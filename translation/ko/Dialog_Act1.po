msgctxt "hbb63fdbeg3615g425bgaa72g6e2e479a49c9"
msgid "*Lathander blesses the rising, bountiful sun.*"
msgstr "*라샌더가 떠오르는 풍성한 태양을 축복합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_StatuePuzzle_AD_StuckStatue
#. Speaker = Narrator
#. NodeID = b8b1f228-d2eb-42ce-a96d-a47ad9439717
