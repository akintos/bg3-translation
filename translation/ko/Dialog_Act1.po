msgctxt "h7b3815c1g0d66g4350g8be1g34e0278be058"
msgid "I can't resist... don't want to."
msgstr "저항할 수 없어... 저항하고 싶지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerCharmed
