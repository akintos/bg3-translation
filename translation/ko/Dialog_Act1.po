msgctxt "hd4aab13dg7b84g489dga089g50341d770084"
msgid "What a strange mask. Is it bronze? Gold, even?"
msgstr "이상한 가면이네. 이거 청동인가? 아니면, 금?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_MerregonMask_PAD
