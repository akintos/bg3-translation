msgctxt "hcb200ddag08efg4c37gae93gb33e157383f5"
msgid "This gibberish is giving me a headache."
msgstr "이 헛소리를 보고 있자니 머리가 아플 지경이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_FurnaceSearch_PAD_MadRecords
#. Speaker = Player
#. NodeID = 0da9ecb2-23d9-9c87-ea55-573f2365c8f3
