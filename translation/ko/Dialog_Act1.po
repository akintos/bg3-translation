#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Skickpit
#. NodeID = 08a6cc66-9ef2-86e8-49fe-9da838f759ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:08a6cc66-9ef2-86e8-49fe-9da838f759ec
msgctxt "hfdd4590agb840g4974g9bd0ge0036d5cb537"
msgid "Then shh - keep it low. Don't let them hear you."
msgstr "그렇다면, 쉿. 조용히 말해. 그들이 네 말을 듣지 못하게 하라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Player
#. NodeID = 0a25ff27-6148-17cf-73d0-188998a3c471
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:0a25ff27-6148-17cf-73d0-188998a3c471
msgctxt "ha2adfda3gd837g423fg8a8bg465c98cbcd7a"
msgid "Hey now. What's with the hostility?"
msgstr "진정해. 왜 그렇게 적대적인 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Skickpit
#. NodeID = 0bdc59ba-9018-3c40-ec9a-b9d5d2529924
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:0bdc59ba-9018-3c40-ec9a-b9d5d2529924
msgctxt "h8cebd11ag290eg435bga4e8g812d5d008c89"
msgid "So like I said: piss off."
msgstr "내가 말했듯이, 저리 꺼져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Player
#. NodeID = 0db1e6bc-fda1-2478-90fe-3e449dd92c75
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_ElevatorGnome_Event_SaidNotTrueSoul(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:0db1e6bc-fda1-2478-90fe-3e449dd92c75
msgctxt "ha5221910gedc2g4d85g92c9g41096d851d63"
msgid "That's the thing - I'm not really a True Soul."
msgstr "바로 그거야, 난 진짜 참된 영혼이 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Player
#. NodeID = 1173faee-fd62-509c-f160-329c5c44f962
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:1173faee-fd62-509c-f160-329c5c44f962
msgctxt "he9681cbbgc2a3g4b4agb9f9g745009f48c57"
msgid "It's pronounced: 'I tremble afore your awful majesty.'"
msgstr "이렇게 말해야지. '끔찍한 분 어전에서 벌벌 떱니다.'"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Player
#. NodeID = 11985302-6cf9-5b07-4b36-b6529782458a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:11985302-6cf9-5b07-4b36-b6529782458a
msgctxt "h13143072g15b6g4de3gac3fg4cf5387c8e9d"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Skickpit
#. NodeID = 142393c2-aab0-1d8f-89a5-01bcda9efb8e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_ELevatorgNome_Event_OfferedHelp = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:142393c2-aab0-1d8f-89a5-01bcda9efb8e
msgctxt "h50e55cfbg9859g46ffgb67eg623ffa248aa8"
msgid "Off with you. They'll get suspicious."
msgstr "얼른 저리 가. 수상하게 생각할 거야. "

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Skickpit
#. NodeID = 144c61b0-75b3-6bb2-7635-7478bc11778c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:144c61b0-75b3-6bb2-7635-7478bc11778c
msgctxt "h40e528e6g699ag4b31gb7afg80ab7593c533"
msgid ""
"You do look the sort. Well - if you're craving blood, better theirs than "
"mine."
msgstr "그래 보이네. 뭐, 피를 갈망한다면 나보단 저 놈들 피가 낫겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Player
#. NodeID = 16067b4a-68b7-852d-a6e7-1418b9a47a46
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_GOOD or PALADIN_GOOD
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:16067b4a-68b7-852d-a6e7-1418b9a47a46
msgctxt "hf6ebdc7cg8808g4d84ga73eg69a6fa332970"
msgid "Listen, I'm here to help. Play along."
msgstr "이봐, 난 도와주러 온 거라고. 일단 어울려 줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Player
#. NodeID = 1e9d2fc2-96c4-6669-ade6-1f385220e6ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:1e9d2fc2-96c4-6669-ade6-1f385220e6ed
msgctxt "h046c3562g7982g4429g86a4g12cc0f24cb23"
msgid "I'll need you to repeat that."
msgstr "다시 말해봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Skickpit
#. NodeID = 2029af85-21a2-3857-2564-bd04cb9d886a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - UND_ElevatorGnome_PissedOff(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:2029af85-21a2-3857-2564-bd04cb9d886a
msgctxt "h03650102gcb94g4d57g877bg73fee3243e94"
msgid ""
"Whatever sick game this is I want <i>nothing </i>to do with it. Get the "
"hells away from me."
msgstr "이게 뭔 거지같은 놀이건간에 난 <i>아무 것도</i> 하기 싫어. 당장 여기서 꺼져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Karlach
#. NodeID = 20d3cbd3-2c5f-44ff-b4fd-0f4f48f8f990
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_KARLACH(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:20d3cbd3-2c5f-44ff-b4fd-0f4f48f8f990
msgctxt "h636eb868g2cf3g4d18g9fbcg7830aad0622c"
msgid ""
"Hang on. You sure you want to pick a fight with these gnomes? They've got "
"bigger problems than <i>us.</i>"
msgstr "잠깐만. 정말 이 노움들이랑 싸우고 싶어? 걔넨 문제가 <i>우리</i> 거보다 더 크다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Player
#. NodeID = 2615ac73-2750-b72a-ba38-db53c33eb2e1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:2615ac73-2750-b72a-ba38-db53c33eb2e1
msgctxt "h49868d03ga943g4e70g97d7g015683d65b0f"
msgid "Go where you want. I've done enough for you."
msgstr "마음대로 해. 이만하면 충분히 도와줬으니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Player
#. NodeID = 291b48a8-9b86-6548-2df5-9c0156e7f3cd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:291b48a8-9b86-6548-2df5-9c0156e7f3cd
msgctxt "hd26c71b2g188bg49c9gbdd8gb932ac88e58c"
msgid "It doesn't matter. Do you want my help or not?"
msgstr "그건 중요한 게 아니야. 도움이 필요해, 안 필요해?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Skickpit
#. NodeID = 2a6c2679-5bd1-156f-65d7-e779b7520538
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:2a6c2679-5bd1-156f-65d7-e779b7520538
msgctxt "h34c29545g3138g43abg86bfg3fa9f424f36e"
msgid ""
"But you better finish the job, 'cause I'll be the one to suffer if you don't."
msgstr "하지만 꼭 해내야 해, 그렇지 못하면 내가 고통받을 테니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Skickpit
#. NodeID = 2a9b03f1-478e-faa0-76ee-b715688096c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:2a9b03f1-478e-faa0-76ee-b715688096c8
msgctxt "hd3e3c560g4321g4eb7gba5dg312cd3c199e3"
msgid "Figures. You want blood? Those pisspots will spill plenty."
msgstr "그렇구만. 피를 원해? 저 오줌통들이 잔뜩 쏟아 줄 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Player
#. NodeID = 2d9e147f-f04d-eaad-9e88-b499352e3eb1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WYLL(1) = False
#. SetFlags:
#.   Dialog:
#.     - UND_ElevatorGnome_Event_SaidNotTrueSoul(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:2d9e147f-f04d-eaad-9e88-b499352e3eb1
msgctxt "hd375eac1g49d0g4b27gbd63g3af5d51d097a"
msgid ""
"My name's [GEN_PlayerName_c11eee1e-7815-6143-7233-f2427799fa53]. I'm not "
"really a True Soul."
msgstr ""
"내 이름은 [GEN_PlayerName_c11eee1e-7815-6143-7233-f2427799fa53](이)야. 난 진짜 참된 영혼이 "
"아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Skickpit
#. NodeID = 2fdf5b33-f0dd-50de-8828-1a26d57bc0b2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_ElevatorGnome_State_Shadowlands = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:2fdf5b33-f0dd-50de-8828-1a26d57bc0b2
msgctxt "h381d1efcgd996g457aga9bag4d3ed9437dc9"
msgid "Nah - not one who freed me from slavers, anyway. You did me right."
msgstr "아니, 날 노예상에게서 풀어준 노움은 안 그러겠지. 넌 날 똑바로 이끌어 줬으니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Skickpit
#. NodeID = 30eda505-6c66-93b9-065c-3aef77988707
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_ElevatorGuards_Dead = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:30eda505-6c66-93b9-065c-3aef77988707
msgctxt "h9d4bbac4gafd8g4947ga94egebfce2b266cf"
msgid "Shit. You did it."
msgstr "씨발. 네가 해냈군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Skickpit
#. NodeID = 311b0f82-49d6-239c-5984-5798a092be45
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:311b0f82-49d6-239c-5984-5798a092be45
msgctxt "h15b549ddg58a5g48d3g804agc36f0fd4aee0"
msgid ""
"Hah! Thulla was mad as a rutting badger, but she weren't a friend of any "
"<i>True Soul.</i>"
msgstr "하! 툴라가 발정난 오소리처럼 정신이 나가긴 했지만, 그녀가 <i>참된 영혼의</i> 친구는 아니었지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Player
#. NodeID = 32d34d64-477f-506a-9164-afc7efaecfb2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:32d34d64-477f-506a-9164-afc7efaecfb2
msgctxt "hbc67f757g501dg4e2bga22ag7251baca10bf"
msgid "Say that to me one more time, and I'll gut you."
msgstr "한 번만 더 내게 그런 식으로 말했다간, 네 내장을 꺼내주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Skickpit
#. NodeID = 37343aab-35f1-7650-eef7-443067f36372
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_ElevatorGnome_State_OffStage = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:37343aab-35f1-7650-eef7-443067f36372
msgctxt "ha04b966fg3336g4cb5g801ege71c5b64d90a"
msgid "Damn it - just when I thought you half decent."
msgstr "제기랄, 너 좀 괜찮다고 생각하자마자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Skickpit
#. NodeID = 386a49bd-84d7-c2e1-66f2-0169b2465dc5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_ELevatorgNome_Event_OfferedHelp = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:386a49bd-84d7-c2e1-66f2-0169b2465dc5
msgctxt "h30bc5ba6ga121g4fa6gbff7ga26232d9b385"
msgid ""
"Ahem. <i>Ain't you hearin' me, prick-hole? Piss off to every last hell!</i>"
msgstr "어흠. <i>내 말 안 들려, 등신 새끼야? 지옥 끝까지 꺼져 버리라고!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Skickpit
#. NodeID = 3b1a8e43-219c-9fd4-b96a-3268ae62624f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:3b1a8e43-219c-9fd4-b96a-3268ae62624f
msgctxt "h63a2225dg586cg4721gbdbfgf5510c3a247e"
msgid "I heard the pisspot - you're a True Soul, same as Nere."
msgstr "오줌통이 말하는 거 들었어, 너도 니어처럼 참된 영혼이잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Lae'zel
#. NodeID = 3f067084-4b69-4355-a6f2-79d5fad8da2f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(2) = True
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:3f067084-4b69-4355-a6f2-79d5fad8da2f
msgctxt "h6d347330g6cb4g443cg9b08g170192bf284e"
msgid ""
"Think this through. Strike a slave, and its owners will not simply stand by."
msgstr "잘 생각해 봐. 노예를 공격하면, 그 주인이 가만있지 않겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Skickpit
#. NodeID = 44793b46-a53b-d9b2-4af1-f039e3db630d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_ElevatorGnome_Event_ClaimedWyll(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:44793b46-a53b-d9b2-4af1-f039e3db630d
msgctxt "haa47f1c9g219fg4542gbb48g8c93c4f71cd2"
msgid "You want to play hero, Blade? I'm not complaining."
msgstr "영웅 행세를 하고 싶나, 칼날? 난 환영이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Wyll
#. NodeID = 452284c7-9651-43b4-a3d7-dcd80b9164ff
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_WYLL(6) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:452284c7-9651-43b4-a3d7-dcd80b9164ff
msgctxt "hfde48844g4e31g4d1egbd81g50bb12dadfeb"
msgid ""
"Cool it. You think you'd be any less mouthy if slavers took <i>you "
"</i>hostage?"
msgstr "진정해. 노예상들이 널 인질로 잡았으면 너라고 조용히 있었을 것 같아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Skickpit
#. NodeID = 481ae2cd-2c3f-7fd3-178c-909f62672218
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:481ae2cd-2c3f-7fd3-178c-909f62672218
msgctxt "h969702d3g39b9g4b8cgbe7fg355722b819b8"
msgid "You're a True Soul, all right. You look it. You <i>smell </i>it."
msgstr "넌 참된 영혼이야, 알겠지. 그래 보여. 그런 <i>냄새가</i> 나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Player
#. NodeID = 498054f3-f111-1980-3d5c-4624b7df3d36
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:498054f3-f111-1980-3d5c-4624b7df3d36
msgctxt "hbf4f2c63gbb8ag4250g883bg3e84cf932855"
msgid ""
"I'm working <i>so hard </i>to be a nice person these days but you're really "
"trying my patience."
msgstr "요즘 <i>진짜 열심히</i> 좋은 사람 노릇 하려는데 네가 내 인내심을 크게 시험하는구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Skickpit
#. NodeID = 4d1d5724-b9ee-9153-5eea-a33cea7f8998
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:4d1d5724-b9ee-9153-5eea-a33cea7f8998
msgctxt "h808e1fbcga11fg481fgbe1fga8e0ab52a8d1"
msgid ""
"Fine - let's say I believe you. You want to kill these peckers, I'm not "
"complaining."
msgstr "좋아, 내가 널 믿는다 치자고. 이 좆같은 새끼들을 죽이고 싶다면, 난 환영이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Skickpit
#. NodeID = 4e1d7e9f-bc34-323f-d61c-c98af129c2b6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_ElevatorGnome_HasPoison(0) = True
#. SetFlags:
#.   Object:
#.     - UND_ElevatorGnome_GivePoison(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:4e1d7e9f-bc34-323f-d61c-c98af129c2b6
msgctxt "h5bbdc737g0bfbg4b20g8361g3b5f64eeaafd"
msgid ""
"Won't be needing this poison, now that you've offed the pricks. Bet you'll "
"find it handy, though."
msgstr "네가 저 새끼들을 치워 줬으니, 이 독은 이제 필요 없겠네. 분명 도움이 될 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Skickpit
#. NodeID = 51b23d32-4cbe-3c4b-b80b-0ef1a84b4a17
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_ElevatorGnome_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - UND_ElevatorGnome_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:51b23d32-4cbe-3c4b-b80b-0ef1a84b4a17
msgctxt "h32e40d4bgf2d6g4283g86ccg02570a22f376"
msgid "Piss off."
msgstr "저리 꺼져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Player
#. NodeID = 521a590f-bb6e-bbc2-52e5-306873740f8a
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:521a590f-bb6e-bbc2-52e5-306873740f8a
msgctxt "h1befe1e9g3a04g403bgbddbg05dbe1159e20"
msgid "Last chance. You want me to kill your slavers or not?"
msgstr "마지막 기회야. 내가 저 노예상들을 죽일까, 관둘까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Skickpit
#. NodeID = 53e3b20c-f35a-ed5c-8be4-0f6e06c51459
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:53e3b20c-f35a-ed5c-8be4-0f6e06c51459
msgctxt "h798d8e14g6f11g4f48g871cg68a7c4d4a24f"
msgid "Free? Glory to Ironhand! I'll join the others."
msgstr "자유라고? 아이언핸드께 영광을! 다른 이들과 합류해야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Skickpit
#. NodeID = 5e516c0a-6f37-9079-6d96-ce623a74ec32
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:5e516c0a-6f37-9079-6d96-ce623a74ec32
msgctxt "hffd71d34g2d68g46bfgbdf9gb9d6d5bed003"
msgid ""
"You're all the same. I'd sooner spit in your shitter than trust a single "
"damn word."
msgstr "너희들은 다 똑같아. 네 말을 한 마디라도 믿을 바엔 네 똥간에 침을 뱉겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Skickpit
#. NodeID = 650e0098-7ca8-0e07-706c-c4d841b43d7d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_ElevatorGnome_State_Shadowlands = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:650e0098-7ca8-0e07-706c-c4d841b43d7d
msgctxt "hd6949a92g1739g458fgb4a3g98a61929d0e7"
msgid "Well, you did me right once, so you earned my trust twice."
msgstr "좋아, 내게 '한'차례 제대로 했기에 내 신용을 '두' 배로 얻은 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Shadowheart
#. NodeID = 66f0fe2d-6af3-408a-84eb-da366aa0b46a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:66f0fe2d-6af3-408a-84eb-da366aa0b46a
msgctxt "h88c4e705g71c7g42cfgbb15g79dd81753c9d"
msgid ""
"Careful - attack a slave, and you might have to answer to the slave master."
msgstr "조심해, 노예를 공격하면, 그 주인이 불만을 표할 테니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Player
#. NodeID = 6bb261a0-359e-af16-bf61-f9bafc231368
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:6bb261a0-359e-af16-bf61-f9bafc231368
msgctxt "h693ed1ccg6872g4970g9818gd4be666d0ced"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Skickpit
#. NodeID = 6bf3f7fe-f9fe-7d11-48e0-eb6f7870bd93
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:6bf3f7fe-f9fe-7d11-48e0-eb6f7870bd93
msgctxt "h02fc33f0g6d94g4158g9f6cg59c7966d467d"
msgid "I can call you other silly names, True Soul. Like arserag, or shitepot."
msgstr "다른 멍청한 이름으로도 부를 수 있어, 참된 영혼. 뒷구멍깔개, 아니면 응가주머니도 좋고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Player
#. NodeID = 6c63a95f-6a50-ca2a-587a-713a2832b61c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:6c63a95f-6a50-ca2a-587a-713a2832b61c
msgctxt "h96f8cf3bg21d7g4f53gac89g585c97b193fe"
msgid "Piss off yourself."
msgstr "너나 꺼지시지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Skickpit
#. NodeID = 6ef88ec4-1bef-9fb5-582a-a960474a84de
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:6ef88ec4-1bef-9fb5-582a-a960474a84de
msgctxt "h390397d5gda09g40c7g8530gb8d6db8dbcf1"
msgid "Now - why in the hottest hells would a True Soul be helping me?"
msgstr "그럼, 대체 무슨 지옥불에 머리가 구워졌길래 참된 영혼이 날 돕겠다는 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Player
#. NodeID = 71792ac5-583d-56c2-2fd3-225fc3089849
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_GnomeWorkers_State_Left = False
#.      - UND_State_LeaderFreedGnomes = True
#.      - GLO_UND_Gnomes_TalkedForeman = True
#. SetFlags:
#.   Global:
#.     - UND_ElevatorGnome_State_Myconids = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:71792ac5-583d-56c2-2fd3-225fc3089849
msgctxt "h82510340g049eg41d0gbbfbgde2b2e6beed0"
msgid "Beldron is taking the others across the lake. Wait for them there."
msgstr "벨드론이 다른 이들을 호수 건너로 데려가고 있어. 거기서 그들을 기다려."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Player
#. NodeID = 72330279-860d-28de-4366-7bb174d8358c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_ElevatorGnome_State_OffStage = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:72330279-860d-28de-4366-7bb174d8358c
msgctxt "h95bf80f8g8e8bg4860gb36fg7c96d0eab115"
msgid "Go find somewhere to hide - wait for things to cool down."
msgstr "숨을 곳을 찾아 - 상황이 진정되기를 기다리라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Skickpit
#. NodeID = 72f7989f-f1cc-6db4-6035-06de6f3975e3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DEEPGNOME(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:72f7989f-f1cc-6db4-6035-06de6f3975e3
msgctxt "hd09d725dgccbag4fc2g86a7g85cbdb76d321"
msgid ""
"I heard the pisspot - you're a True Soul, same as Nere. Traitor to your kind."
msgstr "오줌통이 말하는 거 들었어, 너도 니어처럼 참된 영혼이잖아. 동족의 배신자 녀석."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Gale
#. NodeID = 74bc66a9-8265-4c60-9976-e6f2e6f315ee
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_GALE(7) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:74bc66a9-8265-4c60-9976-e6f2e6f315ee
msgctxt "h353471bfgd931g4680g8b3eg92482a6b5122"
msgid ""
"Hold on. This fellow may deserve it, but I don't think the duergar will "
"appreciate you hurting the merchandise."
msgstr "기다려. 이 친구가 공격받아 싸다 해도, 상품에 흠집을 내면 듀에르가들이 좋아하지 않을걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Player
#. NodeID = 74e0dcff-d2db-fb59-0463-d8b51a2c791e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_GnomeWorkers_State_Left = False
#.      - UND_State_LeaderFreedGnomes = True
#.      - UND_GnomeWorkers_State_PermaDefeated = False
#. SetFlags:
#.   Global:
#.     - UND_ElevatorGnome_State_CaveIn = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:74e0dcff-d2db-fb59-0463-d8b51a2c791e
msgctxt "ha277c8fbg82f3g41aega553gd4cd709c87f8"
msgid "The others are free. Meet them at the dig site."
msgstr "다른 사람들은 자유야. 채굴 현장에서 만나 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Skickpit
#. NodeID = 7570b151-cb31-d296-dee5-b60957c36143
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_ElevatorGnome_State_Shadowlands = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:7570b151-cb31-d296-dee5-b60957c36143
msgctxt "h2ca61d19gf10ag46c7g848bgfae11a6e9c10"
msgid "Fine, fine - I'm not looking for more trouble."
msgstr "알겠어, 알겠다고. 더 말썽 일으키긴 싫어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Skickpit
#. NodeID = 76ed87c9-99f2-8f11-494e-ae04378d45bc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:76ed87c9-99f2-8f11-494e-ae04378d45bc
msgctxt "h8c51136fge591g4d47g86ccgac773759708b"
msgid "Beldron's safe, then? Thank Ironhand. I'll make my way over."
msgstr "그럼 벨드론도 안전한 건가? 아이언핸드님께 감사를. 나는 가봐야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Player
#. NodeID = 7ecbb31c-e1a0-17ec-3bd0-36b3d1a73726
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DUERGARDWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:7ecbb31c-e1a0-17ec-3bd0-36b3d1a73726
msgctxt "h2c655e2dgb8f8g42b1g8f72gc42f27a6749a"
msgid "I'm not with these arseholes."
msgstr "난 저 새끼들이랑 한 편 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Skickpit
#. NodeID = 85337b21-1edc-afd0-f6ab-baab6f11b4ff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:85337b21-1edc-afd0-f6ab-baab6f11b4ff
msgctxt "hafc02d54g02aeg47fag8931gc3f4af6b60e0"
msgid "So listen close. I won't say it again."
msgstr "그러니 잘 들어. 다시 말하지 않을 거니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Skickpit
#. NodeID = 87b6ca6e-029a-bb65-59b3-f888297caa55
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:87b6ca6e-029a-bb65-59b3-f888297caa55
msgctxt "h8d258bedg5162g4589g825dg77cd6c9da7f4"
msgid "What now?"
msgstr "이젠 어쩌지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Skickpit
#. NodeID = 8995c369-188e-2711-19c6-14d527ed34ee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:8995c369-188e-2711-19c6-14d527ed34ee
msgctxt "h7086d4e2g5e79g4559g88cbg45a18a322c53"
msgid "I know a place, cross the lake. Should be safe."
msgstr "호수 건너 아는 곳이 있어. 거기라면 안전할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Skickpit
#. NodeID = 8b541912-ad8f-27c9-c3d9-77734b1e3750
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:8b541912-ad8f-27c9-c3d9-77734b1e3750
msgctxt "hd23cd59bg1a72g4296g89a3g9cb8d81bac36"
msgid ""
"Free? From your mouth, I hope. Go on, then - split them open. I'm not gonna "
"stop you."
msgstr "자유? 난 네 수다에서 자유로워지면 돼. 그럼, 가서 놈들을 찢어버려. 말리지 않을게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Player
#. NodeID = 8d6d69c1-e3f0-b45e-5dd6-fec9e75a4e9b
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_EVIL or PALADIN_EVIL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:8d6d69c1-e3f0-b45e-5dd6-fec9e75a4e9b
msgctxt "hb687a2a3g5018g45d8gaa3bgbd5cfa049b21"
msgid "I'm in the mood for a little slaughter."
msgstr "살육을 좀 즐기고 싶은 기분이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Player
#. NodeID = 927f44f2-c622-0ed6-4af4-8948b1ded638
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - aecd33a6-0a94-7eea-04f7-cbcd0f3a9234_ConsideredAttack = False
#. SetFlags:
#.   Local:
#.     - aecd33a6-0a94-7eea-04f7-cbcd0f3a9234_ConsideredAttack = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:927f44f2-c622-0ed6-4af4-8948b1ded638
msgctxt "h7d176912ge0bag4eb4gaed0g99c7d84a7b84"
msgid "<i>Prepare to strike.</i>"
msgstr "<i>공격을 준비한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Player
#. NodeID = 9b558885-65d1-cab0-c6c6-93c07eb4a012
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GNOME(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:9b558885-65d1-cab0-c6c6-93c07eb4a012
msgctxt "h772e7a24g5946g4ddeg8c83g92b07c6a3d5f"
msgid "Trust me. Would a gnome steer you wrong?"
msgstr "날 믿어. 노움인데 널 잘못 이끌까봐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Skickpit
#. NodeID = 9b625c3f-88c2-3ee3-e1b1-11d9b71b7161
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:9b625c3f-88c2-3ee3-e1b1-11d9b71b7161
msgctxt "hffbdf131g84a8g4944g82f4gee5fbcbf0ed8"
msgid ""
"And who asked for help? Why don't you - hold on. You're talking true, aren't "
"you?"
msgstr "그리고 누가 도와달라긴 했대? 차라리, 아니 잠깐. 너 진짜로 하는 말이구나, 그치?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Skickpit
#. NodeID = 9b6b1926-33fd-70f6-e1c4-b84d828715e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:9b6b1926-33fd-70f6-e1c4-b84d828715e2
msgctxt "hf205c1f2gdc55g4356g834bgfec01695f725"
msgid ""
"They're thick and scrappy, no doubt. If fighting's your vice, I'm not gonna "
"stop you."
msgstr "말할 필요도 없이 두껍고 틱틱대는 놈들이지. 싸우는 버릇이 있다면, 굳이 말리진 않겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Narrator
#. NodeID = 9c80116e-6c20-ba02-38d7-a53510b520e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:9c80116e-6c20-ba02-38d7-a53510b520e2
msgctxt "hddcdc957g0a36g4bfagbf3cg4192a8b3f204"
msgid ""
"*A shred of doubt gives you pause. Attack the gnome, and his owners are sure "
"to defend him.*"
msgstr "*찰나의 의구심에 당신은 잠시 멈춥니다. 노움을 공격한다면, 그 주인들은 당연히 노움을 지키려고 하겠죠.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Player
#. NodeID = 9dc167dd-2fae-ed31-d28d-555547c4b738
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_InjuredGnome_State_GaveQuest = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:9dc167dd-2fae-ed31-d28d-555547c4b738
msgctxt "hffaa1911g4c99g4f13gaddfg8dde4d18f6e4"
msgid "No, you don't understand. Thulla sent me to save you."
msgstr "아니, 잘못 이해하고 있군. 툴라가 널 구하라고 날 보냈어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Player
#. NodeID = 9f67ebb6-c531-c8de-de7e-89b47f44875c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_GnomeWorkers_State_Left = True
#. SetFlags:
#.   Global:
#.     - UND_ElevatorGnome_State_Myconids = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:9f67ebb6-c531-c8de-de7e-89b47f44875c
msgctxt "hd65d814dg8160g40d0gb85aga569026824f4"
msgid "Beldron took the others across the lake. You should join them."
msgstr "벨드론이 다른 이들을 데리고 호수를 건넜어. 너도 그들과 합류해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Player
#. NodeID = a0bc6add-4927-c773-37e2-4f6ff46b8f45
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:a0bc6add-4927-c773-37e2-4f6ff46b8f45
msgctxt "h2961bc3eg391cg44fega4d1gc71b5f3b2a91"
msgid "Grymforge is even more dangerous. Stay at your own peril."
msgstr "그림포지가 훨씬 더 위험해. 알아서 처신하라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Player
#. NodeID = a8ab5fde-26f6-35f9-7258-3dd43e940a93
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:a8ab5fde-26f6-35f9-7258-3dd43e940a93
msgctxt "hae021682ga7d4g4153ga24eg7d3e3af7e6db"
msgid "No one should serve a master. You deserve to be free."
msgstr "누구도 주인을 섬겨선 안 돼. 넌 자유를 누릴 자격이 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Skickpit
#. NodeID = a8d8b654-68d4-c695-b5b0-a8069fc90373
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:a8d8b654-68d4-c695-b5b0-a8069fc90373
msgctxt "h01510fb8gff4cg4e0eg8a00g7d658c5f20b8"
msgid ""
"Is that so? Well listen close, True Soul - I've got a new tune to whistle."
msgstr "그러셔? 그럼 잘 들어 봐, 참된 영혼. 내가 해 줄 말이 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Player
#. NodeID = afde37c6-1ac5-c4b4-88ad-686de9173de2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:afde37c6-1ac5-c4b4-88ad-686de9173de2
msgctxt "h15a59f78g5a48g47e6g9968g93375309d6a5"
msgid "Take the lift to the surface."
msgstr "엘리베이터를 타고 지상으로 올라가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Skickpit
#. NodeID = afe4baa5-af8c-5b6f-2e2e-12b36e65ea72
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:afe4baa5-af8c-5b6f-2e2e-12b36e65ea72
msgctxt "h05e23056g94a3g423cg9f2ag64119309793f"
msgid "The Blade of... well, shit. You're really him, aren't you?"
msgstr "변경의... 이런 세상에. 정말 그 사람이 맞는 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Skickpit
#. NodeID = b4cb5477-0f28-f5a7-4ef3-94f3f9c2fdaf
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - UND_ElevatorGnome_PissedOff(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:b4cb5477-0f28-f5a7-4ef3-94f3f9c2fdaf
msgctxt "he776f3e6g25d6g4efdga1e0g33efd1e3af95"
msgid "Piss. The <i>drugh.</i> Off."
msgstr "저리. <i>드루그.</i> 꺼지라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Player
#. NodeID = bebb738b-c1de-18fa-1551-ba12e2ce200a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = False
#.      - PALADIN_EVIL(1) = False
#.      - CLERIC_EVIL(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:bebb738b-c1de-18fa-1551-ba12e2ce200a
msgctxt "hd41ef303ga999g4a06g92b0gd5fe2e373fcb"
msgid "What can I say? I just love killing."
msgstr "어떻게 설명하겠어? 난 그냥 살인을 즐겨."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Player
#. NodeID = c2357180-3c33-afb0-009f-b21cf1adbc11
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WYLL(1) = True
#. SetFlags:
#.   Dialog:
#.     - UND_ElevatorGnome_Event_ClaimedWyll(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:c2357180-3c33-afb0-009f-b21cf1adbc11
msgctxt "had933862g5106g4e23g9365gf108814f7fe9"
msgid ""
"They call me the Blade of Frontiers. I'm not a True Soul - I can help you."
msgstr "다른 이들은 날 변경의 칼날이라 불러. 나는 참된 영혼이 아니야 - 나는 널 도울 수 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Player
#. NodeID = c46b379f-8d12-9b2a-88f9-a58a53aa2190
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:c46b379f-8d12-9b2a-88f9-a58a53aa2190
msgctxt "h766dd963gc33cg45d8g9f5bg236a16457868"
msgid "Just do it, before I cut out that profane tongue of yours."
msgstr "그냥 해, 네 불경한 혀를 잘라내기 전에 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Player
#. NodeID = c675a1d9-3b8b-b36f-562b-a6241c794131
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:c675a1d9-3b8b-b36f-562b-a6241c794131
msgctxt "h1f1a18edgfa67g432fgb22agedc2a09c1c1b"
msgid "No need to be rude. I'm on your side."
msgstr "그렇게 굴 필요 없어. 난 네 편이니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Skickpit
#. NodeID = c7833c2d-082c-f721-3fd1-1551d87db403
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:c7833c2d-082c-f721-3fd1-1551d87db403
msgctxt "h1b1be580g593bg4376g8d43gcdffe8d32dfb"
msgid "<i>My</i> side? I heard the pisspot. You're a True Soul, same as Nere."
msgstr "<i>내</i> 편이라고? 오줌통이 말하는 거 들었어, 너도 니어처럼 참된 영혼이잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Player
#. NodeID = c85e5a16-5c9e-5bb5-a978-c5875ee7fe48
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - aecd33a6-0a94-7eea-04f7-cbcd0f3a9234_ConsideredAttack = True
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:c85e5a16-5c9e-5bb5-a978-c5875ee7fe48
msgctxt "h13681993g418ag4cc4g9e8bg9575a636c64c"
msgid "<i>Attack the gnome.</i>"
msgstr "<i>노움을 공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Skickpit
#. NodeID = cecb147f-55da-7381-6293-87ac94706d7e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:cecb147f-55da-7381-6293-87ac94706d7e
msgctxt "h8d052668ge9b0g4f48g82d6g46ef1dd7b6b0"
msgid "Fine. You want to spill their guts, I won't stand in the way."
msgstr "좋아. 놈들의 내장을 쏟고 싶다면, 방해하진 않겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Player
#. NodeID = d15d4fa9-556e-b5c0-9d97-bdef6e4e50bb
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:d15d4fa9-556e-b5c0-9d97-bdef6e4e50bb
msgctxt "h042cd5baga8f5g4bf2gb0f2g71992a1926a3"
msgid "The curse is cleared. You'll be perfectly safe."
msgstr "저주를 걷어냈어. 넌 완전히 안전할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Skickpit
#. NodeID = d9835365-a639-6666-5a33-f80d0b064019
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:d9835365-a639-6666-5a33-f80d0b064019
msgctxt "h5e30e8a6gfff1g438bgaf7eg40fadf513fec"
msgid "That's the best comeback you've got? Amateur."
msgstr "그게 네 최선의 응수야? 아마추어군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Player
#. NodeID = d99bf9ff-bf66-3575-6f37-3665dafe6d3d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:d99bf9ff-bf66-3575-6f37-3665dafe6d3d
msgctxt "h3cac3d82g2fe4g4e09gbec5geebceededec3"
msgid "You look like you're in trouble. Surely I can help you."
msgstr "곤경에 처한 것 같은데. 내가 도울 수 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Astarion
#. NodeID = ddd9edec-0d1b-494d-95a6-faf5bc69c5cd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:ddd9edec-0d1b-494d-95a6-faf5bc69c5cd
msgctxt "h385924e1gc163g44dagbb82gfe03a2d899c0"
msgid "You're not going to let him talk to you like that, are you?"
msgstr "저렇게 말하는 걸 내버려 둘 생각은 아니지, 안 그래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Skickpit
#. NodeID = df7ede26-21f9-3569-8081-e0a563f18e52
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_ElevatorGnome_PissedOff(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:df7ede26-21f9-3569-8081-e0a563f18e52
msgctxt "h29759531gc752g4364gb2f7g48d208ba72ba"
msgid "Piss off to every hell."
msgstr "어떤 지옥이든 좋으니, 거기로 꺼져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Skickpit
#. NodeID = e3112a05-2309-24d4-b20c-5229dbf6c118
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_ElevatorGnome_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:e3112a05-2309-24d4-b20c-5229dbf6c118
msgctxt "hf6ce6724gb17cg42a7g986dg082aed8c34bc"
msgid "Didn't you hear me the first time? <i>Piss. Off.</i>"
msgstr "내가 처음에 한 말 못 들었나? <i>저리. 꺼져.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Player
#. NodeID = e4077d50-9277-0c4e-c4c6-1c5af03d62d9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:e4077d50-9277-0c4e-c4c6-1c5af03d62d9
msgctxt "hc31f5684gaffcg4cddgbdaag67f9ec75cadd"
msgid "They look like they'd put up a good fight."
msgstr "저놈들 좋은 싸움 상대처럼 보이는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Skickpit
#. NodeID = e492c57c-f309-129e-b941-ebd80c4dc19f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:e492c57c-f309-129e-b941-ebd80c4dc19f
msgctxt "h5b7e382cg8d86g431egb8bdgbe80daca0f24"
msgid "Shit - up there? Forget it. I hear the land's cursed clear to Moonrise."
msgstr "젠장, 저 위로? 포기해. 그 땅은 문라이즈까지 저주로 싹 도배됐다던데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Skickpit
#. NodeID = e63f41ab-21a2-e0b5-97fc-b4a2652f2b42
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:e63f41ab-21a2-e0b5-97fc-b4a2652f2b42
msgctxt "h77e18cbdg2007g4810gbc57g5b37897106c0"
msgid ""
"What about 'piss off' do you - hold on. You aren't just talking shit, are "
"you?"
msgstr "'저리 꺼져'라는 말의 - 잠깐. 헛소리를 하고 있는 게 아니군, 안 그래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Skickpit
#. NodeID = e6d6984e-629e-3c00-1102-9262e197d184
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:e6d6984e-629e-3c00-1102-9262e197d184
msgctxt "h24574ea6g0a3eg4608g835cgb1d0a1129ab7"
msgid ""
"Down here I know what I'm dealing with. Up there, not so much. Got a better "
"idea?"
msgstr "요 아래에선 내가 뭐 해야 될지 알거든. 위에선 안 그렇고. 더 나은 생각 있어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Player
#. NodeID = e93c1897-b60c-13be-46f8-4d9638515d4d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:e93c1897-b60c-13be-46f8-4d9638515d4d
msgctxt "h454e63b2g9951g4f77g99d1gaa19475944d4"
msgid "Figure it out yourself."
msgstr "네가 알아서 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Skickpit
#. NodeID = eb7d92f5-987c-e7cb-436b-73a103a720ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:eb7d92f5-987c-e7cb-436b-73a103a720ec
msgctxt "h32b024abg4a05g4f89ga261g6cf1a998b8b6"
msgid "Shit. You aren't just talking from your arse, eh?"
msgstr "젠장. 뒷구멍으로 헛소리하는 게 아니었구나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Skickpit
#. NodeID = ef3cc6ba-2715-0399-fd86-235ea5e47b1b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:ef3cc6ba-2715-0399-fd86-235ea5e47b1b
msgctxt "h1763a8f2gc24fg45cfgbf1ag5140772f1cf6"
msgid "Really? <i>Drugh </i>yes. Glory to Ironhand!"
msgstr "정말? <i>존나</i> 잘 됐군. 아이언핸드께 영광을!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Skickpit
#. NodeID = f0814235-f73f-985a-ce17-693654dcb53e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:f0814235-f73f-985a-ce17-693654dcb53e
msgctxt "h0e110cb3ge00cg432fgb354ga575b8ec1db2"
msgid "Better that than chance the damn curse. You got a plan C?"
msgstr "망할 저주에 걸리느니 그게 낫겠네. 계획 C는 있어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Skickpit
#. NodeID = f08d2d5a-d663-48f8-55f1-78d878e066c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:f08d2d5a-d663-48f8-55f1-78d878e066c1
msgctxt "h1bebeed7g75aag4d9fgbbfag0c772ac0e129"
msgid "You might be a shithead. But I'm grateful."
msgstr "넌 개새끼일지도 모르겠다. 하지만 고마워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Player
#. NodeID = f18bd430-f48c-9990-047a-83c291c38a5c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DEEPGNOME(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:f18bd430-f48c-9990-047a-83c291c38a5c
msgctxt "h0483ddf2g829bg470ag8f8dgb8028bfa151a"
msgid "How about we show these slavers what deep gnomes are made of, instead?"
msgstr "그 대신 저 노예상 놈들한테 딥 노움 맛 좀 보여 주기는 어때?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Skickpit
#. NodeID = f4dbb206-2a0e-dd1a-6d2a-53d5463826c2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:f4dbb206-2a0e-dd1a-6d2a-53d5463826c2
msgctxt "hc255e5fcg496cg46e1ga6fag92e7051a00d9"
msgid ""
"Cleared - just like <i>that</i>, huh? Well I'm not taking the chance. Any "
"other ideas?"
msgstr "하, 걷어냈다고, <i>쟤네</i>처럼? 난 안 넘어가. 다른 생각 있어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Skickpit
#. NodeID = f74016f2-0fa3-1ecc-0ecc-2f6adae5e9e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:f74016f2-0fa3-1ecc-0ecc-2f6adae5e9e6
msgctxt "hfef2a310g746eg456ega3f3g12cb03d7a82e"
msgid "You want to help me? Then open those ears and listen close."
msgstr "날 돕고 싶다고? 그럼 귀 열어 두고 잘 들어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Skickpit
#. NodeID = fb9e9229-19e4-96e3-7ecb-f5a82cbfe2ee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:fb9e9229-19e4-96e3-7ecb-f5a82cbfe2ee
msgctxt "hbaffb882gc7d3g496cgb2cbgccac7f680cf8"
msgid "You're a good one. I won't forget it."
msgstr "넌 좋은 놈이야. 잊지 않을게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Player
#. NodeID = fbd8414d-84e6-94a2-4b35-19b164356790
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#. TagRule: BERSERKER
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:fbd8414d-84e6-94a2-4b35-19b164356790
msgctxt "hbd3c34bcg16deg404ag8a34g73f3bee0fb2f"
msgid "<b>MOVE. </b>I WASN'T ASKING."
msgstr "<b>비켜, 부탁하는 게 아니다</b>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Player
#. NodeID = fbd8414d-84e6-94a2-4b35-19b164356790
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:fbd8414d-84e6-94a2-4b35-19b164356790
msgctxt "h623c65dbg0bf1g480cgae82gc60057727844"
msgid "I go where I like. <b>Move.</b>"
msgstr "난 내가 가고 싶은 데로 간다. <b>비켜.</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome
#. Speaker = Player
#. NodeID = ff69cad4-fea2-8fae-bb08-52b1629d4336
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_ElevatorGnome_Event_SaidNotTrueSoul(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome:ff69cad4-fea2-8fae-bb08-52b1629d4336
msgctxt "hef015ef2gda6dg4397ga914g10b7e97befa1"
msgid "I told you. I'm not really a True Soul."
msgstr "말했잖아. 난 진짜 참된 영혼이 아니라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome_CaveIn
#. Speaker = Skickpit
#. NodeID = 2eae0140-c664-4dba-8d76-11d0b7dbb0a1
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DROWELF and REALLY_DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome_CaveIn:2eae0140-c664-4dba-8d76-11d0b7dbb0a1
msgctxt "hb7da65a4g0871g40dagbfa6g4971490d608f"
msgid ""
"Can't thank you enough. A drow with a golden heart. Who'd have thought it?"
msgstr "정말 고마워. 선량한 마음씨의 드로우라니. 누가 상상이나 했겠어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome_CaveIn
#. Speaker = Skickpit
#. NodeID = 2eae0140-c664-4dba-8d76-11d0b7dbb0a1
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DUERGARDWARF and REALLY_DUERGARDWARF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome_CaveIn:2eae0140-c664-4dba-8d76-11d0b7dbb0a1
msgctxt "hfa23e96dg9df2g4a86g8b58gd4f3b53f086f"
msgid "You're a damned miracle. A duergar helping deep gnomes? Mark the day."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome_CaveIn
#. Speaker = Skickpit
#. NodeID = 2eae0140-c664-4dba-8d76-11d0b7dbb0a1
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome_CaveIn:2eae0140-c664-4dba-8d76-11d0b7dbb0a1
msgctxt "h2a7de426g7fd2g4894g8012g08e76d8f6305"
msgid "You've done more than I'd have hoped for. I should never have doubted."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome_Saved
#. Speaker = Skickpit
#. NodeID = 8d89e33c-4452-d975-ca6a-2f000b4f34d7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - UND_ELevatorGnomeSaved_HasMet(1) = True
#. TagRule: DROWELF and REALLY_DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome_Saved:8d89e33c-4452-d975-ca6a-2f000b4f34d7
msgctxt "haac6fcf8g8cb3g4065g849dgc78585dcd7bd"
msgid ""
"You're a first - a drow who helped a deep gnome. I doubt I'll meet many more."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome_Saved
#. Speaker = Skickpit
#. NodeID = 8d89e33c-4452-d975-ca6a-2f000b4f34d7
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - UND_ELevatorGnomeSaved_HasMet(1) = True
#. TagRule: DUERGARDWARF and REALLY_DUERGARDWARF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome_Saved:8d89e33c-4452-d975-ca6a-2f000b4f34d7
msgctxt "he8233ce3gd876g4123ga9c3g738d54ff5508"
msgid ""
"Shit - figured all duergar were slavers. A shame there aren't more like you."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome_Saved
#. Speaker = Skickpit
#. NodeID = 8d89e33c-4452-d975-ca6a-2f000b4f34d7
#. HandlePath = TaggedText[2].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - UND_ELevatorGnomeSaved_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome_Saved:8d89e33c-4452-d975-ca6a-2f000b4f34d7
msgctxt "h1446c9c4gc16ag4746ga074geebd7ede2092"
msgid ""
"Shit. Still can't believe you got me out of there. Sorry I told you to piss "
"off."
msgstr "젠장. 네가 날 저기서 구해줬다는 게 아직도 믿기지가 않네. 아까 꺼지라고 한 건 미안해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome_Saved
#. Speaker = Skickpit
#. NodeID = 92425883-7f9d-db1d-d001-393901d4f355
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_ELevatorGnomeSaved_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGnome_Saved:92425883-7f9d-db1d-d001-393901d4f355
msgctxt "h9070a7e0g380eg4122g883ag421d462c7565"
msgid ""
"Could use a stiff drink, if I'm being honest. The duergar ale wasn't half "
"bad."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_001
#. Speaker = Narrator
#. NodeID = 0776b864-f077-7ad9-b8d5-7a90f1457b41
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_001:0776b864-f077-7ad9-b8d5-7a90f1457b41
msgctxt "he8893338g3f9eg4053g8d71g9691a78fdf0c"
msgid "*'Worst. Hangover. Ever.', Geddarm concluded.*"
msgstr "*'사상. 최악의. 숙취.', 게담은 그렇게 결론 내렸습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_001
#. Speaker = Ward Magmar
#. NodeID = 0e3b5748-55d7-483b-cde7-a207b3dfd636
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_ElevatorGuard001_HasMet(1) = False
#.   Global:
#.      - UND_TheDrowNere_State_PermaDefeated = True
#. SetFlags:
#.   Dialog:
#.     - UND_ElevatorGuard001_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_001:0e3b5748-55d7-483b-cde7-a207b3dfd636
msgctxt "h7546f1b2g8038g425cgb027g41084cc43a8c"
msgid "Shove off. Just 'cause you offed Nere doesn't mean I'm sharing."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_001
#. Speaker = Player
#. NodeID = 1d564646-0c94-4ada-1ed0-c1da230ceb4c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_001:1d564646-0c94-4ada-1ed0-c1da230ceb4c
msgctxt "hfce66a04gfa0dg46fcga45egaaac28bcb840"
msgid "As if I'd swallow a drop of that swill."
msgstr "내가 그 구정물을 한 방울이라도 마실 것처럼 말하지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_001
#. Speaker = Ward Magmar
#. NodeID = 2745254c-b975-853a-3840-a7a44e41be8c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_001:2745254c-b975-853a-3840-a7a44e41be8c
msgctxt "ha7d3f4ceg08e2g4dd4g9defg897e92ef9e78"
msgid "You <i>drugnin' </i>worm."
msgstr "이 <i>드루그닌 </i>벌레 자식이."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_001
#. Speaker = Narrator
#. NodeID = 336d5af2-a6c9-4546-e9e1-482154bacc20
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DUERGARDWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_001:336d5af2-a6c9-4546-e9e1-482154bacc20
msgctxt "h7ac67c86gf2e9g4db4gaed1g22a6d79b6629"
msgid ""
"*You note the ale on his breath. Few duergar partake: alcohol can awaken "
"racial memories of your illithid bondage.*"
msgstr ""
"*그의 숨결에서 에일 냄새가 풍깁니다. 술을 마시는 듀에르가는 거의 없습니다. 그들이 일리시드에게 노예로 부려지던 시절을 떠오르게 하기 "
"때문입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_001
#. Speaker = Player
#. NodeID = 3c86510f-c956-8a69-341b-076f9d828348
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_001:3c86510f-c956-8a69-341b-076f9d828348
msgctxt "h7f2778bbgdb5cg41e6g923dg6e0f193870fe"
msgid "Nothing like ale to surface old memories, wouldn't you say?"
msgstr "오랜 기억을 떠올리기엔 에일만한 것도 없지, 그렇지 않나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_001
#. Speaker = Narrator
#. NodeID = 3d05c477-d4e8-e81e-661f-5897597059fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_001:3d05c477-d4e8-e81e-661f-5897597059fe
msgctxt "h4b8b611egdb2ag4f45ga10egc875f83e8756"
msgid ""
"*You recall that few of your grey cousins tend to drink, lest they kindle "
"ancestral memories of mind flayer torture.*"
msgstr ""
"*당신의 회색 사촌들이 술을 거의 마시지 않는다는 사실이 떠오릅니다. 마인드 플레이어에게 고문 당하던 선조의 기억을 떠올리게 하기 "
"때문입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_001
#. Speaker = Ward Magmar
#. NodeID = 4ff2194f-561b-3589-210e-4fce715e8865
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_001:4ff2194f-561b-3589-210e-4fce715e8865
msgctxt "h7c91c55fg6bf1g460aga3cfg997cf26aab1e"
msgid ""
"This here is Slow Spout. Didn't come by it easy - and I ain't wastin' it on "
"a True-hole."
msgstr "이건 슬로우 스파우트야. 쉽게 찾을 수 없지, 그리고 이걸 참된-구멍한테 낭비할 생각은 전혀 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_001
#. Speaker = Ward Magmar
#. NodeID = 5172adc5-ae3d-3b09-03e8-4751dbf4d993
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_001:5172adc5-ae3d-3b09-03e8-4751dbf4d993
msgctxt "h75908f43g03d2g4f4bg930cg4f3ce5d039a5"
msgid "For shit's sake. I drink to forget the past, not relive it..."
msgstr "이런 씨발 세상에. 난 과거를 잊기 위해 마신다고, 그걸 기억하려는 게 아니라..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_001
#. Speaker = Ward Magmar
#. NodeID = 56ad792c-9bc5-1328-3bb4-5b3eea93b2c0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_ElevatorGuard001_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - UND_ElevatorGuard001_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_001:56ad792c-9bc5-1328-3bb4-5b3eea93b2c0
msgctxt "h3dfefb0dgb634g41cbgb762gb41ebe5c1c52"
msgid "Shove off. I'm not sharing."
msgstr "저리 꺼져. 나눠줄 생각 없으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_001
#. Speaker = Ward Magmar
#. NodeID = 5bee48d5-ae52-43fa-71c8-e1754d8e587b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_001:5bee48d5-ae52-43fa-71c8-e1754d8e587b
msgctxt "h1697f98bg697bg4fc9g8e46g881f59929c7a"
msgid "Sh... shit. Beat it, True-hole, before I start beating you."
msgstr "씨... 씨발. 저리 꺼져, 참된-구멍, 널 패주기 전에."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_001
#. Speaker = Ward Magmar
#. NodeID = 9b16595e-2099-3502-668c-76c9a1b5585d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_ElevatorGuard001_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_001:9b16595e-2099-3502-668c-76c9a1b5585d
msgctxt "hdca70267ga647g4472g8741gd1710c0e43dc"
msgid "Thought I told you to move."
msgstr "저리 가라고 한 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_001
#. Speaker = Player
#. NodeID = ab2ec5c9-d9de-86d7-bf09-628ce1ea6584
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_001:ab2ec5c9-d9de-86d7-bf09-628ce1ea6584
msgctxt "h261a11b4gecacg4173gb4cdgd0292c9abb2d"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_001
#. Speaker = Narrator
#. NodeID = b133d076-f283-b5e0-01aa-f1b7869e1dbe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GALE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_001:b133d076-f283-b5e0-01aa-f1b7869e1dbe
msgctxt "h9c150881g4350g4aa9gbe15g8386dcc90ca0"
msgid ""
"*You recall Volo's treatise 'Libations in the Realms': duergar seldom drink "
"as it can reawaken memories of mind flayer enslavement.*"
msgstr ""
"*당신은 볼로의 논문 '렐름의 헌주'를 떠올립니다: 듀에르가는 마인드 플레이어에게 노예로 부려지던 시절이 떠오르기 쉽기 때문에 술을 잘 "
"마시지 않는다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_001
#. Speaker = Narrator
#. NodeID = b4c21106-2185-eae9-0821-64f2c0aafcd6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_001:b4c21106-2185-eae9-0821-64f2c0aafcd6
msgctxt "hc7441aa3g0babg4349ga2afg914696333932"
msgid ""
"*Alcohol - an odd vice for duergar, prone to triggering ancestral memories "
"of brutal illithid enslavement.*"
msgstr "*알코올 - 듀에르가가 즐기기엔 묘한 일탈로, 일리시드에게 노예로 부려졌던 시절에 대한 조상의 기억을 불러일으키기 쉽습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_001
#. Speaker = Ward Magmar
#. NodeID = bbc6ac33-c963-458e-9273-8492cea62e81
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_001:bbc6ac33-c963-458e-9273-8492cea62e81
msgctxt "h2705562eg2a18g4254ga260g970e21697881"
msgid "Now clear out. Your face is bugging me."
msgstr "이제 저리 꺼져. 네 면상이 거슬리니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_001
#. Speaker = Ward Magmar
#. NodeID = bc5dbc21-4007-8186-3284-e7afb14cc13b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_ElevatorGuard001_HasMet(1) = True
#.   Global:
#.      - UND_TheDrowNere_State_PermaDefeated = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_001:bc5dbc21-4007-8186-3284-e7afb14cc13b
msgctxt "h7b22ef6dg8c36g41a5g878eg74202e8656a9"
msgid "You clobbered Nere. So what - I'm supposed to just give you a drink?"
msgstr "네가 니어를 두들겨 팼다던데. 그래서 어쩌라고 - 널 위해 술이라도 한잔 사 줘야 하나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_001
#. Speaker = Ward Magmar
#. NodeID = bda82920-3dad-b971-4c6d-ff12cb2e2ccd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_001:bda82920-3dad-b971-4c6d-ff12cb2e2ccd
msgctxt "hfe00af04gcc24g47c9g9174ga749ebef5185"
msgid ""
"As if you could handle it. Slow Spout'll drop a poon like you in a blink."
msgstr "넌 감당할 수 있을 것처럼 말하는군. 너 같은 반푼이는 슬로우 스파우트 한 방울에 가버릴 거라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_001
#. Speaker = Narrator
#. NodeID = d7c758f6-b004-157d-5151-af9e25007170
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_001:d7c758f6-b004-157d-5151-af9e25007170
msgctxt "h64d55bb2g55f1g41begb4e6g8d8d9c776261"
msgid ""
"*Through the duergar's ears, you hear the sizzle of burning flesh and the "
"screams of tortured young - old pain felt anew.*"
msgstr ""
"*듀에르가의 귀를 통해, 지글거리며 타들어 가는 살점의 소리와 고문당하는 어린이의 비명이 들립니다. 오래된 고통이 생생하게 느껴집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_001
#. Speaker = Ward Magmar
#. NodeID = e874a4bb-5efd-3741-4549-521789a01006
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_001:e874a4bb-5efd-3741-4549-521789a01006
msgctxt "hecc262dcg73d7g4811ga82cg972c8be3ee91"
msgid ""
"And that yammering pisshole's bad news for your lifespan, but you keep "
"flapping it..."
msgstr "그리고 네 그 나불거리는 오줌 구멍은 수명에 안 좋은 결과를 가져올 거야, 그래도 계속 떠들겠다면..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_001
#. Speaker = Player
#. NodeID = eadc7a6b-078d-9b63-f498-0bcbedc0db09
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_001:eadc7a6b-078d-9b63-f498-0bcbedc0db09
msgctxt "hf27658e0gebd9g4d25g8f84g950a93e262c3"
msgid "Come on - give me just one sip."
msgstr "에이, 한 모금만 줘 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_001
#. Speaker = Player
#. NodeID = f1b340e8-5b7b-441e-5a38-e479a1d97941
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_001:f1b340e8-5b7b-441e-5a38-e479a1d97941
msgctxt "h261b7b33gfc93g44e0gab7ag00a6c1ee9c24"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_001
#. Speaker = Player
#. NodeID = fe61a26f-0ac5-83b5-bb32-c018630aef91
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DUERGARDWARF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_001:fe61a26f-0ac5-83b5-bb32-c018630aef91
msgctxt "hd8a7ea94gdb8dg4968g87fdg92bc3e9e2911"
msgid "Ease up, brother. Alcohol can be bad news."
msgstr "진정해, 형제. 알코올은 좋지 않은 결과를 불러올 수도 있으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_001
#. Speaker = Player
#. NodeID = fe61a26f-0ac5-83b5-bb32-c018630aef91
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_001:fe61a26f-0ac5-83b5-bb32-c018630aef91
msgctxt "h6913d30dg14e6g4eefg9df7g9120d6ca6f62"
msgid "Alcohol is bad news for duergar. Should you be drinking?"
msgstr "듀에르가에게 알코올은 좋지 않을 텐데. 마셔도 괜찮은 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_002
#. Speaker = Ward Pistle
#. NodeID = 1b7cef76-d50a-96a6-0b6d-fb80358f71d3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_ElevatorGuard002_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_002:1b7cef76-d50a-96a6-0b6d-fb80358f71d3
msgctxt "hfad7d14bg1c8bg44b4g83a8g78ced93d44d8"
msgid "You don't need nothing I've got."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_002
#. Speaker = Player
#. NodeID = 27a9b5ea-f58a-3011-264f-d685bf94ea93
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_002:27a9b5ea-f58a-3011-264f-d685bf94ea93
msgctxt "hbf1d23d4g5528g43ceg800eg9805de80a806"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_002
#. Speaker = Player
#. NodeID = 36aa90ea-e75b-7afc-a68b-e1177c905f1f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_002:36aa90ea-e75b-7afc-a68b-e1177c905f1f
msgctxt "hcc5356f2gd832g4f4dgbe6bg38d2b706ecad"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_002
#. Speaker = Ward Pistle
#. NodeID = 5117aafa-27bf-ba98-8fcd-20ad3d434ed3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_ElevatorGuard02_HasMet2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_002:5117aafa-27bf-ba98-8fcd-20ad3d434ed3
msgctxt "hfbe32431g409dg4bebgb2c2g5130ab542afc"
msgid "Ain't you got more drow to pummel?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_002
#. Speaker = Ward Pistle
#. NodeID = 5fd9994e-62d5-3f22-7939-b034109baa4d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_TheDrowNere_State_PermaDefeated = True
#. SetFlags:
#.   Dialog:
#.     - UND_ElevatorGuard02_HasMet2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_002:5fd9994e-62d5-3f22-7939-b034109baa4d
msgctxt "h9d4905f4g3223g4c01g9235g94466a10b9db"
msgid "Clubbed one of your own, eh? I'll drink to that."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_002
#. Speaker = Ward Pistle
#. NodeID = 9e80f43c-5324-043a-a7c2-24369a5a17f2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_DuergarCamp_State_SidedMutineers = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_002:9e80f43c-5324-043a-a7c2-24369a5a17f2
msgctxt "h532b8bdeg0135g430bga4ccgb22cde32caad"
msgid "Heard you helped us out. But I ain't helpin' you back."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_002
#. Speaker = Ward Pistle
#. NodeID = fe349a5e-53cc-459b-98e2-e4d6f2e91d7f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - UND_ElevatorGuard002_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuard_002:fe349a5e-53cc-459b-98e2-e4d6f2e91d7f
msgctxt "h29fd1bfbg95d6g485bg9be3g9d1060c639b9"
msgid "You still hanging around?"
msgstr "아직도 얼쩡대는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards
#. Speaker = Ward Magmar
#. NodeID = 038be6ea-68ab-eced-ed16-81838c950e94
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards:038be6ea-68ab-eced-ed16-81838c950e94
msgctxt "h8131fa1fgdec1g4e5dg96f3gc6cc8c1a76c0"
msgid "Don't I wish. The gnome's a True Soul."
msgstr "딱 내가 바랐던 대로잖아. 이 노움이 참된 영혼이라네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards
#. Speaker = Ward Magmar
#. NodeID = 0faebf2a-3e32-5fce-6b93-ac2edf75e4e4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards:0faebf2a-3e32-5fce-6b93-ac2edf75e4e4
msgctxt "hda4d4874g4696g4613gba0cg50e9adccdd30"
msgid ""
"Look at the top-dwarf getting all judgy. Not like you lot came to our rescue "
"when mind flayers yoked us."
msgstr ""
"이 지상 드워프 녀석이 불평이 많군. 우리 동족이 마인드 플레이어에게 노예로 부려졌을 때 너희 족속들이 구하러 온 것도 아니면서 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards
#. Speaker = Ward Magmar
#. NodeID = 10fc7b4c-1a26-94d3-2726-24d2a83d189b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_DuergarSergeant_State_PermaDefeated = True
#. SetFlags:
#.   Global:
#.     - UND_ElevatorGuards_State_Did3WayDialogue = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards:10fc7b4c-1a26-94d3-2726-24d2a83d189b
msgctxt "h264f4d88g4709g4437g94a9gb3159376bb1c"
msgid "True Soul, yeah? Tell your chums we won't move a pebble."
msgstr "참된 영혼 아닌가? 네 친구들한테 우린 자갈 하나도 옮기지 않을 거라고 전해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards
#. Speaker = Player
#. NodeID = 11e027ba-d9ce-8b6b-b944-094e93440d75
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards:11e027ba-d9ce-8b6b-b944-094e93440d75
msgctxt "hd391fea7gc8deg4030g973aga54b8bcddf40"
msgid "Fine, take a look."
msgstr "좋아, 봐라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards
#. Speaker = Ward Magmar
#. NodeID = 125f5228-24b9-007e-3ed1-017260d4be8e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards:125f5228-24b9-007e-3ed1-017260d4be8e
msgctxt "h2f34f03bgb9beg4469g82b5gef6d6a725f28"
msgid "Now jump to it, or it's up the lift and straight to the shadows."
msgstr "빨리 가서 가져오지 않으면, 이 승강기에 태워서 그림자 속으로 직행시켜 주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards
#. Speaker = Karlach
#. NodeID = 1852a020-73c8-4c13-9e81-538ede0321ae
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_KARLACH(6) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards:1852a020-73c8-4c13-9e81-538ede0321ae
msgctxt "hda20b3a7g4f3dg46ffg9e6bg6604ead196b5"
msgid ""
"Cruelty like that poisons the soul 'til one day, you drop dead - or the "
"person you're fucking with snaps and puts a sword in your eye."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards
#. Speaker = Lae'zel
#. NodeID = 1f774a45-43fe-4a4c-9797-7b5f55c827c5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(8) = True
#.   Tag:
#.      - REALLY_LAEZEL(8) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards:1f774a45-43fe-4a4c-9797-7b5f55c827c5
msgctxt "h98f38576gb5d8g4cefg8f60g46f0bc798021"
msgid ""
"A waste of a slave. He should be digging or scavenging, not... serving "
"drinks."
msgstr "노예를 낭비하고 있군. 이런 녀석은 음료나 나를 게 아니라... 땅을 파거나 청소를 시켜야 하는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards
#. Speaker = Ward Magmar
#. NodeID = 291d34d9-f286-6b46-db8e-05a3b33ac7d7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards:291d34d9-f286-6b46-db8e-05a3b33ac7d7
msgctxt "hef88a639g4089g4827g8fd8gbb6fc0be0030"
msgid "You <i>flirt.</i>"
msgstr "요 <i>매력 덩어리.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards
#. Speaker = Ward Magmar
#. NodeID = 2adf7a2b-eb72-009b-200f-a05378245b87
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: GNOME or HALFLING
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards:2adf7a2b-eb72-009b-200f-a05378245b87
msgctxt "h8ff0dae8g70f9g40f1ga34eg32524ceb04e2"
msgid "Five workin' fingers. A bit stubby. Prime for digging."
msgstr "손가락 다섯 개 다 잘 붙어있구먼. 좀 뭉툭하긴 하지만. 땅을 파는 덴 최적이겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards
#. Speaker = Ward Magmar
#. NodeID = 2adf7a2b-eb72-009b-200f-a05378245b87
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DROWHALFELF or ELF or GITHYANKI or HALFELF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards:2adf7a2b-eb72-009b-200f-a05378245b87
msgctxt "h9c21356cg287eg4952gbde3g5e61a78ae430"
msgid "Five workin' fingers. Nice and bony, prime for digging."
msgstr "손가락 다섯 개 다 잘 붙어있구먼. 아주 튼실하게 생겼어, 땅을 파는 데 최적이겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards
#. Speaker = Ward Magmar
#. NodeID = 2adf7a2b-eb72-009b-200f-a05378245b87
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards:2adf7a2b-eb72-009b-200f-a05378245b87
msgctxt "h0ac39390g6b24g46c6g8998g9a5fcebebd05"
msgid "Five workin' fingers. Nice and meaty, prime for digging."
msgstr "손가락 다섯 개 다 잘 붙어있구먼. 살집도 적당히 붙어서 땅을 파는 덴 최적이겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards
#. Speaker = Player
#. NodeID = 2bf5104f-718d-61f0-3e96-c9b84fbb0cf3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards:2bf5104f-718d-61f0-3e96-c9b84fbb0cf3
msgctxt "hebd3b6f7g20b9g41dag8609g5275085b30b4"
msgid "You want to see my hands? What for?"
msgstr "내 손을 보고 싶다고? 뭐 때문에?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards
#. Speaker = Ward Magmar
#. NodeID = 2e18dc99-b108-f934-b56c-c9d77206a37f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards:2e18dc99-b108-f934-b56c-c9d77206a37f
msgctxt "hfadc1e4fga91cg4304g8464g3bf47107fbfd"
msgid ""
"Moan all you want - we're born with parts to play. I was born a master, and "
"Stickshit was born a slave."
msgstr "마음껏 징징대라고, 결국 모두가 태어난 순간 역할이 있는 거야. 난 주인으로 태어났고, 여기 스틱좆은 노예로 태어난 거지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards
#. Speaker = Wyll
#. NodeID = 2f7efdc1-65ae-4251-b020-f1e7aa1f12ae
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_WYLL(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards:2f7efdc1-65ae-4251-b020-f1e7aa1f12ae
msgctxt "h7e603ad2ge22bg4456g964dg2da0339aced0"
msgid "Damned slavers. Just the sight of them turns my stomach."
msgstr "망할 노예상 놈들. 놈들의 면상을 보는 것만으로 배가 아파지는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards
#. Speaker = Skickpit
#. NodeID = 3abc4f31-efb3-13bc-1da4-6f4f0fc951d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards:3abc4f31-efb3-13bc-1da4-6f4f0fc951d4
msgctxt "h9efc2f80g81dbg4653ga4c4ga4a3053c2bd9"
msgid "Coming right up, Pisspot."
msgstr "다 왔어, 오줌통."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards
#. Speaker = Ward Magmar
#. NodeID = 3c04c48a-8a08-3009-260c-d78b787c797c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards:3c04c48a-8a08-3009-260c-d78b787c797c
msgctxt "h910eff34g0eb5g437cg99d4g1e88da5643c6"
msgid "Scowl all you want. You got five workin' fingers, perfect for digging."
msgstr "마음껏 쏘아보라고. 너도 손가락이 다섯 개 달렸으니, 알아서 잘 팔 수 있겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards
#. Speaker = Ward Magmar
#. NodeID = 3ccb3eab-6603-8910-817f-388936001f15
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_DuergarCamp_State_SidedMutineers = True
#. SetFlags:
#.   Global:
#.     - UND_ElevatorGuards_State_Did3WayDialogue = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards:3ccb3eab-6603-8910-817f-388936001f15
msgctxt "hd3646483g4227g44d7g924ege0b18b557f84"
msgid "Heard you caused a ruckus. But I'm keeping my butt planted."
msgstr "네가 한바탕 소동을 일으켰다던데. 하지만 내 엉덩이를 움직일 생각은 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards
#. Speaker = Ward Magmar
#. NodeID = 411fc3e5-59c8-69dd-a798-737bc41db60d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards:411fc3e5-59c8-69dd-a798-737bc41db60d
msgctxt "h5409d5b1g6219g41beg94a9g795fac6f1375"
msgid "You just take one. They're swarming the place!"
msgstr "하나 골라 잡아. 이곳에 넘쳐나니까 말이야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards
#. Speaker = Ward Magmar
#. NodeID = 43de6a3a-e035-00cc-a9f9-059c20e6a3dd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - UND_ElevatorGuard001_Event_ExpressedMisgivings(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards:43de6a3a-e035-00cc-a9f9-059c20e6a3dd
msgctxt "ha26248efg7fdfg4243g82d9g8c36a1a8a071"
msgid "That's just the way of it."
msgstr "세상 순리가 그런 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards
#. Speaker = Skickpit
#. NodeID = 4f99d9fc-c157-cb54-9f47-5fbfb650ac4d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards:4f99d9fc-c157-cb54-9f47-5fbfb650ac4d
msgctxt "he5e40004g5de0g4283gaec7g8e62ea71241e"
msgid "Pisspot."
msgstr "오줌통 자식."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards
#. Speaker = Ward Pistle
#. NodeID = 5adc9b1a-769f-ce96-c80b-04471ed26584
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards:5adc9b1a-769f-ce96-c80b-04471ed26584
msgctxt "h2df95090g6b63g49abgaef0g02e40cf9912e"
msgid "You heard the man. Let's see 'em."
msgstr "시키는 대로 해. 손을 보여줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards
#. Speaker = Player
#. NodeID = 5d760ffd-9eec-d565-96fa-993baafa10c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards:5d760ffd-9eec-d565-96fa-993baafa10c1
msgctxt "h8ce583a7g68a2g46a7ga941gc79111a2e313"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards
#. Speaker = Player
#. NodeID = 6c724e9a-f27a-754e-2649-98992cbb0cfc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_ElevatorGuard001_Event_TookASide(3) = False
#.   Tag:
#.      - DWARF(3) = True
#.      - DUERGARDWARF(3) = False
#. SetFlags:
#.   Dialog:
#.     - UND_ElevatorGuard001_Event_TookASide(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards:6c724e9a-f27a-754e-2649-98992cbb0cfc
msgctxt "h94d8d2f3g6b81g4bc4g8ec6g7b238db1643b"
msgid "Enslaving the meek? I see you live up to your cruel reputation."
msgstr "무해한 자들을 노예로 삼은 건가? 너희가 괜히 악명을 얻은 게 아니군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards
#. Speaker = Ward Magmar
#. NodeID = 6f7b2751-ac63-3438-df05-09e367ac9509
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards:6f7b2751-ac63-3438-df05-09e367ac9509
msgctxt "hced67668g9c63g404bg83fegdd715c0306dc"
msgid ""
"Look at ya. Like a slab of cold iron come to life. <i>Made</i> for hard "
"labour."
msgstr "이것 좀 보게. 아주 차가운 쇳덩어리가 살아나 움직이는 것 같군. 중노동을 위해 태어난 정도야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards
#. Speaker = Ward Magmar
#. NodeID = 70ec3929-c95a-4ee2-74a7-24a8b1a04847
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DUERGARDWARF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards:70ec3929-c95a-4ee2-74a7-24a8b1a04847
msgctxt "h255ca24fg2dedg49fcga4b5g3e2b4002368d"
msgid "Hold out your hands, <i>clan-sen.</i>"
msgstr "손을 내밀어 봐, <i>클란센</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards
#. Speaker = Ward Magmar
#. NodeID = 70ec3929-c95a-4ee2-74a7-24a8b1a04847
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards:70ec3929-c95a-4ee2-74a7-24a8b1a04847
msgctxt "hc2814fd2g2934g46dcg82a8gb68745766962"
msgid "Hold out your hands, <i>hoon.</i>"
msgstr "손 좀 줘봐, <i>훈</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards
#. Speaker = Ward Magmar
#. NodeID = 73c5a83f-04d6-1d08-48fd-223a359f113f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards:73c5a83f-04d6-1d08-48fd-223a359f113f
msgctxt "h78a7f88cg4b3bg4ea7gbe69g25a95d827482"
msgid "Hey Stickshit? Where's my drink?"
msgstr "어이 스틱좆? 내 음료는 어딨어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards
#. Speaker = Shadowheart
#. NodeID = 7c1a1170-0800-4364-b114-18f6f5b82404
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards:7c1a1170-0800-4364-b114-18f6f5b82404
msgctxt "hb88a32e7g4b88g4a29g803cg02dff8a749d9"
msgid ""
"If I was that slave, I'd be tempted to add a dash of something poisonous to "
"their drinks."
msgstr "내가 저 노예였다면, 저들의 음료에 독을 타는 걸 참기 어려웠을 것 같은걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards
#. Speaker = Ward Magmar
#. NodeID = 7d1ce1b4-c4d9-6217-de55-634da73ab282
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards:7d1ce1b4-c4d9-6217-de55-634da73ab282
#, fuzzy
msgctxt "hdafc4477geedag44d0gb622g30a2ea361021"
msgid "You want respect? Let your Absolute pay for it. 'Til then, bugger off."
msgstr "존중을 원하나? 그럼, 너희 잘난 절대자보고 돈이나 내라고 해. 그때까진, 꺼져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards
#. Speaker = Ward Magmar
#. NodeID = 87145934-8524-19d4-5d60-266eebf14726
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_ElevatorGuards_State_Did3WayDialogue = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards:87145934-8524-19d4-5d60-266eebf14726
msgctxt "h0aa5caffg14f1g4c08g9e84gb4f16e24d18e"
msgid "True Soul, yeah? Tell the sergeant we won't move a pebble."
msgstr "참된 영혼 아닌가? 하사관한테 우린 자갈 하나도 옮기지 않을 거라고 전해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards
#. Speaker = Gale
#. NodeID = 8f1706b0-6478-4544-b39d-cf9b6b66eb88
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(9) = True
#.   Tag:
#.      - REALLY_GALE(9) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards:8f1706b0-6478-4544-b39d-cf9b6b66eb88
msgctxt "hc20e53e5ge497g4ab3g9999ge3e187540f51"
msgid ""
"I think we've found two duergar who are going to get spit in their drinks."
msgstr "우리 듀에르가 친구들이 곧 침이 들어간 술을 마시게 되겠는걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards
#. Speaker = Player
#. NodeID = 955d637f-142b-414c-97d0-93818561cc6f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards:955d637f-142b-414c-97d0-93818561cc6f
msgctxt "h0c1889adg99e7g4ba0g8a0cg0057bf61b359"
msgid "I don't like your attitude."
msgstr "네 태도가 마음에 들지 않는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards
#. Speaker = Ward Magmar
#. NodeID = 99e2b870-2610-7302-ab7a-72167112f832
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - UND_ElevatorGuard001_Event_ExpressedMisgivings(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards:99e2b870-2610-7302-ab7a-72167112f832
msgctxt "h2c9ab8fcgbe94g4f3cgbac7gfbbd34e6057d"
msgid ""
"You want bygones staying bygones? You keep to your business, and we'll keep "
"to ours."
msgstr "지나간 일은 지나간 대로 놔두고 싶나? 그럼 네 일이나 신경 써, 우리 일에는 신경 끄시고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards
#. Speaker = Ward Magmar
#. NodeID = 9dc66dc9-5c6e-3bf6-cefa-5dafd0f238db
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_ElevatorGuards_State_Did3WayDialogue = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards:9dc66dc9-5c6e-3bf6-cefa-5dafd0f238db
#, fuzzy
msgctxt "ha1066902g4b8bg41fbg84f0gf545b772a1c4"
msgid ""
"Prick-squeak - tell the sergeant we won't move a pebble 'til we're paid."
msgstr "좆만아, 가서 하사관한테 우린 돈을 받기 전까진 자갈 하나도 옮길 생각이 없다고 전해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards
#. Speaker = Ward Magmar
#. NodeID = a5ffe44a-8c9a-f990-b070-93e4f5af2f9c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards:a5ffe44a-8c9a-f990-b070-93e4f5af2f9c
msgctxt "h144476cag993eg405ag8575g3370f8821d71"
msgid "Then you'll appreciate how few shits I have to give ya."
msgstr "그럼 내가 너한텐 좆도 신경도 쓰지 않는다는 사실도 인정하겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards
#. Speaker = Ward Magmar
#. NodeID = a7128d45-dc97-167d-0b39-67a478c474d9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - UND_ElevatorGuard001_Event_ExpressedMisgivings(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards:a7128d45-dc97-167d-0b39-67a478c474d9
msgctxt "ha17df1f5g6894g4f50gbf43g53123e066a1d"
msgid ""
"Besides, nothin' mundane about serving good brew. Stuff's the balm of life, "
"and Stickshit there's got the honour."
msgstr "게다가, 좋은 술을 나르는 게 나쁠 것도 않잖아. 이게 생명의 묘약인데, 우리 스틱좆이 그걸 나르는 영예를 누리고 있다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards
#. Speaker = Ward Magmar
#. NodeID = adff4854-e646-3eb2-be6a-b5964d05b8db
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_TheDrowNere_State_PermaDefeated = True
#. SetFlags:
#.   Global:
#.     - UND_ElevatorGuards_State_Did3WayDialogue = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards:adff4854-e646-3eb2-be6a-b5964d05b8db
msgctxt "he00a9c78g5c3ag45fag984bgd970910d9e11"
msgid "Heard you tore Nere t'bits. But that don't make us friends."
msgstr "네가 니어를 가루로 만들어버렸다는 소식은 들었어. 하지만 그렇다고 우리가 친구가 될 거라는 착각은 하지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards
#. Speaker = Player
#. NodeID = b5c43dc4-36ec-3936-8c30-90442f5379e5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_ElevatorGuard001_Event_TookASide(3) = False
#.   Global:
#.      - UND_TheDrowNere_Event_HadMindMeld = False
#.      - UND_DuergarCamp_State_CaveInCleared = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards:b5c43dc4-36ec-3936-8c30-90442f5379e5
msgctxt "hf2053bb5g428eg4534gbb67g4a891ba34f91"
msgid "I heard a True Soul was trapped. Shouldn't you be helping?"
msgstr "참된 영혼이 갇혀버렸다고 들었는데. 그걸 도와야 하지 않나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards
#. Speaker = Player
#. NodeID = bb478d38-6a4c-b140-e109-03960f31f056
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_ElevatorGuard001_Event_TookASide(3) = False
#. SetFlags:
#.   Dialog:
#.     - UND_ElevatorGuard001_Event_TookASide(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards:bb478d38-6a4c-b140-e109-03960f31f056
msgctxt "h1cd55685g50b0g4dabga80fgf84dcf626ddb"
msgid "You disgust me, slaver. How do you live with yourself?"
msgstr "날 역겹게 만드는군, 노예상. 이런 짓을 하면서 어떻게 스스로를 혐오하지 않을 수 있는 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards
#. Speaker = Astarion
#. NodeID = bbbeea07-69f7-4c16-a077-e0fd4988b22a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_ASTARION(7) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards:bbbeea07-69f7-4c16-a077-e0fd4988b22a
msgctxt "h8a7db6d9gbed0g4f46gb202ge0c9057cc466"
msgid "Now that's how you motivate the staff."
msgstr "동기 부여는 그렇게 하는 거지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards
#. Speaker = Ward Magmar
#. NodeID = bc4d4d45-bc46-9d56-1090-2e487468983c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards:bc4d4d45-bc46-9d56-1090-2e487468983c
msgctxt "h38220769g70dfg4629gaa18gb96dc4ff66be"
msgid "Laduguer's guts - it's time I shut you up."
msgstr "러더거의 내장이여, 널 닥치게 만들어 줘야겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards
#. Speaker = Wyll
#. NodeID = c1d53752-825a-5ff0-b5c8-ddcbe6b450ae
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards:c1d53752-825a-5ff0-b5c8-ddcbe6b450ae
msgctxt "h543c2d0dgbd21g4991gb6cfg5c2955ba4fd8"
msgid "Some thoughts aren't meant to be said aloud. That was one of them."
msgstr "가끔 생각이 입 밖으로 튀어나올 때가 있잖아. 방금이 딱 그거였어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards
#. Speaker = Player
#. NodeID = c343f7f2-e97b-d464-4ff5-c1363623914f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards:c343f7f2-e97b-d464-4ff5-c1363623914f
msgctxt "h264a0507gd781g4949ga04fg65a602973487"
msgid "You're quite the blowhard. I can appreciate that."
msgstr "네 성질머리 하나는 인정해 줄 만하군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards
#. Speaker = Ward Magmar
#. NodeID = c480a337-f6ac-b3a7-13fd-400ceeb33ad1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - UND_ElevatorGuard001_Event_ExpressedMisgivings(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards:c480a337-f6ac-b3a7-13fd-400ceeb33ad1
msgctxt "hbc0cd057gd455g41e4gac65ga308fc526ea2"
msgid ""
"I kick up my feet, order a brew, watch 'em work. They'll complain, but they "
"love it, I'm telling you."
msgstr ""
"일어나서, 맥주나 한잔 시키고, 이 자식들이 일하는 걸 구경하는 거지. 불평을 해대긴 하지만, 분명 놈들은 자기가 하는 일을 사랑한다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards
#. Speaker = Ward Magmar
#. NodeID = c56d5461-e0cd-d3be-5351-c02bb6322164
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards:c56d5461-e0cd-d3be-5351-c02bb6322164
msgctxt "h20cef6c9geb48g43acgbffegc7667a9caa12"
msgid "And I don't like pigshit, but damned if your mouth ain't spewing it."
msgstr "그리고 난 돼지똥이라면 질색인데, 네 좆같은 입에서 그게 쏟아져 나오는구만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards
#. Speaker = Ward Magmar
#. NodeID = ca6f65e6-6819-4c52-4194-13de5976967e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards:ca6f65e6-6819-4c52-4194-13de5976967e
msgctxt "h55616160gedc1g46d0ga0d6gc7887817d3b5"
msgid "Comfortably. Figured it obvious."
msgstr "난 아주 편안한데. 당연한 거잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards
#. Speaker = Ward Magmar
#. NodeID = cc258312-ee7f-f75f-5dd7-329960412754
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards:cc258312-ee7f-f75f-5dd7-329960412754
msgctxt "h827c384ag56efg4a73gb7ebg0d5d40fd59ed"
msgid "Another round, Stickshit."
msgstr "한잔 더, 스틱좆."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards
#. Speaker = Player
#. NodeID = ce9a2872-6ddc-ee24-ecc0-abd0a81fa225
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_ElevatorGuard001_Event_TookASide(3) = False
#. SetFlags:
#.   Dialog:
#.     - UND_ElevatorGuard001_Event_TookASide(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards:ce9a2872-6ddc-ee24-ecc0-abd0a81fa225
msgctxt "hf52435a9g88ccg4217g8bc4g3430935c84b6"
msgid "Your captive is most entertaining. How might I get one of my own?"
msgstr "아주 재미있는 포로를 잡아두고 있네. 나도 하나 가지고 싶은데, 어디서 났지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards
#. Speaker = Ward Magmar
#. NodeID = d2e99c2e-d521-b6bc-35d3-534a19a971db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards:d2e99c2e-d521-b6bc-35d3-534a19a971db
msgctxt "h29e7d19dgea4eg44a7gbc25g7aec4e45759e"
msgid "Less asking. More showing."
msgstr "그만 묻고. 직접 보여줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ElevatorGuards
#. Speaker = Ward Magmar
#. NodeID = d468f404-7e25-de4e-5640-550eb163a68b
#. HandlePath = TaggedText[0].TagText[0]
