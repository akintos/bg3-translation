#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditLockpickerWander:49aaaf3e-a051-3a47-3e9e-69d463564fd1
msgctxt "hca10499dg1870g40c2g928egcee4afffc7ab"
msgid "Show yourself!"
msgstr "당장 나타나라고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditLockpickerWander
#. Speaker = Mari
#. NodeID = 67876433-5570-4466-3d09-a3eaf31ed3eb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - ae5c9a07-95f8-2574-a833-b223642e36fb_step2 = True
#. SetFlags:
#.   Local:
#.     - ae5c9a07-95f8-2574-a833-b223642e36fb_step1 = False
#.     - ae5c9a07-95f8-2574-a833-b223642e36fb_step2 = False
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditLockpickerWander:67876433-5570-4466-3d09-a3eaf31ed3eb
msgctxt "hf22e8750g401dg40e5gb7f2gff389d275486"
msgid "Come on, coward! Let's get this over with!"
msgstr "덤벼 봐, 겁쟁아! 어디 끝장을 보자니까!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditLockpickerWander
#. Speaker = Mari
#. NodeID = 98ab466d-9748-9000-1fc5-1ded7bd63d52
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - ae5c9a07-95f8-2574-a833-b223642e36fb_step1 = True
#. SetFlags:
#.   Local:
#.     - ae5c9a07-95f8-2574-a833-b223642e36fb_step1 = False
#.     - ae5c9a07-95f8-2574-a833-b223642e36fb_step2 = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditLockpickerWander:98ab466d-9748-9000-1fc5-1ded7bd63d52
msgctxt "h62f52ed7gfcb3g43f5g8548g8190362679d0"
msgid "You killed my friend. Answer to me. <i>Now!</i>"
msgstr "네가 내 친구를 죽였지! 대답해. <i>당장!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditOpenDoorBanter
#. Speaker = Barton
#. NodeID = 121c4dda-b204-60b9-2153-6f8f61a8143e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - e743eea4-69cf-b485-b7ca-6f359578a2ba_Step1 = True
#. SetFlags:
#.   Local:
#.     - e743eea4-69cf-b485-b7ca-6f359578a2ba_Step2 = True
#.     - e743eea4-69cf-b485-b7ca-6f359578a2ba_Step1 = False
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditOpenDoorBanter:121c4dda-b204-60b9-2153-6f8f61a8143e
msgctxt "h673b84f7g88beg4633g9f0eg8a6474e120c6"
msgid "No... you must've done something without realising. Stroke of luck."
msgstr "아니... 네가 자기도 모르게 뭔가 한 거겠지. 땡잡았는걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditOpenDoorBanter
#. Speaker = Mari
#. NodeID = 7f612170-ce92-db33-a6ca-85040e516970
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - e743eea4-69cf-b485-b7ca-6f359578a2ba_Step1 = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditOpenDoorBanter:7f612170-ce92-db33-a6ca-85040e516970
msgctxt "h3faeb36bg8da6g49c7g8a1fgf72d43a443ca"
msgid "No, listen! I didn't open it. Did you touch something? A lever?"
msgstr "아니, 들어 봐! 내가 연 게 아니야. 혹시 네가 뭐라도 건드렸어? 손잡이 같은 거?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditOpenDoorBanter
#. Speaker = Mari
#. NodeID = b20be29c-e41c-f6a5-3b36-e724186efda9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - e743eea4-69cf-b485-b7ca-6f359578a2ba_Step2 = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditOpenDoorBanter:b20be29c-e41c-f6a5-3b36-e724186efda9
msgctxt "hb599d356g2e32g47b5g8c04gafb622b9147a"
msgid "I know when I've got a lock beaten and I didn't beat this one."
msgstr "내가 자물쇠 딴 거면 내가 모를 리 없다고. 이건 내가 한 게 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditOpenDoorBanter
#. Speaker = Mari
#. NodeID = bcaa13e5-3058-9b4b-2aba-0961c92d8186
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CHA_FL1_Event_OpenDoorBanterOver = True
#.   Local:
#.     - e743eea4-69cf-b485-b7ca-6f359578a2ba_Step2 = False
#.     - e743eea4-69cf-b485-b7ca-6f359578a2ba_Step1 = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditOpenDoorBanter:bcaa13e5-3058-9b4b-2aba-0961c92d8186
msgctxt "hcd2f4ce3ga31bg483egbbcfg508a718fc3eb"
msgid "Maybe. But keep on your guard."
msgstr "그럴수도. 그래도 조심들 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditOpenDoorBanter
#. Speaker = Barton
#. NodeID = c914c7b4-8127-413d-f21f-ddfee98d3922
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditOpenDoorBanter:c914c7b4-8127-413d-f21f-ddfee98d3922
msgctxt "h51e06715g4591g49e9gb344gfa602b7ba2b3"
msgid "Maybe it just broke by itself. This place is ancient."
msgstr "저절로 따진 걸지도 모르지. 여긴 엄청 오래된 곳이잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditOpenDoorBanter
#. Speaker = Mari
#. NodeID = ef5a2f57-d3b6-5b70-51a5-626ad0028ce7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - e743eea4-69cf-b485-b7ca-6f359578a2ba_Step2 = False
#.      - e743eea4-69cf-b485-b7ca-6f359578a2ba_Step1 = False
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditOpenDoorBanter:ef5a2f57-d3b6-5b70-51a5-626ad0028ce7
msgctxt "h7e924894g650cg4954g825bg0a8ed1c2dd12"
msgid "Barton, the door's open!"
msgstr "바톤, 문이 열렸어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditOpenDoorBanter
#. Speaker = Barton
#. NodeID = fe3f0fdc-d1fb-07a9-2911-14e35066f2fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditOpenDoorBanter:fe3f0fdc-d1fb-07a9-2911-14e35066f2fd
msgctxt "h62a0b198g70aeg415agaceagd8ef40e2681b"
msgid "Finally! I was starting to think we'd have to chop it down..."
msgstr "드디어! 문짝을 쪼개버려야 하는 건지 고민 들던 참이었다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditSanctumAlert
#. Speaker = Barton
#. NodeID = 56d991dd-cf6a-9d2a-9da2-3890bdb3d871
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditSanctumAlert:56d991dd-cf6a-9d2a-9da2-3890bdb3d871
msgctxt "h214c0cf4g8f00g49fagba8bge921a1cd581f"
msgid "You hear that? Blades out!"
msgstr "저 소리 들었어? 무기 꺼내!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditSanctumSearching
#. Speaker = Barton
#. NodeID = 19a387e9-ac02-a235-bc7e-b450b152ff53
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4c78f756-720d-a285-a3e6-8f69a6069abc_Step2 = False
#.      - 4c78f756-720d-a285-a3e6-8f69a6069abc_Step1 = False
#. SetFlags:
#.   Local:
#.     - 4c78f756-720d-a285-a3e6-8f69a6069abc_Step1 = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditSanctumSearching:19a387e9-ac02-a235-bc7e-b450b152ff53
msgctxt "h1965e57cg9f01g498bg850cg708e29f73871"
msgid "Rotten food, dusty altars... where's the bloody treasure?"
msgstr "썩은 음식에, 먼지투성이 제단뿐이군... 망할 보물은 어디 있는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditSanctumSearching
#. Speaker = Barton
#. NodeID = 401c1794-2d96-5dbb-aba4-aeda82518416
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4c78f756-720d-a285-a3e6-8f69a6069abc_Step1 = True
#. SetFlags:
#.   Local:
#.     - 4c78f756-720d-a285-a3e6-8f69a6069abc_Step2 = True
#.     - 4c78f756-720d-a285-a3e6-8f69a6069abc_Step1 = False
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditSanctumSearching:401c1794-2d96-5dbb-aba4-aeda82518416
msgctxt "hc4fc2d7bgba93g48begbf6cgfe97725511b9"
msgid "At least there's no skeletons this time."
msgstr "그나마 이번엔 해골바가지는 없네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditSanctumSearching
#. Speaker = Barton
#. NodeID = 5c89c60b-2cfe-bb3a-331c-d4444938112d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4c78f756-720d-a285-a3e6-8f69a6069abc_Step2 = True
#. SetFlags:
#.   Local:
#.     - 4c78f756-720d-a285-a3e6-8f69a6069abc_Step2 = False
#.     - 4c78f756-720d-a285-a3e6-8f69a6069abc_Step1 = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditSanctumSearching:5c89c60b-2cfe-bb3a-331c-d4444938112d
msgctxt "h9f975d4eg0107g4707gba23g0c7ef0bf440c"
msgid "I ain't going home empty-handed again..."
msgstr "또 빈손으로 집에 돌아갈 순 없다고..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditSanctumSpotting
#. Speaker = Barton
#. NodeID = 0e01675b-8ab3-2570-9a3f-445c04848dbb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditSanctumSpotting:0e01675b-8ab3-2570-9a3f-445c04848dbb
msgctxt "hee1f85eag5dc7g48begb70dge062c4687f2c"
msgid "Clear off - we got here <i>first</i>!"
msgstr "당장 꺼져. 여긴 우리가 <i>먼저 </i> 찜했다고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditsSanctumWaitingAlert
#. Speaker = Mari
#. NodeID = 20d15a3a-4ec3-cd1d-867e-9617bc19a132
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditsSanctumWaitingAlert:20d15a3a-4ec3-cd1d-867e-9617bc19a132
msgctxt "h91f50731gf638g46c7g976dg3f60b847cbca"
msgid "Maybe we should go take a look."
msgstr "한번 살펴보러 가는 게 좋겠는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditsSanctumWaitingAlert
#. Speaker = Haseid
#. NodeID = 33dc53ee-b3aa-82e0-6ea1-b4671968d4c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditsSanctumWaitingAlert:33dc53ee-b3aa-82e0-6ea1-b4671968d4c4
msgctxt "he2def78fg9891g41b4ga4eag62023b6d8ebd"
msgid "All clear."
msgstr "텅 비었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditsSanctumWaitingAlert
#. Speaker = Barton
#. NodeID = 41de5bb2-f1a2-4c19-85a4-2b0632663f31
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 9b693c09-49f2-8f76-b5a5-986e6570cfd8_A = True
#. SetFlags:
#.   Local:
#.     - 9b693c09-49f2-8f76-b5a5-986e6570cfd8_B = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditsSanctumWaitingAlert:41de5bb2-f1a2-4c19-85a4-2b0632663f31
msgctxt "h30a44d2egb160g4dacg8988ga4d2727f8b97"
msgid "Keep looking. Something's up."
msgstr "계속 살펴 봐. 뭔가가 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditsSanctumWaitingAlert
#. Speaker = Mari
#. NodeID = 5c58d8aa-02dc-f624-1781-60b6e097147e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditsSanctumWaitingAlert:5c58d8aa-02dc-f624-1781-60b6e097147e
msgctxt "hc049e8ddg3a70g4db0g8c6ag4a8ec28496bc"
msgid "Well it is a crypt, ain't it? Rot's to be expected."
msgstr "여긴 묘실이잖아, 안 그래? 구린내는 당연한 거라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditsSanctumWaitingAlert
#. Speaker = Haseid
#. NodeID = 61058edc-d72f-d184-64aa-30e5f6735a8b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditsSanctumWaitingAlert:61058edc-d72f-d184-64aa-30e5f6735a8b
msgctxt "h151f1532gcc89g4b7dg8ed6g61f146cb92d1"
msgid "Not a chance - could be a trap. Just keep your eyes peeled."
msgstr "말 같잖은 소리. 함정 쳐놨을 수도 있다고. 그냥 한눈팔지나 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditsSanctumWaitingAlert
#. Speaker = Haseid
#. NodeID = 80e05d3c-b28d-190c-d116-f9e5635a560e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditsSanctumWaitingAlert:80e05d3c-b28d-190c-d116-f9e5635a560e
msgctxt "h8164fe60ga4fdg40dbg9749g7d65dc6b304f"
msgid "Shut it. This is no time for joking around."
msgstr "닥쳐. 지금 농담 따먹기나 하고 있을 때냐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditsSanctumWaitingAlert
#. Speaker = Mari
#. NodeID = 956262b3-289b-2001-1e3e-d35a3ced2a80
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditsSanctumWaitingAlert:956262b3-289b-2001-1e3e-d35a3ced2a80
msgctxt "ha7cbd803g5f0eg47ebgb5dcg3896f40c0d13"
msgid "Nothing."
msgstr "아무것도."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditsSanctumWaitingAlert
#. Speaker = Haseid
#. NodeID = b99ba701-4134-460a-4f89-3d83243eb202
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditsSanctumWaitingAlert:b99ba701-4134-460a-4f89-3d83243eb202
msgctxt "h15c4f034g5855g44fag8d9dg50717d480e2f"
msgid "No such thing as coincidences when there's loot to be had."
msgstr "보물이 걸린 상황에선 우연 따윈 존재하지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditsSanctumWaitingAlert
#. Speaker = Barton
#. NodeID = be592d7a-d744-4ecb-b7c3-6c0b5790bb70
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 9b693c09-49f2-8f76-b5a5-986e6570cfd8_B = True
#. SetFlags:
#.   Local:
#.     - 9b693c09-49f2-8f76-b5a5-986e6570cfd8_C = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditsSanctumWaitingAlert:be592d7a-d744-4ecb-b7c3-6c0b5790bb70
msgctxt "hfc08ad17g5b65g4fd8gba91g9f3b07db1c33"
msgid "What're Gimblebock and the others doing up there?"
msgstr "김블보크랑 딴 녀석들은 대체 저 위에서 뭘 하고 있는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditsSanctumWaitingAlert
#. Speaker = Barton
#. NodeID = d4bf1be8-f1f9-4766-81a3-183001eb0cdc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 9b693c09-49f2-8f76-b5a5-986e6570cfd8_A = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditsSanctumWaitingAlert:d4bf1be8-f1f9-4766-81a3-183001eb0cdc
msgctxt "hce7ae16fgc351g4dfagb551ga3497a9c467e"
msgid "See anything?"
msgstr "뭐라도 찾았어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditsSanctumWaitingAlert
#. Speaker = Mari
#. NodeID = d66d70a6-3de1-efb4-5237-5b8fd357956c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditsSanctumWaitingAlert:d66d70a6-3de1-efb4-5237-5b8fd357956c
msgctxt "h70d9c0a9g1b8cg4ee4g9775g2f6d7e95f2b1"
msgid "This place is falling apart - could've happened by itself."
msgstr "여긴 허물어지고 있잖아. 저절로 벌어진 소란일지도 모르지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditsSanctumWaitingAlert
#. Speaker = Barton
#. NodeID = fe960081-b616-4980-9b1c-28f1b73e40a2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 9b693c09-49f2-8f76-b5a5-986e6570cfd8_C = True
#. SetFlags:
