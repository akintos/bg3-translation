#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead:f38bde12-8694-b71b-2a7f-df781eff9ebc
msgctxt "h648e3660gaddbg4796gac16ge74b952463d0"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead
#. Speaker = Auntie Ethel
#. NodeID = f3d85a52-d673-dec3-2d89-124f39e9125b
#. HandlePath = TaggedText[0].TagText[0]
