#, fuzzy
msgctxt "h8512f896gfd07g4df7ga43cgf38c8848224f"
msgid "<i>Complexum tuum, ab terra ortum, ad nos defer.</i>"
msgstr "<i>콤플렉숨 투움, 아브 테라 오르툼, 아드 노스 데페르.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_RitualDruid5
#. Speaker = Tahan
#. NodeID = d01f855b-0256-145a-a6ac-17c70c36b3b5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_SacredPond_Event_RitualChantD = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_RitualDruid5:d01f855b-0256-145a-a6ac-17c70c36b3b5
#, fuzzy
msgctxt "he4ba6335g9d6cg4e24gb9b4g6b808eb21c76"
msgid "<i>Ab spiritu humoque, aculeus vitisque.</i>"
msgstr "<i>아브 스피리투 우모크, 아쿨레우스 비티스퀘.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_RitualDruid5
#. Speaker = Tahan
#. NodeID = f7579297-145e-e39a-9497-a6ab149a3cd3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_RitualDruid_HasMet_Left5(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_RitualDruid5:f7579297-145e-e39a-9497-a6ab149a3cd3
msgctxt "hc756c7b9g7b92g418agad38g072d7017b1d9"
msgid "This will happen again. We won't have you to rescue us when it does."
msgstr "또 이런 일이 벌어지겠지. 그땐 우릴 구해줄 사람이 없을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_RitualDruid5
#. Speaker = Tahan
#. NodeID = f849d133-52fb-0a71-4af3-ab573f0143ee
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_SacredPond_Event_RitualChantB = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_RitualDruid5:f849d133-52fb-0a71-4af3-ab573f0143ee
#, fuzzy
msgctxt "h0996958cgd33fg41d5gad02gf16968877bb2"
msgid "<i>Defende nos ab imminentibus aequilibrio tuo.</i>"
msgstr "<i>데펜데 노스 아브 임미넨티부스 아이퀼리브리오 투오.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_001
#. Speaker = Narrator
#. NodeID = 079b9375-c14e-4106-e9ed-d35340e2c6c7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_001:079b9375-c14e-4106-e9ed-d35340e2c6c7
msgctxt "h69c92ed8gad0ag404bgb6d9gc648812bac02"
msgid "*The rat watches your movements but does not speak.*"
msgstr "*쥐가 당신의 움직임을 관찰하지만 어떤 말도 꺼내지 않습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_001
#. Speaker = Narrator
#. NodeID = 20c63fc7-8e35-7fdc-65c9-9bc874e516c3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruidRats_Event_RememberedLetter = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_001:20c63fc7-8e35-7fdc-65c9-9bc874e516c3
msgctxt "h76449a57g5e2ag46b0g94d5gbbbdc29d24df"
msgid "*The rat scrutinises your every movement.*"
msgstr "*쥐가 당신의 모든 움직임을 면밀히 관찰하고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_001
#. Speaker = Narrator
#. NodeID = 4742671e-7cd9-98d1-8b61-da274778a108
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = True
#.   User:
#.      - DEN_ShadowDruids_DruidHasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_001:4742671e-7cd9-98d1-8b61-da274778a108
msgctxt "h919cf82ega896g4338g9b60g4171df32c978"
msgid ""
"*...then slips into view. The spectre of Shadow Druids in animal form, right "
"under your feet.*"
msgstr "*...그러더니 시야에 들어옵니다. 동물 형상을 한 그림자 드루이드의 요원이, 당신 발 밑에 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_001
#. Speaker = Olodan
#. NodeID = 4fc213fa-d261-a96c-12fa-d27d035aa32b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_001:4fc213fa-d261-a96c-12fa-d27d035aa32b
msgctxt "hf3b4e8a3g0a33g4f11ga42cgd0a7ed11a978"
msgid "*Ckty-ch-ch.*"
msgstr "*찍찍찍*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_001
#. Speaker = Narrator
#. NodeID = 6b577cc5-a38f-a57f-9b66-38cbb5c6543d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_001:6b577cc5-a38f-a57f-9b66-38cbb5c6543d
msgctxt "h7ed67242gcf29g41e6g9175g9b38636e718f"
msgid ""
"*...then slips into view. Kagha's rats might not be simple familiars, but "
"shapeshifted Shadow Druids.*"
msgstr "*...그러더니 시야에 들어옵니다. 카그하의 쥐는 단순한 패밀리어가 아니라, 형상 변환한 그림자 드루이드일지도 모릅니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_001
#. Speaker = Narrator
#. NodeID = 9350a3de-2647-95f4-f96d-1cda89bcde1f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_001:9350a3de-2647-95f4-f96d-1cda89bcde1f
msgctxt "h90c186eegd458g4cacga1c9g36c5b2759625"
msgid "*The rat is otherwise silent in the face of your accusation.*"
msgstr "*쥐는 당신의 비난에도 침묵할 뿐입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_001
#. Speaker = Player
#. NodeID = 9d746dda-4431-1626-1488-7fc9838fc96f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_001:9d746dda-4431-1626-1488-7fc9838fc96f
msgctxt "h7879245bgf62eg4b8ag8798g8805004f4bd8"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_001
#. Speaker = Narrator
#. NodeID = 9f997e51-af85-5f1f-d403-fd64273e9c36
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_001:9f997e51-af85-5f1f-d403-fd64273e9c36
msgctxt "hbffc2427g0b51g4fa9gab20gdc408f795a8f"
msgid "*... but slips away before it comes into focus.*"
msgstr "*... 하지만 집중하기도 전에 이것이 달아납니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_001
#. Speaker = Narrator
#. NodeID = ccc907c5-d1e9-404b-082f-04a2727814b2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = True
#.   User:
#.      - DEN_ShadowDruids_DruidHasMet(1) = False
#. SetFlags:
#.   User:
#.     - DEN_ShadowDruids_DruidHasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_001:ccc907c5-d1e9-404b-082f-04a2727814b2
msgctxt "h195d95f6g0b7bg4a15gbdacgad40eb48efe4"
msgid ""
"*You see a sharp intelligence behind its eyes. Is it a familiar or another "
"druid enjoying their wildshape?*"
msgstr "*당신은 이것의 눈에 날카로운 지성이 숨어있음을 발견합니다. 패밀리어거나 야생 형상을 한 다른 드루이드일까요?*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_001
#. Speaker = Player
#. NodeID = cf9ad8f7-892c-b8e1-cb85-4d97b41a48e4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_001:cf9ad8f7-892c-b8e1-cb85-4d97b41a48e4
msgctxt "hc1aca8d0g7e6dg4b81ga988g76d658a0bb26"
msgid "I know the truth. You are a Shadow Druid."
msgstr "나는 진실을 알고 있어. 너는 그림자 드루이드라는 것을."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_001
#. Speaker = Narrator
#. NodeID = dcea9088-658d-51ac-44e2-1f256fae9998
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_001:dcea9088-658d-51ac-44e2-1f256fae9998
msgctxt "hfc008ff5g7ae6g470ag8946g2164ee091e0b"
msgid ""
"*The creature's whiskers go still for a moment before resuming their nervous "
"jitter.*"
msgstr "*이 생물의 수염은 잠시 가만히 있다가 다시 불안하게 떨기 시작합니다..*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_001
#. Speaker = Narrator
#. NodeID = dff945b7-48ff-c94b-fd01-9307afba87de
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = True
#.   User:
#.      - DEN_ShadowDruids_DruidHasMet(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_001:dff945b7-48ff-c94b-fd01-9307afba87de
msgctxt "h64a6fc71g102eg419fg97fcg2f1ef10695a5"
msgid ""
"*...what if it's neither pest nor familiar - but another druid in animal "
"form?*"
msgstr "*...이것이 유해 동물도 패밀리어도 아니라 - 동물 형상을 한 다른 드루이드라면 어떨까요?*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_001
#. Speaker = Narrator
#. NodeID = fcab8bff-ab8c-e91e-c271-f28b19a8be7e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
