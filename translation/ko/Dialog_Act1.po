#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_Well_State_Worsened = True
#. SetFlags:
#.   Global:
#.     - HAG_Hag_State_SaidGoodbye = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_AD_TeleportSurrogateMother:18b105fc-19ea-7e2e-89ea-1e1304249620
msgctxt "he4b7786egf14fg4b61g9d47g2c44bb6317d3"
msgid "Bye-bye, lovelies! Oh, and enjoy my well water. Hah!"
msgstr "잘 가렴, 얘들아! 아, 그리고 내 우물물은 마음껏 즐기렴. 하!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_AD_TeleportSurrogateMother
#. Speaker = Auntie Ethel
#. NodeID = a135c28f-0812-06f6-af03-5c8977e68058
