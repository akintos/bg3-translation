msgctxt "h6adfb399gb4f0g4e14gb701gb19a7e9d5984"
msgid ""
"He of the Unsleeping Eyes. Grant me the might to carry this burden. Grant me "
"the faith to face darkness without fear."
msgstr "잠들지 않는 눈을 가진 자시여. 제게 이 짐을 짊어질 힘을 주소서. 두려움 없이 어둠에 맞설 수 있는 믿음을 주소서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5
#. Speaker = Fist Recruit Ephren
#. NodeID = 12afa9a6-6425-d93a-4559-f8c6603e7bf3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5:12afa9a6-6425-d93a-4559-f8c6603e7bf3
msgctxt "h0eaa9855g81c8g4a98gaf1fgc42f705bdde6"
msgid "No. We've suffered enough losses."
msgstr "아니. 이미 충분히 많은 이들을 잃었어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5
#. Speaker = Player
#. NodeID = 150d45c2-1577-4b3d-823f-b85db2f8c7de
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - a5416f1a-6435-7f72-5d84-8cd747fcda7d_MindHasBeenRead = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5:150d45c2-1577-4b3d-823f-b85db2f8c7de
msgctxt "h97a23a53g27bcg4191gaedbg16017c717717"
msgid "I am no monster - I mean no harm to you. Tell me what happened here."
msgstr "난 괴물이 아니야 - 당신을 해치려는 의도는 없어. 그냥 이곳에 무슨 일이 벌어진 건지 설명이 필요해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5
#. Speaker = Fist Recruit Ephren
#. NodeID = 15b4720f-42ac-5239-bd7e-0869b0825258
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5:15b4720f-42ac-5239-bd7e-0869b0825258
msgctxt "h8b0d98b6g993ag4c9agabe5g80034862572b"
msgid "You're... you're different than the others. I can tell."
msgstr "당신... 당신은 다른 이들과 다르군요, 알 수 있어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5
#. Speaker = Fist Recruit Ephren
#. NodeID = 16dfda18-b0a4-572f-c2e5-a571d7058312
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5:16dfda18-b0a4-572f-c2e5-a571d7058312
msgctxt "h20a95db5ge333g4132gb47cg8f446ca97e63"
msgid ""
"He should never have been here in the first place. I'm the one that talked "
"him into joining the Fist."
msgstr "그는 애초에 여기 오지 말았어야 했어요. 제가 그를 설득해서 피스트에 합류하게 만들었어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5
#. Speaker = Fist Recruit Ephren
#. NodeID = 1a429f9b-8945-9411-34b8-312631d6111a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_FlamingFist5_HasMet_PuttingOutFire(1) = True
#.   Global:
#.      - PLA_TavernInvestigation_State_BurntDown = False
#.      - PLA_FlamingFist6_State_OutOfTrigger = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5:1a429f9b-8945-9411-34b8-312631d6111a
msgctxt "hb725256fg7076g483fgba7eg946d40ac2a8c"
msgid "Back, I say!"
msgstr "물러서라고 했잖아요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5
#. Speaker = Player
#. NodeID = 1def35f1-5a8e-0462-c535-8980abbb88d6
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5:1def35f1-5a8e-0462-c535-8980abbb88d6
msgctxt "h0cb23c4cg95e4g4662gb0b2g712def68d0c0"
msgid ""
"Think carefully, <i>colnbluth. </i>Do you truly wish to anger Lolth's "
"favoured?"
msgstr "현명히 행동해라, <i>콜른블러스. </i> 감히 롤쓰의 총애를 받는 이의 화를 돋우려는 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5
#. Speaker = Player
#. NodeID = 20fcb30d-85db-972c-8729-74dcd3085fe2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5:20fcb30d-85db-972c-8729-74dcd3085fe2
msgctxt "h7c967d1bg764cg4c12g8f0cg1ff36f1d84be"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5
#. Speaker = Player
#. NodeID = 21ba9b73-90cd-0c98-67b5-cb6a58596dc2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - PLA_FlamingFist5_Knows_ReactedToDeath(1) = False
#.   Tag:
#.      - PALADIN(1) = True
#.      - OATHBREAKER(1) = False
#. SetFlags:
#.   Object:
#.     - PLA_FlamingFist5_Event_Prayed(1) = True
#.     - PLA_FlamingFist5_Knows_ReactedToDeath(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5:21ba9b73-90cd-0c98-67b5-cb6a58596dc2
msgctxt "h0f6f5fabg800bg4470gbf32g68b50ce84b1b"
msgid ""
"<i>Let the prayer finish. The dead should be honoured as their oath "
"commands.</i>"
msgstr "<i>기도를 마칠 때까지 기다린다. 죽은 자는 그들의 맹세에 따라 존중받아야 한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5
#. Speaker = Player
#. NodeID = 243d628f-8ddd-61c3-2a05-17033ad3ff1b
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#. TagRule: BERSERKER
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5:243d628f-8ddd-61c3-2a05-17033ad3ff1b
msgctxt "hb832e520g0119g4e49g8dedge26272c60e0a"
msgid "<b>TRY IT, WEAKLINGS. </b>"
msgstr "<b>해 보시지, 열등한 종족.</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5
#. Speaker = Player
#. NodeID = 243d628f-8ddd-61c3-2a05-17033ad3ff1b
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5:243d628f-8ddd-61c3-2a05-17033ad3ff1b
msgctxt "h3d879538gcd6fg4bb0g8457g5cec2732d9a8"
msgid "Go on, <b>try it.</b>"
msgstr "어디 한번, <b>해 봐.</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5
#. Speaker = Fist Recruit Ephren
#. NodeID = 42f01619-747c-0a73-00f9-04dd9cf9a9a1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5:42f01619-747c-0a73-00f9-04dd9cf9a9a1
msgctxt "h3b16c84bg4628g45b4g8548g51a9d9c995eb"
msgid "Would that the arrow had pierced <i>your</i> heart instead."
msgstr "놈들 화살이 <i>당신</i> 심장에 대신 꽂혔어야 했는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5
#. Speaker = Fist Recruit Ephren
#. NodeID = 4826041f-b556-3308-5720-b986054a138c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_FlamingFist7_State_Permadefeated = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5:4826041f-b556-3308-5720-b986054a138c
msgctxt "h931dc796gb8f2g41d0g8a8cg418710dad092"
msgid "Speak to the Gauntlet. She'll tell you more."
msgstr "건틀릿 님과 이야기해 보세요. 그녀가 더 알려줄 수 있을 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5
#. Speaker = Player
#. NodeID = 4c6f513b-18ee-27c6-ebcd-87b257edc749
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - PLA_FlamingFist5_Knows_ReactedToDeath(1) = False
#.   Tag:
#.      - CLERIC_HELM(1) = True
#. SetFlags:
#.   Object:
#.     - PLA_FlamingFist5_Event_Prayed(1) = True
#.     - PLA_FlamingFist5_Knows_ReactedToDeath(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5:4c6f513b-18ee-27c6-ebcd-87b257edc749
msgctxt "h08f05834g9a3eg425aga62fg8d3cc81d9c73"
msgid "<i>Join the woman in prayer: </i>'Steel our blades...'"
msgstr "<i>여인의 기도에 동참한다:</i> '우리의 칼날을 갈아주시고...'"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5
#. Speaker = Fist Recruit Ephren
#. NodeID = 4d55b146-c57f-3851-a848-eb5842c191c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5:4d55b146-c57f-3851-a848-eb5842c191c0
msgctxt "hc5155e9dg1f77g4642ga083gd543c279751c"
msgid "Please. Just leave me be."
msgstr "부탁드립니다. 그냥 저를 내버려두세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5
#. Speaker = Player
#. NodeID = 4f3ddeef-c2b1-a3a9-e5f4-e03af0c53df9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - PLA_FlamingFist5_Knows_ReactedToDeath(1) = False
#.   Tag:
#.      - BALDURIAN(1) = False
#. SetFlags:
#.   Object:
#.     - PLA_FlamingFist5_Knows_ReactedToDeath(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5:4f3ddeef-c2b1-a3a9-e5f4-e03af0c53df9
msgctxt "hde204af9g2222g4b9bg8d68gefe49c00aa0b"
msgid "Looks like he wasn't cut out for this line of work."
msgstr "그는 이런 일을 견디기에 적합하지 않았나 보군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5
#. Speaker = Fist Recruit Ephren
#. NodeID = 5d1110e0-368c-c60b-0ddb-70cf52d75757
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_FlamingFist7_State_Permadefeated = True
#. SetFlags:
#.   Global:
#.     - PLA_FlamingFists_State_PersuadedDrow = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5:5d1110e0-368c-c60b-0ddb-70cf52d75757
msgctxt "he87066d8ge59fg4e00gab3ag814e5837c4ab"
msgid "Now please, just... leave me be."
msgstr "이제 제발, 그냥... 저를 내벼려두세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5
#. Speaker = Player
#. NodeID = 5f04fe38-7741-455f-2275-8b6becea9610
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - PLA_FlamingFist5_Knows_ReactedToDeath(1) = False
#. SetFlags:
#.   Object:
#.     - PLA_FlamingFist5_Knows_ReactedToDeath(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5:5f04fe38-7741-455f-2275-8b6becea9610
msgctxt "h8bb15460g955fg4011gbaa8gf78ddc5a19ed"
msgid "My condolences to you."
msgstr "그대에게 애도를 표하오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5
#. Speaker = Fist Recruit Ephren
#. NodeID = 61c3676e-a841-4f36-98c5-9ae9c1523ba5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - a5416f1a-6435-7f72-5d84-8cd747fcda7d_MindHasBeenRead = True
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5:61c3676e-a841-4f36-98c5-9ae9c1523ba5
msgctxt "hf8c32db1g55ceg489bg8484g80921f3d01dc"
msgid ""
"<i>Another Lolth-sworn - a killmonger, a monster. If I do not take her head, "
"she will take mine.</i>"
msgstr "<i>또 다른 롤쓰-스원이다. 망할 살인귀, 괴물 자식. 먼저 목을 날리지 못하면, 내 목이 날아가고 말 거야.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5
#. Speaker = Fist Recruit Ephren
#. NodeID = 61c3676e-a841-4f36-98c5-9ae9c1523ba5
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Local:
#.     - a5416f1a-6435-7f72-5d84-8cd747fcda7d_MindHasBeenRead = True
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5:61c3676e-a841-4f36-98c5-9ae9c1523ba5
msgctxt "h419efd6bg6be7g42ccg8badgfe72dcedac28"
msgid ""
"<i>Another Lolth-sworn - a killmonger, a monster. If I do not take his head, "
"he will take mine.</i>"
msgstr "<i>또 다른 롤쓰-스원이다. 망할 살인귀, 괴물 자식. 먼저 목을 날리지 못하면, 내 목이 날아가고 말 거야.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5
#. Speaker = Fist Recruit Ephren
#. NodeID = 61c3676e-a841-4f36-98c5-9ae9c1523ba5
#. HandlePath = TaggedText[2].TagText[0]
#. SetFlags:
#.   Local:
#.     - a5416f1a-6435-7f72-5d84-8cd747fcda7d_MindHasBeenRead = True
#. TagRule: !(FEMALE and MALE)
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5:61c3676e-a841-4f36-98c5-9ae9c1523ba5
msgctxt "h37466a37g3546g4745g9cc2g8dcf4dd99628"
msgid "<i>Another Lolth-sworn - a killmonger, a monster.</i>"
msgstr "<i>또 다른 롤쓰-스원이다. 망할 살인귀, 괴물 자식.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5
#. Speaker = Player
#. NodeID = 635fcc48-e44d-d1c5-26c2-3f3c57b7cce6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - PLA_FlamingFists_Knows_AskedWhatHappened(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5:635fcc48-e44d-d1c5-26c2-3f3c57b7cce6
msgctxt "h024fc1d5g66cbg4abbg95d7gb43926021cd2"
msgid "May I ask what happened here?"
msgstr "이곳에서 무슨 일이 벌어진 건지 물어봐도 될까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5
#. Speaker = Fist Recruit Ephren
#. NodeID = 63ba1b9f-867a-aace-af5c-47785b61a657
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_FlamingFist5_HasMet_PuttingOutFire(1) = True
#.   Global:
#.      - PLA_TavernInvestigation_State_BurntDown = True
#.      - PLA_FlamingFist6_State_OutOfTrigger = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5:63ba1b9f-867a-aace-af5c-47785b61a657
msgctxt "h7f8129f7g7d17g4c5dg8c6cg438fd21e4d43"
msgid "Away, I tell you!"
msgstr "말했잖아요, 저리 가세요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5
#. Speaker = Player
#. NodeID = 76e20636-e371-49eb-aea3-3c7d9704a595
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 0
#. CheckFlags:
#.   Local:
#.      - a5416f1a-6435-7f72-5d84-8cd747fcda7d_MindHasBeenRead = False
#.   Script:
#.      - GEN_CanDetectThoughts_2 = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5:76e20636-e371-49eb-aea3-3c7d9704a595
msgctxt "hcc0ae505g21e7g48e8g921fgdedb8c269fe2"
msgid "<i>Cast Detect Thoughts.</i>"
msgstr "<i>생각 탐지를 시전한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5
#. Speaker = Fist Recruit Ephren
#. NodeID = 8387ce96-9eca-f6cc-9f84-be7d54782710
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5:8387ce96-9eca-f6cc-9f84-be7d54782710
msgctxt "h9e7022b6g2d24g4cbdgbc9fg60628b2c1f64"
msgid ""
"It was a massacre. Drow and goblins slaughtered the lot. My poor Jacek never "
"stood a chance."
msgstr "학살이 벌어졌어요. 드로우와 고블린들이 이들을 도살해 버렸죠. 불쌍한 야책은 손쓸 도리도 없었어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5
#. Speaker = Player
#. NodeID = 84b20ace-65dd-ad46-0a1e-5e7f1d39767e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_Desire_Knows_RavengardTaken = False
#.      - PLA_TavernInvestigation_State_BurntDown = True
#.   User:
#.      - PLA_FlamingFists_Knows_AskedWhatHappened(1) = False
#. SetFlags:
#.   User:
#.     - PLA_FlamingFists_Knows_AskedWhatHappened(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5:84b20ace-65dd-ad46-0a1e-5e7f1d39767e
msgctxt "hd1de7983g340ag4279g9e24gd1b4ec241a44"
msgid "What the hells happened here?"
msgstr "이곳에 대체 무슨 일이 벌어진 것이지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5
#. Speaker = Fist Recruit Ephren
#. NodeID = 8ec1ab96-6a03-c368-61c8-874b43e7f400
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_FlamingFist5_HasMet_PuttingOutFire(1) = False
#.   Global:
#.      - PLA_TavernInvestigation_State_BurntDown = False
#.      - PLA_FlamingFist6_State_OutOfTrigger = True
#. SetFlags:
#.   Dialog:
#.     - PLA_FlamingFist5_HasMet_PuttingOutFire(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5:8ec1ab96-6a03-c368-61c8-874b43e7f400
msgctxt "h9af2244cg13d5g45d1g9619g5b46da8e83eb"
msgid "Get back."
msgstr "물러서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5
#. Speaker = Fist Recruit Ephren
#. NodeID = 8f33f804-f766-a5fd-fbba-432623ed1dc1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5:8f33f804-f766-a5fd-fbba-432623ed1dc1
msgctxt "h7f5b2bc4g302bg43e7ga6bagcca59ec51e64"
msgid "Only a coward would speak ill of the fallen."
msgstr "겁쟁이나 죽은 이들을 헐뜯는 법이죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5
#. Speaker = Player
#. NodeID = 93ba563b-2e80-a5bf-f0d1-6cc84803a38a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5:93ba563b-2e80-a5bf-f0d1-6cc84803a38a
msgctxt "h7454f7ebg2c8fg4c4egad2dg24d2804a9237"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5
#. Speaker = Fist Recruit Ephren
#. NodeID = a193098f-7f07-281d-7eeb-6ea56bd22530
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5:a193098f-7f07-281d-7eeb-6ea56bd22530
msgctxt "ha1f295e2gba26g424aga323gfb04cd07269a"
msgid "... and temper our hearts for the battles in this life and next."
msgstr "... 또한 이번 생과, 그 너머까지 전투에서 저희 심장을 단련해 주소서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5
#. Speaker = Fist Recruit Ephren
#. NodeID = a203689f-47ad-4067-41fc-780945787f5a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_FlamingFist7_State_Permadefeated = True
#. SetFlags:
#.   Global:
#.     - PLA_FlamingFists_State_PersuadedDrow = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5:a203689f-47ad-4067-41fc-780945787f5a
msgctxt "h76e48547g91ddg4623g8d3eg0b4bfcf57554"
msgid "That's all I know. Please, just... leave me be."
msgstr "그게 제가 아는 전부에요. 제발, 이제... 절 내버려 두세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5
#. Speaker = Player
#. NodeID = a41ce58c-0564-5fa5-09b9-d8afd047aaee
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5:a41ce58c-0564-5fa5-09b9-d8afd047aaee
msgctxt "h6cbb61a5g0bfeg41b5gbba4g4ac8f2dc7355"
msgid "Be at ease. I didn't come seeking battle."
msgstr "전정해. 난 전투를 위해 온 게 아니니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5
#. Speaker = Fist Recruit Ephren
#. NodeID = a8865ef6-3ae0-1edc-7f37-b3e1aefa0613
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5:a8865ef6-3ae0-1edc-7f37-b3e1aefa0613
msgctxt "he0565bb0ga4bdg4138gac13g5956d45c8697"
msgid "Save your breath."
msgstr "그 입 다물어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5
#. Speaker = Fist Recruit Ephren
#. NodeID = b5158f2d-0a0a-bb78-459c-e4cae3ed5635
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_FlamingFist6_State_OutOfTrigger = False
#.   User:
#.      - PLA_FlamingFist5_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5:b5158f2d-0a0a-bb78-459c-e4cae3ed5635
msgctxt "h2000a510ge0d1g4102g8249gb2c63b6d41f3"
msgid ""
"I promise my shield and my sword, Vigilant One. Let them be my courage..."
msgstr "제 방패와 검을 바치겠습니다, 경계하는 분이시여. 그들이 제 용기가 되도록 해주소서..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5
#. Speaker = Player
#. NodeID = c1824d35-a6d6-6e9f-649c-e2db0f3c8382
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5:c1824d35-a6d6-6e9f-649c-e2db0f3c8382
msgctxt "h8d932d11gabeag427dg942cg7e408f6350f0"
msgid "To die for a cause is noble, but still tragic. I'm sorry."
msgstr "대의를 위해 죽는 건 고귀하지만, 비참하기도 하지. 미안하군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5
#. Speaker = Fist Recruit Ephren
#. NodeID = cbb1759c-ab2d-853f-ac95-1a0a19f77b34
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5:cbb1759c-ab2d-853f-ac95-1a0a19f77b34
msgctxt "hdd5fe3b4g07a2g4206g928fg4c38df703a04"
msgid "I'll note your concern. I'd do more, were we not so slight in number."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5
#. Speaker = Fist Recruit Ephren
#. NodeID = cd6c451e-44eb-c5ca-f68f-5596e3751ff1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5:cd6c451e-44eb-c5ca-f68f-5596e3751ff1
msgctxt "hf2996e2bg0768g46f4g84d8ga001738a70ed"
msgid "A massacre. Drow and goblins slaughtered the lot."
msgstr "학살이었죠. 드로우와 고블린들이 이들을 도살해버렸어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5
#. Speaker = Player
#. NodeID = cdfe7173-f697-828b-e200-afe0be08bb92
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - PLA_FlamingFist5_Knows_ReactedToDeath(1) = False
#.   Tag:
#.      - CLERIC_GOOD(1) = True
#.      - CLERIC_HELM(1) = False
#. SetFlags:
#.   Object:
#.     - PLA_FlamingFist5_Event_Prayed(1) = True
#.     - PLA_FlamingFist5_Knows_ReactedToDeath(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5:cdfe7173-f697-828b-e200-afe0be08bb92
msgctxt "hfd4cece8g0871g47d7gabc0g92500971aab1"
msgid "<i>Whisper a sympathetic prayer.</i>"
msgstr "<i>동정어린 기도를 읊조린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5
#. Speaker = Fist Recruit Ephren
#. NodeID = cff0f8d3-2138-bb9d-2020-8df0f0dd3212
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_FlamingFist5_State_PissedOffAtWyll(1) = True
#.   Global:
#.      - PLA_FlamingFist6_State_OutOfTrigger = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5:cff0f8d3-2138-bb9d-2020-8df0f0dd3212
msgctxt "h32a9d09dg7923g4d62gbe62ga70b847c5df1"
msgid "Just <i>go.</i>"
msgstr "그냥 <i>저리 가세요.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5
#. Speaker = Fist Recruit Ephren
#. NodeID = d91fd4b4-444c-bb0e-814b-61694fb67143
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_FlamingFist7_State_Permadefeated = False
#. SetFlags:
#.   Global:
#.     - PLA_FlamingFists_State_PersuadedDrow = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5:d91fd4b4-444c-bb0e-814b-61694fb67143
msgctxt "h8f479108gf15dg4666gb0f4g9b4074b664fa"
msgid ""
"Now please, just... leave me be. Speak to the Gauntlet if you want to know "
"more."
msgstr "이제 제발, 그냥... 절 내버려 두세요. 알고 싶은 것이 있다면 건틀릿 님과 이야기하세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5
#. Speaker = Player
#. NodeID = e79c3488-d310-2f27-b50b-f08709396caf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Quest:
#.      - PLA_ZhentShipment.Rewarded_ZhentReturned(1) = True
#.   User:
#.      - PLA_FlamingFists_Knows_ZhentDungeon(1) = False
#. SetFlags:
#.   User:
#.     - PLA_FlamingFists_Knows_ZhentDungeon(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5:e79c3488-d310-2f27-b50b-f08709396caf
msgctxt "h3623ad58g5955g420ag85f2g46c0ada10228"
msgid "You should know there are Zhentarim in the area."
msgstr "이 지역에 젠타림이 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5
#. Speaker = Fist Recruit Ephren
#. NodeID = e7eeca99-da92-067b-f7e0-ff93257e3252
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_FlamingFists_State_PersuadedDrow = False
#.      - PLA_FlamingFist6_State_OutOfTrigger = True
#.   Tag:
#.      - LOLTHDROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5:e7eeca99-da92-067b-f7e0-ff93257e3252
msgctxt "h20a74e5eg0b6cg4857g897dg825eea47b349"
msgid "More drow. Fist - at the ready!"
msgstr "드로우가 더 있다. 피스트 - 준비!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5
#. Speaker = Player
#. NodeID = eabee69b-ebfc-2c2a-b97b-ded77f4f2538
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - PLA_FlamingFist5_Knows_ReactedToDeath(1) = False
#.   Tag:
#.      - BALDURIAN(1) = True
#. SetFlags:
#.   Object:
#.     - PLA_FlamingFist5_Knows_ReactedToDeath(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5:eabee69b-ebfc-2c2a-b97b-ded77f4f2538
msgctxt "h64559a2dg3a3fg4c42ga944gf56ebf48dfc2"
msgid "Looks like he wasn't cut out to be a Flaming Fist."
msgstr "그는 플레이밍 피스트의 일원이 되기에 적합하지 않았던 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5
#. Speaker = Player
#. NodeID = ec2393f3-cbbc-b01c-c049-c0843318f37d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - PLA_FlamingFists_Knows_AskedWhatHappened(1) = False
#. SetFlags:
#.   Object:
#.     - PLA_FlamingFist5_Knows_ReactedToDeath(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5:ec2393f3-cbbc-b01c-c049-c0843318f37d
msgctxt "h8ee53dc0gb9bfg47c5g8d43g0c75ec627385"
msgid "What the hells happened here?"
msgstr "이곳에 대체 무슨 일이 벌어진 것이지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5
#. Speaker = Player
#. NodeID = ee0a06bb-a35d-17ad-a423-bcf3386ba56a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5:ee0a06bb-a35d-17ad-a423-bcf3386ba56a
msgctxt "h340880bdg8f17g4466ga240g6ba2366f3d14"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5
#. Speaker = Fist Recruit Ephren
#. NodeID = f1c84e1e-a8cc-4ccb-a2f4-1e471be9ecee
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5:f1c84e1e-a8cc-4ccb-a2f4-1e471be9ecee
msgctxt "h030e4fe2g37aeg4913g94a9ged99c9860826"
msgid "What are you... you'll pay for that!"
msgstr "뭘 하는... 대가를 치르게 될 거다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5
#. Speaker = Fist Recruit Ephren
#. NodeID = f481313e-f5d2-ecac-c241-cd4472618590
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_FlamingFist5_HasMet_PuttingOutFire(1) = False
#.   Global:
#.      - PLA_TavernInvestigation_State_BurntDown = True
#.      - PLA_FlamingFist6_State_OutOfTrigger = True
#. SetFlags:
#.   Dialog:
#.     - PLA_FlamingFist5_HasMet_PuttingOutFire(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5:f481313e-f5d2-ecac-c241-cd4472618590
msgctxt "h083ec180g0e8eg479bg8f76g7b4be692d3bf"
msgid "Away from me."
msgstr "저리가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5
#. Speaker = Player
#. NodeID = f61fd8ac-055c-c743-5db6-ee58d17adaf9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - PLA_FlamingFist5_Knows_ReactedToDeath(1) = False
#.   Tag:
#.      - OATHBREAKER(1) = True
#. SetFlags:
#.   Object:
#.     - PLA_FlamingFist5_Knows_ReactedToDeath(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5:f61fd8ac-055c-c743-5db6-ee58d17adaf9
msgctxt "he74cc100g388dg451ag94fag6605a403d8e6"
msgid "Yet another dies for a futile cause. I'm sorry."
msgstr "또 다른 영혼이 헛된 이유로 죽음에 이르렀군. 유감이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5
#. Speaker = Fist Recruit Ephren
#. NodeID = f7e994a4-4268-a1fa-390c-290aec506478
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5:f7e994a4-4268-a1fa-390c-290aec506478
msgctxt "h9222a8c5g2c18g46fdg8f2ag3e63b9c7b9c3"
msgid ""
"Steel our blades and temper our hearts for the battles in this life and next."
msgstr "이번 생과 다음 생의 전투를 위해 우리의 칼날을 갈고 마음을 단련시켜 주시길."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5
#. Speaker = Player
#. NodeID = fe062096-a35e-3b49-0354-823419df49ca
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5:fe062096-a35e-3b49-0354-823419df49ca
msgctxt "hcf3a5975g33f1g4a82g908eged0f74167630"
msgid "He is at rest now."
msgstr "그는 이제 영면에 들었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5_AD
#. Speaker = Fist Recruit Ephren
#. NodeID = bfc25dcd-4438-fcee-50ed-d3c396c19f18
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5_AD:bfc25dcd-4438-fcee-50ed-d3c396c19f18
msgctxt "h37bc6ad0g7704g494ag87c8g2be329f630ce"
msgid "Great Guard Helm, allow us peace in this plane and beyond."
msgstr "위대한 수호자 헬름이시여, 이 생과 그 너머에 평화를 허락하소서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5_AD
#. Speaker = Fist Recruit Ephren
#. NodeID = ca889dc4-3677-8206-d20b-74c1a0f4ddf8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5_AD:ca889dc4-3677-8206-d20b-74c1a0f4ddf8
msgctxt "hfddb56ffg8c7fg4c1ega67agf428ea2ab715"
msgid "So it is spoken, and so is it done."
msgstr "말하는 대로 행해질 것이니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5_AD
#. Speaker = Fist Recruit Ephren
#. NodeID = cbde00fc-71aa-8ae9-1e46-414b3a9b22da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist5_AD:cbde00fc-71aa-8ae9-1e46-414b3a9b22da
#, fuzzy
msgctxt "h7c07de17g6403g48d3gbba3gdeeb68f4fcf7"
msgid ""
"Teach us care when we would be reckless. Teach us certainty when we would "
"have doubt."
msgstr "무모한 저희에게 주의를 깨우쳐 주십시오. 의심하는 저희에게 확신을 심어 주십시오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Player
#. NodeID = 018c23d6-1084-1b11-0ce7-95c4db13cbdd
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: Damage
#. RollAbility: Charisma
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:018c23d6-1084-1b11-0ce7-95c4db13cbdd
msgctxt "h237a51acg0763g4688g90d7g93b87f46d2c9"
msgid "I'm a guard from a nearby village. I'm here to offer my assistance."
msgstr "난 근처 마을의 경비병이야. 도움을 주러 왔어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Player
#. NodeID = 03922eb2-f9e5-5186-6232-7f06827f83e0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_FlamingFist7_Knows_AskedWhatHappened(1) = False
#.   Global:
#.      - PLA_Tavern_Knows_DukeAtTowers = True
#. SetFlags:
#.   Dialog:
#.     - PLA_FlamingFist7_Knows_AskedWhatHappened(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:03922eb2-f9e5-5186-6232-7f06827f83e0
msgctxt "hd402b8a3gae7bg45f3g90d3gda54c278ef83"
msgid "Those tracks lead to Moonrise Towers."
msgstr "이 흔적은 문라이즈 타워로 이어지는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Player
#. NodeID = 04a37a58-f302-69b1-df7a-a1ea9b96f4bf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_Tavern_Knows_DukeInTavern = True
#.      - PLA_Tavern_Knows_DukeAtTowers = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:04a37a58-f302-69b1-df7a-a1ea9b96f4bf
msgctxt "h6da194c6g2616g430fga953g55c2b72ca217"
msgid "I can tell you: Grand Duke Ravengard was kidnapped."
msgstr "내가 알고 있어. 레이븐가드 대공은 납치됐어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Player
#. NodeID = 07fa743d-f9b0-a867-d3ff-4afab686c3eb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - e6738c9d-060d-c901-b945-4d49ca303d5b_SuccessfullyReadTracks = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:07fa743d-f9b0-a867-d3ff-4afab686c3eb
msgctxt "hd396671eg5956g4b97ga53bg38a189373ef1"
msgid "No luck. Sorry."
msgstr "운이 없었네. 미안."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Gauntlet Dain
#. NodeID = 08553bc5-24a2-6025-e440-c8d825f627f8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
