msgctxt "hccddf373ga261g4ed8g99ddg39680a27bc4e"
msgid "Oh, look! It's daddy's regret."
msgstr "이거 봐라! 애비도 후회하는 자식이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_AD_ViciousMockery
