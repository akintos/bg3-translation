msgctxt "h784c19c4g1050g469bg9561g3fae0a45899a"
msgid "You all right there? You're looking a bit peaky."
msgstr "야, 너 괜찮아? 조금 피곤해 보이는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Brewery_AD_DrunkCheering
#. Speaker = Kobold Scout
#. NodeID = 62b2c54f-f66d-430e-9b3c-bcec7f65e2b0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Brewery_AD_DrunkCheering:62b2c54f-f66d-430e-9b3c-bcec7f65e2b0
msgctxt "h68f6df2bg73d4g4146ga221g776fec4defa9"
msgid "Oi, don't go soft on me after a couple of pints."
msgstr "인마, 술 몇잔 마셨다고 친절하게 굴지 마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Brewery_AD_DrunkCheering
#. Speaker = Kobold Looter
#. NodeID = 704d22d7-93dc-419a-a126-13a30e678696
