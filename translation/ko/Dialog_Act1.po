#.   Object:
#.     - GLO_CharacterDie(2) = True
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:9d0bfa35-1872-b91e-141a-f7f47e1dc2ad
msgctxt "hc99e0fd7ga9a1g4951g9d92gba7c9b6fa10e"
msgid "She is a True Soul. Mind her. She will - she - she..."
msgstr "이 여자는 참된 영혼이다. 지시하는 대로 따라라. 그... 그... 그 여자..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Edowin
#. NodeID = 9d0bfa35-1872-b91e-141a-f7f47e1dc2ad
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_PriestOfTheConqueringGod_Cultists_TrueSoulPowersUsed(3) = False
#. SetFlags:
#.   Object:
#.     - GLO_CharacterDie(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:9d0bfa35-1872-b91e-141a-f7f47e1dc2ad
msgctxt "h9a3877a8gc4e0g4a44ga180g74a69b9a801e"
msgid "They are a True Soul. Mind them. They will - they - they..."
msgstr "저 사람은 참된 영혼이다. 지시하는 대로 따라라. 저... 저... 저 사람..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Andrick
#. NodeID = 9fbed3f4-fc36-9f24-ff22-bb55a874abc6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:9fbed3f4-fc36-9f24-ff22-bb55a874abc6
msgctxt "h4ed58f39gb344g4819g8a84ga2a1e5277baf"
msgid "<i>What?!</i>"
msgstr "<i>뭐라고요?!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Brynna
#. NodeID = aae0242f-074a-6f50-35ad-3cb986d2e401
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:aae0242f-074a-6f50-35ad-3cb986d2e401
#, fuzzy
msgctxt "h87f7f49egd50bg4168gab35gdab0d7f07983"
msgid ""
"A True Soul - like you - has been chosen by the Absolute. You speak with Her "
"voice."
msgstr "당신 같은 참된 영혼님들은 절대자님께 선택받으신 거죠. 당신은 그녀의 목소리를 대변합니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Narrator
#. NodeID = ac6b41af-e228-7957-e632-d4a96b8c5adc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - GLO_TadpoleIntro_NPC(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:ac6b41af-e228-7957-e632-d4a96b8c5adc
msgctxt "hd9e90986g29fcg4467g888dg4d9bca25bb6c"
msgid "*As the symbol glows, power courses through you. <i>Authority</i>.*"
msgstr "*문양이 빛나며, 몸에 흐르는 힘이 느껴집니다. <i>권위</i>.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Narrator
#. NodeID = ae8c6f63-d251-9041-65c5-0e54830264c2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount6(3) = False
#.   Tag:
#.      - TRUESOUL(3) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount6(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:ae8c6f63-d251-9041-65c5-0e54830264c2
msgctxt "hde24d29eg186dg4d87g8721g7f2f31ccfe2a"
msgid ""
"*The presence deep in your mind is awake, unblinking. This is it. A single "
"word pervades your consciousness: 'Soon'.*"
msgstr ""
"*당신의 정신 속 깊이 자리잡은 존재가 태연스레 깨어납니다. 올 것이 왔군요. 한 단어가 당신의 의식 속으로 스며듭니다. ‘곧’*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Brynna
#. NodeID = afa36dd8-8a25-f841-ea96-c7610c35da37
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:afa36dd8-8a25-f841-ea96-c7610c35da37
msgctxt "h0470d8a2gab60g4670ga43egc087c3d71064"
msgid ""
"May the Absolute continue to guide your hand, sir. As for us, we won't take "
"any more of your time."
msgstr "절대자께서 계속 당신의 손을 인도하길 바랍니다 나으리. 더 이상 시간을 뺏지 않겠습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Brynna
#. NodeID = afa36dd8-8a25-f841-ea96-c7610c35da37
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:afa36dd8-8a25-f841-ea96-c7610c35da37
msgctxt "h188c70aagb2d5g4d43g87a6g47df348bd629"
msgid ""
"May the Absolute continue to guide your hand, madam. As for us, we won't "
"take any more of your time."
msgstr "절대자께서 계속 당신의 손을 인도하길 바랍니다 마님. 더 이상 시간을 뺏지 않겠습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Brynna
#. NodeID = afa36dd8-8a25-f841-ea96-c7610c35da37
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:afa36dd8-8a25-f841-ea96-c7610c35da37
msgctxt "hddec4a9fgcb26g4f65ga31egbcd4a218fa5f"
msgid ""
"May the Absolute continue to guide your hand. As for us, we won't take any "
"more of your time."
msgstr "절대자께서 계속 당신의 손을 인도하길 바랍니다. 더 이상 시간을 뺏지 않겠습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Player
#. NodeID = b0989672-f54a-1fb3-2075-c29dff93809a
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - CLERIC_GOOD(3) = False
#.      - PALADIN_GOOD(3) = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:b0989672-f54a-1fb3-2075-c29dff93809a
msgctxt "h400d0426ge43eg41c4g9c67g2098c5789951"
msgid "His wounds look deep. I might be able to help."
msgstr "상처가 깊은 것 같네. 내가 도울 수 있을지도 몰라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Andrick
#. NodeID = b1bc094e-b35c-f5b4-9b0a-c6af867d93b8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_PriestsConqueringGod_Global_GoToOwlbearCave = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:b1bc094e-b35c-f5b4-9b0a-c6af867d93b8
msgctxt "h8699f841g470cg478fgae48gc601758044f5"
msgid ""
"The cave is just ahead. It was too much for us before, but... but if you "
"could help us, True Soul... we may stand a chance."
msgstr ""
"동굴은 바로 앞에 있습니다. 저희에겐 힘든 일이겠지만... 참된 영혼이시여, 당신께서 도와주신다면... 승산이 있을지도 모릅니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Andrick
#. NodeID = b8699c28-5d6f-068c-afb3-3cc33b22bc55
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:b8699c28-5d6f-068c-afb3-3cc33b22bc55
msgctxt "h762c7d4cg2a5dg4d4fga0aegb1350c936fa5"
msgid ""
"Then <i>we'll </i>be the ones with the power - well, you will firstly, True "
"Soul. You don't need me to explain that."
msgstr ""
"그럼, <i>저희 같은 사람들</i>이 힘을 가지는 거죠, 물론 당신은 참된 영혼이시니까 먼저 얻으시겠지만요. 그건 설명해 드릴 필요 "
"없겠죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Player
#. NodeID = b991a1aa-b414-8731-8e77-26383119f9f1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_Owlbear_State_PermaDefeated = False
#.   Object:
#.      - FOR_PriestOfTheConqueringGod_Cultists_Knows_Owlbear(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:b991a1aa-b414-8731-8e77-26383119f9f1
msgctxt "hf2d6740ag04bcg4ae1g99bag8ff2d44494d8"
msgid "You need to find the beast and avenge your brother."
msgstr "그 짐승을 찾아서 네 형제의 복수를 해 줘야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
