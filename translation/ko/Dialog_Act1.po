msgctxt "h6274fc68gd5beg4cd8ga56cg5a11ec30f43c"
msgid "I'm scared, Mol."
msgstr "몰, 나 무서워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_HideoutLeader
#. Speaker = Mol
#. NodeID = bc8827fd-e417-e213-ddf0-f74f606e8738
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_HideoutLeader:bc8827fd-e417-e213-ddf0-f74f606e8738
msgctxt "hdb97c4a0g78a8g45cbg99eegc51a27528f8a"
msgid "I've always protected you, haven't I?"
msgstr "내가 항상 너 지켜 줬잖아. 안 그래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_HideoutLeader
#. Speaker = Zaki
#. NodeID = bdbaaa58-c0ef-3d0e-3ec3-104619142a96
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_HideoutLeader:bdbaaa58-c0ef-3d0e-3ec3-104619142a96
msgctxt "h39c14723g8a0fg463egbd2ega5b55f14c27a"
msgid "I will."
msgstr "그럴 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_HideoutLeader
#. Speaker = Mol
#. NodeID = db92088a-e202-53f3-ab6b-cca46c99ad0f
