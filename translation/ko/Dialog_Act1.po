#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:4ede21df-0560-0b20-7754-acd9aa7d8aff
#, fuzzy
msgctxt "h86cbd8a1g9191g4a93g8695gf6b44e0fa13d"
msgid "You're all right, Scratch."
msgstr "괜찮아, 스크래치."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Player
#. NodeID = 508ceb00-d61a-ce81-54fb-769882063cf4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:508ceb00-d61a-ce81-54fb-769882063cf4
msgctxt "h26081b40gd15eg4093g8a2ag43a9f15d71aa"
msgid "What happened to your friend, exactly?"
msgstr "네 친구한테 정확히 어떤 일이 있었던 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
