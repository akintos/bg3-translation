msgctxt "hb1234fb7g09c7g412cg925bg168f11483597"
msgid "You sees me? <i>Tch. </i>"
msgstr "내가 보여? <i>칫.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_ForestIllusion_IllusionRedcap
#. Speaker = Redcap Blood Sage
#. NodeID = a8d67424-f449-d1f2-ca11-e8a83f6775d1
#. HandlePath = TaggedText[0].TagText[0]
