msgid "*Grrrrafff!*"
msgstr "*그르르르!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Scratch
#. NodeID = 93890b81-ac31-5a00-252d-1329e1c98958
