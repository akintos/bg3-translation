msgctxt "h77b61391gbc98g4d17g8c46g4e9e6c2f3cb3"
msgid "That did <i>something</i>, all right. Just not sure what."
msgstr "뭔가 작동되긴 했는데, 확실히 뭔진 모르겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_KarlachRecruitment_PAD_DiscoveredPressurePlate
#. Speaker = Player
#. NodeID = ea7cfc06-f410-457c-97cc-717e4ea87b51
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_KarlachRecruitment_PAD_DiscoveredPressurePlate:ea7cfc06-f410-457c-97cc-717e4ea87b51
msgctxt "hb7f72b22ga0b3g415dg9d30g96ad9086199a"
msgid "There's a pressure plate in the chair, but I'm missing something."
msgstr "의자에 압력판이 있는 것 같아, 하지만 뭔가 놓치고 있는 것 같은데."

