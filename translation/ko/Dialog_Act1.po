#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_LaezelKilledByGith:1266e90b-d755-3d93-67ef-d8c2f802c395
msgctxt "h144a2d9bgef98g4a16gb5b4g3c82167c17bb"
msgid "Dammit. This shouldn't have happened."
msgstr "젠장. 이렇게 끝나선 안 되는 거였어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_LaezelKilledByGith
#. Speaker = Player
#. NodeID = 1266e90b-d755-3d93-67ef-d8c2f802c395
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_LaezelKilledByGith:1266e90b-d755-3d93-67ef-d8c2f802c395
msgctxt "hdb2463abg05e3g49feg9359gd8e79d5bae07"
msgid ""
"She was dangerous, but I respected her passion and ambition. Her kin have "
"done themselves a disservice."
msgstr "위협적이었지만, 열정과 야망만큼은 높게 샀는데. 동족들은 진가를 알아보지 못해서 슬프네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_LaezelKilledByGith
#. Speaker = Player
#. NodeID = 1266e90b-d755-3d93-67ef-d8c2f802c395
#. HandlePath = TaggedText[5].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_LaezelKilledByGith:1266e90b-d755-3d93-67ef-d8c2f802c395
msgctxt "h6b5eeea7g4b8dg4ee9gb724g4204e5495d73"
msgid "Come - we shouldn't linger here."
msgstr "가자 - 이곳에 더 이상 머무르지 않는 것이 좋겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_LaezelKilledByGith
#. Speaker = Player
#. NodeID = d5405c76-338d-9ce7-2437-c982df58df61
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_LaezelKilledByGith:d5405c76-338d-9ce7-2437-c982df58df61
msgctxt "h122dc428ge993g486dgbcedgb939d338f281"
msgid "Dead - by our own kin's hand."
msgstr "죽었군, 우리 동족의 손에."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_LaezelKilledByGith
#. Speaker = Player
#. NodeID = d5405c76-338d-9ce7-2437-c982df58df61
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_LaezelKilledByGith:d5405c76-338d-9ce7-2437-c982df58df61
msgctxt "h24c9d841g7c8bg404fg9b27g650b0d6904f9"
msgid "Dead - by her own kin's hand."
msgstr "죽었군, 자기 동족의 손에."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_LaezelPostFight
#. Speaker = Lae'zel
#. NodeID = f8454f5e-13dc-c53e-0aa6-664b51891fe1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_LaezelPostFight:f8454f5e-13dc-c53e-0aa6-664b51891fe1
msgctxt "haf4c25fbgdcdcg4ef7ga9f6g15b13a1f5dcc"
msgid "Their corpses may have <i>something</i> of use..."
msgstr "그들의 시체에 <i>뭔가</i> 쓸모 있는 것이 있을지도 몰라..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_LaezelReadMap
#. Speaker = Lae'zel
#. NodeID = 7f09bf74-ba36-41d7-a9a3-4a85cabb76e5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_LaezelReadMap:7f09bf74-ba36-41d7-a9a3-4a85cabb76e5
msgctxt "h982e7519gb677g46c7gaf81g41ac36d12ea3"
msgid "A githyanki crèche lies beyond the mountain pass."
msgstr "산길 너머에 기스양키 양성소가 있다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_LaezelReadMap
#. Speaker = Lae'zel
#. NodeID = b2c34290-83ed-cec7-af13-fa48c5ea161e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_LaezelReadMap:b2c34290-83ed-cec7-af13-fa48c5ea161e
msgctxt "hac4ed933g6ef4g4cb1ga2a5g117bb2b58a23"
msgid "Purification is finally at hand."
msgstr "정화가 마침내 눈앞에 있다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_LeavingLaezelBehind
#. Speaker = Player
#. NodeID = 2be55063-748e-1aa8-7067-9c6be5d3889c
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_LeavingLaezelBehind:2be55063-748e-1aa8-7067-9c6be5d3889c
msgctxt "hb952d455gc85ag4184gb4aag509665c3e06c"
msgid ""
"Lae'zel might not be my warmest friend, but are we going to just abandon her "
"like that?"
msgstr "레이젤이 딱히 친절한 친구는 아니지만, 정말 이렇게 두고 갈 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_LeavingLaezelBehind
#. Speaker = Player
#. NodeID = 2be55063-748e-1aa8-7067-9c6be5d3889c
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_LeavingLaezelBehind:2be55063-748e-1aa8-7067-9c6be5d3889c
msgctxt "h2694b182gc6c6g4e3agb7begcde2de964aa9"
msgid "Ah, Lae'zel's been left behind. I could go back for her. Or not."
msgstr "레이젤이 남겨졌군. 그녀를 위해 돌아갈 수도 있겠어. 아니면 말고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_LeavingLaezelBehind
#. Speaker = Player
#. NodeID = 2be55063-748e-1aa8-7067-9c6be5d3889c
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_LeavingLaezelBehind:2be55063-748e-1aa8-7067-9c6be5d3889c
msgctxt "h91d16c10gb4cag4ae3ga3c1g8fb1d570de86"
msgid "We're not leaving Lae'zel behind, are we?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_LeavingLaezelBehind
#. Speaker = Player
#. NodeID = 2be55063-748e-1aa8-7067-9c6be5d3889c
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_LeavingLaezelBehind:2be55063-748e-1aa8-7067-9c6be5d3889c
msgctxt "hd96eed8cg3e0cg431dgb847g1fd457e80035"
msgid "Lae'zel was left behind. It doesn't feel right to abandon her."
msgstr "레이젤이 남겨졌어. 그녀를 두고 오니 마음이 편하지 않은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_LeavingLaezelBehind
#. Speaker = Player
#. NodeID = 2be55063-748e-1aa8-7067-9c6be5d3889c
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_LeavingLaezelBehind:2be55063-748e-1aa8-7067-9c6be5d3889c
msgctxt "hdf9e6cfbgc22fg4af1gb234gf0ce34ec91d1"
msgid "Oh hells - Lae'zel is still back there. Should I just leave her?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_LeavingLaezelBehind
#. Speaker = Player
#. NodeID = 2be55063-748e-1aa8-7067-9c6be5d3889c
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: !REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_LeavingLaezelBehind:2be55063-748e-1aa8-7067-9c6be5d3889c
msgctxt "h955b0a87gedf6g4732g89fbg27a11c3d73f9"
msgid "Lae'zel is still back there. Should I just abandon her?"
msgstr "레이젤이 아직 뒤에 남아있어. 그녀를 두고 가야 할까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_LeavingLaezelBehind
#. Speaker = Player
#. NodeID = d2e462ec-d911-963f-5bb0-09499ab02631
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_LeavingLaezelBehind:d2e462ec-d911-963f-5bb0-09499ab02631
msgctxt "hb1731d00g14d1g4048g88c6ge2440b846a09"
msgid "And miss what happens next? I wouldn't dream of it."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_LeavingLaezelBehind
#. Speaker = Player
#. NodeID = d2e462ec-d911-963f-5bb0-09499ab02631
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_LeavingLaezelBehind:d2e462ec-d911-963f-5bb0-09499ab02631
msgctxt "h68b57025g56dcg4bfeg99f5g0521f038d512"
msgid "She made her choice. We have to do what's best for ourselves."
msgstr "그녀는 선택을 했어. 우린 우릴 위한 선택을 해야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_LeavingLaezelBehind
#. Speaker = Player
#. NodeID = d2e462ec-d911-963f-5bb0-09499ab02631
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_LeavingLaezelBehind:d2e462ec-d911-963f-5bb0-09499ab02631
msgctxt "h1d6d20c5g8f58g4bcdga346g733646f337eb"
msgid "You're not abandoning her! Just redistributing your presence."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_LeavingLaezelBehind
#. Speaker = Player
#. NodeID = d2e462ec-d911-963f-5bb0-09499ab02631
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_LeavingLaezelBehind:d2e462ec-d911-963f-5bb0-09499ab02631
msgctxt "h58aef10eg2e36g4df8g9e88g4f891ace45cf"
msgid "We have to respect her choices. Or do we?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_LeavingLaezelBehind
#. Speaker = Player
#. NodeID = d2e462ec-d911-963f-5bb0-09499ab02631
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_LeavingLaezelBehind:d2e462ec-d911-963f-5bb0-09499ab02631
msgctxt "hc03696a1gf6e3g4a7fg8aa1gd01e0d88fbbb"
msgid "Lae'zel's one of us now. It doesn't feel right to abandon her."
msgstr "레이젤은 이제 우리 동료야. 그녀를 두고 가는 건 옳지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_LeavingLaezelBehind
#. Speaker = Player
#. NodeID = d2e462ec-d911-963f-5bb0-09499ab02631
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: !REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_LeavingLaezelBehind:d2e462ec-d911-963f-5bb0-09499ab02631
msgctxt "h452f1aeegfd2cg4d45g91fagd6175f203434"
msgid "It may not be the best idea."
msgstr "좋은 생각은 아닐지도 모르겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_Shield
#. Speaker = Player
#. NodeID = c5ff96c3-abcb-af68-8e05-987cfb9faf4b
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_Shield:c5ff96c3-abcb-af68-8e05-987cfb9faf4b
msgctxt "h39d93d66g43d1g41c2gb11agdaa1c3008d96"
msgid "There's not much that can turn aside a dragon's breath."
msgstr "드래곤의 숨결을 막아낼 것은 많지 않지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_Shield
#. Speaker = Player
#. NodeID = c5ff96c3-abcb-af68-8e05-987cfb9faf4b
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_Shield:c5ff96c3-abcb-af68-8e05-987cfb9faf4b
msgctxt "h4cfe33eag749dg4e8cgae8bg1df2e9cfce39"
msgid ""
"When it comes down to man versus dragon, the result tends to be predictable."
msgstr "사람과 드래곤이 싸운다면, 보통 그 결과는 뻔하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_Shield
#. Speaker = Player
#. NodeID = c5ff96c3-abcb-af68-8e05-987cfb9faf4b
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_Shield:c5ff96c3-abcb-af68-8e05-987cfb9faf4b
msgctxt "hab223aa5g6d26g4ec6g9846g2b308594636c"
msgid "Those dragons burn hotter than me."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_Shield
#. Speaker = Player
#. NodeID = c5ff96c3-abcb-af68-8e05-987cfb9faf4b
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_Shield:c5ff96c3-abcb-af68-8e05-987cfb9faf4b
msgctxt "h81b1f7b0g2227g4b15ga739g43e0c3f19bc4"
msgid ""
"Red dragons make powerful weapons and steeds. Vlaakith was wise to ally with "
"them."
msgstr "레드 드래곤은 강력한 무기이자 탈것이지. 블라키스가 그들과 손잡은 건 현명했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_Shield
#. Speaker = Player
#. NodeID = c5ff96c3-abcb-af68-8e05-987cfb9faf4b
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_Shield:c5ff96c3-abcb-af68-8e05-987cfb9faf4b
msgctxt "h98b22a2bg4d67g447fgaf17g3b8425c353b4"
msgid "Not much protection against dragon breath."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_Shield
#. Speaker = Player
#. NodeID = c5ff96c3-abcb-af68-8e05-987cfb9faf4b
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_Shield:c5ff96c3-abcb-af68-8e05-987cfb9faf4b
msgctxt "h21e4872cg1ee2g4ca8g86abg94c539d80185"
msgid "A single shield could never withstand a red dragon's breath."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_Shield
#. Speaker = Player
#. NodeID = c5ff96c3-abcb-af68-8e05-987cfb9faf4b
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_Shield:c5ff96c3-abcb-af68-8e05-987cfb9faf4b
msgctxt "hdc9df582g6b45g4232ga19fg0b9a74095ae8"
msgid "A dragon is clearly not to be trifled with."
msgstr "확실히 드래곤은 건드려서는 안 될 존재야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_Shield
#. Speaker = Player
#. NodeID = c9eae335-30e5-ba18-f753-a2ba91f1517e
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_Shield:c9eae335-30e5-ba18-f753-a2ba91f1517e
msgctxt "h92c30279g04b8g4815ga887gc727352f00e3"
msgid "It's a well-roasted shield."
msgstr "잘 구워진 방패로군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_Shield
#. Speaker = Player
#. NodeID = c9eae335-30e5-ba18-f753-a2ba91f1517e
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_Shield:c9eae335-30e5-ba18-f753-a2ba91f1517e
msgctxt "ha509d2b9gdf60g422dg8b04g2f60240ebba3"
msgid "Hot to the touch. The dragon's breath still lingers on this shield."
msgstr "만지면 뜨겁군. 드래곤의 숨결이 아직 이 방패에서 느껴져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_Shield
#. Speaker = Player
#. NodeID = c9eae335-30e5-ba18-f753-a2ba91f1517e
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_Shield:c9eae335-30e5-ba18-f753-a2ba91f1517e
msgctxt "hc06e3e09g07e2g4a61gbda6g3e804cc2d9da"
msgid "Still warm to the touch."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_Shield
#. Speaker = Player
#. NodeID = c9eae335-30e5-ba18-f753-a2ba91f1517e
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_Shield:c9eae335-30e5-ba18-f753-a2ba91f1517e
msgctxt "hbe277da3gd5d5g4666g86f4gd95e0a5c2b0d"
msgid "Still warm from the red dragon's fire."
msgstr "레드 드래곤의 불로 아직 따뜻해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_Shield
#. Speaker = Player
#. NodeID = c9eae335-30e5-ba18-f753-a2ba91f1517e
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_Shield:c9eae335-30e5-ba18-f753-a2ba91f1517e
msgctxt "h89d01ceage10eg4cb9ga4b8g420381d78440"
msgid "Still warm, like it's fresh from the blacksmith's forge."
msgstr "여전히 따뜻한걸. 대장간에서 갓 나온 것만 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_Shield
#. Speaker = Player
#. NodeID = c9eae335-30e5-ba18-f753-a2ba91f1517e
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_Shield:c9eae335-30e5-ba18-f753-a2ba91f1517e
msgctxt "h613f0ea8g73abg426dg99c9gf740ce91f348"
msgid ""
"They didn't stand a chance. The shield is <i>still </i>glowing from the heat."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_Shield
#. Speaker = Player
#. NodeID = c9eae335-30e5-ba18-f753-a2ba91f1517e
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_Shield:c9eae335-30e5-ba18-f753-a2ba91f1517e
msgctxt "h89371e8cg82cbg428fga480gd204214476bd"
msgid "Still warm to the touch, if you can believe it."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_Shield
#. Speaker = Player
#. NodeID = df96c7e2-c522-4f61-88c8-6eedb5c6ab8e
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_Shield:df96c7e2-c522-4f61-88c8-6eedb5c6ab8e
msgctxt "hb01c7bfcg8fc8g4010g8fe9gd2dfa486f475"
msgid "Not much use against a dragon's breath."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_Shield
#. Speaker = Player
#. NodeID = df96c7e2-c522-4f61-88c8-6eedb5c6ab8e
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_Shield:df96c7e2-c522-4f61-88c8-6eedb5c6ab8e
msgctxt "h441f7b5dgb444g4926g9943g58e356473062"
msgid ""
"Still hot to the touch. When it comes down to man versus dragon, the result "
"tends to be predictable."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_Shield
#. Speaker = Player
#. NodeID = df96c7e2-c522-4f61-88c8-6eedb5c6ab8e
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_Shield:df96c7e2-c522-4f61-88c8-6eedb5c6ab8e
msgctxt "h66dcf01ag7483g47cbg91bcg20ab2ae61560"
msgid "Shield's still warm. That dragon burns hotter than me."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_Shield
#. Speaker = Player
#. NodeID = df96c7e2-c522-4f61-88c8-6eedb5c6ab8e
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_Shield:df96c7e2-c522-4f61-88c8-6eedb5c6ab8e
msgctxt "h1db87602g382bg4d4fga533g22f1083b216b"
msgid ""
"The shield is warm from the red dragon's fire. Wise of Vlaakith to take them "
"as allies."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_Shield
#. Speaker = Player
#. NodeID = df96c7e2-c522-4f61-88c8-6eedb5c6ab8e
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_Shield:df96c7e2-c522-4f61-88c8-6eedb5c6ab8e
msgctxt "h36bbc709gb9ecg480fg8f12g03e198c5c6e2"
msgid "Still warm, like it's fresh from the blacksmith's forge."
msgstr "여전히 따뜻한걸. 대장간에서 갓 나온 것만 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_Shield
#. Speaker = Player
#. NodeID = df96c7e2-c522-4f61-88c8-6eedb5c6ab8e
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_Shield:df96c7e2-c522-4f61-88c8-6eedb5c6ab8e
msgctxt "h5c0099e7ga1fdg4a77g8b68gd011c264727b"
msgid "Poor fellow. This shield was no match for a red dragon's breath."
msgstr "불쌍한 친구로군. 이 방패로는 레드 드래곤의 숨결에 맞서기엔 역부족이었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_Shield
#. Speaker = Player
#. NodeID = df96c7e2-c522-4f61-88c8-6eedb5c6ab8e
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_Shield:df96c7e2-c522-4f61-88c8-6eedb5c6ab8e
msgctxt "hb0418240g286cg4910gaa3fgf279a8f3ad9e"
msgid ""
"The shield is still warm to the touch. A dragon is not to be trifled with."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PartyReaction
#. Speaker = Player
#. NodeID = 21ec356c-73ce-6af5-eb60-f641412136e9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_GithChokepoint_Event_SoloReaction = True
#.   Tag:
#.      - REALLY_LAEZEL(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PartyReaction:21ec356c-73ce-6af5-eb60-f641412136e9
msgctxt "he5389c65g71f8g43b7gad08g36a9068068ae"
msgid "Facing that lot would be suicide... at least for now."
msgstr "저녀석들과 싸우는 건 자살 행위나 마찬가지야... 적어도 지금은 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PartyReaction
#. Speaker = Player
#. NodeID = 37f6baa1-cb30-3032-9c7d-ea58d83696ba
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_GithChokepoint_Event_SoloReaction = True
#.      - GLO_GithChokepoint_State_MeetsLevel = True
#.   Tag:
#.      - REALLY_LAEZEL(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PartyReaction:37f6baa1-cb30-3032-9c7d-ea58d83696ba
msgctxt "hccf2bdb4g3cfbg4e6cg86caga508df66a267"
msgid "They'll be tough to fight... but not impossible to beat."
msgstr "쉽지 않은 상대겠지만... 불가능한 싸움은 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PartyReaction
#. Speaker = Player
#. NodeID = 6bbea4b5-1c24-ef70-4973-3e24bed95040
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PartyReaction:6bbea4b5-1c24-ef70-4973-3e24bed95040
msgctxt "hbdef715bg1ecfg44f4gb684gfce60c173916"
msgid ""
"My kin wield their spears formidably. It would be foolish to provoke battle "
"with them now."
msgstr "내 동족들은 창을 무섭게 휘두르는군. 지금 저들과 전투를 벌이는 것은 어리석은 일이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PartyReaction
#. Speaker = Player
#. NodeID = 8e3cd81d-141a-ccc6-c58a-0e9aa56aa9f2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_GithChokepoint_State_MeetsLevel = True
#.   Tag:
#.      - REALLY_LAEZEL(0) = False
#.      - REALLY_GITHYANKI(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PartyReaction:8e3cd81d-141a-ccc6-c58a-0e9aa56aa9f2
msgctxt "hc80742f8g5ee1g4f1fgaeb1g8f72bffec6b5"
msgid ""
"These gith are formidable - but not infallible. We can take them in battle, "
"should it come to that."
msgstr "저 기스들은 강력하지만 무적은 아니야. 만약 전투가 벌어진다고 해도, 충분히 상대할 수 있겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PartyReaction
#. Speaker = Player
#. NodeID = a8625e98-939d-a33c-3fe3-e6c6b1ec8646
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(0) = False
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PartyReaction:a8625e98-939d-a33c-3fe3-e6c6b1ec8646
msgctxt "h38d58598g15c1g4a79gbb64gb3945ba49812"
msgid "I hate to be negative, but those gith will carve you up like a goose."
msgstr "부정적으로 말하긴 싫지만, 저 기스들은 널 거위마냥 조각내버릴걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PartyReaction
#. Speaker = Player
#. NodeID = a8625e98-939d-a33c-3fe3-e6c6b1ec8646
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(0) = False
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PartyReaction:a8625e98-939d-a33c-3fe3-e6c6b1ec8646
msgctxt "heec69445gf6a9g4718g84a1gb147ec306971"
msgid "Stay clear of those gith. Even the Blade of Frontiers has his limits."
msgstr "저 기스들에게선 떨어지는 게 좋겠어. 변경의 칼날도 한계가 있거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PartyReaction
#. Speaker = Player
#. NodeID = a8625e98-939d-a33c-3fe3-e6c6b1ec8646
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(0) = False
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PartyReaction:a8625e98-939d-a33c-3fe3-e6c6b1ec8646
msgctxt "hd7346fb5gb572g46edga1a4g9c2bde706521"
msgid ""
"Those gith look like a fight and a half. Best keep away from them for now."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PartyReaction
#. Speaker = Player
#. NodeID = a8625e98-939d-a33c-3fe3-e6c6b1ec8646
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(0) = False
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PartyReaction:a8625e98-939d-a33c-3fe3-e6c6b1ec8646
msgctxt "h612d6eb1g875eg4538g9ee6g215c2e56f6c9"
msgid "With the right troops I could take them... with you, I'm not so sure."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PartyReaction
#. Speaker = Player
#. NodeID = a8625e98-939d-a33c-3fe3-e6c6b1ec8646
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PartyReaction:a8625e98-939d-a33c-3fe3-e6c6b1ec8646
msgctxt "hb78511a2g50a6g458dgb5f4gd252b65b9b0c"
msgid ""
"You'd have to be a fool to pick a fight with that lot. Best to keep away for "
"now..."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PartyReaction
#. Speaker = Player
#. NodeID = ba4ba6e7-a110-0712-dfbe-a385c93862cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PartyReaction:ba4ba6e7-a110-0712-dfbe-a385c93862cf
msgctxt "h938c08a1g0a2eg48a1g8f8egaaa8f444f9a1"
msgid "Let's see if they want to have their blood spilled."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PartyReaction
#. Speaker = Player
#. NodeID = c46bd632-99f8-44e0-8d2d-456a3d75ce9c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_GithChokepoint_State_MeetsLevel = True
#.   Tag:
#.      - REALLY_LAEZEL(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PartyReaction:c46bd632-99f8-44e0-8d2d-456a3d75ce9c
msgctxt "hf0948f54gbda7g40aegb6dbg007e4c15579c"
msgid "Githyanki! I must speak with them - a crèche must be near."
msgstr "기스양키군! 지금 얘기해 봐야겠어. 양성소가 분명 근처에 있을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PartyReaction
#. Speaker = Player
#. NodeID = c983b063-1ae5-e246-a3ba-79f718ff5a50
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_GithChokepoint_State_MeetsLevel = True
#.   Tag:
#.      - REALLY_LAEZEL(0) = False
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PartyReaction:c983b063-1ae5-e246-a3ba-79f718ff5a50
msgctxt "hf092783bg2d62g42eeg91c9g4b0c2caf0adf"
msgid "Oh - can we kill them? Please? Pretty please?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PartyReaction
#. Speaker = Player
#. NodeID = c983b063-1ae5-e246-a3ba-79f718ff5a50
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_GithChokepoint_State_MeetsLevel = True
#.   Tag:
#.      - REALLY_LAEZEL(0) = False
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PartyReaction:c983b063-1ae5-e246-a3ba-79f718ff5a50
msgctxt "h784b86efg79f3g4a15g8614ga6a426d50022"
msgid "Come on, already - we've got a roadblock to clear."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PartyReaction
#. Speaker = Player
#. NodeID = c983b063-1ae5-e246-a3ba-79f718ff5a50
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_GithChokepoint_State_MeetsLevel = True
#.   Tag:
#.      - REALLY_LAEZEL(0) = False
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PartyReaction:c983b063-1ae5-e246-a3ba-79f718ff5a50
msgctxt "hb8dd91d0gc721g40bfg9ad5g828577cc4559"
msgid "Those whelps are blocking the bridge. Time to put them in their place."
msgstr "저새끼들이 다리를 막고 있어. 제 자리로 보내버리자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PartyReaction
#. Speaker = Player
#. NodeID = c983b063-1ae5-e246-a3ba-79f718ff5a50
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_GithChokepoint_State_MeetsLevel = True
#.   Tag:
#.      - REALLY_LAEZEL(0) = False
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PartyReaction:c983b063-1ae5-e246-a3ba-79f718ff5a50
msgctxt "haa21ccd7g05bfg4bb5gb12dg0b79bffb37fc"
msgid "Want me to send them to the Hells? Just say the word."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PartyReaction
#. Speaker = Player
#. NodeID = c983b063-1ae5-e246-a3ba-79f718ff5a50
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_GithChokepoint_State_MeetsLevel = True
#.   Tag:
#.      - REALLY_LAEZEL(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PartyReaction:c983b063-1ae5-e246-a3ba-79f718ff5a50
msgctxt "h2997b25fgf98cg44a6g8034g374a0fd767fb"
msgid ""
"I reckon those warriors holding the bridge can be fought off... if it comes "
"to that."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PartyReaction
#. Speaker = Player
#. NodeID = e64d2e19-a83c-415e-5526-a389abf79ffc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(0) = False
#.      - REALLY_GITHYANKI(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PartyReaction:e64d2e19-a83c-415e-5526-a389abf79ffc
msgctxt "hf4b31541g0157g4538gb918g25334c32f2a0"
msgid ""
"My kin wield their spears formidably. It would be foolish to provoke battle "
"with them now."
msgstr "내 동족들은 창을 무섭게 휘두르는군. 지금 저들과 전투를 벌이는 것은 어리석은 일이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ReadingMap
#. Speaker = Narrator
#. NodeID = 0be0c84a-7509-36c8-d447-2199fdd2db53
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_Knows_CrecheLocation = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ReadingMap:0be0c84a-7509-36c8-d447-2199fdd2db53
#, fuzzy
msgctxt "hf4015a67gc899g4954g89ddg0ae6b8b613d1"
msgid ""
"*A mystical map glows before you, revealing a githyanki refuge inside a "
"temple within the mountain pass.*"
msgstr "*눈앞에 신비로운 지도가 빛나며 산길 너머에 있는 기스양키 피난처의 위치가 드러납니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ReadingMap
#. Speaker = Lae'zel
#. NodeID = 0d39dae8-6ec4-391e-fb54-1cb0c403c664
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ReadingMap:0d39dae8-6ec4-391e-fb54-1cb0c403c664
msgctxt "h546a474cge80fg409fg9d01gfd70dfa472f9"
msgid "Hurry forth. Purification is at hand."
msgstr "서두르자. 정화가 코앞에 있다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ReadingMap
#. Speaker = Narrator
#. NodeID = 109ec69a-da08-a2f6-b403-db356c862d6f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = False
#. SetFlags:
#.   Global:
#.     - GLO_GithChokepoint_Knows_DecipheredMap = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ReadingMap:109ec69a-da08-a2f6-b403-db356c862d6f
msgctxt "hc3ae5556g41b7g4c27g8e3bgab229db827ff"
msgid "*Magical energy courses through the slate, then to Lae'zel.*"
msgstr "*마법적인 에너지가 석판을 타고 흐르더니, 레이젤에게 흘러갑니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ReadingMap
#. Speaker = Narrator
#. NodeID = 113b61b8-8adb-b43f-0998-e60ba23bce83
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ReadingMap:113b61b8-8adb-b43f-0998-e60ba23bce83
msgctxt "he4680b86g8971g4616gadffg8b342e764d7e"
msgid ""
"*The slate also reveals their mission: to locate a polyhedric relic of great "
"importance to your queen.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ReadingMap
#. Speaker = Narrator
#. NodeID = 134da9ed-12aa-d238-b2e6-824ad12e4574
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_GithChokepoint_Knows_DecipheredMap = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ReadingMap:134da9ed-12aa-d238-b2e6-824ad12e4574
msgctxt "h22ea0529gf485g459bg9a51gb9b57ee9d990"
msgid ""
"*Magical energy courses through the slate. You are flooded with "
"understanding.*"
msgstr "*마법적인 에너지가 석판을 타고 흐릅니다. 이해의 홍수가 밀려 들어옵니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ReadingMap
#. Speaker = Narrator
#. NodeID = 1a94e246-a5bd-90fc-9a22-c3e0f903636d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_GithChokepoint_Knows_DecipheredMap = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ReadingMap:1a94e246-a5bd-90fc-9a22-c3e0f903636d
msgctxt "h5b2c41dbg4f9dg44e0g8baag28b5a3cbd3f7"
msgid ""
"*Magical energy courses through the slate, then to Lae'zel. Your own body "
"buzzes in resonance.*"
