#.      - GOB_WolfPens_Beastmaster002_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_WolfPens_Beastmaster002_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_Beastmaster002:c7a44a41-9acf-0319-0a4a-d86df51ce533
msgctxt "h6fe9adb8g72b5g49edg948agb5efed443747"
msgid "Hands off. This one's for the pups."
msgstr "손 떼. 워그들 먹일 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_Beastmaster002
