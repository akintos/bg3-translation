#.      - b8958184-8715-01f5-4668-f08390d1151e_Loop 2 = True
#.      - b8958184-8715-01f5-4668-f08390d1151e_Loop 1 = True
#.      - b8958184-8715-01f5-4668-f08390d1151e_Intro = True
#. SetFlags:
#.   Local:
#.     - b8958184-8715-01f5-4668-f08390d1151e_Loop 2 = False
