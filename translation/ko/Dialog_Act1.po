#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter_ThreewayDialogAfterBaelenAteMushroom:e16f78e8-c878-a9a4-cdd0-f3ff380d730a
msgctxt "h3c32864eg2199g40b3g8f4ag78466f8c230b"
msgid "<i>Observe the couple silently.</i>"
msgstr "<i>조용히 부부를 관찰한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter_ThreewayDialogAfterBaelenAteMushroom
#. Speaker = Derryth Bonecloak
#. NodeID = ea40d981-1a21-8902-22b7-9ccd3e927689
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter_ThreewayDialogAfterBaelenAteMushroom:ea40d981-1a21-8902-22b7-9ccd3e927689
msgctxt "ha72bb877g1349g455cg9cacg8eb76c4b61ed"
msgid "Do you remember these last years? Since you've been sick?"
msgstr "지난 몇 년의 시간을 기억 못하는 거야? 당신이 아팠을 때부터?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter_ThreewayDialogAfterBaelenAteMushroom
#. Speaker = Baelen Bonecloak
#. NodeID = fdf5c4a1-a487-54a5-fa6b-4dd534147e3f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter_ThreewayDialogAfterBaelenAteMushroom:fdf5c4a1-a487-54a5-fa6b-4dd534147e3f
msgctxt "h1d6cc4e7g1314g4dcag84e9gbf4aad83a21b"
msgid ""
"Respect? After she's using me as a pack mule and a truffle pig these past "
"years."
msgstr "존중이라고? 그녀가 날 노새에 버섯 찾는 돼지로 수년 간 부려 먹었는데 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter_ThreewayDialogAfterBaelenAteMushroom
#. Speaker = Baelen Bonecloak
#. NodeID = ff59dd24-fce1-4bd5-fbc4-404984d1d6ba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter_ThreewayDialogAfterBaelenAteMushroom:ff59dd24-fce1-4bd5-fbc4-404984d1d6ba
msgctxt "h8dbdc73bg3434g45a4g9a68ga6fa4f210298"
msgid "Gods, I can finally <i>think!</i>"
msgstr "신이시여, 드디어 <i>생각을</i> 할 수 있군!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent07_AD_Combat
