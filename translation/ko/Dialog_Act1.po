msgctxt "h33f7e6e0gd356g4ecbg9ddcgee88889ae5b8"
msgid "Drive them out!"
msgstr "놈들을 몰아내!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_Apprentice
#. Speaker = Nettie
#. NodeID = 3771237e-92b0-d31b-38c8-057500d7abb2
