msgid "<i>A simple tumbler lock. Make short work of it.</i>"
msgstr "<i>간단한 자물쇠다. 금방 열어버린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = f047f43b-6c6e-db5d-f7e4-821f1511f4fe
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_TorturedAdventurer_LeftInChains(1) = True
#.     - GOB_TorturedAdventurer_Knows_FailedPersuade(1) = True
