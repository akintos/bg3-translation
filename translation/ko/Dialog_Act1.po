msgctxt "he9b3a361g60cdg4d8eg9426g90a405bedb63"
msgid "Deep grooves in the mud around that rock."
msgstr "저 바위 주변 진흙이 깊게 파여있는걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_HarperBooster_ScaredBoar
#. Speaker = Player
#. NodeID = 0a5a641f-65b9-c179-3c50-32ab8867075d
#. HandlePath = TaggedText[0].TagText[0]
