msgctxt "hf2554f6bg96c2g4816g8559g71a2d8794091"
msgid "You'll meet my master soon, and have a chance to show your gratitude."
msgstr "당신은 제 주인님을 다시 만나게 되실 테니, 그때 감사를 표할 기회가 있을 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarlockProposal_Warlock
#. Speaker = Player
#. NodeID = 7f504a04-b52f-3171-529f-3e2103f0201c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarlockProposal_Warlock:7f504a04-b52f-3171-529f-3e2103f0201c
msgctxt "hc9b5ea58g7f14g472fg8c85g3ba57156a801"
msgid "And whose pet are you?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarlockProposal_Warlock
#. Speaker = Korrilla
#. NodeID = 8935d8a2-9e41-cb2d-7f17-554190b9c099
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarlockProposal_Warlock:8935d8a2-9e41-cb2d-7f17-554190b9c099
msgctxt "h04070b91g642ag4bceg81b6g3fee8a85dba9"
msgid ""
"I know all about your situation... your <i>condition</i>. My master has "
"taken a personal interest."
msgstr ""

