msgid "You rat!"
msgstr "이 쥐새끼가!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaezelRecruitment_PickASide
#. Speaker = Lae'zel
#. NodeID = c122fd1b-d7e7-10ab-1f2d-0f553a1d6a5f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaezelRecruitment_PickASide:c122fd1b-d7e7-10ab-1f2d-0f553a1d6a5f
msgctxt "h122a2b74ge758g49e5g8a4fg8db7be2345e4"
msgid "Prove you're not a craven. Join me, or die."
msgstr "네가 비겁자가 아님을 증명해라. 나와 함께하거나, 죽어라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaezelRecruitment_PickASide
