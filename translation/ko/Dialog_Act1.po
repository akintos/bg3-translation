msgctxt "h1ed443f9gfbfbg4c87gae6bg6b78dbe6bb65"
msgid "Splendid crossbow, quite refined. No duergar clan made this."
msgstr "훌륭한 쇠뇌야, 꽤 세련되었군. 듀에르가가 이걸 만들었을 리 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SharranTargetPractice_PAD
#. Speaker = Player
#. NodeID = 681f3ffa-d0e5-4e35-881e-2ed07ff29852
#. HandlePath = TaggedText[7].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SharranTargetPractice_PAD:681f3ffa-d0e5-4e35-881e-2ed07ff29852
#, fuzzy
msgctxt "h9743c88bg9227g4ee0g8ef9gfdba1c972317"
msgid "This crossbow is too well designed to be made by duergar."
msgstr "이 쇠뇌는 듀에르가가 만들었다기엔 너무 정교해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Xanta
#. NodeID = 05f5f645-9f4f-d133-637c-3721c3e49e00
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:05f5f645-9f4f-d133-637c-3721c3e49e00
msgctxt "hac0977d5g0fccg494egb02ege4ec2336101e"
msgid "It is no <i>coup </i>- it is the opportunity of our entire lives!"
msgstr "이건 <i>반역이</i> 아니야 - 우리 일생 일대의 기회라고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Xanta
#. NodeID = 05f9c98c-51a3-e161-8471-75740b5081a4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_DuergarCamp_SpiderEvangelical_DialogEnded = True
