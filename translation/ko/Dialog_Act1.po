msgctxt "h4f225f55g2536g4f0bg8d7bg1b86c994e89c"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FairyRings_Dead
#. Speaker = Dead Drow
#. NodeID = 4ee85ff1-3f21-733d-5f59-86388a60e6aa
#. HandlePath = TaggedText[0].TagText[0]
