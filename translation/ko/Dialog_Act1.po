#.   Dialog:
#.      - GOB_Torturers_BurnedThigh(2) = True
#. SetFlags:
#.   Dialog:
#.     - GOB_Torturers_Assisted(2) = True
#.   Object:
#.     - GLO_PaladinOathbreaker_Event_BrokeOath(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:7d725bbd-6436-d5d6-b4db-5b264e134749
msgctxt "h696348f9ga81ag4c33g8fe7g77e7ebc48a29"
msgid "<i>Smash a club into his knee.</i>"
msgstr "<i>몽둥이로 그의 무릎을 내려친다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Narrator
#. NodeID = 7f1d0ea6-410b-bb26-0e56-8a1c619ea1e6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount6(2) = False
#.   Tag:
#.      - TRUESOUL(2) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount6(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:7f1d0ea6-410b-bb26-0e56-8a1c619ea1e6
msgctxt "h003e4c53g8b35g4e43g93a1g1eccba256407"
msgid ""
"*The presence deep in your mind is awake, unblinking. This is it. A single "
"word pervades your consciousness: 'Soon'.*"
msgstr ""
"*당신의 정신 속 깊이 자리잡은 존재가 태연스레 깨어납니다. 올 것이 왔군요. 한 단어가 당신의 의식 속으로 스며듭니다. ‘곧’*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = 80984dad-0339-623e-6b73-8813e3e34204
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:80984dad-0339-623e-6b73-8813e3e34204
msgctxt "h54e87232g4ffag4b9bg8a8ega671eaac9186"
msgid ""
"So now we're teachin' 'im 'is place. 'Course, now that you're 'ere... we'd "
"gladly let ya take over!"
msgstr "그래서 주제를 알게 해주던 참이야. 물론, 이제 네가 왔으니... 기꺼이 네게 맡기도록 할게!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Narrator
#. NodeID = 89497ab5-7969-7163-8829-e255147f629c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount2(2) = False
#.   Tag:
#.      - TRUESOUL(2) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount2(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:89497ab5-7969-7163-8829-e255147f629c
msgctxt "h1de3cde4g5dd5g47e0g9dedge3e32de05230"
msgid ""
"*Something stirs deep within you, hungry and alert... it's taking something "
"you'll never get back.*"
msgstr "*몸 깊숙한 데서 굶주리고 기민한 존재가 꿈틀댑니다... 잃으면 되찾지 못할 뭔가를 좀먹고 있군요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = 89cadc42-b156-6278-073a-b2da0b21cdf3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_Torturers_Failed = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:89cadc42-b156-6278-073a-b2da0b21cdf3
msgctxt "hac852209gc52eg4926ga7dfg46231ac6a3fc"
msgid "Get lost - 'less ya want to get whipped, too."
msgstr "저리 꺼져. 너도 한 대 맞고 싶지 않다면 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = 8a44c395-fb71-6bf1-f229-ece2e796180e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:8a44c395-fb71-6bf1-f229-ece2e796180e
msgctxt "h8b05e225g4a1eg4592g944eg0d20eaca02c6"
msgid "What does 'e think we'll do? Kill 'im?"
msgstr "두목은 무슨 생각인 거야? 우리가 녀석을 죽일까 봐 그러나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = 8c0a7f91-7752-ef8e-591b-74532068fea6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GLO_PaladinOathbreaker_Event_BrokeOath(2) = True
#. TagRule: REALLY_DARK_URGE
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:8c0a7f91-7752-ef8e-591b-74532068fea6
msgctxt "h8ca1c72bg6a3eg4f84g9f15gdee589f5f986"
msgid "<i>Treat him to a refreshing stretch.</i>"
msgstr "<i>상쾌함을 느낄 수 있게 온몸을 늘여준다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = 8c0a7f91-7752-ef8e-591b-74532068fea6
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Object:
#.     - GLO_PaladinOathbreaker_Event_BrokeOath(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:8c0a7f91-7752-ef8e-591b-74532068fea6
msgctxt "hb162920fgbd68g48d9g92a7gfaa8bca25b4c"
msgid "<i>Crank the rack and stretch him.</i>"
msgstr "<i>고문대를 조작해 그를 잡아 늘인다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = 8df5710b-86fe-3781-4e13-6775e0dbfc48
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Torturers_BrokeNose(2) = False
#. SetFlags:
#.   Global:
#.     - GOB_Torturers_Failed = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:8df5710b-86fe-3781-4e13-6775e0dbfc48
msgctxt "hfb01d200g4056g4424gbc78gaeef5a61a1d9"
msgid "Should've known you'd be soft. Get out!"
msgstr "네가 여린 마음의 소유자라는 걸 알았어야 했는데. 나가!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = 8e2f5e5b-b6f3-51d1-44fe-3f11b7a337ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:8e2f5e5b-b6f3-51d1-44fe-3f11b7a337ae
msgctxt "h12bfb62eg08a1g4c64gad13g4d6d7d10a5c0"
msgid ""
"Think you're better? Fine! He's all yours - muck it up and you'll answer to "
"the drow."
msgstr "네가 더 잘한다고 생각해? 좋아! 그는 네거야 - 망치면 그 드로우에게 설명해야 할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = 8f4a1e1a-1730-0dbf-7ff6-0076deff1e60
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:8f4a1e1a-1730-0dbf-7ff6-0076deff1e60
msgctxt "h28a4581dg9d2eg4302g9700g74908da60466"
msgid "What, think you can do better? HA. Go on then, have at it."
msgstr "뭐야, 네가 더 잘할 수 있다고 생각하는 거야? 하. 그럼 어디 한번 해봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Liam
#. NodeID = 90820129-e970-9309-fdff-e5f36fda0e90
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Torturers_State_KnowDen = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:90820129-e970-9309-fdff-e5f36fda0e90
msgctxt "haa6184dagf013g443fg949eg865a06ec3fb0"
msgid "AARGH! P-please, why... s-stop... pl...ease... I -"
msgstr "<b>아아악!</b> 제-제발, 어째서... 그-그만... 제...발... 난-"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = 90f9ad04-4f9b-17f0-2da0-bcba2275b8e9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Torturers_AskedWhatTheyAreDoing(2) = False
#.   Tag:
#.      - REALLY_DARK_URGE(2) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_Torturers_AskedWhatTheyAreDoing(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:90f9ad04-4f9b-17f0-2da0-bcba2275b8e9
msgctxt "h0ddee845ge7e7g4e2dg86a7g0e2afd4069c5"
msgid "Why are you torturing him?"
msgstr "왜 그를 고문하고 있는 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = 92e16e01-78a4-7c7c-d6ca-60c2d71a24f9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Torturers_State_KnowDen = True
#. SetFlags:
#.   Global:
#.     - GOB_Torturers_State_TorturedEnough = True
#.     - GOB_HappyTorturers_Event_ClearSpearOwnership = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:92e16e01-78a4-7c7c-d6ca-60c2d71a24f9
msgctxt "h1091eb3bg564cg40cegbe93g20d1bb9430aa"
msgid "Well, party's over. No fun kickin' a beaten dog. Let's go."
msgstr "자, 파티는 끝났어. 두들겨 맞은 개를 계속 차는 건 재미 없다고. 그만 가자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = 971a7417-0bd8-eb38-7d31-65b0d77094ea
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SafeRomance_Enabled(2) = False
#. TagRule: ELF or GNOME or HALFLING
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:971a7417-0bd8-eb38-7d31-65b0d77094ea
msgctxt "h44715822gbd14g4e13g8713g9904ef08fefc"
msgid "Scrawny thing like you? I'll believe that when I see it."
msgstr "너 같은 말라깽이가 이 일을 한다고? 두 눈으로 직접 봐야지 믿을 수 있을 거 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = 971a7417-0bd8-eb38-7d31-65b0d77094ea
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SafeRomance_Enabled(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:971a7417-0bd8-eb38-7d31-65b0d77094ea
msgctxt "h29cdb17fg3fe2g41c1gb214g4ce63bd46a0f"
msgid "You? I'll believe that when I see it."
msgstr "네가 이 일을 한다고? 두 눈으로 직접 봐야지 믿을 수 있을 거 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Narrator
#. NodeID = 9af909a1-dd42-12ca-82c1-08139f571305
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount3(2) = False
#.   Tag:
#.      - TRUESOUL(2) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount3(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:9af909a1-dd42-12ca-82c1-08139f571305
msgctxt "h200e847agaefag4029gb3bbg70bad4bc96be"
msgid "*Your mind lurches, reeling suddenly as if... bitten.*"
msgstr "*뭔가에 깨물린 것처럼 느닷없이 정신이 휘청거립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Liam
#. NodeID = 9b0d353d-57fa-7cd8-dc86-193044377959
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_TorturedAdventurer_Event_SoftOption(2) = False
#.   Global:
#.      - GOB_Torturers_State_KnowDen = True
#. SetFlags:
#.   Object:
#.     - GOB_TorturedAdventurer_State_Faint(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:9b0d353d-57fa-7cd8-dc86-193044377959
msgctxt "h566f8630ge4d6g4befg8495ga3a471e22772"
msgid "No! P-please, why... s-stop... pl...ease... I -"
msgstr "안 돼! 제-제발, 어째서... 그-그만... 제...발... 난-"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Liam
#. NodeID = 9bff3604-3814-42f9-929f-f8495a9b5faa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:9bff3604-3814-42f9-929f-f8495a9b5faa
msgctxt "h347abbe7g35d8g40d6g864dg5865774b8dd7"
msgid "What... what are you?"
msgstr "넌.... 대체 뭐야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Liam
#. NodeID = 9d86226f-eef2-c208-ff5a-bd7096dda0b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:9d86226f-eef2-c208-ff5a-bd7096dda0b1
msgctxt "h5212818fgad63g4c17g9e61ge72d68031cec"
msgid "Argh! Please, s-stop!"
msgstr "악! 제발, 그-그만!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = 9e0aa6bf-6e1a-2fe8-2299-5bfaac90e2b3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_Torturers_Goblet_Inclusion_Start(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:9e0aa6bf-6e1a-2fe8-2299-5bfaac90e2b3
msgctxt "h06dbcb3ag2d75g4fb3g95b7g8093952ab6a8"
msgid ""
"But there's some tongue-looseners in the fire, if you want 'em! We'll leave "
"ya to it."
msgstr "대신 화로 쪽에 입을 열게 할 도구들이 몇 개 있으니 쓰고 싶으면 써! 그럼 나머지 일을 맡길게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = 9ecf29c1-5fd8-af9c-80f4-109b93ae820e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_5 = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:9ecf29c1-5fd8-af9c-80f4-109b93ae820e
msgctxt "h9aa11c3dga80fg4e85ga08eg63d4378f0757"
msgid "C'mon Grush. There might still be a slurp o' ale to be had."
msgstr "가자 그루쉬. 아직 먹어치울 에일이 남아 있으려나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = a0d77632-88c7-9ae1-3e31-eedd8dccb5c1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Moonrise_Knows_Prisoners = True
#.   Object:
#.     - GOB_Torturers_Persuaded(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:a0d77632-88c7-9ae1-3e31-eedd8dccb5c1
msgctxt "hb84e872bgeb1ag4164g8ed2gadf7aa95eb67"
msgid ""
"Should've sent 'im to Moonrise with the rest, for all the good he's been."
msgstr "나머지 놈들이랑 같이 문라이즈로 보내버렸어야 했는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = a1c40107-e17d-97a6-3f0a-b86c966e460f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:a1c40107-e17d-97a6-3f0a-b86c966e460f
msgctxt "hdbf400d4g581cg4d88gbb6dgde9b0c308c1c"
msgid "You are about to have the best day of your miserable life!"
msgstr "네 비참한 인생에서 오늘만큼은 아주 잊지 못할 날이 될 거다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = a21d678b-23fd-e7d7-d7ed-07bb52cfd84e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_5 = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:a21d678b-23fd-e7d7-d7ed-07bb52cfd84e
msgctxt "h6f0bb098g2c0ag4a6egb2e1g3826428c70a8"
msgid "I - I wasn't! I didn't know! C'mon, Grush, let's go!"
msgstr "그...그건 아니야! 난 몰랐어! 어서, 그루쉬, 그만 가자고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = a2c3d2c5-8c27-ff3f-ee0c-8424148b10b6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Torturers_AskedWhatTheyAreDoing(2) = False
#.   Tag:
#.      - REALLY_DARK_URGE(2) = True
#. SetFlags:
#.   Dialog:
#.     - GOB_Torturers_AskedWhatTheyAreDoing(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:a2c3d2c5-8c27-ff3f-ee0c-8424148b10b6
msgctxt "h68599010g18dcg43b6g8624g8e8045dd5b13"
msgid "Nice rack."
msgstr "멋진 고문대로군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Narrator
#. NodeID = a357471f-fa34-64e0-366f-947da6cedcd5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:a357471f-fa34-64e0-366f-947da6cedcd5
msgctxt "h28e55796g2f82g4da7g8762gd6999d98e1e9"
msgid "*The prisoner smiles through the pain, then spits in your direction.*"
msgstr "*포로는 고통 속에서도 미소를 짓더니, 당신을 향해 침을 뱉습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = a681f573-a513-1666-92cb-484e8783c016
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_Torturers_Hostile(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:a681f573-a513-1666-92cb-484e8783c016
msgctxt "hc84c6872geb17g4946gb9c4g6450ddfedfbf"
msgid "What...? You fool!"
msgstr "이게 무슨...? 이 바보 같은 놈이!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = a6eb4996-bb88-3018-2881-6158997cd8d4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Torturers_BrokeNose(2) = False
#.      - GOB_TorturedAdventurer_Event_SoftOption(2) = True
#. SetFlags:
#.   Object:
#.     - GLO_PaladinOathbreaker_Event_BrokeOath(2) = True
#. TagRule: REALLY_DARK_URGE
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:a6eb4996-bb88-3018-2881-6158997cd8d4
msgctxt "h52c0bffag641eg460agbea4g3ec75608c64c"
msgid "<i>Crack his kneecaps like eggs.</i>"
msgstr "<i>계란 부수듯 무릎을 깨버린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = a6eb4996-bb88-3018-2881-6158997cd8d4
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Torturers_BrokeNose(2) = False
#.      - GOB_TorturedAdventurer_Event_SoftOption(2) = True
#. SetFlags:
#.   Object:
#.     - GLO_PaladinOathbreaker_Event_BrokeOath(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:a6eb4996-bb88-3018-2881-6158997cd8d4
msgctxt "h30423d64g6ab1g487egbd68gfa320f864297"
msgid "<i>Smash a club into his knee.</i>"
msgstr "<i>몽둥이로 그의 무릎을 내려친다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = a7bd7c31-6947-374e-6fbb-9cf6ad082e7c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_HappyTorturers_Assaulted = True
#.   Object:
#.      - GLO_SafeRomance_Enabled(2) = False
#.   Tag:
#.      - PALADIN_DEVOTION(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:a7bd7c31-6947-374e-6fbb-9cf6ad082e7c
msgctxt "hd477affegaebdg4713g8932gc941fdc6ca16"
msgid "I wanted to join in on the fun - let me put him through his paces."
msgstr "나도 재미 좀 보고 싶었어. 내가 한번 해보지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = a8999149-aa40-8d87-51b3-21dbec10e111
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 20
#. CheckFlags:
#.   Tag:
#.      - DROWELF(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:a8999149-aa40-8d87-51b3-21dbec10e111
msgctxt "h08d66b0bg4cdcg43ffga63ag4c10b07c4f11"
msgid "Your boss sent me. He wants the prisoner intact."
msgstr "너희 두목이 날 보냈어. 죄수는 손대지 말래."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = a9efdbbe-f42e-3c78-7874-3daba0527bcd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_HappyTorturers_Assaulted = True
#.   Tag:
#.      - DROWELF(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:a9efdbbe-f42e-3c78-7874-3daba0527bcd
msgctxt "h64a4a8a3g684ag4cddgbd23g6af2c3c8396a"
msgid "M-my drowness, if you wanted a try at torture, you only had to say so!"
msgstr "드... 드로우 선생, 고문을 하고 싶었던 거라면 말 한마디 했으면 됐다고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = abd3b1de-3004-1abc-3b3a-1a776c0816d8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Torturers_BrokeNose(2) = True
#.   Global:
#.      - GOB_Torturers_State_KnowDen = False
#. SetFlags:
#.   Global:
#.     - GOB_Torturers_Failed = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:abd3b1de-3004-1abc-3b3a-1a776c0816d8
msgctxt "h8e820656g6385g493ag8b7dgb4336abf062a"
msgid "And 'e was just about to talk. Get out. Out!"
msgstr "그는 막 말하려던 참이었어. 나가! 나가라고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = afc54313-e42f-6558-7c7c-a7cae2379025
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:afc54313-e42f-6558-7c7c-a7cae2379025
msgctxt "he5982d60g7109g46d1g8565ga18f14749ef2"
msgid ""
"But nooo! Ya gotta keep silent, don'tcha? Where'd they flee to, ya stubborn "
"RAT?"
msgstr "그런데 고집은...! 어디 한번 계속 입 다물어 봐, 응? 놈들이 어디로 꼬리를 뺐냐, 이 고집불통 쥐새끼야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = afef60fc-5773-81de-23de-ec2db43c4f21
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Torturers_State_KnowDen = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:afef60fc-5773-81de-23de-ec2db43c4f21
msgctxt "h749d6be2gd899g4a6fg9129g212390b53b3d"
msgid "Or what? Ya gonna start a fight?"
msgstr "싫다면 어쩔 건데? 한 판 붙어보자는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = b0726886-32a9-091e-8e5e-93986502be4e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 10
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(2) = False
#.   Tag:
#.      - TRUESOUL(2) = False
#.      - ILLITHID(2) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:b0726886-32a9-091e-8e5e-93986502be4e
msgctxt "hcbd116bcg1812g4ebeg891eg9d627ddc0f8e"
msgid "Leave, both of you."
msgstr "떠나라, 너희 둘 다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = b2ca8e0f-3dd5-ec9b-5166-a561a616c1c3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:b2ca8e0f-3dd5-ec9b-5166-a561a616c1c3
msgctxt "h934f8e3egf709g4f92ga0b5gd3442254f8de"
msgid "Look at 'im! You got 'im <i>good</i>."
msgstr "이 녀석 봐! <i>완전</i> 본때를 보여줬구먼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = b2db7d88-30c2-821f-d803-f5159a48f36a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:b2db7d88-30c2-821f-d803-f5159a48f36a
msgctxt "h8d89d7aegd965g4797g8905gead1dfad6064"
msgid ""
"Some other git found the grove before we did. Made us look real stupid, 'e "
"did."
msgstr "다른 녀석이 우리보다 한발 앞서 숲을 찾아냈어. 이놈이 우릴 완전 바보로 만들었다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = b3035be5-9383-0c36-280c-ac2eb2c9eca5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_Torturers_BurnedThigh(2) = True
#.     - GOB_TorturedAdventurer_Event_HardOption(2) = True
#.     - GOB_Torturers_Assisted(2) = True
#.   Object:
#.     - GLO_PaladinOathbreaker_Event_BrokeOath(2) = True
#. TagRule: REALLY_DARK_URGE
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:b3035be5-9383-0c36-280c-ac2eb2c9eca5
msgctxt "h5255d082geb54g45efgbe45g0f99f9a36f7f"
msgid "<i>...caress his thighs with the poker's warmth.</i>"
msgstr "<i>...온기를 품은 부지깽이를 들어 허벅지에 갖다 댄다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = b3035be5-9383-0c36-280c-ac2eb2c9eca5
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_Torturers_BurnedThigh(2) = True
#.     - GOB_TorturedAdventurer_Event_HardOption(2) = True
#.     - GOB_Torturers_Assisted(2) = True
#.   Object:
#.     - GLO_PaladinOathbreaker_Event_BrokeOath(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:b3035be5-9383-0c36-280c-ac2eb2c9eca5
msgctxt "hc68f2aeag3147g4edfg8976g215545711bc0"
msgid "<i>... press a red hot poker against his thigh.</i>"
msgstr "<i>허벅지에 달궈진 부지깽이를 갖다 댄다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = b6ccf095-dd5d-f033-b7bf-879656bc6a8b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Torturers_HasMet_Spike(2) = True
#.   Global:
#.      - GOB_Torturers_Failed = False
#.   Tag:
#.      - DROWELF(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:b6ccf095-dd5d-f033-b7bf-879656bc6a8b
msgctxt "h44239de3g5557g49dbgac62g95b6a63b9535"
msgid "Oh. You're back. Uh - he's all yours."
msgstr "오. 다시 왔군. 그럼... 저놈은 마음대로 해도 돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = b702fce1-0fd5-eec6-9c34-b5d28f6982b0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#.      - DROWELF(2) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_Torturers_HasMet_Spike(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:b702fce1-0fd5-eec6-9c34-b5d28f6982b0
msgctxt "h1532fc3eg60f6g40e6gb848gf1ae4d246374"
msgid "'Ere to see yer friend, have ya? Come an' join 'im, if ya like."
msgstr "친구를 만나러 왔나, 앙? 원한다면 이리 와서 함께하라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = b949943c-051e-1253-70be-1f06ded56b72
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_HappyTorturers_Event_ClearSpearOwnership = True
#.   Object:
#.     - GOB_Torturers_Goblet_Inclusion_Start(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:b949943c-051e-1253-70be-1f06ded56b72
msgctxt "h4bbfe991gf061g42ccgbf1bg42eaa9ad9cd6"
msgid ""
"O-of course! There's weapons in the fire if you want 'em. Uhm. We'll leave "
"ya to it."
msgstr "아...알겠어! 원하면 저기 불가에 무기도 있어. 으음. 그럼, 네게 맡길게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = ba8452e8-650e-6e7e-217f-d144392cdf1a
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:ba8452e8-650e-6e7e-217f-d144392cdf1a
msgctxt "h02b1e652g2abbg40d8gbfa8g0610a393197d"
msgid "S-sorry, ma'am, I didn't realise! He's all yours!"
msgstr "죄... 죄송합니다, 부인. 제가 몰라봤습니다! 녀석은 마음대로 하셔도 됩니다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = ba8452e8-650e-6e7e-217f-d144392cdf1a
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:ba8452e8-650e-6e7e-217f-d144392cdf1a
msgctxt "he25ee099ga679g45degad2cg17a34289d28c"
msgid "S-sorry, sir, I didn't realise! He's all yours!"
msgstr "죄... 죄송합니다. 제가 몰라봤습니다! 그는 마음대로 하셔도 됩니다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = ba8452e8-650e-6e7e-217f-d144392cdf1a
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:ba8452e8-650e-6e7e-217f-d144392cdf1a
msgctxt "h11ace7fag8c42g443dg9f73g324751b56d8d"
msgid "S-sorry, I didn't realise! He's all yours!"
msgstr "죄... 죄송합니다, 제가 몰라봤습니다! 녀석은 마음대로 하셔도 됩니다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = bb25967b-f41d-20c8-b68b-c8e68e5bd6e3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SafeRomance_Enabled(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:bb25967b-f41d-20c8-b68b-c8e68e5bd6e3
msgctxt "he96b1dedg51bdg40cbg90ebga29f1b7507ab"
msgid "Think you'd fare better? Fine - <i>prove it.</i>"
msgstr "더 잘할 수 있다고 생각해? 좋아. <i>어디 증명해 봐.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = bcdbe5a9-34d9-d0fa-9cc2-f3fbd0f3776d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Torturers_State_KnowDen = False
#. SetFlags:
#.   Dialog:
#.     - GOB_TorturedAdventurer_Event_SoftOption(2) = True
#. TagRule: REALLY_DARK_URGE
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:bcdbe5a9-34d9-d0fa-9cc2-f3fbd0f3776d
msgctxt "h0a9f1994g7d6ag47e1gb1a4gca70994d2c32"
msgid "BEG for mercy. BEG! BEG!"
msgstr "살려달라고 말해. 목숨을 구걸하라고! 어서!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = bcdbe5a9-34d9-d0fa-9cc2-f3fbd0f3776d
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Torturers_State_KnowDen = False
#. SetFlags:
#.   Dialog:
#.     - GOB_TorturedAdventurer_Event_SoftOption(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:bcdbe5a9-34d9-d0fa-9cc2-f3fbd0f3776d
msgctxt "ha447195egaab0g423fga0b3g6890817372e8"
msgid "Would you like to start begging for mercy now, or...?"
msgstr "지금부터 자비를 구할래, 아니면...?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = be7e14bc-cc32-77fb-0cf6-65411b00f6db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:be7e14bc-cc32-77fb-0cf6-65411b00f6db
msgctxt "h2ded0971gd7e0g46a1gb4faga12435cfa34d"
msgid "Oh, I'd like to see you try."
msgstr "오호라. 그거 궁금한데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = c20c6888-2001-c959-57a8-9c927d9c6dc1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_Torturers_Hostile(2) = True
#. TagRule: REALLY_DARK_URGE
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:c20c6888-2001-c959-57a8-9c927d9c6dc1
msgctxt "h24617fe4ge583g49c6g919fg4f3ca5679c51"
msgid "<i>... swim out of this spiral of cruelty. Attack the goblins.</i>"
msgstr "<i>...잔혹한 충동의 소용돌이에서 빠져 나온다. 고블린을 공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = c20c6888-2001-c959-57a8-9c927d9c6dc1
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_Torturers_Hostile(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:c20c6888-2001-c959-57a8-9c927d9c6dc1
msgctxt "h6cb08a2dg2c24g4e49ga695g7d8e44e7a5c7"
msgid "<i>... attack the goblins.</i>"
msgstr "<i>... 고블린을 공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = c363fa6e-fadf-5747-95e6-20f7e0c316fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:c363fa6e-fadf-5747-95e6-20f7e0c316fc
msgctxt "hba84c890g1a12g4dc1gab9fg347294ba2912"
msgid "Fine. Let me show you what real talent looks like."
msgstr "좋아. 진정한 재능이란 게 어떤 것인지 내가 보여주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = c4237ff8-24be-e914-0d33-23bc3e7d3c15
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Torturers_Failed = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:c4237ff8-24be-e914-0d33-23bc3e7d3c15
msgctxt "hbb72acfdg25a5g4fbag8a98gcc1e01b59484"
msgid "What're you still 'ere for? I said OUT!"
msgstr "왜 아직 여기서 얼쩡거리는 거야? 꺼지라고 했잖아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = c4837bb4-9e38-28bd-dcc6-f893cdff2d9f
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 20
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:c4837bb4-9e38-28bd-dcc6-f893cdff2d9f
msgctxt "hc38e593bg3e92g4155g9d42gc49551ccbbb8"
msgid "Go have yourselves a drink. Your boss sent me to relieve you."
msgstr "가서 술이나 한잔 하지 그래. 너희 대장이 너희더러 휴식을 좀 취하라고 나를 보냈어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = c6635641-e6de-3715-7470-e473093c1bf7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_Torturers_BrokeNose(2) = True
#.     - GOB_TorturedAdventurer_Event_SoftOption(2) = True
#.     - GOB_Torturers_Assisted(2) = True
#.   Object:
#.     - GLO_PaladinOathbreaker_Event_BrokeOath(2) = True
#. TagRule: REALLY_DARK_URGE
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:c6635641-e6de-3715-7470-e473093c1bf7
msgctxt "hc592c324g254ag4062g8fa9gb9eba8042bf4"
msgid "<i>... pulverize his shrivelled nethers with the spear-butt.</i>"
msgstr "<i>...창을 들어 움츠러든 아랫도리를 자루 끝으로 뭉개버린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = c6635641-e6de-3715-7470-e473093c1bf7
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_Torturers_BrokeNose(2) = True
#.     - GOB_TorturedAdventurer_Event_SoftOption(2) = True
#.     - GOB_Torturers_Assisted(2) = True
#.   Object:
#.     - GLO_PaladinOathbreaker_Event_BrokeOath(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:c6635641-e6de-3715-7470-e473093c1bf7
msgctxt "h239d4e62ga0d1g4f3dgbce6gd1db4227bbc8"
msgid "<i>... smash the butt of a spear into his groin.</i>"
msgstr "<i>... 창의 뭉툭한 부분으로 그의 사타구니를 내리친다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = ca451315-2c55-bda1-fc88-ebf1c09b1945
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Dialog:
#.      - GOB_Torturers_Knows_ShadowheartAdvice(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:ca451315-2c55-bda1-fc88-ebf1c09b1945
msgctxt "hedfa7cdagfc45g4298gbaf0gb98b6c31a6cb"
msgid ""
"I'm taking over. Your sloppy handiwork is going to kill the prisoner too "
"quickly."
msgstr "내가 처리하지. 네 서투른 솜씨로는 그 포로를 너무 빨리 죽여버릴 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Narrator
#. NodeID = cf6cca98-dbde-2862-8438-0b559a1b450b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(2) = True
#. SetFlags:
#.   Global:
#.     - ORI_DarkUrge_State_TorturedWithGoblins = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:cf6cca98-dbde-2862-8438-0b559a1b450b
msgctxt "h123e149eg873bg4eb7g8500g689416d26d54"
msgid "*You don't know why, but you are <i>really </i>good at this.*"
msgstr "*왠지 모르겠지만, 당신은 <i>정말로</i> 재능이 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = d21823f9-96fe-ba5b-6b09-377e658e2865
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:d21823f9-96fe-ba5b-6b09-377e658e2865
msgctxt "hd2a70452g3932g4093ga368gfebed325251d"
msgid "Stop."
msgstr "그만둬."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = d9796ba6-b0c9-b558-bfc0-7a66582ae8a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:d9796ba6-b0c9-b558-bfc0-7a66582ae8a4
msgctxt "h4113ad63g7097g4600g8e15g17c3f7b35f95"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Narrator
#. NodeID = da7c13e3-6b2c-9384-2e84-af946ea184b8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TRUESOUL(2) = False
#. SetFlags:
#.   Tag:
#.     - TRUESOUL(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:da7c13e3-6b2c-9384-2e84-af946ea184b8
msgctxt "h41134de7g0d89g49b8g8209gd199ddda6e34"
msgid ""
"*Your mind is full, bursting with ecstasy and terror. Finally, it is coming. "
"You are becoming.*"
msgstr "*당신의 정신이 황홀경과 공포로 가득 차오릅니다. 마침내, 때가 됐군요. 당신은 변화 중입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = db059bb2-21ad-7f63-b214-bab1fe959d7f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:db059bb2-21ad-7f63-b214-bab1fe959d7f
msgctxt "h7fee7314gc4b9g417fg97e8gbeddcaef5b30"
msgid ""
"What? That drow think I can't do my job? Go on, let's see how hard you can "
"make 'im scream."
msgstr "뭐라고? 그 드로우는 내가 일을 제대로 못 한다고 생각하는 거야? 어디 해봐. 얼마나 괴성을 자아낼 수 있을지 한번 보자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Liam
#. NodeID = dccb536a-a386-1e87-7348-af684fdfae28
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_TorturedAdventurer_State_Faint(1) = True
#.   Quest:
#.     - DEN_Conflict_SUB_AoD.GotGroveLocation(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:dccb536a-a386-1e87-7348-af684fdfae28
msgctxt "hb34da514ge517g4996ga6ccg165de85cd38d"
msgid "P-past the ruins and... the bridge. They c-covered the gate with ivy..."
msgstr "폐-폐허와... 다리 반대편에 있어. 문은 덩굴로 덮였고..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = dd81e3d2-2152-2a08-0d0b-66b3e9fc0889
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_DrowCommander_Event_GoTorturePrisoner = True
#.   Object:
#.      - GLO_SafeRomance_Enabled(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:dd81e3d2-2152-2a08-0d0b-66b3e9fc0889
msgctxt "h875e5b0agb292g4ebdg9cc6g96d6826035af"
msgid "Give me your club - Minthara asked me to assist you."
msgstr "몽둥이 이리 줘. 너를 도우라고 민타라가 그랬어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = de59f60b-84df-4493-70b8-05bf96e9767f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SafeRomance_Enabled(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:de59f60b-84df-4493-70b8-05bf96e9767f
msgctxt "hc383dcccg27d0g4540g8fe6g2321acecba40"
msgid "Think you can do better? Fine - <i>prove it.</i>"
msgstr "더 잘할 수 있다고 생각해? 좋아. <i>어디 증명해봐.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = ded47d23-8dde-b5c2-376c-255b75e9bd76
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:ded47d23-8dde-b5c2-376c-255b75e9bd76
msgctxt "h47216254g5a38g47c4g8c71gc792eb2c7c84"
msgid "I'm a little out of practice. Another time."
msgstr "내가 아직 좀 서툴러서. 다음 기회에 할게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Liam
#. NodeID = e0d288a3-5b03-4ecd-7ee7-64937d934c6c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:e0d288a3-5b03-4ecd-7ee7-64937d934c6c
msgctxt "h1750f0e8g57dbg440bg90aag3516f3b790d8"
msgid "Go... die."
msgstr "나가... 죽어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = e2618d10-0233-e8e1-4703-e6785d0a288f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:e2618d10-0233-e8e1-4703-e6785d0a288f
msgctxt "h4763c375g6b48g477cg874bg4ea9e15fc737"
msgid ""
"I need him to bleed, to talk - not to <i>die</i>. So keep yer amateur hands "
"off him, or you're next!"
msgstr ""
"피를 보게 하고, 입을 열게끔 하려는 거야. <i>죽이려는</i> 게 아니라. 그러니 솜씨 없는 손으로 녀석을 건드리지 마. 그렇지 "
"않으면 다음은 네 차례가 될 거야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = e4e9d164-37c6-2b9f-1244-38671c909794
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_Torturers_Failed = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:e4e9d164-37c6-2b9f-1244-38671c909794
msgctxt "h04465fcfg36bag42dcgb84eg558104c7ef5f"
msgid "Get out, then. Wastin' my time like that."
msgstr "그럼 저리 비켜. 내 시간 낭비하지 말고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = e5a6229e-afd5-0721-35bf-f6e6689a55b2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Torturers_State_KnowDen = False
#. TagRule: HUMAN
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:e5a6229e-afd5-0721-35bf-f6e6689a55b2
msgctxt "hb5928752gf0fbg41afgad4dg4174261879ce"
msgid "A human torturin' a human? HA! I'd like to see that. Go on, have at it."
msgstr "인간이 인간을 고문한다고? 하! 그거 정말 보고 싶은데. 어서, 맘껏 해봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = e5a6229e-afd5-0721-35bf-f6e6689a55b2
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Torturers_State_KnowDen = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:e5a6229e-afd5-0721-35bf-f6e6689a55b2
msgctxt "hf5f6924aga6b8g4934g95e8gf8cf42266a7c"
msgid "Bloodthirsty, ain't ya? HA. Go on then: make 'im scream."
msgstr "아주 피에 목말랐구나? 하. 어디 해봐. 비명을 지르게끔 만들라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = e5b91d14-425a-bf35-d2b2-f9fa223a676d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Torturers_HasMet_Spike(2) = False
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = False
#.      - DROWELF(2) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_Torturers_HasMet_Spike(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:e5b91d14-425a-bf35-d2b2-f9fa223a676d
msgctxt "hf6a56730g0b26g470fg8190gd4b7bacd2e7c"
msgid "Come to see yer friend, have ya? Come an' join 'im, if ya like."
msgstr "친구를 보러 왔나? 원하면 와서 그와 함께하라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = e883c12b-3aa1-7b26-111c-bfa00496dcaa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:e883c12b-3aa1-7b26-111c-bfa00496dcaa
msgctxt "h3c097c80g6e63g4150g9bffg2abfce075358"
msgid "Then shut up and watch."
msgstr "그럼 닥치고 보기나 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Narrator
#. NodeID = e8f288dc-384b-e67c-9f74-1575ea00f00f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - GLO_TadpoleIntro_NPC(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:e8f288dc-384b-e67c-9f74-1575ea00f00f
msgctxt "ha9d1df31g4e21g459ega95fge660cf5a6e15"
msgid "*As the symbol glows, power courses through you. <i>Authority</i>.*"
msgstr "*문양이 빛나며, 몸에 흐르는 힘이 느껴집니다. <i>권위</i>.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = e93ee34e-c28d-149b-8113-8043f0d8f346
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:e93ee34e-c28d-149b-8113-8043f0d8f346
msgctxt "hcb68295bgccdbg4ae3g8c84gc42c19bb4651"
msgid ""
"The man on it is a bit short though, don't you think 'e could be longer?"
msgstr "고문대에 묶인 이 녀석 키가 좀 작아 보이는데, 키를 더 늘릴 수 있을 거 같지 않아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Narrator
#. NodeID = e9cf1736-d5f7-85e8-3d34-a501fdd8c686
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:e9cf1736-d5f7-85e8-3d34-a501fdd8c686
msgctxt "h036f7251g000fg4b2dg9c07g618ebb80145e"
msgid ""
"*The mark glows, but you feel nothing in response. Your illithid power is "
"beyond reach until you rest.*"
msgstr "*문양이 빛나지만, 어떤 반응도 느껴지지 않습니다. 일리시드 능력을 더 사용하려면 휴식을 취해야 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = ec714071-db93-2f0e-d69c-aef7af5d1f04
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_DrowCommander_Event_GoTorturePrisoner = False
#.      - GOB_HappyTorturers_Assaulted = True
#.   Object:
#.      - GLO_SafeRomance_Enabled(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:ec714071-db93-2f0e-d69c-aef7af5d1f04
msgctxt "hcbdd8ca5gb39ag48a4g9557ge2a08c179380"
msgid "I wanted to join in on the fun - let me put him through his paces."
msgstr "나도 재미 좀 보고 싶었어. 내가 한번 해보지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = ef31f20e-ef5c-dc51-c9bd-cb61444d9d5b
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 0
#. CheckFlags:
#.   Local:
#.      - 50db693e-1d65-b503-8056-99bf936af658_MindHasBeenRead = False
#.   Script:
#.      - GEN_CanDetectThoughts_3 = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:ef31f20e-ef5c-dc51-c9bd-cb61444d9d5b
msgctxt "h43928139g61d9g4d20g8d58gb31581b49f5a"
msgid "<i>Read his thoughts.</i>"
msgstr "<i>그의 생각을 읽는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = f0dec248-f1f9-26ae-a791-34e8ab6730b4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3e0cc9b8-f2f1-bd11-5ff7-f347a649c9fc_MindHasBeenRead = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:f0dec248-f1f9-26ae-a791-34e8ab6730b4
msgctxt "h84c9283ag8ecag42acg8cb4gb820f7e3e921"
msgid "I'll take over - unless you want the drow to learn of your failures."
msgstr "내가 처리하지 - 드로우가 네 실패에 대해 알게 하고 싶지 않다면 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = f35358b5-8c08-f2cc-b20f-18ac91b2e0f0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_Torturers_Hostile(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:f35358b5-8c08-f2cc-b20f-18ac91b2e0f0
msgctxt "h5d8aba8eg215bg4bf8g9793g95121e7ff8a4"
msgid "<i>Attack the goblins.</i>"
msgstr "<i>고블린을 공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Narrator
#. NodeID = f6812b42-25a3-8132-f632-2d3d41bc6f6c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount4(2) = False
#.   Tag:
#.      - TRUESOUL(2) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount4(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:f6812b42-25a3-8132-f632-2d3d41bc6f6c
msgctxt "h806edf63g0426g4512g9eddg929debb319f6"
msgid ""
"*A shadow swims across your vision, and a familiar voice tells you to be "
"calm. You are loved.*"
msgstr "*그림자가 낀 듯이 눈앞이 흐려지더니, 익숙한 목소리가 당신을 달래줍니다. 사랑이 느껴집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = f89a23f3-7282-9f41-2840-d8ce2cf71fab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:f89a23f3-7282-9f41-2840-d8ce2cf71fab
msgctxt "h351cf93egd075g4095g9d49geb46221afc5e"
msgid ""
"We know all about 'is secret hideout by now, so let's see what else ya can "
"make 'im say."
msgstr "녀석 무리의 은신처 위치를 이제 전부 알고 있으니, 또 다른 무슨 얘길 꺼낼지 한 번 알아보자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = fc73f79a-d7cc-1e2f-eb4b-4cc0d2d53706
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_Torturers_Hostile(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:fc73f79a-d7cc-1e2f-eb4b-4cc0d2d53706
msgctxt "h81268910g1121g48d3gb692g3d66e5ee602f"
msgid "<i>Attack the goblins.</i>"
msgstr "<i>고블린을 공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = fcf797ab-9763-da02-f5d3-fa0695fa3505
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:fcf797ab-9763-da02-f5d3-fa0695fa3505
msgctxt "he456f9f8g18ceg4b4agaafeg0af9f373d115"
msgid ""
"I am going to do something so <i>awful </i>it would scare even <i>you </i>to "
"watch."
msgstr "아주 <i>끔찍한</i> 짓을 저지를 거라서 쳐다보기만 해도 소스라치게 놀랄지 몰라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Shadowheart
#. NodeID = fd2f905f-8b22-9511-1d41-8ee32fb28409
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#. SetFlags:
#.   Dialog:
#.     - GOB_Torturers_Knows_ShadowheartAdvice(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:fd2f905f-8b22-9511-1d41-8ee32fb28409
msgctxt "h980ef7cbgd310g4b00gb15dg291062324431"
msgid ""
"Say we'll take over. His work is sloppy; he'll kill the prisoner too quickly."
msgstr "우리가 상황을 접수한다고 해. 이 녀석은 일을 제대로 처리하질 못하니, 포로를 금방 죽여버리고 말 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = fd54296b-76cf-650a-5b8a-8db6f4b9ca7d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:fd54296b-76cf-650a-5b8a-8db6f4b9ca7d
msgctxt "hc69ca6b7gb86cg41acg9821g5fbbb0728c1c"
msgid ""
"Like 'e cares. And if 'e did, 'e wouldna sent no <i>outsider </i>to order us "
"around."
msgstr "두목이 신경이나 쓰겠어? 그리고 그렇다고 쳐도 그가 <i>외부인</i>을 보내서 명령을 전할 리 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = fdf93264-615d-92af-5147-b73c34335d68
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:fdf93264-615d-92af-5147-b73c34335d68
msgctxt "hc29bb696g3ec8g48a7gb320gae7312a57784"
msgid ""
"Beating him with a club? Really? Sloppy <i>and </i>unoriginal. Stand aside."
msgstr "고작 몽둥이로 때린다고? 정말? 엉성한데다가 뻔하기까지. 비켜봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = ff5e2ab3-864d-327b-ec56-92af503b79a6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_Torturers_Goblet_Inclusion_Start(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:ff5e2ab3-864d-327b-ec56-92af503b79a6
msgctxt "h4a3f371fge7d0g4f3cgaa8bg39ad358683ac"
msgid ""
"Heh. Maybe she'll send you back here to take his place. Then I'll show you "
"what I can do."
msgstr "헤. 어쩌면 그녀가 그의 자리를 대신하라고 널 보낼지도. 그 때가 되면 내가 뭘 할 수 있는지 네게 보여주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_VoloBallad_Guard
#. Speaker = Gribbo
#. NodeID = 9a21675c-3c48-c085-b948-393d4ee355b2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Volo_State_AtGoblinCamp = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_VoloBallad_Guard:9a21675c-3c48-c085-b948-393d4ee355b2
msgctxt "h0c8aa4efgf1c0g42f7gac66g08e78351cb28"
msgid "Shove off."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_VoloBallad_Guard
#. Speaker = Gribbo
#. NodeID = d3c93b84-b24f-28b0-806b-37a489bcd1b9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Volo_State_AtGoblinCamp = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_VoloBallad_Guard:d3c93b84-b24f-28b0-806b-37a489bcd1b9
msgctxt "h4bbad0c2g3073g4eb9g9fecg41ac3b0000ce"
msgid "Feck off!"
msgstr "꺼져!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_VoloBallad_Guard_AtCage
#. Speaker = Gribbo
#. NodeID = 01364917-dd16-d548-d4f8-7d3b75f17a74
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_VoloBallad_Guard_AtCage:01364917-dd16-d548-d4f8-7d3b75f17a74
#, fuzzy
msgctxt "h8fa715f2g3a0bg4c17g8143gd6479bf5ccf3"
msgid "Bring him back when he's all tuckered out."
msgstr "완전히 지치면 다시 데려와."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_VoloBallad_Guard_AtCage
#. Speaker = Gribbo
#. NodeID = 063807a2-e6ad-293f-4dd7-4dc03c1878db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_VoloBallad_Guard_AtCage:063807a2-e6ad-293f-4dd7-4dc03c1878db
msgctxt "h127f1fa5g5d11g4ef2g8857g12b9927f9f1d"
msgid "But, erm, how much <i>do </i>ya got?"
msgstr "그치만, 음, 그래서 얼마 있어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_VoloBallad_Guard_AtCage
#. Speaker = Gribbo
#. NodeID = 08fceeaa-6ba9-f70d-668c-d5ac14cb2cce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_VoloBallad_Guard_AtCage:08fceeaa-6ba9-f70d-668c-d5ac14cb2cce
msgctxt "ha4da3468gb16ag4cc8ga2e7gb29cd359cccb"
msgid "Nahhh."
msgstr "에이."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_VoloBallad_Guard_AtCage
#. Speaker = Player
#. NodeID = 0ba88579-f4ef-a55f-21a7-11f556f06544
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_VoloBallad_Guard_AtCage:0ba88579-f4ef-a55f-21a7-11f556f06544
msgctxt "hfc6f01b6g30b9g473agb01bg62dacc594426"
msgid "Does your bird have a name?"
msgstr "네 새한테 이름은 지어줬어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_VoloBallad_Guard_AtCage
#. Speaker = Player
#. NodeID = 0f19a756-e906-c5f7-6398-da099df3c70d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_VoloBallad_Guard_AtCage:0f19a756-e906-c5f7-6398-da099df3c70d
msgctxt "h18839495gb24dg4e85g9730g6d91f6a06443"
msgid "I'm done talking. Open the cage or you'll be sorry."
msgstr "이야기는 이만 됐어. 당장 우리를 열지 않으면 후회할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_VoloBallad_Guard_AtCage
#. Speaker = Gribbo
#. NodeID = 0f51503f-1d91-85ca-f9a4-b9890c7560fb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_VoloBallad_Guard_AtCage:0f51503f-1d91-85ca-f9a4-b9890c7560fb
msgctxt "h5c2d2534g13e0g4706g8d75gf9bdf8559e37"
msgid "What's it to ya?"
msgstr "그래서 네가 무슨 상관이야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_VoloBallad_Guard_AtCage
#. Speaker = Narrator
#. NodeID = 141bca25-2dd0-d0aa-36bf-b451d266fe8c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - GLO_TadpoleIntro_NPC(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_VoloBallad_Guard_AtCage:141bca25-2dd0-d0aa-36bf-b451d266fe8c
msgctxt "h2bdaa825gdfe2g42ebgbc22g25dbc75de5f9"
msgid "*As the symbol glows, power courses through you. <i>Authority</i>.*"
msgstr "*문양이 빛나며, 몸에 흐르는 힘이 느껴집니다. <i>권위</i>.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_VoloBallad_Guard_AtCage
#. Speaker = Player
#. NodeID = 162b9f6d-244e-229e-56d6-5b1751b7f7ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_VoloBallad_Guard_AtCage:162b9f6d-244e-229e-56d6-5b1751b7f7ae
msgctxt "h2f23a70bg84e0g4847gb85fg1dafad6379ef"
msgid ""
"<i>Offer a small fortune. </i>([GEN_CheckMagicPocketGold_4_5dac5eea-faeb-"
"459c-b675-46c51519b784])"
msgstr ""
"<i>꽤 큰 금액을 제시한다. </i>([GEN_CheckMagicPocketGold_4_5dac5eea-faeb-"
"459c-b675-46c51519b784])"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_VoloBallad_Guard_AtCage
#. Speaker = Player
#. NodeID = 19105703-9c60-0a9f-eadc-4f439bf92978
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_VoloBallad_Guard_AtCage:19105703-9c60-0a9f-eadc-4f439bf92978
msgctxt "h8b295b3cgb38cg47b6g8605g5fe697b57544"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_VoloBallad_Guard_AtCage
#. Speaker = Player
#. NodeID = 1f2d7a89-0d47-ebbd-3fb9-b74a24fd26a8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_VoloBallad_MetGuardPrison = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_VoloBallad_Guard_AtCage:1f2d7a89-0d47-ebbd-3fb9-b74a24fd26a8
msgctxt "h5a12250bgf8f5g4ac1g9f0cg99bc9c14bf66"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_VoloBallad_Guard_AtCage
#. Speaker = Gribbo
#. NodeID = 20c0a191-0a99-2d4c-0eb9-dcb1a2ef2223
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_VoloBallad_Guard_PlayerConvincedGribboTrueSoul(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_VoloBallad_Guard_AtCage:20c0a191-0a99-2d4c-0eb9-dcb1a2ef2223
msgctxt "hc2827a40gca44g4892g95b6g75928c67965e"
