msgctxt "h2adb4d59g3838g4926g83ceg6ba3a60bef77"
msgid "Mind the True Soul. They will - they - they..."
msgstr "참된 영혼을 따라라. 그... 그... 그 사람이..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Narrator
#. NodeID = c0bc0a6e-9587-9d64-fb31-b3ab4c2b2d79
