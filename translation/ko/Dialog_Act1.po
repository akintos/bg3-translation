msgctxt "hae045deegd0cfg472fga945ga884f1359691"
msgid "Hells. Not another dragon. Anything but a dragon."
msgstr "젠장. 또 드래곤이라니. 드래곤만 아니면 좋겠는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_DragonShadow
#. Speaker = Player
#. NodeID = d04835f1-4c39-d418-9dd9-748f338150a0
