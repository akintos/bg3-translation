#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarGuardSergeant_AD:9f2936ac-2bc8-a4ce-2aa3-ba9236209e43
msgctxt "h883242adgbe92g408egb536g88278d467bfc"
msgid "Nere dies, heads roll!"
msgstr "니어가 죽으면, 머리들이 굴러다닐 거야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarGuardSergeant_AD
