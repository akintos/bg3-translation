msgctxt "h411ee000g5f73g4ff1g8794ga181a994d8d1"
msgid "What-cha... this woman's some <i>booyahg</i>! She's tryna magick me!"
msgstr "뭐야... 이 여자는 <i>부야그</i>야! 나를 마법으로 조종하려고 해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_NoticedPoisoning
#. Speaker = GROUP_Act1_GOB_Festivities
#. NodeID = 92040fe1-51aa-b462-0631-bbb7fd325ad0
#. HandlePath = TaggedText[2].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_GoblinToast_PoisoningRedHanded = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_NoticedPoisoning:92040fe1-51aa-b462-0631-bbb7fd325ad0
msgctxt "h2c523fb3gb7b8g4902gaec3ge8b406aa898e"
msgid "What-cha... this'n's some <i>booyahg</i>! They're tryna magick me!"
msgstr "뭐야... 이 녀석들은 <i>부야그</i>야! 나를 마법으로 조종하려고 해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_NoticedPoisoning
#. Speaker = Narrator
#. NodeID = 9335cced-cb56-ce6e-8679-c91d6e3d74a7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount5(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount5(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_NoticedPoisoning:9335cced-cb56-ce6e-8679-c91d6e3d74a7
msgctxt "heab76467g31c3g4aaag9c9agf3fd51182c3a"
msgid ""
"*Your blood runs quicker, feeding the gnawing absence at the centre of your "
"mind.*"
msgstr "*피가 더 빨리 흐르면서, 당신의 정신 한가운데를 좀먹는 허전함을 양분으로 채웁니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_NoticedPoisoning
#. Speaker = Narrator
#. NodeID = 97be652b-f765-f66d-a6c0-48229317d41d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount4(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount4(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_NoticedPoisoning:97be652b-f765-f66d-a6c0-48229317d41d
msgctxt "hdb4744a9ge540g4466g9d62g74eb333c65ce"
msgid ""
"*A shadow swims across your vision, and a familiar voice tells you to be "
"calm. You are loved.*"
msgstr "*그림자가 낀 듯이 눈앞이 흐려지더니, 익숙한 목소리가 당신을 달래줍니다. 사랑이 느껴집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_NoticedPoisoning
#. Speaker = GROUP_Act1_GOB_Festivities
#. NodeID = 9dd37f1e-6e3f-45be-336b-4ba87085560f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_NoticedPoisoning:9dd37f1e-6e3f-45be-336b-4ba87085560f
msgctxt "h56f46f73g3f5dg4f6fgb249g14a6dacb4903"
msgid ""
"Like hells. I don't know what you're gettin' at, but answer the question. "
"What were you doin'?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_NoticedPoisoning
#. Speaker = GROUP_Act1_GOB_Festivities
#. NodeID = b6101f47-0665-f037-031c-3605e3f13f58
