msgctxt "h7b86b258gde2eg4f04g9a90gf3b599abaf0e"
msgid "Bloody doors!"
msgstr "망할 문짝 같으니!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_ShadowHeartRecruitment_AD
#. Speaker = Shadowheart
#. NodeID = 9bee6ed5-0745-a6df-4ffd-a15ac88a7953
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 35f08b91-666d-20bf-3fea-90e316dfd478_C = True
#.      - 35f08b91-666d-20bf-3fea-90e316dfd478_A = True
#.      - 35f08b91-666d-20bf-3fea-90e316dfd478_B = True
#. SetFlags:
#.   Local:
#.     - 35f08b91-666d-20bf-3fea-90e316dfd478_C = False
#.     - 35f08b91-666d-20bf-3fea-90e316dfd478_A = False
#.     - 35f08b91-666d-20bf-3fea-90e316dfd478_B = False
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_ShadowHeartRecruitment_AD:9bee6ed5-0745-a6df-4ffd-a15ac88a7953
msgctxt "h0ddc39a1ge7e3g4f8eg896bga9a8451849f2"
msgid "Why?! Why won't you just open?!"
msgstr "왜?! 어째서 그냥 좀 열리지 않냐고?!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_ShadowHeartRecruitment_PAD_Door
#. Speaker = Shadowheart
#. NodeID = 7af2534c-9217-64a9-f650-9985ae4a6df3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - TUT_TransformChamber_State_ShadowheartFreed = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_ShadowHeartRecruitment_PAD_Door:7af2534c-9217-64a9-f650-9985ae4a6df3
msgctxt "hec0acd55ge3a6g4b73g8de9g08cd90ea5171"
msgid "Won't get that open easily. Maybe there's another entrance."
msgstr "그리 쉽게 열리진 않을걸. 다른 입구가 있을지도 몰라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_ShadowHeartRecruitment_PAD_Door
#. Speaker = Shadowheart
#. NodeID = 9f8d27f5-4633-249d-1c6b-b0bee32b326f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_ShadowHeartRecruitment_PAD_Door:9f8d27f5-4633-249d-1c6b-b0bee32b326f
msgctxt "h0bdc5808ga301g4077gaf41ge55692950129"
msgid "I've tried already. Damn thing won't budge."
msgstr "내가 이미 해봤어. 이 망할 건 꼼짝도 안 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_ShadowHeartRecruitment_PAD_Return
#. Speaker = Shadowheart
#. NodeID = be9ff1cc-af4e-e70f-e53d-d1d4b82f2c5e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_ShadowHeartRecruitment_PAD_Return:be9ff1cc-af4e-e70f-e53d-d1d4b82f2c5e
msgctxt "h4d97eb11g2d65g4fd7gb1e2g4188cba7430a"
msgid "Dead goblins over there. Worth checking for supplies maybe."
msgstr "저기 고블린들이 죽어 있군. 보급품이 있을지 확인해봐도 좋겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_ShadowHeartRecruitment_VB
#. Speaker = Shadowheart
#. NodeID = bfe8cf43-2ada-fbb5-3c0c-77359c18bfd8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_ShadowHeartRecruitment_VB:bfe8cf43-2ada-fbb5-3c0c-77359c18bfd8
msgctxt "hacac6810g9349g48d8ga36cg278209c28135"
msgid "Some sort of chapel or sepulchre... but dedicated to whom?"
msgstr "일종의 예배당이나 안치소 같은데... 대체 누굴 모신 곳이지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AstarionRecruitment_Recruitment_AD
#. Speaker = Astarion
#. NodeID = 58215fc8-92e5-1ddf-2a9d-a48d89b6faa8
