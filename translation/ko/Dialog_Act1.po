msgctxt "hfdc72661g4758g4858ga43bgbf64004f6c8a"
msgid "<i>Turn to see what he's looking at.</i>"
msgstr "<i>뒤를 돌아 그가 뭘 보고 있는지 확인한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_GruntingKid
#. Speaker = Player
#. NodeID = bbd45492-66fb-5cec-ebf7-a8a9fccfd2ff
