#.     - 8000b0ab-2e5f-c22d-8f09-7878115989ea_C = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_Refugee1:4358aaf7-1512-f029-7c47-9cb5fdc05936
msgctxt "h4ba1a11dg2ca4g498cg8b70g805448424bb8"
msgid "Is that everything? I think that's everything..."
msgstr "이게 다였나? 이게 다인 거 같군..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_Refugee1
#. Speaker = Eramas
#. NodeID = 8e006016-b8aa-5cf8-a86b-9c6d978cdd61
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 8000b0ab-2e5f-c22d-8f09-7878115989ea_A = False
