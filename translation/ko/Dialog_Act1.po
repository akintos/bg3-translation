#.     - CRE_General_State_VlaakithPortrait_HistoryCheckAttempted(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait:d876ad43-f2de-119e-a42a-b12b70c9147f
msgctxt "hde25289fg2b05g4905gbea4gf238ea8347bd"
msgid "<i>Inspect the symbol more closely.</i>"
msgstr "<i>문양을 좀 더 자세히 관찰한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait
#. Speaker = Player
#. NodeID = e3315d5d-1bbf-f933-98b4-8f556916eac0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CRE_General_State_VlaakithPortrait_ExaminedFace(1) = False
#.   Tag:
#.      - REALLY_GITHYANKI(1) = True
#. SetFlags:
#.   Object:
#.     - CRE_General_State_VlaakithPortrait_ExaminedFace(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait:e3315d5d-1bbf-f933-98b4-8f556916eac0
msgctxt "h9ed8b9abg8fa4g4fd4gaba6g6d9f7a95c56b"
msgid "<i>Gaze upon Vlaakith's regal countenance.</i>"
msgstr "<i>블라키스의 위풍당당한 모습을 우러러본다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait
#. Speaker = Narrator
#. NodeID = e5107bc9-6f89-cf2c-fde1-c34eca8c0fb2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait:e5107bc9-6f89-cf2c-fde1-c34eca8c0fb2
msgctxt "h53db040fg039bg42eag81f6g249ec63b4aba"
msgid "*Just as you find your flow, you slip.*"
msgstr "*흐름을 탔다고 생각한 순간, 손이 미끄러집니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait
#. Speaker = Lae'zel
#. NodeID = fb74353a-29ac-d566-aa41-84b61b3a12fa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - Approval_AtLeast_5_For_Sp2(3) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait:fb74353a-29ac-d566-aa41-84b61b3a12fa
msgctxt "h60d7a189g410eg4ea0g8dfdg6367a5a171d2"
msgid "A wretched display. I thought you better than such juvenile antics."
msgstr "불쾌하기 짝이 없군. 널 그런 유치한 짓거리를 하는 사람으론 안 봤는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_AD_CombatDoctor_PlayerDown
#. Speaker = Ghustil Stornugoss
#. NodeID = 3ea86706-458e-5c91-8fb1-a250c811d178
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_AD_CombatDoctor_PlayerDown:3ea86706-458e-5c91-8fb1-a250c811d178
#, fuzzy
msgctxt "hda20a890gb228g4f27ga76fgf92eb44ebf5c"
msgid "Don't touch! That specimen is <i>mine</i>."
msgstr "만지지 마! 저 표본은 <i>내 거</i>야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_AD_DoctorAtAmbush
#. Speaker = Ghustil Stornugoss
#. NodeID = edd974b9-2d97-1d17-2a11-542c5059c1ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_AD_DoctorAtAmbush:edd974b9-2d97-1d17-2a11-542c5059c1ae
#, fuzzy
msgctxt "h942fdc22gbc8fg4a1eg8a1egc31cfaf758c5"
msgid "Purge the <i>infected</i> only. Leave enough to study."
msgstr "<i>감염자</i>만 제거해. 나머지는 연구를 위해 남겨 놓도록."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_AD_DoctorGoesToDevice
#. Speaker = Ghustil Stornugoss
#. NodeID = 426c196f-ff18-e75b-b58d-44fca4941f72
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_AD_DoctorGoesToDevice:426c196f-ff18-e75b-b58d-44fca4941f72
#, fuzzy
msgctxt "h66eb5da3ga0b7g4343gb8e6g7c934252913c"
msgid ""
"Even githyanki rarely experience the <i>zaith'isk</i>. You are very lucky, "
"<i>istik</i>."
msgstr "기스양키한테도 <i>제이트이스크</i>를 경험하는 건 매우 드문 일이지. 넌 아주 운이 좋군, <i>이스틱</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_AD_DoctorGoesToDevice
#. Speaker = Ghustil Stornugoss
#. NodeID = b28c65d9-f49b-ece9-8c1a-7d121631bea1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_AD_DoctorGoesToDevice:b28c65d9-f49b-ece9-8c1a-7d121631bea1
#, fuzzy
msgctxt "h78a29a82gbb40g403fgba1eg0e4ba24370da"
msgid ""
"Most of our kin never get to experience the <i>zaith'isk</i>. Vlaakith "
"smiles on you."
msgstr "대부분의 우리 동족도 <i>제이트이스크</i>를 경험해 본 적 없지. 블라키스 님이 너에게 미소 짓나 보군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_AD_DoctorReactsToExplosion
#. Speaker = Ghustil Stornugoss
#. NodeID = f399074b-7646-c8fd-eab7-e5e342a599a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_AD_DoctorReactsToExplosion:f399074b-7646-c8fd-eab7-e5e342a599a4
#, fuzzy
msgctxt "hb9ca489agc614g46b2gb290g79118cd4aba2"
msgid "The <i>zaith'isk</i>! Stay right where you are."
msgstr "<i>제이트이스크</i>가! 거기 그대로 있어."

