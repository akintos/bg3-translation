msgctxt "h92548de2ga141g44d1g9f92g549b68721d95"
msgid "Since when has yielding been an option? Gut the little rodent."
msgstr "언제부터 항복을 받아준다고 했어? 저 벌레 자식의 내장을 꺼내버려."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_FistFight
#. Speaker = Player
#. NodeID = 16ca29ed-0b40-2aab-a298-4b606cac22f6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_DrunkGoblin_Event_Spared(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_FistFight:16ca29ed-0b40-2aab-a298-4b606cac22f6
msgctxt "hd32177b6g160fg4cb6g9c84g8de404f6ddd4"
msgid "<i>Leave him grovelling on the ground.</i>"
msgstr "<i>땅바닥에 굽신거리는 채로 둔다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_FistFight
#. Speaker = Lae'zel
#. NodeID = 18058462-81bb-6d45-ecbb-b0028e1fd24a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(2) = True
