msgctxt "h3892fffbge097g4ee2gb721gf7370bde9fde"
msgid "You'd get sick if you ate me. I carry a strange curse."
msgstr "날 먹으면 병 걸릴 텐데. 난 이상한 저주를 옮기거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders
#. Speaker = Player
#. NodeID = c2d95c4e-dad6-98a0-a476-31e13b76ff56
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders:c2d95c4e-dad6-98a0-a476-31e13b76ff56
msgctxt "hf784fadfgb2acg4f45g946bg711a6c88de18"
msgid "Kill the goblins."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders
#. Speaker = Narrator
#. NodeID = c2e6ecd1-17a3-1b47-df06-46456b83f9c3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_SpiderNest_State_DoorOpen = True
#. SetFlags:
