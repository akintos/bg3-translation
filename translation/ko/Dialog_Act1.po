msgctxt "he5c9dc21g9495g4fddg9152g4c742ebd1db6"
msgid "((*leave this one. come to me. we must speak*))"
msgstr "((*이 자는 놔둬라. 내게 오거라. 우리는 대화해야 한다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 009762a8-5c97-94c7-ed3a-30992abe394d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_MyconidCircle_DwarvenAlchemist_BaelenReturned_Hasmet(1) = False
#.   Global:
#.      - UND_MushroomHunter_Event_AteMushroom = False
#.      - UND_MushroomHunter_State_InVillage = True
#. SetFlags:
#.   Dialog:
#.     - UND_MyconidCircle_DwarvenAlchemist_BaelenReturned_Hasmet(1) = True
#.   Quest:
#.     - UND_MushroomHunter.ReportedToDerryth_BaelenIsAlive(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:009762a8-5c97-94c7-ed3a-30992abe394d
msgctxt "h265cc544g4504g435bgb51bg34d519db2067"
msgid "Look at that. Got my useless old man back."
msgstr "저것 봐라. 내 쓸모 없는 남편이 돌아왔군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = 01ed0a26-4282-d82e-5556-e9b652a8f1c9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:01ed0a26-4282-d82e-5556-e9b652a8f1c9
msgctxt "h08690d3cg787bg4d41g9c90g453a1bef1155"
msgid "Using nature's gifts to fatten your purse is unseemly."
msgstr "자연의 선물로 네 지갑을 채우는 건 부적절해 보이는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = 0299b98a-9b2f-b4df-1086-36b9667993fd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_OfferedToFindBaelen = False
#. SetFlags:
#.   Local:
#.     - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_OfferedToFindBaelen = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:0299b98a-9b2f-b4df-1086-36b9667993fd
msgctxt "hcdaab952gc49fg42beg970eg92003d79c0e8"
msgid "I could look for him - for a price."
msgstr "값만 제대로 쳐 준다면, 그를 찾아볼 수도 있습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 03138557-6112-59c8-63cd-0ca31ecaa8ee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:03138557-6112-59c8-63cd-0ca31ecaa8ee
msgctxt "h36114fc4gf77cg45efgafaeg67c70528b198"
msgid "Give it or don't."
msgstr "주든지, 말든지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 03772804-aad4-2985-9663-44380048c1d2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:03772804-aad4-2985-9663-44380048c1d2
msgctxt "h67d351a5ge2a6g4386g9ac3g752ee353740b"
msgid "I should've killed him myself."
msgstr "내 손으로 그를 죽여버렸어야 하는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 04f8d574-4019-a1b7-bbdd-679a04214841
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:04f8d574-4019-a1b7-bbdd-679a04214841
msgctxt "h4dbde5d9gdd8fg43fbg8410g20e07923104e"
msgid "<i>Don't touch me.</i>"
msgstr "<i>날 만지지 마.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 06c3f93c-95d6-61b9-9b99-1c652549c348
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - UND_MushroomHunter.LearnedBaelenInfo(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:06c3f93c-95d6-61b9-9b99-1c652549c348
msgctxt "hf1e2776egb29cg434ag87c8gc77e9327fd57"
msgid "Bald. Blue tunic. Dumb as a stick."
msgstr "대머리에 파란 튜닉을 입은 멍청한 인간이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = 0a3fdd7f-4bde-7795-7bc7-20fea9b42610
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_DwarvenAlchemist_Knows_LossOfMemory = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:0a3fdd7f-4bde-7795-7bc7-20fea9b42610
msgctxt "hfbd35756gf401g4417gbd41g3bebdd40b425"
msgid "No love lost between the two of you, I gather."
msgstr "당신 둘 사이의 사랑은 식지 않은 듯하군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 0a9544b0-10f1-fce5-f9ca-89d0eb79e46b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_MyconidCircle_DwarvenAlchemist_Event_RefusedHerNoblestalk(1) = True
#.      - UND_MyconidCircle_DwarvenAlchemist_Event_CheatedDerryth(1) = False
#.   Global:
#.      - UND_DwarvenAlchemist_State_AlchemistGotNoblestalk = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:0a9544b0-10f1-fce5-f9ca-89d0eb79e46b
msgctxt "ha76766efgcc40g4addg864cg982a0458707f"
msgid "No point in lingering. Not after <i>you </i>swiped what we came for."
msgstr "<i>네</i>가 우리가 여기 온 이유를 슬쩍했으니, 여기서 뭉그적거릴 이유가 없지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = 113cae4f-2840-d0b8-e8f6-db5d8ea1f51e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_AskedForPayment = False
#. SetFlags:
#.   Local:
#.     - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_AskedForPayment = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:113cae4f-2840-d0b8-e8f6-db5d8ea1f51e
msgctxt "h2c50d1d0gcd21g4643gbc9cg8ba5d1476e59"
msgid "Sounds like you'll be willing to pay me for it then."
msgstr "그렇다면 그걸 위해서 제게 돈을 지불할 용의도 있을 것 같군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 1171c1d6-8821-40a7-6ee6-8c8d39f4d56e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:1171c1d6-8821-40a7-6ee6-8c8d39f4d56e
msgctxt "h2ce235a4g18a0g4c1cgacd2g939fab31f5f6"
msgid "Knock yourself out. But don't come begging for coin if you find him."
msgstr "마음대로 해. 하지만 그를 찾더라도 동전을 구걸하러 오지는 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = 142f7dde-bb14-57ab-1212-e7ad9a776aa9
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Local:
#.      - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_AskedForPayment = True
#.   Tag:
#.      - BARBARIAN(1) = False
#. SetFlags:
#.   Local:
#.     - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_EvilTagPersuade = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:142f7dde-bb14-57ab-1212-e7ad9a776aa9
msgctxt "h9eb2ba7agdfb9g4e69g8e6dg99c4f5be561d"
msgid ""
"Not good enough. Give me something, or I'll toss <i>you </i>into a chasm."
msgstr "그걸론 안 되겠는데요. 제게 뭘 내놓던가, <i>당신을 </i>낭떠러지로 던져드리죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = 14e1d718-1c47-8f4c-c8ab-f69458359be7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_MyconidCircle_DwarvenAlchemist_knows_BaelenHusband(1) = False
#. SetFlags:
#.   Dialog:
#.     - UND_MyconidCircle_DwarvenAlchemist_knows_BaelenHusband(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:14e1d718-1c47-8f4c-c8ab-f69458359be7
msgctxt "hc2f74c84g5a23g4806g8ce5ge828569600b3"
msgid "Who is he to you?"
msgstr "그와는 어떤 사이입니까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = 159d1f7d-d2d0-dba7-33f9-6a9f6c4f9a56
