msgctxt "h55dec48ag6c79g4381gbd23gea0f91b43500"
msgid "Circles and the celestial. It's the seal from that journal."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/VBs/GOB_TempleAccess_PuzzleApproach_ReadInstructions_VB
