msgid "<b><i>BREAK FREE.</i></b>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chains
#. Speaker = Narrator
#. NodeID = ba767a11-ad97-9206-7afd-96a28c2a0119
