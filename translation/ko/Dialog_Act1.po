msgctxt "h2fa95b29g5e1eg42dcgbd38gbc5eaf58258b"
msgid "Not sure what the other mushrooms are."
msgstr "다른 버섯들이 뭔지는 모르겠는걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_PanicRoom_HiddenGnome_AD_Trespassing
#. Speaker = Philomeen
#. NodeID = ec4f7a2c-0470-4888-94cc-86f6be27cd71
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_PanicRoom_HiddenGnome_AD_Trespassing:ec4f7a2c-0470-4888-94cc-86f6be27cd71
msgctxt "h58f97c92g83ebg48a5g93e0gc96ab5d3baf4"
msgid "You <i>drugnin' </i>sneak. It is <i>over!</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_Signpost_AD
#. Speaker = Narrator
#. NodeID = 2d39f57f-8e7d-4090-0f8a-e687763eec3c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_Signpost_AD:2d39f57f-8e7d-4090-0f8a-e687763eec3c
msgctxt "h3ae45df2g49eag47a9gbf27g4dbb2f34b20f"
msgid ""
"*The names of settlements are crossed out: Breachstone - sinkhole! Ssalsen - "
"Lolth! Old Kell - demons!*"
msgstr "*정착지들의 이름에 줄이 그어져 있습니다: 브리치스톤 - 싱크홀! 살센 - 롤스! 올드 켈 - 데몬!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SocietyOfBrilliance_MindFlayer_AD_AfterSummonedAgain
#. Speaker = Blurg
#. NodeID = 97970be4-ddc9-3fbe-2078-cb464520283a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SocietyOfBrilliance_MindFlayer_AD_AfterSummonedAgain:97970be4-ddc9-3fbe-2078-cb464520283a
msgctxt "h7e84c36egb6f2g44a9gb7e3g4553c639d5f7"
msgid "Not I, but our guests. Let's indulge their curiosity."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SocietyOfBrilliance_MindFlayer_AD_AfterSummonedAgain
#. Speaker = Omeluum
#. NodeID = be7eb1a7-8f48-43f8-8dc0-cd6b2fa7434b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SocietyOfBrilliance_MindFlayer_AD_AfterSummonedAgain:be7eb1a7-8f48-43f8-8dc0-cd6b2fa7434b
msgctxt "h03561b93g2177g401eg9be0ge9884f3cfd75"
msgid "<i>Ah, Blurg. Are you in need of my expertise?</i>"
msgstr "<i>아, 블러그. 나의 전문적 견해가 필요한 겐가?</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SocietyOfBrilliance_MindFlayer_AD_CombatStart
#. Speaker = Omeluum
#. NodeID = 173a5f4a-ee44-e6ee-315c-b7b7db03be61
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SocietyOfBrilliance_MindFlayer_AD_CombatStart:173a5f4a-ee44-e6ee-315c-b7b7db03be61
msgctxt "h398e0c10g89aeg4df1gb31eg1ae8e90c6d71"
msgid "<i>This violence serves no end!</i>"
msgstr "<i>이런 폭력은 어떤 이득도 없습니다!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SocietyOfBrilliance_Scholar_AD
#. Speaker = Omeluum
#. NodeID = 0518bf3f-143b-952d-7e51-3c692869cec0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SocietyOfBrilliance_Scholar_AD:0518bf3f-143b-952d-7e51-3c692869cec0
msgctxt "h91c120e8g1433g4911ga4aag148474c6f080"
msgid "<i>Hm. It simply shouldn't be possible.</i>"
msgstr "<i>흠. 도저히 불가능한 일인데.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SocietyOfBrilliance_Scholar_AD
#. Speaker = Omeluum
#. NodeID = 06d30da1-8a52-bf7d-eae2-0733e8d90d73
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_SocietyOfBrilliance_State_MindFlayerPresent = True
#.      - UND_SocietyOfBrilliance_MindFlayer_State_ConnectionPerformed = True
#.   Local:
#.      - 90e5f6ec-dc15-7015-6ecd-0ad72beb9098_A = False
#.      - 90e5f6ec-dc15-7015-6ecd-0ad72beb9098_B = False
#. SetFlags:
#.   Local:
#.     - 90e5f6ec-dc15-7015-6ecd-0ad72beb9098_A = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SocietyOfBrilliance_Scholar_AD:06d30da1-8a52-bf7d-eae2-0733e8d90d73
msgctxt "h13081445g0f4cg4869g89d3g3eb81693c019"
msgid ""
"<i>I have never seen anything like it, Blurg. Is my species evolving?</i>"
msgstr "<i>이런 현상은 본 적이 없네, 블러그. 내 종족이 진화라도 하는 건가?</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SocietyOfBrilliance_Scholar_AD
#. Speaker = Omeluum
#. NodeID = 076af28d-0685-c653-05d2-33802729d9cd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_SocietyOfBrilliance_MindFlayer_State_ConnectionRefused = True
#.      - UND_SocietyOfBrilliance_State_MindFlayerPresent = True
#.      - UND_SocietyOfBrilliance_MindFlayer_State_ConnectionPerformed = False
#.   Local:
#.      - 90e5f6ec-dc15-7015-6ecd-0ad72beb9098_A = False
#.      - 90e5f6ec-dc15-7015-6ecd-0ad72beb9098_B = False
#. SetFlags:
#.   Local:
#.     - 90e5f6ec-dc15-7015-6ecd-0ad72beb9098_A = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SocietyOfBrilliance_Scholar_AD:076af28d-0685-c653-05d2-33802729d9cd
msgctxt "hf0da6ce6g68c7g415dgb465g6781970ca204"
msgid "<i>Are you sure it was an illithid larva, Blurg?</i>"
msgstr "<i>일리시드 유충이었던 게 확실한가, 블러그?</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SocietyOfBrilliance_Scholar_AD
#. Speaker = Blurg
#. NodeID = 1d1fec7a-2755-a152-dfdc-368a0f8eb9ec
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_SocietyOfBrilliance_State_MindFlayerPresent = False
#.   Local:
#.      - 90e5f6ec-dc15-7015-6ecd-0ad72beb9098_BanterSwitchB = True
#.      - 90e5f6ec-dc15-7015-6ecd-0ad72beb9098_BanterSwitchA = True
#. SetFlags:
#.   Local:
#.     - 90e5f6ec-dc15-7015-6ecd-0ad72beb9098_BanterSwitchB = False
#.     - 90e5f6ec-dc15-7015-6ecd-0ad72beb9098_BanterSwitchA = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SocietyOfBrilliance_Scholar_AD:1d1fec7a-2755-a152-dfdc-368a0f8eb9ec
msgctxt "h0270e25dgcf8cg4792g9c1ega3b97ea59653"
msgid "*Cough.* Perhaps Omeluum is right. I should get a mask."
msgstr "*기침* 어쩌면 오멜룸 말이 맞을 수도. 가면이라도 써야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SocietyOfBrilliance_Scholar_AD
#. Speaker = Omeluum
#. NodeID = 22062d34-eaa7-2ae2-3955-101f83fe8756
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SocietyOfBrilliance_Scholar_AD:22062d34-eaa7-2ae2-3955-101f83fe8756
msgctxt "h77ec23fcg4023g4538gacddg48d60f54357d"
msgid "<i>Yes. She is cataloguing kuo-toan fertility rituals.</i>"
msgstr "<i>그렇네. 그녀는 쿠오-토아의 교미 의식을 기록하고 있네.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SocietyOfBrilliance_Scholar_AD
#. Speaker = Omeluum
#. NodeID = 3c715c43-42d8-9947-421b-5f59220d2232
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SocietyOfBrilliance_Scholar_AD:3c715c43-42d8-9947-421b-5f59220d2232
msgctxt "h3b168bc4g6414g40b8g9404g4f1260b953a9"
msgid ""
"<i>Not well. The nutrition my species receives from other minds is difficult "
"to emulate.</i>"
msgstr "<i>상황이 좋진 않네. 내 종족이 다른 이들의 정신으로부터 얻는 양분을 모방하기가 쉽지 않아.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SocietyOfBrilliance_Scholar_AD
#. Speaker = Blurg
#. NodeID = 7b6c580e-95a0-cb78-85fd-2b1be7023e8f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SocietyOfBrilliance_Scholar_AD:7b6c580e-95a0-cb78-85fd-2b1be7023e8f
msgctxt "h93d233c3g3e34g47ffgb317gee77ad1aef12"
msgid "Perhaps. But at such an accelerated rate?"
msgstr "그럴지도 몰라. 하지만 이렇게 빠른 속도로 변하는 게 가능한가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SocietyOfBrilliance_Scholar_AD
#. Speaker = Omeluum
#. NodeID = 89896ebe-1cd3-a5a8-38e3-6b63496dbc59
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SocietyOfBrilliance_Scholar_AD:89896ebe-1cd3-a5a8-38e3-6b63496dbc59
msgctxt "hba2bf829ge08dg431agbf45gac915a192940"
msgid "<i>True. If only I could see into their mind...</i>"
msgstr "<i>맞는 말이네. 내가 그들의 정신을 들여다볼 수만 있다면...</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SocietyOfBrilliance_Scholar_AD
#. Speaker = Blurg
#. NodeID = 8c0c01b5-967a-c360-d040-14c96c97a1da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SocietyOfBrilliance_Scholar_AD:8c0c01b5-967a-c360-d040-14c96c97a1da
msgctxt "h9786f92cg8b1ag4910g8addg98bcc9fa3ca8"
msgid "I'm not sure what reason there would be to lie."
msgstr "거짓말을 할 이유가 뭐가 있는지 잘 모르겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SocietyOfBrilliance_Scholar_AD
#. Speaker = Blurg
#. NodeID = b232623e-30bc-3616-7b51-42e65e78a9c0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_SocietyOfBrilliance_State_MindFlayerPresent = False
#.   Local:
#.      - 90e5f6ec-dc15-7015-6ecd-0ad72beb9098_BanterSwitchB = False
#.      - 90e5f6ec-dc15-7015-6ecd-0ad72beb9098_BanterSwitchA = False
#. SetFlags:
#.   Local:
#.     - 90e5f6ec-dc15-7015-6ecd-0ad72beb9098_BanterSwitchA = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SocietyOfBrilliance_Scholar_AD:b232623e-30bc-3616-7b51-42e65e78a9c0
msgctxt "h0b163830g734fg44bfg91f3gb0819c80f096"
msgid "So many minds connected... What could they accomplish?"
msgstr "그리도 많은 정신이 연결되었다니... 어떤 것들을 해낼 수 있을까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SocietyOfBrilliance_Scholar_AD
#. Speaker = Blurg
#. NodeID = c4f65b37-9328-6a89-4d8a-a401c3328a25
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_SocietyOfBrilliance_State_MindFlayerPresent = False
#.   Local:
#.      - 90e5f6ec-dc15-7015-6ecd-0ad72beb9098_BanterSwitchB = False
#.      - 90e5f6ec-dc15-7015-6ecd-0ad72beb9098_BanterSwitchA = True
#. SetFlags:
#.   Local:
#.     - 90e5f6ec-dc15-7015-6ecd-0ad72beb9098_BanterSwitchB = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SocietyOfBrilliance_Scholar_AD:c4f65b37-9328-6a89-4d8a-a401c3328a25
msgctxt "h22fbea4age1c9g4f75ga382gd13e591dd956"
msgid "Hm. Ripplebark could sustain an entire village if seeded properly."
msgstr "흠. 파도껍질을 잘 심기만 한다면 온 마을을 수용할 수 있겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SocietyOfBrilliance_Scholar_AD
#. Speaker = Blurg
#. NodeID = c598f616-ff21-9bae-7df0-d1105f6264c2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 90e5f6ec-dc15-7015-6ecd-0ad72beb9098_A = True
#.      - 90e5f6ec-dc15-7015-6ecd-0ad72beb9098_B = False
#. SetFlags:
#.   Local:
#.     - 90e5f6ec-dc15-7015-6ecd-0ad72beb9098_B = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SocietyOfBrilliance_Scholar_AD:c598f616-ff21-9bae-7df0-d1105f6264c2
msgctxt "hd4bf01d2g35cfg479eg8863g3b9c49b16d8b"
msgid "How is your more... personal research progressing?"
msgstr "자네의 음... 개인적인 연구는 어떻게 되어가고 있나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SocietyOfBrilliance_Scholar_AD
#. Speaker = Blurg
#. NodeID = e7098cc3-0fc2-2329-31ca-a8ff1a2e4fca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SocietyOfBrilliance_Scholar_AD:e7098cc3-0fc2-2329-31ca-a8ff1a2e4fca
msgctxt "hccbc9b8dg6481g4610g84b0ge19101286841"
msgid "Worry not, friend. You'll find the key soon enough."
msgstr "걱정하지 말게나, 친구. 곧 답을 찾을 수 있을걸세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SocietyOfBrilliance_Scholar_AD
#. Speaker = Blurg
#. NodeID = fe1d4be2-8be0-6cf4-5949-db82d601df16
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 90e5f6ec-dc15-7015-6ecd-0ad72beb9098_A = True
#.      - 90e5f6ec-dc15-7015-6ecd-0ad72beb9098_B = True
#. SetFlags:
#.   Local:
#.     - 90e5f6ec-dc15-7015-6ecd-0ad72beb9098_A = False
#.     - 90e5f6ec-dc15-7015-6ecd-0ad72beb9098_B = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SocietyOfBrilliance_Scholar_AD:fe1d4be2-8be0-6cf4-5949-db82d601df16
msgctxt "h13bf4125gfa56g4a92g88b6g60132ef0b13f"
msgid "Have you spoken with Skriss lately?"
msgstr "최근에 스크리스와 대화를 나누어 본 적이 있나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SocietyOfBrilliance_Scholar_AD
#. Speaker = Blurg
#. NodeID = fe901d84-5140-da56-d717-74277bc1f452
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SocietyOfBrilliance_Scholar_AD:fe901d84-5140-da56-d717-74277bc1f452
msgctxt "he1877f4agf7e9g4040gaf64g5ef946a9d370"
msgid "Oh? Perhaps after I finish my research here, I'll join her..."
msgstr "오? 이곳에서의 연구를 끝마치고 나면, 그녀와 함께하는 것도 괜찮겠군..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SocietyOfBrilliance_Scholar_AD_CombatStart
#. Speaker = Blurg
#. NodeID = 2db4f464-23a0-a5ab-3a64-97dc765c8634
#. HandlePath = TaggedText[0].TagText[0]
