msgctxt "h77892844g7485g4b70ga045g543baf541830"
msgid "Drop your weapons!"
msgstr "무기를 버려라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_DragonEvent
#. Speaker = Sarth Baretha
#. NodeID = 8d9a4cd0-8b09-f549-f801-d29f5ec72446
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_DragonEvent:8d9a4cd0-8b09-f549-f801-d29f5ec72446
msgctxt "h5105cd02gdf69g49f2ga78eg079184fce036"
msgid "Of course, <i>kith'rak</i>. We merely sought to -"
msgstr "물론입니다, <i>키스‘락</i>. 저희는 그저..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_DragonEvent
#. Speaker = Sarth Baretha
#. NodeID = b62fad8e-1deb-2b33-6caf-c42eee30b3db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_DragonEvent:b62fad8e-1deb-2b33-6caf-c42eee30b3db
msgctxt "h39c5faa2g925dg4db5g96a8gfd23bd3257b3"
msgid "I'll feed your innards to the ants before I do that, <i>istik</i>."
msgstr "그러기 전에 네 내장을 개미 먹이로 주도록 하지, <i>이스틱</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_DragonEvent
#. Speaker = Sarth Baretha
#. NodeID = d8e8f88e-5faf-78b9-dd0c-e6aa5043d576
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_GithChokepoint_DragonAppear = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_DragonEvent:d8e8f88e-5faf-78b9-dd0c-e6aa5043d576
msgctxt "h32066726g5ff3g4d55gb133g84d46302044e"
msgid "No, look up. That was your last chance, <i>istik</i>. Now burn!"
msgstr "아니, 위를 봐라. 그건 너희의 마지막 기회였다, <i>이스틱</i>. 이제 불타라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_DragonEvent
#. Speaker = Gauntlet Dion
#. NodeID = e1746171-18b2-00ca-84a2-3f36cd4b8a96
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_DragonEvent:e1746171-18b2-00ca-84a2-3f36cd4b8a96
msgctxt "hf26815eegae3cg4e38ga99eg444e68a4d555"
msgid "This is y-your last chance!"
msgstr "마... 마지막 경고다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_DragonEvent
#. Speaker = Kith'rak Voss
#. NodeID = e1c9e456-4bd9-9439-bcab-251471051cc8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_DragonEvent:e1c9e456-4bd9-9439-bcab-251471051cc8
msgctxt "hd09c7b57g29a5g48e2gafd3gedfcdd37a9fd"
msgid "No excuses. Question, kill, then move on. Find the weapon."
msgstr "변명은 받지 않겠다. 질문하고, 죽이고, 움직여라. 무기를 찾아야 한다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_DragonEvent
#. Speaker = Gauntlet Dion
#. NodeID = e8709b46-5476-aa8a-2cfb-b25adedd6d6e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_GithChokepoint_Event_FeatherfallPosition = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_DragonEvent:e8709b46-5476-aa8a-2cfb-b25adedd6d6e
msgctxt "h1722d36dg6601g49aagbe9bg7958944039d9"
msgid "Drop your weapons!"
msgstr "무기를 버려라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_DragonShadow
#. Speaker = Player
#. NodeID = 057d234d-ccee-7838-aaec-109f3b683595
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - PLA_GithChokepoint_State_FailedFrightenedSV(0) = True
#.   Tag:
#.      - REALLY_LAEZEL(0) = False
