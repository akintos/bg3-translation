msgctxt "hf9c70dd4gcae5g4524g9100g641ec4d15353"
msgid "Fools. Little surprise they perished."
msgstr "바보들. 죽어버리다니 놀랍지도 않군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_HagAmush_PAD_FoundBrothersAfterLongRest
