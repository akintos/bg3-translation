#.      - ffb3cc3a-7e4b-eb7a-40a8-c6fab4614885_SaidName = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead:283d4b39-e92b-4fb0-a0a9-1456845ebbb5
msgctxt "hfe6f2509gd080g4d93g8464g496600a59ebd"
msgid "Where can I find the gith crèche?"
msgstr "기스의 양성소는 어디서 찾을 수 있지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead
#. Speaker = Player
#. NodeID = 2de1a4fb-6ce8-69cf-d022-5cab8a97030b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - ffb3cc3a-7e4b-eb7a-40a8-c6fab4614885_SaidCity = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead:2de1a4fb-6ce8-69cf-d022-5cab8a97030b
msgctxt "h4eb38cd9gdb7eg4eedg8d97gc13361c1e3c6"
msgid "Did you find the way to Baldur's Gate?"
msgstr "발더스 게이트로 향하는 길을 찾았나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead
#. Speaker = Narrator
#. NodeID = 42e7b115-065d-1fde-4ff3-eafc9e5783af
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead:42e7b115-065d-1fde-4ff3-eafc9e5783af
msgctxt "h3b6597aag2746g49d5gad7fg96e53d3d4150"
msgid ""
"*To the tiefling scout, gith are monsters. To you, they are a sign: you are "
"nearing the crèche.*"
msgstr "*티플링 정찰병에게 있어서, 기스는 괴물이나 다름없습니다. 하지만 당신에게는, 양성소가 근처에 있다는 신호입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead
#. Speaker = Player
#. NodeID = 5051aaaa-9cbb-2dbb-aeab-59b00e61e73a
