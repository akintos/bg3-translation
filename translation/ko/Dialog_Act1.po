msgctxt "hf42ee390g44d1g4f88gbd46gdca3b78bd93e"
msgid "<b>THINK YOU CAN BEST ME?</b>"
msgstr "<b>날 이길 수 있을 것 같아?</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap
#. Speaker = Player
#. NodeID = a68cd0bc-5e6b-2d9e-858e-e94ff2e42d0a
