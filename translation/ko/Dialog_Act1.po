msgctxt "h42452913g42a7g4708gb3fdg02524f583542"
msgid "What in Ilmater's broken bones are <i>you</i> doing here?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim_AD_PerceptionSucceeded
#. Speaker = Player
#. NodeID = 34a8f8e8-9b8d-eb1f-89d0-f3694375e073
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_EscapingZhentarim_Event_Spotted = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim_AD_PerceptionSucceeded:34a8f8e8-9b8d-eb1f-89d0-f3694375e073
msgctxt "h2e6b147dg17f8g4c53g85c7gbf4ac4f3c37d"
msgid "What was... hm. Never mind."
msgstr "방금 그건... 음. 신경 쓰지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim_AD_PerceptionSucceeded
#. Speaker = Player
#. NodeID = 65d6c696-ccaf-0bf3-d5ba-cbb10719c539
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_EscapingZhentarim_Event_Spotted = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim_AD_PerceptionSucceeded:65d6c696-ccaf-0bf3-d5ba-cbb10719c539
msgctxt "h76cce51fg3584g41c0g9e93gb43f95767c96"
msgid "Someone's moving around in there."
msgstr "안쪽에 움직임이 보이는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim_AD_PerceptionSucceeded
#. Speaker = Player
#. NodeID = e17bd2c2-999e-962e-8130-4ef8ae020133
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Quest:
#.      - PLA_ZhentShipment.GotPassword(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim_AD_PerceptionSucceeded:e17bd2c2-999e-962e-8130-4ef8ae020133
msgctxt "h99781c9bg952bg42acg9a93g4cbe89eae39a"
msgid "This is the spot Rugan marked. Doesn't look like much."
msgstr "여기가 루간이 표시해준 지점이군. 딱히 뭐가 있어 보이진 않는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim_Permitted
#. Speaker = Salazon
#. NodeID = 37443763-0179-6964-6bab-136ed76f3ca8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_ZhentDungeon_Zhent01_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim_Permitted:37443763-0179-6964-6bab-136ed76f3ca8
msgctxt "hba2e9e5fga4a6g4d3fg9b22gc2a19fa9c97c"
msgid "Said you could pass, didn't I?"
msgstr "지나가도 된다고 하지 않았나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim_Permitted
#. Speaker = Salazon
#. NodeID = 3e73ffbf-2ca5-53fc-2045-36e12a6199bd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_ZhentDungeon_Zhent01_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - PLA_ZhentDungeon_Zhent01_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim_Permitted:3e73ffbf-2ca5-53fc-2045-36e12a6199bd
msgctxt "h10c15dfcg4c60g4406gb8a8g64971af60f63"
msgid "Said your friend could pass - goes for you too."
msgstr "네 친구는 지나가도 된다고 말했는데. 너도 마찬가지고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist1
#. Speaker = Gauntlet Yeva
#. NodeID = 41f2e736-d1a5-bff6-2634-0852f5d7c519
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist1:41f2e736-d1a5-bff6-2634-0852f5d7c519
msgctxt "h89644806gc0d8g4d97gbe9bg919f2d7f5c29"
