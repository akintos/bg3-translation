msgctxt "hf1a00adag5cccg40d7g8934g36dd018e02ba"
msgid "Who are you?"
msgstr "너는 누구지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithCaptain_Dead
#. Speaker = Sarth Baretha
#. NodeID = dd9302fa-5a3a-352b-e393-90d1fe16c743
