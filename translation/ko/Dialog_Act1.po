msgctxt "h3d50464fgcb38g49b2gb644g26335e1e558a"
msgid "Yeeearghh! You broke my thumb! Why?!"
msgstr "끄아아아악! 제 엄지를 부러뜨렸잖아요! 어째서?!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
