msgctxt "hdf7aaa66g7e91g49cfg8f51g3bc68c9f0849"
msgid "That old woman was certainly memorable."
msgstr "저 노파는 확실히 기억이 나는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader_VB_HagLeaves
#. Speaker = Player
#. NodeID = bf294468-e547-8f9a-0d76-4c493c99f8f9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader_VB_HagLeaves:bf294468-e547-8f9a-0d76-4c493c99f8f9
msgctxt "hcf6370d7g62e7g4294ga1d9gd087cb775526"
msgid "That's putting it mildly."
msgstr "이것도 좋게 표현한 거지."

