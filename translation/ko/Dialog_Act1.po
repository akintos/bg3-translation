msgctxt "h9342945dg6533g458bgabd9g02f26720e8c6"
msgid "<i>Ah! </i>Sharper than Malar's fangs, these thorns! \n"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_SwampExploration_PAD_PrickedFinger
#. Speaker = Player
#. NodeID = efb82b54-7591-ee2c-72fd-591b9e7e7bc5
