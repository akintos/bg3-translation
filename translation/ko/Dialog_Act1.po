msgctxt "hcaa10527g747eg4097gabe4gf8066ad55d3c"
msgid "Came back to watch, huh?"
msgstr "다시 구경하러 왔어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = 5f63b63d-192a-46be-be17-ee9448d3e600
#. HandlePath = TaggedText[0].TagText[0]
