#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_AD_ViciousMockery:f43a3a7f-57ab-7123-7a45-81d2acbee518
msgctxt "h0b1bcc77gcf9fg4ea2g848cg6c4e35d3692f"
msgid "Try laughing after I rip your throat out, gnome."
msgstr "내가 네 목을 찢어발긴 뒤에도 웃어보려무나, 노움아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_AD_ViciousMockery
#. Speaker = Auntie Ethel
#. NodeID = f5ae3f99-f091-daa7-cbf6-1da31a55e458
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3d850796-62b9-081e-45e7-a4bfd2041faf_B = False
#.      - 3d850796-62b9-081e-45e7-a4bfd2041faf_A = False
