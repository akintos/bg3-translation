msgctxt "h3956598bgbe94g4e7fg9ff8g66d2ca2e7b71"
msgid ""
"<i>Chk.</i> The Inquisitor better not hear of this. Report to the infirmary."
msgstr "<i>츠크.</i> 심문관 귀에는 들어가지 않는 편이 좋겠군. 의무실에 보고해라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Gish Far'aag
#. NodeID = f3760a2a-1463-7170-389c-5400f8e167f6
