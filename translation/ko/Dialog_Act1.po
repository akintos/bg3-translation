#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HiddenStash_PAD:c193be45-f5c5-4a40-8c7b-4cd123c5444f
msgctxt "h8d53d2c0g0253g4082gbe15g345c41e97ce3"
msgid "A loose stone. Perhaps a secret about to be unhidden."
msgstr "느슨한 돌이군. 비밀을 숨기고 있을지도 몰라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HiddenStash_PAD
#. Speaker = Player
#. NodeID = c193be45-f5c5-4a40-8c7b-4cd123c5444f
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_HiddenStash_PerceptionPassed = True
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HiddenStash_PAD:c193be45-f5c5-4a40-8c7b-4cd123c5444f
msgctxt "hfc7d5763g5af9g4b04ga75fgac920674f9f0"
msgid "Loose stone - let's look."
msgstr "헐거운 돌인데 - 살펴보자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HiddenStash_PAD
#. Speaker = Player
#. NodeID = c193be45-f5c5-4a40-8c7b-4cd123c5444f
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_HiddenStash_PerceptionPassed = True
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HiddenStash_PAD:c193be45-f5c5-4a40-8c7b-4cd123c5444f
msgctxt "h908aad44g1378g4afeg88deg6a90b35dfc1f"
msgid "A loose stone? Someone's secret stash has been found out."
msgstr "느슨한 돌이군? 누군가의 비밀 보관함을 찾은 것 같네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HiddenStash_PAD
#. Speaker = Player
#. NodeID = c193be45-f5c5-4a40-8c7b-4cd123c5444f
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_HiddenStash_PerceptionPassed = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HiddenStash_PAD:c193be45-f5c5-4a40-8c7b-4cd123c5444f
msgctxt "ha6180c83gb73fg4a73gb810g385f1cf76265"
msgid "Loose stone - hiding something maybe?"
msgstr "느슨한 돌이야. 뭔가를 숨기고 있는 걸까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HiddenStash_PAD
#. Speaker = Player
#. NodeID = c193be45-f5c5-4a40-8c7b-4cd123c5444f
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_HiddenStash_PerceptionPassed = True
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HiddenStash_PAD:c193be45-f5c5-4a40-8c7b-4cd123c5444f
msgctxt "hf64a2f9ag9e05g4c04g825egaf457499b6c9"
msgid "That stone looks mighty odd. Someone's been messing with it."
msgstr "저 돌은 꽤나 수상쩍은데. 누군가 손을 댄 것 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HiddenStash_PAD
#. Speaker = Player
#. NodeID = c193be45-f5c5-4a40-8c7b-4cd123c5444f
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_HiddenStash_PerceptionPassed = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HiddenStash_PAD:c193be45-f5c5-4a40-8c7b-4cd123c5444f
msgctxt "h5e3518ebg9100g4a57gb8c9g9b7406cd16a0"
msgid "Curious - that stone there's been pried loose."
msgstr "신기하군. 누군가 저 돌을 느슨하게 풀어놓았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HookHorror_Hermit_Dead
