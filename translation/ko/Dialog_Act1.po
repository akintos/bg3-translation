msgid "Let's go. He'll start stinking soon."
msgstr "가자. 곧 썩는 내가 나겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_PlayerKissedFoot_001
#. Speaker = Sharp-Eye Breg
#. NodeID = 29bb0e6a-898a-e315-d68e-5b152843784c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_PlayerKissedFoot_001:29bb0e6a-898a-e315-d68e-5b152843784c
msgctxt "h0205299agc553g4acbg829cg6bb9ea47ebe8"
msgid "Hah! Didya really... really kiss his foot?"
msgstr "하! 너 진짜… 진짜 그의 발에 키스한 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_PlayerKissedFoot_002
#. Speaker = Brawler Tiny
#. NodeID = f75921eb-edad-000a-400d-c3a24b2421e9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_PlayerKissedFoot_002:f75921eb-edad-000a-400d-c3a24b2421e9
msgctxt "ha4f7e48dg139cg4304gbe5fg6c1dc2344aec"
msgid "Ugh! That's so disgustin'!"
msgstr "우웩! 역겨워!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_SecludedPlace
#. Speaker = Crusher
#. NodeID = 61af9180-e175-4df3-34c4-0402acba4032
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_SecludedPlace:61af9180-e175-4df3-34c4-0402acba4032
msgctxt "h863e40b7g5095g4adagb15agb10929a7a773"
msgid "Can't even enjoy a drink in peace."
msgstr "좀 조용히 술 마시게 못 놔둔다니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories
#. Speaker = Crusher
#. NodeID = 0d4053b0-c982-7a55-9dc6-08af3fd7c519
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories:0d4053b0-c982-7a55-9dc6-08af3fd7c519
msgctxt "h73a82cf3g9a62g48bbg9c89g394d2c644c3d"
msgid "So I stuck my dagger in that arm."
msgstr "그때 내가 그 팔에 단검을 박았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories
#. Speaker = Crusher
#. NodeID = 10754d8d-538d-5c25-a107-ae26e9d2d518
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories:10754d8d-538d-5c25-a107-ae26e9d2d518
msgctxt "h2f58b4degcc5ag46e8g99b4g28ae4055893f"
msgid "So I start creeping 'round."
msgstr "그래서 내가 몰래 뒤로 돌아갔지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories
#. Speaker = Crusher
#. NodeID = 119f5ca1-455e-cdd8-b380-9cf5761d4898
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories:119f5ca1-455e-cdd8-b380-9cf5761d4898
msgctxt "h4a61b50fg9c25g486cg8639g97dc27b971df"
msgid "Could've killed 'im. Easy."
msgstr "죽일 수도 있었어. 쉽지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories
#. Speaker = Tracker Kirz
#. NodeID = 210e7fcc-7203-7b83-dc52-40593668b3f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories:210e7fcc-7203-7b83-dc52-40593668b3f8
msgctxt "h8432a6a8g807ag43d4ga583g1e5ae5503767"
msgid "Nah, he captured him. Right?"
msgstr "야냐, 생포했어. 그치?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories
#. Speaker = Tracker Kirz
#. NodeID = 314a4c75-6473-e934-18d6-aec9b08f6898
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories:314a4c75-6473-e934-18d6-aec9b08f6898
msgctxt "h1f495758gda7cg4bbdg8bacgbfbcafdb5056"
msgid "Yeah."
msgstr "그래."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories
#. Speaker = Crusher
#. NodeID = 31daf3a5-95cf-0786-6504-3e4974d70241
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories:31daf3a5-95cf-0786-6504-3e4974d70241
msgctxt "hf4136323gc621g4ee0g8f95g1d914cd7b3ec"
msgid "An' I run up to the guy an' think, 'Try healin' <i>this</i>'."
msgstr "그래서 내가 그놈한테 달려가면서 생각하길, '어디 <i>이것도</i> 치료해 봐라'."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories
#. Speaker = Crusher
#. NodeID = 40892151-4048-4037-2dd0-55afd76efe7f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories:40892151-4048-4037-2dd0-55afd76efe7f
msgctxt "hcd2a1ac1gd84ag4435g971dg5f2a63899dc1"
msgid "Figured I'd give him to the drow. Keep the Absolute happy."
msgstr "드로우한테 넘기는 게 낫겠다 싶었지. 절대자님께 바치려고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories
#. Speaker = Crusher
#. NodeID = 433b5511-9837-f748-c13d-6bbbdee8814b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories:433b5511-9837-f748-c13d-6bbbdee8814b
msgctxt "hb72c2073g349bg4f24g8338gd44393b2a5d3"
msgid "Then 'e turns. Must've... must've read my <i>mind</i>, y'know?"
msgstr "그때 놈이 돌아섰지. 분명... 틀림없이 내 <i>생각을</i> 읽었을 거야, 그치?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories
#. Speaker = Brawler Tiny
#. NodeID = 5d70e481-86b7-8022-f2ba-b9e9e8842d03
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories:5d70e481-86b7-8022-f2ba-b9e9e8842d03
msgctxt "h00b0b364g2be5g418fg8f32g5cc5c7449b84"
msgid "Heh heh."
msgstr "헤 헤."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories
#. Speaker = Tracker Kirz
#. NodeID = 6abf6d13-62e7-1b3a-69ee-ea5a92f83fe7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories:6abf6d13-62e7-1b3a-69ee-ea5a92f83fe7
msgctxt "h1419dde5g053fg4bb1ga368g495f817e641a"
msgid "Didya capture 'im?"
msgstr "그놈 잡았어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories
#. Speaker = Crusher
#. NodeID = 6c8896c2-3e5e-37b7-3561-a273bdb6864b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories:6c8896c2-3e5e-37b7-3561-a273bdb6864b
msgctxt "h11fcefc4g4ab8g4e94gb8b2g63b3f3b6cd61"
msgid "'Cuz I ain't wasting arrows, not me."
msgstr "난 화살을 안 낭비하니까, 암."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories
#. Speaker = Crusher
#. NodeID = 74d0dd8f-f942-0294-b791-7e150d370dda
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories:74d0dd8f-f942-0294-b791-7e150d370dda
msgctxt "h7441518fgfb22g4140gabb6g3b80b3474fc7"
msgid "Then 'e lifts up this mace. With his <i>other </i>arm."
msgstr "그러니까 놈이 <i>다른</i> 팔로 메이스를 들어올렸어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories
#. Speaker = Brawler Tiny
#. NodeID = 7dc03f2e-4fa9-27e5-aaf6-fd932f5bad05
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories:7dc03f2e-4fa9-27e5-aaf6-fd932f5bad05
msgctxt "h4631c1c5g9a99g4d00g9428g273b9615e4fe"
msgid "You kill 'im?"
msgstr "그놈 죽였어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories
#. Speaker = Sharp-Eye Breg
#. NodeID = 869593da-6b18-2f75-ea80-c390f1cd040c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories:869593da-6b18-2f75-ea80-c390f1cd040c
msgctxt "haa0e33f2g608dg468agacfag34ed06d0aad0"
msgid "You kill 'im?"
msgstr "그놈 죽였어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories
#. Speaker = Crusher
#. NodeID = 8ecbc4be-6db1-d898-06a5-77dfb112be01
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories:8ecbc4be-6db1-d898-06a5-77dfb112be01
msgctxt "h6a8e9a39gfe9fg4e9fgb99dg2e863ceffb52"
msgid ""
"Then this other guy twirls his fingers, an' some <i>light </i>comes out."
msgstr "그러더니, 딴 놈이 손가락을 막 돌리니까, 뭔 <i>빛</i>같은 게 쏟아져 나오더라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories
#. Speaker = Crusher
#. NodeID = 97e4582d-f459-a982-9a89-41dcb0c3c2dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories:97e4582d-f459-a982-9a89-41dcb0c3c2dc
msgctxt "h4df24d37ga59bg4a75g9da6g05625dcb7ae5"
msgid "Yeah. They got some cheatin' magicker."
msgstr "맞아. 그자식들 웬 비겁한 요술쟁이를 데리고 있었지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories
#. Speaker = Crusher
#. NodeID = 998542f9-d839-4e19-0777-e420020ebabc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories:998542f9-d839-4e19-0777-e420020ebabc
msgctxt "h9dc15a0fgac8eg4bfcg9ec5g34d7314d9c1b"
msgid "Yeah."
msgstr "그래."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories
#. Speaker = Crusher
#. NodeID = c757a4be-b137-6f0d-7f70-5aa14ae05672
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories:c757a4be-b137-6f0d-7f70-5aa14ae05672
msgctxt "hacac96ffgbe6eg427dg9ce0g322c55cd93d8"
msgid "And the dwarf just... stops bleeding. Just stands back up."
msgstr "그리곤 드워프가 갑자기... 피가 확 멎더란 말야. 그대로 벌떡 일어나더라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories
#. Speaker = Crusher
#. NodeID = c872b124-6f1b-2571-e12a-90024f752b30
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories:c872b124-6f1b-2571-e12a-90024f752b30
msgctxt "h37460fecg29dag4d80gaa3bgcc77f9eb6120"
msgid "No more sparkly stuff for 'im."
msgstr "이제 반짝이는 건 못 하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories
#. Speaker = Crusher
#. NodeID = d31112ce-dfa6-c01b-25c9-9614f35801a2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories:d31112ce-dfa6-c01b-25c9-9614f35801a2
msgctxt "h4a5e55cdg93d1g4101g8de2g6b622012fd69"
msgid "So I grab 'is hand, and crush it. <i>Crack</i>."
msgstr "그래서 내가 그놈 손을 붙잡아선, 뭉개 버렸지. <i>콰직</i> 하고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories
#. Speaker = Crusher
#. NodeID = dfff9d54-684e-03e0-ecd2-92f860af87bb
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_DrunkGoblin_AddGoblin2(0) = True
#.     - GOB_DrunkGoblin_AddGoblin1(0) = True
#.     - GOB_DrunkGoblin_AddGoblin0(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories:dfff9d54-684e-03e0-ecd2-92f860af87bb
msgctxt "h3e7826fbgfc95g4e47gaa57gc6b76b80b966"
msgid "So I'm shootin' arrows at this dwarf. It's great."
msgstr "그래서 내가 그 드워프 자식에게 화살을 쏘고 있었거든. 그것까진 좋았지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories
#. Speaker = Brawler Tiny
#. NodeID = e6ea3c70-ab68-dcf1-21ff-98ffae7304cd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories:e6ea3c70-ab68-dcf1-21ff-98ffae7304cd
msgctxt "hb71ff928g70d4g4424g9118g9cd055dadc8d"
msgid "Oh ho!"
msgstr "오 호!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories
#. Speaker = Crusher
#. NodeID = e73d3f70-1810-cb09-ed66-d3d04ea5f256
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories:e73d3f70-1810-cb09-ed66-d3d04ea5f256
msgctxt "h09b65585g6476g416cga49bg943c9aa8ea71"
msgid "But I didn't wanna."
msgstr "하지만 그러고 싶지 않았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories
#. Speaker = Crusher
#. NodeID = e8899f4c-a475-dd81-140f-ac0757e1a8f9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories:e8899f4c-a475-dd81-140f-ac0757e1a8f9
msgctxt "ha43ccc66g0a66g43b7g8918g9ae6f86d94cf"
msgid "No more problems from that runt after <i>that</i>."
msgstr "<i>그렇게</i> 하고 나니 그놈이 문제 일으킬 일은 없단 말씀."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories
#. Speaker = Crusher
#. NodeID = eae49811-7fc6-1df2-fc45-e22958677090
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories:eae49811-7fc6-1df2-fc45-e22958677090
msgctxt "h97bf9645g64e0g4a43ga4bag0b98921609f5"
msgid "And 'e raises his arm to magick again."
msgstr "근데 그자식이 또 팔을 들어올리면서 요술을 부리려는 거 아니겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories
#. Speaker = Tracker Kirz
#. NodeID = fcdc00a4-1e69-ba6f-c984-81a9eceb57e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_Stories:fcdc00a4-1e69-ba6f-c984-81a9eceb57e7
msgctxt "h8b2d14f2g9534g4bdcg84b6g807d03dbe3b2"
msgid "<i>Booyahg.</i>"
msgstr "<i>부야그구나.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_AfterPoisoning_000
#. Speaker = Devout Mezzka
#. NodeID = 6fc5b44d-3709-f742-3aad-571d0badfb20
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_AfterPoisoning_000:6fc5b44d-3709-f742-3aad-571d0badfb20
msgctxt "hd5c871d9gb83dg419ega128g506f89bccd48"
msgid "My guts hurt. Hope I ain't poisoned."
msgstr "배가 아파. 독에 걸린게 아니길 빌어야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_AfterPoisoning_001
#. Speaker = Warrior Sul
#. NodeID = 4f96a3ad-f387-ca97-7b1f-df0493bf6c4a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_AfterPoisoning_001:4f96a3ad-f387-ca97-7b1f-df0493bf6c4a
msgctxt "h08a415edg9e9cg4068gbc25g2a380a9e5069"
msgid "I <i>knew</i> there was somethin' wrong with that beer."
msgstr "난 저 술이 뭔가 잘못된 건줄 <i>알았어</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_AfterPoisoning_002
#. Speaker = Tracker Tak
#. NodeID = 1394b85e-3b70-fa9e-ca1e-968abaf6552d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_AfterPoisoning_002:1394b85e-3b70-fa9e-ca1e-968abaf6552d
msgctxt "hb9ec7506gd1e7g4876ga613ge03acfbf68ad"
msgid "Murderin' us with our own beer - that's proper cruel."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_AfterPoisoning_003
#. Speaker = Brawler Rot
#. NodeID = 8804ad0a-009c-e11e-b9d6-11a0f0648317
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_AfterPoisoning_003:8804ad0a-009c-e11e-b9d6-11a0f0648317
msgctxt "h72c81f7dgfeebg4b55ga6beg2939c384ef65"
msgid "Poisonings for cowards. Should find 'em and kill 'em."
msgstr ""

