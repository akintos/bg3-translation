msgctxt "ha146469eg9543g432agb268gae76dfb1942a"
msgid "You made quite an impression on my master - he sends his regards."
msgstr "제 주인님이 당신에게 무척 감명 받으셨답니다. 그분이 눈여겨보고 계셔요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarlockProposal_Warlock
#. Speaker = Korrilla
#. NodeID = a2b6165e-2f9f-ca27-a5a7-d35408d2ee43
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarlockProposal_Warlock:a2b6165e-2f9f-ca27-a5a7-d35408d2ee43
msgctxt "he8456d05g81bfg4938g8d5dg6ee66a2419ce"
msgid "Kill me? I don't think so. You can't even wriggle out of those chains."
msgstr "날 죽이겠다고 하셨나요? 당신은 그 사슬에서 조금도 꼼짝 못 할 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarlockProposal_Warlock
#. Speaker = Player
#. NodeID = a533a7af-ce6c-edad-3107-fc49e7549ea2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarlockProposal_Warlock:a533a7af-ce6c-edad-3107-fc49e7549ea2
