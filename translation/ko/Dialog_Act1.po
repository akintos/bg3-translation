#. CheckFlags:
#.   Global:
#.      - GOB_GoblinToast_State_RealizedPoison = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Ogre_00:f1a1de54-8187-44d3-7907-5c7896f16e25
msgctxt "h27200af5g960dg478fg9df8g1d52449ad661"
msgid "Someone kill beer. No more fun - I smash him."
msgstr "누가 맥주를 죽였다. 이제 재미 없다. 그 녀석 부순다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Trader
#. Speaker = Player
#. NodeID = 15e4bc90-9cc0-25cf-6b98-dd2b6a54f948
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Trader_Knows_Goods(1) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_Trader_Knows_Goods(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Trader:15e4bc90-9cc0-25cf-6b98-dd2b6a54f948
msgctxt "ha2a9e07bg71bdg4db0gaa96g2321c1befe79"
msgid "Quite the trove. How'd you get your hands on all this?"
msgstr "엄청 많네. 이 모든 것을 어떻게 손에 넣은 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Trader
