msgctxt "h7f114fc1g54d4g485agb57ag76d918bd08c1"
msgid "Could've done a lot worse. <b>A lot worse.</b>"
msgstr "더 끔찍한 짓도 가능했어. <b>아주 끔찍한 짓을.</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation
#. Speaker = Narrator
#. NodeID = a3eed0b8-1db0-92e1-1e37-fd2169c001de
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation:a3eed0b8-1db0-92e1-1e37-fd2169c001de
msgctxt "ha40b5dfbgf360g4432g860fgb0f61ae79cd8"
msgid ""
"*The mark glows, but you feel nothing in response. Your illithid power is "
"beyond reach until you rest.*"
msgstr "*문양이 빛나지만, 어떤 반응도 느껴지지 않습니다. 일리시드 능력을 더 사용하려면 휴식을 취해야 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation
