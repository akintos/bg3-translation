msgctxt "he0a6968dg5e37g4f95g9e51g07bb173b9097"
msgid "None of your concern. Back to your stupor."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinSleeper_02
#. Speaker = Booyahg Culk
#. NodeID = 343bf5a5-f6b1-0502-3154-dcbe2ee5b741
