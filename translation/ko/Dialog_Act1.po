msgctxt "hd54f86eag2807g4167g981bg46b18fed9052"
msgid ""
"*Something stirs deep within you, hungry and alert... it's taking something "
"you'll never get back.*"
msgstr "*몸 깊숙한 데서 굶주리고 기민한 존재가 꿈틀댑니다... 잃으면 되찾지 못할 뭔가를 좀먹고 있군요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Trespassing
#. Speaker = Player
#. NodeID = af39401a-f54e-d650-8116-5238a3352fcb
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Trespassing:af39401a-f54e-d650-8116-5238a3352fcb
msgctxt "hc4c22c29g7ee1g42dag8680g0597b3248212"
msgid "Remove yourself from my presence, or pay the price."
msgstr "당장 내 앞에서 물러나지 않으면 대가를 치르게 될 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Trespassing
#. Speaker = GROUP_GOB_Checkpoint_Guards
#. NodeID = b479c3dc-a755-5dbb-b294-20784b73992d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_Checkpoint_State_GainedAccess = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Trespassing:b479c3dc-a755-5dbb-b294-20784b73992d
msgctxt "h6fdd3543gf575g4a3cg99c7g67f1ba4066f1"
msgid ""
"<i>You? </i>Well. In you get, then. Hope you brought somethin' good to chug."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Trespassing
#. Speaker = Narrator
#. NodeID = b6001091-49de-5544-3319-b431cbcfc6c2
