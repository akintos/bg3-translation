#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_Adventurer02:f51c017a-d1c7-7fcd-9a11-3c39727c510c
msgctxt "haee5bc4bge173g49abga115g92d7bc5191b9"
msgid "I need a drink and a real bed."
msgstr "술 한 잔이 간절해. 제대로 된 침대도."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_CorpseMove
#. Speaker = Rikka
#. NodeID = 1e455bb0-6264-ba8b-a6b6-f5f748405166
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_CorpseMove:1e455bb0-6264-ba8b-a6b6-f5f748405166
msgctxt "h6a6531b4g5c68g4bbbgb5ebg43e4f7604680"
msgid "Please, may he rest by Your side."
msgstr "바라노니, 그를 품어 편히 쉬게 하소서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_CorpseMove
#. Speaker = Rikka
#. NodeID = 22caff9c-70d0-8675-232b-55dbb29230d1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_CorpseMove:22caff9c-70d0-8675-232b-55dbb29230d1
msgctxt "hbac6d52bg7e52g41e1g8e9bge3ca9b6f9919"
msgid "He always knew what to say... when I was homesick."
msgstr "내가 고향을 그리워 할 때면... 늘 나를 달래줬었지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_CorpseMove
#. Speaker = Rikka
#. NodeID = 2ae8a03d-6ff6-8e55-89d9-00e012d974c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_CorpseMove:2ae8a03d-6ff6-8e55-89d9-00e012d974c0
msgctxt "h1ddf3f14g72c3g489cga676ge21c0fc7f369"
msgid "He... he never hurt anyone."
msgstr "카논은… 남을 해친 적 없는 애였어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_CorpseMove
#. Speaker = Rikka
#. NodeID = 3fc8fe4d-cc5e-3f0d-650c-7aab7bcac14f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 2cdb05c3-d201-33f6-506c-20f0102e4f57_A = False
#. SetFlags:
#.   Local:
#.     - 2cdb05c3-d201-33f6-506c-20f0102e4f57_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_CorpseMove:3fc8fe4d-cc5e-3f0d-650c-7aab7bcac14f
msgctxt "hd1db70ecg24a1g45ebgae44g13e8ad97cd63"
msgid "Why does this keep happening?"
msgstr "왜 이런 일이 자꾸 생기는 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_CorpseMove
#. Speaker = Rikka
#. NodeID = 4c7a48da-07b4-b289-273b-53aed0a03ef6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_CorpseMove:4c7a48da-07b4-b289-273b-53aed0a03ef6
msgctxt "h4d7666ecgb1bag4ba7g9018ge2691bbcd390"
msgid "He never let it show, but he was homesick, too."
msgstr "티낸 적은 없지만, 얘도 고향을 그리워했는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_CorpseMove
#. Speaker = Rikka
#. NodeID = 5b74b704-0e87-e6f5-a553-49267bc5ea12
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_CorpseMove:5b74b704-0e87-e6f5-a553-49267bc5ea12
msgctxt "hce21f497gd517g4a09gad8ag1b23d7e6071e"
msgid "And now what? We dig a hole and be done with him?"
msgstr "이젠 어째? 무덤이나 파주고 나면 얘랑은 이렇게 끝인 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_CorpseMove
#. Speaker = Kaldani
#. NodeID = 67e952fc-2d1e-1455-014b-ac942a4d76e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_CorpseMove:67e952fc-2d1e-1455-014b-ac942a4d76e7
msgctxt "h8a03d9feg4176g4b1bg86cag4250f3ecf63f"
msgid "We... we could say a prayer. We should have time for that."
msgstr "우린... 기도 정도는 해줄 수 있어. 그럴 여유 정도는 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_CorpseMove
#. Speaker = Rikka
#. NodeID = 6a3f94a1-5734-8fa4-76c0-cf4b590ead07
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_CorpseMove:6a3f94a1-5734-8fa4-76c0-cf4b590ead07
msgctxt "h0f2bf859g8868g4a86ga7d2g97b0fe20d60c"
msgid "He didn't deserve this."
msgstr "이런 일을 당해선 안 됐다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_CorpseMove
#. Speaker = Rikka
#. NodeID = 7cb3933c-a3be-3a49-bc98-9a8890dc454d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_CorpseMove:7cb3933c-a3be-3a49-bc98-9a8890dc454d
msgctxt "h43377f46g66e3g4dacg9d81gf16560ef314d"
msgid "He was joking about Okta's soup just a moment ago..."
msgstr "아까 전까지 오크타 아주머니 죽 가지고 농담 나눴는데..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_CorpseMove
#. Speaker = Rikka
#. NodeID = b73d345f-8874-0797-36e7-c74ed2bb0b3f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_CorpseMove:b73d345f-8874-0797-36e7-c74ed2bb0b3f
msgctxt "hab334d35g986dg434cgbc9bgc0a18819f8e8"
msgid "Yeah... yeah, that would be good."
msgstr "그래... 그래. 그러면 좋을 거 같네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_CorpseMove
#. Speaker = Rikka
#. NodeID = e91f4ce2-1d56-0e6e-eb58-ea43351fe0a7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 2cdb05c3-d201-33f6-506c-20f0102e4f57_A = True
#. SetFlags:
#.   Local:
#.     - 2cdb05c3-d201-33f6-506c-20f0102e4f57_A = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_CorpseMove:e91f4ce2-1d56-0e6e-eb58-ea43351fe0a7
msgctxt "hf998a40bg55feg480bgba76g543803b8015f"
msgid "O Selûne, Our Lady of Silver."
msgstr "아아, 셀루네. 은의 여인이시여."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_CorpseMove
#. Speaker = Kaldani
#. NodeID = f9dd1809-7396-cd3f-072e-4573bc2b4efb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_CorpseMove:f9dd1809-7396-cd3f-072e-4573bc2b4efb
msgctxt "h56ae1523ga409g46b6gbeb0gb90e3d846951"
msgid "Come on, Rikka."
msgstr "진정해, 리카."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_Gatekeeper
#. Speaker = Elegis
#. NodeID = 2d6402bb-237a-5adc-1aad-5670f4bded00
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_Gatekeeper:2d6402bb-237a-5adc-1aad-5670f4bded00
msgctxt "h943a9138g4235g45edgba1fgcb276322ff6f"
msgid "Feel like we're being watched..."
msgstr "누가 우릴 감시하는 것만 같아..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_Gatekeeper
#. Speaker = Elegis
#. NodeID = 746c4683-3c95-5c78-da84-0a51fe410b76
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Refugees_State_LeadersAreDead = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_Gatekeeper:746c4683-3c95-5c78-da84-0a51fe410b76
msgctxt "h9911a436g38fbg49abg896egf25c04c9e9df"
msgid "We can finally leave."
msgstr "드디어 떠날 수 있겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_GruntingKid
#. Speaker = Doni
#. NodeID = ef62a7af-a1df-9403-94b7-b9d3bc0c101a
