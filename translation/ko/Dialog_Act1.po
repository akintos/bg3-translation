msgctxt "hdd5059edg2bddg4e47g9a9cg5adf800dab4a"
msgid "Leaving. Fresh meat someplace else."
msgstr "떠난다. 다른 어딘가 신선한 고기."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeWorg1
#. Speaker = Worg
