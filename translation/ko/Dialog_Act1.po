#.     - CRE_UpperGuards_State_GainedAccess = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing:151405cf-27e4-8225-9111-3dcb886d7816
msgctxt "hfefa3589g30bbg4711gb1a6g9819d696d743"
msgid ""
"Wait. First, report to our <i>Kith'rak</i>, she might have need of you. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing
#. Speaker = Player
#. NodeID = 179f405e-f1f0-e0b8-4863-2438ab07b4f9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_GithChokepoint_State_SpokeToVoss = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing:179f405e-f1f0-e0b8-4863-2438ab07b4f9
msgctxt "h5b859557gf219g420dgbf7bge7d36fbb58ef"
msgid "I have the weapon Captain Voss was looking for."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing
#. Speaker = Player
#. NodeID = 19f1240f-df7b-4088-9906-5da03b5ab1a7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_GithChokepoint_State_SpokeToVoss = True
#.      - GLO_GithChokepoint_Quest_GithLeave = True
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing:19f1240f-df7b-4088-9906-5da03b5ab1a7
msgctxt "h2394d40cg2e8bg4c72ga282gd49509d8348b"
msgid ""
"Kith'rak Voss said you're looking for a weapon, I've brought it with me."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing
#. Speaker = Raider G'r'ath
#. NodeID = 1e5cfb5e-e010-3c73-1a10-3418102da110
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = False
#. SetFlags:
#.   Global:
#.     - CRE_UpperGuards_Event_HiddenCheckpointHostile = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing:1e5cfb5e-e010-3c73-1a10-3418102da110
msgctxt "hbea2a855g5075g40d0g9173gb2056c57f6d3"
msgid "Unlikely. <i>Htak'a!</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing
#. Speaker = Player
#. NodeID = 2188e4b2-0a28-d4d9-8993-6cdb9725284e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing:2188e4b2-0a28-d4d9-8993-6cdb9725284e
msgctxt "h2f111f05g93cbg4894gbaa2g314806224717"
msgid "Do you have no mercy?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing
#. Speaker = Player
#. NodeID = 267085e0-0649-4ca1-2235-fc922a450248
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 21
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing:267085e0-0649-4ca1-2235-fc922a450248
msgctxt "hc43e9ba0g8ce3g4ee9gba8dg11854c8b4557"
msgid ""
"I have not transformed yet, and it's been ages. Your medics would find me "
"useful. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing
#. Speaker = Player
#. NodeID = 2d8a5f94-57d3-804a-668f-3cc434f3ada9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing:2d8a5f94-57d3-804a-668f-3cc434f3ada9
msgctxt "hc25f3c94g7896g42b6g99ecg092eff1c59e7"
msgid "Wait! I've been infected by an illithid, and I need your help. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing
#. Speaker = Raider G'r'ath
#. NodeID = 35e26252-07c8-5c1a-8265-cc7026537f5b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_UpperGuards_Event_HiddenCheckpointHostile = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing:35e26252-07c8-5c1a-8265-cc7026537f5b
msgctxt "h23ad68e2g5c96g44b3gaea1gba4fbb94b247"
msgid "'Mercy' is a weakness we do not suffer from. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing
#. Speaker = Player
#. NodeID = 436bbac2-63e9-4663-9a28-eeae5486a920
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_UpperGuards_Event_HiddenCheckpointHostile = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing:436bbac2-63e9-4663-9a28-eeae5486a920
msgctxt "h9e2faaf4g98f4g4f89g8ea5g6d03a0ff5617"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing
#. Speaker = Player
#. NodeID = 5ae994b4-a064-22d2-c25d-74625332515f
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 21
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing:5ae994b4-a064-22d2-c25d-74625332515f
msgctxt "h41be15f1g97e4g46d2g9695g0c3cbcc13277"
msgid "Let me past. It'll save both of us time and <i>you </i>a lot of blood. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing
#. Speaker = Raider G'r'ath
#. NodeID = 6d1237f0-dd92-3e38-b7a6-41546fae105a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_UpperGuards_State_GainedAccess = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing:6d1237f0-dd92-3e38-b7a6-41546fae105a
msgctxt "h54a124a0gaf9cg46b3g98f5g841d24b08be4"
msgid "Perhaps you could be of use to her. Seek her within."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing
#. Speaker = Raider G'r'ath
#. NodeID = 6f340d2e-6c36-5af0-869f-babca2d9db97
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing:6f340d2e-6c36-5af0-869f-babca2d9db97
msgctxt "h2195ce3dg6a36g487cga9e0g36e73f5f1fee"
msgid "You would ask <i>us </i>for help?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing
#. Speaker = Raider G'r'ath
#. NodeID = 719c140c-4414-f9ec-8d05-f41931c64163
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing:719c140c-4414-f9ec-8d05-f41931c64163
msgctxt "ha44b6a67g2b8bg4d9bgb85fg9299390387f2"
msgid "<i>Kith'rak </i>Therezzyn is similarly concerned."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing
#. Speaker = Raider G'r'ath
