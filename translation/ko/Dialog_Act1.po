msgctxt "hcf61976cgd669g4b2eg976dg1f4b37a1ebb7"
msgid "What's this...? Oh, just a bone."
msgstr "이게 뭐지...? 오, 그냥 뼈군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_WormWall_PAD_Empty3
