msgid "Stand down!"
msgstr "물러서!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Narrator
#. NodeID = 68922f04-9e19-140b-173b-1283bb34ecfd
