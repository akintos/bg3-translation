msgctxt "h430f1a0dg59efg490ega7c7g5757b7990765"
msgid "Dragon claws. Amazing."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DragonScratch_PAD
#. Speaker = Player
#. NodeID = 2480260e-a924-4a37-946f-16e9188f1048
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DragonScratch_PAD:2480260e-a924-4a37-946f-16e9188f1048
msgctxt "hfd1f09cdg85e5g457bg8110g49c93643382a"
msgid "A dragon's claw-scratches. Unmistakable."
msgstr "틀림없이 드래곤의 발톱 자국이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DragonScratch_PAD
#. Speaker = Player
#. NodeID = 2480260e-a924-4a37-946f-16e9188f1048
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DragonScratch_PAD:2480260e-a924-4a37-946f-16e9188f1048
msgctxt "h8f1cda94ga2f5g458bga3d5g03f0f76c0c0f"
msgid "Dragon claws. The marks look recent."
msgstr "드래곤의 발톱이야. 얼마 되지 않은 흔적이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DragonScratch_PAD
#. Speaker = Player
#. NodeID = 2480260e-a924-4a37-946f-16e9188f1048
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DragonScratch_PAD:2480260e-a924-4a37-946f-16e9188f1048
msgctxt "h1d76e47cg003cg4009gb013gb1e4fd3e2af5"
msgid "The work of a dragon, no doubt in my mind."
msgstr "의심할 여지 없이 드래곤의 작품이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DragonScratch_PAD
#. Speaker = Player
#. NodeID = 2480260e-a924-4a37-946f-16e9188f1048
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DragonScratch_PAD:2480260e-a924-4a37-946f-16e9188f1048
msgctxt "hd3bb06aag871ag495eg8921g51ce55a5db0e"
msgid "I think they're dragon marks. Better keep an eye out."
msgstr "드래곤 흔적 같아. 조심하는 게 좋겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DragonScratch_PAD
#. Speaker = Player
#. NodeID = ee7df49d-9ad0-4661-b3e1-abb22a87f0d3
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DragonScratch_PAD:ee7df49d-9ad0-4661-b3e1-abb22a87f0d3
msgctxt "h46f26763gf3d7g4301gbc51g82d9a8b18db3"
msgid "Whatever did it, I don't want to meet it."
msgstr "저걸 남긴 게 무엇이든 간에 별로 만나고 싶지는 않군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DragonScratch_PAD
#. Speaker = Player
#. NodeID = ee7df49d-9ad0-4661-b3e1-abb22a87f0d3
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DragonScratch_PAD:ee7df49d-9ad0-4661-b3e1-abb22a87f0d3
msgctxt "hfe3a9fc8g330bg4079gb85dg78196263e74f"
msgid "What the hells could do that...?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DragonScratch_PAD
#. Speaker = Player
#. NodeID = ee7df49d-9ad0-4661-b3e1-abb22a87f0d3
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DragonScratch_PAD:ee7df49d-9ad0-4661-b3e1-abb22a87f0d3
msgctxt "h7e07aca2gbc28g4d9dga0b6ge5f19eedbe49"
msgid "Maybe some natural phenomenon."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DragonScratch_PAD
#. Speaker = Player
#. NodeID = ee7df49d-9ad0-4661-b3e1-abb22a87f0d3
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DragonScratch_PAD:ee7df49d-9ad0-4661-b3e1-abb22a87f0d3
msgctxt "h8e0a3c94g9c88g431bg92efg900810b0ed0b"
msgid "A gnoll, perhaps? No. Something bigger."
msgstr "놀인가? 아니야. 더 큰 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DragonScratch_PAD
#. Speaker = Player
#. NodeID = ee7df49d-9ad0-4661-b3e1-abb22a87f0d3
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DragonScratch_PAD:ee7df49d-9ad0-4661-b3e1-abb22a87f0d3
msgctxt "h3fdd09c5g94a2g4320ga0d1g8fbb36c41209"
msgid "Anything with claws that big is best avoided."
msgstr "저만한 발톱을 가진 생물은 피하는 게 상책이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DragonScratch_PAD
#. Speaker = Player
#. NodeID = ee7df49d-9ad0-4661-b3e1-abb22a87f0d3
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DragonScratch_PAD:ee7df49d-9ad0-4661-b3e1-abb22a87f0d3
msgctxt "h852b0c44g8c37g482eg9e2ag0ecc3dc32c84"
msgid "Whatever made those scratches, it's big. <i>Very</i> big."
msgstr "이 자국을 남긴 게 뭔진 몰라도, 큰 녀석이야. <i>무척</i> 큰."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DragonScratch_PAD
#. Speaker = Player
#. NodeID = ee7df49d-9ad0-4661-b3e1-abb22a87f0d3
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DragonScratch_PAD:ee7df49d-9ad0-4661-b3e1-abb22a87f0d3
msgctxt "h67949accgaff5g4709g83e7gdc38aee7c49e"
msgid "Perhaps it's some artist trying to make a statement."
msgstr "어떤 예술가가 남긴 일종의 예술인지도 모르지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_02
