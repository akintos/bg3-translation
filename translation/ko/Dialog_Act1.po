msgctxt "h36137e95g6b80g4a2cgbfefg803b70085c9a"
msgid "Now where has she slithered off to...?"
msgstr "어디로 슬쩍 빠져나간 거지...?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_PAD_Fled
