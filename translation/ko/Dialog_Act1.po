msgctxt "h7ac2f401g9e47g4beag8c62gb643655cef03"
msgid "*The spell's power wanes. You can ask no more questions.*"
msgstr "*주문의 힘이 약해집니다. 더 이상 질문할 수 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_DeadFisherman5_Dead
