msgid "<i>Tuuch! Tuuch! Tuuch!</i>"
msgstr "<i>투우치! 투우치! 투우치!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinPriest_AD_AfterBranding
#. Speaker = True Soul Gut
#. NodeID = 07a128c8-462d-08f1-ec72-e085d434b99f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinPriest_AD_AfterBranding:07a128c8-462d-08f1-ec72-e085d434b99f
msgctxt "h35014261gb623g4c55gbe5agdfbc28ecc871"
msgid "Obey the drow."
msgstr "드로우를 따르라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinPriest_AD_AfterBranding
#. Speaker = True Soul Gut
