msgctxt "h7b16d0a7gd405g4c5bga660g795fcc0575bf"
msgid "Please, I need more."
msgstr "제발, 더 들려줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerCharmed
