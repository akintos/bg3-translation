msgctxt "h7b707c8fgc2ccg4263ga508g0365f2d60aff"
msgid "Such splendour... how did I live without it?"
msgstr "이런 장엄함이라니... 이런 아름다움을 모른 채 어떻게 지금껏 살아왔을까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerCharmed
#. Speaker = Player
#. NodeID = 0383f50b-4238-08bd-c76b-1a063fb7040a
