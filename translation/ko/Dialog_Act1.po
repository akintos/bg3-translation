#.      - UND_FurnaceSearch_State_TriedInvestigation(1) = False
#. SetFlags:
#.   Object:
#.     - UND_FurnaceSearch_State_TriedInvestigation(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_DisguisedJournal:82deae23-6078-40ac-916c-cd527ab27f23
msgctxt "h9cb779b1g89eag40dega038g135fa9c7926e"
msgid "<i>Examine the book closely.</i>"
msgstr "<i>책을 더 자세히 살펴본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_DisguisedJournal
#. Speaker = Player
#. NodeID = 859e3f8b-95cb-e792-be1f-1de91a4c7736
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 15
#. CheckFlags:
