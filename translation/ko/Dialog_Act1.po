msgctxt "hd3ce8f05gd157g4578g8728g10af5b6c48d3"
msgid "More Selûnite markings. No worshippers left though."
msgstr "셀루네 교단의 상징이 더 있어. 하지만 추종자들은 전혀 보이지 않네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/VBs/GOB_ShadowHeart_VB_Mural
#. Speaker = Shadowheart
#. NodeID = dc835cc3-6408-3ea3-f735-ebc4f041d386
#. HandlePath = TaggedText[0].TagText[0]
