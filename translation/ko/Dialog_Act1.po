msgctxt "hcde689b8g4836g4d1cgb51cg3bfa63e76ae8"
msgid "Hellooo?"
msgstr "계세요오오?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DeepHole
#. Speaker = Voice from the Deep Hole
#. NodeID = b9616c6d-9f38-a3c9-2602-802565c4112b
