msgctxt "hc7d42620g3646g4df6gb34eg14fe7d860643"
msgid "*SCREE!*"
msgstr "*스크리!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Narrator
#. NodeID = 330cd538-da4a-5b76-0708-99249b85b440
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:330cd538-da4a-5b76-0708-99249b85b440
msgctxt "h5e5c698dgba66g4c8egb53cgc8f9d11e3a34"
msgid ""
"*These spiders are loyal to the local duergar. In the event of a fight, they "
"will join the fray against you - with slavering enthusiasm.*"
msgstr ""
"*이 거미들은 지역 듀에르가에게 충성합니다. 만약 싸움이 벌어지면, 그들은 당신을 상대로 벌이는 싸움에 엄청난 기세로 참여할 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Fu
#. NodeID = 3744055a-0de7-b4c8-d039-b5a9d2c04a08
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_DuergarCamp_SpiderEvangelical_DialogEnded = True
#.     - GLO_UND_SpiderFight_SpidersLeave = True
