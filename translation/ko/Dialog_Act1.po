msgctxt "h5e26292egc287g48ecga4acgaca5abe0c367"
msgid ""
"<i>Why won't he leave? I need to warn the others... and find Remira, if "
"she's still alive.</i>"
msgstr "<i>왜 떠나질 않는 거야? 다른 이들에게 경고해 줘야 해... 그녀가 살아있다면, 레미라도 찾고.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = a9da07b3-ad32-a94f-e6c3-a90ff3bec45f
#. HandlePath = TaggedText[2].TagText[0]
#. SetFlags:
#.   Local:
#.     - 6621e6ea-f89e-a19d-e8dc-6e6bc0779404_MindHasBeenRead = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:a9da07b3-ad32-a94f-e6c3-a90ff3bec45f
msgctxt "h1fa7e209gfdcdg4891g9beag90208f5265f5"
msgid ""
"<i>Why won't they leave? I need to warn the others... and find Remira, if "
"she's still alive.</i>"
msgstr "<i>왜 떠나질 않는 거야? 다른 이들에게 경고해 줘야 해... 그녀가 살아있다면, 레미라도 찾고.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = ad3e3ee9-c635-5dc9-1191-8c74434f263f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:ad3e3ee9-c635-5dc9-1191-8c74434f263f
msgctxt "h060361cag1635g4fbbga6e1g1abf3e63503e"
msgid "<i>Wait </i>just <i>a bit longer.</i>"
msgstr "<i>조금만 더 기다린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = adcb4a9e-c2c2-f619-6dad-6e34542219b2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - GLO_Tadpole_SUB_Druid.LearnedBear(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:adcb4a9e-c2c2-f619-6dad-6e34542219b2
msgctxt "h9e057f15g6b3cg48efg8b67g817e235a3533"
msgid ""
"Halsin? I... I don't know. He changed into a bear, but... I lost sight of "
"him. I don't know if he's s-still alive."
msgstr ""
"할신? 저... 저도 몰라요. 곰으로 변신하는 건 봤는데... 그 이후는 본 적이 없어요. 그가 지-지금 살아있는지도 모른다고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = af7ad2a1-6160-48e5-b44f-41e1a630869c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:af7ad2a1-6160-48e5-b44f-41e1a630869c
msgctxt "h42a8c615gdf75g456agb5feg78732d3407eb"
msgid "<i>Try to understand what's happening.</i>"
msgstr "<i>무슨 일이 일어나는지 이해하려 애쓴다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = b1babb07-beac-3ab2-1a1b-1bad3faee03b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:b1babb07-beac-3ab2-1a1b-1bad3faee03b
msgctxt "h7ece1115g8854g4bd5gaceeg161a20199b80"
msgid "<i>Nnnearrgh!  </i>My hand... ahh..."
msgstr "<i>끄아아아악!  </i>내 손이... 아아..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = b1bb799d-3790-f0ce-7c70-32cb1c377d63
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:b1bb799d-3790-f0ce-7c70-32cb1c377d63
msgctxt "he0e2df51g2371g4877g9880g86de60d8db5b"
msgid "It was the only way. You should be able to slip your hand free."
msgstr "이 방법밖엔 없었어. 이제 당신 손을 빼낼 수 있을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = b21b548f-b32f-12d4-8a0b-97307a721258
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:b21b548f-b32f-12d4-8a0b-97307a721258
msgctxt "h82044d52g938cg451bgbcc9gc4e965a8d286"
msgid "Nnnearrgh! Are you mad?! I'm -"
msgstr "으아아아악! 정신이 나간 건가요?! 전-"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = b2fba627-e448-6954-1a76-530b3b2edd5c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 0
#. CheckFlags:
#.   Local:
#.      - 6621e6ea-f89e-a19d-e8dc-6e6bc0779404_MindHasBeenRead = False
#.   Script:
#.      - GEN_CanDetectThoughts_2 = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:b2fba627-e448-6954-1a76-530b3b2edd5c
msgctxt "h768a7b43g5dedg42f6g938agc98365bba5f7"
msgid "<i>Read his mind.</i>"
msgstr "<i>그의 생각을 읽는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = b33a9c4c-781b-c21b-3a5b-d794138fcd41
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_TorturedAdventurer_LeftInChains(1) = True
#.     - GOB_TorturedAdventurer_Knows_FailedPersuade(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:b33a9c4c-781b-c21b-3a5b-d794138fcd41
msgctxt "h4d68158bg12b3g49fcg8548gd4516d95f725"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = b7d0a69e-bbc8-fcd6-3e15-e847ce191a00
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_Torturers_State_PrisonerFreed = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:b7d0a69e-bbc8-fcd6-3e15-e847ce191a00
msgctxt "h809e7791geebag44e5g9814gdb33b1d2321f"
msgid "<i>Ahh</i>... I suppose I ought to be grateful."
msgstr "<i>아야</i>... 고마워해야 하긴 하겠죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = b8317ba1-a314-acb4-3673-a36615222075
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_AdventurersQuest_Knows_AboutSH = True
#.      - GOB_TorturedAdventurer_Knows_WasLookingForSH = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:b8317ba1-a314-acb4-3673-a36615222075
msgctxt "hf4224745gafa7g4757ga3cfg571ad7366acd"
msgid "You came looking for the Nightsong, didn't you?"
msgstr "당신은 밤의 노래를 찾으러 온 것 아닌가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = b87b79d5-f808-b093-74bb-6c5269e15105
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_AdventurersQuest_Knows_AboutSH = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:b87b79d5-f808-b093-74bb-6c5269e15105
msgctxt "h03f9549dg7b3cg4f3egb044gfcb8442e21ec"
msgid "How were you captured?"
msgstr "어떻게 하다가 납치된 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = b8bb6c95-b14b-0b7f-d5cb-c74fcfef051f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - Has_TaggedItem_HEALING_POTION(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:b8bb6c95-b14b-0b7f-d5cb-c74fcfef051f
msgctxt "h9d3cc862gff4dg4e43gb76cg7262bb138783"
msgid "<i>Pour a healing potion into his mouth.</i>"
msgstr "<i>그의 입에 치유의 물약을 붓는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = b9e96963-273c-3ee7-3747-4fc7766b59ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:b9e96963-273c-3ee7-3747-4fc7766b59ac
msgctxt "hb31a8e14g0ff2g461bgb298ge2526a49696f"
msgid "Where are the goblins hiding it?"
msgstr "고블린들이 그걸 어디에 숨기고 있지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = ba3f6974-d58c-e46e-0582-db2e7fd4195b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:ba3f6974-d58c-e46e-0582-db2e7fd4195b
msgctxt "hb28b823agd58eg4c04g91c6gec86db970b7d"
msgid "I don't know. The boss didn't say."
msgstr "전 몰라요. 대장이 말해 주지 않았거든요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = c0429f2b-0b52-101a-8c61-3a8d26b7d1ff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:c0429f2b-0b52-101a-8c61-3a8d26b7d1ff
msgctxt "h7fdfd909gb9e0g4339gb98agcfb9da4cdf8d"
msgid ""
"We... I was w-with a group of adventurers. We came here for an artefact."
msgstr "우리... 전 모험가 무리와 하-함께였어요. 이곳에 아티팩트를 찾으러 왔죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = c06b4e59-28b6-dd63-8111-af27684d5764
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_AdventurersQuest_Knows_AboutBounty = True
#.   Quest:
#.     - SHA_Nightsong.HeardOf(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:c06b4e59-28b6-dd63-8111-af27684d5764
msgctxt "he42db222g6fc1g4bf0g9081g81f05e6fb616"
msgid ""
"He j-just said some wizard called Lorroakan would reward us if we found it."
msgstr "그가 말, 말하길 로로아칸이라는 위저드가 그걸 찾으면 우리에게 보상을 줄 거라고 했다고 하더군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = c0ac0cd2-8a6e-4079-8426-ddb0443d30d5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - SHA_Nightsong.LearnedLocation(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:c0ac0cd2-8a6e-4079-8426-ddb0443d30d5
msgctxt "hc3dad297gea37g4a3cg802ag5d0cfefdb099"
msgid "S-somewhere underneath the temple. There's a hidden p-passage."
msgstr "이 신전 아래 어-어딘가에요. 숨겨진 토-통로가 있어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = c24f1baa-4a26-b11b-a74f-f57e9fbc95f2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_HappyTorturers_Knows_PlayersKnowDenLocation = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:c24f1baa-4a26-b11b-a74f-f57e9fbc95f2
msgctxt "h5329d15cgd23fg4fcbgba3bge521be690391"
msgid "What did the goblins want with you?"
msgstr "고블린들이 당신한테 뭘 원한 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = c278b769-09e1-6d9a-8c9d-c6217f56b726
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:c278b769-09e1-6d9a-8c9d-c6217f56b726
msgctxt "h71bd2cdbg6933g4453gae13gfb439f96e407"
msgid "<i>Wait.</i>"
msgstr "<i>기다린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = c29c9cc3-00bc-1044-c21a-a61738aac4a9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - GLO_Tadpole_SUB_Druid.LearnedBear(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:c29c9cc3-00bc-1044-c21a-a61738aac4a9
msgctxt "h6acd85e5g1867g4eaeg991cg2260b7d3657d"
msgid ""
"Halsin? I... I don't know. He changed into a bear, but... I lost sight of "
"him. I don't know if he's s-still alive."
msgstr ""
"할신? 저... 저도 몰라요. 곰으로 변신하는 건 봤는데... 그 이후는 본 적이 없어요. 그가 지-지금 살아있는지도 모른다고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = c4026f3a-e08c-bb71-4981-b27455ca4f99
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_TorturedAdventurer_LeftInChains(1) = True
#.     - GOB_TorturedAdventurer_Knows_FailedPersuade(1) = True
#.   Global:
#.     - GOB_TorturedAdventurer_State_FailedPersuasion = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:c4026f3a-e08c-bb71-4981-b27455ca4f99
msgctxt "h735ee115g44b3g484egba1bg73c98978f6ad"
msgid "Are you mad? Just... just leave, please!"
msgstr "정신이 나간 거예요? 그냥... 그냥 떠나세요, 제발요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Narrator
#. NodeID = c5d2888c-4888-65d4-b5cd-7b3ba18b4590
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_TorturedAdventurer_Event_RemoveHealingPot = True
#.   Object:
#.     - GOB_TorturedAdventurer_State_Faint(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:c5d2888c-4888-65d4-b5cd-7b3ba18b4590
msgctxt "h4aee8676gba4cg435cgac03g138ccda0ad13"
msgid ""
"*The man coughs hard, but his eyes shoot open and the colour returns to his "
"cheeks.*"
msgstr "*남자는 기침을 심하게 하지만, 눈이 번쩍 뜨이고 뺨에 색이 돌아옵니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = c6206edc-f13b-c161-a5d9-10cd28a2eceb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:c6206edc-f13b-c161-a5d9-10cd28a2eceb
msgctxt "h72f33327g1351g4264g857agadfc22f8160b"
msgid "This wasn't supposed to happen. It should have been easy..."
msgstr "일이 이렇게 됐으면 안 됐어요. 쉬운 일이었어야 했는데..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = c816bb78-bf06-ecd1-268e-885f476c4cac
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Torturers_State_PrisonerFreed = True
#.   Local:
#.      - 6621e6ea-f89e-a19d-e8dc-6e6bc0779404_AskedQuestions = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:c816bb78-bf06-ecd1-268e-885f476c4cac
msgctxt "h60fbdb85gd6cdg4998gae95g1a52a1d2939a"
msgid "We shouldn't be seen together. I'll get to the grove on my own."
msgstr "우리가 함께 있는 모습을 보여선 안 돼요. 숲까지는 저 혼자 갈게요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = ca6acb3e-a015-d9ac-031d-0dc3eef8532c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_AdventurersQuest_Knows_AboutBounty = True
#.   Quest:
#.     - SHA_Nightsong.HeardOf(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:ca6acb3e-a015-d9ac-031d-0dc3eef8532c
msgctxt "h8ae40194g2d15g4a97g9f71g8be87709c948"
msgid ""
"He j-just said some wizard called Lorroakan would reward us if we found it. "
"That's all!"
msgstr "그가 말, 말하길 로로아칸이라는 위저드가 그걸 찾으면 우리에게 보상을 준다고 했댔어요. 그게 다예요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = cb089804-b60d-3d62-59be-2f155280e271
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_AdventurersQuest_Knows_AboutSH = True
#.      - GOB_TorturedAdventurer_Knows_WasLookingForSH = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:cb089804-b60d-3d62-59be-2f155280e271
msgctxt "h4dd89a2fg7240g44abgae43g69d92cfd134e"
msgid "You came looking for the Nightsong, didn't you?"
msgstr "당신은 밤의 노래를 찾으러 온 것 아닌가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = cf12425f-ecb4-d917-fed0-77a6b6509339
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:cf12425f-ecb4-d917-fed0-77a6b6509339
msgctxt "h28921fa2gd3f1g4a0cg8eaaga8d04c537242"
msgid "I don't know. The boss didn't say."
msgstr "전 몰라요. 대장이 말해 주지 않았거든요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = cfc53348-59bc-d3b5-0cca-f61d5ebd949d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:cfc53348-59bc-d3b5-0cca-f61d5ebd949d
msgctxt "hfc832d54ge3a3g451bgaac4g48af51be1b67"
msgid "What else do you know about the temple? Any other treasure?"
msgstr "이 신전에 대해 더 알고 있는 건 없나? 다른 보물이라도 있어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = d16b8396-1846-fd8b-66ba-710273b2404b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:d16b8396-1846-fd8b-66ba-710273b2404b
msgctxt "ha76bf745g0a17g4676ga451g366eb5a6d3a8"
msgid "T-two..."
msgstr "두-둘..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = d282dd13-390e-2a50-470f-e74c3fc2a165
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_AdventurersQuest_Knows_AboutSH = True
#.     - GOB_TorturedAdventurer_Knows_WasLookingForSH = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:d282dd13-390e-2a50-470f-e74c3fc2a165
msgctxt "h14e9c37dg662dg4791ga10dgf4f88ad11cdc"
msgid ""
"... b-but they ambushed us. I didn't think a pack of goblins could be so... "
"so efficient."
msgstr "... 하-하지만 놈들이 매복하고 있었어요. 전 고블린 무리가 그렇게... 효율적으로 행동할지 몰랐어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = d2b21d93-0ccc-3b8f-d70d-3c1f59281898
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_TorturedAdventurer_ToldAboutMap(1) = False
#.   Global:
#.      - GOB_TorturedAdventurer_Knows_WasLookingForSH = True
#. SetFlags:
#.   Dialog:
#.     - GOB_TorturedAdventurer_ToldAboutMap(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:d2b21d93-0ccc-3b8f-d70d-3c1f59281898
msgctxt "hbce2c64fg35edg4b3fgb07ag1604e590dd64"
msgid "You mentioned the Nightsong. Where can I find it?"
msgstr "밤의 노래란 걸 말했었잖아. 그건 어디서 찾을 수 있지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = d618e5b0-5586-88e4-10e7-56c46592910b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:d618e5b0-5586-88e4-10e7-56c46592910b
msgctxt "h33cde999g5978g4752g8d69g7f73dcda9cec"
msgid "Th-they didn't hide it. I don't think they even kn-know it exists."
msgstr "그-그들이 숨긴 게 아니에요. 애초에 그게 조-존재하는지 알지도 못하는 것 같아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = d76d3119-96ee-838b-bf47-2cd7501ed76e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_HappyTorturers_Knows_PlayersKnowDenLocation = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:d76d3119-96ee-838b-bf47-2cd7501ed76e
msgctxt "hb2874fc1g96aeg4446g8404g7d8eddbc7697"
msgid "What did the goblins want with you?"
msgstr "고블린들이 당신한테 뭘 원한 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = d996d4c6-d1df-24bd-23df-2c7b997d8ef4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:d996d4c6-d1df-24bd-23df-2c7b997d8ef4
msgctxt "hea170dcdgdd68g4073gb9e6g60299955905b"
msgid "Where are the goblins hiding it?"
msgstr "고블린들이 그걸 어디에 숨기고 있지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = dae90c4e-5885-e034-a94a-69038c15c6da
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 6621e6ea-f89e-a19d-e8dc-6e6bc0779404_MindHasBeenRead = True
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:dae90c4e-5885-e034-a94a-69038c15c6da
msgctxt "h01394855gbc06g4203ga385gccfaf88fdd32"
msgid ""
"<i>Why won't she leave? I need to warn the others... and find Remira, if "
"she's still alive.</i>"
msgstr "<i>왜 떠나질 않는 거야? 다른 이들에게 경고해 줘야 해... 그녀가 살아있다면, 레미라도 찾고.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = dae90c4e-5885-e034-a94a-69038c15c6da
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Local:
#.     - 6621e6ea-f89e-a19d-e8dc-6e6bc0779404_MindHasBeenRead = True
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:dae90c4e-5885-e034-a94a-69038c15c6da
msgctxt "h2064d2f8g348cg46e3ga684g1ef86a5391f4"
msgid ""
"<i>Why won't he leave? I need to warn the others... and find Remira, if "
"she's still alive.</i>"
msgstr "<i>왜 떠나질 않는 거야? 다른 이들에게 경고해 줘야 해... 그녀가 살아있다면, 레미라도 찾고.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = dae90c4e-5885-e034-a94a-69038c15c6da
#. HandlePath = TaggedText[2].TagText[0]
#. SetFlags:
#.   Local:
#.     - 6621e6ea-f89e-a19d-e8dc-6e6bc0779404_MindHasBeenRead = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:dae90c4e-5885-e034-a94a-69038c15c6da
msgctxt "h106e9afbg943dg4954gbde8g2e9cb6aeed08"
msgid ""
"<i>Why won't they leave? I need to warn the others... and find Remira, if "
"she's still alive.</i>"
msgstr "<i>왜 떠나질 않는 거야? 다른 이들에게 경고해 줘야 해... 그녀가 살아있다면, 레미라도 찾고.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = dc02d206-640a-c007-822e-ab8042ac2a8c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
