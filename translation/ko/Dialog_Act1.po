msgctxt "h4c909a0agf5d9g44a0gabf8g43d0480f72fa"
msgid "<i>Give him the bag.</i>"
msgstr "<i>그에게 배낭을 준다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Player
#. NodeID = 97628475-7690-73a4-e1d3-bf345854bed5
#. HandlePath = TaggedText[0].TagText[0]
