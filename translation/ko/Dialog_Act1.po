msgctxt "h56db73c6gb4d5g4012ga674gcbe7485f225f"
msgid "I'll take care of it."
msgstr "내가 해결하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarLoyalSergeant
