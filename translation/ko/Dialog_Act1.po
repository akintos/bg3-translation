msgctxt "h3bde0a65ga2d0g4b14ga5d0gebdb86e3333f"
msgid "Sorry for this, but I tried warnin' you."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_AlarmUsedReaction
#. Speaker = Sentinel Olak
#. NodeID = 10456647-b708-8855-0cf4-4947189b5c03
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_AlarmUsedReaction:10456647-b708-8855-0cf4-4947189b5c03
msgctxt "hf590fbd5g1863g4d92gbfb7g38c7abd131a8"
msgid ""
"Don't worry - seein' how you made us dance, I won't let 'em kill ya - "
"<i>this</i> time."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_AlarmUsedReaction
#. Speaker = Sentinel Olak
#. NodeID = 13bc9770-d3a5-054b-4e3b-4f96ad7ec25e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_AlarmUsedReaction:13bc9770-d3a5-054b-4e3b-4f96ad7ec25e
msgctxt "h0547ad8eg4dbfg48d1gbc94g27668cda7fb2"
msgid ""
"Hah! Lads, looks like this idiot just went and raised the alarm on "
"<i>theirselves!</i>\n"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_AlarmUsedReaction
