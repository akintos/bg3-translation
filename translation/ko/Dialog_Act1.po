msgctxt "h496f04e6gc2d9g4823g8b46g4dc4656b600d"
msgid "*The spell's power wanes. You can ask no more questions.*"
msgstr "*주문의 힘이 약해집니다. 더 이상 질문을 할 수 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_005_Dead
#. Speaker = Player
#. NodeID = 3ece0bfd-c74c-b574-2ad3-05b1ff819a02
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_005_Dead:3ece0bfd-c74c-b574-2ad3-05b1ff819a02
msgctxt "h94320afage9b6g45b2g85beg7c59ce16139b"
msgid "Is there anything I should know about this place?"
msgstr "이 장소에 대해 알아야 할 게 있나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_005_Dead
#. Speaker = Blinded Elf
#. NodeID = 561c7b8b-f68c-c1aa-f663-6bd96ed18eb9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_005_Dead:561c7b8b-f68c-c1aa-f663-6bd96ed18eb9
msgctxt "hbe85a899gbe97g4315gb4cegdf11923e0cec"
msgid "They didn't like... me having something... they couldn't touch."
msgstr "그들은 싫어했어... 그들이 손댈 수 없는 것을... 내가 갖는 걸..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_005_Dead
#. Speaker = Blinded Elf
#. NodeID = 63379841-a95e-1c48-e117-a9544150eeec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_005_Dead:63379841-a95e-1c48-e117-a9544150eeec
msgctxt "h385c8f47g2af1g4ed2gba52g94bbebfa5417"
msgid "My family took her... my baby girl..."
msgstr "내 가족이 그녀를 데려갔어... 내 딸을..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_005_Dead
#. Speaker = Player
#. NodeID = 71a04451-0e91-f630-9286-734129054700
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 7256657b-1386-989f-0262-c6530e03a9fb_AskedWhy = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_005_Dead:71a04451-0e91-f630-9286-734129054700
msgctxt "h09c4cc34g401fg4782ga54cg28a0b57f2d82"
msgid "Why did your family take your child?"
msgstr "왜 가족이 네 아이를 데려갔지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_005_Dead
#. Speaker = Blinded Elf
#. NodeID = 731ecc5b-276b-3851-a9cd-486f2e73bc84
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_005_Dead:731ecc5b-276b-3851-a9cd-486f2e73bc84
#, fuzzy
msgctxt "hc25b557dg5951g497bg90e3g1be2f3a851e5"
msgid "Doesn't matter... nothing matters... without... baby girl..."
msgstr "...상관없어... 아무것도... 내... 딸 없이는..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_005_Dead
#. Speaker = Player
#. NodeID = 7b809aa8-2100-10b5-1fb4-f787dd63c87a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_005_Dead:7b809aa8-2100-10b5-1fb4-f787dd63c87a
msgctxt "h9a47ac15gca11g4398ga92ag3c99358c9ec3"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_005_Dead
#. Speaker = Narrator
#. NodeID = 81f945e1-9662-2807-c67f-7b72ea0ea007
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_005_Dead:81f945e1-9662-2807-c67f-7b72ea0ea007
msgctxt "ha42f53c3g5af3g47b9ga6b3g99fe66f418d6"
msgid "*The corpse does not stir. It will answer no more questions.*"
msgstr "*시체는 움직이지 않습니다. 더 이상 질문을 받지 않을 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_005_Dead
#. Speaker = Blinded Elf
#. NodeID = 960096c9-598f-11e1-0820-cc1c498f5f3c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 7256657b-1386-989f-0262-c6530e03a9fb_AskedWhy = False
#. SetFlags:
#.   Local:
#.     - 7256657b-1386-989f-0262-c6530e03a9fb_AskedWhy = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_005_Dead:960096c9-598f-11e1-0820-cc1c498f5f3c
msgctxt "h293d1912g87dbg4c54g984dg55c327d372c5"
msgid ""
"Told Ethel... never wanted... to see them again... she... took my eyes..."
msgstr "에텔에게 말했어... 다시는 그들을 보고 싶지 않다고... 그녀가... 내 눈을 가져가버렸어..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_005_Dead
#. Speaker = Blinded Elf
#. NodeID = ac3eb873-67f5-eb94-36c2-a67cd3d7e41d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_005_Dead:ac3eb873-67f5-eb94-36c2-a67cd3d7e41d
msgctxt "h931a523agb479g4ce9g8eb9g3a69dcb3c06a"
msgid "Pretended she... never existed..."
msgstr "마치 그녀가 존재했던 적이 없다는 듯이..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_005_Dead
#. Speaker = Player
#. NodeID = b0d10144-a68d-d469-c6fb-99043d08dd5d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_005_Dead:b0d10144-a68d-d469-c6fb-99043d08dd5d
msgctxt "h5fb5bc4bg5cb1g4335g9d4bg775f62e925e7"
msgid "Why did you go to the hag?"
msgstr "왜 해그를 찾아갔지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_005_Dead
#. Speaker = Blinded Elf
#. NodeID = b4022f52-5ab6-f514-63e4-00969800096b
