msgctxt "h90d6bc79gbf48g496fga3a8g65302c853074"
msgid ""
"*Your blood runs quicker, feeding the gnawing absence at the centre of your "
"mind.*"
msgstr "*피가 더 빨리 흐르면서, 당신의 정신 한가운데를 좀먹는 허전함을 양분으로 채웁니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Player
#. NodeID = 54bdf2ab-b1d3-76e9-305d-db995f21c681
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:54bdf2ab-b1d3-76e9-305d-db995f21c681
msgctxt "h62639841g12a3g4127gabf0gfae0aa3f6a0c"
msgid "<i>Follow the goblin's orders and kneel down - for now.</i>"
msgstr "<i>당장은 고블린의 명령을 따라 무릎을 꿇는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Narrator
#. NodeID = 55708f42-e40f-6402-9708-55da04c5ba47
#. HandlePath = TaggedText[0].TagText[0]
