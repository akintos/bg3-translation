msgctxt "hcb21f844gd2fag4f66gbbbfg187ab3b2a4c3"
msgid "And where can I find Mol?"
msgstr "몰은 어디서 찾을 수 있지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_General_Dead_SnakeKid
#. Speaker = Arabella
#. NodeID = 7687bc1f-8e4a-7354-77b2-d5e78e49c971
