msgctxt "h7f6244c8ga5f3g471fg885bgfc196cd603c2"
msgid "These flowers - what is this feeling?"
msgstr "이 꽃들 - 이 느낌은 뭐지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_SussurTree_PAD_Aura
