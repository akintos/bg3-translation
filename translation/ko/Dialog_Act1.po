msgctxt "h728df328g9a7eg4201g8daag259d46cc3d47"
msgid "Something's got this lava stirred up."
msgstr "뭔가 이 용암을 끓어오르게 하고 있군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_MonkAmulet_PAD_EnteredLavaLake
