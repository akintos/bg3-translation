msgctxt "h4486dd4cgf345g43d5g932bg27c2c73960ec"
msgid ""
"Murmath? Is that the guy who keeps telling everyone about his useless, "
"hideous spiders?"
msgstr "무르마스? 자기 끔찍하고 쓸모없는 거미 이야기를 하고 다니는 그 사람 말이야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Otan
#. NodeID = 12ad93ee-ddc4-b1ca-1f06-2b6a44af12c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:12ad93ee-ddc4-b1ca-1f06-2b6a44af12c1
msgctxt "h6d55010cg5d7eg4d3dg8f6eg01fa3013f77e"
msgid "Disdain..."
msgstr "무시..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Player
#. NodeID = 12c2160a-edfb-456f-8083-776bf6bd44e1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:12c2160a-edfb-456f-8083-776bf6bd44e1
msgctxt "hd2aa00deg2007g43f3gbff6g0ce29650d56e"
msgid "Hey! Knock it off, the lot of you!"
msgstr "이봐! 그만둬, 너희 다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
