msgctxt "h690f00b9gff40g4c80g8e36g8023fbe52240"
msgid "I cannot see you. M-aster? Speak."
msgstr "당신이 보이지 않는군요, 주-인님? 말씀하세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Ornate Mirror
#. NodeID = 27230e7f-ddab-2f1d-3f12-049617515531
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:27230e7f-ddab-2f1d-3f12-049617515531
msgctxt "hec5b57b4g7d05g45fcgb429g53875191b693"
msgid "Speak your n-ame."
msgstr "이-름을 말하라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Ornate Mirror
#. NodeID = 2bb16737-5ae3-304d-6609-ee3c2a866a16
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:2bb16737-5ae3-304d-6609-ee3c2a866a16
msgctxt "he3fe33ecgfdd2g48b9g9917g0b3e52e1cffb"
msgid "You seek to sur-vive. You seek power."
msgstr "살-아남길 원하는 구나. 힘을 찾고 있네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Player
#. NodeID = 2f988215-df17-d442-ae35-65a9edc58e39
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Object:
#.      - FOR_ThayanCellar_Event_TriedToTrick(1) = False
#. SetFlags:
#.   Object:
#.     - FOR_ThayanCellar_Event_TriedToTrick(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:2f988215-df17-d442-ae35-65a9edc58e39
msgctxt "he34563a5g3ab1g421agaa2eg60c84ae121aa"
msgid "ILYN. TOTH."
msgstr "<b>일린. 토쓰.</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Ornate Mirror
#. NodeID = 302dff5d-84bb-c2bb-d691-e3113397c49d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:302dff5d-84bb-c2bb-d691-e3113397c49d
msgctxt "h47b6edf8g60d0g486ag9d5dg39d12919c38f"
msgid "Very w-ell."
msgstr "아주 좋-다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Narrator
#. NodeID = 385e3b0a-8907-0d25-4d08-dbe5d145e9d5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SORCERER(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:385e3b0a-8907-0d25-4d08-dbe5d145e9d5
msgctxt "hb5ab3820g9c91g4fa6gac94g8e17078ce81f"
msgid "*An enchanted mirror. Raw magic leashed to a bauble. Almost sad.*"
msgstr "*마법 걸린 거울입니다. 날것의 마법이 싸구려 장식품에 묶여 있습니다. 거의 슬플 지경이네요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Player
#. NodeID = 3ae1d6bf-dd73-47d4-2681-8ac961265068
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FOR_ThayanCellar_Event_TriedToTrick(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:3ae1d6bf-dd73-47d4-2681-8ac961265068
msgctxt "h777acc50gbafbg4dbdgbda4ge64b04b6d766"
msgid "Yes, an ally! I'm an ally of your master's."
msgstr "그래, 동맹! 난 네 주인의 동맹이라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Narrator
#. NodeID = 3d412bce-cbb0-6d58-0c4b-a176bfe25563
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - FOR_ThayanCellar_State_NoReflection(1) = True
#. SetFlags:
#.   Object:
#.     - FOR_ThayanCellar_State_NoReflection(1) = False
#.     - FOR_ThayanCellar_State_CheckReflection(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:3d412bce-cbb0-6d58-0c4b-a176bfe25563
msgctxt "hf2d1b1b2g924fg453bg9d84gfce6f508d2f7"
msgid "*Alas, all you see is empty space. The mirror reflects nothing.*"
msgstr "*안 됐군요, 텅 빈 공간밖에 보이지 않습니다. 거울은 아무 것도 반사하지 않습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Player
#. NodeID = 411389af-ded9-013c-7573-88d1aae6c17e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 10
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:411389af-ded9-013c-7573-88d1aae6c17e
msgctxt "he37fa056g95e2g445dg9a03gbf906da1339a"
msgid "<i>Sniff the mirror, trying to understand the nature of its magic.</i>"
msgstr "<i>거울의 냄새를 맡고, 그 마법의 본질에 대해 이해하려 시도해본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Player
#. NodeID = 411389af-ded9-013c-7573-88d1aae6c17e
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 10
#. TagRule: WARLOCK or WIZARD
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:411389af-ded9-013c-7573-88d1aae6c17e
msgctxt "ha3158e05g5445g42ceg839ag1e1d1fdb76ae"
msgid "<i>Examine the mirror, trying to understand its magic.</i>"
msgstr "<i>거울을 살펴보고, 그 마법에 대해 이해하려 시도해본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Player
#. NodeID = 411389af-ded9-013c-7573-88d1aae6c17e
#. HandlePath = TaggedText[2].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 10
#. TagRule: SORCERER
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:411389af-ded9-013c-7573-88d1aae6c17e
msgctxt "h665e9e69ga7eag44c7gb5e0g815d4a37b17b"
msgid "<i>Try to sense the magic tamed within the mirror.</i>"
msgstr "<i>거울에 깃든 마법을 느끼려 시도해본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Player
#. NodeID = 452a0f9b-3266-4015-e383-26a91550f623
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:452a0f9b-3266-4015-e383-26a91550f623
msgctxt "hd13bce8cgf717g448dgb347g3bc15d3626c5"
msgid "He's a great and powerful leader."
msgstr "강력하고 위대한 지도자이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Ornate Mirror
#. NodeID = 4778453f-6bd8-5b15-9af7-a381a868387c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:4778453f-6bd8-5b15-9af7-a381a868387c
msgctxt "h77afb345gf929g4427g9565gfcea58c7d51c"
msgid "If you are his ally, ste-p forward and declare it."
msgstr "네가 그의 동맹이라면, 앞으로 나-와서 당당히 말하라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Player
#. NodeID = 49f2f1ae-1e12-d643-a023-28b2173aa20d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GENERIC(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:49f2f1ae-1e12-d643-a023-28b2173aa20d
msgctxt "h9326b04cge041g4bfbg8d4ag06e6f1eea43b"
msgid "I'd see the ones I love."
msgstr "내가 사랑하는 이들을 보고 싶다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Player
#. NodeID = 4e3f54fa-4ef2-0d00-4720-3721de10e6fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:4e3f54fa-4ef2-0d00-4720-3721de10e6fe
msgctxt "h7740f85ag348eg4813gb2eagfd9321226ce6"
msgid "I don't have time for games. Let me pass."
msgstr "장난칠 시간 없어. 들여보내 줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Player
#. NodeID = 5fb5e3bd-a368-e75a-7763-e6e3cd573bf5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GENERIC(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:5fb5e3bd-a368-e75a-7763-e6e3cd573bf5
msgctxt "h0c5c7975g8f57g4ef5gafe6g33b642b6d989"
msgid "I'd see my enemies suffering."
msgstr "내 적들이 고통받는 모습을 보고 싶다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Ornate Mirror
#. NodeID = 623872d5-b019-1816-ab5c-290e81b5157e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:623872d5-b019-1816-ab5c-290e81b5157e
msgctxt "h32ea54bcg83bcg4e51ga01cg4df8fa10eca0"
msgid "Weak."
msgstr "약하구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Narrator
#. NodeID = 6b9166aa-4975-eb25-4c2a-6479b2ff33cd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_ThayanCellar_Event_StartTrap = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:6b9166aa-4975-eb25-4c2a-6479b2ff33cd
msgctxt "h6dcccdd4gb2ecg43ddga656geef9ac369809"
msgid "*The mirror is not amused.*"
msgstr "*거울은 즐거워하지 않습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Player
#. NodeID = 6cdd2c25-d744-b83d-fa1b-3f550e23f5d7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GENERIC(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:6cdd2c25-d744-b83d-fa1b-3f550e23f5d7
msgctxt "h0b7071edgd437g4de0g8467g05a2796d882b"
msgid "I'd look for whatever spell will rid me of this worm in my head."
msgstr "내 머릿속에 있는 벌레를 없앨 수 있는 어떤 주문이라도 찾을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Ornate Mirror
#. NodeID = 6f0e0fde-6705-da94-a76d-8b647958294b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_ThayanCellar_Knows_WizardName = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:6f0e0fde-6705-da94-a76d-8b647958294b
msgctxt "h7ce5581bgf2fcg4908gae3dg2f501e331bf0"
msgid "Only a t-rue ally of Ilyn Toth may pass."
msgstr "일린 토쓰의 진-정한 동맹만이 지나갈 수 있다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Player
#. NodeID = 6f2a579e-9ffa-4afc-61fb-305c07ee57a6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GALE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:6f2a579e-9ffa-4afc-61fb-305c07ee57a6
msgctxt "h18fabab6gbe24g4cbcg8562gf480a419c904"
msgid "Balsam disinfects wounds. Surely everyone knows that?"
msgstr "발삼은 상처를 소독하지. 다 아는 사실 아닌가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Ornate Mirror
#. NodeID = 7185b631-641c-503b-9330-91f8c8f592f7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:7185b631-641c-503b-9330-91f8c8f592f7
msgctxt "hb3a43ab2ge43bg47d4g803bgf84d2d5bd15a"
msgid "Wise."
msgstr "현명하구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Narrator
#. NodeID = 71f17a8f-89ae-7df9-7dbf-f443bfa5e1f5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GALE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:71f17a8f-89ae-7df9-7dbf-f443bfa5e1f5
msgctxt "h5c48ea92g768ag4006g93fag43fd01d87ba2"
msgid "*A magic mirror. A primitive contraption, but not without its use.*"
msgstr "*마법의 거울입니다. 구식 장치이지만, 쓸모가 있긴 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Player
#. NodeID = 74a102d2-8ddd-2cdb-cc4b-bd018b888b8a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:74a102d2-8ddd-2cdb-cc4b-bd018b888b8a
msgctxt "h59824be2g0c1bg482cga44bg310a1724ad30"
msgid "To clear a rash?"
msgstr "발진을 없애는 데 쓰나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Player
#. NodeID = 8247bb6f-fc98-0456-fc48-2f010787882e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:8247bb6f-fc98-0456-fc48-2f010787882e
msgctxt "ha959c3f2g9bfcg46b5g8b1bg6a9114403d71"
msgid "I'd see my enemies suffering."
msgstr "내 적들이 고통받는 모습을 보고 싶다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Ornate Mirror
#. NodeID = 8ceeab7a-51f5-8310-3540-32621a6ad4fa
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_ThayanCellar_Event_StartTrap = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:8ceeab7a-51f5-8310-3540-32621a6ad4fa
msgctxt "h3ef4e7dbg3a34g4ed7g9289g1bce60167a46"
msgid "I think n-ot."
msgstr "그렇지 않-다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Ornate Mirror
#. NodeID = 8e87d02b-bd89-0803-0762-0faaa212191b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:8e87d02b-bd89-0803-0762-0faaa212191b
msgctxt "h27088745g8ef2g420fga9b9ge3fcd73433c8"
msgid "What is your n-ame?"
msgstr "네 이-름은 무엇인가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Narrator
#. NodeID = 8fc6a2ce-3a8a-24f6-0d56-6ff8f98fc860
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(1) = True
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:8fc6a2ce-3a8a-24f6-0d56-6ff8f98fc860
msgctxt "h227f2b62g00e9g4775g8af9gee5e0e538c78"
msgid "*Lacking any evidence to the contrary, you assume you look amazing.*"
msgstr "*반대되는 증거가 없으므로, 당신은 당신이 참 잘생겼다고 가정합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Player
#. NodeID = 907db520-7f35-5b4b-4813-013ac698d618
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:907db520-7f35-5b4b-4813-013ac698d618
msgctxt "hfae6a406g5228g4f99gb5c9g917ec348ffe0"
msgid "I know how this goes. 'Magic mirror, tell me true...'"
msgstr "나 이거 알아. '거울아, 거울아...'"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Narrator
#. NodeID = 9384501c-3379-b595-8854-4176a685a32a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:9384501c-3379-b595-8854-4176a685a32a
msgctxt "h4000efdbg33bfg437agad5fga592f24bbeda"
msgid ""
"*Szass Tam is a powerful lich that rules the land of Thay. He drove many Red "
"Wizards out of their ancestral home.*"
msgstr "*스자스 탐은 테이를 다스리는 강력한 리치입니다. 많은 수의 레드 위저드가 선조의 고향에서 쫓겨난 것도 그 때문입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Player
#. NodeID = 94eeaa6e-a779-3710-b9f9-3fe58a6f0558
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SORCERER(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:94eeaa6e-a779-3710-b9f9-3fe58a6f0558
msgctxt "he742efbeg69d6g4a97g9985gd1289e1c45a1"
msgid ""
"Nothing - you're a thing of magic. I can shatter this prison for you, if you "
"wish."
msgstr "아무 것도. 넌 마법의 존재야. 네가 원한다면 이 감옥을 산산조각내줄 수 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Player
#. NodeID = 9bf50e3a-8ae7-e635-1958-8f19005179f5
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Object:
#.      - FOR_ThayanCellar_Event_TriedToTrick(1) = False
#.   Tag:
#.      - BARD(1) = False
#. SetFlags:
#.   Object:
#.     - FOR_ThayanCellar_Event_TriedToTrick(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:9bf50e3a-8ae7-e635-1958-8f19005179f5
msgctxt "h16341de2g5a8eg4167ga1dbgaf99ec81b5cb"
msgid ""
"I think seven years' bad luck sounds like a fair trade for smashing you."
msgstr "너를 박살내고 칠 년 동안 불운을 떠안는 건 꽤 공정한 거래 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Ornate Mirror
#. NodeID = 9f3bc53f-12d5-fe89-1248-c2a21389519a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:9f3bc53f-12d5-fe89-1248-c2a21389519a
msgctxt "h0620f34fg7681g44d7g9bcfg8a4cf6fb65f4"
msgid "Now. Sp-eak."
msgstr "이제. 말-해라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Player
#. NodeID = a0b09546-419e-a920-091a-7bf873b97fbf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:a0b09546-419e-a920-091a-7bf873b97fbf
msgctxt "hd2b0bfbegf7abg497fgbacfgd21536d4767b"
msgid "Szass Tam is a foul, wretched creature."
msgstr "스자스 탐은 불결하고 끔찍한 괴물이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Player
#. NodeID = a2ab48aa-7ebb-b1f3-e349-7135cc832ec8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_ThayanCellar_Knows_WizardName = True
#. SetFlags:
#.   Object:
#.     - FOR_ThayanCellar_State_CheckReflection(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:a2ab48aa-7ebb-b1f3-e349-7135cc832ec8
msgctxt "hcc24340ag02b4g4dc3gb9c6gf4668dd21a4e"
msgid "<i>Repeat the name from the book you read: 'Ilyn Toth'.</i>"
msgstr "<i>책에서 읽은 이름을 읊는다. '일린 토쓰'.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Narrator
#. NodeID = a6a8a0c7-dd7a-4123-7735-6d178ef83223
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - FOR_ThayanCellar_State_NoReflection(1) = False
#. SetFlags:
#.   Object:
#.     - FOR_ThayanCellar_State_CheckReflection(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:a6a8a0c7-dd7a-4123-7735-6d178ef83223
msgctxt "h35efc282g637ag45d3ga503g2e3e22b12266"
msgid ""
"*You do your best to wipe the dirt from your face and look presentable. "
"Adventuring is murder on one's wardrobe, though.*"
msgstr "*당신은 얼굴의 때를 최대한 닦아내어 조금 단정해 보이려 노력합니다. 하지만 모험은 멋 내는 데 별로 도움이 되지는 않습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Player
#. NodeID = a95fd804-04f4-924c-5646-6843a933ba63
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   User:
#.     - FOR_ThayanCellar_MagicMirror_PissedOffMirror(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:a95fd804-04f4-924c-5646-6843a933ba63
msgctxt "h590a591cg3793g49f8gababgf573e0c75ed4"
msgid "...'Magic mirror, tell me true, show my fortune, known by few.'"
msgstr "'...거울아, 거울아, 진실을 알려주렴, 내 운세를 보여다오.'"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Ornate Mirror
#. NodeID = ac02a7aa-4356-fd9d-3a6c-5a61b8879f6b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:ac02a7aa-4356-fd9d-3a6c-5a61b8879f6b
msgctxt "h81ca019bg97dag4100g9433gd551fadb503d"
msgid "T-tell me, why might one use balsam ointment?"
msgstr "마-말해라. 발삼 연고를 쓰는 이유는 무엇인가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Ornate Mirror
#. NodeID = af272ec4-f6f0-bd1c-d62c-995a6d7efe04
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:af272ec4-f6f0-bd1c-d62c-995a6d7efe04
msgctxt "hf9f2b39dg8effg4ee1ga3e8gdf5d38fde6e0"
msgid ""
"If you are known to my mas-ter, step forward and de-clare yourself an ally."
msgstr "내 주인을 알고 있다면, 앞으로 나와서 동맹임을 밝-혀라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Player
#. NodeID = b48f782d-c5ec-9131-f3f7-09d117630cf5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_ThayanCellar_Quest_ReadDoctorLog = False
#.   Tag:
#.      - RANGER(1) = False
#.      - REALLY_GALE(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:b48f782d-c5ec-9131-f3f7-09d117630cf5
msgctxt "h2e256825g2712g408bgad21gdc935f6f5c9f"
msgid "To clean a wound?"
msgstr "상처 소독하는 데 쓰나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Ornate Mirror
#. NodeID = b5700006-8b72-2f0d-0024-d758498e8226
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:b5700006-8b72-2f0d-0024-d758498e8226
msgctxt "h24ccd005g1e3cg4becgb2afg750b1d6c6885"
msgid "I do no-t know this name."
msgstr "난 이 이름을 모른-다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Player
#. NodeID = b9831285-bb02-ecb5-d9ed-345d23104d35
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_ThayanCellar_Knows_BalsamTreatsBurns = True
#. SetFlags:
#.   Global:
#.     - FOR_ThayanCellar_Event_SaidWrongAnswer = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:b9831285-bb02-ecb5-d9ed-345d23104d35
msgctxt "hbc5a6e5ag07aag4468gbd0bga8b252b05bb1"
msgid "I spoke to the quasit. It treats burns."
msgstr "콰지트와 얘기했지. 화상 치료제라고 하더군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Narrator
#. NodeID = bccfab4f-ba5b-a641-064b-1ab8e1afcef1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:bccfab4f-ba5b-a641-064b-1ab8e1afcef1
msgctxt "hacd3cd34gda53g45f4gb504g8df6488c4da8"
msgid ""
"*The magic is old and wavering, but you recognise it. The mirror is a "
"thinking lock, hiding some secret.*"
msgstr "*마법은 오래됐고 약해지고 있지만, 당신은 그걸 알아볼 수 있습니다. 비밀을 숨기고 있는, 생각하는 자물쇠입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Player
#. NodeID = c04312d0-0671-c41b-7a1b-b79ce949872b
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_GALE or WIZARD
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:c04312d0-0671-c41b-7a1b-b79ce949872b
msgctxt "h9e0a5501gcd8eg49ecg9233g7f058fa0e407"
msgid "Actually, Szass Tam isn't a zulkir - he rules as High Regent now."
msgstr "엄밀히 말해서 스자스 탐은 줄키르가 아니야. 지금은 고위 섭정으로서 통치하고 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Ornate Mirror
#. NodeID = c118293a-ea41-1fcb-54f5-fb31ebb47432
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - FOR_ThayanCelar_MagicMirror_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:c118293a-ea41-1fcb-54f5-fb31ebb47432
msgctxt "hff70ee48gb563g4f8agacd5gdd22fda03d89"
msgid "You are not my mast-er."
msgstr "넌 나의 주-인이 아니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Ornate Mirror
#. NodeID = c17eb382-9874-5310-0e38-801c61531001
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:c17eb382-9874-5310-0e38-801c61531001
msgctxt "hff30506cg8378g411bg8388g7abfd13aeae4"
msgid "You are no zulkir. B-ut are you wise?"
msgstr "너는 줄키르가 아니다. 하-지만 현명할까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Player
#. NodeID = c535c2ee-bf0a-6cdc-df80-50db55a83848
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:c535c2ee-bf0a-6cdc-df80-50db55a83848
msgctxt "h6a4676e0g862ag4641gac6ag2b20ce90574f"
msgid "He's as fine a zulkir as ever lived!"
msgstr "그는 지금껏 살아온 훌륭한 줄키르지!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Player
#. NodeID = c5b01751-3bde-d32a-a117-b6e05ed809c6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GENERIC(1) = False
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:c5b01751-3bde-d32a-a117-b6e05ed809c6
msgctxt "h731540a8gcc56g4aa5g9de2ged152e02a022"
msgid ""
"I'd see my home. My <i>real </i>home - the one I haven't seen in centuries."
msgstr "내 집을 보고 싶다. <i>진짜</i> 집 말이야. 수백 년 동안 보지 못했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Player
#. NodeID = c5b01751-3bde-d32a-a117-b6e05ed809c6
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GENERIC(1) = False
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:c5b01751-3bde-d32a-a117-b6e05ed809c6
msgctxt "hd7ce4de0gedc2g44dbga25eg5012d60ae81a"
msgid "I'd see a wizard tower. A safe haven for me and a sweetheart - forever."
msgstr "위저드 타워를 보고 싶다. 나와 내 연인이 영원토록 쉴 수 있는 안식처 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Player
#. NodeID = c5b01751-3bde-d32a-a117-b6e05ed809c6
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GENERIC(1) = False
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:c5b01751-3bde-d32a-a117-b6e05ed809c6
msgctxt "h4a978002g3648g41e0g90bcgfa240df6fa76"
msgid ""
"I'd see my folks in our house in the Outer City. Mince pies on the window "
"sill. Perfect."
msgstr "외부 도시에 있는 내 집에서 가족들을 보고 싶다. 창턱에 올려 둔 민스 파이도. 완벽해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Player
#. NodeID = c5b01751-3bde-d32a-a117-b6e05ed809c6
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GENERIC(1) = False
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:c5b01751-3bde-d32a-a117-b6e05ed809c6
msgctxt "h7a27d37eg90b0g419cgaf33gd69a05db561a"
msgid "I'd gaze upon Vlaakith in the grand city of Tu'narath."
msgstr "Tu'narath의 웅장한 도시에서 블라키스 님을 올려다보고 싶다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Player
#. NodeID = c5b01751-3bde-d32a-a117-b6e05ed809c6
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GENERIC(1) = False
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:c5b01751-3bde-d32a-a117-b6e05ed809c6
msgctxt "he521da50g7668g4be4g87c9ge5bea1962d77"
msgid "I have no memory of my parents - I'd like to see them, at least once."
msgstr "난 부모님에 대한 기억이 없다. 한 번만이라도, 보고 싶어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Player
#. NodeID = c5b01751-3bde-d32a-a117-b6e05ed809c6
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GENERIC(1) = False
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:c5b01751-3bde-d32a-a117-b6e05ed809c6
msgctxt "h040ff8bag3fc5g4e9egbfacg1ab121ff598d"
msgid "I would see my father - his arms extended in forgiveness."
msgstr "두 팔을 벌린 채 용서해 주시는 아버지를 보고 싶다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Ornate Mirror
#. NodeID = c9ce8dfb-26cf-8a35-b3da-2d96de6113be
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:c9ce8dfb-26cf-8a35-b3da-2d96de6113be
msgctxt "h5ea92c85gc780g4e73gaab4g6dd127b29010"
msgid "But y-ou cared to ask. No others ever did. Th-ank you."
msgstr "하지만 너-는 신경써서 물어봐주었다. 아무도 그렇게 해준 적 없다. 고-맙다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Player
#. NodeID = d4cab845-a273-b0d2-73a1-de38516e56f1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FOR_ThayanCellar_State_CheckReflection(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:d4cab845-a273-b0d2-73a1-de38516e56f1
msgctxt "hcce3781cg20d7g49a8g8419g4cb64dc6368a"
msgid "<i>Examine your appearance.</i>"
msgstr "<i>자신의 외모를 살펴본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Player
#. NodeID = d67f36f2-df32-ab2e-8614-9bb94f9fca41
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:d67f36f2-df32-ab2e-8614-9bb94f9fca41
msgctxt "hc74cb1e8g22fbg49feg96b2gd89170062918"
msgid "<i>Step back and say nothing.</i>"
msgstr "<i>물러서서 아무 말도 하지 않는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Narrator
#. NodeID = d8df4d31-29ba-a131-f46f-7df6f5ec641c
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_GALE or WIZARD
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:d8df4d31-29ba-a131-f46f-7df6f5ec641c
msgctxt "h6ce92e35g1405g4f23g9b3dgf4ec459e9b75"
msgid ""
"*You recognise the name, of course - anyone that knows of the Red Wizards "
"would.*"
msgstr "*당연하게도, 당신은 그 이름을 알고 있습니다. 레드 위저드에 대해 알고 있다면 다 아는 이름입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Player
#. NodeID = d8f9c880-7686-b46a-1b4a-b475eed1b80f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GENERIC(1) = False
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:d8f9c880-7686-b46a-1b4a-b475eed1b80f
msgctxt "h6e24c0aag688fg4b31g8048g8195f6015ea5"
msgid ""
"I'd see how to safely keep the powers this mind flayer's worm has given me."
msgstr "마인드 플레이어의 벌레가 내게 준 힘을 안전하게 간직하는 방법을 보고 싶다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Player
#. NodeID = d8f9c880-7686-b46a-1b4a-b475eed1b80f
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GENERIC(1) = False
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:d8f9c880-7686-b46a-1b4a-b475eed1b80f
msgctxt "hc53b32c1g3338g467cga76cg36ddb758c51f"
msgid ""
"I'd see myself in my next incarnation: a living manifestation of Netherese "
"magic. A mythal in my own right."
msgstr "네더릴 마법의 살아있는 화신이 된 나의 다음 형태를 보고 싶어. 나만의 강력한 마법 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Player
#. NodeID = d8f9c880-7686-b46a-1b4a-b475eed1b80f
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GENERIC(1) = False
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:d8f9c880-7686-b46a-1b4a-b475eed1b80f
msgctxt "h2400d5a3g190ag4bf8g8476g00d5b03cb7d7"
msgid ""
"I'd see myself whole again. <i>My </i>heart beating away in my chest. And "
"Zariel's head on a pike for good measure."
msgstr "나 자신을 다시 보고 싶다. 덤으로, <i>내 </i> 가슴에서 심장이 뛰고, 자리엘의 머리가 파이크에 꽂혀있기를 바란다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Player
#. NodeID = d8f9c880-7686-b46a-1b4a-b475eed1b80f
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GENERIC(1) = False
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:d8f9c880-7686-b46a-1b4a-b475eed1b80f
msgctxt "ha7607b87g70a3g49a2gac7bg504c119597cf"
msgid ""
"I'd see myself as a <i>kith'rak</i>: <i>ghaik</i> head in one hand, silver "
"sword in the other."
msgstr ""
"<i>키스‘락</i>이 된 내 모습을 보고 싶다. 한 손에는 <i>게이크</i> 머리통을 들고, 다른 한 손에는 은검을 든 모습을."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Player
#. NodeID = d8f9c880-7686-b46a-1b4a-b475eed1b80f
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GENERIC(1) = False
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:d8f9c880-7686-b46a-1b4a-b475eed1b80f
msgctxt "h33678b68g1d80g41afgbdd1g0202dea92b3e"
msgid "I'd see myself as Shar's Chosen, with all her power at my disposal."
msgstr "샤의 선택받은 자가 되어 그녀의 힘을 마음대로 쓰는 내 모습을 보고 싶다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Player
#. NodeID = d8f9c880-7686-b46a-1b4a-b475eed1b80f
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GENERIC(1) = False
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:d8f9c880-7686-b46a-1b4a-b475eed1b80f
msgctxt "h77f53ed3gaf9dg44ecg8bdcgc023b3ebf148"
msgid "I'd see Mizora, cowering before me and begging my mercy."
msgstr "미조라가 내 앞에 몸을 숙여 자비를 부르짖는 모습을 보고 싶다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Narrator
#. NodeID = d93bca10-1e94-9c92-4daf-ed6f7a4e5b3a
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: WIZARD
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:d93bca10-1e94-9c92-4daf-ed6f7a4e5b3a
msgctxt "hf6d0205agf32eg4782g8504g851711b93e38"
msgid ""
"*You remember reading a history of Thay. Szass Tam is a powerful lich who "
"rules that land and drove out the Red Wizards that opposed him.*"
msgstr ""
"*테이의 역사에 대해 읽은 기억이 납니다. 스자스 탐은 테이를 다스리는 강력한 리치이고, 그에 반하는 레드 위저드들을 다 몰아냈습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Narrator
#. NodeID = d93bca10-1e94-9c92-4daf-ed6f7a4e5b3a
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:d93bca10-1e94-9c92-4daf-ed6f7a4e5b3a
msgctxt "habfda161gb14cg4cffgbf94gb8c388b22f57"
msgid ""
"*You remember stories of Szass Tam - a powerful lich in Thay who made deals "
"with dark gods.*"
msgstr "*스자스 탐의 이야기가 기억이 납니다. 어둠의 신들과 거래를 한 테이의 강대한 리치이죠.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Player
#. NodeID = db257253-802c-9bf0-7beb-763809f4c66d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_ThayanCellar_Quest_ReadDoctorLog = False
#. TagRule: CLERIC_GOOD or CLERIC_NEUTRAL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:db257253-802c-9bf0-7beb-763809f4c66d
msgctxt "h4f728a43g53d8g4bfdga60egc8704aefab0a"
msgid "Balsam is a common disinfectant."
msgstr "발삼은 소독제로 흔히 쓰이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Narrator
#. NodeID = dd1148cd-f896-695d-23b9-b99f161d8726
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WIZARD(1) = True
#.      - REALLY_GALE(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:dd1148cd-f896-695d-23b9-b99f161d8726
msgctxt "h99a637b8g2430g440dg8b2cg006abb853f57"
msgid ""
"*A magic mirror! You've read all about them, but never seen one up close "
"before.*"
msgstr "*마법의 거울이라니! 책에서 읽은 적은 있지만, 이렇게 가까이에서 보는 건 처음입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Player
#. NodeID = de1e53d1-ff3a-2c94-7686-dd27626e87d2
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Object:
#.      - FOR_ThayanCellar_Event_TriedToTrick(1) = False
#. SetFlags:
#.   Object:
#.     - FOR_ThayanCellar_Event_TriedToTrick(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:de1e53d1-ff3a-2c94-7686-dd27626e87d2
msgctxt "h94b2a9fdg6297g4a12g88c4g111219ec006c"
msgid "Open or I'll smash you to pieces - bad luck be damned."
msgstr "열지 않으면 산산조각내주겠다. 불운 따윈 알 바 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Ornate Mirror
#. NodeID = de9b365b-9279-5470-2e47-eccf65c958f7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:de9b365b-9279-5470-2e47-eccf65c958f7
msgctxt "h8632e821g5af0g46b1gbc40gdfe473f3bee2"
msgid "...if you could see an-ything in me, what w-ould it be?"
msgstr "...내게서 무엇-이든 볼 수 있다면, 어떤 것을 보고 싶-은가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Ornate Mirror
#. NodeID = dfbfd7db-839e-6d08-9f87-8337a4ae58fa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - FOR_ThayanCellar_State_NoReflection(1) = False
#. SetFlags:
#.   Global:
#.     - FOR_ThayanCellar_Knows_WizardName = True
#.   Object:
#.     - FOR_ThayanCellar_State_CheckReflection(1) = False
#. TagRule: DWARF or GNOME or HALFLING
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:dfbfd7db-839e-6d08-9f87-8337a4ae58fa
msgctxt "h34b0bdebg9556g4f24g9e43ga473d271e49f"
msgid "My master stands t-all and proud. You are not Ilyn Toth."
msgstr "나의 주인은 키가 크고 당-당하다. 너는 일린 토쓰가 아니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Ornate Mirror
#. NodeID = dfbfd7db-839e-6d08-9f87-8337a4ae58fa
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Object:
#.      - FOR_ThayanCellar_State_NoReflection(1) = False
#. SetFlags:
#.   Global:
#.     - FOR_ThayanCellar_Knows_WizardName = True
#.   Object:
#.     - FOR_ThayanCellar_State_CheckReflection(1) = False
#. TagRule: UNDERDARK
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:dfbfd7db-839e-6d08-9f87-8337a4ae58fa
msgctxt "h74b05478gcb8fg43f1g9bb8g6ac0aadabf4b"
msgid "I see you were shaped by d-arkness, not light. You are not Ilyn Toth."
msgstr "네가 빛이 아닌, 어-둠 속에서 만들어진 존재인 것이 보인다. 너는 일린 토쓰가 아니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Ornate Mirror
#. NodeID = dfbfd7db-839e-6d08-9f87-8337a4ae58fa
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Object:
#.      - FOR_ThayanCellar_State_NoReflection(1) = False
#. SetFlags:
#.   Global:
#.     - FOR_ThayanCellar_Knows_WizardName = True
#.   Object:
#.     - FOR_ThayanCellar_State_CheckReflection(1) = False
#. TagRule: HALFELF or HALFORC
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:dfbfd7db-839e-6d08-9f87-8337a4ae58fa
msgctxt "ha841b413g6c37g47e2gac06g36eb28e7ed26"
msgid "My master is no filthy half-breed. You are not Ilyn Toth."
msgstr "나의 주인은 더러운 혼혈이 아니다. 너는 일린 토쓰가 아니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Ornate Mirror
#. NodeID = dfbfd7db-839e-6d08-9f87-8337a4ae58fa
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Object:
#.      - FOR_ThayanCellar_State_NoReflection(1) = False
#. SetFlags:
#.   Global:
#.     - FOR_ThayanCellar_Knows_WizardName = True
#.   Object:
#.     - FOR_ThayanCellar_State_CheckReflection(1) = False
#. TagRule: HUMAN
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:dfbfd7db-839e-6d08-9f87-8337a4ae58fa
msgctxt "h75fc9b58g1af9g4212g933cg39714cdbe68c"
msgid "I know my m-aster's face. You are not Ilyn Toth."
msgstr "나는 내 주-인의 얼굴을 알고 있다. 너는 일린 토쓰가 아니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Ornate Mirror
#. NodeID = dfbfd7db-839e-6d08-9f87-8337a4ae58fa
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Object:
#.      - FOR_ThayanCellar_State_NoReflection(1) = False
#. SetFlags:
#.   Global:
#.     - FOR_ThayanCellar_Knows_WizardName = True
#.   Object:
#.     - FOR_ThayanCellar_State_CheckReflection(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:dfbfd7db-839e-6d08-9f87-8337a4ae58fa
msgctxt "h3c5c3c6cgdf86g4ca7gbe26g6ef46ba9ecd1"
msgid "My master was human, pure and true. You are not Ilyn Toth."
msgstr "내 주인은 진실로 순혈인 인간이었다. 너는 일린 토쓰가 아니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Player
#. NodeID = e346021f-7b2d-5489-dec4-b9279ac9b0ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:e346021f-7b2d-5489-dec4-b9279ac9b0ea
msgctxt "hda7e5b95g91dfg47ccgbcc7g8c69e34f279c"
msgid "I'm not your master."
msgstr "나는 네 주인이 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Player
#. NodeID = e47fce63-f6cb-8a27-93e8-3fe2852245dc
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_DWARF
