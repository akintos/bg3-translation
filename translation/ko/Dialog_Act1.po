#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerCharmed:05018964-92a4-0602-28a5-9e6fc53d548d
msgctxt "hc1ecf98agf31dg4b2egadf8ga8eaf9b250d3"
msgid "So beautiful. Like the whispers of the succubi."
msgstr "너무 아름다워. 마치 서큐버스가 속삭이는 것 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerCharmed
#. Speaker = Player
#. NodeID = 05018964-92a4-0602-28a5-9e6fc53d548d
