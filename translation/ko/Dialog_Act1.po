msgctxt "he8f80629gdfc2g49c8gb311g515fde27160c"
msgid "*The spell's power wanes. You can ask no more questions.*"
msgstr "*주문의 힘이 약해집니다. 더 이상 질문을 할 수 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Dead
#. Speaker = Fezzerk
#. NodeID = caf3fb27-4294-4dde-d219-a2d67b0afcbf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Dead:caf3fb27-4294-4dde-d219-a2d67b0afcbf
msgctxt "hf06b8137gcbdfg4061ga3d3g744268020b72"
msgid "The... <i>Towers</i>..."
msgstr "그... <i>타워</i>..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Dead
#. Speaker = Player
#. NodeID = cfbb8a33-f056-0d16-1a57-3f0c3ed619ec
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
