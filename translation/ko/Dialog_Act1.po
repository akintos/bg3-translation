#.     - GOB_GoblinWily_HasMet(1) = True
#. TagRule: DROWELF and FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinWily:69574f56-0623-4484-b697-315eb837e1e8
msgctxt "h96b0ebd3g3d2ag4853gafebg1eb2dd389ca3"
msgid "Look, yer ladyship. Priestess Gut burned me <i>good</i>."
msgstr "이것 보세요, 나리. 여사제 거트가 절 <i>제대로</i> 지져버렸다고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinWily
#. Speaker = Tracker Tozad
