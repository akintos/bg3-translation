msgid "Who's roundin' up the spiders?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WaitingStupid
#. Speaker = Sharp-Eye Eef
#. NodeID = 5ab1bba7-dd92-ba08-e643-8224bcd90f9b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WaitingStupid:5ab1bba7-dd92-ba08-e643-8224bcd90f9b
