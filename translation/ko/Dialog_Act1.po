msgctxt "h6a75d72cg0679g445ag9b26ga92d3a1160dd"
msgid "Erm, p-praise the Absolute. Always inspirin' to have a drow among us."
msgstr "으음, 절대자를 차-찬양하라. 드로우를 모시는건 늘 영광이죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinWily
#. Speaker = Tracker Tozad
#. NodeID = 50254d64-ce2e-0622-fb75-5fd64c063b40
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_GoblinWily_HasMet(1) = False
#.   Tag:
