#.     - e529a8c3-dba0-7ed1-d0a0-300172319d13_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_IrritatedTieflingTrainingAfterAttack:c6852342-5c87-ef14-7cd5-b037e272f8ab
msgctxt "h8fdbdb2dg020dg4837ga691g5a605d789a2d"
msgid "Hrah! Do you like that, Kagha?"
msgstr "흐라아! 맛이 어떠냐, 카그하?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_IrritatedTieflingTrainingAfterAttack
