msgctxt "h6a4c8f96gbf6cg4899g9b49g960ab148904b"
msgid "Impressive armour. Drow handiwork?"
msgstr "인상적인 갑옷이군. 드로우의 작품인가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_VB_DeadDrow1Armor
