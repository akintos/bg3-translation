msgctxt "he5b19b8cg3b9cg4092gb751g363a57362161"
msgid "AH! I was sure I had it that time."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_StatuePuzzle_PAD_HitWeakly
