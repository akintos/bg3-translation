msgctxt "h2da40163ga687g4fedgb357gb2a42ee43ea1"
msgid "It's that bloody mask. Take it off. <i>Now!</i>"
msgstr "그 빌어먹을 마스크다. <i>당장</i> 벗어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_ControlledByMask
#. Speaker = Karlach
#. NodeID = 5bdc8838-7d4e-4f46-8ad7-84bd5a816deb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_KARLACH(4) = True
