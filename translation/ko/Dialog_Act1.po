msgctxt "h461c07e0gda6eg4584gab6fgceec4e6d90b8"
msgid "And we stopped it. For now, that's all that matters."
msgstr "그리고 우리가 막았지. 지금으로선 그게 더 중요하다고 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance
#. Speaker = Player
#. NodeID = e027e933-1ef9-4ebd-853f-59618e71dbff
#. HandlePath = TaggedText[5].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance:e027e933-1ef9-4ebd-853f-59618e71dbff
msgctxt "h59f0a8e2g07a8g481dg9d08geb0edf23399e"
msgid "Does it matter? We managed to stop it."
msgstr "무슨 상관이야? 우리가 해결했잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_EnterGauntlet
