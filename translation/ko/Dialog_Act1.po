msgctxt "h6a52a56eg94aag4616gb9bagf13805736d16"
msgid "Seeking... reinforcements..."
msgstr "찾고 있었어... 지원군을..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7_Dead
#. Speaker = Gauntlet Dain
#. NodeID = 99512e56-1388-428c-b73e-379eb387deb1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7_Dead:99512e56-1388-428c-b73e-379eb387deb1
msgctxt "h0fae2bc3g3609g4559g94bbgb7ef742150a4"
msgid "Gauntlet... Dain..."
msgstr "건틀릿... 다인..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7_Dead
#. Speaker = Narrator
#. NodeID = ac964669-c053-448c-b5b8-306e07ce8b79
