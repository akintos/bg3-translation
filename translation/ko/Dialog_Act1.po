msgctxt "h204f8c81g666fg405fg8d74g8a8d8548970c"
msgid "Should've set him on fire the moment we caught him."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WolfPens_AD_Reinforcement003_CommentOnPrisonersBody
#. Speaker = Sharp-Eye Eef
#. NodeID = e5eafbe0-8e72-67aa-2e95-0efdf9fc17d3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WolfPens_AD_Reinforcement003_CommentOnPrisonersBody:e5eafbe0-8e72-67aa-2e95-0efdf9fc17d3
msgctxt "hfe75c286g04a5g4011ga19fg62a6c02b55c5"
msgid "Damned <i>booyahg</i>, bears turnin' into elves."
msgstr "망할 <i>부야그</i>, 곰들이 엘프들로 변하고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WolfPens_AD_Warning
#. Speaker = One
#. NodeID = 00589470-c48c-c7f5-4a8d-3005e34d6338
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_WolfPens_Backup_State_Swept = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WolfPens_AD_Warning:00589470-c48c-c7f5-4a8d-3005e34d6338
msgctxt "haa918c0dge24ag492cg8ec6g853685144803"
msgid "They're... they're all dead! Run!"
msgstr "다... 다 죽었어! 도망쳐!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WolfPens_AD_Warning
#. Speaker = One
#. NodeID = e2a91d84-a989-b1da-762d-56aa9446dba7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_WolfPens_Backup_State_Swept = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WolfPens_AD_Warning:e2a91d84-a989-b1da-762d-56aa9446dba7
msgctxt "hfe887543g9c37g4831g83b1g781a6e62671f"
msgid "Help! The bear - it got out!"
msgstr "도와줘! 저 곰이 탈출했어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WolfPens_AD_Warning_002
#. Speaker = Three
#. NodeID = 78b9d5f8-cae7-2166-767f-438b02ba1cbb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_WolfPens_Backup_State_Swept = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WolfPens_AD_Warning_002:78b9d5f8-cae7-2166-767f-438b02ba1cbb
msgctxt "ha63bdf30g80a0g4aacga4b6g00c039d0ad86"
msgid "The bear! The bear got out!"
msgstr "곰이다! 곰이 탈출했다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WolfPens_AD_Warning_002
#. Speaker = Three
#. NodeID = e8b70bbd-c13e-f0bf-e111-495e2d7f7823
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_WolfPens_Backup_State_Swept = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WolfPens_AD_Warning_002:e8b70bbd-c13e-f0bf-e111-495e2d7f7823
msgctxt "ha0102406g70e8g49f5gb308g1f5b61ef5e67"
msgid "Th-they're dead! W-we gotta hide!"
msgstr "그-그들이 죽었어! 우-우리 숨어야 해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GEB_GOB_EyeMurder_AD
#. Speaker = Dror Ragzlin
#. NodeID = 9c045e3e-a130-3592-0118-fccc157b2bfe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GEB_GOB_EyeMurder_AD:9c045e3e-a130-3592-0118-fccc157b2bfe
msgctxt "h32e3a15cg7d20g4978g9712g53409c3ab0bd"
msgid "'S dead. Spied one too many bowels movin', I expect."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_AbsoluteCultistAble
#. Speaker = Kagran
#. NodeID = 0de776af-c09d-854e-25ac-d4e18e1f9ffd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_AbsoluteCultistAble_HasMet(1) = True
#.   Global:
#.      - GOB_GoblinKing_Event_ScryingEnded = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_AbsoluteCultistAble:0de776af-c09d-854e-25ac-d4e18e1f9ffd
msgctxt "hc1ee558eg2216g43f2g8149g0d51169315aa"
msgid "An alien here in Faerûn... I can't believe it."
msgstr "페이룬에 외계인이 나타나다니... 믿을 수가 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_AbsoluteCultistAble
#. Speaker = Kagran
#. NodeID = 1c2256a1-77bd-03d7-f51c-e14507e432fa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_AbsoluteCultistAble:1c2256a1-77bd-03d7-f51c-e14507e432fa
msgctxt "h9b8c143ag001ag49c6g91dfgaf42cca72fde"
msgid "Someone needs to keep an eye on these buggers."
msgstr "이 자식들을 누군가는 감시해야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_AbsoluteCultistAble
#. Speaker = Player
#. NodeID = 2b4821ca-a87f-c875-07d7-cabbe4828ba4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_AbsoluteCulstist_Able_Knows_AskedQuestion(1) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_AbsoluteCulstist_Able_Knows_AskedQuestion(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_AbsoluteCultistAble:2b4821ca-a87f-c875-07d7-cabbe4828ba4
msgctxt "h38eb527cgdedag4438gb3d0ga79e62022cd1"
msgid "But goblins give you no pause?"
msgstr "그런데 고블린은 아무런 상관도 없어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_AbsoluteCultistAble
#. Speaker = Kagran
#. NodeID = 4c30b8a1-3bd4-5f72-a01f-be2d7894a09d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Absolute_Knows_Name = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_AbsoluteCultistAble:4c30b8a1-3bd4-5f72-a01f-be2d7894a09d
msgctxt "h2b4cd6f8gd8d0g48c5gbac3gb79fc3f09472"
msgid "I don't make a habit of questioning the Absolute. Now quiet."
msgstr "절대자의 지시에는 분명 뜻이 있을 거다. 이제 조용."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_AbsoluteCultistAble
#. Speaker = Kagran
#. NodeID = 63d07938-b75a-091f-556d-6ff8b5f6f082
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_AbsoluteCultistAble_HasMet(1) = False
#.   Global:
#.      - GOB_GoblinKing_Event_ScryingEnded = False
#. SetFlags:
#.   Dialog:
#.     - GOB_AbsoluteCultistAble_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_AbsoluteCultistAble:63d07938-b75a-091f-556d-6ff8b5f6f082
msgctxt "h6d533d0ag32d8g4101g96f3g1e74680efea1"
msgid "Shh. Let's hope this gives us some answers."
msgstr "쉿. 이게 우리에게 해답을 주길 기도하자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_AbsoluteCultistAble
#. Speaker = Player
#. NodeID = 6b53f8b4-14d8-d231-d9ce-497405ad7449
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_AbsoluteCultistAble:6b53f8b4-14d8-d231-d9ce-497405ad7449
msgctxt "h220650ecg808fg41a8gacd8g89cf104b2701"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_AbsoluteCultistAble
#. Speaker = Kagran
#. NodeID = 9d488957-1573-6dfa-cd49-09591cfe9e85
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Absolute_Knows_Name = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_AbsoluteCultistAble:9d488957-1573-6dfa-cd49-09591cfe9e85
msgctxt "h426b81dfgf931g4cfag8786g90abdb5768f3"
msgid "Of course, the Absolute protects us now, but still..."
msgstr "물론 절대자께서 우리를 보호하시긴 하지만, 그래도..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_AbsoluteCultistAble
#. Speaker = Kagran
#. NodeID = 9ec70109-63d4-1ea6-a223-0817ec347443
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_AbsoluteCultistAble_HasMet2(1) = True
#.   Global:
#.      - GOB_GoblinKing_Event_ScryingEnded = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_AbsoluteCultistAble:9ec70109-63d4-1ea6-a223-0817ec347443
msgctxt "h559155f7g67d1g4b12ga4cbgeb4404844ccd"
msgid "I'm glad it was dead when we found it."
msgstr "우리가 찾았을 때 죽어 있던 게 다행이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_AbsoluteCultistAble
#. Speaker = Kagran
#. NodeID = a492a8bd-aca7-dcca-c43f-7597e6ba5e57
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_AbsoluteCultistAble_HasMet2(1) = False
#.   Global:
#.      - GOB_GoblinKing_Event_ScryingEnded = True
#. SetFlags:
#.   Dialog:
#.     - GOB_AbsoluteCultistAble_HasMet2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_AbsoluteCultistAble:a492a8bd-aca7-dcca-c43f-7597e6ba5e57
msgctxt "h2e8a7536gfb14g4feag9a8eg15b9150c0403"
msgid ""
"That was... intense. Wouldn't want to bump into that thing while it was "
"still alive."
msgstr "방금 그건... 긴장됐네. 살아있을 때 만났으면 큰일 났겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_AbsoluteCultistAble
#. Speaker = Player
#. NodeID = f8e3f876-948c-0f3c-d96c-90ba5fc30ea6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_AbsoluteCulstist_Able_Knows_AskedQuestion(1) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_AbsoluteCulstist_Able_Knows_AskedQuestion(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_AbsoluteCultistAble:f8e3f876-948c-0f3c-d96c-90ba5fc30ea6
msgctxt "h5430d738g31c2g40d3gac93gbde5636f305b"
msgid "You really wouldn't."
msgstr "그럼 정말로 큰일이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_AbsoluteCultistStiff
#. Speaker = Narvass
#. NodeID = 0aa5394a-6ba0-d686-9168-bf6feea51ea5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_AbsoluteCultistStiff_HasMet(1) = False
#.   Global:
#.      - GOB_GoblinKing_Event_ScryingEnded = False
#. SetFlags:
#.   Dialog:
#.     - GOB_AbsoluteCultistStiff_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_AbsoluteCultistStiff:0aa5394a-6ba0-d686-9168-bf6feea51ea5
msgctxt "hea0ba743gc481g4487g918cg2498ee2390a5"
msgid "Silence. You'll interrupt the ritual."
msgstr "조용. 의식을 방해하잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_AbsoluteCultistStiff
#. Speaker = Narvass
#. NodeID = 6a529802-65f7-e0e7-176b-2190f75e8a78
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_AbsoluteCultistStiff_HasMet2(1) = False
#.   Global:
#.      - GOB_GoblinKing_Event_ScryingEnded = True
#. SetFlags:
#.   Dialog:
#.     - GOB_AbsoluteCultistStiff_HasMet2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_AbsoluteCultistStiff:6a529802-65f7-e0e7-176b-2190f75e8a78
msgctxt "hb68d29adgeed2g4850g885cg2eb9f24baaf6"
msgid ""
"I wouldn't dawdle if I were you. I doubt True Soul Minthara has much "
"patience left."
msgstr "나라면 그렇게 어물쩍거리지 않겠어. 참된 영혼 민타라가 오래 기다려 줄 것 같으냐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_AbsoluteCultistStiff
#. Speaker = Narvass
#. NodeID = 8f7c5944-012a-8a86-fb83-27267dd92b68
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_AbsoluteCultistStiff_HasMet(1) = True
#.   Global:
#.      - GOB_GoblinKing_Event_ScryingEnded = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_AbsoluteCultistStiff:8f7c5944-012a-8a86-fb83-27267dd92b68
msgctxt "hce910537g7210g4b3fg9265g8441b6f3e996"
msgid "Shhh. Try not to break his concentration. Again."
msgstr "쉬잇. 또냐. 집중하는 데 방해하지 마라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_AbsoluteCultistStiff
#. Speaker = Narvass
#. NodeID = e05031f9-002e-53e1-25ec-14a283b55e67
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_AbsoluteCultistStiff_HasMet2(1) = True
#.   Global:
#.      - GOB_GoblinKing_Event_ScryingEnded = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_AbsoluteCultistStiff:e05031f9-002e-53e1-25ec-14a283b55e67
msgctxt "hed4a3f17g21bbg46d6gba5bg1fc471b7c0ff"
msgid "A warning: do <i>not </i>disappoint Minthara."
msgstr "경고 하나 하지. <i>절대로</i> 민타라를 실망시키지 마라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_BattleStations_WarDrum
#. Speaker = Player
#. NodeID = 0c1de7ea-8838-13ec-3d20-a4e1cec6bc85
