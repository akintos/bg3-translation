#. SetFlags:
#.   Local:
#.     - 57c003e7-0932-6f0c-e655-99025a4abe3a_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_LookingForInstrument:d42db296-302b-1ada-099c-07e2fa93de95
msgctxt "h80915c56g1ac9g4b0egbf7bgf44741561d85"
msgid "I can't believe I lost it - I'm so <i>stupid. </i>"
msgstr "그걸 잃어버리다니. 나 왜 이리 <i>멍청하지?</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_QuitComposing
#. Speaker = Alfira
#. NodeID = 151786ae-c88e-3e72-6584-9e5534ba8154
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 145f29c2-661d-9bf6-6501-f3da72eed0ea_A = True
#. SetFlags:
#.   Local:
#.     - 145f29c2-661d-9bf6-6501-f3da72eed0ea_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_QuitComposing:151786ae-c88e-3e72-6584-9e5534ba8154
msgctxt "ha03c1a5agfc19g4180gb8e4g27bba32d0cda"
msgid "I could be a poet? <i>Urgh. </i>I'd probably be terrible at that too..."
msgstr "시인을 할까? <i>으으. </i> 그것도 잘 못하겠지..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_QuitComposing
#. Speaker = Alfira
#. NodeID = 560ec4cd-a3a4-a6c7-a806-4ac345c728a0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 145f29c2-661d-9bf6-6501-f3da72eed0ea_B = True
#. SetFlags:
#.   Local:
#.     - 145f29c2-661d-9bf6-6501-f3da72eed0ea_B = False
#.     - 145f29c2-661d-9bf6-6501-f3da72eed0ea_A = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_QuitComposing:560ec4cd-a3a4-a6c7-a806-4ac345c728a0
msgctxt "hcb111966g4831g48ccgace3g935541344473"
msgid "I have to do <i>something </i>in Baldur's Gate. But what?"
msgstr "발더스 게이트에서 <i>뭔가</i> 해야 해. 뭘 하지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_QuitComposing
#. Speaker = Alfira
#. NodeID = c84c562a-c3cf-8535-69fd-5919ccb285ec
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 145f29c2-661d-9bf6-6501-f3da72eed0ea_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_QuitComposing:c84c562a-c3cf-8535-69fd-5919ccb285ec
msgctxt "h1c7c32efg6912g411dg9e94ge77ada0e7821"
msgid "If not a bard, then an adventurer? No, I don't have the stomach for it."
msgstr "음유시인 말고, 모험가? 아니지, 그럴 배짱은 없고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_StartingOver
#. Speaker = Alfira
#. NodeID = ba905a3b-0966-dc8b-1626-72d2efdd5a84
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 3b604a3b-6f20-b1f0-0419-2bda8d88d565_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_StartingOver:ba905a3b-0966-dc8b-1626-72d2efdd5a84
msgctxt "he699228dgfac7g4677g8a6cg42df2147c300"
msgid "No. That's stupid."
msgstr "아냐. 바보 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_StartingOver
#. Speaker = Alfira
#. NodeID = bc71a835-5438-5928-f1f2-1caedfa663c5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3b604a3b-6f20-b1f0-0419-2bda8d88d565_A = True
#. SetFlags:
#.   Local:
#.     - 3b604a3b-6f20-b1f0-0419-2bda8d88d565_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_StartingOver:bc71a835-5438-5928-f1f2-1caedfa663c5
msgctxt "h3ad6877egd4efg423dgad21g63e9a2006d63"
msgid "That's even worse."
msgstr "더 안 좋아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_StartingOver
#. Speaker = Alfira
#. NodeID = e43fa1f5-94d8-5cf5-f6f2-222429c3027f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3b604a3b-6f20-b1f0-0419-2bda8d88d565_B = True
#. SetFlags:
#.   Local:
#.     - 3b604a3b-6f20-b1f0-0419-2bda8d88d565_A = False
#.     - 3b604a3b-6f20-b1f0-0419-2bda8d88d565_B = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_StartingOver:e43fa1f5-94d8-5cf5-f6f2-222429c3027f
msgctxt "h29bc1928gc77bg42aeg86dfga1a627c4e3ef"
msgid "Nope. I hate it all."
msgstr "아냐. 다 싫어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals
#. Speaker = Spar
#. NodeID = 0a741719-546b-d36d-77d0-9bb1759e7b18
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals:0a741719-546b-d36d-77d0-9bb1759e7b18
msgctxt "haeffa3adg829eg49ddg8f7cgb30929a01379"
msgid "Oh no! Whatever shall we do?"
msgstr "안 돼! 어떻게 해야 하지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals
#. Speaker = Corinna
#. NodeID = 0ea369ac-076f-f96d-d7d0-d5ca1cb11cd3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals:0ea369ac-076f-f96d-d7d0-d5ca1cb11cd3
msgctxt "h495fd2f5g6831g4427gbf0cga11ddad448da"
msgid "More witless creatures! More ear-bleed!"
msgstr "바보 같은 괴물들이 더 왔잖아! 귀에서 피가 더 나겠어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals
#. Speaker = Corinna
#. NodeID = 1511394e-d16a-f7f5-d232-a7860dec43e8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(2) = True
#. SetFlags:
#.   Global:
#.     - DEN_TieflingBard_State_SpokeToAnimals = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals:1511394e-d16a-f7f5-d232-a7860dec43e8
msgctxt "h42cbd950g4d6fg4e06g917eg9916b3f339e4"
msgid "It hurts! It hurts!"
msgstr "아파! 아파!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals
#. Speaker = Player
#. NodeID = 2ad5b48f-de48-4c1e-48ae-76135bd22762
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals:2ad5b48f-de48-4c1e-48ae-76135bd22762
msgctxt "h84eeb8beg15efg48d9g9653g838e0a9222dd"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals
#. Speaker = Spar
#. NodeID = 2b973a75-43f8-ee20-c9ac-8e1ecd893d96
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals:2b973a75-43f8-ee20-c9ac-8e1ecd893d96
msgctxt "ha92aa58bgd189g40f1ga5cagde126e82281f"
msgid "*Squeak. Squeak.*"
msgstr "*찍. 찍.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals
#. Speaker = Corinna
#. NodeID = 2fd25e41-f136-3a79-fc05-135ffc0060f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals:2fd25e41-f136-3a79-fc05-135ffc0060f0
msgctxt "hd5d1dd2dgb728g4024gb63agec0b39829c15"
msgid "Unlike <i>some</i>."
msgstr "<i>누구</i>랑은 다르네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals
#. Speaker = Player
#. NodeID = 32a84455-6d11-0d56-c2c3-f181fe1993c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals:32a84455-6d11-0d56-c2c3-f181fe1993c8
msgctxt "hbe710521g7baeg4474gba98ge6d78f6b7009"
msgid "Shhh - you're ruining the song."
msgstr "쉬잇 - 네가 노래를 망치고 있잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals
#. Speaker = Spar
#. NodeID = 597fb95b-5768-2530-82be-3952528c14c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals:597fb95b-5768-2530-82be-3952528c14c4
msgctxt "hb187332ag9571g4d5fga845gf84404292e09"
msgid "You're killing us!"
msgstr "우릴 죽이고 있어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals
#. Speaker = Spar
#. NodeID = 6fb40539-4e6b-02eb-b3aa-dd8df89b5c3e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals:6fb40539-4e6b-02eb-b3aa-dd8df89b5c3e
msgctxt "h28f848f2g48d4g48afgbe23g6acc58a0a892"
msgid "Of course - we are born performers."
msgstr "물론이지, 우린 타고난 공연자라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals
#. Speaker = Corinna
#. NodeID = 7eab882a-cfdd-adfb-48c2-8fad54089228
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals:7eab882a-cfdd-adfb-48c2-8fad54089228
msgctxt "h80966688g8f74g48d1gae18g86c798d9e3ba"
msgid "Away, away!"
msgstr "꺼져, 꺼져!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals
#. Speaker = Corinna
#. NodeID = 82c71665-adbc-3189-1081-e4ee7551ca0a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals:82c71665-adbc-3189-1081-e4ee7551ca0a
msgctxt "h9f443027ge157g48e1ga2e4gb98302cb0fbd"
msgid "Noooo!"
msgstr "안 돼애애!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals
#. Speaker = Player
#. NodeID = 86ba5695-7715-21fc-6110-629ab14aa17b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(2) = True
#. TagRule: REALLY_TIEFLING or TIEFLING
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals:86ba5695-7715-21fc-6110-629ab14aa17b
msgctxt "h93fd05bbgeadbg4c8dg9d68g5cd60c9d08b3"
msgid ""
"<i>Sing along with them, improvising lyrics: 'How can we stop this dreadful "
"song, this half-formed verse from leaden tongue?'</i>"
msgstr "<i>따라서 같이 부르며 가사를 지어낸다. '어찌하면 멈출까 대참사인 노래, 내 귀가 썩어가는 대재앙을 초래?'</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals
#. Speaker = Player
#. NodeID = 86ba5695-7715-21fc-6110-629ab14aa17b
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(2) = True
#. TagRule: !()
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals:86ba5695-7715-21fc-6110-629ab14aa17b
msgctxt "h82234428g6550g4040gb6dag81f23a5f3a95"
msgid ""
"<i>Sing along with them, improvising lyrics: 'How can we stop this dreadful "
"song, half-formed verse from devil's tongue?'</i>"
msgstr "<i>따라서 같이 부르며 가사를 지어낸다. '어찌하면 멈출까 데빌의 저 노래, 내 귀가 썩어가는 대재앙을 초래?'</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals
#. Speaker = Player
#. NodeID = 87a57c3a-40b2-7678-7915-29cee542b85b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals:87a57c3a-40b2-7678-7915-29cee542b85b
msgctxt "he563c3bfga924g4692g9bf5gbb3fd321b16e"
msgid "Bravo. You could go on tour, with talent like that."
msgstr "브라보. 그런 실력이면 순회 공연을 다녀도 되겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals
#. Speaker = Corinna
#. NodeID = 9438c05f-35cd-583d-e167-ee31d8c10eab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals:9438c05f-35cd-583d-e167-ee31d8c10eab
msgctxt "h8bc6b7b1g9c81g4e9dgbfd7g20262d695afb"
msgid "With my last strength, I will save us both! Away. Away."
msgstr "내 마지막 힘을 짜내서, 우리 둘 다 구하겠어! 꺼져. 꺼져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals
#. Speaker = Corinna
#. NodeID = 96f10689-0c0b-e098-1767-ddbca5e48a04
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals:96f10689-0c0b-e098-1767-ddbca5e48a04
msgctxt "h0ca05957ga1fag45e1g8c4cge10476870e3f"
msgid "Can't you hear it?"
msgstr "들리지 않는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals
#. Speaker = Player
#. NodeID = 99fea8ba-5079-fe42-7d6d-868142059855
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals:99fea8ba-5079-fe42-7d6d-868142059855
msgctxt "h777c5b6agd3f2g47dagab74g19551b0fb12d"
msgid "Shut up - I want to hear the bard."
msgstr "닥쳐 - 바드 목소리를 듣고 싶으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals
#. Speaker = Spar
#. NodeID = 9e5fd943-728c-6b3e-ec0f-03d4b8bd1948
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals:9e5fd943-728c-6b3e-ec0f-03d4b8bd1948
msgctxt "hf44d145dg506eg44a1ga47fg92d20f3abd99"
msgid "We'll save you, poor soul."
msgstr "널 구해줄게, 불쌍한 영혼아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals
#. Speaker = Player
#. NodeID = a38c2baf-5f34-cdfc-63f5-946213e19b6c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals:a38c2baf-5f34-cdfc-63f5-946213e19b6c
msgctxt "hc9c63b3cg5274g44f9g9f0egc1ba983c938b"
msgid "It <i>is </i>quite a racket. You could just spare your ears by leaving."
msgstr "<i>완전 </i>소음이야. 네 귀를 생각해서 떠나는 게 좋을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals
#. Speaker = Corinna
#. NodeID = a93445f3-f1e2-75b1-83d8-1f603d7f45c2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals:a93445f3-f1e2-75b1-83d8-1f603d7f45c2
msgctxt "h2f496e64g3bedg446egbe56g6c7d1f8f3a61"
msgid "My head is melting! I'm leaving before the damage is <i>permanent.</i>"
msgstr "내 머리가 녹는 것 같아! <i>영구적인</i> 손상을 입기 전에 떠나야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals
#. Speaker = Spar
#. NodeID = acf913dc-7972-df81-30e3-3b7b00bd923c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals:acf913dc-7972-df81-30e3-3b7b00bd923c
msgctxt "h349bf543g1512g4eb4g9161g084b955d7c77"
msgid "Terrible!"
msgstr "끔찍해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals
#. Speaker = Corinna
#. NodeID = adc5ac0b-f301-f3dd-2f4b-8a26a50ff856
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals:adc5ac0b-f301-f3dd-2f4b-8a26a50ff856
msgctxt "hb2eb945fg953eg4d6cg8dfag01f50778e9d2"
msgid "We can't! Our brains are melting!"
msgstr "못 버티겠어! 우리 뇌가 녹아내리는 것 같아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals
#. Speaker = Player
#. NodeID = b0086a05-f618-1172-3c73-47dd2c0f3f84
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals:b0086a05-f618-1172-3c73-47dd2c0f3f84
msgctxt "h7797e284gfc72g49e3gab4agf89aab6b4718"
msgid "<i>Sing along with the bard - as loudly and off-key as you can.</i>"
msgstr "<i>바드를 따라 노래를 부른다. 최대한 음정을 틀리게 부른다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals
#. Speaker = Spar
#. NodeID = b034cfdf-1f6f-618b-b89d-66bcd86fc635
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals:b034cfdf-1f6f-618b-b89d-66bcd86fc635
msgctxt "h57d959e2g8873g4d65g83d8g00b7d24d4917"
msgid "Yes, yes - that's it!"
msgstr "그래, 그래 - 바로 그거야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals
#. Speaker = Player
#. NodeID = b17c1f0f-f092-9a08-7faa-97f453d5ffbf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals:b17c1f0f-f092-9a08-7faa-97f453d5ffbf
msgctxt "hc1a46212g06d3g4d65ga8b3g6297152dcb90"
msgid "Slow down - what's wrong?"
msgstr "진정해 - 뭐가 문제야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals
#. Speaker = Player
#. NodeID = b8ee2697-ad35-1dc6-95c1-d88dfe7f3aac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals:b8ee2697-ad35-1dc6-95c1-d88dfe7f3aac
msgctxt "hcf4314fcg1704g4741ga205g7232965f5298"
msgid "Don't mock her - she's trying her best... I assume."
msgstr "너무 그녀를 비난하지 마 - 그녀는 최선을 다하고 있다고... 아마도."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals
#. Speaker = Corinna
#. NodeID = bc7900b5-9690-3fe8-58c4-c7a2a9a212f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals:bc7900b5-9690-3fe8-58c4-c7a2a9a212f0
msgctxt "hef919254g3be4g4adag8625ged1327c76132"
msgid "Her singing - it's awful!"
msgstr "그녀의 노래 말이야 - 끔찍해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals
#. Speaker = Narrator
#. NodeID = c021322d-1dd5-d1f8-9b93-7c0347942d2e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals:c021322d-1dd5-d1f8-9b93-7c0347942d2e
msgctxt "h7d74d7c0g48bag4a50g938bg97327eb31b57"
msgid ""
"*The critters start a duet of their own, attempting to drown out the bard's "
"music. They look at you expectantly.*"
msgstr "*조그마한 녀석들이 바드의 노래를 묻으려는 듯, 같이 듀엣을 부르기 시작합니다. 뭔가 기대에 한껏 들뜬 채 당신을 바라봅니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals
#. Speaker = Corinna
#. NodeID = cd1ca577-8a65-0219-964c-329679e97bea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals:cd1ca577-8a65-0219-964c-329679e97bea
msgctxt "hb2f6feedg4ab3g41acgb693g7575c275183c"
msgid ""
"Finally, a song to set our heads straight after that <i>display. </i>We "
"should leave, before the effect wears off."
msgstr "마침내, 그 <i>끔찍한 </i>노래를 잊을만한 노래군. 빨리 효과가 사라지기 전에 떠나야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals
#. Speaker = Corinna
#. NodeID = d19c91b4-1a5a-a8ec-03d5-4171eb0003e5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals:d19c91b4-1a5a-a8ec-03d5-4171eb0003e5
msgctxt "h07a49cc3g1979g45c2g9054gcec68a740234"
msgid "*Screech!*"
msgstr "*끼이익!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals
#. Speaker = Spar
#. NodeID = d9faeb00-ac75-9a6d-6985-1e78f484976b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals:d9faeb00-ac75-9a6d-6985-1e78f484976b
msgctxt "h0c961513g0dd6g40e0g9557gbd4ee1f2090b"
msgid "Please, make it stop!"
msgstr "제발, 멈춰줘!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals
#. Speaker = Player
#. NodeID = e48f40c7-c84a-dfdc-d739-5418ded4eea5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(2) = True
#. TagRule: REALLY_TIEFLING or TIEFLING
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals:e48f40c7-c84a-dfdc-d739-5418ded4eea5
msgctxt "h3aa2f156g8c89g4f32g8df3g1878aabb89d0"
msgid ""
"<i>Sing for them, improvising lyrics: 'How can we stop this dreadful song, "
"this half-formed verse from leaden tongue?'</i>"
msgstr ""
"<i>그들에게 즉흥적으로 가사를 지어내 노래를 불러준다. '어찌하면 멈출까 대참사인 노래, 내 귀가 썩어가는 대재앙을 초래?'</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals
#. Speaker = Player
#. NodeID = e48f40c7-c84a-dfdc-d739-5418ded4eea5
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(2) = True
#. TagRule: !()
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals:e48f40c7-c84a-dfdc-d739-5418ded4eea5
msgctxt "h959c32c2g47d1g4c3cga5f8ga551ef861088"
msgid ""
"<i>Sing for them, improvising lyrics: 'How can we stop this dreadful song, "
"half-formed verse from devil's tongue?'</i>"
msgstr ""
"<i>그들에게 즉흥적으로 가사를 지어내 노래를 불러준다. '어찌하면 멈출까 데빌의 저 노래, 내 귀가 썩어가는 대재앙을 초래?'</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals
#. Speaker = Spar
#. NodeID = edd86559-883c-3f49-24ea-a93512258292
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals:edd86559-883c-3f49-24ea-a93512258292
msgctxt "h72f46df2ge12dg4e4cga7f5gf3f5d7436b37"
msgid ""
"Corinna, drag me away! The big one is right - we should go, before it's too "
"late."
msgstr "코리나, 날 끌어내 줘! 이 커다란 녀석 말이 맞아, 너무 늦기 전에 떠나야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals
#. Speaker = Corinna
#. NodeID = ffaa83fe-d928-ffe1-a7e0-ab8bb59fff4a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Animals:ffaa83fe-d928-ffe1-a7e0-ab8bb59fff4a
msgctxt "h5ca53c60g4f57g4e12gadfdg614d5c19a812"
msgid "Don't you think it's awful?"
msgstr "끔찍한 것 같지 않아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = 01f423d1-696c-c922-8737-efb8538cc689
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:01f423d1-696c-c922-8737-efb8538cc689
msgctxt "h28682cbeg5a67g4e37gb7f8g5421e7ba9023"
msgid "You're holding yourself back. Start over with a blank slate."
msgstr "너무 자신을 억제하고 있잖아. 백지에서 다시 시작해 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 04561393-efe1-f642-3d0b-def076c1a5ea
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_TieflingBard_Event_SmashedLute(1) = True
#.   Global:
#.     - DEN_TieflingBard_State_SmashedLute = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:04561393-efe1-f642-3d0b-def076c1a5ea
msgctxt "hfde1837ag6bf3g4e24g95d1gcbc7311fe02e"
msgid ""
"What did you do?! My teacher gave me that! And she - and she's <i>dead</i>, "
"you bastard."
msgstr "무슨 짓이야?! 선생님이 주신 건데! 그분 돌아가셨단 말야, 개자식아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 08b52c30-f4a3-2da1-e832-30835e245d9b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_TieflingBard_Event_TransferInstrument(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:08b52c30-f4a3-2da1-e832-30835e245d9b
msgctxt "h1aff71f8gc882g4879gb396gfe281c6ac344"
msgid ""
"Look, erm, I really appreciate the help. But I think I should continue on my "
"own. Thanks anyway."
msgstr "저기, 도와줘서 고맙지만 내가 알아서 하는 게 좋겠어요. 아무튼 고마워요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = 0aa1eac1-ead0-ded8-f45b-bd43e6b2d9e8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:0aa1eac1-ead0-ded8-f45b-bd43e6b2d9e8
msgctxt "h8fe1682cg05f1g431cgb304gb5750f5ca326"
msgid "You'd better swap that lute for a weapon. You'll need one, soon enough."
msgstr "그 류트를 무기로 바꾸는 게 좋을 거야. 곧 필요할 테니 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = 0c027729-ba2d-8e0e-62d2-50e881a65e9c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:0c027729-ba2d-8e0e-62d2-50e881a65e9c
msgctxt "h3f054cb0gfbffg49d1gad1egf430c9ed52fe"
msgid "How can I put this? That sounded a little... <i>unpolished</i>."
msgstr "음, 뭐라고 해야 하나? 방금 건 약간... <i>덜 다듬어진 것 </i>같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = 0c624f38-de60-3c7f-8190-9f1d436e75cf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - MONK(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:0c624f38-de60-3c7f-8190-9f1d436e75cf
#, fuzzy
msgctxt "h00ac749dg4c2dg4bc2g9f7dgc1f80a6e89c2"
msgid "Why are you songwriting <i>now</i>? Hardly the best time."
msgstr "왜 <i>지금 </i>작곡을 하고 있는 거야? 좋은 시기는 아닌 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 0d9c63d1-480f-f5ac-cfec-5f2d236189e1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:0d9c63d1-480f-f5ac-cfec-5f2d236189e1
msgctxt "he59cc90eg6f2ag4458g9107g2a6f167d9396"
msgid "No. I'm moments away from a grisly death..."
msgstr "아뇨. 끔찍한 죽음이 코앞이에요..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 0f1f5071-0b0e-6f6a-b8dd-6200aa8a9647
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:0f1f5071-0b0e-6f6a-b8dd-6200aa8a9647
msgctxt "h9455252fgb761g43e1g89cfg656e018371a6"
msgid ""
"True. And when you <i>finally </i>perfect a song... there's nothing like it."
msgstr "맞아요. <i>마침내</i> 노래를 완성하면... 그만한 게 또 없죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 1275ba9c-5356-943d-6bef-965ba8882ea4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:1275ba9c-5356-943d-6bef-965ba8882ea4
msgctxt "hd7039361g2ea3g471dg910fga27a9e42be6a"
msgid "She was playing her lute. We... didn't hear the gnolls coming."
msgstr "선생님은 류트 연주 중이었고, 우린... 놀이 오는 소리를 못 들었죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 1582d1fa-2988-9200-02e5-7aed86cd79aa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:1582d1fa-2988-9200-02e5-7aed86cd79aa
msgctxt "hda21e6afg0c5bg43acgb391g88e3fd835b4f"
msgid ""
"I remember waking up one night on the road and seeing her - dancing beneath "
"the stars... a huge smile on her face."
msgstr "하루는 노숙하다 깼더니 별빛 아래에서 선생님이 춤추고 있었죠... 환하게 웃으면서요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 17b61b67-9ad5-018c-c5f1-1dadf55f2f79
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:17b61b67-9ad5-018c-c5f1-1dadf55f2f79
msgctxt "hfb7742b5g8402g45cdgbb36g53b58aaccaf7"
msgid "What is wrong with you? You told me you wanted to help!"
msgstr "대체 왜 이래요? 도와주고 싶다면서요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = 1887f5a2-7669-449d-6ef2-8cf553dadf23
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:1887f5a2-7669-449d-6ef2-8cf553dadf23
msgctxt "ha3afb28cg48e7g41cdg9efdg5a5bed979b8a"
msgid "Well, I don't know. Perhaps the lute had it coming."
msgstr "글쎄, 나도 잘 모르겠어. 그게 류트의 운명이었는지도 모르지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 191e850a-c26d-0de7-5f24-b51ac0ba18c9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_TieflingBard_Event_StoleInstrument(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:191e850a-c26d-0de7-5f24-b51ac0ba18c9
msgctxt "h7a1bfbdeg7c87g468dgac9ag980ee71818ec"
msgid "Look, thank you for returning it, but just - just leave me alone."
msgstr "돌려줘서 고맙지만 절 좀 내버려 두세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 195419af-4cf0-177a-8027-e3cd2869fcf9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingBard_State_ConvincedToQuit = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:195419af-4cf0-177a-8027-e3cd2869fcf9
msgctxt "h1772a705gd427g4500g93b0g84a5067fca40"
msgid "I'm not cut out to be a bard. Or much else, if I'm honest."
msgstr "전 뛰어난 음유시인이 아니에요. 솔직히 말하면 반대죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 1bc8d007-95ea-2740-52e2-e5805537f81c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:1bc8d007-95ea-2740-52e2-e5805537f81c
msgctxt "h42440a00g000bg4ef3gbfbbga012efe891da"
msgid "But I... maybe you're right. It was broken to begin with."
msgstr "하지만... 그 말이 맞겠죠. 원래 망가져 있었어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = 1be90f47-a509-e030-9c76-16d5cc0db540
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:1be90f47-a509-e030-9c76-16d5cc0db540
msgctxt "he0d8d68eg3d4fg4283ga038g21540abdf51b"
msgid "No. It's mine now."
msgstr "아니. 이건 이제 내 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = 1c6d5267-b720-f9db-9a11-1120ba882d14
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingBard_State_SpokeToAnimals = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:1c6d5267-b720-f9db-9a11-1120ba882d14
msgctxt "h272b485bgc735g4d0bg90fagc8e134ef3af9"
msgid "Tough audience. Those animals weren't shy with their criticisms."
msgstr "관객들이 깐깐하더군. 다람쥐들이 망설임 없이 비판을 쏟아내던데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = 1f3efa39-7085-3525-17d8-beb44c233e21
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:1f3efa39-7085-3525-17d8-beb44c233e21
msgctxt "hfd355c13g38b9g4c23gbdbfg70ce4a59fe17"
msgid "<i>Nod in encouragement and gesture to her lute.</i>"
msgstr "<i>격려의 의미로 고개를 끄덕이고 그녀의 류트를 향해 눈빛을 보낸다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = 21bcdec5-1d2a-7f19-bb0c-4bf71334bd00
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:21bcdec5-1d2a-7f19-bb0c-4bf71334bd00
msgctxt "h7297c959g7323g4678gae65g9b6203689727"
msgid "That's terrible."
msgstr "끔찍해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 21c3573e-fa16-d3c0-0f88-239352df63cf
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_TieflingBard_Event_LostInstrument = True
#.     - DEN_TieflingBard_Event_MoveWorry = True
#.     - DEN_TieflingBard_State_StoleInstrument = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:21c3573e-fa16-d3c0-0f88-239352df63cf
msgctxt "h9a773d9cgd123g4c0fga590gb4a5cd19a219"
msgid "Where is it? <i>Damn it.</i> No, no!"
msgstr "잠깐, 어디 갔지? <i>망할.</i> 안 돼, 안 돼!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 21ecdc7b-e2b9-e822-28f7-c2f12e718ff1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:21ecdc7b-e2b9-e822-28f7-c2f12e718ff1
msgctxt "hf8ee7152g2807g40e9gb9f0g032452dcf97d"
msgid "It's been so long since I... since..."
msgstr "너무 오래됐어요... 그 후로..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = 221d5afa-d6ae-6828-b376-15fc9c88bb96
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_TieflingBard_State_HasInstrument(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_TieflingBard_Event_ReturnedInstrument(1) = True
#.   Global:
#.     - DEN_TieflingBard_Event_LostInstrument = False
#.     - DEN_TieflingBard_State_StoleInstrument = False
#.   Object:
#.     - DEN_TieflingBard_Event_TransferInstrument(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:221d5afa-d6ae-6828-b376-15fc9c88bb96
msgctxt "h5f33336ag8ef6g485bg9e68gc06ea78efb72"
msgid "I found your lute. Here."
msgstr "네 류트를 찾았어. 여기."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 22a4bcd9-1b44-973f-6556-ef5d37d65cc7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:22a4bcd9-1b44-973f-6556-ef5d37d65cc7
msgctxt "h20ecdc91gfd3bg44bfg85dcg3334eef547fd"
msgid "Hm. It can't hurt. What do you have in mind?"
msgstr "흠. 나쁠 건 없죠. 좋은 생각 있어요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = 241e2aad-ee39-fe7e-bf79-bc6a9cc3737f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:241e2aad-ee39-fe7e-bf79-bc6a9cc3737f
msgctxt "hd6e4630eg0cf7g43e9g8e01g5c58d4a3c8c6"
msgid "No need to be sorry. Though it still needs work."
msgstr "미안해할 것 없어. 여전히 좀 작업이 필요하긴 할 테지만 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = 257c0308-683f-5111-5f4a-7486c0f0b9a0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:257c0308-683f-5111-5f4a-7486c0f0b9a0
msgctxt "hb8a5ca10gb426g440agad6cgfbad791a92cd"
msgid "Let me see if I can help."
msgstr "내가 도울 수 있는지 볼게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 28423321-933a-952d-3457-237e1b82462a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:28423321-933a-952d-3457-237e1b82462a
msgctxt "hb17ca2bbgacb8g4e8dg9bfage4cdd0804851"
msgid ""
"Lihala said that's why eulogies were important. They were for the living as "
"well as the dead."
msgstr "선생님은 그래서 추모가 중요하다고 했어요. 죽은 자 뿐 아니라, 산 자를 위한 것이기도 하니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 2867fbce-c4a4-4df2-0bde-ac926173b1f1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_TieflingBard_State_FinishedSong = True
#.   Object:
#.     - DEN_TieflingBard_Event_GiveProficiency(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:2867fbce-c4a4-4df2-0bde-ac926173b1f1
msgctxt "hf7c28a17gba14g4991gbc8fgc4f68b0fc3ef"
msgid ""
"<i>Moon reminds me of your grace... All the love I can't repay... Rest and "
"know that I will pray... Farewell, my dear old friend...</i>"
msgstr "<i>그 선함을 닮은 달... 갚지 못할 그 사랑... 편히 쉬기를 기도해... 잘 가요, 소중한 내 친구...</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 2929178e-cc92-c60d-568b-2bf06c6676bf
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_TieflingBard_Event_ReturnedInstrument(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:2929178e-cc92-c60d-568b-2bf06c6676bf
msgctxt "h0c46a112g8980g4270ga723ga43ce7a02c15"
msgid "You horrid, horrid beast. What is wrong with you?"
msgstr "기분 나쁜 짐승 놈아. 도대체 뭐야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 2a728fcd-79a5-0817-7930-e14413895cd1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:2a728fcd-79a5-0817-7930-e14413895cd1
msgctxt "hbf3e47e2g8357g4d24g9e25g52cd007a7b5c"
msgid "That was my teacher's. It's all I - I'm sorry. I have to find it."
msgstr "선생님 건데. 남은 건 그거 뿐... 죄송해요. 찾아야 해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = 2b28c320-9e41-7a7e-42b2-269552caa05e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:2b28c320-9e41-7a7e-42b2-269552caa05e
msgctxt "h17c820c7g6518g4eb3g8147g373a29305b39"
msgid "Sounds terrible. I'm sorry."
msgstr "끔찍하네. 유감이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = 2cab8a4e-f788-02ba-7765-28da8150af3c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:2cab8a4e-f788-02ba-7765-28da8150af3c
msgctxt "h459b6a9egb280g4ec3gadf9ge06f3f8c31a3"
msgid "<i>Play along with her. </i>"
msgstr "<i>그녀와 함께 연주한다. </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 2d4608cb-8587-6ffd-e61c-2f7f9afceab8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_TieflingBard_State_FinishedSong = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:2d4608cb-8587-6ffd-e61c-2f7f9afceab8
msgctxt "h30f63d92g178bg401agbb6dg8731f4deb0c6"
msgid "Thank you. I was having trouble... finding the words."
msgstr "고마워요. 가사를 쓰기가 좀... 힘들었거든요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 2deda6dc-1dff-67c8-394e-b5641eaf7741
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:2deda6dc-1dff-67c8-394e-b5641eaf7741
msgctxt "h08c2a5a0gf270g4905g977fg14c175bae3bf"
msgid "Really? Oh..."
msgstr "정말요? 아..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 2e07d330-7e73-82d0-c9d5-af12d09a060c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:2e07d330-7e73-82d0-c9d5-af12d09a060c
msgctxt "h6de3f5b4g0fcfg41e1ga6bcg193283290994"
msgid "Oh. Should I try something else? Be honest."
msgstr "아. 다르게 해볼까요? 솔직히 말해줘요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 35d08f25-2983-9207-fe0f-43914021095d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:35d08f25-2983-9207-fe0f-43914021095d
msgctxt "h56e71c2bgda06g4cd4ga494g5052532970e0"
msgid ""
"<i>Words of mine will turn to ash... When you call the last light down...</i>"
msgstr "<i>내 말은 재가 되고... 그대 최후의 빛 기원하면...</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 363fdf92-a605-8c40-6ac2-ac55fdc3778f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_TieflingBard_Event_Helped(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:363fdf92-a605-8c40-6ac2-ac55fdc3778f
msgctxt "h0e60dd5egfa21g4764gb603gede2c480c3e8"
msgid "Sorry, I need to do this on my own."
msgstr "미안해요, 혼자 해야겠어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 3659328c-d84d-3619-fee7-8357a72bc71e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:3659328c-d84d-3619-fee7-8357a72bc71e
msgctxt "h6cabcf20g6ae7g4332gaf2egb5ca0cc19b00"
msgid ""
"Urgh. Even animals think I'm terrible. I <i>want </i>to finish this song, "
"but I can't - nothing fits, you know?"
msgstr "으으. 동물도 내가 못하는 줄 아네. 정말 완성하고 싶은데 어울리는 가사를 못 찾겠다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = 36b094e5-d529-e5d3-904e-1971a85f50eb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:36b094e5-d529-e5d3-904e-1971a85f50eb
msgctxt "hd7d80024g798eg4424gb887gb8f2eefa5819"
msgid "Perfectly awful. These are the worst lyrics I've ever heard."
msgstr "완전히 끔찍해. 내가 들은 가사 중에 최악이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = 3745f657-774f-62e1-29d7-4a349636cea3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_TieflingBard_Event_Helped(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:3745f657-774f-62e1-29d7-4a349636cea3
msgctxt "h2b6f166ag55fcg4749g8f99g887ce6e9ba5a"
msgid "Listen closely. I'll show you how to do it right."
msgstr "자 들어봐. 내가 어떻게 하는 건지 보여줄 테니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = 38a4f873-0bb9-48de-b35b-394e138243b9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_TieflingBard_Event_Helped(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:38a4f873-0bb9-48de-b35b-394e138243b9
msgctxt "h7730ebc9gd89dg429cgbc89g1e146bbaeee8"
msgid "Can I help?"
msgstr "도울 수 있을까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 3a25448b-8f17-2351-b429-be575b2e02d7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:3a25448b-8f17-2351-b429-be575b2e02d7
msgctxt "h870eab33g7140g4e86g8d46gf93a2deb9a0f"
msgid "This song will be the death of me."
msgstr "이 노래만 만들다 죽겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 3b89ec8b-e6fd-7728-3a2c-197a7c3c0398
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:3b89ec8b-e6fd-7728-3a2c-197a7c3c0398
msgctxt "hd4b808dcg88bag4abcga6a6gbad1e6044a76"
msgid "This is embarrassing. Gods."
msgstr "창피하다, 정말."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = 3d3ebb8a-0370-4c75-8e63-4cc69e58941c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:3d3ebb8a-0370-4c75-8e63-4cc69e58941c
msgctxt "hb714cb27gb03dg4977ga0ebg4c565b820718"
msgid "You want honesty? Give up - you don't have the makings of a bard."
msgstr "솔직히? 관 둬. 네겐 바드의 재능이 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = 49c74bbe-a634-e43d-4d5c-4d6af62cd425
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:49c74bbe-a634-e43d-4d5c-4d6af62cd425
msgctxt "hf3b90a87g5bb6g4e0agbe60g3e9f277fa4f1"
msgid "<i>Continue to play. </i>"
msgstr "<i>계속 연주한다. </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 4a05c8bf-dbcd-affc-1d65-bf3b5f910988
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:4a05c8bf-dbcd-affc-1d65-bf3b5f910988
msgctxt "h1ff62ee3ge35dg4a93gb1bbg8e6c43ffe488"
msgid "<i>...when you call the last light down...</i>"
msgstr "<i>...그대 최후의 빛 기원하면...</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = 4a3923c5-95c9-51ce-788d-3942be423aa8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:4a3923c5-95c9-51ce-788d-3942be423aa8
msgctxt "he2ce5978gc784g495cg8609gc3ff50e14bbd"
msgid "What's the matter?"
msgstr "문제가 뭐니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = 4a43107e-dc2f-7218-874a-e7a69bed7b2b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:4a43107e-dc2f-7218-874a-e7a69bed7b2b
msgctxt "h9b4eef0cgb683g42f8g8421gdf85e88da8a0"
msgid "Are you all right?"
msgstr "괜찮아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 4ad8588f-f055-ec81-9543-71df09eadbc7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_TieflingBard_Event_ReturnedInstrument(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:4ad8588f-f055-ec81-9543-71df09eadbc7
msgctxt "h3c7a18ebg25eeg4b27ga3c6gf69d40f420f7"
msgid "Leave me alone. I mean it."
msgstr "내버려 둬요. 진심이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 4c373f28-4fbe-b1cc-e5c1-017e8eb0a45d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:4c373f28-4fbe-b1cc-e5c1-017e8eb0a45d
msgctxt "hea0ae484g6d46g4526gbd06g81d16e50ad24"
msgid "That's the first time I've played since Lihala died. My teacher."
msgstr "제 선생님 리할라가 죽은 후로 처음 연주한 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 4c8b74e5-6135-d03b-27f2-4afdaacaf996
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:4c8b74e5-6135-d03b-27f2-4afdaacaf996
msgctxt "h54793f55gb05dg41b3gb080ge17d3f229ede"
msgid "<i>Words of mine will turn to ash... </i>"
msgstr "<i>내 말은 재가 되고... </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 4d1578f4-be76-e46d-60ed-79aff4db7db8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingBard_Event_LostInstrument = True
#.      - DEN_TieflingBard_State_StoleInstrument = True
#. SetFlags:
#.   Dialog:
#.     - DEN_TieflingBard_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:4d1578f4-be76-e46d-60ed-79aff4db7db8
msgctxt "h6757035aged9cg4909ga0a6g8dc3565355bd"
msgid "It was right <i>here</i>. Someone must have taken it."
msgstr "<i>여기</i> 있었는데. 누가 가져간 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 4d3d94c6-63a7-dbef-26ea-9161cdac4489
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:4d3d94c6-63a7-dbef-26ea-9161cdac4489
msgctxt "h0ef9c525g1a15g453fgbc53g47b9392c211b"
msgid "Get the hells away from me."
msgstr "다가오지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = 4d84680a-6b4c-d85e-27a8-afb634d79b52
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:4d84680a-6b4c-d85e-27a8-afb634d79b52
msgctxt "h40fe3061gbeb9g4c4fg9258g44abd1aea139"
msgid "<i>Gesture for her to continue. </i>"
msgstr "<i>계속 하라고 손짓한다. </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 4e0334d4-f574-7ad1-e87c-5037bcba9a7f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:4e0334d4-f574-7ad1-e87c-5037bcba9a7f
msgctxt "h25df4bd2gecbag4c37gb47eg3ae4992011fe"
msgid "My teacher, Lihala. She loved dancing. Had two left feet, mind."
msgstr "제 선생님, 리할라예요. 춤을 사랑했죠. 몸치이긴 했지만요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 4e242cae-d8c2-3da5-1da9-0c721d9872d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:4e242cae-d8c2-3da5-1da9-0c721d9872d9
msgctxt "h444f561cgb9cdg43a6g95f9g0fe4d4c515dc"
msgid "Thanks. I'll need it."
msgstr "고마워요. 필요할 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = 4e58571d-89ee-833d-49c4-469d947d99cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:4e58571d-89ee-833d-49c4-469d947d99cb
msgctxt "hea3458efgf5deg4e7ag928cg0eb2f892f726"
msgid "Don't worry. Cry as much as you need."
msgstr "걱정하지 마. 울고 싶은 만큼 울어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 4f12904c-3b17-4377-9086-efe2e4d7114f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:4f12904c-3b17-4377-9086-efe2e4d7114f
msgctxt "h1b1889a6g2504g4404gae16gf4f6c7cfc323"
msgid "Heh. Thanks."
msgstr "하, 고마워요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 514c98b2-5592-ccb4-c11b-1d066d5164c2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:514c98b2-5592-ccb4-c11b-1d066d5164c2
msgctxt "h309e745egc00eg4d88g922fg912e3f175c7a"
msgid "<i>Moon... moon reminds me of your grace...</i>"
msgstr "<i>달... 그 선함을 닮은 달...</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 5231618f-eb02-6668-11b7-c7df1cf2abc9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:5231618f-eb02-6668-11b7-c7df1cf2abc9
msgctxt "hbac92c05g8a94g4feag9ef6gea3b03389be4"
msgid "Yes. Yes!"
msgstr "됐어. 됐어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 55566894-7bee-7859-e304-5fc502dae185
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:55566894-7bee-7859-e304-5fc502dae185
msgctxt "h41e4bfd5gde19g4e8cg87e8g9110a94b97cb"
msgid ""
"<i>All the love I can't repay... Rest and know that I will pray... Farewell, "
"my dear old friend.</i>"
msgstr "<i>갚지 못 할 그 사랑... 편히 쉬기를 기도해... 잘 가요, 내 소중한 친구.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = 55659bc3-5fc0-bdfe-03e8-a34778514e44
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_TieflingBard_Event_Helped(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:55659bc3-5fc0-bdfe-03e8-a34778514e44
msgctxt "h88f7bdbdge6edg4b95gb798gae093677e01b"
msgid "First things first - what's the song about?"
msgstr "먼저, 노래의 주제가 뭐야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = 5694c31e-6390-578c-aebe-8ae2347ffd38
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:5694c31e-6390-578c-aebe-8ae2347ffd38
msgctxt "h859d6cceg8be1g4f7cgb7e1g2caeb71437b4"
msgid "Never mind. This isn't going anywhere."
msgstr "아니다. 이걸로는 안 되겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 57261cba-1adf-92d0-df9c-eae4e677b290
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_TieflingBard_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:57261cba-1adf-92d0-df9c-eae4e677b290
msgctxt "hd99e112cg0e8eg4120gbb64g7ccf7df948d5"
msgid ""
"<i>Dance upon the stars tonight. Smile and pain will fade away. Words of "
"mine will change</i> - no. <i>Become</i> - ugh."
msgstr ""
"<i>별 위에서 춤을 춰요.</i> <i>그 미소에 치유받아, 내 말들이 재로 변할... </i>아냐. <i>재가 되어...</i> 으."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 593ec7b8-315d-c471-0d95-febe27972b7e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:593ec7b8-315d-c471-0d95-febe27972b7e
msgctxt "hd335e0ccg2c3bg4d52g9b93g830192e9f96d"
msgid "I've a long way to go, but thank you. I... I needed this."
msgstr "갈 길이 멀지만 고마워요. 이런 게 필요했어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 5b4766e0-709e-dde9-7488-608aa93e2e05
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:5b4766e0-709e-dde9-7488-608aa93e2e05
msgctxt "h016b2d58gdefdg4397ga4fbga92af9d5f924"
msgid ""
"And that's exactly what I'm going to do: finish <i>The Weeping Dawn</i> - "
"for her."
msgstr "그게 바로 내가 할 일이에요. 선생님을 위해 <i>흐느끼는 새벽</i>을 완성하는 거."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 5daed14f-c264-defd-03d4-ee434a8646ec
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_TieflingBard_Event_PlayWithInstrument(1) = True
#. SetFlags:
#.   Object:
#.     - DEN_TieflingBard_Event_TransferInstrument(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:5daed14f-c264-defd-03d4-ee434a8646ec
msgctxt "hc8b99da7g1fffg4039g9f57ge00f1eeb031f"
msgid "Keep the lute. Please. You've earned it."
msgstr "그 류트 가지세요. 자격 있어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 5ddc8548-3fc3-fa79-3f01-f94385bb14ab
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - HIDDEN_WLD_Boosters.DEN_TieflingBard_Helped(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:5ddc8548-3fc3-fa79-3f01-f94385bb14ab
msgctxt "h86bdee43ga5efg4184g8604gfbea8aff9046"
msgid "Sorry."
msgstr "미안해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = 60ffe684-f7d7-c045-161e-4caa51e64be5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:60ffe684-f7d7-c045-161e-4caa51e64be5
msgctxt "haa85716cg3044g4129gbd8bg2003d7808518"
msgid "It's all right. Let it all out."
msgstr "괜찮아. 다 쏟아내."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = 65057208-5899-c6df-22fb-8db1153303b7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_TieflingBard_Event_Helped(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:65057208-5899-c6df-22fb-8db1153303b7
msgctxt "h80f64263gd32cg4666g88eeg50609f7d093d"
msgid "That was terrible. I'll show you how it's done."
msgstr "정말 끔찍하네. 내가 어떻게 하는지 보여주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 65443fd8-55e7-a218-0598-fcc441694a09
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:65443fd8-55e7-a218-0598-fcc441694a09
msgctxt "h3403d33bg6b7ag49e3g95b9g83ffaa1ce825"
msgid "But when you're stuck, and it's just getting worse - <i>ugh.</i>"
msgstr "그런데 막히면, 더 안 좋아질 뿐이죠. <i>으.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = 654c0cd2-c787-1d52-e4c0-cdb62b58981b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_TieflingBard_Event_Helped(1) = True
#.   Object:
#.     - DEN_TieflingBard_Event_TransferInstrument(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:654c0cd2-c787-1d52-e4c0-cdb62b58981b
msgctxt "hae574aa4gdc6cg4a64g8f94gaf65a964226d"
msgid "Hand me that lute. We can perform together."
msgstr "그 류트 이리 줘. 같이 연주하자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = 65f951b0-f266-11e0-e326-053a08871745
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:65f951b0-f266-11e0-e326-053a08871745
msgctxt "h80377dcfg3d10g4839ga11dg7087009cfd54"
msgid ""
"This grove could become a battlefield soon enough. It's not the time for "
"music."
msgstr "곧 숲은 전쟁터가 될 거야. 음악을 하기엔 좋은 시기가 아닌데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 662e2263-7bbd-8920-f08a-6cf7c19cfaeb
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_TieflingBard_State_ConvincedToQuit = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:662e2263-7bbd-8920-f08a-6cf7c19cfaeb
msgctxt "hd28accbaga624g4b88gb150g150f34e93a64"
msgid "Sorry, do you mind? You've given me a lot to think about."
msgstr "미안한데 가 주세요. 덕분에 생각이 많아져서요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 6682d3ea-d7a6-cacc-faf0-699e6ef86d1d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:6682d3ea-d7a6-cacc-faf0-699e6ef86d1d
msgctxt "h8c4808bcg322eg422fgb44dgdb6ef32838cc"
msgid ""
"It refers to a night on the road with my teacher, Lihala. I was fast asleep "
"when I heard a noise."
msgstr "내 선생님, 리할라와 어느 날 노숙할 때 있었던 일이에요. 깊이 잠들었는데 어떤 소리를 들었죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 67160f7d-0803-19a5-4ee0-2b528e66fefc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_TieflingBard_State_TrashedSong = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:67160f7d-0803-19a5-4ee0-2b528e66fefc
msgctxt "h35d0c11eg24d8g4ddeg8acagf1804e32c353"
msgid "I should start sketching out ideas. Thank you for the help, I guess."
msgstr "아이디어를 짜 봐야겠어요. 어쨌든 도와줘서 고마워요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = 6862b70a-e78e-16f4-58bd-92af40d85ad2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_TieflingBard_Event_TransferInstrument(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:6862b70a-e78e-16f4-58bd-92af40d85ad2
msgctxt "h25cbcd86gc2a1g43fdgafe9g5089a598e347"
msgid "Here. I don't have time for this."
msgstr "여기. 이럴 시간 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 68b195b6-afb3-8a19-ebc5-e3a818b4bb57
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:68b195b6-afb3-8a19-ebc5-e3a818b4bb57
msgctxt "h53506807g7303g482cg8896ga4e64a575594"
msgid ""
"<i>The Weeping Dawn </i>will be my gift to her. Thank you. I... I needed "
"this."
msgstr "<i>흐느끼는 새벽</i>은 선생님을 위한 선물이 될 거예요. 고마워요. 정말 도움됐어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 68e3af6c-a7bc-36df-6f3e-3f2bda7d8fcf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:68e3af6c-a7bc-36df-6f3e-3f2bda7d8fcf
msgctxt "h7d17be4egffb9g4e5cg8069ge107ee164711"
msgid "You horrid, horrid beast. What is wrong with you?"
msgstr "기분 나쁜 짐승 놈아. 도대체 뭐야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = 6918f20f-1df4-6271-16c9-0b1299a5c4f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:6918f20f-1df4-6271-16c9-0b1299a5c4f5
#, fuzzy
msgctxt "h8a20b538gbf78g48ccg81b4g73789c24866b"
msgid "Consider this a lesson - don't be careless."
msgstr "교훈을 얻었다고 생각해. 항상 조심하라는 거지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 696132d1-55de-649e-0138-8e13c7ed4b35
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:696132d1-55de-649e-0138-8e13c7ed4b35
msgctxt "h9b859efbg1a1fg41adgbcb3g7b5dd58c9efd"
msgid ""
"Besides, I'm not doing this for me. This is for the people I... we lost on "
"the way here. It's important."
msgstr "게다가 날 위한 일도 아니에요. 나...우리가 도중에 잃은 사람들을 위해서니까요. 중요하죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 69ebcf4c-8eef-3254-7be5-1b5105e6985c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:69ebcf4c-8eef-3254-7be5-1b5105e6985c
msgctxt "h225a5f05g5fa9g4a79ga768gdaf536e92b69"
msgid "I... we lost people on the way here."
msgstr "여기 오면서 사람들을 잃었어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 6dc7a6aa-90ef-e62e-1b14-dfa407cd7065
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_TieflingBard_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:6dc7a6aa-90ef-e62e-1b14-dfa407cd7065
msgctxt "h7eeb0097g35d0g4d0agbc64ga179741e28ac"
msgid "<i>Words of mine will </i>- urgh."
msgstr "<i>내 말은 재로...</i> - 으."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 6eee42cc-cbae-64c7-cb8b-bb48bc49e91a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:6eee42cc-cbae-64c7-cb8b-bb48bc49e91a
msgctxt "h14eca271g0d2cg4a38g9716g71ce0fe6e35f"
msgid "Heh. She'd have said the same thing."
msgstr "하. 선생님도 같은 말씀 하셨을 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 74b3cf54-94e0-7fcd-88c1-cd260ec35c44
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:74b3cf54-94e0-7fcd-88c1-cd260ec35c44
msgctxt "h09f7a033g8dd7g495bg8b17gdff23f0b8822"
msgid "There was so much blood. I - I can still smell it."
msgstr "피가 넘쳐 흘렀죠. 지금도 그 냄새를 못 잊어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 74e8114e-fe9b-f537-60f0-abdecf91359c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:74e8114e-fe9b-f537-60f0-abdecf91359c
msgctxt "h3d108594g51d6g4334ga59aga7b591478e7c"
msgid "<i>Change</i>? No. DAMN IT."
msgstr "<i>바꾼다?</i> 아냐. 망할."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = 7575b8d2-1690-067a-e90e-984ba3e52b04
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:7575b8d2-1690-067a-e90e-984ba3e52b04
msgctxt "h344025d1g334fg4ee3ga8b7g64f7abbe9a5b"
msgid "<i>Say nothing. </i>"
msgstr "<i>아무 말도 하지 않는다. </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 758ca6d2-847d-177a-927b-6e5031ef2af2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingBard_State_TrashedSong = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:758ca6d2-847d-177a-927b-6e5031ef2af2
msgctxt "heea95afeg7a90g4b76g97bcg054b7367091d"
msgid "I started fresh with that song."
msgstr "처음부터 새로 썼어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = 75c44192-7a18-eda3-5311-2a40d1f6ec8d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:75c44192-7a18-eda3-5311-2a40d1f6ec8d
msgctxt "h8245612bgd921g4cbagab0dg3235a205b2f3"
msgid "All right - <i>that's </i>what your lyrics need to say."
msgstr "좋아. <i>그게 </i>바로 네 가사가 전해야 할 내용이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 7694d89a-01e4-5303-dcbf-db84d6cd1476
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:7694d89a-01e4-5303-dcbf-db84d6cd1476
msgctxt "hce5aebf2g351fg47a1gaff7g9f8e7b9a83d5"
msgid ""
"Thanks. Lihala made me <i>love</i> music: the sound, the feel, the thrill. "
"But when she died... it was gone."
msgstr "고마워요. 선생님 덕에 음악을 <i>사랑하게</i> 됐죠. 그 소리, 느낌, 전율을. 돌아가신 후로는... 다 사라졌네요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = 7ad50bfe-3f09-c702-6a85-20c910af9524
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:7ad50bfe-3f09-c702-6a85-20c910af9524
msgctxt "h7f690c11ga809g49abga68eg101dd2528a9f"
msgid "Who's the song about?"
msgstr "누구에 관한 노래야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 7b6af651-9972-4645-7fbc-3ee6dd2e1b30
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:7b6af651-9972-4645-7fbc-3ee6dd2e1b30
msgctxt "hc26e862dg399cg4f8dg844eg57e454e6b150"
msgid ""
"<i>The Weeping Dawn </i>will be my gift to Lihala. I've a long way to go, "
"but thank you. I... I needed this."
msgstr "<i>흐느끼는 새벽</i>은 선생님께 바치는 선물이 될 거예요. 갈 길은 멀지만, 고마워요. 정말 도움 됐어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = 7b6b5a44-8d17-14b2-7f7c-d4feb7b4e48e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:7b6b5a44-8d17-14b2-7f7c-d4feb7b4e48e
msgctxt "h02b2a0c1ga8b5g4684g82c9g15b96afc6bf7"
msgid "That song was beautiful. Worthy of a few tears."
msgstr "아름다운 노래였어. 울어도 될 만큼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 7b7c12ed-3f11-f257-5fe8-53bdde86e793
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:7b7c12ed-3f11-f257-5fe8-53bdde86e793
msgctxt "hd478ade9gb9e8g45c1g9cfbg46fac9eee961"
msgid ""
"Until now. I'd forgotten what it was like: that itch in my fingers to "
"<i>perfect </i>a song."
msgstr "지금까지는요. 잊고 있었네요. 곡을 <i>완성</i>하고 싶어 근질거리는 느낌을."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 7c7836f2-ac97-7479-4a8b-c05682c0126b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:7c7836f2-ac97-7479-4a8b-c05682c0126b
msgctxt "hdfa6b5cdg00e6g4823g8223g56da2b4c6f9f"
msgid "Haha. Very subtle."
msgstr "하하. 매우 섬세하네요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 7da33d4f-af34-c1cc-0928-a4f68abcefa5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:7da33d4f-af34-c1cc-0928-a4f68abcefa5
msgctxt "h71c886aag5447g46f8gb001ga3ed0666c47e"
msgid "<i>Dance upon the stars tonight... Smile and pain will fade away...</i>"
msgstr "<i>별 위에서 춤을 춰요... 그 미소에 치유받아...</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 7e058121-03e4-1e0f-07aa-2f8f1dfdde10
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:7e058121-03e4-1e0f-07aa-2f8f1dfdde10
msgctxt "h557c0865g89c0g4208g8148g36b3bdc68353"
msgid ""
"...by slowly killing it with this song. <i>Urgh.</i> I can't... nothing "
"fits, you know?"
msgstr "...이 노래로 천천히 사라지는. <i>으.</i> 못해... 전혀 안 어울린다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 7e995315-6689-5c33-32e8-e9932d0373a2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:7e995315-6689-5c33-32e8-e9932d0373a2
msgctxt "h6f39e5acg5b30g4600g8374ga5e005d0c6a3"
msgid "What?! Is it - ? No scratches, strings seem intact..."
msgstr "뭐요?! 정말요? 긁히지도 않고, 줄도 멀쩡하고..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 7fd977c7-3493-66e6-f42a-4e5d7bb8d00b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:7fd977c7-3493-66e6-f42a-4e5d7bb8d00b
msgctxt "h0d1b5fd8g1a18g467agbd0ag837ff873fdce"
msgid ""
"This song is for Lihala... my teacher. She - she died on the way here. I "
"<i>need </i>to get this right."
msgstr "이 곡은 내 선생님... 리할라를 위한 노래예요. 여기 오다가 돌아가셨죠. <i>꼭</i> 제대로 만들 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 80c660c0-a700-8b4b-5573-ddd32349c16e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:80c660c0-a700-8b4b-5573-ddd32349c16e
msgctxt "h128f3ca7ge3cbg4dfbg907fgcb5d263841f7"
msgid "I should never have let it out of my sight. I'm an <i>idiot</i>."
msgstr "눈을 떼지 말았어야 하는데. 난 <i>바보</i>야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = 811357cc-bffb-abd7-df19-3afbaf9a3582
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:811357cc-bffb-abd7-df19-3afbaf9a3582
msgctxt "h82cf529fg9b64g4782g9e32gf3387d0aa416"
msgid "Can I help you finish the song?"
msgstr "내가 곡을 완성하는 걸 도와도 될까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 829fcb4b-fe91-d97f-41ac-16ef2a4410ee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:829fcb4b-fe91-d97f-41ac-16ef2a4410ee
msgctxt "h870f133ageb8dg406fg8d2cgd615cc64878c"
msgid ""
"Heh. She'd yell at me for that clunky verse. And make me play 'til my "
"fingers were raw."
msgstr "하, 가사 투박하다고 구박하시고는, 손가락이 닳도록 연주 시키셨을 걸요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = 83b9f1c2-ac26-b814-9ddb-ff06ccd2334a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_TieflingBard_Event_StoleInstrument(1) = True
#.   Global:
#.     - DEN_TieflingBard_Event_MoveAngry = True
#.     - DEN_TieflingBard_State_StoleInstrument = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:83b9f1c2-ac26-b814-9ddb-ff06ccd2334a
msgctxt "hcfa0c3e6g3de0g42f5gac25g0eae22634e81"
msgid "<i>Slip the lute into your pack. </i>"
msgstr "<i>류트를 슬쩍 훔친다. </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = 83cd3f05-4125-21d7-86eb-556341b0b7a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:83cd3f05-4125-21d7-86eb-556341b0b7a6
msgctxt "hdc8d4ab1g1d89g4d1agbe78g2eb2b7562f0f"
msgid "Well, would you look at this grove. So lovely. So... grove-like."
msgstr "어이쿠, 이 숲 좀 봐. 아주 멋지네. 아주... 울창하고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 84df2175-cf24-405b-9c5d-998a1f24ad4a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:84df2175-cf24-405b-9c5d-998a1f24ad4a
msgctxt "h4398f8e4ga0dcg4161gbaf3g8c646e1ce305"
msgid "And thank you - for everything."
msgstr "고마워요, 전부 다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 85efb114-2d5f-dd7d-a91e-34ce939a1535
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingBard_Event_LostInstrument = False
#.   Object:
#.      - DEN_TieflingBard_State_HasInstrument(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:85efb114-2d5f-dd7d-a91e-34ce939a1535
msgctxt "h51a61f72g1630g435dga0c1g4ba78bd90059"
msgid "Hm. It can't hurt. I have her... I have an extra lute, if you want?"
msgstr "흠. 나쁠 거 없죠. 선생님의... 여분의 류트가 있는데, 필요해요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 866443a1-9fce-e5a7-d337-b56c38f39ec7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:866443a1-9fce-e5a7-d337-b56c38f39ec7
msgctxt "hb4b9d4a4g95b7g45d7g97dbge0209c7a5d4c"
msgid "It was my teacher's. And it's - it's all I have left."
msgstr "선생님 거였어요. 유일한 유품이라고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 86d3ea5a-a0a9-cb05-222c-58818c1652bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:86d3ea5a-a0a9-cb05-222c-58818c1652bf
msgctxt "hfbdc3cd8gf582g45e0g8f79g4b6d24a5e2ed"
msgid "<i>All the love I can't repay...</i>"
msgstr "<i>갚지 못 할 그 사랑</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 87d8e45d-796a-cca6-262c-942babaadd1e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:87d8e45d-796a-cca6-262c-942babaadd1e
msgctxt "h9c786409gf3cdg434bga35cg7de5a2256a18"
msgid ""
"I haven't finished a song since Lihala died. Haven't played at all, if I'm "
"honest."
msgstr "선생님이 돌아가신 후로는 곡을 전혀 안 썼어요. 솔직히 연주도 안 했고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = 90e50610-572b-b1cb-3d49-0c77b2b611bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:90e50610-572b-b1cb-3d49-0c77b2b611bf
msgctxt "hd2e52211g3171g478eg81e5g4e880d604348"
msgid "I take it back. What you're doing is perfect."
msgstr "취소할게. 넌 아주 잘 하고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = 93143bcf-4cdc-8e9e-3146-1e2a0f610bfa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:93143bcf-4cdc-8e9e-3146-1e2a0f610bfa
msgctxt "h69a28882g3bfag45f4ga61agab160fa9575d"
msgid "That's the creative process for you. Agony and ecstasy. Mostly agony."
msgstr "그게 네 창작 과정인 거야. 고통과 환희. 뭐 대부분은 고통인 것 같지만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 931af9a2-6761-d934-6b15-8edf8adb6069
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:931af9a2-6761-d934-6b15-8edf8adb6069
msgctxt "h603c72abg8f04g4a74gba4ag752f51cc4013"
msgid "More like butchering. Don't know why I bother."
msgstr "노래가 아니라 소음이겠죠. 그냥 집어치울까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = 9333a879-012d-e6d4-b9c9-9b12ad04c828
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:9333a879-012d-e6d4-b9c9-9b12ad04c828
msgctxt "h24768f8eg7aafg4a6bg9340g65d968f80b9b"
msgid "Hardly a unique tale of woe these days. Toughen up, or you won't last."
msgstr "요즘 세상엔 흔한 슬픈 이야기네. 마음 굳게 먹어, 그렇지 않으면 버티지 못할 테니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = 93e7ac8f-127b-1534-ed09-b73cdc214cfd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_TieflingBard_Event_StoleInstrument(1) = False
#.   Global:
#.     - DEN_TieflingBard_State_ReturnedInstrument = True
#.   Object:
#.     - DEN_TieflingBard_Event_TransferInstrument(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:93e7ac8f-127b-1534-ed09-b73cdc214cfd
msgctxt "hc3163f08g274fg4c5dg9b2dgbef7b3674501"
msgid "Fine. Take it."
msgstr "좋아. 가져가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 94085adc-781d-adcf-954e-7694ebf34875
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:94085adc-781d-adcf-954e-7694ebf34875
msgctxt "hffc113bcg4ca4g4d96g9493g1f326f83da6b"
msgid ""
"Violence doesn't fix everything, you know. Music can help in ways a <i>silly "
"blade </i>can't."
msgstr "폭력은 아무 것도 해결 못 해요. 음악은 <i>어리석은 칼</i>로 해결 못 하는 걸 할 수 있고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = 9520dd16-e1b1-25a7-0d00-82ae154ad65f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:9520dd16-e1b1-25a7-0d00-82ae154ad65f
msgctxt "h336cbdaag11cdg4a4cg8f78g3e90c01f10eb"
msgid "I'm sure your teacher would be proud to see you now."
msgstr "분명 네 선생님이 보셨다면 자랑스러우셨을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 9581fc66-3f7f-9b3f-1b52-3aee3a8b928e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:9581fc66-3f7f-9b3f-1b52-3aee3a8b928e
msgctxt "he4532a09g6b7fg40aeg8ccbgb3cb21c96147"
msgid ""
"And the dead deserve to be remembered. That's what my teacher always said."
msgstr "망자를 기억해야 한다고, 늘 선생님이 말씀하셨죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 95fc6e6f-4e59-8e44-0f16-f2f8c47918ce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:95fc6e6f-4e59-8e44-0f16-f2f8c47918ce
msgctxt "had526508gd57bg425agaeaege9c27cca0962"
msgid "Wait."
msgstr "잠깐만요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = 99048a47-dd8f-5309-3c6d-d46a8048bfa4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:99048a47-dd8f-5309-3c6d-d46a8048bfa4
msgctxt "hb0be6059g7910g460ag9591gdf4cf36dd97a"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 9a345bbe-9fd1-9a40-9234-689850081ee3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:9a345bbe-9fd1-9a40-9234-689850081ee3
msgctxt "h2a3bb0b9g759bg4b41gaa05g99a2e914a064"
msgid ""
"I woke up, and there she was - dancing beneath the stars... a huge smile on "
"her face."
msgstr "일어났더니, 선생님이 별빛 아래에서 춤추고 있었죠... 환한 미소를 띄고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 9cc09789-3528-9118-f05b-81ce678debb1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:9cc09789-3528-9118-f05b-81ce678debb1
msgctxt "hd58225a4ge1b5g4a60g8246g55bc2d385fdb"
msgid "I don't usually - I'm all right."
msgstr "보통 안 이러... 괜찮아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = 9e368fc1-96a7-162e-3661-c0a44a21d5b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:9e368fc1-96a7-162e-3661-c0a44a21d5b6
msgctxt "h0cdb6306g3509g469cgb3d6g7b20e531a847"
msgid "Guess I'll see what Baldur's Gate brings."
msgstr "발더스 게이트에 가서 어떻게 될지 봐야죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = a38dbf4b-c723-599e-2cd5-ec5594e82612
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:a38dbf4b-c723-599e-2cd5-ec5594e82612
#, fuzzy
msgctxt "h93d6cb16g2ad8g45e9gb924ga589189291e9"
msgid "<i>Sing: 'Words of mine will turn to ash...'</i>"
msgstr "<i>'내 말은 재가 되네...'라고 노래를 부른다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = a626080b-b529-3842-474b-236a6ccb4c34
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:a626080b-b529-3842-474b-236a6ccb4c34
msgctxt "he614b91bg822eg4e11g886cg8a11e6293a20"
msgid "No. I mean - yes."
msgstr "아니, 그러니까... 그래요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = a6748c65-b647-beb3-69a9-fb17492fd924
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:a6748c65-b647-beb3-69a9-fb17492fd924
msgctxt "he9603f6dga0d1g4fc4g8146gdcf37b1b13db"
msgid "Please. It was my teacher's. I don't have - I <i>need </i>it."
msgstr "부탁해요. 제 선생님 거예요. 그것 밖에... <i>꼭</i> 있어야 해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = a6e811a9-413d-67d1-7742-116cc36ff7f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:a6e811a9-413d-67d1-7742-116cc36ff7f1
msgctxt "ha7af572cgc925g488ag9f3dg7ecacf754fbd"
msgid "It's a bad song, plain and simple."
msgstr "끔찍한 노래네, 평범하고 단순해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = a8d655af-61e5-aa71-b370-23534564df7f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:a8d655af-61e5-aa71-b370-23534564df7f
msgctxt "h4f9a53ceg2b85g401cgae67g4a4c3b393edb"
msgid "You're right. She'd have said the same."
msgstr "맞아요. 선생님도 같은 말씀 하셨겠죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = ace1c669-337d-cf9d-d50f-ad6ac326d9b0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:ace1c669-337d-cf9d-d50f-ad6ac326d9b0
msgctxt "hda2ad24ag66b0g461egb177g2f40995513ec"
msgid "<i>Stay silent and listen. </i>"
msgstr "<i>조용히 서서 듣는다. </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = ae5afe7d-5865-f1e9-9578-4bf374921bfc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:ae5afe7d-5865-f1e9-9578-4bf374921bfc
msgctxt "he2ff84b6g88f4g4b29ga257g5cb072efd769"
msgid "You think I don't know that?"
msgstr "그걸 모르는 줄 알아요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = aee8a491-e26e-0015-2d87-e96979f00daf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:aee8a491-e26e-0015-2d87-e96979f00daf
#, fuzzy
msgctxt "h79919ad6g0289g42acg9076g220fc5671bb4"
msgid ""
"Keep going. What would you say to your teacher if she were here right now?"
msgstr "계속해 봐. 네 선생님이 여기 있었다면, 그녀에게 어떤 말을 해줬을 것 같아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = b17d4aaf-416e-07c8-6d4c-94a4498a81bc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:b17d4aaf-416e-07c8-6d4c-94a4498a81bc
msgctxt "h0fa7196dgbaf6g4c65g86d0g5a46c630f20e"
msgid ""
"It was awful. I couldn't look at a lute without hearing her - screaming."
msgstr "끔찍했어요. 류트를 볼 때 마다 선생님의 비명이 들렸죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = b182a3ce-53c7-a02c-9eb6-1f85fb83a1e4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:b182a3ce-53c7-a02c-9eb6-1f85fb83a1e4
msgctxt "hc1ddd102gbf02g40a8ga054g699cfe20708a"
msgid "You already have an instrument. Why do you need another?"
msgstr "이미 악기가 있잖아. 하나 더 있을 이유는 뭐야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = b1975487-4026-55aa-cc54-a7f6b5dc063a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_TieflingBard_State_HasInstrument(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_TieflingBard_Event_ReturnedInstrument(1) = True
#.   Global:
#.     - DEN_TieflingBard_State_ReturnedInstrument = True
#.   Object:
#.     - DEN_TieflingBard_Event_TransferInstrument(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:b1975487-4026-55aa-cc54-a7f6b5dc063a
msgctxt "h12e08bccg85ccg4957gbb79gc81eb9a1ba12"
msgid "It was just a joke. Here's your lute."
msgstr "농담이었어. 자 여기 네 류트."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Narrator
#. NodeID = b1c3533a-a48d-3121-a2db-b969c367822b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#. SetFlags:
#.   Object:
#.     - ORI_DarkUrge_Event_HadUrge(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:b1c3533a-a48d-3121-a2db-b969c367822b
msgctxt "h8e75d11egd628g40edgb2b5gc5b32ecc89c5"
msgid ""
"*Too sweet, odiously sweet. The vomitous gall within despairs at your "
"kindness.*"
msgstr "*너무나도 선한, 불쾌할 정도의 순수함. 내면의 메스꺼운 감각이 당신의 친절에 혐오를 표합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = b249d3aa-d960-e4f7-fd62-73389a2892df
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:b249d3aa-d960-e4f7-fd62-73389a2892df
msgctxt "hdba244b0ge2bdg4f37ga2c0ge91f1a5ba545"
msgid "Best of luck with that."
msgstr "그걸로 행운이 있길 바랄게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = b2cadfa5-9c37-3a8c-e822-c9bedcc291f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:b2cadfa5-9c37-3a8c-e822-c9bedcc291f1
msgctxt "h7f705d14gb965g49eegbc96g7e5d6b80b5f8"
msgid ""
"Heh. And then some. But I have the bones of the song - and that's what "
"matters."
msgstr "헤. 더 손 봐야죠. 노래 뼈대는 갖췄으니까 된 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = b3e4d616-d237-8d00-f0ec-3595162417c1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingBard_State_SmashedLute = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:b3e4d616-d237-8d00-f0ec-3595162417c1
msgctxt "hab63d5bagfbbcg4296g81bcgdd64821ad844"
msgid "Why would someone do that? Why would someone destroy my lute?"
msgstr "누가 그런 짓을? 내 류트를 왜 부순 거죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = b94f1343-51d0-3a14-beca-83c92c1909a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:b94f1343-51d0-3a14-beca-83c92c1909a3
msgctxt "h7c115ab7g751eg42e2g8009ga277bdfb1307"
msgid "The song's more important than survival? Fine - it's your life."
msgstr "생존보다 노래가 중요하다고? 알았어, 네 인생이니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = b98359bf-e607-74c6-0c2f-bccb26caf26e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:b98359bf-e607-74c6-0c2f-bccb26caf26e
msgctxt "h2a6756a0g4062g430fg8d74g78cef6203189"
msgid ""
"<i>Words of mine will turn to ash... When you call the last light down...</i>"
msgstr "<i>내 말은 재가 되고... 그대 최후의 빛 기원하면</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = b9a0af33-9e86-4970-9161-2403e38884d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:b9a0af33-9e86-4970-9161-2403e38884d9
msgctxt "hfa4e9c61g1145g4d79g980bg6f5379b86ba6"
msgid "And I'm sticking to it. Thank you ever so much."
msgstr "그러니까 제 맘대로 해야죠. 아셨으면 이만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = b9b4f598-d187-f505-7b1e-807297b85f26
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:b9b4f598-d187-f505-7b1e-807297b85f26
msgctxt "h5cf91073g8e93g49b5ga315gc0c3fd4e7790"
msgid ""
"I know. I should be packing up, but I <i>need </i>to finish this song. "
"It's... it's important."
msgstr "알아요. 짐을 싸야 하지만, <i>꼭</i> 이 곡을 완성해야 해요. 중요한... 일이라서요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = bafd5c3f-97eb-fa49-6bfc-178ffd4fbca5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:bafd5c3f-97eb-fa49-6bfc-178ffd4fbca5
msgctxt "hb8232e2fgd74ag48e4g968fg2d63d9441c28"
msgid "I'm sure your teacher would be proud to see you now."
msgstr "분명 네 선생님이 보셨다면 자랑스러우셨을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = bd25212e-7c50-a26c-2bfa-c72fe12502d7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:bd25212e-7c50-a26c-2bfa-c72fe12502d7
#, fuzzy
msgctxt "h6da64195g8758g4036gb086gde70950f4baf"
msgid "Let me help you finish it, then."
msgstr "그럼 내가 완성하는 걸 돕게 해줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = bd9cd857-79cd-378d-198c-87535b1b60cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:bd9cd857-79cd-378d-198c-87535b1b60cf
msgctxt "h8d362470g221ag4a47g8543gcd89391c3863"
msgid ""
"I'm trying to finish this bloody song. And it's not... nothing fits, you "
"know?"
msgstr "이 망할 노래를 완성하려는 중인데... 아무 것도 안 어울려요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = be8e8679-1c42-0219-9db4-82a921b5e103
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:be8e8679-1c42-0219-9db4-82a921b5e103
msgctxt "hc4c3ea33g4cbag4ec5g91b6gce583759feb7"
msgid ""
"Heh. Yes, it's led quite a life of crime. I'm simply putting it out of its "
"misery..."
msgstr "하. 맞아요, 정말 큰 범죄를 저질렀죠. 전 비참한 삶을 벗어나게 해주는 것뿐이고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = bf57b7df-1283-b51f-bab1-0089bbf99db9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:bf57b7df-1283-b51f-bab1-0089bbf99db9
msgctxt "hb908ab4agc900g4728g9ca6g7858d7eeec8d"
msgid ""
"I just wanted to - to thank her. To honour her, you know? And now I'll never "
"finish her eulogy."
msgstr "전 그냥... 고맙다고 하고 싶어요. 기리는 거요. 그런데 추모곡을 완성 못 할 것 같아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Narrator
#. NodeID = c06f6411-acf4-0940-57d2-23c1a3940112
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#. SetFlags:
#.   Object:
#.     - ORI_DarkUrge_Event_HadUrge(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:c06f6411-acf4-0940-57d2-23c1a3940112
msgctxt "he96cca77g4992g4437ga5e2gf742138ada75"
msgid ""
"*Too sweet, odiously sweet. The vomitous gall within churns - she sickens "
"you.*"
msgstr "*너무나도 선한, 불쾌할 정도의 순수함. 내면의 메스꺼운 감각이 요동칩니다. 이 사람을 보자니 구역질이 나는군요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = c315ef4c-4df2-a567-ac2c-8224e51ee95a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:c315ef4c-4df2-a567-ac2c-8224e51ee95a
msgctxt "ha03dca6ag68b5g475bgaeafgecc602027ecb"
msgid "My teacher always said a good musician never demands a solo."
msgstr "선생님은 늘 뛰어난 음악가는 솔로 연주가 필요 없다고 하셨죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = c3244514-fc3c-5696-9367-0ead6ba3372b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:c3244514-fc3c-5696-9367-0ead6ba3372b
msgctxt "h109a0f38gc5d5g4f2bgbaadg4a199fec5744"
msgid ""
"I'm not going to ask where you got this. Just... thank you. Now, please "
"leave."
msgstr "어디서 났는지는 묻지 않을게요. 그냥... 고마워요. 이제 가 주세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = c52aa230-2347-f0ab-d824-7c12bccf80c3
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Dexterity
#. DifficultyClass: 10
#. SetFlags:
#.   Global:
#.     - DEN_TieflingBard_Event_MoveAngry = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:c52aa230-2347-f0ab-d824-7c12bccf80c3
msgctxt "hd269fdafgdbb9g46bbgb28cg5bffbbb0a2ce"
msgid "<i>Snatch the lute out of her hands and smash it. </i>"
msgstr "<i>그녀의 손에서 류트를 빼앗은 뒤 박살 낸다. </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = c7213f3a-2661-c441-0471-a363c7a17b9c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:c7213f3a-2661-c441-0471-a363c7a17b9c
msgctxt "h8ca2cd99g3c4bg487aga2d1g682d6df12643"
msgid ""
"<i>Moon reminds me of your grace... All the love I can't repay... Rest and "
"know that I will pray... Farewell, my dear old friend.</i>"
msgstr "<i>그 선함을 닮은 달... 갚지 못 할 그 사랑... 편히 쉬기를 기도해... 잘 가요, 내 소중한 친구.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = c97463eb-3179-f8b0-5a70-2379f04f9076
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:c97463eb-3179-f8b0-5a70-2379f04f9076
msgctxt "h6b7a22ffg991eg40f5g8a59g4323268f588f"
msgid "Sorry. Damn it."
msgstr "미안해요. 젠장."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = ca1211df-fef1-79f8-2a79-6320f24b47f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:ca1211df-fef1-79f8-2a79-6320f24b47f1
msgctxt "h901b74bdgde0dg4c3fg8688g846a5d0eea28"
msgid ""
"I wanted to write a song for her and you - you ruined it. You ruined "
"<i>everything</i>."
msgstr "선생님을 위한 곡을 쓰려 했는데 당신이... 망쳤어. <i>전부</i> 망쳤다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = cb942825-00f9-0ef3-990a-6140472f499b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:cb942825-00f9-0ef3-990a-6140472f499b
msgctxt "hed3ed4f3g3e08g45ffg8f70g57dd01fd749a"
msgid "I'd forgotten what it was like: that itch to <i>perfect </i>a song."
msgstr "잊고 있었네요. 곡을 <i>완성</i>하고 싶어 근질거리는 느낌을."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = ce65c286-bade-2116-ebb3-e802c135fd01
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:ce65c286-bade-2116-ebb3-e802c135fd01
msgctxt "hb98b82afgfacag40c2g9f10gf47e800387d5"
msgid "You're welcome. Just keep at it."
msgstr "천만에. 계속 그렇게만 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = d04b5cf4-5da5-d50d-9be0-112b2c17c77f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_TieflingBard_Event_SmashedLute(1) = True
#.   Global:
#.      - DEN_TieflingBard_State_SmashedLute = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:d04b5cf4-5da5-d50d-9be0-112b2c17c77f
msgctxt "hcfdf2df8gd8c8g4511g8271ga037dcc9b1be"
msgid ""
"How could you <i>break</i> it?! I hope - I hope you're ripped apart by "
"gnolls, you beast."
msgstr "그걸 <i>부수다니</i>?! 짐승 자식, 놀한테 찢겨서 죽어버려."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = d1e6b943-fc7c-5766-d557-ee4001d06bff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:d1e6b943-fc7c-5766-d557-ee4001d06bff
msgctxt "h3aa383bfg4242g49b8g97fag925e321c5de4"
msgid ""
"...at the hands of this <i>bloody</i> song. I can't... nothing fits, you "
"know?"
msgstr "...이 <i>빌어먹을</i> 노래 때문에요. 어울리는 말이 없다고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = d25aee36-1a22-ff85-53e1-981b0131c668
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:d25aee36-1a22-ff85-53e1-981b0131c668
msgctxt "hf968abc3gaa2fg4f52ga5c3gc40305c33aef"
msgid "That... that it's okay. That I'll be okay."
msgstr "괜... 괜찮다고요. 다 괜찮다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = d5e95b33-ca57-6600-365d-f4216daf87ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:d5e95b33-ca57-6600-365d-f4216daf87ea
msgctxt "h92fa6f3eg3dd5g4cc2g8eecgfa5e5649c1f8"
msgid "Wait - what are you doing? Give that back! Right now!"
msgstr "잠깐, 무슨 짓이야? 돌려줘! 당장!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = d71f9e67-d79e-70ab-ee40-11d05ef8e070
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:d71f9e67-d79e-70ab-ee40-11d05ef8e070
msgctxt "h666914fag864dg449cg940egb98f6b220efd"
msgid "It sounded like a cat being strangled. <i>Godsdammit.</i>"
msgstr "목 맨 고양이 소리 같네. <i>맙소사</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = d82753a6-3296-b9ee-7c70-5624651f3cbe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - MONK(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:d82753a6-3296-b9ee-7c70-5624651f3cbe
msgctxt "h9554f464ga32eg4ee7g81e5g2627262e8440"
msgid "To sing outward, one must look inward. Why are you writing the song?"
msgstr "밖으로 표현하고자 한다면, 우선 내면을 들여다보아야 하는 법. 이 노래를 만드는 이유가 뭐지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = d880ce0f-ec0d-9fda-ca29-c8b0d4118a08
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:d880ce0f-ec0d-9fda-ca29-c8b0d4118a08
msgctxt "h5bbbf706g9188g477fg997aga51491f1ac7a"
msgid ""
"There's no singing voice that could save those lyrics. You know that, right?"
msgstr "그런 가사라면 어떤 목소리로도 살릴 수 없겠어. 너도 알지, 그렇지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = d8cf6ab0-5d01-f38e-d57e-03754ae015fa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:d8cf6ab0-5d01-f38e-d57e-03754ae015fa
msgctxt "h4bdc86efg94c2g40bbg966bg8fb95872f1e8"
msgid "Really? I... I love music."
msgstr "정말요? 전... 음악이 좋아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = d9015e81-1ac1-a8af-e7fc-b998b713945e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:d9015e81-1ac1-a8af-e7fc-b998b713945e
msgctxt "hb961a5e6g3cdcg4f9cga069g7ea5617c779d"
msgid "Oh. All right. I mean - thanks anyway."
msgstr "아. 그래요. 어쨌든 고맙다고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = da59955a-337d-2eb7-c77a-92b02100afaa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:da59955a-337d-2eb7-c77a-92b02100afaa
msgctxt "hf8bd23b1g6202g4ef0gb01cgde539d57bb74"
msgid "Really? Good. That's good. Let's keep going."
msgstr "진짜요? 좋네요. 좋아요. 계속하죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = da73507c-e896-574d-6e77-a5b45f6b3926
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingBard_State_ReturnedInstrument = False
#.      - DEN_TieflingBard_State_StoleInstrument = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:da73507c-e896-574d-6e77-a5b45f6b3926
msgctxt "h0153fc21g626eg4376ga6bbg52fcc43f8775"
msgid "I shouldn't have let that lute out of my sight. I'm an <i>idiot</i>."
msgstr "류트에서 눈을 떼지 말았어야 하는데. 이 <i>바보</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = dbe5d251-7fb7-5791-5c9b-4bb5e52050a8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingBard_State_SpokeToAnimals = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:dbe5d251-7fb7-5791-5c9b-4bb5e52050a8
msgctxt "hb8218cb5g5de4g45e9ga1efg09aa0564daf9"
msgid "The animals agreed. Why else do you think they left?"
msgstr "동물들도 동의했어. 안 그럼 그 녀석들이 왜 떠났겠어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = dc8aaf9a-a8e2-f6f4-f808-d2e27fe85ac6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_TieflingBard_State_AtPlayingSpot(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:dc8aaf9a-a8e2-f6f4-f808-d2e27fe85ac6
msgctxt "haf611cb3g3c7fg476dga703g83f2c0a75c1e"
msgid "Leave me be. I'm in the middle of something."
msgstr "방해하지 마세요. 뭐 좀 하는 중이라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = de2f96c1-37cd-1e9e-ca7a-58ce7e7956d9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingBard_State_FinishedSong = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:de2f96c1-37cd-1e9e-ca7a-58ce7e7956d9
msgctxt "hed1a383age7dfg4fdcg8258g6897ba40b68c"
msgid "It's still rough, but my song is getting there!"
msgstr "다듬어야 하지만, 거의 다 된 것 같아요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = de6b5c30-758c-5ae3-9587-5eef23a3f185
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:de6b5c30-758c-5ae3-9587-5eef23a3f185
msgctxt "h0f842de2g58a6g4d62g8bcfg404b22e018f6"
msgid "But I can't even finish this one song..."
msgstr "하지만 이 노래 하나도 완성 못 하네요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = dfb6a893-c3e1-c212-d49b-ae850236c2e8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:dfb6a893-c3e1-c212-d49b-ae850236c2e8
msgctxt "hd52b7585g849eg4793gbbc4g8d8a68df5472"
msgid "You really should be more careful."
msgstr "더 조심하는 게 좋겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = e02bcb4e-6c06-efe6-a632-bf3ae623143f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:e02bcb4e-6c06-efe6-a632-bf3ae623143f
msgctxt "hb44a4676g44f6g41d9ga85bgeac47ce7cb57"
msgid "Lihala. My teacher. And friend."
msgstr "리할라요. 제 선생님이죠. 친구고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = e0d3a3d9-5fac-2a28-5dc6-842e5619b9fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:e0d3a3d9-5fac-2a28-5dc6-842e5619b9fd
msgctxt "hf19f64b5g53cag4836ga985g253aa73ed291"
msgid "I'll start from the beginning. We'll take it slow."
msgstr "처음부터 시작할게요. 천천히 해 보죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = e4160be7-52d9-6719-93c0-d45a5983128e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:e4160be7-52d9-6719-93c0-d45a5983128e
msgctxt "hc92fdddcgefb9g49ffg9251g4c6edb3869d6"
msgid "Well, you've come up with a fine tribute to her."
msgstr "뭐, 그녀를 위한 괜찮은 추모곡인 것 같네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = e6046f57-1d39-fa8e-d0a7-bfd696f18f69
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:e6046f57-1d39-fa8e-d0a7-bfd696f18f69
#, fuzzy
msgctxt "h1e8bdfa8gfddag4719ga29bg9ec5812850b6"
msgid "<i>Continue singing: 'Moon reminds me of your grace...'</i>"
msgstr "<i>노래를 계속한다: '달빛이 네 은혜를 떠올리네.'</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = e6b056f2-ff89-47ef-1405-4e4c9888d044
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:e6b056f2-ff89-47ef-1405-4e4c9888d044
msgctxt "h5b1c6383g5e91g437dgbb0dg609fb89ad145"
msgid "And I have no time for amateurs. Thanks."
msgstr "고맙지만 아마추어 상대할 시간 없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = ec09232f-60c9-a260-a655-4dbdbf5a50e5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:ec09232f-60c9-a260-a655-4dbdbf5a50e5
msgctxt "hdb796a5eg8c19g40c6ga4cagfc2d19e83a49"
msgid "What's that tune you're singing?"
msgstr "네가 부르는 그 노래 제목이 뭐지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = ec869111-596e-a4e0-0350-eedea82a7c5e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:ec869111-596e-a4e0-0350-eedea82a7c5e
msgctxt "h35f52e08gba2bg44cag94edg8b6f0318084a"
msgid ""
"Heh. She'd yell at me for that metre. And make me play it over and over "
"again."
msgstr "헤. 선생님은 박자 틀렸다고 야단치셨을 거예요. 그리고 계속 연습 시켰을 걸요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = ed1882b9-49a8-3e61-97ee-d96623bb48a1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:ed1882b9-49a8-3e61-97ee-d96623bb48a1
msgctxt "h0ea66482g40d8g41a2gbe70g13fca3e5a4da"
msgid "Maybe the life of a bard just isn't for you."
msgstr "어쩌면 네게 바드의 삶이 맞지 않는 걸지도 몰라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = ed87c1f8-c0ac-9e8b-d651-03439c805668
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:ed87c1f8-c0ac-9e8b-d651-03439c805668
msgctxt "h6c587fafg7f8bg48fag9725gf7ee7083dbd3"
msgid "Get the hells away from me."
msgstr "다가오지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = edf91068-ebd3-46a2-d6a0-b9dead7ffdfa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:edf91068-ebd3-46a2-d6a0-b9dead7ffdfa
msgctxt "h46ecbaf0gce0fg4af7g9950ga5b2882c225a"
msgid "Well, you've come up with a fine tribute to her."
msgstr "뭐, 그녀를 위한 괜찮은 추모곡인 것 같네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = f17499a8-8725-4813-3b8a-7c509420e96b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:f17499a8-8725-4813-3b8a-7c509420e96b
msgctxt "h2510a55eg1372g4387g89a2g0da30eab9e06"
msgid ""
"Thinking of it now - my heart hurts and my words just seem to crumble... "
"like ash."
msgstr "지금 생각해도 가슴이 아프고, 말이 바스라지는 것 같아요... 재처럼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = f17d0b19-3a9c-2ce2-f9b9-43900dc3cc99
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_TieflingBard_Event_StoleInstrument(1) = True
#.   Global:
#.      - DEN_TieflingBard_State_ReturnedInstrument = False
#.      - DEN_TieflingBard_State_StoleInstrument = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:f17d0b19-3a9c-2ce2-f9b9-43900dc3cc99
msgctxt "h326c6d6cg3b50g47eeg9c57g3964768b0a5d"
msgid "Don't come <i>near </i>me. I mean it."
msgstr "<i>가까이</i> 오지 마. 진심이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = f39b4105-136e-7cc4-cc52-d81b06efd442
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:f39b4105-136e-7cc4-cc52-d81b06efd442
msgctxt "h0f4968f3g968fg451ega25cg67377c5aa268"
msgid ""
"I haven't, well, come up with anything yet. But I'm sure it'll come to me... "
"eventually."
msgstr "뭐, 아직 생각난 건 없지만, 결국은... 떠오르겠죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = f40206d3-498a-6743-3e89-303dcf9c123a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:f40206d3-498a-6743-3e89-303dcf9c123a
msgctxt "h6d5fd6d6ga0e3g4401g88e7gea80921da6b3"
msgid "Thank goodness. I feel like I'm so <i>close</i>. Let me try again."
msgstr "다행이네요. <i>거의 다</i> 된 것 같아요. 다시 해볼게요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = f75f0896-869f-95d8-17b3-8a04a99ac754
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_TieflingBard_Event_Helped(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:f75f0896-869f-95d8-17b3-8a04a99ac754
msgctxt "h0c227452g212dg4605g9d3cg5e7f04b85d6f"
msgid "Let's start with the lyrics. <i>Dance upon the stars tonight?</i>"
msgstr "가사부터 시작하자. <i>별 위에서 춤을 춰요?</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = f7766663-3362-e481-ee45-1b7d1126eb36
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:f7766663-3362-e481-ee45-1b7d1126eb36
msgctxt "h4fe4512ege902g4e09g842cg35c54879f49a"
msgid ""
"What did that poor instrument ever do to you? You're <i>butchering </i>it."
msgstr "왜 그 악기를 고문하고 있는 거야? 뭘 <i>잘못</i>했길래."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = f7a879bd-2fa8-4d59-35ea-e4d97183c778
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:f7a879bd-2fa8-4d59-35ea-e4d97183c778
msgctxt "h56ccc6a5gb133g4c05g8f9dg45862913504b"
msgid "Hardly a unique tale of woe these days. Toughen up, or you won't last."
msgstr "요즘 세상엔 흔한 슬픈 이야기네. 마음 굳게 먹어, 그렇지 않으면 버티지 못할 테니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = f972e685-e20c-0bbc-b211-a9e22d14007d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:f972e685-e20c-0bbc-b211-a9e22d14007d
msgctxt "h0a2358cfge0ebg4e42g869egd71d18d72a24"
msgid "Get the hells away from me."
msgstr "다가오지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = fa4806ed-1c9c-11e4-0ad5-23595eb1faf8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:fa4806ed-1c9c-11e4-0ad5-23595eb1faf8
msgctxt "h0edf0cebgf7e4g4ef9gb97cg0812757fa8f8"
msgid "Wait. That's it."
msgstr "잠깐. 그거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = fa84a6bb-c64d-763c-a4ea-d42818185ea5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:fa84a6bb-c64d-763c-a4ea-d42818185ea5
msgctxt "hb50934a3gc0c8g4ae5gb233g52f0a8d1884e"
msgid "That was... interesting. Why don't we try again?"
msgstr "정말... 재밌었어요. 다시 해보죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = fc04924e-bde7-b486-7c4c-5d2187c424e1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:fc04924e-bde7-b486-7c4c-5d2187c424e1
msgctxt "he36b6a4fg729ag4426g81eag2234a2191e1c"
msgid "I... I thought they were cheering me on."
msgstr "난... 녀석들이 응원하는 줄 알았어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = fc0cfc2b-8a00-cefd-8688-e7e58546dee6
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:fc0cfc2b-8a00-cefd-8688-e7e58546dee6
msgctxt "h43d14ed0g544dg4186gbec3g1253899ca990"
msgid "<i>Keep time with her. </i>"
msgstr "<i>그녀에게 시간을 준다. </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Alfira
#. NodeID = fce77836-4fe0-658c-678d-3c67141a95a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:fce77836-4fe0-658c-678d-3c67141a95a6
msgctxt "he4c8a05ag2abeg4680g978cg47082e209825"
msgid "Wait. <i>Words of mine will turn to ash...</i> That's perfect."
msgstr "잠깐. <i>내 말이 재가 되고... </i>완벽해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = fe716ad2-cae1-f3d4-1812-d7432478b5bb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:fe716ad2-cae1-f3d4-1812-d7432478b5bb
msgctxt "hd168337aga6b5g4ed8gb7f2g870e74fb73cc"
msgid "Sounds terrible. I'm sorry."
msgstr "끔찍하네. 유감이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = ff487914-c4c4-88e2-e9c2-351a815e32de
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:ff487914-c4c4-88e2-e9c2-351a815e32de
msgctxt "h0eda00e4ge335g40d8gbaffg13ca868fb988"
msgid "Finding the words is an important part of being a singer, you know."
msgstr "있잖아, 가수가 되려면 좋은 가사를 찾는 게 중요한 일이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard
#. Speaker = Player
#. NodeID = ffd55ef2-dda4-4d1b-ffa4-a10fed4992bb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_Bard:ffd55ef2-dda4-4d1b-ffa4-a10fed4992bb
msgctxt "h6db6cfacg12a5g42cfg9fb7gb08b461ed66c"
msgid "Forget what I said. You're doing just fine."
msgstr "내가 한 말은 잊어. 넌 아주 잘하고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 01eece49-90d2-a6e2-e24d-0bf2b9ebd964
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:01eece49-90d2-a6e2-e24d-0bf2b9ebd964
msgctxt "hfa0d08e6gde56g40e1g8696g33fe8943aea6"
msgid ""
"There may be a way though. Goblins are ill-disciplined - it's unlike them to "
"organise so cleverly."
msgstr "하지만 방법이 있을지도 모르지. 고블린은 본래 오합지졸이야. 이토록 영리하게 조직적으로 움직이는 것은 이상 현상이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 04830171-f1eb-dab5-941a-ddfaa8becca7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Refugees_State_LeadersAreDead = True
#. SetFlags:
#.   Dialog:
#.     - DEN_TieflingLeader_HasMet_Introduction(1) = True
#.   Global:
#.     - DEN_TieflingRefugees_Knows_BaldurGoal = True
#.   Quest:
#.     - DEN_Conflict_SUB_Goblin.LearnedLeaving(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:04830171-f1eb-dab5-941a-ddfaa8becca7
msgctxt "hb96274f9g5f5cg49e2gb8cag4c0bee220179"
msgid ""
"A scout just reported - the goblins' leadership has been decimated. We might "
"escape this place yet."
msgstr "방금 정찰대의 보고가 들어왔네. 고블린들의 지도 체계가 붕괴했다고 하는군. 마침내 이곳에서 탈출할 때가 왔는지도 모르겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 04975fd0-6bc5-20ee-8fb9-e2b20003909a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:04975fd0-6bc5-20ee-8fb9-e2b20003909a
msgctxt "h1b208397ga79cg4054g8e2fg7e8eef6ec35a"
msgid ""
"Because of druid 'law'. Every <i>natural</i> law demands I take up my sword, "
"storm their lair, and -"
msgstr "이른바 드루이드의 '법' 때문이지. 진정한 <i>자연의</i> 법칙은 내게 검을 뽑아 그들의 소굴을 치라고 요구하지만..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 04bddeb4-71c3-c8f7-a999-1e9daf3aee38
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:04bddeb4-71c3-c8f7-a999-1e9daf3aee38
msgctxt "h87938e44g1ef5g4c9agb895gcd64830ea31a"
msgid "You had it coming."
msgstr "당신이 자초한 일이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Karlach
#. NodeID = 04cb623d-2b23-3c68-5463-db5e64e58516
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:04cb623d-2b23-3c68-5463-db5e64e58516
msgctxt "hd0fa3510gfb32g4014gaaf5gcb3030a81f8f"
msgid "I knew I liked you."
msgstr "마음에 쏙 든다니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 053bee8a-164c-5419-ffcf-3146b64f6c3f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:053bee8a-164c-5419-ffcf-3146b64f6c3f
msgctxt "h67801c60gfc13g45fcg8f77g18af362d51b5"
msgid "I suppose that's between the two of you."
msgstr "그거라면 내가 관여할 일은 아니겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 0604c219-02cf-64a2-4ccb-48a9948c9952
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:0604c219-02cf-64a2-4ccb-48a9948c9952
msgctxt "hcb813026ga375g4563g9b24g1e2654b6a490"
msgid ""
"We'll live to tell another tale, if we can just convince these druids not to "
"turn us out on our backsides."
msgstr "이 드루이드들이 우리를 걷어차지 않도록 설득할 수만 있다면 이번에도 살아남아 이야기를 계속해나갈 수 있을 걸세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 06e66fff-2714-9765-7658-c5deb8bf72ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:06e66fff-2714-9765-7658-c5deb8bf72ed
msgctxt "h4b9fc2a2ga979g4d9fg90e1gb3bdf807001f"
msgid "Maybe your people should have stayed in Hell."
msgstr "당신네 사람들은 그냥 지옥에 남는 편이 좋았을지도 모르겠군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 098bc320-5aa6-13f1-7ecc-2c7125ac1c4f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_State_HelpDeclined = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:098bc320-5aa6-13f1-7ecc-2c7125ac1c4f
msgctxt "h88b6565dg57a1g4ce2gb366g531d15c93c15"
msgid "I'll speak to the druids."
msgstr "제가 드루이드들과 말해 보죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 0bf50406-8edb-df63-9953-384783b50e2c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingLeader_State_KaghaResolved = False
#.      - DEN_ShadowDruid_State_KaghaIsDead = False
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = True
#. SetFlags:
#.   Global:
#.     - DEN_TieflingLeader_State_KaghaResolved = True
#.     - DEN_TieflingLeader_HasMet_DruidsPacified = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:0bf50406-8edb-df63-9953-384783b50e2c
msgctxt "h7cab3beagd6dfg4ea5g9b98g73cff595633c"
msgid "Kagha's agreed to stop the ritual."
msgstr "카그하가 의식을 중단하기로 동의했습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Narrator
#. NodeID = 0c75ed85-93b4-6b0b-b15a-24ec12ea531b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Tieflings_Knows_DescentIntoAvernus = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:0c75ed85-93b4-6b0b-b15a-24ec12ea531b
msgctxt "hfbe46cb5g1d0cg46f6gb577gc044174800da"
msgid ""
"*'The Descent' - an infernal conspiracy that had seen the entire city of "
"Elturel briefly dragged to the Hells.*"
msgstr "* '하강' - 엘투렐 도시 전체를 한순간에 지옥으로 끌고 간 지옥의 음모입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 0c9f79d4-8d5d-012a-e21a-75f20779e711
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:0c9f79d4-8d5d-012a-e21a-75f20779e711
msgctxt "h6d693fdeg05a3g4819gb97egd64f0e78ae14"
msgid ""
"Rarely have I seen a pair of more impressive horns. I've seen enough "
"devilish magic to ask whether you came about them voluntarily, though."
msgstr ""
"이보다 인상적인 뿔을 본 기억이 별로 없는 것 같네. 데빌의 마법을 많이 봐왔기 때문에 자네가 이 뿔을 자의로 얻은 것인지 묻고 "
"싶어지는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 0d265548-c0e2-59a3-08f5-b2850ec7a9b2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:0d265548-c0e2-59a3-08f5-b2850ec7a9b2
msgctxt "h8c9aafe0g47a1g4dcdg8223g97935e194ac7"
msgid "My apologies, Wyll. I meant no offence."
msgstr "미안하네, 윌. 기분 나쁘게 할 생각은 없었네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 1078908f-493c-8973-b3bc-b73266ca2ef5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = False
#.      - DEN_TieflingLeader_State_KaghaResolved = False
#.      - DEN_ShadowDruid_State_KaghaIsDead = True
#. SetFlags:
#.   Global:
#.     - DEN_TieflingLeader_State_KaghaResolved = True
#.     - DEN_TieflingLeader_HasMet_DruidsPacified = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:1078908f-493c-8973-b3bc-b73266ca2ef5
msgctxt "h9b48b020g717eg4461gb319gcd17e671cf20"
msgid "Kagha's dead."
msgstr "카그하는 죽었습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 10c524ea-6807-8aee-5bcc-64452818b337
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:10c524ea-6807-8aee-5bcc-64452818b337
msgctxt "he4abfaf0g0283g4dc4g9fa5g309920443157"
msgid "I assure you, it very much concerns you as well as us."
msgstr "우리뿐만 아니라 자네와도 관련이 있는 일이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 10f2a70d-fa3a-82f6-14bc-4c63907fe0c5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:10f2a70d-fa3a-82f6-14bc-4c63907fe0c5
msgctxt "h01a0b59egc1e2g4d94gb09ag96dc07756edd"
msgid "That is between the two of us."
msgstr "둘 사이의 문제입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 11b08960-9093-a7c4-61ed-46ba7e46e505
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Apprentice_Knows_HeardAboutNettie = False
#.      - DEN_Apprentice_UserShortcut = False
#.      - DEN_Apprentice_State_Dead = False
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Knows_HeardAboutNettie = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:11b08960-9093-a7c4-61ed-46ba7e46e505
msgctxt "h464bc7a4g2ab2g4d36gae4agc3d8be39250b"
msgid "Is there a healer here?"
msgstr "혹시 이곳에 치유사가 있어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 12346145-0389-2386-bec5-1bf93bb33393
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:12346145-0389-2386-bec5-1bf93bb33393
msgctxt "h715ed041g0922g4d53ga3begdb06719888cb"
msgid ""
"Truly? May Kelemvor judge her justly, then - I've seen Hell, and it's too "
"good for her."
msgstr ""
"정말인가? 그렇다면 켈렘보르께서 그녀를 정당하게 심판하실 것이네. 나는 지옥을 본 적 있네. 그곳도 그녀에게는 호사스러운 곳이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 12adb667-e905-a886-f6ed-394021dae75a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_State_DruidsPacified = False
#.      - DEN_TieflingLeader_State_TalkedAboutMurder = False
#.      - DEN_ShadowDruid_State_KaghaIsDead = False
#. SetFlags:
#.   Global:
#.     - DEN_TieflingLeader_HasMet_AdvisedStay = True
#.     - DEN_TieflingLeader_State_TalkedAboutMurder = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:12adb667-e905-a886-f6ed-394021dae75a
msgctxt "h7bd600acg204bg4fd3gbd57g45ba9dda8b12"
msgid "You can't let the druids force you out."
msgstr "드루이드가 당신들을 쫓아내도록 내버려둬서는 안됩니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 12adf7a6-c95f-4fea-3928-3203bbb4b0bf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:12adf7a6-c95f-4fea-3928-3203bbb4b0bf
msgctxt "he1efe94cgcbdag4452g9f14g502f020b436d"
msgid "Forgive me for presuming, but I think you'll fit right in."
msgstr "주제넘은 말일 수도 있지만, 자네라면 그냥 들여보내 줄 듯싶군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 12b72e0d-2db9-b925-af72-b27e3f27b0f0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AdventurerLeader_State_PermaDefeated = False
#.      - DEN_RaidingParty_State_PeacefulResolution = True
#. SetFlags:
#.   Dialog:
#.     - DEN_TieflingLeader_HasMet_Introduction(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:12b72e0d-2db9-b925-af72-b27e3f27b0f0
msgctxt "h5ab42234g17e2g4072gb90egb304601930b5"
msgid ""
"Ah. You. Thank you. You stopped us from making a bad situation much worse."
msgstr "아. 당신이군. 고맙소. 당신 덕에 이미 좋지 않은 우리 상황이 더 최악으로 가는 길을 피했소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 12f0cd7c-2f77-4cf5-0b3b-84c4a5759fe3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - DEN_TieflingLeader_State_AskedAboutGrove(1) = False
#. SetFlags:
#.   User:
#.     - DEN_TieflingLeader_State_AskedAboutGrove(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:12f0cd7c-2f77-4cf5-0b3b-84c4a5759fe3
msgctxt "he37426f1gf4fbg42a0g9b10g6c5f66b44a60"
msgid "New here. What is this place?"
msgstr "여기 새로 왔어. 여긴 어디지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 13d1584d-03a8-437f-d4da-9159c5c87e30
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_Quest_ZorruIsPermaDefeated = False
#.      - ORI_Laezel_Quest_FoundZorru = False
#.      - ORI_Laezel_Quest_FindZorru = True
#. SetFlags:
#.   Global:
#.     - DEN_TieflingLeader_Knows_AskedAboutZorruAfterIntro = True
#. TagRule: REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:13d1584d-03a8-437f-d4da-9159c5c87e30
msgctxt "h7180b074g8e42g48a4gb328gdd5f078f449b"
msgid "I'm looking for the one called 'Zorru'."
msgstr "'조르'라고 불리는 자를 찾고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 13d1584d-03a8-437f-d4da-9159c5c87e30
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_Quest_ZorruIsPermaDefeated = False
#.      - ORI_Laezel_Quest_FoundZorru = False
#.      - ORI_Laezel_Quest_FindZorru = True
#. SetFlags:
#.   Global:
#.     - DEN_TieflingLeader_Knows_AskedAboutZorruAfterIntro = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:13d1584d-03a8-437f-d4da-9159c5c87e30
msgctxt "h9755aba9g9040g46cag909cg45d60062a39d"
msgid "I'm looking for a man named Zorru."
msgstr "조르라는 사람을 찾고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 14340a28-dbbc-29e6-0412-3cf8251df5f6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:14340a28-dbbc-29e6-0412-3cf8251df5f6
msgctxt "hb3c3b8cegba84g4839g9e45g4a275a14743d"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 15bca6d4-0878-3dc2-acc9-4a3030a9367e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:15bca6d4-0878-3dc2-acc9-4a3030a9367e
msgctxt "hf42833c5g903ag44acg8cccg6147859c68ab"
msgid ""
"Please reconsider. The people in this camp need help. I can only take us so "
"far."
msgstr "부디 재고해 주시게. 이 야영지에 있는 사람들은 도움이 필요해. 나는 이 사람들을 여기까지만 이끌 수 있었네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 16162942-c8fc-7aee-764d-371085b98c1d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:16162942-c8fc-7aee-764d-371085b98c1d
msgctxt "h6a07edf9g3d3cg4780g86cag5cde5143206a"
msgid "Those goblins - have there been many attacks like that?"
msgstr "방금 그 고블린들 말입니다만, 그런 공격이 많이 있었습니까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 16c14b34-60a2-4c25-5e8e-c18cf3bbfecf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:16c14b34-60a2-4c25-5e8e-c18cf3bbfecf
msgctxt "he311ecd4g7162g4fcegb0f3g965b1f6993d4"
msgid ""
"...But no. That's what Kagha wants. To prove we are exactly what she says - "
"a threat."
msgstr "...안 될 일이야. 그게 바로 카그하가의 목적일 테니. 우리가 위협이 된다는 주장만 입증하는 꼴이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 18fc23b9-1630-0556-f4d4-619e381b7139
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:18fc23b9-1630-0556-f4d4-619e381b7139
msgctxt "h0851e6f5g0246g4c2dgb712g815dcd34d63d"
msgid "No armies at our heels... Amazing. We can finally <i>leave</i>."
msgstr "이제 우리 뒤를 쫓는 군대가 사라졌군... 놀라워. 드디어 <i>떠날 수</i> 있겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 191eb055-c8d3-b2b6-eb2f-bb235be8c271
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:191eb055-c8d3-b2b6-eb2f-bb235be8c271
msgctxt "hca820d0ag2620g4929gbe47g77757851aa7c"
msgid "He encountered strange creatures nearby. I wish to know more."
msgstr "근처에서 이상한 생물들을 목격했다더라고. 더 자세한 얘기를 듣고 싶어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 1ac23beb-9edf-1293-dcc0-cd6f610f967f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:1ac23beb-9edf-1293-dcc0-cd6f610f967f
msgctxt "h63079430g75d5g4a0cgb0b8g5620d012aa21"
msgid ""
"Somebody must be leading them, bringing discipline to their ranks. Take out "
"that leadership, and they'll scatter."
msgstr "누군가가 그들을 이끌고 있는 게 분명하네. 조직에 규율을 부여하는. 그 지휘관을 제거하면 고블린들은 흩어지고 말겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 1cf8a8c7-cebe-a711-7cf2-f31acb5f4242
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingLeader_Quest_GobHuntResponded = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:1cf8a8c7-cebe-a711-7cf2-f31acb5f4242
msgctxt "h0196a06ag8f94g4d3cgb417gac9b48e8b80b"
msgid "Removing her isn't the way. Better to face the goblins."
msgstr "그녀를 제거하는 건 올바른 길이 아니야. 고블린을 상대하는 편이 낫지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 1d6ef4b8-1d75-fb95-199f-bfbb653c3761
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_TieflingLeader_HasMet_Introduction(1) = False
#.   Global:
#.      - DEN_GroveConflict_Knows_ZevlorSentToKagha = True
#.   Tag:
#.      - AVATAR(1) = True
#.      - WYLL(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_TieflingLeader_HasMet_Introduction(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:1d6ef4b8-1d75-fb95-199f-bfbb653c3761
msgctxt "h62c02fe0gafcfg48fegba1dg7692b3a4d0bd"
msgid "The Blade of Frontiers. An honour, no matter the circumstance."
msgstr "변경의 칼날이군. 영광이네, 상황이 이렇긴 하지만 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 1d9cb933-b04c-b63b-84f3-cab16da9bc5b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:1d9cb933-b04c-b63b-84f3-cab16da9bc5b
msgctxt "h62fa66c0gbe12g4998gbbd6g5dc07c8cfece"
msgid "Truly? Ilmater's ashes, I never thought she would actually see reason."
msgstr "정말인가? 일메이터의 유해여, 나는 그녀가 실로 이치를 볼 것이라고는 생각 못했네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 2104fee8-5b8e-aa58-4cb4-b47bc76abf8f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:2104fee8-5b8e-aa58-4cb4-b47bc76abf8f
msgctxt "h681abaefg8b35g4434gb187gc2ccaf0feed7"
msgid "Please: tell me you will."
msgstr "부디, 그렇게 하겠다고 말해 주게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 214bc9a0-cbd0-dcf7-6b9d-b1f6f7c48a71
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:214bc9a0-cbd0-dcf7-6b9d-b1f6f7c48a71
msgctxt "hca9db29bgf2cag4c56g91afg305fc70a3ba6"
msgid "Mind your own business, Zevlor."
msgstr "당신 일이나 신경써요, 제블로어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 243fcf0c-ad33-d8e9-73f6-3361945997e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:243fcf0c-ad33-d8e9-73f6-3361945997e7
msgctxt "h1049aac1g0a7cg4b78gb417ge9dd737e6483"
msgid "I can only hope you see that before it's too late."
msgstr "나로서는 자네가 너무 늦기 전에 그 사실을 직시하기만을 바랄 수밖에."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 2467f6a3-e60b-f369-ea41-a2a079fc373d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:2467f6a3-e60b-f369-ea41-a2a079fc373d
msgctxt "hc40b2ea2g013eg4eb6g82adg210c0748de1e"
msgid ""
"Unless you've reconsidered speaking to them for us? Kagha might listen to "
"you."
msgstr "자네가 우리를 대신해 그들과 대화해 주겠다면 혹시 모르겠군? 카그하가 자네 말은 들어줄지도."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 24b1f402-ae84-c2e2-dd52-74f7ea9c000e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Knows_HeardAboutNettie = True
#.   Quest:
#.     - GLO_Tadpole_SUB_Apprentice.LearnedAboutNettie(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:24b1f402-ae84-c2e2-dd52-74f7ea9c000e
msgctxt "h2de3967dg82b8g4b13ga2d5g75b3d4fa1996"
msgid ""
"If it's not too serious, you could try his apprentice, Nettie. She's with "
"the other druids, in the inner grove."
msgstr "그리 심각한 문제가 아니라면, 그의 제자인 네티를 만나보는 것도 괜찮을 걸세. 그녀는 숲 안쪽에 다른 드루이드들과 함께 있네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 251d9972-c64d-01e2-f28b-71aac6b55f25
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:251d9972-c64d-01e2-f28b-71aac6b55f25
msgctxt "h1130e1b8g3911g4bfegbf9dg5a878513ea8d"
msgid ""
"I'll... I'll pray for him. So long as the goblins hold the roads, I'm afraid "
"it's all we can do."
msgstr "나는... 그를 위해 기도하겠네. 고블린이 길을 장악하고 있는 한, 우리가 할 수 있는 건 그것밖에 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Astarion
#. NodeID = 2721d9f7-41c9-9457-532d-71ab10718b63
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:2721d9f7-41c9-9457-532d-71ab10718b63
msgctxt "h7d4d65fegc25fg4ecdg88d4g23d157c53767"
msgid "Really? We're messengers, now?"
msgstr "정말로? 이제 전령 역할까지 하자는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 27a6fa3d-0ac6-a57f-d6c4-68ab0e912c91
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:27a6fa3d-0ac6-a57f-d6c4-68ab0e912c91
msgctxt "h9c166365g1c29g4394ga158g3fce10db5813"
msgid "What is it?"
msgstr "무슨 일인가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 2954bcf1-cc3d-f23b-6609-b41385807bf6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:2954bcf1-cc3d-f23b-6609-b41385807bf6
msgctxt "hf96d637bg940cg4363gaea9ga4af219feb79"
msgid "Just passing through."
msgstr "그냥 지나가는 길이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 298a2f76-35e2-605b-d042-9f2938fe75cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:298a2f76-35e2-605b-d042-9f2938fe75cb
msgctxt "hc386987ag808cg4b28g9ab9g733b5aeb6b7c"
msgid "Found sanctuary here, did you?"
msgstr "이곳을 은신처로 삼은 거군요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 2adccfbe-6b7e-0b49-38c7-f7269a164be0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:2adccfbe-6b7e-0b49-38c7-f7269a164be0
msgctxt "ha6868595g2952g4f12gb830g3eac9851741d"
msgid "Whatever it is, I'm not interested."
msgstr "뭔진 모르겠지만, 난 관심 없습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 2caf48a1-f5cb-1694-d7c8-46fc80af0fcb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Apprentice_Knows_HeardAboutNettie = False
#.      - DEN_Apprentice_UserShortcut = False
#.      - DEN_Apprentice_State_Dead = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:2caf48a1-f5cb-1694-d7c8-46fc80af0fcb
msgctxt "h7267ce1eg7738g4572g9158g1311ff4559c7"
msgid "I won't be staying long - I just need to find a healer."
msgstr "오래 머무르진 않을 겁니다. 그저 치유사를 찾기만 하면 돼요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 2e181d10-6e7e-0fb3-1e3c-10d7751041f8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:2e181d10-6e7e-0fb3-1e3c-10d7751041f8
msgctxt "h1fdb7fa9g7476g4889g815dg8197e292b91c"
msgid "You saw what they did to Arabella for trying - a <i>child</i>."
msgstr "자네도 그들이 시도한 것만으로 아라벨라에게 한 짓을 보지 않았나, 아이에게 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 2e229eea-3524-b82a-b8c8-00c71808a3fa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_RaidingParty_Event_KnockOutTiefling = True
#.      - DEN_RaidingParty_Event_PlayerDidTheKO = True
#.   User:
#.      - DEN_TieflingLeader_State_AskedAboutGrove(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:2e229eea-3524-b82a-b8c8-00c71808a3fa
msgctxt "h1eb99b03g8bedg44c6g93c1g2b12598e9945"
msgid "What is this place?"
msgstr "여기는 어디죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 2f0f6dea-4623-2a69-5170-d7e74faefc9e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:2f0f6dea-4623-2a69-5170-d7e74faefc9e
msgctxt "ha7dab220g23adg4f45ga523gd874d54b92f1"
msgid ""
"It doesn't sit well with me either. But to get these people to safety, "
"there's nothing I won't do."
msgstr "나 역시도 마음에 들지 않네. 하지만 이 사람들을 안전하게 할 수 있다면, 내가 마다할 일은 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Astarion
#. NodeID = 2fdba976-16a6-5ed4-5664-c3f373152a50
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:2fdba976-16a6-5ed4-5664-c3f373152a50
msgctxt "h48991369g26eeg4f0agbe94ga0b66f5a3f4d"
msgid "Turning your back on those in need? Maybe we'll get along after all."
msgstr "도움이 필요한 사람에게 등을 돌리는 건가? 우린 잘 어울릴지도 모르겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 312fa86e-74a8-0ca7-9053-a56034608baf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:312fa86e-74a8-0ca7-9053-a56034608baf
msgctxt "hed442afeg4f8eg4865gab2ag1e7614f45fa4"
msgid ""
"It's Kagha's influence. Without her twisting things, I believe the druids "
"might see sense."
msgstr "이는 카그하의 영향이야. 그녀의 뒤틀린 사상이 없으면, 드루이드들도 사리를 파악할 수 있을 것이라 믿네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 31507526-bd14-aafd-2d43-8ff5b74ef7af
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:31507526-bd14-aafd-2d43-8ff5b74ef7af
msgctxt "h487a8553g3d3bg484cgbdafga8b32587ec13"
msgid "I've tried. Kagha - their new First Druid - won't see me."
msgstr "시도는 해봤지. 드루이드들의 새 지도자인 카그하가 날 만나주지 않네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 31c5c648-a64e-23d5-27b0-72b9fa65e483
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:31c5c648-a64e-23d5-27b0-72b9fa65e483
msgctxt "h5bdef574gf71ag49efg811cg233986d147a3"
msgid "Just as soon as I know she's gone."
msgstr "카그하가 죽었다는 소식이 들리는 즉시 말일세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 32ebdb09-190b-e52a-1813-377a66ad301a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_TieflingLeader_HasMet_Introduction(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:32ebdb09-190b-e52a-1813-377a66ad301a
msgctxt "had1f0a9fg8dfcg4ffag8345g68896625cb93"
msgid "Your help at the gate was appreciated."
msgstr "관문에서의 일은 고맙네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 33a5a86c-ccf1-f713-633b-33f4c94d63c0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingLeader_Knows_AskedAboutZorruAfterIntro = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:33a5a86c-ccf1-f713-633b-33f4c94d63c0
msgctxt "h1029531cgb509g40adg8425g0f15115acdca"
msgid "See that you don't distract him from his duties."
msgstr "그 친구 직무를 너무 방해하지는 말아주게나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 342b7521-e0fb-e19e-a9c2-b91908329f3d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:342b7521-e0fb-e19e-a9c2-b91908329f3d
msgctxt "hce93dec3geaf6g4064gb3bdg7356aabe425d"
msgid "He has seen others of my kind - I wish to know more."
msgstr "내 동족을 본 적이 있다던데 말이지. 더 자세한 얘기를 듣고 싶어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 359a6ed2-d5df-3a3b-6888-a785595f5dc8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:359a6ed2-d5df-3a3b-6888-a785595f5dc8
msgctxt "h83538ecdg3bdcg4b91g872fga582d9574d82"
msgid "By Dhelt's virtue, the Blade of Frontiers? What's happened, Wyll?"
msgstr "맙소사, 변경의 칼날 아닌가? 어떻게 된 건가, 윌?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 37e3a4ab-e612-6e38-5b7a-ec31e9d9d8da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:37e3a4ab-e612-6e38-5b7a-ec31e9d9d8da
msgctxt "hab5a81b0gef94g45e8g81c5ga0f6c55f8b46"
msgid "I'll find her. And I'll speak to Kagha while I'm there."
msgstr "그녀를 찾아야겠군요. 그리고 거기에 있는 동안 카그하와 이야기를 해보겠습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 39e6397e-f85e-171a-8ed1-a1da0d2cfce3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:39e6397e-f85e-171a-8ed1-a1da0d2cfce3
msgctxt "h5afe15f0g3090g46b4gaad1g7b65f3899adf"
msgid "I can't manage that... but they've already let you pass once."
msgstr "나는 시도할 수 없지만... 저들이 자네의 통행은 허락했잖나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 3e43d2a6-2ec7-949c-671d-15819512802e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:3e43d2a6-2ec7-949c-671d-15819512802e
msgctxt "h5e57bb3bgf57eg4b05gab4bgf3abb7067b46"
msgid ""
"I suppose so. We don't have much. But we'll scrape together whatever we can."
msgstr "그렇겠지. 우리가 가진 게 많지는 않아. 하지만 다 같이 모을 수 있는 건 뭐든 긁어모으겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 3ebe08a3-34c5-919a-1f43-5498083114e1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_State_HelpDeclined = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:3ebe08a3-34c5-919a-1f43-5498083114e1
msgctxt "hdfa645f7gc362g477fgb8a3gb491bc415ff9"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 3f1666d3-dc7b-7e3d-887e-e3d1c9e5c9e3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:3f1666d3-dc7b-7e3d-887e-e3d1c9e5c9e3
msgctxt "h1a05c1cegfbfag4d2fgb6e4g14229e1fbd2b"
msgid "We'll be ready to leave as soon as you give word."
msgstr "우리는 자네가 지시만 내리면 바로 출발할 준비가 되어 있네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 3f895a00-c9fb-375d-2b8f-621475bcdc67
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:3f895a00-c9fb-375d-2b8f-621475bcdc67
msgctxt "h37f222edga356g4a9bg93edgc3e40bbf9bf8"
msgid ""
"We're refugees from Elturel - we took shelter here after goblins and gnolls "
"attacked us on the road."
msgstr "우린 엘투렐에서 온 난민들이라네. 길에서 고블린과 놀에게 공격당하다가 이곳으로 도망쳐온 것이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 40126c5a-fcc1-d193-8cbb-67a6083b6fb6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:40126c5a-fcc1-d193-8cbb-67a6083b6fb6
msgctxt "h63413ecegcd49g4b6bgb8e7gf8aea3f4bacc"
msgid "If your people survived that, they'll survive anything."
msgstr "당신의 동족이 그로부터 살아남았다면, 무엇이든 살아남을 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 4305f0c4-87f3-6d51-c974-5d1dd7423139
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:4305f0c4-87f3-6d51-c974-5d1dd7423139
msgctxt "h9b6c7d05gc926g4315g8457g3bb75b27f72d"
msgid "You can keep your coin."
msgstr "동전은 간직하고 있어도 됩니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 447a259b-85b1-3269-93d0-526a21693746
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_RaidingParty_Event_KnockOutTiefling = True
#.      - DEN_RaidingParty_Event_PlayerDidTheKO = True
#. SetFlags:
#.   Dialog:
#.     - DEN_TieflingLeader_HasMet_Introduction(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:447a259b-85b1-3269-93d0-526a21693746
msgctxt "h5bc9fd51g49dag491bgbeddg8d25d0371ad8"
msgid "You're the one who knocked my jaw out of joint."
msgstr "내 턱에 한 방 날린 양반이 여기까지 찾아 오셨구만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Narrator
#. NodeID = 454af9a7-d023-b0e9-0ee7-59671339e983
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#. SetFlags:
#.   Global:
#.     - GLO_Tieflings_Knows_DescentIntoAvernus = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:454af9a7-d023-b0e9-0ee7-59671339e983
msgctxt "h0b697be0gd4b4g443cg86b8gbfc34dea2dd6"
msgid ""
"*You remember it. Elturel and all its citizens were dragged into Avernus - "
"then back out again.*"
msgstr "*당신도 기억하는 사건입니다. 엘투렐 전체가 주민들과 함께 아베르누스로 끌려갔다가 도로 빠져나왔습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 4681af09-0caa-5799-0bac-23d3f88bb1d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:4681af09-0caa-5799-0bac-23d3f88bb1d6
msgctxt "h1648889fg1210g4144gac5bg95ec96d23f5c"
msgid ""
"So we can risk violence here or face it for certain on the road. Quite the "
"choice, isn't it?"
msgstr "우리는 여기서 폭력의 위험을 감수할 수 있고, 아니면 길에서 폭력을 확실히 마주할 수 있네. 정말 대단한 선택이지 않나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 47a2099c-8b71-0380-be82-1195d14865e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:47a2099c-8b71-0380-be82-1195d14865e6
msgctxt "h648d4c4bgd686g407agb965g5b8650af6000"
msgid "Of course - you have your own business to attend to."
msgstr "이해하네. 자네도 자네 나름대로 해야 할 일이 있겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 48462aa8-162a-0c91-eabb-09eabc62c31b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:48462aa8-162a-0c91-eabb-09eabc62c31b
msgctxt "h3887fd72g5f6bg4d2fg841ag7cbdb00950e7"
msgid "We know one another."
msgstr "서로 아는 사이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 485a8023-6400-f2b4-09cb-81ce937395b2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:485a8023-6400-f2b4-09cb-81ce937395b2
msgctxt "h874a685dg76e6g4408g930agfccc623caf8a"
msgid "The goblins are still massing out there."
msgstr "고블린들이 아직도 넘쳐나네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 4883ac45-7e8e-3f5d-3516-38cffe3954b7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:4883ac45-7e8e-3f5d-3516-38cffe3954b7
msgctxt "hbe0dd486ge0e7g4b3dgbd76gdf50cecbf1af"
msgid ""
"If you want to turn your blade on anyone - turn it on the goblins. You won't "
"be able to cut them all down, there's a horde of them out there."
msgstr ""
"어딘가 칼날을 겨누어야 한다면 - 이왕이면 고블린들에게 겨누게. 놈들은 무리를 이루고 있어서 아무리 자네라도 모조리 쓸어버릴 순 없을 "
"걸세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 4a19d84e-2879-daa4-011a-5ece772c5f68
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:4a19d84e-2879-daa4-011a-5ece772c5f68
msgctxt "h39217cbcg7460g4359g905eg953f973b86ec"
msgid ""
"But if you believe Kagha deserves your compassion after what she's done, "
"there's nothing more to discuss."
msgstr "하지만 카그하가 한 짓에도 불구하고 자네가 그녀를 믿는다면 더 이상 할 말은 없네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Shadowheart
#. NodeID = 4ac81e08-ca16-f0d8-6be3-880e6f416f85
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:4ac81e08-ca16-f0d8-6be3-880e6f416f85
msgctxt "h6755d0f9g2336g4112g97c7g1b066fc6a926"
msgid "You chose well. We have enough burdens as it is without taking on more."
msgstr "잘 선택했어. 우리는 지금도 충분히 힘들어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 4af0fd81-5e26-aa55-5caf-33066e215f1b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_TieflingLeader_Event_StartIntimidationCombat = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:4af0fd81-5e26-aa55-5caf-33066e215f1b
msgctxt "hcfe81d4egd5e7g4526gba46g1c880280166e"
msgid "No. You would send us to our deaths - I'm not going to let it happen."
msgstr "안 돼. 자네는 우리를 죽음으로 몰아넣으려 하는군. 나는 그런 일이 일어나게 두지 않을 것이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 4b2ce76d-2a27-bfe3-2963-b3a95b88452e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_TieflingLeader_Event_GaveName(1) = True
#. SetFlags:
#.   Local:
#.     - 34c3046f-4a32-f165-c262-24d2af9e0114_A = True
#. TagRule: DROWELF or DROWHALFELF
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:4b2ce76d-2a27-bfe3-2963-b3a95b88452e
msgctxt "hbb3bf611g3605g4babg837cg689bdcd0a13e"
msgid ""
"Never thought I'd say this to a drow, but... thank you. I'm Zevlor. And "
"you're...?"
msgstr "드로우에게 이런 말을 하게 될 줄은 몰랐지만... 고맙네. 난 제블로어라고 하네. 그리고 자네는...?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 4bb27188-dc47-1c24-be18-53f8547528f7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:4bb27188-dc47-1c24-be18-53f8547528f7
msgctxt "h0768feb0g1c66g4177gbaddgcc14dc4e6e8e"
msgid ""
"We'd owe you a great debt. If we're forced to leave now, more of my people "
"will die."
msgstr "자네에게 큰 빚을 지는 것 같군. 만약 우리가 당장 쫓겨나면, 더 많은 사람들이 죽어야만 할 걸세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 4d023db1-0dbc-7dfe-8feb-affa89dd4cf6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_Quest_AgreedToMurder = True
#.   Quest:
#.     - DEN_Conflict_SUB_Murder.ZevlorTalkedMurder(1) = True
#.     - DEN_Conflict.ZevGaveQuest(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:4d023db1-0dbc-7dfe-8feb-affa89dd4cf6
msgctxt "h47405727g0dfeg45b4g9ae3gd22cd9291744"
msgid "Leave it to me."
msgstr "저에게 맡기십시오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 4ec90832-04c7-a738-72f8-c1b04e1c4e5e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:4ec90832-04c7-a738-72f8-c1b04e1c4e5e
msgctxt "hbe0404cbg2cffg47c5g9502gf2fdafcb1513"
msgid ""
"A druids' grove, dedicated to the Oak Father, Silvanus. You'll find its "
"keepers just as thorny, I fear."
msgstr "드루이드의 숲이네. 참나무 아버지인 실바누스에게 봉헌되었지. 안타깝게도, 가시 돋친 관리자들을 찾을 수 있을 걸세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 504819c4-0ff0-2963-4b08-7e08828b77f1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Apprentice_Knows_HeardAboutNettie = False
#.      - DEN_Apprentice_UserShortcut = False
#.      - DEN_Apprentice_State_Dead = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:504819c4-0ff0-2963-4b08-7e08828b77f1
msgctxt "h42177123g8996g4b45gbe4fg6e2d4fb5ee9d"
msgid "I'm looking for a healer."
msgstr "치유사를 찾고 있어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 515ea9e6-9262-14c4-ca81-04137e7b40f9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:515ea9e6-9262-14c4-ca81-04137e7b40f9
msgctxt "h9a715b2agdba2g465ega573gd462142d8a34"
msgid ""
"But if the druids won't abandon this ritual of theirs, it will be trouble - "
"for <i>all </i>of us."
msgstr "하지만 드루이드들이 의식을 멈추지 않으면 문제가 생기고 말 걸세. 우리 <i>모두</i>에게 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 5251d44d-0b16-0ba5-f5a3-a27d20262c16
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingLeader_HasMet_ReactToDruidAttack = False
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#. SetFlags:
#.   Global:
#.     - DEN_TieflingLeader_HasMet_ReactToDruidAttack = True
#.     - DEN_TieflingLeader_State_KaghaResolved = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:5251d44d-0b16-0ba5-f5a3-a27d20262c16
msgctxt "h4f661774gf459g4de6g8b8fg34ff07c62811"
msgid "That was ugly work, but it was them or us."
msgstr "참 더러운 일이었네, 하지만 저들이 아니었다면 우리가 당했겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 52aa341c-e823-7f98-b97c-c74133b7f226
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:52aa341c-e823-7f98-b97c-c74133b7f226
msgctxt "hcac9780dg6127g4908g92f2g58ec1fefdaf0"
msgid ""
"The stories I was raised on don't equate drow with diplomacy - I'm glad to "
"see they were baseless."
msgstr "드로우와는 어떤 협상도 하지 말라는 이야기를 들으며 자랐다네, 그 말들이 근거 없는 소리라는 것을 알게 돼서 기쁘군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 53c91454-ce82-1e76-3a0e-3761599e6600
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:53c91454-ce82-1e76-3a0e-3761599e6600
msgctxt "h9d9789bcg4448g4e37ga06bg577105364608"
msgid "Tell me what you need."
msgstr "필요한 것을 말해 보세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 53ca57d0-09e7-5639-bef6-22e43fd80cbd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:53ca57d0-09e7-5639-bef6-22e43fd80cbd
msgctxt "h83ef588dg0164g454cgab9cgaacc5a103b78"
msgid ""
"The High Overseer - <i>our grand protector</i> - signed a pact with devils. "
"It dragged Elturel straight to Hell."
msgstr "우리 <i>수호자</i>, 고위 감독관이 데빌과 계약을 맺었다네. 그 계약으로 인해 엘투렐이 지옥으로 끌려 내려갔지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 543d7d0e-b006-237b-59a6-7bc154468a20
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingLeader_HasMet_AdvisedRun = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:543d7d0e-b006-237b-59a6-7bc154468a20
msgctxt "hc677e2e5g02afg431egb424g0dca2c9ed653"
msgid ""
"Our time grows short. If Kagha won't abandon her madness, then we'll have to "
"try the road - goblins or no."
msgstr "시간이 별로 없네. 만약 카그하가 광기를 버리지 못한다면, 우리는 고블린이 있든 없든 길에 나가야만 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 54ff5182-4746-b69b-7690-555dca7d0ecb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:54ff5182-4746-b69b-7690-555dca7d0ecb
msgctxt "h03bb9df8gb553g4d84g9831ge1d0f4418433"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Gale
#. NodeID = 5568072d-35a8-c093-9457-8b8e052df92f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:5568072d-35a8-c093-9457-8b8e052df92f
msgctxt "hfb0f9f12g02d8g46adg925egb20d57c78191"
msgid "I think you should, yes. No harm in trying the diplomatic route."
msgstr "나도 동의해. 외교적 방법을 시도하는 것도 나쁘지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 55a6fbe2-014f-84ae-9c50-e71da40529fd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_Quest_AgreedToMurder = True
#.   Quest:
#.     - DEN_Conflict_SUB_Murder.ZevlorTalkedMurder(1) = True
#.     - DEN_Conflict.ZevGaveQuest(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:55a6fbe2-014f-84ae-9c50-e71da40529fd
msgctxt "h9754632dge8ddg4d94g9bbbgd0387bf6f9e7"
msgid "What's it worth to you?"
msgstr "이러는 것이 당신에게 무슨 가치가 있죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 57dce3c8-b908-f87c-e7bf-06d84e5d2afe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:57dce3c8-b908-f87c-e7bf-06d84e5d2afe
msgctxt "h62414e92gfda2g4ef9ga6dcg2ac3caf2ccf1"
msgid "I'm surprised you haven't heard of it."
msgstr "처음 듣는다니 놀랍군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 592779d6-f998-1b34-8414-e1f8ab848c2b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:592779d6-f998-1b34-8414-e1f8ab848c2b
msgctxt "ha8b87240ge36dg4efcgae8fg2f43c43d7577"
msgid ""
"It seems you're of a mind with our hosts here. But their ritual will force "
"<i>you</i> out, too."
msgstr "자네는 이곳의 주인들과 마음이 맞는 모양이군. 그러나 그들의 의식은 <i>자네</i>도 내쫓을 것이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 59ad6a6a-bb4c-a48d-92ff-a297b64cfb76
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:59ad6a6a-bb4c-a48d-92ff-a297b64cfb76
msgctxt "h159e34bbg364bg41cdg8a73gede4225b5dd5"
msgid ""
"I've always suspected drow weren't nearly so heartless as surface-folk "
"believe. Thank you for providing the proof."
msgstr "난 언제나 드로우가 지상 종족들에 비해 비정한 자들이라는 말을 의심했다네. 그 생각이 맞다는 것을 증명해 줘서 고맙네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 5a5ad04a-ea33-6825-0eb3-d1cdb49620cc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_RaidingParty_Event_KnockOutAdventurer = True
#.      - DEN_RaidingParty_Event_PlayerDidTheKO = True
#.      - DEN_AdventurerLeader_State_PermaDefeated = False
#. SetFlags:
#.   Dialog:
#.     - DEN_TieflingLeader_HasMet_Introduction(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:5a5ad04a-ea33-6825-0eb3-d1cdb49620cc
msgctxt "h4324f332g802ag4251gacc0gc1dea69c2c7b"
msgid ""
"You knocked Aradin clean out. <i>And </i>you helped drive the goblins back. "
"Thank you."
msgstr "아라딘에게 멋지게 한 방 먹여 줬군. <i>게다가</i> 고블린을 몰아내는 일도 도와줬어. 고맙네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 5a7c748e-4242-4e39-1358-73f63f5fee43
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:5a7c748e-4242-4e39-1358-73f63f5fee43
msgctxt "h513e7a16g5687g4666gb88eg3444997e2373"
msgid ""
"Afterwards, people looked at us and just saw 'devilkin'. No different from "
"the druids here, really."
msgstr "그 사건 이후로, 사람들은 우리를 그저 '악마족'으로 여긴다네. 여기 드루이드들도 딱히 다르지 않더군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 5b7d6366-abaf-3bc3-c6e5-3920cb893722
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = False
#.      - DEN_ShadowDruid_State_SnakesCourtDone = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:5b7d6366-abaf-3bc3-c6e5-3920cb893722
msgctxt "h0d09d438g57e4g4251gbf13g95cc6e56e641"
msgid "I heard what happened. Thank you for protecting the child."
msgstr "무슨 일이 일어났는지 들었다네. 그 아이를 지켜줘서 고맙네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 5bbf511f-cf7e-69db-cc09-403721f8496a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:5bbf511f-cf7e-69db-cc09-403721f8496a
msgctxt "h8b8d3c4fg7756g49d2ga313gc6a7458d3e87"
msgid "A low thought, but I'd be lying if I said I hadn't considered it."
msgstr "좋지 못한 생각일세. 다만 내가 생각해본 적도 없다고 하면 거짓말이겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 5c1334b1-3e8d-e2ef-912f-4034ab35fbeb
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - GLO_Tadpole_SUB_Apprentice.LearnedAboutNettie(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:5c1334b1-3e8d-e2ef-912f-4034ab35fbeb
msgctxt "h0b90acdcgb91ag4871g8257gc52fb6107c91"
msgid ""
"If Nettie can't help you, you'll need to go to Baldur's Gate - and you'll "
"face the same threats as us along the way."
msgstr ""
"만약 네티가 자네를 도와줄 수 없다면, 자네는 발더스 게이트로 가야 하네. 그리고 그 과정에서 우리와 같은 위협에 직면할 것이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 5c9a2206-abc4-07a2-069c-04c1ce52f51c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:5c9a2206-abc4-07a2-069c-04c1ce52f51c
msgctxt "ha55c2336gec0cg43d6g8f8dg4b399266478d"
msgid "I'm Zevlor."
msgstr "난 제블로어라고 하네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 5cec5dc0-22ab-3628-a57b-c275460202cd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_State_Returned = True
#. SetFlags:
#.   Global:
#.     - DEN_AttackOnDen_Event_HalsinSpotted = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:5cec5dc0-22ab-3628-a57b-c275460202cd
msgctxt "h3905b4acgaf1dg4db8gb2eag28d2d8e382aa"
msgid ""
"It's quite a day for reunions. Halsin has returned, too - and I expect he'll "
"want to speak with you. As for us..."
msgstr "재회가 가득한 날이군. 할신도 돌아왔다네. 아마 자네와 대화하고 싶어하겠지. 우리로 말하자면..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 5d8da628-b153-39d0-afdd-cd5852bd3491
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:5d8da628-b153-39d0-afdd-cd5852bd3491
msgctxt "hbc04e7bbg4b28g43d7gb657g393f44538077"
msgid ""
"Oh, and if it's of any concern... you're brave to walk around without hiding "
"your heritage. I'll make sure everyone knows that you helped us at the gate."
msgstr ""
"아, 그리고 혹시나 걱정을 했는지 모르겠지만... 자네가 출신을 숨기지 않고 돌아다니는 것은 용감한 일이라 생각하네. 자네가 관문에서 "
"우리를 도운 일은 모두에게 꼭 일러두겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 5d9e1da7-8080-e76c-9e28-699af88ed01d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:5d9e1da7-8080-e76c-9e28-699af88ed01d
msgctxt "hcbc4fb42g1f93g48c7gb0a7g160841184a06"
msgid ""
"How easily such a nasty word slips through the mouth of someone you thought "
"you knew."
msgstr "잘 아는 사람이라고 생각했던 자가 어찌 그렇게 쉽게 모욕을 내뱉는 것인지, 참."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 5e95919d-c71a-fbda-0065-86c1d20235d3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingLeader_Quest_GobHuntResponded = True
#.      - DEN_TieflingLeader_Quest_GobHuntDeclined = False
#.      - DEN_TieflingRefugees_Quest_HuntRewardOffered = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:5e95919d-c71a-fbda-0065-86c1d20235d3
msgctxt "h0de346b8gd0b2g42fdg9926gf7c55cc997f5"
msgid "And I hear <i>you </i>are the one to thank. I'm grateful."
msgstr "그리고 감사해야 할 인물은 <i>자네</i>라고 들었지. 정말 고맙네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 5eaf23db-6b1e-9d89-d41c-94b30c13b7bc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:5eaf23db-6b1e-9d89-d41c-94b30c13b7bc
msgctxt "h6a1d4a5fg371bg4f75gafe2gf22a3a61472c"
msgid ""
"You'll find the druids at the heart of the grove. Please - make them see "
"sense."
msgstr "숲의 심장부로 가면 드루이드들을 찾을 수 있을 걸세. 제발, 그들이 이성적으로 행동하도록 도와주게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 5ecda0af-6d75-3b9d-fef0-194f9399f1f5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_Knows_ZevlorSentToKagha = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:5ecda0af-6d75-3b9d-fef0-194f9399f1f5
msgctxt "h136f5bcbge4d8g4112g9f04g6851cc2b0dbe"
msgid "This ritual - is there no way to convince the druids to stop it?"
msgstr "그 의식, 드루이드들을 설득해서 멈추도록 할 수는 없습니까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 5ef8b2ad-5d9e-5964-0d71-9ec1b705a6aa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_Knows_ZevlorSentToKagha = True
#.      - DEN_GroveConflict_State_HelpDeclined = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:5ef8b2ad-5d9e-5964-0d71-9ec1b705a6aa
msgctxt "he9afa7cfg0689g4ad7gba57g9ea57da6c8f7"
msgid "I'd advise you to settle your affairs here quickly."
msgstr "여기서 볼일이 있다면 빠르게 해결하는 것이 좋을 걸세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 6005ecc4-7f8d-b418-8e41-62c5b780fcb8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:6005ecc4-7f8d-b418-8e41-62c5b780fcb8
msgctxt "he62fc626gb016g44ccg86f3g95027191ceb1"
msgid "I'm not some murderer for hire."
msgstr "저는 살인 청부업자가 아닙니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 60781421-c664-d59c-290b-dd67f9489d86
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_TieflingLeader_State_HasRewardRitual(0) = True
#. SetFlags:
#.   Object:
#.     - DEN_TieflingLeader_Event_GiveRewardRitual(1) = True
#.   Quest:
#.     - DEN_Conflict_SUB_Murder.ZevlorRewarded(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:60781421-c664-d59c-290b-dd67f9489d86
msgctxt "h5684fbe9g2f1dg4703g8af0gc6fe3899fb60"
msgid ""
"I need to ensure my people make the most of it. But here - left over from my "
"soldiering days."
msgstr "나는 내 동족들이 이를 최대한 활용할 수 있도록 해야 하네. 하지만 여기, 내가 군인 시절부터 갖고 있던 것이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 60a13aee-bf36-95e5-fe2b-b963eda80339
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_TieflingRefugees_Quest_HuntRewardOffered = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:60a13aee-bf36-95e5-fe2b-b963eda80339
msgctxt "hb869ee69g00fdg436agb0f0g5b59ed46214c"
msgid "Very good of you. Thank you."
msgstr "아주 친절한 마음씨를 지녔군. 고맙네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 60b5160c-2555-5cec-fc08-45c2a849cf28
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:60b5160c-2555-5cec-fc08-45c2a849cf28
msgctxt "hf001f3dage380g4dfegb322g241a9af72a27"
msgid ""
"I meant no insult. It's simply that yours are a people at war with "
"themselves - I've never known them to care for outsiders."
msgstr ""
"모욕할 의도는 없었네. 그저 당신네 사람들은 항상 내전에 휘말려 있다고 들어서, 그들이 외부인에게 신경을 쓴다는 이야기는 들어본 적이 "
"없어서 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 614a9878-408f-da77-22b6-2840a87d2ea7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:614a9878-408f-da77-22b6-2840a87d2ea7
msgctxt "he87bc5fagf0f7g4993g8bf7g586ad3a881e5"
msgid "I believe he's <i>catching up </i>with Kagha. As for us..."
msgstr "그는 카그하와 <i>대화</i>를 하고 있을 걸세. 우리의 경우엔..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Narrator
#. NodeID = 64011c4d-b8e9-5b6d-fca5-9d30f403f08a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:64011c4d-b8e9-5b6d-fca5-9d30f403f08a
msgctxt "h43d4aab7g7d17g4190g9e75g3ae31f1376cb"
msgid ""
"*A moment passes as Zevlor contemplates Wyll's words. He then turns his "
"attentions to you.*"
msgstr "*제블로어가 윌의 얼굴을 응시하는 동안 잠시 시간이 흘렀습니다. 그는 이제 당신을 향해 시선을 돌립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 651f8cc4-cb7e-b03f-70e5-a3e271c28278
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:651f8cc4-cb7e-b03f-70e5-a3e271c28278
msgctxt "h1701016dg7eeag408bg9a54geacea3f64238"
msgid ""
"We were bound for Baldur's Gate, and it was too late to turn back. Elturel "
"had no place for tieflings after the Descent."
msgstr ""
"발더스 게이트로 향하던 길이었네만, 이제 돌아가기엔 너무 멀리 와버렸네. 엘투렐은 하강 사건 이후로 티플링들이 설 곳이 사라졌다네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 65645649-8d25-ba25-f715-921f5ef6d761
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:65645649-8d25-ba25-f715-921f5ef6d761
msgctxt "hb6c1f8d3g6d33g4bcegb4f8g8f3234eeb886"
msgid "Leaders need to make tough decisions. We do what we must."
msgstr "지도자는 어려운 결정을 내릴 필요가 있네. 우리는 반드시 해야 할 일을 하는 것이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 657c5c58-26c6-cd84-9e1b-e7f51afecbbb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:657c5c58-26c6-cd84-9e1b-e7f51afecbbb
msgctxt "h53be137ag18e1g4813g8002g12d03057ea2d"
msgid ""
"Hah - a fair point. We can only hope the citizens of Baldur's Gate are more "
"open-minded."
msgstr "하, 좋은 지적이네. 우리로선 발더스 게이트 시민들이 더 개방적이기를 바랄 수밖에."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Wyll
#. NodeID = 65daa8f8-0820-8831-c5ee-6e49cf5177ab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:65daa8f8-0820-8831-c5ee-6e49cf5177ab
msgctxt "h10f9f8d5ge69bg4aaag8ce5gf2ffc8a826c3"
msgid "These poor souls seek a champion - and you turn your back?"
msgstr "이 불쌍한 영혼들이 구원자를 찾고 있는데, 그들에게서 등을 돌리겠다는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 676720b6-04c0-855a-b0f7-8ede0f074b61
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:676720b6-04c0-855a-b0f7-8ede0f074b61
msgctxt "h7e1c7deagf8dcg4886gad7ag6f15e6d04c14"
msgid "Is there a place for tieflings anywhere?"
msgstr "티플링들을 위한 곳이 있기는 합니까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 6a01ee7a-4515-162b-5226-a423d7f2673f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:6a01ee7a-4515-162b-5226-a423d7f2673f
msgctxt "hffdd2801g7b77g41fcga383g4fa322a6b081"
msgid ""
"And so will you, if you ever interfere in my business again. <i>That </i>I "
"promise you."
msgstr "또 다시 내 일에 끼어들거든 자네 역시 다치게 될 걸세. <i>분명히</i> 약속하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 6a09816d-99b4-6aaa-473e-05e52e2f50e9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingRefugees_Quest_HuntRewardOffered = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:6a09816d-99b4-6aaa-473e-05e52e2f50e9
msgctxt "hf3235598g1e28g47fcga0d0gb293cbef1a1b"
msgid ""
"I took a collection - from all of us. It isn't much, but you've earned it."
msgstr "내가 우리 모두에게서 기부금을 모았네. 많은 양은 아니지만, 자네는 받을 자격이 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 6a7955b4-e52a-b478-128d-c5580b205485
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:6a7955b4-e52a-b478-128d-c5580b205485
msgctxt "ha231de55g5427g4e04g8f8cg96a74ef9fe7c"
msgid ""
"Thank you - we still have the goblins to contend with, but you've given us "
"time to prepare."
msgstr "고맙네. 우리는 여전히 고블린과 다투어야 하지만, 자네는 우리에게 시간을 벌어주었네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 6ae5cee5-fdfe-be91-4771-76cec097485e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_State_HelpDeclined = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:6ae5cee5-fdfe-be91-4771-76cec097485e
msgctxt "h3ee7bef3gc7f9g4de8g8347g579273e5d6c0"
msgid "Enough about the ritual. I have my own problems."
msgstr "의식 이야기는 충분히 들었습니다. 저도 제 문제가 급합니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 6c5776a4-9961-2e5a-6ec0-231291928dc8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 34c3046f-4a32-f165-c262-24d2af9e0114_A = True
#. TagRule: DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:6c5776a4-9961-2e5a-6ec0-231291928dc8
msgctxt "h0ae6a2f1g350fg47fdg8507g5e38d387041f"
msgid "Spare me your platitudes about my people. I don't need them."
msgstr "내 동족에 대한 진부한 이야기는 접어둬. 내겐 필요 없으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 6d88cfaf-86da-9550-e935-5e35cfb30466
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingLeader_HasMet_ReactToDruidAttack = False
#.      - DEN_TieflingLeader_Quest_GobHuntResponded = False
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#. SetFlags:
#.   Global:
#.     - DEN_TieflingLeader_HasMet_ReactToDruidAttack = True
#.     - DEN_TieflingLeader_State_KaghaResolved = True
#.   Quest:
#.     - DEN_Conflict_SUB_Murder.ZevlorRewarded(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:6d88cfaf-86da-9550-e935-5e35cfb30466
msgctxt "hb6353e6bg2c4fg49aaga919gb05bad06574b"
msgid ""
"I didn't want this. It was supposed to be <i>just </i>Kagha... but thank you."
msgstr "이런 걸 원한 건 아니었어. 그저 카그하 <i>하나만</i> 없애면 됐던건데... 그래도 고맙네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 6e5c692e-ddfd-b82a-32ea-434958007a22
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:6e5c692e-ddfd-b82a-32ea-434958007a22
msgctxt "h7e277d56g9194g4c83g9eceg0ffb79fab153"
msgid ""
"Hah - a fair point. We can only hope the citizens of Baldur's Gate are more "
"open-minded."
msgstr "하, 좋은 지적이네. 우리로선 발더스 게이트 시민들이 더 개방적이기를 바랄 수밖에."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 6f0b038d-bf75-d527-0a1b-ab12815e0252
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:6f0b038d-bf75-d527-0a1b-ab12815e0252
msgctxt "hb3bf7561ge869g4cbfg9c38gcaa67e0ebd23"
msgid "I'm still hoping Kagha can be swayed from this madness. But if not..."
msgstr "나는 지금도 카그하가 이 광기에서 벗어날 수 있길 바라네. 하지만 그러지 못한다면..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 6fadb574-1666-56c9-fbde-5b87d98c5607
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:6fadb574-1666-56c9-fbde-5b87d98c5607
msgctxt "h9153c2a9g81eag4cb4gbdc9ga3da088a218f"
msgid "Whatever you decide, I'm not involved in any of this."
msgstr "자네가 어떤 결정을 내리든, 난 이 일과 관련 없는 걸세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 7077fddd-c7c2-76f3-f7e7-c1914d9e11b7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:7077fddd-c7c2-76f3-f7e7-c1914d9e11b7
msgctxt "hb99c4ae0gab7eg4827ga678g87d7aef65c86"
msgid ""
"We can't stay, but we'll be slaughtered if we leave - we're no fighters."
msgstr "여기에 머무를 수도 없지만, 떠난다고 해도, 도륙나 버릴 걸세. 우린 전사가 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 71529c4b-d417-8c28-e517-9af1d04acc8c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_TieflingLeader_Quest_GobHuntResponded = True
#.     - DEN_TieflingLeader_Quest_GobHuntDeclined = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:71529c4b-d417-8c28-e517-9af1d04acc8c
msgctxt "h22b4d712ga052g44cfg8dafgd9d53d14aaef"
msgid "I have other things to worry about."
msgstr "나는 걱정해야 할 다른 일들이 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 7235b1b3-c476-a42a-4cf6-f1ac94d41cd2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:7235b1b3-c476-a42a-4cf6-f1ac94d41cd2
msgctxt "h99e2ee69g5078g4a43gbac7g0f4f05f50afd"
msgid ""
"So long as Kagha leads them, we'll never be safe here. If you're suggesting "
"we remove her..."
msgstr "카그하가 그들을 이끄는 한, 우리는 이곳에서 안전하지 못할 것이네. 만약 그녀를 없애자고 제안하는 것이면..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 737ddc79-d6d5-e6e2-192e-fc616c221aea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:737ddc79-d6d5-e6e2-192e-fc616c221aea
msgctxt "h9a1589b6g25a5g4d12g87c9g55f564da1192"
msgid "To get these people to Baldur's Gate? <i>Everything.</i>"
msgstr "이 사람들을 발더스 게이트로 이끄는 것 말인가? 나의 <i>전부라네.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 7428cd47-676f-b835-4604-1432c294b2b8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:7428cd47-676f-b835-4604-1432c294b2b8
msgctxt "h92d85252gd9adg4891g933dg91e39d8ee747"
msgid ""
"Truly? I'm sorry it had to come to this, but she left us with no choice."
msgstr "정말인가? 이렇게까지 돼서 유감스럽지만, 그녀는 우리에게 선택의 여지를 주지 않았네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 747e5c9e-0485-7b3a-0b71-0169c658cfaa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:747e5c9e-0485-7b3a-0b71-0169c658cfaa
msgctxt "h92b64b26g9458g47c5ga796g8dc8713bb801"
msgid "If you'll excuse me - I'd best get my people moving."
msgstr "이만 실례하겠네. 내 동족들을 계속 이동시켜야 해서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 749f972b-84ce-2ce6-c055-493742b39fc6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:749f972b-84ce-2ce6-c055-493742b39fc6
msgctxt "hadf01ddeg239cg4cddga3f2gb27ca9788b09"
msgid "You saw what they were willing to do to a child just for trying."
msgstr "시도했다는 이유만으로 아이에게 그들이 어떤 짓을 하려고 했는지 자네도 봤잖나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Wyll
#. NodeID = 758a6415-002b-bddc-2fa0-260615add218
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Zevlor_State_KnowsWyllDevil = False
#.   Script:
#.      - GEN_IsSpeakerPresent_7 = True
#.   Tag:
#.      - WYLL_DEVIL(6) = True
#. SetFlags:
#.   Global:
#.     - GLO_Zevlor_State_KnowsWyllDevil = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:758a6415-002b-bddc-2fa0-260615add218
msgctxt "h6533b420g2f13g448egab4ega03de3d207d4"
msgid "Zevlor."
msgstr "제블로어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Wyll
#. NodeID = 75ad3bc8-4c4c-974e-ed7a-fa0ab06bd464
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:75ad3bc8-4c4c-974e-ed7a-fa0ab06bd464
msgctxt "haa95dff1g1654g42d8g8e92gd9622ac611ff"
msgid "I paid the price of angering the wrong devil."
msgstr "데빌을 잘못 건드린 대가를 치뤘지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 76a43f79-dfb6-72de-322a-a7ef614b7f2d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:76a43f79-dfb6-72de-322a-a7ef614b7f2d
msgctxt "hc7c0fb63g0640g42dagaa7bg9372cd16e6a8"
msgid ""
"It's good of you to offer, but there's a whole army of goblins out there."
msgstr "제의는 고맙네. 그러나 밖에는 여전히 고블린 대군이 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 76b0cc3d-cfb5-97a1-393b-9020f0f4f216
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Apprentice_Knows_HeardAboutNettie = False
#.      - DEN_Apprentice_UserShortcut = False
#.      - DEN_Apprentice_State_Dead = False
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Knows_HeardAboutNettie_PartialInfo = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:76b0cc3d-cfb5-97a1-393b-9020f0f4f216
msgctxt "h89b84ddfgd461g49d9g8397gee7e2f59ecbc"
msgid "I don't have time. I need a healer - fast."
msgstr "저는 시간이 없습니다. 빨리 치유사를 찾아야 해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 76e83691-d897-dbe8-2038-3b66456ddf1b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:76e83691-d897-dbe8-2038-3b66456ddf1b
msgctxt "hadfefd21g1e01g43d9gb2cfg3f527f11d846"
msgid "I understand. I can only thank you for the help you've already given."
msgstr "이해하겠네. 이미 도와준 것만으로도 감사할 수밖에."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 7740ef75-cd45-2f61-98d2-598468507f6f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:7740ef75-cd45-2f61-98d2-598468507f6f
msgctxt "hf791ac58g9d08g4492g85f7g4f7382a579e6"
msgid ""
"So I hoped. But we've lost so many already - and more will die if we're "
"forced out again."
msgstr "나도 바라는 바네. 허나 우리는 지금도 너무나 많은 이를 잃었어. 그리고 우리가 쫓겨난다면 더 많은 이들이 또 죽어 나갈 걸세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 77521920-cbcc-b07c-322e-c85f886adf01
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_TieflingLeader_Quest_GobHuntResponded = True
#.     - DEN_TieflingLeader_Quest_GobHuntDeclined = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:77521920-cbcc-b07c-322e-c85f886adf01
msgctxt "h4dd74451g7ef1g476dgbab1ge922a50a0dcd"
msgid "This isn't my problem."
msgstr "이건 제 문제가 아닙니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 7aaea3f8-7d3b-bc1d-ad49-b84c1997c253
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingLeader_State_TalkedAboutMurder = False
#. SetFlags:
#.   Global:
#.     - DEN_TieflingLeader_State_TalkedAboutMurder = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:7aaea3f8-7d3b-bc1d-ad49-b84c1997c253
msgctxt "heeb57e65gb33bg4021gb28bg8d727714f838"
msgid "Then why don't you get rid of her?"
msgstr "그럼 그녀를 제거하는 건 어떻습니까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 7d31d2f6-91d4-b520-dbf0-2fec3d718adb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:7d31d2f6-91d4-b520-dbf0-2fec3d718adb
msgctxt "hb3b14c03g21dfg41ebg83begd77a3d422399"
msgid ""
"You, though... I know it's not your business, but she owes you for saving "
"this place."
msgstr "자네라면... 자네와 아무 상관 없는 일인 줄은 알지만, 그녀는 자네가 여길 구해준 데에 빚을 졌네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 7e02b8f7-909d-8f87-a9b8-77fe939430b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:7e02b8f7-909d-8f87-a9b8-77fe939430b4
msgctxt "hd645e2cbg236fg40deg82b1g05e4c197c7af"
msgid ""
"I won't give her the satisfaction. I'll get my people clear of this - but on "
"our terms."
msgstr "그녀의 뜻대로 되지 않을 거야. 내 사람들을 지켜야 하네, 단 우리만의 방식으로."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 7f06330d-4c7b-3d49-d437-d0bdf0373dec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:7f06330d-4c7b-3d49-d437-d0bdf0373dec
msgctxt "hf9246387g2393g4949g94e2g458923829490"
msgid "Believe me - I understand better than most."
msgstr "날 믿게, 그 누구보다 자네 상황을 잘 이해할 걸세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 7f16f441-9884-f166-ca23-eb454da5ea01
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:7f16f441-9884-f166-ca23-eb454da5ea01
msgctxt "h824865c7g6ae8g407dgb231g9ed52240d18d"
msgid "Let me guess - you want something."
msgstr "보아하니 또 뭘 해 달라는 거군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 7fd38330-adf7-af10-d0a8-8385e7357761
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:7fd38330-adf7-af10-d0a8-8385e7357761
msgctxt "h91d73b36g0169g4ea2gbfe1g9d151b5490b1"
msgid "You've done so much for us - and I have more yet to ask."
msgstr "자네가 우리를 위해 해준 것이 정말로 많지만... 그래도 더 부탁할 수밖에 없군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 80f5375b-7296-2366-7068-49052da1914c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:80f5375b-7296-2366-7068-49052da1914c
msgctxt "habd3c4a8g60acg40c7g9a19g4aeff1b325a0"
msgid ""
"This grove is poorer for losing Halsin, but I have my own people's concerns "
"to look to."
msgstr "할신의 실종은 이 숲의 안타까운 손실이지만, 나로서는 내 동족들 일부터 살펴야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Karlach
#. NodeID = 82640bd7-5b0d-de07-cec7-97063ee82ddc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:82640bd7-5b0d-de07-cec7-97063ee82ddc
msgctxt "hc29d4e05g8767g4399g8991g59ef867f69ee"
msgid "We can't abandon all these people. Right?"
msgstr "이 사람들을 그냥 버릴 수는 없어. 그치?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 8385c49a-f075-f837-d024-1cb4c214f6e1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:8385c49a-f075-f837-d024-1cb4c214f6e1
msgctxt "h2989d47bg9356g4732gadb3g7df9dfe53447"
msgid ""
"Lucky for us, a group of adventurers found a way to bring the city back."
msgstr "다행히, 한 무리의 모험가들이 도시를 다시 지상으로 올릴 방법을 찾았다네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 83e1ec9c-3e64-425b-a954-6610dc816c43
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_7 = True
#.   Tag:
#.      - WYLL_DEVIL(6) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:83e1ec9c-3e64-425b-a954-6610dc816c43
msgctxt "hcb8f6aafg792ag4276ga430g25c6b470dcd1"
msgid ""
"The Blade of Frontiers has done what he can to help us prepare for the "
"journey, and we're grateful, but it'll be a short journey if the goblins "
"still own the roads."
msgstr ""
"변경의 칼날이 여행 준비를 일부 도운 건 감사하게 생각하지만, 고블린들이 여전히 길을 장악하고 있다면 우리의 여정은 짧게 끝나게 될 걸세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 8425fe2c-9320-5ec3-cd4e-ddcc4edeccae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:8425fe2c-9320-5ec3-cd4e-ddcc4edeccae
msgctxt "h2b858a46gab41g43dfg85fag796c8599749c"
msgid ""
"I'll survive a sore jaw. And <i>you'll </i>survive as long as you keep your "
"hands to yourself."
msgstr "턱이 좀 아픈 것 정도로 죽진 않겠지. 하지만 <i>자네</i>는 주먹을 아껴야 살아남을 수 있을 걸세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 845e9777-f0e2-d1df-f3e2-be597fd6e22e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:845e9777-f0e2-d1df-f3e2-be597fd6e22e
#, fuzzy
msgctxt "heb36cbd4g61f3g4b55g813bgebed71922336"
msgid "Let's go there right away."
msgstr "저도 준비됐어요 - 가시죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Narrator
#. NodeID = 84824e4a-06e3-85c9-64bb-3c3f79996c7a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Zevlor_State_KnowsWyllDevil = False
#.   Tag:
#.      - WYLL_DEVIL(1) = True
#.      - REALLY_WYLL(1) = True
#. SetFlags:
#.   Global:
#.     - GLO_Zevlor_State_KnowsWyllDevil = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:84824e4a-06e3-85c9-64bb-3c3f79996c7a
msgctxt "h506f5b0fgbe30g45f2gb83egab46be2d436e"
msgid "*Confusion crosses Zevlor's eyes as he takes you in.*"
msgstr "*당신을 보자마자 제블로어의 눈에 혼란이 스칩니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 853f8da3-c861-0144-4b12-b16b2c3bb1ea
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_TieflingLeader_ReassuredDrow(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_TieflingLeader_ReassuredDrow(1) = True
#. TagRule: DROWELF or DROWHALFELF
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:853f8da3-c861-0144-4b12-b16b2c3bb1ea
msgctxt "h93effd18g6881g49e7g9f94gd6938c7c9349"
msgid ""
"We're raised to fear the drow, but you've earned your place here. I'll make "
"sure everyone here knows that."
msgstr "자라면서 드로우들은 두려운 존재라고 배웠지만, 자넨 여기 있을 자격을 스스로 얻어냈군. 다른 사람들에게도 이 사실을 전하겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 86b1b88d-188c-f4fd-88b0-492f0533620f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_TieflingLeader_Event_GaveName(1) = True
#. TagRule: REALLY_TIEFLING
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:86b1b88d-188c-f4fd-88b0-492f0533620f
msgctxt "h5bb98cb5gad5cg46f5gb3b6gddeac3c6736d"
msgid ""
"Nice to meet another tiefling - these parts are... less than friendly. I'm "
"Zevlor. And you're...?"
msgstr "다른 티플링을 만나니 반갑군, 지금 상황은... 썩 반갑지 못하지만. 나는 제블로어라고 하네. 자네는...?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 86b1b88d-188c-f4fd-88b0-492f0533620f
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_TieflingLeader_Event_GaveName(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:86b1b88d-188c-f4fd-88b0-492f0533620f
msgctxt "hdd84e22cge819g4af3g9b6fg0da86b5a9939"
msgid "I'm Zevlor. And you're...?"
msgstr "난 제블로어라고 하네. 그리고 자네는...?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 87b45923-7287-effd-ab8e-9e9a875b4153
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:87b45923-7287-effd-ab8e-9e9a875b4153
msgctxt "h9bfcc006g13d4g4bcfg8e1agb196076f3774"
msgid "Right. He's been going on about something of the sort."
msgstr "그렇군. 그 친구가 계속 그런 이야기를 늘어놓고 있긴 했지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 87db7fdc-5eb5-0df5-218a-915194f468cb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_RaidingParty_Event_KnockOutTiefling = True
#.      - DEN_RaidingParty_Event_PlayerDidTheKO = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:87db7fdc-5eb5-0df5-218a-915194f468cb
msgctxt "h9d416e41g2e18g4394g9198ga93c1de8d011"
msgid "It will be smart for both of us to make allies of enemies."
msgstr "아무래도 우리 적들에 맞서 동맹을 맺는 게 좋을 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 87e825d0-79e6-2a9e-e39c-e710a46b33ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:87e825d0-79e6-2a9e-e39c-e710a46b33ec
msgctxt "h30c28e3egbbb1g4d29gb5c7g1f6f145385c3"
msgid ""
"Not so fast. After what you did at the gate, I'd like to know who I've let "
"inside these walls."
msgstr "서두르지 말게. 관문에서 자네의 활약을 보고 나니, 내가 누구를 방책 안으로 들여보낸 건지 알고 싶군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 89ee470e-53e2-620e-5b92-0a941b2f354c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:89ee470e-53e2-620e-5b92-0a941b2f354c
msgctxt "h49fdd9beg114dg4bb3gb79fgfde64f84cbbd"
msgid ""
"You've bought us some time here. But the goblins are still massing out there."
msgstr "자네는 우리에게 이곳에 머무를 시간을 벌어주었네. 다만 고블린들은 아직 저 밖에서 무리를 짓고 있네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 8a6aea2c-6f28-ce2c-98e9-3dbf1738c42d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:8a6aea2c-6f28-ce2c-98e9-3dbf1738c42d
msgctxt "h166b11f8ga3dfg42d2g99a6gc56fa9ff662a"
msgid "I paid the price of angering the wrong devil."
msgstr "데빌을 잘못 건드린 대가를 치뤘지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 8d826fdd-1add-28dd-0d3d-ad758f8790c2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_TieflingLeader_Event_GaveName(1) = False
#. SetFlags:
#.   Object:
#.     - DEN_TieflingLeader_Event_GaveName(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:8d826fdd-1add-28dd-0d3d-ad758f8790c2
msgctxt "h315fad4fgbd97g41c4gbc98ga7e887ce48ee"
msgid "I'm [GEN_PlayerName_c11eee1e-7815-6143-7233-f2427799fa53]."
msgstr "전 [GEN_PlayerName_c11eee1e-7815-6143-7233-f2427799fa53]입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 8db1900b-90b1-bb5f-8533-95a0bd1d8551
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingLeader_Quest_GobHuntResponded = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:8db1900b-90b1-bb5f-8533-95a0bd1d8551
msgctxt "h24438045g695cg4a0agb2efg618005e6be39"
msgid "Surely your people can fight off a few goblins."
msgstr "당신네 사람들이 고블린 몇 마리 정도는 쓰러뜨릴 수 있겠죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 8f3c764e-f19b-4e4d-a7d0-15660d076ddf
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_TieflingLeader_HasMet_AdvisedStay = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:8f3c764e-f19b-4e4d-a7d0-15660d076ddf
msgctxt "h66cd8306ge418g44bcga8ffg3c43c0c23d79"
msgid "Can you delay the ritual?"
msgstr "당신이 의식을 미룰 수 있습니까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 8f82550d-8669-aaf5-ee43-39cb23ebed57
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:8f82550d-8669-aaf5-ee43-39cb23ebed57
msgctxt "h59fccab2g0fbdg4013g8ce7gb4afd9a6ae09"
msgid "You'll find him in camp. What do you want with him?"
msgstr "여기 야영지에 있네만. 무슨 용무로 찾는 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Narrator
#. NodeID = 8febd137-5a0c-e95b-fc3a-d6de52330fb1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:8febd137-5a0c-e95b-fc3a-d6de52330fb1
msgctxt "he1f3c4f4g2390g454dga137g2a28fd55b0d3"
msgid ""
"*A moment passes as Zevlor contemplates your face. He then turns his "
"attentions elsewhere.*"
msgstr "*제블로어가 당신의 얼굴을 응시하는 동안 잠시 시간이 흘렀습니다. 그는 이제 다른 곳으로 시선을 돌립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 9013cf47-b01a-e611-bbe6-dea4804aebee
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_IsMissing = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:9013cf47-b01a-e611-bbe6-dea4804aebee
msgctxt "hff96bbd8g89a6g409dga681g28a45fb36aac"
msgid "Why did Halsin go with the adventurers?"
msgstr "할신은 왜 모험가들을 따라나섰던 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 902fa165-0277-f86c-984d-ad124d469661
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_Quest_AgreedToMurder = True
#.      - DEN_TieflingLeader_State_KaghaResolved = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:902fa165-0277-f86c-984d-ad124d469661
msgctxt "h3b562d9fg9c46g44acga6adg215ce70ebdf8"
msgid "Any word on... what we discussed? About Kagha?"
msgstr "이야기 했던 것 중에... 할 말 있나? 카그하에 대해서?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 90e9ce4c-07ba-a95f-5206-523c591e3c44
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Apprentice_Knows_HeardAboutNettie = False
#.      - DEN_Apprentice_UserShortcut = False
#.      - DEN_Apprentice_State_Dead = False
#. TagRule: REALLY_DARK_URGE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:90e9ce4c-07ba-a95f-5206-523c591e3c44
msgctxt "h9d8334dcg7af4g444fgbfacgba7c127d67d2"
msgid "Perhaps if you could help me find a healer."
msgstr "당신이 치유사를 찾는 걸 도와줄 수 있다면 또 모르죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 90e9ce4c-07ba-a95f-5206-523c591e3c44
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Apprentice_Knows_HeardAboutNettie = False
#.      - DEN_Apprentice_UserShortcut = False
#.      - DEN_Apprentice_State_Dead = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:90e9ce4c-07ba-a95f-5206-523c591e3c44
msgctxt "hc3212da2gdaf7g4493ga3e8g3024dc8e0e59"
msgid "I have my own temporal concerns. I need a healer."
msgstr "저에게는 시간이 촉박한 문제가 있습니다. 치유사가 필요합니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 9128885c-b9de-ea7a-6762-7b928d08f57e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:9128885c-b9de-ea7a-6762-7b928d08f57e
msgctxt "hd254aea0gc5cfg42b5ga601g8ffc042624f1"
msgid ""
"Well met. Though I should warn you - visitors are no longer welcome in this "
"grove."
msgstr "만나서 반갑네. 하지만 경고를 해줘야겠군. 이제 이 숲에서 방문객은 환영받지 못한다네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 92096e81-ef58-c615-ae9d-1bdb7ddad8be
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:92096e81-ef58-c615-ae9d-1bdb7ddad8be
msgctxt "h60e6bc6age471g44e6gbc0eg26c8d94fcc79"
msgid "This latest attack will only strengthen their resolve."
msgstr "이 공격으로 그들의 생각이 더 확고해졌을 걸세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 922b4461-518d-fe3b-0dba-5f8fe5fc3bf7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:922b4461-518d-fe3b-0dba-5f8fe5fc3bf7
msgctxt "h24191cb0g41d7g4305g976dgddf97ccbe205"
msgid ""
"It's sparse thanks for what you've done for us - and I'm afraid I have more "
"yet to ask."
msgstr "자네가 우리에게 해준 일에 대한 감사의 표시일세. 그리고 송구스럽지만 아직 부탁할 일이 더 있네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Karlach
#. NodeID = 929f46d6-4901-49e4-99ea-44a0b3834da6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:929f46d6-4901-49e4-99ea-44a0b3834da6
msgctxt "h6dbb0d9dga44bg475eg9aa9g826d8ff1c2f5"
msgid "Excuse you."
msgstr "너, 말조심해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 936d2b3c-90b2-b0cf-5af8-fe6fda5a7f2d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:936d2b3c-90b2-b0cf-5af8-fe6fda5a7f2d
msgctxt "h033b3f47g5becg4a44g8696gfbef196049a9"
msgid "Everyone in this camp depends on it. Thank you."
msgstr "이 야영지에 있는 모두의 운명이 이에 달려 있네. 고맙네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 939e8928-0634-4d87-58fe-6ef008ffb5ce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:939e8928-0634-4d87-58fe-6ef008ffb5ce
msgctxt "h6a5b91b0g0e9cg4927g9cc0g23f6dd47868f"
msgid "They've withdrawn there to prepare this damn ritual of theirs."
msgstr "그들은 자기들의 망할 의식을 준비하기 위해 그곳으로 철수했다네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 941304c2-f356-0c67-5383-cc5f5a22e5b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:941304c2-f356-0c67-5383-cc5f5a22e5b3
msgctxt "h76e3127fg4606g47e1g87cagbb20d6e15a94"
msgid ""
"I wish we could ride to his rescue, but my people would just wind up "
"slaughtered along with him."
msgstr "사람들을 꾸려 구하러 가고는 싶네만, 내 동족들은 가봤자 그랑 함께 도살당하기만 할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 9557ba2f-9741-b351-9ced-90920d23b27f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:9557ba2f-9741-b351-9ced-90920d23b27f
msgctxt "h4263826dgd09bg4d3agbce5g200f2a9ddc91"
msgid ""
"Gods above. This is wonderful news, but... I've <i>seen</i> what goblins do "
"to their captives."
msgstr "신들이시여. 그건 반가운 소식이지만... 난 고블린들이 포로에게 뭔 짓을 하는지 <i>직접 봤다네</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 95bd7857-fb61-049a-1511-c41b33676649
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:95bd7857-fb61-049a-1511-c41b33676649
msgctxt "h0a83ea27g6557g4473g977fg7328ed9dc2cf"
msgid "I'm surprised you haven't heard of it."
msgstr "처음 듣는다니 놀랍군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 96e4c519-648b-918e-384b-7c51d58fd655
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Knows_WentWithAdventurers = True
#.   Quest:
#.     - GLO_Tadpole_SUB_Druid.LearnedLostHalsin(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:96e4c519-648b-918e-384b-7c51d58fd655
msgctxt "hbd28b650g47acg490egac4fgc52b9f4af7cf"
msgid ""
"You're wounded? The druid Halsin's a renowned healer, but he didn't make it "
"back from Aradin's <i>expedition</i>."
msgstr "부상을 입었나? 드루이드 할신은 유명한 치유사지만, 그는 아라딘의 <i>원정</i>에서 돌아오지 못했네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 96e6503b-7448-a3bd-926e-37d944bf3ef0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingLeader_State_KaghaResolved = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:96e6503b-7448-a3bd-926e-37d944bf3ef0
msgctxt "h7270b02dg938dg4c38gbd94g77db52965e6e"
msgid "Yes?"
msgstr "응?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 974045b6-da61-0566-7575-10f6e0980f33
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:974045b6-da61-0566-7575-10f6e0980f33
msgctxt "hd10cba69g4916g46c7gb278g6b9a45d80b08"
msgid "We'll see you there."
msgstr "나중에 야영지에서 뵙죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Karlach
#. NodeID = 9a1ed842-1ad4-43e5-9819-6d2ef8256780
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Tieflings_Knows_DescentIntoAvernus = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:9a1ed842-1ad4-43e5-9819-6d2ef8256780
msgctxt "h0bee9f9bg12dfg4c79g8c2egdd78730f02f1"
msgid ""
"Gods, these are <i>those </i>tiefs? Their whole city was dragged into "
"Avernus for a while. Zariel was <i>delighted. </i>When they made it back "
"out, I'd hoped they got their happy ending."
msgstr ""
"세상에, 그때 <i>그</i> 티플링 친구들이야? 한동안 도시 전체가 아베르누스로 끌려 내려가서 살았어. 자리엘이 아주 <i>좋아라</"
"i> 했지. 그 사람들이 도로 탈출하는 걸 보면서 좋은 결말을 맞기를 바랐는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 9a832181-052c-fee7-e32c-7bb015bc0d2b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingLeader_Quest_GobHuntResponded = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:9a832181-052c-fee7-e32c-7bb015bc0d2b
msgctxt "hda519d7fg6e3cg4e82g88b0gd38a89439526"
msgid ""
"Please, just <i>listen</i> - sending us out there is a death sentence. But "
"there is another way."
msgstr "제발, 내 말 좀 <i>들어주게</i> - 우리를 저 밖으로 내보내는 건 사형선고나 다름없네. 하지만 다른 방법이 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 9b0ed198-5c21-3dc6-a8e6-c7246cae85b9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:9b0ed198-5c21-3dc6-a8e6-c7246cae85b9
msgctxt "hc6937b9bg226eg4d87g8539g6060b0d2e03d"
msgid ""
"We thought we'd found sanctuary here, but the druids have determined to turn "
"us out."
msgstr "이곳을 은신처삼을 수 있을 줄 알았건만, 드루이드들이 우리를 내쫓기로 단단히 작정한 것 같네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 9c3f76d5-fb1c-98fc-6d43-c24ac78a50bd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:9c3f76d5-fb1c-98fc-6d43-c24ac78a50bd
msgctxt "he608298dg0ee0g40f5g91ddgea53e515026d"
msgid "Thank you."
msgstr "고마워요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 9cbff222-2236-1202-5750-795f9afd0e4a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_State_DruidsPacified = False
#.      - DEN_GroveConflict_Quest_AcceptedKagha = True
#.      - DEN_TieflingLeader_State_KaghaResolved = False
#.      - DEN_ShadowDruid_State_KaghaIsDead = False
#.   Tag:
#.      - REALLY_WYLL(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:9cbff222-2236-1202-5750-795f9afd0e4a
msgctxt "h79a6dd19gb066g411fg9d14g4236116f7ae0"
msgid "Time's up - I've been asked to escort you out of here."
msgstr "시간이 다 됐어. 나는 당신들을 바깥으로 모셔다 주라는 요청을 받았다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 9d708557-ea24-1fc3-9cc3-45bcf17f400c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:9d708557-ea24-1fc3-9cc3-45bcf17f400c
msgctxt "hb3f5c4fbg5897g46b6g8d5eg1d7bb1a1d319"
msgid "If your people survived that, they'll survive anything."
msgstr "당신의 동족이 그로부터 살아남았다면, 무엇이든 살아남을 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 9f2f030a-00b2-16de-4c78-04bea0efb25f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:9f2f030a-00b2-16de-4c78-04bea0efb25f
msgctxt "hb833b03fg3dc7g483bg92d3g46f504d28bef"
msgid ""
"You'd be well rewarded for the risk. But if that won't sway you, there's "
"nothing more to discuss."
msgstr "자네는 이 위험에 대한 보상을 후하게 받을 것이네. 그래도 자네가 혹하지 않는다면 더 이상 논의할 것이 없네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = 9fffb85f-0eb0-5ff6-68f7-8961897df1fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:9fffb85f-0eb0-5ff6-68f7-8961897df1fd
msgctxt "h10760908ge7a6g4469gafcfg6ffbc2aaf925"
msgid "That depends - can you pay me?"
msgstr "저에게 보수를 줄 수 있는지에 달려 있죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = a118bb22-93a2-d6ce-3044-f618736aa1d9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_Knows_HeardAboutRitual = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:a118bb22-93a2-d6ce-3044-f618736aa1d9
msgctxt "hd9584020g442eg43a4gba18ga98b67657d34"
msgid "They've started a ritual to cut the grove off from the world outside."
msgstr "그들이 이 숲을 외부 세계와 단절시키는 의식을 시작했네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = a465df14-93dd-8bfc-f7dd-8d6eb9c794e6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Tieflings_Knows_DescentIntoAvernus = False
#. SetFlags:
#.   Global:
#.     - GLO_Tieflings_Knows_DescentIntoAvernus = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:a465df14-93dd-8bfc-f7dd-8d6eb9c794e6
msgctxt "h4ec30ac9gd6a7g4d54g9008g22f9f0700721"
msgid "'The Descent'? What is that?"
msgstr "'하강'? 그게 뭐죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = a5f8bf54-63e5-d06f-2626-75e1ba79ce69
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:a5f8bf54-63e5-d06f-2626-75e1ba79ce69
msgctxt "h1a9c478egdc1eg4f2ag8caag1bc3a59d3a92"
msgid "Loose tongue, bruised jaw - perhaps they're related?"
msgstr "턱이 아프니 혀가 길어지는군, 둘이 연관성이 있던가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = a741eb55-7916-5be7-bf9f-3d5b719fadd4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AdventurerLeader_State_PermaDefeated = True
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Knows_WentWithAdventurers = True
#.     - GLO_Halsin_Knows_IsMissing = True
#.   Quest:
#.     - GLO_Tadpole_SUB_Druid.LearnedLostHalsin(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:a741eb55-7916-5be7-bf9f-3d5b719fadd4
msgctxt "he7b384fdgc2cdg4fb0gba63gf037901e9a6d"
msgid ""
"You're wounded? The druid Halsin's a renowned healer, but he went with those "
"adventurers. It seems they left him behind."
msgstr ""
"부상을 입었나? 드루이드 할신은 유명한 치유사지만, 그는 아라딘의 <i>원정</i>에서 돌아오지 못했네. 저들이 그를 두고 떠난 듯하군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = a7ea54db-87aa-abc7-c3a4-922738c9ca8f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:a7ea54db-87aa-abc7-c3a4-922738c9ca8f
msgctxt "hc71dc364ga192g4976gbebcg1d53e52893d2"
msgid ""
"If you can clear the road of goblins as you say, I'll ensure a reward is "
"gathered for you."
msgstr "자네가 말한 대로 고블린의 길을 정리해 주면, 보상을 준비해 주겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = a859cdc8-1f35-bac6-b602-ddb509e4fffd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_GoblinHunt_Event_GiveRewardBag(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:a859cdc8-1f35-bac6-b602-ddb509e4fffd
msgctxt "hae73e67dg8849g448bgb6a3gdd8c2c19bfd5"
msgid "It's not enough, but it's all we have."
msgstr "충분하진 않지만, 이게 우리가 가진 전부라네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = a8c650aa-a63c-b7b9-1737-0735adea50fa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:a8c650aa-a63c-b7b9-1737-0735adea50fa
msgctxt "hc44d367cgfd93g4dbfg90c5g416ab534fe0c"
msgid "Just passing through."
msgstr "그냥 지나가는 길이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = aca1c4c3-67c9-31e3-208d-4fb51d3d60a4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingLeader_HasMet_AdvisedStay = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:aca1c4c3-67c9-31e3-208d-4fb51d3d60a4
msgctxt "h0f284613gc5dcg4544g9182g1dbd29919188"
msgid ""
"Our time grows short. If Kagha won't abandon her madness, then we'll have to "
"try the road - goblins or no."
msgstr "시간이 별로 없네. 만약 카그하가 광기를 버리지 못한다면, 우리는 고블린이 있든 없든 길에 나가야만 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = ad64b99b-fe01-2561-ca3b-5f8e94491e5f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:ad64b99b-fe01-2561-ca3b-5f8e94491e5f
msgctxt "hcdd48496g6a17g4e52g81b1gb3980c03d699"
msgid "Outsiders, perhaps. But not me."
msgstr "외부인이라면 그럴지도 모르지. 하지만 난 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = adbb9dc1-2ed4-6704-3649-cdc8561666e9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:adbb9dc1-2ed4-6704-3649-cdc8561666e9
msgctxt "ha3b49286g73beg4c60ga8b7gbc8f0bd66b8d"
msgid "Is there a place for tieflings anywhere?"
msgstr "티플링들을 위한 곳이 있기는 합니까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Narrator
#. NodeID = ae31885d-660f-9175-dd04-4bff9f2e13c0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Tieflings_Knows_DescentIntoAvernus = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:ae31885d-660f-9175-dd04-4bff9f2e13c0
msgctxt "h57420ba1gbf8eg4ac9g874ag86acfdae9136"
msgid ""
"*'The Descent' - an infernal conspiracy that had seen the entire city of "
"Elturel briefly dragged to the Hells.*"
msgstr "* '하강' - 엘투렐 도시 전체를 한순간에 지옥으로 끌고 간 지옥의 음모입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = b12035b9-2c6e-5a40-33d7-efa421072d3a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:b12035b9-2c6e-5a40-33d7-efa421072d3a
msgctxt "hdb28e452g809eg4390gb8adgbc426d18d55c"
msgid "Maybe your people should have stayed in Hell."
msgstr "당신네 사람들은 그냥 지옥에 남는 편이 좋았을지도 모르겠군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = b2de2dbb-ebdc-b2e1-81c8-7f2c25ffadcc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_TieflingLeader_HasMet_ProposedCelebration(1) = True
#. SetFlags:
#.   Quest:
#.     - DEN_Conflict_SUB_Goblin.LearnedLeaving(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:b2de2dbb-ebdc-b2e1-81c8-7f2c25ffadcc
msgctxt "h123d8c4egfbffg48e2gb541g88de5ce41875"
msgid "We're ready to head to your camp - are you?"
msgstr "우리는 준비를 마쳤네, 자네는 어떤가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = b2e0b962-1855-8050-7c8c-30d1159d29b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:b2e0b962-1855-8050-7c8c-30d1159d29b6
msgctxt "h22cb7d7egfcebg479ag85a4g90edfc64ff0b"
msgid "What brought you here?"
msgstr "어쩌다 이곳까지 오게 된 거죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = b3cc54a3-3581-2501-9bbe-91b2146df9ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:b3cc54a3-3581-2501-9bbe-91b2146df9ea
msgctxt "h7f75d8b4g2706g4fe0g9edbg3997d9cf642a"
msgid ""
"Some artefact Aradin was hunting. I don't know any more than that - and "
"don't want to."
msgstr "아라딘이 찾던 어떤 아티팩트 때문이었어. 그 이상은 모르겠고 알고 싶지도 않네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = b4128792-838d-0535-acc1-f83ad4d27702
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:b4128792-838d-0535-acc1-f83ad4d27702
msgctxt "hef49ac13g49f4g4b87ga5feg41c7399fa63f"
msgid "Why are they forcing you out?"
msgstr "왜 당신들을 내쫓으려는 거죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = b83f3404-f18a-1105-f138-b23aedfb3a7f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:b83f3404-f18a-1105-f138-b23aedfb3a7f
msgctxt "hadf876beg00bag4d9eg89d1g7c947ed038d9"
msgid ""
"Afterwards, people looked at us and just saw 'devilkin'. No different from "
"the druids here, really."
msgstr "그 사건 이후로, 사람들은 우리를 그저 '데빌족'으로 여긴다네. 여기 드루이드들도 딱히 다르지 않더군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = b9a91e39-b446-c697-620d-75ba48a81988
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:b9a91e39-b446-c697-620d-75ba48a81988
msgctxt "h812ab357ga884g4715ga0e5g4a9851612d38"
msgid ""
"So I hoped. But we've lost so many already - and more will die if we're "
"forced out again."
msgstr "나도 바라는 바네. 허나 우리는 지금도 너무나 많은 이를 잃었어. 그리고 우리가 쫓겨난다면 더 많은 이들이 또 죽어 나갈 걸세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = ba72d674-eaec-b5fb-c4c8-72712683c6ed
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Knows_WentWithAdventurers = True
#.     - GLO_Halsin_Knows_IsMissing = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:ba72d674-eaec-b5fb-c4c8-72712683c6ed
msgctxt "h472a7c99ga191g4ba5g82d1gd878d92cb3b9"
msgid "He should've returned with the adventurers. Cowards left him behind."
msgstr "원래는 모험가들이랑 함께 돌아왔어야 했는데. 그 겁쟁이들이 버리고 왔더군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Wyll
#. NodeID = baeca9e3-7725-e190-7412-0f773f02c1d5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:baeca9e3-7725-e190-7412-0f773f02c1d5
msgctxt "h9a5f076cgba0eg46e9g93a8ge6e49a595bf6"
msgid "Kagha's a piece of work. Let's see if your wit surpasses your might."
msgstr "카그하는 보통 인물이 아니지. 힘이 아니라 기지를 발휘해야 할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = bb22bee4-7a7b-46e0-a90c-f075336c9cea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:bb22bee4-7a7b-46e0-a90c-f075336c9cea
msgctxt "haf77db55g158cg4410g9e13g28916de511cf"
msgid ""
"The druids would have overwhelmed us, if not for you. You've proven yourself "
"a fine warrior - and a better friend."
msgstr "자네가 아니었다면 드루이드들이 우리를 압도했겠지. 자네는 전사로서의 능력뿐 아니라 호의 또한 증명했네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = bb8354a0-1f8b-7199-95e4-5c02b6504489
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_TieflingLeader_Knows_TieflingPlight = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:bb8354a0-1f8b-7199-95e4-5c02b6504489
msgctxt "h725fd416g346cg4b01g9c33g323d69abfc67"
msgid ""
"Whatever your business here, I'd see to it quickly - the druids are forcing "
"everyone out."
msgstr "어떤 일로 이곳에 왔는진 모르겠네만, 빨리 해결하는 것이 좋을걸세, 드루이드들이 모두를 내쫓고 있으니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = bba93eb0-a7eb-97c2-d8ac-b051c538d026
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:bba93eb0-a7eb-97c2-d8ac-b051c538d026
msgctxt "h2a3a6119gb0afg4af6g945fgee2f97d47136"
msgid ""
"Let me guess: Your old neighbours called you 'devilkin' and acted like they "
"never knew you."
msgstr "알 것 같네요. 옛날 이웃들이 당신들을 '악마족'이라고 부르며 모르는 사람 취급을 했겠죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = bc6b83d4-6792-f9e0-50d3-8a50ef9a268d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Tieflings_Knows_DescentIntoAvernus = False
#. SetFlags:
#.   Global:
#.     - GLO_Tieflings_Knows_DescentIntoAvernus = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:bc6b83d4-6792-f9e0-50d3-8a50ef9a268d
msgctxt "h9677b41cgebdbg446bgac97g722b0f578420"
msgid "'The Descent'? What is that?"
msgstr "'하강'? 그게 뭐죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = bc95381d-23b4-8054-5453-76465e62fa21
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:bc95381d-23b4-8054-5453-76465e62fa21
msgctxt "ha9b92a06g1fd4g421eg9b59g9f347f65c6c4"
msgid "I'm [GEN_PlayerName_c11eee1e-7815-6143-7233-f2427799fa53]."
msgstr "전 [GEN_PlayerName_c11eee1e-7815-6143-7233-f2427799fa53]입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = bcf3073b-1811-68f0-9135-af605e91a2bc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:bcf3073b-1811-68f0-9135-af605e91a2bc
msgctxt "h651075e0gfb17g45aeg9c6bgdc52c88846ab"
msgid "Lucky you."
msgstr "좋겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = bd3d1bb3-4a4f-28cd-e230-58bb92925177
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_TieflingLeader_Quest_GobHuntAccepted = True
#.     - DEN_TieflingLeader_Quest_GobHuntResponded = True
#.   Quest:
#.     - DEN_Conflict.ZevGaveQuest(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:bd3d1bb3-4a4f-28cd-e230-58bb92925177
msgctxt "h49cd8f90g091bg4363g9d7dgef6d6bcfe4b1"
msgid "Don't bother. I'll do what I can."
msgstr "신경 쓰지 마세요. 제가 할 수 있는 일을 하겠습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = be9bf9a7-ebb2-b785-39b6-752d661a4917
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_TieflingLeader_HasMet_ProposedCelebration(1) = True
#.   Global:
#.     - DEN_AttackOnDen_Event_TieflingPartyInvitation = True
#.   Quest:
#.     - DEN_Conflict.SidedTieflings_Celebrate(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:be9bf9a7-ebb2-b785-39b6-752d661a4917
msgctxt "h5cd285e8g18ffg4b49gaeb8g099bc8d4b918"
msgid ""
"But perhaps we need not speak of farewells. We'll join your camp tonight to "
"celebrate, if you'll have us."
msgstr "하지만 작별 인사를 할 필요는 없겠군. 자네만 괜찮다면, 우리는 오늘 밤 축하를 위해 자네 야영지에 합류하겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = c09f8879-1ae6-851d-5538-90606d00009b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_Quest_AcceptedKagha = True
#.      - DEN_ShadowDruid_State_KaghaIsDead = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:c09f8879-1ae6-851d-5538-90606d00009b
msgctxt "h7f543b2bg435fg4b75g83dcg7880ea8d2911"
msgid "I'm not interested. You'll go now, as Kagha says, or I'll force you."
msgstr "관심 없어. 카그하의 명령대로 당장 떠나지 않으면, 내가 강제로 쫓아낼 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = c38f74da-da6a-2724-3ff4-89f14a2c24f0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_TieflingLeader_HasMet_AdvisedStay = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:c38f74da-da6a-2724-3ff4-89f14a2c24f0
msgctxt "h4565eb5cgeb7eg4faag826dgbc68270bcd9d"
msgid "You have to resist."
msgstr "당신들은 저항해야 해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = c3a2e641-ea81-36bb-7341-1e3047a10128
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:c3a2e641-ea81-36bb-7341-1e3047a10128
msgctxt "h25adb09aga1dbg47c4ga9e7g758ca81c2fb6"
msgid "You're taking a risk for us - we'll see that you're rewarded."
msgstr "자네는 우리를 위해 위험을 감수하는군. 자네가 꼭 보상을 받을 수 있도록 하겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = c430f266-1182-5aec-8172-7405f3246860
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:c430f266-1182-5aec-8172-7405f3246860
msgctxt "h1fedfa1ege53ag483fgbd86g5f7d09df6efa"
msgid ""
"Lucky for us, a group of adventurers found a way to bring the city back."
msgstr "다행히, 한 무리의 모험가들이 도시를 다시 지상으로 올릴 방법을 찾았다네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = c4328a8e-fae3-39a3-fe85-3c9d3fcb94c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:c4328a8e-fae3-39a3-fe85-3c9d3fcb94c0
msgctxt "h2df4a94dga4fcg4bd6gbd81g2c745479946c"
msgid "Of course. Everything we have. Anything we can give you, we will."
msgstr "물론. 우리가 가진 모든 것을 줄 걸세. 우리가 줄 수 있는 것은 무엇이든 주겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = c4dc2400-dfc8-1efe-2bb3-f19ed4cb66c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:c4dc2400-dfc8-1efe-2bb3-f19ed4cb66c6
msgctxt "h58c5e818gd271g487fgb038g1fc5993b989b"
msgid "You helped us fight those goblins. Who are you?"
msgstr "자네는 고블린들과 싸울때 우리를 도왔지. 자네는 누구인가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = c55f9d99-e2e4-e65b-86e0-62b2924df531
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:c55f9d99-e2e4-e65b-86e0-62b2924df531
msgctxt "h56d64baeg869ag4184gbc67g38e74d825fb1"
msgid ""
"It's no small thing to ask, but... I've seen you fight. You're equal to the "
"task."
msgstr "주제넘은 부탁이라는 것은 알지만... 자네가 싸우는 모습을 봤네. 충분히 능력이 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = c591a505-e477-95a0-fd9a-ac93ad943e8c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:c591a505-e477-95a0-fd9a-ac93ad943e8c
msgctxt "h036941e9g0afag4bedgae11g2efdc8894a60"
msgid ""
"We'd need an army of our own to escort us safely to Baldur's Gate, and while "
"I don't doubt your abilities... you're no army."
msgstr ""
"이에 맞먹는 군대가 호위하지 않고서는 우리가 발더스 게이트까지 안전하게 갈 수 없을 터. 자네의 능력엔 의심의 여지가 없지만... 자네 "
"혼자서 군대를 대신할 수 있을진 모르겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = c606c58a-f51a-ae52-9434-de4e567fe03f
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DROWELF or DROWHALFELF
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:c606c58a-f51a-ae52-9434-de4e567fe03f
msgctxt "h3b4b863cg29ddg414dgab10gfb274f6b0622"
msgid "And yet you walk in here like it's your domain. Typical drow arrogance."
msgstr "그런데도 자네는 이곳을 제집인 양 어슬렁거리는군. 과연 드로우다운 거만이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = c631fc1b-1f5e-dfbe-03d6-778e74d620cf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:c631fc1b-1f5e-dfbe-03d6-778e74d620cf
msgctxt "hf68e7fd9gd2f0g4285g84e4g68fe941504d4"
msgid "A thought I might have dismissed, before Arabella."
msgstr "말도 안 되는 생각이라 했겠지, 아라벨라가 죽기 전까지는 말일세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = c78b998f-575f-cc41-d15d-4cf99a5a0a1c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_TieflingLeader_Quest_GobHuntResponded = True
#.     - DEN_TieflingLeader_Quest_GobHuntWithPayment = True
#.   Quest:
#.     - DEN_Conflict.ZevGaveQuest(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:c78b998f-575f-cc41-d15d-4cf99a5a0a1c
msgctxt "he56602d7gd0f2g4291gb0d6gf6a041324ae0"
msgid "Make sure it's enough."
msgstr "충분해야 할 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = c883f851-4ed2-8d22-80b2-265a1c6e9fc5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:c883f851-4ed2-8d22-80b2-265a1c6e9fc5
msgctxt "h1d2e54efg5ebag40a0gbd12g0e22dbf536f6"
msgid ""
"But I'm gathering what I can from my people. A reward - because I have "
"something else to ask of you."
msgstr "그래도 십시일반으로 보상을 마련해 보겠네. 한 가지 더 부탁하고 싶은 게 있거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = cbdf3d54-3151-d0fe-1321-f48d6201c863
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_Laezel_Quest_AskedZevlorAboutZorru(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:cbdf3d54-3151-d0fe-1321-f48d6201c863
msgctxt "h336e65d7g877bg4c2bg88b7g3f2b1df1fc6e"
msgid ""
"You'll find him in the caves. But I warn you not to start trouble. There's "
"already enough going."
msgstr "동굴 쪽에서 그를 찾을 수 있을 걸세. 하지만 말썽 피우지는 않았으면 좋겠군. 이미 충분히 많은 일이 벌어지고 있으니 말일세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = cc024bb7-42c4-3ac7-94b1-ff251c342c2d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_TieflingLeader_Knows_Elturel = False
#. SetFlags:
#.   Global:
#.     - GLO_TieflingLeader_Knows_Elturel = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:cc024bb7-42c4-3ac7-94b1-ff251c342c2d
msgctxt "h56029dd8g58bdg47b9ga52dge9aba9c4b26e"
msgid "What brings your people out into the wilds?"
msgstr "당신네 사람들은 어째서 야생으로 나오게 됐나요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = cc533256-0f32-841a-5be2-d55b5717669b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_TieflingLeader_HasMet_AdvisedRun = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:cc533256-0f32-841a-5be2-d55b5717669b
msgctxt "h1e58dd4fg8776g4a1aga9ccgd959a4bba014"
msgid "You need to cut your losses and run. I'll help."
msgstr "당신들은 손실을 피하고 떠나야 합니다. 제가 도와드리죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = cd0b884b-05fd-c824-3d32-1b568301ff22
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:cd0b884b-05fd-c824-3d32-1b568301ff22
msgctxt "h54c08860g5e32g4525g93ebgc42a7e513ab0"
msgid "Kill the goblins, and you'll clear the way for yourself as well."
msgstr "고블린들을 처치하면, 자네가 갈 길도 확보할 수 있을 걸세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = cd3d5869-c511-3d2f-3611-4069b117ff35
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:cd3d5869-c511-3d2f-3611-4069b117ff35
msgctxt "h41b84df6g3fe8g4fddg8766gefe1195111c2"
msgid ""
"But the druids would slaughter us - we'd have to get close to Kagha. Within "
"striking distance."
msgstr "하지만 드루이드들이 우리를 도살할 수도 있네. 우리는 카그하에게 가까이 접근해야 해. 공격할 수 있는 범위 내에 말일세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = ce7fb5fe-b956-8618-acaa-4da764ebe695
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:ce7fb5fe-b956-8618-acaa-4da764ebe695
msgctxt "had420431gec94g4089gb5c5g41fd23a43721"
msgid "No. The druids are too powerful - we can't stand against them all."
msgstr "그렇게는 안되네. 드루이드들은 너무 강력해. 우리가 그들 모두에게 맞설 수는 없네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = cf10fb3e-de0a-31dd-efee-c7911a4e8338
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_State_Returned = True
#.      - DEN_ShadowDruid_State_KaghaIsDead = False
#. SetFlags:
#.   Global:
#.     - DEN_AttackOnDen_Event_HalsinSpotted = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:cf10fb3e-de0a-31dd-efee-c7911a4e8338
msgctxt "h40d4b84aga587g46a7g91c8gb54b6b4e3545"
msgid ""
"Halsin will likely want to thank you, too, mind. He returned just a while "
"ago."
msgstr "할신도 자네에게 감사를 표하고 싶어할 걸세. 그가 조금 전에 돌아왔네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = cfeb38d3-3073-7764-f5fb-a331d9f18322
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:cfeb38d3-3073-7764-f5fb-a331d9f18322
msgctxt "h9a82b612gdbffg421cgb4b9gc51e79adc7f5"
msgid "Not yet."
msgstr "아직 안 했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = d08874c4-f41c-2864-d64c-2a2897176de3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_TieflingLeader_HasMet_StayedImpartial = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:d08874c4-f41c-2864-d64c-2a2897176de3
msgctxt "h0bfc1f58g89dcg4b4ag9406g135f7e27eb38"
msgid "Best of luck with that. This has nothing to do with me."
msgstr "행운을 빕니다. 저와는 상관없는 일입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = d0ebe029-01f2-53c1-90d4-45fce252161c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_TieflingLeader_Quest_GobHuntAccepted = True
#.     - DEN_TieflingLeader_Quest_GobHuntResponded = True
#.   Quest:
#.     - DEN_Conflict.ZevGaveQuest(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:d0ebe029-01f2-53c1-90d4-45fce252161c
msgctxt "hb1a9efcage10ag4cf6g91e1g90b4800f9eb2"
msgid "Kill the goblin horde's leaders? I'll see what I can do."
msgstr "고블린 무리의 지휘자들을 죽이라는 거죠? 해보겠습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = d1099dbd-465c-116e-ca01-f3cd97e9bfa6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = False
#.      - DEN_GroveConflict_Quest_AcceptedKagha = True
#.   Tag:
#.      - REALLY_WYLL(1) = False
#. SetFlags:
#.   Global:
#.     - DEN_TieflingLeader_HasMet_AdvisedRun = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:d1099dbd-465c-116e-ca01-f3cd97e9bfa6
msgctxt "h6fd2bc17gcebfg44e8gb713g95dfdc47b9e5"
msgid "I'm not here to advise you. I'm here to make sure you leave."
msgstr "당신에게 조언하러 온 게 아니에요. 확실히 떠나게 만드려고 왔지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = d127711e-0aff-8ddf-9106-718e5953de08
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#.      - DEN_ShadowDruid_State_SnakesCourtDone = True
#. SetFlags:
#.   Global:
#.     - DEN_GuardedEntrance_State_ParentsKnowDeath = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:d127711e-0aff-8ddf-9106-718e5953de08
msgctxt "hcdc0d255ga902g40e1g962fgbb8a7a48f8d9"
msgid ""
"I've... already heard. Arabella. Nine summers old, and now she'll never see "
"another."
msgstr "나도... 이미 들었네. 아라벨라. 지금까지 아홉 번의 여름을 보냈지만, 이제 더는 볼 수 없겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = d1c73e8f-915a-e866-510e-ed95189105da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:d1c73e8f-915a-e866-510e-ed95189105da
msgctxt "hf6510645g8d0ag4165gaf29gbeb064368ab6"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = d305e902-dc15-0c0a-0962-4e9860d090f7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:d305e902-dc15-0c0a-0962-4e9860d090f7
msgctxt "hb9e719c0g2a2eg4b75gb688gb474d6b081cd"
msgid "These are civilians. Open battle would be a massacre."
msgstr "이들은 민간인이네. 전면전은 대학살이 될 걸세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = d39a061e-a994-dc37-7ca7-d7da7adca636
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:d39a061e-a994-dc37-7ca7-d7da7adca636
msgctxt "hbc7d989fg819ag479cga72cgaf5a949478cf"
msgid "Torm's truth. You really are her creature, aren't you?"
msgstr "톰의 진실이여. 자네는 정녕 그녀의 애완동물인 것인가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = d496a98b-73bd-6aac-a331-e970299cae14
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_TieflingLeader_HasMet_Introduction(1) = False
#.   Global:
#.      - DEN_GroveConflict_Knows_ZevlorSentToKagha = True
#. SetFlags:
#.   Dialog:
#.     - DEN_TieflingLeader_HasMet_Introduction(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:d496a98b-73bd-6aac-a331-e970299cae14
msgctxt "hdc358b49g1f5bg45aeg8143gf40da5883bcf"
msgid "Ah. I've already spoken to your travelling companion. Well met."
msgstr "아, 자네의 동료에게 이미 이야기 들었지, 만나서 반갑네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = d4fa42c9-f815-05e8-f428-fea84a4eb1aa
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_AttackOnDen_Event_GoToCamp = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:d4fa42c9-f815-05e8-f428-fea84a4eb1aa
msgctxt "h23ab94b7g5c8cg4a40ga622g5edf85667e4d"
msgid "Excellent - lead the way."
msgstr "훌륭하군 - 앞장서게나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = d5240afe-8dd0-e74e-b7c2-b61117b4fabe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:d5240afe-8dd0-e74e-b7c2-b61117b4fabe
msgctxt "h114b1e6fg5cb3g4c76gb2a1g0d80107857a4"
msgid "But we can't get there with those beasts blocking our path."
msgstr "하지만 저 짐승들이 길을 막고 있는 이상 우리는 그곳에 갈 수도 없네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = d5462749-2dd9-def4-047d-5aabf711271b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:d5462749-2dd9-def4-047d-5aabf711271b
msgctxt "h46541e0cgbd46g422cg8fc8g5f0b5ebdab72"
msgid "Aradin ran off."
msgstr "아라딘은 도망쳤습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = d5881960-f073-bdf6-1dee-7c2c3570c847
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:d5881960-f073-bdf6-1dee-7c2c3570c847
msgctxt "h54d1cdeeg8747g49b0gb76dg7971b6ecd0e9"
msgid "If the issue is coin, I'll ensure you're well rewarded."
msgstr "돈이 문제라면, 자네가 충분한 보상을 받을 수 있도록 하겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = d5a8adf0-05ec-2bb6-d82f-96af432619da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:d5a8adf0-05ec-2bb6-d82f-96af432619da
msgctxt "h1db90421g51acg4850g8f02g0718922020df"
msgid ""
"We were bound for Baldur's Gate, and it was too late to turn back. Elturel "
"had no place for tieflings after the Descent."
msgstr ""
"발더스 게이트로 향하던 길이었네만, 이제 돌아가기엔 너무 멀리 와버렸네. 엘투렐은 하강 사건 이후로 티플링들이 설 곳이 사라졌다네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = d6bffd97-d134-60c7-3150-5bcd18c2fceb
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_DARK_URGE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:d6bffd97-d134-60c7-3150-5bcd18c2fceb
msgctxt "h2f22ea5aga88bg49bbga3d2g434e5949a9d7"
msgid "I want to try and help. I'll do what I can."
msgstr "마음만은 돕고 싶습니다. 최선을 다해 보죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = d6bffd97-d134-60c7-3150-5bcd18c2fceb
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:d6bffd97-d134-60c7-3150-5bcd18c2fceb
msgctxt "hb1ceaf87gbf68g4a9dga426g52d831aa842a"
msgid "I'll see what I can do."
msgstr "제가 무엇을 할 수 있는지 보겠습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = d7dc1463-e664-6294-8d5e-ea021afdc8b0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:d7dc1463-e664-6294-8d5e-ea021afdc8b0
msgctxt "hcfd618b2g3defg490bga70cg9eb3691c032c"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = d80f4b97-8415-0dd3-48e6-ccc71bd94c95
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:d80f4b97-8415-0dd3-48e6-ccc71bd94c95
msgctxt "h7c1f4a69gcf6dg43cfg8a3bg088686a637d3"
msgid "Good riddance."
msgstr "속이 다 시원하군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Lae'zel
#. NodeID = d99918f3-f4b8-c55d-559a-a6d86b4541a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:d99918f3-f4b8-c55d-559a-a6d86b4541a5
msgctxt "ha2feecd5gc724g4c1bgb58ag5458c572c3d4"
msgid "A rational choice. We mustn't stray from our path."
msgstr "현명한 선택이야. 우리 경로를 이탈해선 안 돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = db7d4954-46c5-3cfc-3b0c-858f543f8e43
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:db7d4954-46c5-3cfc-3b0c-858f543f8e43
msgctxt "h62ae3823g3d72g4f30gbf4fg420b8706941d"
msgid "I was there, you know. I'd hoped you'd had a happy ending."
msgstr "저도 그때 거기 있었거든요. 당신들이 좋은 결말을 맞기만을 바랐죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = db9d0fbe-a40b-0682-1f6b-5a2d7884b6be
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:db9d0fbe-a40b-0682-1f6b-5a2d7884b6be
msgctxt "h3d7ea81ag7aa3g4b6fgb147g82f92ceee1b2"
msgid "Sorry about that."
msgstr "좀 전엔 죄송했습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = dc8c1622-3a3a-3725-1f53-141862f17d56
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_State_HelpDeclined = True
#. TagRule: REALLY_DARK_URGE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:dc8c1622-3a3a-3725-1f53-141862f17d56
msgctxt "hb07dca08gfe08g47a4ga89ag47fd06bf06d3"
msgid "My head's a wreck. I've got too much else to deal with right now."
msgstr "제 머릿속이 엉망이라, 지금은 그런 데 신경 쓰기엔 너무 일이 많아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = dc8c1622-3a3a-3725-1f53-141862f17d56
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_State_HelpDeclined = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:dc8c1622-3a3a-3725-1f53-141862f17d56
msgctxt "h88e89626g5e00g4d7cga65eg3c02c2472fa8"
msgid "I'm sorry. I've got my own problems."
msgstr "미안합니다. 저는 저만의 문제가 있습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Lae'zel
#. NodeID = e01aedc5-c58b-ff0e-7f54-840982c4c751
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:e01aedc5-c58b-ff0e-7f54-840982c4c751
msgctxt "hdf774057g082dg4df6g8e5age99bea8a3631"
msgid "Bah. We've no time to offer aid to every whimpering pup."
msgstr "쳇. 낑낑거리는 강아지에게 일일이 도움을 줄 시간은 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = e1930996-cc77-4097-2d61-db43b1be96e4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:e1930996-cc77-4097-2d61-db43b1be96e4
msgctxt "hc74404c4gc73eg4be6ga2a7g88f91a1948d0"
msgid "Do not be so sure - Kagha won't spare you either, if it comes to it."
msgstr "그렇게 확신하지 말게. 때가 오면, 카그하는 자네도 남겨두지 않을 걸세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = e1d45121-4d14-8910-1101-6753020a39ce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:e1d45121-4d14-8910-1101-6753020a39ce
msgctxt "h83c05b9bg3046g4242ga9eag6a988229486d"
msgid "What are you offering for my aid?"
msgstr "제 도움의 대가로 뭘 제공할 수 있죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = e1e08dca-54da-1b02-0421-8ec92658305b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:e1e08dca-54da-1b02-0421-8ec92658305b
msgctxt "h2d2f20ddg616bg4f85ga2f6g08a5c1c77df9"
msgid "Thank you again for your help out there."
msgstr "다시 한번, 아까 도와준 것에 대해 감사를 표하네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = e2af90fe-b89d-cd06-49d1-e24e6a0eefb2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:e2af90fe-b89d-cd06-49d1-e24e6a0eefb2
msgctxt "h48247895g1cddg4d4fga410g3d43ff01d518"
msgid "So Kagha's twisted your mind as well."
msgstr "카그하가 자네의 마음도 뒤틀었군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = e2cff674-606c-3b62-7263-e5e80be206c4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingLeader_Quest_GobHuntResponded = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:e2cff674-606c-3b62-7263-e5e80be206c4
msgctxt "h39f14e30g8254g4908g8359gd09cc7b0a034"
msgid ""
"It's sparse thanks for what you've done for us but, gods and goblins "
"willing, I won't need it again."
msgstr "자네가 우리에게 해준 일에 대한 감사의 표시일세. 신과 고블린이 막지 않는다면, 나에게는 다시 필요 없을 것 같네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = e2e19625-619b-36c8-f5d5-d4819756a664
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:e2e19625-619b-36c8-f5d5-d4819756a664
msgctxt "h12bf17c0g8837g4048g857fg2fd4511eeada"
msgid ""
"Once the druids complete their ritual, we'll be sharing the road with "
"goblins once again."
msgstr "드루이드들이 의식을 끝마치면, 우린 고블린들과 또 다시 길을 나눠 쓰게 되겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = e48871b0-229c-132c-d16a-5879cef80616
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_State_PermaDefeated = False
#.      - GLO_Halsin_Knows_IsFound = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:e48871b0-229c-132c-d16a-5879cef80616
msgctxt "h783d184age082g4031ga2bcg07da74d0a3e3"
msgid "Halsin's alive - he's being held captive by goblins."
msgstr "할신은 살아있어. 고블린에게 포로로 붙잡혀 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = e50cfe4c-73a9-33df-5dd0-de40f324205c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:e50cfe4c-73a9-33df-5dd0-de40f324205c
msgctxt "h05ec101agddb3g4be5gb8bdg90fec2a98395"
msgid ""
"But they're ill-disciplined. It's unusual for them to organise so cleverly."
msgstr "놈들은 보통 열악한 훈련 상태로 알려져 있지. 영리하게 무리를 이루는 건 드문 일일세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = e61c95f2-8ec8-f04d-424b-8e8d2e88a7c3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:e61c95f2-8ec8-f04d-424b-8e8d2e88a7c3
msgctxt "h1c3dcf32g999eg4e1bgb73cgf9fa2b0c9fd4"
msgid ""
"There have been several attacks by different monsters. The druids blame us "
"'outsiders' for drawing them here. Nobody's welcome anymore."
msgstr ""
"다양한 괴물 놈들로부터 이런 공격이 몇 번 있었네. 드루이드들은 우리 '외부인'들이 그들을 여기로 불러들이고 있다고 탓하고 있지. 더 "
"이상 아무도 환영받지 못해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = e76fc22e-6933-f734-a97b-0a25fb766760
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:e76fc22e-6933-f734-a97b-0a25fb766760
msgctxt "h3f4ff487g7797g4249g9c26gec1d38fd79fc"
msgid ""
"What little we have, we'll scrape together. It isn't coin we need - it's "
"<i>time</i>."
msgstr "우리도 가진게 많지 않지만, 최대한 긁어모아 보도록 하겠네. 지금 우리에게 필요한 건 동전이 아니야. <i>시간</i>이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = e8205f3e-5975-4074-dc28-119a4f1e9c76
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:e8205f3e-5975-4074-dc28-119a4f1e9c76
msgctxt "he3de0a0cgff5ag4c32g96a9g5af4889e99a0"
msgid "Better to leave on your own terms before it comes to that. I'll help."
msgstr "그런 일이 벌어지기 전에 제 발로 떠나는 편이 좋을 걸세. 내가 돕지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = e8919d85-e1da-8773-dfdf-138f14579079
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:e8919d85-e1da-8773-dfdf-138f14579079
msgctxt "h951badf0ga685g4cd9g9bdbg169b27fccfa8"
msgid ""
"Truly? Ilmater's ashes, I never thought she would actually see reason. Too "
"late for poor Arabella."
msgstr ""
"정말인가? 일메이터의 유해여, 나는 그녀가 실로 이치를 파악할 것이라고는 생각 못했네. 불쌍한 아라벨라에게는 너무 늦은 일이지만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = ea8e1950-869f-b6cd-34e5-9619e4c9a4a1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:ea8e1950-869f-b6cd-34e5-9619e4c9a4a1
msgctxt "h447edb7cg91d3g4659g9ff9gfa6e7d404741"
msgid ""
"We're refugees from Elturel - we took shelter here after gnolls and goblins "
"attacked us on the road."
msgstr "우린 엘투렐에서 온 난민들이라네. 길에서 고블린과 놀에게 공격당하다가 이곳으로 도망쳐온걸세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = eb12f480-9b15-2a78-df12-44694f6f6dd3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:eb12f480-9b15-2a78-df12-44694f6f6dd3
msgctxt "hb5909db6gabddg49f1gb754ge4757f9a1360"
msgid "I know you'll do the right thing."
msgstr "자네가 옳은 행동을 할 거라고 믿네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = ebfb8783-3218-7c09-694b-91c2fb9d121f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:ebfb8783-3218-7c09-694b-91c2fb9d121f
msgctxt "h0266028cg0ebbg41ecg9cbfgb96e332ac6dc"
msgid ""
"We got out alive. That's what matters. And you did too, by the looks of "
"things."
msgstr "우리야 결국 살아서 탈출했으니, 그게 중요한 거지. 보아하니 자네도 마찬가지고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = ec5096a9-105d-70c5-f7fe-185f656bd6ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:ec5096a9-105d-70c5-f7fe-185f656bd6ea
msgctxt "h2126aab9g8ebeg491egb665gd5d14ac5f18f"
msgid ""
"The High Overseer - <i>our grand protector</i> - signed a pact with devils. "
"It dragged Elturel straight to Hell."
msgstr "우리 <i>수호자</i>, 고위 감독관이 데빌과 계약을 맺었다네. 그 계약으로 인해 엘투렐이 지옥으로 끌려 내려갔지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = ecaea736-7c2a-b8dc-1ba6-ca43c8a7d249
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:ecaea736-7c2a-b8dc-1ba6-ca43c8a7d249
msgctxt "h33ff97f8gf212g4d19g8387g0ffb1ff5ef9f"
msgid "But we can't get there with those beasts blocking our path."
msgstr "하지만 저 짐승들이 길을 막고 있는 이상 우리는 그곳에 갈 수도 없네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Shadowheart
#. NodeID = ed5fd5fa-16d3-e3f9-c171-df112b47c5a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:ed5fd5fa-16d3-e3f9-c171-df112b47c5a6
msgctxt "he1898b70g242eg435dgb20dg4c1b244b9384"
msgid ""
"Let's not forget why we're here. No point in wasting precious time on a lost "
"cause."
msgstr "우리가 여기 왜 왔는지 잊지 마. 쓸데없는 일에 귀중한 시간을 낭비할 필요는 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = eebc89e2-62b7-8af0-07d7-fb77045bc39d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:eebc89e2-62b7-8af0-07d7-fb77045bc39d
msgctxt "hacb19e86g9e7fg43e9gad49g28a1ffa4328d"
msgid "Right. Best not to stop here."
msgstr "그렇군. 여긴 지금 머물기 좋은 곳은 아닐세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = ef942562-b02d-7f28-950b-314833e64bb6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_Laezel_Quest_AskedZevlorAboutZorru(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:ef942562-b02d-7f28-950b-314833e64bb6
msgctxt "h59edf4dfgd699g4650g8681g9ef40c4ec991"
msgid "You'll find him in the caves. But we won't stay here much longer."
msgstr "동굴 쪽에서 찾을 수 있을 걸세. 다만 우린 여기 오래 머물 생각 없으니 유념하게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = efae02d3-fccb-3926-12bf-f0e394f86d69
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:efae02d3-fccb-3926-12bf-f0e394f86d69
msgctxt "hab9479cfg3d8eg4433g9218gb1d00693cf62"
msgid "That's exactly what I'm suggesting."
msgstr "그게 바로 내가 제안하는 바입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = f07e214f-4acb-a5c4-ba52-2fc5c99f21b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:f07e214f-4acb-a5c4-ba52-2fc5c99f21b4
msgctxt "ha44deee9gd4e4g4145gbb91gac3e9b1fb4dd"
msgid ""
"Right. I'd offer you supplies and sustenance by way of thanks, but I'm "
"afraid there's little to spare."
msgstr "그렇군. 감사의 표시로 보급품이나 생필품이라도 내주고 싶지만, 우리 쪽 사정도 넉넉하진 않아서 말일세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = f1cf1404-a98b-5839-35db-2f3732e03c77
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_Knows_ZevlorSentToKagha = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:f1cf1404-a98b-5839-35db-2f3732e03c77
msgctxt "h799accadgfa6eg4b87g8fefgc21243847c97"
msgid "Have you spoken to Kagha?"
msgstr "카그하와는 얘기 나눴나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Wyll
#. NodeID = f22fdf08-1303-420f-9a79-f9d60f7e7666
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:f22fdf08-1303-420f-9a79-f9d60f7e7666
msgctxt "h93a711c7g40e8g4752g951agc92fe981d3f6"
msgid ""
"By the Triad, there is only one correct answer. Refuse him, and we sentence "
"these people to die."
msgstr "삼선신이시여, 옳은 답은 오직 하나 뿐이야. 우리가 거절하면 저 사람들에게 죽음을 선고하는 거라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = f2c1889c-6e25-a014-b62d-226f521eab1b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:f2c1889c-6e25-a014-b62d-226f521eab1b
msgctxt "h987225fbgcbe7g4b1ag81d6g05e017750f16"
msgid ""
"Lucky for you, you seem to have spooked Aradin and his trash into leaving."
msgstr "운이 좋게도, 자네가 아라딘과 그의 쓰레기 무리들이 떠나도록 설득한 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = f31e4b0c-92cb-d93d-f312-10bb412a60d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:f31e4b0c-92cb-d93d-f312-10bb412a60d6
msgctxt "h56f7e752g043dg4bb3g8e7bgd4ff3c13f527"
msgid ""
"If the druids are this far gone, then it's not just goblins we have to fear."
msgstr "드루이드들이 그 지경까지 가면, 우리가 두려워해야 할 건 고블린뿐만이 아닐 걸세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = f3521c38-d174-4275-8aec-768e8591bed7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_State_DruidsPacified = True
#.      - DEN_TieflingLeader_State_KaghaResolved = False
#.      - DEN_TieflingLeader_HasMet_DruidsPacified = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:f3521c38-d174-4275-8aec-768e8591bed7
msgctxt "h33c5b54bgdf8bg425bg987eg271f37e14391"
msgid "I'm told the druids have stopped their damn chanting. What happened?"
msgstr "드루이드들이 그 망할 의식을 중단했다더군. 어떻게 된 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = f3b087e9-2dda-74cb-196e-816042ca9ebf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:f3b087e9-2dda-74cb-196e-816042ca9ebf
msgctxt "h929bb521g78a1g47e9g963fgbdb9613e7013"
msgid "I figured I was due a makeover. What do you think?"
msgstr "기분 전환이 필요했습니다. 괜찮아 보이나요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = f3fb8e8d-38c2-0692-9594-ef336bc2eb29
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:f3fb8e8d-38c2-0692-9594-ef336bc2eb29
msgctxt "h3bb94145g8b59g4430g91afge663064313e7"
msgid "To see Kagha pay? <i>Everything.</i> You'll get your coin."
msgstr "카그하가 대가를 치르게 하는 대가 말인가? <i>뭐라도 좋네. </i>돈은 받을 수 있을걸세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = f7634720-6ab2-46ff-ac99-a7066be2d3fb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_Quest_ZorruIsPermaDefeated = False
#.      - ORI_Laezel_Quest_FoundZorru = False
#.      - ORI_Laezel_Quest_FindZorru = True
#. TagRule: REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:f7634720-6ab2-46ff-ac99-a7066be2d3fb
msgctxt "heae89bfegba56g48ceg9750g720e239def19"
msgid "I'm looking for the one called 'Zorru'."
msgstr "'조르'라고 불리는 자를 찾고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = f7634720-6ab2-46ff-ac99-a7066be2d3fb
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_Quest_ZorruIsPermaDefeated = False
#.      - ORI_Laezel_Quest_FoundZorru = False
#.      - ORI_Laezel_Quest_FindZorru = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:f7634720-6ab2-46ff-ac99-a7066be2d3fb
msgctxt "h3e43e745g3d5cg48aag9330gddb458d71608"
msgid "I'm looking for a man named Zorru."
msgstr "조르라는 사람을 찾고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = f7a47057-ac82-ca80-2c44-0c1e25c17223
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_TieflingLeader_HasMet_AdvisedRun = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:f7a47057-ac82-ca80-2c44-0c1e25c17223
#, fuzzy
#| msgid "Leaving's the grove is the best option. I can help."
msgctxt "h49ace9acgd116g449egada7g293a677d6f00"
msgid "Leaving the grove is the best option. I can help."
msgstr "이곳을 떠나는 게 최선이네요. 제가 도와드리겠습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = f9e1fdf5-942e-4092-1076-deaa5f5444a9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:f9e1fdf5-942e-4092-1076-deaa5f5444a9
msgctxt "hec6095c7g10e8g43c2g8218g2f937250b954"
msgid "I'm not your messenger."
msgstr "난 당신 전령 같은 게 아닌데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = fa0670af-5f0b-4f8b-45ff-58fcdc1fcc8a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:fa0670af-5f0b-4f8b-45ff-58fcdc1fcc8a
msgctxt "h607a5f96gd719g4d9dg9b87g9ea91c726438"
msgid "I want to discuss something else."
msgstr "다른 이야기를 하고 싶어서 왔어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = fa0943a0-0a97-267f-3f2c-db19da487eb5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:fa0943a0-0a97-267f-3f2c-db19da487eb5
msgctxt "had842036g316cg45aagaeeeg24736ba4f973"
msgid "Just keep your fists to yourself, yes?"
msgstr "그냥, 주먹만 함부로 휘두르지 말게, 알겠나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = fb181297-ae1f-ad03-d6a0-21eb01afe8d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:fb181297-ae1f-ad03-d6a0-21eb01afe8d9
msgctxt "ha504aa77g45afg4020g9b02g133c0f30d478"
msgid ""
"There's the First Druid Halsin. This is his grove. <i>Was</i>, I should say."
msgstr "최고 드루이드 할신이 치유사야. 이곳은 그의 숲이고. 아니, 그의 숲<i>이었지</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = fc54fdf7-205f-324d-7ca7-30ccf3508702
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - DEN_Conflict.MetZevlor(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:fc54fdf7-205f-324d-7ca7-30ccf3508702
msgctxt "h85f5594cg59d1g4731gbda9g4a3119bea4c6"
msgid ""
"Perhaps you could persuade her. For more time to prepare, if nothing else."
msgstr "자네라면 그녀를 설득할 수 있을지도 몰라. 적어도 준비할 시간은 벌 수 있겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = fcc68c13-012a-6bb6-2a5a-f9d4661652eb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#.      - DEN_GroveConflict_Quest_AcceptedKagha = True
#.   Tag:
#.      - REALLY_WYLL(1) = False
#. SetFlags:
#.   Global:
#.     - DEN_TieflingLeader_HasMet_AdvisedRun = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:fcc68c13-012a-6bb6-2a5a-f9d4661652eb
msgctxt "h02d0f98cgf0a0g41d5gb90cg485d07846df5"
msgid "No, you won't - I'm here to make sure you leave."
msgstr "아니, 그럴 일 없어. 난 당신이 떠나야 한다는 걸 확실히 하려고 왔어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = fccca06b-2117-409f-4997-97d0f7265ee8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_TieflingLeader_ReassuredDrow(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_TieflingLeader_ReassuredDrow(1) = True
#. TagRule: DROWELF or DROWHALFELF
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:fccca06b-2117-409f-4997-97d0f7265ee8
msgctxt "h20e25279gc85dg4b6dg9fe8g5d3f9fc37839"
msgid ""
"You'll find the druids at the heart of the grove. Please - make them see "
"sense, before more lives are lost."
msgstr ""
"숲의 심장부에서 드루이드들을 찾을 수 있을 거야. 부탁컨대, 그들이 사리를 파악할 수 있게 해주게. 더 많은 이들이 목숨을 잃기 전에 "
"말일세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = fd37ba61-6068-065d-be34-07d855c97312
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:fd37ba61-6068-065d-be34-07d855c97312
msgctxt "h2aa53ecag3e85g4242g91c9g80fc8b25d4c2"
msgid ""
"Raise your hand to one of us again, however, and every tiefling in this "
"encampment will fall on you like a tide."
msgstr "허나 또 한 번 우리 사람들에게 손을 들면, 이 숙영지에 있는 모든 티플링이 파도처럼 달려들 줄 알게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = fd5a0b45-9e25-df60-0ead-978152ebd94e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Knows_HeardAboutNettie = True
#.   Quest:
#.     - GLO_Tadpole_SUB_Apprentice.LearnedAboutNettie(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:fd5a0b45-9e25-df60-0ead-978152ebd94e
msgctxt "hfef50a72gf23dg4d32g9ee1g08432c42fc98"
msgid "Try his apprentice, Nettie. You'll find her in the druids' circle."
msgstr "대신 그의 제자인 네티를 찾아보게. 드루이드 회합에서 찾을 수 있을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Zevlor
#. NodeID = fe511550-a8fb-dc48-f073-e7c84840d34b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - DEN_Conflict_SUB_Murder.ZevlorRewarded(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:fe511550-a8fb-dc48-f073-e7c84840d34b
msgctxt "h35f56cb5g0d04g4eddgb7e1g2c3161d7d456"
msgid ""
"I'll ensure my people make the most of it. It pains me that I have nothing "
"to give you in thanks."
msgstr "내 사람들과 최대한 활용해 보겠네. 보답으로 내줄 게 없어서 마음이 아프군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Player
#. NodeID = fedab0e4-3c1b-bb53-9061-fc115849ff14
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:fedab0e4-3c1b-bb53-9061-fc115849ff14
msgctxt "h010140ffgaac5g48a8ga44bgfa0db24156a8"
msgid "I have no quarrel with druids."
msgstr "저는 드루이드들과 문제 없습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader
#. Speaker = Gale
#. NodeID = ff9a94c7-d548-fb5d-ee65-29451c574a38
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader:ff9a94c7-d548-fb5d-ee65-29451c574a38
msgctxt "hfcbf897bg3bc5g48f1gac23gd55ca93007f4"
msgid ""
"We've our problems, granted, but there might be some merit in shutting down "
"a local conflict, no?"
msgstr "물론 우리 문제도 있긴 하지만, 이 지역의 분쟁을 막을 수 있는 장점이 있지 않겠어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD
#. Speaker = Zevlor
#. NodeID = 1495f5a3-9b68-e464-41a4-90a7fe8ac6e2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - ea88dfe9-ff39-9b98-ae03-48d7fdf2708e_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD:1495f5a3-9b68-e464-41a4-90a7fe8ac6e2
msgctxt "ha6944f52g77b5g446bg891dg724b48c7a29a"
msgid "The gate needs fortification."
msgstr "관문을 더 보강해야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD
#. Speaker = Zevlor
#. NodeID = a61b6076-bc4d-df58-b6b7-9b48a95a5c24
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - ea88dfe9-ff39-9b98-ae03-48d7fdf2708e_B = True
#. SetFlags:
#.   Local:
#.     - ea88dfe9-ff39-9b98-ae03-48d7fdf2708e_A = False
#.     - ea88dfe9-ff39-9b98-ae03-48d7fdf2708e_B = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD:a61b6076-bc4d-df58-b6b7-9b48a95a5c24
msgctxt "h0079b996g3d3dg4b1ag920dg1b55f25e5c93"
msgid "They'll target the children, if they find us..."
msgstr "그들이 우릴 찾으면, 아이들을 노릴 거야..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD
#. Speaker = Zevlor
#. NodeID = d06a1459-c385-62ac-b515-162d9aff6742
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - ea88dfe9-ff39-9b98-ae03-48d7fdf2708e_A = True
#. SetFlags:
#.   Local:
#.     - ea88dfe9-ff39-9b98-ae03-48d7fdf2708e_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD:d06a1459-c385-62ac-b515-162d9aff6742
msgctxt "hc2acb44eg7f53g4548g8b03g2915c7f77976"
msgid "If more goblins strike now, we're finished."
msgstr "지금 고블린들이 더 쳐들어오면, 우린 끝이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD_DenIntro
#. Speaker = Zevlor
#. NodeID = 27e3c693-4209-db8a-1aa9-6c52b36d7686
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_RaidingParty_Event_KnockOutAdventurer = True
#.      - DEN_RaidingParty_Event_AdventurerLeft = False
#.      - DEN_AdventurerLeader_State_PermaDefeated = False
#.   Local:
#.      - c68c5474-226f-4b47-b327-a22274e360a0_A = True
#. SetFlags:
#.   Local:
#.     - c68c5474-226f-4b47-b327-a22274e360a0_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD_DenIntro:27e3c693-4209-db8a-1aa9-6c52b36d7686
msgctxt "hb29543beg7b91g4374g9abbg11b5a7e894c7"
msgid "Halsin, why would you go anywhere with that fool."
msgstr "할신, 어째서 그 멍청이랑 떠나버린 건가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD_DenIntro
#. Speaker = Zevlor
#. NodeID = 5a80def1-0d6a-c168-56e7-e85954d80eca
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - c68c5474-226f-4b47-b327-a22274e360a0_B = True
#. SetFlags:
#.   Local:
#.     - c68c5474-226f-4b47-b327-a22274e360a0_C = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD_DenIntro:5a80def1-0d6a-c168-56e7-e85954d80eca
msgctxt "h9c54698ag042ag4ec9g9178g30f4f8394591"
msgid "Perhaps we should have stayed in Elturel."
msgstr "엘투렐에 머무르는 편이 나았을지도 모르겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD_DenIntro
#. Speaker = Zevlor
#. NodeID = 8e67a270-ee39-5f19-79f7-6de51bc17b89
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_RaidingParty_Event_KnockOutAdventurer = True
#.      - DEN_RaidingParty_Event_AdventurerLeft = False
#.      - DEN_AdventurerLeader_State_PermaDefeated = False
#. SetFlags:
#.   Local:
#.     - c68c5474-226f-4b47-b327-a22274e360a0_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD_DenIntro:8e67a270-ee39-5f19-79f7-6de51bc17b89
msgctxt "hcbcd8a38g6e80g483eg86cegfacbe0766b86"
msgid "Seems his skull isn't as thick as I thought."
msgstr "그의 두개골은 내가 생각했던 만큼 두텁지 않은 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingLeader_AD_DenIntro
#. Speaker = Zevlor
#. NodeID = afdacdc5-5947-a075-723f-ba6eb958e193
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_RaidingParty_Event_KnockOutAdventurer = True
#.      - DEN_RaidingParty_Event_AdventurerLeft = False
#.      - DEN_AdventurerLeader_State_PermaDefeated = False
