msgctxt "hce7ce8dega019g49bega6cdg956442eefb82"
msgid "... the pact... power..."
msgstr "... 계약... 힘..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_Dead_PostEA
