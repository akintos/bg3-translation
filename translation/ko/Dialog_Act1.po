msgctxt "h12ae8625g4a0eg4416ga38eg73f8c8577f48"
msgid "Sing to me! Sing!"
msgstr "내게 노래해 줘! 어서!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerCharmed
