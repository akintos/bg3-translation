msgctxt "h0246e6c5gae12g4ec6g8b40gca743552b68b"
msgid "Our mission is urgent, and our time short. Do not waste it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_IntelligenceOfficer03
#. Speaker = Ardent Qu'th
#. NodeID = 53a84052-fa75-5d7d-ddd3-5803d533a3ce
