#. CheckFlags:
#.   Object:
#.      - GOB_DrunkGoblin_Event_MockedGoblin(1) = True
#.      - GOB_DrunkGoblin_Event_Mocked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_Friend2:a113b93b-7e09-bff9-39f4-d940d789db21
msgctxt "h27173d5fg1c2ag414aga059ga1c135904e19"
msgid "Why'd ya do that? D'you get off on people lickin' yer feet? Urgh."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_Friend2
#. Speaker = Brawler Tiny
#. NodeID = ae5dffd1-cf6b-9d25-ab40-daac174874a4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_DrunkGoblin_Friend2_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_DrunkGoblin_Friend2_HasMet(1) = True
#. TagRule: DUERGARDWARF or DWARF or GNOME or HALFLING or SHORT
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_Friend2:ae5dffd1-cf6b-9d25-ab40-daac174874a4
msgctxt "h6b3ec097g1e41g4f1agb616g26052633206a"
msgid ""
"What're you starin' at? Think I'm small? Not like yer any taller. Not much."
msgstr "뭘 봐? 내가 작아보여? 너도 별로 키 안 크잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_Friend2
#. Speaker = Brawler Tiny
#. NodeID = ae5dffd1-cf6b-9d25-ab40-daac174874a4
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_DrunkGoblin_Friend2_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_DrunkGoblin_Friend2_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_Friend2:ae5dffd1-cf6b-9d25-ab40-daac174874a4
msgctxt "h5651ed2fg361cg401ega711g1ced68872394"
msgid "What're you starin' at? Think I'm small? Yer just a freak."
msgstr "뭘 봐? 내가 작아보여? 넌 그냥 별종이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_Friend2
#. Speaker = Brawler Tiny
#. NodeID = c2351b18-3e1d-da1a-6c8f-0a5162c9cd52
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_Friend2:c2351b18-3e1d-da1a-6c8f-0a5162c9cd52
msgctxt "h8fc80bd5gd69eg4df3gb512g29b8a8c61e4a"
msgid "Go  away. An' don't speak to me."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_Friend2
#. Speaker = Brawler Tiny
#. NodeID = d6c97fdf-f9b3-7e71-ce65-3657ee90e5a3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_DrunkGoblin_Event_KissedGoblinFeet(1) = True
#.      - GOB_DrunkGoblin_Event_KissedFeet(0) = True
#. SetFlags:
#.   Dialog:
#.     - GOB_DrunkGoblin_Friend2_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_Friend2:d6c97fdf-f9b3-7e71-ce65-3657ee90e5a3
msgctxt "ha7532b73g1c96g428cg9ea2g1c03eb925429"
msgid "Why'd ya do that? I wouldn't <i>touch </i>feet, let alone - urgh."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_Friend2
#. Speaker = Brawler Tiny
#. NodeID = e348b077-70ae-dee7-6a5b-177b3c6b2f4b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_Friend2:e348b077-70ae-dee7-6a5b-177b3c6b2f4b
msgctxt "hbab7d0a1g52e8g4dc4g91b6gfac0df5e0c1e"
msgid "Go wash yer mouth. An' don't speak to me."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_Friend2
#. Speaker = Brawler Tiny
#. NodeID = f2cf3f83-68e2-f808-05aa-3333ccf44c4a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_GoblinToast_State_RealizedPoison = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_Friend2:f2cf3f83-68e2-f808-05aa-3333ccf44c4a
msgctxt "he5ed34bfga550g42ecgae3dgf04c8a769993"
msgid ""
"What? Get yer eyes off me. Ya should be lookin' for that killer, 'fore he "
"slits your throat."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Eye
#. Speaker = Narrator
#. NodeID = 386aef3f-ea39-0d2f-332c-42ca47186d53
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Eye_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Eye:386aef3f-ea39-0d2f-332c-42ca47186d53
msgctxt "h4c51333eg819fg4c62g9a02gc5353ce4722a"
msgid "*The eye doesn't seem to notice your presence.*"
msgstr "*눈은 당신의 존재를 알아 차리지 못하는 듯 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Eye
#. Speaker = Player
#. NodeID = 51d5014d-c94d-b454-9da7-cb64371f058f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Eye:51d5014d-c94d-b454-9da7-cb64371f058f
msgctxt "hefd1e5ebg8de8g47f5g9acagfce34dd2b5a5"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Eye
#. Speaker = Narrator
#. NodeID = 5cd2e703-0e7a-0c6d-16b8-2819bf304cd9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Eye:5cd2e703-0e7a-0c6d-16b8-2819bf304cd9
msgctxt "h04dcd239g3a74g46c5g8513gb9503027bf80"
msgid ""
"*Confusion. Alarm. Then the presence withdraws - leaving a dull black mirror "
"once more.*"
msgstr "*혼란. 경고. 그러더니 물체가 물러나고 또다시 칙칙한 검은 거울이 남습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Eye
#. Speaker = Narrator
#. NodeID = 6495646d-4dc4-0861-90e2-2fccfbbcbc05
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Eye_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_Eye_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Eye:6495646d-4dc4-0861-90e2-2fccfbbcbc05
msgctxt "h96c3516cg98ebg4aa3ga3a4g415f833c7eb5"
msgid "*The eye's glassy black surface reflects your gaze.*"
msgstr "*눈의 투명한 검은 표면이 당신의 응시를 반사합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Eye
#. Speaker = Player
#. NodeID = 8f1124ba-9009-cb02-6cca-5b256dacc71b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Eye:8f1124ba-9009-cb02-6cca-5b256dacc71b
msgctxt "h6812320bg5927g4e67g8c0bgaafef0e15f75"
msgid "<i>Reach out to the presence.</i>"
msgstr "<i>물체에 접근한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Eye
#. Speaker = Narrator
#. NodeID = 936b4ad5-b82e-feef-d4d9-f23f60ad1922
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Eye:936b4ad5-b82e-feef-d4d9-f23f60ad1922
msgctxt "hb7af9838gf593g4e64g9a74gf9756599dc61"
msgid "*You sense no reaction from the unblinking eye.*"
msgstr "*당신은 깜빡이지 않는 눈에게서 아무런 반응도 감지하지 못합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Eye
#. Speaker = Narrator
#. NodeID = 9a77efee-9733-e566-0d0f-1a38131ae1a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Eye:9a77efee-9733-e566-0d0f-1a38131ae1a4
msgctxt "hbc251191gb2d9g4e6dg8a87gace725c6e6b1"
msgid "*You sense no reaction from the unblinking eye.*"
msgstr "*당신은 깜빡이지 않는 눈에게서 아무런 반응도 감지하지 못합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Eye
#. Speaker = Player
#. NodeID = 9d111aba-9c4f-c4ff-41e2-c8b68505bab3
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Eye:9d111aba-9c4f-c4ff-41e2-c8b68505bab3
msgctxt "hcca07eb2g9538g494cg8640g06b09f5db37a"
msgid "<i>Glare back at it.</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Eye
#. Speaker = Player
#. NodeID = 9d111aba-9c4f-c4ff-41e2-c8b68505bab3
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Eye:9d111aba-9c4f-c4ff-41e2-c8b68505bab3
msgctxt "h17697747g8a15g4accgbff6g539cfcf39d04"
msgid "<i>Give a cheerful wave.</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Eye
#. Speaker = Narrator
#. NodeID = d34e6354-fce0-f318-8abe-d6aa94dbb7ce
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_ScryingEyes_State_FeltGaze = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Eye:d34e6354-fce0-f318-8abe-d6aa94dbb7ce
msgctxt "h61076e02g040eg482egb9dfgf34bc95ff435"
msgid ""
"*You feel a brief, lurching connection. The sensation of falling into your "
"own image, endlessly.*"
msgstr "*찰나의 요동치는 연결이 느껴집니다. 자신만의 환상 속으로 끝없이 빠져드는 느낌입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Eye
#. Speaker = Narrator
#. NodeID = dd7facfb-3f8b-55f4-e58a-e9aefaae6882
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Eye:dd7facfb-3f8b-55f4-e58a-e9aefaae6882
msgctxt "h7672fd15g5f74g4fe9g9397g0ba8a17721dd"
msgid "*As you gaze deeper, you feel a focus. An <i>intent</i>.*"
msgstr "*당신이 더 깊이 쳐다볼수록, 초점이 맞춰지는 것을 느낄 수 있습니다. <i>응시</i>가 느껴집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Eye
#. Speaker = Player
#. NodeID = e258d126-5be6-7040-d963-6921032596fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Eye:e258d126-5be6-7040-d963-6921032596fd
msgctxt "hb1bef656ga1f1g4051g901eg38e7c0d555df"
msgid "<i>Poke it.</i>"
msgstr "<i>찔러본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00
#. Speaker = Narrator
#. NodeID = 07daec97-aeda-f3f3-dbd1-318cd9beab01
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Tag:
#.     - TRUESOUL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00:07daec97-aeda-f3f3-dbd1-318cd9beab01
msgctxt "hc6f1f5bagc9b0g466fg800bg5768ec1ef739"
msgid ""
"*Your mind is full, bursting with ecstasy and terror. Finally, it is coming. "
"You are becoming.*"
msgstr "*당신의 정신이 황홀경과 공포로 가득 차오릅니다. 마침내, 때가 됐군요. 당신은 변화 중입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00
#. Speaker = Player
#. NodeID = 11c14245-bc83-5fb4-226a-db916d6d0f1a
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 7
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00:11c14245-bc83-5fb4-226a-db916d6d0f1a
msgctxt "haacafa40g6b3eg4d33gaba3gbcd8ee261c70"
msgid "Sorry - I thought you might need fresh drinks."
msgstr "미안, 네가 새 술이 필요할 줄 알았지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00
#. Speaker = Narrator
#. NodeID = 11fa7166-6747-f9b9-9095-1676dfbea723
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00:11fa7166-6747-f9b9-9095-1676dfbea723
msgctxt "h72cc9328ga5fcg48abg841cgfb8c4b33f805"
msgid "*A shiver runs across your mind... You feel sated.*"
msgstr "*전율이 불현듯 머릿속을 스쳐 지나가고... 만족감이 듭니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00
#. Speaker = Stimk
#. NodeID = 13aed86f-87ca-c1e0-a1e4-a28a1583b858
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00:13aed86f-87ca-c1e0-a1e4-a28a1583b858
msgctxt "hd96053b5g6e3cg4804g8a4bg05c818f06104"
msgid "I hear the Absolute in you."
msgstr "너에게서 절대자님이 들리는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00
#. Speaker = Narrator
#. NodeID = 2850fd0c-3338-5c4e-459f-442d85cea77f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount5(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount5(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00:2850fd0c-3338-5c4e-459f-442d85cea77f
msgctxt "h0a6f27bcgccc8g4265g8676gd11806b4f967"
msgid ""
"*Your blood runs quicker, feeding the gnawing absence at the centre of your "
"mind.*"
msgstr "*피가 더 빨리 흐르면서, 당신의 정신 한가운데를 좀먹는 허전함을 양분으로 채웁니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00
#. Speaker = Stimk
#. NodeID = 28b1364b-5dfa-f3b3-6add-d80b7cf6e6af
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00:28b1364b-5dfa-f3b3-6add-d80b7cf6e6af
msgctxt "hc1827f26g1114g4601g9a6ag0c875a62afbc"
msgid "Yes. Drink will help me to sleep again."
msgstr "맞아. 마시면 다시 잘 수 있겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00
#. Speaker = Player
#. NodeID = 5adc68dd-6139-9f8f-273b-2ea3c053be3d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00:5adc68dd-6139-9f8f-273b-2ea3c053be3d
msgctxt "hbe4c4598g053bg4356gb510g030103fc557f"
msgid "Huh? I was sleeping with the rest of you. No idea who made that racket."
msgstr "흠... 난 너희들이랑 같이 자고 있었어. 누가 소란을 피웠는지 전혀 모르겠는걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00
#. Speaker = Stimk
#. NodeID = 61d6f0d8-a77c-e3c5-1286-819c96fe430e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Festivities_BugbearSleeper_00_TrueSoulCommand(1) = True
#.      - GOB_Festivities_BugbearSleeper_00_HasMet(1) = True
#.   Object:
#.      - GOB_Festivities_Sleeper_WokenByNoise(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00:61d6f0d8-a77c-e3c5-1286-819c96fe430e
msgctxt "h0e55f259g2140g4940ga563g6815c837a633"
msgid "Go away, True Soul. I need sleep."
msgstr "저리 가. 난 자야돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00
#. Speaker = Stimk
#. NodeID = 70f5668c-2053-1cbd-b907-4d971b1e6478
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_Festivities_SleepersFight(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00:70f5668c-2053-1cbd-b907-4d971b1e6478
msgctxt "h7e4bd42bg8f0cg48b5gbbc1g3a467378fb23"
msgid "<i>Nothing.</i> I'll break your skull!"
msgstr "<i>아무것도 없잖아.</i> 네 골통을 부숴버리겠다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00
#. Speaker = Stimk
#. NodeID = 74f3ae99-2a61-1dc5-4378-b50f1fbe019a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_Festivities_SleeperGotBooze(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00:74f3ae99-2a61-1dc5-4378-b50f1fbe019a
msgctxt "h5bc6dcc9g5d2bg4f99g9c8fgae15fb9b85a8"
msgid "Good. Go now. And do not wake me again."
msgstr "좋아. 이제 가. 그리고 다신 날 깨우지마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00
#. Speaker = Stimk
#. NodeID = 7654aa2f-9336-9a33-30c8-4d8b2fa3f61f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Festivities_BugbearSleeper_00_HasMet(1) = True
#.   Object:
#.      - GOB_Festivities_Sleeper_WokenByNoise(0) = True
#. TagRule: DROWELF or DROWHALFELF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00:7654aa2f-9336-9a33-30c8-4d8b2fa3f61f
msgctxt "hcc5169ccga88cg461fg8660g3d559d96a35b"
msgid "Go away, drow. I need sleep."
msgstr "저리 가, 드로우. 난 자야돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00
#. Speaker = Stimk
#. NodeID = 80636c00-01fd-aa1d-a349-f5c4afa065f5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_Festivities_SleepersFight(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00:80636c00-01fd-aa1d-a349-f5c4afa065f5
msgctxt "h4b04e593gaf04g47e7g9b9fg3f209f539958"
msgid "I don't take orders from you. Kill 'em!"
msgstr "난 네게서 명령을 받지 않아. 다 죽여!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00
#. Speaker = Stimk
#. NodeID = 81e2ed57-e117-ddb2-479e-eb9c66dad4bd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00:81e2ed57-e117-ddb2-479e-eb9c66dad4bd
msgctxt "h3767b727g8584g44b2g93d5g95b7ee00a25e"
msgid "I'll rip your tongue, break your legs, <i>make</i> you quiet."
msgstr "네 혀를 뽑고, 다리를 분질러서, 조용히 <i>만들어</i> 주마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00
#. Speaker = Stimk
#. NodeID = 8457b03d-3cbe-bd5d-3b89-f748146a232b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_Festivities_SleepersFight(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00:8457b03d-3cbe-bd5d-3b89-f748146a232b
msgctxt "hd7a22407g88b8g4646g8c3eg5966788e1eb2"
msgid "Too much talking. Too much noise. <i>Glath, glath.</i> You die now!"
msgstr "너무 떠들어대. 너무 시끄러워. <i>글라스, 글라스.</i> 죽었어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00
#. Speaker = Stimk
#. NodeID = 91291093-6803-9abd-a271-d658abaa8e2b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_Festivities_SleepersFight(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00:91291093-6803-9abd-a271-d658abaa8e2b
msgctxt "h6b2019d1g2743g4c57gabfbg88534b77589e"
msgid "Rather break bones than drink more. Your bones."
msgstr "더 마시기 보다는 뼈를 으스러뜨리고 싶은데. 네 뼈를 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00
#. Speaker = Player
#. NodeID = 920a79a7-dffe-f9d4-3c5c-d45cd895ae4b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00:920a79a7-dffe-f9d4-3c5c-d45cd895ae4b
msgctxt "h87e49398gd567g47cdgbd7ag9a907e1052ae"
msgid "You dare speak to me like that? Go back to sleep."
msgstr "감히 내게 그런 식으로 말해? 잠이나 다시 자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00
#. Speaker = Narrator
#. NodeID = 93380078-b0b1-bb70-04ac-86c383c5ca85
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount4(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount4(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00:93380078-b0b1-bb70-04ac-86c383c5ca85
msgctxt "h9a6851ddg531cg46e2ga99fg1ab56a42fd98"
msgid ""
"*A shadow swims across your vision, and a familiar voice tells you to be "
"calm. You are loved.*"
msgstr "*그림자가 낀 듯이 눈앞이 흐려지더니, 익숙한 목소리가 당신을 달래줍니다. 사랑이 느껴집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00
#. Speaker = Player
#. NodeID = 99034d93-8461-ed66-daf7-c31277c4e9a9
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - HALFORC(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00:99034d93-8461-ed66-daf7-c31277c4e9a9
msgctxt "h85b9265cgb737g434bgaf87g1c68f3a5f8f1"
msgid "Go back to sleep before I <i>put</i> you to sleep."
msgstr "내가 널 <i>재워</i>버리기 전에 가서 자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00
#. Speaker = Player
#. NodeID = a1722542-4767-c015-9c94-b01e996d4c11
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_Festivities_SleepersFight(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00:a1722542-4767-c015-9c94-b01e996d4c11
msgctxt "hd82209edgf66ag4996gb95fg323281fed1b5"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00
#. Speaker = Stimk
#. NodeID = a3c7a04a-1327-7981-1a95-9584a4904bd8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00:a3c7a04a-1327-7981-1a95-9584a4904bd8
msgctxt "h1ffad9d3gd529g4567g95dfge89d9ec8e38e"
msgid "Stupid pests. The next person that wakes me dies."
msgstr "멍청한 놈들. 다음에 나 깨우는 놈은 죽었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00
#. Speaker = Narrator
#. NodeID = ad976765-b13f-1991-589d-0bbba169ea3d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount6(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount6(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00:ad976765-b13f-1991-589d-0bbba169ea3d
msgctxt "h334d23c6g982cg4ab8g8c9cg99e062439f9e"
msgid ""
"*The presence deep in your mind is awake, unblinking. This is it. A single "
"word pervades your consciousness: 'Soon'.*"
msgstr ""
"*당신의 정신 속 깊이 자리잡은 존재가 태연스레 깨어납니다. 올 것이 왔군요. 한 단어가 당신의 의식 속으로 스며듭니다. ‘곧’*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00
#. Speaker = Narrator
#. NodeID = af167e44-feb6-b489-51c3-e379c3236297
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = True
#.   Tag:
#.      - ILLITHID(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00:af167e44-feb6-b489-51c3-e379c3236297
msgctxt "h36091f7ag5687g4debg855ag6af532526647"
msgid ""
"*The mark glows, but you feel nothing in response. Your illithid power is "
"beyond reach until you rest.*"
msgstr "*문양이 빛나지만, 어떤 반응도 느껴지지 않습니다. 일리시드 능력을 더 사용하려면 휴식을 취해야 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00
#. Speaker = Stimk
#. NodeID = b1cd2783-2d27-c05e-67cc-83b2ef9e4f75
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Festivities_BugbearSleeper_00_HasMet(1) = False
#.   Object:
#.      - GOB_Festivities_Sleeper_WokenByNoise(0) = True
#. SetFlags:
#.   Dialog:
#.     - GOB_Festivities_BugbearSleeper_00_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00:b1cd2783-2d27-c05e-67cc-83b2ef9e4f75
msgctxt "hf609b691g6910g4242g914agafeb44f75d03"
msgid ""
"<i>Vaws-hak</i>. My head hurts bad. You crash about like a drunken ogre."
msgstr "<i>보스-하크</i>. 머리가 심하게 아파. 넌 술 취한 오우거처럼 뛰어 다니는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00
#. Speaker = Stimk
#. NodeID = b5667299-0d1d-7444-ddd6-87502b1f1da0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00:b5667299-0d1d-7444-ddd6-87502b1f1da0
msgctxt "h4d23c1aag37c4g46a4g878cg783007b02fd7"
msgid "<i>Grashmog</i>... <i>araga ghistpok araga</i>..."
msgstr "<i>그래쉬모그</i>... <i>아라가</i>, <i>크리스트포크</i>, <i>아라가</i>..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00
#. Speaker = Narrator
#. NodeID = b88b2fb3-d68f-dc11-19f8-d7110f61b3e4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ILLITHID(1) = True
#.   User:
#.      - GLO_TadpoleIntro_NPC(1) = False
#. SetFlags:
#.   User:
#.     - GLO_TadpoleIntro_NPC(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00:b88b2fb3-d68f-dc11-19f8-d7110f61b3e4
msgctxt "h087db0ecg6d84g4644ga17egc68de8a32db6"
msgid ""
"*A strange symbol glows, marked on their flesh, and something within you "
"stirs in response.*"
msgstr "*그들의 살갗에 새겨진 기묘한 상징이 빛나고, 이에 반응하여 당신 내면의 무언가가 꿈틀거립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00
#. Speaker = Stimk
#. NodeID = bd9827b3-0b73-28af-5a10-fbfac0c0a785
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_Festivities_SleeperCheckInventory(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00:bd9827b3-0b73-28af-5a10-fbfac0c0a785
msgctxt "ha483dad5g9d85g4004g8f9fg9126dbda1b5f"
msgid "What did you bring for me?"
msgstr "내게 뭘 줄 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00
#. Speaker = Player
#. NodeID = cc49d980-221a-3fdb-37bd-009fa5b3e811
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = False
#.      - HALFORC(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00:cc49d980-221a-3fdb-37bd-009fa5b3e811
msgctxt "hfc2474a5g97afg4a07gbef0g82f151808d46"
msgid "Sleep is for the weak. I could have killed you where you lay."
msgstr "잠은 나약한 자들이나 자는 거야. 네가 누워있을 때 죽일 수 있었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00
#. Speaker = Narrator
#. NodeID = d0e9b041-b28b-32db-5c21-dca87562767a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ILLITHID(1) = True
#.   User:
#.      - GLO_TadpoleIntro_NPC(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00:d0e9b041-b28b-32db-5c21-dca87562767a
msgctxt "h929c0b28g862cg4ac1gb0aaga0828764ab09"
msgid "*As the symbol glows, power courses through you. <i>Authority</i>.*"
msgstr "*문양이 빛나며, 몸에 흐르는 힘이 느껴집니다. <i>권위</i>.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00
#. Speaker = Stimk
#. NodeID = dbaadca8-ed2d-0bda-27ee-cef0c5a8ca38
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_Festivities_BugbearSleeper_00_TrueSoulCommand(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00:dbaadca8-ed2d-0bda-27ee-cef0c5a8ca38
msgctxt "h3a46c2d8ga0c8g4a12gbee4g0f792e2fd0e4"
msgid "Do not disturb me again, True Soul."
msgstr "날 또 깨우지 마라, 참된 영혼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00
#. Speaker = Stimk
#. NodeID = e14718c6-bb98-f984-5490-053c383686ef
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Festivities_BugbearSleeper_00_HasMet(1) = True
#.   Object:
#.      - GOB_Festivities_Sleeper_WokenByNoise(0) = True
#. SetFlags:
#.   Object:
#.     - GOB_Festivities_SleepersFight(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00:e14718c6-bb98-f984-5490-053c383686ef
msgctxt "hd5e317d9g851eg45a4gbcffg064aca433242"
msgid "No more excuses. I'll crack your skull!"
msgstr "번명하지 마. 골통을 부숴버릴 거야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00
#. Speaker = Player
#. NodeID = e8d80c9b-20e8-1a97-02cc-696187015097
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 2
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#.      - ILLITHID(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00:e8d80c9b-20e8-1a97-02cc-696187015097
msgctxt "h318398c1g1cf1g47a2gbf7fged343b99010c"
msgid "You dare speak to me like that? Go back to sleep."
msgstr "감히 내게 그런 식으로 말해? 잠이나 다시 자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00
#. Speaker = Stimk
#. NodeID = e92d9dd7-8fa1-b1b3-1983-f3e3c278ceaa
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00:e92d9dd7-8fa1-b1b3-1983-f3e3c278ceaa
msgctxt "hb6f31257ga002g4ad9g9f1bgdb10bce2209d"
msgid "Didn't think drow were so clumsy. Leave us to rest."
msgstr "드로우가 이렇게 서투른 줄 몰랐네. 우릴 쉬게 놔둬."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00
#. Speaker = Stimk
#. NodeID = ec40a23f-e284-a927-7154-91115fd051fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00:ec40a23f-e284-a927-7154-91115fd051fd
msgctxt "hfc599c29g9cf8g499egbc70g54384c064e28"
msgid ""
"You are right. You are strong. But if you wake me again, I will kill "
"<i>you</i>."
msgstr "네가 맞아. 넌 강해. 근데 날 또 깨운다면 <i>널</i> 죽일 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00
#. Speaker = Narrator
#. NodeID = f17a3859-be7d-54a3-8a0a-f478f04da821
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount3(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount3(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00:f17a3859-be7d-54a3-8a0a-f478f04da821
msgctxt "hc2ad336dged92g4167gb324g6de760c1ff15"
msgid "*Your mind lurches, reeling suddenly as if... bitten.*"
msgstr "*뭔가에 깨물린 것처럼 느닷없이 정신이 휘청거립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00
#. Speaker = Player
#. NodeID = f305bcb6-22f4-2552-136e-5eeb28988806
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00:f305bcb6-22f4-2552-136e-5eeb28988806
msgctxt "h4b929778g6b3fg489ag9d14g8497bb366e6b"
msgid "SLEEP, OR <b>DIE</b>. YOUR CHOICE."
msgstr "자, <b>죽거나</b>. 니 선택이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00
#. Speaker = Narrator
#. NodeID = f96d2e30-e279-0d62-ac0e-1b207d29298a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount2(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_00:f96d2e30-e279-0d62-ac0e-1b207d29298a
msgctxt "hf7008091g3832g4a9fg825bg3f318ab8ed16"
msgid ""
"*Something stirs deep within you, hungry and alert... it's taking something "
"you'll never get back.*"
msgstr "*몸 깊숙한 데서 굶주리고 기민한 존재가 꿈틀댑니다... 잃으면 되찾지 못할 뭔가를 좀먹고 있군요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_01
#. Speaker = Teghun
#. NodeID = 71a7daf7-954d-26c9-ea47-02ed85a5280c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_BugbearSleeper_01:71a7daf7-954d-26c9-ea47-02ed85a5280c
msgctxt "hc977aee9g490ag48fcga48dg452e8174c15f"
msgid "*Snarl.*"
msgstr "*으르렁*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Bugbear_Wanderer
#. Speaker = Bao'ek'nuk
#. NodeID = 0bdc1e2f-2fc4-83c1-835d-2580800ae45b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Bugbear_Wanderer:0bdc1e2f-2fc4-83c1-835d-2580800ae45b
msgctxt "h6b953eb0g13d7g4618gad31g4e5433cc7aab"
msgid "Poisonin' the only good thing in this dump..."
msgstr "이 똥통에서 그나마 좋았던 걸 망치다니..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Bugbear_Wanderer
#. Speaker = Bao'ek'nuk
#. NodeID = 4126438e-761e-0890-abd3-b8e2acdb5123
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Festivities_HasMet_BugbearWanderer(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Bugbear_Wanderer:4126438e-761e-0890-abd3-b8e2acdb5123
msgctxt "h8e7acf6dgb7f9g4709g90b6g20f9117bbba8"
msgid "*Grumble.*"
msgstr "*투덜 거리는 소리.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Bugbear_Wanderer
#. Speaker = Bao'ek'nuk
#. NodeID = 4126438e-761e-0890-abd3-b8e2acdb5123
#. HandlePath = TaggedText[0].TagText[1]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Festivities_HasMet_BugbearWanderer(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Bugbear_Wanderer:4126438e-761e-0890-abd3-b8e2acdb5123
msgctxt "hb5475727g3f1bg4e86gaf20gb2ed5741088d"
msgid "*Yawn.*"
msgstr "*하품.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Bugbear_Wanderer
#. Speaker = Bao'ek'nuk
#. NodeID = 4126438e-761e-0890-abd3-b8e2acdb5123
#. HandlePath = TaggedText[0].TagText[2]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Festivities_HasMet_BugbearWanderer(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Bugbear_Wanderer:4126438e-761e-0890-abd3-b8e2acdb5123
msgctxt "hf9e896ffgd247g428cga86cgf96b8eb71169"
msgid "*Grunt.*"
msgstr "*끙.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Bugbear_Wanderer
#. Speaker = Bao'ek'nuk
#. NodeID = 6b4cf6bb-8930-9aba-3fb9-a033baa9b7ae
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_GoblinToast_State_RealizedPoison = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Bugbear_Wanderer:6b4cf6bb-8930-9aba-3fb9-a033baa9b7ae
msgctxt "h293d1427gd387g4e18g9c04ga85763368f35"
msgid ""
"You find the ones who poisoned that beer, you bring 'em to me. I'll take "
"their heads for free."
msgstr "술에 독 타고 튄 놈 찾아내면, 나한테 데려와. 내가 손수 목을 베어줄테니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Bugbear_Wanderer
#. Speaker = Bao'ek'nuk
#. NodeID = f64f60fb-7f69-94d1-18ec-3d82e349bcce
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_Festivities_HasMet_BugbearWanderer(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Bugbear_Wanderer:f64f60fb-7f69-94d1-18ec-3d82e349bcce
msgctxt "hf710b1e6g4d98g4134ga84cg6764263da208"
msgid "I ain't paid to talk. Keep walkin'."
msgstr "놀려고 돈 받은 거 아니다. 갈 길 가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = 014a7f60-29e9-fcbf-6245-165c25d854f7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:014a7f60-29e9-fcbf-6245-165c25d854f7
msgctxt "hbabe70c8g84d6g4ef4g85c5g912b84d65071"
msgid "'S good meat if you can get it. Better than bloody chicken anyhow."
msgstr "잡을 수만 있다면 고기가 많다고. 빌어먹을 닭보단 나아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = 06847e54-3bce-53ca-f858-468762deaa19
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:06847e54-3bce-53ca-f858-468762deaa19
msgctxt "h7b9c71a2ge28fg46aag9b32gba6eac14c1ba"
msgid ""
"Dunno. Woz already stripped down to his breeches when I got my hands on 'im."
msgstr "나도 몰라. 워즈가 이미 바지 빼고 다 벗겨 먹어서, 난 남은 걸 가져왔을 뿐이라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = 0a19f469-f790-3a56-d26b-fd47fbb38155
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:0a19f469-f790-3a56-d26b-fd47fbb38155
msgctxt "hc8e8a38eg96d1g4922gb819ga8370c4ea27c"
msgid ""
"Wot? It's a load of old bollocks... all this moons and stars rubbish. "
"Embarrassin' is wot it is."
msgstr "뭐야? 그냥 헛소리나 적어놓은 거지... 이 달이니 별이니 지껄이기나 하고. 보기만 해도 징그럽다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = 0e777582-8509-6f6e-57e2-a7d00bd420f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:0e777582-8509-6f6e-57e2-a7d00bd420f4
msgctxt "h1e9ff813ga640g48e6g81c1g1263b5e317a9"
msgid ""
"Silly little whisker-wart came bargin' in 'ere with his mates causin' a "
"ruckus."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = 13e95827-23d1-f148-74fd-28be86ac2c6e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_SharTempleEntrance_HasMap(0) = True
#. TagRule: DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:13e95827-23d1-f148-74fd-28be86ac2c6e
msgctxt "hd4c76576g95d2g4515g9bb0g6818608b7a27"
msgid ""
"Of course! I'm thinking of selling it - reckon it's worth anything, boss?"
msgstr "당연하지! 어차피 팔 생각이었어. 이게 가치가 있다고 생각해, 두목?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = 1437bf56-ccda-3659-1593-b1addebdd0ab
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_SharTempleEntrance_HasMap(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:1437bf56-ccda-3659-1593-b1addebdd0ab
msgctxt "hdd509ae0gb3f0g43c4g90f1g53f6ad86c23b"
msgid "Really? S'pose it don't matter that somebody already nicked it then."
msgstr "그래? 그럼 누가 훔쳐간 것도 큰 문제는 아니었나 보네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = 15158abe-f9ed-ed9d-6df2-520dbeac52a0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_SharTempleEntrance_HasMap(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:15158abe-f9ed-ed9d-6df2-520dbeac52a0
msgctxt "h22bc2c9bgfbafg4ffdg8890g88d0cb31587c"
msgid ""
"Er, don't be angry, boss, but I can't find the bloody thing. Someone must "
"have nicked it."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = 173c374b-ba83-125c-7ba0-6a464bb8105b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_GoblinToast_State_RealizedPoison = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:173c374b-ba83-125c-7ba0-6a464bb8105b
msgctxt "h9d1265cega286g46f3gb754gfff2d84a0775"
msgid "Some coward move, poisonin' our drink. But we'll get them, you'll see."
msgstr "어떤 비겁한 놈이 우리 술에다 독을 탔더군. 그 자식 찾아낼 거야, 두고 보라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = 191868db-9e49-0c0c-61df-2710af070ea4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_RoastingDwarf0_HasMet(1) = False
#.   Global:
#.      - GOB_RoastingDwarf_Quest_MeatStolen = False
#. SetFlags:
#.   Dialog:
#.     - GOB_RoastingDwarf0_HasMet(1) = True
#. TagRule: !DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:191868db-9e49-0c0c-61df-2710af070ea4
msgctxt "h35c7907eg9638g47b3ga055g883b1b46ef69"
msgid "Enjoyin' the view? Lookin' tasty in these new breeches, ain't I?"
msgstr "내 외모가 마음에 드나? 새 바지를 입고 있으니 섹시해 보이지 않아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = 191868db-9e49-0c0c-61df-2710af070ea4
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_RoastingDwarf0_HasMet(1) = False
#.   Global:
#.      - GOB_RoastingDwarf_Quest_MeatStolen = False
#. SetFlags:
#.   Dialog:
#.     - GOB_RoastingDwarf0_HasMet(1) = True
#. TagRule: DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:191868db-9e49-0c0c-61df-2710af070ea4
msgctxt "hfa3f1892g2aa9g472dg8578g1a2dc9c6ebd3"
msgid ""
"Greetings, your most excellent drow-ness. What do you think of these "
"breeches? Could be a new uniform."
msgstr "환영해, 가장 훌륭한 드로운 님. 이 바지 어때? 새 군복이 될 수도 있겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = 1d5ace62-f88d-6b01-8851-035892798ea7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_SharTempleEntrance_HasMap(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:1d5ace62-f88d-6b01-8851-035892798ea7
msgctxt "h9612a3f6g868fg4288g95adg31f290e95d81"
msgid "Hang on. I can't find the bloody thing. Somebody's robbed it!"
msgstr "잠깐만. 그 망할 물건이 사라졌잖아. 누군가 훔쳐갔어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = 2778c801-7452-1b0c-8049-16476c19db31
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 1ab4230e-d8f1-3e6f-5284-ec5113c27131_GOB_DwarfOperator_ReadMind = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:2778c801-7452-1b0c-8049-16476c19db31
msgctxt "he379dd60g07ecg4bf3gbf6cg44d566abfb8f"
msgid ""
"<i>Some of these words are real pretty. But if the lads find out how much I "
"enjoy it, they'll stick ME on the spit.</i>"
msgstr ""
"<i>이 단어들이 꽤 아름답긴 해. 하지만 내 친구들이 내가 이걸 즐기고 있다는 걸 알아내면, 녀석들이 <b>날</b> 꼬챙이에 꽂아버릴 "
"거야.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = 27d55501-725e-d124-3af2-7490d9cc62d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:27d55501-725e-d124-3af2-7490d9cc62d9
msgctxt "hab827622g947cg4690ga06dgb5d1ac2d9bf1"
msgid ""
"Don't take it personal. If my mate Grikka was dead and I woz hungry, I'd eat "
"'im."
msgstr "괜히 마음 상하지 마. 내 친구 그리카가 죽었어도 배고프면 먹었을 거니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = 2888e505-e23b-7f2b-0ce1-90edd1cc1fa6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_SharTempleEntrance_HasMap(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:2888e505-e23b-7f2b-0ce1-90edd1cc1fa6
msgctxt "hd597d6bbgc193g4712g92a7gcff7f135b25a"
msgid "Hang on. I can't find the bloody thing. Somebody's robbed it!"
msgstr "잠깐만. 그 망할 물건이 사라졌잖아. 누군가 훔쳐갔어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = 2d762ae7-e6c2-1341-4293-121f3fe711cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:2d762ae7-e6c2-1341-4293-121f3fe711cb
msgctxt "hb00bceb9gde5ag4587gbe9eg684a7750e3be"
msgid ""
"Maybe I just ain't got the brains for it... but that dwarf poem don't make "
"sense."
msgstr "내가 그냥 머리가 딸리는 걸지도 모르겠지만... 이놈의 드워프 시는 이해가 안 돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = 2e2b6967-ed78-0536-8672-51239e1473a0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_SharTempleEntrance_HasMap(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:2e2b6967-ed78-0536-8672-51239e1473a0
msgctxt "hf81fd377g34feg44e5gbe95g3abfa2cbc209"
msgid "If you ain't willin' to pay up, I'll keep it!"
msgstr "돈 낼 생각 없으면, 내가 간직하려고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = 2e7e5c00-d0e8-95af-8fcc-b48817a14db5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_SharTempleEntrance_HasMap(0) = False
#. SetFlags:
#.   Object:
#.     - GOB_RoastingDwarf_SoldPoem(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:2e7e5c00-d0e8-95af-8fcc-b48817a14db5
msgctxt "h89d9d9bdgb6e3g4b67ga713g9e4bec5132d9"
msgid ""
"Cheers! Now I can get me a fancy belt and <i>really</i> impress the lads."
msgstr "이야! 이제 멋진 벨트도 사서 <i>제대로</i> 다른 놈들에게 자랑할 수 있겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = 2ee7c737-ce4f-8619-8937-42663cbe92d5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_Checkpoint_State_Paint(1) = False
#. TagRule: TIEFLING
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:2ee7c737-ce4f-8619-8937-42663cbe92d5
msgctxt "h8837340egfc37g4553gbf25g1157ca734117"
msgid ""
"An' I ain't takin' fashion advice from someone who 'as to cut tail-holes in "
"their pants."
msgstr "그리고 바지에 꼬리 구멍을 뚫는 놈이 옷차림에 대해 뭘 안다고 참견이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = 32637635-3056-2d60-eb19-07494b904035
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_Checkpoint_State_Paint(1) = True
#. TagRule: !DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:32637635-3056-2d60-eb19-07494b904035
msgctxt "hf170a7f5g97f8g4b94g8941ge20e775e2edf"
msgid ""
"An' I ain't takin' fashion advice from someone with worg-dung on their face."
msgstr "그리고 얼굴에 워그 똥을 펴바른 놈이 옷차림에 대해 뭘 안다고 참견이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Player
#. NodeID = 33176c1a-6197-49a0-df96-61194cc4a3c7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_DwarfOperator_ToldAboutDwarf = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:33176c1a-6197-49a0-df96-61194cc4a3c7
msgctxt "hc44cf16agaa87g4302gb1cdg88a5a7accc01"
msgid "How'd you manage to catch a dwarf?"
msgstr "드워프는 어떻게 잡았지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = 33293cc4-d21e-759f-c8df-c75dc46324ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:33293cc4-d21e-759f-c8df-c75dc46324ae
msgctxt "hee12eea3ge633g4d85g8f17g5f4866a363cf"
msgid "Are you kiddin'? I look <i>fantastic</i>."
msgstr "장난해? 난 지금 <i>환상적이라고</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Player
#. NodeID = 38895379-0e6d-e13d-6886-081aa39a87fd
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 5
#. CheckFlags:
#.   Dialog:
#.      - GOB_RoastingDwarf_State_TriedToReadMind(1) = False
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#.      - ILLITHID(1) = True
#. SetFlags:
#.   Dialog:
#.     - GOB_RoastingDwarf_State_TriedToReadMind(1) = True
#.     - GOB_RoastingDwarf_State_TriedToPersuade(1) = True
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:38895379-0e6d-e13d-6886-081aa39a87fd
msgctxt "he23c9b0ag61f3g438ag87a5g2057243ecc34"
msgid "The Absolute does not ask. Certainly not <i>twice.</i>"
msgstr "절대자께서는 부탁을 하시지 않는다. <i>두 번은 절대 아니지.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = 4401f982-ef16-2099-06fb-a8e083ee6262
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:4401f982-ef16-2099-06fb-a8e083ee6262
msgctxt "h88f1c803gf825g4b00g8ae6g7ecd15d4b0d4"
msgid "Daft bastard came to us! An' I'd been prayin' for a square meal..."
msgstr "멍청한 자식이 내게 왔어! 난 만족스런 식사를 위해 기도하고 있었는데..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = 4c891863-8e16-4975-c7c7-ba5f52e8416f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_SharTempleEntrance_HasMap(0) = False
#. SetFlags:
#.   Object:
#.     - GOB_RoastingDwarf_SoldPoem(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:4c891863-8e16-4975-c7c7-ba5f52e8416f
msgctxt "h3dbb8c2fg52e6g410fg939eg0011a4c14091"
msgid "Cheers, mate. There ya go!"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = 5371e52e-9caa-57b2-0c22-2a01ddabac68
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: FEMALE and DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:5371e52e-9caa-57b2-0c22-2a01ddabac68
msgctxt "h94c85b71g6fd9g40f1ga192g1fcfee9c9e37"
msgid "Reckon it's worth anything, mistress?"
msgstr "뭐라도 가치가 있을 것 같습니까, 마님?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = 5371e52e-9caa-57b2-0c22-2a01ddabac68
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:5371e52e-9caa-57b2-0c22-2a01ddabac68
msgctxt "h7314e1d8g0689g4990gb8eag883d8d613722"
msgid "Reckon it's worth anything, boss?"
msgstr "뭐라도 가치가 있을 것 같습니까, 대장?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Narrator
#. NodeID = 54d8b2fa-4757-571f-9b5a-8fcc2670a151
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount2(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:54d8b2fa-4757-571f-9b5a-8fcc2670a151
msgctxt "h7eb3039dg781eg4f9ag9bffg29be963a20a4"
msgid ""
"*Something stirs deep within you, hungry and alert... it's taking something "
"you'll never get back.*"
msgstr "*몸 깊숙한 데서 굶주리고 기민한 존재가 꿈틀댑니다... 잃으면 되찾지 못할 뭔가를 좀먹고 있군요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = 559c2c90-a668-2fe7-c257-e5cc479f224c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:559c2c90-a668-2fe7-c257-e5cc479f224c
msgctxt "h4b65ec47ge197g474dgb0efgcb96d25f0129"
msgid "Bet he'd taste real good, too."
msgstr "맛도 굉장하겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = 55aac5a8-1908-38da-af82-ed512be6b5f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:55aac5a8-1908-38da-af82-ed512be6b5f0
msgctxt "h6e17db0fgaaffg435fga159g18dbfc76258f"
msgid "Enjoy the party, boss."
msgstr "파티를 즐겨, 대장."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = 586cbe87-c2ef-9479-96ce-678d60e94190
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:586cbe87-c2ef-9479-96ce-678d60e94190
msgctxt "h7efb5529g7661g48c2g9642gd3e141fccea6"
msgid "You heard right."
msgstr "제대로 들었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Narrator
#. NodeID = 5a67db11-58c7-442b-d144-d0d18645b0e4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - GLO_TadpoleIntro_NPC(1) = False
#. SetFlags:
#.   User:
#.     - GLO_TadpoleIntro_NPC(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:5a67db11-58c7-442b-d144-d0d18645b0e4
msgctxt "h1d92bd7ag2c69g4f95g9f7cg9e7b4d7a3f06"
msgid ""
"*A strange symbol glows, marked on their flesh, and something within you "
"stirs in response.*"
msgstr "*그들의 살갗에 새겨진 기묘한 상징이 빛나고, 이에 반응하여 당신 내면의 무언가가 꿈틀거립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = 5c00b7c2-f22d-9a54-fa41-6cce4aff5b25
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:5c00b7c2-f22d-9a54-fa41-6cce4aff5b25
msgctxt "h960efd86g78e4g4e0bgbed7gbc24ddf20037"
msgid "Nuffin' in his pants except a coupla coins and some lousy poem."
msgstr "놈의 바지 속에는 동전 몇 개와 형편없는 시 몇 편을 제외하고는 아무것도 없었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = 5d6780a2-58c0-7ae0-d095-db956a12aa6b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_SharTempleEntrance_HasMap(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:5d6780a2-58c0-7ae0-d095-db956a12aa6b
msgctxt "hdb0edc7fg9115g4a8agb2a2g3f122573f4ef"
msgid "Someone else already snagged it. Weren't worth nothin' anyhow."
msgstr "다른 사람이 이미 가져갔어. 어차피 아무 짝에 쓸모도 없는 거였지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Player
#. NodeID = 5e2dc0ec-fb2b-74cf-df44-34ca55fd261c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 0
#. CheckFlags:
#.   Local:
#.      - 1ab4230e-d8f1-3e6f-5284-ec5113c27131_GOB_DwarfOperator_ReadMind = False
#.   Script:
#.      - GEN_CanDetectThoughts_2 = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:5e2dc0ec-fb2b-74cf-df44-34ca55fd261c
msgctxt "h219e9643gaf8dg4352g9b96g10c686bc8b5f"
msgid "<i>Read his thoughts.</i>"
msgstr "<i>그의 생각을 읽는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = 5fc75f7d-b90c-d286-2b29-9ae84cc86f0f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:5fc75f7d-b90c-d286-2b29-9ae84cc86f0f
msgctxt "h8a3dcea2g368eg4fc2g837dgca19fe193d5e"
msgid ""
"Who you tryin' to kid? You want this for yerself. And that means you better "
"cough up some coin."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = 6b4d06c8-548f-a3d1-e30c-df53f6f0c44e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:6b4d06c8-548f-a3d1-e30c-df53f6f0c44e
msgctxt "hcab53b27g837cg4f60g85fegdbf94b3a1cc8"
msgid "You havin' a laugh? I need the money to buy meself a belt."
msgstr "농담하는 거야? 내가 벨트를 사려면 돈이 필요해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Narrator
#. NodeID = 73c231c2-753a-0282-cf0d-973167cdb1b6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - GLO_TadpoleIntro_NPC(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:73c231c2-753a-0282-cf0d-973167cdb1b6
msgctxt "he66dc3bbg219dg43cfga405geedc1fc09db9"
msgid "*As the symbol glows, power courses through you. <i>Authority</i>.*"
msgstr "*문양이 빛나며, 몸에 흐르는 힘이 느껴집니다. <i>권위</i>.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Player
#. NodeID = 755db8a1-785b-55c0-3400-af6e8fbb7ee4
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Dialog:
#.      - GOB_RoastingDwarf_State_TriedToPersuade(1) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_RoastingDwarf_State_TriedToPersuade(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:755db8a1-785b-55c0-3400-af6e8fbb7ee4
msgctxt "haecc3658g3ccdg4e98ga32cgec1114a93cdf"
msgid "You're wasting your time. Dwarven poetry is worthless."
msgstr "넌 시간을 낭비하고 있는 거야. 드워프의 시는 쓰레기라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Narrator
#. NodeID = 7593d20e-17bc-41fc-9710-1ee61d1b9fc2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Tag:
#.     - TRUESOUL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:7593d20e-17bc-41fc-9710-1ee61d1b9fc2
msgctxt "ha3bf5d77g3cd9g48c2gb829gc543a0bf9aa1"
msgid ""
"*Your mind is full, bursting with ecstasy and terror. Finally, it is coming. "
"You are becoming.*"
msgstr "*당신의 정신이 황홀경과 공포로 가득 차오릅니다. 마침내, 때가 됐군요. 당신은 변화 중입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Player
#. NodeID = 78b6a505-3a2a-40ba-9e49-c5d9ae576e3e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:78b6a505-3a2a-40ba-9e49-c5d9ae576e3e
msgctxt "h2e907230g9116g4fb9gb71dg2e23b2369dd9"
msgid "The dwarf - did he have anything on him? Besides pants."
msgstr "그 드워프 - 다른 물건은 없었나? 그 바지는 빼고 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = 7b5bb95c-2c50-7a26-fab3-f51c604f492c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:7b5bb95c-2c50-7a26-fab3-f51c604f492c
msgctxt "h1e85db8dgb9f2g46dfg8a3dga30f777a183f"
msgid ""
"<i>Mebbe</i> they're a bit loose, but that's cuz I keep myself in shape."
msgstr "<i>약가는</i> 헐렁하긴 하지만, 그건 내가 운동을 열심히 해서 그런 거라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = 7f62b8b4-0449-9ee6-5bc6-0f62ccb9d97b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:7f62b8b4-0449-9ee6-5bc6-0f62ccb9d97b
msgctxt "hca878830g2edfg4b40gbafdg731be6df63bf"
msgid "Give me enuff to buy a belt an' a fancy hat, an' it's yours."
msgstr "허리띠랑 멋진 모자 살 돈만 주면, 네게 주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Player
#. NodeID = 8185838b-49b8-fdbe-65af-aa04727fd48a
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:8185838b-49b8-fdbe-65af-aa04727fd48a
msgctxt "h5b556ab9g7311g4c07g91deg785b08273466"
msgid "I didn't make myself clear. Give it to me now."
msgstr "내 말이 분명하지 못했군. 그거 당장 내놔."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Player
#. NodeID = 860956a6-5931-3fde-6b9f-536478b9453f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:860956a6-5931-3fde-6b9f-536478b9453f
msgctxt "h940adc01gf388g4cfcgaf63gad3820d347e3"
msgid "I love poetry - can I see?"
msgstr "시라면 환영이지, 봐도 될까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Player
#. NodeID = 87ce3263-8288-86b1-3023-6453dfaba738
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_DwarfOperator_ToldAboutDwarf = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:87ce3263-8288-86b1-3023-6453dfaba738
msgctxt "h632d06a9g8051g41ceg8b02gb77e7f8e6c07"
msgid "Is that the dwarf who tried to sneak into your camp?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = 88be29b2-416c-d157-0a98-d87e4427ce30
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_SharTempleEntrance_HasMap(0) = False
#. SetFlags:
#.   Object:
#.     - GOB_RoastingDwarf_SoldPoem(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:88be29b2-416c-d157-0a98-d87e4427ce30
msgctxt "h9366241fgf4e1g4e14ga292ga7f84ce1116f"
msgid ""
"Cheers! Now I can get me a fancy belt and <i>really</i> impress the lads."
msgstr "이야! 이제 멋진 벨트도 사서 <i>제대로</i> 다른 놈들에게 자랑할 수 있겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Player
#. NodeID = 8975fe26-f10a-63f1-cd83-fce29c06b6ac
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_RoastingDwarf_InsultedPants(1) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_RoastingDwarf_AdmiredPants(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:8975fe26-f10a-63f1-cd83-fce29c06b6ac
msgctxt "h8a5a3cdfgadc6g4c60g8f94g24d923de2a1f"
msgid "They look quite fetching on you."
msgstr "꽤 멋지네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = 8bbf7b12-c672-647b-2c88-b85837d74352
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_SharTempleEntrance_HasMap(0) = True
#. SetFlags:
#.   Object:
#.     - GOB_RoastingDwarf_SoldPoem(1) = True
#.     - GOB_SharTempleEntrance_GiveMap(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:8bbf7b12-c672-647b-2c88-b85837d74352
msgctxt "hc1525dbeg1b9ag4cc8gb4b5gb84521e905c1"
msgid "Of course! I wouldn't keep nuffin' from the Absolute!"
msgstr "물론! 절대자님께는 뭐든지 바쳐야지!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = 8e719b6e-1a18-cdee-3f5d-bf8b81eebae0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_SharTempleEntrance_HasMap(0) = True
#. SetFlags:
#.   Object:
#.     - GOB_SharTempleEntrance_GiveMap(1) = True
#.     - GOB_RoastingDwarf_GavePoem(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:8e719b6e-1a18-cdee-3f5d-bf8b81eebae0
msgctxt "h9a0f1c6ege204g4872g868ag99dfff464738"
msgid "Really? Ah, shite. You might as well use it as bog roll then."
msgstr "정말? 아, 젠장. 그럼 화장지로 쓰는 게 낫겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Player
#. NodeID = 9273c397-c7be-f2f2-302f-d3b153a6c0fe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:9273c397-c7be-f2f2-302f-d3b153a6c0fe
msgctxt "h99d5596eg94d6g4d12gb386gc716fa3790ea"
msgid "You're talking about my kin. Show some respect."
msgstr "내 동족이야. 말 가려서 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Narrator
#. NodeID = 99647e46-e18a-4599-553d-f455afe4336f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount5(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount5(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:99647e46-e18a-4599-553d-f455afe4336f
msgctxt "hd9d7d190gd27eg49e6g9e21g9510abc44c04"
msgid ""
"*Your blood runs quicker, feeding the gnawing absence at the centre of your "
"mind.*"
msgstr "*피가 더 빨리 흐르면서, 당신의 정신 한가운데를 좀먹는 허전함을 양분으로 채웁니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = 9f159a22-1957-b140-9523-b8c68a0c2d6f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_SharTempleEntrance_HasMap(0) = True
#. TagRule: !DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:9f159a22-1957-b140-9523-b8c68a0c2d6f
msgctxt "h94b5c5ceg8163g43e7g9750g71f69ecfdeee"
msgid "Sure you can. But a look's all yer gettin'."
msgstr "물론이야. 하지만 보는 것만 허락하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = 9f994a1c-fa24-e9a0-91bd-c6cfc2c9f3e4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_RoastingDwarf_SoldPoem(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:9f994a1c-fa24-e9a0-91bd-c6cfc2c9f3e4
msgctxt "h48ad7e65ga39dg4c90g8060gead27ec3ac6b"
msgid "Get any joy out of the poem? Load of nonsense, innit?"
msgstr "시는 좀 즐겼나? 그냥 헛소리뿐이지, 그러치?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = a05bc697-2401-9bea-86b0-dcdee2d34679
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_RoastingDwarf_Quest_MeatStolen = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:a05bc697-2401-9bea-86b0-dcdee2d34679
msgctxt "hf3f4899eg05d4g4687g8856g2f72f35ef6d7"
msgid "Wot happened to the meat?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Player
#. NodeID = a0d7e823-184a-7e06-5417-1405b3eb5b1b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:a0d7e823-184a-7e06-5417-1405b3eb5b1b
msgctxt "hbee7512bg4d5cg4a20ga3c3g40a72402a127"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Player
#. NodeID = a157f011-7b60-9590-7e67-3c01a7faae08
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:a157f011-7b60-9590-7e67-3c01a7faae08
msgctxt "h650dd640g9febg48e6g8029g4278bc94e9b6"
msgid "What happened to the rest of him?"
msgstr "그에게 어떤 일이 일어난 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = a8bb5f78-d0cf-e749-cbe5-f79e31a53c15
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:a8bb5f78-d0cf-e749-cbe5-f79e31a53c15
msgctxt "h2e6faa70g4623g4f12gaca1ge5b673f8f808"
msgid "Pay up an' it's yours."
msgstr "돈을 내면 네 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = ab4152f0-c65c-4bc9-1f6a-a8cfa5a3f8ce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:ab4152f0-c65c-4bc9-1f6a-a8cfa5a3f8ce
msgctxt "hf81d909eg6ef9g4de1ga5b7g5c95494406c0"
msgid "That's him, on the spit! Plenty of him to go around once he's cooked."
msgstr "저게 그 녀석이야, 꼬챙이에 매달려 있는 거! 익히고 나면 한 바퀴는 돌릴 수 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Player
#. NodeID = b1ae181f-1f71-add4-353b-a7260223146a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:b1ae181f-1f71-add4-353b-a7260223146a
msgctxt "h6252155fg9b16g493bgaf3ag5507de59fae9"
msgid "Do you make a habit of eating dwarves?"
msgstr "평소에도 드워프를 즐겨 먹나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Player
#. NodeID = b3fcf5e5-780e-17f7-3c64-a85e18d8d520
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. TagRule: BARD
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:b3fcf5e5-780e-17f7-3c64-a85e18d8d520
msgctxt "h2071b0d5gd5bdg4549ga099gaae59645ee5c"
msgid ""
"I think I know him. That's Piltrid the Warbler, the worst bard in Faerûn."
msgstr "나 아는 사람 같은데. 꾀꼬리 필트리드야. 페이룬 사상 최악의 바드지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = bab158a5-59c6-4bb2-3cc1-97e3d78cf66e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:bab158a5-59c6-4bb2-3cc1-97e3d78cf66e
msgctxt "hdee5d620g8db7g4c4bgade1gf254c777b520"
msgid "I dunno. But it must be worth <i>sumfin'</i>."
msgstr "몰라. 아무튼 분명 <i>뭔가</i> 가치있겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Narrator
#. NodeID = bab89591-8ddc-5721-7fb8-df51519f9a75
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:bab89591-8ddc-5721-7fb8-df51519f9a75
msgctxt "h76d2eaeag0e6fg404bg932ag6fc34863dc7a"
msgid ""
"*The mark glows, but you feel nothing in response. Your illithid power is "
"beyond reach until you rest.*"
msgstr "*문양이 빛나지만, 어떤 반응도 느껴지지 않습니다. 일리시드 능력을 더 사용하려면 휴식을 취해야 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = babf958c-cbae-c3c1-ae81-b98d9494f428
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Absolute_Knows_GoblinsWorship = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:babf958c-cbae-c3c1-ae81-b98d9494f428
msgctxt "h55174fedg701eg4f49ga3f6g36e95c5f1639"
msgid ""
"Now he's supper. That's wot happens to people that mess with us now we've "
"got th'Absolute on our side."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = bd1f7602-8f05-c7ca-84a8-6700142f1705
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: !DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:bd1f7602-8f05-c7ca-84a8-6700142f1705
msgctxt "h18a17383g4963g44e4g97eeg18b6978d2c94"
msgid "Yer just jealous cuz you wished you looked this good."
msgstr "너도 이렇게 멋지게 보이고 싶어서 질투하는 거잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = bd1f7602-8f05-c7ca-84a8-6700142f1705
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:bd1f7602-8f05-c7ca-84a8-6700142f1705
msgctxt "hfb336113ga5c9g4103g8c20g4f9aa3a92898"
msgid "Really good pants though, ain't they? I thought so anyhow."
msgstr "그래도 정말 좋은 바지 아니야? 난 그런 줄 알았는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = c1b74e21-8835-41d7-66c3-f97d7712810e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_RoastingDwarf_Admired(1) = False
#.      - GOB_RoastingDwarf0_HasMet(1) = True
#.   Object:
#.      - GOB_RoastingDwarf_SoldPoem(1) = False
#.      - GOB_RoastingDwarf_GavePoem(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:c1b74e21-8835-41d7-66c3-f97d7712810e
msgctxt "h7f7633d0g0dd1g4ecbg8bebg1e177613fa16"
msgid "Somethin' about the moon... an' stars?"
msgstr "달이랑... 별이 뭐 어쨌다고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Narrator
#. NodeID = c26b56f2-3c86-de96-5362-449eb27d658e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:c26b56f2-3c86-de96-5362-449eb27d658e
msgctxt "hcc661174g63a0g47f7g963cg4d82e0350e96"
msgid "*A shiver runs across your mind... You feel sated.*"
msgstr "*전율이 불현듯 머릿속을 스쳐 지나가고... 만족감이 듭니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = c2b5dca2-15c7-e9f9-1672-5a340320505c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:c2b5dca2-15c7-e9f9-1672-5a340320505c
msgctxt "ha89cb0fdgfbf7g411dgb0cdg1ce198585c7a"
msgid "Shame he was as <i>poor</i> as a chicken."
msgstr "이놈이 닭만큼 <i>빈털터리</i>였던 건 아쉽지만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Player
#. NodeID = c73935fa-ae3f-35a1-3dd0-0a2499ad86ac
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:c73935fa-ae3f-35a1-3dd0-0a2499ad86ac
msgctxt "h6a6d94b1g5e00g4c33gbf2dg88a7c3570337"
msgid "The Absolute does not ask. Certainly not <i>twice.</i>"
msgstr "절대자께서는 부탁을 하시지 않는다. <i>두 번은 절대 아니지.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Narrator
#. NodeID = c93a7333-d499-904d-3801-6f8926474e4f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount4(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount4(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:c93a7333-d499-904d-3801-6f8926474e4f
msgctxt "hc26bc7d5gac69g4a41g89b7gae57ed54c29a"
msgid ""
"*A shadow swims across your vision, and a familiar voice tells you to be "
"calm. You are loved.*"
msgstr "*그림자가 낀 듯이 눈앞이 흐려지더니, 익숙한 목소리가 당신을 달래줍니다. 사랑이 느껴집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Player
#. NodeID = c95d7dc5-3cd1-386e-865e-4a40c6c4a020
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_RoastingDwarf_AdmiredPants(1) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_RoastingDwarf_InsultedPants(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:c95d7dc5-3cd1-386e-865e-4a40c6c4a020
msgctxt "heb190f98gd708g40e5gae35g46d684695e0a"
msgid "Tasty's not the word. Gruesome, maybe?"
msgstr "섹시해 보인다는 표현은 잘못된 것 같은데. 끔찍하다가 맞지 않을까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Player
#. NodeID = ca50d7f9-fa83-c629-1001-710a152e30e1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:ca50d7f9-fa83-c629-1001-710a152e30e1
msgctxt "hac9f1875g7bc2g455dg963dg78510505b162"
msgid "I'll just take the coin then."
msgstr "그럼 동전만 가져가지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = cb1ca0ef-c211-ddc7-3b55-638c340206a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:cb1ca0ef-c211-ddc7-3b55-638c340206a5
msgctxt "hc129e2dbgbba4g4c5cg8c5cge01ff5f469d2"
msgid "Not like that chunky dwarf I nicked 'em off."
msgstr "이 바지를 가져온 저 뚱뚱한 드워프랑은 다르게 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = d05695a3-fa28-82ee-3b60-2c449d0d55ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:d05695a3-fa28-82ee-3b60-2c449d0d55ad
msgctxt "h78fd6397ge91bg4ac0ga13bgd3f9cd1340c4"
msgid ""
"For all I know, this little roaster was some famous bard and you'll be "
"sellin' his last words for a pretty penny."
msgstr ""
"혹시 또 모르지, 이 통구이 자식이 원래 유명한 시인이었을 수도 있잖아. 네가 놈의 마지막 유언을 가져가서 비싸게 팔아치우는 꼴은 못 "
"보지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = d3d05ad3-150f-c65e-5f6a-f829804fbb2d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:d3d05ad3-150f-c65e-5f6a-f829804fbb2d
msgctxt "h6a218fd3gc973g45fbga36bge9432de12dc2"
msgid "Had a coupla coins in the pockets and some daft poem. But that's all."
msgstr "동전 주머니에 동전 몇 푼이랑 드워프 시 밖에 없었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = d83dfd3d-03a4-01c6-fa71-6e98496f7ef4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_RoastingDwarf0_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:d83dfd3d-03a4-01c6-fa71-6e98496f7ef4
msgctxt "had92c1a7g1c60g4014gb823gd46ac54c7a5e"
msgid "Get a good whiff of the meat - crackling up real nice, innit?"
msgstr "저 고기 냄새 좀 맡아 봐. 아주 지글지글 잘 구워졌지, 응?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = d8d0fef4-ee1e-bfe4-b850-cea04c050b8c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:d8d0fef4-ee1e-bfe4-b850-cea04c050b8c
msgctxt "h5868a1f7g9e44g4b23g8135g1a62dc5d151a"
msgid ""
"'Ow can you recognise 'im with his face burned off? You tryin' to kid me?"
msgstr "얼굴이 다 타버렸는데 어떻게 알아본다는 거야? 장난하냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = d8e026a5-c1cd-9b19-0d3b-852a5fc2e2ff
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_RoastingDwarf_GavePoem(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:d8e026a5-c1cd-9b19-0d3b-852a5fc2e2ff
msgctxt "h5b0e67e5ge372g488fg9c64gb5b1ae1562a5"
msgid "Get any joy out of the poem? Load of nonsense, innit?"
msgstr "시는 좀 즐겼나? 그냥 헛소리뿐이지, 그러치?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = de13a679-4059-d4e7-68c1-cc723a0a2007
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_SharTempleEntrance_GiveMap(1) = True
#.     - GOB_RoastingDwarf_GavePoem(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:de13a679-4059-d4e7-68c1-cc723a0a2007
msgctxt "hee0540aegf18cg46begaecage10f3bb8a797"
msgid "It's soft-stuff. Don't want nothin' to do with it."
msgstr "약골 놈들이나 좋아하는 거야. 난 건드리기도 싫다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Player
#. NodeID = e1792c06-0b8a-4b5d-4bc3-061eb1041b17
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:e1792c06-0b8a-4b5d-4bc3-061eb1041b17
msgctxt "h3746cd59gfa06g4edfg89dfgc8f03f7aae06"
msgid "They're just pants."
msgstr "그냥 바지일 뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = e46b23fe-02b7-ea66-62b9-61efa579f6df
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:e46b23fe-02b7-ea66-62b9-61efa579f6df
msgctxt "hd922f12ege581g4190g90b9g2c766e7d6eda"
msgid "I'll get back to tendin' the meat."
msgstr "돌아가서 고기나 지켜야겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = e4b83c2e-bcfd-1d67-c750-ed382ce39826
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: !DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:e4b83c2e-bcfd-1d67-c750-ed382ce39826
msgctxt "he69a521bg1ec2g4174g90a1g77a7806ae946"
msgid "You look smart. Reckon it's worth anything?"
msgstr "그쪽은 똑똑해 보이는데, 뭐라도 가치가 있을 것 같아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = e557414a-8a6a-ff30-d313-8675f8956070
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:e557414a-8a6a-ff30-d313-8675f8956070
msgctxt "h8f8ed43fgf028g4416gae76g34abb7f7b67e"
msgid ""
"I reckon you know this thing is worth a proper pile of loot. So you better "
"pay up."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = e5f3e467-9448-1454-c04b-164dcf4dd7da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:e5f3e467-9448-1454-c04b-164dcf4dd7da
msgctxt "h8ddd120dgd910g4179gb1f0g8dd1c43dcbee"
msgid ""
"I dunno. It rhymes an' everythin'. Reckon that's gotta be worth sumthin'."
msgstr "모르겠어. 운율이 척척 맞더라. 뭔가 가치가 있을 것 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Narrator
#. NodeID = e5fd9513-d90b-6b19-d058-c8c86fd85096
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount6(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount6(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:e5fd9513-d90b-6b19-d058-c8c86fd85096
msgctxt "h7159b343gbd0cg492fga640g5c2af68c59a4"
msgid ""
"*The presence deep in your mind is awake, unblinking. This is it. A single "
"word pervades your consciousness: 'Soon'.*"
msgstr ""
"*당신의 정신 속 깊이 자리잡은 존재가 태연스레 깨어납니다. 올 것이 왔군요. 한 단어가 당신의 의식 속으로 스며듭니다. ‘곧’*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = e7810061-c276-d1c2-4e26-7c359d7eef31
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_SharTempleEntrance_HasMap(0) = True
#. SetFlags:
#.   Object:
#.     - GOB_RoastingDwarf_SoldPoem(1) = True
#.     - GOB_SharTempleEntrance_GiveMap(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:e7810061-c276-d1c2-4e26-7c359d7eef31
msgctxt "h0e1529bagd9c5g4eb1g96e9g0734727294c6"
msgid "Right you are, boss. Hope you enjoy it."
msgstr "알아들었어, 대장. 네가 이걸 즐기길 바랄게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Player
#. NodeID = eabc6a69-8656-ff82-dabe-c2f1fa2d4b42
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 1ab4230e-d8f1-3e6f-5284-ec5113c27131_GOB_DwarfOperator_ReadMind = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:eabc6a69-8656-ff82-dabe-c2f1fa2d4b42
msgctxt "h6f828506g051cg48dega893gdc4686e07afe"
msgid "Ah, you're a secret poetry-lover. How cute."
msgstr "아, 비밀스럽게 시를 즐기고 있군. 귀여워라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = edac5dc8-0e99-1ddc-1207-d864bf691974
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:edac5dc8-0e99-1ddc-1207-d864bf691974
msgctxt "h6b4980e7g7fbfg4406gab1ega3ca8ae7f920"
msgid "What the hells are you doin'? Get out of my head!"
msgstr "이런 씨발, 뭐 하는 거야? 내 머릿속에서 나가!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Tracker Klagga
#. NodeID = eeffc8c4-dbdc-d0c7-b6a2-036d1b7e3adf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:eeffc8c4-dbdc-d0c7-b6a2-036d1b7e3adf
msgctxt "h653bb77egaa8ag424dg8531g3297271ac779"
msgid "Proper stylish, ain't they? Nicked 'em off this dwarf we're cookin'."
msgstr "멋지지, 안 그래? 우리가 요리하고 있는 저 드워프가 입고 있던 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Player
#. NodeID = ef1d9e0d-1ed4-3056-e8a6-666f069086f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:ef1d9e0d-1ed4-3056-e8a6-666f069086f4
msgctxt "hb13e0648g6dacg4b7fga281gce0f2271ec94"
msgid "What's your price?"
msgstr "얼마를 원해?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Narrator
#. NodeID = f22d062e-aaf6-1c32-031a-56155b0c5d16
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount3(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount3(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:f22d062e-aaf6-1c32-031a-56155b0c5d16
msgctxt "h12638d16g6852g4babg8ac9ga483b00f8e53"
msgid "*Your mind lurches, reeling suddenly as if... bitten.*"
msgstr "*뭔가에 깨물린 것처럼 느닷없이 정신이 휘청거립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000
#. Speaker = Player
#. NodeID = fdb5baeb-629f-7564-4dd4-ec00989468c8
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - DWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator000:fdb5baeb-629f-7564-4dd4-ec00989468c8
msgctxt "hd8d44dcbgf902g436eg845dge555b9b7648b"
msgid "He's one of my clan. Piltrid the Warbler, worst bard in Faerûn."
msgstr "내 클랜 사람이네. 꾀꼬리 필트리드, 페이룬 사상 최악의 바드지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001
#. Speaker = Tracker Grikka
#. NodeID = 09268109-67e8-9970-9e57-37a5b4032909
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_RoastingDwarf1_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001:09268109-67e8-9970-9e57-37a5b4032909
msgctxt "hfe74ea2fg53eeg46a2gb521g3c754a89ebeb"
msgid "Meat ain't ready yet - dwarves take an <i>age</i> to roast."
msgstr "고기가 아직 안 익었어. 드워프는 익히는데 <i>시간이</i> 오래 걸리지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001
#. Speaker = Player
#. NodeID = 1049cc30-998c-d339-bb0a-262a1c135397
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_IsMissing = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001:1049cc30-998c-d339-bb0a-262a1c135397
msgctxt "h51696af4gb229g4efcg91d6g8737684ccc08"
msgid "Who was with the dwarf?"
msgstr "그 드워프와 함께 있던 자는 누구였지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001
#. Speaker = Tracker Grikka
#. NodeID = 1aaee31f-17df-550f-7c5d-a3eb49b10bf6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - HUMAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001:1aaee31f-17df-550f-7c5d-a3eb49b10bf6
msgctxt "h427a87d2g0c31g42ddg830dg181684cc0a7d"
msgid ""
"Prefer human meat myself. Juicier. Yer makin' me salivate just standin' "
"there."
msgstr "난 인간 고기가 더 좋아. 더 육즙이 있거든. 네가 거기 있으니까 군침 돌게 하네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001
#. Speaker = Tracker Grikka
#. NodeID = 1f4d5bfc-9a62-19e5-5d82-e370ba2f20fe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DUERGARDWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001:1f4d5bfc-9a62-19e5-5d82-e370ba2f20fe
msgctxt "hf28fb5a9gbbc0g4fc3ga80cg9a76ec296a6d"
msgid ""
"Figured you'd enjoy it. Bet you wish you'd been 'ere to skewer the ugly "
"bastard."
msgstr "좋아할 줄 알았지. 분명 너도 그 못생긴 놈을 직접 꼬챙이에 꽂지 못해서 아쉬울 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001
#. Speaker = Player
#. NodeID = 24bf82db-d365-e16f-f744-dbc080367afe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001:24bf82db-d365-e16f-f744-dbc080367afe
msgctxt "h0fbd2bb0g1b24g4328g9713g14995efab15d"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001
#. Speaker = Tracker Grikka
#. NodeID = 26b884b3-88fe-be7d-d10d-cb99f8d0b439
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_GoblinToast_State_RealizedPoison = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001:26b884b3-88fe-be7d-d10d-cb99f8d0b439
msgctxt "h6dd51f12g7aabg43f7g8d32g3c3dc0f5cd88"
msgid "Get ready to fight or get out. Party's over."
msgstr "싸울 준비를 하거나 꺼져. 파티는 끝났어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001
#. Speaker = Tracker Grikka
#. NodeID = 2866d096-f91c-9138-6795-7dc19e038df2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001:2866d096-f91c-9138-6795-7dc19e038df2
msgctxt "h1552704dg770bg418bgb7fdg71e1de494f24"
msgid ""
"That's just how dwarves is. Probably shoulda shaved him before cookin' him."
msgstr "드워프가 원래 그렇지. 요리하기 전에 수염을 밀었어야 했는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001
#. Speaker = Tracker Grikka
#. NodeID = 3379c1c5-a0b2-dbad-a821-c2fe6d5a2077
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001:3379c1c5-a0b2-dbad-a821-c2fe6d5a2077
msgctxt "h7c7a7f51g99bdg4f88g9925gca87361cbd93"
msgid "An' if you don't watch yer tongue, I'll chuck that on the fire an' all."
msgstr "그리고 자꾸 그런 식으로 입조심 안 하면, 내가 그 혀도 불에다 던져버릴 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001
#. Speaker = Tracker Grikka
#. NodeID = 39add714-97fb-918e-67b7-154aaa97ce3a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001:39add714-97fb-918e-67b7-154aaa97ce3a
msgctxt "hd9d6f123g1111g4a27gbe90g16f1044927c5"
msgid "He's inside. Keep to the right... an' follow the screams."
msgstr "그는 안에 있어. 오른쪽으로 가봐... 그리고 비명소리를 따라가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001
#. Speaker = Tracker Grikka
#. NodeID = 578881a9-ca15-04cb-a51e-6b7d3b38bbbd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_RoastingDwarf1_DwarfCannibal(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001:578881a9-ca15-04cb-a51e-6b7d3b38bbbd
msgctxt "ha49a1b3dg2320g4609g8e7cg2e5613d1e3d8"
msgid ""
"Tha's the spirit! I ate goblin once. Me brother. Wouldn't recommend it. All "
"grease and gristle."
msgstr "바로 그 정신이야! 나도 고블린을 먹은 적이 있어. 내 형제였지. 추천하고 싶진 않아. 기름기 투성이에 질겼어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001
#. Speaker = Player
#. NodeID = 5a6344aa-990c-5977-f756-218e3968e7da
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_RoastingDwarf1_DwarfCannibal(1) = False
#.   Tag:
#.      - DWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001:5a6344aa-990c-5977-f756-218e3968e7da
msgctxt "h2633b69dg6517g4f54gbd4dg44e0cdc700f3"
msgid "Step away from the pit. Now."
msgstr "거기서 손 떼. 당장."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001
#. Speaker = Tracker Grikka
#. NodeID = 658e75e8-bab5-7164-e752-72ef87f90670
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DUERGARDWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001:658e75e8-bab5-7164-e752-72ef87f90670
msgctxt "h64f291e5g5de7g46e6g9d6ag0428ce46bc85"
msgid "Yer not allergic to dwarf-flesh or anything, are ya?"
msgstr "드워프 고기에 알레르기 같은 건 없지, 안 그래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001
#. Speaker = Player
#. NodeID = 6d69ea49-080f-ee75-154f-08444a1673e4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001:6d69ea49-080f-ee75-154f-08444a1673e4
msgctxt "h39db592ege50dg4f1bga882gef029365857a"
msgid "That's disgusting. He smells awful."
msgstr "역겹군. 냄새가 지독해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001
#. Speaker = Player
#. NodeID = 7c1c47db-c140-7c34-0f74-686c1f324224
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_DwarfOperator_ToldAboutDwarf = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001:7c1c47db-c140-7c34-0f74-686c1f324224
msgctxt "h8b74f6fcg1621g45f1gbf54ge292db180b2a"
msgid "Where did you find a dwarf?"
msgstr "드워프는 어디서 찾았지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001
#. Speaker = Tracker Grikka
#. NodeID = 7c33c3b9-6283-3d19-f163-46211b480821
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001:7c33c3b9-6283-3d19-f163-46211b480821
msgctxt "h7c1d847cg08f0g4ab5gbc56gae3396fee6f0"
msgid "We'll beat the fight out of it, and make it one of our own."
msgstr "일단 그놈을 좀 때려서 반항기를 죽여놓고, 앞으로 우리가 대신 부릴 생각이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001
#. Speaker = Player
#. NodeID = 7d0c0caf-f8be-d1d0-d479-51955405dfb8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001:7d0c0caf-f8be-d1d0-d479-51955405dfb8
msgctxt "heb3b7203g092bg43edg9f79g24c3be12eb06"
msgid "Save me a piece."
msgstr "한 입만 줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001
#. Speaker = Tracker Grikka
#. NodeID = 7d73ba90-58cb-af98-5dd2-87be23736dc2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DROWELF(1) = True
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001:7d73ba90-58cb-af98-5dd2-87be23736dc2
msgctxt "hbcdfbd08ga579g48a8gad3dgefea401c1d77"
msgid ""
"Thanks, ma'am. He'll probably spill his guts as soon as he claps eyes on ya!"
msgstr "감사합니다, 마님. 그가 당신을 보자마자 내장을 쏟아 낼겁니다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001
#. Speaker = Tracker Grikka
#. NodeID = 7d73ba90-58cb-af98-5dd2-87be23736dc2
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DROWELF(1) = True
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001:7d73ba90-58cb-af98-5dd2-87be23736dc2
msgctxt "hef505ac7g6dd9g4105g9d9egeb4d59f27ac4"
msgid ""
"Thanks, sir. He'll probably spill his guts as soon as he claps eyes on ya!"
msgstr "감사합니다, 나리. 그가 당신을 보자마자 내장을 쏟아 낼겁니다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001
#. Speaker = Tracker Grikka
#. NodeID = 7d73ba90-58cb-af98-5dd2-87be23736dc2
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001:7d73ba90-58cb-af98-5dd2-87be23736dc2
msgctxt "h22b43fefgcf3cg47c8g8217gab5edb75f023"
msgid ""
"Thanks, True Soul. He'll probably spill his guts as soon as he claps eyes on "
"ya!"
msgstr "감사합니다, 참된 영혼. 그가 당신을 보자마자 내장을 쏟아 낼겁니다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001
#. Speaker = Tracker Grikka
#. NodeID = 7f888da2-38cf-ff21-80b8-38399138d19e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001:7f888da2-38cf-ff21-80b8-38399138d19e
msgctxt "h4747a474g201bg4419gbcf2ga094ae32ee5c"
msgid ""
"What you <i>really</i> want is a good bit of human meat, with all the "
"trimmings."
msgstr "<i>진짜로</i> 먹어야 하는 건 질 좋은 인간 고기야. 잘 손질된 걸로."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001
#. Speaker = Tracker Grikka
#. NodeID = 7fed6fd0-0816-a38c-420c-e494a9e0ef2b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001:7fed6fd0-0816-a38c-420c-e494a9e0ef2b
msgctxt "h68372848gc3b9g49d9g99f3g03e03b7d3bde"
msgid "Ah, bugger off wiv yer attitude. He 'ad it comin' to 'im."
msgstr "에이, 괜히 지랄하지 말라고. 죽어도 싼 놈이었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001
#. Speaker = Tracker Grikka
#. NodeID = 8b7c24d7-9456-a45e-3b8c-02a6bf9fa017
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001:8b7c24d7-9456-a45e-3b8c-02a6bf9fa017
msgctxt "h32a02650g8e98g4046gaf2dg530c715fdf47"
msgid "Lads have got 'im inside for <i>questionin'</i>. Heh-heh-heh."
msgstr "우리 애들이 안에서 그놈한테 <i>질문</i> 중이지. 헤헤헤."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001
#. Speaker = Player
#. NodeID = 8cde1381-efbc-f9e8-881e-ead099c40ff5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001:8cde1381-efbc-f9e8-881e-ead099c40ff5
msgctxt "hf3cdc15egd350g4f32gbc0cg1d300467d1fa"
msgid "Smells delicious. Reminds me of my childhood."
msgstr "맛있는 냄새가 나는군. 어릴 적 생각나네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001
#. Speaker = Tracker Grikka
#. NodeID = 8ea6c6d1-8b27-c926-b070-343e99160882
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DWARF(1) = True
#. SetFlags:
#.   Dialog:
#.     - GOB_RoastingDwarf1_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001:8ea6c6d1-8b27-c926-b070-343e99160882
msgctxt "hc4f2b63dga6f4g4cf1gb312g4da30692e5b2"
msgid ""
"You peckish? Didn't figure dwarves for cannibals, but yer welcome to 'ave a "
"bite when he's done."
msgstr "배고프냐? 드워프가 식인종인 줄은 몰랐지만, 그가 준비되면 한 입 먹어도 돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001
#. Speaker = Tracker Grikka
#. NodeID = 93811c18-bc4f-d63f-4184-e73c95c4900f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001:93811c18-bc4f-d63f-4184-e73c95c4900f
msgctxt "hf3271333geabcg4590g80d4g2da672c7daeb"
msgid ""
"Nah. Druids are all beardy and woodsy, ain't they? This lot were a scabby "
"gang of tomb-robbers."
msgstr "아니야. 드루이드는 다 수염 기르고 숲에서 사는 거잖아, 안그래? 이 놈들은 더러운 도굴꾼 무리들이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001
#. Speaker = Tracker Grikka
#. NodeID = 975c7912-a244-4c74-6d84-3c6c3a955296
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_RoastingDwarf1_HasMet(1) = True
#.   Tag:
#.      - DROWELF(1) = True
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001:975c7912-a244-4c74-6d84-3c6c3a955296
msgctxt "h67d221e0gad4cg436dgbc84g1a9d8d0c2682"
msgid "'Scuse me, ma'am - gotta concentrate on the meat."
msgstr "실례합니다, 마님. 고기에 집중해야 해서요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001
#. Speaker = Tracker Grikka
#. NodeID = 975c7912-a244-4c74-6d84-3c6c3a955296
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_RoastingDwarf1_HasMet(1) = True
#.   Tag:
#.      - DROWELF(1) = True
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001:975c7912-a244-4c74-6d84-3c6c3a955296
msgctxt "h39b00c39g858bg4203g97e8gc2dd4ca18e5a"
msgid "'Scuse me, sir - gotta concentrate on the meat."
msgstr "실례합니다, 나리. 고기에 집중해야 해서요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001
#. Speaker = Tracker Grikka
#. NodeID = 975c7912-a244-4c74-6d84-3c6c3a955296
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_RoastingDwarf1_HasMet(1) = True
#.   Tag:
#.      - DROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001:975c7912-a244-4c74-6d84-3c6c3a955296
msgctxt "h0ffc3a66g846bg4440gaf87gec2e5321e9a3"
msgid "'Scuse me, True Soul - gotta concentrate on the meat."
msgstr "실례합니다, 참된 영혼이시여. 고기를 굽는 데 집중해야 합니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001
#. Speaker = Player
#. NodeID = a7c8bc0e-7833-b39c-2e56-0bc83e3f7d1f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001:a7c8bc0e-7833-b39c-2e56-0bc83e3f7d1f
msgctxt "h730546f6g5d6dg4856gbb3dg985bf3a827fa"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001
#. Speaker = Tracker Grikka
#. NodeID = a9e3140c-2458-f6b0-2a36-1a24579a754e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001:a9e3140c-2458-f6b0-2a36-1a24579a754e
msgctxt "h42eb85d9g5eadg4879g8a48g4159b85527a4"
msgid "Enjoy pokin' holes in people do ya?"
msgstr "사람 몸에 구멍 뚫는 거 좋아하나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001
#. Speaker = Player
#. NodeID = acecc1ec-c40b-2105-a475-be4709249073
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_IsFound = False
#.      - GLO_Halsin_Knows_IsMissing = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001:acecc1ec-c40b-2105-a475-be4709249073
msgctxt "hecab0faege98cg46d8gba71g285beca0d810"
msgid "Was one of his 'mates' a druid?"
msgstr "그의 '동료' 중 한 명이 드루이드였나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001
#. Speaker = Tracker Grikka
#. NodeID = adaa6a71-ab15-907c-5223-614dc0b9d740
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001:adaa6a71-ab15-907c-5223-614dc0b9d740
msgctxt "hd1a73e79gdc2dg4a27g97b8gc0c7b5ef4678"
msgid ""
"Some managed to scarper, but the rest are all carved up... or wishin' they "
"was."
msgstr "몇 명은 도망쳤지만, 나머지는 모두 썰렸어... 그렇게 됐기를 바라는 놈도 있고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001
#. Speaker = Tracker Grikka
#. NodeID = af11992b-bd31-0ab1-45c8-7fc08fc72e8c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001:af11992b-bd31-0ab1-45c8-7fc08fc72e8c
msgctxt "he6d18c74gef94g490fg9965gccfcc690fda3"
msgid "Lads inside are tryin' to get answers out of one of his mates."
msgstr "안에 있는 친구들이 그의 동료들 중 한 명에게 대답을 얻으려고 애쓰고 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001
#. Speaker = Tracker Grikka
#. NodeID = b2a9dd84-dc12-d0d4-2459-08e880261a75
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001:b2a9dd84-dc12-d0d4-2459-08e880261a75
msgctxt "h480b1a46g8f26g4738gad2dga0e158bbfa97"
msgid "He found us! Dunno wot he was doin' 'ere or where he came from."
msgstr "그가 우릴 찾았어! 여기서 뭘 하고 있었는지, 어디서 왔는지는 모르겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001
#. Speaker = Tracker Grikka
#. NodeID = bae4c76f-1772-48d5-18c6-da85a960d2f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001:bae4c76f-1772-48d5-18c6-da85a960d2f1
msgctxt "h98ba1a23gd3fcg4e28ga74egebb4c4d1f9a4"
msgid ""
"One of this fella's mates woz a tasty-lookin' morsel, but he ain't ready for "
"the spit yet."
msgstr "이 친구의 동료들 중 한 명은 맛있어 보였는데, 아직 꼬치로 만들 준비가 안 됐어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001
#. Speaker = Player
#. NodeID = c22a7fd2-a587-13bd-d0df-91d036f6b9f9
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: BESTIAL
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001:c22a7fd2-a587-13bd-d0df-91d036f6b9f9
msgctxt "h2d690896g4377g4fa9g8ab5g8ffe3f29bdc8"
msgid ""
"I'll handle the prisoner - when I ask questions, people tend to answer. "
"Quickly."
msgstr "내가 그 죄수를 처리할게. 내가 질문을 하면, 사람들은 대답하는 경향이 있어. 빠르게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001
#. Speaker = Player
#. NodeID = c22a7fd2-a587-13bd-d0df-91d036f6b9f9
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001:c22a7fd2-a587-13bd-d0df-91d036f6b9f9
msgctxt "he069a7d3g8dd0g4414g8a5fg77198cda18b3"
msgid "I can get you answers. Where's the prisoner?"
msgstr "내가 답을 얻어 낼 수 있어. 그 죄수는 어딨지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001
#. Speaker = Tracker Grikka
#. NodeID = ca623990-9cd9-de31-8242-efca07e67ccb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DUERGARDWARF(1) = True
#. SetFlags:
#.   Dialog:
#.     - GOB_RoastingDwarf1_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001:ca623990-9cd9-de31-8242-efca07e67ccb
msgctxt "hda8613a5g508dg47c3g8437g748e0e5ae232"
msgid "D'ya fancy a hunk of dwarf meat, under-dweller? He ain't ready yet."
msgstr "드워프 고기 한 덩어리는 어때, 언더다크 형씨? 그는 아직 준비 덜 됐어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001
#. Speaker = Tracker Grikka
#. NodeID = ca8156a6-c06a-44bf-9ab3-d1734ccc4e17
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_RoastingDwarf1_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001:ca8156a6-c06a-44bf-9ab3-d1734ccc4e17
msgctxt "h2e7a5aacgae92g446fgac9eg5cea676e5525"
msgid "Buzz off - gotta concentrate on the meat."
msgstr "꺼져. 고기를 굽는 데 집중해야 한다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001
#. Speaker = Tracker Grikka
#. NodeID = ce6f5030-0872-ee1b-2447-346b1fce39f3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DROWELF(1) = True
#. SetFlags:
#.   Dialog:
#.     - GOB_RoastingDwarf1_HasMet(1) = True
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001:ce6f5030-0872-ee1b-2447-346b1fce39f3
msgctxt "hebc766b8g636bg4a70g8dceg0c432c79eda2"
msgid ""
"Sorry, ma'am. Meat ain't ready yet - dwarves take an <i>age</i> to roast."
msgstr "죄송합니다, 마님. 고기는 아직 준비가 안 됐습니다. 드워프는 굽는데 <i>시간이</i> 오래 걸리거든요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001
#. Speaker = Tracker Grikka
#. NodeID = ce6f5030-0872-ee1b-2447-346b1fce39f3
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DROWELF(1) = True
#. SetFlags:
#.   Dialog:
#.     - GOB_RoastingDwarf1_HasMet(1) = True
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001:ce6f5030-0872-ee1b-2447-346b1fce39f3
msgctxt "h75a33d6bgb3a4g4aaag8285gf0928c84ac69"
msgid "Sorry, sir. Meat ain't ready yet - dwarves take an <i>age</i> to roast."
msgstr "죄송합니다, 나리. 고기는 아직 준비가 안 됐습니다. 드워프는 굽는데 <i>시간이</i> 오래 걸리거든요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001
#. Speaker = Tracker Grikka
#. NodeID = ce6f5030-0872-ee1b-2447-346b1fce39f3
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DROWELF(1) = True
#. SetFlags:
#.   Dialog:
#.     - GOB_RoastingDwarf1_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001:ce6f5030-0872-ee1b-2447-346b1fce39f3
msgctxt "ha166cda5g7f0eg496dgad19gef3e867ee402"
msgid ""
"Sorry, True Soul. Meat ain't ready yet - dwarves take an <i>age</i> to roast."
msgstr "죄송합니다, 참된 영혼이시여. 고기는 아직 준비가 안 됐습니다. 드워프는 굽는데 <i>시간이</i> 오래 걸리거든요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001
#. Speaker = Tracker Grikka
#. NodeID = d3474590-af63-0636-14d4-6cde699abadb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001:d3474590-af63-0636-14d4-6cde699abadb
msgctxt "h8072705cg0b0eg4401g88a1g071b2c57880b"
msgid "Prefer human meat myself. Juicier."
msgstr "난 인간고기가 더 좋아. 더 육즙이 있거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001
#. Speaker = Tracker Grikka
#. NodeID = dd2e5d07-5d25-cb2d-1ce9-6298cad4b0a1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001:dd2e5d07-5d25-cb2d-1ce9-6298cad4b0a1
msgctxt "h5c633130gfc05g44d5g90d7g64488d39557b"
msgid ""
"One of his mates woz a tasty-lookin' long pig - but he ain't ready for the "
"spit yet."
msgstr "놈의 동료들 중 한 명은 맛있어 보이는 인육이었는데, 아직 꼬치로 만들 준비가 안 됐어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001
#. Speaker = Tracker Grikka
#. NodeID = e4ca5d6e-27f0-5431-cb41-e0bcb4a2ba2c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001:e4ca5d6e-27f0-5431-cb41-e0bcb4a2ba2c
msgctxt "ha4a943c6gcdaeg49a7gb10bg52bc7b766e8c"
msgid ""
"Scabby gang of tomb-robbers sniffin' around for loot. We put the fear of the "
"Absolute in 'em."
msgstr "보물 찾아 돌아다니는 더러운 도굴꾼 무리. 우리가 놈들에게 절대자의 공포를 심어주었지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001
#. Speaker = Tracker Grikka
#. NodeID = e73d1f95-3e82-356f-9cf8-5a91f740f6d3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_RoastingDwarf_Quest_MeatStolen = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001:e73d1f95-3e82-356f-9cf8-5a91f740f6d3
msgctxt "hf3d26a0dg8807g4180ga689gbb15f43da2cd"
msgid "That dwarf was still half-raw. Who ate it?"
msgstr "그 드워프는 아직 덜 익었어. 누가 먹었지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001
#. Speaker = Tracker Grikka
#. NodeID = fa3ed701-c63b-894e-0e56-5bde8a4988fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_DwarfOperator001:fa3ed701-c63b-894e-0e56-5bde8a4988fe
msgctxt "h4df4d5b5gaee4g4615g8cecg206a57514f46"
msgid ""
"Had a big ol' warbear with 'em, though. Took five of our meanest lashers to "
"chain it up."
msgstr "커다란 곰을 데리고 같이 싸우긴 했지. 우리 채찍꾼 중에서도 드센 놈들이 다섯 명이나 덤벼서 겨우 잡아 묶었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Goblin000
#. Speaker = Devout Mezzka
#. NodeID = 14db6515-cc4f-850e-c36e-d9fab917f04e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_ChickenChase_State_PlayedOnce = False
#.   Tag:
#.      - DROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Goblin000:14db6515-cc4f-850e-c36e-d9fab917f04e
msgctxt "ha9739153g390cg480cg8bf8g4d4183a450b5"
msgid "Wanna play, yer honour? Krolla will get you started."
msgstr "게임을 하고 싶으신가요, 손님? 크롤라가 가이드 해줄겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Goblin000
#. Speaker = Devout Mezzka
#. NodeID = 2bf0e415-d3ae-ed62-d013-33924ee1aee1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Goblin000:2bf0e415-d3ae-ed62-d013-33924ee1aee1
msgctxt "h50cc1ae9g631eg45f6g9aebgdd2fd387a808"
msgid "You hungry? The dwarf's gettin' good an' crispy."
msgstr "배고파? 드워프가 맛있고 바삭하게 익고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Goblin000
#. Speaker = Devout Mezzka
#. NodeID = 53f1e75c-321f-b146-066d-793985e03741
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_GoblinToast_State_RealizedPoison = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Goblin000:53f1e75c-321f-b146-066d-793985e03741
msgctxt "h990294c0gb55fg48a3g8771gd3aee198977b"
msgid "You feelin' all right? That ale was rotten."
msgstr "기분 괜찮아? 저 에일은 썩었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Goblin000
#. Speaker = Devout Mezzka
#. NodeID = 9cb0f38b-a1c7-0413-1e1f-931da9d15459
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_ChickenChase_State_PlayingChase = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Goblin000:9cb0f38b-a1c7-0413-1e1f-931da9d15459
msgctxt "he6b2957bg3139g433eg8628g63a8d61f2cd2"
msgid "I ain't playin'. Got knifed at the inn; wound ain't scabbed over yet."
msgstr "난 안할 거야. 여관에서 칼에 찔렸어; 상처가 아직 아물지 않았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Goblin000
#. Speaker = Devout Mezzka
#. NodeID = cf977852-fd98-b443-c7d9-474b4328f38d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_ChickenChase_State_PlayedOnce = False
#.   Tag:
#.      - DROWELF(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Goblin000:cf977852-fd98-b443-c7d9-474b4328f38d
msgctxt "h52fa2a93g45fcg4c5bga493g6e640a80bcdd"
msgid "If you fancy playin', talk to Krolla."
msgstr "게임을 하고 싶으면 크롤라에게 말해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Goblin001
#. Speaker = Warrior Sul
#. NodeID = 4f4be89c-8358-8f33-9739-bdf29503fa55
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Festivities_Goblin001_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_Festivities_Goblin001_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Goblin001:4f4be89c-8358-8f33-9739-bdf29503fa55
msgctxt "h0add4820gd9b9g4a68g8898g8154d1d07bb6"
msgid "This ale tastes like hobgoblin spit. Who's been pukin' in the barrel?"
msgstr "이 에일은 홉고블린 침 맛이 나는군. 누가 술통에 토한 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Goblin001
#. Speaker = Warrior Sul
#. NodeID = c37ac953-017c-c172-8c06-98a1ce841a08
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Festivities_Goblin001_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Goblin001:c37ac953-017c-c172-8c06-98a1ce841a08
msgctxt "h9ae601d1gf382g4510ga727g7fb8a46b35b0"
msgid "Oi. Watch you don't spill my beer, or I'll cut ya."
msgstr "야. 맥주 쏟지 않게 조심해. 안 그럼 널 갈라버릴 테니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Goblin001
#. Speaker = Warrior Sul
#. NodeID = ea574425-416b-b22b-a7ca-0de89559a022
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_GoblinToast_State_RealizedPoison = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Goblin001:ea574425-416b-b22b-a7ca-0de89559a022
msgctxt "haaa382fegae1cg4dcegbd76g11157b833a75"
msgid "Party's over, mate. Somethin's wrong with the booze."
msgstr "파티는 끝났어, 친구. 뭔가 술에 문제가 있는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Goblin002
#. Speaker = Tracker Tak
#. NodeID = 1920ce41-2356-dfa5-409b-66d115b5904c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Goblin002:1920ce41-2356-dfa5-409b-66d115b5904c
msgctxt "h9bea9cddg7bbfg4d6bg9481gdca7f95d00a7"
msgid "Where the 'ell do you get yours? From an <i>inn</i>, numpty."
msgstr "넌 술을 어디서 마시는데? <i>여관</i>에서 가져왔지, 멍청아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Goblin002
#. Speaker = Player
#. NodeID = 1f0c68f2-1fa7-4fd8-8c40-43f9981e5d13
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Goblin002:1f0c68f2-1fa7-4fd8-8c40-43f9981e5d13
msgctxt "hddf4a19ag8135g49a7g9269g0b91ff91a863"
msgid "Is it? Looks like swill to me."
msgstr "그래? 내 눈엔 구정물 같은걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Goblin002
#. Speaker = Tracker Tak
#. NodeID = 275ec639-5804-ae9f-c2f7-328aa6911579
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Goblin002:275ec639-5804-ae9f-c2f7-328aa6911579
msgctxt "h33ceabdeg6161g40a1g8fcfg0a722e269def"
msgid "'Course, sweet piss is still piss. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Goblin002
#. Speaker = Tracker Tak
#. NodeID = 3f472c1b-b9bb-5b2a-060f-7b1ad0172687
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_GoblinToast_State_RealizedPoison = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Goblin002:3f472c1b-b9bb-5b2a-060f-7b1ad0172687
msgctxt "h68e8310bg1d7bg4c7ag8a70ge8a6080e36e3"
msgid "Watch yerself - there's somethin' rotten in the booze. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Goblin002
#. Speaker = Tracker Tak
#. NodeID = 43f0ea40-5c5b-07fe-eb61-2ca7c1a43b7f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Goblin002:43f0ea40-5c5b-07fe-eb61-2ca7c1a43b7f
msgctxt "hc0584b1dg1fb9g44a5g8f5fg36c13b597500"
msgid "I swear, I got more dizzy from the smoke when we burned the place down."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Goblin002
#. Speaker = Player
#. NodeID = 4956b024-9adb-967f-935a-5832c2eb5531
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Goblin002:4956b024-9adb-967f-935a-5832c2eb5531
msgctxt "h226dc15dg1a32g4911g9c00gd32ffb82b87f"
msgid "I'd rather drink drider-venom."
msgstr "차라리 드라이더 독을 마시겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Goblin002
#. Speaker = Tracker Tak
#. NodeID = 63230cbb-f15f-2729-0b07-f3e818c467a2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Goblin002:63230cbb-f15f-2729-0b07-f3e818c467a2
msgctxt "h8f2cec49g6e16g448fg9d39g586428507bae"
msgid "That some fancy elf brew, is it? Never know, might 'ave it."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Goblin002
#. Speaker = Tracker Tak
#. NodeID = 69412584-8d5b-c1fc-81a4-a202e2bbab75
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Festivities_Goblin002_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Goblin002:69412584-8d5b-c1fc-81a4-a202e2bbab75
msgctxt "h1ddb7a47g9fc6g41edg8a95g4919b0da29ab"
msgid "Pish. Pure <i>pish</i>. N'ain't even <i>drunk</i>, see?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Goblin002
#. Speaker = Tracker Tak
#. NodeID = 6a38359d-8467-e6b4-91d0-d193ccca730d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Goblin002:6a38359d-8467-e6b4-91d0-d193ccca730d
msgctxt "h9250f00eg1d38g4ca5ga286ge3238f493b79"
msgid "Aye, but can't expect proper stuff from them fancy inns, can ya?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Goblin002
#. Speaker = Player
#. NodeID = 900110a2-1505-3ad5-fef4-d5275b95fd66
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Goblin002:900110a2-1505-3ad5-fef4-d5275b95fd66
msgctxt "h7bd86fadg5c45g4b15g9c40gc7d5d48c1ea1"
msgid "Indeed."
msgstr "확실히 그래."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Goblin002
#. Speaker = Tracker Tak
#. NodeID = 9d1317e1-c4d4-943a-5fb7-7d4f0953bbc8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Goblin002:9d1317e1-c4d4-943a-5fb7-7d4f0953bbc8
msgctxt "h3854eacbg3ce8g4f75gb4adgf98a887b5f9e"
msgid ""
"That inn was askin' for a burnin', sellin' this muck. Ain't even "
"<i>chewy</i>."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Goblin002
#. Speaker = Tracker Tak
#. NodeID = aa43a44c-e7aa-b70e-f956-b8455a1aae07
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Goblin002:aa43a44c-e7aa-b70e-f956-b8455a1aae07
msgctxt "h4928ea54g8002g43deg8f8fg4223d8c66107"
msgid "We lifted all sorts from that inn afore we burned it."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Goblin002
#. Speaker = Player
#. NodeID = b69723ca-528a-a665-4cdf-5c553e88eadc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Goblin002:b69723ca-528a-a665-4cdf-5c553e88eadc
#, fuzzy
msgctxt "hd54b4ea8ga28eg408bg9f7ag650b05c434ea"
msgid "Free? Where did you get it all?"
msgstr "이게 다 공짜라고? 다 어디서 난 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Goblin002
#. Speaker = Tracker Tak
#. NodeID = d2f473aa-9afe-eda4-24e7-dd18b8c97375
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_Festivities_Goblin002_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Goblin002:d2f473aa-9afe-eda4-24e7-dd18b8c97375
msgctxt "hdcb9b640g01dfg4cffgae4fge3f345e10492"
msgid "'Avin' a drink? 'S all the sweeter when it's free, innit?"
msgstr "술 마시는고야? 공짜니까 더 맛있지 않아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Goblin002
#. Speaker = Tracker Tak
#. NodeID = d858370d-2f85-e9e0-8d29-80f6887c8375
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Goblin002:d858370d-2f85-e9e0-8d29-80f6887c8375
msgctxt "h1cb46f90g08bag4632g8567gcc3ad75b9c37"
msgid ""
"'Course you won't find much there now. Took all the good stuff afore we "
"burned it."
msgstr "물론 이제 별로 남은 건 없어. 쓸만한 건 모조리 태워버렸으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Goblin003
#. Speaker = Brawler Rot
#. NodeID = 310729c8-94d1-6d98-4a57-f8e035d809a5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_ChickenChase_State_OwlbearReplacedChicken = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Goblin003:310729c8-94d1-6d98-4a57-f8e035d809a5
msgctxt "h7426d54fg9cebg4c40g9518g15353c63cd89"
msgid "Wass holdin' up the game? Chicken ain't dead is it?"
msgstr ""

