msgctxt "h2beace92g6c8fg4eedga821g0cfaed0a4fb1"
msgid "What happened to you?"
msgstr "무슨 일이 있었지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_HangedDrow_Dead
#. Speaker = Executed Drow
#. NodeID = bf683da0-0007-510d-ceb8-4de99db20e08
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_HangedDrow_Dead:bf683da0-0007-510d-ceb8-4de99db20e08
msgctxt "hb46c1d4eg404cg4ab3ga6f2g60935df99b4a"
msgid "Cultists... threat to Baldur's Gate... Jaheira's orders..."
msgstr "발더스 게이트에 위협이 되는... 광신도들을... 자헤이라의 명령으로..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_HangedDrow_Dead
#. Speaker = Shadowheart
#. NodeID = c1bfca95-9460-4461-b5ca-f97893ad902a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
