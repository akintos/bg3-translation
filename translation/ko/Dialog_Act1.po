msgctxt "hdd23927bg7317g4f4cg8939gb820abb0b018"
msgid "How did you come here?"
msgstr "어떻게 여길 오게 된 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_UnfortunateGnome_Dead
