msgctxt "h1feb8132g95c8g40c4g8d86g5111476b642f"
msgid "Gone. Seeking more pawns for her head games, no doubt."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_PAD_Fled
#. Speaker = Player
#. NodeID = 4a216a17-743c-7b91-3009-705fb384d184
