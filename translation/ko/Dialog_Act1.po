msgctxt "hfd5bce11g457ag407bg9186g7b7db76c1d3b"
msgid "Something I can help you with?"
msgstr "제가 도와드릴 것이라도 있습니까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03
#. Speaker = Player
#. NodeID = f94f03ad-a2e8-3a1c-acd5-f52eb11c59d1
#. HandlePath = TaggedText[0].TagText[0]
