msgctxt "hd0bf5caagccfcg4d3eg81bbg51b0e2d79de1"
msgid "Let them come..."
msgstr "꼬이게 둬..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_DeadPrisoner_Dead
#. Speaker = Abducted Nobleman
#. NodeID = 3ac6acef-3335-73f4-8ffd-856ace92d916
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_DeadPrisoner_Dead:3ac6acef-3335-73f4-8ffd-856ace92d916
msgctxt "h0eca71cegbf0eg48edg87e1g06ff14a586a1"
msgid "They took me... took everything..."
msgstr "난 납치됐어... 다 빼앗겼다고..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_DeadPrisoner_Dead
#. Speaker = Abducted Nobleman
#. NodeID = 3f96925e-6af2-42e3-4bb0-46c5443c569e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRA_DeadPrisoner_Dead_MentionedTadpole(1) = False
#. SetFlags:
#.   Dialog:
#.     - CRA_DeadPrisoner_Dead_MentionedTadpole(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_DeadPrisoner_Dead:3f96925e-6af2-42e3-4bb0-46c5443c569e
msgctxt "h4bf2bbfag52ffg41d7gb0c7g6d39518eb663"
msgid "Took me here... put something in my eye..."
msgstr "이 배에 끌려왔지... 내 눈에 뭘 넣었어..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_DeadPrisoner_Dead
#. Speaker = Abducted Nobleman
#. NodeID = 504194c4-7a3f-039d-2f37-6253c5cd847e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_DeadPrisoner_Dead:504194c4-7a3f-039d-2f37-6253c5cd847e
msgctxt "hc400f132gf2f8g4cfdg8ea4gd853f496fcb6"
msgid "...or die... it'll leave..."
msgstr "...아님 죽든가... 그럼 빠지겠지..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_DeadPrisoner_Dead
#. Speaker = Player
#. NodeID = 8447086c-b6c2-f839-5142-7e43ae116e15
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRA_DeadPrisoner_Dead_MentionedTadpole(1) = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_DeadPrisoner_Dead:8447086c-b6c2-f839-5142-7e43ae116e15
msgctxt "ha23cfc1cgf804g448dgb690g4179e10907f9"
msgid "They put something in my eye too. Can we get rid of it?"
msgstr "녀석들이 내 눈에도 뭘 넣었거든. 없앨 수 있을까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_DeadPrisoner_Dead
#. Speaker = Abducted Nobleman
#. NodeID = 97e86ef5-e6f9-b0b6-631f-c0805a4e1c4d
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_EVIL or PALADIN_EVIL
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_DeadPrisoner_Dead:97e86ef5-e6f9-b0b6-631f-c0805a4e1c4d
msgctxt "h6459f45bgbabbg43a6gaee3g14b162e1a8d7"
msgid "Not from your cursed god..."
msgstr "네 망할 신의 의식 따윈 필요 없어..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_DeadPrisoner_Dead
#. Speaker = Abducted Nobleman
#. NodeID = 97e86ef5-e6f9-b0b6-631f-c0805a4e1c4d
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_DeadPrisoner_Dead:97e86ef5-e6f9-b0b6-631f-c0805a4e1c4d
msgctxt "h8d3dab08g6f34g42f3g950ag6eb0a9111080"
msgid "Too late now..."
msgstr "너무 늦었어..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_DeadPrisoner_Dead
#. Speaker = Player
#. NodeID = 9b9bad78-23b8-27af-b57d-a39c95cdcdda
#. HandlePath = TaggedText[0].TagText[0]
