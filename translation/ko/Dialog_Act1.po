#.      - 2fb4a271-d5f8-fce1-b64e-a7ba0a3e0830_A = False
#.      - 2fb4a271-d5f8-fce1-b64e-a7ba0a3e0830_B = False
#. SetFlags:
#.   Local:
#.     - 2fb4a271-d5f8-fce1-b64e-a7ba0a3e0830_A = True
#.     - 2fb4a271-d5f8-fce1-b64e-a7ba0a3e0830_B = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD:6dd5237c-45f2-9716-44b7-42cdd03db5c2
msgctxt "he10a395ag2953g4e2dgb39dgb4d68d796b3b"
msgid "Think - what else do we need?"
msgstr "생각해 - 또 뭐가 필요하더라?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD
#. Speaker = Nettie
#. NodeID = 8e1859d2-837d-ca09-adfa-a093b08581a7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 2fb4a271-d5f8-fce1-b64e-a7ba0a3e0830_Node1 = False
#.     - 2fb4a271-d5f8-fce1-b64e-a7ba0a3e0830_Node3 = False
#.     - 2fb4a271-d5f8-fce1-b64e-a7ba0a3e0830_Node2 = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD:8e1859d2-837d-ca09-adfa-a093b08581a7
msgctxt "hb4e6369bg0b42g4dd0g8970g214968d51411"
msgid "Silvanus save us if the goblins get in here."
msgstr "고블린이 쳐들어온다면, 실바누스시여, 저희를 지켜 주소서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD
#. Speaker = Nettie
#. NodeID = fb01fc6d-f07a-1f62-c5a3-49fb2ec865c7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#.   Local:
#.      - 2fb4a271-d5f8-fce1-b64e-a7ba0a3e0830_A = False
#.      - 2fb4a271-d5f8-fce1-b64e-a7ba0a3e0830_B = True
#. SetFlags:
#.   Local:
#.     - 2fb4a271-d5f8-fce1-b64e-a7ba0a3e0830_A = False
#.     - 2fb4a271-d5f8-fce1-b64e-a7ba0a3e0830_B = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD:fb01fc6d-f07a-1f62-c5a3-49fb2ec865c7
msgctxt "he498ab75ge1f0g4e24gbfbag605718f19ecc"
msgid "The grove's going to feel so empty now."
msgstr "이 숲이 텅 비어보이겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD
#. Speaker = Nettie
#. NodeID = fbcb438e-133e-d9fa-eb57-df328c2b39ba
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 2fb4a271-d5f8-fce1-b64e-a7ba0a3e0830_Node1 = False
#.      - 2fb4a271-d5f8-fce1-b64e-a7ba0a3e0830_Node3 = False
#.      - 2fb4a271-d5f8-fce1-b64e-a7ba0a3e0830_Node2 = True
#. SetFlags:
#.   Local:
#.     - 2fb4a271-d5f8-fce1-b64e-a7ba0a3e0830_Node1 = False
#.     - 2fb4a271-d5f8-fce1-b64e-a7ba0a3e0830_Node3 = True
#.     - 2fb4a271-d5f8-fce1-b64e-a7ba0a3e0830_Node2 = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD:fbcb438e-133e-d9fa-eb57-df328c2b39ba
msgctxt "hb2953b08g5d2bg459eg8218g7f3605e63bb5"
msgid "We're low on everything that I need to staunch a wound."
msgstr "지혈에 필요한 모든 게 부족해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD_Busy
#. Speaker = Nettie
#. NodeID = a20c5602-8e7b-a207-7f43-e1bfde542c85
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD_Busy:a20c5602-8e7b-a207-7f43-e1bfde542c85
msgctxt "h1f868913g11a5g4de3gb51eg141968a9f86b"
msgid "Not now. I'm busy."
msgstr "나중에요. 지금 바빠요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD_Studying
#. Speaker = Nettie
#. NodeID = 17926a8a-a6eb-8756-f80e-a2d90912fabb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Apprentice_State_HostileToTadpoled = False
#.   Local:
#.      - 6bba3537-3756-eb27-a08a-a8596d765f2e_C = False
#. SetFlags:
#.   Local:
#.     - 6bba3537-3756-eb27-a08a-a8596d765f2e_C = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD_Studying:17926a8a-a6eb-8756-f80e-a2d90912fabb
msgctxt "hb219277eg8733g475bgb5d2ga90585f61a0f"
msgid "I'll see if there's anything in Master Halsin's notes."
msgstr "할신 님의 기록에 뭔가 있는지 좀 봐야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD_Studying
#. Speaker = Nettie
#. NodeID = 39b90519-e77b-8b2d-b0e5-d4bf8850085f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD_Studying:39b90519-e77b-8b2d-b0e5-d4bf8850085f
msgctxt "h69de8faegc5b2g49ddg8f56gfe9abda53ec3"
msgid "He didn't find a cure, but maybe we can make you comfortable."
msgstr "치유할 방법을 찾진 못하셨지만, 안정을 찾을 방법은 있을지도 몰라요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD_Studying
#. Speaker = Nettie
#. NodeID = 72099339-9d3a-785f-4cce-a18a0016cade
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 6bba3537-3756-eb27-a08a-a8596d765f2e_B = True
#. SetFlags:
#.   Local:
#.     - 6bba3537-3756-eb27-a08a-a8596d765f2e_B = False
#.     - 6bba3537-3756-eb27-a08a-a8596d765f2e_A = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD_Studying:72099339-9d3a-785f-4cce-a18a0016cade
msgctxt "h14b0988cg8246g48dcg8325g224da59e9a75"
msgid "The more I read, the more sure I am. This is for the best."
msgstr "더 많이 읽을수록, 확신이 생기네요. 이게 최선이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD_Studying
#. Speaker = Nettie
#. NodeID = a6247b57-fc17-de9f-0528-15e3575edbe1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 6bba3537-3756-eb27-a08a-a8596d765f2e_A = True
#. SetFlags:
#.   Local:
#.     - 6bba3537-3756-eb27-a08a-a8596d765f2e_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD_Studying:a6247b57-fc17-de9f-0528-15e3575edbe1
msgctxt "hb6b7a8ffg4c63g4e0ag9524g1146bbbd185c"
msgid "It's just pages of death and terror."
msgstr "죽음과 공포에 대한 내용뿐이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD_Studying
#. Speaker = Nettie
#. NodeID = bcc7e771-0526-ff70-2d21-9ac2569dd171
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 6bba3537-3756-eb27-a08a-a8596d765f2e_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD_Studying:bcc7e771-0526-ff70-2d21-9ac2569dd171
msgctxt "hd771323eg22b0g4c16gbb0bg7a1a16e81926"
msgid "Bones twisting. Skin peeling off. This is ... horrific."
msgstr "뼈가 뒤틀리고. 피부가 벗겨진다니. 이건... 끔찍하군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD_TadpoledCombat
#. Speaker = Nettie
#. NodeID = 2702bc73-f916-4f79-a395-4a8cbb60f513
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - e9c0697a-41b0-32bb-7b2b-d3b1228718c1_CombatAD_1 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD_TadpoledCombat:2702bc73-f916-4f79-a395-4a8cbb60f513
msgctxt "hf736d245gf863g4851gab15g85d5b88eb99c"
msgid "I don't want to hurt you - but I have to protect the others."
msgstr "당신을 해치고 싶진 않지만, 다른 이들을 보호해야만 해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD_TadpoledCombat
#. Speaker = Nettie
#. NodeID = 67e1881e-12e9-47a8-a273-ca2dd1631716
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - e9c0697a-41b0-32bb-7b2b-d3b1228718c1_CombatAD_2 = True
#. SetFlags:
#.   Local:
#.     - e9c0697a-41b0-32bb-7b2b-d3b1228718c1_CombatAD_3 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD_TadpoledCombat:67e1881e-12e9-47a8-a273-ca2dd1631716
msgctxt "ha0fdad0cg671dg41b7g9ffdg187544c6985e"
msgid "Please. Don't make me do this."
msgstr "제발. 이러지 마세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD_TadpoledCombat
#. Speaker = Nettie
#. NodeID = aea9c2b7-b31f-40f0-85c9-b28368810e44
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - e9c0697a-41b0-32bb-7b2b-d3b1228718c1_CombatAD_4 = True
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Event_CombatADFinished = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD_TadpoledCombat:aea9c2b7-b31f-40f0-85c9-b28368810e44
msgctxt "hec59f1abg7783g4d7ag942bg220a9207a275"
msgid "You don't understand - you're dangerous!"
msgstr "이해를 못하시는군요, 당신은 위험해요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD_TadpoledCombat
#. Speaker = Nettie
#. NodeID = b19adb02-f177-494b-b3a7-859765a3cc23
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - e9c0697a-41b0-32bb-7b2b-d3b1228718c1_CombatAD_1 = True
#. SetFlags:
#.   Local:
#.     - e9c0697a-41b0-32bb-7b2b-d3b1228718c1_CombatAD_2 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD_TadpoledCombat:b19adb02-f177-494b-b3a7-859765a3cc23
msgctxt "h931bdaeag252dg47bcga8d1g96fce749efd7"
msgid "This is for your own good, why can't you see that?"
msgstr "결국 당신을 위한 일인 것을 왜 모르시나요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD_TadpoledCombat
#. Speaker = Nettie
#. NodeID = f483031c-91fe-4719-acab-7505857abd70
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - e9c0697a-41b0-32bb-7b2b-d3b1228718c1_CombatAD_3 = True
#. SetFlags:
#.   Local:
#.     - e9c0697a-41b0-32bb-7b2b-d3b1228718c1_CombatAD_4 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD_TadpoledCombat:f483031c-91fe-4719-acab-7505857abd70
msgctxt "hee63f392ge449g43b6gb66ag6d4a8e2978f0"
msgid "This could've been easy!"
msgstr "간단히 끝낼 수도 있었어요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD_TadpoledStart
#. Speaker = Nettie
#. NodeID = 8340d3d0-99eb-6942-5819-5bd9fbd7ad58
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD_TadpoledStart:8340d3d0-99eb-6942-5819-5bd9fbd7ad58
msgctxt "hcd970664gfcd2g43afg991agfcdafc4808c4"
msgid "We need to be quick. This way."
msgstr "서둘러야 해요. 이쪽이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD_ToStorage
#. Speaker = Nettie
#. NodeID = 3c8dd230-bf99-16fa-c1d6-3fb89a5a15ee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD_ToStorage:3c8dd230-bf99-16fa-c1d6-3fb89a5a15ee
msgctxt "h773eafaagd77eg4749g9454ga160d576f785"
msgid "Head on in."
msgstr "안으로 들어가시죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD_WithBird
#. Speaker = Wounded Bird
#. NodeID = 06abb20b-b63f-a921-6b3d-458ddc27ea1a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD_WithBird:06abb20b-b63f-a921-6b3d-458ddc27ea1a
msgctxt "hd0228c42g0b6dg4f09g8753gac74654b78b1"
msgid "*Chirp!*"
msgstr "*짹짹!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD_WithBird
#. Speaker = Nettie
#. NodeID = 28937d0a-e11a-0799-cfd5-ac6116616063
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - b8958184-8715-01f5-4668-f08390d1151e_Intro = False
#. SetFlags:
#.   Local:
#.     - b8958184-8715-01f5-4668-f08390d1151e_Intro = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD_WithBird:28937d0a-e11a-0799-cfd5-ac6116616063
msgctxt "h425e7779gfccdg49cbgaa0fg0be8e91767cf"
msgid "They did a number on you, didn't they?"
msgstr "그들이 네게 꽤나 못된 짓을 했구나, 안 그래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD_WithBird
#. Speaker = Nettie
#. NodeID = 6a352c29-e6a7-d0fd-798b-e628554b4037
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD_WithBird:6a352c29-e6a7-d0fd-798b-e628554b4037
msgctxt "h6722a206g6cf4g4b55gb080g9d325125434a"
msgid "Shhh. Nearly there."
msgstr "조용히. 거의 다 왔어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD_WithBird
#. Speaker = Nettie
#. NodeID = 778a2ad0-b62c-aaf2-5ba8-922203971f85
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD_WithBird:778a2ad0-b62c-aaf2-5ba8-922203971f85
msgctxt "h7f21ca50g0ad5g4406gbff9g08b4bb6234b9"
msgid "I know. We're nearly done."
msgstr "알아. 거의 끝났어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD_WithBird
#. Speaker = Nettie
#. NodeID = 8f1ebd9c-d417-548f-a615-ee890dc9e381
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
