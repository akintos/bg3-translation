msgctxt "h27b3449cgb0f4g4189ga9b9g08af5c4e2003"
msgid "What are you playing at...? The mask - <i>take it off</i>!"
msgstr "대체 뭘 가지고 노는....? 가면이잖아 - <i>당장 벗어</i>!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_ControlledByMask
#. Speaker = Gale
#. NodeID = 54f17764-65c4-4f20-8885-0a4db1aa8f38
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom2(7) = True
