msgctxt "he75a565agcd97g4b20gbda7ge9886eb6a646"
msgid "Are those big ears just for show? You heard me."
msgstr "그 커다란 귀는 장식이냐? 내 말 들었잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = ade84ead-7def-5263-1d61-a383ab2a6084
