msgctxt "h9e0d42eeg3c8fg4533gb9fcg67307f16a42b"
msgid "No matter. There must be another way in."
msgstr "상관 없어. 분명 다른 길이 있을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_TavernInvestigation_PAD_OtherWay
