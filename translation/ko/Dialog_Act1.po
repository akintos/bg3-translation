#.      - UND_MyconidDrowDead_State_ToldRivalry(1) = False
#.   Global:
#.      - UND_MyconidDrowDead_State_MentionedOthers = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_MyconidDrow_Dead:89e1c01f-7fc3-6dd2-801c-506b38abbcad
msgctxt "h5fc992fag5a35g48ebg93dbg5ce82b6bab63"
msgid "'We'? Who were the others?"
msgstr "'우리'라니? 다른 자들은 누군데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_MyconidDrow_Dead
#. Speaker = Pale Corpse
#. NodeID = 8e259bdd-116f-4143-988a-01940af48e68
