msgctxt "h29057835g9cf4g41cfg8417g60d1325cd6d9"
msgid "What th-"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_AlarmUsedReaction
#. Speaker = Sentinel Olak
#. NodeID = 44adef9b-ae5b-a3a6-84c1-9d9c74922e6f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_AlarmUsedReaction:44adef9b-ae5b-a3a6-84c1-9d9c74922e6f
msgctxt "h6a61ff32g86a3g4b32g9ea7gf20cfb771397"
msgid "Can't have 'em fallin' asleep now, can we?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_AlarmUsedReaction
#. Speaker = Sentinel Olak
#. NodeID = 683b699c-dad4-6770-756a-ea79941628a1
#. HandlePath = TaggedText[0].TagText[0]
