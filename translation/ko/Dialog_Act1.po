msgctxt "h4aee8096g54e9g48a4gbb6dgc845e6cb7d88"
msgid "Do you have any regrets?"
msgstr "아무런 후회도 없나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead
#. Speaker = Auntie Ethel
#. NodeID = ba73f5c1-ad5b-0e50-1449-348133a2e989
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
