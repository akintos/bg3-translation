#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_TavernInvestigation_PAD_OtherWay:df24472e-7153-d0b4-3c32-e21e621feaf8
msgctxt "h191e97d1gc737g4b4ag9c60ge76b2ca1f7cd"
msgid "Hmm. Looks like I'll need to find another way in."
msgstr "흠, 다른 길을 찾아봐야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_TavernInvestigation_PAD_OtherWay
#. Speaker = Player
#. NodeID = df24472e-7153-d0b4-3c32-e21e621feaf8
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_TavernInvestigation_PAD_OtherWay:df24472e-7153-d0b4-3c32-e21e621feaf8
msgctxt "h1c4f68d4g8042g4e04gae37g4e4e898a3ad7"
msgid "Worth looking for another way in before this place is reduced to ashes."
msgstr "이 곳이 잿더미가 되기 전에 다른 길을 찾는 게 좋겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_TavernInvestigation_PAD_OtherWay
#. Speaker = Player
#. NodeID = df24472e-7153-d0b4-3c32-e21e621feaf8
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_TavernInvestigation_PAD_OtherWay:df24472e-7153-d0b4-3c32-e21e621feaf8
msgctxt "hf627a0d2gda3bg4e3dg8c99g1d0ebbce35c7"
msgid "You huff and puff at the door. I'll find my own way in."
msgstr "계속 문에서 씩씩대봐. 난 다른 길을 찾아서 들어갈테니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_TavernInvestigation_PAD_OtherWay
#. Speaker = Player
#. NodeID = df24472e-7153-d0b4-3c32-e21e621feaf8
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_TavernInvestigation_PAD_OtherWay:df24472e-7153-d0b4-3c32-e21e621feaf8
msgctxt "h19bea9e3g4630g4ca6g94dag16390108fa17"
msgid "Damn it. Have to find another way in."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_TavernInvestigation_PAD_OtherWay
#. Speaker = Player
#. NodeID = df24472e-7153-d0b4-3c32-e21e621feaf8
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_TavernInvestigation_PAD_OtherWay:df24472e-7153-d0b4-3c32-e21e621feaf8
msgctxt "he18c0ca7g6b05g49d3gb1bbg621d5d9614de"
msgid "Hmmm. When one door closes, another opens. All I need to do is find it."
msgstr "흐음.. 하나의 문이 닫히면 다른 문이 열린다지. 그 문을 찾기만 하면 돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_TavernInvestigation_PAD_OtherWay
#. Speaker = Player
#. NodeID = df24472e-7153-d0b4-3c32-e21e621feaf8
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_TavernInvestigation_PAD_OtherWay:df24472e-7153-d0b4-3c32-e21e621feaf8
msgctxt "h3e179f16g8382g471fg8580g078cf54fa895"
msgid "There's got to be another way in."
msgstr "다른 입구가 있을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_DeadCiv1_Dead
#. Speaker = Player
#. NodeID = 04129d58-29f2-0af2-6f6b-ceb4005a7de8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#.   Quest:
#.     - PLA_StuckHalfElf.FoundWife(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_DeadCiv1_Dead:04129d58-29f2-0af2-6f6b-ceb4005a7de8
msgctxt "h6d3b8205gb9a2g47f0gaef0g7087ad641af3"
msgid "Who are you?"
msgstr "당신은 누구지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_DeadCiv1_Dead
#. Speaker = Benryn
#. NodeID = 0594107a-eed7-5bf5-16b7-2ebb0091d48e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_StuckHalfElf_Knows_ExplainedDowry = False
#. SetFlags:
#.   Global:
#.     - PLA_StuckHalfElf_Knows_ExplainedDowry = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_DeadCiv1_Dead:0594107a-eed7-5bf5-16b7-2ebb0091d48e
msgctxt "h95232189gbed2g46c5gb6e3gdd38d3893109"
msgid "It's for her sister's wedding. Miri had it when she ran out."
msgstr "내 여동생의 결혼식을 위한 거예요. 미리가 도망쳐 나갔을 때 가지고 있었어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_DeadCiv1_Dead
#. Speaker = Player
#. NodeID = 0b1a228d-2bd1-11ae-ea68-cb6d9a9e94e2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(1) = False
#. SetFlags:
#.   User:
#.     - PLA_StuckHalfElf_Event_ToldQuestion(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_DeadCiv1_Dead:0b1a228d-2bd1-11ae-ea68-cb6d9a9e94e2
msgctxt "hc116b81fgee8dg49f7gaa6fg018ceb7b6edd"
msgid "Maybe. What do you want me to ask?"
msgstr "그럴지도. 뭘 물어봐 줬으면 좋겠어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_DeadCiv1_Dead
#. Speaker = Player
#. NodeID = 1197258d-20a5-d040-e8fb-f5b4d5a1887c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Quest:
#.      - PLA_StuckHalfElf.KnowDowry(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_DeadCiv1_Dead:1197258d-20a5-d040-e8fb-f5b4d5a1887c
msgctxt "hf910e606g6c9fg43d0g86c8g8982219afde3"
msgid "I already know where it is."
msgstr "이미 어디에 있는지 알고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_DeadCiv1_Dead
#. Speaker = Player
#. NodeID = 1384c395-b30e-956f-d47e-ff1ae069eb32
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_StuckHalfElf_Knows_ExplainedDowry = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#.   Tag:
#.      - HALFELF(2) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#.   Quest:
#.     - PLA_StuckHalfElf.KnowDowry(1) = True
#.   User:
#.     - PLA_TavernInvestigation_Knows_HalfElfHusband(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_DeadCiv1_Dead:1384c395-b30e-956f-d47e-ff1ae069eb32
msgctxt "h4d438dbag8723g4232gb7d0g9cc6858c9536"
msgid "Where is your sister's dowry?"
msgstr "당신 여동생의 결혼 지참금은 어디 있지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_DeadCiv1_Dead
#. Speaker = Player
#. NodeID = 1efbb16a-8372-0ce8-0087-222fb7ad13be
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_DeadCiv1_Dead:1efbb16a-8372-0ce8-0087-222fb7ad13be
msgctxt "hd8d53245gf610g41a9gaefegf46c0e7d2a14"
msgid "I've done enough for you."
msgstr "해줄 수 있는 건 다 해줬어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_DeadCiv1_Dead
#. Speaker = Narrator
#. NodeID = 1fbcaa9b-a821-20d5-f791-48d3fdb41d2e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_DeadCiv1_Dead:1fbcaa9b-a821-20d5-f791-48d3fdb41d2e
msgctxt "h7b5c338cgb744g42bbgad47gddab445652be"
msgid "*The corpse regards you lifelessly.*"
msgstr "*시체가 생기 없는 모습으로 당신을 맞이합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_DeadCiv1_Dead
#. Speaker = Narrator
#. NodeID = 252e7566-851c-9979-b5b5-c330afd6dbf3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_DeadCiv1_Dead:252e7566-851c-9979-b5b5-c330afd6dbf3
msgctxt "h547caa39gbca8g4b91gbc1eg6e79bb537622"
msgid "*The spell's power wanes. You can ask no more questions.*"
msgstr "*주문의 힘이 약해집니다. 더 이상 질문을 할 수 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_DeadCiv1_Dead
#. Speaker = Narrator
#. NodeID = 28e5d1f1-a5ae-760f-265e-e1c0299cf9a6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_DeadCiv1_Dead:28e5d1f1-a5ae-760f-265e-e1c0299cf9a6
msgctxt "h83fd768ag94bag48c5gadf8g7404c5a0d8b6"
msgid "*The corpse does not stir. It will answer no more questions.*"
msgstr "*시체는 움직이지 않습니다. 더 이상 질문을 받지 않을 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_DeadCiv1_Dead
#. Speaker = Benryn
#. NodeID = 371a47ee-bacd-d0ff-c97a-8a85db797c60
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_DeadCiv1_Dead:371a47ee-bacd-d0ff-c97a-8a85db797c60
msgctxt "h8fa87c24gb5bdg4c6egbbc4g190158c3ef74"
msgid "Please."
msgstr "제발."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_DeadCiv1_Dead
#. Speaker = Benryn
#. NodeID = 371e9819-c08a-c156-f344-56dddca89b6e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_DeadCiv1_Dead:371e9819-c08a-c156-f344-56dddca89b6e
msgctxt "hd2ff9773gca75g42cagb7cbg25f66090784f"
msgid "I trust you to get it for me. I can't leave her."
msgstr "당신이 가져다주리라 믿어요. 난 그녀 곁을 떠날 수 없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_DeadCiv1_Dead
#. Speaker = Benryn
#. NodeID = 38b0d0b9-8b99-bdef-0268-06f069d59f9b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_DeadCiv1_Dead:38b0d0b9-8b99-bdef-0268-06f069d59f9b
msgctxt "hbe6ad4aagf6d3g4422g9008gaf7f94fa0eeb"
msgid "You can stop now. Let her rest."
msgstr "그만해요. 이제 쉬게 놔둬요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_DeadCiv1_Dead
#. Speaker = Mirileth
#. NodeID = 3e6712fa-86e1-7b33-1dd6-2bbaf75b0353
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_DeadCiv1_Dead:3e6712fa-86e1-7b33-1dd6-2bbaf75b0353
msgctxt "h5bf44bd5gc081g4902g8f52g391585ef2394"
msgid "... finding... husband... Benryn... inside..."
msgstr "... 남편을... 찾다가... 벤린이... 안에..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_DeadCiv1_Dead
#. Speaker = Benryn
#. NodeID = 4089352d-1b63-350a-b77f-1a1818189e22
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_StuckHalfElf_Knows_ExplainedDowry = False
#. SetFlags:
#.   Global:
#.     - PLA_StuckHalfElf_Knows_ExplainedDowry = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_DeadCiv1_Dead:4089352d-1b63-350a-b77f-1a1818189e22
msgctxt "hcaa9fa37g91b1g4b76gb9b4gb3f155cb0885"
msgid "She had her sister's dowry. I'd hoped she could tell us where it is."
msgstr "그녀가 동생을 위한 결혼 지참금을 가지고 있었어요. 그걸 어디에 뒀는지 알려 줬으면 좋겠어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_DeadCiv1_Dead
#. Speaker = Benryn
#. NodeID = 4231a509-2667-2338-8254-19fd4cee9f01
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_StuckHalfElf_State_PlayerAngered(1) = False
#.   Local:
#.      - c167cdf3-7201-e55c-222f-773c758e1000_IncludedHusband = False
#.   Quest:
#.      - PLA_StuckHalfElf.ReturnedGold(1) = True
#. SetFlags:
#.   Quest:
#.     - PLA_StuckHalfElf.ReachedWife(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_DeadCiv1_Dead:4231a509-2667-2338-8254-19fd4cee9f01
msgctxt "hc8008b7fgbe90g4647ga02ega50724eae4c5"
msgid "Please, leave her be. She deserves peace."
msgstr "제발, 그녀를 그냥 놔둬요. 이제 쉬게 둬요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_DeadCiv1_Dead
#. Speaker = Benryn
#. NodeID = 4b97efff-f03f-61c8-cf0a-2c7a3c17e31e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_DeadCiv1_Dead:4b97efff-f03f-61c8-cf0a-2c7a3c17e31e
msgctxt "h82e676efg01bdg44dbgbd18gea5e5b21ebca"
msgid "Oh. It was probably pointless anyway."
msgstr "오, 어차피 그건 별 소용 없었을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_DeadCiv1_Dead
#. Speaker = Benryn
#. NodeID = 523eb333-9cc5-0328-444f-8c98f141a4f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_DeadCiv1_Dead:523eb333-9cc5-0328-444f-8c98f141a4f5
msgctxt "h7c669c09g2f7cg4079gae1ageaef296ed059"
msgid "She didn't make it far. It'll be close."
msgstr "그녀는 멀리 가지 못했어요. 분명 가까이 있을 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_DeadCiv1_Dead
#. Speaker = Player
#. NodeID = 58bef2cf-c1cc-ad3c-98b9-46e69a8ac2b8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#.   User:
#.      - PLA_TavernInvestigation_Knows_HalfElfHusband(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_DeadCiv1_Dead:58bef2cf-c1cc-ad3c-98b9-46e69a8ac2b8
msgctxt "h37c824begb2e8g4625g9e57ga0546c06848e"
msgid "Where is Benryn?"
msgstr "벤린은 어디에 있지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_DeadCiv1_Dead
#. Speaker = Player
#. NodeID = 657de5db-786c-a743-a5dd-ae57108a28a9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - PLA_StuckHalfElf_State_PlayerAngered(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_DeadCiv1_Dead:657de5db-786c-a743-a5dd-ae57108a28a9
msgctxt "hae7e5ea5ge5f2g4292g902dge222d31451f8"
msgid "I said no."
msgstr "아니라고 했을 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_DeadCiv1_Dead
#. Speaker = Mirileth
#. NodeID = 6a3fa909-b0bf-7f12-1770-fe62be50e82a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_DeadCiv1_Dead:6a3fa909-b0bf-7f12-1770-fe62be50e82a
msgctxt "hf073631dgb3fdg4b76g9ba0gba2a3fa188cb"
msgid "... dowry... for sister... in barn..."
msgstr "...동생을 위한... 결혼 지참금... 헛간에..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_DeadCiv1_Dead
#. Speaker = Benryn
#. NodeID = 6fda0b2f-b336-673c-8ba7-ed97a025a5cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_DeadCiv1_Dead:6fda0b2f-b336-673c-8ba7-ed97a025a5cf
msgctxt "he4987903gbe39g4f44gb2acgd98ddcd27d39"
msgid "The barn? She must mean one of the empty buildings behind the inn."
msgstr "헛간이라고? 여관 뒤에 있는 빈 건물 중에 하나를 말하는 게 분명해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_DeadCiv1_Dead
#. Speaker = Player
#. NodeID = 702957e8-e220-5949-7577-9df5c56cdfd0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - PLA_StuckHalfElf_State_HasDowry(1) = True
#. SetFlags:
#.   Object:
#.     - PLA_StuckHalfElf_Event_GiveDowry(2) = True
#.   Quest:
#.     - PLA_StuckHalfElf.ReturnedGold(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_DeadCiv1_Dead:702957e8-e220-5949-7577-9df5c56cdfd0
msgctxt "hcb63c42fg29adg48d1ga804g963356b9adeb"
msgid ""
"I already found it. Here, take it. "
"([GEN_CheckMagicPocketGold_6057ad05-9492-4630-9f0a-be548b134c54])"
msgstr ""
"이미 찾았어. 자 여기, 가져가. ([GEN_CheckMagicPocketGold_6057ad05-9492-4630-9f0a-"
"be548b134c54])"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_DeadCiv1_Dead
#. Speaker = Player
#. NodeID = 7597efca-1c21-e4f5-4987-555420a03214
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Quest:
#.      - PLA_StuckHalfElf.KnowDowry(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#.   Quest:
#.     - PLA_StuckHalfElf.KnowDowry(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_DeadCiv1_Dead:7597efca-1c21-e4f5-4987-555420a03214
msgctxt "hc90997dcgce4ag441fgaa2dg618bf8099735"
msgid "<i>Ask his question.</i>"
msgstr "<i>그의 질문을 묻는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_DeadCiv1_Dead
#. Speaker = Player
#. NodeID = 76106b9e-4c5e-5e44-06a3-b8aad7129e06
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_DeadCiv1_Dead:76106b9e-4c5e-5e44-06a3-b8aad7129e06
msgctxt "hc7cbd089g07a5g42c6g862ag2bd49dccbf72"
msgid "Be quiet. I have questions of my own."
msgstr "조용히 해. 내가 할 질문이 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_DeadCiv1_Dead
#. Speaker = Benryn
#. NodeID = 78ef4d1f-aeef-7dad-c36b-d719ea78d3ac
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   User:
#.     - PLA_StuckHalfElf_Knows_MentionedDowry(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_DeadCiv1_Dead:78ef4d1f-aeef-7dad-c36b-d719ea78d3ac
