msgctxt "hfea34ad7g71aeg44f0g8d30gbc7b2086b78f"
msgid "*The rothé utters an angry bellow and charges.*"
msgstr "*로테가 분노의 굉음을 내더니 돌진합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001
#. Speaker = Narrator
#. NodeID = a9a5c9da-bcf7-2e75-6987-58808a17446d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001:a9a5c9da-bcf7-2e75-6987-58808a17446d
msgctxt "hafc9311fg0efbg458ag99ecgf88aae409893"
msgid "*The deep rothé's agitation intensifies. It is primed to attack.*"
msgstr "*지하 로테의 불안감이 깊어집니다. 공격하기 직전입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001
#. Speaker = Deep Rothé
#. NodeID = aae20ddc-01a9-1fcb-1b6a-30f484f6a020
