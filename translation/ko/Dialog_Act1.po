msgctxt "hd541b8a8gd293g42bbga6a5ga1e2e7e6ccdb"
msgid "I... erm..."
msgstr "난... 음..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Trespassing
#. Speaker = Narrator
#. NodeID = aee6de9a-a947-3a5f-545f-3b77f6d36d92
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
