msgctxt "h7f10fc55g3fe8g43a8gb757g79386a51f914"
msgid "MIRI! Answer me!"
msgstr "<b>미리!</b> 대답해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_AD_Searching
