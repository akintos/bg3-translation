msgctxt "heb909159gd920g4e2dg8e3cg55508e35b854"
msgid ""
"*The spiders scatter and you stash the bag. Something clinks among the "
"coins.*"
msgstr "*거미는 물러갔고 당신은 주머니를 챙겼습니다. 동전들 사이에서 무언가가 달그락거립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice
#. Speaker = Player
#. NodeID = e47d0332-44be-a2a3-e3c3-7214369e92a4
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 10
