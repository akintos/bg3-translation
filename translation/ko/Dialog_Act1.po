#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:9d0bfa35-1872-b91e-141a-f7f47e1dc2ad
msgctxt "hb0228abbg438cg429eg94a9g1587fb101ef9"
msgid "He is a True Soul. Mind him. He will - he - he..."
msgstr "이 남자는 참된 영혼이다. 그를 따라라. 그가... 그... 그가..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Edowin
#. NodeID = 9d0bfa35-1872-b91e-141a-f7f47e1dc2ad
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_PriestOfTheConqueringGod_Cultists_TrueSoulPowersUsed(3) = False
