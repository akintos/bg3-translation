msgctxt "h91af69d3gf833g440bg9db6g8a6e5cc22003"
msgid "Did I not warn you? Slice 'em up, fellas!"
msgstr "경고하지 않았나? 얘들아, 이놈들을 조각내 버려라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent
#. Speaker = Corsair Greymon
#. NodeID = 3dc9353d-398e-65d8-ff78-31e0c75e798d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent:3dc9353d-398e-65d8-ff78-31e0c75e798d
msgctxt "h9c2334b2gd633g4fe9ga3a2g558358ca1c9d"
msgid "Where's Gekh? <i>Who are you?</i>"
msgstr "게크는 어디 있지? <i>넌 누구야?</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent
#. Speaker = Corsair Greymon
#. NodeID = 3de52e50-b9a3-7b62-3c80-c6f336768c9d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_DarkLake_State_HostileResolution = True
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent:3de52e50-b9a3-7b62-3c80-c6f336768c9d
msgctxt "h393e2982g38f4g481dga669g81531abc774d"
msgid "Get him, fellas!"
msgstr "얘들아, 놈을 잡아라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent
#. Speaker = Corsair Greymon
#. NodeID = 3de52e50-b9a3-7b62-3c80-c6f336768c9d
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_DarkLake_State_HostileResolution = True
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent:3de52e50-b9a3-7b62-3c80-c6f336768c9d
msgctxt "h44313c9ag74e4g4d3fga842gf93779010e46"
msgid "Get her, fellas!"
msgstr "얘들아, 저년을 잡아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent
#. Speaker = Corsair Greymon
#. NodeID = 3de52e50-b9a3-7b62-3c80-c6f336768c9d
#. HandlePath = TaggedText[2].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_DarkLake_State_HostileResolution = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent:3de52e50-b9a3-7b62-3c80-c6f336768c9d
msgctxt "h462cad6dg3a19g4d92gb75egfa20b589008a"
msgid "Get them, fellas!"
msgstr "얘들아, 놈들을 잡아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent
#. Speaker = Corsair Greymon
#. NodeID = 3f5ef991-8f09-e38c-b9ae-d936e1f5b2ff
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: HUMAN
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent:3f5ef991-8f09-e38c-b9ae-d936e1f5b2ff
msgctxt "h15773382g8d68g414bgb46fg24eca68f7137"
msgid "Ho! How desperate is the cur, to make an ally of a <i>human</i>?"
msgstr "하! 그 개자식 <i>인간</i>이랑 편을 먹다니, 얼마나 절박한 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent
#. Speaker = Corsair Greymon
#. NodeID = 3f5ef991-8f09-e38c-b9ae-d936e1f5b2ff
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DWARF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent:3f5ef991-8f09-e38c-b9ae-d936e1f5b2ff
msgctxt "h2d87e045g069cg4457g9cf6ga4fa8c7b7ea4"
msgid "Ho! How desperate is the cur, to make an ally of a dwarf <i>hoon</i>?"
msgstr "하! 드워프 <i>훈</i>이랑 편을 먹다니, 얼마나 절박한 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent
#. Speaker = Corsair Greymon
#. NodeID = 3f5ef991-8f09-e38c-b9ae-d936e1f5b2ff
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: GNOME
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent:3f5ef991-8f09-e38c-b9ae-d936e1f5b2ff
msgctxt "h2e381560g4e9bg4eedg9d4eg695c1c531549"
msgid "Ho! How desperate is the cur, to make an ally of a gnome?"
msgstr "하! 그 개자식 <i>노움</i>이랑 편을 먹다니, 얼마나 절박한 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent
#. Speaker = Corsair Greymon
#. NodeID = 3f5ef991-8f09-e38c-b9ae-d936e1f5b2ff
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: UNDERDARK
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent:3f5ef991-8f09-e38c-b9ae-d936e1f5b2ff
msgctxt "h9e0deb70g24beg4eaeg85bcgbf6d07ec28ff"
msgid "Ho! How desperate is the cur, that he calls on a helper?"
msgstr "하! 도움을 요청하다니, 그 개자식 얼마나 절박한 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent
#. Speaker = Corsair Greymon
#. NodeID = 3f5ef991-8f09-e38c-b9ae-d936e1f5b2ff
#. HandlePath = TaggedText[4].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent:3f5ef991-8f09-e38c-b9ae-d936e1f5b2ff
msgctxt "hcf77cd4egd47ag4dafgaf46gaf3816089e99"
msgid "Ho! How desperate is the cur, to make an ally of a <i>topsider</i>?"
msgstr "하! <i>지상 놈이랑</i> 편을 먹다니, 그 개자식 얼마나 절박한 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent
#. Speaker = Corsair Greymon
#. NodeID = 4f25f249-127d-3789-c765-443a7f5a0f9d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent:4f25f249-127d-3789-c765-443a7f5a0f9d
msgctxt "hf6223825g5038g47bdg993agb0f5de8397d1"
msgid "Hold on. <i>You're not Gekh.</i>"
msgstr "잠깐. <i>넌 게크가 아니잖아.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent
#. Speaker = Player
#. NodeID = 503a3865-ccc2-3aad-b72e-4be0bd605890
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent:503a3865-ccc2-3aad-b72e-4be0bd605890
msgctxt "h4cd631bfga9e9g469eg9471g0d870933b887"
msgid "He stayed behind to tie up some loose ends."
msgstr "처리할 일이 좀 남아서, 뒤에 남았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent
#. Speaker = Corsair Greymon
#. NodeID = 50982707-1649-c9ec-aeca-f27c58469a78
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent:50982707-1649-c9ec-aeca-f27c58469a78
msgctxt "h09b06804gcdcfg40f2g88e8g3bc200a43276"
msgid "What a load of rothé shite. No way a mushroom killed Gekh."
msgstr "로테 똥 같은 소리군. 게크가 버섯한테 당했을 리가 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent
#. Speaker = Corsair Greymon
#. NodeID = 50d0fd44-84b1-1c3e-9429-e9a35af7e1e8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DUERGARDWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent:50d0fd44-84b1-1c3e-9429-e9a35af7e1e8
msgctxt "hf25af73cg4461g4e0fga9bcg9e0942155e11"
msgid "Gekh? Is that you?"
msgstr "게크? 너냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent
#. Speaker = Corsair Greymon
#. NodeID = 5286c739-d597-4ccd-f7a0-d53b2c6bc7ba
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_LoneDuergar_Quest_DuergarMet = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent:5286c739-d597-4ccd-f7a0-d53b2c6bc7ba
#, fuzzy
msgctxt "hb3d369fegeec2g47fcgb005g12ad007b1374"
msgid "Damn it. Gekh's gone and screwed up. If he's dead, so's the squad."
msgstr "망할. 게크가 사라져서 망쳐버렸군. 그놈이 죽었다면, 녀석의 분대도 같이 갔겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent
#. Speaker = Corsair Greymon
#. NodeID = 5417567b-1922-de27-75d7-3a75b2d49a19
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent:5417567b-1922-de27-75d7-3a75b2d49a19
msgctxt "h93945dcagb5a3g4923gb0adga15fd8b35b05"
msgid "Where's Gekh? <i>Who are you?</i>"
msgstr "게크는 어디 있지? <i>넌 누구야?</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent
#. Speaker = Corsair Greymon
#. NodeID = 599b4a16-08a2-6e2b-05f5-6e3fdfdbd49d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent:599b4a16-08a2-6e2b-05f5-6e3fdfdbd49d
msgctxt "hc2f54a9cg2fa6g4d2egb367g7d902e7eb182"
msgid "Well I'll be - you got them. The sergeant's been whining non-stop."
msgstr "글쎄, 나는 - 네가 그걸 가져왔군. 하사관이 계속 징징거렸다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent
#. Speaker = Player
#. NodeID = 66dfe1d0-10db-9c76-af88-4483f53d81e8
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Global:
#.      - UND_LoneDuergar_Quest_DuergarMet = True
#. SetFlags:
#.   Global:
#.     - UND_DarkLake_State_ClaimedGekhWasDead = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent:66dfe1d0-10db-9c76-af88-4483f53d81e8
msgctxt "hfe2cb14dgc08fg4b83g8354g9cddf3d28015"
msgid "I'm afraid Gekh is dead - he fell fighting the myconids."
msgstr "미안하지만, 게크는 죽었어. 마이코니드들과 싸우다가 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent
#. Speaker = Corsair Greymon
#. NodeID = 692bb78a-5ac2-cde8-270d-de8243042f52
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DEEPGNOME(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent:692bb78a-5ac2-cde8-270d-de8243042f52
msgctxt "ha7a5121fgbd58g4b27ga475g7fa024b49f70"
msgid "She just loves your sort, you see. Real keen on deep gnomes. Heh."
msgstr "그녀는 너 같은 놈들을 아주 사랑하거든. 딥 노움에 대한 집착이 꽤 심하단 말이지. 헤."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent
#. Speaker = Corsair Greymon
#. NodeID = 69b54eec-8831-817a-01e0-fc7368561428
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_DarkLake_State_HostileResolution = True
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent:69b54eec-8831-817a-01e0-fc7368561428
msgctxt "ha3164208g150fg4509gbbe3gebd82ddf9fe2"
msgid "The Absolute? Not bloody likely. Get him, fellas!"
msgstr "절대자라고? 아닌 것 같은데. 얘들아, 놈을 잡아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent
#. Speaker = Corsair Greymon
#. NodeID = 69b54eec-8831-817a-01e0-fc7368561428
