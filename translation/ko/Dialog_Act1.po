msgctxt "hfc6963bfgad34g4ff3g8a64g55acc66c57fa"
msgid "You don't scare us!"
msgstr "우린 네가 두렵지 않다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_Trainer
#. Speaker = Asharak
#. NodeID = 309de998-a7f0-6cc8-1529-6cf2e900724b
