msgctxt "h7a4d81f0g790fg4457gabdagf7560a477b6a"
msgid ""
"Captain Voss won't be happy you killed the person who found your lost weapon."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing
#. Speaker = Player
#. NodeID = 12097f91-9139-842f-5c2e-f48ae9820e9e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#. CheckFlags:
