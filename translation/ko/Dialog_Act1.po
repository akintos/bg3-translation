msgctxt "ha385b36ag8d12g4db7ga581gfe936c55ef37"
msgid "That's hardly how you should speak of your saviour."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarlockProposal_Warlock
#. Speaker = Korrilla
#. NodeID = 7b23f5fc-985b-7fc7-ac1b-b206dc205754
#. HandlePath = TaggedText[0].TagText[0]
