msgctxt "h586485e4g8e24g40edga39ag5f200a4ea69a"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ShadowDruid_002
#. Speaker = Narrator
#. NodeID = 3b24c0ef-96f3-46ad-781f-7b32f62741d7
