msgctxt "h2256d72fge497g4478gb20cgf5af1b74772d"
msgid "Hah! Got an earful, did ya?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WarchiefGrumpy_AD_WithCoalRaiders
#. Speaker = Zurga
#. NodeID = 04bfeb17-2378-f38a-21ee-08fe4bbec358
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WarchiefGrumpy_AD_WithCoalRaiders:04bfeb17-2378-f38a-21ee-08fe4bbec358
msgctxt "hc783ee40g6bbeg4f7fg820dge4f0766c4bf5"
msgid "You been cookin' rats in 'ere? Smells <i>good</i>."
msgstr "여기서 쥐고기 요리했냐? <i>좋은</i> 냄새가 나는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WarchiefGrumpy_AD_WithCoalRaiders
#. Speaker = Sharp-Eye Neem
#. NodeID = 0e052692-15e9-d5a2-5a60-3b9ce15bc109
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WarchiefGrumpy_AD_WithCoalRaiders:0e052692-15e9-d5a2-5a60-3b9ce15bc109
msgctxt "h81900c28g17c7g484eg8a54g57fff6ab24dd"
msgid "...I stood too close to the fire and burned my arse."
msgstr "...불에 너무 가까이 서 있는 바람에 궁둥짝이 구워졌어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WarchiefGrumpy_AD_WithCoalRaiders
#. Speaker = Sharp-Eye Neem
#. NodeID = cb3b5188-5388-f918-645a-9ab5f88c6020
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WarchiefGrumpy_AD_WithCoalRaiders:cb3b5188-5388-f918-645a-9ab5f88c6020
msgctxt "h93d489d1gae50g4cdcg9d05g8c0f0644b365"
msgid "Nah, that ain't rat..."
msgstr "아니, 쥐는 아니었어..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WarchiefGrumpy_AD_WithGuard
#. Speaker = Lookout Grush
#. NodeID = 3dcabe2e-8267-5d47-a28a-846b2e19354c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WarchiefGrumpy_AD_WithGuard:3dcabe2e-8267-5d47-a28a-846b2e19354c
msgctxt "h808fd904g78b6g4bfdga400ge19ee1e43c83"
msgid "Nah. That sack of offal won't tell us nothing."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WarchiefGrumpy_AD_WithGuard
#. Speaker = Lookout Grush
#. NodeID = 4625c0be-6e51-5c4f-00e8-a8e1d4e88afd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WarchiefGrumpy_AD_WithGuard:4625c0be-6e51-5c4f-00e8-a8e1d4e88afd
msgctxt "h57c9bdd3g0742g428eg881bg2cf81e0d2e79"
msgid "You <i>wouldn't</i>."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WarchiefGrumpy_AD_WithGuard
#. Speaker = Lookout Grush
#. NodeID = 584f1b58-5ab6-50b9-2fd5-cd5f6773c90e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 8a650cbb-db40-0a41-c4cd-c39338d01b55_B = True
#. SetFlags:
#.   Local:
#.     - 8a650cbb-db40-0a41-c4cd-c39338d01b55_A = False
#.     - 8a650cbb-db40-0a41-c4cd-c39338d01b55_B = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WarchiefGrumpy_AD_WithGuard:584f1b58-5ab6-50b9-2fd5-cd5f6773c90e
msgctxt "h2ffb1fc9g4827g4a21ga213gfea525d0d9f6"
msgid "'Ello, mate. How's the drow treatin' ya?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WarchiefGrumpy_AD_WithGuard
#. Speaker = Zurga
#. NodeID = 75e26792-efe0-ce34-012f-ca768031971a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WarchiefGrumpy_AD_WithGuard:75e26792-efe0-ce34-012f-ca768031971a
msgctxt "h096780afg0cb9g4189g949egeced603d7ce2"
msgid "Shite. Drow's getting impatient."
msgstr "썅. 드로우가 참을성을 잃고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WarchiefGrumpy_AD_WithGuard
#. Speaker = Zurga
#. NodeID = 808f0183-ce37-c998-2b4f-6aa13a2dfca2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WarchiefGrumpy_AD_WithGuard:808f0183-ce37-c998-2b4f-6aa13a2dfca2
msgctxt "hd284d837ge6a5g4040gb7a6gd9d25abae359"
msgid ""
"Your longpig started squealin' yet? Cos if you're drinkin', job must be done "
"- <i>yeah?</i>"
msgstr "그 길쭉이 돼지는 아직 안 불었냐? 술을 마시고 있는 걸 보면, 일이 끝난 거겠지. <i>안 그래?</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WarchiefGrumpy_AD_WithGuard
#. Speaker = Zurga
#. NodeID = 8fa815be-de95-810c-25ce-d4daea9571bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WarchiefGrumpy_AD_WithGuard:8fa815be-de95-810c-25ce-d4daea9571bf
msgctxt "hf0e89e2age375g43cag9076g642304c262fd"
msgid "I would. And I'd <i>enjoy</i> it."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WarchiefGrumpy_AD_WithGuard
#. Speaker = Zurga
#. NodeID = 909d9368-5084-caf8-96cd-4c89653bfd53
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WarchiefGrumpy_AD_WithGuard:909d9368-5084-caf8-96cd-4c89653bfd53
msgctxt "h03acc410gf429g4c5agb1c2g355cc30bee52"
msgid "Worse than you're treatin' that bloody prisoner. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WarchiefGrumpy_AD_WithGuard
#. Speaker = Zurga
#. NodeID = a447fec5-df3b-202d-75e5-c67f7d5d94f7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WarchiefGrumpy_AD_WithGuard:a447fec5-df3b-202d-75e5-c67f7d5d94f7
msgctxt "ha083ca28gac97g4c59ga2f1g6602c0c2050c"
msgid "Has he talked yet?"
msgstr "아직 안 불었나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WarchiefGrumpy_AD_WithGuard
#. Speaker = Zurga
#. NodeID = a4a046df-5776-79b3-4ed4-0565d78827f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WarchiefGrumpy_AD_WithGuard:a4a046df-5776-79b3-4ed4-0565d78827f4
msgctxt "h640343cagd678g4f14g92e8g446274907d35"
msgid ""
"That a fact? Hope so, for your sake - plenty of room next to the piggy if "
"you're lying."
msgstr "그렇단 말이지? 만약 거짓말을 하는 거라면, 돼지 녀석 옆에도 자리는 많으니 각오해라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WarchiefGrumpy_AD_WithGuard
#. Speaker = Lookout Grush
#. NodeID = bd9eaeb6-0feb-5e8d-a41b-270a2f84b45a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WarchiefGrumpy_AD_WithGuard:bd9eaeb6-0feb-5e8d-a41b-270a2f84b45a
msgctxt "h116f0f1cg85b3g4051g9edcg085d9a48eaa4"
msgid ""
"Yeah. Mostly he just says, 'Stop, argh, my guts are s'posed to be on the "
"<i>inside</i>'."
msgstr "그래요. 하는 소리라고는, '그만, 으악, 내장은 <i>안에</i> 그대로 둬주세요' 같은 소리밖에 없습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WarchiefGrumpy_AD_WithGuard
#. Speaker = Zurga
#. NodeID = d057aab1-588e-cf1b-b7a3-d92dd2931352
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 8a650cbb-db40-0a41-c4cd-c39338d01b55_A = True
#. SetFlags:
#.   Local:
#.     - 8a650cbb-db40-0a41-c4cd-c39338d01b55_B = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WarchiefGrumpy_AD_WithGuard:d057aab1-588e-cf1b-b7a3-d92dd2931352
msgctxt "h8b1e183cg3e80g4149gaf27gc569aef8cd16"
msgid "Oi - anythin' to report?"
msgstr "어이, 보고할 거 있나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WarchiefGrumpy_AD_WithGuard
#. Speaker = Lookout Grush
#. NodeID = e48537ca-6cd3-30c0-417c-ed444ab9c071
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WarchiefGrumpy_AD_WithGuard:e48537ca-6cd3-30c0-417c-ed444ab9c071
msgctxt "h8c08b21dg432eg4e17g9ab5g08d65abae2e6"
msgid "Ah, as good as, boss! Got a professional workin' on him right now."
msgstr "아, 끝난 거나 다름없습니다, 대장! 이제 진짜 전문가가 작업하는 중이죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WarchiefGrumpy_AD_WithGuard
#. Speaker = Zurga
#. NodeID = e9d3d6d3-5819-fcbe-3483-50c421944ecb
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 8a650cbb-db40-0a41-c4cd-c39338d01b55_A = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WarchiefGrumpy_AD_WithGuard:e9d3d6d3-5819-fcbe-3483-50c421944ecb
msgctxt "h40a2f5eag21b0g4babgabb1gc026cdef934e"
msgid "Drow says if the prisoner don't talk soon, I should cut yer arms off."
msgstr "드로우가 말하기를, 포로가 입을 열지 않으면 너희 팔을 잘라버리랬어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WarchiefGrumpy_AD_WithStoneRaiders
#. Speaker = Brawler Gurd
#. NodeID = 172fffae-d998-54ae-8133-762ee3684252
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WarchiefGrumpy_AD_WithStoneRaiders:172fffae-d998-54ae-8133-762ee3684252
msgctxt "he5bcb646g899dg4f2ag8a09g4ce9c6e376c6"
msgid "Proper nice that swamp was."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WarchiefGrumpy_AD_WithStoneRaiders
#. Speaker = Brawler Gurd
#. NodeID = 48afe0f2-7bd3-c225-4910-3ea3d2154185
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WarchiefGrumpy_AD_WithStoneRaiders:48afe0f2-7bd3-c225-4910-3ea3d2154185
msgctxt "hafbf5647gea5ag40c8gbb71ge905a0d4eda6"
msgid "Ain't been comfortable since we been here. I miss the swamp."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WarchiefGrumpy_AD_WithStoneRaiders
#. Speaker = Zurga
#. NodeID = b1e69e58-361c-0d25-3ac4-c3e1e22d0d0c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WarchiefGrumpy_AD_WithStoneRaiders:b1e69e58-361c-0d25-3ac4-c3e1e22d0d0c
msgctxt "hd1e21252g41a1g44bcg89fdg27cb6e194816"
msgid ""
"Don't get too comfortable, you 'orrible sacks of muck. Drow might need us "
"any time."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WolfPens_AD_BackupGroup
#. Speaker = Sharp-Eye Eef
#. NodeID = 1d8fbeb6-4827-fefe-c5b8-1e740ae25bb8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WolfPens_AD_BackupGroup:1d8fbeb6-4827-fefe-c5b8-1e740ae25bb8
msgctxt "hb007d8cag25d7g4f9dg9542g28d2d9dabc96"
msgid "Certainly won't be cuz of yer beautiful eyes."
msgstr "분명 네 아름다운 눈깔 때문은 아니겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WolfPens_AD_BackupGroup
#. Speaker = Sharp-Eye Nass
#. NodeID = 36652720-6835-62f4-10ec-1ebbb28a123d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WolfPens_AD_BackupGroup:36652720-6835-62f4-10ec-1ebbb28a123d
msgctxt "h373dad7dgadbcg4518g834ag14ae3e51f1f8"
msgid "They're <i>drow</i>. They're stuck-ups."
msgstr "<i>드로우</i> 놈들이 다 그렇지. 거만한 족속들. "

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WolfPens_AD_BackupGroup
#. Speaker = Sharp-Eye Eef
#. NodeID = 47a43851-1f0d-00f2-8ba0-4c88c7a0a5dc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 74a7efca-a8a8-981f-f907-42c54865f7c2_A = True
#.      - 74a7efca-a8a8-981f-f907-42c54865f7c2_B = False
#.      - 74a7efca-a8a8-981f-f907-42c54865f7c2_C = False
#. SetFlags:
#.   Local:
#.     - 74a7efca-a8a8-981f-f907-42c54865f7c2_B = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WolfPens_AD_BackupGroup:47a43851-1f0d-00f2-8ba0-4c88c7a0a5dc
msgctxt "h0dc4d113g3710g443cgab07g51b6800c4233"
msgid "D'you think the dwarf is ready yet? I'm hungry."
msgstr "그 드워프 녀석 아직 덜 요리됐나? 슬슬 배고픈데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WolfPens_AD_BackupGroup
#. Speaker = Sharp-Eye Neem
#. NodeID = 5cc24a17-f03d-bbc8-c208-7f0f1d4b1307
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WolfPens_AD_BackupGroup:5cc24a17-f03d-bbc8-c208-7f0f1d4b1307
msgctxt "h9a37ae07g2e96g4e7agb0adg10f882eec70c"
msgid ""
"What do they need to be lookin' at <i>any </i>of us for, is what I'm sayin'."
msgstr "내 말은, <i>누가 됐든</i> 우리를 감시할 이유가 있느냐는 거야. "

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WolfPens_AD_BackupGroup
#. Speaker = Sharp-Eye Eef
#. NodeID = 69ab8463-1f4e-0d65-dfa3-e229f6b6618a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 74a7efca-a8a8-981f-f907-42c54865f7c2_A = True
#.      - 74a7efca-a8a8-981f-f907-42c54865f7c2_B = True
#.      - 74a7efca-a8a8-981f-f907-42c54865f7c2_C = True
#. SetFlags:
#.   Local:
#.     - 74a7efca-a8a8-981f-f907-42c54865f7c2_A = False
#.     - 74a7efca-a8a8-981f-f907-42c54865f7c2_B = False
#.     - 74a7efca-a8a8-981f-f907-42c54865f7c2_C = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WolfPens_AD_BackupGroup:69ab8463-1f4e-0d65-dfa3-e229f6b6618a
msgctxt "hc5389496g7c3cg4c96g8eccgbd906315524c"
msgid "What are they delayin' for? Can't we just swarm the forest?"
msgstr "뭐 때문에 죽치고 있는 거지? 그냥 숲으로 몰려가면 안 되나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WolfPens_AD_BackupGroup
#. Speaker = Sharp-Eye Nass
#. NodeID = 85949658-274e-6363-3097-1274af39d7ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WolfPens_AD_BackupGroup:85949658-274e-6363-3097-1274af39d7ed
msgctxt "h919ec04agbfefg44b1ga15fg1c241000818d"
msgid ""
"Right. What would some drow wizard in Moonrise wanna look at <i>you </i>fer?"
msgstr "맞아. 문라이즈의 어떤 드로우 위저드가 <i>널</i> 지켜보고 싶어 할까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WolfPens_AD_BackupGroup
#. Speaker = Sharp-Eye Nass
#. NodeID = 92eb264c-29b1-dc8b-471a-d5cdb26ce1ba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WolfPens_AD_BackupGroup:92eb264c-29b1-dc8b-471a-d5cdb26ce1ba
msgctxt "h269a6daagf358g40d8gbc2fg69b35ccd6751"
msgid "Ignore 'em an' be happy they didn't throw ya to the spiders yet."
msgstr "그냥 무시해. 아직 거미 밥으로 던져지지 않은 걸 다행으로 여기라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WolfPens_AD_BackupGroup
#. Speaker = Sharp-Eye Neem
#. NodeID = afe5f265-dd8a-f458-df86-8171b50d44dd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 74a7efca-a8a8-981f-f907-42c54865f7c2_A = False
#.      - 74a7efca-a8a8-981f-f907-42c54865f7c2_B = False
#.      - 74a7efca-a8a8-981f-f907-42c54865f7c2_C = False
#. SetFlags:
#.   Local:
#.     - 74a7efca-a8a8-981f-f907-42c54865f7c2_A = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WolfPens_AD_BackupGroup:afe5f265-dd8a-f458-df86-8171b50d44dd
msgctxt "hae51467eg8db5g4a40gb2b5g59935f9fe70b"
msgid "I tell ya, the scryin' eye was lookin' at me all strange."
msgstr "장담하는데 저 수정 눈깔이 날 이상하게 쳐다 봤어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WolfPens_AD_BackupGroup
#. Speaker = Sharp-Eye Nass
#. NodeID = c0d8336b-82f3-b424-601c-bb011d6cce22
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WolfPens_AD_BackupGroup:c0d8336b-82f3-b424-601c-bb011d6cce22
msgctxt "he4f203a2g60a9g4d4cg84d5gcd8aa65c1735"
msgid "Drow wants to know exactly where those adventurers came from."
msgstr "우리 드로우께서 그 모험가 놈들이 어디서 왔는지 알아내고 싶으시단다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WolfPens_AD_BackupGroup
#. Speaker = Sharp-Eye Neem
#. NodeID = c468759e-1aee-2582-488e-f10936c43c02
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WolfPens_AD_BackupGroup:c468759e-1aee-2582-488e-f10936c43c02
msgctxt "h1be3592agb122g4ccfg882ag15901b2cc9ce"
msgid "What are they doin'? Hidin' in trees? We'll smoke 'em out no problem."
msgstr "뭐하는 놈들이길래? 나무에 숨기라도 했대? 연기로 태워버리면 그만이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WolfPens_AD_BackupGroup
#. Speaker = Sharp-Eye Nass
#. NodeID = e28e6b5b-ff30-49dc-a84e-b12424b44a73
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WolfPens_AD_BackupGroup:e28e6b5b-ff30-49dc-a84e-b12424b44a73
msgctxt "hd58543dfgb628g4d32g8e87g09cabdbec0c4"
msgid "Again? D'you <i>want </i>to become spider-food?"
msgstr "또냐? 거미 먹이라도 <i>되고 싶은</i> 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WolfPens_AD_BackupGroup
#. Speaker = Sharp-Eye Neem
#. NodeID = e76e2ed8-83a2-091e-20ec-4bcf9fc7a80e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WolfPens_AD_BackupGroup:e76e2ed8-83a2-091e-20ec-4bcf9fc7a80e
msgctxt "hfe467494gb64bg438eg8e0ag06b3aeabb66d"
msgid ""
"We're all on the same side. Not like we're gonna set the True Soul on fire."
msgstr "우린 다 같은 편이잖아. 우리가 참된 영혼을 태워 먹기라도 할 줄 아나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WolfPens_AD_BackupGroup
#. Speaker = Sharp-Eye Nass
#. NodeID = e8770336-3533-abb8-9f84-f3d7193ad499
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WolfPens_AD_BackupGroup:e8770336-3533-abb8-9f84-f3d7193ad499
msgctxt "hd82dc2f7g0149g4040g9b54g57b1cb11dea0"
msgid "Orders were to stand by here. No booze. No sneakin' off."
msgstr "여기서 대기하라는 명령이다. 술 마시거나 몰래 빠져나갈 생각 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WolfPens_AD_BackupGroup
#. Speaker = Sharp-Eye Neem
#. NodeID = f25834e8-c836-6a4f-d9d3-7d0b384bf83a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 74a7efca-a8a8-981f-f907-42c54865f7c2_A = True
#.      - 74a7efca-a8a8-981f-f907-42c54865f7c2_B = True
#.      - 74a7efca-a8a8-981f-f907-42c54865f7c2_C = False
#. SetFlags:
#.   Local:
#.     - 74a7efca-a8a8-981f-f907-42c54865f7c2_C = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WolfPens_AD_BackupGroup:f25834e8-c836-6a4f-d9d3-7d0b384bf83a
msgctxt "hee7dbde1ge872g4190ga49cgc0c4ddc07ca6"
msgid "I'm just sayin', those eyes..."
msgstr "그냥 하는 말인데, 저 눈깔들..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WolfPens_AD_BackupGroup
#. Speaker = Sharp-Eye Eef
#. NodeID = f523196e-700d-1fe4-9755-58a8c605b108
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WolfPens_AD_BackupGroup:f523196e-700d-1fe4-9755-58a8c605b108
msgctxt "ha3040cbbg1bdbg428ag8c52gca14b10616d4"
msgid "Gah. You're all borin'."
msgstr "쳇. 따분하게 굴기는."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WolfPens_AD_Beastmaster001
#. Speaker = Butcher Vrak
#. NodeID = faae651f-a1ed-47f2-f9ff-fc207b6ae117
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WolfPens_AD_Beastmaster001:faae651f-a1ed-47f2-f9ff-fc207b6ae117
msgctxt "h15ff0a2cg8a3bg4558ga52egead0a4648e9e"
msgid "Just get some big chunks, they can chew through the bones."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WolfPens_AD_Beastmaster001
#. Speaker = Butcher Vrak
#. NodeID = faae651f-a1ed-47f2-f9ff-fc207b6ae117
#. HandlePath = TaggedText[0].TagText[1]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WolfPens_AD_Beastmaster001:faae651f-a1ed-47f2-f9ff-fc207b6ae117
msgctxt "h057bdf2bg446fg429fga3b7gb6face6540c0"
msgid "I could get used to all these raids... an' especially all this meat."
msgstr "이런 습격에 익숙해질 수 있을 것 같아... 특히 고기가 많이 들어오니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WolfPens_AD_Beastmaster001_CommentOnPrisonersBody
#. Speaker = Butcher Vrak
#. NodeID = 3cebe5fe-9eba-a477-40fa-bc807689ff6d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - dab5de6f-98f7-c552-9e81-56c090d5ed6e_A = True
#. SetFlags:
#.   Local:
#.     - dab5de6f-98f7-c552-9e81-56c090d5ed6e_A = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WolfPens_AD_Beastmaster001_CommentOnPrisonersBody:3cebe5fe-9eba-a477-40fa-bc807689ff6d
msgctxt "hd094bb49gb3ffg4816g9173g40b44e738271"
msgid "Couldn't he just stay a bear? Pelt'd make a nice rug."
msgstr "그냥 곰으로 있지 그랬냐? 곰 가죽 카펫이 가지고 싶었는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WolfPens_AD_Beastmaster001_CommentOnPrisonersBody
#. Speaker = Butcher Vrak
#. NodeID = 55092a5a-1145-922c-bb9d-03e25103ce96
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - dab5de6f-98f7-c552-9e81-56c090d5ed6e_A = False
#. SetFlags:
#.   Local:
#.     - dab5de6f-98f7-c552-9e81-56c090d5ed6e_A = True
