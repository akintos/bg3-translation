#. SetFlags:
#.   Local:
#.     - 12c3bf70-6622-e9db-0f6a-7ed590fd0039_P2 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD:83d56de8-d74a-e21c-cbd0-e61aebeb73b5
msgctxt "h39a1e6bbge44fg4b36gbcaeg0cfec1894052"
msgid "How long until Rolan shows off his Thunderwave?"
msgstr "롤란이 또 언제 자기 천둥파 자랑해댈까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD
#. Speaker = Rolan
#. NodeID = 9b0a3031-c227-2e93-5590-fb62612ef181
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Prodigy_State_Staying = True
#.      - DEN_Prodigy_State_Leaving = False
#.   Local:
#.      - 12c3bf70-6622-e9db-0f6a-7ed590fd0039_P2 = True
#. SetFlags:
#.   Local:
#.     - 12c3bf70-6622-e9db-0f6a-7ed590fd0039_P2 = False
#.     - 12c3bf70-6622-e9db-0f6a-7ed590fd0039_P1 = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD:9b0a3031-c227-2e93-5590-fb62612ef181
msgctxt "h54236495g992ag4dd5gbcc9gaee716bc1a96"
msgid "I'd die if I met Lorroakan reeking of this place."
msgstr "여기 냄새 풍기는 채로 로로아칸 만나느니 죽고 말지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD
#. Speaker = Cal
#. NodeID = 9eb36ac1-32a7-9830-dcb6-2c62d3e69893
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Prodigy_State_Staying = True
#.      - DEN_Prodigy_State_Leaving = False
#.   Local:
#.      - 12c3bf70-6622-e9db-0f6a-7ed590fd0039_P1 = False
#. SetFlags:
#.   Local:
#.     - 12c3bf70-6622-e9db-0f6a-7ed590fd0039_P1 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD:9eb36ac1-32a7-9830-dcb6-2c62d3e69893
msgctxt "he3a51307g6565g4b6cgb225g13dab080ca91"
msgid "Don't be grumpy, Rolan. We'll get to the city soon."
msgstr "심술내지 마, 롤란. 금방 도시에 갈 수 있을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD
#. Speaker = Cal
#. NodeID = a773588b-3099-ebe3-c391-91cf232fbcfc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD:a773588b-3099-ebe3-c391-91cf232fbcfc
msgctxt "hde40c862g1f97g4e17g8deag82aa289b5df2"
msgid "Drinks on Rolan? Count me in."
msgstr "롤란이 술 쏠 거래? 나도 끼워줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD
#. Speaker = Rolan
#. NodeID = c0295ba7-6a86-9202-e5a7-9ba07f17a4ab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD:c0295ba7-6a86-9202-e5a7-9ba07f17a4ab
msgctxt "h3ec00450g5c6dg4a64g88fdg17c35eabde64"
msgid "I care about our lives. Our futures."
msgstr "내게 중한 건 우리 목숨이야. 우리 미래랑."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD
#. Speaker = Lia
#. NodeID = c2835bfd-5d9a-11eb-b9aa-592a3943e8bd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD:c2835bfd-5d9a-11eb-b9aa-592a3943e8bd
msgctxt "h246843e7ga88bg4886g8e25g3037f9da21b1"
msgid "I <i>will </i>punch you in the throat, Rolan."
msgstr "너 그러다 니 목젖에 주먹 꽂힌다, 롤란."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD
#. Speaker = Lia
#. NodeID = c3f8be89-43d9-62e5-4d57-e0b4f35aef89
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD:c3f8be89-43d9-62e5-4d57-e0b4f35aef89
msgctxt "h100e981dga1f5g4563g912cgb03cbd08cccd"
msgid "No. You just care about your stupid apprenticeship."
msgstr "아니. 네게 중한 건 그 멍청한 견습 기회 뿐이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD
#. Speaker = Cal
#. NodeID = cc2a61a9-4b6d-35c9-7871-eb85b43639ce
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Prodigy_State_Staying = False
#.      - DEN_Prodigy_State_Leaving = False
#.   Local:
#.      - 12c3bf70-6622-e9db-0f6a-7ed590fd0039_P2 = True
#. SetFlags:
#.   Local:
#.     - 12c3bf70-6622-e9db-0f6a-7ed590fd0039_P2 = False
#.     - 12c3bf70-6622-e9db-0f6a-7ed590fd0039_P1 = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD:cc2a61a9-4b6d-35c9-7871-eb85b43639ce
msgctxt "h662f39a5g83cfg427fgb3c7g289ec77aec03"
msgid "Calm down! <i>Please.</i>"
msgstr "진정들 좀 해! <i>제발.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD
#. Speaker = Lia
#. NodeID = cd6d43e5-141e-0b4c-d45f-431f96a0454b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD:cd6d43e5-141e-0b4c-d45f-431f96a0454b
msgctxt "h3708ac02gb136g4f73gb970g03bfc9083238"
msgid "*Sigh.*"
msgstr "*하아.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD
#. Speaker = Lia
#. NodeID = cf9d1f3e-8325-9df8-b51e-37be00ab0e13
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Prodigy_State_Staying = False
#.      - DEN_Prodigy_State_Leaving = True
#.   Local:
#.      - 12c3bf70-6622-e9db-0f6a-7ed590fd0039_P1 = True
#. SetFlags:
#.   Local:
#.     - 12c3bf70-6622-e9db-0f6a-7ed590fd0039_P2 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD:cf9d1f3e-8325-9df8-b51e-37be00ab0e13
msgctxt "hf6ddafd8gf5aeg4308g8410g6222ebd2d2c8"
msgid "Stay close to me out there."
msgstr "밖에 나서면 나한테 꼭 붙어 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD
#. Speaker = Lia
#. NodeID = da7163b2-ad06-23d7-7c8a-ac60947d7056
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD:da7163b2-ad06-23d7-7c8a-ac60947d7056
msgctxt "h638b6acagb64bg4a52gbad0g538ede422153"
msgid "So long as you're paying."
msgstr "네가 쏜다면야 얼마든지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD
#. Speaker = Cal
#. NodeID = e0e896ce-838f-0c3f-bcc6-7c1593b77dda
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD:e0e896ce-838f-0c3f-bcc6-7c1593b77dda
msgctxt "h2ff1e12eg6b91g4d82gb832ga0d6a2d8b7d1"
msgid "Hah! True."
msgstr "하! 그러네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD
#. Speaker = Rolan
#. NodeID = f74589dd-ace6-1def-cbb3-6611932c2eef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD:f74589dd-ace6-1def-cbb3-6611932c2eef
msgctxt "h73325238g0e22g415bg85cdg8e5190d67153"
msgid "Take that back! Right now!"
msgstr "그 말 취소해! 당장!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Brother
#. Speaker = Cal
#. NodeID = 078f9577-c2ef-db19-9959-afa0551731b8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Prodigy_HasMet_Brother(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_Prodigy_HasMet_Brother(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Brother:078f9577-c2ef-db19-9959-afa0551731b8
msgctxt "h31d80e43g180bg4fabgb2a7gd7e06b78bfdc"
msgid ""
"Lia and Rolan would never admit it, but they'd take an arrow for the other. "
"Also stab each other. Not sure what'll come first."
msgstr ""
"리아랑 롤란 둘 다 절대 인정 안 하겠지만, 이 녀석들은 서로를 위해서라면 화살도 대신 맞을 거야. 뭐 등에 칼을 꽂을지도 모르겠지만. "
"뭐가 먼저 일어날진 모르겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Brother
#. Speaker = Cal
#. NodeID = b5faa91e-04fe-9d7d-7df7-ac8c02bec0a2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Brother:b5faa91e-04fe-9d7d-7df7-ac8c02bec0a2
msgctxt "hff8a9acag87b9g4953ga8e8g9a37b878c41e"
msgid ""
"Thanks for cutting in - there might have been more than words if you hadn't."
msgstr "끼어들어 줘서 고마워. 당신이 중재해 주지 않았다면 주먹다짐이 일어났을지도 몰라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Brother
#. Speaker = Cal
#. NodeID = c17fb467-f4fd-c5bf-7c9c-66bc88be8ffa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Prodigy_HasMet_Brother(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Brother:c17fb467-f4fd-c5bf-7c9c-66bc88be8ffa
msgctxt "h3ed79cb7g8506g4473ga3f8g2462f9ff78ac"
msgid "Here's hoping we all make it in one piece."
msgstr "그저 우리 모두 안전하길 바라는 것뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Dead
#. Speaker = Player
#. NodeID = 09615ec0-8f3f-47cb-b668-950c63fd900c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Dead:09615ec0-8f3f-47cb-b668-950c63fd900c
msgctxt "h03d93ef3g0178g4ca2g8279ge9c1ead863e8"
msgid "Where are you from?"
msgstr "어디서 왔지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Dead
#. Speaker = Rolan
#. NodeID = 0b7a42f8-ed74-e20b-6a05-902c771fdc7d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Dead:0b7a42f8-ed74-e20b-6a05-902c771fdc7d
msgctxt "hca15ce36gdb56g43a6gb93eg26acc871c9e4"
msgid "They are... brother and sister. Cal says... I am family, but..."
msgstr "그 둘은 남매야... 칼은... 내가 가족이라고 하지만..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Dead
#. Speaker = Player
#. NodeID = 14d7155c-31a3-478b-a229-7eff0e1cc99b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Local:
#.     - 29d44d61-53f3-ec7d-2d37-92f73bb6a49f_Lorroakan = True
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Dead:14d7155c-31a3-478b-a229-7eff0e1cc99b
msgctxt "h625beabbgbd4eg4309g80d3g67c501072ccf"
msgid "Where were you going?"
msgstr "어디로 가고 있었지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Dead
#. Speaker = Rolan
#. NodeID = 16105011-de34-3427-ab88-93f70ed36587
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Dead:16105011-de34-3427-ab88-93f70ed36587
msgctxt "h559c0e1fga4dcg47dcg9061gbbf2cb596945"
msgid "My... training... must get to... Lorroakan."
msgstr "내... 훈련... 가야만 해... 로로아칸에게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Dead
#. Speaker = Player
#. NodeID = 17072780-9d00-45ac-b457-cbf8a79859b6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Dead:17072780-9d00-45ac-b457-cbf8a79859b6
msgctxt "hf6733d0egf48bg4566gb720g236fcdfedbe6"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Dead
#. Speaker = Player
#. NodeID = 2986bdec-3f1f-e841-35e7-b29396f83560
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 29d44d61-53f3-ec7d-2d37-92f73bb6a49f_Lorroakan = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Dead:2986bdec-3f1f-e841-35e7-b29396f83560
msgctxt "h531d1cbbg1bbfg47efgb24cgb634e644ac8e"
msgid "What is so important about Lorroakan?"
msgstr "로로아칸이 뭐가 그렇게 중요한 건데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Dead
#. Speaker = Rolan
#. NodeID = 344ff707-8a67-ee7d-5c39-0f397b8a7b97
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Dead:344ff707-8a67-ee7d-5c39-0f397b8a7b97
msgctxt "h9697c2d6g52bcg45f7g8f36g9c1acaea826d"
msgid "<i>Everything. </i>He'll make me... greatest wizard... in Faerûn."
msgstr "<i>전부 다. </i>나를... 페이룬... 최강의 위저드로... 만들어 줄 거야..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Dead
#. Speaker = Rolan
#. NodeID = 3c389c2f-4ee7-f5fa-31a5-0294e6444896
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Dead:3c389c2f-4ee7-f5fa-31a5-0294e6444896
msgctxt "h0bd59878g2771g43e5g9048g9e3f63219cbc"
msgid ""
"With Lia... and Cal. They are brother and sister. But I am... not blood."
msgstr "리아와... 칼... 그 둘은 남매고. 나는... 피 섞이지 않았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Dead
#. Speaker = Rolan
#. NodeID = 4799a31c-ea19-4557-9f57-d76f798ecee6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Dead:4799a31c-ea19-4557-9f57-d76f798ecee6
msgctxt "h38166df9g60d9g4681g94bege238030764c9"
msgid "To Baldur's Gate... to Lorroakan... my destiny."
msgstr "발더스 게이트로... 로로아칸에게로... 내 운명을 향해서..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Dead
#. Speaker = Player
#. NodeID = 66444ae8-f0b0-982e-79d7-a1ffa83eaf31
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 29d44d61-53f3-ec7d-2d37-92f73bb6a49f_Family = True
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Dead:66444ae8-f0b0-982e-79d7-a1ffa83eaf31
msgctxt "he29bc3e8g033bg4fd1g84eag92ca26d90537"
msgid "Do you have any family?"
msgstr "가족이 있나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Dead
#. Speaker = Player
#. NodeID = 6f12bac5-e237-0047-c33d-24c93d129ee7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 29d44d61-53f3-ec7d-2d37-92f73bb6a49f_Finish = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Local:
#.     - 29d44d61-53f3-ec7d-2d37-92f73bb6a49f_Lorroakan = True
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Dead:6f12bac5-e237-0047-c33d-24c93d129ee7
msgctxt "h6f6c46a8g4e42g4dcegb727g65aff3f4fc69"
msgid "Finish what?"
msgstr "끝내다니, 뭐를?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Dead
#. Speaker = Player
#. NodeID = 8d6cbdee-90c4-17dd-86a8-6ad1fc8930e9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Prodigy_State_ArgumentDone = False
#.   Local:
#.      - 29d44d61-53f3-ec7d-2d37-92f73bb6a49f_Family = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Dead:8d6cbdee-90c4-17dd-86a8-6ad1fc8930e9
msgctxt "hec241514gad4eg48bfgb9dcg28cc5af209f7"
msgid "Did you come here alone?"
msgstr "여기엔 혼자 왔나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Dead
#. Speaker = Player
#. NodeID = a5f6bf32-66d2-4912-a306-bf06cc093eae
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Local:
#.     - 29d44d61-53f3-ec7d-2d37-92f73bb6a49f_Finish = True
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Dead:a5f6bf32-66d2-4912-a306-bf06cc093eae
msgctxt "h33fd0b26g6a4fg4c9dg8e20g33d0324ba870"
msgid "How did you die?"
msgstr "어떻게 죽었지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Dead
#. Speaker = Rolan
#. NodeID = ace84856-d21b-4d98-a153-96dcf04d6124
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Dead:ace84856-d21b-4d98-a153-96dcf04d6124
msgctxt "hbd8d51c6gfb06g4624gb3edgc97d3c2eec02"
msgid "The city that... survived Hell."
msgstr "지옥에서 살아남은... 그 도시..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Dead
#. Speaker = Rolan
#. NodeID = ce3bec01-6f12-4205-9577-5c8a050f9072
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Dead:ce3bec01-6f12-4205-9577-5c8a050f9072
msgctxt "h5948005egd89eg4f62g9142g930fe5fd3aaf"
msgid "Rolan. Just... Rolan."
msgstr "롤란. 그냥... 롤란."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Dead
#. Speaker = Narrator
#. NodeID = daa19c5d-650f-4da6-880f-7bdd4ac6a071
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Dead:daa19c5d-650f-4da6-880f-7bdd4ac6a071
msgctxt "hfc09ec57g0961g4126ga8bag120a25156ccc"
msgid "*The corpse does not stir. It will answer no more questions.*"
msgstr "*시체는 움직이지 않습니다. 더 이상 질문을 받지 않을 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Dead
#. Speaker = Narrator
#. NodeID = de3bb1ac-1ede-48a9-bb7c-d95b7b337961
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Dead:de3bb1ac-1ede-48a9-bb7c-d95b7b337961
msgctxt "hfbc6a9a9gfc4cg490dgb37dgab6e3b2e0fee"
msgid "*The corpse regards you lifelessly.*"
msgstr "*시체가 생기 없는 모습으로 당신을 맞이합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Dead
#. Speaker = Player
#. NodeID = e1ed81c0-3332-057d-3a3e-ff9abfd7259e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Prodigy_State_ArgumentDone = True
#.   Local:
#.      - 29d44d61-53f3-ec7d-2d37-92f73bb6a49f_Family = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Dead:e1ed81c0-3332-057d-3a3e-ff9abfd7259e
msgctxt "h828b7bcegc45ag4fd0g8f20gc97c0418dbf8"
msgid "No family? What about Lia and Cal?"
msgstr "가족이 없다고? 리아와 칼은 뭔데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Dead
#. Speaker = Rolan
#. NodeID = e6c6cb04-ef94-3cff-5194-53fbdd4fb7a9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Dead:e6c6cb04-ef94-3cff-5194-53fbdd4fb7a9
msgctxt "hbb33fd73g749fg4575ga78egdbcd52e2decc"
msgid "No... family... no one."
msgstr "없어... 가족... 아무도 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Dead
#. Speaker = Player
#. NodeID = e93b010a-4204-4df0-82e2-234c7efdda9d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Dead:e93b010a-4204-4df0-82e2-234c7efdda9d
msgctxt "h305a4b8bgf67dg46e0g8f8bgf1f55ae5462e"
msgid "What's your name?"
msgstr "네 이름이 뭐지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Dead
#. Speaker = Rolan
#. NodeID = edab6983-d9a3-49b9-8a22-028b30f96d40
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Dead:edab6983-d9a3-49b9-8a22-028b30f96d40
msgctxt "he9787f71gf713g41ceg81d0g28eaf4d73c89"
msgid "Too fast but... can't be. Must finish..."
msgstr "너무 빨리 당했어... 그럴 수는 없어... 끝내야만 해..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Dead
#. Speaker = Narrator
#. NodeID = eed0c286-64cf-4fb1-a26e-fb06ecbaa94a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Dead:eed0c286-64cf-4fb1-a26e-fb06ecbaa94a
msgctxt "he4d2154dg6f88g46e1g9781g2657208428e9"
msgid "*The spell's power wanes. You can ask no more questions.*"
msgstr "*주문의 힘이 약해집니다. 더 이상 질문을 할 수 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Dead
#. Speaker = Narrator
#. NodeID = f6d7f741-5bd4-4aab-bb8b-fd7aa903f0c8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_Killer(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Dead:f6d7f741-5bd4-4aab-bb8b-fd7aa903f0c8
msgctxt "hae9d0f96g5d0eg4c7dgacbfg1318c45a8385"
msgid "*The corpse seems willing to speak - but not to its killer.*"
msgstr "*시체는 말할 의지가 있지만, 자신을 죽인 자와 대화하고 싶지는 않은 듯 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group
#. Speaker = Player
#. NodeID = 015e1594-eee8-1ae9-84f5-d803a1d92093
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_Prodigy_Event_ToldToLeave(3) = True
#. TagRule: CLERIC_EVIL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group:015e1594-eee8-1ae9-84f5-d803a1d92093
msgctxt "hd51cdb70g2a4fg41a7ga425g3e7fe9cce794"
msgid "Why die for those who can't defend themselves?"
msgstr "왜 제 한 몸 지킬 줄도 모르는 자들을 위해 목숨을 바쳐야 하지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group
#. Speaker = Player
#. NodeID = 05c69b7a-9a11-cceb-4513-af4ab5eeb4db
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DRAGONBORN(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group:05c69b7a-9a11-cceb-4513-af4ab5eeb4db
msgctxt "hd7295ba6g865fg49e5ga5cbge694f8e04ec7"
msgid "Clan is everything. You don't abandon those you swore to protect."
msgstr "일족은 전부인 법이야. 네가 지키기로 맹세한 이들을 저버려선 안 되지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group
#. Speaker = Lia
#. NodeID = 16088c72-48f3-8217-37da-3cc48cfa934e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group:16088c72-48f3-8217-37da-3cc48cfa934e
msgctxt "ha7bb0e38g199fg4b1egab7ag7a5baf558a69"
msgid "Hells, we can't just leave. They're <i>kin. </i>"
msgstr "망할, 그냥 떠날 순 없어. 우리 <i>동족이잖아. </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group
#. Speaker = Rolan
#. NodeID = 171c07c3-8b2e-51f5-f26a-1d8cd392f900
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group:171c07c3-8b2e-51f5-f26a-1d8cd392f900
msgctxt "h0d61777ege5c5g4b8bga97cg036e41cb73a9"
msgid ""
"Or would you deny your brother here his chance at fortune in Baldur's Gate?"
msgstr "아니면 혹시 이 오라버니가 발더스 게이트에서 한몫 잡을 기회를 망칠 심산인 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group
#. Speaker = Cal
#. NodeID = 1c75a3c4-e8eb-1de6-f287-aee9b4e99131
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group:1c75a3c4-e8eb-1de6-f287-aee9b4e99131
msgctxt "h867271f6g4bbbg47cega60cg0802a195102d"
msgid "Rolan's right, sis. We should leave - while we still can."
msgstr "롤란 말이 맞아, 누나. 아직 늦지 않았을 때 떠나야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group
#. Speaker = Rolan
#. NodeID = 2c1ecda2-7df1-1c1c-f1f5-8ea84bfcaa61
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group:2c1ecda2-7df1-1c1c-f1f5-8ea84bfcaa61
msgctxt "h1e15e748g43e3g47ffgb45eg4616b3d43e9d"
msgid "If we survive, it'll make for a good story I suppose..."
msgstr "살아남는다면, 쓸 만한 이야깃감이 될 순 있겠지..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group
#. Speaker = Player
#. NodeID = 2c718e07-4463-a033-2f84-f4ea98cde671
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(3) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Prodigy_Event_ToldToLeave(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group:2c718e07-4463-a033-2f84-f4ea98cde671
msgctxt "h455d22e9gb7edg47f0g8e61g015e185dd560"
msgid "If they cannot fight, they will die. That is as it should be."
msgstr "싸울 능력이 없는 자는 죽는 거지. 그건 당연한 섭리야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group
#. Speaker = Cal
#. NodeID = 2d4a9c7e-038d-39ba-8e20-b16ab2ad3c40
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group:2d4a9c7e-038d-39ba-8e20-b16ab2ad3c40
msgctxt "hd05aa6aeg3f98g4963g86e3g1ed8bf64f2a4"
msgid "Can we all just take a moment? Please?"
msgstr "우리 잠깐이라도 차분하게 얘기 나누면 안 돼?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group
#. Speaker = Rolan
#. NodeID = 3a46d01a-87cc-0b8b-61a7-268b33086c8f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group:3a46d01a-87cc-0b8b-61a7-268b33086c8f
msgctxt "h388a45c5ge15ag4caag8a97gfb62897168d7"
msgid "No. This place is a death trap. Let us leave - immediately!"
msgstr "아니. 여긴 묫자리나 다름없어. 우린 떠나야 해, 당장!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group
#. Speaker = Rolan
#. NodeID = 4b6de5c0-c9e8-4032-4014-d2ca4db874d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group:4b6de5c0-c9e8-4032-4014-d2ca4db874d6
msgctxt "h4704a41bgd865g4583ga82ag2196de3a2616"
msgid "<i>Zurgan. </i>Fine. Give it here."
msgstr "<i>저르간. </i> 좋아. 이리 내놔."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group
#. Speaker = Rolan
#. NodeID = 593f61fc-5074-f3e1-a91c-71cd910d1fd5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group:593f61fc-5074-f3e1-a91c-71cd910d1fd5
msgctxt "h5f824806ga8b4g4bb5g8cdfgb58369c3d53a"
msgid "How <i>dare </i>you!"
msgstr "네가 뭔데 <i>감히</i>!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group
#. Speaker = Lia
#. NodeID = 5fac3382-11f0-22c8-8870-b76dd10181e0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Prodigy_State_Staying = True
#.     - DEN_Prodigy_State_ArgumentDone = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group:5fac3382-11f0-22c8-8870-b76dd10181e0
msgctxt "h1bc2b0aagb559g4887gb4abg3c85c4a44f17"
msgid "Thank you, Rolan. And thank you, friend."
msgstr "고마워, 롤란. 그쪽도 고맙고, 친구."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group
#. Speaker = Lia
#. NodeID = 635afef8-5cce-76a4-d8ce-f38a1e850900
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group:635afef8-5cce-76a4-d8ce-f38a1e850900
msgctxt "h94041d9eg8cc3g4706ga1b8g6f9870f46dad"
msgid ""
"You know, that money could go towards a spiffy new outfit for your "
"apprenticeship...?"
msgstr "저 돈이면 너 견습 시작할 때 입을 근사한 새 옷 한 벌 장만할 수 있을 거 같은데...?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group
#. Speaker = Lia
#. NodeID = 638c40f8-8c9e-f9dc-cb1b-ba38beacf6a8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Prodigy_State_Staying = True
#.     - DEN_Prodigy_State_ArgumentDone = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group:638c40f8-8c9e-f9dc-cb1b-ba38beacf6a8
msgctxt "ha05982b9g838dg4214gb129g0d8e83fb2bde"
msgid "Thank you, Rolan."
msgstr "고마워 롤란."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group
#. Speaker = Lia
#. NodeID = 6955fc0f-d073-c6b9-c50c-cdea1059d8bb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group:6955fc0f-d073-c6b9-c50c-cdea1059d8bb
msgctxt "hb56f779bg49afg46f0g8a37gbce5a664bc99"
msgid ""
"Just be responsible for yourself then. We have to stay; it's the right thing "
"to do."
msgstr "그럼 너 자신에게 책임을 다하라고. 우린 여기 남아야 해. 그게 옳은 일이니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group
#. Speaker = Player
#. NodeID = 6ab36819-9dbd-910b-466c-a6f71212751b
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group:6ab36819-9dbd-910b-466c-a6f71212751b
msgctxt "h8e1ab409g09a2g44adgaed6gda118889a2c7"
msgid "You should all stay. A single blade could make a difference."
msgstr "다들 남아야 해. 칼 한 자루 보태지는 거에 상황이 바뀔 수도 있다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group
#. Speaker = Rolan
#. NodeID = 79368396-9685-e7a1-f87e-3a50a972e1c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group:79368396-9685-e7a1-f87e-3a50a972e1c0
msgctxt "h32bb499dgaa56g4313gaa53ge6ac5a281f95"
msgid "Common sense at last. Let's get out of this death trap."
msgstr "상식인이 드디어 나타났군. 이만 이 망할 묫자리를 빠져나가자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group
#. Speaker = Lia
#. NodeID = 7cedde74-f2ff-692a-a204-b28d2d2dd70d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group:7cedde74-f2ff-692a-a204-b28d2d2dd70d
msgctxt "h121d37afgb752g4541g944fg3d71cdf204ad"
msgid "These people aren't fighters. We can <i>help. </i>"
msgstr "이 사람들은 전사가 아니라고. 우린 <i>도움</i>이 될 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group
#. Speaker = Rolan
#. NodeID = 7d6a45d7-2ef4-8ff5-b4ca-93a167e68544
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group:7d6a45d7-2ef4-8ff5-b4ca-93a167e68544
msgctxt "h5821cec8gf355g422cgb564gf6a06a6dc2b7"
msgid ""
"What? The dangers of overpriced taverns and muddy streets? I think I'll take "
"that risk."
msgstr "위험? 바가지 씌우는 주점이나 진흙투성이 도로 같은 거? 그쯤은 얼마든지 감수해주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group
#. Speaker = Player
#. NodeID = 8685dc0a-2098-a567-c02c-b5719a52258c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Prodigy_State_Leaving = True
#.     - DEN_Prodigy_State_ArgumentDone = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group:8685dc0a-2098-a567-c02c-b5719a52258c
msgctxt "hb5301fc3gb087g437fg9fbfg2ed4b4d67215"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group
#. Speaker = Rolan
#. NodeID = 8fa3cece-7e34-63c5-ca3d-5027bc994585
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group:8fa3cece-7e34-63c5-ca3d-5027bc994585
msgctxt "h3721c5eaga8e2g437fg890eg7fd9531b69a9"
msgid ""
"Exactly! These types <i>always </i>need saving. We shouldn't sacrifice "
"ourselves for them."
msgstr "내 말이! 이런 자들은 <i>늘 </i> 남의 도움이 필요해. 그런 작자들 때문에 우리가 희생할 의무는 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group
#. Speaker = Player
#. NodeID = 91d09614-fa4c-6125-afcc-41ca4364f621
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group:91d09614-fa4c-6125-afcc-41ca4364f621
msgctxt "h7939e475gc7d7g4873g9aebg5bf79a0c8216"
msgid "<i>Say nothing.</i>"
msgstr "<i>아무 말도 하지 않는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group
#. Speaker = Rolan
#. NodeID = 96f00ce7-c298-0309-b3f7-49abfe9a5282
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group:96f00ce7-c298-0309-b3f7-49abfe9a5282
msgctxt "hec627dc8gfb47g45eag8be4g83038572013b"
msgid ""
"I made no such oath, and I will <i>not</i> be held responsible for these "
"people."
msgstr "그딴 맹세는 한 적도 없고, 저 사람들을 위해 책임을 질 생각 따위도 <i>없어</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group
#. Speaker = Lia
#. NodeID = 9b90a6dd-ebe5-7c60-4feb-1d7613a4f67d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - HIDDEN_WLD_Boosters.DEN_Prodigy_Persuaded(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group:9b90a6dd-ebe5-7c60-4feb-1d7613a4f67d
msgctxt "haf6dc7cag98d2g47e7ga9e7gda4b8da88c66"
msgid "Thank you! It's the right thing to do, and you know it."
msgstr "고마워! 남는 게 옳은 일이라는 거 너도 알 거 아냐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group
#. Speaker = Player
#. NodeID = 9c2c0c7b-93bb-537e-9645-5b70b16a0fb1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - MONK(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group:9c2c0c7b-93bb-537e-9645-5b70b16a0fb1
msgctxt "h8f1fb5d6g10ddg4e84gbeceg64c291237cde"
msgid ""
"To leave is a heavy choice - it will weigh on whatever path you walk next."
msgstr "떠나는 걸 가벼이 여기지 마. 앞으로 어떤 길을 걷게 되든 그 선택의 무게를 짊어져야 할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group
#. Speaker = Cal
#. NodeID = 9d2b5f6a-c8bb-1f39-0166-e3a511a30b02
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group:9d2b5f6a-c8bb-1f39-0166-e3a511a30b02
msgctxt "he5ae0c07g54cdg4d47gab33gc5811c0bb0aa"
msgid "C'mon, sis. We're less of a target alone. We should leave."
msgstr "그래, 누나. 우린 다함께 다녀야 안전하다고. 여길 떠나야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group
#. Speaker = Lia
#. NodeID = 9dff96bb-713d-b59e-8c0f-e126761fb92a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group:9dff96bb-713d-b59e-8c0f-e126761fb92a
msgctxt "h062544fegad94g4fb8gb7c1g7f3c8ee004ef"
msgid ""
"Just like I was saying. I don't want all these lives on my conscience. We "
"need to stay."
msgstr "내 말이 그 말이라니까. 난 수많은 목숨을 저버렸단 가책을 받고 싶지 않아. 우린 남아야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group
#. Speaker = Rolan
#. NodeID = a02f0efc-fcd7-aae4-7d73-92bf8b9973d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group:a02f0efc-fcd7-aae4-7d73-92bf8b9973d8
msgctxt "h770187c8g4ebeg479fg9da6g374e0812afd3"
msgid "Exactly! Hear that, Lia? We're not helping anyone if we're corpses."
msgstr "내 말이! 들었어, 리아? 이런 일에 죽어나가면 아무한테도 득이 안 된다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group
#. Speaker = Lia
#. NodeID = a8be01a2-3f3d-0afb-574a-f1889750cd30
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group:a8be01a2-3f3d-0afb-574a-f1889750cd30
msgctxt "hac202606ga81dg436eg983ag7e5e5090492c"
msgid "The city's not going anywhere. I'm staying - we're needed here."
msgstr "도시가 어디로 새는 건 아니잖아. 난 남을 거야. 여긴 우리 힘이 필요해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group
#. Speaker = Rolan
#. NodeID = a9592c4c-5326-89de-1f22-23b433a22c23
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group:a9592c4c-5326-89de-1f22-23b433a22c23
msgctxt "h0dffbbddgd361g4d11ga397g00d79cc87dc3"
msgid ""
"<i>Zurgan. </i>Fine. I'll stay too. Lest you both end up with your throats "
"slit by a goblin blade."
msgstr "<i>저르간. </i>좋아. 나도 남겠어. 그냥 갔다간 니들 둘 다 고블린 칼에 목이 썰려버릴 게 뻔하니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group
#. Speaker = Player
#. NodeID = aa006005-aa01-9476-da09-a9bdfbb5e870
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_TIEFLING(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group:aa006005-aa01-9476-da09-a9bdfbb5e870
msgctxt "h9f9fb70agab56g46bagb581g9b1456b7765a"
msgid ""
"Have you forgotten Elturel? We should stand by our people - no one else will."
msgstr "엘투렐 일을 잊은 거야? 우리는 동족끼리 뭉쳐야 해. 서로 외엔 도울 이가 없다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group
#. Speaker = Rolan
#. NodeID = ab147cc5-dc93-0c7b-220e-6cf9b49d191b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - HIDDEN_WLD_Boosters.DEN_Prodigy_Persuaded(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group:ab147cc5-dc93-0c7b-220e-6cf9b49d191b
msgctxt "hcd778c09g359eg4b73g9b0dg394acee91aa1"
msgid ""
"<i>Zurgan</i>. Fine! We'll stay. If we survive, it'll make for a good story "
"I suppose..."
msgstr "<i>저르간</i>. 좋아! 여기 남자고. 살아남는다면, 쓸 만한 이야깃감이 될 순 있겠지..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group
#. Speaker = Player
#. NodeID = ab7a5e3a-159a-8710-d00a-35107abec68e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group:ab7a5e3a-159a-8710-d00a-35107abec68e
msgctxt "hc1491b4ag4d00g42dcg8cefga681f72158a6"
msgid "Only cowards run from a fight."
msgstr "싸움에서 도망치는 건 겁쟁이뿐이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group
#. Speaker = Player
#. NodeID = c37c93f7-d7b6-e902-2eaf-e3ba9373a896
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_Prodigy_Event_ToldToLeave(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group:c37c93f7-d7b6-e902-2eaf-e3ba9373a896
msgctxt "h7919699cg6704g4e75g9623g189adeb88218"
msgid "Get out while you can - the goblins will be back."
msgstr "고블린은 또 들이닥칠 거야. 늦기 전에 여길 떠나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group
#. Speaker = Lia
#. NodeID = c490f5ca-27d9-b93d-8796-0598dfd11b0a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Prodigy_State_Leaving = True
#.     - DEN_Prodigy_State_ArgumentDone = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group:c490f5ca-27d9-b93d-8796-0598dfd11b0a
msgctxt "h7baa3651g5d29g482agb8e4gab61e2ff1080"
msgid ""
"But if something happens to these people, it's on us. I hope you know that."
msgstr "하지만 이 사람들에게 일이 생기면, 그건 우리 탓이야. 알아뒀으면 좋겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group
#. Speaker = Player
#. NodeID = c594c379-6fae-507f-9a34-d1b11f054073
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group:c594c379-6fae-507f-9a34-d1b11f054073
msgctxt "h6268712dgcf84g48e1ga56egf5121911f0f8"
msgid "<i>Say nothing.</i>"
msgstr "<i>아무 말도 하지 않는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group
#. Speaker = Rolan
#. NodeID = c7013227-8553-9156-aaed-a890d65177b2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group:c7013227-8553-9156-aaed-a890d65177b2
msgctxt "h52511abeg827fg4bc3gb39bg27a87ccd4175"
msgid ""
"This isn't Elturel and I'm not responsible for every damn tiefling in the "
"world!"
msgstr "여기는 엘투렐이 아니고, 세상 모든 망할 티플링을 내가 책임질 이유 따윈 없어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group
#. Speaker = Cal
#. NodeID = c7c80085-5085-c341-e8e2-aca123a8172a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group:c7c80085-5085-c341-e8e2-aca123a8172a
msgctxt "h77df96bdg0e48g4bcdg920agab08134f309f"
msgid "Or yell louder. That's fine too."
msgstr "아님 더 꽥꽥대든가. 난 모르겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group
#. Speaker = Lia
#. NodeID = c9996fd0-8fc2-0ee6-5583-513596f84195
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group:c9996fd0-8fc2-0ee6-5583-513596f84195
msgctxt "h4f3c3cecg3bccg4082gbd6cg033536d5dc61"
msgid "Prove him wrong, then. If you think you're able to, that is."
msgstr "그럼 아니란 걸 증명해 봐. 과연 그럴 깜냥이 있을까 싶지만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group
#. Speaker = Lia
#. NodeID = c9996fd0-8fc2-0ee6-5583-513596f84195
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group:c9996fd0-8fc2-0ee6-5583-513596f84195
msgctxt "ha39ea386geb07g482fga31agd72d1c0d6e0e"
msgid "Prove her wrong, then. If you think you're able to, that is."
msgstr "그럼 아니란 걸 증명해 봐. 과연 그럴 깜냥이 있을까 싶지만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group
#. Speaker = Lia
#. NodeID = c9996fd0-8fc2-0ee6-5583-513596f84195
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group:c9996fd0-8fc2-0ee6-5583-513596f84195
msgctxt "hbe7e0a3bg2df6g468bgacfbg61aa0a298a76"
msgid "Prove them wrong, then. If you think you're able to, that is."
msgstr "그럼 아니란 걸 증명해 봐. 과연 그럴 깜냥이 있을까 싶지만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group
#. Speaker = Rolan
#. NodeID = cf916c75-fe7f-b26b-049a-7b05b6811651
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group:cf916c75-fe7f-b26b-049a-7b05b6811651
msgctxt "hcf9d3c04g4feeg4542gad6fg1c85bdcbba33"
msgid ""
"I'll not gamble our lives, our <i>futures, </i>on people who are as good as "
"dead. We must leave for Baldur's Gate - at once."
msgstr "이미 죽은 목숨인 자들 때문에 우리 목숨, 우리 <i>미래</i>를 걸고 도박을 할 순 없어. 당장 발더스 게이트로 떠나야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group
#. Speaker = Lia
#. NodeID = d6a87ac7-31b8-defe-455a-55db0d081e0b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group:d6a87ac7-31b8-defe-455a-55db0d081e0b
msgctxt "hb02008a8g0eb9g415bgb5c4gd233e516ee16"
msgid ""
"What's the point in blades and spells if we don't bloody <i>use</i> them? We "
"should stay."
msgstr "<i>쓰지도</i> 않을 거라면 검술이랑 주문은 뭐하러 처 배운 건데? 우린 남아야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group
#. Speaker = Rolan
#. NodeID = e4dca450-8574-d64d-9a09-99b01f623efc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group:e4dca450-8574-d64d-9a09-99b01f623efc
msgctxt "haadfbdc5g2cf5g43deg81cbg6d08c4610baa"
msgid ""
"But it is, nevertheless, true. We've risked everything to get this far, we "
"can't afford to throw it all away."
msgstr "난 엄연한 사실을 말한 거야. 우린 그 기회를 위해 모든 걸 걸어 왔어. 그걸 허사로 만들 위험은 감수할 수 없다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group
#. Speaker = Player
#. NodeID = e68e3012-b490-7633-5475-d91697ea76f3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - RANGER(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group:e68e3012-b490-7633-5475-d91697ea76f3
msgctxt "h08aa37e1g5439g4efeg8be4gac4802648a6f"
msgid "I'd choose the wilderness over the dangers of a city any day. Stay."
msgstr "나라면 언제든 도시의 위험에 시달리느니 야생지에서 지낼 거야. 여기 남아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group
#. Speaker = Player
#. NodeID = e7d0c8d6-f35a-2b0b-8947-dbbb7e4206a0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group:e7d0c8d6-f35a-2b0b-8947-dbbb7e4206a0
msgctxt "h8a033282gcd6bg4331gaa4cg56209b8d2b83"
msgid "That's a low blow."
msgstr "치사한 구실이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group
#. Speaker = Player
#. NodeID = e7df1fca-d52a-5337-393c-0249008665e2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group:e7df1fca-d52a-5337-393c-0249008665e2
msgctxt "heddfc416gea27g4e76gadf2g51c8f77a6152"
msgid "'Where the weak have need, the strong have a duty'. Stay."
msgstr "'곤경에 처한 약자를 돕는 건 강자의 의무이다'. 여기 남아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group
#. Speaker = Cal
#. NodeID = ed685c52-226f-ace5-8f69-19e7a8ba0063
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group:ed685c52-226f-ace5-8f69-19e7a8ba0063
msgctxt "ha2dd8d07g7479g4612g8a31g61ac12c3fe98"
msgid "She's right, Rolan. We're better than this."
msgstr "누나 말이 맞아, 롤란. 양심을 저버리진 말자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group
#. Speaker = Player
#. NodeID = f6a0321d-4d3c-aa65-ea39-07eb32ad6cf3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group:f6a0321d-4d3c-aa65-ea39-07eb32ad6cf3
msgctxt "hc0bcae12gcd10g41c2g8edfg98da1975ae73"
msgid "You want fortune? There's coin in it if you stay."
msgstr "한몫 잡는 걸 원해? 여기 남는다면 이 돈을 주겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group
#. Speaker = Lia
#. NodeID = ffe49799-e13e-824c-9eab-63409748fc14
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Group:ffe49799-e13e-824c-9eab-63409748fc14
msgctxt "h90308378gaa9ag409ega91bg42d2f4df3933"
msgid "<i>Argh. </i>Fine. Let's sneak away like godsdamned cowards."
msgstr "<i>으으. </i>좋아. 어디 망할 겁쟁이 새끼처럼 몰래 빠져나가 보자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Sister
#. Speaker = Lia
#. NodeID = 05fb514b-e968-42bc-2b2f-32c4ae4c3bbb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Prodigy_HasMet_Sister(1) = False
#.   Global:
#.      - DEN_Prodigy_State_Staying = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Prodigy_HasMet_Sister(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Sister:05fb514b-e968-42bc-2b2f-32c4ae4c3bbb
msgctxt "h24ea187bg87cfg43a2ga2bdgd031a82c97a3"
msgid "Those goblins will rue the day they chose to tangle with this grove."
msgstr "그 고블린들은 이 숲이랑 엮이게 된 그날을 후회하게 될 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Sister
#. Speaker = Lia
#. NodeID = 3b9ab7f5-1361-c318-9868-e8127faf5967
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Sister:3b9ab7f5-1361-c318-9868-e8127faf5967
msgctxt "h87bb02a0gd4afg4fcag84b0g5fa994af9254"
msgid "You'd best get out too - while there's still time."
msgstr "당신도 떠나는 게 좋을 거야, 아직 시간이 남았을 때 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Sister
#. Speaker = Lia
#. NodeID = 6b4fec8f-b96a-749c-f400-fc102078da40
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Sister:6b4fec8f-b96a-749c-f400-fc102078da40
msgctxt "hdb028acbga635g4048gb683g607faab81216"
msgid "You and I will do some good here - I can feel it."
msgstr "당신과 나라면 여기서 뭔가 이룰 수 있을 것 같군. 느껴져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Sister
#. Speaker = Lia
#. NodeID = 72a47597-1aa1-4851-e23d-2bdd3eaf6449
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Prodigy_HasMet_Sister(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Sister:72a47597-1aa1-4851-e23d-2bdd3eaf6449
msgctxt "h586acd4ag4880g4031g89d9g96c38b77c3d5"
msgid ""
"I keep dreaming I'll wake up with my throat slit. May your sleep be more "
"pleasant."
msgstr "항상 눈을 뜨면 목이 베여 있는 꿈을 꿔. 당신의 꿈자리는 더 편안했으면 좋겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Sister
#. Speaker = Lia
#. NodeID = c60dacd6-f736-72a0-e3cb-2140d59c0e71
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Prodigy_HasMet_Sister(1) = False
#.   Global:
#.      - DEN_Prodigy_State_Leaving = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Prodigy_HasMet_Sister(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_Sister:c60dacd6-f736-72a0-e3cb-2140d59c0e71
msgctxt "hfa898b29ge1a9g4ad9g80fegb6dfd44e975c"
msgid ""
"I hate it, but Rolan is right. Every moment here is another we risk dying at "
"the hands of greenskins."
msgstr ""
"인정하긴 싫지만, 롤란 말이 맞아. 이 장소에 남아있는 시간마다 우리가 그 초록색 괴물 놈들한테 목이 따일 확률이 올라가는 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_Adventurer1AtGate
#. Speaker = Barth
#. NodeID = f4ec5096-3b92-4b54-dc17-afd06b54ecd7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_Adventurer1AtGate:f4ec5096-3b92-4b54-dc17-afd06b54ecd7
msgctxt "hbda0d4b5gc645g44d2gb24bg615f9380b751"
msgid "Hurry! Please! The goblins are on us!"
msgstr "빨리 좀 열어! 고블린이 뒤쫓아온다고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_Adventurer2AtGate
#. Speaker = Remira
#. NodeID = 06284859-abdb-4bf9-d854-8e3112237862
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_Adventurer2AtGate:06284859-abdb-4bf9-d854-8e3112237862
msgctxt "h74d0de51g351eg4ec2gbc06g4f132417dd3d"
msgid "Please, please, let us in!"
msgstr "제발, 제발 좀! 들여보내줘!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_AdventurerLeaderAtGate
#. Speaker = Aradin
#. NodeID = 093bd162-164d-f2a3-86a0-40264daff8b9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - d3f8458a-5a3c-b7a0-f664-0bf8f787d89f_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_AdventurerLeaderAtGate:093bd162-164d-f2a3-86a0-40264daff8b9
msgctxt "h21e18e62gd24ag4f23g8ee2gc584c910e9af"
msgid "Open the gate, you stubborn bastard!"
msgstr "문 열어, 이 고집불통 새끼야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_AdventurerLeaderAtGate
#. Speaker = Kanon
#. NodeID = 2027bc1c-dd9d-8d5e-b483-a5eeaba6d789
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_AdventurerLeaderAtGate:2027bc1c-dd9d-8d5e-b483-a5eeaba6d789
msgctxt "h5bd69429gd4c2g4d48g8c76g5585f023c6bf"
msgid "He's been alerted. I won't leave my post."
msgstr "경보 울렸으니 오시겠지. 내 자리를 비우진 않을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_AdventurerLeaderAtGate
#. Speaker = Aradin
#. NodeID = 5e478ee6-1d5e-6eae-6b00-00ad99c322ee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_AdventurerLeaderAtGate:5e478ee6-1d5e-6eae-6b00-00ad99c322ee
msgctxt "hb238f6e1g5bc9g4b5cg9fc4gf0c8c45d59fc"
msgid "Look - please, just let us in. They're almost on us."
msgstr "이봐, 그냥 좀 들여보내 줘. 놈들이 바짝 쫓고 있다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_AdventurerLeaderAtGate
#. Speaker = Kanon
#. NodeID = 6a523bd3-e2ad-a5cb-b2ae-1e81087e6ff7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_AdventurerLeaderAtGate:6a523bd3-e2ad-a5cb-b2ae-1e81087e6ff7
msgctxt "h9c3e2cc4g5b49g4ca2g8175ga70bed39d459"
msgid "Go ahead and try."
msgstr "할 수 있으면 해보시지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_AdventurerLeaderAtGate
#. Speaker = Aradin
#. NodeID = 8153c68a-9819-c8de-b5aa-410b9cebcc29
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - d3f8458a-5a3c-b7a0-f664-0bf8f787d89f_B = True
#. SetFlags:
#.   Local:
#.     - d3f8458a-5a3c-b7a0-f664-0bf8f787d89f_A = False
#.     - d3f8458a-5a3c-b7a0-f664-0bf8f787d89f_B = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_AdventurerLeaderAtGate:8153c68a-9819-c8de-b5aa-410b9cebcc29
msgctxt "h514e7cfag7952g4e4dgb3bagf4b1c645875c"
msgid "Open up or I'll break the bloody thing down!"
msgstr "당장 열지 않으면 이 망할 문을 박살 내버리겠어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_AdventurerLeaderAtGate
#. Speaker = Aradin
#. NodeID = f492d777-79b8-1b67-40f6-8663f2dfc370
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - d3f8458a-5a3c-b7a0-f664-0bf8f787d89f_A = True
#. SetFlags:
#.   Local:
#.     - d3f8458a-5a3c-b7a0-f664-0bf8f787d89f_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_AdventurerLeaderAtGate:f492d777-79b8-1b67-40f6-8663f2dfc370
msgctxt "hb0b1032ag050bg4f34g9e51g1e840af3170f"
msgid "Then go get him!"
msgstr "그럼 니들 대장 불러!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_AdventurerLeaderRant
#. Speaker = Aradin
#. NodeID = 2aa0e580-0813-6a50-0c8d-ceb3f6733ac0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingLeader_State_PermaDefeated = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_AdventurerLeaderRant:2aa0e580-0813-6a50-0c8d-ceb3f6733ac0
msgctxt "h3d1febf8gbd53g4577g829dg451525c5e6cc"
msgid "He got what he deserved."
msgstr "뒈져도 싼 짓 한 놈이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_AdventurerLeaderRant
#. Speaker = Aradin
#. NodeID = 73a3dd0f-efa5-0089-bc36-c77f96787f4d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_AdventurerLeaderRant:73a3dd0f-efa5-0089-bc36-c77f96787f4d
msgctxt "hebe98a1eg239cg4bc4gb221g241b6082bb27"
msgid "Coward almost got us killed."
msgstr "그 겁쟁이가 우리 다 죽일 뻔했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_AdventurerLeaderToConfrontation
#. Speaker = Aradin
#. NodeID = 753d4a7e-413a-e230-4d64-152fa5a7091f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingLeader_State_PermaDefeated = True
#. SetFlags:
#.   Global:
#.     - DEN_RaidingParty_Event_SkipConfrontation = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_AdventurerLeaderToConfrontation:753d4a7e-413a-e230-4d64-152fa5a7091f
msgctxt "hbbca6b7ag2050g4a2ag85eagb4bf3a1481ee"
msgid "One less demon to worry about."
msgstr "망할 데몬 한 놈 잘 뒈졌군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_AdventurerLeaderToConfrontation
#. Speaker = Aradin
#. NodeID = dd4567c7-838f-6255-aae2-03678b195d01
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_RaidingParty_Event_AdventurerLeaderToConfrontation = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_AdventurerLeaderToConfrontation:dd4567c7-838f-6255-aae2-03678b195d01
msgctxt "h2418963dg3ce7g40cagaae1gada269e7d0a0"
msgid "Where is that bastard?!"
msgstr "그 개자식 어딨어?!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_AdventurerWakesUp
#. Speaker = Aradin
#. NodeID = 5029d2b5-909f-8ae8-4fde-85019c5f6980
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_AdventurerWakesUp:5029d2b5-909f-8ae8-4fde-85019c5f6980
msgctxt "h28134252g75c0g4f69g9e98gdbffa6e8e6af"
msgid "Just like a foulblood."
msgstr "더러운 혈통답게들 구는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_GoblinCaptain
#. Speaker = Za'krug
#. NodeID = 4e124ac9-7f5f-2988-4ffb-daa16a40c52e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_GoblinCaptain:4e124ac9-7f5f-2988-4ffb-daa16a40c52e
msgctxt "h6b2021f7g261cg43c3g9ff6g1ad35c4c1e50"
msgid "For the Absolute!"
msgstr "절대자님을 위해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_GoblinCaptain
#. Speaker = Za'krug
#. NodeID = 60c60b41-6873-59c9-a78b-e813d6423f57
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_GoblinCaptain:60c60b41-6873-59c9-a78b-e813d6423f57
msgctxt "h1cbf97bcgab4eg4ee9ga450gdcc1c486f7cc"
msgid "Scouts - get to the high ground. Raiders - charge the bastards!"
msgstr "정찰대, 고지대로 가라! 습격대, 저 개자식들한테 돌격!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_LeadersArgue
#. Speaker = Aradin
#. NodeID = 02337ae3-8981-82a1-da8c-529ffc7265bb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_LeadersArgue:02337ae3-8981-82a1-da8c-529ffc7265bb
msgctxt "h2411d5c5g6078g455bga34cg83ce7beb11d0"
msgid "And you was ready to let 'em have us."
msgstr "그러는 댁은 놈들이 우릴 죽이게 놔두려고 했지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_LeadersArgue
#. Speaker = Zevlor
#. NodeID = 36e20c83-28e3-5885-7065-d5bce0fe6284
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_LeadersArgue:36e20c83-28e3-5885-7065-d5bce0fe6284
msgctxt "ha08a5168g6c7cg439bgbbc8ga2bbcdf5d824"
msgid "Watch your tongue. Before it's too late."
msgstr "입 조심해라. 너무 늦기 전에."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_LeadersArgue
#. Speaker = Aradin
#. NodeID = 52f1c8e8-2738-91bd-e31d-47d99c2fd639
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_LeadersArgue:52f1c8e8-2738-91bd-e31d-47d99c2fd639
msgctxt "h2aa09f92g0be5g45b2gaf83g096c70c60213"
msgid "<i>Tieflings, </i>you mean."
msgstr "<i>티플링</i> 새끼들이겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_LeadersArgue
#. Speaker = Zevlor
#. NodeID = 53d1d4ee-1021-cc65-2c0c-c0c238e629d1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 123221d0-8f93-b105-cadd-998eb3518077_local1 = False
#. SetFlags:
#.   Local:
#.     - 123221d0-8f93-b105-cadd-998eb3518077_local1 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_LeadersArgue:53d1d4ee-1021-cc65-2c0c-c0c238e629d1
msgctxt "hf6580e15ga9e6g4999ga23fg30fe9ab2859b"
msgid "You led them to our door."
msgstr "놈들을 우리 문 앞에 끌어들이다니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_LeadersArgue
#. Speaker = Aradin
#. NodeID = 69ca025d-4ec8-3979-a036-70b3df857234
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_LeadersArgue:69ca025d-4ec8-3979-a036-70b3df857234
msgctxt "hfa82b312g2073g4809g8708ged6376ccad26"
msgid "Or what, horns? What?"
msgstr "싫다면 어쩔래, 뿔쟁이? 응?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_LeadersArgue
#. Speaker = Zevlor
#. NodeID = 74c3d7d9-7358-8a32-d4bf-a391299f3fc3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_LeadersArgue:74c3d7d9-7358-8a32-d4bf-a391299f3fc3
msgctxt "h6cb98c61g9a2cg4e3bga347g13a415d4076b"
msgid "What did you just say?"
msgstr "방금 뭐라 지껄였나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_LeadersArgue
#. Speaker = Zevlor
#. NodeID = b0160232-b0c1-f2a3-1586-76b44fb8f9bc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_LeadersArgue:b0160232-b0c1-f2a3-1586-76b44fb8f9bc
msgctxt "hc2a14117g8684g4a07gb765g0e354e390bee"
msgid "There are people here. Children."
msgstr "여긴 사람들이 있단 말이다. 아이들이."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_LeadersArgue
#. Speaker = Aradin
#. NodeID = b820aeba-35d6-f8a8-62e4-af9a16c705d3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_LeadersArgue:b820aeba-35d6-f8a8-62e4-af9a16c705d3
msgctxt "hcbe62903g7373g4379ga24ag3cc7179d7321"
msgid "I should've known. Can't trust a devil."
msgstr "진작 알았어야 했어. 데빌을 믿다니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_LeadersArgue
#. Speaker = Zevlor
#. NodeID = eddda66b-e1c4-9162-8e3b-db7d451770af
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_LeadersArgue:eddda66b-e1c4-9162-8e3b-db7d451770af
msgctxt "h88a2539egd577g4bf4gb0a1gdf3751aeacc5"
msgid "Don't blame me for your idiotic mistakes."
msgstr "멍청한 짓을 저지른 건 너희니 내 탓하지 마라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_LeadersArgue
#. Speaker = Aradin
#. NodeID = f58600af-4c00-0640-be21-541ede9f5c18
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_LeadersArgue:f58600af-4c00-0640-be21-541ede9f5c18
msgctxt "h5d0ef4c5g676cg48f3g9301g775e95e808fc"
msgid "I blame you for lockin' us out. Leavin' us to die."
msgstr "난 댁이 입구 막은 걸 탓하는 거야. 우릴 죽게 내버려뒀잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_TieflingLeaderRant
#. Speaker = Zevlor
#. NodeID = 00c58201-3a0e-cb7d-52ed-ca0aa72d264d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AdventurerLeader_State_PermaDefeated = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_TieflingLeaderRant:00c58201-3a0e-cb7d-52ed-ca0aa72d264d
msgctxt "h6cbd789dg07abg4d71gbaa0ge8c2cb513a26"
msgid "Good riddance."
msgstr "속이 시원하군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_TieflingLeaderRant
#. Speaker = Zevlor
#. NodeID = 96703df7-0d74-5348-785e-b34ee3f3c268
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_TieflingLeaderRant:96703df7-0d74-5348-785e-b34ee3f3c268
msgctxt "h56a14523gf7a7g4805g9357gfe75c10ec90e"
msgid "Damn vermin."
msgstr "망할 해충 놈들."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_TieflingLeaderSpotsWyll
#. Speaker = Zevlor
#. NodeID = 92a1d486-8e05-0682-21d3-8778325c7b3e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_TieflingLeaderSpotsWyll:92a1d486-8e05-0682-21d3-8778325c7b3e
msgctxt "hc052bb09g9d6fg4556gb562g3d63c4a86a03"
msgid "The Blade of Frontiers."
msgstr "변경의 칼날이로군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_TieflingLeaderWantsGateOpened
#. Speaker = Zevlor
#. NodeID = 0549028a-08e6-13d7-aacb-53c7291e8897
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_RaidingParty_Event_OpenDenGate = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_TieflingLeaderWantsGateOpened:0549028a-08e6-13d7-aacb-53c7291e8897
msgctxt "h695f5bc6gdd93g409cgbfd2g28d7b9a0cae1"
msgid "The danger has passed - for now. Open the gates."
msgstr "위협이 처리됐군. 당장은 말이지. 관문을 열어라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_TieflingWakesUp
#. Speaker = Zevlor
#. NodeID = 84238c76-c5b6-77ad-4227-f304944f704d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_TieflingWakesUp:84238c76-c5b6-77ad-4227-f304944f704d
msgctxt "hc9edb7cbg2d0eg4e29ga871g028fdd2e57c7"
msgid "Ngh... my jaw..."
msgstr "으윽... 내 턱..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_RaidingParty_AD_WyllCharge
#. Speaker = Wyll
#. NodeID = 541b4d52-41db-00e2-7fa5-8390d58e2248
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - e0b6dfeb-2923-e0ad-1dc5-2a5d1e055e16_local1 = False
#. SetFlags:
#.   Local:
