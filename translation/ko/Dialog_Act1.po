#. TagRule: REALLY_GENERIC
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_VB_BanditsLeaveReaction:d51e5855-36bb-5adc-bc27-07c96d829332
msgctxt "h3fe376fag6b8dg4071ga30agcc1b8c08a633"
msgid "Good work. Thought we had a fight on our hands."
msgstr "잘했어. 싸우게 될 줄만 알았는데 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_VB_Fissure_1
#. Speaker = Player
#. NodeID = ab135090-d485-99df-51e9-d1ab25cd838c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_VB_Fissure_1:ab135090-d485-99df-51e9-d1ab25cd838c
msgctxt "h8179cc91g4c70g47d8g84e9g070a22b16b0d"
msgid "There's something underneath here..."
msgstr "여기 아래에 뭔가가 있어..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_VB_LockpickingCrypt_1_WithShadowheart
#. Speaker = Shadowheart
#. NodeID = fc8e9480-4842-0395-7914-4ba89616b907
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_VB_LockpickingCrypt_1_WithShadowheart:fc8e9480-4842-0395-7914-4ba89616b907
msgctxt "h3ea9b8cdg56a6g4acaga280ga1357a00b95f"
msgid "What, you got it open, just like that...?"
msgstr "뭐야, 너 그거 연 거야? 그렇게 쉽게...?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_VB_LockpickingShadowheart_1_WithShadowheart
#. Speaker = Shadowheart
#. NodeID = 79535675-ee7f-3615-53cb-4b8a53b702f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_VB_LockpickingShadowheart_1_WithShadowheart:79535675-ee7f-3615-53cb-4b8a53b702f5
msgctxt "ha6da95afg28b7g459cgb7e4gb420236e0863"
msgid "There! Not so impregnable after all."
msgstr "됐다! 그렇게 난공불락은 아니었네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_ShadowHeartRecruitment_AD
#. Speaker = Shadowheart
#. NodeID = 55d4d031-7fc9-4628-0b87-f68266ce197b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 35f08b91-666d-20bf-3fea-90e316dfd478_C = False
#.      - 35f08b91-666d-20bf-3fea-90e316dfd478_A = True
#.      - 35f08b91-666d-20bf-3fea-90e316dfd478_B = True
#. SetFlags:
#.   Local:
#.     - 35f08b91-666d-20bf-3fea-90e316dfd478_C = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_ShadowHeartRecruitment_AD:55d4d031-7fc9-4628-0b87-f68266ce197b
msgctxt "hae52db71g4f8fg42b9g9f3dg29a48b0513a9"
msgid "They can't hold forever. Come on!"
msgstr "계속 뻐팅길 순 없을 거 아냐. 제발 좀!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_ShadowHeartRecruitment_AD
#. Speaker = Shadowheart
#. NodeID = 5d2f7647-2a59-b737-b8b0-6ef473d8afbd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 35f08b91-666d-20bf-3fea-90e316dfd478_C = False
#.      - 35f08b91-666d-20bf-3fea-90e316dfd478_A = False
#.      - 35f08b91-666d-20bf-3fea-90e316dfd478_B = False
#. SetFlags:
#.   Local:
#.     - 35f08b91-666d-20bf-3fea-90e316dfd478_A = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_ShadowHeartRecruitment_AD:5d2f7647-2a59-b737-b8b0-6ef473d8afbd
msgctxt "he43d184eg7004g4bbdgb5cegd8d465d42c2f"
msgid "Blessed Mother, smite the obstacles in my path."
msgstr "은혜로운 어머니시여, 제 앞을 막는 방해물을 쳐부숴 주소서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_ShadowHeartRecruitment_AD
#. Speaker = Shadowheart
#. NodeID = 7589c7f3-1922-d304-2da6-9eb10e7c6e50
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 35f08b91-666d-20bf-3fea-90e316dfd478_C = False
#.      - 35f08b91-666d-20bf-3fea-90e316dfd478_A = True
#.      - 35f08b91-666d-20bf-3fea-90e316dfd478_B = False
#. SetFlags:
