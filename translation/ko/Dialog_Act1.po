msgctxt "hcd2bdee3g3a70g4027gab0ag2d3854cbaf43"
msgid "I had really hoped we were above base pursuits like 'monster hunting'."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Tollhouse_PAD_RefugeesAreCultists
#. Speaker = Player
#. NodeID = d628960c-fc12-4ec4-9694-d55a62988217
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Tollhouse_PAD_RefugeesAreCultists:d628960c-fc12-4ec4-9694-d55a62988217
msgctxt "h6e09d7c2gf18ag4c40g8f2fg8ecea4cfd746"
msgid "I hope this proves to be worthwhile. We can hardly afford distractions."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Tollhouse_PAD_RefugeesAreCultists
#. Speaker = Player
#. NodeID = d628960c-fc12-4ec4-9694-d55a62988217
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Tollhouse_PAD_RefugeesAreCultists:d628960c-fc12-4ec4-9694-d55a62988217
msgctxt "h5692089dgdfbcg4547g811cg7c3bd7774258"
msgid ""
"Who's to say who's the real villain in this tale of devils and masquerades?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Tollhouse_PAD_RefugeesAreCultists
#. Speaker = Player
#. NodeID = d628960c-fc12-4ec4-9694-d55a62988217
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_GENERIC
