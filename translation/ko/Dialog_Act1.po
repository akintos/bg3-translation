msgctxt "he38e2fdfgc582g48bdg99acg7e9bae759436"
msgid "Many would kill to be chosen by for such a task. Do <i>not</i> fail.  "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_IntelligenceOfficer04
#. Speaker = Ardent Jhe'rezath
