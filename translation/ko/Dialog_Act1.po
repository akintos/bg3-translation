msgctxt "h2fb1a0edg3357g40dfg997eg3e639b7cb544"
msgid "Get to work, or get out of the way."
msgstr "일하러 가든가, 썩 꺼져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarLoyalFocused
