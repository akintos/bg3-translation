msgctxt "h756afc20gc15cg486fg8910gace2a33e9d0b"
msgid "Keep trying. You'll figure it out."
msgstr "계속 노력해 봐. 어떻게든 되겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
