#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_LaezelWithKnight:12ec3361-399e-85fd-2f13-05403d4f3e1d
msgctxt "h49d429f2g4c85g4563g9c45gaee2048d2daf"
msgid "Hear me, knight. I must..."
msgstr "들어보십시오, 기사여. 전 반드시..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_LaezelWithKnight
#. Speaker = Lae'zel
#. NodeID = 23f1e294-3ee5-265e-67ec-475ac4c0fa6f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 8876b4e8-08c6-fdf5-bca6-96f6d1a11959_FirstLoopDone = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_LaezelWithKnight:23f1e294-3ee5-265e-67ec-475ac4c0fa6f
msgctxt "h83d57331g60bag4107g88cagcf0d761d15ae"
msgid "You do not understand. I heed Vlaakith's call."
msgstr "당신은 이해하지 못해. 난 블라키스 님의 명을 따르고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_LaezelWithKnight
#. Speaker = Kith'rak Voss
#. NodeID = 62cf6991-b245-fc9c-f18c-7f402da8f048
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_LaezelWithKnight:62cf6991-b245-fc9c-f18c-7f402da8f048
msgctxt "h12513e8eg9f5bg4c48gb0c6g7c1166b60cc5"
msgid "Few of our Queen's children prove so stubborn."
msgstr "여왕님의 자녀들 중 이렇게 고집이 센 경우는 드물지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_LaezelWithKnight
#. Speaker = Kith'rak Voss
#. NodeID = b0bc144e-31c6-826b-a3da-5a887d3a1f36
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_LaezelWithKnight:b0bc144e-31c6-826b-a3da-5a887d3a1f36
msgctxt "h08a63c0eg7efag4ccega61cgc7a8fa1611b5"
msgid "It is not your time to speak."
msgstr "네가 말할 때가 아니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_LaezelWithKnight
#. Speaker = Kith'rak Voss
#. NodeID = c75e52b0-cbc1-1eac-36f5-2c1aac57f42c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_LaezelWithKnight:c75e52b0-cbc1-1eac-36f5-2c1aac57f42c
msgctxt "hbfa86b85gbe5bg4cbag96a9g269abffb8d53"
msgid "Child of Vlaakith. Be still, and listen."
msgstr "블라키스 님의 아이야. 잠시 들어 보거라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_LaezelWithKnight
#. Speaker = Kith'rak Voss
#. NodeID = e2ea4562-ed89-c492-7683-0d6a0e415c48
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 8876b4e8-08c6-fdf5-bca6-96f6d1a11959_FirstLoopDone = False
#. SetFlags:
#.   Local:
#.     - 8876b4e8-08c6-fdf5-bca6-96f6d1a11959_FirstLoopDone = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_LaezelWithKnight:e2ea4562-ed89-c492-7683-0d6a0e415c48
msgctxt "h3a69eff9g8c43g43c6g9004gaaf7cedb36b2"
msgid "Baretha - look what wanders near."
msgstr "바레사, 근처에 뭐가 거니는지 봐라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_LaezelWithKnight
#. Speaker = Kith'rak Voss
#. NodeID = f5784115-57a3-c839-140f-96cc9d87f814
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_LaezelWithKnight:f5784115-57a3-c839-140f-96cc9d87f814
msgctxt "h23913da5g8608g4cc8g8658g7f8e298e4df5"
msgid "Do you not honour the command of a <i>kith'rak</i>, young one?"
msgstr "감히 <i>키스락</i>의 명을 존중하지 않겠다는 것이냐, 어린 자여?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_ScoutLeaves
#. Speaker = Ellyka
#. NodeID = f7ff6253-122f-0b57-e289-0ddc671c8e14
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_ScoutLeaves:f7ff6253-122f-0b57-e289-0ddc671c8e14
msgctxt "h4fade31agacd4g4128g896eg817d2a4baa6f"
msgid "<i>Mrag! </i>That's it - I'm getting out of here!"
msgstr "<i>므락!</i> 이제 됐어, 난 여기서 빠져나가야겠어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_ScoutReactsToDragon
#. Speaker = Ellyka
#. NodeID = 68266b70-70f9-4473-7b4d-fe1aae86d80d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_ScoutReactsToDragon:68266b70-70f9-4473-7b4d-fe1aae86d80d
msgctxt "h6ae27a97g835eg449bg9616g5c41b4bcbddf"
msgid "Helm protect me, where'd that beast come from...?"
msgstr "헬름이시여 저를 보호하소서, 저 괴수는 어디서 온 거야...?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_SearchingCorpses
#. Speaker = Sarth Baretha
#. NodeID = 2add0020-b893-4677-9fee-8385088c9c7d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_SearchingCorpses:2add0020-b893-4677-9fee-8385088c9c7d
msgctxt "hf2070dc9g3ca8g4707gb7e9g1355a5767dce"
msgid "Of course, Kith'rak."
msgstr "물론입니다, 키스락이여."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_SearchingCorpses
#. Speaker = Kith'rak Voss
#. NodeID = 3ab23c9a-7df4-6b0a-e7d1-1da1c2ca9415
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 1c74b01f-5dcf-8107-b384-204d341ed9d5_B = False
#.     - 1c74b01f-5dcf-8107-b384-204d341ed9d5_A = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_SearchingCorpses:3ab23c9a-7df4-6b0a-e7d1-1da1c2ca9415
msgctxt "h1de6fb14g53b5g4038g9db5g89549b167054"
msgid "Well? Anything?"
msgstr "그래서? 아무것도 없나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_SearchingCorpses
#. Speaker = Sarth Baretha
#. NodeID = 4886039f-47f5-0ade-18c1-38fcc9fcb315
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 1c74b01f-5dcf-8107-b384-204d341ed9d5_B = False
#.      - 1c74b01f-5dcf-8107-b384-204d341ed9d5_A = True
#. SetFlags:
#.   Local:
#.     - 1c74b01f-5dcf-8107-b384-204d341ed9d5_B = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_SearchingCorpses:4886039f-47f5-0ade-18c1-38fcc9fcb315
msgctxt "h6a41a740g9c80g4f0cg8fccg343fe63f0314"
msgid "We will not fail Vlaakith."
msgstr "블라키스 님을 실망하게 해 드릴 수는 없다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_SearchingCorpses
#. Speaker = Sarth Baretha
#. NodeID = 6159cea0-9327-323c-fab7-1ee3d307bb7a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_SearchingCorpses:6159cea0-9327-323c-fab7-1ee3d307bb7a
msgctxt "h91fdabd8gab14g4244gb31bgee2ac8604309"
msgid "Yes, Kith'rak. We shall find it."
msgstr "알겠습니다, 키스락. 반드시 찾아내겠습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_SearchingCorpses
#. Speaker = Kith'rak Voss
#. NodeID = 9d112eaa-fa7a-5b55-78ff-e4dd0ca9d8d9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 1c74b01f-5dcf-8107-b384-204d341ed9d5_OnlyOnce = False
#. SetFlags:
#.   Local:
#.     - 1c74b01f-5dcf-8107-b384-204d341ed9d5_OnlyOnce = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_SearchingCorpses:9d112eaa-fa7a-5b55-78ff-e4dd0ca9d8d9
msgctxt "h81d48980gc0a0g46dbgaf00ga60b72a09f40"
msgid "Get to work, Baretha! Search the dead!"
msgstr "가라, 바레사! 죽은 이들을 수색하도록!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_SearchingCorpses
#. Speaker = Sarth Baretha
#. NodeID = a63d4622-c852-8e57-e9bb-e8ca45f60269
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_SearchingCorpses:a63d4622-c852-8e57-e9bb-e8ca45f60269
msgctxt "h2c4f0248g10acg4b68gb72aga180bec6c100"
msgid "You heard him - search every corpse!"
msgstr "말씀 들었지, 모든 시체를 수색해라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_SearchingCorpses
#. Speaker = Sarth Baretha
#. NodeID = a986ceb5-24c4-e587-0ccb-7f106531ddc9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_SearchingCorpses:a986ceb5-24c4-e587-0ccb-7f106531ddc9
msgctxt "ha61c7f46g6742g4ed3gac95g68356211121f"
msgid "Nothing so far, Kith'rak."
msgstr "아직은 아무것도 없습니다, 키스락."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_SearchingCorpses
#. Speaker = Kith'rak Voss
#. NodeID = b158ac92-a279-bb76-83d2-c9f263fd52ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_SearchingCorpses:b158ac92-a279-bb76-83d2-c9f263fd52ae
msgctxt "hc162f5aag01aag4784gbe7bg36e03a50d467"
msgid "I expect you to fall on your sword, if you do."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_SearchingCorpses
#. Speaker = Kith'rak Voss
#. NodeID = fab406ac-69b4-89db-1ed4-bc08e36c7f9c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 1c74b01f-5dcf-8107-b384-204d341ed9d5_B = False
#.      - 1c74b01f-5dcf-8107-b384-204d341ed9d5_A = False
#. SetFlags:
#.   Local:
#.     - 1c74b01f-5dcf-8107-b384-204d341ed9d5_A = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_SearchingCorpses:fab406ac-69b4-89db-1ed4-bc08e36c7f9c
msgctxt "hd5ec926dgcbd2g4f95ga62cge85541ca237c"
msgid "Keep looking! Someone in this wretched world has what we need."
msgstr "수색을 계속해라! 분명 이 비참한 세계에 누군가는 우리가 원하는 것을 가지고 있을 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_StandOff
#. Speaker = Sarth Baretha
#. NodeID = 140818a3-b615-11b9-44fc-c3cbe5ef1cc0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_StandOff:140818a3-b615-11b9-44fc-c3cbe5ef1cc0
msgctxt "h8500b426g9405g47f2gb8fbg14a6ef598579"
msgid "Your babbling tires me, <i>istik</i>. Move your carcass!"
msgstr "주절거림을 듣고 있기도 지치는군, <i>이스틱</i>. 몸뚱이를 치워라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_StandOff
#. Speaker = Gauntlet Dion
#. NodeID = 54cf7c2f-bfee-a53d-ebf9-5bae61b4467a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_StandOff:54cf7c2f-bfee-a53d-ebf9-5bae61b4467a
msgctxt "h8186673bga9bbg457dgad01gc8e5f2b5b23a"
msgid "B-by order of the Flaming Fist, halt!"
msgstr "프-플레이밍 피스트의 지시에 따라, 멈춰라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_StandOff
#. Speaker = Sarth Baretha
#. NodeID = eb1c2b9f-41f2-1371-7578-979c116cd6cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_StandOff:eb1c2b9f-41f2-1371-7578-979c116cd6cb
msgctxt "hc2092f41g2686g45ceg90a7g8aed3d855965"
msgid "Or what? Show us what you can do, worm."
msgstr "아니면 뭐? 네가 뭘 할 수 있는지 보여 봐라, 벌레야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 0198fb90-8b23-88da-e249-2aa07aa64d47
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:0198fb90-8b23-88da-e249-2aa07aa64d47
msgctxt "hf0ee4aacg5f5ag4d4fg92d4gcacc663ad6c4"
msgid ""
"I want something, yes. But I don't need you to be drawing breath in order to "
"take it..."
msgstr "그래, 나도 원하는 게 있지. 허나 그걸 취하기 위해서 널 죽일 수도 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 01e43967-a745-2413-a445-3a3067651efc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_GithChokepoint_Event_MentionedWeapon = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:01e43967-a745-2413-a445-3a3067651efc
msgctxt "h02e6193eg4bb4g4156g846aged1b19e6c1c8"
msgid ""
"We hunt a weapon, taken from the <i>ghaik </i>slave ship. Have you seen such "
"an item?"
msgstr "무기를 찾고 있다.게이크 노예선에서 떨어진 것인데, 본 적 있나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 02881481-b5f8-405d-2ef3-258b712939eb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:02881481-b5f8-405d-2ef3-258b712939eb
msgctxt "hf23e67b0gdeb1g4fd6g8692g485bbda55351"
msgid "I have every right: I am strong, you are weak. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 03ae7208-6899-3b69-596a-3fc1ba8d48a2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:03ae7208-6899-3b69-596a-3fc1ba8d48a2
#, fuzzy
msgctxt "h027fbf64g8377g4e39g96bfg3b6a71e6f2d3"
msgid "I gave you a chance to save your hide. Instead you chose empty bluster."
msgstr "너에게 살 수 있는 기회를 주었건만. 허울 뿐인 허세를 떠는 걸 택했구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Player
#. NodeID = 05603960-b3c5-90dd-39c6-a966dc4c066d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4dd8c77c-d075-b1b3-1690-7a46dc8b8fb8_MindHasBeenRead = True
#.   Tag:
#.      - GITHYANKI(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:05603960-b3c5-90dd-39c6-a966dc4c066d
msgctxt "h47ee9339g1aacg4340g9eeeg6fcd9890ad09"
msgid "Don't be too hasty. I could prove <i>very </i>useful."
msgstr "너무 성급해 하지 마. 내가 <i>매우</i>쓸모 있다는 걸 증명 할 수 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 085ee268-1592-e4ae-7c72-7be4eaecb41b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 4dd8c77c-d075-b1b3-1690-7a46dc8b8fb8_MindHasBeenRead = True
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:085ee268-1592-e4ae-7c72-7be4eaecb41b
msgctxt "h8b7475a9g9366g421dg8764gd9bf2563a37b"
msgid ""
"<i>A worthless kill - no sport. If this one was even slightly useful, I "
"might spare him...</i>"
msgstr "<i>의미 없는 살육이야. 재미도 없겠군. 이자가 조금이라도 쓸모가 있다면, 살려두는 편이 나을지도 모르겠어...</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 085ee268-1592-e4ae-7c72-7be4eaecb41b
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Local:
#.     - 4dd8c77c-d075-b1b3-1690-7a46dc8b8fb8_MindHasBeenRead = True
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:085ee268-1592-e4ae-7c72-7be4eaecb41b
msgctxt "h974a9a02gfdc5g4eb5g88f4gd7844f78f62d"
msgid ""
"<i>A worthless kill - no sport. If this one was even slightly useful, I "
"might spare her...</i>"
msgstr "<i>의미 없는 살육이야. 재미도 없겠군. 이자가 조금이라도 쓸모가 있다면, 살려두는 편이 나을지도 모르겠어...</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 085ee268-1592-e4ae-7c72-7be4eaecb41b
#. HandlePath = TaggedText[2].TagText[0]
#. SetFlags:
#.   Local:
#.     - 4dd8c77c-d075-b1b3-1690-7a46dc8b8fb8_MindHasBeenRead = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:085ee268-1592-e4ae-7c72-7be4eaecb41b
msgctxt "h8ba79fcagc852g40f0ga74agedbab9467754"
msgid ""
"<i>A worthless kill - no sport. If this one was even slightly useful, I "
"might spare them...</i>"
msgstr "<i>의미 없는 살육이야. 재미도 없겠군. 이들이 조금이라도 쓸모가 있다면, 살려두는 편이 나을지도 모르겠어...</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 0a1e685c-536d-387d-f06f-cd37f0836100
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:0a1e685c-536d-387d-f06f-cd37f0836100
msgctxt "he28dc646ge776g4363gbbd3gc46b18cfc7a2"
msgid ""
"And if you come across any survivors of the <i>ghaik</i> vessel, kill them "
"and search them. Thoroughly."
msgstr "게이크 함의 생존자를 만나면 사살하고 수색해라. 철저히."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 0ac9560d-fb88-c07e-b941-3aa171114580
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:0ac9560d-fb88-c07e-b941-3aa171114580
msgctxt "h0521b738g4c8bg476bg8658gfefe9e6fe49b"
msgid "Your troubles are over; we shall help you. Baretha?"
msgstr "그 문제로는 더 이상 걱정하지 않아도 좋네. 우리가 도와주지. 바레사?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 0dc3b8e4-40ff-0a97-5aa0-24e951ba5482
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:0dc3b8e4-40ff-0a97-5aa0-24e951ba5482
msgctxt "ha2eda670g4caeg49d1g9606g2079337907de"
msgid "You may live. For the moment."
msgstr "살아도 좋다. 당분간은."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 0ea1e97d-d1b8-6268-5f60-0dd339bc2ed9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:0ea1e97d-d1b8-6268-5f60-0dd339bc2ed9
msgctxt "h534e5565g8a8cg443ag92b3gd8283457de81"
msgid ""
"<i>Lies. </i>You speak like the vermin from this wretched world. What are "
"you, a deserter?"
msgstr "<i>거짓말.</i>넌 마치 이 썩어빠진 세상의 쥐새끼 마냥 혀를 놀리는군. 대체 넌 뭐지, 탈영병인가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Player
#. NodeID = 0fb019fb-c582-8763-6608-7decee03cfa6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:0fb019fb-c582-8763-6608-7decee03cfa6
msgctxt "hfa55bd71gb263g401fga7eag9cfefc13c94c"
msgid "I might know something. But it'll cost you."
msgstr "내가 아는 바가 있을지도 모르지. 하지만 값을 지불해 줘야겠는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 0fe1b3e7-b4d4-950c-ff41-c24dd3e908b2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_GithChokepoint_Quest_GithLeave = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:0fe1b3e7-b4d4-950c-ff41-c24dd3e908b2
msgctxt "h7db04fb3gc562g446cga529gebab5f5ba01c"
msgid ""
"Better to let stronger blood thrive. It can give rise to worthier foes and "
"hardier slaves. Don't disappoint me."
msgstr "강한 피는 번성하게 두는 것이 낫다. 더욱 가치 있는 적과 강인한 노예를 낳을 수 있으니 말이지. 나를 실망시키지 마라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 107bbcf2-8307-e415-be0f-0b26d45d2840
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:107bbcf2-8307-e415-be0f-0b26d45d2840
msgctxt "h9eed3e09g6365g44b7gb630gce19d28f635c"
msgid "You think you can worm your way into my head, simpleton? "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 13161f5d-9a5d-1b52-3ec3-68397edccc13
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_GithChokepoint_Event_MentionedWeapon = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:13161f5d-9a5d-1b52-3ec3-68397edccc13
msgctxt "heb49a4a5gff49g4f1egbbb6ga46da7d6fcca"
msgid ""
"Baretha! Rid us of this worm. I need to continue the hunt for the weapon."
msgstr "바레사! 이 지렁이를 밟아버려라. 난 무기 수색을 계속하겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Player
#. NodeID = 1353e2c3-edea-da04-3472-e025d3b2347e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:1353e2c3-edea-da04-3472-e025d3b2347e
msgctxt "hbab9cd5agb333g40a6g94b9gf38cb4112017"
msgid "I'll help if I can."
msgstr "도울 수 있는 게 있다면 돕지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Player
#. NodeID = 15c3fe35-00b3-a5ba-b0eb-14f25bb7880a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:15c3fe35-00b3-a5ba-b0eb-14f25bb7880a
msgctxt "hed0ddc21g3070g48eag9ee9g8a3e719b8e4d"
msgid "<i>Attack</i>."
msgstr "<i>공격한다</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 16110e1c-720c-3050-c06c-0ee26826816d
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:16110e1c-720c-3050-c06c-0ee26826816d
msgctxt "h6b3cc6d1g3f8fg4f27ga88egbc9d5cde0d1d"
msgid ""
"I'll take your silence as respect, kin. But I would have you speak now..."
msgstr "네 침묵은 존중으로 받아들이겠다, 동족이여. 하지만 이제는 말을 해야 할 거야..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 16110e1c-720c-3050-c06c-0ee26826816d
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:16110e1c-720c-3050-c06c-0ee26826816d
msgctxt "h3579a6e3g2e51g46c6ga13dgbdd192376f83"
msgid ""
"Hmm. You make good use of silence. Too many think hot air will save them..."
msgstr "흠. 침묵을 잘 활용하는구나. 많은 이들이 변명이나 늘어놓는 것이 스스로를 구할 방법이라고 생각하지..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Player
#. NodeID = 16fb1ded-2a89-34ad-fed0-c39ebfa13cec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:16fb1ded-2a89-34ad-fed0-c39ebfa13cec
msgctxt "h71d65dfcg1eaeg4958ga80cge2dfa8aff4a3"
msgid "I don't know of such a weapon."
msgstr "그런 무기는 모르겠는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 188f58f4-b208-95b9-4ef0-13ebaaaa01b1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_GithChokepoint_Quest_GithLeave = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:188f58f4-b208-95b9-4ef0-13ebaaaa01b1
msgctxt "h5026a6cegd23cg4bc8gaba2gbd0b762bfc72"
msgid "Baretha - keep hunting. And do better. Qudenos - we fly!"
msgstr "바레사 - 사냥을 계속해라. 그리고 더 잘해야 할 거다. 쿠데노스 - 하늘로!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 1899bf28-abe1-6230-a70a-d1f05c52acaf
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:1899bf28-abe1-6230-a70a-d1f05c52acaf
msgctxt "h37636c46g8641g429ega6b3gc7608d0b0eac"
msgid "Kill him. Make it swift and clean."
msgstr "그를 죽여라. 신속하고 깔끔하게 처리하도록."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 1899bf28-abe1-6230-a70a-d1f05c52acaf
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:1899bf28-abe1-6230-a70a-d1f05c52acaf
msgctxt "haa786515gca21g44e2ga525g8a7f4226d2b6"
msgid "Kill her. Make it swift and clean."
msgstr "그녀를 죽여라. 신속하고 깔끔하게 처리하도록."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 1899bf28-abe1-6230-a70a-d1f05c52acaf
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:1899bf28-abe1-6230-a70a-d1f05c52acaf
msgctxt "h0b238372gd4b1g4785g80e8gc3816f04a938"
msgid "Kill them. Make it swift and clean."
msgstr "그들을 죽여라. 신속하고 깔끔하게 처리하도록."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 1b5bbb74-a8f0-d9c6-81cb-ee791a409de6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_GithChokepoint_State_VossDeniedCure = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:1b5bbb74-a8f0-d9c6-81cb-ee791a409de6
msgctxt "h9f0be5e5g0230g427agb5c5gce3afb94d768"
msgid ""
"...It is true. You were corrupted by the filthy spawn of the <i>ghaik</i>. "
"Yet you still retrieved our queen's weapon."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 1c590746-5112-504c-70a5-b3cd01127305
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:1c590746-5112-504c-70a5-b3cd01127305
msgctxt "h2dd611d0g0e48g457bga930gdc37883cefcd"
msgid ""
"If I have no use for you alive, I'll have your death, slow and sweet. "
"Understand?"
msgstr "널 살려둘 이유가 없다면, 당장 널 죽여버리겠다, 아주 천천히 즐기면서 말이야. 알아듣겠나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Player
#. NodeID = 1c97ac50-1659-a05b-f85e-050f8c69f42d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:1c97ac50-1659-a05b-f85e-050f8c69f42d
msgctxt "h2b8764dbg02feg4a0fgb122gdd40825ff03f"
msgid "<i>Impersonate a fierce gith and refuse him any explanation.</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 1cf14d5a-0158-75a6-6d07-840bcf050c0c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:1cf14d5a-0158-75a6-6d07-840bcf050c0c
msgctxt "hc2b96ee1gae2bg4435ga458g7f4d0845ebaf"
msgid ""
"Of course you are not a threat! You are <i>nothing </i>until I tell you "
"otherwise."
msgstr "물론 위협이 되지 않겠지! 내가 너를 달리 부르지 않는 한, 너는 <i>아무것도</i> 아니니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 1e44a310-87ab-85ce-1bc5-bf7250111343
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_GithChokepoint_State_VossDeniedCure = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:1e44a310-87ab-85ce-1bc5-bf7250111343
msgctxt "h69d88b09g20d7g4eeag8137gf1d25e87f86c"
msgid ""
"<i>Ts'kva! </i>You carry a <i>ghaik </i>parasite in your head! Death will be "
"a kindness to you..."
msgstr "<i>스크바! </i>네놈은 머릿속에 <i>게이크</i>기생충을 달고 다니는군! 너에게는 죽음이 자비일 것이다..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 258c96be-ad8f-59fc-70ae-0593030057b1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_GithChokepoint_State_NonGithInTow = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:258c96be-ad8f-59fc-70ae-0593030057b1
msgctxt "hc7dc2569g25aeg4ad3gb24fg0b0b62058751"
msgid ""
"And in the company of local vermin...? Explain yourself, <i>vin'iisk</i>."
msgstr "게다가 이 구역 벌레들까지 데리고...? 정체를 밝혀라, <i>비니스크</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 262c8e84-7972-020a-ada2-b6254704f594
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:262c8e84-7972-020a-ada2-b6254704f594
msgctxt "h6ea871a4g6d48g4987g951fg8fa67e2211e4"
msgid ""
"But there's a repellent logic in your words. You may notice things a noble "
"gith does not."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 27256bfb-f4b6-4eca-339f-55240ac83b81
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_GithChokepoint_Event_MentionedWeapon = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:27256bfb-f4b6-4eca-339f-55240ac83b81
msgctxt "h93b4bee9g5af3g4824ga36cg4b2175330fbe"
msgid ""
"Baretha! Rid us of this disgrace. I have to continue my hunt for the weapon."
msgstr "바레사! 이 불경한 놈을 눈 앞에서 치우게. 난 계속해서 무기를 찾겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Player
#. NodeID = 27f43941-9450-af01-776d-4cc3b2354c43
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:27f43941-9450-af01-776d-4cc3b2354c43
msgctxt "h42294288g8c6dg48b9gb1e7gf95cde7bb37b"
msgid ""
"These are local guides. I'll get rid of them once they cease to be useful."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 2869d10b-c8a0-4b0b-8caf-652deca4ebc7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:2869d10b-c8a0-4b0b-8caf-652deca4ebc7
msgctxt "ha493e0beg0516g4572g8f9ag74f31993c74f"
msgid "The only value you hold is as meat to the carrion birds. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Player
#. NodeID = 2a296fb6-8dc7-5ccc-4851-23d1fdd827e8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:2a296fb6-8dc7-5ccc-4851-23d1fdd827e8
msgctxt "h33344cd1g13dbg477fgb810g22f08fbd2cb5"
msgid "<i>Do nothing.</i>"
msgstr "<i>아무것도 하지 않는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Player
#. NodeID = 2b88c849-be6d-d941-bf3b-2fcdd3c9731d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:2b88c849-be6d-d941-bf3b-2fcdd3c9731d
msgctxt "hc30a082dgdceag4a73g9fe4g95aea849105e"
msgid "Honestly? I'm not really a gith."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Player
#. NodeID = 2e9f92ef-fcca-aea0-f8ce-ef970549e8f9
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Dexterity
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:2e9f92ef-fcca-aea0-f8ce-ef970549e8f9
msgctxt "h3a44a7ffg09bag4966g9d5cgf2ffb94b6f18"
msgid "<i>Silently hold his stare and discreetly prepare to attack.</i>"
msgstr "<i>조용히 그를 응시하며 조심스럽게 공격할 준비를 한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 30a72f06-9bda-145a-a25c-d4bf5c22d291
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:30a72f06-9bda-145a-a25c-d4bf5c22d291
msgctxt "heb184a13g3757g4b2fg8ac9gdfc02d2ccb3d"
msgid "No creature from this wretched world is important, half-wit."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Player
#. NodeID = 42935da1-b556-64b0-ccdd-7fe521e43b2f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:42935da1-b556-64b0-ccdd-7fe521e43b2f
msgctxt "h41092fa2g8edbg4ff1ga78fg1ac8dc26b828"
msgid "I am no crèche hatchling. Do not speak to me as one."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 4928e7e1-932c-e073-6928-4d2818e7edd5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_GithChokepoint_Event_MentionedWeapon = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:4928e7e1-932c-e073-6928-4d2818e7edd5
msgctxt "h2e964d0cg03a5g46f2g877eg54bfccfc0003"
msgid ""
"Baretha! Kill this fiend. I will continue to hunt for the weapon elsewhere."
msgstr "바레사! 이 마족을 죽여라. 난 계속 무기의 위치를 찾아내겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 497afec0-dbe9-856b-8cab-cb892de760b4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:497afec0-dbe9-856b-8cab-cb892de760b4
msgctxt "h23270d27g4cd3g4960gad55gfa8f314ccb6c"
msgid ""
"Help us find it and I will leave your blood beneath your skin, unspilled."
msgstr "우리 수색을 돕는다면 네 살갗 밑의 피는 보존할 수 있을 것이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 4b8d9736-882f-0feb-c379-3c54b86d992c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:4b8d9736-882f-0feb-c379-3c54b86d992c
msgctxt "hc3bbe21fg597dg4bfdgb0c7g3561b33a25a2"
msgid "<i>Tsk'va! </i>You seek to impersonate us? To <i>spy </i>on us?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Player
#. NodeID = 4cd046b1-0a5a-b6ad-8182-aa3af4ff0fbc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:4cd046b1-0a5a-b6ad-8182-aa3af4ff0fbc
msgctxt "h10ecd7c5g6c93g46bfg8b30ge21b35e360e4"
msgid "<i>Show deference. Bow and explain that you are lost.</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 4d21e8d9-7006-227c-4d01-2080af9a6843
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:4d21e8d9-7006-227c-4d01-2080af9a6843
msgctxt "hd09dc5a5gae73g4868g83d1gd5eae9a67b51"
msgid ""
"You have done well, in spite of your affliction. Allow me to reward you. "
"Baretha?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Player
#. NodeID = 4e97fbe9-4bf2-666a-0a20-28f0568e6949
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DROWELF(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:4e97fbe9-4bf2-666a-0a20-28f0568e6949
msgctxt "h15d02748g8b0fg41e9g9f37g2451d5745ac6"
msgid "Don't be foolish. I have powerful allies."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 5180311b-fa50-a47c-d89d-9bc7981e07de
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:5180311b-fa50-a47c-d89d-9bc7981e07de
msgctxt "h4d3616e6g2ea5g40degb117gc893d0912bd1"
msgid ""
"It is polyhedric in shape, inscribed with the sacred runes of our people. It "
"is our queen's, and she shall have it back."
msgstr "그것은 다면체 형태이고, 우리 종족의 성스러운 룬 문자가 새겨져 있다. 여왕님의 것이며, 그분께서 돌려받길 원한다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Narrator
#. NodeID = 54166f15-0c27-3367-7a4f-781b352ae30b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:54166f15-0c27-3367-7a4f-781b352ae30b
msgctxt "hd8a84f79g601ag4b4eg8524gb6cc835c61d7"
msgid ""
"*You attune your mind to it. The artefact does not want to part from you. It "
"does not want to fall into the gith raiders' hands.*"
msgstr ""
"*당신은 그것에 당신의 정신을 조율해봅니다. 아티팩트는 당신과 떨어지고 싶지 않습니다. 기스 습격자들의 손에 들어가길 원치 않습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Player
#. NodeID = 55663ecc-42ff-859b-88c8-32f9e08bf3e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:55663ecc-42ff-859b-88c8-32f9e08bf3e6
msgctxt "h2185d3fcg4695g4977g8569g6ecd588eebc3"
msgid "<i>Say nothing.</i>"
msgstr "<i>아무 말도 하지 않는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Sarth Baretha
#. NodeID = 563e67aa-4292-dafe-69cd-f17247249181
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:563e67aa-4292-dafe-69cd-f17247249181
msgctxt "hf792fe5cg2a21g452dg9e71g5f5656bd28a1"
msgid "At once... <i>Htak'a!</i>"
msgstr "분부대로... <i>흐타카!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 565a3bda-8949-6435-cac5-1b08ca747a5a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:565a3bda-8949-6435-cac5-1b08ca747a5a
msgctxt "h80981f03g5c0bg4b74g813agfca620be507f"
msgid ""
"We must not linger among such cattle. Even their warriors' blood shames our "
"blades."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Player
#. NodeID = 56d375df-47ca-ff69-95d8-295bf10ca70b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:56d375df-47ca-ff69-95d8-295bf10ca70b
msgctxt "h0032b577g9aa0g42f0ga531g638be3c7fa00"
msgid "I need to know more. What is its appearance? Its purpose?"
msgstr "더 알아야겠는데. 어떻게 생겼지? 어디에 쓰이는 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Player
#. NodeID = 577ea642-56aa-0976-ab4a-a242847b9230
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - PALADIN(2) = True
#.      - OATHBREAKER(2) = False
#. TagRule: PALADIN_DEVOTION
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:577ea642-56aa-0976-ab4a-a242847b9230
msgctxt "h17eb71e8gdd93g4025g9e13ge6bc43c053c7"
msgid ""
"Did you not <i>feel</i> the devotion when inside my head? I could be an "
"invaluable ally. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Player
#. NodeID = 577ea642-56aa-0976-ab4a-a242847b9230
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - PALADIN(2) = True
#.      - OATHBREAKER(2) = False
#. TagRule: PALADIN_ANCIENTS
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:577ea642-56aa-0976-ab4a-a242847b9230
msgctxt "h4f0a32e6g1752g46bbg9b21gc71bfabd3a07"
msgid ""
"You must've seen my knowledge of these ancient lands. I could be of use to "
"you."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Player
#. NodeID = 577ea642-56aa-0976-ab4a-a242847b9230
#. HandlePath = TaggedText[2].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - PALADIN(2) = True
#.      - OATHBREAKER(2) = False
#. TagRule: PALADIN_VENGEANCE and NOT_FOR_EA
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:577ea642-56aa-0976-ab4a-a242847b9230
msgctxt "hed2488a5g86ecg494eg897eg0230f75836b7"
msgid "You saw how ruthlessly I pursue my goals. I can help you. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Player
#. NodeID = 57dbc178-fb55-caf7-3639-1c333f37f01d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ROGUE(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:57dbc178-fb55-caf7-3639-1c333f37f01d
msgctxt "ha95a2612g08ccg4dccg90a9g547c9691d43c"
msgid "A corpse is useless. But a living informant might unearth something."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 57facaef-3da7-b3c5-44ea-8cc862a619c6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_GithChokepoint_Event_MentionedWeapon = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:57facaef-3da7-b3c5-44ea-8cc862a619c6
msgctxt "h36e6432dge449g45dfg8299g7c1deaa17064"
msgid ""
"A vessel fell from the sky. We seek a precious weapon that was taken from it."
msgstr "하늘에서 함선이 추락했다. 그리고 우린 그곳에서 탈취된 귀중한 무기를 찾고 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 58084254-3094-0e34-0be9-02cba7cf3a26
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:58084254-3094-0e34-0be9-02cba7cf3a26
#, fuzzy
msgctxt "h88d19165g0bf4g4a01ga1e5g958bcabde89c"
msgid "Unlikely. But it costs me nothing to spare your sorry life."
msgstr "그럴 가능성은 낮겠지만, 그건 내가 너의 애처로운 목숨을 살려주는데 아무런 도움이 되지 않는다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 59708b5a-9519-9f4f-b444-14c3cc2aeb9a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:59708b5a-9519-9f4f-b444-14c3cc2aeb9a
msgctxt "h4cf62971gb907g4262ga19bg5bf7adf24a0e"
msgid "Cunning. You will do well, <i>vin'iisk</i>."
msgstr "교활하군. 잘 해라, <i>비니스크</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 5b31a146-626c-a43c-b028-eebcb8580899
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:5b31a146-626c-a43c-b028-eebcb8580899
msgctxt "hf9892d3cg95abg4a71ga16fg6bfa57546544"
msgid ""
"It cannot be... You have the weapon? Someone would have reported it to me."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Narrator
#. NodeID = 5bb083d7-0516-90a4-77be-4df8b403efb6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:5bb083d7-0516-90a4-77be-4df8b403efb6
msgctxt "hc260a5c3g279fg4aeaga2c7g6350cc4c50c4"
msgid "*You realise he's casting Detect Thoughts.*"
msgstr "*당신은 그가 생각 탐지를 시전하고 있다는 사실을 깨닫습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 5c7318cb-1f99-b496-0cf1-5d291450a089
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:5c7318cb-1f99-b496-0cf1-5d291450a089
msgctxt "hb7af6dc6gfc4bg4901ga1deg8b2bba00e886"
msgid "Baretha! Kill this insolent worm. I need to continue my hunt."
msgstr "바레사! 이 건방진 지렁이를 밟아버려라. 난 사냥을 계속 해야 하니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Narrator
#. NodeID = 5f41234c-ac67-2a3a-0a16-1ec0fce83253
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:5f41234c-ac67-2a3a-0a16-1ec0fce83253
msgctxt "hce8da829g7fdag43dbg8773g2cdace3e82e5"
msgid ""
"*The gestures mean nothing to you - some sort of spell that you don't "
"recognise.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 60efcf2f-6305-f326-cf77-f7e2d5d635ce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:60efcf2f-6305-f326-cf77-f7e2d5d635ce
msgctxt "h3fecc470g7ab5g4c7agb369g2b9aff34e44d"
msgid ""
"Curious. I thought even the lowest of creatures had at least a shred of "
"dignity. You prove me wrong."
msgstr "흥미롭군. 난 가장 열등한 생물 조차도 조금의 품위는 가지고 있다고 생각했는데. 자네가 아님을 증명해줬군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Player
#. NodeID = 61b2c62a-6ec4-c818-002f-05bc20580bf4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:61b2c62a-6ec4-c818-002f-05bc20580bf4
msgctxt "h995a4546g1a72g4bdcg9699g39fc31f854c8"
msgid ""
"You'll need to start from the beginning - what is this weapon you're after?"
msgstr "다시 설명해 줘, 너희가 쫓는 이 무기라는 게 뭐지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 6b99be1f-f106-5fec-a77e-7718fa16499d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:6b99be1f-f106-5fec-a77e-7718fa16499d
msgctxt "h5e86dedag1c75g4844g9f4agde546629d884"
msgid ""
"Take them to the crèche. And see about fetching reinforcements. But first, a "
"question..."
msgstr "그들을 양성소로 데려가라. 그리고 지원군을 데려올 방법을 알아봐라. 하지만, 그 전에 질문 하나만 하지..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Narrator
#. NodeID = 6d1cf1a8-d8e9-c6a2-29fa-bb4fab4a1e39
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:6d1cf1a8-d8e9-c6a2-29fa-bb4fab4a1e39
msgctxt "h10ac2248gb62cg433dgb3c3g1c2b0ffe60f2"
msgid ""
"*You attune your mind to it. The artefact does not want to part from you. It "
"does not want to fall into the gith raiders' hands.*"
msgstr ""
"*당신은 그것에 당신의 정신을 조율해봅니다. 아티팩트는 당신과 떨어지고 싶지 않습니다. 기스 습격자들의 손에 들어가길 원치 않습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Player
#. NodeID = 6d512aba-324a-11da-d88b-40e1de512088
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 0
#. CheckFlags:
#.   Local:
#.      - 4dd8c77c-d075-b1b3-1690-7a46dc8b8fb8_MindHasBeenRead = False
#.   Script:
#.      - GEN_CanDetectThoughts_3 = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:6d512aba-324a-11da-d88b-40e1de512088
msgctxt "h8e9fda8fgcfbfg429fgbb9cg3ef93e04898f"
msgid "<i>Read his thoughts.</i>"
msgstr "<i>그의 생각을 읽는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 6e60ec47-fbb7-c4ef-9c88-462af4fa3a83
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:6e60ec47-fbb7-c4ef-9c88-462af4fa3a83
msgctxt "hcf9ef130g1a03g4ccbgbef8gbb312a7a83ef"
msgid "<i>Pa'vrylk! </i>You twist our noble words with a coward's tongue!"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 6ff65ae6-fd78-8830-70bd-5c91f92fc7e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:6ff65ae6-fd78-8830-70bd-5c91f92fc7e6
msgctxt "h88329904g1f78g4409gbd2ag96dbff442922"
msgid "Baretha! Show this worm its place. I need to continue my hunt."
msgstr "바레사! 이 벌레에게 자기 위치를 알려주도록. 난 사냥을 계속하겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Narrator
#. NodeID = 718aedd3-ccc7-d918-8190-b31ca380cb52
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:718aedd3-ccc7-d918-8190-b31ca380cb52
msgctxt "he6523a3ag9848g4381g9529g239c14a9a376"
msgid "*He begins to move his hand in a quick flurry of gestures.*"
msgstr "*그가 손을 재빠르게 움직이기 시작합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Narrator
#. NodeID = 729e739d-1ce5-d6ca-3700-871dd170d6a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:729e739d-1ce5-d6ca-3700-871dd170d6a8
msgctxt "hec79073dgdcb8g43e9g9ca7g765c307a1d96"
msgid ""
"*Her mind focuses - the giths' suspicion cannot be aroused. They cannot "
"discover that the weapon they seek is right within their grasp.*"
msgstr ""
"*그녀가 정신을 집중합니다. 기스의 의심을 불러와서는 안 됩니다. 그들이 찾고 있는 무기가 바로 그들 눈앞에 있다는 사실을 알게 할 수는 "
"없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 73797d0e-9548-95c0-983d-0e8a36812429
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:73797d0e-9548-95c0-983d-0e8a36812429
msgctxt "h8160d450ge32eg4d7dga050g9b7693f14a70"
msgid "Do not speak. Your bleating offends my ears. Just stand still..."
msgstr "그만. 네놈의 재잘거리는 목소리가 거슬리는군. 그냥 제 자리에 서 있도록..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Narrator
#. NodeID = 757dec2c-2ccd-249d-6468-a97f00f12ace
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:757dec2c-2ccd-249d-6468-a97f00f12ace
msgctxt "h0565377cge256g4650g98e5g1e1cd4f31fa3"
msgid ""
"*You feel Shadowheart's anxiety. The weapon that Voss seeks - it's the "
"artefact that she carries.*"
msgstr "*섀도하트의 불안감이 느껴집니다. 보스가 찾고 있는 무기, 그건 바로 그녀가 가지고 다니는 아티팩트입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Player
#. NodeID = 7625abef-55bc-a47b-fe99-6b90f6e60a6a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ROGUE(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:7625abef-55bc-a47b-fe99-6b90f6e60a6a
msgctxt "h5df63514g245ag48bdgafdbg946b386bdafb"
msgid "<i>Claim you're an important person. A valuable hostage - or ally.</i>"
msgstr "<i>당신이 귀중한 아군이나, 포로로 활용할 수 있는 중요한 인물임을 강조한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Shadowheart
#. NodeID = 773a1cea-25b2-4fec-3b11-f082407b58ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:773a1cea-25b2-4fec-3b11-f082407b58ae
msgctxt "h84ae9b3bg0509g4d99gb38dg1c53cc1edf3a"
msgid "Don't help them. Don't tell them a thing. We're dead if you do."
msgstr "그들을 돕지 마. 그들에게 아무것도 알려주면 안 돼. 그렇지 않으면 우린 죽은 목숨이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 7771cf19-547a-70da-e250-4ae773d8fc8e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:7771cf19-547a-70da-e250-4ae773d8fc8e
#, fuzzy
msgctxt "h0d3c7714g4173g4977g998bgbe3ff4e34de5"
msgid ""
"...but I suppose you are young and untested. This world can be confounding "
"to navigate."
msgstr "...하지만 자네는 어리고 미숙해 보이는군. 이 세상은 탐험하기에 혼란스러울 수 있다네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 7aeb9e9a-c055-07b8-0c4d-90d7bb64091c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:7aeb9e9a-c055-07b8-0c4d-90d7bb64091c
msgctxt "h964051fegee03g46fcg974dgbb4600f98129"
msgid ""
"Ha! Your tongue is still sharp - good. This soft world can dull our wits."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 7b037fb5-3357-72f8-ab47-7e02c47f291e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:7b037fb5-3357-72f8-ab47-7e02c47f291e
msgctxt "h3d623445gcfd6g4c87ga8a9g692108a93274"
msgid "What's this...?"
msgstr "이건 무엇인가...?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 7b53613f-e8e6-12f6-c7f5-bb9191668a6a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:7b53613f-e8e6-12f6-c7f5-bb9191668a6a
msgctxt "h91106c67g0ac1g479bgb8cbgc1e0ffa4fdf5"
msgid "And as for you, tell me - why shouldn't I run you through this instant?"
msgstr "그리고 너, 말해 보거라. 내가 널 당장 베어버리지 않을 이유가 뭐가 있지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 7c127b59-d29f-788b-3a11-dff5e0b92830
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_GithChokepoint_State_NonGithInTow = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:7c127b59-d29f-788b-3a11-dff5e0b92830
msgctxt "ha827edecg0e52g401dg837bg8350ecf1d855"
msgid "Explain yourself, <i>vin'iisk</i>."
msgstr "네 스스로 설명해봐라, <i>비니스크</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Player
#. NodeID = 7de85710-f756-cc60-fa15-939128007a75
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(2) = True
#. TagRule: BERSERKER
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:7de85710-f756-cc60-fa15-939128007a75
msgctxt "he1771d51g7fd9g4014g9a73g62334c6ec94e"
msgid "<b><i>ROAR.</i></b>"
msgstr "<b><i>크아아.</i></b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Player
#. NodeID = 7de85710-f756-cc60-fa15-939128007a75
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:7de85710-f756-cc60-fa15-939128007a75
msgctxt "hc8b6b2d4ge143g414fgad73g2dcbc850935f"
msgid "Give it a try. I'm hungry for a little fun."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 7f63245a-cde0-7b61-9610-700d1c862d60
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:7f63245a-cde0-7b61-9610-700d1c862d60
msgctxt "h7914293cge536g4945g8e58g551cbd5d6f32"
msgid "Help? Absurd. You're already a hindrance, wasting my time."
msgstr "도움이 된다고? 터무니 없군. 자네는 이미 내 시간만 먹는 방해 요소야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Narrator
#. NodeID = 82f53ed0-0272-962f-cf1f-f2d95c994e70
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Orpheus_Knows_GobLookingForWeapon = True
#.   Tag:
#.      - AVATAR(2) = True
#.      - REALLY_SHADOWHEART(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:82f53ed0-0272-962f-cf1f-f2d95c994e70
msgctxt "h824111bcg25aag420dgaeedg460f0fa03674"
msgid ""
"*You realise that the weapon Voss speaks of is the gith artefact you carry. "
"You must keep it from him, just as you must keep it from the Absolute.*"
msgstr ""
"*보스가 말하는 이 무기는 바로 당신이 들고 다니는 아티팩트입니다. 절대자에게서 이걸 지켜야 하는 것과 마찬가지로, 보스의 손에도 "
"들어가지 않도록 지켜야만 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 82f6fdf5-32f9-8318-7507-120750e4fa8f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:82f6fdf5-32f9-8318-7507-120750e4fa8f
#, fuzzy
msgctxt "h5829a5eegf42cg45a4ga3deg006ff000338b"
msgid "Killing vermin requires no daring."
msgstr "고작 쥐새끼를 밟아 죽이는데 큰 힘을 쓸 필요는 없지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Narrator
#. NodeID = 8368a747-2cbc-b5ac-d1be-628daef8ff8d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Orpheus_Knows_GobLookingForWeapon = True
#.   Tag:
#.      - REALLY_SHADOWHEART(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:8368a747-2cbc-b5ac-d1be-628daef8ff8d
msgctxt "h18557024g856bg476bg8c46ge509a35ea5bc"
msgid ""
"*You feel Shadowheart's anxiety. The weapon that Voss seeks is the same one "
"the Absolute's followers are hunting - it's the artefact that she carries.*"
msgstr ""
"*섀도하트의 불안감이 느껴집니다. 보스가 찾는 무기는 절대자의 추종자들이 노리는 바로 그 물건입니다. 바로 그녀가 지닌 아티팩트 "
"말입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 87e81ac1-0acf-51b6-0676-15332c923a53
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_GithChokepoint_Event_MentionedWeapon = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:87e81ac1-0acf-51b6-0676-15332c923a53
msgctxt "h9f8332e2ge47bg4eb5g8881ge98b2823459c"
msgid ""
"Now, we seek a weapon, taken from a vessel that fell from the sky. "
"Understand, <i>istik</i>?"
msgstr "지금부터, 우리는 하늘에서 떨어진 함선으로부터 나온 무기를 찾는다. 이해했나, <i>이스틱</i>?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 8e65e2cc-02ec-ed4b-f014-1ca0148a903b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_GithChokepoint_Event_ContinueFromLaezel = True
#.   Tag:
#.      - GITHYANKI(2) = True
#. SetFlags:
#.   Global:
#.     - PLA_GithChokepoint_State_SpokeToVoss = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:8e65e2cc-02ec-ed4b-f014-1ca0148a903b
msgctxt "hd804170agc603g4154ga86ag54f2a20515a2"
msgid ""
"You are unknown to me, kin. Are you straight from the crèche, wandering "
"<i>unbidden</i>?"
msgstr "처음 보는 얼굴이군, 양성소에서 바로 온 건가, <i>허락도 없이</i> 어슬렁거리면서?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 91c7eba7-2cb8-6d23-e905-7809da91f770
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:91c7eba7-2cb8-6d23-e905-7809da91f770
msgctxt "hf27edefbg49fbg41d8g91f4gc3d965b35f2b"
msgid ""
"How diligent you are, <i>vin'iisk</i>. If only all of our queen's warriors "
"served with such rigour."
msgstr "부지런하군, <i>비니스크</i>. 모든 여왕님의 전사가 이렇게 성실하면 좋으련만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 952a4004-53a2-4fd9-658b-f502858664d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:952a4004-53a2-4fd9-658b-f502858664d4
msgctxt "h297c5d70g2c8dg46c3g99f3g7692a4f82dcf"
msgid ""
"But your bravery amuses me. Finally I find a wolf in a world of lowing "
"cattle..."
msgstr "그렇지만 너의 용기가 나를 즐겁게 하는구나. 하찮은 가축들의 세계에서 마침내 늑대 한 마리를 찾았어..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Player
#. NodeID = 96fa36cd-a7d0-3645-523d-d1e6c04fe179
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:96fa36cd-a7d0-3645-523d-d1e6c04fe179
msgctxt "h66c46b33gc85fg4cf1g9797gbfb7d5b80272"
msgid "Why are you hesitating, then? Try it, I dare you."
msgstr "그럼 뭘 망설이는 거야? 어서, 덤벼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 970caa40-6aac-516d-cbe9-531b1aa2b1a1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:970caa40-6aac-516d-cbe9-531b1aa2b1a1
msgctxt "hadbb397dg8564g4c0dg9c30g9b6fd40f2743"
msgid ""
"Your lips spill <i>falsehoods</i>! You have taken on the soft, cowardly ways "
"of this world."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Player
#. NodeID = 97202838-d42e-3e91-d54d-7ca19575bcbb
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:97202838-d42e-3e91-d54d-7ca19575bcbb
msgctxt "h1d9ff2a7g19b0g46d0gbd14g2af5154cbed2"
msgid ""
"<i>In the gith tongue, explain that they are local guides - to be killed "
"once they cease to be useful.</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Narrator
#. NodeID = 9766ae2f-12d7-153d-3761-264c48796dff
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - AVATAR(2) = True
#.      - REALLY_SHADOWHEART(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:9766ae2f-12d7-153d-3761-264c48796dff
msgctxt "h5eaca970g254eg4898gb4e8g8356aff66ffd"
msgid ""
"*You realise that the weapon Voss speaks of is the gith artefact you carry. "
"You cannot let him discover it - no matter what.*"
msgstr ""
"*보스가 말하는 이 무기가, 당신이 들고 다니는 아티팩트라는 것을 깨닫습니다. 그가 알아채게 둘 수는 없습니다... 어떤 수를 써서라도 "
"말입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 97ae12d2-1c90-bd90-9882-722f8fbd5474
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_Knows_CrecheLocation = True
#.     - PLA_GithChokepoint_State_VossRevealedLocation = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:97ae12d2-1c90-bd90-9882-722f8fbd5474
msgctxt "h3c88395ag4471g422ega0a2gecf3002c37ed"
msgid ""
"Bring me their heads. Bring me the <i>weapon</i>. If you succeed, the reward "
"will be great."
msgstr "그들의 머리와 <i>무기</i>를 가져와라. 네가 성공한다면, 엄청난 보상을 내리겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 990448ca-0027-336c-26b7-d33f172c6585
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:990448ca-0027-336c-26b7-d33f172c6585
msgctxt "h1ecadbeag28fdg4ddbg992bg19313f4aef23"
msgid "It cannot be."
msgstr "이럴 수가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Player
#. NodeID = 9dacb367-c7b8-140b-f3d5-092b99ed273e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:9dacb367-c7b8-140b-f3d5-092b99ed273e
msgctxt "h6dfa9578gdda6g4cedgb639g4a506017f92e"
msgid "Indeed. I came from the crèche."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 9ebaa32e-0368-8e6d-ee4f-e2186b7f5b8d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(2) = False
#. SetFlags:
#.   Global:
#.     - PLA_GithChokepoint_State_SpokeToVoss = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:9ebaa32e-0368-8e6d-ee4f-e2186b7f5b8d
msgctxt "h5ab674a0g3810g44cegb859geba4f9c3b27b"
msgid ""
"These creatures are so simple to ensnare, Baretha. You mewl too much about "
"your task."
msgstr "이 생물들은 너무나 쉽게 덫에 제 발로 걸어들어오는구나, 바레사. 이런데도 넌 네 임무에 대해 너무 많이 불평하는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = 9fb409d9-28ad-f7d7-6c9f-771491f202fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:9fb409d9-28ad-f7d7-6c9f-771491f202fd
msgctxt "h72db30f3gfb7cg4bcega452g11c4358fecfe"
msgid ""
"<i>Chk!</i> You dare speak to me like my better? Others have died for lesser "
"insults - <i>slowly</i>."
msgstr "<i>츠크!</i> 감히 나에게 잘난 척을 해? 이보다 덜한 모욕을 한 자들도 죽었어. <i>천천히</i> 말이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Sarth Baretha
#. NodeID = a113d748-98d8-66d7-b853-64b6665ed60f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:a113d748-98d8-66d7-b853-64b6665ed60f
msgctxt "he5fb3eceg4333g47cbg848cg71f50e6b60f8"
msgid "At once... <i>Htak'a!</i>"
msgstr "분부대로... <i>흐타카!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Player
#. NodeID = a1682cda-482d-cad8-70ff-521a13e0cb1e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:a1682cda-482d-cad8-70ff-521a13e0cb1e
msgctxt "h344cab13g5777g4408g87b6g7d844283fb33"
msgid ""
"They are my prisoners. I intend to bring them to the crèche for "
"interrogation."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Player
#. NodeID = a32c9d68-c0f9-43d8-de47-ec028c15c4e8
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:a32c9d68-c0f9-43d8-de47-ec028c15c4e8
msgctxt "h21dcf568g7902g44d8gb81eg30a03e428eb8"
msgid "<i>Resist the probing into your mind.</i>"
msgstr "<i>그가 정신에 파고드는 것에 저항한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = a428b0e8-339c-5f5e-faed-d3c2b4bf4390
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_GithChokepoint_Quest_GithLeave = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:a428b0e8-339c-5f5e-faed-d3c2b4bf4390
msgctxt "h13420f7bgdc7dg4472g92c6gd665343be53f"
msgid "Now go."
msgstr "이제 가보거라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Player
#. NodeID = a4f992e8-28bc-4c50-961a-9b9487ab8219
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:a4f992e8-28bc-4c50-961a-9b9487ab8219
msgctxt "hf8e6ec25g4d61g41b4gaeeegb9645cc9a8a0"
msgid "<i>Play along as a gith. Say you're indeed from the crèche.</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Narrator
#. NodeID = a686be8d-f063-c534-25fa-15ac2c5c00a0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:a686be8d-f063-c534-25fa-15ac2c5c00a0
msgctxt "h79eff4abg34eeg4097g9127gdd55c9356cd1"
msgid ""
"*You feel a presence in your head - the <i>kith'rak</i>'s presence. Your "
"tadpole recoils defensively.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Player
#. NodeID = a6d9c43f-bc54-36b6-df56-2366ea03315b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:a6d9c43f-bc54-36b6-df56-2366ea03315b
msgctxt "h552ffc03g5174g459egb076g57913cd7f263"
msgid "<i>Tell him about your parasite and ask for help.</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Narrator
#. NodeID = a8ebc7bb-f436-c966-5a3b-b82b6288382f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Orpheus_Knows_GobLookingForWeapon = True
#.   Tag:
#.      - AVATAR(2) = True
#.      - REALLY_SHADOWHEART(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:a8ebc7bb-f436-c966-5a3b-b82b6288382f
msgctxt "hf5e737f1g34f0g4db5ga9acg1cc44f736dad"
msgid ""
"*You realise that the weapon Voss speaks of is the gith artefact you carry. "
"You must keep it from him, just as you must keep it from the Absolute.*"
msgstr ""
"*보스가 말하는 이 무기는 바로 당신이 들고 다니는 아티팩트입니다. 절대자에게서 이걸 지켜야 하는 것과 마찬가지로, 보스의 손에도 "
"들어가지 않도록 지켜야만 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = a8f03132-e98a-0e62-8298-5d25a02b1f56
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:a8f03132-e98a-0e62-8298-5d25a02b1f56
msgctxt "h7130e467g61b9g4e93ga46bgfeb764e7c2d9"
msgid "Then they can mourn for you."
msgstr "그럼 그 강한 동맹이 자네를 위해 애도할 수 있겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Player
#. NodeID = a92cb366-fa5d-ba0e-807b-1a26ffdc1180
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 5
#. TagRule: SORCERER or WARLOCK or WIZARD
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:a92cb366-fa5d-ba0e-807b-1a26ffdc1180
msgctxt "h04bb64ccg5ff6g40f8ga705g0eed1d10d670"
msgid "<i>He is casting Detect Thoughts - steel your mind to resist it.</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = a9931887-79e1-1d04-007d-ba80a9c90d40
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_GithChokepoint_Event_MentionedWeapon = True
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:a9931887-79e1-1d04-007d-ba80a9c90d40
#, fuzzy
msgctxt "h10d88c4agb2deg4b93gba2eg80f3ded69330"
msgid ""
"No matter. Baretha! This one is no kin to us. Kill him. I will continue "
"searching for the weapon."
msgstr "문제 없다. 바레사! 이 자는 우리의 동족이 아니다. 그를 죽여라. 난 계속해서 무기를 찾을 테니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = a9931887-79e1-1d04-007d-ba80a9c90d40
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_GithChokepoint_Event_MentionedWeapon = True
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:a9931887-79e1-1d04-007d-ba80a9c90d40
msgctxt "hb5abc484g8823g47b8g99a5ga0a0f4c0eef0"
msgid ""
"No matter. Baretha! This one is no kin to us. Kill her. I will continue "
"searching for the weapon."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = a9931887-79e1-1d04-007d-ba80a9c90d40
#. HandlePath = TaggedText[2].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_GithChokepoint_Event_MentionedWeapon = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:a9931887-79e1-1d04-007d-ba80a9c90d40
msgctxt "h6b937790g8b69g4a62g909ega47f532ce6f8"
msgid ""
"No matter. Baretha! This one is no kin to us. Kill them. I will continue "
"searching for the weapon."
msgstr "문제 없다. 바레사! 이 자들은 우리 동족이 아니다. 그들을 죽여라. 난 계속해서 무기를 찾겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = a9bff450-d533-9a00-76fd-91edf894ecbf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:a9bff450-d533-9a00-76fd-91edf894ecbf
msgctxt "h4ee976begd9c9g4496g821fgfe9de44dbbee"
msgid ""
"In gratitude, I'll grant you a swift death. Baretha? You know what to do."
msgstr "감사의 표시로, 너에게 빠른 죽음을 선사하마. 바레사? 뭘 해야 하는지 알겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = ab0e5aa8-4029-55a1-06c2-a6392df0a121
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:ab0e5aa8-4029-55a1-06c2-a6392df0a121
msgctxt "h15b2edd3g6d63g47dcga7e3gba3ce885bc0b"
msgid "Of course! Obedience is your only hope. Now stand still..."
msgstr "그래야지! 복종이 너의 유일한 희망이다. 이제 가만히 서 있어라..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Player
#. NodeID = abb6ba0e-2f4a-c011-8734-f52933952ee7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:abb6ba0e-2f4a-c011-8734-f52933952ee7
msgctxt "h9cfe08e1g3487g43f0gb88ag7520deafe890"
msgid ""
"<i>Lie. Claim you saw bandits loot a wreck, then set off to the west.</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Player
#. NodeID = ac97d815-ee1a-43a8-09ec-1be6e90ad690
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:ac97d815-ee1a-43a8-09ec-1be6e90ad690
msgctxt "h11949214g20c8g4752gb261gbb002bb34d3e"
msgid ""
"You would've done so already if you didn't want something from me first."
msgstr "네가 원하는 바가 없었다면, 진작 그렇게 했겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Player
#. NodeID = adacac93-74d6-e552-89c8-bf3997360bbf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:adacac93-74d6-e552-89c8-bf3997360bbf
msgctxt "h4dc86ab9g983cg4b28gb6f9gcb15a84d28c2"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = b39c2331-037e-a10a-61ca-dce83a86091e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:b39c2331-037e-a10a-61ca-dce83a86091e
msgctxt "hb800b1e0g751fg4268g9428g48d9bdc8c51a"
msgid ""
"Senseless creature - I don't want to dull my blade on your overly thick "
"skull."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Player
#. NodeID = b5fcba8a-f3cf-4817-e95f-2dbc9acd4391
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 10
#. TagRule: !(SORCERER and WARLOCK and WIZARD)
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:b5fcba8a-f3cf-4817-e95f-2dbc9acd4391
msgctxt "he4c04f46g3139g4a72g93cdge9094b6b067c"
msgid "<i>Silently interpret the meaning of the gestures.</i>"
msgstr "<i>조용히 손동작의 의미를 파악한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Narrator
#. NodeID = b644ca5c-4218-5f9b-1c98-9267ba9d4468
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:b644ca5c-4218-5f9b-1c98-9267ba9d4468
msgctxt "h9795eac1g602cg467cg8ac9g2a50d7d53376"
msgid ""
"*You feel Shadowheart's anxiety. The weapon that Voss seeks - it's the "
"artefact that she carries.*"
msgstr "*섀도하트의 불안감이 느껴집니다. 보스가 찾고 있는 무기, 그건 바로 그녀가 가지고 다니는 아티팩트입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Narrator
#. NodeID = ba73cf61-6944-bc12-49d8-ca2547b2e3b5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:ba73cf61-6944-bc12-49d8-ca2547b2e3b5
msgctxt "h52f18da3g76f4g4f34g8596g58cbe4e2d131"
msgid ""
"*You realise he is casting Detect Thoughts. You feel him rummaging in your "
"head already.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = bb16eaab-df9c-e16a-0146-a4ef29dfc2e7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_Knows_CrecheLocation = True
#.     - PLA_GithChokepoint_State_VossRevealedLocation = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:bb16eaab-df9c-e16a-0146-a4ef29dfc2e7
msgctxt "hf46012bfgfb6cg48e3gb563gfa7d47829609"
msgid ""
"Clearly you know nothing of this, <i>vin'iisk</i>. No matter, it will be "
"found. Make for the crèche."
msgstr "전혀 모르고 있군, <i>비니스크</i>. 상관 없다, 찾을 테니. 양성소를 위해서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = bcde1519-8470-670f-63a3-35d2344c1c29
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:bcde1519-8470-670f-63a3-35d2344c1c29
msgctxt "hf386f0ffgaeb1g40d3ga0c5g06f1025aac1a"
msgid "<i>Threat? </i>Pah! You are no threat, stray."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = bcde1519-8470-670f-63a3-35d2344c1c29
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:bcde1519-8470-670f-63a3-35d2344c1c29
msgctxt "h5852a3feg67c0g443aga546g702c18333a49"
msgid ""
"Threat? Pah! You threaten me no more than the insects scrambling in the dirt."
msgstr "위협? 하! 차라리 진흙 속에서 꿈틀 거리는 곤충들이 더 위협적이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = bd43ca4f-7556-cb95-9767-133141258e7e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_GithChokepoint_Event_MentionedWeapon = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:bd43ca4f-7556-cb95-9767-133141258e7e
msgctxt "h3946a6f7g289cg4719ga799g5b49c5b43052"
msgid ""
"Baretha - kill them and search the bodies. I will hunt for the weapon "
"elsewhere."
msgstr "바레사, 이 놈들을 죽이고 시체를 수색해라. 나는 계속해서 무기의 위치를 찾겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = bee47c2c-da14-d043-744d-7e790102b197
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:bee47c2c-da14-d043-744d-7e790102b197
msgctxt "h938f3c15ga65bg4d40ga319gc14a99800c3e"
msgid ""
"You will return to the crèche and fetch reinforcements. But first, a "
"question..."
msgstr "양성소로 돌아가서 지원군을 불러라. 그 전에 먼저, 질문이 있다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = beed7452-1191-b49c-58a6-3f81a4b0bdc1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:beed7452-1191-b49c-58a6-3f81a4b0bdc1
msgctxt "h6e2ef126g9274g46b4g8142gf7f113033b01"
msgid ""
"<i>Chk! </i>I can devise torments beyond your reckoning, rest assured. But "
"time is pressing."
msgstr "<i>차크!</i>난 자네가 상상조차 할 수 없는 고통을 고안할 수 있으니 안심하게. 하지만 시간이 촉박하군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = c0171dbb-aa4e-0d44-b4a4-734529a3ec2e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:c0171dbb-aa4e-0d44-b4a4-734529a3ec2e
msgctxt "hd48f9302ge521g4260gab73gde5362da3cfd"
msgid ""
"Just like that, you offer up what I seek. Remarkable. You have my thanks."
msgstr "갑작스레 내가 원하는 것을 주다니. 놀랍군. 고맙다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = c1c67279-430b-8cdf-127e-9b21a2e9efdb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:c1c67279-430b-8cdf-127e-9b21a2e9efdb
msgctxt "h296e83a6g54ceg4e42ga64eg71a3f999cd83"
msgid ""
"Unlikely you'd be successful... but it costs me nothing to spare your sorry "
"life."
msgstr "성공할 것 같지는 않지만... 너의 안타까운 목숨을 살리는 데는 아무런 비용이 들지 않지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = c1f9f139-1b78-6a64-6a02-512e1b776681
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:c1f9f139-1b78-6a64-6a02-512e1b776681
msgctxt "hbda232eegd36eg4663g87abg95a90efeb75e"
msgid ""
"Ha! Your tongue is sharp - good. The crèche's hatchlings have not been "
"compromised by this meek, <i>wretched</i> world."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Player
#. NodeID = c38c3a18-9844-e0e7-4b45-d4f0f4610ea8
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(2) = True
#. TagRule: BERSERKER
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:c38c3a18-9844-e0e7-4b45-d4f0f4610ea8
msgctxt "hddf65cb0g5012g471fga6e4g83f0f94f0b8b"
msgid "<b><i>ROAR.</i></b>"
msgstr "<b><i>크아아.</i></b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Player
#. NodeID = c38c3a18-9844-e0e7-4b45-d4f0f4610ea8
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:c38c3a18-9844-e0e7-4b45-d4f0f4610ea8
msgctxt "hf74e6bc8g43e0g4ddbg9652g3cc994282f95"
msgid "You'd sprain your wrist trying."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = c46f2ad8-f734-7ba9-b236-92866ab03731
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:c46f2ad8-f734-7ba9-b236-92866ab03731
msgctxt "hd0150d75g32d8g4647g91c2g53ac99fdabd6"
msgid ""
"Curious. Most coming from the crèche would come across this bridge behind "
"me. You did not..."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = c4f9b32d-91f2-6aae-7ab4-7142493d428b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(2) = True
#. SetFlags:
#.   Global:
#.     - PLA_GithChokepoint_State_SpokeToVoss = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:c4f9b32d-91f2-6aae-7ab4-7142493d428b
msgctxt "hd8a9b178gd181g4e42ga56dg8e1d689311af"
msgid ""
"You are unknown to me, kin. Are you straight from the crèche, wandering "
"<i>unbidden</i>?"
msgstr "처음 보는 얼굴이군, 양성소에서 바로 온 건가, <i>허락도 없이</i> 어슬렁거리면서?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = c599132f-b169-37c5-5ff2-0e9da587deb2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_Knows_CrecheLocation = True
#.     - PLA_GithChokepoint_State_VossRevealedLocation = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:c599132f-b169-37c5-5ff2-0e9da587deb2
msgctxt "hd88c381egaaffg46f2g92dcg6b42d0de7326"
msgid ""
"No matter. More spears will make short work of this hunt. Make for the "
"crèche."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = c66d2fd9-a40e-57a2-74cb-4bb76774537f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:c66d2fd9-a40e-57a2-74cb-4bb76774537f
msgctxt "ha2dc549fg227cg467cga495g4b90132d21d6"
msgid "You are a waste of flesh. Perhaps the worms will have use for you. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Narrator
#. NodeID = c9fc6385-c2e6-ad87-f790-cfd004418cd1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Orpheus_Knows_GobLookingForWeapon = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:c9fc6385-c2e6-ad87-f790-cfd004418cd1
msgctxt "h8ca76f33g9a20g405ag97aag0b9a3cc5fcf6"
msgid ""
"*You attune your mind to it. The artefact does not want to fall into the "
"gith raiders' hands any more than it does the Absolute followers'.*"
msgstr ""
"*당신은 아티팩트에 당신의 정신을 조율해봅니다. 아티팩트는 절대자 추종자들의 손에 들어가기를 원치 않는 것과 마찬가지로, 기스 습격자들의 "
"손에도 들어가길 원치 않습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Sarth Baretha
#. NodeID = caae20b8-ca74-6108-99de-fd28b537731e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:caae20b8-ca74-6108-99de-fd28b537731e
msgctxt "h327f9affg6749g4282gb26fg0ff24209e10a"
msgid "Forgiveness, Kith'rak."
msgstr "용서하십시오, 키스락."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = cbeb1f1d-a965-7eb1-ebed-3f77f6984d2f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:cbeb1f1d-a965-7eb1-ebed-3f77f6984d2f
#, fuzzy
msgctxt "h2cbe6aebg88cag4bc4gb547g7bfb765f3c0e"
msgid ""
"Oh you saw something, did you? Let us see exactly what these bandits took..."
msgstr "오, 무언가를 본 모양이로군, 그렇지? 그 도적들이 가져간 것을 보여주게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = cc00c054-6aec-a36a-16b0-940ba42d6e36
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:cc00c054-6aec-a36a-16b0-940ba42d6e36
msgctxt "h8fc59ac8g8900g4694gbedcge6e3068d53d0"
msgid ""
"Bah! Nothing even approaching a useful thought in that skull. I ought to "
"just kill you..."
msgstr "쳇! 네 두개골 속에는 쓸만한 생각이라곤 하나도 없군. 널 그냥 죽여버리는 편이 낫겠어..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Player
#. NodeID = cc2e3d89-f720-56ac-1feb-c494b80056a5
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Local:
#.      - 4dd8c77c-d075-b1b3-1690-7a46dc8b8fb8_MindHasBeenRead = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:cc2e3d89-f720-56ac-1feb-c494b80056a5
msgctxt "h79e7b1c5g7207g4318ga25eg41f007b5bb6c"
msgid "I could help if you let me live - search for this weapon, perhaps."
msgstr "날 살려준다면 당신을 도울 수 있을지도 몰라, 무기를 찾는 걸 돕는다든지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Narrator
#. NodeID = cc55a714-1284-af91-c12b-3cf76981c116
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_InfernalBox_State_CharacterHasBox(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:cc55a714-1284-af91-c12b-3cf76981c116
msgctxt "h22e765f3gd13cg4f30gb874g27852c8e8a57"
msgid ""
"*You suddenly feel a strange anxiety take hold - not your own, but that of "
"the artefact you carry. Somehow, <i>it's afraid</i>...*"
msgstr ""
"*갑자기 이상한 불안감이 엄습합니다... 당신이 아니라, 당신이 지닌 아티팩트가 느끼는 것입니다. 어째서인지, <i>두려워하고 "
"있습니다...</i>*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = cc8827d3-3811-e71d-abca-5d4128ed298e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:cc8827d3-3811-e71d-abca-5d4128ed298e
msgctxt "hc4a769bfg2fc9g4a0ag9202g265318c3da9d"
msgid "Insubordinate at best. A blood traitor and deserter at worst."
msgstr "좋게 봐줘도 불복종. 최악이라면 동족의 배신자와 탈영병이겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = ccc84549-efbf-f99f-d9fe-3341a6c7a18e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:ccc84549-efbf-f99f-d9fe-3341a6c7a18e
msgctxt "h63a936c6g7525g4c59g9a5eg84610a15dad5"
msgid ""
"This world has made you soft, like rotten fruit. I will not let you shame "
"Vlaakith any longer..."
msgstr "이 세계가 널 썩은 과일 마냥 무르게 만들었어. 더 이상 네 녀석이 블라키스 님을 욕 보이게 두지 않겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = cf948000-e7dc-4add-78ed-bd147a436592
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:cf948000-e7dc-4add-78ed-bd147a436592
msgctxt "h97427b93g98ebg4151ga535g98e1763a50fa"
msgid "So bold in the face of death... Perhaps you may live after all."
msgstr "죽음을 코앞에 두고도 이리 대담하다니... 어쩌면 너는 결국 살아남을 수도 있겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Player
#. NodeID = d3e6c012-8cfb-2d1c-f4f3-8754ba4c98a4
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - PALADIN(2) = False
#.      - OATHBREAKER(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:d3e6c012-8cfb-2d1c-f4f3-8754ba4c98a4
msgctxt "hd7257076g9f69g489fgb8adgd31b2168e8c6"
msgid "You ought to just <i>leave</i>. You've no right to decide my fate."
msgstr "그냥 떠나는 게 옳은 일이야. 당신에게 내 운명을 결정할 권한은 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Player
#. NodeID = d5172ad3-100e-fa45-c6a8-996a70ac65bd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:d5172ad3-100e-fa45-c6a8-996a70ac65bd
msgctxt "h233e79e1g14f3g4ea0g998bg2b3b2a0e5345"
msgid ""
"These are my comrades. I will not stoop to explain my choice of company."
msgstr "이들은 내 동료들이야. 내가 누구와 왜 동행하는지 해명할 정도로 비굴해지진 않겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = d580d96e-883d-f5f1-b290-45b0001a7488
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:d580d96e-883d-f5f1-b290-45b0001a7488
msgctxt "h7a9b61c5gaa33g4ecegaa5fg311897763992"
msgid "Unless... unless you carried it off the <i>ghaik</i> ship yourself."
msgstr "만약... 만약에 자네가 <i>게이크</i>함선에서 가지고 나온게 아니라면 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = d69c0540-9d56-1f46-b23c-baa94e482f96
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:d69c0540-9d56-1f46-b23c-baa94e482f96
msgctxt "h2ec9a2e7g4da0g47dbga081gd407015e7bf8"
msgid "Perceptive, for such an inferior creature."
msgstr "열등한 생물치고는 통찰력이 뛰어나군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Player
#. NodeID = d7ef2834-1566-e383-34cc-f1070685cf0e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_InfernalBox_State_CharacterHasBox(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:d7ef2834-1566-e383-34cc-f1070685cf0e
msgctxt "hb83aae3fgcf9cg48adgb93ag2db5947a58d3"
msgid "<i>Produce the artefact. Ask if this is what he seeks.</i>"
msgstr "<i>아티팩트를 보여준다. 이게 그가 찾는 것인지 물어본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Player
#. NodeID = da0a4394-29a5-691c-1c47-cbf8ce6b40f2
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:da0a4394-29a5-691c-1c47-cbf8ce6b40f2
msgctxt "hdbb616fbg6c3bg41f1gba73gc3d7a44e419f"
msgid "I don't know you. I pose no threat."
msgstr "나는 너를 모르는걸. 나는 위협이 되지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = dae86aff-51ef-60c8-c963-ffe22164e72f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:dae86aff-51ef-60c8-c963-ffe22164e72f
msgctxt "h6271b96cgc31bg4bd2g9f4bg2782b2c62c2a"
msgid ""
"My blade is my right. If I can take your life, it is <i>mine</i>. But "
"perhaps you have other uses..."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = db5f9c15-81d4-80e7-5a4f-d13a3d9c7839
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:db5f9c15-81d4-80e7-5a4f-d13a3d9c7839
msgctxt "hbd884cb1g1173g4d4egb659g615eb612c615"
msgid ""
"Treacherous <i>shka'keth</i>! Baretha - deal with this! I will continue the "
"hunt elsewhere."
msgstr "배신자들 <i>쉬카케스</i>! 바레사, 이것들을 처리해라! 나는 다른 곳에서 계속 찾아보겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Narrator
#. NodeID = dca998a9-0eb6-47d9-09a6-e230dc52d833
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Orpheus_Knows_GobLookingForWeapon = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:dca998a9-0eb6-47d9-09a6-e230dc52d833
msgctxt "hec4eef00g9969g44deg986bgca17a16b1ac1"
msgid ""
"*You attune your mind to it. The artefact does not want to fall into the "
"gith raiders' hands any more than it does the Absolute followers'.*"
msgstr ""
"*당신은 아티팩트에 당신의 정신을 조율해봅니다. 아티팩트는 절대자 추종자들의 손에 들어가기를 원치 않는 것과 마찬가지로, 기스 습격자들의 "
"손에도 들어가길 원치 않습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Narrator
#. NodeID = df074728-fabc-6df5-dd48-836f36d5358a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_InfernalBox_State_CharacterHasBox(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:df074728-fabc-6df5-dd48-836f36d5358a
msgctxt "h55fac708gfaf0g47a0ga2dbg3678f9ff2d8e"
msgid ""
"*You suddenly feel a strange anxiety take hold - not your own, but that of "
"the artefact you carry. Somehow, <i>it's afraid</i>...*"
msgstr ""
"*갑자기 이상한 불안감이 엄습합니다... 당신이 아니라, 당신이 지닌 아티팩트가 느끼는 것입니다. 어째서인지, <i>두려워하고 "
"있습니다...</i>*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Sarth Baretha
#. NodeID = e1fd73d6-8a14-559b-9457-e2e54433115c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:e1fd73d6-8a14-559b-9457-e2e54433115c
msgctxt "h270e7008g5714g4ae2g9373gc2a6ab1d9a85"
msgid "Yes, Kith'rak?"
msgstr "네, 키스락?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = e40fc703-81d0-581b-dda5-175b4e56281e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_GithChokepoint_State_VossDeniedCure = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:e40fc703-81d0-581b-dda5-175b4e56281e
msgctxt "h5c28d9e2g02eag4709g82eeg395153c41eb8"
msgid "I believe you, <i>vin'iisk</i>. No one would lie about such a thing."
msgstr "난 자네를 믿네, <i>비니스크</i>. 그런 걸로 거짓말 할 사람은 아무도 없겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Narrator
#. NodeID = e5543272-e970-011c-d4d1-0ae181d4ac65
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - AVATAR(2) = True
#.      - REALLY_SHADOWHEART(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:e5543272-e970-011c-d4d1-0ae181d4ac65
msgctxt "h42d2f3f0g1e74g4791g9d2fg08286b837410"
msgid ""
"*You realise that the weapon Voss speaks of is the gith artefact you carry. "
"You cannot let him discover it - no matter what.*"
msgstr ""
"*보스가 말하는 이 무기가, 당신이 들고 다니는 아티팩트라는 것을 깨닫습니다. 그가 알아채게 둘 수는 없습니다... 어떤 수를 써서라도 "
"말입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = e6719de8-1be7-35aa-e78f-388cdbc5c9e9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:e6719de8-1be7-35aa-e78f-388cdbc5c9e9
msgctxt "h0b6a0400g6642g42d9g9d0bg230855855f9a"
msgid ""
"Very well, <i>istik</i>. Seek out survivors from the ship that crashed on "
"this wretched world."
msgstr "좋다, <i>이스틱</i>. 이 비참한 세계에 불시착한 함선에서 생존자를 찾아내도록."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = e7490f5b-b785-0a07-4caa-538a717b2e03
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:e7490f5b-b785-0a07-4caa-538a717b2e03
msgctxt "hdc611965gcde1g4769g82c9g6cdbdb93fb79"
msgid "Kill him."
msgstr "놈을 죽여라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = e7490f5b-b785-0a07-4caa-538a717b2e03
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:e7490f5b-b785-0a07-4caa-538a717b2e03
msgctxt "hf33bca93g808dg48f0gbe2dgd10c1a0df9cf"
msgid "Kill her."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = e7490f5b-b785-0a07-4caa-538a717b2e03
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:e7490f5b-b785-0a07-4caa-538a717b2e03
msgctxt "hf1e427dbged00g42a6g89b8g628dfc05c3e7"
msgid "Kill them."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = e7822b77-7bc3-c424-6593-4eccbb7c8306
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:e7822b77-7bc3-c424-6593-4eccbb7c8306
msgctxt "haa8d6e74gff9ag4a15g8f64g5ef33b23edfe"
msgid "You haggle with your own life, fool. Be silent and hold still..."
msgstr "너는 네 목숨으로 흥정하는 것이다, 멍청아. 침묵하고 가만히 있어라..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Player
#. NodeID = e8485bf4-d677-2fc0-6f49-49fd417d7337
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - PALADIN(2) = True
#.      - OATHBREAKER(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:e8485bf4-d677-2fc0-6f49-49fd417d7337
msgctxt "hba25bc7dg1f89g498bgbe40g5803daa9bea3"
msgid "My fate is my own. You will <i>not</i> take it from me. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Player
#. NodeID = e9d256ff-6d1e-6fb2-8ce8-f4b8ebfc4683
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_InfernalBox_State_CharacterHasBox(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:e9d256ff-6d1e-6fb2-8ce8-f4b8ebfc4683
msgctxt "h74d384e5gc5b3g4233gbcffg343d7d561135"
msgid "<i>Produce the artefact. Ask him if this is what he seeks.</i>"
msgstr "<i>아티팩트를 보여준다. 이게 그가 찾는 것인지 물어본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Narrator
#. NodeID = eae9949e-7f27-544b-f5e7-78d3df0648f8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Orpheus_Knows_GobLookingForWeapon = True
#.   Tag:
#.      - REALLY_SHADOWHEART(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:eae9949e-7f27-544b-f5e7-78d3df0648f8
msgctxt "h5e43fc7bga741g4219g9a64g2c6559d1a21f"
msgid ""
"*You feel Shadowheart's anxiety. The weapon that Voss seeks is the same one "
"the Absolute's followers are hunting - it's the artefact that she carries.*"
msgstr ""
"*섀도하트의 불안감이 느껴집니다. 보스가 찾는 무기는 절대자의 추종자들이 노리는 바로 그 물건입니다. 바로 그녀가 지닌 아티팩트 "
"말입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Player
#. NodeID = ec1e5e8a-4a9f-93dc-7787-b2c894cc14bd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DROWELF(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:ec1e5e8a-4a9f-93dc-7787-b2c894cc14bd
msgctxt "h6407e7ccga939g4bd5g9293g4edc5a40c46a"
msgid "Can't you muster a real threat, like flaying or blinding?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = ec60ea93-ca33-a115-dc2f-da9aeb5fdd50
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:ec60ea93-ca33-a115-dc2f-da9aeb5fdd50
msgctxt "h221d37cbg7b8dg4327g8868g07b7e4995aea"
msgid ""
"There is no conviction in your voice. What are you? A deserter? A traitor?"
msgstr "네 목소리에 확신이 없군. 넌 뭐지? 탈영병? 배반자?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Narrator
#. NodeID = ecee688d-1c08-d3df-5847-e6b3eecebb73
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:ecee688d-1c08-d3df-5847-e6b3eecebb73
msgctxt "h79607835g0efbg49efg881dg8c77ac0a97fb"
msgid ""
"*Her mind focuses - the giths' suspicion cannot be aroused. They cannot "
"discover that the weapon they seek is right within their grasp.*"
msgstr ""
"*그녀가 정신을 집중합니다. 기스의 의심을 불러와서는 안 됩니다. 그들이 찾고 있는 무기가 바로 그들 눈앞에 있다는 사실을 알게 할 수는 "
"없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = ed45361c-55b0-0db5-8932-3dc0e47bb325
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:ed45361c-55b0-0db5-8932-3dc0e47bb325
msgctxt "h0ce262dbg6b14g4f13g8273g7138cc1ad191"
msgid ""
"For you to keep sucking air, it is necessary for you to tell me something of "
"worth."
msgstr "네가 계속 공기를 마시려면, 가치있는 것을 말해야 할 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = efdadcc9-81e3-e0de-a355-6c6ad3174f22
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:efdadcc9-81e3-e0de-a355-6c6ad3174f22
msgctxt "h669f49f5gefb3g425agb30dg254539ef1c49"
msgid "Well now. If you are of no use to me alive, I'll have your death."
msgstr "자, 그럼. 네가 살아서 내게 쓸모가 없다면, 너를 죽여야겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Player
#. NodeID = f0b9015d-e1b7-71a7-c1d7-9ce1f09b9848
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:f0b9015d-e1b7-71a7-c1d7-9ce1f09b9848
msgctxt "h3401048dge573g439aga313gac1727f93a38"
msgid "I just want passage - if I have to go through you, so be it."
msgstr "나는 단지 지나가기를 원할 뿐이야. 내가 너를 뚫고 지나가야 한다면, 그렇게 하겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = f50b1a39-8672-5553-0542-3e76a0df1802
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(5) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:f50b1a39-8672-5553-0542-3e76a0df1802
msgctxt "hecd34d39geea3g41b8gad4dga73bb02deb09"
msgid ""
"Help us find it and I will leave your blood beneath your skin, unspilled."
msgstr "우리 수색을 돕는다면 네 살갗 밑의 피는 보존할 수 있을 것이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = f5aab9fd-f29b-876f-b572-0a88f7265885
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:f5aab9fd-f29b-876f-b572-0a88f7265885
msgctxt "h32f8c418gc71eg4814g8352gab229d5e172e"
msgid "What easy prey you make, walking right within my blade's embrace."
msgstr "아주 손쉬운 사냥감이군, 내 검의 품속으로 바로 걸어들어오다니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Player
#. NodeID = f6a4da2f-a88b-fc3f-015e-bff02cc33e8c
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: FIGHTER or RANGER
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:f6a4da2f-a88b-fc3f-015e-bff02cc33e8c
msgctxt "h757e36beg3765g4519ga989g6c5351e1a9a6"
msgid "Try it - let's see who walks away alive."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = fa40080e-0ba2-714c-4683-c8b46f8d17b0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_GithChokepoint_Event_ContinueFromLaezel = True
#. SetFlags:
#.   Global:
#.     - PLA_GithChokepoint_State_SpokeToVoss = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:fa40080e-0ba2-714c-4683-c8b46f8d17b0
msgctxt "hfbf0ae16g532fg40f9g8745g52e7c20b49a9"
msgid ""
"Now, now, child - your pet means to speak. Tell me, pet: why shouldn't I run "
"you through this instant?"
msgstr ""
"자, 자, 얘야 - 너의 애완동물이 말하려는 것 같구나. 말해 봐라, 애완동물아. 내가 지금 즉시 너를 죽이면 안되는 이유가 있나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = faed9467-df7d-957f-c9f7-ff2bc201b5a0
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:faed9467-df7d-957f-c9f7-ff2bc201b5a0
msgctxt "h53a9535dgaa87g4854g82ecg76318821a867"
msgid ""
"...You think I don't see that pathetic fumbling? I expected better of my kin."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Kith'rak Voss
#. NodeID = faed9467-df7d-957f-c9f7-ff2bc201b5a0
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:faed9467-df7d-957f-c9f7-ff2bc201b5a0
msgctxt "he31e5da9gd1ffg41f0g9f0bg693d561f9211"
msgid "...You think I don't see that pathetic fumbling?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation
#. Speaker = Player
#. NodeID = fbe5c736-a4f5-f227-3f79-79574fd88f89
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_Confrontation:fbe5c736-a4f5-f227-3f79-79574fd88f89
msgctxt "hc0b440bag8f4bg499cgab64g876577467d69"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Narrator
#. NodeID = 00b0e6a8-4dc1-c192-50c0-09e668618154
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - AVATAR(7) = True
#.      - REALLY_SHADOWHEART(7) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:00b0e6a8-4dc1-c192-50c0-09e668618154
msgctxt "h5f3b88c6gf42fg47b0g90f8g860dfd072843"
msgid ""
"*You realise that the weapon Voss speaks of is the gith artefact you carry. "
"You cannot let him discover it - no matter what.*"
msgstr ""
"*보스가 말하는 이 무기가, 당신이 들고 다니는 아티팩트라는 것을 깨닫습니다. 그가 알아채게 둘 수는 없습니다... 어떤 수를 써서라도 "
"말입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Lae'zel
#. NodeID = 01ac28d5-82e9-315c-6684-03b36aad8667
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:01ac28d5-82e9-315c-6684-03b36aad8667
msgctxt "ha34fe928g4554g4fdagb4b3g497e742bb6cb"
msgid "Voss, Knight Supreme. The queen's silver, the queen's sword."
msgstr "여왕의 은검, 무력의 상징인 절대 기사, 보스시여."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Lae'zel
#. NodeID = 03470ec3-80b9-8190-fd4d-d6de79f9a3b2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:03470ec3-80b9-8190-fd4d-d6de79f9a3b2
msgctxt "hff765959gbb60g4140gb7e4gf41ee4973700"
msgid ""
"Never. Vlaakith demands my purity, <i>Kith'rak</i>. I was infected aboard "
"the <i>ghaik </i>ship. By protocol, you must aid me."
msgstr ""
"절대. 블라키스 님이 제 정화를 요구하십니다, <i>키스락</i>. 전 <i>게이크 </i>함선에서 감염되었습니다. 절차에 따라, 절 "
"도와주시는 것이 그대의 의무입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Narrator
#. NodeID = 04bb873b-f7e7-4021-9743-c3339f4c86a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:04bb873b-f7e7-4021-9743-c3339f4c86a3
msgctxt "h026fe480gdc35g440cg89cegbd7f3a7b0faf"
msgid ""
"*Her mind focuses - the giths' suspicion cannot be aroused. They cannot "
"discover that the weapon they seek is right within their grasp.*"
msgstr ""
"*그녀가 정신을 집중합니다. 기스의 의심을 불러와서는 안 됩니다. 그들이 찾고 있는 무기가 바로 그들 눈앞에 있다는 사실을 알게 할 수는 "
"없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Kith'rak Voss
#. NodeID = 08a06f94-a2b1-a383-deaa-6ca405e9e372
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:08a06f94-a2b1-a383-deaa-6ca405e9e372
msgctxt "h79998b9cgf407g48c8g875dgc51118edd4eb"
msgid "Yet you are not bleeding. For I am <i>nothing</i> if not merciful."
msgstr "하지만 넌 멀쩡하지. 내가 그토록 <i>관대</i>하기 때문이니라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Kith'rak Voss
#. NodeID = 0bbd2437-817f-cfaa-baeb-a28c30926b01
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_GithChokepoint_Event_MentionedWeapon = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:0bbd2437-817f-cfaa-baeb-a28c30926b01
msgctxt "hab056fbcgae85g4d92g9528g3c18e3eeb409"
msgid ""
"A <i>ghaik</i> vessel has fallen from the sky, Lae'zel. Thieves aboard have "
"taken a weapon most precious."
msgstr "<i>게이크</i> 함선이 하늘에서 추락했다, 레이젤. 거기 올라탄 도둑들이 귀중한 무기를 훔쳐갔지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Kith'rak Voss
#. NodeID = 12ef423e-6f61-4687-2c84-57120505be0a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:12ef423e-6f61-4687-2c84-57120505be0a
#, fuzzy
msgctxt "h46cd142ag8922g46c0g96f6g4fa3e06c3739"
msgid "You will give it to us. Then you will bend your head for the sword."
msgstr "너는 그것을 내게 내놓을 것이야. 그리고 나서 내 검에 목을 내밀도록 해라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Player
#. NodeID = 22c32c82-c446-8199-6742-d66f4f23d32b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_GithChokepoint_Event_ContinueFromLaezel = True
#.     - GLO_GithChokepoint_Event_PlayerAnnoyerLaezel = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:22c32c82-c446-8199-6742-d66f4f23d32b
msgctxt "ha0ba9bd7gfeccg4b74g9566g84e1e8e5c9b5"
msgid "If you wish to speak, speak to <i>me.</i>"
msgstr "얘기를 하고 싶거든, <i>나</i>에게 하시지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Kith'rak Voss
#. NodeID = 22d2e35c-a92e-6569-a34a-ad21b3544c7d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:22d2e35c-a92e-6569-a34a-ad21b3544c7d
msgctxt "h28039fadgb9a3g42dcg8a1cg5dc13d4433f8"
msgid "Sh-sh-shh. Such a familiar tone."
msgstr "쉿, 쉿, 쉿. 아주 스스럼없는 말투로구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Player
#. NodeID = 28a0e7df-771c-2e63-f812-f6b0330d6e20
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IMPOSSIBLE = True
#.      - GLO_InfernalBox_State_TeamHasBox = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:28a0e7df-771c-2e63-f812-f6b0330d6e20
msgctxt "h0e468208g068cg47e8gb685g795fc1180b82"
msgid "<i>Produce the artefact. </i>You're looking for this, I take it?"
msgstr "<i>아티팩트를 보여준다. </i>이걸 찾고 있는 것 같은데, 맞나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Narrator
#. NodeID = 2d05eda1-359c-58e4-4040-11223bb8dbc3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_InfernalBox_State_CharacterHasBox(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:2d05eda1-359c-58e4-4040-11223bb8dbc3
msgctxt "h85d3331eg2074g44a7gbd93g6f2f3d1d1ba7"
msgid ""
"*You suddenly feel a strange anxiety take hold - not your own, but that of "
"the artefact you carry. Somehow, <i>it's afraid</i>...*"
msgstr ""
"*갑자기 이상한 불안감이 엄습합니다... 당신이 아니라, 당신이 지닌 아티팩트가 느끼는 것입니다. 어째서인지, <i>두려워하고 "
"있습니다...</i>*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Narrator
#. NodeID = 2e1d5094-00ec-3a2b-7d52-de37b56cc300
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:2e1d5094-00ec-3a2b-7d52-de37b56cc300
msgctxt "he1dfd964g3a80g4db2ga0c9g4172bb809159"
msgid ""
"*You attune your mind to it. The artefact does not want to part from you. It "
"does not want to fall into the gith raiders' hands.*"
msgstr ""
"*당신은 아티팩트에 당신의 정신을 조율해봅니다. 아티팩트는 당신과 떨어지고 싶지 않습니다. 기스 습격자들의 손에 들어가길 원치 않습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Lae'zel
#. NodeID = 2e3951f2-5929-388a-351f-8fa51f6f172a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:2e3951f2-5929-388a-351f-8fa51f6f172a
msgctxt "h859661e3g9448g462egab71gb2a46d3183a5"
msgid "<i>You. Stay put, and keep your lips sealed.</i>"
msgstr "<i>너. 가만히 있어라, 입은 꼭 다물고.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Narrator
#. NodeID = 30ee1466-81c6-7506-decb-ada8ca6e6d2b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Orpheus_Knows_GobLookingForWeapon = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:30ee1466-81c6-7506-decb-ada8ca6e6d2b
msgctxt "hf40c6411ge3fag44fcga4cfg6943f6f4de5a"
msgid ""
"*You attune your mind to it. The artefact does not want to fall into the "
"gith raiders' hands any more than it does the Absolute followers'.*"
msgstr ""
"*당신은 아티팩트에 당신의 정신을 조율해봅니다. 아티팩트는 절대자 추종자들의 손에 들어가기를 원치 않는 것과 마찬가지로, 기스 습격자들의 "
"손에도 들어가길 원치 않습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Lae'zel
#. NodeID = 3f503171-f3c2-82b8-5b57-6b38e484640f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_GithChokepoint_State_VossDeniedCure = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:3f503171-f3c2-82b8-5b57-6b38e484640f
#, fuzzy
msgctxt "hb1643d6dg78d4g44f4g8bb1g8782b3b21d22"
msgid ""
"My mandate, <i>Jhe'stil Kith'rak</i>, is to locate this crèche. I was "
"infected aboard a <i>ghaik </i>ship and need to be purified. <i>Your</i> "
"mandate is to aid me."
msgstr ""
"<i>Chk. </i>제가 받은 명령이라면, 존경하는 <i>키스락</i>이시여, 이 양성소를 찾는 것뿐입니다. 저는 <i>게이크 </"
"i>함선에서 감염되었고 정화되어야 합니다. <i>당신</i>이 받은 명령은 저를 돕는 것입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Player
#. NodeID = 3fc15a75-4bbd-09e7-8130-e784a59547ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:3fc15a75-4bbd-09e7-8130-e784a59547ea
msgctxt "h0dc7a5b2g931cg44ceg8104gafe56eaceafa"
msgid "<i>Keep quiet - let Lae'zel speak.</i>"
msgstr "<i>침묵을 유지하고, 레이젤이 말하도록 한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Kith'rak Voss
#. NodeID = 46ce59ec-cba6-c4d0-fe27-bbb7ec3dfb27
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:46ce59ec-cba6-c4d0-fe27-bbb7ec3dfb27
msgctxt "hc362c6eegbbb4g4a1cg9911g3dc5503de78f"
msgid "Only in <i>death</i> are the infected cleansed."
msgstr "감염된 자들은 오직 <i>죽음</i>으로 정화될 수 있다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Kith'rak Voss
#. NodeID = 47a5daae-1f21-bcdc-0491-470aa5db9594
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:47a5daae-1f21-bcdc-0491-470aa5db9594
msgctxt "hf9c933f1gc7a2g44cegbea3g74789be7cbb2"
msgid "But... you were on the nautiloid. You possess what I seek."
msgstr "그런데... 너는 노틸로이드에 있었군. 내가 찾는 것을 네가 가지고 있구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Kith'rak Voss
#. NodeID = 4a4a7a59-ee1a-baf2-4102-ec835fe60d8b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:4a4a7a59-ee1a-baf2-4102-ec835fe60d8b
msgctxt "h5fb9d53eg190cg4217gbcc9g3f8b5ba0152e"
msgid "Our queen's word binds me."
msgstr "이 몸은 여왕 폐하의 명에 복종할 뿐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Kith'rak Voss
#. NodeID = 4c8642ff-509d-18a5-0ce4-d8160ef8cd9e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:4c8642ff-509d-18a5-0ce4-d8160ef8cd9e
msgctxt "h16f1f44bg25deg4099gadedg8cebb22528c4"
msgid "'Lae'zel.' Proud. Regal, even."
msgstr "'레이젤'이라. 긍지있는 이름이구나. 장엄하기까지 하군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Lae'zel
#. NodeID = 4e839cc3-9248-4a0b-5eee-0f41a182b97e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:4e839cc3-9248-4a0b-5eee-0f41a182b97e
msgctxt "h72a2d738g716ag4861g9b71g0f970dead0f4"
msgid "Imbecile. Stay <i>back</i>!"
msgstr "이 얼간이가. <i>물러가라</i>!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Player
#. NodeID = 525b01f7-bd90-6b8f-5e27-542e7b2a8fd4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(2) = True
#. SetFlags:
#.   Global:
#.     - PLA_GithChokepoint_Event_ContinueFromLaezel = True
#.     - GLO_GithChokepoint_Event_PlayerAnnoyerLaezel = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:525b01f7-bd90-6b8f-5e27-542e7b2a8fd4
msgctxt "h7ddc16ffgea7fg48b8gbf6dg7c3b0f6703f6"
msgid "<i>Step forward and state your own name.</i>"
msgstr "<i>앞으로 나서서 당신의 이름을 말한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Kith'rak Voss
#. NodeID = 5545764c-a029-ff0c-47be-1d9bfa96a233
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:5545764c-a029-ff0c-47be-1d9bfa96a233
msgctxt "h1dfaa3a0g9c42g47fdgb68dgb78bb6ed0b23"
msgid "Take word to your crèche. You are to join our search."
msgstr "너희 양성소에 전하도록 해라. 우리 수색에 합류한다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Lae'zel
#. NodeID = 55818fd8-f93f-df60-5f22-fb15182acd77
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_GithChokepoint_State_LaezelFailedJoinFullParty = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:55818fd8-f93f-df60-5f22-fb15182acd77
msgctxt "h02eb04ffg140ag4913g8139g48eadf127080"
msgid "<i>Stay put, and keep your lips sealed.</i>"
msgstr "<i>가만히 있어라, 입은 다물고.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Kith'rak Voss
#. NodeID = 58074f97-12d2-391c-e55f-9e2dce446c2c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:58074f97-12d2-391c-e55f-9e2dce446c2c
msgctxt "h4021d679g837fg482bg90d2g6837533aec76"
msgid "Our queen's word binds me."
msgstr "이 몸은 여왕 폐하의 명에 복종할 뿐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Lae'zel
#. NodeID = 5b5369da-31c0-af53-3002-d551447c4857
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:5b5369da-31c0-af53-3002-d551447c4857
msgctxt "hd21b9f80g6102g45begae7ega84cebc9db89"
msgid "Half-wit!"
msgstr "이런 멍청이가!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Kith'rak Voss
#. NodeID = 623f8bed-b396-527c-5ea8-35558b85b9a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:623f8bed-b396-527c-5ea8-35558b85b9a3
msgctxt "h066af15fg8b8ag45c9ga031gbfcc5703293f"
msgid ""
"It is polyhedric in shape, and inscribed with the sacred runes of our people."
msgstr "그것은 다면체 형태이고, 우리 종족의 성스러운 룬 문자가 새겨져 있다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Player
#. NodeID = 62f9a9e5-2043-3dd6-3a17-277373118b66
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:62f9a9e5-2043-3dd6-3a17-277373118b66
msgctxt "h0869efd6g684eg4a7agb494g4fd5d9e3f207"
msgid "Death is at hand, <i>kith'rak!</i>"
msgstr "죽음이 눈앞에 있다, <i>키스락!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Player
#. NodeID = 62f9a9e5-2043-3dd6-3a17-277373118b66
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:62f9a9e5-2043-3dd6-3a17-277373118b66
msgctxt "h442dac61g9064g4fd5g81fdge3905b6b608e"
msgid "I have my own mandate. Time to die, gith."
msgstr "내 명령은 내가 내린다. 죽을 시간이야, 기스."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Narrator
#. NodeID = 6e947992-bfcb-6511-ffd3-0b4c10e68a4f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:6e947992-bfcb-6511-ffd3-0b4c10e68a4f
msgctxt "h3c150840g4863g476bga4b3g8a510b49a440"
msgid ""
"*A current of deception carries Voss' words. Wherever he flies, it is not to "
"Vlaakith.*"
msgstr "*보스의 말에서 기만이 느껴집니다. 그가 날아가는 곳이 어디든, 블라키스가 있는 곳은 아닙니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Lae'zel
#. NodeID = 780ed573-2265-00f9-1984-470b3498c047
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_GithChokepoint_State_SpokeToVoss = True
#.     - GLO_GithChokepoint_Event_LaezelOMStarted = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:780ed573-2265-00f9-1984-470b3498c047
msgctxt "h9711a3b2g29f1g4f7ag9642g1d5ebd3fc0b5"
msgid "Rider - my time is short. Lead me to..."
msgstr "기수여, 시간이 촉박하다. 어서 날..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Narrator
#. NodeID = 7de25b9b-21c3-0057-ed95-2d60cab9a810
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:7de25b9b-21c3-0057-ed95-2d60cab9a810
msgctxt "h4e78d904ge8beg453cg9633g09d87f7422ee"
msgid ""
"*Your skull pounds in response to the githyanki's white-hot stare. Her lips "
"don't move, yet you hear her voice.*"
msgstr "*기스양키의 새하얗게 불타는 눈빛에 반응하듯 두개골이 진동합니다. 그녀의 입술은 움직이지 않지만, 그녀의 목소리가 들립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Kith'rak Voss
#. NodeID = 7ed44f62-3c64-07ca-e190-0d0859c6ed09
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:7ed44f62-3c64-07ca-e190-0d0859c6ed09
msgctxt "h2364a059geff4g41e9ga228gfdd603b0fb58"
msgid "Were I not merciful, I would slice the skin clean from your meat."
msgstr "내가 자비롭지 않았다면, 네 살점에서 가죽을 깔끔히 벗겨냈을 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Kith'rak Voss
#. NodeID = 86d3bc93-e62e-cab9-6e5d-c8ab646627bb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:86d3bc93-e62e-cab9-6e5d-c8ab646627bb
msgctxt "hbd5b4dd7gf336g4422gb852ga2b6c3865b46"
msgid "Speak up, child. Affirm your mandate."
msgstr "말하거라, 아이야. 네가 받은 명령을 받들겠다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Kith'rak Voss
#. NodeID = 9398d8db-56a4-c8c7-12ab-062e9ba02131
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:9398d8db-56a4-c8c7-12ab-062e9ba02131
#, fuzzy
msgctxt "he1dd6dddg1a35g435fga39bg8249b33e1a28"
msgid ""
"Baretha - see their skulls split and their corpses examined. I must fly to "
"our Undying Queen."
msgstr "바레사, 이 녀석들의 두개골을 쪼개버리고 시체를 조사해라. 블라키스 님의 명령이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Lae'zel
#. NodeID = 9826748d-5301-348f-1a88-0bae687216bc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_LaezelRecruitment_SituationHasMet1 = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:9826748d-5301-348f-1a88-0bae687216bc
msgctxt "h9b8730e4gc449g4b4ag8fa1g788bd242eca7"
msgid "<i>You. Stay put, and keep your lips sealed.</i>"
msgstr "<i>너. 가만히 있어라, 입은 꼭 다물고.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Kith'rak Voss
#. NodeID = 98d8ed7e-ef85-01c6-0ad4-a4c296edb3a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:98d8ed7e-ef85-01c6-0ad4-a4c296edb3a5
msgctxt "hcd0967b9g74d0g4f8agac5bg057c39a4f9bd"
msgid "Your name, child."
msgstr "이름을 대거라, 아이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Kith'rak Voss
#. NodeID = 99bfcda3-7960-0820-97d4-c98cd9284469
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:99bfcda3-7960-0820-97d4-c98cd9284469
msgctxt "h0809ae92g0671g47b8g92a9gcd9aa9d46935"
msgid "Our thieves come forth, Baretha. Did you imagine such fortune?"
msgstr "도둑이 제 발로 찾아왔구나, 바레사. 이런 행운이 따를 거라 생각이라도 해 봤나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Player
#. NodeID = a07d7b71-c3a0-7718-78bc-340fdae23b40
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   User:
#.     - PLA_GithChokepoint_State_LetLaezelSpeak(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:a07d7b71-c3a0-7718-78bc-340fdae23b40
msgctxt "h4f029c28g4641g43afgb8f8g60cc105cae22"
msgid "<i>Keep quiet.</i>"
msgstr "<i>침묵을 유지한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Player
#. NodeID = a6d44bc8-83f0-3a7f-46c4-3277c8b4f92c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:a6d44bc8-83f0-3a7f-46c4-3277c8b4f92c
msgctxt "hbfc75edeg674ag4bccgbc02gbbf3ae99138f"
msgid "<i>Attack the gith.</i>"
msgstr "<i>기스를 공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Kith'rak Voss
#. NodeID = a90fe80e-d80f-e826-2a2f-c4a436282722
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:a90fe80e-d80f-e826-2a2f-c4a436282722
msgctxt "h3767fc3dg4737g4bf9gbae3g4544c1ce5cdf"
msgid "You will call me <i>Jhe'stil Kith'rak</i>."
msgstr "나를 <i>제스틸 키스락</i>이라 부르도록."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Kith'rak Voss
#. NodeID = adc7cbc5-9ca7-bcc1-ae8a-6a685042a229
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_GithChokepoint_State_LaezelSuspectsVlaakith = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:adc7cbc5-9ca7-bcc1-ae8a-6a685042a229
#, fuzzy
msgctxt "h47f44856g2810g42ffg9f78g08b978a3dd47"
msgid ""
"Baretha - see her skull split and her corpse examined. I will take word to "
"Queen Vlaakith - our quest has ended."
msgstr "바레사 - 블라키스 님의 명에 따라 그녀의 두개골을 쪼개고 시체를 검시하도록."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Kith'rak Voss
#. NodeID = b057b996-99b7-4dc5-326e-d68161c009b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:b057b996-99b7-4dc5-326e-d68161c009b3
msgctxt "h63ea47f0gfdf5g4e2dgab30g3cc5a88ccf05"
msgid ""
"You will give us the weapon. Then you will bend your head for the sword."
msgstr "무기를 이리 넘겨라. 그리고 얌전히 고개를 조아려 칼을 받도록."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Kith'rak Voss
#. NodeID = b93516e1-f236-5687-5c5d-f37d88a15d84
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_GithChokepoint_State_LaezelSuspectsVlaakith = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:b93516e1-f236-5687-5c5d-f37d88a15d84
msgctxt "hded92ab6g2ec2g409cgb811g4816b29c052c"
msgid ""
"Baretha, see that her skull is split and the weapon collected, on Vlaakith's "
"command. I will take word to the Undying Queen - our quest has ended."
msgstr "바레사, 여왕 폐하의 명에 따라 저것의 머리를 쪼개고 무기를 회수하도록. 난 불사의 여왕께 임무가 끝났음을 보고드리겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Lae'zel
#. NodeID = bcf0757f-3853-ebbd-4a2e-02fde11ac3ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:bcf0757f-3853-ebbd-4a2e-02fde11ac3ec
msgctxt "haba20da0g812cg45c0gaa03gbd6d73440049"
msgid "Stand down, knight. I do not have what you seek!"
msgstr "진정하십시오. 기사님께서 찾으시는 무기는 수중에 없습니다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Kith'rak Voss
#. NodeID = c0a79a85-0c94-e154-81f1-a95a3164a30b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:c0a79a85-0c94-e154-81f1-a95a3164a30b
msgctxt "hc8f6becbgf2efg461cgae46g7def5dc0da58"
msgid "Qudenos - to the sky!"
msgstr "쿠데노스, 하늘로!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Kith'rak Voss
#. NodeID = c2044752-2a54-7c11-df7e-ffe0195057fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:c2044752-2a54-7c11-df7e-ffe0195057fd
msgctxt "hcb3d17cag8945g4bb9g80c2ge91263a7dc46"
msgid "I am who you say."
msgstr "교육을 잘 받았구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Kith'rak Voss
#. NodeID = d70c7c74-7a6a-7690-a390-96f867fff069
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:d70c7c74-7a6a-7690-a390-96f867fff069
msgctxt "he302d6c8gde51g451dga1a6gcf6283752eef"
msgid "Now, now - Vlaakith esteems all her children."
msgstr "자, 자 - 블라키스 님은 모든 자손을 소중히 여긴다네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Kith'rak Voss
#. NodeID = d9f73e4c-775f-1712-78f9-e249df809fa3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:d9f73e4c-775f-1712-78f9-e249df809fa3
msgctxt "h0e31a31eg159cg4732g921bgbe9f76faf5ab"
msgid ""
"Purified? Oh, Lae'zel - why must the truth be so bitter? Soon, your skin "
"will go grey, and your blood will run silver. You will shed your skin to "
"become <i>ghaik.</i>"
msgstr ""
"정화라니? 아, 레이젤, 진실은 참으로 쓰디쓴 것이란다. 곧 네 피부는 회색빛이 되고, 피는 은빛이 되어 흐를 것이다. 너는 피부가 모두 "
"벗겨져 <i>게이크</i>가 될 것이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Narrator
#. NodeID = e05d2e5b-3798-bfa6-8da2-629452ee236d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Orpheus_Knows_GobLookingForWeapon = True
#.   Tag:
#.      - REALLY_SHADOWHEART(7) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:e05d2e5b-3798-bfa6-8da2-629452ee236d
msgctxt "h09fafb57gb9e0g4879g9099g06afaa4c7feb"
msgid ""
"*You feel Shadowheart's anxiety. The weapon that Voss seeks is the same one "
"the Absolute's followers are hunting - it's the artefact that she carries.*"
msgstr ""
"*섀도하트의 불안감이 느껴집니다. 보스가 찾는 무기는 절대자의 추종자들이 노리는 바로 그 물건입니다. 바로 그녀가 지닌 아티팩트 "
"말입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Narrator
#. NodeID = e967421b-7495-e5ab-6f95-59dd308fc3c5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(7) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:e967421b-7495-e5ab-6f95-59dd308fc3c5
msgctxt "h7b686c7dg7a74g4a1ag92f3g3908e99254f7"
msgid ""
"*You feel Shadowheart's anxiety. The weapon that Voss seeks - it's the "
"artefact that she carries.*"
msgstr "*섀도하트의 불안감이 느껴집니다. 보스가 찾고 있는 무기, 그건 바로 그녀가 가지고 다니는 아티팩트입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Lae'zel
#. NodeID = f3805127-41ec-75e7-e038-2fb6b96c159f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:f3805127-41ec-75e7-e038-2fb6b96c159f
msgctxt "h0c53fb9ag85feg4ce4gb42fg869a25734313"
msgid "What? Half-wit! I have not suffered for you to deny me!"
msgstr "뭐? 머저리 같으니! 힘들게 동행해 줬건만 이제 와서 방해하려 들다니!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Lae'zel
#. NodeID = f69ec4cd-962a-c6ff-6e45-348fc2326c61
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:f69ec4cd-962a-c6ff-6e45-348fc2326c61
msgctxt "hb0010d2dga45bg4783g8721g6a9b30190121"
msgid "Imbecile. Stay <i>back</i>!"
msgstr "이 얼간이가. <i>물러가라</i>!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Narrator
#. NodeID = fa91ea27-b079-47cf-4f99-81f1dbe94cdf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Orpheus_Knows_GobLookingForWeapon = True
#.   Tag:
#.      - AVATAR(7) = True
#.      - REALLY_SHADOWHEART(7) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:fa91ea27-b079-47cf-4f99-81f1dbe94cdf
msgctxt "hf5866e36g6940g4cb3ga058g53bf50279ab2"
msgid ""
"*You realise that the weapon Voss speaks of is the gith artefact you carry. "
"You must keep it from him, just as you must keep it from the Absolute.*"
msgstr ""
"*보스가 말하는 이 무기는 바로 당신이 들고 다니는 아티팩트입니다. 절대자에게서 이걸 지켜야 하는 것과 마찬가지로, 보스의 손에도 "
"들어가지 않도록 지켜야만 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Kith'rak Voss
#. NodeID = fba0fe61-1bbc-57d6-e470-87d72a243fd1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:fba0fe61-1bbc-57d6-e470-87d72a243fd1
msgctxt "h58171667ge5cag4953gbc32ge2d70d5f59dd"
msgid "Qudenos - to the sky!"
msgstr "쿠데노스, 하늘로!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel
#. Speaker = Lae'zel
#. NodeID = ff4a028c-4b8e-34cb-9879-6bc7183307fa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ConfrontationLaezel:ff4a028c-4b8e-34cb-9879-6bc7183307fa
msgctxt "h68a9fb75gfbbcg4427ga563g647d1bd63faf"
msgid "...Lae'zel."
msgstr "...레이젤."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_DragonEvent
#. Speaker = Kith'rak Voss
#. NodeID = 3154eba1-fe6a-1a67-7255-79db67d087bd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_DragonEvent:3154eba1-fe6a-1a67-7255-79db67d087bd
#, fuzzy
msgctxt "h80967d3cgd02bg4401gb097gfb0d48c324ba"
msgid "Our queen watches us. Fail her at your peril."
msgstr "여왕님께서 우릴 지켜보신다. 실망시키지 말도록."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_DragonEvent
#. Speaker = Gauntlet Dion
#. NodeID = 4fe558ad-6462-e6ae-50b5-8e2e07709c74
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_DragonEvent:4fe558ad-6462-e6ae-50b5-8e2e07709c74
msgctxt "h2679ff8ag9517g4e3fgb34ag3c476ed8bfa9"
msgid "Drop your weapons!"
msgstr "무기를 버려라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_DragonEvent
#. Speaker = Kith'rak Voss
#. NodeID = 6493a965-b907-4c6c-66c6-d2d660a3445e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_DragonEvent:6493a965-b907-4c6c-66c6-d2d660a3445e
msgctxt "h513a8fa9g2ee1g498eg9b02g316394d5bb3f"
msgid "Stop wasting time, Baretha. You're not here to play with the locals."
msgstr "시간 낭비 마라, 바레사. 토착민들과 노닥거리려고 여기 온 것이 아니니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_DragonEvent
#. Speaker = Gauntlet Dion
#. NodeID = 85ee6dff-02be-24a9-9baa-612036f7b20c
