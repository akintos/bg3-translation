msgctxt "h819ca4b3g0777g48f7gb4afgd9a3b5ff2b6e"
msgid "<i>Focus on your oath as you try to wrest control from the hag.</i>"
msgstr "<i>해그에게 통제권을 뺏기지 않기 위해 맹세에 집중한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_ControlledByMask
#. Speaker = Lae'zel
#. NodeID = 6cda416d-e32f-4c25-b25b-65e48e27b9ce
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(2) = True
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_ControlledByMask:6cda416d-e32f-4c25-b25b-65e48e27b9ce
msgctxt "h96322c85g4471g4fe5g91b0gf26ce1c2599d"
msgid "What has come over you?"
msgstr "너에게 어떤 변화가 일어난 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_ControlledByMask
#. Speaker = Wyll
#. NodeID = 6e165696-369e-45a0-b9b6-a9c0ffd8fb4b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_WYLL(6) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_ControlledByMask:6e165696-369e-45a0-b9b6-a9c0ffd8fb4b
msgctxt "hc0925e57gde92g4a98gb94egf9d36d4470c6"
msgid "What in the hells...?"
msgstr "대체 뭐야...?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_ControlledByMask
#. Speaker = Lae'zel
#. NodeID = 6f3a4b18-2383-4fcb-a4f0-f9d2e17a510c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(2) = True
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_ControlledByMask:6f3a4b18-2383-4fcb-a4f0-f9d2e17a510c
msgctxt "ha5b109a8g7ae4g491egbf5bg760002db0f96"
msgid "What are you...? <i>Pa'vrylk</i> - remove the mask. <i>Now!</i>"
msgstr "대체 뭐하는...? <i>Pa'vrylk</i> - 가면을 벗어. <i>당장!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_ControlledByMask
#. Speaker = Auntie Ethel
#. NodeID = 84719b7c-9cb2-6dc4-7737-51a87420525f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_ControlledByMask:84719b7c-9cb2-6dc4-7737-51a87420525f
msgctxt "hcf5c2883g60aeg4270g8c6bge55758331a4f"
msgid "Nice try, little paladin. Pity you lack <i>conviction.</i>"
msgstr "시도는 좋았어, 꼬마 팔라딘. 너는 <i>신념</i>이 부족한 게 안타깝군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_ControlledByMask
#. Speaker = Auntie Ethel
#. NodeID = 908ddd66-123c-42c4-86c3-d0df461af5fe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_ControlledByMask:908ddd66-123c-42c4-86c3-d0df461af5fe
msgctxt "hf742da0ag4b45g47fagb34cga789737c796b"
msgid ""
"<i>Yes.</i> I have you now, petal. Don't worry. Auntie is going to take good "
"care of you."
msgstr "<i>그래.</i> 이제 내가 있어, 꽃잎아. 걱정하지 마. 이모가 잘 돌봐줄게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_ControlledByMask
#. Speaker = Narrator
#. NodeID = 9a3f5e7c-4adf-4769-a16b-db683bca2377
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_ControlledByMask:9a3f5e7c-4adf-4769-a16b-db683bca2377
msgctxt "h5db5a2b9g23dcg4752g8bddgde106c272651"
msgid ""
"*The stench of rot is a slap to the face. Suddenly she is there. Beside you. "
"Behind you. <i>Inside you.</i>*"
msgstr "*썩은 악취가 얼굴을 때립니다. 갑자기 그녀가 그곳에 있습니다. 당신 옆에. 당신 뒤에. <i>당신 안에.</i>*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_ControlledByMask
#. Speaker = Player
#. NodeID = ad735c73-1002-2f20-c683-097eb68ecfd8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GLO_PaladinOathbreaker_Event_BrokeOath(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_ControlledByMask:ad735c73-1002-2f20-c683-097eb68ecfd8
msgctxt "had877c93g0fd7g4a1ega479g22b3f6a43bed"
msgid "<i>Succumb to the hag.</i>"
msgstr "<i>해그에게 굴복한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_ControlledByMask
#. Speaker = Auntie Ethel
#. NodeID = bd0a8eff-4aea-b20e-d072-0e4845856ddd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_ControlledByMask:bd0a8eff-4aea-b20e-d072-0e4845856ddd
msgctxt "h82e59ea3gfe83g4711gba7dge7dbcff88071"
msgid "ARGH! THAT HURT, YOU LITTLE SHIT!"
msgstr "<b>아악! 아프잖아, 이 좆만한 게!</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_ControlledByMask
#. Speaker = Auntie Ethel
#. NodeID = c8ea2e20-2a66-45da-b931-1bb33590f834
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 5e4e3a92-3f90-9950-5c7e-a3f8fe0b95c7_B = True
#. SetFlags:
#.   Local:
#.     - 5e4e3a92-3f90-9950-5c7e-a3f8fe0b95c7_A = False
#.     - 5e4e3a92-3f90-9950-5c7e-a3f8fe0b95c7_B = False
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_ControlledByMask:c8ea2e20-2a66-45da-b931-1bb33590f834
msgctxt "h32f5a544ga454g4c43g9a7fga003c47df264"
msgid "Stay with me, petal. Stay with Auntie. Forever."
msgstr "내 곁에 있어주렴, 꽃잎아. 이모랑 영원히 같이 있는 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_ControlledByMask
#. Speaker = Karlach
#. NodeID = d723e69a-bb94-48f6-a9e2-248936aa5e12
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_KARLACH(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_ControlledByMask:d723e69a-bb94-48f6-a9e2-248936aa5e12
msgctxt "h6bce7046gacc4g4977g9b8fg0058d974100a"
msgid "The hag's in your head! Take that mask off - now!"
msgstr "해그가 네 머릿속에 있어! 그 가면을 벗어 - 당장!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_ControlledByMask
#. Speaker = Shadowheart
#. NodeID = d8355572-c7c4-49e2-a9a4-1b8ca526334d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_ControlledByMask:d8355572-c7c4-49e2-a9a4-1b8ca526334d
msgctxt "he43076e5ge98ag461dga7f7g41efe2ed0812"
msgid "What are you playing at...?"
msgstr "대체 뭘 가지고 노는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_ControlledByMask
#. Speaker = Astarion
#. NodeID = df6fbd1f-f6ec-457f-9916-2ee4c68d3415
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom2(5) = True
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_ControlledByMask:df6fbd1f-f6ec-457f-9916-2ee4c68d3415
msgctxt "h45ca26ffg65b2g4b53ga154g5d2ea93dcb12"
msgid "It's the mask - take it off, you fool!"
msgstr "가면이잖아 - 벗어, 이 멍청아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_ControlledByMask
#. Speaker = Gale
#. NodeID = e50ada33-7bae-4362-b703-6e056ab7a4ef
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_GALE(7) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_ControlledByMask:e50ada33-7bae-4362-b703-6e056ab7a4ef
msgctxt "h5eaf145fg6adag4e62ga489g11e00334e1e9"
msgid "What's going on? Something's amiss!"
msgstr "무슨 일이야? 뭔가 잘못됐어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_ControlledByMask
#. Speaker = Astarion
#. NodeID = ec3aa8c8-09e2-46f1-8d29-78e9c2f3a952
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_ControlledByMask:ec3aa8c8-09e2-46f1-8d29-78e9c2f3a952
msgctxt "hd0f03f9fga7e5g491dgab55gbabc97f47031"
msgid "What's happening? What did you do?"
msgstr "대체 무슨 일이지? 지금 뭘 한 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_ControlledByMask
#. Speaker = Player
#. NodeID = f7e8c1a7-45f3-583e-68c2-6988f9bc5236
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - PALADIN_ANCIENTS(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_ControlledByMask:f7e8c1a7-45f3-583e-68c2-6988f9bc5236
msgctxt "hf1e19f15g6b40g402bg9ca1g3ae4749a917e"
msgid "<i>Focus on your oath as you try to wrest control from the hag.</i>"
msgstr "<i>해그에게 통제권을 뺏기지 않기 위해 맹세에 집중한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_ControlledByMask
#. Speaker = Astarion
#. NodeID = f898b5da-1b6e-4b2d-8b8d-bfbd255597f6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_ControlledByMask:f898b5da-1b6e-4b2d-8b8d-bfbd255597f6
msgctxt "h1f8f001bg80ccg4ff7gb081g4a1b7bc0eece"
msgid "You fool. Take off the mask - now!"
msgstr "이런 멍청한. 가면을 벗어, 당장!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_EntranceDouble
#. Speaker = Auntie Ethel
#. NodeID = 1879d004-e2ba-ed8d-324b-a7a13098d87b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_EntranceDouble:1879d004-e2ba-ed8d-324b-a7a13098d87b
msgctxt "h1d9478cag3278g4e84g9ef8g1a7ae0d5eba0"
msgid "This is my personal play house. And you don't have an invite. Get. Out."
msgstr "이곳은 내 놀이터야. 그리고 넌 초대받지 않았어. 당장. 나가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_EntranceDouble
#. Speaker = Auntie Ethel
#. NodeID = 1b4a6851-6c53-f5e3-7898-8bf141a972ed
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAG_HagLair_EntranceDouble_Leave = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_EntranceDouble:1b4a6851-6c53-f5e3-7898-8bf141a972ed
msgctxt "h166e16d8g8ba2g4b39g8fb5g9fd8b53d98b7"
msgid ""
"She <i>chose </i>to be here, petal. But go ahead - risk yourself for the "
"brat, and see where it gets you. HAH."
msgstr ""
"녀석은 <i>원해서</i> 이곳에 있는 거야, 꽃잎아. 뭐, 어디 해 보든지. 저 버르장머리 없는 년을 위해 위험을 감수해서, 결과가 "
"어떻게 될지 봐라. <b>하.</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_EntranceDouble
#. Speaker = Auntie Ethel
#. NodeID = 1cecdf84-2c22-17a0-8a05-56c45247fb5a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAG_HagLair_EntranceDouble_Leave = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_EntranceDouble:1cecdf84-2c22-17a0-8a05-56c45247fb5a
msgctxt "h77f5aee0g3af8g49d7ga89bga5e454576770"
msgid "Keep going, petal - and you'll find out. HAH."
msgstr "계속해 봐, 꽃잎아. 그럼 알게 될 테니. <b>하</b>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_EntranceDouble
#. Speaker = Auntie Ethel
#. NodeID = 326c5fbf-c87e-933c-a4d4-d229701ed9dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_EntranceDouble:326c5fbf-c87e-933c-a4d4-d229701ed9dc
msgctxt "hada2caacg3002g44ceg90dcg3a1a30e6d384"
msgid ""
"Has that wriggler eaten your brain already? Leave. Or you'll end up in "
"tonight's stew."
msgstr "그 벌레가 벌써 네 뇌를 갉아먹었니? 나가거라. 그렇지 않으면 오늘밤 스튜가 될 게야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_EntranceDouble
#. Speaker = Player
#. NodeID = 38673df0-c24e-b004-944c-a9873078668d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_HagSpawn_SurrogateMother_State_InLair = True
#.   Tag:
#.      - PALADIN_DEVOTION(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_EntranceDouble:38673df0-c24e-b004-944c-a9873078668d
msgctxt "h1831e09dg26c6g4423g8a3cgf66e980212a2"
msgid "I cannot - not without Mayrina. I won't let you hurt her."
msgstr "메이리나 없이는 떠나지 않아. 네가 그녀를 해치게 두지 않겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_EntranceDouble
#. Speaker = Player
#. NodeID = 3ee05168-4e01-8278-751b-fbbae154b27c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_HagSpawn_SurrogateMother_State_InLair = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_EntranceDouble:3ee05168-4e01-8278-751b-fbbae154b27c
msgctxt "he5cce1c5g3ef2g4d7dgb76eg64964505eb65"
msgid "Tell me where Mayrina is."
msgstr "메이리나가 어딨는지 말해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_EntranceDouble
#. Speaker = Player
#. NodeID = 4bcd7e6d-73c7-b0fc-0f1d-148fc61ab234
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN_ANCIENTS(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_EntranceDouble:4bcd7e6d-73c7-b0fc-0f1d-148fc61ab234
msgctxt "h81a6f07eg82d9g4c6ag878agaa3ba9f068f9"
msgid ""
"I cannot. You are a perversion of the natural order, hag - I must kill you."
msgstr "그럴 수 없다. 넌 자연의 질서를 왜곡했어, 해그. 널 죽이는 게 내 의무다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_EntranceDouble
#. Speaker = Auntie Ethel
#. NodeID = 542bb4c1-c4af-84a6-67db-1fd2c076ae9a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_EntranceDouble:542bb4c1-c4af-84a6-67db-1fd2c076ae9a
#, fuzzy
msgctxt "h2dbfe1fcg0fa7g4ebfg8324ge9200a889320"
msgid ""
"You had better. Or I'll cut you into little pieces and serve you with a "
"slice of lemon."
msgstr "좋은 선택이야. 아니면 내가 널 조각 조각 썰어 레몬을 곁들여 내었을 테니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_EntranceDouble
#. Speaker = Auntie Ethel
#. NodeID = 62e4bdbd-5498-44d7-a623-894f2898d538
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_HagSpawn_SurrogateMother_State_InLair = True
#. SetFlags:
#.   Global:
#.     - HAG_HagLair_EntranceDouble_Leave = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_EntranceDouble:62e4bdbd-5498-44d7-a623-894f2898d538
msgctxt "hc481cb5bgad2fg4b91g8c24g5478dc8d46e7"
msgid "You'll go nicely with Mayrina. She's already marinating. HAH!"
msgstr "너는 메이리나와 잘 어울릴 거야. 그녀는 이미 양념하는 중이거든. 하!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_EntranceDouble
#. Speaker = Auntie Ethel
#. NodeID = 7ddd5e81-a76c-1080-51e5-74c28ad0f8da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_EntranceDouble:7ddd5e81-a76c-1080-51e5-74c28ad0f8da
msgctxt "ha235fbcag8a46g4c22g82b9g277f6278954c"
msgid "Oh, the cocky ones are my favourite to chew on."
msgstr "오, 건방진 녀석들을 손봐주는 게 제일 좋다니깐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_EntranceDouble
#. Speaker = Auntie Ethel
#. NodeID = 968a2fe7-31f3-c0fb-3a35-8418316b5b6a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_EntranceDouble:968a2fe7-31f3-c0fb-3a35-8418316b5b6a
msgctxt "hada043dag05d8g48acga856g54c379b15930"
msgid ""
"Gods alive, a <i>paladin.</i> You lot are drier than shite in the noonday "
"sun."
msgstr "신이시여, <i>팔라딘이잖아.</i> 너희는 땡볕 아래의 똥보다 더 뻣뻣하다니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_EntranceDouble
#. Speaker = Player
#. NodeID = 9ffc4874-9d0d-53b3-59c1-a829e86b6d93
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Not_For_EA = True
#.   Tag:
#.      - PALADIN_VENGEANCE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_EntranceDouble:9ffc4874-9d0d-53b3-59c1-a829e86b6d93
msgctxt "h2b3e7e32g54bag43eag9239g6a167373c612"
msgid "I am sworn to end your life, hag - do not resist."
msgstr "내 맹세가 네 목숨을 끝내길 원한다, 해그야. 저항하지 마라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_EntranceDouble
#. Speaker = Auntie Ethel
#. NodeID = aea5b486-924a-a5f9-4043-684360b114b6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAG_HagLair_EntranceDouble_Leave = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_EntranceDouble:aea5b486-924a-a5f9-4043-684360b114b6
#, fuzzy
msgctxt "ha7d5057dg6ea4g4a3egb89cg0f88d9190926"
msgid ""
"I've picked plenty of your brethren from my teeth, petal - and I look "
"forward to seeing how tasty you are. HAH."
msgstr "수많은 네 동족들을 내 이빨 사이에서 빼내야 했단다, 꽃잎아 - 넌 과연 얼마나 맛있을지 기대가 되는구나. 하."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_EntranceDouble
#. Speaker = Player
#. NodeID = b8b62f69-147c-808f-99e6-19dc5511be45
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_HagSpawn_SurrogateMother_State_InLair = False
#.   Tag:
#.      - PALADIN_DEVOTION(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_EntranceDouble:b8b62f69-147c-808f-99e6-19dc5511be45
msgctxt "h4b1e655eg9bb4g4edegb85ag7ade6961ec29"
msgid "You thrive on the blood of innocents, hag - I cannot let you live."
msgstr "넌 무고한 이들을 짓밟으며 살아간다, 해그. 널 살려둘 순 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_EntranceDouble
#. Speaker = Auntie Ethel
#. NodeID = c7c3e2c0-ccdc-02a1-8f7d-9a74c0ea7538
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - HAGEYED(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_EntranceDouble:c7c3e2c0-ccdc-02a1-8f7d-9a74c0ea7538
msgctxt "hdc391648g98bbg4fbfg875cg2423fd739e19"
msgid ""
"That pretty little eye of yours is <i>mine</i>. Did you think you could "
"sneak down here without my say so?"
msgstr "너의 그 작고 예쁜 눈은 이제 <i>내 눈</i>이야. 내 허락 없이 몰래 내려올 수 있을 거라고 생각했니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_EntranceDouble
#. Speaker = Auntie Ethel
#. NodeID = c9af7124-ed61-191e-e1bf-1f85ec6a54ac
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAG_HagLair_EntranceDouble_Leave = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_EntranceDouble:c9af7124-ed61-191e-e1bf-1f85ec6a54ac
msgctxt "h215aeac7g6775g4d28g8ee6gb48c725df5b5"
msgid "HAH!"
msgstr "하!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_EntranceDouble
#. Speaker = Auntie Ethel
#. NodeID = cabcae72-fbba-60c0-04ee-13b0169a85bc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_EntranceDouble:cabcae72-fbba-60c0-04ee-13b0169a85bc
msgctxt "h9abdf948g623ag49b2gaab6gde879d2017df"
msgid "You are as thick as they come, sweetness."
msgstr "너는 참 머리도 둔하구나, 귀염둥아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_EntranceDouble
#. Speaker = Player
#. NodeID = e1e81165-2444-f31b-2ed7-169584c58a82
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_EntranceDouble:e1e81165-2444-f31b-2ed7-169584c58a82
msgctxt "hd6121234gdb11g4bc4gb9d3g7f25a2dd2a5c"
msgid "Or what?"
msgstr "싫다면?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_EntranceDouble
#. Speaker = Player
#. NodeID = e388972f-075a-a960-ab16-cb31c09d1d7c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_EntranceDouble:e388972f-075a-a960-ab16-cb31c09d1d7c
msgctxt "h586675e9g6950g4ab3g9a0cgc84fd19f9148"
msgid "I think I'll stay a while."
msgstr "한동안은 머물러야겠는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_EntranceDouble
#. Speaker = Player
#. NodeID = f10606b0-92e4-fdcd-5e50-19c37b01390c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_EntranceDouble:f10606b0-92e4-fdcd-5e50-19c37b01390c
msgctxt "hbfcbcefeg1003g478cg983bg807b43dd00e0"
msgid "Forgive me. I'll leave right away."
msgstr "용서해줘. 바로 떠날게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_EntranceDouble_StatusFallback
#. Speaker = Auntie Ethel
#. NodeID = 0a68d2ae-607d-47bf-8ea4-e99e70c171f2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAG_HagLair_EntranceDouble_Leave = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_EntranceDouble_StatusFallback:0a68d2ae-607d-47bf-8ea4-e99e70c171f2
msgctxt "h69f61584g8f24g4babg9cfbge79cae0bfa23"
msgid "This is my personal play house. And you don't have an invite. Get. Out."
msgstr "이곳은 내 놀이터야. 그리고 넌 초대받지 않았어. 당장. 나가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_EntranceDouble_StatusFallback
#. Speaker = Auntie Ethel
#. NodeID = d2d34131-924f-413b-b933-8f453da233b0
