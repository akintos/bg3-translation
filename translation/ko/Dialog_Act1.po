msgctxt "h2ce31a64gd63ag4b32gbe70g970b9244e8dd"
msgid "<i>Kneel down in front of him.</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = 406fafcf-4472-4535-f12a-589af5b83e60
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Absolute_Knows_GoblinsWorship = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:406fafcf-4472-4535-f12a-589af5b83e60
msgctxt "h96065815g4ca4g4a72gb43cg3f12043af209"
msgid "But no more. Things're changin'. We got the Absolute on our side now."
msgstr "하지만 더는 아니야. 상황이 바뀌고 있어. 우리 편에는 절대자님이 있으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = 40f544d9-95c7-b947-5cec-26ea21e4ff3c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:40f544d9-95c7-b947-5cec-26ea21e4ff3c
msgctxt "hb2d4b9cfg0365g4e1egb982g2ded962ea6ae"
msgid "Ya better learn yer place."
msgstr "네 주제를 아는 게 좋을 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Brawler Tiny
#. NodeID = 42681f8a-3ad8-bb3b-8698-947112c45366
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:42681f8a-3ad8-bb3b-8698-947112c45366
msgctxt "hd47ddbcdgae4dg4799g8f0ag58460f717899"
msgid "Oh ho, you got 'im good!"
msgstr "오 호, 잘 처리했네!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = 44fabf9b-01dc-69e8-b115-cadc6ea3b38a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_DrunkGoblin_Event_StartFistFight(4) = True
