msgctxt "hf34bb887g59c0g42ecga388g7215180d1ffa"
msgid "Just hold still."
msgstr "가만히 있으렴."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD_WithBird
#. Speaker = Wounded Bird
#. NodeID = ad396a11-d928-cc95-d44c-624863739d47
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD_WithBird:ad396a11-d928-cc95-d44c-624863739d47
msgctxt "h8a51f977g39b8g49adg842fg108e06021d8a"
msgid "*Chirp.*"
msgstr "*짹짹.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD_WithBird
#. Speaker = Wounded Bird
#. NodeID = f19ad64d-4a03-d5c5-8fed-aed4ef4131b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD_WithBird:f19ad64d-4a03-d5c5-8fed-aed4ef4131b6
msgctxt "h02a49ee2ga263g44ecgafd4ga45994964b73"
msgid "*Chirp.*"
msgstr "*짹짹.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Bird
#. Speaker = Player
#. NodeID = 073ded13-cd2b-24ca-acd9-75b0c24ee5e5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Bird:073ded13-cd2b-24ca-acd9-75b0c24ee5e5
msgctxt "h78392a96ge3acg49e1ga255g5d108c1166b8"
msgid "Where are you going?"
msgstr "어디로 가는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Bird
#. Speaker = Tingmiaq
#. NodeID = 1235862f-7462-3164-7949-7109331069aa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Bird:1235862f-7462-3164-7949-7109331069aa
msgctxt "h255bc9bcgfed7g41ebgb675ga888a3bc9772"
msgid "*Chirp!*"
msgstr "*짹짹!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Bird
#. Speaker = Player
#. NodeID = 1edefcc4-807e-da42-6559-56b8ec3292ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Bird:1edefcc4-807e-da42-6559-56b8ec3292ea
msgctxt "h07d8fdd8ga3cfg4993g849bgd8d20bf3e870"
msgid "What's the rush?"
msgstr "왜 그렇게 급해?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Bird
#. Speaker = Player
#. NodeID = 2bf8753e-1525-5e24-2317-f2e98b426822
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Bird:2bf8753e-1525-5e24-2317-f2e98b426822
msgctxt "h6a331bbdg9e60g4d88gad3fg01be8493d9c6"
msgid "I need information, friend. Spare me a moment?"
msgstr "정보가 필요해, 친구. 시간을 좀 내주겠어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Bird
#. Speaker = Tingmiaq
#. NodeID = 38bac0e7-fb31-780c-de83-70a234267706
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: !(DROWELF and ELF and HALFELF)
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Bird:38bac0e7-fb31-780c-de83-70a234267706
msgctxt "hc78af089gf901g4f4fgb4e6ga6893da76e87"
msgid "Goblins. Gnolls. All manner of monsters!"
msgstr "고블린. 놀. 온갖 종류의 괴물이 가득해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Bird
#. Speaker = Tingmiaq
#. NodeID = 38bac0e7-fb31-780c-de83-70a234267706
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Bird:38bac0e7-fb31-780c-de83-70a234267706
msgctxt "hb2a12d91gb2cag4614gb836g768e620c6f56"
msgid "Goblins. Gnolls. Even elves that look like you."
msgstr "고블린. 놀. 너 같이 생긴 엘프까지 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Bird
#. Speaker = Tingmiaq
#. NodeID = 38bac0e7-fb31-780c-de83-70a234267706
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: ELF or HALFELF
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Bird:38bac0e7-fb31-780c-de83-70a234267706
msgctxt "hb922667cg88c5g441bgaa8cg9ac6b06e8bf2"
msgid "Goblins. Gnolls. Even a couple of your underground cousins."
msgstr "고블린. 놀. 너희 지하 친척들도 몇 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Bird
#. Speaker = Player
#. NodeID = 529a8474-d9a2-b9af-8f5b-a984e96e322f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BALDURIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Bird:529a8474-d9a2-b9af-8f5b-a984e96e322f
msgctxt "h16888ef5g620fg4e5ag8c45g94c0fac439ce"
msgid "Do you know Baldur's Gate? Is the city far?"
msgstr "발더스 게이트에 대해서 알아? 여기서 멀어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Bird
#. Speaker = Tingmiaq
#. NodeID = 5f765554-b242-aa36-0523-4bddcedce20c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Bird:5f765554-b242-aa36-0523-4bddcedce20c
msgctxt "h94faf687g8f32g45cfg9b59gc348ce2e3903"
msgid "Not now. Places to be."
msgstr "지금은 안돼. 가야 할 곳이 있어서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Bird
#. Speaker = Player
#. NodeID = 60367e26-3a45-40fd-cc8d-893e7323b29b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_IsMissing = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Bird:60367e26-3a45-40fd-cc8d-893e7323b29b
msgctxt "h82d303bcg9c95g47c7g8a9dgd17845a1ced0"
msgid "I'm looking for the druid Halsin. Where is he?"
msgstr "할신이라는 드루이드를 찾고 있어. 어디에 있는지 알아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Bird
#. Speaker = Tingmiaq
#. NodeID = 63c70028-672a-341e-34bc-221e5916b753
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Bird:63c70028-672a-341e-34bc-221e5916b753
msgctxt "hce88ccb1g0e93g4c44g91e6g82d50dfdf2ed"
msgid "Now I have to go. There's not a moment to lose!"
msgstr "이제 가봐야겠어. 한시도 지체할 수 없어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Bird
#. Speaker = Player
#. NodeID = 678173aa-2844-63fd-14de-2e3845a1d6cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Bird:678173aa-2844-63fd-14de-2e3845a1d6cb
msgctxt "haba7c503g2e7dg441agaa36g96d0f2194bd8"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Bird
#. Speaker = Player
#. NodeID = 7d54ebe9-db2a-4536-bbb4-9d4c57bf9638
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Bird:7d54ebe9-db2a-4536-bbb4-9d4c57bf9638
msgctxt "h3c00603agfe6eg415fg85b3g1d736cc2dae8"
msgid "What's waiting for us outside this grove? In the wilds?"
msgstr "이 숲 바깥의 야생에는 뭐가 있어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Bird
#. Speaker = Player
#. NodeID = 90e9b549-9b2e-c0c3-4e88-62e15e7836b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Bird:90e9b549-9b2e-c0c3-4e88-62e15e7836b1
msgctxt "h871b9593gda91g4d7dg95a5g671c148e629d"
msgid "Never mind. Off you go."
msgstr "아무것도 아니야. 가던 길 가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Bird
#. Speaker = Tingmiaq
#. NodeID = 96b2acfd-3cf4-3e35-bced-7103a312c831
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Bird:96b2acfd-3cf4-3e35-bced-7103a312c831
msgctxt "h0a1c064cga961g4f5agab20g1ab49b9d7916"
msgid "I know these hills, and there's no city here."
msgstr "이쪽 언덕은 아는데, 여긴 도시라곤 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Bird
#. Speaker = Tingmiaq
#. NodeID = af2c82b5-249c-2e88-d228-659c01352871
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_SenderBird_Event_TakeOff = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Bird:af2c82b5-249c-2e88-d228-659c01352871
msgctxt "he7eb0423g56c7g4d99gb7a1g727a715f3564"
msgid "I have to find Halsin. There's not a moment to lose!"
msgstr "할신을 찾아야 해. 낭비할 시간이 없어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Bird
#. Speaker = Tingmiaq
#. NodeID = b500a419-0cbf-5ed3-3ae3-1b8719cfcc1a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Bird:b500a419-0cbf-5ed3-3ae3-1b8719cfcc1a
msgctxt "hf5ef66a3g0aedg488eg981agdc0fc4a46be0"
msgid "That's what I'm trying to find out!"
msgstr "나도 그걸 알아내려는 거야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Bird
#. Speaker = Narrator
#. NodeID = c32bd213-37ac-53f7-396a-7e6c237fecaa
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_SenderBird_Event_TakeOff = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Bird:c32bd213-37ac-53f7-396a-7e6c237fecaa
msgctxt "h020c305egff3bg4c12g999cg626031c6bb68"
msgid ""
"*He flutters into the air without another word, setting off at a determined "
"pace.*"
msgstr "*녀석은 대답 없이 하늘로 날아오르며, 단호히 날아갑니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Bird
#. Speaker = Tingmiaq
#. NodeID = dcea68e3-9bd2-07d9-d79e-8997c4899a55
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Bird:dcea68e3-9bd2-07d9-d79e-8997c4899a55
msgctxt "h09997ca2g3eedg45f4g90a5gcd25d3e8e124"
msgid "For one of our own. But be quick."
msgstr "우리 편을 위해서라면. 하지만 서둘러."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Bird
#. Speaker = Tingmiaq
#. NodeID = fc1a3c91-203a-3177-2cfb-d9f496cc9880
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_SenderBird_Event_TakeOff = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Bird:fc1a3c91-203a-3177-2cfb-d9f496cc9880
msgctxt "h9c91b21fge5a5g45e6g96acg1ecd2b90b28f"
msgid "To find Halsin. There's not a moment to lose!"
msgstr "할신을 찾으러. 낭비할 시간이 없어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_CombatStarts
#. Speaker = Nettie
#. NodeID = 1b9bfa64-54f6-482f-83c9-24c549f1fe7c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_CombatStarts:1b9bfa64-54f6-482f-83c9-24c549f1fe7c
msgctxt "h62e92bc5g5397g4910g89d3g29a0b495f418"
msgid ""
"I tried to make this easy on you and give you some time. But if you won't "
"stop, I'll have to stop you."
msgstr "좀 편하게 해드리려고 충분한 시간을 드렸어요. 하지만 스스로 하실 수 없겠다면, 제가 할 수밖에 없겠군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 0082370a-9d8a-5ca8-20ed-6cb7a8593ac7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Apprentice_Knows_IdentifiedBranch = True
#.   Object:
#.      - DEN_Apprentice_State_Cyanide_ShortPath(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:0082370a-9d8a-5ca8-20ed-6cb7a8593ac7
msgctxt "h622b0d2dg02dfg44ddga7c0g0617497d50fd"
msgid "More poison? I would've preferred a cure."
msgstr "또 독이야? 치료제였으면 좋았을 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 01162b06-8316-6df5-518e-b16b11823aa2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:01162b06-8316-6df5-518e-b16b11823aa2
msgctxt "ha43d2dabgb7b1g4034g8668ga344a72f9bde"
msgid ""
"You know, I've spent my life treating folk and never once saw a mind flayer "
"infection. Then suddenly there's dozens of you - maybe more."
msgstr ""
"저기, 전 평생 사람들을 치료해왔지만 한 번도 마인드 플레이어 감염을 본 적이 없어요. 그런데 당신과 같은 이들이 갑자기 수십 명, "
"어쩌면 그보다 많이 나타났어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 02034357-5d68-19b1-d8e7-61cc8e60c636
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:02034357-5d68-19b1-d8e7-61cc8e60c636
msgctxt "h449e7e54gaed2g45d9g89cag30b45aedd78f"
msgid "The door's locked. Neither of us are leaving until this is done."
msgstr "문은 잠겼어요. 이 일이 마무리되기 전까진 누구도 떠날 수 없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 026d6313-a5f3-c3ee-d927-8fe28b4036a7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - GLO_TUT_Knows_TalkedToIntellectDevourer(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:026d6313-a5f3-c3ee-d927-8fe28b4036a7
msgctxt "h46a9ac5fg4bc6g46b7g987fgc35487df8e9d"
msgid "An intellect devourer spoke to me. That was a little odd."
msgstr "한 지성 포식자가 내게 말을 걸었어. 그게 조금 이상했지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 04e2704e-f560-a844-2cdf-7de0c2d878ce
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_TYR or PALADIN_TYR
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:04e2704e-f560-a844-2cdf-7de0c2d878ce
msgctxt "h5f7643b2gee1eg4c79gaa29gd997e2b4cb7d"
msgid "I swear, by the Lord of Justice."
msgstr "정의의 신의 이름으로 맹세할게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 04e2704e-f560-a844-2cdf-7de0c2d878ce
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: CLERIC_SELUNE or PALADIN_SELUNE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:04e2704e-f560-a844-2cdf-7de0c2d878ce
msgctxt "h13219fefg0720g450cg9efcg22631b2e634f"
msgid "By Our Lady of Silver, I swear it."
msgstr "은의 여인의 이름으로 맹세할게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 04e2704e-f560-a844-2cdf-7de0c2d878ce
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: CLERIC_ILMATER or PALADIN_ILMATER
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:04e2704e-f560-a844-2cdf-7de0c2d878ce
msgctxt "hb374ef60g3a3eg4152g90ecg36710eac9777"
msgid "In the name of He Who Endures, I swear it."
msgstr "인내하시는 자의 이름으로 맹세할게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 04e2704e-f560-a844-2cdf-7de0c2d878ce
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: CLERIC_MYSTRA or PALADIN_MYSTRA
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:04e2704e-f560-a844-2cdf-7de0c2d878ce
msgctxt "h0ae5f1f4g3f09g481ega16bgbde02876de5a"
msgid "By the Mother of All Magic, I swear it."
msgstr "마법의 어머니, 미스트라의 이름으로 맹세할게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 04e2704e-f560-a844-2cdf-7de0c2d878ce
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: CLERIC_HELM or PALADIN_HELM
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:04e2704e-f560-a844-2cdf-7de0c2d878ce
msgctxt "hac20a3a0g33dag4213gae76gb20e85b07db4"
msgid "In the Watcher's name, I swear it."
msgstr "감시자의 이름으로 맹세할게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 04e2704e-f560-a844-2cdf-7de0c2d878ce
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: CLERIC_KELEMVOR or PALADIN_KELEMVOR
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:04e2704e-f560-a844-2cdf-7de0c2d878ce
msgctxt "hdbe48041gdc6ag444bg8421g1706d07e9c8a"
msgid "In Kelemvor's name, I swear it."
msgstr "켈렘보르의 이름으로, 맹세할게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 04e2704e-f560-a844-2cdf-7de0c2d878ce
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: CLERIC_OGHMA or PALADIN_OGHMA
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:04e2704e-f560-a844-2cdf-7de0c2d878ce
msgctxt "hc22c9ae4g3798g4746gb5a6g57575caee299"
msgid "By the Lord of Knowledge, I swear it."
msgstr "지식의 신의 이름으로 맹세할게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 04e2704e-f560-a844-2cdf-7de0c2d878ce
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: CLERIC_TEMPUS or PALADIN_TEMPUS
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:04e2704e-f560-a844-2cdf-7de0c2d878ce
msgctxt "h82443deegb76dg4b1bg9ca8g302576717a8d"
msgid "By the Lord of Battles, I swear it."
msgstr "전쟁 군주의 이름으로 맹세할게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 04e2704e-f560-a844-2cdf-7de0c2d878ce
#. HandlePath = TaggedText[8].TagText[0]
#. TagRule: CLERIC_LOLTH or CLERIC_SHAR or PALADIN_LOLTH or PALADIN_SHAR
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:04e2704e-f560-a844-2cdf-7de0c2d878ce
msgctxt "hce2917a2ge7f4g4209ga79egbfe4d95ca9df"
msgid "I swear, in my Lady's name."
msgstr "여신님의 이름에 맹세할게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 04e2704e-f560-a844-2cdf-7de0c2d878ce
#. HandlePath = TaggedText[9].TagText[0]
#. TagRule: CLERIC_EVIL or PALADIN_EVIL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:04e2704e-f560-a844-2cdf-7de0c2d878ce
msgctxt "h146f6c03g9fc6g419ega5feg383246b80755"
msgid "I swear, in the name of the Most High."
msgstr "가장 높으신 분의 이름 앞에 맹세한다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 04e2704e-f560-a844-2cdf-7de0c2d878ce
#. HandlePath = TaggedText[10].TagText[0]
#. TagRule: CLERIC
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:04e2704e-f560-a844-2cdf-7de0c2d878ce
msgctxt "h183305a8g8315g49e0gac73g6d4effe9bc99"
msgid "Before you and my god, I swear it."
msgstr "당신과 나의 신 앞에 맹세해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 05a92bfc-eb3d-d89c-37a5-14a95cb0a0d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:05a92bfc-eb3d-d89c-37a5-14a95cb0a0d4
msgctxt "h850cf53cg90eag4158g8c36g90067ba6de5c"
msgid "Well... if someone else has a tadpole, our minds can merge."
msgstr "그런데... 만약 다른 사람도 올챙이를 갖고 있으면, 정신을 결합할 수 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 087112d8-7d35-a9aa-32cd-5abaca4dab79
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_IsFound = True
#.   Local:
#.      - 96fcd78d-a71b-fe26-84bd-c0f59a85b60f_ToldFoundHalsin = False
#. SetFlags:
#.   Local:
#.     - 96fcd78d-a71b-fe26-84bd-c0f59a85b60f_ToldFoundHalsin = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:087112d8-7d35-a9aa-32cd-5abaca4dab79
msgctxt "h07e43459gfb79g441agb854g513e1aa6326e"
msgid "I already know where to find him: the worg pens of the goblin camp."
msgstr "그의 행방이라면 이미 알고 있어. 고블린 야영지의 워그 우리에 있다더군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 087df8aa-7c91-66cb-eaca-0813e8ecf5d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:087df8aa-7c91-66cb-eaca-0813e8ecf5d4
msgctxt "h5dd946abgf72eg4990g9b1cg0ce440d94803"
msgid ""
"I'm sorry for misleading you, but I had to be sure you weren't a threat "
"before I told you everything."
msgstr "오해하게 해서 죄송하지만, 모든 것을 말씀드리기 전에 당신이 위협이 되지 않는지 확인해야 했어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 08bbe928-b263-ca8f-1478-6318be4a5c24
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_Apprentice_HasMet(1) = True
#. TagRule: !DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:08bbe928-b263-ca8f-1478-6318be4a5c24
msgctxt "he48df990ge896g43aeg83ffgc8358054dcee"
msgid ""
"This one had the same problem as you. Attacked us in the woods together with "
"some goblins."
msgstr "이 사람도 당신과 같은 문제가 있었어요. 고블린 몇 마리와 함께 숲에서 우릴 공격했죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 08bbe928-b263-ca8f-1478-6318be4a5c24
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_Apprentice_HasMet(1) = True
#. TagRule: DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:08bbe928-b263-ca8f-1478-6318be4a5c24
msgctxt "he854bc05g70b8g4566g88e6g9efb81a2a926"
msgid ""
"Don't worry about him on the table. I'm not in the habit of killing drow."
msgstr "테이블 위의 저 놈은 신경 쓰지 마세요. 드로우 죽이기에 맛 들린 거 아니니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 091249da-d548-5aac-855a-d6b767690d04
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:091249da-d548-5aac-855a-d6b767690d04
msgctxt "h13a297a4g3bafg430bgad91g9e8643bbb494"
msgid ""
"I respect Kagha, but she can't order me to put everyone's lives at risk."
msgstr "저는 카그하 님을 존중하지만, 그녀가 저에게 모든 사람의 목숨을 위험에 빠뜨리라고 명령할 수는 없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 0967ea47-6b81-71c3-b265-4b72d433cf7e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:0967ea47-6b81-71c3-b265-4b72d433cf7e
msgctxt "h4315d05cg5dbag475cg946fg364a29846bec"
msgid ""
"Protected from on high? Sounds like the drow - Master Halsin said he was "
"tougher than he had any right to be."
msgstr "높은 데서 보호를 받았다고요? 이 드로우와 비슷하게 들리네요 - 마스터 할신은 그가 정상적인 수준보다 강했다고 하셨어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 09890e1c-1def-fd00-fca1-ce2814114e8e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:09890e1c-1def-fd00-fca1-ce2814114e8e
msgctxt "hc94ce52ag1e04g4566g9e00g04d10f6551cb"
msgid "I don't trust you. I'm leaving."
msgstr "난 너를 믿지 않아. 나갈게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 0a1c27ac-8151-005c-d342-04413acf9082
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Quest_FindHalsin = True
#.     - DEN_Apprentice_Event_OpenDoor = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:0a1c27ac-8151-005c-d342-04413acf9082
msgctxt "h5486d22eg6baeg4fc4ga8f3g2ce0b28ee01a"
msgid ""
"Please, you have to bring him back to us. For your own sake as much as ours."
msgstr "부탁드려요, 그를 저희에게 다시 데려와 주세요. 저희뿐만 아니라 당신을 위해서라도요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 0e11ffad-8c9e-f6e0-0f82-9a8fa155cf89
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:0e11ffad-8c9e-f6e0-0f82-9a8fa155cf89
msgctxt "h2984abdeg088fg49d6ga888gf1d39f713710"
msgid "So tell me, where'd you get that thing?"
msgstr "그럼 말해 주세요, 어디서 그것을 들이게 되었나요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 0efadaff-029e-229b-06ae-12ad0a9f67b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:0efadaff-029e-229b-06ae-12ad0a9f67b3
msgctxt "h1c410787g9d73g46fcg8fc7gb029bbbb3b52"
msgid "No. That was Master Halsin."
msgstr "아뇨. 마스터 할신이 하셨습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 0f872383-26c5-7cf7-187c-bc209ad6b315
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:0f872383-26c5-7cf7-187c-bc209ad6b315
msgctxt "h0d991a50g7b84g4c00g826ag2eaa4f8ed78a"
msgid "Nothing? You're sure?"
msgstr "아무것도? 확실해요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 0fabc7fc-431f-e4db-f956-99c09077f2ea
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - MONK(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:0fabc7fc-431f-e4db-f956-99c09077f2ea
msgctxt "h54c2901dg98ccg4869g95dagd7089e6aff73"
msgid "All right. Hand it over."
msgstr "좋아. 그걸 이리 넘겨."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 0ff4b27b-3f76-2176-904b-c7e383031d7e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:0ff4b27b-3f76-2176-904b-c7e383031d7e
msgctxt "h5631c9b8g59f9g460ag8b1ag5bea84aa0108"
msgid "I don't have a cure. Only a way out."
msgstr "저에게 치료제는 없어요. 오직 탈출구밖에 없죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 12126186-0a43-18db-6b11-abc74ba6f636
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:12126186-0a43-18db-6b11-abc74ba6f636
msgctxt "hd5399787gfe9ag4383g9be2gb52eb6594ca7"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 12bead23-69db-eaa7-1036-d58b05c983cc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:12bead23-69db-eaa7-1036-d58b05c983cc
msgctxt "h97e44a59g0cbfg4e21g8e6fg2d696f99a5e3"
msgid "You must've learned something from studying them."
msgstr "너는 그것들을 연구하면서 뭔가 깨달은 게 있겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 144ec78d-682d-7cac-58be-df7ae105b6c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:144ec78d-682d-7cac-58be-df7ae105b6c0
msgctxt "h2759b080g89e5g4134g9c44gf975ff930505"
msgid "You - you're right. I'm no use to the others dead."
msgstr "당신 - 당신 말이 맞아요. 저는 다른 사람을 죽이는 데 소질이 없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 1563ada4-e907-771b-16e5-fe20d6fc4eca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:1563ada4-e907-771b-16e5-fe20d6fc4eca
msgctxt "hb1af293fgd688g4d6dgbdccg5f7cbe1f7e34"
msgid "Exactly! I'm glad you're coming to your senses."
msgstr "그러니까! 네가 상식적으로 생각하게 돼서 기쁘군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 16a43657-3857-31a3-7eff-eab76eaa2e3e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:16a43657-3857-31a3-7eff-eab76eaa2e3e
msgctxt "hc294768fg0749g4bf8ga6a8g1697a5dd8f7f"
msgid ""
"I want to help you, but I can't unless you work with me. So: has anything "
"unusual happened to you?"
msgstr "당신을 도와드리고 싶지만 협조하시지 않으면 그럴 수 없어요. 그래서, 이상한 일이 있진 않았나요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Narrator
#. NodeID = 1729a42f-f381-e102-65a6-59fbb75b9225
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Knows_IdentifiedBranch = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:1729a42f-f381-e102-65a6-59fbb75b9225
msgctxt "h4c8a022bg5011g45d8g8ff0g83cce8d06bc6"
msgid ""
"*Not many thorns have such unique poison - it has to be Kelemvor's Kiss, a "
"plant from the Dalelands. There is a cure but, try as you might, you can't "
"recall it.*"
msgstr ""
"*이렇게 독특한 독을 가진 가시는 많지 않습니다 - 이것은 데일랜드에서 자라는 식물인 켈렘보르의 입맞춤일 것입니다. 치료법이 있지만, "
"아무리 노력해도 기억이 나지 않습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 17502d9f-b53e-4f24-2415-02d9d2ee1346
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:17502d9f-b53e-4f24-2415-02d9d2ee1346
msgctxt "hc45bf31fg578eg4bfagb90fg16675c1c7e42"
msgid ""
"I'm truly, truly sorry. For what it's worth, the poison is painless. It'll "
"be like going to sleep."
msgstr "정말, 정말로 미안해요. 이 말이 도움이 될지는 모르겠지만, 고통스럽진 않을 거예요. 잠드는 것과 비슷할 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 17816119-bc75-a682-1096-8ffbba96d6c3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:17816119-bc75-a682-1096-8ffbba96d6c3
msgctxt "hf0114ad6g8049g42cfg90eag43b99c51e4df"
msgid ""
"Of course. Now, tell me what's been happening. Any symptoms? Strange events?"
msgstr "물론이죠. 이제 무슨 일이 일어났는지 말씀해 주세요. 증상이나 이상한 일이 있었나요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 185482ad-23b5-0794-4fb6-b2bad5cd91de
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - GLO_Tadpole_SUB_Druid.LearnedResearchHalsin(1) = True
#.   User:
#.     - DEN_Apprentice_State_Cyanide_Persuaded(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:185482ad-23b5-0794-4fb6-b2bad5cd91de
msgctxt "he0a4eb02gc32eg434bga9aegb2ac2ce0b507"
msgid ""
"All right! Master Halsin did say the drow's tadpole was dormant. Maybe yours "
"is too."
msgstr "알겠어요! 마스터 할신은 이 드로우의 올챙이가 휴면기에 있었다고 하셨어요. 어쩌면 당신도 마찬가지일지도요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 1b099886-92ec-90ba-7459-2f4de87e892f
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 10
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_Cyanide_Persuade2(1) = True
#.      - DEN_Apprentice_State_Cyanide_Persuade1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:1b099886-92ec-90ba-7459-2f4de87e892f
msgctxt "h1d5e9035g29e9g4874gb15eg2ac10f0a7307"
msgid ""
"As long as there's a chance, you're not saving me. You're committing murder."
msgstr "가능성이 있는 한, 이건 구원이 아니야. 살인이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 1b3a4dde-3789-caa0-7898-4fc44c636f60
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:1b3a4dde-3789-caa0-7898-4fc44c636f60
msgctxt "ha9d317fag7517g46c3g8036g4019d96c750b"
msgid "Give me the godsdamn antidote!"
msgstr "나에게 빌어먹을 해독제를 달라고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 1c3fec48-ee7b-b5e0-c988-2f8b75d1eae1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:1c3fec48-ee7b-b5e0-c988-2f8b75d1eae1
msgctxt "h150e3ab6g2364g4c37g8d9fg8ce08b24befa"
msgid "No, I'm leaving."
msgstr "안 돼. 나는 떠나야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 1c4be6bf-7292-3100-fbb0-8de7ea02d380
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_Event_GiveWyvenPoison(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:1c4be6bf-7292-3100-fbb0-8de7ea02d380
msgctxt "h662ec2a3gf111g4256g956dg69599382ef10"
msgid "The way I see it, you have two options. Halsin or that wyvern poison."
msgstr "제가 봤을 때, 당신에게는 두 가지 선택지가 있어요. 할신 아니면 그 와이번 독이죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 1c730778-48fc-f438-cd33-909757087e70
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:1c730778-48fc-f438-cd33-909757087e70
msgctxt "hc996ce7cg8251g4c35gb8dbg7b9aa18b7f26"
msgid "I'm trying to help you, but I need to be sure."
msgstr "저는 당신을 도와드리려고 노력 중이지만, 확실히 할 필요가 있어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 1c7b1404-6ccf-1b68-a395-9e4db3d2fe6d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - DEN_Apprentice_Knows_IdentifiedBranch = False
#.   Object:
#.      - DEN_Apprentice_Event_TookThorn(1) = False
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_Event_TookThorn(1) = True
#. TagRule: DRUID or RANGER
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:1c7b1404-6ccf-1b68-a395-9e4db3d2fe6d
msgctxt "h827e5489gd4bag4562g90cfga202d390d26f"
msgid ""
"<i>Grab and examine the branch - have you come across this plant before?</i>"
msgstr "<i>가지를 잡고 조사한다 - 이 식물을 본 적이 있나?</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 1ca6fcc6-ef98-b9e8-e29c-2bab74f2f38e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:1ca6fcc6-ef98-b9e8-e29c-2bab74f2f38e
msgctxt "hf75d7728g2ae3g4c13ga2cfga6595852a7e8"
msgid ""
"When Master Halsin heard the adventurers were heading that way, he saw a "
"chance to get answers. Joined on the spot."
msgstr "마스터 할신께선 모험가들이 그쪽으로 가고 있다는 소식을 듣고, 답을 얻을 기회로 여겨 바로 합류하셨죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 1d4777b5-5a7a-8142-f628-bd004b807c2f
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - DEN_DruidLair_State_UnderstoodTwoFrescos = False
#.   Object:
#.      - DEN_Apprentice_State_Cyanide_Intimidate1(1) = False
#.   Tag:
#.      - DRUID(1) = False
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_Cyanide_Intimidate1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:1d4777b5-5a7a-8142-f628-bd004b807c2f
msgctxt "hcd497b7cg6dcbg47d9gb95bge2cac5eac894"
msgid "<i>Recite what you know of her order - this can't be allowed!</i>"
msgstr "<i>그녀의 단체에 대해 알고 있는 것을 열거하듯 말한다 - 이런 일은 용납될 수 없다!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 1d62b97b-e866-8d54-1a36-e2247decf9bc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:1d62b97b-e866-8d54-1a36-e2247decf9bc
msgctxt "h07112b5bgefceg4850g95a2g12bbd06ff8de"
msgid "I don't know, I just woke up with it."
msgstr "모르겠어, 나는 그것을 품은 채 일어났을 뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 1f78988b-99fb-9923-2fdd-44ba7044cdda
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:1f78988b-99fb-9923-2fdd-44ba7044cdda
msgctxt "h00b30ae5g441ag4560gaf70gff0a7447c5c3"
msgid "No. I'm not taking poison from a woman I can't trust."
msgstr "아니. 나는 믿을 수 없는 여자가 준 독약을 먹지 않을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 207d7560-9e41-da16-1a8d-abac23cb9b9c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:207d7560-9e41-da16-1a8d-abac23cb9b9c
msgctxt "h49830c0dg5af6g46beg8bcega3b18d9563e5"
msgid "My legs? What kind of cure is this?"
msgstr "내 다리? 이건 무슨 종류의 치료제지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 21eeeb5b-b9ae-5db9-95b6-7e21033bdda2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:21eeeb5b-b9ae-5db9-95b6-7e21033bdda2
msgctxt "h54bf4b3dge19ag4e35gb6c2gb8bb9d455b9e"
msgid "I won't turn into one of them."
msgstr "나는 그들 중 하나로 변하지 않을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 2299895a-57bc-d542-6681-921c7261dc88
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:2299895a-57bc-d542-6681-921c7261dc88
msgctxt "h0d6ece28gca6ag46b1g99f9gfa6db560d3db"
msgid ""
"Is everyone being captured by mind flayers these days? Didn't think it was a "
"common experience."
msgstr "요즘은 누구나 마인드 플레이어에게 사로잡히나? 흔한 경험인 줄은 몰랐어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 22d45813-7032-d196-ece3-36856f859251
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:22d45813-7032-d196-ece3-36856f859251
msgctxt "h1a027494g1b5ag4533gafcdg1c8d9103c3b0"
msgid "Of course I am. Lives are on the line, and not just yours."
msgstr "당연하죠. 당신뿐만 아니라 많은 사람의 생명이 위태로우니까요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 24c7ef26-c756-08ef-ee28-c05641b5792f
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#. TagRule: BERSERKER
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:24c7ef26-c756-08ef-ee28-c05641b5792f
msgctxt "h4a4d3e53ge59dg4afcg8485gd957353f917c"
msgid ""
"<b>You won't have to worry about anyone else after I CRUSH YOUR SKULL.</b>"
msgstr "<b>내가 네 골통을 부순 다음엔 다른 사람 걱정할 필요가 없어질 거야.</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 24c7ef26-c756-08ef-ee28-c05641b5792f
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:24c7ef26-c756-08ef-ee28-c05641b5792f
msgctxt "he44c9ef3g83d0g4f5cg9659g63a56a81ceb4"
msgid "I don't need to transform to kill everyone. <b>Stand down.</b>"
msgstr "내가 모두를 죽이기 위해서 꼭 변이가 필요한 건 아니야. <b>물러서.</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 2573861b-45f5-8dfc-c708-4cc1f355b1ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:2573861b-45f5-8dfc-c708-4cc1f355b1ae
msgctxt "h209c249cge586g49f4g8cd7g9b8dbcd2219f"
msgid "On a mind flayer ship - I was kidnapped and infected."
msgstr "나는 마인드 플레이어 함선에 납치되어 감염됐어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 26fef27a-59d2-8a0a-3696-4d9dc0889900
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:26fef27a-59d2-8a0a-3696-4d9dc0889900
msgctxt "h9b36e6d5g79e3g4c22g9c7bgfc40ce3744e0"
msgid "I don't envy your choice, truly. But this is the hand fate's dealt you."
msgstr "전 당신의 선택에 불만을 갖지 않겠어요. 정말로요. 하지만 이건 운명이 당신에게 내민 손이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 2b1d6745-b693-e667-ce71-38ade8ce6393
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:2b1d6745-b693-e667-ce71-38ade8ce6393
msgctxt "h2b426819gafa6g43d3g8ea1gaa8bd180d418"
msgid "What in the hells have you done?"
msgstr "대체 내게 무슨 짓을 한 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 2c0a4a6f-1ec5-5297-8994-64627239b649
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_State_NettieAttemptedKill = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:2c0a4a6f-1ec5-5297-8994-64627239b649
msgctxt "hf732d414ge969g49b0ga3aage1c987a39d97"
msgid "To hells with it."
msgstr "망할, 집어치웁시다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 2d0f424f-6127-424b-d172-162d38514299
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:2d0f424f-6127-424b-d172-162d38514299
msgctxt "h56d8c27eg2e46g4b99g82e7g71de424314e8"
msgid "You're asking a lot of questions..."
msgstr "당신은 질문이 많군..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Astarion
#. NodeID = 2d5c1919-702d-e7ea-dead-751247789d2b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:2d5c1919-702d-e7ea-dead-751247789d2b
msgctxt "ha5b6f1e5ga1f6g4f0bg8d74g50d1623b5608"
msgid "Please, don't mind me. I'll just watch."
msgstr "부디, 저는 신경 쓰지 말아주세요. 저는 지켜보기만 할게요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 2d6a1f73-18c1-f447-d96c-613cb57f2308
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:2d6a1f73-18c1-f447-d96c-613cb57f2308
msgctxt "h75002423gd6ccg40aeg94d7g801675386e98"
msgid ""
"<i>Try to recall the tenets of her order - no druid could support this!</i>"
msgstr "<i>네티가 속한 단체의 교리를 떠올리려 애쓴다 - 드루이드는 이런 일을 지지할 리 없다!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 2d9ee2e3-8b73-7ac5-d988-2150b0071a23
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 10
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_Cyanide_Intimidate1(1) = True
#.   Tag:
#.      - SORCERER(1) = False
#.      - WARLOCK(1) = False
#.      - WIZARD(1) = False
#.      - REALLY_GALE(1) = False
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_Cyanide_Intimidate2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:2d9ee2e3-8b73-7ac5-d988-2150b0071a23
msgctxt "h97639982gb8cag4059gaca5ga61d56744f36"
msgid "Magic can cure me if you can't. I know the Weave well!"
msgstr "당신이 할 수 없다면, 마법이 날 치유할 수 있을 거야. 난 위브를 아주 잘 알거든!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 309386cb-9c8b-54aa-f151-739691b56c0d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:309386cb-9c8b-54aa-f151-739691b56c0d
msgctxt "h990b1492g34d9g40ffg89d1ga45c4c140058"
msgid "So you think it's only a matter of time?"
msgstr "그렇다면 단지 시간 문제라고 생각하는 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 30b59d3f-370d-55df-d26a-1ca0bd83c34a
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 10
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_Cyanide_Intimidate1(1) = True
#.      - DEN_Apprentice_State_Cyanide_Intimidate2(1) = False
#. TagRule: REALLY_GALE or SORCERER or WARLOCK or WIZARD
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:30b59d3f-370d-55df-d26a-1ca0bd83c34a
msgctxt "h85abfdb9g9907g4079g9a0dge92755cc04d7"
msgid "Magic can cure me if you can't. I know the Weave well!"
msgstr "당신이 할 수 없다면, 마법이 날 치유할 수 있을 거야. 난 위브를 아주 잘 알거든!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 319384e4-651c-9781-6057-5fa6b9c2d444
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:319384e4-651c-9781-6057-5fa6b9c2d444
msgctxt "hc2860ebbg41fag426dg9808ge718e1d5be0a"
msgid "This was a mistake. I should go."
msgstr "이 일은 실수였어. 나는 가야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 31f86b8b-8bb0-91d5-b211-751368870350
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Event_NettieTurnsHostile = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:31f86b8b-8bb0-91d5-b211-751368870350
msgctxt "h3afc8aedgd50fg4f53g828bg3a9efa9ef4f8"
msgid "I'm sorry. I'm so sorry."
msgstr "미안해요. 정말 미안해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 3208725a-0194-8983-1555-551bdf636cf1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:3208725a-0194-8983-1555-551bdf636cf1
msgctxt "hc25bcd00g847eg4887g8f54g5d650c54eeaf"
msgid "Then I'm sorry, but I can't. You're too dangerous."
msgstr "그럼 죄송하지만, 할 수 없어요. 당신은 너무 위험해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 322f74c2-c217-2f63-e415-6aa45e472faf
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:322f74c2-c217-2f63-e415-6aa45e472faf
msgctxt "h8ad8ae19gd20cg44e4gbaadg36927f9027a2"
msgid "<b>Try me.</b>"
msgstr "<b>해 보시죠.</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 3260decf-6e3d-63fa-82fa-efe6cab85d8b
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:3260decf-6e3d-63fa-82fa-efe6cab85d8b
msgctxt "h590d589eg31ffg4bf6ga997gd7a46119206e"
msgid "Don't be a fool. I'd kill you before you could blink."
msgstr "멍청한 짓 하지 마. 네가 눈도 깜빡이기 전에 너를 죽일 수 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Narrator
#. NodeID = 33e6f81b-87af-f432-ea5f-23e1d56fbbb6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Knows_IdentifiedBranch = True
#. TagRule: DRUID
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:33e6f81b-87af-f432-ea5f-23e1d56fbbb6
msgctxt "h7e1764c6gd384g4326g8d1fg2481fc86d118"
msgid ""
"*Looking closer, you recognise the branch, and it's no druidic cure. She's "
"holding Kelemvor's Kiss, a briar from the Dalelands and a deadly poison.*"
msgstr ""
"*당신은 가지를 더 자세히 보고, 드루이드의 치료제가 아니라는 사실을 깨닫습니다. 그녀는 켈렘보르의 입맞춤을 들고 있습니다. 데일랜드에서 "
"자라는 찔레나무로, 치명적인 독을 품고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Narrator
#. NodeID = 33e6f81b-87af-f432-ea5f-23e1d56fbbb6
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Knows_IdentifiedBranch = True
#. TagRule: RANGER
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:33e6f81b-87af-f432-ea5f-23e1d56fbbb6
msgctxt "hdd84b6c6g297ag48adgb2b7g3da8c9d29c2a"
msgid ""
"*Looking closer, you realise you've seen this thorn in the wilds - it's "
"Kelemvor's Kiss, a briar from the Dalelands. And a deadly poison.*"
msgstr ""
"*당신은 가지를 더 자세히 보고, 야생에서 본 듯한 가시를 발견합니다. 바로 데일랜드에서 자라는 찔레나무인 켈렘보르의 입맞춤입니다. "
"그리고 치명적인 독이기도 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 3421d85c-487b-ea49-976f-14648c1e129f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_IsFound = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:3421d85c-487b-ea49-976f-14648c1e129f
msgctxt "h1d7ec6fagddb7g4ca9g9b65gb7a46efe7d7c"
msgid "All right, I'll find Halsin."
msgstr "좋아, 내가 할신을 찾지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 34de22c4-eebb-c488-6d70-0d6ad5667fda
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:34de22c4-eebb-c488-6d70-0d6ad5667fda
msgctxt "h20dca0c2g8e48g4602ga0aegfc99b6d13e43"
msgid "I'm hoping for a less grave cure."
msgstr "저것보단 덜 아픈 치료법이 있으면 좋겠는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 368e3a21-c512-3333-c2d7-fbc2b52fb53f
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_IsFound = False
#.   Object:
#.      - DEN_Apprentice_State_Cyanide_Deceive1(1) = True
#.      - DEN_Apprentice_State_Cyanide_Deceive2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:368e3a21-c512-3333-c2d7-fbc2b52fb53f
msgctxt "h32c5a108g8534g4268g9e6eg8e65ac82f5e2"
msgid "I'm the only one that can find Halsin."
msgstr "나는 할신을 찾을 수 있는 유일한 인물이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 36dafd8d-9f33-2c4e-61da-4f4346d23577
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - DEN_DruidLair_State_UnderstoodTwoFrescos = False
#.   Object:
#.      - DEN_Apprentice_State_Cyanide_Intimidate1(1) = False
#.      - DEN_Apprentice_State_Cyanide_Intimidate2(1) = False
#.   Tag:
#.      - DRUID(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:36dafd8d-9f33-2c4e-61da-4f4346d23577
msgctxt "h62fb1e9dg4261g473dgb4efgb8dcf121165e"
msgid "<i>Recite what you know of her order - this can't be allowed!</i>"
msgstr "<i>그녀의 단체에 대해 알고 있는 것을 열거하듯 말한다 - 이런 일은 용납될 수 없다!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 36dee272-d57d-6504-877f-def6dab448e5
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = False
#.      - FIGHTER(1) = False
#.      - MONK(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:36dee272-d57d-6504-877f-def6dab448e5
msgctxt "h1f28a5b8g6a15g4900g9ca0g42094e6cd9c3"
msgid "You can't hit me, let alone kill me. Don't make me put you down."
msgstr "너는 날 죽이기는커녕 때릴 수도 없어. 내가 널 때려눕히게 하지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Narrator
#. NodeID = 3785e625-4c3b-2d86-44b7-9ed7c7e6f534
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_Event_ApplyPoison(1) = True
#.   Quest:
#.     - GLO_Tadpole_SUB_Apprentice.PoisonedByApprentice(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:3785e625-4c3b-2d86-44b7-9ed7c7e6f534
msgctxt "hd8faf109g245bg43dcg8856g8c0bfe83423b"
msgid ""
"*She doesn't hesitate, moving quickly. Before you realise what's happening, "
"you feel a burning scratch on your hand.*"
msgstr "*그녀는 망설이지 않고, 빠르게 움직입니다. 당신은 무슨 일이 일어났는지 눈치 채기도 전에, 손에 타는 듯한 상처를 느낍니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 37c8041b-4807-e776-f342-8a4f5d33b732
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TUT_State_WasDeadAtTheEndOfTUT(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:37c8041b-4807-e776-f342-8a4f5d33b732
msgctxt "h6da6eb38g5734g4693gae77ga774b16275e3"
msgid ""
"I fell from a ship in the sky, but something caught me. It saved my life."
msgstr "나는 하늘에 떠 있는 배에서 떨어졌지만, 무언가가 나를 붙잡았어. 그게 내 목숨을 구해줬어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 38e9f340-6363-6ef8-d7f0-16a44298161e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_HasWyvernPoison(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:38e9f340-6363-6ef8-d7f0-16a44298161e
msgctxt "h5f9eeb93g324ag4c52g9a61gcdf4109ec3ff"
msgid ""
"Now, this is a vial of wyvern poison. It's quick and painless. Swear to me "
"you'll swallow it if you feel <i>any </i>symptoms."
msgstr "자, 와이번 독이 담긴 병이에요. 빠르고 고통 없이 끝날 거예요. <i>어떤</i> 증상이라도 느껴지면 삼키겠다고 맹세하세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 3992b2bd-3277-c6dd-828b-d2be7e1c30ea
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_Event_GiveWyvenPoison(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:3992b2bd-3277-c6dd-828b-d2be7e1c30ea
msgctxt "h6cb339e3gfff7g47e4g938bg452fab26dd29"
msgid ""
"Good luck out there. And if things start to go bad - remember the oath you "
"swore."
msgstr "행운을 빌어요. 그리고 상황이 나빠지면, 당신이 약속한 것을 기억하세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 39a69a53-edf3-c107-6ffd-16db985cec69
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:39a69a53-edf3-c107-6ffd-16db985cec69
msgctxt "hdc825951g4590g462cg818bgc73ad6b8660b"
msgid "<i>Swear it.</i>"
msgstr "<i>맹세하세요.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 3aaa13dc-45b7-358d-0568-3546bc952c87
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_IsFound = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:3aaa13dc-45b7-358d-0568-3546bc952c87
msgctxt "h064c61d5g5cb1g42cag893ag9bd5a22c3aa1"
msgid "I know where Halsin is! I can save him, but only if you let me go."
msgstr "나는 할신이 어디 있는지 알아! 네가 나를 보내줘야만 내가 그를 구할 수 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 3acaa341-60c4-5f87-907a-f8a66e284ece
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:3acaa341-60c4-5f87-907a-f8a66e284ece
msgctxt "h0985f5cag3e43g495eg8a11gf244971afb85"
msgid "It's too late. It's already in your system."
msgstr "너무 늦었어요. 이미 당신의 몸속을 돌고 있을 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 3c069d76-1307-24b2-3dd0-db3525c0b1f8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_Apprentice_State_TookPoison(1) = True
#.   Global:
#.     - DEN_Apprentice_Quest_TookPoison = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:3c069d76-1307-24b2-3dd0-db3525c0b1f8
msgctxt "h5ec396d1ga165g488dgb24cgf1be22b57239"
msgid "Thank you. I truly hope it doesn't come to that."
msgstr "고마워요. 진심으로 그런 일이 오지 않기를 바라요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 3dc6172b-e069-ef6f-47c9-55808cbc4091
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:3dc6172b-e069-ef6f-47c9-55808cbc4091
msgctxt "h055d13e3gd9a3g45daga68cgc08d98023ed3"
msgid "<i>Fine</i> is not enough. Look at me."
msgstr "<i>좋아</i>, 정도로는 부족해요. 절 보세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 3e805edd-bd68-5b09-6b10-acbd0755e360
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:3e805edd-bd68-5b09-6b10-acbd0755e360
msgctxt "h3a6c9991g97adg4e08g9b32gb46e90590498"
msgid "I can't make any promises. This is like nothing we've seen before."
msgstr "저는 아무것도 장담할 수 없어요. 이건 우리가 본 적이 없는 것이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 3fb319d6-0d5f-ad78-fe9c-93d42b4cec9f
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 10
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_Cyanide_Persuade2(1) = False
#.      - DEN_Apprentice_State_Cyanide_Persuade1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:3fb319d6-0d5f-ad78-fe9c-93d42b4cec9f
msgctxt "he802df75gbf0eg4f92gb2c6gfecee604b468"
msgid "You said I have time - let me use it."
msgstr "나에게 시간이 있다고 했지 - 이를 활용하게 해줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 40cf4121-ae82-e10c-d354-929477b08009
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:40cf4121-ae82-e10c-d354-929477b08009
msgctxt "hbc32fbf0g61b9g4c8cg89f6gb7b46ccb5887"
msgid "So? Go and get him."
msgstr "그래서? 가서 그를 찾아오면 되잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 40eb0f7b-8e04-cb95-cdd0-75b39efe9b46
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:40eb0f7b-8e04-cb95-cdd0-75b39efe9b46
msgctxt "h1404970dg68b1g478fg9fc8g073ae4d3f983"
msgid "Put the briar down and we'll talk."
msgstr "그 가시나무부터 집어넣고 나서 대화하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 422e327b-85d9-3267-40b4-6f6dd9cd0559
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 10
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_Cyanide_Persuade1(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:422e327b-85d9-3267-40b4-6f6dd9cd0559
msgctxt "hc4a48ca5g545fg4dcegae07g7a8dbc0e4c05"
msgid "I'm safe - I'm not showing symptoms, and it's been days."
msgstr "나는 안전해 - 며칠째 증상을 보이지 않고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 4326f5f0-7093-7207-642d-3035bf9189e1
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_Cyanide_Deceive1(1) = False
#.      - DEN_Apprentice_State_Cyanide_Deceive2(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:4326f5f0-7093-7207-642d-3035bf9189e1
msgctxt "h2b4f67e4g547ag48a2gbaf2g476ea3f40e91"
msgid "You can't do this - your leader needs to talk to me."
msgstr "이러면 안 돼. 너의 지도자가 나와 이야기해야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 455d41c7-83ba-b260-156f-b574d9ccba20
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Apprentice_Knows_IdentifiedBranch = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:455d41c7-83ba-b260-156f-b574d9ccba20
msgctxt "hb8bbf901g29b0g4315gb819g8bdab774531f"
msgid "Wait - you <i>poisoned</i> me?!"
msgstr "잠깐 - 나를 <i>중독시킨</i> 거야?!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 4b165952-a41f-2a88-7391-821a832715a0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:4b165952-a41f-2a88-7391-821a832715a0
msgctxt "he12b5962g06a0g4386ga196g90114e6201d0"
msgid "I'm telling you everything you need to know. Believe me on that."
msgstr "저는 당신이 알아야 할 모든 것을 말하고 있어요. 그건 믿어주세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 4ba673fe-019a-6705-a949-f7fa9dc97986
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - GLO_Tadpole_SUB_Druid.LearnedResearchHalsin(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:4ba673fe-019a-6705-a949-f7fa9dc97986
msgctxt "hdf1852a6gf435g4ed1gaa95g44f78eaf72f0"
msgid ""
"I'm sorry. Maybe Master Halsin could have plucked it from your head, but I "
"can't."
msgstr "미안해요. 마스터 할신이라면 그것을 당신 머리에서 뽑아낼 수 있었겠지만, 저는 못하겠어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 4cfe607d-44e6-aa44-d1cc-e12482ee3984
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:4cfe607d-44e6-aa44-d1cc-e12482ee3984
msgctxt "hd268de08g03f6g4099g9fdegbd896f795d35"
msgid "I'll do the best I can."
msgstr "최선을 다 해보죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Karlach
#. NodeID = 4d2244c4-dfa0-7fb4-88f7-fcf379986705
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_KARLACH(6) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:4d2244c4-dfa0-7fb4-88f7-fcf379986705
msgctxt "hcd618812gfb65g4607g8397gfd7249b7e30c"
msgid "I'd like to keep an eye on things, thanks."
msgstr "난 항상 지켜보는 걸 좋아해서, 사양할게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 4f5eee9a-ea91-015c-7b7e-fc42d0806fbc
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_Cyanide_Deceive1(1) = True
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_Cyanide_Deceive2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:4f5eee9a-ea91-015c-7b7e-fc42d0806fbc
msgctxt "hef52266fg73fcg4d53g893age95412102530"
msgid "I have important information - your grove will die without it."
msgstr "나는 중요한 정보를 갖고 있어 - 이것 없이는 너의 숲이 죽고 말 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 51e2734f-3bad-d3ae-a943-7abdfc2f2887
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_Cyanide_FailedToPersuadeNettie(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:51e2734f-3bad-d3ae-a943-7abdfc2f2887
msgctxt "h7c2d7a26g4086g41b4gaff9g8e6fa3335358"
msgid "I'm sorry. There's nothing you can say to change my mind."
msgstr "죄송해요. 당신이 무슨 말씀을 하셔도 제 마음은 바뀌지 않을 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 5265dbf9-53c2-aadc-38a3-2086cb133e00
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:5265dbf9-53c2-aadc-38a3-2086cb133e00
msgctxt "h440eab4cg5549g4277g82d3g73f9bfc2050b"
msgid "You're sure he can cure me?"
msgstr "그가 나를 치료할 수 있다는 건 확실해?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 55fe498d-26d6-b813-f243-9b0a72cd2827
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:55fe498d-26d6-b813-f243-9b0a72cd2827
msgctxt "h93266af0g430dg4896g90fcg6ee800c1cc4a"
msgid ""
"The thorn? Coated in a fatal toxin. It was a last resort, in case I couldn't "
"trust you."
msgstr "이 가시요? 치명적인 독으로 덮여 있어요. 당신을 믿을 수 없을 때를 대비한 최후의 수단이었어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 55ff8a3e-8e7a-69a2-1f42-c51d546240f7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:55ff8a3e-8e7a-69a2-1f42-c51d546240f7
msgctxt "he34222fcg40e1g41b2gafcbgaeaf08530705"
msgid ""
"First things first. Tell me, have you noticed anything unusual? Not just "
"symptoms - any strange events?"
msgstr "우선 저에게 말씀해 주세요. 이상한 점을 발견하셨나요? 증상뿐만 아니라 이상한 사건도 있었나요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 564db8c0-de6c-a220-3d9d-5732e51713c3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:564db8c0-de6c-a220-3d9d-5732e51713c3
msgctxt "ha28ac4fag06d0g4a23g8a96g7b144b4fdc8b"
msgid "Whatever he found there, he didn't make it back."
msgstr "그가 그곳에서 발견한 것이 무엇이든, 그는 돌아오지 못했어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 5684dcd4-3fb4-0708-f96f-0458ae13c15d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:5684dcd4-3fb4-0708-f96f-0458ae13c15d
msgctxt "h285fea9ag9585g4dc6g80cagb5dd896666a0"
msgid ""
"It might be suicide either way. Trust me, you do not want to become one of "
"those monsters."
msgstr "어느 쪽이든 자살 행위가 될 거예요. 절 믿어주세요. 당신도 그 괴물들 중 하나가 되고 싶지는 않잖아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 5d7596ee-2113-de7c-26a5-3085c2bf59ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:5d7596ee-2113-de7c-26a5-3085c2bf59ad
msgctxt "hcb7c6ea2g0ed6g4b37gb5f1g2776be482ccf"
msgid ""
"You, though? You're one of them - technically speaking, I mean. They won't "
"kill someone carrying their parasite."
msgstr "하지만 당신은요? 당신은 그들 중 하나예요. 제 말은, 엄밀히 말하면요. 그들은 기생충이 들어있는 사람을 죽이지는 않아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 5e44b573-9298-0890-8799-8367944411b3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Knows_AntidoteLocation = True
#.   Object:
#.     - DEN_Apprentice_State_Cyanide_AntidotePickpocketed(1) = True
#.     - ORI_Gale_State_NettieGaveAntidote(1) = True
#.     - DEN_Apprentice_Event_Gale_GotAntidoteApproval(1) = True
#.     - DEN_Apprentice_Event_GiveAntidote(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:5e44b573-9298-0890-8799-8367944411b3
msgctxt "h33a12129g393eg4e5ag8b07g09dd8e75522a"
msgid ""
"Well, not to worry. Have a read of that book - <i>Flora of the Dalelands</"
"i>. There's a recipe for your antidote in there."
msgstr "음, 걱정 마세요. 방법이 있으니까요. <i>데일랜드의 식생</i>이라는 책을 찾아보세요. 거기 해독제 제조법이 있을 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 5e968828-031a-1fff-1870-153f1a1d9e39
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TUT_State_WasDeadAtTheEndOfTUT(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:5e968828-031a-1fff-1870-153f1a1d9e39
msgctxt "h35b8b249g1bb3g4be4g941cg42dcfb9eca44"
msgid "I did fall from a ship in the sky, but something caught me."
msgstr "나는 하늘에 떠 있는 함선에서 떨어졌지만, 무언가가 날 붙잡았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 60192c59-f4fd-8265-2d0c-8f20cce2f522
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - MONK(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:60192c59-f4fd-8265-2d0c-8f20cce2f522
msgctxt "hf77630fag47ddg4161g9209ga19397711736"
msgid ""
"Fine - but better hope it works. Poison doesn't always hurt the pure of body."
msgstr "좋아. 그렇지만 그게 잘 듣길 바라지. 독이 언제나 몸을 해치는 건 아니거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Narrator
#. NodeID = 6077d97e-74e8-1e8d-b9f8-727a49ebc785
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:6077d97e-74e8-1e8d-b9f8-727a49ebc785
msgctxt "he400747cg0f8cg4f9dg8350g76505c794704"
msgid ""
"*You dodge her blow, but as you regain your footing, you can see the pain in "
"her eyes.*"
msgstr "*당신은 그녀의 공격을 피했지만, 바로 섰을 때 그녀의 눈에서 고통을 볼 수 있었습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 62197c37-e6b7-977f-c02d-2596d0fbfba8
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 10
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_Cyanide_Persuade1(1) = True
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_Cyanide_Persuade2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:62197c37-e6b7-977f-c02d-2596d0fbfba8
msgctxt "h7634dbebga21cg40a2g8705g01d994fab6f9"
msgid "Eventually? That gives me time to find a cure."
msgstr "결국엔 변했다고? 그럼 그 전에 치료법을 찾을 시간이 있긴 하다는 거군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 62ad4be1-3c3f-efac-44de-ba8cd2a568a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:62ad4be1-3c3f-efac-44de-ba8cd2a568a3
msgctxt "hb1d542e6ge2c7g4096gac18gdd64864abad3"
msgid "Please, try to relax. This doesn't have to be hard."
msgstr "제발, 진정해 주세요. 어려운 길로 갈 필요는 없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 64717595-f002-8dc9-5f2d-73a3b87df327
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:64717595-f002-8dc9-5f2d-73a3b87df327
msgctxt "h941c4654g32d4g485fg8747gdab992d3eee4"
msgid "That sounds like suicide. I won't do it."
msgstr "그건 자살 행위 같군. 사양하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 6558bfcc-275b-9493-0a5f-b628c324e9db
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_Cyanide_AskedBranch(1) = False
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_Cyanide_AskedBranch(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:6558bfcc-275b-9493-0a5f-b628c324e9db
msgctxt "h62930d3bgc830g43bdg9fe1g0c3f4681faaa"
msgid "What is that?"
msgstr "그건 뭐지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 66748274-6666-4c89-ff8f-f8e856c8a164
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:66748274-6666-4c89-ff8f-f8e856c8a164
msgctxt "he5ba2075gf548g4eabg9773g6c0c4b3a7213"
msgid "It sounds like you're making a lot of assumptions that could kill me."
msgstr "증거도 없는 네 가정에 내 목숨을 걸라는 말로 들려."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 6778b6e5-b1cd-e412-bbc4-a01dbcce5711
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:6778b6e5-b1cd-e412-bbc4-a01dbcce5711
msgctxt "hdef90e0eg7a05g47e5gaceag69e540872f6d"
msgid ""
"I think so. I hope so. I've sent birds to find him, but they can't get close "
"without goblins trying to shoot them down."
msgstr ""
"그렇게 생각해요. 그러길 바라고요. 제가 새들을 보내 그를 찾으려 해봤지만, 고블린들이 사격해 떨어뜨리려고 해서 가까이 갈 수 없었어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 67ff26ef-1dc0-7e0b-a7e0-f33f2e5d4754
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:67ff26ef-1dc0-7e0b-a7e0-f33f2e5d4754
msgctxt "hf61a18b1g85dfg4481ga726gfd47aba53018"
msgid ""
"I wish I could tell you more, but only those adventurers know what happened "
"out there."
msgstr "더 많은 것을 알려드리고 싶지만, 그 '모험가들'만이 그곳에서 무슨 일이 있었는지 알 수 있어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Lae'zel
#. NodeID = 68ab3823-f82a-68cf-0a51-a6786522e5b6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_LAEZEL(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:68ab3823-f82a-68cf-0a51-a6786522e5b6
msgctxt "hf60b3502ga99cg4815gbf73g14436fe87189"
msgid "I will remain. I've a vested interest in the outcome."
msgstr "남아있겠다. 이 결과는 내게도 중요하니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Narrator
#. NodeID = 68c5d27f-f3d6-bd2f-ae19-f82541b91860
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:68c5d27f-f3d6-bd2f-ae19-f82541b91860
msgctxt "hac5e99a9g6b06g4106g9a89g2b4b51f23e24"
msgid "*She shifts uneasily, hesitating. Something's off.*"
msgstr "*그녀는 불안한 표정을 지으며 머뭇거립니다. 뭔가 이상합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 6921c663-6916-76e4-e467-3ef3f3024595
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:6921c663-6916-76e4-e467-3ef3f3024595
msgctxt "h2e403db6g8402g4270gaa35ga1ade8654f13"
msgid ""
"Swear to me that if you feel <i>any </i>symptoms, you'll end things yourself."
msgstr "만약 당신이 <i>어떤</i> 증상이라도 느낀다면, 스스로 생을 끝내겠다고 저에게 맹세해 주세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 6a1475df-96d6-b608-1989-2b5cf950aefa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - GLO_TUT_Knows_TalkedToIntellectDevourer(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:6a1475df-96d6-b608-1989-2b5cf950aefa
msgctxt "h5f3d44a9g7424g4ef9gafe4g283592b88390"
msgid "An intellect devourer spoke to me as if I were one of its own."
msgstr "한 지성 포식자가 내가 같은 편인 것마냥 내게 말을 걸었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 6a465c43-eac6-5e0f-f9d3-be93f0ce1463
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_HasWyvernPoison(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:6a465c43-eac6-5e0f-f9d3-be93f0ce1463
msgctxt "hf1121ca6g4a9cg4070gab31g5e9b3315c90d"
msgid ""
"This is a vial of wyvern poison. Swear to me you'll swallow it if you feel "
"<i>any</i> symptoms."
msgstr "이건 와이번 독이 담긴 병이에요. <i>어떤</i> 증상이라도 느껴지면 삼키겠다고 맹세하세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 6cdbc789-57bb-846c-f475-60658f23e403
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:6cdbc789-57bb-846c-f475-60658f23e403
msgctxt "h95308383gbd46g40b8g9e41g4ac9a3ecba3e"
msgid "I won't turn into one of them."
msgstr "난 그들 중 하나가 되지 않을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 6cebaaa8-0406-2c57-b6c5-1b93db213832
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:6cebaaa8-0406-2c57-b6c5-1b93db213832
msgctxt "h729ba091ge906g4fb1gb80bg06e940de674d"
msgid "Excellent news! All the power, none of the tentacles."
msgstr "훌륭한 소식이군! 그런 힘에, 촉수도 없다니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 6d6cf24c-3216-ca52-4060-b00679378458
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Knows_WentWithAdventurers = True
#.   Quest:
#.     - GLO_Tadpole_SUB_Druid.LearnedLostHalsin(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:6d6cf24c-3216-ca52-4060-b00679378458
msgctxt "h06be6dc8gda6eg48ccg885egbb7e750e77d4"
msgid ""
"Rather too common as of late. At least that's what Master Halsin suspected."
msgstr "요즘은 너무 흔한 일이죠. 적어도 마스터 할신께선 그렇게 생각하셨어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 6e66be36-d45f-0505-9832-b8a99abd6b4a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_HasWyvernPoison(0) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Apprentice_State_TookPoison(1) = True
#.   Global:
#.     - DEN_Apprentice_Quest_TookPoison = True
#.   Object:
#.     - DEN_Apprentice_Event_GiveWyvenPoison(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:6e66be36-d45f-0505-9832-b8a99abd6b4a
msgctxt "h4c8e66ffg5b0eg44b1g95a0gd9c7b2d3c91f"
msgid "I hope it doesn't come to that but... thank you. Here."
msgstr "그런 일이 오지 않기를 바라지만... 고마워요. 여기 있어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 6ec9b02d-c888-e0f1-bace-b84b723c220f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:6ec9b02d-c888-e0f1-bace-b84b723c220f
msgctxt "hea55d866g4163g4220g810cg283fb0cab1c7"
msgid "No one else can stop those goblins. You need me."
msgstr "다른 누구도 그 고블린들을 막을 수 없어. 너는 내가 필요할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 6f57425e-d309-4ad3-343e-24f7e39697e9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:6f57425e-d309-4ad3-343e-24f7e39697e9
msgctxt "h77730f41gc894g4af8g8f36gf4313ea6056d"
msgid "You came to me for help. Do you want it or not?"
msgstr "당신은 도움을 받으러 찾아왔잖아요. 도움을 원해요, 원하지 않아요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 71558c1b-0565-f6fc-10a7-eaabd5223aab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:71558c1b-0565-f6fc-10a7-eaabd5223aab
msgctxt "h9f84147ege525g45dcga0bdgd60f2d6d316b"
msgid "This is the last time I'll ask. <i>Please.</i>"
msgstr "이번이 제 마지막 요청이에요. <i>부탁할게요.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 72b8a2cf-5b4a-4b73-4cbe-b7ee86b114bd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Event_CloseDoor = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:72b8a2cf-5b4a-4b73-4cbe-b7ee86b114bd
msgctxt "h6e9053dcgb4d8g4b9cg8e4ag8a7cc244169a"
msgid "There. It's done."
msgstr "자. 이제 됐습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 73e11271-d947-1153-4e33-ed9cda21bbf2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_Event_TookThorn(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:73e11271-d947-1153-4e33-ed9cda21bbf2
msgctxt "hd6243f0cg2759g419agaf97g01d1752f5fdf"
msgid "<i>Grab the branch from her.</i>"
msgstr "<i>그녀에게서 가지를 낚아챈다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 759d3c80-0ab3-aa4b-96c8-9490177398f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:759d3c80-0ab3-aa4b-96c8-9490177398f5
msgctxt "h828db68ag93d2g43e8g9c49g722630999545"
msgid ""
"By rights your teeth should be falling out and your skin turning grey. I "
"don't know why you haven't changed, but I can't risk you suddenly turning "
"into a mind flayer."
msgstr ""
"원래는 당신 이빨이 빠지고 피부가 회색으로 변했어야 했어요. 왜 안 변했는지는 모르겠지만, 저는 당신이 갑자기 마인드 플레이어로 변할 "
"위험을 감수할 수 없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 76550b32-06ab-9e73-2a61-3639e0da92dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:76550b32-06ab-9e73-2a61-3639e0da92dc
msgctxt "h518b601fgf575g4777ga05cg4f07a6804f68"
msgid "Now, your arm, please. You don't have time for games."
msgstr "자, 얼른 주세요. 장난칠 시간 없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 76f0e408-7200-2e67-e976-329c8a078525
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:76f0e408-7200-2e67-e976-329c8a078525
msgctxt "h5ad71e28g851cg4d84gb0bfg407e0c677045"
msgid ""
"Victims can identify each other? Not that the others know they're victims, "
"of course."
msgstr "피해자들이 서로를 식별할 수 있나요? 물론 다른 사람들은 그들이 피해자라는 것을 모르겠지만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 78e3ae62-14b6-7bdc-25d8-61fcc9ab1bb3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:78e3ae62-14b6-7bdc-25d8-61fcc9ab1bb3
msgctxt "h62d4560bg5933g4487g832agf2a26ae9f4d5"
msgid "It won't cure what's in your head, though."
msgstr "아마 머리 속에 그건 치료해주지 못할 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 7a17b52a-c58d-de75-34da-5042affd93a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:7a17b52a-c58d-de75-34da-5042affd93a3
msgctxt "hfde30e8ag4c4ag448dg8777g9b641f5a409b"
msgid "<i>Pull back.</i>"
msgstr "<i>뒤로 뺀다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 7a1f26a2-abfb-8f16-36f5-fe5099568af1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Apprentice_Knows_IdentifiedBranch = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:7a1f26a2-abfb-8f16-36f5-fe5099568af1
msgctxt "h8c78d247g94cbg4fbcgb13bg3d742398eb45"
msgid "Cure me first, then I'll answer all the questions you want."
msgstr "먼저 나를 치료해 줘. 그럼 네가 원하는 모든 질문에 답할게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 7a3ce1e3-a962-97b8-11c9-58171cfb1e06
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:7a3ce1e3-a962-97b8-11c9-58171cfb1e06
msgctxt "hc2b941acg39cfg46ddg9a31g1643e213a586"
msgid ""
"It might, but first things first. Tell me about your symptoms - have you "
"noticed anything strange happening?"
msgstr ""
"아마 될 거예요. 하지만 더 중요한 것이 있어요. 당신의 증상에 대해 말해 주세요 - 뭔가 이상한 일이 일어난 것을 눈치채셨나요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 7a91f6d9-511a-4dd1-ad0f-a1589832e293
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:7a91f6d9-511a-4dd1-ad0f-a1589832e293
msgctxt "h23fa0e9dg2165g4e82g8b5fgc9f43f6da019"
msgid "A mind flayer ship? But Master Halsin was sure -"
msgstr "마인드 플레이어 함선이라고요? 하지만 마스터 할신께서는 분명히-"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 7b4d16de-5f0d-9127-86da-cd2d628697e5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:7b4d16de-5f0d-9127-86da-cd2d628697e5
msgctxt "h95b43824gdde4g4335g9b21gf33bb7a0b4f8"
msgid ""
"Could be, but there's a lot we don't know. Infected - folks like you - have "
"been converging on an old temple of Selûne, and I've no idea why."
msgstr ""
"그럴 수도 있지만, 우리가 모르는 게 많아요. 당신과 같은 감염자들이 오래된 셀루네의 신전에 모여들고 있는데, 그 이유를 모르겠어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 7bd63b97-623b-4648-f52f-5a6d57d1cc33
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:7bd63b97-623b-4648-f52f-5a6d57d1cc33
msgctxt "h5f456426g2921g4b88g81b3g26483de524e7"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 7d6bc8a2-ccd3-0e65-2500-7a320b77c692
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Event_CloseDoor = True
#.   Object:
#.     - DEN_Apprentice_Event_ApplyPoison(1) = True
#.   Quest:
#.     - GLO_Tadpole_SUB_Apprentice.PoisonedByApprentice(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:7d6bc8a2-ccd3-0e65-2500-7a320b77c692
msgctxt "h637ce4e7g07d8g42b6ga991ged27a564d1cd"
msgid "There."
msgstr "자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 7dfe673a-f839-d072-e81a-028503e0d9e9
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:7dfe673a-f839-d072-e81a-028503e0d9e9
msgctxt "h49aa6076gd13fg43fegae4bgcf302b6e836e"
msgid "The drow didn't transform - I won't either."
msgstr "저 드로우는 변이하지 않았잖아. 나도 마찬가지야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 7e7ff162-54b3-0a52-7c67-885e01f5f3a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:7e7ff162-54b3-0a52-7c67-885e01f5f3a4
msgctxt "h1803e6d2ga714g45a3ga816gfafadceab9c8"
msgid "Swear that if you feel <i>any</i> symptoms, you'll end things yourself."
msgstr "만일 증상이 <i>하나라도</i> 나타난다면, 스스로 해결할 거라 맹세해 주세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 7ee3c90d-e8c6-4a76-eb17-e993a5a73b3d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_Cyanide_AskedBranch(1) = False
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_Cyanide_AskedBranch(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:7ee3c90d-e8c6-4a76-eb17-e993a5a73b3d
msgctxt "hd3957e85g21b9g4980g91f7ga7a7077aa0ab"
msgid "What's that plant? Will it help?"
msgstr "그 식물은 뭐야? 그게 도움이 될까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 7fcd4e0b-a2cd-e0b9-3cbf-46d9b7db4a62
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Event_CloseDoor = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:7fcd4e0b-a2cd-e0b9-3cbf-46d9b7db4a62
msgctxt "h730eab58g5115g48b2g88c5g38d4ef551b97"
msgid ""
"...Look, you've been straight with me, so I'll be straight with you. You're "
"dangerous. If you transform here, we're all dead."
msgstr ""
"...들어보세요. 제게 솔직해주셨으니, 저도 당신에게 솔직하게 말할게요. 당신은 위험한 존재예요. 만약 당신이 여기서 변이하면, 우리는 "
"모두 죽고 말겠죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 8081ba3c-e42f-bff2-7f62-39dbb99f963a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_HasAntidote(0) = True
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Knows_AntidoteLocation = True
#.   Object:
#.     - ORI_Gale_State_NettieGaveAntidote(1) = True
#.     - DEN_Apprentice_Event_Gale_GotAntidoteApproval(1) = True
#.     - DEN_Apprentice_Event_GiveAntidote(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:8081ba3c-e42f-bff2-7f62-39dbb99f963a
msgctxt "h147cd2cdg626eg48aeg9cb2g6626d4f00fa7"
msgid ""
"Here, take this. It'll stop the poison, but I can't do anything for that "
"wriggler in your head."
msgstr "자, 이거 받으세요. 그 독은 멈추겠지만, 당신 머리속 벌레는 제가 어떻게 할 수 없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 80c12287-6c66-2ee9-972d-7d3ce678e3bc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_Cyanide_WarnedOfOptions(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:80c12287-6c66-2ee9-972d-7d3ce678e3bc
msgctxt "hf067c57ag78c6g47dcgbf31g20070bc8eb1b"
msgid ""
"But I know this for sure: Master Halsin is the only one close to "
"understanding these things. He's your best bet to survive."
msgstr ""
"하지만 한 가지는 확신해요. 마스터 할신만이 모든 것을 이해할 수 있는 유일한 분이라는 것입니다. 그가 당신이 살아남을 수 있는 최선의 "
"방법이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 82bd76f8-c65a-36fe-30e2-453e908a162f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_State_PermaDefeated = False
#.      - GLO_Halsin_Knows_IsFound = True
#. SetFlags:
#.   Local:
#.     - 96fcd78d-a71b-fe26-84bd-c0f59a85b60f_ToldFoundHalsin = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:82bd76f8-c65a-36fe-30e2-453e908a162f
msgctxt "hbab9feffgc8cfg407dg978egffdb5ba823c2"
msgid "I know where Halsin is! Give me the antidote or he'll die."
msgstr "난 할신의 위치를 알고 있어! 내게 해독제를 주지 않으면 그는 죽을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 84cca1d3-fbd2-2a05-70d8-85fc51b64506
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Dexterity
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:84cca1d3-fbd2-2a05-70d8-85fc51b64506
msgctxt "h4383cd86g7e10g4017g80b6gac36edd52820"
msgid "<i>Dodge when she lunges for you.</i>"
msgstr "<i>그녀가 당신을 향해 돌진할 때 회피한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 84cfeb5a-76f7-378b-72b2-6a52771f25e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:84cfeb5a-76f7-378b-72b2-6a52771f25e2
msgctxt "hcd92b394g477cg4d94gbc38g0fafaaa189c1"
msgid "The door's locked. Neither of us are leaving until this is done."
msgstr "문은 잠겼어요. 이 일이 마무리되기 전까진 누구도 떠날 수 없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 84d9ce7c-051f-45f2-368b-006f372f6bb3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_Cyanide_AskedBranch(1) = False
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_Cyanide_AskedBranch(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:84d9ce7c-051f-45f2-368b-006f372f6bb3
msgctxt "h177fa3e3g07f6g4e0cg87feg1e3e48ded006"
msgid "What is that?"
msgstr "그게 뭐지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 85c7e81c-6ce7-72d1-4a45-708a6384b8de
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:85c7e81c-6ce7-72d1-4a45-708a6384b8de
msgctxt "h694d657cgd75dg4859g9d04g2a26ca3c4bb1"
msgid "A cure."
msgstr "치료제예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 8791af9e-8ef5-68ff-93e4-e72037e848c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:8791af9e-8ef5-68ff-93e4-e72037e848c8
msgctxt "h69e041bcg60beg4c7agbad7g7e0d71e491df"
msgid ""
"If you transform out there, you'll kill everyone in the grove. Everyone for "
"leagues around."
msgstr "만약 당신이 저 밖에서 변이하면, 숲에 있는 모든 사람이 죽을 거예요. 주변 모두가 몰살당할 거라고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 88f310ca-0413-d56a-c2cb-9e7e2aa9c4a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:88f310ca-0413-d56a-c2cb-9e7e2aa9c4a8
msgctxt "h67e44b0ag4698g43f1g9fd9g0702a5b5a94a"
msgid ""
"I wouldn't be so sure. There's a lot we don't know. Infected - folks like "
"you - have been converging on an old temple of Selûne, and I've no idea why."
msgstr ""
"그렇게 확신할 수는 없어요. 우리가 모르는 게 너무 많아요. 당신 같은 감염자들이 오래된 셀루네의 신전에 모여들고 있는데, 그 이유를 "
"모르겠어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 899226ce-fbff-8033-27fd-880b4f28ff25
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:899226ce-fbff-8033-27fd-880b4f28ff25
msgctxt "he60f74d2g3c43g470aga413g12465ec50bf0"
msgid "We can look after our own. Starting with this."
msgstr "우리는 우리 스스로를 지킬 수 있어요. 그 시작이 바로 이거고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 8bb6cc41-f7e3-f092-92fc-39b8e41dc0ba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:8bb6cc41-f7e3-f092-92fc-39b8e41dc0ba
msgctxt "ha94f4937g4ba3g4556g88a5g78a0cfe8d9a4"
msgid "Thank you, I'll take anything that can help."
msgstr "고마워, 도움이 될 만한 건 뭐든 받아들일게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 8d4d172e-e369-7b5d-1f0c-288e5e0c951b
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - DEN_DruidLair_State_UnderstoodTwoFrescos = True
#.   Object:
#.      - DEN_Apprentice_State_Cyanide_Intimidate1(1) = False
#.      - DEN_Apprentice_State_Cyanide_Intimidate2(1) = False
#.   Tag:
#.      - DRUID(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:8d4d172e-e369-7b5d-1f0c-288e5e0c951b
msgctxt "h2e0c13f0gc64ag4ae9g833fgf791752a698b"
msgid "<i>Recite what you know of her order - this can't be allowed!</i>"
msgstr "<i>그녀의 단체에 대해 알고 있는 것을 열거하듯 말한다 - 이런 일은 용납될 수 없다!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 8db36843-8196-2476-878e-70f362df9275
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:8db36843-8196-2476-878e-70f362df9275
msgctxt "h5caa68fcg92d2g44a2gbf59gb78055056246"
msgid ""
"If you can find Halsin and get him out of there, we can discover what he "
"learned. And perhaps he can save your life. How's that sound?"
msgstr ""
"만약 당신이 할신을 찾아서 거기서 꺼내주면 그가 뭘 배웠는지 알아낼 수 있어요. 그리고 아마도 그는 당신을 구할 수 있을 거예요. 어때요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 8e2610d5-d123-9a17-0b3b-7f4603626edc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Event_NettieTurnsHostile = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:8e2610d5-d123-9a17-0b3b-7f4603626edc
msgctxt "hf9291c59gff3fg4795gb1aagafa3885c4352"
msgid "<i>Attack her.</i>"
msgstr "<i>그녀를 공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 8e4e0d2e-8708-c44c-d3e5-354da16ad07b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_Cyanide_WarnedOfOptions(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:8e4e0d2e-8708-c44c-d3e5-354da16ad07b
msgctxt "h320d5debgb29bg4171gaac8g7318af20aacc"
msgid ""
"But of course, the choice is yours. I just hope you find a cure out there."
msgstr "물론 선택은 당신 몫이애요. 저는 당신이 그곳에서 치료제를 찾기를 바랄 뿐이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 8e62fbaf-cd3c-bee8-e386-cf64898621e1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:8e62fbaf-cd3c-bee8-e386-cf64898621e1
msgctxt "h93373058g96c9g4b13g8803g53fa552d985e"
msgid "Nothing. I'm sure."
msgstr "아무것도 없었어. 확실해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 8e98c147-a9ff-5168-702e-c0ee6ee8ca88
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_HasWyvernPoison(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:8e98c147-a9ff-5168-702e-c0ee6ee8ca88
msgctxt "h6366e33dga197g40a9g91a9ga3604bd763fc"
msgid ""
"This is a vial of wyvern poison. Swear to me you'll swallow it if you feel "
"<i>any </i>symptoms."
msgstr "이건 와이번 독이 담긴 병이에요. <i>어떤</i> 증상이라도 느껴지면 삼키겠다고 맹세하세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Gale
#. NodeID = 8e9ac958-7574-1dbe-7239-4f1fdb764a74
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_GALE(7) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:8e9ac958-7574-1dbe-7239-4f1fdb764a74
msgctxt "h69499d88gf94eg4831gb272gdee4e6ec907d"
msgid "I'm interested in the procedure, actually. Please, go ahead."
msgstr "사실 어떤 과정인지 궁금하거든. 계속해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 8eb2863b-7339-0d28-ca27-8d63b61389cd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:8eb2863b-7339-0d28-ca27-8d63b61389cd
msgctxt "h80ec74bdg9cb8g4944g9526g0bd78b12383f"
msgid ""
"The thing is, I've sent birds to find him, but the place is rotten with "
"goblins. None of us can even get close."
msgstr "문제는 제가 그를 찾기 위해 새들을 보냈지만, 그곳은 고블린으로 들끓고 있다는 거예요. 우리 중 누구도 접근조차 못하죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 91f80875-adbb-3f69-dc9c-12c145f60838
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:91f80875-adbb-3f69-dc9c-12c145f60838
msgctxt "h2c2c56e7g92d3g48ddg9f10gc913ebee3948"
msgid "I can merge my mind with anyone else that's infected."
msgstr "나는 감염된 다른 사람과 정신을 결합할 수 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 9235dd39-6553-7b01-2671-d38deaeaa739
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:9235dd39-6553-7b01-2671-d38deaeaa739
msgctxt "h405fba02g345fg41d0gb54cg20823bafe2e2"
msgid "That's... good news?"
msgstr "그건... 좋은 소식인가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 92670ed2-046c-1da3-71bc-65279c8edb84
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_Event_GiveWyvenPoison(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:92670ed2-046c-1da3-71bc-65279c8edb84
msgctxt "h388a8ec9g8db2g4673gb40dg7eec3a3271fa"
msgid ""
"Good luck out there. And if things start to go bad - remember the vial. "
"Remember your oath."
msgstr "행운을 빌어요. 그리고 상황이 나빠지면, 독을 기억하세요. 당신의 약속을요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 926b80ba-875d-52aa-5904-0ed29c67ecc3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Quest_FindHalsin = True
#.     - DEN_Apprentice_Event_OpenDoor = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:926b80ba-875d-52aa-5904-0ed29c67ecc3
msgctxt "h48796879gbe41g431agaa99g4fe9a34691cd"
msgid ""
"Master Halsin and I were tracking them, studying them, trying to figure out "
"what the hells was going on."
msgstr "마스터 할신과 저는 그들을 추적하고, 연구해서, 도대체 무슨 일이 벌어지고 있는지 알아내려고 노력하고 있었어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 93851ffa-1f6f-461d-deee-77c5adb4bef1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Apprentice_Knows_IdentifiedBranch = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:93851ffa-1f6f-461d-deee-77c5adb4bef1
msgctxt "h93b06b7agad21g421ega3acg9897ede4cf7a"
msgid "All right. I suppose that makes things easier."
msgstr "좋아요. 이제 일이 더 쉬워진 것 같네요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 939190bf-3064-2dd0-9c5c-b2719fb48b31
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:939190bf-3064-2dd0-9c5c-b2719fb48b31
msgctxt "hf1aee13egb8d5g4407g95cdga9c0176bd2b9"
msgid "Try to poison me and you'll regret it."
msgstr "나를 중독시키려 해 봐. 후회하게 될 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 948f79fa-a7fc-dc56-b95d-081688fcd729
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - DEN_DruidLair_State_UnderstoodTwoFrescos = True
#.   Object:
#.      - DEN_Apprentice_State_Cyanide_Intimidate1(1) = False
#.   Tag:
#.      - DRUID(1) = False
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_Cyanide_Intimidate1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:948f79fa-a7fc-dc56-b95d-081688fcd729
msgctxt "h313c7a11g471cg4d06g9f79gff220880bd9c"
msgid "<i>Recite what you know of her order - this can't be allowed!</i>"
msgstr "<i>그녀의 단체에 대해 알고 있는 것을 열거하듯 말한다 - 이런 일은 용납될 수 없다!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 94a3fba7-5973-4278-1f7e-f48bcf2a0064
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 10
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_Cyanide_Intimidate1(1) = False
#.      - DEN_Apprentice_State_Cyanide_Intimidate2(1) = False
#.   Tag:
#.      - DRUID(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:94a3fba7-5973-4278-1f7e-f48bcf2a0064
msgctxt "hd2d138aag584dg4673g9f49g11db1c6e7ca3"
msgid "<i>Recite her order's druidic law - this can't be allowed!</i>"
msgstr "<i>그녀가 속한 단체의 드루이드 율법을 열거하듯 말한다 - 이런 일은 용납될 수 없다!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 95cc0ad0-07b8-daaf-1c31-97027adad433
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:95cc0ad0-07b8-daaf-1c31-97027adad433
msgctxt "hdf7fd66eg08f2g4142g9b25g8cc060f3ee08"
msgid "I'm not showing symptoms - that means I have time."
msgstr "나는 증상을 보이지 않고 있어. 그 말인즉슨, 나에게 시간이 있다는 뜻이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 96fe9803-d0fd-b502-5477-391cea80ccd8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:96fe9803-d0fd-b502-5477-391cea80ccd8
msgctxt "h65686c71ge1f9g4d55g9ab5g1310d7e4a15c"
msgid "It recognised you as being infected? Well now, that's something."
msgstr "당신을 감염된 것으로 인식한 건가요? 그거 신기하네요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 98db7e46-072e-a0ab-7598-24e318ac8988
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:98db7e46-072e-a0ab-7598-24e318ac8988
msgctxt "h718b5380gfeacg47d6g8a69g1a190b24f67b"
msgid "Gods above. It's a risk, but maybe you deserve a chance..."
msgstr "신이시여. 위험할지도 모르겠지만 당신은 기회를 잡을 자격이 있을지도 모르겠네요..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = 9b20f251-402b-8858-ccf7-fd56999f3678
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:9b20f251-402b-8858-ccf7-fd56999f3678
msgctxt "h47eabadcgba4cg4b79gb21aga31fcccc63ea"
msgid "I just want a chance to find a cure."
msgstr "나는 치료법을 찾을 기회를 원할 뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = 9c554735-5537-9682-e863-10dbc7822b13
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:9c554735-5537-9682-e863-10dbc7822b13
msgctxt "he4efd9d5gb170g42adg831fg8ca7a262456d"
msgid ""
"Do whatever you need to, but we're not leaving this room until it's over."
msgstr "필요한 것은 무엇이든 하시되, 우린 이 상황이 끝날 때까지 이 방을 떠나지 못할 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = a25707fb-5d87-011d-a312-62db83a6c69a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:a25707fb-5d87-011d-a312-62db83a6c69a
msgctxt "h87144534g3d06g4c83g9ca3g3a151a4e8b33"
msgid "Are you mad? I'm not going to kill myself - symptoms or not."
msgstr "미쳤나? 증상이 있는 없든, 나는 자살하지 않을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = a265fe70-986b-c3f4-7060-04a0ea62c10e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:a265fe70-986b-c3f4-7060-04a0ea62c10e
msgctxt "h78666209gef6bg43e4gb494g02f3de3dd0d0"
msgid "I don't care - I am not going to die!"
msgstr "신경 안 써 - 나는 안 죽을 거야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = a27cc0fe-b3c9-f20c-c2ff-3aedbebe6a15
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:a27cc0fe-b3c9-f20c-c2ff-3aedbebe6a15
msgctxt "h9c15234dge47cg4eaega067gbb513012b6ba"
msgid "What do you mean 'should' be changing?"
msgstr "변이'했어야 했다'는 무슨 뜻이야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = a286d6fa-7d84-b62c-24e7-eeaa5e8a56cd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_RaidingParty_Event_AdventurersLeave = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:a286d6fa-7d84-b62c-24e7-eeaa5e8a56cd
msgctxt "hf4970c54gd724g4c0dgadcagacbbb9ab3623"
msgid ""
"I wish I could tell you what happened out there, but those adventurers were "
"the only witnesses. And they're long gone."
msgstr "바깥에서 무슨 일이 일어났었는지 알려드리고 싶지만, 유일한 목격자였던 모험가들이 떠나버렸군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = a4dc9581-7534-cb07-ee55-db4f8da0e1f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:a4dc9581-7534-cb07-ee55-db4f8da0e1f1
msgctxt "h6908a385g32e0g40fdg9759g382c35829a4d"
msgid "Gods above - why didn't you say so?"
msgstr "신이시여, 왜 그건 말하지 않았어요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = a5bbda15-fe11-be10-9a9e-318f7ccc358c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Apprentice_Knows_IdentifiedBranch = False
#.   Object:
#.      - DEN_Apprentice_State_Cyanide_ShortPath(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:a5bbda15-fe11-be10-9a9e-318f7ccc358c
msgctxt "hab054c40ga570g4611gb911ga613a5d668db"
msgid "I thought you could cure me? What about that branch of yours?"
msgstr "당신이 나를 치료할 수 있다고 생각했는데? 당신의 그 가지는 뭐지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = a5cca53c-bc60-d36d-d61d-bc04f72bc3c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:a5cca53c-bc60-d36d-d61d-bc04f72bc3c4
msgctxt "hee5fb84bg362bg4336gbfebgb6d672462653"
msgid "Just tell me if there's a cure or not."
msgstr "치료제가 있는지 없는지나 말해 줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = a68cea65-8e9e-39e9-807a-4d7b6123b6c2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:a68cea65-8e9e-39e9-807a-4d7b6123b6c2
msgctxt "h0be83191gb350g40eag8980ge79bf5a5dae1"
msgid ""
"He attacked Master Halsin and I in the woods, leading a pack of goblins."
msgstr "숲에서 고블린들을 이끌고 저와 할신 님을 공격했어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = a72d0e72-dec7-a6b8-d3c1-2a7b4ca14afc
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_Cyanide_Deceive1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:a72d0e72-dec7-a6b8-d3c1-2a7b4ca14afc
msgctxt "h740cbd61g537dg47e9g80edgcaacd6f11f34"
msgid "You can't do this - your leader needs to talk to me."
msgstr "이러면 안 돼. 너의 지도자가 나와 이야기해야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = a7f12982-afdd-ebd2-d5a8-439065737efb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:a7f12982-afdd-ebd2-d5a8-439065737efb
msgctxt "h62b0448bgcb1dg41fega65cg0e67a3e85deb"
msgid "No. Absolutely not."
msgstr "안 돼. 절대 안 돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = a9586c5d-07c8-6ba8-54b2-93275ba2aba5
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_DROWELF or REALLY_DROWHALFELF
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:a9586c5d-07c8-6ba8-54b2-93275ba2aba5
msgctxt "h88aec5cegb3aag4a89ga4dag1db78acf1c12"
msgid "He and I have the same kind of parasite?"
msgstr "나도 저 드로우와 같은 종류의 기생충이 있는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = a9586c5d-07c8-6ba8-54b2-93275ba2aba5
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:a9586c5d-07c8-6ba8-54b2-93275ba2aba5
msgctxt "he8268daag8e93g4aeeg9558g0103bc40d6f2"
msgid "The drow and I have the same kind of parasite?"
msgstr "이 드로우와 내가 같은 기생충을 가진 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = a9806704-57a6-7ef8-7f80-3d0c57d446e0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Event_CheckOtherPlayers = True
#.     - GLO_Halsin_Knows_IsMissing = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:a9806704-57a6-7ef8-7f80-3d0c57d446e0
msgctxt "h6ed58439ge24bg4e0ag891cgb31613d474b7"
msgid ""
"A pity you got me instead of him. He understands these things - studied "
"them. Still, we have options."
msgstr ""
"이것들을 제대로 이해하고 연구하던 그분이 여기 있었다면 좋았을 텐데, 대신 저만 있어 유감이네요. 그래도 우리에겐 선택지가 있습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = aaa919f4-a1df-6c3f-3477-22f4388569a9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:aaa919f4-a1df-6c3f-3477-22f4388569a9
msgctxt "h2def966age219g4425g842fg34b726b815f4"
msgid "What is this? I came to you for help!"
msgstr "이건 뭐야? 나는 너에게 도움을 구하러 왔어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = ab14e6c1-8782-0aeb-548a-f7eb01abf0aa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:ab14e6c1-8782-0aeb-548a-f7eb01abf0aa
msgctxt "h7b102b13g0e19g421eg948fgc9aaf3b192c3"
msgid "But first, swear to me you'll do what needs to be done."
msgstr "하지만 그 전에, 해야 할 일을 하겠노라 맹세해 주세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = ac28ac1a-5de9-3596-f31d-95ed4ba7d5a7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Knows_StudiedTadpole = True
#.   Quest:
#.     - GLO_Tadpole_SUB_Druid.LearnedResearchHalsin(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:ac28ac1a-5de9-3596-f31d-95ed4ba7d5a7
msgctxt "h3c2dc334gca6bg4670gaf78gbbb4cfd2363d"
msgid ""
"Because you should all be changing - there should be a small army of mind "
"flayers out there! But you're not. Weird powers aside, you seem perfectly "
"normal."
msgstr ""
"원래대로라면 당신들 모두 진작에 변이했어야만 해요. 지금쯤이면 저 밖에 소규모 마인드 플레이어 군대가 있어야 한다고요! 그런데 변이하지 "
"않고 있죠. 기묘한 능력을 제외하면 지극히 정상이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = ac911e6d-90c1-4f61-4a6b-9f57de2f53d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:ac911e6d-90c1-4f61-4a6b-9f57de2f53d0
msgctxt "hc9b98f42g16a1g4f41g91e4g56aad1d2e387"
msgid ""
"I've sent birds to find him, but the place is rotten with goblins. And if my "
"birds can't get close, what chance do I have?"
msgstr "마스터 할신을 찾기 위해 새들을 보냈지만, 그곳은 고블린으로 들끓고 있어요. 새들조차 접근할 수 없는데, 제가 어쩌겠어요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = acb76f47-ead1-7816-2fea-bf9a548297a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:acb76f47-ead1-7816-2fea-bf9a548297a4
msgctxt "h996ef48fgd452g4b27ga3ccg92ca151a4b6c"
msgid "Maybe, but it's one hell of a maybe. You could have days or seconds."
msgstr "그럴지도요, 하지만 그건 정확히 알 수 없어요. 며칠이 남았을지, 아니면 몇 초가 남았을지도 몰라요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Shadowheart
#. NodeID = ae221b05-5cb6-2221-e84e-c3845e80ce28
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:ae221b05-5cb6-2221-e84e-c3845e80ce28
msgctxt "ha9769976gd122g4f95g9f1cg3c67279dcbd2"
msgid "No, I'll stay. I'd rather know exactly what you're up to."
msgstr "아니, 난 머무를거야. 네가 뭘 하려고 하는 건지 정확히 알아야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = ae2a9553-56b0-4993-75bd-6f5dc44a779d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 10
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_Cyanide_Intimidate1(1) = True
#.      - DEN_Apprentice_State_Cyanide_Intimidate2(1) = False
#.   Tag:
#.      - SORCERER(1) = False
#.      - WARLOCK(1) = False
#.      - WIZARD(1) = False
#.      - REALLY_GALE(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:ae2a9553-56b0-4993-75bd-6f5dc44a779d
msgctxt "hc097e7bfg3105g462ag8d35g0e48d06058e0"
msgid "Magic can cure me if you can't. I know the Weave well!"
msgstr "당신이 할 수 없다면, 마법이 날 치유할 수 있을 거야. 난 위브를 아주 잘 알거든!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = ae2fcc65-d095-0a61-3abf-d67d2d223e89
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = False
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_Cyanide_Intimidate1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:ae2fcc65-d095-0a61-3abf-d67d2d223e89
msgctxt "hb3864263g27b3g4aaagac38g0ad70ae9c356"
msgid "<i>Try to recall the tenets of her order - she can't support this!</i>"
msgstr "<i>그녀가 속한 단체의 교리를 기억해본다 - 그녀는 이런 일을 지지할 수 없다!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = af3f0888-0971-7615-6728-e099c49539c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:af3f0888-0971-7615-6728-e099c49539c6
msgctxt "ha88f54feg0cfag4b11g989fg7a8de306be77"
msgid "Tadpole crawled out of his head soon after."
msgstr "그리고 얼마 지나지 않아 올챙이가 머릿속에서 기어 나오더군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = b02972e3-44f5-6fda-4ce7-0d3b709b487d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - GLO_Tadpole_SUB_Druid.LearnedResearchHalsin(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:b02972e3-44f5-6fda-4ce7-0d3b709b487d
msgctxt "h96591ddbg2701g4698g88c7g2fc4d1584dc2"
msgid ""
"Master Halsin did say the drow's tadpole was dormant. Maybe yours is too."
msgstr "마스터 할신은 이 드로우의 올챙이가 동면 상태에 있었다고 하셨어요. 어쩌면 당신 것도 마찬가지일지도요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = b0e0a699-1549-170e-37d7-5350b6ec3cc1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:b0e0a699-1549-170e-37d7-5350b6ec3cc1
msgctxt "h664788a4ge40fg444egb873g4f9b3a0a16a2"
msgid ""
"The drow's tadpole was dormant, not dead. It didn't transform, but that's "
"not to say it wouldn't have."
msgstr "그 드로우의 올챙이는 동면 상태였지, 죽은 게 아니었어요. 변이하지는 않았지만 끝까지 그랬을지는 모르는 일이죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = b374b8ba-25bd-0c22-7565-6c878c17742b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:b374b8ba-25bd-0c22-7565-6c878c17742b
msgctxt "hf9546438g1893g4deeg9c99gecdb0399d5cc"
msgid "I swear."
msgstr "맹세할게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = b3878a0d-0cd8-a412-c109-10bc599ec1b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:b3878a0d-0cd8-a412-c109-10bc599ec1b3
msgctxt "h5df41e60ge57dg4e3cgac58g55289022c5f1"
msgid "All right. Hand it over."
msgstr "좋아. 그걸 이리 넘겨."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = b39ad233-3a8b-9a50-3271-fbc56349982f
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - DEN_Apprentice_Knows_IdentifiedBranch = False
#.   Object:
#.      - DEN_Apprentice_Event_TookThorn(1) = True
#. TagRule: DRUID or RANGER
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:b39ad233-3a8b-9a50-3271-fbc56349982f
msgctxt "h4e028bc6gf88dg4581ga8cdg59ab6791fcdc"
msgid "<i>Examine the branch - have you come across this plant before?</i>"
msgstr "<i>가지를 조사한다 - 이 식물을 본 적이 있나?</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = b41ff6f6-80d2-3f2b-59b4-3c180166e830
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_CuredEarly(1) = True
#.   User:
#.     - DEN_Apprentice_State_Cyanide_Persuaded(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:b41ff6f6-80d2-3f2b-59b4-3c180166e830
msgctxt "hb42a7b49g0e84g4244g9386gad54642da288"
msgid "All right, but on one condition."
msgstr "좋아요, 하지만 한 가지 조건이 있어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = b56b8484-dec6-b09a-8363-63b0a651bbae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:b56b8484-dec6-b09a-8363-63b0a651bbae
msgctxt "hdf53d36fg5358g4c76g9f6dg5ee46b8d7184"
msgid "Thank you. It would mean everything to the grove. To me."
msgstr "고마워요. 이 일은 이 숲에게 있어 모든 것이에요. 저에게도요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = b63ec106-afaf-977f-f639-700295eee78e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Event_CloseDoor = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:b63ec106-afaf-977f-f639-700295eee78e
msgctxt "hb6f5aa49ga77dg49dcgbd35g78d78876565a"
msgid "I - I'm sorry, but I can't let you go."
msgstr "죄 - 죄송해요. 하지만 당신을 가게 둘 수 없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = b6606558-8625-087b-129b-e4dc4bd80068
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:b6606558-8625-087b-129b-e4dc4bd80068
msgctxt "hf28ace94g3e90g472cgb3e2g0b7f933355b0"
msgid "Not yet, anyhow."
msgstr "어떻게든, 아직은요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = b6970e6d-ba31-e5cf-48f6-ea728a4aced5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:b6970e6d-ba31-e5cf-48f6-ea728a4aced5
msgctxt "h88802400ge9f5g43f3ga3c8gff8081bbeda0"
msgid ""
"For one, that thing in your head is like nothing we've ever seen from mind "
"flayers."
msgstr "우선, 당신 머릿속에 있는 것은 지금까지 우리가 마인드 플레이어에게서 본 적이 없는 것이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = b6b51ef8-5016-0e29-76d3-d90689995230
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - DEN_Apprentice_Knows_IdentifiedBranch = False
#.   Object:
#.      - DEN_Apprentice_Event_TookThorn(1) = False
#.   Tag:
#.      - RANGER(1) = False
#.      - DRUID(1) = False
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_Event_TookThorn(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:b6b51ef8-5016-0e29-76d3-d90689995230
msgctxt "hbc6dd8deg26a8g4b88ga4f5ga9f53ad4561a"
msgid "<i>Grab the branch and try to identify the poison.</i>"
msgstr "<i>가지를 붙잡고 독을 판별하려고 한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = b6fce2f6-a4d7-7b11-1341-a0a5fa462269
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:b6fce2f6-a4d7-7b11-1341-a0a5fa462269
msgctxt "h7da600d5g0de1g43c3g8475gb8e238d9cfb1"
msgid "It 'might'? What aren't you telling me?"
msgstr "'아마'? 나에게 말하지 않은 것이 뭐지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = b7e3d27c-a68d-dabd-f570-f5f590c9e1b3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Knows_WentWithAdventurers = True
#.   Quest:
#.     - GLO_Tadpole_SUB_Druid.LearnedLostHalsin(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:b7e3d27c-a68d-dabd-f570-f5f590c9e1b3
msgctxt "hccf663f1g636dg4178gaef2g2b10d8479cdc"
msgid ""
"It's why he joined the adventurers on their expedition. To find out what was "
"happening."
msgstr "그래서 이번 원정에 따라가신 거예요. 무슨 일이 일어난 건지 알아내기 위해서요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = ba1d5285-d550-4df9-ee74-2fd9c0fe6c56
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:ba1d5285-d550-4df9-ee74-2fd9c0fe6c56
msgctxt "hc92b0813g4db9g4aa9ga714g781f7e514941"
msgid ""
"Mind flayers reproduce by infecting someone with their parasite. Seven "
"gruesome days later, the victim transforms and a new mind flayer is born."
msgstr ""
"마인드 플레이어는 누군가를 기생충에 감염시켜 번식합니다. 끔찍한 일주일이 지난 후, 피해자는 변이하고 새로운 마인드 플레이어가 탄생하죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = babc3351-9152-fed6-e82d-b20d72c2385f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:babc3351-9152-fed6-e82d-b20d72c2385f
msgctxt "he36431a9g9bf6g402fg91f1gb1a7837974a5"
msgid ""
"I've spent my life treating folk and never once saw a mind flayer infection. "
"Then suddenly there's dozens of you - maybe more."
msgstr ""
"저는 평생 사람들을 치료해왔지만 한 번도 마인드 플레이어 감염을 본 적이 없어요. 그런데 갑자기 수십 명, 어쩌면 그 이상의 감염자가 "
"나타났다고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = bba17a7c-e2c5-df3c-3667-2313d7a37715
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Knows_WentWithAdventurers = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:bba17a7c-e2c5-df3c-3667-2313d7a37715
msgctxt "h6b784e67ga83bg4bc3g8df1gecc2c24b3ffd"
msgid ""
"All I can say for sure is they all went to the old temple of Selûne and "
"Master Halsin didn't make it back."
msgstr "제가 확실히 말할 수 있는 건 그들이 모두 오래된 셀루네의 신전에 갔고 마스터 할신은 돌아오지 못했다는 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = bbd2070a-b24e-e655-0049-01b6b44f7c70
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Apprentice_Knows_IdentifiedBranch = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:bbd2070a-b24e-e655-0049-01b6b44f7c70
msgctxt "hd7ae931dgf1d0g4c6agb9efg7ba73799a46d"
msgid "Look, are you going to cure me or not?"
msgstr "이봐, 나를 치료할 거야, 안할 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = bd74290b-1180-8112-ee2f-3ee9684ff012
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:bd74290b-1180-8112-ee2f-3ee9684ff012
msgctxt "hd8bd0a62g0557g4d07gbb30g9f9658b3113b"
msgid "<i>Turn and leave.</i>"
msgstr "<i>돌아서서 떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = bd9e47aa-3b0b-bb25-24e3-23382eec6ed8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:bd9e47aa-3b0b-bb25-24e3-23382eec6ed8
msgctxt "ha101b819g2329g4892gbdcag44aa32ec7117"
msgid ""
"I don't want to hurt you, but I can't let you live. You're too dangerous."
msgstr "저는 당신을 다치게 하고 싶진 않지만, 살려 보낼 수도 없어요. 당신은 너무 위험해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = bf3460ad-815b-d407-0622-c4b45ffaf8fb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Apprentice_Knows_IdentifiedBranch = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:bf3460ad-815b-d407-0622-c4b45ffaf8fb
msgctxt "hdb59288bg05b5g47c3g956ag99828a27b6f5"
msgid "So you can poison me? Absolutely not!"
msgstr "날 중독시키려고? 어림도 없지!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = c01988e2-ff5a-d38c-63dd-e26b710d35aa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Apprentice_Knows_IdentifiedBranch = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:c01988e2-ff5a-d38c-63dd-e26b710d35aa
msgctxt "h2be7d6e8g4b0cg459dg96ccg9b7891743840"
msgid "Put the thorns down and I'll tell you."
msgstr "그 가시를 치우고 나면 설명해 주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = c1b0e745-3723-3e9b-e9db-e2c9026e10e4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:c1b0e745-3723-3e9b-e9db-e2c9026e10e4
msgctxt "h6fef0eadg9997g45d8g8628gc99faee5755a"
msgid "<i>Swear it.</i>"
msgstr "<i>맹세하세요.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = c22ce011-525a-679e-0657-a50f467b8e94
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_State_PermaDefeated = False
#.      - GLO_Halsin_Knows_IsFound = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:c22ce011-525a-679e-0657-a50f467b8e94
msgctxt "h2b4c00e8g9c58g4c13g97d5g1f78201204fa"
msgid "Halsin? I saw him in the goblin camp."
msgstr "할신? 고블린 야영지에서 그를 봤어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = c31fd7d6-6c66-606e-c056-7b2470dc1568
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   User:
#.     - DEN_Apprentice_State_Cyanide_Persuaded(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:c31fd7d6-6c66-606e-c056-7b2470dc1568
msgctxt "h300c08cega82cg4d56gb105g5a210991279b"
msgid ""
"Hells' teeth, why didn't you say anything sooner? I'll tell you where the "
"antidote is, but there's a condition."
msgstr "맙소사, 왜 진작 말하지 않았어요? 해독제가 어디 있는지 알려드릴게요. 대신 조건이 있어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = c41440ca-6946-5f6e-0fe8-3f0fb14d685e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:c41440ca-6946-5f6e-0fe8-3f0fb14d685e
msgctxt "h3117c8b8gb63ag4695g953ag518a9086166e"
msgid "<i>Try to recall the tenets of her order - she can't support this!</i>"
msgstr "<i>네티가 속한 단체의 교리를 떠올리려 애쓴다 - 이런 일을 지지할 리가!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = c59c285d-29c0-a0cb-0759-01ccd85a6a32
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:c59c285d-29c0-a0cb-0759-01ccd85a6a32
msgctxt "h8df9d49fge272g4b64g9e60gcfa861f00633"
msgid "No! I can't let you leave - you could transform any second."
msgstr "안 돼요! 당신을 떠나게 둘 순 없어요. 당신은 언제라도 변이할 수 있으니까요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = c5eb2d07-7a26-5487-bd58-32296443a1ea
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Event_CheckOtherPlayers = True
#.     - GLO_Halsin_Knows_IsMissing = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:c5eb2d07-7a26-5487-bd58-32296443a1ea
msgctxt "hfabf1b8egb8e8g46ecgb2dfg521326579753"
msgid ""
"I'm no Master Halsin, mind. He'd have your tadpole out like that. Still, we "
"have options."
msgstr ""
"저는 마스터 할신이 아니에요. 할신 이라면 당신의 올챙이를 손쉽게 제거할 수 있겠죠. 하지만, 제가 해결해드릴 수 있는 선택지도 있어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = c6f7fb03-6b03-7cc2-bbb1-ac61d0ce6c4b
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 10
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_Event_TookThorn(1) = False
#.   Tag:
#.      - RANGER(1) = False
#.      - DRUID(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:c6f7fb03-6b03-7cc2-bbb1-ac61d0ce6c4b
msgctxt "he6dc2d4fgf846g4814g92e6g5087b3202fa5"
msgid "<i>Examine the branch to identify the poison.</i>"
msgstr "<i>독을 판별하기 위해 가지를 조사한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = c925e4aa-87ea-c7ff-9af6-5917d6d22ebd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 96fcd78d-a71b-fe26-84bd-c0f59a85b60f_ToldFoundHalsin = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:c925e4aa-87ea-c7ff-9af6-5917d6d22ebd
msgctxt "hd791ae9ag1a12g4d88gb62eg44e6c2d5be2d"
msgid ""
"If you can get Halsin out of there, we can discover what he learned. And "
"perhaps he can save your life. How's that sound?"
msgstr "할신을 데려올 수 있다면 그가 거기서 무엇을 발견했는지 알 수 있어요. 아마 당신을 살릴 수 있을지도 몰라요. 어때요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = c9427c9d-4763-723a-97ff-b91ee24639b7
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 10
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_Cyanide_Intimidate1(1) = False
#.   Tag:
#.      - DRUID(1) = True
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_Cyanide_Intimidate1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:c9427c9d-4763-723a-97ff-b91ee24639b7
msgctxt "h522a9676g867bg43d9g817bg4f255faf2546"
msgid "<i>Recite her order's druidic law - this can't be allowed!</i>"
msgstr "<i>그녀가 속한 단체의 드루이드 율법을 열거하듯 말한다 - 이런 일은 용납될 수 없다!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Wyll
#. NodeID = c97f1876-7354-0309-7b25-0f0f6680d314
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(2) = True
#.   Tag:
#.      - REALLY_WYLL(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:c97f1876-7354-0309-7b25-0f0f6680d314
msgctxt "he9323536gdc8bg4288gbccag290bbc2ed85c"
msgid "I'd like to stay, if it's all the same."
msgstr "어차피 별 차이가 없다면 여기 있을게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = ca966dfb-01c3-2c66-8150-36f6b3598c0c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:ca966dfb-01c3-2c66-8150-36f6b3598c0c
msgctxt "h612de645gcf16g4bb1ga96cg848a27fb96c4"
msgid "So you killed him and laid him out on the table?"
msgstr "그래서 당신이 그를 죽여서 테이블 위에 눕혔나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = cbd12efe-5324-acd3-19e3-e39ca1054f8f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:cbd12efe-5324-acd3-19e3-e39ca1054f8f
msgctxt "hf464ddf4g0181g4117gb48fg021cb7e29974"
msgid ""
"The way I see it, you have two options. Halsin or death - whatever form it "
"takes."
msgstr "제가 봤을 때, 당신에게는 두 가지 선택지가 있어요. 할신 아니면 죽음입니다 - 어떤 방식이든 간에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = ce68aa48-9184-b1e6-b5c4-70c681730184
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:ce68aa48-9184-b1e6-b5c4-70c681730184
msgctxt "hb1b80334gbf0cg4e35ga36ag1e97944915a1"
msgid "I won't. I can't."
msgstr "그러지 않을 거예요. 그럴 수 없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = cf2b908b-7ba1-5490-0a49-349450737a8a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Apprentice_State_SeesExtraPlayers = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:cf2b908b-7ba1-5490-0a49-349450737a8a
msgctxt "h2857d518g04ccg496eg9ebdge114fbe86667"
msgid "You don't have to be here for this."
msgstr "잠시 나가 계시는 게 어떤가요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = cf414d50-ff4e-118f-afd1-06f9def4c345
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Nettie_State_SoughtTadpoleCure = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:cf414d50-ff4e-118f-afd1-06f9def4c345
msgctxt "h1c4ee4f8g05d9g4f5fgb5e8g42cdea807e45"
msgid "All right, let's see what we can do."
msgstr "좋아요, 그럼 뭘 할 수 있는지 한번 보죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = cf89098a-c243-f5fd-a984-3a7bdd6451ef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:cf89098a-c243-f5fd-a984-3a7bdd6451ef
msgctxt "h0fbd357egd35cg4023ga81dgb5032f05669b"
msgid "No, nothing strange, I just want it out of my head."
msgstr "아니, 이상한 건 없었어. 나는 이게 내 머리에서 나가길 바랄 뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = d005442f-4aca-687b-2d23-d0b321cdcc75
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:d005442f-4aca-687b-2d23-d0b321cdcc75
msgctxt "h5291d7cag7425g4576g9a1dg8c2df5f029d7"
msgid "Be careful. Your legs'll probably give out first."
msgstr "조심하세요. 다리에 힘이 먼저 빠질 수 있어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = d1415417-a2fd-e319-8754-c8bc8f35afb9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:d1415417-a2fd-e319-8754-c8bc8f35afb9
msgctxt "h4569044eg27d8g4225ga2ecgb41144135e03"
msgid "Whatever this is, you had better have an antidote."
msgstr "이게 뭐든 간에 해독제를 가지고 있는 편이 신상에 좋을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = d3991b8a-3c4f-1c5f-f5c3-651576e135dd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:d3991b8a-3c4f-1c5f-f5c3-651576e135dd
msgctxt "h5b1460f9g1cacg4545g9e96gd3cf5f943b9f"
msgid "Just hurry up and cure me. I don't have time to chat."
msgstr "서둘러서 나를 치료하기나 해줘. 나는 잡담할 시간 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = d47fc1ae-8a92-89af-a19d-de8707a7f535
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:d47fc1ae-8a92-89af-a19d-de8707a7f535
msgctxt "he596cac9g40a6g47d9gbab2gf9a6e73f6557"
msgid "Are you mad? I'm not going to kill myself - symptoms or not."
msgstr "미쳤나? 증상이 있는 없든, 나는 자살하지 않을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = d4c05f94-d779-70d9-d8ed-7aba7fa6ad85
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 96fcd78d-a71b-fe26-84bd-c0f59a85b60f_ToldFoundHalsin = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:d4c05f94-d779-70d9-d8ed-7aba7fa6ad85
msgctxt "ha4fbfe65g9ee7g4ebfgb83ag67546da3404f"
msgid "You think he's still alive?"
msgstr "그가 아직 살아있다고 생각하나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = d556b9ad-6e5f-a517-087b-97cdb56cad75
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:d556b9ad-6e5f-a517-087b-97cdb56cad75
msgctxt "h85f044d7gb0e6g4a89gb0e3g4f4cc9936bae"
msgid "Now, I've an antidote - um... where is the bloody thing?"
msgstr "자, 여기 해독제가, 어... 이 젠장할 것이 어디 갔지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = d5fc0ab6-6f62-cad1-1b7a-6db01709aedd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:d5fc0ab6-6f62-cad1-1b7a-6db01709aedd
msgctxt "hf77d6b06gdce8g4b1fg82a4gad196594ea01"
msgid "<i>Turn and leave.</i>"
msgstr "<i>돌아서서 떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = d6389164-28e4-1996-a11b-62dadf77c5d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:d6389164-28e4-1996-a11b-62dadf77c5d4
msgctxt "h71745544g4dbcg42ffgb521g3182ee84f653"
msgid "You said you were tracking other victims. Did they change?"
msgstr "너는 다른 피해자들을 추적하고 있었다고 했지. 그들도 변이했나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = d66bf689-cb45-45b9-fb91-abd20d34dd6f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:d66bf689-cb45-45b9-fb91-abd20d34dd6f
msgctxt "h1a9fa2c0g8beeg4596ga37fg2290c413a1e7"
msgid "But you have to. Don't you understand? You could kill us all!"
msgstr "하지만 그렇게 하셔야 돼요. 이해 못하셨어요? 당신이 우리 모두를 죽일 수 있다구요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = d6be9094-feea-7f34-d2b1-9da8daf9bc47
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Knows_StudiedTadpole = True
#.   Quest:
#.     - GLO_Tadpole_SUB_Druid.LearnedResearchHalsin(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:d6be9094-feea-7f34-d2b1-9da8daf9bc47
msgctxt "h79923d0dgcfc5g4257g8ceagc5ff9549c181"
msgid ""
"If anyone can help you, it'll be him. He studied that tadpole for days, and "
"the birds told him about plenty of others with the same infection."
msgstr ""
"만약 당신을 도와줄 사람이 있다면, 그분일 거예요. 그는 며칠 동안 그 올챙이를 연구했고, 새들이 그에게 마찬가지로 감염된 수많은 이들에 "
"대해 알려줬어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = d9ea8958-3a09-efeb-139d-59a17e44ae10
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_Cyanide_Deceive1(1) = True
#.      - DEN_Apprentice_State_Cyanide_Deceive2(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:d9ea8958-3a09-efeb-139d-59a17e44ae10
msgctxt "h8643cc8agbb84g4dd1g81b9g01a282cb2554"
msgid "I have important information - the grove will be destroyed without it."
msgstr "내게 중요한 정보가 있어. 이대로라면 숲은 파멸하고 말 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = da5e5279-4965-8388-a7a0-c5ff99ae2b1e
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_TYR or PALADIN_TYR
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:da5e5279-4965-8388-a7a0-c5ff99ae2b1e
msgctxt "h181945begef96g4d27gb789g24f1a8e5a2d3"
msgid "I swear, by the Lord of Justice."
msgstr "정의의 신의 이름 아래 맹세하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = da5e5279-4965-8388-a7a0-c5ff99ae2b1e
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: CLERIC_SELUNE or PALADIN_SELUNE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:da5e5279-4965-8388-a7a0-c5ff99ae2b1e
msgctxt "hdee2c4ffg71e0g4641gbe3fgb56d8c512873"
msgid "By Our Lady of Silver, I swear it."
msgstr "은의 여신님의 이름 아래 맹세합니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = da5e5279-4965-8388-a7a0-c5ff99ae2b1e
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: CLERIC_ILMATER or PALADIN_ILMATER
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:da5e5279-4965-8388-a7a0-c5ff99ae2b1e
msgctxt "h838e619cg25a2g40acg949egb1396e651d79"
msgid "In the name of He Who Endures, I swear it."
msgstr "인내하시는 자의 이름으로 맹세합니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = da5e5279-4965-8388-a7a0-c5ff99ae2b1e
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: CLERIC_MYSTRA or PALADIN_MYSTRA
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:da5e5279-4965-8388-a7a0-c5ff99ae2b1e
msgctxt "ha88dca0bg869eg4a92gb7c3g7cb569027e46"
msgid "By the Mother of All Magic, I swear it."
msgstr "모든 마법의 어머니의 이름 아래 맹세하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = da5e5279-4965-8388-a7a0-c5ff99ae2b1e
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: CLERIC_HELM or PALADIN_HELM
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:da5e5279-4965-8388-a7a0-c5ff99ae2b1e
msgctxt "hed190fa4gc8e9g4c72gb420g39e3296a2de4"
msgid "In the Watcher's name, I swear it."
msgstr "감시자의 이름으로 맹세해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = da5e5279-4965-8388-a7a0-c5ff99ae2b1e
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: CLERIC_KELEMVOR or PALADIN_KELEMVOR
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:da5e5279-4965-8388-a7a0-c5ff99ae2b1e
msgctxt "h5804e37bg6fddg456dg8f8ege4b17dda72e8"
msgid "In Kelemvor's name, I swear it."
msgstr "켈렘보르의 이름으로, 맹세합니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = da5e5279-4965-8388-a7a0-c5ff99ae2b1e
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: CLERIC_OGHMA or PALADIN_OGHMA
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:da5e5279-4965-8388-a7a0-c5ff99ae2b1e
msgctxt "h57521806g59acg4790gb615g05c3a80ffca2"
msgid "By the Lord of Knowledge, I swear it."
msgstr "지식의 신의 이름 아래 맹세합니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = da5e5279-4965-8388-a7a0-c5ff99ae2b1e
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: CLERIC_TEMPUS or PALADIN_TEMPUS
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:da5e5279-4965-8388-a7a0-c5ff99ae2b1e
msgctxt "h18f6f01dg45d4g4be6gba05g50a34e767363"
msgid "By the Lord of Battles, I swear it."
msgstr "전쟁 군주의 이름으로 맹세해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = da5e5279-4965-8388-a7a0-c5ff99ae2b1e
#. HandlePath = TaggedText[8].TagText[0]
#. TagRule: CLERIC_LOLTH or CLERIC_SHAR or PALADIN_LOLTH or PALADIN_SHAR
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:da5e5279-4965-8388-a7a0-c5ff99ae2b1e
msgctxt "h8eaba6a8g8d44g4c0ag8be5g50490ad8d915"
msgid "I swear, in my Lady's name."
msgstr "여신님의 이름을 걸고 맹세하마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = da5e5279-4965-8388-a7a0-c5ff99ae2b1e
#. HandlePath = TaggedText[9].TagText[0]
#. TagRule: CLERIC_EVIL or PALADIN_EVIL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:da5e5279-4965-8388-a7a0-c5ff99ae2b1e
msgctxt "h762dee16ga949g4647g9da0ge2af38168825"
msgid "I swear, in the name of the Most High."
msgstr "가장 높으신 분의 이름을 걸고 맹세하마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = da5e5279-4965-8388-a7a0-c5ff99ae2b1e
#. HandlePath = TaggedText[10].TagText[0]
#. TagRule: CLERIC
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:da5e5279-4965-8388-a7a0-c5ff99ae2b1e
msgctxt "he55efc5age92fg42b9ga56ag7f1f53fa7169"
msgid "Before you and my god, I swear it."
msgstr "당신과 나의 신 앞에 맹세해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = dad8597c-863b-9ad4-62cf-5d9097dc95e3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Event_CloseDoor = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:dad8597c-863b-9ad4-62cf-5d9097dc95e3
msgctxt "hdd7b7bc2gfc33g40eegbb28g56598ad1229e"
msgid "I'm sorry, I truly am, but I can't let you go."
msgstr "미안해요. 정말 미안해요. 하지만 당신을 내보낼 수는 없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = db19b214-ebd3-3e0f-ae42-d3a909025b5c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Event_NettieTurnsHostile = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:db19b214-ebd3-3e0f-ae42-d3a909025b5c
msgctxt "hde4290cag1099g4590g8739gb2f333a597aa"
msgid "Then I've no choice. I'm sorry."
msgstr "그럼 저에게는 선택지가 없군요. 죄송합니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = dbe4fff5-1827-cf22-f606-6c44e32ebd75
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:dbe4fff5-1827-cf22-f606-6c44e32ebd75
msgctxt "he6cb21a4g9f3bg45ffga277g6bf84529b995"
msgid "You're not asking. This is a threat."
msgstr "이건 요청이 아니라, 위협이잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = dce94de5-6f20-204e-e8eb-c42131405186
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:dce94de5-6f20-204e-e8eb-c42131405186
msgctxt "h2743ea28g6b06g4da6ga406g59f008a12ea0"
msgid "You - you're serious. Silvanus' blessings!"
msgstr "당신, 농담 하는 게 아니군요. 실바누스님의 축복이!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = e21a13fd-feb9-c52f-0ac4-b8dd00bf6580
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:e21a13fd-feb9-c52f-0ac4-b8dd00bf6580
msgctxt "hd4493cb7g7068g4e3bg8ea0g2950f65cb993"
msgid "I swear."
msgstr "맹세할게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = e31d36a2-340b-0a78-3451-57dce0d1b880
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:e31d36a2-340b-0a78-3451-57dce0d1b880
msgctxt "h477f6e41g572ag4626ga6c6g927b8a83fd10"
msgid ""
"Without him here, the only treatment for an illithid tadpole is death. "
"You're a risk to the people around you."
msgstr "그가 이곳에 없는 이상, 일리시드 올챙이를 치료할 수 있는 유일한 방법은 죽음뿐이에요. 당신은 주변 사람들에게 위험해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = e3b07584-a9df-9ada-7b6c-5c283dc82f3d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:e3b07584-a9df-9ada-7b6c-5c283dc82f3d
msgctxt "hecec6f7eg1aedg4ddbgb00fgd8876795cb81"
msgid "I'll unlock the door, but I have one condition."
msgstr "문을 열어 드리는 대신, 조건이 하나 있어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = e437cbb7-8002-2885-c11f-80b19d62a9af
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_Cyanide_ShortPath(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:e437cbb7-8002-2885-c11f-80b19d62a9af
msgctxt "h38c83afcg96cag4eb2g9469g8d5a448865ec"
msgid "But you seem like a good soul. You deserve a chance to save yourself."
msgstr "하지만 당신은 선한 영혼인 것 같아요. 스스로를 구할 기회를 가질 자격이 있어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = e4a47ccd-2fb8-560c-5464-4540d2865e98
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 10
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_Cyanide_Intimidate1(1) = True
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_Cyanide_Intimidate2(1) = True
#. TagRule: REALLY_GALE or SORCERER or WARLOCK or WIZARD
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:e4a47ccd-2fb8-560c-5464-4540d2865e98
msgctxt "h52b9f24bg99c5g4fc8g9eeeg262c4a46f070"
msgid "Magic can cure me if you can't. I know the Weave well!"
msgstr "당신이 할 수 없다면, 마법이 날 치유할 수 있을 거야. 난 위브를 아주 잘 알거든!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = e4c9065d-d9dc-8820-46bb-c75bdbf2fb77
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:e4c9065d-d9dc-8820-46bb-c75bdbf2fb77
msgctxt "h58b47ff3g33c4g4797g8dcdg408be8e70173"
msgid "What do you want me to do?"
msgstr "내가 무엇을 하길 원하지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Narrator
#. NodeID = e5c46fef-838e-1275-b4f6-5d301ca9dc93
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_Event_ApplyPoison(1) = True
#.   Quest:
#.     - GLO_Tadpole_SUB_Apprentice.PoisonedByApprentice(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:e5c46fef-838e-1275-b4f6-5d301ca9dc93
msgctxt "ha6f72744gc8ddg4323g8d68gdb4fa7ef6609"
msgid "*You try to dodge her blow, but she catches you, scratching your hand.*"
msgstr "*당신은 그녀의 공격을 피하려고 하지만, 그녀는 당신을 붙잡고 손을 긁습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = e6105783-5706-32fd-0a1a-ecd8f9243a88
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:e6105783-5706-32fd-0a1a-ecd8f9243a88
msgctxt "h8b690ff9g1446g4b64g96fcg188aafdacdb9"
msgid "<i>Hold out your arm.</i>"
msgstr "<i>팔을 내민다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = e6d6910a-bc45-8d7c-def4-f44a8830f3ac
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = True
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_Cyanide_Intimidate1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:e6d6910a-bc45-8d7c-def4-f44a8830f3ac
msgctxt "hd74e9a52gdd87g4a18gaf5fgf7c0a723b5b7"
msgid ""
"<i>Try to recall the tenets of her order - no druid could support this!</i>"
msgstr "<i>그녀가 속한 단체의 교리를 기억하려고 노력한다 - 어떤 드루이드도 이를 지지할 수는 없다!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = e72585f2-f630-fd2a-ddfb-edc07ca1e23b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:e72585f2-f630-fd2a-ddfb-edc07ca1e23b
msgctxt "h2087372ag5c0dg423dgac65ge4d0d17cab9c"
msgid ""
"You can't cure what you don't understand. And as much as I know about mind "
"flayers, I can't make heads nor tails of this."
msgstr ""
"당신이 이해하지 못하는 것을 치료할 수는 없어요. 그리고 저는 마인드 플레이어에 대해 알고 있지만, 이 문제에 대해서는 머리와 꼬리도 "
"구분할 수 없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = e76988bc-4ac1-6268-34e9-19eb0eb9e5c5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:e76988bc-4ac1-6268-34e9-19eb0eb9e5c5
msgctxt "hb296031eg3ad8g4bd6g828egc33b2ac45b77"
msgid ""
"How'd you pick up the parasite? Halsin was desperate to find where all this "
"was happening."
msgstr "기생충을 어떻게 들이게 되었나요? 할신 님은 이 모든 일이 어디에서 벌어지고 있는지 알아내기 위해 필사적이셨어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = e8c4ed4c-ba01-2096-2827-161eb8cb9d2c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - GLO_Tadpole_SUB_Druid.LearnedResearchHalsin(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:e8c4ed4c-ba01-2096-2827-161eb8cb9d2c
msgctxt "h244a7604g63adg4d06gb9b8ga836b80361e6"
msgid "Same as the drow... But Master Halsin said he'd turn eventually."
msgstr "이 드로우와 같군요... 마스터 할신은 그가 결국엔 변이했다고 하셨어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = ea70d2d7-6896-15cb-1d5c-e9934015105e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Event_NettieTurnsHostile = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:ea70d2d7-6896-15cb-1d5c-e9934015105e
msgctxt "hf747d41bg87acg45e6g8456g662319e4bb4e"
msgid "<i>Attack her first - kill her quickly.</i>"
msgstr "<i>먼저 그녀를 공격한다 - 그녀를 신속히 죽인다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = ea8fb30b-9f68-40cf-f698-f25a8e9e9ab5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:ea8fb30b-9f68-40cf-f698-f25a8e9e9ab5
msgctxt "h82adea27g89adg46a6g8778ge439eadf9cd9"
msgid ""
"The thing in your skull, though? It's different to anything in our records."
msgstr "그런데 당신 머릿속에 있는 것은요? 우리 기록상의 어떠한 것과도 달라요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = eaa88b5e-efc4-bc90-ab0f-ec56b8a77113
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. TagRule: FIGHTER or MONK
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:eaa88b5e-efc4-bc90-ab0f-ec56b8a77113
msgctxt "h02541cd2g2198g418fg9a77g18d8319f45a7"
msgid ""
"I'm trained in combat, you're a druid with a stick. Don't make me kill you."
msgstr "나는 숙련된 전사고, 너는 막대기를 든 드루이드일 뿐이지. 너를 죽이고 싶진 않은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = ebf45504-d55c-7f2b-05f3-df80de863c50
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:ebf45504-d55c-7f2b-05f3-df80de863c50
msgctxt "hc343021eg7518g4e13gb56bg95ac6dad8688"
msgid ""
"I understand you're angry, I really do, but I won't let you endanger these "
"people."
msgstr "화가 난 거 이해해요. 정말이에요. 하지만 이 사람들을 위험에 처하게 할 수 없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = ef20594f-25e1-98ae-6ff1-fded70852e7b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:ef20594f-25e1-98ae-6ff1-fded70852e7b
msgctxt "h8ac8cd01gd6c9g4a29gbc9dg31abfb9c7246"
msgid "Is there an antidote?"
msgstr "해독제가 있나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Narrator
#. NodeID = f17d6292-4366-17f2-a78a-7a77aa4049fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:f17d6292-4366-17f2-a78a-7a77aa4049fc
msgctxt "h9d19ca45g19e3g4807g88b8g02be1fedbe6b"
msgid ""
"*You try to find a clue among the thorns, but there's nothing. You have no "
"idea what poison's tainted your veins.*"
msgstr ""
"*당신은 가시에 대해 아는 것을 떠올려 보려 하지만 도저히 생각이 나지 않습니다. 혈관에 어떤 독이 침투했는지 짐작도 가지 않는군요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = f24856e6-ffab-62ee-5840-ec2856a927f0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 96fcd78d-a71b-fe26-84bd-c0f59a85b60f_ToldFoundHalsin = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:f24856e6-ffab-62ee-5840-ec2856a927f0
msgctxt "h264a4980ga946g4679g8f67g8cb9df8b7502"
msgid "All right, I'll save Halsin."
msgstr "좋아, 내가 할신을 구해올게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = f34a35e3-afc0-0e23-a792-b76c0db0beea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:f34a35e3-afc0-0e23-a792-b76c0db0beea
msgctxt "h623861d3gd83ag4fdfgb909g9e23ebbe9abb"
msgid ""
"You're not getting out of here. I'll do whatever I have to to protect my kin."
msgstr "당신은 여기서 나갈 수 없어요. 저는 제 동족을 지키기 위해 뭐든 할 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = f3d0e34f-0670-fbe8-8d82-19b03f606900
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:f3d0e34f-0670-fbe8-8d82-19b03f606900
msgctxt "h3bc46edeg8f6bg49d1gbc75g14544321a79a"
msgid "Give me the antidote. I know you have one."
msgstr "나에게 해독제를 줘. 네가 갖고 있다는 거 알고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = f460ed69-c41f-2e7b-5b94-ed59099e7e66
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_Cyanide_Deceive1(1) = False
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_Cyanide_Deceive1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:f460ed69-c41f-2e7b-5b94-ed59099e7e66
msgctxt "hf6d11076g4826g4fb5g8c07g89690084aa49"
msgid "You can't do this - your leader needs to talk to me."
msgstr "이러면 안 돼. 너의 지도자가 나와 이야기해야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = f4803d64-e7ed-9873-f7ba-90debb6596ee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:f4803d64-e7ed-9873-f7ba-90debb6596ee
msgctxt "hcb92d5b8gf0a0g4c2bgb2e7gfba39349365f"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = f55f9d2c-2c01-3285-a7ea-8548b3f59a2d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Event_CheckOtherPlayers = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:f55f9d2c-2c01-3285-a7ea-8548b3f59a2d
msgctxt "h1d6a1504g75d3g4e83gbf3eg03aecc9a39ba"
msgid "Give me your arm, please."
msgstr "제게 팔을 주세요, 부탁이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = f5b7e895-8ee7-c1ba-90ee-3098ae39e4c2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_Event_GiveWyvenPoison(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:f5b7e895-8ee7-c1ba-90ee-3098ae39e4c2
msgctxt "h03e76097ge080g47d3gb5fag690930cf3b0f"
msgid "Otherwise, that vial's your only option."
msgstr "그 외엔, 그 독만이 당신의 유일한 선택지예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = f5e68f29-55a0-b352-4798-23d577e32557
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:f5e68f29-55a0-b352-4798-23d577e32557
msgctxt "h4f38b3beg4e2fg4799gb00agd440987ee82b"
msgid ""
"Hard to say, but there's a lot we don't know. Infected - folks like you - "
"have been converging on an old temple of Selûne, and I've no idea why."
msgstr ""
"말하기 어렵네요. 우리가 모르는 게 너무 많아요. 당신 같은 감염자들이 오래된 셀루네의 신전에 모여들고 있는데, 그 이유를 모르겠어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = f5f46ba6-2759-323b-347c-b2ce0db08444
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:f5f46ba6-2759-323b-347c-b2ce0db08444
msgctxt "h5b2d4212gd988g4fdbg83b2gd740c7ac965e"
msgid ""
"It's one of their worms, for sure, but this one gives you powers - "
"telepathic connections. And it doesn't turn you into one of them."
msgstr ""
"물론 이것도 그들의 벌레 중 하나겠지만, 이 벌레는 당신에게 텔레파시 연결이라는 강력한 능력을 제공해요. 그리고 당신을 그들 중 하나로 "
"바꾸지 않고 있어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = f6621824-cf45-e0f5-6805-69b2cab947b5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:f6621824-cf45-e0f5-6805-69b2cab947b5
msgctxt "hdb57d4ceg499dg44begaa74gf5327089c086"
msgid "You can't have it. I can't risk you turning - you'd kill us all."
msgstr "당신에게 드릴 수는 없어요. 저는 당신이 변이해서 모두를 죽이는 위험을 감수할 수 없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = f69746df-58ef-dfa7-a7ce-58a451ecac4b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:f69746df-58ef-dfa7-a7ce-58a451ecac4b
msgctxt "h7b607784g1592g46fbg9493g87abe25f233f"
msgid "Seems so. Gave Master Halsin a right start."
msgstr "그런 것 같아요. 마스터 할신께서 제대로 놀랐죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = f71bbe9d-2924-2adb-795c-ac3c58c14870
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 15
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_Cyanide_Persuade1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:f71bbe9d-2924-2adb-795c-ac3c58c14870
msgctxt "h648b3868g00f2g40e3gab6fgd47f5b07c533"
msgid "But I don't have symptoms - I'm not changing."
msgstr "하지만 나는 증상이 없어. 변이하고 있지 않다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = f75c9820-5903-0d20-fc53-160273b9d2dc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_Event_GiveWyvenPoison(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:f75c9820-5903-0d20-fc53-160273b9d2dc
msgctxt "h10276f20g1317g4736gaf34g665b4d57e31d"
msgid ""
"Otherwise you'll need to end things yourself, before the transformation "
"really takes hold."
msgstr "그렇지 않으면, 변이가 확실히 진행되기 전에 스스로 목숨을 끊어야만 할 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = f7f1262f-b8bb-b66b-537a-05fcd792e94d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:f7f1262f-b8bb-b66b-537a-05fcd792e94d
msgctxt "h9a29866age6d0g4943g85f9g768f8d511df6"
msgid "Now, do I have your word or not?"
msgstr "이제 약속을 해주시겠어요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = f8f0a440-c794-7049-961f-12390e5b84c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:f8f0a440-c794-7049-961f-12390e5b84c6
msgctxt "he181fff6gc1ccg4005gb435g96b6466e798d"
msgid "<i>Walk away.</i>"
msgstr "<i>떠납니다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Nettie
#. NodeID = fa165e8d-afcb-029a-3b2e-d7e6ff65ecba
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_HasAntidote(0) = True
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Knows_AntidoteLocation = True
#.   Object:
#.     - ORI_Gale_State_NettieGaveAntidote(1) = True
#.     - DEN_Apprentice_Event_Gale_GotAntidoteApproval(1) = True
#.     - DEN_Apprentice_Event_GiveAntidote(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:fa165e8d-afcb-029a-3b2e-d7e6ff65ecba
msgctxt "h4c21e65bge986g4361gb85cga986102c8c71"
msgid "And here's the antidote. Do not mix those two up."
msgstr "그리고 여기 해독제예요. 두 개를 혼동하지는 마세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = fe545687-4943-97fc-a8b0-cbce91ecd829
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Intelligence
#. DifficultyClass: 10
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_Cyanide_Intimidate1(1) = True
#.      - DEN_Apprentice_State_Cyanide_Intimidate2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:fe545687-4943-97fc-a8b0-cbce91ecd829
msgctxt "h1df7b4bdgfe77g46ebga488gc0eaa19c5196"
msgid ""
"You said there were others like me - we <i>need </i>to cure this, or your "
"kin will never be safe."
msgstr "나같은 사람이 더 있다고 했지. 우린 이걸 <i>치료해야만 해</i>, 아니면 당신들 중 누구도 안전을 보장할 수 없을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide
#. Speaker = Player
#. NodeID = fec247bf-2727-f7e8-1f3c-bec4efea2ae9
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 10
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_Cyanide_Persuade1(1) = False
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_Cyanide_Persuade1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Cyanide:fec247bf-2727-f7e8-1f3c-bec4efea2ae9
msgctxt "hb2231b99g847bg4971gb1ecgc28a50fbfc03"
msgid "But I'm safe - I'm not showing symptoms, and it's been days."
msgstr "하지만 나는 안전해 - 며칠째 증상을 보이지 않고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_HealedBird
#. Speaker = Wounded Bird
#. NodeID = 69c36eb7-6251-4d8e-8ad9-de96464cb571
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Apprentice_HasMet_WoundedBirdVictory(1) = False
#.   Global:
#.      - DEN_AttackOnDen_Event_Start = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Apprentice_HasMet_WoundedBirdVictory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_HealedBird:69c36eb7-6251-4d8e-8ad9-de96464cb571
msgctxt "h68a565e7g7d2fg4190g9ca2g74882393590d"
msgid "There was so much noise out there. I'm glad you're okay."
msgstr "저 밖은 너무 시끄럽군. 네가 무사해서 다행이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_HealedBird
#. Speaker = Wounded Bird
#. NodeID = 85352a36-3ab3-495c-b012-caafb080225d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_HealedBird:85352a36-3ab3-495c-b012-caafb080225d
msgctxt "hab64f883g43beg4b7eg9d58g65a705ee430c"
msgid "*Chirp!*"
msgstr "*짹짹!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_HealedBird
#. Speaker = Wounded Bird
#. NodeID = 93379be8-cb37-4eaf-9d80-fba5a3ddb7c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_HealedBird:93379be8-cb37-4eaf-9d80-fba5a3ddb7c4
msgctxt "h76c70f5fg8262g435cgb6d9g9161bf22828a"
msgid "Wing's still a little stiff, but I'm getting stronger!"
msgstr "날개가 아직 뻣뻣하지만 점점 나아지고 있어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = 014a51e2-d2bd-4220-a29a-e847991aa7ce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:014a51e2-d2bd-4220-a29a-e847991aa7ce
msgctxt "hdc6f37e2g3207g4295g92efg975c07c92986"
msgid ""
"If it helps, she won't feel any pain. It's the best death I can give her."
msgstr "효력이 있다면, 더 고통을 느끼진 않을 거야. 그게 내가 줄 수 있는 최선의 죽음이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = 02dbc5d2-a417-4edb-a85c-9ccb8f7dae41
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_HasWyvernPoison(0) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Apprentice_State_TookPoison(1) = True
#.   Global:
#.     - DEN_Apprentice_Quest_TookPoison = True
#.     - DEN_Apprentice_Event_OpenDoor = True
#.   Object:
#.     - DEN_Apprentice_Event_GiveWyvenPoison(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:02dbc5d2-a417-4edb-a85c-9ccb8f7dae41
msgctxt "hc2a40c5cgf0dbg432bgb475g3a2befb68064"
msgid "I hope it doesn't come to that but... thank you. Here."
msgstr "그런 일이 오지 않기를 바라지만... 고마워요. 여기 있어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Player
#. NodeID = 04173a7c-2310-4837-bc81-6ae0f1731ba6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:04173a7c-2310-4837-bc81-6ae0f1731ba6
msgctxt "h7c50a9a6g3bfbg4524g9122gd176ead2904b"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = 0570a6cc-efed-2a22-1683-97d24eb508f7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_Cyanide_AntidotePickpocketed(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:0570a6cc-efed-2a22-1683-97d24eb508f7
msgctxt "hc65bc4e7g759fg4c3dga441g3991b2c9d6ff"
msgid ""
"I've spent my life treating folk and never once saw a mind flayer infection. "
"Then suddenly there's dozens of you - maybe more."
msgstr ""
"저는 평생 사람들을 치료해왔지만 한 번도 마인드 플레이어 감염을 본 적이 없어요. 그런데 갑자기 수십 명, 어쩌면 그 이상의 감염자가 "
"나타났다고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = 060777b4-8c2d-462d-909b-1d5a28eda18a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:060777b4-8c2d-462d-909b-1d5a28eda18a
msgctxt "h4918dcedgd90fg4066g9025gb759d2bc85e0"
msgid "<i>Swear it.</i>"
msgstr "<i>맹세하세요.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = 08f81daf-493d-408a-84e3-03ddb889b91d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   User:
#.     - DEN_Apprentice_State_Cyanide_Persuaded(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:08f81daf-493d-408a-84e3-03ddb889b91d
msgctxt "h024be13fg4d2ag4518ga456g154f2ebc9453"
msgid ""
"All right! Master Halsin thought the tadpole was dormant, so you have some "
"time. Perhaps it's only fair I let you use it."
msgstr ""
"그래요! 마스터 할신은 이 드로우의 올챙이가 휴면기에 있었다고 하셨어요. 그러니 당신에게 시간이 있어요. 아마 당신에게 이걸 사용하게 "
"하는 것만이 타당할 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Player
#. NodeID = 09983b05-c0e4-40e6-b8bc-6ad6c8602846
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_Cyanide_Deceive1(1) = True
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_Cyanide_Deceive2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:09983b05-c0e4-40e6-b8bc-6ad6c8602846
msgctxt "h431c6a6bg2f19g44c2ga10ag9bac5ba97964"
msgid ""
"The grove is in terrible danger - cure me and I'll tell your leader how to "
"save it."
msgstr "숲에 끔찍한 위기가 닥쳐올 거야. 나를 치료해주면 너희 우두머리에게 대책을 알려줄게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = 0c2c8799-972d-8e6e-b38f-a2a3dbbdca0d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:0c2c8799-972d-8e6e-b38f-a2a3dbbdca0d
msgctxt "haab285abg2055g4d5eg8ef3gdebb89023b93"
msgid ""
"Could be, but there's a lot we don't know. Infected - folks like you - have "
"been converging on an old temple of Selûne, and I've no idea why."
msgstr ""
"그럴 수도 있지만, 우리가 모르는 게 많아요. 당신과 같은 감염자들이 오래된 셀루네의 신전에 모여들고 있는데, 그 이유를 모르겠어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Player
#. NodeID = 0ea0b9b8-9f2f-70e3-84f2-9f1a0b48e53a
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 10
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_Cyanide_Intimidate1(1) = True
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_Cyanide_Intimidate2(1) = True
#. TagRule: REALLY_GALE or SORCERER or WARLOCK or WIZARD
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:0ea0b9b8-9f2f-70e3-84f2-9f1a0b48e53a
msgctxt "hb9a00ddeg9306g413fgadb3gd6fa0b5466ac"
msgid "Magic can cure me if you can't. I know the Weave well!"
msgstr "당신이 할 수 없다면, 마법이 날 치유할 수 있을 거야. 난 위브를 아주 잘 알거든!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = 17ea6897-6a30-6134-ace9-6661fc82f256
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:17ea6897-6a30-6134-ace9-6661fc82f256
msgctxt "he1676e82ga78cg4d4bgb1e7g511cbf68c479"
msgid ""
"I think so. I hope so. I've sent birds to find him, but they can't get close "
"without goblins trying to shoot them down."
msgstr ""
"그렇게 생각해요. 그렇게 바라고요. 제가 새들을 보내 그를 찾으려 해봤지만, 고블린들이 사격해 떨어뜨리려고 해서 그들이 가까이 갈 수 "
"없었어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = 19160c27-a27c-7629-cce1-52f03689af71
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_Event_GiveWyvenPoison(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:19160c27-a27c-7629-cce1-52f03689af71
msgctxt "h7faaa4b3ge821g4c41g8606g71856de74915"
msgid ""
"Good luck out there. And if things start to go bad - remember the vial. "
"Remember your oath."
msgstr "바깥에서의 행운을 빌어요. 그리고 상황이 나빠지기 시작하면, 독을 기억하세요. 당신의 약속을요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = 19c46c70-97b6-7982-17e3-bb47d7d31992
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Apprentice_State_HostileToTadpoled = False
#.   Object:
#.      - DEN_Apprentice_Event_RevealedTadpole(1) = False
#.      - DEN_Apprentice_State_HasGenderNeutralTadpoled(0) = True
#.   User:
#.      - DEN_Apprentice_State_Cyanide_Persuaded(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:19c46c70-97b6-7982-17e3-bb47d7d31992
msgctxt "h0f360001ga83ag44e8g93e5gbda3e78320c1"
msgid "I hope your friend sees sense soon. They don't have much time left."
msgstr "당신의 친구가 이성을 되찾길 바라요. 시간이 얼마 없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Player
#. NodeID = 1d97202c-c244-a409-f558-9ae517894291
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:1d97202c-c244-a409-f558-9ae517894291
msgctxt "h64b4aedfg0aedg4e23gbc57g62d9a2f912f7"
msgid "It sounds like you're making a lot of assumptions that could kill me."
msgstr "증거도 없는 네 가정에 내 목숨을 걸라는 말로 들려."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Player
#. NodeID = 1db688e2-83af-441d-829f-f02ee43fc8f6
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 10
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_Cyanide_Intimidate1(1) = True
#.   Tag:
#.      - SORCERER(1) = False
#.      - WARLOCK(1) = False
#.      - WIZARD(1) = False
#.      - REALLY_GALE(1) = False
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_Cyanide_Intimidate2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:1db688e2-83af-441d-829f-f02ee43fc8f6
msgctxt "h1c944ae9g3973g4d66ga294g8df5b0eda240"
msgid "Magic can cure me if you can't. I know the Weave well!"
msgstr "당신이 할 수 없다면, 마법이 날 치유할 수 있을 거야. 난 위브를 아주 잘 알거든!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = 2386b626-ba73-4e0e-b2aa-001a4b869d57
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:2386b626-ba73-4e0e-b2aa-001a4b869d57
msgctxt "h97f20a44g57b0g400fgb9afg7f33eded6550"
msgid "Then we've nothing more to talk about."
msgstr "그렇다면 더 이상 논할 이야기가 없겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Player
#. NodeID = 252079e8-a604-4051-90c3-c83fddf1a9af
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:252079e8-a604-4051-90c3-c83fddf1a9af
msgctxt "hd28a4cd5gaa51g4718g9f0cgbd2983dc8360"
msgid "By my sacred oath, I swear it."
msgstr "내 신성한 서약에 걸고, 맹세하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Player
#. NodeID = 25fd7836-8abf-381a-f681-d7586cf8a909
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:25fd7836-8abf-381a-f681-d7586cf8a909
msgctxt "h2a6537d0g03beg4028gba85gb4f5d1fb873e"
msgid "Just tell me if there's a cure or not."
msgstr "치료제가 있는지 없는지나 말해 줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = 26974251-85b9-47d5-3346-a8ad1ad6721d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Knows_StudiedTadpole = True
#.   Quest:
#.     - GLO_Tadpole_SUB_Druid.LearnedResearchHalsin(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:26974251-85b9-47d5-3346-a8ad1ad6721d
msgctxt "h57f970c0gf1acg433cg820dgbac9503137ec"
msgid ""
"Because you should all be changing - there should be a small army of mind "
"flayers out there! But you're not. Weird powers aside, you seem perfectly "
"normal."
msgstr ""
"원래대로라면 당신들 모두 진작에 변이했어야만 해요. 지금쯤이면 저 밖에 소규모 마인드 플레이어 군대가 있어야 한다고요! 그런데 변이하지 "
"않고 있죠. 기묘한 능력을 제외하면 지극히 정상이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Player
#. NodeID = 27f8f72b-1dee-cb61-5632-fd21554ab543
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_IsFound = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:27f8f72b-1dee-cb61-5632-fd21554ab543
msgctxt "hde4483afg24c8g4c28gb08eg7a9dfd08105d"
msgid "All right, I'll find Halsin."
msgstr "좋아, 내가 할신을 찾지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = 2ad0d055-00c4-4343-a79a-d98e3703c3f8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_HasWyvernPoison(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:2ad0d055-00c4-4343-a79a-d98e3703c3f8
msgctxt "ha8a73370g8fadg44e4ga6d5g0a9be5cb7457"
msgid ""
"I want to help, but I can't. Not until I know she'll take the wyvern poison "
"if she starts to change."
msgstr "돕고 싶지만, 그럴 수 없어요. 그녀가 변이하기 시작하면 와이번 독을 복용하겠다고 확신하는 게 아니라면요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = 2af2c377-1f17-4a13-a9ba-636f0443761f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Apprentice_State_HostileToTadpoled = False
#.   Object:
#.      - DEN_Apprentice_State_HasMaleTadpoled(0) = True
#.      - DEN_Apprentice_Event_RevealedTadpole(1) = False
#.   User:
#.      - DEN_Apprentice_State_Cyanide_Persuaded(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:2af2c377-1f17-4a13-a9ba-636f0443761f
msgctxt "h2eafe167g5b4eg406bga040g7983a511df59"
msgid "I hope your friend sees sense soon. He doesn't have much time left."
msgstr "당신 친구가 이성적인 선택을 하길 바라요. 그에겐 시간이 얼마 남지 않았거든요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = 2b43a923-6415-fe24-0218-d9a61a7b3936
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_Event_GiveWyvenPoison(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:2b43a923-6415-fe24-0218-d9a61a7b3936
msgctxt "h7641471bg78cdg4ae5g9352g153fbba6e1fb"
msgid "The way I see it, you have two options: Halsin or that wyvern poison."
msgstr "제가 봤을 때, 당신에게는 두 가지 선택지가 있어요. 할신 아니면 그 와이번 독이죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = 2e936ad7-d050-48ce-9086-3647f878ea12
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Event_NettieTurnsHostile = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:2e936ad7-d050-48ce-9086-3647f878ea12
msgctxt "hb0a013edg97b1g415agb5e7g3c6e36c4754b"
msgid "I'm sorry. I'm so sorry."
msgstr "죄송해요. 정말 죄송해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = 32bfa315-70c6-d6af-ca06-cb735d933832
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:32bfa315-70c6-d6af-ca06-cb735d933832
msgctxt "hd0601b7dg577cg4727g95afg1d8e336a2671"
msgid ""
"For one, that thing in your head is like nothing we've ever seen from mind "
"flayers."
msgstr "우선, 당신 머릿속에 있는 것은 지금까지 우리가 마인드 플레이어에게서 본 적이 없는 것이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Player
#. NodeID = 358e4b59-4843-e5ff-6f75-6eb0f3244da2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:358e4b59-4843-e5ff-6f75-6eb0f3244da2
msgctxt "h78081aa6g7afdg4f14gb4c6gb0853086ba30"
msgid "So you think it's only a matter of time?"
msgstr "그렇다면 단지 시간 문제라고 생각하는 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Player
#. NodeID = 37616563-1947-575b-2a83-8dcfde989f13
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 10
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_Cyanide_FailedToPersuadeNettie(1) = False
#.   Tag:
#.      - DRUID(1) = True
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_Cyanide_Intimidate1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:37616563-1947-575b-2a83-8dcfde989f13
msgctxt "h297301dcga24eg48c7ga59eg75ccfba21fca"
msgid ""
"<i>Try to recall the tenets of her order - no druid could support this!</i>"
msgstr "<i>그녀가 속한 단체의 교리를 기억하려고 노력한다 - 어떤 드루이드도 이를 지지할 수는 없다!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = 3c7f3fcb-1faf-fee3-69e8-653d043cb535
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:3c7f3fcb-1faf-fee3-69e8-653d043cb535
msgctxt "h2f4d0244g1828g4204gb53dg954e63c5bc74"
msgid ""
"I want to help, but I can't. Not until I know he'll do what has to be done, "
"if it comes to that."
msgstr "도와드리고 싶지만, 그럴 수 없어요. 최악의 상황이 온다면, 그가 반드시 필요한 일을 할 거란 확신이 들 때까지는요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Player
#. NodeID = 40379bd5-a09c-4935-896c-654e4d61eb68
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - DEN_DruidLair_State_UnderstoodTwoFrescos = False
#.   Object:
#.      - DEN_Apprentice_State_Cyanide_FailedToPersuadeNettie(1) = False
#.   Tag:
#.      - DRUID(1) = False
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_Cyanide_Intimidate1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:40379bd5-a09c-4935-896c-654e4d61eb68
msgctxt "hda5c6b15g7dabg4ba0gabadg1615eb64899f"
msgid "<i>Try to recall the tenets of her order - she can't support this!</i>"
msgstr "<i>그녀가 속한 단체의 교리를 기억해본다 - 그녀는 이런 일을 지지할 수 없다!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Player
#. NodeID = 403cc46d-5546-24e5-5e44-8261870b1c80
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:403cc46d-5546-24e5-5e44-8261870b1c80
msgctxt "h30e3e9c8g4c17g4ac2gb6edge23d05a1a8d1"
msgid "You're sure he can cure me?"
msgstr "그가 나를 치료할 수 있다는 건 확실해?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = 41367937-94ea-440b-a214-ecb5315bdb6b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_HasWyvernPoison(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:41367937-94ea-440b-a214-ecb5315bdb6b
msgctxt "h98910ad6g781dg4381g9363g0c33a84aaed1"
msgid ""
"I want to help, but I can't. Not until I know he'll take the wyvern poison "
"if he starts to change."
msgstr "돕고 싶지만 그럴 수 없어요. 변이가 시작되면 와이번 독을 마신다고 맹세하기 전까진요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Player
#. NodeID = 443c7999-2d1f-4992-bf64-aec270f3916f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:443c7999-2d1f-4992-bf64-aec270f3916f
msgctxt "h1a8f8a3ag2bc7g49c7ga8c0gacd672be95d2"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = 453336d0-1673-dd24-b23e-3a97142fdd58
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:453336d0-1673-dd24-b23e-3a97142fdd58
msgctxt "h159425dbg884eg401cg8e60g44773506fa5e"
msgid ""
"You can't cure what you don't understand. And as much as I know about mind "
"flayers, I can't make heads nor tails of this."
msgstr ""
"당신이 이해하지 못하는 것을 치료할 수는 없어요. 그리고 저는 마인드 플레이어에 대해 알고 있지만, 이 문제에 대해서는 머리와 꼬리도 "
"구분할 수 없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = 47e62c4e-8c0e-5989-e596-fd9c095cce4e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_CuredEarly(1) = False
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Knows_AntidoteLocation = True
#.   Object:
#.     - ORI_Gale_State_NettieGaveAntidote(1) = True
#.     - DEN_Apprentice_Event_Gale_GotAntidoteApproval(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:47e62c4e-8c0e-5989-e596-fd9c095cce4e
msgctxt "hbd1b8838g17edg4fa8g8c6fge18f52d7e7cc"
msgid ""
"Well, not to worry. Have a read of that book - <i>Flora of the Dalelands</"
"i>. There's a recipe for your antidote in there. It won't do anything for "
"what's in your skull, though."
msgstr ""
"음, 걱정 마세요. 방법이 있으니까요. <i>데일랜드의 식생</i>이라는 책을 찾아보세요. 거기 해독제 제조법이 있을 거예요. 머릿속에 "
"있는 녀석을 해결하는데는 도움이 되지 않겠지만요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = 4a03562c-ecae-80c9-e7fc-133f552637a9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_Event_GiveWyvenPoison(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:4a03562c-ecae-80c9-e7fc-133f552637a9
msgctxt "hbfeb39ebgd88ag40a7ga219gb77226d67875"
msgid ""
"Otherwise you'll need to end things yourself, before the transformation "
"really takes hold."
msgstr "상황이 잘 풀리지 않는다면, 변이가 완전히 시작하기 전에 당신이 직접 마무리를 지어야 해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = 4d15d1cc-5eb6-7fcb-3e4a-544b273b9a7d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Quest_FindHalsin = True
#.     - DEN_Apprentice_Event_OpenDoor = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:4d15d1cc-5eb6-7fcb-3e4a-544b273b9a7d
msgctxt "hca20033egcc48g4543ga9e2g35bf17478c9b"
msgid ""
"Master Halsin and I were tracking them, studying them, trying to figure out "
"what the hells was going on."
msgstr "마스터 할신과 저는 그들을 추적하고, 연구해서, 도대체 무슨 일이 벌어지고 있는지 알아내려고 노력하고 있었어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = 52815a0c-38e5-4725-a175-c83c5e7b2e33
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:52815a0c-38e5-4725-a175-c83c5e7b2e33
msgctxt "h621ddb9agd699g4bfag8271gff566fef18a8"
msgid "I don't envy your choice, truly. But this is the hand fate's dealt you."
msgstr "전 당신의 선택에 불만을 갖지 않겠어요. 정말로요. 하지만 이건 운명이 당신에게 내민 손이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = 544b0ed1-a644-4e62-9631-f0872c2eb857
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:544b0ed1-a644-4e62-9631-f0872c2eb857
msgctxt "hd69e6d2bg49a6g4192gacb3g51de3ad95fea"
msgid "The door's locked. Neither of us are leaving until this is done."
msgstr "문은 잠겼어요. 이 일이 마무리되기 전까진 누구도 떠날 수 없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = 5582e73b-eea4-1f86-be6b-0aea67ca84e2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_Cyanide_WarnedOfOptions(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:5582e73b-eea4-1f86-be6b-0aea67ca84e2
msgctxt "hb67ad051g657fg4fa5g91feg4d50f90a79d3"
msgid ""
"But I know this for sure: Master Halsin is the only one close to "
"understanding these things. He's your best bet to survive."
msgstr ""
"하지만 한 가지는 확신해요. 마스터 할신만이 모든 것을 이해할 수 있는 유일한 분이라는 것입니다. 그가 당신이 살아남을 수 있는 최선의 "
"방법이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Player
#. NodeID = 55b7b2d4-d808-f847-8800-d9ecd01a1100
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 10
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_Cyanide_Intimidate1(1) = False
#.   Tag:
#.      - DRUID(1) = True
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_Cyanide_Intimidate1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:55b7b2d4-d808-f847-8800-d9ecd01a1100
msgctxt "h52dec80eg49c4g41ffg96edgffe243ef1f25"
msgid "<i>Recite her order's druidic law - this can't be allowed!</i>"
msgstr "<i>그녀가 속한 단체의 드루이드 율법을 열거하듯 말한다 - 이런 일은 용납될 수 없다!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = 5777e69e-6d97-dade-d94c-e94782127c00
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:5777e69e-6d97-dade-d94c-e94782127c00
msgctxt "h526c3507g9e4fg4ff2g93bbg04bc75088321"
msgid ""
"It's one of their worms, for sure, but this one gives you powers - "
"telepathic connections. And it doesn't turn you into one of them."
msgstr ""
"물론 이것도 그들의 벌레 중 하나겠지만, 이 벌레는 당신에게 텔레파시 연결이라는 강력한 능력을 제공해요. 그리고 당신을 그들 중 하나로 "
"바꾸지 않고 있어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = 59edf8bc-cff6-340b-0779-58c2bee8b8ac
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Knows_WentWithAdventurers = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:59edf8bc-cff6-340b-0779-58c2bee8b8ac
msgctxt "he5dd4107gd92fg4943g9e47g90c8e98bcf68"
msgid ""
"All I can say for sure is they all went to the old temple of Selûne and "
"Master Halsin didn't make it back."
msgstr "제가 확실히 말할 수 있는 건 그들이 모두 오래된 셀루네의 신전에 갔고 마스터 할신은 돌아오지 못했다는 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = 5bd3662f-6327-e3fe-b38e-ab3f959a9739
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:5bd3662f-6327-e3fe-b38e-ab3f959a9739
msgctxt "hdce5fcf5g8f1cg4bd3gae52g3ef68dffcc8c"
msgid ""
"It might be suicide either way. Trust me, you do not want to become one of "
"those monsters."
msgstr "어느 쪽이든 자살 행위가 될 거예요. 절 믿어주세요. 당신도 그 괴물들 중 하나가 되고 싶지는 않잖아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Player
#. NodeID = 5ce9f301-93ab-f69e-83ea-fee6620e9fd3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:5ce9f301-93ab-f69e-83ea-fee6620e9fd3
msgctxt "hbb0c0a8bg142fg44ecgb19fg38dbfa60fbcb"
msgid "You must've learned something from studying them."
msgstr "너는 그것들을 연구하면서 뭔가 깨달은 게 있겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = 617d765a-df63-c3a0-0927-fe3e07e3cf35
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_CuredEarly(1) = False
#.      - DEN_Apprentice_State_HasAntidote(0) = True
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Knows_AntidoteLocation = True
#.   Object:
#.     - ORI_Gale_State_NettieGaveAntidote(1) = True
#.     - DEN_Apprentice_Event_Gale_GotAntidoteApproval(1) = True
#.     - DEN_Apprentice_Event_GiveAntidote(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:617d765a-df63-c3a0-0927-fe3e07e3cf35
msgctxt "h6e6d3142g8826g4639g9690g03cb74484fe1"
msgid ""
"Here, take this. It'll stop the poison, but I can't do anything for that "
"wriggler in your head."
msgstr "자, 이거 받으세요. 그 독은 멈추겠지만, 당신 머리속 벌레는 제가 어떻게 할 수 없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = 6690df7c-0771-238b-0b2b-8bd0d25f77bd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_Event_RevealedTadpole(1) = True
#.   User:
#.      - DEN_Apprentice_State_Cyanide_Persuaded(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:6690df7c-0771-238b-0b2b-8bd0d25f77bd
msgctxt "hcbf33d4fg834dg4368g90d4g821efd4cfab8"
msgid "And? Will you swear you'd die before you turn?"
msgstr "그리고요? 변이하기 전에 죽음을 택하겠다고 맹세하실 수 있나요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Player
#. NodeID = 67ab6f51-ec97-4af2-836b-1371a2d48b74
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_CuredEarly(1) = True
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Event_NettieTurnsHostile = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:67ab6f51-ec97-4af2-836b-1371a2d48b74
msgctxt "hbaf214eeg3106g4e4dg88degcdf86fd22735"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Player
#. NodeID = 686e9384-3e85-47e2-a328-f410226bf5af
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 10
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_Cyanide_Persuade1(1) = True
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_Cyanide_Persuade2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:686e9384-3e85-47e2-a328-f410226bf5af
msgctxt "ha7ffd1dcg192eg49a1gbeedgba0a85f4a6bc"
msgid "Eventually? That gives me time to find a cure."
msgstr "결국엔 변했다고? 그럼 그 전에 치료법을 찾을 시간이 있긴 하다는 거군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = 68dd445a-ceac-4f71-b8e4-a8463020d8b2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:68dd445a-ceac-4f71-b8e4-a8463020d8b2
msgctxt "h625c4554gf407g46d6g90eeg3def792c8583"
msgid ""
"I know you're angry, but how many people would die if you changed? I can't "
"take that risk."
msgstr "당신이 화나셨다는 건 알지만, 만약 당신이 변이한다면 얼마나 많은 사람이 죽겠어요? 저는 그 위험을 감수할 수 없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Player
#. NodeID = 69bf28fc-739c-4394-89fe-406f35c56cfc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:69bf28fc-739c-4394-89fe-406f35c56cfc
msgctxt "h82a9a40eg2d59g4df2gb5c7g1fb114fb85f8"
msgid "You think he's still alive?"
msgstr "그가 아직 살아있다고 생각하나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = 6c486dbe-cacf-b166-2377-05ec91c5b761
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_RaidingParty_Event_AdventurersLeave = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:6c486dbe-cacf-b166-2377-05ec91c5b761
msgctxt "h2a3249e7g3107g4eeega034g377f0d7af0df"
msgid ""
"I wish I could tell you what happened out there, but those adventurers were "
"the only witnesses. And they're long gone."
msgstr ""
"바깥에서 무슨 일이 일어났는지 제가 설명해 드릴 수 있다면 좋겠지만, 그 모험가들이 유일한 목격자였어요. 이젠 다 가버린 지 오래고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = 6e24634d-fc2f-7548-4f79-1c9c602b48a6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_Apprentice_State_TookPoison(1) = True
#.   Global:
#.     - DEN_Apprentice_Quest_TookPoison = True
#.     - DEN_Apprentice_Event_OpenDoor = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:6e24634d-fc2f-7548-4f79-1c9c602b48a6
msgctxt "h96cb7009gfa37g43f6g93e5g69c84d260e9f"
msgid "Thank you. I truly hope it doesn't come to that."
msgstr "고마워요. 진심으로 그런 일이 오지 않기를 바라요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = 6fbdf86a-9ff5-8c22-a250-acf80b15f08b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:6fbdf86a-9ff5-8c22-a250-acf80b15f08b
msgctxt "h9f05379ag1d65g4aa4g9debg51125d0dd870"
msgid "Gods above - why didn't you say so?"
msgstr "신이시여, 왜 그건 말하지 않았어요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Player
#. NodeID = 72e0b4e0-ef92-424c-aefe-af36066e8a06
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_State_PermaDefeated = False
#.      - GLO_Halsin_Knows_IsFound = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:72e0b4e0-ef92-424c-aefe-af36066e8a06
msgctxt "h112ddf72g940dg4414g842cg0acd073c9e20"
msgid "I know where Halsin is! Give me the antidote or he'll die too!"
msgstr "할신이 어디 있는지 알아! 나에게 해독제를 주지 않으면 그도 죽을 거야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = 7343c30f-1703-49c6-a4d1-54b7e8470f22
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_Event_RevealedTadpole(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:7343c30f-1703-49c6-a4d1-54b7e8470f22
msgctxt "ha597eea8g2f3fg4b8egb45bg3293ac8d43cc"
msgid "Yes? Is there anything I can do?"
msgstr "네? 제가 도와드릴 일이 있나요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = 768c8935-7a86-1b70-728e-9ad187118ee8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:768c8935-7a86-1b70-728e-9ad187118ee8
msgctxt "h74c9991cga0feg4564gbf9cgcf85f3468a4c"
msgid "Thank you. It would mean everything to the grove. To me."
msgstr "고마워요. 이 일은 이 숲에게 있어 모든 것이에요. 저에게도요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = 76fdc325-3fd5-1bf5-01fe-adc4c1bef7d2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_CuredEarly(1) = False
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_Cyanide_AntidotePickpocketed(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:76fdc325-3fd5-1bf5-01fe-adc4c1bef7d2
msgctxt "h24332904g4a00g4451g8fbfg3aed45c0363c"
msgid "Now, I've an antidote - um... where is the bloody thing?"
msgstr "자, 여기 해독제가, 어... 이 젠장할 것이 어디 갔지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Player
#. NodeID = 7910de79-89e8-0e8b-90e6-fea410a3f160
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:7910de79-89e8-0e8b-90e6-fea410a3f160
msgctxt "he1229e47g5e39g4c3bgb0e5g9be1ea1c9be6"
msgid "That's... good news?"
msgstr "그건... 좋은 소식인가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Player
#. NodeID = 7a55fb02-972f-c450-29ee-5c96549c47ed
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_Cyanide_FailedToPersuadeNettie(1) = True
#.     - DEN_Apprentice_HasMet_PersuasionFailed(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:7a55fb02-972f-c450-29ee-5c96549c47ed
msgctxt "hf877df25g5886g4288g9fadg3808184430f9"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = 804006f4-c9e0-67fe-aaf3-790870015b90
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:804006f4-c9e0-67fe-aaf3-790870015b90
msgctxt "h9dea28c2ge9b5g43fdgb097g467f50285c8c"
msgid ""
"I've sent birds to find him, but the place is rotten with goblins. And if my "
"birds can't get close, what chance do I have?"
msgstr "마스터 할신을 찾기 위해 새들을 보냈지만, 그곳은 고블린으로 들끓고 있어요. 새들조차 접근할 수 없는데, 제가 어쩌겠어요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = 86bfb5ee-282d-4a51-8186-a38f8e7cdf87
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Apprentice_Event_CuredBeforePersuasion = True
#.   Object:
#.      - DEN_Apprentice_State_IsTadpoledPlayer(1) = True
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Event_CuredBeforePersuasion = False
#.   User:
#.     - DEN_Apprentice_State_Cyanide_Persuaded(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:86bfb5ee-282d-4a51-8186-a38f8e7cdf87
msgctxt "h54a39237g4f64g4d3egaa7ag6e8a1e5d8401"
msgid "There's no stopping you, is there?"
msgstr "아무래도 당신을 막을 방법은 없는 모양이네요. 그렇지 않나요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Player
#. NodeID = 8cfbb797-1db5-a3a4-d08b-3193d71d6d55
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_IsFound = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:8cfbb797-1db5-a3a4-d08b-3193d71d6d55
msgctxt "heff781e8g24f0g4255ga89bgd8f40d1d5145"
msgid "I already know where to find him: the worg pens of the goblin camp."
msgstr "그의 행방이라면 이미 알고 있어. 고블린 야영지의 워그 우리에 있다더군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Player
#. NodeID = 8d333e5d-892c-8d40-e5b5-3babe338af75
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:8d333e5d-892c-8d40-e5b5-3babe338af75
msgctxt "h6dad888dg46d8g4791g8603gc2e12f666981"
msgid "I'll never swear to that."
msgstr "절대 맹세 못하겠는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = 901d94a0-4e8d-4195-8852-9755fd468a8a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_HasMet_PersuasionFailed(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:901d94a0-4e8d-4195-8852-9755fd468a8a
msgctxt "h8752a938gb6aag4ee2g8b8cgc597fdc3dd14"
msgid "I'm sorry. There's nothing you can say to change my mind."
msgstr "죄송해요. 당신이 무슨 말씀을 하셔도 제 마음은 바뀌지 않을 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Player
#. NodeID = 9241c5d0-ea97-49ba-b50b-528742317366
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Event_NettieTurnsHostile = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:9241c5d0-ea97-49ba-b50b-528742317366
msgctxt "hec39b3e7g7c44g4435g8fa8g786634127620"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = 9c91c411-1c15-48d7-bb92-6837be38a277
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:9c91c411-1c15-48d7-bb92-6837be38a277
msgctxt "h3acb5342g209fg4909g8521g7fdc8a1ef764"
msgid ""
"But first - swear to me that if you feel <i>any </i>symptoms, you'll end "
"things yourself."
msgstr "하지만 그 전에, <i>어떤</i> 증상이라도 느껴진다면, 스스로를 마무리 짓겠다고 맹세해주세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Player
#. NodeID = 9cd023b3-30a9-4f35-b800-528a2657c955
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_CuredEarly(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:9cd023b3-30a9-4f35-b800-528a2657c955
msgctxt "h2a3cf8ebg154ag464cgb1dfg2daa23f8d755"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = 9df6b135-ec2f-4cc9-a961-4940c05ee971
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Apprentice_State_HostileToTadpoled = False
#.   Object:
#.      - DEN_Apprentice_Event_RevealedTadpole(1) = False
#.   User:
#.      - DEN_Apprentice_State_Cyanide_Persuaded(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:9df6b135-ec2f-4cc9-a961-4940c05ee971
msgctxt "hbef289d9g8b7dg4404gaafagea22df0887aa"
msgid "I hope your friend sees sense soon. She doesn't have much time left."
msgstr "당신의 친구가 이성을 되찾길 바라요. 시간이 얼마 없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = 9e108947-2bc4-449a-b4de-b15ac4a6bd02
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_HasWyvernPoison(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:9e108947-2bc4-449a-b4de-b15ac4a6bd02
msgctxt "h980a5ab1g6fd0g40d2gb942g91a641b4bc54"
msgid ""
"But first - this is a vial of wyvern poison. Swear to me you'll swallow it "
"if you feel <i>any </i>symptoms."
msgstr "하지만 먼저, 이건 와이번 독이 담긴 병이에요. <i>어떤</i> 증상이라도 느껴지면 삼키겠다고 맹세하세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Player
#. NodeID = 9f300f19-903f-0769-96ba-73e9b2926c2e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:9f300f19-903f-0769-96ba-73e9b2926c2e
msgctxt "h5b9af4cfg6776g4d0ag8cd6g0ce650aa5169"
msgid "What do you mean 'should' be changing?"
msgstr "변이'했어야 했다'는 무슨 뜻이야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = a0b3516f-a61e-80a7-18ef-5affe72fa390
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:a0b3516f-a61e-80a7-18ef-5affe72fa390
msgctxt "h09f21d29g1909g4a5bg9e49g8cb6a4bc755d"
msgid ""
"The thing is, I've sent birds to find him, but the place is rotten with "
"goblins. None of us can even get close."
msgstr "문제는 그를 찾기 위해 새들을 보냈지만, 그곳엔 고블린이 득실댄다는 거예요. 우리 중 아무도 가까이 갈 수조차 없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Player
#. NodeID = a3d11e20-a8c6-6336-68fe-00fd049b7cb1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:a3d11e20-a8c6-6336-68fe-00fd049b7cb1
msgctxt "h12ca4adaga0efg4a43gab48g3ef185288652"
msgid "What do you want me to do?"
msgstr "내가 무엇을 하길 원하지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = a47c5eae-5428-433f-ac79-09c09dfffef9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_Event_RevealedTadpole(1) = True
#.      - DEN_Apprentice_State_HasWyvernPoison(0) = True
#.   User:
#.      - DEN_Apprentice_State_Cyanide_Persuaded(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:a47c5eae-5428-433f-ac79-09c09dfffef9
msgctxt "h4dbd1becg494bg4e3agafc0gcb51ce6a1672"
msgid "And? Will you swear you'll take the poison?"
msgstr "그래서요? 독을 마실거라고 맹세하실 건가요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Player
#. NodeID = a4ede112-c22d-4875-a7d7-3a1fc105a6ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:a4ede112-c22d-4875-a7d7-3a1fc105a6ad
msgctxt "h633eebbdg263cg4b24gbe57g70f9d1f0490f"
msgid "I swear, Nettie."
msgstr "맹세할게, 네티."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = aac35085-8152-e86f-db41-153b0dac01a0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_Event_GiveWyvenPoison(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:aac35085-8152-e86f-db41-153b0dac01a0
msgctxt "h1f53b370gc3dag4235ga781g78d42387764b"
msgid ""
"Good luck out there. And if things start to go bad - remember the oath you "
"swore."
msgstr "바깥에서의 행운을 빌어요. 그리고 상황이 나빠지기 시작하면, 당신이 맹세한 것을 기억하세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = ad567526-976a-d328-4fb2-ecbddede21a9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:ad567526-976a-d328-4fb2-ecbddede21a9
msgctxt "h257094begc648g49cag9e53gebdeff9550b8"
msgid "Not yet, anyhow."
msgstr "어떻게든, 아직은요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = ae6b961d-b3fe-8474-efac-bee1a2bd90be
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:ae6b961d-b3fe-8474-efac-bee1a2bd90be
msgctxt "h4a3c1849g5215g41b8g953fg41d1b36776fd"
msgid "I can't make any promises. This is like nothing we've seen before."
msgstr "저는 아무것도 장담할 수 없어요. 이건 우리가 본 적이 없는 것이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Player
#. NodeID = af35f967-c0ce-4887-836a-5564563f1c2f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:af35f967-c0ce-4887-836a-5564563f1c2f
msgctxt "hd1945d90g51c7g44abgb13agbb0e8d685df8"
msgid "Have you lost your mind? No!"
msgstr "제정신이야? 싫어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = b5f540fa-bfe2-68b1-b042-6a7850da40f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:b5f540fa-bfe2-68b1-b042-6a7850da40f1
msgctxt "h691fa15fg69b5g40d9gaa42g84dfaf33cd96"
msgid ""
"Hard to say, but there's a lot we don't know. Infected - folks like you - "
"have been converging on an old temple of Selûne, and I've no idea why."
msgstr ""
"말하기 어렵네요. 우리가 모르는 게 너무 많아요. 당신 같은 감염자들이 오래된 셀루네의 신전에 모여들고 있는데, 그 이유를 모르겠어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = b640ffc6-1f7f-7c98-4046-589dab3980cf
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Quest_FindHalsin = True
#.     - DEN_Apprentice_Event_OpenDoor = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:b640ffc6-1f7f-7c98-4046-589dab3980cf
msgctxt "hb725e008gba31g452bg8501g1b419a07d770"
msgid ""
"Please, you have to bring him back to us. For your own sake as much as ours."
msgstr "부탁드려요, 그를 저희에게 다시 데려와 주세요. 저희뿐만 아니라 당신을 위해서라도요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = b6ca200f-b7ca-cf55-f37d-ef52256b14e4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_Event_GiveWyvenPoison(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:b6ca200f-b7ca-cf55-f37d-ef52256b14e4
msgctxt "h10d6f9eag9c4eg4dfbgbb0dg56f1e8c9cbe0"
msgid "Otherwise, that vial's your only option."
msgstr "그 외엔, 그 독만이 당신의 유일한 선택지예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = b9223e35-26f9-46bb-99b0-d406b4475548
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:b9223e35-26f9-46bb-99b0-d406b4475548
msgctxt "hfd1103ecg149ag4529gb04cg242fbd9d9997"
msgid "Same as the drow... But Master Halsin said he'd turn eventually."
msgstr "이 드로우와 같군요... 마스터 할신은 그가 끝내 변이했다고 하셨어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Player
#. NodeID = b94f2371-c0ed-4de6-8407-d2097ef5fd3b
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 10
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_Cyanide_Persuade1(1) = False
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_Cyanide_Persuade1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:b94f2371-c0ed-4de6-8407-d2097ef5fd3b
msgctxt "h18d3d8fagfb9bg4a59g947agb6102d748bf7"
msgid "It's been days. If I were going to turn, it would've happened by now."
msgstr "이렇게 며칠이 지났어. 내가 변이할 사람이었다면, 지금쯤 변이했을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = bbbf2951-f1cf-38f5-ca6f-d3d809b56219
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:bbbf2951-f1cf-38f5-ca6f-d3d809b56219
msgctxt "h23a04dfdgb52ag4460g87c8g38454d8057d8"
msgid ""
"You, though? You're one of them - technically speaking, I mean. They might "
"not kill someone carrying their parasite."
msgstr "하지만 당신은요? 당신은 그들 중 하나예요. 제 말은, 엄밀히 말하면요. 그들은 기생충이 들어있는 사람을 죽이지는 않아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = bc532aea-0053-aced-160b-21bbc1fa18db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:bc532aea-0053-aced-160b-21bbc1fa18db
msgctxt "ha6d8d19eg7cfcg4654ga14fg1e2df65c38be"
msgid ""
"Swear to me that if you feel <i>any </i>symptoms, you'll end things yourself."
msgstr "만약 당신이 <i>어떤</i> 증상이라도 느낀다면, 스스로 생을 끝내겠다고 저에게 맹세해 주세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Player
#. NodeID = be7698d5-be52-aad6-62d5-40ce2b7a1bf7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:be7698d5-be52-aad6-62d5-40ce2b7a1bf7
msgctxt "hfe659c96g000eg40a1g9600g2da45bd3b73e"
msgid "That sounds like suicide. I won't do it."
msgstr "그건 자살 행위 같군. 사양하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = bf25318b-12ab-10fd-21fc-39a1642b6a04
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_HasWyvernPoison(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:bf25318b-12ab-10fd-21fc-39a1642b6a04
msgctxt "h98ac8b0eg6957g4b7cg90bdg8ca3be4415f2"
msgid ""
"I want to help, but I can't. Not until I know they'll take the wyvern poison "
"if they start to change."
msgstr "저는 도와드리고 싶지만, 그럴 수 없어요. 만약 그들이 변이하기 시작하면 와이번 독을 삼킬 것이라는 보장이 있어야 해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = c032699d-f7fc-346d-08fd-383419d837c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:c032699d-f7fc-346d-08fd-383419d837c0
msgctxt "h59c57f7ag8331g4b2eg8335g0d00f79c9dad"
msgid ""
"I wish I could tell you more, but only those adventurers know what happened "
"out there."
msgstr "더 많은 것을 알려드리고 싶지만, 그 '모험가들'만이 그곳에서 무슨 일이 있었는지 알 수 있어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = c30d2cea-8b9a-4650-8dfd-07f9571e57d1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:c30d2cea-8b9a-4650-8dfd-07f9571e57d1
msgctxt "hd5aaf601g6305g4531gb624ge60f9309e4ff"
msgid ""
"It doesn't matter if you're Silvanus himself come to walk among us - "
"infected is infected."
msgstr "설령 당신이 걸어서 저희를 찾아온 실바누스님이라고 해도 마찬가지예요. 감염자는 감염자예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = c55bdf35-effe-105f-e92a-ddfcee5880f8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_HasGenderNeutralTadpoled(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:c55bdf35-effe-105f-e92a-ddfcee5880f8
msgctxt "h4f648df3g9ae1g4683ga199g13b58bf8e216"
msgid ""
"If it helps, they won't feel any pain. It's the best death I can give them."
msgstr "효과가 있다면, 그들은 고통을 느끼지 않을 거예요. 제가 그들에게 드릴 수 있는 최상의 죽음입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = c84b2545-4219-c0c8-4f04-5edbeea9e07f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Apprentice_State_TadpolePlayerDied = True
#.      - DEN_Apprentice_Event_CuredBeforePersuasion = True
#.   Object:
#.      - DEN_Apprentice_State_IsTadpoledPlayer(1) = True
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Event_CuredBeforePersuasion = False
#.   User:
#.     - DEN_Apprentice_State_Cyanide_Persuaded(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:c84b2545-4219-c0c8-4f04-5edbeea9e07f
msgctxt "h69450528g5e3ag4289gac11g5dbda51b49cd"
msgid "You're alive? There's no way I'm stopping you, is there?"
msgstr "살아있었나요? 내가 당신을 막을 방법은 없겠군요. 안 그래요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = c9ac41c2-142e-1f9a-68c3-31a728e1a882
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:c9ac41c2-142e-1f9a-68c3-31a728e1a882
msgctxt "h7fb81ab2g50a8g4d5cga416g8eb4ee9cb8f1"
msgid ""
"The thing in your skull, though? It's different to anything in our records."
msgstr "그런데 당신 머릿속에 있는 것은요? 우리 기록상의 어떠한 것과도 달라요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = ca94ccc1-bb00-a798-01a3-c442a9299bfa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:ca94ccc1-bb00-a798-01a3-c442a9299bfa
msgctxt "hab7e7fb2g7ec6g4c6cg9f6dg3c5bd7133b8e"
msgid ""
"The way I see it, you have two options: Halsin or death - whatever form it "
"takes."
msgstr "제가 봤을 때, 당신에겐 두 가지 선택지가 있어요. 할신 아니면 죽음입니다 - 그 방식이 무엇이든 간에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Player
#. NodeID = caff11f7-d47f-4ef1-b300-3dbc6ece6f74
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - DEN_DruidLair_State_UnderstoodTwoFrescos = False
#.   Object:
#.      - DEN_Apprentice_State_Cyanide_Intimidate1(1) = False
#.   Tag:
#.      - DRUID(1) = False
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_Cyanide_Intimidate1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:caff11f7-d47f-4ef1-b300-3dbc6ece6f74
msgctxt "hde8fc369g81a9g45deg9eacg8b120588e322"
msgid "<i>Recite what you know of her order - this can't be allowed!</i>"
msgstr "<i>그녀의 단체에 대해 알고 있는 것을 열거하듯 말한다 - 이런 일은 용납될 수 없다!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = cbeea0d7-e1bd-4b58-9fb4-f8cabe31b1a8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_HasMaleTadpoled(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:cbeea0d7-e1bd-4b58-9fb4-f8cabe31b1a8
msgctxt "h4b8aff6dg490eg4013g8353g7cb11f8675d3"
msgid ""
"If it helps, he won't feel any pain. It's the best death I can give him."
msgstr "효과가 있다면, 그는 고통을 느끼지 않을 거예요. 제가 그에게 드릴 수 있는 최상의 죽음입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Player
#. NodeID = cc4c993c-9b17-4258-a7a9-ccd73bd3f9ca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:cc4c993c-9b17-4258-a7a9-ccd73bd3f9ca
msgctxt "he42c53aagcb23g49b2ga958g6b5906d7a800"
msgid "Fine, just give it to me."
msgstr "그러지, 해독제나 넘겨."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = cc92ee6d-7409-1c09-1acc-c81fe3131331
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:cc92ee6d-7409-1c09-1acc-c81fe3131331
msgctxt "h8abec9a5g2763g4828gb4e4g0fa540aafff3"
msgid ""
"If you can find Halsin and get him out of there, we can discover what he "
"learned. And perhaps he can save your life. How's that sound?"
msgstr ""
"만약 당신이 할신을 찾아서 거기서 꺼내주면 그가 뭘 배웠는지 알아낼 수 있어요. 그리고 아마도 그는 당신을 구할 수 있을 거예요. 어때요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Player
#. NodeID = cd4f79ff-04f9-cdb2-7baa-5ea71fdae2d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:cd4f79ff-04f9-cdb2-7baa-5ea71fdae2d4
msgctxt "h46f1e1bag81a1g403dgb061g2ec6c1be6c32"
msgid "You said you were tracking other victims. Did they change?"
msgstr "너는 다른 피해자들을 추적하고 있었다고 했지. 그들도 변이했나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Player
#. NodeID = d0d80597-6a15-4d63-8b39-f4658ba3d57a
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 10
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_Cyanide_FailedToPersuadeNettie(1) = False
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_Cyanide_Persuade1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:d0d80597-6a15-4d63-8b39-f4658ba3d57a
msgctxt "h2d63fe8fg4403g4371ga056gf3f404553175"
msgid "We can both see I have no symptoms - I'm not about to change!"
msgstr "내가 증상이 없다는 걸 우리 둘 다 알고 있어 - 나는 변하지 않을 거야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = d1cbda6a-cbcc-519c-718c-8c407ac34d82
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:d1cbda6a-cbcc-519c-718c-8c407ac34d82
msgctxt "h03d74df1gc86eg4690ga21agce241d883473"
msgid ""
"I wouldn't be so sure. There's a lot we don't know. Infected - folks like "
"you - have been converging on an old temple of Selûne, and I've no idea why."
msgstr ""
"그렇게 확신할 수는 없어요. 우리가 모르는 게 너무 많아요. 당신 같은 감염자들이 오래된 셀루네의 신전에 모여들고 있는데, 그 이유를 "
"모르겠어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Player
#. NodeID = d43c998a-f533-495f-9796-187cf4715892
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_Cyanide_Deceive1(1) = False
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_Cyanide_Deceive1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:d43c998a-f533-495f-9796-187cf4715892
msgctxt "hf444cd24gec77g4faagb0a9gc62580e448be"
msgid "You can't do this - your leader needs to talk to me."
msgstr "이러면 안 돼. 너의 지도자가 나와 이야기해야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Player
#. NodeID = d4878ee0-be63-ff3f-462a-36d653a9c1e1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:d4878ee0-be63-ff3f-462a-36d653a9c1e1
msgctxt "h017a9374gdf42g4b6fg860cgbe0a1a120ec4"
msgid "So? Go and get him."
msgstr "그래서? 가서 그를 찾아오면 되잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Player
#. NodeID = d68e4aed-d5ae-5131-8d18-77dfd6d86fad
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - DEN_DruidLair_State_UnderstoodTwoFrescos = True
#.   Object:
#.      - DEN_Apprentice_State_Cyanide_FailedToPersuadeNettie(1) = False
#.   Tag:
#.      - DRUID(1) = False
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_Cyanide_Intimidate1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:d68e4aed-d5ae-5131-8d18-77dfd6d86fad
msgctxt "h42cb3bb3g8991g41fega583g052338d2094f"
msgid "<i>Try to recall the tenets of her order - she can't support this!</i>"
msgstr "<i>그녀의 단체의 교리를 기억해본다 - 그녀는 이런 일을 지지할 수 없다!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = d7106749-c1fe-4f9f-a3d8-9cd2498bee00
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_CuredEarly(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:d7106749-c1fe-4f9f-a3d8-9cd2498bee00
msgctxt "hb0647b49gcc31g4bedgbdadge33cf1e4c770"
msgid ""
"I don't want to hurt you, but I can't let you live. You're too dangerous."
msgstr "저는 당신을 다치게 하고 싶진 않지만, 살려 보낼 수도 없어요. 당신은 너무 위험해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = d8bccb2b-77cd-492c-bf27-4d1760b2787b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:d8bccb2b-77cd-492c-bf27-4d1760b2787b
msgctxt "h6d075a10g16acg438dga9ebg21e502efcdb8"
msgid "Aside from the obvious."
msgstr "당연한 말은 제쳐두고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = d9fe703a-8715-ca89-ed81-f1e1d67ad5d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:d9fe703a-8715-ca89-ed81-f1e1d67ad5d8
msgctxt "h794a591bge1eeg46adgacedg7a9c05b9bb62"
msgid ""
"When Master Halsin heard the adventurers were heading that way, he saw a "
"chance to get answers. Joined on the spot."
msgstr "마스터 할신께선 모험가들이 그쪽으로 가고 있다는 소식을 듣고, 답을 얻을 기회로 여겨 바로 합류하셨죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = da0c5b8f-444b-b037-12ae-bf06b1dc455e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:da0c5b8f-444b-b037-12ae-bf06b1dc455e
msgctxt "hf01cc342ga207g4478g897fg1de5e62a717f"
msgid "Whatever he found there, he didn't make it back."
msgstr "그가 그곳에서 발견한 것이 무엇이든, 그는 돌아오지 못했어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = de4ef01e-1744-ebdb-a2d2-cad2a97617e9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:de4ef01e-1744-ebdb-a2d2-cad2a97617e9
msgctxt "h38a98af8g32d1g47c4g9089g7ab22d1cc4a6"
msgid ""
"I want to help, but I can't. Not until I know she'll do what has to be done, "
"if it comes to that."
msgstr "효과가 있다면, 그녀는 고통을 느끼지 않을 거예요. 제가 그녀에게 드릴 수 있는 최상의 죽음입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = de820f51-ab42-4812-4fe0-a47d208832d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:de820f51-ab42-4812-4fe0-a47d208832d0
msgctxt "hea06aea4gce2eg48d8gb4f1gba4eed788404"
msgid ""
"I want to help, but I can't. Not until I know they'll do what has to be "
"done, if it comes to that."
msgstr "돕고 싶지만, 그럴 수 없어요. 그들이 해야 할 일을 할 것이라는 확신이 들 때까지는."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = dea52951-d84c-4d4f-be77-255d00fe5fe4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_HasWyvernPoison(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:dea52951-d84c-4d4f-be77-255d00fe5fe4
msgctxt "h0b4bd970g218fg4851g9306g0df110314516"
msgid ""
"This is a vial of wyvern poison. Swear to me you'll swallow it if you feel "
"<i>any </i>symptoms."
msgstr "이건 와이번 독이 담긴 병이에요. <i>어떤</i> 증상이라도 느껴지면 삼키겠다고 맹세하세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = e29da411-f0d2-45da-a84c-3c7881855cbb
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_Cyanide_FailedToPersuadeNettie(1) = True
#.     - DEN_Apprentice_HasMet_PersuasionFailed(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:e29da411-f0d2-45da-a84c-3c7881855cbb
msgctxt "h77bd4173gcfe8g434cgbd1fg5fcfdd4b90dc"
msgid "I'm sorry. There's nothing you can say to change my mind."
msgstr "죄송해요. 당신이 무슨 말씀을 하셔도 제 마음은 바뀌지 않을 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = e2fd127d-9279-e867-bc76-0ea19974b659
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:e2fd127d-9279-e867-bc76-0ea19974b659
msgctxt "h66eab944gb7bag41d6ga441g6b96579be6ca"
msgid ""
"I've spent my life treating folk and never once saw a mind flayer infection. "
"Then suddenly there's dozens of you - maybe more."
msgstr ""
"저는 평생 사람들을 치료해왔지만 한 번도 마인드 플레이어 감염을 본 적이 없어요. 그런데 갑자기 수십 명, 어쩌면 그 이상의 감염자가 "
"나타났다고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = ea18cf4f-340a-1979-3827-5caaf6b09e99
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:ea18cf4f-340a-1979-3827-5caaf6b09e99
msgctxt "h6d751969g2e8dg4430g8620g87b887058d2c"
msgid ""
"Mind flayers reproduce by infecting someone with their parasite. Seven "
"gruesome days later, the victim transforms and a new mind flayer is born."
msgstr ""
"마인드 플레이어는 누군가를 기생충에 감염시켜 번식합니다. 끔찍한 일주일이 지난 후, 피해자는 변이하고 새로운 마인드 플레이어가 탄생하죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Player
#. NodeID = eb6b4dec-c6bc-df1a-96dd-dad06317a41b
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - DEN_DruidLair_State_UnderstoodTwoFrescos = True
#.   Object:
#.      - DEN_Apprentice_State_Cyanide_Intimidate1(1) = False
#.   Tag:
#.      - DRUID(1) = False
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_Cyanide_Intimidate1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:eb6b4dec-c6bc-df1a-96dd-dad06317a41b
msgctxt "hbdb8f9acg8109g4debgaaefg0b805b59ad6b"
msgid "<i>Recite what you know of her order - this can't be allowed!</i>"
msgstr "<i>그녀의 단체에 대해 알고 있는 것을 열거하듯 말한다 - 이런 일은 용납될 수 없다!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Player
#. NodeID = ec94201a-07c5-4034-abd6-ec58a906a524
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_Cyanide_FailedToPersuadeNettie(1) = False
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_Cyanide_Deceive1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:ec94201a-07c5-4034-abd6-ec58a906a524
msgctxt "h8cafc682g1d87g4e8ega05cg5577670fb9da"
msgid "You can't do this - I'm on a secret mission. Everything depends on it."
msgstr "이러면 안 돼 - 나는 비밀 임무를 수행 중이야. 모든 것이 이에 달려 있다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Player
#. NodeID = ed5908c5-257a-c775-6bf3-214f8fbc29f6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:ed5908c5-257a-c775-6bf3-214f8fbc29f6
msgctxt "ha929f1f5gd798g4619g9e5aga4cae929dd5f"
msgid "Excellent news! All the power, none of the tentacles."
msgstr "훌륭한 소식이군! 그런 힘에, 촉수도 없다니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = efa94178-e4d7-f772-437e-7fc1ef6d8528
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_Cyanide_WarnedOfOptions(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:efa94178-e4d7-f772-437e-7fc1ef6d8528
msgctxt "h7f0bd17bgca41g4832g8900g153b1498da32"
msgid ""
"But of course, the choice is yours. I just hope you find a cure out there."
msgstr "물론 선택은 당신 몫이애요. 저는 당신이 그곳에서 치료제를 찾기를 바랄 뿐이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = f0689b79-10f4-c02e-f529-68b33bc752fc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_CuredEarly(1) = False
#.      - DEN_Apprentice_State_HasAntidote(0) = True
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Knows_AntidoteLocation = True
#.   Object:
#.     - ORI_Gale_State_NettieGaveAntidote(1) = True
#.     - DEN_Apprentice_Event_Gale_GotAntidoteApproval(1) = True
#.     - DEN_Apprentice_Event_GiveAntidote(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:f0689b79-10f4-c02e-f529-68b33bc752fc
msgctxt "hee572484g7879g4be5gbc95gad7b62437fa0"
msgid "And here's the antidote. Do not mix those two up."
msgstr "그리고 여기 해독제예요. 두 개를 혼동하지는 마세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp
#. Speaker = Nettie
#. NodeID = f58a82f4-cdfa-4f08-a957-6b306c095ded
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   User:
#.     - DEN_Apprentice_State_Cyanide_Persuaded(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_LockedUp:f58a82f4-cdfa-4f08-a957-6b306c095ded
msgctxt "h24670ea7g9426g4735g9403g70453cc2c78b"
msgid ""
"Hells' teeth. All right. I'll tell you where the antidote is, but there's a "
"condition."
msgstr "맙소사. 알겠어요. 해독제가 어디있는지 말할게요. 하지만 조건이 있어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Cyanide
#. Speaker = Player
#. NodeID = 316a25a7-a8de-48b0-8d84-c8665a8e4379
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Cyanide:316a25a7-a8de-48b0-8d84-c8665a8e4379
msgctxt "ha3442ba2g486bg4a82gb657ge61839d90a70"
msgid ""
"Better than becoming a mind flayer. Keep it - in case things start to go "
"very wrong."
msgstr "마인드 플레이어가 되는 것 보단 낫지. 일단 가지고 있어. 일이 꼬이면 필요할 수도 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Cyanide
#. Speaker = Player
#. NodeID = 316a25a7-a8de-48b0-8d84-c8665a8e4379
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Cyanide:316a25a7-a8de-48b0-8d84-c8665a8e4379
msgctxt "h37598ca2gffb4g4ce9g8a5cga1c3a5995f07"
msgid ""
"As something of a potential would-be mind flayer myself, I couldn't agree "
"more."
msgstr "잠재적 마인드 플레이어 변이 예정자 중 하나인 입장으로서, 난 아주 찬성이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Cyanide
#. Speaker = Player
#. NodeID = 316a25a7-a8de-48b0-8d84-c8665a8e4379
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Cyanide:316a25a7-a8de-48b0-8d84-c8665a8e4379
msgctxt "hf98a49cag6eeag4903g9e63g110670bc8ec6"
msgid ""
"If you start to turn, I encourage you to take it. I'm sure it'll be very "
"entertaining for the rest of us."
msgstr "변이가 시작되면 마시는 걸 추천해. 분명히 우리들한테 아주 좋은 구경거리가 될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Cyanide
#. Speaker = Player
#. NodeID = 316a25a7-a8de-48b0-8d84-c8665a8e4379
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Cyanide:316a25a7-a8de-48b0-8d84-c8665a8e4379
msgctxt "h09278848g641dg476aga6e3g6416d6ea0390"
msgid ""
"Trade it to the nearest quartermaster for a better weapon - it looks like "
"you could use one."
msgstr "근처의 병참장교에게 가서 더 쓸만한 무기로 교환하는 건 어때? 필요해 보여서 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Cyanide
#. Speaker = Player
#. NodeID = 316a25a7-a8de-48b0-8d84-c8665a8e4379
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Cyanide:316a25a7-a8de-48b0-8d84-c8665a8e4379
msgctxt "h2b2a61e3g6af7g4cdagbcf5g548d9e23b82c"
msgid "We're a long way from a measure that drastic. A very long way."
msgstr "그렇게 극단적인 조치가 필요할 때까진 아직 멀었어. 아주 멀었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Cyanide
#. Speaker = Player
#. NodeID = 316a25a7-a8de-48b0-8d84-c8665a8e4379
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Cyanide:316a25a7-a8de-48b0-8d84-c8665a8e4379
msgctxt "h85ec01abg4044g4075g823dg1d2ce52492dc"
msgid ""
"I might use it - as a projectile. Not dying a second sooner than I have to, "
"that's for sure."
msgstr "쓸만하겠어. - 투척용으로는 말야. 난 1초라도 빨리 죽고 싶지 않은 건, 확실하니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Cyanide
#. Speaker = Player
#. NodeID = 316a25a7-a8de-48b0-8d84-c8665a8e4379
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_GENERIC
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Cyanide:316a25a7-a8de-48b0-8d84-c8665a8e4379
msgctxt "h7662250dg1251g4013g8fc2gb81fc58c7e4e"
msgid "Better to have on hand than not."
msgstr "없는 것보다는 지니고 있는 것이 낫지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Cyanide
#. Speaker = Player
#. NodeID = 4274dac0-4fc5-45a0-854c-e3b8e9311dcd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = False
#.      - REALLY_WYLL(1) = False
#.      - REALLY_LAEZEL(1) = False
#.      - REALLY_ASTARION(1) = False
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Cyanide:4274dac0-4fc5-45a0-854c-e3b8e9311dcd
msgctxt "h25f5620dg4ae9g4020g948ag42928b437ea3"
msgid "Wyvern poison. Never tried it, and I hope to keep it that way."
msgstr "와이번 독이네. 써본 적은 없어. 앞으로도 쓸 일이 없으면 좋겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Cyanide
#. Speaker = Player
#. NodeID = 4274dac0-4fc5-45a0-854c-e3b8e9311dcd
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = False
#.      - REALLY_WYLL(1) = False
#.      - REALLY_LAEZEL(1) = False
#.      - REALLY_ASTARION(1) = False
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Cyanide:4274dac0-4fc5-45a0-854c-e3b8e9311dcd
msgctxt "heb595ab4gaaf7g413fgbaffg659ec411f3f7"
msgid ""
"Wyvern poison. Lethal stuff. Let's hope we won't have to sample its delights."
msgstr "와이번 독이네. 치명적인 물건이지. 이 녀석을 맛 볼 일이 없길 바라자고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Cyanide
#. Speaker = Player
#. NodeID = 4274dac0-4fc5-45a0-854c-e3b8e9311dcd
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = False
#.      - REALLY_WYLL(1) = False
#.      - REALLY_LAEZEL(1) = False
#.      - REALLY_ASTARION(1) = False
#. TagRule: REALLY_GENERIC
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Cyanide:4274dac0-4fc5-45a0-854c-e3b8e9311dcd
msgctxt "h559f3d03gd19cg4343gaaddg608e09f84be6"
msgid "Wyvern poison. Let's hope it doesn't come to that."
msgstr "와이번 독이네. 이걸 쓸 일이 없었으면 좋겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Cyanide
#. Speaker = Player
#. NodeID = 7048e45d-0f95-4416-a2d3-c3b0f9edf592
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Cyanide:7048e45d-0f95-4416-a2d3-c3b0f9edf592
msgctxt "hf65fccf3g6911g4489g911fg588a84abb61c"
msgid "You can toss that poison. We won't be needing it."
msgstr "그 독은 버려도 돼. 쓸 일이 없을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Cyanide
#. Speaker = Player
#. NodeID = 72c797ae-6c03-45c6-892f-67daeab84374
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(0) = False
#.      - REALLY_WYLL(0) = False
#.      - REALLY_LAEZEL(0) = False
#.      - REALLY_ASTARION(0) = False
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Cyanide:72c797ae-6c03-45c6-892f-67daeab84374
msgctxt "hf1ea8f50gad2ag41e3gb5a6g2f8df5dbcd75"
msgid ""
"I've read it's one of the nastiest poisons in Faerûn. Starts burning in the "
"small intestine, and works its way through the blood from there."
msgstr "페이룬에서 가장 끔찍한 독 중 하나라는 글을 읽은 적이 있어. 소장을 태우는 걸로 시작해서 혈관을 타고 온 몸에 퍼지는 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Cyanide
#. Speaker = Player
#. NodeID = 72c797ae-6c03-45c6-892f-67daeab84374
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(0) = False
#.      - REALLY_WYLL(0) = False
#.      - REALLY_LAEZEL(0) = False
#.      - REALLY_ASTARION(0) = False
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Cyanide:72c797ae-6c03-45c6-892f-67daeab84374
msgctxt "h1bb30806geb0fg4b51g8e1fga37d04d1b969"
msgid ""
"Better than becoming a mind flayer, I suppose. Keep it - in case things "
"start to go very wrong."
msgstr "마인드 플레이어가 되는 것 보단 낫지. 일단 가지고 있어. 일이 꼬이면 필요할 수도 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Cyanide
#. Speaker = Player
#. NodeID = 72c797ae-6c03-45c6-892f-67daeab84374
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(0) = False
#.      - REALLY_WYLL(0) = False
#.      - REALLY_LAEZEL(0) = False
#.      - REALLY_ASTARION(0) = False
#. TagRule: REALLY_GENERIC
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Cyanide:72c797ae-6c03-45c6-892f-67daeab84374
msgctxt "h6896b61egc0edg43a0g968fg38f1dfcf7d29"
msgid "Better a quick draught than ceremorphosis, nonetheless."
msgstr "어쨌든, 뇌변이보단 한 모금으로 빠르게 끝내는 편이 낫겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Dying
#. Speaker = Player
#. NodeID = 18b1e591-1206-40e3-b999-5668367ee51a
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Dying:18b1e591-1206-40e3-b999-5668367ee51a
msgctxt "h57fa8217gb042g4932g93a4ge4186431ff1a"
msgid "No. No, it can't end like this!"
msgstr "안 돼. 안 돼, 이런 식으로 끝날 순 없어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Dying
#. Speaker = Player
#. NodeID = 18b1e591-1206-40e3-b999-5668367ee51a
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Dying:18b1e591-1206-40e3-b999-5668367ee51a
msgctxt "h825d0a89gf233g4f78gaf1bg36ef0a0d5614"
msgid "The poison is overtaking me. Bring me back! I must be brought back!"
msgstr "독이 날 집어삼키고 있어. 날 살려내! 날 무조건 살려내라고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Dying
#. Speaker = Player
#. NodeID = 18b1e591-1206-40e3-b999-5668367ee51a
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Dying:18b1e591-1206-40e3-b999-5668367ee51a
msgctxt "hb5818cb8g7aaag4825g88c6g0192b0785466"
msgid "The poison's turned my guts to muck... I'm done for..."
msgstr "독 때문에 속이 메스꺼워... 난 여기까진가..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Dying
#. Speaker = Player
#. NodeID = 18b1e591-1206-40e3-b999-5668367ee51a
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Dying:18b1e591-1206-40e3-b999-5668367ee51a
msgctxt "h725a9bb3g9977g4c09g8642gfc52040ac651"
msgid "The poison's done its work. <i>I'm sorry, my Queen...</i>"
msgstr "독이 제 역할을 톡톡히 하는군. <i>여왕님, 죄송합니다...</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Dying
#. Speaker = Player
#. NodeID = 18b1e591-1206-40e3-b999-5668367ee51a
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Dying:18b1e591-1206-40e3-b999-5668367ee51a
msgctxt "h7b03d7d8gb3d0g4405gbcfcgfd4ef067fccf"
msgid "<i>Agh</i>... killed by a bloody dwarf healer. Pathetic."
msgstr "<i>아악</i>... 망할 드워프 치료사한테 독살당하다니. 한심한 최후구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Dying
#. Speaker = Player
#. NodeID = 18b1e591-1206-40e3-b999-5668367ee51a
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Dying:18b1e591-1206-40e3-b999-5668367ee51a
msgctxt "h52eb7a46ge8d0g4134gb617g7eb6ff83c3d0"
msgid "This... this is it. It's too much..."
msgstr "여... 여기까진가. 독이 너무 많이 퍼졌어..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Dying
#. Speaker = Player
#. NodeID = 18b1e591-1206-40e3-b999-5668367ee51a
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_GENERIC
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Dying:18b1e591-1206-40e3-b999-5668367ee51a
msgctxt "h35e2a3e0g8449g4c89g845dgbbadb74748a6"
msgid "Argh, the poison. It's too much. It's too late..."
msgstr "아악, 독이. 너무 많이 퍼졌어. 여기까진가..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_FeelingSick
#. Speaker = Player
#. NodeID = 2571eb57-0563-4dc2-abc8-17b0bedef154
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_ThornStage2(0) = True
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_FeelingSick:2571eb57-0563-4dc2-abc8-17b0bedef154
msgctxt "h4f358722ga2e4g4c8dgb920gbc039e8ee6ea"
msgid "I feel woozy. Whatever that druid scratched me with, it's working."
msgstr "토할 것 같아. 저 드루이드가 뭘로 날 할퀸지는 모르겠는데, 효과 만점이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_FeelingSick
#. Speaker = Player
#. NodeID = 2571eb57-0563-4dc2-abc8-17b0bedef154
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_ThornStage2(0) = True
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_FeelingSick:2571eb57-0563-4dc2-abc8-17b0bedef154
msgctxt "he50dfe00g13c3g4d7agbca8g4d3ed8c8066b"
msgid "I feel... sick. What in the hells did that druid do to me?"
msgstr "속이... 안 좋아. 저 드루이드가 무슨 수작을 부린 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_FeelingSick
#. Speaker = Player
#. NodeID = 2571eb57-0563-4dc2-abc8-17b0bedef154
#. HandlePath = TaggedText[2].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_ThornStage2(0) = True
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_FeelingSick:2571eb57-0563-4dc2-abc8-17b0bedef154
msgctxt "hde0b21f9g0d51g43b1g8b90g04e39530b2ac"
msgid ""
"Feel like I've been sucking on a stench kow's udder... That druid fucked me "
"up."
msgstr "스텐치 카우의 젖을 빨고 있는 기분이야... 저 드루이드가 날 조져놨군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_FeelingSick
#. Speaker = Player
#. NodeID = 2571eb57-0563-4dc2-abc8-17b0bedef154
#. HandlePath = TaggedText[3].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_ThornStage2(0) = True
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_FeelingSick:2571eb57-0563-4dc2-abc8-17b0bedef154
msgctxt "h86b2c5b5g42f2g4479gbb6eg4847672042ba"
msgid ""
"Urgh - dizziness, nausea. Clear signs of poisoning. This is Nettie's doing."
msgstr "어억.. 어지럽고 메스꺼워. 명백한 중독 증상이군. 네티가 한 짓인가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_FeelingSick
#. Speaker = Player
#. NodeID = 2571eb57-0563-4dc2-abc8-17b0bedef154
#. HandlePath = TaggedText[4].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_ThornStage2(0) = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_FeelingSick:2571eb57-0563-4dc2-abc8-17b0bedef154
msgctxt "hf43e89bdg91afg4f14ga030g532399cc955c"
msgid "Whatever Nettie did to me... it's getting worse."
msgstr "네티가 내게 뭘 했는지 모르겠지만... 악화되고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_FeelingSick
#. Speaker = Player
#. NodeID = 2571eb57-0563-4dc2-abc8-17b0bedef154
#. HandlePath = TaggedText[5].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_ThornStage2(0) = True
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_FeelingSick:2571eb57-0563-4dc2-abc8-17b0bedef154
msgctxt "h5925d3a3g34b9g4862gbcc8gbcadbfee188a"
msgid "<i>Ngh</i> - I'm not feeling so good. Is this Nettie's doing?"
msgstr "<i>윽</i> - 상태가 안좋아. 네티의 짓인가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_FeelingSick
#. Speaker = Player
#. NodeID = 2571eb57-0563-4dc2-abc8-17b0bedef154
#. HandlePath = TaggedText[6].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_ThornStage2(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_FeelingSick:2571eb57-0563-4dc2-abc8-17b0bedef154
msgctxt "h16cfca79gbe7bg465cg9331gc483e8c1d6a9"
msgid "I don't feel too good. What did that druid scratch me with?"
msgstr "상태가 안좋아. 저 드루이드가 날 뭘로 긁은 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_FeelingSick
#. Speaker = Player
#. NodeID = a84d9c45-481e-4178-b3e8-b27643d58212
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_ThornStage2(0) = True
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_ThornStage2(0) = False
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_FeelingSick:a84d9c45-481e-4178-b3e8-b27643d58212
msgctxt "h4faa8f42g040eg46c2gb1f3g138da91a525b"
msgid "I can feel the druid's poison in my veins. She must have had a cure..."
msgstr "드루이드의 독이 내 혈관을 흐르는 게 느껴져. 분명 저 여자에게 해독제가 있을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_FeelingSick
#. Speaker = Player
#. NodeID = a84d9c45-481e-4178-b3e8-b27643d58212
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_ThornStage2(0) = True
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_ThornStage2(0) = False
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_FeelingSick:a84d9c45-481e-4178-b3e8-b27643d58212
msgctxt "h23670fe6g4c99g48a4g968bgd2bba75fb158"
msgid "I grow cold, numb. I need a damned antidote now!"
msgstr "점점 춥고, 감각이 사라지고 있어. 당장 망할 해독제가 필요하다고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_FeelingSick
#. Speaker = Player
#. NodeID = a84d9c45-481e-4178-b3e8-b27643d58212
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_ThornStage2(0) = True
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_ThornStage2(0) = False
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_FeelingSick:a84d9c45-481e-4178-b3e8-b27643d58212
msgctxt "hb4db13bbg38b7g46a8ga6edge34a90735d18"
msgid "I feel weak. That poison's not gonna cure itself... need an antidote."
msgstr "약해지는 느낌이 들어. 저절로 나아질 독이 아니야... 해독제가 필요해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_FeelingSick
#. Speaker = Player
#. NodeID = a84d9c45-481e-4178-b3e8-b27643d58212
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_ThornStage2(0) = True
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_ThornStage2(0) = False
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_FeelingSick:a84d9c45-481e-4178-b3e8-b27643d58212
msgctxt "h23089f78ge86fg41dag946ag5fd7545cc840"
msgid ""
"I'm... I'm growing cold. I must find an antidote to this poison, and quick."
msgstr "저... 점점 추워지고 있어. 서둘러서 해독제를 찾아야만해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_FeelingSick
#. Speaker = Player
#. NodeID = a84d9c45-481e-4178-b3e8-b27643d58212
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_ThornStage2(0) = True
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_ThornStage2(0) = False
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_FeelingSick:a84d9c45-481e-4178-b3e8-b27643d58212
msgctxt "hed96070fg18d6g4f8dgbfdfg84b2e3f496cb"
msgid ""
"Agh... I need to reverse whatever Nettie did to me, before it's too late."
msgstr "으윽... 네티가 내게 한 짓을 되돌려 놓아야만 해. 너무 늦기 전에."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_FeelingSick
#. Speaker = Player
#. NodeID = a84d9c45-481e-4178-b3e8-b27643d58212
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_ThornStage2(0) = True
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_ThornStage2(0) = False
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_FeelingSick:a84d9c45-481e-4178-b3e8-b27643d58212
msgctxt "h03c9e01dge671g4bbcgbdedg91267aa18e4e"
msgid ""
"<i>Ngh</i> - I'm getting worse. There's got to be a way to treat this "
"poison..."
msgstr "<i>끄윽</i>. 상태가 악화되고 있어. 이 독을 치료할 방법이 있을 텐데..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_FeelingSick
#. Speaker = Player
#. NodeID = a84d9c45-481e-4178-b3e8-b27643d58212
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_ThornStage2(0) = True
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_State_ThornStage2(0) = False
#. TagRule: REALLY_GENERIC
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_FeelingSick:a84d9c45-481e-4178-b3e8-b27643d58212
msgctxt "h7e04018bg3063g4ff0gbd63gcb767344379d"
msgid "The druid's poison is spreading. I need a cure, fast."
msgstr "드루이드의 독이 퍼지고 있어. 치료를 서둘러야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_LockedUp
#. Speaker = Player
#. NodeID = 29077630-39f1-4705-8347-1aaa6048d98c
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_LockedUp:29077630-39f1-4705-8347-1aaa6048d98c
msgctxt "h33e43538ge738g4862gb11cg5a22d82fc351"
msgid ""
"Let's keep our condition on a need-to-know basis. As in, nobody needs to "
"know."
msgstr "우리 상황은 알아야 될 사람들한테만 알리자고. 다시 말해, 아무도 몰라도 된다는 거지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_LockedUp
#. Speaker = Player
#. NodeID = 29077630-39f1-4705-8347-1aaa6048d98c
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_LockedUp:29077630-39f1-4705-8347-1aaa6048d98c
msgctxt "h1f09e99ega973g4c6bgbc7dgdb1608eb6b45"
msgid ""
"Only proven allies should know of our condition. Anyone else? Keep your lips "
"sealed."
msgstr "오직 우리 편임이 확실한 자들에게만 우리 상태를 알려야 한다. 그 밖에는? 입을 닫고 있어라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_LockedUp
#. Speaker = Player
#. NodeID = 29077630-39f1-4705-8347-1aaa6048d98c
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_LockedUp:29077630-39f1-4705-8347-1aaa6048d98c
msgctxt "h3bac271ag588dg4de3g89cdg84d92b76266c"
msgid ""
"I trust the next time someone asks if we have a mind flayer tadpole in any "
"of our skulls, we'll consider lying?"
msgstr "다음 번엔 누가 우리 머리 속에 마인드 플레이어 올챙이가 들어있는지 물어본다면, 거짓말을 하는 게 좋겠지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_LockedUp
#. Speaker = Player
#. NodeID = 29077630-39f1-4705-8347-1aaa6048d98c
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_LockedUp:29077630-39f1-4705-8347-1aaa6048d98c
msgctxt "h01aed52bg102dg4004g9733g8b8bcdcc4046"
msgid "Blind honesty is always a bad idea. We should keep quiet in future."
msgstr "맹목적인 정직함이 언제나 좋은 생각인 건 아니야. 앞으론 가만히 있는 게 좋겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_LockedUp
#. Speaker = Player
#. NodeID = 29077630-39f1-4705-8347-1aaa6048d98c
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_LockedUp:29077630-39f1-4705-8347-1aaa6048d98c
msgctxt "h0daafe80g88e4g4aa7ga695g3b49488fc2c2"
msgid "Better to keep some things on the inside pocket, you know."
msgstr "가끔은 숨기는 게 차라리 나을 때도 있어, 너도 알잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_LockedUp
#. Speaker = Player
#. NodeID = 29077630-39f1-4705-8347-1aaa6048d98c
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_LockedUp:29077630-39f1-4705-8347-1aaa6048d98c
msgctxt "he116a0abgc312g41degbbb1g01e7479bb254"
msgid ""
"These tadpoles are no ordinary ailment. It might be wiser to keep the "
"specifics to ourselves."
msgstr "이 올챙이들은 평범한 질병 같은 게 아니야. 자세한 사항은 우리끼리만 알고 있는 게 좋겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_LockedUp
#. Speaker = Player
#. NodeID = 29077630-39f1-4705-8347-1aaa6048d98c
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_GENERIC
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_LockedUp:29077630-39f1-4705-8347-1aaa6048d98c
msgctxt "h37dfc5f3gbb4bg4d5dgb15cgf63261608b76"
msgid ""
"Can't blame anyone for reacting with fear - but it might do to keep our "
"condition on a need-to-know basis."
msgstr ""
"다른 사람들이 두려워하는 반응을 보이는 걸 비난할 수 없지만, 그럼에도 알아야 할 필요가 있는 사람들에게는 우리의 상태를 알려주는 게 "
"나을지도 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_LockedUp
#. Speaker = Player
#. NodeID = 5ab538e4-4790-438a-94eb-2de924657e8e
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_LockedUp:5ab538e4-4790-438a-94eb-2de924657e8e
msgctxt "h646898d0gba5eg4194ga6fdg3377241aac72"
msgid ""
"For someone who just heard we're all beasties-in-waiting, she reacted... "
"well."
msgstr "우리가 전부 괴물이 될 예정이란 말을 들은 것 치고는, 나쁘지 않은 반응이군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_LockedUp
#. Speaker = Player
#. NodeID = 5ab538e4-4790-438a-94eb-2de924657e8e
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_LockedUp:5ab538e4-4790-438a-94eb-2de924657e8e
msgctxt "ha111595egfe88g4f00g9cd3gbd8836b54574"
msgid "So this is what honesty gets you? Consider my lesson learned."
msgstr "이게 정직함의 대가라고? 좋은 교훈을 얻었군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_LockedUp
#. Speaker = Player
#. NodeID = 5ab538e4-4790-438a-94eb-2de924657e8e
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_LockedUp:5ab538e4-4790-438a-94eb-2de924657e8e
msgctxt "hf9e31bc0g0a22g4affg88d7g049e79eca7e1"
msgid "Could have been worse, I suppose. At least she didn't just attack."
msgstr "상황이 더 나빠질 수도 있었겠어. 그래도 그냥 우릴 공격하진 않았네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_LockedUp
#. Speaker = Player
#. NodeID = 5ab538e4-4790-438a-94eb-2de924657e8e
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_LockedUp:5ab538e4-4790-438a-94eb-2de924657e8e
msgctxt "h6d2df768gdb0bg45d7gaab7gbac6cf4da649"
msgid "She hears of the tadpole, and thinks we can be <i>bound</i>?"
msgstr "분명 그녀도 올챙이 이야기를 들었을 텐데, 우리를 <i>구속할</i> 수 있다고 생각했을까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_LockedUp
#. Speaker = Player
#. NodeID = 5ab538e4-4790-438a-94eb-2de924657e8e
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_LockedUp:5ab538e4-4790-438a-94eb-2de924657e8e
msgctxt "h293f3e3fg4675g4941g8afcg5f05806f441c"
msgid "Honesty's not always the best policy, I guess."
msgstr "정직함이 최선의 방법은 아닌 것 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_LockedUp
#. Speaker = Player
#. NodeID = 5ab538e4-4790-438a-94eb-2de924657e8e
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_LockedUp:5ab538e4-4790-438a-94eb-2de924657e8e
msgctxt "h68498ab3g5d0bg45a0gad1agef096447cda1"
msgid "A prudent reaction, if somewhat lacking in curiosity."
msgstr "호기심이 부족했는지는 몰라도, 조심스러운 반응이네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_LockedUp
#. Speaker = Player
#. NodeID = 5ab538e4-4790-438a-94eb-2de924657e8e
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_GENERIC
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_LockedUp:5ab538e4-4790-438a-94eb-2de924657e8e
msgctxt "h46f407d2g4f85g4de4gb2ccg244498bfe3ed"
msgid ""
"So much for honesty. Our healer turned into a jailor pretty quickly once she "
"heard about the tadpole."
msgstr "솔직함을 대가로 너무 많은 것을 치렀어. 올챙이 이야기를 듣자마자 치료사에서 간수로 변했잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Relieved
#. Speaker = Player
#. NodeID = 7a841e1f-f4f5-4df7-bdfe-de4f4559b5a6
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Relieved:7a841e1f-f4f5-4df7-bdfe-de4f4559b5a6
msgctxt "h3123dc6fg782ag45e6gba54gb98e9d48b867"
msgid "That was uncomfortably close. Imagine, being killed by a dwarf..."
msgstr "정말이지 아슬아슬했어. 드워프 손에 죽는다고 생각해 봐..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Relieved
#. Speaker = Player
#. NodeID = 7a841e1f-f4f5-4df7-bdfe-de4f4559b5a6
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Relieved:7a841e1f-f4f5-4df7-bdfe-de4f4559b5a6
msgctxt "h0732475ag35a3g4746g9dd0g6ef110bbf8cc"
msgid "The antidote's working. Gods, that was too close a call."
msgstr "해독제가 통하는구나. 신들이시여, 정말 아슬아슬했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Relieved
#. Speaker = Player
#. NodeID = 7a841e1f-f4f5-4df7-bdfe-de4f4559b5a6
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Relieved:7a841e1f-f4f5-4df7-bdfe-de4f4559b5a6
msgctxt "h632c4721gd1c2g4387ga373g280a0346fa3e"
msgid "That did the trick - don't think I'd have lasted much longer."
msgstr "치료가 통했어. 이게 아니었다면 더 이상 버티지 못했을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Relieved
#. Speaker = Player
#. NodeID = 7a841e1f-f4f5-4df7-bdfe-de4f4559b5a6
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Relieved:7a841e1f-f4f5-4df7-bdfe-de4f4559b5a6
msgctxt "h26ce9d43gebe1g42d4g8fb1g5cf3f7501332"
msgid "The antidote worked - the symptoms have lifted."
msgstr "해독제가 통했어. 증상이 사라졌다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Relieved
#. Speaker = Player
#. NodeID = 7a841e1f-f4f5-4df7-bdfe-de4f4559b5a6
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Relieved:7a841e1f-f4f5-4df7-bdfe-de4f4559b5a6
msgctxt "haa17f0a2g4996g447fg933ag16ea5bfd96e5"
msgid ""
"Poison's faded. Just my luck to find a healer, only to have her try to "
"<i>kill </i>me."
msgstr "독 기운이 가셨다. 기껏 치료사를 찾았더니 나를 <i>죽이려</i> 드는 꼴이라니, 팔자 하고는."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Relieved
#. Speaker = Player
#. NodeID = 7a841e1f-f4f5-4df7-bdfe-de4f4559b5a6
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Relieved:7a841e1f-f4f5-4df7-bdfe-de4f4559b5a6
msgctxt "h0fe71ccfg88e2g450dg80f1g7fe7097d9f33"
msgid "That was quick - I'm feeling better already."
msgstr "얼마 안 걸리네. 벌써 다 나은 것 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Relieved
#. Speaker = Player
#. NodeID = 7a841e1f-f4f5-4df7-bdfe-de4f4559b5a6
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_GENERIC
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_Relieved:7a841e1f-f4f5-4df7-bdfe-de4f4559b5a6
msgctxt "h7dfb1d86g2948g427fg8337g402b73fc2493"
msgid "I can feel the poison clearing - I'm cured!"
msgstr "독 기운이 가시는 느낌이 들어- 해독 됐군!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow
#. Speaker = Player
#. NodeID = 973d809a-5646-3b25-e292-a69f8ba8041b
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow:973d809a-5646-3b25-e292-a69f8ba8041b
msgctxt "hb6a2362dg244ag4ccfg85a7g61da15a25af9"
msgid "Part library, part morgue. An interesting combination."
msgstr "도서관 반, 영안실 반이라. 흥미로운 조합인데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow
#. Speaker = Player
#. NodeID = 973d809a-5646-3b25-e292-a69f8ba8041b
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow:973d809a-5646-3b25-e292-a69f8ba8041b
msgctxt "h2776747agd693g4eb4ga5bfg01c735349c57"
msgid "Speaks volumes as to the owner of the place."
msgstr "이 곳 주인이 어떤 자인지 안 봐도 뻔하군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow
#. Speaker = Player
#. NodeID = 973d809a-5646-3b25-e292-a69f8ba8041b
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow:973d809a-5646-3b25-e292-a69f8ba8041b
msgctxt "h6eb19cd6ga3a0g432bgb784g0952173a40d2"
msgid "This is weird, right? We can all agree this is weird."
msgstr "이거 이상하다, 그치? 이게 이상하단 말에 토 달 사람 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow
#. Speaker = Player
#. NodeID = 973d809a-5646-3b25-e292-a69f8ba8041b
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow:973d809a-5646-3b25-e292-a69f8ba8041b
msgctxt "hc0d4b8a2g53e5g47a2g8e1agf07139091869"
msgid ""
"Seems like the domain of a well-versed scholar - and not a squeamish one at "
"that."
msgstr "조예 깊은 학자의 영역처럼 보이네. 저런 쪽에 비위가 약한 사람도 아닌 것 같고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow
#. Speaker = Player
#. NodeID = 973d809a-5646-3b25-e292-a69f8ba8041b
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow:973d809a-5646-3b25-e292-a69f8ba8041b
msgctxt "h9dcff0a3g9790g4164gbe93gda1a9e3e96d5"
msgid "What manner of misfit curates a collection like this?"
msgstr "도대체 어떤 부적응자길래 이따위 수집품을 엄선해 놓는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow
#. Speaker = Player
#. NodeID = 973d809a-5646-3b25-e292-a69f8ba8041b
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow:973d809a-5646-3b25-e292-a69f8ba8041b
msgctxt "hce1a2b9bg5bb3g40e3g9be6g923286792bd1"
msgid "A peculiar collection. I'm keen to meet its curator."
msgstr "유별난 수집품이로군. 전시한 사람과 만나보고 싶어 근질거리네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow
#. Speaker = Player
#. NodeID = 973d809a-5646-3b25-e292-a69f8ba8041b
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: (REALLY_DROWELF or REALLY_DROWHALFELF) and REALLY_GENERIC
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow:973d809a-5646-3b25-e292-a69f8ba8041b
msgctxt "h02832bc7g26d2g4071ga033ga82e736a17b0"
msgid "I'm still wondering about the dead drow."
msgstr "아직도 그 죽은 드로우 생각이 가시질 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow
#. Speaker = Player
#. NodeID = 973d809a-5646-3b25-e292-a69f8ba8041b
#. HandlePath = TaggedText[7].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow:973d809a-5646-3b25-e292-a69f8ba8041b
msgctxt "hbcc783e1g3348g4234g8a22gfdf7bbad9041"
msgid "I can't tell if this is a temple or a library."
msgstr "여기가 신전인지 도서관인지 딱 잘라 말할 수가 없네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow
#. Speaker = Player
#. NodeID = bbe4382a-a617-ccd0-ec2e-6a03ee246500
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow:bbe4382a-a617-ccd0-ec2e-6a03ee246500
msgctxt "hec8d048dg2152g480dgbb02gd416d4c24fcf"
msgid "Never mind that - what a statue!"
msgstr "그건 신경 꺼. 이 석상 참 물건이네!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow
#. Speaker = Player
#. NodeID = bbe4382a-a617-ccd0-ec2e-6a03ee246500
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow:bbe4382a-a617-ccd0-ec2e-6a03ee246500
msgctxt "hbd3c6e0bgf6abg4b2fg8e7bg35379fbaa3d6"
msgid "And yet it's that statue that commands all attention."
msgstr "그럼에도 저 석상이 이목을 온통 장악하고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow
#. Speaker = Player
#. NodeID = bbe4382a-a617-ccd0-ec2e-6a03ee246500
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow:bbe4382a-a617-ccd0-ec2e-6a03ee246500
msgctxt "he0910478g2231g468egab2ege1d55a1c209b"
msgid "Nobody's going to mention the enormous wolf?"
msgstr "무지막지한 늑대 얘기는 아무도 안 꺼낼 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow
#. Speaker = Player
#. NodeID = bbe4382a-a617-ccd0-ec2e-6a03ee246500
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow:bbe4382a-a617-ccd0-ec2e-6a03ee246500
msgctxt "hbb463850gda09g44c6ga993g99b3813eabab"
msgid "Quite the statue. A formidable piece of stonework."
msgstr "꽤 상당한 석상이군. 가공할 석공술의 산물이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow
#. Speaker = Player
#. NodeID = bbe4382a-a617-ccd0-ec2e-6a03ee246500
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow:bbe4382a-a617-ccd0-ec2e-6a03ee246500
msgctxt "h03687c30g1589g4e08gb61eg835d45da4e69"
msgid "A wolf statue, too. What's the story here?"
msgstr "늑대 석상도 있어. 어떤 사연이 있는 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow
#. Speaker = Player
#. NodeID = bbe4382a-a617-ccd0-ec2e-6a03ee246500
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow:bbe4382a-a617-ccd0-ec2e-6a03ee246500
msgctxt "he2a54bf3ge48bg40c5gbd10g4c71c72ec3ec"
msgid "And what of this statue? A peculiar collection..."
msgstr "게다가 이 석상은 어떻고? 유별난 수집품이로군..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow
#. Speaker = Player
#. NodeID = bbe4382a-a617-ccd0-ec2e-6a03ee246500
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: (REALLY_DROWELF or REALLY_DROWHALFELF) and REALLY_GENERIC
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow:bbe4382a-a617-ccd0-ec2e-6a03ee246500
msgctxt "h2d0852fcg326fg461fgab9fg48023649dcdf"
msgid "I'm still wondering about the dead drow."
msgstr "아직도 그 죽은 드로우 생각이 가시질 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow
#. Speaker = Player
#. NodeID = bbe4382a-a617-ccd0-ec2e-6a03ee246500
#. HandlePath = TaggedText[7].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow:bbe4382a-a617-ccd0-ec2e-6a03ee246500
msgctxt "hb98f2465gf20ag4e6dgadcagdf9dc879d6f6"
msgid "And look at that statue."
msgstr "저 석상도 봐 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow
#. Speaker = Player
#. NodeID = e0e7014d-c4dc-402f-ce6e-536e20053e85
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow:e0e7014d-c4dc-402f-ce6e-536e20053e85
msgctxt "h0bb8f6d3g68ffg4303ga65cge7f5d40d1e6f"
msgid "And a dead tadpole in that brine."
msgstr "저기 죽은 올챙이도 절여 놨네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow
#. Speaker = Player
#. NodeID = e0e7014d-c4dc-402f-ce6e-536e20053e85
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow:e0e7014d-c4dc-402f-ce6e-536e20053e85
msgctxt "hafac5679g7cefg4315g8547ga31c67789288"
msgid "Notice the tadpole too - in that jar over there."
msgstr "저 올챙이도 주목해 봐. 저기 건너편 병 속에."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow
#. Speaker = Player
#. NodeID = e0e7014d-c4dc-402f-ce6e-536e20053e85
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow:e0e7014d-c4dc-402f-ce6e-536e20053e85
msgctxt "h395517b6gf6c6g431fg9782gb7390e1ddcf8"
msgid "And look, in the jar - one of our little tadpole friends."
msgstr "저기도 봐, 병 속에. 우리 귀여운 올챙이 친구도 보이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow
#. Speaker = Player
#. NodeID = e0e7014d-c4dc-402f-ce6e-536e20053e85
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow:e0e7014d-c4dc-402f-ce6e-536e20053e85
msgctxt "h2692d76dg5a24g409fg9842g299711e842a8"
msgid "There's a tadpole too, pickling in a jar."
msgstr "저기 올챙이도 있어. 병 속에 절여 놨네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow
#. Speaker = Player
#. NodeID = e0e7014d-c4dc-402f-ce6e-536e20053e85
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow:e0e7014d-c4dc-402f-ce6e-536e20053e85
msgctxt "h85fda5bag1dfcg4c78g97ecg33c46f21cb11"
msgid "Let's not overlook the tadpole in a jar."
msgstr "저기 병 속에 담긴 올챙이도 빼놓지 말자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow
#. Speaker = Player
#. NodeID = e0e7014d-c4dc-402f-ce6e-536e20053e85
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow:e0e7014d-c4dc-402f-ce6e-536e20053e85
msgctxt "ha6d9b66ag09e8g43efg90f3g248ebeef9041"
msgid "Forget the drow. This jar contains a parasite."
msgstr "드로우는 됐어. 이 병에 기생충이 담겨 있다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow
#. Speaker = Player
#. NodeID = e0e7014d-c4dc-402f-ce6e-536e20053e85
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: (REALLY_DROWELF or REALLY_DROWHALFELF) and REALLY_GENERIC
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow:e0e7014d-c4dc-402f-ce6e-536e20053e85
msgctxt "h949cf6d6g89a1g4220g8874g277d8c73c3b2"
msgid "Hardly a welcoming sight."
msgstr "보기 좋은 광경은 못 되는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow
#. Speaker = Player
#. NodeID = e0e7014d-c4dc-402f-ce6e-536e20053e85
#. HandlePath = TaggedText[7].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow:e0e7014d-c4dc-402f-ce6e-536e20053e85
msgctxt "h0148cfaeg2eb5g43afg9843g8352a7c5a2bd"
msgid "Is there a dead tadpole in that jar?"
msgstr "저기 병에 있는 게 죽은 올챙이야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow
#. Speaker = Player
#. NodeID = f39387ea-7bf8-31c3-9446-ea3f9c0ce515
