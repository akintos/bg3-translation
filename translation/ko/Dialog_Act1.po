msgctxt "h5e273e01g802bg46bcg8c64g2fe9a3fe78e2"
msgid "Gods, where is she?"
msgstr "신들이시여, 대체 어디 있는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_AD_Searching
