#, fuzzy
msgctxt "h7a5d3b7dgb620g4c08g8af9g83f7cf493dd6"
msgid "Always another evil to correct, always another monster to slay."
msgstr "죽여야 할 괴물은 끊이질 않는군, 안 그래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Narrator
#. NodeID = 4156a6f9-2394-01d1-de23-af955f7d0ed1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:4156a6f9-2394-01d1-de23-af955f7d0ed1
msgctxt "h3b7e4f34gd882g46adg8acfg3695976e03ed"
msgid "*The sovereign drones a new melody, cautious but insistent.*"
msgstr "*군주가 새로운 멜로디를 웅얼거립니다. 신중하면서도 집요합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Player
#. NodeID = 41b9ee27-e98f-f7ff-c220-369b3af4279a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:41b9ee27-e98f-f7ff-c220-369b3af4279a
msgctxt "h886908a2g6590g459cgb0a2gdb4e443a82b3"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Narrator
#. NodeID = 4280d12c-6900-8fac-7ac5-0ceabd0dde26
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - UND_MyconidSovereign_Event_BlissSpores(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:4280d12c-6900-8fac-7ac5-0ceabd0dde26
msgctxt "he6721c84g80ccg4504gbb73g048d6e97dc39"
msgid ""
"*Fragrant spores waft through the air. Your heart swells with bliss with "
"your every breath.*"
msgstr "*향기로운 포자가 공기 중에 퍼집니다. 숨을 쉴 때마다 당신의 심장이 환희로 부풀어 오릅니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Sovereign Spaw
#. NodeID = 44df3c2a-294a-4cfe-08ad-962c26be7a1e
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DUERGARDWARF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:44df3c2a-294a-4cfe-08ad-962c26be7a1e
msgctxt "h96c7ba0eg5f8bg4d86gaf6eg123726b3842c"
msgid "((*we laid waste to many. others remain. <b>you remain</b>*))"
msgstr "((*우리는 그들 중 다수를 죽였다. 나머지가 남아있다. <b>너도 포함해서</b>*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Sovereign Spaw
#. NodeID = 44df3c2a-294a-4cfe-08ad-962c26be7a1e
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:44df3c2a-294a-4cfe-08ad-962c26be7a1e
msgctxt "h2c93ae2ag708eg4460g97e8g477496f77bbd"
msgid "((*we laid waste to many. others remain*))"
msgstr "((*우리는 그들 중 다수를 죽였다. 나머지가 남아있다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Player
#. NodeID = 45ab9475-d43f-095f-600b-5731e741d79b
