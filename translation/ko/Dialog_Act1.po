msgctxt "h420cbdf1g632dg4508ga1d9g8b19dc8bdeef"
msgid "I can't, it's locked."
msgstr "그럴 수 없어요, 잠겼어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_TavernInvestigation_DesireDoor
#. Speaker = Counsellor Florrick
#. NodeID = a5103744-dd75-d518-2b1d-5b35014f6c40
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - PLA_GrandDukeRescue.FoundCounsellor(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_TavernInvestigation_DesireDoor:a5103744-dd75-d518-2b1d-5b35014f6c40
msgctxt "heb7911d4g2ccbg47d6gb8adge9291f72e26f"
msgid "I'm trapped! Someone, open this door!"
msgstr "안에 갇혔어! 이 문을 열어줘!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_TavernInvestigation_DesireDoor
#. Speaker = Player
#. NodeID = bcae62a5-7b5e-84f0-9c98-81efccce2cb5
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Strength
#. DifficultyClass: 10
#. CheckFlags:
