#.     - 2faeb2e2-9340-3d97-2441-b989f8b24e51_Knows_About_Moonrise = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_Cultist03_Dead:b64c3f59-e042-a586-1359-5ae9e0a69d14
msgctxt "h89b28c70g5575g4d4cg8e15g7a53d3359d3f"
msgid "Path to Moonrise Towers... Absolute... Answering the call..."
msgstr "문라이즈 타워로 가는 길... 절대자... 부름에 응답..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_Cultist03_Dead
#. Speaker = Player
#. NodeID = be1b6c28-b7f2-4a53-be41-13cb3c3147b3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_Cultist03_Dead:be1b6c28-b7f2-4a53-be41-13cb3c3147b3
msgctxt "h112ea3bfg798cg407bg807dg7e9750878d22"
msgid "Why were you so desperate to run?"
msgstr "왜 그렇게 필사적으로 도망친 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_Cultist03_Dead
#. Speaker = Corliss
#. NodeID = be895791-8781-417e-a682-0abe25c847a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_Cultist03_Dead:be895791-8781-417e-a682-0abe25c847a3
msgctxt "hcfc6b598g23efg4790g9c62g889ce73044cf"
msgid "Little house... Under a hill... Somewhere... Don't... Remember..."
msgstr "작은 집... 언덕 아래... 어딘가... 잘... 기억 안나..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_Cultist03_Dead
#. Speaker = Corliss
#. NodeID = c443ac14-145d-4b13-b857-b97f2114437c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_Cultist03_Dead:c443ac14-145d-4b13-b857-b97f2114437c
msgctxt "h735a8c3bg60d4g447egbfa7g20be03a434c9"
msgid "Corliss... Undertump..."
msgstr "콜리스... 언더텀프..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_Cultist03_Dead
#. Speaker = Player
#. NodeID = cba00a94-adf6-1f45-8cda-533bfee1bfe9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 2faeb2e2-9340-3d97-2441-b989f8b24e51_HeardAboutGeneral = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_Cultist03_Dead:cba00a94-adf6-1f45-8cda-533bfee1bfe9
msgctxt "hef851e64gbe4cg42e6gb3aag4c9b642e1489"
msgid "What 'General'?"
msgstr "어떤 '장군'?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_Cultist03_Dead
#. Speaker = Corliss
#. NodeID = d7612d7d-bd7d-b728-d1a0-5cbc63cd91b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_Cultist03_Dead:d7612d7d-bd7d-b728-d1a0-5cbc63cd91b6
msgctxt "h7a206232gcde2g40b1gabbag4818a4c44d50"
msgid "Chosen... Of the... Absolute..."
msgstr "선택받은 자... 절대자... 의..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_Cultist03_Dead
#. Speaker = Narrator
#. NodeID = e13bb5a1-a3e1-4f7f-9ef5-c478114096c3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_Cultist03_Dead:e13bb5a1-a3e1-4f7f-9ef5-c478114096c3
msgctxt "ha5ebb72age5d0g4d68gb70cg00932ca9d2c0"
msgid "*The corpse does not stir. It will answer no more questions.*"
msgstr "*시체는 움직이지 않습니다. 더 이상 질문을 받지 않을 것입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_Cultist03_Dead
#. Speaker = Narrator
#. NodeID = e5850532-a32d-4ca0-8f8f-b716f02890b6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_Cultist03_Dead:e5850532-a32d-4ca0-8f8f-b716f02890b6
msgctxt "hda4b39a9g5db2g4c5cg9cd2ge85d01ece55e"
msgid "*The corpse regards you lifelessly.*"
msgstr "*시체가 생기 없는 모습으로 당신을 맞이합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_Cultist03_Dead
#. Speaker = Player
#. NodeID = ec8d8ce9-96da-4a29-9ad8-4294740e5f85
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_Cultist03_Dead:ec8d8ce9-96da-4a29-9ad8-4294740e5f85
msgctxt "h1f12d133gb278g4227ga6ebg45296878611d"
msgid "Who are you?"
msgstr "넌 누구지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_Cultist03_Dead
#. Speaker = Corliss
#. NodeID = f55c9c6c-2d8b-4a96-a93c-d1154530b72f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_Cultist03_Dead:f55c9c6c-2d8b-4a96-a93c-d1154530b72f
msgctxt "h44de5748g54fbg4522ga660g0df8331f8ecc"
msgid "Scared... Heard... Bad things..."
msgstr "무서웠어... 들었어... 나쁜 이야기들..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_Cultist03_Dead
#. Speaker = Narrator
#. NodeID = fc630d45-0553-4f6a-8eca-3a2e5ec0a673
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_Cultist03_Dead:fc630d45-0553-4f6a-8eca-3a2e5ec0a673
msgctxt "h7777b622gca38g48c9g8239ga6ccb88836e5"
msgid "*The spell's power wanes. You can ask no more questions.*"
msgstr "*주문의 힘이 약해집니다. 더 이상 질문을 할 수 없습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_Cultist03_Dead
#. Speaker = Narrator
#. NodeID = ff9ff0c3-d62b-4d19-9a81-727dfb0f47cc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_Killer(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_Cultist03_Dead:ff9ff0c3-d62b-4d19-9a81-727dfb0f47cc
msgctxt "h30e6b104g8dc9g4e60g878bg5c1e3ebfa0d2"
msgid "*The corpse seems willing to speak - but not to its killer.*"
msgstr "*시체는 말할 의지가 있지만, 자신을 죽인 자와 대화하고 싶지는 않은 듯 합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_CultistsCapture
#. Speaker = Narrator
#. NodeID = 5ebad444-f3c2-f228-0f13-31534fdcc237
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_CultistsCapture:5ebad444-f3c2-f228-0f13-31534fdcc237
msgctxt "he01a4e5eg4727g475fg9dc6g6cc10ee5928e"
msgid ""
"*You have found your kin at last. You know to step carefully - the cultists "
"have the crèche on high alert.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_CultistsCapture
#. Speaker = Raider Add'ath
#. NodeID = 876ecc5f-3743-9a75-23fa-85a4a59a13ff
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_SecretOfArtefact_GuardMentionedCaptain = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_CultistsCapture:876ecc5f-3743-9a75-23fa-85a4a59a13ff
msgctxt "hb398cb20g3d0dg48fbg9340g45b31a408356"
msgid ""
"As I thought. Through the doors. <i>Now. </i>The Captain is expecting you."
msgstr "생각했던 대로야. 문으로. <i>지금. </i> 대장님이 기다리고 계셔."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_CultistsCapture
#. Speaker = Mahrin
#. NodeID = 98637ffc-6295-6f42-5a19-987c78676b89
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_CultistsCapture:98637ffc-6295-6f42-5a19-987c78676b89
msgctxt "h63ae74aeg3501g426fg923agfa50dae7d3f9"
msgid ""
"If this is about that 'weapon' your friend was talking about, we don't have "
"it, and we don't know shit about it!"
msgstr "당신의 친구분이 말한 '무기' 때문이라면, 저흰 그걸 가지고 있지도 않고 뭔지도 몰라요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_CultistsCapture
#. Speaker = Raider Add'ath
#. NodeID = 9e4da690-a9a3-66a3-f3ac-c6de03102aaa
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_Knows_CrecheLocation = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_CultistsCapture:9e4da690-a9a3-66a3-f3ac-c6de03102aaa
msgctxt "ha7178811g5b89g4562g9bfbg922ac26f58aa"
msgid "That's enough. On your feet."
msgstr "됐어. 일어나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_CultistsCapture
#. Speaker = Player
#. NodeID = ad343693-410a-b130-bff7-22056c7ab3f4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(5) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_CultistsCapture:ad343693-410a-b130-bff7-22056c7ab3f4
msgctxt "h9c0514d2gae02g43c6gbcd3gf04b9d065e78"
msgid "Forward - carefully. These cultists have the crèche on high alert."
msgstr "조심해서 전진하자. 광신도들 때문에 양성소의 경계가 삼엄하군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_CultistsCapture
#. Speaker = Raider Add'ath
#. NodeID = b7594613-837e-0550-99db-94d96ffe55dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_CultistsCapture:b7594613-837e-0550-99db-94d96ffe55dc
msgctxt "hc48ab424gb51eg4627gbb54ga80fb5282f3a"
msgid "Silence! Move."
msgstr "조용! 움직여라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_CultistsCapture
#. Speaker = Corliss
#. NodeID = ba17272b-4f2c-2dfc-b847-93dbef4c527b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_CultistsCapture:ba17272b-4f2c-2dfc-b847-93dbef4c527b
msgctxt "ha1557300gb36dg48edgbde5gbdeb7dfd19c5"
msgid "Ugh!"
msgstr "악!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_CultistsCapture
#. Speaker = Lae'zel
#. NodeID = cd65c6e3-bf43-44be-8f8a-92f3241b2513
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_CultistsCapture:cd65c6e3-bf43-44be-8f8a-92f3241b2513
msgctxt "h36a1fb90gf59cg4acbgaa7dgbdf53097582f"
msgid "Forward - carefully. These cultists have the crèche on high alert."
msgstr "조심해서 전진하자. 광신도들 때문에 양성소의 경계가 삼엄하군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_CultistsCapture
#. Speaker = Corliss
#. NodeID = d5c4d506-c3e5-448e-c391-56c19885e1b0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_CultistsCapture:d5c4d506-c3e5-448e-c391-56c19885e1b0
msgctxt "h99e8d559g1d07g4f51gbdeeg829517550d47"
msgid "Where are you taking us?"
msgstr "저흴 어디로 데려가는 거예요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_CultistsCapture
#. Speaker = Raider Add'ath
#. NodeID = edf1f8f2-e27a-7eea-d796-a68520bc9b69
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_Event_CultistKilled = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_CultistsCapture:edf1f8f2-e27a-7eea-d796-a68520bc9b69
msgctxt "h8a86491egd086g45fdg9d17gdd0cac66415b"
msgid "Anyone want to join her?"
msgstr "또 나대고 싶은 놈 있나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_CultistsCapture
#. Speaker = Corliss
#. NodeID = fa131059-c09f-543e-5e3a-46fabcd1503c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_CultistsCapture:fa131059-c09f-543e-5e3a-46fabcd1503c
msgctxt "had23e6e4g4635g400ag85aegc44658e90536"
msgid "No. No no no. I'm not going in there. I won't!"
msgstr "안 돼. 싫어, 싫어, 싫어. 안 들어갈래. 싫어!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_PAD_NearDeadBody
#. Speaker = Player
#. NodeID = 2027ac47-0c85-4024-bfa6-69313736de34
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_PAD_NearDeadBody:2027ac47-0c85-4024-bfa6-69313736de34
msgctxt "had688c48g3672g414dg9596g8905fed27785"
msgid "Is the enemy of my enemy my friend? Or do the gith only have enemies?"
msgstr "적의 적은 내 친구인가? 아니면 기스에게는 적만 있는 건가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_PAD_NearDeadBody
#. Speaker = Player
#. NodeID = 2027ac47-0c85-4024-bfa6-69313736de34
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_PAD_NearDeadBody:2027ac47-0c85-4024-bfa6-69313736de34
msgctxt "hfebc5d4eg9e5dg4c5cg8994ga7e539bcb093"
msgid ""
"Seems the githyanki came to blows with the cultists. Let's hope they keep "
"each other busy."
msgstr "기스양키가 광신도들과 싸움을 벌인 것 같네. 계속 그렇게 싸워서 서로 정신 없게 해줬으면 좋겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_PAD_NearDeadBody
#. Speaker = Player
#. NodeID = 2027ac47-0c85-4024-bfa6-69313736de34
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_PAD_NearDeadBody:2027ac47-0c85-4024-bfa6-69313736de34
msgctxt "h505e2eedg5501g446cg80ddge2d3962a9884"
msgid "Everyone hates the Absolute, I guess."
msgstr "모두가 절대자를 싫어하는 모양이군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_PAD_NearDeadBody
#. Speaker = Player
#. NodeID = 2027ac47-0c85-4024-bfa6-69313736de34
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_PAD_NearDeadBody:2027ac47-0c85-4024-bfa6-69313736de34
msgctxt "h89714d55g0b87g493dg9afbg0c191fe325d7"
msgid ""
"The cultists have made enemies of my people. They will be eager for my help."
msgstr "광신도들이 내 동족을 적으로 만들었군. 그들은 내 도움을 간절히 기다리고 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_PAD_NearDeadBody
#. Speaker = Player
#. NodeID = 2027ac47-0c85-4024-bfa6-69313736de34
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_PAD_NearDeadBody:2027ac47-0c85-4024-bfa6-69313736de34
msgctxt "ha54254a4g247bg414cg91c1g7d82a92e410e"
msgid ""
"So the gith are at odds with the Absolute as well. Now if only they'd just "
"wipe each other out..."
msgstr "그럼 기스는 절대자와도 대립하는 모양이군. 이제 그냥 서로를 쓸어버리면 좋겠는데..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_PAD_NearDeadBody
#. Speaker = Player
#. NodeID = 2027ac47-0c85-4024-bfa6-69313736de34
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_PAD_NearDeadBody:2027ac47-0c85-4024-bfa6-69313736de34
msgctxt "he97b6d7bg1e6bg4f15g80ddg32739dae02c5"
msgid ""
"The enemy of my enemy is my friend, they say. But I'm not so sure they're "
"right."
msgstr "적의 적은 내 친구라던데. 하지만 그게 맞는지는 모르겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_PAD_NearDeadBody
