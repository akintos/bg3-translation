#.      - UND_FearfulRothe_Event_ConvincedRotheToAttackRubble = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_002:f940f8f9-f52b-fe9a-5158-6b6150c0f935
msgctxt "had0d663cgbb3ag43adg9068g5d02243207fe"
msgid "<i>Nod to the rubble. Perhaps the creature will break through.</i>"
msgstr "<i>잔해 쪽으로 고개를 젓는다. 어쩌면 이 생명체들이 돌진해서 부숴버릴 수 있을지도 모른다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_002
#. Speaker = Deep Rothé
#. NodeID = fdf87951-f4ac-435b-9625-714d040da9cc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_FearfulRothe_HasMet_Rothe_002(1) = False
#.   Tag:
#.      - PETPAL(1) = False
#. SetFlags:
#.   Dialog:
#.     - UND_FearfulRothe_HasMet_Rothe_002(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_002:fdf87951-f4ac-435b-9625-714d040da9cc
msgctxt "hd1dd03cag5797g4316g9270ga3922157a360"
msgid "*Whinny.*"
msgstr "*히힝.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_RubbleAttack
#. Speaker = Herdmaster Skarjall
#. NodeID = 221b8472-3a0d-0720-4ba7-f2343cfa8804
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_FearfulRothe_Event_ShowedAdamantine = True
#. SetFlags:
#.   Global:
#.     - UND_AdamantineForge_Knows_Adamantine = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_RubbleAttack:221b8472-3a0d-0720-4ba7-f2343cfa8804
msgctxt "h398700a8g76a2g4bd4gbe53ga95e64525484"
msgid "Adamantine is precious, <i>jargh</i>. And I'm not the sharing type."
msgstr "아다만틴은 값비싼 물건이야, <i>자그</i>. 그리고 난 나눠줄 생각 같은 건 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_RubbleAttack
#. Speaker = Player
#. NodeID = 2982c8b6-083f-df7c-05be-d0032dc5bea7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_RubbleAttack:2982c8b6-083f-df7c-05be-d0032dc5bea7
msgctxt "h8527915bg1beeg4d37gb511g3b3fc0ad7109"
msgid "You'll be feeling even worse in a moment."
msgstr "그 기분, 곧 더 나빠질 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_RubbleAttack
#. Speaker = Herdmaster Skarjall
#. NodeID = 29ac920d-cf13-44b5-b8dc-b2e744dd4537
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_RubbleAttack:29ac920d-cf13-44b5-b8dc-b2e744dd4537
msgctxt "hf08c9b93gebc6g43d7ga2c1gbe67b6fc2a27"
msgid "What can I say? I'm a creature of habit."
msgstr "난들 어쩌겠어? 난 습관대로 사는 사람이라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_RubbleAttack
#. Speaker = Player
#. NodeID = 39454b1e-d590-0f2b-1966-3a61ff364d15
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_RubbleAttack:39454b1e-d590-0f2b-1966-3a61ff364d15
msgctxt "h62a36036g6948g4d80gbf4cged3612f9ab0e"
msgid "Stand down. I'm not trying to take <i>anything.</i>"
msgstr "진정해. 뭘 훔치려는 게 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_RubbleAttack
#. Speaker = Player
#. NodeID = 57677db5-5a18-1abf-6242-c2b96b1e2cf3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_UNDERDARK(1) = True
#.      - REALLY_DUERGARDWARF(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_RubbleAttack:57677db5-5a18-1abf-6242-c2b96b1e2cf3
msgctxt "h333a9eb1g59a0g4e4cg926fg52b0fd5acf3b"
msgid "I can't say I'm surprised. Hoped you'd be smarter, but not surprised."
msgstr "놀랍진 않군. 네가 좀 더 똑똑하길 바랐지만, 그럴 줄 알았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_RubbleAttack
#. Speaker = Herdmaster Skarjall
#. NodeID = 584bd9cb-6f16-0745-595c-585b35620708
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_RubbleAttack:584bd9cb-6f16-0745-595c-585b35620708
msgctxt "h46ea7e3fg5452g4bf9gacd0gcaed956c0844"
msgid "Aye. Serves you right, indeed."
msgstr "그래. 물론 당연한 일이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_RubbleAttack
#. Speaker = Player
#. NodeID = 613c6206-8ff2-44bc-cd9f-99ee358ac250
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_RubbleAttack:613c6206-8ff2-44bc-cd9f-99ee358ac250
msgctxt "h221348efg716ag4f74gbb89gb5022320771d"
msgid "What in the hells? I helped you, and now you want me dead?"
msgstr "뭐야? 내가 널 도와줬더니, 이제 날 죽이겠다고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_RubbleAttack
#. Speaker = Herdmaster Skarjall
#. NodeID = 704886ac-b7b2-c0a6-e0d3-f6d14454c27b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_RubbleAttack:704886ac-b7b2-c0a6-e0d3-f6d14454c27b
msgctxt "h8c5186c3gd883g4f69gbcfcg789dca722a93"
msgid "I almost feel bad about this."
msgstr "거의 기분이 나쁠 지경이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_RubbleAttack
#. Speaker = Herdmaster Skarjall
#. NodeID = a23dfcb2-4560-901f-39ee-4189404bb135
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_FearfulRothe_Event_MakeDuergarHostileInDialog = True
#.     - UND_AdamantineForge_Knows_Adamantine = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_RubbleAttack:a23dfcb2-4560-901f-39ee-4189404bb135
msgctxt "h106ee14fgfe6eg4a2cga33fgfef29218c8e9"
msgid "You tryin' to grab the adamantine back there for yourself?"
msgstr "저 뒤에서 아다만틴을 독식할 생각인가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_RubbleAttack
#. Speaker = Herdmaster Skarjall
#. NodeID = aa7f7be1-bcbd-a133-a75b-6a6624d3a43f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_FurnaceSearch_Event_DuergarMentionsForge = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_RubbleAttack:aa7f7be1-bcbd-a133-a75b-6a6624d3a43f
msgctxt "h3e6f6fd2g7eedg4a9dgb93ege06d85fe6d7c"
msgid "The metal and forge are the clan's - Laduguer's decree!"
msgstr "금속과 대장간은 우리 일족의 것이다. 러더거님의 명이야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_RubbleAttack
#. Speaker = Herdmaster Skarjall
#. NodeID = bca30dd7-48fa-781c-d9bf-e9879eb11bf0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_RubbleAttack:bca30dd7-48fa-781c-d9bf-e9879eb11bf0
msgctxt "haf3bccd2g37c3g4c0agaf09g51e5e2fa0086"
msgid ""
"Empty words, <i>jargh. </i>Adamantine's precious, and I'm not the sharing "
"type."
msgstr "빈말이로군, <i>자그. </i>아다만틴은 값비싼 물건이야, 그리고 그걸 나눠줄 생각 따위는 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_RubbleAttack
#. Speaker = Player
#. NodeID = c7327086-f6fb-7694-6cc3-646881097508
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_RubbleAttack:c7327086-f6fb-7694-6cc3-646881097508
msgctxt "h76bd9ffeg4df4g4471g8360g627056038d78"
msgid "What in the hells? What's this all about?"
msgstr "이런 세상에? 이게 대체 뭐야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_RubbleAttack
#. Speaker = Player
#. NodeID = cc92c2c5-4d90-f8cc-1c26-14d359acec65
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_RubbleAttack:cc92c2c5-4d90-f8cc-1c26-14d359acec65
msgctxt "h6765ebd5g3a5cg4f82g8d01g3f00c6abb89d"
msgid "You've started a fight you can't win."
msgstr "넌 지금 이길 수 없는 싸움을 건 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_RubbleAttack
#. Speaker = Herdmaster Skarjall
#. NodeID = d0e0ac69-ba99-f1ec-7d11-f17263b7add6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_FearfulRothe_State_ConvincedRotheToAttackRubble = True
#. SetFlags:
#.   Global:
#.     - UND_FearfulRothe_Event_MakeDuergarHostileInDialog = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_RubbleAttack:d0e0ac69-ba99-f1ec-7d11-f17263b7add6
msgctxt "hd5d74c19gc974g44eeg87dfgf6172e5da790"
msgid "Not enough caning for my tastes, but you got the job done."
msgstr "내 기준엔 못 미치지만, 어쨌든 일을 끝마쳤군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_RubbleAttack
#. Speaker = Player
#. NodeID = dddbeedd-fedb-370e-ec1b-7c1c8ea2ce54
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DUERGARDWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_RubbleAttack:dddbeedd-fedb-370e-ec1b-7c1c8ea2ce54
msgctxt "hb3424ee7g5b80g48e4g80f9gc5499e05aaa9"
msgid ""
"Should've known not to help a miserable excuse for a duergar. Serves me "
"right."
msgstr "듀에르가의 비참한 변명 따위는 듣지 않았어야 했어. 당연한 일이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_RubbleAttack
#. Speaker = Herdmaster Skarjall
#. NodeID = e6770f11-ce83-7020-4136-db5f3e9d9d6e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_FearfulRothe_Event_ShowedAdamantine = False
#. SetFlags:
#.   Global:
#.     - UND_AdamantineForge_Knows_Adamantine = True
#.     - UND_FurnaceSearch_Event_DuergarMentionsForge = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_RubbleAttack:e6770f11-ce83-7020-4136-db5f3e9d9d6e
msgctxt "h50bd00bdgb8deg4c5dg8fcbgcd4be5670ea9"
msgid ""
"There's an adamantine forge back there, <i>jargh. </i>And I'm not the "
"sharing type."
msgstr "저 뒤에 아다만틴 대장간이 있다, <i>자그. </i>그리고 나눠줄 생각 따위는 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_RubbleAttack
#. Speaker = Herdmaster Skarjall
#. NodeID = f84ecfff-b066-b1ed-fe2a-00aa47fafc97
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_RubbleAttack:f84ecfff-b066-b1ed-fe2a-00aa47fafc97
msgctxt "h0a1d97ecg0427g479dg856fgc680f0c5b529"
msgid "Adamantine is precious, <i>jargh</i>. And I'm not the sharing type."
msgstr "아다만틴은 값비싼 물건이야, <i>자그</i>. 그리고 난 나눠줄 생각 같은 건 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_DisguisedJournal
#. Speaker = Player
#. NodeID = 06aff4e4-8d19-fe9c-70c4-dadb3a18637b
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 5
#. CheckFlags:
#.   Global:
#.      - UND_FurnaceSearch_State_DisguisedJournalIllusionDropped = False
#.   Object:
#.      - UND_FurnaceSearch_State_TriedInvestigation(1) = False
#. SetFlags:
#.   Object:
#.     - UND_FurnaceSearch_State_TriedInvestigation(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_DisguisedJournal:06aff4e4-8d19-fe9c-70c4-dadb3a18637b
msgctxt "ha3e5ae86g2386g4923gb4fdg90d5d8110d90"
msgid "<i>Try to peer through the illusion.</i>"
msgstr "<i>환영을 들여다보려 노력한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_DisguisedJournal
#. Speaker = Player
#. NodeID = 0973890a-605f-cc9f-ad02-b35393f1419a
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - UND_FurnaceSearch_State_DisguisedJournalIllusionDropped = False
#.   Tag:
#.      - REALLY_UNDERDARK(1) = True
#.      - RANGER(1) = False
#.      - DRUID(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_DisguisedJournal:0973890a-605f-cc9f-ad02-b35393f1419a
msgctxt "h6c2a6966g9b9dg4f4eg9de7gab806c1d5b60"
msgid ""
"<i>Flumphs - largely benign parasites. But what do you know of their love "
"lives?</i>"
msgstr "<i>플럼프 - 대체로 온순한 기생충이다. 하지만 그들의 성 생활에 관해 아는 바가 있나?</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_DisguisedJournal
#. Speaker = Narrator
#. NodeID = 274d3e7f-d73a-fd3b-5208-dfd1e916dfc1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_FurnaceSearch_HasMet_DisguisedJournal(1) = True
#.   Global:
#.      - UND_FurnaceSearch_Knows_JournalDisguised = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_DisguisedJournal:274d3e7f-d73a-fd3b-5208-dfd1e916dfc1
msgctxt "hc6b3221fgbd13g46d8g967cg13d0d8699279"
msgid "*The cover is cool in your hand. And very <i>slightly</i> sticky.*"
msgstr "*표지는 약간 차갑습니다. 또한 아주 <i>살짝</i> 끈적하기도 합니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_DisguisedJournal
#. Speaker = Narrator
#. NodeID = 2ec61d36-f778-84bc-2a58-ad83d2db07c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_DisguisedJournal:2ec61d36-f778-84bc-2a58-ad83d2db07c0
msgctxt "hf952e044g112ag48b2gbf72gfd283c973009"
msgid ""
"*Mad supposition, questionable diagrams, and many gleeful references to "
"'tentacles'. Not an overly academic text.*"
msgstr ""
"*정신나간 상상, 수상한 그림, 그리고 신이 나서 떠들어대는 수많은 '촉수' 언급. 딱히 학문적 가치가 있는 서적 같지는 않습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_DisguisedJournal
#. Speaker = Narrator
#. NodeID = 3ac33f31-545d-9bb9-7438-aeac9ecc5299
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_DisguisedJournal:3ac33f31-545d-9bb9-7438-aeac9ecc5299
msgctxt "h1c0760fbg8be1g4931ga8f0gffda4b4dabfc"
msgid ""
"*Underdark fauna is a topic much written-on - but this title has never "
"appeared in any collection you've seen.*"
msgstr "*언더다크 동물학은 많이 다뤄진 주제이지만, 이 제목은 지금까지 당신이 본 어떤 컬렉션에도 등장한 적이 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_DisguisedJournal
#. Speaker = Player
#. NodeID = 44176d51-b758-9495-3c0c-f14ec93e4904
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - UND_FurnaceSearch_State_DisguisedJournalIllusionDropped = False
#.   Tag:
#.      - REALLY_UNDERDARK(1) = True
#.      - RANGER(1) = True
#.      - DRUID(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_DisguisedJournal:44176d51-b758-9495-3c0c-f14ec93e4904
msgctxt "h589f5e87gc1b0g4697gb00fg0f4d78c1a01d"
msgid ""
"<i>Flumphs - largely benign parasites. But what do you know of their love "
"lives?</i>"
msgstr "<i>플럼프 - 대체로 온순한 기생충이다. 하지만 그들의 성 생활에 관해 아는 바가 있나?</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_DisguisedJournal
#. Speaker = Narrator
#. NodeID = 44299c49-6ef9-c0b2-3fd4-38f3105f4077
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_DisguisedJournal:44299c49-6ef9-c0b2-3fd4-38f3105f4077
msgctxt "ha4655ed8g8f50g481aga0bfg469e892a584f"
msgid ""
"*Flumphs reproduce asexually - this text contends exactly the opposite, with "
"far too vivid details to match.*"
msgstr "*플럼프는 무성생식을 통해 번식합니다. 하지만 이 자료는 아주 생생한 묘사와 함께 정확히 그 반대의 내용을 주장하고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_DisguisedJournal
#. Speaker = Narrator
#. NodeID = 45623e3d-329e-40db-dc58-f5206af998ab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_DisguisedJournal:45623e3d-329e-40db-dc58-f5206af998ab
msgctxt "hed93ccd1g8382g4fbag889dgd120cbbd97c8"
msgid ""
"*Strain as you might, your eyes find nothing but an overly detailed "
"description of the flumph's reproductive process.*"
msgstr "*아무리 들여다보아도 눈에 보이는 것은 플럼프의 번식 과정에 대한 지나치게 상세한 설명뿐입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_DisguisedJournal
#. Speaker = Narrator
#. NodeID = 5afa9d9b-68cf-4c2b-9201-436a065d49ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_DisguisedJournal:5afa9d9b-68cf-4c2b-9201-436a065d49ac
msgctxt "h9519a71egca90g4f26g843eg92bef192f2cf"
msgid ""
"*It is exactly what it appears to be - a rather stained and unsavoury look "
"at the mating rituals of the common flumph.*"
msgstr "*보이는 그대로, 일반적인 플럼프의 짝짓기 의식의 다소 얼룩지고 불쾌한 모습입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_DisguisedJournal
#. Speaker = Player
#. NodeID = 61744f7b-9275-1213-b534-a84ddef0ba0e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - e3555e9d-9114-2faa-e9a2-857a04854354_Browsed = False
#. SetFlags:
#.   Local:
#.     - e3555e9d-9114-2faa-e9a2-857a04854354_Browsed = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_DisguisedJournal:61744f7b-9275-1213-b534-a84ddef0ba0e
msgctxt "he9131a9agfefdg43f9g81eegf78ffc1ba7a1"
msgid "<i>Browse the contents.</i>"
msgstr "<i>내용을 살펴본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_DisguisedJournal
#. Speaker = Player
#. NodeID = 63165164-2b68-4cc8-b584-9c298eb3e030
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_DisguisedJournal:63165164-2b68-4cc8-b584-9c298eb3e030
msgctxt "h72963ad2g133cg4d90gb898ga971c7318c41"
msgid "<i>Put it away.</i>"
msgstr "<i>집어넣는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_DisguisedJournal
#. Speaker = Narrator
#. NodeID = 67d4ff1b-aa3f-4c36-d624-782e69bce00a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_FurnaceSearch_State_FoundForgeManual = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_DisguisedJournal:67d4ff1b-aa3f-4c36-d624-782e69bce00a
msgctxt "h135abc4agb6cag45cag8be0gfb2d7860ae31"
msgid ""
"*What remains are simple instructions written in a spare hand: the secret to "
"forging adamantine.*"
msgstr "*남아 있는 것은 여분의 손으로 쓰인 간단한 지침입니다: 아다만틴을 단조하는 방법의 비밀.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_DisguisedJournal
#. Speaker = Narrator
#. NodeID = 6cd246f6-1480-7010-2309-577ea1d72865
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_DisguisedJournal:6cd246f6-1480-7010-2309-577ea1d72865
msgctxt "hf44a568ag19c7g4aa6g9d28g26400b3b0ab4"
msgid ""
"*Nothing. Flumphs are nomadic creatures, not well-suited to detailed "
"study<i>.*</i>"
msgstr "*아무것도 없습니다. 플럼프는 시기에 따라 이동하는 생명체로, 자세히 연구하기에는 적합하지 않습니다<i>.*</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_DisguisedJournal
#. Speaker = Player
#. NodeID = 82deae23-6078-40ac-916c-cd527ab27f23
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 15
#. CheckFlags:
