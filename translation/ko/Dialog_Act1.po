msgctxt "h7705e7bdg385eg43fag90ccg0f5238a67ad7"
msgid "<i>Give the foot a long lick.</i>"
msgstr "<i>발을 길게 핥는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = b76f8799-c46e-8da9-be5a-a07f4947a69b
