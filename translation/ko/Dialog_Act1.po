msgctxt "h5aed6711g917ag4b56gab99gc989f444cd94"
msgid "The kith'rak betrayed Vlaakith. What is he after?"
msgstr "이 키스‘락은 블라키스를 배반했군. 놈이 뭘 쫓고 있지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithCaptain_Dead
#. Speaker = Sarth Baretha
#. NodeID = caa51370-7dca-46f4-9fe2-1733b8fa4bb0
#. HandlePath = TaggedText[0].TagText[0]
