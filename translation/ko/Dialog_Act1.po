msgctxt "ha303b53dg59d9g4c36g9102gf3ed151bcff4"
msgid "Who are you?"
msgstr "넌 누구지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_DeadFisherman5_Dead
#. Speaker = Player
#. NodeID = 6d4b02ee-a9cb-6443-1526-055a74b5b64f
