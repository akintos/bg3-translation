#. SetFlags:
#.   Object:
#.     - FOR_ThayanCellar_Event_TriedToTrick(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:1ced50ac-c2db-b9af-8c8c-fa4924e670d0
msgctxt "hae3e8608g9c8cg465bg84e8g345fb9f57dc8"
msgid "<i>Pick up a rock to smash the mirror.</i>"
msgstr "<i>바위를 주워서 거울을 부순다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Player
#. NodeID = 207e223a-34d8-ddf7-b667-7c0da23751fc
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
