msgctxt "h0ffd0860g049dg46bfg8120gf60c93876f75"
msgid "I'm, eh - ...Krunk?"
msgstr "나는 음 ...크렁크?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Player
