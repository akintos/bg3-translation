msgctxt "ha2e151b8g744ag4babgb3f6g578a6b9476d4"
msgid "It's noble to protect one of your clan, but he's gone."
msgstr "네 가족을 지키려는 행동은 고귀하지만, 그는 이미 죽었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Narrator
#. NodeID = 4d859cd7-3864-b359-e871-3ad32015cebf
