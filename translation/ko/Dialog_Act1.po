msgid "Ah! I can't!"
msgstr "악! 안 되겠어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_TryJoinParty
#. Speaker = Benryn
#. NodeID = 30179856-47c8-0bf0-6813-b17f6518df25
