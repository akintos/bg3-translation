msgctxt "h316b2a9ag8cf3g4ec7g9900g05061fc0a2a3"
msgid ""
"If you're here to help with the raid, talk to her ladyship. She's in charge."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefBrave
#. Speaker = Rozzak
#. NodeID = 837ae800-b1f7-5da0-54ce-27075d175bc8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_WarchiefBrave_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefBrave:837ae800-b1f7-5da0-54ce-27075d175bc8
msgctxt "h5690a006g122cg4e5ag8cc5g2007753ec9a6"
msgid "If you ain't helpin', clear off."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefBrave
#. Speaker = Rozzak
#. NodeID = ceb0d7ab-bb55-f311-f53b-c73d0a267c31
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_WarchiefBrave_HasMet(1) = True
#.   Tag:
#.      - FEMALE(1) = True
#.      - DROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefBrave:ceb0d7ab-bb55-f311-f53b-c73d0a267c31
msgctxt "h11ce9e04g48dag4180ga8f3ge546b7bde87a"
msgid "Don't mind me, ma'am."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefBrave
#. Speaker = Rozzak
#. NodeID = db549e4a-b27e-3bc9-15c4-1c60a71e91be
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_WarchiefBrave_HasMet(1) = False
#.   Tag:
#.      - FEMALE(1) = True
#.      - DROWELF(1) = True
#. SetFlags:
#.   Dialog:
#.     - GOB_WarchiefBrave_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefBrave:db549e4a-b27e-3bc9-15c4-1c60a71e91be
msgctxt "ha6a3d59cg9261g4e29gb63bg0dddb1ba23d7"
msgid ""
"If you're here to join the raid, mistress, talk to her ladyship. She's in "
"charge."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefGrumpy
#. Speaker = Player
#. NodeID = 1382e0a2-843b-ad80-e6ae-ab91645bec82
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_HALFLING
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefGrumpy:1382e0a2-843b-ad80-e6ae-ab91645bec82
msgctxt "hb72f42b1g2bf1g4284g9234gb3241d9d6a67"
msgid "The fighting's done for now. Enjoy the feast."
msgstr "전투는 끝났잖아. 축제를 즐겨야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefGrumpy
#. Speaker = Player
#. NodeID = 1382e0a2-843b-ad80-e6ae-ab91645bec82
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefGrumpy:1382e0a2-843b-ad80-e6ae-ab91645bec82
msgctxt "h354c0375g7abfg4e7bga05ag19bf2f2a3a53"
msgid "Another fight? You should enjoy the spoils of the last one."
msgstr "또 싸운다고? 지난번 전투의 결과를 좀 즐기시지 그래."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefGrumpy
#. Speaker = Zurga
#. NodeID = 1a997d86-e734-6311-0c77-ae9d5f7d9e88
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefGrumpy:1a997d86-e734-6311-0c77-ae9d5f7d9e88
msgctxt "h3efd3550g678dg43a5gaf82g80a2cf075c74"
msgid "Her ladyship Minthara's tryin' to figure it out, studyin' the war map."
msgstr "민타라 아가씨가 전쟁 지도를 보며 방법을 강구하는 중이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefGrumpy
#. Speaker = Player
#. NodeID = 22fd8a39-59af-06a2-32bb-12eb0434560f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BRANDED(1) = True
#. SetFlags:
#.   Dialog:
#.     - GOB_WarchiefGrumpy_ShowedMark(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefGrumpy:22fd8a39-59af-06a2-32bb-12eb0434560f
msgctxt "h8d01c144g61aeg438cga091g0a8fd0ed024e"
msgid "I fight for the Absolute. I carry her brand on my skin."
msgstr "난 절대자의 낙인을 지니고 그분을 위해 싸워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefGrumpy
#. Speaker = Zurga
#. NodeID = 2fea9179-7877-6594-69ae-3de56c7648e0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_WarchiefGrumpy_HasMet(1) = True
#.      - GOB_WarchiefGrumpy_ShowedMarkHasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefGrumpy:2fea9179-7877-6594-69ae-3de56c7648e0
msgctxt "hd4be4a22ge7fcg4f0egb798gd64ef28abb71"
msgid "Praise the Absolute. And spill some guts in Her honour!"
msgstr "절대자님을 찬양하라. 그녀의 이름으로 피를 흘려라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefGrumpy
#. Speaker = Player
#. NodeID = 3dc072b2-50e9-8a2f-314e-a8ff4274752a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefGrumpy:3dc072b2-50e9-8a2f-314e-a8ff4274752a
msgctxt "h0904ce90g7551g4390gad82g23a3de2b6dc6"
msgid "Speaking of another fight - what's the next raid going to target?"
msgstr "전투 하니까 하는 말인데 - 다음 습격 대상은 누구야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefGrumpy
#. Speaker = Zurga
#. NodeID = 3edae161-df18-9416-0988-5dc6f954c058
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefGrumpy:3edae161-df18-9416-0988-5dc6f954c058
msgctxt "h77f1b493gb9d4g47d8g8fb4g1e678136ec6e"
msgid ""
"I've had my fill of feastin'. Rest of 'em can get fat and fuddled - I wanna "
"<i>kill</i> somethin'!"
msgstr "만찬은 충분히 즐겼어. 나머진 먹고 마시라고 해 - 난 뭔가 <i>죽이고</i> 싶다고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefGrumpy
#. Speaker = Zurga
#. NodeID = 5a86c4e0-359c-14d9-68b7-3ade72a9047d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefGrumpy:5a86c4e0-359c-14d9-68b7-3ade72a9047d
msgctxt "hc87ce1fag9ff9g4083g9e4fg8c9908dd7fae"
msgid "Smashin'! Wish you was part of my mob."
msgstr "죽여 주는걸! 네가 내 패거리였으면 좋았을 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefGrumpy
#. Speaker = Zurga
#. NodeID = 62a218ff-8dd4-5dc3-e743-5085620fa60b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefGrumpy:62a218ff-8dd4-5dc3-e743-5085620fa60b
msgctxt "he6531e79ge9fag4779g8c06g9e552ffd3078"
msgid ""
"Not me though. I'm as hard as they come, an' I'm itchin' for another fight."
msgstr "난 아니야. 존나 꼴려서 다음 전투를 기다릴 수가 없다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefGrumpy
#. Speaker = Zurga
#. NodeID = 66998ba3-1d68-cbd4-caa1-5510c7296170
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefGrumpy:66998ba3-1d68-cbd4-caa1-5510c7296170
msgctxt "hde964611g3ef4g4808g8ea5g69143ad6d0c6"
msgid "Er... let's hope it don't come to that, yer honour."
msgstr "어... 그렇게 안 되길 바라보죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefGrumpy
#. Speaker = Player
#. NodeID = 674b8d60-ddbc-5015-ae21-c56d9a0b137a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefGrumpy:674b8d60-ddbc-5015-ae21-c56d9a0b137a
msgctxt "h3154b5b6g8b95g495dgafe6g4d95c10b2865"
msgid "Indeed, by the bucket."
msgstr "당연하지. 피가 웅덩이를 이룰 정도로."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefGrumpy
#. Speaker = Zurga
#. NodeID = 7a30260c-4486-9c9b-f028-1273b121ba06
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefGrumpy:7a30260c-4486-9c9b-f028-1273b121ba06
msgctxt "hd8cb51f3g1fbbg495cg94e4g15e17dd6664d"
msgid ""
"Carve a mark on the next one you drop so's everyone knows who's in charge "
"around here!"
msgstr "다음에 쓰러뜨리는 놈한테 표식을 새겨서 모두가 여기 대장이 누구인지 알 수 있게 하라고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefGrumpy
#. Speaker = Zurga
#. NodeID = 8316e4c1-b43c-355d-d3b0-0a79ebc2a2b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefGrumpy:8316e4c1-b43c-355d-d3b0-0a79ebc2a2b3
msgctxt "hbab4d534gccd6g40aagb136g402f26cb1a4e"
msgid "Drow's studyin' the war map, tryin' to figure it out."
msgstr "드로우가 전쟁 지도를 보며 방법을 강구하고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefGrumpy
#. Speaker = Zurga
#. NodeID = 8734dea2-2afe-ded5-f774-574d981535a3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_WarchiefGrumpy_HasMet(1) = True
#.      - GOB_WarchiefGrumpy_ShowedMarkHasMet(1) = False
#.      - GOB_WarchiefGrumpy_ShowedMark(1) = True
#. SetFlags:
#.   Dialog:
#.     - GOB_WarchiefGrumpy_ShowedMarkHasMet(1) = True
#.   Global:
#.     - GLO_Absolute_Knows_GoblinsWorship = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefGrumpy:8734dea2-2afe-ded5-f774-574d981535a3
msgctxt "hb2e8c204g4016g42e3gbc7bgbae6ce4aecd5"
msgid "You been out there spillin' blood for the Absolute?"
msgstr "절대자님을 위해 피 좀 흘리고 다녔냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefGrumpy
#. Speaker = Zurga
#. NodeID = a48e06bd-8cb2-a164-225a-b6381e09bc42
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefGrumpy:a48e06bd-8cb2-a164-225a-b6381e09bc42
msgctxt "h2bc3e662ga6f5g47f9g937ag753ccba87b4a"
msgid ""
"Ha! Could do with more like you in my next raidin' mob. Keep yer blades "
"sharp."
msgstr "하! 다음 습격대에 널 껴야겠는걸! 칼 좀 갈아두라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefGrumpy
#. Speaker = Zurga
#. NodeID = adc3454f-556b-17ae-71f9-af3d7b6b1fe3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_WarchiefGrumpy_HasMet(1) = True
#.      - GOB_WarchiefGrumpy_ShowedMarkHasMet(1) = False
#.      - GOB_WarchiefGrumpy_ShowedMark(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefGrumpy:adc3454f-556b-17ae-71f9-af3d7b6b1fe3
msgctxt "h54b0ef21g0e00g4ee1gbe49gd2a703f58e1b"
msgid "You should come on the raid!"
msgstr "너도 습격에 참여해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefGrumpy
#. Speaker = Zurga
#. NodeID = c013d20c-e0f5-e0fe-368f-a465c70aaa26
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefGrumpy:c013d20c-e0f5-e0fe-368f-a465c70aaa26
msgctxt "hd390482cgfdbbg4b3cg9b3cgc589dcddafe8"
msgid ""
"Wot's more important than rippin' into some soft-gut? Get out there and kick "
"some arse!"
msgstr "나약한 놈들을 찢어발기는 것보다 뭣이 더 중요한데? 가서 깽판 좀 치자고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefGrumpy
#. Speaker = Player
#. NodeID = c2191845-73e8-0d0f-4dba-84f6cc2a4fe0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefGrumpy:c2191845-73e8-0d0f-4dba-84f6cc2a4fe0
msgctxt "h33b55d52g22c3g4bbeg9ce6ga57c821204d0"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefGrumpy
#. Speaker = Zurga
#. NodeID = c8b26d23-3fe9-7c6a-262e-b2600a97bdee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefGrumpy:c8b26d23-3fe9-7c6a-262e-b2600a97bdee
msgctxt "h11693a89g3eddg45b0g8c4ag62e61d467af8"
msgid "Good on ya, pal. Next raid, I'm gonna spill some guts in Her name!"
msgstr "잘됐네, 친구. 다음 습격 때 절대자의 이름으로 피를 흘리겠어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefGrumpy
#. Speaker = Zurga
#. NodeID = c96c66f4-ce9b-3789-ac1c-5a7ebc644456
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_WarchiefGrumpy_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_WarchiefGrumpy_HasMet(1) = True
#. TagRule: BESTIAL or HALFORC or RARE
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefGrumpy:c96c66f4-ce9b-3789-ac1c-5a7ebc644456
msgctxt "ha037b3b8g6b59g4dccgacfdg03ebb8c29375"
msgid ""
"'Alf the scrubs in 'ere would probably lose their nerve just <i>lookin'</i> "
"at you. Bunch of drunken layabouts."
msgstr "여기 있는 자식들은 널 <i>보기만</i> 해도 쫄아버릴 걸. 취한 게으름뱅이들 같으니라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefGrumpy
#. Speaker = Zurga
#. NodeID = c96c66f4-ce9b-3789-ac1c-5a7ebc644456
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_WarchiefGrumpy_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_WarchiefGrumpy_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefGrumpy:c96c66f4-ce9b-3789-ac1c-5a7ebc644456
msgctxt "hf504c302g5e87g4d26gbd14g9215983008fb"
msgid ""
"You look like you could kick the arse of half the scrubs in here. Bunch of "
"drunken layabouts."
msgstr "여기 있는 놈들 반수는 너한테 상대도 안 될 것 같네. 게으른 주정뱅이들 같으니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefGrumpy
#. Speaker = Player
#. NodeID = ce480dac-2a5a-20c1-315b-951a78be9b5a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefGrumpy:ce480dac-2a5a-20c1-315b-951a78be9b5a
msgctxt "h951fe13ag1cdeg4659g9f8cg97f7ef155792"
msgid "I've been busy - other matters needed my attention."
msgstr "난 바빠. 다른 할 일이 많다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefGrumpy
#. Speaker = Player
#. NodeID = e5befb7d-d177-3622-fc78-81ab6c435ce5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefGrumpy:e5befb7d-d177-3622-fc78-81ab6c435ce5
msgctxt "h33795e0bg9d7fg4190gac40g7202d9d52273"
msgid "I could take the whole camp - you included."
msgstr "난 이곳 기지 전체를 상대할 수도 있다. 널 포함해서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefGrumpy
#. Speaker = Zurga
#. NodeID = f530312e-4c92-b618-2500-e8282b121e3a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_Knows_LeaderNameDrow = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarchiefGrumpy:f530312e-4c92-b618-2500-e8282b121e3a
msgctxt "hd968fb42g8cb8g473agb979ged601aa3caf2"
msgid "You should talk to her... get the killin' started quicker."
msgstr "가서 말해봐... 좀 빨리 죽이게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarlockProposal_Warlock
#. Speaker = Korrilla
#. NodeID = 0bee5a36-fe16-3552-b3b7-259786af01bc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarlockProposal_Warlock:0bee5a36-fe16-3552-b3b7-259786af01bc
msgctxt "h91ac2ba1g9111g420fg874ag584b6005f6a3"
msgid "An observer. He's curious about you... and your <i>condition</i>."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarlockProposal_Warlock
#. Speaker = Korrilla
#. NodeID = 1607000c-bf95-d98c-370c-32aa49819087
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarlockProposal_Warlock:1607000c-bf95-d98c-370c-32aa49819087
msgctxt "h88754e70g01c7g4d17g879eg434c2d625df0"
msgid ""
"In the meantime, try not to get yourself killed. I won't always be watching."
msgstr "그때까지 죽지 않도록 해 봐요. 제가 매번 지켜볼 수는 없으니까요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarlockProposal_Warlock
#. Speaker = Korrilla
#. NodeID = 18551e8e-e87a-7a45-b8ad-8723734dcb73
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_TheMonitor_HasMet_TheMonitor = False
#. SetFlags:
#.   Global:
#.     - GLO_WarlockProposal_ReleasePlayer = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarlockProposal_Warlock:18551e8e-e87a-7a45-b8ad-8723734dcb73
msgctxt "h27e822c8g1a5bg4adeg8270g7a98a587e4a7"
msgid "You'll meet him soon, and have a chance to show your gratitude."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarlockProposal_Warlock
#. Speaker = Korrilla
#. NodeID = 1d60cc45-1431-6f68-17cc-ee0d4b112c49
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
