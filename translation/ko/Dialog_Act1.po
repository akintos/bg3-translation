msgctxt "h5af9a899g3548g4210gadc7gcaf40bdfe17b"
msgid "Well. Whatever happened in there, you don't look any worse for wear."
msgstr "안에서 무슨 일이 있었던 건지는 몰라도 제법 멀쩡해보이네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/AstralPlane/CRE_AstralPrison_PAD_ComingOutOfCave
#. Speaker = Player
#. NodeID = ddb20ef1-7153-4d38-9f66-ad5b04757510
