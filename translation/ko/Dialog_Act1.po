msgctxt "hf2a7a2fag7da7g4870g9142g5009022f596c"
msgid ""
"Captain Voss sent me in search of a weapon. I am bringing it to this crèche."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_AD_GithBoy_AssaultReaction
