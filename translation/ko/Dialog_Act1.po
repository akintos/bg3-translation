msgctxt "hee80394fg3f42g4797ga634g7b53b0467662"
msgid "Not a sound, people."
msgstr "숨소리도 내지마, 모두."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ParentA
#. Speaker = Locke
