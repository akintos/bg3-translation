#.      - PLA_ConflictedFlind_Hyena_002_HasMet(1) = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ConflictedFlind_Hyena_002:5b36d583-7480-bc06-309e-0e1cc9a0e2d5
msgctxt "hfecf3d4fg8dd1g45aeg89d1g171f61b967ae"
msgid "Stomach hurts. Stomach always hurts."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ConflictedFlind_Hyena_002
#. Speaker = Player
#. NodeID = 6001028e-da13-aaa6-04a2-339b82c8adfd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ConflictedFlind_Hyena_002:6001028e-da13-aaa6-04a2-339b82c8adfd
msgctxt "h303a0557g3632g4f25g8367g1315ab2ca577"
msgid "I'm a githyanki, beast."
msgstr "난 기스양키다, 하찮은 짐승아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ConflictedFlind_Hyena_002
#. Speaker = Hyena
#. NodeID = 64fdbad6-7a43-6805-f11e-6cc0e71f0509
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ConflictedFlind_Hyena_002:64fdbad6-7a43-6805-f11e-6cc0e71f0509
msgctxt "hc7876f7bg0008g4c02gaba5g5b42aea4db33"
msgid "Strange meat. Maybe you glow inside."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ConflictedFlind_Hyena_002
#. Speaker = Player
#. NodeID = 669ca531-aff8-2f19-3bdc-9a1cb2328623
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DUERGARDWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ConflictedFlind_Hyena_002:669ca531-aff8-2f19-3bdc-9a1cb2328623
msgctxt "he3b083a6g9e85g45a9gb986g56d24418e846"
msgid "I'm a duergar. Don't you have eyes?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ConflictedFlind_Hyena_002
#. Speaker = Player
#. NodeID = 93fcbbe5-f2fc-c759-40db-03122d9206fa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TIEFLING(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ConflictedFlind_Hyena_002:93fcbbe5-f2fc-c759-40db-03122d9206fa
msgctxt "h00d71867g43edg444cga1bbgeda4cf49206d"
msgid "The horns didn't cue you in? I'm a tiefling."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ConflictedFlind_Hyena_002
#. Speaker = Hyena
#. NodeID = 97d750fb-3d71-3869-e440-bdb041412cf3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ConflictedFlind_Hyena_002:97d750fb-3d71-3869-e440-bdb041412cf3
msgctxt "he71b7a1dgd185g44bag9210g7b30296bdd9e"
msgid "He makes us hungry. Always hungry."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ConflictedFlind_Hyena_002
#. Speaker = Hyena
#. NodeID = 990c640a-166b-e45e-cd0d-bfd6f0bb9a73
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ConflictedFlind_Hyena_002:990c640a-166b-e45e-cd0d-bfd6f0bb9a73
msgctxt "hb289b4f5g4072g49a6gb91fg1b753bff1666"
msgid "What does godmeat taste like? I... I gotta know."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ConflictedFlind_Hyena_002
#. Speaker = Hyena
#. NodeID = 9a08ea70-40cc-9c3c-2e09-89dada9a5d8a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ConflictedFlind_Hyena_002:9a08ea70-40cc-9c3c-2e09-89dada9a5d8a
msgctxt "h266cd879ga56cg4878g8b60ga65d0496c2cf"
msgid "Tough meat. Want to chew down to the bones."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ConflictedFlind_Hyena_002
#. Speaker = Player
#. NodeID = aab3955e-d014-3cb3-80a4-8d899f407c3f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_HALFORC(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ConflictedFlind_Hyena_002:aab3955e-d014-3cb3-80a4-8d899f407c3f
msgctxt "he07c8d9ag0555g4218gb4c7gee2fdddfe0d4"
msgid "Half of me is orc, if that's what you're asking."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ConflictedFlind_Hyena_002
#. Speaker = Player
#. NodeID = ababa6aa-f811-bfbf-99f5-2dbede8c051d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - HUMAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ConflictedFlind_Hyena_002:ababa6aa-f811-bfbf-99f5-2dbede8c051d
msgctxt "hea6c9617gcb84g4b4dg8d08g031fd03d1545"
msgid "Well, I'm human."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ConflictedFlind_Hyena_002
#. Speaker = Player
#. NodeID = b1f07775-8208-a51d-7aac-f550cf1f8b37
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ConflictedFlind_Hyena_002:b1f07775-8208-a51d-7aac-f550cf1f8b37
msgctxt "h41331ebag432eg4031g9193g5dc3506ee9f9"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ConflictedFlind_Hyena_002
#. Speaker = Player
#. NodeID = b340840c-52ed-aa83-591c-ddb8544a79b5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GNOME(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ConflictedFlind_Hyena_002:b340840c-52ed-aa83-591c-ddb8544a79b5
msgctxt "h636d33d3gaf62g4ef8g90aeg3f54f662fbd9"
msgid "Never seen a gnome before?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ConflictedFlind_Hyena_002
#. Speaker = Hyena
#. NodeID = bf9214e4-d0da-ebae-9da3-7028f1a08d29
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ConflictedFlind_Hyena_002:bf9214e4-d0da-ebae-9da3-7028f1a08d29
msgctxt "hf5a5d8d8g9ff4g4dbeg8fa2g2a304793ed5f"
msgid "We gotta eat. Better run. Better git. Or it'll be you."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ConflictedFlind_Hyena_002
#. Speaker = Hyena
#. NodeID = d1556aeb-a129-5eb1-d42c-949175b46fd3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ConflictedFlind_Hyena_002:d1556aeb-a129-5eb1-d42c-949175b46fd3
msgctxt "h17569fb8ge38dg4afegb28agf55df5f2ef65"
msgid "Grey meat. Tastes like earth. Tastes like pain."
msgstr "회색 고기잖아. 흙과 고통의 맛이 나지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ConflictedFlind_Hyena_002
#. Speaker = Hyena
#. NodeID = d198d862-7bf5-3db8-06d6-622eaf3d3374
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ConflictedFlind_Hyena_002:d198d862-7bf5-3db8-06d6-622eaf3d3374
msgctxt "h26ebe514g55a4g4044gb5a8ge3842951eaa4"
msgid "Heh. Heh. You are?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ConflictedFlind_Hyena_002
#. Speaker = Hyena
#. NodeID = d623d547-84d6-626f-d408-741d08609b3e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ConflictedFlind_Hyena_002:d623d547-84d6-626f-d408-741d08609b3e
msgctxt "h1c994781g390fg4021g9417gb71f8282e0e0"
msgid "Oh. Holy, good holy. We follow Yeenoghu holy."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ConflictedFlind_Hyena_002
#. Speaker = Player
#. NodeID = e41efaad-f59d-d2da-c726-5f0dea0f6445
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ConflictedFlind_Hyena_002:e41efaad-f59d-d2da-c726-5f0dea0f6445
msgctxt "h281443feg28b4g4411g85d3g63830140c2e2"
msgid "I wouldn't expect a hyena to recognise drow."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ConflictedFlind_Hyena_002
#. Speaker = Hyena
#. NodeID = e7cee454-fd3c-f980-9e46-6071cb381a88
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ConflictedFlind_Hyena_002:e7cee454-fd3c-f980-9e46-6071cb381a88
msgctxt "h0562e742g2431g4c33gb574g198cddb1e2b8"
msgid "Soft meat, uh-huh. That's what I thought."
msgstr "부드러운 고기잖아, 으하하. 내 생각 그대로야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 0215bf25-b340-e890-3334-a92111fbc211
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:0215bf25-b340-e890-3334-a92111fbc211
msgctxt "h7592ec34ge8c3g47dcgb35dg2079a10d027a"
msgid "It takes more than mere fire to break me, Pavel."
msgstr "날 무너뜨리려면 단순한 불꽃 만으론 부족해, 파벨."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 024054da-66f7-2de9-b0e3-a45df6cb07e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:024054da-66f7-2de9-b0e3-a45df6cb07e2
msgctxt "h80947460g1bffg438egbabege43a3b4b4771"
msgid ""
"Without him, the city faces collapse. In fact, I fear that may have been the "
"intention of those who abducted him."
msgstr "도시는 그분 없이 얼마 버티지 못할 겁니다. 납치범들이 사실은 그 부분을 노리고 일을 벌인 게 아닐지 몹시 걱정되는군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 02d34df8-2040-bae6-c724-bc714440e6b6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - HUMAN(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:02d34df8-2040-bae6-c724-bc714440e6b6
msgctxt "h6b5a5918g5387g487ag8d72gf69106b701bd"
msgid ""
"Ito - report to the manip and send for reinforcements. We must find the Duke."
msgstr "이토, 매닙에게 보고하고 지원 병력을 파견하도록. 반드시 대공님을 찾아야 한다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Wyll
#. NodeID = 03e026fb-19d9-3d68-e585-b60a57ce1c41
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:03e026fb-19d9-3d68-e585-b60a57ce1c41
msgctxt "h5a137ac0g3391g47cegb11dg18a740bc4bef"
msgid ""
"But pride is no reason to refuse help to my own flesh and blood. How can we "
"help?"
msgstr "그렇다 한들 내 혈육에 대한 의무까지 가벼워지는 건 아니지. 어떻게 도우면 되겠습니까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 0567bf49-167c-50f3-7219-a75bf23f554b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - HUMAN(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:0567bf49-167c-50f3-7219-a75bf23f554b
msgctxt "h77c41581g7fbcg47a6g812fg01eaf12005bd"
msgid ""
"Pavel - report to the manip and send for reinforcements. We must find the "
"Duke."
msgstr "파벨, 매닙에게 보고하고 지원 병력을 파견하도록. 반드시 대공님을 찾아야 한다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Wyll
#. NodeID = 059f7040-be92-9901-18f9-e6b80eeb7e2f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:059f7040-be92-9901-18f9-e6b80eeb7e2f
msgctxt "he7805704g204dg4e1aga913gf4ae114659d5"
msgid ""
"A story best left for calmer days. Now breathe deeply - are you in pain?"
msgstr "못다 한 이야기는 차차 나누시죠. 심호흡을 해 보세요. 통증이 있나요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 072d4019-f342-33f5-58f1-94302711a8d8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GLO_Desire_HasMet(5) = True
#.   Global:
#.     - PLA_Desire_Knows_RavengardTaken = True
#.   Quest:
#.     - PLA_GrandDukeRescue.LearnedDukeMissingCounsellor(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:072d4019-f342-33f5-58f1-94302711a8d8
msgctxt "h6e9a5193g2cebg4790g94cag5e649531c14a"
msgid ""
"Now listen close, fist: duty calls. Drow have taken Grand Duke Ulder "
"Ravengard - westward, if my eyes and ears can be believed."
msgstr ""
"이제 집중하도록, 피스트. 의무가 부른다. 드로우가 얼더 레이븐가드 대공님을 데려갔다. 내 눈과 귀가 정확하다면 서쪽으로 향했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 075c22d6-72bd-af44-3bbd-d809bea3b14f
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:075c22d6-72bd-af44-3bbd-d809bea3b14f
msgctxt "hd5e7acbdgc235g4a0dgbca0g4be2e7a31d47"
msgid "Your training serves you well, child of Gith. I'm in your debt."
msgstr "훈련을 잘 받으셨군요, 기스의 자식이여. 덕분에 신세 졌습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 075c22d6-72bd-af44-3bbd-d809bea3b14f
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DRAGONBORN and MALE
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:075c22d6-72bd-af44-3bbd-d809bea3b14f
msgctxt "he5448b88ge4b3g44deg8afbg9c60b6ab0584"
msgid "You honour your clan, sir. I'm in your debt."
msgstr "그대의 부족을 자랑스럽게 하는군요. 빚을 졌습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 075c22d6-72bd-af44-3bbd-d809bea3b14f
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: DRAGONBORN and FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:075c22d6-72bd-af44-3bbd-d809bea3b14f
msgctxt "h09f29c23ga65eg4243g82cbg5de2ec660fe5"
msgid "You honour your clan, miss. I'm in your debt."
msgstr "그대의 부족을 자랑스럽게 하는군요. 빚을 졌습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 075c22d6-72bd-af44-3bbd-d809bea3b14f
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:075c22d6-72bd-af44-3bbd-d809bea3b14f
msgctxt "hda905bdegd527g4a35g9e59g60e1eb26c7f2"
msgid "You honour your own name, Blade of Frontiers. I'm in your debt."
msgstr "그대의 이름에 걸맞은 활약이군요, 변경의 칼날. 빚을 졌습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 075c22d6-72bd-af44-3bbd-d809bea3b14f
#. HandlePath = TaggedText[4].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:075c22d6-72bd-af44-3bbd-d809bea3b14f
msgctxt "hd4ad4111g1e57g4cfagbf72gfb844a6d587d"
msgid "Your boldness is a blessing - I'm in your debt."
msgstr "당신의 대담함은 축복입니다. 당신에게 빚을 졌군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 0832e52b-70ba-99a8-6073-531b026c5134
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:0832e52b-70ba-99a8-6073-531b026c5134
msgctxt "h7535d54egd902g49b1gb87agbf04f0e21b3f"
msgid ""
"A scorched throat, a few hairs singed off. Nothing a bit of time and fresh "
"air can't cure."
msgstr "목구멍이 따갑고, 머리카락 몇 움큼 탄 정도입니다. 신선한 공기 좀 쐬면 금방 나을 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Wyll
#. NodeID = 0adf4109-cc14-0a5f-ac8d-95268d5fa309
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:0adf4109-cc14-0a5f-ac8d-95268d5fa309
msgctxt "h101af974g3cb4g4087g8032g5588a77a842b"
msgid "Trust us to see it through, Counsellor."
msgstr "저희가 책임질 테니 걱정 마세요, 자문관님."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 0eec7f1e-3102-1241-3c57-fe3d29e40ac1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GLO_Desire_HasMet(5) = True
#.   Global:
#.     - PLA_Desire_Knows_RavengardTaken = True
#.   Local:
#.     - 3c05c8ab-de4e-b1a5-691a-2f221d19fecf_NoFFPresent = True
#.   Quest:
#.     - PLA_GrandDukeRescue.LearnedDukeMissingCounsellor(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:0eec7f1e-3102-1241-3c57-fe3d29e40ac1
msgctxt "h4a826956g4c71g4255g94f5g527a140aaf06"
msgid "Listen, Wyll - the drow have taken Grand Duke Ravengard."
msgstr "잘 들으세요, 윌. 드로우들이 레이븐가드 대공을 납치해 갔습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 0f29a27e-1040-ef41-3e6a-099cc56c2a26
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - PLA_GrandDukeRescue.Counsellor_RefusedHelp(5) = True
#. TagRule: REALLY_WYLL and WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:0f29a27e-1040-ef41-3e6a-099cc56c2a26
msgctxt "h559239f0g37bcg4f13g9e94g12fd3d9bf318"
msgid ""
"I see the Blade's goodwill has limits. Far be it from me to stretch them."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 0f29a27e-1040-ef41-3e6a-099cc56c2a26
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Quest:
#.     - PLA_GrandDukeRescue.Counsellor_RefusedHelp(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:0f29a27e-1040-ef41-3e6a-099cc56c2a26
msgctxt "h20b21571g4a15g4109g9882g06bc511604de"
msgid "I see your goodwill has limits. Far be it from me to stretch them."
msgstr "당신의 선의에는 한계가 있나 보군요. 제가 그 한계를 늘려보라고 할 수는 없죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 0f32a1f8-7732-567b-b81d-1c784a8f8603
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:0f32a1f8-7732-567b-b81d-1c784a8f8603
msgctxt "h2664bd06ge89bg457dgafc4g909bd40919ad"
msgid ""
"He is the great champion of the Council, commander of the Flaming Fist - the "
"binding force holding Baldur's Gate together."
msgstr "그분은 4인 평의회의 위대한 수호자이시자, 발더스 게이트를 하나로 단합시키는 조직인, 플레이밍 피스트의 사령관이십니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 10e6fd7c-819e-dfe8-8993-5b5959e6ce71
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 3c05c8ab-de4e-b1a5-691a-2f221d19fecf_NoFFPresent = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:10e6fd7c-819e-dfe8-8993-5b5959e6ce71
msgctxt "h324ebe8dgc8dfg456cg9f98g0929af0ce53c"
msgid "I must report to the Flaming Fist manip, with haste."
msgstr "저는 플레이밍 피스트 매닙에게 하루 빨리 보고해야 합니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 11859997-d374-dafb-0930-d688deca0534
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GLO_Desire_HasMet(5) = True
#.   Global:
#.     - PLA_Desire_Knows_RavengardTaken = True
#.   Local:
#.     - 3c05c8ab-de4e-b1a5-691a-2f221d19fecf_NoFFPresent = True
#.   Quest:
#.     - PLA_GrandDukeRescue.LearnedDukeMissingCounsellor(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:11859997-d374-dafb-0930-d688deca0534
msgctxt "h0fe4b440g54eeg46a7g8c99gfa4c37dc6e02"
msgid "Listen, Wyll - the drow have taken Grand Duke Ravengard."
msgstr "잘 들으세요, 윌. 드로우들이 레이븐가드 대공을 납치해 갔습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 13ca370f-0e9f-713b-90e3-9cbddf8109f6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:13ca370f-0e9f-713b-90e3-9cbddf8109f6
msgctxt "ha901566dg16b2g4635gb8f6g153cc11eece8"
msgid ""
"Wyll, you must hold little love for your father. But please, find him and "
"return him to the city. Baldur's Gate needs him now, more than ever."
msgstr ""
"윌, 당신은 부친에게 아직까지 감정의 앙금을 품고 있겠죠. 하지만 부탁하겠습니다. 아버지를 찾아서 도시로 돌려보내 주세요. 발더스 "
"게이트는 어느 때보다도 그분이 필요합니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Player
#. NodeID = 175fabaf-9332-a623-c28a-bae1c726ed2b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:175fabaf-9332-a623-c28a-bae1c726ed2b
msgctxt "hec952e1ag7a2bg483fg82b8gd8fb0a04113f"
msgid "Why entrust this to me? You have others at your command."
msgstr "왜 저한테 이런 일을 맡기는 거죠? 당신의 휘하에 다른 이들도 많잖아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Player
#. NodeID = 1bf5ddad-abae-1e88-bf62-b4a9c63fff2f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:1bf5ddad-abae-1e88-bf62-b4a9c63fff2f
msgctxt "h39b7a55agedafg4c47g88f8gf0c970375ea2"
msgid "You'll have to find somebody else for the job."
msgstr "이 일에는 다른 사람을 찾으시죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Player
#. NodeID = 1d6970a2-6de2-9a21-7f04-83dd7142c1a3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Desire_State_AgreedToFindDuke = True
#. TagRule: REALLY_WYLL and WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:1d6970a2-6de2-9a21-7f04-83dd7142c1a3
msgctxt "hc1a01723gbe8fg49deg9fc6g748b4e6f4cdd"
msgid "Whoever holds my father is my target. I'll head west and find them."
msgstr "누구든 제 아버지를 붙잡은 자들은 제 적입니다. 서쪽으로 가서 그들을 찾겠습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Player
#. NodeID = 1d6970a2-6de2-9a21-7f04-83dd7142c1a3
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Desire_State_AgreedToFindDuke = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:1d6970a2-6de2-9a21-7f04-83dd7142c1a3
msgctxt "h4e32837bga554g4a86gae0eg2b027d5f4cdc"
msgid "I'll head west and find Duke Ravengard."
msgstr "서쪽으로 가서 레이븐가드 대공을 찾겠습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 1e5ab195-c1ac-8679-5b2d-2c0ce6260c27
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - HUMAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:1e5ab195-c1ac-8679-5b2d-2c0ce6260c27
msgctxt "h50a5716bg37fag460bga43dg31e53b4b07d6"
msgid ""
"Gauntlet, a new duty calls. Drow have taken Grand Duke Ulder Ravengard - "
"westward, if my eyes and ears can be believed."
msgstr "건틀렛, 새 임무다. 내 눈과 귀가 틀리지 않았다면, 드로우 놈들이 얼더 레이븐가드 대공을 서쪽으로 데려갔다. "

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 204c0f34-cacc-e079-cf21-ea3ac6777fda
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GLO_Desire_HasMet(5) = True
#.   Global:
#.     - PLA_Desire_Knows_RavengardTaken = True
#.   Quest:
#.     - PLA_GrandDukeRescue.LearnedDukeMissingCounsellor(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:204c0f34-cacc-e079-cf21-ea3ac6777fda
msgctxt "h5877a9e8g6983g4654g9284g81e04fb88665"
msgid "Listen, Wyll - the drow have taken Grand Duke Ravengard."
msgstr "잘 들으세요, 윌. 드로우들이 레이븐가드 대공을 납치해 갔습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 20e626b4-5772-8832-ca2a-dc75d11897ce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:20e626b4-5772-8832-ca2a-dc75d11897ce
msgctxt "heee2d57bg6da0g4986g8073g16c4164cbc61"
msgid "I'll empty every last of the Council of Four's coffers, if I must."
msgstr "필요하다면 4인 평의회의 금고를 몽땅 비울 수도 있습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 240836d6-d124-05d6-9ab7-7a52b10e6cf3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:240836d6-d124-05d6-9ab7-7a52b10e6cf3
msgctxt "hffd2038agf706g45dfga01bg88dda00af59d"
msgid ""
"A champion, indeed. He's the invisible force holding Baldur's Gate together."
msgstr "물론, 영웅이시죠. 그분이 발더스 게이트를 하나로 지탱하고 있는 보이지 않는 힘이나 마찬가지입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 24c7a361-5ea3-e189-e1db-5034b3b5eb92
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:24c7a361-5ea3-e189-e1db-5034b3b5eb92
msgctxt "ha368ed3dgb923g4bfcg94a4gbe99e319bca9"
msgid ""
"The invisible force holding Baldur's Gate together. Without him, the city's "
"collapse is certain."
msgstr "그분이 발더스 게이트를 하나로 지탱하고 있는 보이지 않는 힘이나 마찬가지입니다. 그분이 없어지면, 도시는 무너져 내릴 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Player
#. NodeID = 24e61e8f-4d1c-f76f-4096-ac6bd95efdc6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:24e61e8f-4d1c-f76f-4096-ac6bd95efdc6
msgctxt "h23d09c37gdcb0g4584gb3f4g3549510c8ea8"
msgid "You'll need to find him without my help - I've done all I can for now."
msgstr "그를 찾는 일은 알아서 하시죠, 전 이미 충분히 도와드렸습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 2ef72d76-fa0e-e6e3-9f86-07a61b3392be
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GLO_Desire_HasMet(5) = True
#.   Global:
#.     - PLA_Desire_Knows_RavengardTaken = True
#.   Quest:
#.     - PLA_GrandDukeRescue.LearnedDukeMissingCounsellor(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:2ef72d76-fa0e-e6e3-9f86-07a61b3392be
msgctxt "hf910ddc5gf9eeg4f6fga83cgb9a0701d0c3b"
msgid "Report to the manip and send for reinforcements. We must find the Duke."
msgstr "매닙에게 보고하고 지원군을 요청하도록. 반드시 공작을 되찾아야 한다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Player
#. NodeID = 2f99498c-e2b1-6744-1fa4-208a8558f741
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:2f99498c-e2b1-6744-1fa4-208a8558f741
msgctxt "h0053fd51gd092g4e8eg8073g776c943a9ba9"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Player
#. NodeID = 37b494d3-6832-6970-fd04-ff6fcc44e3f7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:37b494d3-6832-6970-fd04-ff6fcc44e3f7
msgctxt "hb53d76f3g0fe9g4feeg8b92g46903b8c5f6b"
msgid "A Grand Duke, you say? And what is his rescue worth to you?"
msgstr "대공이라고 했습니까? 그가 당신들에게 얼마나 중요한 인물이죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 391c0e5b-5831-e58c-c89d-26f76d5a7f9a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:391c0e5b-5831-e58c-c89d-26f76d5a7f9a
msgctxt "hb93e1885gac8eg47c2gbd47ga6a83c26ce37"
msgid "I fear that may have been the intention of those who abducted him."
msgstr "그게 바로 그를 납치한 자들의 의도는 아닌지 걱정입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 3a49a068-948f-8f38-b256-11762ebe00d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:3a49a068-948f-8f38-b256-11762ebe00d4
msgctxt "h0ca53b2egd2d0g4a0bg9f12g0da0f3bc3c18"
msgid ""
"As well you should. He is the great champion of the Council, commander of "
"the Flaming Fist - the binding force holding Baldur's Gate together."
msgstr ""
"물론 그렇겠죠. 그분은 4인 평의회의 위대한 수호자이시자, 발더스 게이트를 하나로 단합시키는 조직인, 플레이밍 피스트의 사령관이시니까요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Player
#. NodeID = 3d03b5ac-d0f7-4660-3d35-c986842e63dc
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:3d03b5ac-d0f7-4660-3d35-c986842e63dc
msgctxt "h544148abg1310g425agb809gf86345c6db23"
msgid "No, it can't be. You mean, they've taken -"
msgstr "안 돼, 그럴 리 없어. 그렇다면 놈들이..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Player
#. NodeID = 420d094d-07f9-de83-a938-5f8017400b75
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BALDURIAN(5) = False
#. SetFlags:
#.   Local:
#.     - 3c05c8ab-de4e-b1a5-691a-2f221d19fecf_AskedMore = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:420d094d-07f9-de83-a938-5f8017400b75
msgctxt "h742e1ee3gce2cg4588g9ef2gbc2b652adc80"
msgid "Ravengard? I don't know the name."
msgstr "레이븐가드? 처음 듣는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 4328b1e9-bee6-5989-0a4d-ed13af4831f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:4328b1e9-bee6-5989-0a4d-ed13af4831f3
msgctxt "hd74310b6g5271g4104gab19g314254d2d3b9"
msgid "I won't press for answers you won't give."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 485cadc4-1e74-2489-7b87-880b7201a991
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL and WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:485cadc4-1e74-2489-7b87-880b7201a991
msgctxt "h76aa67a6gcc63g4fe6g9732gdc27ad885a79"
msgid "This was no random attack. Your father was their target."
msgstr "마구잡이식 공격이 아니었습니다. 처음부터 당신 아버지를 노렸던 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 485cadc4-1e74-2489-7b87-880b7201a991
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:485cadc4-1e74-2489-7b87-880b7201a991
msgctxt "h7914e239g95aag4561gaf65g54cf147e1205"
msgid "This was no random attack. The Grand Duke was their target."
msgstr "이유 없는 공격이 아니었어요. 대공이 그들의 표적이었던 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 49a097d1-0cef-9662-0475-c10c6bc14936
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:49a097d1-0cef-9662-0475-c10c6bc14936
msgctxt "h54a49dcdg2e70g43d6g8180g87c6b4098df3"
msgid ""
"Wyll, you must hold little love for your father. But please, find him and "
"return him to the city. Baldur's Gate needs him now, more than ever."
msgstr ""
"윌, 당신은 부친에게 아직까지 감정의 앙금을 품고 있겠죠. 하지만 부탁하겠습니다. 아버지를 찾아서 도시로 돌려보내 주세요. 발더스 "
"게이트는 어느 때보다도 그분이 필요합니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Player
#. NodeID = 4b142cfd-ee15-2574-00e8-3549f6b64396
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Desire_State_AgreedToFindDuke = True
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:4b142cfd-ee15-2574-00e8-3549f6b64396
msgctxt "h6e57471ag8730g45bfgb05agdcdd42dee4e7"
msgid ""
"Duke Ravengard is my flesh and blood. I will travel west and rescue him."
msgstr "레이븐가드 대공님은 제 혈육입니다. 제가 서쪽으로 가서 그분을 구출하겠습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Player
#. NodeID = 4b142cfd-ee15-2574-00e8-3549f6b64396
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Desire_State_AgreedToFindDuke = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:4b142cfd-ee15-2574-00e8-3549f6b64396
msgctxt "h37d1965aga0aag4a4bg8cbcg2044bb9b660d"
msgid "I'll travel west and rescue Duke Ravengard."
msgstr "제가 서쪽으로 가서 레이븐가드 대공을 구출하겠어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 5084e36a-9e09-3141-d30a-1d7f4f43897b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_Inclusion_Wyll(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:5084e36a-9e09-3141-d30a-1d7f4f43897b
msgctxt "h5af40767geafcg4713g8f4dg67970767dda5"
msgid "I will seek reinforcements and join you when I can."
msgstr "전 증원군을 데리고 그들이 도착하면 따라갈게요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 5660361d-5029-496e-baa8-39b1d5c97dc8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:5660361d-5029-496e-baa8-39b1d5c97dc8
msgctxt "heabe3324g2b46g4f7bgb6f9g89a0da12da74"
msgid "... unless darker forces are at work."
msgstr "... 더 어두운 세력이 움직이기 시작한 게 아니라면 말이죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Player
#. NodeID = 56d3d950-c89f-d5dd-cf6f-9df1df06e743
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BALDURIAN(5) = True
#. SetFlags:
#.   Local:
#.     - 3c05c8ab-de4e-b1a5-691a-2f221d19fecf_AskedMore = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:56d3d950-c89f-d5dd-cf6f-9df1df06e743
msgctxt "h798abc16g4e8eg4e95gb80aga260d7eed01a"
msgid "Ravengard? I know that name."
msgstr "레이븐가드? 아는 이름인데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Player
#. NodeID = 5d23fd56-691b-8e93-0707-ca2c30000835
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3c05c8ab-de4e-b1a5-691a-2f221d19fecf_AskedMore = False
#.   Tag:
#.      - REALLY_WYLL(5) = False
#.      - BALDURIAN(5) = True
#. SetFlags:
#.   Local:
#.     - 3c05c8ab-de4e-b1a5-691a-2f221d19fecf_AskedMore = True
#. TagRule: REALLY_DARK_URGE
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:5d23fd56-691b-8e93-0707-ca2c30000835
msgctxt "heee0fe34g9f03g4a0bgabeeg63991f6f5ac1"
msgid ""
"Ravengard... I know that name... he is much beloved by the city, isn't he?"
msgstr "레이븐가드... 아는 이름이야... 도시에서 아주 인기 좋은 인물 아닌가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Player
#. NodeID = 5d23fd56-691b-8e93-0707-ca2c30000835
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3c05c8ab-de4e-b1a5-691a-2f221d19fecf_AskedMore = False
#.   Tag:
#.      - REALLY_WYLL(5) = False
#.      - BALDURIAN(5) = True
#. SetFlags:
#.   Local:
#.     - 3c05c8ab-de4e-b1a5-691a-2f221d19fecf_AskedMore = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:5d23fd56-691b-8e93-0707-ca2c30000835
msgctxt "h98e072b7g29a2g446dg90ddg14295e8c1d0f"
msgid "Ravengard's a champion to the people of Baldur's Gate."
msgstr "레이븐가드라면 발더스 게이트의 영웅이잖아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 5d4bd271-dde0-1bea-985c-9e14f856254a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_Desire_State_WyllComTrack = True
#.   Tag:
#.      - REALLY_WYLL(6) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:5d4bd271-dde0-1bea-985c-9e14f856254a
msgctxt "h23bde200gdc58g4e4ag9ae4g48a2022a8dfa"
msgid "Wyll, by the living gods! I couldn't have asked for a finer saviour."
msgstr "윌, 살아 계신 신들이시여! 때마침 구세주가 나타나셨군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 60730386-8247-f870-7133-07db7677f0d5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:60730386-8247-f870-7133-07db7677f0d5
msgctxt "h18f2f787gcfe2g48cdgbc82g3b1ec473c1f0"
msgid ""
"Please - rescue Ravengard from his drow captors. The Council will reward you "
"for your effort."
msgstr "부탁입니다, 드로우 납치범들에게서 레이븐가드 공을 구출해 주세요. 의회가 당신의 헌신에 꼭 보상해 줄 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Player
#. NodeID = 61430e35-adc3-889d-5e80-3a16a094c14a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3c05c8ab-de4e-b1a5-691a-2f221d19fecf_AskedMore = False
#.   Tag:
#.      - OATHBREAKER(5) = True
#. SetFlags:
#.   Local:
#.     - 3c05c8ab-de4e-b1a5-691a-2f221d19fecf_AskedMore = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:61430e35-adc3-889d-5e80-3a16a094c14a
msgctxt "h8b832995ga97cg4739ga7f6g4de1cf7a6629"
msgid ""
"I have no duty to nobles, dukes, or anyone. Any<i>thing</i> for that matter."
msgstr "귀족이든 공작이든, 그 누구든 의무를 진 적은 없어. 어떤 경우에도 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 61e8edfe-1a49-3248-b114-cd5968b96a4f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:61e8edfe-1a49-3248-b114-cd5968b96a4f
msgctxt "h90db676fgce3eg412dg9240g04c0fe8b249e"
msgid "Yes, Wyll. They have your father."
msgstr "그래요, 윌. 놈들이 당신 아버지를 붙잡았습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 6615e513-9a9e-96e4-0d53-6f7c66e85d46
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - HUMAN(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:6615e513-9a9e-96e4-0d53-6f7c66e85d46
msgctxt "hce945b67ga0abg48f8gb165g822971dd4425"
msgid ""
"Fist Ito, a new duty calls. Drow have taken Grand Duke Ulder Ravengard - "
"westward, if my eyes and ears can be believed."
msgstr "피스트 아이토, 새 임무다. 내 눈과 귀가 틀리지 않았다면, 드로우 놈들이 얼더 레이븐가드 대공을 서쪽으로 데려갔다. "

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 6aae9913-d5f6-4d1b-8c00-b73809f6be61
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(6) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:6aae9913-d5f6-4d1b-8c00-b73809f6be61
msgctxt "hed595580g9f8fg46b0gb215gdc50adbdfe2e"
msgid ""
"Remember, Wyll. 'Courage is found in the battle against fear, not in the "
"defeat of it.'"
msgstr "명심하렴, 윌. 무릇 '용기란 두려움을 물리칠 때가 아니라 맞서 싸울 때 솟아난다.'는 것을."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Player
#. NodeID = 6ac223e0-1f9f-3a2a-5cac-3329aac5a38f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3c05c8ab-de4e-b1a5-691a-2f221d19fecf_AskedMore = False
#.   Tag:
#.      - REALLY_UNDERDARK(5) = True
#. SetFlags:
#.   Local:
#.     - 3c05c8ab-de4e-b1a5-691a-2f221d19fecf_AskedMore = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:6ac223e0-1f9f-3a2a-5cac-3329aac5a38f
msgctxt "hbec07dafgb820g4edeg89b2gdeb3061b8cd0"
msgid "A duke? I owe no fealty to the nobles of the upper world."
msgstr "공작이라고? 내가 상류층 귀족한테 충성할 의무는 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 6b7798b1-a610-926f-4d3d-d00da99f4bda
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:6b7798b1-a610-926f-4d3d-d00da99f4bda
msgctxt "heb0aca5cgd784g45adgad32g12817b0aedcc"
msgid ""
"Yes. As Ravengard told me, where his son treads, the Hells fires are sure to "
"burn."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 6f921b45-bc3b-27bd-0fc6-6ca870355b35
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:6f921b45-bc3b-27bd-0fc6-6ca870355b35
msgctxt "h264b33a9gfd96g477dgb063g186473a55278"
msgid "It takes more than mere fire to break me, Aelis."
msgstr "날 무너뜨리려면 단순한 불꽃 만으론 부족해, 아엘리스."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 718e99ed-3af9-504a-5407-101e7a31dd2f
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:718e99ed-3af9-504a-5407-101e7a31dd2f
msgctxt "h2469e409g3b8ag4482g9022gee879b212264"
msgid ""
"Thank you. And should your courage falter, remember your father's generosity."
msgstr "감사합니다. 위태로운 상황에서 용기가 흔들리거든, 당신 아버지의 관대함을 기억하세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 718e99ed-3af9-504a-5407-101e7a31dd2f
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:718e99ed-3af9-504a-5407-101e7a31dd2f
msgctxt "h9d43e14egde22g4650g82c7g0c0295f5de35"
msgid ""
"Thank you. And should your courage falter, remember the Duke's generosity."
msgstr "고마워요. 그리고 당신의 용기가 흔들린다면, 대공님의 관대함을 기억하세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 732840b3-e128-a6d8-a976-25f49cd4f6d0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - HUMAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:732840b3-e128-a6d8-a976-25f49cd4f6d0
msgctxt "hd3d2922dge3acg4ff4g82f2gf6f1fdfb135f"
msgid ""
"Gauntlet - report to the manip and send for reinforcements. We must find the "
"Duke."
msgstr "건틀릿, 본부로 가서 보고하고 지원 병력을 파견하도록. 대공님을 반드시 찾아야 한다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 753124f0-feff-85a1-691a-0580343dbf3f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_Desire_Event_HasMet = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:753124f0-feff-85a1-691a-0580343dbf3f
msgctxt "hb72fb82dg0d9cg4eb8ga9eag7254145825ba"
msgid "Fresh air, at last."
msgstr "드디어, 신선한 공기를 좀 마실 수 있겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Fist Recruit Ito
#. NodeID = 7923bc07-fc85-131c-4bd1-ddcb66d0bc53
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:7923bc07-fc85-131c-4bd1-ddcb66d0bc53
msgctxt "he456aa7agd2b4g4cfcg9ccfgc47cfac6a16f"
msgid "On your command, Counsellor."
msgstr "명령을 따르겠습니다, 자문관님."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 7d2bf214-2e6d-2b47-361f-50fd3d24bfb5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_Desire_State_WyllComTrack = True
#.   Tag:
#.      - WYLL_DEVIL(6) = True
#.      - REALLY_WYLL(6) = True
#. SetFlags:
#.   Global:
#.     - GLO_Florrick_State_KnowsWyllDevil = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:7d2bf214-2e6d-2b47-361f-50fd3d24bfb5
msgctxt "h55e37c8bgbdbag4fdbg81bbged8b1dc0227b"
msgid "Wyll - by the Maimed God, what's become of you?"
msgstr "윌... 불구가 된 신이시여, 대체 어떻게 된 겁니까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Player
#. NodeID = 7d4013d1-5b54-ae01-0e46-d9b508aa4693
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:7d4013d1-5b54-ae01-0e46-d9b508aa4693
msgctxt "h4b077d6cg6513g4bbag95ddg4aaadb40a025"
msgid ""
"Whoever holds my father is my target. I'll head west and find them - trust "
"me to see it through."
msgstr "누구든 제 아버지를 붙잡은 자들은 제 적입니다. 서쪽으로 가서 그들을 찾아낼 테니, 절 믿으세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Player
#. NodeID = 7d435df8-1360-e5b8-cd18-e5060d7fd2ba
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Moonrise_Knows_Prisoners = True
#.      - PLA_Tavern_Knows_DukeAtTowers = False
#.      - GLO_Absolute_Knows_MoonriseTowers = False
#. TagRule: REALLY_WYLL and WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:7d435df8-1360-e5b8-cd18-e5060d7fd2ba
msgctxt "h81d85507g5a9ag42c9gac01ge645051d58fd"
msgid ""
"Goblins take their prisoners to Moonrise Towers. That's where we'll find my "
"father."
msgstr "고블린들은 사로잡은 포로를 문라이즈 타워로 압송합니다. 거기서 아버지를 찾을 수 있을 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Player
#. NodeID = 7d435df8-1360-e5b8-cd18-e5060d7fd2ba
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Moonrise_Knows_Prisoners = True
#.      - PLA_Tavern_Knows_DukeAtTowers = False
#.      - GLO_Absolute_Knows_MoonriseTowers = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:7d435df8-1360-e5b8-cd18-e5060d7fd2ba
msgctxt "h21b89655g4eeag48e5gb482g57b6f2c23f7f"
msgid ""
"Goblins take their prisoners to Moonrise Towers. That's where we'll find the "
"duke."
msgstr "고블린은 그들의 포로를 문라이즈 타워로 데려갑니다. 그곳에서 대공을 찾을 수 있을 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 7db31456-65aa-48f2-ce0b-42d02c59c8ee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:7db31456-65aa-48f2-ce0b-42d02c59c8ee
msgctxt "hfee36a93g750bg4c95gbb29g729e1af99589"
msgid "It takes more than mere fire to break me, Ito."
msgstr "날 무너뜨리려면 단순한 불꽃 만으론 부족해, 이토."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Player
#. NodeID = 7fcb208c-c78b-9228-b502-56ce0c8f9ba0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3c05c8ab-de4e-b1a5-691a-2f221d19fecf_AskedMore = False
#.   Tag:
#.      - REALLY_WYLL(5) = False
#.      - BALDURIAN(5) = True
#. SetFlags:
#.   Local:
#.     - 3c05c8ab-de4e-b1a5-691a-2f221d19fecf_AskedMore = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:7fcb208c-c78b-9228-b502-56ce0c8f9ba0
msgctxt "h5c9d8344gd778g4421gb36fg3047e7acc069"
msgid "I owe no fealty to some Upper City toff."
msgstr "상부 도시에 사는 나으리들의 신하가 되기로 한 적은 없는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 85a0c761-e6e7-b1a9-bb44-7a4ac6a42a76
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:85a0c761-e6e7-b1a9-bb44-7a4ac6a42a76
msgctxt "h1b4c0b42g90d0g4ba0g8f4eg23c0832cc9d4"
msgid ""
"By the time aid arrives, it might be too late. You've the heart of a dragon "
"and the will of a hero. Tell me I can count on you."
msgstr ""
"지원이 도착할 때가 되면, 너무 늦을 수도 있어요. 당신은 용의 심장과 영웅의 의지를 가졌습니다. 제가 당신을 믿어도 된다고 말해 줘요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 8a40eafa-7557-92c4-3111-e38a7a8e889d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:8a40eafa-7557-92c4-3111-e38a7a8e889d
msgctxt "hf9e6d76eg5b84g4ad8g82b7gfbea778e724d"
msgid ""
"Grand Duke Ravengard is the invisible force holding Baldur's Gate together."
msgstr "레이븐가드 대공이 발더스 게이트를 하나로 지탱하고 있는 보이지 않는 힘이나 마찬가지입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 8b7f52d5-b77a-88d5-0290-e1ac975abbff
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Moonrise_Knows_Prisoners = False
#.      - PLA_Tavern_Knows_DukeAtTowers = False
#.      - PLA_Desire_State_WyllComTrack = True
#.      - GLO_Absolute_Knows_MoonriseTowers = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:8b7f52d5-b77a-88d5-0290-e1ac975abbff
msgctxt "h775f8059ga65cg4f42gb747g0e6875e78c49"
msgid ""
"Thank you. When the Grand Duke returns to the city, he'll hail his only son "
"a hero."
msgstr "고맙군요. 대공께서 도시로 귀환하시면, 하나뿐인 아들을 영웅으로서 환대하실 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Wyll
#. NodeID = 9024a24c-3330-0ca3-7b38-468c5121cca7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:9024a24c-3330-0ca3-7b38-468c5121cca7
msgctxt "h4b155027g9fa8g45a4g9071g7f95882a936b"
msgid "No, it can't be. You mean, they've taken -"
msgstr "안 돼, 그럴 리 없어. 그렇다면 놈들이..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 9086bf0e-ed2e-71a0-324e-f214cdc647ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:9086bf0e-ed2e-71a0-324e-f214cdc647ed
msgctxt "h459b46a2gc55dg4946gad77g866a34d27c23"
msgid ""
"Without him, the city faces collapse. In fact, I fear that may have been the "
"intention of those who abducted him."
msgstr "도시는 그분 없이 얼마 버티지 못할 겁니다. 납치범들이 사실은 그 부분을 노리고 일을 벌인 게 아닐지 몹시 걱정되는군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 928b9c20-4764-dc58-cb27-42d66e8ceede
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:928b9c20-4764-dc58-cb27-42d66e8ceede
msgctxt "h98dbbfc4g782cg49d8g9a80g413be892bed5"
msgid "Wyll, by the living gods! I couldn't have asked for a finer saviour."
msgstr "윌, 살아 계신 신들이시여! 때마침 구세주가 나타나셨군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 97f363bd-47e9-df6d-09bb-5c86197a0fed
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3c05c8ab-de4e-b1a5-691a-2f221d19fecf_NoFFPresent = True
#. TagRule: REALLY_WYLL and WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:97f363bd-47e9-df6d-09bb-5c86197a0fed
#, fuzzy
#| msgid "Should you hear word of your father, seek me out. I will not fly far."
msgctxt "h939010abg371ag4cf7g81f8g27183b42a8ed"
msgid "Should you hear word of your father, seek me out. I will not fly far"
msgstr "아버님에 대한 소문이 들리면, 날 찾거라. 멀리 가지는 않을 테니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = 97f363bd-47e9-df6d-09bb-5c86197a0fed
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3c05c8ab-de4e-b1a5-691a-2f221d19fecf_NoFFPresent = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:97f363bd-47e9-df6d-09bb-5c86197a0fed
msgctxt "hf8591d07gc5e2g48a9ga7ecg6bac6407a07f"
msgid "Should you hear word of Ravengard, seek me out. I will not fly far."
msgstr "대공에 대한 소문이 들리면, 저를 찾아주세요. 멀리 가지는 않겠습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Player
#. NodeID = 9d8dbc0d-f626-f183-79aa-9ced990da204
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:9d8dbc0d-f626-f183-79aa-9ced990da204
msgctxt "h45274da4g19a5g4650g9926g6e6dd835f7b4"
msgid "Let's just say I got mixed up with the wrong crowd."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Player
#. NodeID = a16c163c-892e-b0a8-9319-e6bf6f9096e7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Moonrise_Knows_Prisoners = True
#.      - PLA_Tavern_Knows_DukeAtTowers = False
#.      - GLO_Absolute_Knows_MoonriseTowers = True
#. TagRule: REALLY_WYLL and WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:a16c163c-892e-b0a8-9319-e6bf6f9096e7
msgctxt "hc7c2b4ffg884bg4686g8b53g70b2a0375c56"
msgid ""
"The Absolute's cult is based at Moonrise Towers. That's where they'll have "
"taken father."
msgstr "문라이즈 타워에 절대자 교단이 자리 잡고 있어요. 아버지를 거기로 데려갔을 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Player
#. NodeID = a16c163c-892e-b0a8-9319-e6bf6f9096e7
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Moonrise_Knows_Prisoners = True
#.      - PLA_Tavern_Knows_DukeAtTowers = False
#.      - GLO_Absolute_Knows_MoonriseTowers = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:a16c163c-892e-b0a8-9319-e6bf6f9096e7
msgctxt "h6728d948g33efg4a83g90e4g0e770fe065fb"
msgid ""
"The Absolute's cult is based at Moonrise Towers. That's where they'll have "
"taken the duke."
msgstr "문라이즈 타워에 절대자 교단이 자리 잡고 있어요. 공작을 거기로 데려갔을 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Player
#. NodeID = a40dd9e6-cb4f-6c0a-9c73-d67dfc003ff3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:a40dd9e6-cb4f-6c0a-9c73-d67dfc003ff3
msgctxt "h25ba9c64g7740g474bgabf6g1ef9d96ae089"
msgid "That's my business, and no one else's."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = a455ef5c-e96e-c0e4-5145-55dc6a2e49ff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:a455ef5c-e96e-c0e4-5145-55dc6a2e49ff
msgctxt "h27c79093g010dg4a60g9181g65faecc5e885"
msgid ""
"A scorched throat, a few hairs singed off. Nothing a bit of time and fresh "
"air can't cure."
msgstr "목구멍이 따갑고, 머리카락 몇 움큼 탄 정도입니다. 신선한 공기 좀 쐬면 금방 나을 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = a4e0432f-54b6-ce29-5367-8efb5da5d7e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:a4e0432f-54b6-ce29-5367-8efb5da5d7e6
msgctxt "hb34d9f15gead9g4c1fg9cd2g9b13c8a76f1d"
msgid "It is not fealty I ask, but a great favour on behalf of our city."
msgstr "당신에게 충성을 요구하는 게 아닙니다. 저희 도시를 위해 큰 부탁을 하는 것이죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = a7ab4058-175d-c14e-e0b7-4e0327007d65
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:a7ab4058-175d-c14e-e0b7-4e0327007d65
msgctxt "h2b2f08eeg49e3g4160gaaefgaea41e976f82"
msgid "Yes, Wyll. They have your father."
msgstr "그래요, 윌. 놈들이 당신 아버지를 붙잡았습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Player
#. NodeID = a9f258f7-7201-8498-5c42-369f6b751400
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:a9f258f7-7201-8498-5c42-369f6b751400
msgctxt "h1c902626ga346g4243gb596gb5affd71ffa8"
msgid "Wyll, you are the son of nobility?"
msgstr "윌, 귀족 집안의 자제셨겠다?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Wyll
#. NodeID = b0017d0b-2cca-43f4-8af9-0c011def329a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_Desire_State_WyllComTrack = True
#.   Local:
#.     - 3c05c8ab-de4e-b1a5-691a-2f221d19fecf_WyllSpoke = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:b0017d0b-2cca-43f4-8af9-0c011def329a
msgctxt "hfcb86435ge45cg4d1cgaf3aga6afb1b86cfb"
msgid "Counsellor Florrick - are you all right?"
msgstr "플로릭 자문관님, 다친 곳은 없으십니까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Fist Recruit Aelis
#. NodeID = b0390440-6aac-1670-faee-97bbddc86a08
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - HUMAN(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:b0390440-6aac-1670-faee-97bbddc86a08
msgctxt "hdc05962cg5d98g44b0g8bebg04e73a1750fb"
msgid "Counsellor - are you all right?!"
msgstr "자문관님, 다친 곳은 없으십니까?!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = b3f30e1a-7d7e-9776-6c76-d027eea573e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:b3f30e1a-7d7e-9776-6c76-d027eea573e7
msgctxt "h09bb3bf0g003dg4e94g95eagb3a428a068ff"
msgid "May I trust you'll see it through?"
msgstr "믿어도 될까요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Player
#. NodeID = b6efa182-e3d8-13be-ba15-d85de478cb20
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3c05c8ab-de4e-b1a5-691a-2f221d19fecf_AskedMore = False
#. SetFlags:
#.   Local:
#.     - 3c05c8ab-de4e-b1a5-691a-2f221d19fecf_AskedMore = True
#. TagRule: REALLY_GITHYANKI or REALLY_PLANAR
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:b6efa182-e3d8-13be-ba15-d85de478cb20
msgctxt "h5a198835g98d6g465dg9f5eg332647dd21b3"
msgid "A duke? I owe no fealty to the nobles of this world."
msgstr "공작이라고? 내가 이 세계의 귀족에게 충성을 맹세한 적은 없다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = b6f2c68f-1e2c-cf54-dcf7-0446252d171f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:b6f2c68f-1e2c-cf54-dcf7-0446252d171f
msgctxt "hac4411d9g97dbg4135g94a8gb9da8cba96c6"
msgid "It is not fealty I ask, merely a great favour on behalf of my city."
msgstr "충성을 다하라고 하는 것이 아닙니다. 저희 도시를 위해 큰 부탁을 드리는 것이지요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = b770ae04-3b59-bdbd-b96c-2eaafb0d47af
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:b770ae04-3b59-bdbd-b96c-2eaafb0d47af
msgctxt "h1e70f31cg2583g4350gbb73g6101985d1bc0"
msgid "Yes, Wyll. The drow have your father."
msgstr "그래요, 윌. 드로우들이 당신 아버지를 데려갔습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = b88c5c98-52d7-a54c-f30d-66cbbb40780c
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:b88c5c98-52d7-a54c-f30d-66cbbb40780c
msgctxt "h86c7ac48gd425g4039gacf5g3a7e9972c36f"
msgid "And you, githyanki - I must ask again for your aid."
msgstr "그리고 기스양키, 당신. 다시 한번 도움을 요청해야겠군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = b88c5c98-52d7-a54c-f30d-66cbbb40780c
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:b88c5c98-52d7-a54c-f30d-66cbbb40780c
msgctxt "hb1956fe0gb836g4667g8405geba6cee17fa6"
msgid "And you - I must ask again for your aid."
msgstr "그리고 당신. 도움을 한 번 더 요청해야겠군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Player
#. NodeID = b9d3389b-6751-2114-3501-39227a4c07b6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3c05c8ab-de4e-b1a5-691a-2f221d19fecf_AskedMore = False
#.   Tag:
#.      - REALLY_UNDERDARK(5) = False
#.      - REALLY_PLANAR(5) = False
#.      - REALLY_WYLL(5) = False
#.      - REALLY_GITHYANKI(5) = False
#. SetFlags:
#.   Local:
#.     - 3c05c8ab-de4e-b1a5-691a-2f221d19fecf_AskedMore = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:b9d3389b-6751-2114-3501-39227a4c07b6
msgctxt "h60fb0562g91d4g4517gbb04g22d8c9b23beb"
msgid "Who is this Duke Ravengard?"
msgstr "이 레이븐가드 대공이라는 자는 누구죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = ba6f7040-b685-dc0d-694f-e04b5c72b376
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - PLA_GrandDukeRescue.Counsellor_AcceptedHelp_Moonrise(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:ba6f7040-b685-dc0d-694f-e04b5c72b376
msgctxt "ha9eb60ebge959g4d40g87bdg00780c48a4bf"
msgid ""
"Approach the Towers with care - the land itself has been swallowed in shadow."
msgstr "문라이즈로 향할 때는 조심하도록 하세요. 그 땅 자체가 그림자에 삼켜졌으니 말입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = bcc01387-ad54-80dc-9351-ec738f68d296
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:bcc01387-ad54-80dc-9351-ec738f68d296
msgctxt "hd12e3867g3ed0g4e91gb0b6ga16f5afc3a51"
msgid ""
"Wyll, you must hold little love for your father. But please, find him and "
"return him to the city."
msgstr "윌, 당신은 부친에게 아직까지 감정의 앙금을 품고 있겠죠. 하지만 부탁하겠습니다. 아버지를 찾아서 도시로 돌려보내 주세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Narrator
#. NodeID = bdb68fa1-5bfb-8b55-e844-c6e617f3401c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:bdb68fa1-5bfb-8b55-e844-c6e617f3401c
msgctxt "hcecae3a7gd45eg4fc1gb3a8g55cf221a768b"
msgid ""
"*She is a ghost from your past come to haunt you - Counsellor Florrick, your "
"father's closest confidante, and a loyal servant of Baldur's Gate.*"
msgstr ""
"*그녀는 당신을 괴롭히는 과거에서 온 유령입니다. 자문관 플로릭, 당신의 아버지의 가장 가까운 친구이자, 발더스 게이트의 충직한 "
"공복입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = be01b10c-18bb-239e-8105-689c22f3908b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - PLA_GrandDukeRescue.Counsellor_AcceptedHelp_NoLocation(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:be01b10c-18bb-239e-8105-689c22f3908b
msgctxt "hc0ff4b93gbf70g473fg885fg6ea005ddfece"
msgid "Go. You should pick up the drow trail with ease."
msgstr "가세요. 드로우 흔적은 발견하기 쉬울 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Fist Recruit Pavel
#. NodeID = bf6fbd7f-7aa5-d66f-73b1-53465edde748
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:bf6fbd7f-7aa5-d66f-73b1-53465edde748
msgctxt "h03152bf2g252dg4d1aga71ag6d4f3b383124"
msgid "On your command, Counsellor."
msgstr "명령을 따르겠습니다, 자문관님."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Narrator
#. NodeID = bfc114a1-c105-8a83-5860-660fbee04b45
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:bfc114a1-c105-8a83-5860-660fbee04b45
msgctxt "ha87ce3b3g2cdag4be3g9963gc1b4b6778356"
msgid ""
"*Grand Duke Ulder Ravengard - the man you call your father. The man who cast "
"you from your home after pacting with Mizora.*"
msgstr "*대공작 얼더 레이븐가드. 당신이 아버지라 부르는 사람. 미조라와 계약한 후 당신을 고향에서 추방한 사람.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = c367dc76-2fa4-3f31-58ad-1feffec849dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:c367dc76-2fa4-3f31-58ad-1feffec849dc
msgctxt "h307f9029g70bag41a0g898fge0e08c64143a"
msgid "Yes, Wyll. The drow have your father."
msgstr "그래요, 윌. 드로우들이 당신 아버지를 데려갔습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Wyll
#. NodeID = c477fb19-7eb8-3b58-f2c7-68bd831ea38d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(6) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:c477fb19-7eb8-3b58-f2c7-68bd831ea38d
msgctxt "h71682004g381dg4f31g8981gb9f6b89103a9"
msgid "So father said. I won't soon forget."
msgstr "부친께서 가라사대. 제가 어떻게 잊겠습니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Gauntlet Yeva
#. NodeID = c5f78f78-8378-225e-4fe9-8b51609c658b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - HUMAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:c5f78f78-8378-225e-4fe9-8b51609c658b
msgctxt "h20505980ge309g4486gb6f9gf878a96da51d"
msgid "Counsellor - are you all right?!"
msgstr "자문관님, 다친 곳은 없으십니까?!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = cb0d0cd9-7b2e-8038-1d1f-663e93fb7168
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - HUMAN(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:cb0d0cd9-7b2e-8038-1d1f-663e93fb7168
msgctxt "hc3c64d15g9416g40abgb85eg23c8aa832807"
msgid ""
"Fist Pavel, a new duty calls. Drow have taken Grand Duke Ulder Ravengard - "
"westward, if my eyes and ears can be believed."
msgstr "피스트 파벨, 새 임무다. 내 눈과 귀가 틀리지 않았다면, 드로우 놈들이 얼더 레이븐가드 대공을 서쪽으로 데려갔다. "

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Player
#. NodeID = cbc9e0c9-c176-fcea-0c09-8520d298a048
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(5) = True
#.      - OATHBREAKER(5) = False
#. SetFlags:
#.   Global:
#.     - GLO_Desire_State_AgreedToFindDuke = True
#. TagRule: REALLY_WYLL and WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:cbc9e0c9-c176-fcea-0c09-8520d298a048
msgctxt "ha122a06dg7994g4ff8gb096gcb8ff749ac40"
msgid "On my oath: I will see my father rescued, and his captors vanquished."
msgstr "제 서약에 따라, 제 아버지를 구출하고, 그분을 납치한 이들을 멸하도록 하겠습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Player
#. NodeID = cbc9e0c9-c176-fcea-0c09-8520d298a048
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(5) = True
#.      - OATHBREAKER(5) = False
#. SetFlags:
#.   Global:
#.     - GLO_Desire_State_AgreedToFindDuke = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:cbc9e0c9-c176-fcea-0c09-8520d298a048
msgctxt "h39f44e93g9f94g4420g9e7eg00fa916468ed"
msgid ""
"On my oath: I will see Duke Ravengard rescued, and his captors vanquished."
msgstr "제 서약에 따라, 레이븐가드 대공을 구출하고, 그를 납치한 이들을 멸하도록 하겠습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = cc84ec48-5d4c-3bc3-aa21-8ad621d14d61
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:cc84ec48-5d4c-3bc3-aa21-8ad621d14d61
msgctxt "hca026086g171fg40f1gae91g6bcb9d0d4f2e"
msgid ""
"The rest of you - count the dead. Take word of their sacrifice to the city."
msgstr "나머지는 사상자 수를 확인하도록. 그들의 희생을 도시에 알려야 한다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Fist Recruit Pavel
#. NodeID = cde5f3e0-f908-00f0-299a-2f63e1409bfd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - HUMAN(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:cde5f3e0-f908-00f0-299a-2f63e1409bfd
msgctxt "hcde9d9edg3519g4b4cg8274gd0db636a83ca"
msgid "Counsellor - are you all right?!"
msgstr "자문관님, 다친 곳은 없으십니까?!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = cf8f7017-95d4-8692-fea4-df3a7e855ad2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:cf8f7017-95d4-8692-fea4-df3a7e855ad2
msgctxt "h3a6c07ffg1932g4a72ga6dfg2f6920a09814"
msgid "It takes more than mere fire to break me, Yeva."
msgstr "날 무너뜨리려면 단순한 불꽃 만으론 부족해, 예바."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = cfb823b7-4c4e-6680-c9fd-80de427bdff8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:cfb823b7-4c4e-6680-c9fd-80de427bdff8
msgctxt "h1eb4939fg3aefg4d0aga34dge0f5e1773d63"
msgid "Fist: to work."
msgstr "피스트, 일을 시작하도록."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Player
#. NodeID = d1d7cdd6-ba6b-2c89-ded7-1c52fafd70f9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_Desire_State_WyllComTrack = True
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:d1d7cdd6-ba6b-2c89-ded7-1c52fafd70f9
msgctxt "hb5325431g3511g4bfcg9596g286d8be09f76"
msgid "Counsellor Florrick - are you all right?"
msgstr "플로릭 자문관님, 다친 곳은 없으십니까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = d696f1c1-97fd-1620-3758-e30517e8d415
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - HUMAN(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:d696f1c1-97fd-1620-3758-e30517e8d415
msgctxt "h6aa82fbcgb071g4350gbedagb2767734dea1"
msgid ""
"Aelis - report to the manip and send for reinforcements. We must find the "
"Duke."
msgstr "이엘리스, 매닙에게 보고하고 지원 병력을 요청하도록. 반드시 대공님을 찾아야 한다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = d80528d2-8979-314a-0575-85b35c7a8b15
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Florrick_State_KnowsWyllDevil = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:d80528d2-8979-314a-0575-85b35c7a8b15
msgctxt "h253a6d1cg7f35g4d01g8a31gbaa89378a556"
msgid ""
"Thank you so - no, it can't be. Wyll, by the living gods, what's happened to "
"you?"
msgstr "정말 고마 - 이럴 수가. 윌, 신이시여, 도대체 무슨 일이 있었던 거죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Wyll
#. NodeID = e24b67e7-e0a7-28b0-0117-a991f912d4a2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:e24b67e7-e0a7-28b0-0117-a991f912d4a2
msgctxt "h83e5ae55gec50g4fdega8b4g727c07785b2f"
msgid ""
"The circumstance of my birth is no matter of pride for neither me nor my "
"father."
msgstr "내 출생 배경 따윈 우리 부자에게 아무런 자랑거리도 되지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = e2840aaf-0f7e-89f0-8ce4-746608763739
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - HUMAN(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:e2840aaf-0f7e-89f0-8ce4-746608763739
msgctxt "h3fd6b92egdb55g4c59gaf70g2e86314afbeb"
msgid ""
"Fist Aelis, a new duty calls. Drow have taken Grand Duke Ulder Ravengard - "
"westward, if my eyes and ears can be believed."
msgstr "피스트 아엘리스, 새 임무다. 내 눈과 귀가 틀리지 않았다면, 드로우 놈들이 얼더 레이븐가드 대공을 서쪽으로 데려갔다. "

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Gauntlet Yeva
#. NodeID = e40e90cc-a61d-dfce-f77a-1fc940364046
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:e40e90cc-a61d-dfce-f77a-1fc940364046
msgctxt "h2a78aab1gc671g4a60gbb71g19844ba1c083"
msgid "On your command, Counsellor."
msgstr "명령을 따르겠습니다, 자문관님."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Player
#. NodeID = e4f9b9be-466c-f11a-8621-1415d54fcf2f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_Tavern_Knows_DukeAtTowers = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:e4f9b9be-466c-f11a-8621-1415d54fcf2f
msgctxt "hef9a517egd7efg4645g8fe6gb8956febd75e"
msgid "The drow took the Duke to Moonrise Towers."
msgstr "드로우가 대공을 문라이즈 타워로 끌고갔어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Player
#. NodeID = e5668fe8-698a-fa42-c102-bd3ba1d45180
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Moonrise_Knows_Prisoners = False
#.      - PLA_Tavern_Knows_DukeAtTowers = False
#.      - GLO_Absolute_Knows_MoonriseTowers = True
#. TagRule: REALLY_WYLL and WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:e5668fe8-698a-fa42-c102-bd3ba1d45180
msgctxt "hb68ca01bg3622g4c88g8caeg8f44637594d9"
msgid ""
"The Absolute's cult is based at Moonrise Towers. That's where they'll have "
"taken father."
msgstr "문라이즈 타워에 절대자 교단이 자리 잡고 있어요. 아버지를 거기로 데려갔을 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Player
#. NodeID = e5668fe8-698a-fa42-c102-bd3ba1d45180
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Moonrise_Knows_Prisoners = False
#.      - PLA_Tavern_Knows_DukeAtTowers = False
#.      - GLO_Absolute_Knows_MoonriseTowers = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:e5668fe8-698a-fa42-c102-bd3ba1d45180
msgctxt "h3be3d4ccg209dg4e61g8048ge6dc8c035b59"
msgid ""
"The Absolute's cult is based at Moonrise Towers. That's where they'll have "
"taken the duke."
msgstr "문라이즈 타워에 절대자 교단이 자리 잡고 있어요. 그들은 공작을 거기로 데려갔을 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = e66bd575-97a2-45d4-9508-85e14e179416
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:e66bd575-97a2-45d4-9508-85e14e179416
msgctxt "h0cea74eegf078g4980g9655g20160386088c"
msgid ""
"Wyll, you must hold little love for your father. But please, find him and "
"return him to the city."
msgstr "윌, 당신은 부친에게 아직까지 감정의 앙금을 품고 있겠죠. 하지만 부탁하겠습니다. 아버지를 찾아서 도시로 돌려보내 주세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Player
#. NodeID = e683e74e-50dc-143e-b7e4-a24b4e1863d2
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:e683e74e-50dc-143e-b7e4-a24b4e1863d2
msgctxt "he7ac49d4g2403g418egbd1dgace00cfec32c"
msgid ""
"A story best left for calmer days. Now breathe deeply - are you in pain?"
msgstr "못다 한 이야기는 차차 나누시죠. 심호흡을 해 보세요. 통증이 있나요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = e977c2a4-6f5d-1a32-f235-035a78c638cc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:e977c2a4-6f5d-1a32-f235-035a78c638cc
msgctxt "h40a53e22g85eag4e89g9fdcgec33563ac992"
msgid "Calmer days are not soon to come, Wyll - as I'm sure you know."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = ea5cf306-5198-da71-ee90-912227c61398
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:ea5cf306-5198-da71-ee90-912227c61398
msgctxt "h9eb0e822gbbe2g4388g9439g8487177add51"
msgid ""
"Rescue Ravengard from his drow captors. Baldur's Gate needs him now, more "
"than ever."
msgstr "드로우 납치범들에게서 레이븐가드 공작을 구해 주세요. 발더스 게이트는 어느 때보다도 그분이 필요합니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = ef077da7-c330-b70e-c253-d5b9f339cef5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3c05c8ab-de4e-b1a5-691a-2f221d19fecf_WyllSpoke = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:ef077da7-c330-b70e-c253-d5b9f339cef5
msgctxt "hb1b609dcg2e9fg4f07g9d75gbf5d3ff5951f"
msgid ""
"Isn't it clear? You travel with the Blade of Frontiers. Who might I trust, "
"if not a legend? Who might rise to the moment, if not Ravengard's own son?"
msgstr ""
"당연하지 않겠어요? 당신은 변경의 칼날과 함께 다니잖아요. 전설을 믿지 못한다면, 누굴 믿어야 하죠? 레이븐가드의 아들이 아니라면, 누가 "
"이 순간에 나설 수 있죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = f2102885-758b-13c3-a645-aad6a3c51c60
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WYLL(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:f2102885-758b-13c3-a645-aad6a3c51c60
msgctxt "he74bdda1g98ceg45fag9d5ag8ea6a88285ee"
msgid ""
"Isn't it clear? The Blade is known for action. Who might I trust, if not a "
"legend? Who might rise to the moment, if not Ravengard's own son?"
msgstr ""
"당연하지 않겠어요? 칼날은 행동을 실천하기로 유명하죠. 전설을 믿지 못한다면, 누굴 믿어야 하죠? 레이븐가드의 아들이 아니라면, 누가 이 "
"순간에 나설 수 있죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = f28ba247-28a7-00da-a6db-f2af4f3b3e3a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_Desire_State_ToldFlorrickAboutTowers = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:f28ba247-28a7-00da-a6db-f2af4f3b3e3a
msgctxt "he016c933g5475g4fecgbc6fgf1a8b5330746"
msgid ""
"Moonrise Towers? Along the old road? That place is cursed. Few could survive "
"there..."
msgstr "문라이즈 타워라고요? 그 오래된 길에 있는? 그 장소는 저주받았어요. 그곳에서 생존할 수 있는 이들은 얼마 없는데..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Player
#. NodeID = f52a28c4-a162-011d-65fd-8ad3f0167898
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:f52a28c4-a162-011d-65fd-8ad3f0167898
msgctxt "h4209110bg174fg4e86g8e4eg15924e7b7d92"
msgid "A story best left for calmer days, Counsellor."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Fist Recruit Ito
#. NodeID = f61e13aa-507d-7e56-e52b-36c0a022a9a2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - HUMAN(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:f61e13aa-507d-7e56-e52b-36c0a022a9a2
msgctxt "h63df93e5g3e9bg40bag8ea8g947d0284b232"
msgid "Counsellor - are you all right?!"
msgstr "자문관님, 다친 곳은 없으십니까?!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = f76b62c9-0b47-3fcc-b220-894dd4872706
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_Desire_State_Freed2 = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:f76b62c9-0b47-3fcc-b220-894dd4872706
msgctxt "he7f0f2a1g6c9fg4544gada7g29be3cdabbc3"
msgid "We can talk when you get me out of here!"
msgstr "여기서 저를 꺼내주신 후에 대화합시다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Counsellor Florrick
#. NodeID = f816da57-d8f5-aa50-e7c3-8c9556f71acf
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GLO_Desire_HasMet(5) = True
#.   Global:
#.     - PLA_Desire_Knows_RavengardTaken = True
#.   Quest:
#.     - PLA_GrandDukeRescue.LearnedDukeMissingCounsellor(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:f816da57-d8f5-aa50-e7c3-8c9556f71acf
msgctxt "hae78bf43gc549g49d7g9187gff046f3c2c59"
msgid ""
"Listen close: drow have taken Grand Duke Ulder Ravengard - westward, if my "
"eyes and ears may be believed."
msgstr "잘 들으세요. 드로우가 얼더 레이븐가드 대공님을 납치했습니다. 제 눈과 귀가 정확하다면, 서쪽으로 향했을 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Fist Recruit Aelis
#. NodeID = fa27bc70-78ef-bc15-5867-a7495d0a5bf0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire:fa27bc70-78ef-bc15-5867-a7495d0a5bf0
msgctxt "h3f436576gba0bg4c93gb307gddf5f1bbf18d"
msgid "On your command, Counsellor."
msgstr "명령을 따르겠습니다, 자문관님."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Desire
#. Speaker = Wyll
#. NodeID = fd0c78ff-9ccd-4f76-a6fd-bf3de44dee76
#. HandlePath = TaggedText[0].TagText[0]
