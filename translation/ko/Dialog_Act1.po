#.      - DRUID(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive:34c78a98-ca08-75e1-32ab-2605cf9f3209
msgctxt "hea6b3430gf95fg4693gbc04g87fdabada98a"
msgid "Calm, friend. I won't harm you."
msgstr "진정해, 친구. 널 해치려는 게 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive
#. Speaker = Player
#. NodeID = 4185961d-40ec-6d21-5710-9902ef782fa5
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 10
#. CheckFlags:
#.   Dialog:
#.      - PLA_OxAlive_State_AnimalHandlingFailed(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive:4185961d-40ec-6d21-5710-9902ef782fa5
msgctxt "h83d1f350ge515g4c1dgb5bcgde3ba4f591e1"
msgid "<i>Interpret his behaviour.</i>"
msgstr "<i>그의 행동을 해석해본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive
#. Speaker = Frightened Ox
#. NodeID = 48c7f833-6102-d147-f014-2d76f6f129a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive:48c7f833-6102-d147-f014-2d76f6f129a8
msgctxt "h232c6946ge21fg44c7g928cg553f12638d57"
msgid "*Moo.*"
msgstr "*음머.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive
#. Speaker = Narrator
#. NodeID = 53e5fda1-fcf3-091e-a211-71225a1a1c8b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_Tavern_State_OxPacified = True
#.   Local:
#.      - 1ae9dcd5-ff2b-db0a-44dc-ca2314c9bb33_AnimalHandlingSuccess = True
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive:53e5fda1-fcf3-091e-a211-71225a1a1c8b
msgctxt "hb7b55059gc664g4ddcg886dg06cd46b20b22"
msgid ""
"*The creature turns a piece of cud around its mouth, chewing contentedly.*"
msgstr "*이 생물은 만족스러운 듯 되새김질합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive
#. Speaker = Frightened Ox
#. NodeID = 593bfdfb-b3d2-41a9-aa42-95f53a193192
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive:593bfdfb-b3d2-41a9-aa42-95f53a193192
msgctxt "h761d53dcgf6bfg418cg9474g70d0797da928"
msgid "NO! DIE!"
msgstr "안 돼! 죽어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive
#. Speaker = Frightened Ox
#. NodeID = 5b3afba3-0ccd-4c22-7e38-12fe990c3e84
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = True
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#. TagRule: DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive:5b3afba3-0ccd-4c22-7e38-12fe990c3e84
msgctxt "h202a4511g2df4g4e96gba47ga2224562437d"
msgid "You're one of them! Monster!"
msgstr "그들과 한패구나! 괴물!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive
#. Speaker = Player
#. NodeID = 607f54ac-acf2-34f4-a8e1-6d11d3419a52
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive:607f54ac-acf2-34f4-a8e1-6d11d3419a52
msgctxt "h28b3ee8dg0703g4b06gbed2gad4456d82753"
msgid "Did you kill the goblin in the stable?"
msgstr "마굿간에 있는 고블린은 네가 죽인 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive
#. Speaker = Player
#. NodeID = 61408171-7ec5-981b-594b-429c00753929
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive:61408171-7ec5-981b-594b-429c00753929
msgctxt "h7b4ccffag5524g488fga6ccg2fb9d7d4b315"
msgid "<i>Defend yourself.</i>"
msgstr "<i>스스로를 방어한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive
#. Speaker = Frightened Ox
#. NodeID = 74d395a2-2d23-1d4d-416f-2dfdfa63dd05
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive:74d395a2-2d23-1d4d-416f-2dfdfa63dd05
msgctxt "hf633e221g2799g4548g9a35geb68dd9d4b2d"
msgid "An attack. Monsters... little ones, and taller ones."
msgstr "습격이었어. 괴물 놈들... 작은 놈들이랑, 큰 놈들도 있었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive
#. Speaker = Narrator
#. NodeID = 74d7fe7a-6262-76a1-2eb6-26daa1b065ef
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - PLA_OxAlive_State_AnimalHandlingFailed(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive:74d7fe7a-6262-76a1-2eb6-26daa1b065ef
msgctxt "h146ba09eg7474g4ab4gac16gfd5e835fd8bd"
msgid "*You gather nothing from his intense stare.*"
msgstr "*놈의 강렬한 눈빛에 어떤 뜻이 담겨 있는지 전혀 알 수 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive
#. Speaker = Frightened Ox
#. NodeID = 7841e242-0e4c-40bf-9df8-fb270b3ded45
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_Tavern_State_OxPacified = True
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive:7841e242-0e4c-40bf-9df8-fb270b3ded45
msgctxt "h559121d0g743eg4c8bg96cfgceb4b2baafb9"
msgid "*Sniff.*"
msgstr "*킁킁.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive
#. Speaker = Narrator
#. NodeID = 8158eac1-01a1-14be-06ec-15c191e2717d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive:8158eac1-01a1-14be-06ec-15c191e2717d
msgctxt "hb39f4f44gf1d0g4f4dg98eag38db2c13a176"
msgid "*His glassy eyes roll, wild with fear, as he begins to charge.*"
msgstr "*놈의 반짝이는 눈알이 공포심으로 요동치더니, 갑자기 돌진하기 시작합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive
#. Speaker = Frightened Ox
#. NodeID = 8b1e4b1d-5ec5-73ca-a300-6e816823b68b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_Tavern_Ox_HasMet(1) = True
#.   Global:
#.      - PLA_Tavern_State_OxPacified = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive:8b1e4b1d-5ec5-73ca-a300-6e816823b68b
msgctxt "ha30db5c1g241fg4c26g80cfgbf629a835ac8"
msgid "Walk well, friend."
msgstr "잘 가, 친구."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive
#. Speaker = Player
#. NodeID = 8e3a7a10-4504-f9eb-c1ce-5bec5d8e8c60
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive:8e3a7a10-4504-f9eb-c1ce-5bec5d8e8c60
msgctxt "h53240a1fga539g4f19gb6e4g66bb13b88bb5"
msgid "<i>Hold out your hands peacefully.</i>"
msgstr "<i>평화의 의미로 손바닥을 내비친다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive
#. Speaker = Player
#. NodeID = 9363a4c1-e463-3b45-6165-381a616e99de
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#. TagRule: BERSERKER
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive:9363a4c1-e463-3b45-6165-381a616e99de
msgctxt "hf580eb93g93f6g45beg8b40g490070b78074"
msgid "<b>BACK DOWN, BEAST.</b>"
msgstr "<b>물러서, 짐승.</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive
#. Speaker = Player
#. NodeID = 9363a4c1-e463-3b45-6165-381a616e99de
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive:9363a4c1-e463-3b45-6165-381a616e99de
msgctxt "h5c8919c8g8389g49b8g93e5gbd81a4138438"
msgid "Back down. <b>Or else.</b>"
msgstr "물러서. <b>그렇지 않으면.</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive
#. Speaker = Narrator
#. NodeID = 99675150-f9c7-b15b-a5c6-38e654f0a785
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - PLA_Tavern_Ox_HasMet(1) = True
#.   Global:
#.     - PLA_Tavern_Event_CancelOxHostility = True
#.     - PLA_Tavern_State_OxPacified = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive:99675150-f9c7-b15b-a5c6-38e654f0a785
msgctxt "h45785600gf801g488eg8617g07048a377cd4"
msgid "*He huffs and, after a moment, appears to relax.*"
msgstr "*놈이 크게 한숨을 쉬더니, 잠시 후 긴장을 푸는 듯 보입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive
#. Speaker = Player
#. NodeID = 9dc8034e-8f66-5c98-f0fb-0bb0176142b5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive:9dc8034e-8f66-5c98-f0fb-0bb0176142b5
msgctxt "h08e4efe7g79c5g4ea7ga9bdg3c834c4a4401"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive
#. Speaker = Frightened Ox
#. NodeID = 9e082e23-df7a-4825-4dab-bb48b3158440
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive:9e082e23-df7a-4825-4dab-bb48b3158440
msgctxt "h4286c135gb895g48f6g9b8ag91835d71d450"
msgid "*Bellow!*"
msgstr "*울부짖음!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive
#. Speaker = Frightened Ox
#. NodeID = a6c6b42e-3901-b8fe-c7a9-4005ec839653
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive:a6c6b42e-3901-b8fe-c7a9-4005ec839653
msgctxt "he66033b1g0039g4d0cgb636gba51fe99631b"
msgid "You speak to me? The monsters only scream."
msgstr "나한테 말을 거는 거야? 그 괴물 놈들은 비명만 질렀어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive
#. Speaker = Frightened Ox
#. NodeID = a8b06eb2-b5a6-c2c5-84fd-265b17fab281
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive:a8b06eb2-b5a6-c2c5-84fd-265b17fab281
msgctxt "h627d52d6g22e2g40bbg80a4g31cd35ec7036"
msgid "Yes. It was screaming, waving around its metal."
msgstr "그래. 놈들은 비명을 지르면서 금속 조각들을 흔들고 있었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive
#. Speaker = Narrator
#. NodeID = aa392c2c-f931-bfec-b635-7c78d984d5aa
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - PLA_Tavern_Ox_HasMet(1) = True
#.   Global:
#.     - PLA_Tavern_Event_CancelOxHostility = True
#.     - PLA_Tavern_State_OxPacified = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive:aa392c2c-f931-bfec-b635-7c78d984d5aa
msgctxt "h52726958ge67bg4ed7ga8abgdd7804c9c538"
msgid "*The ox calms, his tail swishing a satisfied arc.*"
msgstr "*황소가 진정한 듯, 꼬리를 부드럽게 흔듭니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive
#. Speaker = Frightened Ox
#. NodeID = b73c9b33-16dc-b724-72d9-08ee770a8134
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_Tavern_State_OxPacified = False
#.   Tag:
#.      - DROWELF(1) = False
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive:b73c9b33-16dc-b724-72d9-08ee770a8134
msgctxt "h2eae864cgba18g4614gb94ag170e63224c5d"
msgid "Monsters... everywhere... kill..."
msgstr "괴물... 투성이... 죽여..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive
#. Speaker = Frightened Ox
#. NodeID = b7cbb633-c71a-2eb8-a40c-78ebc046cfbe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive:b7cbb633-c71a-2eb8-a40c-78ebc046cfbe
msgctxt "h2f621f63ga5e0g4905g93ffg126bcee8c802"
msgid "No. You're not one of them at all."
msgstr "아니. 넌 놈들이랑 전혀 다르구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive
#. Speaker = Player
#. NodeID = b91335ee-86af-799f-56ae-3c6466dd48bc
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#. TagRule: BERSERKER
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive:b91335ee-86af-799f-56ae-3c6466dd48bc
msgctxt "h19ac48b6g7d86g4646gbcb6g74ba9d3e7eee"
msgid "<b><i>Stare down the beast.</i></b>"
msgstr "<b><i>짐승을 내려다본다.</i></b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive
#. Speaker = Player
#. NodeID = b91335ee-86af-799f-56ae-3c6466dd48bc
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive:b91335ee-86af-799f-56ae-3c6466dd48bc
msgctxt "h47039087g15e6g4963gb1fbgf973619ea50a"
msgid "<i>Stare him down, as you have so many beasts in the wild.</i>"
msgstr "<i>야생에서 수많은 짐승에게 그랬듯, 놈을 노려본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive
#. Speaker = Frightened Ox
#. NodeID = bd7061b8-500d-78d9-641a-8620c45a4126
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_Tavern_State_OxPacified = False
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive:bd7061b8-500d-78d9-641a-8620c45a4126
msgctxt "h66b8564bg0cf0g4425g8781ge3ec3e867d96"
msgid "*Grunt!*"
msgstr "*끙!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive
#. Speaker = Frightened Ox
#. NodeID = c140b7ad-2ccd-091e-73c7-05e643b5fb2c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive:c140b7ad-2ccd-091e-73c7-05e643b5fb2c
msgctxt "h94612714gb8a9g4f6dg9733gdb51bd1d3bd9"
msgid "Him? He was the biggest. Now I'm the biggest."
msgstr "그놈? 그가 제일 컸어. 이젠 내가 제일 커."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive
#. Speaker = Narrator
#. NodeID = c2efd93f-5090-e7f0-ec94-6315be7e4bb6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive:c2efd93f-5090-e7f0-ec94-6315be7e4bb6
msgctxt "h860b81c7g5b4dg4fedg9226g10ff0d0abc92"
msgid "*You manage only to agitate him more.*"
msgstr "*오히려 더 자극한 것 같습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive
#. Speaker = Player
#. NodeID = c312119f-4737-c6ae-9dab-00169c3eaddd
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive:c312119f-4737-c6ae-9dab-00169c3eaddd
msgctxt "h6aa3e25cg5834g4626gbca6g030f0d1547f1"
msgid "Look at me - I'm not a monster."
msgstr "날 봐, 난 괴물이 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive
#. Speaker = Frightened Ox
#. NodeID = c8fe40e0-a4bb-5a9e-c21c-aed42b8eaaaa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive:c8fe40e0-a4bb-5a9e-c21c-aed42b8eaaaa
msgctxt "h3acd306bga78dg4c1bga773g20611c98dc35"
msgid "You'd give me a choice? Hm. You're not like them."
msgstr "나한테 선택권을 주는구나? 흠. 넌 놈들이랑은 전혀 다르네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive
#. Speaker = Narrator
#. NodeID = c95e9ce4-945a-65b0-7bfc-b16b09f2fd82
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 1ae9dcd5-ff2b-db0a-44dc-ca2314c9bb33_AnimalHandlingSuccess = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive:c95e9ce4-945a-65b0-7bfc-b16b09f2fd82
msgctxt "he9d09c78g43beg40c3gac7eg8d04c8292c6c"
msgid ""
"*His hide twitches, every muscle primed to bolt. He's <i>terrified</i>.*"
msgstr "*놈의 가죽이 경련을 일으키고, 모든 근육이 튀어나와 있습니다. 완전히 <i>겁에 질렸습니다.</i>*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive
#. Speaker = Player
#. NodeID = d213a35b-68e5-8de6-6f34-fbb7908c7667
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
