#. SetFlags:
#.   Global:
#.     - GLO_GithChokepoint_Knows_DragonRider = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_DragonShadow:057d234d-ccee-7838-aaec-109f3b683595
msgctxt "h2d8a310dg0a11g4c7ag8588g5c29c50deff1"
msgid "A dragon-rider. My kin are hunting - blood will be spilled."
msgstr "드래곤 라이더다. 내 동족이 근처에서 사냥을 하고 있군, 피가 흐르겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_DragonShadow
#. Speaker = Player
#. NodeID = 2420a414-311f-a483-b89d-d618377667e1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
