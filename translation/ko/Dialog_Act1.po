msgctxt "h24c26774ga51bg4a63g988dgdc384873c982"
msgid "Why would a druid kill you?"
msgstr "드루이드가 널 왜 죽였지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_General_Dead_SnakeKid
#. Speaker = Arabella
#. NodeID = d1033ac1-e61b-484a-b68c-9fd567286cc3
#. HandlePath = TaggedText[0].TagText[0]
