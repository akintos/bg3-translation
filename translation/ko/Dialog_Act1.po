msgctxt "h4f2fdf8bg8176g4dc8gae7cg74c1914a1349"
msgid "Is that all you've got?"
msgstr "고작 그게 다냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_IrritatedTieflingTrainingAfterAttack
#. Speaker = Guex
#. NodeID = c6852342-5c87-ef14-7cd5-b037e272f8ab
