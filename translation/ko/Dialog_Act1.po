msgctxt "h873e7342gf777g4982g8c43g6036dd89c328"
msgid "No prisoners, no mercy!"
msgstr "포로는 없다, 자비를 보이지 마라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_DrowLeaving1
#. Speaker = Nightwarden Minthara
#. NodeID = dbaa7888-f207-58f9-575c-71026d17312e
#. HandlePath = TaggedText[0].TagText[0]
