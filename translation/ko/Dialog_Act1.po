msgctxt "h9fe93ad8g7492g46acgbc12g94b9c9683aec"
msgid "Hungry! Food!"
msgstr "배고파! 밥!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_OwlBear_LastCub
#. Speaker = Owlbear Cub
#. NodeID = 8f2cb0f3-9ccb-6559-f1f1-aca5bfc32a8f
