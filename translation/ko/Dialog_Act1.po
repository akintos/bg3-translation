#.     - GOB_GoblinPriest_Event_CountPlayers(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:b95440fb-1a1d-b746-47ab-e552146ac211
msgctxt "h2c90916egce28g4fd7g8d20g680d79c7d129"
msgid "Let's get your head fixed once and for all."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = b9c4dad9-c226-cd74-4f1d-01dda42e0526
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_GoblinPriest_Event_CountPlayers(1) = True
