msgctxt "hcec5e537gfbeeg4548gaa68g68d2504b0812"
msgid "Yeah, all right."
msgstr "네. 좋아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_BardAndKidAfterAttack
#. Speaker = Zaki
#. NodeID = 6ed65281-45cd-f23f-c9c5-8f8c731b0953
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - f108995b-14f4-7823-d218-790177a93da8_C = True
#. SetFlags:
#.   Local:
#.     - f108995b-14f4-7823-d218-790177a93da8_A = False
#.     - f108995b-14f4-7823-d218-790177a93da8_C = False
#.     - f108995b-14f4-7823-d218-790177a93da8_B = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_BardAndKidAfterAttack:6ed65281-45cd-f23f-c9c5-8f8c731b0953
msgctxt "h6261ff61gb667g4a48gbfd1g0eac687036f4"
msgid "Why did Mol let you in, anyway?"
msgstr "몰이 왜 당신을 들여보낸 거예요, 근데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_BardAndKidAfterAttack
#. Speaker = Alfira
#. NodeID = b8b35654-4180-9b5e-346f-ea973e1167f9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_BardAndKidAfterAttack:b8b35654-4180-9b5e-346f-ea973e1167f9
msgctxt "h1e9d914bg4672g421cgaed7gbb09e9e12368"
msgid "Not yet, I'm afraid. Just a bit longer, all right?"
msgstr "아직 안 돼. 조금만 더 있자, 응?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_BardAndKidAfterAttack
#. Speaker = Alfira
#. NodeID = d1eb0e00-5ad5-8c23-3f48-26d980ac4d7b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_BardAndKidAfterAttack:d1eb0e00-5ad5-8c23-3f48-26d980ac4d7b
msgctxt "hae08706fg7fd7g4efdg9ccag794497b2624d"
msgid ""
"Just until it's safe to go out. Don't worry. How about a story in the "
"meantime?"
msgstr "밖이 안전해질 때까지야. 걱정 마. 그동안 이야기 하나 들려줄까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_BardAndKidAfterAttack
#. Speaker = Zaki
#. NodeID = dcbc84f7-5892-a854-7aa6-e3a3f99a5bbd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - f108995b-14f4-7823-d218-790177a93da8_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_BardAndKidAfterAttack:dcbc84f7-5892-a854-7aa6-e3a3f99a5bbd
msgctxt "hd6576edfg7180g4e0egaad7g1ed9f8c512f6"
msgid "Can we leave yet?"
msgstr "이제는 나가도 되나요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_BardAndKidAfterAttack
#. Speaker = Zaki
#. NodeID = e8a2d616-67ff-6f8b-620c-ab5866cdf302
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - f108995b-14f4-7823-d218-790177a93da8_A = True
#. SetFlags:
#.   Local:
#.     - f108995b-14f4-7823-d218-790177a93da8_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_BardAndKidAfterAttack:e8a2d616-67ff-6f8b-620c-ab5866cdf302
msgctxt "h41431068gb790g4850ga3a0g3901609866d6"
msgid "How long will you be down here, anyway?"
msgstr "근데, 여긴 대체 언제까지 있을 거예요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_BardAndKidAfterAttack
#. Speaker = Alfira
#. NodeID = f43d4879-94d0-2172-58f6-caf144c5cf1f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_BardAndKidAfterAttack:f43d4879-94d0-2172-58f6-caf144c5cf1f
msgctxt "ha7237e99g25f3g4029gb774g1dd5c3ad79f4"
msgid "I know. Perhaps you can give me some pointers?"
msgstr "알아. 너도 조언 좀 해줄 수 있겠어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_BardAndKidAfterAttack
#. Speaker = Alfira
#. NodeID = f6ddc647-295b-d743-a456-aa70d908cd69
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_BardAndKidAfterAttack:f6ddc647-295b-d743-a456-aa70d908cd69
msgctxt "h70bd648dgcf06g4c15ga77eg398c080e2fc9"
msgid "Even your boss can't resist a good story."
msgstr "너희 대장이라도 재밌는 이야기는 거절 못하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ChefAndSonAfterAttack
#. Speaker = Ikaron
#. NodeID = 49b4400f-6f0b-eb05-5758-2465ae5af8ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ChefAndSonAfterAttack:49b4400f-6f0b-eb05-5758-2465ae5af8ed
msgctxt "hde236329g4555g45d0gb470g7d64b3fa1b18"
msgid "Come on. You can't tell me you're not curious."
msgstr "에이, 엄마도 내심 궁금하시잖아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ChefAndSonAfterAttack
#. Speaker = Ikaron
#. NodeID = 5aabeea5-69ed-b8a0-0630-992b9897e72c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - bde7a4f1-933f-f6ce-4a3e-4b1f29f83704_A = True
#. SetFlags:
#.   Local:
#.     - bde7a4f1-933f-f6ce-4a3e-4b1f29f83704_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ChefAndSonAfterAttack:5aabeea5-69ed-b8a0-0630-992b9897e72c
msgctxt "h36e5af36g2a6fg4173g847bg1834c82daae7"
msgid "Eerie little black rock. Wonder what it does?"
msgstr "섬뜩한 작고 새까만 돌이네. 이게 대체 뭘까요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ChefAndSonAfterAttack
#. Speaker = Okta
#. NodeID = 67da894e-3f96-322e-38f8-9f8fafde2b49
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - bde7a4f1-933f-f6ce-4a3e-4b1f29f83704_C = True
#. SetFlags:
#.   Local:
#.     - bde7a4f1-933f-f6ce-4a3e-4b1f29f83704_C = False
#.     - bde7a4f1-933f-f6ce-4a3e-4b1f29f83704_B = False
#.     - bde7a4f1-933f-f6ce-4a3e-4b1f29f83704_A = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ChefAndSonAfterAttack:67da894e-3f96-322e-38f8-9f8fafde2b49
msgctxt "h0b94429fg6ba4g4663g892eg19b312910562"
msgid "Anything of value?"
msgstr "쓸만한 것 좀 찾았니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ChefAndSonAfterAttack
#. Speaker = Ikaron
#. NodeID = 6e744995-50c5-9f78-3447-7539051a6c41
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ChefAndSonAfterAttack:6e744995-50c5-9f78-3447-7539051a6c41
msgctxt "h9b88c728g1a09g4098g9201g8b211c50df9b"
msgid "No... it's all junk."
msgstr "아뇨... 죄다 쓰레기예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ChefAndSonAfterAttack
#. Speaker = Okta
#. NodeID = a384059c-083b-722b-f3ab-8ca04c50733a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ChefAndSonAfterAttack:a384059c-083b-722b-f3ab-8ca04c50733a
msgctxt "haf9188a5g663eg4192g8453g8a570c175b6e"
msgid "Probably rots your fingers off. Leave it be!"
msgstr "그러다 손가락 썩을지도 모른다. 그냥 냅둬!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ChefAndSonAfterAttack
#. Speaker = Okta
#. NodeID = b5f399af-a167-4bfc-13a0-b56cc4b684d3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - bde7a4f1-933f-f6ce-4a3e-4b1f29f83704_B = True
#. SetFlags:
#.   Local:
#.     - bde7a4f1-933f-f6ce-4a3e-4b1f29f83704_C = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ChefAndSonAfterAttack:b5f399af-a167-4bfc-13a0-b56cc4b684d3
msgctxt "h673eb17fg0fc4g42e6g92b7g781369c118b9"
msgid "Do I have to drag you out of there by the horns?"
msgstr "기어이 내가 네 머리 뿔 잡아끌어야 정신 차릴 게냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ChefAndSonAfterAttack
#. Speaker = Ikaron
#. NodeID = c9426f3f-b04d-ad74-4098-36f3ff8c1c26
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ChefAndSonAfterAttack:c9426f3f-b04d-ad74-4098-36f3ff8c1c26
msgctxt "h24f10167g831bg409eg96d0g4e02ba3d2f41"
msgid "I'm just curious! Her knick-knacks could be worth something."
msgstr "그냥 궁금해서 그래요! 그 여자 잡동사니가 돈 될 수도 있잖아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ChefAndSonAfterAttack
#. Speaker = Okta
#. NodeID = f11bff29-c2c0-0637-3a3e-fcb7bcf1a3aa
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - bde7a4f1-933f-f6ce-4a3e-4b1f29f83704_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ChefAndSonAfterAttack:f11bff29-c2c0-0637-3a3e-fcb7bcf1a3aa
msgctxt "h12b9d600gec75g4161ga48fga4b7f9307479"
msgid "Son, stay out of that old woman's things."
msgstr "얘야, 그 늙은 여편네 것은 괜히 건들지 말거라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_DruidGuard1
#. Speaker = Jeorna
#. NodeID = 24069e4e-3060-a6e9-64a5-170979029b04
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 47511dbb-8940-d871-bc7f-3238ecbf05da_b = True
#.      - 47511dbb-8940-d871-bc7f-3238ecbf05da_a = True
