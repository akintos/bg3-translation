msgctxt "hb5e27358gdb06g439dg8942gd5af844cb68e"
msgid "<i>Drink the potion.</i>"
msgstr "<i>물약을 마신다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = fbf27b77-8503-e7ec-dd17-00e84c6f05ab
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_GoblinPriest_State_PlayersAroundChapel(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:fbf27b77-8503-e7ec-dd17-00e84c6f05ab
msgctxt "h92974c18gb3c1g4449g95d4gada97fbbedaf"
msgid "Don't want a crowd of gawpers. Everybody else needs to leave."
msgstr "구경꾼들이 있으면 안 돼. 다른 사람들은 모두 나가야 한다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = fed5b0a3-8013-4c8e-2899-612f87426640
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:fed5b0a3-8013-4c8e-2899-612f87426640
msgctxt "h47b0de7cgb830g423eg8a6fg8fa6c4351f36"
