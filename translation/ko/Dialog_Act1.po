#. CheckFlags:
#.   Local:
#.      - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_LeaveHim = False
#. SetFlags:
#.   Local:
#.     - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_LeaveHim = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:16811065-56bb-21a9-511e-d1ff9884b223
msgctxt "hc49cf70fg5852g4c7bg942eg8204af822518"
msgid "You could always just leave him."
msgstr "그냥 그를 두고 가도 되잖아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 175d8677-337a-cb12-fb4c-ac701ee0d312
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:175d8677-337a-cb12-fb4c-ac701ee0d312
msgctxt "h290507e1g1e16g4602ga53ag0bcb5c4b559a"
msgid "Thanking you. I'll be on my way then."
msgstr "고마워. 그럼 이만 가 봐야겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = 193d742e-4b20-711d-11c9-3ee390b91e2d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DUERGARDWARF(1) = True
#.      - DUERGARDWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:193d742e-4b20-711d-11c9-3ee390b91e2d
msgctxt "h175fa14fg8062g4abcgbe71gfb9783bb5978"
msgid "Don't know. Don't care. Don't like your questions."
msgstr "몰라. 신경 쓰고 싶지도 않고. 당신 질문도 마음에 들지 않는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = 19b36b99-21a8-be1d-3a40-116cf38be3bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:19b36b99-21a8-be1d-3a40-116cf38be3bf
msgctxt "h1e39723bge3cfg45ddgb0bag3fb0f53c274e"
msgid "Why is a mushroom so important to you?"
msgstr "이 버섯이 당신에게 왜 그렇게 중요한 겁니까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = 1ae8d49c-b15b-f748-2151-4685000ad222
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - LOLTHDROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:1ae8d49c-b15b-f748-2151-4685000ad222
msgctxt "ha4e2c876g4cb3g4027g8218g0a252fef687a"
msgid "Watch your tongue - you have no power here."
msgstr "입 조심해 - 너는 여기서 아무런 힘도 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 1d5a983d-6a24-6217-c405-33e75f07937c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:1d5a983d-6a24-6217-c405-33e75f07937c
msgctxt "he3d15af2gbebfg48a1g9be0g9f24a071f2eb"
msgid "Not no more, though."
msgstr "하지만 이젠 어쩔 수 없겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 1e3cfe6a-e30f-ae57-5a04-d86c433df540
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:1e3cfe6a-e30f-ae57-5a04-d86c433df540
msgctxt "ha33d20b1gba68g4c25g834dg9c037531f037"
msgid ""
"Come visit me in Baldur's Gate if you find yourself that way. Might be I can "
"repay your kindness."
msgstr "발더스 게이트에 도착하면, 날 찾아와. 당신의 친절함에 보상을 해줄 수도 있으니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = 1e442cf0-9177-8db4-a082-fb33fb2c83f9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_BaelenDescriptiongGiven = False
#. SetFlags:
#.   Local:
#.     - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_BaelenDescriptiongGiven = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:1e442cf0-9177-8db4-a082-fb33fb2c83f9
msgctxt "h31b72a5fg5429g4452gbde9g3c1998a22482"
msgid "Can you describe him?"
msgstr "그를 묘사해 줄 수 있습니까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = 20993c9f-affb-fbda-6522-da8283c2d22a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:20993c9f-affb-fbda-6522-da8283c2d22a
msgctxt "hf1691e1agef86g437aga9c7g53184263484b"
msgid "<i>Keep the mushroom.</i>"
msgstr "<i>버섯을 간직한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 20c23946-d06d-7a52-6c9b-7db53d8c256d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:20c23946-d06d-7a52-6c9b-7db53d8c256d
msgctxt "hb1f90284g2288g446eg81a2g963825623401"
msgid "All right... please. That mushroom could change everything for me."
msgstr "좋아... 제발. 그 버섯이 내 인생을 뒤바꿀 수 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = 21fe80d5-8b10-c2ca-f322-a63ea7358fa2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_WhatDoingHere = False
#. SetFlags:
#.   Local:
#.     - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_WhatDoingHere = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:21fe80d5-8b10-c2ca-f322-a63ea7358fa2
msgctxt "h48a49242g5525g47dag8558ga6c9699a7350"
msgid "This is dangerous territory. You must be down here for a reason."
msgstr "여긴 아주 위험한 곳이에요. 여기까지 내려온 데에는 분명 이유가 있을 텐데요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = 228e38ec-0b04-6f8d-f815-cb50923bb15f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_HerOwnFault = False
#. SetFlags:
#.   Local:
#.     - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_HerOwnFault = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:228e38ec-0b04-6f8d-f815-cb50923bb15f
msgctxt "h6c2c2915g2528g4e6agbff5g1930056fda3b"
msgid "It's your own fault - you took advantage of Baelen while he was unwell."
msgstr "그건 당신 잘못입니다. 베일렌이 아플 때, 그를 이용했잖아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 246e013e-5ec9-9254-8ffc-263f30e7a5b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:246e013e-5ec9-9254-8ffc-263f30e7a5b1
msgctxt "h1963c361g0279g4bd3gb21dgf59c2e5149e1"
msgid "Wait - <i>please. </i>I need this."
msgstr "잠깐 - <i>제발</i>. 내게 꼭 필요한 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = 25f22fd4-0a28-dc01-bc6f-8f1f5d43c4e0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_MushroomHunter_State_HasMushroom(1) = True
#. SetFlags:
#.   Global:
#.     - UND_DwarvenAlchemist_State_AlchemistGotNoblestalk = True
#.   Object:
#.     - UND_MushroomHunter_Event_GiveMushroom(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:25f22fd4-0a28-dc01-bc6f-8f1f5d43c4e0
msgctxt "hf902bb28g3989g4d77g84d0gd7960e837ee7"
msgid "<i>Let her take the mushroom.</i>"
msgstr "<i>그녀에게 버섯을 준다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 262993bb-2577-14e2-dd6f-88b5e4c05d45
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:262993bb-2577-14e2-dd6f-88b5e4c05d45
#, fuzzy
msgctxt "h87879d48g8f16g46bcga88egadb6c806e57c"
msgid ""
"Probably. But Baelen in his right mind wasn't worth half a half of "
"noblestalk."
msgstr "그럴지도. 하지만 제정신이 박힌 베일렌은 귀족줄기의 절반의 반의 가치도 없었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 2964ccc6-e424-0d9d-1346-bb5e56b7f335
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:2964ccc6-e424-0d9d-1346-bb5e56b7f335
msgctxt "hb6992d9agea34g4601gb901g42f78de3c6c9"
msgid "We - <i>I </i>- run a shop called Bonecloak's in Baldur's Gate."
msgstr "우리, <i>난</i> 발더스 게이트에서 본클록스라는 상점을 운영하고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = 2af534f7-5b78-8cb9-c786-f383a3e6cd60
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_MyconidCircle_DwarvenAlchemist_Knows_NoblestalkFunction(1) = True
#.   Global:
#.      - UND_MushroomHunter_State_BaelenDead = False
#.      - UND_DwarvenAlchemist_Knows_LossOfMemory = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:2af534f7-5b78-8cb9-c786-f383a3e6cd60
msgctxt "h03dda686g9bedg4dbbg97e8g41d0d3adea25"
msgid "Could it cure Baelen's memory loss?"
msgstr "그게 베일렌의 기억 상실을 치유할 순 없나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = 2c476ee5-f2f6-a2bb-1ef5-7d8fd6e20b78
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Local:
#.      - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_AskedForPayment = True
#.   Tag:
#.      - BARBARIAN(1) = True
#. SetFlags:
#.   Local:
#.     - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_EvilTagPersuade = True
#. TagRule: BERSERKER
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:2c476ee5-f2f6-a2bb-1ef5-7d8fd6e20b78
msgctxt "hcfda097fg0379g4ab9g979ag776e24335ae1"
msgid "Correct. PAY UP. <b>NOW</b>."
msgstr "맞아. 갚아.<b>당장</b>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = 2c476ee5-f2f6-a2bb-1ef5-7d8fd6e20b78
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Local:
#.      - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_AskedForPayment = True
#.   Tag:
#.      - BARBARIAN(1) = True
#. SetFlags:
#.   Local:
#.     - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_EvilTagPersuade = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:2c476ee5-f2f6-a2bb-1ef5-7d8fd6e20b78
msgctxt "h64133e11g44ffg47e4ga285g6e68eff0ecf8"
msgid "I know exactly what you owe. <b>Pay up.</b>"
msgstr "나는 당신이 얼마나 빚졌는지 정확히 알고 있어. <b>갚아.</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 2cbccd6c-c426-9b4e-f22c-71cc0344a584
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - UND_MushroomHunter.TalkedToDerryth(1) = True
#. TagRule: DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:2cbccd6c-c426-9b4e-f22c-71cc0344a584
msgctxt "h46d50dd6g7ce1g4b11gb142g8a700c80cfa7"
msgid ""
"Now, doubt you'd care to notice, but you didn't see a dwarf on your travels, "
"did you? Baelen's his name."
msgstr "자, 눈치챘는지 모르겠지만, 여행 중에 드워프를 본적 없지, 그렇지? 베일렌이 그의 이름이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 2cbccd6c-c426-9b4e-f22c-71cc0344a584
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Quest:
#.     - UND_MushroomHunter.TalkedToDerryth(1) = True
#. TagRule: DUERGARDWARF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:2cbccd6c-c426-9b4e-f22c-71cc0344a584
msgctxt "h75c1ef93gf5acg4706g8e9fgebb8c8eefbff"
msgid ""
"But while you're here, you seen a dwarf around? The non-grey type. Baelen's "
"his name."
msgstr "하지만 당신이 여기 있는 동안, 주위에 드워프를 본 적이 있어? 회색이 아닌 유형. 베일렌이 그의 이름이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 2cbccd6c-c426-9b4e-f22c-71cc0344a584
#. HandlePath = TaggedText[2].TagText[0]
#. SetFlags:
#.   Quest:
#.     - UND_MushroomHunter.TalkedToDerryth(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:2cbccd6c-c426-9b4e-f22c-71cc0344a584
msgctxt "h96cc7aabg4510g456bga9e7gdddc82586fef"
msgid "You see a fella on his own on your way in? Dwarf. Baelen's his name."
msgstr "들어오는 길에 혼자 있는 남자 못 봤나? 드워프야. 이름은 베일렌이고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 2d3b3a81-2bb1-db2b-d424-8966722bd598
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:2d3b3a81-2bb1-db2b-d424-8966722bd598
msgctxt "hdb7f0152g6a9fg4057gab58g25f14c714336"
msgid ""
"Baelen nearly sunk the shop to pay for drink, when he was of his own mind."
msgstr "베일렌이 제정신이었을 땐, 술값을 낸다고 상점을 거의 팔아버릴 뻔했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 2db3c0d9-59ab-d5a6-0a20-8cc4dfe49b6b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:2db3c0d9-59ab-d5a6-0a20-8cc4dfe49b6b
msgctxt "h9fd2df53gd7f2g4187gb97dg3b14c28c9a0e"
msgid "Right. Never mind."
msgstr "알았어. 신경 쓰지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = 2e10fedc-a6c7-af0f-205b-db18fdd61a3a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_MushroomHunter_State_HasMushroom(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:2e10fedc-a6c7-af0f-205b-db18fdd61a3a
#, fuzzy
msgctxt "hcc5e3471g0603g4660g8c06gdbe2315dd5bc"
msgid "<i>Hold out the noblestalk to her.</i>"
msgstr "<i>그녀에게 귀족줄기를 내밀어 보인다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 30858b43-0c61-af3d-0a5d-a75d5d74d147
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:30858b43-0c61-af3d-0a5d-a75d5d74d147
msgctxt "h0f9f300dg49a3g4f6agb003g4b6b7d39c194"
msgid "Nearly nothing it can't cure. Blindness, poison, hair loss..."
msgstr "그건 거의 모든 것을 치유할 수 있어. 실명, 중독, 탈모까지..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = 32734e38-4bb9-a7c9-249f-1c6056e4b98c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_UNDERDARK(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:32734e38-4bb9-a7c9-249f-1c6056e4b98c
msgctxt "hed95c8ecg5987g45f7g80adga789fb97573e"
msgid "I've heard it has uses as a remedy."
msgstr "치료제로 사용한다고 들었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 334f7cd5-57b7-3cea-257b-28492759219d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:334f7cd5-57b7-3cea-257b-28492759219d
msgctxt "hb33cd3e9gbad8g437agb9f2g4df1af5f15f8"
msgid ""
"Don't like having a sour-breath grey in my face myself, but here we are."
msgstr "내 얼굴에 시큼한 숨결의 회색빛이 도는 건 마음에 안 들지만, 우리가 여기 있잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = 3353e499-5d2f-65d3-9875-584daeb36443
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:3353e499-5d2f-65d3-9875-584daeb36443
msgctxt "hf7ad204ag56d5g4f93ga072gff2729e3af7d"
msgid "Actually, I was mistaken. I haven't seen him."
msgstr "사실, 헷갈린 것 같아. 그를 본 적은 없는 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = 3388f425-6cd7-cca5-3d5b-a9048d18e29a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:3388f425-6cd7-cca5-3d5b-a9048d18e29a
msgctxt "h718b8606g3239g4f88g9025g892d75356fdc"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 3a8285cc-598f-f803-beaf-b1ed7e100a2c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - UND_MushroomHunter.LearnedBaelenInfo(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:3a8285cc-598f-f803-beaf-b1ed7e100a2c
msgctxt "hb1cfb0bag4ddfg4b86gbe77gd3308ed46443"
msgid "Bald. Blue tunic. Dumb as a stick."
msgstr "대머리에 파란 튜닉을 입은 멍청한 인간이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = 3b21c178-4f14-5433-2c9d-5ccf76db9e37
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_HelpLeaveHim = False
#. SetFlags:
#.   Local:
#.     - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_HelpLeaveHim = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:3b21c178-4f14-5433-2c9d-5ccf76db9e37
msgctxt "h64fe3fe2g9f0bg4b4dga90egeb9a2d551366"
msgid "Maybe I can help you get away from him."
msgstr "제가 당신이 그에게서 벗어나도록 도와줄 수 있을지도 몰라요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 3c4bd809-8b66-03af-d059-122a121ee815
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:3c4bd809-8b66-03af-d059-122a121ee815
msgctxt "h5c8aa3a4gd1e1g43c5gbf2bg6f1a4bd550fb"
msgid "Did it look like he'd make it out of them bibberbang?"
msgstr "그 비버뱅에서 빠져나올 수 있을 것 같던가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = 3c6a24ae-6e0c-28c7-a5ea-0777cc17df34
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DUERGARDWARF(1) = False
#.      - DUERGARDWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:3c6a24ae-6e0c-28c7-a5ea-0777cc17df34
msgctxt "hda6377ebg0c81g470bgaa0agd0032ff01cdb"
msgid "I'm not truly a duergar - merely disguised."
msgstr "난 진짜 듀에르가가 아니야. 변장한 것뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = 3e04ba22-b656-1b95-a91f-1e68a9cde4d0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_MushroomHunter_State_HasMushroom(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:3e04ba22-b656-1b95-a91f-1e68a9cde4d0
#, fuzzy
msgctxt "h98c0b58age070g44b9gb096gf52498dae16a"
msgid "<i>Show her the noblestalk.</i>"
msgstr "<i>그녀에게 귀족줄기를 보여준다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 3ef896cb-c71b-9bab-4791-8973dd3469f2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:3ef896cb-c71b-9bab-4791-8973dd3469f2
#, fuzzy
msgctxt "h90dc8745g92cdg4166ga57fg832807c9e1a1"
msgid ""
"If I can put noblestalk on the shelves, it might allow me to hang on a "
"little longer."
msgstr "내가 귀족줄기를 선반에 내놓으면, 조금 더 버틸 수 있을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 3f74a4cd-62d4-eada-3ff9-623af0b1525b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:3f74a4cd-62d4-eada-3ff9-623af0b1525b
msgctxt "hf35e3c51g799dg43f9g8a12gc47348762fbe"
msgid "Please. Baelen's got a job to do. We can leave when he's done it."
msgstr "제발. 베일렌에겐 아직 끝낼 일이 있다고. 그걸 마무리하기 전엔 떠날 수 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 41260d61-d5de-37aa-6fc8-3fd237396a25
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:41260d61-d5de-37aa-6fc8-3fd237396a25
msgctxt "h983bee0agfcc8g4304g9c7fg7aa892f01c24"
msgid "We - <i>I </i>- run a shop called Bonecloak's in Baldur's Gate."
msgstr "우리, <i>난</i> 발더스 게이트에서 본클록스라는 상점을 운영하고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 41c3d1de-ab97-4512-64cf-d6767ede89b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:41c3d1de-ab97-4512-64cf-d6767ede89b1
msgctxt "h4bdb8bdbg6c74g4830gb103g8dbbc836751c"
msgid "Just go. <i>Please.</i>"
msgstr "그냥 가. <i>부탁이야.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 425906f4-8b73-52c6-4ac6-c0c1b910a52b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:425906f4-8b73-52c6-4ac6-c0c1b910a52b
msgctxt "h13d79254g9a0ag42b1ga799g21efedd96354"
msgid ""
"Hrrm. Clever disguise as long as it works. Stupid beyond belief as soon as "
"it stops."
msgstr "흠. 먹힌다면 똑똑한 위장이 되겠어. 걸리는 순간 믿을 수 없을 정도로 멍청해 보이겠지만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = 435e14b0-cbba-623e-f09b-ff7d87af6342
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MushroomHunter_State_BaelenDead = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:435e14b0-cbba-623e-f09b-ff7d87af6342
msgctxt "hcc1bd388g006eg4894g951cge699fda41c63"
msgid "Baelen died in a field of toxic mushrooms."
msgstr "베일렌은 독성 버섯이 가득한 곳에서 죽었어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = 45141d48-84a0-0cfd-0628-c5dcfb34f994
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_MushroomHunter_HasMet(1) = True
#.   Global:
#.      - UND_MushroomHunter_State_BaelenDead = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:45141d48-84a0-0cfd-0628-c5dcfb34f994
msgctxt "hb775fd13g9283g4745ga9f5g67fef2f6bb54"
msgid "I met Baelen in a field of deadly mushrooms."
msgstr "독성 버섯이 가득한 밭에서 베일렌을 만났어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 4921d0c0-7492-1f8e-c722-024ce7317778
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:4921d0c0-7492-1f8e-c722-024ce7317778
msgctxt "h144c2ac2gb767g422cg9467g01c1f6e8cfff"
msgid ""
"You see him again, tell him to get back here to me. He's overdue as it is."
msgstr "그를 다시 만나면, 내게 돌아오라고 전해 줘. 이미 많이 늦었다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 4af6466a-b786-d2ce-aa29-a5c639735d0b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:4af6466a-b786-d2ce-aa29-a5c639735d0b
msgctxt "h4c5257d1gb86eg4a89g9a95g8298e92c101a"
msgid "You've sunk me. You and Baelen together."
msgstr "너희 둘이 날 파멸시켰어. 너랑 베일렌이랑."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 4b477f76-f7a4-3a43-df6d-1a1b48746549
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:4b477f76-f7a4-3a43-df6d-1a1b48746549
msgctxt "hd5873622g0b92g44d3gba38g03adecef402f"
msgid "Ah. To no surprise of mine, you're more competent than Baelen."
msgstr "아. 놀랄 것도 없이, 당신이 베일렌보다 일을 잘하는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = 4bc8fd21-b350-6822-39e1-d6c3cdfe3fd2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:4bc8fd21-b350-6822-39e1-d6c3cdfe3fd2
msgctxt "hc132f844g567bg4072gbab9g0949da85876d"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 4c34e390-5183-2756-0012-674104573262
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:4c34e390-5183-2756-0012-674104573262
msgctxt "h1f390b4agb56cg4bb1g8262gdb802712c124"
msgid "No point in wasting any more time here with you."
msgstr "여기서 너랑 더 시간을 낭비하는 건 의미 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 4d3b5d2c-1acd-2d8f-d67b-bb6a363a14bd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:4d3b5d2c-1acd-2d8f-d67b-bb6a363a14bd
msgctxt "h9e8336b0gcdedg49a7ga5d5g399a0f0e6a54"
msgid ""
"You thievin' mudsucker! I hope a cave-in breaks every bone in your carcass!"
msgstr "망할 도둑 자식! 동굴이 무너져서 니 뼈가 다 으스러지기를 빌테다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 4e7cefbd-6867-ac65-6098-c16742a277b5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:4e7cefbd-6867-ac65-6098-c16742a277b5
msgctxt "h77df9f66gc33ag4769ga3e4g2242ae1013aa"
msgid "He'll find his own way out, or he won't."
msgstr "알아서 잘 할 거야. 못하려나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 4f749731-390d-0b12-227c-4a6a38f221ec
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_MyconidCircle_DwarvenAlchemist_BaelenRestoredHasmet(1) = True
#.   Global:
#.      - UND_MushroomHunter_Event_AteMushroom = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:4f749731-390d-0b12-227c-4a6a38f221ec
msgctxt "h63b67a32g626ag47ffg8878g52be97d082c2"
msgid "Just leave me, I said. You've done enough damage already."
msgstr "그냥 나가라고 했어. 너는 이미 충분한 상처를 줬어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 50759b88-1bfb-8c2c-a9e2-65eba9079112
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:50759b88-1bfb-8c2c-a9e2-65eba9079112
msgctxt "h3c126837gf024g4dd5g927eg4cb3b2bbd372"
msgid "Rubbish - you haven't seen him, have you? Forget it."
msgstr "개소리군, 거짓말이지, 안 그래? 잊어버려."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 53086be1-9c77-8e46-b9d8-72208c8a200e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:53086be1-9c77-8e46-b9d8-72208c8a200e
msgctxt "hf2d89764g5200g4882g930fg4f0e2a41c438"
msgid "You take care out here."
msgstr "그럼 잘 버텨봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = 54a6e091-80d2-cbcb-b913-8269052bd203
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_WhatDoingHere = False
#. SetFlags:
#.   Local:
#.     - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_WhatDoingHere = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:54a6e091-80d2-cbcb-b913-8269052bd203
msgctxt "heb22c13fg299eg48bbg80a4g8dbfe2dc712d"
msgid "What are you doing down here?"
msgstr "이 아래에서 뭘 하고 있습니까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 56082aae-483a-f59c-613e-8f31e03567bd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:56082aae-483a-f59c-613e-8f31e03567bd
msgctxt "h5e15cddfgd106g4817g9219g87b978b806f1"
msgid "Oh. Thank you. I owe you more than you know."
msgstr "오. 감사합니다. 감사합니다. 제가 당신에게 얼마나 고마운지 당신은 모를 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = 5620a38c-50f2-b8e4-5c14-c638a143d02c
#. HandlePath = TaggedText[0].TagText[0]
