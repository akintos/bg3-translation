msgctxt "h5ac458e3g25beg433eg8ab8g2c8697043625"
msgid "We lost our way. Never again."
msgstr "우리는 길을 잃었어. 다시는 그러지 않을 걸세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid3
#. Speaker = Inwe
#. NodeID = 1567f6e9-69e8-5163-1867-f53c1023030c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#.   Local:
#.      - 6bde1237-aa43-36d3-9e53-ec1092198541_B = True
#. SetFlags:
#.   Local:
#.     - 6bde1237-aa43-36d3-9e53-ec1092198541_C = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid3:1567f6e9-69e8-5163-1867-f53c1023030c
msgctxt "h7d46e884gd993g4503g90e6gdd7729f6bb9a"
msgid "The air feels different. Colder."
msgstr "공기의 느낌이 달라. 차가워졌어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid3
#. Speaker = Inwe
#. NodeID = 4bc20e3a-ba92-ba46-fecd-87bda50a7568
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#.   Local:
#.      - 6bde1237-aa43-36d3-9e53-ec1092198541_A = True
#. SetFlags:
#.   Local:
#.     - 6bde1237-aa43-36d3-9e53-ec1092198541_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid3:4bc20e3a-ba92-ba46-fecd-87bda50a7568
msgctxt "hfa8e2105g4c5ag46c5ga66cgfd17fc504e46"
msgid "The grove doesn't feel the same."
msgstr "숲이 이전 같지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid3
#. Speaker = Inwe
#. NodeID = 601c1e08-6340-8438-2cfb-1aa7479cbfa5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 6bde1237-aa43-36d3-9e53-ec1092198541_A = True
#. SetFlags:
#.   Local:
#.     - 6bde1237-aa43-36d3-9e53-ec1092198541_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid3:601c1e08-6340-8438-2cfb-1aa7479cbfa5
msgctxt "hc8f046bdg80feg4ae6gba07g6754112dd6ea"
msgid "What was I thinking?"
msgstr "대체 내가 무슨 생각을 했던 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid3
#. Speaker = Inwe
#. NodeID = 60d0a204-30d7-45a9-facb-4e70786e5bc8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 6bde1237-aa43-36d3-9e53-ec1092198541_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid3:60d0a204-30d7-45a9-facb-4e70786e5bc8
msgctxt "h4c469490g2cb5g4fc0ga739gabccb4e798e3"
msgid "I can't believe I fell for her lies."
msgstr "내가 그런 거짓말에 홀리다니 믿어지질 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid3
#. Speaker = Inwe
#. NodeID = 7a72fec0-7cc6-3892-01fe-74ffd69046de
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#. SetFlags:
#.   Local:
#.     - 6bde1237-aa43-36d3-9e53-ec1092198541_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid3:7a72fec0-7cc6-3892-01fe-74ffd69046de
msgctxt "h735ea649gc331g4e44ga4cbg967f6e09532f"
msgid "Are we really safe?"
msgstr "우리 진짜 안전해?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid3
#. Speaker = Inwe
#. NodeID = c581a9c0-935d-706f-2e39-aa81500f3afa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 6bde1237-aa43-36d3-9e53-ec1092198541_C = True
#. SetFlags:
#.   Local:
#.     - 6bde1237-aa43-36d3-9e53-ec1092198541_A = False
#.     - 6bde1237-aa43-36d3-9e53-ec1092198541_C = False
#.     - 6bde1237-aa43-36d3-9e53-ec1092198541_B = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid3:c581a9c0-935d-706f-2e39-aa81500f3afa
msgctxt "hafed7600gb18bg4b91g9056g1bf8d9cb7a09"
msgid "We have to make this right."
msgstr "이걸 제대로 돌려 놓아야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid3
#. Speaker = Inwe
#. NodeID = d121f37a-de5c-aa0c-f241-e182509de849
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 6bde1237-aa43-36d3-9e53-ec1092198541_B = True
#. SetFlags:
#.   Local:
#.     - 6bde1237-aa43-36d3-9e53-ec1092198541_C = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid3:d121f37a-de5c-aa0c-f241-e182509de849
msgctxt "hca1550c4ga2ecg4793g845cg97089f88ae7e"
msgid "It wasn't just Kagha. We're all at fault."
msgstr "카그하 뿐만이 아니었지. 우리 모두 실수한 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid3
#. Speaker = Inwe
#. NodeID = d79f777f-4cc6-1283-2793-98e0873c11b2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#.   Local:
#.      - 6bde1237-aa43-36d3-9e53-ec1092198541_C = True
#. SetFlags:
#.   Local:
#.     - 6bde1237-aa43-36d3-9e53-ec1092198541_A = False
#.     - 6bde1237-aa43-36d3-9e53-ec1092198541_C = False
#.     - 6bde1237-aa43-36d3-9e53-ec1092198541_B = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid3:d79f777f-4cc6-1283-2793-98e0873c11b2
msgctxt "ha5f30578gf1a5g49edg8e62g45a00a03659b"
msgid "I have to pull it together."
msgstr "다 같이 당겨야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid4
#. Speaker = Elwyn
#. NodeID = 009162fa-9f70-f13b-eda4-52049c8b22ac
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - e8142b63-8cd3-1bc7-cc0f-52876cd59134_A = True
#. SetFlags:
#.   Local:
#.     - e8142b63-8cd3-1bc7-cc0f-52876cd59134_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid4:009162fa-9f70-f13b-eda4-52049c8b22ac
msgctxt "h629d7c83gade3g4c67g98cbgd518589960c1"
msgid "The grove isn't safe. Not anymore."
msgstr "숲은 안전하지 못해. 더 이상은 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid4
#. Speaker = Elwyn
#. NodeID = 685e5f98-c5c2-654d-a2ff-6799c9984797
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - e8142b63-8cd3-1bc7-cc0f-52876cd59134_B = True
#. SetFlags:
#.   Local:
#.     - e8142b63-8cd3-1bc7-cc0f-52876cd59134_C = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid4:685e5f98-c5c2-654d-a2ff-6799c9984797
msgctxt "h194d6f6eg8827g43e5ga251g98ddf1727095"
msgid "We don't stand a chance against an army of goblins."
msgstr "고블린 군대와 대치할 기회 조차 잡지 못했지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid4
#. Speaker = Elwyn
#. NodeID = 703c42a4-2746-0438-3db0-4d0442f7934e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - e8142b63-8cd3-1bc7-cc0f-52876cd59134_C = True
#. SetFlags:
#.   Local:
#.     - e8142b63-8cd3-1bc7-cc0f-52876cd59134_A = False
#.     - e8142b63-8cd3-1bc7-cc0f-52876cd59134_B = False
#.     - e8142b63-8cd3-1bc7-cc0f-52876cd59134_C = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid4:703c42a4-2746-0438-3db0-4d0442f7934e
msgctxt "he0d7ef52gfafeg46f5gbc16gc234138846b9"
msgid "We'll fight, but we can't win."
msgstr "우린 싸울거야. 하지만 이기진 못해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid4
#. Speaker = Elwyn
#. NodeID = 845a06de-47e8-5783-d5a9-305476068069
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#.   Local:
#.      - e8142b63-8cd3-1bc7-cc0f-52876cd59134_A = True
#. SetFlags:
#.   Local:
#.     - e8142b63-8cd3-1bc7-cc0f-52876cd59134_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid4:845a06de-47e8-5783-d5a9-305476068069
msgctxt "h82b25aa2g4c41g4868gbbb8g78b212d5a3c7"
msgid "Feels like I've been holding my breath for a tenday."
msgstr "열흘동안 숨을 참은 기분이구만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid4
#. Speaker = Elwyn
#. NodeID = a4abce55-c9f6-49e0-ddcc-5d0b6030eb30
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - e8142b63-8cd3-1bc7-cc0f-52876cd59134_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid4:a4abce55-c9f6-49e0-ddcc-5d0b6030eb30
msgctxt "h79df0f3cg40fdg41fagb3acg184af5b49d34"
msgid "We need a plan. We need a <i>leader</i>."
msgstr "계획이 필요해. 우린 <i>leader</i>가 필요해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid4
#. Speaker = Elwyn
#. NodeID = c86641a0-0d79-dfd4-f4e3-194e7d1a6e1c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#.   Local:
#.      - e8142b63-8cd3-1bc7-cc0f-52876cd59134_C = True
#. SetFlags:
#.   Local:
#.     - e8142b63-8cd3-1bc7-cc0f-52876cd59134_A = False
#.     - e8142b63-8cd3-1bc7-cc0f-52876cd59134_B = False
#.     - e8142b63-8cd3-1bc7-cc0f-52876cd59134_C = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid4:c86641a0-0d79-dfd4-f4e3-194e7d1a6e1c
msgctxt "ha6cc1bc8gc67ag4e38g8ea1g7cdc57368b86"
msgid "No more goblins. No more fighting. Just... <i>peace</i>."
msgstr "고블린도 없고. 싸움도 없어. 그저... <i>평화</i> 뿐이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid4
#. Speaker = Elwyn
#. NodeID = cd5ca79e-e944-f9ff-3ed2-0a4b30ea01a5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#. SetFlags:
#.   Local:
#.     - e8142b63-8cd3-1bc7-cc0f-52876cd59134_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid4:cd5ca79e-e944-f9ff-3ed2-0a4b30ea01a5
msgctxt "h3c570208g8b37g457dg9b63g679fef35e9dd"
msgid "I'd forgotten how beautiful our grove is."
msgstr "우리 숲이 얼마나 아름다운지 잊을 뻔했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid4
#. Speaker = Elwyn
#. NodeID = f8e624a1-6796-e1c7-29be-704e10ee4c39
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#.   Local:
#.      - e8142b63-8cd3-1bc7-cc0f-52876cd59134_B = True
#. SetFlags:
#.   Local:
#.     - e8142b63-8cd3-1bc7-cc0f-52876cd59134_C = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid4:f8e624a1-6796-e1c7-29be-704e10ee4c39
msgctxt "h1390fc3bg1bbfg4788ga7cbg7d969d8e1ccb"
msgid "We're okay. We're safe."
msgstr "살았어. 모두 안전해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid5
#. Speaker = Tahan
#. NodeID = 16d0bbcc-5b14-7fb3-1af9-7912ca309c2f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#.   Local:
#.      - df3e1892-2ab5-7b69-e57b-a75504e1a8f2_A = True
#. SetFlags:
#.   Local:
#.     - df3e1892-2ab5-7b69-e57b-a75504e1a8f2_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid5:16d0bbcc-5b14-7fb3-1af9-7912ca309c2f
msgctxt "hdf23d6abgc89dg4f05g8122gbb55b180ec3d"
msgid "Our gates should stay closed."
msgstr "문들은 닫혀 있어야 돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid5
#. Speaker = Tahan
#. NodeID = 4f150e7a-04c5-fec9-51b3-6c170e644ef0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#.   Local:
#.      - df3e1892-2ab5-7b69-e57b-a75504e1a8f2_C = True
#. SetFlags:
#.   Local:
#.     - df3e1892-2ab5-7b69-e57b-a75504e1a8f2_C = False
#.     - df3e1892-2ab5-7b69-e57b-a75504e1a8f2_B = False
#.     - df3e1892-2ab5-7b69-e57b-a75504e1a8f2_A = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid5:4f150e7a-04c5-fec9-51b3-6c170e644ef0
msgctxt "h8ae98173gc03bg450ag9dc4gd9a3a6e15d6a"
msgid "Gods, we'll never learn."
msgstr "신이여, 우린 절대 깨닫지 못할지어니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid5
#. Speaker = Tahan
#. NodeID = b4981808-acd2-2382-c3c3-bb87d8968b1c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - df3e1892-2ab5-7b69-e57b-a75504e1a8f2_C = True
#. SetFlags:
#.   Local:
#.     - df3e1892-2ab5-7b69-e57b-a75504e1a8f2_C = False
#.     - df3e1892-2ab5-7b69-e57b-a75504e1a8f2_B = False
#.     - df3e1892-2ab5-7b69-e57b-a75504e1a8f2_A = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid5:b4981808-acd2-2382-c3c3-bb87d8968b1c
msgctxt "h6a6c156bgb7deg4fd6gb5bdg61b219167ede"
msgid "We should be looking out for ourselves."
msgstr "우리는 우리끼리 잘 돌보고 살면 되는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid5
#. Speaker = Tahan
#. NodeID = b73617b5-8d94-91ee-2e0e-5b803c0e0a49
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - df3e1892-2ab5-7b69-e57b-a75504e1a8f2_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid5:b73617b5-8d94-91ee-2e0e-5b803c0e0a49
msgctxt "h66d5d5b5g9f82g4324g8d06ge974e9d0681c"
msgid "Damn outsiders, sticking their noses into our affairs."
msgstr "망할 외지놈들. 우리들 일에 왜 계속 주둥이를 들이밀어서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid5
#. Speaker = Tahan
#. NodeID = c8343f3e-026f-80cb-5b30-5a4ba283cf30
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - df3e1892-2ab5-7b69-e57b-a75504e1a8f2_B = True
#. SetFlags:
#.   Local:
#.     - df3e1892-2ab5-7b69-e57b-a75504e1a8f2_C = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid5:c8343f3e-026f-80cb-5b30-5a4ba283cf30
msgctxt "hb96fb14egb72fg45f8gb0f4g8981781cc7b9"
msgid "Why should we sacrifice ourselves for strangers?"
msgstr "왜 이방인들을 위해 우리가 희생해야 하는 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid5
#. Speaker = Tahan
#. NodeID = df156668-fa84-a47b-41b0-9d76aa77b195
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#.   Local:
#.      - df3e1892-2ab5-7b69-e57b-a75504e1a8f2_B = True
#. SetFlags:
#.   Local:
#.     - df3e1892-2ab5-7b69-e57b-a75504e1a8f2_C = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid5:df156668-fa84-a47b-41b0-9d76aa77b195
msgctxt "haf591df2gdf71g49feg9e08g4df336990931"
msgid "How many will die the next time we throw open our doors?"
msgstr "다음번에 문을 열면 또 몇 명이 죽을까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid5
#. Speaker = Tahan
#. NodeID = e547dd1e-e26c-419d-cd6a-e92fe9691cad
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#. SetFlags:
#.   Local:
#.     - df3e1892-2ab5-7b69-e57b-a75504e1a8f2_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid5:e547dd1e-e26c-419d-cd6a-e92fe9691cad
msgctxt "hacfa340cg77e7g47b8g8fafgd16636da0fe4"
msgid "Those tieflings brought nothing but trouble."
msgstr "이 티플링들은 아주 골칫거리야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid5
#. Speaker = Tahan
#. NodeID = fc1b0016-7740-0bb6-7098-e68b61054e55
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - df3e1892-2ab5-7b69-e57b-a75504e1a8f2_A = True
#. SetFlags:
#.   Local:
#.     - df3e1892-2ab5-7b69-e57b-a75504e1a8f2_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid5:fc1b0016-7740-0bb6-7098-e68b61054e55
msgctxt "hccb1d6f7g60deg4ec1g93dfgbcc7472abc56"
msgid "We had everything under control."
msgstr "원래는 아무 문제도 없었다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_SearchingBird
#. Speaker = Apikusis
#. NodeID = 0a7523ee-1849-7413-d57e-41323c75a216
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_SearchingBird:0a7523ee-1849-7413-d57e-41323c75a216
msgctxt "hd4286289g7c5eg442ag97d5gb0f9f00c39b4"
msgid "Fly quick. Fly safe."
msgstr "빠르게, 안전히 날기를."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_SearchingBird
#. Speaker = Apikusis
#. NodeID = 7490e306-2600-d216-87af-1834d23210ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_SearchingBird:7490e306-2600-d216-87af-1834d23210ae
msgctxt "h3f7af2ecg14a4g4dacga317ge67151608875"
msgid "Find our master. Return to me then."
msgstr "마스터를 찾아서, 내게 돌아와."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_SearchingBird
#. Speaker = Tingmiaq
#. NodeID = 8f5b4427-073a-6cbb-e695-b3ffb5ac3427
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_SearchingBird:8f5b4427-073a-6cbb-e695-b3ffb5ac3427
msgctxt "hb98528e4gd3dag408cga0b8gb0fcbceacaee"
msgid "*Chirp!*"
msgstr "*짹짹!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_SearchingBird
#. Speaker = Apikusis
#. NodeID = d4adf167-5edf-269b-c4a8-8492393a3867
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_SearchingBird:d4adf167-5edf-269b-c4a8-8492393a3867
msgctxt "h611a308cg0a39g4538g8ef1gd344a23c3875"
msgid "Tell me what you find. Tell <i>only </i>me. Understand?"
msgstr "돌아와서 뭘 찾았는지 알려줘. <i>나에게만</i> 말해줘야 해. 알겠지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Apikusis
#. NodeID = 02e04149-3d69-596f-0449-f37a7d49b83f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:02e04149-3d69-596f-0449-f37a7d49b83f
msgctxt "hcf5b70bfge629g4225g8f05g615d2a2380f4"
msgid "Please, not so loud!"
msgstr "제발요, 너무 크게 말하지 마세요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Player
#. NodeID = 0939b83b-71db-4e32-07a5-bc4b295616ab
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_State_DruidsPacified = False
#.      - DEN_GroveConflict_Knows_HeardAboutRitual = True
#.   User:
#.      - DEN_BirdSender_Knows_AskedAboutRitual(1) = False
#. SetFlags:
#.   User:
#.     - DEN_BirdSender_Knows_AskedAboutRitual(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:0939b83b-71db-4e32-07a5-bc4b295616ab
msgctxt "h11c2c9efgb101g432dg943dgf2ce577a7709"
msgid "I hear a ritual can protect the grove. Are you helping prepare it?"
msgstr "의례가 숲을 안전하게 지킨다던데. 당신도 준비를 돕고 있는 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Player
#. NodeID = 0973f8b4-cd21-b34e-df4c-1030e9f7c8b7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_State_DruidsPacified = False
#.      - DEN_GroveConflict_Knows_HeardAboutRitual = True
#.   User:
#.      - DEN_BirdSender_Knows_AskedAboutRitual(1) = False
#. SetFlags:
#.   User:
#.     - DEN_BirdSender_Knows_AskedAboutRitual(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:0973f8b4-cd21-b34e-df4c-1030e9f7c8b7
msgctxt "hf60477f3g7782g44cbg8593gbced8bc91fc3"
msgid "Are you helping to prepare for the ritual?"
msgstr "의례 준비를 돕고 있는 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Apikusis
#. NodeID = 0abc75d4-47fa-d088-889d-62a1daf79fa5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:0abc75d4-47fa-d088-889d-62a1daf79fa5
msgctxt "h4b1451f3ga7f0g481cg970fga187a3b10a0a"
msgid ""
"But if Master Halsin does not return, Kagha will give the order. And my "
"voice will not matter."
msgstr "하지만 할신 님이 돌아오지 않으시면, 카그하가 명령을 내릴 거예요. 그리고 제 목소리는 아무 의미도 없겠죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Player
#. NodeID = 0b34bd9b-dcde-5bcd-5ebc-6858ecf0ae10
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_State_DruidsPacified = False
#.      - DEN_GroveConflict_Knows_ZevlorSentToKagha = True
#.      - DEN_GroveConflict_Knows_KaghaSentToZevlor = False
#.   User:
#.      - DEN_BirdSender_Knows_AskedAboutRitual(1) = False
#. SetFlags:
#.   User:
#.     - DEN_BirdSender_Knows_AskedAboutRitual(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:0b34bd9b-dcde-5bcd-5ebc-6858ecf0ae10
msgctxt "hd133b362gfe01g4110g95c0gc721e405a937"
msgid "It doesn't look like you're helping with the ritual."
msgstr "의례를 돕고 있는 것처럼 보이진 않는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Apikusis
#. NodeID = 0c2b96d7-b6ba-731e-42e2-9ac43f47028a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:0c2b96d7-b6ba-731e-42e2-9ac43f47028a
msgctxt "had8e436fg567dg4f29gbe4dg8a1791f40740"
msgid ""
"A druid and an outsider? We can do nothing without turning the others "
"against us."
msgstr "드루이드 한 명과 외부인 한 명이? 다른 사람들을 등 돌리게 하지 않고는 우리가 할 수 있는 게 없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Apikusis
#. NodeID = 0dab79dd-87f8-e0dd-4e23-cc4e01688010
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:0dab79dd-87f8-e0dd-4e23-cc4e01688010
msgctxt "hd48b3945gb0fag4544gae15g697e8ad9684c"
msgid "But it could be another lie. I pray it isn't."
msgstr "하지만 또 다른 거짓말일지도 모르죠. 아니길 바라요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Player
#. NodeID = 0dade2ab-44c5-cc29-186c-ea4607e439fb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_BirdSender_Knows_AskedAboutBird(1) = False
#.   Global:
#.      - DEN_GroveConflict_State_DruidsPacified = False
#.      - DEN_BirdSender_Knows_TalkedAboutBird = False
#. SetFlags:
#.   Dialog:
#.     - DEN_BirdSender_Knows_AskedAboutBird(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:0dade2ab-44c5-cc29-186c-ea4607e439fb
msgctxt "h826b057dge437g4a79ga428g0a626b71adeb"
msgid "What were you saying to that bird?"
msgstr "새에게 뭐라고 하고 있던 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Apikusis
#. NodeID = 0dc4be4e-1307-2e7a-576e-e9c22c8c1758
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:0dc4be4e-1307-2e7a-576e-e9c22c8c1758
msgctxt "h71bb051dge20bg4ee2g8e86gb74908042c9d"
msgid "I could have forgiven her scheming. But the child..."
msgstr "모략을 꾸미는 정도는 용서해 줄 수 있어요. 하지만 그 아이는..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Apikusis
#. NodeID = 21d2a806-a979-471c-8349-6cdac1b87a15
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:21d2a806-a979-471c-8349-6cdac1b87a15
msgctxt "h13a0c876g75b9g443cg8309g24674ed34172"
msgid "It searches for news of Master Halsin. Only he can set this right."
msgstr "할신 님의 흔적을 쫓고 있어요. 오직 그만이 이 상황을 바로잡을 수 있어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Player
#. NodeID = 2a114e6c-dfdb-71f6-9d06-fef298c8853b
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:2a114e6c-dfdb-71f6-9d06-fef298c8853b
msgctxt "h9a2d909fg3813g47eagb0d7gd2b78465b82c"
msgid "I helped defend this grove - I'm not your enemy."
msgstr "난 이 숲을 방어하는 걸 도왔어. 난 당신 적이 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Player
#. NodeID = 35df983e-4a2f-a8bc-bded-964e13afa3ff
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Apprentice_HasMet(1) = False
#.   Global:
#.      - DEN_Apprentice_UserShortcut = False
#.      - DEN_Apprentice_Knows_HeardAboutNettie_PartialInfo = True
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Knows_HeardAboutNettie = True
#.   User:
#.     - DEN_BirdSender_Knows_AskedAboutNettie(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:35df983e-4a2f-a8bc-bded-964e13afa3ff
msgctxt "h1c5efdbbg7933g4544ga0bfg93c473e3cc34"
msgid "I'm looking for a healer - help me narrow the search?"
msgstr "치유사를 찾고 있는데, 혹시 도와줄 수 있을까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Apikusis
#. NodeID = 36548fb7-752d-4d56-ccca-6cef7fdbccf8
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: TIEFLING
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:36548fb7-752d-4d56-ccca-6cef7fdbccf8
msgctxt "h9c31b9d4g73b8g4d30g8dc4g6d7a354b7e08"
msgid "If not, I fear for everyone here."
msgstr "그렇지 않다면, 이곳의 모두가 걱정이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Apikusis
#. NodeID = 36548fb7-752d-4d56-ccca-6cef7fdbccf8
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:36548fb7-752d-4d56-ccca-6cef7fdbccf8
msgctxt "haada2c6bg3bbcg43e5gbce9g5de69b1c0435"
msgid "If not, I fear for my people."
msgstr "그렇지 않다면, 우리 사람들이 걱정이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Apikusis
#. NodeID = 3beb6f96-63e3-a83e-b91e-bf9926052851
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:3beb6f96-63e3-a83e-b91e-bf9926052851
msgctxt "h4a43d4ffg559dg45c9gb957g2b5d14a25adf"
msgid "Hold your tongue."
msgstr "그 입 다물어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Apikusis
#. NodeID = 3e966aba-86b2-e383-2bd6-a1a934f2942b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:3e966aba-86b2-e383-2bd6-a1a934f2942b
msgctxt "h51811d3bga89dg43fcgbcd3g328492361d59"
msgid "Not all enemies are outside our walls."
msgstr "적이 전부 벽 너머에 있으란 법은 없죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Player
#. NodeID = 40c9c5ad-f479-b7b1-df25-9e601ee2f8c0
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:40c9c5ad-f479-b7b1-df25-9e601ee2f8c0
msgctxt "hadbb6ff1gdb98g4b8fgb48cg32020ee1e9f4"
msgid "Hmm... Suspicious. Do the other druids know? Because I could tell them."
msgstr "흠... 의심스럽군. 다른 드루이드들도 이걸 알고 있나? 그들에게 말할 수도 있는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Apikusis
#. NodeID = 40e6e734-9f93-5bd8-eda7-fccc44324268
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - GLO_Tadpole_SUB_Apprentice.LearnedAboutNettie(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:40e6e734-9f93-5bd8-eda7-fccc44324268
msgctxt "h36a0e00cgf696g47e2g855dgd830dcdb9ec7"
msgid "Find Nettie in her room. Through the carved door, deeper in the grove."
msgstr "네티를 찾으세요. 숲 깊은 곳에 돌문을 따라 가면 있을 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Player
#. NodeID = 41525a17-4c9b-912a-83fb-cf09d3be034f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:41525a17-4c9b-912a-83fb-cf09d3be034f
msgctxt "h0cbd2875g4f5eg47b0gaae2gd13b27f4a701"
msgid "Halsin won't be resolving anything if he's dead."
msgstr "할신이 죽었다면 아무것도 해결하지 못해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Apikusis
#. NodeID = 4553b8e5-1efc-e4ab-b28e-e7e3ef8e6e03
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:4553b8e5-1efc-e4ab-b28e-e7e3ef8e6e03
msgctxt "hf7cbef3dg9647g4204ga711g46922487ef06"
msgid "Perhaps not. But that does not make it right."
msgstr "어쩌면 맞을지도 모르죠. 하지만 그렇다고 그게 올바른 일은 아니에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Player
#. NodeID = 4973fcb8-4b91-a21a-51ea-46180c9fe9ef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:4973fcb8-4b91-a21a-51ea-46180c9fe9ef
msgctxt "h6abb8912g0123g4886g87a9gce5e24c6bf5a"
msgid "You've known her longer - has she really changed?"
msgstr "당신이 그녀를 더 오래 알았잖아. 정말 변한 것 같아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Apikusis
#. NodeID = 49e6dc0c-49e0-34a0-5be0-97f91f7d0018
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:49e6dc0c-49e0-34a0-5be0-97f91f7d0018
msgctxt "h1aa3e9c0g6274g492bga3e5g4b3e7a06daf9"
msgid ""
"I- forgive me. My love for my brethren is strong, but 'trust'? It is "
"delicate."
msgstr "전... 용서해 주세요. 전 제 동지들을 사랑하지만, '신뢰'? 그건 더 신중하게 다뤄야 해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Player
#. NodeID = 4a0fa0a7-f26b-534a-d7ce-7c9fce6ebfc8
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:4a0fa0a7-f26b-534a-d7ce-7c9fce6ebfc8
msgctxt "hf10f7253g170bg4c73g8bafg359b7259ded9"
msgid "<b>Tell me.</b>"
msgstr "<b>알려줘.</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Player
#. NodeID = 53d1f26e-edeb-2d16-b6ef-cff0ef3bafd2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_IsFound = False
#.      - GLO_Halsin_Knows_IsMissing = False
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Knows_IsMissing = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:53d1f26e-edeb-2d16-b6ef-cff0ef3bafd2
msgctxt "h0f6f52e6g6a00g4727gb639g53582bbf81a0"
msgid "What happened to Halsin?"
msgstr "할신에게 무슨 일이 있었지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Apikusis
#. NodeID = 59f0597c-5a95-3b44-7bf8-16184243c419
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:59f0597c-5a95-3b44-7bf8-16184243c419
msgctxt "hb954e573gae81g4272g9e1bgaa7ed96a73d7"
msgid "Master Halsin welcomed the refugees in. I wait for him to resolve this."
msgstr "할신 님이 난민들을 받아들이셨어요. 그가 돌아와서 이 상황을 해결해 주길 기다리고 있어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Player
#. NodeID = 5d8dcf85-374a-c586-5483-b1f0bd6cea89
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = False
#.      - TIEFLING(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:5d8dcf85-374a-c586-5483-b1f0bd6cea89
msgctxt "h6c0a4b49g49a8g4630g9645gb56674effb62"
msgid "I'm not with the other tieflings, if that's what worries you."
msgstr "난 다른 티플링들과 한 편이 아니야, 그게 걱정이라면 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Apikusis
#. NodeID = 5f36adea-a5c3-28ff-6a87-b8f7b1176158
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:5f36adea-a5c3-28ff-6a87-b8f7b1176158
msgctxt "hc5abc9dfgb975g4b41gad9cgb5d4110fa773"
msgid "I'll tell you, but please don't do that again."
msgstr "알려드릴게요, 그러니 제발 방금 하신 건 멈춰주세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Player
#. NodeID = 5ff4793d-77bf-ed89-b717-96ce720e4eb1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Apprentice_HasMet(1) = False
#.   Global:
#.      - DEN_Apprentice_UserShortcut = False
#.      - DEN_Apprentice_Knows_HeardAboutNettie_PartialInfo = True
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Knows_HeardAboutNettie = True
#.   User:
#.     - DEN_BirdSender_Knows_AskedAboutNettie(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:5ff4793d-77bf-ed89-b717-96ce720e4eb1
msgctxt "ha92eec36g7249g4ae5g8777g8ff84ae75acb"
msgid "I'm looking for a healer - help me narrow the search?"
msgstr "치유사를 찾고 있어. 혹시 도움을 줄 수 있을까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Apikusis
#. NodeID = 65a4c127-bf73-8ff2-43ba-26bf7b7c419d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_BirdSender_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:65a4c127-bf73-8ff2-43ba-26bf7b7c419d
msgctxt "hbf219062g3756g475cgbb89ga2504ef8f279"
msgid "Speak."
msgstr "말하세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Player
#. NodeID = 66a519b1-1fc1-f5be-1b6e-4a06f8caa574
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:66a519b1-1fc1-f5be-1b6e-4a06f8caa574
msgctxt "hefb81e98g7a11g40b2g9ff9g6909aa981d4b"
msgid "You still haven't told me what you were doing with that bird."
msgstr "네가 그 새랑 뭘 하고 있었는진 아직 말해 주지 않았는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Apikusis
#. NodeID = 67bcf3b5-c4ca-3d77-3df9-19a100cb552c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - GLO_Tadpole_SUB_Druid.LearnedLostHalsin(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:67bcf3b5-c4ca-3d77-3df9-19a100cb552c
msgctxt "h19c14064gc29fg410fg9700g60ec8405c943"
msgid ""
"Master Halsin did not chase treasure. I do not know what he was chasing. But "
"he never returned."
msgstr "할신 님은 보물을 찾아 나서신 게 아니에요. 그분이 뭘 쫓고 계셨는진 모르겠지만. 돌아오지 않으셨어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Player
#. NodeID = 6e91b2ff-c3b5-fc9e-86a5-ec7f62f5052b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:6e91b2ff-c3b5-fc9e-86a5-ec7f62f5052b
msgctxt "he5b983dfg66ebg4646gb12dg3a807f856abd"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Player
#. NodeID = 80273f1f-4f66-7290-dcf1-37978805bb90
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = True
#.      - TIEFLING(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:80273f1f-4f66-7290-dcf1-37978805bb90
msgctxt "ha9ae14a5gc3c3g42e6g9c93gf90870c2d352"
msgid "Come now - surely a fellow druid is entitled to know."
msgstr "어디 보자, 동료 드루이드들도 분명 알고 싶겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Player
#. NodeID = 84395118-cf55-7a28-8ee7-a0500c27a2aa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:84395118-cf55-7a28-8ee7-a0500c27a2aa
msgctxt "h98b55549g36adg4c62gbcfdg135f52e44bd5"
msgid "Sounds like she has to be stopped. How would we do that?"
msgstr "그녀를 제지해야 할 것 같군. 방법이 있을까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Apikusis
#. NodeID = 86631fdb-8768-94da-fee5-6f2d9a3c345b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:86631fdb-8768-94da-fee5-6f2d9a3c345b
msgctxt "hfac8d415g70c1g4d3agb7fdg7bc49b0e7dc0"
msgid "I- forgive me. I don't fear your blood, tiefling. I fear my brethren."
msgstr "전... 용서해 주세요. 당신이 티플링이라 두려운 게 아닙니다. 제 동지들이 걱정이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Apikusis
#. NodeID = 882c5f4b-c619-da34-7d54-9c49fc3cbbf3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:882c5f4b-c619-da34-7d54-9c49fc3cbbf3
msgctxt "h19a31a93g9b12g4f70g8cd3gd4e706d651e5"
msgid "We may talk, but - I do not trust my brethren."
msgstr "대화를 할 순 있지만, 전 제 동지들을 신뢰하지 않아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Apikusis
#. NodeID = 92e96287-5f1f-4643-9d41-24850a691192
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:92e96287-5f1f-4643-9d41-24850a691192
msgctxt "h5b6b5f8eg6c10g4eb2g856fg58d0f9612ff0"
msgid "You pulled her from the brink. She owes you her life."
msgstr "큰 위기에서 그녀를 구하셨잖아요. 그녀는 당신에게 목숨을 빚진 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Player
#. NodeID = 935214e6-3814-2906-5470-9869b52a18a0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:935214e6-3814-2906-5470-9869b52a18a0
msgctxt "hd86af3dbg7032g46c8g8f46gefda9e84c62d"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Player
#. NodeID = 93b2b8cb-7a38-35c8-e3eb-bc9dfc51dd15
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = True
#.      - TIEFLING(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:93b2b8cb-7a38-35c8-e3eb-bc9dfc51dd15
msgctxt "h69ab6753g3c03g4d80gbc4dg18ba0c05011f"
msgid "I'm not with these other tieflings - I'm a druid. You can speak freely."
msgstr "난 다른 티플링들과 한 편이 아니다. 난 드루이드야. 내게 편히 말해도 돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Apikusis
#. NodeID = 985284d3-8a23-bb8f-472c-eb948e6708f0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_BirdSender_Knows_TalkedAboutBird = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:985284d3-8a23-bb8f-472c-eb948e6708f0
msgctxt "hc4869228g1765g4793ga6d0gefcda3b0f54b"
msgid ""
"More follow Kagha every day. They are afraid and she offers a simple "
"solution - eject the refugees and we will be safe."
msgstr ""
"점점 더 많은 이들이 카그하를 따르고 있어요. 그들은 두려워하고 있고, 카그하가 단순한 해결책을 제시해 주고 있죠. 난민들을 내쫓으면, "
"우리가 안전해질 거라고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Apikusis
#. NodeID = 9c6a8066-ce68-78f3-0db8-219b52c74847
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:9c6a8066-ce68-78f3-0db8-219b52c74847
msgctxt "hf3018834g056eg48eeg9fc8g863e1deb6fa3"
msgid "She meant to kill that poor girl. There's no coming back from that."
msgstr "그녀는 불쌍한 어린 아이를 죽이려고 했어요. 그건 돌이킬 수 없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Apikusis
#. NodeID = a3c40929-5186-16d0-393c-cbd3fa2e57a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:a3c40929-5186-16d0-393c-cbd3fa2e57a3
msgctxt "h633a043egb3b8g46f9gbf98g534c67d5594c"
msgid "I - forgive me. It is not you I fear, it is my brethren."
msgstr "전... 용서하세요. 당신을 두려워하는 게 아니라, 제 동지들을 두려워하는 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Apikusis
#. NodeID = a4adc0cc-05f2-1841-30a0-ebe6ff2b0514
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:a4adc0cc-05f2-1841-30a0-ebe6ff2b0514
msgctxt "h5a0da299gd0c8g4763g879fgb6e1bc51e5d9"
msgid "No! Please, a moment."
msgstr "안 돼! 잠시, 잠시만요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Apikusis
#. NodeID = a642ae40-ca97-30f2-f1e4-5b27657f7069
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:a642ae40-ca97-30f2-f1e4-5b27657f7069
msgctxt "h710303dfg05c9g4257g8894g057b5a0d838f"
msgid ""
"He left with the adventurers. They went treasure hunting in an old temple "
"near here."
msgstr "그는 모험가들과 함께 떠났어요. 근처에 있는 오래된 신전에 보물 사냥을 하러 떠났죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Apikusis
#. NodeID = af7bf551-7b0d-b88f-39f6-f78e30f0a0ce
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_BirdSender_HasMet_DruidsPacified(1) = False
#.   Global:
#.      - DEN_GroveConflict_State_DruidsPacified = True
#. SetFlags:
#.   Dialog:
#.     - DEN_BirdSender_HasMet_DruidsPacified(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:af7bf551-7b0d-b88f-39f6-f78e30f0a0ce
msgctxt "ha9e3995fgfc98g40efg9e71g81440ba8ab07"
msgid ""
"I knew Kagha was desperate, but I never imagined she'd get Cloakwood "
"involved."
msgstr "카그하가 절박한 상태라는 건 알았지만, 클록우드를 끌어들일 줄은 상상도 못했어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Apikusis
#. NodeID = b3d4e98b-932b-7ff7-cc8d-782a6ba325be
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:b3d4e98b-932b-7ff7-cc8d-782a6ba325be
msgctxt "hea493e23gce9eg4b5cg9ee3gdddf24c05c33"
msgid "Your brutish demands have no place here."
msgstr "당신의 끔찍한 요구는 들어줄 수 없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Player
#. NodeID = b77bb70d-e8b2-b260-d897-34d899c268ac
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_State_DruidsPacified = False
#.      - DEN_GroveConflict_Knows_ZevlorSentToKagha = True
#.      - DEN_GroveConflict_Knows_KaghaSentToZevlor = False
#.   User:
#.      - DEN_BirdSender_Knows_AskedAboutRitual(1) = False
#. SetFlags:
#.   User:
#.     - DEN_BirdSender_Knows_AskedAboutRitual(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:b77bb70d-e8b2-b260-d897-34d899c268ac
msgctxt "h8b49c149g7bbbg4d25gbe36g67d56973464d"
msgid ""
"Shouldn't the ritual protect the grove? You're not helping the others "
"prepare it."
msgstr "의식이 숲을 보호하는 거 아닌가? 다른 이들이 준비하는 걸 돕지 않고 있군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Apikusis
#. NodeID = b8586533-d1ec-2434-8045-4f01f4aaf295
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:b8586533-d1ec-2434-8045-4f01f4aaf295
msgctxt "ha0b1640dg11e2g4dfdg85e3gaa8ab2de7ffb"
msgid "Pray he is not. For the refugees' sake."
msgstr "살아있길 빌어요. 난민들을 위해서라도."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Player
#. NodeID = b8cc1c6c-7524-8f92-2687-975994837173
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:b8cc1c6c-7524-8f92-2687-975994837173
msgctxt "hd64d995fg50f9g4431g866eg333f901c407f"
msgid "And she's wrong?"
msgstr "카그하가 틀렸단 말이야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Apikusis
#. NodeID = ba6cbcf2-ea70-3724-bff6-fb3026e11b55
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KaghaIsDead = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:ba6cbcf2-ea70-3724-bff6-fb3026e11b55
msgctxt "h02a1ccdeg8347g4fbag9398gc90070cac8aa"
msgid "And it cost her her life. What a waste."
msgstr "그 대가로 목숨을 잃었죠. 어찌나 아까운지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Apikusis
#. NodeID = c24f2d09-d594-8a37-5cf1-9b999b7470f9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:c24f2d09-d594-8a37-5cf1-9b999b7470f9
msgctxt "hddec245cge715g4852gbb25gb9dab05b827e"
msgid "I would prefer not to."
msgstr "그러고 싶진 않아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Player
#. NodeID = c8900437-e590-c1ae-f511-4b21a85fa4a0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:c8900437-e590-c1ae-f511-4b21a85fa4a0
msgctxt "h07181214g3affg40b4gbf68gefd16f4b1359"
msgid "A waste? Don't you think she deserved it?"
msgstr "아깝다고요? 그녀가 마땅히 당했어야 할 일이라고 생각하지 않나요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Apikusis
#. NodeID = ccb57ed5-3a0d-68c4-701d-785ddb3bdf40
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:ccb57ed5-3a0d-68c4-701d-785ddb3bdf40
msgctxt "h42c0bbdcg16c7g4659g870bg91160d0d5577"
msgid "The ritual is Kagha's decision. But she is not our leader."
msgstr "의식은 카그하의 결정이에요. 하지만 그녀가 우리 지도자는 아니죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Apikusis
#. NodeID = ced28eaf-6beb-7757-e27f-545e003c5c32
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:ced28eaf-6beb-7757-e27f-545e003c5c32
msgctxt "heb4ac5a8g60bfg47ddg9401g6f8bb440a22f"
msgid "The bird knows. She needs to know. You do not."
msgstr "새는 알죠. 그녀는 알 필요가 있으니까요. 하지만 당신은 아니죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Apikusis
#. NodeID = cf93825a-45c7-c8d4-84d1-7868bd7621b1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_State_DruidsPacified = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:cf93825a-45c7-c8d4-84d1-7868bd7621b1
msgctxt "h988290bfg6136g4096gb42bg1e26c260c3fb"
msgid "Shadow Druids... I still can't believe it."
msgstr "그림자 드루이드라니... 아직도 믿을 수가 없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Player
#. NodeID = d24e4462-969b-5369-79bf-e11302815eb0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Apprentice_HasMet(1) = False
#.   Global:
#.      - DEN_Apprentice_UserShortcut = False
#.      - DEN_Apprentice_Knows_HeardAboutNettie_PartialInfo = True
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Knows_HeardAboutNettie = True
#.   User:
#.     - DEN_BirdSender_Knows_AskedAboutNettie(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:d24e4462-969b-5369-79bf-e11302815eb0
msgctxt "hd0a070fbg67a4g4da9gb81fg7ad095cbffbf"
msgid "I'm looking for a healer - help me narrow the search?"
msgstr "치유사를 찾고 있어. 도와줄 수 있나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Apikusis
#. NodeID = d7a2316d-c519-e443-f10f-a0b2bba99d53
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:d7a2316d-c519-e443-f10f-a0b2bba99d53
msgctxt "hd751e413g1408g4e25g9f28g03ee9794163d"
msgid "If he is gone - well, pray that he is not."
msgstr "만약 그분이 돌아가셨다면... 그렇지 않기를 바랄 뿐이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Player
#. NodeID = d9a3ccae-b1e3-9ea6-5d3a-d96f0851063c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Apprentice_HasMet(1) = False
#.   Global:
#.      - DEN_Apprentice_Knows_HeardAboutNettie = False
#.      - DEN_Apprentice_UserShortcut = False
#.   User:
#.      - DEN_BirdSender_Knows_AskedAboutNettie(1) = False
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Knows_HeardAboutNettie = True
#.   User:
#.     - DEN_BirdSender_Knows_AskedAboutNettie(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:d9a3ccae-b1e3-9ea6-5d3a-d96f0851063c
msgctxt "hd014d563g0d3cg41bega612g26f0dbdefa16"
msgid "Are there any healers in this place?"
msgstr "이곳에 혹시 치유사는 없나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Apikusis
#. NodeID = dae552a1-675a-6690-c91d-5a661352624c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:dae552a1-675a-6690-c91d-5a661352624c
msgctxt "hd9b964fdg3ec4g435fgad8dg1ff183ae582f"
msgid ""
"Before you do that, see how our First Druid treats outsiders. Then decide if "
"you would put your faith in her."
msgstr "그렇게 하기 전에, 저희 최고 드루이드가 외부인을 어떻게 대하는지 보세요. 그러고 나서 그녀를 믿어도 될지 결정하시죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Player
#. NodeID = dc327f89-fa98-bebf-a78d-6209d7a5ee60
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:dc327f89-fa98-bebf-a78d-6209d7a5ee60
msgctxt "h5af5d9d1gdbadg455eg99a6g2975cb7c2c8b"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Apikusis
#. NodeID = e431b49c-2916-aa3d-774c-6ca19f3d5edf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_BirdSender_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:e431b49c-2916-aa3d-774c-6ca19f3d5edf
msgctxt "h4bf103bag622bg426dg91c1g24762bb59273"
msgid "Again?"
msgstr "또 뭔가요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Player
#. NodeID = e7fb0a5e-5a9c-f8fa-7e29-31014cff2de5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_BirdSender_Knows_AskedAboutBird(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_BirdSender_Knows_AskedAboutBird(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender:e7fb0a5e-5a9c-f8fa-7e29-31014cff2de5
msgctxt "h6c8c8eb2g3522g457ag96ddg567de7505a11"
msgid "Is that why you were talking with that bird?"
msgstr "그래서 그 새와 대화하고 있었던 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_BirdSender
#. Speaker = Player
#. NodeID = edc125ae-364a-a930-6178-ab863113e606
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Apprentice_HasMet(1) = False
