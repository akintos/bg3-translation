msgctxt "h0579d701g432dg4062gb15bg715f9f008ad6"
msgid "No talk, only bite! Go to goblin leader for talk."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeWorg2
#. Speaker = Worg
#. NodeID = bf83ad1f-d983-8878-365e-759ad4a06098
