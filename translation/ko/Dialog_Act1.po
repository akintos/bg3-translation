msgid "Keep moving, damn it!"
msgstr "젠장, 계속 움직여!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_AD_FoundWife
#. Speaker = Benryn
