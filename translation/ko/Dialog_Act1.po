msgctxt "haead6dbeg15c6g470bgb236g43cb18bcdd98"
msgid "Right. I'll try to keep up."
msgstr "알겠어요. 따라가도록 노력할게요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_TryJoinParty
#. Speaker = Benryn
#. NodeID = 45715d95-cf37-22a8-446d-cf10bab533f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_TryJoinParty:45715d95-cf37-22a8-446d-cf10bab533f4
msgctxt "h62df96b1g2645g4909g9ccdgfe18eda4f15f"
msgid "The smoke - I can't see a damn thing!"
msgstr "연기 때문에 아무것도 안보여요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_TryJoinParty
#. Speaker = Player
#. NodeID = a502ba10-f40a-5ac6-3563-e6f9c7b095a2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_TryJoinParty:a502ba10-f40a-5ac6-3563-e6f9c7b095a2
msgctxt "h4422a244g41c2g44dagbfdbg80dc236d927e"
msgid "You're on your own."
msgstr "알아서 잘 탈출해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_TryJoinParty
#. Speaker = Benryn
#. NodeID = aca51e3a-6dc7-0dfa-37e7-99132351bb99
#. HandlePath = TaggedText[0].TagText[0]
