#.   Global:
#.     - WLD_PriestsConqueringGod_LeaveLevel = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave:3baab6aa-0f39-fed0-2613-83aa87f01508
msgctxt "hfc5a9e4dg5252g4d22ga1cdg95d95dc6da22"
msgid "Go safely, True Soul."
msgstr "안전히 가십시오, 참된 영혼이시여."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave
#. Speaker = Brynna
#. NodeID = 43d1a39b-4838-2c42-c7ba-2675c577f533
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - FOR_PriestConqueringGod_AtCaveEntrance(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave:43d1a39b-4838-2c42-c7ba-2675c577f533
msgctxt "h56769d4bg4295g4ac7g8384ga6b716c922ca"
msgid "Absolute protect us..."
msgstr "절대자님이 우리를 보호하시니..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave
#. Speaker = Player
#. NodeID = 6c5ef09c-b3a7-9d17-2865-ccaf78d75275
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave:6c5ef09c-b3a7-9d17-2865-ccaf78d75275
msgctxt "h8ef0efaag3a16g4152g8de9g0b11bff8def2"
msgid "Find the nearest stronghold and report on your mission."
msgstr "가장 가까이 있는 요새를 찾아서 너희 임무에 대해 보고하도록."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave
#. Speaker = Player
#. NodeID = 72552384-4662-56b1-519d-f7121c01fa78
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave:72552384-4662-56b1-519d-f7121c01fa78
msgctxt "hb963c2e6gc994g43a4ga19dgca5439e4e039"
msgid "Find the nearest stronghold and report on your mission."
msgstr "가장 가까이 있는 요새를 찾아서 너희 임무에 대해 보고하도록."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave
#. Speaker = Andrick
#. NodeID = 78b8f1ea-9f38-41b0-94fd-5947131d1323
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave:78b8f1ea-9f38-41b0-94fd-5947131d1323
msgctxt "h05b41bc9ga869g4e00gbdb5g4391aaebf0f3"
msgid "The Absolute wants them found, one way or another."
msgstr "절대자님께서 그들을 찾길 원하세요. 죽었든 살았든 상관없이요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave
#. Speaker = Andrick
#. NodeID = 7c8fc36c-f380-58bd-124a-8799cde0be4c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave:7c8fc36c-f380-58bd-124a-8799cde0be4c
msgctxt "h07997ddag6085g48d1ga974g9e5622fa124a"
msgid ""
"We were sent to look for fugitives. Some survivors from a crashed ship a "
"ways west along the Chionthar."
msgstr "저희는 도망자들을 수색하기 위해 파견되었습니다. 치온타르 강 서쪽에 추락한 함선의 생존자들이라더군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave
#. Speaker = Player
#. NodeID = 8071b2d1-d178-dee0-c6cd-d7a9a81890c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave:8071b2d1-d178-dee0-c6cd-d7a9a81890c0
msgctxt "h9874100ag6ea1g46e4gb9ebgfb62ddbce7db"
msgid "Perhaps. Who truly knows the ways of our god?"
msgstr "그럴지도 모르지. 우리 신의 뜻을 진정으로 이해하는 자가 어디 있겠나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave
#. Speaker = Player
#. NodeID = 820575bf-eef4-a0e3-12b7-f556cfb8edad
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_PriestOfTheConqueringGod_Cultists_Knows_Mission(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave:820575bf-eef4-a0e3-12b7-f556cfb8edad
msgctxt "hf77a1902g631cg4afegb6c8g734875a7067e"
msgid "Carry on with your hunt, then."
msgstr "그럼 너희 사냥을 계속하도록."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave
#. Speaker = Brynna
#. NodeID = 9c2bc6e0-fb2f-38e1-264e-3143f29bfa99
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FOR_DeathOfATrueSoul_Knows_GoblinCamp(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave:9c2bc6e0-fb2f-38e1-264e-3143f29bfa99
msgctxt "hf2344b50gcac6g432ega7d5g3e9702e68984"
msgid ""
"Edowin told us there was a camp of faithful goblins nearby. It'll do me good "
"to be among allies."
msgstr "에도윈이 근처에 독실한 고블린들이 세운 야영지가 있다고 했어요. 아군 근처에 있으면 좋겠죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave
#. Speaker = Player
#. NodeID = a0caf8d0-cded-efcf-b3ea-966939a67423
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave:a0caf8d0-cded-efcf-b3ea-966939a67423
msgctxt "h39f0754ag6ba6g407ega8ddg40d1c94b74a9"
msgid "He died honourably. You should be proud."
msgstr "그는 명예롭게 죽었다. 자랑스럽게 생각해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave
#. Speaker = Brynna
#. NodeID = aa141c56-1acd-ffce-437f-9ce0497bce60
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_Owlbear_State_PermaDefeated = True
#.      - FOR_PriestConqueringGod_001_Defeated = False
#. SetFlags:
#.   Object:
#.     - FOR_PriestsConqueringGod_AlliedPlayer(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave:aa141c56-1acd-ffce-437f-9ce0497bce60
msgctxt "ha02dd036ga6f2g4962g8f36g187a1325897c"
msgid "It's... dead. We couldn't have done it without you. Thank you."
msgstr "주... 죽었어요. 당신이 아니었다면 해낼 수 없었을 거예요. 감사합니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave
#. Speaker = Brynna
#. NodeID = ab9cdd52-5fa3-2d45-47f3-32a1a51575b0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FOR_DeathOfATrueSoul_Knows_GoblinCamp(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave:ab9cdd52-5fa3-2d45-47f3-32a1a51575b0
msgctxt "h04f9ed28g0f8dg4e5bg8517g273fe4568635"
msgid ""
"Edowin told us there was a camp of faithful goblins nearby. We'll find safe "
"harbour there. He'd... want us among friends."
msgstr ""
"에도윈이 근처에 독실한 고블린들이 모여있는 야영지가 있다고 했어요. 그곳에 정착하도록 하죠. 그는... 우리가 친구들과 함께 있기를 "
"원했을 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave
#. Speaker = Brynna
#. NodeID = ac8e6078-b2f5-bb78-6978-6df900bfdc82
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave:ac8e6078-b2f5-bb78-6978-6df900bfdc82
msgctxt "h7df3172fg145ag4a1dg899fg1f4ffc7a993d"
msgid ""
"I wish Edowin were here. He would have been honoured to fight alongside you."
msgstr "에도윈이 함께 있었다면 좋았을 텐데. 분명 당신 곁에서 싸우는 걸 영광으로 생각했을 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave
#. Speaker = Brynna
#. NodeID = bbc4ed88-3c70-e98d-96cb-d4a33905e468
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave:bbc4ed88-3c70-e98d-96cb-d4a33905e468
msgctxt "h8cad4e42g5253g49e0g9fe9g36bb25b645ab"
msgid "I suppose... I suppose the Absolute keeps some mysteries from us all."
msgstr "아마... 아마 절대자께서 저희에게 몇 가지는 비밀로 간직하시는 걸지도 모르죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave
#. Speaker = Player
#. NodeID = bbd71906-a82b-7e1d-9c20-c526770ee53f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_PriestOfTheConqueringGod_Cultists_Knows_Mission(1) = True
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave:bbd71906-a82b-7e1d-9c20-c526770ee53f
msgctxt "h0097b2e3g1f93g4a2fga4d3gec546a58a494"
msgid "It seems you've found one of your fugitives. Me."
msgstr "너희가 찾는 도망자를 찾은 것 같은데. 그게 나야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave
#. Speaker = Player
#. NodeID = bc6f196f-acbd-0200-72e9-86728ebd9e80
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_PriestOfTheConqueringGod_Cultists_Knows_Mission(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave:bc6f196f-acbd-0200-72e9-86728ebd9e80
msgctxt "h81bfff22gdd13g4fecg964cg62f2d5cbfe6d"
msgid "Resume your duties in the area - whatever those are."
msgstr "뭐였는진 모르겠지만, 이 지역에서 하고 있던 임무를 재개하도록."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave
#. Speaker = Brynna
#. NodeID = cb7e1953-93da-4cdc-3161-c1d8972b040d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_Owlbear_State_PermaDefeated = True
#.      - FOR_PriestConqueringGod_001_Defeated = True
#. SetFlags:
#.   Object:
#.     - FOR_PriestsConqueringGod_AlliedPlayer(2) = True
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave:cb7e1953-93da-4cdc-3161-c1d8972b040d
msgctxt "ha0cbf090g37c5g40fag8d22g7812acb196e4"
msgid "We lost Andrick. Sir."
msgstr "안드릭을 잃었습니다. 나리."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave
#. Speaker = Brynna
#. NodeID = cb7e1953-93da-4cdc-3161-c1d8972b040d
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_Owlbear_State_PermaDefeated = True
#.      - FOR_PriestConqueringGod_001_Defeated = True
#. SetFlags:
#.   Object:
#.     - FOR_PriestsConqueringGod_AlliedPlayer(2) = True
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave:cb7e1953-93da-4cdc-3161-c1d8972b040d
msgctxt "hb3631f1agc13eg4cd2gb9e3gc02efe759e75"
msgid "We lost Andrick. Ma'am."
msgstr "안드릭을 잃었습니다. 마님."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave
#. Speaker = Brynna
#. NodeID = cb7e1953-93da-4cdc-3161-c1d8972b040d
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_Owlbear_State_PermaDefeated = True
#.      - FOR_PriestConqueringGod_001_Defeated = True
#. SetFlags:
#.   Object:
#.     - FOR_PriestsConqueringGod_AlliedPlayer(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave:cb7e1953-93da-4cdc-3161-c1d8972b040d
msgctxt "h657491bdg57d1g4337gadbag09908a3c4538"
msgid "We lost Andrick. True Soul."
msgstr "안드릭을 잃었습니다. 참된 영혼이시여."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave
#. Speaker = Brynna
#. NodeID = d6545967-f2a1-1a68-7f04-220e99c43420
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_Owlbear_State_PermaDefeated = False
#. SetFlags:
#.   Object:
#.     - FOR_PriestsConqueringGod_AlliedPlayer(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave:d6545967-f2a1-1a68-7f04-220e99c43420
msgctxt "hcb91bf80g3d9cg4ee7g9cb7gc7b1ff19c2ca"
msgid "The beast's ahead. We need to get closer."
msgstr "야수가 이 앞에 있어요. 더 가까이 가야 해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave
#. Speaker = Brynna
#. NodeID = eb67d928-a154-a641-0d8f-141da6fd9203
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave:eb67d928-a154-a641-0d8f-141da6fd9203
msgctxt "hdc247db0g6358g4272gb039g7b2cd1fda383"
msgid "What would you have of me now, sir?"
msgstr "이제 어떻게 할까요, 나으리?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave
#. Speaker = Brynna
#. NodeID = eb67d928-a154-a641-0d8f-141da6fd9203
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave:eb67d928-a154-a641-0d8f-141da6fd9203
msgctxt "hb4fc8a72g5816g44a9ga732gc7a010c9a8df"
msgid "What would you have of me now, madam?"
msgstr "이제 어떻게 할까요, 마님?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave
#. Speaker = Brynna
#. NodeID = eb67d928-a154-a641-0d8f-141da6fd9203
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave:eb67d928-a154-a641-0d8f-141da6fd9203
msgctxt "h9eb81b5cg7d88g411bg8c42g308dde72c2b8"
msgid "What would you have of me now, True Soul?"
msgstr "이제 어떻게 할까요, 참된 영혼님?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave
#. Speaker = Brynna
#. NodeID = f29f0f21-5c8e-23d0-85e4-8184bb0716c3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - WLD_PriestsConqueringGod_LeaveLevel = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave:f29f0f21-5c8e-23d0-85e4-8184bb0716c3
msgctxt "h3c8bb838g7921g4f6cg9c08g2eba5810cae3"
msgid "Absolute protect you."
msgstr "절대자님이 당신을 보호하시길."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave
#. Speaker = Brynna
#. NodeID = f5a609e5-2ed4-7cbe-8006-1c39afef195a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave:f5a609e5-2ed4-7cbe-8006-1c39afef195a
msgctxt "ha1072329ge79bg4706gb6d0gce61f1e915eb"
msgid "Thank you."
msgstr "감사합니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave
#. Speaker = Brynna
#. NodeID = f778b6c3-b0ea-de53-bd7b-4d830666d33b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave:f778b6c3-b0ea-de53-bd7b-4d830666d33b
msgctxt "hd2b5957agd2ddg44b0g99c7g7a8a2af3c403"
msgid "Yes. That's what Edowin would say. And what Andrick would've done, too."
msgstr "그래요. 에도윈이라면 그렇게 말했겠죠. 그라면 그렇게 했을 거고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave
#. Speaker = Brynna
#. NodeID = fb352c81-b826-7e47-0611-9e2b2f4b42ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_InCave:fb352c81-b826-7e47-0611-9e2b2f4b42ae
msgctxt "hf02319b7gef35g4478g8adegbf3d488a1e84"
msgid "He's... with Edowin now, right? He's with the Absolute."
msgstr "그는... 이제 에도윈과 함께 있겠죠? 절대자님과 함께 일 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Player
#. NodeID = 00fa53c2-a026-4760-60a4-930169a2001d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_PriestOfTheConqueringGod_TriedAttack(3) = False
#. SetFlags:
#.   Dialog:
#.     - FOR_PriestOfTheConqueringGod_TriedAttack(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:00fa53c2-a026-4760-60a4-930169a2001d
msgctxt "hb33d1e80g5ee7g47b8gab29gd6209f86eec9"
msgid "<i>Move away, reaching for your weapon.</i>"
msgstr "<i>물러서서, 무기에 손을 가져간다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Andrick
#. NodeID = 01dfaa27-956d-da6d-7b61-17ab97f61575
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:01dfaa27-956d-da6d-7b61-17ab97f61575
msgctxt "he4dfa114g7285g4818g93f9gb70f0fcc90a4"
msgid "...But instead of them, Edowin found an owlbear. An angry one."
msgstr "...그런데 대신에 아울베어를 찾았죠. 아주 화난 놈을요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Andrick
#. NodeID = 07d34a55-ea29-c1da-6add-2e58179402b7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FOR_PriestOfTheConqueringGod_Cultists_Knows_Owlbear(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:07d34a55-ea29-c1da-6add-2e58179402b7
msgctxt "h61edb063g9dbbg4091gaaa2g96fd03852bc0"
msgid ""
"He's hurt badly. An owlbear got him deep. If there's anything you can do..."
msgstr "심하게 다쳤어요. 아울베어에게 당했죠. 도와주실 수 있다면..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Player
#. NodeID = 0a9d5961-54ec-480d-f8f1-0db6ef7ea825
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_Owlbear_State_PermaDefeated = True
#.   Object:
#.      - FOR_PriestOfTheConqueringGod_Cultists_Knows_Owlbear(3) = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:0a9d5961-54ec-480d-f8f1-0db6ef7ea825
msgctxt "hd12ac6dcg076eg4334g9c82ga11799b2fb8f"
msgid ""
"I killed an owlbear nearby. If that's what attacked your brother, consider "
"him avenged."
msgstr "근처에서 아울베어를 죽였어. 그게 너희 형제를 공격한 놈이었다면, 복수는 끝났다고 생각해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Andrick
#. NodeID = 0c5761d6-7efb-122c-2a0f-c5d732b19d09
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:0c5761d6-7efb-122c-2a0f-c5d732b19d09
msgctxt "he5fcaa7age868g4c0eg9d85g83b30c797143"
msgid ""
"I suppose... I suppose he'd want us to go on - find a way to honour his "
"sacrifice."
msgstr "아마도... 아마도 그도 저희가 계속 나아가길 바라겠죠. 그의 희생을 헛되이 하지 않을 방법을 찾아야 해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Player
#. NodeID = 0d0dd427-f089-fe9d-d6fc-3be5d4203184
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_PriestConqueringGod_001_TriedLeaving(3) = False
#.   Global:
#.      - FOR_Owlbear_State_PermaDefeated = False
#.   Object:
#.      - FOR_PriestOfTheConqueringGod_Cultists_Knows_Owlbear(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:0d0dd427-f089-fe9d-d6fc-3be5d4203184
msgctxt "h3c081a67gba56g459egb65bgdf24d91a0e5b"
msgid "Forget the owlbear. You're still alive - so <i>go</i>."
msgstr "아울베어는 잊어버려. 아직 숨은 붙어 있으니, 이만 가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Player
#. NodeID = 0d665e36-98b8-6bcf-4fd8-b1284c2e445c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_PriestOfTheConqueringGod_Cultists_Knows_Mission(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:0d665e36-98b8-6bcf-4fd8-b1284c2e445c
msgctxt "h65a45082gb258g4db8g94ebga7d3b77b53bb"
msgid "These fugitives - tell me more."
msgstr "도망자라. 더 자세히 말해 줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Gale
#. NodeID = 0f6eff0c-18a2-857f-4a4f-36ffe0408487
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(10) = True
#.   Tag:
#.      - REALLY_GALE(10) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:0f6eff0c-18a2-857f-4a4f-36ffe0408487
msgctxt "h6a92f57ag920ag4463gbcfag465022a3fd8f"
msgid ""
"That fellow had a tadpole in his head, and they consider him blessed? "
"Chosen? What madness is this?"
msgstr "그 녀석도 머리에 올챙이가 있었어, 그런데 그가 축복받은 존재라고 생각한다고? 선택받았다고? 이게 무슨 광기지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Player
#. NodeID = 0f79d272-5afe-98fb-2c07-96264162c595
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_PriestOfTheConqueringGod_Cultists_Knows_Mission(3) = False
#. SetFlags:
#.   Dialog:
#.     - FOR_PriestOfTheConqueringGod_Cultists_Knows_Mission(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:0f79d272-5afe-98fb-2c07-96264162c595
msgctxt "hb2527253gf40fg4c9bg9966ga36f5416d5f0"
msgid "Why are you out here? The wilderness is dangerous."
msgstr "여긴 왜 나와있는 거지? 야생은 위험이 가득해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Brynna
#. NodeID = 1120c73f-8e15-11c2-8671-4a660e283373
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:1120c73f-8e15-11c2-8671-4a660e283373
msgctxt "h6de9a94cg40aeg45dfg9d26g36cdbc67cb37"
msgid "I'm sorry, True Soul. I... only repeated what I thought I knew."
msgstr "죄송합니다, 참된 영혼이시여. 전... 그저 배운 것을 말했을 뿐입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Andrick
#. NodeID = 128bd543-e870-96cf-ca6d-b1dacb9ec72a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_PriestOfTheConqueringGod_Cultists_TrueSoulPowersUsed(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:128bd543-e870-96cf-ca6d-b1dacb9ec72a
msgctxt "h33ee7a32gda83g41c4gb6dcg21ce2b399d2d"
msgid ""
"A True Soul. Thank the Absolute. Edowin, our brother - he was chosen. Like "
"you."
msgstr "참된 영혼이시군요. 절대자님께 감사를. 저희 형제, 에도윈도 선택받았었어요. 당신처럼요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Edowin
#. NodeID = 134172e4-ea6c-7395-72cd-6614eaf3fec5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:134172e4-ea6c-7395-72cd-6614eaf3fec5
msgctxt "h536e8b36g0862g4e2ega7eegef5bb3a6338e"
msgid "Wait."
msgstr "잠깐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Brynna
#. NodeID = 155f9ac4-cb92-5306-0e41-eabb44b7c336
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:155f9ac4-cb92-5306-0e41-eabb44b7c336
msgctxt "h0dff1609gc45fg4ac9gb55dgd6cb3fe5cdc1"
msgid "I'm watching you."
msgstr "내가 계속 지켜보겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Player
#. NodeID = 1dca5db0-0ce1-fe7f-071a-0f6a4e594fef
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 54fb952d-a4e1-2381-0646-e8ce1c5513c2_ExplainDoctrine = False
#. SetFlags:
#.   Local:
#.     - 54fb952d-a4e1-2381-0646-e8ce1c5513c2_ExplainDoctrine = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:1dca5db0-0ce1-fe7f-071a-0f6a4e594fef
msgctxt "h8469dd35gf703g4194ga57fg1b6e30864f17"
msgid "True Soul?"
msgstr "참된 영혼이라고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Andrick
#. NodeID = 24a777d5-1d05-fd4e-8495-4d38cd563d12
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:24a777d5-1d05-fd4e-8495-4d38cd563d12
msgctxt "h9c068a45g8f43g4a86g91a1g0391b3ea285b"
msgid "Edowin. Ed! <i>Please!</i>"
msgstr "에도윈. 에드! <i>안 돼!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Player
#. NodeID = 32c6453c-1a37-8ca8-2c82-cff8488751cc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:32c6453c-1a37-8ca8-2c82-cff8488751cc
msgctxt "h8cae7d21gbfe6g45b8g82b6g5ee82f4b1b25"
msgid "<i>Hold his stare.</i>"
msgstr "<i>그의 눈을 마주 본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Player
#. NodeID = 32ff67b5-593e-a548-03ba-6e8cd273f620
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:32ff67b5-593e-a548-03ba-6e8cd273f620
msgctxt "hce67ce02g7dfeg441bg8621gbe71b33fdda5"
msgid "I don't take orders from cowering children."
msgstr "겁에 질린 애새끼들의 명령 따위 받지 않는다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Player
#. NodeID = 32ff67b5-593e-a548-03ba-6e8cd273f620
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:32ff67b5-593e-a548-03ba-6e8cd273f620
msgctxt "hb7287cfag78d2g4a2fg8a23gd5d760f42728"
msgid "<i>Stay quiet, keeping a careful eye on them.</i>"
msgstr "<i>그들을 주의 깊게 관찰하면서 조용히 있는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Player
#. NodeID = 32ff67b5-593e-a548-03ba-6e8cd273f620
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:32ff67b5-593e-a548-03ba-6e8cd273f620
msgctxt "h32ce0e14gf7e9g42c1ga4efg2f851ef189d7"
msgid "<i>Raise a brow. You aren't impressed.</i>"
msgstr "<i>이마를 모은다. 전혀 감명받지 않았다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Player
#. NodeID = 32ff67b5-593e-a548-03ba-6e8cd273f620
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:32ff67b5-593e-a548-03ba-6e8cd273f620
msgctxt "hbfeeae04g3482g49fdgb73dgaf8f3ee2eee9"
msgid "<i>Glower at them. </i>"
msgstr "<i>그들을 노려본다. </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Player
#. NodeID = 32ff67b5-593e-a548-03ba-6e8cd273f620
#. HandlePath = TaggedText[4].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:32ff67b5-593e-a548-03ba-6e8cd273f620
msgctxt "h7a3a2eb2gb866g45d0g8ddbg4f123485f6d5"
msgid "<i>Freeze and hold up your hands.</i>"
msgstr "<i>멈춰서 손을 들어 올린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Player
#. NodeID = 35659c11-056e-fcb7-234f-a6f22aaa24a0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:35659c11-056e-fcb7-234f-a6f22aaa24a0
msgctxt "h0cf59dd1gf686g49c3g8889g67b95613cdac"
msgid "<i>Try to block him out.</i>"
msgstr "<i>그를 떨쳐낸다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Andrick
#. NodeID = 36d1cb42-dfd2-ceb6-3075-e2b69618e533
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:36d1cb42-dfd2-ceb6-3075-e2b69618e533
msgctxt "h48c683d3g9a45g4720gb206gbba696b4ff8e"
msgid "And just... leave Ed?"
msgstr "그리고... 그냥 에드를 두고 가라고요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Karlach
#. NodeID = 39d71d61-f61f-d6ec-e872-248e3f01c74b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_KARLACH(6) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:39d71d61-f61f-d6ec-e872-248e3f01c74b
msgctxt "h195bff3bgd9e2g4771ga0e6g8e4d747fb6e5"
msgid "I don't serve, and I don't rule. With or without tadpole."
msgstr "난 섬기지도, 지배하지도 않아. 올챙이가 있든 없든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Andrick
#. NodeID = 3c783a2b-c1c2-306c-a5d7-143a7d371c3f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:3c783a2b-c1c2-306c-a5d7-143a7d371c3f
msgctxt "h32acf2c8gf275g4063gb8f2gb64eb3723fd9"
msgid "Really? You killed that thing?"
msgstr "정말요? 그 짐승을 죽여버렸다고요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Andrick
#. NodeID = 3d087672-cbd7-14eb-4fe4-e5b8323e9ca7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:3d087672-cbd7-14eb-4fe4-e5b8323e9ca7
msgctxt "h803671d8gec0ag42e5gb588gc196aea4f814"
msgid ""
"I <i>told </i>Edowin not to look in that cave - it was filthy with owlbear "
"tracks."
msgstr "에도윈에게 동굴 안은 위험하다고 했는데, 아울베어 흔적이 온 사방에 있었어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Narrator
#. NodeID = 4082280e-e134-ceb5-e554-cb17011c2220
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount3(3) = False
#.   Tag:
#.      - TRUESOUL(3) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount3(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:4082280e-e134-ceb5-e554-cb17011c2220
msgctxt "hb10d8880gf976g41fdg8b58g2aba4fc80ef5"
msgid "*Your mind lurches, reeling suddenly as if... bitten.*"
msgstr "*뭔가에 깨물린 것처럼 느닷없이 정신이 휘청거립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Andrick
#. NodeID = 421879ea-7c6c-25dd-c51e-1b23ceb23396
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_PriestOfTheConqueringGod_Cultists_Knows_Mission(3) = False
#. SetFlags:
#.   Dialog:
#.     - FOR_PriestOfTheConqueringGod_Cultists_Knows_Mission(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:421879ea-7c6c-25dd-c51e-1b23ceb23396
msgctxt "h51e48fe1gb705g41a8ga308g64bd112a71c3"
msgid ""
"We were looking for fugitives. Survivors from that ship that crashed farther "
"west of here."
msgstr "도망자들을 찾고 있어요. 이곳에서 서쪽으로 멀리 떨어진 곳에 추락한 함선의 생존자들이죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Narrator
#. NodeID = 42aff4ff-0a04-6ab7-0cd0-46505164e782
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - GLO_TadpoleIntro_NPC(3) = False
#. SetFlags:
#.   User:
#.     - GLO_TadpoleIntro_NPC(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:42aff4ff-0a04-6ab7-0cd0-46505164e782
msgctxt "haa7be14ega838g4f6dgb7a8g9c50c90f29ef"
msgid ""
"*A strange symbol glows, marked on their flesh, and something within you "
"stirs in response.*"
msgstr "*그들의 살갗에 새겨진 기묘한 상징이 빛나고, 이에 반응하여 당신 내면의 무언가가 꿈틀거립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Brynna
#. NodeID = 46023046-cef4-e973-9381-7a7d815c8a81
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:46023046-cef4-e973-9381-7a7d815c8a81
msgctxt "h1458844bg223fg4cf3g8018g7e79002cd004"
msgid "What are you doing?! Your sword, brother. <i>Now.</i>"
msgstr "뭐 하는 거야?! 검을 들어, 동생아. <i>당장.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Player
#. NodeID = 4bc1640a-71fb-17b1-3819-0653b185cdbf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Absolute_Knows_TrueSoul = False
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(3) = False
#.   Tag:
#.      - TRUESOUL(3) = True
#. SetFlags:
#.   Dialog:
#.     - FOR_PriestOfTheConqueringGod_Cultists_TrueSoulPowersUsed(3) = True
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:4bc1640a-71fb-17b1-3819-0653b185cdbf
msgctxt "h15c44631g7d2bg42aegb8d8gb2b7f696fa50"
msgid "I will go where I wish."
msgstr "난 내가 가고 싶은 데로 간다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Brynna
#. NodeID = 4d4eedd3-a4f1-0aee-fb7a-e530ae8fee58
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:4d4eedd3-a4f1-0aee-fb7a-e530ae8fee58
msgctxt "ha92e3723g800bg42e8g9f11g863c22601c1a"
msgid "You! Not a step closer."
msgstr "너! 한 발짝도 다가오지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Narrator
#. NodeID = 4d8f81b0-1e78-6777-ba31-7afea1c4e202
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:4d8f81b0-1e78-6777-ba31-7afea1c4e202
msgctxt "h6bafd7bdg4015g4970gb015gbc86ae60703e"
msgid ""
"*Your limbs do not obey. Your minds intertwine. You see his siblings - "
"Andrick and Brynna. New recruits. Yours to shepherd.*"
msgstr ""
"*사지가 말을 듣지 않습니다. 서로의 정신이 뒤얽힙니다. 그의 형제자매인 안드릭과 브리나가 보입니다. 새로운 추종자들입니다. 당신이 "
"목자가 되어 돌봐야 할 양떼들입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Player
#. NodeID = 4e5316b2-fcc6-21a9-49c8-063c78a5aec6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_PriestConqueringGod_001_TriedLeaving(3) = True
#.   Global:
#.      - FOR_Owlbear_State_PermaDefeated = False
#.   Object:
#.      - FOR_PriestOfTheConqueringGod_Cultists_Knows_Owlbear(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:4e5316b2-fcc6-21a9-49c8-063c78a5aec6
msgctxt "hb1f3f4f7g1855g4684gaf3dgd8d257214850"
msgid "Forget the owlbear. You're still alive - so <i>go</i>."
msgstr "아울베어는 잊어버려. 아직 숨은 붙어 있으니, 이만 가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Brynna
#. NodeID = 5016449d-6010-4866-7329-93f628bcfa6c
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:5016449d-6010-4866-7329-93f628bcfa6c
msgctxt "he51f811bg9b94g49c0g9f64g4be65ba525d4"
msgid "We know that all too well, sir. But... the Absolute sent us here."
msgstr "저희도 그건 잘 알고 있습니다, 나으리. 하지만... 절대자님께서 저희를 여기로 보내셨습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Brynna
#. NodeID = 5016449d-6010-4866-7329-93f628bcfa6c
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:5016449d-6010-4866-7329-93f628bcfa6c
msgctxt "h42873d80g4037g49b2g8b24gd18cda01081f"
msgid "We know that all too well, ma'am. But... the Absolute sent us here."
msgstr "저희도 그건 잘 알고 있습니다, 마님. 하지만... 절대자님께서 저희를 여기로 보내셨습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Brynna
#. NodeID = 5016449d-6010-4866-7329-93f628bcfa6c
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:5016449d-6010-4866-7329-93f628bcfa6c
msgctxt "h3d9d63deg9b95g4afaga8d4g353e3f0a8c49"
msgid "We know that all too well. But... the Absolute sent us here."
msgstr "저희도 그건 잘 알고 있습니다. 하지만... 절대자님께서 저희를 여기로 보내셨습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Brynna
#. NodeID = 54fff703-d37a-8871-ab8e-e594c6d560bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:54fff703-d37a-8871-ab8e-e594c6d560bf
msgctxt "heee4c863g287cg4d10g9043gbd5bbe8907ee"
msgid ""
"It killed one of us. It killed <i>Edowin</i>. It's an enemy of the Absolute."
msgstr "그게 우리 형제를 죽였습니다. <i>에도윈을</i> 죽였어요. 그건 절대자님의 적입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Brynna
#. NodeID = 565875ec-b81d-e839-b66c-1cf5b62537fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:565875ec-b81d-e839-b66c-1cf5b62537fd
msgctxt "hc1ed8ccag12ebg4c44ga4c6g414a6fa2aef3"
msgid "You're a True Soul. You can't die. <i>Please </i>stay with us."
msgstr "참된 영혼이시잖아요. 죽으면 안 돼요. 제발 우리 곁에 남아 줘요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Player
#. NodeID = 575474f6-3510-72df-5f30-57a832eaa705
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_Owlbear_State_PermaDefeated = True
#.   Object:
#.      - FOR_PriestOfTheConqueringGod_Cultists_Knows_Owlbear(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:575474f6-3510-72df-5f30-57a832eaa705
msgctxt "hb75877c0g7e2ag475cg863bg5d47ddb1ec08"
msgid "The beast is dead. You should be on your way."
msgstr "그 짐승은 죽었어. 가던 길 계속 가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Brynna
#. NodeID = 63050e81-ac46-884f-c2ac-ae2a4d791cfa
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - WLD_PriestsConqueringGod_LeaveLevel = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:63050e81-ac46-884f-c2ac-ae2a4d791cfa
msgctxt "h817f8415g6b1cg49a8g8ef7ge4df5c9433c0"
msgid "May the Absolute guide us."
msgstr "절대자님이 저희를 인도하시길."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Narrator
#. NodeID = 63cec765-b222-acde-8b72-dc34df3d0080
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TRUESOUL(3) = False
#. SetFlags:
#.   Tag:
#.     - TRUESOUL(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:63cec765-b222-acde-8b72-dc34df3d0080
msgctxt "h1015c3d7gabd7g4209ga068g54e8fbab4a3f"
msgid ""
"*Your mind is full, bursting with ecstasy and terror. Finally, it is coming. "
"You are becoming.*"
msgstr "*당신의 정신이 황홀경과 공포로 가득 차오릅니다. 마침내, 때가 됐군요. 당신은 변화 중입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Andrick
#. NodeID = 649cd431-27bb-e650-6aeb-a208d39313e7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_PriestOfTheConqueringGod_Cultists_Knows_Mission(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:649cd431-27bb-e650-6aeb-a208d39313e7
msgctxt "hd0d3f119g4066g4fb4g800dgad5476e3133b"
msgid "An owlbear. It had him on the ground before we had a chance to react."
msgstr "아울베어에게 당했어요. 저희가 손쓸 시간도 없이 그를 바닥에 눕혀버렸죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Andrick
#. NodeID = 68b86c70-c445-48d5-fdf4-c964d6fa7ade
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:68b86c70-c445-48d5-fdf4-c964d6fa7ade
msgctxt "h6f0fa7fbg0709g4729g8887gea68d6bf5706"
msgid ""
"The Absolute is our goddess. She's going to rip down the old world order, "
"start a new one."
msgstr "절대자님은 저희의 여신님입니다. 그녀는 구세계의 질서를 무너뜨리고, 새로운 세상을 만들려고 하고 계시죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Narrator
#. NodeID = 6b31dd06-fcf9-ef17-a5cf-c2f58fc40187
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:6b31dd06-fcf9-ef17-a5cf-c2f58fc40187
msgctxt "he44cd7ccg9da0g4170g96f5g1324d38071bf"
msgid ""
"*Useless. Your minds intertwine. You see his siblings - Andrick and Brynna. "
"New recruits. Yours to shepherd.*"
msgstr ""
"*소용없습니다. 서로의 정신이 뒤얽힙니다. 그의 형제자매가 보입니다. 안드릭과 브리나 입니다. 새로운 추종자들입니다. 당신이 목자가 되어 "
"돌봐야 할 양떼들입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Narrator
#. NodeID = 7185ef9d-670d-053c-43f3-14282f0cc802
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount5(3) = False
#.   Tag:
#.      - TRUESOUL(3) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount5(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:7185ef9d-670d-053c-43f3-14282f0cc802
msgctxt "h95860c02gfbb3g444bgb72agb50bd8cf07b2"
msgid ""
"*Your blood runs quicker, feeding the gnawing absence at the centre of your "
"mind.*"
msgstr "*피가 더 빨리 흐르면서, 당신의 정신 한가운데를 좀먹는 허전함을 양분으로 채웁니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Player
#. NodeID = 72bfa96b-57b8-e503-934c-e12ecae76241
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_PriestOfTheConqueringGod_Cultists_Knows_Mission(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:72bfa96b-57b8-e503-934c-e12ecae76241
msgctxt "h4f836ed9gcb98g470bg8cc3ge16eba9ee7da"
msgid "<i>I'm</i> a survivor of that crash. Looks like you found me."
msgstr "<i>내가</i> 그 추락의 생존자야. 날 찾고 있었나 보군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Narrator
#. NodeID = 72f51c92-a466-9ffa-86bc-90f08b9e5c0c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:72f51c92-a466-9ffa-86bc-90f08b9e5c0c
msgctxt "hf73877b2gf01dg4cbeg98adg71a7e87a8b39"
msgid ""
"*Your minds intertwine. You see his siblings - Andrick and Brynna. New "
"recruits. Yours to shepherd.*"
msgstr ""
"*서로의 정신이 뒤얽힙니다. 그의 형제자매가 보입니다. 안드릭과 브리나 입니다. 새로운 추종자들입니다. 당신이 목자가 되어 돌봐야 할 "
"양떼들입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Andrick
#. NodeID = 75d0d9fc-a5f8-df6f-dc70-ff76ef2fcb84
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:75d0d9fc-a5f8-df6f-dc70-ff76ef2fcb84
msgctxt "h70b249d2g824dg4209ga0f2g31b12b9c8ee3"
msgid "<i>You...? </i>Brynna - kill him!"
msgstr "<i>당신...? </i>브리나 - 그를 죽여!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Andrick
#. NodeID = 75d0d9fc-a5f8-df6f-dc70-ff76ef2fcb84
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:75d0d9fc-a5f8-df6f-dc70-ff76ef2fcb84
msgctxt "hdd4c16adg71eag4fb7g834bg383d5331e943"
msgid "<i>You...? </i>Brynna - kill her!"
msgstr "<i>당신...? </i>브리나 - 그녀를 죽여!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Andrick
#. NodeID = 75d0d9fc-a5f8-df6f-dc70-ff76ef2fcb84
#. HandlePath = TaggedText[2].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:75d0d9fc-a5f8-df6f-dc70-ff76ef2fcb84
msgctxt "h1100c3ecga063g41ccga394g3a8a417b9235"
msgid "<i>You...? </i>Brynna - kill them!"
msgstr "<i>당신...? </i>브리나 - 그들을 죽여!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Brynna
#. NodeID = 767f56f7-0a8b-cb9b-cf1d-167d362cc9b9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_PriestOfTheConqueringGod_Cultists_TrueSoulPowersUsed(3) = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:767f56f7-0a8b-cb9b-cf1d-167d362cc9b9
msgctxt "h495c8ee3g5b9fg4032g8758g3fca819ec50d"
msgid ""
"You're... you're a True Soul. Edowin, our brother - he was chosen. Like you."
msgstr "당신... 당신은 참된 영혼이시군요. 저희의 형제, 에도윈도 당신같이 선택받은 자였어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Andrick
#. NodeID = 7ad00580-5dbb-f991-ac87-5b4a6b9684dd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:7ad00580-5dbb-f991-ac87-5b4a6b9684dd
msgctxt "hba0796e7g8938g4bb6g8273g509b84de593c"
msgid "The Absolute wants them found. At any cost."
msgstr "절대자께서 그들을 찾길 원하세요. 어떤 대가를 치러서라도요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Wyll
#. NodeID = 7c52da3f-51be-cd73-b3b9-aa0d2988e539
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(9) = True
#.   Tag:
#.      - REALLY_WYLL(9) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:7c52da3f-51be-cd73-b3b9-aa0d2988e539
#, fuzzy
msgctxt "h8ceb6a60g8580g4100g8122gd3e41b4d3e1d"
msgid "That fellow was infected, like us. Is this the mark of a True Soul?"
msgstr "저 녀석도 우리처럼 감염된 상태였어. 참된 영혼의 특징인 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Player
#. NodeID = 7c64c077-88f2-37a1-764e-9e0af94063fa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 54fb952d-a4e1-2381-0646-e8ce1c5513c2_ExplainDoctrine = False
#. SetFlags:
#.   Local:
#.     - 54fb952d-a4e1-2381-0646-e8ce1c5513c2_ExplainDoctrine = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:7c64c077-88f2-37a1-764e-9e0af94063fa
msgctxt "h7fb6a53eg1439g4e21g82eeg74ee6e71c7ec"
msgid "Explain this Absolute to me."
msgstr "이 절대자라는 것에 관해서 설명해 줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Narrator
#. NodeID = 7e48619c-24b6-5c7c-055d-f9c13e19f217
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount2(3) = False
#.   Tag:
#.      - TRUESOUL(3) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount2(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:7e48619c-24b6-5c7c-055d-f9c13e19f217
msgctxt "h90505216g417cg415dgb3b4ge4f1a1bb4c4f"
msgid ""
"*Something stirs deep within you, hungry and alert... it's taking something "
"you'll never get back.*"
msgstr "*몸 깊숙한 데서 굶주리고 기민한 존재가 꿈틀댑니다... 잃으면 되찾지 못할 뭔가를 좀먹고 있군요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Player
#. NodeID = 7ed468da-ffa9-6af7-d832-a6b10cd3ee83
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - FOR_PriestOfTheConqueringGod_Cultists_Knows_Owlbear(3) = False
#. SetFlags:
#.   Object:
#.     - FOR_PriestOfTheConqueringGod_Cultists_Knows_Owlbear(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:7ed468da-ffa9-6af7-d832-a6b10cd3ee83
msgctxt "h2e7560f8g63d5g45c8gaf22gb1e2b2b41883"
msgid "What happened to your brother exactly?"
msgstr "네 형제에게 정확히 무슨 일이 있었던 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Brynna
#. NodeID = 892fa4a0-c6b7-adc8-39ca-5d58b2fef7d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:892fa4a0-c6b7-adc8-39ca-5d58b2fef7d9
msgctxt "h99c28061ge676g449ag9b5cg18fdec2f9912"
msgid "He's with the Absolute now."
msgstr "절대자님 곁으로 갔어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Andrick
#. NodeID = 8a07340c-3223-ccf6-1933-79a11591feeb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:8a07340c-3223-ccf6-1933-79a11591feeb
msgctxt "h1505bca0g5bf4g4e3cg9467g669dd19364ee"
msgid ""
"We don't know what they look like, but anyone who survived that crash is "
"bound to be injured. That's enough to get us started."
msgstr ""
"그들이 어떻게 생겼는진 모르지만, 그런 추락에서 살아남았다면 분명 상처를 입었을 거예요. 그 정도면 수색을 하는 데 많은 도움이 되겠죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Shadowheart
#. NodeID = 8bad875a-aee0-0b25-23c9-82b96d2a0430
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:8bad875a-aee0-0b25-23c9-82b96d2a0430
msgctxt "h9e799516ga9e1g490aga188g968f3569b514"
msgid "Please. Any supposed new god would have an uphill battle."
msgstr "제발. 소위 새로운 신이라는 모든 이들은 힘든 싸움을 거쳐야 할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Brynna
#. NodeID = 8c9defb2-46b4-bed7-35c5-cfd024aa39bd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:8c9defb2-46b4-bed7-35c5-cfd024aa39bd
#, fuzzy
msgctxt "h3f6a4af7gbc5fg4816g81b2g4fd5b27233c5"
msgid "I don't know any druids."
msgstr "제가 아는 드루이드는 없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Narrator
#. NodeID = 8fb05baf-2ee8-1e37-8f45-dc13afe778e6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:8fb05baf-2ee8-1e37-8f45-dc13afe778e6
msgctxt "h091746a4g177eg4fffgbaddgd5300b9b695d"
msgid ""
"*The mark glows, but you feel nothing in response. Your illithid power is "
"beyond reach until you rest.*"
msgstr "*문양이 빛나지만, 어떤 반응도 느껴지지 않습니다. 일리시드 능력을 더 사용하려면 휴식을 취해야 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Brynna
#. NodeID = 962275ec-e031-9274-f858-875c70f52de3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:962275ec-e031-9274-f858-875c70f52de3
msgctxt "h8b8a716eg6d42g4c43g8b96gadf3f9236fd3"
msgid "It seems the Absolute still has a great deal to teach me."
msgstr "절대자님께 배울 것이 아직 많이 남은 것 같군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Player
#. NodeID = 96e738ab-a24d-6d4b-ac00-7976fb62d0d2
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_GOOD or PALADIN_GOOD
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:96e738ab-a24d-6d4b-ac00-7976fb62d0d2
msgctxt "h34a2303dgf709g4be2gbea6g20de602f3e9c"
msgid "He's wounded. I'd like to help - if you'll let me."
msgstr "상처를 입었군. 당신들이 허락한다면, 내가 돕고 싶은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Brynna
#. NodeID = 9738aaf7-9916-7155-b2de-58e908c574ca
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:9738aaf7-9916-7155-b2de-58e908c574ca
msgctxt "h41f9f6e6g2332g473cgbf51g779c6b46d429"
msgid "You're right, sir. The beast must be destroyed."
msgstr "나으리 말이 맞습니다. 그 짐승은 제거되어야 해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Brynna
#. NodeID = 9738aaf7-9916-7155-b2de-58e908c574ca
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:9738aaf7-9916-7155-b2de-58e908c574ca
msgctxt "h1e274018g2557g4c68g94c8gcbda95a166ee"
msgid "You're right, madam. The beast must be destroyed."
msgstr "마님 말이 맞습니다. 그 짐승은 제거되어야 해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Brynna
#. NodeID = 9738aaf7-9916-7155-b2de-58e908c574ca
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:9738aaf7-9916-7155-b2de-58e908c574ca
msgctxt "h23fa54bcgaa61g4856gba16g51599256ac1c"
msgid "You're right. The beast must be destroyed."
msgstr "당신 말이 맞습니다. 그 짐승을 처리해야 해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Player
#. NodeID = 981e03d2-cc98-8102-d0ed-a448050496d4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_PriestOfTheConqueringGod_TriedAttack(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:981e03d2-cc98-8102-d0ed-a448050496d4
msgctxt "h5048f4e8g22b3g4ed0g8395ge318514fe0eb"
msgid "<i>Try to flee.</i>"
msgstr "<i>도망친다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Edowin
#. NodeID = 99e42ad0-c639-d302-17ba-8867ca3e22f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:99e42ad0-c639-d302-17ba-8867ca3e22f0
msgctxt "hc05684b4g231eg425cga9dcg13a6b10eb223"
msgid "<i>Protect them.</i>"
msgstr "<i>이들을 지켜줘.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Andrick
#. NodeID = 9c5d7aed-7bf2-e52c-4bd5-dce6be0c9f1c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:9c5d7aed-7bf2-e52c-4bd5-dce6be0c9f1c
msgctxt "h7cffd53fg262bg4b47g9fb4g0e602d182127"
msgid "Wait! Please - don't leave us. What should we do now...?"
msgstr "기다려! 제발... 우릴 두고 가지 마. 이제 우린 뭘 해야 하지...?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Edowin
#. NodeID = 9d0bfa35-1872-b91e-141a-f7f47e1dc2ad
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
