msgctxt "h34ec9c02gdbfag4711g932fg364bd3887b07"
msgid "Drink the potion."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = b25bbb53-d23c-4d0b-8451-192492a1119e
#. HandlePath = TaggedText[0].TagText[0]
