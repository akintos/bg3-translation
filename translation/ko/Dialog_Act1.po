msgctxt "h161589f6g72c6g4f47ga8cbg3ed841e15d9e"
msgid "<i>Attack the tiefling.</i>"
msgstr "<i>티플링을 공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene
#. Speaker = Nymessa
#. NodeID = f18a1876-b780-6d5e-01fe-355583473147
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene:f18a1876-b780-6d5e-01fe-355583473147
msgctxt "h87210b3dg6659g487cg9e6agb8fb1ba659d4"
msgid "But Damays, if it's intelligent... We can't just..."
msgstr "하지만 다메이스, 저게 지성이 있다면... 그냥 무작정..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene
