msgctxt "h98eb2a36gf4b6g4994ga5deg49f1f535b438"
msgid "I've had three."
msgstr "벌써 세 잔 마셨어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hagspawn_AD_HagSurrogateMotherStartScene
