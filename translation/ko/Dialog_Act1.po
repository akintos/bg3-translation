msgctxt "h54f61489g9a12g46deg8fa5gdef91b3ccd75"
msgid "We met these brothers. Guess they didn't find their sis."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_HagAmush_PAD_FoundBrothersAfterLongRest
