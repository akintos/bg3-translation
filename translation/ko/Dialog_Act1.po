msgctxt "h45e0f583gce76g4be2g8b8cg41c1524948b1"
msgid "The old crone had a back door. Interesting."
msgstr "그 노파에게 뒷문이 있었잖아. 흥미롭군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_FairyRings_PAD_TeleportedFromUnderdarkToHag
