msgctxt "hbe76954dgd4cbg4213g94b3gdbc81deed164"
msgid "*Screech.*"
msgstr "*끼익.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_AnimatedArmor_AD
#. Speaker = Animated Armour
#. NodeID = 7b417dec-a327-63da-fa49-062b60cc1098
