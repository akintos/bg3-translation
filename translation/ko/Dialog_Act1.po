msgctxt "h8a09ced4g9bbag4696g8754g84a00450378f"
msgid "I need new pockets to pick."
msgstr "어디 털 만한 사람 새로 없나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_RobberKidTheft
#. Speaker = Meli
#. NodeID = 0420734b-b089-79da-ce21-140b056b1cbe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_RobberKidTheft:0420734b-b089-79da-ce21-140b056b1cbe
msgctxt "h7eb71ee0gcbe7g4503ga885gef275405df62"
msgid "Heh."
msgstr "헤헤."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee1Responses
#. Speaker = Umi
#. NodeID = 0b6cf7a4-009b-49bc-d924-01ade1083a00
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Trainer_State_Phase3 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee1Responses:0b6cf7a4-009b-49bc-d924-01ade1083a00
msgctxt "hd2f491b0g6584g449fgbce7g32d9f17ec633"
msgid "What should I bite, sir?"
msgstr "어딜 공격해야 하죠, 선생님?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee1Responses
#. Speaker = Asharak
#. NodeID = 109f5cc5-54f1-443b-3cf6-c4955a53eed8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee1Responses:109f5cc5-54f1-443b-3cf6-c4955a53eed8
msgctxt "h32cfe4b0gd779g4319gacb4gf0c02904d24d"
msgid "I'll see if we can find you a dagger, child."
msgstr "그럼 단검이 있는지 찾아봐 주마, 얘야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee1Responses
#. Speaker = Umi
#. NodeID = 4013d97d-f502-4b2f-fe8e-8b31b63ef63c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Trainer_State_Phase2 = True
#.   Object:
#.      - DEN_Thieflings_Event_HasOtherKid(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee1Responses:4013d97d-f502-4b2f-fe8e-8b31b63ef63c
msgctxt "h45e92451ge54eg4ccfga0b9g5156e3374036"
msgid "Yah!"
msgstr "이얏!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee1Responses
#. Speaker = Asharak
#. NodeID = 41083dff-cc87-6eed-c4e9-3f943f2444fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee1Responses:41083dff-cc87-6eed-c4e9-3f943f2444fc
msgctxt "h4220f508g954fg44f9ga249g35878b2d1482"
msgid "Throat if you can. Wrist if you can't."
msgstr "되도록 목을 노리렴. 못 하면 손목을 노리고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee1Responses
#. Speaker = Umi
#. NodeID = 5e544625-893b-a9b3-39b5-f0c9768b66e9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Trainer_State_Phase2 = True
#.   Object:
#.      - DEN_Thieflings_Event_HasOtherKid(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee1Responses:5e544625-893b-a9b3-39b5-f0c9768b66e9
msgctxt "hdb1cb3d5gda45g4176ga406g00979cac7cd1"
msgid "Can I have a smaller sword? This one's heavy."
msgstr "더 작은 검은 없어요? 이건 무거워요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee1Responses
#. Speaker = Asharak
#. NodeID = 6520721a-844b-5de3-34b3-2d2d99bd1c96
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee1Responses:6520721a-844b-5de3-34b3-2d2d99bd1c96
msgctxt "h913551b1g2f58g42abgaf94g4036d3db23c3"
msgid "Hobgoblins? Maybe."
msgstr "홉고블린? 그럴 수 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee1Responses
#. Speaker = Umi
#. NodeID = 7a0ceddf-4c66-d961-4efd-0ad44debe8e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee1Responses:7a0ceddf-4c66-d961-4efd-0ad44debe8e6
msgctxt "hab716c0bg5845g4120g848dgb3cb61a0b76c"
msgid "Oh. Are those worse than hogboglins?"
msgstr "오. 홉고블린이 혹보글린보다 쎈 거예요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee1Responses
#. Speaker = Umi
#. NodeID = dc4f93eb-7bbe-5808-78cd-2032fa09a4cc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee1Responses:dc4f93eb-7bbe-5808-78cd-2032fa09a4cc
msgctxt "h400a37cagf2cfg4d06gb4e9g73bd7bcbf46c"
msgid "Okay."
msgstr "네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee1Responses
#. Speaker = Umi
#. NodeID = ea1c89ee-467d-128b-0469-ac496a06ec8e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee1Responses:ea1c89ee-467d-128b-0469-ac496a06ec8e
msgctxt "hca79d2f3g6af0g4423g8568ge702859d589f"
msgid "Sir? Are we gonna have to fight hogboglins?"
msgstr "선생님? 혹보글린이랑도 싸우게 될까요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee2Responses
#. Speaker = Ide
#. NodeID = 0cbbaf09-0c9a-b82e-f20e-c1a9596f1828
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee2Responses:0cbbaf09-0c9a-b82e-f20e-c1a9596f1828
msgctxt "hfb629bf6g8420g4b2cgb43ag5fdbb74e18c8"
msgid "Do we get to wear armour too?"
msgstr "저희도 갑옷 입게 되나요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee2Responses
#. Speaker = Asharak
#. NodeID = 44ee5acd-e169-ac41-27b7-d59d12e93b8f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee2Responses:44ee5acd-e169-ac41-27b7-d59d12e93b8f
msgctxt "h8c4f5d22gf903g4a89g9a1cge2a25d364678"
msgid "No. We have nothing that would fit you."
msgstr "아니. 너희한테 맞는 갑옷이 없단다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee2Responses
#. Speaker = Ide
#. NodeID = 9806c0d1-d244-b0ce-a419-91d7b17917f3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Trainer_State_Phase3 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee2Responses:9806c0d1-d244-b0ce-a419-91d7b17917f3
msgctxt "h96f786b0gb779g4cf1g82d5g3406376eb85d"
msgid "<i>Yuck</i>."
msgstr "<i>우웩</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee2Responses
#. Speaker = Asharak
#. NodeID = a87906c3-012f-9e4e-438f-9ef549902b0b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee2Responses:a87906c3-012f-9e4e-438f-9ef549902b0b
msgctxt "hb152e233gd421g465fg81b4gffabf7a31f59"
msgid "What's yuck about it?"
msgstr "뭐가 그리 우웩이니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee2Responses
#. Speaker = Asharak
#. NodeID = abbe443b-cb9f-fc54-f84c-e17e0a802b4e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee2Responses:abbe443b-cb9f-fc54-f84c-e17e0a802b4e
msgctxt "hef1536f4g8d25g4082g9bb1g39514a870262"
msgid "Almost. Turn your wrist out a little. <i>There</i>."
msgstr "좀만 더. 손목을 조금 더 꺾는 거야. <i>그렇지</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee2Responses
#. Speaker = Ide
#. NodeID = ae7336d4-a193-07c9-eaab-cb32b80f1d0d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Trainer_State_Phase2 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee2Responses:ae7336d4-a193-07c9-eaab-cb32b80f1d0d
msgctxt "hf72cfc66g3882g472agb4c2gb656bd28e980"
msgid "Like this?"
msgstr "이렇게요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee2Responses
#. Speaker = Ide
#. NodeID = afee7800-ccad-1cb3-9947-abf39de2496f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee2Responses:afee7800-ccad-1cb3-9947-abf39de2496f
msgctxt "h33761b3ag47f1g48f5gbd2fg98cd9b1ae706"
msgid "All of it, sir."
msgstr "전부 다요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee2Responses
#. Speaker = Ide
#. NodeID = b80058fc-a5e4-d569-a6b9-d57389cd7d42
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee2Responses:b80058fc-a5e4-d569-a6b9-d57389cd7d42
msgctxt "h6dc3ce13gbed7g48c6g966fg8e07c4e7a0bd"
msgid "Aw."
msgstr "에이."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee3Responses
#. Speaker = Gan
#. NodeID = 021400bb-ecd1-f461-3439-63d6f6ef9d0d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee3Responses:021400bb-ecd1-f461-3439-63d6f6ef9d0d
msgctxt "h65614ec1gd52cg4906g8b88g0952d0f21172"
msgid "<i>Goblinbane.</i>"
msgstr "<i>고블린파멸.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee3Responses
#. Speaker = Ide
#. NodeID = 135c89fe-6162-a970-c831-aa9b637fd9c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee3Responses:135c89fe-6162-a970-c831-aa9b637fd9c9
msgctxt "hef810241g2369g4ed8ga063g1d6f703f40ca"
msgid "I'm going to kill six hundred."
msgstr "난 육백 놈 정도 없앨 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee3Responses
#. Speaker = Gan
#. NodeID = 25a85662-b7f7-9958-34fa-6aeeb7f1cdde
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Trainer_State_Phase2 = True
#.   Object:
#.      - DEN_Thieflings_Event_HasOtherKid(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee3Responses:25a85662-b7f7-9958-34fa-6aeeb7f1cdde
msgctxt "h4947efb6gc96ag4af9g8640g5c45e0f22f53"
msgid "Ahah!"
msgstr "이얍!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee3Responses
#. Speaker = Gan
#. NodeID = 376b7542-82dc-57d7-a8a8-f994702a1546
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Trainer_State_Phase2 = True
#.   Object:
#.      - DEN_Thieflings_Event_HasOtherKid(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee3Responses:376b7542-82dc-57d7-a8a8-f994702a1546
msgctxt "h01889833g3961g4c55ga78egf69af0e046d7"
msgid "I'm going to kill so many goblins."
msgstr "고블린 놈들 잔뜩 죽일 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee3Responses
#. Speaker = Gan
#. NodeID = 3adbc470-bb19-6a59-bf86-cb3b8377bef3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Thieflings_Event_HasOtherKid(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee3Responses:3adbc470-bb19-6a59-bf86-cb3b8377bef3
msgctxt "h32563932g0471g4e07g9f50g7ed44015f923"
msgid "Rrrargh!"
msgstr "으아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee3Responses
#. Speaker = Gan
#. NodeID = 3eacdcdc-dcfe-3dad-9ce6-eaf4ce202392
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee3Responses:3eacdcdc-dcfe-3dad-9ce6-eaf4ce202392
msgctxt "h7386956cgf3d7g4120g8fbdge10efcd21998"
msgid "Like six."
msgstr "한, 여섯쯤."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee3Responses
#. Speaker = Gan
#. NodeID = 4de4d200-a194-91f1-4468-e8dbf71d7803
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Thieflings_Event_HasOtherKid(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee3Responses:4de4d200-a194-91f1-4468-e8dbf71d7803
msgctxt "hfbb8471cg55eag43a4ga24fgfd03f9666725"
msgid "Can I name my sword?"
msgstr "제 칼에 이름 붙여도 돼요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee3Responses
#. Speaker = Asharak
#. NodeID = 5c843d5b-d69b-f0d2-7c0c-9a5b959b29ab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee3Responses:5c843d5b-d69b-f0d2-7c0c-9a5b959b29ab
msgctxt "h2745d912g4dc3g4963g87d0g1946aeacaa9a"
msgid "Children."
msgstr "얘들아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee3Responses
#. Speaker = Asharak
#. NodeID = 6430a2ae-cb55-5cc9-5684-3140d35cce1d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee3Responses:6430a2ae-cb55-5cc9-5684-3140d35cce1d
msgctxt "h4619ad9dg4de0g4bfcg8cf7gd85b7002544e"
msgid "Go right ahead."
msgstr "좋을 대로 하렴."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee3Responses
#. Speaker = Asharak
#. NodeID = 7e54ea6c-4d7b-3d1d-6906-d053885fa220
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee3Responses:7e54ea6c-4d7b-3d1d-6906-d053885fa220
msgctxt "h279e446eg3345g4636gad31gd25f39f24e14"
msgid "Focus, children."
msgstr "집중해라, 얘들아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee3Responses
#. Speaker = Ide
#. NodeID = 8043e1ac-77d6-e642-d14f-7afb3a32eac0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee3Responses:8043e1ac-77d6-e642-d14f-7afb3a32eac0
msgctxt "hb556cca8g8899g4afbg902dg40a4b082b369"
msgid "That's my sword's name!"
msgstr "그건 내 검 이름이잖아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee3Responses
#. Speaker = Gan
#. NodeID = 9555fe92-c3d5-7ab3-9581-870b41184a03
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Trainer_State_Phase3 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee3Responses:9555fe92-c3d5-7ab3-9581-870b41184a03
msgctxt "h55e2e42fg7d81g4e71g9ddeg00785326029e"
msgid "What about my tail?"
msgstr "제 꼬리는 어떻게 해요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee3Responses
#. Speaker = Asharak
#. NodeID = b29fbc4b-60bb-239a-66fc-9ac8a102de30
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee3Responses:b29fbc4b-60bb-239a-66fc-9ac8a102de30
msgctxt "hbfd8df9dgc44ag4e77gbb00gd9eef6c309c9"
msgid "Use that too. Your entire body is a weapon."
msgstr "그것도 쓰렴. 네 몸 전체를 무기로 삼는 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee3Responses
#. Speaker = Ide
#. NodeID = d7ea69b0-c783-6b44-d0c5-41da46ae2043
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee3Responses:d7ea69b0-c783-6b44-d0c5-41da46ae2043
msgctxt "h73501ab7g664eg4a91ga300g27dbbd59fd5e"
msgid "How many?"
msgstr "얼마나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee3Responses
#. Speaker = Gan
#. NodeID = f1ce44db-54d5-341e-e9e4-24aa96303a06
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trainee3Responses:f1ce44db-54d5-341e-e9e4-24aa96303a06
msgctxt "he7f70dcege46eg4d4fg98e1gae710490aa76"
msgid "Wicked."
msgstr "죽인다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_TrainerLessons
#. Speaker = Asharak
#. NodeID = 0738c1b9-b310-06eb-6b3c-b3c756479022
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Trainer_Event_HasKidAnswer = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_TrainerLessons:0738c1b9-b310-06eb-6b3c-b3c756479022
msgctxt "ha55d2e8fgcac4g49f7g90b0gec29e871b679"
msgid "Any questions, children?"
msgstr "질문 있니, 얘들아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_TrainerLessons
#. Speaker = Asharak
#. NodeID = 1b5b555b-6849-1b40-c76a-2c16ed54fa5b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Trainer_Event_HasKidAnswer = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_TrainerLessons:1b5b555b-6849-1b40-c76a-2c16ed54fa5b
msgctxt "h821b530dgb3e8g4580gbe83g328c6dede36a"
msgid "No questions? All right."
msgstr "질문 없어? 좋아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_TrainerLessons
#. Speaker = Asharak
#. NodeID = 53438108-a93d-c525-6a9a-de5a19823aa7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Trainer_Event_HasKidAnswer = True
#.      - DEN_Trainer_State_Phase3 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_TrainerLessons:53438108-a93d-c525-6a9a-de5a19823aa7
msgctxt "hb2c94993gf409g4b85gb7f2g2d84023961fa"
msgid "Remember: you have teeth and claws! Use them."
msgstr "기억해: 이빨과 손톱도 무기가 될 수 있단다! 잘 활용해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_TrainerLessons
#. Speaker = Asharak
#. NodeID = b4d0cb97-a169-5cad-6736-db3213515511
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Trainer_Event_HasKidAnswer = False
#.      - DEN_Trainer_State_Phase3 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_TrainerLessons:b4d0cb97-a169-5cad-6736-db3213515511
msgctxt "h4f98a8afg006dg4452gb8e7g488614ba725b"
msgid "Don't fight fair. Fight to live."
msgstr "공정하게 싸울 생각은 하지 마. 살기 위해 싸우는 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_TrainerLessons
#. Speaker = Asharak
#. NodeID = c9a20d72-28ce-fc75-a2e0-e7ddd499dcb6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Trainer_Event_HasKidAnswer = True
#.      - DEN_Trainer_State_Phase2 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_TrainerLessons:c9a20d72-28ce-fc75-a2e0-e7ddd499dcb6
msgctxt "heca3a96cg8da1g4eb7g8d1fg725d36eaa643"
msgid "Keep your blades up, children."
msgstr "칼날은 항상 위로 유지해, 얘들아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_TrainerLessons
#. Speaker = Asharak
#. NodeID = da6d566c-7505-1d19-7483-19c53cdd210e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Trainer_State_TraineesAreScared = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_TrainerLessons:da6d566c-7505-1d19-7483-19c53cdd210e
msgctxt "he12d0f9eg8b6dg407dg9f40g395ac779c8b8"
msgid "It's all right, children. They didn't mean it."
msgstr "괜찮아, 얘들아. 일부러 한 건 아닐 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_TrainerLessons
#. Speaker = Asharak
#. NodeID = da6d566c-7505-1d19-7483-19c53cdd210e
#. HandlePath = TaggedText[0].TagText[1]
#. CheckFlags:
#.   Global:
#.      - DEN_Trainer_State_TraineesAreScared = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_TrainerLessons:da6d566c-7505-1d19-7483-19c53cdd210e
msgctxt "h91670cf7ge0d7g424egbe9cge5decfd9a141"
msgid "We have training to do. Come on."
msgstr "훈련을 해야지. 가자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_TrainerLessons
#. Speaker = Asharak
#. NodeID = da6d566c-7505-1d19-7483-19c53cdd210e
#. HandlePath = TaggedText[0].TagText[2]
#. CheckFlags:
#.   Global:
#.      - DEN_Trainer_State_TraineesAreScared = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_TrainerLessons:da6d566c-7505-1d19-7483-19c53cdd210e
msgctxt "hcd62d836g72bdg47b5g9315gdde4f0bf81e0"
msgid "Am I supposed to hug you, or..."
msgstr "널 안아줘야 하는 거야, 아님..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_TrainerLessons
#. Speaker = Asharak
#. NodeID = f175a549-220f-d087-5ffb-d9f33ba83060
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Trainer_Event_HasKidAnswer = False
#.      - DEN_Trainer_State_Phase2 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_TrainerLessons:f175a549-220f-d087-5ffb-d9f33ba83060
msgctxt "h12319ca6geb3fg4579g882dg60595043edd2"
msgid "Keep your feet planted."
msgstr "항상 중심을 잡아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trespassing
#. Speaker = Mattis
#. NodeID = 21a1de61-de53-f430-73ce-f1a5b65ea333
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trespassing:21a1de61-de53-f430-73ce-f1a5b65ea333
msgctxt "h03898956ga52dg4854ga0cdg38a4f7bad947"
msgid "Mol! We've got trouble!"
msgstr "몰! 문제가 생겼어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trespassing
#. Speaker = Mattis
#. NodeID = 21a1de61-de53-f430-73ce-f1a5b65ea333
#. HandlePath = TaggedText[0].TagText[1]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trespassing:21a1de61-de53-f430-73ce-f1a5b65ea333
msgctxt "hdc75154fgc5dbg431bg84b6g7f820cf97068"
msgid "You're not supposed to be here!"
msgstr "여기 계시면 안 돼요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trespassing
#. Speaker = Mattis
#. NodeID = 21a1de61-de53-f430-73ce-f1a5b65ea333
#. HandlePath = TaggedText[0].TagText[2]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_Trespassing:21a1de61-de53-f430-73ce-f1a5b65ea333
msgctxt "h32aec7f5g2516g41ceg9fecg8712c79e4772"
msgid "You can't be here! This is our hideout!"
msgstr "여기 있으면 안 돼요! 여긴 우리 은신처란 말이에요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo
#. Speaker = Player
#. NodeID = 11f2fc78-acda-1dc9-d9c1-5774d141b9fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo:11f2fc78-acda-1dc9-d9c1-5774d141b9fe
msgctxt "h767717cdg90c5g4765gb709g476944f35841"
msgid "<i>Keep staring.</i>"
msgstr "<i>계속 쳐다본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo
#. Speaker = Player
#. NodeID = 16dbf4c5-85c9-9367-76b3-f0f049b612fb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo:16dbf4c5-85c9-9367-76b3-f0f049b612fb
msgctxt "h26faf7c1gb26bg4f99g8730g264043efd73c"
msgid "<i>Stare at his forehead.</i>"
msgstr "<i>녀석의 마빡을 빤히 쳐다본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo
#. Speaker = Meli
#. NodeID = 17e32bf0-227c-3fc9-a245-f0bc3afabe7d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo:17e32bf0-227c-3fc9-a245-f0bc3afabe7d
msgctxt "h34916b96g875bg404fgbe4bg1de6944518ca"
msgid ""
"I'm not saying I didn't have that whole amulet situation under control, "
"but..."
msgstr "내가 그 아뮬렛 일 알아서 해결 못 봤을 거라고 여기는 건 아니지만..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo
#. Speaker = Meli
#. NodeID = 229c128a-94c6-9fee-22a1-ab8809988c65
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_State_AfterRobberKidConfront = True
#.   Object:
#.      - DEN_Thieflings_State_WitnessedArgument(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo:229c128a-94c6-9fee-22a1-ab8809988c65
msgctxt "hbd72ab44g053eg44b4g8786g80507a67aeca"
msgid "I hope I don't look as old as you when I'm your age."
msgstr "내가 그쪽 나이 되면 댁만큼 삭아 보이진 않았으면 좋겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo
#. Speaker = Meli
#. NodeID = 340e51cf-7d64-fa9a-c154-bf301764635d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AdventurerRobber_HasMet(1) = False
#.   Global:
#.      - DEN_Thieflings_State_AfterRobberKidConfront = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AdventurerRobber_HasMet(1) = True
#. TagRule: DUERGARDWARF or DWARF or SHORT
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo:340e51cf-7d64-fa9a-c154-bf301764635d
msgctxt "hb5745da5g0f80g48bbgbfdeg2aaedd6ef410"
msgid "Kind of short for an adult, aren't you?"
msgstr "어른치고는 키가 좀 작은 양반인걸?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo
#. Speaker = Meli
#. NodeID = 340e51cf-7d64-fa9a-c154-bf301764635d
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AdventurerRobber_HasMet(1) = False
#.   Global:
#.      - DEN_Thieflings_State_AfterRobberKidConfront = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AdventurerRobber_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo:340e51cf-7d64-fa9a-c154-bf301764635d
msgctxt "h0f0f2165g2aa6g433cg9ad6gb5fff9d3b8b1"
msgid "You're blocking my light."
msgstr "댁 때문에 볕이 가려지잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo
#. Speaker = Meli
#. NodeID = 3c350579-9af9-e524-ccd1-23adce0576a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo:3c350579-9af9-e524-ccd1-23adce0576a7
msgctxt "h6c94acb0g1b1ag44bag8451g720c2c0b087f"
msgid "You want something? Or you just here to stare at my forehead?"
msgstr "뭔 볼일 있어? 아니면 그냥 내 마빡이나 쳐다보러 온 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo
#. Speaker = Meli
#. NodeID = 3c6c0845-0234-2de1-c886-09269a1998f6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo:3c6c0845-0234-2de1-c886-09269a1998f6
msgctxt "h5951ee94g94e8g40c1gb530ga855c029e70e"
msgid "Your approval means bunches to me, complete stranger."
msgstr "쌩판 모르는 남한테 칭찬을 받다니 아주 감격에 겨워 죽겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo
#. Speaker = Player
#. NodeID = 3d64ca5e-845a-64e3-217e-59b2d7621e58
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_KidGotAway = False
#.      - DEN_Thieflings_Event_ItemReturned = True
#.      - GLO_Thieflings_State_PickpocketKidGotHit = False
#.   Object:
#.      - DEN_Thieflings_State_WitnessedArgument(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo:3d64ca5e-845a-64e3-217e-59b2d7621e58
msgctxt "h9a04d926g665bg492aga0b3g253ddb8149b3"
msgid "You did the right thing before - returning that locket."
msgstr "네가 그때 로켓을 돌려준 건 옳은 일을 한 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo
#. Speaker = Meli
#. NodeID = 41d28428-278c-24b5-f360-3e8b427083ce
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_PlayerNotInvolved = True
#.      - DEN_Thieflings_Event_ItemReturned = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo:41d28428-278c-24b5-f360-3e8b427083ce
msgctxt "ha2f16fd9g6002g4b30gaab1g31c332ffd1d1"
msgid ""
"Oh, I remember you. You're the one who made me return the ugly human's "
"jewellery."
msgstr "아, 어디서 봤나 했더니. 그 못생긴 인간한테 쌔빈 장신구 도로 뱉게 만든 작자네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo
#. Speaker = Player
#. NodeID = 498b6f19-8f0f-56c8-9cc9-3c5d337ca066
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AdventurerRobber_PCAskedAboutLocket(1) = True
#.   Global:
#.      - DEN_Thieflings_Event_ItemReturned = False
#.   Object:
#.      - DEN_Thieflings_State_WitnessedArgument(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo:498b6f19-8f0f-56c8-9cc9-3c5d337ca066
msgctxt "hfc1f1755gb02bg46bcgab51g9744ed1b4826"
msgid "I'm here for the locket. Where is it?"
msgstr "로켓을 찾으러 왔어. 어디에 뒀냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo
#. Speaker = Meli
#. NodeID = 55a3011e-31ea-6e81-a30d-fe695ed693c5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AdventurerRobber_PreAdventurerHasMet(1) = False
#.   Global:
#.      - DEN_Thieflings_State_AfterRobberKidConfront = False
#. SetFlags:
#.   Dialog:
#.     - DEN_AdventurerRobber_PreAdventurerHasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo:55a3011e-31ea-6e81-a30d-fe695ed693c5
msgctxt "h56130d87ga0c3g4af6g8434gdefc500efd9e"
msgid "I'm waiting on someone, and you aren't him. Do you mind?"
msgstr "내가 누구 기다리는데 그게 댁은 아니거든? 그만 가 줄래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo
#. Speaker = Meli
#. NodeID = 60e33392-71f7-f32a-0ad8-27e5b8a2b48b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AdventurerRobber_HasMet(1) = False
#.   Global:
#.      - DEN_Thieflings_State_AfterRobberKidConfront = True
#.   Object:
#.      - DEN_Thieflings_State_WitnessedArgument(1) = False
#.      - DEN_Thieflings_State_AtHideoutPoint(0) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AdventurerRobber_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo:60e33392-71f7-f32a-0ad8-27e5b8a2b48b
msgctxt "h2af47e84g57d7g4ac8ga4dfg0aff099a44ae"
msgid "You're the first grown-up who's ever gotten in here. Not bad."
msgstr "여기까지 들어 온 어른은 지금껏 댁이 처음이야. 제법인걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo
#. Speaker = Meli
#. NodeID = 69dd1046-b6fa-eb5a-8259-d8f6c48dee86
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo:69dd1046-b6fa-eb5a-8259-d8f6c48dee86
msgctxt "h0bcf6782g07afg4f77ga53eg34910085d0c1"
msgid "Now, find yourself a maze and get lost. I'm busy."
msgstr "이만 어디로든 알아서 헤메시고, 좀 꺼져 줘. 난 바쁘니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo
#. Speaker = Meli
#. NodeID = 6a5f55cb-0627-a693-62fa-b4e26f1f5c53
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo:6a5f55cb-0627-a693-62fa-b4e26f1f5c53
msgctxt "h83de7069gdd0dg4d0dgbe1ag377dc4c0bb90"
msgid "This entire conversation is a waste of our time, don't you think?"
msgstr "이런 하나마나한 대화는 피차 시간낭비일 뿐이라고. 그렇지 않아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo
#. Speaker = Meli
#. NodeID = 7b202efc-a0a1-9fa2-6bf9-d064e2186701
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo:7b202efc-a0a1-9fa2-6bf9-d064e2186701
msgctxt "hcc1c1c7agad6eg4cadgb0f7g0b7c373b0999"
msgid "Aw, go tell my parents. Wait, you can't. They're dead."
msgstr "저런, 그럼 내 부모한테 따지셔. 아 참, 그건 못하겠네. 이미 죽었으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo
#. Speaker = Meli
#. NodeID = 83ab8c89-cb6a-3ffd-d383-cf1ffa45bf53
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_State_SecondStageDone = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo:83ab8c89-cb6a-3ffd-d383-cf1ffa45bf53
msgctxt "h8f059016g9b52g4a66gb0e7gf9bb4a1321f1"
msgid "Oh, I remember you. You're the one who got me in trouble with Ikaron."
msgstr "아, 어디서 봤나 했더니. 날 이카론한테 혼나게 만든 그 작자네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo
#. Speaker = Player
#. NodeID = 85d867f1-f11f-6af6-fc87-1b31c7db9be6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_PCEmbarassedPickpocketingKid = False
#.      - DEN_Thieflings_State_PCBroughtUpPickpocketingKidsMum = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo:85d867f1-f11f-6af6-fc87-1b31c7db9be6
msgctxt "h4940fd9bg3c82g4112ga8aeg5f2d4f454cb2"
msgid "You need to learn some manners, I think."
msgstr "넌 그 버르장머리 좀 고쳐야겠다 싶다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo
#. Speaker = Player
#. NodeID = 8e76f0c7-0705-93d3-f98e-32b27b68b06e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_ItemReturned = False
#.   Object:
#.      - DEN_Thieflings_State_WitnessedArgument(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AdventurerRobber_PCAskedAboutLocket(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo:8e76f0c7-0705-93d3-f98e-32b27b68b06e
msgctxt "h0a3c9f78g66fag4680gb0e4g8520a16fa048"
msgid "Tell me the truth. That adventurer's locket - do you have it?"
msgstr "사실대로 얘기해 봐. 그 모험가의 로켓, 네가 갖고 있지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo
#. Speaker = Meli
#. NodeID = 8e8c55d5-a0a5-a6b8-1dc8-87e6beb745d7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo:8e8c55d5-a0a5-a6b8-1dc8-87e6beb745d7
msgctxt "hb95dd3c0g94eag415cg8bbbg915fb291ca55"
msgid "Yeah, okay, fine. Very funny. What do you want?"
msgstr "아이고, 그래. 거 참 웃기네. 뭔 볼일이냐고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo
#. Speaker = Meli
#. NodeID = a0f58023-e209-3693-6cd8-e64dbb428df4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo:a0f58023-e209-3693-6cd8-e64dbb428df4
msgctxt "h672f6020g1e4eg4f3eg9606g251dcdc7b68c"
msgid "Look, if I had it, would I tell you?"
msgstr "내가 갖고 있다 쳐도, 그걸 인정하겠냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo
#. Speaker = Meli
#. NodeID = a6a58b4b-5a3f-9007-a191-2c82b371434e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AdventurerRobber_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo:a6a58b4b-5a3f-9007-a191-2c82b371434e
msgctxt "h70ee2205geb77g41f9gb408gcf193588e123"
msgid "I thought I told you to get lost?"
msgstr "그만 꺼지라고 내가 말했을 텐데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo
#. Speaker = Meli
#. NodeID = a94d7521-847f-7d25-160d-e30e69c5f3c3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo:a94d7521-847f-7d25-160d-e30e69c5f3c3
msgctxt "h3ba1b5e2g3820g4711gbc4fgdccd53739699"
msgid ""
"I didn't think I'd get to keep the damn thing. So... thanks. Thanks a lot."
msgstr "그 망할 걸 간수할 수 있을 거라곤 생각 못했거든. 그러니... 고마워. 진짜로."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo
#. Speaker = Meli
#. NodeID = d3dc5ed1-c460-933b-e71d-33b2a3aaf96a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_KidGotAway = True
#.   Object:
#.      - DEN_Thieflings_State_WitnessedArgument(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo:d3dc5ed1-c460-933b-e71d-33b2a3aaf96a
msgctxt "hf1072d7ag26deg44a5g87e7g6c0dda83ba87"
msgid "Oh, I remember you. You're the one who helped me get away."
msgstr "아, 어디서 봤나 했더니. 내가 벗어나는 거 도와준 그분이시네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo
#. Speaker = Meli
#. NodeID = dde514ee-1168-1b63-30ee-e56448048cf7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Thieflings_State_PickpocketKidGotHit = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo:dde514ee-1168-1b63-30ee-e56448048cf7
msgctxt "h19c6c651g6461g4388g929cg189acd96f8a4"
msgid "Oh, I remember you. You're the one who let the ugly human hit me."
msgstr "아, 어디서 봤나 했더니. 그 못생긴 인간이 나 패는 거 냅둔 그 작자네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo
#. Speaker = Meli
#. NodeID = def96f5c-fec8-f186-c8fc-47fb254ca412
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Hideout_Event_BefriendedThieflings = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo:def96f5c-fec8-f186-c8fc-47fb254ca412
msgctxt "h168417d1g4de8g4139g99deg0349f7efe888"
msgid "Mol says you're all right. Doesn't mean I gotta talk to you."
msgstr "몰이 댁은 괜찮다고 하더라. 그렇다고 말 섞을 생각은 없지만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo
#. Speaker = Meli
#. NodeID = e8401528-d07d-4af3-3528-ffcf469cc278
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AdventurerRobber_HasMet(1) = True
#.   Global:
#.      - DEN_Thieflings_Knows_MeliTalkedAboutHisMother = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo:e8401528-d07d-4af3-3528-ffcf469cc278
msgctxt "h3883777bg51e8g403cg8bdege279de0aba86"
msgid "Keep out of trouble, hey? One of us should."
msgstr "괜히 말썽 피우지 말자고. 우리 중 하나라도 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo
#. Speaker = Meli
#. NodeID = edbeb67f-29d4-d933-76f4-268bf7037f46
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AdventurerRobber_PreAdventurerHasMet(1) = True
#.   Global:
#.      - DEN_Thieflings_State_AfterRobberKidConfront = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo:edbeb67f-29d4-d933-76f4-268bf7037f46
msgctxt "h4a5b3963g1c27g4cfeg99d5g7693c95e7c2a"
msgid "Look, you seem nice and all, but take a hint, huh?"
msgstr "저기, 생긴 건 멀쩡한 양반이 왤케 눈치 없게 굴어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo
#. Speaker = Meli
#. NodeID = ee09e8f0-5a43-b523-65e5-d4fbb7e3033e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo:ee09e8f0-5a43-b523-65e5-d4fbb7e3033e
msgctxt "h67179f55g3fd7g45ffg805bg86fe36d6e38b"
msgid "Nowhere you'd ever look. Go away."
msgstr "댁이 절대 못 찾을 곳에 있지. 저리 꺼져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo
#. Speaker = Player
#. NodeID = f37bb559-4ed0-689b-3eda-c0915e488eae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo:f37bb559-4ed0-689b-3eda-c0915e488eae
msgctxt "hf0d04963g939eg4a27gb0bag6f81a13844c6"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo
#. Speaker = Meli
#. NodeID = fdaa5669-55fa-569f-8bcf-12b079855a62
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AdventurerRobber_HasMet(1) = False
#.   Global:
#.      - DEN_Thieflings_Knows_MeliTalkedAboutHisMother = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AdventurerRobber_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo:fdaa5669-55fa-569f-8bcf-12b079855a62
msgctxt "hef2e2a49g5330g4ac7g88d1gafce434c8949"
msgid "Hey, uh, listen."
msgstr "저기, 그... 있잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo
#. Speaker = Meli
#. NodeID = fdd4dd10-2139-c8a9-fdd8-1fc2bba5dded
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_HideoutCallForHelp = True
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo:fdd4dd10-2139-c8a9-fdd8-1fc2bba5dded
msgctxt "ha9fba258g1826g4be4g90b0g1d9ac070db5b"
msgid "Mol says you're dead to us. Go away, dead girl."
msgstr "몰이 댁 뒈졌다고 취급하라더라. 저리 꺼져, 뒈진 년아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo
#. Speaker = Meli
#. NodeID = fdd4dd10-2139-c8a9-fdd8-1fc2bba5dded
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_HideoutCallForHelp = True
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo:fdd4dd10-2139-c8a9-fdd8-1fc2bba5dded
msgctxt "hee464b8cg3764g4726gac51gedb4c36da876"
msgid "Mol says you're dead to us. Go away, dead boy."
msgstr "몰이 댁 뒈졌다고 취급하라더라. 저리 꺼져, 뒈진 놈아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo
#. Speaker = Meli
#. NodeID = fdd4dd10-2139-c8a9-fdd8-1fc2bba5dded
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_HideoutCallForHelp = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AdventurerRobber_Solo:fdd4dd10-2139-c8a9-fdd8-1fc2bba5dded
msgctxt "h376601a2gc5c1g4a5eg9927gd4e3685fb56f"
msgid "Mol says you're dead to us. Go away."
msgstr "몰이 댁 뒈졌다고 취급하라더라. 저리 꺼져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Player
#. NodeID = 0409d2e6-5c0a-e2d8-71ac-60b71ff81635
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TIEFLING(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:0409d2e6-5c0a-e2d8-71ac-60b71ff81635
msgctxt "h63f6eb4fg9166g4bdfg80feg3a6b57ccdb8c"
msgid ""
"I see. Your blessed mum was providing for her family, but the young tiefling "
"is a thieving devil."
msgstr "그렇군. 네 어머니는 가족 부양하느라 그런 천사같은 분이지만, 그 티플링 꼬마는 도둑질쟁이 데빌이다 이거냐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = 06fdedd0-a7eb-4c9c-8503-305ce6d6c1ef
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:06fdedd0-a7eb-4c9c-8503-305ce6d6c1ef
msgctxt "h7372ee31g8b4bg4eb8ga440g59b764387412"
msgid "Ugh. Get your head outta my head!"
msgstr "으윽, 내 머리 속에서 당장 나가!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = 0954a018-d6eb-29a3-3525-1f87c8b8386b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:0954a018-d6eb-29a3-3525-1f87c8b8386b
msgctxt "ha623d03agf477g4dd5g8f54gfd6cde891599"
msgid ""
"Don't blame you for trying, but I gotta eat. Give me the amulet, I pay you "
"fair, and we're square."
msgstr "욕심은 이해하는데, 나도 먹고 살아야지. 아뮬렛 넘기면 알아서 값 좋게 쳐 줄 거고, 그걸로 땡이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = 0c3ec9a7-182f-7ff0-c9f4-75eb2a808c48
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:0c3ec9a7-182f-7ff0-c9f4-75eb2a808c48
msgctxt "hbe7aea97ga2a8g43c8gbabegafc112c02438"
msgid "Not long, matter of fact."
msgstr "사실 그리 옛날 건 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = 0c4087e9-694b-2085-f1d2-b59fb61f8bfb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_CheckPocketGold_2 = True
#. SetFlags:
#.   Object:
#.     - GEN_TransferNPCPayment_2(0) = True
#.   Quest:
#.     - DEN_RobbedAdventurer.ReturnedLocketReward(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:0c4087e9-694b-2085-f1d2-b59fb61f8bfb
msgctxt "h132a0767g3471g43abg90b1ge417fb29dee5"
msgid "And here's your reward. We're square now. Get lost."
msgstr "여기 네 보상이다. 이제 빚은 없는 거야. 이만 사라져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = 0cabf474-d9b5-c577-b92d-1820d00571d5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_State_AfterRobberKidConfront = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:0cabf474-d9b5-c577-b92d-1820d00571d5
msgctxt "hbb18ebccg7a14g4f4dga697gdb6b5061fce9"
msgid ""
"Good to be back behind the walls, have to say. For as long as that lasts."
msgstr "방벽 안으로 돌아왔으니 다행이다 싶긴 하네. 얼마나 갈지는 모르겠지만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = 0d72e3d5-018f-7246-3411-56c5b854c444
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:0d72e3d5-018f-7246-3411-56c5b854c444
msgctxt "h6cab0805g285bg475dg8df6ged3153342c3b"
msgid "Bet he's learned his lesson now."
msgstr "이제는 교훈을 얻었겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Player
#. NodeID = 0f11d2a2-e8e4-7f3e-a5df-5b14b5f48d47
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:0f11d2a2-e8e4-7f3e-a5df-5b14b5f48d47
msgctxt "h0bb4f309g9394g4a80gac30gffa56bd37cb9"
msgid "Wherever it came from, at least it's something to remember her by."
msgstr "출처가 어떻든 간에, 그걸로 네 어머니를 추억할 수 있다면 된 거지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = 14d5f75e-ae96-185c-90ea-5d0408dce739
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Thieflings_State_HasStolenLocket(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:14d5f75e-ae96-185c-90ea-5d0408dce739
msgctxt "hbdd47a31gb1e8g435fgadcbg3eb36a334558"
msgid "Got nothing to say to you. You got nothing I want."
msgstr "너랑 할 얘기 없다. 내가 원하는 건 너한테 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = 16fa6cd9-3413-c8c4-b830-34cbbcfc8fc2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:16fa6cd9-3413-c8c4-b830-34cbbcfc8fc2
msgctxt "h040aefebgfce1g40efg93cdg96bee1412f0e"
msgid "Ain't the same and you know it."
msgstr "그거랑은 다르지. 너도 알잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Player
#. NodeID = 17268ff5-5af0-6f1d-5641-b52175d58cb5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Thieflings_State_HasStolenLocket(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:17268ff5-5af0-6f1d-5641-b52175d58cb5
msgctxt "hae62fd1egaf29g436eg9bf6gbbde49a52eda"
msgid "You mean <i>this</i> locket? How much is it worth to you?"
msgstr "이 <i>로켓</i>을 말하는 거야? 너한테는 이게 얼마만큼 소중하지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = 1b3df626-5833-30a4-891e-6c32f1176142
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Thieflings_State_HasStolenLocket(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:1b3df626-5833-30a4-891e-6c32f1176142
msgctxt "h03c617a5g4eefg4fccga732g4a0483e5c0bf"
msgid ""
"My mum gave me that locket on her godsdamned deathbed. The boy took the "
"thing. I know it."
msgstr "그 로켓은 우리 엄마가 임종 직전에 주신 거라고. 그 꼬맹이가 훔친 거야. 분명해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = 1c63ded0-ffb9-5eb9-504f-a20f86ac077b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:1c63ded0-ffb9-5eb9-504f-a20f86ac077b
msgctxt "he6c3832ag30fcg4ef3g9cd8gbf13648187aa"
msgid "They didn't pay her much. They owed her a perk or two."
msgstr "봉급이 쥐꼬리만한 데였어. 그 정도는 챙기실 만했다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Player
#. NodeID = 2a9db6a4-cb4c-5a8b-46ba-5aedf9ea8454
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:2a9db6a4-cb4c-5a8b-46ba-5aedf9ea8454
msgctxt "h6c359d1egc568g4adfgad2cg71edbce9052b"
msgid "You're right - I'm joking."
msgstr "맞아. 농담이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = 2ba77466-d663-3716-c086-21fdfe0d00c7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Event_AngeredAdventurer = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:2ba77466-d663-3716-c086-21fdfe0d00c7
msgctxt "h48518f13gf750g4afega091g08f1ae7467af"
msgid "Tell me you are, and this doesn't have to end in blood."
msgstr "농담이라 해. 그러면 괜히 피 볼 일 없을 테니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Player
#. NodeID = 2fb97a97-b1e6-4973-1c5e-bc0a72e11345
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#. TagRule: BERSERKER
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:2fb97a97-b1e6-4973-1c5e-bc0a72e11345
msgctxt "h10d6df2dgc579g4b9ag83c1g51b6ad33cdf0"
msgid "<b>OH, BUT IT DOES!</b>"
msgstr "<b>오, 난 봐야겠는데!</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Player
#. NodeID = 2fb97a97-b1e6-4973-1c5e-bc0a72e11345
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:2fb97a97-b1e6-4973-1c5e-bc0a72e11345
msgctxt "hae3f60adgf7d3g443cgb73ag7256b710b78f"
msgid "Blood? Sounds like a happy ending to me."
msgstr "피? 오히려 나는 그 편이 맘에 드는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Player
#. NodeID = 301f2751-75a0-41eb-ae45-6b7ecc0b5ce0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:301f2751-75a0-41eb-ae45-6b7ecc0b5ce0
msgctxt "hc466703eg59c2g489ag94ebg1f8a4133d0f5"
msgid ""
"Let me guess - it wasn't your mother's to give you in the first place, was "
"it?"
msgstr "짐작이 가는걸. 너한테 남겼다는 그거, 애초에 너희 엄마 거였던 게 아닌 모양인데. 안 그래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = 33786a41-1dd1-5dd7-89e1-d069498a4e4d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TIEFLING(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:33786a41-1dd1-5dd7-89e1-d069498a4e4d
msgctxt "h7a277540g1371g463fg9ad5gfa4628b6acd8"
msgid ""
"Kind of you to offer, but that boy ain't giving it up, not even to one of "
"his own. I'm sure of it."
msgstr "말은 고맙지만, 그 꼬맹이는 순순히 내주지 않을걸? 지 동족이 상대라도 말이지. 보나마나라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = 379e2a59-4277-3e2d-0088-653d87025921
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_State_AfterRobberKidConfront = True
#.   Object:
#.      - DEN_Thieflings_State_WitnessedArgument(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:379e2a59-4277-3e2d-0088-653d87025921
msgctxt "ha1fe71cfg62fcg4cefg8fe7g1a3a7e0e9300"
msgid "Not in the mood to talk right now. It ain't you, so leave it."
msgstr "지금은 얘기 나눌 기분 아니야. 너 때문은 아니니, 그냥 가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Player
#. NodeID = 3b503400-912f-dca6-eb54-537601679467
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:3b503400-912f-dca6-eb54-537601679467
msgctxt "h932ac1b7g95f5g4f2bga303gbc2bf0e6fef1"
msgid ""
"I think you can up your offer a little. It was a gift from your mother, "
"after all."
msgstr "조금 더 챙겨줄 수 있을 거 같은데. 네 어머니가 남긴 선물이라며."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = 3c96e98a-be60-f6ba-6330-bae0b2679b36
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_CheckPocketGold = True
#. SetFlags:
#.   Object:
#.     - GEN_TransferNPCPayment(0) = True
#.   Quest:
#.     - DEN_RobbedAdventurer.ReturnedLocketReward(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:3c96e98a-be60-f6ba-6330-bae0b2679b36
msgctxt "he4895a45g4904g4564gb34ag64f44b425422"
msgid "And here's your reward. We're square now. Get lost."
msgstr "여기 네 보상이다. 이제 빚은 없는 거야. 이만 사라져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Player
#. NodeID = 3e3e4a90-65c5-0099-65b8-a9c3e03dae4e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - DEN_RobbedAdventurer.NoLocketReturn(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:3e3e4a90-65c5-0099-65b8-a9c3e03dae4e
msgctxt "h859597dcgb67ag4214g93a0g34cf9c6ede72"
msgid "Then I guess we're going to have problems. Because I'm keeping it."
msgstr "그럼 곱게 끝나기는 글렀군. 그건 내가 챙길 거거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Player
#. NodeID = 49c2d5fc-1c14-b39c-af8c-01bf2d52ae74
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:49c2d5fc-1c14-b39c-af8c-01bf2d52ae74
msgctxt "hd7a5757dged61g4a05gb22dg0a46e938f118"
msgid "*I took my leave.*"
msgstr "*자리를 뜬다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = 4ab54415-d8d9-351f-68a0-4efb4df905f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:4ab54415-d8d9-351f-68a0-4efb4df905f4
msgctxt "hc52ed91fg2b68g4b74g944eg688e5f738e8e"
msgid "Finally."
msgstr "드디어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = 4bb74059-874f-c1a8-1616-07cc7978c17e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TIEFLING(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:4bb74059-874f-c1a8-1616-07cc7978c17e
msgctxt "h673ef940g5521g42acg9393g6a29e552062b"
msgid "Kind of you to offer, but that boy ain't giving it up. I'm sure of it."
msgstr "말은 고맙지만, 그 꼬맹이는 순순히 내주지 않을걸? 보나마나라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Player
#. NodeID = 507bf51e-f415-2112-a400-2c6fe2323d6f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:507bf51e-f415-2112-a400-2c6fe2323d6f
msgctxt "h5ee29082gc8feg4f18ga100g2a7ea018f80d"
msgid "<i>Attack him.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = 5170c8c6-b72b-ca9c-ac91-8419c185a0fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:5170c8c6-b72b-ca9c-ac91-8419c185a0fe
msgctxt "ha64abfdcga816g4b32gb3b2g31787377aeeb"
msgid "Yeah, thanks to you."
msgstr "그래, 다 네 덕분이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Player
#. NodeID = 51793626-e949-c521-768f-5e585669e8c3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Thieflings_State_HasStolenLocket(0) = True
#. TagRule: ROGUE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:51793626-e949-c521-768f-5e585669e8c3
msgctxt "hbebf4096g42b1g41b0gb8acgfca33424a5ab"
msgid ""
"Quit whining, and give me the locket. It'll save me the effort of picking "
"your pocket later."
msgstr "그만 징징거리고 그 로켓 내놔. 나중에 슬쩍하기도 귀찮으니까 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = 53869d60-996a-7881-1f9e-7ecf672dcbae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:53869d60-996a-7881-1f9e-7ecf672dcbae
msgctxt "h96f45f85g1c40g4500ga236gc7e275cdfbc0"
msgid ""
"<i>It's the last thing of mum's I have... it's worth everything to me.</i>"
msgstr "<i>그건 엄마의 유일한 유품이야... 나한테는 전부나 다름 없다고.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = 658bd4d9-dd9e-f9fa-32b5-b1a3654cb39c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Adventurer_HasMet(1) = False
#.   Global:
#.      - DEN_Thieflings_Knows_MeliTalkedAboutHisMother = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Adventurer_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:658bd4d9-dd9e-f9fa-32b5-b1a3654cb39c
msgctxt "h84f6bf23gb354g4627ga24bg403eb4fe1671"
msgid "Hey. Thanks for stepping between me and the kid."
msgstr "이봐. 그 꼬맹이 일 때 끼어들어 줘서 고마워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = 66a90dfb-5a7a-63ae-6ec0-8b9df5ede3a5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_CheckPocketGold = False
#. SetFlags:
#.   Quest:
#.     - DEN_RobbedAdventurer.ReturnedLocketFree(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:66a90dfb-5a7a-63ae-6ec0-8b9df5ede3a5
msgctxt "h92584e0ag7665g4f78gbfe1ga43c8778b61a"
msgid ""
"And it looks like someone took my money too. Got nothing to give you but my "
"thanks."
msgstr "근데 누가 내 돈도 털어간 모양인걸. 네게 감사 말고는 줄 게 없겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = 68402385-ac37-ac34-a707-c6fe100125d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:68402385-ac37-ac34-a707-c6fe100125d4
msgctxt "h24d88307g6decg45a7g841cg2156219979aa"
msgid ""
"It's gonna be hard to wear a necklace when you ain't got a neck. Give it "
"back."
msgstr "모가지가 달아나면 그 목걸이 걸어보기도 힘들 거다. 당장 내놔."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = 6f74522c-3933-0fc4-b4d5-9ff76f822a45
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:6f74522c-3933-0fc4-b4d5-9ff76f822a45
msgctxt "h1da0fc35gc345g437aga701g8cbf27c3848c"
msgid "W-what? Get your head outta my head!"
msgstr "뭐, 뭐야? 내 머릿속에서 당장 나가!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = 715271bb-0ee6-cd67-232a-811ccdeb8bc1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:715271bb-0ee6-cd67-232a-811ccdeb8bc1
msgctxt "h98c74997ge716g49acga5f2g8ac4b3da7185"
msgid "Anyway, I should go. See you around."
msgstr "아무튼 난 이만 가봐야겠어. 나중에 또 보자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Player
#. NodeID = 7466009a-b4a3-9fad-3b1b-007c5aa523e2
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 15
#. CheckFlags:
#.   Script:
#.      - GEN_CanDetectThoughts_2 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:7466009a-b4a3-9fad-3b1b-007c5aa523e2
msgctxt "h3da6a5dbg26d6g4848g8cddga5a4cbfc5086"
msgid "<i>Read his mind.</i>"
msgstr "<i>그의 생각을 읽는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = 7534ee31-5b24-403f-7963-cf73336efb24
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:7534ee31-5b24-403f-7963-cf73336efb24
msgctxt "h087aa642g9819g4e9egb005g894ea401e62e"
msgid "Yeah. I know she would."
msgstr "그래. 분명 그러실 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = 7703d035-7a20-c60e-d771-b6799108f2e8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Adventurer_HasMet(1) = True
#.   Global:
#.      - DEN_Thieflings_Knows_MeliTalkedAboutHisMother = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:7703d035-7a20-c60e-d771-b6799108f2e8
msgctxt "h7c58d698gebadg4cb2gbfeag1b426c559d57"
msgid "You're all right by me."
msgstr "넌 괜찮은 녀석이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Player
#. NodeID = 78d23bc2-1a92-16fe-4f57-c815c2ab80f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:78d23bc2-1a92-16fe-4f57-c815c2ab80f1
msgctxt "h8e0784bbgbcd3g40caga97ega0abdea805f5"
msgid "Well, at least you can have it back now."
msgstr "어쨌든 되찾았네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = 7b2a40f7-9502-8407-f677-c05a44fde275
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:7b2a40f7-9502-8407-f677-c05a44fde275
msgctxt "h9cc29a25ge26cg497cga471g2552d660893c"
msgid "That's it. That is bloody it."
msgstr "됐어. 더는 못 참아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = 812b3937-3f0d-fe91-62ca-8c53ac67d495
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Adventurer_HasMet(1) = False
#.   Global:
#.      - DEN_Thieflings_Event_AdventurerKnockedOut = False
#.      - DEN_Thieflings_Event_AngeredAdventurer = True
#.   Object:
#.      - DEN_Thieflings_State_WitnessedArgument(1) = True
#.      - DEN_Thieflings_State_HasStolenLocket(0) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Adventurer_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:812b3937-3f0d-fe91-62ca-8c53ac67d495
msgctxt "ha9d259a7ga640g476bg8e8bgcaf3ae61d39b"
msgid ""
"Thanks to you, I almost lost my locket. My mum gave that to me on her "
"deathbed.\n"
msgstr "너 때문에 내 로켓을 못 찾을 뻔했어. 엄마가 임종 때 내게 남기신 거라고.\n"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = 84fa9c2e-a9d6-878e-7f4b-e6cf09547f8f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:84fa9c2e-a9d6-878e-7f4b-e6cf09547f8f
msgctxt "h6dced5ceg60a3g4512gbec1g45fa35f98285"
msgid "Finally."
msgstr "드디어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = 88009a1b-e686-7500-8fe4-1668fb0b562c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Adventurer_HasMet(1) = True
#.   Global:
#.      - DEN_Thieflings_State_AfterRobberKidConfront = True
#.      - DEN_Thieflings_Event_AngeredAdventurer = False
#.   Object:
#.      - DEN_Thieflings_State_WitnessedArgument(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:88009a1b-e686-7500-8fe4-1668fb0b562c
msgctxt "h2f548cd8g1584g4654gae50gc6e464af60d6"
msgid "Watch your bags, huh? Learn from my mistakes."
msgstr "가방 간수 잘 해. 나 같은 일 겪지 말라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = 8cd41e3b-c3e9-2df2-d8d7-c24666303bfc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Adventurer_HasMet(1) = False
#.   Global:
#.      - DEN_Thieflings_State_AfterRobberKidConfront = True
#.      - DEN_Thieflings_Event_AdventurerKnockedOut = True
#.      - DEN_Thieflings_Event_AngeredAdventurer = False
#.   Object:
#.      - DEN_Thieflings_State_WitnessedArgument(1) = True
#.   Tag:
#.      - TIEFLING(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Adventurer_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:8cd41e3b-c3e9-2df2-d8d7-c24666303bfc
msgctxt "h416c6a4eg2f6bg4954ga7f2gf35d55d066f3"
msgid "I'll say this for those devils: they know how to throw a punch."
msgstr "데빌 놈들, 이거 하나는 인정해야겠군. 주먹질이 제법 매서워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = 8ea25ec3-477f-7822-7186-bb1cc97abc67
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:8ea25ec3-477f-7822-7186-bb1cc97abc67
msgctxt "hef6dee9fg77fag410eg8bc1g0b6ac76a2ee0"
msgid ""
"What're you waiting for? I told you I'd give you some coin. Hand it over!"
msgstr "뭘 꾸물거리고 있어? 내가 돈 주겠다고 말했잖아. 어서 이리 내!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = 9094add4-9721-1779-cba7-4ddafc1e4f8f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:9094add4-9721-1779-cba7-4ddafc1e4f8f
msgctxt "hf728030cg3499g46f1ga32fgc851fc88308c"
msgid "If that ain't enough, too bad. It's all I got."
msgstr "그걸론 부족하다면, 거 안됐네. 그게 내 전부거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = 9346757d-b680-a83e-f7e4-26abbe3e2e39
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Adventurer_HasMet(1) = False
#.   Global:
#.      - DEN_Thieflings_State_AfterRobberKidConfront = True
#.      - DEN_Thieflings_Event_AdventurerKnockedOut = False
#.      - DEN_Thieflings_Event_AngeredAdventurer = False
#.   Object:
#.      - DEN_Thieflings_State_WitnessedArgument(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Adventurer_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:9346757d-b680-a83e-f7e4-26abbe3e2e39
msgctxt "h27b33195g7b72g46d8ga60bg7650aab5131e"
msgid "The nerve of that smirking little rat."
msgstr "그 능글맞은 쥐새끼의 뻔뻔스러움이란."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = 962dc023-e1a8-82d6-a426-bf509ee9e5d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:962dc023-e1a8-82d6-a426-bf509ee9e5d9
msgctxt "h8d7a4d99gbc9eg49b8g9f96gebc28c33df4a"
msgid ""
"I appreciate the kindness friend, but I ain't getting the locket back. Not "
"now."
msgstr "호의는 고맙지만 말이야 친구, 그 로켓은 되찾기 힘들 거 같아. 당분간은."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = 96cd063a-9b2b-affc-cce7-a52d0bb68246
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Adventurer_HasMet(1) = True
#.   Global:
#.      - DEN_Thieflings_Event_AngeredAdventurer = True
#.   Object:
#.      - DEN_Thieflings_State_WitnessedArgument(1) = True
#.      - DEN_Thieflings_State_HasStolenLocket(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:96cd063a-9b2b-affc-cce7-a52d0bb68246
msgctxt "hff4d8997g5d0dg428ag81ecg958ccaca3c7f"
msgid "That kid stole the one thing that means anything to me."
msgstr "내가 유일하게 아끼는 걸 그 꼬맹이가 훔쳐가버렸어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Player
#. NodeID = 997193ac-1420-5752-a894-8f5bcdd8adc3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_AdventurerKnockedOut = True
#.   Object:
#.      - DEN_Thieflings_State_HasStolenLocket(0) = True
#. TagRule: CLERIC_EVIL or FIGHTER or MONK or PALADIN_EVIL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:997193ac-1420-5752-a894-8f5bcdd8adc3
msgctxt "hb88d0ef2gee68g4900g9265g461519f02f2c"
msgid "If you don't want another beating, give me the locket. Now."
msgstr "한 대 더 처맞기 싫으면 그 로켓 나한테 넘겨. 당장."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Player
#. NodeID = 9a862a7e-6307-fc8c-aba0-16985798557c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - DEN_RobbedAdventurer.NoLocketReturn(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:9a862a7e-6307-fc8c-aba0-16985798557c
msgctxt "hfde68e4dga083g4a65gb9a3g532f8eaffd22"
msgid "On second thoughts, I'm keeping it."
msgstr "다시 생각해봤는데, 내가 계속 가져야겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = a08045c0-2680-ac85-49a3-cd8847d7f095
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:a08045c0-2680-ac85-49a3-cd8847d7f095
msgctxt "h2b4cf207gd7beg4e13g8d7bgb1bf9621834e"
msgid "Nothing. I'm sad, is all. Leave it alone."
msgstr "없어. 그냥 속상해서 그런 거야. 그만 신경 꺼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Player
#. NodeID = a57f5840-202f-8b3b-cf3a-5de78da7162c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Thieflings_State_HasStolenLocket(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:a57f5840-202f-8b3b-cf3a-5de78da7162c
msgctxt "hfc97582cg015bg4a0fga827ga7b47aca3fb0"
msgid "Speaking of the locket... can I have it?"
msgstr "말이 나왔으니 말인데... 그거 내가 가져도 될까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = a724979e-bb04-39bc-bbc2-bd1923c029c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:a724979e-bb04-39bc-bbc2-bd1923c029c4
msgctxt "h66135d7egf4e9g4416gacd3g8f05ca3ea61f"
msgid "You'd best be joking."
msgstr "농담도 잘하시는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = ab23016f-5101-3fad-3b2f-cab09c1feabd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:ab23016f-5101-3fad-3b2f-cab09c1feabd
msgctxt "h9e0f1f39g6246g4b94gb95bg209d9962b269"
msgid "Now hand it over, or we're gonna have problems, you and me."
msgstr "이제 이리 넘겨. 안 그러면 고운 꼴 못 보게 될 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = ab98cd03-84a6-3b03-2e7c-32714cda1d6d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:ab98cd03-84a6-3b03-2e7c-32714cda1d6d
msgctxt "hee62a91eg976bg4d9bg9988gfd359bf05b39"
msgid ""
"My mum gave me that amulet. But I think she'd be happy knowing the kid has "
"it now."
msgstr "그 아뮬렛은 우리 엄마 유품이지. 하지만 그 꼬마가 가지는 편이 엄마도 기뻐해 하실 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Player
#. NodeID = ac8ac29a-0a66-0984-7367-6a8cd73fc26a
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:ac8ac29a-0a66-0984-7367-6a8cd73fc26a
msgctxt "h05757d7egf648g4c77gb24egf8871320800d"
msgid "Come on, spit it out. What aren't you telling me about the locket?"
msgstr "솔직히 털어놔 봐. 그 로켓에 네가 말하지 않은 사연이 있지 않아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Player
#. NodeID = accdcc43-e555-e583-5e5e-9302208ea118
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Event_ItemReturned = True
#.   Object:
#.     - DEN_Thieflings_Event_ReturnedLocket(1) = True
#.     - DEN_Hideout_Event_TransferLocket(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:accdcc43-e555-e583-5e5e-9302208ea118
msgctxt "h6b5478f4g8017g4490gad84g3a6343239c0b"
msgid "<i>Hand it over to him.</i>"
msgstr "<i>물건을 건네준다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = ae04a338-3c5a-85a2-6e55-d28edfc6ee6b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Adventurer_HasMet(1) = False
#.   Global:
#.      - DEN_Thieflings_Event_AdventurerKnockedOut = True
#.      - DEN_Thieflings_Event_AngeredAdventurer = True
#.   Object:
#.      - DEN_Thieflings_State_WitnessedArgument(1) = True
#.      - DEN_Thieflings_State_HasStolenLocket(0) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Adventurer_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:ae04a338-3c5a-85a2-6e55-d28edfc6ee6b
msgctxt "h182f2d21g054eg4308g8651g6fd1810a8c7a"
msgid "Got a beating, thanks to you. But at least I got my locket back."
msgstr "너 때문에 한 대 맞았잖아. 그나마 로켓은 되찾아 망정이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = ae471a6a-74e8-d974-f76d-ec2c97204ae2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_ItemReturned = True
#.   Object:
#.      - DEN_Thieflings_State_WitnessedArgument(1) = True
#.      - DEN_Thieflings_State_HasStolenLocket(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:ae471a6a-74e8-d974-f76d-ec2c97204ae2
msgctxt "hd45da7ddgec7bg42b5gaff7gd8aafb1b1d49"
msgid ""
"Someone stole the damn amulet off me again. Don't want to talk about it. "
msgstr "누가 내 망할 아뮬렛을 또 훔쳐갔어. 이젠 말도 꺼내기 싫군. "

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = af67d719-3578-4092-5250-461070f3bbf3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Adventurer_HasMet(1) = False
#.   Global:
#.      - DEN_Thieflings_Event_AdventurerKnockedOut = False
#.      - DEN_Thieflings_Event_AngeredAdventurer = True
#.   Object:
#.      - DEN_Thieflings_State_WitnessedArgument(1) = True
#.      - DEN_Thieflings_State_HasStolenLocket(0) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Adventurer_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:af67d719-3578-4092-5250-461070f3bbf3
msgctxt "h613cbb85ge401g4197g97c6gb146d3209eb9"
msgid ""
"Thanks to you, that kid has my locket. My mum gave that to me on her "
"deathbed."
msgstr "너 때문에 그 꼬마가 내 로켓을 차지했어. 그건 엄마가 임종 때 내게 남기신 거라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = b0cc5dec-5b29-fdd5-b234-459be62c79f4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_CheckPocketGold_2 = False
#. SetFlags:
#.   Quest:
#.     - DEN_RobbedAdventurer.ReturnedLocketFree(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:b0cc5dec-5b29-fdd5-b234-459be62c79f4
msgctxt "h7e45f75bg7d36g4755ga184gea64a1593363"
msgid ""
"And it looks like someone took my money too. Got nothing to give you but my "
"thanks."
msgstr "근데 누가 내 돈도 털어간 모양인걸. 네게 감사 말고는 줄 게 없겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = b463ce1f-50d0-0358-2405-c38abf65ed74
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Adventurer_HasMet(1) = False
#.   Global:
#.      - DEN_Thieflings_Event_AdventurerKnockedOut = True
#.      - DEN_Thieflings_Event_AngeredAdventurer = True
#.   Object:
#.      - DEN_Thieflings_State_WitnessedArgument(1) = True
#.      - DEN_Thieflings_State_HasStolenLocket(0) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Adventurer_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:b463ce1f-50d0-0358-2405-c38abf65ed74
msgctxt "hd7c141a9gfd6ag400bgba9fg014b43ce4752"
msgid "Thanks to you, that kid has my mum's locket and I got a beating."
msgstr "너 때문에 그 꼬마가 우리 엄마 로켓을 차지했고, 나는 한 대 처맞았다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = b4c0b0c5-c39c-199f-cc4c-50b4ca0f04e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:b4c0b0c5-c39c-199f-cc4c-50b4ca0f04e2
msgctxt "he9f8c2cfgc55fg47cbg82ecgbf2098abac18"
msgid "She stole it from a house she cleaned, all right?"
msgstr "엄마가 청소부 하던 집에서 훔치신 거다. 됐냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Player
#. NodeID = b6186c9e-fe59-e1ec-8a78-2c0559c79695
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Thieflings_State_HasStolenLocket(0) = True
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:b6186c9e-fe59-e1ec-8a78-2c0559c79695
msgctxt "h0cbda895g0188g45fcgbb6ag575b19ea37a4"
msgid "Locket. <b>Now.</b>"
msgstr "로켓 내놔. <b>당장.</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Player
#. NodeID = b7b2c217-524c-ffc8-5fdd-90f03c9859c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:b7b2c217-524c-ffc8-5fdd-90f03c9859c6
msgctxt "hc7ca3040g5fc2g4ad9g8138g05d177ee48d7"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Player
#. NodeID = bc4f45d8-fab8-c0f3-d126-481ea66aa4da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:bc4f45d8-fab8-c0f3-d126-481ea66aa4da
msgctxt "h3863ce28g1398g4fe3gbcf0gc4bc768c5adb"
msgid ""
"Let me get this straight - you're annoyed that somebody stole your stolen "
"property?"
msgstr "정리 좀 해보자. 그럼 넌 누구한테서 훔친 물건을 또 누구한테 도둑맞았다고 성질을 부려댄 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = bf73b95e-1250-697e-027c-b3acc4242333
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Adventurer_AdventuerHasAmuletAndGaveStory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:bf73b95e-1250-697e-027c-b3acc4242333
msgctxt "h1ad4c93dga9b1g4dbfga60dg30057bb3c09d"
msgid "You're all right by me, friend. "
msgstr "넌 괜찮은 녀석이야, 친구. "

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = c07ac64d-2b25-a5c0-9462-df51d8b255a6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Event_AngeredAdventurer = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:c07ac64d-2b25-a5c0-9462-df51d8b255a6
msgctxt "h6f949ee9gf5c3g4622gae9bg2323bc0e9223"
msgid "I... I don't know what to say."
msgstr "뭐... 뭐라 해야 할지 모르겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = c187cd25-8518-6235-939a-69c16249527b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:c187cd25-8518-6235-939a-69c16249527b
msgctxt "hdf208281g434bg4f86g94b8g3fa07be8e701"
msgid "Yeah, all right, it wasn't."
msgstr "그래, 맞아. 아니었지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = c2de6540-2f25-e355-fd80-adeb3706cf8e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:c2de6540-2f25-e355-fd80-adeb3706cf8e
msgctxt "h26a3112eg85bcg4848gb1c3g5c96034cbc4d"
msgid "Anyway, I meant what I said. Thanks for what you did. I gotta go."
msgstr "아무튼 내가 한 말은 진심이었어. 친절을 베풀어줘서 고마워. 이만 가볼게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Player
#. NodeID = c3bf5169-9526-5480-7304-49a58d32bfe5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Event_ItemReturned = True
#.   Object:
#.     - DEN_Thieflings_Event_ReturnedLocket(1) = True
#.     - DEN_Hideout_Event_TransferLocket(0) = True
#.   Quest:
#.     - DEN_RobbedAdventurer.ReturnedLocketReward(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:c3bf5169-9526-5480-7304-49a58d32bfe5
msgctxt "hbb8ed348g86d7g4f53g8a03g02186030a2cb"
msgid "Thank you kindly."
msgstr "대단히 고맙군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Player
#. NodeID = c57d53e7-df09-a9fb-495c-ec00d666e30f
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:c57d53e7-df09-a9fb-495c-ec00d666e30f
msgctxt "h98c927e0g2f4cg4035gac32gdeea4edd8e12"
msgid "Not much of an heirloom then... unless there's a tale behind it, maybe?"
msgstr "그럼 딱히 가보는 아니네... 아니면 혹시 따로 사연이라도 있는 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = c5f682c6-356c-3656-6ba9-018bc77efcc2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:c5f682c6-356c-3656-6ba9-018bc77efcc2
msgctxt "h9f9cc55agd886g4697ga9c7g43c8dfae9d7f"
msgid "Should've seen that, but my temper was up. "
msgstr "나도 알았어야 했는데, 화를 주체할 수 없었지. "

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Player
#. NodeID = c96f5388-c248-1fec-7fc1-0ef01291c548
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Thieflings_State_HasStolenLocket(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Adventurer_AdventuerHasAmuletAndGaveStory(1) = True
#.   Global:
#.     - DEN_Thieflings_Event_ItemReturned = True
#.   Object:
#.     - DEN_Thieflings_Event_ReturnedLocket(1) = True
#.     - DEN_Hideout_Event_TransferLocket(0) = True
#.   Quest:
#.     - DEN_RobbedAdventurer.ReturnedLocketFree(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:c96f5388-c248-1fec-7fc1-0ef01291c548
msgctxt "h7b36af69g18c3g4bd5g9c34g41bc1662d7ca"
msgid "Here's the locket. It's all yours."
msgstr "여기 네 로켓이야. 가져가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Player
#. NodeID = c9ecc016-91c1-8333-3164-1f405b032e7f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Event_ItemReturned = True
#.   Object:
#.     - DEN_Thieflings_Event_ReturnedLocket(1) = True
#.     - DEN_Hideout_Event_TransferLocket(0) = True
#.   Quest:
#.     - DEN_RobbedAdventurer.ReturnedLocketFree(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:c9ecc016-91c1-8333-3164-1f405b032e7f
msgctxt "h191bc85fgf6dbg4fceg835bgcfbadf21fad4"
msgid "Forget the coin. The locket's yours. Take it."
msgstr "돈은 됐어. 로켓은 네 거야. 받아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = cdc73696-4d00-1b72-4e5e-4274b69cfb59
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:cdc73696-4d00-1b72-4e5e-4274b69cfb59
msgctxt "hc965093fg84edg4e9egac80g76c5e1bed27a"
msgid ""
"And if you twist the pup's arm, he'll yelp, and the wolves'll come running. "
msgstr "그 새끼 팔 조금만 꽉 잡아도 생난리 칠 테고, 딴 놈들이 네게 달려들 거야. "

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = d81854d6-3e08-a612-dbeb-4b8895b8b233
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Thieflings_State_HasStolenLocket(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:d81854d6-3e08-a612-dbeb-4b8895b8b233
msgctxt "hdc2bd201g1124g43f6ga5c3g779ed23a9d45"
msgid ""
"Can't believe the kid thought he could snatch my mum's locket and get away "
"with it."
msgstr "그 꼬마가 우리 엄마 로켓을 훔치고 내뺄 수 있을 거라 생각했다니 어이가 없네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = db8c736f-54a0-1cb8-3762-d3d1289a2311
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:db8c736f-54a0-1cb8-3762-d3d1289a2311
msgctxt "h2dec899bg570eg4939gb849g9b7e5cf34bab"
msgid ""
"Fine. I'll give you everything I've got and you can choke on it for all I "
"care. Give me the amulet."
msgstr "좋아. 내가 가진 돈 다 줄테니까 거기 깔려 죽든 말든 어디 맘대로 해. 아뮬렛 이리 줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = dbc19931-d43a-9c5d-7b22-23ed83079ff6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:dbc19931-d43a-9c5d-7b22-23ed83079ff6
msgctxt "h2e7dbf98g6e5bg415dg9382ga4f39e2d59ab"
msgid ""
"<i>Was in</i> another <i>family right up 'til mum stole it. But it's mine "
"now - all I have.</i>"
msgstr "<i>엄마가 훔치기 전까지는 </i>다른 <i>가족 거였지. 하지만 지금은 내 거야. 내 전부라고.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = dfb79ff3-6918-57a4-3223-44abe99b224d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:dfb79ff3-6918-57a4-3223-44abe99b224d
msgctxt "h19c317d3g930cg4d29gbdcdgbcb8f4e38cec"
msgid "I know it's stupid. It's all I have of her, is all."
msgstr "실없다는 건 알아. 내가 가진 엄마 물건은 이게 전부인걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Player
#. NodeID = e0559b73-e132-724c-c2aa-ee7ee1673bd0
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 0
#. CheckFlags:
#.   Script:
#.      - GEN_CanDetectThoughts_2 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:e0559b73-e132-724c-c2aa-ee7ee1673bd0
msgctxt "h542151b8g6bc2g4928g9e66g1ca5a804c3c7"
msgid "<i>Read his mind.</i>"
msgstr "<i>그의 생각을 읽는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Player
#. NodeID = e19227f4-492a-95e2-f06c-708e7bd0f73c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:e19227f4-492a-95e2-f06c-708e7bd0f73c
msgctxt "h28aae2d0g3c51g4e55ga832g7204de214f14"
msgid "Heirloom, is it? Been in your family long?"
msgstr "가보인 모양인데. 집안 대대로 내려온 물건인가 보지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Player
#. NodeID = e1984c0f-7f31-f608-ea43-a5a5372924fa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_ItemReturned = False
#.   Object:
#.      - DEN_Thieflings_Event_ReturnedLocket(1) = False
#.      - DEN_Thieflings_State_HasStolenLocket(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:e1984c0f-7f31-f608-ea43-a5a5372924fa
msgctxt "h3756fe86g069cg4a71g8437gee52696a19a7"
msgid "I'll see about getting it back into your hands."
msgstr "내가 그 물건을 되찾는 걸 도와줄게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = e24d352a-4cd3-1cc3-9d0a-c6ebb8e6921b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:e24d352a-4cd3-1cc3-9d0a-c6ebb8e6921b
msgctxt "h78bab4c5ge37bg4e28g9fa3g410936c242e0"
msgid "Thought so."
msgstr "그래야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Player
#. NodeID = e36f2ff9-0b10-50f5-a66f-346f30ce8695
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Event_ItemReturned = True
#.   Object:
#.     - DEN_Thieflings_Event_ReturnedLocket(1) = True
#.     - DEN_Hideout_Event_TransferLocket(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:e36f2ff9-0b10-50f5-a66f-346f30ce8695
msgctxt "h5d181ed5gaa8fg4ca8g84eeg4dc16776bd31"
msgid "<i>Hand it over to him.</i>"
msgstr "<i>물건을 건네준다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = e418b973-7be8-9116-44a8-40db48667656
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Event_AngeredAdventurer = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:e418b973-7be8-9116-44a8-40db48667656
msgctxt "h803cc41fgd172g4980gbe45g036d16e8cbd1"
msgid "You found it? I... I don't know what to say."
msgstr "네가 찾아줬다고? 뭐... 뭐라 해야 할지 모르겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = e50c19ca-b3d1-4478-ee66-7b2c09432bd7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:e50c19ca-b3d1-4478-ee66-7b2c09432bd7
msgctxt "hd2c936c4gc430g4e43g9683g6bcfc12650c6"
msgid "How did you... all right, fine. I'll give you some coin for it."
msgstr "대체 어떻게... 그래, 좋아. 그걸 주면 돈을 조금 줄게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Player
#. NodeID = ebc3738d-28ae-8fd7-4bf8-0a072f20421b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:ebc3738d-28ae-8fd7-4bf8-0a072f20421b
msgctxt "h9d92b310g1781g46dcg9476g28d3d24bf0a3"
msgid ""
"On second thought, I quite like this bauble. Think I'll keep it for myself."
msgstr "가만히 생각해 보니 이 장신구 꽤 마음에 드는걸. 그냥 내가 계속 가져야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = ed22a2bf-32dd-00d6-75dc-bb65a9f0b9fb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:ed22a2bf-32dd-00d6-75dc-bb65a9f0b9fb
msgctxt "he006ab78gf2fbg4e5bgb9b0gb986210c7ac9"
msgid ""
"Never said she was an angel, did I? But she sure as hells didn't have horns "
"on her head!"
msgstr "울 엄마가 천사라고 내가 언제 그랬냐? 다만 적어도 머리에 망할 뿔은 달려있지 않으셨지!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = edafd9d4-10d3-607d-76a0-ddd0ce51d659
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_CheckPocketGold = True
#. SetFlags:
#.   Object:
#.     - GEN_TransferNPCPayment(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:edafd9d4-10d3-607d-76a0-ddd0ce51d659
msgctxt "ha91e0c9bgd988g4cb2g9e8cg1881797f262c"
msgid "Kind of you, friend. Here's something for your troubles."
msgstr "정말 고마워, 친구. 이건 네 수고에 대한 보답이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Player
#. NodeID = f14c461e-4f6e-7a37-ce88-526154671ff9
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - ROGUE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:f14c461e-4f6e-7a37-ce88-526154671ff9
msgctxt "h37003698gb784g48adg8296g560b0161f212"
msgid "'Some coin'? Try 'lots of coin' - or else the trinket stays with me."
msgstr "고작 '조금'? '많이'로 정정하시지. 아니면 이 장신구는 내가 챙기겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = f57957ef-a385-5117-64eb-1cb1cf77b1b3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Adventurer_HasMet(1) = False
#.   Global:
#.      - DEN_Thieflings_State_AfterRobberKidConfront = True
#.      - DEN_Thieflings_Event_AdventurerKnockedOut = True
#.      - DEN_Thieflings_Event_AngeredAdventurer = False
#.   Object:
#.      - DEN_Thieflings_State_WitnessedArgument(1) = True
#.   Tag:
#.      - TIEFLING(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Adventurer_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:f57957ef-a385-5117-64eb-1cb1cf77b1b3
msgctxt "h87afd267gfdefg48ffg9163g19e89ce1aa51"
msgid "I'll say this for you devils: you know how to throw a punch."
msgstr "너희 데빌 놈들, 이거 하나는 인정하지. 주먹질 하난 제법 매운 것들이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = fb8e70f5-afc5-c5b1-9526-bdece86852f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:fb8e70f5-afc5-c5b1-9526-bdece86852f0
msgctxt "hdb67255bg3929g4b3egb467g510eac3ea158"
msgid "Get out of my face. Got nothing to say to you."
msgstr "내 앞에서 사라져. 너랑 할 말은 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo
#. Speaker = Barth
#. NodeID = fff6eed1-2a4b-fa2c-042e-b81c1cdc3204
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Adventurer_HasMet(1) = True
#.   Global:
#.      - DEN_Thieflings_Event_AngeredAdventurer = True
#.   Object:
#.      - DEN_Thieflings_State_WitnessedArgument(1) = True
#.      - DEN_Thieflings_State_HasStolenLocket(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Adventurer_Solo:fff6eed1-2a4b-fa2c-042e-b81c1cdc3204
msgctxt "h0c5a5d01gd3adg4457gab19g9e69af7076c9"
msgid "Get out of my face. Got nothing to say to you."
msgstr "내 앞에서 사라져. 너랑 할 말은 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief
#. Speaker = Silfy
#. NodeID = 06339d92-9cff-5c5c-a36f-a115cd0592e5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_Thieflings_Event_DropPickpocketLoot(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief:06339d92-9cff-5c5c-a36f-a115cd0592e5
msgctxt "h4360c3ecg277eg4afeg9cf6g75dad1c2b9fd"
msgid "Aah! Let go of me!"
msgstr "아악! 놔줘요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief
#. Speaker = Silfy
#. NodeID = 0ff02de3-f153-8ecb-02bc-e9261289d9a2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_PlayerRobbed = True
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Knows_PlayerRobbed = True
#.   Quest:
#.     - DEN_Thieflings.ToldRobbed(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief:0ff02de3-f153-8ecb-02bc-e9261289d9a2
msgctxt "h1dea86a9g437eg4b47ga787gd2b45aeb3518"
msgid "Right. You def'nately caught me the first and only time I stole."
msgstr "좋아요. 절 붙잡으셨네여, 맹세코 이번이 첫 번째 도둑질이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief
#. Speaker = Silfy
#. NodeID = 142845a7-8c32-2a9e-bf4c-de8c8684ac53
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief:142845a7-8c32-2a9e-bf4c-de8c8684ac53
msgctxt "hb0789ba9g27e9g432fg863bg7353c89bb479"
msgid "I can't give it back, though. It's already in the stash."
msgstr "돌려드릴 순 없어요. 이미 은신처에 숨겼거든요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief
#. Speaker = Player
#. NodeID = 1a717060-2920-5b29-4ea8-7a5570d79e5d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Strength
#. DifficultyClass: 10
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_State_MessedWithMolsKids = True
#.     - GLO_Thieflings_State_PCShookPickpocketSister = True
#.   Object:
#.     - DEN_Thieflings_Event_ShookThief(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief:1a717060-2920-5b29-4ea8-7a5570d79e5d
msgctxt "h0d3fd5c1g8a4ag44deg9780g0e419036bedd"
msgid "<i>Lunge at her. Remorse or not, she tried to rob you.</i>"
msgstr "<i>그녀에게 달려든다. 후회하든 말든, 그녀는 당신을 털려고 했다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief
#. Speaker = Silfy
#. NodeID = 1bda5a02-7737-be34-b845-f1a229988e10
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_PlayerRobbed = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief:1bda5a02-7737-be34-b845-f1a229988e10
msgctxt "h0dd6a157g6e72g4726g88d3g14fa75419d4e"
msgid "That's, um, really nice of you."
msgstr "그건, 음, 정말 착하시네요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief
#. Speaker = Narrator
#. NodeID = 235f53b0-11db-00d2-d9a4-cbeb277699bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief:235f53b0-11db-00d2-d9a4-cbeb277699bf
msgctxt "h990fb8abgf371g4abega799gae79baa4658d"
msgid "*You see her hand in your bags... and the shame in her heart.*"
msgstr "*그녀의 손이 당신 가방에 들어온 것이 보이고... 그녀의 양심의 가책이 느껴집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief
#. Speaker = Player
#. NodeID = 3015d682-be01-d256-75fc-4f440ea8a4d2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Hideout_Event_BefriendedThieflings = True
#.     - DEN_Hideout_Event_EasyOnPickpocket = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief:3015d682-be01-d256-75fc-4f440ea8a4d2
msgctxt "h5043a61fgc58ag4558gacdfg47c0555e3982"
msgid "Something tells me the thieving life isn't for you."
msgstr "내 생각엔 넌 도둑질이랑은 잘 맞지 않는 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief
#. Speaker = Silfy
#. NodeID = 376c4f4c-251d-1916-8308-a77c0ee339fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief:376c4f4c-251d-1916-8308-a77c0ee339fd
msgctxt "h0b6eafbbgd5a7g4aaagb7a3g54975911467c"
msgid "Help!"
msgstr "도와줘요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief
#. Speaker = Player
#. NodeID = 384728f2-e5b3-90a4-4983-0b2e0cd5594b
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Strength
#. DifficultyClass: 15
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_State_MessedWithMolsKids = True
#.     - GLO_Thieflings_State_PCShookPickpocketSister = True
#.   Object:
#.     - DEN_Thieflings_Event_ShookThief(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief:384728f2-e5b3-90a4-4983-0b2e0cd5594b
msgctxt "h6c991903g2eb9g4799g88bcg57cccdbc421d"
msgid "<i>Ignore her theatrics and grab her.</i>"
msgstr "<i>그녀의 연기를 무시하고 붙잡는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief
#. Speaker = Silfy
#. NodeID = 39698034-57f7-c406-495f-d96152834d01
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief:39698034-57f7-c406-495f-d96152834d01
msgctxt "h70be8745gcf8fg4d94gbdd8g5025ec823b10"
msgid "One of the big kids."
msgstr "큰 애들 중 한 명한테요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief
#. Speaker = Silfy
#. NodeID = 408f7558-5b57-70a2-ffc2-422e36a67e03
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief:408f7558-5b57-70a2-ffc2-422e36a67e03
msgctxt "h2aafab2agbbceg416fgb03dg7ce356d51306"
msgid "Help!"
msgstr "도와줘요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief
#. Speaker = Silfy
#. NodeID = 527d5055-2e82-7d4d-2371-3fdfda3550e4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief:527d5055-2e82-7d4d-2371-3fdfda3550e4
msgctxt "h60c17edegb670g4653gbfe5g13cfd320483f"
msgid "I guess I'll try harder not to get caught next time. Bye!"
msgstr "다음번엔 잡히지 않도록 더 노력해야겠네요. 그럼 이만!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief
#. Speaker = Silfy
#. NodeID = 575187d5-04cd-a470-bf9e-bcc22dea59a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief:575187d5-04cd-a470-bf9e-bcc22dea59a3
msgctxt "he3173e54g785fg4602gb114g5539f9aa0b56"
msgid "Oh. Okay."
msgstr "오, 알았어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief
#. Speaker = Silfy
#. NodeID = 5bf31cd4-e497-7ea4-7a4c-699b8579730e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief:5bf31cd4-e497-7ea4-7a4c-699b8579730e
msgctxt "h9518d212ga451g436cga6e7g65878fd4e250"
msgid "Um. Gotta go now."
msgstr "음. 이제 가야겠네요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief
#. Speaker = Narrator
#. NodeID = 663bba17-8915-a161-ecce-9c68fbf25a5c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief:663bba17-8915-a161-ecce-9c68fbf25a5c
msgctxt "hc3c00e5fg29efg455fga1f3g349de1b5f4fc"
msgid ""
"*You notice she's trembling. The tears streaming down her cheeks are indeed "
"real.*"
msgstr "*그녀가 떨고 있는 것이 느껴집니다. 그녀가 흘리고 있는 눈물은 진심입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief
#. Speaker = Silfy
#. NodeID = 66c20573-754c-00cd-8c00-ba51222b35e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief:66c20573-754c-00cd-8c00-ba51222b35e7
msgctxt "hb8d56b2cgfc0bg45fagb59eg9cd5c8bd8663"
msgid "How... how did you catch me?"
msgstr "어떻게... 절 잡으신 거예요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief
#. Speaker = Player
#. NodeID = 672a360c-c212-c196-8450-1e0e02e215dd
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Strength
#. DifficultyClass: 15
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_State_MessedWithMolsKids = True
#.     - GLO_Thieflings_State_PCShookPickpocketSister = True
#.   Object:
#.     - DEN_Thieflings_Event_ShookThief(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief:672a360c-c212-c196-8450-1e0e02e215dd
msgctxt "h37f0ee2bgce54g4362gbcc7g08d3bae74359"
msgid "<i>Lunge at her. Real tears or not, she tried to rob you.</i>"
msgstr "<i>아이에게 달려든다. 진심으로 울든 말든, 도둑질을 하려고 했다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief
#. Speaker = Player
#. NodeID = 79ce40de-0ef7-8236-8acc-2e5b171af01f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Hideout_Event_BefriendedThieflings = True
#.     - DEN_Hideout_Event_EasyOnPickpocket = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief:79ce40de-0ef7-8236-8acc-2e5b171af01f
msgctxt "h8b1f0c20ge269g4579ga7d5geb8e49cd4001"
msgid ""
"Relax, I won't get angry. You didn't even manage to get anything from me."
msgstr "진정해, 화난 거 아니야. 아무것도 훔치지도 못했는데 뭘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief
#. Speaker = Player
#. NodeID = 7e5eaa26-5237-adbc-3100-063eb80885a0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_State_CaughtStealing = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief:7e5eaa26-5237-adbc-3100-063eb80885a0
msgctxt "hdd974154ga1b1g46bdgbd3fg46a8035daeca"
msgid "Get out of my sight."
msgstr "당장 꺼져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief
#. Speaker = Player
#. NodeID = 8d00da01-78e6-eebf-d623-37ae48095bb1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ROGUE(1) = True
#. SetFlags:
#.   Global:
#.     - DEN_Hideout_Event_BefriendedThieflings = True
#.     - DEN_Hideout_Event_EasyOnPickpocket = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief:8d00da01-78e6-eebf-d623-37ae48095bb1
msgctxt "hea47c07egb941g4d2bg910dg0a3ef0b7fe46"
msgid "Well now, <i>someone's </i>starting young. Who taught you that?"
msgstr "어디 보자, <i>어린 녀석이</i> 간도 크구나. 누구한테 배운 거니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief
#. Speaker = Silfy
#. NodeID = 95de4c99-3259-8fe9-7e14-f575c3dca374
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief:95de4c99-3259-8fe9-7e14-f575c3dca374
msgctxt "h4d9f9359g6b7eg474egb21cg67bc34cab0a7"
msgid "I can't do this anymore, Mattis! I'm sorry!"
msgstr "더 이상은 못하겠어, 매티스! 미안해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief
#. Speaker = Narrator
#. NodeID = 984ca6e2-ef29-01fa-24bd-bb40c3b25344
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief:984ca6e2-ef29-01fa-24bd-bb40c3b25344
msgctxt "h45fef8f1g21d8g435aga477g2e88be8948a0"
msgid "*Her hands hide her face, preventing you from reading her expression.*"
msgstr "*그녀가 손으로 얼굴을 가리고 있어, 어떤 감정을 느끼고 있는지 알 수 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief
#. Speaker = Player
#. NodeID = 99718224-6911-02b7-e5c3-e0e42caee662
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 5
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief:99718224-6911-02b7-e5c3-e0e42caee662
msgctxt "h7dab46efg5bd5g43c1gbd21gad5438b1b14a"
msgid "<i>Observe her silently. Maybe these are just crocodile tears.</i>"
msgstr "<i>그녀를 조용히 관찰한다. 우는 척 연기하고 있는 걸지도 모른다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief
#. Speaker = Silfy
#. NodeID = 9ad45696-3a9f-cf9a-7a45-5241bcd32184
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_PlayerRobbed = True
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Knows_PlayerRobbed = True
#.   Quest:
#.     - DEN_Thieflings.ToldRobbed(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief:9ad45696-3a9f-cf9a-7a45-5241bcd32184
msgctxt "h385c5eacg1815g4992gb24eg552d1b4bce7e"
msgid ""
"I already took some of your stuff. Brought it back to the hideout. I'm so "
"sorry!"
msgstr "이미 당신 물건을 좀 훔쳤어요. 은신처에서 다시 가지고 나왔어요. 미안해요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief
#. Speaker = Silfy
#. NodeID = 9e3d8cde-a635-0ffb-a5db-b1df29517da8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief:9e3d8cde-a635-0ffb-a5db-b1df29517da8
msgctxt "h1f2f71bbgc056g4e90gab26gc746c1f14eee"
msgid "Wow. Thank you!"
msgstr "와. 고마워요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief
#. Speaker = Silfy
#. NodeID = 9f10a7d7-9db2-0037-ba17-3ce22d44d038
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Knows_PlayerRobbed = True
#.   Quest:
#.     - DEN_Thieflings.ToldRobbed(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief:9f10a7d7-9db2-0037-ba17-3ce22d44d038
msgctxt "h6e96242cgf947g40b0g9fd2gd56f8658b95b"
msgid ""
"I... feel like I should say that I already took some of your stuff. Before "
"now, I mean."
msgstr "저... 제가 당신 물건을 좀 훔쳤어요. 아까 전에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief
#. Speaker = Silfy
#. NodeID = a73eb6a3-2f4f-962f-00d1-e39afd48fd53
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_State_MessedWithMolsKids = True
#.     - GLO_Thieflings_State_PCShookPickpocketSister = True
#.   Object:
#.     - DEN_Thieflings_Event_ShookThief(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief:a73eb6a3-2f4f-962f-00d1-e39afd48fd53
msgctxt "hc0dba7fdg7784g4eb7ga8dcg668d096a980a"
msgid "N-no! What are you doing?"
msgstr "아-아니에요! 뭘 하시는 거예요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief
#. Speaker = Player
#. NodeID = bd0557db-796c-ea64-01ac-712b7b0684e4
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 0
#. CheckFlags:
#.   Script:
#.      - GEN_CanDetectThoughts_2 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief:bd0557db-796c-ea64-01ac-712b7b0684e4
msgctxt "he103afa1g6b01g4dccg94fbg531470c851db"
msgid "<i>Read her thoughts.</i>"
msgstr "<i>그녀의 생각을 읽는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief
#. Speaker = Player
#. NodeID = bd734cae-26fd-633d-075b-07c73b121d1b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#. SetFlags:
#.   Global:
#.     - DEN_Hideout_Event_BefriendedThieflings = True
#.     - DEN_Hideout_Event_EasyOnPickpocket = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief:bd734cae-26fd-633d-075b-07c73b121d1b
#, fuzzy
msgctxt "h97450b8dgef6ag49dbg9009gb63c2042271d"
msgid ""
"You don't have what it takes to be a villain. Kill while you smile, steal "
"like you <i>breathe</i>."
msgstr "너는 악인이 되기에는 부족해. 웃으면서 죽이고, 숨 쉬듯이 훔쳐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief
#. Speaker = Player
#. NodeID = c0410ba2-20d5-052a-7b8d-b66cd524f4b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief:c0410ba2-20d5-052a-7b8d-b66cd524f4b4
msgctxt "h8eb4ce99g30a8g4d83g9046g52068b1cb08b"
msgid "How else? You're clumsy. A dead man could've caught you."
msgstr "어떻게라니? 넌 손재주가 없어. 죽은 사람도 널 잡을 수 있었겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief
#. Speaker = Narrator
#. NodeID = d3264138-86b4-b6f3-e738-97194fc510f3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Knows_KidsThieves = True
#.     - DEN_Thieflings_Knows_PlayerRobbed = True
#.     - DEN_Thieflings_State_PCSawKidThievesGettingCaught = True
#.   Quest:
#.     - HIDDEN_WLD_Boosters.DEN_Thieflings_PersuadedPickpocket(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief:d3264138-86b4-b6f3-e738-97194fc510f3
msgctxt "hd50d6146gb634g48f3g9947g909ee9df0d21"
msgid "*You suddenly feel something moving against your back and turn.*"
msgstr "*당신은 갑자기 뒤쪽에서 뭔가 움직이는 것을 느끼고 돌아섭니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief
#. Speaker = Silfy
#. NodeID = dbef1cfd-eac1-f66f-102a-c1daa9bf3e0b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_PlayerRobbed = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief:dbef1cfd-eac1-f66f-102a-c1daa9bf3e0b
msgctxt "hdde62d96gdc36g4ba0gbf61g2595e1888b56"
msgid "Nuh-uh."
msgstr "아니, 으."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief
#. Speaker = Player
#. NodeID = f4f76fcc-8c25-b574-ea22-7d6c10d44393
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Event_SaidGotPickpocketTalent = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_CaughtThief:f4f76fcc-8c25-b574-ea22-7d6c10d44393
msgctxt "he8689ed1gf9feg4508g861ag999611dacaa7"
msgid "You were just unlucky this time. But you've got talent - I can tell."
msgstr "이번엔 운이 나빴던 거야. 하지만 넌 재능이 있어. 난 알 수 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutGuard_002
#. Speaker = Zaki
#. NodeID = be9a181a-cdd3-0dcc-dd1b-7cf7d21a0ca5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_HasMet_Guard2(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_HasMet_Guard2(1) = True
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutGuard_002:be9a181a-cdd3-0dcc-dd1b-7cf7d21a0ca5
msgctxt "h99ccdf03gd016g47f1gb420g25a9f571b168"
msgid ""
"You don't look so tough, toad-lady. Mol fought off a hobgoblin all by "
"herself."
msgstr "너는 강해 보이지 않네, 두꺼비 아가씨. 몰은 혼자서 홉고블린을 물리쳤어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutGuard_002
#. Speaker = Zaki
#. NodeID = be9a181a-cdd3-0dcc-dd1b-7cf7d21a0ca5
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_HasMet_Guard2(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_HasMet_Guard2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutGuard_002:be9a181a-cdd3-0dcc-dd1b-7cf7d21a0ca5
msgctxt "h6b6e455eg04aeg4150gbea0g6789e7c53128"
msgid "You don't look so tough. Mol fought off a hobgoblin all by herself."
msgstr "너는 강해 보이지 않네. 몰은 혼자서 홉고블린을 물리쳤어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutGuard_002
#. Speaker = Zaki
#. NodeID = dbfdc3bc-4b5d-a6f8-6643-2fa1f79bd774
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_HasMet_Guard2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutGuard_002:dbfdc3bc-4b5d-a6f8-6643-2fa1f79bd774
msgctxt "h9626314bg2be7g498aga8f0g5e02789914d0"
msgid "Give Mol a tenday and she'll own Baldur's Gate. You'll see."
msgstr "몰에게 열흘만 주면 그녀가 발더스 게이트를 차지할 거야. 두고 보라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 031a46ea-91c1-23f2-5cee-9276b051c63c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_State_CanTrespassInHideout = False
#.      - DEN_Hideout_State_MolAngryWithPlayer = True
#. SetFlags:
#.   Global:
#.     - DEN_Hideout_Event_TurnedKidsHostile = True
#.     - DEN_Hideout_Event_BefriendedThieflings = False
#.   Object:
#.     - DEN_Hideout_State_HostileThroughDialog(0) = True
#.   Quest:
#.     - DEN_Thieflings.DoneAngeredThieflings(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:031a46ea-91c1-23f2-5cee-9276b051c63c
msgctxt "h99969ea2gab80g4ff8g9368g0471f3ab0e58"
msgid "I told you to leave. What happens next is your fault."
msgstr "나는 떠나라고 말했어. 네 잘못에 책임을 져야 할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 05939ab4-bbee-8af7-2407-e69ea0dac3e8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_State_StolenGoodsTamperedWith = False
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Event_ReturnStolenGoods = True
#.     - DEN_Hideout_State_ResolvedThieflings = True
#.   Quest:
#.     - DEN_Thieflings.GivenGoods(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:05939ab4-bbee-8af7-2407-e69ea0dac3e8
msgctxt "h3f9d1271gc6cfg4eb9g8386gfdd15ccaf9d4"
msgid "Here you go. Won't happen again."
msgstr "여기 받아. 다신 그런 일은 생기지 않을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 08c88a35-bae3-0659-520f-33a503cb41ae
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Hideout_Event_EasyOnPickpocket = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:08c88a35-bae3-0659-520f-33a503cb41ae
msgctxt "h68038256g4ee7g49efg9dccg680d06fdc527"
msgid ""
"Still, you went easy on Silfy even though you caught her in your pockets."
msgstr "그래도, 넌 실피에게 주머니를 털렸는데도 부드럽게 대해줬어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 0a66cca6-0b8b-3a85-7741-98e7f8825d1b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_State_MessedWithMolsKids = True
#.   Object:
#.      - DEN_Hideout_State_PlayerWarnedToLeaveKidsAlone(1) = False
#. SetFlags:
#.   Object:
#.     - DEN_Hideout_State_PlayerWarnedToLeaveKidsAlone(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:0a66cca6-0b8b-3a85-7741-98e7f8825d1b
msgctxt "h539f04b8g7d72g49aagb96eg4a3e966b2478"
msgid "My gang says you've been messing with them. Don't deny it."
msgstr "우리 패거리 말로는 네가 애들을 괴롭혔다던데. 발뺌할 생각 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 0abede94-49a0-df8b-c156-d0c9e5cf0ebf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:0abede94-49a0-df8b-c156-d0c9e5cf0ebf
msgctxt "he9f37c2dg0b3fg4605gb100g71b7e35fcce6"
msgid ""
"They're <i>murderers</i>. I'd spit in the eye of any god the likes of them "
"worship."
msgstr "그들은 <i>살인자</i>야. 그들이 숭배하는 신이라면 어떤 신이라도 그 눈에 침을 뱉을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Player
#. NodeID = 0c5f6935-a8dc-ef37-3dcc-84352ae31e03
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Hideout_State_ResolvedThieflings = True
#. SetFlags:
#.   Object:
#.     - DEN_Hideout_State_PurposeOfHideoutExplained(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:0c5f6935-a8dc-ef37-3dcc-84352ae31e03
msgctxt "hce0450a4g4141g4c9bg8859gc26989be18ed"
msgid "There's nothing else to be said, for now."
msgstr "달리 말하고 싶은 건 없어, 당장은."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 0f78d3a8-3d40-3d28-b6be-e2aac07ac9fb
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_Hideout_State_GivenWarning(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:0f78d3a8-3d40-3d28-b6be-e2aac07ac9fb
msgctxt "hfecb9242g8395g4295g91d0g7dac81f1a658"
msgid "This is our hideout, but hey, maybe you didn't know."
msgstr "여긴 우리 은신처야. 그런데 보아하니, 넌 모르고 있었던 것 같네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 0fddf62d-1894-b670-1c00-3448b2d4a232
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:0fddf62d-1894-b670-1c00-3448b2d4a232
msgctxt "h7d23aab0g7feag49f5ga2c5g9381b1579523"
msgid "Suit yourself."
msgstr "맘대로 하셔."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Player
#. NodeID = 11d609ae-e582-7827-7ff2-bdf8e7afc3e4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Hideout_Event_DiscussedBGPlans = False
#.   Script:
#.      - GEN_CheckPocketGold = False
#. SetFlags:
#.   Global:
#.     - DEN_Hideout_Event_DiscussedBGPlans = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:11d609ae-e582-7827-7ff2-bdf8e7afc3e4
msgctxt "hef724550g754bg40cagadcbg504343c9d2c6"
msgid "Not at all. You've got foresight - that'll help you to survive."
msgstr "그럴 리가. 넌 사리에 밝구나. 무인도에서도 살아남겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 11ec7d5f-cfc8-4eae-051a-7f9336ecd002
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Hideout_Event_TurnedKidsHostile = True
#.     - DEN_Hideout_Event_BefriendedThieflings = False
#.     - DEN_Thieflings_State_HoldingStolenGoods = False
#.   Object:
#.     - DEN_Hideout_State_GivenWarning(1) = True
#.     - DEN_Hideout_State_HostileThroughDialog(0) = True
#.   Quest:
#.     - DEN_Thieflings.DoneAngeredThieflings(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:11ec7d5f-cfc8-4eae-051a-7f9336ecd002
msgctxt "h29f56bcdgfa22g4f1agb87bg8a94c049f4f0"
msgid "You idiot. What comes next is on you."
msgstr "돌대가리 같으니. 네 실수에 책임을 져야 할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 12a57f43-c4e7-2285-3df3-4d05d4e8312f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Hideout_Event_TurnedKidsHostile = False
#.   Party:
#.      - DEN_HideoutLeader_HasMet(1) = False
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_HasMet_Mol = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:12a57f43-c4e7-2285-3df3-4d05d4e8312f
msgctxt "h0afe7b65g96c0g4303ga461g3d1fd48e712c"
msgid "Well, look who's come to visit."
msgstr "그래, 누가 찾아왔는지 보자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 12fbb449-4933-1892-8b28-098ee4ea9944
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Hideout_Event_TurnedKidsHostile = True
#.     - DEN_Hideout_Event_BefriendedThieflings = False
#.     - DEN_Thieflings_State_HoldingStolenGoods = False
#.   Object:
#.     - DEN_Hideout_State_GivenWarning(1) = True
#.     - DEN_Hideout_State_HostileThroughDialog(0) = True
#.   Quest:
#.     - DEN_Thieflings.DoneAngeredThieflings(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:12fbb449-4933-1892-8b28-098ee4ea9944
msgctxt "h3cf6a0c8g2fadg4292gb366g65fea8b45de8"
msgid ""
"That's it. I'm telling the guards what you did. <i>Everything </i>you did!"
msgstr "됐어. 경비병들에게 네가 한 짓을 말해줄 거야. 네가 한 <i>모든</i> 짓을!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Player
#. NodeID = 134a5fd1-1aa5-453b-d134-2c4262aa5074
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ROGUE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:134a5fd1-1aa5-453b-d134-2c4262aa5074
msgctxt "h5b24d38ag763dg4535g8228gc82f9e9d7ac8"
msgid ""
"Here's some free advice, more valuable than gold: don't bargain, just take."
msgstr "금보다도 값비싼 조언 하나 해 줄게. 흥정할 시간에 그냥 빼앗아라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 1484f960-0bbc-1953-de53-c78bbe0b7de5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Hideout_Event_TurnedKidsHostile = False
#.      - DEN_Hideout_Event_BefriendedThieflings = False
#.   Party:
#.      - DEN_HideoutLeader_HasMet(1) = True
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_HasMet_Mol = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:1484f960-0bbc-1953-de53-c78bbe0b7de5
msgctxt "h6e73ed17g6c6cg48aag9d0fgb0b2d8205761"
msgid "Little slow on the uptake, aren't you?"
msgstr "너는 받아들이는 게 느리구나, 안 그래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 1605d3fe-984f-83fe-e38c-4b6de537a823
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_State_CanTrespassInHideout = True
#.      - DEN_Hideout_State_MolAngryWithPlayer = True
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_State_CanTrespassInHideout = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:1605d3fe-984f-83fe-e38c-4b6de537a823
msgctxt "h1f00485bg0cbdg48d9g9dfegb00293e6f430"
msgid "Any reason you're still here?"
msgstr "아직 볼일 남았어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Player
#. NodeID = 19a8e0b8-9234-bbb9-e45b-f511abe0b45c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:19a8e0b8-9234-bbb9-e45b-f511abe0b45c
msgctxt "h727d47c4gd41bg4a3bgbbbbga7fcaf9c2adc"
msgid ""
"I'm sure this <i>was</i> a misunderstanding. My things cost me a lot... I "
"really need them back."
msgstr "분명 오해였을 거야. 막대한 거금을 들여 구한 물건들이라고... 진짜로 그것들을 돌려받아야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Player
#. NodeID = 1a9e0718-59ef-3bad-bf19-a9430cd10c9f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Hideout_State_GivenWarning(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:1a9e0718-59ef-3bad-bf19-a9430cd10c9f
msgctxt "h9738b54dg6856g474bgb19cg000168516b3c"
msgid ""
"I go where I like - told you already. And I'll tell you again if I have to."
msgstr "난 내가 원하는 곳으로 간다. 이미 말했을 텐데. 필요하면 또 말해 줄게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Player
#. NodeID = 1cc2b6a6-32c1-301b-8ed5-91255f41d8aa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Hideout_State_ResolvedThieflings = False
#. SetFlags:
#.   Object:
#.     - DEN_Hideout_State_PurposeOfHideoutExplained(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:1cc2b6a6-32c1-301b-8ed5-91255f41d8aa
msgctxt "h2505e864g8ec6g43f8g9d72gb89a89155e8c"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 1d412541-8278-21d3-5f9e-8c1173cbc135
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Hideout_Event_TurnedKidsHostile = False
#.      - DEN_Hideout_State_ResolvedThieflings = True
#.   Party:
#.      - DEN_HideoutLeader_HasMet(1) = True
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_HasMet_Mol = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:1d412541-8278-21d3-5f9e-8c1173cbc135
msgctxt "h267a103bg4bfeg4e64g9484gf9e5136440e3"
msgid "I had a feeling you'd be back."
msgstr "다시 돌아올 줄 알았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 1dfa6946-a7b0-58b2-6c82-2ef7150bf632
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Hideout_Event_BefriendedThieflings = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:1dfa6946-a7b0-58b2-6c82-2ef7150bf632
msgctxt "h894a8131g0ab6g4813g885eg0bdc898ebb1b"
msgid "Well, it's been a pleasure. You know the way out."
msgstr "만나서 반가웠어. 출구가 어디인지는 알고 있겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 1e33df44-faac-f2c1-26a7-d41dfb6e3f0b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:1e33df44-faac-f2c1-26a7-d41dfb6e3f0b
msgctxt "he971c182g0a1dg4fc3gafe4g39411b4eff4e"
msgid "Anything else?"
msgstr "다른 건?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 203082cc-c424-69c6-d69b-1a06dff65191
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_ReturnedStolenRing = False
#.      - DEN_Thieflings_State_RippedOffPickpocketKid = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:203082cc-c424-69c6-d69b-1a06dff65191
msgctxt "h97236c3egeae5g48afg8308gd6e700db0ca0"
msgid "You took advantage of Mattis."
msgstr "넌 매티스를 이용해 먹었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 2111b633-0912-e5bb-f803-7ffc845d54a6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Hideout_Event_BefriendedThieflings = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:2111b633-0912-e5bb-f803-7ffc845d54a6
msgctxt "h9daf86e5ga054g47acga584g9dce9bb6ad9e"
msgid ""
"Thanks. See you in Baldur's Gate, I hope. Now scram, before I get emotional."
msgstr "고마워. 발더스 게이트에서 보면 좋겠네. 이제 꺼져, 감정적으로 되기 전에."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 26082d8a-c45e-6807-8ec2-7bead72bd361
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Hideout_Event_BefriendedThieflings = False
#.      - DEN_Hideout_State_MolAngryWithPlayer = False
#.   Object:
#.      - DEN_Hideout_State_GivenWarning(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:26082d8a-c45e-6807-8ec2-7bead72bd361
msgctxt "h53ad294fgb0e6g4419ga2b8g8830b2a1de9e"
msgid "Not sure why you're poking your nose in our business, though."
msgstr "하지만 네가 왜 우리 사업에 간섭하는지 모르겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Player
#. NodeID = 2db76815-02da-bcf2-f7c3-a3aea2dcbad7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Knows_KidsThieves = True
#.   Object:
#.      - DEN_Hideout_State_PurposeOfHideoutExplained(1) = False
#. SetFlags:
#.   Object:
#.     - DEN_Hideout_State_PurposeOfHideoutExplained(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:2db76815-02da-bcf2-f7c3-a3aea2dcbad7
msgctxt "h21e76df4g0a45g4dbcga69fg6a12107a9b49"
msgid "Why're you running all these schemes and swindles? Risky, you know."
msgstr "너희는 왜 이런 음모와 사기극을 벌이는 거야? 위험천만하잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Player
#. NodeID = 2e4944b4-2cac-4660-950b-83fcc420a572
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:2e4944b4-2cac-4660-950b-83fcc420a572
msgctxt "h7f66087eg4761g4083gad2fgb8965e4befbf"
msgid "Do you have anything to trade?"
msgstr "거래할 건 없어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 2ea2ad29-0202-6ee7-1dc5-3daf5d3cd907
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:2ea2ad29-0202-6ee7-1dc5-3daf5d3cd907
msgctxt "h91295a68g2409g422agb447g29d9613bfe15"
msgid ""
"That ritual's nothing more than a fancy way to kick us out and leave us for "
"dead."
msgstr "그 의식은 우리를 쫓아내고 죽음으로 몰아넣기 위한 화려한 방식에 지나지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 3182d792-8ca5-d2e6-757f-dbe0f66efe23
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_State_MessedWithMolsKids = True
#.   Object:
#.      - DEN_Hideout_State_PlayerWarnedToLeaveKidsAlone(1) = False
#. SetFlags:
#.   Object:
#.     - DEN_Hideout_State_PlayerWarnedToLeaveKidsAlone(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:3182d792-8ca5-d2e6-757f-dbe0f66efe23
msgctxt "h81ca1f04g465eg490fga08bge9a60a686c8b"
msgid "Messing with our business, yeah?"
msgstr "우리 사업을 방해하려는 거냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 31bd7b62-f6a9-2d5a-888a-73aa18631d63
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Hideout_Event_TurnedKidsHostile = True
#.   Object:
#.      - DEN_Thieflings_Event_HideoutTrespassCrimeResolved(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:31bd7b62-f6a9-2d5a-888a-73aa18631d63
msgctxt "heb245996g6a9fg4f16g924eg1b3a6608b267"
msgid "You did this to yourself!"
msgstr "네가 자초한 일이야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 32b8b38e-4095-0133-0daf-5ec51242f48c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:32b8b38e-4095-0133-0daf-5ec51242f48c
msgctxt "ha53b4176g0b83g4781g8b2fgf54f29abeed0"
msgid "We have nothing to talk about."
msgstr "우린 할 말 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Player
#. NodeID = 33f2e4a8-fd83-ad32-ec7d-140f2cacde3b
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_AgreedStealIdol = True
#.      - DEN_Thieflings_Event_RefusedGiveIdol = False
#.      - DEN_GroveConflict_State_IdolIsMissing = True
#.      - DEN_Thieflings_Event_GaveMolIdol = False
#.   Object:
#.      - DEN_Thieflings_State_HasIdol(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:33f2e4a8-fd83-ad32-ec7d-140f2cacde3b
msgctxt "hd0e9c50agdc75g4f91g8a66g6ed96526923c"
msgid "I didn't touch the idol. Don't know what happened to it."
msgstr "난 우상에 손 댄 적 없는데. 당최 무슨 일이 일어난 건지 원."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 36d8decc-3cc5-8158-3728-5b2e70c98e81
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Hideout_Event_BefriendedThieflings = False
#. SetFlags:
#.   Object:
#.     - DEN_Hideout_State_GivenWarning(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:36d8decc-3cc5-8158-3728-5b2e70c98e81
msgctxt "h017e7803ga9aag4fc6gbd8fgfa5d69d74d49"
msgid "Don't come back unless you want to talk business."
msgstr "사업 얘기 나눌 거 아니면 돌아오지 말라구."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 36e2aeb0-71d2-9a78-39a0-33b22e709b18
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Event_RefusedGiveIdol = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:36e2aeb0-71d2-9a78-39a0-33b22e709b18
msgctxt "h49229773geb2dg4abag9964gaedf45dd638f"
msgid "Damn it. Having that stashed away would have made life a lot easier."
msgstr "망할. 그걸 손에 넣었다면 삶이 좀 폈을 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Player
#. NodeID = 37cf3dcc-879e-5e53-8bdd-5902e9d8c3eb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:37cf3dcc-879e-5e53-8bdd-5902e9d8c3eb
msgctxt "he19654ceg68abg4e0egb3e3g3a279efec0dc"
msgid "You're about as intimidating as a flail snail in a salt mine."
msgstr "너는 소금 광산의 도리깨 달팽이만큼이나 위협적인 존재야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Player
#. NodeID = 38840181-e57a-7155-3419-cc48788bc879
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:38840181-e57a-7155-3419-cc48788bc879
msgctxt "hd84c8646g6df7g4732ga14dg14df3c9740d6"
msgid "Happy to help."
msgstr "도움이 돼서 기쁘군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 3ef0edda-3c7c-60cd-8ec9-4cbc9205cadb
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_Hideout_State_GivenWarning(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:3ef0edda-3c7c-60cd-8ec9-4cbc9205cadb
msgctxt "hd294be06g5f1eg48fcga072gc86f9544ee4a"
msgid "Okay, that's funny. You're funny."
msgstr "좋아, 그거 재밌네, 재밌는 사람이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 408f88fe-9d19-d6f0-9e01-34de4b371592
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Hideout_Event_BefriendedThieflings = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:408f88fe-9d19-d6f0-9e01-34de4b371592
msgctxt "hd0ac6580gc33ag4930g86f7g077544faa30c"
msgid "Still, you've been a friend to us so far."
msgstr "그래도, 넌 지금까지 줄곧 우리 친구였어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Player
#. NodeID = 40d6c233-86ea-8eaa-b9c7-c159d54b7ed1
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:40d6c233-86ea-8eaa-b9c7-c159d54b7ed1
msgctxt "hed4ffb3bg5151g491cgadb6g9324a9b4d8e0"
msgid "I'm not your mother. Do as you please."
msgstr "나는 네 어머니가 아니야. 하고 싶은 대로 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Player
#. NodeID = 40d6c233-86ea-8eaa-b9c7-c159d54b7ed1
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:40d6c233-86ea-8eaa-b9c7-c159d54b7ed1
msgctxt "h5fb79052g710ag4990g85a3gbdfe069c4c7a"
msgid "I'm not your father. Do as you please."
msgstr "나는 네 아버지가 아니야. 하고 싶은 대로 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Player
#. NodeID = 40d6c233-86ea-8eaa-b9c7-c159d54b7ed1
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:40d6c233-86ea-8eaa-b9c7-c159d54b7ed1
msgctxt "h2d7e730bgcdedg4674gbd17g84448bdaa2cb"
msgid "I'm not your parent. Do as you please."
msgstr "나는 네 부모님이 아니야. 하고 싶은 대로 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 41ae28cc-ba24-aaba-b056-c74a799c2f64
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Event_PromisedIdolCut = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:41ae28cc-ba24-aaba-b056-c74a799c2f64
msgctxt "h6a4e0b2eg4446g4e20g8e8egdbbf3435726f"
msgid "Sure. When we sell it in the city, I'll make sure you get your cut."
msgstr "물론. 우리가 도시에서 우상을 팔면, 너도 배당을 받을 수 있도록 할게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Player
#. NodeID = 425b2ed4-6530-7f48-8547-2f1b0c0e7e64
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Knows_KidsThieves = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:425b2ed4-6530-7f48-8547-2f1b0c0e7e64
msgctxt "hb14e1a35g4fe4g402agb5e0gbee28e999608"
msgid ""
"You'd better keep these kids in check. They won't get off so lightly forever."
msgstr "이 아이들을 잘 통제하는 게 좋을 거야. 영영 가볍게 위기를 벗어나지는 못할 테니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Player
#. NodeID = 42bca0e4-64a1-1127-d84b-0cf3f795f1be
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:42bca0e4-64a1-1127-d84b-0cf3f795f1be
msgctxt "h8e43a2c3g648ag453cg9cf9g2889bcc9100f"
msgid ""
"That 'big shiny idol' is part of a sacred ritual. Don't you have any respect?"
msgstr "그 '크고 빛나는 우상'은 성스러운 의식의 일부야. 너에게는 존경심도 없나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Player
#. NodeID = 43ecb401-5114-0a7c-0785-6134954e944e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Intelligence
#. DifficultyClass: 5
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:43ecb401-5114-0a7c-0785-6134954e944e
msgctxt "h353ce620gd43dg4ac1ga047g1ab413dd2e2e"
msgid "<i>Copy the gesture.</i>"
msgstr "<i>동작을 따라한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 43f4b29b-dc6f-85db-e0af-34eaa18e2456
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Thieflings_State_PickpocketKidGotHit = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:43f4b29b-dc6f-85db-e0af-34eaa18e2456
msgctxt "h7dedac30g9357g4197ga607gac91d8c2df9c"
msgid "You let that adventurer hit Meli."
msgstr "그 모험가 놈이 멜리에게 손 대도록 두었고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Player
#. NodeID = 49522847-db56-9115-cbf6-89a41a3a4fd0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Hideout_State_GivenWarning(1) = False
#.   Tag:
#.      - ROGUE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:49522847-db56-9115-cbf6-89a41a3a4fd0
msgctxt "h5620f09ag000fg426cg9e8cg86cbd96642bd"
msgid ""
"Poking your nose in other people's business is the best way to get rich, I "
"find."
msgstr "다른 사람 사업에 끼어드는 게 부자가 되는 최고의 방법이거든, 내가 찾은 방법이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 49a32959-427b-692d-a368-d0cd8bfe1711
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Hideout_Event_BefriendedThieflings = True
#. SetFlags:
#.   Quest:
#.     - DEN_Thieflings.BefriendedTieflings(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:49a32959-427b-692d-a368-d0cd8bfe1711
msgctxt "h82d3c0e5g27d9g4cb4gaa23gcc3308729ba4"
msgid "Sure. Silfy probably grabbed them by mistake."
msgstr "물론 그렇겠지. 아마도 실피가 실수로 가져갔을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Player
#. NodeID = 49f2222f-1173-7d32-a2a6-c7d033427b61
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Hideout_Event_BefriendedThieflings = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:49f2222f-1173-7d32-a2a6-c7d033427b61
msgctxt "h058e8ef9ga49ag48b1gbea4g962670ce3956"
msgid "I'm not joining your little criminal gang."
msgstr "너희 꼬맹이 범죄 집단에 들어갈 생각은 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 4a873100-29ab-6798-278a-c3ac921ac15f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:4a873100-29ab-6798-278a-c3ac921ac15f
msgctxt "hcc6c8265g417dg4a49g8d90g5de69aed6117"
msgid "And for that, you get one more chance."
msgstr "그러니까 한 번 더 기회를 줄게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 4c222fe9-c71e-22fb-df0e-d9eeebee8bcc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:4c222fe9-c71e-22fb-df0e-d9eeebee8bcc
msgctxt "h5fec8821g5702g4aaaga4abgedad8fbd359d"
msgid "That's the way you want it? <i>Fine.</i>"
msgstr "그게 네가 원하는 방식이야? <i>좋아.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 4d2cf85c-bad4-92d9-3f17-2a29465cc865
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:4d2cf85c-bad4-92d9-3f17-2a29465cc865
msgctxt "h93e1d59dg991eg4e1fg9ca9g65466a9ef388"
msgid "And we're happy to <i>be </i>helped. Now, what can I do for you?"
msgstr "우리는 도움을 <i>받아서</i> 기쁘지. 자, 내가 너에게 뭘 해줄까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 50fd9a16-d50f-a448-6003-eaa98f15247f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:50fd9a16-d50f-a448-6003-eaa98f15247f
msgctxt "h3ea0bc54g07d4g4f25gb381g66d2a5a10203"
msgid "Threats, huh? The stones on you. Have it your way."
msgstr "하, 위협하시겠다? 자존심은 세 가지고. 맘대로 하셔."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Player
#. NodeID = 5247990f-55f2-4b5a-2509-51e790332437
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Hideout_Event_DiscussedBGPlans = False
#.      - DEN_Thieflings_State_StolenGoodsTamperedWith = False
#.      - DEN_Thieflings_State_HoldingStolenGoods = False
#.   Script:
#.      - GEN_CheckPocketGold = True
#. SetFlags:
#.   Global:
#.     - DEN_Hideout_Event_DiscussedBGPlans = True
#.     - DEN_Hideout_Event_GaveMoneyForGuild = True
#.   Object:
#.     - GEN_TransferNPCPayment(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:5247990f-55f2-4b5a-2509-51e790332437
msgctxt "hf297fffbg2bb6g45c6gbf10g31d85181e8fe"
msgid ""
"Quite the opposite. I want to invest in the newest thieves' guild on the "
"Sword Coast. ([GEN_CheckMagicPocketGold_6057ad05-9492-4630-9f0a-"
"be548b134c54])"
msgstr ""
"그 반대야. 소드 코스트의 새로운 도둑 길드에 투자하고 싶어. "
"([GEN_CheckMagicPocketGold_6057ad05-9492-4630-9f0a-be548b134c54])"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 533c2198-03c8-b309-e151-26e7f7640362
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:533c2198-03c8-b309-e151-26e7f7640362
msgctxt "h1adecd1eg3aaeg4c39ga4a3g9e0b436edf16"
msgid ""
"Won't turn down free money. I've got operating costs you wouldn't believe."
msgstr "공짜 돈은 거절할 수 없지. 나는 네가 믿기조차 어려울 만큼의 운영 자금을 모았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Player
#. NodeID = 54111992-3888-f76d-a495-139398db6ee3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Hideout_State_GivenWarning(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:54111992-3888-f76d-a495-139398db6ee3
msgctxt "h7009749bg5f8bg4edbg808bgc8fa6fd19e6a"
msgid "You ready to tell me what sort of racket you're running down here?"
msgstr "이 아래에서 어떤 종류의 사기를 치고 있는지 알려줄 준비 됐어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 54f7ae05-89cc-f8e9-deaf-0673fb68eea8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Hideout_Event_ThankedForSnakeKid = False
#.      - DEN_ShadowDruid_State_KidFreed = True
#. SetFlags:
#.   Global:
#.     - DEN_Hideout_Event_ThankedForSnakeKid = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:54f7ae05-89cc-f8e9-deaf-0673fb68eea8
msgctxt "h334f7bdege502g49c1gbe32g8df987dacfee"
msgid ""
"You saved Arabella from the druids. Don't know what those bastards would "
"have done."
msgstr "너는 드루이드들로부터 아라벨라를 구해줬어. 그 개자식들이 무슨 짓을 했을지 몰라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 55df05d8-53d9-6cb5-e32b-4823c0d5affa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:55df05d8-53d9-6cb5-e32b-4823c0d5affa
msgctxt "h333e88c3g9278g4fb6g8d75g8eb71e637e7f"
msgid "You know what else costs a lot? That inspection fee."
msgstr "비용 좀 드는 게 또 있는데 어쩌지? 검사비 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 5641140d-987a-21fc-015e-3d0c4768ba1c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Hideout_Event_PriceRaised(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:5641140d-987a-21fc-015e-3d0c4768ba1c
msgctxt "h219a2d3ag9f69g44f5ga89ag8a42f6be6397"
msgid ""
"Might help if you pay the inspection fee. I could take a look. "
"([GEN_CheckMagicPocketGold_6057ad05-9492-4630-9f0a-be548b134c54])"
msgstr ""
"검사비를 지불하면 도움이 될지도 모르지. 내가 찾아봐 줄게. "
"([GEN_CheckMagicPocketGold_6057ad05-9492-4630-9f0a-be548b134c54])"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 57e7d82e-79bb-085b-e755-bd37eec45e90
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Hideout_Event_PriceRaised(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:57e7d82e-79bb-085b-e755-bd37eec45e90
msgctxt "h57728907gec16g49d1g9326ge817ba064ec3"
msgid ""
"Might help if you pay the inspection fee. I could take a look. "
"([GEN_CheckMagicPocketGold_2_463b0f43-5410-412d-aba3-875cf81c38ca])"
msgstr ""
"검사비를 지불하면 도움이 될지도 모르지. 내가 찾아봐 줄게. ([GEN_CheckMagicPocketGold_2_463b0f43-5410"
"-412d-aba3-875cf81c38ca])"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 5892f00e-d2b6-ee56-86b5-3c25aec96bc6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:5892f00e-d2b6-ee56-86b5-3c25aec96bc6
msgctxt "hceede213g6db1g4ac0g99e4gf875675aa89e"
msgid "Making sure we're ready to leave when the time comes."
msgstr "때가 되면 떠날 준비가 되어 있는지 확인하고 있죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Player
#. NodeID = 589801c6-45b1-286b-2d56-9f16424c8629
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:589801c6-45b1-286b-2d56-9f16424c8629
msgctxt "h3f0c4524g95c2g4757g9c9dg74a852a0e0a2"
msgid ""
"Yes. You're taking advantage during bad times. There are words for folk like "
"that."
msgstr "그래, 너희는 남들에게 험난한 시기를 기회로 삼는군. 그런 녀석들을 일컫는 말이 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 597f5657-e8da-218e-7ba6-f53bee1edfa0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_State_MessedWithMolsKids = True
#.      - DEN_Hideout_Event_TurnedKidsHostile = False
#.   Object:
#.      - DEN_Hideout_State_PlayerWarnedToLeaveKidsAlone(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:597f5657-e8da-218e-7ba6-f53bee1edfa0
msgctxt "h8eeb3dadgcbb8g4efcg9e46g5e01937389b3"
msgid "<i>You.</i> Godsdammit, I warned you to stay away from my kids."
msgstr "<i>너.</i> 씨발, 우리 애들한테서 떨어지라고 경고했을 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 59e6eca5-c2fa-2c8d-bc4b-8fd1836d674d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_ReturnedStolenRing = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:59e6eca5-c2fa-2c8d-bc4b-8fd1836d674d
msgctxt "h14b831f6g9aaag4a95gb74ag2dc5050e4286"
msgid "Still, you gave Mattis' ring back. Taught him a lesson doing it, too."
msgstr "그래도, 넌 매티스의 반지를 돌려뒀어. 교훈도 좀 주고 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 5ad21571-b6c5-8fa6-03da-fb48365ba37b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Hideout_Event_BefriendedThieflings = True
#.   Quest:
#.     - DEN_Thieflings.GivenGoods(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:5ad21571-b6c5-8fa6-03da-fb48365ba37b
msgctxt "hd06aaed3g2883g4891ga8deg2edb36b348e4"
msgid "Honesty and politeness. I like that."
msgstr "정직하고 공손하군. 맘에 드네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 5b5e8794-5f42-bbbb-71e5-0150509a9f79
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:5b5e8794-5f42-bbbb-71e5-0150509a9f79
msgctxt "hc425c5edg5f16g4c4ag9893ge7abe3383ab7"
msgid "We're saving up for a better hideout when we get to Baldur's Gate."
msgstr "우리는 발더스 게이트에 도착하고 나서 더 좋은 은신처를 마련하기 위해 돈을 모으고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 5bce4abf-80fd-0256-b2ac-a24a406de3d8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Hideout_Event_TurnedKidsHostile = True
#.   Object:
#.      - DEN_Thieflings_Event_HideoutTrespassCrimeResolved(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:5bce4abf-80fd-0256-b2ac-a24a406de3d8
msgctxt "h09fa7a7dgd6fag40b7gbef4ga058a55a2b49"
msgid "I'm done with you. You better hope we don't have to talk again."
msgstr "너랑 볼일 끝났어. 다시는 얘기할 일 없길 바라는 게 좋을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 5d1d6c80-405d-45ac-1e6c-c28b14d01e20
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Hideout_Event_BefriendedThieflings = False
#.     - DEN_Thieflings_Event_RefusedGiveIdol = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:5d1d6c80-405d-45ac-1e6c-c28b14d01e20
msgctxt "h8e728253g5791g4eb5g949dg8efba8c92f0b"
msgid "Sounds more like a challenge than advice. Keep an eye on your pack."
msgstr "조언보다는 참견같이 들리는데. 배낭 잘 간수하라구."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 61214435-a6ab-8bdd-6798-07621e8ea671
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Knows_HandSignal = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:61214435-a6ab-8bdd-6798-07621e8ea671
msgctxt "h185f65bdg448bg4eebg82e4g54ea06bb06ac"
msgid "You got it. Now, we done here or what?"
msgstr "잘 하네. 그럼 뭐 볼 일은 끝난 거야? 아님 더 얘기하고 싶은 게 남은 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 62564b67-86ce-dfc0-be75-c5f46295181d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:62564b67-86ce-dfc0-be75-c5f46295181d
msgctxt "h72d39aeegccb9g4800g8224g85f504e2d786"
msgid ""
"And to make sure none of the kids on the job outside mess with you, show "
"them this:"
msgstr "그리고 밖에서 작업하는 애들이 너한테 장난질하는 걸 막고 싶다면, 이걸 보여줘:"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Player
#. NodeID = 637c7f38-5ce6-b181-4fee-7a18284c7031
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:637c7f38-5ce6-b181-4fee-7a18284c7031
msgctxt "ha0f7f9efg96b1g4eedgbf9cga4261a0e61ff"
msgid "And now the deal's off. See you around."
msgstr "그리고 거래는 끝이야. 나중에 보자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 63be7141-5c11-40e3-ca7f-f59ab580fe21
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Quest:
#.      - DEN_Thieflings.DoneTookGoods(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:63be7141-5c11-40e3-ca7f-f59ab580fe21
msgctxt "h169bd0ccg4b4dg4545g887cg722616b12629"
msgid "Sure. Silfy probably grabbed them by mistake."
msgstr "물론 그렇겠지. 아마도 실피가 실수로 가져갔을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 6c1692cb-0464-f594-47cc-215fc63c8a6e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Hideout_Event_AskedForGoods(1) = True
#.   Global:
#.      - DEN_Thieflings_Knows_PlayerRobbed = True
#.      - DEN_Hideout_Event_BefriendedThieflings = False
#.      - DEN_Thieflings_State_HoldingStolenGoods = True
#. SetFlags:
#.   Object:
#.     - DEN_Hideout_State_GivenWarning(1) = True
#.   Quest:
#.     - DEN_Thieflings.RefusedPayGoods(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:6c1692cb-0464-f594-47cc-215fc63c8a6e
msgctxt "h23b0e6c0gcf3eg4624gbf6cg11b9961ef0bc"
msgid "If you change your mind about that fee, you know where to find me."
msgstr "수수료에 대해 생각 좀 바뀌거든 여기서 다시 만나자구."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Player
#. NodeID = 6c69ebdb-8132-4d5c-7825-98f529894078
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Hideout_Event_LeaveCountdown = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:6c69ebdb-8132-4d5c-7825-98f529894078
msgctxt "hba54741cg2ea4g4f9bgb685ge9a51a1b2375"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Player
#. NodeID = 6ca41f98-d71e-6e41-fcde-fc3530d58f47
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Knows_KidsThieves = False
#.   Local:
#.      - 343c18e6-5c6c-cca5-84fa-74dceebbd4fb_WhatAreYouDoingHere = False
#. SetFlags:
#.   Local:
#.     - 343c18e6-5c6c-cca5-84fa-74dceebbd4fb_WhatAreYouDoingHere = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:6ca41f98-d71e-6e41-fcde-fc3530d58f47
msgctxt "h5b7b9e53g093bg4cccg9d98g654c3fe0b7f7"
msgid "What're you doing down in this cave?"
msgstr "이 동굴 아래에서 뭐하는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Player
#. NodeID = 6dd0a232-8290-ef4c-a6ae-7e4988697a36
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:6dd0a232-8290-ef4c-a6ae-7e4988697a36
msgctxt "h454cc8e4g2ac1g42bag80cag444735c9efae"
msgid "I don't think I'll be paying for anything. Bye for now!"
msgstr "내가 대가를 치를 일은 없는 것 같은데. 지금은 이만!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Player
#. NodeID = 6fe97e9a-9ce3-d911-934f-92f007b61f89
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Knows_KidsThieves = False
#.   Local:
#.      - 343c18e6-5c6c-cca5-84fa-74dceebbd4fb_WhatAreYouDoingHere = False
#. SetFlags:
#.   Local:
#.     - 343c18e6-5c6c-cca5-84fa-74dceebbd4fb_WhatAreYouDoingHere = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:6fe97e9a-9ce3-d911-934f-92f007b61f89
msgctxt "hea28f0d5g8970g42bbgbd2eg0107b433f5ba"
msgid "What're you doing down in this cave?"
msgstr "이 동굴 아래에서 뭐하는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 6feec443-1bb7-2e0d-7e90-97ea80436c63
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:6feec443-1bb7-2e0d-7e90-97ea80436c63
msgctxt "h11f61978g4f44g4f72gb781g372d4d47406d"
msgid "Is that right? Fine, you get one more chance."
msgstr "진짜야? 좋아, 기회를 한 번 더 주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 70a9ebc7-f1e8-8cce-14a5-e56f14c468e1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:70a9ebc7-f1e8-8cce-14a5-e56f14c468e1
msgctxt "h97e8931dg1d5dg4fd3ga01dgcb6abf3b24d6"
msgid "Foresight's the least of what we've got going, but thanks."
msgstr "이런 세상에서 사리에 밝은 건 기본 소양이지. 어쨌든 고마워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 76cf2ae4-8468-9a92-9740-13a322dd1ec3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:76cf2ae4-8468-9a92-9740-13a322dd1ec3
msgctxt "h778de003g765cg4188g8095g87358a39e4aa"
msgid "So what? Should we be panicking like everyone else?"
msgstr "그래서 어쩌라고? 우리도 다른 사람들처럼 겁에 질려야 해?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Player
#. NodeID = 7773da67-0752-e4ab-76ff-fc4f79e970c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:7773da67-0752-e4ab-76ff-fc4f79e970c9
msgctxt "h1ad968bfg2318g48bfg958dgcac97cb494e3"
msgid "I could help you get it, but my time's valuable to me."
msgstr "네가 그것을 입수하는 데 도움을 줄 수 있지만, 나에게 내 시간은 소중해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 78030de7-81a3-c564-56e5-a491b2af0d8b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:78030de7-81a3-c564-56e5-a491b2af0d8b
msgctxt "h41580291g7f13g4403gb767g62185e38fd87"
msgid "Making sure we're ready to leave when the time comes."
msgstr "때가 되면 떠날 준비가 되어 있는지 확인하고 있죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Player
#. NodeID = 7a1c1090-faca-532d-987b-def9aff41a80
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Hideout_Event_AskedForGoods(1) = True
#.   Global:
#.      - DEN_Thieflings_Knows_PlayerRobbed = True
#.      - DEN_Hideout_State_ResolvedThieflings = False
#.      - DEN_Thieflings_State_HoldingStolenGoods = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:7a1c1090-faca-532d-987b-def9aff41a80
msgctxt "h01c14508gaa2eg479ega3d4gd168105a44ff"
msgid "Looks like some of my possessions have gone 'missing'. Again."
msgstr "내 소지품 몇 개가 '실종'된 것 같아. 또 한 번 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 7b001d18-4d22-f418-71f0-ca26a6ce50fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:7b001d18-4d22-f418-71f0-ca26a6ce50fd
msgctxt "h803a59e9g24b8g4baag9a80geb4ced0c4a57"
msgid "You're a terrible liar. We had a deal."
msgstr "거짓말인 거 다 알아. 우린 거래하기로 약속했잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Player
#. NodeID = 7bce7135-a4f5-31c0-3519-6d575dc125e8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - LOLTHDROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:7bce7135-a4f5-31c0-3519-6d575dc125e8
msgctxt "h1116bf3ag0127g4839gb965g6e960ccee1c0"
msgid "If you don't get out of my way, I'll tear your spine out, whelp."
msgstr "내 앞에서 안 꺼지면 척추를 뽑아버린다, 좆만아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 7d1c8160-bfa3-7149-56d6-aeeceef1abfd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Hideout_Event_BefriendedThieflings = False
#. SetFlags:
#.   Object:
#.     - DEN_Hideout_State_GivenWarning(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:7d1c8160-bfa3-7149-56d6-aeeceef1abfd
msgctxt "hf320de4bgdbf4g4778ga901g7d7d04e4e953"
msgid "Then we're done here."
msgstr "그럼 볼일 끝났네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 7d73ee0e-f9ee-e6c7-51fe-9614e165de1f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:7d73ee0e-f9ee-e6c7-51fe-9614e165de1f
msgctxt "ha12ce3f0g0a63g4328gaa7bg739ce5c5d3f8"
msgid ""
"The bastards that killed Arabella. She was a precious little thing; like a "
"sister to me."
msgstr "아라벨라를 죽인 개자식들이야. 그 애는 작고 소중한 존재였어. 내게 동생 같은 애였다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 7e2626aa-0e1c-3b1f-1a7a-bc9b884a1f73
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Hideout_Event_TurnedKidsHostile = True
#.     - DEN_Hideout_Event_BefriendedThieflings = False
#.     - DEN_Thieflings_State_HoldingStolenGoods = False
#.   Object:
#.     - DEN_Hideout_State_GivenWarning(1) = True
#.     - DEN_Hideout_State_HostileThroughDialog(0) = True
#.   Quest:
#.     - DEN_Thieflings.DoneAngeredThieflings(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:7e2626aa-0e1c-3b1f-1a7a-bc9b884a1f73
msgctxt "h16abe3a9gdef2g42a7gadf4g94b0fac38e37"
msgid ""
"I'll go tell the guards you're pushing us around. See you around, chump."
msgstr "경비병들한테 네가 우릴 괴롭힌다고 전할게. 또 보자, 얼간아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Player
#. NodeID = 80be7425-600d-6a3e-56ae-416d8bc5bc9c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Hideout_Event_ShortCountdown = True
#.     - DEN_Hideout_Event_Count10 = True
#.     - DEN_Hideout_Event_Count9 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:80be7425-600d-6a3e-56ae-416d8bc5bc9c
msgctxt "h2ff43a7ag21a6g4906g8ff6g3c9304bfeccb"
msgid "You're joking, right?"
msgstr "지금 농담하는 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 83cf8c68-70fe-75af-a52a-03f367d47554
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Hideout_Event_ThankedForPickpocket = False
#.      - DEN_Hideout_Event_EasyOnPickpocket = True
#. SetFlags:
#.   Global:
#.     - DEN_Hideout_Event_ThankedForPickpocket = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:83cf8c68-70fe-75af-a52a-03f367d47554
msgctxt "h65bae8ecgc359g4a66g9c46g57a1c7aa1a93"
msgid ""
"And thanks for going easy on Silfy. Not many marks would've done the same."
msgstr "실피를 봐줘서 고마워. 표적이 그쪽처럼 반응하는 경우는 잘 없거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 841ff7fb-631a-5515-f441-e12f60347308
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:841ff7fb-631a-5515-f441-e12f60347308
msgctxt "ha0591ec8g005bg4f0dg9f0eg3270dcdab270"
msgid "<i>None of yours.</i>"
msgstr "<i>네 알 바 아니거든.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 84ee5fd0-a2b6-e345-3619-44f5c2f330c6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Hideout_Event_TurnedKidsHostile = False
#.      - DEN_Hideout_Event_BefriendedThieflings = True
#.   Party:
#.      - DEN_HideoutLeader_HasMet(1) = True
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_HasMet_Mol = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:84ee5fd0-a2b6-e345-3619-44f5c2f330c6
msgctxt "habfbc12dg342dg431dg8ee1gb36ba51c24e0"
msgid "I had a feeling you'd be back."
msgstr "다시 돌아올 줄 알았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 857172db-8812-5d31-e584-8682c6b21d0e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:857172db-8812-5d31-e584-8682c6b21d0e
msgctxt "h43402ab6ged09g498agb537gbb766d7567db"
msgid "You got your junk back. Take it and get out."
msgstr "네 고물 돌려받았잖아. 그거 갖고 꺼져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Player
#. NodeID = 88b7f779-2766-c7f1-3753-4591b07401ea
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Hideout_State_GivenWarning(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:88b7f779-2766-c7f1-3753-4591b07401ea
msgctxt "h8f4bd44ag393bg4062ga7efg856f6ac2fc0f"
msgid "I don't even know what your business is."
msgstr "나는 네 사업이 뭔지도 몰라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 890d97eb-289c-6867-01c2-48b92a7f1a0f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_HarpyMeal_Event_KidReturnHideout = True
#.      - DEN_Hideout_Event_ThankedForHarpyKid = False
#. SetFlags:
#.   Global:
#.     - DEN_Hideout_Event_ThankedForHarpyKid = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:890d97eb-289c-6867-01c2-48b92a7f1a0f
msgctxt "h7135da4cg1d13g43afgb65ag048a581ae2a3"
msgid ""
"Mirkon says you got him out of a tight spot with some harpies. Gotta say, "
"I'm impressed."
msgstr "미르콘 말로는 네가 하피들로 인해 곤경에 처한 그 애를 구해줬다던데. 감명 받았다고 해야겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 8a057a51-3ea8-6f2b-785c-24349e92823f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:8a057a51-3ea8-6f2b-785c-24349e92823f
msgctxt "h169e4dcfg28b1g4374gae0ag0634d0db5ba5"
msgid "Ugh, get out of my head!"
msgstr "으악, 내 머리 속에서 나가!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Player
#. NodeID = 8b5cef99-787b-daba-e04e-97523d8ec697
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Event_RefusedStealIdol = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:8b5cef99-787b-daba-e04e-97523d8ec697
msgctxt "h11775af3g159fg4eb2gb2cbg31718ea1809f"
msgid "Count me out - I'm not getting involved."
msgstr "나는 빼줘. 개입할 생각 없으니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Player
#. NodeID = 8d428368-639e-405a-ca24-f641842d3a5e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:8d428368-639e-405a-ca24-f641842d3a5e
msgctxt "h27934608g8a68g4753gb624g80ef9739b003"
msgid "You're right. I won't mess with any of your gang again. Promise."
msgstr "네 말이 맞아. 다신 네 패거리를 건드리지 않는다고 약속할게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 903611d8-4d82-7223-a1d1-d914088f2225
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Hideout_Event_LeaveCountdown = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:903611d8-4d82-7223-a1d1-d914088f2225
msgctxt "h9d2f3a78ga154g4664ga5b3gb709c2e56b4c"
msgid "Nine."
msgstr "9."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 9359058d-0e72-2ae9-70ac-8926431058b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:9359058d-0e72-2ae9-70ac-8926431058b3
msgctxt "h3dfb74cag9f77g4154g9b17g5b22dbd570ad"
msgid "A few things are missing from your pack. Is that right?"
msgstr "가방에 든 물건 몇 개가 없어졌을 거야. 그렇지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 95b9c512-29d2-0755-5504-dda9d41f5e51
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Party:
#.     - DEN_HideoutLeader_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:95b9c512-29d2-0755-5504-dda9d41f5e51
msgctxt "h5dc185f8gbbb6g483dg975cgea36e0c9a89a"
msgid "My kids say you've been busy since you got here."
msgstr "우리 애들이 네가 여기 와서 꽤나 바쁘게 지내고 있다고 하던데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 95ca2a51-c54c-d076-ae1d-748ad51e814d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_Hideout_Event_PriceRaised(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:95ca2a51-c54c-d076-ae1d-748ad51e814d
msgctxt "hc097c875gd65bg4ee9ga492g221869c96551"
msgid ""
"I forgot it went up a tenday ago. Anyway, pay up, and I'll see what I can "
"do. ([GEN_CheckMagicPocketGold_2_463b0f43-5410-412d-aba3-875cf81c38ca])"
msgstr ""
"열흘이나 지난 일은 잃어버리거든. 대신 내게 비용을 지불하면 방법을 찾아 볼게. "
"([GEN_CheckMagicPocketGold_2_463b0f43-5410-412d-aba3-875cf81c38ca])"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Player
#. NodeID = 97088bfa-9f27-2d5d-f581-a324abed1bdb
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:97088bfa-9f27-2d5d-f581-a324abed1bdb
msgctxt "h4b3f0882g564eg4e60g9988g75e7282df539"
msgid "Give me what's mine, or I'll rip your bloody tail off."
msgstr "내 걸 내놔. 안 그러면 망할 꼬리를 뽑아버리겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = 9ee294d1-0244-8db6-123f-4c1011d8c8f6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_KidGotAway = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:9ee294d1-0244-8db6-123f-4c1011d8c8f6
msgctxt "h491ba3d5g54a0g47daga321g0837bb745f21"
msgid "Still, you helped Meli get away from the adventurer."
msgstr "그래도, 넌 멜리가 모험가 놈한테서 벗어나는 걸 도왔어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = a7196c61-e7fd-8b9a-d545-f75c3afc30db
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Hideout_Event_AskedForGoods(1) = True
#.   Global:
#.      - DEN_Thieflings_Knows_PlayerRobbed = True
#.      - DEN_Thieflings_State_HoldingStolenGoods = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:a7196c61-e7fd-8b9a-d545-f75c3afc30db
msgctxt "h1589d67eg6bb1g4ab8g916cga614f325c55e"
msgid "Anyway. You want to talk? Talk."
msgstr "그건 그렇고. 대화하고 싶어? 말해 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = a8bf482f-bf96-ee5a-3022-3f93574b8197
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:a8bf482f-bf96-ee5a-3022-3f93574b8197
msgctxt "h1c37bfbfgf29dg4267ga771g3f8286ae70c7"
msgid "Why, you planning on telling me stealing is wrong?"
msgstr "왜, 도둑질은 잘못됐다고 말하려고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = aa606d72-3d69-a6c2-10b3-89928d809a2d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:aa606d72-3d69-a6c2-10b3-89928d809a2d
msgctxt "h481f5554gdcd6g433dga332g868fb7966665"
msgid "Anyway. You want to talk? Talk."
msgstr "그건 그렇고. 대화하고 싶어? 말해 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Player
#. NodeID = ad46902a-c8cf-2b53-c939-10a8aaaa72bd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Hideout_Event_AskedForGoods(1) = False
#.   Global:
#.      - DEN_Thieflings_Knows_PlayerRobbed = True
#.      - DEN_Hideout_State_ResolvedThieflings = False
#.      - DEN_Thieflings_State_HoldingStolenGoods = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Hideout_Event_AskedForGoods(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:ad46902a-c8cf-2b53-c939-10a8aaaa72bd
msgctxt "h114dd4e2g451ag4c38gaf73g152349de11ed"
msgid "I'm shy a few of my belongings - one of your associates robbed me."
msgstr "내 소지품 중 몇 개가 없어졌어. 너희들 중 한 명이 내게서 물건을 훔친 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Player
#. NodeID = ad967984-e8bb-f858-f54a-78cbf4d1061a
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 0
#. CheckFlags:
#.   Script:
#.      - GEN_CanDetectThoughts_2 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:ad967984-e8bb-f858-f54a-78cbf4d1061a
msgctxt "h17831a63gfa57g40e1gbd15gafb9f935d98e"
msgid "<i>Read her mind.</i>"
msgstr "<i>그녀의 생각을 읽는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = ae0a4598-0d01-10c9-4c4b-68b47e0d137a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_PlayerAdmittedPickpocketing = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:ae0a4598-0d01-10c9-4c4b-68b47e0d137a
msgctxt "h243468eeg1c27g41e1g8632g8145b0a17d8d"
msgid ""
"Still, you showed you're one of us by taking Mattis' ring. Never saw you "
"coming, did he?"
msgstr "그래도 넌 매티스의 반지를 가져가서 우리 중 하나임을 보여줬어. 매티스는 네가 올 줄 몰랐지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = aefde60f-5244-9c34-df54-6b0aff0572aa
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Hideout_Event_BefriendedThieflings = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:aefde60f-5244-9c34-df54-6b0aff0572aa
msgctxt "he7fe4b46g4d1eg4f8bg8c0egd7761b76c265"
msgid "Much appreciated. Let's take a look."
msgstr "이용해 주셔서 감사합니다. 어디 한번 볼까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = af70c154-75bb-41a3-4aaa-d4de300cd69d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:af70c154-75bb-41a3-4aaa-d4de300cd69d
msgctxt "h542379d4g8885g4633g9a1fgaf067fcf45ff"
msgid "Figures. Don't think you've got the stones for the job anyhow."
msgstr "예상대로네요. 차피 그쪽이 그럴 배짱이 있다고 생각하지도 않았어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Player
#. NodeID = b1fad902-318f-6ad5-6074-f6ba5a219e95
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:b1fad902-318f-6ad5-6074-f6ba5a219e95
msgctxt "h97a6e532g9ec0g4f12g967dg2aff3409bf45"
msgid ""
"I didn't mean to cause trouble for your people. Should have been more "
"careful."
msgstr "너희 애들에게 폐를 끼치려던 건 아니었어. 좀 더 조심했어야 했는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = b259b343-881b-8b15-a74c-efea613d9387
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:b259b343-881b-8b15-a74c-efea613d9387
msgctxt "h812ea2cag3f4cg4324ga462g1983369fbb44"
msgid "Because of that, I'll give you a ten-count to leave."
msgstr "그런 이유로, 나는 네게 떠날 수 있는 10초의 시간을 주겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = b2805376-9b77-316d-6a8b-ceac644188d7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_ReturnedStolenRing = True
#.      - DEN_Hideout_Event_ThankedForRing = False
#. SetFlags:
#.   Global:
#.     - DEN_Hideout_Event_ThankedForStealing = True
#.     - DEN_Hideout_Event_ThankedForRing = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:b2805376-9b77-316d-6a8b-ceac644188d7
msgctxt "h7cee692cgeca0g4165g876agf8602093cd7b"
msgid ""
"I appreciate you teaching Mattis a lesson, too. Kid should be more careful "
"with his rings."
msgstr "매티스에게도 교훈을 가르쳐줘서 고마워. 애들은 자신의 반지를 좀 더 조심해서 갖고 놀아야 돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = b30b8ac3-cb5d-3c74-7284-cf49fe50c555
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:b30b8ac3-cb5d-3c74-7284-cf49fe50c555
msgctxt "h8858e15fg8b39g43d2gb123g6be55ad0a5c3"
msgid "I want to steal that big shiny idol they're all chanting at."
msgstr "저들 모두가 주문을 외우고 있는 그 크고 빛나는 우상을 네가 훔쳤으면 좋겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = b4350685-b7b3-0d94-b06e-21ec728fb1b0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidFreed = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:b4350685-b7b3-0d94-b06e-21ec728fb1b0
msgctxt "hb74bf49bgf74fg4ebag82feg468759ebcf7c"
msgid ""
"You saw what those bastards that run the place were doing to Arabella. "
"Scaring the precious mite."
msgstr "이곳을 관리하는 개자식들이 아라벨라에게 무슨 짓을 했는지 봤을 거야. 가여운 애를 겁주면서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = b43c086f-7c65-d8de-8297-1e703c743031
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:b43c086f-7c65-d8de-8297-1e703c743031
msgctxt "hcbcbe4cbgd0f5g47ddgb005g5ff0fbdee995"
msgid "Now, you're going to pay for it."
msgstr "이제, 대가를 치러야 할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = b4d8f2a5-7c73-557a-b222-deb8b667e0a5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidFreed = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:b4d8f2a5-7c73-557a-b222-deb8b667e0a5
msgctxt "h30cb1208ge2f7g480cg94e4gb7dccc481b6a"
msgid "Still, you got Arabella out of that mess with the druids."
msgstr "그래도, 넌 아라벨라를 드루이드들이 있는 그 난장판에서 구했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = b5973841-a3db-69b8-acab-a7bc985204d5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:b5973841-a3db-69b8-acab-a7bc985204d5
msgctxt "h5d2a0593g5b66g43c7ga18cg012de9a6a5b4"
msgid "You think that's funny? Fine, laugh at <i>this</i>."
msgstr "내 말이 우스워? 좋아, <i>이것</i>도 한번 비웃어 보시지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Player
#. NodeID = b8127368-e3b5-9e50-ec10-8ff01b4e9e28
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Thieflings_State_HasIdol(1) = True
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Event_GaveMolIdol = True
#.   Object:
#.     - DEN_Thieflings_Event_TransferIdol(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:b8127368-e3b5-9e50-ec10-8ff01b4e9e28
msgctxt "h26fb24d0g719ag422dgb136g754c2fc4f69d"
msgid "Fine. Take it."
msgstr "좋아. 가져가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = b9c090e2-89ce-df7e-0e6a-e9dc1d14d9ec
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Hideout_Event_AskedForGoods(1) = False
#.   Global:
#.      - DEN_Thieflings_Knows_PlayerRobbed = True
#.      - DEN_Thieflings_State_HoldingStolenGoods = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:b9c090e2-89ce-df7e-0e6a-e9dc1d14d9ec
msgctxt "h4249ac3fg8558g4617g84dcge5c46050bb83"
msgid "And I hear you have a problem."
msgstr "너한테 문제가 생겼다고 들었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = bb320248-e077-b136-6468-cfd0fea51408
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:bb320248-e077-b136-6468-cfd0fea51408
msgctxt "h7365c8cbg346dg40fbgbccag9152f798d4e8"
msgid "Be careful. They look brittle as old bark, but they're vicious."
msgstr "조심해. 그놈들은 오래된 나무 껍질만큼 부서지기 쉬워 보이지만, 악랄한 녀석들이니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = bbc66f23-3990-368b-47b4-b18635de185d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:bbc66f23-3990-368b-47b4-b18635de185d
msgctxt "hdf1dd699g5292g4f46g81c9g565a13ed3b22"
msgid ""
"We have a plan. We're the ones who'll end up on top in the Gate. Anything "
"else?"
msgstr "우리는 계획이 있어. 우리는 발더스 게이트에서 성공할 거야. 또 필요한 건?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Player
#. NodeID = bc2d5900-95c4-26f6-3aac-48ffa1bcf69c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Hideout_Event_PriceRaised(1) = True
#.   Script:
#.      - GEN_CheckPocketGold_2 = True
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Event_PaidForReturn = True
#.   Object:
#.     - GEN_TransferNPCPayment(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:bc2d5900-95c4-26f6-3aac-48ffa1bcf69c
msgctxt "hfb0cdd97ge880g4866g89f3g0ea1758ec5b2"
msgid ""
"<i>Pay the fee.</i> ([GEN_CheckMagicPocketGold_2_463b0f43-5410-412d-"
"aba3-875cf81c38ca])"
msgstr ""
"<i>검사비를 낸다.</i> ([GEN_CheckMagicPocketGold_2_463b0f43-5410-412d-"
"aba3-875cf81c38ca])"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Player
#. NodeID = c247679a-1f9c-37ec-c896-6533df232248
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:c247679a-1f9c-37ec-c896-6533df232248
msgctxt "hff87372egfb8bg453ag8745ge0f944c60376"
msgid "You're pests, the lot of you. Stay out of my way, or else."
msgstr "너희들은 해충이야, 너희들 모두. 내 앞에서 꺼지지 않으면 후회할 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = c4882ba4-864e-845a-96b3-fe95b92d81d2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:c4882ba4-864e-845a-96b3-fe95b92d81d2
msgctxt "he1316e76gf460g4840gab1cga2298a63b8ac"
msgid ""
"The important thing is to get it away from <i>them</i>. That ritual's gonna "
"get us all killed."
msgstr "중요한 건 <i>그놈들</i>에게서 우상을 떨어뜨리는 거야. 그 의식은 우리 모두를 죽게 만들 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Player
#. NodeID = c6f73e22-9b91-ad1f-ee0c-5ae89767fb89
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:c6f73e22-9b91-ad1f-ee0c-5ae89767fb89
msgctxt "h1c3b31d5g87d4g4e06g84aag2bbf3411a0bf"
msgid "An idol? What'll you do with something like that?"
msgstr "우상? 그런 걸로 뭐할 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = c83d86c7-2073-4fdd-9392-ef7ba3996e54
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:c83d86c7-2073-4fdd-9392-ef7ba3996e54
msgctxt "h0fd6cbccg534dg4c09gbefbg20b38d0afa85"
msgid "We have that in common, then. But you aren't welcome <i>here</i>."
msgstr "그건 우리 둘의 공통점이네. 하지만 너는 <i>여기서</i> 환영받지 못해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Player
#. NodeID = cb48281e-ea6c-22b7-622b-5ee4911df78e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_RefusedStealIdol = False
#.      - DEN_Thieflings_Event_AgreedStealIdol = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:cb48281e-ea6c-22b7-622b-5ee4911df78e
msgctxt "h23b28f55g16bdg4d9dg99acg371243cb0eee"
msgid "Thought you might need help with something."
msgstr "네가 뭔가 도움을 필요해하는 것 같았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = cbaf473e-bcbe-85c3-b155-feac837873f5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_PlayerAdmittedPickpocketing = True
#.      - DEN_Hideout_Event_ThankedForStealing = False
#. SetFlags:
#.   Global:
#.     - DEN_Hideout_Event_ThankedForStealing = True
#.     - DEN_Hideout_Event_ThankedForRing = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:cbaf473e-bcbe-85c3-b155-feac837873f5
msgctxt "h805b8d25gf638g4e90g9f9ege180092471df"
msgid ""
"I appreciate you teaching Mattis a lesson, too. Kid should be more careful "
"with his rings."
msgstr "매티스에게도 교훈을 가르쳐줘서 고마워. 애들은 자신의 반지를 좀 더 조심해서 갖고 놀아야 돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = cf757495-14cc-fb78-198f-360c6f5ee4c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:cf757495-14cc-fb78-198f-360c6f5ee4c0
msgctxt "hd3d318c2g9289g4c7fg9bcdg9354d55d10ba"
msgid "Then I'm not looking for your stuff. That was easy. Anything else?"
msgstr "그럼 네 물건 살펴볼 필요 없겠네. 잘됐어. 아직 볼일 남았어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = d08b8a74-11de-232e-4145-2501c205374f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Hideout_Event_BefriendedThieflings = False
#.     - DEN_Thieflings_Event_RefusedGiveIdol = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:d08b8a74-11de-232e-4145-2501c205374f
msgctxt "h863acf85g548bg4163g9d8cg1c68a0f2c75c"
msgid "Fine. Hope the damn thing's cursed."
msgstr "좋아. 그 망할 물건에 저주나 깃들라지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = d74fad3d-131e-b079-a650-8e3c7719a39e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:d74fad3d-131e-b079-a650-8e3c7719a39e
msgctxt "h0e563ef0gaaf0g46b9g99adg90b4805591fc"
msgid ""
"And we can sell it once we get to the city. Thing like that's gotta be worth "
"a small fortune."
msgstr "그리고 우리가 일단 그 도시에 다다르면 우상을 팔 수 있어. 그런 물건은 값을 꽤 많이 쳐줄 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Player
#. NodeID = d76c909e-4f52-f211-593c-ab06896f23c4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Hideout_State_GivenWarning(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:d76c909e-4f52-f211-593c-ab06896f23c4
msgctxt "h0cb672b9ga0edg42f8gb672g7242fc7f75ee"
msgid ""
"Nothing piques my interest more than being told to stay away from somewhere."
msgstr "신경 끄라는 말보다 더 흥미를 자극하는 것은 없지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = d7e02898-9832-476b-4117-14e45a899e22
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Hideout_Event_TurnedKidsHostile = True
#.     - DEN_Hideout_Event_BefriendedThieflings = False
#.   Object:
#.     - DEN_Hideout_State_HostileThroughDialog(0) = True
#.   Quest:
#.     - DEN_Thieflings.DoneAngeredThieflings(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:d7e02898-9832-476b-4117-14e45a899e22
msgctxt "h7b8d8b4bg6474g4e6bgb243g165c48f72ab1"
msgid "I told you to leave. What happens next is your fault."
msgstr "나는 떠나라고 말했어. 네 잘못에 책임을 져야 할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Player
#. NodeID = da875279-54d0-f2a4-c96a-0588b582a714
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_AgreedStealIdol = True
#.      - DEN_Thieflings_Event_RefusedGiveIdol = False
#.      - DEN_GroveConflict_State_IdolIsMissing = True
#.      - DEN_Thieflings_Event_GaveMolIdol = False
#.   Object:
#.      - DEN_Thieflings_State_HasIdol(1) = True
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Event_GaveMolIdol = True
#.   Object:
#.     - DEN_Thieflings_Event_TransferIdol(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:da875279-54d0-f2a4-c96a-0588b582a714
msgctxt "hb40c3247gdd9dg4e0bg8355g9a980473babe"
msgid "The idol's all yours."
msgstr "우상은 이제 너희 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = dbe8c978-fe30-0d75-5b3b-8d5aff152d71
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_State_PCWasNiceToThieflingHideoutGuard = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:dbe8c978-fe30-0d75-5b3b-8d5aff152d71
msgctxt "hc7123351g6424g484ag8a57g7604d11116cb"
msgid "Still, one of my guards said you were nice to him."
msgstr "그래도, 내 경호원 한 명한테 친절하게 대해 줬다고 들었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = dc68a9cd-5fa5-6bf7-320e-682742af93e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:dc68a9cd-5fa5-6bf7-320e-682742af93e2
msgctxt "h0f8e934bgcf6dg4096gba14g2653730b913c"
msgid "Didn't need your permission, but fine."
msgstr "너의 허락도 필요 없거든. 하지만 알겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = dc8171a7-01ec-4cf6-63c4-a7ab8427a0a7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:dc8171a7-01ec-4cf6-63c4-a7ab8427a0a7
msgctxt "h13876e0egc467g40d9g8f10g2e5cce50d566"
msgid ""
"And we can sell it once we get to the city. Might be worth enough to pay a "
"priest to bring Arabella back."
msgstr ""
"그리고 우리가 일단 그 도시에 다다르면 우상을 팔 수 있어. 사제에게 돈을 줘서 아라벨라를 부활시켜달라고 할 수 있을 만큼의 값어치가 될 "
"거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Player
#. NodeID = dcb53d74-26de-0e9d-9028-38fb9814f93e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:dcb53d74-26de-0e9d-9028-38fb9814f93e
msgctxt "h52c53dd8g533eg48bfgb77cg33bddb2969d8"
msgid "Don't be ridiculous. I'm not giving you anything."
msgstr "뚱딴지같은 소리 마. 내가 동전 한 닢 주나 봐라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Player
#. NodeID = ddec8613-9551-77bc-5e32-143cbeeda5aa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Knows_KidsThieves = True
#.   Object:
#.      - DEN_Hideout_State_PurposeOfHideoutExplained(1) = False
#. SetFlags:
#.   Object:
#.     - DEN_Hideout_State_PurposeOfHideoutExplained(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:ddec8613-9551-77bc-5e32-143cbeeda5aa
msgctxt "hacdbc5d3gdcccg4e56gb789gadd7583a385c"
msgid "Why're you running all these schemes and swindles? Risky, you know."
msgstr "너희는 왜 이런 음모와 사기극을 벌이는 거야? 위험천만하잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = e1b3b4a2-9898-666c-8ab5-03c14e57034a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Thieflings_State_PCShookPickpocketSister = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:e1b3b4a2-9898-666c-8ab5-03c14e57034a
msgctxt "heeb92488g9121g490ag9e71gf82b1a1b4918"
msgid "You scared the life out of little Silfy."
msgstr "꼬맹이 실피를 죽도록 겁줬지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = e5226518-f8a1-2e63-c15b-58aaf2376a44
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:e5226518-f8a1-2e63-c15b-58aaf2376a44
msgctxt "hd21f2e90g35a0g434fg99f1g1434ea2c5218"
msgid "Not good enough."
msgstr "부족해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = e59ea90c-92ac-534b-3239-2bad332245e1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_Hideout_State_PurposeOfHideoutExplained(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:e59ea90c-92ac-534b-3239-2bad332245e1
msgctxt "ha7116959g1c6bg4a80g8936g9208fdc00ff5"
msgid "See you around, maybe."
msgstr "나중에 봐, 아마도."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = e7ac570d-514e-c2cc-152a-a3e11d6af622
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:e7ac570d-514e-c2cc-152a-a3e11d6af622
msgctxt "h4c158084g6d21g4113ga426g15301bdd06cc"
msgid "Maybe we can do something about this."
msgstr "어쩌면 이 문제를 우리가 해결할 수 있을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = e83fa49c-9273-709f-d3a5-a4ca4fcff843
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_KidGotAway = True
#.      - DEN_Hideout_Event_ThankedForRobberKid = False
#. SetFlags:
#.   Global:
#.     - DEN_Hideout_Event_ThankedForRobberKid = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:e83fa49c-9273-709f-d3a5-a4ca4fcff843
msgctxt "hf948f97agb850g4312ga1e6g6a233dc886dc"
msgid "I heard you helped Meli with that locket. I owe you for that."
msgstr "멜리가 로켓을 가질 수 있게 도와줬다고 들었어. 이거 신세를 졌군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = eb00fa14-42c3-54b7-853c-00b253110259
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Hideout_Event_BefriendedThieflings = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:eb00fa14-42c3-54b7-853c-00b253110259
msgctxt "hf9d3ad8ag44e8g40e2g92dcgeb6ef41e8f92"
msgid "You've been a friend to us. Come back any time."
msgstr "넌 우리 친구야. 언제든 돌아와."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = ee12b10c-a29a-78c9-7a3d-ebde247e2f99
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_State_DruidsPacified = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:ee12b10c-a29a-78c9-7a3d-ebde247e2f99
msgctxt "haa2c3fe3g5d4eg4240gbbb4gaed6619caf0b"
msgid "Nothing comes to mind. Always eager to accept donations, though."
msgstr "떠오르는 게 없네. 하지만 기부는 언제나 환영이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = f07dd257-c2d1-51b5-51cd-75bfd02f298c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_State_StolenGoodsTamperedWith = True
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Event_ReturnStolenGoods = True
#.     - DEN_Hideout_State_ResolvedThieflings = True
#.   Quest:
#.     - DEN_Thieflings.GivenSomeGoods(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:f07dd257-c2d1-51b5-51cd-75bfd02f298c
msgctxt "h761c4c1bg5a4cg4c8fga785g07d1e6bba1b3"
msgid ""
"We took this off you before. Some of it's missing, feels like. But there you "
"go."
msgstr "너한테서 벗겨 먹은 것들이야. 몇 개는 빠진 것 같은데, 어쨌든 여기 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = f16f97a3-05ce-f63d-858a-7c322fc2fd20
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Hideout_Event_BefriendedThieflings = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:f16f97a3-05ce-f63d-858a-7c322fc2fd20
msgctxt "hd4798524gb054g4f72gada5gdf37d2079470"
msgid "Come see me in the city sometime, huh? I'll repay this and then some."
msgstr "언젠가 도시에서 나를 찾아와, 응? 이자도 붙여서 보답할게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = f231256e-f09d-0e45-1275-e6084c07741b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_State_MessedWithMolsKids = False
#.     - DEN_Thieflings_State_CanTrespassInHideout = True
#.     - DEN_Hideout_Event_BefriendedThieflings = False
#.     - DEN_Hideout_State_MolAngryWithPlayer = True
#.   Object:
#.     - DEN_Hideout_State_PlayerWarnedToLeaveKidsAlone(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:f231256e-f09d-0e45-1275-e6084c07741b
msgctxt "h611b731fg30d4g4697gae9cg90fdf00f482b"
msgid "We're done here. Get lost."
msgstr "볼일 끝났어. 꺼져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Player
#. NodeID = f2c77e47-0f63-7ea4-216d-fbff885f49fe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Hideout_Event_PriceRaised(1) = False
#.   Script:
#.      - GEN_CheckPocketGold = True
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Event_PaidForReturn = True
#.   Object:
#.     - GEN_TransferNPCPayment(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:f2c77e47-0f63-7ea4-216d-fbff885f49fe
msgctxt "h54b26225g2276g4fb3g8c05g75863756dbf4"
msgid ""
"<i>Pay the fee. </i>([GEN_CheckMagicPocketGold_6057ad05-9492-4630-9f0a-"
"be548b134c54])"
msgstr ""
"<i>검사비를 낸다.</i> ([GEN_CheckMagicPocketGold_6057ad05-9492-4630-9f0a-"
"be548b134c54])"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = f505e95e-0f0d-43b8-7586-ec6e7750900b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:f505e95e-0f0d-43b8-7586-ec6e7750900b
msgctxt "h63919074g0232g41c4gae4agf35192a7fb26"
msgid "I do, as a matter of fact. Revenge."
msgstr "맞아. 사실은 말이지. 복수할 게 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = f5d01245-e912-ec65-a6c5-6f8db7e0ee33
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:f5d01245-e912-ec65-a6c5-6f8db7e0ee33
msgctxt "h171ee42fg1866g436aga79aga130033f0eef"
msgid "Is that a fact? I'll tell them to watch their step."
msgstr "그러셔? 애들한테 조심하라고 일러는 둘게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Player
#. NodeID = f62273ab-51cd-8ec9-1fc2-a7b5f2250b17
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#. TagRule: BERSERKER
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:f62273ab-51cd-8ec9-1fc2-a7b5f2250b17
msgctxt "hd3ad4fd3gc709g44b3g9666g92fe883db2ae"
msgid "<b>MINE. GIVE. <i>NOW.</i></b>"
msgstr "<b>내 거. 준다. <i>당장.</i></b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Player
#. NodeID = f62273ab-51cd-8ec9-1fc2-a7b5f2250b17
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:f62273ab-51cd-8ec9-1fc2-a7b5f2250b17
msgctxt "h8845ad00g7dc7g48fcg97cbg3b18d59f6d47"
msgid "Mine. <b>Now.</b>"
msgstr "내 거. <b>당장.</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = f73703fc-b4da-da5f-b7f3-8386b7eb2a56
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:f73703fc-b4da-da5f-b7f3-8386b7eb2a56
msgctxt "h0e4e4bf2gef0cg4a9fg88dbg03f03ae0fe0d"
msgid ""
"Ready to pay that inspection fee now? "
"([GEN_CheckMagicPocketGold_6057ad05-9492-4630-9f0a-be548b134c54])"
msgstr ""
"그럼 검사 비용 지불할 준비는 됐어? ([GEN_CheckMagicPocketGold_6057ad05-9492-4630-9f0a-"
"be548b134c54])"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = fa91f8f4-2040-6937-a0b3-0558b1fb1a76
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Hideout_Event_TurnedKidsHostile = True
#.     - DEN_Hideout_Event_BefriendedThieflings = False
#.     - DEN_Thieflings_State_HoldingStolenGoods = False
#.   Object:
#.     - DEN_Hideout_State_GivenWarning(1) = True
#.     - DEN_Hideout_State_HostileThroughDialog(0) = True
#.   Quest:
#.     - DEN_Thieflings.DoneAngeredThieflings(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:fa91f8f4-2040-6937-a0b3-0558b1fb1a76
msgctxt "h8ce23db2g35feg41baga525g3701da3e0dd3"
msgid "What comes next is on you."
msgstr "네 실수에 책임을 져야 할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = face8cd6-e014-9fa4-43d1-2261795d2d82
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Hideout_Event_BefriendedThieflings = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:face8cd6-e014-9fa4-43d1-2261795d2d82
msgctxt "hb69e7964gd485g4da5ga988g1b727484f977"
msgid ""
"Maybe one of the kids picked up something of yours by mistake. I couldn't "
"say."
msgstr "우리 애들 중 하나가 어쩌다 그쪽 소지품을 주웠는지도 모르지. 난 모르는 이야기야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = fb4de9ba-d54e-42a0-76b2-6717f56d09a4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Hideout_Event_TurnedKidsHostile = True
#.     - DEN_Hideout_Event_BefriendedThieflings = False
#.   Object:
#.     - DEN_Hideout_State_HostileThroughDialog(0) = True
#.   Quest:
#.     - DEN_Thieflings.DoneAngeredThieflings(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:fb4de9ba-d54e-42a0-76b2-6717f56d09a4
msgctxt "h667bd74dg8cd2g4144ga01bgc2c7d507467a"
msgid "Fine, then. What happens next is your fault."
msgstr "좋아, 그럼. 이제부터 일어나는 일은 네 잘못이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = fc93a997-bace-82e4-3dbc-7eb695645dd1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:fc93a997-bace-82e4-3dbc-7eb695645dd1
msgctxt "h97bc40f9g3487g464egab46g89ad9608d494"
msgid "No, no. Like this:"
msgstr "아냐, 아냐. 이렇게:"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Player
#. NodeID = fcc60966-efc4-eb14-59f6-8cb4c3de08cb
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Event_AgreedStealIdol = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:fcc60966-efc4-eb14-59f6-8cb4c3de08cb
msgctxt "hc677d41dg69e7g4697gb712g33f5b32929a3"
msgid "I'll see what I can do."
msgstr "뭔가 방법을 찾아 볼게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = fd5fc044-020e-61e5-79e7-74fdae9ca4a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:fd5fc044-020e-61e5-79e7-74fdae9ca4a3
msgctxt "h9fa753e0g0e40g48c4g8551g2c52d6be27a9"
msgid ""
"...Fine. But make any more trouble for us and you'll regret it, drow or not."
msgstr "...좋아. 경고하는데 드로우든 좆이든 또 다시 우리 애들을 괴롭히면 재미없을 줄 알아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = fe7edcd3-63c9-a371-bba6-1b8d94073912
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Hideout_Event_TurnedKidsHostile = False
#.      - DEN_Hideout_State_ResolvedThieflings = False
#.      - DEN_Thieflings_State_HoldingStolenGoods = True
#.      - DEN_Hideout_State_MolAngryWithPlayer = False
#.   Party:
#.      - DEN_HideoutLeader_HasMet(1) = True
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_HasMet_Mol = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:fe7edcd3-63c9-a371-bba6-1b8d94073912
msgctxt "ha7621226g3cb9g4d96g8c38ga3308dea1bea"
msgid "Had a feeling you'd be back."
msgstr "어쩐지 돌아올 것 같더라니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001
#. Speaker = Mol
#. NodeID = fe8bc318-cf9f-782a-318b-16ed988cca7d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_HideoutKid_001:fe8bc318-cf9f-782a-318b-16ed988cca7d
msgctxt "hf8a73c35g6ef1g4bdaga47cg80860007dd77"
msgid "<i>Nobody messes with my family - I'm all they've got.</i>"
msgstr "<i>아무도 내 가족을 건드리지 못해 - 얘들한테는 나 밖에 없어.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 018c098a-9bac-7efd-4088-44ae9cc07ac6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:018c098a-9bac-7efd-4088-44ae9cc07ac6
msgctxt "h8967821bg813bg4020g9853gdb1d07f55445"
msgid ""
"If you're lying to me, I'll rip those horns off your adorable little head."
msgstr "거짓말이라면 네 귀엽고 작은 머리에서 그 뿔을 뜯어내 줄 테야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 02a0b430-8fd3-185f-e2d3-6e1b4b9e51db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:02a0b430-8fd3-185f-e2d3-6e1b4b9e51db
msgctxt "hda332b19gd636g4478ga273g82c6749dc17f"
msgid "Heads it is!"
msgstr "앞면이네요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 034651d4-26fd-5e58-2373-47efdab5daeb
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_Thieflings_Event_TransferPickpocketRing(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:034651d4-26fd-5e58-2373-47efdab5daeb
msgctxt "h42421198g8317g4a03g8f56g288ce107907f"
msgid "Fine. Take the ring. I just want to trade."
msgstr "좋아. 이 반지 가져가. 나는 거래를 원할 뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 0435b1c1-f8ee-8ce2-ec00-ba0b41529698
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_State_RippedOffPickpocketKid = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Pickpocket1_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:0435b1c1-f8ee-8ce2-ec00-ba0b41529698
msgctxt "h16aae179g6dbag4e4fg8554g9234920c5d69"
msgid "I don't talk to dead scabs, scab. Keep moving."
msgstr "난 죽은 딱지랑은 얘기 안 해, 딱지야. 계속 움직여."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 0698708d-3db5-a590-0029-d0db76d040cc
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:0698708d-3db5-a590-0029-d0db76d040cc
msgctxt "hd83206aag3afag4051g835agb5bcbd8ca98b"
msgid "She <i>what</i>? Blood and rust, lady. What'd you do?"
msgstr "걔가 <i>뭐라고요</i>? 세상에, 아가씨. 뭘 어떻게 했길래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 0698708d-3db5-a590-0029-d0db76d040cc
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:0698708d-3db5-a590-0029-d0db76d040cc
msgctxt "hf676b3f8g7c3ag44ccg80f8g18ce97144e99"
msgid "She <i>what</i>? Blood and rust, mister. What'd you do?"
msgstr "걔가 <i>뭐라고요</i>? 세상에, 아저씨. 뭘 어떻게 했길래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 0698708d-3db5-a590-0029-d0db76d040cc
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:0698708d-3db5-a590-0029-d0db76d040cc
msgctxt "h6b9347d5gf4cdg4064ga566g3721fc7a44c0"
msgid "She <i>what</i>? Blood and rust. What'd you do?"
msgstr "걔가 <i>뭐라고요</i>? 세상에. 뭘 어떻게 했길래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 06fc8340-a19d-1d10-18b2-aa455ac5e27e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Event_MerchantKidLeaves = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:06fc8340-a19d-1d10-18b2-aa455ac5e27e
msgctxt "hb682af51g7eddg45c6ga7bfg1c4db50ae73e"
msgid "<i>Leave. </i>"
msgstr "<i>떠난다. </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 077fe022-edac-7b55-405e-d9408667a711
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:077fe022-edac-7b55-405e-d9408667a711
msgctxt "h34feabe2g1989g4dd6gae0ag87a780d2c324"
msgid "Come back any time!"
msgstr "언제든 다시오세요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 07d3dc08-28ec-e366-4451-299e9a8d0e32
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:07d3dc08-28ec-e366-4451-299e9a8d0e32
msgctxt "hacf8a382g0010g4949g88f4g02a15f9774b8"
msgid "Hey, hold on. You gotta pay for that!"
msgstr "이봐요, 멈춰요. 비용은 지불하셔야죠!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 0814fd6f-450b-fb82-5719-65e36139b7b7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:0814fd6f-450b-fb82-5719-65e36139b7b7
msgctxt "h701ec0a0g222eg4f68ga0c0g0471c325d409"
msgid "Hey, hold on. You gotta pay for that!"
msgstr "이봐요, 멈춰요. 비용은 지불하셔야죠!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 08ae636c-c267-f106-55f2-2a94e87ce503
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:08ae636c-c267-f106-55f2-2a94e87ce503
msgctxt "h4acbefbbgca42g4854gbf30g75205d5a410f"
msgid "That's very forgiving of you."
msgstr "정말 너그럽군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 09583bee-6fda-24b3-5697-60b27909d8fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:09583bee-6fda-24b3-5697-60b27909d8fe
msgctxt "hcc085a9cgcff4g494bgaec3ga8c77ae74f18"
msgid "Let me see what you have."
msgstr "네가 갖고 있는 것을 보여줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Narrator
#. NodeID = 0ac5fce8-626c-8213-1beb-43320ca7b562
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_PlayerRobbed_Twice = False
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Knows_PlayerRobbed = True
#.   Quest:
#.     - DEN_Thieflings.DiscoveredRobbed(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:0ac5fce8-626c-8213-1beb-43320ca7b562
msgctxt "h5bc870d9g4ca8g40f2g97e7gdc2887c8df3f"
msgid "*You were just <i>robbed.*</i>"
msgstr "*당신은 방금 <i>소매치기 당했습니다.*</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 0b0e983e-07b5-6c7f-859f-61b2bf3be3e8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:0b0e983e-07b5-6c7f-859f-61b2bf3be3e8
msgctxt "h51cf21a0g4575g46cag92a4g416ae54d3f7a"
msgid "Heads it is!"
msgstr "앞면이네요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 0b0e983e-07b5-6c7f-859f-61b2bf3be3e8
#. HandlePath = TaggedText[0].TagText[1]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:0b0e983e-07b5-6c7f-859f-61b2bf3be3e8
msgctxt "h7e0b45dfga2f6g40c5g8e0aged0bee3e00ef"
msgid "Heads!"
msgstr "앞면!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 0b0e983e-07b5-6c7f-859f-61b2bf3be3e8
#. HandlePath = TaggedText[0].TagText[2]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:0b0e983e-07b5-6c7f-859f-61b2bf3be3e8
msgctxt "h317118a4g7b19g41c1gb334g55cee35e7b5b"
msgid "We have heads!"
msgstr "앞면이 나왔군요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 0b0e983e-07b5-6c7f-859f-61b2bf3be3e8
#. HandlePath = TaggedText[0].TagText[3]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:0b0e983e-07b5-6c7f-859f-61b2bf3be3e8
msgctxt "h9cd54b9bg6d01g49f9gbefbg4753c3d95895"
msgid "Heads it is!"
msgstr "앞면이네요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 0b46b6fd-cb18-8d27-7793-0ccf98f2cee8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ROGUE(1) = True
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Knows_KidsThieves = True
#.     - DEN_Thieflings_Knows_LimsRingGameIsAScam = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:0b46b6fd-cb18-8d27-7793-0ccf98f2cee8
msgctxt "ha00c7386gac72g4500gb5ebgb2359e0116c5"
msgid "Did you really think you could fool me?"
msgstr "정말로 나를 속일 수 있을 것이라 생각했어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 0b546767-0790-ffef-b315-f3eb3b858dcb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ROGUE(1) = True
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Knows_KidsThieves = True
#.     - DEN_Thieflings_Knows_LimsRingGameIsAScam = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:0b546767-0790-ffef-b315-f3eb3b858dcb
msgctxt "h129f9257g05e7g4863g969bg205509c21344"
msgid "You can drop the act."
msgstr "연기는 그만두지 그래."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 0c2088c7-fb1f-5b3c-b7c1-8b303e705500
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:0c2088c7-fb1f-5b3c-b7c1-8b303e705500
msgctxt "he2d6e529g4c32g4376gb585gd677164cdc1f"
msgid "Huh. Don't think anyone's ever apologised for stealing my stuff before."
msgstr "허. 제 물건을 훔친 것을 사과할 사람이 있을 줄은 몰랐어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 0c7abe15-b517-e4e2-e310-d8af72ba7132
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:0c7abe15-b517-e4e2-e310-d8af72ba7132
msgctxt "h5b59135fg445dg4e39g8591g54f12ed2ab0a"
msgid "They look nice. You look nice. It was just a guess."
msgstr "엘프는 멋지잖아요. 당신도 멋져요. 그냥 추측이었어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 0d49430c-4ce7-e80b-6253-c3a8fa78fcb7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:0d49430c-4ce7-e80b-6253-c3a8fa78fcb7
msgctxt "haae2ef50gca6bg4e00g87d4g07db79f2b40b"
msgid "Oh. Okay..."
msgstr "오. 그래요..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 0d76aa0b-71ab-5b4d-4b77-689c03d99ea0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:0d76aa0b-71ab-5b4d-4b77-689c03d99ea0
msgctxt "h107b25f0g0272g4a50g97e5g9a68af99e813"
msgid "Anyways, you gotta call before the flip. Heads or tails?"
msgstr "어쨌든, 뒤집기 전에 맞춰보세요. 앞면 혹은 뒷면?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 0e064a29-d5b8-de56-12e6-f5209759c03b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Thieflings_State_HasPickpocketRing(0) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_TriedRingScamOn(1) = True
#.   Global:
#.     - DEN_Thieflings_State_KeptMagicRing = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:0e064a29-d5b8-de56-12e6-f5209759c03b
msgctxt "h96b5214ag5c46g4fecgaea3g37e79108ef89"
msgid "Uh... blood and rust. Someone stole the damn ring!"
msgstr "엇... 제기랄. 누가 그 망할 반지를 훔쳤어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 0ee5f481-8f99-5565-d618-62a73ef853f5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Pickpocket1_PCAttemptedTheftBefeoreCoinFlip(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:0ee5f481-8f99-5565-d618-62a73ef853f5
msgctxt "h5cacb14ag681fg4120gbc04gbfab009b39eb"
msgid "I am indeed. I've got a free ring."
msgstr "그래. 나는 공짜 반지를 얻었으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 0ef71c1d-ef88-89c8-5cef-ca8eb1cad895
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:0ef71c1d-ef88-89c8-5cef-ca8eb1cad895
msgctxt "h3b9a0328gfec3g485dg8911gb28f2d3de8d2"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 0fcf54ef-865d-5e15-141d-d5949743a794
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SELDARINEDROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:0fcf54ef-865d-5e15-141d-d5949743a794
msgctxt "h227b7a8bg246fg4b97gaea8g3db063fd28bb"
msgid ""
"You're thinking of the Lolth-sworn. Should you see a pair of red eyes? Run."
msgstr "롤쓰 스원을 생각하고 있군. 만약 네가 붉은 눈을 보게 된다면? 도망쳐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 102258c2-0342-7bb1-c623-037da620735a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:102258c2-0342-7bb1-c623-037da620735a
msgctxt "h85f87a00g43feg4835g9c23ge91e86b6c51c"
msgid "Maybe it's how this one worked?"
msgstr "아마도 이건 그렇게 작동하는 방식일지도?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 105bd22a-813a-1d61-1fd0-3b2501eab41a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:105bd22a-813a-1d61-1fd0-3b2501eab41a
msgctxt "h0b15a747g763dg4a0fg8b45gc586d789af53"
msgid "Really. Good thing we met, then!"
msgstr "정말이에요. 그러면 우리가 만나서 다행인 거네요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 125671bc-1ad0-0205-45a5-ba70668a86db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:125671bc-1ad0-0205-45a5-ba70668a86db
msgctxt "h212824c0g98d1g4603g810cg831c4923665a"
msgid "Well, what you think? Good stuff, right?"
msgstr "무슨 생각하세요? 좋은 물건이죠, 그렇죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 131b0277-995f-19b2-53a9-14de03a2cfd0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 92b550ec-6255-fa14-7f65-abf7d2dd0ed7_5 = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:131b0277-995f-19b2-53a9-14de03a2cfd0
msgctxt "h7b3b0fa5g43acg4ed5g8305g9f0255bc642a"
msgid "Not yet. Flip the coin again."
msgstr "아직. 동전을 다시 던져봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 1456f1a4-928d-61de-e006-e67d7441be91
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:1456f1a4-928d-61de-e006-e67d7441be91
msgctxt "h228d6c6ag23ccg4dacg8b47g417747a6a743"
msgid ""
"Look, you caught her. Good for you, you aren't a chump like everybody else "
"around here."
msgstr "저기, 도중에 눈치채셨잖아요. 그쪽한텐 좋은 일이죠. 여기 있는 다른 모두 같은 얼간이가 아니라는 거니까요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 167d5522-f0ae-37ca-e641-281eb2b00b04
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_Thieflings_Event_TransferPickpocketRing(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:167d5522-f0ae-37ca-e641-281eb2b00b04
msgctxt "h7a3fbd84g09e1g4edagafd2gc2aeb5e91b77"
msgid "<i>Take the ring. </i>"
msgstr "<i>반지를 가져간다. </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 171706bf-5344-8a6d-2c4b-b0cb07fb0fb9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:171706bf-5344-8a6d-2c4b-b0cb07fb0fb9
msgctxt "h87239548g2e86g4952g8e17g8959989decc7"
msgid "I should remove one of your sister's fingers - as a lesson."
msgstr "네 여동생 손가락 하나를 잘라내야겠어. 교훈 삼아서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 18440f90-0271-ee05-7d05-ae6f287d2eeb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:18440f90-0271-ee05-7d05-ae6f287d2eeb
msgctxt "he3b621beg5a77g481bgb2efg57f81951b3de"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 18873dea-ffe5-2b87-d715-0223f51d4196
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:18873dea-ffe5-2b87-d715-0223f51d4196
msgctxt "hc58b416dg62deg4309g8b33gbff196284a30"
msgid "I just wanted to support a young businessman."
msgstr "난 그저 어린 사업가를 응원하고 싶었을 뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 18aa6cfc-f365-ef2c-bec1-a10ff6398e00
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Hideout_State_GivenWarning(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Event_ToldAboutHideoutLeader(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:18aa6cfc-f365-ef2c-bec1-a10ff6398e00
msgctxt "h71899c9dg9ccdg429eg8d02g599bbee7205b"
msgid "Her office is through the crack in the wall over there, if you can fit."
msgstr "걔 거처는 저기 벽의 틈으로 들어가면 있을 거예요. 만약 선생님이 들어갈 수 있다면 말이죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 1b2c9947-9343-8620-44ab-2e2086b8ebaf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:1b2c9947-9343-8620-44ab-2e2086b8ebaf
msgctxt "h2e9666f6g34dag4135gb059gd3ebb4763c3f"
msgid "Yeah? Me too. And if you want your stuff back, you gotta talk to her."
msgstr "그래요? 저도요. 그리고 당신 물건을 돌려받고 싶으면, 그녀에게 말해야 해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 1b7bed5a-0c18-6aec-04dd-d26363d1278e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:1b7bed5a-0c18-6aec-04dd-d26363d1278e
msgctxt "h73149e3dge0bbg49e9ga45fgd2ea57b2b665"
msgid "Uh huh..."
msgstr "아하..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 1d4acbf0-3e25-e961-b7ad-8d3d59a826b9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:1d4acbf0-3e25-e961-b7ad-8d3d59a826b9
msgctxt "h3612aebegaf4cg4376g9aaegf5260073b437"
msgid "If you touch my pack again, I'll pull your horns off. Slowly."
msgstr "다시 내 짐을 건드렸다간, 네 뿔을 뽑아버릴 거야. 천천히."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 1ee54cdf-031b-0596-6e0f-ca2b33ba617e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Pickpocket1_PCIsNotAChump(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:1ee54cdf-031b-0596-6e0f-ca2b33ba617e
msgctxt "h5c13635bge14eg4c19ga581g54a12360bcab"
msgid "So move along, okay? Make room for the real chumps."
msgstr "그러니까 가요, 네? 진짜 얼간이들 오게 비켜달라고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 1f75bbcc-d784-c9d2-1f03-7a971dc7aa5d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:1f75bbcc-d784-c9d2-1f03-7a971dc7aa5d
msgctxt "h94554688g3330g4611gbc49ga23b7b31c93c"
msgid ""
"I wish I had better things to sell than... trinkets, but it's all I have!"
msgstr "이런 장신구보다 좋은 걸 팔 수 있었으면 좋겠지만... 이게 제가 가진 전부라구요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 201284dc-4fe3-b92f-8cbe-493aca2bccdc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ROGUE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:201284dc-4fe3-b92f-8cbe-493aca2bccdc
msgctxt "h737f6068ge170g45aaga03ag04e07edb35c3"
msgid "Is your boss part of the thieves' guild?"
msgstr "너의 대장은 도둑 길드의 일원인가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 20407874-b116-1c22-fdeb-cf4a69f8b5ee
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Pickpocket1_CoinGame1(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Pickpocket1_CoinGame2(1) = True
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:20407874-b116-1c22-fdeb-cf4a69f8b5ee
msgctxt "he999224fg0a9bg405ag8238g16ae04ac7351"
msgid "Lady, come on. Okay. Heads or tails?"
msgstr "숙녀분, 제발요. 알았어요. 앞면 혹은 뒷면?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 20407874-b116-1c22-fdeb-cf4a69f8b5ee
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Pickpocket1_CoinGame1(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Pickpocket1_CoinGame2(1) = True
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:20407874-b116-1c22-fdeb-cf4a69f8b5ee
msgctxt "hde51939aga0deg4f4ag9ee3gfefae905d914"
msgid "Mister, come on. Okay. Heads or tails?"
msgstr "신사분, 제발요. 알았어요. 앞면 혹은 뒷면?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 20407874-b116-1c22-fdeb-cf4a69f8b5ee
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Pickpocket1_CoinGame1(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Pickpocket1_CoinGame2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:20407874-b116-1c22-fdeb-cf4a69f8b5ee
msgctxt "hdd080dbagefb3g4350g91c4g29fb3d2032fa"
msgid "Oh, come on. Okay. Heads or tails?"
msgstr "제발요. 알았어요. 앞면 혹은 뒷면?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 204be25a-c0bc-797b-bf9e-e27d4ea01100
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:204be25a-c0bc-797b-bf9e-e27d4ea01100
msgctxt "hb4f98a54g1ca7g480ag811bg6388a730a96c"
msgid "Us too! No one says anything nice about tieflings."
msgstr "우리도요! 아무도 티플링에 대해 좋은 말을 하지 않아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 20c870bb-3b14-1cf9-5b09-8fbe78bbb574
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:20c870bb-3b14-1cf9-5b09-8fbe78bbb574
msgctxt "h7ff53d73g24f8g4236gb303g267ef01c74bc"
msgid "Sure. I'll have a look."
msgstr "그래. 한번 볼게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 21d6e9b9-03a3-09e1-1e78-343241e91917
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:21d6e9b9-03a3-09e1-1e78-343241e91917
msgctxt "h69359ee6g9e71g4f60ga88eg3fa1f93bb6df"
msgid "Here's what I got."
msgstr "여기 내가 가지고 있는 것들이죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 2256732d-96f6-f7b9-6580-2e046cc6f1dc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:2256732d-96f6-f7b9-6580-2e046cc6f1dc
msgctxt "h5fc4d1edgbd26g41eegb7f3gad52ad934fa8"
msgid "Have you no honour, hell child?"
msgstr "명예도 없는 거니, 지옥의 꼬마야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 22832a7e-e165-a676-1abd-3f5d0d1f76fc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_Thieflings_Event_CheckKnowsHideout(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:22832a7e-e165-a676-1abd-3f5d0d1f76fc
msgctxt "hadcb4c69gc671g46cdg86c6gc7a4937da1fe"
msgid "Good. Mol's office is through the crack in the wall over there."
msgstr "좋아요. 몰의 거처는 저 벽의 틈으로 들어가면 있을 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 2289b7d6-43b9-4914-4c33-ad6ebde5140f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Thieflings_State_HasPickpocketRing(1) = True
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_State_MessedWithMolsKids = False
#.     - DEN_Thieflings_Event_ReturnedStolenRing = True
#.     - DEN_Hideout_Event_BefriendedThieflings = True
#.     - DEN_Thieflings_State_RippedOffPickpocketKid = False
#.   Object:
#.     - DEN_Thieflings_Event_TransferPickpocketRing(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:2289b7d6-43b9-4914-4c33-ad6ebde5140f
msgctxt "h9f488dddg53a8g4bb0ga2dbg5663f72415d0"
msgid "I'm sorry for taking your ring. Here you go."
msgstr "반지를 가져간 건 미안하게 됐어. 여기 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 2478471c-cd85-133f-1da5-959e3efcdc51
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 92b550ec-6255-fa14-7f65-abf7d2dd0ed7_5 = False
#. SetFlags:
#.   Object:
#.     - DEN_Thieflings_Event_TransferPickpocketRing(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:2478471c-cd85-133f-1da5-959e3efcdc51
msgctxt "hdd1ea9a8ge5bcg42abg98c5g6496513c202a"
msgid "Here. Take your ring back. I want to see your wares."
msgstr "여기. 네 반지 도로 가져가. 네 물건을 보고 싶군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 25a9a6d4-d29e-ba82-3d67-1db0dbbf0029
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Knows_PlayerRobbed = True
#.      - DEN_Hideout_State_ResolvedThieflings = False
#.      - DEN_Thieflings_Event_CaughtThief = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Pickpocket1_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:25a9a6d4-d29e-ba82-3d67-1db0dbbf0029
msgctxt "hb58497c3g480fg4fc1gbc5dg4f21eba33183"
msgid "Uh, hey. You here to trade or..."
msgstr "어, 저기. 거래하러 오신 건지 아니면..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 2636134e-24fe-5f6a-8e86-0f6555d026d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:2636134e-24fe-5f6a-8e86-0f6555d026d9
msgctxt "hb5c5e97egb07bg4a7ag9ea4g964d4a1f8ec4"
msgid "While I'm here, could we trade?"
msgstr "내가 여기 있으니, 우리 거래할까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 282cb823-e397-cc09-0668-fc5b8acd3c4e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Dexterity
#. DifficultyClass: 15
#. SetFlags:
#.   Object:
#.     - DEN_Thieflings_Event_TransferPickpocketRing(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:282cb823-e397-cc09-0668-fc5b8acd3c4e
msgctxt "he2ded592g6094g4034gb1a1g0526f69e7971"
msgid "<i>Mimic his trick and make the ring disappear.</i>"
msgstr "<i>그의 속임수를 흉내 내서 반지를 사라지게 한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 283ca659-a43f-d743-2f94-1a1ca1195ac6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:283ca659-a43f-d743-2f94-1a1ca1195ac6
msgctxt "hc468d1b4g5cbeg450fg87b4ga5f61ea9348e"
msgid "Just take the ring, huh? Free sample."
msgstr "그냥 이 반지 가져가세요, 네? 무료 견본이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 2875159f-36f2-ec87-bd35-040f675aadf2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:2875159f-36f2-ec87-bd35-040f675aadf2
msgctxt "hd7c9bfe1g6f49g415fg8ff1g100c3bff8c87"
msgid "Well, thanks for the honesty, I guess."
msgstr "뭐, 솔직함에 감사해요, 아마도."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 28d6da54-bf8b-656b-9918-2f54df86b18c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:28d6da54-bf8b-656b-9918-2f54df86b18c
msgctxt "h370926f8g9507g4351g898dg26d981c41f2a"
msgid "Tails it is!"
msgstr "뒷면이네요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 29584a6a-89e6-3c79-715e-9d0246fe825f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:29584a6a-89e6-3c79-715e-9d0246fe825f
msgctxt "hf9acc18cgce98g45efgb849g956d579c169a"
msgid ""
"You know what? Forget your junk. You got bigger problems if you pissed off "
"Mol."
msgstr "그거 아세요? 선생님 물건은 잊어버리세요. 몰을 화나게 하면 더 큰 문제가 생길 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 2ab6fc9c-bd36-ee3b-9b0a-41f075f40bec
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:2ab6fc9c-bd36-ee3b-9b0a-41f075f40bec
msgctxt "h7dca2db3g794bg49c7g88c6gedd5eaf6fe1c"
msgid "A warning? Where I come from, thieves are punished - harshly."
msgstr "경고라고? 내가 온 곳에서는, 도둑질을 하면 아주 가혹한 처벌을 받지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 2b7cd846-1d64-4043-a440-95f272a899bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:2b7cd846-1d64-4043-a440-95f272a899bf
msgctxt "h07173088g7c24g4eabgb723g719dd3403071"
msgid "I dunno. You don't look <i>that </i>scary."
msgstr "잘 모르겠어요. <i>그렇게 </i>무섭게 생기진 않으신걸요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 2d4e21d0-de0b-9dfa-f4b5-356eecf726ac
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Event_ToldAboutHideoutLeader(1) = False
#.   Global:
#.      - DEN_Thieflings_Knows_PlayerRobbed = True
#.      - DEN_Thieflings_Event_PlayerRobbed = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:2d4e21d0-de0b-9dfa-f4b5-356eecf726ac
msgctxt "h0436a7e6geaf2g4963g9136g319855c15ae7"
msgid "Have you taken something? Something that doesn't belong to you?"
msgstr "물건을 가져갔니? 원래 네 것이 아니었던 물건을?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 2d6fd1bc-475c-9179-ad20-f65d79a6534f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:2d6fd1bc-475c-9179-ad20-f65d79a6534f
msgctxt "h2b0bacbdg7c88g4451g84ebg23446589cfd9"
msgid ""
"Find yourself another line of work. Second-rate pickpockets tend to lose "
"their hands."
msgstr "다른 일을 찾아보는 게 좋을 거야. 소매치기범의 절반은 자기 손을 잃거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 2de16988-d310-759c-1c27-f6b51a43e011
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_Thieflings_Event_TransferPickpocketRing(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:2de16988-d310-759c-1c27-f6b51a43e011
msgctxt "h66ebfa76g3f08g44b8gac4bgb8de655ee3d8"
msgid "Here. You can have it back. Now, what do you have for sale?"
msgstr "여기. 다시 가져가. 뭘 팔고 있니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 2e340c17-d709-6cc5-c891-3d712e1145fe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DROWHALFELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:2e340c17-d709-6cc5-c891-3d712e1145fe
msgctxt "h51051fdfg16efg4806ga585gf79bacf5f8e2"
msgid "I'm half-drow - I only steal half the children I meet."
msgstr "난 하프 드로우야, 난 내가 만나는 아이의 절반만 납치한단다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 2e69df78-7a15-d3c6-fea8-5f79fb7339b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:2e69df78-7a15-d3c6-fea8-5f79fb7339b1
msgctxt "hb4fa2448g9a96g43efgbd05gfae1d8c98b6c"
msgid "<i>Leave. </i>"
msgstr "<i>떠난다. </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 314557de-566d-378d-f059-7980c3b6ccd3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:314557de-566d-378d-f059-7980c3b6ccd3
msgctxt "hc65ae2cagd283g4e84gb75bg6936ef5bf74f"
msgid ""
"I'm just... trying to earn money for my family. My father left and my "
"mother... she's so sick."
msgstr "저는 그저... 가족을 위해 돈을 벌려고 하는 거예요. 제 아버지는 돌아가셨고 어머니는... 몹시 아프세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 328cbc65-823d-48ee-4b09-d58e55b2e7f9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Pickpocket1_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:328cbc65-823d-48ee-4b09-d58e55b2e7f9
msgctxt "h98cda0f9gcbd8g4462gba4egb96183d739a5"
msgid "Hey, you're back! Look to buy, sell, or what?"
msgstr "돌아오셨네요! 파실 거예요, 사실 거예요, 뭘 원하세요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 32ce1f1b-d033-de91-05cc-0bdd89e1373c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:32ce1f1b-d033-de91-05cc-0bdd89e1373c
msgctxt "hdb2a1b0ega997g420cga9c9gcfb82d1c4e7b"
msgid "Me? No, promise. I'm just a kid trying to make a living."
msgstr "저요? 아뇨, 맹세해요. 저는 먹고 살기에도 급급한 꼬맹이인걸요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 3412db32-1019-bb6e-4f87-bb539f101577
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:3412db32-1019-bb6e-4f87-bb539f101577
msgctxt "h37d6ec96g33dcg48e8gbe50g3b3edb7743f9"
msgid "It's only a joke. Go on - flip your coin."
msgstr "농담일 뿐이야. 계속해 - 동전을 던져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 34f519b1-3dfb-6cca-576f-d2f70d961507
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Party:
#.     - DEN_Thieflings_Event_FirstTheftCheck(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:34f519b1-3dfb-6cca-576f-d2f70d961507
msgctxt "h39c71767g97d3g461ag94cdg4413587aa952"
msgid "Thank you. That... means so much."
msgstr "고마워요. 그건... 정말 큰 의미가 있네요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 36b7ae07-f906-73dc-3904-f267536d0672
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:36b7ae07-f906-73dc-3904-f267536d0672
msgctxt "h3d24662cg4599g49f6g9705g85f823d51539"
msgid "Good news is, I got more on sale. Interested?"
msgstr "좋은 소식은, 제가 그걸 더 가지고 있다는 거예요. 관심 있으세요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 3771a582-b289-f466-b13f-b97df211410b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LOLTHDROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:3771a582-b289-f466-b13f-b97df211410b
msgctxt "h14527a17gcb24g4c80g8035g8a6c66b947c3"
msgid ""
"If you have lied to me, I will feed you to spiders. One piece at a time."
msgstr "내게 거짓말을 한 거라면, 널 거미 먹이로 먹여주지. 한 번에 한 조각씩 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 377bfad9-f67c-1aeb-d4f2-e69a13ca9a09
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:377bfad9-f67c-1aeb-d4f2-e69a13ca9a09
msgctxt "hf6249bb5g919eg4939ga433g8d6216448c0d"
msgid "You caught me, all right? They're not lucky rings."
msgstr "딱 걸렸네요, 그렇죠? 이것들은 행운의 반지가 아니에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 377f886b-860f-2526-c001-890b8b0408c8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Thieflings_State_HasPickpocketRing(1) = True
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Event_PlayerAdmittedPickpocketing = True
#.     - DEN_Hideout_Event_BefriendedThieflings = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:377f886b-860f-2526-c001-890b8b0408c8
msgctxt "hec237935g5e29g445cg94d8g6c1be121f133"
msgid "I might have had something to do with that."
msgstr "내가 그 일과 관련 있을지도 모르겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 38e86651-ee77-27f1-0683-6755e2853573
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_DUERGARDWARF or REALLY_DWARF
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:38e86651-ee77-27f1-0683-6755e2853573
msgctxt "h8e76ede3g2eb2g4f00g89e7gf750a769788c"
msgid "It's junk. That craftsmanship is downright offensive."
msgstr "쓰레기야. 그 세공은 완전 불쾌할 정도야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 38e86651-ee77-27f1-0683-6755e2853573
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:38e86651-ee77-27f1-0683-6755e2853573
msgctxt "ha32b24adg00bcg4e9agb625gb9d2695f3906"
msgid "It's nothing but junk."
msgstr "쓰레기밖에 없잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 3a9091b8-2650-edb4-0f6d-c7f822a41439
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:3a9091b8-2650-edb4-0f6d-c7f822a41439
msgctxt "h6008523bg4c37g4729g8a6dg964bb02b5921"
msgid "You have a boss? Maybe I'll pay a visit."
msgstr "네가 따르는 대장이 있니? 그를 만나봐야겠는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 3fee3c07-fc6e-432d-8ca0-c1a16b58e34b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:3fee3c07-fc6e-432d-8ca0-c1a16b58e34b
msgctxt "h01bb190dg50e5g45f7ga499g64984fd7480a"
msgid ""
"Okay, maybe you don't need extra luck. But since you're already holding the "
"thing..."
msgstr "알았어요, 운이 더 필요하지 않을 수도 있죠. 하지만 이미 반지를 들고 계시니..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 4154b09b-5b0f-9baa-83f4-726a569ac2b0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Pickpocket1_PCAttemptedTheftBefeoreCoinFlip(1) = True
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_State_KeptMagicRing = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:4154b09b-5b0f-9baa-83f4-726a569ac2b0
msgctxt "h2af0fc8dgc882g479agac95gc156cefcf79b"
msgid "Thanks for the free ring."
msgstr "공짜 반지 고마워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 415d7275-73c0-6579-5f1f-72d7ca58a51f
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:415d7275-73c0-6579-5f1f-72d7ca58a51f
msgctxt "h7cbb25e1g3ee0g4389ga9fag9fa1ab94986e"
msgid "Hard luck, lady. But like I said, we can change that. Watch!"
msgstr "운이 나쁘시네요, 숙녀분. 하지만 제가 말씀드렸던 대로, 그건 바꿀 수 있어요. 보세요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 415d7275-73c0-6579-5f1f-72d7ca58a51f
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:415d7275-73c0-6579-5f1f-72d7ca58a51f
msgctxt "h0a009792g9e1fg4378g9058g3202dc164fff"
msgid "Hard luck, mister. But like I said, we can change that. Watch!"
msgstr "운이 나쁘시네요, 신사분. 하지만 제가 말씀드렸던 대로, 그건 바꿀 수 있어요. 보세요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 415d7275-73c0-6579-5f1f-72d7ca58a51f
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:415d7275-73c0-6579-5f1f-72d7ca58a51f
msgctxt "h41f039d7g5ccdg45e0g839eg3aaff8b60996"
msgid "Hard luck. But like I said, we can change that. Watch!"
msgstr "운이 나쁘시네요. 하지만 제가 말씀드렸던 대로, 그건 바꿀 수 있어요. 보세요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 41e66cfa-da33-aafb-7bf9-1541beb47f07
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:41e66cfa-da33-aafb-7bf9-1541beb47f07
msgctxt "hbed1a801gaf3bg43c0g90a9gad627e288cbe"
msgid "You? You skimmed <i>me</i>? I was trying to skim <i>you! </i>Ahahaha!"
msgstr "당신이? 당신이 <i>나를</i> 털었어요? 내가 <i>당신을 </i>털려고 했었는데! 아하하하!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 423ff80d-63e1-94c7-3705-cf4bfe29ba26
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Pickpocket1_CoinGame4(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Pickpocket1_CoinGame5(1) = True
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:423ff80d-63e1-94c7-3705-cf4bfe29ba26
msgctxt "he471dfa1g1572g43fdgb825g7190ceed8dc4"
msgid "You're killing me here, lady. You really are."
msgstr "당신 때문에 여기서 죽겠어요, 숙녀분. 진짜로요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 423ff80d-63e1-94c7-3705-cf4bfe29ba26
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Pickpocket1_CoinGame4(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Pickpocket1_CoinGame5(1) = True
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:423ff80d-63e1-94c7-3705-cf4bfe29ba26
msgctxt "hc6045297gae73g4ad1g8d57g12a8944e3c73"
msgid "You're killing me here, mister. You really are."
msgstr "당신 때문에 여기서 죽겠어요, 신사분. 진짜로요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 423ff80d-63e1-94c7-3705-cf4bfe29ba26
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Pickpocket1_CoinGame4(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Pickpocket1_CoinGame5(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:423ff80d-63e1-94c7-3705-cf4bfe29ba26
msgctxt "h36d7d25bga27cg4f43gbc60g0a8538f21c54"
msgid "You're killing me here. You really are."
msgstr "당신 때문에 여기서 죽겠어요. 진짜로요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 4444895b-6af1-59c4-4fdd-da8221ff5b9b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:4444895b-6af1-59c4-4fdd-da8221ff5b9b
msgctxt "h31f906f4gbf40g4329g875eg43d53eb8bccb"
msgid "Look, do you want to buy something or nothing?"
msgstr "이봐요, 뭘 사실 거예요 말 거예요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 465311a7-c650-9306-15c9-b84cfb03a8cc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Thieflings_Event_PlayerPurchased(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:465311a7-c650-9306-15c9-b84cfb03a8cc
msgctxt "h53d4a778gda14g4534g870dgd16068bc98ee"
msgid "Nothing caught your eye, huh?"
msgstr "눈길을 사로잡는 것이 없나요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 46cfd953-75d1-9b9e-cc89-79e9a9487839
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:46cfd953-75d1-9b9e-cc89-79e9a9487839
msgctxt "h12f38542gddc3g4d65ga1cegb0144f11f3fc"
msgid "Here's your ring. Let's trade."
msgstr "여기 네 반지야. 거래하자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 490ca681-201e-43af-6695-c1311cd8b87b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Knows_HandSignal = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Pickpocket1_PCShowedHandSignal(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:490ca681-201e-43af-6695-c1311cd8b87b
msgctxt "h6a4fc28eg0c87g466eg968fgef30134addca"
msgid "<i>Perform Mol's hand signal.</i>"
msgstr "<i>몰의 수신호를 따라한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 49208241-070b-b7cd-00f5-297a6fca9ce5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Pickpocket1_PCAttemptedTheftBefeoreCoinFlip(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:49208241-070b-b7cd-00f5-297a6fca9ce5
msgctxt "h48417832g069fg46c4gb085ga3ccc83c4bfb"
msgid "<i>Pocket the ring.</i>"
msgstr "<i>반지를 주머니에 넣는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 4b376cab-551e-7c7b-9072-c6c90cc15697
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:4b376cab-551e-7c7b-9072-c6c90cc15697
msgctxt "h5cf473a5gad63g40d3ga77dg3e681be11a6d"
msgid "That's what I got!"
msgstr "제가 가진 물건이에요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 4c430f67-d3d3-b13d-f7cf-c1d335a523c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:4c430f67-d3d3-b13d-f7cf-c1d335a523c1
msgctxt "h71294755g23aeg45f7ga94fg544d0f1940bf"
msgid "Real sweet sense of humour you got there, chum."
msgstr "유머 감각이 참 좋네요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 4e268cb6-c405-167d-3710-90dac44c0013
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:4e268cb6-c405-167d-3710-90dac44c0013
msgctxt "h24fefb47gb9b1g4bb3g9089gad4cb8cd0a95"
msgid "The thieves' what? No."
msgstr "도둑의 뭐요? 아뇨."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 4e98b857-d140-9a2e-df8f-102d27f2b0cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:4e98b857-d140-9a2e-df8f-102d27f2b0cf
msgctxt "h60052070g24c2g4e0egaf68g505990bdfd97"
msgid "Call it. Heads or tails?"
msgstr "맞춰보세요. 앞면 혹은 뒷면?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 500fa222-8474-2ecb-8441-20c558bc6d8c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:500fa222-8474-2ecb-8441-20c558bc6d8c
msgctxt "h63ee60f2gd1d5g40c5g9286gc7b40b0327e9"
msgid ""
"That a fact? Well, they're magical rings. Maybe it vanished, y'know, "
"magic'ly."
msgstr "그거 사실인가요? 글쎄요, 그건 마법의 반지예요. 사라졌겠죠. '마법적으로'."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 50385bdf-001b-9b21-13bb-fb248b815612
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_Thieflings_Event_TransferPickpocketRing(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:50385bdf-001b-9b21-13bb-fb248b815612
msgctxt "h7d678a9cg8602g4fdfg8c7cge49f9ae237d2"
msgid "Take your ring. I don't have time for this."
msgstr "네 반지 가져가. 나는 이러고 있을 시간 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 57bb898c-f20f-c977-0049-d819a44f9c95
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:57bb898c-f20f-c977-0049-d819a44f9c95
msgctxt "ha8b474f2g66fdg429ag9469g7f90ef8673b2"
msgid "Yeah, sure."
msgstr "네, 그러겠죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 59736f9f-ce35-3460-9edf-56ff9b7c585d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:59736f9f-ce35-3460-9edf-56ff9b7c585d
msgctxt "hdf673133g74b1g4d82g8b0dg4320e721bc73"
msgid "Otherwise, Mol's waiting."
msgstr "그게 아니면, 몰을 만나야죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 5af16eea-ad9f-ac54-432c-9dd5d11f64d7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:5af16eea-ad9f-ac54-432c-9dd5d11f64d7
msgctxt "hd7fa7a6age7cdg4d8dga503g3b9d219a7d8d"
msgid "I want an apology from her."
msgstr "걔한테서 사과를 받고 싶은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 5c0268e1-8ac4-398c-0e02-429b456a2d79
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_Thieflings_Event_CheckKnowsHideout(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:5c0268e1-8ac4-398c-0e02-429b456a2d79
msgctxt "h4ea363e1ga0a2g49f1gae21ge7a6f27bea77"
msgid ""
"You know who you should talk to? Mol. She's my... boss, I guess. Good at "
"finding stuff."
msgstr "누구에게 말해야 하는지 아세요? 몰이에요. 아마 제... 보스예요. 걔는 물건을 잘 찾아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 5db9eda0-944d-0f85-1355-4f498bbeaa64
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:5db9eda0-944d-0f85-1355-4f498bbeaa64
msgctxt "h3055b905g9408g478ega9cbgef67d849a39f"
msgid "I don't need anyone's permission."
msgstr "난 누구의 허락도 필요 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 5dfde961-c4c6-cdd8-4fba-8f6ee88d1cb3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Pickpocket1_PartnerAccused(1) = False
#.   Global:
#.      - DEN_Thieflings_Event_PlayerRobbed = False
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Pickpocket1_PartnerAccused(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:5dfde961-c4c6-cdd8-4fba-8f6ee88d1cb3
msgctxt "h592b6292g63c6g4d62g9df4g88dbc6c1d3db"
msgid "Your partner's a thief."
msgstr "네 친구가 도둑이었군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 5f6825c2-d5d4-e057-23bd-adc6b8b7afa1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:5f6825c2-d5d4-e057-23bd-adc6b8b7afa1
msgctxt "h84d397acg179fg43e9gad55gda25eacbb2e1"
msgid "Yeah? Are they bored to death?"
msgstr "그래요? 걔들은 지루해서 죽었대요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 60376c0a-7305-fd70-c3fb-0eb6ced936e4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:60376c0a-7305-fd70-c3fb-0eb6ced936e4
msgctxt "h7575dbfagf2b0g4047g8692gd65fc4fcc46a"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 608e750e-75e5-533d-2480-cd19192e938f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:608e750e-75e5-533d-2480-cd19192e938f
msgctxt "ha033142bg6ce9g4d21gafe0gb4d07d9b33da"
msgid "Anyway, forget that. Take the ring! I wanna show you how lucky it is!"
msgstr "어쨌든, 방금 건 잊으세요. 이 반지를 가져가세요! 이게 얼마나 운이 좋은지 당신에게 보여드리고 싶네요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 6117dee5-a68b-3b49-525e-fbffd4c53e4c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:6117dee5-a68b-3b49-525e-fbffd4c53e4c
msgctxt "he184498cg93ccg4977ga15ag42e09d686352"
msgid "Keep the ring. No hard feelings. That was some sharp work, mate."
msgstr "반지는 가져요. 기분 나쁘게 생각하지 말고. 정말 빈틈없는 작업이었어, 친구."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 6126c985-eca9-0683-3a76-f537cb9302a1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:6126c985-eca9-0683-3a76-f537cb9302a1
msgctxt "hef01dc0fg7906g4afega8cfge15dc25afc78"
msgid ""
"The hell it is. You can't do that one with rings. It has to be bracelets "
"because..."
msgstr "젠장. 반지로는 안될 거예요. 팔찌여야 돼요. 왜나하면..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 6184d512-ac03-d2da-02bc-419ea1277a7c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:6184d512-ac03-d2da-02bc-419ea1277a7c
msgctxt "h95ced8bbg04ceg4555g8533gac249462e169"
msgid "Anyway, to business. Hold out your hand. I want to show you something."
msgstr "아무튼, 본론으로 들어가죠. 손 내밀어 봐요. 보여줄 게 있어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 6498d67b-0f57-5fd7-93be-6042878c9e53
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Knows_KidsThieves = True
#.     - DEN_Thieflings_Knows_LimsRingGameIsAScam = True
#. TagRule: WARLOCK or WIZARD
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:6498d67b-0f57-5fd7-93be-6042878c9e53
msgctxt "h1ccb6d1dgda60g44a9gb29eg4505da2e5ae4"
msgid "This is no magic ring. The runes are gibberish."
msgstr "이건 마법의 반지가 아닌데. 룬이 엉망인걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Narrator
#. NodeID = 6609675a-3d1b-df4f-d108-29a6bfccdecc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:6609675a-3d1b-df4f-d108-29a6bfccdecc
msgctxt "h731c9898gcc88g4d4fg9068gf7ef634e3eef"
msgid "*You recognise his movements - Mol's hand signal.*"
msgstr "*당신은 몰의 수신호를 알아챕니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 6721652b-e8b1-2523-b545-0531d5040df1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:6721652b-e8b1-2523-b545-0531d5040df1
msgctxt "hbf0ea001g4700g4c2fgbee6g786fa61a3398"
msgid "Could be worth something if I had a furnace to melt it down."
msgstr "용광로만 있으면 내가 녹여내서 만들 수 있겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 6a45f8fa-5987-249d-ca62-296063db6bde
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:6a45f8fa-5987-249d-ca62-296063db6bde
msgctxt "h9226600bgf62eg4b6dg9dc9g7b1cbe136ed3"
msgid "<i>Leave. </i>"
msgstr "<i>떠난다. </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 6c1a8f9b-43fd-e5e0-9629-c53130fbd81e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:6c1a8f9b-43fd-e5e0-9629-c53130fbd81e
msgctxt "h8d211531g63aeg4d0egaf2fgd33fe63f998b"
msgid "Again? I mean, sure."
msgstr "또요? 제 말은, 당연하죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 6c215fa5-79ca-a6a0-ba6a-d1fd6c46a4aa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:6c215fa5-79ca-a6a0-ba6a-d1fd6c46a4aa
msgctxt "h4d77ee2cga427g49efg890fg7d94ea36a7ef"
msgid "Anyone could see this was a modified War Widow scam."
msgstr "누구라도 이건 변형된 전쟁 과부 사기라는 걸 알 수 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 6f3f9642-9e74-7a59-9b26-8c0d69947ebe
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Party:
#.     - DEN_Thieflings_Event_FirstTheftCheck(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:6f3f9642-9e74-7a59-9b26-8c0d69947ebe
msgctxt "h4eb73493g6939g4a63g8f7ag92ec2f291813"
msgid "Really? I mean, good."
msgstr "정말요? 제 말은, 좋아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 703c8c5f-e244-2607-e191-ba9c7bf103d2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:703c8c5f-e244-2607-e191-ba9c7bf103d2
msgctxt "hf172b1e1g9bb8g4477ga59egb5fc9fb6e6e9"
msgid "Go on! Take the ring and watch your fortune change!"
msgstr "얼른요! 이 반지를 가져가시면 당신의 운이 바뀌는 걸 보실 수 있을 거예요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 7073ea59-802b-36e5-5f61-03ecc557844c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:7073ea59-802b-36e5-5f61-03ecc557844c
msgctxt "h5676625fgaf7eg4ae3gaae9g5d624877a783"
msgid "I am sorry! Sorry we're still talking about this."
msgstr "죄송합니다! 아직도 이 얘기를 하고 있는 게 죄송해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 7298b097-d700-7fe8-a388-aada9f1af487
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_TriedRingScamOn(1) = False
#.   Global:
#.      - DEN_Hideout_State_ResolvedThieflings = False
#.      - DEN_Thieflings_State_KeptMagicRing = False
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Pickpocket1_HasMet(1) = True
#. TagRule: BESTIAL or GITHYANKI or PLANAR or RARE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:7298b097-d700-7fe8-a388-aada9f1af487
msgctxt "h6369fd61g1338g4f18g9ac8g435d4855d1ab"
msgid "Whoa. Hey. Can't say I've ever seen someone like you before."
msgstr "우와. 당신 같은 사람은 처음 보네요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 7298b097-d700-7fe8-a388-aada9f1af487
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_TriedRingScamOn(1) = False
#.   Global:
#.      - DEN_Hideout_State_ResolvedThieflings = False
#.      - DEN_Thieflings_State_KeptMagicRing = False
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Pickpocket1_HasMet(1) = True
#. TagRule: HALFORC
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:7298b097-d700-7fe8-a388-aada9f1af487
msgctxt "h77317cf6gec3ag440cg8b7ag09ceea6d9a33"
msgid "Hey! Jumbo! Wanna see something fun?"
msgstr "이봐요! 덩치! 재미있는 것 좀 볼래요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 7298b097-d700-7fe8-a388-aada9f1af487
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
