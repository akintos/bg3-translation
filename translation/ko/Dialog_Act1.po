msgctxt "hc2b6b3f1gf790g44a5g87d8gbb4265c59af9"
msgid "Praise the Absolute!"
msgstr "절대자님을 찬양하라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinBrash
