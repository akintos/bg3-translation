msgctxt "h76fa376bg9102g46fbg8ac8g2db5bf0701f6"
msgid "Where did he go...?"
msgstr "어디로 간 거지...?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_AD_InvestigationCheck2
#. Speaker = Player
#. NodeID = d64dff6a-686d-6e23-c6de-207d2cb334ab
