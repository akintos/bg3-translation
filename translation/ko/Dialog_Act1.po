msgctxt "hf4bb7725g3f63g4a87g8a3agecbe943ec1ec"
msgid "Excellent armour. Drowcraft, of course."
msgstr "훌륭한 방어구네. 역시 드로우의 솜씨야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_VB_DeadDrow1Armor_WithDrow
#. Speaker = Player
#. NodeID = 8cb4796d-997d-c1e4-1352-010e1294919c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
