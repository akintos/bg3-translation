#.   Dialog:
#.      - GOB_GuardPolite_HasMet(1) = True
#.   Tag:
#.      - DROWELF(1) = True
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardPolite:f4bb21ef-273f-3821-25a4-4322cf26f14f
msgctxt "h0e1edeffg415dg4267g86c7g1ebe489a9fd9"
msgid "Enjoyin' your visit, yer lordship?"
msgstr "머무는데 불편한 건 없으신가요, 나리?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardPolite
#. Speaker = Warrior Druk
#. NodeID = f4bb21ef-273f-3821-25a4-4322cf26f14f
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_GuardPolite_HasMet(1) = True
#.   Tag:
#.      - DROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardPolite:f4bb21ef-273f-3821-25a4-4322cf26f14f
msgctxt "h5c53f971g1280g4d7egafb7ge5bc03561115"
msgid "Enjoyin' your visit, True Soul?"
msgstr "머무는데 불편한 건 없으신가요, 참된 영혼이시여?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardTense
#. Speaker = Warrior Nrog
#. NodeID = 015670b3-64b3-7fa0-7918-cee58abf8fbf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BRANDED(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardTense:015670b3-64b3-7fa0-7918-cee58abf8fbf
msgctxt "h86dd1f37gf9b8g4a31ga0b9g1b70fa9f514b"
msgid "Priestess burned ya, then? Thought I smelled somethin' tasty cookin'."
msgstr "여사제가 네게 낙인을 새겼어? 어쩐지 '맛있게 굽는' 냄새가 난다 했지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardTense
#. Speaker = Warrior Nrog
#. NodeID = 2de86341-00cc-5ae9-cfcd-9b21ea0a2335
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_GuardTense_HasMet(1) = False
#.   Global:
#.      - GOB_GoblinThroneCheckpoint_Pass = False
#. SetFlags:
#.   Object:
#.     - TeleportOutOfTrespass(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardTense:2de86341-00cc-5ae9-cfcd-9b21ea0a2335
msgctxt "hb45b3278ga2bfg4cc3g978cg77447a693a76"
msgid "Oi! We ain't said you pass - <i>you don't pass.</i>"
msgstr "야! 너 지나가라고 안 했잖아 - <i>그럼 너 못 지나간다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardTense
#. Speaker = Warrior Nrog
#. NodeID = 6246665a-b562-0705-b1ad-556fac18e67f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_GuardTense_HasMet(1) = False
#.   Global:
#.      - GOB_GoblinThroneCheckpoint_Pass = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardTense:6246665a-b562-0705-b1ad-556fac18e67f
msgctxt "h322beec4g4c14g4b48ga925g2a95d5242e7e"
msgid "Been boozin'? Won't make the brandin' go any easier - I tried."
msgstr "술 좀 마셨나? 그래도 낙인 새기는 건 고통스러울걸. 나도 해봤어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardTense
#. Speaker = Warrior Nrog
#. NodeID = 8eb8a9bd-b0c9-de51-9d2c-ca2636e4fb25
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_GuardTense_HasMet(1) = True
#.   Tag:
#.      - BRANDED(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardTense:8eb8a9bd-b0c9-de51-9d2c-ca2636e4fb25
msgctxt "h52cc7d1cgf4a4g41cdg85b2gcfa6c4c4a4ca"
msgid "Go on. Sooner yer marked, sooner ye'll heal."
msgstr "가봐. 빨리 새길수록, 빨리 회복될 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = 028ac107-2707-8fb8-5da0-1bce8eab19d7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_GoblinThroneCheckpoint_Pass = True
#.      - GLO_Halsin_Knows_IsMissing = True
#. TagRule: DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:028ac107-2707-8fb8-5da0-1bce8eab19d7
msgctxt "hd6b4a06fg4ac6g4333gb437g46a44c0c26c7"
msgid ""
"Forgive the reception. Had some intruders a while back - can't be too "
"careful."
msgstr "아까는 미안해 친구. 얼마 전에 침입자가 있었거든, 항상 조심해야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = 028ac107-2707-8fb8-5da0-1bce8eab19d7
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_GoblinThroneCheckpoint_Pass = True
#.      - GLO_Halsin_Knows_IsMissing = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:028ac107-2707-8fb8-5da0-1bce8eab19d7
msgctxt "hefd76d9cg46e1g4c28g8cb6g7dbbc6827c77"
msgid ""
"Forgive the reception, eh, mate? Had some intruders a while back. Can't be "
"too careful."
msgstr "아까는 미안해 친구, 알겠지? 얼마 전에 침입자가 있었거든, 항상 조심해야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = 070d3853-6477-2652-61c4-a9972173dbff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:070d3853-6477-2652-61c4-a9972173dbff
msgctxt "haec6c2a5g3773g4de7g939bg7dc93b41e547"
msgid ""
"Well, beg pardon but... it ain't just <i>you</i> the Absolute speaks through."
msgstr "에, 정말 미안하지만... <i>당신만</i> 절대자님의 목소리를 들을 수 있는 건 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Player
#. NodeID = 09e43b00-f147-3f2e-20ae-3d9aa12a1165
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - DROWELF(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:09e43b00-f147-3f2e-20ae-3d9aa12a1165
msgctxt "hf49ffaf5g638eg404cg8e7cg46fcab7694b2"
msgid "I've got an audience with the one in charge."
msgstr "너희 대장을 알현하러 왔다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = 0b0db2f2-8d80-8300-8583-a4ac1de7fd82
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_GoblinThroneCheckpoint_Pass = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:0b0db2f2-8d80-8300-8583-a4ac1de7fd82
msgctxt "hb534c876g5ad3g4a85g93d3gd00c964f4c69"
msgid "You one of those Moonrise types, then?"
msgstr "그럼, 문라이즈 타워에서 왔나 보군?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Player
#. NodeID = 0b1de6c5-cbfd-7158-717f-90342b469856
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 5
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#.      - ILLITHID(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:0b1de6c5-cbfd-7158-717f-90342b469856
msgctxt "h120dcc18g55b8g4b96gbf25gfd8f6261efbc"
msgid "I'm not here to talk to a lowly guard."
msgstr "하급 경비랑 대화하러 온 게 아니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = 10a650df-d0a0-a513-107d-107e5f3b9a05
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:10a650df-d0a0-a513-107d-107e5f3b9a05
msgctxt "hdbc38ff8g5f51g4ebbgb1e4g9bec97918ce9"
msgid "Cheeky bugger. Get 'em!"
msgstr "건방진 새끼가. 잡아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = 1db76189-36e9-aaf6-4229-c980bc56a95c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_State_WyllLearnedAllLeaders = False
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_Knows_LeaderNameDrow = True
#.   Quest:
#.     - DEN_Conflict_SUB_Goblin.GOB_LearntAllNames(1) = True
#. TagRule: DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:1db76189-36e9-aaf6-4229-c980bc56a95c
msgctxt "hab13ad9bg84e7g4d34g90bdg9b9fbe33ff43"
msgid ""
"Then Minthara arrived. And now you - the Absolute's keen on drow, seems like."
msgstr "그러더니 민타라가 왔지. 이젠 당신까지, 절대자께서 드로우를 좋아하시는 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = 1db76189-36e9-aaf6-4229-c980bc56a95c
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_State_WyllLearnedAllLeaders = False
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_Knows_LeaderNameDrow = True
#.   Quest:
#.     - DEN_Conflict_SUB_Goblin.GOB_LearntAllNames(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:1db76189-36e9-aaf6-4229-c980bc56a95c
msgctxt "h81b22163ge1a3g42c7gaf26g516f17c1520b"
msgid ""
"Then the drow arrived. And now you - the Absolute 'as big plans for all of "
"us, seems like."
msgstr "그러더니 그 드로우가 왔지. 이젠 당신까지, 절대자께서 모두를 위한 계획을 세우고 계신 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = 2355b07e-b75e-d74c-0f2e-6bb7e0819976
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - GLO_Tadpole_SUB_Druid.LearnedPit(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:2355b07e-b75e-d74c-0f2e-6bb7e0819976
msgctxt "h1616d816g0f9bg4951g8123g66b78982b6d2"
msgid ""
"A druid? Can't be sure - got one of 'em chained up below, though. Just "
"follow the hollerin'."
msgstr "드루이드? 확실하진 않지만, 놈들 중 하나를 밑에 사슬로 묶어뒀어. 비명소리를 따라가면 될 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = 2441fe0f-26d2-60c1-5019-606c63ab43c6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TeleportOutOfTrespass(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:2441fe0f-26d2-60c1-5019-606c63ab43c6
msgctxt "h7d32ee0cg812eg4411g85a7g0ce01a6d056f"
msgid "Aye, back the way you came now, afore I change my mind."
msgstr "어이, 왔던 길로 되돌아가라고, 내 생각이 바뀌기 전에 말야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = 290478fd-080c-6134-124c-4a99053d1eff
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_GoblinThroneCheckpoint_Pass = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:290478fd-080c-6134-124c-4a99053d1eff
msgctxt "hffefeab2g0819g490fga793g1e32b6e416bd"
msgid "Right. Well. You ain't the first foreign type, I s'pose."
msgstr "그렇군. 알았어. 네가 첫 이방인도 아니긴 하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = 2b88fc86-01be-9771-0c10-f41d024d36ec
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_GuardUpset_State_ConvincedTrueSoul(1) = True
#.   Global:
#.     - GOB_GoblinThroneCheckpoint_State_NonCharlatanAccess = True
#.     - GOB_GoblinThroneCheckpoint_Pass = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:2b88fc86-01be-9771-0c10-f41d024d36ec
msgctxt "hec601d5bg6010g4a9bgbebcgddf3992962fa"
msgid ""
"Ah, beg p-pardon! You must be 'ere to join the other True Souls. Please, go "
"right ahead."
msgstr "아, 시-실례했군! 다른 참된 영혼들과 함께하려는 거구나. 그럼, 지나가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = 2f9ccb1b-7a6f-549c-5ac4-84034746c50c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_GoblinThroneCheckpoint_Pass = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:2f9ccb1b-7a6f-549c-5ac4-84034746c50c
msgctxt "h68720669ga91eg4128gac97g4cea9f8700c4"
msgid ""
"All right, all right - normally, we'd stick you foreign types in the spider "
"pit."
msgstr "알았어, 알았어 - 평소라면 너희 외지인들은 거미굴로 쳐넣겠지만 말야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Player
#. NodeID = 349f9daf-02c2-c41d-c8d9-208364dd9500
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:349f9daf-02c2-c41d-c8d9-208364dd9500
msgctxt "he4d5652bgcdbbg44a7g86b9gbba0e868e05d"
msgid "I want to see Priestess Gut."
msgstr "여사제 거트를 만나고 싶다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Narrator
#. NodeID = 34b18ccb-e540-3777-870a-b8cf7891278b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount3(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount3(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:34b18ccb-e540-3777-870a-b8cf7891278b
msgctxt "hdc91e5d4g523fg4477ga162g6335f5722d60"
msgid "*Your mind lurches, reeling suddenly as if... bitten.*"
msgstr "*뭔가에 깨물린 것처럼 느닷없이 정신이 휘청거립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = 360876fe-6e6b-e655-53ca-55f5edd9aeed
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_GoblinThroneCheckpoint_Pass = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:360876fe-6e6b-e655-53ca-55f5edd9aeed
msgctxt "hd49a1dccg77adg40b2g8169g053bd60e784e"
msgid ""
"Still a bit strange, your kind running around. Absolute says we're all one "
"side now though, eh?"
msgstr "너 같은 종족이 돌아다니는 걸 보는 게 아직도 이상하군. 절대자께서는 우리가 같은 편이라고 하긴 하셨지, 안 그래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Narrator
#. NodeID = 397ace0c-0cf8-b188-23e1-9e29fc602779
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount5(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount5(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:397ace0c-0cf8-b188-23e1-9e29fc602779
msgctxt "hf522f90cg6cc4g459bgac23gfb3d0e0a663c"
msgid ""
"*Your blood runs quicker, feeding the gnawing absence at the centre of your "
"mind.*"
msgstr "*피가 더 빨리 흐르면서, 당신의 정신 한가운데를 좀먹는 허전함을 양분으로 채웁니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Player
#. NodeID = 3a7ead59-8311-44d3-ba11-0cb60cf95325
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = False
#. SetFlags:
#.   Global:
#.     - GOB_GoblinThroneCheckpoint_State_NonCharlatanAccess = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:3a7ead59-8311-44d3-ba11-0cb60cf95325
msgctxt "h839d90a6gfc70g4be0ga68ag9317bd5cc51f"
msgid "You don't need to know about my business. <i>Move.</i>"
msgstr "내 일은 네가 알바 아니다. <i>비켜.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Player
#. NodeID = 3b6da009-34a1-b168-becc-7270899e5a53
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#. SetFlags:
#.   Global:
#.     - GOB_GoblinThroneCheckpoint_State_NonCharlatanAccess = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:3b6da009-34a1-b168-becc-7270899e5a53
msgctxt "hf6625deag64dbg49dag9bd2g46d88b8324e6"
msgid "Let. Me. <b>Through.</b>"
msgstr "날. 들여보내. <b>줘.</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Narrator
#. NodeID = 3d1bd726-3efc-d30d-f76e-aab924136cbb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - GLO_TadpoleIntro_NPC(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:3d1bd726-3efc-d30d-f76e-aab924136cbb
msgctxt "h32148026gd3edg41a4g9fdbgf87aae1b858e"
msgid "*As the symbol glows, power courses through you. <i>Authority</i>.*"
msgstr "*문양이 빛나며, 몸에 흐르는 힘이 느껴집니다. <i>권위</i>.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = 3db857d4-59ba-0669-d5ec-1fe2e7f88818
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_Knows_LeaderNamePriest = True
#.     - DEN_GroveConflict_Knows_LeaderNameKing = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:3db857d4-59ba-0669-d5ec-1fe2e7f88818
msgctxt "h05173721g7a43g4226gb822gd11044a73dca"
msgid ""
"At first we thought it were just Boss Ragzlin and Priestess Gut. Just <i>our "
"</i>kind, like."
msgstr "처음엔 라그즐린 두목이랑 여사제 거트만 있는 줄 알았어. 그러니까, <i>우리 </i>종족 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = 3dda7589-7960-4b80-9ee6-0ce26f21018e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_GuardUpset_State_ConvincedTrueSoul(1) = True
#.   Global:
#.      - GOB_GoblinThroneCheckpoint_Pass = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:3dda7589-7960-4b80-9ee6-0ce26f21018e
msgctxt "he21ab4a3g55d7g4db4gb7c7gfee3b6753f1a"
msgid "Good to 'ave ya, True Soul."
msgstr "당신이 와서 기쁘군, 참된 영혼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = 3ff4c1b6-fcb0-83f2-ab1a-284cca7cd946
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_Knows_LeaderNamePriest = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:3ff4c1b6-fcb0-83f2-ab1a-284cca7cd946
msgctxt "he30beb14g205cg481egb34agc759c95a8f0f"
msgid ""
"She's through the main doors. Just follow the smell of burnt goblin-arse, "
"heh."
msgstr "커다란 문을 통해 가면 찾을 수 있을 거야. 그냥 타버린 고블린 가죽 냄새를 따라가라고, 헤."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = 4363e0ad-5a6c-ae64-9a5a-acdbb82405e9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_DrowCommander_Knows_DrowLeader = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:4363e0ad-5a6c-ae64-9a5a-acdbb82405e9
msgctxt "hd5d3cf3ag4692g47ebgb87dg3c81cafeb94f"
msgid ""
"She's in tellin' the warchiefs wot's wot. Next raid's gonna be a big'un, I "
"hear."
msgstr "그녀가 워치프들에게 설명을 해주고 있어. 다음 습격은 엄청날 거라고 하더군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = 44307524-8868-8482-a0c4-fd34ac5d0915
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - DEN_Conflict_SUB_Goblin.GOB_LearntTwoNames(1) = True
#. TagRule: DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:44307524-8868-8482-a0c4-fd34ac5d0915
msgctxt "h3da70eebg18a7g47fcg864fg1ee942013cad"
msgid ""
"Like Priestess Gut and Boss Ragzlin. Gods, we even got a <i>drow</i>. Two, "
"countin' you."
msgstr ""
"여사제 거트나 라그즐린 대장님처럼 말이야. 세상에, 이젠 우리 편에 <i>드로우도</i> 있다고. 당신까지 포함하면 둘이 되겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = 44307524-8868-8482-a0c4-fd34ac5d0915
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Quest:
#.     - DEN_Conflict_SUB_Goblin.GOB_LearntTwoNames(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:44307524-8868-8482-a0c4-fd34ac5d0915
msgctxt "h3af7b891g6565g4a3agaa4fg09685759eacf"
msgid ""
"Like Priestess Gut and Boss Ragzlin. Gods, we even got a <i>drow</i> now."
msgstr "여사제 거트나 라그즐린 대장님처럼 말이지. 세상에, 이젠 우리 편에 <i>드로우도</i> 있다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = 44e6fa5b-08d5-1f52-87d8-96ccdd45c3aa
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_Quest_Learnt3LeadersTwoNames = True
#. TagRule: DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:44e6fa5b-08d5-1f52-87d8-96ccdd45c3aa
msgctxt "h6535ccbcg32b8g4ff6g90d1g323fce0cb722"
msgid ""
"Like Priestess Gut and Boss Ragzlin. Gods, we even got one like you now."
msgstr "여사제 거트나 라그즐린 대장님처럼 말이지. 세상에, 이젠 우리 편에 당신 같은 족속도 있군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = 4501070e-f10c-d5ba-1784-489985470a38
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_Quest_Learnt3LeadersTwoNames = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:4501070e-f10c-d5ba-1784-489985470a38
msgctxt "h32eb8ea2gcdcdg4c5fgb04eg2ff5edd0620d"
msgid ""
"Like Priestess Gut and Boss Ragzlin. Gods, we even got a <i>drow</i> now."
msgstr "여사제 거트나 라그즐린 대장님처럼 말이지. 세상에, 이젠 우리 편에 <i>드로우도</i> 있다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = 49c5164b-24a1-569e-22a5-890feaf9b90c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_GuardUpset_HasMet(1) = True
#.   Global:
#.      - GOB_GoblinThroneCheckpoint_Pass = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:49c5164b-24a1-569e-22a5-890feaf9b90c
msgctxt "hf77e101cg238dg4afagb434g04f794b7846c"
msgid "Already told you to bugger off, didn't I?"
msgstr "저리 꺼지라고 말하지 않았나, 앙?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = 52d8ad2d-e50a-4134-7f51-97f1d7ffe668
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_GuardUpset_HasMet(1) = False
#.   Global:
#.      - GOB_FestivitiesArea_State_Swept = True
#.      - GOB_GoblinThroneCheckpoint_Pass = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:52d8ad2d-e50a-4134-7f51-97f1d7ffe668
msgctxt "h743a7dbega1ffg4ca9ga213g57e42a22f09a"
msgid "Oi! What's the bloody ruckus out there?"
msgstr "어이! 밖에서 대체 무슨 짓을 하고 있는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Player
#. NodeID = 548766e5-26a9-d9cd-e30a-cf2d09e6ae99
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:548766e5-26a9-d9cd-e30a-cf2d09e6ae99
msgctxt "hffa40161gdb4cg463bgb323g55f8a352ce70"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = 57d48873-5638-4ceb-53cb-a82809c13e56
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:57d48873-5638-4ceb-53cb-a82809c13e56
msgctxt "hea171781g9ce9g4903g90ccgc6333551c92c"
msgid "Your kind usually don't deal with Boss Ragzlin and Priestess Gut."
msgstr "너희는 라그즐린 대장이나 여사제 거트를 보러 오진 않던데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Narrator
#. NodeID = 59275b8d-c6eb-4690-fae5-945f25809b39
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:59275b8d-c6eb-4690-fae5-945f25809b39
msgctxt "h782c2418g0853g4451g92d1g6ead360e604c"
msgid "*A shiver runs across your mind... You feel sated.*"
msgstr "*전율이 불현듯 머릿속을 스쳐 지나가고... 만족감이 듭니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = 5c8bf812-1266-1f87-07a1-1cbbf2739bb0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:5c8bf812-1266-1f87-07a1-1cbbf2739bb0
msgctxt "hc44939c4g2a01g4090ga17bg67cee8491aeb"
msgid ""
"Well now, gonna 'ave to be more specific than that. We're drownin' in True "
"Souls 'ere, we are."
msgstr "이봐, 그것보단 구체적으로 말하라고. 여긴 참된 영혼들이 넘치도록 많으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = 5e1dd9b1-4419-4728-25c4-a451da2d6829
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:5e1dd9b1-4419-4728-25c4-a451da2d6829
msgctxt "hc5dba172gfb1eg468egb0b4gebd489e7f2d7"
msgid "We follow the Absolute and them She speaks through."
msgstr "우린 절대자님을 따르고, 그분들은 그녀를 대변해서 말씀하시지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Narrator
#. NodeID = 5ed042cf-ecc6-0ff4-958a-e3484003da29
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:5ed042cf-ecc6-0ff4-958a-e3484003da29
msgctxt "hdefa9233g09a7g45d0ga6ebgd73f3ccd0612"
msgid ""
"*The mark glows, but you feel nothing in response. Your illithid power is "
"beyond reach until you rest.*"
msgstr "*문양이 빛나지만, 어떤 반응도 느껴지지 않습니다. 일리시드 능력을 더 사용하려면 휴식을 취해야 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = 61adf18e-f58c-5c73-7de5-61c83fc0b8b9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:61adf18e-f58c-5c73-7de5-61c83fc0b8b9
msgctxt "h3e01f507g911bg42e9g819eg29abf32097d4"
msgid ""
"Gonna 'ave to be a bit more specific though, mate - Absolute's got a few "
"favourites around here."
msgstr "그래도 좀 더 구체적으로 말해줘야겠어, 친구. 절대자님의 총애를 받는 분들이 몇 계시거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = 63540e15-8f43-2173-d22b-1c96d292ec97
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:63540e15-8f43-2173-d22b-1c96d292ec97
msgctxt "h88d1e880gf732g4dfcg88d6g1fcf0f77c9a4"
msgid ""
"And... you and all now, I reckon. Go ahead, please - I'm sure you're "
"expected."
msgstr "그리고... 지금 보니 알겠군. 그럼, 지나가 - 분명 당신을 기다리고 있을 테니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = 67ff9fd5-35cc-3f09-0aef-8ddb6c311c03
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_Quest_Learnt3LeadersAllNames = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:67ff9fd5-35cc-3f09-0aef-8ddb6c311c03
msgctxt "h37c44bedg48d6g4077ga5a6gea5a4b9f51aa"
msgid "Guessin' you're after Minthara. Could be 'er blood by the looks of you."
msgstr "그럼 민타라를 보러 왔나 보군. 보아하니 그녀의 혈족일지도 모르고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = 6a45db6e-0c85-2957-df1f-7e4010a28e80
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:6a45db6e-0c85-2957-df1f-7e4010a28e80
msgctxt "h3356c2feg34abg4ddegb3c8g978bc5751f71"
msgid "Oh no? Don't worry, mate - time for talk is <i>well</i> past. Get 'em!"
msgstr "안 돼? 걱정 마 친구, 대화 시간은 <i>진작에</i> 지났으니까. 놈들을 잡아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Narrator
#. NodeID = 6cc6c1de-3f04-2411-74d2-26ad2b17a6bb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount6(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount6(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:6cc6c1de-3f04-2411-74d2-26ad2b17a6bb
msgctxt "hd472f04fgbe3fg4682g9cc1gf2e3823e99a0"
msgid ""
"*The presence deep in your mind is awake, unblinking. This is it. A single "
"word pervades your consciousness: 'Soon'.*"
msgstr ""
"*당신의 정신 속 깊이 자리잡은 존재가 태연스레 깨어납니다. 올 것이 왔군요. 한 단어가 당신의 의식 속으로 스며듭니다. ‘곧’*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Narrator
#. NodeID = 6d3954de-1150-3ba6-ef37-c3382210d253
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount4(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount4(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:6d3954de-1150-3ba6-ef37-c3382210d253
msgctxt "h7674b8afg188cg44bbg8038g0d1fd91d273a"
msgid ""
"*A shadow swims across your vision, and a familiar voice tells you to be "
"calm. You are loved.*"
msgstr "*그림자가 낀 듯이 눈앞이 흐려지더니, 익숙한 목소리가 당신을 달래줍니다. 사랑이 느껴집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = 730c4e2f-d67b-2316-c86f-39ba70042038
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:730c4e2f-d67b-2316-c86f-39ba70042038
msgctxt "h4ba23e78g35c0g4b62g8126g7e0b0ae536fd"
msgid "Oi! Only the Absolute 'erself gets to do that!"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Player
#. NodeID = 738cedfc-8038-5fa8-c358-f79333a90b88
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:738cedfc-8038-5fa8-c358-f79333a90b88
msgctxt "ha78ebd30gdb18g4c29ga1c7g700007ed837a"
msgid "Who's in charge around here?"
msgstr "이곳의 책임자가 누구지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = 7446430e-81e6-3a65-20d5-c4689c4389f8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_GuardUpset_State_ConvincedTrueSoul(1) = True
#.   Global:
#.     - GOB_GoblinThroneCheckpoint_State_NonCharlatanAccess = True
#.     - GOB_GoblinThroneCheckpoint_Pass = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:7446430e-81e6-3a65-20d5-c4689c4389f8
msgctxt "h366525d8gd5e8g4a40gaa71gd3ca8288b928"
msgid "Oh! B-beg <i>pardon</i>, True Soul! At y'service, of course."
msgstr "이런! <i>시-실례했군</i>, 참된 영혼! 당신의 명을 받들지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Player
#. NodeID = 75d5e5d2-276f-ea54-2c40-1a3a94d3fba7
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 20
#. CheckFlags:
#.   Dialog:
#.      - GOB_GuardUpset_State_FailedLie(1) = False
#. TagRule: BARD
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:75d5e5d2-276f-ea54-2c40-1a3a94d3fba7
msgctxt "h8d9f1b38g24abg45b4ga530g56f2cbec22a6"
msgid "B-booze. Bit much. <i>Baffroom?</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Player
#. NodeID = 76488978-703c-261b-cbbb-12a278c89216
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:76488978-703c-261b-cbbb-12a278c89216
msgctxt "hc2cff30fg1fcfg4ce8g8aebga571a3d831df"
msgid "<i>They seem ready to attack - be the one to strike first.</i>"
msgstr "<i>저들이 공격할 준비를 마친 것 같다. 먼저 공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = 7697c615-95f5-32a2-7776-19987d1682a7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:7697c615-95f5-32a2-7776-19987d1682a7
msgctxt "hbc53465egf1b1g46f7g998ag66538a9d4345"
msgid "You <i>what</i>, you cheeky bastard?"
msgstr "네가 <i>뭐라고</i>? 이 건방진 개자식아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Narrator
#. NodeID = 7808060a-cc09-de52-4a10-2b874a7f2452
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Tag:
#.     - TRUESOUL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:7808060a-cc09-de52-4a10-2b874a7f2452
msgctxt "h06b76ee8g7094g47d9gb370g95628f007b97"
msgid ""
"*Your mind is full, bursting with ecstasy and terror. Finally, it is coming. "
"You are becoming.*"
msgstr "*당신의 정신이 황홀경과 공포로 가득 차오릅니다. 마침내, 때가 됐군요. 당신은 변화 중입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = 7c84b3bc-8f0e-cd6e-1665-7160044aa543
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:7c84b3bc-8f0e-cd6e-1665-7160044aa543
msgctxt "hb920981ag3af0g4251g8350gb18edf0390ab"
msgid "Oi! Ain't no party in 'ere - we're doing the Absolute's work."
msgstr "어이! 여긴 파티장이 아니야 - 우린 절대자님의 명령을 수행하고 있다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Narrator
#. NodeID = 7cdfcee5-a9e7-b161-6a70-0d3ae6618b4f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount6(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount6(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:7cdfcee5-a9e7-b161-6a70-0d3ae6618b4f
msgctxt "h74bc4b24g498dg455agb863gd9cd0474c8d3"
msgid ""
"*The presence deep in your mind is awake, unblinking. This is it. A single "
"word pervades your consciousness: 'Soon'.*"
msgstr ""
"*당신의 정신 속 깊이 자리잡은 존재가 태연스레 깨어납니다. 올 것이 왔군요. 한 단어가 당신의 의식 속으로 스며듭니다. ‘곧’*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Player
#. NodeID = 7eea6cbb-3ef7-7b22-3f92-2d2166283ee4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:7eea6cbb-3ef7-7b22-3f92-2d2166283ee4
msgctxt "h30e3045bg5e74g4ecdg90d1g36499b921771"
msgid "I'll be asking the questions."
msgstr "질문은 내가 하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = 8149285c-6227-5597-871d-57944ef6d39b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 81ec7f22-e5af-1171-66e7-c0547e036763_MindHasBeenRead = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:8149285c-6227-5597-871d-57944ef6d39b
msgctxt "h8ac41319g7326g4176g8cadg3d7a933a6aed"
msgid ""
"<i>Can't be 'ere to see the True Souls. Those types don't even bother to "
"</i>wait<i>.</i>"
msgstr "<i>참된 영혼들을 만나러 왔을 리는 없겠지. 그런 부류는 기다리지도 않아.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = 82569b9e-448c-6dd6-e58b-446bae38f129
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_Quest_Learnt3LeadersTwoNames = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:82569b9e-448c-6dd6-e58b-446bae38f129
msgctxt "h0d8a3590g3836g4882gaeaegaa69d50ebc88"
msgid "You 'ere to see Priestess Gut, Boss Ragzlin, or the drow?"
msgstr "여사제 거트, 라그즐린 두목, 아님 드로우 중 누구를 만나러 왔나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Player
#. NodeID = 84e07daa-e1a6-9f4d-504a-dc2fdab8dd29
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:84e07daa-e1a6-9f4d-504a-dc2fdab8dd29
msgctxt "h83244398g3de0g4670ga1bdg17200c624891"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = 88697461-2336-8ab2-b44d-9f2849cbc2a5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_State_WyllLearnedAllLeaders = True
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_Knows_LeaderNameDrow = True
#.   Quest:
#.     - DEN_Conflict_SUB_Goblin.GOB_LearntAllNames(1) = True
#. TagRule: DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:88697461-2336-8ab2-b44d-9f2849cbc2a5
msgctxt "h69888f75g8213g4cf4g95c8gbc7fcf7c7bc1"
msgid ""
"Then Minthara arrived. And now you - the Absolute's keen on drow, seems like."
msgstr "그러더니 민타라가 왔지. 이젠 당신까지, 절대자께서 드로우를 좋아하시는 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = 88697461-2336-8ab2-b44d-9f2849cbc2a5
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_State_WyllLearnedAllLeaders = True
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_Knows_LeaderNameDrow = True
#.   Quest:
#.     - DEN_Conflict_SUB_Goblin.GOB_LearntAllNames(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:88697461-2336-8ab2-b44d-9f2849cbc2a5
msgctxt "hcfb8df23gc51bg460agb7d9gaeb83719f7f0"
msgid ""
"Then the drow arrived. And now you - the Absolute 'as big plans for all of "
"us, seems like."
msgstr "그러더니 그 드로우가 왔지. 이젠 당신까지, 절대자께서 모두를 위한 계획을 세우고 계신 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = 8b1714df-9fd5-0dff-5780-f297c2b07d66
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:8b1714df-9fd5-0dff-5780-f297c2b07d66
msgctxt "h1a8fe492gb0c2g4a2fg90b1gfb505f54281c"
msgid "Won't ask again - what's your business?"
msgstr "다시 묻지 않을 거야 - 뭐하러 온거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Narrator
#. NodeID = 8cb0dd1d-ae3d-87ac-2aa0-59809d6bf892
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount5(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount5(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:8cb0dd1d-ae3d-87ac-2aa0-59809d6bf892
msgctxt "hefd11a92gdd0fg4a81g821dg257121eefc28"
msgid ""
"*Your blood runs quicker, feeding the gnawing absence at the centre of your "
"mind.*"
msgstr "*피가 더 빨리 흐르면서, 당신의 정신 한가운데를 좀먹는 허전함을 양분으로 채웁니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Narrator
#. NodeID = 8cef7022-2d16-4f48-4583-0ecb75db968c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount3(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount3(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:8cef7022-2d16-4f48-4583-0ecb75db968c
msgctxt "hefafc9b7g5f98g4256gb25agddcae1fa316b"
msgid "*Your mind lurches, reeling suddenly as if... bitten.*"
msgstr "*뭔가에 깨물린 것처럼 느닷없이 정신이 휘청거립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Player
#. NodeID = 8d7a61c4-1f61-cd2b-c9d4-4e0f5b8ec4e5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Absolute_Knows_TrueSoul = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:8d7a61c4-1f61-cd2b-c9d4-4e0f5b8ec4e5
msgctxt "ha7d4e3a3g4015g46f6gb07bg63a09a21bd89"
msgid "Why are you calling me a 'True Soul'?"
msgstr "왜 나를 '참된 영혼'이라고 부르는 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Player
#. NodeID = 9408d256-0cf6-3ff1-3412-9a481e534de8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DROWELF(1) = True
#. SetFlags:
#.   Global:
#.     - GOB_GoblinThroneCheckpoint_State_DrowAutoPass = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:9408d256-0cf6-3ff1-3412-9a481e534de8
msgctxt "h76f34388g7ae6g417fga239g8b67d278d6d9"
msgid "I've got an audience with the one in charge."
msgstr "너희 대장을 알현하러 왔다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Player
#. NodeID = 97928429-577b-1269-e700-aedef450b33b
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 0
#. CheckFlags:
#.   Local:
#.      - 81ec7f22-e5af-1171-66e7-c0547e036763_MindHasBeenRead = False
#.   Script:
#.      - GEN_CanDetectThoughts_2 = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:97928429-577b-1269-e700-aedef450b33b
msgctxt "h88951d8fga517g475agb5f5gdcde108120ff"
msgid "<i>Probe her thoughts.</i>"
msgstr "<i>그녀의 생각을 읽는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = 9885ec2a-d5e4-b9be-0c1e-e9f0dadba788
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_GuardUpset_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:9885ec2a-d5e4-b9be-0c1e-e9f0dadba788
msgctxt "hbe0063deg8e69g4eeega4f8gb57a02f0dfc9"
msgid "State yer business. <i>Now.</i>"
msgstr "용건을 대. <i>당장.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Narrator
#. NodeID = 9b836eeb-c3dc-127f-b62a-4a17ec5c7889
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount2(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:9b836eeb-c3dc-127f-b62a-4a17ec5c7889
msgctxt "h2656eec6gf906g4304g8dd4g2bf4cb47b1c2"
msgid ""
"*Something stirs deep within you, hungry and alert... it's taking something "
"you'll never get back.*"
msgstr "*몸 깊숙한 데서 굶주리고 기민한 존재가 꿈틀댑니다... 잃으면 되찾지 못할 뭔가를 좀먹고 있군요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Player
#. NodeID = 9e41fe33-f239-0373-2fa2-40db1a0c460f
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: !DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:9e41fe33-f239-0373-2fa2-40db1a0c460f
msgctxt "h755b23abgd817g4234gbb8fg545ae7d3530e"
msgid "I've got an audience with the drow."
msgstr "드로우를 알현하려 한다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Player
#. NodeID = 9e9a006e-fa37-7f01-15b5-3d7ac1558879
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:9e9a006e-fa37-7f01-15b5-3d7ac1558879
msgctxt "h804f4dd3ga990g4a7fg819cg19f6cbf3cd77"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Narrator
#. NodeID = a10e8a08-c9ad-5987-69be-9940d31fc80e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount4(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount4(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:a10e8a08-c9ad-5987-69be-9940d31fc80e
msgctxt "h7bceb273gd4aag4a8aga684g6f531e373013"
msgid ""
"*A shadow swims across your vision, and a familiar voice tells you to be "
"calm. You are loved.*"
msgstr "*그림자가 낀 듯이 눈앞이 흐려지더니, 익숙한 목소리가 당신을 달래줍니다. 사랑이 느껴집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = a2cdeffb-34fe-95c0-2f1a-3ed112c4bba6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TeleportOutOfTrespass(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:a2cdeffb-34fe-95c0-2f1a-3ed112c4bba6
msgctxt "h3bdfb4d3g4c3dg4745gb3ddg1b13968c7dba"
msgid ""
"Likes of you? <i>Please.</i> Only boss you need concern yourself with is me. "
"Out. <i>Now.</i>"
msgstr "너 같은 놈을? <i>제발.</i> 네가 신경 써야 할 대장은 나뿐이야. 나가. <i>당장.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Narrator
#. NodeID = aa67fc6b-e84e-2657-d1d7-bdc3f1c99143
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:aa67fc6b-e84e-2657-d1d7-bdc3f1c99143
msgctxt "ha3c60047g5c14g449cga0eag5441b5ee5eb3"
msgid "*A shiver runs across your mind... You feel sated.*"
msgstr "*전율이 불현듯 머릿속을 스쳐 지나가고... 만족감이 듭니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = ad9b157f-72de-150e-dd07-03038da737ce
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_GoblinThroneCheckpoint_Pass = True
#. TagRule: DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:ad9b157f-72de-150e-dd07-03038da737ce
msgctxt "h0f3bd64bgee66g4355g8209ge5d0e964b178"
msgid ""
"...Well, I didn't say <i>that</i>. But you'll need to be more specific. "
"Absolute's blessed us with <i>three</i>."
msgstr ""
"...뭐, <i>그런</i> 뜻으로 말한 건 아니야. 하지만 조금 더 자세히 말해 줘야겠는데. 절대자께서는 <i>세 분을</i> "
"축복하셨지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = ad9b157f-72de-150e-dd07-03038da737ce
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_GoblinThroneCheckpoint_Pass = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:ad9b157f-72de-150e-dd07-03038da737ce
msgctxt "he8844f6bg0aedg40a3g9d58gbbcf21eb50c0"
msgid ""
"...Well, I didn't say <i>that</i>. But you'll need to be more specific, "
"mate. Absolute's blessed us with <i>three</i>."
msgstr ""
"...아냐, <i>그런</i> 뜻으로 말한 건 아니었어. 하지만 더 구체적으로 말해 줘, 친구. 절대자님은 우리 가운데 <i>세 명</"
"i>에게 축복을 내려주셨어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = b14b50aa-a7f4-6608-5ce9-e2af100c2ce1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:b14b50aa-a7f4-6608-5ce9-e2af100c2ce1
msgctxt "h5c04e852g6621g431cgad90gf169e3b2df89"
msgid ""
"The Absolute is gatherin' us all together. For something <i>big</i>, I "
"reckon."
msgstr "절대자님이 우릴 모두 모으시고 있습니다. 뭔가 <i>큰</i> 일을 벌이신다고 하더군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Player
#. NodeID = b9435665-a6c7-45cc-3430-946dccc60745
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:b9435665-a6c7-45cc-3430-946dccc60745
msgctxt "h4c85f1edgf11fg4f3dg861dg6b9ab1aa6a47"
msgid "Was there a druid among these intruders?"
msgstr "침입자 중에서 드루이드도 있었나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Narrator
#. NodeID = bce41af2-972e-8057-397a-7b3043bda4da
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_GuardUpset_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:bce41af2-972e-8057-397a-7b3043bda4da
msgctxt "h4a7c3692g370bg4f75g8c4fg94c5925a3f27"
msgid ""
"*A strange symbol glows, marked on their flesh, and something within you "
"stirs in response.*"
msgstr "*그들의 살갗에 새겨진 기묘한 상징이 빛나고, 이에 반응하여 당신 내면의 무언가가 꿈틀거립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = be72b802-a5bb-17a8-1605-f469f47dec6d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:be72b802-a5bb-17a8-1605-f469f47dec6d
msgctxt "hf8880570gcc5bg492fg94eag7d37a1be454b"
msgid ""
"But the Absolute says we're all makin' nice now. So in you go, I s'pose."
msgstr "하지만 절대자께서 말씀하시길 우리 모두 이제 잘 지내야 한다고 하셨어. 그러니까 들어가 봐도 될 거 같애."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Narrator
#. NodeID = bea565b5-056f-8a76-c3ba-e484f1760597
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - GLO_TadpoleIntro_NPC(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:bea565b5-056f-8a76-c3ba-e484f1760597
msgctxt "h43b07602gc79cg40e9gbd85g0d9c18b7319f"
msgid "*As the symbol glows, power courses through you. <i>Authority</i>.*"
msgstr "*문양이 빛나며, 몸에 흐르는 힘이 느껴집니다. <i>권위</i>.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Player
#. NodeID = bf7da2bf-4134-dbb1-8ccd-8d980a35c274
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:bf7da2bf-4134-dbb1-8ccd-8d980a35c274
msgctxt "hcc52e614g6f90g4ad1gbd64g4f08450fa82a"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Player
#. NodeID = c2f02288-8d0f-4cf2-649f-4c3cef69fd91
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 25
#. CheckFlags:
#.   Dialog:
#.      - GOB_GuardUpset_State_FailedLie(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:c2f02288-8d0f-4cf2-649f-4c3cef69fd91
msgctxt "hf3074b8dg4e11g4be0gbcd9g0bc5deaadacf"
msgid "It <i>is</i> loud. I think I lost my way in the confusion."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Player
#. NodeID = c2f68d93-aa2f-70ef-6d18-3ccda9cfefa4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Absolute_Knows_TrueSoul = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:c2f68d93-aa2f-70ef-6d18-3ccda9cfefa4
msgctxt "h602e01d0ga5b5g4647gaa7bga2b13b5e91bc"
msgid "'Other' True Souls? What do you mean?"
msgstr "'다른' 참된 영혼이라고? 무슨 뜻이지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = c5b09a53-9467-0a5e-dda5-5671077a1f06
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:c5b09a53-9467-0a5e-dda5-5671077a1f06
msgctxt "h5044b593g3bf8g4e12gb579g5580c49789ec"
msgid "Do ya now? Might feel different once she puts a burnin' brand to ya. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = c887f646-6e29-769b-053c-b199b46b9cb3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_Quest_Learnt3LeadersAllNames = True
#. TagRule: DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:c887f646-6e29-769b-053c-b199b46b9cb3
msgctxt "h51e847cagb183g4b8fg8319ga2a52cdaf13d"
msgid ""
"At first it were just Priestess Gut and Boss Ragzlin. Then Minthara came "
"along."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = c887f646-6e29-769b-053c-b199b46b9cb3
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_Quest_Learnt3LeadersAllNames = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:c887f646-6e29-769b-053c-b199b46b9cb3
msgctxt "h832c9d8aga586g4cd9gb78egb50ef9b4b120"
msgid ""
"At first we thought it were just Priestess Gut and Boss Ragzlin. Then the "
"drow came along."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Narrator
#. NodeID = cd08645c-d807-8525-f754-13716a1471fd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - GLO_TadpoleIntro_NPC(1) = False
#. SetFlags:
#.   User:
#.     - GLO_TadpoleIntro_NPC(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:cd08645c-d807-8525-f754-13716a1471fd
msgctxt "hf0922f20gff88g4abag9c88gd1ff6e4ea275"
msgid ""
"*A strange symbol glows, marked on their flesh, and something within you "
"stirs in response.*"
msgstr "*그들의 살갗에 새겨진 기묘한 상징이 빛나고, 이에 반응하여 당신 내면의 무언가가 꿈틀거립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = d12d88a1-80f9-9385-83f2-11bd95e6d3e3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_GuardUpset_State_ConvincedTrueSoul(1) = True
#.   Global:
#.      - GOB_GoblinThroneCheckpoint_Pass = True
#.      - GLO_Halsin_Knows_IsMissing = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:d12d88a1-80f9-9385-83f2-11bd95e6d3e3
msgctxt "h8ab9b0f1g3bdcg4eceg9d88g83c52bf19852"
msgid ""
"Forgive my tone just now, True Soul. Had a few intruders a while back. Just "
"bein' careful."
msgstr "아까 말투는 용서해 줘, 참된 영혼. 얼마 전에 침입자가 있었어서 말이야. 조심하는 것뿐이라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = d1f35ae2-0762-5d0e-c7e6-11f3bbaf4d34
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_GuardUpset_State_FailedLie(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:d1f35ae2-0762-5d0e-c7e6-11f3bbaf4d34
msgctxt "h394741a6ga2bbg4382gb988g87058a3df346"
msgid ""
"That you have. Now - asked you a <i>question</i>, lovely. What's your "
"business 'ere?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = d4f62661-0e0e-1043-0e4b-ca59170bfd20
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TeleportOutOfTrespass(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:d4f62661-0e0e-1043-0e4b-ca59170bfd20
msgctxt "h60f66c1cgbcdeg4cc9g8f56gada98eee9940"
msgid ""
"Good for you. Turn back now and I won't spread yer <i>business</i> all over "
"that wall."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = d55e5be4-ae3f-f97a-baf8-45c89b9e0e26
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:d55e5be4-ae3f-f97a-baf8-45c89b9e0e26
#, fuzzy
msgctxt "h557c9cc1gbdefg497cga88fg5fdc15b76f0b"
msgid ""
"Well... cuz that's what you <i>are</i>, innit? One of them as hears our "
"thoughts - and the voice of the Absolute."
msgstr "그야... 당신이 그들 중 하나 아니십니까? 그들은 우리 생각을 읽고 절대자의 말씀을 전하시죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = d7f26b82-40ea-7ac8-6838-d6044488cbd3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_GoblinThroneCheckpoint_Bypassed = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:d7f26b82-40ea-7ac8-6838-d6044488cbd3
msgctxt "h08684c59g42a1g42d7g9685g84bab6525890"
msgid ""
"Oi! Get your lardy arse out of the doorway. Serious work goin' on in 'ere."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = d8fe8bcd-73f3-7343-fdfb-1c53e2fa511c
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:d8fe8bcd-73f3-7343-fdfb-1c53e2fa511c
msgctxt "ha75bf3e3g5500g45c7gacc1g13599df939d8"
msgid ""
"Between the two of you, we're swimmin' in drow. Go ahead, I'm sure she's "
"expectin' you."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = d926f72b-933d-db51-9158-c0486cf1eea8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_GuardUpset_State_FailedLie(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:d926f72b-933d-db51-9158-c0486cf1eea8
msgctxt "he46c6fd7gcbb3g4a89g98e8gc1207cdb008d"
msgid ""
"You think I can't tell true drunk from false? Mate, I been guzzlin' grog "
"since the <i>teat</i>."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Narrator
#. NodeID = dbe89094-9075-be9a-3949-5069cfa353a2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Tag:
#.     - TRUESOUL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:dbe89094-9075-be9a-3949-5069cfa353a2
msgctxt "he03acf3eg8fb5g4c36ga71eg28ae0481f400"
msgid ""
"*Your mind is full, bursting with ecstasy and terror. Finally, it is coming. "
"You are becoming.*"
msgstr "*당신의 정신이 황홀경과 공포로 가득 차오릅니다. 마침내, 때가 됐군요. 당신은 변화 중입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Player
#. NodeID = e04b49b3-f1f0-6322-cacf-f3867628be1e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Absolute_Knows_TrueSoul = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:e04b49b3-f1f0-6322-cacf-f3867628be1e
msgctxt "ha672066fg40cdg4f32gae03gff9ac5b56c95"
msgid "Why are you calling me a 'True Soul'?"
msgstr "왜 나를 '참된 영혼'이라고 부르는 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Player
#. NodeID = e12fc2af-84d2-d229-4d66-d717b09cd194
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 81ec7f22-e5af-1171-66e7-c0547e036763_MindHasBeenRead = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:e12fc2af-84d2-d229-4d66-d717b09cd194
msgctxt "h9eb7d2ebga868g41f3ga372g8431921c75be"
msgid "I'm here to see the True Souls. Do you want to keep them waiting?"
msgstr "나는 참된 영혼들을 만나러 왔다. 그들을 계속 기다리게 할 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Player
#. NodeID = e27302b6-ce95-8b98-c2db-a3159ebaa6a4
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 5
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#.      - ILLITHID(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:e27302b6-ce95-8b98-c2db-a3159ebaa6a4
msgctxt "h51d214e9ge80fg4a6ega087ga5eb1fbf86a9"
msgid "You have - and I'm telling <i>you </i>to mind your manners."
msgstr "그랬지, 그리고 난 <i>네가 </i>존중을 표하라고 하고 있고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Narrator
#. NodeID = e4f4f0b0-e550-a4f9-1c98-70edb0b4aaf4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount2(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:e4f4f0b0-e550-a4f9-1c98-70edb0b4aaf4
msgctxt "hca1c1c63g0c76g4986g8e9cge21ca1239ccc"
msgid ""
"*Something stirs deep within you, hungry and alert... it's taking something "
"you'll never get back.*"
msgstr "*몸 깊숙한 데서 굶주리고 기민한 존재가 꿈틀댑니다... 잃으면 되찾지 못할 뭔가를 좀먹고 있군요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Player
#. NodeID = e52655fa-b449-211d-26ec-e60aab2b6df7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TRUESOUL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:e52655fa-b449-211d-26ec-e60aab2b6df7
msgctxt "h3d9a2011g2824g4cdbgab28g5e6ee681be02"
msgid "You have - and I'm telling <i>you </i>to mind your manners."
msgstr "그랬지, 그리고 난 <i>네가 </i>존중을 표하라고 하고 있고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = e8ddbd51-1c79-1fce-edd3-c2d3b5fccd7f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:e8ddbd51-1c79-1fce-edd3-c2d3b5fccd7f
msgctxt "hb435d1b7gd199g4cfcg928dg316a89755951"
msgid "Throne room's at the back. He's <i>communin'</i>, mind, so step soft."
msgstr "왕좌의 방은 뒤편에 있어. 그는 정신을 <i>교감</i> 중이니, 조용히 다가가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = ece6e2c7-411c-fe6f-b9c8-435b672e89d9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_Knows_LeaderNameKing = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:ece6e2c7-411c-fe6f-b9c8-435b672e89d9
msgctxt "h02fdb577g1e80g4c72gac12g1fb1d6fd6377"
msgid ""
"Well <i>look</i>, big-boots 'ere has an appointment with Dror Ragzlin "
"hisself!"
msgstr "<i>이거 봐라</i>, 이 발이 넓은 분이 드롤 라그즐린 님에게 용건이 있대!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = edb01ffc-73ba-0442-0a05-0815301d40e6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TeleportOutOfTrespass(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:edb01ffc-73ba-0442-0a05-0815301d40e6
msgctxt "h2d80b175g523cg4861gba6cg73952919a97e"
msgid ""
"<i>Outside</i>, you bloody pisspot. Tell the rest of 'em to keep it down and "
"all - <i>work</i> goin' on in 'ere."
msgstr ""
"<i>나가</i>, 이 빌어먹을 오줌통 자식아. 그리고 나머지 녀석들에게 조용히 좀 하라고 해, 이 안에선 <i>일을 </i>하고 "
"있으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Player
#. NodeID = eed7f536-4410-776d-709e-0cffd9eb7e5a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_Knows_LeaderNameDrow = True
#. TagRule: DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:eed7f536-4410-776d-709e-0cffd9eb7e5a
msgctxt "h5af212e9g69abg4710g84acg485936db8668"
msgid "I've got an audience with Minthara."
msgstr "민타라를 알현하러 왔다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Player
#. NodeID = f08710a2-054c-5fee-1624-c01a446b1a9c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 5
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#.      - ILLITHID(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:f08710a2-054c-5fee-1624-c01a446b1a9c
msgctxt "hf2a9a13fgfa21g4ca0g8364g3eb280648ced"
msgid "I'll be asking the questions."
msgstr "질문은 내가 하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Player
#. NodeID = f17a8274-33ef-7381-fbf6-5836da9592bf
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:f17a8274-33ef-7381-fbf6-5836da9592bf
msgctxt "h08eb8739g3077g4610ga7a1g57435cf24330"
msgid "That was the sound of your friends dying. Care to join them?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = f2378357-c753-6918-d653-2a0e0fe6671c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:f2378357-c753-6918-d653-2a0e0fe6671c
msgctxt "hd2727504gc2b5g4ef6g8ec6gfd0b800e419e"
msgid ""
"'Audience' is right. She's an uppity one and no mistake, but she knows 'er "
"business."
msgstr "'알현'이라. 그녀가 거만하고 실수를 용납하진 않지만, 자기가 무슨 일을 하고 있는지는 잘 알고 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Player
#. NodeID = f56a8fc6-5087-e3db-1ca5-1f2086405910
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:f56a8fc6-5087-e3db-1ca5-1f2086405910
msgctxt "h433030feg7687g48e4g8bf2g07fe020468ab"
msgid "I'm here for Ragzlin."
msgstr "라그즐린을 만나러 왔다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Player
#. NodeID = f9007ba8-bdd7-fb42-f18a-6bd31a362dd6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TeleportOutOfTrespass(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:f9007ba8-bdd7-fb42-f18a-6bd31a362dd6
msgctxt "h8eaf7b5dg9255g4bb9g8a00gd286198247b2"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Player
#. NodeID = f9cf8b2a-a67e-4765-1219-0c4c68aaeb98
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 20
#. CheckFlags:
#.   Dialog:
#.      - GOB_GuardUpset_State_FailedLie(1) = False
#.   Tag:
#.      - BARD(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:f9cf8b2a-a67e-4765-1219-0c4c68aaeb98
msgctxt "h877ce359gc5a0g48e4g9b74g729007dfa961"
msgid "B-booze. Bit much. <i>Baffroom?</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Player
#. NodeID = fb6b1cec-6c55-431a-e583-b91eabc4445e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:fb6b1cec-6c55-431a-e583-b91eabc4445e
msgctxt "h95180df0gf941g4f09ga9c9g4e2d5362a009"
msgid "You <i>will </i>let me in."
msgstr "넌 날 <i>들여보내 줘야</i> 할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Player
#. NodeID = fbc8d82c-ad18-fd3c-23ad-ce83caf5223d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:fbc8d82c-ad18-fd3c-23ad-ce83caf5223d
msgctxt "hbda44000g405dg47e8g996fg1384486e8e0d"
msgid "Who's in charge around here?"
msgstr "이곳의 책임자가 누구지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Narrator
#. NodeID = fc28556a-26ba-ff6e-60b9-e4df92b89011
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:fc28556a-26ba-ff6e-60b9-e4df92b89011
msgctxt "h2e189e63g20b7g48aegb3c5g3d43b0ebcc2b"
msgid ""
"*The mark glows, but you feel nothing in response. Your illithid power is "
"beyond reach until you rest.*"
msgstr "*문양이 빛나지만, 어떤 반응도 느껴지지 않습니다. 일리시드 능력을 더 사용하려면 휴식을 취해야 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset
#. Speaker = Warrior Trinzas
#. NodeID = fe643fc4-1656-b13a-5424-a8b45f179db8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Absolute_Knows_TrueSoul = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardUpset:fe643fc4-1656-b13a-5424-a8b45f179db8
msgctxt "ha7b23bd4g188ag4e4bg98b5g7020c2eeb399"
msgid ""
"Well... cos that's what you <i>are</i>, innit? One of them as hears our "
"thoughts - and the voice of the Absolute."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardVulgar
#. Speaker = Warrior Bez
#. NodeID = 3f911b9c-c4c7-fa8c-7743-4ce0b82f2314
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_GuardVulgar_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_GuardVulgar_HasMet(1) = True
#. TagRule: LOLTHDROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardVulgar:3f911b9c-c4c7-fa8c-7743-4ce0b82f2314
msgctxt "hc6c42840gac59g437cg8e65gf87cefba223a"
msgid ""
"Spiders are down there, boss. Lovely spiders. Keep 'em real clean, we do."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardVulgar
#. Speaker = Warrior Bez
#. NodeID = 3f911b9c-c4c7-fa8c-7743-4ce0b82f2314
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_GuardVulgar_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_GuardVulgar_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardVulgar:3f911b9c-c4c7-fa8c-7743-4ce0b82f2314
msgctxt "h43c1a2c0gbca4g4a86g80ceg94ae6713840f"
msgid ""
"Unless you like big, bristlin' hairy legs, I wouldn't go down there, mate. "
"Tha's the spider pit."
msgstr "네가 빠르게 움직이는 크고 털이 난 다리들에 푹 빠진 게 아니라면 저 아래로 가지 않는 게 좋을걸, 친구. 거어긴 거미굴이라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardVulgar
#. Speaker = Warrior Bez
#. NodeID = 6ff7ba7a-c254-c903-b425-cc63858d199e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_GuardVulgar_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardVulgar:6ff7ba7a-c254-c903-b425-cc63858d199e
msgctxt "h2739c028g6c5dg45d3g9fdbg4133bf7e3f44"
msgid ""
"If you're headin' down to the spiders, give 'em a tickle. They're <i>real</"
"i> friendly..."
msgstr "거미들에게 내려가는 거라면, 약간 간질여봐. 그것들은 <i>엄청나게</i> 친근하거든..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_InnerCheckpoint_3way_UpsetAndCapturedGoblins
#. Speaker = Warrior Trinzas
#. NodeID = 03962d79-a730-86df-0e1d-c055626e9921
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_GoblinThroneCheckpoint_Pass = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_InnerCheckpoint_3way_UpsetAndCapturedGoblins:03962d79-a730-86df-0e1d-c055626e9921
msgctxt "h27e365b0ge2f8g43ccgb157g5d2dab301fc0"
msgid ""
"Just get your friend branded proper, right Sazza? Got better things to do th-"
msgstr "그냥 네 친구가 제대로 낙인 찍힐 수 있게 도와줘. 알았어, 삿자? 난 더 중요한 일들이-"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_InnerCheckpoint_3way_UpsetAndCapturedGoblins
#. Speaker = Warrior Trinzas
#. NodeID = 23b95729-62ea-0796-5e85-3af1f1f69ef4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_InnerCheckpoint_3way_UpsetAndCapturedGoblins:23b95729-62ea-0796-5e85-3af1f1f69ef4
msgctxt "hf4abc5e2gdb33g4a3cg8de7g67162c82a6cc"
msgid "Oi! Ain't no party in 'ere -"
msgstr "어이! 이 안은 파티장이 아니야-"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_InnerCheckpoint_3way_UpsetAndCapturedGoblins
#. Speaker = Warrior Trinzas
#. NodeID = 620cb875-bae4-f641-7e7b-efe0d45714d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_InnerCheckpoint_3way_UpsetAndCapturedGoblins:620cb875-bae4-f641-7e7b-efe0d45714d4
msgctxt "hd87fc0dbg395cg4537g8200g28b2cbfb55d7"
msgid "My arse - what's a True Soul want with any mate o' yours?"
msgstr "웃기고 있네 - 참된 영혼이 네 짝에게 원하는 게 뭔데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_InnerCheckpoint_3way_UpsetAndCapturedGoblins
#. Speaker = Sazza
#. NodeID = 6446aa1a-20c6-0acc-f65c-e6833d579deb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_InnerCheckpoint_3way_UpsetAndCapturedGoblins:6446aa1a-20c6-0acc-f65c-e6833d579deb
msgctxt "h4f8ce21fg8574g44b7g8be6g8653c62992d1"
msgid "Shut it, Graw. Olak cleared us - got a visitor for the drow, I do."
msgstr "닥쳐, 그로. 올라크가 우릴 들여보내줬어. 난 그 드로우에게 손님을 데려가야 한단 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_InnerCheckpoint_3way_UpsetAndCapturedGoblins
#. Speaker = Sazza
#. NodeID = 941da246-957a-d31f-1788-798b8d49d6ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_InnerCheckpoint_3way_UpsetAndCapturedGoblins:941da246-957a-d31f-1788-798b8d49d6ea
msgctxt "h1649b939g4567g4216g97edgc6275ae805ef"
msgid ""
"Private business, that is. <i>Raidin'</i> business. But if anyone wants a "
"pisspot guarded, we'll call."
msgstr "그건 사적인 일이야. <i>습격</i>에 관한 일이지. 그래도 주정뱅이 안내해달란 사람 있으면, 우리가 부를게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_InnerCheckpoint_3way_UpsetAndCapturedGoblins
#. Speaker = Sazza
#. NodeID = a6fdfce5-fbe1-1da5-30b6-1238ebf12a7c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_GoblinThroneCheckpoint_Pass = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_InnerCheckpoint_3way_UpsetAndCapturedGoblins:a6fdfce5-fbe1-1da5-30b6-1238ebf12a7c
msgctxt "hf29333f6g47cdg4e4cg9f6agf619a876cd4c"
msgid "No you don't. Come on, then."
msgstr "싫어, 네가 해. 자, 따라와."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_InnerCheckpoint_Backup_01
#. Speaker = Tracker Fezk
#. NodeID = cfade7bc-dd32-d941-87e6-fb951a415103
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_InnerCheckpoint_Backup_01_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_InnerCheckpoint_Backup_01_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_InnerCheckpoint_Backup_01:cfade7bc-dd32-d941-87e6-fb951a415103
msgctxt "hce0e009egfb44g41dag8eb1g3ff4e9b7af77"
msgid ""
"'S good you ain't causin' trouble. Boss means business, now he's got the "
"Absolute in his ear."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_InnerCheckpoint_Backup_01
#. Speaker = Tracker Fezk
#. NodeID = e463e446-ce90-4cb1-555d-0a02c6fc3ee2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_InnerCheckpoint_Backup_01_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_InnerCheckpoint_Backup_01:e463e446-ce90-4cb1-555d-0a02c6fc3ee2
msgctxt "hbdf97c16g326dg4735gb492g49edf05ad87f"
msgid ""
"Before the Absolute, I'd've gut your kind without thinkin' twice. Funny, "
"innit?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_InnerCheckpoint_Backup_02
#. Speaker = Tracker Tizg
#. NodeID = 36a83972-077e-eaf3-9eb8-019c39056c5f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_InnerCheckpoint_Backup_02_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_InnerCheckpoint_Backup_02:36a83972-077e-eaf3-9eb8-019c39056c5f
msgctxt "h610d38d8g0577g4a81g8dc1g602c40fc35c3"
msgid ""
"Go on. If you've business in 'ere, best not to keep a True Soul waitin'."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_InnerCheckpoint_Backup_02
#. Speaker = Tracker Tizg
#. NodeID = d951e378-7fff-f8ce-f163-80d190cee435
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_InnerCheckpoint_Backup_02_HasMet(1) = False
#. SetFlags:
#.   Dialog:
