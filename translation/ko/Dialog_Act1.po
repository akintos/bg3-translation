msgctxt "hbab5bc0fg94ebg4c37ga949g2e2f23b3cdd8"
msgid "Gnomes. Gnomes gnomes gnomes."
msgstr "노움. 노움 노움 노움."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_CorpseDisposer_Companion
#. Speaker = Viss
#. NodeID = 3f6830b5-e3c6-fb89-2f7f-9bd1263c844a
