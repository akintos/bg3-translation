msgctxt "h613cd87cg3149g4a6bgb739g3d486e4a416f"
msgid "The hag's lair. Hardly an improvement on the Underdark..."
msgstr "해그의 굴이야. 언더다크에서 딱히 개선되진 않았네..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_FairyRings_PAD_TeleportedFromUnderdarkToHag
