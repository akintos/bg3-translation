msgctxt "h99869cd4g15f3g4635gb5bfg3ed8db8409ef"
msgid ""
"((*...floating, knowing, seeing, hearing. all together, never apart...*))"
msgstr "((*...부유하며, 알고 있으며, 보고 있으며, 듣고 있습니다. 항상 함께, 결코 떨어지지 않고...*))"

