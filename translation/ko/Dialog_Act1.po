msgctxt "h28139eb2g7ad1g45b9g8a9fgd9395f90d044"
msgid "Closer... I need to get closer!"
msgstr "더 가까이... 더 가까이 다가가야 해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerCharmed
