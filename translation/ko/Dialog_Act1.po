msgctxt "h4cd87f5dg0405g48edgad8eg3f1d48cbc2ba"
msgid "Careful, your lordness. That drum's for callin' backup."
msgstr "조심해 주십쇼, 나리. 그 북은 지원군을 부를 때 쓰는 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_AlarmUsedReaction
#. Speaker = Sentinel Olak
#. NodeID = 3730affd-1830-30a6-368a-554e23cbf81b
#. HandlePath = TaggedText[0].TagText[0]
