msgctxt "h2a30f08aga893g42c8g823dga8dcad7b80a4"
msgid "*You stash the bag. Something clinks among the coins.*"
msgstr "*주머니를 빼냈습니다. 동전 사이에서 무언가가 덜그럭 소리를 냅니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice
