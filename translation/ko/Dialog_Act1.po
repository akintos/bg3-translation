msgctxt "hab79516bg86a8g4efbgae44gb7f106729b62"
msgid "A <i>clan-sen</i>. Just what we needed."
msgstr "<i>클란센</i>이다. 딱 필요하던 거구만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarLoyalFocused
