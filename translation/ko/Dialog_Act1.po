msgctxt "hb7e7e315gaa4fg4b78ga4abg007a162013db"
msgid "Oi, stand back! Where'd you come from?"
msgstr "야, 물러서! 어디서 온 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Trespassing
#. Speaker = Narrator
