msgctxt "hff61380eg6c1fg44b7gb92eg86f752fc7af1"
msgid "What's in it for me?"
msgstr "그래서 내게 좋을 게 뭐야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_UnfortunateGnome_TiedUp
#. Speaker = Barcus Wroot
#. NodeID = 20b43638-bf66-767c-71fe-b0beecaf392d
