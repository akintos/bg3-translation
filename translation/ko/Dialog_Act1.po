msgctxt "h6b638065g2d93g4675gb86eg64ad9e7d6baa"
msgid "What happened to you?"
msgstr "무슨 일이 있었지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_UnfortunateGnome_Dead
#. Speaker = Barcus Wroot
#. NodeID = f536e333-8066-eb0b-5b3b-06cc9f3b5bdd
