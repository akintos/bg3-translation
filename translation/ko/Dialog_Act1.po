msgctxt "h70c29fa3g18fbg47c1g8b12g7d40c745c4f6"
msgid "This is ridiculous."
msgstr "어처구니가 없네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin_AD_Guards
#. Speaker = Arka
#. NodeID = 756928b9-9805-3b90-c7a4-b8f02a55e820
