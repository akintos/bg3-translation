msgctxt "h4a39d4c9g6e79g48a8g9f74g1b460cbe5850"
msgid "Hells - it won't give."
msgstr "망할, 꼼짝도 안 하는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_StatuePuzzle_PAD_AthleticsCheckFailed
#. Speaker = Player
