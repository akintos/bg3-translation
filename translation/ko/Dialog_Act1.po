msgctxt "h25c1d1d9g4768g481bg9d9cga9771ef6287d"
msgid ""
"*Blood-smell<i>. Life</i>-smell. Not like the great hollow below, which "
"smells only of death.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RatRacket_LocalRat_001
#. Speaker = Narrator
#. NodeID = 9c2fc8fa-b661-1861-e09f-ec4751b9212a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_RatRacket_LocalRat_001_HasMet(1) = True
