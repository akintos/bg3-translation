msgctxt "h186b8617g0a58g4589gb751gc92dd9c4e4bc"
msgid "Erm, Absolute's blessings, sir."
msgstr "음, 절대자님의 축복을, 나으리."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinWily
#. Speaker = Tracker Tozad
#. NodeID = 8e68596f-c75c-0a6c-d142-e5140d1d4c81
