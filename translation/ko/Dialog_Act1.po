msgid "<i>Ngh</i>... it hurts..."
msgstr "<i>으</i>...아파..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_OwlBear_LastCub
#. Speaker = Owlbear Cub
#. NodeID = 2f804bd9-0fe6-6e3c-9ea8-fc68f49b8e22
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
