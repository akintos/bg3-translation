#. NodeID = be90a946-4d97-2658-37f7-b0f2eb401243
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_FairyRings_PAD_TeleportedFromHagToSwamp:be90a946-4d97-2658-37f7-b0f2eb401243
msgctxt "h103edde9ge82dg4f20gbccfg08cb952ebe15"
msgid ""
"The swamp. Of course. Wouldn't want to be teleported anywhere pleasant, "
"naturally."
msgstr "늪지대라. 당연하지. 여기보다 좋은 순간이동 목적지가 어디 있겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_FairyRings_PAD_TeleportedFromHagToSwamp
#. Speaker = Player
#. NodeID = be90a946-4d97-2658-37f7-b0f2eb401243
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_FairyRings_PAD_TeleportedFromHagToSwamp:be90a946-4d97-2658-37f7-b0f2eb401243
