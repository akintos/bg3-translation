msgctxt "hf0ace3c7g39a6g45a4gbe4ag226137d20db2"
msgid "Too bad. Time to die."
msgstr "유감이군. 죽어라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Blue Jay
#. NodeID = 19d1700b-6338-afff-c5df-cf9546e8f5b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:19d1700b-6338-afff-c5df-cf9546e8f5b3
msgctxt "h74421c21gf2c4g479ag9580g9e0237a1a379"
msgid "I'm not <i>just</i> hungry! But, also, yes. I am hungry."
msgstr "배<i>만</i> 고픈게 아니야! 하지만, 뭐, 배도 고프긴 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Player
#. NodeID = 1a1e07e4-17a2-891c-3189-69c8884e845f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:1a1e07e4-17a2-891c-3189-69c8884e845f
msgctxt "h220fc80dg9389g4736gb23bgbbb594369035"
msgid "Thieves? What did they steal?"
msgstr "도둑? 뭘 훔쳐갔는데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Blue Jay
#. NodeID = 1bde8ac2-e0c0-9a45-350e-8e08d5d298f5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_HungryBird_State_OnRoof = True
#.      - CRE_Eagles_State_AllDefeated = True
#.      - CRE_HungryBird_State_RewardGiven = False
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:1bde8ac2-e0c0-9a45-350e-8e08d5d298f5
msgctxt "hed22f3e4g5f36g4cf6gb3faga6f5a971b271"
msgid ""
"Glorious! Feathers bloody <i>everywhere, </i>mate! Feels good to be home in "
"<i>my</i> nest."
msgstr "아주 좋아! 온 <i>사방</i>이 깃털 투성이야, 친구! <i>내 </i>둥지로 돌아오니 참 좋구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Player
#. NodeID = 1d14138a-b292-63c6-ba52-451dc95ad907
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:1d14138a-b292-63c6-ba52-451dc95ad907
msgctxt "ha6e8151aga658g4188g9f17gff3094447443"
msgid "That's great - where's <i>my </i>reward?"
msgstr "잘 됐네. <i>내 </i>보상은 어디 있지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Player
#. NodeID = 1f102b87-2c08-e9a0-35d4-57b92b393050
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:1f102b87-2c08-e9a0-35d4-57b92b393050
msgctxt "h60cd9499g25a1g4841gad0ag44bc5f93785c"
msgid "Is that why you're grumpy then? You're hungry?"
msgstr "그래서 화난거야? 배고파서?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Player
#. NodeID = 21a40676-21d0-5775-5e5d-b9c8248fd0cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:21a40676-21d0-5775-5e5d-b9c8248fd0cb
msgctxt "h609fe851g7693g4424g9f34g5ea792dd3e8a"
msgid "So the eagles are pricks for stealing a nest, but you're not?"
msgstr "그러니까 독수리가 둥지를 훔치면 순 나쁜 놈들이지만, 네가 훔치는 건 괜찮다는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Player
#. NodeID = 21e4ab0b-174d-690d-d151-356d4a2a4595
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:21e4ab0b-174d-690d-d151-356d4a2a4595
msgctxt "h842da806g7599g40cegafa9g6cdcecd147ca"
msgid "So am I, and you look like a perfect portion."
msgstr "나도 그런데. 그리고 너 꽤 맛있어보이는구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Player
#. NodeID = 24da9c35-b288-1636-e9cd-f0a8097c15bd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:24da9c35-b288-1636-e9cd-f0a8097c15bd
msgctxt "hb2be5cd3g4b7eg4809g8581g710a36ca0533"
msgid "<i>Leave</i>."
msgstr "<i>떠난다</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Player
#. NodeID = 2579f422-3831-10de-4f4b-ef92ccfac426
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_GithCreche_Knows_Location = True
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:2579f422-3831-10de-4f4b-ef92ccfac426
#, fuzzy
msgctxt "h8fb25c1dg2bbag41d4gb16ag8016dbcc1ab3"
msgid "I'm not here to take. Have you seen any of my people nearby?"
msgstr "뭔가를 빼앗으려고 온 게 아니야. 혹시 우리 종족 못 봤어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Blue Jay
#. NodeID = 28b938b5-ec2e-0dac-4421-22e9b2de4b87
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:28b938b5-ec2e-0dac-4421-22e9b2de4b87
#, fuzzy
msgctxt "ha168c68bg93b3g4d70g87e7g6d1ec13d8f02"
msgid "Well, it feels rubbish. I miss <i>my </i>roof-nest."
msgstr "하지만 개같은 느낌인걸. 나 <i>내 </i> 지붕 둥지가 그리워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Blue Jay
#. NodeID = 298ac455-f93c-4aa8-b38c-af91275bb44a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_MonasteryApproach_Bird_Hasmet(1) = True
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:298ac455-f93c-4aa8-b38c-af91275bb44a
msgctxt "h65209ad6g46d4g4115g9411g0dbb9e74d61c"
msgid "*Chirp! Chirp!*"
msgstr "*짹! 짹!*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Player
#. NodeID = 2aa2b040-8af3-1975-dbe5-d65f9040eb45
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_Eagles_State_AllDefeated = False
#. SetFlags:
#.   Global:
#.     - CRE_HungryBird_State_QuestAccepted = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:2aa2b040-8af3-1975-dbe5-d65f9040eb45
msgctxt "hb9f8bf19g57d5g49e1gb4b0g5fcad4eed0fc"
msgid "I can fight the eagles and get your nest back."
msgstr "내가 독수리들이랑 싸워서 네 둥지를 돌려줄 수 있는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Blue Jay
#. NodeID = 2b4a0b3d-f811-e168-7e26-901d093b4fad
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_HungryBird_Event_FlyToRoof = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:2b4a0b3d-f811-e168-7e26-901d093b4fad
msgctxt "h49eebe45g5f10g4187g8244g1c1122bfcd0b"
msgid "I'll either be killed or ask another poor sap to fight them again."
msgstr "그냥 죽거나, 다른 멍청한 놈한테 또 싸워달라고 해야지 뭐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Player
#. NodeID = 2b4de6a5-85f7-ccf3-9b7e-a5d43c960f6c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_HungryBird_Event_FlewAway = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:2b4de6a5-85f7-ccf3-9b7e-a5d43c960f6c
msgctxt "h0bb86cf9g913eg4d0bg8a73g1699944915db"
msgid "<i>Attack </i>."
msgstr "<i>공격한다</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Blue Jay
#. NodeID = 2be7705a-a7c8-d9d0-54d9-a6dd4d7239de
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:2be7705a-a7c8-d9d0-54d9-a6dd4d7239de
msgctxt "hff7040cbg87aeg4e88gb134g87aa04ec17c3"
msgid ""
"Oh, sure, <i>a </i>nest. But it's not <i>my </i>nest. That's up on the roof, "
"with the eagles. Eagles are pricks."
msgstr ""
"아, 물론, 이것도 둥지지. 하지만 <i>내 </i> 둥지는 아니야. 내 둥지는 지붕 위에, 독수리들하고 있다구. 독수리는 순 나쁜 "
"놈들이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Player
#. NodeID = 2cf0c5f8-13e4-ba46-5abb-19f5805c1f3d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:2cf0c5f8-13e4-ba46-5abb-19f5805c1f3d
msgctxt "h4da61cbeg65a1g4e21gb742gf0a17afcec93"
msgid "Why the roof?"
msgstr "왜 지붕 위야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Blue Jay
#. NodeID = 2eab7323-9ab2-f2d3-49dd-02835711596a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:2eab7323-9ab2-f2d3-49dd-02835711596a
msgctxt "h230ae3f7g215dg4b38gac73g61ee1f8b141f"
msgid ""
"Exactly right. Not all humans can grasp bird ethics, you should be proud."
msgstr "바로 그거야. 조류 윤리학을 이해할 수 있는 사람은 많지 않아. 자랑스러워하라구."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Player
#. NodeID = 2fda62a0-d40e-2818-07f5-858aba04882f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:2fda62a0-d40e-2818-07f5-858aba04882f
msgctxt "h66a476b1g35c3g48b3g8bcegdbc5dbaf6fcf"
msgid "That's a lot of attitude from a little bird."
msgstr "쬐끄만 새가 예의도 좋구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Player
#. NodeID = 32133f44-a627-28e4-02b5-1f5fee22cbfb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:32133f44-a627-28e4-02b5-1f5fee22cbfb
msgctxt "ha1662919g94cbg4cdfgb9f4gd2d053de6c5e"
msgid ""
"That's exactly how it works, and it's my turn. Get out, or I'll turn you "
"into stew."
msgstr "바로 그런 거지. 이제 내 차례야. 안 꺼지면 스튜로 만들어주겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Blue Jay
#. NodeID = 329cbf53-2a9f-715c-abcf-adf6e3f14d81
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_HungryBird_State_QuestAccepted = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:329cbf53-2a9f-715c-abcf-adf6e3f14d81
msgctxt "h82293a58g0c4bg44d1g85d1g584e24ec64db"
msgid ""
"Thank you. I'll keep an eye on the roof. Rude bastards, those eagles. "
"Deserve a little comeuppance."
msgstr "고마워. 지붕 위를 지켜보고 있을게. 그 독수리들, 재수 없는 것들이야. 본때를 보여줘야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Blue Jay
#. NodeID = 35517e08-6c66-d127-187b-5dc469b2094a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:35517e08-6c66-d127-187b-5dc469b2094a
msgctxt "h84e46da9g733fg44b0g8887gc0aeaf74de69"
msgid "It's a good lookout spot for <i>food</i>..."
msgstr "그 위는 <i>먹이</i>를 찾기 좋거든..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Player
#. NodeID = 35ccc9cb-35ae-7f69-4957-f84006d91624
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:35ccc9cb-35ae-7f69-4957-f84006d91624
msgctxt "h075fe9d2gd561g4d9dg9206gd2ef6d71ee35"
msgid "I'm expecting a powerful artefact."
msgstr "강력한 아티팩트였으면 좋겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Blue Jay
#. NodeID = 42594725-abaa-7ca0-fbaf-277e5e171d67
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:42594725-abaa-7ca0-fbaf-277e5e171d67
msgctxt "h805400b7g031ag47b7ga721gf46f09088767"
msgid "Hah! You? Kill an <i>eagle?</i> But if you think you <i>can</i>..."
msgstr "하! 네가? <i>독수리</i>를 죽여? 그치만... 죽일 수 있다면..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Player
#. NodeID = 571cd786-b45e-746e-2200-27f318e3f08c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_Eagles_State_AllDefeated = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:571cd786-b45e-746e-2200-27f318e3f08c
msgctxt "hbe897c84g2cb0g47cdg944fg79769d88b59a"
msgid "You're in luck, the eagles are dead."
msgstr "넌 운이 좋군. 독수리들은 죽었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Player
#. NodeID = 5b857444-5fd8-fd47-f57e-501a6d98a70c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:5b857444-5fd8-fd47-f57e-501a6d98a70c
msgctxt "h04521dcdg1c56g4d6dg8121ge5a3322e26c2"
msgid "Actually, my kind do birth eggs."
msgstr "사실, 우리 종족은 알을 낳긴 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Blue Jay
#. NodeID = 5c3c53f7-971d-dc72-63b3-a1f2fd86378f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:5c3c53f7-971d-dc72-63b3-a1f2fd86378f
msgctxt "h56daa7d9gba68g48f1gac7fg483518ae0bd1"
msgid ""
"I wish there was something I could give you in return. Oh! Tell you what..."
msgstr "너한테 줄 수 있는 게 있으면 좋겠는데. 아! 맞다..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Player
#. NodeID = 5cdb9138-9d66-f2ba-83d7-51e9f37c6b91
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:5cdb9138-9d66-f2ba-83d7-51e9f37c6b91
msgctxt "h37731ee0g3e1dg4c7fg9060ge578f3739ed7"
msgid "Surely the eagles need a nest as much as you?"
msgstr "독수리들한테도 둥지는 필요할 것 같은데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Player
#. NodeID = 6242e707-4a98-73f8-45ae-c2b662348c49
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:6242e707-4a98-73f8-45ae-c2b662348c49
msgctxt "h7e8bf41fg8fbdg4975g83eagd0d257b53def"
msgid "They're not invincible, I just haven't gotten round to it yet."
msgstr "독수리는 무적이 아니야. 그냥 아직 처리하지 않은 것뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Blue Jay
#. NodeID = 639115de-2793-c99a-b406-a9d39943e4fc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_HungryBird_Event_FlewAway = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:639115de-2793-c99a-b406-a9d39943e4fc
msgctxt "ha22ba3bfgd712g48c4g947dg80ffc7374939"
msgid "Not again! No! Abandon nest!"
msgstr "또야! 안 돼! 둥지를 버려라!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Player
#. NodeID = 654e95ab-7f20-e3fd-6c42-034eef73a7c2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:654e95ab-7f20-e3fd-6c42-034eef73a7c2
msgctxt "hcaf54bb4g1ef6g47afg8d47gf1e1070e4e41"
msgid "<i>Leave</i>."
msgstr "<i>떠난다</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Blue Jay
#. NodeID = 6a5b81bf-ba54-66fe-e742-d252e711c50c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_Eagles_State_AllDefeated = True
#.      - CRE_HungryBird_State_RewardGiven = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:6a5b81bf-ba54-66fe-e742-d252e711c50c
#, fuzzy
msgctxt "h56c97c6fga0bfg4151g9795g465a2a34ccac"
msgid ""
"Bet these eagle corpses'll scare any more of the big-wing bastards away."
msgstr "이 독수리 시체들을 보면 날개 큰 개놈들도 겁먹고 도망치겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Blue Jay
#. NodeID = 70fac398-b6d0-b8f0-c69f-ed8a5d3cc05a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:70fac398-b6d0-b8f0-c69f-ed8a5d3cc05a
msgctxt "he0a31d44gd649g4b85gb43cg035be48f4963"
msgid ""
"Hah! The eagles couldn't finish me off, and they're <i>much</i> bigger than "
"you."
msgstr "하! 너보다 <i>훨씬</i> 큰 독수리들도 나는 못 잡았다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Player
#. NodeID = 781275e0-a302-ad95-0c89-4ed87024f56b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_Eagles_State_AllDefeated = False
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:781275e0-a302-ad95-0c89-4ed87024f56b
msgctxt "hf112d235g1d92g4a65ga101g457e03ee7034"
msgid "Do you want me to go and deal with the eagles for you?"
msgstr "내가 독수리들을 처리해줄까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Player
#. NodeID = 7acf46cb-01c0-50c2-09af-fee00bf48e9b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:7acf46cb-01c0-50c2-09af-fee00bf48e9b
msgctxt "he34b8ac1gde64g419eg9f6dg2682041fb92c"
msgid "Wait, so if that's not your nest, whose is it?"
msgstr "그게 네 둥지가 아니면, 누구 둥지인데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Player
#. NodeID = 7b3d704c-1760-9437-39b7-e4a25b0c407e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_Eagles_State_AllDefeated = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:7b3d704c-1760-9437-39b7-e4a25b0c407e
msgctxt "hba3512a6g25edg4073g898dg2ddc91c2ba85"
msgid ""
"I finished off those eagles for you, the top of the monastery is all yours."
msgstr "독수리들을 처리했어. 수도원 꼭대기는 네 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Player
#. NodeID = 7c5395d2-36d2-432d-c4b6-3f50b65c5782
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:7c5395d2-36d2-432d-c4b6-3f50b65c5782
msgctxt "hfbd0627ag17d0g428fga3bag79989abffb36"
msgid "<i>Leave</i>."
msgstr "<i>떠난다</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Player
#. NodeID = 7d0cecd4-997c-d0e5-dd17-03fc1e9e8ec7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:7d0cecd4-997c-d0e5-dd17-03fc1e9e8ec7
msgctxt "hf3fc4c1cg7df5g4a99g95cagda4926b6ea5b"
msgid "<i>Leave</i>."
msgstr "<i>떠난다</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Blue Jay
#. NodeID = 7d3cb295-ba6c-fd30-1087-a66eee52225a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:7d3cb295-ba6c-fd30-1087-a66eee52225a
msgctxt "hc0bf0e68g53deg49ceg8092gb34a9824bb7b"
msgid "Maybe I wouldn't be so little if I had a proper dinner and a nest."
msgstr "밥이랑 둥지가 있었으면 이보단 컸을지도 모르지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Player
#. NodeID = 7f21bd24-b666-8d58-b0ad-05bc5d053cb7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:7f21bd24-b666-8d58-b0ad-05bc5d053cb7
#, fuzzy
msgctxt "h5917ae02g288ag4d12ga01ege2d8441858ed"
msgid ""
"It's about to get less fair. You have to leave this nest now, or <i>else</i>."
msgstr "이제 조금 더 불공평해질거야. 이 둥지에서 당장 꺼져. <i>안 그러면</i>..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Blue Jay
#. NodeID = 80a13618-6348-9235-ec83-afeac53758e5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_MonasteryApproach_Bird_Hasmet_SWA(1) = True
#.   Global:
#.      - CRE_HungryBird_State_QuestAccepted = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:80a13618-6348-9235-ec83-afeac53758e5
msgctxt "hd7628ac2g9a31g4561g90dbg754a02d40662"
msgid ""
"Let me guess. Defeat. It's to be expected, eagles are invincible after all."
msgstr "한 번 맞춰볼게. 졌구나. 그야 그렇겠지, 독수리는 무적이니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Blue Jay
#. NodeID = 8284a84e-d1f9-ec1a-985d-8dfef1f5cb64
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:8284a84e-d1f9-ec1a-985d-8dfef1f5cb64
msgctxt "h432d8d6cgfffbg45dbgb68dg1972dd26b9f9"
msgid ""
"<i>Weird</i>. Does your kind like mysterious buried treasure more than "
"bullying birds?"
msgstr "<i>요상하네</i>. 혹시 너희 종족은 새 괴롭히는 것 보다 미지의 보물을 더 좋아하진 않니?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Blue Jay
#. NodeID = 849bbe82-ba2e-5e65-a9c1-d9c401d7c33f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:849bbe82-ba2e-5e65-a9c1-d9c401d7c33f
#, fuzzy
msgctxt "h81352e1dgb222g4271ga83cg572a377e1feb"
msgid ""
"Eagles can be killed? Incredible! Thank you, kind, tall, ugly stranger. "
"<i>My </i>nest awaits."
msgstr "독수리를 죽일 수 있다고? 놀라워! 고마워, 친절하고, 키 크고, 못생긴 모르는 사람아. <i>내 </i>둥지야, 기다려라!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Narrator
#. NodeID = 879c7806-461d-32ca-2694-777f84ccd51d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:879c7806-461d-32ca-2694-777f84ccd51d
#, fuzzy
msgctxt "h08882cc2g480eg4fa8ga6bcg91c7a443c327"
msgid ""
"*Alcoholic lizards didn't show up much in your studies of the natural world.*"
msgstr "*자연의 세계에 대해 배울 때 술에 취한 도마뱀에 대한 이야기는 들어본 기억이 없습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Blue Jay
#. NodeID = 87a8a4fb-a9b9-ecb9-f035-94df3f11fd4a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:87a8a4fb-a9b9-ecb9-f035-94df3f11fd4a
msgctxt "h805c2b1bgab94g480agb845ge6a287bb0e39"
msgid "Hah, not likely! That bird is long gone, no way you talked to them."
msgstr "하, 말이 되는 소리를 해! 그 새는 떠난지 한참 됐어. 너랑 얘기했을 리가 없지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Player
#. NodeID = 883b5aa4-f2d5-9016-20fc-535a113eafb3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:883b5aa4-f2d5-9016-20fc-535a113eafb3
msgctxt "h0aeb3ef8gcd28g43bfga2d6gfc4777a58de0"
msgid "I can't help but notice you have a nest right there."
msgstr "지금 거기에 있는 것도 둥지 같은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Blue Jay
#. NodeID = 89d6a582-fa60-5a87-1a44-84acb54dc40f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:89d6a582-fa60-5a87-1a44-84acb54dc40f
#, fuzzy
msgctxt "h04bf68bag872cg4c23gb446g5fe8a6294134"
msgid ""
"Typical arrogance. Remember, tall one, pride comes before the fall. A very "
"long fall."
msgstr "오만한 사람들은 다 그렇게 말하지. 기억해, 오만 다음에는 몰락이 오는 법이야. 아주 끔찍한 몰락이."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Blue Jay
#. NodeID = 8bae3541-53cb-0407-60a7-3d637d5a9b90
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:8bae3541-53cb-0407-60a7-3d637d5a9b90
msgctxt "h3155e403gea9bg4c03g9428g1bbbd292e282"
msgid ""
"You're not the first to be scared of the eagles, there's no shame in "
"admitting it."
msgstr "너만 독수리가 무서운 게 아니야, 그냥 인정해도 괜찮아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Player
#. NodeID = 8f13c564-ec15-e490-6c78-5ba052a815eb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:8f13c564-ec15-e490-6c78-5ba052a815eb
msgctxt "hbefe52d3gae2fg4f19g824eg0a545072b9eb"
msgid "<i>Leave</i>."
msgstr "<i>떠난다</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Blue Jay
#. NodeID = 93bfedd6-9ab2-1ce4-b1d9-f643c57a1c58
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:93bfedd6-9ab2-1ce4-b1d9-f643c57a1c58
msgctxt "hc61ce506g0592g442ega4d4gf7c9e205f5b5"
msgid ""
"I'm sorry... I'm just a bird. I don't have <i>things</i> to give you. "
"Although..."
msgstr "미안... 난 그냥 새야. 너한테 줄 수 있는 <i>물건</i> 같은 건 없어. 그렇지만..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Player
#. NodeID = 9499c1c2-0e0f-7a06-7838-a44a1eb81df4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:9499c1c2-0e0f-7a06-7838-a44a1eb81df4
msgctxt "h6c07b774g742cg419fg9291gc87afde1e871"
msgid "<i>Leave</i>."
msgstr "<i>떠난다</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Player
#. NodeID = 95c7c40a-a784-0507-218b-cd773e728c8c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:95c7c40a-a784-0507-218b-cd773e728c8c
msgctxt "h30de4b28g9aecg4716ga9b0g71b391c182eb"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Player
#. NodeID = 9a5086a9-ce6e-21fb-3b52-999f11d9775f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_GithCreche_Knows_Location = True
#.   Tag:
#.      - GITHYANKI(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:9a5086a9-ce6e-21fb-3b52-999f11d9775f
msgctxt "h3fb62a9age8a2g4945gb35fg252eab7da14d"
msgid ""
"I'm not here to take. I'm looking for a githyanki crèche. Have you seen one?"
msgstr "뭘 빼앗으려고 온 게 아니야. 기스양키 양성소를 찾고 있는데, 본 적 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Player
#. NodeID = 9a7859b5-3155-bcf5-ef79-a465c3044a39
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:9a7859b5-3155-bcf5-ef79-a465c3044a39
msgctxt "h61653d96g87d1g43bfg8b54ga8bb57131456"
msgid "I'll see what I can do."
msgstr "방법을 찾아볼게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Blue Jay
#. NodeID = 9c3ff04f-2525-8413-11ed-1d067b9d01e9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:9c3ff04f-2525-8413-11ed-1d067b9d01e9
msgctxt "hb0b1b8e9g3ed2g4f66g9ab4gbfc4364b7352"
msgid ""
"It's not even like the eagles <i>need</i> my nest, the drunk lizards they "
"eat aren't hard to catch."
msgstr "독수리들한테 내 둥지가 <i>필요</i>한 것도 아냐, 걔네가 먹는 술취한 도마뱀들은 잡기 어렵지 않거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Blue Jay
#. NodeID = 9c57f5a9-1db4-4667-f676-5aa2e46e69b9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:9c57f5a9-1db4-4667-f676-5aa2e46e69b9
msgctxt "h3344ed93gb39ag44efg8a92g4a0655ec7f9f"
msgid ""
"Why do <i>you</i> want it? You lot don't even lay eggs! Let me have it - "
"I'll make it worth your while."
msgstr "<i>넌</i> 또 왜 이러는데? 너넨 알도 안 낳잖아! 내가 가지게 해주라. 보상은 충분히 할게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Blue Jay
#. NodeID = a03d9fc4-de2f-cfc2-8120-2cf1301e431d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:a03d9fc4-de2f-cfc2-8120-2cf1301e431d
msgctxt "hfa369497gf00ag42acgb895g1493a86e076b"
msgid "Some poor little tit who wasn't paying attention."
msgstr "한눈팔고 있던 어느 작은 박새 거지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Player
#. NodeID = a0cc9331-4d91-2203-4683-0267c68a19b0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:a0cc9331-4d91-2203-4683-0267c68a19b0
msgctxt "h8b49b4efg7bcfg4e2egacffg507d7d7efc99"
msgid "I suppose I could turn you into dinner."
msgstr "널 저녁으로 먹을 수는 있겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Blue Jay
#. NodeID = a387002b-c236-2547-8593-9024800ad650
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:a387002b-c236-2547-8593-9024800ad650
msgctxt "h107fb1f2gc670g4605g870egf5987a264f71"
msgid ""
"<i>Steal?</i> Eagles are bigger, they just <i>take</i>... Nest, prey, "
"everything. That's how it works here."
msgstr "<i>훔쳐?</i> 독수리들은 크니까, 그냥 <i>빼앗아</i> 가... 둥지에, 먹잇감에, 전부 다. 여기선 그런 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Player
#. NodeID = a9a42238-6ace-cdd7-b339-70e1160b82c7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:a9a42238-6ace-cdd7-b339-70e1160b82c7
msgctxt "h48419602g8a8eg48e4g81d4g8099cc9fd571"
msgid "<i>Leave</i>."
msgstr "<i>떠난다</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Player
#. NodeID = aa3e9874-98f8-8601-6f8b-066626209af5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:aa3e9874-98f8-8601-6f8b-066626209af5
msgctxt "h821acbbbg5877g48c5g87d6g08727077ef67"
msgid "Did someone steal something from you?"
msgstr "누가 뭔가를 훔쳐간 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Player
#. NodeID = aff7cdb7-37cc-3521-285b-9e8129a0d51d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:aff7cdb7-37cc-3521-285b-9e8129a0d51d
msgctxt "h986889fcg8d13g43ceg88fag403cdf27ab34"
msgid "Glad I could help."
msgstr "도움이 됐다니 기뻐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Player
#. NodeID = b6b6a884-2cb6-666d-8f94-5bccc77e0e05
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_Eagles_State_AllDefeated = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:b6b6a884-2cb6-666d-8f94-5bccc77e0e05
msgctxt "h917af3cbg4de5g4d2cgb3bfgf79ed7c6c367"
msgid "I've already killed the eagles, luckily for you."
msgstr "넌 운이 좋군. 독수리들은 이미 내가 죽였어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Blue Jay
#. NodeID = b865f6b8-5651-6e2b-55df-6e724f45899b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_HungryBird_Event_FlewAway = True
