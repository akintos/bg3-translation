msgctxt "h2b846674g2c84g4b27gaf48gddf3cd23d31a"
msgid "Get up - you won't die today."
msgstr "일어서 - 넌 오늘 죽지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/AstralPlane/CRE_AstralPrison_Daisy
