#.     - GLO_TadpoledCount1(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:c0bc0a6e-9587-9d64-fb31-b3ab4c2b2d79
msgctxt "ha4d7fd91g7304g41fcg8f3fg2aad2ce5bace"
msgid "*A shiver runs across your mind... You feel sated.*"
msgstr "*전율이 불현듯 머릿속을 스쳐 지나가고... 만족감이 듭니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Andrick
#. NodeID = d212687a-1a97-3e48-f99b-0a89d3cd60c7
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:d212687a-1a97-3e48-f99b-0a89d3cd60c7
msgctxt "h3d5966c7g8eedg47bagaed5g6a7f3402a5a2"
msgid "He might be a healer, Bry."
msgstr "그가 치유사일지도 몰라, 브리."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Andrick
#. NodeID = d212687a-1a97-3e48-f99b-0a89d3cd60c7
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:d212687a-1a97-3e48-f99b-0a89d3cd60c7
msgctxt "hbcefb021gcd29g4f4dg9391g12c57796ae0b"
msgid "She might be a healer, Bry."
msgstr "그녀가 치유사일지도 몰라, 브리."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Andrick
#. NodeID = d212687a-1a97-3e48-f99b-0a89d3cd60c7
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:d212687a-1a97-3e48-f99b-0a89d3cd60c7
msgctxt "h9d7f886fg36f0g4fcdga324g8056fecb25c6"
msgid "They might be a healer, Bry."
msgstr "그들이 치유사일지도 몰라, 브리."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Andrick
#. NodeID = d5661b3d-13d9-588c-086e-46bad7b8e204
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 54fb952d-a4e1-2381-0646-e8ce1c5513c2_AreYouTestingUs = False
#. SetFlags:
#.   Local:
#.     - 54fb952d-a4e1-2381-0646-e8ce1c5513c2_AreYouTestingUs = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:d5661b3d-13d9-588c-086e-46bad7b8e204
msgctxt "h677eae04g15a7g4e8egaf01g5011a6cdb7de"
msgid "What...? Are you... are you testing us?"
msgstr "네...? 그게 무슨... 저희를 시험하시는 겁니까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Brynna
#. NodeID = d65757c4-cd03-6e7c-7037-34eb0d8ccb86
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:d65757c4-cd03-6e7c-7037-34eb0d8ccb86
msgctxt "hc3a1abbagbf80g4314g83ebg8cf815f41dbc"
msgid ""
"I'm so, so sorry. It's our brother - True Soul Edowin. He's injured, and "
"I... I wasn't thinking."
msgstr "정말, 정말 죄송해요. 우리의 형제 - 참된 영혼 에도윈이에요. 상처를 입어서, 그래서... 경황이 없었어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Brynna
#. NodeID = d93669e2-453e-d886-ab4d-529637676c54
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:d93669e2-453e-d886-ab4d-529637676c54
msgctxt "h8651aaa9g79a7g41aega501g96f1eaaf8043"
msgid "Shut up, Andrick! Do you serve the Absolute?"
msgstr "닥쳐, 안드릭! 넌 절대자를 섬기나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Brynna
#. NodeID = db8faab6-f391-5023-61c8-fe44837ef52f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:db8faab6-f391-5023-61c8-fe44837ef52f
msgctxt "h30c0647dge150g469fg8ea2gdb38c6419a9a"
msgid "And when the time comes, the True Souls - <i>you </i>- will rule."
msgstr "그리고 때가 오면, 당신 같은 참된 영혼들이 지배하는 거죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Player
#. NodeID = dbcb1b13-41c2-6bde-02a5-74e535dc33a6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_PriestConqueringGod_001_TriedLeaving(3) = True
#.   Object:
#.      - FOR_PriestOfTheConqueringGod_Cultists_Knows_Owlbear(3) = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:dbcb1b13-41c2-6bde-02a5-74e535dc33a6
msgctxt "h90e7cf5cgd0d5g427fgb8b0g23708b6162b6"
msgid "You should get out of here."
msgstr "여기서 떠나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Player
#. NodeID = ddad224f-cf12-4e17-0309-a21f58e91abb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Absolute_Knows_TrueSoul = True
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(3) = False
#.   Tag:
#.      - TRUESOUL(3) = True
#. SetFlags:
#.   Dialog:
#.     - FOR_PriestOfTheConqueringGod_Cultists_TrueSoulPowersUsed(3) = True
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:ddad224f-cf12-4e17-0309-a21f58e91abb
msgctxt "h3f7d0478g2005g477agab3dg09c28abd5f2a"
msgid "Don't you recognise a True Soul when you see one?"
msgstr "참된 영혼을 보면 바로 알아보지 못하나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Narrator
#. NodeID = de7b3098-ee1f-9c18-73c5-3cfee5ac4abf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount4(3) = False
#.   Tag:
#.      - TRUESOUL(3) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount4(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:de7b3098-ee1f-9c18-73c5-3cfee5ac4abf
msgctxt "h9a147932gddf3g4b1fg8e3bg3d9c5e02589c"
msgid ""
"*A shadow swims across your vision, and a familiar voice tells you to be "
"calm. You are loved.*"
msgstr "*그림자가 낀 듯이 눈앞이 흐려지더니, 익숙한 목소리가 당신을 달래줍니다. 사랑이 느껴집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Player
#. NodeID = e1c855b2-463f-b3f2-b4fe-5c3e16434d00
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:e1c855b2-463f-b3f2-b4fe-5c3e16434d00
msgctxt "hfd93f547g06b5g483cg89bag187d75cf79e5"
msgid "A crude summary. You have more to learn of our faith, novice."
msgstr "조잡한 요약이야. 우리의 믿음에 대해 배울 게 아직 많이 남았군, 수습생."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Andrick
#. NodeID = e2054cef-5aff-faed-0451-ec16447b56c3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FOR_DeathOfATrueSoul_TalkedToCultists(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:e2054cef-5aff-faed-0451-ec16447b56c3
msgctxt "h1c6b23d1g9724g4bb0gae9cg82a9f831f96b"
msgid "I don't think he's conscious. Can you hear us, Ed?"
msgstr "지금 의식이 없으셔. 저희 말 들려요, 에드?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Player
#. NodeID = e32e4e68-2de8-5bf6-4b67-8885ec7808fc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FOR_PriestOfTheConqueringGod_Cultists_Knows_Owlbear(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:e32e4e68-2de8-5bf6-4b67-8885ec7808fc
msgctxt "h3bf567b2g9712g4696g8bfdgec59ef6ad156"
msgid "What happened to your friend?"
msgstr "너희 친구에게 무슨 일이 벌어진 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Player
#. NodeID = e553b9cd-271e-4d34-72f7-1bf8f77e173f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Apprentice_Quest_FindHalsin = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:e553b9cd-271e-4d34-72f7-1bf8f77e173f
msgctxt "h2a839769ga61bg483cgb4cfg4e246fe8819c"
msgid "Perhaps you can help me. I'm looking for the druid Halsin."
msgstr "날 도울 수 있을지도 모르겠군. 난 할신이라는 드루이드를 찾고 있다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Narrator
#. NodeID = e67e3144-14c7-770e-efef-f2ef6634e292
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:e67e3144-14c7-770e-efef-f2ef6634e292
msgctxt "h518c57c4g1abeg4bfagad49gdddd90013aba"
msgid ""
"*The injured man locks eyes with you. The parasite writhes in your head.*"
msgstr "*상처를 입은 남자가 당신과 눈을 마주칩니다. 머릿속의 기생충이 몸을 비틉니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Andrick
#. NodeID = e6a199d7-9eff-ac4b-a211-8f668b2b5c27
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:e6a199d7-9eff-ac4b-a211-8f668b2b5c27
msgctxt "hf2371600g89a8g42c3gb66fg22e938b878a7"
msgid ""
"We're looking for fugitives. Survivors from that ship that crashed farther "
"west of here."
msgstr "도망자들을 찾고 있습니다. 여기서 서쪽으로 멀리 떨어진 곳에 추락한 함선의 생존자들이요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Player
#. NodeID = ea906ec3-ff57-78d6-8d67-12f0dc225e55
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_PriestOfTheConqueringGod_Cultists_Knows_Mission(3) = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:ea906ec3-ff57-78d6-8d67-12f0dc225e55
msgctxt "h58d6f0a2g9d0bg4684g9f16gef300e02af89"
msgid "You're mistaken - I'm no True Soul."
msgstr "착각을 한 모양이군, 난 참된 영혼이 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Brynna
#. NodeID = ec1c7dfd-21db-6d9b-3ff5-bb01018ac737
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:ec1c7dfd-21db-6d9b-3ff5-bb01018ac737
#, fuzzy
msgctxt "hcc639939g7795g46a1ga61dg550b5b342bcd"
msgid ""
"Your words are Her command. She grants you the power to enforce Her will."
msgstr "당신의 말이 곧 그분의 명령입니다. 여신께서는 당신에게 자신의 뜻을 집행할 힘을 부여하시죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Astarion
#. NodeID = ee01b4a5-62b3-3e81-2a9b-2100a8be1c46
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(8) = True
#.   Tag:
#.      - REALLY_ASTARION(8) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:ee01b4a5-62b3-3e81-2a9b-2100a8be1c46
msgctxt "hb2f90ee6g13ffg4d87g8483g5b05e55d8266"
msgid "Oh, I like these two. All zeal and no brains."
msgstr "오, 얘네들 마음에 드는데. 열정은 넘치고 머리는 없잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Brynna
#. NodeID = efddc0bb-146b-4088-dc7f-c1c608f0c0c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:efddc0bb-146b-4088-dc7f-c1c608f0c0c1
msgctxt "h22bdf736g52a3g4d98g8f97g1715cccfb3a5"
msgid "Do you have orders for us? We were reporting to Edowin."
msgstr "명령을 내려주시겠어요? 저흰 원래 에도윈을 따르고 있었어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Narrator
#. NodeID = f1b555f3-fff4-462f-c75f-cd7298654622
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:f1b555f3-fff4-462f-c75f-cd7298654622
msgctxt "h8dd11318g0953g4e95g9221gc8a4d30a865a"
msgid ""
"*The injured man locks eyes with you. A familiar squirming churns in your "
"head.*"
msgstr "*쓰러진 남자가 당신과 눈을 마주칩니다. 머릿속에서 익숙한 꿈틀거림이 느껴집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Player
#. NodeID = f4a44835-5b95-7e81-f90a-5c8cdd4d4d1f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_PriestConqueringGod_001_TriedLeaving(3) = False
#. SetFlags:
#.   Dialog:
#.     - FOR_PriestConqueringGod_001_TriedLeaving(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:f4a44835-5b95-7e81-f90a-5c8cdd4d4d1f
msgctxt "hc3e13082g3a38g4edbg8c19g763cedd881b1"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Lae'zel
#. NodeID = f4f32fb9-acb1-8eff-77be-0ca18370ca0c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_LAEZEL(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:f4f32fb9-acb1-8eff-77be-0ca18370ca0c
#, fuzzy
msgctxt "h81a78017g2e22g407dgac6bg0a1a8ebeaf29"
msgid "Bah. I will serve at no ruler's side but my queen's."
msgstr "흥. 나는 여왕님 말고는 누구도 섬기지 않는다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Andrick
#. NodeID = f55d5beb-3603-07d3-bdc1-366625ab27b9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:f55d5beb-3603-07d3-bdc1-366625ab27b9
msgctxt "h975719d0ged3cg4471g9be6g57da38311863"
msgid "An owlbear. Please, do you have any -"
msgstr "아울베어한테 당했어요. 제발, 도움이..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Player
#. NodeID = f75e9433-0d85-de1c-d7f6-fa2f7cbfe733
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 10
