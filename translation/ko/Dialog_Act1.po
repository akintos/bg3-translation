#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_Dead_PostEA:f2692e72-1149-4a66-8190-0866dfb24087
msgctxt "h17a6d2f3gfe06g4516ga8f7ge400254e7251"
msgid "Why would you sign a pact with a devil?"
msgstr "데빌과 서약을 왜 맺은 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Refugee_SpokeWithDeadCrime
