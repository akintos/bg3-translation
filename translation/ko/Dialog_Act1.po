msgctxt "h65a5f282g468bg4e7eg93e7g0c3f3d47e1c9"
msgid "Hungry! Food!"
msgstr "배고파! 밥 먹을래!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_OwlBear_LastCub
#. Speaker = Narrator
#. NodeID = e461a4ec-4f68-4280-9a6c-443a5ecc2b2f
