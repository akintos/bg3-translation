msgid "What're you at? Lads - this'n's trying to scramble me head!"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Trespassing
#. Speaker = GROUP_GOB_Checkpoint_Guards
#. NodeID = 93fece57-30d7-9333-068f-11d2ac148071
