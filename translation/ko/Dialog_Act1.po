#.      - PLA_FlamingFist7_InnBurntDown_HasMet(1) = False
#.   Global:
#.      - PLA_Desire_Knows_RavengardTaken = False
#.      - PLA_TavernInvestigation_State_BurntDown = True
#. SetFlags:
#.   Dialog:
#.     - PLA_FlamingFist7_InnBurntDown_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:6813a8b2-d1ce-7c30-73fc-66b216ab7a59
msgctxt "h93fba97egf8b6g47e3g8892gdcf08b3dbae6"
msgid "The tracks converge here. Two, maybe three drow. At least one of ours."
msgstr "흔적이 여기서 겹쳐. 두세 놈의 드로우에, 하나는 우리 쪽이겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Player
#. NodeID = 693c639b-69de-43c9-61df-6072ec090f5b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_FlamingFist7_Knows_AskedWhatHappened(1) = False
#. SetFlags:
#.   Dialog:
#.     - PLA_FlamingFist7_Knows_AskedWhatHappened(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:693c639b-69de-43c9-61df-6072ec090f5b
msgctxt "h867ad89fgcd30g491agbf4agb9365d982c3d"
msgid "<i>Wipe away the tracks with your foot.</i>"
msgstr "<i>흔적을 당신의 발로 지운다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Gauntlet Dain
#. NodeID = 6a49767d-55ed-7456-706d-51ad6ecd6b1f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:6a49767d-55ed-7456-706d-51ad6ecd6b1f
msgctxt "hf428f230g3124g4471g9629g1bf41d32a07a"
msgid "Oh, damn it all. Half the Sword Coast probably knows by now."
msgstr "제기랄. 이제 소드 코스트의 절반이 알겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Gauntlet Dain
#. NodeID = 6dc60099-1f63-6a29-bcf0-4ce90d9add2c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:6dc60099-1f63-6a29-bcf0-4ce90d9add2c
msgctxt "h18ee58f3gc154g418aga88bg8c219923f3d9"
msgid "There aren't any villages within a day's walk."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Gauntlet Dain
#. NodeID = 6ed660d2-73df-53ca-48cf-4cd922981aab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:6ed660d2-73df-53ca-48cf-4cd922981aab
msgctxt "h2e5a3263g4305g4d8bg96a8gddbe06be9180"
msgid "Be easier if you weren't bothering me."
msgstr "만약 네가 방해하지 않았다면 좀 더 쉬웠겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Player
#. NodeID = 70907abb-6090-f138-8012-9a0d3ff58268
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_FlamingFist7_Knows_AskedWhatHappened(1) = False
#. SetFlags:
#.   Dialog:
#.     - PLA_FlamingFist7_Knows_AskedWhatHappened(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:70907abb-6090-f138-8012-9a0d3ff58268
msgctxt "h2a0c024dg8d18g42beg97cdga668360166f8"
msgid "You're the one who seems confused."
msgstr "제일 혼란스러워 보이는 건 너 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Gauntlet Dain
#. NodeID = 7324aaeb-ea95-e2ee-da20-6a1bf8f8ff47
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_Tavern_Knows_DukeInTavern = True
#.     - PLA_Desire_Knows_RavengardTaken = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:7324aaeb-ea95-e2ee-da20-6a1bf8f8ff47
msgctxt "h6639290cgff19g4cf7gb262g43bac19893a1"
msgid ""
"The raiders kidnapped Grand Duke Ravengard of Baldur's Gate. Killed his "
"entire guard while they were at it."
msgstr "습격자들이 발더스 게이트의 대공이신 레이븐가드 경을 납치했어. 그러면서 호위병들도 몰살시켰지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Gauntlet Dain
#. NodeID = 75ddaf94-6ab8-3bce-c3c3-72adc7eb39f0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DROWELF(1) = True
#. SetFlags:
#.   User:
#.     - PLA_TavernInvestigation_Knows_AskedStelmane(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:75ddaf94-6ab8-3bce-c3c3-72adc7eb39f0
msgctxt "he821f475g56d3g44fegbed1g8e6fab44761c"
msgid ""
"Your kind burned the inn to the ground. Even brought goblins along for the "
"fun."
msgstr "네 동족들이 여관을 불태웠지. 고블린들까지 불러서 재미 좀 봤더라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Player
#. NodeID = 76fa49bf-12cb-ccc1-7bdb-03800345ef57
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: Damage
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - REALLY_SELDARINEDROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:76fa49bf-12cb-ccc1-7bdb-03800345ef57
msgctxt "hf5ef2468gb963g4d94gbd8ag97842e5f8890"
msgid "My true kin have no care for surface raids. You can trust me."
msgstr "내 일족들은 지상 습격에는 관심이 없어. 믿어도 좋아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Player
#. NodeID = 7ac40ab0-6aba-05b4-8ddf-e74b01e95602
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_Desire_Knows_RavengardTaken = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:7ac40ab0-6aba-05b4-8ddf-e74b01e95602
msgctxt "hf88e033cgc12ag4901g8d32ga76766018e0f"
msgid "Evidence for what? Surely you've pieced something together by now."
msgstr "무슨 증거? 지금쯤이면 너도 무슨 일인지 대충 감 잡았겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Gauntlet Dain
#. NodeID = 7d8b86ff-cb4b-1d85-dbae-3ee025ba3c10
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:7d8b86ff-cb4b-1d85-dbae-3ee025ba3c10
msgctxt "hd6c4c78eg2c70g47d3g8745gd2918c476911"
msgid "These tracks should be able to tell us everything that happened here."
msgstr "여기서 일어난 모든 일들을 이 흔적들이 설명해줄 거라 생각했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Gauntlet Dain
#. NodeID = 8403afd9-ff4c-4e5f-e3ef-d04b3a4c4801
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:8403afd9-ff4c-4e5f-e3ef-d04b3a4c4801
msgctxt "h0037e5d4g88f3g4ed1gbb59gd0aafe78a597"
msgid "Right. I don't think you hail from <i>anywhere</i> close by."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Gauntlet Dain
#. NodeID = 868b403b-f954-0e80-736e-8d92f2553b36
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:868b403b-f954-0e80-736e-8d92f2553b36
msgctxt "ha910c491gf4aeg4ca3gb999g6decbd17d0c4"
msgid "And you should just bugger off."
msgstr "너도 꺼지는 편이 좋아 보이고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Gauntlet Dain
#. NodeID = 8820546a-3583-4ed7-e910-a76af5b82dad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:8820546a-3583-4ed7-e910-a76af5b82dad
msgctxt "h878d707ag9fbeg481cg8dabgab0ad67c34be"
msgid "Hm. You haven't tried to slit my throat <i>yet</i>..."
msgstr "흠. <i>아직까진</i> 내 목을 베려고 하진 않았지..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Narrator
#. NodeID = 88d24cde-6d6a-baf6-b7f1-f8d29dbd0019
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - e6738c9d-060d-c901-b945-4d49ca303d5b_SuccessfullyReadTracks = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:88d24cde-6d6a-baf6-b7f1-f8d29dbd0019
msgctxt "h11fd2ddcgec40g4dedg8e4cg1e0861b7849e"
msgid ""
"*Your gaze follows the drow footprints around the courtyard and south - out "
"of the inn.*"
msgstr "*당신의 시선은 안뜰과 남쪽에 남은 드로우의 발자국을 따라갑니다. 여관의 바깥쪽이군요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Player
#. NodeID = 89233e0a-b569-ce24-3888-91700b83aacb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:89233e0a-b569-ce24-3888-91700b83aacb
msgctxt "h3e6d4d58ga01dg49b9ga6d2g4497fc8998c2"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Player
#. NodeID = 8d92e0bd-cb9e-1ca4-77c8-9c61c979f9c9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - e6738c9d-060d-c901-b945-4d49ca303d5b_SuccessfullyReadTracks = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:8d92e0bd-cb9e-1ca4-77c8-9c61c979f9c9
msgctxt "h48000c2fg6469g4e39gb0d4gef6be4016316"
msgid "The drow went south."
msgstr "드로우는 남쪽으로 갔어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Gauntlet Dain
#. NodeID = 8e494fc3-9e06-64c6-19ab-2261bfc5b936
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:8e494fc3-9e06-64c6-19ab-2261bfc5b936
msgctxt "hba6c6af1g4aebg4fa2gb876ge6ae4cd1ad83"
msgid "What do you think you're doing? Stop that!"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Gauntlet Dain
#. NodeID = 96e3058e-f52d-20a3-ab89-b0eb5b2d94fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:96e3058e-f52d-20a3-ab89-b0eb5b2d94fe
#, fuzzy
msgctxt "h6d5ca9b1g6b5bg4ba8gb6a2ged1f3ae28500"
msgid ""
"I'll pass it up the chain of command - whatever good it'll do for the Grand "
"Duke."
msgstr "대공을 구하는데 도움이 될 수만 있다면, 지휘계통에 그 사실을 보고하겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Gauntlet Dain
#. NodeID = 9783b2e0-64c8-8d63-3ce3-da70ee6bff0c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:9783b2e0-64c8-8d63-3ce3-da70ee6bff0c
msgctxt "h48660753g31b7g4a2cg93d0gee957f01de6c"
msgid ""
"How do you - oh, never mind. Half the Sword Coast probably knows by now."
msgstr "어떻게 그걸...됐다, 신경 쓰지 마. 이미 소드 코스트의 절반은 알고 있을 테니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Gauntlet Dain
#. NodeID = 9ab5c7ee-76a3-ba0d-6c2a-52e20b4ace3e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:9ab5c7ee-76a3-ba0d-6c2a-52e20b4ace3e
msgctxt "h96d53d4cgfdc8g483dgaf83g7aaaaa2ddd38"
msgid "But I can't piece together much, thanks to the fire."
msgstr "이 망할 놈의 화재 때문에, 도저히 모르겠단 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Gauntlet Dain
#. NodeID = 9fb6fde1-2fc5-ab46-7ad7-4e5d8837a34b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:9fb6fde1-2fc5-ab46-7ad7-4e5d8837a34b
msgctxt "hb648d477gf02ag465fgb304g78b040c00fe1"
msgid "I'll blame that trick on simple curiosity. This time."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Gauntlet Dain
#. NodeID = a0911ee1-37a3-1696-9916-3511cc7aa05f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:a0911ee1-37a3-1696-9916-3511cc7aa05f
msgctxt "hbf1f394cg3490g46c0g9043g9989eb0a71fa"
msgid "And? What do you expect me to do about it?"
msgstr "그래서? 그럼 내가 어떻게 해야 할 것 같은데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Gauntlet Dain
#. NodeID = a1aa83cd-3662-cb3a-79e2-a0d57e5f3263
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - UNDERDARK(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:a1aa83cd-3662-cb3a-79e2-a0d57e5f3263
msgctxt "h20186f55gd642g4c9dga421g8b727a1fb8c6"
msgid ""
"You, a guard? Gods, they must be desperate if they're hiring Underdark "
"muscle."
msgstr "네가 경비병이라고? 세상에, 언더다크 떡대들을 고용할 정도면 어지간히 절박했나 보군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Gauntlet Dain
#. NodeID = a8cd9475-2a44-9095-b841-c00b48ebab28
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:a8cd9475-2a44-9095-b841-c00b48ebab28
msgctxt "h93529603ge635g43f5gaf23gc9a7a4e9579b"
msgid "Can't really tell the difference between you lot, honestly."
msgstr "솔직히 말해서, 딱히 다른 점을 모르겠는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Gauntlet Dain
#. NodeID = ab8981e7-c40c-eab6-a281-2fb736c08981
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:ab8981e7-c40c-eab6-a281-2fb736c08981
msgctxt "h5150461bg763fg425ega129g0b1e82f830e4"
msgid "We'll stay put for now. Still might get something out of these tracks."
msgstr "난 당분간은 여기 있겠어. 이 흔적에서 아직 뭔가 찾을 수 있을지도 모르니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Player
#. NodeID = ae35a444-ec9b-b752-7d3e-ec9b1dad114d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 6540a799-02ab-9ed6-90c2-b4b984d7386b_MindHasBeenRead = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:ae35a444-ec9b-b752-7d3e-ec9b1dad114d
msgctxt "h091008e9ga4c8g4446ga2e3gca3f845b0e98"
msgid "You're smart to keep quiet. Nobles attract the wrong sort of attention."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Player
#. NodeID = ae3f3719-84e5-2c36-37e0-06171d265699
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   User:
#.     - PLA_TavernInvestigation_Knows_AskedStelmane(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:ae3f3719-84e5-2c36-37e0-06171d265699
msgctxt "h04ac2bb4geb46g4ac8gaa88g3778ca1b97cd"
msgid "Have you figured anything out?"
msgstr "뭔가 알아낸 게 있나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Gauntlet Dain
#. NodeID = af5e5932-e262-6be3-9c12-bcf491df0dd0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:af5e5932-e262-6be3-9c12-bcf491df0dd0
msgctxt "hd7c40ddegfcaeg4677g80bdg100f1df5bfee"
msgid "Huh. Don't know how much help you can be, really."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Gauntlet Dain
#. NodeID = b3f2421e-5c94-54bd-cb63-c0598fb8c7b5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:b3f2421e-5c94-54bd-cb63-c0598fb8c7b5
msgctxt "hd68185cag4214g4bcdg955eg40fccb7edb06"
msgid "Oh, stand up. You're embarrassing yourself."
msgstr "일어나, 내가 다 창피하네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Narrator
#. NodeID = b671d21b-0f8e-4d54-6552-aa9bcf569edc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - e6738c9d-060d-c901-b945-4d49ca303d5b_SuccessfullyReadTracks = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:b671d21b-0f8e-4d54-6552-aa9bcf569edc
msgctxt "hda64d30fg372ag4e28g9270g5c070111a833"
msgid ""
"*The tracks are a chaotic mess. Gleaning any information from them is "
"impossible.*"
msgstr "*흔적은 끔찍하게 엉망입니다. 이것을 보고 정보를 얻기란 불가능해 보이는군요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Player
#. NodeID = b74f8e4b-efe9-c236-3f39-817233fb4ebd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:b74f8e4b-efe9-c236-3f39-817233fb4ebd
msgctxt "h25fa934cg9db0g4cd2g89eege6249975cea1"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Gauntlet Dain
#. NodeID = b8625dce-a462-f8c3-b633-aef0dfa17968
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 6540a799-02ab-9ed6-90c2-b4b984d7386b_MindHasBeenRead = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:b8625dce-a462-f8c3-b633-aef0dfa17968
msgctxt "h0eca825cg36a1g4869ga6d1g4f7caaac285e"
msgid ""
"<i>We should've sent another dozen guards, at least. He's not just any "
"noble, damn it! </i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Player
#. NodeID = c2964741-1a0e-1b18-4888-afa4a434ba5f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentDungeon_Event_Setup = True
#.   Quest:
#.      - PLA_ZhentShipment.Rewarded_ZhentReturned(1) = False
#.   User:
#.      - PLA_FlamingFists_Knows_ZhentDungeon(1) = False
#. SetFlags:
#.   User:
#.     - PLA_FlamingFists_Knows_ZhentDungeon(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:c2964741-1a0e-1b18-4888-afa4a434ba5f
msgctxt "h88a738e7gcb95g481dg84b9g24499deaedee"
msgid "I found a pack of Zhentarim hiding nearby."
msgstr "근처에 숨어있는 젠타림 집단을 찾았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Gauntlet Dain
#. NodeID = c3e167e9-8a17-d1cd-d26e-8019b705d92b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:c3e167e9-8a17-d1cd-d26e-8019b705d92b
msgctxt "he442fbe7g64bag49b8ga9c0geba4e19d69f3"
msgid "How did you..."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Player
#. NodeID = c45479d2-07c7-0439-a191-47951d4601ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:c45479d2-07c7-0439-a191-47951d4601ad
msgctxt "h34908656g7592g4571gb290g5ce78d1a2771"
msgid "You might as well give up."
msgstr "포기하는 편이 좋을 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Gauntlet Dain
#. NodeID = c55a0190-027b-4e84-9a01-5c27eb20aeff
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_FlamingFist7_InnBurntDown_HasMet(1) = False
#.   Global:
#.      - PLA_Desire_Knows_RavengardTaken = True
#.      - PLA_TavernInvestigation_State_BurntDown = True
#. SetFlags:
#.   Dialog:
#.     - PLA_FlamingFist7_InnBurntDown_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:c55a0190-027b-4e84-9a01-5c27eb20aeff
msgctxt "h1bac74a8gf69fg472eg8357g503d878af520"
msgid ""
"Watch where you step - these tracks might tell us where the raiders went."
msgstr "발 밑 조심해. 이 흔적들이 습격자들의 행방을 알려줄 수도 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Gauntlet Dain
#. NodeID = c77c90f9-44c1-cad5-a77d-1200d9a1df27
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:c77c90f9-44c1-cad5-a77d-1200d9a1df27
msgctxt "h44edf865g2cf1g4961g8cc8gc21ed3a3a633"
msgid "I'll blame your little lie on simple curiosity. This time."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Player
#. NodeID = caca244e-a4b0-d65b-cd32-1b160373dcd1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_Tavern_Knows_DukeInTavern = False
#.   User:
#.      - PLA_TavernInvestigation_Knows_AskedStelmane(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:caca244e-a4b0-d65b-cd32-1b160373dcd1
msgctxt "h2ba2bf88gef90g4da8g8607g81386d16b8ca"
msgid "I can tell you: the inn was raided by goblins and drow."
msgstr "내가 알고 있어. 고블린과 드로우들이 여관을 습격했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Gauntlet Dain
#. NodeID = cb7b0a2d-cf11-5f35-1e83-9f106b0cd84f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:cb7b0a2d-cf11-5f35-1e83-9f106b0cd84f
msgctxt "hedb6a793g6536g41fdg94daga5b16dfea304"
msgid ""
"That's <i>something</i>. But they could've gone south and then down - "
"towards the Underdark."
msgstr "그것도 하나의 <i>가능성</i>이지. 하지만 남쪽으로 향했다가 언더다크로 내려갔을 수도 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Gauntlet Dain
#. NodeID = cbabdcc8-9160-b20b-c48b-816a4d242396
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:cbabdcc8-9160-b20b-c48b-816a4d242396
msgctxt "hebd12912gc76ag43adg82deg641308669a0e"
msgid "You should get going. And watch for goblins on the road."
msgstr "이제 가. 가는 길에 고블린들 조심하고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Player
#. NodeID = d075e5a9-87d4-3a87-2938-db971972052d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:d075e5a9-87d4-3a87-2938-db971972052d
msgctxt "ha1569085g6101g4270gbcc9gd25fb94cc07c"
msgid ""
"If they allied with goblins, they were not Lolth's Chosen. Tell me more - "
"now."
msgstr "고블린과 동맹을 맺었다면, 롤쓰에게 선택받은 자들이 아니군. 좀 더 말해봐, 당장."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Player
#. NodeID = d94e9227-784a-2c9c-fb3e-7bcf8fe6d32f
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: Damage
#. RollAbility: Charisma
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:d94e9227-784a-2c9c-fb3e-7bcf8fe6d32f
msgctxt "h5e2ac360g05ebg4765ga584gb8b23ce5f998"
msgid "Clearly you're in a rough spot. I can help."
msgstr "확실히 곤경에 처한 것 같네. 내가 도울 수 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Gauntlet Dain
#. NodeID = d98aa9bc-8d0d-9346-8129-6d04dcb331ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:d98aa9bc-8d0d-9346-8129-6d04dcb331ae
msgctxt "h82b3d678g15b4g4435ga305g7fb12f91fb13"
msgid "I appreciate the offer, but you'd just get in the way."
msgstr "제안은 고맙지만, 넌 여기서 빠지는 게 낫겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Gauntlet Dain
#. NodeID = d992a2a4-d38f-1fe8-75a0-c45eede49a86
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:d992a2a4-d38f-1fe8-75a0-c45eede49a86
msgctxt "ha2c85676g8609g436cgae02g3eda1e59082c"
msgid "The old fortress? Gods, that whole area is cursed."
msgstr "그 오래된 요새? 맙소사, 거기는 저주받은 땅이잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Gauntlet Dain
#. NodeID = db404be6-027f-82dc-000a-86d91020fc26
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:db404be6-027f-82dc-000a-86d91020fc26
msgctxt "heb1f9c3cg02c3g4ba7gbd6bg5b4a960a5c64"
msgid ""
"The drow came for the Duke. Killed near everyone in the inn while they were "
"at it."
msgstr "드로우는 공작님을 찾아서 온 거야. 그 와중에 여관에 있던 대부분의 사람들을 죽였어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Player
#. NodeID = dc0cb81f-a273-f10e-02a5-c5cf36baf43a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_FlamingFist7_Knows_AskedWhatHappened(1) = False
#. SetFlags:
#.   Dialog:
#.     - PLA_FlamingFist7_Knows_AskedWhatHappened(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:dc0cb81f-a273-f10e-02a5-c5cf36baf43a
msgctxt "hb091859dg447bg45a9gb14fgf03972c3c4ad"
msgid "What are you doing?"
msgstr "뭐 하는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Player
#. NodeID = ddb9da66-e165-78b6-e338-a93c798a50de
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_Tavern_Knows_DukeAtTowers = True
#. SetFlags:
#.   Global:
#.     - PLA_Tavern_Told_DukeToTowers = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:ddb9da66-e165-78b6-e338-a93c798a50de
msgctxt "h37d91310g5318g42a1gb70fgb36b481413ec"
msgid "They took the Grand Duke to Moonrise Towers."
msgstr "그들은 대공을 문라이즈 타워로 데려갔어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Player
#. NodeID = df3e84b1-548a-19a3-79d7-4d9e4d853959
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:df3e84b1-548a-19a3-79d7-4d9e4d853959
msgctxt "hbbb0fe32g3ef2g4098gb01bge05fd0ee0aea"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Player
#. NodeID = e06a66a5-bef8-63d2-ca09-16e05aa5aa5b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:e06a66a5-bef8-63d2-ca09-16e05aa5aa5b
msgctxt "hc7a34640g89ebg41b7g96c2g38a86d66c0b4"
msgid "It's a shame they left any survivors. That's poor form."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Gauntlet Dain
#. NodeID = e3f04abe-1ff5-de00-de58-e1fcafbc47b9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   User:
#.     - PLA_FlamingFist7_Angry(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:e3f04abe-1ff5-de00-de58-e1fcafbc47b9
msgctxt "hba483cb3gfe79g4e10g91c6g5c131e0691b6"
msgid "You need to go. <i>Now</i>."
msgstr "저리 가. <i>당장</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Gauntlet Dain
#. NodeID = eb9158d2-753b-f7f7-5b33-955e3dc7fc05
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:eb9158d2-753b-f7f7-5b33-955e3dc7fc05
msgctxt "h55fec874ge2e5g4664g82fdg8f65da021ca2"
msgid "From here they went... Damn! It's all so confused."
msgstr "이쪽에서 그 녀석들이 왔고...제길! 너무 헷갈리잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Player
#. NodeID = ec1ebe1f-2c08-0edc-2f36-12f155ab5612
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_Tavern_Knows_DukeAtTowers = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:ec1ebe1f-2c08-0edc-2f36-12f155ab5612
msgctxt "h3d11dd04g2c65g4941g87e7g2d38309256b4"
msgid "Maybe you need a second pair of eyes. Want me to take a look?"
msgstr "두번째 눈이 필요한 걸지도 모르지. 내가 봐도 될까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Player
#. NodeID = ec661d74-3cd3-1d95-acdb-7e13905be5d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:ec661d74-3cd3-1d95-acdb-7e13905be5d6
msgctxt "h7d26c121g471dg43eag961bgdeb62e81c74e"
msgid "Figure it out for yourself."
msgstr "혼자 힘으로 해결해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Player
#. NodeID = f1539d64-dd3c-5b5c-88b3-bd8bed897e19
#. HandlePath = TaggedText[0].TagText[0]
#. RollType:
#. RollAbility: Wisdom
#. DifficultyClass: 0
#. CheckFlags:
#.   Local:
#.      - 6540a799-02ab-9ed6-90c2-b4b984d7386b_MindHasBeenRead = False
#.   Script:
#.      - GEN_CanDetectThoughts_2 = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:f1539d64-dd3c-5b5c-88b3-bd8bed897e19
msgctxt "h3c50efeag27b3g42f6g8c0bg1e3432afa0c4"
msgid "<i>Search her mind for information.</i>"
msgstr "<i>정보를 얻기 위해 생각을 탐지한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Gauntlet Dain
#. NodeID = f223362e-049d-de76-72f8-5cfb8e114b5a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_FlamingFists_Knows_DesireDead = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:f223362e-049d-de76-72f8-5cfb8e114b5a
msgctxt "ha16b956bg295eg4af9ga381gcf1a8f4474a9"
msgid "The Counsellor died, too. This has all gone to the hells."
msgstr "자문관님도 돌아가셨어. 상황이 아주 지옥 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Gauntlet Dain
#. NodeID = f23205a5-859e-c9cc-f4c2-38e026cc04e1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:f23205a5-859e-c9cc-f4c2-38e026cc04e1
msgctxt "hf8fc5094g438fg41ddg9055g0fefb63b1643"
msgid "Nothing I didn't already know."
msgstr "아직 까진, 아무것도."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Gauntlet Dain
#. NodeID = f4718a05-a394-f62d-8b58-a0c00315819e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_Desire_Knows_RavengardTaken = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:f4718a05-a394-f62d-8b58-a0c00315819e
msgctxt "h5eca762bgaa03g4427gbc26g7f10ef857c72"
msgid "At least his counsellor survived, thank the gods."
msgstr "그나마 자문관님이 살아남으셔서 다행이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Gauntlet Dain
#. NodeID = f4b8e028-745f-6d46-c1e8-e29131667328
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:f4b8e028-745f-6d46-c1e8-e29131667328
msgctxt "h050d4beeg22afg4a07gbfbdgfe0fb3e5a0b3"
msgid "I'm not confused, I'm <i>frustrated</i>."
msgstr "혼란스러운 게 아니라, <i>답답한</i> 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Gauntlet Dain
#. NodeID = f4ed7af6-00fb-2059-0d97-3a2fbd8f5c8f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   User:
#.     - PLA_FlamingFist7_Angry(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7:f4ed7af6-00fb-2059-0d97-3a2fbd8f5c8f
msgctxt "h2ecfdb86g79bdg4814gb3dcg51b8db729521"
msgid "Leave, before I put a sword through you."
msgstr "꺼져, 네 면상에 칼을 들이밀기 전에."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7_AD
#. Speaker = Gauntlet Dain
#. NodeID = 364b93bc-076b-75cc-4b4e-9dcd874b4974
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - c241adf3-2154-a79e-aa10-896b99264692_B = True
#.      - c241adf3-2154-a79e-aa10-896b99264692_A = True
#.      - c241adf3-2154-a79e-aa10-896b99264692_C = True
#. SetFlags:
#.   Local:
#.     - c241adf3-2154-a79e-aa10-896b99264692_B = False
#.     - c241adf3-2154-a79e-aa10-896b99264692_A = False
#.     - c241adf3-2154-a79e-aa10-896b99264692_C = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7_AD:364b93bc-076b-75cc-4b4e-9dcd874b4974
msgctxt "h98619c1bg58aag4bdag9e77g573b5a40725a"
msgid "They dragged someone through here..."
msgstr "이쪽으로 누군가를 끌고 갔어..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7_AD
#. Speaker = Gauntlet Dain
#. NodeID = 48bea395-d926-145e-8b56-8f5cbb4fb859
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - c241adf3-2154-a79e-aa10-896b99264692_B = False
#.      - c241adf3-2154-a79e-aa10-896b99264692_A = False
#.      - c241adf3-2154-a79e-aa10-896b99264692_C = False
#. SetFlags:
#.   Local:
#.     - c241adf3-2154-a79e-aa10-896b99264692_A = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7_AD:48bea395-d926-145e-8b56-8f5cbb4fb859
msgctxt "h188e6a3fg8902g4fb5gb4bcg2a7aca0a59b7"
msgid "There were three... no, four."
msgstr "셋... 아니, 넷이 있었군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7_AD
#. Speaker = Gauntlet Dain
#. NodeID = c33a68ad-2a44-7f43-1eb7-cb1f6bdfda5e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - c241adf3-2154-a79e-aa10-896b99264692_B = False
#.      - c241adf3-2154-a79e-aa10-896b99264692_A = True
#.      - c241adf3-2154-a79e-aa10-896b99264692_C = False
#. SetFlags:
