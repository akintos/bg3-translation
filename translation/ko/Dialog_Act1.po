msgctxt "h1f68d7a0ga93dg4f1fg8e20g061297a2fc49"
msgid "<i>Read their mind.</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_NoticedPoisoning
#. Speaker = GROUP_Act1_GOB_Festivities
#. NodeID = d4fab7c9-7415-436e-c155-72157c44e76e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_NoticedPoisoning:d4fab7c9-7415-436e-c155-72157c44e76e
msgctxt "h10124aaegdb1dg4318g9a70g3b404ef1220c"
msgid "Like hells. That ain't firewine!"
msgstr "지랄하네. 그거 파이어와인 아니잖아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_NoticedPoisoning
#. Speaker = GROUP_Act1_GOB_Festivities
#. NodeID = d91d1233-e58e-6ead-5446-a35fdd89e864
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - ee2a8342-0aad-ed4e-a7b1-811c6cc527a8_MindHasBeenRead = True
#. TagRule: FEMALE and TIEFLING
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_NoticedPoisoning:d91d1233-e58e-6ead-5446-a35fdd89e864
msgctxt "h66953bc0g2089g4865gb1cag09a14f5cd99f"
msgid ""
"<i>Urk. The world's spinnin'... Heh. Her horns look like snakes, all "
"wriggly. Damn, this is some good beer.</i>"
msgstr "<i>억. 세상이 돈다... 헤. 저년 뿔이 꿈틀거리는 게 뱀처럼 보이네. 젠장, 이거 좋은 맥주군.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_NoticedPoisoning
#. Speaker = GROUP_Act1_GOB_Festivities
#. NodeID = d91d1233-e58e-6ead-5446-a35fdd89e864
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Local:
#.     - ee2a8342-0aad-ed4e-a7b1-811c6cc527a8_MindHasBeenRead = True
#. TagRule: TIEFLING
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_NoticedPoisoning:d91d1233-e58e-6ead-5446-a35fdd89e864
msgctxt "h36de0be4g9116g4c68gbdd4gc9a5ba1bbd5d"
msgid ""
"<i>Urk. The world's spinnin'... Heh. His horns look like snakes, all "
"wriggly. Damn, this is some good beer.</i>"
msgstr "<i>억. 세상이 돈다... 헤. 저놈 뿔이 꿈틀거리는 게 뱀처럼 보이네. 젠장, 이거 좋은 맥주군.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_NoticedPoisoning
#. Speaker = GROUP_Act1_GOB_Festivities
#. NodeID = d91d1233-e58e-6ead-5446-a35fdd89e864
#. HandlePath = TaggedText[2].TagText[0]
#. SetFlags:
#.   Local:
#.     - ee2a8342-0aad-ed4e-a7b1-811c6cc527a8_MindHasBeenRead = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_NoticedPoisoning:d91d1233-e58e-6ead-5446-a35fdd89e864
msgctxt "he0d6cf1cg3014g4551ga22cg16931608b384"
msgid ""
"<i>Urk. The world's spinnin'... Heh. The stones look alive, all wriggly. "
"Damn, this is some good beer.</i>"
msgstr "<i>억. 세상이 돈다... 헤. 돌멩이가 살아서 꿈틀거리네. 젠장, 이거 좋은 맥주군.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_NoticedPoisoning
#. Speaker = Player
#. NodeID = dacde90a-2df0-c900-9d4b-503b864c6bd0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_NoticedPoisoning:dacde90a-2df0-c900-9d4b-503b864c6bd0
msgctxt "h4aa3f977g0694g47a5gb14bg08e44431c851"
msgid "A lethal poison. Enough to take the lot of you down."
msgstr "치명적인 독이야. 너희 대부분을 쓰러트리기에 충분하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_NoticedPoisoning
#. Speaker = Narrator
#. NodeID = e2e085b5-7890-a4ac-ac0e-1b64d5da15ad
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_NoticedPoisoning:e2e085b5-7890-a4ac-ac0e-1b64d5da15ad
msgctxt "h2a1334a3g9f2bg4a6aga171g91241add8310"
msgid ""
"*The mark glows, but you feel nothing in response. Your illithid power is "
"beyond reach until you rest.*"
msgstr "*문양이 빛나지만, 어떤 반응도 느껴지지 않습니다. 일리시드 능력을 더 사용하려면 휴식을 취해야 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_NoticedPoisoning
#. Speaker = Player
#. NodeID = e79266fc-0d65-39e5-4393-7357efd45aa1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_NoticedPoisoning:e79266fc-0d65-39e5-4393-7357efd45aa1
#, fuzzy
msgctxt "h63f06883g9ef1g4c39g9e13g746d5baa91ea"
msgid "Turn around and walk away. Do not question the will of the Absolute."
msgstr "뒤돌아서서 가던 길 가라. 절대자님의 뜻을 의심하지 말고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_NoticedPoisoning
#. Speaker = GROUP_Act1_GOB_Festivities
#. NodeID = e958af0f-c8f2-a561-ba31-fa8a74be28d1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_NoticedPoisoning:e958af0f-c8f2-a561-ba31-fa8a74be28d1
msgctxt "he3fbacf4g6718g4e4ag8d70ga2c87a2f87d8"
msgid "Drink must be tellin' on me. Guess I need some more. Heh."
msgstr "술 땜에 헛것을 봤나 봐. 몇 잔 더 마셔야겠다. 헤."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation
#. Speaker = GROUP_Act1_GOB_Festivities
#. NodeID = 006065f7-f090-4d13-7873-4fece02fa7e6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_GoblinToast_State_ConfrontedAboutPoisoning = True
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation:006065f7-f090-4d13-7873-4fece02fa7e6
msgctxt "h0cc8acf9gef9bg4735gb4afg3106fbed4a6d"
msgid "Yeah? We'll see 'bout that!"
msgstr "그러셔? 그건 두고 봐야지!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation
#. Speaker = Player
#. NodeID = 016fce3b-4d86-8a90-45a8-40d639518aa9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Absolute_Knows_TrueSoul = True
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation:016fce3b-4d86-8a90-45a8-40d639518aa9
msgctxt "h335f674fgfbe7g4750gadb8g9a5fcf9714d7"
msgid "And why would I do that? I'm a True Soul."
msgstr "내가 왜 그러겠어? 나는 참된 영혼인데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation
#. Speaker = Narrator
#. NodeID = 073970b5-a4f3-6cda-ee23-847c5383c8eb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount3(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount3(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation:073970b5-a4f3-6cda-ee23-847c5383c8eb
msgctxt "he01e27c1gf780g45f2g92f4gaf2ebc542c99"
msgid "*Your mind lurches, reeling suddenly as if... bitten.*"
msgstr "*뭔가에 깨물린 것처럼 느닷없이 정신이 휘청거립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation
#. Speaker = GROUP_Act1_GOB_Festivities
#. NodeID = 0a8913b8-8c7b-fbcd-6fba-9490e73d8ba4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 233377a8-9099-ed74-4410-b8f46400bd4f_MindHasBeenRead = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation:0a8913b8-8c7b-fbcd-6fba-9490e73d8ba4
msgctxt "h1ad3dd2eg0169g4808g9854g5d2d61bd93ac"
msgid ""
"<i>I </i>knew <i>we shouldn'tve taken that fancy berry beer. Could've tasted "
"the poison if it hadn't been so sweet.</i>"
msgstr ""
"<i>그 </i>망할 <i>고급 베리 맥주를 갖고 오는 게 아니었는데. 단맛이 강해서 망정이지 완전 독약 맛이나 다름 없었겠어.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation
#. Speaker = GROUP_Act1_GOB_Festivities
#. NodeID = 0ee4281a-338c-d4f1-fcc6-0d76289003e6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_GoblinToast_State_ConfrontedAboutPoisoning = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation:0ee4281a-338c-d4f1-fcc6-0d76289003e6
msgctxt "h34238d13g2103g4f50gac82g65a8da3747ac"
msgid "V-very sorry - I didn't know. I swear I didn't know!"
msgstr "저-정말 미안해 - 난 몰랐어. 맹세코 몰랐어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation
#. Speaker = Narrator
#. NodeID = 228118da-6524-72da-abff-5eb366b01f86
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount5(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount5(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation:228118da-6524-72da-abff-5eb366b01f86
msgctxt "hffce63ecgd1ebg4013gbf57g486adf66f9ba"
msgid ""
"*Your blood runs quicker, feeding the gnawing absence at the centre of your "
"mind.*"
msgstr "*피가 더 빨리 흐르면서, 당신의 정신 한가운데를 좀먹는 허전함을 양분으로 채웁니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation
#. Speaker = Player
#. NodeID = 250de825-13a7-d190-7015-979a8f399b0a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 233377a8-9099-ed74-4410-b8f46400bd4f_MindHasBeenRead = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation:250de825-13a7-d190-7015-979a8f399b0a
msgctxt "had421a0dgb00bg4d12gb63bg4974035e26fe"
msgid ""
"You poisoned yourselves. This is Elderberry Beer - goblins are allergic to "
"it."
msgstr "너희들이 자초한 일이야. 이건 엘더베리 맥주거든, 고블린에게 알레르기 반응을 일으켜."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation
#. Speaker = GROUP_Act1_GOB_Festivities
#. NodeID = 34459a7f-4b21-7e61-b02e-735a90066369
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_GoblinToast_PlayerWasNoticedPoisoning(1) = True
#.      - GOB_GoblinToast_GoblinNoticedPoisoning(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation:34459a7f-4b21-7e61-b02e-735a90066369
msgctxt "hdabb3b7eg6331g4d40g9d9bg176a2e2b50ed"
msgid "You! I knew you'd been mucking with our beer! You poisoned us!"
msgstr "너! 네 녀석이 우리 맥주에 장난친 거 알고 있어! 우릴 독살시키려 해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation
#. Speaker = Player
#. NodeID = 5c8d2530-9447-229a-42ab-60eba7967570
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 20
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = False
#.      - DROWELF(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation:5c8d2530-9447-229a-42ab-60eba7967570
msgctxt "hf52dd5f8g06e6g4872g9458ga92c6f6bd3af"
msgid "I did, but I can slit your throat if you'd prefer a quick death."
msgstr "내가 탔는데, 너도 빠른 죽음을 원한다면 목을 베어줄 수 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation
#. Speaker = Narrator
#. NodeID = 5fd2fae0-121b-13b2-7f90-9b8eecce55e6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - GLO_TadpoleIntro_NPC(1) = False
#. SetFlags:
#.   User:
#.     - GLO_TadpoleIntro_NPC(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation:5fd2fae0-121b-13b2-7f90-9b8eecce55e6
msgctxt "h3fe72047g9326g4922ga27ag4a81e50cb31f"
msgid ""
"*A strange symbol glows, marked on their flesh, and something within you "
"stirs in response.*"
msgstr "*그들의 살갗에 새겨진 기묘한 상징이 빛나고, 이에 반응하여 당신 내면의 무언가가 꿈틀거립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation
#. Speaker = GROUP_Act1_GOB_Festivities
#. NodeID = 6989b0c5-68b5-0bd7-f857-d2b621084e13
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_GoblinToast_State_ConfrontedAboutPoisoning = True
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#. TagRule: SHORT
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation:6989b0c5-68b5-0bd7-f857-d2b621084e13
msgctxt "hcee8c448g75f5g4b89gade3g07aa51782562"
msgid "You? You're smaller than a worg whelp. Guys - get this idiot!"
msgstr "니가? 워그 새끼보다 쪼매난 주제에. 얘들아, 이 병신 잡아라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation
#. Speaker = GROUP_Act1_GOB_Festivities
#. NodeID = 6989b0c5-68b5-0bd7-f857-d2b621084e13
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_GoblinToast_State_ConfrontedAboutPoisoning = True
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation:6989b0c5-68b5-0bd7-f857-d2b621084e13
msgctxt "h5cf09a0fg5948g4668g8bcbgb5e4ad5a6f1e"
msgid ""
"You, a True Soul? I'd be shakin' in my boots if you were, but all I'm "
"feelin' is the urge to see your guts."
msgstr "니가, 참된 영혼이시다? 진짜라면 내 다리가 후들거렸을 텐데, 널 보면 배를 갈라보고 싶은 생각만 가득한걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation
#. Speaker = Narrator
#. NodeID = 7492e4a2-ccef-c879-5158-6c8e308b4dbf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount2(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation:7492e4a2-ccef-c879-5158-6c8e308b4dbf
msgctxt "hcead7af2gf3e4g4e6egb80cg93bfe421bd3e"
msgid ""
"*Something stirs deep within you, hungry and alert... it's taking something "
"you'll never get back.*"
msgstr "*몸 깊숙한 데서 굶주리고 기민한 존재가 꿈틀댑니다... 잃으면 되찾지 못할 뭔가를 좀먹고 있군요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation
#. Speaker = GROUP_Act1_GOB_Festivities
#. NodeID = 795859a3-ca57-3ca4-3df2-8181830e337d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_GoblinToast_State_ConfrontedAboutPoisoning = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation:795859a3-ca57-3ca4-3df2-8181830e337d
msgctxt "hf68750ecgb457g4892ga4bcg31c6ccafd599"
msgid "Th-this one's all right, lads! Knows nothin' about no poisonin'!"
msgstr "이-이 자는 상관 없어, 얘들아! 독에 대해선 아무것도 모르더라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation
#. Speaker = Narrator
#. NodeID = 7c12bbb9-683f-b49f-f537-e79559372866
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - GLO_TadpoleIntro_NPC(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation:7c12bbb9-683f-b49f-f537-e79559372866
msgctxt "h13dbc24egcec3g4a3fgb81bg790edd5aab90"
msgid "*As the symbol glows, power courses through you. <i>Authority</i>.*"
msgstr "*문양이 빛나며, 몸에 흐르는 힘이 느껴집니다. <i>권위</i>.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation
#. Speaker = GROUP_Act1_GOB_Festivities
#. NodeID = 80d988dd-ea23-948b-8261-60a7b787ea0d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_GoblinToast_State_ConfrontedAboutPoisoning = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation:80d988dd-ea23-948b-8261-60a7b787ea0d
msgctxt "h8b6de211g3086g4e63ga7d3g8ab3b3c0c050"
msgid "<i>Tnak</i>, you're right. Whoever did this could be anywhere by now."
msgstr "<i>트낵</i>, 네 말이 맞아. 범인이 누구든 지금쯤이면 빠져나갔겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation
#. Speaker = GROUP_Act1_GOB_Festivities
#. NodeID = 86219cbc-071b-2182-6672-92a559c3b951
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_GoblinToast_State_ConfrontedAboutPoisoning = True
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation:86219cbc-071b-2182-6672-92a559c3b951
msgctxt "h644402edg908ag4b5bga046g00c0f298e048"
msgid "Or you just thought we'd be stupid enough to believe ya!"
msgstr "우리가 그런 거짓부렁에 넘어갈 만큼 멍청해보이냐!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation
#. Speaker = Player
#. NodeID = 87eb5cfe-d9ac-4823-de60-b3e2183b666f
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. TagRule: DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation:87eb5cfe-d9ac-4823-de60-b3e2183b666f
msgctxt "h766f66d2g488cg4069g882bg48eb17434ef2"
msgid "Consider it a privilege. I could have just gutted you."
msgstr "호의를 베푼 거라고 생각해. 그냥 네 배를 갈라버릴 수도 있었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation
#. Speaker = Player
#. NodeID = 96eca036-dd60-45b5-68a0-63e9e306393e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 5
#. CheckFlags:
#.   Global:
#.      - GLO_Absolute_Knows_TrueSoul = True
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#.      - ILLITHID(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation:96eca036-dd60-45b5-68a0-63e9e306393e
msgctxt "ha52132bbg42e7g49fegbbe5gf486f69cf828"
msgid "And why would I do that? I'm a True Soul."
msgstr "내가 왜 그러겠어? 나는 참된 영혼인데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation
#. Speaker = Narrator
#. NodeID = 99c66239-eecc-31db-d533-0f251a75312c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount6(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount6(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation:99c66239-eecc-31db-d533-0f251a75312c
msgctxt "h2e4260c8g59b3g4c81gbf2eg8ed3a49e0494"
msgid ""
"*The presence deep in your mind is awake, unblinking. This is it. A single "
"word pervades your consciousness: 'Soon'.*"
msgstr ""
"*당신의 정신 속 깊이 자리잡은 존재가 태연스레 깨어납니다. 올 것이 왔군요. 한 단어가 당신의 의식 속으로 스며듭니다. ‘곧’*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation
#. Speaker = Player
#. NodeID = 9af37cae-a95d-8bf5-a477-28992f814832
