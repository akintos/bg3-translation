msgctxt "hb3034de7gbd1fg438fga384gf2dc3677f9bd"
msgid "Damays, let's..."
msgstr "다메이스, 이만..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene
#. Speaker = Damays
#. NodeID = e7563ed8-be9c-9ac5-9f29-e9a0aaf18771
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 4b9219b6-9074-0463-e4e0-1ff4c30e087b_Grove = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene:e7563ed8-be9c-9ac5-9f29-e9a0aaf18771
msgctxt "hc8e2890fg75d9g4b3fg8b0cg2da3058650b0"
msgid "You didn't hear it? Shook our camp good, so I came for a look."
msgstr "그쪽은 못 들은 거야? 온 야영지가 뒤흔들릴 정도였지. 난 그걸 살피러 나왔어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene
#. Speaker = Player
#. NodeID = ea41d030-3cd5-6926-ba31-0c37922bafeb
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene:ea41d030-3cd5-6926-ba31-0c37922bafeb
msgctxt "h49230ffeg5c94g4359g8ceeg3b8c94a55b41"
msgid "If you value your life, walk away."
msgstr "목숨이 아깝다면 여길 떠나시지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene
#. Speaker = Nymessa
#. NodeID = eaf605d7-03e3-9a5a-91bd-28357a9ee07e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_LaezelRecruitment_State_Tiefling2Missing = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene:eaf605d7-03e3-9a5a-91bd-28357a9ee07e
msgctxt "h74d87ab4gde6bg4e29g9b13ga87d2340748b"
msgid "Zorru was right. Yellow as a toad, and twice as ugly."
msgstr "조르 말이 맞았어. 두꺼비처럼 누렇고, 그보다 두 배는 못생겼군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene
#. Speaker = Player
#. NodeID = ec9a98c1-58c0-c681-0125-b0bbb9dc6a08
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CHA_LaezelRecruitment_MindMeld(3) = False
#.   Global:
#.      - TUT_TransformChamber_State_TriedToFree = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene:ec9a98c1-58c0-c681-0125-b0bbb9dc6a08
msgctxt "hb574cddfg8c94g439eg8589g7528ed3f6c9a"
msgid "<i>Rather demanding for a woman in your position. Why should I?</i>"
msgstr "<i>그런 꼬락서니로 잘도 이래라저래라 하는군. 내가 왜 그래야 하지?</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene
#. Speaker = Narrator
#. NodeID = ed6fe3b1-1962-ec5c-b702-39423c094276
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CHA_LaezelRecruitment_MindMeld(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene:ed6fe3b1-1962-ec5c-b702-39423c094276
msgctxt "he2dea397gc028g4b0bg9b5ag5411c7d782b7"
msgid ""
"*Your skull briefly aches - and you are <i>her</i>. You feel her irritation "
"and indignity.*"
msgstr "*머리가 잠시 욱신거리더니, <i>저쪽</i>과 하나가 됩니다. 짜증과 모멸감이 전해지는군요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene
#. Speaker = Nymessa
#. NodeID = edba2bb8-5537-0b1f-8cf2-32e528de91c0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
