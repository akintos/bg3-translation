msgctxt "h7d203734g439fg4fa6gaab4g7eef7b5e6ba4"
msgid "MIRI! Where are you?"
msgstr "<b>미리!</b> 어디 있는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_AD_Searching
#. Speaker = Benryn
#. NodeID = baeadab5-4a40-7274-7b0c-6b4cad78154b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 01ae93b4-9977-51e9-b25a-d8d6dbfc7540_A = False
#.      - 01ae93b4-9977-51e9-b25a-d8d6dbfc7540_B = True
#. SetFlags:
#.   Local:
#.     - 01ae93b4-9977-51e9-b25a-d8d6dbfc7540_B = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_AD_Searching:baeadab5-4a40-7274-7b0c-6b4cad78154b
msgctxt "h3a5d69a0ge2cag4409gba13g3b127071a97f"
msgid "She's alive. I know she is."
msgstr "살아 있어. 분명 살아 있을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_AD_ToWife
#. Speaker = Benryn
#. NodeID = 07e47eaf-2a7e-f2d8-2d0c-fd6963e63f37
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - PLA_StuckHalfElf_State_ReachedWifeBox(0) = True
