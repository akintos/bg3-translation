msgctxt "h63605ffeg9ce8g4d52gac3eg40cf0a2d3339"
msgid "Yer flesh is marked!"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinPriest_AD_AfterBranding
#. Speaker = True Soul Gut
#. NodeID = 5d501e6c-02b2-d9a2-dc50-ecbddc4c7305
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_GoblinPriest_FinishedSermon = True
#.     - GOB_GoblinPriest_FinishedBranding = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinPriest_AD_AfterBranding:5d501e6c-02b2-d9a2-dc50-ecbddc4c7305
msgctxt "hf88b1081g61ebg4720g8b59g37b726b9de1d"
msgid "But you're not ready to become True Souls yet."
msgstr "하지만 넌 아직 참된 영혼이 될 준비가 안 됐어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinPriest_AD_AfterBranding
#. Speaker = True Soul Gut
#. NodeID = 7210b133-d1d1-9d90-5c55-2f2795e79832
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinPriest_AD_AfterBranding:7210b133-d1d1-9d90-5c55-2f2795e79832
msgctxt "h4edd49d9g8ea8g4be3gad65g3c1af564936c"
msgid "Follow my teachings. Follow Ragzlin's orders."
msgstr "내 가르침을 따라라. 라그즐린의 명령에 복종하라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinPriest_AD_AfterBranding
#. Speaker = True Soul Gut
#. NodeID = 75451de2-aacb-847a-4c7b-4709753c02b2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinPriest_AD_AfterBranding:75451de2-aacb-847a-4c7b-4709753c02b2
msgctxt "h5b45ebffga402g401fg8debg060d354690f1"
msgid "The Absolute is upon you!"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinPriest_AD_AfterBranding
#. Speaker = True Soul Gut
#. NodeID = f7dbee9f-c328-9127-0dfe-1a19ab33b156
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_GoblinPriest_FinishedBranding = True
#. SetFlags:
#.   Global:
#.     - GOB_GoblinPriest_FinishedSermon = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinPriest_AD_AfterBranding:f7dbee9f-c328-9127-0dfe-1a19ab33b156
msgctxt "h1482c575gbb1ag488egb17cgab54db4f8104"
msgid "Faith is obedience!"
msgstr "믿음이란 자고로 복종인 것이여!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinPriest_AD_AfterBranding
#. Speaker = True Soul Gut
#. NodeID = fc1b863a-9a65-85ce-4be8-81df1609a285
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_GoblinPriest_FinishedSermon = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinPriest_AD_AfterBranding:fc1b863a-9a65-85ce-4be8-81df1609a285
msgctxt "hfbc2de23g0d1ag4bebg9a55g796000f37d0c"
msgid "Serve the Absolute, and you may be chosen."
msgstr "그분을 신실히 섬기면 선택받을 수 있다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinPriest_AD_Branding_000
#. Speaker = Devout Muzul
#. NodeID = 0e4ab75f-204c-b995-582c-cdf0b18ed1aa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinPriest_AD_Branding_000:0e4ab75f-204c-b995-582c-cdf0b18ed1aa
msgctxt "h26b7543bg04eag40f3gb25ag60691a896bd1"
msgid "I only hear Her through you, priestess."
msgstr "저는 당신을 통해서만 그분을 들을 수 있습니다, 여사제님."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinPriest_AD_Branding_000
#. Speaker = True Soul Gut
#. NodeID = 5810a400-f264-6887-acc6-73196a7fd10c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinPriest_AD_Branding_000:5810a400-f264-6887-acc6-73196a7fd10c
msgctxt "h1ad25b89g7f90g4078g96a2g0c4aa29e68e0"
msgid "Do you hear the Absolute's voice? Do you feel Her inside you?"
msgstr "절대자님의 목소리가 들리나? 너의 내면에서 그분이 느껴지나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinPriest_AD_Branding_000
#. Speaker = True Soul Gut
#. NodeID = d0f593b2-fbe1-ebd3-fdd7-6b6d5d634641
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinPriest_AD_Branding_000:d0f593b2-fbe1-ebd3-fdd7-6b6d5d634641
msgctxt "h789be70bg60feg4534gab97gce07c69bd80b"
msgid "That's because She <i>chose</i> me. You're not worthy yet!"
msgstr "그분이 날 <i>택했기</i> 때문이지. 넌 아직 가치가 없다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinPriest_AD_Branding_001
#. Speaker = True Soul Gut
#. NodeID = 26e755bd-8adf-fe7d-ac53-d7379eed330f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinPriest_AD_Branding_001:26e755bd-8adf-fe7d-ac53-d7379eed330f
msgctxt "h63f90b7bgb86ag4c00g99bdgaec539b2221c"
msgid "Are you ready for the Absolute's mark on your flesh?"
msgstr "네 살에 절대자님의 표식을 새길 준비는 되었나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinPriest_AD_Branding_001
#. Speaker = Devout Mrak
#. NodeID = 4971fb85-0d33-fa89-6851-b6b616ad103e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinPriest_AD_Branding_001:4971fb85-0d33-fa89-6851-b6b616ad103e
msgctxt "h90fac657g4723g4475g87c7gf6d3f57958f8"
msgid "Yeah. And then I'll hear Her voice?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinPriest_AD_Branding_001
#. Speaker = True Soul Gut
#. NodeID = 6d79b1be-3625-7d9d-d40e-4582abf5470c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinPriest_AD_Branding_001:6d79b1be-3625-7d9d-d40e-4582abf5470c
msgctxt "hc838649egf8e6g4db1g9ab5g236e37c927e2"
msgid "You're too feeble. Her voice is a blade - it'd cut your brain to bits."
msgstr "넌 너무나 나약하구나. 그분의 목소리는 칼날과 같아서 너의 뇌를 가를 수 있다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinPriest_AD_Branding_002
#. Speaker = True Soul Gut
#. NodeID = 21442992-b0db-c27a-f1ac-f97fb0af1d45
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinPriest_AD_Branding_002:21442992-b0db-c27a-f1ac-f97fb0af1d45
msgctxt "h49a1da05gffc7g433bg84c0g1ad49f762997"
msgid "She loves <i>me</i>! You lot ain't proved yourselves yet."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinPriest_AD_Branding_002
#. Speaker = Booyahg Shekt
#. NodeID = 50d1e47f-3784-a0e7-0122-a504bc30f987
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinPriest_AD_Branding_002:50d1e47f-3784-a0e7-0122-a504bc30f987
msgctxt "h8156c693g6619g4edag9c5fg83fa2be9de02"
msgid "The Absolute loves us!"
msgstr "절대자님은 우리를 사랑하셔!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinPriest_AD_Branding_002
#. Speaker = True Soul Gut
#. NodeID = b4332f8e-dd04-8ff7-2dcc-4c4ca5b7a267
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinPriest_AD_Branding_002:b4332f8e-dd04-8ff7-2dcc-4c4ca5b7a267
msgctxt "h5ab6c25fg50fbg4cb6g9c27g440129d22bd9"
msgid "The brand marks your flesh. Her voice purifies your mind."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinPriest_AD_Branding_003
#. Speaker = True Soul Gut
#. NodeID = 7a8b322b-a05c-6f58-6032-fe20b7286a9f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinPriest_AD_Branding_003:7a8b322b-a05c-6f58-6032-fe20b7286a9f
msgctxt "h871ab39bga769g4985g8042g0cba62fae22f"
msgid "None of you are worthy. Such a disappointment."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinPriest_AD_Branding_003
#. Speaker = Tracker Tozad
#. NodeID = d5cfc3a5-1dee-9deb-f2cd-b2664a18e5ee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinPriest_AD_Branding_003:d5cfc3a5-1dee-9deb-f2cd-b2664a18e5ee
msgctxt "hb79c9358g02e8g43a9gaaa8gfa1ed67fdb64"
msgid "How do we get closer to Her?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinPriest_AD_Branding_003
#. Speaker = True Soul Gut
#. NodeID = e88b00ff-701a-84b5-bfc6-f642796d0078
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinPriest_AD_Branding_003:e88b00ff-701a-84b5-bfc6-f642796d0078
msgctxt "had289370gd87dg423ag9ecag48104af08ec0"
msgid "Do what us True Souls command. Spill the blood of non-believers!"
msgstr "참된 영혼들이 지시하는 것을 따르라. 불신자들의 피를 뿌리자!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinPriest_AD_Call
#. Speaker = True Soul Gut
#. NodeID = 34b92d4c-a2c4-615a-e010-4d349b7568b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinPriest_AD_Call:34b92d4c-a2c4-615a-e010-4d349b7568b3
msgctxt "h0a9a647dg5cd7g4a52g9c86g42b82cdca66f"
msgid "Oi - c'mere. I ain't waiting around."
msgstr "어이, 빨리 와. 죽치고 있을 시간 없으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinPriest_AD_CallingForHelp
#. Speaker = True Soul Gut
#. NodeID = 984cc1c0-fa59-a53d-393d-9e467ea0a7fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinPriest_AD_CallingForHelp:984cc1c0-fa59-a53d-393d-9e467ea0a7fc
msgctxt "hab6382b3g409cg4a02gb82cg6d7da779edad"
msgid "Get in here - we've got trouble!"
msgstr "이리 모여, 여기 문제가 생겼다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinPriest_AD_LeavingBranding
#. Speaker = Warlock Greez
#. NodeID = 29a41a4b-3268-580c-7239-0b8dc2fcee83
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_GoblinPriest_Branded(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinPriest_AD_LeavingBranding:29a41a4b-3268-580c-7239-0b8dc2fcee83
msgctxt "h73c53bd3g7497g4de8gb7a9g505998a9bf55"
msgid "Oi! I've been waitin' for the mark - where's the priestess off to?"
msgstr "어이! 줄창 표식만 기다리고 있었다고. 저 양반이 어딜 가는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinPriest_AD_LeavingBranding
#. Speaker = Devout Muzul
#. NodeID = 98171c92-5d7a-cae5-51c2-163e9fd3abff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinPriest_AD_LeavingBranding:98171c92-5d7a-cae5-51c2-163e9fd3abff
msgctxt "h179803afg6011g47c5g99abgd61b5e2e186a"
msgid "Ha! Maybe you ain't good enough for the Absolute."
msgstr "하! 어쩌면 너 따윈 절대자님 성에 차지 않나 보지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinPriest_AD_LeavingBranding
#. Speaker = Warlock Greez
#. NodeID = abc471a6-55f2-d7a6-6064-a2f7d39d190e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_GoblinPriest_Branded(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinPriest_AD_LeavingBranding:abc471a6-55f2-d7a6-6064-a2f7d39d190e
msgctxt "h12ed4792g80a9g4fa9gad14gd9c7fe4e8a4f"
msgid "Oi! Priestess! We want the mark!"
msgstr "어이! 여사제 양반! 우리도 표식을 원한다고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinPriest_AD_LeavingBranding
#. Speaker = Devout Muzul
#. NodeID = e95fac87-3121-b0a8-1772-1b1d63624b0d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinPriest_AD_LeavingBranding:e95fac87-3121-b0a8-1772-1b1d63624b0d
msgctxt "h662358deg9274g4f4eg993dgc6b59864124a"
msgid "Yeah! Ain't we good enough for the Absolute?"
msgstr "맞아! 우리 정도면 절대자님께 충분하지 않아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinSulky_AD_AfterBranding
#. Speaker = Devout Muzul
#. NodeID = 3679672f-5ad3-0c5c-eace-4e18f7534a61
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinSulky_AD_AfterBranding:3679672f-5ad3-0c5c-eace-4e18f7534a61
msgctxt "hc8b67b5bgad04g42feg9b1bgb861b08729c7"
msgid "Absolute's lookin' out for me now."
msgstr "절대자님께서 이제 날 지켜준다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinToast_AD_Attack
#. Speaker = Brawler Rot
#. NodeID = 03663ec8-59a7-1971-ab92-ffae9b75e9b7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinToast_AD_Attack:03663ec8-59a7-1971-ab92-ffae9b75e9b7
msgctxt "h992918a6g88bcg4c5fg8973gf7da675d5130"
msgid "They - they're dead!"
msgstr "얘들이... 죽었어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinToast_AD_Attack
#. Speaker = Brawler Rot
#. NodeID = 25ef1256-53bb-39a3-73f7-6b544f2ee1a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinToast_AD_Attack:25ef1256-53bb-39a3-73f7-6b544f2ee1a4
msgctxt "hd2c54f4fgb098g43b1ga083g8246a7b3cd82"
msgid "Must've been those strangers!"
msgstr "이방인 자식들 짓이 분명해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinToast_AD_SceneWithoutPlayer
#. Speaker = Warlock Gurk
#. NodeID = 2ca8a40d-2074-7879-3952-c5b4cba08ecf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinToast_AD_SceneWithoutPlayer:2ca8a40d-2074-7879-3952-c5b4cba08ecf
msgctxt "h29dd53dfg102bg444fg855fg31d517249eef"
msgid "To findin' those looters and crushin' 'em!"
msgstr "도둑놈들을 찾아서 박살내자!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinToast_AD_SceneWithoutPlayer
#. Speaker = Sharp-Eye Aggy
#. NodeID = 6dd5aff7-736c-2a1a-a45e-bbaf4150828e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinToast_AD_SceneWithoutPlayer:6dd5aff7-736c-2a1a-a45e-bbaf4150828e
msgctxt "h1572175cgc05dg4e2eg8a7ag67ebf2effaf0"
msgid "To tha' duke's face when we gave 'im to the drow!"
msgstr "우리가 공작을 드로우에게 넘겼을 때의 그 낯짝을 위하여!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinToast_AD_SceneWithoutPlayer
#. Speaker = Sharp-Eye Mirg
#. NodeID = 97c93808-a2e3-d3c0-192e-07c041c1db5d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinToast_AD_SceneWithoutPlayer:97c93808-a2e3-d3c0-192e-07c041c1db5d
msgctxt "h831fff52g9ce4g4330g882egee92ddcab114"
msgid "A toast! To our victory, and many more to come!"
msgstr "건배! 우리의 승리와, 앞으로의 많은 승리에 건배!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinToast_AD_SceneWithoutPlayer
#. Speaker = Sharp-Eye Mirg
#. NodeID = f4e69dbb-d35e-733c-4180-a7777ed700ac
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_GoblinToast_Event_SceneWithoutPlayerEnded = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinToast_AD_SceneWithoutPlayer:f4e69dbb-d35e-733c-4180-a7777ed700ac
msgctxt "hc1c12990g5fa6g4232g9988g074684356487"
msgid "To the Absolute!"
msgstr "절대자님을 위하여!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinToast_AD_ToStations
#. Speaker = Sharp-Eye Aggy
#. NodeID = 84757233-f3fb-4d3b-0d7c-49ddc3a0852a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinToast_AD_ToStations:84757233-f3fb-4d3b-0d7c-49ddc3a0852a
msgctxt "ha62dd5e7ga89cg424dga238gbe604d1a585c"
msgid "Someone's killing us off - battle stations!"
msgstr "누군가 우릴 전멸시키려고 한다 - 전투 준비!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinToast_AD_ToastIntro
#. Speaker = Sharp-Eye Mirg
#. NodeID = 3cfea6dc-bc62-5ce8-38dc-44a0755b4f8a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 44fe07b0-3627-3a0c-e48f-cda82f6c987d_ToastStart = False
#. SetFlags:
#.   Local:
#.     - 44fe07b0-3627-3a0c-e48f-cda82f6c987d_ToastStart = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinToast_AD_ToastIntro:3cfea6dc-bc62-5ce8-38dc-44a0755b4f8a
msgctxt "hd5467133gf7c9g44b5ga3b9ga06d4facba34"
msgid "Everyone got a drink?"
msgstr "다들 좀 마셨나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinToast_AD_ToastIntro
#. Speaker = Sharp-Eye Mirg
#. NodeID = 6def55ba-7ad7-07da-9c00-d9c295c6560c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 44fe07b0-3627-3a0c-e48f-cda82f6c987d_ToastStart = True
#. SetFlags:
#.   Local:
#.     - 44fe07b0-3627-3a0c-e48f-cda82f6c987d_ToastStart = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinToast_AD_ToastIntro:6def55ba-7ad7-07da-9c00-d9c295c6560c
msgctxt "h5dc76580g6940g4211g9c1fgd7a7bcbccf2b"
msgid "Shut up, I'm gonna say something!"
msgstr "닥쳐, 내가 말할게!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinToast_AD_TooMuchBeer_001
#. Speaker = GROUP_Act1_GOB_Festivities
#. NodeID = cd55315c-26fa-10af-827d-9acb08e7b911
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinToast_AD_TooMuchBeer_001:cd55315c-26fa-10af-827d-9acb08e7b911
msgctxt "hba593a88gfafag4d02g9876ga5c7ef7c642d"
msgid "Fallin' down <i>already?</i> What are ya, a bloody gnome?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinToast_AD_TooMuchBeer_002
#. Speaker = GROUP_Act1_GOB_Festivities
#. NodeID = c3f11b4c-fc73-851d-bfee-88a8d5f50dcc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinToast_AD_TooMuchBeer_002:c3f11b4c-fc73-851d-bfee-88a8d5f50dcc
msgctxt "hce4ea0adg5d04g46adg862bg8aeb46c61d5f"
msgid "<i>Another</i> one down?! You pisspots can't 'old your drink. Shameful."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinToast_AD_WaitingForToast_001
#. Speaker = Sharp-Eye Aggy
#. NodeID = e6564af5-1da7-7cb0-3f1b-e903b7164921
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinToast_AD_WaitingForToast_001:e6564af5-1da7-7cb0-3f1b-e903b7164921
msgctxt "hb2e3644cg7c00g4b09gab35geb617fbaba77"
msgid "Toast! Toast!"
msgstr "건배! 건배!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinToast_AD_WaitingForToast_002
#. Speaker = Tracker Tak
#. NodeID = 17929ddb-cc74-c2fa-3244-a2e920321e9b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinToast_AD_WaitingForToast_002:17929ddb-cc74-c2fa-3244-a2e920321e9b
msgctxt "hd762f64cg1701g41e4g8003gd33e9fabcdb9"
msgid "Speech! SPEECH!"
msgstr "축사! <b>축사!</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinToast_AD_WalkingTowardsToastPoint
#. Speaker = Sharp-Eye Mirg
#. NodeID = 2c527ddf-c5b6-5e04-e191-fe95835d8e85
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinToast_AD_WalkingTowardsToastPoint:2c527ddf-c5b6-5e04-e191-fe95835d8e85
msgctxt "h8ff1e99bg54d2g4051g8454gdfc7ebca6411"
msgid "Over here, lads! I propose... a toast!"
msgstr "여기야, 친구들! 제안하지... 건배!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinWily_AD_AfterBranding
#. Speaker = Tracker Tozad
#. NodeID = be877459-35eb-5057-57ac-62ace97d7fa0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinWily_AD_AfterBranding:be877459-35eb-5057-57ac-62ace97d7fa0
msgctxt "h3be67373g83b6g4911g87f6g5df4ff1c491a"
msgid "Nobody's gonna push us around anymore."
msgstr "이제 아무도 우리를 우습게 못 보겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Guards_AD_Idle
#. Speaker = Warrior Nrog
#. NodeID = 04ab8c98-c800-bee6-a0d5-efa69f1bcfb5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Guards_AD_Idle:04ab8c98-c800-bee6-a0d5-efa69f1bcfb5
msgctxt "h3118cf84g9180g41ffg9163g7cae12604109"
msgid ""
"We got 'em though, eh? And once the whelp starts singin' we'll know who sent "
"'em."
msgstr "결국 놈들을 헤치우긴 했잖아? 그 새끼가 술술 불기 시작하면 누가 보냈는지 알게될 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Guards_AD_Idle
#. Speaker = Warrior Trinzas
#. NodeID = 1523ea1a-e33a-3c2c-2601-b0eb2df3eb09
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Guards_AD_Idle:1523ea1a-e33a-3c2c-2601-b0eb2df3eb09
msgctxt "h08d37b4dg4163g483bgba09gd335c58e52f2"
msgid "Aye - so much <i>fun </i>that those thieves almost got past."
msgstr "그래 - 너무 재미를 많이 봐서 그 도둑놈들을 그냥 들여보낼 뻔했지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Guards_AD_Idle
#. Speaker = Warrior Trinzas
#. NodeID = a41a6a80-5d37-b496-f76a-990dc08c9591
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Guards_AD_Idle:a41a6a80-5d37-b496-f76a-990dc08c9591
msgctxt "h5c30b07agbf08g49dcgb6bagea5fd00d20ab"
msgid ""
"Aye. Might be we'll pay 'em a visit in return. That'll be some <i>real "
"</i>fun."
msgstr "그래. 우리도 그 보답으로 한번 찾아가 줄 수도 있겠지. 그건 <i>진짜 </i>재밌을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Guards_AD_Idle
#. Speaker = Warrior Trinzas
#. NodeID = c10e5679-8f3f-608f-20b2-4d7c6dcf1534
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Guards_AD_Idle:c10e5679-8f3f-608f-20b2-4d7c6dcf1534
msgctxt "h248dc249g7676g4f59gaa22g1e0884d27a27"
msgid "Bloody racket..."
msgstr "망할, 시끄러워 죽겠군..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Guards_AD_Idle
#. Speaker = Warrior Nrog
#. NodeID = fc9efaea-7f15-14c9-438a-760e4a92be0a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Guards_AD_Idle:fc9efaea-7f15-14c9-438a-760e4a92be0a
msgctxt "hfc5dd137g4802g4e0eg8583gca7ccc8b2d86"
msgid "Aw, c'mon now. They're just 'avin a bit o' fun."
msgstr "에이, 그만해. 녀석들은 재미를 좀 보고 있는 것뿐이라구."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_NerdyGoblinSage_AD
#. Speaker = Booyahg Piddle
#. NodeID = 61c5819d-d57f-0826-4769-401e73e67d2b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_HasVoloGoblinManuscript(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_NerdyGoblinSage_AD:61c5819d-d57f-0826-4769-401e73e67d2b
msgctxt "h511b3ea5ga104g4994ga1e0g5f25c121046b"
msgid "Tha's a long word..."
msgstr "긴 단언데..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_NerdyGoblinSage_AD
#. Speaker = Booyahg Piddle
#. NodeID = 61c5819d-d57f-0826-4769-401e73e67d2b
#. HandlePath = TaggedText[0].TagText[1]
#. CheckFlags:
#.   Object:
#.      - GOB_HasVoloGoblinManuscript(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_NerdyGoblinSage_AD:61c5819d-d57f-0826-4769-401e73e67d2b
msgctxt "h5641366bg6348g4d34g8290g8b7c5a628166"
msgid "This is makin' my head hurt."
msgstr "머리 아프게 하네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_NerdyGoblinSage_AD
#. Speaker = Booyahg Piddle
#. NodeID = 61c5819d-d57f-0826-4769-401e73e67d2b
#. HandlePath = TaggedText[0].TagText[2]
#. CheckFlags:
#.   Object:
#.      - GOB_HasVoloGoblinManuscript(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_NerdyGoblinSage_AD:61c5819d-d57f-0826-4769-401e73e67d2b
msgctxt "he0b98c66g3924g4296g9706ge6502c69d80c"
msgid "<i>Sad-is-tick</i>? Wot's a tick got to be sad about?"
msgstr "<i>가-학-적</i>? 학을 적에게 가게 한다고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_NerdyGoblinSage_AD
#. Speaker = Booyahg Piddle
#. NodeID = 61c5819d-d57f-0826-4769-401e73e67d2b
#. HandlePath = TaggedText[0].TagText[3]
#. CheckFlags:
#.   Object:
#.      - GOB_HasVoloGoblinManuscript(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_NerdyGoblinSage_AD:61c5819d-d57f-0826-4769-401e73e67d2b
msgctxt "hdd411351ga8feg4db9gb5eegd7157e6d3236"
msgid "Doesn't make any sense..."
msgstr "말이 안 되는구만..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_PainPriest_AD_Battlestation
#. Speaker = Abdirak
#. NodeID = 20ea3fb6-ae18-c027-fc49-eef52c9b8989
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_PainPriest_AD_Battlestation:20ea3fb6-ae18-c027-fc49-eef52c9b8989
msgctxt "h91b0f5d8g4a8dg4a22gbe2cge8dafd8f8c80"
msgid "My interest is in pain - not <i>death</i>. I'll take no part in this."
msgstr "내 관심사는 고통이지, <i>죽음</i>이 아니라고. 여기엔 관여하고 싶지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_PainPriest_AD_BeginPenance
#. Speaker = Abdirak
#. NodeID = 27349673-84c4-411b-bcdf-40739ad9e43c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_PainPriest_AD_BeginPenance:27349673-84c4-411b-bcdf-40739ad9e43c
msgctxt "hd6a98182g3676g42e0g897eg523c2dc2da53"
msgid "Be still. I do not wish to hurt you - too much."
msgstr "가만히 있어. 널 다치게 하고 싶진 않다고. 과하게는."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_PainPriest_AD_BeginPenance
#. Speaker = Abdirak
#. NodeID = 39dd813c-ec47-58af-c01a-e5aa541ad3a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_PainPriest_AD_BeginPenance:39dd813c-ec47-58af-c01a-e5aa541ad3a5
msgctxt "hb670ccbdgbf49g410eg8260g55f0605d48ea"
msgid "Now - steady your heart, and <i>do not move. </i>"
msgstr "자, 마음을 단단히 먹고, <i>움직이지 마. </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_PainPriest_AD_BeginPenance
#. Speaker = Abdirak
#. NodeID = 9d1365c5-9ae6-a2a1-99b9-07f6a52a0390
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_PainPriest_AD_BeginPenance:9d1365c5-9ae6-a2a1-99b9-07f6a52a0390
msgctxt "h38356d25g5ddag4302g91dag00d66628a9fa"
msgid ""
"Do not move, child. We don't want to cause anything permanent, now do we?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_PainPriest_AD_Bible
#. Speaker = Player
#. NodeID = b073b9d5-569f-3226-b4fe-f6457a09e8f2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_PainPriest_State_PassedBookCheck = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_PainPriest_AD_Bible:b073b9d5-569f-3226-b4fe-f6457a09e8f2
msgctxt "h015372f8g3277g4ffag8e80g6636c82443db"
msgid ""
"Loviatar - a goddess who thrives on pain. This book must be for her "
"followers."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_PainPriest_AD_Bible
#. Speaker = Player
#. NodeID = e23df73e-08b7-00b2-e688-048c061b2ec7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_PainPriest_AD_Bible:e23df73e-08b7-00b2-e688-048c061b2ec7
msgctxt "h414c4c42g26f7g43a7gab6fg0e9f78e5d3a0"
msgid "Loviatar? Sounds like a violent goddess. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_PainPriest_AD_GobletLowHP
#. Speaker = Abdirak
#. NodeID = 35584fed-e364-1448-27f8-d927dff9fafb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_PainPriest_AD_GobletLowHP:35584fed-e364-1448-27f8-d927dff9fafb
msgctxt "h04762c7dgd672g4b71g80b0g668fc92ac6a9"
msgid "Tend to your wounds, and we shall continue."
msgstr "상처를 돌보라고. 그런 다음 이어서 할 테니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_PainPriest_AD_GobletLowHP
#. Speaker = Abdirak
#. NodeID = 95fdef7b-2b95-ff75-a26c-538200742a66
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_PainPriest_AD_GobletLowHP:95fdef7b-2b95-ff75-a26c-538200742a66
msgctxt "h622ec639gb12bg46c6gace2g87cfeda3a888"
msgid "We have been over this. <i>Twice. </i>"
msgstr "이 얘긴 이미 끝냈잖아. <i>두 번이나.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_PainPriest_AD_GobletLowHP
#. Speaker = Lookout Grush
#. NodeID = d6807a83-8300-36b3-7791-059cf6c5136b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_PainPriest_AD_GobletLowHP:d6807a83-8300-36b3-7791-059cf6c5136b
msgctxt "hbed13848g6524g49f5gb5acg0578c3440d92"
msgid "I don't get it. Ain't I supposed to be wounded?"
msgstr "이해가 안 되네! 내가 다쳐야 하는 거 아니었어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_PainPriest_AD_OrderFaceWall
#. Speaker = Abdirak
#. NodeID = 28a3fbbd-62fb-c1d7-8739-9670ccb2f3c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_PainPriest_AD_OrderFaceWall:28a3fbbd-62fb-c1d7-8739-9670ccb2f3c0
msgctxt "ha1279d4fgc583g4d48ga163g4901ba406ff1"
msgid "Good. Turn towards the wall."
msgstr "좋아. 벽을 마주보고 서거라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_PainPriest_AD_PenanceWithGoblet
#. Speaker = Lookout Grush
#. NodeID = 43aebf4a-133d-303a-4f6f-d23945d7a3bb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_PainPriest_AD_PenanceWithGoblet:43aebf4a-133d-303a-4f6f-d23945d7a3bb
msgctxt "h7bed6b1cg6a8eg4fc8g90ccg80ca67c5b8c2"
msgid "What, no ripping me to pieces? Weird."
msgstr "뭐여, 날 찢어발기는 거 아니었어? 이상하네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_PainPriest_AD_PenanceWithGoblet
#. Speaker = Abdirak
#. NodeID = 625c042f-ec21-f584-c9cc-381e4c70cb9e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_PainPriest_AD_PenanceWithGoblet:625c042f-ec21-f584-c9cc-381e4c70cb9e
msgctxt "h8cf414dcg3774g4532gb18bg1858d43d205a"
msgid "Just - just keep quiet."
msgstr "그냥- 제발 조용히 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_PainPriest_AD_PenanceWithGoblet
#. Speaker = Abdirak
#. NodeID = 6490cbdd-0704-037f-0ab5-4bb1d3738ae3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 51ad75bf-bd86-60cb-fb11-b3b5728e81cc_ADLoop2 = True
#. SetFlags:
#.   Local:
#.     - 51ad75bf-bd86-60cb-fb11-b3b5728e81cc_ADLoop1 = True
#.     - 51ad75bf-bd86-60cb-fb11-b3b5728e81cc_ADLoop2 = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_PainPriest_AD_PenanceWithGoblet:6490cbdd-0704-037f-0ab5-4bb1d3738ae3
msgctxt "h211c0027g350ag4f23g947egf46aa1b6b7f8"
msgid "The pain you suffer will cleanse you - do not fight it."
msgstr "네가 겪는 고통이 너를 정화할 것이다. 맞서지 말거라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_PainPriest_AD_PenanceWithGoblet
#. Speaker = Lookout Grush
#. NodeID = 6721de70-f187-c0d5-079f-21d6be661444
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_PainPriest_AD_PenanceWithGoblet:6721de70-f187-c0d5-079f-21d6be661444
msgctxt "h34a3ef23ga182g4059g9132g77813c30f02f"
msgid "Oh, lemme try the fancy whip thing after!"
msgstr "어으, 다 끝나면 그 멋드러진 채찍 한 번 쓰게 해줘!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_PainPriest_AD_PenanceWithGoblet
#. Speaker = Abdirak
#. NodeID = 714dc9a7-6785-e5b9-8ad8-716d9b83a787
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 51ad75bf-bd86-60cb-fb11-b3b5728e81cc_ADLoop1 = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_PainPriest_AD_PenanceWithGoblet:714dc9a7-6785-e5b9-8ad8-716d9b83a787
msgctxt "h365f606bg6412g4b01g8df9g08cf841de066"
msgid "Pain is proof that we live! Revel in it."
msgstr "고통은 살아있다는 증거다! 그것에 열중해라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_PainPriest_AD_PenanceWithGoblet
#. Speaker = Abdirak
#. NodeID = 886e05f0-1ba1-cb5c-acbb-873d8996ce96
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 51ad75bf-bd86-60cb-fb11-b3b5728e81cc_ADLoop1 = True
#. SetFlags:
#.   Local:
#.     - 51ad75bf-bd86-60cb-fb11-b3b5728e81cc_ADLoop2 = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_PainPriest_AD_PenanceWithGoblet:886e05f0-1ba1-cb5c-acbb-873d8996ce96
msgctxt "h3a896183gc031g4291ga029gc1d9902e5b51"
msgid "Cry out - <i>embrace </i>it!"
msgstr "울부짖어라, <i>받아들여라!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_PainPriest_AD_PenanceWithGoblet
#. Speaker = Abdirak
#. NodeID = ca503e49-fbca-4642-302d-95559a983ef8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_PainPriest_AD_PenanceWithGoblet:ca503e49-fbca-4642-302d-95559a983ef8
msgctxt "ha7b563a0g639bg4529ga61cg4b7afa21f1a1"
msgid "That is not what I meant."
msgstr "그런 뜻으로 말한 게 아니다."

