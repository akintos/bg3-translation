#.      - TRUESOUL(1) = False
#.      - ILLITHID(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ConflictedFlind_Flind:d4c45824-a91e-a6ef-eb34-c497dc360460
msgctxt "h307286f2g214fg4ccfgb6e9g2f820e241486"
msgid "<i>Harness her anger - the meat in the cave must die.</i>"
msgstr "<i>그녀의 분노를 이끌어낸다 - 동굴 속의 고기는 죽어야만 한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ConflictedFlind_Flind
#. Speaker = Narrator
#. NodeID = d83cef8a-4041-48e8-a515-12ec97c049c5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount5(1) = False
