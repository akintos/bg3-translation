msgctxt "h6f44470bg3dcag4f2fg95c3gcc26db6d7b64"
msgid "*The corpse regards you lifelessly.*"
msgstr "*시체가 생기 없는 모습으로 당신을 맞이합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_TollCollector001_Dead
#. Speaker = Narrator
#. NodeID = 97decd02-97df-99a2-750d-20aaf1805fb7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_TollCollector001_Dead:97decd02-97df-99a2-750d-20aaf1805fb7
msgctxt "hfb48eeadg2829g4d78g89aeg4daa88b3569a"
msgid "*The corpse does not stir. It will answer no more questions.*"
msgstr "*시체는 움직이지 않습니다. 더 이상 질문을 받지 않을 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_TollCollector001_Dead
