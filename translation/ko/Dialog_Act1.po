msgctxt "h977043f3g9986g4053ga32dg094948a3133f"
msgid "Hmph. Humans. What did they expect?"
msgstr "흐음. 인간이란. 뭘 기대했던 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_HagAmush_PAD_FoundBrothersAfterLongRest
#. Speaker = Player
#. NodeID = e908ba6a-4009-81ee-2844-0427c4e67e5e
