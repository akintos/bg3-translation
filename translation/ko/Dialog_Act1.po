msgctxt "h7b472447g8997g4617g8fdfgfc0094d681b3"
msgid "You haven't seen anything yet, mister!"
msgstr "이 정도는 아무것도 아니에요, 신사분!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 737987a7-831f-18d0-90f2-dd710beceb74
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:737987a7-831f-18d0-90f2-dd710beceb74
msgctxt "he25f021cg2bcfg4fdfg9081g6e7f939a1b58"
msgid "You haven't seen anything yet!"
msgstr "이 정도는 아무것도 아니랍니다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 760ecd56-0928-1002-0602-ed1332bc026a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_State_KeptMagicRing = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:760ecd56-0928-1002-0602-ed1332bc026a
msgctxt "h84fdaacega57cg41d2gbb89gaedf0d098efc"
msgid "You're getting paid in experience. The ring is <i>mine </i>now."
msgstr "경험으로 대가를 치뤘다고 생각하렴. 이 반지는 이제 <i>내 소유</i>야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 76d9764b-313b-489d-25f3-88640879afc1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Knows_PlayerRobbed = True
#.      - DEN_Hideout_State_ResolvedThieflings = False
#.      - DEN_Thieflings_Event_CaughtThief = False
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Pickpocket1_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:76d9764b-313b-489d-25f3-88640879afc1
msgctxt "h18633941g3090g480fg908cgc4632627746b"
msgid "Hey, you're back! Here to buy some stuff?"
msgstr "돌아오셨네요! 뭘 좀 사시려고요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 77ce6008-8be2-d8bd-9d31-325a10c2e234
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:77ce6008-8be2-d8bd-9d31-325a10c2e234
msgctxt "h5a0b0702gaacfg4aa0gbf99g6497db4e3fb0"
msgid "I - look, lady, it's nothing personal."
msgstr "전 - 그러니까, 숙녀분, 기분을 상하게 하려고 했던 건 아니에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 77ce6008-8be2-d8bd-9d31-325a10c2e234
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:77ce6008-8be2-d8bd-9d31-325a10c2e234
msgctxt "h0ee92f65g503eg4d8fg8123g5b26dc61cf6c"
msgid "I- look, mister, it's nothing personal."
msgstr "전 - 그러니까, 신사분, 기분을 상하게 하려고 했던 건 아니에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 77ce6008-8be2-d8bd-9d31-325a10c2e234
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:77ce6008-8be2-d8bd-9d31-325a10c2e234
msgctxt "h48b7abf4ge144g4d71g9235gbdd3b9eacbee"
msgid "I - look, it's nothing personal."
msgstr "전 - 그러니까, 기분을 상하게 하려고 했던 건 아니에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 77de8624-d983-d1c2-b631-4044d09ec178
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:77de8624-d983-d1c2-b631-4044d09ec178
msgctxt "h1538111egc88dg4818g98bcgb8eb6cdd921a"
msgid ""
"But word to the wise? You should probably let my boss know you're working "
"here."
msgstr "하지만 현명한 조언을 해줄까요? 내 대장에게 네가 여기서 작업하고 있다는 걸 알려야 할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 7848cf94-7ece-89ca-1f83-3092565bdf8a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Pickpocket1_HasMet(1) = True
#.   Global:
#.      - DEN_Hideout_State_ResolvedThieflings = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:7848cf94-7ece-89ca-1f83-3092565bdf8a
msgctxt "hba14e27bg8910g4c66g8ce5g6897c842e92a"
msgid "Hey, you're back. Here to trade?"
msgstr "돌아오셨네요. 거래를 하러 오셨나요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 79b779f0-5c2e-48e0-a87f-fd75a39f9fd5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LOLTHDROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:79b779f0-5c2e-48e0-a87f-fd75a39f9fd5
msgctxt "ha5cb2e15g6493g43cbgac8fg7ef7fe0dec41"
msgid "Nonsense! We kill far more children than we enslave."
msgstr "헛소리! 우린 아이들을 노예로 삼는 것보단 죽이는 걸 좋아해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 7b0d7271-e2e9-116b-0ab7-e803147fb128
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ROGUE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:7b0d7271-e2e9-116b-0ab7-e803147fb128
msgctxt "h7d65c52egc8d8g4b75gaf3fg54541ac75056"
msgid "I've been playing this game longer than you. I tend to win."
msgstr "난 이런 일에 너보다 훨씬 경험이 많아. 보통은 내가 이기지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 7bafc601-b2ce-d6d4-d0f0-c4526537c0e7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = False
#.      - REALLY_KARLACH(1) = False
#.      - REALLY_SHADOWHEART(1) = False
#.      - REALLY_LOLTHDROWELF(1) = False
#.      - REALLY_GITHYANKI(1) = False
#.      - REALLY_ASTARION(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:7bafc601-b2ce-d6d4-d0f0-c4526537c0e7
msgctxt "h34177e8egacc9g4c76gb376g95024889ad0d"
msgid "You can make it right - by giving me a percentage of your take."
msgstr "이 일을 바로잡을 수도 있지. 네 몫에서 일정 비율을 넘겨."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Narrator
#. NodeID = 7bb476a5-dac5-1e69-a3d1-ee0843bbf140
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_SuccessfulPickpocket = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:7bb476a5-dac5-1e69-a3d1-ee0843bbf140
msgctxt "hd71c2c8eg9c1fg4dd1g93ebg332d1dea506f"
msgid "*You spot the boy giving a sly wink as he turns away.*"
msgstr "*당신은 소년이 돌아서면서 능청스런 윙크를 보내는 것을 포착합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 7c6cdb01-b1de-3394-3dee-23285fd67073
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:7c6cdb01-b1de-3394-3dee-23285fd67073
msgctxt "hf049d3e7g6a72g4ef8ga41bgbdfe3c8ac0e7"
msgid ""
"Fine. I'm not so good at counting, but I think any percentage of zero is "
"zero."
msgstr "그러죠 뭐. 저는 계산은 잘 못하지만, 0의 일정 비율은 0이라고 생각해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 7cd9c31a-2870-9e6a-32dc-c9f9e0aac3c0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Pickpocket1_PCShowedHandSignal(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:7cd9c31a-2870-9e6a-32dc-c9f9e0aac3c0
msgctxt "h877f4716g8d7eg4972g9682g1a5a6872a7a0"
msgid "Keep moving, huh? I'm working here."
msgstr "가던 길 가세요, 네? 지금 일하고 있잖아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 7d41adc0-f7c9-655d-8df7-ba6f8dbd1476
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:7d41adc0-f7c9-655d-8df7-ba6f8dbd1476
msgctxt "h19b7c136gbb19g410agac16gc20ad21ba910"
msgid "I, uh, I don't know what you mean."
msgstr "저는, 어, 무슨 말씀을 하시는지 모르겠어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 7f2a44f4-9f7b-c6d6-bd7e-68d4e63d1716
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:7f2a44f4-9f7b-c6d6-bd7e-68d4e63d1716
msgctxt "h8f01a248gc165g4924g8b8cg7c53be06b646"
msgid "Far be it from me to argue with that discerning eye of yours, sir."
msgstr "그 분별력 있는 눈썰미에 반박할 생각은 전혀 없습니다, 손님."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 7f2a44f4-9f7b-c6d6-bd7e-68d4e63d1716
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:7f2a44f4-9f7b-c6d6-bd7e-68d4e63d1716
msgctxt "h0ec14b20g70b4g4c7cg98d0g742907494616"
msgid "Not sure what you expected. I'm a kid living at the back of a cave."
msgstr "뭘 기대하신 건지 모르겠네요. 저는 동굴 뒤편에 사는 꼬맹이인걸요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 7f8229c2-e936-9d5e-0b7b-aad0b43fecb9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Pickpocket1_CoinGame3(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Pickpocket1_CoinGame4(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:7f8229c2-e936-9d5e-0b7b-aad0b43fecb9
msgctxt "h573a4a01gd059g421fgb554g55412c892eef"
msgid "Heads. Or tails."
msgstr "앞면 혹은 뒷면."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 7fc5bf6e-d1a0-10f3-7b00-ba0c5c6d531f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:7fc5bf6e-d1a0-10f3-7b00-ba0c5c6d531f
msgctxt "he42aeb8cgbcd5g46bbgb968gb65c5d7ebbae"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 8058594d-a2d2-c3be-3b64-109bf5fffdb9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:8058594d-a2d2-c3be-3b64-109bf5fffdb9
msgctxt "h020fcd79g8cbbg45faga013ga76169ade8f1"
msgid ""
"I know, but you didn't have business with her then. Now you do. Good luck!"
msgstr "알아요, 하지만 그때는 걔랑 거래를 하지 않으셨는데. 지금은 하고 있잖아요. 행운을 빌어요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 816ceebb-e578-96f7-3bae-8cc35aaf3232
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:816ceebb-e578-96f7-3bae-8cc35aaf3232
msgctxt "h60988f81g278dg4867g93ffg1589231ae56d"
msgid "Last chance. You want a look at my stuff or not?"
msgstr "마지막 기회에요. 제 물건을 보고 싶으세요, 안 보고 싶으세요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 8192a840-eddb-3cd6-ae38-07bccf392dbd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Event_MerchantKidLeaves = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:8192a840-eddb-3cd6-ae38-07bccf392dbd
msgctxt "h919d87f1g3bc9g4c6dg8a71g4bb2fff9100e"
msgid "Change your mind."
msgstr "생각을 바꾸세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 82bcb1e4-6da8-0487-b37c-ecb3136f0471
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:82bcb1e4-6da8-0487-b37c-ecb3136f0471
msgctxt "h8653e5d8gb8b7g4f87gab55g5f8adccd8cff"
msgid "Look, whatever you think, take it up with Mol."
msgstr "이봐요, 무슨 생각을 하고 계시든, 몰과 이야기해 보세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 841bb92d-c360-f63f-f634-aed45a81c39c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Pickpocket1_CoinGame2(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Pickpocket1_CoinGame3(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:841bb92d-c360-f63f-f634-aed45a81c39c
msgctxt "h9508d1c6g7d5bg4a27g8697gb17a5ab043b9"
msgid "F... fine. Heads or tails?"
msgstr "좆... 좋아요. 앞면 혹은 뒷면?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 85b134a0-ba7e-eaac-8b30-4c87bb242134
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:85b134a0-ba7e-eaac-8b30-4c87bb242134
msgctxt "h25ee4007g282fg45beg8813g0aca6df3a4c4"
msgid "Hold on. One coin toss doesn't prove anything."
msgstr "잠깐만. 동전 던지기 한 번만으로는 뭘 증명할 수 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 86c27213-011e-08ef-e279-d927e4a29519
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:86c27213-011e-08ef-e279-d927e4a29519
msgctxt "he40adb2cg6875g4fc9gbb25gedbe237212ae"
msgid "You bet. Good luck, pal!"
msgstr "당연하죠. 행운을 빕니다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 87c0aea3-9898-32e2-a792-8efd9e3606e3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Party:
#.      - DEN_Thieflings_Event_FirstTheftCheck(1) = False
#. SetFlags:
#.   Party:
#.     - DEN_Thieflings_Event_FirstTheftCheck(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:87c0aea3-9898-32e2-a792-8efd9e3606e3
msgctxt "ha7d57935gb920g441bg8091gca0c1405d0c8"
msgid "You got it. One sec."
msgstr "그러세요. 잠시만요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 88602039-c4ee-244d-8fff-63a5d6ccef74
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:88602039-c4ee-244d-8fff-63a5d6ccef74
msgctxt "ha3fb090fg3bdfg427bgb463g7d3bedb214e3"
msgid "I- look, mister, I don't want trouble."
msgstr "저- 그러니까, 신사분, 문제를 일으키고 싶진 않아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 88602039-c4ee-244d-8fff-63a5d6ccef74
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:88602039-c4ee-244d-8fff-63a5d6ccef74
msgctxt "h52052a47gd369g4fbdgaaf8gcb2404dcc1b5"
msgid "I- look, lady, I don't want trouble."
msgstr "저- 그러니까, 숙녀분, 문제를 일으키고 싶진 않아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 88602039-c4ee-244d-8fff-63a5d6ccef74
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:88602039-c4ee-244d-8fff-63a5d6ccef74
msgctxt "hb76abbd7g9a22g41c5g9a05gce95ec129fad"
msgid "I- look, I don't want trouble."
msgstr "저- 그러니까, 문제를 일으키고 싶진 않아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 88ae7f3f-d37f-834d-2924-ec01516c2078
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:88ae7f3f-d37f-834d-2924-ec01516c2078
msgctxt "hc5a5f73fg14e5g4f12gb3e3g695898aaff19"
msgid "And I promise this isn't a Tinker's Trash scam."
msgstr "하지만 이건 땜장이의 쓰레기 사기가 아니라고 약속해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 88d6cae2-e07f-94f2-3399-12b0cc595dba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:88d6cae2-e07f-94f2-3399-12b0cc595dba
msgctxt "h6324e258gda67g4aeaga8c4g649ad81d7ab2"
msgid "<i>Leave. </i>"
msgstr "<i>떠난다. </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 8b43de2d-668e-a2b8-f591-d396867a3327
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_Thieflings_Event_CheckKnowsHideout(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:8b43de2d-668e-a2b8-f591-d396867a3327
msgctxt "h500f85a4g5796g45c4g8a44g8ac90ae89a56"
msgid "Your funeral. Mol gets spicy when people leave her out of the know."
msgstr "당신이 책임져야겠죠. 몰은 사람들이 자기를 소외시키면 화를 내거든요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 8c11d454-b3c2-001f-3ca1-a0d42f7fcab3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:8c11d454-b3c2-001f-3ca1-a0d42f7fcab3
msgctxt "h67090babg902dg4648ga6e2g46078ce6d25c"
msgid "But you gotta at least look at the other rings, okay? I gotta eat."
msgstr "그치만 적어도 다른 반지들은 보셔야 돼요, 아셨죠? 저도 먹고 살아야죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 8d9c372f-c263-7e7b-73a1-8bec37a93c11
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:8d9c372f-c263-7e7b-73a1-8bec37a93c11
msgctxt "haebd03dfgad56g409bgb2a7gc7e126c6b434"
msgid "<i>Leave</i>."
msgstr "<i>떠난다</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 8e2b32e6-e144-8479-2d44-89b9a1d27430
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Pickpocket1_CoinGame1(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Pickpocket1_CoinGame1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:8e2b32e6-e144-8479-2d44-89b9a1d27430
msgctxt "h5b37f373g1040g4697g935bg6282e6e158ea"
msgid "Really? I mean... fine. Heads or tails?"
msgstr "정말요? 제 말은... 알겠어요. 앞면 혹은 뒷면?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 8ea1c556-abfc-c1e9-cef0-331786659771
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:8ea1c556-abfc-c1e9-cef0-331786659771
msgctxt "h88611017g2e2ag4f7cg9d72ge4a688f25d6d"
msgid "I don't have to do anything. Goodbye."
msgstr "나는 아무 것도 할 필요 없어. 잘 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 8f2d8e6c-02b4-eaea-a23e-a5be86bb7084
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:8f2d8e6c-02b4-eaea-a23e-a5be86bb7084
msgctxt "h689d9ae7g725fg4ea8ga199g4109d8d2813a"
msgid "Careful. Not everyone is as forgiving as I am."
msgstr "조심해. 다들 나처럼 너그러운 건 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 904a117f-ddee-ec3b-68e6-72424b918a70
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Knows_KidsThieves = True
#.     - DEN_Thieflings_Knows_LimsRingGameIsAScam = True
#. TagRule: WARLOCK or WIZARD
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:904a117f-ddee-ec3b-68e6-72424b918a70
msgctxt "hc52e5757g7e03g4993gbfa4g893abaa37ac7"
msgid "The 'runes' on this ring are gibberish."
msgstr "이 반지에 적힌 '룬'이라는 건 그냥 낙서잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 9065a7e8-aa4a-2892-3d7e-2fcde8de0414
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:9065a7e8-aa4a-2892-3d7e-2fcde8de0414
msgctxt "ha86f2769g6f46g4f2dgb4dag427f60f03907"
msgid "That hurts. It's a great <i>big </i>scam."
msgstr "상처인데요. 이건 <i>대단한</i> 사기라고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 91adc1c8-1340-1e53-e7c3-1f3124d98977
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:91adc1c8-1340-1e53-e7c3-1f3124d98977
msgctxt "h7dd45de8gd5d5g4a18g9b95g2e621540b6bb"
msgid "Tails."
msgstr "뒷면."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 91b0fd07-eac6-d783-951f-7cdd3fc074cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:91b0fd07-eac6-d783-951f-7cdd3fc074cb
msgctxt "h24d2e08dg1afbg419dgb9e0g0d009e1a5ec4"
msgid "Tails."
msgstr "뒷면."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 91c24a39-3455-7997-8145-1629adad6a65
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:91c24a39-3455-7997-8145-1629adad6a65
msgctxt "h6ff1d618ga691g4286ga2e7ga0b5755b3d3d"
msgid "Hey, not so loud!"
msgstr "이봐요, 너무 크게 말하지 마요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 92ed5596-83fc-7c83-c85d-32bf407b3078
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:92ed5596-83fc-7c83-c85d-32bf407b3078
msgctxt "h651c19f0g31c5g43feg91b7g37151aa2fe46"
msgid "Bye, I guess?"
msgstr "어, 그러니까, 안녕히 가세요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 92f78961-5916-d91c-eb38-5fe5332d9a59
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:92f78961-5916-d91c-eb38-5fe5332d9a59
msgctxt "hbedcf1b8g9b33g4914g8f19gf73b88e5a2d8"
msgid "It's just a ring, lady. I know it's nothing special."
msgstr "그건 그냥 반지일 뿐이에요, 숙녀분. 저도 평범한 거라는 건 알아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 92f78961-5916-d91c-eb38-5fe5332d9a59
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:92f78961-5916-d91c-eb38-5fe5332d9a59
msgctxt "hdae542d4g8ad6g4704g90begab93223e625d"
msgid "It's just a ring, mister. I know it's nothing special."
msgstr "그건 그냥 반지일 뿐이에요, 신사분. 저도 평범한 거라는 건 알아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 92f78961-5916-d91c-eb38-5fe5332d9a59
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:92f78961-5916-d91c-eb38-5fe5332d9a59
msgctxt "h5591c167g2286g430eg9d00gdaf7f1e373ba"
msgid "It's just a ring. I know it's nothing special."
msgstr "그건 그냥 반지일 뿐이에요. 저도 평범한 거라는 건 알아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 937d9b83-c537-0107-c330-4314c3a4a3ce
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Event_ToldAboutHideoutLeader(1) = True
#.   Quest:
#.      - DEN_Thieflings.TriedSmallEntrance(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:937d9b83-c537-0107-c330-4314c3a4a3ce
msgctxt "hd8472f91g1855g4d5agb2c4ge0bf11fec36a"
msgid "Is there a larger entrance to the hideout?"
msgstr "은신처로 가는 더 큰 입구는 없니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 95798796-831a-dd00-5cfd-1de4244c539e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_Thieflings_Event_TransferPickpocketRing(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:95798796-831a-dd00-5cfd-1de4244c539e
msgctxt "h46c74642g122eg489fga997g2d598a53164b"
msgid "Actually, never mind. Just take your ring."
msgstr "사실은, 신경 쓰지 마. 그냥 반지를 가져가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Narrator
#. NodeID = 95fcefd8-96ce-61ef-0e23-aefe1e486ab9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:95fcefd8-96ce-61ef-0e23-aefe1e486ab9
msgctxt "h1a156115g3198g42b9g9a29g515f62dc500c"
msgid ""
"*As you turn to leave, you realise the other child does too. She looks "
"nervous.*"
msgstr "*당신이 떠나려고 돌아섰을 때, 다른 아이도 그런다는 것을 깨닫습니다. 그녀는 불안해 보입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 967bb15d-e90b-eb60-0d26-e95c8edc7433
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:967bb15d-e90b-eb60-0d26-e95c8edc7433
msgctxt "he8b7d019g48b8g4fb8g8759gdcafb29df410"
msgid "Anyway, see you again sometime. Take care! Safe travels!"
msgstr "아무튼, 언젠가 다시 봐요. 건강히 지내시고 안전한 여행 되세요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 975e324b-a8f4-500c-9326-8a1ed5453c5c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_TriedRingScamOn(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:975e324b-a8f4-500c-9326-8a1ed5453c5c
msgctxt "h87d2c9e4g672dg4c86g8ff9gf326d15689c9"
msgid "You some kind of elf or something?"
msgstr "무슨 엘프 같은 건가요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 97a9435c-7998-3238-e0d0-d33c8c1763a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:97a9435c-7998-3238-e0d0-d33c8c1763a7
msgctxt "hcf83a1abga610g47f5g8880g0efca9ffaa88"
msgid "See? That's the kinda luck you get from just one of my lucky rings!"
msgstr "보셨죠? 제 행운의 반지 하나만 있으면 이런 행운을 얻을 수 있어요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 980f4909-0b74-565f-193a-6c9238521b47
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:980f4909-0b74-565f-193a-6c9238521b47
msgctxt "h7c080753g4a5dg4d52g8b5fga29feea3f07e"
msgid "Do I frighten you?"
msgstr "내가 두렵니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 98b88a0c-4710-9efe-106b-b1113c90143f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Knows_KidsThieves = True
#. TagRule: ROGUE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:98b88a0c-4710-9efe-106b-b1113c90143f
msgctxt "h4740dee9ga8b5g4545ga27agf0eba9da5377"
msgid "I've no time for a scam. Bye, kid."
msgstr "나는 사기에 어울릴 시간 없어. 잘 있어, 꼬마야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 98b88a0c-4710-9efe-106b-b1113c90143f
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Knows_KidsThieves = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:98b88a0c-4710-9efe-106b-b1113c90143f
msgctxt "hcda2f599g6fc4g4808gbda8g06bc6ddb24aa"
msgid "<i>Leave. </i>"
msgstr "<i>떠난다. </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 99108038-34df-000c-0fc8-755c564db702
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:99108038-34df-000c-0fc8-755c564db702
msgctxt "h2335e69cgf617g4088g930bgfe2ccd158c37"
msgid "No! I mean - it's nothing personal, lady."
msgstr "아뇨! 제 말은, 개인적인 감정은 전혀 없어요, 아가씨."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Narrator
#. NodeID = 999c3fd6-609e-1e76-be6a-fc234098c5b7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Knows_KidsThieves = True
#.     - DEN_Thieflings_Event_PlayerRobbed_Noticed = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:999c3fd6-609e-1e76-be6a-fc234098c5b7
msgctxt "h82f5e05cg4598g4949gaed5g251babc27ab4"
msgid "*You realise your bag feels light.*"
msgstr "*당신은 가방이 가벼움을 느낍니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 99bb8db5-4be4-3de4-6c1e-7d625dfc3afd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:99bb8db5-4be4-3de4-6c1e-7d625dfc3afd
msgctxt "h5f9f8a6eg58ffg4d17gb8f3g2d90ff9d75c1"
msgid "Go on. Take this ring. It's <i>lucky</i>."
msgstr "어서. 이 반지를 가져가세요. <i>행운</i>의 반지예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 9b0fb953-00fc-8c86-48ec-a6c838c59ea8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LOLTHDROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:9b0fb953-00fc-8c86-48ec-a6c838c59ea8
msgctxt "h3c989060gc80fg4c42gab32gab507e2a08e0"
msgid "Thieves make poor slaves - until you break them, at least."
msgstr "도둑은 노예로서는 부적합해. 적어도 그들을 굴복시킬 때까지는."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 9b1db553-d781-0451-ce80-7a86157a1038
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Pickpocket1_PCAttemptedTheftBefeoreCoinFlip(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:9b1db553-d781-0451-ce80-7a86157a1038
msgctxt "h0b70eea1ga151g4feag8073g61ca63b099c3"
msgid "Thanks for the free ring."
msgstr "공짜 반지 고마워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 9c74bdb0-6ca5-91f6-0f3f-ee5eca388d14
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:9c74bdb0-6ca5-91f6-0f3f-ee5eca388d14
msgctxt "h20b50642g627fg449ega683g4d0312313b51"
msgid "Then what kind of con is it?"
msgstr "그럼 무슨 사기지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 9f386a08-41ea-84d9-7da7-60f7741df494
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:9f386a08-41ea-84d9-7da7-60f7741df494
msgctxt "h1238f89eg35c2g4fcegbfafgce03d7cdf689"
msgid "No - and I'm keeping the ring."
msgstr "안 보고 싶어. 그리고 이 반지는 내가 가져가겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 9f894e80-a713-d080-d97a-2bb7dc0e1044
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_DUERGARDWARF or REALLY_DWARF
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:9f894e80-a713-d080-d97a-2bb7dc0e1044
msgctxt "h55a521b4gd957g4753gb5a5gd76925a6169b"
msgid "<i>Examine the ring.</i>"
msgstr "<i>반지를 조사한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = a0d8ce3e-8bc1-42e4-2d52-d3578fa894d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:a0d8ce3e-8bc1-42e4-2d52-d3578fa894d4
msgctxt "he92a3f47g591bg4039g989fg5aae6b20d345"
msgid ""
"Hey, that hurts. I'm running an honest... okay, what's a Tinker's Trash?"
msgstr "이봐요, 말씀이 심하시네요. 저는 정직한... 그런데, 땜장이의 사기는 뭔가요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = a2ae936e-5fb6-184d-0db8-786ab179593a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Hideout_State_ResolvedThieflings = False
#.   Party:
#.      - DEN_Thieflings_Event_FirstTheftCheck(1) = False
#. SetFlags:
#.   Party:
#.     - DEN_Thieflings_Event_FirstTheftCheck(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:a2ae936e-5fb6-184d-0db8-786ab179593a
msgctxt "h67411475g8c6ag4e99g8de8g6e7ef0e18b7d"
msgid "I knew it. Hang on..."
msgstr "그러실 줄 알았어요. 기다려 봐요..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = a2f428d7-ec70-1b91-cdd3-5352245489ce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:a2f428d7-ec70-1b91-cdd3-5352245489ce
msgctxt "hf3d1240cg4450g4627ga317g2605e3280032"
msgid "Indeed. A swamp elf."
msgstr "물론이지. 늪 엘프야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = a3a52c4b-12d7-711b-04af-3433f11e4f2b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:a3a52c4b-12d7-711b-04af-3433f11e4f2b
msgctxt "h389674b2g0529g486fg9efbg0ae87e46bb97"
msgid "Wait - what others?"
msgstr "잠깐, 다른 사람들이라니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = a503333d-5e04-3ce8-30f7-ab3c22d15f72
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SORCERER(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:a503333d-5e04-3ce8-30f7-ab3c22d15f72
msgctxt "h3c386e18g53e3g4475gb98fg6b5289f39818"
msgid ""
"If there was magic in this ring, I'd have felt it. It's nothing but junk."
msgstr "이 반지에 마법이 담겨 있었다면, 내가 느낄 수 있었을 거야. 이건 그냥 고물일 뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Narrator
#. NodeID = a5f90d9e-0c2c-3c14-85f0-ef82b0a5fd0c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Knows_PlayerRobbed = False
#.      - DEN_Thieflings_Event_PlayerRobbed_Twice = True
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Knows_PlayerRobbed = True
#.   Quest:
#.     - DEN_Thieflings.DiscoveredRobbed(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:a5f90d9e-0c2c-3c14-85f0-ef82b0a5fd0c
msgctxt "h1f61b081gdef6g449fg9ccbgf334f0ac817f"
msgid ""
"*You were robbed. And by the feel of your pack, not for the first time.*"
msgstr "*당신은 소매치기 당했습니다. 당신의 가방 무게로 느끼건대, 이번이 처음이 아닙니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = a7f2fc07-0aa3-9b69-182b-1fa1275298dc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Pickpocket1_PCIsNotAChump(1) = True
#.   Global:
#.      - DEN_Hideout_State_ResolvedThieflings = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:a7f2fc07-0aa3-9b69-182b-1fa1275298dc
msgctxt "h64dfb0cbgebccg4327g9400g084da13b8c2b"
msgid "Think you could stand back a ways, pal? I'm fishing for chumps here."
msgstr "좀 뒤로 물러나 줄래요? 난 지금 멍청이를 낚는 중이거든요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = a86fa162-23a4-0fdc-0192-6782b7153913
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_DUERGARDWARF or REALLY_DWARF
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:a86fa162-23a4-0fdc-0192-6782b7153913
msgctxt "h31319b6ag5932g4ac0ga00dg8717b432fdf0"
msgid "It <i>is </i>junk. But the raw materials might be useful."
msgstr "<i>이건</i> 쓰레기야. 하지만 원석은 쓸만할지도 몰라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = a86fa162-23a4-0fdc-0192-6782b7153913
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:a86fa162-23a4-0fdc-0192-6782b7153913
msgctxt "hb58c6b35g74c5g4152gb7bdg75ebbb4982be"
msgid "Collecting junk is a hobby of mine."
msgstr "쓰레기를 모으는 게 내 취미야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = a8cee8e1-bdbf-f140-64cb-e3d76dce997a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:a8cee8e1-bdbf-f140-64cb-e3d76dce997a
msgctxt "h5a265e0bg291bg4eb2gb661ge20cb61355c9"
msgid "No. Please. Go on."
msgstr "괜찮아. 한 번 계속해 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = ac8dbd00-69e3-0591-ada5-c5f00f12ac23
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_PlayerAdmittedPickpocketing = True
#.      - DEN_Thieflings_Event_MerchantKidLeaves = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Pickpocket1_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:ac8dbd00-69e3-0591-ada5-c5f00f12ac23
msgctxt "hdff845fbgcedag4d8bg99bag1eaa6d0e265a"
msgid ""
"I still have no idea how you took my ring. Mol won't say it, but she's "
"impressed."
msgstr "어떻게 당신이 제 반지를 가져갔는지 아직도 모르겠네요. 몰은 말하지 않겠지만, 걔도 감명 받았어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = ae8afa0a-3dba-4526-3a00-cddc00a63d11
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:ae8afa0a-3dba-4526-3a00-cddc00a63d11
msgctxt "h1c42f9ffga300g4613g92c0g9ee5f8c8b268"
msgid "So, <i>not </i>an elf? Okay."
msgstr "엘프 <i>아니시죠</i>? 좋아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = aec99f04-0a5e-e58a-c410-d24f17f84bae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:aec99f04-0a5e-e58a-c410-d24f17f84bae
msgctxt "h86876fc6g3454g407dga342gdb9eb80dc265"
msgid "Heads."
msgstr "앞면."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Narrator
#. NodeID = aedc9f37-1910-c4a6-f430-5dc8b4bb95b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:aedc9f37-1910-c4a6-f430-5dc8b4bb95b6
msgctxt "h0fc68aebg08a6g44aagb003gc753a0008d92"
msgid "*The metal is coarse and riddled with imperfections.*"
msgstr "*금속은 거칠고 결함이 가득합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = af388d7f-d47a-2e6d-d8a8-3bdaed077259
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:af388d7f-d47a-2e6d-d8a8-3bdaed077259
msgctxt "hd309a9a8ge6aag42d2gbd4bg0629219ff607"
msgid ""
"Look, I swear to you. These rings are the real deal. I promise I'm not "
"running a scam."
msgstr "이봐요, 전 당신에게 맹세해요. 이 반지는 진짜예요. 사기를 치는 게 아니라고 약속할게요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = afe4b446-c82b-b196-7bcb-a24abfbceabe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Event_OutrageousClaimsMentioned(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Event_OutrageousClaimsMentioned(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:afe4b446-c82b-b196-7bcb-a24abfbceabe
msgctxt "hd489a5b8ga2e2g4347g9ab9gfa3446f4ffa0"
msgid "It's all pretty terrible."
msgstr "모두 너무나 끔찍하군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = b0424b23-0eab-0f5a-4da3-9706e916ab04
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:b0424b23-0eab-0f5a-4da3-9706e916ab04
msgctxt "h77832c3dg3db5g4792g9029g31695eb8f68b"
msgid "I want to trade."
msgstr "거래를 하고 싶어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = b1ebdb1f-00dd-897a-047c-e7b82c9d7bac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:b1ebdb1f-00dd-897a-047c-e7b82c9d7bac
msgctxt "hcba255bcga3efg4742ga72dg1c99e8ed02a9"
msgid "It's when a scammer offers the target a 'magic' object..."
msgstr "사기꾼이 대상에게 '마법'의 물건을 제공하면..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = b1fa9b81-f1dc-d4bd-0775-723d6caf5b68
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:b1fa9b81-f1dc-d4bd-0775-723d6caf5b68
msgctxt "h189471adg44f2g445dga82ag8cd8ea5c9a6e"
msgid "Come on. This is a Tinker's Trash scam. A <i>clumsy </i>one."
msgstr "알고 있어. 이건 땜장이의 쓰레기 사기잖아. <i>어설픈</i> 수법이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = b22aef29-ad75-029b-1ef1-a2dfcad7c041
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Event_MentionedRingTheft(1) = False
#.   Global:
#.      - DEN_Thieflings_State_RingStolenBack = True
#.   Object:
#.      - DEN_Thieflings_State_HasPickpocketRing(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Event_MentionedRingTheft(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:b22aef29-ad75-029b-1ef1-a2dfcad7c041
msgctxt "h5fd16916ge355g44b9g9e14g45c7a281610b"
msgid "I don't have your ring. It vanished."
msgstr "나에게 너의 반지가 없어. 사라졌어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = b384f632-b785-7810-44b0-f8a397234fcf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:b384f632-b785-7810-44b0-f8a397234fcf
msgctxt "h37fb19bcg7ee5g427ag98afge9cc77d9e14f"
msgid "Huh. Interesting."
msgstr "허. 흥미롭네요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = b7fee2a8-6e61-98da-3ffd-76829447499c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:b7fee2a8-6e61-98da-3ffd-76829447499c
msgctxt "h848421ecg70c4g4863g8511g4640da08e47e"
msgid "Tails!"
msgstr "뒷면!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = b7fee2a8-6e61-98da-3ffd-76829447499c
#. HandlePath = TaggedText[0].TagText[1]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:b7fee2a8-6e61-98da-3ffd-76829447499c
msgctxt "h24b8a1b9gd428g43a8g83d1ge5c7afc3ed66"
msgid "Tails it is!"
msgstr "뒷면이네요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = b7fee2a8-6e61-98da-3ffd-76829447499c
#. HandlePath = TaggedText[0].TagText[2]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:b7fee2a8-6e61-98da-3ffd-76829447499c
msgctxt "h9c7b93b6ga658g49a9g84efg55ed24a7aba0"
msgid "We got tails!"
msgstr "뒷면이 나왔네요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = b92a5ac4-acca-4fcf-4940-63fffa8873c8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_State_MessedWithMolsKids = True
#.     - DEN_Thieflings_State_RippedOffPickpocketKid = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:b92a5ac4-acca-4fcf-4940-63fffa8873c8
msgctxt "hf8136196g5febg49e6g80bbg46fdf9f19d76"
msgid "You'll be sorry about this, scab. Count on it."
msgstr "이 일을 후회하게 될 거야, 딱지야. 두고 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = b9a08665-0fe3-6118-206c-878dd7e0c522
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:b9a08665-0fe3-6118-206c-878dd7e0c522
msgctxt "he9ee57cegb9f4g464aga807ga5e0a5286339"
msgid "... then rigs a game to gain the target's trust and sell them trash."
msgstr "... 게임으로 속여서 대상의 신뢰를 얻고 쓰레기를 판매하는 것이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = b9c4c622-aede-c6a2-2823-9c665d5f8ff3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:b9c4c622-aede-c6a2-2823-9c665d5f8ff3
msgctxt "h71d754b1g3744g403bg8579g05cd686df0c3"
msgid "<i>Leave. </i>"
msgstr "<i>떠난다. </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = b9fbb047-a4b6-e67f-dde2-44c7ce6d33c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:b9fbb047-a4b6-e67f-dde2-44c7ce6d33c0
msgctxt "h55bc2fbfgd4b6g4ac0gabf9g079596a44983"
msgid "Oh <i>damn</i>."
msgstr "이런 <i>망할</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = ba294b3b-10f9-6a72-971a-35d7e4a3a1e0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Pickpocket1_PCIsNotAChump(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:ba294b3b-10f9-6a72-971a-35d7e4a3a1e0
msgctxt "heacbcf90g67a9g45cbgbd7egc6444d329db7"
msgid "But okay, fine. Get out of here. Make room for the chumps."
msgstr "네, 하지만 괜찮아요. 여기서 나가주세요. 멍청이들을 위한 공간은 남겨달라고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = bb1d5ff7-8014-98d0-9cc1-4d95a161b853
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_Thieflings_Event_TransferPickpocketRing(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:bb1d5ff7-8014-98d0-9cc1-4d95a161b853
msgctxt "h97ef039egdd41g43d0g9cf1g79b42c34eefb"
msgid "Just take your ring and count yourself lucky."
msgstr "네 반지는 가져가고 네가 행운아인 줄이나 알아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = bbd095bc-c9ce-b2c0-448e-dd754ff95b1d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_TriedRingScamOn(1) = True
#. TagRule: ROGUE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:bbd095bc-c9ce-b2c0-448e-dd754ff95b1d
msgctxt "hd4d82c3bg96f8g41e5g91e8g146fdd16482b"
msgid "Nice sleight-of-hand. Hammar's Flourish, right?"
msgstr "손재주가 좋군. 함마의 손동작이야, 맞지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = bbd095bc-c9ce-b2c0-448e-dd754ff95b1d
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_TriedRingScamOn(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:bbd095bc-c9ce-b2c0-448e-dd754ff95b1d
msgctxt "h14d6f408gdc49g4088g9b86g1f6ee6d82c11"
msgid "That was a fancy trick."
msgstr "교묘한 속임수로군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = bcb5a148-7525-efc9-736f-3c150bd0b6ea
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Event_MerchantKidLeaves = True
#.   Object:
#.     - DEN_Thieflings_Event_CheckKnowsHideout(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:bcb5a148-7525-efc9-736f-3c150bd0b6ea
msgctxt "h66c3c1aagbaadg4840g8f61g36cc77c95f7e"
msgid ""
"Look, just talk to Mol. She's through that crack in the wall. She'll tell "
"you what's what."
msgstr "몰에게 얘기해 보세요. 저 벽의 틈을 따라 가면 있어요. 걔가 당신에게 뭐가 뭔지 설명해줄 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = bd5c3aed-9f31-2aa5-1ca3-1f652e0b6b64
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:bd5c3aed-9f31-2aa5-1ca3-1f652e0b6b64
msgctxt "h6f64bdeeg513fg41cbg9819g8e584d2138e0"
msgid "You could at least pretend to be sorry."
msgstr "이제야 미안한 척이라도 하는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Narrator
#. NodeID = bd8d7c67-6bd3-f69c-9034-7e7d7c976296
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Knows_PlayerRobbed = False
#.      - DEN_Thieflings_Event_PlayerRobbed_Twice = False
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Knows_PlayerRobbed = True
#.   Quest:
#.     - DEN_Thieflings.DiscoveredRobbed(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:bd8d7c67-6bd3-f69c-9034-7e7d7c976296
msgctxt "h756111fbg8656g4083g9d86g38225cd4e40d"
msgid "*You were just <i>robbed.*</i>"
msgstr "*당신은 방금 <i>소매치기 당했습니다.*</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = bef24976-bcbb-47d7-4b2c-0f7446a8f69f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:bef24976-bcbb-47d7-4b2c-0f7446a8f69f
msgctxt "h166dbff4g6e21g4772g8ca2gd4c017270a63"
msgid ""
"You know what? We're square. I'll tell the others to leave you alone too."
msgstr "그거 알아요? 당신에겐 볼 일 없어요. 다른 사람들에게도 당신을 내버려두라고 말할 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = c38bc7b3-6288-c632-74e3-eb0d02e28279
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:c38bc7b3-6288-c632-74e3-eb0d02e28279
msgctxt "h3dcc8816g1eb0g461cg9d3ag13608979bfa8"
msgid ""
"Now, you wanna take a look at the other stuff I got? Or maybe you just wanna "
"<i>go</i>."
msgstr "이제 제가 가진 다른 물건들 보실래요? 아니면 그냥 <i>가셔도</i> 돼요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = c531d38c-eba5-e002-1bb3-0d47face463b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_Thieflings_Event_TransferPickpocketRing(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:c531d38c-eba5-e002-1bb3-0d47face463b
msgctxt "h455aa23dg10d6g422bga97ag9e8d02448e8c"
msgid "<i>Return the ring and leave. </i>"
msgstr "<i>반지를 돌려주고 떠난다. </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = c77455ef-cb17-4dcb-8d8f-cb72bad19422
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:c77455ef-cb17-4dcb-8d8f-cb72bad19422
msgctxt "h11d53909g2f80g47cegbc25ga5e6ac1b3ced"
msgid "This sounds like a scam."
msgstr "사기처럼 들리는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = c7c5402c-0b5f-81a3-2c7c-0906e3c2eace
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GALE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:c7c5402c-0b5f-81a3-2c7c-0906e3c2eace
msgctxt "h5cae704fg17fdg46bdgbdf5gb24814d63aa7"
msgid ""
"It would be a grave mistake, were you to lie to the great Gale of "
"Waterdeep..."
msgstr "워터딥의 위대한 게일에게 거짓말을 하는 것은 중대한 실수가 될 거야..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = ca118baf-d160-a2df-d061-db4e52f5b3d4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_Thieflings_Event_TransferPickpocketRing(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:ca118baf-d160-a2df-d061-db4e52f5b3d4
msgctxt "he71d7858ge95cg4a07g83afg0b0b18c9f1cd"
msgid "All right, take your ring. What do you have to trade?"
msgstr "좋아, 네 반지 가져가. 넌 뭘 거래하고자 하지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = cbe06f80-f0f5-08ac-b76a-9f1a069bf443
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:cbe06f80-f0f5-08ac-b76a-9f1a069bf443
msgctxt "he5ce9f01g6ba2g4aedg8dd6g7020cf0c9e94"
msgid "...Um, hey, would you like to see something fun?"
msgstr "...음, 그러니까, 뭔가 재밌는 걸 보지 않으실래요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Narrator
#. NodeID = cc4726f7-f470-cbdb-5a6d-bf72843812c1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Event_PlayerRobbed_Noticed = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:cc4726f7-f470-cbdb-5a6d-bf72843812c1
msgctxt "h47de07bag5f45g418eg96ffg9351cb3a5d52"
msgid "*You realise your bag feels light.*"
msgstr "*당신은 가방이 가벼움을 느낍니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = cc72b209-b358-b678-3ad3-0bf0280ad4ed
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Event_MerchantKidLeaves = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:cc72b209-b358-b678-3ad3-0bf0280ad4ed
msgctxt "h142fdfdag6940g44d5gba63ga6a17e6274b3"
msgid "Thank the gods."
msgstr "신께 감사드립니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Narrator
#. NodeID = cd33d50f-6f8d-8e6c-fa25-14701509f561
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_SuccessfulPickpocket = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:cd33d50f-6f8d-8e6c-fa25-14701509f561
msgctxt "hd25343b7g1c45g4bf4gaebbga4602bbb5926"
msgid "*You spot the boy giving a sly wink as he turns away.*"
msgstr "*당신은 그 소년이 돌아서면서 교활한 윙크를 보내는 것을 발견합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = cdd1b567-3f8b-747b-d2bc-dc017ccc62b4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Pickpocket1_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Pickpocket1_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:cdd1b567-3f8b-747b-d2bc-dc017ccc62b4
msgctxt "hc2fea1c4gf7deg483cg9c3ag365374e63e75"
msgid ""
"Hey there. You wanna buy one of my lucky rings? Bargain magic at good prices."
msgstr "저기요. 제 행운의 반지 중 하나 사가실래요? 가격도 싼 마법의 물건이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = cf03e7be-6fd3-9120-ca0d-112440c13947
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Pickpocket1_HasMet(1) = False
#.   Global:
#.      - DEN_Hideout_State_ResolvedThieflings = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Pickpocket1_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:cf03e7be-6fd3-9120-ca0d-112440c13947
msgctxt "h4239ca16gd07fg4cdag86d0g512ef009b739"
msgid ""
"Hey there. You wanna buy one of my lucky rings? Bargain magic at good prices."
msgstr "저기요. 제 행운의 반지 중 하나 사가실래요? 가격도 싼 마법의 물건이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = cfc5b2a4-4e35-71ab-0e2f-36c23e1c7a25
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:cfc5b2a4-4e35-71ab-0e2f-36c23e1c7a25
msgctxt "hbcbee671gc811g4fe7gae05g001e35673e93"
msgid "Yeah, I know. I was standing right here, telling her to rob you."
msgstr "그래요, 나도 알아요. 바로 여기 서서 걔한테 훔치라고 한 게 저라고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = d07657fb-4f3d-ce3a-b1d7-70de86e0866f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Event_MerchantKidLeaves = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:d07657fb-4f3d-ce3a-b1d7-70de86e0866f
msgctxt "h0fd695a7g8b2cg4c5agbbb6gab7e654ab69c"
msgid "See you there, maybe."
msgstr "거기서 볼 수 있을 거예요, 아마도."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = d07ca960-3ee9-5adb-e9f5-a0c5ce0c4fa8
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARD(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:d07ca960-3ee9-5adb-e9f5-a0c5ce0c4fa8
msgctxt "h6fe3d153gd360g41c2gb639g3b11d4c26d5c"
msgid "<i>Spin the ring in an elaborate parlour trick.</i>"
msgstr "<i>반지에 정교한 속임수를 써서 돌린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Narrator
#. NodeID = d0ed133c-db21-0f91-656c-3ef3e3e72441
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Knows_PlayerRobbed = True
#. SetFlags:
#.   Quest:
#.     - DEN_Thieflings.DiscoveredRobbed(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:d0ed133c-db21-0f91-656c-3ef3e3e72441
msgctxt "h7fb68e7dgb4acg4972gb308g447687c759e4"
msgid "*You've just been robbed. Again.*"
msgstr "*당신은 방금 소매치기 당했습니다. 또 다시.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = d12c0141-415c-e895-97b0-a623045abb58
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:d12c0141-415c-e895-97b0-a623045abb58
msgctxt "hb552b864ge292g4a77gafd6gb88920807f89"
msgid "Again? Really?"
msgstr "또? 이러실 건가요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = d182a055-c2f0-595c-d0b7-741b4afc3c37
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_TriedRingScamOn(1) = True
#.   Object:
#.     - DEN_Thieflings_Event_TransferPickpocketRing(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:d182a055-c2f0-595c-d0b7-741b4afc3c37
msgctxt "h3440f2f5gc28ag469ag8700gee3dd8a66e16"
msgid "<i>Take the ring. </i>"
msgstr "<i>반지를 가져간다. </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = d32c6db2-8667-dd7e-bea9-d000cb8f2d16
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:d32c6db2-8667-dd7e-bea9-d000cb8f2d16
msgctxt "h54ab27c6g6241g4b57ga322gcbc54280afde"
msgid ""
"If you change your mind, she's through that crack in the wall over there. "
"And lady?"
msgstr "마음이 바뀌면, 그녀가 저 벽 너머 틈새안에 있으니 만나봐요. 그리고 아가씨?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = d32c6db2-8667-dd7e-bea9-d000cb8f2d16
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:d32c6db2-8667-dd7e-bea9-d000cb8f2d16
msgctxt "hbdb72fe7g16aag4679g8a26g19f439fd3206"
msgid ""
"If you change your mind, she's through that crack in the wall over there. "
"And mister?"
msgstr "마음이 바뀌면, 그녀가 저 벽 너머 틈새안에 있으니 만나봐요. 그리고 아저씨?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = d32c6db2-8667-dd7e-bea9-d000cb8f2d16
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:d32c6db2-8667-dd7e-bea9-d000cb8f2d16
msgctxt "h365658afg8adbg421dg9edegae0c87ec0b47"
msgid ""
"If you change your mind, she's through that crack in the wall over there. "
"And one more thing?"
msgstr "마음이 바뀌면, 그녀가 저 벽 너머 틈새안에 있으니 만나봐요. 그리고 하나 더?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = d3a8e015-5a36-530a-a0ca-8238e721460a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_HALFORC(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:d3a8e015-5a36-530a-a0ca-8238e721460a
msgctxt "h8df0a119g7d18g4c7egbd0age4cc7792cb6a"
msgid "Do I look like someone you want to steal from?"
msgstr "내가 누굴 훔칠 사람처럼 보이냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = d69bb530-cf22-dda8-056a-089ab511d8bc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Knows_HandSignal = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:d69bb530-cf22-dda8-056a-089ab511d8bc
msgctxt "h3f337f0fg3c92g497eg87e5g71bf576c2eb1"
msgid "Drop the act. I know about your little scam."
msgstr "연기는 그만둬. 너의 하찮은 사기 수법을 알고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Narrator
#. NodeID = d6c7131f-8682-3e77-e3be-e05df03db2c7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Knows_PlayerRobbed = False
#.      - DEN_Thieflings_Event_PlayerRobbed_Twice = True
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Knows_PlayerRobbed = True
#.   Quest:
#.     - DEN_Thieflings.DiscoveredRobbed(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:d6c7131f-8682-3e77-e3be-e05df03db2c7
msgctxt "h7970f8f6gf624g407agb153g06c6381724d8"
msgid ""
"*You were robbed. And by the feel of your pack, not for the first time.*"
msgstr "*당신은 소매치기 당했습니다. 당신의 가방 무게로 느끼건대, 이번이 처음이 아닙니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = d77ebd60-f3fb-4a1b-cb38-362128db636e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_Thieflings_Event_TransferPickpocketRing(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:d77ebd60-f3fb-4a1b-cb38-362128db636e
msgctxt "h568fabbbgfb69g4f1bgb9ebge683f4bd787e"
msgid "Take your ring. I don't have time for this."
msgstr "네 반지 가져가. 나는 이러고 있을 시간 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = d81fe1ee-364e-ea3d-64f3-0c52c39c3132
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:d81fe1ee-364e-ea3d-64f3-0c52c39c3132
msgctxt "h8d224762g515eg435fga07agb62efac57905"
msgid "Yeah, well, you can't eat honour."
msgstr "네, 명예가 밥 먹여 주진 않잖아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = d8c5e074-27df-79fb-41fb-9fe7242339ab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:d8c5e074-27df-79fb-41fb-9fe7242339ab
msgctxt "hbd85d61bgc396g4adcg8756g26aa1a3cb08f"
msgid "There. Happy?"
msgstr "봐요. 만족하셨죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = d95142b2-5517-e735-7583-5411a520f59c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:d95142b2-5517-e735-7583-5411a520f59c
msgctxt "ha7ffcb7fgfcc5g4058g828egf2203e8328b2"
msgid "Here, want to see a trick?"
msgstr "이것 봐요, 마술 하나 보여드릴까요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = d96c66af-7a13-e8bb-9f71-945a36518200
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:d96c66af-7a13-e8bb-9f71-945a36518200
msgctxt "h285743fcg218fg43f3g9217g75fcb2220aba"
msgid "Heads."
msgstr "앞면."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = da32f652-9863-d294-c293-0743410f534b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:da32f652-9863-d294-c293-0743410f534b
msgctxt "h5ee49ca2g241ag4df4ga364g08ba7685fa65"
msgid "Huh. Never heard of those. Guess I have now!"
msgstr "흠. 그런 건 들어본 적이 없는데. 이제 알거 같아요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Narrator
#. NodeID = da896f89-4f42-09b4-8a24-0b1790091d86
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:da896f89-4f42-09b4-8a24-0b1790091d86
msgctxt "he4907b62gef32g4949ga822g5c01ef2f9b64"
msgid ""
"*As you turn to leave, you realise the other child does too. She looked "
"nervous.*"
msgstr "*당신이 떠나려고 돌아섰을 때, 다른 아이도 그런다는 것을 깨닫습니다. 그녀는 불안해 보입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = daffc054-b976-86c6-831c-98fd52b3d421
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:daffc054-b976-86c6-831c-98fd52b3d421
msgctxt "hd184d681g64d8g4bbeg8f88g8abd57d05755"
msgid "Just talk to Mol, okay? She's the one you need."
msgstr "몰에게 말해요, 알았죠? 그녀가 당신이 필요로 하는 사람이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = deeea165-e0d2-8699-3f2d-deaa4e51f70e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Hideout_Event_TurnedKidsHostile = True
#.      - DEN_Hideout_State_ResolvedThieflings = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:deeea165-e0d2-8699-3f2d-deaa4e51f70e
msgctxt "h8e7211b4g76acg42c7ga537g03cbb1aeede7"
msgid "We've met. She tried to kill me."
msgstr "우리 만났었어. 걔가 날 죽이려고 했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = df1af0db-5eb0-2054-3f64-438926064f9b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:df1af0db-5eb0-2054-3f64-438926064f9b
msgctxt "ha3f2770fg7468g4368gaf8eg3b61ac35c21e"
msgid "What makes you think I'm an elf?"
msgstr "뭐 때문에 날 엘프라고 생각하는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = dfdf7523-eb2e-9980-31f7-4885d91ec868
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ROGUE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:dfdf7523-eb2e-9980-31f7-4885d91ec868
msgctxt "hb8875630g78a8g4b35gb606g6330e3390e29"
msgid "Uh. I never learned names or anything. Just the tricks."
msgstr "어. 이름이나 다른 건 배운 적 없는데요. 그냥 속임수예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = e219e2e6-fb39-063d-6499-c6c69148a966
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:e219e2e6-fb39-063d-6499-c6c69148a966
msgctxt "h8494cd42g7b71g4b51g99cdgac81e0a883f0"
msgid "Heads or tails? Call it."
msgstr "앞면 혹은 뒷면? 맞춰주세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = e253d045-db55-ebe9-4a1f-29e94d53efd4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_TriedRingScamOn(1) = True
#. TagRule: DROWELF or LOLTHDROWELF or SELDARINEDROWELF
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:e253d045-db55-ebe9-4a1f-29e94d53efd4
msgctxt "h1a47b429g656dg4330gb477gf0bf67a68d93"
msgid ""
"I heard stories about you. How you all live underground and steal kids away."
msgstr "당신에 관한 이야기들을 들었어요. 죄다 언더다크에 살고 아이들을 납치한다는 이야기요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = e341cb48-baf2-cbb7-ca0a-d3f1037b405f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Pickpocket1_PCIsNotAChump(1) = True
#.   Quest:
#.     - DEN_Thieflings.DoneOutsmartedKids(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:e341cb48-baf2-cbb7-ca0a-d3f1037b405f
msgctxt "hf234b112gc87fg4e20ga2e2g4fa4fd1b2d7e"
msgid ""
"No fooling you, is there? All right, get walking. Leave some room for the "
"chumps, huh?"
msgstr "당신을 속일 사람은 없겠군요, 그렇죠? 알겠어요, 가던 길 가주세요. 멍청이들을 위한 공간은 남겨달라고요, 네?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = e3b1337c-df5c-f251-ff19-b24a2c794ed5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:e3b1337c-df5c-f251-ff19-b24a2c794ed5
msgctxt "he5b76ca2g96f1g49e8gb687g046a1f097557"
msgid "I mean- I don't think so?"
msgstr "내 말은, 아닌 것 같은데요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = e42b9bed-d7bf-eba8-633d-6ecb65c81b37
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:e42b9bed-d7bf-eba8-633d-6ecb65c81b37
msgctxt "h77f6032fg1df5g4dc8g9d44g4a5c6ab7c85c"
msgid "Don't worry about it. Now, you wanna buy something this time?"
msgstr "걱정 마세요. 자, 이번에 뭔가 사실래요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = e555e87e-28f4-1b00-0416-188287496b46
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:e555e87e-28f4-1b00-0416-188287496b46
msgctxt "hfe48acb2g6d09g452eg87eagaa406c125e34"
msgid "Want all you want. She's somewhere safe and staying that way."
msgstr "받고 싶은 거야 그쪽 마음이죠. 근데 걘 어디 안전한 곳으로 떠났고 쭉 거기 있을 예정이거든요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = e675c6fe-8285-42e0-9bca-4db81abb5a77
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:e675c6fe-8285-42e0-9bca-4db81abb5a77
msgctxt "hc4247ff6gd85dg44d5gbb61gfd0d4cc19a9e"
msgid ""
"Well, grudges don't buy bread, and I gotta eat. Speaking of which, wanna "
"trade?"
msgstr "네, 원한으로는 빵을 살 수 없는 데다, 저도 먹고 살아야죠. 말이 나온 김에 거래하실래요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = ea40545f-a281-5adc-ef38-c627b834f0ff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:ea40545f-a281-5adc-ef38-c627b834f0ff
msgctxt "h59948620g9d94g42dega7f4g5b6ac1976c89"
msgid "Oh yeah? Are they bored to death?"
msgstr "오 그래요? 걔들은 지루해서 죽었대요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = ec47ff76-455f-4ea6-fdf9-f5cadddb3472
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_HideoutCallForHelp = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Pickpocket1_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:ec47ff76-455f-4ea6-fdf9-f5cadddb3472
msgctxt "h843e45f0gbb98g4e05gbf71g86717a211b00"
msgid ""
"Not sure what you did to piss off Mol. Don't want to know. Keep walking, "
"scab."
msgstr "몰을 왜 화나게 한 건지 모르겠고, 알고 싶지도 않아. 계속 가, 딱지야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = ecabf6b5-dbf7-145c-7a68-5d24e5d4e5c1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_Thieflings_Event_TransferPickpocketRing(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:ecabf6b5-dbf7-145c-7a68-5d24e5d4e5c1
msgctxt "hf5fa946eg2a15g4e90ga53agd206f94ff655"
msgid "No thanks. Could I see your other wares?"
msgstr "괜찮아. 너의 다른 물건들을 볼 수 있을까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = ed53de3e-4c2c-dadf-cbab-9385e62609d3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Event_OutrageousClaimsMentioned(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:ed53de3e-4c2c-dadf-cbab-9385e62609d3
#, fuzzy
msgctxt "h052a9f47gb0c6g4366gb45dg9061028a2c8f"
msgid "Your stock is still disappointing."
msgstr "네 물건은 여전히 형편없구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = ed9be4d9-4371-d4de-f22d-3b3abc2ecab1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:ed9be4d9-4371-d4de-f22d-3b3abc2ecab1
msgctxt "h622bf2f3ge4e8g41ccg9723g7e137734e1c8"
msgid "I've got more where that came from. Real cheap, too. Interested?"
msgstr "저는 이 반지와 같은 것들을 더 많이 갖고 있어요. 값도 정말 저렴해요. 관심 있으세요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Narrator
#. NodeID = eddcae35-df70-09be-19c1-bc78d2a6930b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Knows_PlayerRobbed = True
#. SetFlags:
#.   Quest:
#.     - DEN_Thieflings.DiscoveredRobbed(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:eddcae35-df70-09be-19c1-bc78d2a6930b
msgctxt "hbe34e650g95e6g48f6gb3a0g2899db823b0f"
msgid "*You've just been robbed. Again.*"
msgstr "*당신은 방금 소매치기 당했습니다. 또 다시.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = ee40b704-d3b1-2876-0bd6-1e18e65dbd54
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:ee40b704-d3b1-2876-0bd6-1e18e65dbd54
msgctxt "hc049d77eg3970g4e16gb801gaf3e92787cdf"
msgid "Sorry to hear that. Keep checking back!"
msgstr "유감이네요. 계속 확인해 주세요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = ee909119-a074-2951-4e39-784b757c0577
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:ee909119-a074-2951-4e39-784b757c0577
msgctxt "h3fc99653g5119g40e4gb200g946dbf33eaa1"
msgid "Go on. Mol's waiting."
msgstr "어서요. 몰이 기다리고 있어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = ef0e4d6c-e5cd-f58c-f6ca-82b46c52ec6f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:ef0e4d6c-e5cd-f58c-f6ca-82b46c52ec6f
msgctxt "hebd20750g3b5eg4fc4g898dgc32a8a8b17e8"
msgid "Hey! You're not taking any slaves here."
msgstr "이봐요! 여기서 노예를 데려가면 안 돼요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = f080e90e-03ef-c9b8-045a-4075cbc94518
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:f080e90e-03ef-c9b8-045a-4075cbc94518
msgctxt "h38a6c63eg8608g4537ga6ffg6824aa904383"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = f1012d96-54a0-351c-392c-64de9fd9df6c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Hideout_Event_TurnedKidsHostile = False
#.      - DEN_Hideout_State_ResolvedThieflings = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:f1012d96-54a0-351c-392c-64de9fd9df6c
msgctxt "hdf566f13g32c9g4adcg8a50g81e2bf2fb714"
msgid "We've met. She told me to leave."
msgstr "우리 만났었어. 걔가 떠나라고 하더군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = f12d66a7-4dd6-f56c-b07c-7fd8fdc24cc0
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: SORCERER or WARLOCK or WIZARD
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:f12d66a7-4dd6-f56c-b07c-7fd8fdc24cc0
msgctxt "h33504c28g4a90g4939gb875g6b9f666b0d3b"
msgid "That's not how magic rings work."
msgstr "마법의 반지는 그런 식으로 작동하지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = f1490c11-bfa5-6bd9-6bae-2769b32421ea
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:f1490c11-bfa5-6bd9-6bae-2769b32421ea
msgctxt "hae2a4500gd0b6g45a2ga0d9g1494a49aaac1"
msgid "Watch it. Where I'm from thieves are punished - harshly."
msgstr "조심해. 내가 온 곳에선 도둑들은 처벌을 받아 - 가혹하게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = f16cee3d-505f-0c8d-741f-7784c3aef81b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:f16cee3d-505f-0c8d-741f-7784c3aef81b
msgctxt "haf9eee61g0a43g4502gb11egee5e619dfe93"
msgid "I didn't! I swear!"
msgstr "안 그랬어요! 맹세해요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = f17a5dac-ecb7-8327-7e87-4219b39209e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:f17a5dac-ecb7-8327-7e87-4219b39209e7
msgctxt "hf9cfc491gafe8g4c4ega1c2g31702f3068a3"
msgid "Oh, you have. You definitely have."
msgstr "오, 그랬죠. 물론이죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = f33f9af4-0fab-0292-da5e-48028ea5f935
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Thieflings_Event_PlayerPurchased(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:f33f9af4-0fab-0292-da5e-48028ea5f935
msgctxt "ha542e901g6558g4decga087g6600069fc214"
msgid ""
"You bought something. Most everybody says it looks like junk and moves on."
msgstr "뭘 사셨네요? 다들 쓰레기처럼 보인다고 하면서 그냥 지나가는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = f35e0be7-083f-8c22-2d8a-21494446a858
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:f35e0be7-083f-8c22-2d8a-21494446a858
msgctxt "h5d564c31g24c4g41fdgac62ga6573a04b160"
msgid "Why should I trust a mere hatchling?"
msgstr "내가 왜 갓난애를 믿어야 하지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = f6d87f25-bee2-a9d6-a49e-bc02de1a4c1a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:f6d87f25-bee2-a9d6-a49e-bc02de1a4c1a
msgctxt "h06a455f5g5f5cg4b14ga187ga15376e07a3f"
msgid "Now please. <i>Please</i>. Buy something or go."
msgstr "이제 <i>제발</i>. 제발 부탁인데 뭘 살 게 아니면 가주세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = f712787a-8112-ae9d-44fc-b9f72ce16f17
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:f712787a-8112-ae9d-44fc-b9f72ce16f17
msgctxt "he1d80790g4137g4b9egac22g06e33eb7b603"
msgid "I get it, you're not a chump, but we're just trying to survive."
msgstr "알았어요. 얼간이가 아니시다. 하지만 우리도 좀 먹고 살아야죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = f7eefc9c-2731-44a2-c818-5b10d5507cd2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Pickpocket1_PCIsNotAChump(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:f7eefc9c-2731-44a2-c818-5b10d5507cd2
msgctxt "h1717da02g6181g49afg95c1ge30d484f3051"
msgid "Now, do me a favour. Make room for the chumps."
msgstr "그러니까, 부탁 좀 할게요. 얼간이들이 오도록 자리 좀 비워달라고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = f8490f4b-8d1d-beef-ea60-4ac36aca4fce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:f8490f4b-8d1d-beef-ea60-4ac36aca4fce
msgctxt "h921d9db0g33f2g46b8gb884g806cb31b8fd6"
msgid "Please. I am a <i>githyanki</i>."
msgstr "무슨 소리. 나는 <i>기스양키</i>야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = f931ef17-a519-fefe-d12b-37eea82a1d9e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:f931ef17-a519-fefe-d12b-37eea82a1d9e
msgctxt "h72b9bbd1g95c0g41aegacdcg4460cd434efc"
msgid "Dunno. I just use the one I know."
msgstr "몰라요. 전 그냥 아는 거 하나만 쓰는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = f9b7d2d3-275b-379d-4cc1-a0f2ccb130bd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_PlayerAdmittedPickpocketing = False
#.      - DEN_Thieflings_Event_MerchantKidLeaves = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Pickpocket1_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:f9b7d2d3-275b-379d-4cc1-a0f2ccb130bd
msgctxt "hdc3bda6fgc12bg4ce4g9fbcg090d5430a9ed"
msgid "Hells, you get everywhere, don't you?"
msgstr "세상에, 당신은 어디든 갈 수 있네요, 그렇죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = fa01ddd4-28f8-5b65-0671-b8085a88d3d3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:fa01ddd4-28f8-5b65-0671-b8085a88d3d3
msgctxt "hadc3e695g40ecg47b3g9813g1b4c3f792209"
msgid "Oh... oh! Haha. Good one."
msgstr "어... 아! 하하. 재미있으시네요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = face47f1-d6d7-8195-ecd6-9640a3fd8938
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:face47f1-d6d7-8195-ecd6-9640a3fd8938
msgctxt "h53f6659cg1d91g414ag91c4gfd140ec3d0bf"
msgid "Careful. Not everyone is as forgiving as I am."
msgstr "조심해라. 모든 사람이 나처럼 너그러운 것은 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = fb190bae-7749-70a5-61f8-75268d83ada8
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Dexterity
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - ROGUE(1) = True
#. SetFlags:
#.   Object:
#.     - DEN_Thieflings_Event_TransferPickpocketRing(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:fb190bae-7749-70a5-61f8-75268d83ada8
msgctxt "h047da779g063fg46f0ga8f1g50ec6ef216d0"
msgid "<i>Vanish the ring with a reverse Hammar's Flourish.</i>"
msgstr "<i>함마의 손동작을 거꾸로 하여 반지를 사라지게 한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = fbe83d36-46f9-c2bd-7b41-3cbd6eb81e5c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:fbe83d36-46f9-c2bd-7b41-3cbd6eb81e5c
msgctxt "hc162e293ge0fcg465cgacbeg59f21cc06f59"
msgid "Then I'll get my answers out of her."
msgstr "그럼 몰에게서 답을 얻을 수 있겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = fc00d928-7da3-dc74-32c6-2bdf8b4517c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:fc00d928-7da3-dc74-32c6-2bdf8b4517c1
msgctxt "h5a63ff7cg7084g4793g876bg44e3b57ff189"
msgid "If you have another choice, you go right ahead."
msgstr "다른 선택지가 있다면, 바로 진행하세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = fc9fd32f-556b-099e-8723-6ce9fc1aae67
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:fc9fd32f-556b-099e-8723-6ce9fc1aae67
msgctxt "h6bbc7b7dg2de9g40cag8b00g8adbccf8f94a"
msgid "<i>Leave. </i>"
msgstr "<i>떠난다. </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = fda884b1-cff8-2f1c-f19a-788be5e91a6b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_Thieflings_Event_VanishRing(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:fda884b1-cff8-2f1c-f19a-788be5e91a6b
msgctxt "h80148330g55fdg4642g92f0gde1337a7349a"
msgid "Weeping, bleeding <i>hells</i>."
msgstr "우와, <i>미쳤다</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = fdd48d83-92e3-a338-5e29-21300b04e665
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:fdd48d83-92e3-a338-5e29-21300b04e665
msgctxt "h1d6d4f35gbd77g4ae2g8d7eg07de41c9911a"
msgid "Okay, fair. Let's go again."
msgstr "알았어요. 다시 해봅시다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = fe023789-869d-2caf-466d-b69769e71366
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:fe023789-869d-2caf-466d-b69769e71366
msgctxt "h352087b0g51fdg4e5dgb8adgbc84ddb717c0"
msgid "Fine, keep it. Call it a sample, yeah?"
msgstr "알았어요, 가져가세요. 견본인 셈 칠게요, 됐나요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = fe522d3d-190b-7d7b-08ac-d7796ccdbeb4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:fe522d3d-190b-7d7b-08ac-d7796ccdbeb4
msgctxt "hcd8aa6d4g53c9g44afg83c1gb6cc7a5e6ecb"
msgid ""
"Bet you can find another one, though. This place has tonnes of tunnels and "
"stuff."
msgstr "하지만 다른 곳을 찾을 수 있을 거예요. 여기엔 굴 같은 게 엄청 많아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Player
#. NodeID = 0047cea5-728b-f27b-421f-41b549ae10c2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:0047cea5-728b-f27b-421f-41b549ae10c2
msgctxt "h29edea92gbf4dg434eg972bg1dcd4b140511"
msgid "The bears might be. I'm not."
msgstr "곰들은 착할지 몰라도, 난 아냐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Silfy
#. NodeID = 016decac-9bf0-8698-b707-7c6864a35303
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:016decac-9bf0-8698-b707-7c6864a35303
msgctxt "h995708a7gd023g4fc0ga0eegf02efe219c52"
msgid ""
"It's... It's just so hard! We're on our own, and Mol said she'd help us. "
"She..."
msgstr "그게... 정말 힘들단 말이에요! 여기선 아무도 우리를 돌봐주지 않아요, 그치만 몰이 우릴 도와주기로 했거든요. 몰이..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Player
#. NodeID = 07296038-f315-d3cb-6ca0-b567616bc460
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Knows_HandSignal = True
#.      - DEN_Hideout_State_ResolvedThieflings = True
#. SetFlags:
#.   Dialog:
#.     - DEN_ThieflingsPickpocket2_PCUsedHandSignal(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:07296038-f315-d3cb-6ca0-b567616bc460
msgctxt "h08ba24eeg4db4g4e27gb4c5ge4010f615d60"
msgid "<i>Perform Mol's hand signal.</i>"
msgstr "<i>몰의 수신호를 따라한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Silfy
#. NodeID = 081d9f50-8364-c4c2-e543-7ca828635a53
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Pickpocket2_HasMet(1) = True
#.   Global:
#.      - DEN_Thieflings_State_CaughtStealing = False
#.      - DEN_Hideout_State_ResolvedThieflings = False
#.      - DEN_Thieflings_Event_PlayerRobbed = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:081d9f50-8364-c4c2-e543-7ca828635a53
msgctxt "h5dcad059gf7e9g4945gb12dgd5e27741972e"
msgid "Um. Hello again. Um."
msgstr "음. 다시 오셨네요. 음."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Silfy
#. NodeID = 09c2c1d5-d448-3f5f-d468-b279ec658369
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:09c2c1d5-d448-3f5f-d468-b279ec658369
msgctxt "h073f45b7gf2e3g4adbg918dgc803bf787ca9"
msgid "I shouldn't have said that. I gotta go!"
msgstr "말하면 안 됐는데. 가야겠어요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Player
#. NodeID = 0ae2285f-77ae-1d04-0bf3-524edb2ed671
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Knows_HandSignal = False
#.      - DEN_Hideout_State_ResolvedThieflings = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:0ae2285f-77ae-1d04-0bf3-524edb2ed671
msgctxt "h690a1d85g84ddg4b33gae9bgbe712ef6bdf1"
msgid "Mol told me everything. Keep your hands to yourself."
msgstr "몰이 다 말해줬어. 손 조심해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Silfy
#. NodeID = 0db5a91c-b62d-6d5c-db13-8738ea7b95ea
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Pickpocket2_HasMet(1) = False
#.   Global:
#.      - DEN_Thieflings_State_CaughtStealing = False
#.      - DEN_Hideout_State_ResolvedThieflings = False
#.      - DEN_Thieflings_Event_PlayerRobbed = False
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Pickpocket2_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:0db5a91c-b62d-6d5c-db13-8738ea7b95ea
msgctxt "hf54c815ag0895g4fadg8099g92ef68b30ba0"
msgid "Oh. Um. Hi."
msgstr "어. 음. 안녕하세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Silfy
#. NodeID = 0e1ed407-bd4d-6f99-b1da-da54655631f9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Event_BrotherSlipUp(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Event_BrotherSlipUp(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:0e1ed407-bd4d-6f99-b1da-da54655631f9
msgctxt "h78fdd06cg2b37g41f6gb466g1c855c54750c"
msgid "Um. My partner, I mean."
msgstr "음. 그러니까, 제 파트너 말이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Player
#. NodeID = 110f2205-e57e-02cb-74a9-10296bb250b2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Event_PartnerQuestionAsked(1) = False
#.   Global:
#.      - DEN_Thieflings_Knows_PlayerRobbed = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:110f2205-e57e-02cb-74a9-10296bb250b2
msgctxt "he0795c03g05aeg4da4ga36bgccbfee36fc27"
msgid "I've been robbed. Have you seen anyone acting suspiciously?"
msgstr "도둑질을 당했어. 수상한 사람은 못 봤니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Silfy
#. NodeID = 15b57e38-bc53-6589-99d6-06514f214b8d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_PlayerRobbed_Twice = False
#.      - DEN_Thieflings_Event_MerchantKidLeaves = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:15b57e38-bc53-6589-99d6-06514f214b8d
msgctxt "h02b520d6gad4cg48cegb19cg360e691c9631"
msgid "I don't have money or anything to sell. My p-partner does that."
msgstr "저는 돈도 없고 팔 물건도 없어요. 그건 제 파-파트너 담당이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Silfy
#. NodeID = 1ba9ef79-6f98-8241-d82a-4889f6811ae9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:1ba9ef79-6f98-8241-d82a-4889f6811ae9
msgctxt "hb0d9e9e3g94dcg4a18g9de1g2f43d5ea9c84"
msgid "What? N-no! It wasn't her!"
msgstr "뭐라구요? 아-아니에요! 그녀가 아니었어요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Player
#. NodeID = 21ff8acb-eaee-3e4b-4468-91fd55ba1cb5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_RARE(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:21ff8acb-eaee-3e4b-4468-91fd55ba1cb5
msgctxt "h83e51220g865eg4c1eg9142g892c8958f073"
msgid "Your little friend doesn't frighten me."
msgstr "네 꼬마 친구 불러와봤자 하나도 안 무서워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Player
#. NodeID = 220e2568-0cbe-540a-d628-efc9c536b597
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - REALLY_PLANAR(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:220e2568-0cbe-540a-d628-efc9c536b597
msgctxt "h7706f05egd185g449aga679g0349dba77611"
msgid "Child - I'm a visitor here. I deserve better than this."
msgstr "얘야, 난 여기 손님이란다. 이렇게 대하면 안 되지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Player
#. NodeID = 263326e2-aec4-fc83-6adb-c40b61a81c48
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Event_BrotherQuestionAsked(1) = False
#.      - DEN_Thieflings_Event_BrotherSlipUp(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Event_BrotherQuestionAsked(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:263326e2-aec4-fc83-6adb-c40b61a81c48
msgctxt "h2b8b3746g18c6g4905g960fg778d6a7d68b4"
msgid "Is he your partner or your brother?"
msgstr "네 형제인 거야, 아니면 네 파트너인 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Player
#. NodeID = 28339b52-0078-a948-8b29-53c0c2545987
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Event_PartnerQuestionAsked(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Event_PartnerQuestionAsked(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:28339b52-0078-a948-8b29-53c0c2545987
msgctxt "h9b89adc7ge01ag4654g93e4g5e183559a4da"
msgid "You sound pretty useless."
msgstr "별로 쓸모가 없어 보이는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Player
#. NodeID = 285ced8a-5928-b3c8-e5e1-315d77b12388
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - REALLY_BESTIAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:285ced8a-5928-b3c8-e5e1-315d77b12388
msgctxt "h847ca0ecg9d3dg4477gac15g0fecaad8d68e"
msgid "Did you know that I can smell when people are lying?"
msgstr "난 사람들이 거짓말을 할 때 냄새를 맡을 수 있다는 거 알고 있니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Silfy
#. NodeID = 29e7057a-0fc9-7859-583f-8613d203ee49
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_ThiefCaughtInDialog = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:29e7057a-0fc9-7859-583f-8613d203ee49
msgctxt "h6b36a6c2g82d8g4221gaba5ge0c38918023a"
msgid "Oh. Hello again. Um."
msgstr "오. 다시 오셨네요. 음."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Player
#. NodeID = 345cdcdc-e47f-a91c-db6f-a3d6ff1bee55
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:345cdcdc-e47f-a91c-db6f-a3d6ff1bee55
msgctxt "h6ad7191bg5813g4845gac23g0358711e8529"
msgid "<i>Leave</i>."
msgstr "<i>떠난다</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Silfy
#. NodeID = 3e87c0d3-86e4-3651-740c-39f5bab05258
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:3e87c0d3-86e4-3651-740c-39f5bab05258
msgctxt "hb6444854g2846g483bgb1b0g58c2b43ebfce"
msgid ""
"Y-you don't scare me. You won't do nothing with all the grown-ups around!"
msgstr "다-당신은 하나도 안 무서워요. 주변에 어른들이 많은데 아무 짓도 하지 못하실 거예요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Silfy
#. NodeID = 48bcaf2c-a879-60cf-b418-9bd3508dc770
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:48bcaf2c-a879-60cf-b418-9bd3508dc770
msgctxt "hd8c0a3cbgf72eg4f18gbf29g011d002e9e64"
msgid "She should! Mol's tougher than anyone! She..."
msgstr "무서울걸요! 몰은 제일 쎄다고요! 몰은..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Wyll
#. NodeID = 4e5150a0-8343-f4c0-9fe3-a7acbf6fba1e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(2) = True
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_ThiefCaughtInDialog = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:4e5150a0-8343-f4c0-9fe3-a7acbf6fba1e
msgctxt "hfce5a2a0g8feeg4a61ga3fegc5f104b4b253"
msgid "Wow - you really showed that small defenceless child who's in charge."
msgstr "참 대단도 하네. 힘없는 꼬마한테 기싸움으로 이기고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Silfy
#. NodeID = 510c749d-91c1-0ef2-af59-0e345f78a51c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_PlayerRobbed_Twice = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:510c749d-91c1-0ef2-af59-0e345f78a51c
msgctxt "h58a05bfbg2f50g4f33g8eeeg11f6692445c5"
msgid "Oh. Hello again. Um."
msgstr "오. 다시 오셨네요. 음."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Player
#. NodeID = 5455f153-b72b-2507-5f4d-715459489373
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Event_BrotherSlipUp(1) = False
#.      - DEN_Thieflings_Event_PartnerQuestionAsked(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Event_PartnerQuestionAsked(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:5455f153-b72b-2507-5f4d-715459489373
msgctxt "h76dcb10cgd1d3g4feag92afgcdd9c49d74e3"
msgid "So what's your side of the business?"
msgstr "그럼 너는 무슨 일을 하니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Silfy
#. NodeID = 547f1e66-ed33-5500-d534-dbf008232a58
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_ThiefCaughtInDialog = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:547f1e66-ed33-5500-d534-dbf008232a58
msgctxt "hc37eefc2g523cg4f9cgb0ecg377c1ff6d369"
msgid "But, um, I'll go ask my boss for you. Right now. "
msgstr "그렇지만, 어, 대장한테 가서 물어볼게요. 지금 바로요. "

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Silfy
#. NodeID = 5566416d-4e27-470d-e9e0-7361063221e3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:5566416d-4e27-470d-e9e0-7361063221e3
msgctxt "h8e96ba65gdd12g49adga405g312713059bed"
msgid "Mol! Help!"
msgstr "몰! 도와줘!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Narrator
#. NodeID = 58458b46-0f20-ab04-ac37-76623d8eb847
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_ThiefCaughtInDialog = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:58458b46-0f20-ab04-ac37-76623d8eb847
msgctxt "h4d2046e6g408cg4671ga136g402c90e85306"
msgid "*Before you can say anything else, she sprints away.*"
msgstr "*당신이 어떤 말도 덧붙이기 전에, 그녀가 줄행랑을 쳐버립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Silfy
#. NodeID = 59c00924-2529-fbd4-9c1c-77fe1bc4b6e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:59c00924-2529-fbd4-9c1c-77fe1bc4b6e6
msgctxt "h4e1720cagcfe6g486bg8c1bg08ece1bbebfd"
msgid "Right. So... look out! I'm watching you!"
msgstr "맞아요. 그러니, 조심하세요! 지켜보고 있으니까요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Silfy
#. NodeID = 59ea5c26-df95-a265-f75b-bc92e7216b25
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:59ea5c26-df95-a265-f75b-bc92e7216b25
msgctxt "hc72f5fefg0633g4663gbb71g2bb3cc6de3ce"
msgid "He sells the stuff and I... don't sell the stuff."
msgstr "오빠는 물건을 팔고 저는... 물건을 안 팔고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Silfy
#. NodeID = 5f1509bc-db23-283c-c24c-5915beb7dc1d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:5f1509bc-db23-283c-c24c-5915beb7dc1d
msgctxt "h3a41999ege36ag4c65gbf7aga1794ac5a41e"
msgid "It's a family business."
msgstr "이거 가업이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Player
#. NodeID = 61082058-a3ef-d1f4-92a9-e000e1422cca
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Pickpocket_002_ThreatenedKid(1) = True
#. TagRule: BERSERKER
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:61082058-a3ef-d1f4-92a9-e000e1422cca
msgctxt "hbb28c9b1g31d8g4032g84c5g5b9ebd1d6bb6"
msgid "<b>SPIT IT OUT.</b>"
msgstr "<b>당장 말해.</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Player
#. NodeID = 61082058-a3ef-d1f4-92a9-e000e1422cca
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Pickpocket_002_ThreatenedKid(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:61082058-a3ef-d1f4-92a9-e000e1422cca
msgctxt "hf0b75f80g5e81g474dgb2a3ga89eb8ad25c5"
msgid "The truth. <b>Now.</b>"
msgstr "진실을 말해. <b>당장.</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Silfy
#. NodeID = 6b74ef84-2773-d974-8f0c-755bda4cf9d6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Pickpocket1_HasMet(1) = False
#.   Global:
#.      - DEN_Hideout_Event_BefriendedThieflings = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Pickpocket1_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:6b74ef84-2773-d974-8f0c-755bda4cf9d6
msgctxt "h81f68a47g675dg4cebga7d9g82f41295e7c1"
msgid "Oh! Um. Hi?"
msgstr "오! 음. 안녕하세요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Player
#. NodeID = 7671fb37-5d3e-fd92-1aad-9d4a1c196621
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:7671fb37-5d3e-fd92-1aad-9d4a1c196621
msgctxt "h9e068719ge89cg4fc6ga897ga70b120028a1"
msgid "Is Mol the one who stole from me?"
msgstr "내 물건을 훔친 게 몰이야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Player
#. NodeID = 77af496f-978c-e2ca-13f9-186ca6be387a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Event_PartnerQuestionAsked(1) = True
#.   Global:
#.      - DEN_Thieflings_Knows_PlayerRobbed = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:77af496f-978c-e2ca-13f9-186ca6be387a
msgctxt "h8fcf7f0fgfe49g4427g9f8fgc6577ffc2575"
msgid "I've been robbed. You're the guard - see anything suspicious?"
msgstr "강도를 당했어. 너는 경비원이니까 - 수상한 걸 못 봤니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Silfy
#. NodeID = 78b34d0b-0f32-c4fa-b37a-a87d1bb0f50e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Pickpocket1_HasMet(1) = True
#.   Global:
#.      - DEN_Thieflings_Event_PlayerRobbed_Twice = False
#.      - DEN_Hideout_State_ResolvedThieflings = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:78b34d0b-0f32-c4fa-b37a-a87d1bb0f50e
msgctxt "h66902866gdedfg431cgbf53g3f29f1bb4035"
msgid "Oh. Um. You're back."
msgstr "오. 음. 다시 오셨네요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Player
#. NodeID = 80c0fa9b-2206-5c6f-2a8d-45de24fe3a8c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Event_PartnerQuestionAsked(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:80c0fa9b-2206-5c6f-2a8d-45de24fe3a8c
msgctxt "hc2bf3e73g8975g4ab9gb166gd95a1aea7aca"
msgid "You're just here to stand guard, then?"
msgstr "그냥 여기서 계속 경비만 서는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Player
#. NodeID = 83956928-5883-c82a-6491-68ea28038733
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:83956928-5883-c82a-6491-68ea28038733
msgctxt "he846344cg944bg4a00g8e27g2712d444697d"
msgid "Do you know of any thieves around here?"
msgstr "근처의 도둑들에 대해 뭔가 알고있는 게 있니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Silfy
#. NodeID = 849be1a8-7ef2-a387-7d12-c66919921fd1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Pickpocket2_HasMet(1) = True
#.   Global:
#.      - DEN_Thieflings_State_CaughtStealing = False
#.      - DEN_Hideout_State_ResolvedThieflings = False
#.      - DEN_Thieflings_Event_PlayerRobbed = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:849be1a8-7ef2-a387-7d12-c66919921fd1
msgctxt "h915053dfg3e75g42f2ga9fbgc0b782fe44ee"
msgid "Um, hi. Are you here to see my brother?"
msgstr "음, 안녕하세요. 제 형을 보러 오셨나요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Silfy
#. NodeID = 85c4d1a9-d05a-896a-f5ec-5299fb16a125
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_State_CaughtStealing = True
#.   Object:
#.      - DEN_Thieflings_Event_ShookThief(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:85c4d1a9-d05a-896a-f5ec-5299fb16a125
msgctxt "h8a6cd05eg08a8g40dfg9e3egcc2e263f87d3"
msgid "Oh. Hello again. Um."
msgstr "오. 다시 오셨네요. 음."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Player
#. NodeID = 86a42aea-6a79-813d-4df3-4887ac84857c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BERSERKER(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Pickpocket_002_ThreatenedKid(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:86a42aea-6a79-813d-4df3-4887ac84857c
msgctxt "h4fd01136geab0g4a0cgbe3bg54ddc939e5bd"
msgid "I can crush you with <b>one hand</b>."
msgstr "난 널 <b>한 손</b>으로도 짓이길 수 있단다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Player
#. NodeID = 86a42aea-6a79-813d-4df3-4887ac84857c
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BERSERKER(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Pickpocket_002_ThreatenedKid(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:86a42aea-6a79-813d-4df3-4887ac84857c
msgctxt "haf888776g5b14g4661gba8dga050d9fa58dd"
msgid "Do it."
msgstr "해보든가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Player
#. NodeID = 892e10c1-e7ac-1be1-558e-79fefd4cc9c4
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_BESTIAL or REALLY_RARE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:892e10c1-e7ac-1be1-558e-79fefd4cc9c4
#, fuzzy
msgctxt "h12a37395gc6fdg4f3egb86dgc197c966c275"
msgid "Look at me. Do you really think it's the bears you have to worry about?"
msgstr "날 봐. 너희들이 지금 걱정해야 할 게 곰일거라 생각해?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Player
#. NodeID = 8ca3e80f-2083-c623-da37-6714e476e5bb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - HALFORC(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:8ca3e80f-2083-c623-da37-6714e476e5bb
msgctxt "h2ff85c63g0be7g40a3gb903gc46f981922e4"
msgid "My teeth are sharper than any bear's, little one."
msgstr "꼬마야, 내 이빨은 곰보다도 훨씬 날카롭단다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Silfy
#. NodeID = 8d8f9cf5-8fe5-56b4-890a-310640459ca3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:8d8f9cf5-8fe5-56b4-890a-310640459ca3
msgctxt "h137af0c5g179bg4a85g85a8gb7de93ab3b83"
msgid "Um. Both. Of course."
msgstr "음. 당연히. 둘 다죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Silfy
#. NodeID = 968bb019-747d-16e0-2186-91e0849632a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:968bb019-747d-16e0-2186-91e0849632a7
msgctxt "hc0248904gf763g4d2dgac19gd8cb54ee8f74"
msgid "I will. Did I say sorry? Sorry."
msgstr "그럴게요. 제가 사과했었나요? 죄송해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Player
#. NodeID = 96daea47-0b2b-4aa4-3d16-b19dea162fd1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:96daea47-0b2b-4aa4-3d16-b19dea162fd1
msgctxt "h7b73d0beg8558g4f1fgb0d5g9bdc842c559b"
msgid "Are you sure about that?"
msgstr "정말 확실해?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Narrator
#. NodeID = 9821e193-db19-60f7-0272-e6979735c523
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Pickpocket_002_ThreatenedKid(1) = False
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_ThiefCaughtInDialog = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:9821e193-db19-60f7-0272-e6979735c523
msgctxt "hb03127f7gc630g4cbcg8b6fgc09f5a3a3b43"
msgid "*Before you can say anything else, she sprints away.*"
msgstr "*당신이 어떤 말도 덧붙이기 전에, 그녀가 줄행랑을 쳐버립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Silfy
#. NodeID = a60d88ff-1480-9b86-b0d1-e099a5485c19
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:a60d88ff-1480-9b86-b0d1-e099a5485c19
msgctxt "h906b2a46g8384g4fcfg94adgb575ce019a27"
msgid "Me? Suspicious? No?"
msgstr "저요? 수상하다니요? 아닐 걸요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Silfy
#. NodeID = a771286f-066a-f447-a98e-d960ff1530bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:a771286f-066a-f447-a98e-d960ff1530bf
msgctxt "h8b586edbg9114g419egab07g233efe0378d6"
msgid ""
"Anyway, I won't say anything else. You can't make me. Even if you murder me!"
msgstr "어쨌든, 더 말 안 할 거예요! 절대요. 절 죽여도 말 못 해요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Silfy
#. NodeID = a7db10a3-22d7-d131-35c1-c0eb027ad172
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_HideoutCallForHelp = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:a7db10a3-22d7-d131-35c1-c0eb027ad172
msgctxt "h508629d7gba60g477bg9689g6a79d05eea5f"
msgid "Mol says we can't talk to you anymore. Um. Sorry."
msgstr "몰이 당신과 대화하지 말래요. 음. 미안해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Silfy
#. NodeID = a8f9e7ad-fc54-876b-7d6f-3ebb139fce05
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:a8f9e7ad-fc54-876b-7d6f-3ebb139fce05
msgctxt "h1da06973gc6cfg4d93gaf27g9bd7521e2d11"
msgid "Yes! Mol said they're calm as cats! She..."
msgstr "네! 몰이 고양이처럼 침착하다고 했어요! 몰은..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Player
#. NodeID = aabb2200-3c92-f856-145f-22d903dbe29b
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Pickpocket_002_ThreatenedKid(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:aabb2200-3c92-f856-145f-22d903dbe29b
msgctxt "h0243f55eg86c7g492cga442g606010b4e101"
msgid "Tell me the truth - or I'll feed you to a bear."
msgstr "사실을 말해 - 안 그러면 곰에게 먹이로 줄 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Silfy
#. NodeID = acb67642-c353-bcdd-8de5-77b28890b1da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:acb67642-c353-bcdd-8de5-77b28890b1da
msgctxt "ha446942ag6a71g4c69gb338g3c45c144bcad"
msgid "Mol's in charge here. Not me."
msgstr "여기서는 몰이 책임자에요. 저는 아니고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Silfy
#. NodeID = b7ec3fa0-b74b-9319-0d5d-479a6877815a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_State_CaughtStealing = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:b7ec3fa0-b74b-9319-0d5d-479a6877815a
msgctxt "h3511b7acg74e3g41f4g9dd3gc2557e118ca5"
msgid "Eep."
msgstr "앗."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Silfy
#. NodeID = bbe8e92b-3186-0520-6476-8589e2122c30
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:bbe8e92b-3186-0520-6476-8589e2122c30
msgctxt "hb5036567g7c2eg4092g9402gf90fc24ccbbf"
msgid "Nice try. The bears are nice here. Um. I think."
msgstr "그럴듯한 협박이지만, 여기 곰들은 착하거든요. 어, 일단은요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Silfy
#. NodeID = bddd9281-e1a7-85a7-b27a-40045a72b873
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:bddd9281-e1a7-85a7-b27a-40045a72b873
msgctxt "h7e51e44cgbf1ag467cgb3f2gb7ac533d0d48"
msgid "No. I sure don't."
msgstr "아뇨, 처음 들어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Silfy
#. NodeID = bee0fa9b-c5dd-f853-6619-082d8f3767c7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:bee0fa9b-c5dd-f853-6619-082d8f3767c7
msgctxt "hfe557cc7g80e8g4a28ga9d7g96ad7766dfe5"
msgid "It wasn't my idea, it was Mol's! She..."
msgstr "제 아이디어가 아니었어요, 몰이 그랬어요. 그녀가..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Player
#. NodeID = c48097ce-7ac4-6604-8658-b658d37ca576
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_BESTIAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:c48097ce-7ac4-6604-8658-b658d37ca576
msgctxt "h74218e89g63cag4117gbcb9gb9706409d59b"
msgid ""
"You can't yell without a tongue. They go well with a pinch of salt. Tasty."
msgstr "그럼 찍소리도 못하게 혀를 뽑아 주지. 소금 간을 해서 구워 먹으면 얼마나 별미인데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Silfy
#. NodeID = c50d9728-f391-809c-7c60-c72b6fb1bc54
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Pickpocket1_HasMet(1) = True
#.   Global:
#.      - DEN_Hideout_Event_BefriendedThieflings = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:c50d9728-f391-809c-7c60-c72b6fb1bc54
msgctxt "h13e6b82dg0b2bg4773g8818g82fdb12fa2be"
msgid "Hello again! Um."
msgstr "또 보네요! 음."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Player
#. NodeID = cecf97b6-d0d3-640b-c1fa-393449032155
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:cecf97b6-d0d3-640b-c1fa-393449032155
msgctxt "hd621c756gae08g4214g93cdgd08e9e12707a"
msgid "<i>Leave</i>."
msgstr "<i>떠난다</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Silfy
#. NodeID = d7fdde57-4f34-d20d-0719-d584a7de3508
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_State_CaughtStealing = True
#.   Object:
#.      - DEN_Thieflings_Event_ShookThief(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:d7fdde57-4f34-d20d-0719-d584a7de3508
msgctxt "he2659214g471dg4ce6gbf44gcfc59aa27fec"
msgid "No! Don't shake me again!"
msgstr "봐 주세요! 무섭단 말이에요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Silfy
#. NodeID = d86562d4-6ad4-75fa-5a28-470132b6b0ab
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Pickpocket1_HasMet(1) = False
#.   Global:
#.      - DEN_Thieflings_Event_PlayerRobbed_Twice = False
#.      - DEN_Hideout_State_ResolvedThieflings = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Pickpocket1_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:d86562d4-6ad4-75fa-5a28-470132b6b0ab
msgctxt "h554f7bd9g7236g4662g9ffcg75b701699325"
msgid "Oh! Um. Hi?"
msgstr "오! 음. 안녕하세요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Silfy
#. NodeID = da80269b-04ef-4736-f792-c46a7a425bd4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:da80269b-04ef-4736-f792-c46a7a425bd4
msgctxt "hcf880f7agb7f7g4c8dg95ecg5fd6102f79b8"
msgid "Stop... stop yelling at me! Or I'll call Mol!"
msgstr "그만... 제게 고함치지 마세요! 안 그러면 몰을 부르겠어요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Player
#. NodeID = e06987b7-7c8d-6359-dfac-95a80cc4f443
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Pickpocket_002_ThreatenedKid(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:e06987b7-7c8d-6359-dfac-95a80cc4f443
msgctxt "h35038490g12d0g4aaag96dagd116e5f09443"
msgid "Good. Then I can toss both of you into the river."
msgstr "잘 됐네. 둘 다 강에다 던져버리면 되겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Silfy
#. NodeID = e4919e04-b2ee-7add-4140-083e5ab743fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:e4919e04-b2ee-7add-4140-083e5ab743fd
msgctxt "h9654a7aeg8338g4098g8464geae67aed3373"
msgid "Um.  Sorry. Um."
msgstr "음.  죄송해요. 음."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Silfy
#. NodeID = e4d74972-7ba2-d22c-737a-e276e711d82a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_Thieflings_Event_CheckKnowsMol(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:e4d74972-7ba2-d22c-737a-e276e711d82a
msgctxt "h8e1e4507g2816g4935gb7b1gb2aa6a3a00d7"
msgid "Um. I wasn't supposed to say her name."
msgstr "음. 그녀의 이름을 말했으면 안 되는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Silfy
#. NodeID = e59da516-ef69-adf9-ed75-654fd0d47597
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Pickpocket2_HasMet(1) = False
#.   Global:
#.      - DEN_Thieflings_State_CaughtStealing = False
#.      - DEN_Hideout_State_ResolvedThieflings = False
#.      - DEN_Thieflings_Event_PlayerRobbed = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_Pickpocket2_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:e59da516-ef69-adf9-ed75-654fd0d47597
msgctxt "h70649cc9g7e23g46d1gae49ge68f9d77614f"
msgid "Oh! Um. Hi?"
msgstr "오! 음. 안녕하세요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Silfy
#. NodeID = ee61aa57-d33d-cd56-f16f-6f23d7bda385
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:ee61aa57-d33d-cd56-f16f-6f23d7bda385
msgctxt "h70ee1a75gfd0ag47c2g84c4gb98006dc51ed"
msgid "What? N-no! We didn't do anything! Me and Mattis and Mol, we just..."
msgstr "네? 아, 아녜요! 우린 아무 짓도 안 했어요! 저랑 매티스랑 몰은 그냥..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Silfy
#. NodeID = f084d676-4203-3a82-4f03-6f9629df7d82
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:f084d676-4203-3a82-4f03-6f9629df7d82
msgctxt "h2779f126g211bg4408gb7e0g2c131367a846"
msgid "What? Um."
msgstr "네? 음."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Silfy
#. NodeID = f0cb3c43-ef52-d8f4-b1e8-3ddd123a8be5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:f0cb3c43-ef52-d8f4-b1e8-3ddd123a8be5
msgctxt "h4e02008ag3342g43cfg81d9g87407fd9b520"
msgid "I'm the guard? So... don't steal anything! I'm watching you!"
msgstr "저는 경비병일걸요? 그러니... 아무것도 훔치지 마세요! 제가 보고 있으니까요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Silfy
#. NodeID = f1e1be03-e276-1ced-3f02-7428eafef61e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:f1e1be03-e276-1ced-3f02-7428eafef61e
msgctxt "h6dd1b1d8gc525g498eg8509g95fe9223ec39"
msgid "Oh. Um. We can both swim."
msgstr "어. 음, 우리 둘 다 수영할 줄 알거든요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Player
#. NodeID = f398ce8e-e1a1-5026-8c2f-935b2bae3607
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:f398ce8e-e1a1-5026-8c2f-935b2bae3607
msgctxt "h4f2ac085gbafdg43f5ga098g255370d7647a"
msgid "You know, you didn't deny lying to me."
msgstr "아무튼 날 속였다는 거네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Silfy
#. NodeID = f3e52a86-c6ab-9a09-0341-df2440d99007
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:f3e52a86-c6ab-9a09-0341-df2440d99007
msgctxt "h3bfdac7cg8ff0g4f54g839ag409fd1194c0f"
msgid "I don't know what you mean. At all."
msgstr "무슨 말씀인지 모르겠어요. 진짜요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Silfy
#. NodeID = f42bf996-a3f5-2e6a-5fa2-1dcba1a2e258
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:f42bf996-a3f5-2e6a-5fa2-1dcba1a2e258
msgctxt "h100d70e0g95e3g494fg8040g53079578e286"
msgid "Y-you wouldn't do that! Not with all the grown-ups around!"
msgstr "그, 그렇겐 못 할걸요! 주위에 어른들이 얼마나 많은데!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Player
#. NodeID = fc8b9a79-a7f0-bd70-62a4-0232c87612ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:fc8b9a79-a7f0-bd70-62a4-0232c87612ed
msgctxt "h94556a94gf53eg43a3g9108g0a222b8746f2"
msgid "<i>Leave</i>."
msgstr "<i>떠난다</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Silfy
#. NodeID = fcdd6204-4d7a-7ab0-0287-e725fbd40d56
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Pickpocket2_HasMet(1) = True
#.   Global:
#.      - DEN_Thieflings_Event_MerchantKidLeaves = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:fcdd6204-4d7a-7ab0-0287-e725fbd40d56
msgctxt "h2893f2afgc783g4791g8d1bgd0d4f627e84e"
msgid "Oh. Hello again. Um."
msgstr "오. 다시 오셨네요. 음."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Player
#. NodeID = fdd4a94e-e13b-57d7-f990-1ee5a300740f
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - ROGUE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:fdd4a94e-e13b-57d7-f990-1ee5a300740f
msgctxt "he036c8f6gecb7g4622g9baagc0154cad0b94"
msgid "I know your game - and it's sloppy. Drop the act."
msgstr "난 너희들의 속임수를 알고 있어 - 그리고 엉성해. 그만둬."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Silfy
#. NodeID = fea3b02d-9dfb-90b6-e936-519df7ba260b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_ThieflingsPickpocket2_PCUsedHandSignal(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:fea3b02d-9dfb-90b6-e936-519df7ba260b
msgctxt "hc1e6198aga72cg4c8agb428g89d59fa27440"
msgid ""
"I can't talk right now. I'm supposed to be looking for, um, marks. You know."
msgstr "말할 시간 없어요. 지금 그걸 찾고 있거든요, 그, 표적이요. 알잖아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002
#. Speaker = Silfy
#. NodeID = ffb71ff0-91c4-44e0-7e7d-2ab21f7aa81d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_Thieflings_Event_CheckKnowsMol(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_002:ffb71ff0-91c4-44e0-7e7d-2ab21f7aa81d
msgctxt "h6b689af2g9e4eg45ccg9b04g7286952bd3bb"
msgid "She's my... um. My... boss?"
msgstr "걔는, 음. 제... 대장?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Meli
#. NodeID = 017834d5-d34f-a1c2-a06f-c34f4269c98a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TIEFLING(3) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:017834d5-d34f-a1c2-a06f-c34f4269c98a
msgctxt "h90526087g8555g4832g900eg6c56345be5bc"
msgid "These two outsiders are threatening me, Ikaron."
msgstr "이 외부인 둘이 절 협박해댔어요, 이카론."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Player
#. NodeID = 02bf855b-29d3-4948-b27b-554eb6ead501
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(3) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:02bf855b-29d3-4948-b27b-554eb6ead501
msgctxt "h270402bdgba1eg457dga24dg51665c6ecc33"
msgid "Do you really want to take a beating over some jewellery?"
msgstr "정말 고작 장신구 때문에 두들겨맞고 싶은 작정인 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Player
#. NodeID = 03e6e55f-9131-9635-7bc3-9978537cfe90
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#.   Tag:
#.      - BARBARIAN(3) = True
#. TagRule: BERSERKER
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:03e6e55f-9131-9635-7bc3-9978537cfe90
msgctxt "h91c33be4g108ag4ee0gb2e2gb9adc138a2c7"
msgid "<b>DO AS HE SAYS, OR JOIN THE SNAKEBITTEN GIRL IN HER GRAVE.</b>"
msgstr "<b>시키는 대로 해라. 아니면 뱀한테 물린 그 여자애 따라 무덤에 들어가든가.</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Player
#. NodeID = 03e6e55f-9131-9635-7bc3-9978537cfe90
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#.   Tag:
#.      - BARBARIAN(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:03e6e55f-9131-9635-7bc3-9978537cfe90
msgctxt "ha1fbb27age978g40eag8b66g2ecc50a19ab8"
msgid "Thieving children wind up dead around here. <b>Do as he says.</b>"
msgstr "이미 손버릇 나쁜 애 하나가 지 목숨 날렸지. <b>시키는 대로 해.</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Ikaron
#. NodeID = 0712a0f9-9d6a-4419-f9ac-1923bbdb44d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:0712a0f9-9d6a-4419-f9ac-1923bbdb44d9
msgctxt "h7679b166g6324g417fgad93g21dee98d7609"
msgid "And stay down."
msgstr "그대로 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Meli
#. NodeID = 07960d73-3cb5-ee8e-71f0-bad1db013e0a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:07960d73-3cb5-ee8e-71f0-bad1db013e0a
msgctxt "h6ac7baabgab5ag4a73g979dg5f3872d0ef26"
msgid "You're sick. "
msgstr "구역질 나. "

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Ikaron
#. NodeID = 0a47c81a-725e-67ea-9c4e-0894a6da4575
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:0a47c81a-725e-67ea-9c4e-0894a6da4575
msgctxt "h88892473ge96bg4a89gbbd5g8bcb5a0a71a6"
msgid "He's an orphan. How'd you like it if I struck <i>you</i>?"
msgstr "얘는 고아라고. 내가 <i>널</i> 후려 패도 괜찮을 거 같냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Player
#. NodeID = 0a8301e2-640f-9e59-beb3-2581e8e95ea3
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#.   Tag:
#.      - BARBARIAN(3) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:0a8301e2-640f-9e59-beb3-2581e8e95ea3
msgctxt "he442d30ag5b93g4f69g9386g306eac14f9eb"
msgid "Better do what he says, boy. There's already one thief to bury today."
msgstr "시키는 대로 하는 게 좋을 거다, 꼬마야. 묫자리 들어간 도둑이 벌써 하나 있거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Meli
#. NodeID = 0aaf3b7a-332e-8067-eade-8a50f29370d5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Hideout_Event_BefriendedThieflings = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:0aaf3b7a-332e-8067-eade-8a50f29370d5
msgctxt "h7df04e9ag34efg43cfga472gb14fba61c793"
msgid "Maybe you will. But personally, I doubt it."
msgstr "그럴지도 모르지. 근데 내 생각엔 어림도 없을걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Player
#. NodeID = 0adb92cc-e247-fc98-dcd9-9ca8ef3a4ef3
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:0adb92cc-e247-fc98-dcd9-9ca8ef3a4ef3
msgctxt "ha3342968gbfc4g41a4gbc93g7e67142b5501"
msgid "You're not fooling anyone, boy. Why'd you take it?"
msgstr "그래봤자 아무도 안 속는다, 꼬맹아. 왜 훔친 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Meli
#. NodeID = 122267b1-ca38-8932-11d1-2e5f21cbbe44
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:122267b1-ca38-8932-11d1-2e5f21cbbe44
msgctxt "h18de6440g614eg4e15gaa76gf02de2b1354a"
msgid "You're sick. "
msgstr "구역질 나. "

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Meli
#. NodeID = 1afcb63c-e147-496e-c942-61245d37330d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - HIDDEN_WLD_Boosters.DEN_Thieflings_PersuadedKid(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:1afcb63c-e147-496e-c942-61245d37330d
msgctxt "hd319aff2gd6c5g4df7g8842g82726b0eaf64"
msgid "Probably not. It's just tin and glass."
msgstr "그건 좀 아니네. 겨우 쇠랑 유리 쪼가리인걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Player
#. NodeID = 1bc31296-cc42-c290-4065-633a596ea488
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(3) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:1bc31296-cc42-c290-4065-633a596ea488
msgctxt "h674e591cg0e69g41d8ga623g2f0f387ceb25"
msgid "Meddlers are even worse than thieves. You're not meddling, are you?"
msgstr "참견쟁이는 도둑보다도 더 망할 종자인데 말이야. 설마 참견질 해대려던 건 아니지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Player
#. NodeID = 21148fef-c550-5d2d-39f2-fcd66d0231c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:21148fef-c550-5d2d-39f2-fcd66d0231c8
msgctxt "h5bfa37d8g1941g4b37ga8a0g276ab71c89b0"
msgid "I tried to give you a chance. You're on your own."
msgstr "기회를 주려던 건데 글러먹었군. 너 알아서 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Ikaron
#. NodeID = 246424a7-43f2-e2f5-ba54-1080de009899
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:246424a7-43f2-e2f5-ba54-1080de009899
msgctxt "hbe538013ge141g452eg90f2ge77c0b4f7a99"
msgid "Is this true?"
msgstr "그게 사실이냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Ikaron
#. NodeID = 27e78388-a9b1-3621-d7f4-3227ab9a79c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:27e78388-a9b1-3621-d7f4-3227ab9a79c8
msgctxt "h45f512f0gc74ag483dgb980gc2c5d256ba59"
msgid "We were wrong to trust you. I see that now."
msgstr "널 믿고 여기 들인 게 실수였어. 네 수작질이 보인다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Player
#. NodeID = 2a89edac-7f63-120f-3cf3-cded34e60eae
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - MONK(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:2a89edac-7f63-120f-3cf3-cded34e60eae
msgctxt "h43a3e33dgc038g40d3gb583ga907829d2b5b"
msgid ""
"Let us find balance. The child will return the locket - and the adult will "
"act his age."
msgstr "균형을 갖추자. 아이는 로켓을 돌려주고, 어른은 어른답게 행동하는 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Ikaron
#. NodeID = 2be39393-d787-6407-4e92-88179eff7239
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_Thieflings_Event_AdventurersTieflingsHostile(1) = True
#.     - DEN_Thieflings_Event_TurnTieflingsHostile(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:2be39393-d787-6407-4e92-88179eff7239
msgctxt "hf74dfdc0g387bg4ac9g811bgbe740fd5e961"
msgid "Sisters! Brothers! To arms!"
msgstr "형제자매들! 무기를 들어라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Meli
#. NodeID = 2d9f4a08-f8aa-a7a8-7d77-d7b21356b42f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - HIDDEN_WLD_Boosters.DEN_Thieflings_PersuadedKid(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:2d9f4a08-f8aa-a7a8-7d77-d7b21356b42f
msgctxt "h5dac429agcf7dg4baeg91d6gab0d6430b3fa"
msgid "Fine! It's just tin and glass anyway."
msgstr "알았어! 어차피 겨우 쇠랑 유리 쪼가리니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Ikaron
#. NodeID = 3641bf0b-2132-3324-9bc1-0a9ce0edf606
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:3641bf0b-2132-3324-9bc1-0a9ce0edf606
msgctxt "h1aff7c5eg0060g491bg8a8cgf1916ee382a9"
msgid "And you, get out of my sight."
msgstr "그리고 넌 내 눈앞에서 사라져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Meli
#. NodeID = 37626753-cdca-09c3-7e31-13778e4f3b7e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_State_SecondStageDone = False
#.   Object:
#.      - DEN_Thieflings_State_HasStolenLocket(0) = True
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Event_PlayerNotInvolved = True
#.     - DEN_Thieflings_Event_ItemReturned = True
#.   Object:
#.     - DEN_Hideout_Event_TransferLocket(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:37626753-cdca-09c3-7e31-13778e4f3b7e
msgctxt "h5c37199bg9b1eg456dg9f78g8e43a91608df"
msgid "There. Don't know why you cared so much. It's junk."
msgstr "받아. 이게 뭐라고 난리 친 건지 모르겠네. 잡동사니 가지고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Ikaron
#. NodeID = 377e552d-b540-c178-e24c-7ff7507b7434
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:377e552d-b540-c178-e24c-7ff7507b7434
msgctxt "h215397cdg0ff1g4d94g9293g1156386a5335"
msgid "Go, child."
msgstr "가라, 얘야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Ikaron
#. NodeID = 3b09a69e-2c09-f833-5ecf-0ec5777e8245
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:3b09a69e-2c09-f833-5ecf-0ec5777e8245
msgctxt "h012be5f6g4afdg4f72ga3a1g7d55983c3741"
msgid "You're not wrong. I wish you were."
msgstr "틀린 말은 아니군. 인정하고 싶진 않지만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Meli
#. NodeID = 3b5a9d11-e125-b0f7-f455-ef5a5c436b70
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_State_MessedWithMolsKids = True
#.     - GLO_Thieflings_State_PickpocketKidGotHit = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:3b5a9d11-e125-b0f7-f455-ef5a5c436b70
msgctxt "h60f135c3g4027g4d52gab8dgf2606c86d365"
msgid "Do it, you gutless stinksack!"
msgstr "쳐 봐, 이 깡도 없는 구린내쟁이야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Player
#. NodeID = 3cb544d8-c947-7acd-45e2-4f3e5ce5083b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#.   Tag:
#.      - MONK(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:3cb544d8-c947-7acd-45e2-4f3e5ce5083b
msgctxt "h94a5d8b1gb715g4ab5g859dg60ae605b4b85"
msgid ""
"Theft and revenge have already killed a child here. Calm yourselves - "
"explain what happened."
msgstr "도둑질과 그 보복으로 이미 아이 하나가 목숨을 잃은 상황이야. 마음을 진정시키고 무슨 일인지 설명해 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Meli
#. NodeID = 3d66292d-9580-9a2d-bda5-1a847e5bb0db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:3d66292d-9580-9a2d-bda5-1a847e5bb0db
msgctxt "h5f9ccf92g4f86g41dfg8902g3524f4d34202"
msgid "A beating, huh? Oh no. Whatever will I do?"
msgstr "때리시겠다? 어이구야. 이거 참 어쩌나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Ikaron
#. NodeID = 3e9f587b-0677-142a-0478-94f0b6420501
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:3e9f587b-0677-142a-0478-94f0b6420501
msgctxt "h89477a48g72c5g439ega9d4gcab05c3d569b"
msgid "And now you're threatening <i>me</i>? You fool."
msgstr "이젠 <i>나까지</i> 협박하는 거냐? 멍청하긴."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Meli
#. NodeID = 3ecdd5a5-66da-6cdc-aeea-3387ee8a4838
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:3ecdd5a5-66da-6cdc-aeea-3387ee8a4838
msgctxt "h8eb6500fg1bd2g4140g9581g80edcf5e8be6"
msgid "And I... huh. Someone stole it from me. That's kind of funny."
msgstr "그리고 난... 어라. 누가 그거 훔쳐갔나 봐. 거 참 웃기는 일이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Barth
#. NodeID = 3f6d61c7-d9f9-c04e-7662-1e6f7a60f41f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:3f6d61c7-d9f9-c04e-7662-1e6f7a60f41f
msgctxt "h5abd30e9geefag429eg9559g10b136fc9691"
msgid "Keep it, kid. You need it more than me."
msgstr "네가 가져라. 나보단 네가 갖는 게 낫겠구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Player
#. NodeID = 42a59fd2-0436-c112-f691-32cbd098b310
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = False
#.   Tag:
#.      - MONK(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:42a59fd2-0436-c112-f691-32cbd098b310
msgctxt "h66ae4587gd209g4f4eg8d10g9dc519289cab"
msgid ""
"I think it would benefit everyone to <i>calm down</i> here. What happened?"
msgstr "다들 일단 마음을 <i>진정</i>하는 게 좋을 거 같군. 무슨 일이야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Barth
#. NodeID = 45b5ccf5-b7b3-6922-c836-74c25bc93337
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:45b5ccf5-b7b3-6922-c836-74c25bc93337
msgctxt "hdfa755a4g7140g49f6gb1d2gba07a97c366b"
msgid "Don't you tell me to calm down - my locket was stolen!"
msgstr "진정하라 마라 하지 마. 내 로켓이 도둑맞았다고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Ikaron
#. NodeID = 472eb4c5-93ff-f203-ff90-6ac560144a18
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:472eb4c5-93ff-f203-ff90-6ac560144a18
msgctxt "hc8ec6853g8502g4177gb031g45469af2776d"
msgid "Good, that's settled. Now, <i>disperse</i>. "
msgstr "좋아, 정리됐군. 이만 <i>가던 길 가.</i> "

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Player
#. NodeID = 4766cedd-6dd3-7725-ba99-3782e4e358c6
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - TIEFLING(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:4766cedd-6dd3-7725-ba99-3782e4e358c6
msgctxt "h612c29afg0b73g4c4dg8b49g337e0664bd38"
msgid "Just give it back, boy. You're better than this."
msgstr "그냥 돌려줘라, 얘야. 못난 모습은 보이지 말아야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Barth
#. NodeID = 491a40a9-031d-7bb5-4d04-e8465e9b3c38
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_PlayerNotInvolved = False
#.      - DEN_Thieflings_Event_IntimidationFailed = False
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Knows_KidsThieves = True
#.     - DEN_Thieflings_State_PCSawKidThievesGettingCaught = True
#.   Object:
#.     - DEN_Thieflings_State_WitnessedArgument(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:491a40a9-031d-7bb5-4d04-e8465e9b3c38
msgctxt "he760bb23g2fd0g4f54gbb39g1a4bf1fb3b2e"
msgid "Only going to ask you one more time, boy. Hand over my locket."
msgstr "마지막으로 딱 한 번만 더 말한다, 꼬맹아. 내 로켓 내놓으시지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Player
#. NodeID = 4943a0ed-5b2b-6672-4240-d8654f4ef38b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:4943a0ed-5b2b-6672-4240-d8654f4ef38b
msgctxt "h3f252170ga8eeg4705ga551g79026a2e66e4"
msgid "Good. Everyone happy?"
msgstr "좋아. 이제 다 해결 된 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Meli
#. NodeID = 49beddc5-c6ff-bb22-bb83-b33dfc669128
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Thieflings_State_HasStolenLocket(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:49beddc5-c6ff-bb22-bb83-b33dfc669128
msgctxt "h37ab238fg86fdg44a3ga930g67f1de2749e7"
msgid "Gods, don't bleed over the thing. It's just tin and glass."
msgstr "아니, 겨우 그걸로 피를 봐야 돼? 그냥 쇠랑 유리 쪼가린데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Meli
#. NodeID = 4f13cec0-33ba-ba56-ba3e-4fe8212f9897
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_GuardNearby = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:4f13cec0-33ba-ba56-ba3e-4fe8212f9897
msgctxt "h43458507gdbadg451cgb6a9g9968c482d992"
msgid "You like watching people hit kids? You happy now?"
msgstr "댁은 애 처맞는 거 보는 게 좋나 봐? 기분 째지셔?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Ikaron
#. NodeID = 5068e6b3-5944-6d11-d46b-767a67d30ad0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:5068e6b3-5944-6d11-d46b-767a67d30ad0
msgctxt "h2aca2b58g66fag4291g85aagcb5184d1c279"
msgid "Child, learn your lesson and be grateful."
msgstr "얘야, 이 일을 교훈 삼고 다행으로 여기렴."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Player
#. NodeID = 506d37c5-813f-636e-a26e-5f07173186ad
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - PALADIN_NEUTRAL(3) = True
#.      - PALADIN_GOOD(3) = True
#. TagRule: PALADIN_GOOD or PALADIN_NEUTRAL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:506d37c5-813f-636e-a26e-5f07173186ad
msgctxt "h87530b79ga074g473cgb78fg0c6379b5af89"
msgid "Whatever you do to the child, I'll repay ten-fold."
msgstr "애한테 뭔 짓이라도 하면, 내가 열 배로 되돌려주겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Player
#. NodeID = 51a8ff11-0b2e-2e3f-84bb-e91386fbacf2
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - PALADIN_NEUTRAL(3) = False
#.      - PALADIN_GOOD(3) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:51a8ff11-0b2e-2e3f-84bb-e91386fbacf2
msgctxt "h8de38ef5g477cg4814g8d08g1402c1bfecd8"
msgid "You're the one making threats - to a child. Pull yourself together."
msgstr "협박은 네가 하고 있는 거지. 그것도 애한테. 정신 좀 차리라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Barth
#. NodeID = 530da8d8-4a5f-8524-7ace-428d2e040d8e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:530da8d8-4a5f-8524-7ace-428d2e040d8e
msgctxt "ha52b33aeg2ca6g467ag9a03gc442cc64d966"
msgid "Can't thank you enough."
msgstr "정말이지 고마워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Player
#. NodeID = 54252374-dffe-b104-e012-9c077f429426
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(3) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:54252374-dffe-b104-e012-9c077f429426
msgctxt "h382df44cg9a7eg4604g9efdg6002c877fcd5"
msgid "Raise a hand to that child and you'll lose it. Your choice."
msgstr "저 애한테 손 들이대면 그 손모가지 잃게 될 거다. 잘 생각하시지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Ikaron
#. NodeID = 553b5b37-d3ce-52de-d2e6-c962dedd1283
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:553b5b37-d3ce-52de-d2e6-c962dedd1283
msgctxt "h03d38605gebd5g4236g966ag183f35e79e17"
msgid "<i>Quiet</i>. Child, go."
msgstr "<i>다물어</i>. 가라, 얘야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Player
#. NodeID = 55838816-4b54-e45f-1bf7-16a9817b16b0
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:55838816-4b54-e45f-1bf7-16a9817b16b0
msgctxt "h348b1cc0g51acg4806g87a1g09d848e3cea1"
msgid "Strike the child, go on<b>. See what happens.</b>"
msgstr "애를 치시겠다? 어디 해 봐. <b>어떻게 되나 보자고.</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Barth
#. NodeID = 563192a8-9298-a7ae-9d46-9885af406acc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:563192a8-9298-a7ae-9d46-9885af406acc
msgctxt "h86a889c4gb0a3g44bbg9a7ageec61e2050e1"
msgid "I get my locket back and you'll have no trouble from me."
msgstr "내 로켓만 돌려준다면 나도 아무 짓 하지 않을 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Player
#. NodeID = 56d59fb3-4419-0be1-b762-00e0f56129f2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:56d59fb3-4419-0be1-b762-00e0f56129f2
msgctxt "h2bae8394g8fc0g4467g9996ga787538bd2d6"
msgid "I want an answer - why'd you steal it?"
msgstr "대답을 듣고 싶은데. 왜 그걸 훔친 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Player
#. NodeID = 578fb0ba-e579-d375-a25e-70d303596727
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:578fb0ba-e579-d375-a25e-70d303596727
msgctxt "h41e8c564g9db5g439bg9f93ga3b457fb53a1"
msgid "The boy's a thief."
msgstr "이 애는 도둑이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Meli
#. NodeID = 57a2bb67-0f1c-dc1b-7c89-744222dd677d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:57a2bb67-0f1c-dc1b-7c89-744222dd677d
msgctxt "hace11fa1gb2ceg4cd6g9322g8c5aefb3a03b"
msgid "Fine, lumpy. You win."
msgstr "알았수, 이 진상아. 내가 졌어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Ikaron
#. NodeID = 5966f14c-5db0-db5a-4e8e-a18cd8a829ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:5966f14c-5db0-db5a-4e8e-a18cd8a829ec
msgctxt "h989371a2g91bfg4965gba98g7139276296d0"
msgid "Of... of course not."
msgstr "그... 그럴리가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Player
#. NodeID = 5c1be2ee-c40f-f781-c98a-7474bd5919f2
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:5c1be2ee-c40f-f781-c98a-7474bd5919f2
msgctxt "hd0f26851g926fg4497g8558g4326866b2a33"
msgid ""
"Just a misunderstanding. The boy was about to give Barth his locket back."
msgstr "오해하는 거야. 꼬마가 바쓰한테 로켓 돌려주고 끝나려던 참이었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Player
#. NodeID = 5e6efb76-b794-b914-eee6-5d72c2a8c8db
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - TIEFLING(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:5e6efb76-b794-b914-eee6-5d72c2a8c8db
msgctxt "ha7750388g7985g45e1g8751gf036781f1a82"
msgid "I'm the one looking out for the boy."
msgstr "난 이 애를 지켜주고 있는 쪽이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Barth
#. NodeID = 6070fe86-745c-ab92-7394-1a5cf262bf24
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:6070fe86-745c-ab92-7394-1a5cf262bf24
msgctxt "ha5f57bb0gdf91g4a14g961bge5a4bad6194c"
msgid "But my locket!"
msgstr "내 로켓은 어쩌고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Meli
#. NodeID = 66a2a68f-aa45-fa06-0101-f28a3293b16e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:66a2a68f-aa45-fa06-0101-f28a3293b16e
msgctxt "h941e1cf9gf8c3g4f7cg9c9cg802db4b7802b"
msgid "I don't have your ugly locket. I've never even seen it before!"
msgstr "난 댁의 못생긴 로켓 갖고 있지 않아. 애초에 본 적도 없다고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Meli
#. NodeID = 676e4e6b-401a-4b02-73de-75af75f99041
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:676e4e6b-401a-4b02-73de-75af75f99041
msgctxt "h7cbe5fe6g249ag4d6dg8534ga406080d99ab"
msgid "What kind of question is that? Why does anyone steal anything?"
msgstr "뭔 놈의 질문이 순 그래? 도대체 누가 뭘 훔쳤다는 건데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Barth
#. NodeID = 6c9c58f3-1319-4b4f-69ec-69e713c77d7d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:6c9c58f3-1319-4b4f-69ec-69e713c77d7d
msgctxt "h2ab727cfga7d4g4943ga64ag8f599596738f"
msgid "The boy stole my locket!"
msgstr "이 꼬마가 내 로켓을 훔쳤어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Meli
#. NodeID = 6cdefc83-6fdb-ff9e-903f-b487acd8e6ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:6cdefc83-6fdb-ff9e-903f-b487acd8e6ad
msgctxt "heab650e9g5f06g4c81gbe6dgebdb33626896"
msgid "Fine. It's worthless anyway."
msgstr "좋아요. 어차피 쓸모도 없는 거니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Barth
#. NodeID = 6f8fa2d1-9df2-7c21-915d-c67b052cd380
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:6f8fa2d1-9df2-7c21-915d-c67b052cd380
msgctxt "hb84a7418gb487g44d7gab3bg4e86b886c116"
msgid ""
"These little devils get away with everything because of coddling bastards "
"like you."
msgstr "너 같은 망할 응석받이들 때문에 저 데빌 꼬맹이들이 눈에 뵈는 게 없이 구는 거야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Meli
#. NodeID = 6fc319b8-1693-5e30-5b78-b12f494eb0dd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Thieflings_State_HasStolenLocket(0) = False
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Event_PlayerNotInvolved = True
#.     - DEN_Thieflings_Event_CallGuard = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:6fc319b8-1693-5e30-5b78-b12f494eb0dd
msgctxt "hceca0abcg80a5g4fbeg9c5bgb52a5d816502"
msgid "Feel better? Or were you hoping I'd cry?"
msgstr "이제 후련해? 내가 질질 짜기라도 바란 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Barth
#. NodeID = 701ff5ac-b800-8881-eccd-87f59910ef22
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:701ff5ac-b800-8881-eccd-87f59910ef22
msgctxt "h59a4cc78ge5b7g4481gbe1dgab2b0dbf5f12"
msgid "Yeah? I'll give you something to laugh about."
msgstr "그래? 이래도 웃기나 어디 한번 보자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Ikaron
#. NodeID = 750e6bfc-9892-a09f-876d-e06fb7cbb7dc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_PlayerNotInvolved = True
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_State_SecondStageDone = True
#.   Object:
#.     - DEN_Thieflings_State_WitnessedArgument(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:750e6bfc-9892-a09f-876d-e06fb7cbb7dc
msgctxt "hc47a04d7g6b7cg4d91gae51gd9c075c5a918"
msgid "What's happening here?"
msgstr "무슨 소란이냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Player
#. NodeID = 78481b51-fa9f-c9b9-c111-f58ae84a48cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:78481b51-fa9f-c9b9-c111-f58ae84a48cf
msgctxt "ha1567ddcg86cfg42fbgbf8cg0a800ca8b065"
msgid "No idea. This man just started attacking the boy."
msgstr "모르겠어. 이 남자가 갑작스레 애를 때리더라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Meli
#. NodeID = 7d63a52d-f615-c113-d0ab-d5fc3d9378f1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Event_ItemReturned = True
#.     - DEN_Hideout_Event_BefriendedThieflings = True
#.   Quest:
#.     - HIDDEN_WLD_Boosters.DEN_Thieflings_PersuadedKid(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:7d63a52d-f615-c113-d0ab-d5fc3d9378f1
msgctxt "hc16b89d3g5cfcg4b1eg8906g5ff2f4518f1b"
msgid "Not bad. Not even a little bit bad."
msgstr "솜씨 괜찮네. 감쪽같이 당했는걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Meli
#. NodeID = 7ef7cdd4-4ef1-da37-4018-fff9db688ec4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_Thieflings_Event_AdventurersTieflingsHostile(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:7ef7cdd4-4ef1-da37-4018-fff9db688ec4
msgctxt "h2eab8a67g33e7g4640g877dg60b47758e43c"
msgid "Help! This human is trying to kill me!"
msgstr "살려줘! 이 인간이 저 해치려고 해요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Ikaron
#. NodeID = 7f29f4f1-fb52-857d-d913-46438742036f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - HIDDEN_WLD_Boosters.DEN_Thieflings_PersuadedAdventurer(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:7f29f4f1-fb52-857d-d913-46438742036f
msgctxt "h9ce74d0dgbcb2g4fd6gbaebg79fc77036a2e"
msgid "Good. You heard them, child. You're free to go."
msgstr "좋아. 들었지, 얘야. 이만 가보려무나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Ikaron
#. NodeID = 80040b49-4f75-65ab-85ea-171f1ce3be1e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:80040b49-4f75-65ab-85ea-171f1ce3be1e
msgctxt "hcbaa7a15gcfc5g4742gae6ag14ece55243e4"
msgid "And both of you thought striking the child was a suitable punishment?"
msgstr "그렇다고 너희는 애를 때리는 게 합당한 처벌이라고 생각한 거냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Meli
#. NodeID = 8106156b-a9a5-2c90-a8c4-17177023d950
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:8106156b-a9a5-2c90-a8c4-17177023d950
msgctxt "hb35ac773g7909g44f2gbac4g0943cacede4c"
msgid "It looked like my mother's, all right?"
msgstr "우리 엄마 거랑 비슷해서 그랬어! 됐냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Player
#. NodeID = 817a63d0-b907-ede5-8a02-3a752f7157a7
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:817a63d0-b907-ede5-8a02-3a752f7157a7
msgctxt "h62dc82b1g7bb8g4ca6gbda6g7dce97c388c9"
msgid "That bauble worth a <b>thrashing?</b>"
msgstr "<b>매타작</b>이 나도 그 싸구려를 갖고 싶냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Player
#. NodeID = 825b8bd8-944e-2b0b-a96d-2fc117a0b31a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:825b8bd8-944e-2b0b-a96d-2fc117a0b31a
msgctxt "h879df67eg8115g4bdag9ddega5095b222396"
msgid "My coin's on the tiefling. He looks <i>angry</i>."
msgstr "티플링이 이긴다에 걸겠어. 제대로 <i>열 받은</i> 모양이니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Meli
#. NodeID = 86bce21d-9f03-bfed-ba03-f1efc9ef6bcb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_GuardNearby = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:86bce21d-9f03-bfed-ba03-f1efc9ef6bcb
msgctxt "h62a324bfg55ccg4f9eg9916g92523565e704"
msgid "You like watching people hit kids? You happy now?"
msgstr "댁은 애 처맞는 거 보는 게 좋나 봐? 기분 째지셔?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Meli
#. NodeID = 8db6aad1-4e7a-9064-603c-4b252c702792
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Thieflings_State_HasStolenLocket(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:8db6aad1-4e7a-9064-603c-4b252c702792
msgctxt "h21d35ad7g0fe2g4cabg9f4cg10d897028cb8"
msgid "Huh. Someone stole it from me. That's kind of funny."
msgstr "어라. 누가 그거 훔쳐갔나 봐. 거 참 웃기는 일이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Barth
#. NodeID = 97a1f202-1a5b-8d99-2632-851870b03ed3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:97a1f202-1a5b-8d99-2632-851870b03ed3
msgctxt "h018a7122gb97dg49dfgb500g97f739893762"
msgid "Doesn't look like they're coming, boy. "
msgstr "네 말 들은 사람 없나 보구나, 꼬맹아. "

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Barth
#. NodeID = 97e58861-70e4-367c-63ca-28edf64e6cdd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Event_PlayerNotInvolved = True
#.     - DEN_Thieflings_Event_CallGuard = True
#.     - DEN_Thieflings_Event_ItemReturned = True
#.   Object:
#.     - DEN_Hideout_Event_TransferLocket(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:97e58861-70e4-367c-63ca-28edf64e6cdd
msgctxt "h76a905aega527g4b95g8f19g82540923ca51"
msgid "Knew it. Bloody well knew it."
msgstr "역시. 빌어먹을 역시나였어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Meli
#. NodeID = 98e5192c-577d-43f8-17d7-652d0c8f0706
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:98e5192c-577d-43f8-17d7-652d0c8f0706
msgctxt "hf2c316c8g2619g4480gaa1ag3824200d2e6c"
msgid "Ahh!"
msgstr "아야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Meli
#. NodeID = 9a92fe5c-0a7e-f689-3831-03417745a86f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:9a92fe5c-0a7e-f689-3831-03417745a86f
msgctxt "hb8e032b0ga101g475bg992dg7b5c501964f3"
msgid "And I thought <i>he was a </i>coward."
msgstr "겁쟁이는 <i>이 인간</i> 쪽일 줄 알았는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Meli
#. NodeID = a15e94fa-91af-f18b-c9f2-db725ae85ad3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:a15e94fa-91af-f18b-c9f2-db725ae85ad3
msgctxt "h6f9be58bgf6bcg4209gb75bg356b58bf73cd"
msgid ""
"I said I don't have it. Maybe he dropped it running away from those big, "
"scary goblins."
msgstr "내가 안 갖고 있댔잖아. 고블린한테 쫄아 튀던 중에 어디다 떨어뜨려 버렸나 보지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Ikaron
#. NodeID = a203c260-bb89-0f81-19dc-2b2112a68a1e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:a203c260-bb89-0f81-19dc-2b2112a68a1e
msgctxt "hf2f2aeefg7564g4686ga835g1635786f466e"
msgid "And you? You had this coming."
msgstr "그리고 너. 이건 네가 자초한 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Barth
#. NodeID = a43da069-00a2-718c-7b44-f8355ac15bb8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:a43da069-00a2-718c-7b44-f8355ac15bb8
msgctxt "h8f8ffbbcgbde6g4f7ag9747g78e2866fbece"
msgid "You threatening me?"
msgstr "지금 나 협박하냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Player
#. NodeID = a56091f6-adbf-096b-f777-06b299593a90
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:a56091f6-adbf-096b-f777-06b299593a90
msgctxt "h75f830adg5d43g4284g8800gba92e547ff0e"
msgid "Let the boy take it as a warning - he's getting off lightly."
msgstr "꼬마가 경고 받은 셈으로 삼자고. 이만하면 가볍게 넘어간 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Ikaron
#. NodeID = a731d866-824e-4609-de04-b61fc178db1e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:a731d866-824e-4609-de04-b61fc178db1e
msgctxt "h7498b704g8d3cg4cb0g9e78g87497a4d7f62"
msgid "And that justifies threatening a child?"
msgstr "그렇다고 애를 위협해도 된다는 거냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Barth
#. NodeID = ab69fd84-94f7-c9e4-09d6-39c07dfe6958
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:ab69fd84-94f7-c9e4-09d6-39c07dfe6958
msgctxt "h4669d2fdg39edg4cd4g9ac4gdd02a753aa07"
msgid "To impress a girl, most like."
msgstr "여자애한테 점수나 따려던 거겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Player
#. NodeID = b193222d-22f8-1698-c74a-3c3e00c44b38
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:b193222d-22f8-1698-c74a-3c3e00c44b38
msgctxt "hda5750a2g9a91g4293g816fga123b323a6b6"
msgid "There's no locket. This bastard's just throwing his weight around."
msgstr "로켓 같은 건 없어. 이 작자가 그냥 위세를 부려대던 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Meli
#. NodeID = b42e1524-2586-3b27-d80c-ac393b0b5c80
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_Thieflings_Event_AdventurersTieflingsHostile(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:b42e1524-2586-3b27-d80c-ac393b0b5c80
msgctxt "h89f83905g4f50g4518g8342g9096bdad5ea9"
msgid "Guards! This human is trying to hurt me and my friend!"
msgstr "경비병님! 이 인간이 저랑 제 친구 해치려고 해요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Player
#. NodeID = b5449031-364f-66ba-e15a-083d582bd8fa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:b5449031-364f-66ba-e15a-083d582bd8fa
msgctxt "h3a37c55ag32e5g4a23g9f6eg7035a6a8be42"
msgid "Forget it. I don't want any trouble."
msgstr "됐어. 괜한 일에 엮이긴 싫군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Player
#. NodeID = b64ed85b-c649-d9f5-c72e-dea2152e74aa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = False
#.   Tag:
#.      - MONK(3) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:b64ed85b-c649-d9f5-c72e-dea2152e74aa
msgctxt "hbd1f4d6bg725fg4f16g9252g7da7b6a8e95f"
msgid "You better do what he says, boy."
msgstr "시키는 대로 하는 게 좋을 거다, 꼬마야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Barth
#. NodeID = ba52a4cd-7fcb-5904-0ce8-cf1c73581375
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:ba52a4cd-7fcb-5904-0ce8-cf1c73581375
msgctxt "hd0e70392g0540g4bd5gb90bg8329a4d689b7"
msgid "Kid's lucky you were here."
msgstr "네 덕에 저 녀석 산 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Meli
#. NodeID = baa17cfd-7f5f-df8d-f0ce-5a9054ab365f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_State_SecondStageDone = False
#.   Object:
#.      - DEN_Thieflings_State_HasStolenLocket(0) = True
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Event_PlayerNotInvolved = True
#.     - DEN_Thieflings_Event_ItemReturned = True
#.   Object:
#.     - DEN_Hideout_Event_TransferLocket(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:baa17cfd-7f5f-df8d-f0ce-5a9054ab365f
msgctxt "h8fd72b62g5d4fg4b7fgb7b0g0f22fdd9af83"
msgid "Here, take it. Not sure why you care so much about it, honestly."
msgstr "자, 가져가. 솔직히 이게 뭐 대단한 거라고 난리인지 모르겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Player
#. NodeID = bafd2259-78bd-ab0a-9572-72d8d97e1088
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - TIEFLING(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:bafd2259-78bd-ab0a-9572-72d8d97e1088
msgctxt "hb9dc47d6g0f8cg461eg8784g01fb5d9e6eb3"
msgid "He's a thief. Is it any wonder people think that of us all?"
msgstr "녀석은 도둑질을 했다고. 저러니 우리 모두가 싸잡혀 취급된다는 생각은 들지 않아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Player
#. NodeID = bc036d5a-996d-dc77-761c-a32c0aec533e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(3) = True
#. TagRule: BERSERKER
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:bc036d5a-996d-dc77-761c-a32c0aec533e
msgctxt "h345c69f5g5b38g41d6gb1d3g680fd809cc75"
msgid "<b>I kill meddlers. ARE YOU MEDDLING?</b>"
msgstr "<b>나는 참견쟁이 만나면 쳐죽여. 너도 참견쟁이냐?</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Player
#. NodeID = bc036d5a-996d-dc77-761c-a32c0aec533e
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:bc036d5a-996d-dc77-761c-a32c0aec533e
msgctxt "hbcd00320g597bg498egb5a0ga69242d33e50"
msgid ""
"I like meddlers - they make funny noises when I smash them. <b>Are you a "
"meddler?</b>"
msgstr "난 참견쟁이가 좋아. 박살을 내버릴 때 웃기는 소리를 내지르거든. <b>너도 참견쟁이냐?</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Player
#. NodeID = bd553e68-48bc-e27b-c1a0-ac36f54907f2
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:bd553e68-48bc-e27b-c1a0-ac36f54907f2
msgctxt "h2a14cd10gf656g48bdgabd3gc38d5721bcc3"
msgid "Nobody's hurting the boy - he's free to leave when he wants."
msgstr "아무도 저 꼬마 해꼬지하지 않아. 본인이 원한다면 얼마든지 가도 좋다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Meli
#. NodeID = bf061120-f625-b8df-07a3-a888e48449eb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Thieflings_State_HasStolenLocket(0) = True
#. SetFlags:
#.   Quest:
#.     - HIDDEN_WLD_Boosters.DEN_Thieflings_PersuadedKid(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:bf061120-f625-b8df-07a3-a888e48449eb
msgctxt "h4921b91ag8d61g450agb44cga73c2c3b73a8"
msgid "<i>Fine.</i> I have the stupid amulet. Take it."
msgstr "<i>좋아.</i> 내가 그 멍청한 아뮬렛 갖고 있어. 가져가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Player
#. NodeID = c7b3935f-9297-fd97-bd35-447aa44c8903
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:c7b3935f-9297-fd97-bd35-447aa44c8903
msgctxt "h31a91f36gb6a2g4cddg8803g8b64ce99047f"
msgid "Don't you dare lay a finger on that child."
msgstr "그 애한테 손가락 하나라도 함부로 대지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Meli
#. NodeID = c7db4393-49b1-6295-f03c-b2f17342fb9d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:c7db4393-49b1-6295-f03c-b2f17342fb9d
msgctxt "hc5057a6eg324eg458fg9a6age2335aa0ee3d"
msgid "For the last time, I don't have the stupid thing!"
msgstr "몇 번이나 말하지만, 난 그 바보같은 물건 없다고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Player
#. NodeID = c7f00a75-45ef-0013-6a5a-f3cf8311793f
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - TIEFLING(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:c7f00a75-45ef-0013-6a5a-f3cf8311793f
msgctxt "hd1b5fffbgc39fg4d8eg8bf5g0da66264b98c"
msgid "Just warning. I've dealt with your type before, human."
msgstr "경고하는 거야. 너 같은 부류는 전에도 상대해봤다고, 인간."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Barth
#. NodeID = c8d3bacb-5305-714f-73c6-092aef21530e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:c8d3bacb-5305-714f-73c6-092aef21530e
msgctxt "h46999cfag7abbg452ag9f9cgf4288cd87a14"
msgid "Scram before I give <i>you </i>something to care about."
msgstr "난리가 뭔지 <i>제대로 </i>보여주기 전에 썩 꺼져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Barth
#. NodeID = d0a744ec-6fc3-2b94-cfd3-94bc5b6a1de1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:d0a744ec-6fc3-2b94-cfd3-94bc5b6a1de1
msgctxt "hb3f2754fgfbf1g4c40gac1ag0469cad50340"
msgid "You raise a hand to me, it'd better have steel in it."
msgstr "내게 손 대려거든, 차라리 검 드는 편이 좋을 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Meli
#. NodeID = d1ab391e-781d-c8c3-fed0-320a72228546
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TIEFLING(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:d1ab391e-781d-c8c3-fed0-320a72228546
msgctxt "h7c7e60e7gfaeeg45f6g8065g77d5dc0ed83a"
msgid "These two outsiders are threatening me, Ikaron. Even tails over there!"
msgstr "이 외부인 둘이 절 협박해댔어요, 이카론. 저쪽은 우리랑 동포인데도요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Barth
#. NodeID = d2cf2c91-ca42-6b38-3a7a-703df2dd8372
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:d2cf2c91-ca42-6b38-3a7a-703df2dd8372
msgctxt "hdd7f7e9ag1d3dg4a35g81c1g348cb3438346"
msgid "And you! Stay out of my pockets!"
msgstr "그리고 너! 내 주머니 다신 손 대지 마!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Barth
#. NodeID = d866acd0-4fea-e1aa-2bba-3828ae96e445
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:d866acd0-4fea-e1aa-2bba-3828ae96e445
msgctxt "h9a80937cgc69eg41e9gb531g2c2b9c94035c"
msgid "You little split-tongued freak!"
msgstr "이 혀 갈라진 잡놈 새끼가!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Barth
#. NodeID = daf7ced8-7f11-915f-6901-2bab76dcaf21
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:daf7ced8-7f11-915f-6901-2bab76dcaf21
msgctxt "hfde17347gc019g4539gabc4g5eaea2d1a75e"
msgid "If his parents won't do it, I will."
msgstr "얘 부모가 안 하면, 나라도 해야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Barth
#. NodeID = db2c5542-9ae8-f104-cc19-d673c88ed37d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:db2c5542-9ae8-f104-cc19-d673c88ed37d
msgctxt "hf1c78d8dgdfb8g48f4ga8f1gdd75b52cc817"
msgid "Hand it over or I'll slap the teeth out of your head."
msgstr "내놓지 않으면 네 강냉이를 싹 다 털어버릴 거다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Barth
#. NodeID = dbf1b96d-4390-0727-e88d-8a3b7e7d7699
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:dbf1b96d-4390-0727-e88d-8a3b7e7d7699
msgctxt "hbc09e24dgdc25g4504g84c4g945b49cd39be"
msgid "You don't scare me."
msgstr "내가 쫄 것 같냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Barth
#. NodeID = df6fbd6e-3569-9603-b2fb-83f78b6f3363
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Event_AngeredAdventurer = True
#.   Quest:
#.     - HIDDEN_WLD_Boosters.DEN_Thieflings_PersuadedAdventurer(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:df6fbd6e-3569-9603-b2fb-83f78b6f3363
msgctxt "he2299a1ag97feg4870gbbdcgae1e2fa50b8f"
msgid ""
"You don't understand! The kid stole my locket! He... aw, the hells with this."
msgstr "잘 알지도 못하면서! 이 꼬마가 내 로켓을 훔쳤다고! 이놈은... 아오, 다 집어치워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Barth
#. NodeID = e3a15fb1-7dd2-4b6a-50e8-9e9ea036e169
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:e3a15fb1-7dd2-4b6a-50e8-9e9ea036e169
msgctxt "ha0c39cb8gd419g458cg8f25g28e5491345c7"
msgid "Him, I'll hit once. You won't be so lucky. Get out of the way."
msgstr "쟤는 한 번만 팰 거지만, 넌 그걸로 안 끝난다. 내 앞에서 비켜."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Barth
#. NodeID = e4d0394b-3572-60ad-c35b-b8df609366f3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Event_AngeredAdventurer = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:e4d0394b-3572-60ad-c35b-b8df609366f3
msgctxt "hfe19b564g15e0g4156g8ff2g82036762b947"
msgid "You godsdamned snake!"
msgstr "이 빌어먹을 뱀 같은 놈이!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Meli
#. NodeID = eb47794e-a3f4-dfb8-99f4-0f50ad671b91
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Event_CallGuard = True
#.     - DEN_Thieflings_Event_IntimidationFailed = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:eb47794e-a3f4-dfb8-99f4-0f50ad671b91
msgctxt "hb387fd28gbb7cg4097gb71bgaac91c377077"
msgid "Guards! Help me!"
msgstr "경비병님! 살려주세요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Player
#. NodeID = ee9ce898-9a94-2bca-aeb3-6dfced1c6e15
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:ee9ce898-9a94-2bca-aeb3-6dfced1c6e15
msgctxt "haee63867g2485g4271g8518g1f9b99bda708"
msgid "<i>Keep quiet and watch.</i>"
msgstr "<i>가만히 지켜본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Player
#. NodeID = ef213461-719e-c836-3e09-22fa6c9a61a5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Thieflings_State_HasStolenLocket(3) = True
#. SetFlags:
#.   Object:
#.     - DEN_Thieflings_Event_ReturnedLocket(3) = True
#.     - DEN_Hideout_Event_TransferLocket(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:ef213461-719e-c836-3e09-22fa6c9a61a5
msgctxt "hfc4cfe07g09ddg49ffg94f9gf8ab063c85bf"
msgid "Relax. The boy's good, but I'm better - here's your locket."
msgstr "진정해. 꼬마 솜씨가 괜찮긴 했는데 나보단 못 하더라. 여기 댁 로켓이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Ikaron
#. NodeID = f24ad966-3e38-e7dd-1585-24f9c20c2dab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:f24ad966-3e38-e7dd-1585-24f9c20c2dab
msgctxt "h9b55c8d7g0eacg463dgaec1g3ac3753e1825"
msgid "You're lying. I see it in your face."
msgstr "거짓말이군. 얼굴에 다 보인다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Meli
#. NodeID = f3b05dba-4177-edf4-2502-59315ab3d38a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Thieflings_State_HasStolenLocket(0) = True
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Knows_MeliTalkedAboutHisMother = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:f3b05dba-4177-edf4-2502-59315ab3d38a
msgctxt "h18ae2adfg9acag471aga1cfgd117b4feba3a"
msgid "Just take the damn thing and leave me alone!"
msgstr "그 망할 거나 가져가고 나 좀 그만 괴롭혀!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Barth
#. NodeID = f47ed0e8-77a7-4955-921f-734f5b9ee1aa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:f47ed0e8-77a7-4955-921f-734f5b9ee1aa
msgctxt "h591d2726gd1bcg4123gbd8dgfa86099814de"
msgid "You'll get yours some day. I hope I get to see it."
msgstr "언제고 업보 치르게 될 거다. 그 꼴을 직접 보게 되면 좋겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Ikaron
#. NodeID = f5f74ac6-082c-d8f9-df48-2e66c3903592
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - HIDDEN_WLD_Boosters.DEN_Thieflings_PersuadedKid(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:f5f74ac6-082c-d8f9-df48-2e66c3903592
msgctxt "h59eb906eg2b20g4ce8g99f4g046e22d3c884"
msgid ""
"Child, you promised to stop stealing. You disgrace us all. Give it back."
msgstr "얘야, 다신 도둑질 안 한다고 약속했잖냐. 이건 우리 모두를 욕보이는 거야. 돌려주렴."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Ikaron
#. NodeID = fc7fb9b2-f937-e8e6-4b54-894a997bac48
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_IntimidationFailed = True
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_State_SecondStageDone = True
#.   Object:
#.     - DEN_Thieflings_State_WitnessedArgument(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:fc7fb9b2-f937-e8e6-4b54-894a997bac48
msgctxt "h464b4d3ag13d3g46ceg85ecga6020d2f99f2"
msgid "What's happening here?"
msgstr "무슨 소란이냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Meli
#. NodeID = fd2d54db-5609-2ce2-27a5-39c45dec5f90
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Event_KidGotAway = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:fd2d54db-5609-2ce2-27a5-39c45dec5f90
msgctxt "h73c6f708g5f77g4b38gadd8g43fc8f943d5f"
msgid "See you around."
msgstr "나중에 또 보셔."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer
#. Speaker = Barth
#. NodeID = fd6cbfa9-bed5-7c40-af26-cb315ec63e39
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_RobbedAdventurer:fd6cbfa9-bed5-7c40-af26-cb315ec63e39
msgctxt "h14a45afegb5eag4b82gaad5gbf6eff648c82"
msgid "Poor kid."
msgstr "불쌍한 놈."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainee1
#. Speaker = Umi
#. NodeID = 29089df0-9886-c306-05aa-4e8a41940e78
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_HasMet_Trainee1(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_HasMet_Trainee1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainee1:29089df0-9886-c306-05aa-4e8a41940e78
msgctxt "hb500af13g8cdcg47d9g8fe0gc52d8a79a397"
msgid "Oh! Uh... right. 'Go for the heart.'"
msgstr "아! 어... 그렇지. '심장을 노린다.'"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainee1
#. Speaker = Umi
#. NodeID = 39edb898-ff96-2c0b-9855-3232cf5f7d58
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_HasMet_Trainee1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainee1:39edb898-ff96-2c0b-9855-3232cf5f7d58
msgctxt "h36727544g7235g4e03g9963gdae1c984ac97"
msgid "What? Oh yeah. 'Go for the heart.'"
msgstr "네? 아, 맞다. '심장을 노린다.'"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainee1
#. Speaker = Umi
#. NodeID = 4232f931-2018-6c8d-3ed3-941612555d5c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Trainer_State_TraineesAreScared = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainee1:4232f931-2018-6c8d-3ed3-941612555d5c
msgctxt "hf765520ag975dg4f8dgb850g756d27ee09ef"
msgid "Leave me alone!"
msgstr "건들지 마요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainee2
#. Speaker = Wyll
#. NodeID = 0e12c3e6-cd5d-b678-962d-a388e83adc3f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Trainee2_Event_WyllSpokeInclusionLine = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainee2:0e12c3e6-cd5d-b678-962d-a388e83adc3f
msgctxt "h9ed2ecacg7b9dg4cabg9bd2g47d05cc37178"
msgid ""
"Don't push it, kid. If you see trouble, then run. Only fight if you have to."
msgstr "아서렴, 얘야. 상황이 심상찮으면, 도망을 쳐. 어쩔 수 없을 때만 싸우고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainee2
#. Speaker = Ide
#. NodeID = 1275377d-ec97-276f-d77f-b0433049b64d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_HasMet_Trainee2(1) = False
#.   Global:
#.      - DEN_Thieflings_Trainee2_Event_WyllSpokeInclusionLine = False
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_HasMet_Trainee2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainee2:1275377d-ec97-276f-d77f-b0433049b64d
msgctxt "hf980e0d0g9f93g4790g917bgb4a47bdd2eff"
msgid "Next time the goblins come, I'll be ready."
msgstr "다음에 고블린이 쳐들어오면, 저는 준비됐을 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainee2
#. Speaker = Ide
#. NodeID = 31d5f78d-2c30-a6cc-ab43-0be10ec6e241
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_HasMet_Trainee2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainee2:31d5f78d-2c30-a6cc-ab43-0be10ec6e241
msgctxt "h378bebdeg6219g4faeg8948gc6903d3199a2"
msgid "Next time, I'm fighting too, no matter what Asharak says."
msgstr "다음엔 나도 싸울 거예요. 아샤라크가 뭐라든 상관없이요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainee2
#. Speaker = Ide
#. NodeID = 5ab67b7a-3705-be96-1ac8-4799931fb2b4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_HasMet_Trainee2(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_HasMet_Trainee2(1) = True
#. TagRule: WYLL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainee2:5ab67b7a-3705-be96-1ac8-4799931fb2b4
msgctxt "h87ddfc1fge296g479bgb8b4g86a47b4f3013"
msgid "The Blade of Frontiers! I heard you got those goblins good."
msgstr "변경의 칼날이다! 고블린들한테 본때를 보여줬다고 들었어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainee2
#. Speaker = Ide
#. NodeID = 5ab67b7a-3705-be96-1ac8-4799931fb2b4
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_HasMet_Trainee2(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_HasMet_Trainee2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainee2:5ab67b7a-3705-be96-1ac8-4799931fb2b4
msgctxt "hfed1e47ag5a54g4fdeg9909g9496b1a36f18"
msgid "Next time the goblins come, I'll be ready."
msgstr "다음에 고블린이 쳐들어오면, 저는 준비됐을 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainee2
#. Speaker = Wyll
#. NodeID = ce642e02-5e52-00f2-a6a8-d080ffd69f23
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Trainee2_Event_WyllSpokeInclusionLine = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainee2:ce642e02-5e52-00f2-a6a8-d080ffd69f23
msgctxt "h1cf3a97cge9f4g4b45g8c97g79ea499bf308"
msgid ""
"Don't push it, kid. If you see trouble, then run. Only fight if you have to."
msgstr "아서렴, 얘야. 상황이 심상찮으면, 도망을 쳐. 어쩔 수 없을 때만 싸우고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainee2
#. Speaker = Ide
#. NodeID = eef9bf1c-6e87-0130-b7f6-35ba99ed13b8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Trainer_State_TraineesAreScared = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainee2:eef9bf1c-6e87-0130-b7f6-35ba99ed13b8
msgctxt "h1342b18ag69acg4e0eg89bdg9860b24fef84"
msgid ""
"You think we're not tough enough to defend ourselves? I've been training for "
"<i>days</i>!"
msgstr "우리가 제 몸 하나 제대로 못 지킬 줄 알아요? 난 며칠 동안이나 훈련했다고요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainee2
#. Speaker = Ide
#. NodeID = f0efb06e-5772-5b92-dcda-5da725bbb3cd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_HasMet_Trainee2(1) = True
#.   Global:
#.      - DEN_Thieflings_Trainee2_Event_WyllSpokeInclusionLine = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainee2:f0efb06e-5772-5b92-dcda-5da725bbb3cd
msgctxt "hef81550ag913eg4ee7ga046g14e44477fcf8"
msgid "I'm fighting next time, no matter what Asharak says."
msgstr "다음엔 나도 싸울 거예요. 아샤라크가 뭐라든 상관없이요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainee3
#. Speaker = Gan
#. NodeID = 34317e06-107e-4710-da77-a98233ad1bbd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_HasMet_Trainee3(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_HasMet_Trainee3(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainee3:34317e06-107e-4710-da77-a98233ad1bbd
msgctxt "he16e59ffgccdcg478bg8b04gd5c1f8dca70c"
msgid "This is boring. We should train against real goblins!"
msgstr "이거 지루해. 훈련은 진짜 고블린들 상대로 해야 되는데!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainee3
#. Speaker = Gan
#. NodeID = 684bed23-1d01-92a6-f644-441493fb467d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_HasMet_Trainee3(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainee3:684bed23-1d01-92a6-f644-441493fb467d
msgctxt "h679cd5b5gc06cg44c9gb4f5g92fcae6287d0"
msgid "Bring me a goblin! I'm gonna gut it!"
msgstr "고블린을 데려와! 내가 도륙낼 거야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainee3
#. Speaker = Gan
#. NodeID = b543a716-3e18-c53d-d6ad-0e6a9278a402
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Trainer_State_TraineesAreScared = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainee3:b543a716-3e18-c53d-d6ad-0e6a9278a402
msgctxt "h69133830g5597g4aacga2e3gadedbfedf0ec"
msgid ""
"You're wrong! I'm not going to get killed! Not by stupid goblins, not by "
"anyone!"
msgstr "당신은 틀렸어! 난 죽지 않을 거야! 멍청한 고블린한테든, 그 누구한테든!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer
#. Speaker = Asharak
#. NodeID = 1bb82fb4-ea18-d879-6a0b-d559cb079474
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Trainer_State_ScaredTrainees(1) = False
#.   Global:
#.      - DEN_Trainer_State_TraineesAreScared = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer:1bb82fb4-ea18-d879-6a0b-d559cb079474
msgctxt "h06e02696gfcebg47dfga72eg863940057b25"
msgid "Not now, sorry. I have to comfort these little warriors."
msgstr "나중에 얘기하지. 지금은 이 꼬마 전사들을 위로해야 하거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer
#. Speaker = Asharak
#. NodeID = 1c66f64a-a873-3782-bd8a-a27db56d88ff
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Trainer_State_InspiredTrainees(1) = False
#.   Global:
#.      - DEN_Trainer_State_ChildrenWereInspired = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer:1c66f64a-a873-3782-bd8a-a27db56d88ff
msgctxt "h9f09ae21g6264g4458g8c58g961bbe0dbc1f"
msgid "Fierce little fighters, aren't they?"
msgstr "제법 사나운 꼬마 전사들이지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer
#. Speaker = Asharak
#. NodeID = 1f233921-6d46-21f4-6fb7-369e4c6968a1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Trainer_State_SpokeOfBloodAndGlory(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Trainer_State_ScaredTrainees(1) = True
#.   Global:
#.     - DEN_Trainer_State_ChildrenWereScared = True
#.     - DEN_Trainer_State_TraineesAreScared = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer:1f233921-6d46-21f4-6fb7-369e4c6968a1
msgctxt "h4a91e0e2g2b7eg4ea0gb8e8g81d392bacc62"
msgid "Good job. Now they're even more scared."
msgstr "참 잘했군. 덕분에 애들이 더 겁먹었잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer
#. Speaker = Asharak
#. NodeID = 28d831a6-344a-0a6d-15e9-2fc3e6898d05
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer:28d831a6-344a-0a6d-15e9-2fc3e6898d05
msgctxt "ha07809f0g5536g4cd9g98bagd3a038793275"
msgid "A warrior like you could lift their spirits."
msgstr "댁 같은 전사라면 저 애들의 기운을 차릴 수 있을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer
#. Speaker = Player
#. NodeID = 2e5ea1dc-4212-69e2-62af-4acdecaf08f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer:2e5ea1dc-4212-69e2-62af-4acdecaf08f8
msgctxt "h8a5a1c91gf1b7g4ed9g9744g3d0baebb17d3"
msgid ""
"I'll lift their spirits by wiping out that whole camp of goblins by myself."
msgstr "내가 고블린 야영지를 싹 쓸어버릴 거니 애들 기운은 걱정 안 해도 돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer
#. Speaker = Player
#. NodeID = 32b90d73-56ed-d537-7171-73a818bdc0e1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SELDARINEDROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer:32b90d73-56ed-d537-7171-73a818bdc0e1
msgctxt "hf4294048g42beg4e06g8a4cg40c28fffbd00"
msgid ""
"You must outsmart and outmanoeuvre. Your greatest weapon is your cunning!"
msgstr "상대보다 한 수 앞서고 허를 찔러버려. 교묘함이야말로 너희의 가장 큰 무기야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer
#. Speaker = Player
#. NodeID = 38f58645-07fe-14ff-2fab-bc44a5dee131
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - LAEZEL(1) = True
#.      - REALLY_LAEZEL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer:38f58645-07fe-14ff-2fab-bc44a5dee131
msgctxt "h457e4b51g3e0ag4ddcgbae7g421c892fb163"
msgid "I slit my own cousin's throat and tasted her blood."
msgstr "난 내 사촌의 목을 베고 그년의 피를 맛봤다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer
#. Speaker = Asharak
#. NodeID = 3ae41f76-ffb2-8614-ccb2-db1b95a37de5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Wyll_State_TrainingChildren = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer:3ae41f76-ffb2-8614-ccb2-db1b95a37de5
msgctxt "h2c3edb8cgd947g4e39g88d5ge214edd4370d"
msgid "The Blade of Frontiers. What a thrill for the children."
msgstr "변경의 칼날이 납시다니. 아이들이 아주 신이 났어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer
#. Speaker = Asharak
#. NodeID = 4b69d021-ee4e-4d4c-0b3f-b5c10f42447a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Trainer_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer:4b69d021-ee4e-4d4c-0b3f-b5c10f42447a
msgctxt "h089bea69ga74bg4955g845egbf2e3363cd37"
msgid "Can't talk now. The children need me."
msgstr "나중에 얘기하지. 애들을 돌봐야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer
#. Speaker = Player
#. NodeID = 680e572d-42a3-16cb-3948-2ea525713596
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer:680e572d-42a3-16cb-3948-2ea525713596
msgctxt "h9391e391ge014g4b2dga67bg8d5373ad09cc"
msgid "Bad news, children: you're all going to die."
msgstr "나쁜 소식이 있다, 얘들아. 너희 전부 죽을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer
#. Speaker = Player
#. NodeID = 71dab2ae-3653-bba6-81e7-b4cf51e0966d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_Trainer_HasMet(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer:71dab2ae-3653-bba6-81e7-b4cf51e0966d
msgctxt "h1103a165ge7f5g4e87g9deagc87a3d7d3597"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer
#. Speaker = Player
#. NodeID = 72ab4954-533b-de27-a16a-74a7c3cd146d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer:72ab4954-533b-de27-a16a-74a7c3cd146d
msgctxt "h875c7497gbcd2g4a27g9710g7eecff01a6fe"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer
#. Speaker = Asharak
#. NodeID = 76300d11-72ca-d881-da97-3afbd4fde21e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer:76300d11-72ca-d881-da97-3afbd4fde21e
msgctxt "h781d84a1g6577g4527g833eg7c4db5f9693f"
msgid "The goblins will chase us to Baldur's Gate and these kids know it."
msgstr "고블린은 우릴 발더스 게이트까지 끝까지 쫓을 거고, 이 애들도 그걸 알고 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer
#. Speaker = Asharak
#. NodeID = 94c307b4-7c0d-9128-53f2-502977975f2d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Trainer_State_ScaredTrainees(1) = True
#.   Global:
#.      - DEN_Trainer_State_ChildrenWereScared = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer:94c307b4-7c0d-9128-53f2-502977975f2d
msgctxt "h536b6276g7e77g4affgb03fg9dbede909644"
msgid "I think you've inspired them enough today."
msgstr "댁은 애들 그만 다독이는 편이 좋겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer
#. Speaker = Player
#. NodeID = 968bf298-e682-661c-7d5e-96fb73fdf361
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - LAEZEL(1) = True
#.      - REALLY_LAEZEL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer:968bf298-e682-661c-7d5e-96fb73fdf361
msgctxt "h50279d5bg7abag43c2gb3f4gec3349e59c32"
msgid "These hatchlings are weak. Your teachings will fail."
msgstr "이 갓난쟁이들은 약해빠졌어. 네 교육은 헛수고가 될 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer
#. Speaker = Asharak
#. NodeID = 9de21857-f6b9-d935-5b13-bd6c64e0d29a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_Trainer_Event_IncludeTrainee1(1) = True
#.     - DEN_Trainer_Event_IncludeTrainee2(1) = True
#.     - DEN_Trainer_Event_IncludeTrainee3(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer:9de21857-f6b9-d935-5b13-bd6c64e0d29a
msgctxt "h60779ae7g90f2g4d16ga8c2g36b96ae17fc6"
msgid "I saw you at the gates. You fight well."
msgstr "관문에서 그쪽을 봤어. 잘 싸우더군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer
#. Speaker = Asharak
#. NodeID = a125925f-8e46-8919-881d-a61783dfded3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer:a125925f-8e46-8919-881d-a61783dfded3
msgctxt "h1a11ab51g9d3ag4b40g9033g86ff4fc73428"
msgid "It's that or teach them to beg for their lives."
msgstr "이러지 않으면 목숨 구걸하는 법이나 가르쳐야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer
#. Speaker = Asharak
#. NodeID = a1716a46-a7d7-8c2f-1c2b-6f9a8e7c08fb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - LAEZEL(1) = True
#.      - REALLY_LAEZEL(1) = True
#. SetFlags:
#.   Global:
#.     - DEN_Trainer_Event_CheckChildrenInclusions = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer:a1716a46-a7d7-8c2f-1c2b-6f9a8e7c08fb
msgctxt "h75d95181g1e79g415bg9d5eg086369125a47"
msgid "A few words for the kids? Spare a story or two?"
msgstr "애들에게 조언 좀 해주겠나? 이야기 한둘도 괜찮고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer
#. Speaker = Player
#. NodeID = a9529b61-35aa-1d3c-3049-dff4e9cfa599
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_Trainer_State_SpokeOfBloodAndGlory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer:a9529b61-35aa-1d3c-3049-dff4e9cfa599
msgctxt "h59e0d4e3g1f5ag4143g9ed8gc0fa0608c22b"
msgid "Soak the battlefield with blood. Do not resist death, but embrace it!"
msgstr "전장을 피로 물들여. 죽음을 거부하지 말고, 받아들이는 거야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer
#. Speaker = Asharak
#. NodeID = aa32c6a7-636a-9478-743d-e3c02e681eed
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_Trainer_State_ScaredTrainees(1) = True
#.   Global:
#.     - DEN_Trainer_State_ChildrenWereScared = True
#.     - DEN_Trainer_State_TraineesAreScared = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer:aa32c6a7-636a-9478-743d-e3c02e681eed
msgctxt "h12cbb6aeg6834g4017g8868gd8a51d421494"
msgid "Good job. Little ears hear far - I better take care of this."
msgstr "참 잘했군. 어려도 귀는 밝다고. 애들을 달래야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer
#. Speaker = Asharak
#. NodeID = abc68455-4a78-4484-a06c-e97de959f255
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Trainer_Event_CheckChildrenInclusions = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer:abc68455-4a78-4484-a06c-e97de959f255
msgctxt "ha0cdd819g61d8g46a4gb3b0g3297dd0a0f7f"
msgid "A few words for the kids? Spare a story or two?"
msgstr "애들에게 조언 좀 해주겠나? 이야기 한둘도 괜찮고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer
#. Speaker = Player
#. NodeID = ae551378-68f4-c26e-fdb3-874ac50b06c5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - LAEZEL(1) = True
#.      - REALLY_LAEZEL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer:ae551378-68f4-c26e-fdb3-874ac50b06c5
msgctxt "h6527b98eg4c37g404dga43agf742ea813af3"
msgid ""
"I once sliced out a scavver's eye and ate it whole - and not out of hunger."
msgstr "난 스캐버의 눈알을 도려내 통째로 먹어치웠다. 배고파서 그런 것도 아니었지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer
#. Speaker = Player
#. NodeID = afbe2112-640a-d88d-cb33-9179f18bb56e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer:afbe2112-640a-d88d-cb33-9179f18bb56e
msgctxt "ha468318cgfca9g4dbdga466g50536ac61766"
msgid "They're just children - why are you teaching them to fight?"
msgstr "얘네는 어린애잖아. 왜 애들한테 싸움을 가르치는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer
#. Speaker = Asharak
#. NodeID = b79ed12d-3d5c-265c-3aff-717e7a82a151
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_Trainer_State_InspiredTrainees(1) = True
#.   Global:
#.     - DEN_Trainer_State_ChildrenWereInspired = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer:b79ed12d-3d5c-265c-3aff-717e7a82a151
msgctxt "h40605d61gf5d6g49b7ga24bgaa46915151a9"
msgid "Thanks. I prefer when they smile."
msgstr "고마워. 애들이 웃으니 한결 낫군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer
#. Speaker = Player
#. NodeID = b9982442-823c-b3c6-d52b-74fa03675884
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - FIGHTER(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer:b9982442-823c-b3c6-d52b-74fa03675884
msgctxt "hfd839e5ag3707g4f66g8289ga63c3cf1d5db"
msgid "After great adversity comes triumph. Honour and glory!"
msgstr "큰 역경 뒤엔 누릴 승리가 있는 법이란다. 명예와 영광이 말이지!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer
#. Speaker = Wyll
#. NodeID = bdb50092-21d9-bf50-5690-f4db8df97d03
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Trainer_State_WyllPresent = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer:bdb50092-21d9-bf50-5690-f4db8df97d03
msgctxt "h2cc0bf37gd5c6g4793gb39cg17cee243ec65"
msgid "They're tough kids. Smart, too. The future's in good hands."
msgstr "강인한 아이들이야. 또 영리하고. 앞날이 든든하겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer
#. Speaker = Player
#. NodeID = c215887a-bfd5-4aec-50d9-dec830ff3cd0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer:c215887a-bfd5-4aec-50d9-dec830ff3cd0
msgctxt "h5da6f3abg7584g4232g9ff4g41d147506d45"
msgid "Be strong and watch over your kin. In trust there is victory!"
msgstr "강해져서 너희 동족들을 보살펴 내. 서로 신뢰하면 승리해낼 수 있어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer
#. Speaker = Player
#. NodeID = d5127a13-5260-2725-4de1-e596fa66bd8f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer:d5127a13-5260-2725-4de1-e596fa66bd8f
msgctxt "h45ba35b6g3c89g4e82gb4f3g18b10b165bfa"
msgid ""
"I will rip off a horrid mind flayer's head and gift it to my Lich Queen!"
msgstr "난 흉악한 마인드 플레이어의 머리를 따 리치 여왕께 헌정하고야 말 거다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer
#. Speaker = Asharak
#. NodeID = e44757cc-7f45-51f6-e61c-1afd2e5471f7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Trainer_State_InspiredTrainees(1) = True
#.   Global:
#.      - DEN_Trainer_State_ChildrenWereInspired = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer:e44757cc-7f45-51f6-e61c-1afd2e5471f7
msgctxt "h91b7cb7fgdad8g4715g9c35ge54c2e8736aa"
msgid "Look at them beaming. You did that."
msgstr "저 밝은 모습 좀 봐. 댁 덕분이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer
#. Speaker = Asharak
#. NodeID = e4655319-2a9b-0441-dc68-f7f012971d6c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer:e4655319-2a9b-0441-dc68-f7f012971d6c
msgctxt "h18984d10g0ad9g4f5dg9215g0becd3aab8f2"
msgid "I don't think..."
msgstr "그건 별로…"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer
#. Speaker = Asharak
#. NodeID = e77d1940-b9da-67db-5cc3-a27d5b9dae72
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Trainer_State_ScaredTrainees(1) = False
#.   Global:
#.      - DEN_Trainer_State_ChildrenWereScared = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer:e77d1940-b9da-67db-5cc3-a27d5b9dae72
msgctxt "h15b812fdg74ddg443agb2afgdfaf399045c2"
msgid "Not now, sorry. I have to comfort these little warriors."
msgstr "나중에 얘기하지. 지금은 이 꼬마 전사들을 위로해야 하거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer
#. Speaker = Player
#. NodeID = f0c085ac-a9f1-4b2a-559b-b2508920e718
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer:f0c085ac-a9f1-4b2a-559b-b2508920e718
msgctxt "hb8b48cf6g4890g451cg8e1cg3a08c3122cd8"
msgid "You're just going to get them killed - probably by each other."
msgstr "이건 애들을 죽게 만들 뿐이라고. 서로 해치는 꼴 날 수도 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer
#. Speaker = Player
#. NodeID = f35c71ea-dd64-aa44-e71e-7f04c47cd0df
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer:f35c71ea-dd64-aa44-e71e-7f04c47cd0df
msgctxt "h84075023gece9g4d3fg8857gdae2a2dd4f86"
msgid ""
"I crawled inside a red dragon's corpse to stay warm among the Tears of "
"Selûne."
msgstr "셀루네의 눈물에서는 체온을 유지하기 위해 레드 드래곤의 시체 속에 들어간 적도 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer
#. Speaker = Asharak
#. NodeID = fb2651e7-b6f1-83a3-51bf-52f2a0316c8f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Trainer_HasMet(1) = False
#.   Tag:
#.      - AVATAR(1) = False
#.      - WYLL(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Trainer_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer:fb2651e7-b6f1-83a3-51bf-52f2a0316c8f
msgctxt "heafb4f1dg1c9eg497cga4bfgeeec9c023888"
msgid "Thanks for spending time with the kids. I just wish... well. Thanks."
msgstr "애들한테 시간 할애해줘서 고맙네. 난 그저... 음. 고마워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer
#. Speaker = Asharak
#. NodeID = feac1ebc-c821-4713-6942-64a7086a3d30
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Trainer_HasMet(1) = True
#.   Tag:
#.      - AVATAR(1) = False
#.      - WYLL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Trainer:feac1ebc-c821-4713-6942-64a7086a3d30
msgctxt "h4f75afd8g8eeag4697gabdcg33c35e838706"
msgid "Can't talk now. The children need me."
msgstr "나중에 얘기하지. 애들을 돌봐야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_VB_FoundStolenGoods
#. Speaker = Player
#. NodeID = 0a34a2d8-22a6-29d9-e842-4073c3d01180
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_VB_FoundStolenGoods:0a34a2d8-22a6-29d9-e842-4073c3d01180
msgctxt "h7ea1537cgaec9g481ag9d23g68d735eaf91e"
msgid "Wait. This looks familiar."
msgstr "잠깐만. 이거 어디서 본 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ThingLikeMe_AD_TieflingKid004
#. Speaker = Zaki
#. NodeID = 5e9095c5-e293-98eb-96f0-e8f6aceb27e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ThingLikeMe_AD_TieflingKid004:5e9095c5-e293-98eb-96f0-e8f6aceb27e7
msgctxt "he6343a47g124dg4185gb9ebgac75aa9a42fb"
msgid "Wait 'til Mol hears about <i>this</i>."
msgstr "몰한테도 <i>꼭</i> 말해 줘야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ThingLikeMe_AD_TieflingKid004
#. Speaker = Zaki
#. NodeID = 85ec4f17-4c5c-53de-ca71-edad82498068
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_ThingLikeMe_Event_KidSaidZorru(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ThingLikeMe_AD_TieflingKid004:85ec4f17-4c5c-53de-ca71-edad82498068
msgctxt "h2d3e5401g80d5g40f0gaf9fgc8552620c667"
msgid "You're one of those toad-people Zorru saw!"
msgstr "네가 그 조르가 봤다던 두꺼비 인간들 중 하나인가!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ThingLikeMe_AD_ZorruGuard
#. Speaker = Zorru
#. NodeID = 0f9c189f-e66c-e2b9-e221-4a9a2907541a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ThingLikeMe_AD_ZorruGuard:0f9c189f-e66c-e2b9-e221-4a9a2907541a
msgctxt "h7211dc47g6766g4fefgb77bge35f242c0f4a"
msgid "I won't rest. Not while those yellow freaks are after me."
msgstr "쉬지 않을 거야. 그 노란 괴물 자식들이 나를 쫓고 있으니 쉴 수 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ThingLikeMe_AD_ZorruGuard
#. Speaker = Zorru
#. NodeID = 1f478671-ac19-8c26-7fda-2f4de8d5419a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 666be863-dced-2246-7d8f-54ad447f5508_a = False
#. SetFlags:
#.   Local:
#.     - 666be863-dced-2246-7d8f-54ad447f5508_a = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ThingLikeMe_AD_ZorruGuard:1f478671-ac19-8c26-7fda-2f4de8d5419a
msgctxt "h07bbc7a4g78cbg40baga6a8gf08877427e6b"
msgid "Any sign of those brutes?"
msgstr "그 괴물 같은 놈들이 또 나타나지는 않던가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ThingLikeMe_AD_ZorruGuard
#. Speaker = Zorru
#. NodeID = 7a9c320f-c982-0c16-421b-5a43f18cb2d9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 666be863-dced-2246-7d8f-54ad447f5508_a = True
#.      - 666be863-dced-2246-7d8f-54ad447f5508_b = False
#. SetFlags:
#.   Local:
#.     - 666be863-dced-2246-7d8f-54ad447f5508_b = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ThingLikeMe_AD_ZorruGuard:7a9c320f-c982-0c16-421b-5a43f18cb2d9
msgctxt "h2e203cfdg42d7g4dceg8526g2056eeec1bd8"
msgid "Those toad-things're coming. I'm sure of it."
msgstr "그 두꺼비같이 생긴 것들이 쳐들어올 거야. 확실해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ThingLikeMe_AD_ZorruGuard
#. Speaker = Zorru
#. NodeID = 8d64296d-d13c-c6eb-29be-a0492f1320c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ThingLikeMe_AD_ZorruGuard:8d64296d-d13c-c6eb-29be-a0492f1320c4
msgctxt "h0ac48075g80b1g488bg9670gf415bcfde0ed"
msgid "I know what I saw. Saw 'em gut Yul. And they'll come gut me too."
msgstr "내 눈으로 봤다고. 그 놈들이 율의 배를 갈라버리는 걸 봤어. 나도 죽이러 오겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ThingLikeMe_AD_ZorruGuard
#. Speaker = Eramas
#. NodeID = a7a00e77-d2c3-b8ba-b914-6fe23fdb0417
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ThingLikeMe_AD_ZorruGuard:a7a00e77-d2c3-b8ba-b914-6fe23fdb0417
msgctxt "hd3b3527eg99acg45bdg99eeg6db6844c9118"
msgid "You sure you're remembering right?"
msgstr "제대로 기억하고 있는 게 맞아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ThingLikeMe_AD_ZorruGuard
#. Speaker = Zorru
#. NodeID = b1d93c99-7d47-b474-c3d7-cbeef9a6b6fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ThingLikeMe_AD_ZorruGuard:b1d93c99-7d47-b474-c3d7-cbeef9a6b6fd
msgctxt "h409bd96cg3e98g4d7fgb60bg577d8ec73f65"
msgid ""
"Just wait 'til you see 'em. Yellow all over. Covered in spots. No noses to "
"speak of."
msgstr "보면 바로 알 거야. 온통 노란색에 점으로 뒤덮여 있지. 게다가 코는 안 달려있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ThingLikeMe_AD_ZorruGuard
#. Speaker = Zorru
#. NodeID = d57f2005-67fb-53d9-75cf-7ead3fc5b527
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 666be863-dced-2246-7d8f-54ad447f5508_a = False
#.     - 666be863-dced-2246-7d8f-54ad447f5508_b = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ThingLikeMe_AD_ZorruGuard:d57f2005-67fb-53d9-75cf-7ead3fc5b527
msgctxt "hdf42b193g43bfg4254g863bgfcefa014ae28"
msgid "Be on the lookout for those... things."
msgstr "그... 괴물 놈들 조심하라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ThingLikeMe_AD_ZorruGuard
#. Speaker = Eramas
#. NodeID = de2ea94d-835e-a47d-75c4-bf541f37e42d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ThingLikeMe_AD_ZorruGuard:de2ea94d-835e-a47d-75c4-bf541f37e42d
msgctxt "h5e173883gfc7dg412bgae68g22cf1f8fd031"
msgid "You're tense, Zorru. Maybe you should rest a while."
msgstr "너 긴장하잖아, 조르. 잠시 쉬는 게 어때."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ThingLikeMe_AD_ZorruGuard
#. Speaker = Eramas
#. NodeID = fbe8c7a9-b85a-e4a2-23d1-d64e29b8a568
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ThingLikeMe_AD_ZorruGuard:fbe8c7a9-b85a-e4a2-23d1-d64e29b8a568
msgctxt "hacf3ab11g6617g474fga29bg65c0c6656d7a"
msgid "No, Zorru. Not a one."
msgstr "아니, 조르. 전혀 안 보였어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ThingLikeMe_PAD_AfterKid
#. Speaker = Lae'zel
#. NodeID = b20bc087-6620-42fc-12fe-826667e78f64
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ThingLikeMe_PAD_AfterKid:b20bc087-6620-42fc-12fe-826667e78f64
msgctxt "hf422f54fg932dg4bd1ga32dga14cf87e8bae"
msgid "This Zorru has encountered githyanki. I must find and question him."
msgstr "이 조르라는 자가 기스양키를 만났다. 난 그를 찾아서 심문해야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_ComposingSong
#. Speaker = Alfira
#. NodeID = 02168f84-5a66-7447-77e7-eea29915f1b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_ComposingSong:02168f84-5a66-7447-77e7-eea29915f1b1
msgctxt "h899c68adgebc6g451bg87a3gf3415dfe69af"
msgid "Oh, that works! Maybe?"
msgstr "괜찮네! 아마도?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_ComposingSong
#. Speaker = Alfira
#. NodeID = 0e902a43-86df-e621-f65e-70fe2dee7f44
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_ComposingSong:0e902a43-86df-e621-f65e-70fe2dee7f44
msgctxt "h293ce5d2g68b6g4591gac73g33882ecf0ca6"
msgid "Does that fit?"
msgstr "어울려요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_ComposingSong
#. Speaker = Alfira
#. NodeID = 157c3f6a-c8c9-6120-1d66-4540a96fbec9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 00cbc209-8ead-67a1-475a-95f3fa058ff4_SongFlow1 = True
#. SetFlags:
#.   Local:
#.     - 00cbc209-8ead-67a1-475a-95f3fa058ff4_SongFlow2 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_ComposingSong:157c3f6a-c8c9-6120-1d66-4540a96fbec9
msgctxt "h94bdc7fcg3198g47dbg8de5g4b0dede6f250"
msgid "<i>When you call the last light...</i>"
msgstr "<i>최후의 빛 부르면...</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_ComposingSong
#. Speaker = Alfira
#. NodeID = 342e17f0-ae9b-a291-fd4b-f06c6959df8d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_ComposingSong:342e17f0-ae9b-a291-fd4b-f06c6959df8d
msgctxt "h30bd069ag3250g4124ga5a7g109acdeff59f"
msgid "Nope. That's awful."
msgstr "아냐, 최악이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_ComposingSong
#. Speaker = Alfira
#. NodeID = 3645f341-9019-f353-8a70-75ce94eac813
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 00cbc209-8ead-67a1-475a-95f3fa058ff4_SongFlow2 = True
#. SetFlags:
#.   Local:
#.     - 00cbc209-8ead-67a1-475a-95f3fa058ff4_SongFlow2 = False
#.     - 00cbc209-8ead-67a1-475a-95f3fa058ff4_SongFlow1 = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_ComposingSong:3645f341-9019-f353-8a70-75ce94eac813
msgctxt "h5b5d1491g6535g4407ga1b2g195dc1141170"
msgid "<i>Words of mine will turn...</i>"
msgstr "<i>나의 말은...</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_ComposingSong
#. Speaker = Alfira
#. NodeID = 4bce4b9c-2c61-99ed-04a8-269814fbf7c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_ComposingSong:4bce4b9c-2c61-99ed-04a8-269814fbf7c8
msgctxt "hc1f7bbbdg0434g4e8bga502g6395825af9bd"
msgid "Damn it."
msgstr "젠장."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_ComposingSong
#. Speaker = Alfira
#. NodeID = 88c35c17-136a-08df-f702-a328f5ebd965
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 00cbc209-8ead-67a1-475a-95f3fa058ff4_SongFlow1 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_ComposingSong:88c35c17-136a-08df-f702-a328f5ebd965
msgctxt "h8255f30cgc3ecg4cf0g9a08g738e6522ab3f"
msgid "<i>Moon. Sun. All remind me...</i>"
msgstr "<i>달. 태양. 모든 것이...</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_ComposingSong
#. Speaker = Alfira
#. NodeID = edb8e3e2-4304-f477-f132-406d6b78e276
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_ComposingSong:edb8e3e2-4304-f477-f132-406d6b78e276
msgctxt "h1dffbf6bg3c72g43b0ga11ag758ee3630245"
msgid "<i>Urgh.</i> I don't know anymore."
msgstr "<i>으으.</i> 이제 몰라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_ComposingSong
#. Speaker = Alfira
#. NodeID = ff90a977-cd99-e9cc-e7b9-b89b330d0d7b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_ComposingSong:ff90a977-cd99-e9cc-e7b9-b89b330d0d7b
msgctxt "hf8552e51g9ea5g488bgb22bgb524f67d1126"
msgid "No. That doesn't work."
msgstr "아냐. 별로야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_Dejected
#. Speaker = Alfira
#. NodeID = 54be7308-474b-3e82-2b45-c6132b4a5311
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - a0afae3d-53b0-192d-d822-c61da104f979_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_Dejected:54be7308-474b-3e82-2b45-c6132b4a5311
msgctxt "h9a70bf19gfeebg465bg8a07g6ab0f399831a"
msgid "There's no point - <i>damn it</i>."
msgstr "의미 없다고. <i>젠장</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_Dejected
#. Speaker = Alfira
#. NodeID = 6ba75957-b8c3-7cf0-3018-20f5f6503908
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - a0afae3d-53b0-192d-d822-c61da104f979_A = True
#. SetFlags:
#.   Local:
#.     - a0afae3d-53b0-192d-d822-c61da104f979_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_Dejected:6ba75957-b8c3-7cf0-3018-20f5f6503908
msgctxt "h07592149g24bfg4006gbd54g6f31e00d927b"
msgid "Gods, why did I even bother?"
msgstr "정말 애쓸 필요가 있나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_Dejected
#. Speaker = Alfira
#. NodeID = 89958b80-26d3-6444-972b-fdddefb2b6cc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - a0afae3d-53b0-192d-d822-c61da104f979_B = True
#. SetFlags:
#.   Local:
#.     - a0afae3d-53b0-192d-d822-c61da104f979_B = False
#.     - a0afae3d-53b0-192d-d822-c61da104f979_A = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_Dejected:89958b80-26d3-6444-972b-fdddefb2b6cc
msgctxt "h77d519deg1f33g4ffdgb135g353530fae0dc"
msgid "I'll never finish her song now..."
msgstr "선생님 노래는 완성 못 하겠지..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_FullSong
#. Speaker = Alfira
#. NodeID = 0d885b01-1117-e9a5-d199-73951151ee93
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_FullSong:0d885b01-1117-e9a5-d199-73951151ee93
msgctxt "hded82848g857eg41d7g948agd5fae14b9755"
msgid "<i>Farewell, my dear old friend.</i>"
msgstr "<i>잘 가요, 소중한 내 친구.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_FullSong
#. Speaker = Alfira
#. NodeID = 245fd0f7-ad34-cd70-aff5-2190cb10789a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_FullSong:245fd0f7-ad34-cd70-aff5-2190cb10789a
msgctxt "h8f7bcc67g60b6g4b34ga6f0gcd9b9c8c11a9"
msgid "<i>All the love I can't repay.</i>"
msgstr "<i>갚지 못할 그 사랑이.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_FullSong
#. Speaker = Alfira
#. NodeID = 41e97798-9fe3-74df-0cbf-6a377707eea2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_FullSong:41e97798-9fe3-74df-0cbf-6a377707eea2
msgctxt "h6b717c22g9012g42f1g8eb0g01b06dc9a5a5"
msgid "<i>Words of mine will turn to ash.</i>"
msgstr "<i>내 말은 재가 되고</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_FullSong
#. Speaker = Alfira
#. NodeID = 5434f32b-d6b9-048a-8485-b1a75b37295a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_FullSong:5434f32b-d6b9-048a-8485-b1a75b37295a
msgctxt "h5d7247bag3abbg4e4aga6d2g139dc30f7707"
msgid "<i>Moon. Sun. All remind me of your grace.</i>"
msgstr "<i>달도, 해도 그대 선함을 닮았네.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_FullSong
#. Speaker = Alfira
#. NodeID = 5fdcea9c-9869-f71b-a098-04e6be89db5e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_FullSong:5fdcea9c-9869-f71b-a098-04e6be89db5e
msgctxt "h7c649426g015eg4ec2ga7d0ga26f33998a58"
msgid "<i>Faith. Care. All the love I can't repay.</i>"
msgstr "<i>믿음. 배려. 갚지 못할 그 사랑.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_FullSong
#. Speaker = Alfira
#. NodeID = 6b320224-7fd8-eda0-449a-33b7f5ea64d3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_FullSong:6b320224-7fd8-eda0-449a-33b7f5ea64d3
msgctxt "h948d61f7g57b5g4f7cgb4d5g86419e678658"
msgid "<i>Dance upon the stars tonight.</i>"
msgstr "<i>별 위에서 춤을 춰요.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_FullSong
#. Speaker = Alfira
#. NodeID = 74fd4724-91ec-6fd0-19a1-788c73cb34cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_FullSong:74fd4724-91ec-6fd0-19a1-788c73cb34cb
msgctxt "h4c652097geed8g4e8ag955cgaf01ce534893"
msgid "<i>When you call the last light down.</i>"
msgstr "<i>그대 최후의 빛을 기원하면</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_FullSong
#. Speaker = Alfira
#. NodeID = 761f33ad-5235-7835-f00b-5ba9219dc6e0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_FullSong:761f33ad-5235-7835-f00b-5ba9219dc6e0
msgctxt "h265b9f4cg8957g4fd5ga035g0ea9221e3f53"
msgid "<i>Rest and know that I will pray.</i>"
msgstr "<i>편히 쉬기를 기도해</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_FullSong
#. Speaker = Alfira
#. NodeID = 8b377b6a-ab09-7706-49f0-794a87aa1dc7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_FullSong:8b377b6a-ab09-7706-49f0-794a87aa1dc7
msgctxt "h2c0678cbg88acg4e55gadcag6d56f7cd2db6"
msgid "<i>Moon. Sun. All remind me of your grace.</i>"
msgstr "<i>달도, 해도 그대 선함을 닮았네.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_FullSong
#. Speaker = Alfira
#. NodeID = c81125d7-c242-d4b7-dcd4-5547e266dd9d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_FullSong:c81125d7-c242-d4b7-dcd4-5547e266dd9d
msgctxt "h0861be6eg65d8g4ea5gb56agb8c3fa7d1c5b"
msgid "<i>Smile and pain will fade away.</i>"
msgstr "<i>그 미소에 치유되고</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_FullSong
#. Speaker = Alfira
#. NodeID = e3d06ba6-6365-2033-1168-388bb9559df8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_FullSong:e3d06ba6-6365-2033-1168-388bb9559df8
msgctxt "hba1901b8gc6d0g4e26g806egb12d1748d0e1"
msgid "<i>Moon reminds me of your grace.</i>"
msgstr "<i>그 선함을 닮은 달 </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_FullSong
#. Speaker = Alfira
#. NodeID = ee2a096f-2e79-da43-3c78-d0f6f80537fb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_FullSong:ee2a096f-2e79-da43-3c78-d0f6f80537fb
msgctxt "h56940030g1965g451bg8a47g8a7dd8ef33b7"
msgid "<i>Faith. Care. All the love I can't repay.</i>"
msgstr "<i>믿음. 배려. 갚지 못할 그 사랑.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_InstrumentBroken
#. Speaker = Alfira
#. NodeID = 2cd396f2-51dd-7817-6782-12b4837714cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_InstrumentBroken:2cd396f2-51dd-7817-6782-12b4837714cb
msgctxt "he40d9809gfabbg4296ga2e4gcb0962d94c49"
msgid "Don't come near me!"
msgstr "가까이 오지 마!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_InstrumentBroken
#. Speaker = Alfira
#. NodeID = 671587b6-27be-95d7-faaf-591593cf36df
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_InstrumentBroken:671587b6-27be-95d7-faaf-591593cf36df
msgctxt "h1da2dc28g2d17g4d81g8eebg6908403f211e"
msgid "*Sob.*"
msgstr "*흐느낌.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_InstrumentStolen
#. Speaker = Alfira
#. NodeID = d5070d05-37dd-71dd-4c8a-a9d254692b04
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_InstrumentStolen:d5070d05-37dd-71dd-4c8a-a9d254692b04
msgctxt "hca597f96g02cfg4024g82a2ge33694d3b22b"
msgid "Get away from me. I mean it!"
msgstr "가까이 오지 마. 진심이야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_LookingForInstrument
#. Speaker = Alfira
#. NodeID = 438db211-e008-c8cd-5764-ed0850c5b6f1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 57c003e7-0932-6f0c-e655-99025a4abe3a_B = True
#. SetFlags:
#.   Local:
#.     - 57c003e7-0932-6f0c-e655-99025a4abe3a_B = True
#.     - 57c003e7-0932-6f0c-e655-99025a4abe3a_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_LookingForInstrument:438db211-e008-c8cd-5764-ed0850c5b6f1
msgctxt "h3f06e59dg7663g4a94g9e2eg9dab26f71b80"
msgid "No, no, no. It was right <i>here. </i>"
msgstr "안 돼, 안 돼. <i>여기</i> 있었는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_LookingForInstrument
#. Speaker = Alfira
#. NodeID = 70729b0b-4831-419f-00a4-1dd24ad745c7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 57c003e7-0932-6f0c-e655-99025a4abe3a_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_LookingForInstrument:70729b0b-4831-419f-00a4-1dd24ad745c7
msgctxt "h9c1202dbg94cdg40eag9770ge2759dbd0183"
msgid "Where is it?!"
msgstr "어디 있지?!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_TieflingBard_AD_LookingForInstrument
#. Speaker = Alfira
#. NodeID = d42db296-302b-1ada-099c-07e2fa93de95
