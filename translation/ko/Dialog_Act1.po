#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:25ab1f1d-7285-1d09-aab3-1ce452ec7174
msgctxt "h415a3229gbf71g478dgade9g5c4353736dd9"
msgid ""
"*The presence deep in your mind is awake, unblinking. This is it. A single "
"word pervades your consciousness: 'Soon'.*"
msgstr ""
"*당신의 정신 속 깊이 자리잡은 존재가 태연스레 깨어납니다. 올 것이 왔군요. 한 단어가 당신의 의식 속으로 스며듭니다. ‘곧’*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Player
#. NodeID = 2c99fcb7-483b-5dba-684a-d3702af2f5fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:2c99fcb7-483b-5dba-684a-d3702af2f5fc
msgctxt "haf6b6331gb09dg47cag93dcg369ccaece48a"
msgid "Find the nearest stronghold and report on your mission."
msgstr "가장 가까이 있는 요새를 찾아서 너희 임무에 대해 보고하도록."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Player
#. NodeID = 2f4ea23a-4e19-1545-ec1d-edb1b4fbbe03
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:2f4ea23a-4e19-1545-ec1d-edb1b4fbbe03
msgctxt "h0d06eda1g2c56g4ab5gac6dg4e75b569c19e"
msgid "The Absolute has plans for you, child - and they only begin here."
msgstr "절대자님께서 너를 위한 계획을 가지고 계시다, 아이야. 그리고 이곳이 바로 그 시작이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Andrick
#. NodeID = 407891fa-1353-b2ae-6f7c-da469322d54c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - FOR_PriestConqueringGod_Cultists_AwaitingOwlbearCombat(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:407891fa-1353-b2ae-6f7c-da469322d54c
msgctxt "h503461cbgc997g4752g80c2gb74630461b3d"
msgid "I just <i>can't.</i>"
msgstr "그냥 <i>못하겠어요.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Narrator
#. NodeID = 40f7f48b-eb27-3a0c-8f23-fa51c78773f7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:40f7f48b-eb27-3a0c-8f23-fa51c78773f7
msgctxt "ha909dd50g66fag4fdfg828agbf60df0dc0ed"
msgid ""
"*The mark glows, but you feel nothing in response. Your illithid power is "
"beyond reach until you rest.*"
msgstr "*문양이 빛나지만, 어떤 반응도 느껴지지 않습니다. 일리시드 능력을 더 사용하려면 휴식을 취해야 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Andrick
#. NodeID = 43a58d90-e26a-bdb4-0ba2-07c65a213438
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_Owlbear_State_PermaDefeated = True
#.      - FOR_PriestConqueringGod_002_Defeated = True
#. SetFlags:
#.   Object:
#.     - FOR_PriestsConqueringGod_AlliedPlayer(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:43a58d90-e26a-bdb4-0ba2-07c65a213438
msgctxt "h9bb16c93gf915g4f35gbe93gacd133277b4d"
msgid "It... it got her. It got Bry too."
msgstr "그게... 그녀를 죽였어요. 브리도 당했다고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Player
#. NodeID = 48bd631e-ba9f-0a4c-a77c-e9a5d12e4c1c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_PriestOfTheConqueringGod_Cultists_Knows_Mission(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:48bd631e-ba9f-0a4c-a77c-e9a5d12e4c1c
msgctxt "h936ee4f2g4964g41f9g87d4ga2bed20c3df4"
msgid "Resume your duties in the area - whatever those are."
msgstr "뭐였는진 모르겠지만, 이 지역에서 하고 있던 임무를 재개하도록."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Player
#. NodeID = 4c4f8240-1b58-b527-b9ef-d93a4f7c6ecf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_PriestOfTheConqueringGod_Cultists_Knows_Mission(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:4c4f8240-1b58-b527-b9ef-d93a4f7c6ecf
msgctxt "h8e2fa76dg6a02g4a57g9869g5907f07baafc"
msgid "It seems you've found your fugitive - me."
msgstr "너희가 찾던 도망자를 찾은 것 같은데. 그게 나야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Narrator
#. NodeID = 4d7b4d5e-4419-c1e1-eacd-555984ac2450
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount3(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount3(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:4d7b4d5e-4419-c1e1-eacd-555984ac2450
msgctxt "hd82926dcg67c9g4dbcga46cga9fe735a0794"
msgid "*Your mind lurches, reeling suddenly as if... bitten.*"
msgstr "*뭔가에 깨물린 것처럼 느닷없이 정신이 휘청거립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Andrick
#. NodeID = 5dca9113-6e7c-f9db-6f03-3cb2201e3e05
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - FOR_PriestConqueringGod_AtCaveEntrance(0) = True
#. SetFlags:
#.   Global:
#.     - FOR_PriestsConqueringGod_State_ProceedCave = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:5dca9113-6e7c-f9db-6f03-3cb2201e3e05
msgctxt "h921c73a4g9d47g4572g9f01g6bc947d8455a"
msgid "This is it. I guess we... go inside?"
msgstr "여깁니다. 그냥... 들어가면 될까요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Andrick
#. NodeID = 625d4c86-5182-0fb2-64c3-7c5693495fe9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:625d4c86-5182-0fb2-64c3-7c5693495fe9
msgctxt "hf910dd93ge9d4g4627gb3b9ga42370a1a745"
msgid "Thanks."
msgstr "감사합니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Andrick
#. NodeID = 6874ae77-c7f7-76fe-ea93-562f8f3bc5c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:6874ae77-c7f7-76fe-ea93-562f8f3bc5c1
msgctxt "h6bfb94e7gbb93g4009g9ca2g84302181b516"
msgid "Of course, True Soul."
msgstr "물론이죠, 참된 영혼이시여."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Player
#. NodeID = 6a6dcccd-33c2-f4c3-9368-fbc92edd4933
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Absolute_Knows_TrueSoul = False
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = True
#.      - ILLITHID(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:6a6dcccd-33c2-f4c3-9368-fbc92edd4933
msgctxt "h230ece3agb523g474dgbc7eg7d2aee7008c3"
msgid "Move forward. I command it."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Narrator
#. NodeID = 6a7c1a69-ccd8-edf6-a1f6-e65c58490f1a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:6a7c1a69-ccd8-edf6-a1f6-e65c58490f1a
msgctxt "hc39b3ccbgd212g4663gbfb0g3ece9db54216"
msgid "*A shiver runs across your mind... You feel sated.*"
msgstr "*전율이 불현듯 머릿속을 스쳐 지나가고... 만족감이 듭니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Andrick
#. NodeID = 6cad64e6-5913-07f3-a0cc-d9a8073217cd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_PriestConqueringGod_Cultists_AwaitingOwlbearCombat(1) = True
#.      - FOR_Owlbear_Hasmet(1) = False
#.   Global:
#.      - FOR_Owlbear_State_PermaDefeated = False
#. SetFlags:
#.   Object:
#.     - FOR_PriestsConqueringGod_AlliedPlayer(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:6cad64e6-5913-07f3-a0cc-d9a8073217cd
msgctxt "h9aece5d1g30c2g401bgb644g8b15f15cc176"
msgid "Please. I can't go first. I can't."
msgstr "부탁드립니다. 먼저 못 가겠어요. 못하겠습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Andrick
#. NodeID = 7230fe35-d063-156c-f853-49eca79be16a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - WLD_PriestsConqueringGod_GoToGoblinCamp = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:7230fe35-d063-156c-f853-49eca79be16a
msgctxt "h3c36a5ffgc413g46beg8bfage4828b1d490a"
msgid "Right. All right. I'll go."
msgstr "아. 알겠습니다. 갈게요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Andrick
#. NodeID = 779d7882-0f8e-dc78-833c-21961117507d
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:779d7882-0f8e-dc78-833c-21961117507d
msgctxt "h8c83a43dg4c13g49edga4e5g9c1856b795d8"
msgid "Erm. Ma'am."
msgstr "저기. 마님."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Andrick
#. NodeID = 779d7882-0f8e-dc78-833c-21961117507d
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:779d7882-0f8e-dc78-833c-21961117507d
msgctxt "h6068a9b1gd00dg43e4g95e3g66248531cbbc"
msgid "Erm. Sir."
msgstr "저기. 나리."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Andrick
#. NodeID = 779d7882-0f8e-dc78-833c-21961117507d
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:779d7882-0f8e-dc78-833c-21961117507d
msgctxt "ha3ce7dd5gfe22g4ef4g826fg2907a97e943f"
msgid "Erm. True Soul."
msgstr "저기. 진정한 영혼님."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Andrick
#. NodeID = 78f98be5-508e-87b9-be21-fde3c97b95be
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:78f98be5-508e-87b9-be21-fde3c97b95be
msgctxt "h3ec47adfg0edbg4bd8g9be6g289ac957d1cb"
msgid "Please. I can't. I can't go first."
msgstr "제발요. 못하겠어요. 먼저 못 가겠습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Andrick
#. NodeID = 7c2bf396-9019-0b43-c4bc-1e1b9ed5d83d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:7c2bf396-9019-0b43-c4bc-1e1b9ed5d83d
msgctxt "hc392d533g4f10g4d56g899eg17ee57d33d8c"
msgid "I'm not sure I can do this."
msgstr "제가 해낼 수 있을지 모르겠어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Narrator
#. NodeID = 7c484d83-d877-9d36-8794-69abda51f079
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - GLO_TadpoleIntro_NPC(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:7c484d83-d877-9d36-8794-69abda51f079
msgctxt "hd14de932g5dceg41cbg8258g200ae2f1b8e3"
msgid "*As the symbol glows, power courses through you. <i>Authority</i>.*"
msgstr "*문양이 빛나며, 몸에 흐르는 힘이 느껴집니다. <i>권위</i>.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Andrick
#. NodeID = 7fae7690-3f31-80c8-35a0-235d3220a661
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:7fae7690-3f31-80c8-35a0-235d3220a661
msgctxt "h0696ba85g0baeg4fafg996bg7bb320d1d173"
msgid ""
"We were sent to look for fugitives. Some survivors from a crashed ship a "
"ways west along the Chionthar."
msgstr "저희는 도망자들을 수색하기 위해 파견되었습니다. 치온타르 강 서쪽에 추락한 함선의 생존자들이라더군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Player
#. NodeID = 80f199a7-3653-2b12-6a70-16ff476161d9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - RANGER(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:80f199a7-3653-2b12-6a70-16ff476161d9
msgctxt "hef32885eg9835g4cadgb494gbaa7e64e350a"
msgid ""
"Owlbears have vicious tempers - provoke it, and you'll have your opening."
msgstr "아울베어는 성미가 급하지. 그걸 이용하면 기회가 있을 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Andrick
#. NodeID = 8139cd14-4d69-2dac-daf2-058e795c1e35
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:8139cd14-4d69-2dac-daf2-058e795c1e35
msgctxt "h3aec94edg4522g4b08g84e6gca067e2cbfac"
msgid "What now?"
msgstr "이제 어떡하죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Player
#. NodeID = 8c49c6c9-1c9c-bc30-1164-4fa73c0d0e47
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:8c49c6c9-1c9c-bc30-1164-4fa73c0d0e47
msgctxt "h501889c0gc2b9g43bcg9168g0a3eafc95a9e"
msgid "I won't tolerate cowardice. Attack - <i>now.</i>"
msgstr "겁쟁이는 용인하지 않겠다. 공격해. <i>당장.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Andrick
#. NodeID = 91af9307-7c6b-d379-7af1-3f02f0659d16
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_Owlbear_State_PermaDefeated = True
#.      - FOR_PriestConqueringGod_002_Defeated = False
#. SetFlags:
#.   Object:
#.     - FOR_PriestsConqueringGod_AlliedPlayer(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:91af9307-7c6b-d379-7af1-3f02f0659d16
msgctxt "h42f3e793gb017g4696g908eg0220101692c0"
msgid "We survived - I can't believe we survived!"
msgstr "살아남았어, 우리가 살아남다니 믿을 수가 없어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Andrick
#. NodeID = 932f3cee-d54e-3ca8-04a3-137551bdc9c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:932f3cee-d54e-3ca8-04a3-137551bdc9c9
msgctxt "h26d6c2b9g811fg47fdg9b60gf506da2561dc"
msgid "The Absolute wants them found, one way or another."
msgstr "절대자님께서 그들을 찾길 원하세요. 죽었든 살았든 상관없이요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Andrick
#. NodeID = 96356273-623e-0892-32cb-e70c1c84f358
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:96356273-623e-0892-32cb-e70c1c84f358
msgctxt "hc39da1a2g24c9g4a62gba79g73630d20c3be"
msgid ""
"What? <i>You...?</i> But that means... I have to stop you. For the Absolute!"
msgstr "뭐라고요? <i>당신이...?</i> 그렇다는 건... 제가 당신을 막아야 한다는 거군요. 절대자님을 위해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Andrick
#. NodeID = a1c548fc-45b6-c465-58d9-30ee4241c44f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:a1c548fc-45b6-c465-58d9-30ee4241c44f
msgctxt "hbb06666eg310ag4e9agaf3ag26edf8418edf"
msgid "I'm holding..."
msgstr "기다리고 있습니다..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Player
#. NodeID = aff3e7aa-b549-a187-5a67-cdf25c71b2a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:aff3e7aa-b549-a187-5a67-cdf25c71b2a5
msgctxt "h4bce84d6g18c8g4e11ga2d6ge57bac89b74a"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Player
#. NodeID = b5a7fc84-df96-1cea-0034-22a3f99dd6e4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:b5a7fc84-df96-1cea-0034-22a3f99dd6e4
msgctxt "h10c585c4g1ae7g4d74g9d7cg8b201a818281"
msgid "Find the nearest stronghold and report on your mission."
msgstr "가장 가까이 있는 요새를 찾아서 너희 임무에 대해 보고하도록."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Narrator
#. NodeID = b60c75a2-2fd3-83f1-782a-1d5afeb9aad2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount6(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount6(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:b60c75a2-2fd3-83f1-782a-1d5afeb9aad2
msgctxt "h2b5ad815g5b42g4604g96c7g14ff5b9a0e53"
msgid ""
"*Your mind is full, bursting with ecstasy and terror. Finally, it is coming. "
"You are becoming.*"
msgstr "*당신의 정신이 황홀경과 공포로 가득 차오릅니다. 마침내, 때가 됐군요. 당신은 변화 중입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Andrick
#. NodeID = b6c69900-b4df-add5-4712-5b418792ecf8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - WLD_PriestsConqueringGod_GoToGoblinCamp = True
#.   Object:
#.     - FOR_DeathOfATrueSoul_Knows_GoblinCamp(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:b6c69900-b4df-add5-4712-5b418792ecf8
msgctxt "hb580048eg6bdeg4c9eg8033g9b3d525335d5"
msgid ""
"Stronghold. Right. Ed said something about the goblins... Bry will know the "
"way."
msgstr "요새. 그래요. 에드가 고블린에 대해 뭔가 이야기했었어요... 브리가 길을 알 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Player
#. NodeID = bc2d0192-bd0a-cd5a-790a-ab3472f13712
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - RANGER(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:bc2d0192-bd0a-cd5a-790a-ab3472f13712
msgctxt "hfc5b6299g65bbg4bf8g9751g064e5b997a5a"
msgid "Press your advantage now, before the beast smells your fear."
msgstr "지금 습격해야 한다. 저 야수가 네 두려움을 눈치채기 전에 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Player
#. NodeID = bdc763ce-d32f-569d-710d-173b8eb7851b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:bdc763ce-d32f-569d-710d-173b8eb7851b
msgctxt "h4bf747eeg28bcg4736g9318g03ca36d145ae"
msgid "Resume your duties in the area - whatever those are."
msgstr "뭐였는진 모르겠지만, 이 지역에서 하고 있던 임무를 재개하도록."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Player
#. NodeID = be3acd03-e513-3b73-4928-1f305c6f5529
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_PriestOfTheConqueringGod_Cultists_Knows_Mission(1) = False
#. SetFlags:
#.   Dialog:
#.     - FOR_PriestOfTheConqueringGod_Cultists_Knows_Mission(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:be3acd03-e513-3b73-4928-1f305c6f5529
msgctxt "he81b4734gc916g4e6bgaf90gefc46eec0b72"
msgid "What were you doing before the owlbear attacked?"
msgstr "아울베어에게 공격받기 전에는 뭘 하고 있었지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Andrick
#. NodeID = bfb2d99c-9cc7-161b-cb71-70a66ba1984b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:bfb2d99c-9cc7-161b-cb71-70a66ba1984b
msgctxt "h4eccaf9cga038g4a44g8b66gdb1a383d684d"
msgid ""
"You're right... it's just an animal, and we have the Absolute on our side."
msgstr "당신 말이 맞습니다... 그냥 동물일 뿐이에요, 그리고 저희 곁에는 절대자님께서 함께하고 계십니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Andrick
#. NodeID = c1615311-b57d-3600-6178-8744bfe83a5d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:c1615311-b57d-3600-6178-8744bfe83a5d
msgctxt "h3429c184gad3fg496ega1afge461499905b6"
msgid "Of course. If you say so. Erm - where should we go?"
msgstr "물론이죠. 당신이 그렇게 말씀하신다면요. 음... 그런데 어디로 가야 하죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Narrator
#. NodeID = c176088a-1f7b-ba61-2d17-21b6d93d95d2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Tag:
#.     - TRUESOUL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:c176088a-1f7b-ba61-2d17-21b6d93d95d2
msgctxt "hd95ef7c3g41fcg429dgb54dgce4649d17b2d"
msgid ""
"*A shadow swims across your vision, and a familiar voice tells you to be "
"calm. You are loved.*"
msgstr "*그림자가 낀 듯이 눈앞이 흐려지더니, 익숙한 목소리가 당신을 달래줍니다. 사랑이 느껴집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Narrator
#. NodeID = c23c71a0-0589-cbff-d770-6e3bf2873998
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - GLO_TadpoleIntro_NPC(1) = False
#. SetFlags:
#.   User:
#.     - GLO_TadpoleIntro_NPC(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:c23c71a0-0589-cbff-d770-6e3bf2873998
msgctxt "h278c3ff0g166fg4dc2ga7e1g547a2b12d132"
msgid ""
"*A strange symbol glows, marked on their flesh, and something within you "
"stirs in response.*"
msgstr "*그들의 살갗에 새겨진 기묘한 상징이 빛나고, 이에 반응하여 당신 내면의 무언가가 꿈틀거립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Player
#. NodeID = c3f92202-11b6-4014-edca-546e34a3b0ee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:c3f92202-11b6-4014-edca-546e34a3b0ee
msgctxt "h42e64ebfgb974g487cgb6d8gc3e61950e4b3"
msgid "Just hold steady."
msgstr "그냥 가만히 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Andrick
#. NodeID = c4da0e55-9bcf-19af-bfe9-b90b09938c31
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:c4da0e55-9bcf-19af-bfe9-b90b09938c31
msgctxt "hd9049c2fg0412g4d10g8756g577928d8efe7"
msgid "Thank you, True Soul."
msgstr "감사합니다, 참된 영혼이시여."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Andrick
#. NodeID = cb3d213a-f54d-8b9c-d4e0-bb913fa08aad
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_PriestsConqueringGod_Global_ChargeOwlbear = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:cb3d213a-f54d-8b9c-d4e0-bb913fa08aad
msgctxt "h8bd4aab6g338cg4008ga8c1gb814a73b1640"
msgid "For Edowin."
msgstr "에도윈을 위해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Narrator
#. NodeID = cfde004f-72be-feb5-29a2-4208eb85511b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount4(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount4(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:cfde004f-72be-feb5-29a2-4208eb85511b
msgctxt "he3d91dd4g226cg4204g9995gfff166064c66"
msgid ""
"*Your blood runs quicker, feeding the gnawing absence at the centre of your "
"mind.*"
msgstr "*피가 더 빨리 흐르면서, 당신의 정신 한가운데를 좀먹는 허전함을 양분으로 채웁니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Player
#. NodeID = d1325f83-60e7-fad0-de30-e9f27b4410c4
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:d1325f83-60e7-fad0-de30-e9f27b4410c4
msgctxt "h210f2452g6d9ag4d7eg8323g18517bff3784"
msgid "Loss is inevitable. You must embrace it."
msgstr "상실은 불가피한 것. 받아들여야 한다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Player
#. NodeID = d1325f83-60e7-fad0-de30-e9f27b4410c4
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:d1325f83-60e7-fad0-de30-e9f27b4410c4
msgctxt "hcb4355b8gde19g4a29g9993geed84d60b083"
msgid "I'm sorry for your loss."
msgstr "유감이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Player
#. NodeID = d6944c3b-b8fc-6630-1f25-b3c87f85efc5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:d6944c3b-b8fc-6630-1f25-b3c87f85efc5
msgctxt "h6c5c8286g6d1cg496aga773g96e50a8edd56"
msgid "You should leave. You'll just get in the way."
msgstr "떠나라. 방해만 될 뿐이니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Player
#. NodeID = d6a1082d-4e3c-a42f-cd2b-b33846f8d7ee
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Absolute_Knows_TrueSoul = True
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = True
#.      - ILLITHID(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:d6a1082d-4e3c-a42f-cd2b-b33846f8d7ee
msgctxt "hc8d636c3gaf1eg4156ga9f8ga2396ea124de"
msgid "Move forward. Your True Soul commands it."
msgstr "앞으로 나아가라. 참된 영혼의 명령이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Andrick
#. NodeID = e8a7f54a-f443-ba58-cd16-31c887085390
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_Owlbear_Hasmet(1) = True
#.      - FOR_PriestConqueringGod_001_HasMetOwlbear(1) = True
#.   Global:
#.      - FOR_Owlbear_State_PermaDefeated = False
#. SetFlags:
#.   Object:
#.     - FOR_PriestsConqueringGod_AlliedPlayer(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:e8a7f54a-f443-ba58-cd16-31c887085390
msgctxt "h1f5fb571gea67g40e1g821fg6001178f02e2"
msgid "Holding steady... holding steady..."
msgstr "기다리는 중... 기다리는 중..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Andrick
#. NodeID = ea6662d3-e538-aa8a-85b0-ca679d1de57c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Absolute_Knows_Name = True
#.     - FOR_PriestsConqueringGod_Global_ChargeOwlbear = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:ea6662d3-e538-aa8a-85b0-ca679d1de57c
msgctxt "h35c20a50g7be3g4b1ag9674g3cdde7c1bbbf"
msgid "You're right. We can handle this. And - and we'll do it for Edowin."
msgstr "당신 말이 맞습니다. 할 수 있어요. 그리고... 에도윈을 위해 해야 해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Andrick
#. NodeID = ec2c1087-0b26-23db-5553-e4686a91fbf8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_PriestConqueringGod_Cultists_AwaitingOwlbearCombat(1) = False
#.      - FOR_Owlbear_Hasmet(1) = False
#.   Global:
#.      - FOR_Owlbear_State_PermaDefeated = False
#. SetFlags:
#.   Object:
#.     - FOR_PriestsConqueringGod_AlliedPlayer(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:ec2c1087-0b26-23db-5553-e4686a91fbf8
msgctxt "hce4fe0fcg1238g4891gb8b9g0b0d1aceac0d"
msgid "It's just ahead. It's... it's <i>huge.</i>"
msgstr "바로 앞에 있어요. 놈이... 놈이 <i>엄청나게 커요.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Andrick
#. NodeID = f5113197-df7f-6fb8-f2f0-6a3c4a44b535
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - WLD_PriestsConqueringGod_LeaveLevel = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:f5113197-df7f-6fb8-f2f0-6a3c4a44b535
msgctxt "hd237a162gbdabg40b2g88d7g918316fc938e"
msgid "Right. We will. Bry will know where to look."
msgstr "알겠습니다. 그리하겠습니다. 브리라면 어디로 가야 할지 알 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Player
#. NodeID = f9b883ab-c3db-1e71-ad5f-a419bfc9acbd
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 5
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#.      - ILLITHID(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave:f9b883ab-c3db-1e71-ad5f-a419bfc9acbd
msgctxt "hfe14709ege2f9g4d8dga416g816e9481592e"
msgid "You have no choice. <i>Go.</i>"
msgstr "네겐 선택지가 없다. <i>가.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist001_InCave
#. Speaker = Andrick
#. NodeID = ffb05e8b-9393-9f1b-192d-fc53b0c3c911
