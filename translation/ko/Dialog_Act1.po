msgctxt "h5136ea6dg2445g4625gb929g22632a55accc"
msgid ""
"<i>This better not be Minthara's messenger. If the boss finds out I gave her "
"a hard time, that's me done.</i>"
msgstr "<i>민타라의 전령은 아니었으면 좋겠어. 내가 민타라를 번거롭게 했다는 걸 상사가 알게 되면, 난 끝장이야.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = 669063ae-9874-789f-9a7a-09fb39eae9eb
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Local:
#.     - eaea790d-b9b8-b786-370a-5466a9185c91_MINDREAD = True
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:669063ae-9874-789f-9a7a-09fb39eae9eb
msgctxt "hd58bda2fge5f3g4a1fgb204gae891b8c92b2"
msgid ""
"<i>This better not be Minthara's messenger. If the boss finds out I gave him "
"a hard time, that's me done.</i>"
msgstr "<i>민타라의 전령은 아니었으면 좋겠어. 내가 민타라를 번거롭게 했다는 걸 상사가 알게 되면, 난 끝장이야.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = 669063ae-9874-789f-9a7a-09fb39eae9eb
#. HandlePath = TaggedText[2].TagText[0]
#. SetFlags:
#.   Local:
#.     - eaea790d-b9b8-b786-370a-5466a9185c91_MINDREAD = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:669063ae-9874-789f-9a7a-09fb39eae9eb
msgctxt "hf31f6f4ega117g439cg9397gf369cee36fcb"
msgid ""
"<i>This better not be Minthara's messenger. If the boss finds out I gave "
"them a hard time, that's me done.</i>"
msgstr "<i>민타라의 전령은 아니었으면 좋겠어. 내가 민타라를 번거롭게 했다는 걸 상사가 알게 되면, 난 끝장이야.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = 694a2e9d-47a4-3017-1059-3ee88d89ef9d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_Checkpoint_State_NonCharlatanAccess = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:694a2e9d-47a4-3017-1059-3ee88d89ef9d
msgctxt "h844c9369gf639g4d36g8d2cg81adffafe565"
msgid "Of course! 'Scusin' me; didn't know who you was."
msgstr "물론이죠! 미처 몰라뵈었습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = 69758803-445b-f59a-776a-aaab68072c02
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:69758803-445b-f59a-776a-aaab68072c02
msgctxt "h1b59039dg60b5g4d14g8dd3gd5316b5b4a9a"
msgid "Oi! Outta me head!"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = 6a1fa1f8-df2f-d4e0-28b7-343a0b188fca
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_Checkpoint_Guard01_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:6a1fa1f8-df2f-d4e0-28b7-343a0b188fca
msgctxt "h82afa7b8g2357g49d6ga93bg3d36536a78f2"
msgid "Unless you got another reason to be here, feck-shite."
msgstr "여기 있어야 할 다른 이유가 없다면, 꺼져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = 6ad4baf6-fcfa-812e-8310-2a50293fb95b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:6ad4baf6-fcfa-812e-8310-2a50293fb95b
msgctxt "h9000a616ge089g474fgb901gb56c63acbe59"
msgid "Rest of her litter's inside, in the pens. Beautiful beasts."
msgstr "나머지 새끼들은 우리 안에 있어. 아름다운 짐승들이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = 7291e0ed-ef1d-a57c-71a2-68d8a73ea633
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:7291e0ed-ef1d-a57c-71a2-68d8a73ea633
msgctxt "hf6f3a385gce6ag456eg8796g54a22a5ef942"
msgid "Both - we're havin' a party."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Player
#. NodeID = 72c193e1-332e-cc11-b802-c543c7a4baa2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:72c193e1-332e-cc11-b802-c543c7a4baa2
msgctxt "he1e1ce35gc7c4g4d46ga809g965fccf61502"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = 737a0cbc-696b-a80b-6901-b52cd948a416
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:737a0cbc-696b-a80b-6901-b52cd948a416
msgctxt "h4b466f84g3b4fg4acfgb10bgf5c23f7fecb2"
msgid "Stand down, lads! We got a True Soul comin' through!"
msgstr "무기 내려라, 아그들아! 참된 영혼 납신다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = 73c8ce5d-2ba4-f653-de15-1d8b967f0373
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:73c8ce5d-2ba4-f653-de15-1d8b967f0373
msgctxt "h426d8a80g4290g4ab0gb424gdc1b47374881"
msgid "We're celebratin' a raid. No better time in camp than this."
msgstr "우린 습격을 축하하고 있었어. 야영지에서 이보다 더 좋을 땐 없지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Narrator
#. NodeID = 7649013f-ce0c-af17-9ef4-ec23738417af
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount5(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount5(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:7649013f-ce0c-af17-9ef4-ec23738417af
msgctxt "hfef21493ge0a1g4f72g8038gfcb8726ea0d6"
msgid ""
"*Your blood runs quicker, feeding the gnawing absence at the centre of your "
"mind.*"
msgstr "*피가 더 빨리 흐르면서, 당신의 정신 한가운데를 좀먹는 허전함을 양분으로 채웁니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Player
#. NodeID = 797de936-349e-b0de-f7b3-9dd3ba73a231
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. SetFlags:
#.   Global:
#.     - GOB_Checkpoint_State_NonCharlatanAccess = True
#. TagRule: FIGHTER
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:797de936-349e-b0de-f7b3-9dd3ba73a231
msgctxt "hc4b190a7g4357g4dd0g94cdgb86e2995385a"
msgid ""
"To offer my sword to your boss. You can be my first demonstration, if you "
"like."
msgstr "내 검을 너희 대장에게 바치러 왔다. 네가 원한다면, 널 첫 번째 시범으로 삼아주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Narrator
#. NodeID = 7b0084a4-7eb6-8391-19b2-ff785c805fad
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:7b0084a4-7eb6-8391-19b2-ff785c805fad
msgctxt "h28ca0d78gaf65g453fg855fgfe808e0c42c6"
msgid ""
"*The mark glows, but you feel nothing in response. Your illithid power is "
"beyond reach until you rest.*"
msgstr "*문양이 빛나지만, 어떤 반응도 느껴지지 않습니다. 일리시드 능력을 더 사용하려면 휴식을 취해야 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = 80b4b33e-d2d7-0f19-eeb6-00f0be1190ce
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:80b4b33e-d2d7-0f19-eeb6-00f0be1190ce
msgctxt "h2c600cf6g206ag47ffg818bgb3a54d31e4ac"
msgid "Ma'am, I don't think... I... "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = 80b4b33e-d2d7-0f19-eeb6-00f0be1190ce
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:80b4b33e-d2d7-0f19-eeb6-00f0be1190ce
msgctxt "h4a61ce6agf4a5g4caega7cbgff6ffc65fea3"
msgid "Sir, I don't think... I... "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = 80b4b33e-d2d7-0f19-eeb6-00f0be1190ce
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:80b4b33e-d2d7-0f19-eeb6-00f0be1190ce
msgctxt "ha0b444abg8318g4532g8d96gdc2e3cd9d9b4"
msgid "True Soul, I don't think... I... "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Player
#. NodeID = 82da652c-fb18-0c7c-e3be-1c151f5a727f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:82da652c-fb18-0c7c-e3be-1c151f5a727f
msgctxt "h6273a493gff42g43beg98dbgc82de627228f"
msgid "<i>Attack him. This is a waste of time.</i>"
msgstr "<i>공격한다. 이건 시간 낭비다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = 83dedbe8-eb3c-15fd-b8e4-ffa35ad0cfc8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_Checkpoint_OlakToldPaint(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:83dedbe8-eb3c-15fd-b8e4-ffa35ad0cfc8
msgctxt "heb8d62ecgf1b2g4830gb61dga9c8068ee913"
msgid ""
"There's a party on. Celebratin' a raid, we are. You'll need to wear our war "
"colours."
msgstr "파티가 열리고 있어. 습격을 축하하고 있다구, 우린. 넌 우리 전쟁 페인트를 칠해야 할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = 851c2945-3298-c272-ce9c-cbb6ce342359
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:851c2945-3298-c272-ce9c-cbb6ce342359
msgctxt "he2494204gbd26g420dga2f2gc56d368699da"
msgid "Stop that - <i>now!</i>"
msgstr "그만둬, <i>당장!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Player
#. NodeID = 857d4086-e06a-60b3-b531-18eae2bcc817
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - MONK(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:857d4086-e06a-60b3-b531-18eae2bcc817
msgctxt "h4826e499g2da2g43cagbd06g3d9f07d28f5c"
msgid "I could best all of your sentinels with my bare hands. Let me pass."
msgstr "난 맨손으로도 너희 파수병 전부를 상대할 수 있어. 지나가게 해주시지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Narrator
#. NodeID = 8592abac-89a7-a268-7f2d-c050ce45bb74
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount6(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount6(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:8592abac-89a7-a268-7f2d-c050ce45bb74
msgctxt "hddcaf407gc79ag4d45g99a9gac5726ec5a68"
msgid ""
"*The presence deep in your mind is awake, unblinking. This is it. A single "
"word pervades your consciousness: 'Soon'.*"
msgstr ""
"*당신의 정신 속 깊이 자리잡은 존재가 태연스레 깨어납니다. 올 것이 왔군요. 한 단어가 당신의 의식 속으로 스며듭니다. ‘곧’*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Player
#. NodeID = 891e108a-dba3-04af-eba2-cd83164be160
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 5
#. TagRule: DRUID or RANGER
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:891e108a-dba3-04af-eba2-cd83164be160
msgctxt "h19f4152eg02c4g43b6gbbb2ga294c39ee510"
msgid ""
"Beautiful animal. Does she belong to the <i>Nordiland worgata </i>family?"
msgstr "아름다운 동물이네. <i>노르디랜드 워가타</i> 과야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Narrator
#. NodeID = 8b3af5be-a8bc-b9e5-9a17-30ac32ee6ef4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount4(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount4(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:8b3af5be-a8bc-b9e5-9a17-30ac32ee6ef4
msgctxt "h94291fe9gd287g4cc0g9c97gb2a0210e0701"
msgid ""
"*A shadow swims across your vision, and a familiar voice tells you to be "
"calm. You are loved.*"
msgstr "*그림자가 낀 듯이 눈앞이 흐려지더니, 익숙한 목소리가 당신을 달래줍니다. 사랑이 느껴집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = 8c177094-548d-4bae-8dac-b642be2361e8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Checkpoint_Guard01_HasMet(1) = False
#.   Tag:
#.      - UNDERDARK(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:8c177094-548d-4bae-8dac-b642be2361e8
msgctxt "hc611dffcg6c5cg4e69gb14fgf15f95bcc146"
msgid "Lookit, Klaw! Supper's here!"
msgstr "이거봐, 클로! 저녁거리가 왔어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = 8f2cdc27-1b33-0c2f-09fc-bec4c420efd9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_Checkpoint_State_GainedAccess = True
