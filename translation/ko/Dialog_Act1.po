msgctxt "h3519dd87gb08dg4addg8f62g5a09f8d1e016"
msgid "A dead drow. Quite the decoration."
msgstr "드로우 시체라. 아주 화려한 장식이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow
#. Speaker = Player
#. NodeID = f39387ea-7bf8-31c3-9446-ea3f9c0ce515
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow:f39387ea-7bf8-31c3-9446-ea3f9c0ce515
msgctxt "h332e630dge282g4c7cg8c0ag448425bb54a9"
msgid "That drow's seen better days."
msgstr "저 드로우는 좋은 시절 다 갔군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow
#. Speaker = Player
#. NodeID = f39387ea-7bf8-31c3-9446-ea3f9c0ce515
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow:f39387ea-7bf8-31c3-9446-ea3f9c0ce515
msgctxt "hb0c88676g672eg41beg9b1agaa78d4c3bdb2"
msgid "A dead drow. The druids' work?"
msgstr "드로우 시체잖아. 드루이드들 짓인가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow
#. Speaker = Player
#. NodeID = f39387ea-7bf8-31c3-9446-ea3f9c0ce515
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow:f39387ea-7bf8-31c3-9446-ea3f9c0ce515
msgctxt "hb55212eeg4c6cg4a77ga308g71c9739e8520"
msgid "That a dead drow?!"
msgstr "저거 죽은 드로우?!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow
#. Speaker = Player
#. NodeID = f39387ea-7bf8-31c3-9446-ea3f9c0ce515
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow:f39387ea-7bf8-31c3-9446-ea3f9c0ce515
msgctxt "h7ee75193gd17dg4cbfg9876gd3cc1bc0b045"
msgid "A dead drow. These druids aren't to be tangled with lightly."
msgstr "죽은 드로우야. 여기 드루이드는 가볍게 얽힐 자들이 아니군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow
#. Speaker = Player
#. NodeID = f39387ea-7bf8-31c3-9446-ea3f9c0ce515
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow:f39387ea-7bf8-31c3-9446-ea3f9c0ce515
msgctxt "hc48e262dg255fg4105ga850gff39419f88b3"
msgid "A dead drow. And the druids did this?"
msgstr "죽은 드로우다. 드루이드가 이런 짓을 했다고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow
#. Speaker = Player
#. NodeID = f39387ea-7bf8-31c3-9446-ea3f9c0ce515
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: (REALLY_DROWELF or REALLY_DROWHALFELF) and REALLY_GENERIC
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow:f39387ea-7bf8-31c3-9446-ea3f9c0ce515
msgctxt "h95b8e4ebgf0b1g4192g8958g9f9efc8905d9"
msgid "A dead drow. Hardly a welcoming sight."
msgstr "드로우 시체군. 보기 좋은 광경은 아닌데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow
#. Speaker = Player
#. NodeID = f39387ea-7bf8-31c3-9446-ea3f9c0ce515
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: REALLY_GENERIC
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_SeeDrow:f39387ea-7bf8-31c3-9446-ea3f9c0ce515
msgctxt "hcf396111g7f65g4824g8f77gc105b80f0527"
msgid "I wonder what happened to that drow."
msgstr "드로우에게 무슨 일이 있었던 걸까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch
#. Speaker = Player
#. NodeID = 435d6622-e6f8-a66a-152f-ec47f335c9d1
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch:435d6622-e6f8-a66a-152f-ec47f335c9d1
msgctxt "hc91a126dg4e4cg4ac6ga5fagb73b75cd1971"
msgid "This 'Halsin' was taking notes on our wriggling friends."
msgstr "이 '할신'이란 자가 우리 꿈틀이 친구들을 두고 몇 자 적어놨네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch
#. Speaker = Player
#. NodeID = 435d6622-e6f8-a66a-152f-ec47f335c9d1
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch:435d6622-e6f8-a66a-152f-ec47f335c9d1
msgctxt "h14febb34g8c4eg4862g8c55gfdf7b791a3a1"
msgid ""
"This Halsin sounds like a knowledgeable man. He studied illithid tadpoles in "
"great detail."
msgstr "이 할신이란 친구, 식견이 꽤나 있어 보이는군. 일리시드 올챙이를 매우 상세하게 연구했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch
#. Speaker = Player
#. NodeID = 435d6622-e6f8-a66a-152f-ec47f335c9d1
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch:435d6622-e6f8-a66a-152f-ec47f335c9d1
msgctxt "h63a44fd3g3a89g4d6ag90d1g16354dcb7f36"
msgid "This 'Halsin' has studied the parasite."
msgstr "이 '할신'이란 자는 기생충을 연구했다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch
#. Speaker = Player
#. NodeID = 435d6622-e6f8-a66a-152f-ec47f335c9d1
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch:435d6622-e6f8-a66a-152f-ec47f335c9d1
msgctxt "hadedb421g4b9dg458eg8fa4g9351f58b4f72"
msgid "Why the hells was this 'Halsin' messing with tadpoles?"
msgstr "대체 뭔 지랄같은 이유로 이 '할신'이란 작자가 올챙이를 들쑤신 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch
#. Speaker = Player
#. NodeID = 435d6622-e6f8-a66a-152f-ec47f335c9d1
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch:435d6622-e6f8-a66a-152f-ec47f335c9d1
msgctxt "ha0698366g208dg4b9bg88d4g084ae31ff01b"
msgid "This 'Halsin' person seems to know a lot about tadpoles."
msgstr "이 '할신'이란 사람은 올챙이에 대해 많이 아는 듯 보이는군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch
#. Speaker = Player
#. NodeID = 435d6622-e6f8-a66a-152f-ec47f335c9d1
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch:435d6622-e6f8-a66a-152f-ec47f335c9d1
msgctxt "hb7b10063g9bd7g46b6gbbe8g8550e8711d13"
msgid "This 'Halsin' fellow was studying the parasite."
msgstr "이 '할신'이란 친구가 기생충을 연구하고 있었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch
#. Speaker = Player
#. NodeID = 435d6622-e6f8-a66a-152f-ec47f335c9d1
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_GENERIC
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch:435d6622-e6f8-a66a-152f-ec47f335c9d1
msgctxt "hb490c5b2g8573g42dbg880bg47e307b3be73"
msgid "This 'Halsin' has been studying the tadpole."
msgstr "이 '할신'이란 자가 기생충을 연구하고 있었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch
#. Speaker = Player
#. NodeID = 4cddf302-1cfb-e376-69de-a13ce5a02c6b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_IsMissing = True
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch:4cddf302-1cfb-e376-69de-a13ce5a02c6b
msgctxt "h39b9c585g0e6bg4d69ga04dgf32d8cc0deee"
msgid "If there's a cure, it seems Halsin is the one to talk to."
msgstr "치료법이 있다고 하면 우리가 얘기해 봐야 할 사람은 할신인 것 같네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch
#. Speaker = Player
#. NodeID = 4cddf302-1cfb-e376-69de-a13ce5a02c6b
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_IsMissing = True
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch:4cddf302-1cfb-e376-69de-a13ce5a02c6b
msgctxt "hb078b536g5979g4d77g9661g734525db5de0"
msgid ""
"This Halsin sounds like a knowledgeable man. He may just be able to cure us."
msgstr "이 할신이란 자는 학식이 뛰어난 사람 같군. 바로 이 자가 우릴 치료해줄 수도 있겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch
#. Speaker = Player
#. NodeID = 4cddf302-1cfb-e376-69de-a13ce5a02c6b
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_IsMissing = True
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch:4cddf302-1cfb-e376-69de-a13ce5a02c6b
msgctxt "h03834c3bg1521g4512ga2cagaae2d1de8072"
msgid "Halsin was studying the parasite."
msgstr "할신이 기생충을 연구하고 있었다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch
#. Speaker = Player
#. NodeID = 4cddf302-1cfb-e376-69de-a13ce5a02c6b
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_IsMissing = True
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch:4cddf302-1cfb-e376-69de-a13ce5a02c6b
msgctxt "hb45cb5c7gbf34g480egb092gba26b306362e"
msgid "Halsin was studying our little wormy friends. We should talk to him."
msgstr "할신이 우리 귀여운 지렁이 친구들을 연구하고 있었어. 걔랑 얘기해 봐야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch
#. Speaker = Player
#. NodeID = 4cddf302-1cfb-e376-69de-a13ce5a02c6b
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_IsMissing = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch:4cddf302-1cfb-e376-69de-a13ce5a02c6b
msgctxt "hdf6b2793g9b01g4487gbaf5g485d7e05f366"
msgid "Halsin sounds like the best chance of finding a cure."
msgstr "할신에게 의뢰하는 게 최선인 것 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch
#. Speaker = Player
#. NodeID = 4cddf302-1cfb-e376-69de-a13ce5a02c6b
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_IsMissing = True
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch:4cddf302-1cfb-e376-69de-a13ce5a02c6b
msgctxt "had66437ag4da8g4c72g9383gacdc3a28b3ef"
msgid "As I expected. This druid Halsin is key to our cure."
msgstr "예상대로군. 이 할신이란 드루이드가 우리 치료의 열쇠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch
#. Speaker = Player
#. NodeID = 4cddf302-1cfb-e376-69de-a13ce5a02c6b
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_IsMissing = True
#. TagRule: REALLY_GENERIC
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch:4cddf302-1cfb-e376-69de-a13ce5a02c6b
msgctxt "h6a38c8d3g2017g45cbgaa4fg0c1eb3a96b34"
msgid "Looks like Halsin's our best bet for a cure."
msgstr "할신이 치유를 향한 최고의 가능성인 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch
#. Speaker = Player
#. NodeID = 541f6041-efb0-d1a2-f3d5-09a3614ce3a8
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch:541f6041-efb0-d1a2-f3d5-09a3614ce3a8
msgctxt "h21079d04ga73cg4621g9914g669dc18fb5bf"
msgid "Then let's find him. Time is short."
msgstr "그럼 찾으러 가자고. 시간이 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch
#. Speaker = Player
#. NodeID = 541f6041-efb0-d1a2-f3d5-09a3614ce3a8
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch:541f6041-efb0-d1a2-f3d5-09a3614ce3a8
msgctxt "h2b5901f0g80feg4482ga950g358b4e25d45c"
msgid "We know the man. We know the mission. Let's go find him."
msgstr "누구인지도 알고. 뭘 해야 할지도 알고. 찾으러 가자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch
#. Speaker = Player
#. NodeID = 541f6041-efb0-d1a2-f3d5-09a3614ce3a8
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch:541f6041-efb0-d1a2-f3d5-09a3614ce3a8
msgctxt "h6faf9415g90f2g4b74g8cfbg929bf084258b"
msgid "It's a rescue mission then - should be fun. Let's get to work."
msgstr "구출 작전이네 그럼. 재밌겠다. 바로 시작해 보자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch
#. Speaker = Player
#. NodeID = 541f6041-efb0-d1a2-f3d5-09a3614ce3a8
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch:541f6041-efb0-d1a2-f3d5-09a3614ce3a8
msgctxt "he6800dc4g88c7g49cdg933cga3b229757ad1"
msgid "Time to track him down and see what he knows."
msgstr "그 자를 찾아내서 뭘 알고 있는지 확인할 시간이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch
#. Speaker = Player
#. NodeID = 541f6041-efb0-d1a2-f3d5-09a3614ce3a8
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch:541f6041-efb0-d1a2-f3d5-09a3614ce3a8
msgctxt "h906f70a6g082ag4a8cg9db2gf08887a93d81"
msgid "We know the man, we know our mission. Let's move out."
msgstr "누구인지도 알고, 뭘 해야 할지도 알아. 얼른 움직이자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch
#. Speaker = Player
#. NodeID = 541f6041-efb0-d1a2-f3d5-09a3614ce3a8
#. HandlePath = TaggedText[5].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch:541f6041-efb0-d1a2-f3d5-09a3614ce3a8
msgctxt "h655e1033g60f7g430eg823bg93552dd3b0bd"
msgid "We need to find him, before it's too late."
msgstr "그를 찾아야 해, 너무 늦기 전에."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch
#. Speaker = Player
#. NodeID = 5c9cd2fe-c84c-3c00-5453-0637c13c54a1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch:5c9cd2fe-c84c-3c00-5453-0637c13c54a1
msgctxt "hc1282fe7g74e4g4353g839egfbee3d08ce95"
msgid ""
"We gain nothing by chasing strangers. Only a githyanki crèche holds our cure."
msgstr "낯선 사람을 쫓아 봤자 아무것도 얻을 수 없다. 오직 기스양키 양성소 만이 치유의 방법이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch
#. Speaker = Player
#. NodeID = 7eb867a9-9191-20f6-d077-ffef063b069b
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch:7eb867a9-9191-20f6-d077-ffef063b069b
msgctxt "hc513aaccg0b75g4e49g9e81g2152b6a0aea3"
msgid "Assuming he's still alive."
msgstr "그가 살아 있다면 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch
#. Speaker = Player
#. NodeID = 7eb867a9-9191-20f6-d077-ffef063b069b
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch:7eb867a9-9191-20f6-d077-ffef063b069b
msgctxt "h8ac78bf0ge705g4f3dg9a9fg0466f5135b29"
msgid "Let's be optimistic and assume he's still among the living."
msgstr "낙관적으로 생각해서 그가 아직 이승에 남아 있기를 바라자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch
#. Speaker = Player
#. NodeID = 7eb867a9-9191-20f6-d077-ffef063b069b
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch:7eb867a9-9191-20f6-d077-ffef063b069b
msgctxt "h34700cf5g00b3g4a22g86cfg7b52e275d5f8"
msgid "Knowing our luck, something already ate the poor bastard."
msgstr "우리 운이 뻔하지 뭐. 그 불쌍한 새끼는 이미 웬 놈한테 잡아먹혔을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch
#. Speaker = Player
#. NodeID = 7eb867a9-9191-20f6-d077-ffef063b069b
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch:7eb867a9-9191-20f6-d077-ffef063b069b
msgctxt "h0e7b606fgd608g418bgbc4dgfba4ed405b33"
msgid "Assuming he's even still alive."
msgstr "그가 살아 있기나 하다면 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch
#. Speaker = Player
#. NodeID = 7eb867a9-9191-20f6-d077-ffef063b069b
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch:7eb867a9-9191-20f6-d077-ffef063b069b
msgctxt "h8c5dbe7cg4789g41efgba7cg6ba409fdf505"
msgid "Assuming the goblins haven't killed him by now."
msgstr "고블린들이 아직 그를 죽이지 않았다면 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch
#. Speaker = Player
#. NodeID = 7eb867a9-9191-20f6-d077-ffef063b069b
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_GENERIC
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch:7eb867a9-9191-20f6-d077-ffef063b069b
msgctxt "h4d51285fga3b1g4f70g860dg88b45d0c2382"
msgid "What if something happened to him?"
msgstr "그에게 무슨 일이 생겼으면 어떻게 하지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch
#. Speaker = Player
#. NodeID = 898e5ed0-ad3b-1677-2c2a-bb1d30bf0aae
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch:898e5ed0-ad3b-1677-2c2a-bb1d30bf0aae
msgctxt "h946b105bg6f7bg401bg84a5g1fc394a258c9"
msgid "He sounds like someone worth talking to."
msgstr "얘기해 볼 가치가 있는 사람 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch
#. Speaker = Player
#. NodeID = 898e5ed0-ad3b-1677-2c2a-bb1d30bf0aae
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch:898e5ed0-ad3b-1677-2c2a-bb1d30bf0aae
msgctxt "hfda0cc65gada5g4f2ag8041g045ee50a3000"
msgid "Just the sort of chap to have a chat with, I reckon."
msgstr "내 보기엔 딱 우리가 얘기해 봄 직한 양반이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch
#. Speaker = Player
#. NodeID = 898e5ed0-ad3b-1677-2c2a-bb1d30bf0aae
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch:898e5ed0-ad3b-1677-2c2a-bb1d30bf0aae
msgctxt "h00ad6c2egc5abg438fga00eg8b022ea6cff8"
msgid ""
"We should find him - he'll either help us or try to dissect us. Maybe both."
msgstr "할신을 찾아야 해. 우릴 도와주든가, 아니면 해부하려고 하겠지. 둘 다 할지도."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch
#. Speaker = Player
#. NodeID = 898e5ed0-ad3b-1677-2c2a-bb1d30bf0aae
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch:898e5ed0-ad3b-1677-2c2a-bb1d30bf0aae
msgctxt "h5a09effcg1790g4dc4gb89dg5daf7c8b4f61"
msgid "Got to find him then. See if he can help."
msgstr "그럼 이 자를 찾아야 해요. 도움이 될지 확인해 보죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch
#. Speaker = Player
#. NodeID = 898e5ed0-ad3b-1677-2c2a-bb1d30bf0aae
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch:898e5ed0-ad3b-1677-2c2a-bb1d30bf0aae
msgctxt "h6418bc28g29d5g41c8ga0e8g8ec32e21cbb0"
msgid "We best find him. He'll know how to cure us of this damned infection."
msgstr "그를 찾아야겠어. 이 저주받은 감염을 치료하는 법을 알 테니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch
#. Speaker = Player
#. NodeID = 898e5ed0-ad3b-1677-2c2a-bb1d30bf0aae
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch:898e5ed0-ad3b-1677-2c2a-bb1d30bf0aae
msgctxt "hfe71a445g24cfg4900g9f61gfd99b5bb7ae2"
msgid "Forget Halsin. Only a githyanki crèche holds our cure."
msgstr "할신은 잊어라. 오직 기스양키 양성소 만이 치유의 방법이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch
#. Speaker = Player
#. NodeID = 898e5ed0-ad3b-1677-2c2a-bb1d30bf0aae
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch:898e5ed0-ad3b-1677-2c2a-bb1d30bf0aae
msgctxt "hf5684654g1f6fg4809gafd4g03d490f9ce44"
msgid "We should find him, maybe he can help?"
msgstr "그를 찾아야 해, 우릴 도울 수 있지 않을까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch
#. Speaker = Player
#. NodeID = d0ace64d-2c07-f43f-6943-abf18fc84dde
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch:d0ace64d-2c07-f43f-6943-abf18fc84dde
msgctxt "hd536fb1cg82f8g4e6bg8676g2c30c03bf872"
msgid "Forget Halsin. Only a githyanki crèche holds our cure."
msgstr "할신은 잊어라. 오직 기스양키 양성소 만이 치유의 방법이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch
#. Speaker = Player
#. NodeID = e027493c-e4a6-cf6d-2ff9-895044b80bd5
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch:e027493c-e4a6-cf6d-2ff9-895044b80bd5
msgctxt "hb2ac1660gf97bg443dgb209g71afd46c5181"
msgid "If he's dead, we'll make his corpse talk."
msgstr "그가 죽었다면, 그의 시체에 물어보면 되잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch
#. Speaker = Player
#. NodeID = e027493c-e4a6-cf6d-2ff9-895044b80bd5
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch:e027493c-e4a6-cf6d-2ff9-895044b80bd5
msgctxt "hcf771928g84aeg46daga138g8432481a960d"
msgid "Speculation will get us nowhere. Let's go find him."
msgstr "추측으론 아무것도 얻을 수 없어. 가서 그를 찾자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch
#. Speaker = Player
#. NodeID = e027493c-e4a6-cf6d-2ff9-895044b80bd5
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch:e027493c-e4a6-cf6d-2ff9-895044b80bd5
msgctxt "h0ebd55c7g1360g456fga274g8524d96cd373"
msgid "Let's just get to work - if anyone can bring him home safe, it's us."
msgstr "그냥 일이나 시작하자. 그 사람을 집에 무사히 데려다 줄 사람이 있다면 우리 뿐일 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch
#. Speaker = Player
#. NodeID = e027493c-e4a6-cf6d-2ff9-895044b80bd5
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch:e027493c-e4a6-cf6d-2ff9-895044b80bd5
msgctxt "h6cbaf840g37ecg4ff8g869ag33a64f496a0e"
msgid ""
"He won't get off that easily. We can force his corpse to talk if it comes to "
"that."
msgstr "그리 쉽게 당하진 않을 거야. 그렇다면 그의 시체와 대화해야겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch
#. Speaker = Player
#. NodeID = e027493c-e4a6-cf6d-2ff9-895044b80bd5
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch:e027493c-e4a6-cf6d-2ff9-895044b80bd5
msgctxt "h997ded27gac63g4188g9fadgf7ff93a46d25"
msgid "Oh, he's alive. And we're going to find him."
msgstr "오, 그는 살아있어. 그리고 우리가 찾을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch
#. Speaker = Player
#. NodeID = e027493c-e4a6-cf6d-2ff9-895044b80bd5
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch:e027493c-e4a6-cf6d-2ff9-895044b80bd5
msgctxt "hcee5a88ag8736g46aega143ga92e37eed9ab"
msgid "Forget Halsin. Only a githyanki crèche holds our cure."
msgstr "할신은 잊어라. 오직 기스양키 양성소 만이 치유의 방법이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch
#. Speaker = Player
#. NodeID = e027493c-e4a6-cf6d-2ff9-895044b80bd5
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch:e027493c-e4a6-cf6d-2ff9-895044b80bd5
msgctxt "hdbe305abg4e12g42fegae40gd6af8e8883cd"
msgid "Enough chatter. We retrieve Halsin, we find a cure."
msgstr "잡담은 그만. 할신을 되찾고, 치유할 방법을 찾는 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch
#. Speaker = Player
#. NodeID = e027493c-e4a6-cf6d-2ff9-895044b80bd5
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: REALLY_GENERIC
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_PAD_TadpoleResearch:e027493c-e4a6-cf6d-2ff9-895044b80bd5
msgctxt "h7f15f454g45feg47efgb394g45d87c3e3a03"
msgid "All the more reason to hurry."
msgstr "서두를 이유가 늘었군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed
#. Speaker = Nettie
#. NodeID = 012bfc87-f11b-ae7d-e669-d97b4320ab53
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed:012bfc87-f11b-ae7d-e669-d97b4320ab53
msgctxt "hc266d6c9g9d59g45b9g8ea7g8f2865158071"
msgid ""
"Please keep an eye on her while you're looking for Master Halsin... just in "
"case."
msgstr "할신을 찾는 동안 그녀를 잘 살펴보세요... 혹시 모르니까요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed
#. Speaker = Player
#. NodeID = 0bf38634-2bc1-1c91-85e5-425200aea8a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed:0bf38634-2bc1-1c91-85e5-425200aea8a3
msgctxt "h56e81228gd285g45bfga165g8bc1ff7ffcd3"
msgid "That's the plan. I'll do whatever it takes."
msgstr "그게 계획이야. 무슨 일이든 할게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed
#. Speaker = Nettie
#. NodeID = 10d678af-e26c-a9f1-121d-663e82872cab
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_Event_RevealedTadpole(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_Apprentice_HasMet_Stayed(1) = True
#.     - DEN_Apprentice_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed:10d678af-e26c-a9f1-121d-663e82872cab
msgctxt "h37d49169gd76eg4cb0g997aga6d057e0a669"
msgid ""
"Your companion's a brave one. Not everyone would make a promise like that."
msgstr "동료분이 용감하네요. 모두가 그런 맹세를 할 수 있는 건 아니에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed
#. Speaker = Player
#. NodeID = 1586db95-094b-f200-b352-bf7f4e92db83
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_IsFound = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed:1586db95-094b-f200-b352-bf7f4e92db83
msgctxt "h59eaaf22g9cfag4424g9adagb221c0a2426a"
msgid "No, not yet."
msgstr "아니, 아직."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed
#. Speaker = Nettie
#. NodeID = 234125dc-6e8e-0438-6dc9-082feb01f95a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Apprentice_Knows_NettieKnowsHalsinGOB = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed:234125dc-6e8e-0438-6dc9-082feb01f95a
msgctxt "h66ac041ag3a52g4983gb901g43df18fba3a9"
msgid "Please be careful - for both your sake and Master Halsin's."
msgstr "당신과 마스터 할신의 안위를 위해 부디 조심해 주세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed
#. Speaker = Nettie
#. NodeID = 267a8018-1874-fb8e-be37-f63e3939d0ae
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_Apprentice_HasMet_Stayed(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed:267a8018-1874-fb8e-be37-f63e3939d0ae
msgctxt "h12b9aae2gb1d2g4621g8cc2g895cbe018a42"
msgid "Any word on Master Halsin?"
msgstr "마스터 할신에 대한 소식은 없나요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed
#. Speaker = Nettie
#. NodeID = 34409af6-d6c1-f4b3-c54c-9c4b5ac91531
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_Event_RevealedTadpole(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed:34409af6-d6c1-f4b3-c54c-9c4b5ac91531
msgctxt "h4ed099cfg6f6bg460dg8087g74e8455230f5"
msgid "Then your friend's dead. No one else will free them from that tadpole."
msgstr "그럼 당신의 친구들이 죽을 거예요. 누구도 그 올챙이로부터 자유로울 수 없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed
#. Speaker = Nettie
#. NodeID = 3cb99fc5-e4b2-3f43-59fb-e0d8ba79babd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed:3cb99fc5-e4b2-3f43-59fb-e0d8ba79babd
msgctxt "h430cc800g5cc9g4d76gacc1g729996111131"
msgid "But what about your other mission? Any word on Master Halsin?"
msgstr "다른 임무들은 어쩌고요? 할신 님에 대한 소식은 없나요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed
#. Speaker = Nettie
#. NodeID = 3edbfa9d-4e77-b196-bce1-4d63a6e69bb4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Knows_StudiedTadpole = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed:3edbfa9d-4e77-b196-bce1-4d63a6e69bb4
msgctxt "h617900bagdbffg48f2gadd2g97f2dd055ae5"
msgid ""
"Master Halsin studied that drow for days, and he was sure something at the "
"temple could help his research. I'm praying he was right."
msgstr ""
"마스터 할신은 며칠간 그 드로우를 연구하고, 신전에 있는 무언가가 연구에 도움이 될 거라고 확신하셨어요. 저는 그가 옳았기를 기도하고 "
"있습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed
#. Speaker = Nettie
#. NodeID = 40e3de57-56f6-430b-1ef5-6d234c61b6cc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed:40e3de57-56f6-430b-1ef5-6d234c61b6cc
msgctxt "h26b4776fg2f94g45eag8227gf5face31a76d"
msgid "Please, be smart about this. Save him."
msgstr "제발, 현명하게 행동해주세요. 그를 구해주세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed
#. Speaker = Nettie
#. NodeID = 47c50509-ff52-9d4e-26ba-7532c12087bb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed:47c50509-ff52-9d4e-26ba-7532c12087bb
msgctxt "h887cb7a3g4dd5g412ega8b9g24f360607011"
msgid "Please hurry - for both your sakes."
msgstr "당신을 위해서라도 부디 서둘러주세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed
#. Speaker = Nettie
#. NodeID = 63012e16-e6ee-0457-29a2-eaad21796387
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed:63012e16-e6ee-0457-29a2-eaad21796387
msgctxt "hcb8e55f2g19ccg44fdg8966g03330abf470e"
msgid "Sweet Father..."
msgstr "신이시여..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed
#. Speaker = Player
#. NodeID = 63e894df-721d-7d15-1bba-27f42d4b8f9d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_State_PermaDefeated = True
#.      - GLO_Halsin_Knows_IsFound = True
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_State_NettieMournsHalsin = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed:63e894df-721d-7d15-1bba-27f42d4b8f9d
msgctxt "h6e1fefd6g2499g44e4g8160g1c188bcff60e"
msgid "I found Halsin. He's dead."
msgstr "할신을 찾았다. 그는 죽었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed
#. Speaker = Nettie
#. NodeID = 665e63fd-40bb-5d4b-c5e2-b84b6fe0202e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed:665e63fd-40bb-5d4b-c5e2-b84b6fe0202e
msgctxt "h835de047g4663g4a6dgaaa7g240d4c227acd"
msgid "I - Thank you. For trying, and for telling me. At least now we know."
msgstr "아 - 노력해줘서 감사드려요. 제게 알려주신 것도요. 최소한 생사는 알게 되었네요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed
#. Speaker = Nettie
#. NodeID = 6f174565-871b-06d9-4955-ab39f79265d2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Knows_WentWithAdventurers = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed:6f174565-871b-06d9-4955-ab39f79265d2
msgctxt "h077479d1gc48dg47c1gb24bg7b79b26c1733"
msgid "He and the adventurers were headed to the ruined temple in the west."
msgstr "그분과 모험가들은 서쪽의 폐허가 된 신전으로 향했어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed
#. Speaker = Nettie
#. NodeID = 80eaecb8-1d3c-39b5-dbaf-464996a6dac1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_HasMaleTadpoled(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed:80eaecb8-1d3c-39b5-dbaf-464996a6dac1
msgctxt "h9d4f76ccg700eg4ec3g94fdgd00451915238"
msgid ""
"Please keep an eye on him while you're looking for Master Halsin... just in "
"case."
msgstr "할신을 찾는 동안 그를 잘 살펴보세요... 혹시 모르니까요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed
#. Speaker = Nettie
#. NodeID = 827aeabd-c048-43e9-fdef-32617d9809f1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_Event_RevealedTadpole(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed:827aeabd-c048-43e9-fdef-32617d9809f1
msgctxt "hd1575407g9820g4a11g9434ge203aca31e10"
msgid "Then you'll both die. No one else will free you from that tadpole."
msgstr "그러면 둘 다 죽게 될 거예요. 다른 누구도 당신을 올챙이에서 자유롭게 해줄 수 없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed
#. Speaker = Nettie
#. NodeID = 8594a994-dd6a-4c22-557e-a9de97f41a88
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed:8594a994-dd6a-4c22-557e-a9de97f41a88
msgctxt "hd7d47e2bg8711g42e2gb76bgba037af23570"
msgid "Thank you."
msgstr "고마워요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed
#. Speaker = Nettie
#. NodeID = 8924abdf-0717-ce3c-d930-3262ff044f3f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed:8924abdf-0717-ce3c-d930-3262ff044f3f
msgctxt "h896a0adeg9deeg460eg867fg02f67722f2b0"
msgid "Thank the Father he's alive. Please, you have to get him out of there."
msgstr "그가 살아있다니 나무 아버지께 감사를. 부디, 거기서 그를 꺼내주세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed
#. Speaker = Nettie
#. NodeID = 99b9ee4a-60b6-3f15-0242-e39395576248
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Apprentice_HasMet_ReactedToShadowDruids(1) = False
#.   Global:
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Apprentice_HasMet_Stayed(1) = True
#.     - DEN_Apprentice_HasMet_ReactedToShadowDruids(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed:99b9ee4a-60b6-3f15-0242-e39395576248
msgctxt "h11b0a547gb305g4aa7g819fgd1aaf89d4c8c"
msgid "I hear you brought Kagha back from the brink. My thanks."
msgstr "카그하가 잘못된 길을 가지 않도록 도와주셨다고 들었어요. 고마워요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed
#. Speaker = Nettie
#. NodeID = 9a8bd60c-f703-e59b-ae58-ad8d01b84168
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Apprentice_State_NettieMournsHalsin = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed:9a8bd60c-f703-e59b-ae58-ad8d01b84168
msgctxt "hfe48935dg90dfg435fg9d60g2461cd958136"
msgid "To lose such a great man. It just doesn't feel real."
msgstr "그런 위대한 분을 잃다니. 믿겨지지 않아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed
#. Speaker = Player
#. NodeID = 9a9f6d15-4a1d-a669-49a0-a462c2adaa04
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_IsFound = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed:9a9f6d15-4a1d-a669-49a0-a462c2adaa04
msgctxt "ha92f85e0g9f56g43e9g91f7g5ea765e6f2da"
msgid "Do you know where Halsin went?"
msgstr "할신이 어디로 갔는지 아나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed
#. Speaker = Player
#. NodeID = a4716772-7e47-3816-b23c-9943b2798033
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_State_PermaDefeated = False
#.      - GLO_Halsin_Knows_IsFound = True
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Knows_NettieKnowsHalsinGOB = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed:a4716772-7e47-3816-b23c-9943b2798033
msgctxt "h7de581cbga7a9g453ag9f75g4ddf887276cf"
msgid "Halsin's alive - he's being held at the goblins' camp."
msgstr "할신은 살아 있어. 고블린 야영지에 붙잡혀 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed
#. Speaker = Nettie
#. NodeID = b675135d-efbe-9d46-8882-73e841d8ce15
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_HasGenderNeutralTadpoled(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed:b675135d-efbe-9d46-8882-73e841d8ce15
msgctxt "hcc620d24gb5cag4c78gbe32gc5b070714a65"
msgid ""
"Please keep an eye on them while you're looking for Master Halsin... just in "
"case."
msgstr "할신을 찾는 동안 동료들을 잘 살펴보세요... 혹시 모르니까요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed
#. Speaker = Nettie
#. NodeID = ba252f23-35de-543a-2a13-858051714b56
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Apprentice_Quest_TookPoison = True
#.   Object:
#.      - DEN_Apprentice_Event_RevealedTadpole(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_Apprentice_HasMet_Stayed(1) = True
#.     - DEN_Apprentice_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed:ba252f23-35de-543a-2a13-858051714b56
msgctxt "ha976a4ecg4c1bg4214gadb9g235713c09c1e"
msgid "It was brave of your companion to agree to take the poison."
msgstr "당신의 동료가 독을 마시겠다고 한 것은 용감한 일이었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed
#. Speaker = Player
#. NodeID = e2260b6c-fcd4-bfd9-5d85-248c6822d1f2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed:e2260b6c-fcd4-bfd9-5d85-248c6822d1f2
msgctxt "h1d4fb4c0g0313g49a9ga6c9g0e48eb0a0717"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed
#. Speaker = Player
#. NodeID = eba52e54-0796-e2d0-bfac-bdd5891480e5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed:eba52e54-0796-e2d0-bfac-bdd5891480e5
msgctxt "h5faaf949g38dfg4ac4gae10g4c31c018955c"
msgid "I'm not risking my neck against that many goblins."
msgstr "그렇게 많은 고블린들을 상대로 목을 걸고 싶진 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed
#. Speaker = Nettie
#. NodeID = f77bdc07-8b7e-9838-32ac-180a1a45164f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed:f77bdc07-8b7e-9838-32ac-180a1a45164f
msgctxt "h7f9700c1g3a42g4752g84c2g9ffdc3d6b8bd"
msgid "Excuse me. I think I need to be alone."
msgstr "실례할게요. 혼자 있어야 할 것 같아요.."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed
#. Speaker = Nettie
#. NodeID = f9ab15d7-0b34-4d80-1512-82de4151af66
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Apprentice_HasMet_ReactedToShadowDruids(1) = False
#.   Global:
#.      - DEN_GroveConflict_State_DruidsPacified = True
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = False
#. SetFlags:
#.   Dialog:
#.     - DEN_Apprentice_HasMet_Stayed(1) = True
#.     - DEN_Apprentice_HasMet_ReactedToShadowDruids(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_Stayed:f9ab15d7-0b34-4d80-1512-82de4151af66
msgctxt "hadf05a3egfbf9g4932gaf41gad3e1f7cd46e"
msgid "I hear you put an end to Kagha's treachery. My thanks."
msgstr "카그하의 배신을 폭로했다면서요. 고마워요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_TadpoledScene
#. Speaker = Nettie
#. NodeID = 1296d1d4-c477-f286-9d56-5e24cfdfa340
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_TadpoledScene:1296d1d4-c477-f286-9d56-5e24cfdfa340
msgctxt "h015a0306g1005g49dfg862cg3060931e9c14"
msgid "Come. Let me help you."
msgstr "이리 오세요. 제가 도와드릴게요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_TadpoledScene
#. Speaker = Nettie
#. NodeID = 220e997c-a489-0b6f-f29c-045edea88f58
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_TadpoledScene:220e997c-a489-0b6f-f29c-045edea88f58
msgctxt "h60efb31agc1e1g4f1ag8374ge0af1a34525f"
msgid "You don't have time for anything else. That tadpole will kill you."
msgstr "시간이 없어요. 그 올챙이가 당신을 죽일 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_TadpoledScene
#. Speaker = Nettie
#. NodeID = 408f90c9-980a-eb11-de4a-a61d77cbc44d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_TadpoledScene:408f90c9-980a-eb11-de4a-a61d77cbc44d
msgctxt "h55626190gb6adg4da5g911fg95924d037c51"
msgid "Let's go, the workshop's this way."
msgstr "가요. 작업장은 이쪽이예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_TadpoledScene
#. Speaker = Player
#. NodeID = 875e7e59-5d68-d82e-fe91-4d5e7c0b0c72
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_TadpoledScene:875e7e59-5d68-d82e-fe91-4d5e7c0b0c72
msgctxt "h7f6dc24agfe2dg4d42gabb8g01373caa0ad9"
msgid "I'm right behind you."
msgstr "뒤에 있어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_TadpoledScene
#. Speaker = Nettie
#. NodeID = 9d617aac-14ec-5e35-69ca-8efbe2fc5bec
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Apprentice_Event_WaitLockPlayer = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_TadpoledScene:9d617aac-14ec-5e35-69ca-8efbe2fc5bec
msgctxt "h3d202852gbb75g49b7ga292ge3804550c18f"
msgid "In here, please."
msgstr "이쪽이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_TadpoledScene
#. Speaker = Player
#. NodeID = fdb2b9b4-ffb3-c634-47cc-97bb30301eec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_TadpoledScene:fdb2b9b4-ffb3-c634-47cc-97bb30301eec
msgctxt "he80d1375gdf78g4336gad9bg6f956f927fe7"
msgid "I don't have time for this."
msgstr "이럴 시간 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird
#. Speaker = Narrator
#. NodeID = 09a881d7-7713-6f35-5326-c98bcd90ad03
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird:09a881d7-7713-6f35-5326-c98bcd90ad03
msgctxt "hf347a308g3d25g43dagab00geceb6cf14556"
msgid "*The bird says nothing, trying to rest.*"
msgstr "*새는 아무 말 없이 휴식하려 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird
#. Speaker = Wounded Bird
#. NodeID = 13b674d6-967e-b058-796b-c3b774f8fc93
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird:13b674d6-967e-b058-796b-c3b774f8fc93
msgctxt "h3331ba5fg9048g43d7g9c2eg6a7c48ea84c7"
msgid "Hills... near road..."
msgstr "도로 근처... 언덕..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird
#. Speaker = Wounded Bird
#. NodeID = 196661ed-639d-cea1-4833-017b145ae391
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird:196661ed-639d-cea1-4833-017b145ae391
msgctxt "h17b8e386gfe18g4b64ga20bg68d8d7af88ca"
msgid "Yes sir!"
msgstr "넵!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird
#. Speaker = Wounded Bird
#. NodeID = 196661ed-639d-cea1-4833-017b145ae391
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird:196661ed-639d-cea1-4833-017b145ae391
msgctxt "hdf467d2eg9c79g497cg9313g43ca0c007108"
msgid "Yes ma'am!"
msgstr "넵!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird
#. Speaker = Wounded Bird
#. NodeID = 196661ed-639d-cea1-4833-017b145ae391
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird:196661ed-639d-cea1-4833-017b145ae391
msgctxt "hc52e85efgcf9cg4a1cg84a8gf5c3cb51bcb0"
msgid "I will - thanks to you!"
msgstr "그럴게요 - 감사합니다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird
#. Speaker = Narrator
#. NodeID = 1ca8da43-2929-181d-cba0-e978180f47ab
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird:1ca8da43-2929-181d-cba0-e978180f47ab
msgctxt "h5d65237fgea54g4481gb7fcg16680f76f6b9"
msgid "*The bird's eyes are glassy, its breathing weak.*"
msgstr "*새는 눈에 초점이 없고, 호흡도 약합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird
#. Speaker = Player
#. NodeID = 325d6fd6-cf18-0dfd-a7e2-019f5e570b55
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GLO_PaladinOathbreaker_Event_BrokeOath(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird:325d6fd6-cf18-0dfd-a7e2-019f5e570b55
msgctxt "he9a65b35ga290g4539g8b7cg40515c24d50c"
msgid "<i>Prod the bird's wing.</i>"
msgstr "<i>새의 날개를 찌른다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird
#. Speaker = Player
#. NodeID = 517e4f44-583a-10a2-7408-b1c5c105338c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GLO_PaladinOathbreaker_Event_BrokeOath(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird:517e4f44-583a-10a2-7408-b1c5c105338c
msgctxt "h46ec615cg5e8eg480fg9e4dg51b9e274e708"
msgid "Where did you see these gnolls?"
msgstr "어디서 그 놀들을 봤지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird
#. Speaker = Player
#. NodeID = 71d9a4a2-2dca-017b-a910-29e4b6e8d901
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird:71d9a4a2-2dca-017b-a910-29e4b6e8d901
msgctxt "h89d15b24g7b6cg40f5g91fdgfc60c563308a"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird
#. Speaker = Wounded Bird
#. NodeID = 72d8e5ae-8b3d-8a44-94f1-082772963aad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird:72d8e5ae-8b3d-8a44-94f1-082772963aad
msgctxt "h8f0f5effg67fbg44c8gb9aag62caed6816b3"
msgid "Big dog - gnoll... I got too close..."
msgstr "큰 개 - 놀... 내가 너무 가까이 가가갔어..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird
#. Speaker = Narrator
#. NodeID = 76c03dcd-2dae-6ad0-efd0-f00ad79c9945
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird:76c03dcd-2dae-6ad0-efd0-f00ad79c9945
msgctxt "h8dc3dddcg3d4fg4d6aga0afg4f64a797a40d"
msgid ""
"*The bird says nothing. Only the sound of its laboured breath fills the "
"silence.*"
msgstr "*새는 아무 말도 하지 않습니다. 새의 가쁜 숨소리만이 정적을 채웁니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird
#. Speaker = Narrator
#. NodeID = 7ac29f02-4e6f-dd81-a000-197e7bed602a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_DarkUrge_State_WoundedBird_PulledWings = True
#.   Object:
#.     - CharacterDieAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird:7ac29f02-4e6f-dd81-a000-197e7bed602a
msgctxt "h7339163egeae5g4397g9a36g375ac18c2f14"
msgid ""
"*Tearing, you play with the broken tissue. The wing is delicately airy.*"
msgstr "*당신은 망가진 부위를 뜯어내고 만지작거립니다. 날개가 아주 작고 가볍습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird
#. Speaker = Wounded Bird
#. NodeID = 94eb1b83-aa53-f31d-761b-676e2e94c841
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird:94eb1b83-aa53-f31d-761b-676e2e94c841
msgctxt "hd1a4e92cg39deg4511gaa52g54b43a8e9905"
msgid "They're everywhere up there. Stay away if you can."
msgstr "어디를 가도 녀석들이 있으니 조심하세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird
#. Speaker = Player
#. NodeID = 9b6c22a6-15b7-3cf0-e60a-a5397b764a85
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird:9b6c22a6-15b7-3cf0-e60a-a5397b764a85
msgctxt "hbc7135beg715bg4374g8db9ga2f258a57ef3"
msgid "<i>Pull yourself away. Leave her alone.</i>"
msgstr "<i>물러서서 내버려둔다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird
#. Speaker = Narrator
#. NodeID = a1c25cf6-a1cb-7c2f-7a76-a21788174fce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird:a1c25cf6-a1cb-7c2f-7a76-a21788174fce
msgctxt "h996d17d9g5da1g41a1g9e1dg30a817a263be"
msgid "*She lies limply on the table, completely still.*"
msgstr "*그녀의 몸이 테이블 위에 축 늘어져 있습니다. 완전히 조용합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird
#. Speaker = Player
#. NodeID = aa72f5c6-8236-9e7a-e174-814d1a5497ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird:aa72f5c6-8236-9e7a-e174-814d1a5497ea
msgctxt "h9ac4a70cg8f26g47a2g8fa2gd647f78cac96"
msgid "Glad you're feeling better. What hurt you?"
msgstr "기분이 나아졌다니 다행이야. 어째서 다친 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird
#. Speaker = Player
#. NodeID = ba49caf9-500f-e086-e6c0-7ca0086ff523
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird:ba49caf9-500f-e086-e6c0-7ca0086ff523
msgctxt "h4aee005ag72aag4532gbcf0g658960d3bece"
msgid "I'm sorry. Didn't mean to disturb you."
msgstr "미안해. 방해하려던 건 아니었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird
#. Speaker = Narrator
#. NodeID = bb1aab5e-275b-39ce-8003-bae0e5e2e200
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird:bb1aab5e-275b-39ce-8003-bae0e5e2e200
msgctxt "h11685799g6b56g41beg9a57gc1cda5e93af2"
msgid "*You are a resplendent carrion eagle before this pitiful jay.*"
msgstr "*이 불쌍한 어치 앞에서 당신은 마치 장엄한 독수리 같습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird
#. Speaker = Wounded Bird
#. NodeID = bb6d7dcc-3be6-edae-d982-e6b9609ff443
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird:bb6d7dcc-3be6-edae-d982-e6b9609ff443
msgctxt "hb462a858g47c6g4797gb681g2f74463ec010"
msgid "I was scouting the hills nearby. Got too close to a gnoll."
msgstr "나는 근처의 언덕을 정찰 중이었어. 놀에게 너무 가까이 다가갔지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird
#. Speaker = Player
#. NodeID = c4e3b402-cf19-bc2c-f6ef-d1bf1dea8389
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird:c4e3b402-cf19-bc2c-f6ef-d1bf1dea8389
msgctxt "hdf02f75dg44e8g425fga90cg918070d429a7"
msgid "You're welcome. Rest up."
msgstr "천만에. 푹 쉬어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird
#. Speaker = Narrator
#. NodeID = c6e0b535-343e-5f06-d5f6-32bcb406e60b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Event_WoundedBirdDies = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird:c6e0b535-343e-5f06-d5f6-32bcb406e60b
msgctxt "h5c343798g4cceg49c4gb0b5geea7cf09b9cb"
msgid "*The bird lapses into silence, her head lolling to the side.*"
msgstr "*새는 고개를 옆으로 기울인 채 침묵에 잠깁니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird
#. Speaker = Player
#. NodeID = cb92a99f-5571-e246-2170-f28af71afeca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird:cb92a99f-5571-e246-2170-f28af71afeca
msgctxt "h42ad874dg2944g40c4gacf9gaafb40c5b1e9"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird
#. Speaker = Player
#. NodeID = d4b690fe-ce7b-788f-e92c-cbe8c39f99c7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird:d4b690fe-ce7b-788f-e92c-cbe8c39f99c7
msgctxt "hb27d0b8egce32g47d2g93d6g0d8942de02f5"
msgid "<i>Prod her again.</i>"
msgstr "<i>그녀를 다시 찌른다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird
#. Speaker = Player
#. NodeID = dbbbffaf-b7ab-016b-cc3a-10a59443b5db
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GLO_PaladinOathbreaker_Event_BrokeOath(1) = True
#.     - ORI_DarkUrge_Event_IndulgedUrge(1) = True
#.     - ORI_DarkUrge_Event_HadUrge(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird:dbbbffaf-b7ab-016b-cc3a-10a59443b5db
msgctxt "h0efc4ec5ge550g4271gb474g27b2e52a4682"
msgid "<i>Tear her wings off.</i>"
msgstr "<i>날개를 찢어버린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird
#. Speaker = Player
#. NodeID = e1391e70-4130-c8c4-cee7-cea5bef59f02
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird:e1391e70-4130-c8c4-cee7-cea5bef59f02
msgctxt "hb5bc83dag86b4g4bcdg9656g4dd795c96949"
msgid "Something took a chunk out of you. What happened?"
msgstr "무언가가 세게 물었군. 무슨 일이 있었던 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird
#. Speaker = Narrator
#. NodeID = e9720654-05af-485c-6096-e7da14f579b7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird:e9720654-05af-485c-6096-e7da14f579b7
msgctxt "hf1bd8ac4g53f4g4cc4gae5eg387edcb3f6f4"
msgid "*Your chest tightens, your fingertips shake.*"
msgstr "*심장이 조여 오고, 손 끝이 떨립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird
#. Speaker = Wounded Bird
#. NodeID = ebaa8427-2383-8100-b647-9d17c4288400
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Apprentice_State_PlayerHealedBird = True
#.   Tag:
#.      - PETPAL(1) = True
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Event_RemoveBirdExhaustion = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird:ebaa8427-2383-8100-b647-9d17c4288400
msgctxt "h00a27ac3g19d5g4230g99bcg887baa63e289"
msgid "That - that feels good. Thank you!"
msgstr "사-상태가 좋아졌어. 고마워!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird
#. Speaker = Wounded Bird
#. NodeID = ef43b8ee-e2e4-a4e7-f4bc-92965aa9c379
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird:ef43b8ee-e2e4-a4e7-f4bc-92965aa9c379
msgctxt "h918976a5g5d48g4d67g9664g1a1b911a2b2a"
msgid "Argh!"
msgstr "아악!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird
#. Speaker = Wounded Bird
#. NodeID = f7106dec-f726-a559-53e6-fbd5b028ea51
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Apprentice_HasMet_WoundedBird(1) = False
#.   Tag:
#.      - PETPAL(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Apprentice_HasMet_WoundedBird(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird:f7106dec-f726-a559-53e6-fbd5b028ea51
msgctxt "h11beaa08g674eg4b56gb89ag8877c40ebe21"
msgid "Please... I'm resting..."
msgstr "제발... 나는 휴식 중이야..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird
#. Speaker = Narrator
#. NodeID = fb7e5ede-8714-bce8-3a31-1a2b7bee31ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_WoundedBird:fb7e5ede-8714-bce8-3a31-1a2b7bee31ed
msgctxt "h8981d27dg7360g43begb851g74acdec88d9f"
msgid "*You wonder what it would be like to fly as the birds do.*"
msgstr "*당신은 문득 새처럼 나는 건 어떤 느낌일지 궁금해집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ApprenticeLastStand
#. Speaker = Nettie
#. NodeID = 612dcd1f-7114-15d8-a291-fad96a29de29
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ApprenticeLastStand:612dcd1f-7114-15d8-a291-fad96a29de29
msgctxt "hda696f13g206fg4c42g8a4fg8772070201a6"
msgid "And to think I was worried you'd transform."
msgstr "당신이 변이할까 봐 걱정했었다니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ApprenticeLastStand
#. Speaker = Nettie
#. NodeID = cd4d1779-f599-7ee2-cee6-4f845c380762
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ApprenticeLastStand:cd4d1779-f599-7ee2-cee6-4f845c380762
msgctxt "h5b48b439gb026g480eg9b1cgbe023bc93417"
msgid "You were a monster the whole time."
msgstr "애초에 괴물이었는데!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_BardDefendsKids
#. Speaker = Alfira
#. NodeID = 67f1ec03-fbf6-8fed-e8c9-53bfcd0c48d5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_BardDefendsKids:67f1ec03-fbf6-8fed-e8c9-53bfcd0c48d5
msgctxt "h9545c0cegf84ag4a0aga8a0g92226438ec09"
msgid "N-no. Not again. Not. <i>Again.</i>"
msgstr "안 돼. 더는. 절대로!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_BetrayedGrieflingFriend
#. Speaker = Memnos
#. NodeID = c83f19d9-09dd-dd57-f950-fb2b12b9aabe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_BetrayedGrieflingFriend:c83f19d9-09dd-dd57-f950-fb2b12b9aabe
msgctxt "hbccee627ga24dg40bbg9fd2g791e1cb5b47e"
msgid "You backstabbing <i>birna mrag!</i> We trusted you!"
msgstr "이 배신자 <i>비르나 므락!</i> 널 믿었는데!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_BetrayedLeader
#. Speaker = Zevlor
#. NodeID = 0962454f-9c0c-cf11-2095-8dbdb8125c42
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_BetrayedLeader:0962454f-9c0c-cf11-2095-8dbdb8125c42
msgctxt "h8d87105eg5bf4g4280gbd83gc543256a932f"
msgid "What have you <i>done</i>?!"
msgstr "무슨 짓을 <i>저지른 거야</i>?!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_BetrayedTrainer
#. Speaker = Asharak
#. NodeID = d4e7152b-b85c-8589-39d5-7a229e84821b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_BetrayedTrainer:d4e7152b-b85c-8589-39d5-7a229e84821b
msgctxt "h0556c2e2g438cg483eg98f5g6a22d9b155b3"
msgid "I'll kill you, you bloody coward!"
msgstr "죽여버리겠어, 이 빌어먹을 겁쟁아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_BickeringTrainees
#. Speaker = Gan
#. NodeID = 5a8970c9-8cb6-8038-16bd-312c5473eb7d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_BickeringTrainees:5a8970c9-8cb6-8038-16bd-312c5473eb7d
msgctxt "h4c197412gea48g4399g8a9dga492093d28f5"
msgid "Then I'll take a hundred!"
msgstr "그럼 나는 백 마리 잡아야지!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_BickeringTrainees
#. Speaker = Ide
#. NodeID = 90ce01ef-35f9-8135-b525-1936a0ea2370
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_BickeringTrainees:90ce01ef-35f9-8135-b525-1936a0ea2370
msgctxt "hba618467g6e88g460ag800egc8905847c556"
msgid "So? I can take ten!"
msgstr "그래? 그럼 나는 열 마리!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_BickeringTrainees
#. Speaker = Gan
#. NodeID = c2dc1ad8-ba66-46cc-1e5e-58747b2d89ab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_BickeringTrainees:c2dc1ad8-ba66-46cc-1e5e-58747b2d89ab
msgctxt "hadfae37ag3f43g4f6cgbe90g45494d889fc7"
msgid "I don't have to <i>count</i>. I just have to hit 'em."
msgstr "<i>셀 필요가</i> 뭐 있어? 그놈들 맞히기만 하면 되지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_BickeringTrainees
#. Speaker = Ide
#. NodeID = c9f49ce6-14d9-f350-f5e2-8c02211bd74c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_BickeringTrainees:c9f49ce6-14d9-f350-f5e2-8c02211bd74c
msgctxt "ha049adacg6f2cg4787gb789gfc140b1901ca"
msgid "You can't even count to a hundred."
msgstr "넌 백까지 셀 줄도 모르잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_BickeringTrainees
#. Speaker = Gan
#. NodeID = f2ea563e-fd48-ee69-3b25-7d50f43bf2ee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_BickeringTrainees:f2ea563e-fd48-ee69-3b25-7d50f43bf2ee
msgctxt "h13e91c0dg2da0g450dgad90gae6aa69bffc3"
msgid "I'm gonna kill five goblins!"
msgstr "난 고블린 다섯 마리는 잡을 거야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_BossyAtPool
#. Speaker = Goblin Sharp-Eye
#. NodeID = 0adc0198-d03d-9b5b-b52c-210e0b0452df
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3b2ae6b6-ca7e-d905-0430-128078b3119f_A = True
#. SetFlags:
#.   Local:
#.     - 3b2ae6b6-ca7e-d905-0430-128078b3119f_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_BossyAtPool:0adc0198-d03d-9b5b-b52c-210e0b0452df
msgctxt "h2965b481g31dbg4b7ag9ec3g968a05f220e5"
msgid "Something sparkly down there?"
msgstr "아래에 반짝이는 거 좀 있어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_BossyAtPool
#. Speaker = Goblin Sharp-Eye
#. NodeID = 0fd1f921-a45b-853c-1a6b-ba3ef19d58e4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3b2ae6b6-ca7e-d905-0430-128078b3119f_C = True
#. SetFlags:
#.   Local:
#.     - 3b2ae6b6-ca7e-d905-0430-128078b3119f_C = False
#.     - 3b2ae6b6-ca7e-d905-0430-128078b3119f_A = False
#.     - 3b2ae6b6-ca7e-d905-0430-128078b3119f_B = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_BossyAtPool:0fd1f921-a45b-853c-1a6b-ba3ef19d58e4
msgctxt "h8d70c622g0019g4ce1gb4a2g1fe03b1c8ada"
msgid "Maybe I should take one of these statues back with me to camp..."
msgstr "이 조각상 하나를 야영지로 들고 돌아가는 것도 괜찮을 것 같은데..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_BossyAtPool
#. Speaker = Goblin Sharp-Eye
#. NodeID = 313b2bcb-56a8-0da5-0d11-2c65ddd35b15
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 3b2ae6b6-ca7e-d905-0430-128078b3119f_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_BossyAtPool:313b2bcb-56a8-0da5-0d11-2c65ddd35b15
msgctxt "h35ba39bcg24cbg4aa9ga661g8f0e3b64d43c"
msgid "Grove's kinda pretty when you look at it."
msgstr "이렇게 보니까 숲도 꽤 예쁘구만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_BossyAtPool
#. Speaker = Goblin Sharp-Eye
#. NodeID = 8ca683ad-41dd-bcb6-ae11-8f5cf050db47
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3b2ae6b6-ca7e-d905-0430-128078b3119f_B = True
#. SetFlags:
#.   Local:
#.     - 3b2ae6b6-ca7e-d905-0430-128078b3119f_C = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_BossyAtPool:8ca683ad-41dd-bcb6-ae11-8f5cf050db47
msgctxt "hd6e8ab69gbf6fg4350gbaebg4ba5f0983b6f"
msgid "Nah. Just the light reflectin' I guess."
msgstr "에이. 그냥 빛 반사 때문이겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CaringForOx
#. Speaker = Eramas
#. NodeID = 207a98f3-87c0-c0ad-f506-50c13735d065
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - b618166c-99f4-1c7a-02b7-32f0f0fbe420_LocalC = True
#. SetFlags:
#.   Local:
#.     - b618166c-99f4-1c7a-02b7-32f0f0fbe420_LocalA = False
#.     - b618166c-99f4-1c7a-02b7-32f0f0fbe420_LocalB = False
#.     - b618166c-99f4-1c7a-02b7-32f0f0fbe420_LocalC = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CaringForOx:207a98f3-87c0-c0ad-f506-50c13735d065
msgctxt "h4bef2b23gcfbfg42efgab98g0358e24c2427"
msgid "They're not getting in. Keep calm, now."
msgstr "여기 못 들어올 거야. 일단 진정해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CaringForOx
#. Speaker = Eramas
#. NodeID = a6d53d32-3b25-e1f4-ef5c-aaedb5f15049
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CaringForOx:a6d53d32-3b25-e1f4-ef5c-aaedb5f15049
msgctxt "h1edab10agd0e6g41e6g9637gfb5c51f7ee5c"
msgid "Unless they get me first, I suppose."
msgstr "내가 먼저 잡히지 않는 한은 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CaringForOx
#. Speaker = Eramas
#. NodeID = afd87987-2f9d-eeee-d428-726dbf906f39
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - b618166c-99f4-1c7a-02b7-32f0f0fbe420_LocalB = True
#. SetFlags:
#.   Local:
#.     - b618166c-99f4-1c7a-02b7-32f0f0fbe420_LocalC = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CaringForOx:afd87987-2f9d-eeee-d428-726dbf906f39
msgctxt "hce26007eg14ecg4104g8949g9f7495610727"
msgid ""
"Going to miss the grass here, girl? Druid grass - makes you good and strong."
msgstr "이곳의 자연을 그리워하게 될 거야, 그치? 드루이드의 자연은 기분 좋고 건강하게 해주거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CaringForOx
#. Speaker = Eramas
#. NodeID = e7a3e216-ffa2-eae1-3bee-76e00885228e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - b618166c-99f4-1c7a-02b7-32f0f0fbe420_LocalA = True
#. SetFlags:
#.   Local:
#.     - b618166c-99f4-1c7a-02b7-32f0f0fbe420_LocalB = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CaringForOx:e7a3e216-ffa2-eae1-3bee-76e00885228e
msgctxt "h1c748e94g14ebg424fg95adg736ed122db18"
msgid "We'll be back on the road soon, girl."
msgstr "곧 다시 떠날거란다, 얘야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CaringForOx
#. Speaker = Eramas
#. NodeID = f1d3817f-1d74-71b6-596f-eeedf991c75a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - b618166c-99f4-1c7a-02b7-32f0f0fbe420_LocalA = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CaringForOx:f1d3817f-1d74-71b6-596f-eeedf991c75a
msgctxt "ha3cf827ag7c8dg4836gb205g47621628db05"
msgid "Easy now! Not going to let the goblins get you."
msgstr "진정해! 고블린들이 널 잡지 못하게 해줄게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CharmedKidStory
#. Speaker = Mirkon
#. NodeID = 0471c17f-5c92-b0c0-6016-6d20a62cb4f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CharmedKidStory:0471c17f-5c92-b0c0-6016-6d20a62cb4f8
msgctxt "hac1b1392gf24fg4913g9649g6856429c591d"
msgid "And Mol saw something glimmering in there?"
msgstr "몰도 거기서 뭔가 빤짝이는걸 봤다고 하던데요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CharmedKidStory
#. Speaker = Mirkon
#. NodeID = 087a6ad5-0002-8394-d5bd-00476a2c51d2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 6a98f294-9f4f-d0b0-1cba-706f1cb15009_Local 4 = True
#. SetFlags:
#.   Local:
#.     - 6a98f294-9f4f-d0b0-1cba-706f1cb15009_Local 4 = False
#.     - 6a98f294-9f4f-d0b0-1cba-706f1cb15009_Local3 = False
#.     - 6a98f294-9f4f-d0b0-1cba-706f1cb15009_Local1 = False
#.     - 6a98f294-9f4f-d0b0-1cba-706f1cb15009_Local2 = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CharmedKidStory:087a6ad5-0002-8394-d5bd-00476a2c51d2
msgctxt "hd27760c8g5357g4f14gb62fg57b642f8b7ce"
msgid "And they're going to kill the goblins, too."
msgstr "그 사람들이 고블린들도 다 무찔러줄 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CharmedKidStory
#. Speaker = Mirkon
#. NodeID = 1472c742-4b78-179a-fa3a-e1fd3022f689
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CharmedKidStory:1472c742-4b78-179a-fa3a-e1fd3022f689
msgctxt "h0f5d1209g82c1g4416g90d7gefa7afdfb3f3"
msgid ""
"I wasn't hungry anymore. And I couldn't feel that scab I got from that gnoll "
"at all."
msgstr "더이상 배고프지도 않았어요. 그리고 놀한테 옮은 피부병도 하나도 안 간지럽고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CharmedKidStory
#. Speaker = Mirkon
#. NodeID = 2bbdd897-34f4-a6be-398a-687c7dabd1c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CharmedKidStory:2bbdd897-34f4-a6be-398a-687c7dabd1c0
msgctxt "hfc46f835g75e0g4127g96f3g516052ba5a25"
msgid "'Cause I can climb the cliffs no problem."
msgstr "왜냐면 절벽을 오르는것 쯤이야 나한텐 껌이거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CharmedKidStory
#. Speaker = Mirkon
#. NodeID = 38e22efd-c05c-ea39-4079-88cb2bd11fc4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CharmedKidStory:38e22efd-c05c-ea39-4079-88cb2bd11fc4
msgctxt "hbd5286ffge7f6g4f57g945cg78fa1345eb35"
msgid "Because that person was a monster hunter, and they killed it!"
msgstr "그 분은 괴물사냥꾼이었는데, 파바박하고 놈을 무찔렀어요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CharmedKidStory
#. Speaker = Mirkon
#. NodeID = 3f8c966c-8cb9-b324-380c-609c6fdf7d9b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CharmedKidStory:3f8c966c-8cb9-b324-380c-609c6fdf7d9b
msgctxt "h43b6fbb0gfda7g4591ga349g136fe80178ee"
msgid "And when I looked up, there was a harpy, ready to tear me to shreds."
msgstr "위를 올려다보니깐, 하피가 날 갈가리 찢어버리려고 했어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CharmedKidStory
#. Speaker = Mirkon
#. NodeID = 5de48100-bb08-4873-f474-a50142b4f2b0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CharmedKidStory:5de48100-bb08-4873-f474-a50142b4f2b0
msgctxt "h53e74151ge308g4070g8621g9502240e4b09"
msgid "Everything felt so nice. I just wanted to get closer."
msgstr "기분이 너무 좋아지더라구요. 저도 모르게 가까이 갔죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CharmedKidStory
#. Speaker = Mirkon
#. NodeID = 6d8b3ace-ab69-dd93-4b9e-a0c065bf0fcd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 6a98f294-9f4f-d0b0-1cba-706f1cb15009_Local1 = True
#.      - 6a98f294-9f4f-d0b0-1cba-706f1cb15009_Local2 = False
#. SetFlags:
#.   Local:
#.     - 6a98f294-9f4f-d0b0-1cba-706f1cb15009_Local1 = False
#.     - 6a98f294-9f4f-d0b0-1cba-706f1cb15009_Local2 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CharmedKidStory:6d8b3ace-ab69-dd93-4b9e-a0c065bf0fcd
msgctxt "he6f2d229geb12g4d83g96eag7c0cc5c3d572"
msgid "And the beach was empty, but there was this... soft music."
msgstr "해변엔 아무도 없었는데, 잔잔한 노랫소리가... 들려왔어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CharmedKidStory
#. Speaker = Mirkon
#. NodeID = 75f3ec23-0b08-d235-bb68-b85f454659b9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 6a98f294-9f4f-d0b0-1cba-706f1cb15009_Local1 = False
#.      - 6a98f294-9f4f-d0b0-1cba-706f1cb15009_Local2 = False
#. SetFlags:
#.   Local:
#.     - 6a98f294-9f4f-d0b0-1cba-706f1cb15009_Local1 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CharmedKidStory:75f3ec23-0b08-d235-bb68-b85f454659b9
msgctxt "hb8380bddg5d54g4595gbd97gb562e14bd263"
msgid "You know how there's this big nest on one of the cliffs?"
msgstr "절벽에 이따만한 둥지가 있는 거 알아요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CharmedKidStory
#. Speaker = Mirkon
#. NodeID = 79163d58-1bae-1b77-84ae-b6a86878a6dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CharmedKidStory:79163d58-1bae-1b77-84ae-b6a86878a6dc
msgctxt "h21b6adb9g6f07g42aagb41fg8a5679df579f"
msgid "And the voice started screaming - saying that I was hers!"
msgstr "그리곤 괴성을 지르기 시작했어요. -내가 자기 거라면서요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CharmedKidStory
#. Speaker = Mirkon
#. NodeID = 890fd81f-a62c-9257-6912-d4de47668613
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 6a98f294-9f4f-d0b0-1cba-706f1cb15009_Local2 = True
#. SetFlags:
#.   Local:
#.     - 6a98f294-9f4f-d0b0-1cba-706f1cb15009_Local3 = True
#.     - 6a98f294-9f4f-d0b0-1cba-706f1cb15009_Local1 = True
#.     - 6a98f294-9f4f-d0b0-1cba-706f1cb15009_Local2 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CharmedKidStory:890fd81f-a62c-9257-6912-d4de47668613
msgctxt "h2a8e292cg8950g4532gbe08g7a24a435e6ab"
msgid "But suddenly someone was there."
msgstr "그때 갑자기 뭔가 나타났어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CharmedKidStory
#. Speaker = Mirkon
#. NodeID = 8d02b034-c1a4-0f9d-0c05-7eab888ed686
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 6a98f294-9f4f-d0b0-1cba-706f1cb15009_Local3 = True
#.      - 6a98f294-9f4f-d0b0-1cba-706f1cb15009_Local1 = True
#.      - 6a98f294-9f4f-d0b0-1cba-706f1cb15009_Local2 = True
#. SetFlags:
#.   Local:
#.     - 6a98f294-9f4f-d0b0-1cba-706f1cb15009_Local 4 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CharmedKidStory:8d02b034-c1a4-0f9d-0c05-7eab888ed686
msgctxt "he9026815g505bg47b8g8e0bgf6f2b9b373b3"
msgid "I was so scared I just hid."
msgstr "너무 무서워서 숨어버렸어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CharmedKidStory
#. Speaker = Mirkon
#. NodeID = 97fa2ed9-3179-552f-a79e-e528e212df25
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CharmedKidStory:97fa2ed9-3179-552f-a79e-e528e212df25
msgctxt "ha9470befgf342g4ab9g864eg47c20b253848"
msgid "But when I looked up, the harpy was gone!"
msgstr "그런데 다시 올려다보니깐, 하피는 온데간데없는 거 있죠!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CharmedKidStory
#. Speaker = Mirkon
#. NodeID = b7a68eaa-1c42-dfe3-50a4-a5d2d5d178ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CharmedKidStory:b7a68eaa-1c42-dfe3-50a4-a5d2d5d178ad
msgctxt "hf27350begfaa3g4ca0ga620g6545b31eb0b7"
msgid "And all the grown-ups and everyone will be all right."
msgstr "그러면 다 큰 어른들이랑 우리 모두 괜찮아질 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CharmedKidStory
#. Speaker = Mirkon
#. NodeID = da36dc18-7376-d2c7-9a03-b91e6179b2b5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CharmedKidStory:da36dc18-7376-d2c7-9a03-b91e6179b2b5
msgctxt "h433002a8gfbc2g4d4cga0c1gf11d58e449c9"
msgid "We'll get out of here. You'll see."
msgstr "우린 여기서 벗어날 거예요. 두고 봐요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CharmedKidStory
#. Speaker = Mirkon
#. NodeID = e0840390-923f-fd4d-1111-f0bb15690ff0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CharmedKidStory:e0840390-923f-fd4d-1111-f0bb15690ff0
msgctxt "h2c38662eg504eg47fcg9becgfce8fe666d20"
msgid "So when I saw there was nobody on the beach, I snuck over."
msgstr "아무도 없는 것 같길래, 몰래 갔죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CharmedKidStory
#. Speaker = Mirkon
#. NodeID = e8bf264d-1306-a50b-3205-ac3c66178daa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CharmedKidStory:e8bf264d-1306-a50b-3205-ac3c66178daa
msgctxt "h032fcabbgc083g4b5eg824dg303de6d15570"
msgid ""
"It was really beautiful. And a voice was saying that everything would be all "
"right."
msgstr "진짜 아름다운 목소리로, 이제 다 괜찮아질 거라면서요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CheckingBarricade
#. Speaker = Lakrissa
#. NodeID = 0852d204-c5a7-4dfd-6207-b7149e27d54d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - bbb2f9a6-33a9-96f5-b8e8-4a5348889699_A = True
#. SetFlags:
#.   Local:
#.     - bbb2f9a6-33a9-96f5-b8e8-4a5348889699_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CheckingBarricade:0852d204-c5a7-4dfd-6207-b7149e27d54d
msgctxt "h48cfe4ccg2ddcg4c47ga166g1429bb56b307"
msgid "Right. Should hold together."
msgstr "좋아. 이 정도면 유지는 되겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CheckingBarricade
#. Speaker = Kaldani
#. NodeID = 4947294a-a948-08bb-729f-66a8fb878f5a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CheckingBarricade:4947294a-a948-08bb-729f-66a8fb878f5a
msgctxt "h7274bdd1g21fag4838gbbf9ga27431f33678"
msgid "Yup. Murderous is one thing, but late?  Beshaba pass over."
msgstr "맞아. 우리 죽이려드는 건 별개로, 늑장도 부린다? 그런 베샤바의 불운은 없길."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CheckingBarricade
#. Speaker = Lakrissa
#. NodeID = 5d720ad3-cb34-bd50-83b6-0ad1ed33a770
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - bbb2f9a6-33a9-96f5-b8e8-4a5348889699_B = True
#. SetFlags:
#.   Local:
#.     - bbb2f9a6-33a9-96f5-b8e8-4a5348889699_C = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CheckingBarricade:5d720ad3-cb34-bd50-83b6-0ad1ed33a770
msgctxt "hfd6a8255g6b4dg4a78gb495g204834a92164"
msgid "Goblins better bloody show up, after all this effort we're putting in."
msgstr "이렇게 고생해놨는데 고블린 녀석들 안 나타나기만 해 봐, 진짜."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CheckingBarricade
#. Speaker = Kaldani
#. NodeID = a0b89cfa-3abe-a97d-6c61-1abb5cbb60d3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CheckingBarricade:a0b89cfa-3abe-a97d-6c61-1abb5cbb60d3
msgctxt "hb20c628agc57bg45bag8399g1fd95d0f2ca3"
msgid "What?"
msgstr "뭐가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CheckingBarricade
#. Speaker = Lakrissa
#. NodeID = a1479362-cd9f-9221-3f29-9f5d8ad35fc6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - bbb2f9a6-33a9-96f5-b8e8-4a5348889699_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CheckingBarricade:a1479362-cd9f-9221-3f29-9f5d8ad35fc6
msgctxt "hb6ba76c2g4d57g4e34ga9b7g91e6693e0a25"
msgid "Think... I'm getting... the hang of this..."
msgstr "이거.. 하도 짓다 보니... 요령까지 붙네..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CheckingBarricade
#. Speaker = Lakrissa
#. NodeID = a38ff4da-0b78-fd37-b8db-c082259fc8db
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - bbb2f9a6-33a9-96f5-b8e8-4a5348889699_C = True
#. SetFlags:
#.   Local:
#.     - bbb2f9a6-33a9-96f5-b8e8-4a5348889699_A = False
#.     - bbb2f9a6-33a9-96f5-b8e8-4a5348889699_B = False
#.     - bbb2f9a6-33a9-96f5-b8e8-4a5348889699_C = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CheckingBarricade:a38ff4da-0b78-fd37-b8db-c082259fc8db
msgctxt "h0dd94a4cge761g4445g9fc0gd9f227a50ec2"
msgid "You think it'll make any difference?"
msgstr "이게 과연 뭐라도 도움이 될까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CheckingBarricade
#. Speaker = Lakrissa
#. NodeID = a5594980-020d-699e-7152-8a01760655a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CheckingBarricade:a5594980-020d-699e-7152-8a01760655a6
msgctxt "h2dc50ff6gcea5g49d6g9a8fg320b1a04a47a"
msgid "All <i>this. </i>Getting ready, like."
msgstr "이 대비라고 해놓은 <i>모든 것</i> 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CheckingBarricade
#. Speaker = Kaldani
#. NodeID = a98cb421-456f-032a-5922-d1cf0b193b7a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CheckingBarricade:a98cb421-456f-032a-5922-d1cf0b193b7a
msgctxt "hd25ea9c6geafcg4652ga684g88fa23b90468"
msgid "I... I don't know."
msgstr "나는...나도 모르겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CheckingBarricade
#. Speaker = Kaldani
#. NodeID = c76bf2b6-fd45-cd90-3271-7f2e7d24e1a1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CheckingBarricade:c76bf2b6-fd45-cd90-3271-7f2e7d24e1a1
msgctxt "h3fed2bd3g95dag4cb1gbfacge61f34259e0d"
msgid "<i>'Should'?</i>"
msgstr "<i>'유지는' 이라고?</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CheckingBarricade
#. Speaker = Lakrissa
#. NodeID = f06b2902-0b66-d5fb-4b55-0e3c53889d15
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CheckingBarricade:f06b2902-0b66-d5fb-4b55-0e3c53889d15
msgctxt "h878c15d6g8346g424agae23g2d095fb76433"
msgid "Well. We won't be long finding out, I suppose."
msgstr "뭐, 어찌 될지는 조만간 알게 될 거 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ChefAndSon
#. Speaker = Okta
#. NodeID = 242cd42e-4f57-6b98-7de4-31dd952e8dba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ChefAndSon:242cd42e-4f57-6b98-7de4-31dd952e8dba
msgctxt "hd112f519g9a83g4cc6gbd24ge399dbe4f21e"
msgid "There's barely any rations left."
msgstr "배급할 죽이 거의 동나버렸구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ChefAndSon
#. Speaker = Ikaron
#. NodeID = 2a3b5a8f-4690-0106-fe34-16098f77456c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ChefAndSon:2a3b5a8f-4690-0106-fe34-16098f77456c
msgctxt "h48e3323ag9e26g41c1g8523gfdc73b578195"
msgid "It'll have to do."
msgstr "어쩔 수 없잖아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ChefAndSon
#. Speaker = Ikaron
#. NodeID = 317eed91-0fa2-2351-7bab-95741ddd54db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ChefAndSon:317eed91-0fa2-2351-7bab-95741ddd54db
msgctxt "h391383fdgbb05g4960gb28agdfb68cd4d281"
msgid "They're cowards, mother. You don't owe them anything."
msgstr "걔들은 비겁자예요, 엄마. 미안해하실 것 없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ChefAndSon
#. Speaker = Okta
#. NodeID = 49251d4c-3d44-ea2c-6140-4b5d2a40619e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_Event_ChefAndSonTalked = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ChefAndSon:49251d4c-3d44-ea2c-6140-4b5d2a40619e
msgctxt "hdf8dd66cg601cg43d6gae41gc4826c556580"
msgid ""
"If I'd known they were leaving, I would have given them an extra helping."
msgstr "그애들이 이리 떠날 줄 알았다면, 좀 더 많이 챙겨줄 걸 그랬어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ChefAndSon
#. Speaker = Ikaron
#. NodeID = 74ca44a6-fe1f-f0d4-9d55-87a7d7c527fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ChefAndSon:74ca44a6-fe1f-f0d4-9d55-87a7d7c527fd
msgctxt "hbd801f2dg4f25g4014g87f9g0042149d0cfd"
msgid "We can't run forever. I'd rather stand and fight."
msgstr "언제까지 도망만 쳐요? 난 차라리 맞서 싸울 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ChefAndSon
#. Speaker = Okta
#. NodeID = 77d00839-97ba-dc04-a62f-b327a6cf4142
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ChefAndSon:77d00839-97ba-dc04-a62f-b327a6cf4142
msgctxt "hc3f9b1e9g46c3g4e01g97d9gb32d0e2d5670"
msgid "But can you really blame them? After Elturel..."
msgstr "걔들을 탓할 수 있는 노릇이니? 엘투렐 일 이래로..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ChefAndSon
#. Speaker = Okta
#. NodeID = b08190c3-540d-d2a7-70d9-c87f581441bb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ChefAndSon:b08190c3-540d-d2a7-70d9-c87f581441bb
msgctxt "h1d5055ddga885g49bcg83d3g13fc825ae826"
msgid "I can't thin the broth much more than this."
msgstr "이미 더는 묽게 만들 수 없을 정도라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ChefAndSon
#. Speaker = Ikaron
#. NodeID = d3f4d3e9-06b8-531b-1a44-ccc91b32f561
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ChefAndSon:d3f4d3e9-06b8-531b-1a44-ccc91b32f561
msgctxt "h111c4c54gf9f2g48b7gae8ega942c84e099f"
msgid "We'll make it last. We always do."
msgstr "물로 양을 불려야죠. 늘 그랬듯이요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ChefAndSonPacking
#. Speaker = Okta
#. NodeID = 1e76468b-ea17-b9ea-0723-ad87603cf287
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ChefAndSonPacking:1e76468b-ea17-b9ea-0723-ad87603cf287
msgctxt "h01e2a9b4g3ca4g4ac7gbd49ga3362535670a"
msgid "Of course. It's a big city, lots of opportunity."
msgstr "물론이지. 큰 도시니까 기회도 많을 게다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ChefAndSonPacking
#. Speaker = Okta
#. NodeID = 340564f9-d51e-d812-695d-7dfa27665fb9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - f3afb428-73fc-2e5c-057b-2e0e5a1b2f1c_A = True
#. SetFlags:
#.   Local:
#.     - f3afb428-73fc-2e5c-057b-2e0e5a1b2f1c_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ChefAndSonPacking:340564f9-d51e-d812-695d-7dfa27665fb9
msgctxt "hb60343eagd2c4g4eeeg8965g40ecf248ca23"
msgid "What do you think of opening a cart in Baldur's Gate?"
msgstr "발더스 게이트에서 노점을 열면 어떨 것 같니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ChefAndSonPacking
#. Speaker = Ikaron
#. NodeID = 3e0fcb85-4b6f-3ac7-afe0-9d186dfbe379
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ChefAndSonPacking:3e0fcb85-4b6f-3ac7-afe0-9d186dfbe379
msgctxt "h81b9921ag8445g446bg8fcbg6533d1e2ad09"
msgid "A cart sounds fine, but do I have to haul it around?"
msgstr "괜찮을 거 같긴 한데, 혹시 그 노점차 내가 끌고 다녀야 해요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ChefAndSonPacking
#. Speaker = Ikaron
#. NodeID = 4e000125-c467-5866-d4fc-d77e416ad5f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ChefAndSonPacking:4e000125-c467-5866-d4fc-d77e416ad5f0
msgctxt "h1cc29af6gada1g41f3ga2e7g8d3c1e9bab0f"
msgid "I won't. I'm not ten anymore."
msgstr "아무렴요. 전 이제 애가 아니라고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ChefAndSonPacking
#. Speaker = Ikaron
#. NodeID = 4f71e32d-ab89-a52c-27cf-883d6f2460e1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - f3afb428-73fc-2e5c-057b-2e0e5a1b2f1c_B = True
#. SetFlags:
#.   Local:
#.     - f3afb428-73fc-2e5c-057b-2e0e5a1b2f1c_B = False
#.     - f3afb428-73fc-2e5c-057b-2e0e5a1b2f1c_A = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ChefAndSonPacking:4f71e32d-ab89-a52c-27cf-883d6f2460e1
msgctxt "hca254f06g137eg4d0cgb306gf2f13606b722"
msgid "Do you think we'll stay in Baldur's Gate long?"
msgstr "발더스 게이트에 터를 잡을 수 있을까요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ChefAndSonPacking
#. Speaker = Ikaron
#. NodeID = 63b3e000-5cf5-cf04-23c1-ec3fb6e56893
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ChefAndSonPacking:63b3e000-5cf5-cf04-23c1-ec3fb6e56893
msgctxt "h41054270g2b70g4de9gb4fbg52e0d1354a52"
msgid "A cart? Like on the street?"
msgstr "노점이요? 길거리 같은 데서요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ChefAndSonPacking
#. Speaker = Okta
#. NodeID = 6b28f969-33da-315c-4520-3c94b1bd203f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ChefAndSonPacking:6b28f969-33da-315c-4520-3c94b1bd203f
msgctxt "hcfa25b3dgc34cg47b6g93e4g290250a2da22"
msgid "Don't let that place cast a shadow on your head forever."
msgstr "거기서 겪은 일 가지고 남은 평생까지 휘둘리면 못 쓴다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ChefAndSonPacking
#. Speaker = Ikaron
#. NodeID = 7d895481-c920-c4ff-9e6b-98f3b8bf4cdd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ChefAndSonPacking:7d895481-c920-c4ff-9e6b-98f3b8bf4cdd
msgctxt "hdb40e88eg06f7g4c8dg80b1gf9274298d2cc"
msgid "Ugh."
msgstr "윽."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ChefAndSonPacking
#. Speaker = Ikaron
#. NodeID = 94c90c8f-e396-15c9-323d-cc94cc9f4d8e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ChefAndSonPacking:94c90c8f-e396-15c9-323d-cc94cc9f4d8e
msgctxt "hf5f7b734g97ceg4453g94d4g588267c3f008"
msgid "But Elturel..."
msgstr "하지만 엘투렐에선..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ChefAndSonPacking
#. Speaker = Okta
#. NodeID = a019c228-2f7c-90f8-d5fd-93171fa262e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ChefAndSonPacking:a019c228-2f7c-90f8-d5fd-93171fa262e2
msgctxt "h82ff6974g14f2g45a3g9871g6f4927d221be"
msgid "Until we make the coin for a proper ox, maybe."
msgstr "대신 끌 황소 살 수 있을 때까진 그래야겠지, 아마도."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ChefAndSonPacking
#. Speaker = Ikaron
#. NodeID = a86edf5d-b429-c0c3-90d8-a435334d18b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ChefAndSonPacking:a86edf5d-b429-c0c3-90d8-a435334d18b1
msgctxt "hb0d4dd2dg29f4g416egbfccga3ea4ac8b313"
msgid "I guess things are already better. I've learned a lot."
msgstr "그래도 예전보단 나아진 것 같아요. 배운 게 많으니까요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ChefAndSonPacking
#. Speaker = Okta
#. NodeID = a914883e-81ea-23c1-f0b9-8c124012fcc8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ChefAndSonPacking:a914883e-81ea-23c1-f0b9-8c124012fcc8
msgctxt "h53f826dege6fag4551ga6c1g74a9916a33c0"
msgid "Don't I know it. But there's two more boxes after this one."
msgstr "누가 모른다니? 아직 실을 상자가 두 개나 더 남아 하는 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ChefAndSonPacking
#. Speaker = Okta
#. NodeID = b55e0342-3fd5-c011-b5df-3aff47c2daf5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ChefAndSonPacking:b55e0342-3fd5-c011-b5df-3aff47c2daf5
msgctxt "hdb8f4e20g9993g40c4gbbbdgdd97d94c14aa"
msgid ""
"Exactly. Noble types won't want a tiefling cookin' for them, but common "
"folk..."
msgstr "그래, 그거. 귀족네들이야 티플링 먹거리에 관심 없겠지만, 서민들이라면..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ChefAndSonPacking
#. Speaker = Okta
#. NodeID = c5c6cc43-c35a-638d-5a08-6a03149fd8de
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ChefAndSonPacking:c5c6cc43-c35a-638d-5a08-6a03149fd8de
msgctxt "h8d61b1b8gfae5g4d93gabb3gc69620608ed3"
msgid "There we go, boy. Now back to packing."
msgstr "장하구나, 얘야. 이제 다시 짐 꾸리자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ChefAndSonPacking
#. Speaker = Ikaron
#. NodeID = cc832292-1c53-6f3b-7bf3-edf6fb006f4b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ChefAndSonPacking:cc832292-1c53-6f3b-7bf3-edf6fb006f4b
msgctxt "h846edbdeg3945g49b1g801dga4714c0857b2"
msgid "*Sigh.*"
msgstr "*하아.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ChefAndSonPacking
#. Speaker = Ikaron
#. NodeID = d1aa08d1-7e8a-7dbb-bc3f-3818530d4ca2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ChefAndSonPacking:d1aa08d1-7e8a-7dbb-bc3f-3818530d4ca2
msgctxt "h4371ecdfgcb8dg4ff8g9b52g9db41f83389d"
msgid "Nn-! No. I've got it!"
msgstr "끙... 아뇨! 괜찮아요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ChefAndSonPacking
#. Speaker = Okta
#. NodeID = d33a04cc-3b28-c16e-cf91-2951d7b2d998
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ChefAndSonPacking:d33a04cc-3b28-c16e-cf91-2951d7b2d998
msgctxt "hfb733731g719eg4d0eg9dc2gf9e13d57bced"
msgid "Don't be breaking your back before we get to Baldur's Gate."
msgstr "발더스 게이트에 닿기도 전에 허리 나가지나 말려무나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ChefAndSonPacking
#. Speaker = Okta
#. NodeID = fcdec382-a7f9-3c42-9a57-ca16b4e5323f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
