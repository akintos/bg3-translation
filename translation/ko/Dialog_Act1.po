msgctxt "h97baeb6egb6beg4ba2ga324g695c894e766c"
msgid ""
"Think you can ignore us? Think you're so high and mighty? You're nothin'. "
"Not compared to us."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Astarion
#. NodeID = 9f0d5eed-daa2-4cc2-ff86-625a5956a0ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:9f0d5eed-daa2-4cc2-ff86-625a5956a0ac
msgctxt "hf4970719gf0a1g4281g9d8cg8a4f2b070b54"
msgid ""
"Oh don't be like that. Not every problem has to be beaten to death, my dear."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
