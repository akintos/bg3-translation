#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_MyconidDrow_Dead:583520b7-4afa-3478-d044-21d32c866365
msgctxt "hf78fb7b0gf4f3g4e1agbfe1gd6546bacce41"
msgid "What were you fighting over?"
msgstr "무엇 때문에 싸운 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_MyconidDrow_Dead
#. Speaker = Player
#. NodeID = 5a36032d-adea-adba-2486-2c25379cbcf3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidDrowDead_State_ToldFurnaceSearch = True
#.      - UND_AdamantineForge_Knows_SawForge = False
#.      - UND_AdamantineForge_Knows_WhatForgeIs = False
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_MyconidDrow_Dead:5a36032d-adea-adba-2486-2c25379cbcf3
msgctxt "h3becfafdgbe95g4b70g9534g68c4b9683b02"
msgid "What is the Adamantine Forge?"
msgstr "아다만틴 대장간이 뭐지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_MyconidDrow_Dead
#. Speaker = Pale Corpse
#. NodeID = 824a278f-6da2-9abc-fbc4-5440a87bc74a
