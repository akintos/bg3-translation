msgctxt "h8b026ee2gef68g4732gbe76ga7a8f6a3aa13"
msgid "I am nature's bulwark. Where good things grow, I lend my protection."
msgstr "나는 대자연의 보루다. 좋은 것들이 자라는 곳에 나는 보호를 제공하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000
#. Speaker = Player
#. NodeID = ac18f6c6-38dd-d969-d85e-fc4e914eb733
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule: PALADIN_DEVOTION
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000:ac18f6c6-38dd-d969-d85e-fc4e914eb733
msgctxt "hbb9da1dcgf2ecg4ee0gbeb8ge3c3a1be05f4"
msgid "To do what is right. To do my duty."
msgstr "옳은 일을 하는 것, 내 의무를 다하는 거지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000
#. Speaker = Player
