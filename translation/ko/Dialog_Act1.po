msgid "<i>AHAHAHAHA!</i>"
msgstr "<i><b>아하하하하!</b></i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PaladinsOfTyr_PAD_KarlachAfterEnraged
#. Speaker = Karlach
#. NodeID = 7abe2f88-ce45-991c-9a0b-7b55400fc86d
