msgctxt "h6c4355adg0d83g42bfg8c07g92e5247fa3ce"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_TavernInvestigation_DesireDoor
#. Speaker = Player
#. NodeID = 9d95a3e7-1e67-3211-05e2-003bb500196d
