msgctxt "h6613322fg1334g4b6egae62g800a30afe928"
msgid "<i>Tsk'va</i>! Where did you -"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing
#. Speaker = Player
#. NodeID = 10baf14d-bb54-612c-57fd-8a16a8e1cb18
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_GithChokepoint_State_SpokeToVoss = True
#.      - GLO_GithChokepoint_Quest_GithLeave = True
#.   Tag:
#.      - GITHYANKI(1) = False
