msgctxt "haa7fd340g2e17g4ed9gad08g8e3662616fad"
msgid "*Your mind lurches, reeling suddenly as if... bitten.*"
msgstr "*뭔가에 깨물린 것처럼 느닷없이 정신이 휘청거립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Trespassing
