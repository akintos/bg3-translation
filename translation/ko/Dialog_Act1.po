#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RatRacket_LocalRat_002:5f9ce332-f8c8-270e-44db-1592e9fd7967
msgctxt "h4879a75dg3ef7g4b12gad7bgd3ca25bbeadb"
msgid ""
"*You feel the rat's impatience - to wriggle between the cracks in the floor, "
"to the safe space beneath.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RatRacket_LocalRat_002
#. Speaker = Narrator
#. NodeID = fde7c734-395c-a0ce-fa46-84afaef26334
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_RatRacket_LocalRat_002_HasMet(1) = False
#.   Tag:
#.      - PETPAL(1) = True
#. SetFlags:
#.   Dialog:
#.     - GOB_RatRacket_LocalRat_002_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RatRacket_LocalRat_002:fde7c734-395c-a0ce-fa46-84afaef26334
msgctxt "hf6c19347g0d63g4e39gbcb9gc4664d73e909"
msgid ""
"*A longing for small spaces, stone walls hugging close. Confining. "
"<i>Comforting.*</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SecludedSpot_Goblin
#. Speaker = Brawler Rancer
#. NodeID = 88b2c885-e0d0-1df7-0797-b121d35d63ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SecludedSpot_Goblin:88b2c885-e0d0-1df7-0797-b121d35d63ae
msgctxt "h6c5928begceaeg4440gb196gb07cf1453128"
msgid "Tha's the that of it. Heh!"
msgstr "그게 그거야. 헤헤헤!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SecludedSpot_Trespassing
#. Speaker = Narrator
#. NodeID = 06d076b7-8f37-6a55-dbf6-ec7c8f29ea17
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
