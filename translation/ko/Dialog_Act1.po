msgctxt "h91124e80g3d5fg4815gb399g177b0f2328d2"
msgid "Arrogant <i>swine</i>."
msgstr "거만한 <i>돼지</i> 같으니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Player
#. NodeID = b717d4f3-8b9f-b889-80e0-e42a00c4a964
#. HandlePath = TaggedText[0].TagText[0]
