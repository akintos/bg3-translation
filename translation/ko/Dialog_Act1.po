msgctxt "h2634c8beg1fc0g4e48g80e6g66db2d162504"
msgid "Tell me about this place, sheep."
msgstr "이곳에 대해 말해 주렴, 양아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_ForestIllusion_IllusionRedcap
