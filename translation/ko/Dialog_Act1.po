msgctxt "hd0c6687cg76fcg45b3g85f9g55de61e83c99"
msgid "<i>Recall what you know of this title.</i>"
msgstr "<i>이 제목에 대해 아는 바를 떠올린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_DisguisedJournal
#. Speaker = Narrator
#. NodeID = e5e0f07e-907d-7270-9e35-453cf0c2c9e6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_FurnaceSearch_HasMet_DisguisedJournal(1) = False
