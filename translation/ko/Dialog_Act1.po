msgctxt "hef5549b7gcd80g47bbgb37ag530a24aa23af"
msgid "Wot you still 'anging around for, devil-girl?"
msgstr "뭐 때문에 아직도 어슬렁거리는 거야, 데빌 아가씨?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinWily
