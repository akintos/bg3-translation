msgctxt "he5977ac0ge9f3g44cfg84e7gbabf127e8408"
msgid "<i>Attack the goblins.</i>"
msgstr "<i>고블린을 공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear
#. Speaker = Halsin
#. NodeID = 0ae5259a-dce4-085a-2341-0e9b34f2f950
