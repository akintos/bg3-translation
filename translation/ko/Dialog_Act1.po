msgctxt "h0eefa51fgd3f0g464fga90fgd28cea648db8"
msgid "I warned you, fleshbag. You'd better run."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DeepHole
#. Speaker = Voice from the Deep Hole
#. NodeID = d10adc35-d73c-5f61-0dfa-714e764738ff
