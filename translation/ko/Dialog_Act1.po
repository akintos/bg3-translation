msgid "What makes that cargo so important?"
msgstr "그 화물이 왜 그렇게 중요한 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02
#. Speaker = Player
#. NodeID = 04408df3-2d63-3952-efd7-b970f82a8c91
