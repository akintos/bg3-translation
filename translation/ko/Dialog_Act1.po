msgctxt "h0af3e6c4g29ccg401fg8e37g94318e710256"
msgid "That's right, keep drinkin!"
msgstr "그렇지, 계속 마셔!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_Trader_AD
#. Speaker = Grat the Trader
#. NodeID = ec20c91c-4716-f37a-ef1c-f7fe8db6ccce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_Trader_AD:ec20c91c-4716-f37a-ef1c-f7fe8db6ccce
msgctxt "h22499a6ag7b7dg40dbgb81bg95492a2d31ae"
msgid "You lot spend more when you're boozed up."
msgstr "네 치들은 취하면 돈을 더 쓰더라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_Trader_AD
#. Speaker = Grat the Trader
#. NodeID = f591e4a6-7825-5cdb-8ea2-2a8405ac412b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - f701a7c7-2431-b6cd-448b-631c39be0215_B = True
#. SetFlags:
#.   Local:
#.     - f701a7c7-2431-b6cd-448b-631c39be0215_C = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_Trader_AD:f591e4a6-7825-5cdb-8ea2-2a8405ac412b
msgctxt "h0dc0c0b4gac2eg4abcgadaeg25f3efc6b4cb"
msgid "Oi! Who took the innkeep's ring? It weren't for sale!"
msgstr "어이! 누가 여관주인 반지 가져갔어? 파는 거 아니라고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_Trader_AD_AfterPoisoning
#. Speaker = Grat the Trader
#. NodeID = be8a6ad1-bcca-c0e0-05a8-af73915f1f84
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_Trader_AD_AfterPoisoning:be8a6ad1-bcca-c0e0-05a8-af73915f1f84
msgctxt "ha197c7d0gf1f5g46c2g9b04gd3dfdf71f941"
msgid "I knew it weren't sanitary."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinGlib_AD_AfterBranding
#. Speaker = Devout Mrak
#. NodeID = 7e7c45d9-c726-a5df-512a-6566632174dd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinGlib_AD_AfterBranding:7e7c45d9-c726-a5df-512a-6566632174dd
msgctxt "h9d64efabge430g44c0g9a04gb4aec2950fba"
msgid "I ain't never felt so strong!"
msgstr "이렇게 강해진 기분은 처음이야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinHeretic_AD_CageOpen
#. Speaker = Brakkal
#. NodeID = 4e03df82-ba62-6160-5e9b-bd28baa1d0bd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinHeretic_AD_CageOpen:4e03df82-ba62-6160-5e9b-bd28baa1d0bd
msgctxt "had137112g9bdag4a74gad1agf635e746ddc1"
msgid "Oh, worg-shite."
msgstr "오, 이런 워그 똥 같으니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinHeretic_AD_ExplosionReaction
#. Speaker = Sharp-Eye Zami
#. NodeID = 63ef559e-31db-4c92-f6a4-06af8ea972a2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinHeretic_AD_ExplosionReaction:63ef559e-31db-4c92-f6a4-06af8ea972a2
msgctxt "h14376714g094bg4c09g878dgcb776ed3aecc"
msgid "I ain't cleanin' up that mess though."
msgstr "저 난리를 치울 생각은 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinHeretic_AD_ExplosionReaction
#. Speaker = Sharp-Eye Zami
#. NodeID = c1c4cacc-c8c6-c5ac-57c0-37feed63eade
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinHeretic_AD_ExplosionReaction:c1c4cacc-c8c6-c5ac-57c0-37feed63eade
msgctxt "h415e11afg6f12g4327gbf78ge44224bff549"
msgid "<i>Tnak</i>! Almost got hit by giblets! Glad we rigged that up, eh?"
msgstr "<i>우왁</i>! 내장에 맞을 뻔했잖아! 우리가 그걸 조작해서 다행이군, 응?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinHeretic_AD_ReleasedReaction
#. Speaker = Sharp-Eye Zami
#. NodeID = 3913ba3e-0814-62d6-8887-d87ceef4f7a2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinHeretic_AD_ReleasedReaction:3913ba3e-0814-62d6-8887-d87ceef4f7a2
msgctxt "h90949daagf2d0g4bdega062g6e3f2cf2e94d"
msgid "Oi! Heretics belong in cages or in pieces. Kill 'em, lads!"
msgstr "이봐! 이단자 놈들은 철창행이나 조각나는 것이 마땅하지. 죽여버려, 친구들!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinJollyAndLush_AD_Tieflings
#. Speaker = Booyahg Shekt
#. NodeID = 30955510-360d-c2a7-8d1a-dd05aef20cf9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinJollyAndLush_AD_Tieflings:30955510-360d-c2a7-8d1a-dd05aef20cf9
msgctxt "hdd17dc84ged7ag4668gbdf4g4e74d6fe22c1"
msgid "Poor bastard. Slave-stock, are ya?"
msgstr "불쌍한 자식. 노예였구나, 맞지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinJollyAndLush_AD_Tieflings
#. Speaker = Tracker Azak
#. NodeID = c82de46f-06a4-3561-c7b9-939e824a184f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinJollyAndLush_AD_Tieflings:c82de46f-06a4-3561-c7b9-939e824a184f
msgctxt "hda79d925g3f1fg4798g89f3g8322596a2954"
msgid "Yeah. An' the one thing I learned down there..."
msgstr "그래. 그리고 그 아래에서 배운 사실 한 가지는..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinJollyAndLush_AD_Tieflings
#. Speaker = Booyahg Shekt
#. NodeID = e438d52a-b45d-2a48-3f44-bc39e5b6525d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinJollyAndLush_AD_Tieflings:e438d52a-b45d-2a48-3f44-bc39e5b6525d
msgctxt "hc2d09cd6g39abg4bb8gb869gf2d95359592f"
msgid "You ever been to the Underdark?"
msgstr "언더다크에 가본 적 있어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinJollyAndLush_AD_Tieflings
#. Speaker = Tracker Azak
#. NodeID = f78c49bc-4d66-4a1c-d0f5-26f752b46b3a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinJollyAndLush_AD_Tieflings:f78c49bc-4d66-4a1c-d0f5-26f752b46b3a
msgctxt "h954aee96g82f3g47adg8220gc97dda67cfda"
msgid ""
"I was <i>born</i> in the Underdark, mate. An' I've got the lash-marks to "
"show fer it."
msgstr "난 언더다크에서 <i>태어났다고</i>, 친구. 그 사실을 보여줄 채찍 자국도 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinJollyAndLush_AD_Tieflings
#. Speaker = Tracker Azak
#. NodeID = fcd0997e-4ee6-24c3-e299-580ec801d819
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinJollyAndLush_AD_Tieflings:fcd0997e-4ee6-24c3-e299-580ec801d819
msgctxt "h911667cag2632g461dgb247g22c812b95c2c"
msgid ""
"...don't matter if you're a slave or a king. Drow'll pluck out yer eyes if "
"you look at 'em wrong."
msgstr "...노예든 왕이든 상관없다는 거야. 드로우를 잘못 쳐다보면 그놈들이 눈깔을 뽑아버릴걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinKing_AD_KingAfterScrying
#. Speaker = Dror Ragzlin
#. NodeID = 08c85920-848f-5e0e-663c-436d6731bb73
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinKing_AD_KingAfterScrying:08c85920-848f-5e0e-663c-436d6731bb73
msgctxt "h9c775667g8046g447bgb416g96e4ab7e8978"
msgid "Rivers and streams'll flow with their blood."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinKing_AD_KingAfterScrying
#. Speaker = Dror Ragzlin
#. NodeID = 0c9e4c43-41a1-a930-23b4-fff053c0af25
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinKing_AD_KingAfterScrying:0c9e4c43-41a1-a930-23b4-fff053c0af25
msgctxt "h4ead8559g1593g4d12g87abg6045bf5b239e"
msgid "You. Will. REIGN!"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinKing_AD_KingAfterScrying
#. Speaker = Dror Ragzlin
#. NodeID = 3434075a-9d2c-457c-4c94-03d37187aae9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinKing_AD_KingAfterScrying:3434075a-9d2c-457c-4c94-03d37187aae9
msgctxt "he5d67f65gdfd1g4d76ga90agbf638711df3f"
msgid "You'll sit at her table. You'll drink from her barrels."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinKing_AD_KingAfterScrying
#. Speaker = Dror Ragzlin
#. NodeID = 56bbca18-9d7f-31c1-68b9-44c395495922
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinKing_AD_KingAfterScrying:56bbca18-9d7f-31c1-68b9-44c395495922
msgctxt "h610451acg5b12g4a65g8358g4b645ddcad4c"
msgid "Listen. The Absolute honours you and slays Her enemies."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinKing_AD_KingAfterScrying
#. Speaker = Dror Ragzlin
#. NodeID = 73a07f9e-e29e-a606-8b61-5ba453be0cfa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinKing_AD_KingAfterScrying:73a07f9e-e29e-a606-8b61-5ba453be0cfa
msgctxt "hb219cd36gbaaag4446g83c4g98168331eb7b"
msgid "Their cities'll be razed to the ground."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinKing_AD_KingAfterScrying
#. Speaker = Dror Ragzlin
#. NodeID = 82dc4c88-7847-3cd5-1252-1680d1f71203
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinKing_AD_KingAfterScrying:82dc4c88-7847-3cd5-1252-1680d1f71203
msgctxt "hdbc0d901g5537g413bg9e08g6562fafbb249"
msgid "And they'll <i>know</i> She is Absolute!"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinKing_AD_KingAfterScrying
#. Speaker = Dror Ragzlin
#. NodeID = d7dac5b0-e585-0b17-70b6-f0c173c18e54
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinKing_AD_KingAfterScrying:d7dac5b0-e585-0b17-70b6-f0c173c18e54
msgctxt "hed873e0dg227fg4bc3gb5f4g93cea4ecd9d6"
msgid "She'll fertilise the fields with the dead."
msgstr "시체를 쌓아 땅을 비옥하게 하실 것이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinKing_AD_KingBeforeScrying
#. Speaker = Dror Ragzlin
#. NodeID = 3bca13b9-77a0-fd89-a961-7d657e38fc12
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_GoblinKingSpeech3 = True
