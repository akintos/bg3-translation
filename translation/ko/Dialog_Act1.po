msgctxt "h24fbd933g0d89g4da6g88cag9bdf0214d107"
msgid "Row-thay."
msgstr "영차."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_CorpseDisposer_Leader
#. Speaker = Brathwen
#. NodeID = 04ddd0db-90c1-1351-a163-6974255a3f10
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_DeadInTheWater_CorpseDisposerLeader_HasMet(1) = False
#.   Tag:
#.      - DEEPGNOME(1) = True
