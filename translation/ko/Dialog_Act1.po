msgctxt "hc7f95122g1065g44f1g8f1ag6111993a89f1"
msgid ""
"<i>Counter her rage with your own, unleashing your battle frenzy within her "
"mind.</i>"
msgstr "<i>당신의 분노를 표출해, 그녀의 정신에 당신의 전투 격노를 불러낸다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ConflictedFlind_Flind
