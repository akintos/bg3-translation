msgctxt "h1ec57c62gffc6g459bg8726g31c88c36ca81"
msgid "Take me with you!"
msgstr "나를 데려가 줘!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerCharmed
#. Speaker = Player
#. NodeID = dca2f7f5-2185-318c-406d-1c4cc0729e0c
