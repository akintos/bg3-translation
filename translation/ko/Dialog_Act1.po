#.     - UND_DeadInTheWater_CorpseDisposerLeader_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_CorpseDisposer_Leader:04ddd0db-90c1-1351-a163-6974255a3f10
msgctxt "h68ac92b4g58d0g439egb375g651d0a0f5974"
msgid "Hey! Get back with the others. <i>Now.</i>"
msgstr "이봐! 다른 놈들 자리로 돌아가. <i>당장.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_CorpseDisposer_Leader
#. Speaker = Brathwen
#. NodeID = 3bc8fa0c-57de-52e0-f590-2e8bd1f284e0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_DeadInTheWater_CorpseDisposerLeader_HasMet(1) = True
#.   Tag:
#.      - DEEPGNOME(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_CorpseDisposer_Leader:3bc8fa0c-57de-52e0-f590-2e8bd1f284e0
msgctxt "hd4ab1f96g0385g4579gbbe3gc131c24e22a6"
msgid "Some of us don't have time to faff about."
msgstr "법석 떨면서 낭비할 시간 없다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_CorpseDisposer_Leader
#. Speaker = Brathwen
#. NodeID = 55ca4897-8e38-7c5f-b370-40d978c54fe6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_DeadInTheWater_CorpseDisposerLeader_HasMet(1) = False
#.   Tag:
#.      - DEEPGNOME(1) = False
#. SetFlags:
#.   Dialog:
#.     - UND_DeadInTheWater_CorpseDisposerLeader_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_CorpseDisposer_Leader:55ca4897-8e38-7c5f-b370-40d978c54fe6
msgctxt "haae7a3d6g18a1g4473g8afbg28911414366e"
msgid "Any of those Absolutists see you muckin' around and you're toast."
msgstr "네가 이렇게 노닥거리는 거 절대자 신도에게 들키면 재미 없을 줄 알아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_CorpseDisposer_Leader
#. Speaker = Brathwen
#. NodeID = f553c3b0-591b-c626-e27c-205da5ba71fd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_DeadInTheWater_CorpseDisposerLeader_HasMet(1) = True
#.   Tag:
#.      - DEEPGNOME(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_CorpseDisposer_Leader:f553c3b0-591b-c626-e27c-205da5ba71fd
msgctxt "hdc31d592gf1c4g49bfg8a30g4cc291e0e785"
msgid "I ain't playing with you, svirfy."
msgstr "너랑 장난칠 시간 없다, svirfy."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Astarion
#. NodeID = 0270e378-6c6f-70bd-05ac-73ce18c0a89e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:0270e378-6c6f-70bd-05ac-73ce18c0a89e
msgctxt "hf543060cg6374g4f98g8eadgfb3d6d34b773"
msgid "Don't waste your time hoping. It's probably long dead."
msgstr "헛된 희망 품으면서 시간 낭비하지 마. 죽은 지 오래 됐을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Player
#. NodeID = 0a226449-7ddd-a008-8874-dfcbc2fa64e0
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_SHAR or PALADIN_SHAR
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:0a226449-7ddd-a008-8874-dfcbc2fa64e0
msgctxt "h6e418d60g89f4g4dfcgb5e3g7ef3493aba7e"
msgid ""
"I hope whatever killed them is still around. I will not have it soil Shar's "
"name."
msgstr "그들을 죽인 자가 아직 근처에 있으면 좋겠군. 놈이 샤의 이름을 더럽히게 두지 않을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Shadowheart
#. NodeID = 0b4dfe64-a490-1ccd-1c5b-1ed6a3ea98dd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ShadowHeart_InParty_Knows_SharWorshipper = True
#. TagRule: CLERIC_SHAR or PALADIN_SHAR
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:0b4dfe64-a490-1ccd-1c5b-1ed6a3ea98dd
msgctxt "h16937702gd51bg43aag9627gb587605c0eb6"
msgid ""
"Indeed. We will avenge them if we can. And who knows? Perhaps other children "
"of Shar are still to be found down here..."
msgstr "물론이지. 우린 할 수 있다면 그들의 복수를 할 거야. 게다가, 다른 샤의 자녀들이 이 아래에 남아있는지 누가 알겠어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Karlach
#. NodeID = 0e1a4042-7ba1-4eee-b236-82b2938d7ff4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_KARLACH(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:0e1a4042-7ba1-4eee-b236-82b2938d7ff4
msgctxt "he99e316cg8956g441cg933cg8ca2d33b0d70"
msgid ""
"I'll keep an eye out. If it's a demon, I'll be able to spot it a mile off."
msgstr "내가 살펴보고 있을게. 만약 그게 데몬이라면, 저 멀리서도 알아챌 수 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Karlach
#. NodeID = 160ea35b-af5c-1b21-c673-c967a6b12c77
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_KARLACH(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:160ea35b-af5c-1b21-c673-c967a6b12c77
msgctxt "h0b305b09gd8d3g47b8gbd34g3ece32dfde5a"
msgid ""
"Whatever killed a bunch of Sharrans might still be down here. Just saying."
msgstr "샤 신도 한 무더기를 죽인 게 뭐든 아직 이 아래 있을 수도 있지. 그냥 해 본 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Player
#. NodeID = 1616e00b-a1a7-594b-691b-919f8841a8be
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:1616e00b-a1a7-594b-691b-919f8841a8be
msgctxt "h5ded6615g4a6dg49c7gb7ebgddd49da58629"
msgid "To the dust! Die in filth!"
msgstr "먼지로 돌아가라! 오물 속에서 죽어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Player
#. NodeID = 1a15be9d-4183-cfdf-204e-c7b704d6d1a5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:1a15be9d-4183-cfdf-204e-c7b704d6d1a5
msgctxt "h523a6406g1c26g442egba30gced208e66388"
msgid "<i>Try to bow in respect for the dead.</i>"
msgstr "<i>죽은 자를 기리기 위해 목례한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Player
#. NodeID = 1ec286db-ca06-9de5-c668-dab1122f3fc3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:1ec286db-ca06-9de5-c668-dab1122f3fc3
msgctxt "he9777937g7193g4c4bg96e6geef4d304bde8"
msgid ""
"I hope whatever killed them is still around. I will not have it soil Shar's "
"name."
msgstr "그들을 죽인 자가 아직 근처에 있으면 좋겠군. 놈이 샤의 이름을 더럽히게 두지 않을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Lae'zel
#. NodeID = 2946a375-3aec-e90b-9ee7-0b06c6b26456
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(1) = True
#.   Tag:
#.      - REALLY_LAEZEL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:2946a375-3aec-e90b-9ee7-0b06c6b26456
msgctxt "h67b9d687g0379g4a69g9f8cg5cd9a0f7ab71"
msgid "Enough. Whatever your petty squabbles, let them rot with these corpses."
msgstr "됐어. 그 하찮은 일로 옥신각신하는 건 집어치우고, 그냥 이 놈들 썩게 놔둬."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Lae'zel
#. NodeID = 2cea73a0-3b26-4aa1-bc5a-597e3b552862
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(1) = True
#.   Tag:
#.      - REALLY_LAEZEL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:2cea73a0-3b26-4aa1-bc5a-597e3b552862
msgctxt "h6e330e39gdad8g4dd9gaf1dg6ed740ea19d8"
msgid "Yes, we should press forward. These dead have no more tales to tell."
msgstr "그래, 계속 전진해야 해. 죽은 자들은 더 이상 말이 없는 법이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Wyll
#. NodeID = 2ea05e4e-7e1b-8181-7cbb-625d6a2d1d85
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_WYLL(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:2ea05e4e-7e1b-8181-7cbb-625d6a2d1d85
msgctxt "h092a11b3g4d26g491fga928g077bb5359367"
msgid ""
"Let's come back to this later, yeah? We've got more pressing matters afoot."
msgstr "이 이야기는 나중에 하자, 응? 더 중요한 문제가 있잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Karlach
#. NodeID = 34f22ae1-9b8f-9306-09f8-d645ad4d8f12
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_KARLACH(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:34f22ae1-9b8f-9306-09f8-d645ad4d8f12
msgctxt "h05ea15eegc5a4g4bceg8cf2g72821fde7513"
msgid "I think the evil god of loss can avenge herself, if she needs to."
msgstr "내 생각에 상실의 악신은 필요하면 자기 스스로 복수할 수 있을걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Astarion
#. NodeID = 35b28db9-27e6-5535-d33c-ef8b96f28472
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:35b28db9-27e6-5535-d33c-ef8b96f28472
msgctxt "h2c66febfg5c32g4598gb4beg7ed33fc70ce5"
msgid ""
"Powerful enough to take her own revenge, I'm sure. No need for us to get "
"involved."
msgstr "확실히 그녀 자신의 복수를 하기에는 충분할 정도로 강력하겠지. 우린 여기에 관여할 필요 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Narrator
#. NodeID = 3657c80e-e242-3283-e74a-63d7172128ff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:3657c80e-e242-3283-e74a-63d7172128ff
msgctxt "h0bacbb32g2b04g4a93ga295g043043c335ea"
msgid ""
"*As you look at the skeletons, you realise they are all clad in the same "
"dark armour.*"
msgstr "*당신은 그 유골들을 보고, 그들 전원이 모두 어두운 색의 갑옷을 입고 있다는 걸 알아차립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Wyll
#. NodeID = 3b112737-2ced-424c-b434-d2e2ec1bbfd8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_WYLL(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:3b112737-2ced-424c-b434-d2e2ec1bbfd8
msgctxt "ha5948f30g3ba3g41d7gb93bgfaec356e6550"
msgid ""
"Let's get moving, then. Once we fill our packs with what we can carry, of "
"course."
msgstr "그럼 계속 이동하도록 하자. 물론 챙길 거 다 챙기고 나서 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Narrator
#. NodeID = 3ba6aa68-611b-d331-210a-8baf7edaf5ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:3ba6aa68-611b-d331-210a-8baf7edaf5ea
msgctxt "h5fa46d6agd105g4daega792gc11e16205cfc"
msgid "*You see nothing special - just torn and faded velvet tunics.*"
msgstr "*특이한 점은 보이지 않습니다. 그저 찢어지고 색 바랜 벨벳 웃옷일 뿐입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Wyll
#. NodeID = 3ca29588-b15b-44ee-e366-0daf3defb27f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_WYLL(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:3ca29588-b15b-44ee-e366-0daf3defb27f
msgctxt "hc8e83595g7ec3g4ce5gabbcg94df36ef5c10"
msgid ""
"Now, now. Take a breath, count to ten. This battle's been long-finished - no "
"reason to fight it again."
msgstr "그래, 그래. 심호흡 좀 하고, 열 까지 세. 이 전투는 한참 전에 끝난 거야. 우리가 다시 싸울 필요는 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Karlach
#. NodeID = 40202953-5d02-4ad0-93b3-0e521007fe0a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_KARLACH(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:40202953-5d02-4ad0-93b3-0e521007fe0a
msgctxt "h21a58b6cgca79g465fgb306g17439206504b"
msgid "You took the words right out of my mouth, soldier."
msgstr "딱 내가 하고 싶었던 말이야, 신참."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Gale
#. NodeID = 436eee67-6f14-466f-a8db-28764ce9617b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:436eee67-6f14-466f-a8db-28764ce9617b
msgctxt "habd2f133g4868g46f0gbf28g2898f72469d0"
msgid "Look at those uniforms. They must have belonged to some kind of sect."
msgstr "이 제복을 좀 봐. 무슨 교파의 것이었던 게 확실해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Gale
#. NodeID = 4bc48d5e-4495-38cc-2f71-716a5c275854
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_GALE(6) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:4bc48d5e-4495-38cc-2f71-716a5c275854
msgctxt "h0a6840e5g4c32g432ag92aag8073d3cbc41d"
msgid ""
"Don't turn on each other. If whatever managed to murder a group of Sharrans "
"is still around, we had better watch our step."
msgstr "서로에게 등을 돌리지 마. 이 샤 신도 집단을 살해한 존재가 아직도 근처에 머무르고 있다면, 우리도 조심하는 게 좋을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Lae'zel
#. NodeID = 4d5763aa-7bae-da5d-3eac-5156388ba498
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(1) = True
#.   Tag:
#.      - REALLY_LAEZEL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:4d5763aa-7bae-da5d-3eac-5156388ba498
msgctxt "h6e7fe404gf19bg4831g85c0gfe9df1b4596f"
msgid ""
"Bah - let Shar exact her own revenge, if she's so inclined. Our concerns lie "
"far elsewhere."
msgstr "쳇, 샤의 복수는 샤가 내킬 때 알아서 하게 냅둬. 우리 관심사는 한참 먼 곳에 있다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Lae'zel
#. NodeID = 4dd89829-b224-417f-bf94-ea07165219fa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(1) = True
#.   Tag:
#.      - REALLY_LAEZEL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:4dd89829-b224-417f-bf94-ea07165219fa
msgctxt "h5ab28313g684eg4887gbefbg307ec4309be9"
msgid ""
"Yes, we should press forward. But let's not presume the past always remains "
"buried."
msgstr "그래. 우린 계속 전진해야 해. 그치만 과거의 일이 항상 묻힌 채 있을 거라고 속단하지는 말자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Lae'zel
#. NodeID = 4f10e6ea-1454-9581-5079-9c09d4b53f7a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:4f10e6ea-1454-9581-5079-9c09d4b53f7a
msgctxt "h4d173a59g3b56g4c3egb50cg9279484d811c"
msgid ""
"Shar's name is no more our concern than a gnat's egg. Turn your attentions "
"to something of actual import."
msgstr "샤의 명성은 지금 우리가 신경쓸 부분이 아니야. 정말로 중요한 것에 집중을 좀 하라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Astarion
#. NodeID = 5376d011-cde4-4be6-99c1-9d293aea6cc2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:5376d011-cde4-4be6-99c1-9d293aea6cc2
msgctxt "h8210ec6fg940fg4185ga281gc697fcaae2a7"
msgid "Cut down and left to rot. Such fine armour deserved better."
msgstr "그렇게 멋진 갑옷이, 그저 베어지고 썩을 때까지 방치되었다니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Shadowheart
#. NodeID = 53aa9be4-45e9-4691-b70f-34eaa21316f6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(2) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:53aa9be4-45e9-4691-b70f-34eaa21316f6
msgctxt "h5f7fa4d0g55aag4ef3g94d5ga7412d2aaa59"
msgid ""
"As you like. Hopefully my own remains are treated with a little more "
"dignity, when the time comes..."
msgstr "원하는 대로 해. 그래도 내가 죽게 됐을 때 내 시신은 좀 더 존엄하게 다루어줬으면 좋겠네..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Wyll
#. NodeID = 56077fd9-1914-4be7-814e-c5ccf3c601ee
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_WYLL(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:56077fd9-1914-4be7-814e-c5ccf3c601ee
msgctxt "h12999c53g2cb2g4281ga92fg8253b5d4e6f1"
msgid ""
"If we must. Oh, but imagine what tales these bones might tell if they could."
msgstr "그래야만 한다면. 그래도 한번 상상해 봐. 이 뼈다귀들이 우리에게 어떤 이야기를 전해줄 수 있었을지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Shadowheart
#. NodeID = 5df4424c-1c09-4d82-bca2-4e793be44517
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ShadowHeart_InParty_Knows_SharWorshipper = False
#. SetFlags:
#.   Global:
#.     - UND_DarkJusticiarsCorpses_Recognized = True
#.     - UND_DarkJusticiars_Quest_FoundCorpses = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:5df4424c-1c09-4d82-bca2-4e793be44517
msgctxt "h318cba14g23c5g4b27ga508ga00751573b34"
msgid ""
"Dark Justiciar uniforms... these were Shar worshippers - her most elite "
"warriors. Curious."
msgstr "다크 저스티시어 제복... 이들은 샤의 신도였어. 여신님의 최정예 전사들이었지. 흥미롭군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Player
#. NodeID = 64f0c3ca-e1de-a0e7-d864-b7919bdfed76
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:64f0c3ca-e1de-a0e7-d864-b7919bdfed76
msgctxt "h32d8d37ag3653g483dgb779g27cd5317074b"
msgid "Ominous. Let's not linger."
msgstr "불길하군. 너무 오래 머물러있진 말자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Gale
#. NodeID = 686a3a7a-b478-4cd9-b5ea-ac35c0a721df
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_GALE(6) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:686a3a7a-b478-4cd9-b5ea-ac35c0a721df
msgctxt "hb94f97ceg6b09g49e4ga7a4g823ebecca55b"
msgid ""
"Let's not. But a word of warning: down here in the Underdark, few dangers "
"ever truly die."
msgstr "그러지 말자. 하지만 경고의 말 하나 하지. 이 언더다크 아래에서는, 진짜 죽어 사라진 위험은 별로 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Lae'zel
#. NodeID = 6ea8fc6c-c0a9-4510-9c36-2edfc21d12c5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:6ea8fc6c-c0a9-4510-9c36-2edfc21d12c5
msgctxt "hb9c3b224gd6dfg4227gabb7g77fa2b5d8381"
msgid "Unusually robust uniforms - warriors fallen in battle, perhaps."
msgstr "특이할 정도로 튼튼한 제복이야. 전투에서 쓰러진 전사들인 것 같네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Wyll
#. NodeID = 713c22a0-1960-96c4-7279-99984d38eda9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:713c22a0-1960-96c4-7279-99984d38eda9
msgctxt "h5f80acfbgce5dg41b6g896ag9c479ee46982"
msgid ""
"If their killer's still around, it's not Shar's name I'm most interested in "
"saving."
msgstr "이들을 죽인 것이 아직 근처에 있다면, 샤의 명예를 지키는 건 내 관심사가 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Shadowheart
#. NodeID = 730e5b87-39d1-a63a-4131-feb4db07d6b9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ShadowHeart_InParty_Knows_SharWorshipper = True
#. SetFlags:
#.   Global:
#.     - UND_DarkJusticiars_Quest_FoundCorpses = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:730e5b87-39d1-a63a-4131-feb4db07d6b9
msgctxt "h3cc70fe0ga9ddg456ega008g688e6280b125"
msgid ""
"Dark Justiciar uniforms... these were Shar worshippers - the same as me."
msgstr "다크 저스티시어 제복... 이들은 나와 마찬가지로 샤 신도였어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Shadowheart
#. NodeID = 759c5ef2-ade1-41f1-ad9d-db7983349fab
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(2) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:759c5ef2-ade1-41f1-ad9d-db7983349fab
msgctxt "h192b7908ge946g433bgbd38g959766d075ec"
msgid ""
"As you like. But don't presume whatever killed them is a thing of the past. "
"Some battles span centuries."
msgstr ""
"내키는 대로. 하지만 그들을 죽인 것이 무엇이든 간에 그게 지난 일일 거라고 짐작하지는 마. 어떤 전투는 수백 년이 지나도 끝나지 않거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Narrator
#. NodeID = 7c6d658e-e328-3172-c6ad-26fbd7c9e7b3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_DarkJusticiarsCorpses_Recognized = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:7c6d658e-e328-3172-c6ad-26fbd7c9e7b3
msgctxt "h31f0d8b0gbc22g498dga6b0g6e9661bd3a3d"
msgid ""
"*Among the various fabrics, you recognise the unmistakable symbol of Shar, "
"the Dark Lady.*"
msgstr "*당신은 다양한 직물 사이에서, 어둠의 여인, 샤의 상징을 분명히 알아봅니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Wyll
#. NodeID = 7fae55a9-5318-da75-83db-c1b9bea998de
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:7fae55a9-5318-da75-83db-c1b9bea998de
msgctxt "hedcee215g8497g4d00gb93eg1bd5efa271d4"
msgid "Let's hope whoever killed them has long since marched on."
msgstr "저 자들을 죽인 것이 무엇이든 간에, 오래 전에 지나가버렸길 바라자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Shadowheart
#. NodeID = 802946ab-6a9e-b1df-e008-a8d4a4248ba5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ShadowHeart_InParty_Knows_SharWorshipper = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:802946ab-6a9e-b1df-e008-a8d4a4248ba5
msgctxt "h41519170g1461g434ag82ddg33078c489fd4"
msgid "Watch your tongue - these were my brethren."
msgstr "말 조심해. 이들은 내 사람들이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Wyll
#. NodeID = 8602ce00-8905-6db9-ad6d-783139c22c62
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:8602ce00-8905-6db9-ad6d-783139c22c62
msgctxt "hd3ab5bffg115fg4d42ga91fg75d5c61c508c"
msgid "Let us do what we can to avoid their fate, then."
msgstr "그러면, 그들과 같은 운명을 피하기 위해 우리가 할 수 있는 걸 하도록 하자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Karlach
#. NodeID = 874caff2-726b-e9cd-71ea-72c0d9d84707
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:874caff2-726b-e9cd-71ea-72c0d9d84707
msgctxt "h1ac43639gc650g457egae65g4912a0bb280f"
msgid ""
"Whatever killed a bunch of Sharrans might still be down here. Just saying."
msgstr "샤 신도 한 무더기를 죽인 게 뭐든 아직 이 아래 있을 수도 있지. 그냥 해 본 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Gale
#. NodeID = 8845f492-1d43-fdf0-c1c4-d415dfd08451
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:8845f492-1d43-fdf0-c1c4-d415dfd08451
msgctxt "h437a6cb6g6df3g4f14g937fg14d8cb3149b0"
msgid ""
"Still, if whatever managed to murder a group of Sharrans is still around, we "
"had better watch our step."
msgstr "그래도, 이 샤 신도 집단을 살해한 존재가 아직도 근처에 머무르고 있다면, 우리도 조심하는 게 좋을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Astarion
#. NodeID = 88b2a05e-8a07-6ba2-8369-5079f05ae387
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_ASTARION(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:88b2a05e-8a07-6ba2-8369-5079f05ae387
msgctxt "h5559ff7fg852dg4968gbe65g2fc3a7570e90"
msgid ""
"By all means, avenge Shar, but can we do it later? The worm is more "
"important than your piety."
msgstr "아무렴, 복수를 하고 싶으면 네 맘대로 해. 그런데 좀 나중에 하면 안될까? 네 신앙심 보다는 머릿속의 벌레가 더 중요하거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Player
#. NodeID = 91e8d07c-9c2c-4b55-e343-a28bd5ec2510
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:91e8d07c-9c2c-4b55-e343-a28bd5ec2510
msgctxt "hb54f5dc6ga5dcg44acgbfd8g2ddb2b1319c4"
msgid "Shar worshippers. Better off dead."
msgstr "샤 신도들이군. 죽어서 잘 됐어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Gale
#. NodeID = 97a29644-ef65-41f2-8a79-17c4105a3610
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_GALE(6) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:97a29644-ef65-41f2-8a79-17c4105a3610
msgctxt "h57fd4c1bgfa71g4699g8c91g9500033a9a3d"
msgid "Down here in the Underdark, few dangers ever truly die."
msgstr "이 언더다크 아래에서는, 진짜 죽어 사라진 위험은 별로 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Lae'zel
#. NodeID = 98e0850f-987b-944a-c876-3e2af6a0c3ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:98e0850f-987b-944a-c876-3e2af6a0c3ae
msgctxt "hf2a1c9a7g5b31g4169ga4c7gef92d140b0bf"
msgid "And better off still than being skewered by the point of my blade."
msgstr "내 칼 끝에 꿰뚫려 꼬챙이가 되는 것보단 낫겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Narrator
#. NodeID = 9b99b519-b3a6-3e57-bdc5-f878a7e5ced9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_DarkJusticiarsCorpses_Recognized = True
#. TagRule: CLERIC_SHAR or PALADIN_SHAR
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:9b99b519-b3a6-3e57-bdc5-f878a7e5ced9
msgctxt "h7d1052e8gf215g405bg8a7ag000b21c4fccb"
msgid ""
"*You immediately recognise the symbol of your Lady. You know these uniforms.*"
msgstr "*당신은 당신이 섬기는 여신의 상징을 바로 알아봅니다. 당신은 이 제복을 알고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Narrator
#. NodeID = 9db1187f-2c9f-29fe-99d2-30f198aaf2fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:9db1187f-2c9f-29fe-99d2-30f198aaf2fe
msgctxt "h145102a1ga203g4a5bg80e3g97f9a53fb1c0"
msgid ""
"*These people were Dark Justiciars, a reviled order within Shar's priesthood "
"- one whose rite of entry includes killing a cleric of Selûne.*"
msgstr ""
"\"이들은 다크 저스티시어로, 샤 교단의 악랄한 기사단입니다. 그 입단 의식에는 셀루네의 성직자를 죽이는 것도 포함되어 있었습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Player
#. NodeID = 9dee2089-95f9-90ff-ecbc-a9fdff14cd10
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:9dee2089-95f9-90ff-ecbc-a9fdff14cd10
msgctxt "h501a9245g0327g471dg8881gbb60c5059137"
msgid ""
"No use trying to figure out what happened a hundred years ago. Let's focus "
"on our problems at hand."
msgstr "백 년 전에 일어난 일을 알아내려고 하는 건 소용이 없어. 당면한 문제에 집중하자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Astarion
#. NodeID = a0ed4cb7-2fc2-89c0-16f0-0d2d67666944
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_ASTARION(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:a0ed4cb7-2fc2-89c0-16f0-0d2d67666944
msgctxt "hc35d81c9gb3b5g4d07g94b6gb85cc21beaac"
msgid ""
"I'm sure Shar is powerful enough to take her own revenge. No need for us to "
"get involved."
msgstr "확실히 샤는 그녀 자신의 복수를 하기에 충분할 정도로 강력하겠지. 우린 여기에 관여할 필요 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Player
#. NodeID = a36690e9-54e1-ec10-a95b-3db23c494c20
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:a36690e9-54e1-ec10-a95b-3db23c494c20
msgctxt "hbe2d3d2cg202eg4fa4gb4b7gb12228566f8d"
msgid "Something powerful killed them. We must be careful."
msgstr "강력한 존재가 그들을 죽였어. 우리도 조심해야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Astarion
#. NodeID = a4a8da02-303c-fd0e-f554-9cbf5cbd2c23
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_ASTARION(4) = True
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:a4a8da02-303c-fd0e-f554-9cbf5cbd2c23
msgctxt "h8fb48019g8ac5g4c3fgbd6egf9128f8a7d55"
msgid "Don't be touchy. I'm sure he meant 'better off dead' as a compliment."
msgstr "과민반응하지 마. '죽어서 잘 됐다'는 말은 그냥 칭찬인 게 확실해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Astarion
#. NodeID = a4a8da02-303c-fd0e-f554-9cbf5cbd2c23
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_ASTARION(4) = True
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:a4a8da02-303c-fd0e-f554-9cbf5cbd2c23
msgctxt "h3c51f8e5gb264g435cgb207g54e318650d65"
msgid "Don't be touchy. I'm sure she meant 'better off dead' as a compliment."
msgstr "과민반응하지 마. '죽어서 잘 됐다'는 말은 그냥 칭찬인 게 확실해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Astarion
#. NodeID = a4a8da02-303c-fd0e-f554-9cbf5cbd2c23
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_ASTARION(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:a4a8da02-303c-fd0e-f554-9cbf5cbd2c23
msgctxt "he816d678g2298g49adga298g1083f1be353b"
msgid "Don't be touchy. I'm sure they meant 'better off dead' as a compliment."
msgstr "과민반응하지 마. '죽어서 잘 됐다'는 말은 그냥 칭찬인 게 확실해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Gale
#. NodeID = a7a0de4f-c48d-683b-86c1-630c294735ed
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_GALE(6) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:a7a0de4f-c48d-683b-86c1-630c294735ed
msgctxt "h11133c1dg2c02g454aga464g9547828cbf3d"
msgid ""
"Still, if whatever managed to murder a group of Sharrans is still around, we "
"had better watch our step."
msgstr "그래도, 이 샤 신도 집단을 살해한 존재가 아직도 근처에 머무르고 있다면, 우리도 조심하는 게 좋을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Narrator
#. NodeID = a91101b7-e631-5d8d-f600-fd7bc6dfe084
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:a91101b7-e631-5d8d-f600-fd7bc6dfe084
msgctxt "h82f3d188g7c57g45f3g8220g0a13f32fb206"
msgid ""
"*Your wicked heart won't mourn. Deaths are to be celebrated. Every one.*"
msgstr "*당신의 사악한 마음은 애도하지 않습니다. 죽음은 축하할 일입니다. 모든 죽음이 말이죠.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Narrator
#. NodeID = abff9aeb-c323-6739-962e-78643a1ccc65
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_DarkJusticiarsCorpses_Recognized = True
#. TagRule: CLERIC_SELUNE or PALADIN_SELUNE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:abff9aeb-c323-6739-962e-78643a1ccc65
msgctxt "h116d66f6g57a8g4e39g9565gfed34faa75cd"
msgid ""
"*You immediately recognise the symbol of the Dark Lady - and you realise you "
"know these uniforms.*"
msgstr "*당신은 어둠의 여인 샤의 상징을 즉시 알아봅니다. 당신은 이 제복에 대해 알고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Karlach
#. NodeID = ad503b98-c99b-45a5-d5ca-2953f6190b9a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:ad503b98-c99b-45a5-d5ca-2953f6190b9a
msgctxt "h14dd8954g05cbg4873ga4a3g99fec0882fac"
msgid ""
"Let's just hope whatever managed to plough through 'em is long dead, too."
msgstr "뭐가 쓸고 지나갔든 오래 전 일이기나 바라자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Gale
#. NodeID = ae0faea3-ba72-d1f2-7a19-ce0a4b1d19f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:ae0faea3-ba72-d1f2-7a19-ce0a4b1d19f8
msgctxt "h3b3e2b9fg779cg4bdegbce9gb2dfeae952b7"
msgid ""
"Maybe. But if whatever managed to murder a group of Sharrans is still "
"around, we had better watch our step."
msgstr "그럴지도. 그래도 이 샤 신도 집단을 살해한 존재가 아직도 근처에 머무르고 있다면, 우리도 조심하는 게 좋을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Player
#. NodeID = b1c6720f-3aca-cbb2-adab-372c3f1060c1
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:b1c6720f-3aca-cbb2-adab-372c3f1060c1
msgctxt "hd1e73e74g1fd8g45cegbfc4gff55bb0e3a3a"
msgid "<i>Bow down and inspect the corpses more closely.</i>"
msgstr "<i>고개를 숙여 시체를 더 가까이에서 살펴본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Karlach
#. NodeID = b1f04b75-eba7-7e34-4b06-e13d040da744
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:b1f04b75-eba7-7e34-4b06-e13d040da744
msgctxt "h929e77fcgb308g4f17gbb34g33cb2ed42754"
msgid "Be careful what you wish for, soldier."
msgstr "뭘 원하는지 신중하게 생각해, 신참."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Player
#. NodeID = b36f23c4-75dd-3f20-cefe-aa689b3b7f91
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:b36f23c4-75dd-3f20-cefe-aa689b3b7f91
msgctxt "hf2f833d1g29c2g4e61g803bg62f67eed5773"
msgid "Allow the expert to explore these bones a touch."
msgstr "전문가가 이 뼈 좀 만져 보게 해 줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Lae'zel
#. NodeID = b4c818e3-135b-e7c9-cf68-1f1f44618d0a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:b4c818e3-135b-e7c9-cf68-1f1f44618d0a
msgctxt "h02a6cf80g5b8cg4efdg8afcgbb76298373cd"
msgid "And she has since exacted her revenge, undoubtedly."
msgstr "분명 그 후로 지금까지 쭉 복수를 원했겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Player
#. NodeID = b4ca9fa9-a9e2-d1be-ac6a-0f00f650ef0a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:b4ca9fa9-a9e2-d1be-ac6a-0f00f650ef0a
msgctxt "hebbd5aa9gcdf5g4c14ga12dg8d1e4e1452a2"
msgid "Whatever killed them made an enemy of a powerful goddess."
msgstr "그들을 죽인 게 무엇이든 간에 강력한 여신의 적이 되길 자처한 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Lae'zel
#. NodeID = bb7025e9-5c41-c1f8-4894-0b8388150310
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(1) = True
#.   Tag:
#.      - REALLY_LAEZEL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:bb7025e9-5c41-c1f8-4894-0b8388150310
msgctxt "h2f63e076g384cg4331gb22egf73027e26d7b"
msgid ""
"Bah - let Shar exact her own revenge, if she's so inclined. Our concerns lie "
"far elsewhere."
msgstr "쳇, 샤의 복수는 샤가 내킬 때 알아서 하게 냅둬. 우리 관심사는 한참 먼 곳에 있다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Astarion
#. NodeID = bee8dedc-32db-40b1-9f0c-ced57051e202
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_ASTARION(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:bee8dedc-32db-40b1-9f0c-ced57051e202
msgctxt "h0664542bgc7b4g450dgae7bgb1596fa8f065"
msgid ""
"Yes, there's not much we can do for dusty old soldiers. Let's get moving."
msgstr "그래, 먼지 앉은 과거의 병사들을 위해 우리가 해줄 수 있는 건 별로 없지. 움직이자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Astarion
#. NodeID = bfa092b6-2faf-4e26-90a3-2a38599ce86b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_ASTARION(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:bfa092b6-2faf-4e26-90a3-2a38599ce86b
msgctxt "h74b4f23ege863g480aga6d0g022af03e622c"
msgid "Agreed. Let's go, we have places to be."
msgstr "알았어. 움직이자. 우리는 가야 할 곳이 있잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Player
#. NodeID = c185b5f2-b2e6-e85e-d5aa-af96f95e8d99
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:c185b5f2-b2e6-e85e-d5aa-af96f95e8d99
msgctxt "h8f1b647eg91bfg4ae1g889ege91cc45b352d"
msgid "<i>Try to bow in respect for the dead.</i>"
msgstr "<i>죽은 자를 기리기 위해 목례한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Gale
#. NodeID = c8c6a0f5-b5f9-88b8-52e6-711d9b203001
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_GALE(6) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:c8c6a0f5-b5f9-88b8-52e6-711d9b203001
msgctxt "h839829f6g5548g4048ga57bg0184fc6d38a8"
msgid ""
"Whatever it was that killed them, if it managed to murder a group of "
"Sharrans, we had better watch our step."
msgstr "그들을 죽인 게 무슨 존재인지는 모르겠지만, 그 존재가 이 샤 신도들을 살해한 게 맞다면 우리도 조심하는 게 좋을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Karlach
#. NodeID = ca8865aa-ec1e-21b0-1f0c-f377e56350fa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_KARLACH(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:ca8865aa-ec1e-21b0-1f0c-f377e56350fa
msgctxt "h79fb0e21g0323g4b7dgb9e3g03638ff50e99"
msgid "Better dead than stuck down here. Right?"
msgstr "요 아래 갇혀 있느니 죽는 게 낫지. 안 그래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Astarion
#. NodeID = ceb03429-2a75-66b5-2876-12c7efbfa30f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:ceb03429-2a75-66b5-2876-12c7efbfa30f
msgctxt "hae9f881dgf2e7g4532gb3e1ge5e43c6cfbfc"
msgid ""
"Of course, being dead doesn't stop <i>everyone </i>in their tracks. But "
"hopefully it's somewhere quiet, decaying peacefully."
msgstr "물론, 죽는다고 해서 <i>모두가</i> 멈추진 않아. 그래도 어딘가 조용한 곳에서 평화롭게 썩어가고 있길 바라야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Astarion
#. NodeID = d2b0059d-abc8-fc50-a301-73f63f5b7c6b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:d2b0059d-abc8-fc50-a301-73f63f5b7c6b
msgctxt "h20acfcceg11e4g4009g82a5g2483d1e5c7b4"
msgid "Some of us are dead and doing very well, thank you."
msgstr "우리 중 일부는 죽었고 정말 잘 지내고 있어. 참 고맙네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Wyll
#. NodeID = d63b5445-f146-4df0-ade3-250d4f9887ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:d63b5445-f146-4df0-ade3-250d4f9887ad
msgctxt "h282e8c6dg97f6g4f85gbac5g9504308870e6"
msgid "Such handsome armour - a fighting force of some renown, perhaps."
msgstr "참 멋진 갑옷이군. 꽤나 명성을 날린 군대의 것일지도 몰라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Wyll
#. NodeID = db922c42-66fb-94dc-58f2-a6776e20c149
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_WYLL(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:db922c42-66fb-94dc-58f2-a6776e20c149
msgctxt "hcd67858cg234dg4658g848fgfed6b8b6e729"
msgid ""
"Let's come back to this later, yeah? We've got more pressing matters afoot."
msgstr "이 이야기는 나중에 하자, 응? 더 중요한 문제가 있잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Narrator
#. NodeID = de2b2795-d8d1-afe1-ad6c-62dca8b6bc4f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:de2b2795-d8d1-afe1-ad6c-62dca8b6bc4f
msgctxt "hffbcb235ge8b3g4dbeg89e0gba562e60b957"
msgid ""
"*These people were Dark Justiciars, an honorary order within the priesthood "
"of Shar.*"
msgstr "*이들은 샤 교단의 명예로운 기사단인 다크 저스티시어입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Shadowheart
#. NodeID = dec345d1-9b70-e598-7a38-40a8da993332
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ShadowHeart_InParty_Knows_SharWorshipper = False
#. TagRule: CLERIC_SHAR or PALADIN_SHAR
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:dec345d1-9b70-e598-7a38-40a8da993332
msgctxt "hd9993071gd20bg43aagb644g2950efa6e1ab"
msgid ""
"Quite bold of you to flaunt your Shar worship so openly. I hear that's <i"
">ill-advised.</i>"
msgstr "샤 신앙을 그렇게 공공연하게 밝히다니 꽤 대담하군. 그건 <i>경솔한</i> 행동이라고 들었는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Karlach
#. NodeID = e3e3b508-1a01-40c8-9004-3270786ad0ba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:e3e3b508-1a01-40c8-9004-3270786ad0ba
msgctxt "hf1d5354fgc7bfg478aga9aegea5227bcb3f6"
msgid "No burial. Just slaughter. Damn."
msgstr "묻지도 않았어. 그냥 도살해 버렸어. 제길."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Shadowheart
#. NodeID = e40dca6b-22e7-c113-be51-089bd8741ddb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ShadowHeart_InParty_Knows_SharWorshipper = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:e40dca6b-22e7-c113-be51-089bd8741ddb
msgctxt "h32be5a27g865eg43d8gaa6bg234154b27075"
msgid "I'm sure they'd consider the feeling mutual, if they could."
msgstr "저들도 같은 생각을 했을 게 확실해. 그럴 수 있었다면 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Gale
#. NodeID = ef8a1028-2ee5-01e3-dda3-2790c29ad19b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:ef8a1028-2ee5-01e3-dda3-2790c29ad19b
msgctxt "hfc59441egd55dg44fdgb59eg0221b658aaf9"
msgid ""
"If it managed to murder a group of Sharrans, we had better watch our step."
msgstr "샤 신도들 한 무리를 죽인 게 있다면, 조심해서 이동해야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted
#. Speaker = Player
#. NodeID = efc76962-1f99-e3bb-3309-8e12f07f5b3f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted:efc76962-1f99-e3bb-3309-8e12f07f5b3f
msgctxt "h7ea421eag2642g487dgbefagfcf4ca6fb1fd"
msgid "Whatever killed them, at least it rid the world of some of its evil."
msgstr "저들을 죽인 게 뭔진 모르지만, 적어도 이 세상에서 악을 좀 덜어냈군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted_Solo
#. Speaker = Narrator
#. NodeID = 03c7640b-216e-1c47-2a9f-ec2b7b5c108d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted_Solo:03c7640b-216e-1c47-2a9f-ec2b7b5c108d
msgctxt "h76261a56g89bdg4b2ega9deg6b8b2b5cb894"
msgid "*You sniff the corpse like the gore-bound truffle-hog you are.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted_Solo
#. Speaker = Narrator
#. NodeID = 14cbaeb8-ef4a-4893-90be-f2de9b339e98
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_DarkJusticiarsCorpses_Recognized = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted_Solo:14cbaeb8-ef4a-4893-90be-f2de9b339e98
msgctxt "hc0ed3c27gaffag4f27g8762g34af89d61f1a"
msgid ""
"*Among the various fabrics, you recognise the unmistakable symbol of Shar, "
"the Dark Lady.*"
msgstr "*당신은 다양한 직물 사이에서, 어둠의 여인, 샤의 상징을 분명히 알아봅니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted_Solo
#. Speaker = Narrator
#. NodeID = 514f60a6-0d6e-46f9-89e9-3852503f95ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted_Solo:514f60a6-0d6e-46f9-89e9-3852503f95ea
msgctxt "hf08b4c7fga614g49cegb481g06655596e5c9"
msgid ""
"*These people were Dark Justiciars, an honorary order within the priesthood "
"of Shar.*"
msgstr "*이들은 샤 교단의 명예로운 기사단인 다크 저스티시어입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted_Solo
#. Speaker = Player
