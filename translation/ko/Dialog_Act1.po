msgctxt "h613c919dg0cdbg466fgbcf4gf3debcb3cd33"
msgid "A big UGLY baby!"
msgstr "크고 못생긴 애!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain
#. Speaker = Zel'i
#. NodeID = 339cffa2-727a-1356-c690-78261eb51f13
#. HandlePath = TaggedText[0].TagText[0]
