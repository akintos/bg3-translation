#.      - FOR_Courier_Knows_DogName = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:5f484b06-9492-c423-9143-725a0705e5b1
msgctxt "h479192f6ga64fg4534g819cgb5a4cf6431df"
msgid "It's all right, Scratch. I'm not going to hurt you."
msgstr "괜찮아, 스크래치. 널 해치려는 게 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Player
#. NodeID = 5f51a6a5-dd2e-467d-01a8-99c339d70b2e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:5f51a6a5-dd2e-467d-01a8-99c339d70b2e
msgctxt "h248cc402g8b57g4814ga818g0676b8b68a59"
msgid "<i>Reach out to pet him.</i>"
msgstr "<i>손을 뻗어 녀석을 쓰다듬는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Scratch
#. NodeID = 5f6550a2-b579-17c3-acc4-51580214eef8
