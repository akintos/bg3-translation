msgctxt "hbb4fa672g05e3g4e6cgb1c9g5ea8c1b20e59"
msgid ""
"Barrelstalks. Poisonous stuff. Myconids must be using these for protection."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PAD_BarrelstalkInteraction
#. Speaker = Player
#. NodeID = a319cca9-ccf6-c736-a43c-040d1c333c8c
