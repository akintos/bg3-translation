msgctxt "hf89de192gb259g4390g861bgcf2d7d3b23ee"
msgid "There is no greater honour than bleeding for Vlaakith."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing
#. Speaker = Raider G'r'ath
#. NodeID = 7ca7f322-7685-1da5-cfb5-28d70f2aeb52
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_UpperGuards_State_GainedAccess = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing:7ca7f322-7685-1da5-cfb5-28d70f2aeb52
msgctxt "h8752cca8g8fb1g4577g9357gd4e4a20c9d3a"
msgid ""
"An understandable longing. Report to our <i>Kith'rak</i> within, she may "
"have use for you. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing
#. Speaker = Raider G'r'ath
#. NodeID = 8152b7e0-71c8-2b44-e0b9-5a680363c925
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_UpperGuards_State_GainedAccess = True
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing:8152b7e0-71c8-2b44-e0b9-5a680363c925
msgctxt "h458cbebfg948dg413fgbe1bg0bad6f2278b7"
msgid "Crèche Y'llek welcomes you, <i>ra'stil</i>."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing
#. Speaker = Raider G'r'ath
#. NodeID = 82d0801f-e9f6-7b30-2862-5d2d1f2b199b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_UpperGuards_State_GainedAccess = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing:82d0801f-e9f6-7b30-2862-5d2d1f2b199b
msgctxt "hd328320agdf09g4952gbba2g3463b3018b33"
msgid ""
"Quite possible.  Enter then, and report to the infirmary. Do not stray, "
"Crèche Y'llek watches you. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing
#. Speaker = Raider G'r'ath
#. NodeID = 8ae779d8-a311-48e9-bc4c-53e368b6f2dd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_UpperGuards_State_GainedAccess = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing:8ae779d8-a311-48e9-bc4c-53e368b6f2dd
msgctxt "ha036b967g69d7g44d0gb3f2g49fe7edd03f9"
msgid ""
"<i>Ch'mar, zal'a Vlaakith</i>. Enter and report to <i>Kith'rak </i>Therezzyn."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing
#. Speaker = Raider G'r'ath
#. NodeID = 8b492f0b-123a-0f07-f197-eb08f1192cb7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing:8b492f0b-123a-0f07-f197-eb08f1192cb7
msgctxt "h603ce711gcfdbg4d90g8d24g87d89c7562ed"
msgid "Ah, you are kin. State your purpose. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing
#. Speaker = Player
#. NodeID = 91a8a5b0-34da-feeb-8bbd-d776f3540622
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing:91a8a5b0-34da-feeb-8bbd-d776f3540622
msgctxt "h3f65ee81g3d6bg48dfgb752g9419b16e0afb"
msgid ""
"<i>Ghaik </i>have infected these lands. I need this crèche's help stopping "
"them."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing
#. Speaker = Raider G'r'ath
#. NodeID = 9301102a-9e93-c906-62bf-7c57435df62e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_UpperGuards_State_GainedAccess = True
#.   Tag:
#.      - GITHYANKI(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing:9301102a-9e93-c906-62bf-7c57435df62e
msgctxt "h82a57f42g0058g4fcbg813fga88b900814d9"
msgid "I see they're letting even <i>istik</i> mercenaries in these days. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing
#. Speaker = Raider G'r'ath
#. NodeID = 999d3262-270a-b363-1085-3552edbd30fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing:999d3262-270a-b363-1085-3552edbd30fd
msgctxt "hfdcd7ff7g6ec0g4646g956ega523d16d473b"
msgid ""
"<i>Chk.</i> We are never informed first. But if Kith'rak Voss wanted you "
"alive, he must have had his reasons. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing
#. Speaker = Raider G'r'ath
#. NodeID = 99f4cc29-671c-e040-72da-6cfa8c61b8da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing:99f4cc29-671c-e040-72da-6cfa8c61b8da
msgctxt "he60bee59gb6dag46c1g854egc1bce2ceffbf"
msgid "An illithid abomination will not step foot in this crèche. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing
#. Speaker = Raider G'r'ath
#. NodeID = 9b183efe-d2f9-6d0c-ef22-c3c08b1ee422
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_UpperGuards_State_GainedAccess = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing:9b183efe-d2f9-6d0c-ef22-c3c08b1ee422
msgctxt "h8b2d7bc6g1295g4188ga372g9bc38a20bc6b"
msgid "Very well, enter. Seek <i>Kith'rak</i> Therezzyn within. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing
#. Speaker = Raider G'r'ath
#. NodeID = a49cd9d0-81c6-b1ab-b2eb-c76ef6d2dba1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_UpperGuards_State_GainedAccess = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing:a49cd9d0-81c6-b1ab-b2eb-c76ef6d2dba1
msgctxt "h912c6dcbg73d3g4fbegb242g84980e079bb3"
msgid "If you bring harm, she will cut you in two. Seek her within."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing
#. Speaker = Raider G'r'ath
#. NodeID = a94960ab-aecc-443e-800f-2bdf2e156b79
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_UpperGuards_Event_HiddenCheckpointHostile = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing:a94960ab-aecc-443e-800f-2bdf2e156b79
msgctxt "h2f76789dg359ag4291ga359g446099a10709"
msgid "As stupid as you are unfortunate. <i>Htak'a!</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing
#. Speaker = Player
#. NodeID = bf61a568-826d-addb-01df-de354912573f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing:bf61a568-826d-addb-01df-de354912573f
msgctxt "h87a9c004gb249g4414g81aeg464fc8ac9f06"
msgid ""
"A <i>ghaik </i>parasite has infected me. Your crèche will offer me "
"sanctuary, as is its mandate. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing
#. Speaker = Player
#. NodeID = c9516446-e750-c28b-a1f0-448f25fb94c1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing:c9516446-e750-c28b-a1f0-448f25fb94c1
msgctxt "hbac99efdg46f1g4843g8513gfc033899c8a2"
msgid "I simply seek to meet more of my kin, it has been too long. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing
#. Speaker = Raider G'r'ath
#. NodeID = ca2ad29e-25cc-c533-bb2c-721b61fcb4fa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = False
#. SetFlags:
#.   Global:
#.     - CRE_UpperGuards_State_GainedAccess = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing:ca2ad29e-25cc-c533-bb2c-721b61fcb4fa
msgctxt "h787d1500gb81bg40c7gb209g10e138be9aa9"
msgid ""
"Hah! You've a strong spirit, <i>istik</i>. Go, report to our captain, she "
"might have use for you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing
#. Speaker = Player
#. NodeID = d52adc57-627b-c4c2-3fe3-5eb9bbf36c63
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IMPOSSIBLE = True
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing:d52adc57-627b-c4c2-3fe3-5eb9bbf36c63
msgctxt "h646a8840g3778g48a2ga40cg9f42336e6ffd"
msgid "Lae'zel? Perhaps you could intervene?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing
#. Speaker = Raider G'r'ath
#. NodeID = d72f7b15-8424-ba03-b106-feb43a278be6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_UpperGuards_Event_HiddenCheckpointHostile = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing:d72f7b15-8424-ba03-b106-feb43a278be6
msgctxt "h4a8e1a47gafcbg45ebg9b06g01ae00f6f561"
msgid "Your corpse will be useful enough. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing
#. Speaker = Player
#. NodeID = d76a26d7-797c-036e-4172-e9636b101e5c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing:d76a26d7-797c-036e-4172-e9636b101e5c
msgctxt "he8deb782g571bg4a45gb128gde11494019bd"
msgid "Took a wrong turn - I'll just be leaving. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing
#. Speaker = Raider G'r'ath
#. NodeID = dc5b13ae-5bc8-1ba9-599c-e486abaf32d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing:dc5b13ae-5bc8-1ba9-599c-e486abaf32d0
msgctxt "h5e3923e1gbc6fg4206gabdbgfb10112d8c2a"
msgid ""
"Is that so? I had heard he had his ways, and I'm pleased that they bear the "
"promised results. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing
#. Speaker = Raider G'r'ath
#. NodeID = e1c24854-f99f-50ac-1fde-403e73926311
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing:e1c24854-f99f-50ac-1fde-403e73926311
msgctxt "ha96b7a29gacaag4004g8174gc483ae681d58"
msgid ""
"You spoke to a silver sword - and you still live? Curious. We shall see what "
"<i>Kith'rak</i> Therezzyn makes of this. \n"
"\n"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing
#. Speaker = Raider G'r'ath
#. NodeID = e7bbc4d4-ffbc-4cfd-7371-a0a07d9ca8c1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#. SetFlags:
#.   Global:
#.     - CRE_UpperGuards_State_GainedAccess = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing:e7bbc4d4-ffbc-4cfd-7371-a0a07d9ca8c1
msgctxt "he7e2a9ccg3e45g43fbgbb4fg8fa651a7fe70"
msgid ""
"I seek no quarrel with you, kin. Go, speak with our <i>Kith'rak</i>, she "
"might require your help. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing
#. Speaker = Raider G'r'ath
#. NodeID = ecdfdc6a-d4a1-4d4c-88dc-8dff521acaa3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing:ecdfdc6a-d4a1-4d4c-88dc-8dff521acaa3
msgctxt "h31eda172g5defg4c8ag89cfg9fc015323a1d"
msgid "Journey's over, <i>istik</i>. It'll be swift. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing
#. Speaker = Raider G'r'ath
#. NodeID = f146bd06-191f-8948-c62f-eb81d40dcaf1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_UpperGuards_State_GainedAccess = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing:f146bd06-191f-8948-c62f-eb81d40dcaf1
msgctxt "h542e0d29g0037g473bg89a3gb723d5ce709b"
msgid "Report to the infirmary. Ghustil Stornugoss will see to you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing
#. Speaker = Lae'zel
#. NodeID = f711d2f6-33e4-46d2-afad-ea9c8bb54607
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IMPOSSIBLE = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing:f711d2f6-33e4-46d2-afad-ea9c8bb54607
msgctxt "h26053d28g3526g495ag9262g8b1c269584b8"
msgid "I must speak with your <i>ghustil</i>. Our queen's protocol demands it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing
#. Speaker = Player
#. NodeID = fece2d7a-0695-a42b-78b5-7646b374a53e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#. CheckFlags:
#.   Global:
#.      - PLA_GithChokepoint_State_SpokeToVoss = True
#.      - GLO_GithChokepoint_Quest_GithLeave = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointTrespassing:fece2d7a-0695-a42b-78b5-7646b374a53e
msgctxt "hd77f409egfb74g4e58gb2adgd112c36c8ac1"
msgid ""
"Captain Voss told me to find the item you've been searching for. I have it. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointWarning
#. Speaker = Player
#. NodeID = 00a43dd9-3451-17ce-57ce-5705b4d049a1
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointWarning:00a43dd9-3451-17ce-57ce-5705b4d049a1
msgctxt "hf66a5a24gd1cbg448ag9463gc4759fde951b"
msgid ""
"<i>Ghaik</i> have infected this land. I need this crèche's help to purify it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointWarning
#. Speaker = Player
#. NodeID = 00a43dd9-3451-17ce-57ce-5705b4d049a1
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointWarning:00a43dd9-3451-17ce-57ce-5705b4d049a1
msgctxt "h1b68ab18geef1g4890g8768gca10b54f5df4"
msgid ""
"A nautiloid crashed on your doorstep. Illithids are infecting the "
"population. I need your help."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointWarning
#. Speaker = Warrior Qen
#. NodeID = 0b1521b1-c5cc-2cdd-e427-7f59f9076443
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_UpperGuards_State_HiddenPrimaryGuardDefeated = True
#.      - CRE_UpperGuards_State_GainedAccess = False
