msgctxt "hc263a70ag44f5g4521gb175g452bd0f2e518"
msgid "*The mirror glints in the light - the screams from within now silent.*"
msgstr "*거울이 빛을 받아 반짝이고 그 안에서 나는 비병 소리는 이제 조용해졌습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_004
#. Speaker = Narrator
#. NodeID = 591b2c7a-2066-bbb6-f6f4-f7c439ff9b46
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_Hag_State_IsDead = False
