msgctxt "had96443eg7b5cg49dfgb7f5g53e4fcf36344"
msgid "*Kree!*"
msgstr "*크리!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Jox
#. NodeID = 2ddd331e-4009-f67c-1bff-59ef5da28419
#. HandlePath = TaggedText[0].TagText[0]
