msgctxt "h7bcf0415gf722g4bd6ga25eg1768f93ba064"
msgid "I'm, eh - Robin... Humanman."
msgstr "나는, 어... 로빈... 휴먼맨이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Player
