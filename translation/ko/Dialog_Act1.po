msgctxt "had1a529cg618cg4ffcg9c95gc93aad068c63"
msgid "<i>Ngh</i>... it hurts..."
msgstr "<i>으</i>...아파..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_OwlBear_LastCub
#. Speaker = Player
#. NodeID = f5eabfb7-3e5e-40f5-a9d8-15482346fce4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_OwlBear_LastCub:f5eabfb7-3e5e-40f5-a9d8-15482346fce4
msgctxt "ha4c4e1c1g553bg4a07ga9a4g8fd8c952f9c0"
msgid "<i>Silently petition Lady Shar for guidance.</i>"
msgstr "<i>조용히 샤 여신의 인도를 청원한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_OwlBear_VB_CubResolution_1P
#. Speaker = Player
#. NodeID = 8294ecdb-2c4b-75e9-ed55-df4916aab2c8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_OwlBear_SpareCub = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_OwlBear_VB_CubResolution_1P:8294ecdb-2c4b-75e9-ed55-df4916aab2c8
msgctxt "h5e2cad97gd99fg4cd0g86e2g877ffae6ca0b"
msgid "Nature can provide for the cub. Perhaps it'll live."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_OwlBear_VB_CubResolution_1P
#. Speaker = Player
#. NodeID = 9b6510bc-56f5-f12d-1f2b-cc1f55f3facb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_OwlBear_KillCub = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_OwlBear_VB_CubResolution_1P:9b6510bc-56f5-f12d-1f2b-cc1f55f3facb
msgctxt "hd79e9f6bga502g4f23gba62g9ce10d830cea"
msgid "At least it won't suffer anymore."
msgstr "적어도 더 이상 고통받지는 않겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_OwlBear_VB_CubResolution_2P
#. Speaker = Player
#. NodeID = 2805e887-94e3-dbb5-7265-8b5db280c387
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_OwlBear_SpareCub = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_OwlBear_VB_CubResolution_2P:2805e887-94e3-dbb5-7265-8b5db280c387
msgctxt "ha0d600e1gb8afg482bga7ebg17cf2147758e"
msgid "At least the cub has a fighting chance now."
msgstr "적어도 새끼는 살아남을 수 있겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_OwlBear_VB_CubResolution_2P
#. Speaker = Player
#. NodeID = 458b3bd1-18fe-d390-b206-06b256351244
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_OwlBear_KillCub = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_OwlBear_VB_CubResolution_2P:458b3bd1-18fe-d390-b206-06b256351244
msgctxt "h5ad42732g1027g4debga3a0g726ceb7e979f"
msgid "It was for the best. The cub would've died anyway."
msgstr "그게 최선이었어. 어차피 새끼는 죽었을 테니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_OwlBear_VB_CubResolution_2P
#. Speaker = Player
#. NodeID = 89495fc6-2ddb-68f3-1b32-5e352b9c4127
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_OwlBear_VB_CubResolution_2P:89495fc6-2ddb-68f3-1b32-5e352b9c4127
msgctxt "hc1bd93a7g4007g472ega52ag954a8a0e2531"
msgid "Nature might've provided for it. Too late now."
msgstr "자연의 섭리일 수 있지. 어쨌든 끝난일이지만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_OwlBear_VB_CubResolution_2P
#. Speaker = Player
#. NodeID = e340bba2-ed7f-c427-91a1-f0f070cfc804
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_OwlBear_VB_CubResolution_2P:e340bba2-ed7f-c427-91a1-f0f070cfc804
msgctxt "h365f87afg7c49g49d1gb32fge17cf672fe5c"
msgid "That, or we've just prolonged its misery."
msgstr "그렇거나 아니면 안쓰러운 삶을 계속 이어가게끔 둔 거겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_OwlBear_VB_EggPickedUp
#. Speaker = Player
#. NodeID = 1b945d13-53e5-c113-f7ee-7007a3cb6bce
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_OwlBear_EggPickedInCombat = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_OwlBear_VB_EggPickedUp:1b945d13-53e5-c113-f7ee-7007a3cb6bce
msgctxt "h96f709ddgba78g4d74ga174g041df440285e"
msgid "She'll tear me in two for touching her egg."
msgstr "알에 손 댔으니 이제 날 반으로 갈라 죽이겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_OwlBear_VB_EggPickedUp
#. Speaker = Player
#. NodeID = 3d1b7398-89d8-1f3a-9970-23eefca41762
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WLD_PriestsOfTheConqueringGods_OwlBearPrints_PassedCheck = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_OwlBear_VB_EggPickedUp:3d1b7398-89d8-1f3a-9970-23eefca41762
msgctxt "hb46af6c8gfeeeg47fdg8a5bg6b09b07a3dab"
msgid "An owlbear egg... these are supposed to be worth a fortune..."
msgstr "아울베어 알이라... 이건 엄청난 가치가 있다고 하는데..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_OwlBear_VB_EggPickedUp
#. Speaker = Player
#. NodeID = a63748f0-9729-27b8-2d54-aaa6e6f957b9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WLD_PriestsOfTheConqueringGods_OwlBearPrints_PassedCheck = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_OwlBear_VB_EggPickedUp:a63748f0-9729-27b8-2d54-aaa6e6f957b9
msgctxt "hcdf15f7ag5a7ag4ea4gae94g27dc845ff951"
msgid "That's quite an egg."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_OwlBear_VB_EnterCave
#. Speaker = Player
#. NodeID = 68a8d5b9-14c2-259a-292c-cabe3feff2cc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WLD_PriestsOfTheConqueringGods_OwlBearPrints_PassedCheck = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_OwlBear_VB_EnterCave:68a8d5b9-14c2-259a-292c-cabe3feff2cc
msgctxt "h6221355agbca3g4500gabe7g2b48c057dc76"
msgid "That stench... dead owlbear prey, no doubt."
msgstr "악취가 심하군... 아울베어에게 당한 먹잇감이 분명해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_OwlBear_VB_EnterCave
#. Speaker = Player
#. NodeID = d2385649-c516-4d83-c937-da86b6ed77ff
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WLD_PriestsOfTheConqueringGods_OwlBearPrints_PassedCheck = False
#.   Party:
#.      - WLD_PriestsOfTheConqueringGods_OwlBearPrints_UsedPrints(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_OwlBear_VB_EnterCave:d2385649-c516-4d83-c937-da86b6ed77ff
msgctxt "h08cde55cg00bfg41ffgbf81g92e21696b9e9"
msgid "Whatever made those tracks seems to be in here..."
msgstr "저 흔적을 만든 게 뭔진 모르겠지만 이 안에 있는 게 분명해..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_OwlBear_VB_EnterCave
#. Speaker = Player
#. NodeID = eae40cdc-3ba3-d0e8-2106-afcb0448bc0d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_OwlBear_VB_EnterCave:eae40cdc-3ba3-d0e8-2106-afcb0448bc0d
msgctxt "h5c710efag6007g4424g8dc6g27433090f10c"
msgid "Ugh! What is that? Rotting flesh?"
msgstr "웩! 저게 뭐지? 썩은 살점인가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_OwlBear_VB_LastCub
#. Speaker = Player
#. NodeID = 97838fba-9b20-fa95-ee32-6b1a0bd49b26
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_OwlBear_VB_LastCub:97838fba-9b20-fa95-ee32-6b1a0bd49b26
msgctxt "hefed9293g7514g4278gaaa2g696d18491b80"
msgid "Not without its mother by its side. What now?"
msgstr "어미가 근처에 있을 게 분명해. 이제 어쩌지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_OwlBear_VB_LastCub
#. Speaker = Player
#. NodeID = e2e06304-86c2-5244-81aa-0b7adc679e38
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_OwlBear_VB_LastCub:e2e06304-86c2-5244-81aa-0b7adc679e38
msgctxt "h8501d5ffg7520g4cf3gb2d9gcaeab2db02cb"
msgid "A lone cub isn't much of a threat..."
msgstr "새끼 한 마리는 그다지 위협이 되지 않는데..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_AD_HatchedEgg
#. Speaker = Player
#. NodeID = 07e9f69f-f2e4-8bf4-af03-802cc88c16af
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_Owlbear_HatchedEgg_PassedCheck = True
#.   Object:
#.      - FOR_Owlbear_HasOwlbearEgg(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_AD_HatchedEgg:07e9f69f-f2e4-8bf4-af03-802cc88c16af
msgctxt "h4114176dga966g43e3gadf0g5d0039ef030d"
msgid "Owlbear eggshells... an unhatched one would fetch quite a price..."
msgstr "아울베어 알껍데기... 부화되지 않은 알은 꽤 비싼 가격에 팔릴 거야..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_AD_HatchedEgg
#. Speaker = Player
#. NodeID = 0d7d70ce-a911-deb7-59b7-63d91eda05c6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_Owlbear_HatchedEgg_PassedCheck = False
#.   Object:
#.      - FOR_Owlbear_HasOwlbearEgg(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_AD_HatchedEgg:0d7d70ce-a911-deb7-59b7-63d91eda05c6
msgctxt "hb9a5b8e3g5ef5g4f6cga068g59d6b6276876"
msgid ""
"You could feed an army with an egg that size... if you found an intact one."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_AD_HatchedEgg
#. Speaker = Player
#. NodeID = 12c97bf1-bc80-a98a-cfd8-9a53b6defcba
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_Owlbear_HatchedEgg_PassedCheck = True
#.   Object:
#.      - FOR_Owlbear_HasOwlbearEgg(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_AD_HatchedEgg:12c97bf1-bc80-a98a-cfd8-9a53b6defcba
msgctxt "hc8cfbb11gb5f0g4143g81a3g25f6428055a2"
msgid "More owlbear eggs... already hatched. No point in taking these."
msgstr "아울베어 알이 더 있어... 이미 부화했군. 가져가도 소용없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_AD_HatchedEgg
#. Speaker = Player
#. NodeID = 3b9a4f91-9327-fa58-871d-431c58ee55f5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_Owlbear_HatchedEgg_PassedCheck = False
#.   Object:
#.      - FOR_Owlbear_HasOwlbearEgg(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_AD_HatchedEgg:3b9a4f91-9327-fa58-871d-431c58ee55f5
msgctxt "hebf036d3ge433g492dgb1ffg83af036fb4b1"
msgid "Just empty shells. Best to just keep the unhatched one."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_HealedOwlbear
#. Speaker = Player
#. NodeID = 6cacb8c2-4f51-497b-b8e9-d3d1ed88a9e0
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_HealedOwlbear:6cacb8c2-4f51-497b-b8e9-d3d1ed88a9e0
msgctxt "h3c654263gcfd5g4565g9035g504b54b481bf"
msgid "She looks better - hungrier, too."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_HealedOwlbear
#. Speaker = Player
#. NodeID = 6cacb8c2-4f51-497b-b8e9-d3d1ed88a9e0
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_HealedOwlbear:6cacb8c2-4f51-497b-b8e9-d3d1ed88a9e0
msgctxt "h25c1b693gd35bg4bc6ga981gc56a98b75bfb"
msgid ""
"Looks like she's fit as a fiddle again. Which might be somewhat dangerous, "
"mind you."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_HealedOwlbear
#. Speaker = Player
#. NodeID = 6cacb8c2-4f51-497b-b8e9-d3d1ed88a9e0
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_HealedOwlbear:6cacb8c2-4f51-497b-b8e9-d3d1ed88a9e0
msgctxt "h005e5e9fgddb3g46e4ga2edg7ce2d5e4cd11"
msgid "There, there, sweetie. Uh... there, there..."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_HealedOwlbear
#. Speaker = Player
#. NodeID = 6cacb8c2-4f51-497b-b8e9-d3d1ed88a9e0
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_HealedOwlbear:6cacb8c2-4f51-497b-b8e9-d3d1ed88a9e0
msgctxt "h4716c4b1g8604g4df3g9a41g1eeacb5cfc7e"
msgid "Healed or not, she's a hungry beast. Be cautious."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_HealedOwlbear
#. Speaker = Player
#. NodeID = 6cacb8c2-4f51-497b-b8e9-d3d1ed88a9e0
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_HealedOwlbear:6cacb8c2-4f51-497b-b8e9-d3d1ed88a9e0
msgctxt "h948aea22g48bfg4cb4gb9ffg77336612124f"
msgid ""
"Beast still looks murderous. Not sure it appreciates the healing touch..."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_HealedOwlbear
#. Speaker = Player
#. NodeID = 6cacb8c2-4f51-497b-b8e9-d3d1ed88a9e0
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_HealedOwlbear:6cacb8c2-4f51-497b-b8e9-d3d1ed88a9e0
msgctxt "hdd6901deg47f9g425dg8234g8b1bb5316681"
msgid "She's still worked up - not even a nice 'thank you' grunt."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_HealedOwlbear
#. Speaker = Player
#. NodeID = 6cacb8c2-4f51-497b-b8e9-d3d1ed88a9e0
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_HealedOwlbear:6cacb8c2-4f51-497b-b8e9-d3d1ed88a9e0
msgctxt "ha163d6bbg1577g472fga042gd593b934426e"
msgid "Healed - but she doesn't look much happier."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_KilledByGoblins
#. Speaker = Player
#. NodeID = 72822c9b-4091-4b04-a3b4-ab087fa15351
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_KilledByGoblins:72822c9b-4091-4b04-a3b4-ab087fa15351
msgctxt "h50c0062bg39d5g4499g8d94g580df65a352d"
msgid "Looks like the goblins found her little hideaway."
msgstr "고블린들이 이 녀석의 은신처를 찾아낸 모양이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_KilledByGoblins
#. Speaker = Player
#. NodeID = 72822c9b-4091-4b04-a3b4-ab087fa15351
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_KilledByGoblins:72822c9b-4091-4b04-a3b4-ab087fa15351
msgctxt "h6d39c833gb014g4721g88dbg6cb7c9fecc9d"
msgid "A goblin patrol, looks like. The beasts."
msgstr "보아하니 고블린 순찰대 짓이로군. 짐승 놈들."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_KilledByGoblins
#. Speaker = Player
#. NodeID = 72822c9b-4091-4b04-a3b4-ab087fa15351
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_KilledByGoblins:72822c9b-4091-4b04-a3b4-ab087fa15351
msgctxt "hc14440eag2067g4f8ega747g9a3d7b5518e4"
msgid "Goblins got to her."
msgstr "고블린들이 죽였군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_KilledByGoblins
#. Speaker = Player
#. NodeID = 72822c9b-4091-4b04-a3b4-ab087fa15351
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_KilledByGoblins:72822c9b-4091-4b04-a3b4-ab087fa15351
msgctxt "h878b3dd3g652ag4810g9561g1b653bbe40f9"
msgid "Goblins have silenced the owl-beast."
msgstr "고블린들이 부엉이-야수를 침묵시켰다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_KilledByGoblins
#. Speaker = Player
#. NodeID = 72822c9b-4091-4b04-a3b4-ab087fa15351
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_KilledByGoblins:72822c9b-4091-4b04-a3b4-ab087fa15351
msgctxt "h8e7384b9g8e36g4895gb646g6a91c389303f"
msgid "Seems like a pack of goblins swarmed the owlbear."
msgstr "고블린 무리에게 짓밟힌 모양이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_KilledByGoblins
#. Speaker = Player
#. NodeID = 72822c9b-4091-4b04-a3b4-ab087fa15351
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_KilledByGoblins:72822c9b-4091-4b04-a3b4-ab087fa15351
msgctxt "he62d37begdb00g45ceg89edga9ea1839c8a9"
msgid "Goblins got her. Hope she got a few of them before she went down."
msgstr "고블린들 짓이군. 쓰러지기 전에 몇 놈 처치했기를 바란다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_KilledByGoblins
#. Speaker = Player
#. NodeID = 72822c9b-4091-4b04-a3b4-ab087fa15351
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_KilledByGoblins:72822c9b-4091-4b04-a3b4-ab087fa15351
msgctxt "hbf34980ag8274g40c5g9c43gd8dc9fe8462e"
msgid "Looks like the goblins found her."
msgstr "고블린들이 이 녀석을 찾아낸 모양이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_KilledByGoblins
#. Speaker = Player
#. NodeID = be7b732b-6cf4-0861-2bbc-2e57271874af
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_KilledByGoblins:be7b732b-6cf4-0861-2bbc-2e57271874af
msgctxt "h3852a49dgee29g44ccga1a1g0fc3ba0e0624"
msgid "Looks like the goblins found her little hideaway. Pity."
msgstr "고블린들이 이 녀석의 은신처를 찾아낸 모양이네. 딱하기도 하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_KilledByGoblins
#. Speaker = Player
#. NodeID = be7b732b-6cf4-0861-2bbc-2e57271874af
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_KilledByGoblins:be7b732b-6cf4-0861-2bbc-2e57271874af
msgctxt "hd26a61e7g5119g4809gba75g870850b73670"
msgid "She took a few goblins with her, at least. A brave effort."
msgstr "적어도 고블린 몇 놈은 길동무 삼았군. 용감무쌍하게 노력했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_KilledByGoblins
#. Speaker = Player
#. NodeID = be7b732b-6cf4-0861-2bbc-2e57271874af
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_KilledByGoblins:be7b732b-6cf4-0861-2bbc-2e57271874af
msgctxt "h9fa21b2eg9745g4772g8153gb792b3fc00a3"
msgid "Goblins killed her. Such a beautiful beast."
msgstr "고블린들이 죽였군. 이렇게나 아름다운 야수를."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_KilledByGoblins
#. Speaker = Player
#. NodeID = be7b732b-6cf4-0861-2bbc-2e57271874af
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_KilledByGoblins:be7b732b-6cf4-0861-2bbc-2e57271874af
msgctxt "h2f91a8d5g82dcg49c1g9caeg560ae9e9db5d"
msgid "Goblins have silenced the owl-beast. I'd expect no less of vermin."
msgstr "고블린들이 부엉이-야수를 침묵시켰다. 그 해충들은 그러고도 남지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_KilledByGoblins
#. Speaker = Player
#. NodeID = be7b732b-6cf4-0861-2bbc-2e57271874af
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_KilledByGoblins:be7b732b-6cf4-0861-2bbc-2e57271874af
msgctxt "hf138973dge8e5g490cgbf3ag02b8b5d6a918"
msgid "Swarmed by goblins. Not a fate I'd wish on any beast."
msgstr "고블린 무리에게 짓밟혔군. 그 어떤 짐승에게도 바란 적 없는 운명인 것을."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_KilledByGoblins
#. Speaker = Player
#. NodeID = be7b732b-6cf4-0861-2bbc-2e57271874af
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_KilledByGoblins:be7b732b-6cf4-0861-2bbc-2e57271874af
msgctxt "h9e33f698g6c8cg4135gaccag62ab55ab2907"
msgid ""
"Goblins got to her, by the looks of it. But she stood her ground proudly."
msgstr "보아하니 고블린들이 죽인 것 같군. 그러나 당당하게 영역을 지켜냈어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_KilledByGoblins
#. Speaker = Player
#. NodeID = be7b732b-6cf4-0861-2bbc-2e57271874af
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_KilledByGoblins:be7b732b-6cf4-0861-2bbc-2e57271874af
msgctxt "h427f647dg2996g4c63g8e77ga6e0534b9430"
msgid "Cut down by goblins. How cruel."
msgstr "고블린들에게 죽었군. 이렇게 잔혹할 데가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_KilledByGoblins
#. Speaker = Player
#. NodeID = f06232ca-87a3-4b46-bfa5-fdd8fcbd5069
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_KilledByGoblins:f06232ca-87a3-4b46-bfa5-fdd8fcbd5069
msgctxt "h8cb5cf97ga3dcg4983g8e83g19f62571fc90"
msgid "A pity. I kind of liked her."
msgstr "딱하기도 하지. 이 애가 좋았는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_KilledByGoblins
#. Speaker = Player
#. NodeID = f06232ca-87a3-4b46-bfa5-fdd8fcbd5069
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_KilledByGoblins:f06232ca-87a3-4b46-bfa5-fdd8fcbd5069
msgctxt "h37a78ee8gc4c8g40c1g87d4g39dfcdb74146"
msgid "She put up a fight, at least. A brave effort."
msgstr "적어도 싸우기는 했군. 용감무쌍하게 노력했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_KilledByGoblins
#. Speaker = Player
#. NodeID = f06232ca-87a3-4b46-bfa5-fdd8fcbd5069
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_KilledByGoblins:f06232ca-87a3-4b46-bfa5-fdd8fcbd5069
msgctxt "hc6edf3ddg1df7g4f7dgb176gc544f861c94e"
msgid "Poor thing. Such a beautiful creature."
msgstr "가엾은 것. 이렇게나 아름다운 생물인데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_KilledByGoblins
#. Speaker = Player
#. NodeID = f06232ca-87a3-4b46-bfa5-fdd8fcbd5069
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_KilledByGoblins:f06232ca-87a3-4b46-bfa5-fdd8fcbd5069
msgctxt "h006c94b7g2ae3g4237gb221g29d8a249245f"
msgid "I'd expect no less of vermin."
msgstr "그 해충들이라면 그러고도 남지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_KilledByGoblins
#. Speaker = Player
#. NodeID = f06232ca-87a3-4b46-bfa5-fdd8fcbd5069
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_KilledByGoblins:f06232ca-87a3-4b46-bfa5-fdd8fcbd5069
msgctxt "h6b9791c6g2a10g41e3gade8gf5044acd77af"
msgid "Not a fate I'd wish on any creature."
msgstr "그 어떤 짐승에게도 바란 적 없는 운명인 것을."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_KilledByGoblins
#. Speaker = Player
#. NodeID = f06232ca-87a3-4b46-bfa5-fdd8fcbd5069
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_KilledByGoblins:f06232ca-87a3-4b46-bfa5-fdd8fcbd5069
msgctxt "ha7abfba2gab68g4894g83eeg226b2a22c4ee"
msgid "Noble creature, she should be proud for the fight she put up."
msgstr "고결한 생명체로군. 마지막 싸움이 자랑스러웠을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Owlbear_PAD_KilledByGoblins
#. Speaker = Player
#. NodeID = f06232ca-87a3-4b46-bfa5-fdd8fcbd5069
#. HandlePath = TaggedText[6].TagText[0]
