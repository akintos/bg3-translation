#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_ApothecaryGoblins_Goblin_02:5ca3d5e2-81ef-1719-5afa-ec1e7092e31d
msgctxt "h9dd29f1ag3e38g4bc9gbc03g5f921c12ab6d"
msgid "Everything here is <i>ours</i>. Bugger off!"
msgstr "여기 있는 모든건 <i>우리거</i>다. 꺼져라!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_ApothecaryGoblins_Goblin_02
#. Speaker = Brawler Brek
#. NodeID = b605194a-5bb6-ccfd-e996-9d00f47462bb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_ApothecaryGoblins_AD_Goblin_02_HasMet(1) = True
#. TagRule: DROWELF
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_ApothecaryGoblins_Goblin_02:b605194a-5bb6-ccfd-e996-9d00f47462bb
msgctxt "h20f34492gb7bbg41d7ga2d2gb18f9a97b219"
msgid "Don't care if you're a drow! Hands off!"
msgstr "드로우건 뭐건 내 건 건들지 마!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_ApothecaryGoblins_Goblin_02
#. Speaker = Brawler Brek
#. NodeID = b605194a-5bb6-ccfd-e996-9d00f47462bb
#. HandlePath = TaggedText[1].TagText[0]
