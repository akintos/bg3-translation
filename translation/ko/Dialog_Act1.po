msgctxt "h7cca0f22g62e9g40c8g9f1dga287b8caa707"
msgid "<i>Search the rocks for an opening.</i>"
msgstr "<i>바위를 열 만한 것을 찾아본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_GruntingKid
#. Speaker = Player
#. NodeID = e75d6f7a-a108-f7f7-87c3-72e0141b2b69
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_GruntingKid:e75d6f7a-a108-f7f7-87c3-72e0141b2b69
msgctxt "hc47441f2g8b7cg4f0fg91b9gbcccf5675851"
msgid "I see. Anything else on your mind?"
msgstr "알았어. 네 마음을 사로잡는 것이라도 있니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_GruntingKid
#. Speaker = Doni
#. NodeID = ebf59d38-01de-616c-a07b-1689f1dc5fd5
