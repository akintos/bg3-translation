msgctxt "h079a4fdcgeffdg48f7gb33dg264408d0d841"
msgid "<i>And a stiff drink, while I'm at it.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PaladinsOfTyr_AvatarKarlachAfterEnrage
#. Speaker = Karlach
#. NodeID = cf69f1ed-e0ca-cbba-af62-6f5e7087c18e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PaladinsOfTyr_AvatarKarlachAfterEnrage:cf69f1ed-e0ca-cbba-af62-6f5e7087c18e
msgctxt "h142fb659g8c99g475bg9a00g52c6be636b4c"
msgid "<i>Been so long I can hardly remember.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PaladinsOfTyr_AvatarKarlachAfterEnrage
#. Speaker = Karlach
#. NodeID = d1f91ce5-e010-365d-1c80-239dbea7b27b
#. HandlePath = TaggedText[0].TagText[0]
