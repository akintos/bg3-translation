msgctxt "h9e4dabbbgb664g4096g8910g90bc05ca69a8"
msgid "Lava doesn't usually pop like that. What gives?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_MonkAmulet_PAD_EnteredLavaLake
#. Speaker = Player
#. NodeID = 332aa2b4-e1be-4c78-aa25-80c7acd35440
