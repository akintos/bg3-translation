msgctxt "h7f069081ge5ecg4bdag87eag1d633d5dc098"
msgid "Funny symbol on this prayer sheet. Hidden away for any special reason?"
msgstr "기도문에 재밌는 상징이 있네. 숨겨둔 특별한 이유가 있겠지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_PickupPrayerSheet
#. Speaker = Player
#. NodeID = 02916df9-e75e-5b7b-49ae-3138f7423309
