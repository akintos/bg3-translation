msgctxt "heeac8925g4e22g43f0g96e0g111116bc2053"
msgid "<b>I should have ripped your arms off!</b>"
msgstr "<b>그냥 네 녀석의 팔뚝을 찢어발겨야 했는데!</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation
#. Speaker = Player
#. NodeID = 9af37cae-a95d-8bf5-a477-28992f814832
