msgctxt "h6d696e2eg41c6g4f34gb017g630c516136a9"
msgid "It's surprisingly heavy. How would you secure it?"
msgstr "놀랍도록 무겁네. 이걸 어떻게 쓰는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_MerregonMask_PAD
