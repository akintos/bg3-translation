#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_AD_TemplarGreeting:65542574-9973-128b-fd9c-88ee9dce634c
msgctxt "h1ea49b1eg39d5g454bgbffbg66b5505e7444"
msgid "Shame. Such an illustrious journey, ended by poor etiquette."
msgstr "안타깝구나. 그토록 대단한 여정이 잘못된 예절 때문에 끝을 보게 되다니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_AD_TemplarGreeting
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 9a4169e7-8f67-4e64-a96e-6eafcecfd47e
#. HandlePath = TaggedText[0].TagText[0]
