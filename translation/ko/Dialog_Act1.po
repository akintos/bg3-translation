msgctxt "he0d3d793g7079g4addg9917g7fc94624bac4"
msgid "I'll have to tidy this place."
msgstr "여기를 좀 정돈해야겠어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD
#. Speaker = Nettie
#. NodeID = 6dd5237c-45f2-9716-44b7-42cdd03db5c2
