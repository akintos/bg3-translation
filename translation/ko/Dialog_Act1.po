#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_Event_HornFail_Done = False
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_PAD_NotReturning:dd494e73-c90d-93e0-a63d-e7e4b4b25844
msgctxt "h4e1470eag9d8ag4d0agb68bg05071ea1ac10"
msgid "A pretty tune, but that's all this horn is good for now."
msgstr "소리는 예쁘네, 근데 그게 다야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_PAD_NotReturning
#. Speaker = Player
#. NodeID = dd494e73-c90d-93e0-a63d-e7e4b4b25844
#. HandlePath = TaggedText[5].TagText[1]
#. CheckFlags:
#.   Global:
#.      - FOR_SchoolOgres_Event_HornFail_Done = True
#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_Event_HornFail_Done = False
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_PAD_NotReturning:dd494e73-c90d-93e0-a63d-e7e4b4b25844
msgctxt "h50df4f0fg8345g4a9ag8ed2gca42fde01336"
msgid "Useless. Those ogres are long gone by now."
msgstr "쓸모 없어. 오우거는 이미 떠난 지 오래야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_PAD_NotReturning
#. Speaker = Player
#. NodeID = dd494e73-c90d-93e0-a63d-e7e4b4b25844
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_SchoolOgres_Event_HornFail_Done = True
#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_Event_HornFail_Done = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_PAD_NotReturning:dd494e73-c90d-93e0-a63d-e7e4b4b25844
msgctxt "hc20bad33g0e88g484fgae7cg779290dbf3d0"
msgid "No one's coming - the deal is done."
msgstr "아무도 안 올 거야. 거래는 이미 끝났어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_PAD_NotReturning
#. Speaker = Player
#. NodeID = dd494e73-c90d-93e0-a63d-e7e4b4b25844
#. HandlePath = TaggedText[6].TagText[1]
#. CheckFlags:
#.   Global:
#.      - FOR_SchoolOgres_Event_HornFail_Done = True
#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_Event_HornFail_Done = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_PAD_NotReturning:dd494e73-c90d-93e0-a63d-e7e4b4b25844
msgctxt "h58ef82ffg836ag46a3ga0beg971bd6bafd77"
msgid "The ogre must have moved on to new deals."
msgstr "오우거는 새로운 거래를 찾아 떠났을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Player
#. NodeID = 015120fd-4eec-96a8-aee1-34bb8b14e30d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Dialog:
#.      - FOR_SchoolOgres_Knows_AskedBoss(3) = True
#.      - FOR_SchoolOgres_Knows_TeasedOgre(3) = False
#.   Global:
#.      - FOR_SchoolOgres_Knows_FailedPersuade = False
#.   Tag:
#.      - ROGUE(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:015120fd-4eec-96a8-aee1-34bb8b14e30d
msgctxt "hb5e73fc4ga1a1g4d8cga27dgec2f6033a057"
msgid ""
"[463b0f43-5410-412d-aba3-875cf81c38ca] - to be paid once the killing's done."
msgstr "싸움이 끝나면 [463b0f43-5410-412d-aba3-875cf81c38ca]골드를 지불하시지요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = 03b937ce-005e-9e92-e3c7-89d4b90dcbc4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:03b937ce-005e-9e92-e3c7-89d4b90dcbc4
msgctxt "h09d34491ge712g4c6ag981fg117fa0ca1637"
msgid ""
"I've no use for the Absolute - or any god. I follow two masters only: "
"gluttony and greed."
msgstr "저에겐 절대자도, 다른 신도 필요가 없습니다. 전 식욕과 탐욕이라는 두 주인만을 섬기니까요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = 0515053e-133f-bfdc-0506-a4697dd7b2f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:0515053e-133f-bfdc-0506-a4697dd7b2f8
msgctxt "hbbdadb28g4a25g4588ga3b1g95b143a4b25b"
msgid "No talk!"
msgstr "조용히 해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = 0737f0a4-7687-fe96-cc2b-14c026285acb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:0737f0a4-7687-fe96-cc2b-14c026285acb
msgctxt "h3701dc63g9cffg4210g95fcg025002256908"
msgid "No one is food today, alas. It seems we are friends."
msgstr "안타깝지만 오늘은 아무도 음식이 되지 않네요. 우리는 친구가 된 것 같군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = 07f10ad9-3dfa-8ac0-5957-383349bed71c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_State_Hired = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:07f10ad9-3dfa-8ac0-5957-383349bed71c
msgctxt "hf044e37dg1c6dg47d7g8b9ag4ff954bd9f9c"
msgid "Come, now. Famished though we are, we're friends - are we not?"
msgstr "자, 어서. 지금 우리는 굶주렸지만 그래도 친구지요. 안 그렇나요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = 0e72c428-df8c-c2e2-8b1c-20b76e16925a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:0e72c428-df8c-c2e2-8b1c-20b76e16925a
msgctxt "h93d82c70g2436g454bgbdf5g7096fd24d10c"
msgid ""
"Tell me, sweet creature: does your flesh taste as honeyed as I could hope "
"for?"
msgstr "귀여운 생물이여, 알려주시지요. 내 바라건대 당신의 살점은 꿀과 같은 맛이 나나요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = 0f258fa2-716a-3180-98b9-ca3e63dd1509
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - FOR_SchoolOgres_State_HasHorn(0) = True
#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_State_Hired = True
#.   Object:
#.     - FOR_SchoolOgres_Event_GiveHorn(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:0f258fa2-716a-3180-98b9-ca3e63dd1509
msgctxt "h17ffe8f6g2c3dg4452g82a5g33469bbca8d7"
msgid ""
"Take my bonehorn. One blow, and the ground will quake with my family name."
msgstr "내 뿔나팔을 가져가시지요. 한 번 불면, 땅이 내 일족의 이름을 부르며 진동할 것이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = 115e6958-94a1-6f6a-77ad-d059596816ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:115e6958-94a1-6f6a-77ad-d059596816ac
msgctxt "h586e0b5eg1416g4b0agaa73g5b441fa5b7e9"
msgid "I am by all accounts a student of higher commerce and extortion."
msgstr "저는 모든 면에서 상술과 갈취의 대가라고 할 수 있지요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Player
#. NodeID = 1699d81c-33a8-d2ea-4966-5461f0ed1761
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:1699d81c-33a8-d2ea-4966-5461f0ed1761
msgctxt "h19eba3b5g65d7g46d1ga0bcg03b0271aa81b"
msgid "Even sweeter still."
msgstr "더 달콤하구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = 175d58a8-58c6-0de4-c1e7-60a96a639ce2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(3) = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:175d58a8-58c6-0de4-c1e7-60a96a639ce2
msgctxt "hd081059dgee9ag44f2ga9c9ga70c44b38113"
msgid "How regrettable, that your meat must go unsavoured."
msgstr "당신의 고기를 음미할 수 없다니 참으로 유감이군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = 1e09d3c8-7ca9-a74a-f4ff-c0e2ee8ce65c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:1e09d3c8-7ca9-a74a-f4ff-c0e2ee8ce65c
msgctxt "h204675ccg36e2g4290ga142gbd82ddb10132"
msgid "Not food. Friend!"
msgstr "음식이 아니야. 친구다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = 1e751e6a-f7c5-ac83-1294-7b86db18c998
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 916a75f0-23d8-f05b-449d-d926d69fe782_FailedCheck = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:1e751e6a-f7c5-ac83-1294-7b86db18c998
msgctxt "h7347747fg90dcg4a09g9e97g3d572dd055fe"
msgid "I expect more than your word. Show me your <i>flesh.</i>"
msgstr "그냥 말로는 부족하지요. <i>살갗</i>을 보여주시지요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = 22d091b5-161d-0e37-f89b-bed5f7997a5f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToIndivPlayerAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:22d091b5-161d-0e37-f89b-bed5f7997a5f
msgctxt "h70305f70gd67fg480cgbb96g28d8bcc44411"
msgid "<i>Food.</i>"
msgstr "<i>먹을 거.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Player
#. NodeID = 23535335-3960-e559-6003-8da895e61d33
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(3) = True
#.      - BERSERKER(3) = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:23535335-3960-e559-6003-8da895e61d33
msgctxt "hf3aaae0ag31ecg41f8gb89cgd34471ce9234"
msgid "What about you? I'm feeling <i>hungry</i>..."
msgstr "그러는 너는? 나도 막 <i>배고파지려던</i> 참인데..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Chock
#. NodeID = 2a474f48-a9a3-9ff2-2a2e-dca3d5db10f7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:2a474f48-a9a3-9ff2-2a2e-dca3d5db10f7
msgctxt "hc84297e9g7679g4870ga906g9b61bd141734"
msgid "Ogre kill everyone around! Then ogre eats them!"
msgstr "오우거는 전부 다 죽인다! 그리고 먹는다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = 2a530a5c-05d5-e947-312c-b59b257f1a2e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - FOR_SchoolOgres_Knows_AskedBoss(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:2a530a5c-05d5-e947-312c-b59b257f1a2e
msgctxt "h00ac4435ge703g459dg8dfcg1443b6050899"
msgid "The goblins understand my appetites. They sate my hunger for gold..."
msgstr "고블린은 내 식욕을 이해하지요. 황금에 대한 갈망도 채워준답니다..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = 329b66a9-f9ad-f965-4074-65cf31a4c70e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:329b66a9-f9ad-f965-4074-65cf31a4c70e
msgctxt "ha844f422g11dcg468dga5ceg5c58c4b3dd16"
msgid "Ha! Did you expect The Enlightened to fall for such a crude ruse?"
msgstr "하! 깨우친 자가 그토록 조잡한 계략에 넘어갈 거라 생각한 것인지요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = 32f6f29c-327d-eb7d-20db-27dbabe6239c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:32f6f29c-327d-eb7d-20db-27dbabe6239c
msgctxt "hd4b6be31g85bfg44b0g967dg0b2ffac73663"
msgid ""
"The green earth bless us, she bore no mark. Those horns - mm, mm. Such "
"cartilaginous crunch!"
msgstr "대지가 우리를 축복하사, 이 여자는 표식을 지니고 있지 않았지요. 저 뿔은, 으음. 얼마나 오도독한 연골인지!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = 345f6f56-da6d-c0e5-498d-53a58519f2cd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 916a75f0-23d8-f05b-449d-d926d69fe782_PassedCheck = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:345f6f56-da6d-c0e5-498d-53a58519f2cd
msgctxt "h95f18affgfa82g49f4g943bgdd91d3fadab2"
msgid "... and you, a delicacy - were I so lucky."
msgstr "...당신은 미식이겠죠. 제가 운만 좋았더라면."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Player
#. NodeID = 34a0cff9-a89f-2ef3-acbe-f44e9732141c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 20
#. CheckFlags:
#.   Dialog:
#.      - FOR_SchoolOgres_Knows_AskedBoss(3) = True
#.      - FOR_SchoolOgres_Knows_TeasedOgre(3) = False
#.   Global:
#.      - FOR_SchoolOgres_Knows_FailedPersuade = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:34a0cff9-a89f-2ef3-acbe-f44e9732141c
msgctxt "h3b261047gb371g4574g8954g14e88cff5e99"
msgid "I'll pay you in the flesh of the fallen - you'll have your fill."
msgstr "대가는 죽은 자들의 고기로 지불하지. 네 배를 채울 수 있잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = 35fa637c-dd1c-dd9e-7513-6aed584dfd13
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_Knows_FailedPersuade = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:35fa637c-dd1c-dd9e-7513-6aed584dfd13
msgctxt "h2f3a1b7fg50ceg448fgbbe7g04cfb2f3eded"
msgid "A slip of the tongue - you meant to make a better offer, surely."
msgstr "말실수를 했군요. 분명 더 나은 제안을 하려 했던 것이겠지요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = 38570d6c-9798-72cb-9125-cf5be6344944
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:38570d6c-9798-72cb-9125-cf5be6344944
msgctxt "h1fb29746gf4a4g4c88ga719gaa76c9b5ef77"
msgid "Make me an offer. <i>Tempt me.</i>"
msgstr "제안해 보시지요. <i>꾀어 보란 말입니다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = 3bf188b6-918e-ed3a-ddbd-3af3609f418b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:3bf188b6-918e-ed3a-ddbd-3af3609f418b
msgctxt "h91b63038g7201g421dg96e3gc04aa0dd4b76"
msgid "She scampered in from the east, calling for 'Yul'. A pet, no doubt."
msgstr "그녀는 동쪽에서 왔지요. '율'이라는 이름을 부르짖더군요. 의심할 바 없이 애완동물의 이름이겠지요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = 3fc44062-65ad-56c2-5dee-f412650eaa6d
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: TIEFLING
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:3fc44062-65ad-56c2-5dee-f412650eaa6d
msgctxt "h9a2b8f0fga63ag464fgb7a6gb906f4daddbd"
msgid ""
"Brothers, look here. I have eyed yet another tiefling prize. Fortune favours "
"our bellies!"
msgstr "형제들, 이걸 보시게. 또 다른 티플링이라니. 행운의 신께서 우리의 배를 가호하시는구나!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = 3fc44062-65ad-56c2-5dee-f412650eaa6d
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:3fc44062-65ad-56c2-5dee-f412650eaa6d
msgctxt "hec440854g4c81g4f50g8994g25274c387338"
msgid ""
"Brothers, look here. I have eyed yet another prize. Fortune favours our "
"bellies!"
msgstr "형제들, 이걸 보시게. 또 다른 횡재라니. 행운의 신께서 우리의 배를 가호하시는구나!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Player
#. NodeID = 46d13c46-b3cb-81e6-5c02-fa2704851740
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_SchoolOgres_Knows_AskedBoss(3) = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:46d13c46-b3cb-81e6-5c02-fa2704851740
msgctxt "h954ff6ccgde44g48dcg8a7eg3e4419c83e23"
msgid "I notice you don't bear a brand of your own."
msgstr "너는 낙인을 지니고 있지 않은 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = 4837f396-c57a-1847-5791-e31d13792edd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:4837f396-c57a-1847-5791-e31d13792edd
msgctxt "hcd45b1c0g54e1g4a53g88fegfa11fbf5e2a7"
msgid ""
"Stranger: be you friend or food? The mark is Her measure: show us the brand "
"of the Absolute."
msgstr "낯선 이여. 당신은 친구입니까, 음식입니까? 표식이 그녀의 척도죠. 절대자의 표식을 보여주세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = 488235b3-f193-1c49-9c75-43217e761edf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:488235b3-f193-1c49-9c75-43217e761edf
msgctxt "hf9a375bbg085ag4694g8896gc8f3c3c5ab58"
msgid "We will keep close. When you are ready, sound the horn."
msgstr "우리는 근처에 있을 것이니, 준비되면 나팔을 울리시죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Player
#. NodeID = 4a5cd392-6722-8195-7446-1ee0cc8d9e36
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Dialog:
#.      - FOR_SchoolOgres_Knows_AskedBoss(3) = True
#.      - FOR_SchoolOgres_Knows_TeasedOgre(3) = True
#.   Global:
#.      - FOR_SchoolOgres_Knows_FailedPersuade = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:4a5cd392-6722-8195-7446-1ee0cc8d9e36
msgctxt "haa0014e3gaa28g4c77gaf93g4fe57be029c1"
msgid "I'll pay you in the flesh of the fallen - you'll have your fill."
msgstr "대가는 죽은 자들의 고기로 지불하지. 네 배를 채울 수 있잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = 4be65c82-3a02-6b9f-a293-5a8deb07fda9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(3) = False
#. SetFlags:
#.   Local:
#.     - 916a75f0-23d8-f05b-449d-d926d69fe782_PassedCheck = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:4be65c82-3a02-6b9f-a293-5a8deb07fda9
msgctxt "h98c064cbg7780g44dbg9470g6664d67337da"
msgid "Indeed? How regrettable, that your meat must go unsavoured."
msgstr "정말인가? 안타깝군요. 당신의 고기를 음미할 수 없다니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Chock
#. NodeID = 50a77535-bfe1-2551-0d7a-6d98f8020da4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_SchoolOgres_State_EntranceUsed_South = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:50a77535-bfe1-2551-0d7a-6d98f8020da4
msgctxt "h23e096c1g1856g4e2fgb296g28e4d5e78376"
msgid "Taste like chicken!"
msgstr "닭고기 맛이 나!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = 586f9016-7691-9c02-ca1c-7bf27b11076e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(3) = True
#. SetFlags:
#.   Local:
#.     - 916a75f0-23d8-f05b-449d-d926d69fe782_PassedCheck = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:586f9016-7691-9c02-ca1c-7bf27b11076e
msgctxt "h570bb2e7gb954g4031ga624g57b7f9170893"
msgid ""
"Yes, yes - the mark is unmistakable. Tell me, sweet creature: does your "
"flesh taste as honeyed as I could hope for?"
msgstr "그래, 그래. 분명히 표식이 있군. 귀여운 생물이여, 알려주시지요. 내 바라건대 당신의 살점은 꿀과 같은 맛이 나나요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Player
#. NodeID = 592761bc-2b50-88bb-1696-13d1b4bae14b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_SchoolOgres_Knows_AskedOgres(3) = False
#. SetFlags:
#.   Dialog:
#.     - FOR_SchoolOgres_Knows_AskedOgres(3) = True
#. TagRule: REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:592761bc-2b50-88bb-1696-13d1b4bae14b
msgctxt "h6aadb9d6g6fe4g4316gaa70g202f4d295422"
msgid "I know of your kind, but you're among the first I've seen."
msgstr "난 너희 부류를 알지만, 직접 본 것은 처음이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Player
#. NodeID = 592761bc-2b50-88bb-1696-13d1b4bae14b
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_SchoolOgres_Knows_AskedOgres(3) = False
#. SetFlags:
#.   Dialog:
#.     - FOR_SchoolOgres_Knows_AskedOgres(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:592761bc-2b50-88bb-1696-13d1b4bae14b
msgctxt "ha24eb8abga445g4985gb07dgf0293a62dd2d"
msgid "I've seen few other ogres in these parts."
msgstr "이 지역에서 오우거는 별로 본 적 없는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Player
#. NodeID = 5a882ea6-6a97-b081-0283-fc8904ee2bf5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_SchoolOgres_Knows_AskedSpeech(3) = False
#. SetFlags:
#.   Dialog:
#.     - FOR_SchoolOgres_Knows_AskedSpeech(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:5a882ea6-6a97-b081-0283-fc8904ee2bf5
msgctxt "h2ed20332gbd43g4b81g93cfg28048a7ee081"
msgid "You are quite the articulate ogre."
msgstr "참 말을 조리있게 하는 오우거네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Player
#. NodeID = 5d0cde04-497c-dd2e-5250-bca94d1b7049
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Dialog:
#.      - FOR_SchoolOgres_Event_AttemptedFirstSkillCheck(3) = True
#. 
#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Player
#. NodeID = d8608b08-38f6-35b1-b229-de9c98d4e2c1
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Dialog:
#.      - FOR_SchoolOgres_Event_AttemptedFirstSkillCheck(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:5d0cde04-497c-dd2e-5250-bca94d1b7049
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:d8608b08-38f6-35b1-b229-de9c98d4e2c1
msgctxt "h1a3eed0fg0e7cg4a14ga8f3gcc92db8eef19"
msgid ""
"<i>Flash your arm at him.</i> There you are. You could see the brand, could "
"you not?"
msgstr "<i>팔을 살짝 보여준다.</i> 여기. 낙인이 보이지, 그렇지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = 60f5019e-9ccb-08b6-1380-42f83ae5197c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:60f5019e-9ccb-08b6-1380-42f83ae5197c
msgctxt "h0b8aff3cg2d1eg4b41g8631ga8e09eb3796f"
msgid ""
"Gentlemen - contain yourselves. This quarrel sours our feast. Besides - "
"taste like pork!"
msgstr "진정해. 소란이 만찬 분위기를 망치고 있잖아. 게다가, 이건 돼지고기 맛이 분명해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Chock
#. NodeID = 612f4fbc-424f-cf3a-9c70-c5ed347bbd4a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_SchoolOgres_State_EntranceUsed_North = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:612f4fbc-424f-cf3a-9c70-c5ed347bbd4a
msgctxt "ha33eae51gc287g43f0g976age2fcd940fdd7"
msgid "Taste like chicken!"
msgstr "닭고기 맛이 나!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = 63124505-0739-e2ad-08d1-5e028b710565
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToIndivPlayerAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:63124505-0739-e2ad-08d1-5e028b710565
msgctxt "h703d7a61g8c2eg4cd7g9386g821966a65328"
msgid "It's <i>dinnertime,</i> boys!"
msgstr "얘들아, <i>저녁 시간</i>이다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = 670433c2-4f5b-d12d-4b05-53349080795f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:670433c2-4f5b-d12d-4b05-53349080795f
msgctxt "hcf79ec7fgf321g4444gb014g1cdc8506e88d"
msgid ""
"A serenade to my ears, and a boon to my belly. We've a bargain, my tasty "
"kibble!"
msgstr "내 귀에 들려오는 세레나데, 내 배에 들어오는 축복이로구나! 거래 성립이요, 맛난 음식!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = 673b0b04-8e57-c842-b1e1-cbc6e1794388
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:673b0b04-8e57-c842-b1e1-cbc6e1794388
msgctxt "h758ac11cgc766g494fg904cged58bf0e9b90"
msgid "Use it when the need arises - and never a moment before."
msgstr "필요할 때 사용하고, 한 순간도 일찍 사용하지 마시지요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = 676d6bbd-c60a-f044-9c37-2ca1d1991442
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:676d6bbd-c60a-f044-9c37-2ca1d1991442
msgctxt "hb1d9c1e2gc8e1g4c5aga267g53c8ce4554e7"
msgid "Alas - not so much as a nibble."
msgstr "아아, 한 입조차 안 되다니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = 678ec7ef-5607-fc92-aa03-fcf16648556f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:678ec7ef-5607-fc92-aa03-fcf16648556f
msgctxt "hf555e85bg8eebg44f0g8704g14a5c03dc76e"
msgid "Well spoken. Indeed, ogre 'kill everyone around'."
msgstr "말 한번 잘 했구나. 과연, 오우거는 '전부 다 죽인다'고 할 수 있지요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Player
#. NodeID = 67d5235d-117c-98a1-4f9f-8469f85e500b
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Dialog:
#.      - FOR_SchoolOgres_Event_AttemptedFirstSkillCheck(3) = True
#. 
#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Player
#. NodeID = 1ebf1b93-c317-935a-e20f-b5553892ae52
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Dialog:
#.      - FOR_SchoolOgres_Event_AttemptedFirstSkillCheck(1) = True
#.   Tag:
#.      - BARBARIAN(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:67d5235d-117c-98a1-4f9f-8469f85e500b
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:1ebf1b93-c317-935a-e20f-b5553892ae52
msgctxt "hea9637f5g6d6bg4923g87f8g5f1f6edd42f9"
msgid ""
"Do not test the Absolute's finest, ogre. You would not survive Her wrath."
msgstr "절대자에게 총애받는 자를 시험하지 마라, 오우거. 그녀의 진노에서 살아남지 못할 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = 6a89bafe-4419-0ef3-6294-00a5d2367a56
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:6a89bafe-4419-0ef3-6294-00a5d2367a56
msgctxt "h747fd5f4g6685g46a2g89ebg34c6b1f982c3"
msgid "Oh, but you <i>do</i> love to tease."
msgstr "아아, 하지만 <i>당신은</i> 애태우는 걸 참으로 좋아하는군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Player
#. NodeID = 6c16b722-a5fc-dff3-3ad8-cc7c291f4769
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_SchoolOgres_Knows_AskedBoss(3) = True
#.   Script:
#.      - GEN_CheckPocketGold = True
#. SetFlags:
#.   Object:
#.     - GEN_TransferNPCPayment(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:6c16b722-a5fc-dff3-3ad8-cc7c291f4769
msgctxt "ha75c0c0ag1c3fg4fa1g8038g35e323ee310d"
msgid ""
"I'll give you [6057ad05-9492-4630-9f0a-be548b134c54] gold if I can call you "
"into battle."
msgstr "전투를 도와준다면 [6057ad05-9492-4630-9f0a-be548b134c54] 골드를 주겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = 6cb2fcfd-976a-23dd-c47c-37e997b3449d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:6cb2fcfd-976a-23dd-c47c-37e997b3449d
msgctxt "h1689da22gea1eg4cbag9714ge358b57941a0"
msgid ""
"No, not food. Too tough for your digestion, I fear. Perhaps... friend, then?"
msgstr "아니, 먹을 거 아니야. 소화하기 너무 힘들 거 같구나. 그렇다면... 친구가 어떨지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Player
#. NodeID = 7168105b-3200-e888-d809-0dc8b0cf6ad8
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 20
#. CheckFlags:
#.   Tag:
#.      - BERSERKER(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:7168105b-3200-e888-d809-0dc8b0cf6ad8
msgctxt "hffbb0801g0690g4526g81cdgc5ee94f16be1"
msgid "<b>JOIN ME OR I'LL CRUSH YOU TO PULP!</b>"
msgstr "<b>나와 함께하지 않으면 으깨서 곤죽으로 만들어 주지!</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Player
#. NodeID = 723f2040-05cd-9aeb-a5db-8233a3f99eb7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_SchoolOgres_Knows_AskedBoss(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:723f2040-05cd-9aeb-a5db-8233a3f99eb7
msgctxt "h5cce3192g7e77g4d0fgbc88g86500aba66c5"
msgid "Forget goblins. You should be fighting for me."
msgstr "고블린들은 잊어버려. 나를 위해 싸워라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = 72e43e4e-f506-e87b-9d2c-2138b82743f8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 916a75f0-23d8-f05b-449d-d926d69fe782_PassedCheck = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:72e43e4e-f506-e87b-9d2c-2138b82743f8
msgctxt "h29a0bd6cg51c2g483fgba3eg42df96de89c1"
msgid "Spoken with the confidence only a True Soul could muster!"
msgstr "참된 영혼만이 가질 수 있는 자신감으로 말하시는군요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Chock
#. NodeID = 7303f6b0-4fc9-627f-1956-4444ee93b741
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:7303f6b0-4fc9-627f-1956-4444ee93b741
msgctxt "h6a989c98g3aabg4f72g9d62g132903903719"
msgid "Food?"
msgstr "먹을 거?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = 75bc316e-b7c6-420f-b6ed-9d4af7137f41
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_State_OfferedMeat = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:75bc316e-b7c6-420f-b6ed-9d4af7137f41
msgctxt "h8244a41dgf1dag4525gaaefg5020dc3049d7"
msgid ""
"A brilliant notion, and a boon to my aching belly. We have a deal, my tasty "
"kibble!"
msgstr "총명한 관념이요, 내 주린 배에 들어오는 축복이로구나! 거래 성립이요, 맛난 음식!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Player
#. NodeID = 79780cb8-b2e2-148c-e007-0f13a6d70ed2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BRANDED(3) = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:79780cb8-b2e2-148c-e007-0f13a6d70ed2
msgctxt "hfcce6403gce69g4d8fg9ce9g82ad750ad94e"
msgid "I bear no such brand."
msgstr "그 낙인은 지니고 있지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Fank
#. NodeID = 7d991792-fc37-76de-3dfd-2ee9373e0d0f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:7d991792-fc37-76de-3dfd-2ee9373e0d0f
msgctxt "h542c8a95ga0aag43b6g910fg3664c36e430e"
msgid "Food?"
msgstr "먹을 거?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Player
#. NodeID = 844d62b4-9754-a05f-3191-7314553ec320
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 20
#. CheckFlags:
#.   Tag:
#.      - PALADIN(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:844d62b4-9754-a05f-3191-7314553ec320
msgctxt "he80ea40fg5de4g4398g99bbg763984ad0089"
msgid "Fight for me and my oath or I'll cut the last meal from your belly."
msgstr "나와 내 맹세를 위해 싸워라. 그렇게 하지 않으면 네 배를 갈라버리겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Player
#. NodeID = 846c62d8-bb1b-21ad-65d6-57dadcfbe95c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:846c62d8-bb1b-21ad-65d6-57dadcfbe95c
msgctxt "h43c4ab67g5d11g42d0gb60cg4e5e6d883aef"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = 87a6da10-93ee-af91-cac2-459c109408ef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:87a6da10-93ee-af91-cac2-459c109408ef
msgctxt "h9b095f65gf6b8g49ceg85a4g42517a06236f"
msgid "Unh. <i>Dissatisfying.</i>"
msgstr "어휴. <i>불만족스럽군요.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Player
#. NodeID = 8892c987-0f0d-ccda-ce6c-c8b63970d74f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:8892c987-0f0d-ccda-ce6c-c8b63970d74f
msgctxt "h7dbed67fg0fceg42d7gbd9eg615f89d65af7"
msgid "I've changed my mind. The offer is off the table."
msgstr "생각이 바뀌었어. 제안은 취소다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Player
#. NodeID = 8c7a017c-481c-355d-1df9-7d7238baf2c4
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Dialog:
#.      - FOR_SchoolOgres_Knows_AskedBoss(3) = True
#.      - FOR_SchoolOgres_Knows_TeasedOgre(3) = False
#.   Global:
#.      - FOR_SchoolOgres_Knows_FailedPersuade = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:8c7a017c-481c-355d-1df9-7d7238baf2c4
msgctxt "h0e99a21bg225cg4fafg9884gf037a048bf3b"
msgid ""
"[463b0f43-5410-412d-aba3-875cf81c38ca] gold - <i>after</i> you fight for me."
msgstr "[463b0f43-5410-412d-aba3-875cf81c38ca] 골드를 주지. 네가 싸워주고 나서 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = 90e55ed9-1140-9948-4a91-3b93a1ab7829
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:90e55ed9-1140-9948-4a91-3b93a1ab7829
msgctxt "habbbe592g0ae5g4d40gaeb2gf267fe4da010"
msgid "We follow the scents of blood and gold to all lands fertile, friend."
msgstr "우리는 피와 황금의 냄새를 따라서, 비옥한 땅이라면 어디든 가지요, 친구여."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = 91100cf3-b5f7-2c5f-5d9c-1820ed8df941
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(3) = True
#. SetFlags:
#.   Local:
#.     - 916a75f0-23d8-f05b-449d-d926d69fe782_PassedCheck = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:91100cf3-b5f7-2c5f-5d9c-1820ed8df941
msgctxt "h6c2feb76g7f12g4e8ega1aeg6a1838839c10"
msgid ""
"How regrettable. Tell me, sweet creature: does your flesh taste as honeyed "
"as I could hope for?"
msgstr "안타깝기 그지없어라. 귀여운 생물이여, 알려주시지요. 내 바라건대 당신의 살점은 꿀과 같은 맛이 나나요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Player
#. NodeID = 919007b4-77be-9a55-45c3-7d6f748f62d7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:919007b4-77be-9a55-45c3-7d6f748f62d7
msgctxt "h754f65c2g638fg4b7bgae8bg28b76016c129"
msgid "I'll leave that to your imagination."
msgstr "상상에 맡기지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = 91a15302-bbee-bd56-cece-fb4559b5215c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(3) = False
#. SetFlags:
#.   Local:
#.     - 916a75f0-23d8-f05b-449d-d926d69fe782_PassedCheck = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:91a15302-bbee-bd56-cece-fb4559b5215c
msgctxt "ha0216faag1fbdg4129g8807geec3c52395f5"
msgid ""
"Yes, yes - the mark is unmistakable. How regrettable, that your meat must go "
"unsavoured."
msgstr "그래, 그래요. 분명히 표식이 있군. 당신의 고기를 음미할 수 없다니 참으로 유감이군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = 93313535-84c3-6034-cfdb-05be8e7bfe09
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - FOR_SchoolOgres_Knows_TeasedOgre(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:93313535-84c3-6034-cfdb-05be8e7bfe09
msgctxt "hc2bc0485g527ag4134g829fg8f9a9cd6a14b"
msgid "Unh. You <i>wound</i> me, creature. I can hardly resist you."
msgstr "아아. 당신은 내 마음에 상처를 입히는군요. 저항하기 참 어렵군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Fank
#. NodeID = 989739d6-cf79-cf9a-e649-30dd490e1273
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:989739d6-cf79-cf9a-e649-30dd490e1273
msgctxt "hc53ba353gd097g40a2gaf4cg8f3d2cca7298"
msgid "<i>Food?</i>"
msgstr "<i>먹을 거?</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = a0ea58c9-2e30-0131-4961-bcb5bf6cd6c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:a0ea58c9-2e30-0131-4961-bcb5bf6cd6c8
msgctxt "hcb6f967cga134g41a0gad93g364d2c9c1858"
msgid "An admirable instinct, but you're biting off more than you can chew."
msgstr "참으로 존경스러운 본능이지만, 당신은 지금 소화도 못 할 음식을 탐내고 있는 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Player
#. NodeID = a10df8f8-ac04-75e2-be30-c3cda79fa4fa
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. SetFlags:
#.   Dialog:
#.     - FOR_SchoolOgres_Event_AttemptedFirstSkillCheck(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:a10df8f8-ac04-75e2-be30-c3cda79fa4fa
msgctxt "h2d89f247g547ag4056gbed9g09ac52c5ec34"
msgid "I'll do you one better - I'm one of the Absolute's chosen disciples."
msgstr "그보다 한 수 위지. 난 절대자에게 선택받은 신봉자 중 한 명이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Player
#. NodeID = a37bfa29-567b-1f61-fef0-ca3f9db41569
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Dialog:
#.      - FOR_SchoolOgres_Event_AttemptedFirstSkillCheck(3) = True
#.   Tag:
#.      - BERSERKER(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:a37bfa29-567b-1f61-fef0-ca3f9db41569
msgctxt "h605cbddagc5b8g45cdgb96dg7d15c7b5086b"
msgid "<b><i>ROAR.</i></b>"
msgstr "<b><i>크아아.</i></b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Chock
#. NodeID = a68043cd-3304-0240-ff74-6d1aedf10eea
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_SchoolOgres_State_EntranceUsed_East = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:a68043cd-3304-0240-ff74-6d1aedf10eea
msgctxt "h360b9200gf4a5g483bg960cg4f37918c7e15"
msgid "Taste like chicken!"
msgstr "닭고기 맛이 나!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Player
#. NodeID = a6c037c1-5a7e-de6f-dec9-73aa77f7bc2b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:a6c037c1-5a7e-de6f-dec9-73aa77f7bc2b
msgctxt "h97dca244gd557g47d7g91bcg528dc598dd92"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Player
#. NodeID = a6ebafa8-8a77-0d49-6c90-86acc1c4899a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BRANDED(3) = True
#. SetFlags:
#.   Local:
#.     - 916a75f0-23d8-f05b-449d-d926d69fe782_PassedCheck = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:a6ebafa8-8a77-0d49-6c90-86acc1c4899a
msgctxt "h62a6ed50ga312g44b5g9d57g3528e33d9c80"
msgid "<i>Show him your brand.</i>"
msgstr "<i>낙인을 보여준다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = a9380827-338c-6845-9190-81de5104491c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:a9380827-338c-6845-9190-81de5104491c
msgctxt "h8451dc61gcc08g469dga8ffg025456a1faa4"
msgid ""
"Am I not astonishing? A robust diet makes for a shrewd mind, you see. I am a "
"<i>gourmand...</i>"
msgstr "감탄스럽지 않습니까? 보시다시피 왕성한 식단이 영리한 정신을 이루는 법이지요. <i>저는 대식가랍니다...</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Chock
#. NodeID = aa6c8ab0-35dc-0563-36c3-d7c4773ffbd0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:aa6c8ab0-35dc-0563-36c3-d7c4773ffbd0
msgctxt "h4a3f93c1g482cg4790ga940g79369d878e24"
msgid "Food?"
msgstr "먹을 거?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = b1e548c6-435a-344e-48db-fed22bbabd1a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_State_PassedHasMet = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:b1e548c6-435a-344e-48db-fed22bbabd1a
msgctxt "h6962dc5eg2851g4aafg9832g7568f52ab0b6"
msgid "No. Not food."
msgstr "아냐. 음식이 아니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Player
#. NodeID = b7354fd5-645e-f9d3-1de0-4a48cfd82fb7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_SchoolOgres_Knows_AskedSpeech(3) = False
#.   Local:
#.      - 916a75f0-23d8-f05b-449d-d926d69fe782_FailedCheck = False
#. SetFlags:
#.   Dialog:
#.     - FOR_SchoolOgres_Knows_AskedSpeech(3) = True
#. TagRule: REALLY_ELF
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:b7354fd5-645e-f9d3-1de0-4a48cfd82fb7
msgctxt "h040e7de5g436dg4d25g99e7g372d1a96df51"
msgid "You speak with an eloquence unusual to your kind."
msgstr "넌 네 종족에 어울리지 않게 말이 유창하군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Player
#. NodeID = b7354fd5-645e-f9d3-1de0-4a48cfd82fb7
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_SchoolOgres_Knows_AskedSpeech(3) = False
#.   Local:
#.      - 916a75f0-23d8-f05b-449d-d926d69fe782_FailedCheck = False
#. SetFlags:
#.   Dialog:
#.     - FOR_SchoolOgres_Knows_AskedSpeech(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:b7354fd5-645e-f9d3-1de0-4a48cfd82fb7
msgctxt "h1964b7fbgbfc1g453dgb088g0ccf9e1898d7"
msgid "You're quite eloquent for an ogre."
msgstr "오우거치고는 꽤 말을 유창하게 하는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Player
#. NodeID = b9c45c86-9cb9-bd86-627c-ee5d1594f421
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_SchoolOgres_Knows_AskedBoss(3) = True
#.      - FOR_SchoolOgres_Knows_TeasedOgre(3) = True
#.   Global:
#.      - FOR_SchoolOgres_Knows_FailedPersuade = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:b9c45c86-9cb9-bd86-627c-ee5d1594f421
msgctxt "h5de27087gd1a7g481egb791g95c9bc173fc1"
msgid ""
"I'll give you [463b0f43-5410-412d-aba3-875cf81c38ca] gold - <i>after</i> you "
"fight for me."
msgstr ""
"[463b0f43-5410-412d-aba3-875cf81c38ca] 골드를 주겠다. <i>단</i> 날 위해 <i>먼저</i> 싸우고 "
"나서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Chock
#. NodeID = ba30b1f4-2428-4aa1-a0d6-79de6742fcb9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_SchoolOgres_State_EntranceUsed_SouthEastDoor = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:ba30b1f4-2428-4aa1-a0d6-79de6742fcb9
msgctxt "h3cc3ca26gd74ag431eg96e3g983584a43d56"
msgid "Taste like chicken!"
msgstr "닭고기 맛이 나!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = c0d70ea5-1c68-87c9-4177-4206645b2315
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:c0d70ea5-1c68-87c9-4177-4206645b2315
msgctxt "h70aed787g2ae3g4971gb7e9g55598ab8a9ae"
msgid ""
"How regrettable. Tell me, sweet creature: does your flesh taste as honeyed "
"as I could hope for?"
msgstr "안타깝기 그지없어라. 귀여운 생물이여, 알려주시지요. 내 바라건대 당신의 살점은 꿀과 같은 맛이 나나요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Player
#. NodeID = c146a481-b798-0a27-2e57-a21aa7ffd81e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:c146a481-b798-0a27-2e57-a21aa7ffd81e
msgctxt "h2aecf0d8g690dg43c5gbe56gb1dd5cb122dd"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = cd576594-fd53-89bd-c4c2-8709cd19c066
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:cd576594-fd53-89bd-c4c2-8709cd19c066
msgctxt "hea2bd067gea3eg4763gbab6geca1d1d1899d"
msgid "... and you, a delicacy - unless you bear the mark, of course."
msgstr "... 그리고 당신은 별미겠군요. 물론 표식을 지니지 않았을 경우에 말입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = cd7f0009-feb0-658c-9bab-301c267095ce
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_Knows_FailedPersuade = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:cd7f0009-feb0-658c-9bab-301c267095ce
msgctxt "he26d9768g80cbg4fcbg827bg18b8087d0252"
msgid "Such sweet suggestions. Have a care - you may make yourself stringy."
msgstr "참으로 구미가 당기는 제안이로군요. 조심하시지요. 너무 강골이 되지 않게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = ce61a4bb-e114-a445-c87a-d1279978b836
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:ce61a4bb-e114-a445-c87a-d1279978b836
msgctxt "h7c9733ddg322dg43d5g9af8g89a5224e6d3b"
msgid "And this land proves particularly... fruitful."
msgstr "그리고 이 땅은 특히나... 풍요롭지요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = cf46944e-a0fa-be98-5c13-b255c32dbc87
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:cf46944e-a0fa-be98-5c13-b255c32dbc87
msgctxt "h13290876g9b2ag4378gb91agc08c17111350"
msgid ""
"Such an uncouth outburst - I fear it may spoil the succulence of your meat."
msgstr "그토록 상스럽게 감정을 폭발시키다니. 그 성질이 당신 고기의 육즙을 망쳐 버릴까 두렵군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Fank
#. NodeID = d1cc24cd-2eba-1bd2-1be8-f58ee7899c74
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:d1cc24cd-2eba-1bd2-1be8-f58ee7899c74
msgctxt "h370e5fc0g134ag484fgabe5g3cb0e9161826"
msgid "No chicken. Taste like fish!"
msgstr "닭 아니야. 물고기 맛이 난다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Player
#. NodeID = d4d56ac4-fc89-7e4f-d4c7-4cb4d4dcdf5d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_TIEFLING(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:d4d56ac4-fc89-7e4f-d4c7-4cb4d4dcdf5d
msgctxt "hde02d733ge0b1g4362gb850g1f8a25441b00"
msgid "Are you eating a tiefling?"
msgstr "티플링을 먹고 있는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Chock
#. NodeID = d5c328df-1d7e-aba4-4dd5-c3fc1385902e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_SchoolOgres_State_EntranceUsed_West = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:d5c328df-1d7e-aba4-4dd5-c3fc1385902e
msgctxt "h6cd6a3a8g4486g43c4gb43cg46f1525c293c"
msgid "Taste like chicken!"
msgstr "닭고기 맛이 나!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Player
#. NodeID = d7a6b972-a604-b5b7-ebea-16e6fb4e336e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:d7a6b972-a604-b5b7-ebea-16e6fb4e336e
msgctxt "h68b82903g20adg4541g9f8bg3f3f38582129"
msgid "These horns are not yours to take! <i>Attack.</i>"
msgstr "누구 맘대로 내 뿔을! <i>공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = d91be8ac-fff5-3160-c37f-c46981b7497c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(3) = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:d91be8ac-fff5-3160-c37f-c46981b7497c
msgctxt "h0a667aa2gc96bg4b2fgb7e7ga9a0cc17dc92"
msgid "I see it. How regrettable, that your meat must go unsavoured."
msgstr "알겠군요. 당신의 고기를 음미할 수 없다니 참으로 유감이군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = daa08cc2-b6d5-34cc-b4d0-a25e8945cf75
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_Knows_FailedPersuade = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:daa08cc2-b6d5-34cc-b4d0-a25e8945cf75
msgctxt "h93ca8dd8g6ebfg4a24g8091g65107e8292da"
msgid "Come, now. An ogre feasts not on promises."
msgstr "이런, 오우거는 약속을 먹고 살지 않는다고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Chock
#. NodeID = dbfd3071-306b-7309-eb2a-306ec7a732ba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:dbfd3071-306b-7309-eb2a-306ec7a732ba
msgctxt "hec40921dg83cfg4717g9784g92739693d4e6"
msgid "Boss goblin give gold. We check brand. Good deal!"
msgstr "고블린 두목이 금화 준다. 우리는 낙인 확인한다. 좋은 거래다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = dc16327f-2f20-91ff-4e36-13c1b6f2898d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:dc16327f-2f20-91ff-4e36-13c1b6f2898d
msgctxt "h5fbae303gca01g4787ga7d4g5e1fb7c48861"
msgid "Now let's see that mark, lest I give in to my cravings."
msgstr "자, 그럼 제가 탐욕에 굴복하기 전에 어서 그 표식을 보여주시죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Player
#. NodeID = e36b2edd-3838-880c-f96b-4f77c856eb8c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BERSERKER(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:e36b2edd-3838-880c-f96b-4f77c856eb8c
msgctxt "h3ad05dd2g40cag4677g93a8ge69fc16eccc8"
msgid "<b><i>ROAR.</i></b>"
msgstr "<b><i>크아아.</i></b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Player
#. NodeID = e57c93e5-ab26-4e99-b095-3dc8df238ddb
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 20
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(3) = True
#.      - BERSERKER(3) = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:e57c93e5-ab26-4e99-b095-3dc8df238ddb
msgctxt "h34514952g046dg42b0g9cecg733354d2c2fb"
msgid "How about I spare your life. That tempting enough?"
msgstr "내가 널 죽이지 않는 건 어때. 그 정도면 솔깃한가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Chock
#. NodeID = ee674034-c843-dc9a-3976-42bff3730098
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:ee674034-c843-dc9a-3976-42bff3730098
msgctxt "hdbddcf54ge6b3g4f07g8f44g04a2c4919342"
msgid "Food?"
msgstr "먹을 거?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = ee81742d-462c-0b46-d611-5d7067538516
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:ee81742d-462c-0b46-d611-5d7067538516
msgctxt "h8806a6a3g4e30g4f40g870eg75244746400d"
msgid ""
"Take my bonehorn. One blow, and... just a moment. It's been thieved - and I "
"know the culprit."
msgstr "내 뿔나팔을 가져가시지요. 한 번 불면... 잠시만, 누군가가 절도해갔군요. 범인이 누군지는 알겠네요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = f2953c04-d152-1260-8e49-a486a101565e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:f2953c04-d152-1260-8e49-a486a101565e
msgctxt "h06041c3cg3be7g48c3gb046g9cd96d906bb9"
msgid "... and the rest sate my hunger for <i>meat.</i>"
msgstr "... 그리고 나머지는 <i>고기</i>를 먹고 싶은 내 허기를 달래줬죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = f5077696-d75d-b43d-a5a7-be7c1bc84d3e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_State_OfferedLatePayment = True
#.     - FOR_SchoolOgres_State_Hired = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:f5077696-d75d-b43d-a5a7-be7c1bc84d3e
msgctxt "he6320167gcea2g4b8eg9ec0g66adefcc9edb"
msgid "A twice-played serenade to my ears, my tasty kibble. We have a bargain!"
msgstr "우리 맛있는 친구분의 말이 마치 꾀꼬리가 지저귀듯 달콤하군요. 거래 성립입니다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Player
#. NodeID = f5800457-fd88-6b51-b53c-b0fb12db42ef
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - PALADIN(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:f5800457-fd88-6b51-b53c-b0fb12db42ef
msgctxt "h1fa188bagb52cg4c5egb498g0bdcfe6922fa"
msgid "Try to eat me and I'll brand your corpse with the mark of my oath."
msgstr "날 잡아먹으려 하면 네 시체에 내 맹세의 낙인을 찍어주마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Fank
#. NodeID = f5e66e70-4ef7-9ea9-e27f-ecbd4f341cf4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:f5e66e70-4ef7-9ea9-e27f-ecbd4f341cf4
msgctxt "h2822a46ag3cebg42e1gb5e1ge0e6452ce20d"
msgid "Friend."
msgstr "친구."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = f92e0251-d317-f1ee-4b6c-3034ae7cca3c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:f92e0251-d317-f1ee-4b6c-3034ae7cca3c
msgctxt "hb65a7b1ag1804g48ffgb6feg2b4294a30d81"
msgid "And what surprise is <i>this?</i>"
msgstr "<i>이건</i> 또 어떤 깜짝 등장인가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted
#. Speaker = Lump the Enlightened
#. NodeID = fd320e63-d051-c0f6-de90-ec0e8c40b4ea
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_Spotted:fd320e63-d051-c0f6-de90-ec0e8c40b4ea
msgctxt "he472953eg9038g4f37ga182ga7e3c2112323"
msgid "Mm - your candour makes you all the more enticing."
msgstr "으흠, 당신의 그 태도 덕분에 더욱 탐스럽게 보이는군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Schoolhouse_AD_DoorMarks
#. Speaker = Narrator
#. NodeID = 100a2adf-df08-f072-c18a-6cfb45c018bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Schoolhouse_AD_DoorMarks:100a2adf-df08-f072-c18a-6cfb45c018bf
msgctxt "heebb35fag8101g45d5g9f7dg8c8a4ce009d0"
msgid ""
"*Names and heights have been carved into the wood over the years. The last "
"two read 'Maggie Terrens' and 'Marcus Terrens'. Twins, perhaps.*"
msgstr ""
"*이름들과 키를 잰 표시들이 몇년에 걸쳐 나무에 새겨져 있습니다. 마지막 두 개는 '매기 테렌스'와 '마커스 테렌스'라고 적혀 있습니다. "
"아마 쌍둥이였을 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_NoticeShrine
#. Speaker = Player
#. NodeID = 16f24a21-6fa3-ff2e-3fc7-835e7555b453
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: (CLERIC_SHAR or PALADIN_SHAR) and !REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_NoticeShrine:16f24a21-6fa3-ff2e-3fc7-835e7555b453
msgctxt "ha610ead9gb83cg4e3dg9977g1775830228b1"
msgid "A Selûnite shrine over there. Left to rot by the looks of it - good."
msgstr "저곳에 셀루네의 성소가 있어. 보아하니, 한참 동안 방치되어 있었던 것 같네, 좋아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_NoticeShrine
#. Speaker = Player
#. NodeID = 16f24a21-6fa3-ff2e-3fc7-835e7555b453
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: CLERIC_SELUNE or PALADIN_SELUNE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_NoticeShrine:16f24a21-6fa3-ff2e-3fc7-835e7555b453
msgctxt "h990f31b2g489eg4d92ga721g97547da0e297"
msgid "Over there - a shrine to Selûne. By Moonmaiden's grace."
msgstr "저길 봐, 셀루네님의 성소야. 달처녀의 축복이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_NoticeShrine
#. Speaker = Player
#. NodeID = 54f3f94f-b89e-708d-62f4-a072792ea2df
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_SeluneStash_State_KnowShrineCheckSuccess = False
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_NoticeShrine:54f3f94f-b89e-708d-62f4-a072792ea2df
msgctxt "hbf085458g9725g4cb0gbf85gb29f100bc7bc"
msgid "Another shrine to another god."
msgstr "또 다른 신의, 또 다른 성소군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_NoticeShrine
#. Speaker = Player
#. NodeID = 54f3f94f-b89e-708d-62f4-a072792ea2df
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_SeluneStash_State_KnowShrineCheckSuccess = False
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_NoticeShrine:54f3f94f-b89e-708d-62f4-a072792ea2df
msgctxt "hf39c7e6egfe78g4cefgb201g9fada6a08881"
msgid "A shrine. Looks forlorn."
msgstr "성소야. 쓸쓸해 보이는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_NoticeShrine
#. Speaker = Player
#. NodeID = 54f3f94f-b89e-708d-62f4-a072792ea2df
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_SeluneStash_State_KnowShrineCheckSuccess = False
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_NoticeShrine:54f3f94f-b89e-708d-62f4-a072792ea2df
msgctxt "h50bc0694g260ag4cb3gbaeag03e008a3ab7d"
msgid "Hey, a shrine.\n"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_NoticeShrine
#. Speaker = Player
#. NodeID = 54f3f94f-b89e-708d-62f4-a072792ea2df
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_SeluneStash_State_KnowShrineCheckSuccess = False
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_NoticeShrine:54f3f94f-b89e-708d-62f4-a072792ea2df
msgctxt "ha004d92cg484ag4ed9g8185g2e5d26cf236e"
msgid "Look there - a shrine."
msgstr "저길 봐, 성소가 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_NoticeShrine
#. Speaker = Player
#. NodeID = 54f3f94f-b89e-708d-62f4-a072792ea2df
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_SeluneStash_State_KnowShrineCheckSuccess = False
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_NoticeShrine:54f3f94f-b89e-708d-62f4-a072792ea2df
msgctxt "h22f31cd5g9c97g4d9ag8d7ag4030401f6d0b"
msgid "Look at that. Unlikely place for a shrine."
msgstr "저길 봐. 이런 장소에 성소가 있군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_NoticeShrine
#. Speaker = Player
#. NodeID = 54f3f94f-b89e-708d-62f4-a072792ea2df
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_SeluneStash_State_KnowShrineCheckSuccess = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_NoticeShrine:54f3f94f-b89e-708d-62f4-a072792ea2df
msgctxt "h6a905baag8d48g4305g90b1g24d2ce62ea3a"
msgid "Looks like there's a little shrine over there."
msgstr "저기 작은 성지가 있는 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_NoticeShrine
#. Speaker = Player
#. NodeID = 993d04c7-976a-05d5-8cf8-73b989b55ab3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ShadowHeart_InParty_Knows_SharWorshipper = False
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_NoticeShrine:993d04c7-976a-05d5-8cf8-73b989b55ab3
msgctxt "h223c27afg6752g4cf6gb8e2g3856bfaabf7d"
msgid "A Selûne statue? In a stinking cave? Hardly a place of honour."
msgstr "셀루네의 조각상이잖아? 이런 악취 나는 동굴에? 그다지 예를 갖출 만한 장소는 아닌데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_NoticeShrine
#. Speaker = Player
#. NodeID = bed9db99-9a77-2def-4952-17de1d7364b8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_SeluneStash_State_KnowShrineCheckSuccess = True
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_NoticeShrine:bed9db99-9a77-2def-4952-17de1d7364b8
msgctxt "ha92f32bbga522g4197gb063g6ead4c077250"
msgid "A shrine to Selûne. Quaint."
msgstr "셀루네의 성소군. 진기해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_NoticeShrine
#. Speaker = Player
#. NodeID = bed9db99-9a77-2def-4952-17de1d7364b8
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_SeluneStash_State_KnowShrineCheckSuccess = True
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_NoticeShrine:bed9db99-9a77-2def-4952-17de1d7364b8
msgctxt "h52e1733dgea79g447dgbfdeg831ccf94d7e3"
msgid "An unusual place to find a shrine of Selûne, but there it is."
msgstr "이런 외딴 곳에 셀루네의 성소가 있다니, 신기하네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_NoticeShrine
#. Speaker = Player
