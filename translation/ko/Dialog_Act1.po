msgctxt "h37c116a6g6ba7g4ba7ga996g7d1c2b0a57c5"
msgid "Dead. Finally."
msgstr "죽었군. 드디어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaezelRecruitment_AD_LaezelInspectsCorpses
