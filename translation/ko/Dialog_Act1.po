msgctxt "h57496677gd89bg4345g9e8cg48f6e9ef75ce"
msgid ""
"The myconids are trying to help, but I keep seeing my friends in Moonrise - "
"screaming."
msgstr "마이코니드들이 도와주려 하고는 있지만, 문라이즈에 잡혀서 비명을 지르는 친구들의 얼굴이 눈에 밟혀요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerDaffy_Saved
#. Speaker = Apprentice Laridda
#. NodeID = c9a99b10-ad73-5d5b-34f1-155318842177
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerDaffy_Saved:c9a99b10-ad73-5d5b-34f1-155318842177
msgctxt "h0f72f2e0gc127g46eagb990gbafecc395894"
msgid "... I can't bear to think of it."
msgstr "... 차마 생각할 수가 없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerLumpy
#. Speaker = Welso
#. NodeID = 2c9669d2-3e59-7c6c-8ca6-b04feb9a15d3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_GnomeWorkerLumpy_HasMet(1) = True
#.   Global:
#.      - UND_DuergarGuards_Excavation_State_PermaDefeated = True
#.      - UND_DuergarCamp_State_CaveInCleared = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerLumpy:2c9669d2-3e59-7c6c-8ca6-b04feb9a15d3
msgctxt "h661c2ba1g4674g4f4bga9ddgb40a2bb32482"
msgid "Get Meerna out of there. I'll do anything."
msgstr "미르나를 거기서 꺼내줘요. 뭐든지 할 테니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerLumpy
#. Speaker = Welso
#. NodeID = 2f08803d-42e4-2833-bc78-faca348e1d18
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerLumpy:2f08803d-42e4-2833-bc78-faca348e1d18
msgctxt "h6c348d23g65abg4c92gb0b1g86d8de2a9c5c"
msgid "Please - my sister's in there..."
msgstr "부탁이에요, 내 여동생이 저 안에 있어요..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerLumpy
#. Speaker = Welso
#. NodeID = 56ba5d22-8156-7040-2202-9aab0d11e9e1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_GnomeWorkerLumpy_HasMet(1) = True
#.   Global:
#.      - UND_DuergarGuards_Excavation_State_PermaDefeated = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerLumpy:56ba5d22-8156-7040-2202-9aab0d11e9e1
msgctxt "h503d2f6ag3aebg41e4g9325g46417d96fdd5"
msgid "I'm coming, Meerna!"
msgstr "지금 갈게, 미르나!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerLumpy
#. Speaker = Welso
#. NodeID = 976bb2ec-10f8-0f15-ce85-ff27f6e8c083
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerLumpy:976bb2ec-10f8-0f15-ce85-ff27f6e8c083
msgctxt "h2e893370gd304g4e31g97ffg4b8f787c7826"
msgid "<i>Shael vuk.</i> Death is too good for him."
msgstr "<i>샬벅.</i> 죽음도 이 놈에게는 너무 과분해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerLumpy
#. Speaker = Welso
#. NodeID = a1c5284b-b34b-7c6b-03a8-15aad076fdfb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_TheDrowNere_State_PermaDefeated = True
#.      - UND_DuergarCamp_State_SidedLoyal = True
#. SetFlags:
#.   Dialog:
#.     - UND_GnomeWorkerLumpy_HasmetRescued(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerLumpy:a1c5284b-b34b-7c6b-03a8-15aad076fdfb
msgctxt "h500b61ebg7a75g4c8bg9aecgec1b9810843b"
msgid "Meerna... Nere killed her. She's - she's really gone."
msgstr "미르나... 니어가 죽였어. 정, 정말 죽어버리다니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerLumpy
#. Speaker = Welso
#. NodeID = aa9ec206-eed4-c7c2-c7a6-384ff969a382
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_GnomeWorkerLumpy_HasmetRescued(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerLumpy:aa9ec206-eed4-c7c2-c7a6-384ff969a382
msgctxt "h5ae82f46gee2eg4fc6ga25cga681651204ba"
msgid "My sister - dead by Nere's hand. Meerna, I'm so sorry..."
msgstr "내 여동생이, 니어의 손에 죽다니. 미르나, 정말 미안해..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerLumpy
#. Speaker = Welso
#. NodeID = c2cf6865-5398-b782-9a2e-15420770b5d0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_DuergarGuards_Excavation_State_PermaDefeated = True
#.      - UND_DuergarCamp_State_CaveInCleared = False
#. SetFlags:
#.   Dialog:
#.     - UND_GnomeWorkerLumpy_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerLumpy:c2cf6865-5398-b782-9a2e-15420770b5d0
msgctxt "h15f13258g533ag490eg9a02geb4dd52edcc3"
msgid "Meerna! Meerna!"
msgstr "미르나! 미르나!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerLumpy
#. Speaker = Welso
#. NodeID = ca75e80f-800f-7f85-ee38-5ab2a57f04d9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_DuergarGuards_Excavation_State_PermaDefeated = False
#. SetFlags:
#.   Dialog:
#.     - UND_GnomeWorkerLumpy_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerLumpy:ca75e80f-800f-7f85-ee38-5ab2a57f04d9
msgctxt "h0599f47fg4399g4569gba21gd797f5a73d51"
msgid "My sister's in there! MEERNA! Meerna, can you hear me?"
msgstr "내 여동생이 저 안에 있어! <b>미르나!</b> 미르나! 들려?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerLumpy
#. Speaker = Welso
#. NodeID = de8459f7-a3ca-3df0-847b-ecb8a9e805ab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerLumpy:de8459f7-a3ca-3df0-847b-ecb8a9e805ab
msgctxt "hdd3c4f05ge1aag4a5dg8422gc826f5aac994"
msgid "My Meerna - Nere killed her. I should have done more..."
msgstr "미르나... 니어가 죽였어. 내가 더 했어야 했는데..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerLumpy
#. Speaker = Welso
#. NodeID = f0aa1a24-8b9a-e845-0e4c-bbd213965e85
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_DuergarCamp_State_CaveInCleared = True
#. SetFlags:
#.   Dialog:
#.     - UND_GnomeWorkerLumpy_HasMet(1) = True
#.     - UND_GnomeWorkerLumpy_Saved_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerLumpy:f0aa1a24-8b9a-e845-0e4c-bbd213965e85
msgctxt "h38809941g04edg4b44g9e5ag5b067a790167"
msgid "Please - do what you want. Just don't hurt my sister."
msgstr "부탁이에요. 하고 싶은 대로 해도 되는데, 여동생만 해치지 말아줘요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerLumpy
#. Speaker = Welso
#. NodeID = f1e25b97-65fd-b14a-51aa-e49bd763d6f5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_GnomeWorkerLumpy_Saved_HasMet(1) = True
#.   Global:
#.      - UND_DuergarCamp_State_CaveInCleared = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerLumpy:f1e25b97-65fd-b14a-51aa-e49bd763d6f5
msgctxt "h05440ba9g8ee1g4512ga68aga3ca1032b47f"
msgid "She's still back there. Meerna!"
msgstr "아직도 저 안에 있어요. 미르나!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerLumpy_Saved
#. Speaker = Welso
#. NodeID = 059f3435-dee0-846a-0d7f-8643f89e815d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_GnomeWorkerLumpy_Saved_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerLumpy_Saved:059f3435-dee0-846a-0d7f-8643f89e815d
msgctxt "hd5da0f87g6eceg4425g9413g274b59cab80e"
msgid ""
"You've done so much, I hate asking for more. But you see more slavers? Burn "
"them, skin them - make them <i>hurt.</i>"
msgstr ""
"너무 많은 걸 해주셨고, 더 부탁드리기는 싫지만... 노예상 놈들을 또 보게 되거든, 놈들을 태워버리고, 껍질을 벗기고, <i>아프게</"
"i> 해줘요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerLumpy_Saved
#. Speaker = Welso
#. NodeID = c01a4b5e-89c4-4b07-8673-61ac4077a32a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_GnomeWorkerLumpy_Saved_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - UND_GnomeWorkerLumpy_Saved_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerLumpy_Saved:c01a4b5e-89c4-4b07-8673-61ac4077a32a
msgctxt "ha6f8094cgd453g4e3bg9a87g2ffb0d0ececf"
msgid ""
"You saved my skin, but there's more bastards out there. For every one you "
"kill? Pint on me."
msgstr "당신이 저를 구해 주셨지만, 저 밖엔 개자식들이 더 많이 있죠. 한 놈 죽일 때마다 한 잔 살게요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerLumpy_Saved
#. Speaker = Welso
#. NodeID = c28704a6-7816-94be-85b9-36a542006135
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_InjuredGnome_State_SporeServant = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerLumpy_Saved:c28704a6-7816-94be-85b9-36a542006135
msgctxt "h36d1a93aga39fg405eg9e1eg412c9ed600be"
msgid "Whatever that thing is, it's not Thulla. She was the liveliest of us."
msgstr "저것이 뭔지는 모르겠지만, 툴라는 아닐 거야. 우리 중에 가장 활기찼다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerSilly
#. Speaker = Player
#. NodeID = 027f213d-a084-e063-0f07-928e0904d372
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_GnomeWorkerSilly_Event_ToldLunkbugHasPowderq = False
#.   Object:
#.      - HasTaggedItem_EXPLOSIVES(1) = True
#. SetFlags:
#.   Global:
#.     - UND_GnomeWorkerSilly_Event_ToldLunkbugHasPowderq = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerSilly:027f213d-a084-e063-0f07-928e0904d372
msgctxt "hdcf9c92dgcab9g4776ga791gad67863397d8"
msgid "I've got explosive powder. That should open the way."
msgstr "화약 가루를 가져왔지. 이거면 열릴 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerSilly
#. Speaker = Player
#. NodeID = 0abbf3f1-5d57-fdbc-78e1-8c0401116a39
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerSilly:0abbf3f1-5d57-fdbc-78e1-8c0401116a39
msgctxt "hcafda7ffgf86bg46c6g8b70g3316054c0bf7"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerSilly
#. Speaker = Lunkbug
#. NodeID = 112b9778-156b-bd68-5eec-c94126e37730
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_DuergarGuards_Excavation_State_PermaDefeated = True
#.      - UND_DuergarCamp_State_CaveInCleared = False
#. SetFlags:
#.   Dialog:
#.     - UND_GnomeWorkerSilly_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerSilly:112b9778-156b-bd68-5eec-c94126e37730
msgctxt "hd0f9bff4gae85g49dag91b0g0e0f5644cc4a"
msgid "There's more back there. Get them out, please!"
msgstr "저 뒤에 더 있어요. 부탁이에요, 꺼내줘요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerSilly
#. Speaker = Lunkbug
#. NodeID = 324ee4fa-1df7-c42c-843c-ec375cf2effb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerSilly:324ee4fa-1df7-c42c-843c-ec375cf2effb
msgctxt "h1df12f66g4c22g4780g926dgb9d94cd8920d"
msgid "... well. It's too late now. Thank you."
msgstr "... 글쎄. 이제 너무 늦은 것 같군. 참 고맙네요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerSilly
#. Speaker = Lunkbug
#. NodeID = 35b2c3d4-3f41-b341-b350-791da5e511f2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_GnomeWorkerSilly_Event_ToldLunkbugHasPowderq = True
#.   Object:
#.      - HasTaggedItem_EXPLOSIVES(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerSilly:35b2c3d4-3f41-b341-b350-791da5e511f2
msgctxt "hb6da6869g9319g457fg9e1cg2d5c7844aa56"
msgid "Place the powder and use fire to explode it!"
msgstr "화약을 놓고 불을 붙여서 터뜨려요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerSilly
#. Speaker = Lunkbug
#. NodeID = 38851c8d-8c80-2bff-dfd8-e639c8714357
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerSilly:38851c8d-8c80-2bff-dfd8-e639c8714357
msgctxt "h321d9a23g5d38g45f7gb2e6gabe11f667505"
msgid "Oh, thank the highest heavens. A touch of good news."
msgstr "오, 드높은 천상이시여, 감사합니다. 약간이나마 좋은 소식이군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerSilly
#. Speaker = Lunkbug
#. NodeID = 3be14c03-4de4-3e75-f8fc-49e0d7265b50
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_ArguingGnomes_Quest_Refused = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerSilly:3be14c03-4de4-3e75-f8fc-49e0d7265b50
msgctxt "h74320216g9608g4349gbd6fg7188d72f0670"
msgid "Please. We have to free Beldron."
msgstr "부탁이에요. 벨드론을 꺼내야 해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerSilly
#. Speaker = Lunkbug
#. NodeID = 3c2323e7-4a69-d38f-8337-490372100627
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_ArguingGnomes_State_Inconsolable = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerSilly:3c2323e7-4a69-d38f-8337-490372100627
msgctxt "hc43ea24egb79eg4716g84e4g936d525005f4"
msgid "Please, just... just let me dig."
msgstr "제발, 그냥... 그냥 좀 파게 해줘요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerSilly
#. Speaker = Lunkbug
#. NodeID = 5accb766-99b1-2612-5b53-692fd9df9759
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerSilly:5accb766-99b1-2612-5b53-692fd9df9759
msgctxt "hfe3880a3g6706g4159g9d51g291bace1cdeb"
msgid "Gods. We've lost too many."
msgstr "신들이시여. 너무 많은 사람을 잃었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerSilly
#. Speaker = Lunkbug
#. NodeID = 5eeaeb8c-e38f-6951-c291-1a104647886a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_ArguingGnomes_Quest_Accepted = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerSilly:5eeaeb8c-e38f-6951-c291-1a104647886a
msgctxt "h10173f66g6ef8g488bg9019g37b41e42e021"
msgid "Beldron's still back there. Find Philomeen - and hurry!"
msgstr "벨드론이 아직도 저 뒤에 갇혀 있어요. 필로민을 찾아요. 서둘러요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerSilly
#. Speaker = Lunkbug
#. NodeID = 6408c97b-3108-aeda-94c4-09905a33b1ba
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_GnomeForeman_State_PermaDefeated = True
#. SetFlags:
#.   Dialog:
#.     - UND_GnomeWorkerSilly_Event_ChidedPlayer(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerSilly:6408c97b-3108-aeda-94c4-09905a33b1ba
msgctxt "h70a41806gb78cg484fg9f30g4a3e3585e310"
msgid "Beldron - he's gone. And you stood there and <i>watched.</i>"
msgstr "벨드론이 죽었어. 당신은 그냥 거기 서서 <i>보고만</i> 있었지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerSilly
#. Speaker = Lunkbug
#. NodeID = 647b7edc-06b3-5c7c-1d29-9cd60cfd975e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerSilly:647b7edc-06b3-5c7c-1d29-9cd60cfd975e
msgctxt "hf2859522gd074g426dga1f9g617420709914"
msgid "But my Beldron is still trapped. Blow that wall open, I'm begging you."
msgstr "나의 벨드론이 아직도 갇혀 있어요. 저걸 터뜨려서 길을 열어 줘요. 제발, 부탁이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerSilly
#. Speaker = Lunkbug
#. NodeID = 7928bbad-9e75-b74d-ceff-8b55535ee779
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_GnomeWorkerSilly_HasMet(1) = True
#.   Global:
#.      - UND_DuergarGuards_Excavation_State_PermaDefeated = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerSilly:7928bbad-9e75-b74d-ceff-8b55535ee779
msgctxt "h887de673g3624g4309g8f6eg08cacf540020"
msgid "Can't talk!"
msgstr "말할 수 없어요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerSilly
#. Speaker = Player
#. NodeID = a9eb6ddd-4a79-a82b-b57f-051ddb4026c9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_ArguingGnomes_State_SaidEscapeeDead = False
#.      - UND_ArguingGnomes_State_SaidEscapeeSafe = False
#.      - UND_PanicRoom_State_GnomePermaDefeated = True
#. SetFlags:
