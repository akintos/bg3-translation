#. CheckFlags:
#.   Dialog:
#.      - FOR_GoblinAmbush_PatrollingGoblin_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - FOR_GoblinAmbush_PatrollingGoblin_HasMet(1) = True
#. TagRule: !LOLTHDROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_PatrollingGoblin:87da663b-0bbf-d0e7-d916-476c06a33f3e
msgctxt "hed271197gd5ecg4f44gaa43g311e59c43eb4"
msgid "If you wanna keep your insides on the inside, don't cause any trouble."
msgstr "내장을 보존하고 싶다면, 문제를 일으키지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_PatrollingGoblin
#. Speaker = Goblin Brawler
#. NodeID = 87da663b-0bbf-d0e7-d916-476c06a33f3e
