#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_DeadPrisoner_Dead:ebe176d1-3472-0763-3f4b-1e947e4d7711
msgctxt "hd01745a7g7316g4412gae7cg405f7697d3ec"
msgid "Do you know why any of us were taken?"
msgstr "왜 하필 우리가 납치된 건지 알고 있어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_DeadPrisoner_Dead
#. Speaker = Abducted Nobleman
#. NodeID = f94044e0-6556-998e-ad54-f2a9de89d595
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_DeadPrisoner_Dead:f94044e0-6556-998e-ad54-f2a9de89d595
msgctxt "h283e09adg7444g4ec3ga565g1522ebf52422"
msgid "Find healer..."
msgstr "치유사를 찾아..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_DeadPrisoner_Dead
#. Speaker = Player
#. NodeID = f9ce7fb9-ea5a-d1d8-1f1c-3775ec0f3e5d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_DeadPrisoner_Dead:f9ce7fb9-ea5a-d1d8-1f1c-3775ec0f3e5d
msgctxt "he76df9aegd0adg4277g9cc2g9585b7994b3a"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_DeadPrisoner_Dead
#. Speaker = Abducted Nobleman
#. NodeID = fd721a15-8a90-82a8-35ba-a740abc55fa1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_DeadPrisoner_Dead:fd721a15-8a90-82a8-35ba-a740abc55fa1
msgctxt "hbf4615b7g2308g4af3g9a3bg79a66567f183"
msgid "Francis... merchant... selling pottery..."
msgstr "프랜시스... 상인... 도자기를 팔아..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_AD_KilledMindflayer
#. Speaker = Player
#. NodeID = 537be2de-8202-0b40-6b61-0c279d794e7f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CRA_Escape_State_TriedHelpMindflayer(0) = False
#. TagRule: REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_AD_KilledMindflayer:537be2de-8202-0b40-6b61-0c279d794e7f
msgctxt "hf799fbc4g3497g4174g84fcg0e4b5a2495b9"
msgid "Ghaik. Death is too kind a fate."
msgstr "게이크 놈. 이놈에겐 죽음도 너무 자비로워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_AD_KilledMindflayer
#. Speaker = Player
#. NodeID = 537be2de-8202-0b40-6b61-0c279d794e7f
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CRA_Escape_State_TriedHelpMindflayer(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_AD_KilledMindflayer:537be2de-8202-0b40-6b61-0c279d794e7f
msgctxt "h50708eb3g065cg434dg9b35gdf70607f8185"
msgid "Monster. Death is too good for it."
msgstr "괴물 놈. 이놈에겐 죽음조차 과분하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_AD_KilledMindflayer
#. Speaker = Player
#. NodeID = a52073b7-a9ae-9039-2e58-621275ae54bc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CRA_Escape_State_TriedHelpMindflayer(0) = True
#. TagRule: REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_AD_KilledMindflayer:a52073b7-a9ae-9039-2e58-621275ae54bc
msgctxt "hcbe75d3bg281dg4c12g9343ga9467f72e3bb"
msgid "For the best. The <i>ghaik</i> earned its fate."
msgstr "이거면 됐어. <i>게이크</i> 놈에게 어울리는 최후지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_AD_KilledMindflayer
#. Speaker = Player
#. NodeID = a52073b7-a9ae-9039-2e58-621275ae54bc
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CRA_Escape_State_TriedHelpMindflayer(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_AD_KilledMindflayer:a52073b7-a9ae-9039-2e58-621275ae54bc
msgctxt "h1b3a09deg7c26g4129gbb5bgacb0e4dd744e"
msgid "For the best. Death is too good for it."
msgstr "이거면 됐어. 저놈에겐 죽음도 사치라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer
#. Speaker = Narrator
#. NodeID = 0545ed6c-a69d-f1f9-7d09-25a92e506e8a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer:0545ed6c-a69d-f1f9-7d09-25a92e506e8a
msgctxt "h28d23f6bgaea0g4162gbe55g484c94209684"
msgid ""
"*You feel the creature's thoughts stumble against your magic, your will to "
"resist...*"
msgstr "*괴물의 사고력이 당신의 마법과 저항 의지에 부딪혀 휘청거리는 것이 느껴집니다...*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer
#. Speaker = Narrator
#. NodeID = 06d1d446-26bf-f501-ba23-88300b2f8207
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer:06d1d446-26bf-f501-ba23-88300b2f8207
msgctxt "hd841126ag6e3dg4977g90c3g97805d542110"
msgid "*You can't move, can't think: thinking is mercifully done for you.*"
msgstr "*움직일 수도, 생각할 수도 없습니다. 자비롭게도 누군가 생각을 대신 해주는군요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer
#. Speaker = Player
#. NodeID = 098e9537-4515-9430-8ce6-f8f717cd587e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer:098e9537-4515-9430-8ce6-f8f717cd587e
msgctxt "h0f957248g03efg475fg8f4bgaec40da46290"
msgid "<i>This isn't right. Step away.</i>"
msgstr "<i>뭔가 잘못됐다. 뒤로 물러선다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer
#. Speaker = Player
#. NodeID = 0ac549a2-e5da-ce40-ce57-6c625ddc302a
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Intelligence
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer:0ac549a2-e5da-ce40-ce57-6c625ddc302a
msgctxt "h8ad69bdcg3fdag41ebg8f13g4890404d9c38"
msgid "<i>Concentrate on its thoughts.</i>"
msgstr "<i>놈의 생각에 집중한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer
#. Speaker = Player
#. NodeID = 0fdd0b02-5af9-95d4-a066-c0fd33c302f9
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 5
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer:0fdd0b02-5af9-95d4-a066-c0fd33c302f9
msgctxt "h91d00582g307cg4e58g9dcbge091933e0096"
msgid "<i>Resist the intrusion with everything you have.</i>"
msgstr "<i>전력을 다해 놈의 침입에 저항한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer
#. Speaker = Narrator
#. NodeID = 1586b1fb-f01a-4e80-f739-341cb09f3d61
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRA_Escape_MindflayerDialogDone = False
#.   Tag:
#.      - REALLY_GITHYANKI(1) = False
#. SetFlags:
#.   Global:
#.     - CRA_Escape_MindflayerDialogDone = True
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer:1586b1fb-f01a-4e80-f739-341cb09f3d61
msgctxt "h2fe37957gf3b9g4962gbd2agb7e751b74983"
msgid "*You approach the dying monster. This is the thing that abducted you.*"
msgstr "*당신은 죽어가는 괴물에게 다가갑니다. 당신을 납치했던 그 괴물이군요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer
#. Speaker = Narrator
#. NodeID = 1b4e1d6e-7e92-d4c8-bffe-e872ed768e5a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer:1b4e1d6e-7e92-d4c8-bffe-e872ed768e5a
msgctxt "h014dc0c7g04dfg418agb37dg5df775aa9a51"
msgid ""
"*Its mind grips your own like a vice. You feel it locking you into "
"obedience.*"
msgstr "*놈의 정신이 당신의 정신을 족쇄처럼 사로잡습니다. 놈이 당신을 복종시키는 게 느껴집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer
#. Speaker = Player
#. NodeID = 1fd6ee8b-94c6-af0d-5544-fa0cd09a0164
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 97bc1e94-b164-834f-9c0e-95a7c94cf7e6_CompanionInterjected = True
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer:1fd6ee8b-94c6-af0d-5544-fa0cd09a0164
msgctxt "h14ed43fbgd3cfg40e8g95bag04ea92d62103"
msgid "<i>No. It's fine. Everything will be fine...</i>"
msgstr "<i>아니. 괜찮을 거야. 전부 다 괜찮아질 거라고...</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer
#. Speaker = Narrator
#. NodeID = 23cf70e8-9b40-0851-ac26-0a873d0476ca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer:23cf70e8-9b40-0851-ac26-0a873d0476ca
msgctxt "hf52249deg16c7g46efgb972g2b3ffd9775a9"
msgid ""
"*But then the feeling slips. The creature's mind seems to focus elsewhere.*"
msgstr "*하지만 그 감정은 스르르 사라집니다. 이 괴물은 다른 일에 정신을 집중하는 것 같습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer
#. Speaker = Player
#. NodeID = 2540412d-1251-6bdb-7a42-10fbd6461423
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer:2540412d-1251-6bdb-7a42-10fbd6461423
msgctxt "h96e76f25g96e3g4489g9cf5ga782f04536bb"
msgid "<i>Give in to the emotion.</i>"
msgstr "<i>감정에 굴복한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer
#. Speaker = Player
#. NodeID = 3cf26d0c-b71c-fd74-7405-fb830d352326
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer:3cf26d0c-b71c-fd74-7405-fb830d352326
msgctxt "h3852f5cfg3e05g4744g837fg3c1b06762eb6"
msgid "<i>No. You should be furious... shouldn't you? </i>"
msgstr "<i>아니. 오히려 화가 치밀어야 한다... 그게 맞지 않나?</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer
#. Speaker = Narrator
#. NodeID = 40f92b63-ecc0-485e-2734-b1002a1fc5f2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer:40f92b63-ecc0-485e-2734-b1002a1fc5f2
msgctxt "h58a5ff83gb52cg4cfag831fg103e8d744ddb"
msgid "*It will be a joy to serve - to die for it an honour!*"
msgstr "*저것을 받드는 건 즐거울 테죠. 저것을 위해 죽는 건 영예입니다!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer
#. Speaker = Narrator
#. NodeID = 4824bf83-8ed2-211f-59f4-001407ed0edc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRA_Escape_Event_GiveInToMindflayer = True
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer:4824bf83-8ed2-211f-59f4-001407ed0edc
msgctxt "he4631ab1g1b87g4b2dgb806g2b0555dce7a4"
msgid "*... you're perfectly happy.*"
msgstr "*... 더없이 행복해집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer
#. Speaker = Karlach
#. NodeID = 53461b83-77e6-455c-a7fc-dd9242bff4f0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_KARLACH(4) = True
#. SetFlags:
#.   Local:
#.     - 97bc1e94-b164-834f-9c0e-95a7c94cf7e6_CompanionInterjected = True
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer:53461b83-77e6-455c-a7fc-dd9242bff4f0
msgctxt "h23b93d37gf3c9g4837g923fg9e092f187c79"
msgid "Whoa - what  in the hells are you doing?!"
msgstr "야! 지금 대체 뭘 하고 있는 거야?!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer
#. Speaker = Player
#. NodeID = 5a1a6811-69ad-ba6b-3037-1e58d9fddb14
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 5
#. CheckFlags:
#.   Local:
#.      - 97bc1e94-b164-834f-9c0e-95a7c94cf7e6_CompanionInterjected = True
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer:5a1a6811-69ad-ba6b-3037-1e58d9fddb14
msgctxt "h14d02262gc7bdg4fc7gb70eg6df6e2b1e126"
msgid "<i>Change your mind. Resist, if you still can.</i>"
msgstr "<i>생각을 바꾼다. 가능하다면, 저항한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer
#. Speaker = Lae'zel
#. NodeID = 5fe61705-772c-4037-a43e-7b0b9acc49fa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(2) = True
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
#. SetFlags:
#.   Local:
#.     - 97bc1e94-b164-834f-9c0e-95a7c94cf7e6_CompanionInterjected = True
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer:5fe61705-772c-4037-a43e-7b0b9acc49fa
msgctxt "h5b95cb8dg2a6eg445ag8850g470fffc473f4"
msgid "<i>K'chakhi </i>- back. You must resist its call!"
msgstr "<i>크차키</i>. 물러서. 놈의 유혹에 저항해라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer
#. Speaker = Narrator
#. NodeID = 63f024d0-49a7-8369-c9cc-a9854ae15ebe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer:63f024d0-49a7-8369-c9cc-a9854ae15ebe
msgctxt "h5864f020g9becg446aga664gf61ed915d2da"
msgid "*You'd give your life to save it, to nurse it back to health!*"
msgstr "*당신은 목숨을 바쳐서라도 이것이 기력을 되찾도록 돌볼 겁니다!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer
#. Speaker = Wyll
#. NodeID = 665a70a2-1db7-478d-9aae-20d0e1db3846
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_WYLL(6) = True
#. SetFlags:
#.   Local:
#.     - 97bc1e94-b164-834f-9c0e-95a7c94cf7e6_CompanionInterjected = True
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer:665a70a2-1db7-478d-9aae-20d0e1db3846
msgctxt "h6afc46c1g5923g4f25ga535ga56d16c01168"
msgid "What are you... no, no! You have to fight it!"
msgstr "너 뭐 하는... 안 돼, 안 돼! 유혹에 맞서 싸워!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer
#. Speaker = Narrator
#. NodeID = 6ecbba93-6a5a-dda8-ed20-276c6eb64e20
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRA_Escape_MindflayerDialogDone = True
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer:6ecbba93-6a5a-dda8-ed20-276c6eb64e20
msgctxt "h7c5d68e6g801dg45e2g80b3g40fde23e949d"
msgid "*The monster's tentacles twitch weakly. It won't last much longer.*"
msgstr "*괴물의 촉수가 나약하게 경련합니다. 그리 오래 버티지 못할 겁니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer
#. Speaker = Narrator
#. NodeID = 6f208c0f-d832-cd64-3c95-1f085159d307
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer:6f208c0f-d832-cd64-3c95-1f085159d307
msgctxt "hdd98410ag5c87g4788ga9dag5c60c0f93c6f"
msgid "*Compassion?*"
msgstr "*연민이라니?*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer
#. Speaker = Narrator
#. NodeID = 737e003e-d138-5ff5-4730-fc7a0a03fda3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer:737e003e-d138-5ff5-4730-fc7a0a03fda3
msgctxt "h0cc630ffgefd3g48bfg831ag604eaed8cc1f"
msgid "*Compassion.*"
msgstr "*연민 말이죠.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer
#. Speaker = Player
#. NodeID = 74664dd8-be63-9d8e-bcfd-3169c54d0c8a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer:74664dd8-be63-9d8e-bcfd-3169c54d0c8a
msgctxt "h50fe256dg6a6eg455ag9fa8g1237aa40fccb"
msgid "<i>Submit to the feeling - lean in, as for a kiss...</i>"
msgstr "<i>감정에 굴복한다. 키스하기 위해 몸을 기울인다...</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer
#. Speaker = Narrator
#. NodeID = 7616a498-30f2-c7c2-0657-34d77c1df676
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer:7616a498-30f2-c7c2-0657-34d77c1df676
msgctxt "h99e3dd95g6963g41d7g8feeg8d63ef3570cd"
msgid "*Yes, you feel hate. And you deserve to be punished for it.*"
msgstr "*네, 당신은 증오를 느낍니다. 그리고 그 대가로 처벌받아야 마땅하죠.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer
#. Speaker = Narrator
#. NodeID = 77546237-b24d-c414-cec3-2fbf4cf03003
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer:77546237-b24d-c414-cec3-2fbf4cf03003
msgctxt "h89aa5046gc9b8g4fc1g9adcgc83bb77e99a8"
msgid ""
"*Your willpower is not enough. The creature's mind slaps away your efforts "
"to resist it.*"
msgstr "*당신의 의지력으론 역부족입니다. 괴물의 정신이 당신의 저항하려는 노력을 휘날려버리는군요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer
#. Speaker = Player
#. NodeID = 964408f7-29a8-b089-9045-da239a5bdb04
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer:964408f7-29a8-b089-9045-da239a5bdb04
msgctxt "he3df5144g8ee4g4974g8716g368d30cd055d"
msgid "<i>Leave it to die - slowly.</i>"
msgstr "<i>천천히 죽어가도록 내버려둔다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer
#. Speaker = Narrator
#. NodeID = 9764aed3-ca2c-c567-28de-0ac117bc8c45
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer:9764aed3-ca2c-c567-28de-0ac117bc8c45
msgctxt "hc86655f7gb142g4b15g8338g3de9e5613931"
msgid ""
"*It needs sustenance to survive, and with your very body you can provide.*"
msgstr "*놈은 살아남기 위해 양분이 필요하고, 당신의 몸뚱이는 이를 제공할 수 있죠.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer
#. Speaker = Narrator
#. NodeID = 9c93e9af-f63c-4a8c-e1d8-0a13cb5402ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer:9c93e9af-f63c-4a8c-e1d8-0a13cb5402ea
msgctxt "h1f2d69e8g19c7g40c0gbb19g9e0e31632c83"
msgid "*You could end its life here and now, if only you didn't feel...*"
msgstr "*당장에라도 숨통을 끊을 수 있습니다. 이 감정만 들지 않았더라면요...*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer
#. Speaker = Narrator
#. NodeID = a20232a5-1e99-f5c2-0d52-7f3a1cd0355e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer:a20232a5-1e99-f5c2-0d52-7f3a1cd0355e
msgctxt "h7b2d778eg4947g4c9cg895dgbd4e6d394e2e"
msgid ""
"*Warm, wet tentacles wrap themselves around your head, and for the first "
"time in your life...*"
msgstr "*따뜻하고 축축한 촉수들이 머리를 감싸자, 당신은 태어나서 처음으로...*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer
#. Speaker = Narrator
#. NodeID = a5e84342-51c6-15d1-cf1d-a42de6efdcd4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer:a5e84342-51c6-15d1-cf1d-a42de6efdcd4
msgctxt "hebb0a911gbac4g4575g90bdgdcca3cf11bdc"
msgid "*You should be whipped - made to bow before this creature in shame!*"
msgstr "*당신은 채찍을 맞아야 합니다. 수치에 휩싸여 이 생명체 앞에 절을 해야 합니다!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer
#. Speaker = Narrator
#. NodeID = ae4eb550-8a36-8bef-6a6b-3f3e87934870
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer:ae4eb550-8a36-8bef-6a6b-3f3e87934870
msgctxt "h7757acdbgdb2dg447bgb353g768bba5adde8"
msgid ""
"*But then its grip claws back with a vengeance: a vice locking your mind "
"into obedience.*"
msgstr "*하지만 이후 저 괴물의 마수가 복수심과 함께 되돌아옵니다. 당신의 정신을 복종으로 잠그려는 족쇄와도 같이요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer
#. Speaker = Narrator
#. NodeID = b371cbbb-075c-a484-d7cb-6e9bfcfc9e15
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer:b371cbbb-075c-a484-d7cb-6e9bfcfc9e15
msgctxt "h12221f87gb640g4ba7g9637gda2a8b5cf4a5"
msgid ""
"*You try to break through, but its mind is impenetrable. With a last surge "
"of defiance, it slaps your efforts away.*"
msgstr "*당신은 침투를 시도하지만, 놈의 정신을 뚫을 수가 없습니다. 마지막 반항의 물결에 당신의 노력이 물거품이 되어버립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer
#. Speaker = Narrator
#. NodeID = bcd0da3a-1f05-f6bb-8e3d-ea3f7ad45fb5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer:bcd0da3a-1f05-f6bb-8e3d-ea3f7ad45fb5
msgctxt "h2fbaa860gdf46g4790g8e9cg9d7bd24cb8f3"
msgid "*Your minds fuse, lusting for something that is... gone.*"
msgstr "*당신의 정신이 융합되더니, 사라진 무언가에 대한 갈망이... 느껴집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer
#. Speaker = Shadowheart
#. NodeID = bde92606-d069-49f6-ac40-1bee2a69b083
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#. SetFlags:
#.   Local:
#.     - 97bc1e94-b164-834f-9c0e-95a7c94cf7e6_CompanionInterjected = True
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer:bde92606-d069-49f6-ac40-1bee2a69b083
msgctxt "hfad06a8fg0940g4108ga880ge86585da8106"
msgid "Get away from that thing!"
msgstr "그놈에게서 떨어져!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer
#. Speaker = Player
#. NodeID = c5c340ba-67e1-a680-4f0e-a307c376d3f3
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - SORCERER(1) = True
#. TagRule: SORCERER_DRACONIC
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer:c5c340ba-67e1-a680-4f0e-a307c376d3f3
msgctxt "h53b839d9g9aeeg4416g9841g848da16e050a"
msgid ""
"<i>You host the blood of a mighty dragon. Channel its will to resist the "
"abomination.</i>"
msgstr "<i>당신에겐 강대한 용의 피가 흐르고 있다. 저 흉물에게 저항의 의지를 표출한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer
#. Speaker = Player
#. NodeID = c5c340ba-67e1-a680-4f0e-a307c376d3f3
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: RawAbility
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - SORCERER(1) = True
#. TagRule: SORCERER_WILDMAGIC
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer:c5c340ba-67e1-a680-4f0e-a307c376d3f3
msgctxt "h7d955a52g7bd8g4089g9149ga17f1b641c67"
msgid ""
"<i>Steel your will and allow your untamed magic to unbalance the creature's "
"mind.</i>"
msgstr "<i>의지를 가다듬고 당신의 통제되지 않는 마력으로 이 괴물의 정신을 흐트려놓는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer
#. Speaker = Player
#. NodeID = c5c340ba-67e1-a680-4f0e-a307c376d3f3
#. HandlePath = TaggedText[2].TagText[0]
#. RollType: RawAbility
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - SORCERER(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer:c5c340ba-67e1-a680-4f0e-a307c376d3f3
msgctxt "h6422c417g6dc7g47a6g9d2bg555f0f87f53d"
msgid ""
"<i>Draw on your willpower. Improvise a mental shield against the creature's "
"hungry mind.</i>"
msgstr "<i>의지력을 끌어모아 저 괴물의 굶주린 정신을 막아줄 정신 보호막을 즉석에서 생성해낸다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer
#. Speaker = Gale
#. NodeID = ca22dd83-8fe0-4c90-a962-f4cc53adb5f1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_GALE(7) = True
#. SetFlags:
#.   Local:
#.     - 97bc1e94-b164-834f-9c0e-95a7c94cf7e6_CompanionInterjected = True
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer:ca22dd83-8fe0-4c90-a962-f4cc53adb5f1
msgctxt "h35abb725ga3b7g41b6gae65gb80f97ab4f21"
msgid "What are you doing? Stand back! Now!"
msgstr "뭐하고 있는 거야? 물러서! 당장!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer
#. Speaker = Player
#. NodeID = e39df6e0-67a7-d607-3e16-75de868dc7e9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CRA_Escape_Event_KillMindflayer(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer:e39df6e0-67a7-d607-3e16-75de868dc7e9
msgctxt "h594ffcabg7179g4990gaf74g32646cc33e58"
msgid "<i>Close those eyes forever.</i>"
msgstr "<i>그 두 눈을 영원히 감겨버린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer
#. Speaker = Astarion
#. NodeID = e9401225-dca0-4c13-837e-2660c8160960
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#. SetFlags:
#.   Local:
#.     - 97bc1e94-b164-834f-9c0e-95a7c94cf7e6_CompanionInterjected = True
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer:e9401225-dca0-4c13-837e-2660c8160960
msgctxt "h03e5c068gc9e3g4a73ga265g40a4c34e987a"
msgid "What in the hells - get away from that thing!"
msgstr "아니 이게 무슨, 그 괴물한테서 떨어져!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer
#. Speaker = Narrator
#. NodeID = ed08046a-86c8-e5af-07b1-59b55999a3f7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRA_Escape_MindflayerDialogDone = False
#.   Tag:
#.      - REALLY_GITHYANKI(1) = True
#. SetFlags:
#.   Global:
#.     - CRA_Escape_MindflayerDialogDone = True
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer:ed08046a-86c8-e5af-07b1-59b55999a3f7
msgctxt "h712f007dg1549g4506g9669gf1b1d3d80e95"
msgid ""
"*You approach the dying <i>ghaik</i>. The foul thing is at your mercy, and "
"you would have its head.*"
msgstr ""
"*당신은 죽어가는 <i>게이크</i>에게 다가갑니다. 이 비열한 괴물의 목숨은 당신에게 달렸고, 얼마든지 놈의 머리를 취할 수 있죠.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer
#. Speaker = Player
#. NodeID = f1813ea1-e7c4-149c-a1cf-869dc59c1d4d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer:f1813ea1-e7c4-149c-a1cf-869dc59c1d4d
msgctxt "hdfbe3adbg7b1bg440cg8ff8ga7b67bac0a94"
msgid "<i>Take advantage of the lapse - break free.</i>"
msgstr "<i>오판을 기회로 삼는다. 놈의 힘을 떨쳐낸다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer
#. Speaker = Narrator
#. NodeID = f474ec07-340e-d798-f6da-7e42ded74415
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer:f474ec07-340e-d798-f6da-7e42ded74415
msgctxt "hf54938dcg4182g47fag9e3dg2b459ce31312"
msgid "*It's possessing your mind, forcing you to... love it.*"
msgstr "*놈이 당신의 마음을 사로잡아 자신을 사랑하게... 만듭니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer
#. Speaker = Narrator
#. NodeID = fe8c651f-8da5-0daf-5b87-09f9c2aa5d88
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer:fe8c651f-8da5-0daf-5b87-09f9c2aa5d88
msgctxt "h34784811g6b60g4c83gbdbeg500dcf6c2a67"
msgid "*The poor creature is on the brink of death, but there's still time.*"
msgstr "*이 불쌍한 생명체는 죽기 일보 직전이지만 아직 시간이 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer
#. Speaker = Narrator
#. NodeID = fe960f4e-e53e-0b79-487f-9c4f8c3323b8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_Mindflayer:fe960f4e-e53e-0b79-487f-9c4f8c3323b8
msgctxt "hf6d4ca6dg7cceg4e6eg8884g06de0451c961"
msgid ""
"*The monster lies exhausted, defeated. Its eyes - wet, orange pearls - "
"radiate malice.*"
msgstr "*괴물은 기력을 다한 채 쓰러져 있습니다. 축축한 주황색 진주 같은 눈이 악의를 내비칩니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_PAD_FirstIntellectDevourerCombat
#. Speaker = Player
#. NodeID = 51931f41-1d95-2a43-be16-f0e017388d65
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_PAD_FirstIntellectDevourerCombat:51931f41-1d95-2a43-be16-f0e017388d65
msgctxt "hfea74414g0c8eg4878g9e6agda0fefb5ca69"
msgid "Wicked little beasts - they'll down you in one strike."
msgstr "망할 괴물 새끼들 같으니. 한 방 제대로 맞았다간 당하고 말겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_PAD_FirstIntellectDevourerCombat
#. Speaker = Player
#. NodeID = 51931f41-1d95-2a43-be16-f0e017388d65
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_PAD_FirstIntellectDevourerCombat:51931f41-1d95-2a43-be16-f0e017388d65
msgctxt "ha9e0e526g017fg4f36g9297gd7ba5169d893"
msgid "Intellect devourers. A thinking man's worst nightmare."
msgstr "지성 포식자군. 지성인의 가장 끔찍한 악몽이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_PAD_FirstIntellectDevourerCombat
#. Speaker = Player
#. NodeID = 51931f41-1d95-2a43-be16-f0e017388d65
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_PAD_FirstIntellectDevourerCombat:51931f41-1d95-2a43-be16-f0e017388d65
msgctxt "h3690fb58ga531g44deg8592g94ad98c6ec68"
msgid "Can't let these things escape the wreckage."
msgstr "저것들이 이 난파선을 빠져나가게 둘 순 없지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_PAD_FirstIntellectDevourerCombat
#. Speaker = Player
#. NodeID = 51931f41-1d95-2a43-be16-f0e017388d65
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_PAD_FirstIntellectDevourerCombat:51931f41-1d95-2a43-be16-f0e017388d65
msgctxt "h7efc7c27g66e1g4399g8ab4g958b02bf6539"
msgid "<i>Ghaik</i> devourers. One strike could prove lethal."
msgstr "<i>게이크</i> 포식자군. 한 방이라도 공격받으면 치명적이겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_PAD_FirstIntellectDevourerCombat
#. Speaker = Player
#. NodeID = 51931f41-1d95-2a43-be16-f0e017388d65
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_PAD_FirstIntellectDevourerCombat:51931f41-1d95-2a43-be16-f0e017388d65
msgctxt "hddf03ef1g703cg4b26gbe8ag2b9aab4862b1"
msgid "Vicious filth. Best keep some distance, or this'll be a short fight..."
msgstr "사악한 버러지들. 거리를 두지 않으면 금방 당해버리고 말 거야..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_PAD_FirstIntellectDevourerCombat
#. Speaker = Player
#. NodeID = 51931f41-1d95-2a43-be16-f0e017388d65
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_PAD_FirstIntellectDevourerCombat:51931f41-1d95-2a43-be16-f0e017388d65
msgctxt "h3b41b086g4a62g456bga5f6gf9a0116d5726"
msgid "Those tentacles look nasty. One hit, and it's over."
msgstr "촉수가 위협적이게 생겼는걸. 한 방 맞으면, 그냥 끝장나겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_PAD_FirstIntellectDevourerCombat
#. Speaker = Player
#. NodeID = 51931f41-1d95-2a43-be16-f0e017388d65
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_PAD_FirstIntellectDevourerCombat:51931f41-1d95-2a43-be16-f0e017388d65
msgctxt "hcb528f0cg62fcg47bdg9d91g0a5c2b161859"
msgid "Better stay back. One strike could be lethal."
msgstr "거리를 두는 게 좋겠어. 한 방만 맞아도 치명적일 수 있으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_PAD_SeeWoundedDevourers
#. Speaker = Player
#. NodeID = 4f55ed46-bee9-4d7f-9c7a-fa13ec1c6638
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_PAD_SeeWoundedDevourers:4f55ed46-bee9-4d7f-9c7a-fa13ec1c6638
msgctxt "h2445f915gbfdeg492egbc15g98cd771e7364"
msgid "More of those wretched things."
msgstr "그 불쾌한 괴물들이 저기 더 있군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_PAD_SeeWoundedDevourers
#. Speaker = Player
#. NodeID = f05f5d64-20d5-4cd5-9e4d-dea4055b2bd3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_PAD_SeeWoundedDevourers:f05f5d64-20d5-4cd5-9e4d-dea4055b2bd3
msgctxt "ha561b21agf591g41b5gb83cg4374a441c6cd"
msgid "More of the mind flayers' pets."
msgstr "마인드 플레이어의 애완동물이 저기 더 있군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_VB_OtherSurvivors
#. Speaker = Player
#. NodeID = 59e8fa9c-9ce8-95a1-c120-346f7fc36096
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_VB_OtherSurvivors:59e8fa9c-9ce8-95a1-c120-346f7fc36096
msgctxt "hd80731d6g6371g4b9dga3f6g83ada397c9cd"
msgid "Footprints. There may be even more that survived the crash."
msgstr "발자국이군. 추락에서 살아남은 사람이 더 있을지도 모르겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_VB_SawMindflayer
#. Speaker = Player
#. NodeID = 4c2286e1-f95a-5ae8-38d0-27655342335a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_VB_SawMindflayer:4c2286e1-f95a-5ae8-38d0-27655342335a
msgctxt "ha2dbf183gef98g4db5g9393g3f26c4d8b438"
msgid "There! A mind flayer - and it's <i>hurt</i>."
msgstr "저기! 마인드 플레이어다. <i>다쳤나</i> 본데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_VB_SawMindflayer
#. Speaker = Player
#. NodeID = d8cb59c5-a745-7052-5da0-5700a6ceeea9
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_VB_SawMindflayer:d8cb59c5-a745-7052-5da0-5700a6ceeea9
msgctxt "h25efebd5g34c2g4fa3g8bcfg8375d417d1f4"
msgid "That thing's bound to be dangerous, even if injured. Best be careful."
msgstr "부상을 당했어도 위험한 놈이란 건 변함없지. 조심하는 게 좋겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_VB_SawMindflayer
#. Speaker = Player
#. NodeID = d8cb59c5-a745-7052-5da0-5700a6ceeea9
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_VB_SawMindflayer:d8cb59c5-a745-7052-5da0-5700a6ceeea9
msgctxt "h72cfa726g1139g4ed9gafbfg53fcf6f82431"
msgid ""
"Even an injured <i>ghaik</i> is a dangerous one. Do not let your guard down."
msgstr "부상당했다 해도 <i>게이크</i>는 위험한 존재다. 방심하지 마라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_VB_SawMindflayer
#. Speaker = Player
#. NodeID = d8cb59c5-a745-7052-5da0-5700a6ceeea9
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_VB_SawMindflayer:d8cb59c5-a745-7052-5da0-5700a6ceeea9
msgctxt "hbf4e905fg8274g406ag9c70g5cc536a3c744"
msgid "Injured - but still dangerous. Be careful."
msgstr "부상당했대도 위험한 건 여전해. 조심하자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_VB_SawMindflayer
#. Speaker = Player
#. NodeID = d8cb59c5-a745-7052-5da0-5700a6ceeea9
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_VB_SawMindflayer:d8cb59c5-a745-7052-5da0-5700a6ceeea9
msgctxt "hf8ba9c6fgf61ag43bdgace0gba5c9457cb3a"
msgid "Give it a wide berth. It could still do a lot of damage."
msgstr "거리 충분히 둬. 여전히 큰 피해를 끼칠 수 있는 놈이라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_VB_SawMindflayer
#. Speaker = Player
#. NodeID = d8cb59c5-a745-7052-5da0-5700a6ceeea9
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_VB_SawMindflayer:d8cb59c5-a745-7052-5da0-5700a6ceeea9
msgctxt "ha2a3f151g3043g4906ga3b5g84c3ecd0e21c"
msgid "I'd rather it be hurt than me. <i>Do</i> be careful."
msgstr "나보다 더 아픈 상태라면 좋겠네. <i>부디</i> 조심하자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_VB_SawMindflayer
#. Speaker = Player
#. NodeID = d8cb59c5-a745-7052-5da0-5700a6ceeea9
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_VB_SawMindflayer:d8cb59c5-a745-7052-5da0-5700a6ceeea9
msgctxt "h62064591gfc21g4111gaa64ga6360bc4885c"
msgid ""
"Approach with extreme caution. An injured mind flayer is still a dangerous "
"one."
msgstr "아주 조심히 접근하자. 부상당했어도 마인드 플레이어는 여전히 위험한 존재라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_VB_SawMindflayer
#. Speaker = Player
#. NodeID = d8cb59c5-a745-7052-5da0-5700a6ceeea9
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: PLANAR and !REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_VB_SawMindflayer:d8cb59c5-a745-7052-5da0-5700a6ceeea9
msgctxt "h5dfaf2bdg2054g4b41g9cc6gc17e3afbf2f2"
msgid "Do not let your guard down - one misstep, and we're dead."
msgstr "방심하지 말자고. 까딱 잘못하면 우리 모두 죽은 목숨이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_VB_SawMindflayer
#. Speaker = Player
#. NodeID = d8cb59c5-a745-7052-5da0-5700a6ceeea9
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_VB_SawMindflayer:d8cb59c5-a745-7052-5da0-5700a6ceeea9
msgctxt "h8d4e7f70ga38cg45d3gae1fgb94384063052"
msgid "Even injured, a <i>ghaik</i> can kill. Proceed with caution."
msgstr "부상당한 놈이라도, <i>게이크</i>는 위험하지. 조심히 접근하자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_VB_SawMindflayer
#. Speaker = Player
#. NodeID = d8cb59c5-a745-7052-5da0-5700a6ceeea9
#. HandlePath = TaggedText[8].TagText[0]
#. TagRule: REALLY_DUERGARDWARF
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_VB_SawMindflayer:d8cb59c5-a745-7052-5da0-5700a6ceeea9
msgctxt "habfd28cfge457g43c5g85e0g5d08ba9ec742"
msgid ""
"Hurt, but still kicking - I can feel it scrabbling from here. Watch yourself."
msgstr "다쳤지만, 아직 팔팔하군. 저놈 안간힘 쓰는 게 멀리서도 느껴져. 조심하자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_VB_SawMindflayer
#. Speaker = Player
#. NodeID = d8cb59c5-a745-7052-5da0-5700a6ceeea9
#. HandlePath = TaggedText[9].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_Escape_VB_SawMindflayer:d8cb59c5-a745-7052-5da0-5700a6ceeea9
msgctxt "had7ec50agad0cg4feagb481g72a0dc9f378f"
msgid "Even injured, it's dangerous. Be careful."
msgstr "부상당했어도 위험한 놈이지. 조심하자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Crash/CRA_GaleRecruitment_PAD_Approach
#. Speaker = Player
#. NodeID = 2e64b9d0-e207-410a-b81c-68a87be30a18
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act1/Crash/CRA_GaleRecruitment_PAD_Approach:2e64b9d0-e207-410a-b81c-68a87be30a18
msgctxt "h0c1b26f2g972ag435fg9376g9818bb12a48f"
msgid "Is that sigil all right? It doesn't look all right."
msgstr "저 룬 괜찮은 건가? 안 그래 보이는데 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Crash/CRA_GaleRecruitment_PAD_Approach
#. Speaker = Player
#. NodeID = 2e64b9d0-e207-410a-b81c-68a87be30a18
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act1/Crash/CRA_GaleRecruitment_PAD_Approach:2e64b9d0-e207-410a-b81c-68a87be30a18
msgctxt "hf603c3a5g7ba1g4ad5gb8d2g03f9c35e3fc6"
msgid "That rune looks - unsteady. Something's wrong."
msgstr "저 룬은 불안정해 보이는군. 뭔가 잘못됐어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Crash/CRA_GaleRecruitment_PAD_Approach
#. Speaker = Player
#. NodeID = 2e64b9d0-e207-410a-b81c-68a87be30a18
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act1/Crash/CRA_GaleRecruitment_PAD_Approach:2e64b9d0-e207-410a-b81c-68a87be30a18
msgctxt "hf8962d88gf1cag420bga608gff4a9f13dcc9"
msgid "Something's amiss with that rune. Seems unstable."
msgstr "저 룬, 뭔가 잘못된 거 같아. 불안정해 보여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Crash/CRA_GaleRecruitment_PAD_Approach
#. Speaker = Player
#. NodeID = 2e64b9d0-e207-410a-b81c-68a87be30a18
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act1/Crash/CRA_GaleRecruitment_PAD_Approach:2e64b9d0-e207-410a-b81c-68a87be30a18
msgctxt "h7bd97985gc31fg4a6eg9c19g821d07e0b239"
msgid "Look there, on the wall. Something's not right with that sigil."
msgstr "저기, 저 벽 좀 봐. 저 문양 어째 좀 이상해 보이는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Crash/CRA_GaleRecruitment_PAD_Approach
#. Speaker = Player
#. NodeID = 2e64b9d0-e207-410a-b81c-68a87be30a18
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act1/Crash/CRA_GaleRecruitment_PAD_Approach:2e64b9d0-e207-410a-b81c-68a87be30a18
msgctxt "h8ee69eefgae34g4884g8d4eg9424137e71b6"
msgid "Huh. What's <i>that</i>?"
msgstr "허. <i>저건</i> 뭐지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Crash/CRA_GaleRecruitment_PAD_Approach
#. Speaker = Player
#. NodeID = 2e64b9d0-e207-410a-b81c-68a87be30a18
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: !REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act1/Crash/CRA_GaleRecruitment_PAD_Approach:2e64b9d0-e207-410a-b81c-68a87be30a18
msgctxt "hd93add47g264fg4476g8c34ge024a5db5949"
msgid "What's going on with that rune? Looks unstable somehow."
msgstr "저 룬, 상태가 왜 저렇지? 왠지 불안정해 보이는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_FightingFishers
#. Speaker = Player
#. NodeID = 5f68a2a2-1f5c-642a-72a0-db54bf0d9bee
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_FightingFishers:5f68a2a2-1f5c-642a-72a0-db54bf0d9bee
msgctxt "h24b468e3g38e0g456ag9383g1797829ab2df"
msgid "A waste of perfectly good blood."
msgstr "피가 이리 낭비되다니 아까워 죽겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_FightingFishers
#. Speaker = Player
#. NodeID = 5f68a2a2-1f5c-642a-72a0-db54bf0d9bee
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_FightingFishers:5f68a2a2-1f5c-642a-72a0-db54bf0d9bee
msgctxt "h8b7c5b0dg6a40g482bga80agbce5a88d2835"
msgid ""
"These fellows fought to the last. Between fight or flight, they picked the "
"wrong response."
msgstr "이 양반들은 끝까지 맞서 싸웠구먼. 싸움이랑 도망 중에 잘못된 선택을 골랐어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_FightingFishers
#. Speaker = Player
#. NodeID = 5f68a2a2-1f5c-642a-72a0-db54bf0d9bee
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_FightingFishers:5f68a2a2-1f5c-642a-72a0-db54bf0d9bee
msgctxt "he2018165gc00cg4ab6g972fgbf5e566915b7"
msgid ""
"Must've been fishing when the nautiloid crashed. Hope they died quickly, at "
"least."
msgstr "노틸로이드가 추락할 때 낚시 중이었나 봐. 적어도 고통 없이 단숨에 죽었길 바라야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_FightingFishers
#. Speaker = Player
#. NodeID = 5f68a2a2-1f5c-642a-72a0-db54bf0d9bee
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_FightingFishers:5f68a2a2-1f5c-642a-72a0-db54bf0d9bee
msgctxt "h009d59ccgf947g469ag9362g4c7ece6b5515"
msgid "Dead, of course. They'd have been no match for a <i>ghaik</i> devourer."
msgstr "당연하게도 죽어있군. <i>게이크</i> 포식자한테 상대도 안 되는 종자들이니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_FightingFishers
#. Speaker = Player
#. NodeID = 5f68a2a2-1f5c-642a-72a0-db54bf0d9bee
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_FightingFishers:5f68a2a2-1f5c-642a-72a0-db54bf0d9bee
msgctxt "h89470c9fg9783g4f27gb4e4g4680f47fb0f9"
msgid "Put up a fight by the looks of it. Not that it mattered in the end..."
msgstr "모습을 보니 저항을 한 모양이네. 부질없는 짓이었지만 말이야..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_FightingFishers
#. Speaker = Player
#. NodeID = 5f68a2a2-1f5c-642a-72a0-db54bf0d9bee
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_FightingFishers:5f68a2a2-1f5c-642a-72a0-db54bf0d9bee
msgctxt "h65f39d21g7ad4g49d3ga732ge58a83dd4173"
msgid ""
"Rotten luck. One moment, they're fishing. The next, murdered by monsters."
msgstr "재수 참 더럽군. 한가로이 낚시하던 중에, 괴물들에게 살해당하다니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_FightingFishers
#. Speaker = Player
#. NodeID = 5f68a2a2-1f5c-642a-72a0-db54bf0d9bee
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_FightingFishers:5f68a2a2-1f5c-642a-72a0-db54bf0d9bee
msgctxt "hdd3f1503gd41fg44a1g9424g7bdba34f5900"
msgid "Must have been fishing when these monsters came. Bad luck."
msgstr "괴물들이 덮쳤을 때 낚시 중이었나 보네. 운도 나쁘지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_FightingFishers
#. Speaker = Player
#. NodeID = d431d481-3b4c-2f55-da65-62f45b67fa2c
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_FightingFishers:d431d481-3b4c-2f55-da65-62f45b67fa2c
msgctxt "hb8a59e8cg466cg4ca7g98b4g452e62bc8962"
msgid "A waste of perfectly good blood."
msgstr "피가 이리 낭비되다니 아까워 죽겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_FightingFishers
#. Speaker = Player
#. NodeID = d431d481-3b4c-2f55-da65-62f45b67fa2c
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_FightingFishers:d431d481-3b4c-2f55-da65-62f45b67fa2c
msgctxt "h2b54965cga1a2g4943ga624gea4a73e3ce91"
msgid ""
"These fellows fought to the last. Between fight or flight, they picked the "
"wrong response."
msgstr "이 양반들은 끝까지 맞서 싸웠구먼. 싸움이랑 도망 중에 잘못된 선택을 골랐어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_FightingFishers
#. Speaker = Player
#. NodeID = d431d481-3b4c-2f55-da65-62f45b67fa2c
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_FightingFishers:d431d481-3b4c-2f55-da65-62f45b67fa2c
msgctxt "hccdaed1bgee05g46cegb2afg4729102c612c"
msgid "Wrong place, wrong time. Hope they died quickly, at least."
msgstr "때와 장소를 잘못 만났군. 적어도 고통 없이 단숨에 죽었길 바라야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_FightingFishers
#. Speaker = Player
#. NodeID = d431d481-3b4c-2f55-da65-62f45b67fa2c
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_FightingFishers:d431d481-3b4c-2f55-da65-62f45b67fa2c
msgctxt "h82db7187gce67g4a60gb077g1074b29b2693"
msgid "Dead, of course. They'd have been no match for a <i>ghaik</i> devourer."
msgstr "당연하게도 죽어있군. <i>게이크</i> 포식자한테 상대도 안 되는 종자들이니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_FightingFishers
#. Speaker = Player
#. NodeID = d431d481-3b4c-2f55-da65-62f45b67fa2c
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_FightingFishers:d431d481-3b4c-2f55-da65-62f45b67fa2c
msgctxt "h72903cc2g9cb7g47f6g82d6gf0cda01fe08b"
msgid ""
"Rotten luck. One moment, they're fishing. The next, murdered by monsters."
msgstr "재수 참 더럽군. 한가로이 낚시하던 중에, 괴물들에게 살해당하다니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_FightingFishers
#. Speaker = Player
#. NodeID = d431d481-3b4c-2f55-da65-62f45b67fa2c
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_FightingFishers:d431d481-3b4c-2f55-da65-62f45b67fa2c
msgctxt "hb379d96bg833cg4b2eg820bgf8add286ecda"
msgid "Put up a fight by the looks of it. Not that it mattered in the end..."
msgstr "모습을 보니 저항을 한 모양이네. 부질없는 짓이었지만 말이야..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_FightingFishers
#. Speaker = Player
#. NodeID = d431d481-3b4c-2f55-da65-62f45b67fa2c
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_FightingFishers:d431d481-3b4c-2f55-da65-62f45b67fa2c
msgctxt "h9eb24687g092eg4ea3g9cf2g1e502e8c115d"
msgid "Must have been fishing when these monsters came. Bad luck."
msgstr "괴물들이 덮쳤을 때 낚시 중이었나 보네. 운도 나쁘지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_FightingFishers
#. Speaker = Player
#. NodeID = fb54f4cb-2da6-3437-0e1c-ab54b5d4eb68
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_FightingFishers:fb54f4cb-2da6-3437-0e1c-ab54b5d4eb68
msgctxt "h5af370f2gf12fg4305gbeaag3fc4c865db6b"
msgid "A waste of... you have interesting priorities."
msgstr "낭비라니... 거 참 독특한 관점을 지녔는걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_FightingFishers
#. Speaker = Player
#. NodeID = fb54f4cb-2da6-3437-0e1c-ab54b5d4eb68
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_FightingFishers:fb54f4cb-2da6-3437-0e1c-ab54b5d4eb68
msgctxt "h18e1c862gde11g47e8g843bgda4363244d77"
msgid "Hm. Wouldn't wish that fate on anyone."
msgstr "흠. 아무도 바라 마지않을 최후인걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_Jetty
#. Speaker = Player
#. NodeID = 69bd3c41-6324-fb2b-533b-0d8a0c17c85c
#. HandlePath = TaggedText[3].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_Jetty:69bd3c41-6324-fb2b-533b-0d8a0c17c85c
msgctxt "h1d68e8d4gdb34g4119g9f4fgb2039b6b9cc7"
msgid "Let's hope the locals are friendly."
msgstr "현지인들이 호의적이길 바라자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_Jetty
#. Speaker = Player
#. NodeID = 69bd3c41-6324-fb2b-533b-0d8a0c17c85c
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_Jetty:69bd3c41-6324-fb2b-533b-0d8a0c17c85c
msgctxt "h742f9113g330eg484fg949egb1eb99f4a646"
msgid "It's the River Chionthar. I'd know these waters anywhere."
msgstr "이건 치온타르 강이군. 이 강물은 어디서든 딱 알아볼 수 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_Jetty
#. Speaker = Player
#. NodeID = 69bd3c41-6324-fb2b-533b-0d8a0c17c85c
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_Jetty:69bd3c41-6324-fb2b-533b-0d8a0c17c85c
msgctxt "hb3dd036agbb6bg4dfcgad11g6257d88ac5a5"
msgid ""
"Do you intend to vocalise <i>every</i> thought? Or just the most obvious "
"ones?"
msgstr "<i>모든</i> 생각을 입 밖으로 내뱉을 작정인 거냐? 아니면 뻔한 것만 골라 얘기하는 거냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_Jetty
#. Speaker = Player
#. NodeID = 69bd3c41-6324-fb2b-533b-0d8a0c17c85c
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_Jetty:69bd3c41-6324-fb2b-533b-0d8a0c17c85c
msgctxt "h3ad2187eg266cg4e4agb921gfd9ab1d3518b"
msgid "Makes a pleasant change from rivers of blood."
msgstr "피로 된 강물만 보다가 풍경이 바뀌니 기분 좋네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_Jetty
#. Speaker = Player
#. NodeID = cfa8b5b7-6ca6-377f-80ca-4b30ef7790b6
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_Jetty:cfa8b5b7-6ca6-377f-80ca-4b30ef7790b6
msgctxt "h0cfbdb6dge9e5g42f7g919eg8c123ec6564a"
msgid "Running water normally burns like acid. But now - who knows?"
msgstr "원래 흐르는 물은 산성물질처럼 날 태우는데, 지금은... 혹시나 싶은데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_Jetty
#. Speaker = Player
#. NodeID = cfa8b5b7-6ca6-377f-80ca-4b30ef7790b6
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_Jetty:cfa8b5b7-6ca6-377f-80ca-4b30ef7790b6
msgctxt "h85e60ceeg210ag4f56gb950g5b32bba8a42c"
msgid "A mighty river. There's bound to be settlements along its shores."
msgstr "장대한 강이군. 강변을 따라가면 주거지가 틀림없이 나올 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_Jetty
#. Speaker = Player
#. NodeID = cfa8b5b7-6ca6-377f-80ca-4b30ef7790b6
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_Jetty:cfa8b5b7-6ca6-377f-80ca-4b30ef7790b6
msgctxt "h933aa7b6gb0d3g4be7g81c8g16b3aecf0291"
msgid "Makes a pleasant change from rivers of blood."
msgstr "피로 된 강물에서 새 풍경으로 바뀌니 기분 좋네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_Jetty
#. Speaker = Player
#. NodeID = cfa8b5b7-6ca6-377f-80ca-4b30ef7790b6
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_Jetty:cfa8b5b7-6ca6-377f-80ca-4b30ef7790b6
msgctxt "hbcf8550bg0b1eg4731gad48g1be3bf094ea9"
msgid "Fresh water. There will be a settlement near."
msgstr "민물이군. 근처에 주거지가 있겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_Jetty
#. Speaker = Player
#. NodeID = cfa8b5b7-6ca6-377f-80ca-4b30ef7790b6
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_Jetty:cfa8b5b7-6ca6-377f-80ca-4b30ef7790b6
msgctxt "hb1f57defg7e40g4aa8ga770g254e72dc774b"
msgid "There's bound to be a settlement somewhere along this river..."
msgstr "이 강변 어딘가에 주거지가 틀림없이 있을 거야..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_Jetty
#. Speaker = Player
#. NodeID = cfa8b5b7-6ca6-377f-80ca-4b30ef7790b6
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_Jetty:cfa8b5b7-6ca6-377f-80ca-4b30ef7790b6
msgctxt "h274777b5g42bfg4a46g9211g23efdeefbbf3"
msgid "The River Chionthar. I'd know those clear waters anywhere."
msgstr "치온타르 강이군. 이 맑은 물은 어딜 가도 알아볼 수 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_Jetty
#. Speaker = Player
#. NodeID = cfa8b5b7-6ca6-377f-80ca-4b30ef7790b6
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_Jetty:cfa8b5b7-6ca6-377f-80ca-4b30ef7790b6
msgctxt "h62b22286g7fefg4d7cg902ag421e300add98"
msgid "Fresh water. There must be a settlement somewhere nearby."
msgstr "민물이군. 분명 근처에 주거지가 있을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_General_PAD_Jetty
#. Speaker = Player
#. NodeID = dfb8732f-90dc-4431-5022-39dda8d98037
