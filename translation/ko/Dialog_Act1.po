msgctxt "h265eb72eg3be8g4bfdg91a6g535f48c5c146"
msgid "Go on, then. Keep at it."
msgstr "그럼, 계속해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear
#. Speaker = Player
#. NodeID = b5df2df0-5e5e-8772-96ae-80798866c5e4
