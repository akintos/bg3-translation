msgctxt "h2ea5e8e6ga058g4a6eg8e7eg8a5980c61514"
msgid "This music! To live for... To die for..."
msgstr "이 노래! 삶이건 죽음이건 바칠 수 있어..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerCharmed
#. Speaker = Player
#. NodeID = 05018964-92a4-0602-28a5-9e6fc53d548d
