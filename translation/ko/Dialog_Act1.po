#.      - UND_DuergarLoyalFocused_HasMet2(1) = True
#. TagRule: HILLDWARF or MOUNTAINDWARF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarLoyalFocused:b5c1b5c2-f096-4541-c3e4-eb5140a80d81
msgctxt "ha0a589d4ge43bg4326gb8e9g670c13dc9c52"
msgid "Maybe you sun-dwarf's ain't so bad."
msgstr "너희 태양 드워프 놈들도 그렇게 나쁘지는 않을지도."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarLoyalFocused
#. Speaker = Mind Master Fonmara
#. NodeID = b5c1b5c2-f096-4541-c3e4-eb5140a80d81
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_DuergarLoyalFocused_HasMet2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarLoyalFocused:b5c1b5c2-f096-4541-c3e4-eb5140a80d81
msgctxt "hc10ca927g1e60g4931g87f9g72bcf74ce845"
msgid "Absolute will bless you for that. Ain't no denyin'."
msgstr "절대자께서 네게 축복을 내려주실 거다. 이건 부인할 수 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarLoyalFocused
#. Speaker = Mind Master Fonmara
#. NodeID = cf62605c-484e-1576-5170-4123df71fa6f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_DuergarGuardFocused_Hasmet(1) = True
#. TagRule: DEEPGNOME
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarLoyalFocused:cf62605c-484e-1576-5170-4123df71fa6f
msgctxt "h8455a98egee15g4991ga3a5gca9fa15a2e72"
msgid "I'm watching you, runt. One wrong move, and you're joinin' the others."
msgstr "지켜보고 있다, 좆만아. 허튼 짓 하나라도 했다가는 다른 자식들 따라가는 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarLoyalFocused
#. Speaker = Mind Master Fonmara
#. NodeID = cf62605c-484e-1576-5170-4123df71fa6f
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_DuergarGuardFocused_Hasmet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarLoyalFocused:cf62605c-484e-1576-5170-4123df71fa6f
msgctxt "h50062887gd425g4716g820bgef7f9831a016"
msgid "I've got my eye on you. Enough goin' wrong without outsider meddlin'."
msgstr "주시하고 있다. 외부인의 참견 없이도 이미 일이 거지같이 돌아가고 있다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarLoyalGuard_02
#. Speaker = Dalthar
#. NodeID = 0a738a0f-e249-33a6-231d-1d6535d67c43
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_DuergarGuard_03_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarLoyalGuard_02:0a738a0f-e249-33a6-231d-1d6535d67c43
msgctxt "h062d243agcf40g487aga3acgff45adaf206f"
msgid "Off with you, now."
msgstr "이제 꺼져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarLoyalGuard_02
#. Speaker = Dalthar
#. NodeID = af719632-18fc-3bd0-f06a-90eaa93f5bc4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_DuergarGuard_03_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - UND_DuergarGuard_03_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarLoyalGuard_02:af719632-18fc-3bd0-f06a-90eaa93f5bc4
msgctxt "hb8a53a85g65aeg4fc5g9795g8a18206caf0b"
msgid ""
"Saw you arriving - almost put a hole in your boat. Don't make me wish I had."
msgstr "네가 오는 걸 봤어. 네 배에 구멍을 뚫어줄 뻔 했다니까. 내가 그러지 않은 걸 후회하게 하지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarLoyalGuard_02
#. Speaker = Dalthar
#. NodeID = db2b68d9-951f-00a2-1f94-1ed9d9da0f92
