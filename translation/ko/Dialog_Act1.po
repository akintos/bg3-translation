msgctxt "h6a1371e7g2697g4903g924fgc0f86ab55c3e"
msgid "These two were made to suffer, whoever they were."
msgstr "이들이 누군진 모르겠지만, 상당히 고통스러웠겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_HagAmush_PAD_FoundBrothersAfterLongRest
