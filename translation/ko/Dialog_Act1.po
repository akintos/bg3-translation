msgctxt "heb543d59g9fbdg4b7cg9d25g9cb22e7b6924"
msgid "*The spell's power wanes. You can ask no more questions.*"
msgstr "*주문의 힘이 약해집니다. 더 이상 질문을 할 수 없습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_Dead_PostEA
#. Speaker = Narrator
#. NodeID = 2f4bc19d-78e6-4081-941d-78a8e1fe2fde
