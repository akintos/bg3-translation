msgctxt "hc1cdc33cgf9c0g4953gbd67ga47b6ea92f39"
msgid "Thank the gods..."
msgstr "신들이시여, 감사합니다..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_AD_Rescued
#. Speaker = Benryn
#. NodeID = 6f23facb-5ff8-457e-8417-8afcb17422aa
