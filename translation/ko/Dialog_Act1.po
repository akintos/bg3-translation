#.      - BARBARIAN(1) = True
#. TagRule: BERSERKER
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinKid002_LootingCrime:d2359176-38cd-ba0c-d9db-b9aaada871fb
msgctxt "h6ce0bb4cg3c14g49e9ga9a3gb7f88528b39c"
msgid "<b><i>ROAR.</i></b>"
msgstr "<b><i>크아아.</i></b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinKid002_LootingCrime
#. Speaker = Player
#. NodeID = d2359176-38cd-ba0c-d9db-b9aaada871fb
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinKid002_LootingCrime:d2359176-38cd-ba0c-d9db-b9aaada871fb
msgctxt "h4af1177eg4843g4404g9378gce15cd6cfbad"
msgid "<b>Try and stop me.</b>"
msgstr "<b>어디 한번 막아봐라.</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinKid002_LootingCrime
#. Speaker = Eight
#. NodeID = e2dffb71-8dd3-ccbe-b468-9ea9af59573a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_Festivities_Event_KidsRun = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinKid002_LootingCrime:e2dffb71-8dd3-ccbe-b468-9ea9af59573a
msgctxt "h2cac0d24ge764g4cccg9178g35746c9d0c01"
msgid "I'll - I'll leave him to you, uh, True Soul."
msgstr "저는 - 저는 그를 당신에게 맡기겠습니다, 어, 참된 영혼이시여."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinKid002_LootingCrime
#. Speaker = Narrator
#. NodeID = e7c56fb9-c8fd-26f9-cab1-d207e58808bb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount2(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinKid002_LootingCrime:e7c56fb9-c8fd-26f9-cab1-d207e58808bb
msgctxt "h42e135e3ge3b8g49a4g847egeb727c3a5ee5"
msgid ""
"*Something stirs deep within you, hungry and alert... it's taking something "
"you'll never get back.*"
msgstr "*몸 깊숙한 데서 굶주리고 기민한 존재가 꿈틀댑니다... 잃으면 되찾지 못할 뭔가를 좀먹고 있군요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinKid002_LootingCrime
#. Speaker = Eight
#. NodeID = eb17a0e0-1987-9441-d3de-1dd4e49e911b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_Festivities_Event_KidsRun = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinKid002_LootingCrime:eb17a0e0-1987-9441-d3de-1dd4e49e911b
msgctxt "hc40f05b6g8189g40c7gada1g64ad64474c80"
msgid ""
"Take him. I'll just cut your throat when you ain't looking, and get all your "
"stuff, then."
msgstr "그를 데려가. 나는 네가 주시하고 있지 않으면 그땐 네 목을 베고, 네 모든 걸 가져갈 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinKid002_LootingCrime
#. Speaker = Narrator
#. NodeID = ebaeacea-4dd8-b38a-f167-e1e5e5d7cb74
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinKid002_LootingCrime:ebaeacea-4dd8-b38a-f167-e1e5e5d7cb74
msgctxt "hb0525e38g91e1g4294g926age3689f6a26c7"
msgid ""
"*The mark glows, but you feel nothing in response. Your illithid power is "
"beyond reach until you rest.*"
msgstr "*문양이 빛나지만, 어떤 반응도 느껴지지 않습니다. 일리시드 능력을 더 사용하려면 휴식을 취해야 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinKid002_LootingCrime
#. Speaker = Narrator
#. NodeID = f227027a-5069-d4c0-01c7-1d976140e619
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount5(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount5(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinKid002_LootingCrime:f227027a-5069-d4c0-01c7-1d976140e619
msgctxt "h5f279727g7a30g498bgb7e6g7eac1c052096"
msgid ""
"*Your blood runs quicker, feeding the gnawing absence at the centre of your "
"mind.*"
msgstr "*피가 더 빨리 흐르면서, 당신의 정신 한가운데를 좀먹는 허전함을 양분으로 채웁니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinKid002_LootingCrime
#. Speaker = Eight
#. NodeID = f9a0e356-bc03-9530-78a1-153adf542af3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Festivities_GoblinKid002_WarnedAboutCorpse(1) = True
#. SetFlags:
#.   Global:
#.     - GOB_Festivities_State_KidsFighting = True
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinKid002_LootingCrime:f9a0e356-bc03-9530-78a1-153adf542af3
msgctxt "he0835a2fg310fg4f8fg861cg6777b4c53058"
msgid "I said he's <i>mine</i>!"
msgstr "그는 <i>내 거</i>라고 말했다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinSleeper_00
#. Speaker = Sharp-Eye Raagg
#. NodeID = 4221e0d5-115d-df12-c37d-ff3e9beafaa5
