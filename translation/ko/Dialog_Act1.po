msgctxt "h96aef832gbf79g429eg9f5ag053ae8d656f9"
msgid "Hang on. That's adamantine speckled in there."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_DuergarCamp_PAD_FoundAdamantine
#. Speaker = Player
#. NodeID = 593cfe72-d600-fa58-4d7d-bcde379328fd
