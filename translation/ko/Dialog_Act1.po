msgctxt "h279f3c93g992ag42d0g9ee5gbb71a6debc21"
msgid "Kids! Scatter!"
msgstr "얘들아! 흩어져!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_HideoutTrespass
