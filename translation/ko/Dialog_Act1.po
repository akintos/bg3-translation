msgctxt "he3ae0bf2g65bbg4271ga8a8g4334edf08f9a"
msgid "Jaheira? Can't say I know the name."
msgstr "자헤이라? 처음 들어보는 이름 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_HangedDrow_Dead
#. Speaker = Executed Drow
#. NodeID = c35bbd41-57a7-4014-9c6a-8d8e2b9aea0e
#. HandlePath = TaggedText[0].TagText[0]
