#.   Object:
#.      - FOR_SeluneStash_State_SuccessfullyReadPrayer(0) = False
#. TagRule: (CLERIC_SHAR or PALADIN_SHAR) and !REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_OpenStashWithPrayer:90e15916-fb8c-e658-9626-77a2b2e18e0a
msgctxt "h1dad95f3ge02dg4460g85c8g750aa15dbfec"
msgid "These Selûnite words do nothing."
msgstr "이 셀루네의 기도문은 아무 짝에도 쓸모가 없군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_OpenStashWithPrayer
#. Speaker = Player
#. NodeID = 90e15916-fb8c-e658-9626-77a2b2e18e0a
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Object:
#.      - FOR_SeluneStash_State_SuccessfullyReadPrayer(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_OpenStashWithPrayer:90e15916-fb8c-e658-9626-77a2b2e18e0a
msgctxt "h57c471a7g9bb6g42deg8a51gf282679f630f"
msgid "Well praying didn't help..."
msgstr "기도가 도움이 되진 않았네..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_PickupPrayerSheet
#. Speaker = Player
#. NodeID = 02916df9-e75e-5b7b-49ae-3138f7423309
