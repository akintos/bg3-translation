msgctxt "h6663d0c4g6cbfg4bc4gb2c9gbf73f85683ba"
msgid "JUST TRY IT, ZARIEL! COME ON!"
msgstr "<b>여기 와보시지, 자리엘! 덤벼!</b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PreciousCargo_PAD
#. Speaker = Player
#. NodeID = 11d1fe2b-a00b-06a9-3c3c-490d16609b4f
