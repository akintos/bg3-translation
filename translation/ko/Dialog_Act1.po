#. SetFlags:
#.   Dialog:
#.     - DEN_HarpyMeal_Event_OriginCharm1(0) = True
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerCharmed:05018964-92a4-0602-28a5-9e6fc53d548d
msgctxt "h1ac44b09g9874g469eg94f9gbcb0f7d9cd8f"
msgid "I've never heard such music."
msgstr "이런 노래는 들어본 적이 없다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerCharmed
#. Speaker = Player
#. NodeID = 05018964-92a4-0602-28a5-9e6fc53d548d
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_HarpyMeal_Event_OriginCharm1(0) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_HarpyMeal_Event_OriginCharm1(0) = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerCharmed:05018964-92a4-0602-28a5-9e6fc53d548d
msgctxt "hed5b0583gb83bg40c4gb94eg616a83baf0f1"
msgid "So beautiful. Like Shar's embrace..."
msgstr "너무 아름다워. 마치 샤님의 품에 안긴 것 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerCharmed
#. Speaker = Player
#. NodeID = 05018964-92a4-0602-28a5-9e6fc53d548d
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_HarpyMeal_Event_OriginCharm1(0) = False
#. SetFlags:
