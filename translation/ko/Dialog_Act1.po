#.     - a7407f82-add0-9f6d-e4e6-78b9c39195a6_B = True
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Forest_VB_Trap:da20959b-183b-f20a-98c0-e2eb014fe9e1
msgctxt "h4286ddc6g9029g4d9eg9acdg036758d92180"
msgid "Broken. Pitiful."
msgstr "망가져 있어. 한심하긴."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Forest_VB_Trap
#. Speaker = Player
#. NodeID = da20959b-183b-f20a-98c0-e2eb014fe9e1
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Local:
#.      - a7407f82-add0-9f6d-e4e6-78b9c39195a6_C = False
#.      - a7407f82-add0-9f6d-e4e6-78b9c39195a6_B = False
#.      - a7407f82-add0-9f6d-e4e6-78b9c39195a6_A = True
#. SetFlags:
#.   Local:
#.     - a7407f82-add0-9f6d-e4e6-78b9c39195a6_B = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Forest_VB_Trap:da20959b-183b-f20a-98c0-e2eb014fe9e1
msgctxt "h729313cdge47eg484agaddag5c19fc7aa2e3"
msgid "Another broken trap. Who made these things?"
msgstr "또 망가진 함정이잖아. 누가 이런 걸 만든 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Forest_VB_TrapReuse
#. Speaker = Player
#. NodeID = b0f8b8c8-8a5d-22e5-74d8-fc53589b66d9
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Forest_VB_TrapReuse:b0f8b8c8-8a5d-22e5-74d8-fc53589b66d9
msgctxt "h7cdb8086g7de3g4145g8d5egacbc9800d9c3"
msgid "Useless."
msgstr "쓸모없군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Forest_VB_TrapReuse
#. Speaker = Player
#. NodeID = b0f8b8c8-8a5d-22e5-74d8-fc53589b66d9
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Forest_VB_TrapReuse:b0f8b8c8-8a5d-22e5-74d8-fc53589b66d9
msgctxt "hfebdcf69g457dg4b50ga687g3df5b1ed6c7f"
msgid "Not much use anymore."
msgstr "이젠 별로 쓸모가 없겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_AD_EscortStart
#. Speaker = Lae'zel
#. NodeID = 274767a6-3a0e-bfc7-db2d-732dd6d226f6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_AD_EscortStart:274767a6-3a0e-bfc7-db2d-732dd6d226f6
msgctxt "h142a480cge0c9g4e9ag83bfg85e7889397ae"
msgid "You expect a githyanki to surrender? <i>Imbeciles.</i>"
msgstr "기스양키가 항복 따위 할 성싶으냐? <i>얼간이들.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_AD_EscortStart
#. Speaker = Lae'zel
#. NodeID = 369a3909-6c33-6bfb-846c-58a440c9a8d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_AD_EscortStart:369a3909-6c33-6bfb-846c-58a440c9a8d9
msgctxt "h38474ac7g050eg4793ga4f4gd4f2e8f95220"
msgid "You expect a githyanki to surrender? <i>Imbecile.</i>"
msgstr "기스양키가 순순히 항복할 성싶으냐? <i>얼간이들.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_AD_EscortStart
#. Speaker = Damays
#. NodeID = 89bb30eb-cfc8-c3ce-4a47-f9d1e5e2fdc1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_AD_EscortStart:89bb30eb-cfc8-c3ce-4a47-f9d1e5e2fdc1
msgctxt "h595ea296ge9d4g4c1aga370gc3a9fa139931"
msgid "Hold it still - I'll tie it up."
msgstr "꽉 붙들고 있어. 내가 묶을게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_AD_EscortStart
#. Speaker = Nymessa
#. NodeID = cf325c63-6a48-a78a-1577-88f0280b1394
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_LaezelRecruitment_State_Tiefling2Missing = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_AD_EscortStart:cf325c63-6a48-a78a-1577-88f0280b1394
msgctxt "hcf666f16g6282g4903g8fecg9c20775b5e43"
msgid "Time to get this toad tied up."
msgstr "이만 이 두꺼비를 묶어야겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_AD_LaeZelDead
#. Speaker = Damays
#. NodeID = 183bcee7-fa91-a531-b6a0-9a4eeaa886ba
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_LaezelRecruitment_State_LaezelIsDead = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_AD_LaeZelDead:183bcee7-fa91-a531-b6a0-9a4eeaa886ba
msgctxt "ha6752572gfaeeg4879gbdc8g0ecb3e4993b9"
msgid "Dead. Finally."
msgstr "죽었군. 드디어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_AD_LaeZelDead
#. Speaker = Nymessa
#. NodeID = 362ac7c6-1ac7-34e5-0dc4-2ea6261aecbc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_AD_LaeZelDead:362ac7c6-1ac7-34e5-0dc4-2ea6261aecbc
msgctxt "h31835e7fg048bg4b14gabd4g76f63a0ee90f"
msgid "Yes. Of course, of course."
msgstr "그래. 물론, 물론이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_AD_LaeZelDead
#. Speaker = Damays
#. NodeID = 5eeb7c0b-41cc-52ac-6f9d-03423e1b6aad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_AD_LaeZelDead:5eeb7c0b-41cc-52ac-6f9d-03423e1b6aad
msgctxt "hee7b6dd8g2c56g40c9gaab7g83955ad2e452"
msgid "Nymessa. Are you all right?"
msgstr "나이메사. 너 괜찮아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_AD_LaeZelDead
#. Speaker = Damays
#. NodeID = a0a793ec-5a54-94d8-931f-2a12cf4debcc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_AD_LaeZelDead:a0a793ec-5a54-94d8-931f-2a12cf4debcc
msgctxt "hfbd794d6g50dcg48d6g8f57g37ba23e53340"
msgid "Hold it together. We've got to finish what we started."
msgstr "정신 바짝 차려. 마저 끝낼 일이 남아있다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_AD_LaeZelDead
#. Speaker = Nymessa
#. NodeID = b2f9df5e-9a93-dfea-16fa-65770dc9f1ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_AD_LaeZelDead:b2f9df5e-9a93-dfea-16fa-65770dc9f1ea
msgctxt "h3dfb2f78g403bg4937ga5bcg7715e7b5a77a"
msgid "I - I think so."
msgstr "그, 그런 거 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_AD_LaeZelDead
#. Speaker = Damays
#. NodeID = da9b7bdf-cf07-5f78-5e24-72345daf49dd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_AD_LaeZelDead:da9b7bdf-cf07-5f78-5e24-72345daf49dd
msgctxt "ha1c7b5a8g06ffg49f1g84e0g12260a928409"
msgid "Nymessa. Are you all right?"
msgstr "나이메사. 너 괜찮아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_AD_LaeZelTieflingsIntro
#. Speaker = Damays
#. NodeID = 0b694243-6d5b-07bd-48cb-18a24e4eda82
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_AD_LaeZelTieflingsIntro:0b694243-6d5b-07bd-48cb-18a24e4eda82
msgctxt "h5ad59e6ag943cg4d10g8192gfc27c09fe1d7"
msgid "And let the goblins have it?"
msgstr "고블린들이 채가게 냅두라고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_AD_LaeZelTieflingsIntro
#. Speaker = Damays
#. NodeID = 171460df-21f7-7b6a-108f-a30fbbdbd2ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_AD_LaeZelTieflingsIntro:171460df-21f7-7b6a-108f-a30fbbdbd2ea
msgctxt "ha94d9dd0gd77eg4ec0ga24egbf43016f5426"
msgid "And when the goblins ally with it?"
msgstr "저게 고블린들이랑 한패라도 되면 어쩌려고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_AD_LaeZelTieflingsIntro
#. Speaker = Nymessa
#. NodeID = 41681193-752a-9ffd-5569-e343c3d04d10
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_AD_LaeZelTieflingsIntro:41681193-752a-9ffd-5569-e343c3d04d10
msgctxt "heac4ff6aga51cg4ad3g9277g031b8dc17a73"
msgid "So let's leave it."
msgstr "그럼 내버려두자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_AD_LaeZelTieflingsIntro
#. Speaker = Nymessa
#. NodeID = 42a8a720-c685-95cf-f082-cf6ec6cad139
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_AD_LaeZelTieflingsIntro:42a8a720-c685-95cf-f082-cf6ec6cad139
msgctxt "h2a582a30g6034g4336g8078ga9e3d075bfdb"
msgid "We'll be on the road to Baldur's Gate."
msgstr "우린 어차피 발더스 게이트로 뜰 거잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_AD_LaeZelTieflingsIntro
#. Speaker = Damays
#. NodeID = 48618cc8-eeac-1efe-8f53-b6e8d56ef9d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_AD_LaeZelTieflingsIntro:48618cc8-eeac-1efe-8f53-b6e8d56ef9d9
msgctxt "h92c43dbbg20f7g41a2g8754g57c5e9734059"
msgid "Of course it's dangerous. One of them carved up Zorru's whole squad."
msgstr "당연히 위험하지. 저놈들 중 하나가 조르네 조원들을 전부 도륙냈다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_AD_LaeZelTieflingsIntro
#. Speaker = Damays
#. NodeID = 9f5551ff-ba39-1335-cfd7-ad47574e9d7f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 10297257-36dd-3799-f681-657656779d4a_TieflingsLaezelAD1 = False
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_AD_LaeZelTieflingsIntro:9f5551ff-ba39-1335-cfd7-ad47574e9d7f
msgctxt "h010e93acgaa30g4589g8a3bg0a64ac090cd4"
msgid ""
"When this thing strikes, there will be no soldiers to protect you. This "
"isn't Elturel."
msgstr "저게 나중에 습격이라도 해오면, 그때 널 지켜줄 군인 따윈 없어. 여긴 엘투렐이 아니라고."

