msgctxt "h488e81d0g1fccg4267gbde7gbdb32ed2b482"
msgid "Kill it - that thing'll roast up nicely for our supper."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_StatusFallback
#. Speaker = Fezzerk
#. NodeID = 8d47ebc4-579e-4e86-80e1-c95212f28a49
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_StatusFallback:8d47ebc4-579e-4e86-80e1-c95212f28a49
msgctxt "hc84d239eg9634g4d89g836fg90813749b764"
msgid "What's this? Local wildlife havin' a gawk?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Surrender_NotAtWindmill
#. Speaker = Player
#. NodeID = 04adc43d-0f4d-b7be-5064-5c44a65173a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Surrender_NotAtWindmill:04adc43d-0f4d-b7be-5064-5c44a65173a5
msgctxt "h9c9f6f4fg1fbdg4ebdgae51gfcac1351d3ba"
msgid "<i>No mercy. Kill the goblin.</i>"
msgstr "<i>자비는 없다. 고블린을 죽인다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Surrender_NotAtWindmill
#. Speaker = Player
#. NodeID = 0b329bb4-4c31-be72-323e-5c74443b9960
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Surrender_NotAtWindmill:0b329bb4-4c31-be72-323e-5c74443b9960
msgctxt "h10fd7223g5e85g45f2gae4bg1aadf8d991a6"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Surrender_NotAtWindmill
#. Speaker = Narrator
#. NodeID = 105a236e-c112-01db-c31b-079ad09c9dc6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Surrender_NotAtWindmill:105a236e-c112-01db-c31b-079ad09c9dc6
msgctxt "h016ac6a1gc9ceg4378gb10cg63beb179ef22"
msgid "*The veil of rage wavers. Your blood seems to cool in your veins.*"
msgstr "*분노가 약해집니다. 당신의 혈관 속 피가 식는 것 같습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Surrender_NotAtWindmill
#. Speaker = Fezzerk
#. NodeID = 11d45007-3cde-9aa2-6c73-7ec93ad9905a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CharacterDieAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Surrender_NotAtWindmill:11d45007-3cde-9aa2-6c73-7ec93ad9905a
msgctxt "h8ad12a5bgde6fg451bg9b59gf9aac88fc8b5"
msgid "No, wait!"
msgstr "잠깐, 기다려!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Surrender_NotAtWindmill
#. Speaker = Narrator
#. NodeID = 201dc602-785c-9bd2-8ff9-79dedab8d7b9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Surrender_NotAtWindmill:201dc602-785c-9bd2-8ff9-79dedab8d7b9
msgctxt "hdbf14f89g73c1g4957g80b1g7904d55206fc"
msgid ""
"*The goblin's snivelling makes your blood boil. You could give in to the "
"rage and end the wicked little maggot in one strike...*"
msgstr ""
"*이 고블린이 징징거리는 걸 듣고 있으니 당신의 피가 끓습니다. 당신은 분노를 받아들이고 이 사악한 구더기를 한 방에 끝장내버릴 수도 "
"있습니다...*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Surrender_NotAtWindmill
#. Speaker = Player
#. NodeID = 22b5f8fa-00a5-af51-6d1e-3be84e12c00c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_GnomeGoblin1_State_WasLooted = False
#.   User:
#.      - FOR_GnomeGoblin1_State_PaidUser(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Surrender_NotAtWindmill:22b5f8fa-00a5-af51-6d1e-3be84e12c00c
msgctxt "h6c1a9b6fg3ba6g4801gbd4bg36e59f067a20"
msgid "I want everything of value you have."
msgstr "돈 될 만한 거 전부 내놔."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Surrender_NotAtWindmill
#. Speaker = Fezzerk
#. NodeID = 2482deee-85c4-eb5c-49bd-8f10903bf10c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_GnomeGoblin1_State_SurrenderWait = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Surrender_NotAtWindmill:2482deee-85c4-eb5c-49bd-8f10903bf10c
msgctxt "h1b2dda60g5225g4e0egb525g1b4b9f9086a9"
msgid "You sure I c-can't just leave?"
msgstr "날 떠나게 해-해주면 안될까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Surrender_NotAtWindmill
#. Speaker = Fezzerk
#. NodeID = 3dd38436-f719-7885-3b4e-a5bf9f3ad145
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_CheckPocketGold = True
#. SetFlags:
#.   Object:
#.     - GEN_TransferNPCPayment(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Surrender_NotAtWindmill:3dd38436-f719-7885-3b4e-a5bf9f3ad145
msgctxt "hefdf5292gdc69g489cgb811g579aab5f6f0f"
msgid "A-all right, fine. Take it - take it all! Now... can I go...?"
msgstr "아-알겠어. 좋아. 가져가. 다 가져가! 저... 이제 가도 될까...?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Surrender_NotAtWindmill
#. Speaker = Fezzerk
#. NodeID = 4e741dbb-17df-4ab9-731a-c7f206befd36
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Surrender_NotAtWindmill:4e741dbb-17df-4ab9-731a-c7f206befd36
msgctxt "h8970219bg33d0g442cga28bg77c64cc9ab3e"
msgid ""
"There's a hidden path, p-past the bridge into the camp. Over to the side "
"before you reach the first guards. Easy."
msgstr "다리를 지-지나면 야영지 안으로 들어가는 숨겨진 길이 있어. 첫 번째 경비병이 나타나기 전에 옆으로 넘어가. 쉬운 일이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Surrender_NotAtWindmill
#. Speaker = Narrator
#. NodeID = 5d55d552-53d8-4c5f-8b0f-ecafc222dd0b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Surrender_NotAtWindmill:5d55d552-53d8-4c5f-8b0f-ecafc222dd0b
msgctxt "h878a4597g731bg4eebg818dgc986afcaa59b"
msgid ""
"*...but perhaps he knows something useful? Your head aches as rage fights "
"against reason.*"
msgstr "*...하지만 뭔가 유용한 것을 알고 있지 않을까요? 분노와 이성의 싸움으로 머리가 아파옵니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Surrender_NotAtWindmill
#. Speaker = Fezzerk
#. NodeID = 63e089a0-86ab-461a-5a6a-ae243885f441
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_GnomeGoblin1_State_WasLooted = True
#.     - FOR_GnomeGoblin1_State_SurrenderWait = True
#.   Object:
#.     - OpenLoot(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Surrender_NotAtWindmill:63e089a0-86ab-461a-5a6a-ae243885f441
msgctxt "h939846bcg1a3dg446ag8580gd08eeaee6efe"
msgid "All right! Just don't 'urt me!"
msgstr "알았어! 날 해치지만 마!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Surrender_NotAtWindmill
#. Speaker = Player
#. NodeID = 63e9d3e8-10a7-76bd-d461-bc9736af1b2e
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: BERSERKER
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Surrender_NotAtWindmill:63e9d3e8-10a7-76bd-d461-bc9736af1b2e
#, fuzzy
msgctxt "h28363fc4g98b1g4463ga5b5g9f1393f046d2"
msgid "<b><i>Give in. KILL THE MAGGOT.</i></b>"
msgstr "<b><i>받아들인다. 구더기를 죽인다.</i></b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Surrender_NotAtWindmill
#. Speaker = Player
#. NodeID = 63e9d3e8-10a7-76bd-d461-bc9736af1b2e
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Surrender_NotAtWindmill:63e9d3e8-10a7-76bd-d461-bc9736af1b2e
msgctxt "h281623a9g7924g4b95g87c1g7230122e884f"
msgid "<i>Leave reason to the reasonable. Kill the runt.</i>"
msgstr "<i>이성은 이성적인 자들의 것이다. 약골 놈을 죽인다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Surrender_NotAtWindmill
#. Speaker = Fezzerk
#. NodeID = 669fd0f5-b128-496a-57ce-31ee2ca07e6b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_GnomeGoblin1_State_SurrenderWait = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Surrender_NotAtWindmill:669fd0f5-b128-496a-57ce-31ee2ca07e6b
msgctxt "hf37a998eg47a8g4ca5g96fdg046683916dc3"
msgid "Th-thanks! And 'pologies. And... erm... bye!"
msgstr "고-고마워! 그리고 사과할게. 그리고... 음... 잘 있어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Surrender_NotAtWindmill
#. Speaker = Fezzerk
#. NodeID = 8625eef4-0870-cdaf-8519-e3c9f5f6ae74
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Surrender_NotAtWindmill:8625eef4-0870-cdaf-8519-e3c9f5f6ae74
msgctxt "h36a66148gaf90g49c6g9bd4g62b730386b2f"
msgid "W-well, what do you say?"
msgstr "저-저기, 어떨까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Surrender_NotAtWindmill
#. Speaker = Fezzerk
#. NodeID = a9e893d1-b83a-6acb-a4a0-907883c6ac8f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_CheckPocketGold = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Surrender_NotAtWindmill:a9e893d1-b83a-6acb-a4a0-907883c6ac8f
msgctxt "h57510071g91a2g4b02gb859g1f189fa472c6"
msgid "A-all right, fine. Take it - take... Wait. It's... it's gone!"
msgstr "아-알겠어. 좋아. 가져가. 다... 잠깐만. 없잖아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Surrender_NotAtWindmill
#. Speaker = Player
#. NodeID = ad1ef339-7d43-0e30-487a-571885aadab0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_GnomeGoblin1_State_WasLooted = False
#.   User:
#.      - FOR_GnomeGoblin1_State_AskedGoldBack(1) = False
#.      - FOR_GnomeGoblin1_State_PaidUser(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Surrender_NotAtWindmill:ad1ef339-7d43-0e30-487a-571885aadab0
msgctxt "h75e1b85cg867dg43ebgada3g5bb32877aa52"
msgid "Give me my gold back - and anything else you have, too."
msgstr "내 금화를 내놔. 그리고 가진 것 나머지 전부."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Surrender_NotAtWindmill
#. Speaker = Player
#. NodeID = b349e436-0512-859f-a843-b57a810c3095
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_GnomeGoblin1_Surrender_Knows_GoblinCamp(1) = False
#. SetFlags:
#.   Dialog:
#.     - FOR_GnomeGoblin1_Surrender_Knows_GoblinCamp(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Surrender_NotAtWindmill:b349e436-0512-859f-a843-b57a810c3095
msgctxt "hb189feb8gf947g4573ga1b1gbd863e1dadec"
msgid "Talk and you might live. <i>If</i> it's worth my while."
msgstr "말을 하면 살려줄 수도 있지. 그만한 가치가 <i>있다면</i> 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Surrender_NotAtWindmill
#. Speaker = Player
#. NodeID = b357f1ee-5447-acef-04a1-4010310efa76
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_GnomeGoblin1_State_WasLooted = False
#.   User:
#.      - FOR_GnomeGoblin1_State_AskedGoldBack(1) = False
#.      - FOR_GnomeGoblin1_State_PaidUser(1) = True
#. SetFlags:
#.   User:
#.     - FOR_GnomeGoblin1_State_AskedGoldBack(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Surrender_NotAtWindmill:b357f1ee-5447-acef-04a1-4010310efa76
msgctxt "hfa87af0cgaa92g4f80g94d8g0c52a2ea1152"
msgid "I want the gold you took. Now."
msgstr "네가 가져간 금화를 내놔. 당장."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Surrender_NotAtWindmill
#. Speaker = Fezzerk
#. NodeID = b7db0d30-fb93-5fec-165a-b52ea9124ce4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Surrender_NotAtWindmill:b7db0d30-fb93-5fec-165a-b52ea9124ce4
msgctxt "h5aab27a1gc452g4007gbeb9g56033e1541d8"
msgid ""
"M-my lot are camped nearby - I can get you inside, no hassle! You can loot "
"it, do whatever!"
msgstr "우-우리 무리가 근처에서 야영 중이야. 내가 들여 보내줄 수 있어! 거길 털어도 되고, 마음대로 해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Surrender_NotAtWindmill
#. Speaker = Fezzerk
#. NodeID = bf5c6a98-7122-354d-cd26-083c58343f39
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_GnomeGoblin1_State_SurrenderWait = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Surrender_NotAtWindmill:bf5c6a98-7122-354d-cd26-083c58343f39
msgctxt "hac1a90b4g591eg46bcg95d7g30000d95e074"
msgid "Stop! I give up! M-mercy, please!"
msgstr "잠깐! 항복할게! 자-자비를, 제발!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Surrender_NotAtWindmill
#. Speaker = Player
#. NodeID = dcfcb542-ff34-bbbe-f811-f99e03b2afc1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
