msgstr "우상을 훔쳤어... 사과했는데... 화를 안 풀더라..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_General_Dead_SnakeKid
#. Speaker = Narrator
#. NodeID = eb4affdc-ccdb-4194-8d19-c84970776e5f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_General_Dead_SnakeKid:eb4affdc-ccdb-4194-8d19-c84970776e5f
msgctxt "hc636148cg8400g47d3ga9eegdad1171a795a"
msgid "*The spell's power wanes. You can ask no more questions.*"
msgstr "*마법의 힘이 약해집니다. 당신은 더 이상 질문할 수 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_General_Dead_SnakeKid
#. Speaker = Arabella
#. NodeID = f37c3b98-dc40-497f-8ff5-21310559abf7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_General_Dead_SnakeKid:f37c3b98-dc40-497f-8ff5-21310559abf7
msgctxt "hf17fa918gfaaag4afbga7a4g8c8330b81a2b"
msgid "Druid's stupid snake... I was just scared..."
msgstr "드루이드의 망할 뱀이... 난 그냥 겁이 난 건데..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_General_Dead_SnakeKid
#. Speaker = Narrator
#. NodeID = fcd0b996-ed0f-45e3-b169-7be7f0c8525f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_Killer(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_General_Dead_SnakeKid:fcd0b996-ed0f-45e3-b169-7be7f0c8525f
msgctxt "hcf38528fg1120g48ffgb88fge20202bcfa09"
