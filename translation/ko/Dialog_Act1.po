#.     - 5d4b07c1-f1f0-1c63-0ef8-0fb8acb68938_C = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_AD_CultistCapture:7834d036-6a69-4d9b-9f0d-9211e8780f2b
msgctxt "h62e73c15ge9f9g4b3cg92bbge9cd984d6ff4"
msgid "Please. Just give me a moment! "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_AD_CultistCapture
#. Speaker = Raider Add'ath
#. NodeID = 8bbc53e6-cd41-41ef-b6fd-90d6c8daadd8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 5d4b07c1-f1f0-1c63-0ef8-0fb8acb68938_A = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_AD_CultistCapture:8bbc53e6-cd41-41ef-b6fd-90d6c8daadd8
msgctxt "h434dbb4bg6099g4a0fg8558g0d0fa3fd0679"
msgid "You're enjoying this, aren't you? Humiliation suits you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_AD_CultistCapture
#. Speaker = Burrock
#. NodeID = d6a24f62-dbe3-932e-8e68-d299b418345c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_AD_CultistCapture:d6a24f62-dbe3-932e-8e68-d299b418345c
msgctxt "hd14f8469gc949g42c2gb7a8g75ac392b5b41"
msgid "No - please - if you'd just - stop!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_AD_CultistCapture
#. Speaker = Raider Add'ath
#. NodeID = eab135c2-5974-4614-b65d-b74adc9d5d03
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 5d4b07c1-f1f0-1c63-0ef8-0fb8acb68938_C = True
#. SetFlags:
#.   Local:
#.     - 5d4b07c1-f1f0-1c63-0ef8-0fb8acb68938_C = False
#.     - 5d4b07c1-f1f0-1c63-0ef8-0fb8acb68938_B = False
#.     - 5d4b07c1-f1f0-1c63-0ef8-0fb8acb68938_A = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_AD_CultistCapture:eab135c2-5974-4614-b65d-b74adc9d5d03
msgctxt "h3cad17b9g4903g4c8egb9ceg46ee032bda92"
msgid "Pathetic. The fool cannot march without tripping over its own boots."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_AD_CultistCapture
#. Speaker = Warrior Ith'dul
#. NodeID = f7660a01-2cda-c5ed-a8d7-7113f12f9d39
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_AD_CultistCapture:f7660a01-2cda-c5ed-a8d7-7113f12f9d39
msgctxt "ha04aae4ag163cg4365g8151ga426ce444c5b"
msgid "There. Moment's gone. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_AD_SecondTurn
#. Speaker = Kith'rak Therezzyn
#. NodeID = 43cd25c2-8483-4000-aaf3-f70db7ea93d3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_AD_SecondTurn:43cd25c2-8483-4000-aaf3-f70db7ea93d3
msgctxt "h262c10ffg7551g4f02ga2acgf9133fa852bb"
msgid "You will die by my sword, <i>chraith</i>!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_AD_ThirdTurn
#. Speaker = Kith'rak Therezzyn
#. NodeID = 52ac2fb3-8d53-4245-abd6-92c65b731841
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_AD_ThirdTurn:52ac2fb3-8d53-4245-abd6-92c65b731841
msgctxt "haed2955dg468bg4e76g9050ga30fd97d9e66"
msgid "You will <i>not</i> embarrass me anymore!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_BarrierDeviceDialog
#. Speaker = Githyanki Barrier Disruptor
#. NodeID = 16872423-d51c-48ce-94e6-044454b6e44a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_BarrierDeviceDialog:16872423-d51c-48ce-94e6-044454b6e44a
msgctxt "h777752a2g0d53g433ag80f2g3fb7af6bc3dd"
msgid "Who would be... Oh. It is <i>you</i>."
msgstr "누가 감히... 오, <i>그대</i>였군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_BarrierDeviceDialog
#. Speaker = Githyanki Barrier Disruptor
#. NodeID = 438a1006-6055-4385-a4c0-0fca3fda83c7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_State_CaptainBarrierDeactivated = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_BarrierDeviceDialog:438a1006-6055-4385-a4c0-0fca3fda83c7
msgctxt "h600c28f8g74ecg4448ga045gd1788891a94d"
msgid "Make haste. We have business to conduct."
msgstr "서둘러라. 함께 처리해야 할 사안이 있으니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_BarrierDeviceDialog
#. Speaker = Kith'rak Therezzyn
#. NodeID = 4b363dca-a862-667d-4d88-84c9c4f187e4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_BarrierDeviceDialog:4b363dca-a862-667d-4d88-84c9c4f187e4
msgctxt "h3b342130gef78g48c5gbee4gf741380f70a2"
msgid "<i>Chk...</i> As you wish, <i>ch'r'ai</i>."
msgstr "<i>츠크...</i> 분부대로, <i>츠라이</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_BarrierDeviceDialog
#. Speaker = Kith'rak Therezzyn
#. NodeID = 76c3b653-fcb4-4283-b020-4182119ff219
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_BarrierDeviceDialog:76c3b653-fcb4-4283-b020-4182119ff219
msgctxt "h77324e15g92b7g41d8g81efg0a1b4bb5549d"
msgid "<i>Is'tark</i>... I will not have you sneaking through my crèche."
msgstr "<i>이스탁</i>... 내 양성소를 쥐새끼처럼 드나들게 두지 않겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_BarrierDeviceDialog
#. Speaker = Githyanki Barrier Disruptor
#. NodeID = b110c7ff-da18-4276-9c2b-711f10058910
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_BarrierDeviceDialog:b110c7ff-da18-4276-9c2b-711f10058910
msgctxt "hf21c9c19gdf12g44b8g85f9g83c5d068a96e"
msgid "Quiet, Therezzyn. I wish to speak with this one."
msgstr "조용, 테레진. 이 녀석과 대화를 나누고 싶군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = 001ff898-7998-bf25-88a1-ae924003b720
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:001ff898-7998-bf25-88a1-ae924003b720
msgctxt "h8b0f5159g0fe7g4995g8ff3g43e81d8e5e5c"
msgid ""
"<i>Chk.</i> A <i>kith'rak</i>'s time is precious. Waste it at your peril."
msgstr "<i>츠크.</i> 모든 <i>키스락</i>의 시간은 귀중하다. 최소한 위험은 각오하고 낭비하도록."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = 03f5021d-d96b-30ef-c7aa-674e9b9486b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:03f5021d-d96b-30ef-c7aa-674e9b9486b1
msgctxt "h8f83ba17g4e32g4990g95b0gacf539fd8db8"
msgid "A fortune in gold, vouched for by our queen herself."
msgstr "여왕 폐하께서 직접 보증하신 바, 온갖 금덩어리를 안겨주마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = 05c67138-f215-13af-bea6-c00742c5782e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:05c67138-f215-13af-bea6-c00742c5782e
msgctxt "hb640671fgb2d6g44d6g9fd1g585068e56bdb"
msgid "Does this <i>look</i> like an infirmary?"
msgstr "네 눈엔 이곳이 의무실로 <i>보이느냐</i>?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Player
#. NodeID = 1227f871-8d50-36e0-6c50-481de8012cd5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_ChainOfCommand_Knows_GithWantPuzzlebox = False
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_Knows_GithWantPuzzlebox = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:1227f871-8d50-36e0-6c50-481de8012cd5
msgctxt "h44cecadeg973fg470fg9e55g856b48fb3f98"
msgid "I need a description of the weapon you seek."
msgstr "너희가 찾는 무기에 대해 설명을 좀 듣고 싶군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = 188a257b-035f-8748-8d8d-f27ba419ee66
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:188a257b-035f-8748-8d8d-f27ba419ee66
msgctxt "h2b0a9fbbgf16bg4e8fg9d50g2049ea2740da"
msgid ""
"Only return if you <i>have</i> the weapon. I will not tolerate "
"insubordination."
msgstr "무기를 <i>수복해서</i> 돌아와라. 불복종은 용납하지 않겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Player
#. NodeID = 1b65d428-63b0-8869-da16-0401eaf1e040
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:1b65d428-63b0-8869-da16-0401eaf1e040
msgctxt "h39508545ged0eg4da6g99bfgcedaf5664631"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = 1d5effba-d0dd-516c-1317-aeb698cb897a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:1d5effba-d0dd-516c-1317-aeb698cb897a
msgctxt "hb6144bd8g66c6g40ddgb242gfc085e0124f8"
msgid ""
"You are forbidden to leave. Report to the Inquisitor at once. Deliver the "
"Prism."
msgstr "떠나는 것은 금지다. 당장 심문관께 보고해라. 프리즘을 가져다 드리도록."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Player
#. NodeID = 241654fd-a3cd-d1eb-b13a-efdf5746d81c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_ChainOfCommand_Knows_GithWantPuzzlebox = False
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_Knows_GithWantPuzzlebox = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:241654fd-a3cd-d1eb-b13a-efdf5746d81c
msgctxt "h31fafc10g2b2ag4965ga303g9a66cdfde9f7"
msgid "What does this weapon look like?"
msgstr "이 무기가 어떻게 생겼지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = 254ac96d-361f-fdf9-5fd6-928518085e78
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:254ac96d-361f-fdf9-5fd6-928518085e78
msgctxt "h98ea1107g2526g4582g8bddg14053af80bbf"
msgid "You would invoke rank? On a <i>kith'rak</i>? Pathetic, <i>vin'iisk</i>."
msgstr "감히 계급을 들먹이느냐? <i>키스락</i> 면전에서? 딱하구나, <i>비니스크</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Player
#. NodeID = 2c644dd5-1967-74fb-48de-a13e2214d75b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:2c644dd5-1967-74fb-48de-a13e2214d75b
msgctxt "he785ad78gfadfg460eg82bag10602f049aec"
msgid "Forgive me - I misspoke. There is no traitor."
msgstr "용서하십시오 - 잘못 짚었습니다. 배신자 따위는 없습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Player
#. NodeID = 2e80e140-9c0b-0c8b-9384-c42276663591
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:2e80e140-9c0b-0c8b-9384-c42276663591
msgctxt "h53fa917cg7d3eg4abag88e7gf9b1e04adc8e"
msgid "I have found the weapon we seek."
msgstr "우리가 찾고 있는 무기를 내가 찾아냈다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = 2f9c4101-a3e1-851b-a587-67def98b40f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:2f9c4101-a3e1-851b-a587-67def98b40f8
msgctxt "h26fbd836gd7f4g4ffbga75dg393b7877b683"
msgid ""
"You are mistaken. The hunt for the weapon is the Inquisitor's folly, not "
"mine - but it is not your place to question orders."
msgstr ""
"잘못 짚었다. 무기 수색 작업은 심문관의 바보짓이지, 내가 내린 명령이 아니다 - 그렇다고 네놈 따위가 왈가왈부할 문제도 아니지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = 31218861-37cc-0d95-13f4-6af310d33d4d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:31218861-37cc-0d95-13f4-6af310d33d4d
msgctxt "h3e7025d2gae49g49afg9f7fg2b0ba6b0e01c"
msgid ""
"You are not familiar to me, <i>ra'stil</i>. Do you bring news of the weapon?"
msgstr "익숙치 않은 얼굴이군, <i>라스틸</i>. 무기에 대한 소식을 가져왔느냐?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = 31bc6aaa-85be-1420-4598-dea87898058f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:31bc6aaa-85be-1420-4598-dea87898058f
msgctxt "h2ff60b72gcc42g4c07ga8e7gd41b44f48eed"
msgid ""
"Information. <i>Chk.</i> If it's not about the weapon we seek, I don't care."
msgstr "정보라. <i>츠크.</i> 우리가 찾고 있는 무기에 대한 게 아니라면, 관심 없다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = 35b5ab70-154d-eb00-2006-6b052d56af67
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:35b5ab70-154d-eb00-2006-6b052d56af67
msgctxt "h29157597g3385g49eeg9022g34656cf5c067"
msgid ""
"You ask <i>me</i>? I would relish nothing more than burning the <i>ghaik</i> "
"threat from this rock."
msgstr "<i>내게</i> 요청하는 거냐? 나는 이 바위 밑에 처박혀 <i>게이크</i>의 위협을 불태우는 순간을 고대하고 있다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = 35b5ab70-154d-eb00-2006-6b052d56af67
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:35b5ab70-154d-eb00-2006-6b052d56af67
msgctxt "hbc657c50g6d21g436cgacc7g090b2b0bdfba"
msgid "You are well informed. My crèche discovered the same."
msgstr "정보 수집 능력이 좋구나. 나의 양성소도 같은 내용을 발견했다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = 373dc817-795c-300b-0ccb-7f429088d16d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:373dc817-795c-300b-0ccb-7f429088d16d
msgctxt "h6a0da41bg2519g45b5g96dfgfdb8d7e3bc5e"
msgid ""
"Then learn to tame your tongue. I will ask one last time: <i>have you "
"brought the weapon?</i>"
msgstr "그렇다면 혀를 좀 더 잘 놀리는 법을 배워라. 마지막으로 묻겠다: <i>무기를 가져왔느냐?</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Player
#. NodeID = 3994b7ae-b0e7-b25b-a39f-9e132f8ec016
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:3994b7ae-b0e7-b25b-a39f-9e132f8ec016
msgctxt "hccc43e1fgd4acg491bgbc5dgcb91794160ff"
msgid "I have what you're looking for. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = 3d97daa3-e480-de29-02b7-0e69623f0129
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:3d97daa3-e480-de29-02b7-0e69623f0129
msgctxt "h8499886dg3868g460dgb1b4gd973c1725aae"
msgid ""
"Arrogance - a typical symptom of the <i>istik</i> condition. But an arrogant "
"tracker is a tracker nonetheless."
msgstr "오만하군. <i>이스틱</i>에게서 흔히 보이는 증상이지. 하지만 오만한 추적자라도 쓸모는 있을 터이니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Player
#. NodeID = 3f8b078a-3edd-52c0-068f-311d0e9f4a61
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:3f8b078a-3edd-52c0-068f-311d0e9f4a61
msgctxt "h90a47a25gadc7g441bg92b3g84842af9b37f"
msgid ""
"I have proof of the illithid invasion - it might help your Inquisitor to "
"rethink his priorities."
msgstr "일리시드 침공에 대한 증거를 가져왔다. 이걸로 너희 심문관이 우선순위를 재고하게 될지도 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = 41048d77-d353-78bd-e6b5-4ac7153c6a40
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:41048d77-d353-78bd-e6b5-4ac7153c6a40
msgctxt "hee2e79c1g3986g4229g8259g443fefef2dee"
msgid "The very same said to hold the weapon we seek."
msgstr "우리가 찾고 있는 무기를 들고 와서는 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = 44aef6b6-9d60-c2e0-7846-2bc29e44253b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:44aef6b6-9d60-c2e0-7846-2bc29e44253b
msgctxt "h10d0b845g7283g4353gb713gd25ce3e7d6f7"
msgid ""
"If you speak truth, the Inquisitor will reward you greatly. If you lie..."
msgstr "네가 사실을 말하고 있다면, 심문관이 후한 보상을 내리겠지. 만약 거짓이라면..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = 44f0c6ab-e1f1-9b86-cb05-c4908de6326d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:44f0c6ab-e1f1-9b86-cb05-c4908de6326d
msgctxt "h50c54e6ag1a68g4698g8b0dg7315b6511486"
msgid "<i>Hshar'lak</i> among us?"
msgstr "우리 중에 <i>흐샬락</i>이 있다니?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Player
#. NodeID = 47ad85bf-f2bf-a878-6c01-6e2fc5ccd63e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:47ad85bf-f2bf-a878-6c01-6e2fc5ccd63e
msgctxt "h4fdcfb56g1731g4902g9d22ge335e51202c9"
msgid "Your doctor."
msgstr "너희 의사다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = 48a59e6a-37fa-9e82-8a4b-bbc959381e1e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:48a59e6a-37fa-9e82-8a4b-bbc959381e1e
msgctxt "h88169cd4gc146g4d3cga6fage7a274c41f09"
msgid "Then squander my time no more. Go. Now."
msgstr "그럼 시간 낭비 하지 말고 당장 나가."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = 49000ce3-9457-6c03-8191-f6c8d14ea426
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:49000ce3-9457-6c03-8191-f6c8d14ea426
msgctxt "h2cc12319g24d5g44cfg9deag99940ceda9cb"
msgid "But I cannot imagine this is what our queen wants."
msgstr "허나 여왕께서 이런 일을 분부하셨을 거라고는 생각하지 않는다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = 4bc664bb-a882-49fb-4f17-6c59a24ca1a6
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:4bc664bb-a882-49fb-4f17-6c59a24ca1a6
msgctxt "h03e92840g82ecg4efeg9dc2gd07f2bd6b21d"
msgid ""
"<i>Chk</i> - vague allegations and undue demands. A poor introduction for an "
"unproven <i>vin'iisk</i>."
msgstr "<i>츠크</i> - 막연한 주장에 과분한 요구만 늘어놓는구나. 입증되지 않은 <i>비니스크</i>의 자기 소개는 잘 들었다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = 4bc664bb-a882-49fb-4f17-6c59a24ca1a6
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:4bc664bb-a882-49fb-4f17-6c59a24ca1a6
msgctxt "h9cd8958egd5c1g4183g95eag804a899ba2e6"
msgid ""
"<i>Chk</i> - vague allegations and undue demands. A poor introduction for an "
"unproven <i>istik</i>."
msgstr "<i>츠크</i> - 막연한 주장에 과분한 요구만 늘어놓는구나. 입증되지 않은 <i>빈'이스크</i>의 자기 소개는 잘 들었다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = 50768546-c4a2-eadd-2a14-62d301c079b7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_ChainOfCommand_HasMet_Captain(1) = True
#.   Global:
#.      - CRE_ChainOfCommand_State_TemplarResolved = False
#.      - CRE_ChainOfCommand_Event_CaptainDeactivatesBarrier = False
#.   Tag:
#.      - GITHYANKI(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:50768546-c4a2-eadd-2a14-62d301c079b7
msgctxt "hdab7d3cag622ag403dga66fgcef2115e4e16"
msgid ""
"I presume you are not stupid enough to return empty-handed. So give me the "
"weapon - now."
msgstr "설마 빈손으로 돌아올 만큼 멍청하진 않겠지. 그러니 무기를 내놔라 - 당장."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Player
#. NodeID = 52abf8ae-36ab-0cbe-1b1d-dcd282f005e5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:52abf8ae-36ab-0cbe-1b1d-dcd282f005e5
msgctxt "h40f22864g3cf8g4edeg82fagc749784f7c37"
msgid "I believe I have found the weapon we seek."
msgstr "우리가 찾던 무기를 발견한 것 같습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = GROUP_Daisy
#. NodeID = 54156515-deef-410e-a701-1903bd47d71f
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DAISY_MALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:54156515-deef-410e-a701-1903bd47d71f
msgctxt "h686e1626g9135g4b1fg8e76g0894056d84a2"
msgid "Don't tell her anything."
msgstr "그녀에게 아무것도 말하지 마세요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = GROUP_Daisy
#. NodeID = 54156515-deef-410e-a701-1903bd47d71f
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DAISY_FEMALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:54156515-deef-410e-a701-1903bd47d71f
msgctxt "h7c569baeg5e17g4783gab6eg841d51c279c4"
msgid "Don't tell her anything."
msgstr "그녀에게 아무것도 말하지 마세요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = 55295334-f802-e61e-6e99-9d3728be842d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:55295334-f802-e61e-6e99-9d3728be842d
msgctxt "he8e319a2gdd99g4216g8b44gd1d173e22dea"
msgid "Time is finite. As is my <i>patience</i>. Go."
msgstr "시간은 한정적이지. 내 <i>인내심</i>도. 가라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = 5643dec8-a088-1d6c-fa9b-8e7f9b39be3a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:5643dec8-a088-1d6c-fa9b-8e7f9b39be3a
msgctxt "h20956542g28eag422aga752gf6147247b217"
msgid "The <i>Jhe'stil Kith'rak</i>?"
msgstr "<i>제스틸 키스락</i> 말이냐?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = 577cf569-a6c4-39f3-713d-e502c9849b08
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:577cf569-a6c4-39f3-713d-e502c9849b08
msgctxt "h6b3e548fgb57fg4bf2gbc42gb40bdd40a895"
msgid "The Inquisition never explain themselves."
msgstr "심문관은 전혀 설명해 주지 않더군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = GROUP_Daisy
#. NodeID = 586f18bb-fdd2-fff3-0cd3-02acc258417d
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DAISY_MALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:586f18bb-fdd2-fff3-0cd3-02acc258417d
msgctxt "hf11c1c4fg1420g4c23g98cbg419ea9f6527a"
msgid "No. NO!"
msgstr "안 돼. 안 돼!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = GROUP_Daisy
#. NodeID = 586f18bb-fdd2-fff3-0cd3-02acc258417d
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DAISY_FEMALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:586f18bb-fdd2-fff3-0cd3-02acc258417d
msgctxt "h6ba2c67egea69g4240gb515g18578934bef5"
msgid "No. NO!"
msgstr "안 돼. 안 돼!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = 5b11e827-53dd-a8b6-69dc-3a5a9e12ddcc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_Event_CaptainDeactivatesBarrier = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:5b11e827-53dd-a8b6-69dc-3a5a9e12ddcc
msgctxt "hc370d33cgc4f4g40cag9730g7e2174c45f17"
msgid "Do not try to leave or it will be your death!"
msgstr "죽고 싶지 않다면 떠날 생각 마라!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Player
#. NodeID = 6eb0844e-be6f-77cc-de00-ac25397ab569
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:6eb0844e-be6f-77cc-de00-ac25397ab569
msgctxt "hfc53cf81g00f9g432fgb534g7949c73b979d"
msgid "What is so important about this weapon?"
msgstr "이 무기가 왜 그렇게 중요한가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Player
#. NodeID = 74659f32-233a-3004-f4b3-6eef86ff5bb4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_UpperGuards_State_GainedAccess = True
#.      - CRE_GithInfirmary_State_UsedDevice = False
#.   Object:
#.      - CRE_ChainofCommand_ToldReportToInfirmary(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:74659f32-233a-3004-f4b3-6eef86ff5bb4
msgctxt "hf40decc0g230eg4aacgb147g6258b60f2a90"
msgid "I was told to seek your infirmary."
msgstr "당신네 의무실로 찾아가라고 들었다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Player
#. NodeID = 76a408e3-8709-d856-2d3d-ad89c58bc019
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_Event_CaptainCombatStarts = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:76a408e3-8709-d856-2d3d-ad89c58bc019
msgctxt "h770cba89gd03fg4693g9d5egf2171701405d"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Player
#. NodeID = 791b091a-d1f1-f1f4-3c06-81961e8ef4f1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_State_ShowedBoxToCaptain = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:791b091a-d1f1-f1f4-3c06-81961e8ef4f1
msgctxt "hefd822bag8c2fg46e5gb654g3fcadc2cac72"
msgid "<i>Produce the artefact.</i>"
msgstr "<i>아티팩트를 보여준다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Narrator
#. NodeID = 798c609a-6b06-3c53-6afa-d0315ed49671
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_5 = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:798c609a-6b06-3c53-6afa-d0315ed49671
msgctxt "h573e03f0gad98g4b1bg95ceg56407b1026ec"
msgid ""
"*You sense Shadowheart's worry. This 'weapon' sounds like the artefact you "
"carry.*"
msgstr "*섀도하트의 걱정이 느껴집니다. 그녀가 설명하는 '무기'는 당신이 가지고 있는 아티팩트인 것 같습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = 7a42e39c-8d29-1335-4155-551fa6768849
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:7a42e39c-8d29-1335-4155-551fa6768849
msgctxt "hbd144107ge7abg4671g80b8g67b3a878bf54"
msgid "And yet your face betrays you. You found it, didn't you?"
msgstr "허나 네놈의 낯짝이 너를 부정하는구나. 무기를 찾았군, 그렇지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Player
#. NodeID = 7cc61393-b84e-c8d6-02ae-41488171f549
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:7cc61393-b84e-c8d6-02ae-41488171f549
msgctxt "h90f889cag8259g4c91g99e1gab1aa11f1bb6"
msgid "I have important information."
msgstr "중요한 정보가 있다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = 7d20c47b-d1e3-fdda-6a97-900ce00e78a7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_ChainOfCommand_HasMet_Captain(1) = True
#.   Global:
#.      - CRE_ChainOfCommand_State_TemplarResolved = False
#.      - CRE_ChainOfCommand_Event_CaptainDeactivatesBarrier = True
#.   Tag:
#.      - GITHYANKI(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:7d20c47b-d1e3-fdda-6a97-900ce00e78a7
msgctxt "heacaee0ag44a0g4836g8b26g0ba2d3870c46"
msgid "Finish your business here, and leave."
msgstr "볼 일이 있으면 빨리 끝내고, 나가라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = 7e3c0af9-9dbc-5b27-cdb0-3f93cd3836ab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:7e3c0af9-9dbc-5b27-cdb0-3f93cd3836ab
msgctxt "hd2da4b81g4a49g46a1gb0f1gf8d791ff923b"
msgid "The Inquisitor? On what grounds?"
msgstr "심문관을? 무슨 이유로?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = 7ee16d20-2900-f4df-e3c5-389361033483
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_Event_CaptainCombatStarts = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:7ee16d20-2900-f4df-e3c5-389361033483
msgctxt "heec62872gf8eag47a8g98a9g537ff71f8720"
msgid "Then our <i>ghustil </i>will study your corpse."
msgstr "그럼 우리 <i>거스틸</i>이 네 시체를 연구하겠구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = 8416f542-8cec-2c3a-4a6e-59b89122775f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_Event_CaptainDeactivatesBarrier = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:8416f542-8cec-2c3a-4a6e-59b89122775f
msgctxt "h50202985g079eg4e43g9b8eg27bfc2ede68f"
msgid "...Well. Inquisitor W'wargaz will ensure you do not bother me again."
msgstr "...좋다. 심문관 와르가즈가 네놈 같은 골칫거리를 잘 처리해 준다면야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Player
#. NodeID = 841814ca-8bfd-e0b6-a4cc-158274f01b71
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:841814ca-8bfd-e0b6-a4cc-158274f01b71
msgctxt "he7c8fe95g3e50g46b3g9ac7g2609f9ae1eb8"
msgid "Not yet."
msgstr "아니 아직."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Player
#. NodeID = 860206d4-a989-f7b9-8db9-737507e101c6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_UpperGuards_State_GainedAccess = True
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_Knows_GithWantPuzzlebox = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:860206d4-a989-f7b9-8db9-737507e101c6
msgctxt "h7dd76043g8e70g4576g97e5g433d66a933f1"
msgid ""
"I was granted entry by your sentries. They told me to seek the Inquisitor."
msgstr "당신네 초병들에게 허가 받았다. 심문관을 만나보라고 하더군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = 8671336b-f207-586a-1d31-dc6530618ff3
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:8671336b-f207-586a-1d31-dc6530618ff3
msgctxt "h6a9a5be0gaafag4495g8d05g44077a3d24b4"
msgid "It appears you have been chosen, <i>vin'iisk</i>. How lucky you are."
msgstr "무기의 선택을 받은 게 틀림없군, <i>빈이스크</i>. 운 좋은 줄 알거라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = 8671336b-f207-586a-1d31-dc6530618ff3
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:8671336b-f207-586a-1d31-dc6530618ff3
msgctxt "h274cdc62ga46dg4dddg8ecag7861c0cead93"
msgid ""
"It appears you have been chosen, <i>istik</i>. You are lucky it is not for "
"me to question why."
msgstr "무기의 선택을 받은 게 틀림없군, <i>이스틱</i>. 내가 이유를 묻지 않아 다행인 줄 알거라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = 869d954c-5244-9a81-b679-1721d904cdef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:869d954c-5244-9a81-b679-1721d904cdef
msgctxt "h47743c25g50c8g452fgb16fg6ac85b1b515e"
msgid "<i>You </i>manipulate it when <i>I</i> cannot?"
msgstr "<i>나도</i> 다루지 못하는 걸 어떻게 <i>너 따위가</i>?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Player
#. NodeID = 87603ee2-2938-703c-6354-696520a38191
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - Laezel_InParty_Event_AccusedDoctor = True
#.   Local:
#.      - 0aaac174-44ba-e075-70d4-7f10e837e915_MadeAccusation = False
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_Knows_GithWantPuzzlebox = True
#.   Local:
#.     - 0aaac174-44ba-e075-70d4-7f10e837e915_MadeAccusation = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:87603ee2-2938-703c-6354-696520a38191
msgctxt "h6f687ca1g3539g4f0eg97bag75ad5288dcd6"
msgid "I seek audience with your Inquisitor. There's a traitor among you."
msgstr "심문관과의 알현을 요청한다. 너희들 사이에 배신자가 있다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = 88f5ec7c-9117-8c3f-3e2f-dd55c66a6b28
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:88f5ec7c-9117-8c3f-3e2f-dd55c66a6b28
msgctxt "h0e83dfc3g2e77g4a95g9678g0131cbc3785d"
msgid "Whom would you accuse?"
msgstr "네가 고발하려는자가 누구지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Player
#. NodeID = 8cd4c8a3-bc7f-2c36-8f44-b7b8a3753edd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_Knows_GithWantPuzzlebox = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:8cd4c8a3-bc7f-2c36-8f44-b7b8a3753edd
msgctxt "h85a8411ag1a2dg46a5g8ca6g6a49186fb38d"
msgid "What does this weapon look like?"
msgstr "그 무기는 어떻게 생겼지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Player
#. NodeID = 8e52b437-4890-a6e3-a638-43a5e6902a23
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:8e52b437-4890-a6e3-a638-43a5e6902a23
msgctxt "hf5e1e451gbe22g4251g97b9gcb856878f74a"
msgid "I know nothing about the weapon."
msgstr "그 무기에 대해서는 알고 있는 게 없군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Player
#. NodeID = 91ff8bd5-deb5-233e-9991-745eca907d08
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:91ff8bd5-deb5-233e-9991-745eca907d08
msgctxt "h0351effcg214dg44e4g87dageeecd73b7557"
msgid "Weapon? I seek aid. We should be fighting the <i>ghaik</i> incursion."
msgstr "무기라니? 나는 도움을 찾아 왔다. 우리는 <i>게이크</i> 침공에 맞서 싸워야만 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = 94341583-8758-f589-0938-00f3480579c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:94341583-8758-f589-0938-00f3480579c8
msgctxt "h046c2ffcg309dg4cbbg8d83gc34b44ac7df1"
msgid ""
"I have business to attend to. Return with the weapon, or do not return at "
"all."
msgstr "내겐 따로 신경써야 할 일이 있다. 무기를 가지고 복귀하거나 아예 돌아오지 마라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = 96801544-7a9b-dbdd-4e62-c48069564f10
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:96801544-7a9b-dbdd-4e62-c48069564f10
msgctxt "h55abe3b7gc4dbg4067gb2feg553e9ec1d884"
msgid ""
"We know infected flock to Moonrise Towers. I reported the gathering masses "
"back to Tu'narath."
msgstr "우리 역시 감염자 군세가 문라이즈 타워로 향하고 있다는 사실을 알고 있다. 집결 중인 병력에 관해 튜나라쓰에 보고했지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Player
#. NodeID = 9ddfeabe-9d64-5f30-892f-edb545b03ebf
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_Knows_GithWantPuzzlebox = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:9ddfeabe-9d64-5f30-892f-edb545b03ebf
msgctxt "h7b2f6d7dg5e19g4431g84fdgb15435e002f4"
msgid "Maybe I can help you find the weapon."
msgstr "어쩌면 내가 무기를 찾는 데 도움을 줄 수도 있겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Player
#. NodeID = 9ea63f7c-ada5-db1c-b8d8-bd6a54088745
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_State_ShowedBoxToCaptain = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:9ea63f7c-ada5-db1c-b8d8-bd6a54088745
msgctxt "h361230ebg7735g4f13ga9f8g689ccb2b4be3"
msgid "<i>Produce the artefact.</i>"
msgstr "<i>아티팩트를 보여준다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = 9ffbf5d5-5426-94d3-2d3b-2c154b18f5a4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:9ffbf5d5-5426-94d3-2d3b-2c154b18f5a4
msgctxt "h6f3a70aegc4fcg4936g9f9bgbe6f332390d1"
msgid "Meanwhile, illithid <i>sickness</i> spreads right in front of us."
msgstr "그러는 동안 일리시드 <i>질병</i>이 우리 코앞까지 확산되고 있다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = a13f5a92-a2b6-da20-64d4-cc2744ad82ac
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_ChainOfCommand_HasMet_Captain(1) = True
#.   Global:
#.      - CRE_ChainOfCommand_State_TemplarResolved = False
#.      - CRE_ChainOfCommand_Event_CaptainDeactivatesBarrier = False
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:a13f5a92-a2b6-da20-64d4-cc2744ad82ac
msgctxt "hac7c8be6g4a19g469fga153g0ae7ee6bcdcf"
msgid "You have returned. Any news of the weapon?"
msgstr "돌아왔군. 무기에 대한 소식은 있나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Player
#. NodeID = a16e11b2-3311-64cb-32c9-faa9c9ed9b85
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:a16e11b2-3311-64cb-32c9-faa9c9ed9b85
msgctxt "h73ad2015gbe1fg4e9fg8c84g557a2ec4ddbf"
msgid "I will not."
msgstr "싫다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = a2593ee8-0366-9fec-dbe4-5669feb43ecd
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:a2593ee8-0366-9fec-dbe4-5669feb43ecd
msgctxt "hbcc9be1eg6704g4049gbea6g03f5a903e46e"
msgid ""
"<i>Chk</i> - a strong accusation from the mouth of a <i>vin'iisk</i>. The "
"very same said to hold the weapon we seek."
msgstr "<i>츠크</i>, 우리가 찾는 무기를 들고는 <i>비니스크</i>의 입으로 잘도 비난하는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = a2593ee8-0366-9fec-dbe4-5669feb43ecd
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:a2593ee8-0366-9fec-dbe4-5669feb43ecd
msgctxt "he39a0815g1315g4178g8f74g344649e087f5"
msgid ""
"<i>Chk</i> - a strong accusation from the mouth of an <i>istik</i>. The very "
"same said to hold the weapon we seek."
msgstr "<i>츠크</i>, 우리가 찾는 무기를 들고는 <i>비니스크</i>의 입으로 잘도 비난하는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Player
#. NodeID = a2e82569-24fd-31f2-82a7-6f85da0b1275
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:a2e82569-24fd-31f2-82a7-6f85da0b1275
msgctxt "h5a36d2c8gcd76g46d8ga08bgd6b3261ea072"
msgid "I think I have what you're looking for."
msgstr "당신이 찾는 걸 내가 가지고 있는 것 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = a53162f4-94fb-74b2-fdba-4c4c26ff08ff
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_ChainOfCommand_HasMet_Captain(1) = False
#.   Global:
#.      - CRE_ChainOfCommand_State_TemplarResolved = False
#.      - CRE_ChainOfCommand_Event_CaptainDeactivatesBarrier = False
#.   Tag:
#.      - GITHYANKI(1) = False
#. SetFlags:
#.   Dialog:
#.     - CRE_ChainOfCommand_HasMet_Captain(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:a53162f4-94fb-74b2-fdba-4c4c26ff08ff
msgctxt "h8766a79fge489g4231ga9edg23b835780f11"
msgid ""
"An <i>istik</i>. In my crèche. You are one of the mercenaries sent to bring "
"the weapon?"
msgstr "<i>이스틱</i>이군. 내 양성소 안에 말이야. 무기를 가져오라고 보냈던 용병이냐?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Shadowheart
#. NodeID = ac00796b-c80a-de29-08e4-0a5362614984
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:ac00796b-c80a-de29-08e4-0a5362614984
msgctxt "h5930554cg2412g400fg92d6ge3ccf2fa97b8"
msgid "I sincerely hope you know what you're doing..."
msgstr "네가 무슨 짓을 하고 있는지 인지하고 있기를 진심으로 바라..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Player
#. NodeID = ac09bc4f-58ab-dce7-532c-f30aa3cd1555
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - RANGER(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:ac09bc4f-58ab-dce7-532c-f30aa3cd1555
msgctxt "hbf45289cg924dg4724gacedgcf9bc26f8481"
msgid ""
"I am no mercenary, but I am a good tracker. Describe the weapon - I can help "
"you."
msgstr "용병은 아니지만, 추적에는 능숙하지. 무기에 대해 설명해 줘. 내가 도울 수 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Player
#. NodeID = ac3eaa15-9cc7-9500-4ab1-59c88ba6758f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:ac3eaa15-9cc7-9500-4ab1-59c88ba6758f
msgctxt "hc5783632gfdc6g409fga9b4gd0a591e8a092"
msgid "I do not. My apologies."
msgstr "없어. 미안하군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Player
#. NodeID = ac73612d-b819-316d-6d22-340e57530fbb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:ac73612d-b819-316d-6d22-340e57530fbb
msgctxt "h16efdda2g817ag4d56gaeadg70d6f1d10a9b"
msgid "No."
msgstr "싫어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = acc74930-7755-f3f4-8c4a-1aca8cc4cb4d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:acc74930-7755-f3f4-8c4a-1aca8cc4cb4d
msgctxt "h6177a6f3g649fg4226ga567ga14951fb8cdd"
msgid "<i>Tsk'va! </i>Trickery, heresy, how did you -"
msgstr "<i>츠크바! </i>속임수다, 이단이다, 어찌 네놈이 -"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = ace892ac-be44-1f9f-b149-b6e4f75afb55
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:ace892ac-be44-1f9f-b149-b6e4f75afb55
msgctxt "h1338d843ga0dcg4115gaf59g09e9b2ef389e"
msgid "Still, perhaps you've heard of it. Tell me, does this sound familiar?"
msgstr "뭐, 어쩌면 네놈도 들어봤을지 모르지. 말해 봐라, 익숙하게 들리나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = ae4e40bd-a67b-bca0-1301-947a3609cbab
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:ae4e40bd-a67b-bca0-1301-947a3609cbab
msgctxt "h2ebd20e1gc01cg4f8bg90a4g968ad5e5ecbc"
msgid "Then why, <i>ra'stil</i>, do you waste my time?"
msgstr "그렇다면 <i>라스틸</i>, 뭐 때문에 내 시간을 잡아먹고 있는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = ae4e40bd-a67b-bca0-1301-947a3609cbab
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:ae4e40bd-a67b-bca0-1301-947a3609cbab
msgctxt "h6704aec3g12adg4310gb51fg04c54f2e1fa4"
msgid "Then stop wasting my time, <i>istik</i>."
msgstr "그럼 내 시간을 잡아먹지 마라, <i>이스틱</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = af3bbfcb-7b48-1efe-4753-9087914b0d3a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_Event_CaptainDeactivatesBarrier = True
#. TagRule: GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:af3bbfcb-7b48-1efe-4753-9087914b0d3a
msgctxt "hc1b1a716g5b1dg475fga02bgd50be9f1c2df"
msgid "Take the weapon yourself, then. Seek the <i>ch'r'ai</i> below."
msgstr "직접 무기를 가져가도록, <i>츠라이</i>는 아래층에 계신다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = af3bbfcb-7b48-1efe-4753-9087914b0d3a
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_Event_CaptainDeactivatesBarrier = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:af3bbfcb-7b48-1efe-4753-9087914b0d3a
msgctxt "hee58b7fag9181g4738gaaf5g0ff2d87ba0c8"
msgid "Go, seek the Inquisitor below. And take the cursed thing with you."
msgstr "가, 아래층의 심문관을 찾아뵈어라. 그 망할 것도 같이."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Player
#. NodeID = b300599a-f1a1-7f11-ca73-5d821b921815
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_State_EnteredCrecheInfirmary = True
#.      - CRE_GithInfirmary_State_UsedDevice = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:b300599a-f1a1-7f11-ca73-5d821b921815
msgctxt "h9c532b66g3b1ag469dg983fg521edc460677"
msgid "I'm to report to your infirmary for investigation."
msgstr "귀공의 의무실로 가서 조사를 받으라고 했습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = b5b66abf-696d-d9ea-f8a8-5aa93afb8556
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:b5b66abf-696d-d9ea-f8a8-5aa93afb8556
msgctxt "h8ebf135cgdf73g4601g9356gbd3c9da802c2"
msgid ""
"Inquisitor W'wargaz has the Queen's ear, so we have no choice but to follow "
"him in this folly."
msgstr "심문관 와르가즈는 여왕의 귀나 다름없으니, 그를 따라 이 어리석은 작업에 동참할 수밖에 없다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Player
#. NodeID = b73f0751-d3ec-b4ba-4a94-304dbfd7cfe1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:b73f0751-d3ec-b4ba-4a94-304dbfd7cfe1
msgctxt "ha5c11429gd919g4e3agbb0bgd1ca96aafc9f"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Player
#. NodeID = b9ed8fe1-c56f-c32d-1204-0ab237e0493d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:b9ed8fe1-c56f-c32d-1204-0ab237e0493d
msgctxt "h54e3398ag4386g4121g83dag037bf0e8ec71"
msgid "I don't know anything about it."
msgstr "그에 관해서는 알고 있는 게 없다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = bb392158-212d-6479-6252-81995201bfc0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:bb392158-212d-6479-6252-81995201bfc0
msgctxt "h0f9085cbg941cg4803ga41agf69b0142604a"
msgid "What was that look? You know something. Do you <i>have</i> it?"
msgstr "그 표정은 뭐지? 뭔가 알고 있군. 네가 <i>가지고</i> 있나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Player
#. NodeID = bbb313c6-f7d5-96cf-f9f0-d1952794f483
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:bbb313c6-f7d5-96cf-f9f0-d1952794f483
msgctxt "h6f60113fga9b9g4c4cgad17g020146cad5ee"
msgid "What is so important about this weapon?"
msgstr "이 무기가 왜 그렇게 중요한가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Narrator
#. NodeID = bc033982-2040-76ab-37cb-d65509ed1ff1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_5 = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:bc033982-2040-76ab-37cb-d65509ed1ff1
msgctxt "hd8a26c04g3fb6g41efg8df3g5a1c38c64ff2"
msgid "*You realise she seeks the artefact you carry.*"
msgstr "*그녀가 찾고 있는 무기가 바로 당신이 가진 아티팩트라는 것을 깨달았습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Player
#. NodeID = bc442888-1ec3-5f2a-8970-1f68997e1ff3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_GithChokepoint_Event_ConfrontationStarts = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:bc442888-1ec3-5f2a-8970-1f68997e1ff3
msgctxt "h549d3cc8g9483g42d7g9d28gb9b8d9a8dbee"
msgid "Kith'rak Voss."
msgstr "키스락 보스."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = bcf422fd-99ed-7249-7e71-95b22b9eb6a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:bcf422fd-99ed-7249-7e71-95b22b9eb6a8
msgctxt "h6d5b96a8g923bg4591ga180ga2d4d7182fb2"
msgid ""
"Yes - there it is. Exactly as described. The inquisition will finally come "
"to an end."
msgstr "좋아 - 거기 있었군. 과연 들었던 모습 그대로 생겼어. 심문이 드디어 끝을 보겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = bf649335-d99f-0ed8-255e-c7599372c7a9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:bf649335-d99f-0ed8-255e-c7599372c7a9
msgctxt "h1691a99bg9cd1g4058gbb0egd14d6df9f34a"
msgid "I do not know - this hunt is the Inquisitor's folly, not mine."
msgstr "나도 모른다 - 이 수색 작업은 심문관의 바보짓이지, 내 지시가 아니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Player
#. NodeID = c1435ec4-df24-31dc-3b2a-2b5338e7b1ce
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_Knows_GithWantPuzzlebox = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:c1435ec4-df24-31dc-3b2a-2b5338e7b1ce
msgctxt "hdf097a46gec30g4189g8f07gac93a9623b5b"
msgid "If the Inquisition seeks this weapon, it must be vital. Tell me of it."
msgstr "심문관이 이 무기를 찾고 있다면, 분명 중대한 일이겠군. 설명을 듣고 싶다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Lae'zel
#. NodeID = c39d3a57-6d79-4b77-86a1-2ad5f3d628c8
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:c39d3a57-6d79-4b77-86a1-2ad5f3d628c8
msgctxt "h93f7026ege5fbg45c8gad18g3b92b18780e8"
msgid "He speaks the truth, <i>kith'rak</i>."
msgstr "이자는 진실을 고하고 있습니다, <i>kith'rak</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Lae'zel
#. NodeID = c39d3a57-6d79-4b77-86a1-2ad5f3d628c8
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:c39d3a57-6d79-4b77-86a1-2ad5f3d628c8
msgctxt "h6a1fc11dg71c0g4cd5g8c74ga53191cd5210"
msgid "She speaks the truth, <i>kith'rak</i>."
msgstr "이자는 진실을 고하고 있습니다, <i>kith'rak</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Lae'zel
#. NodeID = c39d3a57-6d79-4b77-86a1-2ad5f3d628c8
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:c39d3a57-6d79-4b77-86a1-2ad5f3d628c8
msgctxt "h4c2f2b7cgeb53g482cg9213gc9a40a9aa67f"
msgid "They speak the truth, <i>kith'rak</i>."
msgstr "이자는 진실을 고하고 있습니다, <i>kith'rak</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = c49df6d8-cc8f-665c-a778-f165bc9865ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:c49df6d8-cc8f-665c-a778-f165bc9865ed
msgctxt "h5eca2a22g433eg45a9g9bacg1839bf24839a"
msgid ""
"It is small. Angular. Metal. Adorned with <i>tir'su</i> script. Stolen by "
"'True Soul' heretics."
msgstr "작고 각진 금속 물체다. <i>티어수</i> 문자로 뒤덮여 있지. '참된 영혼' 놈들에게 도난당했다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = c7fc03ff-482d-c692-c4e2-b6f6dcfaf19b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_ChainOfCommand_HasMet_Captain(1) = True
#.   Global:
#.      - CRE_ChainOfCommand_State_TemplarResolved = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:c7fc03ff-482d-c692-c4e2-b6f6dcfaf19b
msgctxt "hb506f4bagfe62g42dcg9acdg158035828726"
msgid ""
"Using my room as a thoroughfare is an indignity. Disturbing me is an "
"<i>insult</i>. Begone."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = c862c606-9860-dd45-7c79-d81c4fce374e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:c862c606-9860-dd45-7c79-d81c4fce374e
msgctxt "h5f51facbgeb29g41fcgb974g6f267d6f1751"
msgid "We have all the proof we need and it has not moved his resolve."
msgstr "증거라면 필요한 만큼 가지고 있다. 허나 무엇도 그의 결심을 바꿔 놓지는 못했다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = cb5c0ce4-a0eb-df8b-cb87-aff906f5632c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:cb5c0ce4-a0eb-df8b-cb87-aff906f5632c
msgctxt "h403af282g7f0cg4aa8g805bg03fd30ae7930"
msgid "The <i>ghustil</i>?"
msgstr "<i>거스틸</i> 말이냐?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = cbd75a0b-e659-e73f-067e-216a175e1668
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_Event_CaptainCombatStarts = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:cbd75a0b-e659-e73f-067e-216a175e1668
msgctxt "h540024aagd48eg440bg87cdg441c2e15fbc0"
msgid "You are here to - no. You are here to die."
msgstr "이곳에 뭐 - 됐다. 죽을 자리를 찾아왔구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = ccd73a3b-7722-c460-eaee-194539ec8a8e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:ccd73a3b-7722-c460-eaee-194539ec8a8e
msgctxt "h5036b2e9gf127g4dafgbe78g131665e128fd"
msgid "You <i>are</i> one of the mercenaries we engaged, are you not?"
msgstr "<i>너는</i> 우리와 계약한 용병들 가운데 하나로군, 아닌가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = cffe3ed9-5be5-3b24-d429-faefa1567dca
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_ChainOfCommand_HasMet_Captain(1) = False
#.   Global:
#.      - CRE_ChainOfCommand_State_TemplarResolved = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:cffe3ed9-5be5-3b24-d429-faefa1567dca
msgctxt "h72a7a378g0383g4f59g805agf833d36a8f49"
msgid "You must have impressed him, to be let out so readily."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Player
#. NodeID = d37d0d2f-d5b8-ecd0-749f-31a5a73c4677
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:d37d0d2f-d5b8-ecd0-749f-31a5a73c4677
msgctxt "h3a7fbcfeg4561g4a1cga370gfaba92ebdceb"
msgid "What's the reward again?"
msgstr "보상이 어떻게 된다고 했지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Player
#. NodeID = d707d6c8-b863-3cbc-4023-a3f92dc28103
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:d707d6c8-b863-3cbc-4023-a3f92dc28103
msgctxt "hdd3021ecga3ffg4327g8440gac6083d75556"
msgid "Where is the infirmary, then?"
msgstr "그럼 의무실은 어느 방향입니까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Narrator
#. NodeID = d774b1d5-8729-1ee6-ae99-3390b569fc0f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_InfernalBox_State_CharacterHasBox(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_InfernalBox_Event_ForceGiveBox(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:d774b1d5-8729-1ee6-ae99-3390b569fc0f
msgctxt "he99a31eeg30bdg42deg9368g78d7b5352dd9"
msgid ""
"*She seeks the artefact you carry - the artefact now nestled in your pocket, "
"that doesn't want to be relinquished.*"
msgstr ""
"*그녀는 당신이 운반 중인 유물을 찾고 있습니다 - 유물은 당신의 주머니 속에 포근히 안겨 있고, 넘겨지기를 원치 않는 듯 보입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = d85f31c1-f7d1-efda-8b55-208f69b6b6a3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_Event_CaptainCombatStarts = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:d85f31c1-f7d1-efda-8b55-208f69b6b6a3
msgctxt "hf2249eb7g67c6g4c6ag98cag4825242e0978"
msgid "I'll gladly see you try. <i>Htak'a!</i>"
msgstr "기꺼이 맞아주지. <i>흐타카!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Lae'zel
#. NodeID = d915e318-1b82-4598-8712-30776073fffd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 0aaac174-44ba-e075-70d4-7f10e837e915_LaezelInclusion1 = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:d915e318-1b82-4598-8712-30776073fffd
msgctxt "hacb43b4bgf5cdg4b62g945ag8ec28aff321b"
msgid "The <i>istik</i> is with me, honoured <i>kith'rak</i>."
msgstr "제가 인솔하는 <i>이스틱</i>입니다, 명예로운 <i>키스락</i>이시여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Player
#. NodeID = d9533b59-16f3-61ed-6375-0785f6af6c8f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_ChainOfCommand_Knows_GithWantPuzzlebox = False
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_Knows_GithWantPuzzlebox = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:d9533b59-16f3-61ed-6375-0785f6af6c8f
msgctxt "h99c554e0g9b12g45aega493gd564efdf37cf"
msgid "Can you give me a description of the weapon you seek?"
msgstr "찾고 있는 무기를 설명해 줄 수 있겠습니까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = da401746-b355-a2d7-9369-dd1ae4aaeef8
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:da401746-b355-a2d7-9369-dd1ae4aaeef8
msgctxt "h6297520dgf80eg4177g8b95g32abfcb1ec70"
msgid ""
"The <i>ghustil</i>'s office is past the dormitories. Go, <i>vin'iisk</i>."
msgstr "<i>거스틸</i>의 사무실은 기숙사를 지나서 있다. 가 보거라, <i>비니스크</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = da401746-b355-a2d7-9369-dd1ae4aaeef8
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:da401746-b355-a2d7-9369-dd1ae4aaeef8
msgctxt "h4f094fb9gd54fg4570gae54g40558009ea50"
msgid ""
"Our healer's office is past the dormitories. Go, before I send you as a "
"corpse."
msgstr "우리 치료사의 사무실은 기숙사를 지나서 있다. 가거라, 시체로 만들어서 보내기 전에."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = da5ac4ea-846c-f67c-5b30-54b85b275e87
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:da5ac4ea-846c-f67c-5b30-54b85b275e87
msgctxt "h41935c71g1090g4936gacc2g6f5d4e0ff213"
msgid "<i>Ch'mar zal'a Vlaakith!</i> Give it to me."
msgstr "<i>츠마르 잘라 블라키스!</i> 내게 넘겨라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = dc33aa85-d9d6-de96-3934-e0c38a120d3c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_ChainOfCommand_State_TemplarResolved = False
#.      - CRE_ChainOfCommand_Event_CaptainDeactivatesBarrier = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:dc33aa85-d9d6-de96-3934-e0c38a120d3c
msgctxt "heda62ec5g4287g49d7gbb6ag7cdbf79fcd47"
msgid "You have orders. See them done."
msgstr "명령에 안 따르고 뭘 미적거리나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Player
#. NodeID = dd84335f-bf71-0eeb-f3a1-96b8e313b777
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:dd84335f-bf71-0eeb-f3a1-96b8e313b777
msgctxt "hec3ca550gc896g4252gb109gf7d29a351e6f"
msgid "Sure I have a weapon. Want to see your blood on it?"
msgstr "무기라면 물론 있어. 거기에 네 피를 좀 묻혀볼까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Player
#. NodeID = ddd99237-6299-f55e-1257-bce03f74aa74
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:ddd99237-6299-f55e-1257-bce03f74aa74
msgctxt "hd752b3edgdad2g4280g9bbag0645a78dfd76"
msgid "Of course. I will be back on the search immediately."
msgstr "물론이다. 지금 바로 수색 작업에 복귀하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = de6e8c50-263f-f704-2440-6048a46446ab
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_Event_CaptainCombatStarts = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:de6e8c50-263f-f704-2440-6048a46446ab
msgctxt "h034fc6d4ge5edg41e7gb257g4f5f6b490317"
msgid "No? Then I will take it from your corpse."
msgstr "싫다고? 그럼 네 시체에서 가져가도록 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = e0bca7ac-768a-3dbb-04ac-ce7dc05d94e1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 0aaac174-44ba-e075-70d4-7f10e837e915_LaezelInclusion1 = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:e0bca7ac-768a-3dbb-04ac-ce7dc05d94e1
msgctxt "h001ae8f4g6a72g4109gb482g23cc8372b3b4"
msgid ""
"So noted. But my question goes unanswered. <i>Do you bring the weapon?</i>"
msgstr "그래 보이는구나. 허나 내 질문에 대한 답은 아직 듣지 못했다. <i>무기를 가져왔나?</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Player
#. NodeID = e21be5a3-17d1-2744-58e1-cd84389c0e42
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:e21be5a3-17d1-2744-58e1-cd84389c0e42
msgctxt "h755a0d3fg9eb6g48afg9df1gbd3cdd12e52b"
msgid "Here it is."
msgstr "여기 있다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Player
#. NodeID = e483fc9a-9c2c-ef7a-a5f8-0bcdf49bb678
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_UpperGuards_State_GainedAccess = True
#.      - CRE_ChainOfCommand_Knows_GithWantPuzzlebox = False
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_Knows_GithWantPuzzlebox = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:e483fc9a-9c2c-ef7a-a5f8-0bcdf49bb678
msgctxt "ha95b60bdg41f0g4fd2g9694g1300916738fb"
msgid "Your sentries thought I could be of use to the Inquisitor."
msgstr "네 보초들은 내가 심문관께 도움이 될 거라 판단하더군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Player
#. NodeID = e769b779-1982-ea98-b52e-71026586b118
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:e769b779-1982-ea98-b52e-71026586b118
msgctxt "h7383cabag342fg4b91ga7e4g736a110c77de"
msgid "What I know can only be heard by the Inquisitor. You must let me pass."
msgstr "내가 갖고 있는 정보는 오직 심문관만이 알 수 있다. 길을 비켜라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Player
#. NodeID = e8088e78-8306-d2e1-c4d4-3696094d2ec0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:e8088e78-8306-d2e1-c4d4-3696094d2ec0
msgctxt "h1bbd4c1bg8c61g4874g9435ge5502e3d70df"
msgid ""
"There's a <i>mind flayer invasion </i>in progress. Why is that not your "
"priority?"
msgstr "<i>마인드 플레이어들의 침공</i>이 진행 중이다. 어째서 그게 우선순위가 아니지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Lae'zel
#. NodeID = e8b23578-b2e4-49b3-b44b-89df29abf88b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:e8b23578-b2e4-49b3-b44b-89df29abf88b
msgctxt "h6b4c81b3g806bg4dddga5a6g0031a07e2b22"
msgid "Honoured <i>kith'rak</i>. May Vlaakith show us truth."
msgstr "명예로운 <i>키스락</i>이시여. 블라키스께서 길을 밝혀 주시기를."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = GROUP_Daisy
#. NodeID = eb8d3b6d-0172-48ae-a99c-0522a7352a97
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DAISY_MALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:eb8d3b6d-0172-48ae-a99c-0522a7352a97
msgctxt "h72c0637fgcd8dg4971g88b7g247a5554f62c"
msgid "I told you, they will stop at nothing to reclaim it."
msgstr "말해드렸잖아요, 이 자들은 그걸 되찾을 때까지 멈추지 않을 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = GROUP_Daisy
#. NodeID = eb8d3b6d-0172-48ae-a99c-0522a7352a97
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DAISY_FEMALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:eb8d3b6d-0172-48ae-a99c-0522a7352a97
msgctxt "h6e35ad81ga14ag44fbgba1cg012cb6c1f068"
msgid "I told you, they will stop at nothing to reclaim it."
msgstr "말해드렸잖아요, 이 자들은 그걸 되찾을 때까지 멈추지 않을 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Player
#. NodeID = eecc4753-abce-4ec2-1a9f-d4e11168c5b0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - FIGHTER(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:eecc4753-abce-4ec2-1a9f-d4e11168c5b0
msgctxt "h614454b3ge5a5g42e5g93e5gc49d71c626c6"
msgid ""
"To value a mere weapon so much is pure vanity. You should worry more about "
"your warriors."
msgstr "무기 하나를 그토록 애지중지하는 것은 허영심에 지나지 않는다. 귀관은 귀관의 전사들을 더 걱정해야 한다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = f4ee4e03-c240-b298-502a-522a3aa26474
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:f4ee4e03-c240-b298-502a-522a3aa26474
msgctxt "h9cc6dfa4g5e0fg4750g9625g11b8b8ae7c31"
msgid ""
"By command of the Inquisition, you are ordered to join in our search. Return "
"with the weapon, or do not return at all."
msgstr "심문관의 명에 따라, 너는 우리 수색 작업에 가담해야 한다. 무기를 가져올 게 아니라면 아예 돌아오지 마라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Player
#. NodeID = f70ab2a5-9415-1982-4d8a-82d3f3f02019
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:f70ab2a5-9415-1982-4d8a-82d3f3f02019
msgctxt "h78456cdcg49e1g46b0g9e72g7a154a1f6d49"
msgid "That is only for your Inquisitor to know. Take me to him."
msgstr "너희 심문관에게 알려야 할 내용이다. 안내해라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Player
#. NodeID = f923eb5c-b1e6-08a1-baf1-dde7b9eb1a2a
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:f923eb5c-b1e6-08a1-baf1-dde7b9eb1a2a
msgctxt "h9e2e8a7cgd394g4303gad4ag8cf3a5e25e8a"
msgid "I've not found it <i>yet</i> - but I'm close. I just need more time."
msgstr "<i>아직</i> 못 찾았습니다 - 하지만 거의 근접했습니다. 조금만 더 시간을 주십시오."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = f95eb85b-ca5d-8ea0-b22c-aa4354bdcbc3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:f95eb85b-ca5d-8ea0-b22c-aa4354bdcbc3
msgctxt "h13300208g163ag47e4gbd3ag72fe54b599d6"
msgid ""
"In response, they sent an Inquisitor. Instead of ordering an assault, we "
"were told to join in this mad hunt for an ancient relic."
msgstr ""
"이에 대한 조치로, 수도에서 심문관을 파견했다. 돌격 명령을 내리는 대신 고대 유물을 찾는 정신 나간 수색 작업에 가담하라 이르더군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = f9d8a098-a9c2-d862-7989-7702cdee8368
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:f9d8a098-a9c2-d862-7989-7702cdee8368
msgctxt "hdd6075fegf9dag47d7g98d7g3716c32bdbd0"
msgid "Perhaps. Tell me, <i>ra'stil</i>, does this sound familiar?"
msgstr "어쩌면. 말해 봐라, <i>라스틸</i>, 어딘가 익숙하게 들리지는 않나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Kith'rak Therezzyn
#. NodeID = f9d8a098-a9c2-d862-7989-7702cdee8368
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:f9d8a098-a9c2-d862-7989-7702cdee8368
msgctxt "h7046cf96g992fg4fc6gb78dg687692a039a6"
msgid "Tell me, <i>istik</i>, does this sound familiar?"
msgstr "어쩌면. 말해 봐라, <i>이스틱</i>, 어딘가 익숙하게 들리지는 않나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain
#. Speaker = Player
#. NodeID = feafb8b7-a8c7-d3a8-8f22-1a92910298fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_Captain:feafb8b7-a8c7-d3a8-8f22-1a92910298fc
msgctxt "hc3dacf79g5060g4c16g8b01gf41926abc26f"
msgid "Not exactly. I'm here to loot the place."
msgstr "조금 다르지. 난 이곳을 털러 왔거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_CaptainSpeaksToTemplar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 06b8e905-4231-b3dc-a05c-221b80d3056f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_CaptainSpeaksToTemplar:06b8e905-4231-b3dc-a05c-221b80d3056f
msgctxt "h25e6ee74gd1a4g4db0gb214g06fdaeed50ef"
msgid "Find the Astral Prism, Therezzyn - my patience falters."
msgstr "아스트랄 프리즘을 찾아라 테레진. 내 인내심이 사라지고 있다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_CaptainSpeaksToTemplar
#. Speaker = Kith'rak Therezzyn
#. NodeID = 1510ff25-d11b-c874-605f-888d69fb59f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_CaptainSpeaksToTemplar:1510ff25-d11b-c874-605f-888d69fb59f1
msgctxt "h186af5b8gafd4g48dfga2a2g4c23add705e4"
msgid "You heard him! GO."
msgstr "다들 들었지, <b>가라!</b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_CaptainSpeaksToTemplar
#. Speaker = Kith'rak Therezzyn
#. NodeID = 2756b818-c82b-0b17-0668-4efcdc046a0f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_State_StartedCaptain = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_CaptainSpeaksToTemplar:2756b818-c82b-0b17-0668-4efcdc046a0f
msgctxt "h5a071febg5be9g4aa4gbf66g3df14bfbce14"
msgid "Please, <i>ch'r'ai</i>, I can explain..."
msgstr "<i>츠라이</i>시여, 설명드리겠습니다..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_CaptainSpeaksToTemplar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 4d01afbd-0972-da80-62c4-5b23b94acd64
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_Event_CaptainWalkToBarrierControl = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_CaptainSpeaksToTemplar:4d01afbd-0972-da80-62c4-5b23b94acd64
msgctxt "h3932a112g288fg4cbfgbcbcg139dac79d069"
msgid "<i>For now.</i>"
msgstr "<i>아직까진 말이지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_CaptainSpeaksToTemplar
#. Speaker = Kith'rak Therezzyn
#. NodeID = 617683d7-557d-cb3f-6cc8-44679895ef10
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_CaptainSpeaksToTemplar:617683d7-557d-cb3f-6cc8-44679895ef10
msgctxt "hc44417f9gd979g421cg93e9ge989171fcb4d"
msgid "Yes, <i>ch'r'ai... </i>"
msgstr "알겠습니다, <i>츠라이... </i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_CaptainSpeaksToTemplar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 8014ee32-2909-beb1-32fb-941fe45abf5b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_CaptainSpeaksToTemplar:8014ee32-2909-beb1-32fb-941fe45abf5b
msgctxt "hed2b2468gebb0g42e9gad63g695055a12cfb"
msgid "Do as she says. She remains your <i>kith'rak</i>."
msgstr "테레진의 명령을 따라라. 그녀가 너희들의 <i>키스락</i>이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_CaptainSpeaksToTemplar
#. Speaker = Kith'rak Therezzyn
#. NodeID = 9c115821-2cb1-69c8-b336-2847ce8feea0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_ChainOfCommand_State_GatesSceneCompleted = True
#. SetFlags:
#.   Global:
#.     - GLO_Absolute_Knows_MoonriseTowers = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_CaptainSpeaksToTemplar:9c115821-2cb1-69c8-b336-2847ce8feea0
msgctxt "h38465fa1g033cg4641gb9bageb76fcc1ede9"
msgid ""
"The latest batch of cultists knew nothing of the Astral Prism. They were "
"just trying to find Moonrise."
msgstr "최근에 잡혀온 광신도들은 아스트랄 프리즘에 대해 아무것도 모르고 있었습니다. 그저 문라이즈를 찾고자 했을 뿐이었습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_CaptainSpeaksToTemplar
#. Speaker = Kith'rak Therezzyn
#. NodeID = b9294bd9-1237-aef5-e33e-4923ee11f36c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_CaptainSpeaksToTemplar:b9294bd9-1237-aef5-e33e-4923ee11f36c
msgctxt "hbb13614ag326eg4435gbbcfg12b5de04ec28"
msgid ""
"We could sift the missing artefact from the tower's ashes, if you would give "
"us -"
msgstr "탑의 잿더미에서 사라진 아티팩트를 찾아낼 수 있을지도 모릅니다. 츠라이께서 그걸 주신다면 -"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_CaptainSpeaksToTemplar
#. Speaker = Kith'rak Therezzyn
#. NodeID = c50cc2ab-7daf-c0a8-f3cd-7f66c5d6ddb0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_CaptainSpeaksToTemplar:c50cc2ab-7daf-c0a8-f3cd-7f66c5d6ddb0
msgctxt "h4ab8de4cg52b0g4af3gbefbgc6c7cf62646b"
msgid ""
"They all head there - my gish have drafted plans to assault the tower. They "
"are ready to fight, <i>ch'r'ai</i>."
msgstr ""
"그들은 모두 그곳으로 향하고 있습니다. 저의 기쉬가 탑을 공격할 계획을 세웠습니다. 그들은 싸울 준비가 되어 있습니다, "
"<i>츠라이</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_CaptainSpeaksToTemplar
#. Speaker = Kith'rak Therezzyn
#. NodeID = d4b0da7c-91f4-dc5d-ca97-078249c893c7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_ChainOfCommand_State_GatesSceneCompleted = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_CaptainSpeaksToTemplar:d4b0da7c-91f4-dc5d-ca97-078249c893c7
msgctxt "h272c23d8ge1a4g42f7g8cf4g69296954bdfd"
msgid "The latest patrol have not returned. I'm sorry, I -"
msgstr "마지막 순찰대가 돌아오지 않았습니다. 죄송합니다, 제가 -"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_CaptainSpeaksToTemplar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = ea7b84e8-13f8-0fd3-4961-52525ec47aa9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_CaptainSpeaksToTemplar:ea7b84e8-13f8-0fd3-4961-52525ec47aa9
msgctxt "h8a23428agd30eg4272g8ad1g4e47201a61b3"
msgid "<i>Quiet</i>."
msgstr "<i>조용히 하라</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_CaptainWarning
#. Speaker = Kith'rak Therezzyn
#. NodeID = 309423ea-f961-02bd-057b-17a3f7222f7c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_CaptainWarning:309423ea-f961-02bd-057b-17a3f7222f7c
msgctxt "h2e562f63g9021g4b9egade2gd2ad93a60cff"
msgid ""
"Where do you think you're going? Take the artefact to the Inquisitor. "
"<i>Now</i>."
msgstr "어딜 가려는 게냐? 아티팩트를 심문관께 가져가도록. <i>당장</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_CaptainWarning
#. Speaker = Kith'rak Therezzyn
#. NodeID = c1a3d255-f035-f1fa-b38d-0e1dcdfd48a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_CaptainWarning:c1a3d255-f035-f1fa-b38d-0e1dcdfd48a5
msgctxt "h2a3d33a8g249fg4fe1gb7a7g502942113c2f"
msgid "Any attempts to subvert me will result in your death."
msgstr "항명하려는 낌새만 보여도 주검 신세가 될 줄 알아라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_GithGuardMonastery01
#. Speaker = Raider Add'ath
#. NodeID = 40c81481-5493-a8e8-04d1-acb04780b733
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_ChainOfCommand_HasMet_GithGuardMonastery01(1) = True
#.   Tag:
#.      - GITHYANKI(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_GithGuardMonastery01:40c81481-5493-a8e8-04d1-acb04780b733
msgctxt "hc234f0bbg05c6g43b5gbc2bg43e7e2f43aad"
msgid "If I need to speak to a creature like you, I will do so. Begone. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_GithGuardMonastery01
#. Speaker = Raider Add'ath
#. NodeID = c955e56d-b3ae-197c-f01c-60b045575042
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_ChainOfCommand_HasMet_GithGuardMonastery01(1) = False
#.   Tag:
#.      - GITHYANKI(1) = True
#. SetFlags:
#.   Dialog:
#.     - CRE_ChainOfCommand_HasMet_GithGuardMonastery01(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_GithGuardMonastery01:c955e56d-b3ae-197c-f01c-60b045575042
msgctxt "h543cb22agae97g4955ga0abgffe9d1d271e4"
msgid ""
"Welcome, <i>ra'stil</i>. If you're looking for the <i>Kith'rak</i>, I would "
"advise caution. Her patience hangs thin."
msgstr "어서 와라, <i>라스틸</i>. <i>키스락</i>을 찾고 있다면, 언행을 삼가길 권하지. 그분의 인내심이 바닥을 드러냈으니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_GithGuardMonastery01
#. Speaker = Raider Add'ath
#. NodeID = dce724e3-bf52-5696-6e61-bb0efa65e353
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_ChainOfCommand_HasMet_GithGuardMonastery01(1) = True
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_GithGuardMonastery01:dce724e3-bf52-5696-6e61-bb0efa65e353
msgctxt "hf8032438g988dg49d5gaaabg5e32e0474d01"
msgid ""
"I hope you bring good news for the <i>kith'rak</i>. Vlaakith help us if you "
"don't."
msgstr "<i>키스락</i>께 좋은 소식을 가져왔길 바라지. 그게 아니라면 블라키스 님의 자비가 필요할 테니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_GithGuardMonastery01
#. Speaker = Raider Add'ath
#. NodeID = fdd38eab-57a4-8b5a-a3dc-dc94fc2f4599
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_ChainOfCommand_HasMet_GithGuardMonastery01(1) = False
#.   Tag:
#.      - GITHYANKI(1) = False
#. SetFlags:
#.   Dialog:
#.     - CRE_ChainOfCommand_HasMet_GithGuardMonastery01(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_GithGuardMonastery01:fdd38eab-57a4-8b5a-a3dc-dc94fc2f4599
msgctxt "haf1b22a2g4bbag4776g865ag488920902de6"
msgid ""
"Another <i>istik</i>? You're lucky we didn't catch you outside, or you'd be "
"in with the Captain right now."
msgstr "또 다른 <i>이스틱</i>이라? 밖에서 붙잡히지 않다니 운이 좋군. 그랬다면 지금쯤 우리 대장과 함께 있었을 테니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_GithGuardMonastery02
#. Speaker = Warrior Ith'dul
#. NodeID = 5783cf9b-5c53-4544-9a5d-fd07703f252b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_ChainOfCommand_HasMet_GithGuardMonastery02(1) = False
#.   Tag:
#.      - GITHYANKI(1) = True
#. SetFlags:
#.   Dialog:
#.     - CRE_ChainOfCommand_HasMet_GithGuardMonastery02(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_GithGuardMonastery02:5783cf9b-5c53-4544-9a5d-fd07703f252b
msgctxt "h459e5554g2449g413dga1d8ge4e3986e5681"
msgid ""
"Yet again, the weapon eludes us. I've heard even Kith'rak Voss is searching "
"now."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_GithGuardMonastery02
#. Speaker = Warrior Ith'dul
#. NodeID = b33ff0d1-81df-903e-b608-8589dd2846a5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_ChainOfCommand_HasMet_GithGuardMonastery02(1) = False
#.   Tag:
#.      - GITHYANKI(1) = False
#. SetFlags:
#.   Dialog:
#.     - CRE_ChainOfCommand_HasMet_GithGuardMonastery02(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_GithGuardMonastery02:b33ff0d1-81df-903e-b608-8589dd2846a5
msgctxt "h261dac33ga521g4accga1abga4b1491fe078"
msgid ""
"The Captain has little patience for your kind. You'd better not waste her "
"time."
msgstr "너희 족속들에 대한 우리 대장의 인내심이 바닥을 드러냈다. 그분의 시간을 낭비하지 않는 게 좋을 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_GithGuardMonastery02
#. Speaker = Warrior Ith'dul
#. NodeID = c28b9a41-5ed7-4b71-8e7d-3c5de0c11b43
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_ChainOfCommand_HasMet_GithGuardMonastery02(1) = True
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_GithGuardMonastery02:c28b9a41-5ed7-4b71-8e7d-3c5de0c11b43
msgctxt "hb950a050g3a4ag4677gb4cbg099975b79e19"
msgid ""
"It is unusual for the Captain to spend so long thwarted. The Inquisitor "
"expects results."
msgstr "우리 대장은 그리 쉽게 낙담에 빠지는 분이 아니시다. 심문관이 결과를 고대하고 있다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_GithGuardMonastery02
#. Speaker = Warrior Ith'dul
#. NodeID = c4ac00c2-8390-5e06-b6cc-499946e371a4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_ChainOfCommand_HasMet_GithGuardMonastery02(1) = True
#.   Tag:
#.      - GITHYANKI(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_GithGuardMonastery02:c4ac00c2-8390-5e06-b6cc-499946e371a4
msgctxt "hf51675f3gf59dg4d91g86a4gb82ac85ef2cc"
msgid "Step lightly, <i>istik</i>."
msgstr "경거망동 마라, <i>이스틱</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_PAD_CaptainsMapComment
#. Speaker = Player
#. NodeID = 74eab6fc-e783-483f-93d7-2e4b318b087c
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_PAD_CaptainsMapComment:74eab6fc-e783-483f-93d7-2e4b318b087c
msgctxt "h31aeb711gc039g4135ga5b2ga741cd6f11a2"
msgid "These gith have mapped half of bloody Faerûn. To what end, I wonder?"
msgstr "이 기스 놈들이 페이룬의 빌어먹을 절반을 표시해 놨잖아. 어떤 용도일지 궁금한데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_PAD_CaptainsMapComment
#. Speaker = Player
#. NodeID = 74eab6fc-e783-483f-93d7-2e4b318b087c
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_PAD_CaptainsMapComment:74eab6fc-e783-483f-93d7-2e4b318b087c
msgctxt "h30f5b453g6a50g4d79gb620g852909baa8d1"
msgid ""
"A map of the Sword Coast. My people have scouted well beyond the temple."
msgstr "소드 코스트 지도로군. 동족들이 신전 너머까지 정찰을 마쳤어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_PAD_CaptainsMapComment
#. Speaker = Player
#. NodeID = 74eab6fc-e783-483f-93d7-2e4b318b087c
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_PAD_CaptainsMapComment:74eab6fc-e783-483f-93d7-2e4b318b087c
msgctxt "hbc1cf776gf058g48efga94dged627c8779e4"
msgid ""
"A map of the Sword Coast. Whatever these githyanki are planning, Baldur's "
"Gate lies at the heart..."
msgstr "소드 코스트 지도로군. 이 기스양키들이 무슨 꿍꿍이를 품고 있든, 발더스 게이트가 핵심인 게 분명해..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_PAD_CaptainsMapComment
#. Speaker = Player
#. NodeID = 74eab6fc-e783-483f-93d7-2e4b318b087c
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_PAD_CaptainsMapComment:74eab6fc-e783-483f-93d7-2e4b318b087c
msgctxt "h0888d280g01bbg4ccbg8945g2e5c7d67ea0e"
msgid ""
"The Sword Coast - there's Baldur's Gate. Somehow, I doubt the gith are "
"planning a holiday."
msgstr "소드 코스트, 발더스 게이트가 표시되어 있어. 기스 놈들이 저기서 휴가라도 보내려는 건 아니겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_PAD_CaptainsMapComment
#. Speaker = Player
#. NodeID = 74eab6fc-e783-483f-93d7-2e4b318b087c
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_PAD_CaptainsMapComment:74eab6fc-e783-483f-93d7-2e4b318b087c
msgctxt "h687d9973g3f20g45begaaadg48b68ec18c8c"
msgid "A map of the Sword Coast? The githyanki are planning something..."
msgstr "소드 코스트의 지도라? 기스양키들이 어떤 작전을 세우고 있는 게 분명해..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_PAD_CaptainsMapComment
#. Speaker = Player
#. NodeID = 74eab6fc-e783-483f-93d7-2e4b318b087c
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_PAD_CaptainsMapComment:74eab6fc-e783-483f-93d7-2e4b318b087c
msgctxt "h08b041b7g0adag4b21gaea4g77691dd56e87"
msgid ""
"Look at that. A map of the entire Sword Coast. Hope they aren't planning "
"anything untoward."
msgstr "이것 봐. 소드 코스트의 전체 지도야. 이 친구들이 골치 아픈 일을 벌일 심산은 아니겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_PAD_CaptainsMapComment
#. Speaker = Player
#. NodeID = 74eab6fc-e783-483f-93d7-2e4b318b087c
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_PAD_CaptainsMapComment:74eab6fc-e783-483f-93d7-2e4b318b087c
msgctxt "hbb54b56eg3170g4b2dgb825gecbdc1ce5e01"
msgid ""
"The Sword Coast. There's Baldur's Gate. What are the githyanki planning...?"
msgstr "소드 코스트군. 발더스 게이트가 저기 있어. 기스양키들이 뭘 계획하고 있는 거지...?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_PAD_CaptainsMapComment
#. Speaker = Player
#. NodeID = 74eab6fc-e783-483f-93d7-2e4b318b087c
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: REALLY_GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_PAD_CaptainsMapComment:74eab6fc-e783-483f-93d7-2e4b318b087c
msgctxt "h91cdc760gab40g4e57gb437gb596225d5daf"
msgid ""
"A map of the Sword Coast. My people have scouted well beyond the temple."
msgstr "소드 코스트 지도로군. 동족들이 신전 너머까지 정찰을 마쳤어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_PAD_CaptainsMapComment
#. Speaker = Player
#. NodeID = 74eab6fc-e783-483f-93d7-2e4b318b087c
#. HandlePath = TaggedText[8].TagText[0]
#. TagRule: !REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_PAD_CaptainsMapComment:74eab6fc-e783-483f-93d7-2e4b318b087c
msgctxt "h046f643ag2782g47b2g9dfeg2bf699415149"
msgid "A map of the Sword Coast? What are the gith planning?"
msgstr "소드 코스트 지도라고? 기스 놈들이 무슨 꿍꿍이속이지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_PAD_DefeatCaptain
#. Speaker = Player
#. NodeID = a1435e92-118f-43df-9bbf-ff30d61b0184
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_PAD_DefeatCaptain:a1435e92-118f-43df-9bbf-ff30d61b0184
msgctxt "he696d214g49a1g48aeg9f6bgbedd99f364a8"
msgid ""
"Well, that's one grunt down, but someone else is calling the shots around "
"here."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_PAD_DefeatCaptain
#. Speaker = Player
#. NodeID = a1435e92-118f-43df-9bbf-ff30d61b0184
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_PAD_DefeatCaptain:a1435e92-118f-43df-9bbf-ff30d61b0184
msgctxt "h4bb5906cge7e1g45d2ga00eg38d946c05f6d"
msgid ""
"That's the rank and file dealt with. Let's hope her commander is more "
"amenable."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_PAD_DefeatCaptain
#. Speaker = Player
#. NodeID = a1435e92-118f-43df-9bbf-ff30d61b0184
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_PAD_DefeatCaptain:a1435e92-118f-43df-9bbf-ff30d61b0184
msgctxt "hb0a14ca4ga22dg4ee2g8c66g200ad93930a8"
msgid "Goon down. Where's the boss?\n"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_PAD_DefeatCaptain
#. Speaker = Player
#. NodeID = a1435e92-118f-43df-9bbf-ff30d61b0184
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_PAD_DefeatCaptain:a1435e92-118f-43df-9bbf-ff30d61b0184
msgctxt "h91dc0a0ag76e8g4a0dg9b5fg5166305c58b1"
msgid "The servant is slain. But there still remains a master."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_PAD_DefeatCaptain
#. Speaker = Player
#. NodeID = a1435e92-118f-43df-9bbf-ff30d61b0184
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_PAD_DefeatCaptain:a1435e92-118f-43df-9bbf-ff30d61b0184
msgctxt "hed2212a7gb6c9g4562g8cb6g8eb73b8335cf"
msgid "That's her done for - now for her commander."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_PAD_DefeatCaptain
#. Speaker = Player
#. NodeID = a1435e92-118f-43df-9bbf-ff30d61b0184
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_PAD_DefeatCaptain:a1435e92-118f-43df-9bbf-ff30d61b0184
msgctxt "h21c1ad89ga1f4g40d0gbe3dgdb60bd1df0fe"
msgid ""
"One target down - but we're not done yet. Time to find this 'inquisitor'."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_PAD_DefeatCaptain
#. Speaker = Player
#. NodeID = a1435e92-118f-43df-9bbf-ff30d61b0184
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_PAD_DefeatCaptain:a1435e92-118f-43df-9bbf-ff30d61b0184
msgctxt "h1aa0877dg62d2g4a79g9540g7d48402ae701"
msgid ""
"Well that's dealt with. But she wasn't the one pulling the strings here. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_PAD_DoorDeviceInteraction
#. Speaker = Player
#. NodeID = 647cb11f-0f93-48fd-8d22-074eb2ef0772
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_PAD_DoorDeviceInteraction:647cb11f-0f93-48fd-8d22-074eb2ef0772
msgctxt "h1c9d14a2g1bb3g4dfbgadf3g871ca4353607"
msgid "Looks like the barrier's already down. How lovely."
msgstr ""

