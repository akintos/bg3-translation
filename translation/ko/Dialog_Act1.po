msgid "*Snort.*"
msgstr "*드르렁.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_ElevatorBear
#. Speaker = Tuffet
#. NodeID = aff3e8a8-051b-2988-b317-4bc37aec8334
