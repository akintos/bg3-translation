msgctxt "h43e525d0g29dag4188ga58bgef6bbc6d69ba"
msgid "You're speaking to a True Soul. Step aside."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SecludedSpot_Trespassing
#. Speaker = Player
#. NodeID = 46d7b11d-ae17-83fe-8359-c78757544ac0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SecludedSpot_Trespassing:46d7b11d-ae17-83fe-8359-c78757544ac0
msgctxt "hc3a518c1g659cg4b34g914cg9c492cb5f5da"
msgid "Aren't you a follower of the Absolute?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SecludedSpot_Trespassing
#. Speaker = Brawler Rancer
#. NodeID = 4b666f51-d2ca-282c-fd39-3405ae417c7a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SecludedSpot_Trespassing:4b666f51-d2ca-282c-fd39-3405ae417c7a
msgctxt "h391d2b6egf841g4ab3gaf4cgd3df76390dc1"
msgid "Ehh, I'll flop ya anyhow."
msgstr "뭐, 어차피 너를 쓰러뜨릴 테니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SecludedSpot_Trespassing
#. Speaker = Brawler Rancer
#. NodeID = 4bfa008d-70df-9bc8-8d0d-d00b77648046
