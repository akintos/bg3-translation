msgstr "이곳의 모든 우상들을 끌어내려야 해. 다음 기회에 하면 되겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/VBs/GOB_ShadowHeart_VB_Statue
#. Speaker = Shadowheart
#. NodeID = 5000e497-b71c-c020-a83b-5922e3d99332
#. HandlePath = TaggedText[0].TagText[0]
