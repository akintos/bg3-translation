msgctxt "h590d16d3g36d4g4916gaeeagbc95fec8f340"
msgid "<i>I</i> think you should open it. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_MageHandKid02
#. Speaker = Ra'jak
#. NodeID = 0be3c656-f620-1044-ca0d-f42df0df6541
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet_MageHandKid02(1) = True
