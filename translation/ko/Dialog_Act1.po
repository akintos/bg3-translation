msgctxt "hb6f8533cgee81g4e96gba26g226dbcc98d4c"
msgid "That was no bear. Damn. Maybe he can still tell us who he was."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/VBs/GOB_Halsin_PAD_HalsinDead
