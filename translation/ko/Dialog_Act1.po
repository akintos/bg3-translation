msgctxt "h456cc977g9240g45ddg8a0dgfaf0b94bab6d"
msgid "*The corpse does not stir. It will answer no more questions.*"
msgstr "*시체는 움직이지 않습니다. 더 이상 질문을 받지 않을 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_DeadFisherman5_Dead
#. Speaker = Dead Fisher
#. NodeID = bbd88382-5a8e-396d-6297-d345b42b6ff6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_Killer(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_DeadFisherman5_Dead:bbd88382-5a8e-396d-6297-d345b42b6ff6
msgctxt "h35e34653g76b3g45acga10ag3157fd87a531"
msgid "No... upriver... too far..."
msgstr "아니... 상류에... 한참 멀어..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_DeadFisherman5_Dead
#. Speaker = Player
#. NodeID = d749ca34-9e28-7ad5-4dcd-2b8c1cf3b737
