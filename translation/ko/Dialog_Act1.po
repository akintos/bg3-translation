msgctxt "h1db1b632gc81dg4872gbfd4g9776839a5752"
msgid "Poor woman. Nothing we can do for her."
msgstr "불쌍한 여인 같으니. 우리가 해줄 수 있는 건 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_FoundWife
#. Speaker = Player
#. NodeID = f5f3a235-94a0-e60e-fb7e-68316c1bba8c
