msgctxt "hbc39f95dg0a3ag46begacbdgdb43ab1eda22"
msgid ""
"*A shadow swims across your vision, and a familiar voice tells you to be "
"calm. You are loved.*"
msgstr "*그림자가 낀 듯이 눈앞이 흐려지더니, 익숙한 목소리가 당신을 달래줍니다. 사랑이 느껴집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear
#. Speaker = Player
#. NodeID = 0197619e-5e17-6e43-0314-b97eabe6659e
