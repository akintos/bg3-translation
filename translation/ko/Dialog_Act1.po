msgctxt "h5d614d5bg764fg40f1gb799gd8307605a365"
msgid "<i>Oh gods, oh gods, oh gods -</i>"
msgstr "<i>맙소사. 맙소사. 맙소사-</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CoweringRefugee003
#. Speaker = Bex
#. NodeID = 498942fd-9801-19f5-78bb-cb00c046dadb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CoweringRefugee003:498942fd-9801-19f5-78bb-cb00c046dadb
msgctxt "h947f422ag6787g4f1fgaaafg58d33e1cbd8a"
msgid "Danis, run!"
msgstr "다니스, 뛰어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CoweringRefugee004
#. Speaker = Toron
#. NodeID = b4c8b0f4-9ada-d2b2-da6d-ec55875d19e4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CoweringRefugee004:b4c8b0f4-9ada-d2b2-da6d-ec55875d19e4
msgctxt "hbe30a652gf70ag4535gb805gb4e2ba3a7e3f"
msgid "Spare me, please! PLEASE!"
msgstr "살려줘, 제발! <b>제발</b>!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CoweringStargazer
#. Speaker = Nadira
#. NodeID = e39e4cfb-8550-4e0c-ccd8-9f777e4d1ac1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CoweringStargazer:e39e4cfb-8550-4e0c-ccd8-9f777e4d1ac1
msgctxt "hc5da2ce2ge824g4e93g8367gb70821d80023"
msgid "Blood and fire. It's the Hells all over again."
msgstr "유혈과 화염이라니. 지옥판이 또 열렸군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CraftyAtPool
#. Speaker = Warrior Trunk
#. NodeID = 014f4644-eaa3-8212-b9c1-c41371ae86da
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 11d70a18-2aae-47a0-1a18-c486858b1eaf_A = True
#. SetFlags:
#.   Local:
#.     - 11d70a18-2aae-47a0-1a18-c486858b1eaf_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CraftyAtPool:014f4644-eaa3-8212-b9c1-c41371ae86da
msgctxt "hde3329bag5f1bg4c1ega690g2d610bbfe32b"
msgid "Think we could get more beer?"
msgstr "맥주 좀 더 마실 수 있을까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CraftyAtPool
#. Speaker = Warrior Trunk
#. NodeID = 2673db66-2c8d-42a1-ba50-1d64d4c8e661
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 11d70a18-2aae-47a0-1a18-c486858b1eaf_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CraftyAtPool:2673db66-2c8d-42a1-ba50-1d64d4c8e661
msgctxt "h78238e8dg1105g4ccbgaf1eg9f92e9161def"
msgid "Glad I had all that beer before the raid. Heh."
msgstr "한바탕 하기 전에 맥주를 다 마시고 와서 다행이구만, 헤헤헤."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CraftyAtPool
#. Speaker = Warrior Trunk
#. NodeID = 3bc4c800-6f02-a1d5-ea8f-0134970329a2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 11d70a18-2aae-47a0-1a18-c486858b1eaf_C = True
#. SetFlags:
#.   Local:
#.     - 11d70a18-2aae-47a0-1a18-c486858b1eaf_A = False
#.     - 11d70a18-2aae-47a0-1a18-c486858b1eaf_B = False
#.     - 11d70a18-2aae-47a0-1a18-c486858b1eaf_C = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CraftyAtPool:3bc4c800-6f02-a1d5-ea8f-0134970329a2
msgctxt "h6c595ba4g02ecg45a5g849ag8a351327fbd6"
msgid "That's what the Absolute would want, I bet."
msgstr "그게 바로 절대자님께서 원하시는 바야, 확실해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CraftyAtPool
#. Speaker = Warrior Trunk
#. NodeID = ee428a5e-abe4-5c94-512f-dabccce1ad74
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 11d70a18-2aae-47a0-1a18-c486858b1eaf_B = True
#. SetFlags:
#.   Local:
#.     - 11d70a18-2aae-47a0-1a18-c486858b1eaf_C = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CraftyAtPool:ee428a5e-abe4-5c94-512f-dabccce1ad74
msgctxt "hbbf2c577g6abdg42f5g9e7cgc202d62136a3"
msgid "Could stretch the camp all the way through this little grove."
msgstr "요 쪼끄마한 숲을 통해서 우리 야영지를 확장할 수 있겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_DrowArrives
#. Speaker = Nightwarden Minthara
#. NodeID = 4d98581b-ffc0-83cd-38e9-92a99b22cb38
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_DrowArrives:4d98581b-ffc0-83cd-38e9-92a99b22cb38
msgctxt "h18df70cdga0ecg47b8gadf0gc97c3a49f31b"
msgid "The True Soul has already begun the slaughter. Break down the gate!"
msgstr "참된 영혼이 벌써 학살을 시작했다. 입구를 파괴해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_DrowArrives
#. Speaker = Nightwarden Minthara
#. NodeID = 5d4d8d18-3859-bb1c-dc3d-88a8ab524df3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_General_State_GateOpened = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_DrowArrives:5d4d8d18-3859-bb1c-dc3d-88a8ab524df3
msgctxt "h5ba9340fg6a42g4e16ga7a1g89fa0fcd3e9d"
msgid "The True Soul has already begun the slaughter. Charge!"
msgstr "참된 영혼이 벌써 학살을 시작했다. 돌격!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 04da24c4-c7e1-4c9f-b6fd-738302eb0400
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 5f09c70a-153e-77e8-731c-5c532e635809_A = True
#. SetFlags:
#.   Local:
#.     - 5f09c70a-153e-77e8-731c-5c532e635809_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_DrowCommander:04da24c4-c7e1-4c9f-b6fd-738302eb0400
msgctxt "h75e6ac2eg115ag4cf5ga81ag2b5d782e5c98"
msgid "My strength is your strength."
msgstr "당신의 힘이 제 힘일지니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 081b24cb-1e67-4416-b7af-c5c88ac12b88
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 5f09c70a-153e-77e8-731c-5c532e635809_B = True
#. SetFlags:
#.   Local:
#.     - 5f09c70a-153e-77e8-731c-5c532e635809_C = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_DrowCommander:081b24cb-1e67-4416-b7af-c5c88ac12b88
msgctxt "h54eddacbge97fg4106g84a7g581c7faa2ffa"
msgid "Your authority is my law."
msgstr "당신의 권위가 저의 법일지니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 5b7ac783-9248-423b-9e0c-2e8355911d81
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 5f09c70a-153e-77e8-731c-5c532e635809_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_DrowCommander:5b7ac783-9248-423b-9e0c-2e8355911d81
msgctxt "h07ce93a7g0018g4c38g87b8g03fc3ec7e80a"
msgid "Absolute, guide me."
msgstr "절대자시여, 저를 인도하소서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 77ce45be-96a3-4446-b62e-efb35d26bf60
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 5f09c70a-153e-77e8-731c-5c532e635809_C = True
#. SetFlags:
#.   Local:
#.     - 5f09c70a-153e-77e8-731c-5c532e635809_B = False
#.     - 5f09c70a-153e-77e8-731c-5c532e635809_C = False
#.     - 5f09c70a-153e-77e8-731c-5c532e635809_A = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_DrowCommander:77ce45be-96a3-4446-b62e-efb35d26bf60
msgctxt "h181d8eeagbc8bg49a3gbb4eg7c1906aadfd1"
msgid "I await your command, Absolute."
msgstr "당신의 명령을 기다리겠습니다, 절대자시여."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_DrowCommanderKneelingOverTiefling
#. Speaker = Nightwarden Minthara
#. NodeID = 4c374049-9341-47e2-ace0-cfef3f6fe57a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - db35597c-4b1d-ee33-f54a-94daac1ae9f8_A = True
#. SetFlags:
#.   Local:
#.     - db35597c-4b1d-ee33-f54a-94daac1ae9f8_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_DrowCommanderKneelingOverTiefling:4c374049-9341-47e2-ace0-cfef3f6fe57a
msgctxt "h68966468g9032g4794ga487gade8db787390"
msgid "Hm. So many cuts. The goblins were eager with this one."
msgstr "흠. 자상이 많군. 고블린들이 좀 많이 흥분했나봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_DrowCommanderKneelingOverTiefling
#. Speaker = Nightwarden Minthara
#. NodeID = 4c580a0c-5bc2-4c42-8b23-6eae9dac8c9d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - db35597c-4b1d-ee33-f54a-94daac1ae9f8_C = True
#. SetFlags:
#.   Local:
#.     - db35597c-4b1d-ee33-f54a-94daac1ae9f8_B = False
#.     - db35597c-4b1d-ee33-f54a-94daac1ae9f8_C = False
#.     - db35597c-4b1d-ee33-f54a-94daac1ae9f8_A = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_DrowCommanderKneelingOverTiefling:4c580a0c-5bc2-4c42-8b23-6eae9dac8c9d
msgctxt "h72593fb2gc136g45c9g9aadg4d0e67388f27"
msgid ""
"To flee the fires of Avernus only to fall here - this is the power of the "
"Absolute."
msgstr "아베르누스의 불길을 피해 도망친 모양이다만 여기서 끝이다 - 절대자님의 힘을 목도하라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_DrowCommanderKneelingOverTiefling
#. Speaker = Nightwarden Minthara
#. NodeID = aabe813d-85a9-4882-a9e6-9eda2487eab7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - db35597c-4b1d-ee33-f54a-94daac1ae9f8_B = True
#. SetFlags:
#.   Local:
#.     - db35597c-4b1d-ee33-f54a-94daac1ae9f8_C = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_DrowCommanderKneelingOverTiefling:aabe813d-85a9-4882-a9e6-9eda2487eab7
msgctxt "h9bbbda6bg92c5g4048ga8c7g5028df476379"
msgid "So young. But then, weren't they all?"
msgstr "어리군. 뭐 다들 그렇지 않았나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_DrowCommanderKneelingOverTiefling
#. Speaker = Nightwarden Minthara
#. NodeID = bd45f5bd-36ab-4022-acf3-0a6603d5dba6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - db35597c-4b1d-ee33-f54a-94daac1ae9f8_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_DrowCommanderKneelingOverTiefling:bd45f5bd-36ab-4022-acf3-0a6603d5dba6
msgctxt "h2c6c003egd0c4g46deg8602ge68e1701af35"
msgid "So much blood. So easily spilled."
msgstr "아까운 피가 너무 많이 흘렀군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_FillingOilBarrel
#. Speaker = Guex
#. NodeID = 14ceddaf-04ec-dcdb-c836-5f9c687a6789
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_FillingOilBarrel:14ceddaf-04ec-dcdb-c836-5f9c687a6789
msgctxt "h07fe45ebga098g43b0g832eg8b95bf1efb0e"
msgid "Please, you're trembling like -"
msgstr "뭐래, 너 진짜 뭣 같이 떨고 있..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_FillingOilBarrel
#. Speaker = Pandirna
#. NodeID = 1ae3d8ab-983a-233f-37f4-c7d70d6fed65
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_FillingOilBarrel:1ae3d8ab-983a-233f-37f4-c7d70d6fed65
msgctxt "h57b19b94g24aag481eg9667g5e5a76362c39"
msgid "It seems... cruel, when you say it like that."
msgstr "그건 좀... 잔인한데. 그런 식으로 말하니까 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_FillingOilBarrel
#. Speaker = Pandirna
#. NodeID = 1c81e133-4378-a4c6-8156-57558017163e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 551618bc-83c9-52cc-0ca7-37c224446cf7_Local1 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_FillingOilBarrel:1c81e133-4378-a4c6-8156-57558017163e
msgctxt "h01c2ab1dgf480g409aga7e4g339885c74f85"
msgid "Gods, this oil bloody stinks."
msgstr "맙소사, 기름 냄새 참 지독하네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_FillingOilBarrel
#. Speaker = Pandirna
#. NodeID = 2cac8fdc-b90b-0ecf-6417-42f407c9a239
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_FillingOilBarrel:2cac8fdc-b90b-0ecf-6417-42f407c9a239
msgctxt "hd5dc3b36gbd6dg432eg8769gd5be53c40e33"
msgid "I'm not. <i>Shaking.</i>"
msgstr "떤 적. <i>없다고.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_FillingOilBarrel
#. Speaker = Guex
#. NodeID = 37f125fd-c517-7038-e5c1-dcf271926457
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_FillingOilBarrel:37f125fd-c517-7038-e5c1-dcf271926457
msgctxt "ha3e592b8gc5eag43dcgaa5dg3f3335b94815"
msgid "<i>Cruel? </i>Imagine what they'd do to us, given half the chance."
msgstr "<i>잔인해? </i> 놈들이 기회 생기면 우리한테 뭔 짓 할지 상상해 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_FillingOilBarrel
#. Speaker = Pandirna
#. NodeID = 3ce6d347-5bb2-f3af-806f-8b0d67cd30be
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 551618bc-83c9-52cc-0ca7-37c224446cf7_Local1 = True
#. SetFlags:
#.   Local:
#.     - 551618bc-83c9-52cc-0ca7-37c224446cf7_Local2 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_FillingOilBarrel:3ce6d347-5bb2-f3af-806f-8b0d67cd30be
msgctxt "hf4b964e4gaed0g4180g8646gc5fe78c342f9"
msgid "Can we just get this done, please? I want to get below before -"
msgstr "그냥 얼른 마무리 좀 보자, 제발. 일 생기기 전에 내려가고 싶-"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_FillingOilBarrel
#. Speaker = Guex
#. NodeID = 7305a41f-bf9a-feeb-0935-33a52266692d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_FillingOilBarrel:7305a41f-bf9a-feeb-0935-33a52266692d
msgctxt "hcf62a5f2gb690g4665g83f3g944b49bfa85a"
msgid "Not so bad as burning goblin will, I'd wager."
msgstr "고블린 타는 냄새보단 나을걸. 내기해도 좋아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_FillingOilBarrel
#. Speaker = Guex
#. NodeID = 8d27c00a-afa6-59fe-50d0-e89b25a7c8e5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_FillingOilBarrel:8d27c00a-afa6-59fe-50d0-e89b25a7c8e5
msgctxt "ha6f8e48dgd52fg43e9gb3b2g3dbc37d5d09c"
msgid "All right..."
msgstr "그렇다 치자..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_FillingOilBarrel
#. Speaker = Guex
#. NodeID = 95e341b4-8139-df11-5e32-294d9688fc29
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_FillingOilBarrel:95e341b4-8139-df11-5e32-294d9688fc29
msgctxt "h6bc288a5gfbeeg47f9g85e7g2a0e5f1054c2"
msgid "<i>You</i> might be afraid of your own shadow, but some of us -"
msgstr "<i>너야</i> 지 그림자만 봐도 쫄아댈 테지만, 모두가 그런 건 -"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_FillingOilBarrel
#. Speaker = Pandirna
#. NodeID = b3f3ea1f-269d-e833-abd7-c9c220fd7a0b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_FillingOilBarrel:b3f3ea1f-269d-e833-abd7-c9c220fd7a0b
msgctxt "h7cee8772g0359g4e2fg992agfff629a099b1"
msgid ""
"Look. Asharak already picked who he wanted on the walls, right? And it "
"wasn't us."
msgstr "야. 방벽에 올라 싸울 인원은 아샤라크가 이미 뽑아놨잖아? 우린 아니라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_FillingOilBarrel
#. Speaker = Guex
#. NodeID = c2fb2d05-558a-110e-9ce9-4e6ac89b3c12
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 551618bc-83c9-52cc-0ca7-37c224446cf7_Local2 = True
#. SetFlags:
#.   Local:
#.     - 551618bc-83c9-52cc-0ca7-37c224446cf7_Local2 = False
#.     - 551618bc-83c9-52cc-0ca7-37c224446cf7_Local1 = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_FillingOilBarrel:c2fb2d05-558a-110e-9ce9-4e6ac89b3c12
msgctxt "h43ec57d6g7b4ag45b2g96a3g26b649b28a8c"
msgid "Would you be careful? We're going to spill if you don't stop shaking."
msgstr "조심 좀 하지? 그렇게 떨어대면 다 쏟아버릴 거라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_FillingOilBarrel
#. Speaker = Pandirna
#. NodeID = c40bad3a-b4e5-0201-1ad1-7891928bc73c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_FillingOilBarrel:c40bad3a-b4e5-0201-1ad1-7891928bc73c
msgctxt "hff39b164g4cccg46c1g9fe7g5c2f514bf63e"
msgid "Puff out your chest all you like - I'm going where it's safe."
msgstr "네 좋을 대로 실컷 허세 부리셔. 나는 안전한 데로 갈 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_FillingOilBarrel
#. Speaker = Pandirna
#. NodeID = c9e3b3c1-c7e5-8621-ee4c-9743978b3ab6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 551618bc-83c9-52cc-0ca7-37c224446cf7_C = False
#.     - 551618bc-83c9-52cc-0ca7-37c224446cf7_B = False
#.     - 551618bc-83c9-52cc-0ca7-37c224446cf7_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_FillingOilBarrel:c9e3b3c1-c7e5-8621-ee4c-9743978b3ab6
msgctxt "h19e69568gc7d2g4fdag830cg67573b80c87a"
msgid "I'm not shaking."
msgstr "떤 적 없는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_FillingOilBarrel
#. Speaker = Guex
#. NodeID = fe0c6ff4-2c74-7530-985e-c25f7f1d62d2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_FillingOilBarrel:fe0c6ff4-2c74-7530-985e-c25f7f1d62d2
msgctxt "h5ec18c8ag36a2g4d4aga806g931451d24246"
msgid "Before what? Afraid you might actually have to fight?"
msgstr "뭔 일? 직접 싸우게 될까 봐 겁난다 이거냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GettingArmed
#. Speaker = Guex
#. NodeID = 3046455f-b8bb-9ea6-b9ea-e540716386af
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - acc081f3-204a-2f29-a3bb-6d33ff784c39_A = True
#.      - acc081f3-204a-2f29-a3bb-6d33ff784c39_B = True
#.      - acc081f3-204a-2f29-a3bb-6d33ff784c39_C = False
#. SetFlags:
#.   Local:
#.     - acc081f3-204a-2f29-a3bb-6d33ff784c39_C = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GettingArmed:3046455f-b8bb-9ea6-b9ea-e540716386af
msgctxt "hdd57b071g791dg4bdagbac7gb8bfae7c8724"
msgid ""
"The more weapons we have on show, the less likely anyone'll give us trouble."
msgstr "무장한 인원이 많아 보일수록, 누구든 우리 건드릴 가능성도 줄어들 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GettingArmed
#. Speaker = Guex
#. NodeID = 95745b94-91c4-2102-6975-4d10edbbe269
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - acc081f3-204a-2f29-a3bb-6d33ff784c39_A = True
#.      - acc081f3-204a-2f29-a3bb-6d33ff784c39_B = False
#.      - acc081f3-204a-2f29-a3bb-6d33ff784c39_C = False
#. SetFlags:
#.   Local:
#.     - acc081f3-204a-2f29-a3bb-6d33ff784c39_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GettingArmed:95745b94-91c4-2102-6975-4d10edbbe269
msgctxt "he07f21edg81a4g49c7g8d2ag877de92ab8a6"
msgid "Pick something realistic. If you can't swing a sword, take a dagger."
msgstr "쓸만한 걸 집어들어. 검을 못 휘두르면, 단검이라도 들라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GettingArmed
#. Speaker = Guex
#. NodeID = 9bb0337b-e49a-692a-7f08-73bdc749d48e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - acc081f3-204a-2f29-a3bb-6d33ff784c39_A = False
#.      - acc081f3-204a-2f29-a3bb-6d33ff784c39_B = False
#.      - acc081f3-204a-2f29-a3bb-6d33ff784c39_C = False
#. SetFlags:
#.   Local:
#.     - acc081f3-204a-2f29-a3bb-6d33ff784c39_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GettingArmed:9bb0337b-e49a-692a-7f08-73bdc749d48e
msgctxt "h366dff85g5970g4746gb321g51ea15fecb9a"
msgid "Arm yourselves. Better to have a weapon and not need it."
msgstr "무기 갖춰 둬. 쓸 일 없더라도 있는 게 나아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GettingArmed
#. Speaker = Guex
#. NodeID = d3358016-61c0-b598-a323-6e4678a1372d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - acc081f3-204a-2f29-a3bb-6d33ff784c39_A = True
#.      - acc081f3-204a-2f29-a3bb-6d33ff784c39_B = True
#.      - acc081f3-204a-2f29-a3bb-6d33ff784c39_C = True
#. SetFlags:
#.   Local:
#.     - acc081f3-204a-2f29-a3bb-6d33ff784c39_A = False
#.     - acc081f3-204a-2f29-a3bb-6d33ff784c39_B = False
#.     - acc081f3-204a-2f29-a3bb-6d33ff784c39_C = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GettingArmed:d3358016-61c0-b598-a323-6e4678a1372d
msgctxt "had97b475gbc29g4943gaa6dg998c62337251"
msgid "C'mon, you're not picking a gift for your sweetheart - grab a blade!"
msgstr "뭐해, 애인 줄 선물 고르는 것도 아닌데 말이야. 빨리 칼 잡아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrieflingFriend
#. Speaker = Memnos
#. NodeID = 47a3eedc-1dce-1bf1-bbd6-2ae925560180
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 21e0890e-7019-66a3-1956-125405f96d7c_C = False
#.      - 21e0890e-7019-66a3-1956-125405f96d7c_A = False
#.      - 21e0890e-7019-66a3-1956-125405f96d7c_B = False
#. SetFlags:
#.   Local:
#.     - 21e0890e-7019-66a3-1956-125405f96d7c_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrieflingFriend:47a3eedc-1dce-1bf1-bbd6-2ae925560180
msgctxt "ha3e7cb07g3addg459fgace4g7f82af122f13"
msgid "Torm, give us courage."
msgstr "토름이시여, 용기를 주소서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrieflingFriend
#. Speaker = Memnos
#. NodeID = 56d69723-cfba-bdee-75e9-a90736fd147e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 21e0890e-7019-66a3-1956-125405f96d7c_C = False
#.      - 21e0890e-7019-66a3-1956-125405f96d7c_A = True
#.      - 21e0890e-7019-66a3-1956-125405f96d7c_B = False
#. SetFlags:
#.   Local:
#.     - 21e0890e-7019-66a3-1956-125405f96d7c_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrieflingFriend:56d69723-cfba-bdee-75e9-a90736fd147e
msgctxt "ha7e00245g6758g4284g851agd7820fb41dd5"
msgid "Helm, protect us."
msgstr "헬름이시여, 우리를 보호하소서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrieflingFriend
#. Speaker = Memnos
#. NodeID = 5e1a93f2-9349-d59d-18f1-80fbf3ae3c46
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 21e0890e-7019-66a3-1956-125405f96d7c_C = False
#.      - 21e0890e-7019-66a3-1956-125405f96d7c_A = True
#.      - 21e0890e-7019-66a3-1956-125405f96d7c_B = True
#. SetFlags:
#.   Local:
#.     - 21e0890e-7019-66a3-1956-125405f96d7c_C = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrieflingFriend:5e1a93f2-9349-d59d-18f1-80fbf3ae3c46
msgctxt "hb2eb8affg28b0g4298gb67bgcce585a26861"
msgid "Tymora, grant us good fortune."
msgstr "티모라시여, 우리에게 행운을 내려주소서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrieflingFriend
#. Speaker = Memnos
#. NodeID = d8bc38a3-6fa8-5adc-2408-630ad30f3d02
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 21e0890e-7019-66a3-1956-125405f96d7c_C = True
#.      - 21e0890e-7019-66a3-1956-125405f96d7c_A = True
#.      - 21e0890e-7019-66a3-1956-125405f96d7c_B = True
#. SetFlags:
#.   Local:
#.     - 21e0890e-7019-66a3-1956-125405f96d7c_C = False
#.     - 21e0890e-7019-66a3-1956-125405f96d7c_A = False
#.     - 21e0890e-7019-66a3-1956-125405f96d7c_B = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrieflingFriend:d8bc38a3-6fa8-5adc-2408-630ad30f3d02
msgctxt "hc1dcb74aga08bg4186g8a4dg688147620a98"
msgid "Kelemvor... show us mercy."
msgstr "켈렘보르시여... 자비를 베푸소서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrieflingFriendAtGate
#. Speaker = Memnos
#. NodeID = 4a032acb-6e35-28a0-a77c-cb5c0312730f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrieflingFriendAtGate:4a032acb-6e35-28a0-a77c-cb5c0312730f
msgctxt "h0b5a9897g1b1bg4ec2g9cb7g2fd7e1b82eaa"
msgid "He'd be proud of you. I know he would."
msgstr "그가 자랑스러워 할 거야. 분명해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrieflingFriendAtGate
#. Speaker = Memnos
#. NodeID = 93c447fd-8a46-43b4-3976-ed5f86203b43
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrieflingFriendAtGate:93c447fd-8a46-43b4-3976-ed5f86203b43
msgctxt "h673a4279g74a0g44b4ga807ge75f7a8d1d20"
msgid "We'll raise a bottle in his name, first chance we get."
msgstr "카논의 이름으로 건배하자. 기회가 되는 대로."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrieflingFriendAtGate
#. Speaker = Memnos
#. NodeID = 95eb2972-a09f-27e6-0f81-0dd30a08f563
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrieflingFriendAtGate:95eb2972-a09f-27e6-0f81-0dd30a08f563
msgctxt "h8af77a4fgf7a7g41acga757g4af6958c0ce6"
msgid ""
"I'm... I'm sorry I wasn't there to help. That'll change from now on, I "
"promise."
msgstr "저기.. 저번엔 도와주지 못해서 미안해. 이제부턴 다를 거야. 약속할게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrieflingFriendAtGate
#. Speaker = Arka
#. NodeID = cdb60607-82bd-a7ae-045d-c7f457352285
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrieflingFriendAtGate:cdb60607-82bd-a7ae-045d-c7f457352285
msgctxt "h9c2d203fgb4f8g4e03g8df0g30963124e79f"
msgid "We did. For Kanon."
msgstr "정말 해냈네. 카논을 위하여."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrieflingFriendAtGate
#. Speaker = Memnos
#. NodeID = e41494ca-d7e4-c8d4-509b-3992698b8b3f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrieflingFriendAtGate:e41494ca-d7e4-c8d4-509b-3992698b8b3f
msgctxt "h6cf54785gdcd0g41f9gb1d3g262f5595ce65"
msgid "We did it. We actually did it!"
msgstr "우리가 해냈어. 진짜 해냈다고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrieflingFriendAtGrave
#. Speaker = Memnos
#. NodeID = 6e93fce5-ef4b-79b4-345d-a98eb519f66b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrieflingFriendAtGrave:6e93fce5-ef4b-79b4-345d-a98eb519f66b
msgctxt "hafd5fa87g1664g4c0egb8d1g2e72b9825f1c"
msgid "Rest well, Arka. I'm sure Kanon's waiting for you."
msgstr "푹쉬어 아르카. 카논이 널 기다리고 있을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrieflingOnGate
#. Speaker = Arka
#. NodeID = 4700a9ac-1569-f23f-ea1e-4e8d7d0caf8d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - e404807f-29b5-d7f6-be63-6a62fdb7d4af_C = True
#. SetFlags:
#.   Local:
#.     - e404807f-29b5-d7f6-be63-6a62fdb7d4af_C = False
#.     - e404807f-29b5-d7f6-be63-6a62fdb7d4af_A = False
#.     - e404807f-29b5-d7f6-be63-6a62fdb7d4af_B = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrieflingOnGate:4700a9ac-1569-f23f-ea1e-4e8d7d0caf8d
msgctxt "h32cf6b49g85cbg496fg828eg157399b9b909"
msgid ""
"All this bloody waiting. I'll go find those goblins myself if they don't "
"appear soon."
msgstr "이 망할 기다림도 짜증나는군. 고블린 자식들, 빨리 나타나지 않으면 직접 찾으러 가주겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrieflingOnGate
#. Speaker = Arka
#. NodeID = 580d0406-ba92-98cb-8f10-2a2e72b646e1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - e404807f-29b5-d7f6-be63-6a62fdb7d4af_B = True
#. SetFlags:
#.   Local:
#.     - e404807f-29b5-d7f6-be63-6a62fdb7d4af_C = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrieflingOnGate:580d0406-ba92-98cb-8f10-2a2e72b646e1
msgctxt "he6a47c5ag7b77g43e7g9da6g17f8dd9417fa"
msgid "Any moment now... come on you <i>zurgnak </i>cowards, attack!"
msgstr "바로... 지금! 덤벼라 이 겁쟁이 <i>주르그낙 </i>들아, 다들 공격해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrieflingOnGate
#. Speaker = Arka
#. NodeID = 9be9ba2e-69bf-2e0c-7427-80a3ec824c03
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - e404807f-29b5-d7f6-be63-6a62fdb7d4af_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrieflingOnGate:9be9ba2e-69bf-2e0c-7427-80a3ec824c03
msgctxt "h5d4f60ffg8d6bg486ega424g5f6b72cc22c1"
msgid "When will they attack? I've a score to settle."
msgstr "언제쯤 쳐들어올까? 한 방 되갚아줘야 하는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrieflingOnGate
#. Speaker = Arka
#. NodeID = cf948f9d-6f6a-7a5e-a651-fdae1e20ee3e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - e404807f-29b5-d7f6-be63-6a62fdb7d4af_A = True
#. SetFlags:
#.   Local:
#.     - e404807f-29b5-d7f6-be63-6a62fdb7d4af_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrieflingOnGate:cf948f9d-6f6a-7a5e-a651-fdae1e20ee3e
msgctxt "h476ef7a1ga51cg4a95g88a4gd2e0886e9a10"
msgid "Come on, cowards. Time to pay for what you did to Kanon..."
msgstr "덤벼 검쟁이들. 카논의 원수를 갚아주마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_Grumpy
#. Speaker = Zurga
#. NodeID = 290bd47d-3516-76eb-97e6-18b5889194d0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - ba2b225d-e9d4-944d-5b4f-b27dd975c626_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_Grumpy:290bd47d-3516-76eb-97e6-18b5889194d0
msgctxt "h74e28bb3g7f0cg4535g8103g1a3008956a3f"
msgid "Where do druids keep their liquor?"
msgstr "드루이드들이 물약을 어디 숨겨 뒀지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_Grumpy
#. Speaker = Zurga
#. NodeID = 636beb84-5b34-c544-2514-6a1ebc8b4ec0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - ba2b225d-e9d4-944d-5b4f-b27dd975c626_B = True
#. SetFlags:
#.   Local:
#.     - ba2b225d-e9d4-944d-5b4f-b27dd975c626_C = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_Grumpy:636beb84-5b34-c544-2514-6a1ebc8b4ec0
msgctxt "hc64c3cb6g879dg4c47g8874g0591f5b5b066"
msgid "Lads were too soft - I didn't even get any good scars."
msgstr "애송이들은 너무 나약해 빠졌어. 난 괜찮은 흉터 하나 얻지도 못했다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_Grumpy
#. Speaker = Zurga
#. NodeID = a66f354b-e2c7-ab37-c4a1-e0dc00db6b4e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - ba2b225d-e9d4-944d-5b4f-b27dd975c626_A = True
#. SetFlags:
#.   Local:
#.     - ba2b225d-e9d4-944d-5b4f-b27dd975c626_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_Grumpy:a66f354b-e2c7-ab37-c4a1-e0dc00db6b4e
msgctxt "h0f8f67e6g609eg494ag8866g18bd195e4076"
msgid "Wish we'd raided another tavern instead of a... garden."
msgstr "다른 선술집이나 털었으면 좋았을 텐데. 이따위... 정원 말고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_Grumpy
#. Speaker = Zurga
#. NodeID = e1f18cd8-5896-46b6-96d3-83da5c38257a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - ba2b225d-e9d4-944d-5b4f-b27dd975c626_C = True
#. SetFlags:
#.   Local:
#.     - ba2b225d-e9d4-944d-5b4f-b27dd975c626_C = False
#.     - ba2b225d-e9d4-944d-5b4f-b27dd975c626_A = False
#.     - ba2b225d-e9d4-944d-5b4f-b27dd975c626_B = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_Grumpy:e1f18cd8-5896-46b6-96d3-83da5c38257a
msgctxt "h1cdc151ag7984g401cg988eg2455a4627a65"
msgid "*Spit.*"
msgstr "*퉤.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrumpyAndArrogant
#. Speaker = Sharp-Eye Neem
#. NodeID = 0ab184c3-2f0f-5232-b550-8052c30d66f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrumpyAndArrogant:0ab184c3-2f0f-5232-b550-8052c30d66f8
msgctxt "h4a2c2763g561bg4dbdg9a28gc926b1ea0240"
msgid "We should have raided a <i>town</i>."
msgstr "<i>마을</i>을 습격했어야 했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrumpyAndArrogant
#. Speaker = Zurga
#. NodeID = 1095a7f9-6e06-6374-de0f-407e0ed09954
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrumpyAndArrogant:1095a7f9-6e06-6374-de0f-407e0ed09954
msgctxt "h7007f1e5g6439g4b49ga55bg5a73e3ecd014"
msgid ""
"If they do it's probably made of grapes or apples, or some other rubbish."
msgstr "보나 마나 포도나 사과, 아니면 다른 쓰레기 같은 것들로 만들겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrumpyAndArrogant
#. Speaker = Zurga
#. NodeID = 199bce63-e954-98ad-7611-3e3f916237de
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 5ebae00c-47d8-736c-6738-4ee56cebbc49_A = True
#. SetFlags:
#.   Local:
#.     - 5ebae00c-47d8-736c-6738-4ee56cebbc49_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrumpyAndArrogant:199bce63-e954-98ad-7611-3e3f916237de
msgctxt "h3c54f5bcg00b7g4801g96b5gffdd05233019"
msgid "We should have raided another tavern."
msgstr "다른 여관을 습격했어야 했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrumpyAndArrogant
#. Speaker = Zurga
#. NodeID = 20dfdcb5-3998-f3b7-8bf5-d0cd57b21043
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrumpyAndArrogant:20dfdcb5-3998-f3b7-8bf5-d0cd57b21043
msgctxt "haa590c98g4b06g41dcg951egb1338af419a2"
msgid "If she hears you, it'll be the last."
msgstr "그녀가 들으시면, 그대로 끝장이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrumpyAndArrogant
#. Speaker = Zurga
#. NodeID = 2c24477e-d050-dbf8-85f3-3a5c4f09ccef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrumpyAndArrogant:2c24477e-d050-dbf8-85f3-3a5c4f09ccef
msgctxt "hf562972bgd445g4516g8d76gaf1a4969db7f"
msgid "Oi! I was right in the thick of it."
msgstr "이봐! 나도 그 현장에 있었다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrumpyAndArrogant
#. Speaker = Sharp-Eye Neem
#. NodeID = 3604c847-7e2b-5c83-7bd7-5a3bfc7afc0e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrumpyAndArrogant:3604c847-7e2b-5c83-7bd7-5a3bfc7afc0e
msgctxt "h1f06fab0g0c75g477aga0ebg6d33a5ce1784"
msgid "I'm not even sure they <i>drink</i> liquor."
msgstr "술을 <i>마시긴</i> 하는 건지도 모르겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrumpyAndArrogant
#. Speaker = Zurga
#. NodeID = 6ff76fcc-59de-47f6-6d1e-2c073050142e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 5ebae00c-47d8-736c-6738-4ee56cebbc49_B = True
#. SetFlags:
#.   Local:
#.     - 5ebae00c-47d8-736c-6738-4ee56cebbc49_C = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrumpyAndArrogant:6ff76fcc-59de-47f6-6d1e-2c073050142e
msgctxt "h8c5c63a1g60c8g4beag8c38g33b3407494f1"
msgid "Get any good scars during the raid?"
msgstr "습격 중에 좋은 상처는 입었나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrumpyAndArrogant
#. Speaker = Zurga
#. NodeID = 88048569-c535-1c3d-3c07-2c6e69ec7266
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrumpyAndArrogant:88048569-c535-1c3d-3c07-2c6e69ec7266
msgctxt "h53ee142cg1287g426eg8189g3c00df7885af"
msgid "A city!"
msgstr "도시도 좋겠다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrumpyAndArrogant
#. Speaker = Sharp-Eye Neem
#. NodeID = 94c31b3b-4de9-a526-d964-3de03d625854
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrumpyAndArrogant:94c31b3b-4de9-a526-d964-3de03d625854
msgctxt "h6531fb63g0964g4419g9fc7gbc3cca8d5cb7"
msgid "Nah. True Souls did most of the fighting."
msgstr "에이. 싸움은 참된 영혼들이 다 했지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrumpyAndArrogant
#. Speaker = Zurga
#. NodeID = b4ea179b-fecd-7227-460e-ba7beb68531b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 5ebae00c-47d8-736c-6738-4ee56cebbc49_C = True
#. SetFlags:
#.   Local:
#.     - 5ebae00c-47d8-736c-6738-4ee56cebbc49_A = False
#.     - 5ebae00c-47d8-736c-6738-4ee56cebbc49_B = False
#.     - 5ebae00c-47d8-736c-6738-4ee56cebbc49_C = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrumpyAndArrogant:b4ea179b-fecd-7227-460e-ba7beb68531b
msgctxt "hcc682815gc28bg4d91g803fgd863d58c5563"
msgid "Minthara's pleased."
msgstr "민타라 님이 만족하셨군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrumpyAndArrogant
#. Speaker = Sharp-Eye Neem
#. NodeID = c8da0a17-462c-0002-7406-85fd36c6c7aa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrumpyAndArrogant:c8da0a17-462c-0002-7406-85fd36c6c7aa
msgctxt "h311cc485gfd27g4eb8gbc05g16fa8b438cac"
msgid "First time for everything."
msgstr "뭐든지 첫경험은 있는 법이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrumpyAndArrogant
#. Speaker = Zurga
#. NodeID = f794cc4b-c024-41c8-23eb-17c6d3ecf51b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 5ebae00c-47d8-736c-6738-4ee56cebbc49_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_GrumpyAndArrogant:f794cc4b-c024-41c8-23eb-17c6d3ecf51b
msgctxt "h387cb85bg8fdcg489cg8af4g4f15d10a5168"
msgid "Where do druids store their liquor?"
msgstr "드루이드 놈들은 술을 어디 보관하는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = 0a0238f2-05f0-f107-6393-fa84ffbf72bb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HalsinAndDruidLeader:0a0238f2-05f0-f107-6393-fa84ffbf72bb
msgctxt "h9ea43d49g7005g4233g8147gef7919f7bfa6"
msgid "I thought I had been a good teacher to you. Clearly not."
msgstr "내가 좋은 스승이 되어준 줄 알았다. 확실히 아니군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HalsinAndDruidLeader
#. Speaker = Kagha
#. NodeID = 152e7d01-6d0e-33fd-4251-d2bab747a58e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HalsinAndDruidLeader:152e7d01-6d0e-33fd-4251-d2bab747a58e
msgctxt "hb848a475g86c2g47dcgae35gceb816afa4aa"
msgid "Have they blinded you to truth? Outsiders bring only <i>chaos.</i>"
msgstr "그들이 당신을 진실에 눈멀게 한 것입니까? 외부인들은 <i>혼돈을 </i>불러올 뿐입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = 158a3292-27f4-f5dc-3331-f6a90d490169
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HalsinAndDruidLeader:158a3292-27f4-f5dc-3331-f6a90d490169
msgctxt "hdea32fa7g08e8g4deagb3efgf70acfcf741e"
msgid ""
"They are our guests until they wish to leave - as I said as the day they "
"arrived."
msgstr "그들은 원하는 만큼 우리의 손님으로 있을 것이다. 그들이 처음 도착했던 날 내가 말했던 대로 말이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = 2667f863-b2d5-374a-1ba2-79a7ec2aa19d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HalsinAndDruidLeader:2667f863-b2d5-374a-1ba2-79a7ec2aa19d
msgctxt "h328d86f2g02d9g4d27g8659g5f9fc23a54e2"
msgid "Oh child. You have drifted far from the Oak Father's teachings."
msgstr "오 아이야. 넌 참나무 아버지의 가르침으로부터 너무 멀리 벗어나 버렸구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HalsinAndDruidLeader
#. Speaker = Kagha
#. NodeID = 2bd0eea9-e60e-70a5-b63c-e5a70d6369b7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HalsinAndDruidLeader:2bd0eea9-e60e-70a5-b63c-e5a70d6369b7
msgctxt "h972c3cf6gd444g4efcgafaegadb17240945f"
msgid "Silvanus would not command us to invite <i>rot</i> into our midst."
msgstr "실바누스께서는 <i>부패를</i> 저희 중심부로 초대하라고 하시지 않으셨을 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = 2f596c0b-dc07-b5e3-964c-39cb4be307c3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HalsinAndDruidLeader:2f596c0b-dc07-b5e3-964c-39cb4be307c3
msgctxt "he01fee00gfae0g4c73gb596gdaf69d1d7d09"
msgid "Perhaps you will prove yourself worthy of forgiveness. Perhaps not."
msgstr "넌 용서받을 자격이 있음을 증명할 수 있을지도 모르지. 그렇지 않을지도 모르고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HalsinAndDruidLeader
#. Speaker = Kagha
#. NodeID = 305b1ac7-5e2e-5d30-84d3-76ead053acd7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 81f2a55d-d317-761f-f6a0-fe97ad6d5288_B = True
#. SetFlags:
#.   Local:
#.     - 81f2a55d-d317-761f-f6a0-fe97ad6d5288_C = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HalsinAndDruidLeader:305b1ac7-5e2e-5d30-84d3-76ead053acd7
msgctxt "h69892c6dga4adg498dg90b6g017f00d2463e"
msgid "And the outlanders? What of them?"
msgstr "외부인들은요? 그들은 어쩌죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = 3103966e-ef3b-4d20-c98a-8623361f619f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HalsinAndDruidLeader:3103966e-ef3b-4d20-c98a-8623361f619f
msgctxt "h2a4f33c2g591cg418cg81aegbee244a633f8"
msgid "At least you recognise your mistake. This is a beginning - a small one."
msgstr "적어도 네 실수를 인지하기는 하는구나. 작긴 하더라도, 그게 시작이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = 4294a221-77dd-0035-856e-ae0ae5a829e2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = True
#. SetFlags:
#.   Local:
#.     - 81f2a55d-d317-761f-f6a0-fe97ad6d5288_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HalsinAndDruidLeader:4294a221-77dd-0035-856e-ae0ae5a829e2
msgctxt "h45bad4f9g4032g4d53gbb23g7d0aa7d7ffb5"
msgid "You imperilled the grove. I'm surprised you dare show your face."
msgstr "그대는 숲을 위험에 빠뜨렸다. 그러고도 감히 얼굴을 비추다니 놀랍군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HalsinAndDruidLeader
#. Speaker = Kagha
#. NodeID = 53b577c9-b47b-78fd-1440-7a9035d20c96
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = True
#.   Local:
#.      - 81f2a55d-d317-761f-f6a0-fe97ad6d5288_C = True
#. SetFlags:
#.   Local:
#.     - 81f2a55d-d317-761f-f6a0-fe97ad6d5288_C = False
#.     - 81f2a55d-d317-761f-f6a0-fe97ad6d5288_A = False
#.     - 81f2a55d-d317-761f-f6a0-fe97ad6d5288_B = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HalsinAndDruidLeader:53b577c9-b47b-78fd-1440-7a9035d20c96
msgctxt "hf432d00dgc8cag4093gb108g8983a14f5db8"
msgid "And what of my future, Master Halsin?"
msgstr "할신 님, 그러면 저는 어떻게 하라는 겁니까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HalsinAndDruidLeader
#. Speaker = Kagha
#. NodeID = 5842c613-eee8-d480-47c5-0445ab1251c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HalsinAndDruidLeader:5842c613-eee8-d480-47c5-0445ab1251c9
msgctxt "hcb1682c7g8801g4ce9ga3ecg0396a2d2aeaa"
msgid "I beg your forgiveness, Master."
msgstr "당신의 용서를 구합니다. 마스터."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = 5d130d1a-8b32-0c4e-f5de-bdb0b661e0d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HalsinAndDruidLeader:5d130d1a-8b32-0c4e-f5de-bdb0b661e0d6
msgctxt "h1eb6c4c2g874bg4102g8389g0d0ebc97ea70"
msgid "Do not forget who invited those shadows. You have much to learn still."
msgstr "그 그림자들을 누가 초대했는지 잊지 말거라. 넌 아직 배울 것이 많다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HalsinAndDruidLeader
#. Speaker = Kagha
#. NodeID = 70b13c34-b873-3c73-b68e-a990bdb4081e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = True
#.   Local:
#.      - 81f2a55d-d317-761f-f6a0-fe97ad6d5288_A = True
#. SetFlags:
#.   Local:
#.     - 81f2a55d-d317-761f-f6a0-fe97ad6d5288_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HalsinAndDruidLeader:70b13c34-b873-3c73-b68e-a990bdb4081e
msgctxt "h2b8acd73g4eb9g4ddfg9858g72e6408f4bab"
msgid "I sought strength in the shadows. May Silvanus forgive me."
msgstr "전 그림자 속에서 힘을 찾았습니다. 실바누스께서 저를 용서하시기를."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = 91274a23-e959-f63a-4f6e-74f8253448d2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HalsinAndDruidLeader:91274a23-e959-f63a-4f6e-74f8253448d2
msgctxt "hd58c93e0g208cg43e9gb2e4g3a629493f430"
msgid "And what have you brought? Harmony? Balance?"
msgstr "그래서 네가 뭘 불러왔지? 화합? 조화?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = 9e949050-4695-c495-72b7-7df153514d74
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 81f2a55d-d317-761f-f6a0-fe97ad6d5288_C = True
#. SetFlags:
#.   Local:
#.     - 81f2a55d-d317-761f-f6a0-fe97ad6d5288_C = False
#.     - 81f2a55d-d317-761f-f6a0-fe97ad6d5288_A = False
#.     - 81f2a55d-d317-761f-f6a0-fe97ad6d5288_B = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HalsinAndDruidLeader:9e949050-4695-c495-72b7-7df153514d74
msgctxt "h7a8f0fc9g5432g4f73gbe28g05b5719aeef9"
msgid ""
"You will make peace with all who seek shelter here. It is the will of "
"Silvanus."
msgstr "넌 이곳에 피난처를 찾아온 누구와도 평화를 이룰 것이다. 그것이 실바누스님의 뜻이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HalsinAndDruidLeader
#. Speaker = Kagha
#. NodeID = a6d41150-3bf8-30ef-8930-a7061524e758
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = True
#.   Local:
#.      - 81f2a55d-d317-761f-f6a0-fe97ad6d5288_B = True
#. SetFlags:
#.   Local:
#.     - 81f2a55d-d317-761f-f6a0-fe97ad6d5288_C = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HalsinAndDruidLeader:a6d41150-3bf8-30ef-8930-a7061524e758
msgctxt "hdf4f1602g23f5g46cbgb10dg1f4dd8ec553b"
msgid "With the shadows vanquished, healing can begin."
msgstr "그림자는 물러갔으니, 정화를 시작할 수 있겠군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HalsinAndDruidLeader
#. Speaker = Kagha
#. NodeID = b8d98383-76cd-454d-4df3-b5b00e2831a1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HalsinAndDruidLeader:b8d98383-76cd-454d-4df3-b5b00e2831a1
msgctxt "h0730d913g18e9g427cg90e7g5f3880cf9377"
msgid ""
"Then banish me. When the coming army marches, there will be none to protect "
"you."
msgstr "그렇다면 절 추방하시죠. 침입자들이 쳐들어오기 시작하면, 당신을 보호할 사람은 없을 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = e585ae34-e7d6-fdc4-d38d-fda20eb304f8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 81f2a55d-d317-761f-f6a0-fe97ad6d5288_A = True
#. SetFlags:
#.   Local:
#.     - 81f2a55d-d317-761f-f6a0-fe97ad6d5288_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HalsinAndDruidLeader:e585ae34-e7d6-fdc4-d38d-fda20eb304f8
msgctxt "h0c9888d2g4e94g455bgab30gc0fe45ae624c"
msgid "You deserve to be banished."
msgstr "넌 추방되어 마땅하다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = edd62dc2-9637-6161-b10e-709bd2d86bcb
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 81f2a55d-d317-761f-f6a0-fe97ad6d5288_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HalsinAndDruidLeader:edd62dc2-9637-6161-b10e-709bd2d86bcb
msgctxt "hd8821d09g336ag4a2dgae46g7e8aa601ed1e"
msgid "You imperilled the grove - how dare you even look me in the eye."
msgstr "너는 숲을 위험에 빠뜨렸다. 어찌 감히 내 눈을 똑바로 바라보느냐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = f540c8bc-7c3d-ecee-a587-5dc0a61e5243
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HalsinAndDruidLeader:f540c8bc-7c3d-ecee-a587-5dc0a61e5243
msgctxt "hd31e31edgbd82g4d18g9f2eg78d0eedf889d"
msgid "Beg Silvanus, not me."
msgstr "내가 아니라, 실바누스님께 빌거라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HalsinAndDruidLeader
#. Speaker = Kagha
#. NodeID = f8008c33-c6d8-0967-9b13-1fc57024eb92
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HalsinAndDruidLeader:f8008c33-c6d8-0967-9b13-1fc57024eb92
msgctxt "h9a9cf2f6g044fg48afgb4b6g2cf6c8b19641"
msgid "I did what I had to. A pity you don't see that."
msgstr "전 해야만 하는 일을 했을 뿐입니다. 당신께서 그걸 보지 못하시다니 안타깝군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HalsinJoinsFight
#. Speaker = Halsin
#. NodeID = 6fa89f16-6c70-1655-a303-d8b2b7697e22
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HalsinJoinsFight:6fa89f16-6c70-1655-a303-d8b2b7697e22
msgctxt "hefdb27e0g89ddg4795gafe8g332e7ce16306"
msgid "You will not desecrate this grove! Not while I draw breath!"
msgstr "넌 이 숲의 가치를 훼손하지 못할 것이다! 내가 살아 숨 쉬는 한은 말이다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HideoutLeaderInstructions
#. Speaker = Meli
#. NodeID = 42bd231c-5d14-bae2-25ec-6845ec408169
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HideoutLeaderInstructions:42bd231c-5d14-bae2-25ec-6845ec408169
msgctxt "hcd78774bgaf8cg4430g9bdaga0ee613d8254"
msgid "Yes, Mol! Checked twice myself."
msgstr "그래, 몰! 두 번이나 확인했다니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HideoutLeaderInstructions
#. Speaker = Silfy
#. NodeID = 53c922cd-4c2d-0376-dda6-d904f6d64114
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HideoutLeaderInstructions:53c922cd-4c2d-0376-dda6-d904f6d64114
msgctxt "h61c3d5e2g82bdg43d5ga258g63596d7ab2c1"
msgid "Sharp as a razor!"
msgstr "면도날만큼이나 날카롭지!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HideoutLeaderInstructions
#. Speaker = Mattis
#. NodeID = 5524bc71-641d-1581-ec45-ab2fc84fbdfc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HideoutLeaderInstructions:5524bc71-641d-1581-ec45-ab2fc84fbdfc
msgctxt "hc00ed2f3g3a46g4e59g8057g538182611990"
msgid ""
"No, there's collectors in the city! They'll pay good coin for it, I swear!"
msgstr "아니, 도시에 수집가들이 있어! 그들이 분명 좋은 값을 쳐 줄 거야. 맹세해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HideoutLeaderInstructions
#. Speaker = Mol
#. NodeID = 969f88be-ef76-771d-2c72-aebb07463d83
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HideoutLeaderInstructions:969f88be-ef76-771d-2c72-aebb07463d83
msgctxt "h2cabed2cg6f53g482ag84e1g4a053386e120"
msgid "Fine, but you're carrying it yourself."
msgstr "좋아, 대신 네가 직접 들고 다녀."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HideoutLeaderInstructions
#. Speaker = Mol
#. NodeID = c6c3fef8-86a3-234c-67b5-3f20a3a21992
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - b43d3bc7-f10d-73cc-232e-c1f93cba3ed5_Local2 = True
#. SetFlags:
#.   Local:
#.     - b43d3bc7-f10d-73cc-232e-c1f93cba3ed5_Local2 = False
#.     - b43d3bc7-f10d-73cc-232e-c1f93cba3ed5_Local1 = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HideoutLeaderInstructions:c6c3fef8-86a3-234c-67b5-3f20a3a21992
msgctxt "h0cdbff72g8f17g44dagb398g6687f5aad5eb"
msgid ""
"We're not in the clear yet. Keep sharp until we're standing on cobbles in "
"Baldur's Gate."
msgstr "우린 아직 안전하지 않아. 발더스 게이트의 자갈길에 서기 전까지는 경계를 늦추지 말라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HideoutLeaderInstructions
#. Speaker = Mol
#. NodeID = d5f047b2-3ab8-ba19-62d6-f80098c6aebf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - b43d3bc7-f10d-73cc-232e-c1f93cba3ed5_Local1 = True
#. SetFlags:
#.   Local:
#.     - b43d3bc7-f10d-73cc-232e-c1f93cba3ed5_Local2 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HideoutLeaderInstructions:d5f047b2-3ab8-ba19-62d6-f80098c6aebf
msgctxt "hf2846c4egc472g4efdgbfa8g69f8cbd97154"
msgid "What's this? Mattis, this is junk! Waste of effort hauling it with us."
msgstr "뭐야? 매티스, 이건 쓰레기잖아! 이따위 물건에 힘을 낭비하지 말라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HideoutLeaderInstructions
#. Speaker = Mol
#. NodeID = f3fc66a6-83de-310c-5472-0be3c32431d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HideoutLeaderInstructions:f3fc66a6-83de-310c-5472-0be3c32431d9
msgctxt "hdc2648f9geae8g42f4g8f45g7ce90217a9c0"
msgid ""
"Better be sure. We need every last copper piece to get started in Baldur's "
"Gate."
msgstr "확실히 준비해. 발더스 게이트에서 새 출발하려면 땡전 한 푼이라도 필요하다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HideoutLeaderInstructions
#. Speaker = Mol
#. NodeID = f735ec13-fb02-381c-9ee4-0174cc2358b5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - b43d3bc7-f10d-73cc-232e-c1f93cba3ed5_Local1 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HideoutLeaderInstructions:f735ec13-fb02-381c-9ee4-0174cc2358b5
msgctxt "h5ca150f8gec12g400ag9bb7gb44c92c59eb0"
msgid "Right, all of our takings stashed away for the journey?"
msgstr "좋아, 여행길에 필요한 우리 물건들 전부 잘 챙겨 놨지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HideoutLeaderScolding
#. Speaker = Mattis
#. NodeID = 22b6b3a3-9e67-11df-8c1b-db24db1cc039
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HideoutLeaderScolding:22b6b3a3-9e67-11df-8c1b-db24db1cc039
msgctxt "h7f8a7781g5d0bg4380gb2efgf48bb936beef"
msgid "Yeah! In the <i>city.</i>"
msgstr "그래! <i>도시</i> 안에서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HideoutLeaderScolding
#. Speaker = Meli
#. NodeID = 33f0e926-7700-20e2-af6c-3757b2faa8af
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HideoutLeaderScolding:33f0e926-7700-20e2-af6c-3757b2faa8af
msgctxt "ha7ab5b00g8cb1g4c4cg9a19g1dd3ee28b765"
msgid "We can always get more stuff later."
msgstr "나중에 얼마든지 구할 수 있는 것들이잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HideoutLeaderScolding
#. Speaker = Mol
#. NodeID = 3bb5f72d-aa99-89ef-d01e-aca1dcab8892
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HideoutLeaderScolding:3bb5f72d-aa99-89ef-d01e-aca1dcab8892
msgctxt "hbd0a27dfg5d6cg4139gb96ag3bf309d8e2a0"
msgid ""
"You won't get there if we starve on the way. Gonna rob your friends when "
"you're hungry?"
msgstr "가다가 먹을 거 동나면 거기 도착도 못 해. 배고프면 친구 털어먹기라도 할 거냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HideoutLeaderScolding
#. Speaker = Mol
#. NodeID = 49d05c8e-716f-4eaa-ebdc-99f9244860f6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HideoutLeaderScolding:49d05c8e-716f-4eaa-ebdc-99f9244860f6
msgctxt "h30263cf1g9651g4d75g89b2gb0bbade469d6"
msgid "Can you two help? Anything you don't pack is getting left behind."
msgstr "니들 둘 좀 거들지? 안 챙긴 짐들은 싹 다 버리고 갈 거라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HideoutLeaderScolding
#. Speaker = Mol
#. NodeID = 52fa9ba2-a333-bb9e-89be-4f601531a8d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HideoutLeaderScolding:52fa9ba2-a333-bb9e-89be-4f601531a8d6
msgctxt "h9e7fb768geeacg45feg93a1g521a5b952dbb"
msgid "Then <i>pack</i>."
msgstr "그럼 <i>짐 싸</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HideoutLeaderScolding
#. Speaker = Meli
#. NodeID = 9e812a84-e9ef-58fe-423e-7df96ef5390d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HideoutLeaderScolding:9e812a84-e9ef-58fe-423e-7df96ef5390d
msgctxt "h26d0b673geb82g4989g80a7g486b5237df7f"
msgid "No way."
msgstr "그건 아니지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HideoutLeaderSighing
#. Speaker = Mol
#. NodeID = fed703d6-3b13-cea5-a01b-ded7d530c0a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_HideoutLeaderSighing:fed703d6-3b13-cea5-a01b-ded7d530c0a4
msgctxt "h610163dfg9c1eg4b17gb22dg6712e10fceb6"
msgid "Some dumb fairy tale is all we have left..."
msgstr "말도 안 되는 동화 속 이야기라도 믿어 보는 수밖에..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_InstructionsForKids
#. Speaker = Rikka
#. NodeID = 5cf7beb8-20d9-516d-16aa-c11318f2c44e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 4f60df8b-86f4-5db2-c510-99a6f2cbee2a_Local1 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_InstructionsForKids:5cf7beb8-20d9-516d-16aa-c11318f2c44e
msgctxt "hf66c448bg36e4g44ebg9f93gf31956c374ab"
msgid "If there's fighting, you run and you do not stop. For <i>anything.</i>"
msgstr "전투가 벌어지면, 당장 도망치고 머뭇대지 마. <i>어떤 상황에서도.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_InstructionsForKids
#. Speaker = Rikka
#. NodeID = 89b20bc4-a6cf-76fd-f821-c857e84dca38
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4f60df8b-86f4-5db2-c510-99a6f2cbee2a_Local1 = True
#. SetFlags:
#.   Local:
#.     - 4f60df8b-86f4-5db2-c510-99a6f2cbee2a_Local2 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_InstructionsForKids:89b20bc4-a6cf-76fd-f821-c857e84dca38
msgctxt "he9f9607fgbce2g47bega19dg09099db3a9b8"
msgid ""
"If we get separated or need to break camp fast, remember - find the river "
"and follow it downstream."
msgstr "중간에 서로 떨어지거나 급히 야영지를 떠야 할 일이 생기면, 이걸 명심해. 강을 찾아낸 다음 하류를 따라가는 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_InstructionsForKids
#. Speaker = Rikka
#. NodeID = d774215a-afae-4a10-e6a6-55866ab71e75
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4f60df8b-86f4-5db2-c510-99a6f2cbee2a_Local2 = True
#. SetFlags:
#.   Local:
#.     - 4f60df8b-86f4-5db2-c510-99a6f2cbee2a_Local2 = False
#.     - 4f60df8b-86f4-5db2-c510-99a6f2cbee2a_Local1 = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_InstructionsForKids:d774215a-afae-4a10-e6a6-55866ab71e75
msgctxt "h9c4a4914g7012g4988gbfcdg7cbc3ed8f72c"
msgid ""
"Remember - stay near the centre of the group, all right? No wandering off."
msgstr "명심해. 항상 일행 한가운데를 벗어나지 마, 알겠지? 딴 데로 새면 안 돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_KidMurderers
#. Speaker = Warrior Rua
#. NodeID = 13ceab61-5cf1-49e3-ddf4-fd647e8cd94f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_KidMurderers:13ceab61-5cf1-49e3-ddf4-fd647e8cd94f
msgctxt "hc28acdfcg0339g44a3g85a8gddc0d90dd73b"
msgid "Yeah. Then I split him in half."
msgstr "맞아. 그러고 나서 놈을 반으로 쪼개줬지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_KidMurderers
#. Speaker = Sharp-Eye Sneem
#. NodeID = 527377fe-cefe-3ab7-1849-49e531341586
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_KidMurderers:527377fe-cefe-3ab7-1849-49e531341586
msgctxt "h23b4d9c6g12dcg449cgafe0g6460fe134d3e"
msgid "I saw. You was laughin' so hard he managed to clonk you on the head!"
msgstr "나도 봤어. 얼마나 웃어댔는지 놈이 네 머리를 때리더군!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_KidMurderers
#. Speaker = Warrior Rua
#. NodeID = 72fc2f39-7e8c-7964-8b62-202c9dcec865
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_KidMurderers:72fc2f39-7e8c-7964-8b62-202c9dcec865
msgctxt "h590e21dfg7819g4cf6ga447g262e108ddfd4"
msgid "One of the little bastards tried to fight me with a wooden sword!"
msgstr "저 좆만한 개자식들 중 하나가 목검을 들고 나와 싸우려고 했어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_KidStory
#. Speaker = Alfira
#. NodeID = 1cf2db36-970b-8851-a700-fd13f9b308af
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_KidStory:1cf2db36-970b-8851-a700-fd13f9b308af
msgctxt "hebfd2463g7fceg4cbbgb822geb50e605182e"
msgid "The Wandering Eye, the jewel of Balduran's fleet! So named because -"
msgstr "발더란 함대의 보석, 방랑자의 눈! 그 이름을 붙인 건..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_KidStory
#. Speaker = Alfira
#. NodeID = 4e0e05b2-bc02-cfa4-2b58-77583ae4336e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_KidStory:4e0e05b2-bc02-cfa4-2b58-77583ae4336e
msgctxt "h88e6bddbg8fefg449aga199gbb1dd3c1434c"
msgid "- well... because Balduran travelled far and... saw much."
msgstr "발더란이 먼 곳까지 모험했고 많은 걸 봐서죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_KidStory
#. Speaker = Alfira
#. NodeID = 506f4b21-2fdb-4cf2-3e18-617a1cfa9c98
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 9b4c05c6-0a79-ea8d-c351-43d6fbb04abc_Story1 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_KidStory:506f4b21-2fdb-4cf2-3e18-617a1cfa9c98
msgctxt "hc8f44dc4g024bg497eg8b2bgb8fbd98818d5"
msgid ""
"... and over the horizon they saw a ship, like some great beast bursting "
"from the waves."
msgstr "수평선 너머로 배가 보였는데, 파도에서 솟구쳐 오르는 거대한 야수 같았대요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_KidStory
#. Speaker = Alfira
#. NodeID = 927ccd98-75f2-b6ea-39c9-308d96a1c03f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_KidStory:927ccd98-75f2-b6ea-39c9-308d96a1c03f
msgctxt "h91889b80ge148g4ba2g88dbg38378ae8c9e6"
msgid "But he had finally come home to save the city he loved!"
msgstr "결국 사랑하는 도시를 지키기 위해 돌아왔죠!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_KidStory
#. Speaker = Alfira
#. NodeID = 9e9b1519-1b95-e129-6d25-3795bae124ce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_KidStory:9e9b1519-1b95-e129-6d25-3795bae124ce
msgctxt "h4d0a1fcfg1bdfg4e3fg922egee0cddf93d3b"
msgid ""
"And so they named the city to honour him. Balduran's - <i>Baldur's </i>Gate."
msgstr "사람들은 발더란을 기리기 위해 도시에 이름을 붙였죠. <i>발더스</i>게이트라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_KidStory
#. Speaker = Alfira
#. NodeID = aff1b833-156e-3b2a-c8bb-fd228633ad22
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_KidStory:aff1b833-156e-3b2a-c8bb-fd228633ad22
msgctxt "hb29f551ag1c84g49c7g8bedg71fcbd491cb0"
msgid "He drove the raiders away and raised a wall to protect his people."
msgstr "침입자를 물리치고, 사람들을 지키려고 벽을 세웠죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_LairDoor
#. Speaker = Stone Door
#. NodeID = 00a9ed9d-ac5b-0d4e-0dfb-9523bb74e3e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_LairDoor:00a9ed9d-ac5b-0d4e-0dfb-9523bb74e3e6
msgctxt "ha43a7302g7a3cg4234g9692gb76abc26fbc3"
msgid "Go away!"
msgstr "저리 가!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_LairDoor
#. Speaker = Doni
#. NodeID = 950355e9-875e-0449-f474-2b7899912577
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_LairDoor:950355e9-875e-0449-f474-2b7899912577
msgctxt "h7ec01c34gb9fdg4d88g8375gb72e7ed18f7a"
msgid "*Grunt.*"
msgstr "*끙.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_LookingForDoni
#. Speaker = Rikka
#. NodeID = 2f6da8b6-6ac7-989c-e451-b9f1e188d70c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 26a47c1c-a1cc-43c0-f402-ed93e6bc8b4d_Local2 = True
#. SetFlags:
#.   Local:
#.     - 26a47c1c-a1cc-43c0-f402-ed93e6bc8b4d_Local2 = False
#.     - 26a47c1c-a1cc-43c0-f402-ed93e6bc8b4d_Local1 = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_LookingForDoni:2f6da8b6-6ac7-989c-e451-b9f1e188d70c
msgctxt "hb8defc39g8575g457egb7abgd28c4dfef94a"
msgid "Doni! I don't want to lock you outside, <i>please.</i>"
msgstr "도니! 이러다 널 못 들이고 싶지 않다고, <i>제발.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_LookingForDoni
#. Speaker = Rikka
#. NodeID = 97a36170-61fe-5256-ddb1-f30b04812cdd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 26a47c1c-a1cc-43c0-f402-ed93e6bc8b4d_Local1 = True
#. SetFlags:
#.   Local:
#.     - 26a47c1c-a1cc-43c0-f402-ed93e6bc8b4d_Local2 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_LookingForDoni:97a36170-61fe-5256-ddb1-f30b04812cdd
msgctxt "h2a42d24eg78c3g4d08gb931ge9a96bdaa3aa"
msgid "We don't have time for this, Doni, please!"
msgstr "이러고 있을 시간 없어, 도니! 제발 나타나!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_LookingForDoni
#. Speaker = Rikka
#. NodeID = db18f333-ff98-9a8a-ea59-91bf352617e2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 26a47c1c-a1cc-43c0-f402-ed93e6bc8b4d_Local1 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_LookingForDoni:db18f333-ff98-9a8a-ea59-91bf352617e2
msgctxt "h84d2b4a3gb0eeg4155g8461g49bd9776b68c"
msgid "Doni! It's time to come back now! DONI!"
msgstr "도니! 이만 돌아올 시간이야! <b>도니!</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_LootingGoblins
#. Speaker = Sharp-Eye Zami
#. NodeID = 56d92423-a5c0-e51e-a157-571afa2f94e5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_LootingGoblins:56d92423-a5c0-e51e-a157-571afa2f94e5
msgctxt "h0879ca42gf63fg4aebg8604gb44519c7d765"
msgid ""
"Nah. Raggedy bastards ain't got anythin' worth stealin'. 'Cept their horns."
msgstr "아니. 누더기 놈들은 뺏을 만한 게 하나도 없어. 뿔 말구."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_LootingGoblins
#. Speaker = Skrut
#. NodeID = 87a75b03-6962-3698-cc1c-398254fcbabf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_LootingGoblins:87a75b03-6962-3698-cc1c-398254fcbabf
msgctxt "h98ab8138g904fg48f0g9275g980416512ca7"
msgid "Find anythin' good?"
msgstr "뭐 좀 찾았냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_LootingGoblins
#. Speaker = Skrut
#. NodeID = 8ea311ed-aaba-26e1-0d81-ef9fe4b1d3a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_LootingGoblins:8ea311ed-aaba-26e1-0d81-ef9fe4b1d3a6
msgctxt "hc62a886eg82bbg4a2eg8120gd136872b778f"
msgid ""
"I'll swap you six kiddy horns for that big one you carved off the old fella."
msgstr "늙은이 머리에서 잘라낸 큰 뿔 하나 주면 꼬맹이 뿔 6개랑 바꿔 줄게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_LootingGoblins
#. Speaker = Skrut
#. NodeID = c66e74bc-aa92-7099-588c-cb2094deace4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_LootingGoblins:c66e74bc-aa92-7099-588c-cb2094deace4
msgctxt "h3bda4964g6b76g411aga28egaec1175f9700"
msgid "Nah. Gonna use that for a flagon."
msgstr "됐어. 이건 술잔으로 쓸거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_LoversOverTortured
#. Speaker = Bex
#. NodeID = 0e5724a9-4d38-17da-3ed7-5cd7954b0dff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_LoversOverTortured:0e5724a9-4d38-17da-3ed7-5cd7954b0dff
msgctxt "h0a5d7dccg6df2g4c90ga810g634595cf0b95"
msgid "Why? You'd just be in the way."
msgstr "왜? 괜히 방해만 될 거라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_LoversOverTortured
#. Speaker = Danis
#. NodeID = 20133815-3e63-f665-2ffa-f7a69dc790f8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4b4d2992-abb5-bd1b-9593-feb68eddf682_A = True
#. SetFlags:
#.   Local:
#.     - 4b4d2992-abb5-bd1b-9593-feb68eddf682_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_LoversOverTortured:20133815-3e63-f665-2ffa-f7a69dc790f8
msgctxt "h5dc32258gb4e7g4c0bg92edg3e03558fb078"
msgid "Beshaba pass over, look what they did to him."
msgstr "베샤바 맙소사, 놈들이 이 친구한테 한 짓 좀 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_LoversOverTortured
#. Speaker = Danis
#. NodeID = 215eb83d-7893-4548-25a0-3b20e506ec31
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_LoversOverTortured:215eb83d-7893-4548-25a0-3b20e506ec31
msgctxt "h839d1ee1g2430g4fbagacc0ge36b48fc411d"
msgid "I'm in the way down here too."
msgstr "어차피 여기서도 방해만 되는걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_LoversOverTortured
#. Speaker = Bex
#. NodeID = 2a41e8d8-57d9-a543-568d-669e321a04d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_LoversOverTortured:2a41e8d8-57d9-a543-568d-669e321a04d6
msgctxt "h1d252429gbc1cg4d35gb0fcgd26e7176c1ba"
msgid ""
"Aye. Goblins know a damn sight more about doing harm than I do about healing "
"it."
msgstr "그래. 내 치료법으론 망할 고블린놈들 해꼬지 수법에 비빌 수 없을 지경이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_LoversOverTortured
#. Speaker = Bex
#. NodeID = 5625e825-e078-2c1e-97a0-22f428572ce0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_LoversOverTortured:5625e825-e078-2c1e-97a0-22f428572ce0
msgctxt "h4a3458bcg16eag4594ga2edg811c026f7d6c"
msgid "Unless the goblins get in."
msgstr "고블린이 들이닥치지 않으면 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_LoversOverTortured
#. Speaker = Bex
#. NodeID = 8990b751-cf2b-bc39-311e-f4b104cbf49b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_LoversOverTortured:8990b751-cf2b-bc39-311e-f4b104cbf49b
msgctxt "hb477f21cga104g4271gbd43geda32229ab6e"
msgid ""
"Like what? We need to keep what supplies we have. We might need them before "
"the fighting's done."
msgstr "더 해준다니? 물자는 하나라도 더 아껴야 한다고. 이 싸움이 끝나기 전까진 언제고 쓰일 수 있잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_LoversOverTortured
#. Speaker = Danis
#. NodeID = aa218467-63f7-d1b7-fb35-6fcd5fc3cef8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_LoversOverTortured:aa218467-63f7-d1b7-fb35-6fcd5fc3cef8
msgctxt "h341d8504ga876g41d3g9063g20cc98bf55fb"
msgid "Is there something more we should be doing for him?"
msgstr "이 친구한테 뭐라도 더 해줄 만한 건 없을까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_LoversOverTortured
#. Speaker = Bex
#. NodeID = b8211f66-cce7-dd18-679e-e7c21cc22b57
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_LoversOverTortured:b8211f66-cce7-dd18-679e-e7c21cc22b57
msgctxt "he2d9c32fg6460g4f12gb054g78a5af637533"
msgid "Nonsense. I'll need you to hold any wounded down while I poke at them."
msgstr "그럴리가. 내가 환자 치료할 때 자기가 환자를 붙들고 있어 줘야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_LoversOverTortured
#. Speaker = Liam
#. NodeID = e113d47c-6423-f29e-ed37-96bc478d1ca1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4b4d2992-abb5-bd1b-9593-feb68eddf682_B = True
#. SetFlags:
#.   Local:
#.     - 4b4d2992-abb5-bd1b-9593-feb68eddf682_B = False
#.     - 4b4d2992-abb5-bd1b-9593-feb68eddf682_A = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_LoversOverTortured:e113d47c-6423-f29e-ed37-96bc478d1ca1
msgctxt "hc8702326gc5b9g4cc1gb4c4g7754a7e70c57"
msgid "*Groan.*"
msgstr "*신음 소리.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_LoversOverTortured
#. Speaker = Danis
#. NodeID = e433e0b9-0e9a-a6ca-4822-97baca7dfe62
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_LoversOverTortured:e433e0b9-0e9a-a6ca-4822-97baca7dfe62
msgctxt "he26fed2eg21c3g41acgaf90gaa20db8e6120"
msgid "You did well, love. At least he'll wake up to some friendly faces."
msgstr "자기는 충분히 잘 했어. 자기 덕분에 이 사람은 안전한 데서 눈을 뜰 거라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_LoversOverTortured
#. Speaker = Danis
#. NodeID = f3e15947-5457-1019-372a-d5623684aedf
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 4b4d2992-abb5-bd1b-9593-feb68eddf682_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_LoversOverTortured:f3e15947-5457-1019-372a-d5623684aedf
msgctxt "h635aa22cg7c06g4736g91ebgdf231a32be30"
msgid "I should be up on the wall."
msgstr "나도 방벽에 올라가 싸울까 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_LoversWithoutGuard
#. Speaker = Danis
#. NodeID = 1da64899-3af1-9713-95f3-0af2f3192874
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_LoversWithoutGuard:1da64899-3af1-9713-95f3-0af2f3192874
msgctxt "h474de912g2cc0g4dc1g87degac5b671a77f5"
msgid "Heh. I'm <i>your </i>lummox."
msgstr "헤. 그럼 넌 <i>멍청이</i> 애인이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_LoversWithoutGuard
#. Speaker = Bex
#. NodeID = 43b85243-c6e9-47ff-153b-5367716e9379
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_LoversWithoutGuard:43b85243-c6e9-47ff-153b-5367716e9379
msgctxt "h5fc954eega9efg4bc2ga35eg815527ce7781"
msgid "Hold still! I'll kiss you when you've stopped bleeding, you lummox."
msgstr "가만히 있어! 네 출혈만 멈추면 얼마든지 키스해 줄게, 멍청아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_LoversWithoutGuard
#. Speaker = Danis
#. NodeID = cb049e14-76d1-5370-65bd-e6039915af14
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_LoversWithoutGuard:cb049e14-76d1-5370-65bd-e6039915af14
msgctxt "h1a2c34e8gaf05g4963g89cag7f87bdb2f51b"
msgid "We did it. Come on, give me a kiss."
msgstr "우리가 해냈어. 자, 나한테 키스 좀 해 줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_LoversWithoutGuard
#. Speaker = Bex
#. NodeID = d62a8316-7c70-e7f8-7207-652a3ddba82a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_LoversWithoutGuard:d62a8316-7c70-e7f8-7207-652a3ddba82a
msgctxt "h6c688f42gdecfg4a42gae7agfac28aaaa4d3"
msgid "Yes, you are. Now stop squirming!"
msgstr "그래, 맞아. 이제 그만 꼼지락거려!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_PackingTraders
#. Speaker = Meli
#. NodeID = 0ae6881a-89c5-1dec-6d82-7262fccb5bb5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_PackingTraders:0ae6881a-89c5-1dec-6d82-7262fccb5bb5
msgctxt "hbdb6d3d7g8f52g4581gb930gabd3c6f13150"
msgid "Hands off, Mattis! I earned this!"
msgstr "손 대지 마, 매티스! 내가 얻은 거라고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_PackingTraders
#. Speaker = Mattis
#. NodeID = 924c1813-5b45-af34-472e-128a3beb9e4e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_PackingTraders:924c1813-5b45-af34-472e-128a3beb9e4e
msgctxt "he7fdccaag9e7eg4d99g98c7g258b480c54d5"
msgid "I <i>helped</i> you earn it."
msgstr "내 <i>도움으로</i> 얻은 거지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_PackingTraders
#. Speaker = Mattis
#. NodeID = c7e18a2d-eda4-5f10-9461-2eff1c395a85
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_PackingTraders:c7e18a2d-eda4-5f10-9461-2eff1c395a85
msgctxt "h21270b6cgc62fg4090gb721gb1125493f3a9"
msgid "Fine by me. I bet there's plenty of adults with loose pockets there."
msgstr "그러든가. 어차피 거긴 주머니 털어먹기 쉬운 어른들 널려있을걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_PackingTraders
#. Speaker = Meli
#. NodeID = e72161c8-c29c-d4cb-e71b-14e60180d02a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_PackingTraders:e72161c8-c29c-d4cb-e71b-14e60180d02a
msgctxt "hdbc75ee9gfa48g4bc4ga9adg49087de456e1"
msgid "Well, I'm stealin' on my own when we get to Baldur's Gate."
msgstr "그리 나오면 발더스 게이트에선 나 혼자 소매치기 다닐 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_PotionRaiders
#. Speaker = Booyahg Benta
#. NodeID = 12b8ae32-6e71-afb0-2516-8e7ce53cd6ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_PotionRaiders:12b8ae32-6e71-afb0-2516-8e7ce53cd6ac
msgctxt "hb7d4ce42g1dbag4c4cgabbag6915fcb2a989"
msgid "Wot did it taste like?"
msgstr "맛은 어땠어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_PotionRaiders
#. Speaker = Warrior Jawn
#. NodeID = 73a52482-4d2f-effd-fae2-5e599456c734
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_PotionRaiders:73a52482-4d2f-effd-fae2-5e599456c734
msgctxt "hed8bf515gcab9g4d4aga89cge2de9cc398cf"
msgid "Chewy worg-milk."
msgstr "쫄깃한 워그-우유 맛."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_PotionRaiders
#. Speaker = Booyahg Benta
#. NodeID = 8c87ade8-8bd0-71ba-0a3b-863e57a33f37
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_PotionRaiders:8c87ade8-8bd0-71ba-0a3b-863e57a33f37
msgctxt "hda8ebf0fgd399g471ag94a3g980d0291e2fe"
msgid ""
"I don't think that <i>were</i> a healing potion, mate. You don't look good."
msgstr "내가 볼 때 <i>그건</i> 치유 물약이 아니었어, 친구. 너 살짝 맛이 간 것 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_PotionRaiders
#. Speaker = Warrior Jawn
#. NodeID = acff432a-8335-d62c-1ced-973e55e279ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_PotionRaiders:acff432a-8335-d62c-1ced-973e55e279ea
msgctxt "h950af65dgecd9g4bdagb06bgcd37c3e53188"
msgid "Ungh. Think yer right."
msgstr "어억. 네 마알 대로야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_PotionRaiders
#. Speaker = Warrior Jawn
#. NodeID = f3e7876a-50b9-7fdc-4780-b5359301e87e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_PotionRaiders:f3e7876a-50b9-7fdc-4780-b5359301e87e
msgctxt "h6b2d1350g6d9fg4dedg8272g74be1137cdf1"
msgid "Funny tastin' healin' potion."
msgstr "재밌는 맛이 나는 '회복' 물약이잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_Prodigies
#. Speaker = Rolan
#. NodeID = 818a23eb-91fd-734e-2fa3-3fa858407584
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_Prodigies:818a23eb-91fd-734e-2fa3-3fa858407584
msgctxt "ha8a731eag623cg446ag9a0bgf150d2b1f7d7"
msgid ""
"My powers are being wasted back here! I could repel any attack in the blink "
"of an eye."
msgstr "내 능력이 여기서 썩고 있어! 난 어떤 공격도 눈 깜짝할 새에 막아낼 수 있다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_Prodigies
#. Speaker = Rolan
#. NodeID = 89e1dfcb-cc5e-6af5-e7ee-126c0be98fc0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_Prodigies:89e1dfcb-cc5e-6af5-e7ee-126c0be98fc0
msgctxt "h8b46a48cgf7d1g4054g983agc78cc1fdb077"
msgid "Ridiculous. Someone of my skill should choose their own vantage point."
msgstr "웃기지 마. 나같이 능력 있는 사람은 유리한 지점을 선택해야 한다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_Prodigies
#. Speaker = Cal
#. NodeID = baf687ff-d40c-10bb-3205-5bde015233d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_Prodigies:baf687ff-d40c-10bb-3205-5bde015233d8
msgctxt "h62432bb6gf36eg460cgb78ege336b9df8229"
msgid ""
"She just means you're our last hope, Rolan. We, eh, may need you to save the "
"day."
msgstr "롤란. 네가 우리의 마지막 희망이라는 뜻이야. 그러니까, 어, 오늘 하루 네 도움이 필요해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_Prodigies
#. Speaker = Lia
#. NodeID = d10c46ed-1222-0c51-9899-508889ca9687
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_Prodigies:d10c46ed-1222-0c51-9899-508889ca9687
msgctxt "h5d07cc2dg312dg4838gb8f1g4595fd4fd336"
msgid "Or wipe <i>us </i>out in the blink of an eye. Best you stay right here."
msgstr "아니면 눈 깜짝할 새에 <i>우리가</i> 쓸리게 하던가. 넌 여기 있는 게 최선이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_RaidersAtPool
#. Speaker = Goblin Sharp-Eye
#. NodeID = 102cb28a-14c7-3248-3f1c-2683801162ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_RaidersAtPool:102cb28a-14c7-3248-3f1c-2683801162ad
msgctxt "h0cb73533ga693g4b2fgbad8g5c91bc7dacce"
msgid "Cheat! You was sneakin' ale the whole time!"
msgstr "사기꾼! 계속해서 술을 훔쳐 마시고 있었잖아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_RaidersAtPool
#. Speaker = Warrior Trunk
#. NodeID = 19570bff-9939-181a-50d1-4487eef0e565
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_RaidersAtPool:19570bff-9939-181a-50d1-4487eef0e565
msgctxt "hfa012323g4e7dg4c98g8d34g50226ad447e3"
msgid "What're we talkin'? Time or amount?"
msgstr "뭘로? 오래 싸는지로, 아니면 많이 싸는지로?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_RaidersAtPool
#. Speaker = Goblin Sharp-Eye
#. NodeID = 19b3ff7f-e9ad-ab77-a9a9-92c7e2aab90b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_RaidersAtPool:19b3ff7f-e9ad-ab77-a9a9-92c7e2aab90b
msgctxt "h569195a1g4952g4d7fgb3f6g5dbc3a23db50"
msgid "Stop rushin' me."
msgstr "재촉하지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_RaidersAtPool
#. Speaker = Goblin Sharp-Eye
#. NodeID = 3bbe3b8c-d6ce-d88d-9856-f03326e2fe52
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - d0423454-cc51-ae8e-5096-cffd1aac9f75_A = True
#. SetFlags:
#.   Local:
#.     - d0423454-cc51-ae8e-5096-cffd1aac9f75_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_RaidersAtPool:3bbe3b8c-d6ce-d88d-9856-f03326e2fe52
msgctxt "h557093f4g8b9ag4cbdgbcb6g45a061e8d627"
msgid "You's ready?"
msgstr "준비 됐어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_RaidersAtPool
#. Speaker = Sharp-Eye Sneem
#. NodeID = 453f1fee-dc22-6438-7e9a-f19dabd96bc0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_RaidersAtPool:453f1fee-dc22-6438-7e9a-f19dabd96bc0
msgctxt "hb3fa987ag7841g4a03g8120gb3fb88a486a1"
msgid "You gonna measure it?"
msgstr "네가 재게?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_RaidersAtPool
#. Speaker = Goblin Sharp-Eye
#. NodeID = 487691e2-a380-3e97-eb5e-76ce2ca0a7ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_RaidersAtPool:487691e2-a380-3e97-eb5e-76ce2ca0a7ad
msgctxt "hcc944491ge98eg4cc6g94aeg01372a7af6e9"
msgid "Go!"
msgstr "가자!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_RaidersAtPool
#. Speaker = Goblin Sharp-Eye
#. NodeID = 552415c8-0f51-2e6f-7f4d-f1efce24661a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_RaidersAtPool:552415c8-0f51-2e6f-7f4d-f1efce24661a
msgctxt "hc1b44d44g5e91g4ecdga4dfgf1bdf91f64ba"
msgid "Huh?"
msgstr "허?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_RaidersAtPool
#. Speaker = Sharp-Eye Sneem
#. NodeID = 582d3471-c646-1bfe-137c-b9221abb2f16
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_RaidersAtPool:582d3471-c646-1bfe-137c-b9221abb2f16
msgctxt "h4721f928g4f50g4f1dgaaccg3fa9c8270d07"
msgid "Hurry! I'm fixin' to burst!"
msgstr "빨리! 터질 것 같아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_RaidersAtPool
#. Speaker = Sharp-Eye Sneem
#. NodeID = 60d7807b-81d9-7e10-326c-8ac3281d1e2f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - d0423454-cc51-ae8e-5096-cffd1aac9f75_B = True
#. SetFlags:
#.   Local:
#.     - d0423454-cc51-ae8e-5096-cffd1aac9f75_B = False
#.     - d0423454-cc51-ae8e-5096-cffd1aac9f75_A = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_RaidersAtPool:60d7807b-81d9-7e10-326c-8ac3281d1e2f
msgctxt "hdd9ad10ageaa1g4bf0gbcdcgaa4d688ea25c"
msgid "Ha! I win!"
msgstr "하! 내가 이겼다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_RaidersAtPool
#. Speaker = Goblin Sharp-Eye
#. NodeID = 7804f502-aed0-006b-e4aa-d05ed43fde7a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_RaidersAtPool:7804f502-aed0-006b-e4aa-d05ed43fde7a
msgctxt "h783823a0g934eg4fbbgb171g2fd1bbaf900d"
msgid "It don't count. It don't count!"
msgstr "그건 인정 안 해. 인정 안 해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_RaidersAtPool
#. Speaker = Goblin Sharp-Eye
#. NodeID = b1dd850d-0703-dc2e-0560-5e60a54bb68a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_RaidersAtPool:b1dd850d-0703-dc2e-0560-5e60a54bb68a
msgctxt "h7e653d6agb55cg47fcg8558g8318a7e54007"
msgid "Set..."
msgstr "준비..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_RaidersAtPool
#. Speaker = Warrior Trunk
#. NodeID = b6a40207-c510-d3ec-6a43-bd85a504ef2c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_RaidersAtPool:b6a40207-c510-d3ec-6a43-bd85a504ef2c
msgctxt "h0cc4e5b2gc057g43adg9f25geffdfd12390f"
msgid "Are we goin' by amount o' piss or not?"
msgstr "오줌 많이 싸기로 하는 거냐, 아니냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_RaidersAtPool
#. Speaker = Sharp-Eye Sneem
#. NodeID = cafe686f-5ae1-d025-4e91-77fcb4e60bc8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_RaidersAtPool:cafe686f-5ae1-d025-4e91-77fcb4e60bc8
msgctxt "hda372e82g821cg45b7g91edg7da1ba2f546c"
msgid "AHH!"
msgstr "아아아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_RaidersAtPool
#. Speaker = Sharp-Eye Sneem
#. NodeID = cc45cad2-7222-2717-81a3-b9e6530c775b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_RaidersAtPool:cc45cad2-7222-2717-81a3-b9e6530c775b
msgctxt "hace581ecg0020g4b66gb654ge49be303c33f"
msgid "That's called strategy."
msgstr "그게 바로 전략이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_RaidersAtPool
#. Speaker = Goblin Sharp-Eye
#. NodeID = de5fbcb4-87be-e824-2424-191107f2e3e0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - d0423454-cc51-ae8e-5096-cffd1aac9f75_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_RaidersAtPool:de5fbcb4-87be-e824-2424-191107f2e3e0
msgctxt "h2f793d9dgcb43g4d36ga48dg24b94f69eaf8"
msgid "How's about we make this a competition, boys?"
msgstr "얘들아, 이걸로 대회나 해 볼까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_RaidersAtPool
#. Speaker = Warrior Trunk
#. NodeID = ffa60338-7322-66f6-190f-bc32dc97f505
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_RaidersAtPool:ffa60338-7322-66f6-190f-bc32dc97f505
msgctxt "hc46a5f76gde99g4284g8cb2g66557346f09e"
msgid "Oh. Time it is."
msgstr "아, 그럼 오래 싸는걸로."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_Refugees
#. Speaker = Ikaron
#. NodeID = 111de158-ec50-b3ed-94da-48beb7d36a42
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - c3d825d1-49b8-9ae2-4554-4fc1f55d2eee_LocalA = True
#. SetFlags:
#.   Local:
#.     - c3d825d1-49b8-9ae2-4554-4fc1f55d2eee_LocalB = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_Refugees:111de158-ec50-b3ed-94da-48beb7d36a42
msgctxt "h8744aad4g1cb1g49adga2d2g70673112e497"
msgid ""
"Look on the bright side, mother - should be fewer mouths to feed after today."
msgstr "긍정적으로 생각하죠, 엄마. 공격 이후엔 먹여 살릴 군식구는 줄어들겠어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_Refugees
#. Speaker = Danis
#. NodeID = 44f27b94-9dc5-ac83-0bdb-33e904c6d8fa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - c3d825d1-49b8-9ae2-4554-4fc1f55d2eee_LocalB = True
#. SetFlags:
#.   Local:
#.     - c3d825d1-49b8-9ae2-4554-4fc1f55d2eee_LocalA = False
#.     - c3d825d1-49b8-9ae2-4554-4fc1f55d2eee_LocalB = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_Refugees:44f27b94-9dc5-ac83-0bdb-33e904c6d8fa
msgctxt "h9d949327g4e0eg4603g89d9g56d1e6fb5382"
msgid "Would you... like to pray, or something?"
msgstr "저기... 기도 같은 거라도 좀 할까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_Refugees
#. Speaker = Ikaron
#. NodeID = 4ba9f004-93b0-44db-feb4-bd163f8e07b2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_Refugees:4ba9f004-93b0-44db-feb4-bd163f8e07b2
msgctxt "h2cdd1e18g1ea8g4f6egb77dg7ef24d19cb5b"
msgid "Then why aren't you on the wall?"
msgstr "그럼 왜 그 솜씨로 경비 안 서냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_Refugees
#. Speaker = Danis
#. NodeID = 522a69db-9b4a-1d7b-2ef5-63761f5fb8d5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_Refugees:522a69db-9b4a-1d7b-2ef5-63761f5fb8d5
msgctxt "had6cbeedg6750g4b1eg8d63g9d6baf804884"
msgid "Right. Silence it is."
msgstr "그래. 입 닫고 있을게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_Refugees
#. Speaker = Okta
#. NodeID = 7484055e-df5f-6d4b-73ba-18c64522143e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - c3d825d1-49b8-9ae2-4554-4fc1f55d2eee_LocalA = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_Refugees:7484055e-df5f-6d4b-73ba-18c64522143e
msgctxt "h4a89a6a7g107eg4e3bgbd5ageb57915fdace"
msgid "So you have experience treating the wounded?"
msgstr "그래, 부상자를 치료해 본 경험은 있니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_Refugees
#. Speaker = Danis
#. NodeID = 98987352-1e13-9ca3-f8b0-3f105012837b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_Refugees:98987352-1e13-9ca3-f8b0-3f105012837b
msgctxt "hc0511f02g4312g4e68g8eaegffbd3fab57f5"
msgid "Rabbits don't shoot back, do they?"
msgstr "토끼랑 다르게 적은 반격하잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_Refugees
#. Speaker = Bex
#. NodeID = a4df463b-1efa-d1ca-abb8-88babc469537
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_Refugees:a4df463b-1efa-d1ca-abb8-88babc469537
msgctxt "h0f87232eg8d9fg4396g85f4gd1e92e97680f"
msgid "Sure. Were you a cook in Elturel?"
msgstr "그렇죠. 그쪽은 엘투렐에서 요리사였어요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_Refugees
#. Speaker = Danis
#. NodeID = bf8d6e9a-0ff6-d2f4-1dc4-9822f6ff8814
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_Refugees:bf8d6e9a-0ff6-d2f4-1dc4-9822f6ff8814
msgctxt "h2432cd1dgbcdeg4fbdga55bgd05e772fbbb4"
msgid "Well. In a pinch."
msgstr "뭐, 여차할 땐 그렇지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_Refugees
#. Speaker = Okta
#. NodeID = c5657030-2f8a-419d-f6af-92b242eb81f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_Refugees:c5657030-2f8a-419d-f6af-92b242eb81f5
msgctxt "hc7f89e3eg1314g4520g8835g98e60de320d2"
msgid "You've had my food, right? Answer's in the gruel."
msgstr "내가 만든 음식 먹어봤을 텐데. 죽 맛을 보면 알잖냐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_Refugees
#. Speaker = Okta
#. NodeID = c964c6ae-cd89-294d-a0f7-09c685ab6490
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_Refugees:c964c6ae-cd89-294d-a0f7-09c685ab6490
msgctxt "h3dc70a05g3e4eg4b32gb202g0e1f08b376b6"
msgid "Ikaron, please."
msgstr "이카론, 그만해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_Refugees
#. Speaker = Okta
#. NodeID = cb3d3f80-aca1-fc3c-5243-ebc07e472366
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_Refugees:cb3d3f80-aca1-fc3c-5243-ebc07e472366
msgctxt "hf43d04c8gc184g4765g950cgf2e4d890ae5f"
msgid "Just good with a needle and thread?"
msgstr "그럼 그냥 바느질만 할 줄 아는 게야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_Refugees
#. Speaker = Bex
#. NodeID = ce13ca55-af08-ec76-60ee-02b8da101ba8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_Refugees:ce13ca55-af08-ec76-60ee-02b8da101ba8
msgctxt "h74281b1ag2356g4bccg92c3g609b54aaa7c4"
msgid "Well... not exactly."
msgstr "뭐... 딱히 없는데요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_Refugees
#. Speaker = Ikaron
#. NodeID = e12c594a-1a26-7520-a4ac-93fb02dc85d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_Refugees:e12c594a-1a26-7520-a4ac-93fb02dc85d8
msgctxt "he306c972g7916g45afga3a2gf0118d10d162"
msgid "No."
msgstr "됐어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_Refugees
#. Speaker = Bex
#. NodeID = f1dc72a2-ebf3-b107-37e2-444291296593
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_Refugees:f1dc72a2-ebf3-b107-37e2-444291296593
msgctxt "hf646e0cdg556bg4bdfgb9f8gc66221881978"
msgid "Danis can hunt! Sharp as an elf with that bow, aren't you love?"
msgstr "다니스는 사냥할 줄 알아! 활 솜씨가 엘프 못지않다고. 그치, 자기야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_RikkaAndDoni
#. Speaker = Doni
#. NodeID = 44703de6-9f12-42ed-837b-c2ba319471c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_RikkaAndDoni:44703de6-9f12-42ed-837b-c2ba319471c6
msgctxt "h6d504417gbdfcg460bg8ce3ga3d2078a1ae4"
msgid "*Grunt.*"
msgstr "*끙.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_RikkaAndDoni
#. Speaker = Rikka
#. NodeID = 6415690a-7fb5-3103-32c5-9b59b7dd8668
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_RikkaAndDoni:6415690a-7fb5-3103-32c5-9b59b7dd8668
msgctxt "h6de08b47g7b5ag482cg8ffbgd54e618fe527"
msgid "There you are! Thank the gods. Enjoyed your little adventure, did you?"
msgstr "왔구나! 신님들, 감사합니다. 어디서 모험 신나게 즐기고 온 모양이구나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_RikkaAndDoni
#. Speaker = Rikka
#. NodeID = 9e1c6a7f-db1e-49cb-67f7-b6665525ffd8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_RikkaAndDoni:9e1c6a7f-db1e-49cb-67f7-b6665525ffd8
msgctxt "h6869b77cgcb0ag49e0g9b0eg80a71776a920"
msgid "Let's get you below. You can tell everyone about it, hm?"
msgstr "이만 아래쪽으로 가자. 모두한테 얘기 들려주고 그러렴, 응?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_Sappers
#. Speaker = Sapper Moke
#. NodeID = 38c0a593-5457-c21e-6ae5-f409d3ebac73
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_Sappers:38c0a593-5457-c21e-6ae5-f409d3ebac73
msgctxt "h0a38064age7d0g4cc7g8cbfg07bff6747f46"
msgid "Are we gonna blow this place to bits or wot?"
msgstr "여기 날려버릴 거야 말거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_Sappers
#. Speaker = Sapper Dextor
#. NodeID = 8c7ea443-09ca-f4c4-62f0-f16f2a016fe1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_Sappers:8c7ea443-09ca-f4c4-62f0-f16f2a016fe1
msgctxt "hb93281bbgd8ebg495cgb6fcg21b6b55b0137"
msgid "Not unless the drow tells us to."
msgstr "드로우의 명령이 있어야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_Sappers
#. Speaker = Sapper Gald
#. NodeID = fd9a444f-dbce-9584-8def-a518feeaaf79
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_Sappers:fd9a444f-dbce-9584-8def-a518feeaaf79
msgctxt "h3bb82036gaca6g4ef5gb1a7g9d5fb3fccd3a"
msgid ""
"Let's just keep out of her way. She's smiling. I get scared when she smiles."
msgstr "그냥 길을 비켜주자. 웃고있잖아. 저 여자가 웃으면 무섭다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_StupidAndDummy
#. Speaker = Sharp-Eye Eef
#. NodeID = 16351a7f-1d7a-59a3-7f4d-815438b56aec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_StupidAndDummy:16351a7f-1d7a-59a3-7f4d-815438b56aec
msgctxt "ha11f435bg954ag4ce7gbf9ag42eefc472a9f"
msgid "You sure about that?"
msgstr "확실해?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_StupidAndDummy
#. Speaker = Sharp-Eye Eef
#. NodeID = 7f173e8c-9720-7af1-2ac6-28abef281308
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_StupidAndDummy:7f173e8c-9720-7af1-2ac6-28abef281308
msgctxt "hdd266705gd9f0g4243g95d9g6e7671680d38"
msgid "I'll stab yer eyes out!"
msgstr "네 눈을 찔러 주마!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_StupidAndDummy
#. Speaker = Tracker Azak
#. NodeID = aca7eef9-ca2f-6721-f725-152a593f055b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_StupidAndDummy:aca7eef9-ca2f-6721-f725-152a593f055b
msgctxt "h228f5780g1283g4a3bg90d4ge27dfbeea298"
msgid "It ain't got eyes, you muck-skull. It ain't even alive!"
msgstr "눈이 없잖아, 이 띨빡아. 살아있지도 않다고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_StupidAndDummy
#. Speaker = Tracker Azak
#. NodeID = cb588c63-edb7-bb7c-0dda-40c535478ef8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_StupidAndDummy:cb588c63-edb7-bb7c-0dda-40c535478ef8
msgctxt "hd508a2beg9feag49e6g98b2g81b7197ef4a8"
msgid "Stop messin' about and get back to work!"
msgstr "그만 노닥거리고 일이나 해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAndGatekeeper
#. Speaker = Asharak
#. NodeID = 03805018-b1ad-1cbd-d0fc-85d1df6b5858
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 98423a2d-7b47-e379-6526-c435773e3cff_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAndGatekeeper:03805018-b1ad-1cbd-d0fc-85d1df6b5858
msgctxt "hf74cc8b7gace8g4775g8d58gd43313e60bde"
msgid "Holding up all right?"
msgstr "잘 지내고 있어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAndGatekeeper
#. Speaker = Elegis
#. NodeID = 099e0465-7e9a-a67b-7e85-df2d5c9523fd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 98423a2d-7b47-e379-6526-c435773e3cff_C = True
#. SetFlags:
#.   Local:
#.     - 98423a2d-7b47-e379-6526-c435773e3cff_A = False
#.     - 98423a2d-7b47-e379-6526-c435773e3cff_B = False
#.     - 98423a2d-7b47-e379-6526-c435773e3cff_C = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAndGatekeeper:099e0465-7e9a-a67b-7e85-df2d5c9523fd
msgctxt "hf243095ag90d1g4478gbb96gf86953b660e2"
msgid "Nock. Draw. <i>Breathe</i>. Loose."
msgstr "시위 걸고. 당기고. <i>숨 들이쉬고</i>. 발사."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAndGatekeeper
#. Speaker = Elegis
#. NodeID = 29d5a132-8a4e-6b56-9e2f-2c87b2e023d3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAndGatekeeper:29d5a132-8a4e-6b56-9e2f-2c87b2e023d3
msgctxt "hea07a923gca5ag47c8g961bge914e08f10b1"
msgid "Yeah. Yeah, fine day for it."
msgstr "그래. 맞아, 더할 나위 없는 날이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAndGatekeeper
#. Speaker = Asharak
#. NodeID = 2cf12e0f-f541-dbf9-ce01-2ba09a50131f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAndGatekeeper:2cf12e0f-f541-dbf9-ce01-2ba09a50131f
msgctxt "h2771c1ecg5049g4453gabb4g72be906694de"
msgid ""
"It's this, or sitting and waiting. So I'll be back, if it's all the same to "
"you."
msgstr "죽치고 앉아있는 거보단 이게 낫다고. 이따 또 올 거야. 너만 괜찮다면 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAndGatekeeper
#. Speaker = Elegis
#. NodeID = 34eb83f4-7c40-256b-95df-a319d1224563
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAndGatekeeper:34eb83f4-7c40-256b-95df-a319d1224563
msgctxt "h7e56bf61g541dg4c08g9a50g9789d0d737df"
msgid "What does that mean?"
msgstr "그게 무슨 뜻이야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAndGatekeeper
#. Speaker = Elegis
#. NodeID = 78670912-d7cc-f5fb-695d-803f58619727
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAndGatekeeper:78670912-d7cc-f5fb-695d-803f58619727
msgctxt "h5da72461gbc1cg49bdg897bg7dc6568a9aa9"
msgid "Nock. Draw. <i>Breathe</i>. Loose."
msgstr "시위 걸고. 당기고. <i>숨 들이쉬고</i>. 발사."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAndGatekeeper
#. Speaker = Asharak
#. NodeID = 8b1f2e0d-b84a-241c-e98c-f12390129964
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAndGatekeeper:8b1f2e0d-b84a-241c-e98c-f12390129964
msgctxt "h48dd455cgad99g4d12ga42dge329e0489399"
msgid "Not a notion. Talking beats thinking, though."
msgstr "별 뜻 없어. 잡념보단 혼잣말이 낫겠어서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAndGatekeeper
#. Speaker = Elegis
#. NodeID = 9f7fe9b9-8b7e-12e0-3ee6-1367f10cee00
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 98423a2d-7b47-e379-6526-c435773e3cff_A = True
#. SetFlags:
#.   Local:
#.     - 98423a2d-7b47-e379-6526-c435773e3cff_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAndGatekeeper:9f7fe9b9-8b7e-12e0-3ee6-1367f10cee00
msgctxt "h599a825dgafb6g4c33ga69ag5044a6777350"
msgid "You've actually fought goblins before, haven't you?"
msgstr "그쪽은 예전에 고블린이랑 실제로 싸워본 경험 있지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAndGatekeeper
#. Speaker = Asharak
#. NodeID = a356f7e6-913a-3655-0ba3-5e86a29e4fcc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAndGatekeeper:a356f7e6-913a-3655-0ba3-5e86a29e4fcc
msgctxt "hfde14a29gf7a4g48efgb453gb673436c135c"
msgid "Hah - sounds <i>exactly </i>the same, then."
msgstr "하, 그럼 <i>정확히</i> 나랑 똑같은데 뭘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAndGatekeeper
#. Speaker = Asharak
#. NodeID = d014cd10-ea48-2789-c689-1e5da679eb8e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAndGatekeeper:d014cd10-ea48-2789-c689-1e5da679eb8e
msgctxt "h23ce516bg89a0g4116gb6b3g848216650929"
msgid "So have you, if I'm not mistaken."
msgstr "내 기억으론, 너도 마찬가지잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAndGatekeeper
#. Speaker = Elegis
#. NodeID = d402998f-3d90-2938-3c50-d7e99ccfa3ba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAndGatekeeper:d402998f-3d90-2938-3c50-d7e99ccfa3ba
msgctxt "h7ffb74a8ga5dag455aga1b3g4dcb77642401"
msgid "I'm fine. You don't have to keep checking."
msgstr "난 괜찮아. 계속 그렇게 확인 안 해도 돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAndGatekeeper
#. Speaker = Elegis
#. NodeID = d504e129-c1f6-1f54-728e-4cee9eb720bd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAndGatekeeper:d504e129-c1f6-1f54-728e-4cee9eb720bd
msgctxt "h695f0ce4gf551g4354g98e4gfc98edef87ae"
msgid "That wasn't - that's not the same. I was terrified the whole time."
msgstr "그건 좀... 경우가 다르지. 난 싸우는 내내 겁에 질려있었다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAndGatekeeper
#. Speaker = Asharak
#. NodeID = f769198b-7ce0-1355-4d07-f52efa58b584
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 98423a2d-7b47-e379-6526-c435773e3cff_B = True
#. SetFlags:
#.   Local:
#.     - 98423a2d-7b47-e379-6526-c435773e3cff_C = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAndGatekeeper:f769198b-7ce0-1355-4d07-f52efa58b584
msgctxt "hdb0eceb8g1613g4d87ga88ag6e540cfbdcd9"
msgid "Fine day for it, I reckon."
msgstr "더할 나위 없는 날인 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAtBarricade
#. Speaker = Kaldani
#. NodeID = 2edf72fe-e3c7-c96d-b940-2db3493ae391
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAtBarricade:2edf72fe-e3c7-c96d-b940-2db3493ae391
msgctxt "h2d353055g2ddeg40d7g871dg623a2079f7a7"
msgid "Ah. Hadn't actually thought of that."
msgstr "아, 거기까진 미처 생각 못 했네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAtBarricade
#. Speaker = Kaldani
#. NodeID = 3456b935-496a-a52f-163c-626529b340a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAtBarricade:3456b935-496a-a52f-163c-626529b340a7
msgctxt "h53dc44d6gc9d5g4f09gaf02gde4d7696fc32"
msgid "Seems a good use of them, to me."
msgstr "나는 요긴하게 잘 썼다고 보는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAtBarricade
#. Speaker = Asharak
#. NodeID = 424a3424-7161-3f00-f535-771efff6ccce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAtBarricade:424a3424-7161-3f00-f535-771efff6ccce
msgctxt "hccac0677g7648g4d3bg8206gdbe1ecca1294"
msgid "Don't think Halsin'd fancy us pulling up his grove."
msgstr "우리가 자기 숲 베어대는 걸 할신이 고깝게 볼 거 같냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAtBarricade
#. Speaker = Asharak
#. NodeID = 6c9e23fd-9957-0f0c-f5dc-4f56b7c48b6b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAtBarricade:6c9e23fd-9957-0f0c-f5dc-4f56b7c48b6b
msgctxt "hc0724b26ga8a9g4348gb7e2gc9a2eba80902"
msgid "Depends which side of it you're standing on, I suppose."
msgstr "그거야 어느 편이느냐에 따라 의미가 달라지겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAtBarricade
#. Speaker = Asharak
#. NodeID = 74a8a9dd-d10f-f6d9-cb1c-6cd0d20ddc72
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - b70d5139-9980-efc6-3ba3-fe2eb56ab2e0_A = True
#. SetFlags:
#.   Local:
#.     - b70d5139-9980-efc6-3ba3-fe2eb56ab2e0_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAtBarricade:74a8a9dd-d10f-f6d9-cb1c-6cd0d20ddc72
msgctxt "hdddd1683g39c7g4d20g8e5fg6a337bd4a90a"
msgid "I suppose it's a pity to tear down trees for this."
msgstr "나무들을 이런 용도로 베게 되어 안타깝다 싶군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAtBarricade
#. Speaker = Kaldani
#. NodeID = 7e454ec2-5be6-fa5c-e8b0-64a8182ce43f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAtBarricade:7e454ec2-5be6-fa5c-e8b0-64a8182ce43f
msgctxt "h5c467a48gcc7bg428bgb17fg71c71e732ef9"
msgid "Is that good or bad?"
msgstr "그래서 좋단 거야, 나쁘단 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAtBarricade
#. Speaker = Kaldani
#. NodeID = 859f3a8d-b509-f7a4-26c2-11cf93114687
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAtBarricade:859f3a8d-b509-f7a4-26c2-11cf93114687
msgctxt "h85f5ccc3gb22eg4ee8g808fge1a33ad1a127"
msgid "For sticking goblin heads on."
msgstr "고블린들 머리 꿰이라고 해놓았지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAtBarricade
#. Speaker = Asharak
#. NodeID = 8daa53f1-9f05-ee14-a73f-6ec8b759620d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - b70d5139-9980-efc6-3ba3-fe2eb56ab2e0_B = True
#. SetFlags:
#.   Local:
#.     - b70d5139-9980-efc6-3ba3-fe2eb56ab2e0_A = False
#.     - b70d5139-9980-efc6-3ba3-fe2eb56ab2e0_B = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAtBarricade:8daa53f1-9f05-ee14-a73f-6ec8b759620d
msgctxt "h3daad234gd625g45d1g987egadcf35cf7a5f"
msgid "What're all the spikes about?"
msgstr "이 뾰족한 것들은 다 뭐야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAtBarricade
#. Speaker = Asharak
#. NodeID = d3ec0892-88cb-01c5-74e2-c9cb68a24321
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - b70d5139-9980-efc6-3ba3-fe2eb56ab2e0_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAtBarricade:d3ec0892-88cb-01c5-74e2-c9cb68a24321
msgctxt "h694375aeg7542g4aa1g8f76gf834b8f380b0"
msgid "Torm spare me, that thing looks fearsome."
msgstr "토름 님 맙소사. 거 참 살벌해 보이는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAtBarricade
#. Speaker = Asharak
#. NodeID = d3ee4c5d-8b2b-c20e-4d14-261939010fb1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAtBarricade:d3ee4c5d-8b2b-c20e-4d14-261939010fb1
msgctxt "ha5ed635cg459cg43a9g8a95g0bb5b9a240be"
msgid "Right. Keep at it, then."
msgstr "좋네. 그럼 계속 수고해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAtOilBarrels
#. Speaker = Guex
#. NodeID = 0b3536e9-5596-ee3a-4fc2-af76e65b5b42
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAtOilBarrels:0b3536e9-5596-ee3a-4fc2-af76e65b5b42
msgctxt "h98676dc6g8bf2g4dacg8bf3g9c240f241b45"
msgid "What happens if they attack before we get the signal?"
msgstr "소리 듣기도 전에 놈들한테 공격당하면 어쩌죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAtOilBarrels
#. Speaker = Pandirna
#. NodeID = 0f2ffecb-fbb8-2594-fd57-c8917ff3cdfb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAtOilBarrels:0f2ffecb-fbb8-2594-fd57-c8917ff3cdfb
msgctxt "hd0198153gd25bg4fe9g9ac2g1c4adefb3817"
msgid "<i>'Yes sir'.</i>"
msgstr "<i>'넷슴다, 대장'.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAtOilBarrels
#. Speaker = Guex
#. NodeID = 13322d64-8705-0b61-dc5d-7e6cb6a31757
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAtOilBarrels:13322d64-8705-0b61-dc5d-7e6cb6a31757
msgctxt "he3cdfcc9gc6beg475cgb3a6gb3145c728521"
msgid "Yes sir!"
msgstr "네, 대장!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAtOilBarrels
#. Speaker = Asharak
#. NodeID = 173d6829-075f-cf0d-073a-65b3bb2acc74
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 7082b286-d565-770b-33c6-8cd28be37fc6_B = True
#. SetFlags:
#.   Local:
#.     - 7082b286-d565-770b-33c6-8cd28be37fc6_B = False
#.     - 7082b286-d565-770b-33c6-8cd28be37fc6_A = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAtOilBarrels:173d6829-075f-cf0d-073a-65b3bb2acc74
msgctxt "hfe76719bg63c9g43a2g83beg84c03825e333"
msgid "Looking well, folks - keep it up."
msgstr "잘하고 있군, 친구들. 이대로만 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAtOilBarrels
#. Speaker = Guex
#. NodeID = 69f1879a-5c3b-2f15-6eba-e2ebb585553e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAtOilBarrels:69f1879a-5c3b-2f15-6eba-e2ebb585553e
msgctxt "h71899734gc27cg44f7ga1d7g942f7cfd1e90"
msgid "Shut it, you - and help me with these barrels."
msgstr "넌 좀 다물어. 여기 통 옮기는 거나 도와."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAtOilBarrels
#. Speaker = Asharak
#. NodeID = 7097bb32-a393-b14f-305b-5973073adec0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAtOilBarrels:7097bb32-a393-b14f-305b-5973073adec0
msgctxt "h67e3ac78g73acg4463gaa3dgabe1f10dff60"
msgid ""
"Good. Reckon we can brave a few nights without lamp-light if it means "
"burning these buggers."
msgstr "좋아. 그 망할 새끼들을 불살라버릴 수만 있다면, 며칠 등불 없이 지내는 건 감수할 수 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAtOilBarrels
#. Speaker = Asharak
#. NodeID = 9dcef5b2-cabc-85d8-5bc1-d246aaec80ee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAtOilBarrels:9dcef5b2-cabc-85d8-5bc1-d246aaec80ee
msgctxt "hff2648a8g4ab4g421bg8d02gc6029fccdba1"
msgid "I'm not 'sir'. I was a doorjack in Elturel."
msgstr "'대장'이라 하지 마. 난 엘투렐에선 그냥 문지기였다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAtOilBarrels
#. Speaker = Asharak
#. NodeID = a7300d12-e5be-228c-9b81-79784a151da3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAtOilBarrels:a7300d12-e5be-228c-9b81-79784a151da3
msgctxt "hfe0bfaf2gba4bg4d0bgb96eg2aea8e1f67fd"
msgid "I reckon you'll hear <i>something.</i>"
msgstr "그 지경이면 <i>뭐라도</i> 듣게 될 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAtOilBarrels
#. Speaker = Asharak
#. NodeID = c096393f-7456-f494-77c9-8254002bd0cb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 7082b286-d565-770b-33c6-8cd28be37fc6_A = True
#. SetFlags:
#.   Local:
#.     - 7082b286-d565-770b-33c6-8cd28be37fc6_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAtOilBarrels:c096393f-7456-f494-77c9-8254002bd0cb
msgctxt "h4763ada9g85f1g46d7gb0ccgb8eb873234ba"
msgid "Remember - get down to the cave as soon as you hear the horn."
msgstr "명심해. 뿔나팔 소리가 들리면 너희는 바로 동굴로 내려가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAtOilBarrels
#. Speaker = Asharak
#. NodeID = e98f263c-f312-5610-0998-e5c8304d275f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 7082b286-d565-770b-33c6-8cd28be37fc6_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAtOilBarrels:e98f263c-f312-5610-0998-e5c8304d275f
msgctxt "hcd83e589g9566g4549ga814g09845c1233fd"
msgid "Almost done?"
msgstr "다 끝나 가나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAtOilBarrels
#. Speaker = Pandirna
#. NodeID = ea485204-a491-4c00-746e-bd1502b5a715
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_TrainerAtOilBarrels:ea485204-a491-4c00-746e-bd1502b5a715
msgctxt "h4fb6f51ag1d4ag48cbg8eaag793d46bfb34d"
msgid "Nearly. We've ransacked the packs for anything that'll burn."
msgstr "거의요. 불에 탈 만한 건 뭐든 탈탈 뒤져 모았어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ViolentAtPool
#. Speaker = Goblin Sharp-Eye
#. NodeID = 4d5730f9-14c5-142f-e60c-c2288e8df23c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 92fb7118-3520-ad29-7cb9-12f73195512f_C = True
#. SetFlags:
#.   Local:
#.     - 92fb7118-3520-ad29-7cb9-12f73195512f_A = False
#.     - 92fb7118-3520-ad29-7cb9-12f73195512f_B = False
#.     - 92fb7118-3520-ad29-7cb9-12f73195512f_C = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ViolentAtPool:4d5730f9-14c5-142f-e60c-c2288e8df23c
msgctxt "hd54c28b8gf6ddg4262g936ag5ce86a0d26c9"
msgid "If so, uh, sorry."
msgstr "그러면, 엇, 죄송합니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ViolentAtPool
#. Speaker = Goblin Sharp-Eye
#. NodeID = 7b70db42-ff22-ccad-cd36-69f82ad3fb3c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 92fb7118-3520-ad29-7cb9-12f73195512f_A = True
#. SetFlags:
#.   Local:
#.     - 92fb7118-3520-ad29-7cb9-12f73195512f_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ViolentAtPool:7b70db42-ff22-ccad-cd36-69f82ad3fb3c
msgctxt "h3c05ff60g5862g4da4g8181g6feac20f25b1"
msgid "Hope not. That'd be kinda weird."
msgstr "안 그랬으면 좋겠어. 좀 이상할 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ViolentAtPool
#. Speaker = Goblin Sharp-Eye
#. NodeID = 7da8448f-cd7c-93e8-f152-91af4740874d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 92fb7118-3520-ad29-7cb9-12f73195512f_B = True
#. SetFlags:
#.   Local:
#.     - 92fb7118-3520-ad29-7cb9-12f73195512f_C = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ViolentAtPool:7da8448f-cd7c-93e8-f152-91af4740874d
msgctxt "h50515fadg2b68g4d88gb0aeg467b70d770ce"
msgid "Wonder if the Absolute can hear me."
msgstr "절대자께서 내 목소리를 들으실지 궁금하네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ViolentAtPool
#. Speaker = Goblin Sharp-Eye
#. NodeID = a0cefe4d-ac09-7e32-635c-50638b28900a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 92fb7118-3520-ad29-7cb9-12f73195512f_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_ViolentAtPool:a0cefe4d-ac09-7e32-635c-50638b28900a
msgctxt "h536a492fg62b9g4ac7g8084gbd0d0a0a8277"
msgid "Think the gods are seein' this?"
msgstr "신들이 이걸 보고 있을까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_WarchiefAndLooters
#. Speaker = Rozzak
#. NodeID = 42e19577-bda4-a376-a641-716ad5e241c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_WarchiefAndLooters:42e19577-bda4-a376-a641-716ad5e241c4
msgctxt "heb09f0ccg27b9g4cfagb56cg8d81d94d3714"
msgid "You serious? Stuff something in yer nose and hurry up."
msgstr "장난하냐? 코에 아무거나 틀어 막고 빨리 움직여!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_WarchiefAndLooters
#. Speaker = Rozzak
#. NodeID = 793c6176-f149-5a0e-f399-25477bbd04ef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_WarchiefAndLooters:793c6176-f149-5a0e-f399-25477bbd04ef
msgctxt "hb322ad8bgd47bg4d82gb114g67c9897c3650"
msgid "What's taking you two so long? Get the goods and get moving!"
msgstr "너희 두 놈, 왜 이리 오래 걸려? 빨리 챙겨서 움직여!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_WarchiefAndLooters
#. Speaker = Brawler Gurd
#. NodeID = c3bd4a69-bdb1-7846-dc0d-f9e46cdff092
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_WarchiefAndLooters:c3bd4a69-bdb1-7846-dc0d-f9e46cdff092
msgctxt "h86f6f9ebg6adcg43bdgbf90gb92334d48cf8"
msgid "Shut your mouth! I... *Ah-choo!* Feckin' leaves."
msgstr "입 닥쳐! 나는... *에취!* 쓰벌 잎사귀들."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_WarchiefAndLooters
#. Speaker = Warrior Clack
#. NodeID = f7e87b21-c052-aa8e-e0fb-0b8bad54bb64
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_WarchiefAndLooters:f7e87b21-c052-aa8e-e0fb-0b8bad54bb64
msgctxt "h1e1722cfg6196g48c8g88ccg22bbc2e7b76b"
msgid "Gurd keeps sneezing and dropping stuff."
msgstr "거드가 계속 재채기하면서 다 떨어트려요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_WarchiefAndPotions
#. Speaker = Warrior Jawn
#. NodeID = 9d050dc3-c7c1-6ef1-7e69-5b02eefd594d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_WarchiefAndPotions:9d050dc3-c7c1-6ef1-7e69-5b02eefd594d
msgctxt "heb0542b3gf6c7g4c6cg91a3g34e3aaa8d561"
msgid "Everythin' tastes like blood..."
msgstr "완전 피 맛밖에 안 나는군… 으윽."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_WarchiefAndPotions
#. Speaker = Booyahg Benta
#. NodeID = aaae3295-1968-ca36-2b86-6025c25ae831
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_WarchiefAndPotions:aaae3295-1968-ca36-2b86-6025c25ae831
msgctxt "hdcd0ba92gd440g4e0bgb4a6gef6a2e35ca06"
msgid "We only drank one! And it churned up our guts somethin' rotten."
msgstr "딱 한 잔 마셨어! 근데 내장이 썩는 것처럼 울렁거려."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_WarchiefAndPotions
#. Speaker = Rozzak
#. NodeID = aef41eca-80e1-ae21-0b7e-2768cd9e9818
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_WarchiefAndPotions:aef41eca-80e1-ae21-0b7e-2768cd9e9818
msgctxt "hf3d4720dg9462g4361g8240g2c4a32930a48"
msgid "Oi! That stuff ain't for you!"
msgstr "얌마! 그거 늬들 거 아냐!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_WarchiefBraveVictory
#. Speaker = Rozzak
#. NodeID = 2c990557-2922-bc1a-794d-53aa1e0d1bf3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - aeffa59b-01bc-d07e-82fe-1d81f4c4fb63_C = True
#. SetFlags:
#.   Local:
#.     - aeffa59b-01bc-d07e-82fe-1d81f4c4fb63_A = False
#.     - aeffa59b-01bc-d07e-82fe-1d81f4c4fb63_C = False
#.     - aeffa59b-01bc-d07e-82fe-1d81f4c4fb63_B = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_WarchiefBraveVictory:2c990557-2922-bc1a-794d-53aa1e0d1bf3
msgctxt "he1f3da0fgb5ffg4011gb41fg440189cdf9d0"
msgid "Good work - the True Souls are proper pleased."
msgstr "잘 했어. 참된 영혼들께서 기뻐하시겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_WarchiefBraveVictory
#. Speaker = Rozzak
#. NodeID = 47640127-03b3-50c9-4f49-d2f8589580e0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - aeffa59b-01bc-d07e-82fe-1d81f4c4fb63_A = True
#. SetFlags:
#.   Local:
#.     - aeffa59b-01bc-d07e-82fe-1d81f4c4fb63_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_WarchiefBraveVictory:47640127-03b3-50c9-4f49-d2f8589580e0
msgctxt "h297c2682g7c75g4a3ag8783g132416c2e51c"
msgid "Nobody and nothin' can stand in our way."
msgstr "그 누구도 그리고 그 무엇도 우리 앞을 막을 수는 없다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_WarchiefBraveVictory
#. Speaker = Rozzak
#. NodeID = 5ed3f71f-b7f7-c6a4-effe-120a1a49d88c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - aeffa59b-01bc-d07e-82fe-1d81f4c4fb63_B = True
#. SetFlags:
#.   Local:
#.     - aeffa59b-01bc-d07e-82fe-1d81f4c4fb63_C = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_WarchiefBraveVictory:5ed3f71f-b7f7-c6a4-effe-120a1a49d88c
msgctxt "h4793e7ffg552ag404agb8b1g2605213a5d5b"
msgid "Enjoy yourselves, but stay sharp."
msgstr "놀고 있으라고. 경계는 늦추지 말고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_WarchiefBraveVictory
#. Speaker = Rozzak
#. NodeID = da69005c-f451-4436-5cb1-91c5cc8c5dcd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - aeffa59b-01bc-d07e-82fe-1d81f4c4fb63_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_WarchiefBraveVictory:da69005c-f451-4436-5cb1-91c5cc8c5dcd
msgctxt "hede6eb84gcff0g4a59gb31eg4b497adb547e"
msgid "For the Absolute! Rhaal'tuuch!"
msgstr "절대자를 위하여! 라알투우우치!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_WarehouseLooters
#. Speaker = Brawler Gurd
#. NodeID = 5e68745d-46ab-38f0-5887-c1c57547d359
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_WarehouseLooters:5e68745d-46ab-38f0-5887-c1c57547d359
msgctxt "hc17e65c1g6b51g42d9gaa99g55f994108cd3"
msgid "Yeah. It's all... green. Why do druids store tree muck inside?"
msgstr "어. 순…풀 냄새만 나. 드루이드들은 왜 나무 찌꺼기를 쌓아놓지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_WarehouseLooters
#. Speaker = Warrior Clack
#. NodeID = 6f6bcb93-6178-2876-13dd-f29ac5724749
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_WarehouseLooters:6f6bcb93-6178-2876-13dd-f29ac5724749
msgctxt "h1f4a2d41g605ag4e12gbc13gf2bd9b29cc68"
msgid "Dunno. But some of it's gotta be valuable, right?"
msgstr "몰라. 그래도 돈 되는 거는 좀 섞여있지 않을까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_WarehouseLooters
#. Speaker = Brawler Gurd
#. NodeID = 9ea0a863-9820-17cf-ea93-cecf80d21f22
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_WarehouseLooters:9ea0a863-9820-17cf-ea93-cecf80d21f22
msgctxt "h17bca2f2g7432g4d99gab18g87104fc9e240"
msgid ""
"*Ah-choo!* Ugh... smells funny whatever it's for. Grab as much as you can."
msgstr "*에헤취!* 어으…이게 뭐가 됐든 냄새 한 번 괴상하네. 가능한 많이 챙기자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_WarehouseLooters
#. Speaker = Warrior Clack
#. NodeID = a6090cc2-cb23-f3fa-2029-548597696e70
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_WarehouseLooters:a6090cc2-cb23-f3fa-2029-548597696e70
msgctxt "h20abec93g3e7fg4e7fga022gf9987e577740"
msgid "You smell that?"
msgstr "너도 냄새 맡냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_WarehouseLooters
#. Speaker = Warrior Clack
#. NodeID = cef7c37e-1dae-6310-4fbb-d6389895746c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_WarehouseLooters:cef7c37e-1dae-6310-4fbb-d6389895746c
msgctxt "habafd0abga101g411fgbf3egea446aa7c79d"
msgid "Maybe. Can't tell if it's for eating or smoking though."
msgstr "아마도. 이게 먹으려고 한 건지 피우려고 한 건지는 모르겠지만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Adventurer2
#. Speaker = Remira
#. NodeID = 1c714c34-3caf-8164-e753-49c66b536dda
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Adventurer2:1c714c34-3caf-8164-e753-49c66b536dda
msgctxt "h76a02620gcff5g429eg9e5ag431b85692f7a"
msgid ""
"But Liam said it was you sprung him from that goblin camp. Not me, not "
"Aradin or Barth - you."
msgstr "근데 리암이 네가 고블린 진지에서 자기를 구해줬다고 하잖아. 나도, 아라딘도, 바쓰도 아닌 네가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Adventurer2
#. Speaker = Remira
#. NodeID = 2fc3b292-5d93-30e3-5c51-4a64cf8c1ce1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Adventurer2:2fc3b292-5d93-30e3-5c51-4a64cf8c1ce1
msgctxt "h2bdab0e6g9590g45d1g8fd0ge80d298bfdb5"
msgid ""
"Still a lost cause, mind - but if you can't live smart, you may as well die "
"right."
msgstr "여전히 승산은 없다 싶지만. 어차피 똑똑하게는 못 살 거, 의롭게 죽는 것도 괜찮겠다 싶어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Adventurer2
#. Speaker = Remira
#. NodeID = 4ca52e04-0896-30c0-d0ad-0c1cc61f8d20
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Adventurer2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Adventurer2:4ca52e04-0896-30c0-d0ad-0c1cc61f8d20
msgctxt "h9ffef0c0g26e7g4d62g825bgcf0aece91b5b"
msgid "You. Liam said you sprung him from the goblin camp."
msgstr "야. 리암이 그러던데 네가 걔 고블린 진지에서 구해줬다며?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Adventurer2
#. Speaker = Remira
#. NodeID = 4e09df0f-a7cb-7530-d763-4a3cbebfb984
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Adventurer2:4e09df0f-a7cb-7530-d763-4a3cbebfb984
msgctxt "h97991ca5g03c2g4a44g8e92gcf5e55554841"
msgid ""
"Better than he was when you found him. Bugger gets to rest while we do the "
"work."
msgstr "네가 발견했을 때보단 나아졌지. 우리가 수고하는 동안 걔는 푹 늘어져만 있는걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Adventurer2
#. Speaker = Player
#. NodeID = 68385e68-301a-b40c-898a-a66d30386ba7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Adventurer2:68385e68-301a-b40c-898a-a66d30386ba7
msgctxt "ha8dd64c8g35bcg4fffg88fbgd4070e776d21"
msgid "I could say the same for you."
msgstr "그건 너도 마찬가지인 거 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Adventurer2
#. Speaker = Player
#. NodeID = 6fc6adac-3b98-91de-6b5c-d2a9cf4fded0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#.      - FIGHTER(1) = True
#.      - RANGER(1) = True
#.      - PALADIN(1) = True
#.      - MONK(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Adventurer2:6fc6adac-3b98-91de-6b5c-d2a9cf4fded0
msgctxt "h47294860g0fdcg4b3fga77cg05ba17843f90"
msgid "Soft heart, strong arm. How's Liam?"
msgstr "마음은 여려도 몸뚱이는 강인하다고. 리암은 어때?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Adventurer2
#. Speaker = Remira
#. NodeID = 7e31c5be-de13-d492-bffc-364487bbafd9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Adventurer2:7e31c5be-de13-d492-bffc-364487bbafd9
msgctxt "hdbe50c87g0dd6g415cg9806gdcea0a91c62d"
msgid ""
"Can't see to Liam's wounds myself so I best keep this crowd alive to do it "
"for me."
msgstr "다만 나 혼자 리암의 부상을 돌볼 순 없으니, 여기 녀석들이 죽지 않게 노력은 하겠단 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Adventurer2
#. Speaker = Remira
#. NodeID = 831fdccc-5875-7e0c-75a3-1f27d735e87f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Adventurer2Victory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Adventurer2:831fdccc-5875-7e0c-75a3-1f27d735e87f
msgctxt "hf364689dgc907g4a71g86a6gd48e9021ac5c"
msgid ""
"You made it - good. Reckon I've seen enough brave idiots run to their deaths "
"for a while."
msgstr "살아남았구나. 잘됐네. 순 용기만 가지고 덤벼들다 죽는 멍청이들은 요새 질리도록 겪었거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Adventurer2
#. Speaker = Remira
#. NodeID = 91988262-6fd3-1b7e-b07e-2918ac12296c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Adventurer2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Adventurer2:91988262-6fd3-1b7e-b07e-2918ac12296c
msgctxt "h314c83e3gaaf4g4878gb0eeg4b42b90ca934"
msgid "Don't you have a heroic defence to lead?"
msgstr "영웅적인 방어전 이끌러 가야 하지 않냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Adventurer2
#. Speaker = Remira
#. NodeID = 94d99840-7edb-0f19-ccd1-c0f20605502c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Adventurer2:94d99840-7edb-0f19-ccd1-c0f20605502c
msgctxt "h6d2c5e5agfffeg44b8gaf0cg211487eedbb7"
msgid "Seems you're not the only one that likes a lost cause."
msgstr "나도 너 같이 승산 없는 일에 혹하는 면이 있나 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Adventurer2
#. Speaker = Remira
#. NodeID = 958e530c-4dc2-1a65-7557-8207459512f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Adventurer2:958e530c-4dc2-1a65-7557-8207459512f4
msgctxt "hd61f8d15gb5a1g4587gabcag090783111543"
msgid ""
"Soft head, more like. If I were smart, I'd be back in Baldur's Gate with my "
"feet up."
msgstr "내 경우는 머리가 가벼운 거고. 내가 똑똑했다면 지금끔 발더스 게이트에 귀환해 푹 늘어졌을 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Adventurer2
#. Speaker = Remira
#. NodeID = 9e484091-88ec-6f33-12e6-6b1cfbbc3713
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Adventurer2:9e484091-88ec-6f33-12e6-6b1cfbbc3713
msgctxt "h62682314g2a38g4cf9ga7f2g519423e68a53"
msgid ""
"Not as much as I'd like, mind, but I'm done chasing baubles for shitey "
"wizards."
msgstr "보수가 썩 맘에 들진 않지만, 망할 위저드들 잡동사니 심부름 노릇은 이제 질렸어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Adventurer2
#. Speaker = Remira
#. NodeID = a743661f-2e7d-7819-08e3-9940ce3a844b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Adventurer2:a743661f-2e7d-7819-08e3-9940ce3a844b
msgctxt "hc288e9a8g8c49g4623gbb20gf0cfb0df0540"
msgid ""
"But this crowd patched Liam up when they had plenty reason not to. Might be "
"I misjudged 'em."
msgstr "하지만 여기 놈들이 리암을 치료해줬거든. 그러지 않을 이유가 차고 넘치는데도. 내가 얘네들을 오해하고 있었나 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Adventurer2
#. Speaker = Player
#. NodeID = ac15685b-37f6-111d-fa2e-60c7349cf66e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC(1) = True
#.      - SORCERER(1) = True
#.      - DRUID(1) = True
#.      - WARLOCK(1) = True
#.      - WIZARD(1) = True
#.      - BARD(1) = True
#.      - ROGUE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Adventurer2:ac15685b-37f6-111d-fa2e-60c7349cf66e
msgctxt "hf5996607gac5bg4cb2gb88agcaf0b642c1d7"
msgid "Soft heart, sharp mind. How's Liam?"
msgstr "마음은 여려도 정신은 매섭다고. 리암은 어때?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Adventurer2
#. Speaker = Remira
#. NodeID = b051fa23-db7e-3ade-c48a-f88f7d3b1c6d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Adventurer2:b051fa23-db7e-3ade-c48a-f88f7d3b1c6d
msgctxt "h0c5628f8g7ae0g4416g8445gf831e4ba70ee"
msgid ""
"And now you're back to stand with this lot. A right soft heart you've got, "
"don't you?"
msgstr "그리고 이젠 여기 놈들 지키러 돌아오셨고. 마음씨가 제법 여린 모양인가 봐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Adventurer2
#. Speaker = Remira
#. NodeID = b950ba90-9bcb-5168-540c-107bdb922944
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Adventurer2:b950ba90-9bcb-5168-540c-107bdb922944
msgctxt "h3d228bb7g5ef9g427egbf8fg9db0c99213ca"
msgid ""
"I left Baldur's Gate to make some coin, not fall in with a bunch of homeless "
"hellspawn."
msgstr "애초에 난 돈이나 벌러 발더스 게이트를 나선 거지, 떠돌이 지옥 종자네랑 엮이는 건 상정에 없었다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Adventurer2
#. Speaker = Player
#. NodeID = d7a07225-288d-b0d1-e3ee-456a71cfdcd8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_RaidingParty_Adventurer2_HasMet(1) = True
#.   Tag:
#.      - REALLY_TIEFLING(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Adventurer2:d7a07225-288d-b0d1-e3ee-456a71cfdcd8
msgctxt "hb156e781ge83cg4496g9acdg67d91551582b"
msgid "Surprised to see you here protecting 'foulbloods'."
msgstr "네가 '더러운 혈통'들을 지키러 머무르고 있다니 의외인걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Adventurer2
#. Speaker = Remira
#. NodeID = da1efa2d-3541-7779-b580-6acbc532f18c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Adventurer2:da1efa2d-3541-7779-b580-6acbc532f18c
msgctxt "h3770d596gd299g4accg9af8g36f8945e8c87"
msgid ""
"Still. This crowd looked after him, no questions asked. Reckon it's only "
"fair I return the favour."
msgstr "아무튼, 여기 녀석들 별 내색 없이 걔를 돌봐주던데, 입 싹 닦고 그냥 뜰 순 없겠더라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Adventurer2
#. Speaker = Remira
#. NodeID = e47a8f90-1ae2-c72c-4774-f81d1d7c2990
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Adventurer2:e47a8f90-1ae2-c72c-4774-f81d1d7c2990
msgctxt "hc7dd5343g930dg4fa3g9042g22fab8fda478"
msgid ""
"I might be thick, but I'm fair - you save one of mine, I can at least try to "
"return the favour."
msgstr "내가 머저리일진 몰라도 뻔뻔하진 않아. 네가 내 동료를 구해 줬는데, 적어도 그 보답은 해야지 않겠어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Adventurer2
#. Speaker = Remira
#. NodeID = e6beb46f-b8c9-9b1a-be37-f7fec0b25b95
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Adventurer2:e6beb46f-b8c9-9b1a-be37-f7fec0b25b95
msgctxt "h1a4f9840gf557g4d8cga116g2cecd1cc609f"
msgid "Oh, bugger off. I'm here, aren't I?"
msgstr "아, 웃기지 마셔. 남았으면 된 거 아냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Adventurer2
#. Speaker = Remira
#. NodeID = f1dcc940-c4da-52d3-f9fc-175c03416254
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Adventurer2Victory(1) = True
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Adventurer2:f1dcc940-c4da-52d3-f9fc-175c03416254
msgctxt "h5076a9acg3103g4597gb582g2763e6b5648e"
msgid ""
"Might be we'll see you in Baldur's Gate. Tieflings offered us coin to guard "
"'em on the road."
msgstr "발더스 게이트에서 다시 만날 수도 있겠네. 티플링들이 호위를 해달라고 돈을 줬거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Adventurer2
#. Speaker = Remira
#. NodeID = f203ef07-bf9a-2dc2-4785-c5defa83d090
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Adventurer2:f203ef07-bf9a-2dc2-4785-c5defa83d090
msgctxt "h13ab029egc574g4605g9b28ge9894888f3b0"
msgid ""
"Look... might be I've said some stupid things. No 'might' about it, actually."
msgstr "이봐. 내가 전에 좀 멍청한 말을 지껄였던 것 같기도 해. 아니, 같은 게 아니라 실제로 했지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Adventurer2
#. Speaker = Player
#. NodeID = f2f1aff6-c64c-08c6-e071-65623fffab27
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Adventurer2:f2f1aff6-c64c-08c6-e071-65623fffab27
msgctxt "h49f032c9gfa61g41fcg8376gc3285adf14ba"
msgid "Better a soft heart than none at all."
msgstr "너처럼 정나미도 없는 것보다야 여린 게 낫지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice
#. Speaker = Player
#. NodeID = 05fd9b5a-7362-04b1-20b5-85ecd6c2996e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - HALFLING(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice:05fd9b5a-7362-04b1-20b5-85ecd6c2996e
msgctxt "hce8f68b5gef9fg440cgb541g68cb5a05e6c1"
msgid "It's your home. It's worth protecting."
msgstr "네 고향이잖아. 충분히 지켜낼 가치가 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice
#. Speaker = Player
#. NodeID = 0bad618e-8a7f-35f1-caa8-b70f1de2ebca
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_EVIL or PALADIN_EVIL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice:0bad618e-8a7f-35f1-caa8-b70f1de2ebca
msgctxt "h8d1d3bd7g76fag4e46gbd47g5de5806396cf"
msgid "Every death was in service of my god."
msgstr "모든 죽음을 내 섬기는 신께 바치리."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice
#. Speaker = Nettie
#. NodeID = 24a447f6-6ff0-5d1d-3e5c-aeafb9316b7f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice:24a447f6-6ff0-5d1d-3e5c-aeafb9316b7f
msgctxt "hd3796388gf0bfg41b4gbe62gaf2c862bc7f4"
msgid ""
"Still, there would be little more than ashes left of the grove without you."
msgstr "맞아요, 당신이 없었다면 숲은 재만 남았을 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice
#. Speaker = Nettie
#. NodeID = 2f099593-d587-984c-61b9-5a780a678fae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice:2f099593-d587-984c-61b9-5a780a678fae
msgctxt "hc6f04c65ge5b5g4f93g976eg115dd5878aa6"
msgid ""
"Too right. Home is where you belong, not where you're born. This - this is "
"where I belong."
msgstr "맞아요. 집은 우리가 태어난 곳이 아니라 살아가는 곳이죠. 여기...이곳이 제 집이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice
#. Speaker = Nettie
#. NodeID = 2fef8991-1a25-9b1e-0e28-b13dac649f9c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice:2fef8991-1a25-9b1e-0e28-b13dac649f9c
msgctxt "he53795edg9971g41a2gbad0g8f44f4d53aa9"
msgid ""
"If you're looking for coin, you're out of luck. I'm a healer, not a "
"moneylender."
msgstr "금전적 보상을 바라셨다면 안됐네요. 저는 대금업자가 아니라 치유사예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice
#. Speaker = Player
#. NodeID = 34334509-8905-44aa-6fc9-29944edc223e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_Event_ApplyPoison(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice:34334509-8905-44aa-6fc9-29944edc223e
msgctxt "ha3aafe6agd3a8g4750g85e0g870d8b7577e5"
msgid "I'm still waiting for an apology for trying to kill me."
msgstr "날 죽이려 한 것에 대한 사과는 아직 못 들었는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice
#. Speaker = Player
#. NodeID = 36044139-9da8-c812-c7ed-cca8205cdb36
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Apprentice_State_TookPoison(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice:36044139-9da8-c812-c7ed-cca8205cdb36
msgctxt "h511fd08cg8692g49fdg9d10gdd4338e0de07"
msgid "You're just lucky I didn't swig that poison."
msgstr "내가 그 독을 마시지 않은 게 다행인 줄 알아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice
#. Speaker = Nettie
#. NodeID = 493677d3-55ae-3103-7121-3f2530602761
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#.      - DEN_AttackOnDen_Event_Start = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_ApprenticeVictory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice:493677d3-55ae-3103-7121-3f2530602761
msgctxt "hec6e24d6gf517g4fe0ga3fcgdeaf2076f546"
msgid "This place... this place means everything to me."
msgstr "이곳은...이곳은 제 전부에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice
#. Speaker = Nettie
#. NodeID = 4af02edb-63b6-aaa4-b790-0b79fe433cd3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice:4af02edb-63b6-aaa4-b790-0b79fe433cd3
msgctxt "h1c521d7ag685fg49f5gbf31gf1d2bcad1b0b"
msgid "Thank you."
msgstr "감사해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice
#. Speaker = Nettie
#. NodeID = 4be74b26-bd96-c7b8-6e84-7a6e8ae831a9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice:4be74b26-bd96-c7b8-6e84-7a6e8ae831a9
msgctxt "hb0023f83gc07eg4e90g9e6ag88b8735cc512"
msgid "I am sorry for that, but the whole grove was at risk."
msgstr "죄송해요, 우리 모두가 위험할 수도 있어서 어쩔 수 없었어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice
#. Speaker = Nettie
#. NodeID = 50ee81bb-9c19-5a40-1c04-2eec6fe54417
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice:50ee81bb-9c19-5a40-1c04-2eec6fe54417
msgctxt "h143fa0afga3d2g4e82gbda2g0dc3d29d9799"
msgid "I... hoped you'd had other motives, but I'll take what I can get."
msgstr "조…금 다른 동기가 있기를 바랐는데, 어쩔 수 없죠 뭐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice
#. Speaker = Nettie
#. NodeID = 5e388bc7-463a-c53e-f513-f1ad88780599
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice:5e388bc7-463a-c53e-f513-f1ad88780599
msgctxt "hba637a77gfe6ag4283g8fcbgf4f742ada763"
msgid "I was sure we wouldn't live to see the morrow."
msgstr "우리에겐 내일이 없을 거라고 생각했어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice
#. Speaker = Nettie
#. NodeID = 64b40ad3-fd1a-9674-f9ab-944eab9d310e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice:64b40ad3-fd1a-9674-f9ab-944eab9d310e
msgctxt "h6d9cc78dgbd42g4215g9917gba352bfef2c8"
msgid "Thank you for everything you've done."
msgstr "당신이 해준 모든 일들에 감사해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice
#. Speaker = Player
#. NodeID = 6679078b-afe0-068b-b1cb-baae7a408070
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_GOOD or PALADIN_GOOD
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice:6679078b-afe0-068b-b1cb-baae7a408070
msgctxt "ha8dc7ad6g9cb2g4e4eg9d91g46d3e83ed324"
msgid "Of course, it's my duty to help those in need."
msgstr "천만에, 도움이 필요한 사람들을 돕는 게 내 의무야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice
#. Speaker = Nettie
#. NodeID = 66af7125-e157-6975-de85-21585bae861c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Apprentice_Quest_TookPoison = True
#.   Object:
#.      - DEN_Apprentice_Event_RevealedTadpole(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice:66af7125-e157-6975-de85-21585bae861c
msgctxt "hbb16021dgd8bbg4d53g966dg104c38f66d6f"
msgid "You kept your word. Thank you."
msgstr "약속을 지켜주셨네요. 감사해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice
#. Speaker = Nettie
#. NodeID = 6fa05c95-2b03-e5ed-5867-c85ad913a8bb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_ApprenticeVictory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice:6fa05c95-2b03-e5ed-5867-c85ad913a8bb
msgctxt "h70d794c2gdf93g469egae32g0198bc155cdb"
msgid "Silvanus be with you, my friend."
msgstr "나의 친구여, 실바누스가 당신과 함께하기를."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice
#. Speaker = Nettie
#. NodeID = 6ff1706e-1416-a4c4-728d-a44e0f0c0883
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice:6ff1706e-1416-a4c4-728d-a44e0f0c0883
msgctxt "h66d6ea73g5762g4c82ga1e0g04176b1099e8"
msgid "Well, you certainly took out more than your fair share."
msgstr "뭐, 좀 지나치게 많이 때려잡은 것 같긴 한데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice
#. Speaker = Nettie
#. NodeID = 700369c4-9ca4-4f39-dc7d-34c6444159d1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_Event_RevealedTadpole(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice:700369c4-9ca4-4f39-dc7d-34c6444159d1
msgctxt "h06662268g31c5g4698ga388g96b49652de9c"
msgid ""
"I'm still not comfortable with your tadpole, but I owe you a chance. Thank "
"you."
msgstr "여전히 당신 머릿속 올챙이가 마음에 걸리긴 하지만, 이번 한번은 넘어가죠. 정말 감사해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice
#. Speaker = Player
#. NodeID = 70d7ea2b-8777-6ba1-39ff-72f059ed4af1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice:70d7ea2b-8777-6ba1-39ff-72f059ed4af1
msgctxt "h9a8afcf0ga0beg4b75g96e6ga8d8e65fa2f4"
msgid "This is a sacred place - it had to be protected."
msgstr "이곳은 신성한 곳이야. 지켜야만 하는 곳이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice
#. Speaker = Nettie
#. NodeID = 74c2ef1e-dc79-7b52-d4a2-e0a78d7e05f2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice:74c2ef1e-dc79-7b52-d4a2-e0a78d7e05f2
msgctxt "h8c51fbb3ge59fg4495g97c7g2d5469f73483"
msgid ""
"Hah! Look, I'm sorry. I didn't know what to do when you told me about that "
"tadpole."
msgstr "정말 미안해요. 당신이 올챙이에 대한 말을 했을 때 어떻게 해야 할지 몰랐어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice
#. Speaker = Nettie
#. NodeID = 7ea8d97d-1084-1e8c-27b4-0c75eec14490
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_State_Returned = True
#.      - GLO_Halsin_State_PermaDefeated = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice:7ea8d97d-1084-1e8c-27b4-0c75eec14490
msgctxt "h4b5c2527g14f3g4adegbf06geb02ccb52363"
msgid "Thank you for saving it. For saving Master Halsin. For everything."
msgstr "여길 지켜주시고, 마스터 할신을 구해주신 것, 모든 것에 감사해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice
#. Speaker = Nettie
#. NodeID = 88601d46-eb32-625a-5c22-7397c2bf1143
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#.      - DEN_AttackOnDen_Event_Start = True
#.   Object:
#.      - DEN_Apprentice_Event_RevealedTadpole(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_ApprenticeVictory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice:88601d46-eb32-625a-5c22-7397c2bf1143
msgctxt "hd81c988bga3eag4205gbf82gd7b61ef02849"
msgid "I was certain your parasite had taken hold."
msgstr "당신 머릿속의 올챙이가 완전히 자리를 잡았다고 생각했어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice
#. Speaker = Nettie
#. NodeID = 89056d19-f24b-d145-8995-1f15560901a4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_State_Returned = True
#.      - GLO_Halsin_State_PermaDefeated = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice:89056d19-f24b-d145-8995-1f15560901a4
msgctxt "hdf466d6agba61g4cfcgb0b0gabfcd7e33069"
msgid "Thank you for saving Master Halsin. For saving my home. For everything."
msgstr "마스터 할신을 구해주셔서, 그리고 우리의 집을 지켜주셔서 감사해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice
#. Speaker = Nettie
#. NodeID = 8ac7f43a-6646-9630-db4f-e07a33378169
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice:8ac7f43a-6646-9630-db4f-e07a33378169
msgctxt "h30f0d659g70cag4da1gab2fg9b37314af6ff"
msgid "I'm glad I was wrong."
msgstr "제가 틀려서 다행이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice
#. Speaker = Player
#. NodeID = 8b7935a4-0534-f8a8-85c8-e9b3bdc86991
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice:8b7935a4-0534-f8a8-85c8-e9b3bdc86991
msgctxt "hf8361d0cga351g4f6dgb079g90eb6e8c51f6"
msgid "You're very welcome."
msgstr "별 말씀을."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice
#. Speaker = Player
#. NodeID = 9948572e-ff4c-1abb-ab23-3b987c779b76
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice:9948572e-ff4c-1abb-ab23-3b987c779b76
msgctxt "hacb92942g53d6g4f7ag85ccg6cc40d02a620"
msgid "Thanks are fine. A reward is better."
msgstr "감사 인사는 됐고, 보상이 더 낫겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice
#. Speaker = Nettie
#. NodeID = 9a52a2e0-45f1-ddc6-a0ec-1c30ddb3abc6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_State_Returned = False
#.      - GLO_Halsin_State_PermaDefeated = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_ApprenticeVictory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice:9a52a2e0-45f1-ddc6-a0ec-1c30ddb3abc6
msgctxt "h6f2bcdabgc827g4ceegb088g468324c586e6"
msgid "The goblins may be gone, but it cost Master Halsin his life..."
msgstr "고블린들은 물리칠 수 있었지만, 그 대가로 마스터 할신 님을 잃었어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice
#. Speaker = Player
#. NodeID = 9c96e7e9-ca8d-d65c-7cc6-5fa05dbfac04
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice:9c96e7e9-ca8d-d65c-7cc6-5fa05dbfac04
msgctxt "h121aac64g0266g4360gb263gf5161d2f9010"
msgid "It was a glorious fight! One to be relished."
msgstr "기억에 남을만한 영광스러운 전투였다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice
#. Speaker = Nettie
#. NodeID = 9e5caa73-367d-e6c7-3975-8838e116a09a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_ApprenticeVictory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice:9e5caa73-367d-e6c7-3975-8838e116a09a
msgctxt "h71dcd1adg7e05g43e0ga096ge59704fad6d5"
msgid ""
"Whatever about the grove, I won't be at peace until Master Halsin returns."
msgstr "숲이 어찌되건, 할신 님이 돌아오지 않으면 마음이 편하지 않을 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice
#. Speaker = Nettie
#. NodeID = a1396c45-79da-b2d0-3e20-3b97eb6a8fa7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice:a1396c45-79da-b2d0-3e20-3b97eb6a8fa7
msgctxt "hac3771cdgae12g4aa9gba23g8d6d0982858f"
msgid ""
"Whatever your motives, my home is still standing - because of you. I'll "
"always be grateful for that."
msgstr "동기가 어찌되었든 당신 덕에 저의 집이 아직 서있어요. 항상 감사할게요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice
#. Speaker = Nettie
#. NodeID = a609f874-4895-3225-3ab6-abb2477c8735
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Apprentice_Event_GiveReward = False
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Event_GiveReward = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice:a609f874-4895-3225-3ab6-abb2477c8735
msgctxt "h8b8c641ag91bag4b92g87f2g2aa319df465d"
msgid "But I'll have the chance - thanks to you."
msgstr "하지만 그 기회는 얻었어요. 고마워요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice
#. Speaker = Nettie
#. NodeID = ac920f72-776e-3a23-6620-afd91c1d5384
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_State_Returned = True
#.      - GLO_Halsin_State_PermaDefeated = False
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_ApprenticeVictory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice:ac920f72-776e-3a23-6620-afd91c1d5384
msgctxt "hb9e8d01fga9a0g465egb6f9g598b779b33ce"
msgid "Blessed day, I was worried I'd never see Master Halsin again."
msgstr "축복받은 날이에요. 마스터 할신 님을 더 이상 못 뵐까봐 걱정했거든요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice
#. Speaker = Nettie
#. NodeID = ad7e76af-3c7a-5b71-3d7c-cf3da80b315c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice:ad7e76af-3c7a-5b71-3d7c-cf3da80b315c
msgctxt "h8bf1c88bg7262g4808g9f39gf1b3a89d2c87"
msgid "I don't know if I can ever restore Silvanus' peace to this place."
msgstr "제가 이곳에 실바누스님의 평화를 다시 가져올 수 있을지는 모르겠군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice
#. Speaker = Nettie
#. NodeID = b00d51af-9924-912e-173d-095eedae19f9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice:b00d51af-9924-912e-173d-095eedae19f9
msgctxt "h6abac288g0294g4405ga3e9gf021643b0a54"
msgid "Thank you for saving my home."
msgstr "우리의 집을 지켜주셔서 감사해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice
#. Speaker = Nettie
#. NodeID = b8e3e387-fc90-c8d0-e0df-a0504da56588
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_Event_RevealedTadpole(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice:b8e3e387-fc90-c8d0-e0df-a0504da56588
msgctxt "h6bdf0470gd952g4142g8963gdef82b568f28"
msgid ""
"I'm sorry neither of us could save you from that tadpole. I hope it ends "
"well for you."
msgstr "우리 중 누구도 당신을 올챙이로부터 구하지 못해서 미안해요. 어떻게든 잘 해결되길 바라요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice
#. Speaker = Nettie
#. NodeID = b9916a23-d2fd-ebfa-1f7d-492f9b612e1b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice:b9916a23-d2fd-ebfa-1f7d-492f9b612e1b
msgctxt "h880f38ecgc463g4457g9bcbg522d764a8015"
msgid "I'm glad you were on our side."
msgstr "당신이 우리 편이라 다행이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice
#. Speaker = Nettie
#. NodeID = bcf809bc-57ab-414d-5e92-b432174f2769
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice:bcf809bc-57ab-414d-5e92-b432174f2769
msgctxt "hcd8e79cdg19ecg415cg8a22g3d7198d2041f"
msgid "And bloody hells, did we need it."
msgstr "끝내주네요. 우린 당신 같은 사람이 필요했어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice
#. Speaker = Nettie
#. NodeID = da7205fd-07f8-2ab5-a06c-d8c406d22b1c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Apprentice_Event_GiveReward = False
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Event_GiveReward = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice:da7205fd-07f8-2ab5-a06c-d8c406d22b1c
msgctxt "h2d404a44gfd79g4838g9f9bg160d6559cfaf"
msgid "But here - to mend any hurts."
msgstr "이거 받아요. 어떤 상처든 잘 들을 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice
#. Speaker = Nettie
#. NodeID = e0f27f63-fac5-c5a5-d7d0-07f90472e418
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_ApprenticeVictory(1) = True
#.   Global:
#.      - GLO_Halsin_Knows_IsFound = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice:e0f27f63-fac5-c5a5-d7d0-07f90472e418
msgctxt "h159cee4cg66cag40feg9649g6dfd33065a79"
msgid ""
"I'll stay here until Master Halsin returns. I still believe he's out there "
"somewhere."
msgstr "저는 여기서 마스터 할신이 돌아올 때까지 기다릴 거예요. 어딘가에서 살아 계실 거라 믿어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice
#. Speaker = Player
#. NodeID = e1115678-f76f-1029-94d6-8e4041e0d70f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice:e1115678-f76f-1029-94d6-8e4041e0d70f
msgctxt "hfbaff0c4g7ccdg4e66g924egf4259aef63f3"
msgid "It was a pleasure to crush some goblin skulls."
msgstr "고블린 두개골 몇 개를 박살낼 수 있어 좋았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice
#. Speaker = Nettie
#. NodeID = e17f72d8-0a9c-9740-fad4-df27f66476f9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice:e17f72d8-0a9c-9740-fad4-df27f66476f9
msgctxt "he0ebb4cbg9abcg4133gaf45g0f7015b87305"
msgid "Glad I was wrong."
msgstr "제가 틀려서 다행이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice
#. Speaker = Player
#. NodeID = e2d61ff0-3a3c-fb72-6589-0dc9441e2607
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TIEFLING(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice:e2d61ff0-3a3c-fb72-6589-0dc9441e2607
msgctxt "hfb20a766g12f9g4236gbf41g7025c61c218c"
msgid "I fought for the refugees, not for you."
msgstr "너희가 아니라 티플링 난민들을 위해 싸운 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice
#. Speaker = Player
#. NodeID = ebca42b3-150e-98aa-0543-5002e7b1744b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice:ebca42b3-150e-98aa-0543-5002e7b1744b
msgctxt "h7b0e9cc6g8f06g47ecgaf4ag55cae9e466e0"
msgid "Damn right. If not for me, you'd all be dead."
msgstr "그래야지. 내가 아니었다면 너흰 모두 죽었을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice
#. Speaker = Nettie
#. NodeID = f0dfb208-1b23-a90b-deb0-9c2d1f77ac34
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice:f0dfb208-1b23-a90b-deb0-9c2d1f77ac34
msgctxt "h4b147df4gfc6dg4d01gb503g077ec61fb059"
msgid "I don't know how we'll go on, but we must. For him."
msgstr "앞으로 어떻게 해야 할지 모르겠지만, 나아가야죠. 할신 님을 위해서라도."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice
#. Speaker = Nettie
#. NodeID = ff62726c-dd15-a267-19f0-3b286d120705
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_ApprenticeVictory(1) = True
#.   Global:
#.      - GLO_Halsin_State_PermaDefeated = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Apprentice:ff62726c-dd15-a267-19f0-3b286d120705
msgctxt "hf8e11ec9gdbc0g4757g8dc7g139c9a0f2d69"
msgid "May Master Halsin rest in the Deep Forest."
msgstr "마스터 할신, 깊은 숲 속에서 편히 쉬시기를."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Player
#. NodeID = 018db450-3222-d30d-f388-14bc8c8143a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:018db450-3222-d30d-f388-14bc8c8143a7
msgctxt "h0954ab81g7e1fg4bc7gbc5cg289d93af13d4"
msgid "I don't have time to celebrate just yet."
msgstr "아직 축하할 시간은 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Cerys
#. NodeID = 047ec5c4-628e-2f75-9fc9-d0a1e6060bdc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:047ec5c4-628e-2f75-9fc9-d0a1e6060bdc
msgctxt "h83886f4bg46f1g40eeg8d8bg17043173a921"
msgid "The road to Baldur's Gate. Choked with monsters - or it was."
msgstr "발더스 게이트로 향하는 길. 괴물이 득실거리지. 이제는 아니지만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Cerys
#. NodeID = 13eb3623-3ec1-219c-b481-15b5f95c5f73
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:13eb3623-3ec1-219c-b481-15b5f95c5f73
msgctxt "hb6a7ae90g407dg4aebgb258g6827b3917fda"
msgid "As I was scouting, I found signs of <i>someone </i>clearing them out."
msgstr "정찰을 하는 동안 <i>누군가</i> 그것들을 쓸어버린 흔적들을 발견했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Player
#. NodeID = 24b2072c-b140-d5a5-eb7c-5f04297e3e42
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:24b2072c-b140-d5a5-eb7c-5f04297e3e42
msgctxt "h8a722827g57c0g4f23gb793gfa2dcbda428d"
msgid "I had business out in the wilds, and no one else was doing anything."
msgstr "숲에서 해야 할 일이 있었지. 누가 됐든 내 앞에서 얼쩡거리면 안 됐어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Cerys
#. NodeID = 28ba4b0a-2606-48c3-5e4b-6cee899f0ba6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Absolute_Knows_MoonriseTowers = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:28ba4b0a-2606-48c3-5e4b-6cee899f0ba6
msgctxt "h67001109g9932g4cb2ga753gfd8578d2ca18"
msgid ""
"This new god has a tight grip on Moonrise Towers, and it was a dark place to "
"begin with."
msgstr "새로운 신이라는 작자가 문라이즈 타워를 지배 하에 뒀어. 안 그래도 원체 어두운 곳인데 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Cerys
#. NodeID = 2f1d15e3-649a-8987-cf5b-37470d76041e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:2f1d15e3-649a-8987-cf5b-37470d76041e
msgctxt "h62228a59gee36g4b2egbe15g43650c15250b"
msgid "Go on. He'll want to speak to the one who saved his grove, I expect."
msgstr "가봐. 숲을 구한 구원자와 이야기하고 싶어할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Cerys
#. NodeID = 3020009d-e85a-198b-ef13-cbca6e62fe82
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_ZevlorIsLeader = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:3020009d-e85a-198b-ef13-cbca6e62fe82
msgctxt "h13ac903ag4e9eg403fg9e07ga02cfecaa53d"
msgid "Godsdammit, Zevlor."
msgstr "젠장, 제블로어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Cerys
#. NodeID = 30fd55a1-87d1-6d03-04e7-26db936d46e4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:30fd55a1-87d1-6d03-04e7-26db936d46e4
msgctxt "h62cf788fgc359g4bbdg99ddg4faa774da6ba"
msgid "I take it this business of yours won't keep you with us?"
msgstr "그 볼일이라는 게 우리와 함께할 순 없는 거겠지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Cerys
#. NodeID = 39e2c7c7-5486-1ab0-3b60-818bd259438e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - DEN_Conflict_SUB_Goblin.LearnedLeaving(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:39e2c7c7-5486-1ab0-3b60-818bd259438e
msgctxt "h0adf2557gf54cg4d35gb8a7g81e5bf178abf"
msgid ""
"I find a clear path to the city, you keep everyone alive long enough to use "
"it. That was the plan."
msgstr "내가 도시로 향하는 안전한 길을 찾고, 그가 모두를 안전하게 지키는 것. 그게 계획이었는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Cerys
#. NodeID = 3a0b2723-18ea-75de-c00e-c05214d66180
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:3a0b2723-18ea-75de-c00e-c05214d66180
msgctxt "h779ce6a2g760ag4a0eg988bg34562c7c56e0"
msgid ""
"Came back to report some lunatic had cleared out the goblin leaders - only "
"to find Zevlor'd gone the same way."
msgstr "어떤 미치광이가 고블린 지도자들을 처리해버렸다고 보고하려고 왔는데. 제블로어도 같은 운명을 맞았군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Player
#. NodeID = 3cb4d4d6-10ac-6be5-b551-deba8a207918
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:3cb4d4d6-10ac-6be5-b551-deba8a207918
msgctxt "h1e22727eg0c32g4012g9c4fg8648e09e0bd3"
msgid "I do. We'll have to part ways here."
msgstr "그래. 여기서 헤어져야겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Cerys
#. NodeID = 3d4e5010-d68b-d6f5-5640-1e2f67edab48
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_AttackOnDen_Event_TieflingPartyInvitation = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:3d4e5010-d68b-d6f5-5640-1e2f67edab48
msgctxt "h3872ffd5g80c2g42fagabbaga173f9d0555d"
msgid "My people will join your camp tonight - a farewell, if you'll have us."
msgstr "당신만 괜찮다면, 동족들과 함께 당신의 야영지를 방문할까 하는데. 송별회를 위해서 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Cerys
#. NodeID = 411f38d2-649b-b760-c7f2-cf23cf572539
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:411f38d2-649b-b760-c7f2-cf23cf572539
msgctxt "h17b89e9bg8ba1g48c2gbc42ga9be59b16939"
msgid ""
"No bloody heroics... But I guess heroics were necessary to survive all of "
"this. Who are you?"
msgstr "영웅적인 짓은 하지 말라고 했는데... 하지만 이 상황에서 살아남으려면 그럴 수밖에 없었겠지. 당신은 누구지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Cerys
#. NodeID = 41980b17-949d-c9ea-3548-a752b6469707
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_ZevlorIsLeader = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:41980b17-949d-c9ea-3548-a752b6469707
msgctxt "h48f72533g1d26g46fbg9053gd38fa901b30c"
msgid "No point spreading honey on dung - he's dead. Godsdammit, Zevlor."
msgstr "좋게 돌려 말해봤자 소용없어. 죽었군. 망할, 제블로어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Cerys
#. NodeID = 47b2df22-6377-0734-18bf-46d50037e9e3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_ZevlorIsLeader = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:47b2df22-6377-0734-18bf-46d50037e9e3
msgctxt "ha17b505dg6a0cg4aa5g8aafg5c83241c8912"
msgid "The saviour Zevlor mentioned in his last message. Well met."
msgstr "제블로어가 마지막 전갈에서 언급했던 그 구원자로군. 반갑다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Cerys
#. NodeID = 4a73d5ec-24be-e436-6523-3595123db3c3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_State_Returned = True
#.      - DEN_ShadowDruid_State_KaghaIsDead = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:4a73d5ec-24be-e436-6523-3595123db3c3
msgctxt "haa000676g3996g44b7gb693g8bdadb7b2eff"
msgid ""
"Great big druid strolled in, too. Halsin - reckon he'll want a word with "
"you. Once he's done with Kagha, anyway. When you're free..."
msgstr ""
"위대한 드루이드 할신도 왔지. 아마 카그하랑 볼일을 마친 다음 당신하고 이야기를 나누고 싶어하지 싶은데. 시간이 된다면 가보라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Cerys
#. NodeID = 4abfd3c5-6e2c-1e8f-6d91-fd19d8413889
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_ZevlorIsLeader = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:4abfd3c5-6e2c-1e8f-6d91-fd19d8413889
msgctxt "h01f67635gd29dg49d1ga6d5g96fb40bacb4d"
msgid ""
"Trust a priest not to say it plain - he's dead, then. Gods damn it, Zevlor."
msgstr "사제란 뭘 직접 말해주는 법이 없군. 그렇다면 죽었다는 이야기겠지. 망할, 제블로어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Cerys
#. NodeID = 5dd4ad0d-cda8-a760-3537-1fb55b5da873
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:5dd4ad0d-cda8-a760-3537-1fb55b5da873
msgctxt "h35b28b08g276fg4e00gb9f5gb189fa386bac"
msgid "The saviour Asharak mentioned in his last message. Well met."
msgstr "아샤라크가 마지막 전갈에서 언급했던 그 구원자로군. 반갑다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Player
#. NodeID = 62350401-00cb-29a9-5c8f-508042fc5b75
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:62350401-00cb-29a9-5c8f-508042fc5b75
msgctxt "hf7d84dd2gab4eg4928ga418ge7e3978efc98"
msgid "I'd love to stay, but I have more to do out here."
msgstr "나도 함께 하고 싶지만, 해야 할 일이 남아서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Cerys
#. NodeID = 6250fef8-2093-2a55-ab62-774d963faf9c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:6250fef8-2093-2a55-ab62-774d963faf9c
msgctxt "hafd49534g52e0g468cgac87ga20730d62d95"
msgid "Right. Just let me know when you're ready."
msgstr "그래. 네가 준비되면 알려줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Cerys
#. NodeID = 62aaad57-8f35-fe41-4cfb-f5474db5d3ec
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_State_Returned = True
#. SetFlags:
#.   Global:
#.     - DEN_AttackOnDen_Event_HalsinSpotted = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:62aaad57-8f35-fe41-4cfb-f5474db5d3ec
msgctxt "h86baa4a1gedadg4a71g9a16g5d74cf7ce209"
msgid ""
"Great big druid strolled in, too. Halsin - reckon he'll want a word with "
"you. When you're done..."
msgstr "위대한 드루이드 할신도 왔지. 당신하고 이야기를 나누고 싶어하지 싶은데. 볼일 다 마치면 가 보라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Player
#. NodeID = 66aaf655-108e-060f-732d-d4ecde642cc6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:66aaf655-108e-060f-732d-d4ecde642cc6
msgctxt "hcb039c7cg389dg449fgbbbegc189b40b05a9"
msgid "Dead. He fell defending the grove."
msgstr "죽었어. 숲을 지키다가 쓰러졌지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Cerys
#. NodeID = 6eaa3229-51e2-8b75-56d7-5c84dd973abe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KaghaIsDead = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:6eaa3229-51e2-8b75-56d7-5c84dd973abe
msgctxt "hec3ede78g30a4g4512g98a4ged281349a6f2"
msgid ""
"Don't fancy being in Kagha's shoes right now. Reckon he'll be happier to "
"speak to you, though."
msgstr "지금은 카그하랑 노닥거릴 때가 아니야. 할신은 당신과 대화를 나누고 싶어할 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Player
#. NodeID = 6fb515b7-a3f3-4a83-89d1-0ca36e23f435
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_AttackOnDen_State_RaidReady = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:6fb515b7-a3f3-4a83-89d1-0ca36e23f435
msgctxt "h8520ca25g89bdg4079g8262g90bbd6e8364b"
msgid "Never mind that. Where were <i>you</i> while we fought for our lives?"
msgstr "그건 신경 쓰지 마. 그런데 우리가 목숨을 걸고 싸우는 동안, <i>넌</i> 어디서 뭘 하고 있었던 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Player
#. NodeID = 717b051b-9cfc-16c0-9348-04937ac91385
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC_KELEMVOR(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:717b051b-9cfc-16c0-9348-04937ac91385
msgctxt "hcdf07b48gf071g410eg851fgfbf87e33e9e1"
msgid "Being judged by Kelemvor as we speak. I hope he's not found wanting."
msgstr "우리가 말하는 이 순간 심판을 위해 켈렘보르 앞에 섰으리라. 그가 부족히 여겨지지 않기를."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Player
#. NodeID = 72e39abe-3403-d2bb-1147-f9686651f203
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:72e39abe-3403-d2bb-1147-f9686651f203
msgctxt "hfbe99403g8d0ag417agb17bgda61fd044a5f"
msgid "Let's do it."
msgstr "좋아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Player
#. NodeID = 7a15d8fa-c735-353d-4dcf-62588b462eee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:7a15d8fa-c735-353d-4dcf-62588b462eee
msgctxt "h2a1130c1g677ag4e22gbf9cge7c34fb41376"
msgid "Rotting with the rest of the corpses, I expect."
msgstr "아마 다른 시체들과 함께 썩고 있겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Cerys
#. NodeID = 7b895335-b3ae-b206-6129-dc4eee4999c6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_ZevlorIsLeader = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_BackupLeader(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:7b895335-b3ae-b206-6129-dc4eee4999c6
msgctxt "h14a06d6bg90a2g4a3cg9135gae4860af7c7f"
msgid "Beshaba's black bones, I'm too late. You - where's Zevlor?"
msgstr "베샤바 맙소사, 너무 늦었군. 제블로어는 어디에 있지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Player
#. NodeID = 8021f051-0fdc-87e7-faf3-78ab21a9c308
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:8021f051-0fdc-87e7-faf3-78ab21a9c308
msgctxt "ha8a4a42bgfbe9g417cga873ga08719045c8d"
msgid "Great. Let's go now."
msgstr "훌륭해. 그럼 가자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Cerys
#. NodeID = 868a0d15-fe75-652c-0058-04fd950ed95b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_AttackOnDen_Event_HalsinSpotted = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:868a0d15-fe75-652c-0058-04fd950ed95b
msgctxt "h32a9b14agfb69g4ca0gbabag95889dba585b"
msgid ""
"Find us when you're done. We'll join your camp and drink to fallen foes "
"tonight - if you'll have us."
msgstr "볼일이 끝나면 우릴 찾아줘. 당신만 괜찮다면 그쪽 야영지로 가서 오늘 죽은 이들을 기리며 함께 술잔을 기울이자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Cerys
#. NodeID = 89bcd079-67ca-bf9a-ce3c-fa08660ebfbd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_AttackOnDen_Event_GoToCamp = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:89bcd079-67ca-bf9a-ce3c-fa08660ebfbd
msgctxt "h17d69e68g4e02g49d7g8b01gf6510d6b98c9"
msgid "Right. Lead the way."
msgstr "좋아. 앞장서도록 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Cerys
#. NodeID = 8b4459af-ad41-fa8d-bdcc-cc202255498f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_ZevlorIsLeader = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:8b4459af-ad41-fa8d-bdcc-cc202255498f
msgctxt "hcf1ebe9egac6dg4c18gb443g7a4a0469f2ba"
msgid ""
"But if what Zevlor said of you is true... you have unfinished business out "
"here."
msgstr "하지만 제블로어가 너에 대해서 알려준 게 사실이라면…여기서 아직 덜 끝마친 일이 있을 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Cerys
#. NodeID = 9071bb8a-c906-fd8e-cc49-aa8d498afe29
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:9071bb8a-c906-fd8e-cc49-aa8d498afe29
msgctxt "h9f6d5dbcgfd4ag45ecgb5c6g07114525d176"
msgid ""
"Fair enough - I can see you've bled for us, so I won't prod any further."
msgstr "좋아, 당신이 우릴 위해 흘린 피를 생각해서, 더 이상 묻진 않을게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Cerys
#. NodeID = 91e50a40-737b-13c4-cbeb-c673da6afc5b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingRefugees_Quest_HuntRewardOffered = False
#. SetFlags:
#.   Global:
#.     - DEN_TieflingRefugees_Quest_HuntRewardOffered = True
#.   Object:
#.     - DEN_GoblinHunt_Event_GiveRewardBag(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:91e50a40-737b-13c4-cbeb-c673da6afc5b
msgctxt "hc0138d98g786eg4c55g9b20gcfe6f12f3a60"
msgid ""
"Here. It's faint thanks compared to what you've done for us, but it's all we "
"have."
msgstr "여기. 당신이 우릴 위해 해준 일에 비하면 얼마 안 되지만, 이게 우리가 가진 전부야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Cerys
#. NodeID = 92941d60-426a-3a16-c318-7e959565d25f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:92941d60-426a-3a16-c318-7e959565d25f
msgctxt "h94ddcb82g707bg4ed3ga0e2g9eff26a3abce"
msgid ""
"I found a path to the city - and with those goblins dead, there'll never be "
"a better time to get on it."
msgstr "도시로 향하는 길을 찾았어, 그리고 이 고블린들도 죽었으니, 지금이 도시로 떠날 적기야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Player
#. NodeID = 960f5b95-081e-2a9e-e7ad-673fb908ea7c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:960f5b95-081e-2a9e-e7ad-673fb908ea7c
msgctxt "h98026450gf221g4117gb58ag05b104cff865"
msgid "I prefer not to travel with civilians."
msgstr "민간인들과 함께 여행하고 싶진 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Cerys
#. NodeID = a5095852-3d00-2f9a-10ef-23f1a01bfdff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:a5095852-3d00-2f9a-10ef-23f1a01bfdff
msgctxt "h287a98e0g5a6cg40cfg8791g9a8e77959452"
msgid ""
"We've another road to walk, and it's past time we were on it. Though... I "
"suppose some thanks is in order."
msgstr "갈 길은 멀고, 지금 출발해도 꽤 늦지만…순리대로 감사를 표하는 게 맞겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Cerys
#. NodeID = a6ded6b8-17b2-e3fd-8a43-6545ea810873
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_BackupLeader(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:a6ded6b8-17b2-e3fd-8a43-6545ea810873
msgctxt "h7f14ebf6g008dg492dg9b4ag30ffe0c72c0a"
msgid "Good to go?"
msgstr "가도록 할까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Cerys
#. NodeID = a8217635-6d0f-9d07-5180-b1a36cb890f7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:a8217635-6d0f-9d07-5180-b1a36cb890f7
msgctxt "h9e8b6d57gfc35g486aga388gd0b479797e6b"
msgid "As do I. But you've done your part, so I suppose it's time I did mine."
msgstr "나도 그래. 하지만 당신이 역할을 다해줬으니, 이제 내가 할 차례겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Cerys
#. NodeID = b89a749c-07c0-c674-cd93-d6d4654864ee
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Absolute_Knows_MoonriseTowers = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:b89a749c-07c0-c674-cd93-d6d4654864ee
msgctxt "h9b719cdag7567g47f0g946dg1bfeea28a772"
msgid ""
"One thing - take care to the west. This new god has a tight grip on Moonrise "
"Towers."
msgstr "한 가지만, 서쪽으로 향하려면 조심해. 새로운 신이라는 작자가 문라이즈 타워를 완전히 장악했으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Player
#. NodeID = b985d100-ca39-709f-b1ee-8c074553131d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:b985d100-ca39-709f-b1ee-8c074553131d
msgctxt "hb82fbc8dg3f15g4f94g81e2g291b1d384bf8"
msgid "That's my business."
msgstr "그건 네 알 바 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Player
#. NodeID = bd7ae833-e7d1-66f8-28db-77de4991d8d1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:bd7ae833-e7d1-66f8-28db-77de4991d8d1
msgctxt "hbbe168fcg0a3fg428fga2f7g87a297a0ca93"
msgid "I lost track of him in the battle."
msgstr "전투 중에 그의 행방을 잃었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Cerys
#. NodeID = be8df5b7-bb77-66ae-9d3b-ee4efa4f15f6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:be8df5b7-bb77-66ae-9d3b-ee4efa4f15f6
msgctxt "h3311e522g006eg421fgacd5gbb8523edc9ef"
msgid ""
"Trust a priest not to say it plain - he's dead, then. Godsdammit, Asharak."
msgstr "사제란 뭘 직접 말해주는 법이 없군. 그렇다면 죽었다는 이야기겠지. 망할, 아샤라크."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Cerys
#. NodeID = c482fa32-c92e-527e-b6d1-2a0f777501a7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Refugees_State_LeadersAreDead = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_BackupLeader(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:c482fa32-c92e-527e-b6d1-2a0f777501a7
msgctxt "h889db87fg4214g497cga576gbbfb89e54277"
msgid "Ah - there you are. No, we haven't met - but I know your work."
msgstr "아, 거기 있군. 만난 적은 없지만, 네가 한 일들에 대해선 들었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Cerys
#. NodeID = cbd0f30c-b8f7-a1c5-b0a8-d7b86a980f3f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:cbd0f30c-b8f7-a1c5-b0a8-d7b86a980f3f
msgctxt "h4fc06556g01a6g456fg93efg609536b9b76a"
msgid ""
"But if what Asharak said of you is true... you have unfinished business out "
"here."
msgstr "하지만 아샤라크가 너에 대해서 알려준 게 사실이라면…여기서 아직 덜 끝마친 일이 있을 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Cerys
#. NodeID = ce096671-5873-59fd-ab86-2b5a6090d6ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:ce096671-5873-59fd-ab86-2b5a6090d6ed
msgctxt "hc1eb48bcg55c9g48f0g8cb3gdc0df5cb3cea"
msgid "Should you be heading west, be careful."
msgstr "서쪽으로 향하려면, 조심해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Cerys
#. NodeID = ce89dc80-9fee-657d-82b2-21cbe06640b5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:ce89dc80-9fee-657d-82b2-21cbe06640b5
msgctxt "h1e66ebacg47e4g4dafgb787gbbd8287ade55"
msgid ""
"<i>He</i> was supposed to play chaperone with this lot, not me. But - "
"moaning won't make the road ahead shorter, I suppose."
msgstr "그가 보호자 역할을 하기로 했었는데. 슬퍼한다고 나아갈 길이 짧아지진 않겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Cerys
#. NodeID = d20e2114-4396-3fe0-23e8-e65b30f533d9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_BackupLeader(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:d20e2114-4396-3fe0-23e8-e65b30f533d9
msgctxt "ha31c8beeg1435g4871gb3e3g1650458fbd5b"
msgid "Beshaba's black bones, I'm too late. You - where's Asharak?"
msgstr "베샤바 맙소사, 너무 늦었군. 아샤라크는 어디에 있지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Player
#. NodeID = d55bda1e-a784-27bf-eed8-47475ca5e5da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:d55bda1e-a784-27bf-eed8-47475ca5e5da
msgctxt "he2c4f245g142cg4dafg9986g527c0896b7c2"
msgid "I prefer to keep my affairs to myself, thanks."
msgstr "내 일은 내가 신경 쓰도록 하지. 어쨌든 고맙군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Cerys
#. NodeID = dc739a40-cb86-31ed-95fb-6638b8a4bccb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingRefugees_Quest_HuntRewardOffered = False
#. SetFlags:
#.   Global:
#.     - DEN_TieflingRefugees_Quest_HuntRewardOffered = True
#.   Object:
#.     - DEN_GoblinHunt_Event_GiveRewardBag(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:dc739a40-cb86-31ed-95fb-6638b8a4bccb
msgctxt "hd4a24976g5953g4a8fg8599g8b51f88e9516"
msgid ""
"Here. It's faint thanks compared to what you've done for us, but it's all we "
"have."
msgstr "여기. 당신이 우릴 위해 해준 일에 비하면 얼마 안 되지만, 이게 우리가 가진 전부야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Player
#. NodeID = e41443f0-b801-86de-d7ab-d6e22f5832c5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:e41443f0-b801-86de-d7ab-d6e22f5832c5
msgctxt "h056d12f9g2b13g4e00g893fgbb761d29e19b"
msgid "<i>Introduce yourself.</i>"
msgstr "<i>자기소개를 한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Cerys
#. NodeID = ea01b866-5531-e9c1-bbd0-47d3563f879f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:ea01b866-5531-e9c1-bbd0-47d3563f879f
msgctxt "hd66ffab9gc452g4282g8dddg7748f0eae6c0"
msgid "Gods above - that's the druid. Some timing you have, Halsin."
msgstr "신이시여, 저게 내가 말한 드루이드야. 극적인 타이밍이군, 할신."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Cerys
#. NodeID = f16c47d1-a5bc-a912-62e2-0ebd54ae584f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:f16c47d1-a5bc-a912-62e2-0ebd54ae584f
msgctxt "hb04a8643gc6ebg4955g928dgcef893ca7252"
msgid "No point spreading honey on dung - he's dead. Godsdammit, Asharak."
msgstr "좋게 돌려 말해봤자 소용없어. 죽었군. 망할, 아샤라크."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Player
#. NodeID = f5cbc61f-a739-d39b-222d-3caca558ca7c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:f5cbc61f-a739-d39b-222d-3caca558ca7c
msgctxt "h719cbb2eg3fcbg4616g9fb4gb3ce89ec0f60"
msgid "That was me."
msgstr "그게 나야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader
#. Speaker = Cerys
#. NodeID = fe5c8feb-201d-0c4c-fd2e-6fd790555032
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupLeader:fe5c8feb-201d-0c4c-fd2e-6fd790555032
msgctxt "hbe53b5edg26a5g404cg8e81g2ac46d947f9e"
msgid "Godsdammit, Asharak."
msgstr "젠장, 아샤라크."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupVictory
#. Speaker = Cerys
#. NodeID = 038107e8-6758-4220-101d-c87c8170be34
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupVictory:038107e8-6758-4220-101d-c87c8170be34
msgctxt "hcbb4e9b1g0d3bg475eg92cbg4b02302ec71a"
msgid ""
"You. I won't pretend to know why, but you've been a friend to us when we "
"needed it most."
msgstr "당신. 우릴 왜 도와주는지는 모르겠지만, 당신은 가장 필요로 할 때 우리에게 도움의 손길을 내밀어줬어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupVictory
#. Speaker = Cerys
#. NodeID = 295e7e6f-cb3c-19a9-ea03-949efc7b4422
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupVictory:295e7e6f-cb3c-19a9-ea03-949efc7b4422
msgctxt "h135e29a0g66bbg4428g9552g66fa1c1d9850"
msgid ""
"We've lost people today. But we are alive, and the dead have bought us a "
"chance."
msgstr "오늘 많은 이들을 잃었어. 하지만 결국 우린 살아남았어, 그리고 죽은 이들이 우릴 위해 두 번째 기회를 준 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupVictory
#. Speaker = Cerys
#. NodeID = 34066557-f9a1-0e92-b83f-14eac1fc3a15
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupVictory:34066557-f9a1-0e92-b83f-14eac1fc3a15
msgctxt "h8e44e190g78b3g4190g9c2cg34b6cf4b54f8"
msgid "The road waits - and beyond it, Baldur's Gate."
msgstr "도로가 근처에 있어, 그리고 그 너머에 발더스 게이트가 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupVictory
#. Speaker = Cerys
#. NodeID = 37beccc5-2750-34d4-f6fe-a3aac92f83e8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupVictory:37beccc5-2750-34d4-f6fe-a3aac92f83e8
msgctxt "ha3df7fabge8d7g4973g81b2g7adc55e5db30"
msgid "Gods above - that's the druid. Some timing you have, Halsin."
msgstr "신이시여, 저게 내가 말한 드루이드야. 극적인 타이밍이군, 할신."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupVictory
#. Speaker = Cerys
#. NodeID = 5cac2e8c-4f9f-4216-0a48-546dcfe975f2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupVictory:5cac2e8c-4f9f-4216-0a48-546dcfe975f2
msgctxt "hba52fa9fgbd2fg462ega437g2d9326576b8d"
msgid ""
"The greatest honour we can do them is to use it - so make yourselves ready."
msgstr "그들을 기릴 최고의 방법은 그걸 이용하는 거겠지, 그러니 준비해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupVictory
#. Speaker = Cerys
#. NodeID = 986589c2-5f73-6a0a-d66a-6694421344e1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupVictory:986589c2-5f73-6a0a-d66a-6694421344e1
msgctxt "h395b9738g5998g4cc2g9432g9acb75e84ce0"
msgid ""
"Here. It's faint thanks compared to what you've done for us, but it's what "
"we have."
msgstr "여기. 당신이 우릴 위해 해준 일에 비하면 얼마 안 되지만, 그게 우리가 가진 전부야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupVictory
#. Speaker = Cerys
#. NodeID = de29cecb-e7db-e060-beab-cdd72fc3eccd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupVictory:de29cecb-e7db-e060-beab-cdd72fc3eccd
msgctxt "h92f0dfb4g4f89g4c9dgafcbgea87ee5487a8"
msgid "All the more reason to find us when you get to the city, eh?"
msgstr "도시에 도착하면 우릴 찾을 이유가 늘었네, 안 그래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupVictory
#. Speaker = Cerys
#. NodeID = f3200844-ebff-273a-72b5-4b3e301c709e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BackupVictory:f3200844-ebff-273a-72b5-4b3e301c709e
msgctxt "h2edd57afgc6eeg41b0gb567ge19ba9eb1831"
msgid "Go on. He'll want to speak to the one who saved his grove, I expect."
msgstr "가봐. 숲을 구한 구원자와 이야기하고 싶어할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard
#. Speaker = Karlach
#. NodeID = 0aa1ec66-1ba9-c404-7f57-bfc686fae5a9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard:0aa1ec66-1ba9-c404-7f57-bfc686fae5a9
msgctxt "hc8d19ef2gc0a5g4326g8d58g77d22868efff"
msgid "All in a day's work."
msgstr "늘상 하는 일이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard
#. Speaker = Alfira
#. NodeID = 238b2d8b-e900-159c-eba5-c772fff747c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard:238b2d8b-e900-159c-eba5-c772fff747c6
msgctxt "h5b6e4cd3g0a08g4b77g99abgaf9c35487c70"
msgid "Huh. Plenty with tiefling villains... but not so many heroes, no."
msgstr "하, 티플링 악당 이야기는 많아도…영웅은 별로 없죠, 네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard
#. Speaker = Alfira
#. NodeID = 2a0fca42-6fe7-445d-1d28-e1aa09a88181
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard:2a0fca42-6fe7-445d-1d28-e1aa09a88181
msgctxt "h231a7423g30cfg40c9ga39dga214c9a4a915"
msgid ""
"Your job is to get up there and give me something <i>real</i> to sing about."
msgstr "가서 제 노래 가사로 <i>쓸만한</i> 걸 주는 게 당신 역할이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard
#. Speaker = Player
#. NodeID = 337be065-5f2d-7757-ff8f-7a65cc87aef0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingBard_State_FinishedSong = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard:337be065-5f2d-7757-ff8f-7a65cc87aef0
msgctxt "h876868bagc422g4578g9404gc83c558af23a"
msgid "You should play <i>The Weeping Dawn</i> instead."
msgstr "<i>흐느끼는 새벽</i>을 연주해보지 그래."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard
#. Speaker = Alfira
#. NodeID = 34695c6a-be87-c343-b7d4-db92f44f8790
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard:34695c6a-be87-c343-b7d4-db92f44f8790
msgctxt "h480da1c4gc83eg4307gb4a7gae473405c592"
msgid ""
"I don't fancy my chances. They're cute but deadly. Like the Realms' most "
"terrifying bunny rabbits."
msgstr "난 못할 것 같아요. 귀엽지만 위험하다고요. 렐름에서 가장 무서운 토끼처럼요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard
#. Speaker = Alfira
#. NodeID = 37d44608-0fca-6862-47e2-90d9b29c0923
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard:37d44608-0fca-6862-47e2-90d9b29c0923
msgctxt "h87ba048bg8e8cg47d9gb361g884b9cde9b35"
msgid ""
"If today's to be something worth singing about - get up there and make sure "
"it's a <i>happy </i>song."
msgstr "오늘이 노래할 가치가 있다면, 가서 정말 <i>행복한</i> 노래가 되게 해주세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard
#. Speaker = Alfira
#. NodeID = 39c0b9d7-ca51-9876-d15f-b66c4fc55b85
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard:39c0b9d7-ca51-9876-d15f-b66c4fc55b85
msgctxt "h7b57af29g1fc6g4f5dga8a9g43af722e55ec"
msgid "Now's a time for cheerful lies, as my master would say."
msgstr "제 스승님의 말씀처럼, 지금은 희망을 주는 거짓말이 필요해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard
#. Speaker = Player
#. NodeID = 3f0f0c07-645b-aa1a-0202-f4dff632a6dd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard:3f0f0c07-645b-aa1a-0202-f4dff632a6dd
msgctxt "h5d2fc39eg6be9g473bg9954g83be822a0cd4"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard
#. Speaker = Alfira
#. NodeID = 4376cbdc-058b-63ef-6ea2-486cd5ea88d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard:4376cbdc-058b-63ef-6ea2-486cd5ea88d4
msgctxt "h139dcc07gd47bg43e9gbacegb753b9251a51"
msgid ""
"<i>Gods</i>, no. Can't see how a grown woman sobbing is going to lighten the "
"mood much."
msgstr "<i>세상에</i>, 안 돼요. 다 큰 여자가 질질 짜면 분위기가 풀리겠어요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard
#. Speaker = Player
#. NodeID = 4390b069-6287-3967-e285-d1f45989e3d5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = False
#.      - BALDURIAN(1) = True
#. TagRule: REALLY_DARK_URGE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard:4390b069-6287-3967-e285-d1f45989e3d5
msgctxt "hc4e597a2g50a1g49eeg8d29g6bad3822b239"
msgid ""
"I'm an amnesiac, and even <i>I </i>know that's not the true story of "
"Balduran."
msgstr "내 기억력이 좋지는 않다만, <i>나조차도</i> 그게 진짜 발더란 이야기가 아닌 걸 알아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard
#. Speaker = Player
#. NodeID = 4390b069-6287-3967-e285-d1f45989e3d5
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = False
#.      - BALDURIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard:4390b069-6287-3967-e285-d1f45989e3d5
msgctxt "h8db67c4ag4ba0g47b7gb5f4g51e4c344425d"
msgid "I've heard a very different version of the tale of Balduran."
msgstr "내가 들어왔던 발더란 이야기와는 차이가 많군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard
#. Speaker = Alfira
#. NodeID = 48177c9e-623d-4662-3014-a68262dec0ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard:48177c9e-623d-4662-3014-a68262dec0ed
msgctxt "hf75d6ef6g6104g4cc7g9a50gc573e6ebcbbb"
msgid "Just... be safe up there."
msgstr "가서... 몸조심하세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard
#. Speaker = Player
#. NodeID = 4fe42aa0-6aea-b642-8d56-5646eb8d7525
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_TIEFLING(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard:4fe42aa0-6aea-b642-8d56-5646eb8d7525
msgctxt "hee785ba4g751eg4b12ga0e4ge9def8102be8"
msgid "Do you know any stories about tiefling heroes?"
msgstr "티플링 영웅을 노래한 이야기를 알고 있나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard
#. Speaker = Alfira
#. NodeID = 53fad8f1-5b3e-240e-d950-ac2009829f74
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard:53fad8f1-5b3e-240e-d950-ac2009829f74
msgctxt "h4f2643a3gfecfg4484g9f41g96ee20a2e2e0"
msgid ""
"If heroes are in short supply, then I will bloody well make one up. For "
"them, and for me."
msgstr "영웅이 없으면 하나 꾸며내기라도 할 거예요. 사람들과 나를 위해서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard
#. Speaker = Alfira
#. NodeID = 5d30ac2e-cf52-c1d7-a381-a645650c8efb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard:5d30ac2e-cf52-c1d7-a381-a645650c8efb
msgctxt "h95441545g48f3g4f8agaceagb7140b79bffb"
msgid ""
"I suppose you'll just have to get up there and change that. No pressure, kin."
msgstr "당신이 가서 그걸 바꾸겠죠? 부담 갖진 말고요, 동족님."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard
#. Speaker = Player
#. NodeID = 5e8e21ec-3ad8-5b56-3985-df78f2c14bbe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard:5e8e21ec-3ad8-5b56-3985-df78f2c14bbe
msgctxt "h7529aa47g93f6g4867ga955gadc2a4dd65da"
msgid "Well, they're eating up that fiction you just spun."
msgstr "글쎄, 저것들 네가 지어낸 말을 철썩같이 믿고 있는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard
#. Speaker = Player
#. NodeID = 6045500a-a252-2741-cd75-8e70912243b7
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: BESTIAL or HALFORC
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard:6045500a-a252-2741-cd75-8e70912243b7
msgctxt "hb82a0e2eg2aa5g447bgab1cgbc4f17c014ea"
msgid "I could always scare them off. Maybe roar a little, for good measure?"
msgstr "난 언제든 저것들을 겁줘서 쫓아버릴 수 있지. 으르렁 소리는 덤으로. 한 번 해 봐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard
#. Speaker = Alfira
#. NodeID = 6b8d3275-772f-54ef-c526-0b845d1dc79b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard:6b8d3275-772f-54ef-c526-0b845d1dc79b
msgctxt "h972622fegde7dg472agbb09gb936ea4a9468"
msgid ""
"I'd best continue with the stories, for fear of inciting a rebellion. But "
"come back safe, all right?"
msgstr "난리 일어나기 전에 이야기나 계속 쓸게요. 무사히 돌아와요, 알겠죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard
#. Speaker = Player
#. NodeID = 6fc35177-bc13-a374-19a7-371a36332be3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GNOME(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard:6fc35177-bc13-a374-19a7-371a36332be3
msgctxt "h4532ce23gca86g447eg9c5aga5d13b3c0014"
msgid ""
"Fascinating. I suppose trying times lead to desperate measures. Could I "
"watch?"
msgstr "멋진데. 힘들 때 궁여지책이 나오기 쉽지. 좀 봐도 될까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard
#. Speaker = Alfira
#. NodeID = 70d0894c-5674-ef9e-9c17-ec468dc76c07
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard:70d0894c-5674-ef9e-9c17-ec468dc76c07
msgctxt "h9741187bg594dg4d14ga610g105d1823e7d6"
msgid ""
"But making enough noise to keep this little mob distracted? That I can help "
"with."
msgstr "하지만 소리로 놈들 무리의 시선을 돌려서 도와드릴 수는 있죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard
#. Speaker = Alfira
#. NodeID = 92912a71-4637-1234-d23c-2e435cec04b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard:92912a71-4637-1234-d23c-2e435cec04b6
msgctxt "h2f93cf48g3f48g4585g82c3g2fbd0d717eaf"
msgid ""
"But, truly... thank you. It's nice to be done with the sad songs, for a time."
msgstr "진심으로…고마워요. 잠시나마 슬픈 노래를 안 하니까 좋네요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard
#. Speaker = Alfira
#. NodeID = a517f4e1-ad5b-d804-ab06-644d410f86d7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard:a517f4e1-ad5b-d804-ab06-644d410f86d7
msgctxt "h83ae258cg3c32g48ddg89c9g47615efda3c1"
msgid "Live through the day and you might even get to hear the finished thing."
msgstr "살아남는다면 완성된 노래를 들을 수도 있겠죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard
#. Speaker = Alfira
#. NodeID = a894d7a9-14eb-91b3-00cc-3d1a97840888
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard:a894d7a9-14eb-91b3-00cc-3d1a97840888
msgctxt "hbe95ee1cg8a3dg4215gad67gd6cdcbeb179c"
msgid "As a halfling's hoof, I should hope."
msgstr "하플링의 발 같기를 빌어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard
#. Speaker = Alfira
#. NodeID = b047a3ed-d461-d5fe-1338-31edd6209f03
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard:b047a3ed-d461-d5fe-1338-31edd6209f03
msgctxt "h0db432d4gf83fg45b1gb675g0fdbcd8ae82b"
msgid "Hardly going to be much use in a battle, am I?"
msgstr "저는 전투에는 별 쓸모가 없을 테니까요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard
#. Speaker = Alfira
#. NodeID = b2b2f11c-f36a-d4a1-b3a8-7f7f847e0755
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard:b2b2f11c-f36a-d4a1-b3a8-7f7f847e0755
msgctxt "h533a6c60g0df5g4760g95beg41d26a83d774"
msgid "I only seem to know the sad ones, and, well..."
msgstr "슬픈 노래밖에 모르고..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard
#. Speaker = Alfira
#. NodeID = b5aa155a-04e7-1a49-4fa7-afb13e0de193
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard:b5aa155a-04e7-1a49-4fa7-afb13e0de193
msgctxt "hbe98df81g609bg454egb918g7e1da0e79468"
msgid "I'm... better, I think. Song's coming along, thanks to you."
msgstr "좀 나은 것 같아요. 덕분에 노래도 떠오르고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard
#. Speaker = Player
#. NodeID = b5df145e-7bf5-325a-667d-543a62019989
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard:b5df145e-7bf5-325a-667d-543a62019989
msgctxt "h73b54c5fg5718g46a3g8989g7c58dd7403ed"
msgid "What are you doing hiding down here?"
msgstr "여기 숨어서 뭘 하고 있지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard
#. Speaker = Player
#. NodeID = b701d70e-a3e2-624a-6f7d-d7e2197504b4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard:b701d70e-a3e2-624a-6f7d-d7e2197504b4
msgctxt "h15ed70d4g3b00g473fg9bb9g2c5561ada882"
msgid "Then slay the whelps before they have the chance."
msgstr "그렇다면 저것들이 움직이기 전에 먼저 목을 따버려."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard
#. Speaker = Alfira
#. NodeID = b73110c9-7d9b-0e60-6827-f1f2b5dc573b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard:b73110c9-7d9b-0e60-6827-f1f2b5dc573b
msgctxt "h9fd0ea3fg18deg45adg855eg2b7f5d247461"
msgid ""
"You may, but unless you can spin a tale worthy of Milil, I suggest running "
"while you can."
msgstr "해 보세요. 밀릴의 이야기 같은 거 못 만들 거면 빨리 도망치시고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard
#. Speaker = Player
#. NodeID = bc8ae955-e2b7-2af9-8004-abf19f886614
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingBard_State_FinishedSong = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard:bc8ae955-e2b7-2af9-8004-abf19f886614
msgctxt "h93af0886ga1a1g4487g9df0gb1b0a527300f"
msgid "Why don't you play some music instead?"
msgstr "그 대신 음악을 좀 연주해 보는 건 어때?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard
#. Speaker = Alfira
#. NodeID = bd66571a-56b7-12aa-f6a4-267aa924a989
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_TieflingBard(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard:bd66571a-56b7-12aa-f6a4-267aa924a989
msgctxt "h9325a3e2gcb1eg43fcg802eg6b0da3f12794"
msgid ""
"Get to the walls, beat the goblins back. Trust me - it's an easier job than "
"this."
msgstr "성벽에 가서 고블린을 물리쳐요. 분명히 이것보단 쉬울 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard
#. Speaker = Alfira
#. NodeID = cf741320-270c-4917-e2c2-0c257bb0e97c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_TieflingBard(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard:cf741320-270c-4917-e2c2-0c257bb0e97c
msgctxt "h586f2aa6g905fg449fgbb48ga20b74bc2155"
msgid ""
"Yes...? I'm pretty certain if I stop for too long they will actually <i>eat</"
"i> me."
msgstr "네…? 너무 오래 여기 있으면 나 진짜 <i>잡아 먹힐</i> 걸요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard
#. Speaker = Player
#. NodeID = d992716d-6d8f-f8e9-bd49-6c12fc641ca5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard:d992716d-6d8f-f8e9-bd49-6c12fc641ca5
msgctxt "h76e0b192g8b80g41b1gbd8fg119854c28947"
msgid "The details of your story seem a little fuzzy."
msgstr "이야기가 꽤나 뭉뚱그려졌는데. 넝쿨에 가려진 느낌이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard
#. Speaker = Alfira
#. NodeID = e8fa7fed-af5b-ab2f-a600-264f9f609cb4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_TieflingBardVictory(1) = True
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard:e8fa7fed-af5b-ab2f-a600-264f9f609cb4
msgctxt "h0a9a346dg2ee4g4d6dg913dg3ab5bb4641a5"
msgid ""
"On to playing for coppers on the corners of Baldur's Gate. I can hardly "
"stand the glamour."
msgstr "발더스 게이트 구석에서 푼돈이나 받고 연주하게 되겠죠. 그런 생활 못 견디겠어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard
#. Speaker = Alfira
#. NodeID = ea8804a3-6539-cbb8-6693-1ea9e5c8255b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard:ea8804a3-6539-cbb8-6693-1ea9e5c8255b
msgctxt "hd50bbe75g2d60g43dcga54cgf0d0c1089c16"
msgid ""
"I suppose you'll just have to get up there and change that. No pressure, kin."
msgstr "당신이 가서 그걸 바꾸겠죠? 부담 갖진 말고요, 동족님."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard
#. Speaker = Player
#. NodeID = efbb1e21-5a86-f231-4a39-71964d248049
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingBard_State_FinishedSong = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard:efbb1e21-5a86-f231-4a39-71964d248049
msgctxt "h4da35a9fgfac4g4603g8a1eg737acc960fb4"
msgid "Good to see you again. How are you holding up?"
msgstr "다시 만나서 기쁘군. 잘 지내나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard
#. Speaker = Alfira
#. NodeID = f1bf01f1-db35-9fa0-d0c7-ed516f44b566
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_TieflingBardVictory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard:f1bf01f1-db35-9fa0-d0c7-ed516f44b566
msgctxt "h3c696a13g3484g4c06g8eb5g32c291cef204"
msgid "I'm going to have to write a song about you now, aren't I?"
msgstr "이제 당신 노래를 쓰게 생겼네요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard
#. Speaker = Alfira
#. NodeID = f9d5d3d0-47e5-75a2-b38e-132154dc77e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Bard:f9d5d3d0-47e5-75a2-b38e-132154dc77e6
msgctxt "he1c7cf22g6f00g40a8g9831g004979d2e6cf"
msgid ""
"Hah! I'd pay good money to see you try. They're cute but deadly. Like the "
"Realms' most terrifying bunny rabbits."
msgstr "하! 좋은 구경 되겠네요. 걔들 귀엽지만 치명적이에요. 렐름에서 가장 무서운 토끼처럼요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BirdSender
#. Speaker = Apikusis
#. NodeID = 1418c6bd-107b-7436-38d9-102f5e112a0d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_State_Returned = True
#.      - GLO_Halsin_State_PermaDefeated = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BirdSender:1418c6bd-107b-7436-38d9-102f5e112a0d
msgctxt "h5697bbc9g3875g412bg8682g0f7249e233b0"
msgid "The days ahead won't be easy. I'm glad we have Halsin to guide us."
msgstr "앞으로의 일이 쉽진 않겠죠. 저희를 인도해 주실 할신 님이 계셔서 다행이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BirdSender
#. Speaker = Apikusis
#. NodeID = 16801a54-9013-6348-3331-3f06af6dea67
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_BirdSender(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BirdSender:16801a54-9013-6348-3331-3f06af6dea67
msgctxt "h2b7fdfc8g6594g4a94gb525gfee2befcf893"
msgid "You saved a holy place from desecration. Thank you."
msgstr "당신이 이 신성한 곳이 모독당하는 것을 막아주셨어요. 감사합니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BirdSender
#. Speaker = Apikusis
#. NodeID = 52421cfc-c879-2288-b6c3-34e0aecb7c0b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_State_IdolIsMissing = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BirdSender:52421cfc-c879-2288-b6c3-34e0aecb7c0b
msgctxt "h7e125bb5g5e8eg4580gb9e5ge7167e24c932"
msgid "The goblins are gone, but so is our idol. We are exposed without it."
msgstr "고블린들은 사라졌지만, 저희 우상도 마찬가지예요. 그게 없다면 저흰 노출된 것이나 다름없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BirdSender
#. Speaker = Apikusis
#. NodeID = 7ccb040b-deab-42d4-daae-97baa8845c79
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_BirdSender(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BirdSender:7ccb040b-deab-42d4-daae-97baa8845c79
msgctxt "ha1be707fg18f9g4ee5g91edg546802d85b8a"
msgid "Safe travels. You will be remembered here."
msgstr "안전한 여정이 되길. 이곳은 당신을 잊지 않을 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BirdSender
#. Speaker = Apikusis
#. NodeID = 8de8437d-612c-2abc-851b-32860462c95a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BirdSender:8de8437d-612c-2abc-851b-32860462c95a
msgctxt "h9dafa8d7g6d8eg40d9g97b1g4c4f3c7de057"
msgid "The days ahead won't be easy, but we'll manage. We have to."
msgstr "앞으로의 일이 쉽지는 않겠죠, 하지만 해낼 수 있을 거예요. 그래야만 하고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BirdSender
#. Speaker = Apikusis
#. NodeID = ac428e33-3b39-6030-165b-c12f7fc1ec21
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_BirdSender_HasMet_GobLeadersDead(1) = False
#.   Global:
#.      - DEN_Refugees_State_LeadersAreDead = True
#. SetFlags:
#.   Dialog:
#.     - DEN_BirdSender_HasMet_GobLeadersDead(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BirdSender:ac428e33-3b39-6030-165b-c12f7fc1ec21
msgctxt "h0aaff742g9d7bg45bbg8ae2g49cb923b164a"
msgid "We're free of the goblins, but the grove is changed. Wounded."
msgstr "고블린의 위협에선 해방되었지만, 이 숲은 변해버렸어요. 상처를 입었죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BirdSender
#. Speaker = Apikusis
#. NodeID = edd1ea76-a315-6be8-f348-23d4f97e2b81
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Refugees_State_LeadersAreDead = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_BirdSender:edd1ea76-a315-6be8-f348-23d4f97e2b81
msgctxt "h08253205g5352g44dcgb209geb513a21e712"
msgid "Thanks to you, we have the chance to heal."
msgstr "고마워요. 덕분에 치유의 기회가 생겼어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon
#. Speaker = Ikaron
#. NodeID = 0040aa4d-f2c4-aa0d-04d4-78ee7d4b76b8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon:0040aa4d-f2c4-aa0d-04d4-78ee7d4b76b8
msgctxt "h7b94eddfg3be9g47f4gb6d9g1681a6040f0c"
msgid "Mother -"
msgstr "엄마!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon
#. Speaker = Ikaron
#. NodeID = 0344006d-759f-6691-c515-381a5740a547
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_ChefAndSon(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon:0344006d-759f-6691-c515-381a5740a547
msgctxt "hcb8759ecg2cafg42a1g858ag287b23440533"
msgid "I suppose we'll have to make do."
msgstr "어거지로 버텨낼 수밖에 없겠어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon
#. Speaker = Player
#. NodeID = 03a82365-db5f-ba04-c3f8-f38a3d9c4ace
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ELF or REALLY_SELDARINEDROWELF
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon:03a82365-db5f-ba04-c3f8-f38a3d9c4ace
msgctxt "h2e81cbb2gb34fg4594g985dg50b045e9099e"
msgid ""
"The past can't be changed. Focus on your future before that too is set in "
"stone."
msgstr "과거는 바꿀 수 없는 법이야. 미래마저 그리되기 전에 거기에 집중해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon
#. Speaker = Okta
#. NodeID = 0da4d351-034e-d2a3-853d-685d612400ff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon:0da4d351-034e-d2a3-853d-685d612400ff
msgctxt "h1a5bd26eg5346g4569g9650g8c024f584aed"
msgid "Enough! I will knock both of your heads together unless you cut it out."
msgstr "그만해! 당장 관두지 않으면 너희 둘 다 머리통을 후려 팰 거다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon
#. Speaker = Ikaron
#. NodeID = 0e988fc1-442b-238f-ae50-3701be404739
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon:0e988fc1-442b-238f-ae50-3701be404739
msgctxt "h51b9130fgfd04g4d6ega018gb045bec37e1b"
msgid ""
"You <i>bastard.\n"
"</i>"
msgstr ""
"이 <i>씹새끼가!\n"
"</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon
#. Speaker = Ikaron
#. NodeID = 10879629-fec7-38f9-554d-1477d828009a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon:10879629-fec7-38f9-554d-1477d828009a
msgctxt "h4372d71fge3ddg4d1cgacacgc789c5813e5a"
msgid "Exactly. Bloody traitors - the lot of them."
msgstr "내 말이. 염병할 배신자들이지… 하나같이 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon
#. Speaker = Okta
#. NodeID = 18c00f0e-6054-f4eb-926d-b2b3c3c3d480
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon:18c00f0e-6054-f4eb-926d-b2b3c3c3d480
msgctxt "h7743bbbeg3017g454fg8a98g4f565bde96fb"
msgid "We will, son. Don't worry about it."
msgstr "해낼 거다, 얘야. 걱정하지 말려무나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon
#. Speaker = Okta
#. NodeID = 1c9c364d-d2d0-7da7-b272-bff49950081c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon:1c9c364d-d2d0-7da7-b272-bff49950081c
msgctxt "h9384e724g3600g4ba1gb217g43f587150558"
msgid ""
"Not another word! Back to work - all of you! We've a battle to prepare for!"
msgstr "그만하라니까! 일이나 마저 해, 너희 모두! 대비해야 할 전투가 있잖냐!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon
#. Speaker = Ikaron
#. NodeID = 23503733-378c-0478-1b3d-1903af9c7a1e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon:23503733-378c-0478-1b3d-1903af9c7a1e
msgctxt "hbada6e45gf081g464fg86cagd244f2186302"
msgid ""
"No! Our so-called <i>kin </i>fled the moment their tails were in danger!"
msgstr "못 해요! 우리 <i>동족</i>이란 것들이 이 위기에서 냅다 달아났는데 어떻게요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon
#. Speaker = Ikaron
#. NodeID = 23ee5ab0-2184-fe6f-ceab-3fc347152bcf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon:23ee5ab0-2184-fe6f-ceab-3fc347152bcf
msgctxt "hc599c2a1gc9d2g449ag85c4g029aa8b6fa47"
msgid "You're right. Lingering on this won't do much good."
msgstr "맞는 말이네. 그런 데 집착해봤자 도움될 건 없긴 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon
#. Speaker = Ikaron
#. NodeID = 2f02554d-689b-52bc-c389-8d119e9504b2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Prodigy_State_Leaving = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon:2f02554d-689b-52bc-c389-8d119e9504b2
msgctxt "h280e76b3g1149g474dgb9c8g293d89af2036"
msgid ""
"Even that cursed wizard took off. Rolan's magic could have made all the "
"difference, you know!"
msgstr "그 염병할 위저드마저 튀었죠. 롤란의 마법이라면 전세가 바뀔 수도 있단 거 알잖아요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon
#. Speaker = Okta
#. NodeID = 30526b2f-5f1b-9071-19cd-74964bddf410
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon:30526b2f-5f1b-9071-19cd-74964bddf410
msgctxt "hb2c3bf2bg7d0cg4d36gbe32g58938460bfe3"
msgid ""
"Ikaron! We're in for a hell of a fight - focus on the matters at hand, not "
"the ones you can't fix!"
msgstr "이카론! 우린 큰 싸움을 앞두고 있어! 바로잡지 못할 일 말고, 지금 직면한 일에 집중하렴!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon
#. Speaker = Player
#. NodeID = 370fc22c-33ad-17d6-e146-86e5c05c1ff8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN_EVIL(2) = True
#.      - TIEFLING(2) = False
#. TagRule: CLERIC_EVIL or PALADIN_EVIL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon:370fc22c-33ad-17d6-e146-86e5c05c1ff8
msgctxt "h23b9ee5cgb25eg48b7g8511ge6454ec91e29"
msgid ""
"Your kin's probably bleeding out on a goblin pike right now. What a waste."
msgstr "네 그 동족들, 아마 지금쯤 고블린들한테 꼬치가 되어 피 흘리고 있을걸? 모자란 짓한 거지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon
#. Speaker = Okta
#. NodeID = 3a962092-b30b-9c3c-1f39-2ec45a47f4ce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon:3a962092-b30b-9c3c-1f39-2ec45a47f4ce
msgctxt "hc665091egdd77g47b9g903cg666657e95732"
msgid "Cut it out, Ikaron! All this grousing is useless."
msgstr "그만 하렴, 이카론! 이리 투덜대봤자 뭐가 달라져?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon
#. Speaker = Okta
#. NodeID = 3ad95980-d0c9-e27d-359d-05f1c72f4029
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon:3ad95980-d0c9-e27d-359d-05f1c72f4029
msgctxt "hb893f643gaeddg4013g8876ga10361541fd4"
msgid ""
"Finally! Now can we all get back to work? Idle chatter isn't going to defeat "
"those goblins."
msgstr "그렇지! 이제 할 일이나 마저들 하련? 한가하게 수다 떤다고 고블린들이 절로 고꾸라지진 않잖니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon
#. Speaker = Player
#. NodeID = 3cfaca69-b9f6-1fce-c4cc-a221ae351260
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon:3cfaca69-b9f6-1fce-c4cc-a221ae351260
msgctxt "hd3acd24dg2814g46bbgb691g5cafa09522b6"
msgid "Cowards deserve a traitor's fate."
msgstr "겁쟁이들은 배신자다운 말로를 맞아야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon
#. Speaker = Okta
#. NodeID = 61bb2860-bcb3-c8e9-f722-89570b394009
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon:61bb2860-bcb3-c8e9-f722-89570b394009
msgctxt "h1901aadfg2e12g49cbga94cg7782983e6333"
msgid "Which is their problem now, not ours."
msgstr "그건 이제 걔네 문제이니, 우린 신경 끄면 돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon
#. Speaker = Okta
#. NodeID = 706c8b04-763f-767b-31a5-15bb5d3cba39
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon:706c8b04-763f-767b-31a5-15bb5d3cba39
msgctxt "hb6002943gc0b7g47b2ga17fg47ff6b4b8c35"
msgid "Leave it, son."
msgstr "잊어라, 아들아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon
#. Speaker = Ikaron
#. NodeID = 715436e3-44d8-581b-9080-d462950673c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon:715436e3-44d8-581b-9080-d462950673c0
msgctxt "h0a719a4cg5a43g4408g8a97g362d0783e7b0"
msgid "The fools - they'll never make it to Baldur's Gate on their own."
msgstr "멍청이들. 지들만으론 절대 발더스 게이트에 살아서 닿지 못할걸?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon
#. Speaker = Ikaron
#. NodeID = 7b2f9253-0c52-eeb0-f755-6ec87a364ff1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon:7b2f9253-0c52-eeb0-f755-6ec87a364ff1
msgctxt "h49cbd396gfa36g48a8g8bb5ge6dd2986d391"
msgid "Spoken like a true coward."
msgstr "순 겁쟁이나 내뱉을 말이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon
#. Speaker = Ikaron
#. NodeID = 82b86b7b-a917-ce89-ae18-7a75b2864f1e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_ChefAndSon(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon:82b86b7b-a917-ce89-ae18-7a75b2864f1e
msgctxt "hb64e71c0gad88g4029gab8bg27cfcc21afeb"
msgid "I can't believe they just <i>left! </i>"
msgstr "그놈들이 그냥 그렇게 여길 <i>튀다니!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon
#. Speaker = Ikaron
#. NodeID = 84c2aabd-9496-feee-620b-b825d05965f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon:84c2aabd-9496-feee-620b-b825d05965f4
msgctxt "h2215d96bgc470g4fe4gb9dagff9e132c9e7e"
msgid "I know. Thank you - for not running like the others."
msgstr "알고 있어요. 고마워. 딴 녀석들처럼 도망치지 않아줘서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon
#. Speaker = Player
#. NodeID = 86461064-45d5-ea7f-b21b-bb2e58767f00
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon:86461064-45d5-ea7f-b21b-bb2e58767f00
msgctxt "hff86a007ga28fg440fg9e5agb0a63426b5ee"
msgid "What's going on here?"
msgstr "뭔 일로 이러는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon
#. Speaker = Okta
#. NodeID = 8a17a924-e5c6-353e-88c6-081a1fcb07ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon:8a17a924-e5c6-353e-88c6-081a1fcb07ed
msgctxt "h56ce380dg4e68g4579g9eefg1b5ff57d7b29"
msgid "Exactly! And look: we're not on our own, are we? Not anymore."
msgstr "내 말이! 그리고 봐라. 우리 말고도 남은 이가 있잖니. 이제는 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon
#. Speaker = Player
#. NodeID = 9108c4a4-a8d9-8428-898d-fd127b08eb5c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon:9108c4a4-a8d9-8428-898d-fd127b08eb5c
msgctxt "he89f9325g306cg46e0ga25dg5bddf31308e2"
msgid "She's right. The coming battle won't be easy."
msgstr "네 어머니 말이 맞아. 곧 있을 전투는 정신없을 거라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon
#. Speaker = Player
#. NodeID = a1e471dd-99b8-4d64-160e-930caf27d05d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRAGONBORN(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon:a1e471dd-99b8-4d64-160e-930caf27d05d
msgctxt "h769a2053g123ag4856g8f1bg4ea28824a56c"
msgid "Clan is everything. Those tieflings gave up their honour."
msgstr "일족은 전부나 다름없는 건데. 그 티플링들은 명예를 저버렸군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon
#. Speaker = Okta
#. NodeID = a776bd8e-7a60-dbe4-5c01-52756e324644
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon:a776bd8e-7a60-dbe4-5c01-52756e324644
msgctxt "hff405095gfd7bg4bcfgb36cg3c926778dae6"
msgid ""
"Some of the others took off in the middle of the night. Left their own kin "
"to fend for themselves."
msgstr "지난 밤중에 몇몇 이들이 여기서 달아나버렸어. 동족들이 죽든 말든 내버려 두고 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon
#. Speaker = Player
#. NodeID = add390af-adf8-d038-57ad-6b162a2bc4db
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon:add390af-adf8-d038-57ad-6b162a2bc4db
msgctxt "h03825e71g5e53g4c6dgb3bdgfa958463e694"
msgid "Rage is fuel. Use it for the fight ahead, not to complain."
msgstr "분노는 좋은 연료지. 불평불만에 허비하지 말고 다가올 싸움에 써."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon
#. Speaker = Player
#. NodeID = c105d05f-2e91-d4a4-7975-49812a3f35f7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TIEFLING(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon:c105d05f-2e91-d4a4-7975-49812a3f35f7
msgctxt "h9f9f558cgf87cg4912g8231g8ebf4cf6a568"
msgid "I'd be devastated if one of my own betrayed me."
msgstr "나도 내 사람 중 누가 배신한다면 망연자실할 듯해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon
#. Speaker = Player
#. NodeID = d2af794b-7d75-3439-3502-e579e5d21396
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DWARF(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon:d2af794b-7d75-3439-3502-e579e5d21396
msgctxt "h172ada34g3ea4g42b1gbe3dge8bf72f341f2"
msgid "Sad thing, if that's the state of 'kin' these days."
msgstr "이게 요즘 '동족' 의식의 현실이라면 통탄할 일이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon
#. Speaker = Player
#. NodeID = e3b03ec3-516b-008f-67c0-1cad28773aae
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_TIEFLING
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon:e3b03ec3-516b-008f-67c0-1cad28773aae
msgctxt "h3a2e1cadgd440g4653g9360ga6a546daa199"
msgid "Running's a smart move. Especially for us."
msgstr "도주는 현명한 수이긴 하지. 우리 종족에겐 특히 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon
#. Speaker = Player
#. NodeID = e3b03ec3-516b-008f-67c0-1cad28773aae
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon:e3b03ec3-516b-008f-67c0-1cad28773aae
msgctxt "hbe49470cgee98g4805gbc39g8c6261ac3d53"
msgid "Running's a smart move. Especially for a tiefling."
msgstr "도주는 현명한 수이긴 하지. 티플링이라면 특히 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon
#. Speaker = Ikaron
#. NodeID = e409efd3-6f1c-67fc-327a-1196810f03ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ChefAndSon:e409efd3-6f1c-67fc-327a-1196810f03ac
msgctxt "h1ba0ecb3g0155g4035g81eegf57d460aecb8"
msgid ""
"We might die because a bunch of traitors cared more about saving their hides "
"then they did about us."
msgstr "배신자 녀석들이 모두의 안위보다 지들 일신만 챙긴 덕분에 우리가 죽을지도 모르는 판국이라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Nightwarden Minthara
#. NodeID = 0498d0b3-7209-8841-bc1f-a45a33d0a79e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:0498d0b3-7209-8841-bc1f-a45a33d0a79e
msgctxt "h2e68b09eg08a3g48fegb66cgc3edaaf08d44"
msgid "But you - I can see you are different. Faithful to the last."
msgstr "하지만 당신은. 그래 당신은 다르겠군. 마지막까지도 충직하겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Player
#. NodeID = 0847c0dc-8f53-b0dc-8b7c-25a47338c419
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Absolute_Knows_MoonriseTowers = True
#.      - GOB_DrowCommander_Quest_AskedAboutPassage = False
#.   Local:
#.      - a759296c-5d41-f5b9-7d31-1c70d1e10dc7_MentionedNere = False
#. SetFlags:
#.   Global:
#.     - GOB_DrowCommander_Quest_AskedAboutPassage = True
#.   Local:
#.     - a759296c-5d41-f5b9-7d31-1c70d1e10dc7_MentionedNere = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:0847c0dc-8f53-b0dc-8b7c-25a47338c419
msgctxt "h23874221g4e24g469bga976g12d605ed19bc"
msgid ""
"I'd prefer to set off for Moonrise than waste time celebrating. How do I "
"reach it?"
msgstr "축배 같은 것 보단 그냥 문라이즈 타워로 출발하고 싶은데. 어떻게 가지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Player
#. NodeID = 088f0813-68ef-72b4-eb27-ce8f96197009
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:088f0813-68ef-72b4-eb27-ce8f96197009
msgctxt "hea6b1428ge6acg4fb0ga408gb9d1b0cbadf3"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Player
#. NodeID = 0a467e5f-c1f5-f730-14a8-724abcdfad8a
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DRAGONBORN and REALLY_DRAGONBORN
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:0a467e5f-c1f5-f730-14a8-724abcdfad8a
msgctxt "h83260f12g8775g4a18gb80cgba1490b780f9"
msgid "There was no honour in this."
msgstr "이 일에 명예는 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Player
#. NodeID = 0a467e5f-c1f5-f730-14a8-724abcdfad8a
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:0a467e5f-c1f5-f730-14a8-724abcdfad8a
msgctxt "h0f5970cdg7e1bg44dbg98c5g0c579fc96fc1"
msgid "This was murder. The only fitting reward for us is the hangman's noose."
msgstr "이건 그냥 살인이야. 우리에게 합당한 보상은 교수형 당할 목줄 뿐이고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Shadowheart
#. NodeID = 0cc8e151-a0ba-dd03-0199-09cdc97d1538
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:0cc8e151-a0ba-dd03-0199-09cdc97d1538
msgctxt "hfc8cfbafgf9feg4725g9de6g330f25481ff8"
msgid ""
"We needn't fight <i>every </i>time, you know. There's this wild notion "
"called choosing your battles!"
msgstr "우린 <i>매번</i> 싸울 필요는 없어, 알지? \"싸울 전투를 선택한다\"는 효과적인 방법도 있어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Nightwarden Minthara
#. NodeID = 17cf0bd2-9ab6-5307-3491-002635dd9f8e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:17cf0bd2-9ab6-5307-3491-002635dd9f8e
msgctxt "h505886fegcfe1g446dg9268g163d2c2bd927"
msgid "And She has so much more to give."
msgstr "게다가 그분은 더 많은 힘을 주실 수 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Nightwarden Minthara
#. NodeID = 1aef83c0-44fa-487e-ed14-212d49f23b48
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:1aef83c0-44fa-487e-ed14-212d49f23b48
msgctxt "h8f099b58gc299g48d8g8ac2g2933e55e2a0b"
msgid ""
"I already know your mind - I <i>will</i> know your body, one way or another."
msgstr "나는 이미 너의 마음을 알고 있다. 너의 몸도 어떻게든 <i>알아낼</i> 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Player
#. NodeID = 1b5fd18f-b3af-d85b-ed8f-24930640e754
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:1b5fd18f-b3af-d85b-ed8f-24930640e754
msgctxt "h42388e69g0173g47e6ga06fgcc14983f929e"
msgid "<i>Reject the vision.</i>"
msgstr "<i>환상을 거부한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Nightwarden Minthara
#. NodeID = 1e4aa957-1b96-cb30-63e1-306dc152a116
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:1e4aa957-1b96-cb30-63e1-306dc152a116
msgctxt "h2a38d55cgce4fg40e1ga9d6g54e28a4c4cdd"
msgid ""
"Greater drow than you have challenged me, sister. The Underdark is thick "
"with their blood."
msgstr "너보다 훨씬 강한 드로우들이 나에게 도전했었다, 자매여. 언더다크는 이미 그들의 피로 흥건하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Nightwarden Minthara
#. NodeID = 1e4aa957-1b96-cb30-63e1-306dc152a116
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:1e4aa957-1b96-cb30-63e1-306dc152a116
msgctxt "h10c5b057g4d7bg4b18g9f6fg6dc878ca7ea0"
msgid ""
"Greater drow than you have challenged me, <i>jaluk</i>. The Underdark is "
"thick with their blood."
msgstr "너보다 훨씬 강한 드로우들이 나에게 도전했었다, <i>잘루크</i>. 언더다크는 이미 그들의 피로 흥건하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Nightwarden Minthara
#. NodeID = 1e4aa957-1b96-cb30-63e1-306dc152a116
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:1e4aa957-1b96-cb30-63e1-306dc152a116
msgctxt "h8d5cfeb9ga9ddg48dbga82fg3776213c22af"
msgid ""
"Greater drow than you have challenged me, <i>wael</i>. The Underdark is "
"thick with their blood."
msgstr "너보다 훨씬 강한 드로우들이 나에게 도전했었다, <i>웨엘</i>. 언더다크는 이미 그들의 피로 흥건하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Narrator
#. NodeID = 1f03a675-8329-9c16-6c85-90bbb053f86c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:1f03a675-8329-9c16-6c85-90bbb053f86c
msgctxt "hacff769eg0cc3g4052ga934g115a5d5e0be8"
msgid ""
"*A flash of anger pulses across your brain. You feel cold metal at your "
"throat - then you snap back to yourself.*"
msgstr "*순간적인 분노에 당신의 뇌가 요동칩니다. 당신의 목구멍에 차가운 금속이 느껴지고 나서, 당신은 다시 정신을 차립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Nightwarden Minthara
#. NodeID = 21e11ae2-23f6-7996-b832-6fb0e61a85d6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(3) = True
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:21e11ae2-23f6-7996-b832-6fb0e61a85d6
msgctxt "h82d69b38gdd33g4358gb69egc23b5b6c1eaa"
msgid ""
"You dare to challenge me? We will see who the Absolute <i>truly</i> loves."
msgstr "감히 내게 도전하는 건가? 절대자가 누굴 <i>진실로</i> 총애하는지 한번 보자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Player
#. NodeID = 29c5c8b8-9357-ed14-391d-c4f3c31b16dd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LOLTHDROWELF(1) = False
#.      - LOLTHDROWELF(1) = False
#. SetFlags:
#.   Global:
#.     - GOB_DrowCommander_State_Hostile = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:29c5c8b8-9357-ed14-391d-c4f3c31b16dd
msgctxt "h5f1eceeag1435g4241g9d7agadd5a5eb077e"
msgid "You won't live to collect any reward, but I will collect your head."
msgstr "넌 살아서 보상을 얻지 못할 거고, 난 너의 머리를 얻을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Nightwarden Minthara
#. NodeID = 303107aa-5af4-20d1-0978-8af9066c61b6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - DEN_Conflict_SUB_AoD.OrderedKillDruids(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:303107aa-5af4-20d1-0978-8af9066c61b6
msgctxt "h99cad534gae06g4d9agb942g7efe68d131b7"
msgid ""
"But there is more to be done. This place is home to druids - root them out "
"and kill them."
msgstr "하지만 아직 할 일이 남았다. 이곳은 드루이드들의 집이지, 놈들을 뿌리 뽑고 몰살해라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Nightwarden Minthara
#. NodeID = 3333ebcd-2f04-8c28-7362-02681526f8a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:3333ebcd-2f04-8c28-7362-02681526f8a3
msgctxt "h4948a0ddg522cg46cag9439g6ef7016f7e82"
msgid "All will be revealed come dawn."
msgstr "날이 밝아오면 모든 게 밝혀지겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Nightwarden Minthara
#. NodeID = 374431a1-b33b-dab0-5d63-df3e03b76b89
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:374431a1-b33b-dab0-5d63-df3e03b76b89
msgctxt "h2b0501c8g1920g4a48ga580gfe38d0757179"
msgid "There are more - hunt them down!"
msgstr "더 있다 - 추적해서 찾아내라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Player
#. NodeID = 3c8ca776-8362-9409-7d29-bcf9e94932ee
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_Event_InsufficientDefense = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:3c8ca776-8362-9409-7d29-bcf9e94932ee
msgctxt "h0a152174g46a7g4febg8c7eg376ae918c79a"
msgid "It's been a privilege to fight alongside you."
msgstr "너와 함께 싸울 수 있어서 영광이었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Nightwarden Minthara
#. NodeID = 3cd40497-c3f8-ea0b-7605-fc1236cfbd5a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_Drow_HasMet(1) = False
#.   Object:
#.      - DEN_AttackOnDen_State_Victorious(0) = True
#.   Tag:
#.      - ELF(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_Drow_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:3cd40497-c3f8-ea0b-7605-fc1236cfbd5a
msgctxt "ha4211078g8904g4b4bg9ae9g58fdfa872321"
msgid ""
"Praise the Absolute! She will reward us well for this exquisite carnage."
msgstr "절대자님을 찬양하라! 그분께서 이 아름다운 학살에 대해 후한 상을 내리실 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Lae'zel
#. NodeID = 3ce3a69d-8c41-41f6-7ca2-836bb81c6a14
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:3ce3a69d-8c41-41f6-7ca2-836bb81c6a14
msgctxt "hc555584bg9f25g4c39g8a1ag667edab8bdeb"
msgid "Your words say <i>nothing</i>, woman. Prove your merit with blood!"
msgstr "말로만 증명할 수 있는 것은 <i>아무것도 없다.</i> 피로 그 가치를 증명해라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Nightwarden Minthara
#. NodeID = 3dbfb102-9f91-43c8-64be-fdc9bf26eefd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DruidsAreDefeated = False
#.   Object:
#.      - DEN_AttackOnDen_State_Victorious(0) = True
#. SetFlags:
#.   Local:
#.     - a759296c-5d41-f5b9-7d31-1c70d1e10dc7_Once = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:3dbfb102-9f91-43c8-64be-fdc9bf26eefd
msgctxt "h56466c4fgeed1g4fffg9983g9bc37298b3f9"
msgid "A glorious day. The Absolute will be pleased."
msgstr "영광스러운 날이군. 절대자께서 만족하실 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Player
#. NodeID = 3de18902-2d8e-9f65-b6c1-63c59c81010a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ELF(1) = True
#.      - REALLY_ELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:3de18902-2d8e-9f65-b6c1-63c59c81010a
msgctxt "hd54a9324ga035g4cf4g86aag0f2a9ea187ac"
msgid "You're an abomination, and now I'm finally going to end you."
msgstr "혐오스럽기 짝이 없군, 마침내 널 끝장내버릴 때가 왔다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Nightwarden Minthara
#. NodeID = 50bd2953-1fe1-26c2-e069-d9a469041939
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:50bd2953-1fe1-26c2-e069-d9a469041939
msgctxt "h87f6b9b4g4b91g4084gb617ga2e5f8c62cf9"
msgid ""
"Pathetic. Your blood betrays you, <i>iblith</i>, and I will spill every drop."
msgstr "애처롭군. 네가 자초한 거다, <i>이블리스</i>, 네 피도 마지막 한 방울까지 흩뿌려 주마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Player
#. NodeID = 53bbe225-d699-aa5e-3ad5-f2e12176a783
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:53bbe225-d699-aa5e-3ad5-f2e12176a783
msgctxt "h333ce309g0adag41e6g820fg1fdff45e810a"
msgid "<i>Open your mind.</i>"
msgstr "<i>정신을 개방한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Player
#. NodeID = 556bdb52-5748-5dc0-41de-772a534af322
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:556bdb52-5748-5dc0-41de-772a534af322
msgctxt "h688d1342gf8b4g401dg877egcc8114056286"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Narrator
#. NodeID = 564caa55-31b3-be07-aff6-d4613c1a29b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:564caa55-31b3-be07-aff6-d4613c1a29b4
msgctxt "h482dc84eg184cg4970gb351g08fb40471057"
msgid ""
"*Through her eyes, you see yourself: skin glistening with sweat, hands "
"bound. Ecstasy... or terror. Maybe both.*"
msgstr ""
"*그녀의 눈을 통해 자신을 봅니다. 땀으로 반짝이는 피부, 묶여버린 손. 그것이 황홀감일지... 공포일지. 둘 다일 수도 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Nightwarden Minthara
#. NodeID = 69b0779c-5546-c088-f3fd-cea3f010c468
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:69b0779c-5546-c088-f3fd-cea3f010c468
msgctxt "h1cf6b826gd731g442bgaf44g15d719217636"
msgid ""
"There is a bond between us, True Soul. I can see what you are. What you "
"<i>want</i>."
msgstr "우리 사이에는 결속이 있다, 참된 영혼. 나는 네가 무슨 존재인지 알 수 있어. 네가 <i>원하는</i>게 뭔지 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Player
#. NodeID = 69b7d1a1-876d-1ba8-ff11-26725cfc27c0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_DrowCommander_Quest_AskedAboutPassage = True
#.   Local:
#.      - a759296c-5d41-f5b9-7d31-1c70d1e10dc7_MentionedNere = False
#. SetFlags:
#.   Local:
#.     - a759296c-5d41-f5b9-7d31-1c70d1e10dc7_MentionedNere = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:69b7d1a1-876d-1ba8-ff11-26725cfc27c0
msgctxt "h55908fc2gd15ag4183gb4e4g78bec6bbbcc8"
msgid "I've done as you asked. It's time you gave me safe passage to Moonrise."
msgstr "부탁한 대로 했어. 이제 문라이즈로 가는 안전한 경로를 알려줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Nightwarden Minthara
#. NodeID = 808ec75b-b347-b127-ac32-8e4bee6279a6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_Drow_HasMet(1) = True
#.   Object:
#.      - DEN_AttackOnDen_State_Victorious(0) = True
#. SetFlags:
#.   Global:
#.     - DEN_AttackOnDen_Event_GoblinPartyInvitation = True
#.   Quest:
#.     - DEN_Conflict_SUB_AoD.CelebrationGoblins(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:808ec75b-b347-b127-ac32-8e4bee6279a6
msgctxt "hc6b89060gc061g414dga6e1g7d2acc7472bd"
msgid "When you are done, we will celebrate our victory at your camp."
msgstr "일을 끝내고 나면, 네 야영지에서 함께 승리를 만끽하도록 하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Nightwarden Minthara
#. NodeID = 815277ce-6693-c88a-1890-1038a0a68616
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:815277ce-6693-c88a-1890-1038a0a68616
msgctxt "hf7543a9fg6548g40f4g9dd8g4c7e2eff3e20"
msgid ""
"You won't even have the dignity of dying in your homeland. <i>Ssussun pholor "
"dos!</i>"
msgstr "넌 고향 땅에서 죽을 수 있는 존엄조차 가지지 못할 것이다. <i>쑤쑨 팔로 도스!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Nightwarden Minthara
#. NodeID = 86d6f594-73d7-3608-adda-00dd9a32f397
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:86d6f594-73d7-3608-adda-00dd9a32f397
msgctxt "h727deb17gb1c3g4269g8563g92fd10bd727e"
msgid "And you can see what <i>I</i> want."
msgstr "너도 <i>내가</i> 원하는 게 뭔지 알 수 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Narrator
#. NodeID = 96bc0fe2-a70d-e11d-3ac8-c81376efbc76
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:96bc0fe2-a70d-e11d-3ac8-c81376efbc76
msgctxt "h1102773cg5af3g4e40g85c7g811f0d7e0d6a"
msgid ""
"*You see the slaughter of the tieflings again, but through <i>her</i> eyes. "
"The delight of blood, the symphony of screams. Glorious.*"
msgstr ""
"*당신은 티플링들의 학살 현장을 다시금 목격하게 되지만, 이번에는 <i>그녀의</i> 시선으로 보게 됩니다. 선혈의 기쁨, 비명의 "
"교향곡. 멋진 광경입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Player
#. NodeID = 9911cdcf-445f-c92d-41d6-8ec944315fa3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_DrowCommander_Quest_AskedAboutPassage = True
#.   Local:
#.      - a759296c-5d41-f5b9-7d31-1c70d1e10dc7_MentionedNere = False
#. SetFlags:
#.   Local:
#.     - a759296c-5d41-f5b9-7d31-1c70d1e10dc7_MentionedNere = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:9911cdcf-445f-c92d-41d6-8ec944315fa3
msgctxt "h67030b96g7ee2g4744g8969gdf1f99037988"
msgid "I've done as you asked. It's time you gave me safe passage to Moonrise."
msgstr "부탁한 대로 했어. 이제 문라이즈로 가는 안전한 경로를 알려줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Player
#. NodeID = 9aaa493c-2e73-d665-71a7-96febe539a67
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Absolute_Knows_MoonriseTowers = True
#.      - GOB_DrowCommander_Quest_AskedAboutPassage = False
#.   Local:
#.      - a759296c-5d41-f5b9-7d31-1c70d1e10dc7_MentionedNere = False
#. SetFlags:
#.   Global:
#.     - GOB_DrowCommander_Quest_AskedAboutPassage = True
#.   Local:
#.     - a759296c-5d41-f5b9-7d31-1c70d1e10dc7_MentionedNere = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:9aaa493c-2e73-d665-71a7-96febe539a67
msgctxt "h8931f2beg1fb0g4595g96d7g0c0cbb3d3a69"
msgid "I need to reach Moonrise. Tell me the way, and let that be my reward."
msgstr "문라이즈 타워로 가는 방법이 필요해. 내 보상으로 알려주면 좋겠는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Nightwarden Minthara
#. NodeID = a0c46cc4-f549-14dd-97d0-a9bd833c9009
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:a0c46cc4-f549-14dd-97d0-a9bd833c9009
msgctxt "h719b8b1cg6521g42c6gb02bg8f83869ad789"
msgid "Until then, let us revel. The Absolute demands no less."
msgstr "그때까진, 모두 즐기도록 하자. 절대자님도 바라실 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Nightwarden Minthara
#. NodeID = a102042f-fb72-7f4d-5cc8-709f2e076ddf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_DrowCommander_State_AboutToLeave(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:a102042f-fb72-7f4d-5cc8-709f2e076ddf
msgctxt "hc32dbb7egc7c7g460fgabf9g6548ef9c6105"
msgid ""
"I expect great things of you - when the battle begins, show me your worth."
msgstr "네게 거는 기대가 크다- 전투가 시작되면, 네 가치를 증명해라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Player
#. NodeID = a5203fd9-abe4-7993-3097-c348f9c50977
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_DrowCommander_Quest_AskedAboutPassage = True
#.   Local:
#.      - a759296c-5d41-f5b9-7d31-1c70d1e10dc7_MentionedNere = False
#. SetFlags:
#.   Local:
#.     - a759296c-5d41-f5b9-7d31-1c70d1e10dc7_MentionedNere = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:a5203fd9-abe4-7993-3097-c348f9c50977
msgctxt "h06f8e414g2e2ag43a9g9f6cg002e417fbcb1"
msgid "I've done as you asked. It's time you gave me safe passage to Moonrise."
msgstr "부탁한 대로 했어. 이제 문라이즈로 가는 안전한 경로를 알려줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Nightwarden Minthara
#. NodeID = a8573e09-f519-6778-777b-921571f1fd63
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:a8573e09-f519-6778-777b-921571f1fd63
msgctxt "hf09218aag7c9ag4e21gb724g33684e791faa"
msgid ""
"The true honour is to serve the Absolute. She loves you fiercely; I see that "
"in the strength She has given you."
msgstr "절대자님을 섬기는 것이 진짜 영광이다. 그분께선 널 몹시도 사랑하시지. 네게 주신 힘을 보면 알 수 있다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Nightwarden Minthara
#. NodeID = aa613d23-bc9f-511e-a67a-f39081176335
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_Event_InsufficientDefense = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:aa613d23-bc9f-511e-a67a-f39081176335
msgctxt "hc15d71a0ga0d5g4067ga696g27724679cba6"
msgid ""
"There were few left alive - you began the slaughter without me, I assume?"
msgstr "몇 놈 안 살아있더군 - 나 없이 학살을 시작한 모양이지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Player
#. NodeID = b3df903c-6107-c11e-65d1-2dd8b6e758bd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_DrowCommander_Quest_AskedAboutPassage = True
#.   Local:
#.      - a759296c-5d41-f5b9-7d31-1c70d1e10dc7_MentionedNere = False
#. SetFlags:
#.   Local:
#.     - a759296c-5d41-f5b9-7d31-1c70d1e10dc7_MentionedNere = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:b3df903c-6107-c11e-65d1-2dd8b6e758bd
msgctxt "he3774ec3gf774g4be6gb729g3934f2fd19e2"
msgid "I've done as you asked. It's time you gave me safe passage to Moonrise."
msgstr "부탁한 대로 했어. 이제 문라이즈로 가는 안전한 경로를 알려줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Nightwarden Minthara
#. NodeID = c2b537b3-579c-b8f7-c76f-6ec28e519dac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:c2b537b3-579c-b8f7-c76f-6ec28e519dac
msgctxt "hf8cac579g678cg4153g9d21g410046b567e8"
msgid ""
"The Absolute loves you, True Soul. And serving Her, as you have, is the path "
"to true power."
msgstr "참된 영혼이여, 절대자께선 너를 사랑하신다. 네가 해 온 대로 계속 그분을 섬기면, 진정한 힘으로 이끌어주실 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Nightwarden Minthara
#. NodeID = cb3ffb2e-efb6-ada2-7455-be093acbebb6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_Drow_HasMet(1) = False
#.   Object:
#.      - DEN_AttackOnDen_State_Victorious(0) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_Drow_HasMet(1) = True
#. TagRule: DROWELF and FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:cb3ffb2e-efb6-ada2-7455-be093acbebb6
msgctxt "hff008d6bg0b66g4ad0gbb1eg9302888a0e0c"
msgid ""
"Praise the Absolute, sister! She will reward us well for this exquisite "
"carnage."
msgstr "자매여, 절대자님을 찬양하라! 그분께서 이 아름다운 학살에 대해 후한 상을 내리실 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Nightwarden Minthara
#. NodeID = cb3ffb2e-efb6-ada2-7455-be093acbebb6
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_Drow_HasMet(1) = False
#.   Object:
#.      - DEN_AttackOnDen_State_Victorious(0) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_Drow_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:cb3ffb2e-efb6-ada2-7455-be093acbebb6
msgctxt "h4af495ecg9f54g456ag8b6bge51d23c4a1c8"
msgid ""
"Praise the Absolute! She will reward us well for this exquisite carnage."
msgstr "절대자님을 찬양하라! 그분께서 이 아름다운 학살에 대해 후한 상을 내리실 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Astarion
#. NodeID = cbc2c1a3-4435-e7c4-7687-0e23503a7585
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:cbc2c1a3-4435-e7c4-7687-0e23503a7585
msgctxt "h536adcbdgaae4g4791gb6f2gf3955cf72aca"
msgid "Please, it's no challenge. Just a friendly little murder between chums."
msgstr "좋을 대로. 도전도 아니지. 그냥 친구들끼리 친근하게 하는 사소한 살인 정도니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Karlach
#. NodeID = ce4be96f-f745-5cad-4036-b8c1ea726b4c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:ce4be96f-f745-5cad-4036-b8c1ea726b4c
msgctxt "heefe2fdbgca2cg4435gbbeagfaa965447984"
msgid "Are we planning to kill <i>everyone</i> we meet?"
msgstr "만나는 <i>사람마다</i> 죽여버릴 계획인가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Player
#. NodeID = d331d528-6658-8f0d-d41d-8541c443eb9a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:d331d528-6658-8f0d-d41d-8541c443eb9a
msgctxt "h5dffb570gef71g458bg81eagf4d3276c744a"
msgid "Glad to have helped - I made sure they were ready to fall."
msgstr "도와줘서 기쁘군. 나는 그들이 언제든지 무너질 것이라 확신했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Nightwarden Minthara
#. NodeID = d3a010ca-cb38-ad7b-061b-0122846eae3e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:d3a010ca-cb38-ad7b-061b-0122846eae3e
msgctxt "h970c8cccgfdb1g49d9g894bg5ffac9bf9675"
msgid "You are almost worthy to live among drow, <i>faerie</i>."
msgstr "넌 드로우와 함께 살 자격이 있을 정도다. <i>페어리</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Player
#. NodeID = d84e8659-fd1d-e4f2-bbae-df7828138a85
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LOLTHDROWELF(1) = True
#.      - LOLTHDROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:d84e8659-fd1d-e4f2-bbae-df7828138a85
msgctxt "h613aec11g28a0g4326gba3cgcb4331031414"
msgid ""
"You rejected the Queen of Spiders for this Absolute - I will slay you in "
"Lolth's name."
msgstr "절대자를 섬긴답시고 거미 여왕님을 거부하다니. 롤쓰님의 이름으로 널 처단하겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Nightwarden Minthara
#. NodeID = dced0129-f671-a434-22ab-bb093f2a4d6c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_AttackOnDen_Event_GoblinPartyInvitation = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:dced0129-f671-a434-22ab-bb093f2a4d6c
msgctxt "hd01ac919g2da3g498egb0b4ge2abdd864807"
msgid ""
"I will come to your camp tonight. We will celebrate this victory. Together."
msgstr "오늘 밤 너의 야영지에 방문하겠다. 우린 축배를 들 것이다. 함께 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Nightwarden Minthara
#. NodeID = ddb299e8-b995-d8ed-43b0-486a07fb05f7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:ddb299e8-b995-d8ed-43b0-486a07fb05f7
msgctxt "h4099a25dg1b5ag475agbd9cg028afa451f9f"
msgid "Look at me."
msgstr "날 보아라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Nightwarden Minthara
#. NodeID = df271d2a-fd98-cbf0-7143-3e7d95adeccf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:df271d2a-fd98-cbf0-7143-3e7d95adeccf
msgctxt "h850f9d46gd9a3g4e26gb405ga9420f8b0aae"
msgid ""
"We will discuss the matter later. First, we lay waste to this forsaken grove."
msgstr "이 일은 나중에 얘기하도록 하지. 우선은 이 버려진 숲을 완전히 파멸시킨다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Nightwarden Minthara
#. NodeID = e3ad91ef-4222-0c7c-cbed-82a4818b574b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(2) = True
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:e3ad91ef-4222-0c7c-cbed-82a4818b574b
msgctxt "h91bd8a74g7272g4782gb4c4g6523a82fb0dc"
msgid "You dare to challenge me?"
msgstr "감히 내게 도전하는 것이냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Player
#. NodeID = ead8ebe4-8d42-e3e2-aeb8-890d3640a56d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:ead8ebe4-8d42-e3e2-aeb8-890d3640a56d
msgctxt "h524170a4gbc31g4093gbc04gc05733aacf2f"
msgid "What a lovely afternoon! A real pleasure!"
msgstr "참 산뜻한 날이야! 정말 기분이 좋네!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Player
#. NodeID = eb9874e9-9e4d-3207-44a0-87d7a28f923b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Absolute_Knows_MoonriseTowers = True
#.      - GOB_DrowCommander_Quest_AskedAboutPassage = False
#.   Local:
#.      - a759296c-5d41-f5b9-7d31-1c70d1e10dc7_MentionedNere = False
#. SetFlags:
#.   Global:
#.     - GOB_DrowCommander_Quest_AskedAboutPassage = True
#.   Local:
#.     - a759296c-5d41-f5b9-7d31-1c70d1e10dc7_MentionedNere = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:eb9874e9-9e4d-3207-44a0-87d7a28f923b
msgctxt "hc7ebf457gb2c2g47a4gb4fcgf6f5a409e7ff"
msgid ""
"I will. But first, tell me how to reach Moonrise, so I can report there when "
"the battle is done."
msgstr "물론이지. 하지만 우선 문라이즈 타워로 가는 길을 알려줘. 전투가 끝나면 가서 보고할 수 있도록 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Nightwarden Minthara
#. NodeID = ebdb3d5e-6d67-f9cb-6cb3-220991f5c600
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:ebdb3d5e-6d67-f9cb-6cb3-220991f5c600
msgctxt "h9159f8bagd69fg462fg8aabgac0797b1d877"
msgid "You are most eager, True Soul. All will be revealed come dawn."
msgstr "너는 정말 간절하구나, 참된 영혼이여. 새벽이 오면 모든 것이 드러날 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Player
#. NodeID = ecd1f064-390d-e236-638b-447e7116298e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_DrowCommander_Knows_SentByNere = False
#.      - UND_TheDrowNere_Quest_SentToMinthara = True
#. SetFlags:
#.   Global:
#.     - GLO_DrowCommander_Knows_SentByNere = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:ecd1f064-390d-e236-638b-447e7116298e
msgctxt "ha37209b2g7a6fg4e40g9c2egaefc30d524dd"
msgid ""
"I met True Soul Nere in the Underdark. He warned me against working with you."
msgstr "언더다크에서 참된 영혼인 니어를 만났어. 너와 협력하지 말라고 경고하더군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Nightwarden Minthara
#. NodeID = effc32ff-d0a8-be33-0545-d1728fef7149
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DruidsAreDefeated = False
#.   Local:
#.      - a759296c-5d41-f5b9-7d31-1c70d1e10dc7_Once = True
#.   Object:
#.      - DEN_AttackOnDen_State_Victorious(0) = True
#. SetFlags:
#.   Quest:
#.     - DEN_Conflict_SUB_AoD.OrderedKillDruids(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:effc32ff-d0a8-be33-0545-d1728fef7149
msgctxt "h95e67b04g1d2bg4f48g8e17g33092db8db16"
msgid "Find the druids. Bleed them dry."
msgstr "드루이드들을 찾아라. 피가 메마를 때까지 베어라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Player
#. NodeID = f0057d5c-78d3-1311-0c43-afe0d2538296
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:f0057d5c-78d3-1311-0c43-afe0d2538296
msgctxt "ha02be76eg0d0cg4b59g98f6g3c8580c96551"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Narrator
#. NodeID = f2a7242c-cda1-f2b9-6774-6a8a0c4c0cf2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_AttackOnDen_Drow_AcceptedSeduction = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:f2a7242c-cda1-f2b9-6774-6a8a0c4c0cf2
msgctxt "hd42d68dcgad21g4255gb051g63777b0f8bcb"
msgid ""
"*You feel her breath on your neck, her fingers running down your spine, and "
"then... it is over.*"
msgstr "*당신의 목에 그녀의 숨결이 느껴지고, 그녀의 손가락이 당신의 척추를 타고 내려가더니... 끝입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Player
#. NodeID = f30c8994-cdfb-b576-5de2-92bea138dd52
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Absolute_Knows_MoonriseTowers = True
#.      - GOB_DrowCommander_Quest_AskedAboutPassage = False
#.   Local:
#.      - a759296c-5d41-f5b9-7d31-1c70d1e10dc7_MentionedNere = False
#. SetFlags:
#.   Global:
#.     - GOB_DrowCommander_Quest_AskedAboutPassage = True
#.   Local:
#.     - a759296c-5d41-f5b9-7d31-1c70d1e10dc7_MentionedNere = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:f30c8994-cdfb-b576-5de2-92bea138dd52
msgctxt "hc2560017g2ba5g478egb825g2dc0f37c891f"
msgid ""
"I'd prefer to set off for Moonrise than waste time celebrating. How do I "
"reach it?"
msgstr "축하하느라 시간을 낭비하느니 문라이즈 타워로 출발하겠어. 어떻게 가지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Nightwarden Minthara
#. NodeID = f5f9509f-b151-4212-a64f-956b495f23c4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:f5f9509f-b151-4212-a64f-956b495f23c4
msgctxt "hd9734d31g35c4g4ed3gb1a1gb56ac963f20c"
msgid ""
"The Absolute did not bring you here to assist me - She brought you here to "
"die."
msgstr "절대자는 나를 도우라고 널 보낸 게 아니야. 죽으라고 보낸 거지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Nightwarden Minthara
#. NodeID = f954bf1f-bfad-d51a-fe62-55ede4745068
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:f954bf1f-bfad-d51a-fe62-55ede4745068
msgctxt "h3c179a80g03c3g4785gaec9g5ce58fa3883d"
msgid ""
"Did he, now? Let me guess: the snivelling brat's failed his duty. Nothing if "
"not expected."
msgstr "그가 그렇게 말했나? 내가 맞춰보지: 그 투덜대는 애송이가 임무에 실패했겠군. 놀랄 일도 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow
#. Speaker = Nightwarden Minthara
#. NodeID = fb5e4057-9332-c305-6233-b5d92b77bdb9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Drow:fb5e4057-9332-c305-6233-b5d92b77bdb9
msgctxt "hc42888f8gcdd4g446dg9271gd8acaa3db7b1"
msgid "The Absolute knows your zeal. And She has so much more to give."
msgstr "절대자님은 너의 열의를 알고 계신다. 게다가 그분은 더 많은 힘을 주실 수 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidGuard001
#. Speaker = Jeorna
#. NodeID = 1079eee8-0dd3-3e9b-e14c-e9f0ec399e1f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_DruidGuard001(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidGuard001:1079eee8-0dd3-3e9b-e14c-e9f0ec399e1f
msgctxt "heffba895g5f8bg4633g8aa5g090096ef15d8"
msgid ""
"I wasn't sure about you at first. Thought you might be trouble. I was very "
"wrong."
msgstr "처음엔 당신에 대한 확신이 없었어. 문제를 일으킬 거라고 생각했지. 하지만 완전히 틀렸군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidGuard001
#. Speaker = Jeorna
#. NodeID = 401bc765-ec5e-4a13-4bd8-e526a1d2881c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_DruidGuard001(1) = True
#.   Global:
#.      - DEN_TieflingRefugees_State_LeftDen = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidGuard001:401bc765-ec5e-4a13-4bd8-e526a1d2881c
msgctxt "h321a93aeg60b2g40e4g87acg3cef25b18e0d"
msgid "Peace in the Grove once again. It's been too long."
msgstr "마침내 숲에 평화가 돌아왔구나. 오랜 기다림이었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidGuard001
#. Speaker = Jeorna
#. NodeID = 46475ac1-351c-d876-06ba-8cb703da9974
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_DruidGuard001(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidGuard001:46475ac1-351c-d876-06ba-8cb703da9974
msgctxt "hc840371ag38dbg4686g920dg336c972ffa46"
msgid "Safe travels. Wherever they may take you."
msgstr "당신이 어디를 향하든, 안전한 여정이 되기를."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidGuard001
#. Speaker = Jeorna
#. NodeID = 695647d6-89d8-9450-5c21-342e7b1307e2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingRefugees_State_LeftDen = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_DruidGuard001(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidGuard001:695647d6-89d8-9450-5c21-342e7b1307e2
msgctxt "hba7fb33bg6363g4fb1gadf6gdb1b59faba44"
msgid ""
"The tieflings have moved on. We can restore the harmony of the Grove now."
msgstr "티플링들이 떠났어요. 이제 숲의 조화를 회복할 수 있겠네요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidGuard002
#. Speaker = Maggran
#. NodeID = 3cfc367f-2eb6-f900-09a7-b4b71176ac35
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_DruidGuard002(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidGuard002:3cfc367f-2eb6-f900-09a7-b4b71176ac35
msgctxt "h2328586fg4fe6g42b5ga19fg652fe215cc82"
msgid "His blessings - our blessings - to thank you."
msgstr "그분의 축복과 - 우리의 축복으로써 - 감사드립니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidGuard002
#. Speaker = Maggran
#. NodeID = 596902d2-5313-b850-5e1b-42204aafbc66
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_DruidGuard002(1) = True
#.   Global:
#.      - DEN_TieflingRefugees_State_LeftDen = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidGuard002:596902d2-5313-b850-5e1b-42204aafbc66
msgctxt "h6dc4beeagc59dg4d35g859cg788b77971260"
msgid "They could have cleared up after themselves before they left..."
msgstr "떠나기 전에 정리 좀 하고 가지..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidGuard002
#. Speaker = Maggran
#. NodeID = 9df9df7f-67d2-848f-dd5b-50424353674c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingRefugees_State_LeftDen = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_DruidGuard002(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidGuard002:9df9df7f-67d2-848f-dd5b-50424353674c
msgctxt "h309f36c5g83ccg47a6g8526gb39602ba6fd3"
msgid "Our 'guests' are finally gone. I thought they'd never leave."
msgstr "우리의 '손님들'이 드디어 갔어. 영영 안 떠나는 줄 알았잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidGuard002
#. Speaker = Maggran
#. NodeID = e7629f8c-4a5a-7057-1123-0d034bfe84dd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_DruidGuard002(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidGuard002:e7629f8c-4a5a-7057-1123-0d034bfe84dd
msgctxt "h9828fd0cg573dg474bgb277gf5b966e3d2d7"
msgid ""
"His leaves to shade you. His branches to point your path. His shelter to "
"protect you. <i>Thank you.</i>"
msgstr "그분의 잎사귀가 가려주고, 나뭇가지가 길을 인도하며, 쉼터는 당신을 보호해 줄 겁니다. <i>감사드립니다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidGuard003
#. Speaker = Mino
#. NodeID = 0e945ed4-20f8-1a56-ea5d-c55bde7a73a8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_DruidGuard003(1) = True
#.   Global:
#.      - DEN_TieflingRefugees_State_LeftDen = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidGuard003:0e945ed4-20f8-1a56-ea5d-c55bde7a73a8
msgctxt "h189ecb8dg602bg45b2gaebbg0ec0b5bea64a"
msgid "Some normalcy can return to the Grove. At last."
msgstr "숲이 정상으로 돌아갈 수 있겠어. 마침내."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidGuard003
#. Speaker = Mino
#. NodeID = 13cd8d1c-e8d7-8670-c8be-522b7a7c76bd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Refugees_State_LeadersAreDead = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_DruidGuard003(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidGuard003:13cd8d1c-e8d7-8670-c8be-522b7a7c76bd
msgctxt "h09599ea4g09f6g416egb10cg096d5daa2142"
msgid ""
"I hear the goblins' leaders met their ends. Unfortunate for them, but very "
"fortunate for the Grove."
msgstr "고블린 지도자들이 죽음을 맞이했다면서요. 그들에겐 안타까운 일이지만, 숲에겐 잘된 일이죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidGuard003
#. Speaker = Mino
#. NodeID = 14d6ce20-4a6c-cc81-ce1c-b73a73dbda74
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_DruidGuard003(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidGuard003:14d6ce20-4a6c-cc81-ce1c-b73a73dbda74
msgctxt "h3d3cba16gf16dg449fg8766g80e154eb38f2"
msgid "Goblins at our gates. In our <i>home.</i> Silvanus' mercy..."
msgstr "고블린들이 입구까지 쳐들어 오다니? 우리의 <i>보금자리</i>까지? 실바누스님 자비를.."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidGuard003
#. Speaker = Mino
#. NodeID = 9b64dd7d-c749-e01d-1820-777803a61357
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_DruidGuard003(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidGuard003:9b64dd7d-c749-e01d-1820-777803a61357
msgctxt "hd4935522g3a6fg4451g846cg38fe40ce6823"
msgid ""
"Those goblins ought never to have found us. They never <i>would </i>have, if "
"we'd been properly secluded."
msgstr "고블린들이 우릴 찾을 수 없어야 했어. <i>절대</i> 못 찾았을 거라고, 숲이 제대로 폐쇄되었기만 했다면."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidGuard003
#. Speaker = Mino
#. NodeID = a31a36f8-7b75-0361-6b1c-ee4e70dae493
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingRefugees_State_LeftDen = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_DruidGuard003(1) = True
#. TagRule: TIEFLING
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidGuard003:a31a36f8-7b75-0361-6b1c-ee4e70dae493
msgctxt "h5c1cc94agaaa5g4866gbd53g8e27ef154f86"
msgid "The other tieflings have finally left. Perhaps you will join them?"
msgstr "드디어 다른 티플링들도 떠났군. 당신도 같이 갑니까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidGuard003
#. Speaker = Mino
#. NodeID = a31a36f8-7b75-0361-6b1c-ee4e70dae493
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingRefugees_State_LeftDen = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_DruidGuard003(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidGuard003:a31a36f8-7b75-0361-6b1c-ee4e70dae493
msgctxt "hd6711921g5142g4d0agb977gd05b1f7ded53"
msgid ""
"The tieflings have gone - good. I wish them well, but they crowded us for "
"far too long."
msgstr "티플링들이 떠났군. 좋아. 잘들 지내길 바라지만, 그 놈들은 여기서 너무 오래 뭉개고 있었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidGuard003
#. Speaker = Mino
#. NodeID = fa3758e4-613a-201a-f5c2-4a667494ca0e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_DruidGuard003(1) = True
#.   Global:
#.      - DEN_Refugees_State_LeadersAreDead = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidGuard003:fa3758e4-613a-201a-f5c2-4a667494ca0e
msgctxt "hb8bd2b03g5283g4faega0ceg814a730dca6a"
msgid ""
"Without leaders, those goblins present little threat to the Grove. Silvanus "
"has blessed us."
msgstr "지도자가 없으면, 저 고블린들은 숲에 별 위협이 되지 못하지. 실바누스께서 굽어살펴 주셨구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidLeader
#. Speaker = Kagha
#. NodeID = 08d5a709-26d6-ba9d-4a82-e1767ce954fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidLeader:08d5a709-26d6-ba9d-4a82-e1767ce954fd
msgctxt "h065db386gdae5g4884g89fcgd641d3ecd83b"
msgid "I've cancelled the rite. The circle must heal."
msgstr "의식은 중단시켰다. 회합은 치유되어야 한다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidLeader
#. Speaker = Player
#. NodeID = 0a66e20a-72c2-2025-da72-9213776165f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidLeader:0a66e20a-72c2-2025-da72-9213776165f5
msgctxt "hc72fc4beg3a25g4a60g8529g65f50d4d9ce0"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidLeader
#. Speaker = Kagha
#. NodeID = 10e0efeb-73fa-ff3d-13e2-2c5f1a905c61
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidLeader:10e0efeb-73fa-ff3d-13e2-2c5f1a905c61
msgctxt "hdba9b7d8g7f79g4baag9ea7g655a288289ce"
msgid ""
"Halsin's cancelled the rite. The brood is exposed. And we've <i>you</i> to "
"thank, Silvanus have pity."
msgstr "할신께서 의식을 중단시켰고 우린 무방비로 노출되었다. 모두 <i>네</i> 덕분이지. 실바누스여 불쌍히 여기소서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidLeader
#. Speaker = Player
#. NodeID = 2ec9fdba-4383-d176-2270-ae880b6b8c1a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidLeader:2ec9fdba-4383-d176-2270-ae880b6b8c1a
msgctxt "h1f26929fg74e0g4c3cga349g707f13cf8319"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidLeader
#. Speaker = Player
#. NodeID = 3a9d530c-1a72-ed5f-4420-17500e06dbec
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_Knows_RecruitmentLetter = True
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = False
#.   Local:
#.      - 45b7358d-da8a-1025-a143-c55add01c608_ConfrontedKagha = False
#. SetFlags:
#.   Local:
#.     - 45b7358d-da8a-1025-a143-c55add01c608_ConfrontedKagha = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidLeader:3a9d530c-1a72-ed5f-4420-17500e06dbec
msgctxt "h2496f5cag61fdg45b1g967bg76166c9de154"
msgid "Enough of the act. I've learned of your alliance with Shadow Druids."
msgstr "연기는 집어치워. 네가 그림자 드루이드와 결탁한 것을 알아냈다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidLeader
#. Speaker = Kagha
#. NodeID = 44c12f07-3ec1-fb4a-2d39-3403fa4d2d6c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDenDruidLeader_State_HasMet(1) = True
#.   Global:
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidLeader:44c12f07-3ec1-fb4a-2d39-3403fa4d2d6c
msgctxt "h77a65e24g92efg4484g9212gc89a88e7d1e6"
msgid "Safe. For now."
msgstr "안전해. 당장은."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidLeader
#. Speaker = Kagha
#. NodeID = 4b74fcf2-5d56-2890-ebfd-f8c520138320
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidLeader:4b74fcf2-5d56-2890-ebfd-f8c520138320
msgctxt "h54d39006g43fcg4d1dg9f20g36b1180f89b2"
msgid "Have you now? And you thought you should <i>tell</i> me?"
msgstr "이제 알아내셨어? 그리고 나한테 <i>말해 줘야겠다</i>고 생각한 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidLeader
#. Speaker = Kagha
#. NodeID = 4ea01268-5203-7c70-6082-2ae28edf6ac4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDenDruidLeader_State_HasMet(1) = True
#.   Global:
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidLeader:4ea01268-5203-7c70-6082-2ae28edf6ac4
msgctxt "h429458e4g758fg437dgb3aag0179c7e875ba"
msgid "Safe. For now."
msgstr "안전해. 당장은."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidLeader
#. Speaker = Kagha
#. NodeID = 67f84221-4668-385f-2a35-e5bf446ade47
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_State_Returned = True
#.      - GLO_Halsin_State_PermaDefeated = True
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = False
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDenDruidLeader_State_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidLeader:67f84221-4668-385f-2a35-e5bf446ade47
msgctxt "h5a11e74fg523bg468bgb578gaa3fe57ffa1f"
msgid "This is only the beginning. An army soon crosses the coast."
msgstr "이건 시작에 불과해. 곧 군대가 해안을 가로지를 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidLeader
#. Speaker = Kagha
#. NodeID = 7040a52b-9034-81d7-92d0-8edad994e9bd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidLeader:7040a52b-9034-81d7-92d0-8edad994e9bd
msgctxt "h392bf72dg0066g43bcgba25g120cd03a0b7e"
msgid ""
"With Halsin back, at least the grove might stand a chance. And we've you to "
"thank."
msgstr "할신이 돌아왔으니, 아직 숲에 기회는 남아있겠어. 당신들에겐 감사해야겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidLeader
#. Speaker = Kagha
#. NodeID = 79b52ce9-4682-7e7d-2d69-b217be5db367
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidLeader:79b52ce9-4682-7e7d-2d69-b217be5db367
msgctxt "h1072f36fg9c70g46f7ga508g39049127808e"
msgid ""
"If only Halsin were still here to guide us. Silvanus willing, we might heal "
"without him."
msgstr "지금 할신이 우릴 이끌 수 있었더라면 좋았을 텐데. 그래도, 실바누스께서 도와주신다면, 그 없이도 치유 할 수 있을 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidLeader
#. Speaker = Kagha
#. NodeID = 967e1493-3874-0564-f8e1-bde1f9d6ffae
#. HandlePath = TaggedText[0].TagText[0]
