msgctxt "h3ae430c2g9ebfg4a48gbb95g420c25b4da08"
msgid "*The corpse regards you lifelessly.*"
msgstr "*시체가 생기 없는 모습으로 당신을 맞이합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_Derryth_Dead
#. Speaker = Player
#. NodeID = c5485fa8-2324-4e5e-9d6b-d06aa5ba3aac
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 09983dce-d7d0-c108-506f-dcadc4044b0a_Derryth_SwD_Who = False
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Local:
#.     - 09983dce-d7d0-c108-506f-dcadc4044b0a_Derryth_SwD_Who = True
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_Derryth_Dead:c5485fa8-2324-4e5e-9d6b-d06aa5ba3aac
msgctxt "hb9c11fd5g67ecg4bd0g8fe5g4c31c85a3a29"
msgid "Who are you?"
msgstr "너는 누구지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_Derryth_Dead
#. Speaker = Player
#. NodeID = c5552ecf-631b-a257-d480-3fadb0811f15
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_MushroomHunter_HasMet(1) = True
#.   Global:
#.      - UND_MushroomHunter_Knows_Missing = True
#.      - UND_MushroomHunter_State_Saved = False
#.   Local:
#.      - 09983dce-d7d0-c108-506f-dcadc4044b0a_Derryth_SwD_BaelenInDanger = False
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Local:
#.     - 09983dce-d7d0-c108-506f-dcadc4044b0a_Derryth_SwD_BaelenInDanger = True
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_Derryth_Dead:c5552ecf-631b-a257-d480-3fadb0811f15
msgctxt "h295fd8b5ge676g48cdgbd69g488d810c21cf"
msgid "Baelen's in danger. How do I help?"
msgstr "베일렌이 위험에 처했어요. 어떻게 도울 수 있을까요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_Derryth_Dead
#. Speaker = Derryth Bonecloak
#. NodeID = c8240c30-e97b-4ba9-ae5c-665e892ccf4b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_Derryth_Dead:c8240c30-e97b-4ba9-ae5c-665e892ccf4b
msgctxt "h14ccf299g83b6g4dc1gb163g4b2445a3a9c9"
msgid "Don't know. Pain... then darkness..."
msgstr "몰라. 아프더니... 어둠만이..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_Derryth_Dead
#. Speaker = Player
#. NodeID = cbbb4f5e-64c4-ea66-a485-e9e95993252c
