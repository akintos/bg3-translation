msgctxt "h58667cf0gee36g4756g91fbg883476d52b45"
msgid "Has this place escaped my people's notice all this time? Embarrassing."
msgstr "여태껏 이곳이 내 동족이 알아채지 못하고 숨겨져 있었던 거야? 당황스럽군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_EnterGauntlet
#. Speaker = Player
#. NodeID = 4e4c2399-c0c7-4ea3-8ea9-f6059261e55a
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_EnterGauntlet:4e4c2399-c0c7-4ea3-8ea9-f6059261e55a
msgctxt "h290eadbdg7307g4cf9ga4d1g67dbb77a68e4"
msgid "Looks untouched. Quite something, to have escaped notice all this time."
msgstr "한 번도 손댄 적 없어 보여. 이렇게 오랜 시간 동안 눈치채지 못하게 했다니, 대단한걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_EnterGauntlet
#. Speaker = Player
#. NodeID = 4e4c2399-c0c7-4ea3-8ea9-f6059261e55a
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_EnterGauntlet:4e4c2399-c0c7-4ea3-8ea9-f6059261e55a
msgctxt "h8dcab8dag1631g4a83ga9c2g6bc07a157915"
msgid "Incredible. Do the githyanki know of this place?"
msgstr "놀라운걸. 기스양키들이 이곳을 알고 있을까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_EnterGauntlet
#. Speaker = Player
#. NodeID = 4e4c2399-c0c7-4ea3-8ea9-f6059261e55a
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_EnterGauntlet:4e4c2399-c0c7-4ea3-8ea9-f6059261e55a
msgctxt "h90775fc8gb13bg4cb9gb397gd1a152e0e815"
msgid "Remarkable that this stayed hidden all this time."
msgstr "이게 얼마나 오랫동안 숨겨져 있었는지 놀랍군."

