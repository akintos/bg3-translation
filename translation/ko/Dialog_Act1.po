#. SetFlags:
#.   Local:
#.     - 6fa2b72d-fde1-4ee3-e1d1-f184232f693d_C = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid2:d5ae9d15-02d8-3a5d-dd71-641cb8ea0c93
msgctxt "h7e36b2c6g1768g498bgbe83g4612434783cf"
msgid "Trust in the Treefather. He'll bring us balance."
msgstr "나무 아버지를 믿어라. 우리에게 균형을 가져다 주실 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid2
#. Speaker = Karrik
#. NodeID = f627a572-62a1-5bca-9d23-2f3093998ee3
