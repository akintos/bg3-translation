msgctxt "hfcb4f508g32c9g483fg9facge7f812705c2f"
msgid "Halt. One step further and I end your primitive existence."
msgstr "멈춰라. 한 발짝만 더 다가오면 너의 미개한 삶을 끝내 주겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointWarning
#. Speaker = Warrior Khunaruth
#. NodeID = eba71f00-0f23-b106-567e-53d766cf1f93
