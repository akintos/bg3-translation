msgctxt "h7ceeb726g392fg41fag82c4gb762ad3943db"
msgid "Hurry, the grove needs us!"
msgstr "서둘러, 숲에서 우릴 필요로 하고있어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_DruidGuard1
#. Speaker = Jeorna
#. NodeID = 297d5be3-ed1d-108f-a7b0-8a27ee9b6b02
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 47511dbb-8940-d871-bc7f-3238ecbf05da_a = False
#.   Object:
#.      - DEN_DruidAttack_State_InPosition(0) = True
#. SetFlags:
#.   Local:
#.     - 47511dbb-8940-d871-bc7f-3238ecbf05da_a = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_DruidGuard1:297d5be3-ed1d-108f-a7b0-8a27ee9b6b02
msgctxt "h14fbf4bdg3097g434eg9ef6g46ad01a5a785"
msgid "Purge the outsiders! Take back our grove!"
msgstr "외부인들을 없애 버려! 우리 숲을 되찾자!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_DruidGuard1
#. Speaker = Jeorna
#. NodeID = 2fc9154d-d68e-e7e9-9bf1-1eeb179a6ea0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_Attacking = True
#.   Local:
#.      - 47511dbb-8940-d871-bc7f-3238ecbf05da_b = False
#.      - 47511dbb-8940-d871-bc7f-3238ecbf05da_a = False
#. SetFlags:
#.   Local:
#.     - 47511dbb-8940-d871-bc7f-3238ecbf05da_b = True
#.     - 47511dbb-8940-d871-bc7f-3238ecbf05da_a = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_DruidGuard1:2fc9154d-d68e-e7e9-9bf1-1eeb179a6ea0
msgctxt "h4c7524dagfd3cg41ebgbc46g4cd2482f06f4"
msgid "Kagha wills it! Silvanus wills it!"
msgstr "카그하의 의지다! 실바누스님의 의지다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_DruidGuard1
#. Speaker = Jeorna
#. NodeID = 4d61ae56-157e-b11f-ac3d-5668b7958c8e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_Attacking = True
#.   Local:
#.      - 47511dbb-8940-d871-bc7f-3238ecbf05da_a = False
#. SetFlags:
#.   Local:
#.     - 47511dbb-8940-d871-bc7f-3238ecbf05da_a = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_DruidGuard1:4d61ae56-157e-b11f-ac3d-5668b7958c8e
msgctxt "hddb62929gedceg4966gbb3cg2b3d6b2bba2e"
msgid "For the grove!"
msgstr "숲을 위하여!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_DruidGuard1
#. Speaker = Jeorna
#. NodeID = 56bed069-06b2-5a91-1d3d-6c297a499a7a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 47511dbb-8940-d871-bc7f-3238ecbf05da_b = True
#.      - 47511dbb-8940-d871-bc7f-3238ecbf05da_a = True
#.   Object:
#.      - DEN_DruidAttack_State_InPosition(0) = True
#. SetFlags:
#.   Local:
#.     - 47511dbb-8940-d871-bc7f-3238ecbf05da_b = False
#.     - 47511dbb-8940-d871-bc7f-3238ecbf05da_a = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_DruidGuard1:56bed069-06b2-5a91-1d3d-6c297a499a7a
msgctxt "h491af9f9gbeacg4a01g8f73gf1e5551da234"
msgid "No mercy - they had their chance!"
msgstr "자비를 보이지 마라. 저들의 기회는 지났어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_DruidGuard1
#. Speaker = Jeorna
#. NodeID = 8217f007-4762-f551-4a77-e8ebd022414f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 47511dbb-8940-d871-bc7f-3238ecbf05da_b = False
#.      - 47511dbb-8940-d871-bc7f-3238ecbf05da_a = True
#.   Object:
#.      - DEN_DruidAttack_State_InPosition(0) = False
#. SetFlags:
#.   Local:
#.     - 47511dbb-8940-d871-bc7f-3238ecbf05da_b = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_DruidGuard1:8217f007-4762-f551-4a77-e8ebd022414f
msgctxt "h7c6f5d46g0effg423fg8c77g8862234a9024"
msgid "Keep going - find the outsiders!"
msgstr "계속 움직여. 외부인들을 찾아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_DruidGuard1
#. Speaker = Jeorna
#. NodeID = 8de18765-c8ae-451c-5793-93b4ef3fca3d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 47511dbb-8940-d871-bc7f-3238ecbf05da_a = False
#.   Object:
#.      - DEN_DruidAttack_State_InPosition(0) = False
#. SetFlags:
#.   Local:
#.     - 47511dbb-8940-d871-bc7f-3238ecbf05da_a = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_DruidGuard1:8de18765-c8ae-451c-5793-93b4ef3fca3d
msgctxt "h25b7eb35gc759g4f4dgb79agba6da21bee66"
msgid "Keep moving - clear every corner!"
msgstr "계속 움직여 - 구석 구석 다 확보해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_DruidGuard1
#. Speaker = Jeorna
#. NodeID = dc6055e0-c725-6adf-0e72-b1a21988d342
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_Attacking = True
#.   Local:
#.      - 47511dbb-8940-d871-bc7f-3238ecbf05da_b = False
#.      - 47511dbb-8940-d871-bc7f-3238ecbf05da_a = True
#. SetFlags:
#.   Local:
#.     - 47511dbb-8940-d871-bc7f-3238ecbf05da_b = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_DruidGuard1:dc6055e0-c725-6adf-0e72-b1a21988d342
msgctxt "hdcaf5341gd6b1g4951g9c76gd56320b9e41d"
msgid "Spare no one - cleanse the grove!"
msgstr "한 놈도 살려두지 마라. 숲을 정화해라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_DruidGuard1
#. Speaker = Jeorna
#. NodeID = e307148f-3627-a59f-b59d-58ba539989b2
