msgctxt "h9b750d9bg5491g45fdga542gfbba0f43fe9c"
msgid "Well that told me nothing."
msgstr "글쎄, 알 수 있는 게 없군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HarperSpy_PAD_RecogniseWatchword
#. Speaker = Player
#. NodeID = d3f783fa-f8fa-4a3a-b88b-094f13e9f971
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HarperSpy_PAD_RecogniseWatchword:d3f783fa-f8fa-4a3a-b88b-094f13e9f971
msgctxt "h164ca061gcec4g40bdg8f00ga333ca6aa48a"
msgid "Hells. That's no help at all."
msgstr "젠장, 전혀 도움이 안 되잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HarperSpy_PAD_RecogniseWatchword
#. Speaker = Player
#. NodeID = d3f783fa-f8fa-4a3a-b88b-094f13e9f971
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HarperSpy_PAD_RecogniseWatchword:d3f783fa-f8fa-4a3a-b88b-094f13e9f971
msgctxt "hc463ec58g889cg4959g8a3bg25b98c55adf6"
msgid "But what does it mean?"
msgstr "하지만 무슨 뜻일까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HiddenStash_PAD
#. Speaker = Player
#. NodeID = c193be45-f5c5-4a40-8c7b-4cd123c5444f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_HiddenStash_PerceptionPassed = True
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HiddenStash_PAD:c193be45-f5c5-4a40-8c7b-4cd123c5444f
msgctxt "h77450f8cg82a6g4168g80eegd2b545acde95"
msgid "Well well, a loose stone. What are you hiding?"
msgstr "이것 봐라, 느슨한 돌이네. 뭘 숨기고 있을까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HiddenStash_PAD
#. Speaker = Player
#. NodeID = c193be45-f5c5-4a40-8c7b-4cd123c5444f
