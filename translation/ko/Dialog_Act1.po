msgctxt "ha61fd13cg28f4g4734gb4d3g68dcd07dc87b"
msgid "Wouldn't <i>you </i>like to know?"
msgstr "알고 싶어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain
#. Speaker = Ra'jak
#. NodeID = 3d70d232-108b-17e3-6d70-ec58e8ced8dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain:3d70d232-108b-17e3-6d70-ec58e8ced8dc
msgctxt "h8b7e63fbgd719g4048g8df8gf6a2f4ca7e8d"
msgid "And we ignored you."
msgstr "그리고 우린 그걸 무시했고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain
#. Speaker = Zel'i
#. NodeID = 50519ece-2397-fcd3-5919-360ccaaae655
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet_MageHandMain(3) = True
