#. CheckFlags:
#.   Local:
#.      - 24124369-4e10-034f-351c-aff4c861ba26_AskedWhatsInChest = False
#.      - 24124369-4e10-034f-351c-aff4c861ba26_ToldToStopOnce = False
#. SetFlags:
#.   Local:
#.     - 24124369-4e10-034f-351c-aff4c861ba26_ToldToStopOnce = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain:cb395046-fa44-148b-c757-784e531e876e
msgctxt "h4a74afa0g6718g4e0fg8740gb03b1353d1a6"
msgid "You should stop doing that. It's not nice."
msgstr "그만 해. 좋지 않아보여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain
#. Speaker = Zel'i
#. NodeID = cdffbbb0-12cd-8e05-8c9c-1abed722babc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain:cdffbbb0-12cd-8e05-8c9c-1abed722babc
msgctxt "h33816619gc9cdg4749ga42fg3b9a0b98c328"
msgid "Where are you going? I thought you wanted to play?"
msgstr "어디 가? 같이 놀고 싶어하는 줄 알았는데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain
#. Speaker = Player
#. NodeID = d452cbc2-e6c6-b7bb-5d1d-20ccb7d3d960
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 24124369-4e10-034f-351c-aff4c861ba26_ToldToStopOnce = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain:d452cbc2-e6c6-b7bb-5d1d-20ccb7d3d960
msgctxt "h43b582c8g231eg432fgb230g634893131418"
msgid "I thought I told you to stop doing that?"
msgstr "멈추라고 했던 거 같은데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain
#. Speaker = Ra'jak
#. NodeID = d5c04ebd-2d6b-239b-7502-6e90b281b4ef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain:d5c04ebd-2d6b-239b-7502-6e90b281b4ef
msgctxt "h104605e9g1231g492agbfe0g17cccd2a5dfa"
msgid "Yeah. I'm <i>sooo </i>scared."
msgstr "맞아, 난 <i>너어어어무</i> 무서워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain
#. Speaker = Player
#. NodeID = da665fef-9f28-f0fc-7929-578d32af51cb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 24124369-4e10-034f-351c-aff4c861ba26_ToldToStopOnce = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain:da665fef-9f28-f0fc-7929-578d32af51cb
msgctxt "h3c74dd8fgf829g4cc9g8626g5358b97c231f"
msgid "That's enough. You need to stop."
msgstr "이거로 됐어. 멈춰."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain
#. Speaker = Ra'jak
#. NodeID = db5d6739-f2b9-0e21-52ea-ccb39b2f6385
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 24124369-4e10-034f-351c-aff4c861ba26_PlayerGotSlapped = True
#.   Object:
#.     - CRE_MageHandGame_Event_PlayerInterferesWithGame(3) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain:db5d6739-f2b9-0e21-52ea-ccb39b2f6385
msgctxt "h08a50c89g38a0g4cffg956cg40e8596fef45"
msgid "Yeah! Let's play!"
msgstr "좋아! 놀자!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain
#. Speaker = Zel'i
#. NodeID = e0d6de65-5b5f-47ee-7dcd-ba002aceebaf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain:e0d6de65-5b5f-47ee-7dcd-ba002aceebaf
msgctxt "h0579effdg1166g4726ga050g14cc05d86887"
msgid "What, you're going to beat us up? <i>Oooh</i> please don't hurt us."
msgstr "뭐라고, 우릴 때리기라도 하겠다고? <i>오...</i> 제발 그러지 마세요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain
#. Speaker = Player
#. NodeID = ed19475b-0b31-f655-8279-59304939f852
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CRE_MageHandGame_State_PlayerAskedToPlay(3) = False
#. SetFlags:
#.   Object:
#.     - CRE_MageHandGame_State_PlayerAskedToPlay(3) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain:ed19475b-0b31-f655-8279-59304939f852
msgctxt "hd41974c7g13dbg4e33ga3a0ga758f70ec741"
msgid "If you won't stop, then I want in. How do I play?"
msgstr "멈추지 않는다면, 나도 같이 할래. 어떻게 노는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain
#. Speaker = Player
#. NodeID = f3480e0e-7738-18fd-c71e-59894598dbfe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain:f3480e0e-7738-18fd-c71e-59894598dbfe
msgctxt "h391f0607gc2b4g4b10ga955gbd9d98b12d3e"
msgid "Whatever. I've got better things to do."
msgstr "뭐 난 상관 없어. 다른 할 일이 많아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain
#. Speaker = Zel'i
#. NodeID = fc738168-cb9a-e8b5-ec79-71854888e99f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain:fc738168-cb9a-e8b5-ec79-71854888e99f
msgctxt "hacda5ca4g4ce4g40d8g8c7fg1fd5fd4de32a"
msgid "<i>Hmmmmm</i>. No!"
msgstr "<i>흐으음</i>. 싫어!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain
#. Speaker = Zel'i
#. NodeID = ff3edfd5-eb61-0209-96d5-4809927d197f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain:ff3edfd5-eb61-0209-96d5-4809927d197f
msgctxt "hd67daad2g9a36g49e2g99e1g3356201c04ed"
msgid "<i>Fiiiiine. </i>If you're going to be a big baby about it."
msgstr "<i> 조오아.</i> 다 큰 애처럼 굴겠다면 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_DormitoryComment
#. Speaker = Player
#. NodeID = f2da75bd-d011-4f67-9dfa-9f487706bd4b
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_DormitoryComment:f2da75bd-d011-4f67-9dfa-9f487706bd4b
msgctxt "hf23a48b9gcd1cg4a53gafd2g2458b9a0ceed"
msgid ""
"I imagined the gith slept on slabs of stone and nails - not <i>beds</i>."
msgstr "난 기스들은 돌판에다 못 박아둔 거에서 잔다고 생각했어... <i>침대</i>가 아니라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_DormitoryComment
#. Speaker = Player
#. NodeID = f2da75bd-d011-4f67-9dfa-9f487706bd4b
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_DormitoryComment:f2da75bd-d011-4f67-9dfa-9f487706bd4b
msgctxt "h848471f3gfa60g4c7bgb28ega5952804a582"
msgid "This crèche's bunks look entirely too soft for my liking."
msgstr "여기 양성소 침대는 내 취향에는 너무 부드럽군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_DormitoryComment
#. Speaker = Player
#. NodeID = f2da75bd-d011-4f67-9dfa-9f487706bd4b
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_DormitoryComment:f2da75bd-d011-4f67-9dfa-9f487706bd4b
msgctxt "h36074fa7gea7dg41bbga677g77bf6cba5351"
msgid ""
"Not the comfiest of dormitories. The githyanki must consider sleep quite the "
"luxury."
msgstr "최고급 숙소는 아니네. 기스양키들은 수면을 귀중히 여길 필요가 있겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_DormitoryComment
#. Speaker = Player
#. NodeID = f2da75bd-d011-4f67-9dfa-9f487706bd4b
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_DormitoryComment:f2da75bd-d011-4f67-9dfa-9f487706bd4b
msgctxt "h26da0dbdg73d7g4b0egb06eg3e42cabf9d1c"
msgid ""
"Rather conventional beds, for githyanki. Do they cuddle plush red dragons, I "
"wonder?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_DormitoryComment
#. Speaker = Player
#. NodeID = f2da75bd-d011-4f67-9dfa-9f487706bd4b
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_DormitoryComment:f2da75bd-d011-4f67-9dfa-9f487706bd4b
msgctxt "h334a501cg8ef1g448eg98ffga60be2aa92ba"
msgid "Communal sleeping. I presume the githyanki don't value privacy."
msgstr "합숙이라. 기스양키들은 사생활을 중요히 여기지 않나 보군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_DormitoryComment
#. Speaker = Player
#. NodeID = f2da75bd-d011-4f67-9dfa-9f487706bd4b
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_DormitoryComment:f2da75bd-d011-4f67-9dfa-9f487706bd4b
msgctxt "h8a139379g0b5ag4326g9602g674618a5fa7b"
msgid "Glad the githyanki don't deny themselves <i>every </i>luxury."
msgstr "기스양키들이 <i>모든</i> 사치를 거부하는 건 아니라니 기쁜걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_DormitoryComment
#. Speaker = Player
#. NodeID = f2da75bd-d011-4f67-9dfa-9f487706bd4b
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_DormitoryComment:f2da75bd-d011-4f67-9dfa-9f487706bd4b
msgctxt "h6cf4ab90g8e8cg4601gb3eeg5758d0065e1c"
msgid ""
"Curious. I had not expected githyanki sleeping arrangements to be so... "
"conventional."
msgstr "흥미롭군. 기스양키의 수면 방식이 이렇게... 평범할 거라고 예상하지 못했는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_DormitoryComment
#. Speaker = Player
#. NodeID = f2da75bd-d011-4f67-9dfa-9f487706bd4b
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: REALLY_GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_DormitoryComment:f2da75bd-d011-4f67-9dfa-9f487706bd4b
msgctxt "h12ca205cgec1ag47f4g9905g52c7b8ae386e"
msgid "Those beds look harder than a brig hammock, and twice as full of bugs."
msgstr "이 침대들은 범선의 해먹보다 딱딱해 보이는 데다가, 두 배는 많은 벌레가 기어다니는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_DormitoryComment
#. Speaker = Player
#. NodeID = f2da75bd-d011-4f67-9dfa-9f487706bd4b
#. HandlePath = TaggedText[8].TagText[0]
#. TagRule: !REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_DormitoryComment:f2da75bd-d011-4f67-9dfa-9f487706bd4b
msgctxt "h3b282876g01edg42eegb78cgf529a38e7c3b"
msgid "So githyanki sleep in beds too. How conventional."
msgstr "기스양키들도 침대에서 자는구나. 진부해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_FoodComment
#. Speaker = Player
#. NodeID = b963f7ee-3b96-44cd-9c51-2b35f7e9ef0d
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_FoodComment:b963f7ee-3b96-44cd-9c51-2b35f7e9ef0d
msgctxt "he3e68d06g7cdag4b26g8854g019da2835c6d"
msgid "No banquets in sight with this pantry, that's for sure."
msgstr "확실히, 이 식당만 딱 봐도 만찬이라고 할 수는 없군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_FoodComment
#. Speaker = Player
#. NodeID = b963f7ee-3b96-44cd-9c51-2b35f7e9ef0d
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_FoodComment:b963f7ee-3b96-44cd-9c51-2b35f7e9ef0d
msgctxt "hc11507cbgdd1eg4c16g9daeg7d67b5c41438"
msgid ""
"Fruit? <i>Chk.</i> No githyanki of worth would prefer this to a fresh kill."
msgstr "과일? <i>츠크.</i> 훌륭한 기스양키라면 이거 말고 갓 잡은 고기를 원할텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_FoodComment
#. Speaker = Player
#. NodeID = b963f7ee-3b96-44cd-9c51-2b35f7e9ef0d
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_FoodComment:b963f7ee-3b96-44cd-9c51-2b35f7e9ef0d
msgctxt "h63e9b169g31e5g40b6g8e38g58f03689df18"
msgid "Apples? Not the bloodthirsty fare I expected to see in such a place."
msgstr "사과? 이런 장소에서 볼 법한 피에 굶주린 식사는 아닌데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_FoodComment
#. Speaker = Player
#. NodeID = b963f7ee-3b96-44cd-9c51-2b35f7e9ef0d
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_FoodComment:b963f7ee-3b96-44cd-9c51-2b35f7e9ef0d
msgctxt "hb9ce9d87gddd5g4e6ag9312g84cead93cdfc"
msgid "An apple a day keeps the tadpoles away. I wish..."
msgstr "하루에 사과 한 개는 올챙이를 막아주지, 였으면 좋겠네..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_FoodComment
#. Speaker = Player
#. NodeID = b963f7ee-3b96-44cd-9c51-2b35f7e9ef0d
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_FoodComment:b963f7ee-3b96-44cd-9c51-2b35f7e9ef0d
msgctxt "h5f43189dg143dg4e63g8814g154132bc096c"
msgid "I would've thought the githyanki prefer fresh meat to fruit."
msgstr "기스양키가 신선한 고기보다 과일을 선호할 거라고 생각해본 적이 없는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_FoodComment
#. Speaker = Player
#. NodeID = b963f7ee-3b96-44cd-9c51-2b35f7e9ef0d
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_FoodComment:b963f7ee-3b96-44cd-9c51-2b35f7e9ef0d
msgctxt "hb70e5acbg5190g4a87ga8f0g2116d6852606"
msgid "Yummy."
msgstr "맛있겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_FoodComment
#. Speaker = Player
#. NodeID = b963f7ee-3b96-44cd-9c51-2b35f7e9ef0d
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_FoodComment:b963f7ee-3b96-44cd-9c51-2b35f7e9ef0d
msgctxt "ha90ff98age88ag46c9gbb2fgbe98349904d0"
msgid "A warrior-in-training's diet."
msgstr "전사 훈련용 식단이군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_FoodComment
#. Speaker = Player
#. NodeID = b963f7ee-3b96-44cd-9c51-2b35f7e9ef0d
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: REALLY_GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_FoodComment:b963f7ee-3b96-44cd-9c51-2b35f7e9ef0d
msgctxt "h17c87fb3gb232g42b4g8a0bg4d37599e68dd"
msgid ""
"Eating is such a waste of time. Finding good food on this plane even more so."
msgstr "먹는 건 시간 낭비야. 이 차원에서 좋은 음식을 찾는 건 더욱 그렇고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_FoodComment
#. Speaker = Player
#. NodeID = b963f7ee-3b96-44cd-9c51-2b35f7e9ef0d
#. HandlePath = TaggedText[8].TagText[0]
#. TagRule: !REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_FoodComment:b963f7ee-3b96-44cd-9c51-2b35f7e9ef0d
msgctxt "he71cd1degcb2fg4370g8095ge91ec9e1f23c"
msgid "I always wondered what githyanki eat."
msgstr "난 항상 기스양키가 뭘 먹는지 궁금했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_PlayerSurprisedAtGremishka
#. Speaker = Player
#. NodeID = a732760c-1bbd-43b7-b65f-c4131b866639
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_PlayerSurprisedAtGremishka:a732760c-1bbd-43b7-b65f-c4131b866639
msgctxt "hc4165f5agb5b5g47ecgb8f3g1f352dc8acd7"
msgid "What in the hells -"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_PlayerSurprisedAtGremishka
#. Speaker = Player
#. NodeID = a732760c-1bbd-43b7-b65f-c4131b866639
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_PlayerSurprisedAtGremishka:a732760c-1bbd-43b7-b65f-c4131b866639
msgctxt "hbb04d577g98d7g4a97ga47dg7b0f936f9938"
msgid "Mystra's dimples! What's that?!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_PlayerSurprisedAtGremishka
#. Speaker = Player
#. NodeID = a732760c-1bbd-43b7-b65f-c4131b866639
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_PlayerSurprisedAtGremishka:a732760c-1bbd-43b7-b65f-c4131b866639
msgctxt "h74362866g6bccg4383g9993gc7c8ee98cddb"
msgid "Whoa gods!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_PlayerSurprisedAtGremishka
#. Speaker = Player
#. NodeID = a732760c-1bbd-43b7-b65f-c4131b866639
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
