#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HookHorror_Hermit_Dead:1de556a3-2079-4507-8aea-3233e2bc5831
msgctxt "h46e479cdg6b7ag4fceg8a37gc97df64c3d13"
msgid "Your notes mention a 'Guardian' - what is it?"
msgstr "쪽지에 '수호자'에 대한 언급이 있던데. 무슨 뜻이지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HookHorror_Hermit_Dead
#. Speaker = Player
#. NodeID = 1ef773b7-4829-1054-54b8-464e05c8b328
