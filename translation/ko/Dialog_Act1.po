#.     - UND_FurnaceSearch_Knows_XargrimSummonedSpectator = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_MyconidDrow_Dead:3bed0658-1cd8-4f4c-569a-36bcbe099f19
msgctxt "hf9cee42agc371g4963g817fgc7fedd912c1b"
msgid "... with spectator... won't... have gone far... hah... <i>hahaha</i>..."
msgstr "... 스펙테이터를 풀었으니... 멀리... 못 갔겠지... 하... <i>하하하</i>..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_MyconidDrow_Dead
#. Speaker = Pale Corpse
#. NodeID = 4c105d52-83a3-7a12-2862-5a62c550a457
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_FurnaceSearch_Knows_JournalDisguised = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_MyconidDrow_Dead:4c105d52-83a3-7a12-2862-5a62c550a457
msgctxt "h9f34df34ga813g4d92g9351ga83d26b27c08"
msgid "... book... disguised ... by magic..."
msgstr "... 책... 마법으로... 위장되어 있어..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_MyconidDrow_Dead
#. Speaker = Player
#. NodeID = 583520b7-4afa-3478-d044-21d32c866365
#. HandlePath = TaggedText[0].TagText[0]
