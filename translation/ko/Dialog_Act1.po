#.     - 687a5077-5eb0-495c-a974-06fced65d325_SpiderCheck = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice:e47d0332-44be-a2a3-e3c3-7214369e92a4
msgctxt "hf452e194gedfag4840ga47cg59436beb6c2a"
msgid "<i>Survey the spiders.</i>"
msgstr "<i>거미를 조사한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice
#. Speaker = Narrator
#. NodeID = e6d6429f-cb83-f851-348b-1111af2b9caf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_Outpost_Event_Calmed = False
#.      - CHA_Outpost_State_BagOut = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice:e6d6429f-cb83-f851-348b-1111af2b9caf
msgctxt "he0cd7296g0a37g4a10g9b20g93ce45826333"
msgid "*A cluster of spiders scuttle inside the crevice.*"
msgstr "*한 무리의 거미가 황급히 틈새 안쪽으로 달아납니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice
#. Speaker = Player
#. NodeID = ec84e82d-1a32-d659-5698-24fd7d091d0b
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Dexterity
#. DifficultyClass: 15
#. CheckFlags:
