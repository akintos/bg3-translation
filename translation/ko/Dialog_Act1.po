#.      - e146b889-323f-540c-30b9-756d4fd55813_InspectedSymbol = False
#. SetFlags:
#.   Local:
#.     - e146b889-323f-540c-30b9-756d4fd55813_InspectedSymbol = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait:5b607e02-3dab-0e19-97f8-1a6493397adf
msgctxt "h4c7d7b6ag92f1g4534g8002g54ebbc58b029"
msgid "<i>Inspect the symbol more closely.</i>"
msgstr "<i>문양을 좀 더 자세히 관찰한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait
#. Speaker = Lae'zel
#. NodeID = 6197bfd7-87ec-4d7c-b8c7-4080740d337b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait:6197bfd7-87ec-4d7c-b8c7-4080740d337b
msgctxt "h89dec683g4230g4a06g95b4ge3216507ab02"
msgid "Pathetic and profane. You've the brain of a child."
msgstr "한심하고 모독적이야! 넌 애새끼의 뇌가 머리에 들었나 보군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait
#. Speaker = Narrator
#. NodeID = 67b506ac-0068-6ff7-e998-686855cbd0e3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait:67b506ac-0068-6ff7-e998-686855cbd0e3
msgctxt "h8398bd5cg6bb1g4779g98c7g1de625013a38"
msgid "*It appears to be a depiction of a comet.*"
msgstr "*혜성을 묘사한 것 같습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait
#. Speaker = Player
#. NodeID = 684fb1ae-baf3-4930-e42a-b1e68c13762c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CRE_General_State_VlaakithPortrait_ExaminedFace(1) = False
#.   Tag:
#.      - REALLY_GITHYANKI(1) = False
#. SetFlags:
#.   Object:
#.     - CRE_General_State_VlaakithPortrait_ExaminedFace(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait:684fb1ae-baf3-4930-e42a-b1e68c13762c
msgctxt "h029a3474g418dg4d34ga10bgf26fd2228ba2"
msgid "<i>Study the subject's features.</i>"
msgstr "<i>초상화 인물의 특징을 조사한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait
#. Speaker = Narrator
#. NodeID = 68dbf70a-d741-fa84-7275-c2da2221b01c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = False
#. SetFlags:
#.   Global:
#.     - CRE_General_State_VlaakithPortraitRuined = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait:68dbf70a-d741-fa84-7275-c2da2221b01c
msgctxt "hb1b78e30gef7bg43c1g9daagab49c7fddab0"
msgid "*She certainly looks a little less regal now.*"
msgstr "*확실히 지금은 덜 당당해 보입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait
#. Speaker = Lae'zel
#. NodeID = 7530560f-ccb5-4feb-bb7f-bac9774369c2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_State_IsOnOrpheusPath = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait:7530560f-ccb5-4feb-bb7f-bac9774369c2
msgctxt "h2336e84ag3b34g414fga885g971692ad1694"
msgid ""
"The sign of Orpheus. Centuries gone, yet his influence stretches across the "
"planes."
msgstr "오르페우스의 표식입니다. 수백 년이 지났지만, 그의 영향력은 모든 차원을 넘어 뻗어나가고 있습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait
#. Speaker = Narrator
#. NodeID = 857eadd6-9495-f219-b37b-60910ba2e1f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait:857eadd6-9495-f219-b37b-60910ba2e1f3
msgctxt "h7fd92230g6140g4cf8ga34dga054dedcfde8"
msgid ""
"*The way her stark white skin stretches over her sharp features gives her a "
"distinctly otherworldly aspect.*"
msgstr "*날카로운 이목구비가 새하얀 피부로 덮여진 모습은 격하게 이질적으로 느껴집니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait
#. Speaker = Player
#. NodeID = 934ad652-a27d-5f54-3291-aedc7ab5166d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 14
#. CheckFlags:
