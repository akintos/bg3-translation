msgctxt "h29b4f836g64e3g48bbgb368gcaaae58edc8e"
msgid "Honour your servants. <i>Tuuch! Tuuch! Tuuch!</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinKing_AD_MinionsBeforeScrying
