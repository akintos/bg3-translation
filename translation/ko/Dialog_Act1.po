msgctxt "h6400a1e5ge1a2g47a0g978fgb1807526f390"
msgid "Did that artist really paint all those things?"
msgstr "저 예술가가 정말로 저것들을 전부 그린 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03_AD_Zhent04
#. Speaker = Garias
#. NodeID = 5ade35d2-7bd7-5620-3afd-7743daef2a56
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03_AD_Zhent04:5ade35d2-7bd7-5620-3afd-7743daef2a56
msgctxt "h095b45b9geb38g4c59g9199gb5c7bde61157"
msgid "Aw."
msgstr "오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03_AD_Zhent04
#. Speaker = Brem
#. NodeID = 63e7f4c7-fe2e-18f6-8541-02301e388f06
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03_AD_Zhent04:63e7f4c7-fe2e-18f6-8541-02301e388f06
msgctxt "h7489830bgd923g4440g8413g19cfb200044b"
msgid "You got coin?"
msgstr "동전은 좀 있어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03_AD_Zhent04
#. Speaker = Garias
#. NodeID = 69d74036-9ce2-3d73-bc6b-d6cfeee21a14
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03_AD_Zhent04:69d74036-9ce2-3d73-bc6b-d6cfeee21a14
msgctxt "h5572234fgac5bg4cbbg94b0g41ef4582de25"
msgid "Why?"
msgstr "왜?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03_AD_Zhent04
#. Speaker = Brem
#. NodeID = 7df02745-7171-7fcd-fa75-da0d7deeceb6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03_AD_Zhent04:7df02745-7171-7fcd-fa75-da0d7deeceb6
msgctxt "h22135baag5a54g4c00g8359gff8b18b51dfb"
msgid "Don't pretend you know what that means. What kind of drawin' you want?"
msgstr "그게 무슨 의미인지 아는 척하지 마. 어떤 그림을 원하는 건데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03_AD_Zhent04
#. Speaker = Garias
#. NodeID = 95c2d3c5-53a1-24a7-7098-62c20d14fdf5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03_AD_Zhent04:95c2d3c5-53a1-24a7-7098-62c20d14fdf5
msgctxt "h2fedc249g4f45g42b6gbc19ga525a0359b8c"
msgid "He what?"
msgstr "그 녀석이 뭐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03_AD_Zhent04
#. Speaker = Brem
#. NodeID = 9a2c3bce-a4e3-01d5-d28d-af96433820ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03_AD_Zhent04:9a2c3bce-a4e3-01d5-d28d-af96433820ed
msgctxt "hcb99089dg3763g4b2cga1a7g6bc902e9cc85"
msgid "Says his muse made him do it."
msgstr "그의 뮤즈가 그렇게 하게 했다던데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03_AD_Zhent04
#. Speaker = Garias
#. NodeID = 9e3c8233-c7a5-f234-5bf8-d513d163387f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_DoubtingArtist_State_FreeBribe = False
#.      - PLA_DoubtingArtist_Event_FreedByPersuade = False
#.   Local:
#.      - ad98f134-2a18-1ff2-1074-8e5f8f1e2c94_Step1 = False
#.      - ad98f134-2a18-1ff2-1074-8e5f8f1e2c94_Step2 = True
#. SetFlags:
#.   Local:
#.     - ad98f134-2a18-1ff2-1074-8e5f8f1e2c94_Step1 = False
#.     - ad98f134-2a18-1ff2-1074-8e5f8f1e2c94_Step2 = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03_AD_Zhent04:9e3c8233-c7a5-f234-5bf8-d513d163387f
msgctxt "hdfab57cdgecbcg4518g93e6g9abe882a2058"
msgid "Here, make your fella draw me something."
msgstr "자, 네 친구가 내게 뭐라도 그려주게 해 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03_AD_Zhent04
#. Speaker = Brem
#. NodeID = 9fb7caf6-a075-84ef-afa0-cb6e0587f7aa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03_AD_Zhent04:9fb7caf6-a075-84ef-afa0-cb6e0587f7aa
msgctxt "h9dc3cfc1g479cg483fg8d4dg22cfc2a93fbd"
msgid "Says he did, yeah."
msgstr "자기 말로는 그렇다던데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03_AD_Zhent04
#. Speaker = Garias
#. NodeID = a0a5119a-a67d-19cd-cf7f-dc1b4978b08b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03_AD_Zhent04:a0a5119a-a67d-19cd-cf7f-dc1b4978b08b
msgctxt "hce34554aga30bg4600gb3ccg48b5373845dd"
msgid "Who's that, then?"
msgstr "그럼 그게 누군데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03_AD_Zhent04
#. Speaker = Brem
#. NodeID = ba311526-ebda-3544-1e44-42a658dd5402
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03_AD_Zhent04:ba311526-ebda-3544-1e44-42a658dd5402
msgctxt "h63dc31c8g014bg4dbfgbc0dgee7cea0c55c1"
msgid "Besides the bleedin' obvious? He <i>misses the sun</i>."
msgstr "망할 당연한 것 말고도? 그는 <i>해를 그리워 한다더군</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03_AD_Zhent04
#. Speaker = Brem
#. NodeID = c2940752-9a05-c61c-deb1-e5f67e52d990
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03_AD_Zhent04:c2940752-9a05-c61c-deb1-e5f67e52d990
msgctxt "hbfe45ffcg2b57g45d7g8130g6d7d6f82dad8"
msgid "Gods, little brother - read a bleedin' book."
msgstr "신이시여, 동생아 - 망할 책 좀 읽어라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03_AD_Zhent04
#. Speaker = Garias
#. NodeID = d777a1f6-3ec3-f061-70d7-f809eb21047a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03_AD_Zhent04:d777a1f6-3ec3-f061-70d7-f809eb21047a
msgctxt "hc8d89e33gea2eg4946gb8e8g2ff65756a7d4"
msgid "So? Can do a better job than that ponce you sold."
msgstr "그래서? 네가 판 계집년보다는 일을 잘 할 수 있는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03_AD_Zhent04
#. Speaker = Brem
#. NodeID = e62eaaa1-f4e1-162d-b68f-bc2bdd995051
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03_AD_Zhent04:e62eaaa1-f4e1-162d-b68f-bc2bdd995051
msgctxt "hdd262f42ge785g4378gabd0ga56f0232930a"
msgid ""
"Needs light to work, he says. We had a chat - turns out he needs his eyes "
"more."
msgstr "일하려면 빛이 필요하다고 하던데. 얘기를 나눠봤는데 - 알고 보니 눈알이 더 소중한가 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03_AD_Zhent04
#. Speaker = Garias
#. NodeID = eb3ecc22-ac01-a61d-822f-0d905bab45d3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03_AD_Zhent04:eb3ecc22-ac01-a61d-822f-0d905bab45d3
msgctxt "hc7aacf8dg1288g4e85g8e3bg3f9d9b3d20c7"
msgid "They got paintings in those?"
msgstr "거기도 그림이 있어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03_AD_Zhent04
#. Speaker = Garias
#. NodeID = fbeb046d-2ea4-1d55-5ab0-15008940a6d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03_AD_Zhent04:fbeb046d-2ea4-1d55-5ab0-15008940a6d0
msgctxt "h03430d47g98bcg4d00ga3c3g6aeacdc4e1a1"
msgid "Yeah, all right, <i>fine</i>. Who are you, his <i>muse</i>?"
msgstr "그래, 알았어, <i>알았다고</i>. 네가 뭐, 그의 <i>뮤즈</i>라도 되냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent04
#. Speaker = Garias
#. NodeID = 2a20ae02-1328-70b3-9cf4-7aa505d3ba02
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentDungeon_State_GnollZhentsPresent = True
#.      - PLA_ZhentShipment_State_ChestLost = True
#.      - PLA_ZhentDungeon_State_JoinedZhent = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent04:2a20ae02-1328-70b3-9cf4-7aa505d3ba02
msgctxt "h25af8f23g318dg4924gbb0bg1d26e8ec676f"
msgid "You don't want to keep Zarys waiting, believe me."
msgstr "자리스를 기다리게 하지 않는 게 좋을걸. 내 말 믿어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent04
#. Speaker = Garias
#. NodeID = 5bb15776-5fd1-fd7f-b719-ac6663015086
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_ZhentDungeon_Zhent04_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - PLA_ZhentDungeon_Zhent04_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent04:5bb15776-5fd1-fd7f-b719-ac6663015086
msgctxt "h8d1ede3ag9bbag47a6gac42g7c22f6920c34"
msgid "You don't want to keep Zarys waiting, believe me."
msgstr "자리스를 기다리게 하지 않는 게 좋을걸. 내 말 믿어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent04
#. Speaker = Garias
#. NodeID = 6a8abce1-2818-87e3-db66-0004cc7658e4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_ZhentDungeon_Zhent04_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent04:6a8abce1-2818-87e3-db66-0004cc7658e4
msgctxt "h92980cd9g73abg4f9cgb4d9g743a5bb9e002"
msgid "Don't touch anything you ain't paid for."
msgstr "돈 낸 거 아니면 아무것도 만지지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent04_AD_Idle
#. Speaker = Garias
#. NodeID = 3b1a5662-5fe9-8392-faa0-0806fd96589c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 42f1f3b5-f411-4213-34f0-b93192337870_B = True
#.      - 42f1f3b5-f411-4213-34f0-b93192337870_C = True
#.      - 42f1f3b5-f411-4213-34f0-b93192337870_A = True
#. SetFlags:
#.   Local:
#.     - 42f1f3b5-f411-4213-34f0-b93192337870_B = False
#.     - 42f1f3b5-f411-4213-34f0-b93192337870_C = False
#.     - 42f1f3b5-f411-4213-34f0-b93192337870_A = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent04_AD_Idle:3b1a5662-5fe9-8392-faa0-0806fd96589c
msgctxt "h47627335g0f0fg4c98g9b85g877235d7d48c"
msgid "Wonder if the Fist pay better than this lot..."
msgstr "피스트가 이 놈들보다 돈을 잘 주는지 궁금하네..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent04_AD_Idle
#. Speaker = Garias
#. NodeID = 4c085d80-346c-7f5e-5af9-8b11da0325e2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 42f1f3b5-f411-4213-34f0-b93192337870_B = True
#.      - 42f1f3b5-f411-4213-34f0-b93192337870_C = False
#.      - 42f1f3b5-f411-4213-34f0-b93192337870_A = True
#. SetFlags:
#.   Local:
#.     - 42f1f3b5-f411-4213-34f0-b93192337870_C = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent04_AD_Idle:4c085d80-346c-7f5e-5af9-8b11da0325e2
msgctxt "h37356e75g6d44g4377g9dfage3e7c600056f"
msgid "I was told there'd be battles. Not this hide-and-seek stuff."
msgstr "이런 숨바꼭질이 아니라 전투가 있을 거라고 들었는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent04_AD_Idle
#. Speaker = Garias
#. NodeID = c227935c-0bd6-db12-3aac-760264b90f98
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 42f1f3b5-f411-4213-34f0-b93192337870_B = False
#.      - 42f1f3b5-f411-4213-34f0-b93192337870_C = False
#.      - 42f1f3b5-f411-4213-34f0-b93192337870_A = True
#. SetFlags:
#.   Local:
#.     - 42f1f3b5-f411-4213-34f0-b93192337870_B = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent04_AD_Idle:c227935c-0bd6-db12-3aac-760264b90f98
msgctxt "h9faddd5ag428bg4145g9abbg07eea28ce71a"
msgid "Are we unpacking? I thought we was packing."
msgstr "짐을 푸는 거야? 짐을 꾸리는 줄 알았는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent04_AD_Idle
#. Speaker = Garias
#. NodeID = d3869948-81cb-24fd-46b4-71d96003e71b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 42f1f3b5-f411-4213-34f0-b93192337870_B = False
#.      - 42f1f3b5-f411-4213-34f0-b93192337870_C = False
#.      - 42f1f3b5-f411-4213-34f0-b93192337870_A = False
#. SetFlags:
#.   Local:
#.     - 42f1f3b5-f411-4213-34f0-b93192337870_A = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent04_AD_Idle:d3869948-81cb-24fd-46b4-71d96003e71b
msgctxt "h76aef516g3b97g49a0gade0gb184b4497d3f"
msgid "Hope the Fist tries to storm in. I want to see those traps in action."
msgstr "피스트 놈들이 들이닥쳤으면 좋겠네. 함정들이 작동하는 걸 보고 싶거든.< br>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent04_AD_Welcome
#. Speaker = Garias
#. NodeID = 52ab4880-36d9-7681-b5a5-5e740fba88df
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent04_AD_Welcome:52ab4880-36d9-7681-b5a5-5e740fba88df
msgctxt "h731e5a48ge063g4a55ga363gfe78f31a4180"
msgid "Don't get comfortable."
msgstr "너무 편히 있지마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent04_AD_Welcome
#. Speaker = Garias
#. NodeID = 52ab4880-36d9-7681-b5a5-5e740fba88df
#. HandlePath = TaggedText[0].TagText[1]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent04_AD_Welcome:52ab4880-36d9-7681-b5a5-5e740fba88df
msgctxt "hcd6cd5dbg70eag496bga3e0gf2355e17ad3e"
msgid "You steal anything, you're dead."
msgstr "뭐든 훔치면 넌 죽은 셈이나 다름없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent04_AD_Welcome
#. Speaker = Garias
#. NodeID = 52ab4880-36d9-7681-b5a5-5e740fba88df
#. HandlePath = TaggedText[0].TagText[2]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent04_AD_Welcome:52ab4880-36d9-7681-b5a5-5e740fba88df
msgctxt "h7955858fg1c60g44acg86d1ge13e91232be3"
msgid "Hope you weren't followed, mate."
msgstr "미행은 없었겠지. 친구."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent04_AD_Welcome
#. Speaker = Garias
#. NodeID = 52ab4880-36d9-7681-b5a5-5e740fba88df
#. HandlePath = TaggedText[0].TagText[3]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent04_AD_Welcome:52ab4880-36d9-7681-b5a5-5e740fba88df
msgctxt "hdf8f7501g11bcg4c5cg8ea2g09b9a69df24a"
msgid "What's that smell?"
msgstr "이게 무슨 냄새지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent05
#. Speaker = Bellar
#. NodeID = 8989888e-f059-785e-8fb2-32f51c8ad20b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_ZhentDungeon_Zhent05_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - PLA_ZhentDungeon_Zhent05_HasMet(1) = True
#. TagRule: GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent05:8989888e-f059-785e-8fb2-32f51c8ad20b
msgctxt "h0b54c855g97d3g415egbb05g6b35ff71e95d"
msgid "You look like a bad enemy to have - glad I won't have to find out."
msgstr "넌 적으로 만나면 안될 것 같아 - 굳이 그걸 확인할 필요가 없어 다행이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent05
#. Speaker = Bellar
#. NodeID = 8989888e-f059-785e-8fb2-32f51c8ad20b
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_ZhentDungeon_Zhent05_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - PLA_ZhentDungeon_Zhent05_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent05:8989888e-f059-785e-8fb2-32f51c8ad20b
msgctxt "hf50bc662g1a44g4f0agbf74g938f504ab3cc"
msgid "You seem a nice sort - I'm glad we didn't have to kill you."
msgstr "넌 괜찮은 사람 같아 - 널 죽일 필요가 없어서 다행이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent05
#. Speaker = Bellar
#. NodeID = 9d62a8b6-bac2-4b3d-ff62-c3764010ce74
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_ZhentDungeon_Zhent05_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent05:9d62a8b6-bac2-4b3d-ff62-c3764010ce74
msgctxt "ha7080cf3g0fc4g46bcgaed3g3d55f2743d56"
msgid ""
"Flaming Fist crawling above and the Underdark waiting below. Don't know "
"which I like less."
msgstr "위에는 플레이밍 피스트가 기어다니고 아래에는 언더다크가 기다리는군. 어느 쪽이 더 나쁜지도 모르겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent05
#. Speaker = Bellar
#. NodeID = cc407148-0b03-85d6-1240-315d6e3e57eb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_ZhentDungeon_Zhent05_HasMet(1) = False
#.   Global:
#.      - PLA_ZhentDungeon_State_GnollZhentsPresent = True
#.      - PLA_ZhentDungeon_State_ZhentAgent002Arrived = True
#.      - PLA_ZhentShipment_State_ChestLost = True
#.      - PLA_ZhentDungeon_State_JoinedZhent = False
#. SetFlags:
#.   Dialog:
#.     - PLA_ZhentDungeon_Zhent05_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent05:cc407148-0b03-85d6-1240-315d6e3e57eb
msgctxt "h20605216g8407g4fc4ga6f8ga2adbf0311e5"
msgid "Olly was a decent lad. Pained me to cut on him like that."
msgstr "올리는 괜찮은 녀석이었어. 그렇게 잘라내어서 마음이 아팠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent05
#. Speaker = Bellar
#. NodeID = e9dfcc6f-0485-ccad-d81d-c60cfdc68992
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_ZhentDungeon_Zhent05_HasMet(1) = False
#.   Global:
#.      - PLA_ZhentDungeon_State_GnollZhentsPresent = True
#.      - PLA_ZhentDungeon_State_ZhentAgent002Arrived = False
#.      - PLA_ZhentShipment_State_ChestLost = True
#.      - PLA_ZhentDungeon_State_JoinedZhent = False
#. SetFlags:
#.   Dialog:
#.     - PLA_ZhentDungeon_Zhent05_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent05:e9dfcc6f-0485-ccad-d81d-c60cfdc68992
msgctxt "h1caf9d48g302dg434agbf16g59d565c0c12c"
msgid ""
"See my handiwork? He started squealing before the knives came out, truth be "
"told. But it pays to be thorough."
msgstr "내 솜씨 봤어? 칼날이 보이기도 전에 소리를 지르잖아, 솔직히 말하건대 철저해서 나쁠 거 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent05_AD_Combat_LeaderDied
#. Speaker = Bellar
#. NodeID = d53ae958-4c10-43a3-8046-bf884f68e894
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent05_AD_Combat_LeaderDied:d53ae958-4c10-43a3-8046-bf884f68e894
msgctxt "hc8335f3dg0c08g40b8gb918gde7b222e3423"
msgid "Zarys! The swordhar's down!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent05_AD_Combat_PoisonUsed
#. Speaker = Bellar
#. NodeID = 6445bfe7-a44c-470c-b11b-4452fc91c1cd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent05_AD_Combat_PoisonUsed:6445bfe7-a44c-470c-b11b-4452fc91c1cd
msgctxt "h5937c91eg6842g4bd7gaebbg5c5e76d26995"
msgid "I've been wanting to try this venom..."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent05_AD_Idle
#. Speaker = Bellar
#. NodeID = 6550f0db-2110-7629-a198-df8cc917582f
