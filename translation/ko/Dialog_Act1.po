msgctxt "he5a40f81gaaa0g4cf2g9e2dg8e2adb80d249"
msgid ""
"This ain't right. Why are you resisting me if you're one with the Absolute?"
msgstr "이건 아니지. 네가 절대자님과 하나라면, 왜 내게 저항하는 거냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = b0af4b89-e2fa-d67b-96ae-7d6300fc6bfb
