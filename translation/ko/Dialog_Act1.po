msgctxt "h7db95b86g7bc3g4110g8327gbcf0cd422688"
msgid "Unfortunately, yes."
msgstr "안타깝게도, 맞아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Doctor
