msgctxt "h135232d4g974cg4645ga85cg93b8253a68dd"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_DeadFisherman5_Dead
#. Speaker = Narrator
#. NodeID = 99b6c431-d178-defc-46d3-7b84722ccbfb
