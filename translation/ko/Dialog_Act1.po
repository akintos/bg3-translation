msgctxt "he975e3fcgeae5g45begb2b2g27a0f685588e"
msgid "Exactly."
msgstr "바로 그거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses
#. Speaker = Ide
#. NodeID = 586df6f9-6bfb-0f03-c309-338e77d65af3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses:586df6f9-6bfb-0f03-c309-338e77d65af3
msgctxt "h16ec63d3gab6cg46b0g9599g82eca624bd0c"
msgid "Me too!"
msgstr "나도!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses
#. Speaker = Wyll
#. NodeID = 5c6f44dc-c64d-2efc-c171-afe3b23d4bee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses:5c6f44dc-c64d-2efc-c171-afe3b23d4bee
msgctxt "hc06b0e77g9147g4a9fgb04cg1738995a40fa"
msgid "Focus, children."
msgstr "집중해라, 얘들아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses
#. Speaker = Gan
#. NodeID = 5fbf6a80-4aa3-ff1b-8d14-617e72b82214
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses:5fbf6a80-4aa3-ff1b-8d14-617e72b82214
msgctxt "h242fa237g8a03g497agb8f1g39c223d47b48"
msgid "Whoa!"
msgstr "우와!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses
#. Speaker = Wyll
#. NodeID = 618af951-fe2f-4507-4d40-00523a38ffa0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses:618af951-fe2f-4507-4d40-00523a38ffa0
msgctxt "hb03b83b4g83f6g41c6g81degfff76237dc6a"
msgid "Use that too. Your entire body is a weapon."
msgstr "그것도 쓰렴. 네 몸 전체를 무기로 삼는 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses
#. Speaker = Wyll
#. NodeID = 681b1444-a06a-901b-22db-9fb41c3d12c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses:681b1444-a06a-901b-22db-9fb41c3d12c6
msgctxt "h58d88343ga2a1g402dga140ged72f835dbbb"
msgid "What'd I tell you?"
msgstr "거 보려무나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses
#. Speaker = Ide
#. NodeID = 707131b8-64a6-7e54-20d1-cfa3b5e5c680
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses:707131b8-64a6-7e54-20d1-cfa3b5e5c680
msgctxt "h6bd8771fg9b81g422bgbc1fgc889fee70879"
msgid "I'm going to kill six hundred."
msgstr "난 육백 놈 정도 없앨 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses
#. Speaker = Gan
#. NodeID = 815f0769-edda-93be-5bea-019c00f66d65
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Trainer_State_Phase3 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses:815f0769-edda-93be-5bea-019c00f66d65
msgctxt "hcc1a66e8g0455g4586gb593g8dde4df6f4e1"
msgid "Watch this! Nngh!\n"
msgstr "잘 봐요! 으럇!\n"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses
#. Speaker = Ide
#. NodeID = 823cea79-5934-0777-6f23-dbb7e2c6049f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses:823cea79-5934-0777-6f23-dbb7e2c6049f
msgctxt "h08bf70b6g4952g4cb4ga3d9g023fdd8daff2"
msgid "No it's not! See? WHACK!"
msgstr "이걸 왜 못 해? 봐! 이얏!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses
#. Speaker = Gan
#. NodeID = 8c85325d-5381-2efd-599c-fc287eb618ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses:8c85325d-5381-2efd-599c-fc287eb618ae
msgctxt "h500a6206gef1cg4b51g94d8g006619925073"
msgid "WHACK!"
msgstr "<b>우왁!</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses
#. Speaker = Wyll
#. NodeID = 8d4657de-f500-46cb-c49c-fb0186852833
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses:8d4657de-f500-46cb-c49c-fb0186852833
msgctxt "he8f03b04g76d5g4847gafbfg60297ccaf483"
msgid "Really."
msgstr "그럼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses
#. Speaker = Wyll
#. NodeID = 8fda3943-313f-90bc-9131-7cb52af6dab6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses:8fda3943-313f-90bc-9131-7cb52af6dab6
msgctxt "hb971e57bg1de6g41f6ga27dg4b7bb7ce0976"
msgid "Now, now. Real heroes don't argue - they cooperate!"
msgstr "자, 자. 진짜 영웅들을 서로 다투지 않아. 협력을 하지!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses
#. Speaker = Gan
#. NodeID = 96bd73d8-9bb7-d47a-83a3-ba185ae30ee5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Trainer_State_Phase3 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses:96bd73d8-9bb7-d47a-83a3-ba185ae30ee5
msgctxt "he530642cg6b4dg493bg991egf800d0024d2c"
msgid "What about my tail?"
msgstr "제 꼬리는 어떻게 해요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses
#. Speaker = Wyll
#. NodeID = 9c745a99-7075-c8f4-9bb5-84d241d239a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses:9c745a99-7075-c8f4-9bb5-84d241d239a8
msgctxt "h951a4071gebfcg4656g83c2g2ae29963b335"
msgid "You're already halfway there, kid."
msgstr "너라면 금방 그리될 거다, 얘야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses
#. Speaker = Gan
#. NodeID = b7022600-1073-d279-e207-f9393b3908e6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Trainer_State_Phase2 = True
#.   Object:
#.      - DEN_Thieflings_Event_HasOtherKid(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses:b7022600-1073-d279-e207-f9393b3908e6
msgctxt "h6df15076g4a69g4276g96b2g429a901875fa"
msgid "It's too hard..."
msgstr "너무 어려워요..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses
#. Speaker = Gan
#. NodeID = b9a83648-4a81-3d88-5ae8-54c2d46c8f0c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Thieflings_Event_HasOtherKid(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses:b9a83648-4a81-3d88-5ae8-54c2d46c8f0c
msgctxt "hbbae2976g86a7g48a5g8cf8gefe2ddc304ee"
msgid "Can I name my sword?"
msgstr "제 칼에 이름 붙여도 돼요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses
#. Speaker = Gan
#. NodeID = ccbb9f6f-9c8e-a007-d2a5-5def4b0a0c3b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses:ccbb9f6f-9c8e-a007-d2a5-5def4b0a0c3b
msgctxt "h780a7541g5538g407bg94e4gb84e333d6330"
msgid "Wicked."
msgstr "죽인다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses
#. Speaker = Wyll
#. NodeID = dba624fb-20a1-5216-a63f-13a44e29023a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses:dba624fb-20a1-5216-a63f-13a44e29023a
msgctxt "he5a237b5g7153g4969gba7eg71e8cadaf202"
msgid "Go right ahead."
msgstr "좋을 대로 하렴."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses
#. Speaker = Ide
#. NodeID = e7f6e80d-6b8b-93e4-003a-7d160438b7a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses:e7f6e80d-6b8b-93e4-003a-7d160438b7a3
msgctxt "h8ad5ce45g96aeg4a57ga217g8fb20b8de61d"
msgid "How many?"
msgstr "얼마나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses
#. Speaker = Gan
#. NodeID = e94290a4-7e57-c379-8ead-e3ef38a33d4c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses:e94290a4-7e57-c379-8ead-e3ef38a33d4c
msgctxt "h361cfa5ag6b36g42c5g93a0gb3b1254dcb0c"
msgid "Really?"
msgstr "정말요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses
#. Speaker = Ide
#. NodeID = edb0f468-6c29-0861-b139-6a6cfcb74a6c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses:edb0f468-6c29-0861-b139-6a6cfcb74a6c
msgctxt "h715a363fg3eceg407dgba98g214f4012427e"
msgid "That's my sword's name!"
msgstr "그건 내 검 이름이잖아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses
#. Speaker = Gan
#. NodeID = ef37e140-a2f0-7504-8f08-dd2a5d2763e4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Thieflings_Event_HasOtherKid(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses:ef37e140-a2f0-7504-8f08-dd2a5d2763e4
msgctxt "h8d2ca916g0611g4c39gb324gf6f29fda07f2"
msgid "Rrrargh!"
msgstr "으아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses
#. Speaker = Gan
#. NodeID = f0891060-be75-714b-9ae3-4266eac63f03
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Trainer_State_Phase2 = True
#.   Object:
#.      - DEN_Thieflings_Event_HasOtherKid(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses:f0891060-be75-714b-9ae3-4266eac63f03
msgctxt "h22be5db7gdf71g4c13gb2ffg77c98dfaf9da"
msgid "I'm going to kill so many goblins."
msgstr "고블린 놈들 잔뜩 죽일 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses
#. Speaker = Gan
#. NodeID = f4c2d78a-5a97-2bed-d6b0-6a94dce117f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses:f4c2d78a-5a97-2bed-d6b0-6a94dce117f3
msgctxt "h52f68043g8d01g4f08g9291g330558fc5931"
msgid "Like six. "
msgstr "한 여섯쯤? "

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses
#. Speaker = Gan
#. NodeID = f68718fb-a86e-a16a-a914-a3777b8885e2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Thieflings_Event_HasOtherKid(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses:f68718fb-a86e-a16a-a914-a3777b8885e2
msgctxt "h2c3e578agba9dg4db1g956dg2ffd76f73451"
msgid "I want to be like you when I grow up."
msgstr "나중에 크면 아저씨처럼 되고 싶어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses
#. Speaker = Gan
#. NodeID = f6e3bf6a-8798-03a9-3bb1-5605d521b8bd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Thieflings_Event_HasOtherKid(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Trainee3Responses:f6e3bf6a-8798-03a9-3bb1-5605d521b8bd
msgctxt "h7e4ce426g8aefg4c24gb96cgf6b52792f3a1"
msgid "I want to be like you when I grow up."
msgstr "나중에 크면 아저씨처럼 되고 싶어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Training
#. Speaker = Wyll
#. NodeID = 0aade2c6-4f41-39b0-2326-050d74f601fe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Trainer_Event_HasKidAnswer = True
#.      - DEN_Trainer_State_Phase3 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Training:0aade2c6-4f41-39b0-2326-050d74f601fe
msgctxt "h060de964gde47g4d06gaf59g50bd4c610329"
msgid "Good work, kids. You're all heroes, each and every one of you."
msgstr "잘하고 있구나, 얘들아. 너희 하나하나 모두가 영웅이란다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Training
#. Speaker = Wyll
#. NodeID = 3b5ebd16-8661-0775-b288-caf8f207389b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Trainer_Event_HasKidAnswer = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Training:3b5ebd16-8661-0775-b288-caf8f207389b
msgctxt "hb9c1f2e2g4347g4db6ga362gbf28a2ab65b3"
msgid "That's the way!"
msgstr "아주 잘했어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Training
#. Speaker = Wyll
#. NodeID = 44a6c4b3-816d-2321-faf2-8760cdbd6c10
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Trainer_Event_HasKidAnswer = True
#.      - DEN_Trainer_State_Phase2 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Training:44a6c4b3-816d-2321-faf2-8760cdbd6c10
msgctxt "h5fd415c9g28e9g4fa0gb02cgdb26d6cc2d55"
msgid "Give it a good whack!"
msgstr "제대로 한 방 후려쳐!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Training
#. Speaker = Wyll
#. NodeID = 44a6c4b3-816d-2321-faf2-8760cdbd6c10
#. HandlePath = TaggedText[0].TagText[1]
#. CheckFlags:
#.   Global:
#.      - DEN_Trainer_Event_HasKidAnswer = True
#.      - DEN_Trainer_State_Phase2 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Training:44a6c4b3-816d-2321-faf2-8760cdbd6c10
msgctxt "hae91c45bga696g4418g8c7dg7f243c54caca"
msgid "Elbows high. Now pull back and... swing!"
msgstr "팔꿈치 들고, 이제 뒤로 당긴 다음... 휘둘러!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Training
#. Speaker = Wyll
#. NodeID = af842dab-38a5-41fd-4732-07bac8f86b87
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Trainer_Event_HasKidAnswer = False
#.      - DEN_Trainer_State_Phase2 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Training:af842dab-38a5-41fd-4732-07bac8f86b87
msgctxt "hf6275068g2e5fg404fg9522g90b3f713492c"
msgid "I'm proud of you, kids."
msgstr "정말 대견스럽구나, 얘들아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Training
#. Speaker = Wyll
#. NodeID = d4580b7f-55c0-9b93-c088-df0963fba65d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Trainer_Event_HasKidAnswer = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Training:d4580b7f-55c0-9b93-c088-df0963fba65d
msgctxt "h7521afefgb373g4523gbccag8df16d95aa11"
msgid "Take your time... get a feel for it."
msgstr "조바심 내지 말고... 감을 잡는 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Training
#. Speaker = Wyll
#. NodeID = e24cfffc-0d93-e4e0-59fa-d64c1cbc18b2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Trainer_Event_HasKidAnswer = False
#.      - DEN_Trainer_State_Phase3 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_WyllRecruitment_AD_Training:e24cfffc-0d93-e4e0-59fa-d64c1cbc18b2
msgctxt "hd18cfaf0g5f93g4a2bg8b33g01db1793b59f"
msgid "Go on. Make me proud!"
msgstr "계속해. 날 흐뭇하게 해주렴!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Bex
#. NodeID = 03379b3f-7f2a-548d-2964-c0b6d99c13f2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:03379b3f-7f2a-548d-2964-c0b6d99c13f2
msgctxt "h80d8601bgd221g4a61g94d3gd65693a37e48"
msgid "Good luck to you, then. And wish us some too!"
msgstr "그럼 행운을 빌게. 우리 행운도 빌어줘!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Player
#. NodeID = 03435551-a5ad-a41a-1c65-4abae4c3acca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:03435551-a5ad-a41a-1c65-4abae4c3acca
msgctxt "h793e1ad4gc326g4b6cg90e9g7b32e724ba9e"
msgid "What is this 'cat' you speak of?"
msgstr "네가 말한 '고양이'라는 게 뭐야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Danis
#. NodeID = 07a1b76a-f65e-c1cb-b0d5-d6c1c3c05654
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_General_YoungLovers_HasMet(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:07a1b76a-f65e-c1cb-b0d5-d6c1c3c05654
msgctxt "h5ce31ed8ge0adg445bga931g3c13dae59bb5"
msgid "I suppose we'll start in the Outer City, get a little business going..."
msgstr "외부 도시에서부터 시작을 하는 게 좋을 것 같아. 거기서 작은 사업을 굴리면..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Bex
#. NodeID = 081c8398-2546-4db4-3f0a-ed5dce67f72e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:081c8398-2546-4db4-3f0a-ed5dce67f72e
msgctxt "hcd0c9fd3g5ec5g474fgb7c7g1531c9146aff"
msgid "I am <i>what </i>now?"
msgstr "방금 <i>뭐라고</i>?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Bex
#. NodeID = 092810ab-5f6b-6d6b-317f-e21daac76ca8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:092810ab-5f6b-6d6b-317f-e21daac76ca8
msgctxt "hdea694fdg22bdg4ae5gb19egf45921b1ced3"
msgid "Exactly!"
msgstr "내 말이!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Player
#. NodeID = 09b21b23-9eb4-eda6-cd17-6e6d49570edf
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_DARK_URGE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:09b21b23-9eb4-eda6-cd17-6e6d49570edf
msgctxt "h22f4058cg2b79g485egbe80g5d589ec27d41"
msgid ""
"How can you make <i>plans</i>? I can't remember what I ate for breakfast."
msgstr "<i>계획</i> 세울 여유가 있다고? 난 오늘 아침에 뭘 먹었는지도 기억 안 나는 판인데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Player
#. NodeID = 09b21b23-9eb4-eda6-cd17-6e6d49570edf
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:09b21b23-9eb4-eda6-cd17-6e6d49570edf
msgctxt "h4e1a8026g1499g40c2ga07ag96398b98da80"
msgid "Plans? Just surviving the journey is ambitious enough already."
msgstr "뭔 계획? 가는 길에 죽지나 말자만 해도 꿈이 크네 싶을 지경인데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Danis
#. NodeID = 0b17e58f-6653-675e-ae27-4741b0e01c1f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:0b17e58f-6653-675e-ae27-4741b0e01c1f
msgctxt "h4a3ba42fg8fb3g4098g899eg51e5928c63e0"
msgid "Thanks. I suppose we'll all need it."
msgstr "고마워. 우리 모두 다 그러면 좋겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Player
#. NodeID = 0bbbf00d-3b3c-03bc-f7d9-8160058ee94c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:0bbbf00d-3b3c-03bc-f7d9-8160058ee94c
msgctxt "hf90853a6gfb67g40d9g8be2gd81309a47239"
msgid "Sorry, didn't mean to interrupt. Good luck to you both."
msgstr "미안, 방해하려던 건 아니야. 둘 다 행운이 따르길 빌게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Danis
#. NodeID = 0fbf7354-e40c-a383-4d81-f31fd80146a0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:0fbf7354-e40c-a383-4d81-f31fd80146a0
msgctxt "hff97e2cag37b3g4afdg8bf9g53a75c9dc785"
msgid "No bother. We're just daydreaming, anyhow."
msgstr "괜찮아. 우리도 그냥 몽상 늘어놓은 것뿐이거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Danis
#. NodeID = 119eb626-6e54-2837-3edb-509a775d8e29
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:119eb626-6e54-2837-3edb-509a775d8e29
msgctxt "h9369fa78ga3bdg445ag9b2bg8775c3af7895"
msgid ""
"No harm in fantasizing about the future. Or don't they do that wherever "
"you're from?"
msgstr "미래에 대해 꿈 좀 꾼다고 나쁠 건 없잖아. 네가 온 데서는 그런 건 꿈도 못 꾸나 봐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Player
#. NodeID = 1ac017b0-56cb-7937-9b99-1042fc14bd67
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:1ac017b0-56cb-7937-9b99-1042fc14bd67
msgctxt "hc88dadffg18e2g4edcg8397g48b8d05439c1"
msgid "I won't be joining you."
msgstr "난 너희랑 같이 안 가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Danis
#. NodeID = 1ad3d7ef-b670-18ef-7091-5ed858cc7fbf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:1ad3d7ef-b670-18ef-7091-5ed858cc7fbf
msgctxt "h9c785138g7ef3g4b09ga7d1gb088bfe39146"
msgid ""
"If that's what we're offered, we'll take it. Everyone's got to start "
"somewhere."
msgstr "그거라도 주어진다면 얼마든지 받을 거야. 누구나 시작은 초라한 법이라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Player
#. NodeID = 1b40ff3c-c375-50f4-106d-42fd5680f0d5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:1b40ff3c-c375-50f4-106d-42fd5680f0d5
msgctxt "hfe86504dg6befg4e0egb21bgcb47b6f00234"
msgid ""
"Two tiefling refugees? You'll be lucky to get a square of dirt at a public "
"house."
msgstr "티플링 난민 둘이서? 술집 먼지바닥 한 평이라도 구하면 감지덕지일걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Danis
#. NodeID = 22e82a1b-879e-b66b-dae0-03392e78ca46
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:22e82a1b-879e-b66b-dae0-03392e78ca46
msgctxt "hfdf951a5g6526g4851gba3fg68fccabbf93b"
msgid "Gods... that sounds like <i>heaven.</i>"
msgstr "이야... 그거 <i>천국</i>이 따로 없겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Danis
#. NodeID = 2456036c-b0fa-ecc2-1b04-527d6a3c8d5e
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: ASTARION or GALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:2456036c-b0fa-ecc2-1b04-527d6a3c8d5e
msgctxt "hf25cd257ga7c7g44c1gbab7gf5c3ca5e14fa"
msgid "Of course! You're definitely invited. We'll make dinner."
msgstr "물론이지! 넌 언제나 환영이야. 우리가 저녁 대접할게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Danis
#. NodeID = 2456036c-b0fa-ecc2-1b04-527d6a3c8d5e
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:2456036c-b0fa-ecc2-1b04-527d6a3c8d5e
msgctxt "he5f8c41dg1333g410fgb4ccg383e8d4ae9dd"
msgid "I hope it's a happy reunion!"
msgstr "그 친구랑 즐거운 재회 되길 바라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Danis
#. NodeID = 2456036c-b0fa-ecc2-1b04-527d6a3c8d5e
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: UNKNOWN_TAG_308b1975
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:2456036c-b0fa-ecc2-1b04-527d6a3c8d5e
msgctxt "hddf4d0f8g6397g4372g8f7cge17bf28aab73"
msgid "Hah! You two will be busy, if half of what I hear is true."
msgstr "하! 그럼 바쁘게 지내겠네. 거기 소문이 절반만 맞더라도 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Danis
#. NodeID = 2456036c-b0fa-ecc2-1b04-527d6a3c8d5e
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:2456036c-b0fa-ecc2-1b04-527d6a3c8d5e
msgctxt "hcd6d29a8gfa7eg4c77gba81ga43fb48e792c"
msgid "You're lucky. We've no friends to turn to there. Just each other."
msgstr "운이 좋네. 우린 거기 의지할 친구가 없거든. 자기랑 나 서로 뿐이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Danis
#. NodeID = 2456036c-b0fa-ecc2-1b04-527d6a3c8d5e
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: WYLL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:2456036c-b0fa-ecc2-1b04-527d6a3c8d5e
msgctxt "h0a80312cgb5afg4551g98c7g7d6417481057"
msgid "May your ale be dark, and the loving sweet! "
msgstr "네 에일주는 진하고, 사랑은 달콤하길 바라! "

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Player
#. NodeID = 25b315ab-3b9b-1726-d8c6-c8ba351cd2a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:25b315ab-3b9b-1726-d8c6-c8ba351cd2a3
msgctxt "h74edb7bbgdf8dg468cg9a9cgdcc5c725afc6"
msgid "Ah, yes - I know the beasts. Insufficiently meaty."
msgstr "아, 그래. 그 짐승은 나도 알아. 살점이 별로 없던데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Danis
#. NodeID = 2811928c-d348-2fa8-5d3f-8c003db2f282
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:2811928c-d348-2fa8-5d3f-8c003db2f282
msgctxt "h7227c28fg1f46g4803g8a2cge88aecccbd19"
msgid "Sure. Yes. Queen Vlaakith and everything."
msgstr "어... 물론. 블라키스 여왕인지 뭔지 다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Player
#. NodeID = 2c7d27af-bf56-9731-545c-5de6b820252c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:2c7d27af-bf56-9731-545c-5de6b820252c
msgctxt "h51b0a68dg37ebg4608gbf66g6d1e24714905"
msgid "I have but one plan: to earn the favour of my beloved Queen Vlaakith."
msgstr "내 계획은 단 하나다. 경애하는 블라키스 여왕님의 총애를 받는 것이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Danis
#. NodeID = 33b25df7-f6ff-5422-64b3-04b0fd81fe86
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:33b25df7-f6ff-5422-64b3-04b0fd81fe86
msgctxt "h7168fa15g4102g4d96gace6g9c174b3a8b5f"
msgid "Let's start with one and see how it goes."
msgstr "일단 한 마리부터 키우고 두고보자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Player
#. NodeID = 38b7ffc0-b07e-cd11-00b5-043a72ed9091
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:38b7ffc0-b07e-cd11-00b5-043a72ed9091
msgctxt "hf2872540gd5cdg4063gba8egd1859a9cb203"
msgid "It is a beast of burden. It requires no name."
msgstr "노역용 짐승일 뿐이잖아. 이름 따위를 뭐하러 붙여?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Bex
#. NodeID = 3c855eb2-90b0-7f2f-b7b4-627f0d603d2d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:3c855eb2-90b0-7f2f-b7b4-627f0d603d2d
msgctxt "h6789df66g6be6g4442gb7d5gca2b5233aea6"
msgid "If we see you there, we'll get you a pint. For your finder's fee."
msgstr "거기서 그쪽 만나면 우리가 한 잔 쏠게. 소개해준 대가로 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Danis
#. NodeID = 43151ab0-7bc1-efc4-cf1d-57685fc63ed5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:43151ab0-7bc1-efc4-cf1d-57685fc63ed5
msgctxt "h2d65f545gef10g487cg8b01g4c10333a5e68"
msgid "Where are you from where there are no <i>cats</i>, by the by?"
msgstr "그나저나 어디서 왔길래 <i>고양이</i>를 모르는 거래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Bex
#. NodeID = 47bebedd-18d8-5e10-2dd5-9f711730c78d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:47bebedd-18d8-5e10-2dd5-9f711730c78d
msgctxt "h92d50014gc472g411dgbbdfg1f8180aa5f0e"
msgid ""
"Your spiced tea is <i>life-changing</i>. And I can bake up almond cakes "
"twenty at a time!"
msgstr "자기 향신료 차는 정말 <i>인생의 경험</i>이지. 나도 아몬드 케이크는 20개씩 거뜬히 구워낼 수 있고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Danis
#. NodeID = 4913f053-26b3-1cb7-e7a4-5bebd99f39e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:4913f053-26b3-1cb7-e7a4-5bebd99f39e2
msgctxt "hfef6c51egc5d9g4899g96bfg26ad728c8910"
msgid ""
"Rest a bit. We're leaving soon. You'll like Baldur's Gate. It's for all "
"sorts."
msgstr "좀 쉬어 둬. 우린 곧 떠날 거야. 너도 발더스 게이트 가면 맘에 들걸? 모두를 위한 도시래."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Bex
#. NodeID = 49308a50-5614-6034-8faf-fbb8a5ca21fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:49308a50-5614-6034-8faf-fbb8a5ca21fe
msgctxt "h33c8c41aga984g4bd7gb07bg3df1d6f1adfc"
msgid "Good luck to you. Wish us a little too. I think we'll all need it."
msgstr "행운을 빌어. 우리 행운도 빌어주고. 우리 모두 그게 필요할 테니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Bex
#. NodeID = 4961d890-867d-15ca-a1cb-84a37dcd4dc2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:4961d890-867d-15ca-a1cb-84a37dcd4dc2
msgctxt "hb056f80bgb84cg4db5ga2e9g62ac8400d9d8"
msgid "<i>Optimism, </i>my friend. Try it out."
msgstr "<i>긍정의 힘이지,</i> 친구. 너도 한번 가져 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Player
#. NodeID = 4d992a95-7ccf-491c-39da-1b77467918ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:4d992a95-7ccf-491c-39da-1b77467918ad
msgctxt "hffe926f7ga193g4505gb747g1f18b0cdaf34"
msgid "I am from a land far from here."
msgstr "여기서 멀리 떨어진 곳이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Player
#. NodeID = 4dfbccc6-a50d-ba92-2f0e-6454ca94df9e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:4dfbccc6-a50d-ba92-2f0e-6454ca94df9e
msgctxt "h0fe41e4bge0ebg4d68gb5ddg56dd7df76c41"
msgid "A vermin hunter? I approve."
msgstr "해수 사냥꾼이라? 그거 맘에 드네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Danis
#. NodeID = 4ec25649-534d-82a4-0fcc-9f0485fbf823
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:4ec25649-534d-82a4-0fcc-9f0485fbf823
msgctxt "h7799875fg6f3bg4037gbe70g457955f6a57e"
msgid "'Crack-<i>what'?</i> Gone gods, It's just a kitty-cat."
msgstr "크랙-<i>뭐?</i> 맙소사, 야옹이 이름에 뭔 유난이래."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Bex
#. NodeID = 57e9bbc3-eeb1-0b09-509a-fd6de59b1bc4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:57e9bbc3-eeb1-0b09-509a-fd6de59b1bc4
msgctxt "hf8e5a5b6g3671g4e20g89ebg888f629b5e47"
msgid ""
"A little orange cat! And a house with a little door so it can come and go as "
"it pleases."
msgstr "작은 주황색 고양이로 하자! 녀석이 마음껏 드나들 수 있게 작은 문 달린 집도 마련하고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Player
#. NodeID = 616d7788-649b-2bce-0e39-324af2419a83
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:616d7788-649b-2bce-0e39-324af2419a83
msgctxt "hcd34e683g8fdag4a5fgbe09g7dcd31c66984"
msgid "What use do you have of this creature?"
msgstr "그 생물은 어떤 일에 유용한데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Bex
#. NodeID = 66772e5d-1e27-f863-9a6e-0e82c67b9330
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:66772e5d-1e27-f863-9a6e-0e82c67b9330
msgctxt "hd5096770g7557g466ega775g9b94f68441e1"
msgid "Poor thing. You seem... tired."
msgstr "안됐네. 딱 보니... 지쳐 보여."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Danis
#. NodeID = 68b76ded-8a65-aa31-eb76-10ccee359f07
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:68b76ded-8a65-aa31-eb76-10ccee359f07
msgctxt "h44c3bef0gd552g4f19gad02ge0800caf08cb"
msgid "Luck's been on our side this far. No reason to think it'll run out now."
msgstr "지금까진 행운이 우릴 따라줬는걸. 지금 와서 그게 동날 것 같진 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Danis
#. NodeID = 6d6fbbb3-b89d-9c66-cb83-51e59b3c0ca3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:6d6fbbb3-b89d-9c66-cb83-51e59b3c0ca3
msgctxt "h38b0cc86g8c2ag4368ga4adgdfe73499ac00"
msgid "Hm. Right. Well, welcome to the Sword Coast."
msgstr "흠. 그렇구나. 그럼, 소드 코스트에 온 걸 환영해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Danis
#. NodeID = 6dd2dfd7-854d-e828-85f1-d50feef659cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:6dd2dfd7-854d-e828-85f1-d50feef659cf
msgctxt "hb452b872ge96ag4d4cgbdc8g014c756f0bf9"
msgid "They don't allow 'em in Baldur's Gate. Cats, though..."
msgstr "발더스 게이트에선 개 못 키우게 해. 고양이는 되지만!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Player
#. NodeID = 70d1c040-6c34-cc11-1eef-ad294d10d16d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:70d1c040-6c34-cc11-1eef-ad294d10d16d
msgctxt "h10087506g8246g4d34ga4f9g8383a6ed4725"
msgid "A pint and a clean room would do me a world of good."
msgstr "맥주 한잔 걸치고 깨끗한 방만 얻으면 더 바랄 게 없을듯해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Player
#. NodeID = 71b08124-f1e2-b5c9-8f77-00b660698d63
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(2) = False
#.      - BALDURIAN(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:71b08124-f1e2-b5c9-8f77-00b660698d63
msgctxt "hcee48520g678cg47d4g9767g6d72ffb834d0"
msgid "It's The Blushing Mermaid for me. Bit rough, but the ale's cheap."
msgstr "달아오른 인어에 가야지. 좀 험한 데긴 한데, 거기 에일주가 싸거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Bex
#. NodeID = 82664c2b-6cac-c7fa-0bd8-26aead3af739
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:82664c2b-6cac-c7fa-0bd8-26aead3af739
msgctxt "h9ae2f524gc9dcg44a4gaca1g964752e2e6a1"
msgid ""
"I think I've heard of that place. Something about a stuffed dragon's head in "
"one of the dining rooms..."
msgstr "나 거기 얘기 들어본 것 같아. 식당에 드래곤 머리 박제가 걸려 있다던가 뭐 그렇다던데..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Player
#. NodeID = 832b3125-497b-58a2-452a-231eda05c689
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:832b3125-497b-58a2-452a-231eda05c689
msgctxt "hbd33b6c6g254eg49aag8acag42313e50a6e6"
msgid ""
"I'm worried the Baldurians are going to rob me for all I'm worth. I'm quite "
"clueless."
msgstr "발더스 사람들이 날 홀라당 털어먹는 거 아닐지가 걱정이야. 난 아무것도 모르거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Danis
#. NodeID = 8aeb9581-3eec-ed11-4dbf-415532618c78
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:8aeb9581-3eec-ed11-4dbf-415532618c78
msgctxt "h5f21b5adg7502g4e32gb2fag0e7da3e864a6"
msgid "No problem."
msgstr "알아들었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Player
#. NodeID = 91207e87-e710-cabf-1146-3896dfe34ec4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:91207e87-e710-cabf-1146-3896dfe34ec4
msgctxt "h49f62299gb2bdg4e74gb539g0ee51bbc268f"
msgid "Idle chatter. Have you nothing better to do?"
msgstr "수다 참 한가롭군. 달리 할 일이 없는 거냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Danis
#. NodeID = 98553150-70af-97c7-2a60-3444e5f151b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:98553150-70af-97c7-2a60-3444e5f151b6
msgctxt "h93e508b8g57a7g4f76g8775gbc509f33fe1c"
msgid "Oh really? What do you suggest then?"
msgstr "아, 그러셔? 그럼 넌 뭐로 지을 건데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Danis
#. NodeID = 9b48feb3-019f-b355-d557-e08d5a9a25fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:9b48feb3-019f-b355-d557-e08d5a9a25fd
msgctxt "h7025ff9egd9ebg4dadg8e49g07cfbf1f83e5"
msgid "... and a high fence to keep eavesdroppers out."
msgstr "...엿듣는 사람 막아줄 울타리도 높이 치고 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Danis
#. NodeID = 9f5e3f83-ebf0-8f89-5dbb-ba5a6b7c641c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:9f5e3f83-ebf0-8f89-5dbb-ba5a6b7c641c
msgctxt "h21c7b417g2a36g41dfg98f5g06e5e22d4dc4"
msgid "Oh. That's too bad. I'd heard you were good in a fight."
msgstr "아, 그거 참 아쉽네. 싸움 실력이 좋다고 들었는데 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Player
#. NodeID = a2ca408c-79d0-2f3e-4acc-c6cb606e9cce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:a2ca408c-79d0-2f3e-4acc-c6cb606e9cce
msgctxt "h636bf785gd098g4e1bg828ag427766ab3c23"
msgid "I couldn't say. Only <i>varsh</i> name githyanki young."
msgstr "그건 내 소관이 아니야. 어린 기스양키의 이름은 오직 <i>바쉬</i>만이 정하니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Player
#. NodeID = a4513579-8250-b9ec-4a8f-d017d327b02e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:a4513579-8250-b9ec-4a8f-d017d327b02e
msgctxt "h6720254fg00acg4e75g9898g768393383370"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Danis
#. NodeID = a674d4f0-2f92-0bbb-6cf2-93844335c4f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:a674d4f0-2f92-0bbb-6cf2-93844335c4f5
msgctxt "h04756ca7g0d4fg4ec8g85e1g1d5821574f76"
msgid "'Geoffrey' it is."
msgstr "그럼 '제프리'로 해야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Danis
#. NodeID = aa9a4c36-380d-5203-e10f-ce0647c1873f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:aa9a4c36-380d-5203-e10f-ce0647c1873f
msgctxt "h54b37c01g06c0g468eg8f35g6bb12422b185"
msgid "Beast of burden? It's a kitty-cat, not a rothé."
msgstr "노역용 짐승이라니? 이건 야옹이 얘기라고. 로테가 아니라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Player
#. NodeID = ac8f28bf-6905-ff12-e801-ae7ab4597aa0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:ac8f28bf-6905-ff12-e801-ae7ab4597aa0
msgctxt "hf44fe38dgb4b6g438dg9383gc64dbecc5060"
msgid "Good luck on your journey."
msgstr "너희 여정에 행운이 있길 바라지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Player
#. NodeID = ad30e049-54cc-337a-7c80-ff21a5660bb6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(2) = False
#. TagRule: REALLY_DEEPGNOME or REALLY_DRAGONBORN or REALLY_DUERGARDWARF or REALLY_RARE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:ad30e049-54cc-337a-7c80-ff21a5660bb6
msgctxt "hd58ea25dg8e3cg40bag8173g86a4968d79b8"
msgid "I'll be keeping to myself. People tend to stare at me."
msgstr "남들 눈에 띄지 않을 생각이야. 사람들은 날 따갑게 쳐다보곤 하거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Player
#. NodeID = b2a77150-3b44-c94b-3d0d-2c580afd6064
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:b2a77150-3b44-c94b-3d0d-2c580afd6064
msgctxt "h96c5c332g6ed3g4755ga8f7gfa1242f2b2f2"
msgid "Are you <i>attracted</i> to these... cats?"
msgstr "넌 그 고양이란 거에... <i>끌리는 거냐</i>?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Bex
#. NodeID = b8e45f5d-b07b-451a-bfe6-b22a755f9a88
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:b8e45f5d-b07b-451a-bfe6-b22a755f9a88
msgctxt "ha7720ccegb14fg437eg874ege029d9abe1be"
msgid "They're not fantasies. They're plans!"
msgstr "나한텐 꿈이 아닌데. 계획이라고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Bex
#. NodeID = ba9e5ba1-955e-3131-41fe-5034709edaab
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_YoungLover1_2_ExplainedCatsToGithPlayer(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:ba9e5ba1-955e-3131-41fe-5034709edaab
msgctxt "he9be6359gbd46g4cabga03dg63622f45b56c"
msgid "Small. Whiskers. 'Meow meow'. You know. <i>Cat.</i>"
msgstr "작고. 수염 달린. '냥냥'거리는. 그 있잖아. <i>고양이.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Player
#. NodeID = bc8a0038-6add-301d-1357-7ba2312c7c6b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(2) = False
#.      - BALDURIAN(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:bc8a0038-6add-301d-1357-7ba2312c7c6b
msgctxt "h952a9c1cga20bg4a87g9b92g1ee24f522459"
msgid "I'll be seeking the warmth of the Elfsong Tavern."
msgstr "엘프송 여관의 온기를 누리러 가 볼 생각이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Bex
#. NodeID = bda0d568-7f17-1968-1415-5b6d245486fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:bda0d568-7f17-1968-1415-5b6d245486fe
msgctxt "h6be02656gf441g4d06g8684g5e8117afcc36"
msgid ""
"It's settled, Danis. You, me, and the Elfsong Tavern, first thing when we "
"arrive."
msgstr "결정됐네, 다니스. 너랑 나, 도시에 도착하면 엘프송 여관에 바로 가는 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Player
#. NodeID = be1bc714-2e3f-a77e-75c4-c401a2f76934
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:be1bc714-2e3f-a77e-75c4-c401a2f76934
msgctxt "he1fe1b31gaad4g4886g979ag8b21db176363"
msgid "I aim to purge the parasite infecting my brain."
msgstr "내 계획은 내 뇌에 침투한 기생충을 정화하는 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Narrator
#. NodeID = bedfeabf-4e34-64e8-7a58-51a28e0fa0c7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(2) = True
#. SetFlags:
#.   Object:
#.     - ORI_DarkUrge_Event_HadUrge(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:bedfeabf-4e34-64e8-7a58-51a28e0fa0c7
msgctxt "he397b91eg68bbg46b1g9748g61f06fdb122f"
msgid ""
"*Surely destined for the slaughter. What would be more perfect than to die "
"by your love's side, and know love was not enough?*"
msgstr "*저런 자들이 꼭 도살될 팔자죠. 사랑은 만능이 아니란 걸 깨달으며, 죽음을 맞는 연인들의 모습보다 볼 만한 게 또 있을까요?*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Bex
#. NodeID = bf6ddec2-74e6-8fb9-d1d1-325984651fb7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:bf6ddec2-74e6-8fb9-d1d1-325984651fb7
msgctxt "h944360cfg2e72g414dg9c3egab5ab0e10b21"
msgid "What about you? Big plans for when you get to the city?"
msgstr "그쪽은 어때? 도시에 가면 어떡할지 계획 세운 거 있어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Player
#. NodeID = c0e7e58c-8a65-6098-62d7-a64b31fa9590
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:c0e7e58c-8a65-6098-62d7-a64b31fa9590
msgctxt "h10471e6dgc3abg41e6gad72gc24ca5db85db"
msgid "Don't mind me. I was just passing through."
msgstr "난 신경 쓰지 마. 그냥 지나가던 길이었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Player
#. NodeID = c98ef35d-0c08-ffb2-c802-39bfa123a3b8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:c98ef35d-0c08-ffb2-c802-39bfa123a3b8
msgctxt "h45dec093g578fg4476g87f3g99f59c52e63b"
msgid "Hm - I think you mean 'gnome'."
msgstr "흠, 들어보니 '노움' 얘기인 거 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Bex
#. NodeID = cafdf098-f72f-e187-1aa9-1f6de0ed3c19
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:cafdf098-f72f-e187-1aa9-1f6de0ed3c19
msgctxt "he22eccfbgcea0g4da5g843ag24af10902791"
msgid ""
"Look - whoever you are, whatever you're into, you'll find it in Baldur's "
"Gate. <i>I </i>only have eyes for this one here."
msgstr ""
"저기, 네가 누구고 취향이 어떻든 간에, 그런 건 발더스 게이트에서 찾아 봐. <i>내가 </i>원하는 건 여기 이 사람 뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Bex
#. NodeID = cda45086-7e01-4625-fb38-ce5bd2fe5fbc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:cda45086-7e01-4625-fb38-ce5bd2fe5fbc
msgctxt "hf23c9c64g628eg412cg86d4g29fbca82e924"
msgid "'Geoffrey' is great. Let's go with that."
msgstr "'제프리' 가 딱 좋네. 그걸로 하자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Player
#. NodeID = cebd0e9d-3eac-630d-1ae4-d56535238e6a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:cebd0e9d-3eac-630d-1ae4-d56535238e6a
msgctxt "hadeac3b6gb22cg4188g8023g067802ffb83b"
msgid "I want a new life, entirely. To be a wholly new person."
msgstr "난 완전히 새로운 삶을 원해. 아예 새사람으로 거듭나는 거지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Bex
#. NodeID = cf99c87a-4ed8-257b-ccb7-43f1d52d2b42
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:cf99c87a-4ed8-257b-ccb7-43f1d52d2b42
msgctxt "h75648dcbg046bg4c1dg9020gce8f8b8841a6"
msgid "Do we ever."
msgstr "우린 일상이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Player
#. NodeID = d129a80b-a301-0dad-e938-76961a39e834
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(2) = True
#. SetFlags:
#.   Global:
#.     - ORI_State_DarkUrge_PromiseArson = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:d129a80b-a301-0dad-e938-76961a39e834
msgctxt "hb366836eg68a3g43fcgad79gafed91a6a802"
msgid ""
"Knowing me, there is a high chance I will start a fire and be sent to jail."
msgstr "내가 나 자신을 좀 아는데, 아마 높은 확률로 난장판 만들고 감옥에 가게 될 것 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Bex
#. NodeID = d4a9be37-98ca-24ca-b43e-5b3281f42e2a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:d4a9be37-98ca-24ca-b43e-5b3281f42e2a
msgctxt "h06cb97c3g8e85g40b7gb224g850d03f7936d"
msgid ""
"Come with us to Baldur's Gate. If <i>cats </i>are new to you, you won't "
"believe what you'll find there."
msgstr "우리랑 같이 발더스 게이트로 가자. <i>고양이가 </i>낯설 정도라면, 거기서 보게 될 건 놀라 까무러칠걸?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Player
#. NodeID = d50feb79-327f-ffc1-c793-91c278f974a9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GENERIC(2) = False
#. TagRule: ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:d50feb79-327f-ffc1-c793-91c278f974a9
msgctxt "h11674483g5974g45e5ga08bg8e74206d7c43"
msgid "Well - I could always stop by your place for a bite."
msgstr "뭐, 한입 얻어먹으러 너희한테 들러 볼 수도 있겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Player
#. NodeID = d50feb79-327f-ffc1-c793-91c278f974a9
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GENERIC(2) = False
#. TagRule: KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:d50feb79-327f-ffc1-c793-91c278f974a9
msgctxt "h706fb3e1g2774g4243g8355g01e68df2a681"
msgid "I'll be tracking down an old friend."
msgstr "옛 친구를 찾아갈 계획이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Player
#. NodeID = d50feb79-327f-ffc1-c793-91c278f974a9
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GENERIC(2) = False
#. TagRule: UNKNOWN_TAG_308b1975
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:d50feb79-327f-ffc1-c793-91c278f974a9
msgctxt "h20e47fbdgb8e1g4c97g9aa8gc76d238eeccd"
msgid "My hamster and I will save it from corruption. Again!"
msgstr "내 햄스터랑 함께 발더스 게이트를 악에서 구해내야지! 한번 더!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Player
#. NodeID = d50feb79-327f-ffc1-c793-91c278f974a9
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GENERIC(2) = False
#. TagRule: SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:d50feb79-327f-ffc1-c793-91c278f974a9
msgctxt "hac8545dcgfcacg4f98g963egb781084ec79f"
msgid "I have... friends awaiting me."
msgstr "날 기다리는... 친구들이 있긴 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Player
#. NodeID = d50feb79-327f-ffc1-c793-91c278f974a9
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GENERIC(2) = False
#. TagRule: WYLL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:d50feb79-327f-ffc1-c793-91c278f974a9
msgctxt "h8690b34bgf56ag43b7g9f5dg261e8011da24"
msgid "A pint of ale and a warm companion are my first priorities."
msgstr "에일주 한잔 걸치고 어느 따뜻한 품에 안기는 게 내 최우선 목표지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Player
#. NodeID = d50feb79-327f-ffc1-c793-91c278f974a9
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GENERIC(2) = False
#. TagRule: GALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:d50feb79-327f-ffc1-c793-91c278f974a9
msgctxt "he4bbaf2dg89a7g4b36gbee7gef016c3598bf"
msgid "I've never been to Baldur's Gate before. Perhaps I can drop in on you."
msgstr "발더스 게이트는 아직 한번도 안 가봤거든. 너희한테 들러볼 수도 있겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Danis
#. NodeID = d56737c1-6e5e-ba7a-189c-c1ed915860fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:d56737c1-6e5e-ba7a-189c-c1ed915860fe
msgctxt "hdd96fb2fg2ae4g4603g9f6ag942260f29304"
msgid "Yes. Over there."
msgstr "맞아. 그랬었지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Bex
#. NodeID = d8b165b7-138f-4259-882e-b30ebbc1a67e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:d8b165b7-138f-4259-882e-b30ebbc1a67e
msgctxt "h7ace3ff8g42e9g4f51ga429gf396be1ba807"
msgid "Won't be long now. One more trip, then we can <i>really </i>rest."
msgstr "얼마 안 남았어. 길 한 번만 더 나서면, <i>제대로 </i>쉬게 될 거라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Bex
#. NodeID = da4155d5-eabd-a8ae-c736-5fe3b6c728ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:da4155d5-eabd-a8ae-c736-5fe3b6c728ae
msgctxt "hc206898eg8be7g4a97gb48ag6ea57a56cf3a"
msgid "Can we get two?"
msgstr "두 마리 키울까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Danis
#. NodeID = da74bc84-241a-e114-ba1a-477375bc14f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:da74bc84-241a-e114-ba1a-477375bc14f4
msgctxt "h18142942g13c6g4688g93b5g524fff43034a"
msgid ""
"I figured. But no matter. We're going to make ourselves a new home in "
"Baldur's Gate. You can too."
msgstr "그럴 거 같더라. 그래도 괜찮아. 우리는 발더스 게이트에서 새로운 보금자리를 만들 거야. 너도 가능하다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Player
#. NodeID = dc6705c4-9668-3e53-a12a-fb9d55aa8704
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:dc6705c4-9668-3e53-a12a-fb9d55aa8704
msgctxt "h70049032g2b1dg4402gbf69g51465ed9990d"
msgid "'Geoffrey?' A weak name. Insipid."
msgstr "'제프리?' 약해빠지고 시시한 이름이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Danis
#. NodeID = dcc8e81f-7ae3-26d7-137d-a4d35f48c717
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:dcc8e81f-7ae3-26d7-137d-a4d35f48c717
msgctxt "h6efba0dfg252dg42b5g8f73g6a0bc192d6dd"
msgid "Know what you mean."
msgstr "그 기분 나도 알아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Bex
#. NodeID = debe88d0-aad9-b9af-24a9-466fad4b993d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:debe88d0-aad9-b9af-24a9-466fad4b993d
msgctxt "h2cd2d041gb693g410fga023g5faa2ef6cbff"
msgid "I'm... sure you'll do just that. Right, Danis?"
msgstr "너라면... 뭐 잘 해낼 거 같네. 그치, 다니스?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Danis
#. NodeID = df085de3-bdc4-acdc-889e-fea91840585c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:df085de3-bdc4-acdc-889e-fea91840585c
msgctxt "he1be11c5gcb6fg4570ga75dgdfbac87ebcfa"
msgid "Where were we, love? A cat and a house with a porch..."
msgstr "어디까지 얘기했더라, 자기야? 아, 고양이랑 걔 전용 문 딸린 집이었지..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Bex
#. NodeID = e51beaa7-ae24-7928-ac68-b0357a9c4e02
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:e51beaa7-ae24-7928-ac68-b0357a9c4e02
msgctxt "h342e3dfag426fg4570gac39gf55fba3c326c"
msgid ""
"Travel with us, if you like. Maybe we can show you to squirrels and ducks on "
"the way."
msgstr "너만 괜찮다면 우리랑 같이 가자. 가는 길에 오리랑 다람쥐 보이면 구경시켜 줄게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Bex
#. NodeID = e7008618-4a3a-d8ba-8d24-adcc79423edd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:e7008618-4a3a-d8ba-8d24-adcc79423edd
msgctxt "h77914548g1315g45d5g84b6g46093d243c72"
msgid ""
"Right. Erm. Danis, we've got to do the thing... in the place... over there. "
"Remember?"
msgstr "그래, 음... 다니스, 우리 저기 저쪽에서... 할일 있었던 거 같은데... 기억나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Player
#. NodeID = e79703c7-fb38-09fc-6b6d-8b8850ff31e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:e79703c7-fb38-09fc-6b6d-8b8850ff31e7
msgctxt "hf40212bdgdc8bg46e1g9558g592eae0e4246"
msgid "That's no concern of yours."
msgstr "그건 네 알 바 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Player
#. NodeID = e7bbc3d8-1441-1420-7bcd-8dd5101461b5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:e7bbc3d8-1441-1420-7bcd-8dd5101461b5
msgctxt "h0dde7f67g240ag4c17g9f5cg1ed8702c59a8"
msgid "A powerful githyanki name should suffice: 'Krak'jthak'."
msgstr "강력한 기스양키식 이름이 알맞겠군. '크라크즈타크'."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Danis
#. NodeID = eaa9c9f8-2e94-010e-c767-45469064b0ca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:eaa9c9f8-2e94-010e-c767-45469064b0ca
msgctxt "h9f447dbfgfbffg48c5g8eecgec806638e731"
msgid ""
"But... I've heard there's all sorts in the city. It might not be like it was "
"in Elturel. I mean - in Baldur's Gate, they give you a chance."
msgstr ""
"그치만... 그 도시엔 온갖 사람이 다 있다고 들었어. 엘투렐이랑은 대접이 다를지도 모른다고. 내 말은, 발더스 게이트에선 기회를 준다 "
"이거지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Danis
#. NodeID = ebab552a-7678-a298-6334-6e9791dccd08
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:ebab552a-7678-a298-6334-6e9791dccd08
msgctxt "h7393ec84g0f97g4db9g8288g73fc27c3c362"
msgid "You heard him, love."
msgstr "알아들었잖아, 자기야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Danis
#. NodeID = ebab552a-7678-a298-6334-6e9791dccd08
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:ebab552a-7678-a298-6334-6e9791dccd08
msgctxt "h1ad82807ga514g4d4cga8f6g86e053408b35"
msgid "You heard her, love."
msgstr "알아들었잖아, 자기야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Danis
#. NodeID = ebab552a-7678-a298-6334-6e9791dccd08
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:ebab552a-7678-a298-6334-6e9791dccd08
msgctxt "hb16ce197g7b13g4f09ga5dage92d4c3aa38e"
msgid "You heard them, love."
msgstr "알아들었잖아, 자기야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Danis
#. NodeID = ec167a98-ea27-a079-e854-75897a5b15d1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:ec167a98-ea27-a079-e854-75897a5b15d1
msgctxt "h4c4715deg351cg4667gad8cg0729a555fa99"
msgid "What'll we name it? I like 'Geoffrey.'"
msgstr "뭐라고 부르면 좋을까? 난 '제프리'가 좋을 것 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Player
#. NodeID = ee74393c-b5fd-e660-35b7-5dae45d37e54
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:ee74393c-b5fd-e660-35b7-5dae45d37e54
msgctxt "h1dd83785gb6cbg46dag97e2g4dd9c9900df6"
msgid "I hail from another plane. Is that not obvious?"
msgstr "나는 다른 차원 출신인데. 딱 보면 모르냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Danis
#. NodeID = f2a26f74-9eaf-f7e3-32d6-f776986e59b0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:f2a26f74-9eaf-f7e3-32d6-f776986e59b0
msgctxt "hfef488ffg976dg41d2g9cdcg81a83a4b5a1c"
msgid "We've had enough <i>rough </i>to last us a good long while."
msgstr "우린 <i>험한 </i> 건 질리도록 겪었으니 거긴 피해야겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Bex
#. NodeID = f50108a0-ea8e-38de-804c-252ec89410f6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:f50108a0-ea8e-38de-804c-252ec89410f6
msgctxt "hf5fc8e94g2ad3g4f92g823ag1ca16568aa40"
msgid "Well, they're excellent mousers. And their little faces are so cute!"
msgstr "음, 걔들은 쥐잡이 전문가야. 또 얼굴이 작은데 그게 엄청 귀여워!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Bex
#. NodeID = f77e42fe-9284-fca6-f6f2-59c924a09357
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_General_YoungLovers_HasMet(2) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_General_YoungLovers_HasMet(2) = True
#.   Global:
#.     - DEN_YoungLovers_State_MetPlayer = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:f77e42fe-9284-fca6-f6f2-59c924a09357
msgctxt "h07ca064cg751dg41f1ga98agc3766c78192a"
msgid "And we'll have a dog, right?"
msgstr "그리고 개도 하나 키우자, 응?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2
#. Speaker = Danis
#. NodeID = fc50e1d8-13f3-c465-034d-0dc274a8f03d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover1_2:fc50e1d8-13f3-c465-034d-0dc274a8f03d
msgctxt "h516a9677gb9dag4446ga2beg0349311bc4b2"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover_1
#. Speaker = Danis
#. NodeID = 6ceacaee-5f30-036e-c591-b98ab6bafc6b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_General_YoungLover_1_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover_1:6ceacaee-5f30-036e-c591-b98ab6bafc6b
msgctxt "h495002a7g7380g4c67g8b2bg61bc07473a16"
msgid "I don't want to wait around here longer than we have to."
msgstr "괜히 이곳에서 오래 밍기적거리고 싶진 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover_1
#. Speaker = Danis
