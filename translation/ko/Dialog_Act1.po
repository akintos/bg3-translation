msgstr "<i>투우치, 투우치, 투우치</i>!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WaitingCunning
#. Speaker = Sharp-Eye Nass
#. NodeID = 3f75383a-b95c-5647-6f5c-d900be120b06
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WaitingCunning:3f75383a-b95c-5647-6f5c-d900be120b06
msgctxt "he128ead1g23c4g4231g9004g6bd33dab745b"
msgid "Nobody's gonna lay a finger on me. Not this time!"
msgstr "누구도 내 털끝 하나 못 건드려. 지금은!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WaitingGrumpy
#. Speaker = Zurga
#. NodeID = 36442f0b-d7f1-f191-ea44-da049b57e208
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WaitingGrumpy:36442f0b-d7f1-f191-ea44-da049b57e208
msgctxt "h908f9420gd455g4211g8755g080118b50db5"
