msgctxt "hff6d0abeg1960g4858g8ab0gb17c8f20f40f"
msgid "<i>Coward.</i>"
msgstr "<i>겁쟁이.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene
#. Speaker = Nymessa
#. NodeID = b75f8a11-1fd5-cdc6-08ac-3f8700170c43
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DROWELF(3) = True
