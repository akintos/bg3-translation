msgctxt "h3257a774ga294g4a41g9881g24bd77be5330"
msgid "You've got a <i>lovely</i> singing voice, Baz..."
msgstr "너 노래할 때 내는 목소리 정말 <i>좋다</i>, 바즈..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Brewery_AD_DrunkCheering
#. Speaker = Kobold Scout
#. NodeID = 4df64ce4-b6b1-4d3f-abe9-032fb32a6101
