msgctxt "h22ac8124g9b8dg47bbg90aag180a0907411a"
msgid "Maybe I went a little too far..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PaladinsOfTyr_AvatarKarlachAfterEnrage
#. Speaker = Karlach
#. NodeID = 8ba58304-c0b3-4c3b-9536-7b47bbc9c960
