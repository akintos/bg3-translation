msgctxt "h7cda8474g413eg4a2ag9693g7c37f48a911d"
msgid "Right time, right place. You done the Abolute proud."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarLoyalGuard_02
#. Speaker = Dalthar
#. NodeID = fabe85e0-4767-8298-2b12-e825826d45a1
