msgctxt "hc7dc9ccagf38dg4cd1g95beg47646d98447f"
msgid "*The corpse does not stir. It will answer no more questions.*"
msgstr "*시체는 움직이지 않습니다. 더 이상 질문을 받지 않을 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithCaptain_Dead
#. Speaker = Narrator
#. NodeID = d87f5667-48e2-470e-b040-c963e4aa6fdf
