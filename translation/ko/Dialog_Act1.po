msgctxt "hcd3e575ag678bg4bcagb254g55b8fb73e5cc"
msgid "Holy hells. <i>Under-dwarf.</i>"
msgstr "이런 망할. <i>언더 드워프잖아.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene
