msgid "I told you to leave that alone!"
msgstr "가만히 내버려 두라고 했잖아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_002_Crime
#. Speaker = Olly
#. NodeID = 0671cb18-83e9-ec8d-fc2f-d4100199f52c
