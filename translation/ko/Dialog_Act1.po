#.      - CHA_LaezelRecruitment_MindMeld(3) = False
#.   Global:
#.      - TUT_TransformChamber_State_TriedToFree = False
#.   Local:
#.      - 4b9219b6-9074-0463-e4e0-1ff4c30e087b_SkippedHelp = False
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene:9bbf1769-161e-5977-0288-92203627cf30
msgctxt "hc5bbd9c8g214fg4912g8f80g92aa00fc5ec3"
msgid "<i>Why should I help you?</i>"
msgstr "<i>내가 왜 널 도와야 하지?</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene
#. Speaker = Damays
#. NodeID = 9d6de32e-9833-5af3-42fb-fbc84bdca716
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_LaezelRecruitment_Event_BothTieflingsLowerTrap = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene:9d6de32e-9833-5af3-42fb-fbc84bdca716
msgctxt "hccd9264ag32e2g45bbg815ag909626f7f98c"
msgid "Lower the trap, Nymessa. This creature must die."
msgstr "함정을 떨궈, 나이메사. 저 존재는 죽어야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene
#. Speaker = Damays
#. NodeID = 9eb62384-83b1-7554-9992-c6aba2f5b18d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene:9eb62384-83b1-7554-9992-c6aba2f5b18d
msgctxt "h63fc4e11gaf18g48f8g8297ga88771077589"
msgid "Find refuge elsewhere. We've enough mouths to feed."
msgstr "피난처라면 딴 곳 알아봐. 먹일 입 더 느는 건 사절이라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene
#. Speaker = Player
#. NodeID = 9f03da7c-e4f1-e142-2ea4-0fcc2c8b32ac
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(3) = True
#.      - REALLY_SHADOWHEART(3) = False
#. SetFlags:
#.   Local:
#.     - 4b9219b6-9074-0463-e4e0-1ff4c30e087b_SkippedHelp = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene:9f03da7c-e4f1-e142-2ea4-0fcc2c8b32ac
msgctxt "h525e70a4g75ecg451bgba85ge4134d922c1a"
msgid "Shoot the trap down. I'll tear it apart before anyone else gets hurt."
msgstr "함정을 쏴 떨어뜨려. 저게 누군가를 해치기 전에 내가 찢어발겨주겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene
#. Speaker = Damays
#. NodeID = a379a495-db35-3db0-e469-3122deb77b0f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CHA_LaezelRecruitment_Event_TieflingPullsLevel = True
#.     - CHA_LaezelRecruitment_Event_PersuadedKillLaezel = True
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene:a379a495-db35-3db0-e469-3122deb77b0f
msgctxt "h3cb5eeb8g5f62g4836g9945g35cea941fcfe"
msgid "He's right. No one's safe if that thing goes loose. Not even us."
msgstr "맞는 말이군. 저게 도망이라도 치면 모두가 위험해지겠지. 우리도 그렇고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene
#. Speaker = Damays
#. NodeID = a379a495-db35-3db0-e469-3122deb77b0f
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Global:
