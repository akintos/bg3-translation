msgctxt "h8f307bcfg454fg41c2gbd5fg3ce3ce20b1e7"
msgid "That voice! Ambrosia... Sing on!"
msgstr "이 목소리! 천상의 노래 같군... 계속해 줘!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerCharmed
