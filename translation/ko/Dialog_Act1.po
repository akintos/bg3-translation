msgctxt "h4c1a3ba4g8405g412ag934agc07f9f47529b"
msgid "You better sober up."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Adventurer
#. Speaker = Smythin
#. NodeID = 583751df-cc7a-c910-002e-284c773504ee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Adventurer:583751df-cc7a-c910-002e-284c773504ee
msgctxt "h9b469c82gd03bg4cdaga322gcfbb8e285655"
msgid "Thanks. I thought I was done for."
msgstr "고마워. 난 끝장났다고 생각했는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 901da8fc-80d9-b243-f892-2abb6a2b0413
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_CapturedGoblin:901da8fc-80d9-b243-f892-2abb6a2b0413
msgctxt "hb16018a2g23b9g4906ga049gd6d5d7eabf6a"
msgid ""
"Let me go. I'll sneak off and become a hermit - won't cause trouble for "
"nobody."
msgstr "풀어줘. 몰래 나간 다음 찌그러져서 지낼 테니까 - 아무 문제 안 일으킬게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders
#. Speaker = Player
#. NodeID = 05dc5b96-0ba7-38d6-1ab1-bb9ab652ca61
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders:05dc5b96-0ba7-38d6-1ab1-bb9ab652ca61
msgctxt "h0b5cac47gd6f0g4278gb122gf7a17da94a77"
msgid "Stay here. Be still."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders
#. Speaker = Player
#. NodeID = 0b44e24e-2113-2c2c-11e3-8faa20b35908
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders:0b44e24e-2113-2c2c-11e3-8faa20b35908
msgctxt "hcf60cae8g440dg4287g909cgbc596cdc9bf3"
msgid "Tell me more about this place."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders
#. Speaker = Narrator
#. NodeID = 0defa075-092b-8b1d-e0b3-bd960863dcba
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders:0defa075-092b-8b1d-e0b3-bd960863dcba
msgctxt "h3c69f26fgc37eg4841g9e0bg3560bae1754d"
msgid "*Shaking with the goddess' fury, the spider shrieks, then attacks.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders
#. Speaker = Narrator
#. NodeID = 14602c72-cc33-8ef6-b294-535fcf5fb0f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders:14602c72-cc33-8ef6-b294-535fcf5fb0f8
msgctxt "hfe2f19f0gb8cbg4315g81e9gbfc0ff67bc15"
msgid "*It hadn't occurred to you that Lolth might be listening.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders
#. Speaker = Narrator
#. NodeID = 1e68f08b-2869-f429-f70a-72e962ced25e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders:1e68f08b-2869-f429-f70a-72e962ced25e
msgctxt "hbe8ea440gcdccg447ag891eg543c49151919"
msgid "*She scuttles toward you, drooling.*"
msgstr "*그녀는 침 흘리며 당신에게 다가옵니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders
#. Speaker = Larger Giant Spider
#. NodeID = 1e8194d8-f9c9-3d4c-3b1e-e2c7b1a93e8e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_SpiderNest_State_SpidersChill = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders:1e8194d8-f9c9-3d4c-3b1e-e2c7b1a93e8e
msgctxt "hcba72255gcad6g4c5fg93bag1827f03c1cdd"
msgid "*Ssssss.*"
msgstr "*스으-.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders
#. Speaker = Player
#. NodeID = 2c70d2a2-f1be-0d83-cd8b-1502741e3ca0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_SpiderNest_Spiders_PCPinnedByWeb(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders:2c70d2a2-f1be-0d83-cd8b-1502741e3ca0
msgctxt "hd94943f0g7e79g4a24g9c04g4ba44f1418ab"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders
#. Speaker = Narrator
#. NodeID = 36c5fbe6-fbb9-b5b3-60b4-4518e3b67c37
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_SpiderNest_State_DoorOpen = False
#. SetFlags:
#.   Global:
#.     - GOB_SpiderNest_State_SpidersChill = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders:36c5fbe6-fbb9-b5b3-60b4-4518e3b67c37
msgctxt "hf83e08f1gf248g42eegb368g6fa69d2d0b42"
msgid "*She looks to the closed door, drooling.*"
msgstr "*그녀는 군침을 흘리며 닫힌 문을 바라봅니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders
#. Speaker = Larger Giant Spider
#. NodeID = 457e3504-32cd-fc4a-cff1-4d7a0f03ffa4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders:457e3504-32cd-fc4a-cff1-4d7a0f03ffa4
msgctxt "h46ebb9c5g5c0fg4502g8e8fgc8902f661d93"
msgid "Yes, my desire. Closer, my sweet!"
msgstr "그래, 내 욕망. 더 가까이 오렴, 귀염둥아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders
#. Speaker = Player
#. NodeID = 4b69a14e-8429-c8b3-29df-f9ca2fb4aeaa
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - LOLTHDROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders:4b69a14e-8429-c8b3-29df-f9ca2fb4aeaa
msgctxt "hef230640g0095g4900g884eg093d1c6cd961"
msgid "How dare you. Do you not recognise me? Lolth, Queen of Spiders."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders
#. Speaker = Player
#. NodeID = 4ba95f07-474d-66f7-51cb-eb25e67c292d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders:4ba95f07-474d-66f7-51cb-eb25e67c292d
msgctxt "hc9105343g2ddbg4b0dgafd0g24e48a813af4"
msgid "Kill the goblins. They displease me."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders
#. Speaker = Larger Giant Spider
#. NodeID = 4cc48676-4b7c-bca3-2f27-d6a7258d22a1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders:4cc48676-4b7c-bca3-2f27-d6a7258d22a1
msgctxt "h99eab8e1g0387g43f5gbbfag72198b8d8c2c"
msgid "<i>You </i>must open the door."
msgstr "<i>네가 </i>문을 열어줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders
#. Speaker = Narrator
#. NodeID = 5660d2d5-bd53-df34-3058-990e316d8890
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders:5660d2d5-bd53-df34-3058-990e316d8890
msgctxt "h3bc9bdfag1efcg4c67g950dg242a94f19e9d"
msgid ""
"*Suddenly, a suffocating wave of divine rage surges through the spider pit.*"
msgstr "*갑자기, 숨막히는 신성한 분노의 파동이 거미굴을 휩쓸어버립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders
#. Speaker = Larger Giant Spider
#. NodeID = 5794806d-6908-4b53-6019-be0f0eace31a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_SpiderNest_State_DoorOpen = False
#. SetFlags:
#.   Global:
#.     - GOB_SpiderNest_State_SpidersChill = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders:5794806d-6908-4b53-6019-be0f0eace31a
msgctxt "h9af95ad8gbb96g44eeg9ac4g67d3b0e881c4"
msgid ""
"Delicious - I do not know. But cruel and sharp - yes. Bindable and wrappable "
"and biteable - yes."
msgstr "맛있나 - 그건 모르겠군. 하지만 잔인하고 날카롭나 - 그래. 구속하고 휘감고 물 수 있나 - 그래."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders
#. Speaker = Larger Giant Spider
#. NodeID = 5fc12986-b086-5c62-1672-5b16e43c0578
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_SpiderNest_Spiders_LolthPersuasion(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders:5fc12986-b086-5c62-1672-5b16e43c0578
msgctxt "he529ca2egb1d6g4710gac6dgeb7d46c9eb16"
msgid "Yes, my queen."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders
#. Speaker = Larger Giant Spider
#. NodeID = 60ea4b1c-0cdb-55ee-d41b-c3cec783897c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_SpiderNest_State_SpidersOut = True
#.      - GOB_SpiderNest_State_SpidersChill = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders:60ea4b1c-0cdb-55ee-d41b-c3cec783897c
msgctxt "hf228bca1g8f35g4c05gb98dg7bd0ac71b9b5"
msgid "Freedom."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders
#. Speaker = Narrator
#. NodeID = 610ce80b-2dd0-651c-a24a-ff3039092b56
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders:610ce80b-2dd0-651c-a24a-ff3039092b56
msgctxt "ha35b9eecgdaf3g4e35gbe06g34b034a0cb63"
msgid ""
"*The spider seems poised to attack, but she hesitates, tapping her claws as "
"if trying to communicate.*"
msgstr "*거미는 공격할 준비가 된 것 같지만, 의사소통을 하려는 듯이 발톱을 두드리며 기다립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders
#. Speaker = Player
#. NodeID = 6544ad3f-bb4a-d439-9f1e-794888a73186
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders:6544ad3f-bb4a-d439-9f1e-794888a73186
msgctxt "h69e046b5gfa16g4f6bg9345g58a23b108884"
msgid "Stay here for now."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders
#. Speaker = Larger Giant Spider
#. NodeID = 67ffba9b-1976-7a6c-7ab4-f2c030125e5d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_SpiderNest_State_SpidersChill = True
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders:67ffba9b-1976-7a6c-7ab4-f2c030125e5d
msgctxt "h9cdf87b0gcdfdg4182gb9a1g77ec56852ee4"
msgid "*Ssssk.*"
msgstr "*스으-크.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders
#. Speaker = Larger Giant Spider
#. NodeID = 68d9592d-5c32-48ed-9048-bbd9a792c7c5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders:68d9592d-5c32-48ed-9048-bbd9a792c7c5
msgctxt "h0690e5b5g86b0g4862gbe56g0ae89c80694a"
msgid "I will wrap you, and bind you, and bite you, and eat you."
msgstr "너를 감싸고, 구속하고, 물고, 먹어줘야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders
#. Speaker = Larger Giant Spider
#. NodeID = 6ea1b4af-060e-08b9-a8e5-0ccc4e7c160f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders:6ea1b4af-060e-08b9-a8e5-0ccc4e7c160f
msgctxt "h7d00c932g5929g4358ga7efgdeea3a2271c4"
msgid ""
"There is another drow here, but she has forgotten you, my queen. She is "
"forsaken."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders
#. Speaker = Player
#. NodeID = 6f07f6bf-da75-c9be-a7b9-0efae155e027
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders:6f07f6bf-da75-c9be-a7b9-0efae155e027
msgctxt "hfdc564d9g5fa1g4140ga5dfg2ac4bc351bf1"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders
#. Speaker = Larger Giant Spider
#. NodeID = 70e7f3c4-d8a2-0f3f-49c8-8bc1378146f1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_SpiderNest_Spiders_LolthPersuasion(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders:70e7f3c4-d8a2-0f3f-49c8-8bc1378146f1
msgctxt "hbe557467gb3c3g4a08gae69gebe221b1b926"
msgid ""
"Lolth? Is it... you? My queen! My queen of biting. My queen of binding. My "
"queen of wrapping and holding. What would you have me do?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders
#. Speaker = Player
#. NodeID = 7230322f-92e3-bc31-f2a9-7f2849e3a8bd
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders:7230322f-92e3-bc31-f2a9-7f2849e3a8bd
msgctxt "hb1c6df72g5401g40f3gb2dega4add3f88295"
msgid "You should eat a goblin instead. They're delicious."
msgstr "대신 고블린을 먹지 그래. 그들은 맛있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders
#. Speaker = Player
#. NodeID = 82188504-f8be-0ba0-a502-9b8229fad55a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders:82188504-f8be-0ba0-a502-9b8229fad55a
msgctxt "hd0892368g8549g4f97g8659gb64423c0d932"
msgid "<i>Usher her toward the door.</i>"
msgstr "<i>문으로 그녀를 안내한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders
#. Speaker = Player
#. NodeID = 8c96dd64-8d03-6358-fa2b-4c10c6657bfd
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders:8c96dd64-8d03-6358-fa2b-4c10c6657bfd
msgctxt "hf26a453dg10b8g4fe7gace8g12211fb8ba8e"
msgid "<i>Clap your hands together, mimicking her movements.</i>"
msgstr "<i>손뼉을 치며 그녀의 움직임을 따라한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders
#. Speaker = Narrator
#. NodeID = 9661fe44-3ca3-fcad-2c53-9d3872a135ca
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders:9661fe44-3ca3-fcad-2c53-9d3872a135ca
msgctxt "h6f3bc56cg200dg4b83ga587g38a79c854652"
msgid "*The sound and your movement agitate her. She prepares to strike.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders
#. Speaker = Larger Giant Spider
#. NodeID = 9f5d76dd-14d5-65b6-4b96-e5f02c38052e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_SpiderNest_Spiders_PersuadedCursed(1) = True
#.   Global:
#.      - GOB_SpiderNest_State_SpidersOut = False
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders:9f5d76dd-14d5-65b6-4b96-e5f02c38052e
msgctxt "h4b13996fg12f3g46aagba56ge8fe68e080e6"
msgid "Gone, spoiled meat. Gone from here."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders
#. Speaker = Narrator
#. NodeID = ab8ccf2b-1007-0d6e-eccc-c2f800d0ce31
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders:ab8ccf2b-1007-0d6e-eccc-c2f800d0ce31
msgctxt "h5ce08999gc61eg4c8cgb420gfe4289e01124"
msgid ""
"*The spider relaxes slightly, but you feel her hunger - and fear - beneath "
"the surface.*"
msgstr "*거미는 약간 긴장의 끈을 놓지만, 당신은 그녀 내면의 배고픔- 그리고 두려움 -을 느낄 수 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders
#. Speaker = Larger Giant Spider
#. NodeID = b5b19ec6-99e9-600e-0e57-3ae12f15cefd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders:b5b19ec6-99e9-600e-0e57-3ae12f15cefd
msgctxt "hc6d20552g2ed4g484dgb034g967059a001a2"
msgid "Lolth? Can it be?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders
#. Speaker = Player
#. NodeID = bc624ff7-8aa5-4510-883e-2e4ee36d033c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
