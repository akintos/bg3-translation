msgid "*Sniff.*"
msgstr "*킁킁.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_002
#. Speaker = Player
#. NodeID = b27e5dac-0ec3-e0fe-ee0f-dca9a511f993
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_FearfulRothe_State_ConvincedRotheToAttackRubble = False
#.      - UND_FearfulRothe_Event_ConvincedRotheToAttackRubble = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_002:b27e5dac-0ec3-e0fe-ee0f-dca9a511f993
msgctxt "h2fa84db9g1124g47dbg8b9ag11ddc9a0e80c"
msgid "How about breaking through that rubble for me?"
msgstr "날 위해서 저 잔해를 치워주는 건 어때?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_002
#. Speaker = Deep Rothé
#. NodeID = b516b197-d14a-4da5-904a-aff95d46b39a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_FearfulRothe_State_ConvincedRotheToAttackRubble = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_002:b516b197-d14a-4da5-904a-aff95d46b39a
msgctxt "he5c81fc8gc47dg41f0g9bdagafe67bc3f2c0"
msgid "It's all right. I'm all right. Have to move rocks."
msgstr "괜찮아. 난 괜찮아. 바위를 옮겨야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_002
#. Speaker = Deep Rothé
#. NodeID = b7164ef9-d72a-4f05-86ca-efd41ad96856
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_FearfulRothe_HasMet_Rothe_002_SpeakWithAnimals(1) = False
