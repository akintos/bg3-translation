#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001_Dead:e5c065ec-d939-1ed9-cf9e-854b7108cf47
msgctxt "h76cc480ag5b40g4883ga46bg1a28edc59c64"
msgid "Why aren't you helping dig out Nere?"
msgstr "왜 니어를 구출하는 걸 돕지 않고 있었지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001_Dead
#. Speaker = Herdmaster Skarjall
#. NodeID = eb1873c9-300d-e602-2090-4a7ba381dbbc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001_Dead:eb1873c9-300d-e602-2090-4a7ba381dbbc
msgctxt "he39cc546g93aag4b6eg872cg9465d01ebf81"
msgid "Don't care... about True Soul... only coin..."
msgstr "참된 영혼은... 알 바 아니야... 돈이 중요해..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_002
#. Speaker = Grundril
#. NodeID = 0f06383a-7627-4b4f-8687-8155497fe3bb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_FearfulRothe_HasMet_Guard_002(1) = False
#.   Global:
#.      - UND_FearfulRothe_State_ConvincedRotheToAttackRubble = False
#.      - UND_FearfulRothe_State_RotheAreDead = False
#. SetFlags:
#.   Dialog:
#.     - UND_FearfulRothe_HasMet_Guard_002(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_002:0f06383a-7627-4b4f-8687-8155497fe3bb
msgctxt "he94dde15ge28ag4725g9d7ag4d21331fb22b"
msgid "Here to help? Talk to Skarjall. Here to gawk? Find a ledge to fall off."
msgstr "도움이 필요해서 왔어? 스카얄에게 말해 봐. 쳐다보러 왔어? 떨어질 절벽을 찾아봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_002
#. Speaker = Grundril
#. NodeID = 185df249-df48-92f3-96cd-1701ee9a8234
#. HandlePath = TaggedText[0].TagText[0]
