msgctxt "h4f205b16g8d8dg4360g9cbfgd3a7be3712ec"
msgid "Excellent armour. Drowcraft, of course."
msgstr "훌륭한 갑옷이다. 물론 드로우제로군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_VB_DeadDrow1Armor
