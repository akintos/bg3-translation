msgctxt "h3dfe12e6g729cg486dg9d4fg06cd61127670"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead
#. Speaker = Auntie Ethel
#. NodeID = cd111bdb-1f05-cb4b-482a-d91767dc87f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead:cd111bdb-1f05-cb4b-482a-d91767dc87f4
msgctxt "hc860c219g2cf2g46c6gad73g9177c52ab06c"
msgid "They want... and want... and want. I merely... give."
msgstr "그들은 원하고... 또 원하고... 더 원하지. 난 그저... 줄 뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead
#. Speaker = Narrator
#. NodeID = d9c4c651-9447-10c1-eae6-8d46e299e948
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead:d9c4c651-9447-10c1-eae6-8d46e299e948
msgctxt "hdce64937g7265g47edgae77ge31260ba0e67"
msgid ""
"*Ethel grits her teeth - struggling to speak, but the spell holds. She can't "
"answer any more questions.*"
msgstr "*에텔이 이를 꽉 깨물며 말하려 노력하지만, 주문의 힘에 의해 막힙니다. 그녀는 더 이상 질문에 대답할 수 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead
#. Speaker = Player
#. NodeID = dd3496a5-2e31-61e2-5f9f-233eb20a2fdf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead:dd3496a5-2e31-61e2-5f9f-233eb20a2fdf
msgctxt "he7505359g34e1g491fg97a6g1179810e3250"
msgid "Tell me the truth - what did you want with Mayrina?"
msgstr "진실을 말해, 메이리나를 데리고 뭘 하려고 했지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead
#. Speaker = Player
#. NodeID = df512a50-2e9c-b96a-93e8-3e910f7c751c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead:df512a50-2e9c-b96a-93e8-3e910f7c751c
msgctxt "hf8f15ed4ga8f7g440bga52eg88ba6ef733f6"
msgid "Why are you so cruel?"
msgstr "왜 그렇게 잔혹한 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead
#. Speaker = Narrator
#. NodeID = dfd95aef-0ceb-0cb8-8324-f74fd43de5c3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_Killer(1) = True
#.      - HAG_Hag_State_HasPhylactery(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead:dfd95aef-0ceb-0cb8-8324-f74fd43de5c3
msgctxt "h3c95012eg4f69g423cg920ag4782eb9be451"
msgid "*A charm on the hag's body flashes a faint glow.*"
msgstr "*해그의 몸에 있는 부적이 희미한 빛이 번쩍입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead
#. Speaker = Auntie Ethel
#. NodeID = e7c5866b-41cc-a21d-4751-f1892bc534a9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead:e7c5866b-41cc-a21d-4751-f1892bc534a9
msgctxt "hf5006b57g3515g495dg9c02g6fba7e6cabc2"
msgid "The brat's husband is <i>dead. </i>So sad."
msgstr "그년의 남편이 <i>죽었단다. </i>참 슬프지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead
#. Speaker = Auntie Ethel
#. NodeID = ef63bdce-85f6-ed75-ccfd-f2288563da71
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead:ef63bdce-85f6-ed75-ccfd-f2288563da71
msgctxt "hba222055gcb0dg412bgb006g1a7f536b4fd7"
msgid "You will bleed - you will choke on your own <i>guts</i> for this."
msgstr "넌 피를 흘릴게다. 네 <i>내장에</i> 목이 졸려 죽어버릴 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead
#. Speaker = Auntie Ethel
#. NodeID = ef6750bc-30f0-2b31-e54d-450c2d7c64a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead:ef6750bc-30f0-2b31-e54d-450c2d7c64a3
msgctxt "ha3f13b86g0e41g425fg92e8ga1c5a718014e"
msgid "People are their own worst enemies, petal. I just let them see it."
msgstr "사람에게 최악의 적은 바로 본인이란다, 꽃잎아. 난 그저 그걸 깨닫게 해주는 것뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead
#. Speaker = Auntie Ethel
#. NodeID = f3590626-1db6-fdb9-5da4-c8ea783922fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead:f3590626-1db6-fdb9-5da4-c8ea783922fd
msgctxt "h78ead6a1gfbb8g48e3gae1egaa7457f80266"
msgid "... was going to... eat it... and make a... hag daughter..."
msgstr "... 먹어서... 내... 해그 딸을... 만드려..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead
#. Speaker = Player
#. NodeID = f38bde12-8694-b71b-2a7f-df781eff9ebc
