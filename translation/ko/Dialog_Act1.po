#.     - DEN_HarpyMeal_Event_OriginCharm1(0) = True
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerCharmed:05018964-92a4-0602-28a5-9e6fc53d548d
msgctxt "hf94bcce2g8a1ag417cgb910g5ab940dbb20a"
msgid "Such rapturous music. I can hardly resist..."
msgstr "이렇게 황홀한 음악이라니. 헤어날 수 없는걸..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerCharmed
#. Speaker = Player
#. NodeID = 0a62687f-48dc-0fa3-3577-d1802ae193e5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_HarpyMeal_Event_OriginCharm1(0) = False
#.     - DEN_HarpyMeal_Event_OriginCharm3(0) = False
#.     - DEN_HarpyMeal_Event_OriginCharm2(0) = False
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerCharmed:0a62687f-48dc-0fa3-3577-d1802ae193e5
msgctxt "h166edf58g5268g4663ga302g9f00b3320cc9"
msgid "No more blood. No more killing. Just this, please."
msgstr "살인도, 피도, 더는 필요 없어. 이것만 듣게 해줘, 제발."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerCharmed
#. Speaker = Player
#. NodeID = 0a62687f-48dc-0fa3-3577-d1802ae193e5
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
