msgctxt "he3ddd85ag0facg48c5ga10fg103137386ba4"
msgid "Damn thing is jammed shut. Won't turn like this."
msgstr "망할 것이 꽉 막혀 있군. 이렇게는 회전하지 않을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_StatuePuzzle_PAD_DoorOpened
#. Speaker = Player
#. NodeID = b6ccab81-e561-4944-84e5-210a9c63b816
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_StatuePuzzle_PAD_DoorOpened:b6ccab81-e561-4944-84e5-210a9c63b816
msgctxt "hb6757c9fgccc9g4508gb3d8g5b2e626ba1ba"
msgid "Well well, look what you've been hiding."
msgstr "이런 이런, 뭐가 숨겨져 있는지 볼까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_StatuePuzzle_PAD_DoorOpened
#. Speaker = Player
#. NodeID = b6ccab81-e561-4944-84e5-210a9c63b816
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_StatuePuzzle_PAD_DoorOpened:b6ccab81-e561-4944-84e5-210a9c63b816
msgctxt "h7eb24638gacc9g4950g96a8g7996d3fb87f2"
msgid "Curious. What secrets might this door be hiding?"
msgstr "흥미롭군. 이 문은 어떤 비밀을 숨기고 있을까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_StatuePuzzle_PAD_DoorOpened
#. Speaker = Player
#. NodeID = b6ccab81-e561-4944-84e5-210a9c63b816
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_StatuePuzzle_PAD_DoorOpened:b6ccab81-e561-4944-84e5-210a9c63b816
msgctxt "h8cc26c88gb8f4g4767gbed1gafe77468b5d1"
msgid "Nothing like a secret door to pique one's interest."
msgstr "비밀의 문은 언제나 호기심을 자극하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_StatuePuzzle_PAD_DoorOpened
#. Speaker = Player
#. NodeID = b6ccab81-e561-4944-84e5-210a9c63b816
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_StatuePuzzle_PAD_DoorOpened:b6ccab81-e561-4944-84e5-210a9c63b816
msgctxt "hee95cd9ag788dg4dabgb5c2g254cd479ad7c"
msgid "A hidden door. Who has the time to design such things?"
msgstr "숨겨진 문이군. 누가 이런 걸 설계할 시간이 있었을까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_StatuePuzzle_PAD_DoorOpened
#. Speaker = Player
#. NodeID = b6ccab81-e561-4944-84e5-210a9c63b816
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_StatuePuzzle_PAD_DoorOpened:b6ccab81-e561-4944-84e5-210a9c63b816
msgctxt "he14344dcg32eag4bd6g8ea3ge5cb725a1698"
msgid "A hidden door? Time to poke around a bit."
msgstr "숨겨진 문? 한번 살펴보자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_StatuePuzzle_PAD_DoorOpened
#. Speaker = Player
#. NodeID = b6ccab81-e561-4944-84e5-210a9c63b816
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_StatuePuzzle_PAD_DoorOpened:b6ccab81-e561-4944-84e5-210a9c63b816
msgctxt "hf69a80f7ge18ag4b64ga5b9g98d23d2aa005"
msgid "What's behind the secret door?"
msgstr "저 비밀 문 뒤에 뭐가 있을까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_StatuePuzzle_PAD_DoorOpened
#. Speaker = Player
#. NodeID = b6ccab81-e561-4944-84e5-210a9c63b816
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_StatuePuzzle_PAD_DoorOpened:b6ccab81-e561-4944-84e5-210a9c63b816
msgctxt "h98c928ffg344ag4f75g9991g29d57cb9845c"
msgid "The statues reveal a hidden path. Most clever."
msgstr "조각상이 숨겨진 통로를 드러냈어. 정말 영리하군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_StatuePuzzle_PAD_DoorOpened
#. Speaker = Player
#. NodeID = b6ccab81-e561-4944-84e5-210a9c63b816
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: !REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_StatuePuzzle_PAD_DoorOpened:b6ccab81-e561-4944-84e5-210a9c63b816
msgctxt "h36e9f4f3g6295g4af8gaf49gb91e7af1c493"
msgid "The statues revealed a hidden door... Curious."
msgstr "조각상이 숨겨진 통로를 드러냈어... 흥미로워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_StatuePuzzle_PAD_HitWeakly
