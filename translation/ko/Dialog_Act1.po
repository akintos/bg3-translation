#. Speaker = Narrator
#. NodeID = e53bf7a6-c59d-a182-d503-227e7081153c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_02:e53bf7a6-c59d-a182-d503-227e7081153c
msgctxt "hfceef044g8f2bg4eb1gb939g8963dcb81f00"
msgid "*His fangs snap and gnash, biting down on nothing. He wants more.*"
msgstr "*녀석은 송곳니로 딱딱 소리를 내며 이를 갈고, 허공을 물어댑니다. 더 원하고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_03
#. Speaker = Narrator
#. NodeID = 3bac5eaf-7392-c331-5919-59d96c80a4c7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_03:3bac5eaf-7392-c331-5919-59d96c80a4c7
msgctxt "h725d3a4fg8960g48b5g8c46g978cd561b77c"
msgid ""
"*You might almost pity the creature. Too full to move, yet desperately "
"starving.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_03
#. Speaker = Bloated Hyena
#. NodeID = 734d9649-9635-d6f6-9905-b8ff32048381
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_03:734d9649-9635-d6f6-9905-b8ff32048381
msgctxt "hd713a12cg5e5eg4b95ga410ga8dde8bcdb73"
msgid "*Whine.*"
msgstr "*낑낑.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_04
#. Speaker = Bloated Hyena
#. NodeID = 0243e0e2-ff13-f31a-7ffc-fd2f6661f33b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_04:0243e0e2-ff13-f31a-7ffc-fd2f6661f33b
msgctxt "h2aa7507cgbf86g4bebga8ebg5ec33e2005a7"
msgid "*Growl!*"
msgstr "*으르렁.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_04
#. Speaker = Narrator
#. NodeID = fa46a72c-c568-c7fd-f8a5-fc55a97231c7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_04:fa46a72c-c568-c7fd-f8a5-fc55a97231c7
msgctxt "h30f70b0fg469eg4085gaca0gefffc185a066"
msgid "*The hyena's eyes are mad with pain.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_AD_GnollBorn
#. Speaker = GROUP_Gnolls
#. NodeID = 3e69ffcc-21d4-cafa-23fc-8ecd0e39119d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_AD_GnollBorn:3e69ffcc-21d4-cafa-23fc-8ecd0e39119d
msgctxt "hcb153828g9384g4bdeg9f29gd2b0d506b91c"
msgid "*Hrrarrrgghh!*"
msgstr "*흐아아아악!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent
#. Speaker = Narrator
#. NodeID = 057b433a-1294-20ed-e21a-63b77b7b7494
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_GOOD or CLERIC_NEUTRAL or PALADIN_ANCIENTS or PALADIN_DEVOTION
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent:057b433a-1294-20ed-e21a-63b77b7b7494
msgctxt "h818d120ege08bg48b7g855bgcc07c2a66dc4"
msgid ""
"*The realisation hits you - that stench wasn't the dead. You can sense that "
"the hyena's very flesh is desecrated...*"
msgstr ""
"*당신은 깨닫습니다. 그 악취는 시체에서 나오는 것이 아닙니다. 하이에나의 육신 그 자체가 부정한 것이 된 걸 느낄 수 있습니다...*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent
#. Speaker = Narrator
#. NodeID = 057b433a-1294-20ed-e21a-63b77b7b7494
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: !(CLERIC_GOOD and CLERIC_NEUTRAL and PALADIN_ANCIENTS and PALADIN_DEVOTION)
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent:057b433a-1294-20ed-e21a-63b77b7b7494
msgctxt "h7371baa5ga328g4366g976bg83d7ec6ddd85"
msgid ""
"*You watch with cold realisation - this isn't the end of one life, but the "
"start of another...*"
msgstr "*당신은 무정한 실상을 깨닫고 지켜봅니다. 이건 한 생명의 최후일 뿐만 아니라, 다른 생명의 시작입니다...*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent
#. Speaker = Narrator
#. NodeID = 0a1a3780-7ed4-be9b-8b07-88b688842e87
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent:0a1a3780-7ed4-be9b-8b07-88b688842e87
msgctxt "h905129cbgf8abg4501ga765ga41aa9402b71"
msgid ""
"*Slowly, her broken body starts to calm, to stop its wild contortions. She "
"lies still.*"
msgstr "*그녀의 부서진 육체가 서서히 진정되며 격렬한 비틀림을 멈춥니다. 이윽고 가만히 누워 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent
#. Speaker = Narrator
#. NodeID = 20f9349e-d78f-0b01-fcc6-f8a26794f393
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent:20f9349e-d78f-0b01-fcc6-f8a26794f393
msgctxt "h70ed9443g0f7bg41c1g8eaag032ceca04d97"
msgid ""
"*The beautiful broken heap smells oddly enticing. You find you can't resist "
"inhaling her offals.*"
msgstr "*아름답게 망가진 덩어리에서 묘하게 유혹적인 냄새가 납니다. 당신은 저것의 내장을 들이마시고 싶은 욕구를 참을 수 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent
#. Speaker = Player
#. NodeID = 2580e334-50a3-a1b1-1668-6e6a4b451b36
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#.      - OATHBREAKER(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent:2580e334-50a3-a1b1-1668-6e6a4b451b36
#, fuzzy
msgctxt "h467cf33dgdf74g4c04g8998gae9137edbf01"
msgid "<i>Bless the hyena, trying to purge her body of evil.</i>"
msgstr "<i>하이에나에게 축복을 내려, 그 몸에서 악을 정화하려 시도해 본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent
#. Speaker = Player
#. NodeID = 26b56017-2057-20e0-c8e3-74d7c5603d21
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent:26b56017-2057-20e0-c8e3-74d7c5603d21
msgctxt "h2c8017d4ga42fg4b4cga05fg2652b9806fc4"
msgid "What's happening to you? Is there any way I can help?"
msgstr "무슨 일이 벌어지고 있는 거야? 내가 도울 수 있을까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent
#. Speaker = Player
#. NodeID = 2b3c76f6-63b1-9156-479f-6f56e5988768
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: RANGER
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent:2b3c76f6-63b1-9156-479f-6f56e5988768
#, fuzzy
msgctxt "h08e51c24g2419g462cg8fcfg7f34b4885981"
msgid "<i>Show mercy, ending her life swiftly.</i>"
msgstr "<i>자비를 베풀어 녀석의 숨통을 빠르게 끊는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent
#. Speaker = GROUP_DyingHyenas
#. NodeID = 316faf01-ae3a-9f84-2480-76d8d1dfefd1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent:316faf01-ae3a-9f84-2480-76d8d1dfefd1
msgctxt "h329350dcg9660g43dbg9ca4g53f34d595222"
msgid "No. Come closer - feed the new flesh."
msgstr "없다. 가까이 와라. 새로운 육신에 먹이를 줘라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent
#. Speaker = Narrator
#. NodeID = 36e03d56-4681-950d-f1fa-42558dbf94e5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_DyingHyena_PCRememberedArcana(1) = False
#. SetFlags:
#.   Global:
#.     - PLA_DyingHyena_Event_PeacefulDeath = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent:36e03d56-4681-950d-f1fa-42558dbf94e5
msgctxt "h6f345df5g678cg413fg9e30g70a3f1894f9f"
msgid ""
"*Whatever horrific creature was growing inside the hyena dies along with "
"her.*"
msgstr "*하이에나의 몸속에서 자라던 정체불명의 끔찍한 생명체도 그녀와 함께 죽습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent
#. Speaker = Narrator
#. NodeID = 391f65e9-fa68-73ea-51db-a00da6e3f43a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ConflictedFlind_Knows_Gnolls = True
#. SetFlags:
#.   Dialog:
#.     - PLA_DyingHyena_PCRememberedArcana(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent:391f65e9-fa68-73ea-51db-a00da6e3f43a
#, fuzzy
msgctxt "ha7a2cd1ag2992g498aga6e3g5cd89de2f777"
msgid "*...Gnolls can spawn from the corpses of dying hyenas.*"
msgstr "*... 놀은 죽은 하이에나의 시체에서 태어난다는 것을요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent
#. Speaker = Player
#. NodeID = 3f3f7260-7c7d-cba3-71ff-acfd2c79268a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#.      - OATHBREAKER(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent:3f3f7260-7c7d-cba3-71ff-acfd2c79268a
msgctxt "ha419f8e7ga180g4777g9e7fg5fd110434b39"
msgid "<i>Smite the abomination.</i>"
msgstr "<i>흉물을 강타한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent
#. Speaker = GROUP_DyingHyenas
#. NodeID = 415fdb37-80e9-4f5e-4fd0-23c7c69fc774
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent:415fdb37-80e9-4f5e-4fd0-23c7c69fc774
msgctxt "h670aa777g0fefg4de4g9de2gb7d23bb0811f"
msgid "Feel its power, the Butcher is hungry. You, me - all meat."
msgstr "도살자께서 굶주리신다. 그 힘을 느껴 봐라. 너도, 나도, 모두 고깃덩이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent
#. Speaker = GROUP_DyingHyenas
#. NodeID = 4f3a60f0-d696-85ec-38f2-2a5989c06727
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent:4f3a60f0-d696-85ec-38f2-2a5989c06727
msgctxt "h0c4c4955ga4dfg4f76g82d3g15ec201e937d"
msgid "Can't leave me - new flesh needs to feed."
msgstr "떠나지 마. 새 육신을 먹여야 한다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent
#. Speaker = Player
#. NodeID = 528e7b14-d12c-e130-c4dc-dac2f21e2b2e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent:528e7b14-d12c-e130-c4dc-dac2f21e2b2e
msgctxt "h59e30652ge55ag4221g8f2fg23891c50d6fe"
msgid "<i>Step back to watch the show.</i>"
msgstr "<i>물러서서 구경거리를 지켜본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent
#. Speaker = GROUP_DyingHyenas
#. NodeID = 5d490807-30e2-8e22-be7f-416ae049d6dc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent:5d490807-30e2-8e22-be7f-416ae049d6dc
msgctxt "h2dc39f99g53b5g42e3gbc73gd66ad190bfc4"
msgid "Hurts... it hur-hur-hur-ha-ha-ha..."
msgstr "아파... 정말로 아,아,아,하,하하..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent
#. Speaker = Narrator
#. NodeID = 692d376c-de9a-b6cd-8b1e-12a51e159c40
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent:692d376c-de9a-b6cd-8b1e-12a51e159c40
msgctxt "h52c971dag6039g42degb40cg894beb130180"
msgid "*Radiant power flows through you as you strike the creature down.*"
msgstr "*당신이 그 생물을 쳐 죽이는 순간 광휘의 힘이 당신을 타고 흐릅니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent
#. Speaker = Player
#. NodeID = 71198f46-3cd7-eb43-5584-8c952c3ff098
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: MeleeWeaponAttack
#. RollAbility:
#. DifficultyClass: 0
#. CheckFlags:
#.   Tag:
#.      - RANGER(1) = False
#.      - DRUID(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent:71198f46-3cd7-eb43-5584-8c952c3ff098
msgctxt "h6b89a302g41eeg4eddg883cg92900dbbcb8d"
msgid "<i>Strike while the beast is vulnerable.</i>"
msgstr "<i>짐승이 취약할 때 공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent
#. Speaker = GROUP_DyingHyenas
#. NodeID = 74116768-c40e-3005-8606-75af4256dc91
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent:74116768-c40e-3005-8606-75af4256dc91
msgctxt "hc62d204eg9868g4c74g90fbg5d99c77d629f"
msgid "Butcher's stronger than you, meat."
msgstr "도살자께선 너보다 강하시다, 이 고깃덩이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent
#. Speaker = Narrator
#. NodeID = 799a6692-e641-94e4-f41e-6f9edd100e94
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent:799a6692-e641-94e4-f41e-6f9edd100e94
msgctxt "h936a4dd6gaebcg4d45g91b2g62fe97d89652"
msgid ""
"*Her darling pups will not be of her own species. Gnolls bring forth their "
"iniquitous litter from many corpsed wombs - including hyenas.*"
msgstr ""
"*그녀의 사랑스러운 새끼들은 같은 종으로 태어나지 않을 겁니다. Gnolls bring forth their iniquitous "
"litter from many corpsed wombs - including hyenas.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent
#. Speaker = Narrator
#. NodeID = 7f3aeb5d-bd90-d60b-044e-05fb887c0113
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent:7f3aeb5d-bd90-d60b-044e-05fb887c0113
msgctxt "h364833aegf646g407ag80d5g9dfe92c22a40"
msgid ""
"*You engrave her pained mewls upon your heart. Her back arches impossibly - "
"a grace made possible only by it being broken.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent
#. Speaker = Narrator
#. NodeID = 7fcae759-2a3e-9879-c05d-86dd1eb7d2eb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent:7fcae759-2a3e-9879-c05d-86dd1eb7d2eb
msgctxt "h36d0f11fgc567g4f5cga3f3g779ee1fc4e65"
msgid ""
"*The creature's eyes roll back in its head - equal parts bliss and agony.*"
msgstr "*생물이 눈을 까뒤집습니다. 환희와 고통이 절반씩 섞여 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent
#. Speaker = Narrator
#. NodeID = 91e02b6d-17ca-f22c-d0a8-7051b6839ddb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent:91e02b6d-17ca-f22c-d0a8-7051b6839ddb
msgctxt "ha523cbfbg2c11g4cd3gb3edg0a62c5ed3fba"
msgid ""
"*The hyena moans softly as its body contorts, ribs cracking and flesh "
"tearing.*"
msgstr "*하이에나의 몸이 뒤틀리고, 갈비뼈는 부러지고 살점이 찢어집니다. 녀석은 조용히 신음합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent
#. Speaker = GROUP_DyingHyenas
#. NodeID = 943ee044-4bd8-4c34-e87c-a143d263a779
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent:943ee044-4bd8-4c34-e87c-a143d263a779
msgctxt "h7121fde0gcb0ag471egab5ag0a74841d6472"
msgid "Come... see. My flesh becomes new flesh."
msgstr "와서... 보아라. 내 육신이 새로운 육신으로 탈바꿈한다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent
#. Speaker = Narrator
#. NodeID = 954c8ce5-6dec-d48d-29e9-f074bd59a38f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent:954c8ce5-6dec-d48d-29e9-f074bd59a38f
msgctxt "h14d95d81gf172g4c75gaa41ge0d0281c1a12"
msgid "*You move quickly, but not quickly enough.*"
msgstr "*당신은 신속히 움직이지만, 충분히 신속하지 못합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent
#. Speaker = Narrator
#. NodeID = 97cc1dc6-581d-74de-cc29-27653312d478
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent:97cc1dc6-581d-74de-cc29-27653312d478
msgctxt "h109bb9d7gf9afg410dga5d5g395ed986434f"
msgid ""
"*The raw hate of life, reared from the miracle of death. A tear almost "
"springs to your eye.*"
msgstr "*죽음의 기적이 빚어낸 생명의 원초적인 증오입니다. 당신은 눈물이 솟구칠 것만 같습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent
#. Speaker = GROUP_DyingHyenas
#. NodeID = 9b822da6-896f-60da-48bf-7a1c65737b4a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent:9b822da6-896f-60da-48bf-7a1c65737b4a
msgctxt "h4ae4c187g5f61g4ac7g9fc7gaf3a4aaff569"
msgid "Yes - come closer. Feed the new flesh."
msgstr "그래, 가까이 와라. 새로운 육신에 먹이를 줘라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent
#. Speaker = Narrator
#. NodeID = afcbad10-9625-3fdf-e3e3-c6fc1dbabb5e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent:afcbad10-9625-3fdf-e3e3-c6fc1dbabb5e
msgctxt "hcc7e173agfcfcg45f4ga72bgd1d781ef43a5"
msgid ""
"*You hear what comes next before you see it: the sharp snapping of bones and "
"a yelp of pain as her body starts to twist and undulate.*"
msgstr "*소리가 먼저 들립니다. 뼈가 부러지는 날카로운 소리와 하이에나의 몸이 뒤틀리고 굽이치며 내는 고통의 비명 소리.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent
#. Speaker = Player
#. NodeID = b3ccaa8b-bdd1-f5ce-d955-14ba57155814
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: RANGER
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent:b3ccaa8b-bdd1-f5ce-d955-14ba57155814
#, fuzzy
msgctxt "h81c61218g3726g4580ga0b2gb4215aa331fa"
msgid "<i>Show mercy, ending her life swiftly.</i>"
msgstr "<i>자비를 베풀어 녀석의 숨통을 빠르게 끊는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent
#. Speaker = Player
#. NodeID = b496077c-3d62-2072-0225-a4ba867de362
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent:b496077c-3d62-2072-0225-a4ba867de362
msgctxt "hfb94e600g577ag4b6egadb5g439292b30d9d"
msgid "<i>Watch the beast die.</i>"
msgstr "<i>짐승이 죽는 것을 지켜본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent
#. Speaker = Narrator
#. NodeID = be482a64-a8cb-0f41-c1b4-9fcf73c2f316
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ConflictedFlind_Knows_Gnolls = False
#. SetFlags:
#.   Dialog:
#.     - PLA_DyingHyena_PCRememberedArcana(1) = True
#.   Global:
#.     - PLA_ConflictedFlind_Knows_Gnolls = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent:be482a64-a8cb-0f41-c1b4-9fcf73c2f316
#, fuzzy
msgctxt "h7ce62c56g0487g40b3g80f8g0d49411a9b4a"
msgid ""
"*...Gnolls - vicious, monstrous humanoids - can spawn from the corpses of "
"dying hyenas.*"
msgstr "*... 잔인한, 괴물 같은 유사인간인 놀이 하이에나의 시체에서 태어난다는 것을요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent
#. Speaker = Narrator
#. NodeID = bf113d70-5ed1-603d-71d2-71f464c0e067
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - PLA_DyingHyena_PaladinSurge(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent:bf113d70-5ed1-603d-71d2-71f464c0e067
msgctxt "ha04d271bg5508g4c2fg98c7gc70da1ed9260"
msgid "*The surge of holy power is rebuked, knocking you back.*"
msgstr "*성스러운 힘의 물결은 책망을 받고, 당신을 뒤로 자빠뜨립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent
#. Speaker = Narrator
#. NodeID = bfb4c7f9-a291-77c3-8c20-dcf1cf1d3f28
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent:bfb4c7f9-a291-77c3-8c20-dcf1cf1d3f28
msgctxt "h40e61f9cg6cefg455fg9d2fg2b7d2df16144"
msgid ""
"*You strike quickly, but not quickly enough. She shrieks, thrashing "
"helplessly.*"
msgstr "*당신은 빠르게 일격을 날렸지만 충분히 빠르지 못했습니다. 녀석은 힘 없이 뒹굴며 비명을 지릅니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent
#. Speaker = Narrator
#. NodeID = c6831948-2bbb-2618-5b36-5e39be2d7523
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_GOOD or CLERIC_NEUTRAL
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent:c6831948-2bbb-2618-5b36-5e39be2d7523
msgctxt "h9a914ff3g2871g4e33g8b85g37e0c993a8f9"
msgid ""
"*The beast reeks of brimstone and offal, every breath thick with blood. "
"Almost gagging, you mutter a quiet prayer to your god.*"
msgstr ""
"*짐승에게선 유황과 내장의 악취가 나고, 놈이 내쉬는 숨에는 피비린내가 진동합니다. 당신은 금방이라도 올라올 것 같은 구토를 참으며 "
"당신의 신에게 조용히 기도합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent
#. Speaker = Narrator
#. NodeID = c6831948-2bbb-2618-5b36-5e39be2d7523
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: !(CLERIC_GOOD and CLERIC_NEUTRAL)
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent:c6831948-2bbb-2618-5b36-5e39be2d7523
msgctxt "h0133f014g5419g4cc4gb6e8gd33f9bf7b823"
msgid ""
"*The beast reeks of brimstone and offal. Every breath is thick with blood.*"
msgstr "*짐승에게서 유황과 내장의 악취가 풍기고, 놈이 내쉬는 숨에는 피비린내가 진동합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent
#. Speaker = Narrator
#. NodeID = c81bb9b3-b37e-192b-bec2-cf6aaca19672
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent:c81bb9b3-b37e-192b-bec2-cf6aaca19672
msgctxt "h8783f8a0ge1efg4b26gaffcg3901d79d8417"
msgid ""
"*Her offals smell irresistible, and while her bloodfeast has filled her, the "
"hyena is not yet <i>sated</i>.*"
msgstr "*입에서는 거부할 수 없는 냄새가 풍기고 몸은 피범벅인데도, 하이에나는 아직 <i>포만감</i>을 느끼지 않습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent
#. Speaker = Narrator
#. NodeID = c8c877ca-1a10-df18-f23a-6ae2f3b5d73c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent:c8c877ca-1a10-df18-f23a-6ae2f3b5d73c
msgctxt "h0ebaa67eg7633g4107g859dgab26c95e1f1c"
msgid ""
"*Bones snap as the hyena is hollowed from the inside out, forming a vessel "
"for something new.*"
msgstr "*하이에나의 몸 안쪽이 텅 비게 되면서 새로운 존재를 위한 그릇이 되고, 뼈가 부러집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent
#. Speaker = Player
#. NodeID = c97a9dc6-0791-57d9-3f15-ea5abdbb3c1d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent:c97a9dc6-0791-57d9-3f15-ea5abdbb3c1d
msgctxt "hf6e4a2f1g0b0ag46d0ga1b0gb7d039057f50"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent
#. Speaker = GROUP_DyingHyenas
#. NodeID = c9cc31e2-1e17-31c5-6bea-1efc26c25579
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent:c9cc31e2-1e17-31c5-6bea-1efc26c25579
msgctxt "h32920a88gc1a9g4668gbd26gbc583787c0c8"
msgid "Flesh inside is quiet - flesh inside is dead. <i>Murderer.</i>"
msgstr "내 안의 육신이 조용해졌다. 그것은 죽었어. <i>살인자.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent
#. Speaker = Player
#. NodeID = cb89e426-fbcb-7ebc-10f9-2e2f3fd2d19b
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 10
#. TagRule: CLERIC_GOOD or CLERIC_NEUTRAL
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent:cb89e426-fbcb-7ebc-10f9-2e2f3fd2d19b
#, fuzzy
msgctxt "hd0dd6093g3b14g44c2gae44g3cc555c9bf08"
msgid "<i>Bless the hyena, trying to purge her body of evil.</i>"
msgstr "<i>하이에나에게 축복을 내려, 그 몸에서 악을 정화하려 시도해 본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent
#. Speaker = Player
#. NodeID = cc9765d5-74ca-266f-f550-1d343aac71a5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent:cc9765d5-74ca-266f-f550-1d343aac71a5
msgctxt "h7c8596f5g989eg4229gaf54gb65e54d276dd"
msgid "<i>Destroy the abomination.</i>"
msgstr "<i>흉물을 파괴한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent
#. Speaker = Player
#. NodeID = ce70932b-da99-762e-9caa-042823633bc5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent:ce70932b-da99-762e-9caa-042823633bc5
msgctxt "h30a4acceg751bg46cbga3aeg75c6627a8f6c"
msgid "Is there any way to stop this?"
msgstr "이걸 멈출 방법이 있을까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent
#. Speaker = Narrator
#. NodeID = d80c28bf-6706-f9c3-13ff-5d4c65c6707d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_DyingHyena_PCRememberedArcana(1) = True
#. SetFlags:
#.   Global:
#.     - PLA_DyingHyena_Event_PeacefulDeath = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent:d80c28bf-6706-f9c3-13ff-5d4c65c6707d
msgctxt "hc4bbee22g567dg4077g8ee7g115c63b3fa9f"
msgid ""
"*As the life fades from her eyes, the gnoll within her dies too, stillborn.*"
msgstr "*그녀의 눈에서 생명이 꺼져가면서, 그 안에 있던 놀도 죽습니다. 사산된 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent
#. Speaker = Narrator
#. NodeID = e10a98c0-2def-1880-5eaa-4ac1ecc887d5
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: RANGER
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent:e10a98c0-2def-1880-5eaa-4ac1ecc887d5
msgctxt "hf2893d15ge775g45f9gaa44g6e46338f25a8"
msgid ""
"*Your nostrils fill with the rank smell of death. The hyena has feasted, but "
"looking into her eyes, you know it wasn't enough. She's still hungry.*"
msgstr ""
"*죽음의 고약한 냄새가 당신의 코를 가득 채웁니다. 하이에나는 포식했지만, 그 눈빛을 보면 충분하지 않았다는 걸 알 수 있습니다. 여전히 "
"굶주린 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent
#. Speaker = Narrator
#. NodeID = e10a98c0-2def-1880-5eaa-4ac1ecc887d5
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: !RANGER
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent:e10a98c0-2def-1880-5eaa-4ac1ecc887d5
msgctxt "h830ce9a7g1648g4b9fg98b2g1a7bd0cf8b06"
msgid ""
"*She'd eaten. Feasted. And yet, looking into her eyes, you can see it wasn't "
"enough. She's still hungry.*"
msgstr "*녀석은 배를 채웠습니다. 포식을 했지요. 그럼에도 그 눈빛을 보면 그것도 충분치 않았습니다. 여전히 굶주려 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent
#. Speaker = Player
#. NodeID = e281696a-2a8a-26d1-d2b4-578f7b84293a
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: (CLERIC_EVIL or OATHBREAKER) and (NOT_FOR_EA and PALADIN_VENGEANCE)
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent:e281696a-2a8a-26d1-d2b4-578f7b84293a
msgctxt "h93589f14g1440g4a73gbc47g98ba67afe305"
msgid "<i>Revel in the creature's demonic influence.</i>"
msgstr "<i>녀석에게 영향을 주는 데몬의 존재에 대해 황홀경에 빠진다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent
#. Speaker = Narrator
#. NodeID = e84b6131-d482-64ee-8209-b7b742f150fa
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_DyingHyena_Event_Death = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent:e84b6131-d482-64ee-8209-b7b742f150fa
msgctxt "h966c5102g00efg4f0ag92ffg493dc8e0496c"
msgid ""
"*Her belly splits like a rotten fruit, birthing a frenzy of claws and fangs.*"
msgstr "*그녀의 배는 썩은 과일처럼 갈라져, 광란의 발톱과 송곳니를 낳습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent
#. Speaker = Narrator
#. NodeID = f030492e-d91f-ac5a-5717-68e0d1af78f9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent:f030492e-d91f-ac5a-5717-68e0d1af78f9
msgctxt "hcf3cee88gc5e2g4c8ag8150g35e37b28504a"
msgid ""
"*You hear what comes next before you see it: the sharp snapping of bones and "
"a yelp of pain as her body starts to twist and undulate.*"
msgstr "*소리가 먼저 들립니다. 뼈가 부러지는 날카로운 소리와 하이에나의 몸이 뒤틀리고 굽이치며 내는 고통의 비명 소리.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent
#. Speaker = Player
#. NodeID = f05604fe-4e96-e228-f84c-e5f9f3bb9041
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GLO_Event_SetSurprisedNextCombat(1) = True
#. TagRule: PETPAL
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent:f05604fe-4e96-e228-f84c-e5f9f3bb9041
#, fuzzy
msgctxt "h2eb397cdg00f3g4ab9g9a24gbc196b613c20"
msgid "There, now, it's all right. It'll be over soon."
msgstr "자, 이제 다 괜찮아. 곧 다 끝날 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent
#. Speaker = Player
#. NodeID = f05604fe-4e96-e228-f84c-e5f9f3bb9041
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Object:
#.     - GLO_Event_SetSurprisedNextCombat(1) = True
#. TagRule: !(PETPAL and REALLY_DARK_URGE)
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent:f05604fe-4e96-e228-f84c-e5f9f3bb9041
#, fuzzy
#| msgid "<i>Try to comfort the hyena.</i>"
msgctxt "hb50c42b1g354eg48cfga517gc73fa004682e"
msgid "<i>Try not to be sick.</i>"
msgstr "<i>하이에나를 안심시킨다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent
#. Speaker = Player
#. NodeID = f05604fe-4e96-e228-f84c-e5f9f3bb9041
#. HandlePath = TaggedText[2].TagText[0]
#. SetFlags:
#.   Object:
#.     - GLO_Event_SetSurprisedNextCombat(1) = True
#. TagRule: !PETPAL
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent:f05604fe-4e96-e228-f84c-e5f9f3bb9041
msgctxt "hee7e6034gde25g4adbgad4cg2a0b1e8cf601"
msgid "<i>Stifle your excitement. This is grotesque.</i>"
msgstr "<i>흥분을 억누른다. 이건 기괴하다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent
#. Speaker = Narrator
#. NodeID = f240c167-f7ac-f7af-8334-b1d31a8e50ce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_DeathEvent:f240c167-f7ac-f7af-8334-b1d31a8e50ce
msgctxt "hbfb5449bg447ag40c8gb621gd7e4a29f46e5"
msgid ""
"*You land a swift strike against her skull. She yelps, then goes still.*"
msgstr "*당신은 녀석의 두개골을 향해 빠르게 일격을 날립니다. 비명을 지르더니 이내 잠잠해집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_Healthy_01
#. Speaker = Player
#. NodeID = 10dbfac4-b69b-79b2-7cfa-04a43fe8ea8c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToIndivPlayerAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_Healthy_01:10dbfac4-b69b-79b2-7cfa-04a43fe8ea8c
msgctxt "h8da9cfa8gbba8g4376g98f6gae1894e7caea"
msgid "<i>Attack before the hyena does.</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_Healthy_01
#. Speaker = Player
