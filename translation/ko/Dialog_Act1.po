msgctxt "hb818fa5dg5c39g4d94g9301g0d6b93c16a13"
msgid "That dowry? I'm keeping it."
msgstr "그 결혼 지참금? 내가 갖도록 하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Benryn
#. NodeID = 02e39303-2341-eeb4-4728-825686d8ba49
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:02e39303-2341-eeb4-4728-825686d8ba49
msgctxt "hb6886b79ga4d3g4c97gb0ceg4ab9deddfeaf"
msgid "Just go. Please."
msgstr "그냥 가요. 제발."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Benryn
#. NodeID = 06c1b310-572f-ca6c-b213-b523ae2ce2b5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:06c1b310-572f-ca6c-b213-b523ae2ce2b5
msgctxt "h53ebfadfg3a77g40dbg826eg4b01fbfa0b07"
msgid "Thank you. She can't have gone far."
msgstr "고마워요. 멀리 있지는 않을 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Benryn
#. NodeID = 09ba381b-32cb-44d6-2fb1-9ee77123c60d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:09ba381b-32cb-44d6-2fb1-9ee77123c60d
msgctxt "h20751f9fg3a2dg4a04g9a6dge4d96902f518"
msgid "This will never be right."
msgstr "이건 옳지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Player
#. NodeID = 0c322ebd-dd84-5aea-acf5-c7060bf3c3ec
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - PLA_StuckHalfElf_State_HasDowry(1) = True
#. SetFlags:
#.   Object:
#.     - PLA_StuckHalfElf_Event_GiveDowry(0) = True
#.   Quest:
#.     - PLA_StuckHalfElf.ReturnedGold(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:0c322ebd-dd84-5aea-acf5-c7060bf3c3ec
msgctxt "h0038c6bdg9531g44dfg95aag17ef6c0d2d2b"
msgid "Here. Take it."
msgstr "여기 있소. 가져가시오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Player
#. NodeID = 0ead2cbc-fa38-0732-0050-6ce44d4b742e
