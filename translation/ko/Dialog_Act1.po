#.     - GOB_DrunkGoblin_Event_Mocked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:3ee30493-b955-a004-976e-3a04728e5c4a
msgctxt "h59d51ad4ge824g42e3gbd4bgb34dc388b699"
msgid "There. I dun it."
msgstr "자. 됐어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Player
#. NodeID = 402320ea-43cd-53ca-f263-fdcb300566ae
#. HandlePath = TaggedText[0].TagText[0]
