#.      - BRANDED(0) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_GoblinWily_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinWily:50254d64-ce2e-0622-fb75-5fd64c063b40
msgctxt "he04664feg7b5fg490fgb0cbg6270d8ac16ef"
msgid ""
"If yer plannin' to talk ta the drow, watch yerself - she's in a right mood."
msgstr "그 드로우와 말할 계획이라면, 조심해. 기분이 안 좋으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinWily
#. Speaker = Tracker Tozad
#. NodeID = 69574f56-0623-4484-b697-315eb837e1e8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
