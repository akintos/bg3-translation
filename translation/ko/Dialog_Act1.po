msgctxt "h1af80fc9g5d03g425cga7e2g2f68d6175500"
msgid "I'm not normally one for literature, but there's something there."
msgstr "내가 문학에는 밝지 않지만, 확실히 이건 뭔가 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_ArcaneTower_PAD_Poems
#. Speaker = Player
#. NodeID = 83839bf1-cce1-4457-ab2f-082b4d446929
#. HandlePath = TaggedText[1].TagText[0]
