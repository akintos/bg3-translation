#.     - 8000b0ab-2e5f-c22d-8f09-7878115989ea_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_Refugee1:8e006016-b8aa-5cf8-a86b-9c6d978cdd61
msgctxt "h0a355c89g24e5g404eg975cg9a4c58d8692b"
msgid "What to bring..."
msgstr "챙겨야 할 게..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_Refugee1
#. Speaker = Eramas
#. NodeID = bae69b73-856a-bbea-4082-74824fd433e1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 8000b0ab-2e5f-c22d-8f09-7878115989ea_A = True
#.      - 8000b0ab-2e5f-c22d-8f09-7878115989ea_B = False
#.      - 8000b0ab-2e5f-c22d-8f09-7878115989ea_C = False
#. SetFlags:
#.   Local:
#.     - 8000b0ab-2e5f-c22d-8f09-7878115989ea_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_Refugee1:bae69b73-856a-bbea-4082-74824fd433e1
msgctxt "h383cd9bbge61eg4289g95b3g80afcf3db25c"
msgid "Right, I've got food, water, my dagger..."
msgstr "좋아. 음식에, 물이랑, 내 단검은 챙겨놨고..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_Refugee1
#. Speaker = Eramas
#. NodeID = c0638f05-abf2-4998-f7c0-0934b7b24ee2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 8000b0ab-2e5f-c22d-8f09-7878115989ea_A = True
#.      - 8000b0ab-2e5f-c22d-8f09-7878115989ea_B = True
#.      - 8000b0ab-2e5f-c22d-8f09-7878115989ea_C = False
#. SetFlags:
#.   Local:
#.     - 8000b0ab-2e5f-c22d-8f09-7878115989ea_C = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_Refugee1:c0638f05-abf2-4998-f7c0-0934b7b24ee2
msgctxt "h324962a0gac98g4731g95abg617afdff5125"
msgid "Shoes. Where are my boots?"
msgstr "신발. 내 부츠 어디다 뒀더라?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_Refugee4
#. Speaker = Toron
#. NodeID = 418230ea-1e3f-168d-a3c3-ffa0b8ffd273
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 9c2faf4f-9f24-e061-d8b9-0c5ea1412354_Switch = False
#. SetFlags:
#.   Local:
#.     - 9c2faf4f-9f24-e061-d8b9-0c5ea1412354_Switch = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_Refugee4:418230ea-1e3f-168d-a3c3-ffa0b8ffd273
msgctxt "h660a212dgcab1g4277ga0d9g434e793f0aba"
msgid ""
"Can't keep the goblins out forever. This is no fortress, and we're no "
"warriors."
msgstr "고블린을 영원히 막아낼 순 없을걸. 여기는 요새가 아니고, 우리는 전사가 아니라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_Refugee4
#. Speaker = Toron
#. NodeID = 53ed44a2-3adc-5299-400d-7d643655f232
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 9c2faf4f-9f24-e061-d8b9-0c5ea1412354_Switch = True
#. SetFlags:
#.   Local:
#.     - 9c2faf4f-9f24-e061-d8b9-0c5ea1412354_Switch = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_Refugee4:53ed44a2-3adc-5299-400d-7d643655f232
msgctxt "h1a2624afgde00g4d75gb01cgac1a9f62f2cf"
msgid ""
"The waiting's getting to me. If we left, we could at least make a run for it."
msgstr "가만히 있자니 죽을 맛이군. 차라리 여길 뜨면 도망이라도 시도할 수 있을 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard1
#. Speaker = Rikka
#. NodeID = a882beca-3a7f-d0a0-7d33-9a7328aa585d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard1:a882beca-3a7f-d0a0-7d33-9a7328aa585d
msgctxt "hab7a2565gca33g46a2gb5a7g35e4d724218b"
msgid "More goblins. What's next?"
msgstr "또 고블린이라니. 다음은 뭐지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard1
#. Speaker = Rikka
#. NodeID = bfb8cc5d-1df1-8771-793b-ef33cbc1f544
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Refugees_State_LeadersAreDead = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard1:bfb8cc5d-1df1-8771-793b-ef33cbc1f544
msgctxt "hb66fd1e8g6881g4df1gb845g2210a38e2d42"
msgid "Maybe things are finally getting better."
msgstr "이제야 슬슬 일이 좀 풀리려나 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard10
#. Speaker = Lakrissa
#. NodeID = f05a2ed9-08a9-7c91-913e-f240d132376a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard10:f05a2ed9-08a9-7c91-913e-f240d132376a
msgctxt "h39bec405g1cfdg41eagabd7ge72bbb2da1fc"
msgid "Goblins, gnolls... so many ways to die."
msgstr "고블린들, 놀들... 죽는 방법도 참 다양하구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard10
#. Speaker = Lakrissa
#. NodeID = fc14dd71-6d48-3cb4-5d0a-d7156bd25ed2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Refugees_State_LeadersAreDead = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard10:fc14dd71-6d48-3cb4-5d0a-d7156bd25ed2
msgctxt "h7e0d6442ga0bcg4b49g8f5bg9ff821a7c6f0"
msgid "The moment we arrive, I'm heading straight to Elfsong Tavern."
msgstr "도착하면 바로 엘프송 여관으로 갈 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard11
#. Speaker = Zorru
#. NodeID = 566e3461-2482-1e8f-0904-62a04b9b857c
