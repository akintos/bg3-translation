msgctxt "h09c32004g574bg467fgba86g6ed7cb39a47d"
msgid "((*come. we must speak*))"
msgstr "((*와라. 대화해야 한다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_BroodingMyconid_AD_DuergarDead
#. Speaker = Sovereign Glut
#. NodeID = e2238056-5b26-472e-9888-023b388c4c6e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_BroodingMyconid_AD_DuergarDead:e2238056-5b26-472e-9888-023b388c4c6e
msgctxt "h3f22564agc633g4138gb657g8fe4ce3880f2"
msgid "((*the fanfare is sung - the Rot is cleansed*))"
msgstr "((*팡파르가 울린다 - 부패가 정화된다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_BroodingMyconid_AD_Resurrecting
#. Speaker = Sovereign Glut
#. NodeID = 12404565-f2a0-2d7f-7fdb-39fea48505a1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_BroodingMyconid_AD_Resurrecting:12404565-f2a0-2d7f-7fdb-39fea48505a1
msgctxt "h441ebaf4g3a27g4134g9c47g8c26656e9e9e"
msgid "((*go - rest at your camp. my servant is not yet ready*))"
msgstr "((*가라 - 너의 야영지에서 쉬어라. 내 하인이 아직 준비되지 않았다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_BroodingMyconid_AD_Resurrecting
#. Speaker = Sovereign Glut
#. NodeID = f150a6b7-aaf5-06cf-e519-2c693c28be28
#. HandlePath = TaggedText[0].TagText[0]
