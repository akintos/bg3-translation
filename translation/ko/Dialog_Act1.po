msgctxt "h62c3035fg0283g42c2g89a6gccfb78e6a542"
msgid ""
"We slay Karlach, and we save these souls from eternal damnation. Justice "
"will be served."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Tollhouse_PAD_RefugeesAreCultists
#. Speaker = Player
#. NodeID = f3fdfd99-4dfb-4cca-b2fc-ea277e221fe3
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Tollhouse_PAD_RefugeesAreCultists:f3fdfd99-4dfb-4cca-b2fc-ea277e221fe3
msgctxt "hc1e8b3afgf826g4d7ega118g9d980b65f99d"
msgid ""
"They made the wrong deal, but they got themselves into that mess. They can "
"get themselves out."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Tollhouse_PAD_RefugeesAreCultists
#. Speaker = Player
#. NodeID = f3fdfd99-4dfb-4cca-b2fc-ea277e221fe3
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_SHADOWHEART
