msgctxt "hbaa9b736g2874g4ad7g8152g8dfc436a138e"
msgid "*...and awaits your first question.*"
msgstr "*...그리고선 당신의 첫 번째 질문을 기다립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DeadMyconid_Dead
