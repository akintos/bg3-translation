#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_KethericOrdersRead_PAD:7f22d09f-e260-4ebc-b71f-65d3880f94ac
msgctxt "h784be695g54f6g41beg88c2gc0338d31e5ac"
msgid "Hells - the Absolute's forces have taken father to Moonrise Towers."
msgstr "젠장, 절대자의 군대가 아버지를 문라이즈 타워로 데려갔어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_KethericOrdersRead_PAD
#. Speaker = Player
#. NodeID = 86668430-b508-08d5-1e63-2fee00c0521e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Wyll_Knows_RavengardFather = False
#.   Tag:
#.      - REALLY_WYLL(0) = True
#. SetFlags:
#.   Global:
#.     - CRE_Knows_DukeAtTowers = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_KethericOrdersRead_PAD:86668430-b508-08d5-1e63-2fee00c0521e
msgctxt "h80a6f5d9g0994g4486gb588g822e4e6dd444"
msgid ""
"Grand Duke Ravengard - abducted to Moonrise Towers? Hells - we need to talk."
msgstr "레이븐가드 대공이 문라이즈 타워로 납치되었다고? 젠장, 우리 얘기 좀 하자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_KethericOrdersRead_PAD
#. Speaker = Player
#. NodeID = 9b0473f6-a300-4aa6-aba9-da567ae4ab09
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_Tavern_Knows_DukeAtTowers = True
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_KethericOrdersRead_PAD:9b0473f6-a300-4aa6-aba9-da567ae4ab09
msgctxt "hb111a3fdg7d6fg4bdcgba1eg0d101c6be1ad"
msgid "A powerful asset. Just what are their intentions, I wonder?"
msgstr "엄청난 인물을 데려갔군. 궁금한 건 저들의 의도가 뭘까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_KethericOrdersRead_PAD
#. Speaker = Player
#. NodeID = c4f4d395-6f8a-433f-ac4a-da869e0c83c3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Wyll_Knows_RavengardFather = True
#. SetFlags:
#.   Global:
#.     - CRE_Knows_DukeAtTowers = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_KethericOrdersRead_PAD:c4f4d395-6f8a-433f-ac4a-da869e0c83c3
msgctxt "he609e77dg5877g4118g9a71gecbc5d57502f"
msgid "The Absolute's forces have taken Duke Ravengard to Moonrise Towers."
msgstr "절대자의 군대가 레이븐가드 공작을 문라이즈 타워로 데려갔어. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_KethericOrdersRead_PAD
#. Speaker = Player
#. NodeID = ff1486eb-4c50-2edf-3fae-6068d0b7cf3d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_KethericOrdersRead_PAD:ff1486eb-4c50-2edf-3fae-6068d0b7cf3d
msgctxt "h23a20128geeadg42a2g836cgf3781d3f32e0"
msgid "A powerful asset. Just what are their intentions, I wonder?"
msgstr "엄청난 인물을 데려갔군. 궁금한 건 저들의 의도가 뭘까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_AD_MagicMouthGauntlet01
#. Speaker = Narrator
#. NodeID = 1e797376-fff1-4b4a-857e-aa81e95b492b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_AD_MagicMouthGauntlet01:1e797376-fff1-4b4a-857e-aa81e95b492b
msgctxt "hbab1e85dg0bedg4dc6gba6dge190fa7708d9"
msgid ""
"*If thou readst this, trespasser: turn back, lest your life be forfeit.*"
msgstr "*침입자여, 이를 읽는다면 목숨을 빼앗기지 않게 돌아설지어다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_AD_MagicMouthGauntlet02
#. Speaker = Narrator
#. NodeID = 1379a499-5e7f-476e-a512-60f98cda0f46
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_AD_MagicMouthGauntlet02:1379a499-5e7f-476e-a512-60f98cda0f46
msgctxt "hba45cd8bgcab0g49f2g948fg51d4f8282fed"
msgid "*Lathander's light may be infinite, but his mercy is not. Return. Now.*"
msgstr "*라샌더의 빛은 무한하지만, 그의 자비는 그렇지 않다. 돌아가라. 당장.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_AD_MagicMouthGauntlet03
#. Speaker = Narrator
#. NodeID = 876d4581-68d7-4ea2-9151-129807f2dfbb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_AD_MagicMouthGauntlet03:876d4581-68d7-4ea2-9151-129807f2dfbb
msgctxt "h3bd79444gf868g4e97gb7a9g8d2365a55168"
msgid "*The Morninglord's wrath awaits, heretic. Retreat whilst thou can.*"
msgstr "*이단자여, 아침군주의 분노가 기다리니. 가능할 때 돌아갈지어다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_AD_MagicMouthWarning
#. Speaker = Bust
#. NodeID = ad15b755-83bb-4c74-aea7-95bbea94228a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_AD_MagicMouthWarning:ad15b755-83bb-4c74-aea7-95bbea94228a
msgctxt "h7832a755gc461g49d9gbafcg56e9457a4937"
msgid "Stand your ground! Keep them busy."
msgstr "물러서지 마라! 놈들을 지연시켜야 한다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_AD_MagicMouthWarning
#. Speaker = Bust
#. NodeID = da3938db-9896-4789-a83a-cf29562eca58
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_AD_MagicMouthWarning:da3938db-9896-4789-a83a-cf29562eca58
msgctxt "hb1138be6g4e62g41a3g957ag381c417387cd"
msgid "Lathander forgive me - we have to fire the Lance."
msgstr "라샌더님 용서하소서, 랜스를 발사해야 할 것 같아요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_CrecheDestroyed
#. Speaker = Player
#. NodeID = 27d94ae0-6d92-4182-97ab-1658ca90effb
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_CrecheDestroyed:27d94ae0-6d92-4182-97ab-1658ca90effb
msgctxt "h896a6d07g1f92g47cdgad87gee6524976587"
msgid "Gods - it's gone. Completely destroyed."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_CrecheDestroyed
#. Speaker = Player
#. NodeID = 27d94ae0-6d92-4182-97ab-1658ca90effb
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_CrecheDestroyed:27d94ae0-6d92-4182-97ab-1658ca90effb
msgctxt "h0bb0edccgd121g49d9g9a4cg5f5b50b43b59"
msgid "Nothing left but rubble. Thank Mystra I'm not buried under it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_CrecheDestroyed
#. Speaker = Player
#. NodeID = 27d94ae0-6d92-4182-97ab-1658ca90effb
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_CrecheDestroyed:27d94ae0-6d92-4182-97ab-1658ca90effb
msgctxt "hb3e2b8e7g91f2g427bg9fabg6523c4a3be4a"
msgid "All gone... was that really because of what <i>I</i> did?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_CrecheDestroyed
#. Speaker = Player
#. NodeID = 27d94ae0-6d92-4182-97ab-1658ca90effb
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_CrecheDestroyed:27d94ae0-6d92-4182-97ab-1658ca90effb
msgctxt "hb0b03725gf274g4331g8eafg368ef63e0b37"
msgid "What in the Nine Hells have I done?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_CrecheDestroyed
#. Speaker = Player
#. NodeID = 27d94ae0-6d92-4182-97ab-1658ca90effb
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_CrecheDestroyed:27d94ae0-6d92-4182-97ab-1658ca90effb
msgctxt "h30419b65g6b0cg4f6dgbae0g3b5e3f390919"
msgid "Just like that - gone. <i>Levelled.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_CrecheDestroyed
#. Speaker = Player
#. NodeID = 60f35683-a084-4a3a-8bfb-01c8e748a046
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_CrecheDestroyed:60f35683-a084-4a3a-8bfb-01c8e748a046
msgctxt "h1af2668agc470g43e1ga2dfg2ce2bd133c0e"
msgid "A shame I can't carry power like that in my pocket."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_CrecheDestroyed
#. Speaker = Player
#. NodeID = 60f35683-a084-4a3a-8bfb-01c8e748a046
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_CrecheDestroyed:60f35683-a084-4a3a-8bfb-01c8e748a046
msgctxt "h3ae31b9cg19a0g4d48gbfcbg9a6c2cfb927e"
msgid ""
"Better to be stood here than buried beneath a thousand tonnes of Trielta "
"limestone."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_CrecheDestroyed
#. Speaker = Player
#. NodeID = 60f35683-a084-4a3a-8bfb-01c8e748a046
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_CrecheDestroyed:60f35683-a084-4a3a-8bfb-01c8e748a046
msgctxt "h5d3337deg9eb1g4aaegba80gd7cbd87c37cd"
msgid ""
"Better get out of here. I don't relish the thought of explaining my part in "
"all of this..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_CrecheDestroyed
#. Speaker = Player
#. NodeID = 60f35683-a084-4a3a-8bfb-01c8e748a046
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_CrecheDestroyed:60f35683-a084-4a3a-8bfb-01c8e748a046
msgctxt "ha3e56e81gfd94g40fag93b0g28896f6c7123"
msgid "Death, destruction - and for what? A mace? A dusty artefact?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_CrecheDestroyed
#. Speaker = Player
#. NodeID = 60f35683-a084-4a3a-8bfb-01c8e748a046
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_CrecheDestroyed:60f35683-a084-4a3a-8bfb-01c8e748a046
msgctxt "h8f088d38gae79g4a6egb545geab2418c356f"
msgid "Wish it could've been avoided. It was pretty beautiful."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_CrecheDestroyed
#. Speaker = Player
#. NodeID = 6ffe94fa-3e5d-4dd5-9ff3-be044621de31
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_CrecheDestroyed:6ffe94fa-3e5d-4dd5-9ff3-be044621de31
msgctxt "hcb423328g0294g41d2g8df7gf896b6e436be"
msgid "It's gone - the entire place is just... gone."
msgstr "무너졌어, 그냥 여기 전체가 다... 무너졌어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_CrecheDestroyed
#. Speaker = Player
#. NodeID = 6ffe94fa-3e5d-4dd5-9ff3-be044621de31
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_CrecheDestroyed:6ffe94fa-3e5d-4dd5-9ff3-be044621de31
msgctxt "h26e8c189g21c6g4a92g805cgc288302e20f4"
msgid ""
"Well. I think it's safe to say we made quite an impact on that monastery."
msgstr "뭐, 우리가 수도원에 꽤 큰 충격을 줬다고 할 수 있겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_CrecheDestroyed
#. Speaker = Player
#. NodeID = 6ffe94fa-3e5d-4dd5-9ff3-be044621de31
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_CrecheDestroyed:6ffe94fa-3e5d-4dd5-9ff3-be044621de31
msgctxt "hfbe8e3a5g39c9g4235gb782gfa31909ba937"
msgid "It's gone - the whole damn crèche reduced to rubble."
msgstr "무너졌어, 양성소가 통째로 부스러기가 되어버렸어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_CrecheDestroyed
#. Speaker = Player
#. NodeID = 6ffe94fa-3e5d-4dd5-9ff3-be044621de31
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_CrecheDestroyed:6ffe94fa-3e5d-4dd5-9ff3-be044621de31
msgctxt "h1b9a3372gbcdag4206g9a12g891766255c06"
msgid "What in the Nine Hells have we done?"
msgstr "우리는 무슨 아홉 지옥 같은 짓을 저질러버린 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_CrecheDestroyed
#. Speaker = Player
#. NodeID = 6ffe94fa-3e5d-4dd5-9ff3-be044621de31
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_CrecheDestroyed:6ffe94fa-3e5d-4dd5-9ff3-be044621de31
msgctxt "h5b4982c3ge180g4f34g8a75g87c2d76fea06"
msgid "It's gone. Levelled to the ground."
msgstr "무너졌어. 땅과 하나가 되어버렸어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_CrecheDestroyed
#. Speaker = Player
#. NodeID = 6ffe94fa-3e5d-4dd5-9ff3-be044621de31
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#. TagRule: REALLY_GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_CrecheDestroyed:6ffe94fa-3e5d-4dd5-9ff3-be044621de31
msgctxt "h0fb5b7f1g903ag4319gaf43g132c114ad2f1"
msgid ""
"As a child, I thought a crèche an impenetrable fortress. I see now they are "
"like everything else - breakable."
msgstr ""
"어릴 때, 나는 양성소는 침범할 수 없는 요새라고 생각했지. 이젠 다른 것들과 다를 게 없다는 게 보이는군, 부서질 수 있다는 거."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_CrecheDestroyed
#. Speaker = Player
#. NodeID = 6ffe94fa-3e5d-4dd5-9ff3-be044621de31
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_CrecheDestroyed:6ffe94fa-3e5d-4dd5-9ff3-be044621de31
msgctxt "he0c7bc42g81f7g4495gaa83g92d60de24362"
msgid "It's gone - the entire crèche is destroyed."
msgstr "무너졌어, 양성소 전체가 파괴되었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_CrecheDestroyed
#. Speaker = Player
#. NodeID = 9c81ef89-4d7e-46d5-b453-451d982ba5df
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_CrecheDestroyed:9c81ef89-4d7e-46d5-b453-451d982ba5df
msgctxt "hc36424c5g3bfag4e3eg9ec4g4cb74f311cf0"
msgid "Well, you don't see power like that every day."
msgstr "뭐, 이런 힘을 매일 보진 못하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_CrecheDestroyed
#. Speaker = Player
#. NodeID = 9c81ef89-4d7e-46d5-b453-451d982ba5df
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_CrecheDestroyed:9c81ef89-4d7e-46d5-b453-451d982ba5df
msgctxt "h68acfab5g3f69g4b82gba08g38ab0feb9d37"
msgid ""
"I hope we don't plan to destroy any further historic landmarks. One is quite "
"enough for me."
msgstr "우리가 앞으로 역사적 거점을 더 파괴할 일이 없길 바라. 나는 하나로 충분하고도 남아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_CrecheDestroyed
#. Speaker = Player
#. NodeID = 9c81ef89-4d7e-46d5-b453-451d982ba5df
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_CrecheDestroyed:9c81ef89-4d7e-46d5-b453-451d982ba5df
msgctxt "h7503fc0fg7156g4a73g92f8g3ef678e4f522"
msgid "So much death and destruction - and for what? A mace? A dusty artefact?"
msgstr "너무 많은 죽음과 파괴가 이루어졌어, 도대체 무엇을 위해서? 메이스 하나? 고작 먼지 쌓인 유물 하나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_CrecheDestroyed
#. Speaker = Player
#. NodeID = 9c81ef89-4d7e-46d5-b453-451d982ba5df
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_CrecheDestroyed:9c81ef89-4d7e-46d5-b453-451d982ba5df
msgctxt "h63dc9854gd204g4a72gbe98gf9348e2ae1d1"
msgid "Let's leave, before we're asked to pay for damages - in gold or blood."
msgstr "어서 떠나자, 피해 보상을 청구당하기 전에 말이야, 돈으로던 피로던."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_CrecheDestroyed
#. Speaker = Player
#. NodeID = 9c81ef89-4d7e-46d5-b453-451d982ba5df
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_CrecheDestroyed:9c81ef89-4d7e-46d5-b453-451d982ba5df
msgctxt "hb99a58e9ged71g471bgbec2gae6573257892"
msgid "It's a pity. That place was pretty beautiful."
msgstr "참 안됐네. 꽤 아름다운 장소였는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_CrecheDestroyed
#. Speaker = Player
#. NodeID = bd10c621-cca6-c2d2-dce3-f633c55ae525
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(0) = False
#.      - REALLY_WYLL(0) = False
#.      - REALLY_SHADOWHEART(0) = False
#.      - REALLY_GALE(0) = False
#.      - REALLY_LAEZEL(0) = False
#.      - REALLY_ASTARION(0) = False
#. TagRule: REALLY_GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_CrecheDestroyed:bd10c621-cca6-c2d2-dce3-f633c55ae525
msgctxt "h08bb71f3g566dg4143ga7d9gbaf4c7f008ce"
msgid "Never thought I'd be the one to destroy a crèche. And get away with it."
msgstr "내가 양성소를 부수게 될 거라고는 생각도 못 했어. 그리고 도망칠 수 있을 거라고도. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_CrecheDestroyed
#. Speaker = Player
#. NodeID = bd10c621-cca6-c2d2-dce3-f633c55ae525
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(0) = False
#.      - REALLY_WYLL(0) = False
#.      - REALLY_SHADOWHEART(0) = False
#.      - REALLY_GALE(0) = False
#.      - REALLY_LAEZEL(0) = False
#.      - REALLY_ASTARION(0) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_CrecheDestroyed:bd10c621-cca6-c2d2-dce3-f633c55ae525
msgctxt "h1129540fg8c04g4e0cg85afgc8d5047d4e37"
msgid "Barely got away. Those githyanki aren't so lucky."
msgstr "겨우 도망쳐 나왔어. 저 기스양키들은 운이 나빴네. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance
#. Speaker = Player
#. NodeID = 38e34537-7f4b-4c29-9198-f476505e22fc
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance:38e34537-7f4b-4c29-9198-f476505e22fc
msgctxt "h8f201720g3a9bg4a61gbd47g6104043171c5"
msgid "I was almost buried here. That was altogether too close."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance
#. Speaker = Player
#. NodeID = 38e34537-7f4b-4c29-9198-f476505e22fc
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance:38e34537-7f4b-4c29-9198-f476505e22fc
msgctxt "h3d21e753g8385g4eb1ga0f4g39a51fe2c485"
msgid "An exceedingly close shave. The entire place was nearly destroyed."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance
#. Speaker = Player
#. NodeID = 38e34537-7f4b-4c29-9198-f476505e22fc
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance:38e34537-7f4b-4c29-9198-f476505e22fc
msgctxt "h7f185f5fgc78fg482bg9f3bg8ea95917a303"
msgid "That was a close one. Whole place almost came down around our ears.\n"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance
#. Speaker = Player
#. NodeID = 38e34537-7f4b-4c29-9198-f476505e22fc
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance:38e34537-7f4b-4c29-9198-f476505e22fc
msgctxt "hd67c5951g76a4g4bb7g9ad0g6b4fcfa08bb3"
msgid "It is done - my duty fulfilled, my people spared."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance
#. Speaker = Player
#. NodeID = 38e34537-7f4b-4c29-9198-f476505e22fc
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance:38e34537-7f4b-4c29-9198-f476505e22fc
msgctxt "h6dd7c10egb49cg423ega801gd8e06653d7e0"
msgid ""
"Too close for my liking - this entire place could have come down around me."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance
#. Speaker = Player
#. NodeID = 38e34537-7f4b-4c29-9198-f476505e22fc
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance:38e34537-7f4b-4c29-9198-f476505e22fc
msgctxt "h6b0ca3edg4b71g4ca6g8c46gc67be248de9f"
msgid ""
"Talk about cutting it close. The entire place could have come crashing down."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance
#. Speaker = Player
#. NodeID = 38e34537-7f4b-4c29-9198-f476505e22fc
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance:38e34537-7f4b-4c29-9198-f476505e22fc
msgctxt "hfb4aa5f2g0718g46b1g9881gf1b34b09d092"
msgid "That was close - this entire place would've been destroyed. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance
#. Speaker = Player
#. NodeID = 3fa9341e-1ead-4d49-b4b4-1b4d227b1fe6
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance:3fa9341e-1ead-4d49-b4b4-1b4d227b1fe6
msgctxt "hcf64250bg2496g4b41g85c4g9ab903414ac5"
msgid ""
"That would have taken out the monastery, the crèche, <i>and most definitely "
"us</i>."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance
#. Speaker = Player
#. NodeID = 3fa9341e-1ead-4d49-b4b4-1b4d227b1fe6
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance:3fa9341e-1ead-4d49-b4b4-1b4d227b1fe6
msgctxt "hb9f1b12bgd5b2g421dgaa61gfe69c49f8ed0"
msgid ""
"If I have any choice as to where I die, I'd rather it not be in the bowels "
"of a ruined monastery."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance
#. Speaker = Player
#. NodeID = 3fa9341e-1ead-4d49-b4b4-1b4d227b1fe6
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance:3fa9341e-1ead-4d49-b4b4-1b4d227b1fe6
msgctxt "h70afb790gc8adg4247gb860g63e61d557bbb"
msgid "I didn't claw my way out of Avernus to go out in a pile of rubble.\n"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance
#. Speaker = Player
#. NodeID = 3fa9341e-1ead-4d49-b4b4-1b4d227b1fe6
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance:3fa9341e-1ead-4d49-b4b4-1b4d227b1fe6
msgctxt "h5beb4f5dg72e4g406cg8916g56e1c4508928"
msgid ""
"Indeed. I don't know what I'd look for in a final resting place, but this "
"isn't it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance
#. Speaker = Player
#. NodeID = 3fa9341e-1ead-4d49-b4b4-1b4d227b1fe6
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance:3fa9341e-1ead-4d49-b4b4-1b4d227b1fe6
msgctxt "h08a04cbbg14ecg4bcbgbcccgb5e19fa2f6fc"
msgid ""
"I'll say. Being smothered by rubble is not how I'd like to spend my final "
"moments."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance
#. Speaker = Player
#. NodeID = 3fa9341e-1ead-4d49-b4b4-1b4d227b1fe6
#. HandlePath = TaggedText[5].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance:3fa9341e-1ead-4d49-b4b4-1b4d227b1fe6
msgctxt "h82efbfeag6268g4aa3g8bc5g176e876ed549"
msgid "Dying under this monastery would've been a shame. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance
#. Speaker = Player
#. NodeID = 412905f8-2c4b-48a4-a51d-31e16b9e8421
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
