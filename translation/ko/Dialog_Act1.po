msgctxt "ha90a9e11g6bdfg4bdbga058gb80c23348edb"
msgid "<i>Where are the others? Mari, Barton? Did he kill them...?</i>"
msgstr "<i>나머지 애들은 어떻게 된 거야? 마리랑 바튼은? 설마 이놈 손에 죽었나...?</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_BanditBackInteraction_Spotted
#. Speaker = Gimblebock
#. NodeID = 6cd70d92-cb8b-9e09-e0cc-5bee381040af
