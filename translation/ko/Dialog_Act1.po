msgctxt "h44852d21g9c2ag454agad6egd4c0865b3359"
msgid "True Soul. Absolute. What ravings are these?"
msgstr "참된 영혼. 절대자. 이게 다 무슨 정신 나간 소리지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene
#. Speaker = Player
#. NodeID = 20dc1620-e337-5f7a-9fd1-c999644acf18
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
