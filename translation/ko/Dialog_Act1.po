msgctxt "h744292ebg213dg4afdg9e8ageefc841154a4"
msgid "*The statue starts to rotate, but its rusty mechanism jams stuck.*"
msgstr "*조각상이 회전하기 시작하다가 녹슬은 장치가 걸려 꼼짝도 안 합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_StatuePuzzle_AD_West
#. Speaker = Narrator
#. NodeID = e2d2e647-8499-e774-a0d8-ce64f2a31512
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_StatuePuzzle_AD_West:e2d2e647-8499-e774-a0d8-ce64f2a31512
msgctxt "hd371844bg18e2g4cd7gacc0g1780dedbd93a"
msgid "*Lathander bids the setting sun a fond farewell.*"
msgstr "*라샌더가 저무는 태양에 다정한 작별을 고합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_StatuePuzzle_PAD_AthleticsCheckFailed
