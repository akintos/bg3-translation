msgstr "엘투렐... 다들 우리한테 화내서... 도망쳤어..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_General_Dead_SnakeKid
#. Speaker = Arabella
#. NodeID = d3cd5b09-3301-444f-9a01-1d24f6a0ae76
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_General_Dead_SnakeKid:d3cd5b09-3301-444f-9a01-1d24f6a0ae76
msgctxt "hd2a04d39g7723g480cgb9c7gb9ad5f7b7ea5"
msgid "Arabella... I'm nine and a half..."
msgstr "아라벨라... 아홉살 반..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_General_Dead_SnakeKid
#. Speaker = Narrator
#. NodeID = d3fe74f7-4a52-4032-9155-106feba94a21
