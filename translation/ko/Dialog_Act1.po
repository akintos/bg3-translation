#.      - GITHYANKI(1) = False
#. SetFlags:
#.   Dialog:
#.     - CRE_General_HasMet_CrecheGuard04(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheGuard04:a4cc8775-75ff-2d8b-3310-c396e0796b0e
msgctxt "h42d7f826g3e77g4f76g848dg500393c8ab16"
msgid ""
"Now <i>istik</i> wander our halls at their leisure? Captain Therezzyn will "
"be even more irate than usual."
msgstr "이젠 <i>이스틱</i>이 느긋하게 복도를 활보한다고? 테레진 대장님이 평소보다 더 분노하시겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheGuard04
#. Speaker = Raider Ahu'u'rag
#. NodeID = f9a90aec-ffb9-ed62-482d-9c4cef916ad9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet_CrecheGuard04(1) = True
#.   Tag:
#.      - GITHYANKI(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheGuard04:f9a90aec-ffb9-ed62-482d-9c4cef916ad9
msgctxt "h9688f4efge2adg45c7g8f78g36dbd66293d6"
msgid ""
"Strange that one of your kind would be allowed here, especially during an "
"inquisition."
msgstr "너희 족속이 입장을 허가받다니 이상한 일이군. 심지어 심문 중에 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheGuard05
#. Speaker = Warrior Yr'rk
#. NodeID = 2af414c2-a83c-4600-9903-e0220c84725b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet_CrecheGuard05(1) = True
#.   Tag:
#.      - GITHYANKI(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheGuard05:2af414c2-a83c-4600-9903-e0220c84725b
msgctxt "h4772a6c9ge949g4ff3g8ecbg94c35b39ed3d"
msgid ""
"On second thoughts, perhaps an inquisitive <i>istik </i>would make a good "
"practice dummy."
msgstr "다시 생각해 보니, 어쩌면 호기심 많은 <i>이스틱</i>이 좋은 연습 인형을 만들어 줄 수도 있겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheGuard05
#. Speaker = Warrior Yr'rk
#. NodeID = 7bcf433a-b2c6-42cb-b933-f6dcc518ed89
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet_CrecheGuard05(1) = True
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheGuard05:7bcf433a-b2c6-42cb-b933-f6dcc518ed89
msgctxt "h0f28f7aeg3901g4525ga82fga361f2e23a80"
msgid ""
"Inquisitor W'wargaz will surely be satisfied with today's training session. "
"<i>Surely</i>."
msgstr "심문관 와르가즈께서는 정말로 오늘 훈련 시간을 만족하실 테야. <i>정말로</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheGuard05
#. Speaker = Warrior Yr'rk
#. NodeID = 83923e0b-3255-4c47-af6d-9bc5114c72e4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet_CrecheGuard05(1) = False
#.   Tag:
#.      - GITHYANKI(1) = True
#. SetFlags:
#.   Dialog:
#.     - CRE_General_HasMet_CrecheGuard05(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheGuard05:83923e0b-3255-4c47-af6d-9bc5114c72e4
msgctxt "h34a8b197g1fa5g48ecgae75g1719c437bf9c"
msgid ""
"The <i>sa'varsh</i> is running even stricter drills than usual for the "
"<i>yanki</i>. Glad I passed that mark already."
msgstr "<i>사바쉬</i>는 평소보다 <i>양키</i>들을 더 엄격하게 훈련하고 있어. 난 이미 통과해서 다행이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheGuard05
#. Speaker = Warrior Yr'rk
#. NodeID = cf7bdc4e-c926-d468-4f15-5d7dead25d16
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet_CrecheGuard05(1) = False
#.   Tag:
#.      - GITHYANKI(1) = False
#. SetFlags:
#.   Dialog:
#.     - CRE_General_HasMet_CrecheGuard05(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheGuard05:cf7bdc4e-c926-d468-4f15-5d7dead25d16
msgctxt "h06fab9e7ga298g46b3gbc90g7cd91c3f7480"
msgid ""
"The <i>yanki</i> are distracted enough; they don't need your interference."
msgstr "<i>양키</i>들이 집중을 못 하고 있잖아. 네놈의 방해는 필요 없다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheGuard06
#. Speaker = Raider Zar'an
#. NodeID = 106f53cb-f96e-421c-89c4-373f9c48d044
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet_CrecheGuard06(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheGuard06:106f53cb-f96e-421c-89c4-373f9c48d044
msgctxt "ha5cde412g5890g420bg97a4g6a6f05e46b0a"
msgid "I am watching you, <i>istik</i>."
msgstr "지켜보고 있다, <i>이스틱</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheGuard06
#. Speaker = Raider Zar'an
#. NodeID = ddf42515-15ca-45be-8b98-bb0b3eb1bfe6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet_CrecheGuard06(1) = True
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheGuard06:ddf42515-15ca-45be-8b98-bb0b3eb1bfe6
msgctxt "hf55a7208g2dceg4874ga3eagd6c7d829eaf9"
msgid "Kin."
msgstr "동포여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheGuard06
#. Speaker = Raider Zar'an
#. NodeID = e302f7c1-3527-4d77-b0ed-1180fc804949
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#. SetFlags:
#.   Dialog:
#.     - CRE_General_HasMet_CrecheGuard06(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheGuard06:e302f7c1-3527-4d77-b0ed-1180fc804949
msgctxt "h9c6e45d9g1a26g4177g9388gf3be5752b423"
msgid "Be welcome, kin, but do not disturb our peace."
msgstr "환영한다, 동포여. 하지만 우리의 평화를 깨진 말아주게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheGuard06
#. Speaker = Raider Zar'an
#. NodeID = f4696c1d-46d0-457d-8638-fb81f07cd2b8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CRE_General_HasMet_CrecheGuard06(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheGuard06:f4696c1d-46d0-457d-8638-fb81f07cd2b8
msgctxt "h1f63f174g90d3g4518g8bb6gd129281b4df1"
msgid "You are permitted in here. Do not confuse that with being welcome."
msgstr "넌 여기 들어오는 것을 허락받았다. 환영받는 걸로 착각하지 말라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheKid01
#. Speaker = Kyr'das
#. NodeID = 04059e78-cf86-4f80-918f-cb314c58d551
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet_CrecheKid01(1) = True
#.   Global:
#.      - CRE_YouthTraining_State_BackToClass = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheKid01:04059e78-cf86-4f80-918f-cb314c58d551
msgctxt "h34702714g42ccg401eg8addgd0bfc990698b"
msgid "I hope we start training with weapons soon. Reading is so boring."
msgstr "빨리 무기로 훈련을 시작했으면 좋겠어. 읽는 건 너무 지루해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheKid01
#. Speaker = Kyr'das
#. NodeID = 1b94a285-6c25-d9c0-d349-2d1168bfa2bc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet2_CrecheKid01(1) = False
#.   Global:
#.      - CRE_YouthTraining_State_BackToClass = False
#. SetFlags:
#.   Dialog:
#.     - CRE_General_HasMet2_CrecheKid01(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheKid01:1b94a285-6c25-d9c0-d349-2d1168bfa2bc
msgctxt "hc33e4fc8g2aa1g4253gb1e4gec4775e94c3b"
msgid "Want to watch Varrl get punished? He's in sooo much trouble."
msgstr "발이 벌 받는 거 보고 싶어? 걔 지금 완아아아전 망했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheKid01
#. Speaker = Kyr'das
#. NodeID = cdb299b5-ca1a-4cc6-a962-614cb6c1d417
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet_CrecheKid01(1) = False
#.   Global:
#.      - CRE_YouthTraining_State_BackToClass = True
#. SetFlags:
#.   Dialog:
#.     - CRE_General_HasMet_CrecheKid01(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheKid01:cdb299b5-ca1a-4cc6-a962-614cb6c1d417
msgctxt "hf28518eag60f1g45e1g908ag0def74bc504b"
msgid "Did you see that? What a wimp! I'm way braver than Varrl."
msgstr "저거 봤어? 질질 짜는 거! 내가 발보다 훨씬 더 용감하다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheKid01
#. Speaker = Kyr'das
#. NodeID = da6645dd-8011-76fe-9442-acccf4624a3e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet2_CrecheKid01(1) = True
#.   Global:
#.      - CRE_YouthTraining_State_BackToClass = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheKid01:da6645dd-8011-76fe-9442-acccf4624a3e
msgctxt "hf849c600g24b6g447dga361g27c6df0d73df"
msgid "Go on - try and get a closer look! I'll wait here..."
msgstr "가봐, 가서 자세히 보라고! 난 여기서 기다릴게..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheKid02
#. Speaker = Ul'mirel
#. NodeID = 1900a0da-5e9d-5d35-5e37-17d9416e4d96
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet2_CrecheKid02(1) = True
#.   Global:
#.      - CRE_YouthTraining_State_BackToClass = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheKid02:1900a0da-5e9d-5d35-5e37-17d9416e4d96
msgctxt "h38e0f83cge262g45e8g8b19gd430ebcb45b7"
msgid "I'd never just <i>stand</i> there getting hit. It's stupid."
msgstr "나라면 저기 <i>가만히 서서</i> 맞고 있지 않을 거야. 바보 같은 짓이라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheKid02
#. Speaker = Ul'mirel
#. NodeID = 1a846f4a-0cb2-a82b-fa25-429cd280b7f3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet2_CrecheKid02(1) = False
#.   Global:
#.      - CRE_YouthTraining_State_BackToClass = False
#. SetFlags:
#.   Dialog:
#.     - CRE_General_HasMet2_CrecheKid02(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheKid02:1a846f4a-0cb2-a82b-fa25-429cd280b7f3
msgctxt "h6b9ed11cgc7ccg454ag85cbg644e387e7e34"
msgid "Varrl's so weird. Why doesn't he fight back?"
msgstr "발 쟤는 좀 이상해. 왜 반격하지를 않지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheKid02
#. Speaker = Ul'mirel
#. NodeID = 38853d42-bab5-4c7f-aca4-4ea39c81e67b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet_CrecheKid02(1) = True
#.   Global:
#.      - CRE_YouthTraining_State_BackToClass = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheKid02:38853d42-bab5-4c7f-aca4-4ea39c81e67b
msgctxt "heb4a5d40gb6e6g4604g8f63ge5cd56a271e6"
msgid "I bet you never had to do all this <i>learning</i>..."
msgstr "너는 이렇게 <i>공부</i>할 필요 없었겠지..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheKid02
#. Speaker = Ul'mirel
#. NodeID = aa8d063a-600b-4103-9e4a-6f0a6c4a1cde
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet_CrecheKid02(1) = False
#.   Global:
#.      - CRE_YouthTraining_State_BackToClass = True
#. SetFlags:
#.   Dialog:
#.     - CRE_General_HasMet_CrecheKid02(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheKid02:aa8d063a-600b-4103-9e4a-6f0a6c4a1cde
msgctxt "h4f22df70gc112g4466g8a65g3cf3274f613b"
msgid "Sa'varsh Kethk won't let us do anything fun 'til we pass this test."
msgstr "사바쉬 케스크는 우리가 이 시험을 통과하기 전까지 놀게 놔두지 않을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheKid02
#. Speaker = Ul'mirel
#. NodeID = de044fbb-4ed1-b6ae-39ff-93389967e020
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheKid02:de044fbb-4ed1-b6ae-39ff-93389967e020
msgctxt "h08a6d658g82e1g457fga0d2g8561876d11b9"
msgid "I just want to learn how to crush someone's brain with my mind. Splat!"
msgstr "난 정신으로 다른 녀석의 뇌를 박살 내는 걸 배우고 싶다고. 뿌직!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheKid03
#. Speaker = Gha'an
#. NodeID = 3e4253da-61e5-4604-8197-ac7b7de646a6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet_CrecheKid03(1) = True
#.   Global:
#.      - CRE_YouthTraining_State_BackToClass = True
#.   Tag:
#.      - GITHYANKI(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheKid03:3e4253da-61e5-4604-8197-ac7b7de646a6
msgctxt "h834fb2f2g8cf6g4ef1g994bg6ef9db53ece0"
msgid "Stop sneaking around, or I'll tell the <i>sa'varsh</i> on you!"
msgstr "살금살금 돌아다니는 건 그만두시지, 계속 그러면 <i>사바쉬</i>께 이를 거야!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheKid03
#. Speaker = Gha'an
#. NodeID = 4f2fd469-c081-d123-1445-6101dbcf6f74
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet2_CrecheKid03(1) = True
#.   Global:
#.      - CRE_YouthTraining_State_BackToClass = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheKid03:4f2fd469-c081-d123-1445-6101dbcf6f74
msgctxt "hda79b323gf34eg4c07g92b5g6a8ca4b5618a"
msgid "Stop bothering us, or - or I'll report you!"
msgstr "귀찮게 좀 하지 마. 아니면 너 그... 보고할 거야!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheKid03
#. Speaker = Gha'an
#. NodeID = 7ab02008-d766-15cd-7587-fb394f2fc988
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet_CrecheKid03(1) = True
#.   Global:
#.      - CRE_YouthTraining_State_BackToClass = True
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheKid03:7ab02008-d766-15cd-7587-fb394f2fc988
msgctxt "h9b3d2e24gaca1g4f2ega2a6gec13936e4185"
msgid ""
"When I'm older, I'm going to be strong and scary and powerful, just like the "
"<i>sa'varsh</i>."
msgstr "어른이 되면, 난 힘세고 무섭고 강력해질 거야. 사바쉬처럼 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheKid03
#. Speaker = Gha'an
#. NodeID = c95cf6c7-116d-4060-c8e1-218163c8339d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet2_CrecheKid03(1) = False
#.   Global:
#.      - CRE_YouthTraining_State_BackToClass = False
#. SetFlags:
#.   Dialog:
#.     - CRE_General_HasMet2_CrecheKid03(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheKid03:c95cf6c7-116d-4060-c8e1-218163c8339d
msgctxt "h924d855cgee64g457dga23fg2d2a99053206"
msgid "We're not skiving! We're just waiting for our lesson to start..."
msgstr "우리 딴짓하는 거 아냐! 수업 시작하는 걸 기다리고 있는 거라고..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheKid03
#. Speaker = Gha'an
#. NodeID = d629e86a-d9c2-5045-823d-baaddde0850e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet_CrecheKid03(1) = False
#.   Global:
#.      - CRE_YouthTraining_State_BackToClass = True
#.   Tag:
#.      - GITHYANKI(1) = False
#. SetFlags:
#.   Dialog:
#.     - CRE_General_HasMet_CrecheKid03(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheKid03:d629e86a-d9c2-5045-823d-baaddde0850e
msgctxt "h795a3bb3g9fe3g4eafga595g585fff559124"
msgid "Outsiders aren't supposed to see us training. You - you should leave!"
msgstr "우리 훈련을 외부인이 보면 안 돼. 너... 너 나가라고!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheKid03
#. Speaker = Gha'an
#. NodeID = f859ac89-c5ff-4ed4-b031-5cbe96f66091
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet_CrecheKid03(1) = False
#.   Global:
#.      - CRE_YouthTraining_State_BackToClass = True
#.   Tag:
#.      - GITHYANKI(1) = True
#. SetFlags:
#.   Dialog:
#.     - CRE_General_HasMet_CrecheKid03(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheKid03:f859ac89-c5ff-4ed4-b031-5cbe96f66091
msgctxt "h46b39d76g441dg4517g9815g61de7fcacdd1"
msgid "You look too old to be training with us. Way too old."
msgstr "넌 우리랑 훈련하기에는 나이가 많아 보이는데. 너무 많아 보여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheKid03
#. Speaker = Gha'an
#. NodeID = f859ac89-c5ff-4ed4-b031-5cbe96f66091
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet_CrecheKid03(1) = False
#.   Global:
#.      - CRE_YouthTraining_State_BackToClass = True
#.   Tag:
#.      - GITHYANKI(1) = True
#. SetFlags:
#.   Dialog:
#.     - CRE_General_HasMet_CrecheKid03(1) = True
#. TagRule: !GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheKid03:f859ac89-c5ff-4ed4-b031-5cbe96f66091
msgctxt "h198b61a9g7c45g44d8gbc37g9ab76adf9fe2"
msgid "Outsiders aren't supposed to see us training. You... you should leave!"
msgstr "우리 훈련을 외부인이 보면 안 돼. 네 녀석... 너는 나가!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheKid04
#. Speaker = Jheruth
#. NodeID = 0043f7dc-78b2-5869-cbfc-05a4e3a16e84
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet2_CrecheKid04(1) = False
#.   Global:
#.      - CRE_YouthTraining_State_BackToClass = False
#. SetFlags:
#.   Dialog:
#.     - CRE_General_HasMet2_CrecheKid04(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheKid04:0043f7dc-78b2-5869-cbfc-05a4e3a16e84
msgctxt "h69a193d7g565dg4d3fgba4eg041c96b4b32b"
msgid "Um, are you here to see the <i>sa'varsh?</i>"
msgstr "음, <i>사바쉬</i>를 찾아오셨나요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheKid04
#. Speaker = Jheruth
#. NodeID = 235d7703-242a-f266-0f4a-2480128da576
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheKid04:235d7703-242a-f266-0f4a-2480128da576
msgctxt "h5404e1bdg11d5g46abgb2ddgbced5b31f946"
msgid ""
"Stop distracting me. I have to learn this, or the <i>sa'varsh</i> will get "
"angry again."
msgstr "저 좀 방해하지 마세요. 이걸 다 외우지 못하면, <i>사바쉬</i>께서 또 화를 내실 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheKid04
#. Speaker = Jheruth
#. NodeID = 39f0aebd-b579-46e5-a7b3-2ba210dc4e7b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet_CrecheKid04(1) = True
#.   Global:
#.      - CRE_YouthTraining_State_BackToClass = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheKid04:39f0aebd-b579-46e5-a7b3-2ba210dc4e7b
msgctxt "h4f9d59b6g4583g47e6gbc22g9726fe6142c6"
msgid ""
"During cere - ceremorphosis, the brain stem is reconnected to the circul - "
"culatory system -"
msgstr "내변... 뇌변이 과정 중에, 뇌줄기는 수난... 순환 계통에 다시 연결된다..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheKid04
#. Speaker = Jheruth
#. NodeID = 7b21ea91-d063-dc04-0c55-1560b164f867
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheKid04:7b21ea91-d063-dc04-0c55-1560b164f867
msgctxt "h7dd458bage5b6g4acdga110g5a842b70bb08"
msgid "He's over there, but he's in a bad mood..."
msgstr "저기 계시는데, 분위기가 안 좋아요.."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheKid04
#. Speaker = Jheruth
#. NodeID = 7d3d7b7a-f0c4-fff2-897b-56340ab77eb6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet2_CrecheKid04(1) = True
#.   Global:
#.      - CRE_YouthTraining_State_BackToClass = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheKid04:7d3d7b7a-f0c4-fff2-897b-56340ab77eb6
msgctxt "h3f930c8fg4137g446cga509g3fbaf381131b"
msgid ""
"Maybe you can try and cheer the <i>sa'varsh </i>up? I think he needs it."
msgstr "당신이 <i>사바쉬</i>의 기분을 풀어드리는 건 어때요? 그런 게 좀 필요해 보여서요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheKid04
#. Speaker = Jheruth
#. NodeID = 80d515ba-dd75-429b-bb49-97401cc1afe6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet_CrecheKid04(1) = False
#.   Global:
#.      - CRE_YouthTraining_State_BackToClass = True
#. SetFlags:
#.   Dialog:
#.     - CRE_General_HasMet_CrecheKid04(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheKid04:80d515ba-dd75-429b-bb49-97401cc1afe6
msgctxt "hed3f6553g4e2bg4d6bg8f47gdfd4bc090e13"
msgid "<i>Ghaik </i>have six major arteries. No wait, seven."
msgstr "<i>게이크 </i>는 대동맥이 6개 있다. 아, 잠깐. 7개였다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheKid04
#. Speaker = Jheruth
#. NodeID = a2f9b880-5959-f78a-e40d-e6751a02c9b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheKid04:a2f9b880-5959-f78a-e40d-e6751a02c9b4
msgctxt "hec1a1672gbb57g4ed8ga578g5b73bd9f16f8"
msgid "Ugh. I'll never remember everything. Why am I so stupid?"
msgstr "으윽. 매번 다 외우질 못하네. 난 왜 이렇게 바보 같지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheTeenager01
#. Speaker = Youth Mirya'al
#. NodeID = 4340db4e-c422-4ffc-8a28-0c1d2cc1da2e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet_CrecheTeenager01(1) = True
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheTeenager01:4340db4e-c422-4ffc-8a28-0c1d2cc1da2e
msgctxt "he492f6b5gd05cg4584g9829ge1a33481690f"
msgid ""
"<i>Vlaakith... Vlaakith'ka... sivim hra... sivim hrath krash'ht. </i>Was "
"that right?"
msgstr "<i>블라키스.. 블라키스'카... 시빔 흐라... 시빔 흐라스 크라쉬'잇 </i>제대로 했나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheTeenager01
#. Speaker = Youth Mirya'al
#. NodeID = a68d9cd4-2865-bd16-f211-eda15f098f39
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet_CrecheTeenager01(1) = True
#.   Tag:
#.      - GITHYANKI(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheTeenager01:a68d9cd4-2865-bd16-f211-eda15f098f39
msgctxt "h9e954d7bg0f59g4db2g9880g821db81a4aa7"
msgid ""
"I'm watching you, <i>istik</i>... I'm sure the Inquisitor will want to hear "
"my report."
msgstr "지켜보고 있다, <i>이스틱</i>... 심판관께선 내 보고를 받고 싶어하실 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheTeenager01
#. Speaker = Youth Mirya'al
#. NodeID = b75d6d56-2339-475e-ba9f-91ba0e9603fd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet_CrecheTeenager01(1) = False
#.   Tag:
#.      - GITHYANKI(1) = True
#. SetFlags:
#.   Dialog:
#.     - CRE_General_HasMet_CrecheTeenager01(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheTeenager01:b75d6d56-2339-475e-ba9f-91ba0e9603fd
msgctxt "hcf74056ag67d9g45fegaa26g7365d9cd3772"
msgid "Rest time feels so wasteful. I could be <i>training</i> right now."
msgstr "휴식이라니 시간 낭비야. 지금 바로 <i>훈련</i>에 나갈 수 있다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheTeenager01
#. Speaker = Youth Mirya'al
#. NodeID = e3406e97-bd41-04ed-3435-27f04faec9f9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet_CrecheTeenager01(1) = False
#.   Tag:
#.      - GITHYANKI(1) = False
#. SetFlags:
#.   Dialog:
#.     - CRE_General_HasMet_CrecheTeenager01(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheTeenager01:e3406e97-bd41-04ed-3435-27f04faec9f9
msgctxt "hcac7e775g4e69g424bg9e1dgfa01bb2e0801"
msgid ""
"<i>Istik</i>! Are you supposed to be here? Maybe I should report you to the "
"<i>sa'varsh</i>."
msgstr "<i>이스틱</i>! 여기 있도록 허락 받았나? 당신을 <i>사바쉬</i>에게 보고해야 할지도 모르겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheTeenager02
#. Speaker = Youth Dyrr'kas
#. NodeID = 4ad7578e-bfa7-d1d8-0c56-ec18e8fe09c3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet_CrecheTeenager02(1) = True
#.   Tag:
#.      - GITHYANKI(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheTeenager02:4ad7578e-bfa7-d1d8-0c56-ec18e8fe09c3
msgctxt "h00b5c09dg244eg45d7g873ag7108d17fb43e"
msgid "Must be nice to wander about wherever you want."
msgstr "넌 어디든지 맘대로 돌아다닐 수 있다니 좋겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheTeenager02
#. Speaker = Youth Dyrr'kas
#. NodeID = c696fb72-b21d-4aa6-a6b0-4c84edcccba0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet_CrecheTeenager02(1) = True
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheTeenager02:c696fb72-b21d-4aa6-a6b0-4c84edcccba0
msgctxt "ha0fefa80g4a0fg4dafg8838ga9c797a220ab"
msgid "Maybe when the patrol comes back I can learn what the outside's like."
msgstr "순찰대가 돌아오면 밖이 어떻게 생겼는지 알려달라 할 수 있을지도 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheTeenager02
#. Speaker = Youth Dyrr'kas
#. NodeID = e4c15096-ee73-4cca-8b16-15c1adcd6eb6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet_CrecheTeenager02(1) = False
#.   Tag:
#.      - GITHYANKI(1) = True
#. SetFlags:
#.   Dialog:
#.     - CRE_General_HasMet_CrecheTeenager02(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheTeenager02:e4c15096-ee73-4cca-8b16-15c1adcd6eb6
msgctxt "hcae223abg6543g47bfgafeega781782a39d9"
msgid ""
"You're from outside, aren't you? I can tell. You walk different to the "
"others. Less... directed."
msgstr "넌 밖에서 왔지? 분명해. 다른 자들이랑 걷는 모습이 다르거든. 목적이... 덜 있어보인달까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheTeenager02
#. Speaker = Youth Dyrr'kas
#. NodeID = e7768e8d-2dfe-d4cd-d02a-635e1bd72d33
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet_CrecheTeenager02(1) = False
#.   Tag:
#.      - GITHYANKI(1) = False
#. SetFlags:
#.   Dialog:
#.     - CRE_General_HasMet_CrecheTeenager02(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CrecheTeenager02:e7768e8d-2dfe-d4cd-d02a-635e1bd72d33
msgctxt "hbee06515g7bbcg48f7g949cg928620cafd4e"
msgid "I've not met an <i>istik </i>before. Do you all look like that?"
msgstr "난 <i>이스틱</i>을 만나본 적이 없거든. 너희들은 다 그렇게 생겼어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_DaisyGithyankiWarning
#. Speaker = GROUP_Daisy
#. NodeID = 36d5a7b3-4145-922d-1d19-e8a23959fb11
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DAISY_FEMALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_DaisyGithyankiWarning:36d5a7b3-4145-922d-1d19-e8a23959fb11
msgctxt "hd0a4cacdga44eg4984g9978g5c43262b175c"
msgid ""
"Your curiosity is getting the better of you - do not let it. Stay away from "
"the githyanki."
msgstr "호기심이 당신을 위험에 빠뜨리게 두지 마세요. 기스양키를 멀리하세요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_DaisyGithyankiWarning
#. Speaker = GROUP_Daisy
#. NodeID = 36d5a7b3-4145-922d-1d19-e8a23959fb11
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DAISY_MALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_DaisyGithyankiWarning:36d5a7b3-4145-922d-1d19-e8a23959fb11
msgctxt "hfb31cafdgd43fg4775gab5cgc5fd6e9d9154"
msgid ""
"Your curiosity is getting the better of you - do not let it. Stay away from "
"the githyanki."
msgstr "호기심이 당신을 위험에 빠뜨리게 두지 마세요. 기스양키를 멀리하세요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_DaisyGithyankiWarning
#. Speaker = GROUP_Daisy
#. NodeID = edd646eb-80d7-7d0f-68ac-eda222f3a112
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DAISY_FEMALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_DaisyGithyankiWarning:edd646eb-80d7-7d0f-68ac-eda222f3a112
msgctxt "he5554f49g0951g45e1ga09bge7af4ee707f1"
msgid ""
"They're hunting you. They want the artefact. They'll stop at nothing to take "
"it from you."
msgstr "그자들은 당신을 쫓고 있습니다. 아티팩트를 원하지요. 당신에게서 뺏어가기 위해 무엇이든 할 겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_DaisyGithyankiWarning
#. Speaker = GROUP_Daisy
#. NodeID = edd646eb-80d7-7d0f-68ac-eda222f3a112
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DAISY_MALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_DaisyGithyankiWarning:edd646eb-80d7-7d0f-68ac-eda222f3a112
msgctxt "h1d6bf51cg1b85g4edcg965fg05589934b604"
msgid ""
"They're hunting you. They want the artefact. They'll stop at nothing to take "
"it from you."
msgstr "그자들은 당신을 쫓고 있습니다. 아티팩트를 원하지요. 당신에게서 뺏어가기 위해 무엇이든 할 겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_DaisyGithyankiWarning
#. Speaker = Narrator
#. NodeID = f7b67600-52fd-e113-468b-7c67ed5248f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_DaisyGithyankiWarning:f7b67600-52fd-e113-468b-7c67ed5248f1
msgctxt "h905ace6cg9c7eg412ag9edeg74dc84bc3f92"
msgid "*Within the artefact, a feeling stirs - uncertainty.*"
msgstr "*아티팩트 안에서, 불확신의 감정이 일렁입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_AD_CaptainGuardChatter
#. Speaker = Raider Chy'raagh
#. NodeID = 14f1eaf8-fbfe-2a7b-050a-a69868b593d2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_AD_CaptainGuardChatter:14f1eaf8-fbfe-2a7b-050a-a69868b593d2
msgctxt "haaae110fge7f7g4cd7g8968g5dc602a5befd"
msgid "I think we all will, when this pestilent search is finally over."
msgstr "모두가 기뻐할 걸, 이 성가신 탐색이 마침내 끝난다면 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_AD_CaptainGuardChatter
#. Speaker = Raider Chy'raagh
#. NodeID = 2157946b-c6bb-dc77-9fb6-046613659ce5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_AD_CaptainGuardChatter:2157946b-c6bb-dc77-9fb6-046613659ce5
msgctxt "hd951e84dg89dbg4873ga332g22cd7a726245"
msgid "So long as he leaves with what he came for."
msgstr "찾으려는 걸 가지고 떠난다면 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_AD_CaptainGuardChatter
#. Speaker = Raider Ahu'u'rag
#. NodeID = 423aae86-2f88-80d9-1e01-09f54936523e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - ee2b1ae6-a35f-0c6b-9191-67fae6429506_A = False
#. SetFlags:
#.   Local:
#.     - ee2b1ae6-a35f-0c6b-9191-67fae6429506_A = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_AD_CaptainGuardChatter:423aae86-2f88-80d9-1e01-09f54936523e
msgctxt "hdf5e376cg0f96g4d7cg8f18g3445cd1dcf82"
msgid "Think the <i>kith'rak</i> will cheer up when we find it?"
msgstr "우리가 찾아내면 <i>키스락</i>께서 기뻐하실까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_AD_CaptainGuardChatter
#. Speaker = Raider Ahu'u'rag
#. NodeID = 4d16d42b-8fe3-bf59-8b53-cac30b0edf2f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - ee2b1ae6-a35f-0c6b-9191-67fae6429506_B = False
#.     - ee2b1ae6-a35f-0c6b-9191-67fae6429506_C = False
#.     - ee2b1ae6-a35f-0c6b-9191-67fae6429506_A = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_AD_CaptainGuardChatter:4d16d42b-8fe3-bf59-8b53-cac30b0edf2f
msgctxt "h7163aae4g25e2g4ab1ga568g9f2d0eb3a999"
msgid "Surely the <i>kith'rak</i> could go look herself, if it's so important?"
msgstr "그게 그렇게 중요한 거라면. <i>키스락</i>께서 직접 가실 수 있는 거 아닌가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_AD_CaptainGuardChatter
#. Speaker = Raider Ahu'u'rag
#. NodeID = 55817840-fac1-bc02-986b-976a671ed362
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - ee2b1ae6-a35f-0c6b-9191-67fae6429506_C = False
#. SetFlags:
#.   Local:
#.     - ee2b1ae6-a35f-0c6b-9191-67fae6429506_C = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_AD_CaptainGuardChatter:55817840-fac1-bc02-986b-976a671ed362
msgctxt "h505b1dc3g6179g4bd3g8135gc5eb612f5a1d"
msgid ""
"They should have let me interrogate those cultists. I'd have loosened their "
"tongues properly..."
