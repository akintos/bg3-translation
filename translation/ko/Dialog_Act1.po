msgctxt "h05d49317ge256g4609g8298gcb0110444502"
msgid "This job you mentioned - what's involved?"
msgstr "네가 말한 일 말인데, 무슨 일이지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02
#. Speaker = Zarys
#. NodeID = 02d4e88e-7c1a-6bed-aa9a-e0c094ca950c
