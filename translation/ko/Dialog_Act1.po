msgctxt "h7a317e0eg3eadg4ecfgb0abg56d717491615"
msgid "Hang on - you ain't even supposed to be here. Get 'em!"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinSleeper_01
#. Speaker = Player
#. NodeID = 287f42b3-65cb-49cd-ffb6-64e882c44334
