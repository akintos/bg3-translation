msgctxt "h6c44cfbag8895g4a36g9cc8gce86df774191"
msgid "You again? That's enough creepin' around. Lads - attack!"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Trespassing
