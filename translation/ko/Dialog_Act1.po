msgctxt "h4d2a7066g55e6g4286g845fg5e302aca8f65"
msgid ""
"I don't intend to make a habit of conversing with my killer, so I will be "
"brief."
msgstr "절 죽이려는 사람과 대화하는 취미는 없으니 짧게 말할게요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/AstralPlane/CRE_AstralPrison_Daisy
#. Speaker = GROUP_Daisy
#. NodeID = 5b52cb70-7514-8b46-fa66-b12b6182b60e
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DAISY_FEMALE_VOICE
