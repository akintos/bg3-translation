msgctxt "he5eef628g84b9g4846g9bbfgb4debd8d89c6"
msgid "A cave. Best stay sharp - I've been out of the dark for a while."
msgstr "동굴이야. 긴장해야겠군, 어둠 속에서 너무 오래 벗어나 있었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_VB_Entrance
