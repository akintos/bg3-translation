#. SetFlags:
#.   Global:
#.     - GOB_GoblinKing_Event_Surprise = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying:186e1384-47f2-8916-eab6-d340ebf18701
msgctxt "h7612d860g4b14g42fcg9efcg04de57a1e143"
msgid "<i>Attack the hobgoblin.</i>"
msgstr "<i>홉고블린을 공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying
#. Speaker = Dror Ragzlin
#. NodeID = 1883b54c-5be1-0049-db98-8248d88ad3c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying:1883b54c-5be1-0049-db98-8248d88ad3c4
msgctxt "h53a00b95ge28fg4dbcg8c97g4d0e65358bce"
msgid ""
"I command you, corpse: speak and say sooth. <i>Lhuuc an ac akuul'dec "
"shuulkokec!</i>"
msgstr "네게 명령하노니, 시체여. 진실을 말해라. <i>Lhuuc an ac akuul'dec shuulkokec!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying
#. Speaker = Narrator
#. NodeID = 1a4b58f6-b7c8-bd15-91eb-9c524093b77b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying:1a4b58f6-b7c8-bd15-91eb-9c524093b77b
msgctxt "h61d3c6d7gdf2eg43c4g85bcgf3e34790bc86"
msgid "*...and the murk clears to reveal a face. Yours.*"
msgstr "*...안개가 걷히더니 얼굴이 드러납니다. 당신입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying
#. Speaker = Dror Ragzlin
#. NodeID = 1c81e967-5a9e-51eb-a5db-d393fbd7082e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying:1c81e967-5a9e-51eb-a5db-d393fbd7082e
msgctxt "h60a872ddg19acg4e69gb266gf54ae08fc4e3"
msgid ""
"Say that again? 'Cause I know I didn't just hear you refuse the Absolute."
msgstr "다시 말해 봐. 네가 절대자님을 거부했을 리가 없으니까 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying
#. Speaker = Narrator
#. NodeID = 1cb6b565-9c35-a54c-4665-a925acf0cf6e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying:1cb6b565-9c35-a54c-4665-a925acf0cf6e
msgctxt "h2e985dcege207g47f0gb4ffgc385c767424e"
msgid ""
"*Yet it, too, roamed the nautiloid. It would have seen you, known you...*"
msgstr "*하지만, 놈도 함선에 타고 있었습니다. 당신을 봤을 것입니다. 누군지 알아볼 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying
#. Speaker = Player
#. NodeID = 1cbb4507-3274-20f0-3a83-1f80af918f0f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Scrying_AskedMission(2) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_Scrying_AskedMission(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying:1cbb4507-3274-20f0-3a83-1f80af918f0f
msgctxt "h9705bf6ag823fg4f64g8438g798faec884e1"
msgid "'What did the killer want?'"
msgstr "'살해자가 뭘 원했지?'"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying
#. Speaker = Narrator
#. NodeID = 1cc7fe63-6b80-d96c-ffdb-cb41f24e63be
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CRA_Escape_State_KilledMindflayer(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying:1cc7fe63-6b80-d96c-ffdb-cb41f24e63be
msgctxt "hf296032fg9699g42b0g970agd79f8b0c2684"
msgid ""
"*Your heart seizes. What if the creature noted your presence at the crash "
"site?*"
msgstr "*심장이 철렁입니다. 만약 이 생물체가 추락 현장에서 당신의 존재를 알아차렸다면?*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying
#. Speaker = Narrator
#. NodeID = 200cd650-bf2b-1e54-6eaf-61de94dd8848
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying:200cd650-bf2b-1e54-6eaf-61de94dd8848
msgctxt "h7983bdc7g18abg4c8dgb2b7ga758ca1e6176"
msgid ""
"*Ragzlin's mind is clouded by doubt, surprised once more by words he didn't "
"expect...*"
msgstr "*라그즐린의 정신에 의심이 피어오릅니다. 자신이라면 하지 않았을 질문에 다시 한번 놀라며 말입니다...*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying
#. Speaker = Narrator
#. NodeID = 210b10c3-f451-9aa5-ebb3-2b5537c30e9b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying:210b10c3-f451-9aa5-ebb3-2b5537c30e9b
msgctxt "h35212eecg97cfg4af2gaa16ga0ba705eaf41"
msgid ""
"*You see a clawed hand open a holding pod. The murk clears to reveal a face. "
"<i>Yours.</i>*"
msgstr "*길쭉한 손이 포드를 여는 모습이 보입니다. 그리고 안개가 걷히며 얼굴이 드러납니다. <i>당신입니다.</i>*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying
#. Speaker = Narrator
#. NodeID = 2165034e-3a31-610a-3124-7a022b403f5f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying:2165034e-3a31-610a-3124-7a022b403f5f
msgctxt "hf783a21cg02cfg4400g9e44g5f18f0fd64d1"
msgid ""
"*You see an image: curved drow blades, crude goblin torches, gnoll teeth "
"dripping blood.*"
msgstr "*눈앞에 환영이 드러납니다: 구부러진 드로우 칼날, 조잡한 고블린 횃불, 피를 흘리는 놀의 이빨.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying
