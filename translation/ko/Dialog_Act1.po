msgctxt "h0e84fad9gf406g4619g8633g26998b377992"
msgid "*The spell's power wanes. You can ask no more questions.*"
msgstr "*주문의 힘이 약해집니다. 더 이상 질문을 할 수 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Dead
#. Speaker = Zarys
#. NodeID = e9b3e48d-8512-41ea-84ee-4e2223f1c781
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Dead:e9b3e48d-8512-41ea-84ee-4e2223f1c781
msgctxt "h387663f0g54a9g4e9bgb651g29ca9c2862fe"
msgid "Waiting... precious cargo..."
msgstr "기다렸어... 소중한 화물을..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Dead
#. Speaker = Narrator
#. NodeID = ed929e63-a11d-4d6b-9233-f8a20a997fbc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_Killer(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Dead:ed929e63-a11d-4d6b-9233-f8a20a997fbc
msgctxt "h28c6299agfc4dg4819gb4b1gbe87385d853a"
msgid "*The corpse seems willing to speak - but not to its killer.*"
msgstr "*시체는 말할 의지가 있지만, 자신을 죽인 자와 대화하고 싶지는 않은 듯 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Dead
#. Speaker = Player
#. NodeID = f3eab18d-763c-80d2-6b01-acecf43ec9a4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Dead:f3eab18d-763c-80d2-6b01-acecf43ec9a4
msgctxt "hf97d657ega1e9g4276g946bg61b46acf0897"
msgid "Did you have anything of value?"
msgstr "지니고 있던 가치있는 물건이 있었나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Dead
#. Speaker = Zarys
#. NodeID = f5dfac73-5952-4f41-b0c2-1d8811c6eb12
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Dead:f5dfac73-5952-4f41-b0c2-1d8811c6eb12
msgctxt "h50d2cd5dgda63g462dgb91egf3152cf0a7c1"
msgid "Goblins... raided... kidnapped a duke..."
msgstr "고블린이... 습격했어... 공작을 납치했어..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Dead
#. Speaker = Zarys
#. NodeID = fdee4cb3-f022-47da-af26-342837cec935
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Dead:fdee4cb3-f022-47da-af26-342837cec935
msgctxt "h7d085c76ga2bbg4d85ga3e4g961fe2b85f32"
msgid "...whole outpost... but you don't steal... from Zhentarim..."
msgstr "...전초기지 전체... 젠타림에게선... 훔치지 않는다..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Player
#. NodeID = 0160b053-e376-8466-d556-2d2fd41b8c71
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_TouchedChest = True
#.      - PLA_ZhentShipment_Agent_001_State_Dead = True
#. SetFlags:
#.   Object:
#.     - PLA_ZhentDungeon_Zhent02_Knows_SurvivorsDead(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:0160b053-e376-8466-d556-2d2fd41b8c71
msgctxt "h18655cebg20f1g4dfeg9395gf0fc3985a10d"
msgid "They won't be coming back - but I know what became of their cargo."
msgstr "놈들이 쫓아오진 않을 거야, 하지만 그 화물이 뭐로 변했는지는 알고 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Player
#. NodeID = 022c38d7-17ad-35a5-06ff-d646577e812a
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_BANE or PALADIN_BANE
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:022c38d7-17ad-35a5-06ff-d646577e812a
msgctxt "h093c4b7bg2d8ag4fb9ga3bfgbe111ed44c4e"
msgid "I thought the Zhentarim would honour a fellow Banite."
msgstr "젠타림은 같은 베인 신봉자를 존중할 줄 알았는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = 02966f88-f6b7-0f20-0de1-1edaf6a4cdad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:02966f88-f6b7-0f20-0de1-1edaf6a4cdad
msgctxt "h3a2bd8f6g4bfbg469fgaa9agb38905615b04"
msgid "Perhaps you are more useful to me alive."
msgstr "널 살려두는 편이 내게 유용할지도 모르지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Player
#. NodeID = 04135a4a-1d43-ec3c-760b-a7a7614ccf58
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:04135a4a-1d43-ec3c-760b-a7a7614ccf58
msgctxt "h79b1c099g382fg4260g87ebgdb165cd9f050"
msgid "Try and I will take your skulls as trophies."
msgstr "그럼 네 두개골을 전리품으로 챙겨주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = 0849da0f-d2b7-9702-a484-f397fbf70cad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:0849da0f-d2b7-9702-a484-f397fbf70cad
msgctxt "h02f93f4egd17ag429eg8a25gbb4e6a10a722"
msgid "If half of them are true, you might be more useful alive."
msgstr "그것들 중 절반이라도 사실이면, 너는 살아있는 편이 더 유용하겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = 0bd37e9d-ab2f-cb61-9d6d-eeff009a5f32
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:0bd37e9d-ab2f-cb61-9d6d-eeff009a5f32
msgctxt "h497fbd2cg3227g41a1gbfcbged3085d72c5e"
msgid "Well aren't you a cold one - making threats like you can back 'em up."
msgstr "냉정한 놈이구나, 근거라도 있는 듯 남을 위협하다니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = 0c78b962-85c5-2322-3edb-433451dca5e6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_ZhentDungeon_State_SaidPassword = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:0c78b962-85c5-2322-3edb-433451dca5e6
msgctxt "h5dc3a3f0gbd26g4166g8e5fgb2f4a3d2a25c"
msgid "A planeswalker? I've heard stories about your kind."
msgstr "플레인즈워커인가? 너희 사람들에 대한 이야기는 들었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = 0d492e1a-25d5-2ab3-5166-67003a372f6f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_ZhentDungeon_State_SaidPassword = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:0d492e1a-25d5-2ab3-5166-67003a372f6f
msgctxt "h84c4a839gb043g4e88gbcb9g39ee4b918f12"
msgid "Huh. Big words."
msgstr "허. 허풍이 심하네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Player
#. NodeID = 10da22d4-d1f6-2d46-56fe-cff854cfe0f8
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = False
#.      - REALLY_GITHYANKI(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:10da22d4-d1f6-2d46-56fe-cff854cfe0f8
msgctxt "ha2bf36a8gadc0g41e1g80edgc7f255aecc3c"
msgid "Stand down. I go where I please."
msgstr "물러나. 나는 가고 싶은 데로 간다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = 14107ef2-80d4-67fa-1c67-a106133969bb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentDungeon_State_StopTriggerTraps = False
#.   Tag:
#.      - HUMAN(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:14107ef2-80d4-67fa-1c67-a106133969bb
msgctxt "haa8343eeg3acfg402eg8e26g698cc4bbf4d2"
msgid "I don't feel like trading today."
msgstr "오늘은 딱히 거래할 기분이 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = 1711ff80-7140-1a19-8dc5-af8944291d92
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:1711ff80-7140-1a19-8dc5-af8944291d92
msgctxt "h09e70076ga240g44acg917dg2c347f3baac9"
msgid ""
"<i>Hrast. </i>Then you're the least of my problems. Count your blessings - "
"and bugger off."
msgstr "<i>흐라스트</i>. 그렇다면 내가 널 신경쓸 때가 아니군. 운 좋은 줄 알아라. 그리고 꺼져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = 17fe6e3a-5e9a-8b65-fd2f-b71e64d4faa7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:17fe6e3a-5e9a-8b65-fd2f-b71e64d4faa7
msgctxt "he5a2fdfegd717g4727gb7dagb37c81402e66"
msgid "<i>Where in the hells is Rugan. I need that cargo.</i>"
msgstr "<i>루간은 대체 어디 있는 거야. 난 그 화물이 필요한데.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Player
#. NodeID = 1c2bda6a-3048-43d2-0d9c-862e90059e40
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 0
#. CheckFlags:
#.   Script:
#.      - GEN_CanDetectThoughts_2 = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:1c2bda6a-3048-43d2-0d9c-862e90059e40
msgctxt "hc779b375g512cg4f10gbee2g1e9fa87a243a"
msgid "<i>Read her mind.</i>"
msgstr "<i>그녀의 생각을 읽는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = 1c835137-9370-afdb-a681-e64c9a5b5f29
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_ZhentDungeon_State_SaidPassword = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:1c835137-9370-afdb-a681-e64c9a5b5f29
msgctxt "h57da797cg5747g4b2dg9977gcc0290fdadaa"
msgid "Trade with what? Your life was ours the moment you walked in here."
msgstr "뭐랑 거래하자고? 걸어 들어온 순간부터 네 생명은 우리 것이었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = 28cf9bcd-7d90-fc9c-92dc-8caf77d651f9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:28cf9bcd-7d90-fc9c-92dc-8caf77d651f9
msgctxt "he692026eg7315g44b0g9d96gc641918bb638"
msgid "More importantly, that's the one who saved the cargo, Rugan."
msgstr "더 중요한 건, 화물을 구한 사람이 바로 루간이라는 점이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Player
#. NodeID = 2bec0827-6e7a-d19a-04de-6a0b97125228
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:2bec0827-6e7a-d19a-04de-6a0b97125228
msgctxt "hf6eab1ddgd293g46f7gb389g9c42f1288c53"
msgid "I'm here to help you find your missing cargo."
msgstr "네가 잃어버린 화물을 찾는 걸 도와주러 왔어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = 315f7b17-6538-475b-fc9c-7873d6e92947
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentDungeon_State_GnollZhentsPresent = True
#.      - PLA_ZhentDungeon_State_WaitForGnollZhent = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:315f7b17-6538-475b-fc9c-7873d6e92947
msgctxt "h3c6a6e0bg940bg42a6g9fc2gb63edfeb45bc"
msgid "Well - it seems you were telling the truth."
msgstr "뭐, 진실을 말하고 있는 것 같네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = 319d6aba-8f41-b2ea-be0c-40e6268c0fae
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_ZhentDungeon_State_SaidPassword = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:319d6aba-8f41-b2ea-be0c-40e6268c0fae
msgctxt "hcad751f2g9cb6g41c1g8d27g873913e4e491"
msgid "Come down, then. Seems you're a friend of the family."
msgstr "그럼, 이리 내려와. 식구의 친구인 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = 3f8c9865-9f57-c7b2-5f17-fc315532aef1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentDungeon_State_StopTriggerTraps = False
#.   Tag:
#.      - HUMAN(3) = True
#. SetFlags:
#.   Global:
#.     - PLA_ZhentDungeon_State_TriggerTraps = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:3f8c9865-9f57-c7b2-5f17-fc315532aef1
msgctxt "h9659f370gad74g4782g8eacga94ef2925796"
msgid "I've heard stories about your kind. Stay where you are."
msgstr "네 사람들에 관한 이야기는 들어 봤지. 그대로 서 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = 409acda0-066b-76bc-cb18-0e944f3f82a2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:409acda0-066b-76bc-cb18-0e944f3f82a2
msgctxt "heed3d2abg2798g4a64ga8e9g657d65f76f29"
msgid "If breathing <i>pleases </i>you, you'd best turn around."
msgstr "숨 쉬는 걸 <i>계속하고 </i>싶다면, 그냥 뒤도는 편이 좋을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Player
#. NodeID = 4195b90e-1b69-8c2d-4196-383d513d526d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Dexterity
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:4195b90e-1b69-8c2d-4196-383d513d526d
msgctxt "h40e9170dga74cg4a47g86e0gaceee88b5d8c"
msgid "<i>Slip back into the shadows.</i>"
msgstr "<i>어둠 속으로 숨는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = 45f88ee6-4fc5-284a-13a0-80f42c515eec
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_ZhentDungeon_State_SaidPassword = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:45f88ee6-4fc5-284a-13a0-80f42c515eec
msgctxt "h87259ff6g4c41g4063g9a17g5858cbeb4e6c"
msgid "No, you don't."
msgstr "아니, 그럴 순 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = 4b110818-0ad0-3a39-f58c-4ad664d49e36
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:4b110818-0ad0-3a39-f58c-4ad664d49e36
msgctxt "h66195a95g63d4g4fbdg8742g469f9765f27d"
msgid "Still, I can look past it - if you have what I need. Come down."
msgstr "그래도, 눈감아줄 수는 있지, 내게 필요한 걸 가지고 있다면 말이야. 이리 내려와."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Player
#. NodeID = 56398632-27b6-1e88-ddd1-9a526810141e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_Talked = True
#.   Object:
#.      - PLA_ZhentShipment_Knows_Agent001Dead(1) = False
#.      - PLA_ZhentShipment_Knows_Agent002Dead(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:56398632-27b6-1e88-ddd1-9a526810141e
msgctxt "hedd4d661gf16fg4630gaa27gb31d74ab9531"
msgid "I saved Rugan on the road. He'll be along soon."
msgstr "길에서 루간을 구했어. 곧 이리로 올 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = 5969d3cf-f153-e061-0b07-0b3e80bc80d0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - PLA_ZhentDungeon_Event_RetreatToShadows(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:5969d3cf-f153-e061-0b07-0b3e80bc80d0
msgctxt "he1455a51gabbbg4fe5ga70ag7d8fecc14838"
msgid "<i>Hrast</i> - lads, we've got a visitor! Arm yourselves!"
msgstr "<i>흐라스트</i> - 얘들아, 손님이 왔다! 무장해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Player
#. NodeID = 6035857b-599e-cd44-b916-cfdb3d76aa27
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_EscapingZhentarim_State_Permitted = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:6035857b-599e-cd44-b916-cfdb3d76aa27
msgctxt "h54de63aeg5dd6g4e87g8d3bga31921e4f57b"
msgid "Relax - your guard at the door let me in."
msgstr "진정해 - 네 보초가 나를 문으로 들여 보내줬어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Player
#. NodeID = 63077a4c-308a-50df-8fa3-771211759857
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = True
#. TagRule: !GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:63077a4c-308a-50df-8fa3-771211759857
msgctxt "hcf841a4cg90acg478fga293g0d07110ae72a"
msgid "A child of Gith goes where they please."
msgstr "기스의 아이는 내키는 대로 간다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = 6a7119be-581a-d671-d96e-6fe644a5e201
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:6a7119be-581a-d671-d96e-6fe644a5e201
msgctxt "he019b957g0981g4eefga4ffg132e52dda07c"
msgid "A... <i>roar?</i> That was... unimpressive."
msgstr "이게 무슨... <i>함성이라고?</i> 그것 참... 평범하네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = 6e750464-99ec-42d6-2d4e-2f813de16b3d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:6e750464-99ec-42d6-2d4e-2f813de16b3d
msgctxt "h08ee195ag5249g450ag9f00g2c3a02479f59"
msgid ""
"Still... takes steel to swagger in here. If you're half as tough as you "
"think you are, I might have a job for you."
msgstr ""
"그치만... 여기를 활보하려면 무력이 있어야 해. 네가 자부하는 만큼의 절반 만이라도 강하다면, 널 위한 일자리가 있을지도 몰라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Player
#. NodeID = 7458e59c-1db2-fae7-2d8d-2fd51a0e0f34
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:7458e59c-1db2-fae7-2d8d-2fd51a0e0f34
msgctxt "h5dd86c65gb2e3g4c10ga1d0g1dbf49e4b2e7"
msgid "Fear not, you can trust me. Your friends did."
msgstr "두려워 마, 난 믿어도 좋으니까. 네 친구들도 그랬어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = 75d3a2b1-12e4-e611-2540-90e56de0b676
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentDungeon_State_GnollZhentsPresent = False
#.      - PLA_ZhentDungeon_State_WaitForGnollZhent = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:75d3a2b1-12e4-e611-2540-90e56de0b676
msgctxt "h5039fb9cgc671g470agb267gcad656a7a517"
msgid "Seems I recall telling you not to come back without my people."
msgstr "내가 우리 식구 없이는 돌아오지 말라고 했던 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = 82647c30-2488-7dc6-4ed2-d636c1bfb353
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:82647c30-2488-7dc6-4ed2-d636c1bfb353
msgctxt "he72aa7bdgaa75g445cg9b0ega9ce27bb2b0e"
msgid "Keep coming - see who it is gets buried down here."
msgstr "계속 와 봐, 이 아래에 묻히는 게 누구인지 보자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = 8288a7d7-c763-57cd-4e8a-17f768c33119
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:8288a7d7-c763-57cd-4e8a-17f768c33119
msgctxt "hcaad79a1g3844g49d9gba67g9a0dd3b0637f"
msgid "Here's a thought for you - turn around."
msgstr "널 위해 하는 말이야, 뒤로 돌아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Player
#. NodeID = 84d46402-c813-c1e9-21de-076df9721389
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_RuganToldPassword = True
#.   Quest:
#.      - PLA_ZhentShipment.GotPassword(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:84d46402-c813-c1e9-21de-076df9721389
msgctxt "h62269713g4089g4e24g816cgad832d6f21ea"
msgid "I know the pass-phrase: 'Little serpent, long shadow'."
msgstr "암구호를 알고 있어: '작은 뱀, 긴 그림자'."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = 87d39517-f11e-7e65-b047-690a0beb8d68
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentDungeon_State_GnollZhentsPresent = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:87d39517-f11e-7e65-b047-690a0beb8d68
msgctxt "he9bae5abg5f03g4b1fg8a0dgad3f07e97bfe"
msgid ""
"Whoa, hold your arrows! This is Rugan's saviour, I'll bet. He told us all "
"about you."
msgstr "워, 다들 사격 중지! 루간의 구원자인 것 같은데. 덕분에 너에 대해 많이 들었지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = 888f0422-0a64-4e90-f471-d4b34ff18f4d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:888f0422-0a64-4e90-f471-d4b34ff18f4d
msgctxt "h76b8e278g3d6ag4be3ga8b2gbf547bb8fb19"
msgid "But... maybe I'll let you buy it back. I have a job needs doing."
msgstr "하지만... 어쩌면 되사게 해줄지도 모르지. 지금 끝마쳐야 할 일이 있어서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Player
#. NodeID = 8b2cb6d5-58e6-ae18-91c2-78822a95243d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - PLA_EscapingZhentarim_Knows_WasAttacked(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:8b2cb6d5-58e6-ae18-91c2-78822a95243d
msgctxt "h80d3e528g4545g448fg9d08g4d0d45f5b4a3"
msgid "Your lookout already tried - and failed."
msgstr "네 보초들이 이미 시도했어, 그리고 실패했지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = 8c7bc324-d13d-77a4-2afa-7a5000421c4c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentDungeon_State_WaitForGnollZhent = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:8c7bc324-d13d-77a4-2afa-7a5000421c4c
msgctxt "ha9781a95g1503g4ebdga87fg4235bd3f1384"
msgid ""
"That's far enough. What's your business down here? Answer honestly, and "
"maybe we'll kill you clean."
msgstr "멈춰. 여긴 무슨 목적으로 온 거지? 정직하게 대답한다면, 깔끔하게 죽여줄 수도 있다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Player
#. NodeID = 93b8fbe8-a495-752f-37f3-eeb416e52582
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = True
#. TagRule: GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:93b8fbe8-a495-752f-37f3-eeb416e52582
msgctxt "hec73c988g8f9eg450bg93efgcc06dfdf96f2"
msgid "A child of Gith goes where they please."
msgstr "기스의 아이는 내키는 대로 간다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Player
#. NodeID = 97605c9a-79f9-dd00-4258-8e6554c96ed6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - PLA_ZhentShipment_Knows_Agent001Dead(1) = False
#.      - PLA_ZhentShipment_Knows_Agent002Dead(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:97605c9a-79f9-dd00-4258-8e6554c96ed6
msgctxt "hd2d82141gc185g41degb747g683c13ffe2ca"
msgid "I saved them on the road. They'll be along soon."
msgstr "길에서 그들을 구했어. 곧 이리로 올 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = 993d8163-205f-76d4-d362-63956bb07890
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_ZhentDungeon_State_TriggerTraps = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:993d8163-205f-76d4-d362-63956bb07890
msgctxt "h2e9a6d47g13d9g44f1gbe57g9467914ecbcf"
msgid "I suggest you turn around - we're closing the shop for the day."
msgstr "돌아가는 편이 좋을걸. 오늘 가게 문은 닫을 거니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Rugan
#. NodeID = 9a625a04-50bd-74ab-b6d3-d56c17244b1d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:9a625a04-50bd-74ab-b6d3-d56c17244b1d
msgctxt "h0e47bc37g073ag4cdcg8701g87faea534de7"
msgid "That's the one who saved me, Zarys!"
msgstr "저자가 날 구했어, 자리스!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = 9f64518d-4b2d-b74b-2fe2-56407de15440
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_ZhentDungeon_State_SaidPassword = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:9f64518d-4b2d-b74b-2fe2-56407de15440
msgctxt "h911ffba7g5ca2g4a03gab5ag94d3625858c2"
msgid ""
"'Fellow Banite' might be a bit strong, but you're welcome among the Zhent."
msgstr "'동료 베인 신봉자'라는 말은 어폐가 좀 있지만, 젠타림이 널 환영하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = a3f68636-f2bc-86b3-e6b5-6184a4d916a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:a3f68636-f2bc-86b3-e6b5-6184a4d916a3
msgctxt "h260a6af9ge719g4fc9gae52g6822a3f4a838"
msgid "Though it was subtly done, I'll grant you that. Maybe I can use you."
msgstr "몰래 하긴 했지만, 그 능력은 인정할게. 내가 널 써먹을 수도 있겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = a4dd4a2a-8dd8-140f-4c61-cb9b5aa1e09a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_ZhentDungeon_State_SaidPassword = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:a4dd4a2a-8dd8-140f-4c61-cb9b5aa1e09a
msgctxt "hb6285485gd87dg41f5gb326g70568470aedc"
msgid ""
"Really? That information would be worth quite a bit to me. If you're telling "
"the truth."
msgstr "그래? 그 정보는 꽤 유용할 수 있겠어. 네가 진실을 말하고 있다면 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Player
#. NodeID = a5a7862c-7169-0d0c-3dac-e46630bb3c39
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:a5a7862c-7169-0d0c-3dac-e46630bb3c39
msgctxt "h19ddf511g33d6g46d9g95aag9959aab98f94"
msgid "I truly don't want to fight - just to trade."
msgstr "정말 싸우고 싶지 않아, 그냥 거래를 하고 싶을 뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Player
#. NodeID = a5ab06d5-5028-09fe-2f24-55294c3768b7
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = False
#.      - REALLY_GITHYANKI(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:a5ab06d5-5028-09fe-2f24-55294c3768b7
msgctxt "h9f5c8c24gc115g491dgb520g9f9d82bc94cd"
msgid "I'm coming in. If you want to die over it, that's your business."
msgstr "나는 들어갈 거다. 죽고 싶다면, 알아서 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = a98bfaa5-67cf-534a-5ae9-66b4a8c73fe2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:a98bfaa5-67cf-534a-5ae9-66b4a8c73fe2
msgctxt "he1c70921g2362g408cgb535gac034dfc2ea8"
msgid "I don't feel like trading today."
msgstr "오늘은 거래할 기분이 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = aa33b793-0b66-434b-8a5e-1a8f907fc175
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:aa33b793-0b66-434b-8a5e-1a8f907fc175
msgctxt "he37d0dedg1a48g4796g87c0ge7dd922e5b4e"
msgid "I don't like repeating myself."
msgstr "같은 말을 반복하는 걸 좋아하진 않는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Player
#. NodeID = aadedc4e-8c69-4e8c-9e03-5f934c8475cf
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BERSERKER(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:aadedc4e-8c69-4e8c-9e03-5f934c8475cf
msgctxt "hbb1a3bc1ga528g410dga9feg45e6a925f47d"
msgid "<b><i>ROAR.</i></b>"
msgstr "<b><i>크아아.</i></b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Player
#. NodeID = ab463d21-0e01-edef-22c1-13ae7f011fc9
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:ab463d21-0e01-edef-22c1-13ae7f011fc9
msgctxt "h65d1b2e3g7d2dg4f35gb484g772d33ed2123"
msgid "I don't want trouble - I just want to trade."
msgstr "문제를 일으키고 싶진 않아, 거래하고 싶을 뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Player
#. NodeID = ada91044-b5e9-cb52-bc5e-8bd205b8fb89
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:ada91044-b5e9-cb52-bc5e-8bd205b8fb89
msgctxt "h782e5f27gd1c8g42edgbdd5ge0cea950a121"
msgid "I'm coming in. If you want to die over it, that's your business."
msgstr "난 들어갈 거다. 그걸 막다가 죽고 싶다면, 네가 자초한 일이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Player
#. NodeID = b9368cf5-6a05-04b1-7feb-9e9159553a0a
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#.      - BERSERKER(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:b9368cf5-6a05-04b1-7feb-9e9159553a0a
msgctxt "h79aca11bgd572g47f2g869dgf2cabfa06dba"
msgid "I want you to know the face of your killer. Or you can let me in."
msgstr "널 죽일 사람 얼굴은 봐야지. 아니면 그냥 들여보내 주던가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = bdd46aac-cd07-8b89-287b-280b7a02fb18
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:bdd46aac-cd07-8b89-287b-280b7a02fb18
msgctxt "hf6a2c99egc686g49d1g97f9gaa23ec5bca5d"
msgid ""
"That just tells me you know our codes, not why you're here. I won't ask "
"again."
msgstr "그건 네가 우리 암구호를 알고 있다는 걸 증명할 뿐이야, 여기 왜 온 건지를 알려주진 않지. 다시 묻진 않겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = be7ba79f-fa44-39cf-6708-ecfad7e10b63
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:be7ba79f-fa44-39cf-6708-ecfad7e10b63
msgctxt "haafece37g60eeg47eag9ecbg1d818e5eb053"
msgid "Then I'll welcome you as a friend - if and when they get here."
msgstr "그렇다면 널 친구로 환영해 주지. 그들이 여기 도착하고 나면 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = c2c7f531-31b1-fdf4-dfe2-13c79e2f8748
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_ZhentDungeon_State_SaidPassword = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:c2c7f531-31b1-fdf4-dfe2-13c79e2f8748
msgctxt "h8425cc6dg82bdg4470gb486g116642189044"
msgid ""
"I never mentioned any cargo, and I don't care for people poking around in my "
"head."
msgstr "난 어떤 화물도 언급하지 않은 데다가, 사람들이 내 머릿속을 들쑤시고 다니는 것은 달갑지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Rugan
#. NodeID = c38c1ddf-8dac-f46f-5edd-4d0d2383479d
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:c38c1ddf-8dac-f46f-5edd-4d0d2383479d
msgctxt "hb59df8d1g5a19g4ab2ga226g58ecca495e14"
msgid "Hold on. That's the lass who saved us from the gnolls. Let her in."
msgstr "잠깐. 저 아가씨가 우릴 놀로부터 구해줬어. 그녀를 들여주게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Rugan
#. NodeID = c38c1ddf-8dac-f46f-5edd-4d0d2383479d
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:c38c1ddf-8dac-f46f-5edd-4d0d2383479d
msgctxt "h726481e6g7058g47ffg88d9g7c145714480e"
msgid "Hold on. That's the lad who saved us from the gnolls. Let him in."
msgstr "잠깐. 저 청년이 우릴 놀로부터 구해줬어. 그를 들여주게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Rugan
#. NodeID = c38c1ddf-8dac-f46f-5edd-4d0d2383479d
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:c38c1ddf-8dac-f46f-5edd-4d0d2383479d
msgctxt "h2a0c2281g2d22g4f3cg9f88g5d6e642e2df1"
msgid "Hold on. That's the one who saved us from the gnolls. Let them in."
msgstr "잠깐. 저 자가 우릴 놀로부터 구해줬어. 그들을 들여주게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = c4f34336-3dad-d6ca-7d28-f96b0bafad8d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:c4f34336-3dad-d6ca-7d28-f96b0bafad8d
msgctxt "h07b87c42g7f39g4e6fgb011g64a7729319b9"
msgid "I suggest you turn around - we're closing the shop for the day."
msgstr "뒤돌아서 떠나는 걸 추천하지. 오늘은 영업 끝났거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = c527af84-fcfd-fa91-992e-54afa24a5f02
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:c527af84-fcfd-fa91-992e-54afa24a5f02
msgctxt "h89f8f85fg789ag4323ga57agdde77b6e8f4c"
msgid "You know I can still see you, right?"
msgstr "지금도 네가 보인다는 거 알고 있지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Player
#. NodeID = c5ee79c9-8f08-2df6-0ab2-3eb7d07d1a37
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BERSERKER(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:c5ee79c9-8f08-2df6-0ab2-3eb7d07d1a37
msgctxt "h089d8b59gd10eg4e21g90aeg6da0a2d4a59e"
msgid "LET ME IN. OR <b>DIE</b>. <b>CHOOSE</b>."
msgstr "<b>날 들여보내. 아니면 죽든가. 선택하시지</b>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = c8275af3-e37d-5f70-9bb0-f6bf6f80568e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentDungeon_State_StopTriggerTraps = False
#.   Tag:
#.      - HUMAN(3) = True
#. SetFlags:
#.   Global:
#.     - PLA_ZhentDungeon_State_TriggerTraps = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:c8275af3-e37d-5f70-9bb0-f6bf6f80568e
msgctxt "h32b5c770gfcfcg4dfdg9c8eg9797d8003f0f"
msgid ""
"You're ugly enough - no need to be a liar on top. Now toddle off back to "
"whatever hole you came from."
msgstr "이미 충분히 추한 것 같은데, 거짓말을 보탤 필요는 없지. 이제 네가 기어 나온 구멍으로 다시 꺼져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = c867b89e-4ad3-990e-5240-366bcfa540cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:c867b89e-4ad3-990e-5240-366bcfa540cb
msgctxt "h896839e8gaf37g40f4gb27bg13120b06337e"
msgid "You're a priest of the Black Hand?"
msgstr "네가 블랙 핸드의 사제라고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Player
#. NodeID = cb9fbf39-4543-da16-6c99-92c137e6c593
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_TouchedChest = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:cb9fbf39-4543-da16-6c99-92c137e6c593
msgctxt "hbaf35ed1g56cfg472ag9100ge8d3704b645d"
msgid "I know what became of Rugan. His cargo, too."
msgstr "루간이 어떻게 됐는지는 알고 있어. 그의 화물도 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = d1a34aac-0e6d-56fb-b68e-88a7eadc127e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:d1a34aac-0e6d-56fb-b68e-88a7eadc127e
msgctxt "h54eddb55g9253g41c4ga7fbgbecf969eaf60"
msgid ""
"That just tells me you've met my people - not why you're here in their stead."
msgstr "그건 그냥 내가 우리 식구를 만났다는 걸 증명할 뿐이야, 네가 그들 대신 여기 왔는지가 아니라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = d2987f3e-924c-ece6-7980-06abb99fa7b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:d2987f3e-924c-ece6-7980-06abb99fa7b1
msgctxt "h97ae236dgc7cbg462cg89f7g86bb68b08aa6"
msgid ""
"Then your answer decides his fate as well as your own - so make it good."
msgstr "그럼 너의 대답이 그와 너희의 운명을 좌우하게 될 거야. 그러니 대답 잘 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = d3244420-f1c4-5826-16c5-cb98715167a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:d3244420-f1c4-5826-16c5-cb98715167a5
msgctxt "h8a790b9dg8960g4c39g91d2gd9322db52bb9"
msgid "Might be I have use for someone with your skills."
msgstr "너 같은 기술을 가진 사람이 필요할지도 모르지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = d7f5d814-5f8a-4de0-6ef3-2c1a13514256
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_ZhentDungeon_State_SaidPassword = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:d7f5d814-5f8a-4de0-6ef3-2c1a13514256
msgctxt "h4f216908gf263g4c5egaaf7g4cc42161892e"
msgid "You did us a good turn, and the Zhentarim pay their debts."
msgstr "넌 우릴 위해 좋은 일을 해 줬어, 그리고 젠타림은 빚을 갚지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Player
#. NodeID = d9ac8b47-243f-ffa4-f1d8-c89de262fe37
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_TouchedChest = False
#.      - PLA_ZhentShipment_Knows_SurvivorsAreDead = True
#. SetFlags:
#.   Object:
#.     - PLA_ZhentDungeon_Zhent02_Knows_SurvivorsDead(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:d9ac8b47-243f-ffa4-f1d8-c89de262fe37
msgctxt "h2cc1647bg1420g4764g9861gd9e2706604e5"
msgid "They're dead."
msgstr "그들은 죽었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = d9f0fd48-4bf2-9852-4c5f-c73e26a77308
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_ZhentDungeon_State_WaitForGnollZhent = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:d9f0fd48-4bf2-9852-4c5f-c73e26a77308
msgctxt "h659cbc15g6f02g4abfg8b37g6e87b487a0a0"
msgid "Until then, I suggest you keep your distance."
msgstr "그때까진, 거리를 두는 걸 추천하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = ddf1536f-826e-bb56-b373-f6aad4df85dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:ddf1536f-826e-bb56-b373-f6aad4df85dc
msgctxt "h5cab198fgde48g4751gacacgf08307400a44"
msgid "You will, will you?"
msgstr "그럴 거야, 그렇지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = e0f9cc78-ae67-28c6-c1f5-04e9bdabf6df
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentDungeon_State_StopTriggerTraps = False
#.   Tag:
#.      - HUMAN(3) = True
#. SetFlags:
#.   Global:
#.     - PLA_ZhentDungeon_State_TriggerTraps = True
#.   Object:
#.     - PLA_ZhentDungeon_Event_RetreatToShadows(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:e0f9cc78-ae67-28c6-c1f5-04e9bdabf6df
msgctxt "h4141bd7eg4f1dg4c42g9279ge3088b047f62"
msgid "<i>Hrast</i> - lads, we've got a visitor! Arm the traps!"
msgstr "<i>흐라스트</i> - 얘들아, 손님이 왔다! 함정을 작동시켜!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = e73af3f2-5ffd-cbe0-4524-346302e1575c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_ZhentDungeon_State_SaidPassword = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:e73af3f2-5ffd-cbe0-4524-346302e1575c
msgctxt "hce1cbc10g11f2g45f7gb43cg5a74f1cdc0fd"
msgid ""
"I never mentioned any cargo, and I don't care for people poking around in my "
"head."
msgstr "난 어떤 화물도 언급하지 않은 데다가, 사람들이 내 머릿속을 들쑤시고 다니는 것은 달갑지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = e9cf0906-fab8-4891-0a30-67f224d657d2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - PLA_ZhentDungeon_Zhent04_StartInclusion(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:e9cf0906-fab8-4891-0a30-67f224d657d2
msgctxt "h6c196fdbgc7b8g484cg9cb7g9eb97de78f73"
msgid "Mind-magic? <i>Seriously?</i>"
msgstr "정신 마법이라고? <i>장난해?</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = ebdb15a8-44c7-0520-2b3e-b89df15cd68b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_ZhentDungeon_State_SaidPassword = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:ebdb15a8-44c7-0520-2b3e-b89df15cd68b
msgctxt "ha292fca6gc53bg4624gbf80ge5089eac2c75"
msgid "A... <i>roar?</i> That was unexpected."
msgstr "이게 무슨... <i>함성이라고? </i>그건 예상 못했는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Player
#. NodeID = f3c21200-3f41-d399-d6b3-4bbdd9b048f4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Quest:
#.      - PLA_ZhentShipment.GotPassword(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:f3c21200-3f41-d399-d6b3-4bbdd9b048f4
msgctxt "hfd583c0dg545bg40eeg9d66gabd3c92337a6"
msgid "Your colleague gave me a pass-phrase: 'Little serpent, long shadow'."
msgstr "네 동료가 암구호를 알려줬어: '작은 뱀, 긴 그림자'."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = f47fb965-5186-77a6-d4db-e7a42e55c1a3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_ZhentDungeon_State_SaidPassword = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:f47fb965-5186-77a6-d4db-e7a42e55c1a3
msgctxt "hbb7668d9g17f6g4fb6g8770gf71184413cab"
msgid "Come on in, then. Any friend of Rugan's is a friend of the family."
msgstr "그럼, 이리 들어와. 루간의 친구는 우리 식구의 친구지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Player
#. NodeID = f5aba876-564e-fa66-60ef-157566f73a22
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:f5aba876-564e-fa66-60ef-157566f73a22
msgctxt "hb2ccd8cfg3bc1g4e91g9733g0b5af156efde"
msgid ""
"I've a network of dangerous contacts who know I'm here. Kill me, they come "
"for you."
msgstr "난 위험한 자들과 연관되어 있어, 그들도 내가 여기 있다는 걸 알고 있지. 날 죽이면, 그들이 널 잡으러 올 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = f5fb3f98-2b2b-b6bd-195b-c145fa872192
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:f5fb3f98-2b2b-b6bd-195b-c145fa872192
msgctxt "ha8605282g57c2g416dg9cd7gac920ee8eb59"
msgid "I won't. Last time - what's your business here?"
msgstr "아니. 마지막으로 묻겠다, 여긴 무슨 목적으로 왔지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = f679ae59-3c49-19f9-6fa7-148487b9a6d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:f679ae59-3c49-19f9-6fa7-148487b9a6d4
msgctxt "h8faca85cg8f70g43c3g9aa7g2c0672fc2678"
msgid ""
"You revealed our location? That tongue gets any looser, Rugan, I'll cut it "
"out."
msgstr "우리 위치를 누설해? 루간, 더 이상 그 혓바닥을 함부로 놀렸다간, 내가 손수 잘라낼 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1
#. Speaker = Zarys
#. NodeID = fe2bc3be-1876-1792-b76b-0bbbcac402c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage1:fe2bc3be-1876-1792-b76b-0bbbcac402c1
msgctxt "h100b4cdcgb289g4446ga388gba037af94cd4"
msgid "We've disarmed the traps. Come down."
msgstr "함정은 해제했어. 내려와."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage2
#. Speaker = Zarys
#. NodeID = 35a1448f-8e9d-6106-57f5-6e52b40b3407
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentDungeon_Zhent02_State_CanFireArrow = False
#.      - PLA_ZhentDungeon_State_WaitForGnollZhent = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage2:35a1448f-8e9d-6106-57f5-6e52b40b3407
msgctxt "hdc33b6a6g524dg4f76g9525g7100c0086e9a"
msgid "Keep moving, across the bridge!"
msgstr "계속 움직여, 다리를 건너!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage2
#. Speaker = Zarys
#. NodeID = 50b97ec2-37be-1ffd-ff56-9181e63ebf11
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentDungeon_State_GnollZhentsPresent = False
#.      - PLA_ZhentDungeon_Zhent02_State_CanFireArrow = False
#.      - PLA_ZhentDungeon_State_WaitForGnollZhent = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage2:50b97ec2-37be-1ffd-ff56-9181e63ebf11
msgctxt "h0d3788beg4903g4b6cg903cgcb0e03f0d009"
msgid "Can't say you weren't warned - steel it is."
msgstr "경고받지 못했다고는 하지 마, 그럼 전투로군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage2
#. Speaker = Zarys
#. NodeID = 91b2c634-c551-6b65-f527-6429b3ae6bb9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentDungeon_Zhent02_State_CanFireArrow = True
#.      - PLA_ZhentDungeon_State_WaitForGnollZhent = False
#. SetFlags:
#.   Global:
#.     - PLA_ZhentDungeon_Event_FireArrow = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage2:91b2c634-c551-6b65-f527-6429b3ae6bb9
msgctxt "h85fc6377g48cdg487fg9cd2g3a0745c26264"
msgid "Scatter!"
msgstr "흩어져!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage2
#. Speaker = Zarys
#. NodeID = c8d37c93-d92c-8402-a8c9-84383e406d52
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentDungeon_State_GnollZhentsPresent = False
#.      - PLA_ZhentDungeon_Zhent02_State_CanFireArrow = True
#.      - PLA_ZhentDungeon_State_WaitForGnollZhent = True
#. SetFlags:
#.   Global:
#.     - PLA_ZhentDungeon_Event_FireArrow = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage2:c8d37c93-d92c-8402-a8c9-84383e406d52
msgctxt "ha1486158g44dag4005ga893g3afbdaf3d7d0"
msgid "You have a death wish, happy to grant it."
msgstr "죽고 싶은 모양이군, 기꺼이 선사해 주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage3
#. Speaker = Zarys
#. NodeID = 0b5733ea-7086-6823-1d3e-ce606fd037f7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentDungeon_State_WaitForGnollZhent = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage3:0b5733ea-7086-6823-1d3e-ce606fd037f7
msgctxt "heea13a76gd52ag4c89g8a81g7a0a7b640da2"
msgid "You're making a bad mistake, my friend. Last chance to turn back."
msgstr "넌 지금 끔찍한 실수를 저지르고 있는 거야, 친구. 뒤돌아서 떠날 마지막 기회다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage3
#. Speaker = Zarys
#. NodeID = b138e16f-2307-fd7d-d4d7-608788c7aa80
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentDungeon_State_GnollZhentsPresent = False
#.      - PLA_ZhentDungeon_State_WaitForGnollZhent = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Stage3:b138e16f-2307-fd7d-d4d7-608788c7aa80
msgctxt "h756f8989g7632g4ccdg8301ga83faaa57967"
msgid "Why couldn't you just run away, you <i>stlarning</i> lunatic?"
msgstr "왜 그냥 뒤돌아서 떠나지 않는 거야, 이 <i>삐뚤어진 </i>미치광이 자식아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap
#. Speaker = Zarys
#. NodeID = 04b9e807-db09-886c-aa9f-712ddfe02205
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap:04b9e807-db09-886c-aa9f-712ddfe02205
msgctxt "h9294af59g1a05g455bga7a6gd6a7e6fc0568"
msgid "... you were so close. <i>So close </i>to walking out of this alive."
msgstr "... 너는 성공 직전이었어. 여기서 살아서 나가기 <i>직전이었는데</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap
#. Speaker = Narrator
#. NodeID = 0850dfec-308b-9682-6704-7ee764c378de
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap:0850dfec-308b-9682-6704-7ee764c378de
msgctxt "h00b7baf8g98a9g495cg9300gb797ccd60bf7"
msgid "*You see nothing you can use. The mercenaries shift impatiently.*"
msgstr "*사용할 만한 것이 보이지 않습니다. 용병들은 초조하게 몸을 움직입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap
#. Speaker = Zarys
#. NodeID = 0df7963e-de4f-5584-d8ca-4d81eb052748
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap:0df7963e-de4f-5584-d8ca-4d81eb052748
msgctxt "h7f858a36g3db5g4ee8g9ee0g5a5f52b2613f"
msgid "Hah! Of course - all you had to do was ask."
msgstr "하! 물론이지 - 부탁만 하면 되는 거였다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap
#. Speaker = Player
#. NodeID = 11f8c867-d69d-53b1-b3ba-3f7a8b72e8ad
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - ROGUE(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap:11f8c867-d69d-53b1-b3ba-3f7a8b72e8ad
msgctxt "ha00dfe8ag2ebfg4fbag9aa0g3fc716bac5ab"
msgid "<i>Look around for something you can use.</i>"
msgstr "<i>사용할 만한 것이 없는지 주변을 둘러본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap
#. Speaker = Zarys
#. NodeID = 1ed2f289-960c-4cad-d3ca-60248eccc448
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap:1ed2f289-960c-4cad-d3ca-60248eccc448
#, fuzzy
msgctxt "h9f6e1624g5d35g4a8fg82bbg4c0cdd5c56f0"
msgid "Show some respect, Rugan. The boy was loyal to you 'til the end."
msgstr "존중을 보여, 루간. 이 애는 최후까지 너에게 충성했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap
#. Speaker = Zarys
#. NodeID = 1fbedfb3-201b-1c53-9cf6-1af7cfa2fc6a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap:1fbedfb3-201b-1c53-9cf6-1af7cfa2fc6a
msgctxt "he763e66bgb274g4914g9501gccfd2c947329"
msgid "Weapons!"
msgstr "무기를 들어라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap
#. Speaker = Player
#. NodeID = 20cf983f-74f5-fb4b-f3e6-d76afbbe71c7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap:20cf983f-74f5-fb4b-f3e6-d76afbbe71c7
msgctxt "h26ff6ff9gcd85g46c3g8087g07307a7f3b80"
msgid "<i>'Steel ends enemies, but gold makes friends.'</i>"
msgstr "<i>'강철은 적을 끝장내지만, 금은 친구를 만든다.'</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap
#. Speaker = Rugan
#. NodeID = 2cb60583-f93a-fabb-1934-65382ad84b86
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap:2cb60583-f93a-fabb-1934-65382ad84b86
msgctxt "hed28c68cg0b30g4e67g9744g03a67bfd01f0"
msgid "NonoNONONO PLEASE-"
msgstr "안돼안돼안돼안돼 제발-"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap
#. Speaker = Zarys
#. NodeID = 2f3e6726-0be8-aedc-b061-571d32fad686
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap:2f3e6726-0be8-aedc-b061-571d32fad686
msgctxt "hf07bc1a7g7853g4359ga239gb67a9d5c44d1"
msgid "... you bloody <i>wouldn't! </i>Hah. You've got guts. I respect that."
msgstr "... 네가 <i>감히! </i>하. 배짱은 있구나. 그건 높게 평가해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap
#. Speaker = Zarys
#. NodeID = 43f0c98c-f5cc-454e-0b3c-8947a27aed75
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap:43f0c98c-f5cc-454e-0b3c-8947a27aed75
msgctxt "h9c7e4552gb056g4e6eg90a3ge60e9d16cf9f"
msgid "There's not much money in retribution, true..."
msgstr "응징으로 돈을 많이 못 얻는 건 사실이야…"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap
#. Speaker = Player
#. NodeID = 585eeeb3-3dc1-d50d-16a3-b045095eb48c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 20
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_ImpersonatedPereghost = False
#.   Tag:
#.      - BARBARIAN(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap:585eeeb3-3dc1-d50d-16a3-b045095eb48c
msgctxt "hf62b1943g230cg4951ga5b5gee854fba1d50"
msgid "I'm going to walk out of here alive. Play it right, and so will you."
msgstr "나는 살아서 여기를 빠져나갈 것이다. 잘 처신하면, 너도 살 수 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap
#. Speaker = Zarys
#. NodeID = 5ab91d6c-061d-f361-5fe9-ad3b8fef8a26
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_ZhentDungeon_State_AllowedSpecialTrade = True
#.     - PLA_ZhentDungeon_State_JoinedZhent = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap:5ab91d6c-061d-f361-5fe9-ad3b8fef8a26
msgctxt "h62c52e4fg90beg4e72gb53ag965d0fc66487"
msgid ""
"All right then, recruit - you can stock up here and be on your way. Bring "
"the cargo to Baldur's Gate. Someone there will make contact."
msgstr ""
"좋아, 그럼 정비해. 여기서 재고를 비축하고 바로 출발해도 좋아. 화물을 발더스 게이트로 가져가. 그곳에서 누군가가 만나러 올 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap
#. Speaker = Player
#. NodeID = 5d51a6ec-0b75-5052-682d-dff8afe6338b
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 7
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentDungeon_Knows_DealPossible = True
#.      - PLA_ZhentShipment_State_ImpersonatedPereghost = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap:5d51a6ec-0b75-5052-682d-dff8afe6338b
msgctxt "h7cec21b3g9b67g4ff4ga115g6663c137bfa1"
msgid "Profit's more important than vengeance. Let's make a deal."
msgstr "복수보단 이익이 우선이지. 거래를 하자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap
#. Speaker = Zarys
#. NodeID = 63c72583-a686-7513-2632-e8b015c9371c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap:63c72583-a686-7513-2632-e8b015c9371c
msgctxt "h92aaf27bgd06bg4ddeg9370gf6b4938916c4"
msgid "Oof. I got a tingle for a second there."
msgstr "아야. 잠깐 찌릿했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap
#. Speaker = Zarys
#. NodeID = 64de76cc-437e-c41d-f086-2ea971969268
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_ImpersonatedPereghost = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap:64de76cc-437e-c41d-f086-2ea971969268
msgctxt "h1d4ecb65g2f33g4899g9ccdgeeeae2646866"
msgid ""
"You've read Manshoon. Seems you know our ways better than poor Rugan here."
msgstr "맨슌의 글을 읽었군. 너는 이 불쌍한 루간보다 우리의 방식을 잘 알고 있는 것 같네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap
#. Speaker = Zarys
#. NodeID = 6bb86d01-4025-3041-d900-058205e6c295
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap:6bb86d01-4025-3041-d900-058205e6c295
msgctxt "hdb535828g9201g4afdgb324gfb7cefd7ec66"
msgid "You're the one who taught me rule number one, remember?"
msgstr "너는 나에게 첫 번째 규칙을 가르쳐준 사람이야. 기억해?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap
#. Speaker = Player
#. NodeID = 6e0b712a-ec1f-f623-cbab-fd696fdd1ae2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_ChestUnlocked = True
#.   Object:
#.      - PLA_ZhentShipment_State_HasShipment(2) = True
#. SetFlags:
#.   Global:
#.     - PLA_ZhentShipment_State_SaidChestUnlocked = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap:6e0b712a-ec1f-f623-cbab-fd696fdd1ae2
msgctxt "h6a4ba3e2g0808g416egba7eg1e73efa4e238"
msgid "The cargo's been opened. Not a problem, I hope?"
msgstr "화물이 열렸어. 문제 없지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap
#. Speaker = Player
#. NodeID = 704e2bfa-fe51-78d8-b68c-d3a0efc2d94a
#. HandlePath = RollAdvantageReason
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_ImpersonatedPereghost = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap:704e2bfa-fe51-78d8-b68c-d3a0efc2d94a
msgctxt "h9cf084c9g6ba3g44cfg82e0gb1d34f1d8829"
msgid "You're an unreliable source"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap
#. Speaker = Player
#. NodeID = 704e2bfa-fe51-78d8-b68c-d3a0efc2d94a
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_ImpersonatedPereghost = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap:704e2bfa-fe51-78d8-b68c-d3a0efc2d94a
msgctxt "hc8cf797agf52dg4580gaf2dgd0790c99e59b"
msgid "I've already shown I've got more wits than Rugan. Let's work together."
msgstr "나는 이미 루간보다 약삭빠른 모습을 보여줬어. 함께 일하자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap
#. Speaker = Zarys
#. NodeID = 70abf1e4-272f-6754-5107-0a2fbcd52bff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap:70abf1e4-272f-6754-5107-0a2fbcd52bff
msgctxt "h69e673ccga273g4a32g84fag7d6647b06029"
msgid "You're dead the moment you steal from the Zhentarim."
msgstr "젠타림으로부터 물건을 훔치는 순간 너는 죽은 목숨이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap
#. Speaker = Zarys
#. NodeID = 7fd4497c-0a39-ebb4-af88-f7ec7258db4d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap:7fd4497c-0a39-ebb4-af88-f7ec7258db4d
msgctxt "h8ee33ce1g87c7g4f56gb1e0gc74c675ddc48"
msgid ""
"Tell you what: you've already taken Rugan's cargo, so finish the job and "
"I'll let you live. Deliver it to Baldur's Gate."
msgstr "좋은 생각이 있어: 네가 이미 루간의 화물을 훔쳤으니, 일을 마무리하면 살려줄게. 발더스 게이트에 그것을 전달하는 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap
#. Speaker = Player
#. NodeID = 8aac046f-ba07-4333-84ea-f69063440b68
#. HandlePath = RollAdvantageReason
