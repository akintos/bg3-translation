msgctxt "hfc95f845gc5bag418ag8008ga993233d2b0d"
msgid "<i>Looks for signs of unnatural activity.</i>"
msgstr "<i>비자연적인 활동의 징후를 찾는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_ForestIllusion_Illusioncheck
#. Speaker = GROUP_PartyMembers
#. NodeID = 230d00ed-47f7-9721-ebf3-b413056de6c6
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 20
