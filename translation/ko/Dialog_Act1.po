#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SecludedSpot_Trespassing:4bfa008d-70df-9bc8-8d0d-d00b77648046
msgctxt "h484eb280g78ffg4fb2gbc55gae539f8e6213"
msgid "All right."
msgstr "알았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SecludedSpot_Trespassing
#. Speaker = Narrator
#. NodeID = 4dcbd63d-4342-2893-ba78-99d4908f9aa8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount3(1) = False
