msgctxt "h75d5e55dg0197g4a66g90e4g7037e12830c8"
msgid "Nothing like being dropped in the wetlands in the blink of an eye..."
msgstr "눈 깜짝할 새에 늪지에 떨어지는 것만한 것도 없지..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_FairyRings_PAD_TeleportedFromUnderdarkToSwamp
#. Speaker = Player
#. NodeID = 056ebdff-ce1a-3a2b-1d28-1334257e07b3
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_WYLL
