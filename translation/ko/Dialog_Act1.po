msgctxt "h4787a38bged68g4663g973bg687983415bb8"
msgid "*Squawk!*"
msgstr "*꾸엑!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_OwlBear_LastCub
#. Speaker = Owlbear Cub
#. NodeID = 80cae3db-51cb-5798-e7a3-53080d8ce016
