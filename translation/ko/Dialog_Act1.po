msgctxt "h0f5c5bf8g1f03g43feg9040g339a609bb601"
msgid "<i>Look for anything out of the ordinary.</i>"
msgstr "<i>수상한 것을 찾아본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_ForestIllusion_Illusioncheck
#. Speaker = Narrator
#. NodeID = 2e15a29f-c907-3f40-4571-b85c9a1d2c2e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_ForestIllusion_Illusioncheck:2e15a29f-c907-3f40-4571-b85c9a1d2c2e
msgctxt "h3b77d238gad5fg488dg8ffdg1edb61534171"
msgid "*The place has a quiet sense of calm. You can't see anything strange.*"
msgstr "*이곳은 조용하고 차분한 분위기입니다. 당신은 수상한 것을 보지 못합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_ForestIllusion_Illusioncheck
#. Speaker = GROUP_PartyMembers
#. NodeID = 354afdb5-5d7d-b5c5-a538-9d92b8b93048
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - PALADIN_MYSTRA(0) = False
#.      - CLERIC_MYSTRA(0) = False
#. TagRule: CLERIC_NEUTRAL or MONK or PALADIN_NEUTRAL
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_ForestIllusion_Illusioncheck:354afdb5-5d7d-b5c5-a538-9d92b8b93048
msgctxt "hccd52622g2589g4ba1gb4a3gfffc71765821"
msgid "<i>Reach out with your senses - check the balance of this place.</i>"
msgstr "<i>감각들을 일깨워 이곳의 상태를 조사한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_ForestIllusion_Illusioncheck
#. Speaker = Narrator
#. NodeID = 502b5f98-b9d9-6a9c-2e7b-7ba9d9632517
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_ForestIllusion_Illusioncheck:502b5f98-b9d9-6a9c-2e7b-7ba9d9632517
msgctxt "h61d3eb08gf35fg4c02gaf18g6efe88e5be06"
msgid ""
"*You blink and the wilderness changes. A swamp, stinking and insidious, "
"assaults your senses.*"
msgstr "*당신이 눈을 깜빡이자 황야의 모습이 바뀝니다. 늪에서는 악취가 서서히 퍼지며 당신의 감각을 자극합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_ForestIllusion_Illusioncheck
#. Speaker = GROUP_PartyMembers
#. NodeID = 65a5d6ff-7d20-91a7-0531-a265196ecb18
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Charisma
#. DifficultyClass: 12
#. CheckFlags:
#.   Tag:
#.      - PALADIN(0) = True
#. TagRule: PALADIN_DEVOTION
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_ForestIllusion_Illusioncheck:65a5d6ff-7d20-91a7-0531-a265196ecb18
msgctxt "h9d2c2387g0a93g4916gb030gb273d3919cfe"
msgid ""
"<i>Something here is... unnatural. Reach out with your magic, seek its "
"source. </i>"
msgstr "<i>이곳은 뭔가... 부자연스럽다. 마법으로 손을 뻗어 그 근원을 찾는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_ForestIllusion_Illusioncheck
#. Speaker = GROUP_PartyMembers
#. NodeID = 65a5d6ff-7d20-91a7-0531-a265196ecb18
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: RawAbility
#. RollAbility: Charisma
#. DifficultyClass: 12
#. CheckFlags:
#.   Tag:
#.      - PALADIN(0) = True
#. TagRule: PALADIN_ANCIENTS
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_ForestIllusion_Illusioncheck:65a5d6ff-7d20-91a7-0531-a265196ecb18
msgctxt "h6239f504g5006g44dbga2e6g24fb292c7ab7"
msgid ""
"<i>Tap into the preternatural awareness granted by your oath. Seek the "
"truth.</i>"
msgstr "<i>맹세로 얻은 초자연적인 인식을 발휘한다. 진실을 찾는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_ForestIllusion_Illusioncheck
#. Speaker = Narrator
#. NodeID = 9a1ef990-c0e6-d5a4-00aa-03e44a6083e8
