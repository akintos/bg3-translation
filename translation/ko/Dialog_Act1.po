msgctxt "h69df8beeg43c0g4586g8206ge93911c77670"
msgid "The Blood of Lathander. Sounds precious - it can't be far from here."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_WeaponsPuzzle_PAD_HiddenNoteReaction
#. Speaker = Player
#. NodeID = 2088f301-dc5c-4a2d-87dc-aafc3c147fd0
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_WeaponsPuzzle_PAD_HiddenNoteReaction:2088f301-dc5c-4a2d-87dc-aafc3c147fd0
msgctxt "h267322bcgaf56g43e9g83c3gf78a24029a33"
