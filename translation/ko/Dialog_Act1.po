msgctxt "h5d784c8cgc6ebg43dbg9c44g82dd50355198"
msgid "Quick path... to surface..."
msgstr "지상으로 향하는... 빠른 경로..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FairyRings_Dead
