msgctxt "h04f8cadegbecfg4163g8987g71760210b2b3"
msgid "The Inquisitor awaits. Follow the corridor."
msgstr "심문관께서 기다리신다. 복도를 따라서 가라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_AD_CaptainSendsPlayerToInquisitior
#. Speaker = Kith'rak Therezzyn
#. NodeID = e99934bf-dcc5-08e8-4bf2-b8060aaeaaae
#. HandlePath = TaggedText[0].TagText[0]
