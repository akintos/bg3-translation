msgctxt "h05051769ge904g46eag949ag03b6ad86d4c8"
msgid ""
"Barrelstalks. Poisonous - and under the myconids' control. Best be careful."
msgstr "통줄기야. 맹독성인데, 마이코니드들이 통제하고 있군. 조심해야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PAD_BarrelstalkInteraction
#. Speaker = Player
#. NodeID = a319cca9-ccf6-c736-a43c-040d1c333c8c
