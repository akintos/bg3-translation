#.      - PLA_ZhentShipment_State_ImpersonatedPereghost = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap:8aac046f-ba07-4333-84ea-f69063440b68
msgctxt "hdf325f77ge2a3g4f03g9a82g1826da739e37"
msgid "Profit's more important than vengeance. Let's make a deal."
msgstr "복수보단 이익이 우선이지. 거래를 하자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap
#. Speaker = Rugan
#. NodeID = 8cdf4a3e-58b5-e702-d666-456f8e7fd617
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap:8cdf4a3e-58b5-e702-d666-456f8e7fd617
msgctxt "hd1b5e9d0g4eb4g4425g992ag67872179f00b"
msgid "Wait! WAIT! It was Olly, I SWEAR IT WAS OLLY!"
msgstr "잠깐! 잠깐! 올리 잘못이야. 올리 잘못이라고 맹세할게!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap
#. Speaker = Zarys
#. NodeID = 92653007-1d30-b1ca-e387-f63cab5c128e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap:92653007-1d30-b1ca-e387-f63cab5c128e
msgctxt "h41151f53g7623g4efegb0a0g5ef88a719ab6"
msgid "You're the one who recruited me, Rugan."
msgstr "날 영입한 건 너야, 루간."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap
#. Speaker = Narrator
#. NodeID = 956aa7ff-04e6-63fc-fc2e-081824246dab
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 53417497-b23e-58b7-dba9-bc64b80dd196_MadeSpotCheck = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap:956aa7ff-04e6-63fc-fc2e-081824246dab
msgctxt "h172c963egf9a7g460dgb5c9g3b296b37e9f9"
msgid ""
"*You spot explosives placed around the cavern. The Zhent are ready to bring "
"the place down.*"
msgstr "*동굴 주변으로 폭발물들이 설치되어 있는 것이 보입니다. 젠타림이 이곳을 무너뜨릴 준비를 마친 것 같습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap
#. Speaker = Rugan
#. NodeID = 983a10fd-8805-fb49-f2cf-1dbc745afdea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap:983a10fd-8805-fb49-f2cf-1dbc745afdea
msgctxt "hc4e1ed4egac93g4166gbd71gc093aa9c9181"
msgid "<i>Bwaah.</i>"
msgstr "<i>브와아아.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap
#. Speaker = Zarys
#. NodeID = 997034cf-9f74-7d63-6dd7-2fc724bd3fa7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_ImpersonatedPereghost = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap:997034cf-9f74-7d63-6dd7-2fc724bd3fa7
msgctxt "hf0fbbf63g7235g4fd2gab24g75220599e743"
msgid ""
"Well, at least you've read Manshoon. Makes your 'emissary' lie a touch more "
"tasteful."
msgstr "뭐, 적어도 멘슌을 읽긴 했군. 네 '사절' 거짓말에 맛을 좀 더해줬어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap
#. Speaker = Zarys
#. NodeID = 9fe12bbf-f2ed-5054-d7cf-1b27dd89a2db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap:9fe12bbf-f2ed-5054-d7cf-1b27dd89a2db
msgctxt "hd8fde9b6gadd8g4aa5g8472g5ed5b36f723a"
msgid "Oh, and kill him."
msgstr "오, 그를 죽이고 나서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap
#. Speaker = Player
#. NodeID = a68cd0bc-5e6b-2d9e-858e-e94ff2e42d0a
#. HandlePath = TaggedText[0].TagText[0]
