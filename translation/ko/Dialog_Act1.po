#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp:4e857deb-4f5d-4345-95e5-5187c00ef047
msgctxt "hb57085c8g6a29g487dgb90dg97558cdfa0ab"
msgid "<i>Draw on the power within to enforce your will.</i>"
msgstr "<i>몸 속에 흐르는 힘을 끌어내 본인의 의지를 관철한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp
#. Speaker = Player
#. NodeID = 4f08e637-5b71-b9e3-e87e-fa233ce65302
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#. TagRule: BERSERKER
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp:4f08e637-5b71-b9e3-e87e-fa233ce65302
msgctxt "h520ac5e8gad9cg45aaga47bg504865ae55d8"
msgid "<b>Let. Them. Go.</b>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp
#. Speaker = Player
#. NodeID = 4f08e637-5b71-b9e3-e87e-fa233ce65302
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp:4f08e637-5b71-b9e3-e87e-fa233ce65302
msgctxt "h4ae7155bge0e0g437dgac64g8a4afda2e20d"
msgid "The gnomes are free. Now walk away, while I'm feeling generous."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp
#. Speaker = Novice Grumm
#. NodeID = 519cc4f3-dcd0-4d06-d65b-61e225a4b044
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_DuergarLoyal_State_Alive = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp:519cc4f3-dcd0-4d06-d65b-61e225a4b044
msgctxt "h185a1531g5489g4f1dg8ae0gfcf069bcd229"
msgid "Listen up, bastards - I'm taking charge. Clean your 'nads and pack up."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp
#. Speaker = Player
#. NodeID = 5ce25338-2067-4695-a14d-7af45d3c2a2d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_GnomeWorkers_State_PermaDefeated = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp:5ce25338-2067-4695-a14d-7af45d3c2a2d
msgctxt "hfdd9816ag6918g4b37g9548gea37f7fdb2e8"
msgid "What about the gnomes? What happens to them?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp
#. Speaker = Wyll
#. NodeID = 65c9e6c0-ddc2-e7a4-c445-0e330c666f07
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp:65c9e6c0-ddc2-e7a4-c445-0e330c666f07
msgctxt "h673500dega746g46b4g84c2g9bb3ab20d6dd"
msgid "Your heart made of stone? They deserved freedom - and you denied it."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp
#. Speaker = Novice Grumm
#. NodeID = 74286d70-478f-4099-1080-5cc585dd0c98
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Moonrise_Knows_AbsoluteAtGrymforge = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp:74286d70-478f-4099-1080-5cc585dd0c98
msgctxt "h2609f25bg071cg4387g85acg117f264363e8"
msgid ""
"Time for the General to recognise us duergar that have been toiling 'round "
"here."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp
#. Speaker = Player
#. NodeID = 74e3a092-7567-c41b-a25b-1fa67e8dafe4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_Mutineers_Event_FailedtoFreeGnomes = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp:74e3a092-7567-c41b-a25b-1fa67e8dafe4
msgctxt "h09e97417gb024g4c06g90d3g255757fff374"
msgid "It's time I cut you down once and for all."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp
#. Speaker = Player
#. NodeID = 888f0edb-1b49-4a87-f04a-b1f63203ebaa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp:888f0edb-1b49-4a87-f04a-b1f63203ebaa
msgctxt "hc7fa488fge2e8g4374g88aag45ee58c9abbb"
msgid "This General sounds powerful. Who is he, exactly?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp
#. Speaker = Novice Grumm
#. NodeID = 8cbb7959-2eed-d2ba-639c-d7d54b80aebf
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_State_LeaderFreedGnomes = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp:8cbb7959-2eed-d2ba-639c-d7d54b80aebf
msgctxt "hc389f4e5g72a6g4699ga587gb1308a433b36"
msgid ""
"Gnomes - it's your lucky day. Get your squat arses moving, before I take a "
"brand to them."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp
#. Speaker = Novice Grumm
#. NodeID = 9532033e-7741-fa01-21d4-b575bacedff2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_DuergarMutineerFollowUp_Event_Happened = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp:9532033e-7741-fa01-21d4-b575bacedff2
msgctxt "h6991ac9fgf50bg4a4fgb310g06c47d3522b6"
msgid "Shit - True Soul Nere's nothing but grub-chow now."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp
#. Speaker = Player
#. NodeID = 96f75cde-44f6-479a-85f3-90083e5603fa
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 10
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#.      - ILLITHID(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp:96f75cde-44f6-479a-85f3-90083e5603fa
msgctxt "he76a1eccg1e68g4d6bga715ged195d36be02"
msgid "<i>Enter his mind. 'Release the gnomes.'</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp
#. Speaker = Novice Grumm
#. NodeID = 9c299e55-cf8b-88c4-126a-f946c4fd0fcd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp:9c299e55-cf8b-88c4-126a-f946c4fd0fcd
msgctxt "h2b671e23g0a5ag4aacgbe18g773da8b71e2a"
msgid "Ask and receive. <i>Zavagh!</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp
#. Speaker = Wyll
#. NodeID = 9c3893ef-68d9-0e92-154b-d8c0b83046c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp:9c3893ef-68d9-0e92-154b-d8c0b83046c9
msgctxt "he567b2d7gef9ag4525gb70fge3f6df1efba3"
msgid "Speak up. You can't just let the clan keep them."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp
#. Speaker = Narrator
#. NodeID = a3f7ab31-ddae-4d57-a42e-c72ac773d324
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - GLO_TadpoleIntro_NPC(1) = False
#. SetFlags:
#.   User:
#.     - GLO_TadpoleIntro_NPC(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp:a3f7ab31-ddae-4d57-a42e-c72ac773d324
msgctxt "h02ba4c60gd9a6g4f2ag91f2g2325bed3c61e"
msgid ""
"*A strange symbol glows, marked on their flesh, and something within you "
"stirs in response.*"
msgstr "*그들의 살갗에 새겨진 기묘한 상징이 빛나고, 이에 반응하여 당신 내면의 무언가가 꿈틀거립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp
#. Speaker = Novice Grumm
#. NodeID = a8817aa0-0712-4639-0de5-ef2986b3f004
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_Mutineers_Event_FailedtoFreeGnomes = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp:a8817aa0-0712-4639-0de5-ef2986b3f004
msgctxt "h4e0c6472g2591g4743gb7cegac5bc5230a40"
msgid ""
"That head of yours must be mixed up. The slaves are for the General. <i>End "
"of.</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp
#. Speaker = Novice Grumm
#. NodeID = b0d9c840-447b-4879-b5ae-da4e9bedeabf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp:b0d9c840-447b-4879-b5ae-da4e9bedeabf
msgctxt "he483796age6c5g44a8gbc1bg0cf1b8625a3e"
msgid "Shit - suppose you're right. No use hauling dead weight."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp
#. Speaker = Novice Grumm
#. NodeID = b2fc6ac8-a273-9771-97cc-f5cfad5cb6ff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp:b2fc6ac8-a273-9771-97cc-f5cfad5cb6ff
msgctxt "h62b076c1gc6d3g4732g860ag0350f911a42f"
msgid ""
"That curse chokes the air from here clear to Moonrise. Not that I'm worried."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp
#. Speaker = Novice Grumm
#. NodeID = b36da447-fbc6-3c9d-96e3-c3f69680a29d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp:b36da447-fbc6-3c9d-96e3-c3f69680a29d
msgctxt "h56f1f6aeg12a1g488ag87c0g08b1de186d09"
msgid "Let's do this!"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp
#. Speaker = Novice Grumm
#. NodeID = b63d3c31-c5c1-456e-8a83-f47cf663ef8b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp:b63d3c31-c5c1-456e-8a83-f47cf663ef8b
msgctxt "haa841790g1958g4b89g84f7g20c554c48023"
msgid "What the... you messing with my mind? I won't stand for it!"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp
#. Speaker = Novice Grumm
#. NodeID = c3205473-0779-e269-7e86-1a252cf22dbf
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp:c3205473-0779-e269-7e86-1a252cf22dbf
msgctxt "hf272bddcga047g4013g8b98geb1897d698ab"
msgid "Smug words for a walking corpse. <i>Zavagh!</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp
#. Speaker = Narrator
#. NodeID = c5133805-92d6-44be-ae51-ef412490b43a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - GLO_TadpoleIntro_NPC(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp:c5133805-92d6-44be-ae51-ef412490b43a
msgctxt "h7bf2544fg632eg46bag855dg2de8d116ea1d"
msgid "*As the symbol glows, power courses through you. <i>Authority</i>.*"
msgstr "*문양이 빛나며, 몸에 흐르는 힘이 느껴집니다. <i>권위</i>.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp
#. Speaker = Player
#. NodeID = c80d3924-5823-22a4-596f-bb2a9fa5a0b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp:c80d3924-5823-22a4-596f-bb2a9fa5a0b1
msgctxt "h828e0269g1e14g493aga0f2gf7ff6b05380d"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp
#. Speaker = Player
#. NodeID = d134fd2d-8d83-2fe3-fcf3-ac437d20c69c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp:d134fd2d-8d83-2fe3-fcf3-ac437d20c69c
msgctxt "hc867434dg1dadg4bb0ga32bg00f613c3ea61"
msgid "They will make a fine offering."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp
#. Speaker = Novice Grumm
#. NodeID = d1d1b995-48ff-b8f3-f37f-92351333cbf2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp:d1d1b995-48ff-b8f3-f37f-92351333cbf2
msgctxt "h23a42fdfgda1bg4b1dg969cg54ddd4603bdd"
msgid "Come and take them, then!"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp
#. Speaker = Narrator
#. NodeID = d54ffa5c-f689-49ae-9600-3fde419bbf51
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount4(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount4(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp:d54ffa5c-f689-49ae-9600-3fde419bbf51
msgctxt "hf78f4affge325g4cdcgbf3agd83e4797fda0"
msgid ""
"*A shadow swims across your vision, and a familiar voice tells you to be "
"calm. You are loved.*"
msgstr "*그림자가 낀 듯이 눈앞이 흐려지더니, 익숙한 목소리가 당신을 달래줍니다. 사랑이 느껴집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp
#. Speaker = Novice Grumm
#. NodeID = d6bd97f4-93e0-42e3-4f02-636487fe29ca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp:d6bd97f4-93e0-42e3-4f02-636487fe29ca
msgctxt "h81ac2b2bgdaddg462eg9e3bg545cff42d393"
msgid "Absolute let Nere and Thrinn both get capped. She's not offin' me now."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp
#. Speaker = Narrator
#. NodeID = dc0be7ad-3a86-4f23-a24c-678bbf872ea3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp:dc0be7ad-3a86-4f23-a24c-678bbf872ea3
msgctxt "h21122b40g9054g4e6dgb794g91fce20b1ece"
msgid "*A shiver runs across your mind... You feel sated.*"
msgstr "*전율이 불현듯 머릿속을 스쳐 지나가고... 만족감이 듭니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp
#. Speaker = Novice Grumm
#. NodeID = e02c85ea-4d91-f1d6-7d1c-4a35c3c985c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp:e02c85ea-4d91-f1d6-7d1c-4a35c3c985c8
msgctxt "ha6c63ff4g837dg4c25gabaag43dec31fee99"
msgid ""
"What - you'd think I'd just toss 'em? They're coming with me. A gift for the "
"General."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp
#. Speaker = Novice Grumm
#. NodeID = e31d15a4-dcb4-d70a-fac5-507b486c1c35
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp:e31d15a4-dcb4-d70a-fac5-507b486c1c35
msgctxt "h3179a93bg5fb3g4efeg827dg210b0890abd2"
msgid "Then show me. And may the Absolute bless the victor!"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp
#. Speaker = Gale
#. NodeID = e6972865-c34a-731a-19aa-4e390503719e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp:e6972865-c34a-731a-19aa-4e390503719e
msgctxt "hcb55ded6g209eg4f16gaaf4g2aa0968d5fff"
msgid ""
"Brittle are the foundations upon which the houses of tyrants are built. It "
"seems I judged you to be less brittle than you really are."
msgstr "폭군들의 집이 세워지는 토대는 연약하지. 보아하니 내가 너를 덜 연약하다고 과대평가한 거 같네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp
#. Speaker = Narrator
#. NodeID = e7d4467c-bf4f-4f3f-a88d-f1ac92dc3e7a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp:e7d4467c-bf4f-4f3f-a88d-f1ac92dc3e7a
msgctxt "h31e4a569ga68fg4493g9a0bg582ef1b0b88a"
msgid ""
"*You focus on the source of the power, but it is quiet and still. It needs "
"to rest.*"
msgstr "*힘의 원천인 존재에 정신을 집중하지만, 응답이 없습니다. 휴식이 필요한 겁니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp
#. Speaker = Narrator
#. NodeID = e7e101c3-017a-4892-8103-98bcc32bee85
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount5(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount5(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp:e7e101c3-017a-4892-8103-98bcc32bee85
msgctxt "h6864eb3eg6838g4fafga364g5bba6c05451f"
msgid ""
"*Your blood runs quicker, feeding the gnawing absence at the centre of your "
"mind.*"
msgstr "*피가 더 빨리 흐르면서, 당신의 정신 한가운데를 좀먹는 허전함을 양분으로 채웁니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp
#. Speaker = Novice Grumm
#. NodeID = e80d52de-35f9-f525-5582-3f323dc3679b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp:e80d52de-35f9-f525-5582-3f323dc3679b
msgctxt "h73f6796dgc381g4732gad84g02060aec4eea"
msgid "Hells yes. The General can't ignore a haul of fresh slaves."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp
#. Speaker = Player
#. NodeID = e93a7b82-4736-96a5-a3ea-8556ff678075
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_Mutineers_Event_FailedtoFreeGnomes = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp:e93a7b82-4736-96a5-a3ea-8556ff678075
msgctxt "h98cad3a1g72dfg4c1dg83bagf85730ec7c19"
msgid "I am freeing these gnomes. Just try and stop me."
msgstr "이 노움들을 풀어줄 거야. 어디 한 번 막아 보시든가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp
#. Speaker = Novice Grumm
#. NodeID = f05f335d-c685-8796-85d9-b4a8aee18963
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp:f05f335d-c685-8796-85d9-b4a8aee18963
msgctxt "h065ec89fg16b1g4a90ga5d1ga1960b6b64b4"
msgid "Yeah? Well I won't give you lip - what the Absolute wants, She gets."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp
#. Speaker = Novice Grumm
#. NodeID = f709950f-c2d1-e85c-4707-211ace00bea2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp:f709950f-c2d1-e85c-4707-211ace00bea2
msgctxt "h08f7644dg71cdg416egb587gb0ffe591472c"
msgid ""
"He's the Absolute's Chosen, the way Nere talked. Building an army at "
"Moonrise - best of the best."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp
#. Speaker = Novice Grumm
#. NodeID = f9811f8d-b5ff-51c7-339f-45f1017911db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp:f9811f8d-b5ff-51c7-339f-45f1017911db
msgctxt "h87ef174bg2ddcg4b9cgbdcagb9016a16c879"
msgid "She'll part the curse for me. I got complete faith."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp
#. Speaker = Novice Grumm
#. NodeID = fa48d5d8-dee2-7a6c-1406-98b5144538d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp:fa48d5d8-dee2-7a6c-1406-98b5144538d8
msgctxt "h669a28aeg68b0g4080g8107gbe5c946b006d"
msgid "Fine. Not looking to piss off a True Soul."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp
#. Speaker = Novice Grumm
#. NodeID = fb773038-d80c-6372-3a7c-d34f201f46b7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp:fb773038-d80c-6372-3a7c-d34f201f46b7
msgctxt "hb83c746cg8cffg42c6g8860g9ce9d5617b39"
msgid ""
"Now I'm in charge here, he'll make <i>me</i> a True Soul. Maybe even a "
"<i>Disciple.</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = 02a77357-cfe8-ff74-a748-51bc2c339174
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:02a77357-cfe8-ff74-a748-51bc2c339174
msgctxt "hcebc357agc946g490bgac97g5f689de53a6b"
msgid "But we ain't need <i>glory </i>- just coin. And Nere's got plenty."
msgstr "하지만 우리에게 <i>영광</i>은 필요 없어. 동전이면 돼. 그리고 니어는 그게 아주 많지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Narrator
#. NodeID = 02ed69ba-8e9b-865f-b5be-ed738a4e1b59
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:02ed69ba-8e9b-865f-b5be-ed738a4e1b59
msgctxt "hb36d5f42gd94fg49f9gbdc0g4127b9ec151b"
msgid "*The slightest of breezes slips through your skull.*"
msgstr "*아주 미세한 바람이 당신의 두개골 사이로 스쳐 지나갑니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = 08ad387c-cee7-7cc2-74d6-da8acd0db8fb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:08ad387c-cee7-7cc2-74d6-da8acd0db8fb
msgctxt "h08706d42g6436g4e23gbd02g33f92fd97775"
msgid "The stench don't lie. You're one of them."
msgstr "악취는 거짓말을 하지 않아. 너도 그들 중 하나야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Player
#. NodeID = 0f0feb24-ce9d-b04e-e5c7-bf9e8db7eda7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:0f0feb24-ce9d-b04e-e5c7-bf9e8db7eda7
msgctxt "h05d1bce0gca12g45ceg8cc4gd25cda865ed8"
msgid "What gold? I thought you hadn't been paid yet."
msgstr "무슨 금? 아직 너도 빚을 못 받은 걸로 아는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = 0ff0f2aa-2d10-b1f8-15f0-fdaecc0da8e1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_GnomeWorkerDaffy_State_PermaDefeated = False
#. SetFlags:
#.   Global:
#.     - UND_Mutineers_Event_SaidTalkApprentice = True
#.   Quest:
#.     - UND_CaveIn_SUB_Smokepowder.HeardAboutHiddenGnome(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:0ff0f2aa-2d10-b1f8-15f0-fdaecc0da8e1
msgctxt "hc1df5c05g5bc8g4defg8ff0g874389b6fc97"
msgid ""
"Her crew know more than they're letting on - see if you can get 'em to talk."
msgstr "하지만 그녀의 동료들은 알고 있는 만큼 털어놓지 않아. 네가 그들의 입을 열 방법을 찾아봐라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Player
#. NodeID = 17246b09-a083-2a03-e3ff-84b8362ab475
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:17246b09-a083-2a03-e3ff-84b8362ab475
msgctxt "he0b526d8g65f4g4d35g9346gfb59dfe6f42f"
msgid "A stench? Ridiculous. I'm no more a True Soul than you are."
msgstr "악취? 터무니없군. 네가 참된 영혼이 아닌 만큼 나도 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = 18fda1a2-d416-925d-bc83-8017e8cce361
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:18fda1a2-d416-925d-bc83-8017e8cce361
msgctxt "h341c10afg2178g4edagbaf0g00a4055d241b"
msgid "Some days back, a slave gnome bolted with smokepowder. Handy stuff."
msgstr "며칠 전에, 한 노움 노예가 화약을 들고 도망쳤지. 편리한 물건인데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Player
#. NodeID = 1ca6a0a7-895d-ebfb-a715-e40de4bddad5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4103e544-e1db-525f-81ec-b5dfa71907d7_KurCalmedBrithvar = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:1ca6a0a7-895d-ebfb-a715-e40de4bddad5
msgctxt "h603b3082g7d52g4113ga88eg6d45fae861bf"
msgid "You want my gold? Then you'll have to fight me for it."
msgstr "내 금을 원하나? 나와 싸워서 가져가야 할걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Player
#. NodeID = 1d722d6e-5b5c-2a68-de9b-b2d0401f6376
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - REALLY_DEEPGNOME(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:1d722d6e-5b5c-2a68-de9b-b2d0401f6376
msgctxt "h5673e7c4g46e6g4935g8deagff54d8970706"
msgid "You're imagining things. I would never bow to the Absolute."
msgstr "너는 상상을 하고 있어. 나는 절대자에게 복종하지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Player
#. NodeID = 1e5c4548-2089-a2b3-5fe8-db9fd1de9807
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DUERGARDWARF or GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:1e5c4548-2089-a2b3-5fe8-db9fd1de9807
msgctxt "h06eac46eg98cag4a1cga2a1g5e97c3b8fcae"
msgid ""
"That 'stench' is just psionic resonance - a remnant of our ancestors' "
"enslavement by illithids."
msgstr "그 '악취'는 단지 정신적 잔향에 불과하다. 우리 조상들이 일리시드 노예였던 시절의 부스러기 말이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = 27af2e56-6af7-28d9-f1aa-c96dcfea021d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:27af2e56-6af7-28d9-f1aa-c96dcfea021d
msgctxt "h482394b8g10b9g4e0bg987agc41c5d9ecc64"
msgid "Ain't my gold I'm offering. It's the True Soul's."
msgstr "내가 금을 제공하는 게 아니야. 그 참된 영혼의 금이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = 2a3ffff7-154b-f6f9-356a-436d9c6ccc4f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_DuergarMutineers_Event_PlayerNotTrueSouls = True
#.   Local:
#.     - 4103e544-e1db-525f-81ec-b5dfa71907d7_NotTrueSoul = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:2a3ffff7-154b-f6f9-356a-436d9c6ccc4f
msgctxt "h143282feg4ba4g4a86gb63agdd947cb821f1"
msgid "Hm... revenge, eh?"
msgstr "흠... 복수라, 그래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Player
#. NodeID = 2a8295dd-9014-c228-c96c-a3bbc1279264
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:2a8295dd-9014-c228-c96c-a3bbc1279264
msgctxt "h28a14d80g45beg4dcbgb9fdgbc3e1f93a640"
msgid "I <i>was</i> a True Soul. That cult lied to me - now I want revenge."
msgstr "나는 참된 영혼<i>이었다</i>. 그 사이비 종교는 나를 속였어. 현재 나는 복수를 원한다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = 2b3a33b2-a76f-d503-e621-a53da6857973
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4103e544-e1db-525f-81ec-b5dfa71907d7_KurCalmedBrithvar = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:2b3a33b2-a76f-d503-e621-a53da6857973
msgctxt "h49981630gf8edg4eafg9a84gfb428f75f75d"
msgid "You don't leave 'til I get my due."
msgstr "내 돈 토해낼 때까진 아무 데도 못 가지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = 2f9d76bd-17fb-eb2c-205d-772cefe40281
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4103e544-e1db-525f-81ec-b5dfa71907d7_KurCalmedBrithvar = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:2f9d76bd-17fb-eb2c-205d-772cefe40281
msgctxt "h14ff540fgd9fbg4902gbae7g654e2bd793ed"
msgid "Time we took our due. Your blade ready, Kur?"
msgstr "우리 빚을 받을 때가 됐다. 칼 준비됐나, 쿠르?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = 307c2d61-98d2-e327-327a-67bf5273ab2e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:307c2d61-98d2-e327-327a-67bf5273ab2e
msgctxt "h5cc26b42gea85g4e40gb0a9g1acc06d41816"
msgid "Would you look at that, Kur. Someone's having a listen."
msgstr "저기 좀 보게, 쿠르. 누가 엿듣고 있네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = 33b42587-704c-30e4-8655-8b30e68519dd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:33b42587-704c-30e4-8655-8b30e68519dd
msgctxt "h0183a765gb0eeg4378gb80cge04e62ec4b97"
msgid ""
"The cult watches through it. And we can't risk more Twat-Souls showing up."
msgstr "교단 놈들이 그걸로 감시하고 있거든. 참된 씹것들이 더 튀어나오는 위험을 감수할 순 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = 345f996b-47b1-62e8-d634-1996e2ccb37e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:345f996b-47b1-62e8-d634-1996e2ccb37e
msgctxt "h06c99bdeg9d3dg4da2g9df6gfe0a73f25972"
msgid ""
"Thrinn's after the Absolute's glory - that's why she's got those slaves "
"digging for Nere."
msgstr "쓰린은 절대자의 영광을 쫓고 있어. 그래서 니어를 구출하려고 노예들을 부리고 있는 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = 35f10f6e-34dc-2d6e-bb94-536d80446b96
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:35f10f6e-34dc-2d6e-bb94-536d80446b96
msgctxt "h03c32a93g053eg4e9fgb6b2g788c49fabb45"
msgid "Now move. You're hogging my air."
msgstr "이제 움직여. 네가 내 공기를 독차지하고 있잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Player
#. NodeID = 37305a9a-023c-6b8a-358d-0073bc8ebf51
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:37305a9a-023c-6b8a-358d-0073bc8ebf51
msgctxt "h33a4e95fga4bcg4a22g81d6gf7d721d02eb6"
msgid "Why would you think I'm a True Soul?"
msgstr "어째서 나를 참된 영혼이라고 생각하지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = 38d72861-4472-4df9-e942-82ef6a2e3fc6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_DuergarCamp_State_CaveInCleared = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:38d72861-4472-4df9-e942-82ef6a2e3fc6
msgctxt "hbedecafdg2db1g45f0gb286gf2711b3471a0"
msgid "Off with you. Private conversation."
msgstr "저리 꺼져. 사적인 대화 중이니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = 3b63d007-8b20-1a35-0905-545edd2a16c5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_DuergarCamp_Event_MutineersSkirmish = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:3b63d007-8b20-1a35-0905-545edd2a16c5
msgctxt "hd4bfaae7g0986g478fg862eg788183fb3277"
msgid "Big words - let's see you back them up."
msgstr "포부도 크시지. 그럴 깜냥이 되는지 보자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Player
#. NodeID = 433b8074-c12b-d052-e660-ca161aee9e9b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:433b8074-c12b-d052-e660-ca161aee9e9b
msgctxt "h254b29c1gb5c8g4467gb5dcg5f74438dfd55"
msgid "Please. I've already got more coin than you could carry."
msgstr "귀엽네. 내겐 이미 네가 들 수도 없을 만큼의 금화가 있는걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = 4856b867-e1b2-618d-88da-fca44c1c6839
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:4856b867-e1b2-618d-88da-fca44c1c6839
msgctxt "h7cda2503g03fdg401dgb25eg40b48a82f6e5"
msgid "Yet you got that Twat-Soul stench."
msgstr "하지만 너에게는 참된 씹것의 악취가 나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Player
#. NodeID = 4b29cd5e-96db-52d4-3670-c3226a1d0dfe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4103e544-e1db-525f-81ec-b5dfa71907d7_KurCalmedBrithvar = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:4b29cd5e-96db-52d4-3670-c3226a1d0dfe
msgctxt "hf6528541gb856g42f9gb68eg6b97b2ba3878"
msgid "These True Souls are my enemies, not my allies."
msgstr "참된 영혼들은 내 아군이 아닌, 적이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Player
#. NodeID = 4d8cb89f-b59f-221c-a2d8-3dadde8c323e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:4d8cb89f-b59f-221c-a2d8-3dadde8c323e
msgctxt "h93d6f3b5g0052g44aag9fb1g451885bd6f78"
msgid "It was a joke. I'm as poor as a pauper."
msgstr "농담이었어. 난 너무 가난해서 보조금을 받아야 할 판인걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Player
#. NodeID = 501d191b-ff24-e191-0ad7-c5247b9dac40
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:501d191b-ff24-e191-0ad7-c5247b9dac40
msgctxt "h163fd6c0g7a85g40aag9d8dg5cf4b15f2d94"
msgid "If you're offering me a job, I'm not interested."
msgstr "내게 일을 제안하는 거라면 관심 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = 508a7364-0113-5ecf-644c-43ae6e715548
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:508a7364-0113-5ecf-644c-43ae6e715548
msgctxt "h0aa8bfa4g60d7g4495g9bd8gccba0580c2d1"
msgid "Half? <i>Drugnin' rakkah</i>. Should split your skull for the insult."
msgstr "절반? <i>병신 같은 라카</i>. 모욕죄로 네놈 대가리를 절반으로 쪼개야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = 531096e3-a94b-5620-931a-0105f06a1d71
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_GnomeWorkerDaffy_State_PermaDefeated = True
#.      - UND_ScryingEye_State_PermaDefeated = True
#. SetFlags:
#.   Global:
#.     - UND_DuergarCamp_State_RecruitedMutineers = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:531096e3-a94b-5620-931a-0105f06a1d71
msgctxt "h11aa1c35g048eg4a42g9841g56f5e848fa37"
msgid "Fine. Half it is."
msgstr "좋아. 절반이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = 5355e1b8-95ef-aeb4-895e-f3161f80086c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:5355e1b8-95ef-aeb4-895e-f3161f80086c
msgctxt "h9ff23c68g3d7eg4cdcg990bgaa04d2906461"
msgid "The stench - all you Twat-Souls got one. Some of us got a nose for it."
msgstr "너희 참된 씹것들은 모두 악취가 나더군. 우리 중 일부는 그걸 맡을 수 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = 55cd20e9-ef13-1f3a-bfc0-de0daefd7c28
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:55cd20e9-ef13-1f3a-bfc0-de0daefd7c28
msgctxt "h2149d2f8g50f8g4b32g8896g41dec1e40a42"
msgid "He stinks to the deepest hells, that's for sure. Could be you're right."
msgstr "장담하는데 그새낀 아마 지옥 끝까지 냄새를 풍길걸. 네 말이 맞을지도 모르겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Player
#. NodeID = 5c0977b5-6f35-1ce5-1a7d-232f83622984
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4103e544-e1db-525f-81ec-b5dfa71907d7_WantNereOut = False
#. SetFlags:
#.   Dialog:
#.     - UND_Mutineers_AskedAboutLead(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:5c0977b5-6f35-1ce5-1a7d-232f83622984
msgctxt "h0dd3845bg2426g4609g8da2gb173b5880fc5"
msgid "Any ideas on getting Nere out?"
msgstr "니어를 꺼낼 아이디어는 있나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Narrator
#. NodeID = 5fe0305d-7305-0491-b93e-bfa47194a270
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:5fe0305d-7305-0491-b93e-bfa47194a270
msgctxt "hb2eec707gb32bg4057g97cbgd866ee041168"
msgid "*The shiver returns. This time, it's colder. Sharper.*"
msgstr "*전율이 다시 찾아옵니다. 이번에는 더 차갑고, 날카롭습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = 603ae563-e75f-ebb4-8f47-5367c95bdcef
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_GnomeWorkerDaffy_State_PermaDefeated = False
#.      - UND_ScryingEye_State_PermaDefeated = True
#. SetFlags:
#.   Global:
#.     - UND_DuergarCamp_State_RecruitedMutineers = True
#.     - UND_Mutineers_Event_SaidTalkApprentice = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:603ae563-e75f-ebb4-8f47-5367c95bdcef
msgctxt "hedb2b59bgddf3g438fgb275ge3ab5a0cdcad"
msgid "Fine. Half it is. But you need to bust Nere out first."
msgstr "좋아. 절반이야. 하지만 우선 네가 니어를 꺼내야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Player
#. NodeID = 61253ce8-b2ad-ea8a-f49d-c6aca3fad5e1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:61253ce8-b2ad-ea8a-f49d-c6aca3fad5e1
msgctxt "h360ae742gcba1g4176g8736g378fef2486b7"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = 6357ebce-22f9-f7ac-a3b4-1eb1cb7e5e60
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_DuergarMutineers_Event_PlayerNotTrueSouls = True
#.   Local:
#.     - 4103e544-e1db-525f-81ec-b5dfa71907d7_NotTrueSoul = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:6357ebce-22f9-f7ac-a3b4-1eb1cb7e5e60
msgctxt "h7e3c6d9bg0992g4b75g99a5g24aeea0881b1"
msgid "Could be you're right. Something's different with you."
msgstr "너의 말이 맞을 수도 있겠군. 너는 뭔가 달라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Player
#. NodeID = 63f2604f-28cf-ffe8-4045-e4012828a151
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:63f2604f-28cf-ffe8-4045-e4012828a151
msgctxt "had43ffd7g5cb3g4a8eg8d7eg2eacffe342d9"
msgid "Fine - I'm a True Soul. What do you plan to do about it?"
msgstr "그래 - 나는 참된 영혼이다. 그래서 어떻게 할 생각이지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = 6ae19a96-9cef-9fa6-f67f-2fe74d3d8094
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_ScryingEye_State_PermaDefeated = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:6ae19a96-9cef-9fa6-f67f-2fe74d3d8094
msgctxt "h35c358ffg28bfg45c9ga97fg775e7d6d82e6"
msgid "Fine. Half it is. But first we need to take care of something."
msgstr "좋아. 절반이야. 하지만 먼저 신경 써야 할 게 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Player
#. NodeID = 6e20311e-fc98-45c0-bd76-b305d7a24410
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:6e20311e-fc98-45c0-bd76-b305d7a24410
msgctxt "h150e823eg2d5dg4f9ega069g920478faced6"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = 6e681745-e2ce-a1b4-1e48-d5719fc14dca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:6e681745-e2ce-a1b4-1e48-d5719fc14dca
msgctxt "h3702e7abg3087g4a77gb975g70bb7cd4fa39"
msgid "Once you blast Nere out, we'll chop him into chunks and take our dues."
msgstr "네가 폭탄으로 니어를 꺼내 주면, 우린 놈을 썰어서 빚을 받아내겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Player
#. NodeID = 6f54d135-3083-17c1-c59f-3f985b40ce3a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_DuergarRebelGreedy_Event_ToldHasExplosives = False
#.   Object:
#.      - HasTaggedItem_EXPLOSIVES(2) = True
#. SetFlags:
#.   Global:
#.     - UND_DuergarRebelGreedy_Event_ToldHasExplosives = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:6f54d135-3083-17c1-c59f-3f985b40ce3a
msgctxt "h8ee1e327g083bg423dg8df1g693e9ac6e85d"
msgid "I've obtained explosive powder. That should open the tunnel."
msgstr "폭약 가루를 얻었어. 터널을 열 수 있을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Player
#. NodeID = 706a14f4-8872-bd54-2148-9936f42e9dad
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:706a14f4-8872-bd54-2148-9936f42e9dad
msgctxt "h5faf784egb72eg40fdg9681g46065e7798c8"
msgid "<i>Just smile. Let him see the rage in your eyes.</i>"
msgstr "<i>말없이 미소 짓는다. 당신의 눈에 서린 분노를 그에게 보여준다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = 71ed5c4a-613f-ae07-2f98-354ac0625799
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:71ed5c4a-613f-ae07-2f98-354ac0625799
msgctxt "h51e15420gfca3g419ag8349ga89818e1e6f2"
msgid "I ain't parleying with more Twat-Souls - that stench don't lie."
msgstr "참된 씹것들과 협상은 더 안 할 거야. 그 악취는 거짓말하지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = 71ff92af-574b-4b4f-2846-3c72612f4d8c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:71ff92af-574b-4b4f-2846-3c72612f4d8c
msgctxt "h5a8daf29g306dg4c45ga35fg21445550fdf2"
msgid "You don't need to ask twice. Your blade ready, Kur?"
msgstr "두 번 물을 필요 없다. 칼 준비됐나, 쿠르?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Player
#. NodeID = 72765275-d4e2-a094-579d-4b2236dded67
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4103e544-e1db-525f-81ec-b5dfa71907d7_WantNereOut = False
#. SetFlags:
#.   Local:
#.     - 4103e544-e1db-525f-81ec-b5dfa71907d7_WantNereOut = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:72765275-d4e2-a094-579d-4b2236dded67
msgctxt "h19552214gb3eag4311ga763ged2041f24d6c"
msgid "I heard you talking. I want Nere out - and you have a lead."
msgstr "너희가 말하는 건 들었다. 나는 니어를 밖으로 꺼내길 원한다. 게다가 너는 단서를 갖고 있군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = 729bcaaf-8083-33ee-d435-dbf9f8625253
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:729bcaaf-8083-33ee-d435-dbf9f8625253
msgctxt "h161a22beg3510g49efg96cage7f7cd9fc782"
msgid "In that case - want to earn some gold?"
msgstr "그렇다면, 금을 벌고 싶나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Player
#. NodeID = 75901a76-f38e-8fbc-60f9-f8e7e35c00fb
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - REALLY_DEEPGNOME(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:75901a76-f38e-8fbc-60f9-f8e7e35c00fb
msgctxt "hdea67facg18b2g4346ga8a2g5c5d37cd6914"
msgid ""
"Use your head - can you imagine a deep gnome being picked as a True Soul?"
msgstr "머리를 써 - 딥 노움이 참된 영혼으로 간택되는 게 말이 돼?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = 7695652e-339f-eb71-e699-d4ca996c56d1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:7695652e-339f-eb71-e699-d4ca996c56d1
msgctxt "h3ac42788g91ffg42fbga6fdg499efd48c617"
msgid "That right? And wouldn't you know - my pockets are mighty light."
msgstr "그렇단 말이지? 마침 하나 알려줄 게 있는데, 내 주머니는 존나 가볍거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = 78f661b5-e289-a4a3-7667-d78d39448591
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:78f661b5-e289-a4a3-7667-d78d39448591
msgctxt "he6bd785agef10g457eg99fdgc64488f36809"
msgid "Help Thrinn free Nere - then you and my chums grind him up."
msgstr "쓰린을 도와서 니어를 해방시켜줘. 그 후에 너와 내 친구들이 그를 갈아버리는 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = 7ceaa3bb-ec44-8cdb-8761-aadbc5a7d87c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:7ceaa3bb-ec44-8cdb-8761-aadbc5a7d87c
msgctxt "h77aee21fge737g44dbgaf92g47c33869d5d2"
msgid "Fine. Spill what you want, True Soul, before I choke on your stench."
msgstr "그러지. 원하는 걸 말해라, 참된 영혼. 내가 너의 악취에 질식하기 전에."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = 87672deb-d0a8-bd86-5c45-22f7442198cf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_GnomeWorkerDaffy_State_PermaDefeated = False
#.      - UND_ScryingEye_State_PermaDefeated = True
#. SetFlags:
#.   Global:
#.     - UND_DuergarCamp_State_RecruitedMutineers = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:87672deb-d0a8-bd86-5c45-22f7442198cf
msgctxt "hd57a8c99ge4b6g4127g9d9dg7fe2dac96689"
msgid "Good. Reckon the gnomes are key to busting Nere out."
msgstr "좋아. 노움들이 니어를 탈출시킬 열쇠인 거 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = 8841b9a4-6df1-7fdd-2e72-6fc715db99f9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_GnomeWorkerDaffy_State_PermaDefeated = True
#.      - UND_ScryingEye_State_PermaDefeated = True
#. SetFlags:
#.   Global:
#.     - UND_DuergarCamp_State_RecruitedMutineers = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:8841b9a4-6df1-7fdd-2e72-6fc715db99f9
msgctxt "h648ec93dgb6c8g41e1g9ee2g4ed316f49b8f"
msgid "Just what I like to hear."
msgstr "바로 그거지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Player
#. NodeID = 8c4ec968-b793-f47d-8a9e-cb56b80910a1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 6cdaa3ab-e6b3-2e7c-8244-bd4dd3dd4e83_MindHasBeenRead = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:8c4ec968-b793-f47d-8a9e-cb56b80910a1
msgctxt "h38877774g26c0g4e18ga659g12057a2f9f51"
msgid "That's not me you smell. You must still be catching Nere's scent."
msgstr "네 코가 사람 잘못 짚었어. 그 냄새는 내가 아니라 니어 냄새라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = 908bcd7e-ee0a-9689-b47b-11f557684521
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_Mutineers_Quest_KillEye = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:908bcd7e-ee0a-9689-b47b-11f557684521
msgctxt "ha2807dfeg91b2g404dgb10fga58fbacbb71e"
msgid "Knife it. And don't get caught."
msgstr "그걸 찢어버려. 그리고 붙잡히지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Player
#. NodeID = 9133171e-386b-12e9-047a-638d60a01796
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - GLO_Not_For_EA = True
#.   Tag:
#.      - PALADIN_VENGEANCE(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:9133171e-386b-12e9-047a-638d60a01796
msgctxt "had556cbcgf661g42cfga5aagc545aed1554c"
msgid "What I am matters not. You seek retribution - I want to help."
msgstr "내가 누구인지는 중요하지 않아. 넌 복수를 원하고 난 그걸 도울 용의가 있어. "

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = 91dae89a-99e4-4ecb-8b6d-43529a2fa79a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 6cdaa3ab-e6b3-2e7c-8244-bd4dd3dd4e83_MindHasBeenRead = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:91dae89a-99e4-4ecb-8b6d-43529a2fa79a
msgctxt "ha9e3556cg2265g4eecg8e09ge0f288eddcd9"
msgid ""
"<i>Drugnin' True Souls. Can still smell Nere from behind that damned "
"wall.</i>"
msgstr "<i>망할 놈의 참된 영혼들. 아직도 망할 벽 뒤에서 니어의 냄새가 난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = 935878ab-65b9-583a-39b0-3d3ffc8689e3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - UND_DuergarCamp_Mutineers_HasMet(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:935878ab-65b9-583a-39b0-3d3ffc8689e3
msgctxt "h27bde66ag3b99g431bg9a43g8f85dbb929a5"
msgid ""
"Seen her run with a barrel under her arm. Just a small one, but enough to "
"blow the drow out."
msgstr "그녀가 통을 팔 아래에 끼고 뛰는 걸 봤어. 작은 통이었지만, 드로우를 밖으로 날려버리기엔 충분해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = 96b7cbb0-02bd-e1c5-3704-23b96b8f0734
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_Mutineers_Event_OfferedQuest = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:96b7cbb0-02bd-e1c5-3704-23b96b8f0734
msgctxt "h69e82383gc66dg4f8dg8c36gfb488d4f1165"
msgid "Whatever the spoils, we'll drop you a fat cut. You in?"
msgstr "전리품이 무엇이든, 한 뭉텅이는 남겨줄게. 함께하겠나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = 98f4c3d0-865b-b80f-0070-b42b16a2918a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:98f4c3d0-865b-b80f-0070-b42b16a2918a
msgctxt "h880fdb32g6570g41dcgb0ecg3ea6694813d8"
msgid ""
"A shitty joke, too - I ain't hearing no laughs. Now you want gold or not?"
msgstr "별 좆같은 농담이 다 있네. 웃음도 안 나와. 그래서 돈 좀 벌어볼 거야, 말 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = 9962a5fe-e5fd-c30e-725a-ac64b6b119ae
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_Mutineers_Event_PromisedHalf = True
#.     - UND_Mutineers_Quest_Accepted = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:9962a5fe-e5fd-c30e-725a-ac64b6b119ae
msgctxt "h3378b2ceg0ba0g4c5dga532g321f96ebb498"
msgid "Half? You <i>drugnin'...</i>"
msgstr "절반? 이 <i>새끼가...</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Player
#. NodeID = 9e134443-f3f3-3e4d-0a9f-8b186474d298
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_DuergarSergeant_State_PermaDefeated = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:9e134443-f3f3-3e4d-0a9f-8b186474d298
msgctxt "h2f554c54gd6aag4c9ag84d2g15bf7ca9b9a8"
msgid "Good plan. I think Sergeant Thrinn should know about it."
msgstr "좋은 계획이야. 하사관 쓰린도 이 계획에 대해 알아야 할 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = 9ea5e69d-c553-d4b2-36e3-263b0b42ca88
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:9ea5e69d-c553-d4b2-36e3-263b0b42ca88
msgctxt "h6f5d4515gb4f8g4286ga910g78056717808c"
msgid "I ain't parleying with more Twat-Souls. And you got the stench."
msgstr "참된 씹것들과 협상은 더 안 할 거야. 너에게는 그 악취가 나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Player
#. NodeID = 9fe76c4a-7451-c5a4-4754-2a3856e8668a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4103e544-e1db-525f-81ec-b5dfa71907d7_WantNereOut = False
#. SetFlags:
#.   Local:
#.     - 4103e544-e1db-525f-81ec-b5dfa71907d7_WantNereOut = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:9fe76c4a-7451-c5a4-4754-2a3856e8668a
msgctxt "h91d4ecf6g88b0g4bb1gb51bg5775545af3af"
msgid "I want Nere out - and it sounds like you have a lead."
msgstr "나는 니어를 밖으로 꺼내길 원한다. 게다가 너는 단서를 갖고 있는 것처럼 들리는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = a0e43182-e82c-8f24-bf78-2194af150742
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:a0e43182-e82c-8f24-bf78-2194af150742
msgctxt "h5c863902g9425g4c1agb130g3c9ba34c9a2f"
msgid "You seen that weird orb-eye floatin' about?"
msgstr "저기 떠다니는 이상한 눈알 보주를 본 적 있나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = a4753537-7518-e20a-6fed-9977d4f2b73b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:a4753537-7518-e20a-6fed-9977d4f2b73b
msgctxt "h1dd5afeag8c89g4165ga24egb8c480733f45"
msgid ""
"Good. Drop it near the rubble when it's time. Flaming arrow or some such'll "
"set it off."
msgstr "좋아. 준비되면 잔해 근처에 그걸 놓도록 해. 불화살이나 뭐 그런 걸 쏘면 점화할 수 있을 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Narrator
#. NodeID = a558e8a8-3537-100c-9f50-c23cbfc10a24
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:a558e8a8-3537-100c-9f50-c23cbfc10a24
msgctxt "h7c78aaa7gf5ccg477dg9b88ge89e22c58038"
msgid "*A shiver runs through you. Your mind is awash in ancient resentments.*"
msgstr "*온몸에 전율이 흐릅니다. 당신의 마음은 오랜 원한으로 가득 차 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Player
#. NodeID = a5fe0b39-fca7-e2ff-05b6-c355414575df
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4103e544-e1db-525f-81ec-b5dfa71907d7_KurCalmedBrithvar = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:a5fe0b39-fca7-e2ff-05b6-c355414575df
msgctxt "hbd079c84g9be2g4552g951ag1f1a08d118a5"
msgid "Go on, try it. I've been itching for a fight."
msgstr "어디 덤벼봐. 싸우고 싶어서 좀이 쑤시던 참이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Player
#. NodeID = ab09ff83-16db-8ef9-0f58-c439be34469c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:ab09ff83-16db-8ef9-0f58-c439be34469c
msgctxt "h8db4c3b6g9472g477eg99bcg9dd5ce763842"
msgid "Depends. What do you need done?"
msgstr "상황에 따라 다르지. 무엇을 해야 하나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = ac219377-29ab-afdd-5074-61738158de5f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - UND_CaveIn_SUB_Smokepowder.HeardAboutHiddenGnome_CrewDead(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:ac219377-29ab-afdd-5074-61738158de5f
msgctxt "h20d0605fg7a17g4437gafc1g3c54d5307d4b"
msgid "No clue where the stump's hiding. But she's got what you need."
msgstr "그 노움이 어디 숨어 있는지는 몰라. 하지만 필요한 걸 갖고 있을 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = ae35ffa7-235b-a563-a5ee-cfc5bcb0e0a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:ae35ffa7-235b-a563-a5ee-cfc5bcb0e0a4
msgctxt "hd84ce80ag3e18g47dcgacf6gc5825055dd98"
msgid "Shut your trap, Kur. The <i>rakkah</i>'s got gold for grabbing."
msgstr "아가리 다물어, 쿠르. 이 <i>라카</i>가 한몫 잡겠다잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = b09ab50a-13f2-433d-1f44-fb45341e5433
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:b09ab50a-13f2-433d-1f44-fb45341e5433
msgctxt "h0af33606g05cfg43b9g922cg4d618677a9bd"
msgid ""
"If I didn't know better, I'd say a mind flayer shat a worm in your brain."
msgstr "멋모르고 봤으면 마인드 플레이어가 네 대가리에 애벌레를 싸지른 줄 알았을 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Player
#. NodeID = b0ef8838-7f0f-43dc-8016-4b153d8c22de
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 0
#. CheckFlags:
#.   Local:
#.      - 6cdaa3ab-e6b3-2e7c-8244-bd4dd3dd4e83_MindHasBeenRead = False
#.   Script:
#.      - GEN_CanDetectThoughts_3 = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:b0ef8838-7f0f-43dc-8016-4b153d8c22de
msgctxt "hc9cf3feegec3eg4edegb0bcgc5277d0e2b38"
msgid "<i>Cast Detect Thoughts.</i>"
msgstr "<i>생각 탐지를 시전한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = b2178af9-dad7-f2a9-6dc8-61080b0c0fa7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:b2178af9-dad7-f2a9-6dc8-61080b0c0fa7
msgctxt "h8b43fb67g9088g451eg8d4eg3dc54ed1bfdb"
msgid "Someone should grab it. Slaves are never gonna manage with pickaxes."
msgstr "누군가가 그걸 가져와야 해. 노예들의 곡괭이로는 절대 못해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Player
#. NodeID = b2a3d073-fc91-88df-475c-af70b76c0a01
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4103e544-e1db-525f-81ec-b5dfa71907d7_KurCalmedBrithvar = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:b2a3d073-fc91-88df-475c-af70b76c0a01
msgctxt "hfe125271gee0bg44c4g86b4g8dc9dccd1d62"
msgid "Don't be absurd. I hate these True Soul cultists."
msgstr "허튼 소리 마. 나는 그 참된 영혼 광신도들을 증오해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = b4992016-1d1e-d5bb-8d56-b72596864b18
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4103e544-e1db-525f-81ec-b5dfa71907d7_KurCalmedBrithvar = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:b4992016-1d1e-d5bb-8d56-b72596864b18
msgctxt "h1956728fga5d2g45f5gb483gc4405fe0ee00"
msgid ""
"I ain't parleying with more Twat-Souls - just want my coin. Your blade "
"ready, Kur?"
msgstr "참된 씹것들과 협상은 더 안 할 거야. 그냥 돈이나 내놓으라고. 칼 꺼낼 준비 됐나, 쿠르?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Stone Guard Kur
#. NodeID = b6e8fc7a-d9aa-63ca-e368-9baf309d915a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 4103e544-e1db-525f-81ec-b5dfa71907d7_KurCalmedBrithvar = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:b6e8fc7a-d9aa-63ca-e368-9baf309d915a
msgctxt "h868cd4e8g8d8ag45e2gbfbfgf932209fec73"
msgid ""
"Drop it, Brithvar. You chop this one, and Nere won't pay a damned copper."
msgstr "진정 좀 하시죠, 브리스바. 이 자를 조지면 망할 니어 놈이 동전 한 푼도 안 줄 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = bcb2e34f-df9b-ecf5-4766-6c0b98243577
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:bcb2e34f-df9b-ecf5-4766-6c0b98243577
msgctxt "h45c6351eg108ag41d4g8df0g2a7b1a3209c8"
msgid ""
"Should split your head open and poke around in there if you lot don't pay up."
msgstr "너희가 빚을 갚지 않는다면, 너의 머리를 갈라서 이리저리 찔러봐야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = be842990-2096-c852-8e0f-c7794c540db3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:be842990-2096-c852-8e0f-c7794c540db3
msgctxt "hf28303aeg355eg4291ga50fgf637b593726e"
msgid "You still standing about? Get on it!"
msgstr "아직도 가만히 서 있나? 시작해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = ca829b68-b44b-ae27-e7b5-4ec07417087b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_DuergarCamp_Event_MutineersSkirmish = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:ca829b68-b44b-ae27-e7b5-4ec07417087b
msgctxt "hbaf399c0gb800g428cg82eag8569b93fef04"
msgid "<i>Done and done.</i>"
msgstr "<i>거래 완료다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Player
#. NodeID = ca8c9f1c-0432-760e-7e2b-d147a013ba54
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:ca8c9f1c-0432-760e-7e2b-d147a013ba54
msgctxt "h8300fc23g48deg41d8gb16dg376186f48a1f"
msgid "You want my coin? Just try and take it."
msgstr "내 돈을 원해? 한번 뺏어 보시지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Stone Guard Kur
#. NodeID = cbdb7bec-22a9-d89b-b3d2-88e9ff67819d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:cbdb7bec-22a9-d89b-b3d2-88e9ff67819d
msgctxt "hbb302579g3fd2g4760g99ddg340859cda896"
msgid "<i>Brithvar. </i>Unwad your britches."
msgstr "<i>브리스바. </i>너무 흥분하지 마십시오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = cd6345bc-5c5d-970f-5187-7663e34cd09a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:cd6345bc-5c5d-970f-5187-7663e34cd09a
msgctxt "h3f1ce514g82b4g4b8ag870bg384935d5e3a9"
msgid "Ain't fooling me. Only you Absolute-lickers get my mind wobbling."
msgstr "날 속일 생각 마. 너처럼 절대자 빨아재끼는 것들만 내 정신을 뒤흔들어댄다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = d59f89a2-c57d-6689-82ca-e0d4ccdcc00b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_ScryingEye_State_PermaDefeated = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:d59f89a2-c57d-6689-82ca-e0d4ccdcc00b
msgctxt "h6d435147g9480g44e3gba84g120d6e00924d"
msgid "Good. But first we need to take care of something."
msgstr "잘됐군. 하지만 그 전에 먼저 처리해야 할 게 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Player
#. NodeID = d7304a69-7076-3c27-e78e-1d859c866ebf
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_Mutineers_Quest_Refused = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:d7304a69-7076-3c27-e78e-1d859c866ebf
msgctxt "hab7a1a64gce2cg40f8g8465gffb0fcad77ba"
msgid "Count me out."
msgstr "나는 빼줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Stone Guard Kur
#. NodeID = debaf9cb-0b97-6de9-5840-cd0ec2c9040e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:debaf9cb-0b97-6de9-5840-cd0ec2c9040e
msgctxt "haca76367g6a61g4b81g8893g8dce0be7e773"
msgid "<i>Brithvar.</i>"
msgstr "<i>브리스바.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = e0e399e5-e55e-cdca-8d7e-5208b9c80503
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:e0e399e5-e55e-cdca-8d7e-5208b9c80503
msgctxt "hf0b3183dg3f25g45dcgb71ag7a2745aade9c"
msgid "<i>Gh'rack. </i>Get you gone, before I <i>get </i>you gone."
msgstr "<i>Gh'rack. </i>사라져라, 내가 너를 <i>사라지게</i> 만들기 전에."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = e1679ee2-da40-a6b2-6ae3-d2fa424462ef
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_DuergarMutineers_Event_PlayerNotTrueSouls = True
#.   Local:
#.     - 4103e544-e1db-525f-81ec-b5dfa71907d7_NotTrueSoul = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:e1679ee2-da40-a6b2-6ae3-d2fa424462ef
msgctxt "hcea95f73gf3a6g46d8ga933g2e3b7cd44b76"
msgid ""
"Fair point. Pipsqueak like you is hardly gonna inspire fear and awe, are you?"
msgstr "맞는 말이네. 너 같은 찌질이를 보고 누가 공포나 경외심 따위를 품겠어, 안 그래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = e5c4129f-ee44-49ab-9370-11874fc8466a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_DuergarCamp_Event_MutineersSkirmish = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:e5c4129f-ee44-49ab-9370-11874fc8466a
msgctxt "hd3e5a8f6g1535g447fg9b95g3a0094c85ec4"
msgid "I feel you poking around. And I'll have your head for it!"
msgstr "내 머리를 뒤져 보려 하다니. 네 머리를 가져가 주마!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = eb8dfdec-f9ef-0513-bac6-f41286bfbcc7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_DuergarCamp_Event_MutineersSkirmish = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:eb8dfdec-f9ef-0513-bac6-f41286bfbcc7
msgctxt "ha3aaf7b6g7a10g4d96ga7fbg7e3288f6a463"
msgid "<i>Drugnin' </i>shithead - like hell she should!"
msgstr "<i>드루그닌</i> 멍청아, 퍽이나 알아야겠다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = ec7fb257-cb89-31b5-d7bc-80825a7e8964
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:ec7fb257-cb89-31b5-d7bc-80825a7e8964
msgctxt "h77e98564gc3b1g4a50g8381g739710d5e423"
msgid "In that case, I got a proposal. Want to earn some gold?"
msgstr "그렇다면, 나에게 제안이 있지. 금을 벌고 싶나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Player
#. NodeID = ee120cd5-9dd5-0edd-69c6-9ab490b13798
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - ROGUE(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:ee120cd5-9dd5-0edd-69c6-9ab490b13798
msgctxt "hab93aaecg4899g431bg8759gd3445423eeeb"
msgid "I'm worth more than a 'cut'. I want half."
msgstr "내 몸값은 '뭉텅이' 가지곤 어림도 없어. 절반 쳐줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Player
#. NodeID = f28f4cd6-8659-9814-d82a-a4ab38172011
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_Mutineers_Quest_Accepted = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:f28f4cd6-8659-9814-d82a-a4ab38172011
msgctxt "hbafd16ebg2252g4492g802bg0be349871a05"
msgid "I'm in."
msgstr "좋아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Player
#. NodeID = f4999265-edeb-26da-7dbf-e7a0ed041d82
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4103e544-e1db-525f-81ec-b5dfa71907d7_WantNereOut = True
#. SetFlags:
#.   Dialog:
#.     - UND_Mutineers_AskedAboutLead(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:f4999265-edeb-26da-7dbf-e7a0ed041d82
msgctxt "hac196e7eg7802g4524ga25ag930b3a0fb7f9"
msgid "I asked about a lead. And you still haven't answered."
msgstr "아직 단서에 대한 대답을 못 들었는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Player
#. NodeID = f8196a32-fbef-a924-0f39-b62432519700
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - ROGUE(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:f8196a32-fbef-a924-0f39-b62432519700
msgctxt "h74fe338ag4042g4beag9669gab2e52dc33f2"
msgid "Sounds good. I expect half the spoils."
msgstr "좋아. 나는 전리품의 절반을 원해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = f9a2bfec-5a2a-8d9e-e11c-68731b3d1857
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:f9a2bfec-5a2a-8d9e-e11c-68731b3d1857
msgctxt "h1d2ac6c9g1af8g4839ga7a3g2acfe20914bc"
msgid ""
"True Soul, no less. What do you think, Kur - should we take Nere's debt off "
"him?"
msgstr "역시 참된 영혼이군. 어떻게 생각하나, 쿠르? 니어의 빚을 대신 갚게 할까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = f9a2bfec-5a2a-8d9e-e11c-68731b3d1857
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:f9a2bfec-5a2a-8d9e-e11c-68731b3d1857
msgctxt "h5c468a52gfde9g4282gbcf5g6127ce858ea5"
msgid ""
"True Soul, no less. What do you think, Kur - should we take Nere's debt off "
"her?"
msgstr "역시 참된 영혼이군. 어떻게 생각하나, 쿠르? 니어의 빚을 대신 갚게 할까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = f9a2bfec-5a2a-8d9e-e11c-68731b3d1857
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:f9a2bfec-5a2a-8d9e-e11c-68731b3d1857
msgctxt "hd5b3c3f2gf9dag411dg888cg3fa6b3c8a345"
msgid ""
"True Soul, no less. What do you think, Kur - should we take Nere's debt off "
"them?"
msgstr "역시 참된 영혼이군. 어떻게 생각하나, 쿠르? 니어의 빚을 대신 갚게 할까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Stone Guard Kur
#. NodeID = fab9c1b7-0088-5519-d001-c9252ba13dfb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:fab9c1b7-0088-5519-d001-c9252ba13dfb
msgctxt "h3ce3905dg833cg495aga6cag95c81267dba4"
msgid "Can't go chasing 'maybes' - the sergeant's our ticket in."
msgstr "'만약'을 쫓을 순 없습니다. 하사관의 지시가 있어야 해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Player
#. NodeID = fcdab621-52b8-6257-5aa7-8d91fb9eb00e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4103e544-e1db-525f-81ec-b5dfa71907d7_KurCalmedBrithvar = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:fcdab621-52b8-6257-5aa7-8d91fb9eb00e
msgctxt "he40602f0g2d86g4f68gbeabg0e915ce9c688"
msgid "All I'm going to spill are your guts."
msgstr "내가 줄 건 네 창자 뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers
#. Speaker = Elder Brithvar
#. NodeID = fdda9049-229e-55e3-165e-1a9201310d53
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4103e544-e1db-525f-81ec-b5dfa71907d7_KurCalmedBrithvar = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers:fdda9049-229e-55e3-165e-1a9201310d53
msgctxt "h75f2a2d6g5ebag4c1fgb57cgc11ff6275ab4"
msgid "Collect my due pay for starters. Blade ready, Kur?"
msgstr "우선은 내 밀린 수당을 챙겨야지. 칼 준비됐나, 쿠르?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_FollowUp
#. Speaker = Elder Brithvar
#. NodeID = 088fb0ea-7b1f-c5ac-7424-d58952930f26
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_State_LeaderFreedGnomes = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_FollowUp:088fb0ea-7b1f-c5ac-7424-d58952930f26
msgctxt "hd2f249cbgf134g40fbga985g7db53b4c74b5"
msgid "Gnome-pricks: you're off the hook. Scram, before I get my senses."
msgstr "노움 새끼들아, 너희를 풀어주마. 썩 꺼져. 내 생각이 바뀌기 전에."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_FollowUp
#. Speaker = Player
#. NodeID = 0c615d82-5a25-16f9-ac4f-8a36ef78a505
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_FollowUp:0c615d82-5a25-16f9-ac4f-8a36ef78a505
msgctxt "h684dab5fg3ff1g4894g96a1ga9e88460343c"
msgid "Understood. I won't interfere."
msgstr "알았어. 간섭하지 않을게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_FollowUp
#. Speaker = Gale
#. NodeID = 100da4a1-ec65-4eb0-b55d-3d8ed98c344a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_FollowUp:100da4a1-ec65-4eb0-b55d-3d8ed98c344a
msgctxt "h8459b6acgc731g493fgbb41g275757271d59"
msgid ""
"The gnomes should be able to go where they please. They are not the "
"duergar's to keep."
msgstr "노움들은 가고 싶은 곳으로 갈 자유가 있어. 듀에르가가 붙잡아놓을 수는 없지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_FollowUp
#. Speaker = Player
#. NodeID = 131eaa3b-d3b8-52ec-afe0-80fc9c2b29cb
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#. TagRule: BERSERKER
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_FollowUp:131eaa3b-d3b8-52ec-afe0-80fc9c2b29cb
msgctxt "he03d83edg8a80g4356g96ebg62d63a1cd54a"
msgid "RELEASE. THE. GNOMES. <b>IMMEDIATELY</b>."
msgstr "<b>노움을</b>. <b>풀어줘라</b>. <b><i>당장</i><b>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_FollowUp
#. Speaker = Player
#. NodeID = 131eaa3b-d3b8-52ec-afe0-80fc9c2b29cb
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_FollowUp:131eaa3b-d3b8-52ec-afe0-80fc9c2b29cb
msgctxt "h20deb35eg616ag4a15gbb11g6304a0619c7a"
msgid "The gnomes go free. You get to live. Everybody wins."
msgstr "노움들을 풀어줘. 그럼 너도 살려줄게. 모두에게 이득이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_FollowUp
#. Speaker = Player
#. NodeID = 1f4f8c68-3654-ab8a-c91e-3aca421ea91f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_DuergarMutineers_Event_Leave = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_FollowUp:1f4f8c68-3654-ab8a-c91e-3aca421ea91f
msgctxt "h85d4964ag2f17g4030ga1a3ga0403cb2a84e"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_FollowUp
#. Speaker = Elder Brithvar
#. NodeID = 27256c87-6551-5916-7118-ba34c6d21d76
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_FollowUp:27256c87-6551-5916-7118-ba34c6d21d76
msgctxt "h84e9e59ag30f3g4e5cga3d7gd1a00bfde6e5"
msgid ""
"Mm - you got a point. Likely to be all hobbled up, what with the lashings."
msgstr "으음. 맞는 말이야. 채찍질당한 것 때문에 넋이 다들 나가 있겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_FollowUp
#. Speaker = Elder Brithvar
#. NodeID = 2f3d0432-54fb-e463-b61d-8c891ee43cc7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_FollowUp:2f3d0432-54fb-e463-b61d-8c891ee43cc7
msgctxt "hfcad7a07g30bcg4192g94a8gdf946495c51e"
msgid "You do that."
msgstr "그래라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_FollowUp
#. Speaker = Elder Brithvar
#. NodeID = 36c10b88-d2b7-0bf5-3663-d4266f59d7cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_FollowUp:36c10b88-d2b7-0bf5-3663-d4266f59d7cb
msgctxt "hcb91fdbdgc069g4144g98e9gc83af35c8a53"
msgid "And there ain't no way I'm sticking around long enough to meet him."
msgstr "그리고 내가 그 새끼를 만나도록 여기 오래 머물러 있을 이유도 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_FollowUp
#. Speaker = Player
#. NodeID = 45f16692-0443-a92a-f7b7-72f6dc2ecb00
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Moonrise_Knows_AbsoluteAtGrymforge = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_FollowUp:45f16692-0443-a92a-f7b7-72f6dc2ecb00
msgctxt "he68edadbgca8bg4f17g8197g784c7bc3dd21"
msgid "What makes Moonrise Towers such a threat?"
msgstr "문라이즈 타워가 그토록 큰 위협인 이유가 뭐야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_FollowUp
#. Speaker = Karlach
#. NodeID = 46dce499-7d02-0d37-f3cd-c99696d2d687
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_FollowUp:46dce499-7d02-0d37-f3cd-c99696d2d687
msgctxt "h3f984183g3f36g4e83gad73g9856af99ab45"
msgid "You can't be serious. What the fuck is wrong with you?"
msgstr "진짜 말도 안 되는 소리하네. 넌 씨발 대체 왜 그래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_FollowUp
#. Speaker = Elder Brithvar
#. NodeID = 477a2d4e-cb0f-72c5-c4a1-b0b556aba91c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_FollowUp:477a2d4e-cb0f-72c5-c4a1-b0b556aba91c
msgctxt "hc4d23e92g731eg4da5g9304gb27baae0550f"
msgid "Clan property. They come with us."
msgstr "일족의 소유물이야. 우리가 데려간다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_FollowUp
#. Speaker = Player
#. NodeID = 4ff19e01-6c71-6c06-15f1-48954ac9d220
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_GnomeWorkers_State_PermaDefeated = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_FollowUp:4ff19e01-6c71-6c06-15f1-48954ac9d220
msgctxt "h64e8ed8cg1e58g40eegbd4bg025d8e5ce54d"
msgid "And the slaves? What about them?"
msgstr "노예들은 어쩌고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_FollowUp
#. Speaker = Elder Brithvar
#. NodeID = 5384bf63-09c2-2d8a-b525-6a8ea27ce718
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_FollowUp:5384bf63-09c2-2d8a-b525-6a8ea27ce718
msgctxt "h297b7966g7fc6g4814g9bf8g75ab77135ad2"
msgid "Time I scrammed before more pricks from Moonrise Towers move in."
msgstr "문라이즈에서 등신들이 더 쳐들어오기 전에 튀도록 하겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_FollowUp
#. Speaker = Elder Brithvar
#. NodeID = 5ead20cc-b946-ea76-5913-47791b8e9260
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_CheckPocketGold = True
#. SetFlags:
#.   Global:
#.     - UND_Mutineers_State_PaidPlayerReward = True
#.   Object:
#.     - GEN_TransferNPCPayment(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_FollowUp:5ead20cc-b946-ea76-5913-47791b8e9260
msgctxt "h6372a742g2c1dg4a7fgb074gc3ae15dd6ed4"
msgid ""
"Here's your cut. I always keep my word. ([6057ad05-9492-4630-9f0a-"
"be548b134c54])"
msgstr "여기 너의 몫이다. 나는 언제나 약속을 지키지. ([6057ad05-9492-4630-9f0a-be548b134c54])"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_FollowUp
#. Speaker = Elder Brithvar
#. NodeID = 5fc98f02-5ba3-fbfb-8195-3a73469122ef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_FollowUp:5fc98f02-5ba3-fbfb-8195-3a73469122ef
msgctxt "h31e1b9f3gb579g4047g83d5g8beaf1052d4a"
msgid ""
"Please. We catch your scent, and you'll get sliced 'fore you can bat your "
"left eye."
msgstr "좀. 우리가 네 녀석 냄새를 맡거든, 눈치채기도 전에 네 목이 따일 거라니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_FollowUp
#. Speaker = Elder Brithvar
#. NodeID = 6bd3d55b-2e31-288c-5407-5807562977b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_FollowUp:6bd3d55b-2e31-288c-5407-5807562977b4
msgctxt "h639525a0ga94bg41fcg9c2dg432086465645"
msgid "Mm. For a <i>jargh</i>, you got smarts."
msgstr "으음. <i>자그</i>치고는 똘똘하구만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_FollowUp
#. Speaker = Elder Brithvar
#. NodeID = 703a820d-2b35-12fe-c109-55a70203d56f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_FollowUp:703a820d-2b35-12fe-c109-55a70203d56f
msgctxt "h714c0dc8g6976g434ega452g1a62998aff40"
msgid "Won't hear me argue. Your mouth's got the might to back it."
msgstr "그럼 더 이상 따지지 않겠어. 네 말엔 그걸 뒷받침할 만한 힘이 있군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
