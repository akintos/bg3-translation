msgctxt "h9a71adf6g26c3g45c2g98c9g9aef51ac4eb8"
msgid "... toll collector... Marten..."
msgstr "... 통행료 징수인... 마르텐..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_TollCollector001_Dead
#. Speaker = Player
