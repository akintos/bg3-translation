msgctxt "hf7467c4bg2cbbg4f09g841bg777d96cf76b0"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02
#. Speaker = Zarys
#. NodeID = 0542f735-7cc8-ac0b-657a-e45bf539b546
