msgctxt "hbdfd0565g29adg4a2egbe92g20dabdc0566e"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_003_PostEA
#. Speaker = Cyrel
#. NodeID = dd6f6ac8-d490-47ea-86c6-f4b7002f1e74
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
