msgctxt "hb3b3db20g6715g402dg8cb0ga8adb25a02c6"
msgid "Wot are you still 'anging around for, devil-boy."
msgstr "뭐 때문에 아직도 어슬렁거리는 거야, 데빌 놈아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinWily
