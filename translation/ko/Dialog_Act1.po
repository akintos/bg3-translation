#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_Courier_State_DogPlayful = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:97d762da-bd30-f6bd-fc3f-86b0a32ecc0c
msgctxt "hc01c86ebg0d1cg4e8fgac00g15fcc48d5db7"
msgid "Of course he will. And then we'll return home."
msgstr "당연히 일어나지. 그러면 함께 집으로 돌아갈 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Player
#. NodeID = a084a47b-9660-c953-e99d-c6371c8588cc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_Courier_Knows_DogName = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:a084a47b-9660-c953-e99d-c6371c8588cc
msgctxt "h0927e8c4gd4e5g4cedg9979gae0bfa1fd28f"
msgid "You're Scratch, aren't you? Come here. It's all right."
msgstr "네 이름이 스크래치지, 안 그래? 이리와. 괜찮아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Narrator
#. NodeID = a57d0c39-0e99-4ca9-6cf7-c20109252641
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_Courier_State_DogCalm = True
#.      - FOR_Courier_State_DogPlayful = False
#.   Local:
#.      - 8e73965a-3b0f-d812-15f1-2e9d011144f0_AHSuccess = True
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:a57d0c39-0e99-4ca9-6cf7-c20109252641
msgctxt "hd8d1156bg4aebg47a5g8645gbb0afabb6083"
msgid "*The dog watches the corpse, a quiet whine escaping with every breath.*"
msgstr "*개는 숨을 내뱉을 때마다 조용히 우는 소리를 내며 시체를 지켜봅니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Player
#. NodeID = a5b5f6db-1321-0bb6-6493-2f3c7a33168a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 8e73965a-3b0f-d812-15f1-2e9d011144f0_AHSuccess = True
#. SetFlags:
#.   Global:
#.     - FOR_Courier_State_DogPlayful = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:a5b5f6db-1321-0bb6-6493-2f3c7a33168a
msgctxt "h893c8baaga410g4294g8bd3ge7f73c08acce"
msgid "<i>Shake your head - the man is gone.</i>"
msgstr "<i>고개를 가로젓는다. 남자는 죽었다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Scratch
#. NodeID = aa70c9f6-a758-4a71-6146-701f716512b8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:aa70c9f6-a758-4a71-6146-701f716512b8
msgctxt "ha5b775e2gafc2g40d7g8394g41ef32d8e9cc"
msgid "And their smell... it was strange. Rotten. <i>Evil</i>."
msgstr "그리고 그놈들의 냄새... 뭔가 이상했어. 부패하고. <i>사악한 향기</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Player
#. NodeID = abfd6250-2902-c6ab-257a-cac3fcbd4c75
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_Courier_Dog_Knows_FinishingMourning(1) = True
#.   Object:
#.      - FOR_Courier_Dog_Knows_InvitedToCamp(1) = False
#. SetFlags:
#.   Object:
#.     - FOR_Courier_Dog_Knows_InvitedToCamp(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:abfd6250-2902-c6ab-257a-cac3fcbd4c75
msgctxt "h2f0e5c2agdf4cg4fbdg92f2g575f05ac80c1"
msgid "If he doesn't wake up, follow my scent. I have a camp."
msgstr "그가 깨어나지 않으면, 내 냄새를 따라와. 내 야영지가 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Player
#. NodeID = b10382b0-3f89-678c-7a35-779bc46e36fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:b10382b0-3f89-678c-7a35-779bc46e36fc
msgctxt "hb351d841gd04ag424dg8132g75d09e04ed19"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Player
#. NodeID = b895307f-57dd-6f81-9e2c-bb26d58842b7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_Courier_Dog_Knows_FinishingMourning(1) = False
#. SetFlags:
#.   Dialog:
#.     - FOR_Courier_Dog_Knows_FinishingMourning(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:b895307f-57dd-6f81-9e2c-bb26d58842b7
msgctxt "h6621665ag71c7g40c5ga211g79c84c7b4180"
msgid "Come on, you can travel with me if you like."
msgstr "가자, 네가 괜찮으면 나랑 같이 여행해도 좋아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Player
#. NodeID = ba120469-db87-92c6-52c9-711b7c04c5cb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_Courier_Knows_DogName = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:ba120469-db87-92c6-52c9-711b7c04c5cb
msgctxt "h92e4f480gd817g4fbfg932dge6a6dd1fad21"
msgid "<i>Take a closer look at him.</i>"
msgstr "<i>그를 더 자세히 살펴본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Player
#. NodeID = bf61779f-774f-e6b9-1e46-a1fb71dc87e5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:bf61779f-774f-e6b9-1e46-a1fb71dc87e5
msgctxt "h69546f28gc0e6g4098g9870g86c7db547cb2"
msgid "Stop deluding yourself - you are guarding a corpse."
msgstr "스스로를 속이지 마. 넌 지금 시체를 지키고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Scratch
#. NodeID = c2f925de-e0ef-a787-2cc6-444afe5df226
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_Courier_Dog_HasMet(1) = False
#.   Tag:
#.      - PETPAL(1) = False
#. SetFlags:
#.   Dialog:
#.     - FOR_Courier_Dog_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:c2f925de-e0ef-a787-2cc6-444afe5df226
#, fuzzy
msgctxt "h7b0480c3g5741g4576gb8a4gbd7efd37295c"
msgid "*Arf! Arf! <i>Grrrrrarf!</i>*"
msgstr "*왈! 왈! <i>그르렁!</i>*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Scratch
#. NodeID = c6a9fe94-f672-f06b-9774-b629923a4517
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:c6a9fe94-f672-f06b-9774-b629923a4517
msgctxt "h00ab1f39g4916g4803ga73fg61e6a058489e"
msgid "If it comes to that... I may. Thank you."
msgstr "그렇게 된다면... 그렇게 할게. 고마워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Scratch
#. NodeID = c936a64e-95ed-2ed3-9958-55a4fc9921e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:c936a64e-95ed-2ed3-9958-55a4fc9921e2
msgctxt "h248afc6ag2247g4991g9359g310ee673835b"
msgid "He calls me Scratch. You can do the same."
msgstr "그는 날 스크래치라고 불러. 너도 그렇게 불러도 좋아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Player
#. NodeID = d3a737ba-643d-5cc0-9837-d58c2ab82190
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_Courier_Dog_Knows_FinishingMourning(1) = True
#.   Object:
#.      - FOR_Courier_Dog_Knows_InvitedToCamp(1) = False
#. SetFlags:
#.   Object:
#.     - FOR_Courier_Dog_Knows_InvitedToCamp(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:d3a737ba-643d-5cc0-9837-d58c2ab82190
msgctxt "ha3f89174gbfdcg40e8gac55gf172e8b28e73"
msgid "<i>Hold out your hand so he can follow your scent to camp.</i>"
msgstr "<i>개가 당신의 냄새를 쫒아 야영지로 따라올 수 있도록 손을 뻗어준다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Scratch
#. NodeID = d69eb441-359f-e549-eea9-7eb4ebaa8d5f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - FOR_Courier_Dog_Knows_InvitedToCamp(1) = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:d69eb441-359f-e549-eea9-7eb4ebaa8d5f
msgctxt "h5740eed4g4047g4a41ga797g2b6ddfe2746e"
msgid "Go on. If he doesn't wake... I'll find you."
msgstr "가. 그가 깨어나지 않으면... 널 찾아갈게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Narrator
#. NodeID = d6fae196-a730-c7d8-6a54-e0b072663fa5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 8e73965a-3b0f-d812-15f1-2e9d011144f0_AHSuccess = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:d6fae196-a730-c7d8-6a54-e0b072663fa5
#, fuzzy
msgctxt "h9d1f2951g1f8bg4eedga1b6g1e21032a12c7"
msgid "*The dog lowers his hackles, his head tilted inquisitively.*"
msgstr "*개가 고개를 숙이고 호기심에 가득 찬 표정을 짓습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Narrator
#. NodeID = da181859-57c1-d81c-574e-96a0d05a1bb4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 8e73965a-3b0f-d812-15f1-2e9d011144f0_AHSuccess = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:da181859-57c1-d81c-574e-96a0d05a1bb4
msgctxt "hced3a58eg4857g4956g8b3fgca93e7459363"
msgid ""
"*The dog sniffs your hand, his tail swung low in understanding. He knows how "
"to find you.*"
msgstr "*개가 당신의 손 냄새를 맡으며, 이해했다는 듯 꼬리를 흔듭니다. 당신을 찾아올 수 있을 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Player
#. NodeID = daa36c00-2e45-6bd1-9c18-cdaa2a43f106
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:daa36c00-2e45-6bd1-9c18-cdaa2a43f106
msgctxt "haeac55a5g6031g481cg9f89g66a23583f8de"
msgid "If I wanted to hurt either of you, I'd have done it already."
msgstr "내가 너희를 해치려고 했으면, 이미 그랬을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Player
#. NodeID = e2dd45dd-1b2c-b517-50eb-22ddf5062bed
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:e2dd45dd-1b2c-b517-50eb-22ddf5062bed
msgctxt "h8bd14f2age323g4953gaf1fg4e1d1f607cd9"
msgid "I understand your fear, but I promise I mean you no harm."
msgstr "너의 두려움은 이해하지만, 너를 해치지 않겠다고 약속할게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Scratch
#. NodeID = e6a7b91c-2424-0e23-4c15-367a8f2bc7a9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:e6a7b91c-2424-0e23-4c15-367a8f2bc7a9
msgctxt "h28ac6cdagdfb2g45aag9e7bg365fc92e60a6"
msgid "We were attacked. Cackling, furry things on two legs."
msgstr "습격당했어. 두 다리로 걸으며 낄낄거리는 털 달린 것들한테."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Player
#. NodeID = e7f55d4a-0ee6-f53f-ab54-4105a9dde2e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:e7f55d4a-0ee6-f53f-ab54-4105a9dde2e2
msgctxt "h865884e5gfc94g41cfgbce4geea129b81a50"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Scratch
#. NodeID = eb830180-9b8a-b083-9e02-f73d2a082e8a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:eb830180-9b8a-b083-9e02-f73d2a082e8a
msgctxt "h73aebfbdgc7e1g4234g8577g8950680476b0"
msgid "*Sniff.*"
msgstr "*킁.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Player
#. NodeID = edf0e4a7-9f4f-6225-1d69-6c4f45b01dbb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:edf0e4a7-9f4f-6225-1d69-6c4f45b01dbb
msgctxt "h7c6d0281gd395g4a6egbf82gc723813ed600"
msgid "<i>Prove the man is dead - shout at his corpse.</i>"
msgstr "<i>남자가 죽었다는 사실을 증명한다. 시체에게 고함친다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Player
#. NodeID = ee207b25-60f6-8a50-dbb3-7b824aaf3600
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - FOR_Courier_Knows_DogName = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:ee207b25-60f6-8a50-dbb3-7b824aaf3600
msgctxt "h2fe6fe61g7bb9g4830ga7cfgc59ac639f0ae"
msgid "<i>Peer at his collar.</i>"
msgstr "<i>녀석의 목줄을 유심히 관찰한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Player
#. NodeID = ef6ae581-ba3e-ac38-2c42-bceec36b62a9
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 10
#. CheckFlags:
#.   Dialog:
#.      - FOR_Courier_Dog_Event_Skillcheck_Fail(1) = False
#.      - FOR_CourierDog_State_AnimalHandlingFailed(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:ef6ae581-ba3e-ac38-2c42-bceec36b62a9
msgctxt "h00e58c03gea20g44c6g88b2g6b3dde9dd698"
msgid "<i>Kneel - you mean no harm.</i>"
msgstr "<i>해를 끼칠 의도가 없다는 뜻으로 무릎을 꿇는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Player
#. NodeID = efbd1908-275e-44b1-4688-4ab5dd2c56f6
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. TagRule: REALLY_HALFORC
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:efbd1908-275e-44b1-4688-4ab5dd2c56f6
msgctxt "h237597a3gbd22g4238ga218gf25928d0403c"
msgid "I could snap you in half, <i>if</i> I wanted to. I don't."
msgstr "만약 <i>내가 원한다면</i> 널 쪼개버릴 수도 있어. 하지만 안 그럴 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Player
#. NodeID = f06e4e58-842f-e734-0754-3552cb859c05
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:f06e4e58-842f-e734-0754-3552cb859c05
msgctxt "hd46a31e0gc9a6g4402g97abgd1166d818839"
msgid "Rest? He needs a grave."
msgstr "쉰다고? 그에겐 무덤이 필요해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Narrator
#. NodeID = f164c6ce-64c7-9819-7c56-18534a515f24
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:f164c6ce-64c7-9819-7c56-18534a515f24
msgctxt "h2b0fa501g8d98g46dagb832g4bbed0951866"
msgid "*With a deep, heartbroken whine, the dog bows his head.*"
msgstr "*깊고, 슬픔이 가득한 울음소리와 함께, 개가 고개를 숙입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Player
#. NodeID = f2b4c128-69a1-1cfe-c1d1-8eebc2305431
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:f2b4c128-69a1-1cfe-c1d1-8eebc2305431
msgctxt "h39c765e6g8e98g4fe2gad98g329cf9725d3a"
msgid "<i>Sidestep him to get to the corpse.</i>"
msgstr "<i>녀석을 피해 사체를 향해 움직인다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Player
#. NodeID = f6106178-9fb3-e5a8-e1e0-d00c7cbdd2d5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_Courier_Knows_DogName = False
#. SetFlags:
#.   Global:
#.     - FOR_Courier_Knows_DogName = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:f6106178-9fb3-e5a8-e1e0-d00c7cbdd2d5
msgctxt "h63ac169ag84d2g4994g8899gb1c7c35f66e3"
msgid "What's your name?"
msgstr "네 이름이 뭐니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Narrator
#. NodeID = f65a51de-7465-d643-1fe5-b75ba5b2c4b4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 8e73965a-3b0f-d812-15f1-2e9d011144f0_AHSuccess = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:f65a51de-7465-d643-1fe5-b75ba5b2c4b4
msgctxt "hd185ffb2geb55g4440gbe30gf6a94cc4d32d"
msgid "*The dog looks at his owner with sad eyes. He does not move.*"
msgstr "*개는 슬픈 눈으로 자신의 주인을 바라보며, 전혀 움직이지 않습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Player
#. NodeID = fae6e3cb-a88d-0ab1-4ea8-5fe2205de458
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - FOR_Courier_Knows_DogName = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:fae6e3cb-a88d-0ab1-4ea8-5fe2205de458
msgctxt "hb7035edfg0761g41d3ga80bg666e6802ba1d"
msgid "<i>Peer at his collar.</i>"
msgstr "<i>녀석의 목줄을 유심히 관찰한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_PAD_FindBook
#. Speaker = Player
#. NodeID = 2bb9b79a-0788-6e0b-1e4d-8bf8e28c10b2
#. HandlePath = TaggedText[0].TagText[0]
