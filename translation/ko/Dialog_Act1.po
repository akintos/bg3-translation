msgctxt "h542454b5gf045g4fa4ga46bga047ea9f9815"
msgid "Last Light... safe haven... in shadows..."
msgstr "최후의 빛... 그림자 속의... 안전한 피난처..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_HangedDrow_Dead
