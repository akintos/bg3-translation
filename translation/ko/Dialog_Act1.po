msgid "*Kssrrt!*"
msgstr "*크스르트!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Narrator
#. NodeID = 1e0e1fe2-2b33-43d6-4bfd-c6efbbf1a098
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:1e0e1fe2-2b33-43d6-4bfd-c6efbbf1a098
msgctxt "he13ebe59gd596g4856ga920gdee6d5f00997"
msgid "*You sense very little from the shifting trio.*"
msgstr "*당신은 꾀를 부리는 세 거미에게서 거의 아무것도 느끼지 못합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
