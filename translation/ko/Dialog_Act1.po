msgctxt "hde72a19bg6b80g43e7gb8a6g7f5ef6f15432"
msgid "*The spell's power wanes. You can ask no more questions.*"
msgstr "*주문의 힘이 약해집니다. 더 이상 질문을 할 수 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001_Dead
#. Speaker = Narrator
#. NodeID = d8e2e5bd-6d95-4e5e-915f-f123c43b1768
