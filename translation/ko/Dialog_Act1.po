msgctxt "h9cef8766g1922g4178gb383g23426fb14fa6"
msgid "Ain't been the same."
msgstr "예전 같지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DeadInTheWater_AD_DuergarsComplaining
