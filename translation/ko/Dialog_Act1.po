msgctxt "hc16b1383g35dcg4d96g98e2ga0793ccbcf8e"
msgid "Looks like all those moon plates can be turned."
msgstr "이 달 문양 석판들은 돌릴 수 있을 거 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/VBs/GOB_VoloBallad_VB_HeardSinging
