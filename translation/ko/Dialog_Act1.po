msgctxt "h45d1b0eeg6854g45b5g9c0ag960572aa5a25"
msgid "Push them back!"
msgstr "놈들을 밀어내!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_Apprentice
#. Speaker = Nettie
#. NodeID = 4b0e73a3-41dd-0f68-2fae-6eb251108753
