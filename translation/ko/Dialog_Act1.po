msgctxt "h69ccc458g69d0g4ee0g994fgec83756b3ef7"
msgid "That wall's dangerously weak."
msgstr "저 벽은 매우 약해 보여."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_PAD_LooseWall
#. Speaker = Player
#. NodeID = 8183aede-df52-75ac-98fc-47b17e6a2548
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_PAD_LooseWall:8183aede-df52-75ac-98fc-47b17e6a2548
msgctxt "h278f1146g8801g424agb99ag880946aa65d3"
msgid "Shabby workmanship. A strong push and this wall comes down."
msgstr "초라한 솜씨네. 세게 밀면 벽이 무너질 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_PAD_LooseWall
#. Speaker = Player
#. NodeID = 8183aede-df52-75ac-98fc-47b17e6a2548
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_PAD_LooseWall:8183aede-df52-75ac-98fc-47b17e6a2548
msgctxt "h80c43e00gf67ag48afg9214g848f19aec73e"
msgid "Wall's wrecked. A good punch would probably finish it."
msgstr "벽에 금이 갔어. 좋은 펀치 한 방이면 끝장 낼 수 있을 걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_PAD_LooseWall
#. Speaker = Player
#. NodeID = 8183aede-df52-75ac-98fc-47b17e6a2548
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_PAD_LooseWall:8183aede-df52-75ac-98fc-47b17e6a2548
msgctxt "h03b7396fgc9acg4bdeg9c27g0db84f95e1db"
msgid "That wall's falling apart. A good blow should send it toppling."
msgstr "저 벽은 주저앉기 직전이군. 제대로 한 방 날리면 무너져 내릴 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_PAD_LooseWall
#. Speaker = Player
#. NodeID = 8183aede-df52-75ac-98fc-47b17e6a2548
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_PAD_LooseWall:8183aede-df52-75ac-98fc-47b17e6a2548
msgctxt "h5bd38bb6g194bg4ff0g8794gd1556d9311f9"
msgid "Loose brickwork. Best not lean against it."
msgstr "벽돌이 느슨하네. 기대지 않는 게 좋겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_PAD_LooseWall
#. Speaker = Player
#. NodeID = 8183aede-df52-75ac-98fc-47b17e6a2548
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_PAD_LooseWall:8183aede-df52-75ac-98fc-47b17e6a2548
msgctxt "h83b66faegc193g4945g8b42g81fa3e53f047"
msgid "Something's off about that wall. Go on, give it a smack."
msgstr "저 벽 뭔가 좀 허전한데. 어서, 한 방 먹이자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_PAD_LooseWall
#. Speaker = Player
#. NodeID = 8183aede-df52-75ac-98fc-47b17e6a2548
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_PAD_LooseWall:8183aede-df52-75ac-98fc-47b17e6a2548
msgctxt "h8534df44gb723g4282gbbe2gab6f3db0f392"
msgid "That wall's barely holding together."
msgstr "벽이 금방이라도 무너질 거 같아."

