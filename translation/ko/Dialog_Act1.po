msgctxt "h9dda1407gaaa0g49fbgb3e2g1f1dd9e38770"
msgid "Who were you in life?"
msgstr "넌 누구였지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Spike_Dead
#. Speaker = Player
#. NodeID = b230d919-d42d-44d0-38c0-1f7d4693b9f2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
