#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:58114e71-ec22-035a-0c80-2572ad8bf586
msgctxt "hd8ba43fdg75eag4271ga5d0g9d33a1dd339c"
msgid "Gah. Whatever. I was gettin' thirsty anyway."
msgstr "젠장. 뭐가 됐든 상관없어. 그나저나 목이 마르던 참이었거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Narrator
#. NodeID = 5c270265-0064-aefd-585b-8c68a7fc71f6
