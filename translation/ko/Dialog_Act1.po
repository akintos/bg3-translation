msgid "The ravings of a lunatic. Pure nonsense."
msgstr "미치광이의 작품이군. 완전 헛소리야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_FurnaceSearch_PAD_MadRecords
#. Speaker = Player
#. NodeID = 0da9ecb2-23d9-9c87-ea55-573f2365c8f3
