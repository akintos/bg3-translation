msgctxt "hcd843f3cg64cbg4788ga335ge95d4026da34"
msgid "I ain't worth yer attention."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinLush
#. Speaker = Tracker Azak
#. NodeID = aefc5b9c-e8fe-ee34-6a4f-514b4d1f0cdf
