msgctxt "h3b3290b6gb863g40adgb309g670b4ec52981"
msgid "*The mirror glints in the light.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_005_Dead
#. Speaker = Narrator
#. NodeID = 18c05cae-f9b6-e749-b619-e44d1f7f16ef
#. HandlePath = TaggedText[0].TagText[0]
