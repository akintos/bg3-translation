msgid "Hold out your hand. Let me show you something."
msgstr "손을 내밀어봐요. 당신에게 보여줄 게 있어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Player
#. NodeID = 72c81d1e-c2c2-8286-fba7-d2bd8398a7b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:72c81d1e-c2c2-8286-fba7-d2bd8398a7b3
#, fuzzy
msgctxt "hb7c09008g06a0g4c0bga55cg34f543e234e0"
msgid "Yes. Surface dwellers tell all sorts of lies about us."
msgstr "그래. 지상인들은 우리에 대한 온갖 거짓말을 지어내곤 하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 737987a7-831f-18d0-90f2-dd710beceb74
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001:737987a7-831f-18d0-90f2-dd710beceb74
msgctxt "h31162c3dg50e0g471ag8631g2efd21184aae"
msgid "You haven't seen anything yet, lady!"
msgstr "이 정도는 아무것도 아니에요, 숙녀분!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_Pickpocket_001
#. Speaker = Mattis
#. NodeID = 737987a7-831f-18d0-90f2-dd710beceb74
#. HandlePath = TaggedText[1].TagText[0]
