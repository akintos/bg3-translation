msgctxt "h87ada8b6ged9cg4b79gad90g04af846a601e"
msgid "No. I'm taking it to camp. Zevlor will know what to do with it."
msgstr "아니. 저건 야영지로 끌고 갈 거야. 제블로어라면 어째야 할지 알겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene
#. Speaker = Nymessa
#. NodeID = 9b1c8b0c-8930-fcd3-4f96-aa7e1daedb02
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene:9b1c8b0c-8930-fcd3-4f96-aa7e1daedb02
msgctxt "hbc900fcdg769fg454bg993fgf10d4a293ffd"
msgid "<i>Converse </i>with it? I barely know what <i>it</i> is!"
msgstr "<i>얘기</i>를 나눠? 난 <i>저게</i> 뭔 종자인지조차 모른다고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene
#. Speaker = Damays
#. NodeID = 9bbb01d7-d23f-bf04-d0ea-d149a6d9be9b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
