msgctxt "h640cefb1gb64eg41b6gabe8g8e2a7d92de3e"
msgid "Me the beast? Now that's fucking rich."
msgstr "나보고 야수라고? 거 참 존나게 재밌네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_003_PostEA
#. Speaker = Player
