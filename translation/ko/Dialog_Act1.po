#.      - PLA_ZhentShipment_State_ReadyToLeaveCave = True
#.      - PLA_ZhentShipment_Agent_001_State_Dead = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_002:a6b47bcf-79e0-5785-4e97-1fd36dd776d5
msgctxt "had7c29dfg8edbg45ccg9a29gc35248d4e6a9"
msgid ""
"That bloody chest can rot for all I care. I'm not cut out for this kind of "
"work."
msgstr "저 빌어먹을 상자는 상관하고 싶지 않아요. 전 이런 일에는 적합하지 않은 것 같군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_002
