#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:792dd885-8f23-7e88-fac4-d49938e5d5a6
msgctxt "h0e7df122g2009g4c13gab31ge02e0f95000e"
msgid "Come on. A child can hit harder than that."
msgstr "뭐야. 어린애도 그것보단 더 세게 때리겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Abdirak
#. NodeID = 7bc72b84-8efb-c6d8-7fc0-6dc7211a78c5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_PainPriest_Event_BadReaction = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:7bc72b84-8efb-c6d8-7fc0-6dc7211a78c5
msgctxt "hd302d6f3gda8fg4c57ga306g4bd46190d775"
msgid "So stoic, dear one. A pity."
msgstr "참으로 고집스럽구나, 아이야. 안타깝군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Shadowheart
#. NodeID = 7d9300ac-b833-be21-c8b3-60a2e69160b7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Astarion_Knows_Vampireness = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:7d9300ac-b833-be21-c8b3-60a2e69160b7
msgctxt "hffa98b7dg9561g4b61g833cg9605f381896f"
msgid "Try not to lick your lips as you say that."
msgstr "그렇게 말하면서 입술 핥지 말아 줄래."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Shadowheart
#. NodeID = 7dd153ba-5dde-62a1-f1c7-0b4fc3710677
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_PainPriest_State_ShadowheartSecondReactionDone(2) = False
#.   Tag:
#.      - REALLY_SHADOWHEART(2) = True
#. SetFlags:
#.   Object:
#.     - GOB_PainPriest_State_ShadowheartSecondReactionDone(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:7dd153ba-5dde-62a1-f1c7-0b4fc3710677
msgctxt "h94830737g5391g46f3g9086g692aa802ae7b"
msgid ""
"Not the worst technique, priest. Good wrist movement, lots of enthusiasm..."
msgstr "솜씨가 나쁘지 않아, 사제. 손목 움직임이 좋고, 열정도 넘치고..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Abdirak
#. NodeID = 7f50c5d8-fe31-2d8f-96e5-1508a6b65ea4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_PainPriest_Event_SecondHitDone = False
#.      - GOB_PainPriest_Event_ReactToSilence = True
#.      - GOB_PainPriest_Event_FirstHitDone = True
#. SetFlags:
#.   Global:
#.     - GOB_PainPriest_Event_SecondHitDone = True
#.     - GOB_PainPriest_Event_ReactToSilence = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:7f50c5d8-fe31-2d8f-96e5-1508a6b65ea4
msgctxt "hb4ee11cag51ebg4595g9b99g7eabfce66cb1"
msgid "Do not keep quiet, dear child. <i>Embrace it!</i>"
msgstr "친애하는 아이야, 묵묵히 있지 마라, <i>포용하거라!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Player
#. NodeID = 84f92298-3e2a-5db9-901f-32999b045a46
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_PainPriest_Event_Entertainer = False
#.   Tag:
#.      - BARD(1) = True
#. SetFlags:
#.   Global:
#.     - GOB_PainPriest_Event_ReactToCry = True
#.     - GOB_PainPriest_Event_Entertainer = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:84f92298-3e2a-5db9-901f-32999b045a46
msgctxt "hb32b7e92gb4b6g4faega83fg3664f92adcfd"
msgid "<i>Make a show of screaming at the top of your lungs.</i>"
msgstr "<i>보란듯이 전력을 다해 비명을 지른다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Abdirak
#. NodeID = 89e7008d-5350-41b3-c683-dd3c875a74c7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:89e7008d-5350-41b3-c683-dd3c875a74c7
msgctxt "h23da5125g9177g4c9cgbd39ge65671edca30"
msgid "Let the sting of flesh wash away your pain!"
msgstr "살을 찌르는 감촉이 네 고통을 씻어낼 거다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Astarion
#. NodeID = 8b36ab6b-1c5e-6240-fa10-e2488e7d9769
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_PainPriest_State_ShadowheartAstarionSecondReactionDone(2) = False
#.   Tag:
#.      - REALLY_SHADOWHEART(2) = True
#.      - REALLY_ASTARION(3) = True
#. SetFlags:
#.   Object:
#.     - GOB_PainPriest_State_ShadowheartAstarionSecondReactionDone(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:8b36ab6b-1c5e-6240-fa10-e2488e7d9769
msgctxt "h2722c909g1eb1g4c00g94d1gf9ed6a0b80ee"
msgid "My my. Who knew our friend had so much blood in them?"
msgstr "이런, 이런. 우리 친구가 이렇게 피가 많을 줄은 몰랐네?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Abdirak
#. NodeID = 9144a553-0e3d-f0ad-7b17-8b63035be5e6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_PainPriest_Event_BadReaction = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:9144a553-0e3d-f0ad-7b17-8b63035be5e6
msgctxt "h3d94ab25g5476g49f3g9f2eg24ac4047ab1b"
msgid "Such mockery only harms you, child."
msgstr "그런 모욕적인 시늉은 해가 될 뿐이다, 아이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Abdirak
#. NodeID = 93b8c6a9-3ef6-859d-fcc0-45f57a348b5f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_PainPriest_Event_SecondHitDone = False
#.      - GOB_PainPriest_Event_FirstHitDone = True
#. SetFlags:
#.   Global:
#.     - GOB_PainPriest_Event_SecondHitDone = True
#.     - GOB_PainPriest_Event_ReactToCry = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:93b8c6a9-3ef6-859d-fcc0-45f57a348b5f
msgctxt "hf52ba70fg097eg4066g9568gfca19d5d5738"
msgid "Pain is proof that we live! Revel in it."
msgstr "고통은 살아있다는 증거다! 그것에 열중해라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Player
#. NodeID = 9aa950e5-0e88-e49b-cb19-446013286ed2
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - GOB_PainPriest_Event_Harder = True
#.      - GOB_PainPriest_Event_HarderTwice = False
#.   Tag:
#.      - BARBARIAN(1) = False
#. SetFlags:
#.   Global:
#.     - GOB_PainPriest_Event_HarderTwice = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:9aa950e5-0e88-e49b-cb19-446013286ed2
msgctxt "h66bacc52g0b10g49eag97d6gdc5b3013a548"
msgid "You look tired. Should I take over?"
msgstr "힘들어 보이는데. 내가 대신 할까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Shadowheart
#. NodeID = a08f70f7-0391-4358-93ab-4e8789330780
