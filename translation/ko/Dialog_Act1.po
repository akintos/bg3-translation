#.      - a7407f82-add0-9f6d-e4e6-78b9c39195a6_A = True
#. SetFlags:
#.   Local:
#.     - a7407f82-add0-9f6d-e4e6-78b9c39195a6_C = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Forest_VB_Trap:021bcac7-3dca-28ab-1f9e-24f45962f47e
msgctxt "h2096a77egff82g4a9fg948fgc50a0bae3125"
msgid "And yet another. Hardly the warmest of welcomes."
msgstr "또 함정이군. 따뜻한 환영 인사랑은 거리가 먼걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Forest_VB_Trap
