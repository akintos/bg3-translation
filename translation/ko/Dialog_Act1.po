msgctxt "hdb4a1b21g7c5bg46cdgae00g9fca47774b96"
msgid "The Bite! No. I don't want to die. I don't - <i>Argh. </i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_HagLair_Victim_003_AD_HeartAttack
#. Speaker = Lorin
#. NodeID = 580b9161-1db8-82d1-0482-c3e27fa25c70
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_HagLair_Victim_003_AD_HeartAttack:580b9161-1db8-82d1-0482-c3e27fa25c70
msgctxt "hb2469272gc3dbg4e38g87b8g619e1e387877"
msgid "No, Ethel! I'm sorry! I'll go back! <i>Argh.</i>"
msgstr "안돼, 에텔! 죄송해요! 다시 돌아갈게요! <i>으악.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_HagLair_Victim_003_PAD_HeartAttack
#. Speaker = Player
#. NodeID = 14ef5776-c92f-0ac8-d40d-2f7938aa6069
