#.     - GOB_DrunkGoblin_AskedToKiss(4) = True
#. TagRule: TIEFLING
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:c37f214f-18d0-ae90-c588-78fec0d732b7
msgctxt "h4c379831gba90g472cga693g0d50bf8c9fef"
msgid "Or I'll kick yer head in, horn-face."
msgstr "아니면 네 대가리를 걷어차 주마, 뿔 면상아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = c37f214f-18d0-ae90-c588-78fec0d732b7
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_Checkpoint_State_Paint(4) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_DrunkGoblin_AskedToKiss(4) = True
#.     - GOB_DrunkGoblin_AskedToKiss(4) = True
#. TagRule: DUERGARDWARF and DWARF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:c37f214f-18d0-ae90-c588-78fec0d732b7
msgctxt "ha317dc73g0c15g4405ga1c2g20bd342e99fd"
msgid "Or I'll wipe that nasty look off yer face, thick-skull."
msgstr "안 그럼 너의 두꺼운 머리통에 달린 면상에서 그 재수 없는 표정을 씻어내주겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = c37f214f-18d0-ae90-c588-78fec0d732b7
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_Checkpoint_State_Paint(4) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_DrunkGoblin_AskedToKiss(4) = True
#.     - GOB_DrunkGoblin_AskedToKiss(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:c37f214f-18d0-ae90-c588-78fec0d732b7
msgctxt "hf53ad36ag040eg472cga63bga73e7a6ca563"
msgid "Or I'll wipe that nasty look right off yer face."
msgstr "안 그럼 너의 면상에서 그 재수 없는 표정을 씻어내주겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Player
#. NodeID = c437e12e-ea0f-90ef-2eb1-ca8f6b344a91
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:c437e12e-ea0f-90ef-2eb1-ca8f6b344a91
msgctxt "hec1fb3d2gf0fag406ag9b0bge5885bfc3c14"
msgid "Not so high and mighty, after all."
msgstr "역시 그렇게 강하고 대단한 녀석도 아니었네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = c441120f-7c39-c891-950b-feddd96d3e42
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:c441120f-7c39-c891-950b-feddd96d3e42
msgctxt "hf549718eg563ag4e80g98bag0153b399c62c"
msgid "Think I'm dumb? Huh?"
msgstr "내가 바본 줄 알아? 응?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = c441704c-4ad0-855e-1ba1-9034ab99e3bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:c441704c-4ad0-855e-1ba1-9034ab99e3bf
msgctxt "hb73668e6gacafg4f5ega824gc9005acb0f15"
msgid "What - how did you? <i>Tnak.</i> Fine."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = c7fddb95-7f0d-c9a8-3804-7a43805dcb98
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:c7fddb95-7f0d-c9a8-3804-7a43805dcb98
msgctxt "h9d737172g563ag4ee7ga32bg6d7b89a49f75"
msgid ""
"You want yer teeth knocked in? You ain't got nothin' on me. So kiss my foot."
msgstr "이빨이 부러지길 원하냐? 내게서 아무것도 받아내지 못할 거다. 그러니 내 발에 키스해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = c8aeb2ff-2aa4-b44c-9539-5b42a23f0d9c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_DrunkGoblin_Event_MoveToSecludedPlace(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:c8aeb2ff-2aa4-b44c-9539-5b42a23f0d9c
msgctxt "haa6c7f57g2eb3g4a67g8751g35f92745a621"
msgid "You enjoyin' that? Disgustin' worm. Just remember: you're nuffing 'ere."
msgstr "맛있었어? 역겨운 벌레 자식. 이것만 기억해: 넌 이곳 분위기를 망치고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = c946779a-b76a-241c-8fed-695929cb0147
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:c946779a-b76a-241c-8fed-695929cb0147
msgctxt "h200162f8g9d66g4476g8615g20d97beda6c1"
msgid "Trickster! Agh!"
msgstr "사기꾼 자식! 아악!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Player
#. NodeID = c98ef355-9a66-3e20-b82e-f7057b6e977e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:c98ef355-9a66-3e20-b82e-f7057b6e977e
msgctxt "h67dc1e49gcc8ag48f8gb047g68dc408943cd"
msgid "Was that enough reverence for you?"
msgstr "이 정도면 너에 대한 존경으로 충분했나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = ca41e44d-1380-c85e-066c-5f9517e08a59
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Absolute_Knows_GoblinsWorship = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:ca41e44d-1380-c85e-066c-5f9517e08a59
msgctxt "h93469c2egc8d7g436dg852dg2be22628af50"
msgid ""
"We're pure. We got the Absolute on our side. An' we'll be the ones on top."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Karlach
#. NodeID = cce8849b-cec4-a34b-11e4-f428cc9f3b2e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:cce8849b-cec4-a34b-11e4-f428cc9f3b2e
msgctxt "h63aa40a7gb1aeg4091gb37eg2a4ea991d83b"
msgid "I think it's fairly obvious. And impressive."
msgstr "꽤 명백한 것 같아. 그리고 인상적이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Player
#. NodeID = d3ae9f21-2b30-20ea-0f8c-a849a269e03e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:d3ae9f21-2b30-20ea-0f8c-a849a269e03e
msgctxt "h5bcc278fg9722g4a89g819cg0b16afb1dbc1"
msgid "<i>Swallow.</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = d7dadb54-7b3d-ad61-2a4d-6d6253105f1e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:d7dadb54-7b3d-ad61-2a4d-6d6253105f1e
msgctxt "h479aaad7gf1a3g48e2gbb61gd936d1921c0d"
msgid "What?! You... you <i>swine</i>."
msgstr "뭐야?! 너… 이 <i>돼지</i> 자식."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Lae'zel
#. NodeID = d82006dc-ff0b-c1b9-b563-0b0612f314d7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:d82006dc-ff0b-c1b9-b563-0b0612f314d7
msgctxt "h1835f49ag7d8bg4895gb447g75f060778b71"
msgid "Or just dispose of the foul thing."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Narrator
#. NodeID = d971bc16-6328-603f-e4b3-31f75b488c2f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:d971bc16-6328-603f-e4b3-31f75b488c2f
msgctxt "h2846b3ffg845eg4522ga516g0e98fe3ff636"
msgid "*You kneel before him, eagerly feigning reverence.*"
msgstr "*당신은 경외하는 척 하면서 그의 앞에 엎드립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Narrator
#. NodeID = d97d56f6-d6cd-5dba-471b-8b06624f8d20
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:d97d56f6-d6cd-5dba-471b-8b06624f8d20
msgctxt "hfea88cbbg3797g4a7dg9c7dg00bb2919bdbd"
msgid ""
"*The goblin stares, mouth agape. Then he sets his jaw and falls to his "
"knees.*"
msgstr "*고블린이 입이 떡 벌어진 채 바라봅니다. 그러고는 고개를 숙이고 무릎을 꿇습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Karlach
#. NodeID = d9bfb62b-c031-acaf-d9f3-2c7c751ba4dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:d9bfb62b-c031-acaf-d9f3-2c7c751ba4dc
msgctxt "hbd5bb45eg4823g401egb5e4g785302372e5f"
msgid ""
"Don't be so quick to judge. Every scar and sigil on my body serves a purpose "
"- there's beauty in them."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Player
#. NodeID = d9dbf856-e29c-57a1-dcc6-83acc3557a02
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(4) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:d9dbf856-e29c-57a1-dcc6-83acc3557a02
msgctxt "h77217a91g3563g4c9ag9ca6gb4fcbf03d8a9"
msgid "You better kiss my foot. Now."
msgstr "내 발에 키스하는 게 좋을 거야. 당장."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Narrator
#. NodeID = df2bf8b0-4acb-071f-cd6c-c5efaaacf1e7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TRUESOUL(4) = False
#. SetFlags:
#.   Tag:
#.     - TRUESOUL(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:df2bf8b0-4acb-071f-cd6c-c5efaaacf1e7
msgctxt "hde8b5dc9g4f6ag4aebg9cddg7df816db1858"
msgid ""
"*Your mind is full, bursting with ecstasy and terror. Finally, it is coming. "
"You are becoming.*"
msgstr "*당신의 정신이 황홀경과 공포로 가득 차오릅니다. 마침내, 때가 됐군요. 당신은 변화 중입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Shadowheart
#. NodeID = e0f3d950-5810-de6d-cd93-3a39bafe5a60
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:e0f3d950-5810-de6d-cd93-3a39bafe5a60
msgctxt "hf69bb263g8fbfg42eeg93f9gb61709a438b2"
msgid "Kiss the damn foot. Worse things have been shoved in your face lately."
msgstr "그 망할 발에 키스해. 최근 들어 더 나쁜 일들이 벌어지고 있잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Player
#. NodeID = e2fcda66-4ffe-02c9-fcd1-9a48fb316df6
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Dexterity
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - ROGUE(4) = True
#. SetFlags:
#.   Object:
#.     - GOB_DrunkGoblin_Event_KissedGoblinFeet(4) = True
#.     - GOB_DrunkGoblin_Event_KissedFeet(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:e2fcda66-4ffe-02c9-fcd1-9a48fb316df6
msgctxt "ha3fa043cgb0d4g4c80g915cgfa4cf9200178"
msgid "<i>Kiss his foot - and try to slide the ring off his toe.</i>"
msgstr "<i>그의 발에 입을 맞추며, 그의 발가락에 껴진 반지를 빼내려 시도한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Narrator
#. NodeID = e4496af5-c2ec-b9f5-468a-92bacb4ae60c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount5(4) = False
#.   Tag:
#.      - TRUESOUL(4) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount5(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:e4496af5-c2ec-b9f5-468a-92bacb4ae60c
msgctxt "h0f9cba1dgb05ag44b0g9e98g4a3bd96179d4"
msgid ""
"*Your blood runs quicker, feeding the gnawing absence at the centre of your "
"mind.*"
msgstr "*피가 더 빨리 흐르면서, 당신의 정신 한가운데를 좀먹는 허전함을 양분으로 채웁니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Player
#. NodeID = e578533f-d897-893a-8ed4-6b51f7f3b454
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4333c842-5420-6a87-571a-4e4f4ffaac40_MindHasBeenRead = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:e578533f-d897-893a-8ed4-6b51f7f3b454
msgctxt "h2491706ag68a4g40a8ga625gfeccc781858a"
msgid ""
"I know you're planning to take over. I wonder what your boss will think of "
"that."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = e5fab677-9db7-c6c3-dc3a-c01868980246
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_DrunkGoblin_Event_NoticedRing(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:e5fab677-9db7-c6c3-dc3a-c01868980246
msgctxt "h95b73e59g7ca1g4b4agb65bge7a7ca56fa9f"
msgid "That's more like it."
msgstr "그 정도면 충분해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = e6a6c586-fde2-5805-21cb-2ff53ff30a14
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_DrunkGoblin_Event_Mocked(0) = True
#. TagRule: TIEFLING
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:e6a6c586-fde2-5805-21cb-2ff53ff30a14
msgctxt "h537c16e4geafag4588ga50ag9c0292819160"
msgid "Get lost, ya sick horn-face."
msgstr "꺼져 이 뿔달린 자식아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = e6a6c586-fde2-5805-21cb-2ff53ff30a14
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_DrunkGoblin_Event_Mocked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:e6a6c586-fde2-5805-21cb-2ff53ff30a14
msgctxt "h2e3eca44gfacbg4aa7gb053g3e7ac9a4c5f5"
msgid "Get lost, ya sick bastard."
msgstr "꺼져 이 병든 자식아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = e6e85f31-1473-ef11-7027-d57ed4a6ab9c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_DrunkGoblin_Event_StartFistFight(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:e6e85f31-1473-ef11-7027-d57ed4a6ab9c
msgctxt "hb2972db0g0bd8g4efega1e9g648605bd5ac0"
msgid "I should bash your teeth in. Yeah, think I will."
msgstr "네 이빨을 부숴 줘야겠군. 그래, 그럴 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = e86ec2b1-b14c-15cf-3418-a53973270da3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_DrunkGoblin_Event_MoveToSecludedPlace(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:e86ec2b1-b14c-15cf-3418-a53973270da3
msgctxt "h30cb073fg173cg40a3g969ag3fa117c4f7c8"
msgid "Heh. Just about. But remember: you're nuffing 'ere."
msgstr "헤. 거의. 하지만 기억해둬: 넌 이곳 분위기를 망치고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = e8b1641c-79ba-1502-195f-c4f872a36b22
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_DrunkGoblin_Event_StartFistFight(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:e8b1641c-79ba-1502-195f-c4f872a36b22
msgctxt "h543fd942g43abg47fag8738gf7eaf28358bf"
msgid "I don't think so. I think I'll break your legs instead."
msgstr "난 그렇게 생각 안 하는데. 대신 네 다리를 부러뜨려 주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Player
#. NodeID = e9c23239-c77b-0e02-d6f0-ebba93fae906
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 5
#. CheckFlags:
#.   Global:
#.      - GLO_Absolute_Knows_TrueSoul = False
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(4) = False
#.   Tag:
#.      - TRUESOUL(4) = False
#.      - ILLITHID(4) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:e9c23239-c77b-0e02-d6f0-ebba93fae906
#, fuzzy
msgctxt "h19401dd2gc2ceg4768g818dg44b31e0af6f8"
msgid "I'm your superior. You'd better show some respect."
msgstr "나는 참된 영혼이다. 예의를 갖추는 게 좋을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = ec539e72-afcf-3081-933c-45d51710a0e5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
