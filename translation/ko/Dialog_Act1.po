msgctxt "hf43e220cgd655g4eafgbf81g281f53459491"
msgid "*The corpse does not stir. It will answer no more questions.*"
msgstr "*시체는 움직이지 않습니다. 더 이상 질문을 받지 않을 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DeadMyconid_Dead
#. Speaker = Narrator
#. NodeID = 60c9bbe3-1f0b-a9a4-0f3b-839a68892f29
#. HandlePath = TaggedText[0].TagText[0]
