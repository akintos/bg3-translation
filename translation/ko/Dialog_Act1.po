msgctxt "hc745c247g3b96g4deegb1eeg34c97c442f01"
msgid "Who sent you?"
msgstr "누가 널 보냈지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarlockProposal_Warlock
#. Speaker = Korrilla
#. NodeID = ae4c5217-3766-6978-85eb-d4b6a189d4a9
