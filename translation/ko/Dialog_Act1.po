msgctxt "ha810f2e8g9cd6g4809g998eg1256c1a7241d"
msgid ""
"My master has been keeping a close eye on you. When you got yourself into "
"this predicament, he sent me to help."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarlockProposal_Warlock
#. Speaker = Korrilla
#. NodeID = 75243efb-cb3d-9fca-8adb-ed4533c2c04f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarlockProposal_Warlock:75243efb-cb3d-9fca-8adb-ed4533c2c04f
msgctxt "h8ab7b3d2g1a2ag4d86ga302g08d9b751d1d9"
msgid ""
"I must say, seeing the infamous Demonsbane at the mercy of a goblin is very "
"disappointing."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarlockProposal_Warlock
#. Speaker = Korrilla
#. NodeID = 7751dfef-2439-34d7-ada2-24253cb02c23
