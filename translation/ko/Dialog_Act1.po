msgctxt "he9c07f89g0aa1g4a57g9f8bg27eeea51d0f8"
msgid "Still pokin' around?"
msgstr "아직도 찔러보고 다니나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GuardPolite
#. Speaker = Warrior Druk
