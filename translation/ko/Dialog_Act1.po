msgctxt "hd037d589g103cg4e1bg88d5g7d87cf8ec217"
msgid "To Selûne, who lights the way!"
msgstr "길을 밝히시는 자, 셀루네를 위하여!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Player
#. NodeID = f29720cb-f396-5e5a-5900-5ac9cee1fea4
