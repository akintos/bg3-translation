msgctxt "hae99170egd811g440aga167g5ac6fd9f21ac"
msgid "She's running. Now it's a <i>hunt</i>."
msgstr "도망치고 있군. 이제 그녀를 <i>사냥</i>할 시간이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_PAD_Fled
#. Speaker = Player
#. NodeID = 6924b376-74a5-73e5-cb76-678748ba5d65
