#.      - GOB_WolfPens_State_PrisonerPermaDefeated = False
#. SetFlags:
#.   Dialog:
#.     - GOB_WolfPens_Worg_001_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_Worg_001:0d40c530-5dae-6611-6a3d-3e58a9cf641b
msgctxt "h7c2a6fc7gb473g49cdgb4cdg1347bc1c77c1"
msgid "Smells big. Big belly. Big GUTS."
msgstr "냄새 크다. 배 크다. <b>내장</b> 크다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_Worg_001
#. Speaker = Ferr
#. NodeID = 7e86d706-02eb-609a-c6eb-8c8fe23df0ea
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_WolfPens_Worg_001_HasMet(1) = True
#.   Global:
#.      - GOB_WolfPens_State_PrisonerPermaDefeated = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_Worg_001:7e86d706-02eb-609a-c6eb-8c8fe23df0ea
msgctxt "h9e81e307g82c8g4c49gb810g7e2ca797ba2f"
msgid "Want it. Fur and meat. Kill it. KILL IT!"
msgstr "원해. 털이랑 고기. 죽여. <b>죽여</b>!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_Worg_001
#. Speaker = Ferr
#. NodeID = a2917002-02be-574e-eb5a-21f92de7283a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_WolfPens_State_PrisonerPermaDefeated = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_Worg_001:a2917002-02be-574e-eb5a-21f92de7283a
msgctxt "hc894baeag9cf6g43e1gac32gfac75f35eca8"
msgid "Meat. Gimme it. GIMME!"
msgstr "고기. 줘. <b>내놔</b>!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_Worg_002
#. Speaker = Tale
#. NodeID = 937a557b-d97d-7c4e-0e75-541e3e3b2b2f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_WolfPens_Worg_002_HasMet(1) = False
#.   Global:
#.      - GOB_WolfPens_State_PrisonerPermaDefeated = False
#. SetFlags:
#.   Dialog:
#.     - GOB_WolfPens_Worg_002_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_Worg_002:937a557b-d97d-7c4e-0e75-541e3e3b2b2f
msgctxt "h498e3e97gda46g4dadgbb2fg6aa598a909d6"
msgid "Fur. Can't you smell the fur? Fur and meat. Lots of MEAT!"
msgstr "털. 털 냄새가 나지 않아? 털이랑 고기. 엄청 많은 <b>고기</b>!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_Worg_002
#. Speaker = Tale
#. NodeID = a890cc5d-99ae-4b9b-9c96-a9a28c332948
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_WolfPens_Worg_002_HasMet(1) = True
#.   Global:
#.      - GOB_WolfPens_State_PrisonerPermaDefeated = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_Worg_002:a890cc5d-99ae-4b9b-9c96-a9a28c332948
msgctxt "hc6d26878g543ag4868gac0dgfc9fd7f55f89"
msgid "Meat, Meat. Let me TEAR it up!"
msgstr "고기, 고기. 내가 <b>해체하게</b> 해줘!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_Worg_002
#. Speaker = Tale
#. NodeID = f4871e41-74a9-441c-71f2-853fa2fda868
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_WolfPens_State_PrisonerPermaDefeated = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_Worg_002:f4871e41-74a9-441c-71f2-853fa2fda868
msgctxt "h1b91f868g28a4g4c6dg9651g7febc8c475a4"
msgid "Out. OUT. Out and RIP it apart."
msgstr "꺼내. <b>꺼내</b>. 꺼내서 갈가리 찢어버리자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ZhentarimGuard_Caster_01
#. Speaker = Erna
#. NodeID = 7509b759-b2b3-20cf-4094-ef31722ba1e6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_ZhentarimGuard_Caster_01_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ZhentarimGuard_Caster_01:7509b759-b2b3-20cf-4094-ef31722ba1e6
msgctxt "h9cef8b38ga53dg4e31gac1bg988d143c88ac"
msgid "You don't want to go in there. Really."
msgstr "거기 들어가고 싶진 않을 거야. 정말로."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ZhentarimGuard_Caster_01
#. Speaker = Erna
#. NodeID = e2dbeedc-c018-a57a-56f7-e31c2fc5b964
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_ZhentarimGuard_Caster_01_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_ZhentarimGuard_Caster_01_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ZhentarimGuard_Caster_01:e2dbeedc-c018-a57a-56f7-e31c2fc5b964
msgctxt "hc6179e1cge51dg4e15gac61gaec8fbfc89e6"
msgid ""
"Wouldn't go in there, 'less you fancy blowing your bones all the way to "
"Baldur's Gate."
msgstr "거긴 들어가지 않는 게 좋을 거야, 네 뼛조각이 발더스 게이트까지 날아가는 걸 구경하고 싶은 게 아니라면 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ZhentarimGuard_Melee_01
#. Speaker = Yerle
#. NodeID = 0cbf348b-13a0-a0ca-3da1-3149da0d3342
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ZhentarimGuard_Melee_01:0cbf348b-13a0-a0ca-3da1-3149da0d3342
msgctxt "h3f4f39e3g6e92g4ebegbae3g3a978f68c64b"
msgid "Bye."
msgstr "안녕."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ZhentarimGuard_Melee_01
#. Speaker = Yerle
#. NodeID = 71c2df48-4742-d401-b312-cb9495f21d1e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_ZhentarimGuard_Melee01_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ZhentarimGuard_Melee_01:71c2df48-4742-d401-b312-cb9495f21d1e
msgctxt "h978a114bgb45dg41c4g88b5g7d76799f434a"
msgid "Snout. <i>Out.</i>"
