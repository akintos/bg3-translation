#. CheckFlags:
#.   Object:
#.      - DEN_Thieflings_Event_LeftHideoutNormally(0) = True
#. SetFlags:
#.   Object:
#.     - DEN_Thieflings_Event_LeftHideoutNormally(0) = False
#. TagRule: !(DWARF and GNOME and HALFLING and KID and SHORT)
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_CannotFitCrack:a7ac2259-b437-3ec4-8b5d-b2f092dde2f3
msgctxt "hb595f6c2gf581g4a8dg884ag1fe4e5bebab6"
msgid "Tight fit. I won't be getting back in that way."
msgstr "꽉 끼는군. 다시는 그런 식으로 돌아가지 않을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_GuardAfterKnockout
#. Speaker = Ikaron
#. NodeID = d80cf65d-cfb7-6a62-e2fe-4391c6918c81
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_AdventurerKnockedOut = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_GuardAfterKnockout:d80cf65d-cfb7-6a62-e2fe-4391c6918c81
msgctxt "h3833b95eg18d3g45feg90e4g8531850941e2"
msgid "And stay down."
msgstr "그대로 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_GuardAfterKnockout
#. Speaker = Ikaron
#. NodeID = f9f4d539-7d42-35a2-a8cd-b081c9938e72
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_AdventurerKnockedOut = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_GuardAfterKnockout:f9f4d539-7d42-35a2-a8cd-b081c9938e72
msgctxt "hf0bd275dg2b72g4c37g8fedg4bcb125ce2f9"
msgid "Enough of this."
msgstr "더는 집어치워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_HideoutGuards
#. Speaker = Mol
#. NodeID = 06b92350-eec0-20ca-1bb4-0cfa450bf317
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_HideoutGuards:06b92350-eec0-20ca-1bb4-0cfa450bf317
msgctxt "h067f2d15gfb1dg49a7g9f79g56eaae9635ca"
msgid ""
"Don't get too attached to that con, kids. I got bigger plans for the city."
msgstr "그런 잡기술 하나에 너무 목매지들 마. 도시에 가거든 큰물에서 놀 거니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_HideoutGuards
#. Speaker = Mirkon
#. NodeID = 3586a150-b47c-d8c8-4277-5a0c0ff729a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_HideoutGuards:3586a150-b47c-d8c8-4277-5a0c0ff729a5
msgctxt "h8262f2b7g0f70g47f9gaaceg3d8cfd1635a7"
msgid "I bet that scam is going to kill in Baldur's Gate."
msgstr "그 수법, 발더스 게이트에서는 씨알도 안 먹힐걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_HideoutGuards
#. Speaker = Mol
#. NodeID = 36cc6736-bff8-5b63-997e-1d5ee940f353
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_HideoutGuards:36cc6736-bff8-5b63-997e-1d5ee940f353
msgctxt "hec7ad396g7361g4d94gab99gf16ff14bb475"
msgid "Don't worry, kid. In Baldur's Gate, purses practically grow on trees."
msgstr "걱정 마, 얘들아. 발더스 게이트에는 나무마다 지갑이 걸려 있다더라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_HideoutGuards
#. Speaker = Mirkon
#. NodeID = 41de10cc-e112-4f0f-9db9-72ce0ff92040
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 9ce64d50-c76f-42a0-3730-3e1e28922e8d_Switch1 = True
#. SetFlags:
#.   Local:
#.     - 9ce64d50-c76f-42a0-3730-3e1e28922e8d_Switch1 = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_HideoutGuards:41de10cc-e112-4f0f-9db9-72ce0ff92040
msgctxt "hb75c5ee7gb44fg4d68g9df2gc52509260579"
msgid "Sorry about the nest. You guys find anything good today?"
msgstr "둥지 일은 미안하게 됐어. 오늘 뭐 좀 건졌니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_HideoutGuards
#. Speaker = Mol
#. NodeID = 4e83a177-82bc-2684-7d24-50fd6ace744c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_HideoutGuards:4e83a177-82bc-2684-7d24-50fd6ace744c
msgctxt "h40b00025gb3ccg4434gb285ga12e60cfa8ef"
msgid "Be patient. We'll get there."
msgstr "조금만 참아. 금방 도착할 테니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_HideoutGuards
#. Speaker = Mol
#. NodeID = 50290384-c006-897f-3692-ab8c1b5342eb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_CaughtThief = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_HideoutGuards:50290384-c006-897f-3692-ab8c1b5342eb
msgctxt "hbfb17c2egc344g42cegb4d5ge35d15f170c7"
msgid "Silfy needs the practice. You'll be out there soon enough."
msgstr "실피가 실습 중이잖아. 금방 밖에 내보내 줄게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_HideoutGuards
#. Speaker = Zaki
#. NodeID = 5ed608c9-ee58-3a43-1274-f19bd734150d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 9ce64d50-c76f-42a0-3730-3e1e28922e8d_Switch1 = False
#. SetFlags:
#.   Local:
#.     - 9ce64d50-c76f-42a0-3730-3e1e28922e8d_Switch1 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_HideoutGuards:5ed608c9-ee58-3a43-1274-f19bd734150d
msgctxt "h287cec53g06d7g4a2dga1bagab220d04aea8"
msgid "When do I get to run the ring scam?"
msgstr "반지 사기는 언제쯤 가르쳐 줄 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_HideoutGuards
#. Speaker = Mirkon
#. NodeID = c8868885-3686-7e7b-9f0d-a781b88873cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_HideoutGuards:c8868885-3686-7e7b-9f0d-a781b88873cb
msgctxt "h227827cbg6284g4cd6g8ba3g62a3b75d52c2"
msgid "Can you stop? It's not like you never got caught."
msgstr "그만하지? 누군 한 번도 안 들킨 것처럼 말하네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_HideoutGuards
#. Speaker = Zaki
#. NodeID = cf1e781a-08a1-78f8-87a6-2ea926ea056d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_HideoutGuards:cf1e781a-08a1-78f8-87a6-2ea926ea056d
msgctxt "hae4306b9g17dag4decgacebga47995beacb9"
msgid "I knew she wasn't ready."
msgstr "걜 내보낸 게 실수였어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_HideoutGuards
#. Speaker = Zaki
#. NodeID = dd2c91ac-a803-8e56-00e2-b62307814ec6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_HideoutGuards:dd2c91ac-a803-8e56-00e2-b62307814ec6
msgctxt "h5d41312eg88bfg411cg87adg310400b6ce68"
msgid "Nah. Everyone's got junk. Worse than junk."
msgstr "아니. 쓰레기밖에 없더라. 쓰레기보다 더하거나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_HideoutGuards
#. Speaker = Mol
#. NodeID = de3155c9-88d5-5aca-7013-800d3947a00f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_CaughtThief = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_HideoutGuards:de3155c9-88d5-5aca-7013-800d3947a00f
msgctxt "hf7cba695g9e26g47e8gb344gb8faa386fdec"
msgid "Silfy got caught. We have to lay low for a while."
msgstr "실피가 걸렸어. 당분간은 몸 좀 사려야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_HideoutLeader
#. Speaker = Mol
#. NodeID = 36b2cf34-6f60-2797-b093-dadcb4b118ac
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 85dd5a35-de87-562e-2bbe-46a91bee0e99_B = True
#. SetFlags:
#.   Local:
#.     - 85dd5a35-de87-562e-2bbe-46a91bee0e99_B = False
#.     - 85dd5a35-de87-562e-2bbe-46a91bee0e99_A = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_HideoutLeader:36b2cf34-6f60-2797-b093-dadcb4b118ac
msgctxt "hcf4cce89ga2f1g4170g9c79g11d4d055eb6c"
msgid "We're going to own that town."
msgstr "우리는 그 마을을 가질거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_HideoutLeader
#. Speaker = Mol
#. NodeID = 4e98e077-0703-60af-bf2d-010a3eb0bc21
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 85dd5a35-de87-562e-2bbe-46a91bee0e99_B = False
#.      - 85dd5a35-de87-562e-2bbe-46a91bee0e99_A = False
#. SetFlags:
#.   Local:
#.     - 85dd5a35-de87-562e-2bbe-46a91bee0e99_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_HideoutLeader:4e98e077-0703-60af-bf2d-010a3eb0bc21
msgctxt "h59bb32d3ge91ag4788gb5ecga200bbc77b30"
msgid "Not long until we leave, now."
msgstr "이제 우리 떠날 시간이 얼마 안 남았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_HideoutLeader
#. Speaker = Mol
#. NodeID = f81cf0b5-eaee-c18e-b816-64c3bdb70f5e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 85dd5a35-de87-562e-2bbe-46a91bee0e99_B = False
#.      - 85dd5a35-de87-562e-2bbe-46a91bee0e99_A = True
#. SetFlags:
#.   Local:
#.     - 85dd5a35-de87-562e-2bbe-46a91bee0e99_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_HideoutLeader:f81cf0b5-eaee-c18e-b816-64c3bdb70f5e
msgctxt "h74e69951g77d3g4cbeg9781gddefcdf0a4dc"
msgid "The Gate will never see us coming."
msgstr "발더스 게이트는 우리가 오는 줄도 모를 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_HideoutTrespass
