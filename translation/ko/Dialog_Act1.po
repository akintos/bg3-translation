msgctxt "h7e1d178fg075bg454fg9086g1025d4821e4e"
msgid "Relax, everything's fine. Just go back to sleep."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinSleeper_01
#. Speaker = Tracker Dullwill
#. NodeID = 219919a1-be8c-e152-0918-591f954901dc
