msgctxt "h080f3b09g769dg42a2g9e03g1c0c5a48df62"
msgid "W-wha? Quick, get her!"
msgstr "무, 무슨? 얘들아, 공격해라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = e2e769d8-2ff9-14c5-34d2-b0f49e400ab7
#. HandlePath = TaggedText[2].TagText[0]
#. SetFlags:
#.   Global:
#.     - WLD_FOR_GnomeGoblinsAngry = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:e2e769d8-2ff9-14c5-34d2-b0f49e400ab7
msgctxt "h7103c2d0gb11cg4744gaef4gd03d16269c43"
msgid "W-wha? Quick, get 'em!"
msgstr "무, 무슨? 얘들아, 공격해라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Player
#. NodeID = e3a296a0-5ecd-ad39-9228-28af0ee6e60a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - WLD_GnomeGoblin1_NoGoldPersuade(2) = False
#.      - WLD_GnomeGoblin1_CantCount(2) = False
#. SetFlags:
#.   Dialog:
#.     - WLD_GnomeGoblin1_CantCount(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:e3a296a0-5ecd-ad39-9228-28af0ee6e60a
msgctxt "hed5cb860g533dg4ae6gba3ag66ee91936091"
msgid "You do know that's a lower figure, yes?"
msgstr "그거 더 낮은 숫자인 건 알고 있어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = e424f1a1-c883-7cef-7e51-d4ee14a8dbe5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:e424f1a1-c883-7cef-7e51-d4ee14a8dbe5
msgctxt "hda95d38dg213cg4974g9e38gd5d5c581574c"
msgid ""
"We ain't lookin' fer <i>company</i>, maggot - not unless you wanna join 'im "
"up there..."
msgstr "우린 <i>동지</i>를 찾고 있지 않아, 구더기야. 네가 저 위에 있는 애랑 같이 있고 싶지 않는 한..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = e48cce5a-9095-324d-662a-d743433bb778
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:e48cce5a-9095-324d-662a-d743433bb778
msgctxt "hfe262c1dg4110g48fag97bcg4a12e0e4f285"
msgid "'Cause it makes me laugh! <i>Heh!</i>"
msgstr "그야 웃기니까! <i>흐헤헤!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = e564eb0e-078d-4a6d-660d-f15ff5b1f795
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - WLD_UnfortunateGnome_PayShow(2) = True
#. SetFlags:
#.   Global:
#.     - FOR_GnomeGoblinsPacified = True
#.   Object:
#.     - GEN_TransferNPCPayment(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:e564eb0e-078d-4a6d-660d-f15ff5b1f795
msgctxt "h2400604bg2d76g4b03g8056g6e4d06c67d00"
msgid ""
"Y'know what? Fair's fair. Enjoy the show. C'mon, you lot, leave the runt. "
"Let's go."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Player
#. NodeID = e5ecce18-cae6-9e94-9914-2a6bc07f037f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - f8d20378-d64f-2863-d81e-394cd4a9fa41_MindHasBeenRead = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:e5ecce18-cae6-9e94-9914-2a6bc07f037f
msgctxt "h1cd677acg20d2g4300gb260gdc38e7d1965f"
msgid "You don't have the stomach for a fight."
msgstr "너는 싸울 배짱이 없구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = e665287e-a9a9-0766-db0b-9be4c3a2e8e5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_GnomeGoblinsPacified = True
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:e665287e-a9a9-0766-db0b-9be4c3a2e8e5
msgctxt "h38657953g7edag4c84g802dga0afe0750072"
msgid "C'mon, you lot, hop it before he changes his mind!"
msgstr "너희들, 따라와. 저분이 마음을 바꾸기 전에 후딱 가자!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = e665287e-a9a9-0766-db0b-9be4c3a2e8e5
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_GnomeGoblinsPacified = True
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:e665287e-a9a9-0766-db0b-9be4c3a2e8e5
msgctxt "h70ad6fbcg584dg40bbgbe38g91d1e90b5fd0"
msgid "C'mon, you lot, hop it before she changes her mind!"
msgstr "너희들, 따라와. 저분이 마음을 바꾸기 전에 후딱 가자!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = e665287e-a9a9-0766-db0b-9be4c3a2e8e5
#. HandlePath = TaggedText[2].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_GnomeGoblinsPacified = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:e665287e-a9a9-0766-db0b-9be4c3a2e8e5
msgctxt "hb2fd0aeeg8c4dg4f88gad34g58c62bd5c244"
msgid "C'mon, you lot, hop it before they change their mind!"
msgstr "너희들, 따라와. 저분이 마음을 바꾸기 전에 후딱 가자!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = e904c5f3-b684-a4bb-fd5c-6220fdd2e367
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:e904c5f3-b684-a4bb-fd5c-6220fdd2e367
msgctxt "h25cfa03bgccf0g4484gb425g86941785f573"
msgid "...erm..."
msgstr "...으음..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = eb588e25-6bdf-feaa-40f8-8301282cf469
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:eb588e25-6bdf-feaa-40f8-8301282cf469
msgctxt "h1e222a99g25e8g4717gb1a3gbcdd862ced0d"
msgid ""
"Y-you want that little pipsqueak...? But we're supposed to take 'im "
"hostage..."
msgstr "다-당신은 저 작고 볼품없는 녀석을 원하시는 겁니까...? 하지만 저희가 인질로 붙잡고 있어야 하는데..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Narrator
#. NodeID = ebe30a7f-e29a-9602-3ac9-6af5d2ed214d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - GLO_TadpoleIntro_NPC(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:ebe30a7f-e29a-9602-3ac9-6af5d2ed214d
msgctxt "hec92f568ge9e6g40eag9a13g652789b21584"
msgid "*As the symbol glows, power courses through you. <i>Authority</i>.*"
msgstr "*문양이 빛나며, 몸에 흐르는 힘이 느껴집니다. <i>권위</i>.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = ee3e8642-455c-c355-cf58-c79c4e8863de
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:ee3e8642-455c-c355-cf58-c79c4e8863de
msgctxt "hf72a944bg4e35g4430g8fb6g9c14e26b495c"
msgid "What's it bloody look like? We're teaching this 'ere pipsqueak to fly!"
msgstr "빌어먹을 뭐로 보여? 이 볼품없는 녀석에게 나는 방법을 가르치는 중이지!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Player
#. NodeID = f0f4690c-7339-2396-c50e-78b15c885e1f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:f0f4690c-7339-2396-c50e-78b15c885e1f
msgctxt "h34331e08gb055g4c73gb4ccg82ea345457d0"
msgid "<i>Attack the goblins.</i>"
msgstr "<i>고블린을 공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = f2dd22f8-c5a6-6a68-c56a-2909c39c929f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:f2dd22f8-c5a6-6a68-c56a-2909c39c929f
msgctxt "h926cacc5g4ab4g48fegac6cgf319598de90c"
msgid "...but you know that, of course... erm... don't you?"
msgstr "...하지만 그것도 당연히 아시겠죠... 음... 아닌가요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = f3a17dbf-06ec-928e-7ab2-034139581ed1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:f3a17dbf-06ec-928e-7ab2-034139581ed1
msgctxt "hfe23c8e6gff14g4d17gacaege65d743e6a5c"
msgid "What're you sayin', that I can't <i>count</i>?!"
msgstr "무슨 소리야, 내가 <i>계산</i>도 못한다는 거야?!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Player
#. NodeID = f624c883-b74e-e50a-0cb9-a76b0bcb6298
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Script:
#.      - GEN_CheckPocketGold_5 = False
#.   Tag:
#.      - BARBARIAN(2) = False
#. SetFlags:
#.   Global:
#.     - FOR_UnfortunateGnome_State_NonCharlatanAccess = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:f624c883-b74e-e50a-0cb9-a76b0bcb6298
msgctxt "h9f18d04ag82d0g4677g86f5gabe6d7cccafb"
msgid ""
"Here's my counter-offer: you can all live so long as you leave right now."
msgstr "내 역제안을 하지: 너희 모두 당장 떠나면 살 수 있을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = f6639d11-3ad3-e62e-24be-7084355b1dfd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:f6639d11-3ad3-e62e-24be-7084355b1dfd
msgctxt "h5c9d62e8g8430g4f32g8b92gf3ef3315d6e0"
msgid "Yehehueh! Flap those wings some more, an' I'll feed you a worm!"
msgstr "와하하하! 날개를 좀 더 퍼덕여봐, 벌레 하나 먹이로 줄게!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Player
#. NodeID = f765b55f-919d-5d32-88ce-a4cd3de17bfd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - WLD_GnomeGoblin1_DrowKeepGoing(2) = False
#. SetFlags:
#.   Dialog:
#.     - WLD_GnomeGoblin1_DrowKeepGoing(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:f765b55f-919d-5d32-88ce-a4cd3de17bfd
msgctxt "h6b0580cdg0d8dg4c5aga5bcg00e630b30b2e"
msgid "Did I tell you to stop? Turn around and continue as you were."
msgstr "내가 그만두라고 했나? 돌아서서 하던 대로 계속해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = f8b9b90e-9475-945b-4030-7aee785730b8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:f8b9b90e-9475-945b-4030-7aee785730b8
msgctxt "h03725d7ag5054g47c3gb3fdg2272ef75440f"
msgid "Naw... something ain't right. You're not like the others..."
msgstr "아냐... 뭔가 잘못됐어. 넌 다른 참된 영혼들과 달라..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = f9253626-1ef7-32bf-ec6e-be266b1893fc
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:f9253626-1ef7-32bf-ec6e-be266b1893fc
msgctxt "h89fb365fga3d7g439ega5fag18895e122623"
msgid ""
"We'll, eh... we'll be on our way, sir. Do as you like with the pipsqueak..."
msgstr "우린, 에... 우린 갈 길 가겠습니다, 나으리. 이 볼품없는 녀석은 마음대로 하십쇼..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = f9253626-1ef7-32bf-ec6e-be266b1893fc
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:f9253626-1ef7-32bf-ec6e-be266b1893fc
msgctxt "h83ed3279g39a7g448cg9c3agfc5610338d44"
msgid ""
"We'll, eh... we'll be on our way, madam. Do as you like with the pipsqueak..."
msgstr "우린, 에... 우린 갈 길 가겠습니다, 마님. 이 볼품없는 녀석은 마음대로 하십쇼..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = f9253626-1ef7-32bf-ec6e-be266b1893fc
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:f9253626-1ef7-32bf-ec6e-be266b1893fc
msgctxt "h7f30f76cg6786g4e34gbdacg19d34525b180"
msgid ""
"We'll, eh... we'll be on our way, True Soul. Do as you like with the "
"pipsqueak..."
msgstr "우린, 에... 우린 갈 길 가겠습니다, 참된 영혼이시여. 이 볼품없는 녀석은 마음대로 하십쇼..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = f98d6e12-6352-bb5f-2192-c70dae87dbb9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - WLD_UnfortunateGnome_UsedAmulet(2) = False
#. SetFlags:
#.   Global:
#.     - FOR_GnomeGoblinsPacified = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:f98d6e12-6352-bb5f-2192-c70dae87dbb9
msgctxt "hc5c6d8d5ga8a1g445agab3eg37902859a5bc"
msgid ""
"All right, fine! Take the little blood clot. Good riddance to the lot o' ye!"
msgstr "좋아, 알았어! 저 작은 바보 녀석은 데려가. 네 놈들 안 볼걸 생각하니 속이 시원하군!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = fc4f7255-62ea-0712-2be5-e0788d33745a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_UnfortunateGnome_State_DrowAutoPass = True
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:fc4f7255-62ea-0712-2be5-e0788d33745a
msgctxt "h20eae4fcg4e74g4ad9g8a7ag97df37ed738d"
msgid "N-no, not questionin', sir! Never! We know our place..."
msgstr "아-아니요, 의심하다니요, 나으리! 절대 아닙니다! 저희는 분수도 알고, 있어야 할 곳도 알죠..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = fc4f7255-62ea-0712-2be5-e0788d33745a
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_UnfortunateGnome_State_DrowAutoPass = True
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:fc4f7255-62ea-0712-2be5-e0788d33745a
msgctxt "h711c6db8g88bfg4da8g8947gb6681102dcff"
msgid "N-no, not questionin', madam! Never! We know our place..."
msgstr "아-아니요, 의심하다니요, 마님! 절대 아닙니다! 저희는 분수도 알고, 있어야 할 곳도 알죠..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = fc4f7255-62ea-0712-2be5-e0788d33745a
#. HandlePath = TaggedText[2].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_UnfortunateGnome_State_DrowAutoPass = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:fc4f7255-62ea-0712-2be5-e0788d33745a
msgctxt "haa302a75ged33g4e5bg93c9g4f20bd516429"
msgid "N-no, not questionin', True Soul! Never! We know our place..."
msgstr "아-아니요, 의심하다니요, 참된 영혼님! 절대 아닙니다! 저희는 분수도 알고, 있어야 할 곳도 알죠..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Player
#. NodeID = ff06f902-8a19-32bb-1906-b5c585381dc6
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Dialog:
#.      - WLD_GnomeGoblin1_AbandonNegotiations(2) = True
#.   Tag:
#.      - BARBARIAN(2) = False
#.      - PALADIN(2) = False
#. SetFlags:
#.   Global:
#.     - FOR_UnfortunateGnome_State_NonCharlatanAccess = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:ff06f902-8a19-32bb-1906-b5c585381dc6
msgctxt "h52e50476g78cbg4b06g8344g6c65980da1f2"
msgid "Negotiations are over. Either leave or die."
msgstr "협상은 끝이야. 떠나든가 죽든가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_AD_InvestigateMill
#. Speaker = Fezzerk
#. NodeID = 18249729-4b64-0864-efef-73fc04b47c72
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_UnfortunateGnome_Event_ThrowOff = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_AD_InvestigateMill:18249729-4b64-0864-efef-73fc04b47c72
msgctxt "h209c5d01g7a65g4c4fga496ga2ffd037b330"
msgid "Why's the spinnymajigger stopped? Get it moving again!"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_AD_InvestigateMill
#. Speaker = Fezzerk
#. NodeID = 6b95a46d-691b-d22f-0628-a6cdb01a6ce8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_UnfortunateGnome_Event_ThrowOff = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_AD_InvestigateMill:6b95a46d-691b-d22f-0628-a6cdb01a6ce8
msgctxt "h6503100bgcf1dg4f91gbc53g5611fd974ce7"
msgid "Our birdy flew away! Go check 'round back!"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_AD_UnfortunateGnomeGone
#. Speaker = Fezzerk
#. NodeID = df988201-7943-3925-dbbb-7c1ead2e1395
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_AD_UnfortunateGnomeGone:df988201-7943-3925-dbbb-7c1ead2e1395
msgctxt "hb646caa3g1938g4cfdg8b38gfbf46ae3fa3f"
msgid "Look's like the fun's over. C'mon, let's see who else we can snatch."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Dead
#. Speaker = Player
#. NodeID = 0e5393ff-cf03-d861-78a9-977fb5ebdd1b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Dead:0e5393ff-cf03-d861-78a9-977fb5ebdd1b
msgctxt "h2e8d8029gd6c7g4d12g84e8ge8c65a2f6207"
msgid "What were you doing in the village?"
msgstr "마을에서 뭘 하고 있었지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Dead
#. Speaker = Fezzerk
#. NodeID = 18fd40d4-4151-030c-c2fc-11a47032eb4f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Dead:18fd40d4-4151-030c-c2fc-11a47032eb4f
msgctxt "hb7fbc59fgdc8ag40d0ga578g8d10af8b359a"
msgid "Fezzerk... best raider... east o' the... Sea o' Swords..."
msgstr "페제르크... 검의 바다... 동쪽에서... 제일가는 습격자..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Dead
#. Speaker = Player
#. NodeID = 1a55665d-6c83-6ab5-b549-3c30d1e6d08a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Dead:1a55665d-6c83-6ab5-b549-3c30d1e6d08a
msgctxt "hca1c19dagc928g4733g93d1g8a684e599e2d"
msgid "Are there others like you nearby?"
msgstr "근처에 너희 부류가 더 있나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Dead
#. Speaker = Player
#. NodeID = 3210ab92-3f9a-7035-9e48-c22138f4504b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Dead:3210ab92-3f9a-7035-9e48-c22138f4504b
msgctxt "h43b9e19cg2456g4997g9f21gf1c186967b08"
msgid "Where did you come from?"
msgstr "어디서 왔지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Dead
#. Speaker = Fezzerk
#. NodeID = 37bd0e52-ff19-45d0-3691-6f5e4593b11d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Dead:37bd0e52-ff19-45d0-3691-6f5e4593b11d
msgctxt "h11c2fd76g2de7g41a2gae68g1b8c22a3912d"
msgid ""
"Many... so many... legions o' goblins... an' more... serving... the "
"Absolute..."
msgstr "많아... 아주 많아... 고블린 군단과... 더 많은 자들이... 절대자를... 섬기지..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Dead
#. Speaker = Narrator
#. NodeID = 4f5996ef-8556-0844-8c22-efa0f66de951
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Dead:4f5996ef-8556-0844-8c22-efa0f66de951
msgctxt "h49bda94cg87b1g4657g8e93g2ec9de421fc0"
msgid "*The corpse does not stir. It will answer no more questions.*"
msgstr "*시체는 움직이지 않습니다. 더 이상 질문을 받지 않을 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Dead
#. Speaker = Fezzerk
#. NodeID = 5096e1ec-4c78-f8ca-e1d9-ff1a922de234
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Dead:5096e1ec-4c78-f8ca-e1d9-ff1a922de234
msgctxt "h34db8b31gf91cg4b5egafdagbe4554003e14"
msgid "Hostages... the Absolute wants... <i>hostages</i>..."
msgstr "인질... 절대자께서... <i>인질</i>을 원하셔..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Dead
#. Speaker = Narrator
#. NodeID = 7a732b51-acd1-eeba-5db6-912e2198f879
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Dead:7a732b51-acd1-eeba-5db6-912e2198f879
msgctxt "h113ce312g85cfg4a21gbdecg747fdacac479"
msgid "*The corpse regards you lifelessly.*"
msgstr "*시체가 생기 없는 모습으로 당신을 맞이합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Dead
#. Speaker = Player
#. NodeID = 89f70d10-4200-4959-5a47-890be8b8c4f7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Dead:89f70d10-4200-4959-5a47-890be8b8c4f7
msgctxt "h869c49fegc919g4ab8g9890g240076611ccf"
msgid "Who are you?"
msgstr "너는 누구지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Dead
#. Speaker = Fezzerk
#. NodeID = 8d4bf0e6-613f-0f8d-5c16-c6ca8fdcdc36
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Dead:8d4bf0e6-613f-0f8d-5c16-c6ca8fdcdc36
msgctxt "h979f2dafg4e27g497fg97f3g5315f3d47dff"
msgid "Urgh... <i>cold</i>..."
msgstr "어윽... <i>추워</i>..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Dead
#. Speaker = Player
#. NodeID = 98942712-a782-9fb1-e789-1bb7cbedf9b0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Dead:98942712-a782-9fb1-e789-1bb7cbedf9b0
msgctxt "h4769a791g4785g46d4g852ag2d404da25175"
msgid "Who killed you?"
msgstr "누가 너를 죽였지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Dead
#. Speaker = Fezzerk
#. NodeID = a2f9ff1a-3f37-6887-7a27-7cf2a9826f07
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Dead:a2f9ff1a-3f37-6887-7a27-7cf2a9826f07
msgctxt "h54c41d5dgcf8cg40bbgaa3ag3a0b154411df"
msgid "No... valuables... only... hostages..."
msgstr "귀중한 건... 없다... 인질만... 있지..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Dead
#. Speaker = Fezzerk
#. NodeID = a3b5d265-6a63-25ae-a5a3-35ca625f6bd9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Dead:a3b5d265-6a63-25ae-a5a3-35ca625f6bd9
msgctxt "h7c0a20ccg2473g439cga3b2gb2b568a36fb2"
msgid "Coward... attacked...  interrupted my work..."
msgstr "비겁한 놈이... 공격했어... 내 일을 방해했어..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Dead
#. Speaker = Fezzerk
#. NodeID = ad80bca7-8acd-75be-a299-3363e6bd9cc4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Dead:ad80bca7-8acd-75be-a299-3363e6bd9cc4
msgctxt "hd3b7c33agfe0bg451ega64dg290c9589f760"
msgid "The... Absolute... she... chose us..."
msgstr "절대자... 그분께서... 우리를 고르셨다..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Dead
#. Speaker = Player
