msgctxt "h017a53a7gd21ag4f6ag8ea5gfe8966ae5c78"
msgid "You chose. You die with them."
msgstr "네 선택이다. 그들과 함께 죽어라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear
#. Speaker = Narrator
