msgctxt "h1b1e5142g34b5g4191ga5e6g304d594a2c1c"
msgid "What in the <i>Nine</i> Hells is wrong with you?"
msgstr "너 도대체 <i>씨발</i> 뭐가 문제야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
