msgctxt "h96528ce4ge5dfg4670g989bg44aba33dc1b2"
msgid "*A chill runs up your spine. You feel like you're being watched.*"
msgstr "*등골이 오싹해집니다. 마치 감시당하는 기분입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_ForestIllusion_Illusioncheck
#. Speaker = Player
#. NodeID = a1193e73-d935-4eaf-b034-4348e019f142
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_ForestIllusion_Illusioncheck:a1193e73-d935-4eaf-b034-4348e019f142
msgctxt "hae7caa57g18f6g40f2g9895ge1d9c8c16497"
msgid "<i>Ignore the feeling.</i>"
msgstr "<i>느낌을 무시한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_ForestIllusion_Illusioncheck
#. Speaker = GROUP_PartyMembers
#. NodeID = a37034e4-4335-ab39-db57-50acf7ca6a8e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - SORCERER_WILDMAGIC(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_ForestIllusion_Illusioncheck:a37034e4-4335-ab39-db57-50acf7ca6a8e
msgctxt "h8aa94e0agd73ag41cega431g8050ea1e25e0"
msgid ""
"<i>Carefully probe with your magic. Is the disturbance around you, or within "
"you?</i>"
msgstr "<i>당신의 마법으로 조심스럽게 조사한다. 방해물이 당신 주변에 있을까, 아니면 당신 내부에 있을까?</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_ForestIllusion_Illusioncheck
#. Speaker = Narrator
#. NodeID = a722a6b3-63ea-f99a-f66b-6ebebd1860f5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_ForestIllusion_Event_DropIllusion = False
#.   Tag:
#.      - PLAYABLE(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_ForestIllusion_Illusioncheck:a722a6b3-63ea-f99a-f66b-6ebebd1860f5
msgctxt "hf35e4bd3gede0g485cg8f5dg0dcf16dc9f50"
msgid "*A chill runs up your spine. You feel like you're being watched.*"
msgstr "*등골이 오싹해집니다. 마치 감시당하는 기분입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_ForestIllusion_Illusioncheck
#. Speaker = Narrator
#. NodeID = d1958229-b92f-c0e0-377d-ad670de8d853
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PLAYABLE(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_ForestIllusion_Illusioncheck:d1958229-b92f-c0e0-377d-ad670de8d853
msgctxt "he58ca03dge4efg4b2egb596g96691d2d5e17"
msgid ""
"*You blink and the wilderness changes. A swamp, stinking and insidious, "
"assaults your senses.*"
msgstr "*당신이 눈을 깜빡이자 황야의 모습이 바뀝니다. 늪에서는 악취가 서서히 퍼지며 당신의 감각을 자극합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_ForestIllusion_Illusioncheck
#. Speaker = GROUP_PartyMembers
#. NodeID = f39dfbb1-59be-b38c-ffd5-dc97d629450a
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 15
#. TagRule: WIZARD
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_ForestIllusion_Illusioncheck:f39dfbb1-59be-b38c-ffd5-dc97d629450a
msgctxt "h4d747a70g1fefg4324g91e9gc013555b872c"
msgid "<i>Search for signs of magical interference.</i>"
msgstr "<i>마법적 간섭의 징후를 찾는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_ForestIllusion_Illusioncheck
#. Speaker = GROUP_PartyMembers
#. NodeID = f39dfbb1-59be-b38c-ffd5-dc97d629450a
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 15
#. TagRule: SORCERER and !SORCERER_WILDMAGIC
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_ForestIllusion_Illusioncheck:f39dfbb1-59be-b38c-ffd5-dc97d629450a
msgctxt "h5a5fb408geb5ag426cg829cg956750c4cff9"
msgid "<i>Attune your magic to find any disturbance.</i>"
msgstr "<i>마법을 조율하여 모든 방해물을 찾아낸다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_ForestIllusion_Illusioncheck
#. Speaker = GROUP_PartyMembers
#. NodeID = f39dfbb1-59be-b38c-ffd5-dc97d629450a
#. HandlePath = TaggedText[2].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 15
#. TagRule: WARLOCK
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_ForestIllusion_Illusioncheck:f39dfbb1-59be-b38c-ffd5-dc97d629450a
msgctxt "h51ee5469g1567g4135ga8edg250a34bb29a9"
msgid "<i>Draw on your pact to empower your sight.</i>"
msgstr "<i>계약의 힘으로 시야를 강화한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_ForestIllusion_Illusioncheck
#. Speaker = GROUP_PartyMembers
#. NodeID = f39dfbb1-59be-b38c-ffd5-dc97d629450a
#. HandlePath = TaggedText[3].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 15
#. TagRule: CLERIC_MYSTRA
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_ForestIllusion_Illusioncheck:f39dfbb1-59be-b38c-ffd5-dc97d629450a
msgctxt "h791561ebge44ag4fdeg98b4g52175a4a1a78"
msgid "<i>Search for any disruption in the Weave.</i>"
msgstr "<i>위브를 방해하는 것을 찾는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 04533fbb-de3f-78d3-6ad9-e159a8c011ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:04533fbb-de3f-78d3-6ad9-e159a8c011ae
msgctxt "hee3347b9g0c34g427dga8d3ge38d733ed3cc"
msgid ""
"Ah, well. If you had, I could not fault you for lying - his kind have charm "
"beyond our mortal means to resist."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 0631e944-9768-06fd-6a42-a03a51d0e46b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:0631e944-9768-06fd-6a42-a03a51d0e46b
msgctxt "hccee5cf3g4704g42d2ga6cfg89efeb018ce0"
msgid ""
"But she thrives on suffering. Once she hears what awaits my quarry when I "
"catch him, she will help."
msgstr ""
"하지만 그녀는 고통을 통해 번영하지. 내가 먹이를 잡았을 때 그에게 무슨 일이 닥칠지 그녀에게 말해 주면, 그녀가 도와줄 것이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = 0b821415-6100-24d2-14be-b8d56b4adbe9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:0b821415-6100-24d2-14be-b8d56b4adbe9
msgctxt "h0dd1b0d9gce78g492fgbc63g7cccebb6aa45"
msgid "I can handle it."
msgstr "난 괜찮아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = 0cef93c2-638f-cc0a-b97c-37be74e01d67
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:0cef93c2-638f-cc0a-b97c-37be74e01d67
msgctxt "h73e7e83fg6529g4de7gaa0eg482f829fe653"
msgid "It's my pleasure. Really."
msgstr "저에게 기쁜 일이죠. 진정으로요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 0e7ec5cf-8664-ceb1-4936-82b1af7f0219
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:0e7ec5cf-8664-ceb1-4936-82b1af7f0219
msgctxt "h03c0ecd5g32d2g4ddagbe60gb2163db86ae3"
msgid ""
"Of course - as the spider invites the fly. You need something, I expect. And "
"she sensed it."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 0ec77fd6-c467-d104-fe52-37021e2cef5c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:0ec77fd6-c467-d104-fe52-37021e2cef5c
msgctxt "h71903aa9g85f9g4cd7g977fg866836b3937f"
msgid ""
"You're wise to walk away. But I cannot - the thing I hunt has gone to "
"ground. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 11fc94c9-a06e-eb07-8958-60faf2c3c4c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:11fc94c9-a06e-eb07-8958-60faf2c3c4c0
msgctxt "hdf62bba4g4c39g4a3cg9b61gae2fc7ed87ae"
msgid "Truly? Then you know what she is - what she can do. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 1349922d-2be9-b022-2c6b-921a52a3be56
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:1349922d-2be9-b022-2c6b-921a52a3be56
msgctxt "h9ae11900gb9cdg4a59g9f4fg99b9d09f84de"
msgid "I do not think that I will."
msgstr "그럴 생각은 없소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = 1466b33f-ba48-604a-89d3-84b45dd50853
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:1466b33f-ba48-604a-89d3-84b45dd50853
msgctxt "h6441e6ffgb45ag4dfaga3e7g4dd3afb13a05"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 177390f0-365d-adf0-d660-873e0700970c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:177390f0-365d-adf0-d660-873e0700970c
msgctxt "h2bb0e519g7c85g412eg96b0gb567de1096d9"
msgid ""
"Today? The same as you - a humble supplicant, come to bargain with the lady "
"of this house."
msgstr "오늘 말인가? 당신과 같이 초라한 탄원자요. 이 집의 숙녀와 거래 하러 왔지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 19733e43-f362-2c65-eaa5-21a4693b325d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:19733e43-f362-2c65-eaa5-21a4693b325d
#, fuzzy
msgctxt "h8c02fac6g6eb9g434fg867fg9a635e5b1258"
msgid ""
"I bid you fair fortune on the road. Though you seem the type to make your "
"own."
msgstr "알아서 잘 헤쳐나갈 사람처럼 보이지만, 그대 가는 길에 행운이 있길 바라오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 1b16e43a-6475-4803-2eab-d9671b0d194f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:1b16e43a-6475-4803-2eab-d9671b0d194f
msgctxt "h9aab6070g779fg4f0eg9ff1gafff739f29a7"
msgid ""
"Know how to ask, and they'll share that knowledge. <i>If </i>you're fool "
"enough to pay their price."
msgstr "요청하는 법을 알면, 그들도 그 지식을 공유할 것이오. <i>만약 </i>당신이 대가를 지불할 만큼 어리석다면 말이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = 1bc3f64a-b99e-9137-c7b7-2dc0fb6b24ed
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAG_Hag_HasMet_Teahouse(1) = True
#.   Global:
#.      - HAG_Hagspawn_State_MadeDeal = False
#.      - HAG_Hag_State_HagDefeated = False
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:1bc3f64a-b99e-9137-c7b7-2dc0fb6b24ed
msgctxt "ha61b026cg90f2g46e7g92ebg047341bc9021"
msgid "She made me an offer - but I refused."
msgstr "거래를 제안 받았지만, 거절했어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 1becc90e-37ee-4c4c-3cf1-bb6e71a915ba
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAG_GurHunter_Astarion_Knows_GurPlan = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:1becc90e-37ee-4c4c-3cf1-bb6e71a915ba
msgctxt "h4a103841gf37fg4b8eg8fabg2f90b2f0fe54"
msgid "Baldur's Gate. My people wait for me there."
msgstr "발더스 게이트요. 내 부족이 그곳에서 나를 기다리고 있소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 1d9679e1-d8e8-5c8e-3129-3d8ecb46b31c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:1d9679e1-d8e8-5c8e-3129-3d8ecb46b31c
msgctxt "h39b17a16g1457g4aaag8199gee9fcecbe505"
msgid "A just choice."
msgstr "옳은 선택을 했소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = 1f6092a3-20de-00ce-703b-7760f40329ed
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_Hagspawn_State_MadeDeal = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:1f6092a3-20de-00ce-703b-7760f40329ed
msgctxt "h80e9e800g7374g4d4dg8963g0ccf075ffe84"
msgid "So I learned."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = 224ebbf0-395f-9c6f-4bfa-e3d1899a3a0a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_Hagspawn_State_MadeDeal = True
#.      - HAG_Hag_State_HagDefeated = False
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:224ebbf0-395f-9c6f-4bfa-e3d1899a3a0a
msgctxt "hd72e37bfg5272g4cd7gabd5g369b2f7ab845"
msgid "And if I did?"
msgstr "그랬다면?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = 22ae7bc3-3962-9d2c-9422-8ec000f04998
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:22ae7bc3-3962-9d2c-9422-8ec000f04998
msgctxt "h07633f0bg12ecg4949g97bbg2a811627a317"
msgid "What's it to you?"
msgstr "당신과 무슨 상관이지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 25c2e2af-b79a-22b5-bef4-3cdac07e9813
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:25c2e2af-b79a-22b5-bef4-3cdac07e9813
#, fuzzy
msgctxt "h387ac84bg1d2eg4193g8702gd9ec5f385f69"
msgid ""
"So instead: know you're outmatched. Know what you're willing to give. And "
"<i>mind your manners</i>."
msgstr ""
"그러니 대신, 당신이 한 수 아래라는 것을 명심하고, 당신이 무엇을 내줄 수 있는지를 파악하시오. 그리고 <i>당신의 예의에 "
"주의하시오.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 25da3ca3-bc87-4e35-8d7f-e2c9a77e4e80
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:25da3ca3-bc87-4e35-8d7f-e2c9a77e4e80
#, fuzzy
msgctxt "heb189ba5gcfc8g4940ga0aagf37712d45793"
msgid ""
"A more innocent name than some I could call her. But it is what she <i>is</"
"i> that ought to concern you."
msgstr "내가 부를 수 있는 그 어떤 이름보다 순수한 이름이지. 하지만 그 여자의 <i>정체</i>는 당신과도 상관이 있소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = 2651a49b-4dc2-1800-bbf5-85a5d73cd687
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAG_GurHunter_AskedAboutPrey(1) = False
#. SetFlags:
#.   Dialog:
#.     - HAG_GurHunter_AskedAboutPrey(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:2651a49b-4dc2-1800-bbf5-85a5d73cd687
msgctxt "h4f5ad907gad52g4c16gb2bdgd53de2dc0c20"
msgid "Who is it you're hunting?"
msgstr "누구를 쫓고 있죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = 2a29c5c5-728b-237c-723a-17ff69ff0312
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:2a29c5c5-728b-237c-723a-17ff69ff0312
msgctxt "hd9a7f11ag2cdeg469fgaf6bgcc744f89c2e4"
msgid "Maybe I can help with your hunt."
msgstr "당신의 사냥을 도와줄 수 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 2d51fb2d-87ea-eed4-0ee0-1cbdc11cdb1e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:2d51fb2d-87ea-eed4-0ee0-1cbdc11cdb1e
msgctxt "h49870417gddc7g4974g8342gb5c8a514e21d"
msgid ""
"But I'm not wrong. Take her lightly, and she'll serve up your eyes for "
"appetisers."
msgstr "하지만 내 말은 틀리지 않소. 그녀를 가볍게 여기면, 그녀가 그대의 눈을 간식으로 만들어서 식사를 차릴 것이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 3015eb10-4038-941f-5025-386b01c47880
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:3015eb10-4038-941f-5025-386b01c47880
msgctxt "ha5e087adg6cbag4cfcg8960g06ee71d73b29"
msgid ""
"I'll eat them, too. I need her knowledge - the thing I hunt has gone to "
"ground."
msgstr "나도 그런 걸 먹어야 하오. 그녀의 지식이 필요해서요. 내가 쫓고 있는 것이 숨어버렸소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 3136c7d9-9771-9f8d-2587-e833bb4dce26
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:3136c7d9-9771-9f8d-2587-e833bb4dce26
msgctxt "h7649304fg59a1g4fc8g999dgc10b5e3db65c"
msgid ""
"You would be wise to look past the seeming of things, if you intend to "
"bargain with the lady of this house."
msgstr "이 집의 숙녀와 거래를 하려면, 겉보기로만 판단하지 않는 것이 현명할 것이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = 33ae2031-8743-fe87-f412-209a62555d7d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:33ae2031-8743-fe87-f412-209a62555d7d
msgctxt "hb4d548c3gd411g43b7gad21g4adc61439640"
msgid ""
"We share a profession, it seems. I'm Wyll - better known as the Blade of "
"Frontiers."
msgstr "보아하니 저랑 하는 일이 비슷하군요. 저는 윌입니다. 변경의 칼날로 알려져 있죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = 33c6faaa-0c03-54bb-c287-4a8bf57decfe
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 20
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:33c6faaa-0c03-54bb-c287-4a8bf57decfe
msgctxt "hd9beb24bg78aag4382g833eg94e4a29c726f"
msgid "Your coyness is getting boring. Tell me."
msgstr "당신의 점잔빼는 태도가 갈수록 질린다. 그냥 말해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 35ae09ed-4a47-d92b-5dfd-bcc45905dfb7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:35ae09ed-4a47-d92b-5dfd-bcc45905dfb7
msgctxt "h669541f8gaa02g47acg8172g143951220666"
msgid ""
"Selûne's light go with you. I fear you will need it to face what is coming."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = 3664c127-7efc-43a1-28ed-09ce472c436f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - HAG_ForestIllusion_State_DroppedIllusion(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:3664c127-7efc-43a1-28ed-09ce472c436f
msgctxt "h2d2b8a62g3843g4f82gb69bg91395c9e31d9"
msgid "There's enough deception in this place - don't add to it."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 374d829e-2326-8b57-bbb2-f6cae39f41a8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_Hag_State_HagDefeated = True
#. SetFlags:
#.   Object:
#.     - HAG_GurHunter_DisappearOutOfSight(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:374d829e-2326-8b57-bbb2-f6cae39f41a8
msgctxt "h6c7b09edgf5b4g45d5gb44ag41c52ca4e9a2"
msgid ""
"A wise decision. I will do my work - and for what it is worth, I will take "
"no pleasure in it."
msgstr "현명한 결정이오. 나는 가치 있는 것을 위해 내 일을 하겠소. 이 일에 기쁨을 느끼지는 않을 것이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 387b4517-e402-173b-638a-8e59bd0cfd7a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:387b4517-e402-173b-638a-8e59bd0cfd7a
msgctxt "h7b5b61e7gb004g48dbg8c2cg88f8e6e6f8c5"
msgid "I would not be so sure. But I won't keep the truth from you."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 39cd4287-9ffa-93da-5c26-71227e4fe737
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:39cd4287-9ffa-93da-5c26-71227e4fe737
msgctxt "h4e7e6119gf280g4dadgb751g5d63ecc10968"
msgid "Ah - so you did. I thought you were just squinting from the stink."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 3ade5107-bc0e-8104-d002-3de7aa3bfad3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:3ade5107-bc0e-8104-d002-3de7aa3bfad3
msgctxt "h53e12c93g75a9g4fcbg8a1dgc442633856dd"
msgid ""
"If captured, my people <i>will </i>make him talk. So I ask again: is he "
"known to you?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 3f4f0420-d732-e0f8-3e72-ae21b576ac5b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:3f4f0420-d732-e0f8-3e72-ae21b576ac5b
#, fuzzy
msgctxt "hf1a998bbge6a9g48aegacc8gfd014d5da16f"
msgid ""
"Strong words may frighten others, my friend, but it takes much more to scare "
"those in my line of work."
msgstr "이 친구야, 나같은 사냥꾼을 내쫓으려면 더 나은 것이 필요할 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 403da8c1-63f1-b43b-16fe-558b53d7e715
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:403da8c1-63f1-b43b-16fe-558b53d7e715
msgctxt "h656e954ag57d3g499ag8d70g662943ca07e0"
msgid "It's amazing you survived, travelling with a beast like that."
msgstr "이런 짐승 같은 녀석과 다니면서 지금까지 살아남은 게 놀랍소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 409b8057-f22c-1e1e-05b2-8f54324355a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:409b8057-f22c-1e1e-05b2-8f54324355a3
msgctxt "h76ace423g07d2g4d2eg911ag03f8a86c26aa"
msgid ""
"I thank you for your help. My people work to rid this world of evil - you "
"are a friend to our cause."
msgstr "당신의 도움에 감사드리오. 내 부족은 이 세상에서 악을 제거하기 위해 노력하고 있소. 당신은 우리 대의의 동반자요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = 435502b9-d440-6604-0e89-85e4c8af3811
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Astarion_HasMet = True
#.      - ORI_Astarion_State_Dead = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:435502b9-d440-6604-0e89-85e4c8af3811
msgctxt "hec9277bag8636g4b60g87d4gbbdd809675d2"
msgid "You're wasting your time. Astarion's been dealt with."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 44d396f2-54ed-c397-4e34-b403d0362daf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:44d396f2-54ed-c397-4e34-b403d0362daf
msgctxt "h932327f9g90cdg4b32gae66g170ad4b10d3c"
msgid ""
"So you <i>have</i> met him. His kind have charm beyond our mortal means to "
"resist."
msgstr "그를 만난 <i>적 있다</i>는 말이군. 그의 종족은 우리 필멸자가 거부할 수 없는 매력을 지니고 있소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 46b4329d-6ad9-0731-92a4-04f476976020
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAG_GurHunter_State_Hostile = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:46b4329d-6ad9-0731-92a4-04f476976020
msgctxt "h3ff3fb4bg56c4g452ag9adfg4ac14d125d56"
msgid "There, I'm afraid you're wrong."
msgstr "안타깝게도, 당신 추측은 틀렸소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 48219eee-8b4a-5814-1594-647367bca7f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:48219eee-8b4a-5814-1594-647367bca7f1
msgctxt "h564cfe6dgc798g48edg9825gb9dcf7c0260c"
msgid ""
"They'll stop plotting to kill one another just long enough to focus all that "
"energy on you, instead."
msgstr "해그들은 모든 힘을 총동원해 당신을 쫓을 것이오. 보통은 자기들끼리 죽이려 드는 사이지만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = 49ed3e08-5a27-237a-f116-d4e3ec9fc549
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Hag_Knows_HagIsHag = False
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:49ed3e08-5a27-237a-f116-d4e3ec9fc549
msgctxt "h4423e322g4ca0g4de8g8db2ga1960451f67c"
msgid "Speak plainly. What is she?"
msgstr "분명히 말하십시오. 그 여자는 뭐죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 4b6ec339-e3a2-8f2a-57f4-fd48c2ce5473
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:4b6ec339-e3a2-8f2a-57f4-fd48c2ce5473
msgctxt "hd77bd0e3g5b0cg423bgaae3g8a43fd54cd66"
msgid "So said the fish 'round the hook in its mouth."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 4bf6269e-32d9-9cf7-0c84-b19444a71f81
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_Hag_State_HagDefeated = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:4bf6269e-32d9-9cf7-0c84-b19444a71f81
msgctxt "hae431a58g080ag4901gb8a8g3387a84a3797"
msgid ""
"You've done your part in dealing with the hag. Now, my own hunt must "
"continue."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 4c5124ce-f936-7e5a-604d-a46480737eb9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:4c5124ce-f936-7e5a-604d-a46480737eb9
msgctxt "h0233bc06gf948g45c9g8386g78bbcc4cd1bb"
msgid "It isn't possible."
msgstr "믿을 수 없군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 4cc4707d-ab27-9ad6-ddbb-9c54d2bd7916
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_Hag_State_HagDefeated = False
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:4cc4707d-ab27-9ad6-ddbb-9c54d2bd7916
msgctxt "hce5bad70gf17cg4265gb31fg2b075751b46a"
msgid ""
"But best to take one terror at a time, hm? I've used enough of your time - "
"the lady awaits."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 4f730977-33bc-5939-af7c-afc2c5b88fc1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:4f730977-33bc-5939-af7c-afc2c5b88fc1
msgctxt "h07996ddagab61g4b2egb0b4gb3d7dae7dbbd"
msgid ""
"But you're right - he's no true vampire. Not yet. I don't suppose you'll "
"tell me where he is?"
msgstr "하지만 당신의 말이 맞소. 그는 진정한 뱀파이어는 아니오. 아직은. 그가 어디 있는지 말해줄 수 있겠소?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = 50587539-fbdf-4d85-0bfc-b3230f8313ae
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_Hag_State_IsDead = False
#.      - HAG_Hag_State_HagDefeated = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:50587539-fbdf-4d85-0bfc-b3230f8313ae
msgctxt "h37d1c76bg9448g447bg9ae3g7cb166969540"
msgid "I did - but I let her keep her life."
msgstr "맞아요, 하지만 목숨은 부지하게 해줬습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = 51cf6855-5dcd-70cb-8bb9-959e9e29196b
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 20
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:51cf6855-5dcd-70cb-8bb9-959e9e29196b
msgctxt "h856fdf7dg74c7g401bgac0cg8a1be43036f9"
msgid "I like danger. The truth - <b>now</b>."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = 528e7a85-cdc9-133f-5610-f15dcf5e173c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAG_GurHunter_AskedAboutPrey(1) = False
#.   Tag:
#.      - PALADIN(1) = True
#. SetFlags:
#.   Dialog:
#.     - HAG_GurHunter_AskedAboutPrey(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:528e7a85-cdc9-133f-5610-f15dcf5e173c
msgctxt "h8e365d31gddb1g480cgad6fgfd7dbc718e77"
msgid ""
"I'd advise against helping such a creature <i>thrive</i>. What quarry could "
"be worth that price?"
msgstr "그런 생물이 <i>번영</i>하는 것을 돕지 않기를 조언하오. 어떤 사냥감이길래 그만한 가치가 있는 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 5290386e-1899-aeeb-8a1c-6db8e066def8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:5290386e-1899-aeeb-8a1c-6db8e066def8
msgctxt "h73e239bag25cdg4aa3ga1f7g8f152600aec3"
msgid ""
"If she can tell me how to flush him out, I'll pay whatever price she asks."
msgstr "그놈을 제거하는 방법을 그녀가 알려줄 수 있다면, 나는 그녀가 무슨 대가를 요구하든 지불할 것이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 52a93228-76d4-9d5c-9ed1-7c669de0cf42
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:52a93228-76d4-9d5c-9ed1-7c669de0cf42
msgctxt "h096397ebge33fg4980ga889g2fc12b6e2b58"
msgid ""
"I'll return him to my tribe, as ordered. Whatever fate awaits him there, I'm "
"sure it is deserved."
msgstr "명령받은 대로, 그를 우리 부족으로 데려갈 것이오. 그곳에서 무슨 운명이 그를 기다리고 있든, 나는 그것이 마땅하다고 확신하오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = 5330fef5-475c-19e2-d67e-80a12eb6b55e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_HagTrader_State_AgreeMeetTeahouse(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:5330fef5-475c-19e2-d67e-80a12eb6b55e
msgctxt "ha8197f20gab5cg4c07gbf23g32a2b5c72125"
msgid "Not at all. I was invited for tea."
msgstr "아뇨. 차 한 잔 하자고 초대받았어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = 5416b995-fcdc-a1e8-3a79-919df823fceb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:5416b995-fcdc-a1e8-3a79-919df823fceb
msgctxt "h6c44da84gf34fg4584ga01cga2822ac735bd"
msgid "And are you fool enough?"
msgstr "당신은 그만큼 멍청한가요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 550553de-a52b-6e26-7d53-9c7a584cd8a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:550553de-a52b-6e26-7d53-9c7a584cd8a5
msgctxt "hdfd1f5a0g2a3bg42feg8ef7g98e3e9cd168b"
msgid "Whatever's easiest to lose and hardest to do without."
msgstr "가장 잃기 쉽고, 없으면 가장 힘든 것이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = 574d46ae-a618-25f0-30de-e7da25cde5b7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAG_Hag_HasMet_Teahouse(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:574d46ae-a618-25f0-30de-e7da25cde5b7
msgctxt "h4b5c8fb3g0522g4689g8c87g8561fa616861"
msgid "Any advice on how to deal with her?"
msgstr "그녀를 어떻게 대해야 할지 조언해줄 수 있습니까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = 5827afd8-9484-544b-f490-7a4c2843b467
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:5827afd8-9484-544b-f490-7a4c2843b467
msgctxt "h01a3a7dfgda96g425agbd45ge9a0df268953"
msgid "You're a monster hunter? Not what I imagined."
msgstr "당신이 괴물 사냥꾼입니까? 제가 생각한 것과는 다르군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 58ce261b-1349-017b-54f2-3334fba0fbfe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:58ce261b-1349-017b-54f2-3334fba0fbfe
msgctxt "h790e3ca5gda37g45cbga73dg4b432311707b"
msgid ""
"I can show you who he truly is - if you will just tell me where to find him."
msgstr "당신이 그가 어디있는지 알려주기만 하면, 내가 그의 진상을 보여줄 수 있소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 5c3bc02a-9395-dac2-e1aa-e0f5acb693ef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:5c3bc02a-9395-dac2-e1aa-e0f5acb693ef
msgctxt "h6b2c00d2g4537g4a9cgbdaeg2fe621ff69f5"
msgid ""
"Or just as easily find it pressed against our throat. I would not put you in "
"danger."
msgstr "혹은 그 진실이 목을 꿰뚫는 것을 쉽게 경험할 수도 있소. 나는 당신까지 위험에 빠뜨리고 싶지 않소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 5ff90eef-a05e-8ba1-385c-c691216f8be9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:5ff90eef-a05e-8ba1-385c-c691216f8be9
msgctxt "h5d56d588g5dc7g48d9g969fg5f428da6df1d"
msgid ""
"The thing I hunt has eluded me too long. The hag can have what she wants, so "
"long as she helps me find him first."
msgstr "추적하던 사냥감이 내 손에서 몇 번이고 빠져나갔소. 해그가 사냥감을 찾아주기만 한다면 무엇이든 줄 것이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = 61480576-ef44-bf84-bbdb-fa85c2bc243b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAG_Hag_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:61480576-ef44-bf84-bbdb-fa85c2bc243b
msgctxt "h744260ecgb4fdg4d94g96ccgb3b7ea1c9d9e"
msgid "Are you talking about Auntie Ethel?"
msgstr "에텔 이모를 말하는 건가요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 62490f8d-2593-73be-c9bf-61f8f35a1dd4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:62490f8d-2593-73be-c9bf-61f8f35a1dd4
msgctxt "h8ce62d73gfbccg4a26g91e8g1fb1bd90c9d5"
msgid "I suggest you find yours before dealing with the lady of this house."
msgstr "이 집의 숙녀를 대하기 전에 당신의 예절을 인식하는 것을 추천하오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 63f72394-d30e-4a1d-c0cb-3daa1189ced5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_Hag_State_HagDefeated = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:63f72394-d30e-4a1d-c0cb-3daa1189ced5
msgctxt "hfb0f9029g92a8g4375ga10ega078bc9c461f"
msgid "You made a fine kill today, my friend - content yourself with that."
msgstr "친구여, 오늘 이미 멋진 사냥을 했으니 그걸로 만족하시오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = 6433cf07-496a-e117-b4bb-64c28f2d26cb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Origin_PartOfTheTeam_Astarion = True
#. SetFlags:
#.   Global:
#.     - HAG_GurHunter_Knows_CampLocation = True
#.   Object:
#.     - HAG_GurHunter_Event_RevealedCampLocation(1) = True
#.   Quest:
#.     - ORI_COM_Astarion.MetGur_ToldCampLocation(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:6433cf07-496a-e117-b4bb-64c28f2d26cb
msgctxt "he0665ccfg0633g46c5gaf1fg6c0b21a74a50"
msgid "<i>Tell him how to find your camp.</i>"
msgstr "<i>그에게 자신의 야영지를 어떻게 찾을 수 있는지 말한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = 65f8d946-e5ee-8363-953c-dc4bdbe26780
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:65f8d946-e5ee-8363-953c-dc4bdbe26780
msgctxt "hd195106fg0a7eg4426g8da0g12a921a4e74f"
msgid "Come now - I've almost certainly killed worse."
msgstr "괜찮아요, 전 훨씬 더 한 놈들도 죽여봤는데요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 660e59a9-d2f1-fcd1-f9e6-613ce03c80a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:660e59a9-d2f1-fcd1-f9e6-613ce03c80a3
#, fuzzy
msgctxt "h098e7817g52c3g4e54g9b12gc8f805ba604e"
msgid ""
"...As you say. Then I must redouble my efforts, and pray my delay costs no "
"more lives."
msgstr ""
"... 그렇게 말한다면야. 그럼 나는 더 많은 노력을 기울여야겠군. 그리고 내 일이 지체돼서 더 많은 목숨이 희생되지 않기를 기도해야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Narrator
#. NodeID = 662afb0c-46af-160d-7300-30e8bde7f15b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:662afb0c-46af-160d-7300-30e8bde7f15b
msgctxt "h7b16908ag55afg4e34gbe3fg47bc11d6341c"
msgid "*You catch a waft of something foul - metallic and sickly-sweet.*"
msgstr "*악취가 당신의 코를 찌릅니다. 금속성이며 역겹도록 달콤한 냄새입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 67ea37c8-e5bf-1128-83c4-a9019a334bd1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:67ea37c8-e5bf-1128-83c4-a9019a334bd1
msgctxt "hf84d231ag511bg4e4dg90degbfe703f2227b"
msgid ""
"No. This duty is mine alone. But for such an offer, an answer at least is "
"owed."
msgstr "아니. 이 의무는 나 혼자만의 것이오. 그렇지만 이런 제안을 해주니, 최소한 대답으로 보답해야겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = 67f1947a-1ab7-c258-0154-c281e044dce6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - HAG_GurHunter_Event_DidNotRevealCampLocation(1) = True
#.   Quest:
#.     - ORI_COM_Astarion.MetGur_DidNotToldCampLocation(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:67f1947a-1ab7-c258-0154-c281e044dce6
msgctxt "h7206ef65ga83cg45d2gadd6g25c70fd67aae"
msgid "I honestly don't know where he is."
msgstr "솔직히 그가 어디 있는지 나도 모릅니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = 6918ddfa-3b2f-6db1-48cf-e4094bebead8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_Hag_State_IsDead = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:6918ddfa-3b2f-6db1-48cf-e4094bebead8
msgctxt "h9e68e1degbd94g4b63gb854g01687d999ff3"
msgid "I have. She didn't survive the encounter."
msgstr "만났습니다. 그녀는 날 만나고 살아남지 못했지만요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 6a6e8a8d-095d-f941-f684-a4ed9640383a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:6a6e8a8d-095d-f941-f684-a4ed9640383a
msgctxt "h3651fdf8g68feg4372g8261g754db53f3cf2"
msgid ""
"A kind offer - but to accept it would be no kindness at all, I assure you."
msgstr "감사한 제안이지만, 마냥 좋게 수락할 수 있는 사안이 아니오. 진심일세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = 6b228f2a-8aff-f13c-2981-2362c59c0cac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:6b228f2a-8aff-f13c-2981-2362c59c0cac
msgctxt "h99125a34ge390g46d9g8079ga723c2ca8314"
msgid "I prefer a weapon to a stench, thanks."
msgstr "고맙지만, 저는 악취보단 무기를 더 선호합니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Astarion
#. NodeID = 6d2aa19d-0f88-f3d1-2344-efd7f5cb7771
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:6d2aa19d-0f88-f3d1-2344-efd7f5cb7771
msgctxt "h9d4261b6g287bg422aga034g23e6b8856547"
msgid "You treacherous little worm!"
msgstr "이 약아빠진 벌레 새끼가!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 6de902f0-e44c-2111-f541-2aa66442db20
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:6de902f0-e44c-2111-f541-2aa66442db20
msgctxt "hb83db5c5ga22cg4000ga77fgbf11ca6d3b1d"
msgid ""
"Perhaps you could tell me where to look, and I could ensure peace of mind "
"for us both?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = 6e2cc2f8-6327-aad8-02d4-058b41daec4c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:6e2cc2f8-6327-aad8-02d4-058b41daec4c
msgctxt "ha868205cg4ff2g40cag8114g70309711b029"
msgid "Whatever you're hunting, your stench alone will kill it."
msgstr "당신이 무엇을 쫓고 있든, 당신 악취만으로도 죽일 수 있겠군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = 6f11df5d-8a02-c352-aad0-6c0aed5e8d6b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:6f11df5d-8a02-c352-aad0-6c0aed5e8d6b
msgctxt "hddf24c68g20ffg4717g9afcg559097b6a388"
msgid "I'd like to trade."
msgstr "거래를 하고 싶군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 717d7dd9-822e-705e-38d8-4c2d61103f9d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:717d7dd9-822e-705e-38d8-4c2d61103f9d
msgctxt "hceb6eea5g5260g4667gad57g796c37713f22"
msgid "May your road be kind."
msgstr "당신의 길이 순탄하길."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 7361af61-8b97-5d2f-9270-79b8cd9202f2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:7361af61-8b97-5d2f-9270-79b8cd9202f2
msgctxt "hf3655470g0717g4608g9ff4gfaa3557bcaba"
msgid ""
"Powdered iron-vine. Most monsters will think twice before making a meal of "
"me."
msgstr "철가시 덩굴 분말을 발랐지. 대부분의 괴물이 나를 먹잇감으로 삼기를 꺼리게 된다오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = 75c501e8-f14e-50fe-345a-5215a96b41f9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Origin_PartOfTheTeam_Astarion = True
#.      - ORI_Astarion_HasMet = True
#.      - ORI_Astarion_State_Dead = False
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:75c501e8-f14e-50fe-345a-5215a96b41f9
msgctxt "h9d17e639g891eg402fg8923gcb72cae82cf6"
msgid "You can give up your hunt. Astarion's under my protection."
msgstr "당신은 사냥을 포기하는 게 좋을 겁니다. 아스타리온은 내 보호를 받고 있으니까요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = 763a1d9f-4472-01d6-f8a3-421641008f8b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Astarion_HasMet = True
#.      - ORI_Astarion_State_Dead = False
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:763a1d9f-4472-01d6-f8a3-421641008f8b
msgctxt "hdb8fdcd4g06a3g48a7gbef2gde447e4674ff"
msgid "We've met - he's not the type to come quietly."
msgstr "그를 만난 적 있습니다. 조용히 따라올 성격은 아닙니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 779207fd-1b21-9213-f59c-4695c01c01dd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:779207fd-1b21-9213-f59c-4695c01c01dd
msgctxt "ha8a925d8geccag4444gb518g24d26d634754"
msgid ""
"I hope this Ethel is waiting for you when you walk through that door. But I "
"suspect you'll find something else."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 77eadaa6-e0de-a222-038f-8123479f1970
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:77eadaa6-e0de-a222-038f-8123479f1970
msgctxt "h560c2f66g5466g4a09g89fcg229575c489a0"
msgid ""
"My people were recently attacked in the night - our camp set upon by a band "
"of vampire spawn."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = 77f96395-e960-75f8-7c5c-b3a4f0d245ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:77f96395-e960-75f8-7c5c-b3a4f0d245ae
msgctxt "h182b65d1gc303g4bacga1f9g86ca2fe14d15"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 78aa7684-c38e-8c28-6d4d-149149563880
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:78aa7684-c38e-8c28-6d4d-149149563880
msgctxt "h5ed9db8fga009g48d8g86bfgcd8480830886"
msgid ""
"Her kind have hidden among us since the first darkness - and their knowledge "
"is matched only by their spite."
msgstr "그녀의 종족은 최초의 암흑기부터 우리 사이에 숨어 있었고, 그들의 지식은 오직 그들의 악의를 위해서만 쓰인다오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 799f8fb9-67c0-2d4d-996c-6389e2cf2523
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:799f8fb9-67c0-2d4d-996c-6389e2cf2523
msgctxt "h9d193755gc125g4de8gb42fg4f51b62981ec"
msgid ""
"We believe this Astarion knows exactly what happened that night, and where "
"to find our little ones."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 79d9fd82-499c-3149-e5f2-2911cff3cd5c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAG_GurHunter_AskedAboutPrey(1) = True
#.      - HAG_Hag_HasMet_Teahouse(1) = False
#.   Object:
#.      - HAG_GurHunter_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:79d9fd82-499c-3149-e5f2-2911cff3cd5c
msgctxt "hcb0402eag8291g4105g9cdbgd36c4432e678"
msgid "Go ahead. The lady of the house awaits."
msgstr "말하게. 이 집의 숙녀가 기다린다네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 7b39cc77-5155-735a-0b5d-79a43f6350f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:7b39cc77-5155-735a-0b5d-79a43f6350f8
msgctxt "h3ec20bfag628cg449dgb392gb9c37aa7fb63"
msgid "Perhaps I was... hasty with my words. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 7b511e1f-3f14-048e-81ca-b43c82600d48
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:7b511e1f-3f14-048e-81ca-b43c82600d48
msgctxt "h4ff37ef3ga75ag4a16g89ffgf49d00688280"
msgid "A gentle name. But I speak of her <i>nature</i>."
msgstr "부드러운 이름이군. 그러나 그녀의 <i>본성</i>을 말하는 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = 7bc87f1a-1983-b5bf-6a81-722a6fea4efe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAG_GurHunter_AskedAboutPrey(1) = True
#.   Global:
#.      - HAG_GurHunter_State_MentionedAstarion = True
#.      - ORI_Astarion_Knows_Vampireness = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:7bc87f1a-1983-b5bf-6a81-722a6fea4efe
msgctxt "h1c1e1c13gf570g4ca5g8cb2gd9623ce0048d"
msgid ""
"The thing you hunt - it's my companion, Astarion. I didn't know what he was."
msgstr "당신이 쫓는 자, 아스타리온은 제 동료입니다. 그의 정체를 전혀 몰랐어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 7bde29d7-081b-cf32-f4e3-07f764b75109
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_Hag_State_IsDead = True
#. SetFlags:
#.   Object:
#.     - HAG_GurHunter_Event_HandedAstarionOver(1) = True
#.     - GLO_Companion_LeaveDisappearInstantly(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:7bde29d7-081b-cf32-f4e3-07f764b75109
msgctxt "hf28ecbc4g288ag4c02ga146g12782e274ae8"
msgid ""
"Thank you for this. And for cleansing this swamp of the hag. You have done "
"good here today. Safe travels."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 7cdcacb0-e5a3-a23d-3086-ccda4c33533f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:7cdcacb0-e5a3-a23d-3086-ccda4c33533f
msgctxt "hdb02d4c9g7ebbg491egb899g1b199d71b8a5"
msgid "That <i>is </i>why you come to her lair, I take it? To bargain?"
msgstr "당신도 <i>거래를 하려</i> 그녀의 은신처에 찾아온 것 아니오?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = 7d6a00cb-51c6-98ef-8b25-4f5b12430d44
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Astarion_HasMet = False
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:7d6a00cb-51c6-98ef-8b25-4f5b12430d44
msgctxt "h1e11e909g5d2eg41d4g8191g633f5e664e6e"
msgid "I've never heard of him."
msgstr "그에 대해 들어본 적 없소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 7deb2a39-2198-0e97-b127-2b5623a433ac
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAG_GurHunter_State_MentionedAstarion = True
#.     - HAG_GurHunter_Event_MentionedAstarionQuestUpdate = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:7deb2a39-2198-0e97-b127-2b5623a433ac
msgctxt "h817912a6gcf1bg463dg9e14g2b7ba7cd5e15"
msgid ""
"I hunt a vampire spawn called Astarion. I'm bound to bring him back to "
"Baldur's Gate - <i>alive</i>."
msgstr "아스타리온이라는 뱀파이어 스폰을 쫓고 있고, 발더스 게이트로 데리고 돌아가야 하오. <i>살려서.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = 7f00c371-eb40-f3b0-0c08-0f56c8d3bc92
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:7f00c371-eb40-f3b0-0c08-0f56c8d3bc92
msgctxt "hdc4a5e23gd731g4d40gb472g9bf754955860"
msgid "Who are you?"
msgstr "당신은 누구죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = 7f039ea8-c6ca-9d76-7227-679eba0f43c5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:7f039ea8-c6ca-9d76-7227-679eba0f43c5
msgctxt "h9ad808f8g0c1bg478cg958ag9407eb86f255"
msgid "I've delivered a monster to a monster hunter."
msgstr "괴물 사냥꾼에게 괴물을 대령했지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 7f549611-b8a8-538a-81c1-fadf2995fda4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:7f549611-b8a8-538a-81c1-fadf2995fda4
msgctxt "h2dbe67acgc994g466eg8499ga1b83c602d46"
msgid "Honourable, but unwise. Her kind don't share your forgiving nature. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 825ef34f-25b2-8416-1715-de10a16b7d08
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:825ef34f-25b2-8416-1715-de10a16b7d08
msgctxt "h6135e699g6f29g4fe0g95f2g3e48d1868cca"
msgid ""
"Of course. I'm a hunter who lost his prey, and here I am seeking help from "
"something worse."
msgstr "물론이오. 나는 먹이를 놓친 사냥꾼이고, 여기서는 더 악랄한 존재에게 도움을 구하고 있소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = 827a142f-8186-fec9-dbec-a8e4b6399e31
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAG_GurHunter_AskedAboutPrey(1) = True
#.   Global:
#.      - HAG_GurHunter_State_MentionedAstarion = True
#.      - ORI_Astarion_Knows_Vampireness = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:827a142f-8186-fec9-dbec-a8e4b6399e31
msgctxt "h65bea61cg21f2g4102g9d41gf0b53db47c2c"
msgid "Astarion's the monster you seek. I wanted to protect him before."
msgstr "아스타리온이란 괴물을 쫓고 있다고 했었지. 일전에 그를 지켜준 적이 있소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 82aef15d-6763-77fc-1122-adb279b48fa6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:82aef15d-6763-77fc-1122-adb279b48fa6
msgctxt "h8facca3dg7403g462ag97ceg6045717acb2e"
msgid ""
"Little enough - I hoped she might help me on my hunt, but I suppose she's... "
"indisposed."
msgstr "중요한 건 아니고 - 그녀가 내 추적에 도움을 줄 수 있을까 했네만, 아무래도... 바쁜 모양이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 83afaddc-40d4-33d3-3429-9377df9c8ec6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:83afaddc-40d4-33d3-3429-9377df9c8ec6
msgctxt "h5a2a2550gce0dg4903g8c42gf2a90f7b0ea8"
msgid ""
"Courage has played its part in this story, my friend. Caution will see you "
"live to tell it."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = 84b0e898-9fcb-61b2-d1e3-599111863eb4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Astarion_Knows_Vampireness = False
#.      - ORI_Astarion_HasMet = True
#.      - ORI_Astarion_State_Dead = False
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:84b0e898-9fcb-61b2-d1e3-599111863eb4
msgctxt "ha46dbecagcbc8g400cga0ddgdb3135e102d4"
msgid "I know Astarion - he's no vampire."
msgstr "아스타리온을 압니다. 하지만 그는 뱀파이어가 아니에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = 863c3bab-16e0-1d8a-4e05-269a14fb3b77
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:863c3bab-16e0-1d8a-4e05-269a14fb3b77
msgctxt "h2d6f8312g70d3g4da4g9f39gd43fcd9f315f"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 8656b4cf-dbb4-eebf-6e34-67f381490b3a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:8656b4cf-dbb4-eebf-6e34-67f381490b3a
msgctxt "h2d9ed4e7g6bf8g47bfg9b0bgeaf7f480e72e"
msgid ""
"I'll have to find my quarry by more traditional means. But, one hunter to "
"another - well done."
msgstr "좀 더 전형적인 방식으로 사냥감을 찾아야겠군. 그래도 같은 사냥꾼으로서 말하자면 - 잘 해치웠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 887580d7-25da-2a1b-4b8c-57a624a41f1d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_Hag_State_HagDefeated = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:887580d7-25da-2a1b-4b8c-57a624a41f1d
msgctxt "h99829da0g0a59g4a8eg9438g36ecee880fa6"
msgid "Though... perhaps I speak too swiftly. You have an odour of your own."
msgstr "그런데... 너무 성급하게 말했나보군. 당신에게서도 악취가 나는 걸 보니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 88c3fcdb-ca80-41f3-f503-a4c99dada28a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:88c3fcdb-ca80-41f3-f503-a4c99dada28a
msgctxt "h0d5221a8g03eag42c2gacb5g5986891dea25"
msgid "You do know him? I don't suppose you'll tell me where he is?"
msgstr "그 자를 아시오? 어디에 있는지 말해주지 않겠소?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 8cb50e98-d757-5048-1851-488a352d17b7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:8cb50e98-d757-5048-1851-488a352d17b7
msgctxt "he18422c2ge793g4ed1ga36fg1695885dc9c2"
msgid "Truth is like a blade, my friend. We can arm ourselves with it."
msgstr "진실은 칼날과도 같다오, 친구여. 우리는 그것으로 무장할 수 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = 8d65dd0c-225f-fdb7-e364-39676213ea53
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_Hagspawn_State_MadeDeal = False
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:8d65dd0c-225f-fdb7-e364-39676213ea53
msgctxt "h59b7dee5gcf21g48degae20g29306cc3e250"
msgid "What price is that?"
msgstr "그 대가는 무엇이오?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 8f9a8316-7df3-ef60-1727-8fd5e39f101c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:8f9a8316-7df3-ef60-1727-8fd5e39f101c
msgctxt "hb98e7953geb17g433eg9d6eg5ff9b3a1cc40"
msgid ""
"For my part - I need her knowledge. The thing I hunt has gone to ground."
msgstr "나로 말할 것 같으면, 그녀의 지식이 필요하오. 내 사냥감이 도망쳤거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 91ddf837-b515-cddc-1690-131e54c8de6b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:91ddf837-b515-cddc-1690-131e54c8de6b
msgctxt "h39e7184cg27f4g43cfg93d2g1ec28ebf65b3"
msgid ""
"You take insult where none is intended, my friend. But fine - I won't add to "
"it."
msgstr "내가 의도치 않게 모욕감을 준 모양이군, 친구여. 알겠소 - 이것만 말하리다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = 931c89cb-8eea-d58e-1037-3010137d4f1b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:931c89cb-8eea-d58e-1037-3010137d4f1b
msgctxt "h1312d27dg1450g43b5gb923g71b75a6b8fe6"
msgid "I'd like to trade."
msgstr "거래를 하고 싶군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 93795b03-0786-3b48-840d-f59c7a505b3f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:93795b03-0786-3b48-840d-f59c7a505b3f
msgctxt "hfafcc71bg9429g4ea2gad12g01fab3919db4"
msgid ""
"Sharp steel is not proof against all the monsters of this world, my friend."
msgstr "날카로운 강철이 세상의 모든 괴물을 막을 수 있는 수단은 아니오, 친구여."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 93b60006-553d-afa1-07e5-d488f865ca83
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:93b60006-553d-afa1-07e5-d488f865ca83
msgctxt "hd767156cg4a27g467bg96dag25dc83462c47"
msgid ""
"A sharp wit will serve you better, if you're to bargain with the lady of "
"this house."
msgstr "만약 당신이 이 집의 숙녀와 거래하려 한다면, 날카로운 재치가 당신에게 더 도움이 될 것이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 94d93dca-5cb1-53cd-a5f9-a131122fd1a1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:94d93dca-5cb1-53cd-a5f9-a131122fd1a1
msgctxt "h15f1a474g831dg463dg83acg294892e2bd13"
msgid ""
"You know him? Not too well, I think, if you believe he is so easily slain. "
"He could be stalking your camp at this very moment."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = 95277ec7-5a41-d445-8bc9-ec9b16d6dcfd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_Hagspawn_State_MadeDeal = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:95277ec7-5a41-d445-8bc9-ec9b16d6dcfd
msgctxt "hed8a7bf7g2c7fg44a5g9687g8de3d25d4142"
msgid "Speak for yourself - I got what I wanted."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = 95fc47df-63b0-2cea-0f7e-cb8e2ebac0d7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAG_Hag_HasMet_Teahouse(1) = True
#.   Global:
#.      - HAG_Hagspawn_State_MadeDeal = False
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:95fc47df-63b0-2cea-0f7e-cb8e2ebac0d7
msgctxt "hb08970a0gc13ag4a90ga675g5b8a31d11b3f"
msgid "Not much of a bargain. She made an offer - I refused."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 9672eb6a-41f2-9613-a114-7c76fbc898c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:9672eb6a-41f2-9613-a114-7c76fbc898c8
msgctxt "h048ed0b9g1641g43d2gaeaeg4c5f2c137892"
msgid ""
"Questions should never bring you regret, my friend. Answers are another "
"matter."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = 96ea4c26-aefb-0d08-9e71-81db22587334
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAG_GurHunter_AskedAboutPrey(1) = False
#. SetFlags:
#.   Dialog:
#.     - HAG_GurHunter_AskedAboutPrey(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:96ea4c26-aefb-0d08-9e71-81db22587334
msgctxt "h61399c7bgcdb7g4340gbf42gaa1499c576f0"
msgid "Who is it you're hunting?"
msgstr "누구를 쫓고 있죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 98014026-be7d-57f7-2952-f781d9e5f1d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:98014026-be7d-57f7-2952-f781d9e5f1d0
msgctxt "h9f66b4fcgdc76g4bc7g8e42gf2f4ed81b2c7"
msgid ""
"As you like. But you needn't be coy - whatever's worth knowing, rest assured "
"she already knows it."
msgstr "원하는 대로. 하지만 수줍어할 필요는 없소. 알 만한 가치가 있는 정보라면, 그녀가 이미 알고 있을 것이라 내 장담하오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = 99eee477-3d4a-904b-95c4-80e38c6b4e3d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_Hag_State_IsDead = False
#.      - HAG_Hag_State_HagDefeated = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:99eee477-3d4a-904b-95c4-80e38c6b4e3d
msgctxt "hb112bf41ga056g4b38ga540g407d112cf6ae"
msgid "Price? She was lucky to keep her life."
msgstr "대가? 그녀는 살아있는 것만으로 감사해야 할 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = 9b6f80ed-9c22-5661-31c0-3d0d07dc73ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:9b6f80ed-9c22-5661-31c0-3d0d07dc73ec
msgctxt "h218eeb2agfd0ag4fa0ga04agd6cb6a0ac209"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = 9bd7fbae-b944-1ec4-ca13-f447b9bc4922
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:9bd7fbae-b944-1ec4-ca13-f447b9bc4922
msgctxt "h1ce4763ag37efg4a44g8041gc6496894b1c6"
msgid "Never mind. I already regret asking."
msgstr "신경 쓰지 마. 이미 물어본 걸 후회하니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = 9d181b51-eee1-ba41-f608-958c00ff8d4e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:9d181b51-eee1-ba41-f608-958c00ff8d4e
msgctxt "h055a4fa0g6800g4137gaf81g48bd42e1d4ca"
msgid ""
"A charming sight, to be sure. But the prettiest web still has a spider "
"sitting at its centre."
msgstr "분명 매력적인 외관이오. 하지만 예쁜 거미줄의 한가운데에는 거미가 앉아 있소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Astarion
#. NodeID = 9d1a1a79-cba1-500c-0d76-b59d4c97c376
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:9d1a1a79-cba1-500c-0d76-b59d4c97c376
msgctxt "h153d8b4cgc970g4bb9gbedbg971251d93606"
msgid "What?!"
msgstr "뭐?!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Astarion
#. NodeID = 9df1731a-226b-409b-d5cc-ae1ffd7fceed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:9df1731a-226b-409b-d5cc-ae1ffd7fceed
msgctxt "h6909c68bgaf50g4519gbb20gfaa7716ee651"
msgid "Oh? And bring him where, exactly?"
msgstr "오? 그래서 그를 정확히 어디로 데려갈 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = 9faabcff-ead5-d280-8164-a4ec9fe11ca9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:9faabcff-ead5-d280-8164-a4ec9fe11ca9
msgctxt "hfdb3e68fga314g46e4g9794g34564507b642"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = a1680248-ea1d-6933-f088-fc6cd013cc9f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_Hag_State_HagDefeated = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:a1680248-ea1d-6933-f088-fc6cd013cc9f
msgctxt "hd2ce89e1g7812g4a09g8804gb23d63354a3d"
msgid ""
"Or so I'm told. With the hag gone, I shall have to wait a while longer to "
"see for myself."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = a287ff25-a79e-0ce4-12a3-89a83825aead
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:a287ff25-a79e-0ce4-12a3-89a83825aead
msgctxt "h42ff9cafgdbe3g40b6ga6b2gadaa877742d4"
msgid "Relax, he's not taking you anywhere."
msgstr "진정해, 그는 너를 어디로 데려가지 않을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = a2d0470f-9ac7-b5dd-58a3-5c028251205b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:a2d0470f-9ac7-b5dd-58a3-5c028251205b
msgctxt "h2805973dg5fd1g4363gacdcgc96c4ba43b51"
msgid ""
"Truly? I won't mourn her passing, though I hoped she would help me on my "
"hunt."
msgstr "정말인가? 해그가 내 사냥을 도와주길 바라고 찾아온 거긴 하지만, 딱히 애도하진 않겠소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = a3ba28ab-23d5-9f6e-6eba-1c2adb2865f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:a3ba28ab-23d5-9f6e-6eba-1c2adb2865f0
msgctxt "h4b7c3dacgf222g4c47ga0f7g9a95da5e0283"
msgid "Your wisdom does you credit. Mine, I'm afraid, is outweighed by need."
msgstr "참으로 현명하군. 유감스럽게도, 나는 대가를 감내해야 할 만큼 절박하오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = a3db8e74-b4ea-ac0d-e3e3-2b0c8feafba1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:a3db8e74-b4ea-ac0d-e3e3-2b0c8feafba1
msgctxt "h8ddb75bag21f2g43d8g970bg416763510ce1"
msgid "It's yours. This is the only prize I need."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = a428137a-5f53-0dfb-df22-666750b78044
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:a428137a-5f53-0dfb-df22-666750b78044
msgctxt "h2f052de2g5b9cg49e0g91cfg7725f5ea4cc8"
msgid "Not this time. My orders are to capture him."
msgstr "이번에는 아니오. 내가 받은 명령은 그를 생포하는 것이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = a47ad145-36e4-1892-cb88-9f64f63a921d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:a47ad145-36e4-1892-cb88-9f64f63a921d
msgctxt "h6ead373dg2ecfg4470gb829ge851905d1478"
msgid "An old hunter's trick - if you can't mask your scent, spoil it."
msgstr "노련한 사냥꾼의 속임수요. 만약 당신의 냄새를 감출 수 없다면, 고약하게 만드시오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = a4a82efe-7cae-1ccf-2555-649f40a82186
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_GurHunter_Astarion_Knows_GurPlan = False
#.   Tag:
#.      - REALLY_ASTARION(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:a4a82efe-7cae-1ccf-2555-649f40a82186
msgctxt "h4b7c5f9fge786g43fcga896g288ecad2c7e7"
msgid "What'll you do when you find the vampire? Kill him?"
msgstr "뱀파이어를 찾으면 어떻게 할 것이오? 죽일 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = a6b7d47a-0ee2-bd3a-5f8a-bd33639b51e1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:a6b7d47a-0ee2-bd3a-5f8a-bd33639b51e1
msgctxt "h2ccf9738g941bg47e8g80b7g0cd8dbae281c"
msgid "Scream. Turn. Run the other way - that's what I'd <i>like</i> to say."
msgstr "비명 지르시오. 돌아서서 반대 방향으로 달리시오. 그게 내가 <i>하고 싶은</i> 말이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = a91ac8a8-d045-c6cd-c738-330a9e00858c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:a91ac8a8-d045-c6cd-c738-330a9e00858c
msgctxt "h70b14816g3531g4dacg908dg92dbc160ed2a"
msgid ""
"Without doubt. But this is a personal quarry - one hunter to another, I'm "
"sure you understand."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = aafab78f-4bd0-53b5-a150-d21f2f3e95aa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:aafab78f-4bd0-53b5-a150-d21f2f3e95aa
msgctxt "h69462f91g52f0g4426g9461g07c7ad9570f3"
msgid ""
"Hah! A quick wit is rare indeed. Good manners, however, all beings can "
"aspire to."
msgstr "하! 번뜩이는 재치는 실로 귀한 것이오. 하지만 모두가 바라는 것은 좋은 예절일 수도 있소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = ad330387-70ca-bde2-dd8b-b7d97c4eeb7b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_Hag_State_HagDefeated = False
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:ad330387-70ca-bde2-dd8b-b7d97c4eeb7b
msgctxt "h51d4ade4gfd96g4084gb043gf82b1d571a7b"
msgid ""
"Questions are free - answers are not. Better to learn that before you meet "
"the lady of the house."
msgstr "질문은 자유지만, 대답을 듣는 건 그렇지 않소. 당신이 이 집의 숙녀를 만나기 전에 그 사실을 알아두는 게 좋을 것이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = ade0bfde-1808-62fb-ac4e-ab57d62c962e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_Hag_State_IsDead = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:ade0bfde-1808-62fb-ac4e-ab57d62c962e
msgctxt "hd8e15108gfbc6g4e26g986cg27c7cef0abdd"
msgid "The only price paid was hers. She's dead."
msgstr "대가는 그녀가 치뤘죠. 목숨으로요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = b146d560-be2a-06d6-a5ba-fedacad8598e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:b146d560-be2a-06d6-a5ba-fedacad8598e
msgctxt "ha82ef9e3g0203g4bc8gbcb6gdb29022e039d"
msgid "The stench of fey blood. You've already met the hag, then?"
msgstr "페이의 피 냄새라. 이미 해그를 만난게로군?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = b1de9dea-dd22-d5b6-1ee1-e99e18d7ad3b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:b1de9dea-dd22-d5b6-1ee1-e99e18d7ad3b
msgctxt "h9396a2b8g4b99g491agb905gd00ce8ea44c1"
msgid ""
"I can wait. You, on the other hand, should already be running. Her coven "
"will hear of this."
msgstr "난 기다릴 수 있소. 허나 해그의 집회가 곧 그 사실을 알게 될 테니, 어서 달아나는 게 좋겠소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = b263e623-4c5b-61ab-3a75-a2c2dc4fb338
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAG_Hag_HasMet_Teahouse(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:b263e623-4c5b-61ab-3a75-a2c2dc4fb338
msgctxt "h3caf3237g561ag4c50ga28bg3ea3a627f67b"
msgid "I think you're mistaken - this place looks innocent enough."
msgstr "이곳은 충분히 순수해 보이는데, 당신이 오해하고 있는 듯하군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = b3700735-783c-7ca0-aff3-12a351b58a0f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_Hag_State_HagDefeated = False
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:b3700735-783c-7ca0-aff3-12a351b58a0f
msgctxt "hb3a6147fg3591g43b7ga46fg188b9fe0991a"
msgid ""
"Besides - first I must survive what waits in that house. One terror at a "
"time, hm?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = b43c1d1b-8533-d7c1-b542-1d258a8c1634
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:b43c1d1b-8533-d7c1-b542-1d258a8c1634
msgctxt "hef6e4a76gcabeg4457g98d7g446945874c6b"
msgid "I bid you good fortune with the lady of the house."
msgstr "찻집 여주인과의 만남에서 행운이 있기를."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Astarion
#. NodeID = b61b5258-515a-b84e-aa7b-e2d7f934802c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:b61b5258-515a-b84e-aa7b-e2d7f934802c
msgctxt "hb8518ef8g05deg40cfg8d7cgfdcbc82d5a76"
msgid "You idiot. What have you done?"
msgstr "바보 자식, 뭐하자는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = b7e389d6-b1a5-a4b0-5d6b-304605a14a6d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:b7e389d6-b1a5-a4b0-5d6b-304605a14a6d
msgctxt "he79c0ab9g7d2eg4185g8966gd353c95f1613"
msgid ""
"Because this is her domain. If you are here, it is because it suits her."
msgstr "이곳이 그녀의 영역이기 때문이오. 당신이 여기 왔다면, 그 이유는 그녀에게 어울리는 장소여서겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = b8612c55-518f-051c-9a39-9d4b241a4e3d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:b8612c55-518f-051c-9a39-9d4b241a4e3d
msgctxt "h6b870a87g5656g4f75g9558gbcae07e68def"
msgid "Why would you assume that?"
msgstr "왜 그렇게 추측하죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = bcc542b4-5329-f023-b84e-151ae461a065
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:bcc542b4-5329-f023-b84e-151ae461a065
msgctxt "h876ac42cgbbadg4706ga461ga8b58d262ad7"
msgid "I won't pry - not when I have need of her myself."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = bedc3071-20f1-ad27-6cff-5fb2abaae9ac
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - HAG_GurHunter_HasMet(1) = True
#.      - HAG_GurHunter_COM_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:bedc3071-20f1-ad27-6cff-5fb2abaae9ac
msgctxt "he2a87657g33edg46b0gb5bcg175420d72d43"
msgid ""
"You've tracked me down again, my friend. Would that I had as much luck with "
"the beast I'm hunting."
msgstr "또 날 찾아냈군, 친구. 내가 그 짐승을 사냥하는 데에도 당신만한 행운이 따랐으면 좋겠소만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = bf89832c-3713-882c-ed33-cd3b39f0f95e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - HAG_GurHunter_Event_DidNotRevealCampLocation(1) = True
#.   Quest:
#.     - ORI_COM_Astarion.MetGur_DidNotToldCampLocation(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:bf89832c-3713-882c-ed33-cd3b39f0f95e
msgctxt "hcbf8d12dg17d8g40c9g8efag95ad3b17fbba"
msgid "I'm not going to help you find him. Back off."
msgstr "그를 찾는 것은 돕지 않겠다. 물러서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = bfc0f536-7575-5838-a697-9067891538c0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAG_GurHunter_AskedAboutPrey(1) = True
#.      - HAG_Hag_HasMet_Teahouse(1) = True
#.      - HAG_GurHunter_MetAgainAfterTeahouse(1) = True
#.   Object:
#.      - HAG_GurHunter_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:bfc0f536-7575-5838-a697-9067891538c0
msgctxt "h4bd33aacg31f1g4a2cga4e1ge4cb67f5eefa"
msgid "Moonmaiden's light upon you. And may she spare a little for me, too."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = c08d05ee-6569-9475-65d7-3b7ff0bcb3a8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_GurHunter_State_MentionedAstarion = True
#.      - ORI_Astarion_Knows_Vampireness = True
#.   Tag:
#.      - REALLY_ASTARION(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:c08d05ee-6569-9475-65d7-3b7ff0bcb3a8
msgctxt "h72f83aceg3db8g40c4g8b00gea524147ee7d"
msgid "I'm here to help. This is Astarion - the vampire you're hunting."
msgstr "저는 도와주러 왔습니다. 이 자가 아스타리온이에요. 당신이 쫓던 뱀파이어죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = c0fa8666-87d0-8671-73ce-5234861a88d7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:c0fa8666-87d0-8671-73ce-5234861a88d7
msgctxt "h0dcac38ag1682g4b08gaf12gd4621a9d34b5"
msgid "What?"
msgstr "뭐라고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = c264219b-fe77-b923-e91b-4cad5a881829
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAG_Hag_HasMet_Teahouse(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:c264219b-fe77-b923-e91b-4cad5a881829
msgctxt "h9d7d7c52gc678g488fg8ff0gc9baae27a962"
msgid "It's a teahouse - hardly a lair."
msgstr "이건 찻집이잖아요. 은신처로는 보이지 않는걸요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = c668de1c-7fb8-18b9-1dce-8f68c0fa4100
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:c668de1c-7fb8-18b9-1dce-8f68c0fa4100
msgctxt "he55c5a88g7bd1g4b16g8ee8g7a580673c5a5"
msgid ""
"Your name should serve you well when you meet with the lady of this house."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = ca77cc20-7dc4-2858-0ddb-eb18a3232406
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:ca77cc20-7dc4-2858-0ddb-eb18a3232406
msgctxt "h4cb042c7g8ba5g44e3ga902g28bc226a3a76"
msgid ""
"It is not everyone who can see past her parlour tricks. As you wish - the "
"truth is not mine to keep."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = cb34e322-9525-7151-c77c-30c4ac458124
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:cb34e322-9525-7151-c77c-30c4ac458124
msgctxt "he62f5ac3gfe17g4a66g9ab3gb8dc0762f2ce"
msgid ""
"Hah. Perhaps that is why I have survived so long where more fearsome peers "
"have not."
msgstr "하. 그래서 더 무시무시한 동료들이 살아남지 못한 곳에서 내가 이렇게 오래 살아남은 것일지도 모르오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = cc3fefa1-bb67-fa2f-40c8-8ae9835c03fa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:cc3fefa1-bb67-fa2f-40c8-8ae9835c03fa
msgctxt "hd4373baag8954g4b74g838cg966e5a4bee84"
msgid ""
"But the thing I hunt has gone to ground. If she can tell me how to draw him "
"out, I'll pay whatever she asks."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = cc813859-3844-f8be-761f-b4366e7c570d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:cc813859-3844-f8be-761f-b4366e7c570d
msgctxt "hd8fa7755gb049g4229g9cd0g196f9291f5ca"
msgid "Take the spawn, just leave his stuff with me."
msgstr "데려가. 그놈 물건은 다 놔두고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = cdfbd8c2-7f57-c2a4-2418-96e983a97c22
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:cdfbd8c2-7f57-c2a4-2418-96e983a97c22
msgctxt "hb13821e9gfd9dg4b20gadc3g51ac04f6821d"
msgid "What does your tribe want with a creature like that?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = d06e5a06-fa95-7619-d2f8-457b90168a5b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:d06e5a06-fa95-7619-d2f8-457b90168a5b
#, fuzzy
msgctxt "h00bd0a33g0becg44f6gbbeeg2577d27d52e2"
msgid "You met with this Auntie Ethel, I take it. But did you pay her price?"
msgstr "에텔 이모를 만나고 온 거 같소만, 그녀가 원하는 대가를 치룬 거요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = d2958c7e-d46d-999b-a00e-bcec49c22f88
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:d2958c7e-d46d-999b-a00e-bcec49c22f88
msgctxt "h753a9270g5107g4b26g929ag59af6778f5e5"
msgid "My business here is my own."
msgstr "내가 여기 온 용건은 개인적인 것입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = d2c406f5-0263-fb95-da4e-9e5baf5c7c81
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAG_Hag_HasMet_Teahouse(1) = True
#.      - HAG_GurHunter_MetAgainAfterTeahouse(1) = False
#.   Object:
#.      - HAG_GurHunter_HasMet(1) = True
#. SetFlags:
#.   Dialog:
#.     - HAG_GurHunter_MetAgainAfterTeahouse(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:d2c406f5-0263-fb95-da4e-9e5baf5c7c81
msgctxt "hcd3e432fg00f7g4e89g9fddg1a5e97cc7ed9"
msgid "If you'll forgive me, my friend - you have the stink of fey about you."
msgstr "미안하지만, 친구. 당신에게서 페이의 냄새가 나는 거 같소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = d431fb5d-1f44-7c7d-ce9b-890e5fac2b70
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:d431fb5d-1f44-7c7d-ce9b-890e5fac2b70
msgctxt "h6d283b43g8d54g469agb400ga6875bf81610"
msgid "I have a cage ready nearby - it will hold him when he wakes."
msgstr "근처에 우리가 있소. 놈이 깰 때까지 잡아둘 거요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = d5038649-4a25-e499-a298-40880a5fb433
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:d5038649-4a25-e499-a298-40880a5fb433
msgctxt "h5ebcb0f4gb301g44a9g98ddgb93f9055d118"
msgid ""
"Astarion has quite the friend in you. I'll make sure he knows that, at the "
"end."
msgstr "아스타리온은 그대에게 좋은 친구인가 보군. 마지막에 아스타리온에게 그 사실을 알려주겠소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = d98afc83-f7a2-2a95-7d9a-e61a6279ae47
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_Hag_State_IsDead = False
#. SetFlags:
#.   Object:
#.     - HAG_GurHunter_Event_HandedAstarionOver(1) = True
#.     - GLO_Companion_LeaveDisappearInstantly(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:d98afc83-f7a2-2a95-7d9a-e61a6279ae47
msgctxt "h5d11ddbfgc8d9g43aagb515g3a5dc2ed73e5"
msgid ""
"I would have made a deal with the hag to find this. I'm very glad that I did "
"not. Thank you and safe travels."
msgstr "이 녀석을 찾으려고 해그와 거래까지 할 뻔했소. 안 하게 돼서 천만다행이군. 고맙소. 안전한 여행 되시오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = e23ed278-f8dc-ec86-cdbd-805abd0b1c61
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:e23ed278-f8dc-ec86-cdbd-805abd0b1c61
msgctxt "h249fa34dg7996g4570g8e66gc22c2a972c7a"
msgid ""
"In the chaos of battle, one of them stole away with our children. We have "
"been searching for them ever since."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = e36667a1-4987-be21-be10-66b54a503b11
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAG_Hag_HasMet(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:e36667a1-4987-be21-be10-66b54a503b11
#, fuzzy
msgctxt "h0ea0d9a6ga327g41f8g8863g70a2926c8f97"
msgid "'The lady of this house'?"
msgstr "'이 집의 숙녀'?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = e42a95a2-232e-5a4f-857c-d2971a5c867e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:e42a95a2-232e-5a4f-857c-d2971a5c867e
msgctxt "h490eaa1eg04a3g4554g947eg4c57b6c49c59"
msgid "But bad as she is, I'm betting whatever drove you to her door is worse."
msgstr "그 여자도 나쁘지만, 당신이 그 여자의 문앞을 찾아오게 만든 것은 분명 더 나쁜 것이겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = e45826cc-a233-f0b3-d6cf-a0d7e8cc5d1c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:e45826cc-a233-f0b3-d6cf-a0d7e8cc5d1c
msgctxt "h4352f496g625fg40ceg9690g6021b77a093f"
msgid ""
"...I see. Your loyalty is admirable but misplaced. His kind have charm "
"beyond our mortal means to resist."
msgstr ""
"...그렇단 말이지. 당신의 충성심은 존경스럽지만 대상이 잘못되었소. 그의 종족은 우리 필멸자가 거부할 수 없는 매력을 지니고 있소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = e8bd2927-b5d0-b793-07fe-abe25a7c3043
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:e8bd2927-b5d0-b793-07fe-abe25a7c3043
msgctxt "hc1275b1ag7229g4d60gb1c0gfef3c6039941"
msgid ""
"But, one fool to another, I can't say I judge you. The thing I hunt has "
"slipped away from me."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = ee5d3c8f-188c-1d32-22d9-da7d2600db3c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAG_Hag_HasMet(1) = True
#.   Global:
#.      - GLO_Hag_Knows_HagIsHag = False
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:ee5d3c8f-188c-1d32-22d9-da7d2600db3c
msgctxt "hc9a0c477g6639g4769g8d79ge3ec78bd34b9"
msgid "I know Ethel - that sounds nothing like her."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = ef2c1aa4-0952-d417-0223-81c84db3ad6a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAG_GurHunter_Astarion_Knows_GurPlan = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:ef2c1aa4-0952-d417-0223-81c84db3ad6a
msgctxt "habd13ebbg95e2g49a9g9565ge03e3a4d822a"
msgid ""
"Though I cannot swear to his condition once my tribe are done with him. Is "
"he known to you?"
msgstr "내 부족이 그를 처리하게 되면, 그의 생사를 장담할 수 없지만 말이지. 당신과 아는 사이인가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = ef3c3dd2-3de8-c124-f3f9-26c189da689d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:ef3c3dd2-3de8-c124-f3f9-26c189da689d
msgctxt "h1c0af64ega2f7g4d2cgaa37g1afaf134e50f"
msgid "What will happen to him?"
msgstr "이 자는 어떻게 되죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = f2892b7b-b0f1-cf9d-ad0c-e50e1ce3d778
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:f2892b7b-b0f1-cf9d-ad0c-e50e1ce3d778
msgctxt "hef0f0669g7b8bg449ag999ag43ea84527023"
msgid ""
"I hoped she might help me on my hunt - but I have no desire to be the first "
"face she sees after yours."
msgstr "마녀가 내 사냥을 도와주길 바랐지만 - 당신네들을 만나고 나서 처음 보게 되는 얼굴이 내가 되진 않았으면 좋겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = fa480ff4-89ef-875a-a7e5-9f5724c3e5a1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - HAG_GurHunter_HasMet(1) = False
#. SetFlags:
#.   Object:
#.     - HAG_GurHunter_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:fa480ff4-89ef-875a-a7e5-9f5724c3e5a1
msgctxt "h15ec3390gbaacg4b77gba5bg11e2da989c02"
msgid "Ah, a fellow wanderer. Forgive the aroma."
msgstr "아, 동료 방랑자로군. 이 향기는 미안하오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = fc64df33-0d4d-6134-cd90-2460f7a8a290
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:fc64df33-0d4d-6134-cd90-2460f7a8a290
msgctxt "h861c4e91gf2d1g445fga880gd3a1dbe6e334"
msgid "A powerful friend. A terrible foe. That, I cannot decide for you."
msgstr "강력한 친구지. 두려운 적이 될 수도 있고. 당신에게 무엇일지는 내가 정의해줄 수 없소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = fcf5ef2b-5921-3959-a9a9-309fa63a419d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:fcf5ef2b-5921-3959-a9a9-309fa63a419d
msgctxt "h0b49127aga81ag4d71gb1b5g1d90847acd13"
msgid ""
"Ah, the Blade of Frontiers! You wield that reputation as deftly as a blade "
"itself."
msgstr "아, 변경의 칼날이라! 명성을 칼날만큼이나 잘 다룰 줄 아는 분이로군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Player
#. NodeID = fe4cdf90-da1a-fbd9-d4df-f3b0df3f4925
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAG_GurHunter_State_Hostile = True
#.   Object:
#.     - HAG_GurHunter_Event_AttackedGurHunter(1) = True
#.     - HAG_GurHunter_Event_DidNotRevealCampLocation(1) = True
#.   Quest:
#.     - ORI_COM_Astarion.MetGur_DidNotToldCampLocation(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:fe4cdf90-da1a-fbd9-d4df-f3b0df3f4925
msgctxt "h44be6184g8ca7g4cfegafdfga8162e3fed98"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter
#. Speaker = Gandrel
#. NodeID = ff641226-a260-f81f-6db9-6c6189175119
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter:ff641226-a260-f81f-6db9-6c6189175119
msgctxt "hfc315fc4g1efdg4653g8badg3715af2da3a5"
msgid "That would be nice. I'd welcome a proper cup of tea."
msgstr "그러면 좋겠군. 제대로 된 차 한 잔이면 나도 환영이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter_Dead
#. Speaker = Gandrel
#. NodeID = 087b83ed-ea20-7c92-d79c-9099e6724f53
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Astarion_Knows_MaidenFel = True
#.   Quest:
#.     - ORI_COM_Astarion.MetGur_LearnedEmployer(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter_Dead:087b83ed-ea20-7c92-d79c-9099e6724f53
msgctxt "h2a6b7316g9da5g465bgb908g66e25682dbb6"
msgid "No... Ulma... leader of my tribe..."
msgstr "아니... 울마... 우리 부족의 지도자..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter_Dead
#. Speaker = Gandrel
#. NodeID = 0df616b0-abf9-72b0-fbb6-acfd6c69dd6e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter_Dead:0df616b0-abf9-72b0-fbb6-acfd6c69dd6e
msgctxt "h3f3f2360ga4c4g4233g83e0g520634be3014"
msgid "Dread... creature... but not the one... I hunt..."
msgstr "무서운... 괴물... 하지만 내가 쫓는 녀석은... 아니야..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter_Dead
#. Speaker = Narrator
#. NodeID = 10d9446b-45f7-597c-559f-c3fd076e0ec6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter_Dead:10d9446b-45f7-597c-559f-c3fd076e0ec6
msgctxt "h2060c16bg9f38g4c63gb002gf1c7974059e0"
msgid "*The spell's power wanes. You can ask no more questions.*"
msgstr "*주문의 힘이 약해집니다. 더 이상 질문을 할 수 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter_Dead
#. Speaker = Narrator
#. NodeID = 132a55ed-8c96-94d9-342c-a1628cf94302
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter_Dead:132a55ed-8c96-94d9-342c-a1628cf94302
msgctxt "ha9ab4cb0g1e8eg4781gb61eg73f93c1ea0d6"
msgid "*The corpse regards you lifelessly.*"
msgstr "*시체가 생기 없는 모습으로 당신을 맞이합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter_Dead
#. Speaker = Gandrel
#. NodeID = 2f8cb4a1-c7e0-00b5-c77d-b727eba921f6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter_Dead:2f8cb4a1-c7e0-00b5-c77d-b727eba921f6
msgctxt "he8bec2ceg95d6g4ca2g9abcgfafa7bcb533b"
msgid "Much. Nothing... you can spend..."
msgstr "많지. 네가 쓸 수... 있는 건 없지..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter_Dead
#. Speaker = Player
#. NodeID = 43f4cc41-7071-01d2-6379-3e732c6cfc01
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_GurHunter_Astarion_Knows_WiseWoman = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter_Dead:43f4cc41-7071-01d2-6379-3e732c6cfc01
msgctxt "hc54c2113g4370g4d23g95c0ge0a98e9e52b1"
msgid "Who is this wise woman?"
msgstr "이 지혜로운 여자가 누구지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter_Dead
#. Speaker = Gandrel
