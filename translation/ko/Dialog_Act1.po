#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SussurTower_PAD_StrengthChair
#. Speaker = Player
#. NodeID = 1a197769-ae98-cdc9-0a77-b0db8cf4937f
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SussurTower_PAD_StrengthChair:1a197769-ae98-cdc9-0a77-b0db8cf4937f
msgctxt "h9118316ag8a3eg4310gacaeg1de78a0ebb79"
msgid "Well now, what's this? I feel <i>powerful</i>."
msgstr "이런, 이게 뭐람? <i>강력한 기운</i>이 느껴져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SussurTower_PAD_StrengthChair
#. Speaker = Player
#. NodeID = 1a197769-ae98-cdc9-0a77-b0db8cf4937f
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SussurTower_PAD_StrengthChair:1a197769-ae98-cdc9-0a77-b0db8cf4937f
msgctxt "h9dfad074g6f2eg48e5g87d8gaec0a4c386bb"
msgid ""
"My, not only is this chair comfortable, it imbues its sitter with power!"
msgstr "오, 의자가 편한 것도 좋지만, 앉은 사람에게 힘을 불어넣어 주다니!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SussurTower_PAD_StrengthChair
#. Speaker = Player
#. NodeID = 1a197769-ae98-cdc9-0a77-b0db8cf4937f
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SussurTower_PAD_StrengthChair:1a197769-ae98-cdc9-0a77-b0db8cf4937f
msgctxt "had4aaa47g54feg471bg9791g3db4ad5eb2da"
msgid "Ohoho, I like this. I feel strong as hell."
msgstr "오호호, 이거 맘에 들어. 겁나게 강해진 기분이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SussurTower_PAD_StrengthChair
#. Speaker = Player
#. NodeID = 1a197769-ae98-cdc9-0a77-b0db8cf4937f
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SussurTower_PAD_StrengthChair:1a197769-ae98-cdc9-0a77-b0db8cf4937f
msgctxt "h722b7f53gbba3g48c3gaa95ga4bb127efa2f"
msgid "What is this <i>power?</i>"
msgstr "이 <i>막강한 힘</i>은 뭐지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SussurTower_PAD_StrengthChair
#. Speaker = Player
#. NodeID = 1a197769-ae98-cdc9-0a77-b0db8cf4937f
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SussurTower_PAD_StrengthChair:1a197769-ae98-cdc9-0a77-b0db8cf4937f
msgctxt "h6fd53530gb133g4883g92e5g03eea0f82a7b"
msgid "This chair... I feel stronger just from sitting in it."
msgstr "이 의자... 그저 앉았을 뿐인데 강해진 기분이 들어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SussurTower_PAD_StrengthChair
#. Speaker = Player
#. NodeID = 1a197769-ae98-cdc9-0a77-b0db8cf4937f
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SussurTower_PAD_StrengthChair:1a197769-ae98-cdc9-0a77-b0db8cf4937f
msgctxt "h173fa5ffg9f24g426fg85a0g5551e9b09c04"
msgid "Holy... I feel <i>powerful</i>. Nice chair indeed."
msgstr "이런... <i>강한</i> 힘이 느껴져. 멋진 의자군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SussurTower_PAD_StrengthChair
#. Speaker = Player
#. NodeID = 1a197769-ae98-cdc9-0a77-b0db8cf4937f
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SussurTower_PAD_StrengthChair:1a197769-ae98-cdc9-0a77-b0db8cf4937f
msgctxt "h539fcfd2g36a8g4f4fgb347gbd50e964f5eb"
msgid "What's this... feeling of <i>power</i>?"
msgstr "뭐지... <i>엄청난 힘</i>이 느껴지는데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SussurTower_PAD_StrengthChair_Leg
#. Speaker = Player
#. NodeID = 87c1153b-250f-27d1-a44a-cc8455072460
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SussurTower_PAD_StrengthChair_Leg:87c1153b-250f-27d1-a44a-cc8455072460
msgctxt "h46f4f6b3ge6abg450bgbf2bgb9fcc59fc841"
msgid "This could do some damage. Waste not..."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SussurTower_PAD_StrengthChair_Leg
#. Speaker = Player
#. NodeID = 87c1153b-250f-27d1-a44a-cc8455072460
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SussurTower_PAD_StrengthChair_Leg:87c1153b-250f-27d1-a44a-cc8455072460
msgctxt "h3d5d3012gf469g4628gbf2ag5a6bb7ba62ed"
msgid ""
"Look at that. An unconventional weapon, but it might just be an effective "
"one."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SussurTower_PAD_StrengthChair_Leg
#. Speaker = Player
#. NodeID = 87c1153b-250f-27d1-a44a-cc8455072460
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SussurTower_PAD_StrengthChair_Leg:87c1153b-250f-27d1-a44a-cc8455072460
msgctxt "h97848939g5ac2g42bcgac71gf071a5816c6f"
msgid "I could do some real damage with that chair leg."
msgstr "저 의자 다리로는 물리적 피해를 입힐 수 있을 것 같네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SussurTower_PAD_StrengthChair_Leg
#. Speaker = Player
#. NodeID = 87c1153b-250f-27d1-a44a-cc8455072460
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SussurTower_PAD_StrengthChair_Leg:87c1153b-250f-27d1-a44a-cc8455072460
msgctxt "h29e29c7bgbdbfg424bg8649g01873e3fcc82"
msgid "It is no silver sword, but that chair leg may be a useful weapon."
msgstr "은검은 아니지만, 저 의자 다리는 무기로 쓸만해 보이는구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SussurTower_PAD_StrengthChair_Leg
#. Speaker = Player
#. NodeID = 87c1153b-250f-27d1-a44a-cc8455072460
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SussurTower_PAD_StrengthChair_Leg:87c1153b-250f-27d1-a44a-cc8455072460
msgctxt "h49a320e7g781cg4ef3g95a8g9874700a89b8"
msgid ""
"Hmm. As much as I enjoy a sit-down, a strengthening bludgeon is more "
"useful..."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SussurTower_PAD_StrengthChair_Leg
#. Speaker = Player
#. NodeID = 87c1153b-250f-27d1-a44a-cc8455072460
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SussurTower_PAD_StrengthChair_Leg:87c1153b-250f-27d1-a44a-cc8455072460
msgctxt "h15c482f6g7d60g4bd0g88fagb4ac14338049"
msgid "Hm - that chair leg might be good for smacking monsters around."
msgstr "흠, 저 의자 다리는 괴물을 후려치는 데 쓰기 좋아 보이는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SussurTower_PAD_StrengthChair_Leg
#. Speaker = Player
#. NodeID = 87c1153b-250f-27d1-a44a-cc8455072460
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SussurTower_PAD_StrengthChair_Leg:87c1153b-250f-27d1-a44a-cc8455072460
msgctxt "hba961418gee8dg48deg8ffcg00e72bc4d088"
msgid "That chair leg could make for a fine weapon..."
msgstr "저 의자 다리는 무기로 쓰기에 괜찮아 보이는데..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SussurTower_PAD_StrengthChair_Stand
#. Speaker = Player
#. NodeID = ad8d71ea-822b-57e5-a671-aa4cbddba73d
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SussurTower_PAD_StrengthChair_Stand:ad8d71ea-822b-57e5-a671-aa4cbddba73d
msgctxt "hf4306054gf475g4986ga4ffgd536bc61a27c"
msgid "Damn it, it's gone..."
msgstr "망할, 힘이 사라졌잖아..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SussurTower_PAD_StrengthChair_Stand
#. Speaker = Player
#. NodeID = ad8d71ea-822b-57e5-a671-aa4cbddba73d
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SussurTower_PAD_StrengthChair_Stand:ad8d71ea-822b-57e5-a671-aa4cbddba73d
msgctxt "hf0aa7844g5994g4613gb0dcg5c95b973ed71"
msgid ""
"Hmmm. So if I stand, the power's gone. Sedentary magic I suppose that's "
"called."
msgstr "흐으음. 일어서면 힘은 사라지는군. 착석 마법이랄까 그런 이름이겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SussurTower_PAD_StrengthChair_Stand
#. Speaker = Player
#. NodeID = ad8d71ea-822b-57e5-a671-aa4cbddba73d
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SussurTower_PAD_StrengthChair_Stand:ad8d71ea-822b-57e5-a671-aa4cbddba73d
msgctxt "h103454c8gdb9ag42bdgb203gcf5faaf5724e"
msgid "Aw! Power's gone as soon as I stand up."
msgstr "아오! 일어서니까 바로 힘이 사라지네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SussurTower_PAD_StrengthChair_Stand
#. Speaker = Player
#. NodeID = ad8d71ea-822b-57e5-a671-aa4cbddba73d
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SussurTower_PAD_StrengthChair_Stand:ad8d71ea-822b-57e5-a671-aa4cbddba73d
msgctxt "hd41f8d9ege7bdg415fgaeafgdc92b27cd105"
msgid "The power's gone. A most vexing chair..."
msgstr "힘이 사라졌다. 아주 짜증나는 의자군..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SussurTower_PAD_StrengthChair_Stand
#. Speaker = Player
#. NodeID = ad8d71ea-822b-57e5-a671-aa4cbddba73d
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SussurTower_PAD_StrengthChair_Stand:ad8d71ea-822b-57e5-a671-aa4cbddba73d
msgctxt "haf5d0f53g754eg41a6g93e0g80b804025481"
msgid "The strength vanishes as soon as I stand. Curious."
msgstr "내가 일어서니까 힘이 사라졌어. 신기하네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SussurTower_PAD_StrengthChair_Stand
#. Speaker = Player
#. NodeID = ad8d71ea-822b-57e5-a671-aa4cbddba73d
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SussurTower_PAD_StrengthChair_Stand:ad8d71ea-822b-57e5-a671-aa4cbddba73d
msgctxt "h9e0d3bc3g0e6dg480aga816gaa409c031ed5"
msgid "And <i>poof</i> - the power's gone."
msgstr "이러니 <i>펑</i>, 힘이 사라졌어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SussurTower_PAD_StrengthChair_Stand
#. Speaker = Player
#. NodeID = ad8d71ea-822b-57e5-a671-aa4cbddba73d
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SussurTower_PAD_StrengthChair_Stand:ad8d71ea-822b-57e5-a671-aa4cbddba73d
msgctxt "h0bb2d2beg4051g4ee5gba4cg8a558078bd96"
msgid "It's gone. I felt so strong - where did that come from?"
msgstr "사라졌어. 엄청난 힘이 느껴졌는데, 어디서 그런 힘이 나오는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_TheDrowNere_AD_Combat
#. Speaker = Nere
#. NodeID = a2da4c22-20bf-40b2-97d6-aff2f287fd71
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_TheDrowNere_AD_Combat:a2da4c22-20bf-40b2-97d6-aff2f287fd71
msgctxt "h6becc92ega0e7g438egae06g1b010623256d"
msgid "Heretic. You should never have come here!"
msgstr "이교도 자식. 여기로 오면 안 됐어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_AdamantineForge_AD_FoundKey
