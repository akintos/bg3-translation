msgctxt "hc97f78a8g492dg467agb9f4gbde918b5630d"
msgid "A dragon. Gods preserve me."
msgstr "드래곤이군. 신들이시여, 지켜주소서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_LaezelKilledByGith
#. Speaker = Player
#. NodeID = 1266e90b-d755-3d93-67ef-d8c2f802c395
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
