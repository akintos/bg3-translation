msgctxt "h07914aafg1451g43d3gaca4g8c07954c7bf3"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_ElevatorBear
#. Speaker = Tuffet
#. NodeID = c8f2ba2c-00f3-238d-5190-cec43c82aefa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_ElevatorBear:c8f2ba2c-00f3-238d-5190-cec43c82aefa
msgctxt "hb13e2030gb6b7g4412g9beegb3a685e0add4"
msgid "Huh? What's that?"
msgstr "허? 그거 뭐야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_ElevatorBear
#. Speaker = Tuffet
#. NodeID = d8738688-91e5-f0e6-6b72-e3278d6d6f45
