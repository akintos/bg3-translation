msgctxt "h12896c1ag41c1g4279gb078g3ad1eaf9d13d"
msgid "I'd like to see you try."
msgstr "난 네가 애쓰는 걸 보고 싶구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush
#. Speaker = Goblin Booyahg
#. NodeID = 1ca1faec-05e9-c2f0-6dc5-bdb6eed79b05
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush:1ca1faec-05e9-c2f0-6dc5-bdb6eed79b05
msgctxt "h5f2df6bcg78bag4b6fg9912g6c934378d242"
msgid "Apologies, your lordship. Hard makin' you out from a distance."
msgstr "정말 죄송합니다, 나으리. 멀리서 뵈어서 알아보기 어려웠습죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush
#. Speaker = Goblin Booyahg
#. NodeID = 229203d3-43bc-0bf7-ef7e-062ed937d439
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush:229203d3-43bc-0bf7-ef7e-062ed937d439
msgctxt "h18f31d6bg81b4g4996g9813g0ba003386c97"
msgid "Y'know, I hear we got one like you roastin' back at camp."
msgstr "알다시피, 너 같은 녀석이 우리 진영에서 구워지고 있는 것 같더라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush
