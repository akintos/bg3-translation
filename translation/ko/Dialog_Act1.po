msgctxt "h3244556fg475ag46fcgb472g69c348ed1c02"
msgid "Such beauty. Such power."
msgstr "정말 아름답고, 또 강력하군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_DragonShadow
