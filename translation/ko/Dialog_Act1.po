msgctxt "hc10d0749gff8bg4664g8b62g6a5580f0eaaf"
msgid "My venom more devastating?"
msgstr "내 독의 파괴력이 커져?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Jox
#. NodeID = 1068519e-86b9-7b25-21d4-ff342df76168
