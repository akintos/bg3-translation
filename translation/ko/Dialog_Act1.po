msgctxt "h95f076e5g313ag48f3ga68dg12f21fd81632"
msgid "What is this place?"
msgstr "여기는 어디지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_VB_MayrinaInCage
#. Speaker = Player
#. NodeID = 4fe5a9bb-3293-4e32-4fb5-70373517af0f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_VB_MayrinaInCage:4fe5a9bb-3293-4e32-4fb5-70373517af0f
msgctxt "h128160c4gc264g4547ga2c7g194c4d607ff5"
msgid "There - in the cage!"
msgstr "저기, 우리 안에!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_VB_MirrorScreams
#. Speaker = Player
#. NodeID = 4d283700-1742-579d-3c0f-2d4df9e4f6fe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Party:
#.      - HAG_HagLair_VB_MirrorScreams_PassedCheck(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_VB_MirrorScreams:4d283700-1742-579d-3c0f-2d4df9e4f6fe
msgctxt "ha7a7ab74g5a88g4ed6g829ag3e3635650af0"
msgid "What's that?"
msgstr "저건 뭐야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_VB_MirrorScreams
#. Speaker = Player
#. NodeID = b7970cf8-3b9d-aa64-623f-5108b980a573
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Party:
#.      - HAG_HagLair_VB_MirrorScreams_PassedCheck(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_VB_MirrorScreams:b7970cf8-3b9d-aa64-623f-5108b980a573
msgctxt "h9b2dec87gb728g43ccgacfcgc5262e4f6cb3"
msgid "Those screams - someone's trapped in that mirror. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Player
#. NodeID = 0053c6e7-e48a-e508-aba2-ae099c062251
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - REALLY_DUERGARDWARF(1) = True
#.      - CLERIC_ILMATER(1) = False
#.      - PALADIN_ILMATER(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:0053c6e7-e48a-e508-aba2-ae099c062251
msgctxt "h2bfb1039g6f4dg4ed7g98abg2ae059bd64bb"
msgid "<i>Examine him for signs of Laduguer's Bite.</i>"
msgstr "<i>그에게 '러더거의 교상' 징후가 있는지 검사한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Player
#. NodeID = 00910e93-f9c6-e976-a596-c1cb89bbf960
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:00910e93-f9c6-e976-a596-c1cb89bbf960
msgctxt "h4a42c126g9647g4753g957dg288ab7bb0ac0"
msgid "Oh, you'll figure it out. You owe me a debt, and I intend to collect."
msgstr "오, 잘 알게 될 거야. 넌 내게 빚진 거고, 난 그걸 가져갈 생각이거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Player
#. NodeID = 02f73cc7-d5db-68ae-fe17-9540a745a0e3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:02f73cc7-d5db-68ae-fe17-9540a745a0e3
msgctxt "hf073cc49g6ae6g407aga312g6e5deec20718"
msgid "I removed the petrification spell."
msgstr "내가 석화 주문을 해제했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Player
#. NodeID = 0be3ea61-e9da-4889-89c2-42816cb3c401
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_Hag_State_IsDead = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:0be3ea61-e9da-4889-89c2-42816cb3c401
msgctxt "h3e79d46bg906dg4602g8fbeg84da9e957a5e"
msgid "The hag is dead."
msgstr "해그는 죽었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Player
#. NodeID = 0f72c405-b0c2-6311-a73e-73c410a99193
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:0f72c405-b0c2-6311-a73e-73c410a99193
msgctxt "h2329b18cg9322g45e3g859cg7ce986d61253"
msgid "You're sick? Are you contagious?"
msgstr "병에 걸렸어? 전염성이 있나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = 0f9b19e9-9843-ca3f-c306-844a67515b6e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GEN_DisappearOutOfSightWhenAvailable(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:0f9b19e9-9843-ca3f-c306-844a67515b6e
msgctxt "hcc7e567cg9cf2g4569g8c9cg50094571a634"
msgid ""
"Argh. The stones take you, you disgusting half-breed. I'll deal with this "
"myself."
msgstr "아악. 돌에 파묻혀라, 이 역겨운 혼혈놈아. 내 스스로 해결할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = 107f2378-b56a-ff23-f565-d05bfcd876b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:107f2378-b56a-ff23-f565-d05bfcd876b6
msgctxt "h829b403bgec0eg4ba3gbd3fgdbf219e6cde0"
msgid "Sorry - now ain't the time for blathering."
msgstr "미안, 실없는 소리나 할 때가 아닌데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = 128406e0-3b64-0350-e53e-9f8af231a5cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:128406e0-3b64-0350-e53e-9f8af231a5cb
msgctxt "h1185c150gec69g421egb1c9g0c4ea0dbef8b"
msgid "Oh, no. No. No. NO."
msgstr "오, 안 돼. 안 돼. 안 돼. <b>안 돼</b>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = 144832c4-cccd-22c4-5a9d-48429cf9058d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:144832c4-cccd-22c4-5a9d-48429cf9058d
msgctxt "h95be8c32gc67dg4991g864bge88e80cc4ec8"
msgid "How... how am I still breathin'?"
msgstr "어... 어떻게 내가 아직 숨 쉬고 있는 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Player
#. NodeID = 148e6e8a-719b-9fad-23af-a15aa3e8bb18
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:148e6e8a-719b-9fad-23af-a15aa3e8bb18
msgctxt "h096de78egb823g4962ga74dg833fad87e9eb"
msgid "You struck a deal with the hag, didn't you?"
msgstr "해그와 거래를 한 거군, 그렇지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = 15709233-11df-614c-a5f5-4e19bcf6068a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:15709233-11df-614c-a5f5-4e19bcf6068a
msgctxt "h861d4ac6g1633g4f4bgae4bg4cf9581aa8d6"
msgid "That double-crossing, filthy, lying wretch."
msgstr "그 배신자, 더러운 거짓말쟁이 개자식."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = 173a906e-5760-457e-064f-03bf8fa90195
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:173a906e-5760-457e-064f-03bf8fa90195
msgctxt "hde081ec6gcc1bg44d4g82cfgb846018167d6"
msgid ""
"My kids were only babes when I left. The stones know how old they are now."
msgstr "내가 떠날 땐 아이들은 그냥 아기였어. 이젠 돌들이 아이들이 몇 살인지 알겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Player
#. NodeID = 185bd4d2-2b83-92dd-a873-df6d5fef1208
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:185bd4d2-2b83-92dd-a873-df6d5fef1208
msgctxt "hfaff7c24ge26dg4789gac36gc67160fcbcd5"
msgid "How long were you trapped like this?"
msgstr "얼마나 오래 갇혀 있던 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = 1b7e4fec-d041-2474-6493-71c9400d146d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - HAG_HagLair_Victim_001_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:1b7e4fec-d041-2474-6493-71c9400d146d
msgctxt "h79953282gb716g42afgbe21g17b47a1f1e47"
msgid "Ungh... what... argh... what in the bloody hells is going on?"
msgstr "으으... 뭐가... 으윽... 대체 뭐가 어떻게 되고 있는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = 1d62447a-866e-b87d-9cee-288b466013b2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:1d62447a-866e-b87d-9cee-288b466013b2
msgctxt "hd9c7863eg5265g4814ga7eegc689a1fb4e1c"
msgid "I'll find another way. I swear to you."
msgstr "다른 방법을 찾아 볼게. 맹세할 수 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = 1de4ab31-a873-8d9e-ffb7-86924f59e01a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:1de4ab31-a873-8d9e-ffb7-86924f59e01a
msgctxt "h6f681b2egea08g4148g9e64g776103879bc2"
msgid "You won't be left wanting. You've my word."
msgstr "만족하게 될 거야. 약속할게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Player
#. NodeID = 259b5b46-cb81-5094-fcb6-c45e83db1fa6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WIZARD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:259b5b46-cb81-5094-fcb6-c45e83db1fa6
msgctxt "hd702dd2dg9781g4d55gaf99g58cd0e49b619"
msgid "<i>Examine him for signs of magic.</i>"
msgstr "<i>그에게서 마법의 흔적을 찾는다</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = 27d1a4b8-6835-bca0-aa69-06ca6c6dd74b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:27d1a4b8-6835-bca0-aa69-06ca6c6dd74b
msgctxt "hed859f75gb848g428bgb93eg4604f27580f0"
msgid "True. And I don't plan to waste a moment more."
msgstr "사실이야. 그리고 더 이상 낭비하지 않을 계획이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Player
#. NodeID = 2884e973-5f02-81b1-07be-a1c005c26c40
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:2884e973-5f02-81b1-07be-a1c005c26c40
msgctxt "h3227bab9g201fg4705gb3cbg2d3dbde03b80"
msgid "Damn it. You could've said as much from the start."
msgstr "빌어먹을. 처음부터 그렇게 말했어야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = 2f62ee35-c1be-d7e1-1bd8-2a9559458729
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:2f62ee35-c1be-d7e1-1bd8-2a9559458729
msgctxt "hfe187449ge13cg490dg8ea5gcbb3475c1577"
msgid "But why... bloody hells."
msgstr "하지만 왜... 이런 망할."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = 3071a007-7f02-2507-eea7-73c1a11fa68d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:3071a007-7f02-2507-eea7-73c1a11fa68d
msgctxt "h6c4d592fgbb71g4b29g94a9gfebf789da363"
msgid "You do?"
msgstr "정말?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Player
#. NodeID = 309773f4-098e-8d07-eff3-05dee2db0585
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DUERGARDWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:309773f4-098e-8d07-eff3-05dee2db0585
msgctxt "hb60ec5dcg4ac5g4215ga135g065fef57f1eb"
msgid "Ha! The Bite should have turned you inside out by now."
msgstr "하! '교상'은 지금쯤이면 널 완전히 뒤집어놨어야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Narrator
#. NodeID = 30ea22f1-aae4-5a34-c04b-ebb0c5e4e4e8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:30ea22f1-aae4-5a34-c04b-ebb0c5e4e4e8
msgctxt "h4bd3869dgd01ag45edg9f88gc1af3ca57b8d"
msgid "*As far as you can tell, he's in perfectly good health.*"
msgstr "*당신이 보기에, 이 남성은 완벽히 건강합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = 32350d32-76c7-b7bc-d39b-66d363b89d60
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:32350d32-76c7-b7bc-d39b-66d363b89d60
msgctxt "had921e6dg892eg4e3dgac85g9cbc19fe7da4"
msgid ""
"I wouldn't wish it on anyone. Yer insides... end up on the outside. "
"Petrification stops the spread."
msgstr "난 누구에게도 옮기고 싶지 않았어. 오장육부가... 다 뒤집어질 거라고. 석화는 확산을 막고 있었지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = 3415eea5-4b41-34ab-ef56-8643d38175f2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DUERGARDWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:3415eea5-4b41-34ab-ef56-8643d38175f2
msgctxt "hdff581deg6a84g46a2gb03bg5ebfa4968d66"
msgid "Look, greyling or not, you having a look put my mind at ease."
msgstr "이봐, 회색쟁이든 아니든, 네가 봐줘서 마음이 편해졌어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = 395d3985-4fd5-3c8c-064e-ea7673f1b96f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:395d3985-4fd5-3c8c-064e-ea7673f1b96f
msgctxt "haf6732ffgaf87g43f2gb5e8gf71a615ccfc3"
msgid "And that the Bite... Laduguer's Bite was fatal."
msgstr "그리고 그 '교상'... '러더거의 교상'은 치명적인데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Player
#. NodeID = 3ab0fb12-3ea8-7fd4-b1d9-8de23f7736a4
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:3ab0fb12-3ea8-7fd4-b1d9-8de23f7736a4
msgctxt "hce7529a2g60d2g4412g91f3gf2ca7b4dca39"
msgid "<i>Look for remnants of the hag's magic.</i>"
msgstr "<i>해그 마법의 흔적을 찾는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Player
#. NodeID = 3cda565e-d261-c82e-8305-9289db915308
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:3cda565e-d261-c82e-8305-9289db915308
msgctxt "h9d5d15e1g30dag4cf6gb4feg004268f454a4"
msgid "No time for questions. Get out of here while you still can."
msgstr "질문할 시간이 없어. 아직 떠날 수 있을 때 여길 뜨라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = 3cfeba82-946b-462c-241f-a01d31d929d3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:3cfeba82-946b-462c-241f-a01d31d929d3
msgctxt "h7b323764g3de5g4551gaffeg81eb9e3130a5"
msgid ""
"The very one. Complete with everything from sores to vomitin' blood. By the "
"time it kills you it - wait."
msgstr "바로 그거야. 온몸의 피를 맹렬하게 토하면서 끝장나는 거지. 죽을 때쯤이면... 가만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Player
#. NodeID = 3f8b6470-6afd-9a82-3b09-431db380ec6d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:3f8b6470-6afd-9a82-3b09-431db380ec6d
msgctxt "hc97825cbgb9e8g4beeg8fe6gc4f4734322dd"
msgid "<i>Laugh harder.</i>"
msgstr "<i>더 크게 웃는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Player
#. NodeID = 44079316-f189-dc26-ce59-26453ccef4a1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DWARF(1) = False
#.      - BARD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:44079316-f189-dc26-ce59-26453ccef4a1
msgctxt "hf4388b1dg8902g409bg8657g3cc3654869ea"
msgid ""
"I've heard tales of Laduguer's Bite. Don't your insides end up on your "
"outside?"
msgstr "'러더거의 교상'에 대한 이야기를 들은 적이 있어. 네 내장이 다 튀어나와야 하는 거 아냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Player
#. NodeID = 444f2cfe-b0e0-4cf4-632e-09bca682ac3c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:444f2cfe-b0e0-4cf4-632e-09bca682ac3c
msgctxt "h09a0f428g80d0g418bg950ag6418963a14c6"
msgid "Listen, I have places to be."
msgstr "저기, 난 가봐야 하거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Player
#. NodeID = 47f33700-e8b1-9b77-af67-3bc0bb381954
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:47f33700-e8b1-9b77-af67-3bc0bb381954
msgctxt "hac181648ge6abg4588gab69gb9e7fc77c362"
msgid "But now you have many more years ahead of you."
msgstr "하지만 이젠 앞으로 더 많은 시간이 남아있는 거잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = 485bc38b-4734-7e03-e41b-93935a261dd3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:485bc38b-4734-7e03-e41b-93935a261dd3
msgctxt "hb501d085g6100g44bbga778g3aaeb1068e5e"
msgid "She <i>made</i> me sick.  And then trapped me in stone for kicks."
msgstr "해그가 날 병들게 <i>한 거야</i>. 그러고선 날 돌에 가둬놓곤 장난을 친 거라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Player
#. NodeID = 49217115-04c6-1378-04f8-fd6600056c9e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:49217115-04c6-1378-04f8-fd6600056c9e
msgctxt "h4119900dga847g47c1ga797ga80d9e148500"
msgid "I'm almost impressed - that's evil, even by a hag's standards."
msgstr "거의 감탄스러울 정도네. 그건 해그 치고도 아주 사악한 행동인데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Player
#. NodeID = 4c07c06c-d07c-5f02-45b9-e312f587b0c2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:4c07c06c-d07c-5f02-45b9-e312f587b0c2
msgctxt "h271ce32fg6b93g4467g939agd8c76d8f4ec2"
msgid "Are you sick or something?"
msgstr "어딘가 아픈 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = 505d5ea1-5482-d1b2-d1a3-d09ee3ece34c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:505d5ea1-5482-d1b2-d1a3-d09ee3ece34c
msgctxt "hc89cb8ceg4e74g4803g993fgb4fb758d3667"
msgid "She petrified me to stop it from spreading until - oh no."
msgstr "확산을 막으려고 해그가 날 석화 상태로 만든건데... 오, 안 돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Player
#. NodeID = 515f69e3-5ba8-8ea4-96f7-bb33e623a5c2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:515f69e3-5ba8-8ea4-96f7-bb33e623a5c2
msgctxt "hfbc5fc8fgfc23g405cgbe7fgce40fb53f539"
msgid "Because I saved you. You're welcome."
msgstr "별말씀을, 왜냐면 내가 당신을 구했으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = 54529bbb-49ab-ff01-8e95-b66637c15ead
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:54529bbb-49ab-ff01-8e95-b66637c15ead
msgctxt "h1b0f4b00g8a24g4464g9a0dgb77ff73d4e16"
msgid "How?"
msgstr "어떻게?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = 546d22de-661d-3afc-0a33-4c0c2fdd8c88
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:546d22de-661d-3afc-0a33-4c0c2fdd8c88
msgctxt "hdb730a28gebb8g4323g9a8ag9e1e4e9a7316"
msgid "The duergar, of course. Filthy greylings."
msgstr "당연히 듀에르가 때문이지. 더러운 회색쟁이놈들."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = 56e9b563-ef9c-b286-15eb-fd758d33622d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:56e9b563-ef9c-b286-15eb-fd758d33622d
msgctxt "hc215d601g605cg4deag9594g924f77304bcf"
msgid "You did <i>what? </i>But - but you can't!"
msgstr "<i>뭘</i> 했다고? 하... 하지만 그러면 안 되는데!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = 579b0fb3-e739-6c11-e664-487683a52bd0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_Hag_SummonedVictims = False
#.      - HAG_Hag_State_IsDead = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:579b0fb3-e739-6c11-e664-487683a52bd0
msgctxt "h6614c37bg0576g4e50g9424g3aa69397a6a8"
msgid "Ungh... me head..."
msgstr "으윽... 머리야..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Player
#. NodeID = 57d20211-54c9-4e26-644a-ea9ca6dd83dc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:57d20211-54c9-4e26-644a-ea9ca6dd83dc
msgctxt "h8387d67ag02d6g495cg8a8egc4df5b439def"
msgid "The Bite's a terrible disease. I can see why you went to the hag."
msgstr "'교상'은 끔찍한 질병이지. 왜 해그에게 갔는지 알겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Player
#. NodeID = 59ae7423-348d-7746-a9ed-752f8cd495d3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:59ae7423-348d-7746-a9ed-752f8cd495d3
msgctxt "h63dc22c0g6061g4512gaf70g7fddd741ce4e"
msgid "What's 'the Bite'?"
msgstr "'교상'이 뭐야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = 59b5d09e-7183-12cc-e7b6-731b7e7ee167
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:59b5d09e-7183-12cc-e7b6-731b7e7ee167
msgctxt "h49eed70bg0f03g4f96g84f2g62d6781d70af"
msgid "What? But that would mean..."
msgstr "뭐? 하지만 그렇다는 의미는..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = 5b23a614-9012-0d73-d83b-3ee358923cbb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:5b23a614-9012-0d73-d83b-3ee358923cbb
msgctxt "h236b24fdg2a16g43e3g87a7gcb09448a6649"
msgid "I - I have the Bite. Laduguer's Bite."
msgstr "교...'교상'에 걸렸었는데. '러더거의 교상'."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = 5ee13d85-7c7d-c3d8-0479-4039d1a89199
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:5ee13d85-7c7d-c3d8-0479-4039d1a89199
msgctxt "h95d621abg4267g4cb1g8c2dg2dadc0c0dc17"
msgid ""
"Grateful? I've got Laduguer's Bite! I'm dying! Why else do you think I was "
"petrified?"
msgstr "감사? 난 '러더거의 교상'에 걸렸었어! 죽어가고 있었다고! 그게 아니면 왜 내가 석화 상태로 있었겠어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = 5faab5f3-ed18-be4d-b5b1-4a77991fbbb0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:5faab5f3-ed18-be4d-b5b1-4a77991fbbb0
msgctxt "h7c72a90bg7d23g477cgafd0g65e72c96bcb5"
msgid "I - I don't know. Days? Years?"
msgstr "나 - 나도 모르겠어. 며칠? 몇 년?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = 60cacdcf-3dad-98fe-c9eb-b7f445548589
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAG_HagLair_Victim_001_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:60cacdcf-3dad-98fe-c9eb-b7f445548589
msgctxt "h911afc10g3d73g4b1dg9663gff7a94013b65"
msgid "I'm getting out of this hellhole. You'd best do the same."
msgstr "이 지옥 같은 곳에서 나가야겠어. 당신네도 그렇게 하라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Player
#. NodeID = 618cfd82-9ffd-bcdd-6f46-80914b52a379
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:618cfd82-9ffd-bcdd-6f46-80914b52a379
msgctxt "hb4b52b49g26aag493dgbc12g957275e36240"
msgid "I'm here to help."
msgstr "당신을 도와주러 왔어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Player
#. NodeID = 637e56cd-a41e-c4a5-1046-066d3c853ddb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:637e56cd-a41e-c4a5-1046-066d3c853ddb
msgctxt "hbe9bcabcg5d05g4318gbe8ag326c1049c635"
msgid "You don't sound pleased. Would you rather be a statue?"
msgstr "별로 달가워 보이지 않는데. 그냥 석상으로 돌아가고 싶은 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = 66fbcad8-d8e3-7224-bc9c-bba65cff9cbe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:66fbcad8-d8e3-7224-bc9c-bba65cff9cbe
msgctxt "ha7372bb1g880dg4299g9cefg895eda10a137"
msgid ""
"I was on death's door when the hag cast... wait. You didn't - you didn't "
"cure the Bite?"
msgstr "내가 죽음의 문턱에 있을 때 해그가 주문을 걸었는데... 가만. 치료한 거야? '교상' 치료했냐고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = 67262972-d137-acf4-f688-7390111580a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:67262972-d137-acf4-f688-7390111580a6
msgctxt "he2b87108g10a0g4ebaga16bgdc1e78882554"
msgid "How did you cure it? The Bite?"
msgstr "'교상'은 어떻게 치료한 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Player
#. NodeID = 6a1e4b0e-2c1c-ad42-4d0e-00db646bbffd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:6a1e4b0e-2c1c-ad42-4d0e-00db646bbffd
msgctxt "hccb47d78g619ag4fccgab0dg380ef69cf287"
msgid "I'm sorry this happened to you."
msgstr "네게 이런 일이 생겨서 유감이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = 6b29eb9d-8f20-10cc-30b9-6d5d3d8041d3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_Hag_SummonedVictims = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:6b29eb9d-8f20-10cc-30b9-6d5d3d8041d3
msgctxt "he6535d22geb94g4660g9653g7cf53e22ac99"
msgid "Ungh... what... argh... what happened?"
msgstr "으으... 무슨... 으윽... 어떻게 된 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Player
#. NodeID = 6d98259f-27aa-39e9-d039-df15126e8f89
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:6d98259f-27aa-39e9-d039-df15126e8f89
msgctxt "h1bfb7c2bg7b81g4d14g8616g1da6bee63192"
msgid ""
"In the tales, hags always cook up their victim's misery first, then sell "
"them false hope."
msgstr "설화를 보면, 해그는 항상 희생자의 고통을 먼저 꾸며낸 다음, 거짓된 희망을 팔더라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Player
#. NodeID = 6e594886-70d2-7fbe-fb05-46b315011720
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WIZARD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:6e594886-70d2-7fbe-fb05-46b315011720
msgctxt "hd2173823gf4adg4decg8985g1dd4b627bf88"
msgid "Mordenkainen warns us that hags often cause their victims' tragedies."
msgstr "모덴카이엔은 경고했지. 해그는 희생자에게 비극을 초래하는 경우가 많다고 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = 718587f6-87fd-b613-fd73-8c83fddf5d1e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:718587f6-87fd-b613-fd73-8c83fddf5d1e
msgctxt "hb0c98ac1g40b8g4d53gb4dcg29b02dd0203c"
msgid "<i>What?! </i>How... how am I still breathin'?"
msgstr "<i>뭐?! </i>어떻게... 어떻게 내가 아직 숨 쉬고 있는 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = 73d7e859-8d60-a6f0-65e6-8749720e8e94
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:73d7e859-8d60-a6f0-65e6-8749720e8e94
msgctxt "h94cd291dg1cd7g4a19g892bg85f64657bc3a"
msgid "That double-crossing, filthy, lying hag."
msgstr "그 배신자, 더러운 거짓말쟁이 해그."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = 77c52db6-242a-1196-7e25-9336ba5f9121
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:77c52db6-242a-1196-7e25-9336ba5f9121
msgctxt "h1325b7e2g5c16g4f10g94f8g55b5eb6ac9e3"
msgid "Could you have a look... <i>please. </i>"
msgstr "한번 봐 줘...<i>제발요.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Player
#. NodeID = 7910e04a-640a-c52b-3709-1e27ebc36e0a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SORCERER(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:7910e04a-640a-c52b-3709-1e27ebc36e0a
#, fuzzy
msgctxt "hf6438287gbf40g454eg9888gb39ce2f54dbd"
msgid "<i>Attune with your blood and search him for magic.</i>"
msgstr "<i>피에 흐르는 위브를 조율하여 마법을 찾아본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = 7c182244-2710-fbc1-3078-0350e33a1f15
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DUERGARDWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:7c182244-2710-fbc1-3078-0350e33a1f15
msgctxt "h60ccd174gf00bg4bb9gb0edg43e8120a6c6f"
msgid "Help? You bloody Duergar gave me the Bite! But... the way I feel..."
msgstr "도와준다고? 너네 망할 듀에르가 때문에 '교상'에 걸렸잖아! 하지만... 이 느낌은..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = 7c51e965-f28f-9fef-91c3-0874fb583164
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CharacterDieAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:7c51e965-f28f-9fef-91c3-0874fb583164
msgctxt "hb8f4269egfecdg45d1g95d5g0f5bb671c5c3"
msgid "I don't want to die, I - *retch*"
msgstr "죽고 싶지 않아, 죽고 싶지... *우욱*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Player
#. NodeID = 7dd655de-2f3c-1daf-6266-c1fdc8dad80a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:7dd655de-2f3c-1daf-6266-c1fdc8dad80a
msgctxt "hb518ec09g1b7cg4f98ga4f3ga0eda9209a56"
msgid "What's 'the Bite' exactly?"
msgstr "'교상'이라는 게 정확히 뭐지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Player
#. NodeID = 7f0d1fc0-45fc-cdcf-f317-e0932228de69
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:7f0d1fc0-45fc-cdcf-f317-e0932228de69
msgctxt "h3d50badcg1a47g4078ga2d8gbe2121dbd42c"
msgid "You're in a hag's lair."
msgstr "당신은 해그의 소굴에 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Player
#. NodeID = 826f71ce-86ef-7449-65eb-55f67946adac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:826f71ce-86ef-7449-65eb-55f67946adac
msgctxt "hbd7fac88gab41g4201g8c3ag5b7289726701"
msgid "Don't worry. I didn't help just to get a reward."
msgstr "걱정 마. 뭘 받자고 도와준 게 아니니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = 866922aa-068f-81fa-72c7-8c08854d70ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:866922aa-068f-81fa-72c7-8c08854d70ac
msgctxt "h39f64c70gb96ag46cfgbcf3g06715682da3d"
msgid ""
"I - I remember that bit. I think. She...  turned me to stone. Because of the "
"Bite! Of course."
msgstr "기...기억이 조금 나는 거 같아. 해그가... 날 돌로 만들었어. 그래 맞아. '교상' 때문이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Player
#. NodeID = 89831e6d-c6fc-f44f-6226-45c02889f911
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:89831e6d-c6fc-f44f-6226-45c02889f911
msgctxt "h7a565b29gc6a4g402cg8884g024e04e42b80"
msgid "No."
msgstr "아니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = 89879907-0c52-122f-d7f1-a837a2574fb0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:89879907-0c52-122f-d7f1-a837a2574fb0
msgctxt "ha62bed42g9058g496cg908eg10c2d7b47786"
msgid "Oh, no, no. Why - why did you remove the spell if ya couldn't fix me?!"
msgstr "오, 안 돼, 안 돼. 왜... 왜 치료할 수도 없으면서 주문을 해제한 거야?!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = 8c3e9210-46bc-1940-423b-bba39bee255e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:8c3e9210-46bc-1940-423b-bba39bee255e
msgctxt "h16f72695g0dd4g4c4dg9622gf01826cd5656"
msgid "Oh no. No. Why ain't I petrified?"
msgstr "오, 안 돼. 안 돼. 왜 내가 석화 상태가 아닌 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = 8cc9229b-bf6f-8a9b-7afd-15825e9333ec
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GEN_DisappearOutOfSightWhenAvailable(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:8cc9229b-bf6f-8a9b-7afd-15825e9333ec
msgctxt "hba2edc01g3047g4ba2g9fffgd5f467144f30"
msgid ""
"Yer right. And look... thank you. I don't know how you pulled it off - but "
"thank you."
msgstr "네 말이 맞아. 그리고 이봐... 고마워. 어떻게 날 구해줬는지는 몰라도 정말 고마워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = 8ea8bb93-8757-32b2-c04a-3e23ff008f50
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:8ea8bb93-8757-32b2-c04a-3e23ff008f50
msgctxt "hb07a9803g9ac3g4265g8deagbbc23e2a7d12"
msgid "Why would you turn me back if you didn't -"
msgstr "왜 날 돌려놓은 거야. 치료하지도 않았으면서..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = 91b77309-4778-33ce-e608-29091df49b70
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:91b77309-4778-33ce-e608-29091df49b70
msgctxt "hadd9ecacg584bg4dedga2e0g679c5806c942"
msgid "Heh. I thought the same, 'til I held me own in my arms."
msgstr "헤. 아이들을 내 팔로 안기 전까지는 나도 너와 똑같은 생각이었지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Narrator
#. NodeID = 92e09279-de26-396c-bf09-c8e95e699dfc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:92e09279-de26-396c-bf09-c8e95e699dfc
msgctxt "h16631738g0fd6g4b8cg9f32g388e1dd4f8f1"
msgid ""
"*You can't detect anything. You have no explanation for his good health.*"
msgstr "*당신은 아무것도 감지하지 못합니다. 그의 건강함을 설명할 길이 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = 93e696c2-79fa-ab07-6d0d-b1314d0c1216
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:93e696c2-79fa-ab07-6d0d-b1314d0c1216
msgctxt "h05f2a820g9948g4826gafefgf510cada85ff"
msgid ""
"Why d'ya think I came to the hag? It was get petrified... or end up covered "
"in me own insides."
msgstr "내가 왜 해그에게 갔겠어? 석화되거나... 내장을 뒤집어쓰고 죽는 거였다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Player
#. NodeID = 9723d757-9c77-b9e1-c206-868059126cc4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SORCERER(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:9723d757-9c77-b9e1-c206-868059126cc4
msgctxt "h050c6ce1g72e6g45d5g8295g1a2958777e5e"
msgid "I can feel the hag's magic on you - it tastes of sickness."
msgstr "너에게서 해그의 마법이 느껴져. 질병의 기미가 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Player
#. NodeID = a8d2ebe3-3bff-3f63-87ac-3b38559bf905
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:a8d2ebe3-3bff-3f63-87ac-3b38559bf905
msgctxt "h94eccd9bge14dg427fg883bgf7e751a15356"
msgid "Hmm? What was that?"
msgstr "흐음? 이 부분을 보자면?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Player
#. NodeID = aa2f1559-81d2-2cac-0821-59052838fc30
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_Hag_State_IsDead = False
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:aa2f1559-81d2-2cac-0821-59052838fc30
msgctxt "h5a6c0b7dg9e0fg4b3dga6e9gc8276553e80d"
msgid "The hag is gone."
msgstr "해그는 죽었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = aa5cb8d8-0c7d-e6c9-b26e-19c2b60bdce9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:aa5cb8d8-0c7d-e6c9-b26e-19c2b60bdce9
msgctxt "h7d6f078dg0340g4abfg8c21g5291c7ee4659"
msgid "You didn't fix it? Oh no."
msgstr "치료 안 한 거야? 오, 안돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = ac175254-2756-b6c7-0462-6fa635832405
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:ac175254-2756-b6c7-0462-6fa635832405
msgctxt "h233bbb70gdcdcg4010g9d39g4e963ebbf072"
msgid "Because nothing disgusts us more than you lot."
msgstr "왜냐하면 네놈들만큼 우리에게 역겨운 건 없기 때문이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = ad066180-ee94-e1b9-fecf-547f3ea2dc97
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:ad066180-ee94-e1b9-fecf-547f3ea2dc97
msgctxt "h9f2a1052g6ba0g4642g9d0fg5802c130ac62"
msgid "Evil don't begin to cover it."
msgstr "이건 사악한 것보다 더 심한 거라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = ae831969-5e0e-a620-8bc1-06437c41c241
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:ae831969-5e0e-a620-8bc1-06437c41c241
msgctxt "h9f0abab5gbe52g40d1gbacagf59856437598"
msgid "What? Are you sayin' it wasn't the Bite? But... bloody hells."
msgstr "뭐? 그럼 '교상'이 아니란 말이야? 하지만... 이런 망할."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Player
#. NodeID = b4e2d264-f5d5-4dbc-ed4a-5110c40f29f6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DWARF(1) = True
#.      - BARD(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:b4e2d264-f5d5-4dbc-ed4a-5110c40f29f6
msgctxt "h349626b0g7401g4723ga6f3g573d9e8dcabd"
msgid "Laduguer's Bite? How'd you catch it?"
msgstr "'러더거의 교상'? 어떻게 걸린 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = b5d886f1-6ee7-5842-832a-cebff89fe4f6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:b5d886f1-6ee7-5842-832a-cebff89fe4f6
msgctxt "hc9b6e68dg31aeg4515g9c82gfeb9c777428c"
msgid "The stones know how old they are now."
msgstr "이젠 돌들이 아이들이 몇 살인지 알겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = b6e804d0-64aa-9597-300d-4f9d9dcb6eb1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:b6e804d0-64aa-9597-300d-4f9d9dcb6eb1
msgctxt "h9782dfefgd244g4973g8e73gcb4b869a5195"
msgid ""
"Right? It was that or die covered in me own insides. It's why she petrified "
"me - to stop the spread."
msgstr "그렇지? 아니면 내장을 뒤집어쓰고 죽는 거였어. 그래서 확산을 막으려고 해그가 날 석화한 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = b80e18d4-1f9b-90a2-78cd-f1e9bcd47960
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:b80e18d4-1f9b-90a2-78cd-f1e9bcd47960
msgctxt "h4f3e96c1gada6g4f10g9617g1863d2009fbc"
msgid "What? But that doesn't make a lick of sense. Unless..."
msgstr "뭐? 하지만 그건 전혀 말이 안 되는데. 혹시..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = bac553f8-cf6a-ed5c-aa80-6f177779a4e5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:bac553f8-cf6a-ed5c-aa80-6f177779a4e5
msgctxt "h32997dc6gec7dg4d4egb2eeg3f10e1902e84"
msgid ""
"I've the bloody Bite! Laduguer's Bite! The petrification stopped it "
"spreading..."
msgstr "난 망할 '교상'에 걸렸다고! '러더거의 교상'! 석화가 확산을 막아주는 거였는데..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Player
#. NodeID = bb9b8317-414f-83ea-5fe1-7870d9e414c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:bb9b8317-414f-83ea-5fe1-7870d9e414c8
msgctxt "h44477f12g66feg4d46g992dg8d2f28582851"
msgid "Hopefully they've grown. Children are disgusting."
msgstr "다 자랐으면 좋겠네. 아이들은 역겹잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = bba6d453-1319-84ec-a177-6365ebfd263f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:bba6d453-1319-84ec-a177-6365ebfd263f
msgctxt "h4da541e3g7a10g48b0gb6dfg571dbd23acfa"
msgid "I s'pose I should count my blessings. Most ain't so lucky."
msgstr "나에게도 이런 축복이 오긴 오나 보네. 대부분 운이 없었거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Narrator
#. NodeID = bd2d3d64-a32f-804e-558e-61144e9e3458
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:bd2d3d64-a32f-804e-558e-61144e9e3458
msgctxt "hb33371b4g5c41g4d44g8e1fg0d0663a8ad5b"
msgid ""
"*You detect traces of decaying magic within him. Likely the cause of his "
"disease.*"
msgstr "*당신은 그의 몸 안에서 썩어가는 마법의 흔적을 감지합니다. 아마도 질병의 원인일 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = bf397116-15b1-3704-780c-93c39b54ccd2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:bf397116-15b1-3704-780c-93c39b54ccd2
msgctxt "h92e4a191g08f8g4112ga291g0f15f41798f5"
msgid "Why d'ya think I'm here? The hag petrified me. Only way to stop it."
msgstr "내가 왜 여기 있겠어? 그 해그가 날 석화한 거야. 그 방법만이 멈출 수 있었다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = c0cdb83d-7a3b-21e2-c6ec-6137207636c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:c0cdb83d-7a3b-21e2-c6ec-6137207636c6
msgctxt "hbd4a96e6g613ag4e0cg86aag71c3d8d5f4ab"
msgid ""
"Not enough to hang around here, mind, but... thank you. And best of luck."
msgstr "여기서 돌아다니기엔 아직 불편하긴 하지만... 고마워. 그리고 행운을 빌게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = c4333b48-b600-20a8-88d3-4d800a6ccb1e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:c4333b48-b600-20a8-88d3-4d800a6ccb1e
msgctxt "h6752944dg4993g4685g87e9gb8bf3d46dee5"
msgid "Ain't nothin' like it."
msgstr "그보다 좋을 순 없더라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Player
#. NodeID = c4591ffa-00c0-92da-9f7e-6925e22ee68c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:c4591ffa-00c0-92da-9f7e-6925e22ee68c
msgctxt "hcf8a8ee2gb062g46f7g8e45gd6ad3423b74b"
msgid ""
"We 'greylings' know the Bite well - ask nicely, and I'll see how long you've "
"got left."
msgstr "우리 '회색쟁이'가 '교상'에 대해 좀 잘 알지. 공손하게 부탁해 봐. 그러면 얼마나 남았나 한번 봐줄 테니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = c71c2443-1313-b9e4-5279-754ee1e65774
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:c71c2443-1313-b9e4-5279-754ee1e65774
msgctxt "h3352f83cg33e1g488dg8478g0d7fe810cc6c"
msgid "I... only wish I could do more to repay you."
msgstr "내... 내가 보상을 더 해줘야 좋을 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = c846f66a-85f2-c941-05c8-6445206e3af0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:c846f66a-85f2-c941-05c8-6445206e3af0
msgctxt "hf862d744g2447g431bg988cg2498cfa16204"
msgid ""
"Tell you what, you ever come by my way? You've a seat at my dinner table."
msgstr "좋은 생각이 있어, 언젠가 날 찾아오겠어? 저녁 식사를 같이하는 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = c9028c58-c027-e283-921c-f99e682d3114
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:c9028c58-c027-e283-921c-f99e682d3114
msgctxt "h837e54c5g9922g4defgaf70g375d3f816fbf"
msgid "Gods, no - Argh. <i>Help.</i>"
msgstr "신이시여, 안돼 - 으윽. <i>살려줘.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Narrator
#. NodeID = c9d734d8-92af-b012-c16e-9190bce3503e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:c9d734d8-92af-b012-c16e-9190bce3503e
msgctxt "h7c01e2b1gf12fg4802g9a38g65e3ca185cfa"
msgid ""
"*Not only is the disease gone, you see it's left no scars - an impossibility "
"for the Bite.*"
msgstr "*질병이 사라졌을 뿐만 아니라, 어떤 상처도 남지 않았습니다. '교상'이라면 불가능한 일 입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Player
#. NodeID = ca59c3b0-8a76-fc15-2023-289ea83db411
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:ca59c3b0-8a76-fc15-2023-289ea83db411
msgctxt "h762dfbb9g45bfg404egbf98g762d99e3e10d"
msgid "Isn't Laduguer's Bite terminal?"
msgstr "'러더거의 교상'은 치명적일 텐데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = cd96afd0-268f-d001-c31d-3bdc24f46fb2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:cd96afd0-268f-d001-c31d-3bdc24f46fb2
msgctxt "h5c15eabcgc35eg4d6fg82e1g657d77ddaea9"
msgid "I've the Bite..."
msgstr "난 '교상'에 걸렸다고..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = cda14efd-8b07-d1a5-57d7-27bf0cd0d6cc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:cda14efd-8b07-d1a5-57d7-27bf0cd0d6cc
msgctxt "h8092bf68g172cg4135g8706gc344836bedbb"
msgid ""
"I left me wife, me kids behind, for fear of infecting them. They were only "
"babes."
msgstr "난 아내도, 아이들도 뒤로 하고 떠나야 했지. 전염될까 봐 걱정됐어. 아이들은 그냥 아기였는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = d18b5644-0750-053d-3651-b5e054fa11f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:d18b5644-0750-053d-3651-b5e054fa11f5
msgctxt "hb45862d7g398bg4f7aga0a9g79f4397c420a"
msgid "But - but how? The hag said there was no cure."
msgstr "하- 하지만 어떻게? 해그가 치료법은 없다고 했는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Player
#. NodeID = d3ce89de-6e3f-1889-d7ec-29950139ab8f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WARLOCK(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:d3ce89de-6e3f-1889-d7ec-29950139ab8f
msgctxt "hc49f43afg2026g4fdeg9213g213efe337f0b"
msgid "What kind of fool would make a pact with a hag?"
msgstr "세상에 어떤 바보가 해그하고 계약하지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Player
#. NodeID = d4352d93-cb27-468c-dc52-fa3feca8cdff
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_ILMATER or PALADIN_ILMATER
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:d4352d93-cb27-468c-dc52-fa3feca8cdff
msgctxt "hd508d512g833bg42d3gb34dg59926d7fd0d7"
msgid "<i>Search for any sign of Laduguer's Bite.</i>"
msgstr "<i>'러더거의 교상' 징후를 찾는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Player
#. NodeID = d499d73a-f786-381c-2cea-a3991bbde7c5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:d499d73a-f786-381c-2cea-a3991bbde7c5
msgctxt "hc9cbc216gb0cfg4b29g8193gece756167012"
msgid "Focus on the positive. At least now you'll see them again."
msgstr "긍정적인 면을 보자고. 적어도 이젠 가족을 볼 수 있게 됐잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = d574afbd-7696-dffc-d8de-7f2067903739
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:d574afbd-7696-dffc-d8de-7f2067903739
msgctxt "h3d2472e1g913bg472agbcedg9b0788145f73"
msgid "I can't believe you fixed it. How did you cure me?"
msgstr "날 치료했다는 게 믿기지 않아. 어떻게 한 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = d62b861c-a62c-8ab1-9fce-eb09b4322e64
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:d62b861c-a62c-8ab1-9fce-eb09b4322e64
msgctxt "h229555a7geecag498egb246gd564a54a5993"
msgid "I had no bloody choice! I'm dying!"
msgstr "망할 선택의 여지가 없었으니까! 난 죽어가고 있었다고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Player
#. NodeID = d9c83971-f3b3-4f44-c3b2-5831126c99cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:d9c83971-f3b3-4f44-c3b2-5831126c99cb
msgctxt "h43dcb2f0g4a66g425dg91cega3a8247ebcf0"
msgid "You... want to be petrified?"
msgstr "석...석화되고 싶다고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = dc5095bc-9ac5-262e-2e08-4ed83cf052c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:dc5095bc-9ac5-262e-2e08-4ed83cf052c1
msgctxt "ha20fc64ag0251g4873gb4c5g471a1b7b806d"
msgid "I... could you have a look?"
msgstr "하...한번 봐 주겠다고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = dda5b01a-0033-e506-e3a9-41a7887442d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:dda5b01a-0033-e506-e3a9-41a7887442d8
msgctxt "h77a9e62dg3f0eg4ba7gae92g51e0a48cbfb7"
msgid ""
"I'll get to see them again, hold 'em again, 'cause of you. I - I ain't got "
"not way to repay you."
msgstr "다시 가족을 보게 될 거야, 다시 안을 수 있다고, 네 덕분이야. 내... 내가 어떻게 보답할 방법이 없네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = de138a3f-046a-d428-b4dc-deadcb5accf6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:de138a3f-046a-d428-b4dc-deadcb5accf6
msgctxt "h7c97f3ffgdf02g410eg88a7gd6e977ab7e05"
msgid "Well - yes. Why d'ya bloody think I'm here?"
msgstr "그럼 당연하지. 그럼 내가 왜 이 망할 곳에 있겠어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = df878751-e923-25b7-feb8-92e0394790a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:df878751-e923-25b7-feb8-92e0394790a6
msgctxt "h75894efag7288g45abga945g30aabcfec28c"
msgid ""
"Gods, r-really? I thought I was dead. I was sure...  thank you. Thank you so "
"much."
msgstr "신이시여, 저...정말이야? 완전히 죽은 목숨인 줄 알았는데... 고마워. 정말 고마워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Player
#. NodeID = e05a39e5-286d-bc85-c5bf-aa63ba83a0ba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:e05a39e5-286d-bc85-c5bf-aa63ba83a0ba
msgctxt "hb949655agbf0bg45b8g91c6g72a5fd5a7e2e"
msgid "You should be grateful. I expect payment."
msgstr "내게 감사해야지. 보상을 기대하겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = e2435f04-8c28-fd13-7f48-1e846894972c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:e2435f04-8c28-fd13-7f48-1e846894972c
msgctxt "hb2bba163g547cg4fc4gb21fg25a04845fa3c"
msgid "Only 'cause of you."
msgstr "순전히 네 덕분이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = e3917b91-91d4-3b58-2f63-c62ba073fbe2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GEN_DisappearOutOfSightWhenAvailable(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:e3917b91-91d4-3b58-2f63-c62ba073fbe2
msgctxt "hbac78788gae4cg4e7egbef8g5f8dfd149a36"
msgid "<i>Thank you. </i>"
msgstr "<i>고마워.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = e556b644-9d08-c90b-c267-c2f1adbe1638
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GEN_DisappearOutOfSightWhenAvailable(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:e556b644-9d08-c90b-c267-c2f1adbe1638
msgctxt "h1e4968afg6706g43b1g9c74g560c16775579"
msgid "I don't fancy hangin' around here. But... thank you. And best of luck."
msgstr "더 이상 여기서 돌아다니고 싶진 않지만... 고마워. 그리고 행운을 빌게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = e92169f3-c92d-d311-ce22-dea78312cf91
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:e92169f3-c92d-d311-ce22-dea78312cf91
msgctxt "h78881b42g4dfbg4031g9cf6ga1b6bb63f332"
msgid "I... I ain't got no way to repay you."
msgstr "내... 내가 어떻게 보답할 방법이 없네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = ed80414e-66bf-705c-9671-ca1607338f69
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:ed80414e-66bf-705c-9671-ca1607338f69
msgctxt "hfb1847fbg06c9g48c5ga8b0g2fac5323b00a"
msgid "No - what you've done for me and mine today won't be forgotten."
msgstr "아냐, 나와 내 가족을 위해 오늘 네가 한 일은 절대 잊지 않을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = efd6cd9e-472a-a334-9d66-1b6fb92dfa30
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:efd6cd9e-472a-a334-9d66-1b6fb92dfa30
msgctxt "h4632562agaa5ag46a5g8603g6f98e64f2093"
msgid "'Cause they're <i>family. </i>Why else?"
msgstr "왜냐면 <i>가족</i>이잖아. 다른 이유가 있어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = f14d05dc-06a0-3e4b-839d-f2f76459cad2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:f14d05dc-06a0-3e4b-839d-f2f76459cad2
msgctxt "hf2689295g36eag4206g8098g3484352280c7"
msgid "I was on death's door. But now I feel... I feel <i>great. </i>"
msgstr "난 죽음의 문턱에 있었어. 하지만 지금은 기분이... 기분이 <i>끝내줘.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = f194d2c8-945a-5398-0e04-82f2e736dcd8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:f194d2c8-945a-5398-0e04-82f2e736dcd8
msgctxt "hb811be8dg8881g4a5dg8ffage2fdca823a7e"
msgid ""
"I had to. I was sick. Real sick. The hag petrified me - to stop it spreading."
msgstr "그래야 했지. 난 병들었거든. 정말 아팠어. 확산을 막으려고 해그가 날 석화한 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Player
#. NodeID = f662920d-2680-3117-9248-4628b21cc211
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:f662920d-2680-3117-9248-4628b21cc211
msgctxt "hb6e821e4ga30bg4ebdgadf4g0768377fd522"
msgid "I fixed your petrification - nothing else."
msgstr "석화만 해제한 거지 다른 건 안 했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = f86922f7-c6f7-8094-4842-01b5db0e29ee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:f86922f7-c6f7-8094-4842-01b5db0e29ee
msgctxt "hacdaaae9g62b5g4ca1g8041g16d13f3cb9b3"
msgid ""
"Better dead than a greyling. Why d'ya think we call it Laduguer's Bite? "
"After that slaver of a god you adore?"
msgstr "회색쟁이보단 죽는 게 낫지. 우리가 왜 '러더거의 교상'이라 부르겠냐? 네놈이 숭배하는 신의 노예 이름을 왜 땄겠어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Player
#. NodeID = f86a4583-1510-3a2f-f848-81eafc84c94a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:f86a4583-1510-3a2f-f848-81eafc84c94a
msgctxt "h9e9b38aag37e9g41e1gaa34gf7182a5e70c2"
msgid "Why would you wish to meet your spawn?"
msgstr "왜 자식을 만나고 싶어 하는 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Player
#. NodeID = fb2456d8-0628-effa-628e-e93d4c8b801c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:fb2456d8-0628-effa-628e-e93d4c8b801c
msgctxt "hc2071661g5a3bg4d9fg8c63g70aa31b81475"
msgid "Changed my mind. Enjoy tripping over your own guts."
msgstr "마음이 바뀌었어. 네 내장에서 미끄럼타며 즐기기 나 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Player
#. NodeID = fbb4bc94-c54c-3d01-3f15-8be305c0ccc3
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - REALLY_DUERGARDWARF(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:fbb4bc94-c54c-3d01-3f15-8be305c0ccc3
msgctxt "h7d84b9dbg6c6eg4ce2ga47bg20076e364168"
msgid "<i>Examine him for signs of Laduguer's Bite.</i>"
msgstr "<i>그에게 '러더거의 교상' 징후가 있는지 검사한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = fc7a451d-c936-7393-fd27-92236154f840
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:fc7a451d-c936-7393-fd27-92236154f840
msgctxt "he925a26bg9168g442ag8a36ge7cb814d7fdc"
msgid ""
"Laduguer's  Bite? I caught it when - wait. You didn't... you didn't fix it?"
msgstr "'러더거의 교상'? 내가 걸렸었던... 가만. 치료한 거야? 치료했냐고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001
#. Speaker = Efrin
#. NodeID = feba1cee-6378-a1df-3214-e95a9c5099ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001:feba1cee-6378-a1df-3214-e95a9c5099ae
msgctxt "h5cfc7d29gb8d2g4c1bg9cb5gf4806dbbe967"
msgid ""
"But that doesn't make a lick of sense. The Bite ain't magical. Unless..."
msgstr "하지만 그건 전혀 말이 안 된다고. '교상'은 마법적인 게 아냐. 혹시..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001_Dead
#. Speaker = Player
#. NodeID = 136f2ae0-fa80-5215-116f-546765d5f06f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001_Dead:136f2ae0-fa80-5215-116f-546765d5f06f
msgctxt "ha8fae574g60f8g4b14g9ba3g4192d539322d"
msgid "What is your name?"
msgstr "당신의 이름은 뭐지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001_Dead
#. Speaker = Player
#. NodeID = 37ce04c1-3b53-9400-36e5-4497eec99d3b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001_Dead:37ce04c1-3b53-9400-36e5-4497eec99d3b
msgctxt "h58243dd0g5f3dg4022g9aa6g88e5d2fcd1d2"
msgid "Cured? Were you sick?"
msgstr "치료되었다고? 어디 아팠나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001_Dead
#. Speaker = Efrin
#. NodeID = 3f4745e2-1d9d-23cd-4675-0c6f9eada512
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001_Dead:3f4745e2-1d9d-23cd-4675-0c6f9eada512
msgctxt "h7e8defc8g3135g40d6g952egdd648ec272d2"
msgid "... wonder what... they look like now..."
msgstr "... 알고 싶다... 애들은 지금 어떤지..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001_Dead
#. Speaker = Efrin
#. NodeID = 676d2c56-a813-8153-e2f6-58cfd378f711
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001_Dead:676d2c56-a813-8153-e2f6-58cfd378f711
msgctxt "hf6403df0gd8a5g44edg838egd5c5ce94cf00"
msgid "I'm... cured."
msgstr "나는... 치료되었다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001_Dead
#. Speaker = Narrator
#. NodeID = 6b8e0d66-5d39-91f1-a6ea-61cfeeabe51e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001_Dead:6b8e0d66-5d39-91f1-a6ea-61cfeeabe51e
msgctxt "hfa0c2f8ege585g4092g823egb321bd9438c5"
msgid "*The spell's power wanes. You can ask no more questions.*"
msgstr "*주문의 힘이 약해집니다. 더 이상 질문을 할 수 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001_Dead
#. Speaker = Player
#. NodeID = 6bcd8651-4e6e-fcc6-073f-05e9a42d86de
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001_Dead:6bcd8651-4e6e-fcc6-073f-05e9a42d86de
msgctxt "hb489dff1g5c0bg4ac0gb75ag3bfa5e1e6c72"
msgid "What can you tell me about the hag?"
msgstr "해그에 대해 무엇을 말해줄 수 있지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001_Dead
#. Speaker = Efrin
#. NodeID = 6f57c81a-3ce6-0c42-23ec-a5ae95e4e474
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001_Dead:6f57c81a-3ce6-0c42-23ec-a5ae95e4e474
msgctxt "h434277ceg4df9g4f3dgb930g0512014d0e45"
msgid "Efrin... Hammerborn..."
msgstr "에프린... 해머본..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001_Dead
#. Speaker = Efrin
#. NodeID = ab2e137f-ec6a-92b9-1d14-fa3467d9c70a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001_Dead:ab2e137f-ec6a-92b9-1d14-fa3467d9c70a
msgctxt "h39a32a7eg6a95g44a8g9643g98251f4250b3"
msgid "Got sick... had to leave home... leave my children..."
msgstr "병에 걸렸다... 집과 내 자식들을... 떠나야 했다..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001_Dead
#. Speaker = Efrin
#. NodeID = b1d95cd7-6b13-ca80-8af9-63cae481b6b7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001_Dead:b1d95cd7-6b13-ca80-8af9-63cae481b6b7
msgctxt "h3426ce99gdeddg4275g8081gded09e569540"
msgid "Hag turned me... to stone. Stopped the... spread."
msgstr "해그가 나를... 돌로 만들었다. 확산을... 멈췄다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001_Dead
#. Speaker = Efrin
#. NodeID = c2899dc7-e00c-6564-fd30-8c4690068948
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001_Dead:c2899dc7-e00c-6564-fd30-8c4690068948
msgctxt "h588f1deag3798g4a46g9214g84bad28d2e41"
msgid "I'd the Bite... Laduguer's Bite... sickness worse than... death."
msgstr "'교상'에 걸렸었다... '러더거의 교상'... 그 아픔은... 죽음보다 더하다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001_Dead
#. Speaker = Player
#. NodeID = c4177f34-ffcc-0123-fefb-5ca1d57b6d84
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001_Dead:c4177f34-ffcc-0123-fefb-5ca1d57b6d84
msgctxt "h4242700ag229fg47f0ga3c1ge2bcb4231cac"
msgid "What happened to you?"
msgstr "무슨 일이 있었지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001_Dead
#. Speaker = Efrin
#. NodeID = cc0af567-97bc-1baf-ad35-a510af8c400f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001_Dead:cc0af567-97bc-1baf-ad35-a510af8c400f
msgctxt "h805473b1ga2ebg4cd7g81c6g86cfd4c86951"
msgid "She'll give you more... than you bargained... for..."
msgstr "그녀는 네가 약속받은 것... 그 이상을 줄 것이다..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001_Dead
#. Speaker = Player
#. NodeID = d104e0a1-b569-5dea-e0e9-3cfa21626fc0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001_Dead:d104e0a1-b569-5dea-e0e9-3cfa21626fc0
msgctxt "hf74a6766g89aag4342g969agd2e8188e4b63"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001_Dead
#. Speaker = Narrator
#. NodeID = e6d5ce58-7775-9077-c734-294e2b0078bb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_001_Dead:e6d5ce58-7775-9077-c734-294e2b0078bb
msgctxt "h59e71f00g6fc1g4011gbc94g7d91c0054be6"
msgid "*The corpse does not stir. It will answer no more questions.*"
msgstr "*시체는 움직이지 않습니다. 더 이상 질문을 받지 않을 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Player
#. NodeID = 0777851a-e592-924d-77da-d36d88692ba0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:0777851a-e592-924d-77da-d36d88692ba0
msgctxt "h245724c3g92eag4abfg8833gcd5e234f77d0"
msgid "Your vision is false. I would never become a <i>ghaik</i>."
msgstr "너의 시야는 거짓이다. 나는 <i>게이크</i>가 되지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Player
#. NodeID = 0967c5a1-b14a-7dfa-7959-505a5a28f212
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WIZARD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:0967c5a1-b14a-7dfa-7959-505a5a28f212
msgctxt "hced21377g1af5g4a30gb93cga54eb14e0cdb"
msgid "You're under a fey spell - a powerful illusion, perhaps."
msgstr "아마도 넌 페이 주문에 걸려있어 - 강력한 환영이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Player
#. NodeID = 0dc697e4-d070-0d95-ae2f-23fb30f97691
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:0dc697e4-d070-0d95-ae2f-23fb30f97691
msgctxt "h15158636g4c9dg45a9gb1d9g1a02e2b4fe15"
msgid "<i>Silently step away.</i>"
msgstr "<i>조용히 물러난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Player
#. NodeID = 116c5311-4db9-a85f-fc7a-743675fb2517
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DROWELF(1) = False
#.      - REALLY_ELF(1) = True
#.   User:
#.      - HAG_HagLair_Victim_003_Knows_Mindflayer(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:116c5311-4db9-a85f-fc7a-743675fb2517
msgctxt "haa08ca1cgaee0g408egb040g87c7ed3f487b"
msgid "Master yourself. What ails you?"
msgstr "네 자신을 통제해봐. 뭐가 널 괴롭게 하는 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Lorin
#. NodeID = 17d6d1d8-807e-4584-f2aa-278eb10b2de6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:17d6d1d8-807e-4584-f2aa-278eb10b2de6
msgctxt "h78874dfdg29f3g4829g8e9dgc211390b8e6a"
msgid "I see it. I see what's to come."
msgstr "보여. 앞으로 무엇이 있을지 보여."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Lorin
#. NodeID = 1a78fe85-3bc6-daac-d533-6c9d6ed6df3f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:1a78fe85-3bc6-daac-d533-6c9d6ed6df3f
msgctxt "h25b92edeg1234g4772g8c19g4e1b8e9030c6"
msgid "AH! Nononono - I'msorry. I - I - I -"
msgstr "으아아! 안돼안돼안돼. 내가 잘못했어. 내-내-내-"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Player
#. NodeID = 1ab16c31-1f60-cbd0-7261-d8abaae263ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:1ab16c31-1f60-cbd0-7261-d8abaae263ec
msgctxt "h8c543944gf1f0g4d28gb1f1g99d7a02ac4a2"
msgid "Every time you open your mouth, it gets a little more tempting."
msgstr "네가 입을 열때마다 조금씩 그러고 싶어지는걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Lorin
#. NodeID = 1fcd2387-3626-4253-c2db-abacc0894374
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_HagLair_Victim_003_State_CanSeeMirror = False
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:1fcd2387-3626-4253-c2db-abacc0894374
msgctxt "ha915b6c4g24dfg45d7g8053g85dad7b14af7"
msgid "Everything. Everyone. Dead. DEAD."
msgstr "전부. 모두가. 죽었어. <b>죽었다고.</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Player
#. NodeID = 2211e7dc-3dce-58ea-f5db-532335bf8f77
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:2211e7dc-3dce-58ea-f5db-532335bf8f77
msgctxt "h71b61002g5882g4f55g8e63gd771228e4db2"
msgid "What? Why would I hurt you?"
msgstr "뭐? 왜 내가 당신을 해쳐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Lorin
#. NodeID = 231a67de-7469-1cef-328e-1fa9678ec76c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:231a67de-7469-1cef-328e-1fa9678ec76c
msgctxt "he585bd3eg4078g4455gacf0g5d3cb55755c9"
msgid "Monster. Monster!"
msgstr "괴물. 괴물이야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Lorin
#. NodeID = 238ef0b5-839b-8e89-dcd0-347c67538826
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:238ef0b5-839b-8e89-dcd0-347c67538826
msgctxt "hed4ef490gb127g49c0gb585g3413203afed0"
msgid "Ethel said. Said to look. Tosee. Seetruth. Seedeath. See -"
msgstr "에텔이 말했어. 보라고 말했어. 보라고. 진실을보라고. 죽음을보라고 -"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Lorin
#. NodeID = 251d7784-e873-1a2e-769a-eb6aa3286866
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:251d7784-e873-1a2e-769a-eb6aa3286866
msgctxt "h948d515eg3629g4760ga653ga44b428a55e7"
msgid "Skullsplitting, knifetwisting, gutspilling."
msgstr "두개골을쪼개고, 칼로비틀고, 내장을꺼내고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Lorin
#. NodeID = 25c2c873-d6dc-dbd2-d970-52f1b83bd506
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:25c2c873-d6dc-dbd2-d970-52f1b83bd506
msgctxt "h1cd46be2g8d1fg4bcdg89a0gbe590bd67aa5"
msgid "Lies! Lies. I <i>see</i> it. Seetruth. Seedeath."
msgstr "거짓말! 거짓말이야. 똑똑히 <i>보인다고</i> . 진실이. 죽음이."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Player
#. NodeID = 2a22f9d0-82d5-dee6-45d5-264620962af8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_PLANAR(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:2a22f9d0-82d5-dee6-45d5-264620962af8
msgctxt "hc7cbf30ag437cg4227g9b92geaa82cf9864d"
msgid "Even I know screaming in someone's face like this is not polite."
msgstr "이렇게 다른 사람의 얼굴에 소리를 지르는 것이 예의가 아니라는 것쯤은 나도 알고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Narrator
#. NodeID = 3290b0d7-7a97-19a7-70ee-acc8964f26aa
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - d0351eff-7af0-d2d9-7c15-bf02155b26b7_perceptionsuccess = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:3290b0d7-7a97-19a7-70ee-acc8964f26aa
msgctxt "h572237cega050g4073g863fg209ba157d87b"
msgid "*You realise there's magic at work. Some type of spell - an illusion.*"
msgstr "*당신은 마법이 작용하고 있다는 사실을 깨닫습니다. 일종의 주문, 즉 환영입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Lorin
#. NodeID = 33c4bcc1-2263-2f0b-a908-a8821221fb75
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:33c4bcc1-2263-2f0b-a908-a8821221fb75
msgctxt "hb0286e46g7476g422cg9825g09fe1a7aeeee"
msgid "All future. Allbad. All -"
msgstr "모든 미래가. 모두나빠. 모두 -"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Lorin
#. NodeID = 3bf5a2ef-94f8-2191-75b1-0183f2488e3b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:3bf5a2ef-94f8-2191-75b1-0183f2488e3b
msgctxt "h4d4907b7g9524g4352ga303g6f564a81d519"
msgid "Alwayssay. But it's true. Alwaysdead. Always -"
msgstr "항상말해. 하지만 진실이야. 항상죽어. 항상 -"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Lorin
#. NodeID = 3d7fb943-8cfd-7de6-e1dc-d9dcf1ef1969
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:3d7fb943-8cfd-7de6-e1dc-d9dcf1ef1969
msgctxt "h515cac36g8503g497fg9df2gdc6f3af9ef50"
msgid "Leave me, leavemealone! Please!"
msgstr "날 내버려둬, 날내버려둬! 제발!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Player
#. NodeID = 3de64136-ce82-c953-1b13-e3ee2bab64b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:3de64136-ce82-c953-1b13-e3ee2bab64b4
msgctxt "h36d23c5egbea9g47cbg9724gde2cadc88c77"
msgid "<i>Quietly observe.</i>"
msgstr "<i>조용히 관찰한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Lorin
#. NodeID = 4ccf0785-0683-729f-08e6-a2ce98cebce6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:4ccf0785-0683-729f-08e6-a2ce98cebce6
msgctxt "h3b6c4b51g4f39g473eg80d7g9c3a7b1dae3d"
msgid "Mind... flayer..."
msgstr "마인드... 플레이어..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Player
#. NodeID = 4f3870e8-1ed7-6554-0770-176c95bc93d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:4f3870e8-1ed7-6554-0770-176c95bc93d0
msgctxt "hf8e7a7ceg398cg467dg8ccdg38e3f133d5fe"
msgid "Look at me - I'm not a mind flayer."
msgstr "나를 봐. 나는 마인드 플레이어가 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Player
#. NodeID = 5aa08abf-4ba5-7444-6043-cb0c9a92c91a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LOLTHDROWELF(1) = True
#.   User:
#.      - HAG_HagLair_Victim_003_Knows_Mindflayer(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:5aa08abf-4ba5-7444-6043-cb0c9a92c91a
msgctxt "h30be8831gc160g4af5g943eg2faf28e67d23"
msgid "<i>Watch the darthiir's suffering with glee.</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Lorin
#. NodeID = 5cf26b0b-bb54-1883-9aae-693318bbef1a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_HagLair_Victim_003_State_CanSeeMirror = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:5cf26b0b-bb54-1883-9aae-693318bbef1a
msgctxt "heec9bb01g868ag4ca1g84a6gc36fd408ea60"
msgid "Me. dead. <i>Dead. </i>Fleshrotten. Boneshining."
msgstr "내가 보여. 시체야. <i>시체라고. </i> 살이 썩고 뼈가 튀어나왔어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Lorin
#. NodeID = 5d27e59c-3349-2847-4545-73c7aba1853d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:5d27e59c-3349-2847-4545-73c7aba1853d
msgctxt "h58a5f607g09dcg4192gbfcbg13ee33b7f1ed"
msgid "ARGH. NO. Stop. Tricktricktrick. Monster. MONSTER."
msgstr "아악. 안 돼. 그만둬. 거짓말거짓말거짓말. 괴물. 괴물이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Lorin
#. NodeID = 5e44ea57-f2ad-6772-e487-89acbc09c311
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAG_HagLair_Victim_003_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:5e44ea57-f2ad-6772-e487-89acbc09c311
msgctxt "h7cd9b0f9g26ecg46ccg8f1egbb1a20d31ece"
msgid "Stop. STOP. Makeitstop."
msgstr "멈춰. <b>멈춰.</b> 제발멈춰줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Player
#. NodeID = 609a981a-569d-fc86-6b9e-d5c1225de136
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SELDARINEDROWELF(1) = True
#.   User:
#.      - HAG_HagLair_Victim_003_Knows_Mindflayer(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:609a981a-569d-fc86-6b9e-d5c1225de136
msgctxt "h6f7a5881gb45dg44a8g96cfg367f1961cf47"
msgid "I am not your enemy, wood elf. What ails you? "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Player
#. NodeID = 61f3ccee-a243-d493-f46f-2b5225629cd3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:61f3ccee-a243-d493-f46f-2b5225629cd3
msgctxt "h54141377g13f2g405eg9f9bgda5cba2cc82b"
msgid "<i>Take a deep breath - and ROAR.</i>"
msgstr "<i>숨을 깊이 들이쉰다. 그리고 포효한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Player
#. NodeID = 63dbf266-6374-5d9e-c1d0-6c78128618cf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LOLTHDROWELF(1) = False
#.   User:
#.      - HAG_HagLair_Victim_003_Knows_Mindflayer(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:63dbf266-6374-5d9e-c1d0-6c78128618cf
msgctxt "h51a08ec2gac42g406ag8895g9b4c33fa667f"
msgid "<i>Smile as he twitches and whimpers.</i>"
msgstr "<i>그가 벌벌 떨며 훌쩍거림에 미소를 짓는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Player
#. NodeID = 6f69592a-6df4-560d-e04c-eca936bb6b88
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: BESTIAL or RARE
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:6f69592a-6df4-560d-e04c-eca936bb6b88
msgctxt "h75ed82aag5c00g42bag9fd9g828ea4b01145"
msgid "Not everyone looks like you do, elf. It's shocking, I know."
msgstr "모두가 너처럼 생긴 건 아니란다, 엘프야. 충격적이겠지, 나도 알아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Lorin
#. NodeID = 7171ce0e-d42f-c9ea-bac0-e97be14b8463
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAG_HagLair_Victim_003_HasMet(1) = False
#.   Global:
#.      - HAG_HagLair_Victim_003_State_CanSeeMirror = True
#. SetFlags:
#.   Dialog:
#.     - HAG_HagLair_Victim_003_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:7171ce0e-d42f-c9ea-bac0-e97be14b8463
msgctxt "h15eaaa2ag5dfcg4263g8cf2gd58e182df82f"
msgid "No... No. Don't look. Musn'tlook. Musn'tsee."
msgstr "안 돼... 안 돼. 보지 마. 봐서는 안 돼. 절대 보면 안 돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Player
#. NodeID = 719cdeae-39d8-c979-886b-593cd07a777f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - LOLTHDROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:719cdeae-39d8-c979-886b-593cd07a777f
msgctxt "h9b0c34ccgd5f5g428cg9ac7gdf9936b316a6"
msgid "My people do not take orders from your kind."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Player
#. NodeID = 76c477cf-3910-c958-c528-ca3dbd082c64
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:76c477cf-3910-c958-c528-ca3dbd082c64
msgctxt "h7b1192d8gf067g4a0eg9ea9g63d41db4b323"
msgid "<i>Speak in your mother tongue - try to calm him.</i>"
msgstr "<i>엘프어로 말해 그를 진정시킨다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Lorin
#. NodeID = 77d97fb4-3cd4-3732-fd89-63959eeba42e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   User:
#.     - HAG_HagLair_Victim_003_Knows_Mindflayer(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:77d97fb4-3cd4-3732-fd89-63959eeba42e
msgctxt "ha84fd5ffg8726g4d32gb82agf18b2d30faab"
msgid "Mindripping, fleshpeeling. MIND FLAYER."
msgstr "마음을 찢고, 살을 벗겨내는. 마인드 플레이어잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Lorin
#. NodeID = 7a0c77eb-0149-f4dd-9e1b-a3a703e4aea6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:7a0c77eb-0149-f4dd-9e1b-a3a703e4aea6
msgctxt "hf97bb348g9da3g4bd6g85ebgc0dfdc6bc51c"
msgid "Always ask. Never good. Neversee. Never -"
msgstr "항상 물어봐. 좋지 않을 거야. 절대안볼거야. 절대 -"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Player
#. NodeID = 7bf379ac-06b2-7d11-e60a-49faf8ef12b7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SELDARINEDROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:7bf379ac-06b2-7d11-e60a-49faf8ef12b7
msgctxt "h433ee032g9655g4102gb596g4e7ef435e328"
msgid "Be calm. I am not sworn to Lolth. You need not fear me."
msgstr "진정해. 나는 롤쓰를 따르지 않아. 두려워하지 않아도 돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Lorin
#. NodeID = 7e1c8e59-d431-2fc8-bed2-ddf6682b0115
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:7e1c8e59-d431-2fc8-bed2-ddf6682b0115
msgctxt "h39b3eac7gd310g4fd1gab50gc1a4c33611bc"
msgid "I see it - what's to come."
msgstr "보여. 앞으로 무엇이 있을지 보여."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Lorin
#. NodeID = 86c1ff24-3129-9379-c847-48d4078bc89b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:86c1ff24-3129-9379-c847-48d4078bc89b
msgctxt "h4e86268dgd942g4345g93b2g33201e58d21a"
msgid "NO! No. Monster!"
msgstr "안 돼! 안 돼. 괴물이다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Player
#. NodeID = 8db431e6-d6ac-64b3-c854-51c632eef791
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:8db431e6-d6ac-64b3-c854-51c632eef791
msgctxt "h9cb40832g5204g4928ga1bfg15ada5e98734"
msgid "What are you doing? Get out of here."
msgstr "뭐하는 거야? 여기서 당장 나가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Player
#. NodeID = 95d99b82-eaf4-5615-58ea-ebc611ce004c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:95d99b82-eaf4-5615-58ea-ebc611ce004c
msgctxt "h48bb4fa7g3995g495ag8adag157f64bfc08c"
msgid "Hey! Look at me."
msgstr "이봐! 나를 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Player
#. NodeID = 98e2c985-460c-9cd0-7ca8-d2c8d00f6864
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:98e2c985-460c-9cd0-7ca8-d2c8d00f6864
msgctxt "h0e27767fgdbbeg4bc9g8175g1c07c059eee4"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Player
#. NodeID = 9c84bd56-0b52-7abd-e07e-a77770480c90
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - HAG_HagLair_Victim_003_Knows_Mindflayer(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:9c84bd56-0b52-7abd-e07e-a77770480c90
msgctxt "h74da08bfgd421g4038ga5b5gdee6e4239c5e"
msgid "Mustn't look at what, exactly?"
msgstr "정확히 뭘 봐서는 안된다는 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Lorin
#. NodeID = 9f084840-347b-7bb0-3af6-603fba41c333
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:9f084840-347b-7bb0-3af6-603fba41c333
msgctxt "h9d403261g5aa9g4171gaefdgf89fad9a3c36"
msgid "No. Future. Bonesplitting, knifetwisting, skullscreaming future -"
msgstr "아니야. 미래. 뼈가 부러지고 상처가 벌려지고 해골이 비명을 지르는 미래가 -"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Lorin
#. NodeID = a0038308-bd1a-f6d2-bfb8-2ea1ebe0513d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:a0038308-bd1a-f6d2-bfb8-2ea1ebe0513d
msgctxt "hfd86cb66gd6efg43ebga310g1ca9ba577507"
msgid "No. NO. Mind flayer! Getawaygetaway."
msgstr "안 돼. 안 돼. 마인드 플레이어다! 저리가저리가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Player
#. NodeID = a1bb1bfe-ded5-90bb-0cc3-670147ea2458
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_HagLair_Victim_003_State_CanSeeMirror = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:a1bb1bfe-ded5-90bb-0cc3-670147ea2458
msgctxt "h394a34f0g7ac7g408fg9941g30ad091d4e75"
msgid "I just see your reflection."
msgstr "내겐 거울에 비친 네 모습만 보이는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Lorin
#. NodeID = b05d552d-1bd7-839f-9887-bb338c0029da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:b05d552d-1bd7-839f-9887-bb338c0029da
msgctxt "hd563d121gb272g4b11g90d3g0ece60cacd0f"
msgid "No. NO. Can'tstop. Can't -"
msgstr "안 돼. 안 돼. 막을수없어. 못하겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Lorin
#. NodeID = b1a51764-4e77-485f-bda4-a4c3fad5c18b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAG_HagLair_Victim_003_HasMet(1) = False
#.   Global:
#.      - HAG_HagLair_Victim_003_State_CanSeeMirror = False
#. SetFlags:
#.   Dialog:
#.     - HAG_HagLair_Victim_003_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:b1a51764-4e77-485f-bda4-a4c3fad5c18b
msgctxt "hb3410bd0g2c1fg4940gb0acg5b5b9594b4d8"
msgid "No... No. Don't look. Mustn'tlook. Mustn'tsee."
msgstr "안돼... 안돼. 보지 마. 봐서는안돼. 절대보면안돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Lorin
#. NodeID = b2703a0b-39de-ae7b-c531-ec546c90c2f2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:b2703a0b-39de-ae7b-c531-ec546c90c2f2
msgctxt "h43f4b20fgd6c5g4f2fgb6e4g5757d253dfb7"
msgid "Ah! Gods! Don't hurt me. Oh, please, please pleasepleaseplease."
msgstr "아! 신이시여! 저를 해치지 말아요. 오, 제발, 제발 제발제발제발."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Lorin
#. NodeID = b2ebac89-f13c-34e0-e081-f0601f52f2fa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:b2ebac89-f13c-34e0-e081-f0601f52f2fa
msgctxt "he1883d85ge886g4c5eg91f8g2ecd5cd3285b"
msgid "No. Real. REAL. Knifetwisting, bonebreaking, skullsplitting, heart -"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Lorin
#. NodeID = bb1b8a63-bd39-090f-cc11-cb8e0a701ce3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:bb1b8a63-bd39-090f-cc11-cb8e0a701ce3
msgctxt "h7d151197g2cc4g42b2g8f52g186a4bc898a3"
msgid "All future."
msgstr "모든 미래가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Player
#. NodeID = c3f2b58b-7595-3bf5-08cb-af6a1ba64065
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SORCERER(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:c3f2b58b-7595-3bf5-08cb-af6a1ba64065
msgctxt "h127d6e2fg0a42g406bgbeebg1e96d0ee8117"
msgid ""
"What you see isn't real. There's magic at work here - something dark and "
"chaotic."
msgstr "당신이 보고 있는 건 진짜가 아니야. 뭔가 마법에 걸린 것 같군. 어두운 혼돈의 마법에."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Player
#. NodeID = c80ce511-089f-bd02-380b-95c1f2968652
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - d0351eff-7af0-d2d9-7c15-bf02155b26b7_perceptionsuccess = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:c80ce511-089f-bd02-380b-95c1f2968652
msgctxt "h95869a91g3d18g428bg86ffga9c496c2c85a"
msgid "Calm yourself. Whatever you're seeing - it isn't real."
msgstr "진정해. 네가 무엇을 보고 있든, 그건 실제가 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Player
#. NodeID = cb20a174-65e6-bb28-e083-592f13a15d2d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:cb20a174-65e6-bb28-e083-592f13a15d2d
msgctxt "h04a84473g0c87g4ec9ga97egfe4019849780"
msgid "That so? And what does my future hold?"
msgstr "그래? 내 미래는 어떻게 되지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Player
#. NodeID = ea5984ef-da9b-564d-6b88-3ad6f572345a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_HagLair_Victim_003_State_CanSeeMirror = False
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:ea5984ef-da9b-564d-6b88-3ad6f572345a
msgctxt "h696d8e84g4af6g4a1eg927cg8ce82128f4c7"
msgid "Just look away from the mirror. You can leave."
msgstr "그냥 그 거울에서 고개를 돌려. 떠날 수 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Player
#. NodeID = f1713452-fb08-98d0-0c25-7900b0e0a5a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:f1713452-fb08-98d0-0c25-7900b0e0a5a4
msgctxt "h032dad5egd802g4779g962cg2459b5f56046"
msgid "This is nonsense."
msgstr "말도 안 돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Lorin
#. NodeID = f1830330-c701-597e-2595-91e0ce4f8deb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:f1830330-c701-597e-2595-91e0ce4f8deb
msgctxt "h4db65812gf5c4g4027g8197gdfae071d9332"
msgid "Not drow. Neverdrow. Monster. MONSTER."
msgstr "드로우 아니야. 절대드로우. 괴물. <b>괴물</b>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Player
#. NodeID = f74223f8-371e-7c00-cb20-03da49e5caf4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - HAG_HagLair_Victim_003_Knows_Mindflayer(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:f74223f8-371e-7c00-cb20-03da49e5caf4
msgctxt "h4769bb2dg54fdg458dg8b92gb40e0acb1d57"
msgid "Are you all right?"
msgstr "괜찮아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003
#. Speaker = Player
#. NodeID = ff396593-5eb1-c17e-9a6c-467de98a5e3d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003:ff396593-5eb1-c17e-9a6c-467de98a5e3d
msgctxt "h5d9756ddg31f9g4f06gbc4cgfa8450ade5fc"
msgid "You're safe with me, I swear."
msgstr "나와 같이 있으면 안전해. 맹세할게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Dead
#. Speaker = Lorin
#. NodeID = 1c68fd86-1cf3-d7c2-8ca7-3a366b4e0395
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Dead:1c68fd86-1cf3-d7c2-8ca7-3a366b4e0395
msgctxt "hb14010cfgc990g49a6ga41fg689f4f5dd7a9"
msgid "... but all I saw... was <i>death</i>... so I ran... ran here..."
msgstr "... 하지만 내가 본 것은... <i>죽음뿐</i>... 그래서 여기로... 여기로 도망쳤어..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Dead
#. Speaker = Lorin
#. NodeID = 1e28b71e-d05e-968d-c232-377320848ef2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Dead:1e28b71e-d05e-968d-c232-377320848ef2
msgctxt "hd6fb10a6gf053g4f8eg8e31gfec2f2ceaa4d"
msgid "... I could see... a person's fate... <i>horrible.</i>"
msgstr "...사람의... 운명을 볼 수 있었어... <i>끔찍해.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Dead
#. Speaker = Lorin
#. NodeID = 1e452795-1218-0da6-2bc0-de13a1e00347
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Dead:1e452795-1218-0da6-2bc0-de13a1e00347
msgctxt "h25c1fb67g1ab1g44f5g817dg3b93d7949a16"
msgid "... it's gone... finally..."
msgstr "... 드디어... 사라졌어..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Dead
#. Speaker = Lorin
#. NodeID = 210f7714-59c4-7d24-3f75-3209a282ecce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Dead:210f7714-59c4-7d24-3f75-3209a282ecce
msgctxt "he3b56b7bgfce8g4041g9e8ag491f0f6b68e8"
msgid "... she gives you... exactly what... was promised..."
msgstr "... 해그는... 약속한 것을... 반드시 주지..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Dead
#. Speaker = Player
#. NodeID = 377149d7-01b3-b306-3560-fda3cb55ea7c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Dead:377149d7-01b3-b306-3560-fda3cb55ea7c
msgctxt "h4293587ag1b20g4ee3g81fbg59904e2e63eb"
msgid "Who are you?"
msgstr "당신은 누구지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Dead
#. Speaker = Lorin
#. NodeID = 3bfc1a9c-0820-55fb-a595-c80be88015df
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Dead:3bfc1a9c-0820-55fb-a595-c80be88015df
msgctxt "h96b8a2c3gead2g42ddgac7aga1814c908a42"
msgid "The sight..."
msgstr "보이던 것들..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Dead
#. Speaker = Player
#. NodeID = 43154b62-bae3-dbfd-c819-9e210efe7ddc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Dead:43154b62-bae3-dbfd-c819-9e210efe7ddc
msgctxt "hfc85cb68g039fg45efga89fg83f7996099bc"
msgid "Do you regret making a deal with the hag?"
msgstr "해그와 거래한 것을 후회하나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Dead
#. Speaker = Player
#. NodeID = 4e7e42ef-64c4-9763-9167-f7449279380f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Dead:4e7e42ef-64c4-9763-9167-f7449279380f
msgctxt "h42459872gbf0dg42ecg8aedgdc81ee496129"
msgid "How did you end up in the cave?"
msgstr "어떻게 이 동굴에 오게 된 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Dead
#. Speaker = Player
#. NodeID = 697d2af7-714f-aa0c-8495-e2198e9a360a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Dead:697d2af7-714f-aa0c-8495-e2198e9a360a
msgctxt "hc31a507bg8479g4063g82b1g46e4a308a645"
msgid "What can you tell me about the hag?"
msgstr "해그에 대해 무엇을 말해줄 수 있지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Dead
#. Speaker = Lorin
#. NodeID = 79094b48-cdec-abb5-569b-ab5a78266a31
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Dead:79094b48-cdec-abb5-569b-ab5a78266a31
msgctxt "h953bba76g942eg4c9fgb33cge94c750993b6"
msgid ""
"Here... I couldn't see it... couldn't see... my family... dead and rotten."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Dead
#. Speaker = Narrator
#. NodeID = 799059e0-808c-edda-3b88-32fa6f2264c7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_Killer(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Dead:799059e0-808c-edda-3b88-32fa6f2264c7
msgctxt "h5138a572g0886g4797ga9e3g9345daf23c4c"
msgid "*The corpse seems willing to speak - but not to its killer.*"
msgstr "*시체는 말할 의지가 있지만, 자신을 죽인 자와 대화하고 싶지는 않은 듯 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Dead
#. Speaker = Lorin
#. NodeID = 7a63ee63-d259-2209-7fd3-176c895d5212
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Dead:7a63ee63-d259-2209-7fd3-176c895d5212
msgctxt "h15626694gc139g4a48g890fgfa2af1c82946"
msgid "Trapped... between two choices... I made a deal... to see my fate..."
msgstr "두 선택지 사이에... 갇혔어... 그래서 거래했지... 내 운명을 보기 위해... "

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Dead
#. Speaker = Lorin
#. NodeID = 7b04092b-a840-0621-7151-24d377f1d181
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Dead:7b04092b-a840-0621-7151-24d377f1d181
msgctxt "had6073c9g0580g43dbg9effg39ae19ea0f61"
msgid "Making a... deal? Yes. Being... here...? No. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Dead
#. Speaker = Player
#. NodeID = 90f5323b-b575-e394-7503-0292125bf755
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Dead:90f5323b-b575-e394-7503-0292125bf755
msgctxt "haa798ac8g2234g4b7bga021g0663c7e2ad3c"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Dead
#. Speaker = Narrator
#. NodeID = a107de05-7a31-f170-f958-cedabaf7373f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Dead:a107de05-7a31-f170-f958-cedabaf7373f
msgctxt "h29cdfefcg03f7g490dg8ad6ga7524812fb34"
msgid "*The corpse does not stir. It will answer no more questions.*"
msgstr "*시체는 움직이지 않습니다. 더 이상 질문을 받지 않을 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Dead
#. Speaker = Narrator
#. NodeID = aa667b3a-4d5e-ca02-c35d-d93a5019a80a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Dead:aa667b3a-4d5e-ca02-c35d-d93a5019a80a
msgctxt "h45efd890gfb24g415dg895fg8993a39db20a"
msgid "*The spell's power wanes. You can ask no more questions.*"
msgstr "*주문의 힘이 약해집니다. 더 이상 질문할 수 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Dead
#. Speaker = Lorin
#. NodeID = d5af552c-0da4-5540-6795-c979fdcf1f0c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Dead:d5af552c-0da4-5540-6795-c979fdcf1f0c
msgctxt "h584acc5fg5a5fg4d41gb7ccge19fc9db07b4"
msgid "... but... no more. I am Lorin... only..."
msgstr "... 하지만... 이젠 아니야. 나는 그저... 로린일뿐..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Dead
#. Speaker = Lorin
#. NodeID = d66d41c0-ba73-f0c8-4588-e5bf01ffd1cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Dead:d66d41c0-ba73-f0c8-4588-e5bf01ffd1cf
msgctxt "hbb4789a5g5fc4g4d58g86f7g66a613fce746"
msgid "Father... husband... son..."
msgstr "아버지이자... 남편... 그리고 아들..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Dead
#. Speaker = Player
#. NodeID = e0f377f2-11b3-e858-04a0-b89b7ac4100e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Dead:e0f377f2-11b3-e858-04a0-b89b7ac4100e
msgctxt "h5de0c052g5b44g4fecgb052g70015139a916"
msgid "What's gone?"
msgstr "뭐가 사라졌지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Dead
#. Speaker = Narrator
#. NodeID = ea8ced2e-6896-e526-414b-8563943dca04
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Dead:ea8ced2e-6896-e526-414b-8563943dca04
msgctxt "h69ad5682gf93cg4854g8d9fge751445da52a"
msgid "*With a gasp, the corpse shudders.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Lorin
#. NodeID = 00194aaf-1b9e-02f3-6f53-e2faaf65991f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:00194aaf-1b9e-02f3-6f53-e2faaf65991f
msgctxt "h63a6bea3g04f7g4053gb658g98cb34fdf0a9"
msgid "No. You don't understand. You <i>kill </i>them. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Lorin
#. NodeID = 031fca9b-5ca5-73b0-4db6-5438fcbd5710
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GEN_DisappearOutOfSightWhenAvailable(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:031fca9b-5ca5-73b0-4db6-5438fcbd5710
msgctxt "h44a7222dg54fbg4326g9607g97ab3e6a637a"
msgid "I can't do this. You're too dangerous. I'm - I'm sorry. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Lorin
#. NodeID = 15024880-b798-a1e9-6030-38a34606fa70
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:15024880-b798-a1e9-6030-38a34606fa70
msgctxt "h9636a882g3c64g4d67gb388gd5f4228e177d"
msgid "I lost my best years rather than just... <i>choose.</i>"
msgstr "나는 그냥... <i>선택하면</i> 됐는데 가장 좋은 나날을 헛되이 보냈어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Lorin
#. NodeID = 211da9ef-63cd-745c-c153-7fe9872be75a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:211da9ef-63cd-745c-c153-7fe9872be75a
msgctxt "he2c2d479gbcadg4abcg8adag8c47d39eba45"
msgid ""
"I saw my future self - a corpse, rotten with maggots. And everyone around me "
"dead. Putrid and dead."
msgstr "미래의 내 모습을 봤는데, 구더기로 썩어가는 시체였어. 내 주변의 모든 사람들도 모두 부패한 시체로 죽어있었고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Lorin
#. NodeID = 21da8f50-33e0-35ab-a8ae-66690a348573
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:21da8f50-33e0-35ab-a8ae-66690a348573
msgctxt "h959b77d0ge23bg4bbdg9642gdc057f8d1efc"
msgid "You - you're the one. The <i>mind flayer. </i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Lorin
#. NodeID = 22f66fe9-9443-8ebb-97f8-09081458d9a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:22f66fe9-9443-8ebb-97f8-09081458d9a7
msgctxt "h5c1f7822gf733g4ed0g9b7ag3c61e2535371"
msgid "Good gods..."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Lorin
#. NodeID = 25ae0e16-76cb-7f82-016f-757b96d803f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:25ae0e16-76cb-7f82-016f-757b96d803f8
msgctxt "h4417b61fg91c6g4cdeg824cg9b7fee075e89"
msgid "A boring story. Stay or go. Marriage and kids or a life of novelty."
msgstr "지루한 이야기야. 머물 것인가와 떠날 것인가였어. 결혼과 자녀인가, 색다른 삶인가였지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Lorin
#. NodeID = 29ef1c57-2043-fc78-2abf-5c063ea12f94
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:29ef1c57-2043-fc78-2abf-5c063ea12f94
msgctxt "hd9176ee3g6932g4fbcg9f48gf7c38d4cd20c"
msgid "Hag magic it might be, but it's never been wrong. Not once. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Player
#. NodeID = 2f058d5a-34d1-f756-2c12-9a9e18817406
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:2f058d5a-34d1-f756-2c12-9a9e18817406
msgctxt "h5d27e985g23cbg45beg9fd2ge9b7ba2661b4"
msgid "You're wrong. I'll stop it. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Lorin
#. NodeID = 3a8b07e2-040b-8d87-eaf2-eb00152f9963
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:3a8b07e2-040b-8d87-eaf2-eb00152f9963
msgctxt "h707f4a7dg85d3g4663g9279gb4ee1f0e9b03"
msgid "I'm so sorry. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Lorin
#. NodeID = 3ceb1fe4-060c-7ded-2194-addae5626efb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:3ceb1fe4-060c-7ded-2194-addae5626efb
msgctxt "hcf5f09aegcdfeg4a4dg89beg60ac3615761d"
msgid "Vile, disgusting... "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Lorin
#. NodeID = 3e5ee432-8248-5cec-68c7-53bd32bda824
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:3e5ee432-8248-5cec-68c7-53bd32bda824
msgctxt "ha3f9e385g1516g4ef1g9528gb22395097353"
msgid ""
"I still hear it. Still see your eyes go dead, and you... you butcher them. "
"Everyone around you. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Lorin
#. NodeID = 3e9bdacc-31af-1258-38c6-37f69c341944
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:3e9bdacc-31af-1258-38c6-37f69c341944
msgctxt "h751e26fbg8401g4bbbga394g7f9d3bf9bc40"
msgid ""
"You change, skin ripping from your body and then you butcher... everyone. "
"Everyone around you. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Lorin
#. NodeID = 40c8540c-c277-691d-ed80-227653be50f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:40c8540c-c277-691d-ed80-227653be50f8
msgctxt "h03e9b9dbgab59g4169gaf54g861233bd7514"
msgid "May she burn in the Nine Hells."
msgstr "그 여자가 아홉 지옥에서 불타길."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Lorin
#. NodeID = 417fd477-d69c-0458-973c-4ea11a9f9640
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GEN_DisappearOutOfSightWhenAvailable(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:417fd477-d69c-0458-973c-4ea11a9f9640
msgctxt "hdd905ed3g387fg4ed6gbf94ga1e21e72716f"
msgid ""
"I can't stay. You're too dangerous. But I hope... I only hope it's a quick "
"death.  "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Player
#. NodeID = 49e1793c-8d24-fd64-e6d1-e0d239157293
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:49e1793c-8d24-fd64-e6d1-e0d239157293
msgctxt "hb819c86eg335bg4f21ga8d1gaead20692914"
msgid "I saved your life. Be grateful."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Lorin
#. NodeID = 4e8eb70c-c2cf-4fdc-b429-7c6a4f239384
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:4e8eb70c-c2cf-4fdc-b429-7c6a4f239384
msgctxt "he12abae6g3172g479cg8ef7g8a5ee7064bb1"
msgid "The hag - there's never been a more vile creature."
msgstr "그 해그보다 더 사악한 생물은 없었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Lorin
#. NodeID = 4eee0ac6-c88f-5088-137d-5823fe8d09aa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:4eee0ac6-c88f-5088-137d-5823fe8d09aa
msgctxt "h114e120fgfcd1g49edg9cf0g59fc93f97642"
msgid "You can't. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Lorin
#. NodeID = 548807f3-a820-9144-23d1-223c0b97c7ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:548807f3-a820-9144-23d1-223c0b97c7ed
msgctxt "h3871562ega1ecg4126g9fbag1d6cd017d1fe"
msgid ""
"I saw you screaming - covered in your own insides as that - that <i>thing</"
"i> bursts out of your skull."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Player
#. NodeID = 5f103786-aac9-9ae3-160a-9c69c3b4aac8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:5f103786-aac9-9ae3-160a-9c69c3b4aac8
msgctxt "h9192bc4fg1b11g4cd2ga841g8fd33b320d63"
msgid "Be specific. When will this happen?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Player
#. NodeID = 6225fe39-0ad7-a0d7-6ecb-b77b9fe6513e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:6225fe39-0ad7-a0d7-6ecb-b77b9fe6513e
msgctxt "hfc1007f7g1010g4ba2gaf37g87f4722a653d"
msgid "Why were you even here?"
msgstr "여긴 왜 온 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Lorin
#. NodeID = 62a86515-3f80-ab2b-4927-554797634fa6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:62a86515-3f80-ab2b-4927-554797634fa6
msgctxt "h91741326g0469g4bc9gbef4gb7472d5ce5d4"
msgid ""
"I was a fool. I wanted to know my fate. I had a choice between two lives, "
"and I was frightened of choosing wrong."
msgstr "내가 바보였지. 난 내 운명을 알고 싶었어. 두 가지 삶의 기로에 섰고, 잘못된 선택을 할까 봐 두려웠던 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Lorin
#. NodeID = 6824c7dc-ea52-3c0c-7ae0-86a09c11262d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GEN_DisappearOutOfSightWhenAvailable(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:6824c7dc-ea52-3c0c-7ae0-86a09c11262d
msgctxt "hfa2a07dfg9916g4941g98f6g1e1f5246a5f2"
msgid "I'm so sorry. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Player
#. NodeID = 6b825ece-606d-9d4d-5ea3-5a957ac1f4c0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_Hag_State_IsDead = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:6b825ece-606d-9d4d-5ea3-5a957ac1f4c0
msgctxt "h5e008e53gc6f1g4510ga1c2gc49f1fb21668"
msgid "She's dead. You're safe now."
msgstr "해그는 죽었어. 당신은 이제 안전해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Lorin
#. NodeID = 6f501b27-9b90-697f-08b5-bcc602a034f6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:6f501b27-9b90-697f-08b5-bcc602a034f6
msgctxt "h3327e0ffg46d2g4a89ga4d6g8bb2c8819aac"
msgid ""
"The hag - there's never been a more vile creature. The things she did to "
"me..."
msgstr "그 해그보다 더 사악한 생물은 없었어. 그 년이 내게 한 짓은..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Lorin
#. NodeID = 70398ab0-8f80-78c7-f6ed-3a819283c593
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:70398ab0-8f80-78c7-f6ed-3a819283c593
msgctxt "h0d511a1cg3f68g4ed7gbf3ag3212c678fbc9"
msgid "I - I don't know. It could be a tenday."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Lorin
#. NodeID = 7077f0ba-fe9f-d348-aa7d-1f5c0cf9e41e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:7077f0ba-fe9f-d348-aa7d-1f5c0cf9e41e
msgctxt "h9bb54e93g4df7g40ccg90b6ge3e6bb93f58f"
msgid ""
"No. I <i>saw </i>it. You're covered in blood and gore - vomiting. And "
"then... your skull splits open."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Lorin
#. NodeID = 75e3dc59-fc0c-5833-fb6e-05700541cc71
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:75e3dc59-fc0c-5833-fb6e-05700541cc71
msgctxt "hee3ade32g75fcg4c8cg94faga3d7a0941521"
msgid "No - the hag's 'gift' is gone but it's - it's going to happen. Soon."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Player
#. NodeID = 7db67837-a21e-8c74-8ca0-32b6c1bfaef6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_Hag_State_IsDead = False
#.      - HAG_Hag_State_HagGivenMercy = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:7db67837-a21e-8c74-8ca0-32b6c1bfaef6
msgctxt "hb9ef8884g73e7g4f3cgb0f5gcf1fa0c8b26f"
msgid "She's gone. You're safe now."
msgstr "그녀는 떠났어. 이제 안전해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Lorin
#. NodeID = 7f49fdd8-3e86-2523-23f7-571361b960ba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:7f49fdd8-3e86-2523-23f7-571361b960ba
msgctxt "heb675ef9gb0a9g4670g9975g29b0d26030cf"
msgid "The things she did to me - the things she made me do I... "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Player
#. NodeID = 88d69b87-aa67-8fa3-72aa-6f3b8d32aa20
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:88d69b87-aa67-8fa3-72aa-6f3b8d32aa20
msgctxt "hce58beb7ga095g4b24g8d1egbca617f4442c"
msgid "Are you all right?"
msgstr "괜찮아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Lorin
#. NodeID = 89f29ce6-4f71-9a23-16a0-197e358d79e9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:89f29ce6-4f71-9a23-16a0-197e358d79e9
msgctxt "ha9e9170ag79cbg41a6g9249gd1b7f508d892"
msgid "No. Not even a little bit. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Player
#. NodeID = 9236874f-5229-b457-57c5-086064c43b6e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DUERGARDWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:9236874f-5229-b457-57c5-086064c43b6e
msgctxt "h572b9850g6bebg4ffcg9063gf5c3c594e013"
msgid "Shut your damn mouth. And <i>never </i>call me that again."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Player
#. NodeID = 9676b9a9-afc7-dce9-e03c-abcf8bce2151
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:9676b9a9-afc7-dce9-e03c-abcf8bce2151
msgctxt "h712d08a2g27c0g4e16gbb6bga78edda43ff1"
msgid "You mentioned choosing between two lives. What were they?"
msgstr "두 가지 삶의 기로에 섰다고 했는데, 그건 뭐였지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Lorin
#. NodeID = 9ab45b26-e5c1-1572-a6e8-9f5d32c745d5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GEN_DisappearOutOfSightWhenAvailable(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:9ab45b26-e5c1-1572-a6e8-9f5d32c745d5
msgctxt "h5b237926ge9c6g494dga9b9g63813070c174"
msgid "Death can't come quick enough for you - <i>monster. </i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Player
#. NodeID = 9f59a257-b1be-520f-487b-549f96334f8c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:9f59a257-b1be-520f-487b-549f96334f8c
msgctxt "ha3f02ce8g5bbbg4aa9g8926g5ccf62992e65"
msgid "I have no idea what you're talking about. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Lorin
#. NodeID = a25fcf5d-364f-f05e-3d2d-9a6e0106ee02
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GEN_DisappearOutOfSightWhenAvailable(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:a25fcf5d-364f-f05e-3d2d-9a6e0106ee02
msgctxt "h825d398dg2b5dg46c9g8593g7a1fa39efce4"
msgid "Yes. I will. <i>Thank you.</i>"
msgstr "그래. 그럴 거야. <i>고마워.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Player
#. NodeID = a525954f-ac12-f967-c15c-92d791aaa5c4
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_EVIL or PALADIN_EVIL
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:a525954f-ac12-f967-c15c-92d791aaa5c4
msgctxt "hae8ecf7eg763fg4b1cg830fg06f4b80afd0c"
msgid "I butcher everyone? That sounds <i>delightful</i>."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Player
#. NodeID = a6fe5627-2fd2-7275-9fb7-b41e70815d83
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:a6fe5627-2fd2-7275-9fb7-b41e70815d83
msgctxt "hfef956d3g9ffeg48ffg96cag0dde10d0006f"
msgid "Get out of here."
msgstr "어서 이곳을 떠나. "

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Lorin
#. NodeID = add0201a-aee4-d945-3c76-0d00dab015b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:add0201a-aee4-d945-3c76-0d00dab015b4
msgctxt "hb50a2a8fg0a89g4af6ga9bdgb06be6d4d4cc"
msgid "Could be any moment. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Player
#. NodeID = b231356b-c260-92dc-d529-fb065ce03edf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:b231356b-c260-92dc-d529-fb065ce03edf
msgctxt "h8711f87ag075cg4743g8312gc639e742b1b2"
msgid "Not if I can help it. Can you still see it? "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Player
#. NodeID = b6c009a0-2810-98d4-573b-11e6b36dec7d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:b6c009a0-2810-98d4-573b-11e6b36dec7d
msgctxt "h4cd69306g754ag4374gb6b7g8666c193ae0a"
msgid "You're lucky to be alive. I could have killed you."
msgstr "살아있는 걸 다행인 줄 알아. 내가 널 죽일 수도 있었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Lorin
#. NodeID = ca8fcf90-891b-4edb-92ad-d75634f5c730
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:ca8fcf90-891b-4edb-92ad-d75634f5c730
msgctxt "h35dcbcf0gb20cg4364g851dg9f40a9a660c5"
msgid ""
"I asked the hag to help me see what the future would hold. Got what I wished "
"for, too."
msgstr "난 해그에게 내 미래를 볼 수 있게 해달라고 도움을 요청했어. 그리고 내 소원대로 됐지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Lorin
#. NodeID = ce0e0efd-1369-b720-1438-4151baab2d79
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAG_HagLair_Victim_003_HasMet(1) = True
#.   Global:
#.      - HAG_Hag_State_IsDead = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:ce0e0efd-1369-b720-1438-4151baab2d79
msgctxt "h30d9d931gbee0g4705gb2fagda9eefc445f4"
msgid "Is the hag gone? Gods, tell me she's gone. Oh, please."
msgstr "해그는 떠났나? 세상에, 그녀가 떠났다고 해줘. 오, 제발."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Player
#. NodeID = d2a6a979-dc52-0616-fb99-a2347e1a3b43
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LOLTHDROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:d2a6a979-dc52-0616-fb99-a2347e1a3b43
msgctxt "h14d3cba5gc850g485fga8cdg462237f9f2f7"
msgid "Leave <i>darthiir</i> - before I finished what the hag started."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Lorin
#. NodeID = dc4e5bd2-bb24-986f-20c4-65e095c8387b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:dc4e5bd2-bb24-986f-20c4-65e095c8387b
msgctxt "hd89cc56dg4af3g48cagb280g2b50956f82a2"
msgid "The things she did - the things she made me do. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Lorin
#. NodeID = e1f54698-5600-16b4-381d-dd75105259ad
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GEN_DisappearOutOfSightWhenAvailable(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:e1f54698-5600-16b4-381d-dd75105259ad
msgctxt "h191f8a8cgbb1eg437bga51eg1783b36cecb2"
msgid "Yes. I will. Forgive me. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Player
#. NodeID = e251010e-28de-c5fc-06be-daa7b6b4e701
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_Hag_State_IsDead = False
#.      - HAG_Hag_State_HagGivenMercy = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:e251010e-28de-c5fc-06be-daa7b6b4e701
msgctxt "h79d76c6ag4c4eg4400gba76g0941d7f7625d"
msgid "She's gone. You're safe now."
msgstr "그녀는 떠났어. 이제 안전해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Lorin
#. NodeID = e6785250-690f-a62c-30c8-ad493ff78e29
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:e6785250-690f-a62c-30c8-ad493ff78e29
msgctxt "h6f34baa6g5bb6g4158ga043g4a61d135fa3a"
msgid "That thing bursts out of you and you're - you're screaming."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Lorin
#. NodeID = edefe6e9-8ddf-02ae-2732-473a3ab8f76b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:edefe6e9-8ddf-02ae-2732-473a3ab8f76b
msgctxt "hcf0b4e18gae14g4228gb861g5b9e8123aa4e"
msgid "Hells."
msgstr "젠장."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Player
#. NodeID = f2285923-b681-55bb-b56a-4bab8bb4bada
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:f2285923-b681-55bb-b56a-4bab8bb4bada
msgctxt "h2ddb14e2g3c95g4fb2gb379g183e379e94f8"
msgid "Say that again, and I'll rip your throat out with my teeth."
msgstr "한 번만 더 그딴 소리 지껄이면 네 목을 물어 끊어 버리겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Player
#. NodeID = f79b766c-44a3-019e-786c-9ed596311a9c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:f79b766c-44a3-019e-786c-9ed596311a9c
msgctxt "h06f4ea09g9e2dg4e02gb2ebg4d562b0fd136"
msgid "Leave while you can - and be careful."
msgstr "떠날 수 있을 때 떠나. 몸조심하고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Player
#. NodeID = fc95b1a5-5f64-843f-e8b4-72ef9544196b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_Hag_State_IsDead = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:fc95b1a5-5f64-843f-e8b4-72ef9544196b
msgctxt "hf0038fcag2932g47d6g885cga48c33152893"
msgid "She's dead. You're safe now."
msgstr "해그는 죽었어. 당신은 이제 안전해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Lorin
#. NodeID = fecfded9-14e4-be1f-1404-ca157e71f4de
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:fecfded9-14e4-be1f-1404-ca157e71f4de
msgctxt "hba0e0264g3f77g4ffdg9c91g68537cbd7ae9"
msgid ""
"That damn shrew would have loved it. Would have loved watching you murder "
"me. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed
#. Speaker = Player
#. NodeID = ff054769-1ddb-3808-02e3-90036961e728
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_Freed:ff054769-1ddb-3808-02e3-90036961e728
msgctxt "ha50b8369gc8e3g400cg9737gb4b00efd7a11"
msgid "Why should I trust you? Or the hag's magic?"
msgstr "왜 내가 널 믿어야 하지? 해그의 마법일 수도 있는데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_PAD_Mindflayer
#. Speaker = Player
#. NodeID = 13b2ef40-3322-c262-4110-3b3db43b9a5e
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_PAD_Mindflayer:13b2ef40-3322-c262-4110-3b3db43b9a5e
msgctxt "h118920deg5defg447bgbfc6gfdec51bc2878"
msgid "Babbling idiot doesn't know what he's talking about."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_PAD_Mindflayer
#. Speaker = Player
#. NodeID = 13b2ef40-3322-c262-4110-3b3db43b9a5e
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_PAD_Mindflayer:13b2ef40-3322-c262-4110-3b3db43b9a5e
msgctxt "h9dc6fdf3g033dg4914gbc0bg1fee0d0a1d2f"
msgid ""
"He doesn't see the future, only the nightmares we think the future may hold."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_PAD_Mindflayer
#. Speaker = Player
#. NodeID = 13b2ef40-3322-c262-4110-3b3db43b9a5e
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_PAD_Mindflayer:13b2ef40-3322-c262-4110-3b3db43b9a5e
msgctxt "h4cdc75e1g4eecg4aa6gb606g4183bfc38255"
msgid "A mind flayer? Absolutely not. No way."
msgstr "마인드 플레이어? 절대 아냐. 말도 안 돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_PAD_Mindflayer
#. Speaker = Player
#. NodeID = 13b2ef40-3322-c262-4110-3b3db43b9a5e
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_PAD_Mindflayer:13b2ef40-3322-c262-4110-3b3db43b9a5e
msgctxt "h4de8aac5g3d10g483dgac85g8706909716d9"
msgid "Ignore him. Just a hallucination, nothing more."
msgstr "무시해. 단순한 환상에 지나지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_PAD_Mindflayer
#. Speaker = Player
#. NodeID = 13b2ef40-3322-c262-4110-3b3db43b9a5e
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_PAD_Mindflayer:13b2ef40-3322-c262-4110-3b3db43b9a5e
msgctxt "h61a9c5c5g9b8fg4e7ega8f3g01f33285628d"
msgid "A mind flayer? Hopefully there's no truth to his ravings."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_PAD_Mindflayer
#. Speaker = Player
#. NodeID = 13b2ef40-3322-c262-4110-3b3db43b9a5e
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_PAD_Mindflayer:13b2ef40-3322-c262-4110-3b3db43b9a5e
msgctxt "h33e97f1agccfag45fegae09g1c497a49509d"
msgid "A mind flayer? Not a particularly good omen."
msgstr "마인드 플레이어? 좋은 징조는 아닌데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_PAD_Mindflayer
#. Speaker = Player
#. NodeID = 13b2ef40-3322-c262-4110-3b3db43b9a5e
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_PAD_Mindflayer:13b2ef40-3322-c262-4110-3b3db43b9a5e
msgctxt "ha2c86852g6019g417bg8c44g25c88a05b049"
msgid "I would rather fall on my blade than become a <i>ghaik</i>."
msgstr "<i>게이크</i>가 될 바에는 내 칼에 쓰러지겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_PAD_Mindflayer
#. Speaker = Player
#. NodeID = 13b2ef40-3322-c262-4110-3b3db43b9a5e
#. HandlePath = TaggedText[7].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_PAD_Mindflayer:13b2ef40-3322-c262-4110-3b3db43b9a5e
msgctxt "h4159651agd87fg47d3g9680g4270acfe8b96"
msgid "A mind flayer. No intention of letting <i>that </i>happen."
msgstr "마인드 플레이어라. <i>그렇게</i> 될 생각은 전혀 없는걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_PAD_Mindflayer
#. Speaker = Player
#. NodeID = 153649d3-63f0-1664-dba0-1ca6a2183c04
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_PAD_Mindflayer:153649d3-63f0-1664-dba0-1ca6a2183c04
msgctxt "h2481d7b5g1644g42a2gb0b1g8353959a9a2c"
msgid "Babbling idiot. Clearly has no idea what he's talking about..."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_PAD_Mindflayer
#. Speaker = Player
#. NodeID = 153649d3-63f0-1664-dba0-1ca6a2183c04
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_PAD_Mindflayer:153649d3-63f0-1664-dba0-1ca6a2183c04
msgctxt "h3cb07317g3be1g4c5bg8c56gfa6307c53f86"
msgid ""
"He doesn't see the future, only the nightmares we think the future may hold. "
"I hope."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_PAD_Mindflayer
#. Speaker = Player
#. NodeID = 153649d3-63f0-1664-dba0-1ca6a2183c04
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_PAD_Mindflayer:153649d3-63f0-1664-dba0-1ca6a2183c04
msgctxt "h83969cd3gda69g4908g965dg6758ba94c27a"
msgid "A mind flayer. No way. I'm making my own future."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_PAD_Mindflayer
#. Speaker = Player
#. NodeID = 153649d3-63f0-1664-dba0-1ca6a2183c04
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_PAD_Mindflayer:153649d3-63f0-1664-dba0-1ca6a2183c04
msgctxt "hda22a0d2g3078g482cgbc63gc60b4627d51a"
msgid "Just a hallucination, nothing more."
msgstr "환각일 뿐, 그 이상은 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_PAD_Mindflayer
#. Speaker = Player
#. NodeID = 153649d3-63f0-1664-dba0-1ca6a2183c04
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_PAD_Mindflayer:153649d3-63f0-1664-dba0-1ca6a2183c04
msgctxt "h167e2253g5bb9g415eg8428g42eb279018a2"
msgid "His mind flayer ravings had better not come to pass."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_PAD_Mindflayer
#. Speaker = Player
#. NodeID = 153649d3-63f0-1664-dba0-1ca6a2183c04
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_PAD_Mindflayer:153649d3-63f0-1664-dba0-1ca6a2183c04
msgctxt "hc5ad0378gb47dg4114g8ab5gc2ad01a480ab"
msgid "A mind flayer? Not a particularly good omen."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_PAD_Mindflayer
#. Speaker = Player
#. NodeID = 153649d3-63f0-1664-dba0-1ca6a2183c04
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_PAD_Mindflayer:153649d3-63f0-1664-dba0-1ca6a2183c04
msgctxt "h48a682dagac0dg4647g80bfga5bb112173a7"
msgid "I would rather fall on my blade than become a <i>ghaik</i>."
msgstr "<i>게이크</i>가 될 바에는 내 칼에 쓰러지겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_PAD_Mindflayer
#. Speaker = Player
#. NodeID = 153649d3-63f0-1664-dba0-1ca6a2183c04
#. HandlePath = TaggedText[7].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_PAD_Mindflayer:153649d3-63f0-1664-dba0-1ca6a2183c04
msgctxt "h6a4f37b9geca4g4bc2gb227g268fb6c3ee56"
msgid "A mind flayer. No intention of letting <i>that </i>happen."
msgstr "마인드 플레이어라. <i>그렇게</i> 될 생각은 전혀 없는걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_PAD_Mindflayer
#. Speaker = Player
#. NodeID = c5542ca5-45b1-f347-4537-482854092a97
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_PAD_Mindflayer:c5542ca5-45b1-f347-4537-482854092a97
msgctxt "h846365ecg088eg4056gbb36gb8fa8390a693"
msgid "Probably another of the hag's mind games. Nothing more."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_PAD_Mindflayer
#. Speaker = Player
#. NodeID = c5542ca5-45b1-f347-4537-482854092a97
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_PAD_Mindflayer:c5542ca5-45b1-f347-4537-482854092a97
msgctxt "h4b0f3392g52fdg423ag8e29gda011cf1f884"
msgid ""
"I say he doesn't see the future, only the nightmares we think the future may "
"hold."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_PAD_Mindflayer
#. Speaker = Player
#. NodeID = c5542ca5-45b1-f347-4537-482854092a97
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_PAD_Mindflayer:c5542ca5-45b1-f347-4537-482854092a97
msgctxt "h770039c2g184eg4bacg94c9g9e5e6054c083"
msgid "Don't worry. We're making our own future."
msgstr "걱정 마. 우리의 미래는 우리가 직접 만들어갈 테니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_PAD_Mindflayer
#. Speaker = Player
#. NodeID = c5542ca5-45b1-f347-4537-482854092a97
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_PAD_Mindflayer:c5542ca5-45b1-f347-4537-482854092a97
msgctxt "h5b7965afgc878g402eg86b7g9001aa7ef51a"
msgid "Ignore him. A hallucination, nothing more."
msgstr "무시해. 단순한 환상에 지나지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_PAD_Mindflayer
#. Speaker = Player
#. NodeID = c5542ca5-45b1-f347-4537-482854092a97
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_PAD_Mindflayer:c5542ca5-45b1-f347-4537-482854092a97
msgctxt "h118a0b2bg4487g4aadga2f6g8dfcfcdd4b87"
msgid "Just a trick, surely. We're being toyed with."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_PAD_Mindflayer
#. Speaker = Player
#. NodeID = c5542ca5-45b1-f347-4537-482854092a97
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_PAD_Mindflayer:c5542ca5-45b1-f347-4537-482854092a97
msgctxt "h4fdd5e96gca94g4e23g9deag94ddea11506b"
msgid "We'll prove him wrong, I'm sure of it."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_PAD_Mindflayer
#. Speaker = Player
#. NodeID = c5542ca5-45b1-f347-4537-482854092a97
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_003_PAD_Mindflayer:c5542ca5-45b1-f347-4537-482854092a97
msgctxt "h39e5bceege9e8g4514g877bg7a50b885fc1a"
msgid "We'll prove him wrong. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_004
#. Speaker = Narrator
#. NodeID = 26dfa605-832b-4bf0-772c-68bf2ad1fd47
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
