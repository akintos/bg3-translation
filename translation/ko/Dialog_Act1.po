#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_MagicMouthKnowledgeCheck:2420c80f-d697-492d-bac6-7c31ebddded4
msgctxt "h89652eb3g5715g4bc5gae30g10cb5bff1eef"
msgid "A talking statue. Now was that a warning - or a command?"
msgstr "말하는 동상이라니. 방금은 무슨 경고나, 명령을 위한 거였을까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_MagicMouthKnowledgeCheck
#. Speaker = Player
#. NodeID = 2420c80f-d697-492d-bac6-7c31ebddded4
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
