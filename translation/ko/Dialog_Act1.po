msgctxt "h155c9960geb34g4163ga8bfg20852d75cf7d"
msgid "Ah, your excelness, you weren't supposed to touch that."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_AlarmUsedReaction
#. Speaker = Sentinel Olak
#. NodeID = 8698607a-3584-8e4b-0fb3-f41e21df78df
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_AlarmUsedReaction:8698607a-3584-8e4b-0fb3-f41e21df78df
msgctxt "h8fa31c72gc83eg40bdg9e43g45a159468297"
msgid "A lovely rhythm, your lordness. Shame you just raised the alarm."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_AlarmUsedReaction
#. Speaker = Sentinel Olak
#. NodeID = a048a766-fb07-21a6-41d5-36678b5a3cea
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Checkpoint_State_ForgaveForUsingAlarm = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_AlarmUsedReaction:a048a766-fb07-21a6-41d5-36678b5a3cea
msgctxt "hc01e1298g63c6g4b4fgaf59gda8f023f979f"
msgid "Oi! Can't say you weren't <i>warned</i>, mate."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_AlarmUsedReaction
#. Speaker = Sentinel Olak
#. NodeID = af81d424-6caf-3124-c839-335ecd51bc71
#. HandlePath = TaggedText[0].TagText[0]
