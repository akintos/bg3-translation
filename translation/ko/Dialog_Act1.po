msgctxt "hedfa2299g2d88g40dbg9a64gf77559570146"
msgid "((*silence. I am breathing life*))"
msgstr "((*조용히 해라. 생명을 불어넣는 중이다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DeadInTheWater_AD_DuergarsComplaining
