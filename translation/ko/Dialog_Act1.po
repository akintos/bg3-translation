msgctxt "h1bddd77age22ag475bg947dge47e0b9c21ab"
msgid "You're either with the Absolute or against her. Ain't no in-between."
msgstr "절대자님을 모시거나 대적하거나 둘 중 하나야. 그 중간은 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Bravado_Goblin_002
