msgid "<i>Focus on your parasite and connect with the sovereign.</i>"
msgstr "<i>기생충에 집중하여 군주와 연결한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000
