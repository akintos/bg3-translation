msgctxt "hcfeab6feg3a03g4b70gbb99g8cd3aa8a98c2"
msgid "Nothing more to plunder."
msgstr "약탈할 게 더 없는 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_WormWall_PAD_Empty3
#. Speaker = Player
#. NodeID = 7a77eca7-ed85-87f3-b85d-b638eb2623f0
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_WormWall_PAD_Empty3:7a77eca7-ed85-87f3-b85d-b638eb2623f0
msgctxt "hfba6b6b9g7fc7g44bfgb0a2g1ee129c06f90"
msgid "No further treasure to be found I'm afraid."
msgstr "아쉽지만 더는 발견할 수 있는 보물이 없는 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_WormWall_PAD_Empty3
#. Speaker = Player
#. NodeID = 7a77eca7-ed85-87f3-b85d-b638eb2623f0
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_WormWall_PAD_Empty3:7a77eca7-ed85-87f3-b85d-b638eb2623f0
msgctxt "hda2df38cg18c2g4497gb19eg5e06c308afe7"
msgid "Empty as a hole."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_WormWall_PAD_Empty3
#. Speaker = Player
#. NodeID = 7a77eca7-ed85-87f3-b85d-b638eb2623f0
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_WormWall_PAD_Empty3:7a77eca7-ed85-87f3-b85d-b638eb2623f0
msgctxt "h59c9a8ddgb9a7g4bd9g92ccg0de9de964344"
msgid "Already cleared out."
msgstr "이미 다 비웠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_WormWall_PAD_Empty3
#. Speaker = Player
#. NodeID = 7a77eca7-ed85-87f3-b85d-b638eb2623f0
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_WormWall_PAD_Empty3:7a77eca7-ed85-87f3-b85d-b638eb2623f0
msgctxt "h49c6991eg996eg412eg9ec3gd1790d70bbe4"
msgid "Nothing in here."
msgstr "여기 안엔 아무것도 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_WormWall_PAD_Empty3
#. Speaker = Player
#. NodeID = 7a77eca7-ed85-87f3-b85d-b638eb2623f0
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
