msgid "Sorry, mistress duergar. Didn't mean to get in your way.\n"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinLush
#. Speaker = Tracker Azak
#. NodeID = 82977cc7-f5d6-da80-cb12-fbb532adccdd
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_ConcubineLush_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_ConcubineLush_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinLush:82977cc7-f5d6-da80-cb12-fbb532adccdd
msgctxt "h3ef012edga130g4ed2gb45ag54462c81beab"
msgid "Leave me alone - ain't got time for chatter."
msgstr "날 내버려둬 - 수다 떨 시간은 없다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinLush
#. Speaker = Tracker Azak
#. NodeID = aefc5b9c-e8fe-ee34-6a4f-514b4d1f0cdf
