msgctxt "h59c91c55gf718g4e64gbcafg992aacde40fa"
msgid "Come here... please!"
msgstr "이리 와... 제발!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerCharmed
