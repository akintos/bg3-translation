msgctxt "h380773deg70e4g4690ga71bg090b6b83ca75"
msgid "Sealed by magic. There's no smashing this open."
msgstr "마법으로 봉인되어 있어. 부숴서 열 수는 없겠는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_NoticeStashSeal
#. Speaker = Player
#. NodeID = 78906681-bbcc-2880-1d5d-052ca046af30
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
