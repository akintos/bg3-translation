msgctxt "h873977f9gfe09g4af0g840eg82f4ce81407e"
msgid "What's wrong with the artist?"
msgstr "저 예술가는 뭐가 문제야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03_AD_Zhent04
