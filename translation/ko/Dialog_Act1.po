#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_AdamantineForge_AD_FoundKey:cfd78504-a624-89af-8983-952cb9502041
msgctxt "hb10eb430g63afg4e06g85c5gfac00df72dd7"
msgid "A casting mould. Made for the forge, no doubt."
msgstr "주형이로군. 분명 그 대장간에서 쓰려고 만든 거겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_AdamantineForge_AD_FoundKey
