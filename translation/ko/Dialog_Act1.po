msgctxt "h9fd86433g8de5g4816gb0fegd5103ef40387"
msgid "<i>Pay him.</i>"
msgstr "<i>지불한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03
