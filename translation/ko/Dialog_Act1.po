msgctxt "h69f3abe6gf817g4108g8905g55677a4f38c4"
msgid "She's dead because of your meddling."
msgstr "네 쓸데없는 간섭 때문에 그녀가 죽은 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_RitualDruid5
#. Speaker = Tahan
#. NodeID = 36b95f31-eccd-f56c-97d6-c4b12468f48f
