#.      - BARBARIAN(4) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:5a4a7ce6-d02c-8465-48f8-db7668109331
msgctxt "h54a4bbeagd504g48d1ga1f8g549c60c46f3a"
msgid "How about you kiss <i>my </i>feet instead?"
msgstr "대신 <i>내 </i>발에 키스하는 건 어때?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = 5a8fdcbe-b356-7a0c-c058-a5697c0a034b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_Checkpoint_State_Paint(4) = False
#. TagRule: HUMAN
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:5a8fdcbe-b356-7a0c-c058-a5697c0a034b
msgctxt "h2030e37fg2b2dg4b51g8961gf89239bc1192"
msgid "And who're you? 'Nother pest? Humans... think ya rule the world. Hah!"
msgstr "넌 누구야? 다른 해충인가? 인간이잖아… 너희가 세상에서 잘난 줄 알지. 하!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = 5a8fdcbe-b356-7a0c-c058-a5697c0a034b
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_Checkpoint_State_Paint(4) = False
#. TagRule: DWARF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:5a8fdcbe-b356-7a0c-c058-a5697c0a034b
msgctxt "hfa42ecf3g1396g4689g8c29g9594a33c17fa"
msgid "And who're you? 'Nother pest? Dwarves... think ya rule the world. Hah!"
msgstr "넌 누구야? 다른 해충인가? 드워프잖아… 너희가 세상에서 잘난 줄 알지. 하!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = 5a8fdcbe-b356-7a0c-c058-a5697c0a034b
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_Checkpoint_State_Paint(4) = False
#. TagRule: ELF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:5a8fdcbe-b356-7a0c-c058-a5697c0a034b
msgctxt "he7d50aeeg4ae8g43abgb1e4g780b938eb0c6"
msgid "And who're you? 'Nother pest? Elves... think ya rule the world. Hah!"
msgstr "넌 누구야? 다른 해충인가? 엘프잖아… 너희가 세상에서 잘난 줄 알지. 하!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = 5a8fdcbe-b356-7a0c-c058-a5697c0a034b
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_Checkpoint_State_Paint(4) = False
#. TagRule: GITHYANKI or HALFORC or TIEFLING
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:5a8fdcbe-b356-7a0c-c058-a5697c0a034b
#, fuzzy
msgctxt "hd291799eg3bc2g4b32g9e6egc8b072748de1"
msgid ""
"And who're you? 'Nother pest? Think ya rule the world just cuz ya got a "
"scary face? Hah!"
msgstr "넌 누구야? 다른 해충인가? 얼굴이 무섭다는 이유만으로 너희가 세상에서 잘난 줄 알지. 하!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = 5a8fdcbe-b356-7a0c-c058-a5697c0a034b
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_Checkpoint_State_Paint(4) = False
#. TagRule: HALFLING
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:5a8fdcbe-b356-7a0c-c058-a5697c0a034b
msgctxt "h5853bcfeg6cacg456fga9a2g8a8fadadbefc"
msgid ""
"And who're you? 'Nother pest? You're just a little halfling... and ya think "
"ya rule the world. Hah!"
msgstr "넌 누구야? 다른 해충인가? 그냥 쪼그만 하플링이잖아… 너희가 세상에서 잘난 줄 알지. 하!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = 5a8fdcbe-b356-7a0c-c058-a5697c0a034b
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_Checkpoint_State_Paint(4) = False
#. TagRule: GNOME
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:5a8fdcbe-b356-7a0c-c058-a5697c0a034b
msgctxt "h39d51aacgea30g44f9g9dbeg15a142c5a654"
msgid ""
"And who're you? 'Nother pest? You're just a teensy gnome... and ya think ya "
"rule the world. Hah!"
msgstr "넌 누구야? 다른 해충인가? 작은 노움이잖아… 너희가 세상에서 잘난 줄 알지. 하!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = 5a8fdcbe-b356-7a0c-c058-a5697c0a034b
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_Checkpoint_State_Paint(4) = False
#. TagRule: HALFELF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:5a8fdcbe-b356-7a0c-c058-a5697c0a034b
msgctxt "h71b01b9eg7327g40e4g99b7g105ff8daccb8"
msgid "And who're you? A half-elf... thinking ya rule the world. Hah!"
msgstr "넌 누구야? 하프 엘프잖아… 너희가 세상에서 잘난 줄 알지. 하!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = 5a8fdcbe-b356-7a0c-c058-a5697c0a034b
#. HandlePath = TaggedText[7].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_Checkpoint_State_Paint(4) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:5a8fdcbe-b356-7a0c-c058-a5697c0a034b
msgctxt "hb056a5d7g297ag4453gbe19g4e62d3bad398"
msgid ""
"And who're you? 'Nother pest? Everyone just barges in here, thinkin' they "
"rule the world. Hah!"
msgstr "넌 누구야? 다른 해충인가? 모두들 자기가 세상에서 잘난 줄 알고 여기 불쑥 끼어드는군. 하!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Karlach
#. NodeID = 5b358fdb-5185-cd8c-7a41-4615234b1658
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(10) = True
#.   Tag:
#.      - REALLY_KARLACH(10) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:5b358fdb-5185-cd8c-7a41-4615234b1658
msgctxt "h046234e5gf12cg4b42g89f0gbc285219a520"
msgid "Come on - let's get you a beer to wash the taste away."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = 5bb137ca-66d1-5796-1ad4-798c597a5aa2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:5bb137ca-66d1-5796-1ad4-798c597a5aa2
msgctxt "h40cc2699gf1c7g4e5aga846g84af315e329c"
msgid "I'm waitin'."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Player
#. NodeID = 5f653d8b-e1de-91f0-d1f0-9ec682e205d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:5f653d8b-e1de-91f0-d1f0-9ec682e205d8
msgctxt "h92684712g1ff8g4af9gb89cg91358a004178"
msgid ""
"I said I'd spit in your face. Was that unclear, or do you need a "
"demonstration?"
msgstr "네 얼굴에 침을 뱉겠다고 했잖아. 이해가 안되면, 직접 보여줘야 되나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Narrator
#. NodeID = 607fe48c-aa7b-c32f-b0bd-a9ac78f289e7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount1(4) = False
#.   Tag:
#.      - TRUESOUL(4) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount1(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:607fe48c-aa7b-c32f-b0bd-a9ac78f289e7
msgctxt "hd89fd4a5g3ad7g4ca6g8f9dgcd1c5eb05100"
msgid "*A shiver runs across your mind... You feel sated.*"
msgstr "*전율이 불현듯 머릿속을 스쳐 지나가고... 만족감이 듭니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Gale
#. NodeID = 60815a75-828c-a490-1e0f-438c8f34bca5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_GALE(7) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:60815a75-828c-a490-1e0f-438c8f34bca5
msgctxt "h01afbf77g3638g4abbg93a6g1497cf813ff8"
msgid ""
"Quick thinking! At least there's a silver lining to having yourself horribly "
"scarred for life."
msgstr "순발력 좋구만! 평생 끔찍한 흉터를 달고 살겠지만 그래도 최소한 희망은 있네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Wyll
#. NodeID = 62a2a21b-ebb8-4295-0b3e-773f2ae57c59
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:62a2a21b-ebb8-4295-0b3e-773f2ae57c59
msgctxt "ha97a021ag8ae6g4403gba7ag38de08d3b977"
msgid "Blech. I'd rather drink the Baldur's Gate sewers dry."
msgstr "으엑. 차라리 발더스 게이트의 하수구 물이 낫겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Narrator
#. NodeID = 6834fabb-9c15-680d-c544-8af45f50567b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - GLO_TadpoleIntro_NPC(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:6834fabb-9c15-680d-c544-8af45f50567b
msgctxt "hc1240ba4g9ebcg4dbbgb5d4g131e35568b74"
msgid "*As the symbol glows, power courses through you. <i>Authority</i>.*"
msgstr "*문양이 빛나며, 몸에 흐르는 힘이 느껴집니다. <i>권위</i>.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Karlach
#. NodeID = 68ee1c23-0d0d-0fed-6390-b1e6a3ba1b14
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:68ee1c23-0d0d-0fed-6390-b1e6a3ba1b14
msgctxt "had6cd3b3g566eg49b5g868eg5cf68331cc24"
msgid "You're just jealous. I saw the way you looked at that foot."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Astarion
#. NodeID = 6bed2588-c251-233e-e380-12a50f8b55fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:6bed2588-c251-233e-e380-12a50f8b55fc
msgctxt "hb526d69ag3b7eg45cdga6abg1a8710af2b85"
msgid "Not bad. I would've taken the whole toe, but whatever works for you."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Karlach
#. NodeID = 6c711a4f-9147-93f2-7840-a100cbbc76ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:6c711a4f-9147-93f2-7840-a100cbbc76ae
msgctxt "hc6d2b9b3g9af2g4ed8gad2dg48becef0677b"
msgid "Good gods. What else can you do with that tongue?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Narrator
#. NodeID = 6ce784fe-3359-7a3a-e473-118aef22a526
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:6ce784fe-3359-7a3a-e473-118aef22a526
msgctxt "hb6d6fbabgdfdeg4558g967dg07f6d6ad89e5"
msgid ""
"*His lips smack together wetly and leave a trail of saliva on your foot.*"
msgstr "*그의 입술이 당신의 발에 촉촉하게 부딪히며 침 자국을 남깁니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = 6d6e2c0e-bc6b-a51e-cfc5-139b74fcd49d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_DrunkGoblin_Event_StartFistFight(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:6d6e2c0e-bc6b-a51e-cfc5-139b74fcd49d
msgctxt "h5bd004f3g3793g4082ga061g42be5fb1b3c0"
msgid "Give it back! I'll cut you open for it."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Player
#. NodeID = 7248e16f-d533-b9ac-3cf2-d95f630583c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:7248e16f-d533-b9ac-3cf2-d95f630583c8
msgctxt "h0af3b00fge2c3g4123g925dgb7c731a65b2e"
msgid "Lot of assumptions here. I don't think I'm better than anyone else."
msgstr "추측이 과하군. 내가 다른 누구보다 낫다고 생각하지는 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Astarion
#. NodeID = 734c705e-7815-cae4-27f9-638f7da68b13
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:734c705e-7815-cae4-27f9-638f7da68b13
msgctxt "h2fff9452gb58dg4c0fgb1eeg054508055454"
msgid "No? I want to hear every sordid detail."
msgstr "그렇지? 난 지저분한 세부 사항까지 다 듣고 싶어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Player
#. NodeID = 769608b3-35d7-0f3e-62da-6ee5e3818e1c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:769608b3-35d7-0f3e-62da-6ee5e3818e1c
msgctxt "hb80cee1ag8b98g406dga8eagfd042bb4ac93"
msgid "<i>Follow the goblin's orders and kneel down - for now.</i>"
msgstr "<i>당장은 고블린의 명령을 따라 무릎을 꿇는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Karlach
#. NodeID = 76b7b4d9-9060-3d86-f7f9-af38c2a622e3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(10) = True
#.   Tag:
#.      - REALLY_KARLACH(10) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:76b7b4d9-9060-3d86-f7f9-af38c2a622e3
msgctxt "h5e9d484bg16a4g4058g8a9fga2e9290ded9d"
msgid ""
"Smart. You should get a few more pretty marks like mine. They're not just "
"for show."
msgstr "영리하군. 넌 나처럼 예쁜 표식들을 더 새겨야 해. 그냥 장식용이 아니라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = 78b1e0b8-d98c-805d-25d6-fda5d9bb0152
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_DrunkGoblin_Knows_IntimidateSuccess(4) = True
#. SetFlags:
#.   Object:
#.     - GOB_DrunkGoblin_Event_StartFistFight(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:78b1e0b8-d98c-805d-25d6-fda5d9bb0152
msgctxt "h06f2ccb8g9474g4e96gaa9dga6bb95a9a62b"
msgid "You want yer teeth knocked in? I can do that."
msgstr "이빨이 부러지길 원하냐? 내가 그렇게 만들 수 있는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Shadowheart
#. NodeID = 79e04ec3-7173-600a-0ba5-89be6e9cba50
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:79e04ec3-7173-600a-0ba5-89be6e9cba50
msgctxt "h658b7f30gbfbeg4f47gae6fgb67eabb653d2"
msgid ""
"Impressive. Though I'm not sure I want to know why you're so skilled at... "
"that."
msgstr "인상적인데. 어째서 네가 그걸.. 그렇게 잘하는지는 모르겠지만 말야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Sharp-Eye Breg
#. NodeID = 7de04f13-0271-eb49-990c-36d5cad36026
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:7de04f13-0271-eb49-990c-36d5cad36026
msgctxt "ha894d67cg892eg40edgb19cg439b04774105"
msgid "Bwa hah!"
msgstr "푸하!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Narrator
#. NodeID = 7e05b39c-2a95-830a-5843-303c434d42aa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:7e05b39c-2a95-830a-5843-303c434d42aa
msgctxt "h008c538dge351g4bf1g98b2gaf662547692a"
msgid "*But with one quick snatch, you envelop a toe in your foul maw.*"
msgstr "*하지만 한 번만에 당신은 발가락을 잘라 그 더러운 입 안에 집어넣습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Gale
#. NodeID = 7edccb67-3b8c-b9b4-8686-42bd02e23a42
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:7edccb67-3b8c-b9b4-8686-42bd02e23a42
msgctxt "h825f532egfd1bg457bgb18fg98a92d683749"
msgid ""
"I feel I should warn you that the average goblin foot is host to some two "
"dozen toe-curling diseases."
msgstr "평균적인 고블린 발은 약 24개의 당황스런 질병을 보유하고 있다는 사실을 경고해 줘야 할 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
