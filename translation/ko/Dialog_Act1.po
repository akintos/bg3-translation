msgctxt "h8ede3b94g0ee4g45b9gb15cg1279805cb6b5"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = b0435404-bdc8-2041-fa23-43a53d90f40a
