msgctxt "h0d3a259bg374ag4c7dga308gf56f927bd25c"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_UnfortunateGnome_Dead
#. Speaker = Barcus Wroot
#. NodeID = ecac36cd-8d60-4148-29d5-c1aacf07e8b9
