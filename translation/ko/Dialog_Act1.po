msgctxt "hc17133dcg1265g43b2gb951g06707f0c5c03"
msgid "Those shadows you saw? There's a creature inside my brain."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = b2d24ceb-81bb-f5c0-0249-6ef9f0d3b219
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:b2d24ceb-81bb-f5c0-0249-6ef9f0d3b219
msgctxt "hed10d6a8gb5e4g4a4fga2d5g4d7412aebbf7"
msgid ""
"Works both ways, mate. An' I saw some weird shadows swimmin' around in your "
"head just now."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = b3137135-c89d-7d4f-86c4-4044754c961e
#. HandlePath = TaggedText[0].TagText[0]
