#.      - eb95a50f-d6fe-d7c8-b65d-732df8bf8e00_B = True
#. SetFlags:
#.   Local:
#.     - eb95a50f-d6fe-d7c8-b65d-732df8bf8e00_A = False
#.     - eb95a50f-d6fe-d7c8-b65d-732df8bf8e00_B = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_Ogre_00:5aaa10cf-8b5c-dcf2-7554-e701d4a3d4ac
msgctxt "ha36a9265g354dg47d5gae94gf688c0bb43f0"
msgid "I ruin him."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_Ogre_00
#. Speaker = Guard Gurgon
#. NodeID = 6dad1004-10e6-4427-170e-b9da8efcd296
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_GoblinToast_State_RealizedPoison = True
#. SetFlags:
#.   Local:
#.     - eb95a50f-d6fe-d7c8-b65d-732df8bf8e00_A = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_Ogre_00:6dad1004-10e6-4427-170e-b9da8efcd296
msgctxt "hf4b5bfa5g54fcg4078g942fg0276086fd3e3"
msgid "I crush him."
msgstr "내가 그를 박살냈어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_Ogre_00
#. Speaker = Guard Gurgon
#. NodeID = c6290e58-2076-dff9-7ecf-931978195bb2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - eb95a50f-d6fe-d7c8-b65d-732df8bf8e00_A = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_Ogre_00:c6290e58-2076-dff9-7ecf-931978195bb2
msgctxt "ha67c3997g7928g4e47ga9dag810759cd6fcc"
msgid "Come, chicken. Come here. Eat."
msgstr "이리 와, 닭아. 이리로 와. 먹어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_SleepersHelp
#. Speaker = Booyahg Culk
#. NodeID = 4f6a5741-79d7-53ae-f356-f7c9d6d57f43
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_SleepersHelp:4f6a5741-79d7-53ae-f356-f7c9d6d57f43
msgctxt "h5c499cc6gf0f0g411dgad01g1f1d0f284300"
msgid "Intruders! Up - UP!"
msgstr "침입자다! 일어나! 일어나라고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_Table1
#. Speaker = Tracker Puli
#. NodeID = 1176d34b-5ec9-bfdd-0874-7bfd03f21856
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_Festivities_Said1(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_Table1:1176d34b-5ec9-bfdd-0874-7bfd03f21856
msgctxt "he6a1213bgaaacg4b7cg8ad1gaabf500b433b"
msgid "Tastes even better when you nick it outta their cold, dead 'ands."
msgstr "죽어서 차가워진 손에서 슬쩍하면 더 맛있더라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_Table1
#. Speaker = Tracker Puli
#. NodeID = 170a12e9-ad19-7023-9d17-5f08404d2a96
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_Table1:170a12e9-ad19-7023-9d17-5f08404d2a96
msgctxt "h655c400eg670dg4634g9289g233c62052533"
msgid "My rat sings better than him!"
msgstr "내가 기르는 쥐새끼가 저놈보단 잘 부르겠다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_Table1
#. Speaker = Tracker Puli
#. NodeID = 1c197eeb-a8b8-8c30-3a0d-7d65d8ab07ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_Table1:1c197eeb-a8b8-8c30-3a0d-7d65d8ab07ec
msgctxt "h080c4236g8a07g47cegb611g276b0751be5c"
msgid "That's the drink talkin'. Absolute wouldn't speak to a worm like you."
msgstr "취했구만. 절대자님은 너 같은 벌레한테는 말을 거시지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_Table1
#. Speaker = Sharp-Eye Mirg
#. NodeID = 4961b7df-365b-3d28-69d6-6c93878470c0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Festivities_Said1(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_Table1:4961b7df-365b-3d28-69d6-6c93878470c0
msgctxt "h26db24f2g67d6g413dgb531gc16eb051ef83"
msgid "Wozzat...? I think I 'eard the Absolute's voice just now."
msgstr "뭐지...? 방금 절대자의 목소리를 들은 것 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_Table1
#. Speaker = Tracker Puli
#. NodeID = 56c1a8ce-898d-24d3-d2df-8841c9006189
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_Table1:56c1a8ce-898d-24d3-d2df-8841c9006189
msgctxt "h8a746f00g9638g4c24g87cfg265b0bb704ea"
msgid "Get off yer arse and do yer own killin'!"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_Table1
#. Speaker = Sharp-Eye Mirg
#. NodeID = 5c3f339d-a95a-f660-c691-20c1c9a80093
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_Table1:5c3f339d-a95a-f660-c691-20c1c9a80093
msgctxt "h7bb6db29g88a8g4303ga303g7e25259632eb"
msgid "Aw, come on. I'm wounded! That wizard burned me sumfin' proper."
msgstr "아우, 제발. 난 다쳤어! 저 마법사가 나를 제대로 태웠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_Table1
#. Speaker = Sharp-Eye Mirg
#. NodeID = 8d27b94b-a3f7-5040-23d4-361200a0dec2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Festivities_Said1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_Table1:8d27b94b-a3f7-5040-23d4-361200a0dec2
msgctxt "h5d0fc227gab89g4ffbg9a7eg4f7a3465f52e"
msgid "Humans ain't good for much, but they make tasty beer."
msgstr "인간은 별로 쓸 데가 없지만, 맥주 하나는 기가 막히게 만들지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_Table1
#. Speaker = Sharp-Eye Mirg
#. NodeID = 961392a6-7274-b01b-cbee-f917c7256912
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_VoloBallad_State_OnStage = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_Table1:961392a6-7274-b01b-cbee-f917c7256912
msgctxt "h75461a43geefbg46ecga07cgb813ee3c7136"
msgid "Don't this stupid human know any good goblin warsongs?"
msgstr "저 멍청한 인간은 멋진 고블린 군가는 하나도 모르냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_Table1
#. Speaker = Sharp-Eye Mirg
#. NodeID = b2afa822-4415-9b2d-2004-349c28c7a8c4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - b3a30b8e-9e0d-7a9d-2f76-a7e5685574cc_DiscussedRaid = False
#. SetFlags:
#.   Local:
#.     - b3a30b8e-9e0d-7a9d-2f76-a7e5685574cc_DiscussedRaid = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_Table1:b2afa822-4415-9b2d-2004-349c28c7a8c4
msgctxt "h2bdd2addgf4cbg4a1fgb02dgbec6409a1007"
msgid "You goin' on the next raid? Bring me back sumfin' pretty"
msgstr "다음 습격에 참여 할 거야? 뭔가 멋진 것 좀 가져다 줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_Table1
#. Speaker = Tracker Puli
#. NodeID = d97fc850-303e-69eb-28c2-a8081c50f76f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_Festivities_Said1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_Table1:d97fc850-303e-69eb-28c2-a8081c50f76f
msgctxt "hfc5448ffgbcf1g4a7fgbfbcg7da7f3a2a189"
msgid "Gotta be chosen to hear Her. Like the boss an' priestess."
msgstr "그녀 말을 들으려면 선택받아야 해. 두목이나 여사제님처럼 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_Table1
#. Speaker = Tracker Puli
#. NodeID = f606901a-7c0a-3717-2974-fcb34590f9e8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_Table1:f606901a-7c0a-3717-2974-fcb34590f9e8
msgctxt "h90376bdaga01dg4dbbg8e4eg5c4a45765720"
msgid "For the last time, that weren't a wizard. It was a bloke with a torch!"
msgstr "마지막으로 말하지만, 그건 위저드가 아니라 횃불을 든 녀석이었다고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_Table2
#. Speaker = Tracker Tak
#. NodeID = 1138b4ae-db6e-c3b0-762d-53c7c7d2e75d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_Festivities_Said2(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_Table2:1138b4ae-db6e-c3b0-762d-53c7c7d2e75d
msgctxt "h33b49cb0g73cag41e5gb65dgc3fec3a6ed40"
msgid ""
"It's the drow that put the fear in 'em. Creepy bastards scare me, and we're "
"on the same side."
msgstr "놈들을 두려움에 떨게 만드는 건 드로우야. 나도 걔네가 무섭지만, 같은 편이라 다행이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_Table2
#. Speaker = Brawler Rot
#. NodeID = 2c7ef601-0fe1-3912-e633-4b8d8228ba64
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_Table2:2c7ef601-0fe1-3912-e633-4b8d8228ba64
msgctxt "h8a4596abg9dd7g4f3cg89cbg92a596bbdb70"
msgid "We eatin' that chicken wot woz runnin' about the place?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_Table2
#. Speaker = Tracker Tak
#. NodeID = 3f0abed5-0ae3-b7c4-3c72-073503baec2d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_VoloBallad_State_OnStage = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_Table2:3f0abed5-0ae3-b7c4-3c72-073503baec2d
msgctxt "h5742c29fg86b4g4c15g8404g8a55340a4085"
msgid "Sing louder or we'll cook ya!"
msgstr "더 크게 안 부르면 잡아먹는다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_Table2
#. Speaker = Warrior Sul
#. NodeID = 6ed2594a-347e-d26b-6f81-3df3ad398df3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Festivities_Said1(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_Table2:6ed2594a-347e-d26b-6f81-3df3ad398df3
msgctxt "h43280c8bg7069g4c1bg990bg9a8adf74ed54"
msgid "Should've let that dwarf run around a bit before we cooked 'im."
msgstr "우리가 그 드워프를 요리하기 전에 조금 뛰어다니게 놔두었어야 했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_Table2
#. Speaker = Warrior Sul
#. NodeID = ace61d36-de67-eaf9-40af-426e21f83b7c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Festivities_Said2(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_Table2:ace61d36-de67-eaf9-40af-426e21f83b7c
msgctxt "hde36b707g0902g4e92ga2d0ga59927395b4d"
msgid ""
"Innkeeper's guts spilled out... I wore 'em like a belt. That put the fear in "
"the rest of 'em."
msgstr "여관 주인의 내장이 흘러나왔지... 나는 그것을 허리띠처럼 착용했고. 그 모습이 나머지 사람들에게 공포심을 불러 일으켰어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_Table2
#. Speaker = Brawler Rot
#. NodeID = b11d86e5-ef6e-cd9b-7def-6d44618685b7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_Festivities_Said1(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_Table2:b11d86e5-ef6e-cd9b-7def-6d44618685b7
msgctxt "hf8682175g02beg43e9gb961g61e84011793d"
msgid "Yeah. And given 'im a good kickin' ta tenderise the meat."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_Table2
#. Speaker = Tracker Tak
#. NodeID = ed03bc68-9184-7405-c4a0-6128f0c9929c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_Festivities_Said2(2) = False
#.     - GOB_Festivities_Said1(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_Table2:ed03bc68-9184-7405-c4a0-6128f0c9929c
msgctxt "h36226638g4dd9g4a29g9b14g921297616b5f"
msgid "Rather have dwarf myself - smells good an' ready, don't it?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_Table3
#. Speaker = Sharp-Eye Aggy
#. NodeID = 2e5c73a4-3a12-f8d1-b387-4fb921dd2412
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - fb5c2553-8069-812c-66c5-e2c767048438_A = False
#.      - fb5c2553-8069-812c-66c5-e2c767048438_B = False
#.      - fb5c2553-8069-812c-66c5-e2c767048438_C = False
#. SetFlags:
#.   Local:
#.     - fb5c2553-8069-812c-66c5-e2c767048438_A = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_Table3:2e5c73a4-3a12-f8d1-b387-4fb921dd2412
msgctxt "hcb40d6d4g85e7g4c75gbc36gc6b4184420e1"
msgid "Go on! Give the worgs some booze! They'll love it."
msgstr "어서! 워그들에게 술을 주어라! 아주 좋아할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_Table3
#. Speaker = Sharp-Eye Aggy
#. NodeID = 3b45003c-6e51-1e71-1c0b-4a42faa90ad0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_VoloBallad_State_OnStage = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_Table3:3b45003c-6e51-1e71-1c0b-4a42faa90ad0
msgctxt "h44797761ga340g4f73gac1bg624c60efa939"
msgid "Sing the saucy one about the bugbear and the ogre!"
msgstr "버그베어와 오거가 나오는 야한 노래 불러 봐!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_Table3
#. Speaker = Sharp-Eye Aggy
#. NodeID = 51ec1f1c-92a9-49d3-5956-eec9febc7427
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - fb5c2553-8069-812c-66c5-e2c767048438_A = True
#.      - fb5c2553-8069-812c-66c5-e2c767048438_B = True
#.      - fb5c2553-8069-812c-66c5-e2c767048438_C = True
#. SetFlags:
#.   Local:
#.     - fb5c2553-8069-812c-66c5-e2c767048438_A = False
#.     - fb5c2553-8069-812c-66c5-e2c767048438_B = False
#.     - fb5c2553-8069-812c-66c5-e2c767048438_C = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_Table3:51ec1f1c-92a9-49d3-5956-eec9febc7427
msgctxt "h9c96ea5fg7ef9g4f49gb7f2g6398ee38ab1e"
msgid "Here's to the Absolute!"
msgstr "절대자님을 위하여!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_Table3
#. Speaker = Sharp-Eye Aggy
#. NodeID = c8344e23-57a6-69e8-961e-9aa903b05669
#. HandlePath = TaggedText[0].TagText[0]
