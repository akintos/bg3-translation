msgctxt "h1c7d2c07gb753g4b08gbe1eg3477b3466778"
msgid "*The corpse regards you lifelessly.*"
msgstr "*시체가 생기 없는 모습으로 당신을 맞이합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithCaptain_Dead
