msgctxt "hc834cc21g5b1bg4d18g8390g2fb09a93c7a8"
msgid "The hag's lair again. Sans hag that is."
msgstr "해그의 동굴로 돌아왔군. 해그는 이제 없지만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_FairyRings_PAD_TeleportedFromUnderdarkToHag
