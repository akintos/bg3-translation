msgctxt "h8db93ff4g935fg47d1gbd6dg4e41200ff777"
msgid "Hey! What are you trying to pull?"
msgstr "이봐요! 뭘 하려는 건가요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_002
#. Speaker = Olly
