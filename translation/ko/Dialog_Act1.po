msgctxt "ha08deb69gc5ddg4a7fg9944g2f5f343029fa"
msgid "I could listen to this forever..."
msgstr "이거라면 영원히 들을 수 있어..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerCharmed
