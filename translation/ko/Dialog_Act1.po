#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_AD_TemplarCombatFirstLine
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = ae729e66-9303-5673-ba1f-4b0e3bb66e32
#. HandlePath = TaggedText[0].TagText[0]
