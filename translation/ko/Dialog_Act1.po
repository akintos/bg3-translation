#.      - GEN_IsSpeakerPresent_2 = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_FurnaceSearch_PAD_MadRecords:42fa9e78-96c2-41c0-9e32-b8604dd0c88d
msgctxt "h4ebdf7f7g1446g441egb616g2aba95268048"
msgid "These notes speak of an adamantine forge hidden deep below."
msgstr "이 메모들은 깊숙이 숨겨진 어떤 아다만틴 대장간을 언급하고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_FurnaceSearch_PAD_MadRecords
#. Speaker = Player
#. NodeID = 42fa9e78-96c2-41c0-9e32-b8604dd0c88d
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_FurnaceSearch_State_LearnedForgeFromMadDrowFirst = True
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_FurnaceSearch_PAD_MadRecords:42fa9e78-96c2-41c0-9e32-b8604dd0c88d
msgctxt "ha7ca70e2ga5b4g4eb5gb4cfg4af9d3a9c25e"
msgid ""
"An adamantine forge, hidden deep in the Underdark - the stuff of legends."
msgstr "언더다크 깊숙이 숨겨진 아다만틴 대장간이라, 전설 속의 장소군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_FurnaceSearch_PAD_MadRecords
#. Speaker = Player
#. NodeID = 42fa9e78-96c2-41c0-9e32-b8604dd0c88d
