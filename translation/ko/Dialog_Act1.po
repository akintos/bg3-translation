#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dead:e098dd86-607d-efca-9b70-c7b9bcb94ac6
msgctxt "hc1c7febfgdd35g4beegb54bg37ee17160822"
msgid "What's your profession?"
msgstr "무슨 일을 했지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dead
#. Speaker = Player
#. NodeID = f0b9a516-1140-b9b5-66f4-b4f7a860bc60
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dead:f0b9a516-1140-b9b5-66f4-b4f7a860bc60
msgctxt "h5ca70c91g50f1g420ag856bg194041c1f4d2"
msgid "Where are you from?"
msgstr "어디서 왔지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Scratch
#. NodeID = 0d59fa86-9fc9-4a7a-c441-4dc47cad836e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:0d59fa86-9fc9-4a7a-c441-4dc47cad836e
msgctxt "h56ad4e7cg308eg45f8gaf45gf86cb4126a2b"
msgid "*Arf! Arf!*"
msgstr "*왈! 왈!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Player
#. NodeID = 112b43da-f624-7203-9086-99aae4593c29
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_Courier_State_DogPlayful = True
#.   Tag:
#.     - HUMANOID(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:112b43da-f624-7203-9086-99aae4593c29
msgctxt "hc487a536g341bg4108ga574gdcd689f57e77"
msgid "<i>Pet him.</i>"
msgstr "<i>쓰다듬어준다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Scratch
#. NodeID = 11f24384-c7f9-64d8-4d8e-1027f6b37a72
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - FOR_Courier_Dog_Event_Skillcheck_Fail(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:11f24384-c7f9-64d8-4d8e-1027f6b37a72
msgctxt "h53e03372g1bc3g4cecga312g6341acf13512"
msgid "*Grrrrrr.*"
msgstr "*으르르르.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Scratch
#. NodeID = 13057e9c-a4b7-70e8-0ec4-77fa7b699998
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - FOR_CourierDog_Event_SwASkillcheckFail(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:13057e9c-a4b7-70e8-0ec4-77fa7b699998
msgctxt "h63f9cc88ge3f2g413bgbd2eg7db646d9db00"
msgid "These wilds crawl with monsters. You could be one of them."
msgstr "이 야생에는 온갖 괴물이 도사리고 있어. 너도 그중 하나일지도 모르지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Player
#. NodeID = 16a84772-80ac-56d5-d99d-72b00c688d89
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:16a84772-80ac-56d5-d99d-72b00c688d89
msgctxt "hea775f66gef90g46e3g932cg0d3a03ab9dcc"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Scratch
#. NodeID = 1827bbf8-899d-f82d-88c8-f1e58db950d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:1827bbf8-899d-f82d-88c8-f1e58db950d8
msgctxt "hf336d7aagc05fg4116g859agacd187d8254b"
msgid "*Whimper.*"
msgstr "*낑낑.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Scratch
#. NodeID = 1c305154-b2b1-e3bc-7d46-13735346e5d5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:1c305154-b2b1-e3bc-7d46-13735346e5d5
msgctxt "h0c309845g1321g4c27gae58gf59767f8f9d9"
msgid "What are you doing? Get back!"
msgstr "뭐 하는 거야? 물러서!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Player
#. NodeID = 1d5e351c-3ec9-bc42-23f3-bd95641f5e3b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_Courier_Dog_Knows_FinishingMourning(1) = False
#.   Global:
#.      - FOR_Courier_Knows_DogName = False
#. SetFlags:
#.   Dialog:
#.     - FOR_Courier_Dog_Knows_FinishingMourning(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:1d5e351c-3ec9-bc42-23f3-bd95641f5e3b
msgctxt "hc78090dcgcf08g4e74gacf9gdd01f810137a"
msgid "<i>Motion him to follow.</i>"
msgstr "<i>녀석에게 따라오라고 손짓한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Player
#. NodeID = 1d674fa8-06f3-7457-24ad-27abfd9778bd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:1d674fa8-06f3-7457-24ad-27abfd9778bd
msgctxt "h17613ef1g296eg41f4g8eecg1c1a6e35de0a"
msgid "<i>Leave him to his sorrow.</i>"
msgstr "<i>계속 슬퍼하게 놔두고 떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Scratch
#. NodeID = 1ed1e069-17f3-ec96-812e-30a79c95e8ec
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_CourierDog_State_AngeredDog(1) = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:1ed1e069-17f3-ec96-812e-30a79c95e8ec
msgctxt "heaf1d581gad8bg4c05gb5f9g673e7d74cfb3"
msgid "Leave us alone."
msgstr "우릴 가만히 내버려 둬."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Scratch
#. NodeID = 20d9b8db-67db-8317-45fb-21cadbc09dbb
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - FOR_CourierDog_State_AngeredDog(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:20d9b8db-67db-8317-45fb-21cadbc09dbb
msgctxt "h8972e0ecg3600g4e80g915cg404d407527bf"
msgid "Just go. I won't ask you again."
msgstr "그냥 가. 다시 묻진 않을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Player
#. NodeID = 213cbfd7-bfa3-1599-fb13-ac8bded80955
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:213cbfd7-bfa3-1599-fb13-ac8bded80955
msgctxt "h10a2aa8ag83ceg42d2ga8e1gffc77a8eb026"
msgid "I don't think he's going to wake up."
msgstr "그가 일어날 것 같지는 않은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Scratch
#. NodeID = 23ff891d-a1ba-fc79-28f8-405e7175359f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - FOR_CourierDog_State_AngeredDog(1) = True
#.   Object:
#.     - FactionHostileToIndivPlayerAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:23ff891d-a1ba-fc79-28f8-405e7175359f
msgctxt "hb6a59b79g12f5g4324gadafg05fd73d1b81b"
msgid "That's enough!"
msgstr "이제 그만!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Player
#. NodeID = 24b780a8-a740-4347-4124-b43e8a394bd2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:24b780a8-a740-4347-4124-b43e8a394bd2
msgctxt "h9e6eebbag96c4g4916gb51eg835483ae52f0"
msgid "<i>Shoo him away.</i>"
msgstr "<i>녀석을 내쫓는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Narrator
#. NodeID = 2a16be4e-8bd5-afd0-b6d5-ff9c1b996be4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_CourierDog_State_AngeredDog(1) = True
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:2a16be4e-8bd5-afd0-b6d5-ff9c1b996be4
msgctxt "h07fe9960g7680g4818gb778gf3dd5be064e2"
msgid "*The dog flashes its teeth in a snarl - he wants you gone.*"
msgstr "*개가 이빨을 보이며 으르렁댑니다. 당신이 떠나길 원하고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Player
#. NodeID = 2baa5596-79b8-467c-41b3-3b952aa7255b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:2baa5596-79b8-467c-41b3-3b952aa7255b
msgctxt "h9a4b1224gbf31g4467g820cgf16cf287e92c"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Scratch
#. NodeID = 2baa694d-ffbd-f65d-61ff-ae5be60af473
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_Courier_Dog_HasMet(1) = True
#.   Global:
#.      - FOR_Courier_State_DogCalm = False
#.      - FOR_Courier_State_DogPlayful = False
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:2baa694d-ffbd-f65d-61ff-ae5be60af473
msgctxt "ha8f1d514g24afg48c4g8b09g5e71d9f4a733"
msgid "*Grrr!*"
msgstr "*으르르!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Player
#. NodeID = 32a62b44-7110-b976-d32e-6143693a2bd5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:32a62b44-7110-b976-d32e-6143693a2bd5
msgctxt "h8ce9c623g3820g4de0gab9fge3f61788470c"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Scratch
#. NodeID = 3ad39f51-02e3-9589-302b-600e71519521
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:3ad39f51-02e3-9589-302b-600e71519521
msgctxt "h78cd2dc3g0f03g4a97gac1cg2882295f3aad"
msgid "It's not over yet. He'll wake up."
msgstr "아직 끝나지 않았어. 곧 일어날 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Scratch
#. NodeID = 3b57aac0-9f24-e550-273f-e56427ab6f7d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:3b57aac0-9f24-e550-273f-e56427ab6f7d
msgctxt "hca6c93bega20ag4ff6g90c5g3fe1f807e5c4"
msgid "Still, you should go. My friend is injured. He needs rest."
msgstr "하지만, 그래도 가줘야겠어. 내 친구가 다쳤어. 그에겐 휴식이 필요해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Scratch
#. NodeID = 3cf89180-fde3-13a1-2261-a5521e9fde11
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_CourierDog_HasMet_SpeakWithAnimals(1) = False
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:3cf89180-fde3-13a1-2261-a5521e9fde11
msgctxt "hc64d1c9dgeb56g4f8agaaabg29d42a7ae7f9"
msgid "Keep moving, stranger. <i>Quietly</i>."
msgstr "가던 길 가, 이방인. <i>조용히</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Player
#. NodeID = 3e09bffb-68d4-8bcb-4d6d-d19926cf0d34
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:3e09bffb-68d4-8bcb-4d6d-d19926cf0d34
msgctxt "h25b15b46ge283g43a1g80a0g31cec405c8e3"
msgid "Who is that?"
msgstr "그건 누구야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Narrator
#. NodeID = 3f163a2b-33b5-349f-3004-b1a6200070d0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 8e73965a-3b0f-d812-15f1-2e9d011144f0_AHSuccess = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:3f163a2b-33b5-349f-3004-b1a6200070d0
msgctxt "ha8d271b5g1387g4f9bga24fg01f620262a1f"
msgid "*The dog whimpers nervously, as if to urge you on.*"
msgstr "*개는 더 쓰다듬어 달라는 듯 낑낑거립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Narrator
#. NodeID = 411e1a84-3754-a5ac-c8ff-ccaa0e1237d1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_Courier_Knows_DogName = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:411e1a84-3754-a5ac-c8ff-ccaa0e1237d1
msgctxt "h0c51a565ga939g450fg9587gdfdbbf6aafd9"
msgid "*You see a name etched into the leather - 'Scratch'.*"
msgstr "*가죽에 새겨진 이름을 발견합니다- '스크래치'.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Player
#. NodeID = 41d3d7f2-046a-909a-84a7-fcc52a83736b
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#. TagRule: BERSERKER
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:41d3d7f2-046a-909a-84a7-fcc52a83736b
msgctxt "h9858b33cg8cb6g4ba6g94a0gc6c88868d203"
msgid "I don't want to hurt you. <b>BUT I CAN</b>."
msgstr "널 해치고 싶진 않아. <b>하지만 내게 어려운 일은 아니야</b>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Player
#. NodeID = 41d3d7f2-046a-909a-84a7-fcc52a83736b
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:41d3d7f2-046a-909a-84a7-fcc52a83736b
msgctxt "hf8ddadc4gf30dg4be5gafbdgc1087b6b93ba"
msgid "You don't want me angry. Trust me - one animal to another."
msgstr "같은 짐승으로서 충고하는데, 내 성깔을 돋구지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Scratch
#. NodeID = 431d9e93-2d88-fb84-a34a-dfa652350fdb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:431d9e93-2d88-fb84-a34a-dfa652350fdb
msgctxt "h5e31f0fag8e52g4240g9acbgef4b6549bf44"
msgid "Your words are uglier than the rest of you."
msgstr "네 말은 네 자신보다 추악하구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Player
#. NodeID = 43e83e21-3ae8-f42d-919b-5ee121de1f3f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC(1) = True
#. TagRule: CLERIC_GOOD or CLERIC_NEUTRAL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:43e83e21-3ae8-f42d-919b-5ee121de1f3f
msgctxt "h492c1c9bgf6c8g4456gb4e3g42e29d1b9a50"
msgid "He's with his god now. I'm sorry."
msgstr "그는 이제 신을 만나러 갔어. 유감이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Scratch
#. NodeID = 4566ac82-0111-237d-ed66-9e01c606a2b7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_Courier_State_DogCalm = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:4566ac82-0111-237d-ed66-9e01c606a2b7
msgctxt "h7811d9a9gae1fg477egb1b2gf731ccbb909e"
msgid "Perhaps that's true. Your scent is thick with blood."
msgstr "그런 것 같네. 네 체취에 피 향기가 가득해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Scratch
