#.      - FOR_GoblinAmbush_PatrollingGoblin_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_PatrollingGoblin:3521bef3-645e-b160-4b3f-de62549d82d1
msgctxt "hfa33a3dcgbc5cg4e6eg84b9g504ad7fdb025"
msgid "Mind the ogres, your drowsiness. They don't got no respect."
msgstr "오우거를 조심하세요, 드로우님. 놈들은 존중심이 없으니까요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_PatrollingGoblin
#. Speaker = Goblin Brawler
#. NodeID = 87da663b-0bbf-d0e7-d916-476c06a33f3e
