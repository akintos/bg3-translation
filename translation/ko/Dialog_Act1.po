#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:721f5691-7477-8ba8-c1e9-649f593b5002
msgctxt "h832b1cbeg65d8g4874gbd9ege5bb5b002367"
msgid "I don't <i>try</i> - I get results. Move aside."
msgstr "난 <i>시도하지</i> 않아. 결과를 얻지. 저리 비켜."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
