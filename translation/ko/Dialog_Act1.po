msgctxt "hcdea4814gb8f9g4530gb037g31703bab1f2a"
msgid "Who are you?"
msgstr "너는 누구지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_TollCollector001_Dead
#. Speaker = Dead Toll Collector
#. NodeID = 3121e858-bb0e-e325-3ee6-34632955c6b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_TollCollector001_Dead:3121e858-bb0e-e325-3ee6-34632955c6b6
msgctxt "hd6561c52g25e0g4cacg8674g30dd598116f8"
msgid "... goblins... laughing... cutting..."
msgstr "... 고블린들이... 웃으면서... 칼로 베고..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_TollCollector001_Dead
#. Speaker = Dead Toll Collector
#. NodeID = 3c951c85-0e0f-6f52-292e-03b1317a682e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_TollCollector001_Dead:3c951c85-0e0f-6f52-292e-03b1317a682e
msgctxt "h6b708965g7589g4246g91b0g6a614b596848"
msgid "... guards... abandoned me... and Vance..."
msgstr "... 경비병들이... 나랑 밴스를... 버리고 도망쳤어..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_TollCollector001_Dead
#. Speaker = Dead Toll Collector
#. NodeID = 5e8fd6d8-b735-f29b-9f22-a07af815798b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_TollCollector001_Dead:5e8fd6d8-b735-f29b-9f22-a07af815798b
msgctxt "hdea621dbg54fbg4cfag8a71g9dfd792dfb8f"
msgid "... hiding... frightened..."
msgstr "... 숨어 있었어... 겁에 질려서..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_TollCollector001_Dead
#. Speaker = Player
#. NodeID = 69f5322b-6587-6c09-ab9d-edfb230090cb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_TollCollector001_Dead:69f5322b-6587-6c09-ab9d-edfb230090cb
msgctxt "h456bc978g2a65g4df3g867eg4e8a01c1d34a"
msgid "Were you alone when you died?"
msgstr "죽었을 때 혼자 있었나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_TollCollector001_Dead
#. Speaker = Narrator
#. NodeID = 7f83d1f5-f2e3-3d35-50c3-0d6f9b8e4dc7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
