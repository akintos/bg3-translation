msgctxt "h49a1d691g3883g4fb9g8e88gd1b5ed84205c"
msgid "Nice view."
msgstr "경치 좋네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_HarperBooster_AD_Rock
#. Speaker = Player
#. NodeID = 5d3c8029-fb61-e9b9-9506-9c5697e52ad2
