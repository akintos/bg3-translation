msgctxt "hdcda33f8g9648g4d17g8756g2f63ee564501"
msgid "*You know the creatures he describes - gnolls.*"
msgstr "*어떤 생물을 묘사하는지 알 것 같습니다. 놀 입니다*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Scratch
#. NodeID = 705e76f3-a95b-7bd2-28e7-817a43a39512
#. HandlePath = TaggedText[0].TagText[0]
