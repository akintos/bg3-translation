#.      - GEN_CanDetectThoughts_2 = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinKid002_LootingCrime:aa2f86bb-0a55-7514-0ac0-4441c7c1e317
msgctxt "hbba12022g4d41g457ega2fdg3f4da699f382"
msgid "<i>Read the child's mind.</i>"
msgstr "<i>아이의 정신을 읽는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinKid002_LootingCrime
