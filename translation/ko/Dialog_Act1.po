msgid "<i>Shka'keth! </i>Traitor!"
msgstr "<i>슈카'케쓰! </i>배신자!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_LaezelRunsToKnight
#. Speaker = Lae'zel
#. NodeID = 0be40b1c-aad0-dd40-a0de-a7a7c583502b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_LaezelRunsToKnight:0be40b1c-aad0-dd40-a0de-a7a7c583502b
msgctxt "hac451917g8a5dg44ffg8bd8g9cd2035032b8"
msgid "<i>Kith'rak. </i>We must speak!"
msgstr "<i>키스락. </i>할 말이 있습니다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_LaezelSidesWithGith
#. Speaker = Lae'zel
#. NodeID = 0b89e860-3900-9641-baae-d0e668b5a414
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_GithChokepoint_Event_LaezelLeftParty = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_LaezelSidesWithGith:0b89e860-3900-9641-baae-d0e668b5a414
msgctxt "h6a027aa4g320ag429cgadd3ge2a7c77c72d9"
msgid "I should have ended you when I had the chance."
msgstr "기회가 있을 때 널 죽여버렸어야 했는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_LaezelSidesWithGith
#. Speaker = Lae'zel
#. NodeID = 80191dcf-e085-eab9-b027-708d3c0809cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_LaezelSidesWithGith:80191dcf-e085-eab9-b027-708d3c0809cb
msgctxt "h6d194f1cg9520g4266g9cb6g5290c5e8bfca"
msgid "<i>Shka'keth! </i>I will tolerate you no longer."
msgstr "<i>쉬카케쓰!</i>더 이상은 참지 않겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_LaezelWithKnight
#. Speaker = Kith'rak Voss
#. NodeID = 0f92bbec-60b4-21ca-2114-1c1fdc4220fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_LaezelWithKnight:0f92bbec-60b4-21ca-2114-1c1fdc4220fc
msgctxt "h49066db5g5dabg443egb624g5289b49bcb03"
msgid "And yet you do not heed her <i>kith'rak's</i> command."
msgstr "그런데도 그분의 <i>키스락</i>이 내리는 명령에 따르지 않는구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_LaezelWithKnight
