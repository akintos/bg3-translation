msgctxt "hb9bbec03ga516g4df6g8a5dgc9e7e6ab5b57"
msgid "*As the symbol glows, power courses through you. <i>Authority.</i>*"
msgstr "*문양이 빛나며, 힘이 당신을 타고 흐릅니다. <i>권위.</i>*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear
#. Speaker = Player
#. NodeID = 8892c750-d65d-b9f0-97eb-2b2aacd103ef
#. HandlePath = TaggedText[0].TagText[0]
