msgid "No, thanks - I just want to trade."
msgstr "사양하지. 나는 그냥 거래하길 원해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03
#. Speaker = Player
#. NodeID = 1fa424f0-4b80-54a8-f45f-1ddb6b9b7005
