#. CheckFlags:
#.   Dialog:
#.      - WLD_UnfortunateGnome_Why(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:8cc684ba-e2c7-cd91-2f09-f1fc73e046fc
msgctxt "hade9311fg978eg4360gb5bdg1693af8c2b83"
msgid "Fun's over - release the gnome at once."
msgstr "즐거움은 끝이다. 저 노움을 당장 풀어줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = 8e26a67b-48e4-2c7b-fe56-c40ab865ce30
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_GnomeGoblinsPromisedLeave = False
#.   Tag:
#.      - DROWELF(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:8e26a67b-48e4-2c7b-fe56-c40ab865ce30
msgctxt "h69b4efebg654cg470dga0b3g8136508fc8dd"
msgid "Look what we got here - another little birdie wantin' to fly!"
msgstr "이것 봐라, 날고 싶은 새가 한 마리 더 왔어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Player
#. NodeID = 8f77e9c8-6492-6efa-50ca-01f750282215
