msgctxt "h2e1128bbg85b9g4b85g8689gf3f4d82bce6a"
msgid "Your corpse would be just as useful, <i>ghaik </i>filth."
msgstr "네놈의 시체가 더 유용하겠군, <i>게이크</i> 쓰레기."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Lae'zel
#. NodeID = e235d694-204a-8a53-c47e-2a809cc09e44
#. HandlePath = TaggedText[0].TagText[0]
