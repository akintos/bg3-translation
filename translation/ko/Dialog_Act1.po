#, fuzzy
msgctxt "h5cdb95d2ge7b9g4b9bga25bg22da5a28a90b"
msgid "For now."
msgstr "오, 너 정말 멍청하구나, 그거 아니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead
#. Speaker = Auntie Ethel
#. NodeID = fb688c11-3737-9c1c-513b-13f0059a0966
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead:fb688c11-3737-9c1c-513b-13f0059a0966
msgctxt "h6c375715ge3a0g45a8g89dag4c1ba558530e"
msgid ""
"From my guts she would've come - my blood, my <i>bile.</i> It would have "
"been glorious. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead
#. Speaker = Auntie Ethel
#. NodeID = fe72219a-feee-f9bb-bcd7-0e769a6108f8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
