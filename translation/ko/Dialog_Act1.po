msgctxt "h81130213g5cc4g4439gaf85ged49a07edab5"
msgid "Left... the... Underdark... way home... nearby..."
msgstr "언더다크를... 떠나왔어... 집으로 가는길... 근처..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_UnfortunateGnome_Dead
