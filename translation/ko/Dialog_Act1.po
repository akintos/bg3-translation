msgctxt "h091a5715g1f9cg40a8gb742g569df75a95f7"
msgid "Who are you?"
msgstr "너는 누구지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander_Dead
#. Speaker = Nightwarden Minthara
#. NodeID = a7ec4536-5812-c1a1-12c4-a753a52000e3
