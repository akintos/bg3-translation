msgctxt "h5a33de71g35d7g4390gb374g72be9686cc26"
msgid "<i>Follow the </i>ghustil<i>'s instruction. Seek the tadpole.</i>"
msgstr "<i></i>거스틸<i>의 지침을 따른다. 올챙이를 수색한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Narrator
#. NodeID = a74bf5a9-dd91-bb39-3bcd-b5429b172658
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
