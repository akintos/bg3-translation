msgctxt "hf6eb7e99g97e8g4264gb6e1ge164784f729d"
msgid "Go, seek Inquisitor W'wargaz within. <i>Ch'mar, zal'a Vlaakith.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Gish Far'aag
