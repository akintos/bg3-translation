msgid "<i>Converse </i>with it? I barely know what <i>it</i> is!"
msgstr "<i>얘기</i>를 나눠? 난 <i>저게</i> 뭔 종자인지조차 모른다고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene
#. Speaker = Damays
#. NodeID = 98d2fa47-a7d0-7caa-b9e2-c256f924ba59
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene:98d2fa47-a7d0-7caa-b9e2-c256f924ba59
msgctxt "hf12bdb30g0caag4a7cgbf1fg4c7a46dbe9dd"
msgid "Nymessa, watch out!"
msgstr "나이메사, 조심해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene
#. Speaker = Nymessa
#. NodeID = 9ae271bb-36b7-febb-ca3d-c5eb297093ca
