msgctxt "h6d08cf00g50e2g449dga9e1gd6b032790cc3"
msgid "Haven't had enough yet?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_SecurityOfficer01
#. Speaker = Warrior Brelal'reth
#. NodeID = 185ba64e-3d36-5ae3-d474-e74051a24c8b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet2_SecurityOfficer01(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_SecurityOfficer01:185ba64e-3d36-5ae3-d474-e74051a24c8b
msgctxt "h740bd634g6094g4836ga473gabfba8111c62"
msgid ""
"Our purpose is almost fulfilled. You must cleanse the weapon, as Vlaakith "
"instructed."
msgstr "우리 목적을 거의 이뤘군, 블라키스 님의 명대로, 무기를 반드시 정화해야 한다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_SecurityOfficer01
#. Speaker = Warrior Brelal'reth
#. NodeID = 215c1be7-9788-f33c-03d1-ac18036dd078
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet2_SecurityOfficer01(1) = False
#. SetFlags:
#.   Dialog:
#.     - CRE_General_HasMet2_SecurityOfficer01(1) = True
#. TagRule: !GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_SecurityOfficer01:215c1be7-9788-f33c-03d1-ac18036dd078
msgctxt "h6b8f651egb25bg48fbg9b6cg3fc5da299a77"
msgid "Vlaakith... she spoke to you. May her will guide your mission."
msgstr "블라키스께서... 직접 말을 거시다니. 여신께서 네 사명을 인도해주시길."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_SecurityOfficer01
#. Speaker = Warrior Brelal'reth
#. NodeID = 215c1be7-9788-f33c-03d1-ac18036dd078
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet2_SecurityOfficer01(1) = False
#. SetFlags:
#.   Dialog:
#.     - CRE_General_HasMet2_SecurityOfficer01(1) = True
#. TagRule: GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_SecurityOfficer01:215c1be7-9788-f33c-03d1-ac18036dd078
msgctxt "h91ad50b4g3f19g4544g97eag37d6738ccc79"
msgid "Our queen chose you... <i>Vlaakith gha'g shkath zai</i>!"
msgstr "여신께서 직접 널 선택하시다니... <i>블라키스 가그 슈카스 자이</i>!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_SecurityOfficer01
#. Speaker = Warrior Brelal'reth
#. NodeID = b027b11e-0095-4da9-9cb4-a8c47ceaa2c6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet_SecurityOfficer01(1) = False
#. SetFlags:
#.   Dialog:
#.     - CRE_General_HasMet_SecurityOfficer01(1) = True
#. TagRule: !GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_SecurityOfficer01:b027b11e-0095-4da9-9cb4-a8c47ceaa2c6
msgctxt "hec976ab3g0b00g4c76g857fg1e3ab453e12c"
msgid "The <i>kith'rak</i> let you through? Go ahead then, <i>istik</i>."
msgstr "<i>키스락</i>께서 어찌 너 같은 걸? 일단 가봐라, <i>이스틱</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_SecurityOfficer01
#. Speaker = Warrior Brelal'reth
#. NodeID = b027b11e-0095-4da9-9cb4-a8c47ceaa2c6
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet_SecurityOfficer01(1) = False
#. SetFlags:
#.   Dialog:
#.     - CRE_General_HasMet_SecurityOfficer01(1) = True
#. TagRule: GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_SecurityOfficer01:b027b11e-0095-4da9-9cb4-a8c47ceaa2c6
msgctxt "hb28eea97g02dfg4df6g9d8dg65af0b5bd0fc"
msgid ""
"The <i>ch'r'ai </i>is down these stairs, kin. I hope the news you bring is "
"welcome."
msgstr "<i>츠라이</i>께서는 아래층에 계신다. 부디 네가 좋은 소식을 가져온 거면 좋겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_SecurityOfficer01
#. Speaker = Warrior Brelal'reth
#. NodeID = e8ed2bd9-ad76-154d-a93b-e9f5fa556e39
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet_SecurityOfficer01(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_SecurityOfficer01:e8ed2bd9-ad76-154d-a93b-e9f5fa556e39
msgctxt "h9a5f46bfgdc87g4cf8g8a21gc4914d710e8d"
msgid "Speaking with the <i>ch'r'ai</i>'s is an honour. Do not squander it."
msgstr "<i>츠라이</i> 님과 대화하는 것은 크나큰 영광이다. 헛되이 하지 말도록."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_SecurityOfficer02
#. Speaker = Raider Kyrr'a'ath
#. NodeID = 257e5f13-e2f2-4d05-aae8-e68e3af84142
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet_SecurityOfficer02(1) = False
#. SetFlags:
#.   Dialog:
#.     - CRE_General_HasMet_SecurityOfficer02(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_SecurityOfficer02:257e5f13-e2f2-4d05-aae8-e68e3af84142
msgctxt "h779d85d8ga9ebg4946g9175g66436cfdf4c4"
msgid "Your presence here is tolerated. Do not confuse it for being welcome."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_SecurityOfficer02
#. Speaker = Raider Kyrr'a'ath
#. NodeID = 5da9aa29-b6f3-126d-5b82-40da2dfc439d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet2_SecurityOfficer02(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_SecurityOfficer02:5da9aa29-b6f3-126d-5b82-40da2dfc439d
msgctxt "h13550cf9g0d30g4784ga68agd8fa1ce8c6f0"
msgid "Our queen's command was clear. The weapon <i>must</i> be restored."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_SecurityOfficer02
#. Speaker = Raider Kyrr'a'ath
#. NodeID = 8548b721-d4d1-89ff-d314-d1b05075704a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet_SecurityOfficer02(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_SecurityOfficer02:8548b721-d4d1-89ff-d314-d1b05075704a
msgctxt "ha5aae860g52feg4674gabb6g586a38611d79"
msgid "I have nothing to say to you. Speak with the <i>ch'r'ai</i>, or leave."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_SecurityOfficer02
#. Speaker = Raider Kyrr'a'ath
#. NodeID = f09fc3ff-fb0c-f481-4346-5286047d733a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet2_SecurityOfficer02(1) = False
#. SetFlags:
#.   Dialog:
#.     - CRE_General_HasMet2_SecurityOfficer02(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_SecurityOfficer02:f09fc3ff-fb0c-f481-4346-5286047d733a
msgctxt "h5e85f102g6deeg4b85g9d7fge02119d30bd1"
msgid ""
"Vlaakith choosing you... If that is her decision, it is the right one. "
"<i>Vlaakith gha'g shkath zai!</i>\n"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_StatuePuzzle_AD_East
