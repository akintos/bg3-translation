msgctxt "h21f66190g520ag4b79gb283ge6a1e14ef484"
msgid "*Bellow.*"
msgstr "*음머.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DeepRothe
#. Speaker = Deep Rothé
#. NodeID = 8362fc68-c527-6ab9-3371-cca0583bc36d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_MyconidCircle_DeepRothe_HasMet_SpeakWithAnimals(1) = True
#.   Global:
#.      - UND_MushroomHunter_State_InVillage = False
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DeepRothe:8362fc68-c527-6ab9-3371-cca0583bc36d
msgctxt "hcc957d0ageefdg4911gbd3ag716f3441c1bd"
msgid "Waiting for master. Miss his scratches. Can't leave without him."
msgstr "주인을 기다리고 있다. 그의 쓰다듬기가 그립다. 그를 떠날 수는 없다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DeepRothe
#. Speaker = Deep Rothé
#. NodeID = 886134d0-789f-faa7-11b8-d9d7cb1b4472
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_MyconidCircle_DeepRothe_HasMet_SpeakWithAnimals(1) = False
#.   Global:
#.      - UND_MushroomHunter_State_InVillage = False
#.   Tag:
#.      - PETPAL(1) = True
#. SetFlags:
#.   Dialog:
#.     - UND_MyconidCircle_DeepRothe_HasMet_SpeakWithAnimals(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DeepRothe:886134d0-789f-faa7-11b8-d9d7cb1b4472
msgctxt "h54fc28b6g388ag4b76g90beg9d299e6222d0"
msgid "Want master back. He treats me good now. Doesn't kick me anymore."
msgstr "주인이 돌아왔으면 좋겠다. 이제 날 잘 대해 주는데. 날 더 이상 발로 차지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DeepRothe
#. Speaker = Deep Rothé
#. NodeID = b1a05c14-f9b7-7e65-be06-0f3dba426bdd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_MyconidCircle_DeepRothe_BaelenAteShroom_Hasmet(1) = True
#.   Global:
#.      - UND_MushroomHunter_Event_AteMushroom = True
#.      - UND_MushroomHunter_State_InVillage = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DeepRothe:b1a05c14-f9b7-7e65-be06-0f3dba426bdd
msgctxt "h59ba0b19g8f2cg4c3egb58fga556fbdc53fa"
msgid "Hope master doesn't start kicking me again."
msgstr "주인이 또 나를 발로 차지 않았으면 좋겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DeepRothe
#. Speaker = Deep Rothé
#. NodeID = ec4d5658-c30e-5461-4873-2ea69945508c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_MyconidCircle_DeepRothe_BaeleReturned_Hasmet(1) = False
#.   Global:
#.      - UND_MushroomHunter_Event_AteMushroom = False
#.      - UND_MushroomHunter_State_InVillage = True
#.   Tag:
#.      - PETPAL(1) = True
#. SetFlags:
#.   Dialog:
#.     - UND_MyconidCircle_DeepRothe_BaeleReturned_Hasmet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DeepRothe:ec4d5658-c30e-5461-4873-2ea69945508c
msgctxt "hab646f60gd496g4da3gaf09g37a03dc6df50"
msgid "Master is back. Good. Missed him."
msgstr "주인이 돌아왔네. 좋군. 그리웠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DirectToSovereign
#. Speaker = Narrator
#. NodeID = 1b61543f-c4fe-c5d9-ff35-277c3b59ddb1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DirectToSovereign:1b61543f-c4fe-c5d9-ff35-277c3b59ddb1
msgctxt "ha0794804gdfbbg4206g8bf0g9f927f364112"
msgid "*A voice drifts into your mind as you gaze upon the misshapen servant.*"
msgstr "*기형적인 종복을 바라보는 당신의 마음속에 어떤 목소리가 울립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DirectToSovereign
#. Speaker = Narrator
#. NodeID = b5e939b0-9d17-4a6e-c52b-aec7a0061c92
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_MyconidCircle_DirectToSovereign_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - UND_MyconidCircle_DirectToSovereign_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DirectToSovereign:b5e939b0-9d17-4a6e-c52b-aec7a0061c92
msgctxt "he09e6b9ag28a6g4c48ga9f4g7c4a70f38aed"
msgid "*Fungus and mould glaze the grotesque creature's face and body.*"
msgstr "*진균과 곰팡이가 괴생명체의 얼굴과 몸에 발려 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DirectToSovereign
#. Speaker = Sovereign Spaw
#. NodeID = d6609c1e-89d3-281e-8c76-2bc61f8220ad
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_MyconidCircle_DirectToSovereign_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DirectToSovereign:d6609c1e-89d3-281e-8c76-2bc61f8220ad
msgctxt "hcb2bc5a1gd01ag49e6g9c0fg816779081f80"
msgid "((*seek me. seek the Sovereign*))"
msgstr "((*날 찾아라. 군주를 찾아라*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DirectToSovereign
#. Speaker = Sovereign Spaw
#. NodeID = f178797a-2979-0de0-e6a0-305921084341
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DirectToSovereign:f178797a-2979-0de0-e6a0-305921084341
msgctxt "ha72f7a0ag67c5g4db3gbb78g9172310c0de1"
msgid "((*leave this one. come to me. we must speak*))"
msgstr "((*이 자는 놔둬라. 내게 오거라. 우리는 대화해야 한다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DirectToSovereign_HookHorror
#. Speaker = Narrator
#. NodeID = 6750ba93-fb60-44e5-99f8-db9e90fed5e7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_MyconidCircle_DirectToSovereign_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - UND_MyconidCircle_DirectToSovereign_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DirectToSovereign_HookHorror:6750ba93-fb60-44e5-99f8-db9e90fed5e7
msgctxt "hd9282ef9g2265g4e46ga9b2g00812e82492c"
msgid ""
"*The monstrosity stares blankly. The voice that echoes within you belongs "
"not to it, but the sovereign.*"
msgstr "*괴물이 멍하니 바라봅니다. 당신 안에서 울려 퍼지는 목소리는 그 괴물이 아니라 군주의 목소리입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DirectToSovereign_HookHorror
#. Speaker = Sovereign Spaw
#. NodeID = b15f0c8f-c455-4059-ad2e-afb452212bc7
