#.      - WLD_PriestsOfTheConqueringGod_HasAmulet(2) = False
#.   Tag:
#.      - BRANDED(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:e28ff8ea-6ff7-095f-8dd2-a088a001ef8d
msgctxt "ha03a8cc8g887fg470eg8db1ge557b764d9e6"
msgid "We're allies - I have the Absolute's brand. Leave the gnome to me."
msgstr "우린 같은 편이야. 절대자의 낙인을 가지고 있지. 그놈은 나한테 맡겨."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = e2d3c4ca-2a19-d3dc-5934-7f5e82f93a69
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_UnfortunateGnome_State_Still = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:e2d3c4ca-2a19-d3dc-5934-7f5e82f93a69
msgctxt "hb6013d43g66d1g47f3gb992g0d54f7ae8525"
msgid "K-keep him spinning! Make that birdie chirp!"
msgstr "저, 저놈 계속 돌려! 저 새가 지저귀게 하란 말이야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = e2e769d8-2ff9-14c5-34d2-b0f49e400ab7
