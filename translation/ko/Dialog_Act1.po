#. Speaker = Tracker Dullwill
#. NodeID = 2ced752e-6127-3827-815a-e8aeade5b52b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinSleeper_01:2ced752e-6127-3827-815a-e8aeade5b52b
msgctxt "h85cc9a2ag5ed8g4053gb921g86ce9d2b7c36"
msgid "Whatever you say, boss."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinSleeper_01
#. Speaker = Narrator
#. NodeID = 33313c92-3847-e512-e46b-b36e915ea092
