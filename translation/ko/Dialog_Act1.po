msgctxt "h5d9431eeg1e32g48e9g815bg70254e7a2ed8"
msgid "*You peer through the telescope.*"
msgstr "*당신은 망원경을 통해 봅니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing_Telescope
#. Speaker = Narrator
#. NodeID = d2800954-db0a-9f19-85fe-b0c0be2a138d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Stargazing_Event_SawDragon = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing_Telescope:d2800954-db0a-9f19-85fe-b0c0be2a138d
msgctxt "h296b5847gc600g4b90gb34bg35e027cc2327"
msgid "*You see a dragon circling like a bird of prey. Hunting.*"
msgstr "*당신은 맹금류처럼 선회하며 사냥 중인 드래곤을 발견합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing_Telescope
#. Speaker = Player
#. NodeID = e49ff88c-5e67-9aa2-9fcd-950265ae8846
