msgctxt "h8e7493a9gc079g4d1ag8e7eg978077cf91c5"
msgid "<i>Rat.</i>"
msgstr "<i>쥐새끼가.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene
#. Speaker = Damays
#. NodeID = e4e3299d-4bdc-6083-2ccb-3d368ca40522
#. HandlePath = TaggedText[0].TagText[0]
