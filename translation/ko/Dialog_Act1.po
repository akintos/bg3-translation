msgctxt "h8435aae9g5ddbg4142ga861g2c54ed848dc9"
msgid "Barrelstalks. Annoy the myconids and they'll cover you with poison."
msgstr "통줄기잖아. 마이코니드를 거슬리게 하면 널 독으로 뒤덮어 버릴 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PAD_BarrelstalkInteraction
#. Speaker = Player
#. NodeID = a319cca9-ccf6-c736-a43c-040d1c333c8c
