msgctxt "h39bd051ag5610g4ae7ga540g10aac8535157"
msgid "Another. A mere hatchling could do finer work."
msgstr "또 있군. 갓 부화한 새끼가 만들어도 이거보단 낫겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Forest_VB_Trap
#. Speaker = Player
#. NodeID = 021bcac7-3dca-28ab-1f9e-24f45962f47e
