msgctxt "h3b57cf4cgc403g4c6ag9cb2gb79151776c60"
msgid "Fuck <i>yes. That felt </i>amazing<i>.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PaladinsOfTyr_AvatarKarlachAfterEnrage
#. Speaker = Karlach
#. NodeID = edfd0052-8335-6e07-dad3-6b016fd4af65
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PaladinsOfTyr_AvatarKarlachAfterEnrage:edfd0052-8335-6e07-dad3-6b016fd4af65
msgctxt "h1da96c66g855ag4990g8e09gaae36a9a23db"
msgid "<i>Deep breaths. I'll be all right. I'll be all right.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PaladinsOfTyr_AvatarKarlachAfterEnrage
#. Speaker = Player
#. NodeID = ef01fd28-31ff-6311-38c2-9b079ce2ea69
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PaladinsOfTyr_AvatarKarlachAfterEnrage:ef01fd28-31ff-6311-38c2-9b079ce2ea69
msgctxt "h0848bba4g7523g4382g88edg594f1b18aefe"
msgid "I'm hot. Very hot. Too hot."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PaladinsOfTyr_AvatarKarlachAfterEnrage
#. Speaker = Karlach
#. NodeID = fbfb55e8-ff2b-fb1a-7bd7-59c0e64a3e4d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PaladinsOfTyr_AvatarKarlachAfterEnrage:fbfb55e8-ff2b-fb1a-7bd7-59c0e64a3e4d
msgctxt "h96941ce0gd3dbg426bga3d5g603b851f49e2"
msgid ""
"<i>Bloody engine isn't cooling down, is it. Guess it wasn't made to work "
"outside Avernus. Hope it holds together long enough to find an infernal "
"mechanic.</i>"
msgstr ""
"<i>빌어먹을 엔진이 식지도 않네, 정말이지. 아베르누스 밖에서는 작동하도록 만들어진 게 아니었나 보네. 지옥의 기계공을 찾을 수 있을 "
"때까지만 버틸 수 있기를.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PaladinsOfTyr_AvatarKarlachBeforeEnrage
#. Speaker = Karlach
#. NodeID = 07935cf3-67c3-7282-e829-dfc515a009d2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PaladinsOfTyr_AvatarKarlachBeforeEnrage:07935cf3-67c3-7282-e829-dfc515a009d2
msgctxt "h9305aa98g5eecg4bafgb6bcg8c1ef0775313"
msgid ""
"<i>I hope you're watching, Zariel. I hope you see how free I am. And I hope "
"you know I'm never, EVER, EVER GOING BACK!</i>"
msgstr ""
"<i>자리엘, 네년이 이걸 보면 좋겠군. 내가 얼마나 자유로운지를 보라고. 그리고 내가 절대, <b>다시는, 다시는 안 돌아간다는 것도 "
"말이야!</b></i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PaladinsOfTyr_AvatarKarlachBeforeEnrage
#. Speaker = Player
#. NodeID = 1e208122-c4c4-6c20-fbcd-5f28f1bc97dd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PaladinsOfTyr_AvatarKarlachBeforeEnrage:1e208122-c4c4-6c20-fbcd-5f28f1bc97dd
msgctxt "hc89b15eeg5dc3g44b4ga422g59bf90b68bbc"
msgid "Easy, girl. There's no point now - you already killed them all."
msgstr "진정하자. 그래 봤자 아무 의미도 없어. 벌써 그놈들을 다 죽였잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PaladinsOfTyr_AvatarKarlachBeforeEnrage
#. Speaker = Player
#. NodeID = 24480827-5fdd-fb95-53d0-08b71504203e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PaladinsOfTyr_AvatarKarlachBeforeEnrage:24480827-5fdd-fb95-53d0-08b71504203e
msgctxt "h8fb13943g9997g4016g94d2gba08126562da"
msgid "TEAR IT DOWN!"
msgstr "<b>다 찢어버리겠다!</b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PaladinsOfTyr_AvatarKarlachBeforeEnrage
#. Speaker = Player
#. NodeID = 36305fda-fb74-0cd0-23b1-89cccf410fc1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PaladinsOfTyr_AvatarKarlachBeforeEnrage:36305fda-fb74-0cd0-23b1-89cccf410fc1
msgctxt "h7165b82dg2babg4620gb5adg98864822afc0"
msgid "I'm hot. <i>Really </i>hot. Is this safe?"
msgstr "뜨거워. <i>정말로</i> 뜨거워. 괜찮을까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PaladinsOfTyr_AvatarKarlachBeforeEnrage
#. Speaker = Karlach
#. NodeID = 52802db2-5260-c534-4b98-5d824da8379f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PaladinsOfTyr_AvatarKarlachBeforeEnrage:52802db2-5260-c534-4b98-5d824da8379f
msgctxt "hab55cb6dge95ag4768gb938gcd5860ac4d18"
msgid ""
"<i>But wouldn't it do to send a message? Wouldn't it be oh-so-fucking "
"fantastic to leave nothing behind at all?!</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PaladinsOfTyr_AvatarKarlachBeforeEnrage
#. Speaker = Karlach
#. NodeID = aeab1ab4-36f4-5038-99d5-b178b4d7b1f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PaladinsOfTyr_AvatarKarlachBeforeEnrage:aeab1ab4-36f4-5038-99d5-b178b4d7b1f5
msgctxt "h64facd01g35d9g428aga676g85503311def2"
msgid "<i>I'm gonna destroy this place. Rip it apart, board by board.</i>"
msgstr "<i>여길 다 부숴 버릴 거야. 판자란 판자는 다 가루로 만들 거야.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PaladinsOfTyr_AvatarKarlachBeforeEnrage
#. Speaker = Karlach
#. NodeID = be037056-d491-b794-f1c3-6ac6cc5cc1e3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PaladinsOfTyr_AvatarKarlachBeforeEnrage:be037056-d491-b794-f1c3-6ac6cc5cc1e3
msgctxt "h6b831c56g502ag4c70g9611g2080bd981a98"
msgid ""
"<i>Probably not. Nothing's safe - never will be. But I can feel the fire in "
"every vein, and I'm not gonna let it go to waste.</i>"
msgstr ""
"<i>분명 아니겠지. 괜찮을 리가. 절대 그럴 리 없어. 하지만 온 혈관에 흐르는 화염이 느껴지는데, 이걸 낭비할 수는 없지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PaladinsOfTyr_AvatarKarlachBeforeEnrage
#. Speaker = Karlach
