msgctxt "h8a8605deg2a5ag448eg949dg0a03d8ede1a9"
msgid "Ugh - it won't budge!"
msgstr "윽, 꿈쩍도 안 해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_TooHeavy
#. Speaker = Player
#. NodeID = 0d827d21-3768-470b-acc8-0f0c96122cc1
