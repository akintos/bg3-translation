msgctxt "h81128fd1g161bg4377g9bc9g35bbb9721f3b"
msgid "This ruin's dedicated to Selûne. Vile moon witch..."
msgstr "이 폐허는 셀루네에게 바쳐졌어. 불쾌한 달 마녀 같으니..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/VBs/GOB_ShadowHeart_VB_Temple
#. Speaker = Shadowheart
#. NodeID = d462917c-c5e9-1ad7-e14a-7fa57db318be
