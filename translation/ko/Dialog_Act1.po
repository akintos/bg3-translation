#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = 00f602b9-b844-b99f-1d56-1476580499bd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_MoonriseBriefing = False
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Quest_MeetAgainInCamp = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:00f602b9-b844-b99f-1d56-1476580499bd
msgctxt "hcd87be6dg0727g4cd2gb2b4g7b8d60c9bd7a"
msgid ""
"Rest. Heal. Celebrate if you wish. Mourn if you must. Come morning, we shall "
"discuss delivering you from your parasite."
msgstr ""
"휴식하고, 치유를 하게. 원한다면 축하하거나 애도해도 좋고. 아침이 다가오면, 그대를 기생충으로부터 구제할 방법에 대해 논의하도록 하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = 01a89f0c-b88e-d5ed-7dec-69a56e85dcfc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:01a89f0c-b88e-d5ed-7dec-69a56e85dcfc
msgctxt "h490c3b23gaee7g4425g89e9g75a9addaad6f"
msgid ""
"You will stay, as a novice anew. You have forgotten the ways of the druids, "
"the natural order of things."
msgstr "머무르는 것은 허락하겠지만, 수습생으로서 새로 시작하거라. 너는 드루이드의 길을 잊어버리고, 자연의 질서를 저버렸다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Player
#. NodeID = 025f7c3f-b745-1d86-0d6d-141276160889
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_KaghasFate = True
#.   Local:
#.      - 524b40c2-5360-04a8-41d8-665501008a2a_ThoguhtsOnGrove = False
#. SetFlags:
#.   Local:
#.     - 524b40c2-5360-04a8-41d8-665501008a2a_ThoguhtsOnGrove = True
#. TagRule: DRUID
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:025f7c3f-b745-1d86-0d6d-141276160889
msgctxt "h925235afg1d86g446fga3d5g9269271eb7d7"
msgid "The grove is nature's beating heart - I was glad to help save it."
msgstr "이 숲은 자연의 맥동하는 심장이죠. 제가 숲을 도울 수 있어 기뻤습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Player
#. NodeID = 025f7c3f-b745-1d86-0d6d-141276160889
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_KaghasFate = True
#.   Local:
#.      - 524b40c2-5360-04a8-41d8-665501008a2a_ThoguhtsOnGrove = False
#. SetFlags:
#.   Local:
#.     - 524b40c2-5360-04a8-41d8-665501008a2a_ThoguhtsOnGrove = True
#. TagRule: REALLY_TIEFLING
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:025f7c3f-b745-1d86-0d6d-141276160889
msgctxt "ha78e3b1fga07cg4c33g8e73g65886eb9d3ca"
msgid "I acted to save my kin, not this place."
msgstr "내 동족을 구하기 위해서였어요, 이곳이 아니라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Player
#. NodeID = 025f7c3f-b745-1d86-0d6d-141276160889
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_KaghasFate = True
#.   Local:
#.      - 524b40c2-5360-04a8-41d8-665501008a2a_ThoguhtsOnGrove = False
#. SetFlags:
#.   Local:
#.     - 524b40c2-5360-04a8-41d8-665501008a2a_ThoguhtsOnGrove = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:025f7c3f-b745-1d86-0d6d-141276160889
msgctxt "h19bba152g49d0g4e81g9209g1d13aec13fec"
msgid "I hope this grove of yours is worth the bloodshed."
msgstr "당신의 숲이 그 모든 피를 흘릴 가치가 있었으면 좋겠군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = 02c72440-6bb7-9c33-4bc9-473d17f8e237
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:02c72440-6bb7-9c33-4bc9-473d17f8e237
msgctxt "h9094eb4dg2216g4597g9dfdg46d88222a5b3"
msgid "How is this possible...?"
msgstr "어떻게 이런 일이...?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = 03053b45-060a-69ed-32b4-5b027d2e1aaa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_WolfPens_State_HalsinIntroHappened = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:03053b45-060a-69ed-32b4-5b027d2e1aaa
msgctxt "h09753e6cg5bebg4223g839cg633bbb884c21"
msgid ""
"The grove stands. Nature prevails. I owe you my thanks - and an introduction."
msgstr "숲은 버텨냈고. 자연이 승리했네. 그대에게 빚을 졌군. 내 소개를 하겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = 053a2a44-7747-9af2-81d7-7f97b42ca738
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:053a2a44-7747-9af2-81d7-7f97b42ca738
msgctxt "h596916d5g4bb9g4b83g85bcgdb10b88e15b8"
msgid ""
"Misplaced, self-important concern. She must learn to respect the balance of "
"all things. But the grove still needs her."
msgstr "잘못된, 자기중심적 걱정이었소. 그녀는 만물의 조화를 존중하는 법을 배워야 하오. 하지만 숲에는 여전히 그녀가 필요하오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Kagha
#. NodeID = 08706f45-4c37-299b-bbd6-7ac127769fdd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:08706f45-4c37-299b-bbd6-7ac127769fdd
msgctxt "h70ccac42g7092g4cdcg90e1g7acb7335e20c"
msgid "So as you say, and so it is done, Master."
msgstr "말씀하신 대로 하겠습니다, 마스터."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = 09a5d1fb-dc6a-44f9-0562-7535def126ee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:09a5d1fb-dc6a-44f9-0562-7535def126ee
msgctxt "h6ea0ce0bg3d0dg4b85ga806g06174abdc5f4"
msgid ""
"Well done? No... this shouldn't have been necessary in the first place. I "
"failed."
msgstr "잘했다고? 아니... 애초에 이런 일이 없었어야 했소. 내 실책이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = 0b0a16a5-9c22-49cf-65c5-d84809a131f5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_HalsinReturns_Event_SeekRath = False
#.      - DEN_ShadowDruid_State_RathIsPermaDefeated = False
#. SetFlags:
#.   Global:
#.     - DEN_HalsinReturns_Event_SeekRath = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:0b0a16a5-9c22-49cf-65c5-d84809a131f5
msgctxt "h36a1d508g8e0dg4efegabd4g24ba0f4f5f8e"
msgid ""
"As for what you've done for the grove, speak to Rath. He will see to your "
"reward."
msgstr "그대가 숲을 위해 해준 일에 대해선, 라스에게 이야기해 보시오. 그가 그대에게 보상을 줄 것이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Player
#. NodeID = 0badb58b-b48e-e7f6-26b3-a21f5fe58476
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_Knows_RecruitmentLetter = False
#.   Tag:
#.      - DRUID(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:0badb58b-b48e-e7f6-26b3-a21f5fe58476
msgctxt "hec39f880gce99g49c2g9506ge1ada4b9f323"
msgid "Is such mercy wise? She's strayed from your teachings once already."
msgstr "그런 자비가 현명한 일일까요? 그녀는 이미 당신의 가르침을 한번 저버렸잖아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Kagha
#. NodeID = 0cfbbba0-09b0-da09-8d33-e017b4f48f5b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:0cfbbba0-09b0-da09-8d33-e017b4f48f5b
msgctxt "h9150b2a1gaf51g4667gb0d0g5a68ea00b933"
msgid "<i>As you wish</i>, Master Halsin."
msgstr "<i>이르신</i> 대로 따르지요, 마스터 할신."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = 0e7531ce-db1a-7e3c-ebfd-9bb2178d0db6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:0e7531ce-db1a-7e3c-ebfd-9bb2178d0db6
msgctxt "h1e41a19agcb49g43dbgbd2fg5bb32fa0bac8"
msgid ""
"I'm sorry to say, I can't undo that magic. I can't cure you. But that "
"doesn't mean I can't help."
msgstr "미안하지만, 난 그 마법을 없앨 수 없소. 난 당신을 치료할 수 없어. 하지만 그렇다고 아무 도움도 줄 수 없다는 뜻은 아니오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Player
#. NodeID = 0fed3980-55b3-6441-49b3-e7c3beb98466
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = False
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = False
#.      - DEN_ShadowDruid_State_KaghaKilled = False
#.   Local:
#.      - 524b40c2-5360-04a8-41d8-665501008a2a_ThoguhtsOnGrove = False
#. SetFlags:
#.   Local:
#.     - 524b40c2-5360-04a8-41d8-665501008a2a_ThoguhtsOnGrove = True
#. TagRule: DRUID
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:0fed3980-55b3-6441-49b3-e7c3beb98466
msgctxt "h7f04f07ag7cfdg477dg97b3gb13d2d1c53b0"
msgid "The grove is nature's beating heart - I was glad to help save it."
msgstr "이 숲은 자연의 맥동하는 심장이죠. 제가 숲을 도울 수 있어 기뻤습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Player
#. NodeID = 0fed3980-55b3-6441-49b3-e7c3beb98466
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = False
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = False
#.      - DEN_ShadowDruid_State_KaghaKilled = False
#.   Local:
#.      - 524b40c2-5360-04a8-41d8-665501008a2a_ThoguhtsOnGrove = False
#. SetFlags:
#.   Local:
#.     - 524b40c2-5360-04a8-41d8-665501008a2a_ThoguhtsOnGrove = True
#. TagRule: REALLY_TIEFLING
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:0fed3980-55b3-6441-49b3-e7c3beb98466
msgctxt "hc66643f2g1c39g4aa5ga790g4ad2edfdf3c3"
msgid "I acted to save my kin, not this place."
msgstr "내 동족을 구하기 위해서였어요, 이곳이 아니라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Player
#. NodeID = 0fed3980-55b3-6441-49b3-e7c3beb98466
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = False
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = False
#.      - DEN_ShadowDruid_State_KaghaKilled = False
#.   Local:
#.      - 524b40c2-5360-04a8-41d8-665501008a2a_ThoguhtsOnGrove = False
#. SetFlags:
#.   Local:
#.     - 524b40c2-5360-04a8-41d8-665501008a2a_ThoguhtsOnGrove = True
#. TagRule: REALLY_LOLTHDROWELF
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:0fed3980-55b3-6441-49b3-e7c3beb98466
msgctxt "h7f923375gda43g4c29g965ag642b7e4417bb"
msgid "I did as I wished to. I never cared if this place was saved or not."
msgstr "내가 원하는 일을 한 거예요. 이 장소를 구하는 일에는 전혀 신경 쓴 적이 없죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Player
#. NodeID = 0fed3980-55b3-6441-49b3-e7c3beb98466
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = False
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = False
#.      - DEN_ShadowDruid_State_KaghaKilled = False
#.   Local:
#.      - 524b40c2-5360-04a8-41d8-665501008a2a_ThoguhtsOnGrove = False
#. SetFlags:
#.   Local:
#.     - 524b40c2-5360-04a8-41d8-665501008a2a_ThoguhtsOnGrove = True
#. TagRule: REALLY_PLANAR
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:0fed3980-55b3-6441-49b3-e7c3beb98466
msgctxt "he0749acdgf4e2g429cga1f7geceedac9be93"
msgid ""
"This place means nothing to me, but a great deal to you, it seems. I hope "
"the blood price was worth it."
msgstr "이 장소는 내게 아무런 의미도 없지만, 당신에겐 큰 의미가 있는 것 같군요. 흐른 피가 그럴 만한 가치가 있었길 바라죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Player
#. NodeID = 0fed3980-55b3-6441-49b3-e7c3beb98466
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = False
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = False
#.      - DEN_ShadowDruid_State_KaghaKilled = False
#.   Local:
#.      - 524b40c2-5360-04a8-41d8-665501008a2a_ThoguhtsOnGrove = False
#. SetFlags:
#.   Local:
#.     - 524b40c2-5360-04a8-41d8-665501008a2a_ThoguhtsOnGrove = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:0fed3980-55b3-6441-49b3-e7c3beb98466
msgctxt "h3f17ec81g8f70g4770g9c76gbd3e7f1e2aeb"
msgid "I hope this grove of yours was worth the bloodshed."
msgstr "당신의 숲이 그 모든 피를 흘릴 가치가 있었다면 좋겠군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Player
#. NodeID = 10c06445-ca4f-7fe2-540d-e41efb69207a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_WhatsNext = False
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Knows_WhatsNext = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:10c06445-ca4f-7fe2-540d-e41efb69207a
msgctxt "h10055f15g5ee7g40b5ga481g5e3dba291bbb"
msgid "What happens next?"
msgstr "이젠 어떻게 될까요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Player
#. NodeID = 16c60d36-d105-d629-12a6-b0470792484a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_ShadowDruid_SnakesCourt_SawKidDie = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:16c60d36-d105-d629-12a6-b0470792484a
msgctxt "h293f1de2g34c0g4aabga3d2g13b9816fb045"
msgid "A child died because of her? She deserved far worse than that."
msgstr "아이를 죽게 만들었다고? 더 심한 꼴을 당해도 싸군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = 17170f16-d5cf-6081-7968-f646cafd3c36
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:17170f16-d5cf-6081-7968-f646cafd3c36
msgctxt "h64c9948aga5e9g4404g9d67g642455d7fbf4"
msgid "Perhaps... but I wouldn't want to place all my faith in blind luck."
msgstr "그럴지도... 하지만 맹목적인 운에 모든 믿음을 걸고 싶지는 않다네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = 184cfe99-7b21-1523-f4b7-0e760acb97d4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GuardedEntrance_State_BothParentsDead = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:184cfe99-7b21-1523-f4b7-0e760acb97d4
msgctxt "h8b17d67bg0487g4bc1gb33agd28da65b89c0"
msgid ""
"Nature will determine your fate - whatever happens to you next, know that it "
"is the Oak Father's will."
msgstr "자연이 네 운명을 결정할 것이다. 다음에 무슨 일이 일어나든, 그것이 참나무 아버지의 의지라는 것을 알아두거라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = 1904060c-5d6c-2308-5074-99c68d5d1cbb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:1904060c-5d6c-2308-5074-99c68d5d1cbb
msgctxt "h25dececcg8867g40b6gbe09gf382bc5af192"
msgid "You show no pity, no remorse. I cannot absolve you."
msgstr "어떤 연민도, 회한도 내비치지 않는군. 널 용서할 수는 없다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = 1c44b016-4ee9-397a-1689-af80b83baed2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:1c44b016-4ee9-397a-1689-af80b83baed2
msgctxt "h54e6da66g5272g4daeg8acdg7a1ba754400d"
msgid ""
"It would have been easier if you just died, Kagha. Now I have to hear your "
"excuses instead."
msgstr "네가 그냥 죽었다면 일이 더 쉬워졌을 것이다, 카그하. 이렇게 된 이상 나는 너의 변명을 들어봐야겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = 1cc86c14-c4de-8baa-fdc5-cfa14a53bdc6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:1cc86c14-c4de-8baa-fdc5-cfa14a53bdc6
msgctxt "h94975044g3960g4362gb48dg3610387fa47b"
msgid "Grace is bestowed by nature, not me."
msgstr "자비는 자연이 내려주는 것이다, 내가 아니라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Player
#. NodeID = 1dfe5c88-5e5e-7e49-f789-4dc6464f2053
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:1dfe5c88-5e5e-7e49-f789-4dc6464f2053
msgctxt "h2284462eg6220g431ag925fg943e0bb778d9"
msgid "Are you mad? Kagha's a traitor."
msgstr "미쳤어요? 카그하는 배신자예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Player
#. NodeID = 2037c379-c4ad-9a39-1239-c5f9f51ad013
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_ShadowDruid_SnakesCourt_SawKidDie = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:2037c379-c4ad-9a39-1239-c5f9f51ad013
msgctxt "h66ae5dfcg366cg4c74g87aag70149d5ace98"
msgid "You overreacted. The child's death was an accident."
msgstr "과민반응을 하는군요. 그 아이의 죽음은 그저 사고였을 뿐이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Kagha
#. NodeID = 302d2b6c-1f97-785f-78b6-8e091a441ff4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:302d2b6c-1f97-785f-78b6-8e091a441ff4
msgctxt "hf6a720adg6c50g4484gbe6fg1e4b2cb12cd9"
msgid ""
"I owe you <i>nothing</i>. Goblins swarmed us like roaches while you stumbled "
"after the past."
msgstr ""
"당신에게 빚진 것은 <i>아무것도</i> 없습니다. 고블린들이 바퀴벌레처럼 저희를 덮쳐오는데, 당신은 과거를 쫓다 발을 헛디디셨죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = 30767cb1-1259-c8fa-b035-af32f68537e0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:30767cb1-1259-c8fa-b035-af32f68537e0
msgctxt "hed15e0f3g056cg452eg9cebg0f5a1b4ffdc7"
msgid ""
"There is no <i>we</i>. You were the driving force behind this madness. Now "
"it stops."
msgstr "<i>우리</i>는 없다. 이 광기를 몰아가고 있는 것은 너였어. 이제 멈춰야 할 때다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Player
#. NodeID = 309d2883-e622-fa1f-fc02-4c2de7680dab
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Event_RevealedNautiloidEscape = False
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Event_RevealedNautiloidEscape = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:309d2883-e622-fa1f-fc02-4c2de7680dab
msgctxt "hda7b20a9g3b51g4508ga569gf7739f35e051"
msgid ""
"I escaped from an illithid ship after being infected. Maybe the process was "
"interrupted."
msgstr "감염되고 나서 일리시드 함선에서 탈출했어요. 변이 과정에 방해가 있었을지도 모르죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = 36248be6-5d50-6ccc-8f0a-531d328bfcb8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:36248be6-5d50-6ccc-8f0a-531d328bfcb8
msgctxt "h9dd22d36g8ff8g4dbdga5b0g871d4e994bbe"
msgid ""
"I will allow you to stay. But consider yourself a novice anew. You have "
"forgotten the ways of the druids - our place in the natural order."
msgstr ""
"머무르는 것은 허용해 주겠다. 하지만 이제부터는 새로 시작한다고 생각하거라. 넌 드루이드의 방식을 저버렸다 - 우리는 자연의 질서를 "
"따라야 한다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = 37141eaa-2ed5-687c-aec5-752383afa1f6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:37141eaa-2ed5-687c-aec5-752383afa1f6
msgctxt "hb1ea6cccgf71fg44abgb9ffg045a89690c16"
msgid ""
"She knows now what cavorting in the shadows brings her. She will not stray "
"again. Besides, this is no time to lose a promising druid."
msgstr ""
"이제 그녀도 그림자 속을 돌아다니는 것이 어떤 대가를 불러오는지 깨달았을 것이오. 이제 더는 엇나가지 않겠지. 게다가, 지금은 장래가 "
"유망한 드루이드를 내칠 때가 아니오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Player
#. NodeID = 401894e1-bf95-cbd0-3c26-141e250fcdcd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Event_AskedForHelp = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:401894e1-bf95-cbd0-3c26-141e250fcdcd
msgctxt "h5e5c98ddga8d0g4bf0ga29dge48814a63586"
msgid ""
"Yes. I have a mind flayer parasite inside my head. I want your help removing "
"it."
msgstr "맞아요. 제 머릿속에는 마인드 플레이어 기생충이 있습니다. 그것을 제거하는 데 당신의 도움을 받고 싶습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Player
#. NodeID = 438500d6-3177-df9e-19ab-036b245a56da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:438500d6-3177-df9e-19ab-036b245a56da
msgctxt "h35652cbfg5a29g4401g8a2bgd8f39f9d5c37"
msgid "You're welcome. What now?"
msgstr "천만에요. 이제 어쩌죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = 4630ac4f-62b9-c1dc-8f6b-d0a68d006cd6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:4630ac4f-62b9-c1dc-8f6b-d0a68d006cd6
msgctxt "hf0bae708gd7a3g4920g8a78g114ae52bd36d"
msgid ""
"I was going to show leniency, but Kagha... a child is <i>dead </i>because of "
"you."
msgstr "네게 관대함을 보여주려 했다. 하지만 카그하... 너의 책임으로 아이가 <i>죽었다</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Kagha
#. NodeID = 4b0d6acb-ddb1-1aeb-0197-39aa4e6bca45
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:4b0d6acb-ddb1-1aeb-0197-39aa4e6bca45
msgctxt "h684f5f3fg1662g4961g90eag89faacbe4da3"
msgid "An error most grave, Master. I beg your grace."
msgstr "심각한 착오였습니다, 마스터. 자비를 부탁드립니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = 4ed49b2b-3a2a-41f0-78a2-d9a7e78dc5c5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:4ed49b2b-3a2a-41f0-78a2-d9a7e78dc5c5
msgctxt "h54ad3012g0c99g45dbgaef1g64a707dc1030"
msgid ""
"A dreadful misdeed - one she will never live down. But the grove still needs "
"her passion."
msgstr "그녀는 무시무시한 악행을 후회하며 살 것이네. 하지만 숲에는 여전히 그녀의 열정이 필요해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Player
#. NodeID = 4fe029cb-df29-f214-13d0-8c6ae737ff54
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:4fe029cb-df29-f214-13d0-8c6ae737ff54
msgctxt "hce26d27ag5511g4b30g846cg999b610da323"
msgid "No need to be so harsh. Kagha acted out of concern."
msgstr "너무 가혹하게 굴지 마세요. 카그하는 그저 걱정하는 마음에 벌인 일일 뿐입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Player
#. NodeID = 50cce341-201b-dfa2-4385-0510753a3df7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_TIEFLING(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:50cce341-201b-dfa2-4385-0510753a3df7
msgctxt "h59e9828fg71cag419fg9cddg31325faafa72"
msgid ""
"You were too lenient. There's bad blood between tieflings and druids because "
"of her."
msgstr "너무 관대하시군요. 그녀 때문에 티플링과 드루이드 사이에 앙금이 생겼어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Player
#. NodeID = 5535a351-b5fb-2738-4c99-6070cd8922fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:5535a351-b5fb-2738-4c99-6070cd8922fd
msgctxt "h1b70a960gf99eg4d57gb2b3g46e231dfd126"
msgid "Kagha had that coming to her. Well done."
msgstr "카그하 본인이 자초한 일입니다. 잘하셨어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = 59d0dd44-2f48-f242-9686-b45836eb95b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:59d0dd44-2f48-f242-9686-b45836eb95b1
msgctxt "hfb895d11gb533g47c6gb845gba5a36de345f"
msgid ""
"Enough. If anyone befouled this place, it is you - by sowing division, "
"hatred - <i>death</i>."
msgstr "그만. 분열과 증오 - <i>죽음</i>을 싹트게 하여 이곳을 더럽힌 사람이 있다면, 그건 바로 너다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = 5aa51d70-7461-6dcb-f23c-6d00d0631b58
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:5aa51d70-7461-6dcb-f23c-6d00d0631b58
msgctxt "h7bbe3abeg4f37g4117gb4a7g79b069490719"
msgid ""
"You are an enemy of nature, to be shunned until you redeem yourself or die. "
"Now go."
msgstr "너는 자연의 적이다. 스스로 깨우치기까지 외면받거나, 죽거나. 이제 떠나라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = 5eb51d96-63ba-04cf-45fa-700cf9e3a5aa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GuardedEntrance_State_BothParentsDead = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:5eb51d96-63ba-04cf-45fa-700cf9e3a5aa
msgctxt "h17fc6a05ga9a0g4bc9g917cg7c588f6cc7ed"
msgid ""
"The girl's parents should have decided your fate, but they perished. "
"Instead, nature will judge you."
msgstr "소녀의 부모가 너의 운명을 결정해야겠지만, 그들은 사라졌다. 대신, 자연이 너를 심판할 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Player
#. NodeID = 5f8764f9-435a-c264-4f4f-16ffc8a403cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:5f8764f9-435a-c264-4f4f-16ffc8a403cb
msgctxt "h2c41f880g1d3bg43daga20cg112220986f0d"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = 6057ae16-4f16-a1cf-5d7d-d8e530bb1247
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:6057ae16-4f16-a1cf-5d7d-d8e530bb1247
msgctxt "h2a5dc39ag1e48g4d68g801ag7a6b8b7a6518"
msgid ""
"No doubt you'd have me flay her or cast her into a spiked pit. But the grove "
"needs druids."
msgstr "물론 그대는 그녀에게 채찍질을 하거나 가시 구덩이에 던지라고 했을 것이오. 하지만 이 숲에는 드루이드가 필요하오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = 65cc78d7-1c6a-012e-557c-e828b41be3e1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:65cc78d7-1c6a-012e-557c-e828b41be3e1
msgctxt "h1247880eg0248g409bg91c3g216f4d411512"
msgid ""
"Apologies for that ugliness. A more bitter homecoming than I would have "
"wished, but at least the grove stands, thanks to you."
msgstr "추한 모습은 사과하지. 내가 바랐던 것보다는 쓰라린 귀환이었지만, 적어도 숲은 건재하오, 그대 덕분이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = 68f6c2b8-a182-5d2a-5623-218d52b10225
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:68f6c2b8-a182-5d2a-5623-218d52b10225
msgctxt "h1e1487d6g1f4eg463ag8d38g47b85f947704"
msgid "Consider it in the past now. We must look forward."
msgstr "그 일은 과거에 묻어 두세. 우린 앞을 보며 나아가야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Player
#. NodeID = 69316551-67b6-9c1e-d1ef-9380303883f4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_ShadowDruid_SnakesCourt_SawKidDie = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:69316551-67b6-9c1e-d1ef-9380303883f4
msgctxt "h718587c0gf478g4104g92a4g5774565f13c9"
msgid ""
"I watched that child die because of her. She deserved far worse than that."
msgstr "난 그녀 때문에 아이가 죽는 걸 지켜봤어요. 그녀에겐 더 가혹한 처벌이 필요해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Player
#. NodeID = 6a1ccde1-c68a-c478-7b73-fd0886b8fb7f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LOLTHDROWELF(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:6a1ccde1-c68a-c478-7b73-fd0886b8fb7f
msgctxt "hd2477a91g848fg4c77g879cg65292d2a46e4"
msgid "Such mercy is a show of weakness. You're tainting a hard-won victory."
msgstr "그런 자비는 나약함을 나타낼 뿐입니다. 당신은 어렵게 얻은 승리에 먹칠하고 있어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Player
#. NodeID = 6cc0bf0e-b6d1-718a-95c8-16b0d3a4ce98
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_Knows_RecruitmentLetter = True
#. TagRule: DRUID
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:6cc0bf0e-b6d1-718a-95c8-16b0d3a4ce98
msgctxt "hff4bb4ceg09d7g4f64g9d4bg1049c74e932d"
msgid ""
"Kagha did not act alone - I found evidence that she conspired with Shadow "
"Druids."
msgstr "카그하는 혼자 행동한 게 아닙니다. 카그하가 그림자 드루이드와 결탁했다는 증거를 찾았어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Player
#. NodeID = 6cc0bf0e-b6d1-718a-95c8-16b0d3a4ce98
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_Knows_RecruitmentLetter = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:6cc0bf0e-b6d1-718a-95c8-16b0d3a4ce98
msgctxt "h3383bf4bg42f2g410bg929eg3ed3f7ea3dc0"
msgid ""
"Kagha was not acting on her own - she was under the influence of Shadow "
"Druids."
msgstr "카그하 혼자서 행동한 게 아닙니다. 그녀는 그림자 드루이드의 영향을 받고 있었습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = 6db19631-1be6-f3bb-b57c-dbb7654da61b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:6db19631-1be6-f3bb-b57c-dbb7654da61b
msgctxt "hfc782517gba13g486bga9d1g10c3f55a64b4"
msgid "I cannot absolve you, even if you are repentant."
msgstr "네가 뉘우친다고 해도, 널 용서할 수는 없다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Player
#. NodeID = 77452e71-e941-e198-cc6d-8c08c812ea63
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_TadpoleHelp = False
#.      - GOB_WolfPens_State_HalsinIntroHappened = True
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Knows_TadpoleHelp = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:77452e71-e941-e198-cc6d-8c08c812ea63
msgctxt "h5bf40cebge6f7g4d22g9de7g39a11e7496b3"
msgid "What about my problem? I need help."
msgstr "내 문제는 어쩌고요? 난 도움이 필요해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = 77ee5c9d-b79d-63ea-ead2-24c4e12e8275
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:77ee5c9d-b79d-63ea-ead2-24c4e12e8275
msgctxt "h1e3f54e4gb5a2g44d1ga223g4ce48f4534df"
msgid ""
"You will soon see why. But enough of that for now - I owe you my thanks."
msgstr "그대도 곧 그 이유를 알게 될 걸세. 하지만 지금은 이만하지 - 그대에게 감사를 빚졌네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = 782dda6b-d990-21cf-8da9-ed79b27bfb4a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_WillJoinCamp = False
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Quest_MeetAgainInCamp = True
#.     - GLO_Halsin_Knows_WillJoinCamp = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:782dda6b-d990-21cf-8da9-ed79b27bfb4a
msgctxt "h5d0efdb3g8a1fg4162g8da4g47517ba30d5e"
msgid ""
"Take tonight to rest, recuperate -celebrate. Tomorrow, I'll join your camp "
"so I can help with the trials yet to come."
msgstr ""
"오늘 밤은 푹 쉬고, 원기를 회복하시오. 축하도 하고 말이오. 내일 동이 트면, 그대의 야영지에 합류해 앞으로 다가올 길에 도움을 주겠소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = 78e42c8f-a6d0-30fd-503e-fdbbfd4a8d29
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_WolfPens_State_HalsinIntroHappened = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Halsin(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:78e42c8f-a6d0-30fd-503e-fdbbfd4a8d29
msgctxt "h1f0be947ga3a0g4051gaef5g3093492033df"
msgid "The grove stands. Nature prevails. And again, I am in your debt."
msgstr "숲은 버텨냈고. 자연이 승리했네. 그리고 다시 한번, 그대에게 빚을 졌군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Kagha
#. NodeID = 79319aeb-c82e-0ee9-0f41-0a2f609beb20
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:79319aeb-c82e-0ee9-0f41-0a2f609beb20
msgctxt "hd114ac6bg4c36g440bg880fgd4a815daa935"
msgid "A <i>thief </i>is dead - she stole the idol, befouled the grove!"
msgstr "<i>도둑이</i> 죽은 겁니다. 그 애는 우상을 훔치고 숲을 기만했어요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = 7cc0f937-32fd-95df-40d0-9d562aa5d813
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Quest_MeetAgainInCamp = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:7cc0f937-32fd-95df-40d0-9d562aa5d813
msgctxt "h682d1efdg09e9g48ccgb171gcedcebac55e6"
msgid "Tomorrow morning, we shall discuss what is to come."
msgstr "내일 아침이 밝으면, 앞으로의 일에 대해 의논하도록 하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = 8a25d921-1aaf-eb5a-d638-681b1fe209aa
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Knows_PlayerTadpoleCondition = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:8a25d921-1aaf-eb5a-d638-681b1fe209aa
msgctxt "hde376e8bga517g4a1eg8833ga5ccfd4d1a93"
msgid "...It's true. I can feel it right now. Oak Father preserve you, child."
msgstr "…사실이로군. 느껴지네. 아버지 떡갈나무께서 그대를 보호하길."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = 8a8baefa-f7fc-f9da-1595-8bed80408c23
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:8a8baefa-f7fc-f9da-1595-8bed80408c23
msgctxt "h4c35a0fagf3d3g4b98g9634g60ffb900fd6b"
msgid ""
"I am Halsin - First Druid of the Emerald Grove... and I sense you have a "
"problem you seek my help with."
msgstr "나는 에메랄드 숲의 최고 드루이드 할신이라네... 짐작컨대 그대는 내게 도움을 구할 문제가 있는 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = 8f62969f-de20-a65f-a206-6ba03dba9d81
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DRUID
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:8f62969f-de20-a65f-a206-6ba03dba9d81
msgctxt "hd6a572dbg203dg47e7ga7e9g521e058e3022"
msgid ""
"If only you had come to this place in more peaceful times. You'd have been a "
"welcome addition."
msgstr "조금 더 평화로운 시기에 방문했다면 좋았을 것을. 큰 환영을 받았을 터인데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = 8f62969f-de20-a65f-a206-6ba03dba9d81
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LOLTHDROWELF or REALLY_TIEFLING
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:8f62969f-de20-a65f-a206-6ba03dba9d81
msgctxt "h2ebab5e9g783ag4202gaa70g39cdd2015c62"
msgid "And yet save it you did. I am grateful no matter what your motivations."
msgstr "하지만 그대가 구했다는 사실은 변하지 않네. 동기가 뭐였든, 감사를 표하겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = 8f62969f-de20-a65f-a206-6ba03dba9d81
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:8f62969f-de20-a65f-a206-6ba03dba9d81
msgctxt "h76dc6937g6b01g4ac3g9567g99fbdf35fe58"
msgid ""
"Believe me, it is. The span of a mortal life isn't enough to grasp the "
"importance of this place. Its roots touch everything."
msgstr "날 믿게, 그건 확실하니. 필멸자의 일생으로는 이 장소의 중요함을 이해할 수 없지. 이곳의 뿌리는 모든 곳에 닿아 있다네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = 907be7b4-71f1-5794-2ec6-d4acc4187c83
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Halsin(2) = True
#.   Global:
#.     - GLO_Halsin_Event_TalkedWithDruidLeader = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:907be7b4-71f1-5794-2ec6-d4acc4187c83
msgctxt "h5bc776d1ga946g4d35ga446ge8a6fd449ce0"
msgid ""
"You took it upon yourself to undertake the Rite of Thorns? To spill "
"<i>blood</i> in this sacred place?"
msgstr "네 마음대로 가시의 의식을 행하기로 결정한 것이냐? 이 신성한 곳에 <i>피</i>가 흐르게 하려고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Kagha
#. NodeID = 952d8558-246e-41d2-a42f-a057c07becbd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:952d8558-246e-41d2-a42f-a057c07becbd
msgctxt "h2d6b26d8gaea3g4d42g8f47gcc10919c7f65"
msgid ""
"It was an accident! She stole the idol - we were overzealous, yes, but -"
msgstr "그건 사고였습니다! 그녀가 우상을 훔쳤어요 - 저희 열정이 지나쳤던 것은 사실입니다. 하지만 -"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Player
#. NodeID = 99ca3d0c-cb11-e39f-0266-4671fb53eaa8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:99ca3d0c-cb11-e39f-0266-4671fb53eaa8
msgctxt "h518cd12egcb5dg4965g9879ge0a7787d1876"
msgid "I don't know."
msgstr "모르겠습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Player
#. NodeID = 9b205b62-ed72-d99a-998f-062d3506b8e2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_AttackOnDen_Event_PlayerDeniesProblemToHalsin = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:9b205b62-ed72-d99a-998f-062d3506b8e2
msgctxt "he82939d8ga978g4604gaa16g7efaeba92205"
msgid "I don't know what you mean. What problem?"
msgstr "무슨 뜻인지 모르겠군요. 어떤 문제죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = 9c89c0fa-acd3-4df8-a156-99710b266cfa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:9c89c0fa-acd3-4df8-a156-99710b266cfa
msgctxt "h59ae54eeg1cc4g41edga5b1g4b2a40edceb0"
msgid ""
"There is naught a clear and meditative mind cannot overcome. After we stray, "
"we return to the fold, having learnt to do better. And in the fold, Kagha is "
"needed."
msgstr ""
"명징한 정신으로 이겨내지 못할 일은 없네. 설사 그릇된 길에 얽혀 들었다 해도, 다시 회합의 품으로 돌아올 때는 더 나은 길을 찾기 "
"마련이지. 여전히 우리 회합에는 카그하가 필요해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = a0697819-e408-6de0-b09a-d3a4743aecd9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_HalsinReturns_Event_SeekRath = False
#. SetFlags:
#.   Global:
#.     - DEN_HalsinReturns_Event_SeekRath = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:a0697819-e408-6de0-b09a-d3a4743aecd9
msgctxt "h919a1d3eg9efeg4b86gb014gd7b1521055ae"
msgid "Speak to Rath - he will reward you for your efforts."
msgstr "라스에게 말을 걸어 보게. 그대의 노고를 보상해 줄 테니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = a25f3085-c68f-98c2-1a52-6ba1f12f0f8b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:a25f3085-c68f-98c2-1a52-6ba1f12f0f8b
msgctxt "h3dbd41fcg419fg43dcg94e4g3fd0c51efd74"
msgid ""
"You shall learn it all once again, right here. Backslide, and nature's fury "
"will crush you."
msgstr "바로 이곳에서, 모든 것을 새로 배우거라. 신앙을 저버린다면, 자연의 분노가 널 짓누를 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = a5836a8a-95e0-e128-30fa-493d1886eef7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:a5836a8a-95e0-e128-30fa-493d1886eef7
msgctxt "h5c0fb483g2e1eg4292g8512g10c8dcea83d2"
msgid ""
"You are an enemy of nature, to be shunned until you redeem yourself or die. "
"Now go."
msgstr "너는 자연의 적이다. 네 스스로를 구원하거나 죽을 때까지 외면받으리라. 이제 떠나라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = a6594cdb-1c53-6608-aad8-8d51ca8e4cbd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = False
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Halsin(2) = True
#.   Global:
#.     - GLO_Halsin_Event_TalkedWithDruidLeader = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:a6594cdb-1c53-6608-aad8-8d51ca8e4cbd
msgctxt "h3519c1dfg6410g415aga9d6g40ad8583b979"
msgid ""
"You took it upon yourself to undertake the Rite of Thorns? I ought to exile "
"you from this place. Forever."
msgstr "네 마음대로 가시의 의식을 행하기로 결정한 것이냐? 원래대로라면 너를 이곳에서 추방해야 한다. 영원히."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = a722d0f9-be20-8f54-d72d-70a5c72335f9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:a722d0f9-be20-8f54-d72d-70a5c72335f9
msgctxt "h0961e916g01a7g45aag8af0g51b9b09d3788"
msgid "<i>Silence.</i> The rite has been ended."
msgstr "<i>조용히 하거라.</i> 의식은 중단되었다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = a7237746-3bd7-8f03-ac30-6d05f5446c7a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:a7237746-3bd7-8f03-ac30-6d05f5446c7a
msgctxt "hfb360fa8g85e4g41b9ga867g56747edddb5c"
msgid ""
"Someone is using very powerful magic to modify these tadpoles. They are "
"using them to exert control over the infected."
msgstr ""
"누군가가 이 올챙이를 개조하기 위해 매우 강한 마법을 사용하고 있네. 그들은 올챙이를 이용하여 감염자들에게 영향력을 행사하고 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Player
#. NodeID = a9919ab4-2cc4-576c-25e0-3affa687d796
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidFreed = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:a9919ab4-2cc4-576c-25e0-3affa687d796
msgctxt "hfabea8e5gec05g472cgab6bge91d12d8e427"
msgid "That's all? She tried to imprison a child."
msgstr "그게 다인가요? 그녀는 아이를 감금하려 했어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = a9ecc9a5-ae3c-1214-7da5-caa4b54922f4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_WillJoinCamp = True
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Quest_MeetAgainInCamp = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:a9ecc9a5-ae3c-1214-7da5-caa4b54922f4
msgctxt "h1bc08b51gfd9cg41a7gb844g393d1280ff11"
msgid ""
"Take tonight to rest, recuperate - celebrate. Tomorrow, we can strike out."
msgstr "오늘 밤은 휴식하고 기운을 회복하며, 축하하게. 내일 출발해도 좋네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = ab76f971-5c76-a053-4450-a39c03d8f22c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Event_AskedForHelp = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:ab76f971-5c76-a053-4450-a39c03d8f22c
msgctxt "h1951aa72gaa2bg414cg921fgc8dba8e7c326"
msgid ""
"It's no coincidence that we found each other, I'll wager? You're after a "
"cure for this parasite."
msgstr "우리가 서로 만난 것도 분명 우연은 아니겠지. 그대는 이 기생충의 치료제를 찾고 있군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Player
#. NodeID = adf24b01-a564-9b89-d579-79394d07ac1a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:adf24b01-a564-9b89-d579-79394d07ac1a
msgctxt "h1aed3522g9a0eg4c0ag9c86g3c7d22e2776d"
msgid "Wait - how did you get here?"
msgstr "잠깐, 여긴 어떻게 온 거죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = b411c542-adc8-ed7a-e4ce-1a8bb500fef7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Daisy_State_TriggerDaisyMissionStatement = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:b411c542-adc8-ed7a-e4ce-1a8bb500fef7
msgctxt "h62191431gd1efg4f12g8242g63ea3ab9e66e"
msgid ""
"At the goblin camp, I hoped to find a way to remove the tadpoles. I failed - "
"but I did find the next best thing. I found out where they come from."
msgstr ""
"고블린 야영지에서, 난 그 올챙이들을 제거할 방법을 찾고자 했지. 결국 실패했지만, 성과가 없지는 않았네. 놈들이 어디서 왔는지 "
"알아냈으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = b584b5af-f01e-2e87-b2bf-e51cff40aee6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:b584b5af-f01e-2e87-b2bf-e51cff40aee6
msgctxt "hab5a3679g67cbg4372g85bcgc5096f4a05a5"
msgid ""
"Spilled blood will not right bad blood. Allow me to deal with my own - I "
"still have need of her."
msgstr "피를 흘린다고 앙금이 사라지진 않소. 내 문제는 스스로 처리하도록 해주시오. 아직 그녀가 필요하오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Kagha
#. NodeID = b6c175d0-d57d-5b67-7914-95879059c8d3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:b6c175d0-d57d-5b67-7914-95879059c8d3
msgctxt "h1b353583g2df4g4eefga61dgccaeb23588ff"
msgid "<i>You</i> chose to abandon us. <i>I</i> chose to protect us!"
msgstr "<i>당신은</i> 저희를 저버리셨습니다. <i>전</i> 저희를 보호하려고 한 것뿐입니다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = bcae44c0-c455-45e8-6a83-19c32c42629a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:bcae44c0-c455-45e8-6a83-19c32c42629a
msgctxt "h2068b18bg3680g49e8gad49g5a1591596569"
msgid "Her punishment is only just beginning, trust me."
msgstr "단언컨대, 그녀의 처벌은 이제 시작일 뿐이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = bd5d8373-0c8e-0a98-c468-8ec2ae5ff02f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:bd5d8373-0c8e-0a98-c468-8ec2ae5ff02f
msgctxt "h0c8e41d8gca3bg4cedg83feg211b946aabaf"
msgid "It is up to you to prove the lessons have been learned once more."
msgstr "가르침을 다시 깨달았음을 증명하는 건 너에게 달렸다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = c61ba0a7-e51b-8166-93b1-2adf2c78bb38
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Event_BanishedKagha = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:c61ba0a7-e51b-8166-93b1-2adf2c78bb38
msgctxt "h7ba610ddgdef2g419dg9a52gea4c7404bb2e"
msgid ""
"You are banished from this place - banished from <i>everywhere </i>the Oak "
"Father's creations thrive."
msgstr "넌 이곳에서 추방될 것이다. 참나무 아버지의 피조물이 있는 곳이라면 <i>어떤 곳에서든 </i>마찬가지다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = cadebf16-5648-30c6-c9f5-230f6e75b568
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:cadebf16-5648-30c6-c9f5-230f6e75b568
msgctxt "h262b216fga5f6g401bg8f84g73d792b2699b"
msgid ""
"Please. Don't sully the gratitude I feel towards you by making excuses for "
"Kagha. My choice was clear."
msgstr "부탁이네. 카그하를 옹호해서, 내가 그대에 표하는 감사의 가치를 훼손하지 말아 주게. 나는 분명히 결정했네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = cc761d5a-1ecb-b880-fd0e-8b4a4a963ed9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:cc761d5a-1ecb-b880-fd0e-8b4a4a963ed9
msgctxt "h6905f11fgb743g4634g82d4g442e92f67bca"
msgid ""
"But... something's <i>different</i>. You're aware of the monster inside you. "
"You don't bow to the Absolute, like the True Souls do..."
msgstr ""
"하지만... 뭔가 <i>다르군</i>. 그대는 내면에 있는 괴물을 인지하고 있어. 참된 영혼들처럼 절대자에게 복종하지 않고 있지..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = ccb9c95b-8d49-1ecb-5fb2-73491b4714fa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:ccb9c95b-8d49-1ecb-5fb2-73491b4714fa
msgctxt "h7596412ag51b4g4ff1gb6f6gf6a0a8d3cddf"
msgid ""
"As for the idol? It's nothing compared to a life. A mere object, next to one "
"of nature's creations."
msgstr "우상 말인가? 그건 생명에 비하면 아무것도 아니야. 자연의 창조물에 비하면, 하나의 물건일 뿐이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = ccfe82c4-96e6-4383-570c-90f4090e8933
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_MoonriseBriefing = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:ccfe82c4-96e6-4383-570c-90f4090e8933
msgctxt "h18fbc28bge20bg43eag827bgc08afc14fb57"
msgid ""
"Soon. Remember the dangers I told you about - there'll be plenty of time to "
"face them."
msgstr "곧 그렇게 될 것이네. 내가 전에 말했던 위협을 기억하게. 그것들에 맞설 일이 많이 있을 것이니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Player
#. NodeID = d067eb22-a01c-7f34-292b-079eb81fc363
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_ShadowDruid_SnakesCourt_SawKidDie = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:d067eb22-a01c-7f34-292b-079eb81fc363
msgctxt "h75a8e6e7g065ag4f98g85cbg76c93f751567"
msgid ""
"Neither of us saw what happened before - maybe the child's death wasn't her "
"fault."
msgstr "그 일이 벌어지기 전의 사정을 모르는 건 우리 둘 다 마찬가지야. 그 아이의 죽음이 그녀 잘못이 아닐지도 모르지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = d2ee381b-72e3-cd2f-6ec2-3c0e75933ca1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:d2ee381b-72e3-cd2f-6ec2-3c0e75933ca1
msgctxt "hb2cbb960g0c4fg459cg892eg6a2e11d743e6"
msgid ""
"I was an unwilling guest of the goblins - but your efforts left them in "
"disarray and I was able to escape."
msgstr "난 고블린들에게 불청객이었네. 하지만 그대의 노력이 그들을 혼란스럽게 만들었고, 그사이에 나는 탈출할 수 있었지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Player
#. NodeID = d2f1446c-c8fb-b19c-d5cc-72bea36f557a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:d2f1446c-c8fb-b19c-d5cc-72bea36f557a
msgctxt "hc168ed85g0ae9g4a06gbab8g736b19e84d7d"
msgid ""
"The fire of ambition is in her very blood - and cruel blood is a life "
"companion."
msgstr "야망의 불길이 그녀의 피 안에 흐르고 있습니다.. 그리고 그 잔인한 피야말로 그녀의 동반자죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = d85245f0-9e9f-3958-c3e3-fa1d218e486f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:d85245f0-9e9f-3958-c3e3-fa1d218e486f
msgctxt "hba91dbdfgf177g448eg89f3g3b63b4ef08a6"
msgid "Instead, I shall listen to the explanation that you owe me."
msgstr "그 대신, 네가 내게 할 말이 있을 것이다. 듣도록 하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Player
#. NodeID = dee58949-9949-c2fd-1a7c-084b9fe9634e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:dee58949-9949-c2fd-1a7c-084b9fe9634e
msgctxt "hf23e0a6eg6456g4f6egaefcgb1a4a7cb7826"
msgid ""
"You'll have your hands full with her. She shows great spirit, to put it "
"mildly."
msgstr "제법 바빠지시겠군요. 좋게 말해, 카그하는 대단한 열정을 보였습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = dfdc7790-f498-0ccc-7824-96fbdd98418c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_Event_PlayerDeniesProblemToHalsin = True
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Knows_PlayerTadpoleCondition = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:dfdc7790-f498-0ccc-7824-96fbdd98418c
msgctxt "h4fa89854g71c5g46eeg916bg8642d124ebac"
msgid ""
"...<i>That</i> problem. You're infected with the mind flayer spawn, aren't "
"you? Oak Father preserve you, child."
msgstr "…<i>그</i> 문제 말이네. 마인드 플레이어에게 감염되었군, 안 그런가? 아버지 떡갈나무께서 그대를 보호하길."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Player
#. NodeID = e35289e1-554b-7c41-43f3-730a71c1bf2b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_TIEFLING(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:e35289e1-554b-7c41-43f3-730a71c1bf2b
msgctxt "hffe3ad15gbe06g484cgb6ddg149006241a5b"
msgid ""
"You should turn her over to my kin for judgement. Bad blood still lingers."
msgstr "그녀의 판결은 내 동족들에게 맡겨야 해요. 아직 앙금이 남아 있습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = ed068311-219b-dcdc-2901-22d45770a6f6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Quest_MeetAgainInCamp = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:ed068311-219b-dcdc-2901-22d45770a6f6
msgctxt "hfefddd7cg8fa1g4dccgb473g430878fc95ef"
msgid ""
"But that's tomorrow's problem. Take some time for yourself tonight - rest, "
"celebrate. Come morning, I'll be by your side."
msgstr ""
"그 문제는 내일 얘기하도록 하지. 오늘 밤엔 자신만의 시간을 좀 가지도록 하게. 푹 쉬고, 축하도 나누게. 내일 아침부터는 그대의 편에 "
"서겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = ed557917-9717-148e-bf01-86178c023d5c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:ed557917-9717-148e-bf01-86178c023d5c
msgctxt "hbfa88637g0c1fg46f5g923dgcfd7c569e2b4"
msgid "The journey to Moonrise Towers, and all the dangers that that entails."
msgstr "문라이즈 타워로 향하는 여정이겠지, 그리고 그와 함께 뒤따르는 위험도 있을 것이고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = ee7ed9af-f186-6c5e-7cbf-a7e8cc9ee8d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:ee7ed9af-f186-6c5e-7cbf-a7e8cc9ee8d0
msgctxt "h5fd92bcdgfc00g4e4ag8e1fgcc685bcf6a41"
msgid ""
"A misjudgement - one that should weigh heavily upon her. But the grove still "
"needs her passion."
msgstr "오판이었네. 그게 그녀를 무겁게 짓누르겠지. 하지만 숲에는 여전히 그녀의 열정이 필요해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = f0444a15-e968-95bb-2481-5a102b8ccad5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:f0444a15-e968-95bb-2481-5a102b8ccad5
msgctxt "h925635a4g9219g4ef2gbab0g48ab6b081be4"
msgid "Now get out of my sight. There is nothing more to be said."
msgstr "이제 썩 물러가거라. 더 이상 말할 것은 없으니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = f42cb5eb-1191-c15b-f8dd-f702f91e7dd3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:f42cb5eb-1191-c15b-f8dd-f702f91e7dd3
msgctxt "h9943b098gb65bg4575g8398g5a7ac3c43322"
msgid "Now get out of my sight. There is nothing more to be said."
msgstr "이제 썩 물러가거라. 더 이상 말할 것은 없으니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = f8fb766c-9525-9043-2f3a-56f9cfa39cea
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Knows_TadpoleHelp = True
#.     - GLO_Halsin_Quest_MeetAgainInCamp = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:f8fb766c-9525-9043-2f3a-56f9cfa39cea
msgctxt "h93122e8eg68d8g4b75g8a37g80fdbcd90fa8"
msgid ""
"I will do what I can to help you. Let us speak tomorrow - you and I both "
"have matters to see to first."
msgstr "내가 도울 수 있는 건 돕겠소. 내일 얘기하도록 하지. 그대나 나나 먼저 처리할 일이 있지 않나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader
#. Speaker = Halsin
#. NodeID = fb7227f9-1d32-9243-e846-c09c8b2a0610
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinAndDruidLeader:fb7227f9-1d32-9243-e846-c09c8b2a0610
msgctxt "h4807379bg8ff8g4a06g9a2cg631cf9923547"
msgid ""
"She shows great insolence. But time will humble her - and the grove still "
"needs her."
msgstr "그녀는 엄청난 무례를 범했네. 하지만 시간이 그녀에게 겸손을 가르쳐 주겠지. 게다가 숲에는 아직 그녀가 필요하네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Halsin
#. NodeID = 0ef36b75-b12a-c8af-6d93-bd7b948f6386
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:0ef36b75-b12a-c8af-6d93-bd7b948f6386
msgctxt "hd7fb441bge418g4cd8g92b1gf2a8919dccc0"
msgid ""
"I am Halsin - First Druid of the Emerald Grove... and I sense you have a "
"problem you seek my help with."
msgstr "나는 에메랄드 숲의 최고 드루이드 할신이라네... 짐작컨대 그대는 내게 도움을 구할 문제가 있는 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Halsin
#. NodeID = 123de7a9-d8b9-7ec9-0e27-84bb31a07f63
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:123de7a9-d8b9-7ec9-0e27-84bb31a07f63
msgctxt "hc88db04ege1cbg4904gbc3cg78a1f1cd3798"
msgid "...It's true. I can feel it right now. Oakfather preserve you, child."
msgstr "...사실이군. 바로 느껴져. 참나무 아버지께서 그대를 지켜주시길."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Player
#. NodeID = 1638af6e-39c3-5279-38a7-e4ea766f8bf4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_TadpoleHelp = False
#.      - GOB_WolfPens_State_HalsinIntroHappened = True
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Knows_TadpoleHelp = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:1638af6e-39c3-5279-38a7-e4ea766f8bf4
msgctxt "hf3317c52g8a0cg44c5gbf14g949219dfb505"
msgid "What about my problem? I need to get to Moonrise Towers."
msgstr "내 문제는 어쩌고요? 난 문라이즈 타워로 가야 해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Halsin
#. NodeID = 1bb10589-dfe9-82f2-5c2d-631ffadfcd6e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:1bb10589-dfe9-82f2-5c2d-631ffadfcd6e
msgctxt "h50b4274dga53cg4bcag9dddg4eed2fbb91e6"
msgid ""
"The shadows could not have tempted her if I had taught her as I should have."
msgstr "내가 그녀에게 올바른 가르침을 내렸다면, 그림자가 그녀를 유혹하지 못했을 테지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Player
#. NodeID = 1c8656e3-80b1-fe65-45a8-c09689f98e73
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_KaghaAlive = False
#.      - GLO_Halsin_Knows_KaghasFate = False
#.      - DEN_ShadowDruid_State_KaghaIsDead = True
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = True
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Knows_KaghasFate = True
#.     - GLO_Halsin_Knows_KaghaDead = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:1c8656e3-80b1-fe65-45a8-c09689f98e73
msgctxt "hf11a560cg448fg4f72gaeecg9e2f6c1fbd66"
msgid "I'm afraid your pupil, Kagha, is dead."
msgstr "안타깝지만, 당신의 제자, 카그하가 죽었어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Halsin
#. NodeID = 203b8c95-913f-17a4-8d0d-36bde83f87f9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Halsin(1) = True
#.   Global:
#.      - DEN_Refugees_State_LeadersAreDead = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:203b8c95-913f-17a4-8d0d-36bde83f87f9
msgctxt "h897bea6bg2587g4a31g8eb1g3090913f4e9f"
msgid ""
"Your path will soon take you away from the grove, I feel. Your efforts will "
"not be forgotten."
msgstr "그대의 여정이 곧 이 숲에서 멀리 떨어진 것으로 이끌 것이란 직감이 드는군. 그대의 노고는 절대 잊히지 않을 것이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Halsin
#. NodeID = 2171ed2f-319d-5ace-175b-9bb235064f04
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_MoonriseBriefing = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:2171ed2f-319d-5ace-175b-9bb235064f04
msgctxt "h1cb54e30g41b8g4559gaf0bg224b15b13fc0"
msgid ""
"Soon. First I must set matters to rights in the grove. And you should "
"celebrate your victory."
msgstr "조만간 그럴 것이네. 일단 나는 이 숲의 문제를 바로잡아야 하고, 그대는 승리를 축하해야 하잖나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Player
#. NodeID = 2553808e-0e05-2f30-20b1-5cfb72022a9f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - NIGHT_DarkUrge_MurderOfAlfira = True
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:2553808e-0e05-2f30-20b1-5cfb72022a9f
msgctxt "h348096ddg22f1g4029g8fe4gc299bed625a7"
msgid "I might go mad... I might be mad..."
msgstr "미칠 것 같아... 미칠 것 같아..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Halsin
#. NodeID = 30318938-d0fe-c426-addc-f29d4b914795
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_MoonriseBriefing = False
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Quest_MeetAgainInCamp = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:30318938-d0fe-c426-addc-f29d4b914795
msgctxt "hc3101e06gbe25g4554gbac8g32d1cea34a88"
msgid ""
"Rest. Heal. Celebrate if you wish. Mourn if you must. Come morning, we shall "
"discuss delivering you from your parasite."
msgstr ""
"휴식하고, 치유를 하게. 원한다면 축하하거나 애도해도 좋고. 아침이 다가오면, 그대를 기생충으로부터 구제할 방법에 대해 논의하도록 하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Halsin
#. NodeID = 367a100f-5cb2-b13c-48bd-809ad528427d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_WillJoinCamp = True
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Quest_MeetAgainInCamp = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:367a100f-5cb2-b13c-48bd-809ad528427d
msgctxt "h427599ebg2fdag485cg8772g61158236eee0"
msgid ""
"Take tonight to rest, recuperate - celebrate. Tomorrow, we can strike out."
msgstr "오늘 밤은 휴식하고 기운을 회복하며, 축하하게. 내일 출발해도 좋네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Player
#. NodeID = 38617e98-4514-77bc-0ec0-86232115c977
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_DruidsAllDead = False
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Knows_DruidsAllDead = True
#.     - GLO_Halsin_Knows_KaghasFate = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:38617e98-4514-77bc-0ec0-86232115c977
msgctxt "h22b3a4d5g1820g4c8cgb86eg11c4c4af46ca"
msgid ""
"The other druids are dead. They turned on us - we had to defend ourselves."
msgstr "다른 드루이드들은 죽었어요. 그들이 우릴 배신해서, 스스로를 방어할 수밖에 없었어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Halsin
#. NodeID = 3d7ee873-a400-8db4-d60a-a7d10c72bb5f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Refugees_State_LeadersAreDead = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Halsin(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:3d7ee873-a400-8db4-d60a-a7d10c72bb5f
msgctxt "ha99b3c3cg4f88g4794g8877gbdba43499f39"
msgid ""
"With the leadership dead, no attack will be mounted on the grove. I am in "
"your debt, my friend."
msgstr "수뇌부가 죽었으니, 이제 숲을 향한 공격은 없겠지. 그대에게 빚을 졌네, 친우여."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Halsin
#. NodeID = 42cd88c2-5de6-1ca5-ceeb-6fa69db4114a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_WillJoinCamp = False
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Quest_MeetAgainInCamp = True
#.     - GLO_Halsin_Knows_WillJoinCamp = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:42cd88c2-5de6-1ca5-ceeb-6fa69db4114a
msgctxt "h5f20e4c3g059dg49edgababge699cf8f6ac5"
msgid ""
"Take tonight to rest, recuperate - celebrate. Tomorrow, I'll join your camp "
"so I can help with the trials yet to come."
msgstr ""
"오늘은 푹 쉬게. 원기를 회복하고, 축하연도 벌이게. 내일 동이 트면, 그대의 야영지에 합류해 앞으로 나아갈 길에 도움을 주겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Player
#. NodeID = 43f27632-e62c-4d85-f4cd-df077c83f23d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_WhatsNext = False
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Knows_WhatsNext = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:43f27632-e62c-4d85-f4cd-df077c83f23d
msgctxt "h5e18a03fgafdag4c90g8f77g495adffde600"
msgid "What happens next?"
msgstr "이젠 어떻게 될까요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Player
#. NodeID = 50909e5c-9a73-3266-1f2b-a4c9ad7da4af
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Event_RevealedNautiloidEscape = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:50909e5c-9a73-3266-1f2b-a4c9ad7da4af
msgctxt "hbd1344a6g3b35g421ag8bfbge718c11afc10"
msgid ""
"I escaped from an illithid ship after being infected. Maybe the process was "
"interrupted."
msgstr "감염되고 나서 일리시드 함선에서 탈출했어요. 변이 과정에 방해가 있었을지도 모르죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Player
#. NodeID = 5152cd31-70a5-3867-d3e5-9c176a6b5797
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_MoonriseBriefing = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:5152cd31-70a5-3867-d3e5-9c176a6b5797
msgctxt "h4f0f4571g67d3g4a3egb4dbge9c77a444e37"
msgid ""
"There's something else I wanted to ask about getting to Moonrise Towers."
msgstr "문라이즈 타워로 가는 방법에 대해 묻고 싶군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Halsin
#. NodeID = 544e0bf0-3a40-3957-2133-000982db298f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Knows_PlayerTadpoleCondition = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:544e0bf0-3a40-3957-2133-000982db298f
msgctxt "hf2bba243gfcbbg4bd1g9473gc7e82d681a00"
msgid "Oakfather... a mind flayer spawn. You should be far gone by now."
msgstr "참나무 아버지시여...마인드 플레이어의 씨앗이로군. 지금쯤 이라면 훨씬 더 진행되었어야 할 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Halsin
#. NodeID = 5c976a1e-2e11-5157-7023-279bd4669c66
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:5c976a1e-2e11-5157-7023-279bd4669c66
msgctxt "h5d7f801cg855eg4f38gae36g04aa8bdbf3c6"
msgid "Perhaps... but I wouldn't want to place all my faith in blind luck."
msgstr "그럴지도... 하지만 맹목적인 운에 모든 믿음을 걸고 싶지는 않다네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Halsin
#. NodeID = 607c01ac-a7b6-7b7e-b6b2-c3c851351ccd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:607c01ac-a7b6-7b7e-b6b2-c3c851351ccd
msgctxt "h40543037g714fg4dbag8a77gf458d2969578"
msgid ""
"After being dormant for so long, your infection is unlikely to produce new "
"symptoms spontaneously."
msgstr "그렇게 오랫동안 휴면 상태였던 감염이, 자연적으로 새로운 증상을 발현할 가능성은 낮을 것 같네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Halsin
#. NodeID = 625387d5-de9b-210d-06ce-c1d209316c32
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:625387d5-de9b-210d-06ce-c1d209316c32
msgctxt "hfed1b820gdfccg4326g97b4g18bcceef5f02"
msgid ""
"Kagha... poor child. The grove will be a dimmer place without her potential."
msgstr "카그하... 불쌍한 아이야. 그녀의 잠재력이 없으면 이 숲은 앞날이 더 어두울 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Halsin
#. NodeID = 6c7ad93c-539b-0b48-1d03-054100ceb31f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Halsin(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:6c7ad93c-539b-0b48-1d03-054100ceb31f
msgctxt "hb59969a8g5f0eg4064ga51bg3f53e93b040c"
msgid "The grove stands. Nature prevails. And again, I am in your debt."
msgstr "숲은 버텨냈고. 자연이 승리했네. 그리고 다시 한번, 그대에게 빚을 졌군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Halsin
#. NodeID = 73db6bbc-9485-f36a-5947-e1803bc5afa3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:73db6bbc-9485-f36a-5947-e1803bc5afa3
msgctxt "h8610daf2gd3edg487aga513g59a5ce2c179f"
msgid ""
"It's no coincidence that we found each other, I'll wager? You're after a "
"cure for this parasite."
msgstr "우리가 서로 만난 것도 분명 우연은 아니겠지. 그대는 이 기생충의 치료제를 찾고 있군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Halsin
#. NodeID = 74b4d133-f68f-80ee-6b97-1a686620ebdc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:74b4d133-f68f-80ee-6b97-1a686620ebdc
msgctxt "h3b0f744dgfa7cg4e33gb65cgf686ad0b0031"
msgid ""
"I was an unwilling guest of the goblins - but your efforts left them in "
"disarray and I was able to escape."
msgstr "난 고블린들에게 불청객이었네. 하지만 그대의 노력이 그들을 혼란스럽게 만들었고, 그사이에 나는 탈출할 수 있었지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Halsin
#. NodeID = 7c8e444e-472e-4456-254c-a85603c2100b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:7c8e444e-472e-4456-254c-a85603c2100b
msgctxt "h5c749265g0c23g4290g8df0g7b8e3d60b69c"
msgid "But the grove still stands even if they do not - thanks to you."
msgstr "비록 그들은 죽었더라도, 숲은 여전히 건재하군. 고맙네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Player
#. NodeID = 7ced0f99-1bb9-2bf1-3782-e431d5ca73e0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_AttackOnDen_Event_PlayerDeniesProblemToHalsin = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:7ced0f99-1bb9-2bf1-3782-e431d5ca73e0
msgctxt "hf00e64b6ga129g4cdega6f0g08063d79d345"
msgid "I don't know what you mean. What problem?"
msgstr "무슨 뜻인지 모르겠군요. 어떤 문제죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Halsin
#. NodeID = 926f59ea-1df0-3704-be34-2c60870389f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:926f59ea-1df0-3704-be34-2c60870389f8
msgctxt "hfa6a7287g1c10g493fga153g1dd726d5fae9"
msgid "The journey to Moonrise Towers, and all the dangers that that entails."
msgstr "문라이즈 타워로 향하는 여정이겠지, 그리고 그와 함께 뒤따르는 위험도 있을 것이고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Player
#. NodeID = 955849d5-3a6c-6005-b0f1-a3ab1b44a735
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_KaghasFate = True
#.   Local:
#.      - e9782733-5e17-c953-3e3d-3d594d62bf6a_ThoguhtsOnGrove = False
#. SetFlags:
#.   Local:
#.     - e9782733-5e17-c953-3e3d-3d594d62bf6a_ThoguhtsOnGrove = True
#. TagRule: DRUID
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:955849d5-3a6c-6005-b0f1-a3ab1b44a735
msgctxt "he1559feegd5acg4d3dgbd33g7b7711176052"
msgid "The grove is nature's beating heart - I was glad to help save it."
msgstr "이 숲은 자연의 맥동하는 심장이죠. 제가 숲을 도울 수 있어 기뻤습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Player
#. NodeID = 955849d5-3a6c-6005-b0f1-a3ab1b44a735
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_KaghasFate = True
#.   Local:
#.      - e9782733-5e17-c953-3e3d-3d594d62bf6a_ThoguhtsOnGrove = False
#. SetFlags:
#.   Local:
#.     - e9782733-5e17-c953-3e3d-3d594d62bf6a_ThoguhtsOnGrove = True
#. TagRule: REALLY_TIEFLING
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:955849d5-3a6c-6005-b0f1-a3ab1b44a735
msgctxt "h23703d93g444cg40f8g8d8eg1b0602603054"
msgid "I acted to save my kin, not this place."
msgstr "내 동족을 구하기 위해서였어요, 이곳이 아니라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Player
#. NodeID = 955849d5-3a6c-6005-b0f1-a3ab1b44a735
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_KaghasFate = True
#.   Local:
#.      - e9782733-5e17-c953-3e3d-3d594d62bf6a_ThoguhtsOnGrove = False
#. SetFlags:
#.   Local:
#.     - e9782733-5e17-c953-3e3d-3d594d62bf6a_ThoguhtsOnGrove = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:955849d5-3a6c-6005-b0f1-a3ab1b44a735
msgctxt "hb0898699g461fg4bddgb5c1g8922d2c544eb"
msgid "I hope this grove of yours is worth the bloodshed."
msgstr "당신의 숲이 그 모든 피를 흘릴 가치가 있었으면 좋겠군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Halsin
#. NodeID = 9731a7c4-08e0-d170-64c6-6f44bb8b898a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_HalsinReturns_Event_SeekRath = False
#.      - DEN_ShadowDruid_State_RathIsPermaDefeated = False
#. SetFlags:
#.   Global:
#.     - DEN_HalsinReturns_Event_SeekRath = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:9731a7c4-08e0-d170-64c6-6f44bb8b898a
msgctxt "hca755069gb009g49adgb946gffd38bc28066"
msgid "Speak to Rath - he will reward you for your efforts."
msgstr "라스에게 말을 걸어 보게. 그대의 노고를 보상해 줄 테니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Halsin
#. NodeID = 983062c3-ce67-5755-84f2-7b883f827ead
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:983062c3-ce67-5755-84f2-7b883f827ead
msgctxt "h92c5b164g97bcg4389g9dd1g1204289cbb51"
msgid ""
"I was not here to guide them. Now they rest forever, while I carry the "
"weight of my failings."
msgstr "이곳에서 그들을 인도해 주지 못했군. 이제 그들은 영면에 들었네. 나는 잃어버린 이들의 무게를 짊어져야겠지만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Halsin
#. NodeID = 9ca8e3e4-e937-6d9d-e226-1dd10c089f0f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:9ca8e3e4-e937-6d9d-e226-1dd10c089f0f
msgctxt "hdf14828ag6b77g4adaga491ga28cf89b9174"
msgid ""
"But you are right - you had no choice. I failed her, long before you arrived."
msgstr "그대 말이 맞네. 선택의 여지가 없었겠지. 그대들이 오기 훨씬 전부터 카그하는 내게 실망했을 걸세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Player
#. NodeID = 9eaaef3a-c779-baba-8f4c-eefa2d3bac83
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:9eaaef3a-c779-baba-8f4c-eefa2d3bac83
msgctxt "h27cf6a1egbd3fg4a83g9877g46500841f5f3"
msgid "I can't remember anything... All my life before the parasite..."
msgstr "아무 것도 기억나지 않습니다... 기생충에 당하기 전의 일은요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Halsin
#. NodeID = a0d7ce94-7c32-9025-4443-8a2a8831a420
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Daisy_State_TriggerDaisyMissionStatement = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:a0d7ce94-7c32-9025-4443-8a2a8831a420
msgctxt "ha013902bg9244g4be9gb754gbfeaeb843927"
msgid ""
"There's a chokehold of magic, binding the creature to you. Any efforts to "
"remove it would almost certainly kill you - or worse."
msgstr ""
"그대를 옥죄고 있는 마법이 있는데, 그 생명체를 그대와 결속하고 있다네. 그 기생충을 제거하려고 하면, 분명 그대가 죽고 말겠지. 그보다 "
"끔찍한 운명이 기다리고 있을지도 모르고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Player
#. NodeID = a0fd41bb-6815-39f0-5f26-262c8cfcd13f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = False
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = False
#.      - DEN_ShadowDruid_State_KaghaKilled = False
#.   Local:
#.      - e9782733-5e17-c953-3e3d-3d594d62bf6a_ThoguhtsOnGrove = False
#. SetFlags:
#.   Local:
#.     - e9782733-5e17-c953-3e3d-3d594d62bf6a_ThoguhtsOnGrove = True
#. TagRule: DRUID
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:a0fd41bb-6815-39f0-5f26-262c8cfcd13f
msgctxt "hb21bdfd2gef1eg40f8g8a87g1b976a9fae70"
msgid "The grove is nature's beating heart - I was glad to help save it."
msgstr "이 숲은 자연의 맥동하는 심장이죠. 제가 숲을 도울 수 있어 기뻤습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Player
#. NodeID = a0fd41bb-6815-39f0-5f26-262c8cfcd13f
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = False
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = False
#.      - DEN_ShadowDruid_State_KaghaKilled = False
#.   Local:
#.      - e9782733-5e17-c953-3e3d-3d594d62bf6a_ThoguhtsOnGrove = False
#. SetFlags:
#.   Local:
#.     - e9782733-5e17-c953-3e3d-3d594d62bf6a_ThoguhtsOnGrove = True
#. TagRule: REALLY_TIEFLING
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:a0fd41bb-6815-39f0-5f26-262c8cfcd13f
msgctxt "hba442b11gac65g424cg8e50ge69c3d70f6c3"
msgid "I acted to save my kin, not this place."
msgstr "내 동족을 구하기 위해서였어요, 이곳이 아니라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Player
#. NodeID = a0fd41bb-6815-39f0-5f26-262c8cfcd13f
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = False
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = False
#.      - DEN_ShadowDruid_State_KaghaKilled = False
#.   Local:
#.      - e9782733-5e17-c953-3e3d-3d594d62bf6a_ThoguhtsOnGrove = False
#. SetFlags:
#.   Local:
#.     - e9782733-5e17-c953-3e3d-3d594d62bf6a_ThoguhtsOnGrove = True
#. TagRule: REALLY_LOLTHDROWELF
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:a0fd41bb-6815-39f0-5f26-262c8cfcd13f
msgctxt "h8553e78fg4956g4b3ag9ee4g1a762820cd41"
msgid "I did as I wished to. I never cared if this place was saved or not."
msgstr "내가 원하는 일을 한 거예요. 이 장소를 구하는 일에는 전혀 신경 쓴 적이 없죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Player
#. NodeID = a0fd41bb-6815-39f0-5f26-262c8cfcd13f
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = False
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = False
#.      - DEN_ShadowDruid_State_KaghaKilled = False
#.   Local:
#.      - e9782733-5e17-c953-3e3d-3d594d62bf6a_ThoguhtsOnGrove = False
#. SetFlags:
#.   Local:
#.     - e9782733-5e17-c953-3e3d-3d594d62bf6a_ThoguhtsOnGrove = True
#. TagRule: REALLY_PLANAR
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:a0fd41bb-6815-39f0-5f26-262c8cfcd13f
msgctxt "habcae521g7594g4892gbaccgedab6ff2e00a"
msgid ""
"This place means nothing to me, but a great deal to you, it seems. I hope "
"the blood price was worth it."
msgstr "이 장소는 내게 아무런 의미도 없지만, 당신에겐 큰 의미가 있는 것 같군요. 흐른 피가 그럴 만한 가치가 있었길 바라죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Player
#. NodeID = a0fd41bb-6815-39f0-5f26-262c8cfcd13f
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = False
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = False
#.      - DEN_ShadowDruid_State_KaghaKilled = False
#.   Local:
#.      - e9782733-5e17-c953-3e3d-3d594d62bf6a_ThoguhtsOnGrove = False
#. SetFlags:
#.   Local:
#.     - e9782733-5e17-c953-3e3d-3d594d62bf6a_ThoguhtsOnGrove = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:a0fd41bb-6815-39f0-5f26-262c8cfcd13f
msgctxt "hd6ac44a1g9525g404bg989bg08b5bdea4ad5"
msgid "I hope this grove of yours was worth the bloodshed."
msgstr "당신의 숲이 그 모든 피를 흘릴 가치가 있었다면 좋겠군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Player
#. NodeID = a6519627-47c2-906e-1feb-027bc23757d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:a6519627-47c2-906e-1feb-027bc23757d6
msgctxt "h7d4f4f55gdd15g4662ga456gef90fedbdb8f"
msgid ""
"Yes. I have a mind flayer parasite inside my head. I want your help removing "
"it."
msgstr "맞아요. 제 머릿속에는 마인드 플레이어 기생충이 있습니다. 그것을 제거하는 데 당신의 도움을 받고 싶습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Halsin
#. NodeID = ae0f5ab3-7105-24e6-cf77-60a045c96220
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Halsin(1) = False
#.   Global:
#.      - GOB_WolfPens_State_HalsinIntroHappened = False
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Halsin(1) = True
#.   Local:
#.     - e9782733-5e17-c953-3e3d-3d594d62bf6a_TadpoleStudies = False
#.     - e9782733-5e17-c953-3e3d-3d594d62bf6a_NotUsualCeremorphosis = False
#.     - e9782733-5e17-c953-3e3d-3d594d62bf6a_CantYouHelp = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:ae0f5ab3-7105-24e6-cf77-60a045c96220
msgctxt "h38e1cb59g4fc9g41dag81e0g5fa4f7144ef4"
msgid ""
"The grove stands. Nature prevails. I owe you my thanks - and an introduction."
msgstr "숲은 버텨냈고. 자연이 승리했네. 그대에게 빚을 졌군. 내 소개를 하겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Player
#. NodeID = b401116b-8278-730e-79ae-b0882eb9212f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:b401116b-8278-730e-79ae-b0882eb9212f
msgctxt "hdf4c6eaege32bg4ba2g800ag3bf968354fcb"
msgid "I don't know."
msgstr "모르겠군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Halsin
#. NodeID = b8938d91-f2a3-b264-6d03-caa1b980188f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Halsin(1) = True
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Quest_MeetAgainInCamp = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:b8938d91-f2a3-b264-6d03-caa1b980188f
msgctxt "hcc116084gfd46g4b31g873eg8976b9e5c291"
msgid "Enjoy the respite. Come morning, we have matters to discuss."
msgstr "잠깐의 여유를 즐기시오. 아침에 보지, 논의할 문제가 있으니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Player
#. NodeID = c3d84f99-0e0a-8e0d-40b4-a0f787c4f7bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:c3d84f99-0e0a-8e0d-40b4-a0f787c4f7bf
msgctxt "hc8fd6022g0e28g45b4ga866g2cea0eeebe59"
msgid "Wait - how did you get here?"
msgstr "잠깐, 여긴 어떻게 온 거죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Halsin
#. NodeID = c57fd83e-f69a-908b-a74f-362022a3347b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_HalsinReturns_Event_SeekRath = False
#.      - DEN_ShadowDruid_State_RathIsPermaDefeated = False
#. SetFlags:
#.   Global:
#.     - DEN_HalsinReturns_Event_SeekRath = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:c57fd83e-f69a-908b-a74f-362022a3347b
msgctxt "hcd004405g5cb9g4f14g9bd3g02f6aa6e1196"
msgid ""
"As for what you've done for the grove, speak to Rath. He will see to your "
"reward."
msgstr "그대가 숲을 위해 해준 일에 대해선, 라스에게 이야기해 보시오. 그가 그대에게 보상을 줄 것이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Halsin
#. NodeID = d079a402-8419-5c37-3c6c-de7e1f177e26
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Quest_MeetAgainInCamp = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:d079a402-8419-5c37-3c6c-de7e1f177e26
msgctxt "hb9882433g2756g4437ga218gf4a14f79d50a"
msgid "Tomorrow morning, we shall discuss what is to come."
msgstr "동이 트거든, 남은 일에 대해 논해보도록 하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Halsin
#. NodeID = d5a09395-730e-9a29-1612-aab00bd2cb12
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_Event_PlayerDeniesProblemToHalsin = True
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Knows_PlayerTadpoleCondition = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:d5a09395-730e-9a29-1612-aab00bd2cb12
msgctxt "hb5549108g8895g4d27g8b56g2a6f093dd37b"
msgid ""
"...<i>That</i> problem. You're infected with the mind flayer spawn, aren't "
"you? Oakfather preserve you, child."
msgstr "...<i>그</i> 문제라. 마인드 플레이어 벌레에게 감염된 것이군. 참나무 아버지께서 지켜주시길."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Halsin
#. NodeID = d78825d7-7883-9499-1290-dcbe4931cfee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:d78825d7-7883-9499-1290-dcbe4931cfee
msgctxt "h0e92f7d8g9dbfg4025g8bc3g6ecbd7d45d17"
msgid ""
"Yes, you did. You acted according to your instincts, to nature. This is my "
"fault."
msgstr "맞아, 그렇지. 그대는 본능에 따라 자연스럽게 행동한 것이오. 이건 내 잘못이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Halsin
#. NodeID = de51e8f3-ccf2-2bd4-0373-8c4c723d0cb4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:de51e8f3-ccf2-2bd4-0373-8c4c723d0cb4
msgctxt "h6597d547g25b6g484agbb02g59f5e42db77a"
msgid ""
"It sounds as if you've been done a world of harm. Cling onto the life you "
"yet have."
msgstr "세상 모든 문제를 다 겪어 본 것처럼 말하는구려. 남은 삶은 다르기를 바라 봅시다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Halsin
#. NodeID = e0acf5fe-8bfa-6faf-e6a5-da5613c7f92a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:e0acf5fe-8bfa-6faf-e6a5-da5613c7f92a
msgctxt "hdce5bf52g7d43g4337gaed0g111625befbcf"
msgid "But the grove still stands even if she does not - thanks to you."
msgstr "하지만 그녀가 없더라도 숲은 여전히 건재하군, 그대 덕분에."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Halsin
#. NodeID = e0da6936-2a09-928f-9dcf-1becdf26eb3b
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DRUID
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:e0da6936-2a09-928f-9dcf-1becdf26eb3b
msgctxt "h21701c8ega6c5g475dg929eg4e5be58a59cc"
msgid ""
"If only you had come to this place in more peaceful times. You'd have been a "
"welcome addition."
msgstr "당신이 좀 더 평화로운 시기에 왔으면 좋았을 것이오. 그랬으면 더 환영받았을 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Halsin
#. NodeID = e0da6936-2a09-928f-9dcf-1becdf26eb3b
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LOLTHDROWELF or REALLY_TIEFLING
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:e0da6936-2a09-928f-9dcf-1becdf26eb3b
msgctxt "hf6fa570bg1412g4eaagbdb9g1e89509fe3b1"
msgid "And yet save it you did. I am grateful no matter what your motivations."
msgstr "하지만 그대가 구했다는 사실은 변하지 않소. 동기가 뭐였든, 감사를 표하겠소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Halsin
#. NodeID = e0da6936-2a09-928f-9dcf-1becdf26eb3b
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:e0da6936-2a09-928f-9dcf-1becdf26eb3b
msgctxt "hb8afcb63gd78cg417agb822g08aa78d0666c"
msgid ""
"Believe me, it is. The span of a mortal life isn't enough to grasp the "
"importance of this place. Its roots touch everything."
msgstr "날 믿게, 그건 확실하니. 필멸자의 일생으로는 이 장소의 중요함의 일부도 이해할 수 없네. 이곳의 뿌리는 모든 곳에 닿아 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Halsin
#. NodeID = e4d25eb1-c71e-fcad-bdb4-5d99639dd6aa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:e4d25eb1-c71e-fcad-bdb4-5d99639dd6aa
msgctxt "h0e4f0ce7gf43eg409fgbbe8gbf9ba2127dd1"
msgid ""
"But... something's <i>different</i>. You're aware of the monster inside you. "
"You don't bow to the Absolute, like the True Souls do..."
msgstr ""
"하지만... 뭔가 <i>다르군</i>. 그대는 내면에 있는 괴물을 인지하고 있어. 참된 영혼들처럼 절대자에게 복종하지 않고 있지..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Halsin
#. NodeID = e641bc8d-8f92-2939-4591-46935fec9edc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Quest_MeetAgainInCamp = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:e641bc8d-8f92-2939-4591-46935fec9edc
msgctxt "h8bacbca2g7dc4g49c4g8019gf54ee4160a78"
msgid ""
"But that's tomorrow's problem. Take some time for yourself tonight - rest, "
"celebrate. Come morning, I'll be by your side."
msgstr ""
"그 문제는 내일 얘기하도록 하지. 오늘 밤엔 자신만의 시간을 좀 가지도록 하게. 푹 쉬고, 축하도 나누게. 내일 아침부터는 그대의 편에 "
"서겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Halsin
#. NodeID = e6f2fb75-df22-87c5-5c6a-c267c8f57c3b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_MoonriseBriefing = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:e6f2fb75-df22-87c5-5c6a-c267c8f57c3b
msgctxt "h535b0ab3g100cg4ec4g8ceege5f56485d763"
msgid ""
"Soon. Remember the dangers I told you about - there'll be plenty of time to "
"face them."
msgstr "곧 그렇게 될 것이네. 내가 전에 말했던 위협을 기억하게. 그것들에 맞설 일이 많이 있을 것이니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Player
#. NodeID = e8b29eb8-dc8b-ce31-0841-8efdbc0d51a2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_TadpoleHelp = True
#.      - GLO_Halsin_Knows_TadpoleHelp2 = False
#.      - GLO_Halsin_Knows_MoonriseBriefing = False
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Knows_TadpoleHelp = True
#.     - GLO_Halsin_Knows_TadpoleHelp2 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:e8b29eb8-dc8b-ce31-0841-8efdbc0d51a2
msgctxt "h13963b84gb307g41aag8b84g11a7d543111b"
msgid "No more delays. Tell me what you know about getting to Moonrise."
msgstr "시간 끌지 말고, 문라이즈에 도착하는 방법에 대해 알고 있는 정보를 말해 주세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Player
#. NodeID = ecff6bf4-34e9-2784-07b6-e384336d823c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:ecff6bf4-34e9-2784-07b6-e384336d823c
msgctxt "ha959eee4g7480g42a9gac5fg30c8a4a993a9"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Player
#. NodeID = f360d7f8-d716-ee18-a1bc-9069cc23073e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_KaghaDead = False
#.      - DEN_ShadowDruid_State_KaghaKilled = True
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Knows_KaghasFate = True
#.     - GLO_Halsin_Knows_KaghaDead = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:f360d7f8-d716-ee18-a1bc-9069cc23073e
msgctxt "h798f80eegdadeg406ag8154gaa7dd4f4421b"
msgid "Kagha is dead. She was swayed by Shadow Druids. I had no choice."
msgstr "카그하는 죽었습니다. 그녀는 그림자 드루이드에게 현혹되었더군요. 저에겐 선택의 여지가 없었습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns
#. Speaker = Halsin
#. NodeID = f4981c3a-473b-7b5b-8f30-0ed30cb1f988
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HalsinReturns:f4981c3a-473b-7b5b-8f30-0ed30cb1f988
msgctxt "hc1a0b4d7g075bg4a6cga1b3gb5417f61b93c"
msgid "How is this possible...?"
msgstr "어떻게 이런 일이...?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HarpyKid
#. Speaker = Mirkon
#. NodeID = 04332b40-cb5f-2524-bb13-f1683a8a5ffc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Kid003(1) = True
#.   Global:
#.      - DEN_TieflingBard_State_Unavailable = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HarpyKid:04332b40-cb5f-2524-bb13-f1683a8a5ffc
msgctxt "h12bb0f83gd727g4783g892fge1265613866b"
msgid "Shh - you need to listen or go away."
msgstr "쉿, 안 들을 거면 저리 가세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HarpyKid
#. Speaker = Mirkon
#. NodeID = 19b566c0-38b4-5fd3-54a6-99d2f0bd081e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Kid003(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HarpyKid:19b566c0-38b4-5fd3-54a6-99d2f0bd081e
msgctxt "h1a684c0cg63c5g478cg9bfcg3cc2ee7316fe"
msgid "Shh - you have to <i>listen </i>to the story."
msgstr "쉿 - 이야기부터 <i>들어야</i> 해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HarpyKid
#. Speaker = Player
#. NodeID = 217c79d4-6288-803a-b8e6-5c19689ad63d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HarpyKid:217c79d4-6288-803a-b8e6-5c19689ad63d
msgctxt "he6f515e1g8537g4684g8c80g411b44d079b0"
msgid "Who is this 'Baldy Ron'?"
msgstr "'발디 론'이 누구지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HarpyKid
#. Speaker = Player
#. NodeID = 26cd298d-e88a-1071-bfdd-b98428f67f31
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HarpyKid:26cd298d-e88a-1071-bfdd-b98428f67f31
msgctxt "h644a00f8g58ddg44a1gac43ge8c5e490c1bc"
msgid "For all I know, I might actually <i>be </i>Baldy Ron."
msgstr "아마도, 내가 실제로 발디 론<i>일지도</i> 모르지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HarpyKid
#. Speaker = Mirkon
#. NodeID = 27ee4ced-b5e7-2737-5d40-4925ba8a85b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HarpyKid:27ee4ced-b5e7-2737-5d40-4925ba8a85b4
msgctxt "hd9aa69bbg5496g428eg8b44g2d3a0e50edac"
msgid ""
"But... didn't you kill those goblins at the gate? You can win. I know you "
"can!"
msgstr "하지만... 당신은 성문 앞에서 그 고블린들을 죽였잖아요? 당신은 해낼 수 있어요. 난 알아요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HarpyKid
#. Speaker = Mirkon
#. NodeID = 307ca725-134b-46ed-f3aa-a19b49582952
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HarpyKid:307ca725-134b-46ed-f3aa-a19b49582952
msgctxt "hf8f26ffeg9bb6g48dfg8bccg8b1bf3be5953"
msgid "He did? I wonder what he found..."
msgstr "그래요? 그 아저씨가 뭘 발견했을지 궁금해지네요..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HarpyKid
#. Speaker = Mirkon
#. NodeID = 339c93e4-6dd8-ab42-2c0b-2097144068a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HarpyKid:339c93e4-6dd8-ab42-2c0b-2097144068a3
msgctxt "hb60ac228g695cg486egbd2bgee800cc39fe6"
msgid ""
"What's a founder? The lady said he saved Baldur's Gate and became a hero!"
msgstr "창립자가 뭔데요? 그 누나가 말하길 발디 론은 발더스 게이트를 구하고 영웅이 되었다던걸요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HarpyKid
#. Speaker = Mirkon
#. NodeID = 349d6182-80b7-da84-5de9-fe0fe2401b8e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingBard_State_Unavailable = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Kid003(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HarpyKid:349d6182-80b7-da84-5de9-fe0fe2401b8e
msgctxt "h6242a991gb8e2g4082gb4fagb2803947cf70"
msgid "I'm telling a story - it's rude to interrupt."
msgstr "지금 이야기 중이잖아 - 무례하게 끼어들지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HarpyKid
#. Speaker = Mirkon
#. NodeID = 38c3b899-56c4-c664-62ce-f705148366ba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HarpyKid:38c3b899-56c4-c664-62ce-f705148366ba
msgctxt "h2ebaf46eg2680g4e8bg9e62g2bb43e4c2aad"
msgid "He saved Baldur's Gate and became a hero!"
msgstr "그는 발더스 게이트를 구하고 영웅이 되었답니다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HarpyKid
#. Speaker = Mirkon
#. NodeID = 4228f4c6-619b-abc2-496a-cf1f31712ecd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HarpyKid:4228f4c6-619b-abc2-496a-cf1f31712ecd
msgctxt "ha40afe6eg9aafg40c7gb5cfg48b98ac9c1f1"
msgid ""
"But... you can win. Goblins aren't as strong as bird women, right? They "
"can't even <i>fly</i>."
msgstr ""
"그래도... 이길 수 있잖아요. 고블린들은 날개 달린 여인들만큼 강하지 않은걸요, 그렇죠? 걔네는 <i>날지도</i> 못한다고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HarpyKid
#. Speaker = Mirkon
#. NodeID = 4e08775a-fc98-962e-67ba-47e98ff9ec89
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HarpyKid:4e08775a-fc98-962e-67ba-47e98ff9ec89
msgctxt "hb32d3f40g40e2g433ega96dgc6d6fcb8099e"
msgid "From the lady's <i>story.</i>"
msgstr "그 바드 누나가 들려주는 <i>이야기</i>에 나오잖아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HarpyKid
#. Speaker = Player
#. NodeID = 5680887b-25d8-769b-ff5d-bf88557f4e95
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HarpyKid:5680887b-25d8-769b-ff5d-bf88557f4e95
msgctxt "h0f72e8ccg32bdg424cg87b4g93ab43f52805"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HarpyKid
#. Speaker = Player
#. NodeID = 58f889cf-172d-b1fd-58a8-11348c4eb7cf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_HarpyMeal_State_HelpedSaveVictim(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HarpyKid:58f889cf-172d-b1fd-58a8-11348c4eb7cf
msgctxt "hb65b575agc54bg41b6gb03cgc7545aafbac7"
msgid "You're not worth the trouble, kid. You're on your own."
msgstr "너 따위 꼬맹이를 위해 나서고 싶은 생각은 없어. 네 살 길은 알아서 찾도록."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HarpyKid
#. Speaker = Mirkon
#. NodeID = 5eb1717e-0061-aed1-e56a-2b65a7393f1d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HarpyKid:5eb1717e-0061-aed1-e56a-2b65a7393f1d
msgctxt "hb6dd93bcgb1fdg4466gb588gd0503690847b"
msgid "Good. And after, the lady can tell us stories about <i>you.</i>"
msgstr "좋아요. 어쩌면 바드 누나가 나중에 <i>당신</i> 이야기를 노래로 쓸지도 모르죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HarpyKid
#. Speaker = Player
#. NodeID = 7d2f6d6f-4b01-8e09-ee5d-5a21d090f1f7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HarpyKid:7d2f6d6f-4b01-8e09-ee5d-5a21d090f1f7
msgctxt "h7e4ff220gb5d5g4517g89b8g7e9b8700d10b"
msgid "That is exactly what I'm here for."
msgstr "그래, 정확히 그러려고 여기 왔단다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HarpyKid
#. Speaker = Mirkon
#. NodeID = 80659ee8-44db-6402-afb9-261377afe035
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_HarpyMeal_State_HelpedSaveVictim(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Kid003(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HarpyKid:80659ee8-44db-6402-afb9-261377afe035
msgctxt "hd688afbbg90a1g485eg8f77g44b3195b7c15"
msgid ""
"The Harpy Killer! Are you here to save us? Like Baldy Ron saved the city?"
msgstr "하피 살해자! 우릴 구하러 온 건가요? 발디 론이 도시를 구한 것처럼?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HarpyKid
#. Speaker = Player
#. NodeID = 82323e4c-703d-a5cc-2836-0d50162e9aa4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BALDURIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HarpyKid:82323e4c-703d-a5cc-2836-0d50162e9aa4
msgctxt "h88764194gd605g4d63g8f87g143190b350dc"
msgid "Do you mean <i>Balduran</i>, the legendary founder of Baldur's Gate?"
msgstr "<i>발더란</i>을 말하는 거니? 발더스 게이트를 건설한 전설적인 인물?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HarpyKid
#. Speaker = Mirkon
#. NodeID = 8aae62e0-7344-677f-02d9-cf8151be1a01
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Kid003(1) = True
#.   Global:
#.      - DEN_TieflingBard_State_Unavailable = True
#.   Object:
#.      - DEN_HarpyMeal_State_HelpedSaveVictim(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HarpyKid:8aae62e0-7344-677f-02d9-cf8151be1a01
msgctxt "h5a512066g3717g4546g8fbdg23e17c3890b3"
msgid "I told everyone you'll save us. I know you will."
msgstr "당신이 우릴 구해줄 거라고 장담했어요. 확신해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HarpyKid
#. Speaker = Mirkon
#. NodeID = 9c404345-7ee6-f023-9771-58b6156622ba
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Kid003(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HarpyKid:9c404345-7ee6-f023-9771-58b6156622ba
msgctxt "hcda3a9d0gbaddg47d0ga1dagdb6397043a45"
msgid "Are you here to save us? Like Baldy Ron saved the city?"
msgstr "우릴 구하러 온 건가요? 발디 론이 도시를 구한 것처럼?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HarpyKid
#. Speaker = Mirkon
#. NodeID = 9f0b5ffd-2a5c-08df-03a6-432b30812005
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Kid003Victory(1) = True
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HarpyKid:9f0b5ffd-2a5c-08df-03a6-432b30812005
msgctxt "h6877bc5fg95bfg49e0g9ac0g371342ce6ae1"
msgid "I hope we get to leave soon. I'm tired of living in a cave."
msgstr "어서 떠났으면 좋겠어요. 동굴 안에서 사는 건 이제 질렸거든요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HarpyKid
#. Speaker = Player
#. NodeID = a66bd633-c15b-ce8d-0750-0b8f61676932
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HarpyKid:a66bd633-c15b-ce8d-0750-0b8f61676932
msgctxt "ha4edb0a1g0ccdg43f4ga2fdg0a067769c632"
msgid "You mean <i>Balduran</i>. He sailed to the edge of the world."
msgstr "<i>발더란</i> 말이로군. 세상의 끝까지 항해했다는."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HarpyKid
#. Speaker = Mirkon
#. NodeID = b185b25b-f2b3-1246-f97d-5cf98b23c21a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Kid003Victory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HarpyKid:b185b25b-f2b3-1246-f97d-5cf98b23c21a
msgctxt "hb3d79738g5c93g4c28g966cg0f0237305b55"
msgid "You saved us! Just like Baldy Ron."
msgstr "당신이 우릴 구했어요! 발디 론처럼요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HarpyKid
#. Speaker = Player
#. NodeID = e1ed5f9b-a053-8755-e9b9-b5634e6d7f4c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_HarpyMeal_State_HelpedSaveVictim(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_HarpyKid:e1ed5f9b-a053-8755-e9b9-b5634e6d7f4c
msgctxt "hc8d68559g62d4g4b9dg9748g75fff74455b0"
msgid "I risked my life for you once. I'm not planning to do it again."
msgstr "이미 한 번 널 위해 목숨을 걸었잖니. 다신 그러지 않을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Kid004
#. Speaker = Zaki
#. NodeID = 00363bd3-4a16-1c2d-73ed-fb477818ec87
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Kid004Victory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Kid004:00363bd3-4a16-1c2d-73ed-fb477818ec87
msgctxt "h7575d50eg83fcg45f0g8eb9g34a14f25a177"
msgid "It smells bad out here. I want to go home."
msgstr "이곳은 악취를 풍겨요. 집에 가고 싶어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Kid004
#. Speaker = Zaki
#. NodeID = 3d97e252-21f3-ffb4-8d20-28a2bbadce51
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_NoStoryteller = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Kid004(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Kid004:3d97e252-21f3-ffb4-8d20-28a2bbadce51
msgctxt "hd9b39937gc697g4995gb448g0e7e4cfab547"
msgid "You know how to fight, right? You should be out there, helping!"
msgstr "당신은 싸울 줄 알잖아요, 맞죠? 그럼 빨리 나가서 도와야죠!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Kid004
#. Speaker = Zaki
#. NodeID = 8d95e2c9-de72-e8c5-1b36-553c6b988ee1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Kid004(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Kid004:8d95e2c9-de72-e8c5-1b36-553c6b988ee1
msgctxt "h67c7815cg96d1g4633g9986g3355f0de72f6"
msgid "Sssh, she's getting to the good part!"
msgstr "쉿, 절정 부분이 코앞이라고요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Kid004
#. Speaker = Zaki
#. NodeID = b2d41c49-3358-1c61-666b-92ddf5c63be0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Kid004(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Kid004:b2d41c49-3358-1c61-666b-92ddf5c63be0
msgctxt "h84c222cfgc4d4g4bbeg822cge67a117d81c2"
msgid "Hush! I'm trying to listen!"
msgstr "쉿! 감상 중이잖아요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Kid004
#. Speaker = Zaki
#. NodeID = ec5743c2-8c0a-7967-85bd-87d7a2c62611
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Kid004Victory(1) = True
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Kid004:ec5743c2-8c0a-7967-85bd-87d7a2c62611
msgctxt "ha402d447g39e7g4cb5g8faeg704ad1128be0"
msgid "You're lucky - you can go wherever you want."
msgstr "부럽네요. 어디든 가고 싶은 곳으로 갈 수 있다니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Kid004
#. Speaker = Zaki
#. NodeID = fe206894-9490-2528-fc08-737b12c3a21d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Kid004(1) = True
#.   Global:
#.      - DEN_AttackOnDen_State_NoStoryteller = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Kid004:fe206894-9490-2528-fc08-737b12c3a21d
msgctxt "h18bcb8a1g2c5cg4f0dg9a2dg9f2a7d7f7579"
msgid "You look all tough, but you're still in here, hiding with us children."
msgstr "겉보기만 강력할 뿐, 당신 꼴을 좀 보세요. 아이들과 함께 숨어서는."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LairDoor
#. Speaker = Player
#. NodeID = 00e399dd-273b-c575-ceb9-f265d2dc1f22
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LairDoor:00e399dd-273b-c575-ceb9-f265d2dc1f22
msgctxt "he7db135dg7f57g49d2g860cg8186e9cace28"
msgid "Go rejoin the others, kid."
msgstr "가서 어른들을 찾거라, 어서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LairDoor
#. Speaker = Player
#. NodeID = 255a6bfe-330c-a41c-b6e3-461e3ce75841
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LairDoor:255a6bfe-330c-a41c-b6e3-461e3ce75841
msgctxt "h143c0caega225g473dgaf50ge859dcdb6190"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LairDoor
#. Speaker = Doni
#. NodeID = 33bdcc76-ba0b-f891-c011-2cc5c62196cc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LairDoor:33bdcc76-ba0b-f891-c011-2cc5c62196cc
msgctxt "h5bdfd4bcg7136g463fgb80ag0efe16b6e85d"
msgid "*Grunt.*"
msgstr "*끙.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LairDoor
#. Speaker = Stone Door
#. NodeID = 3defa4b0-c5dd-b036-ba50-0851ccdea554
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_AttackOnDen_Event_TryConvinceLairDoor(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LairDoor:3defa4b0-c5dd-b036-ba50-0851ccdea554
msgctxt "h600f81cag1e8ag4346gb876g2069f397b355"
msgid "This door is staying shut - just be sensible and leave!"
msgstr "이 문은 열지 않을 것이오. 알아들었으면 떠나시오!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LairDoor
#. Speaker = Player
#. NodeID = 6c28e459-c252-7b6e-f926-137d2eac6518
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_Knows_WhyDoorIsClosed = True
#. SetFlags:
#.   Object:
#.     - DEN_AttackOnDen_Event_TryConvinceLairDoor(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LairDoor:6c28e459-c252-7b6e-f926-137d2eac6518
msgctxt "hf9b18614ga670g4a8aga30cg237d07a83102"
msgid "Come on now, open up! There's people out here who need shelter."
msgstr "어서, 이 문 열어! 피난처가 필요한 사람들이 있다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LairDoor
#. Speaker = Stone Door
#. NodeID = 8885740a-fc64-3a83-01ff-0c8bb485eb11
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LairDoor:8885740a-fc64-3a83-01ff-0c8bb485eb11
msgctxt "h21c42cf9gec95g4aa1gbd85g633d86c085b0"
msgid "There's no shame in ensuring the sanctity of this grove. Now leave!"
msgstr "숲의 신성한 의무를 다함에 있어 부끄러움은 없소. 얼른 떠나시오!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LairDoor
#. Speaker = Stone Door
#. NodeID = 8fd99667-67af-cdd7-b78f-7cd83510d137
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LairDoor:8fd99667-67af-cdd7-b78f-7cd83510d137
msgctxt "h12df557dg16abg4f56gbe69g2b549ab263b7"
msgid ""
"We've been more than generous already! We have to take care of the grove's "
"future."
msgstr "우리 드루이드들은 이미 아낌없이 베풀었소! 이제 숲의 미래를 살필 때요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LairDoor
#. Speaker = Stone Door
#. NodeID = 92032ba0-f264-857c-05a0-8a36f7e4fdc6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LairDoor:92032ba0-f264-857c-05a0-8a36f7e4fdc6
msgctxt "h7d6c196agae26g4b85ga995g94fc2f99c0ba"
msgid ""
"I said <i>go away</i>. You people have endangered this sacred place long "
"enough."
msgstr "<i>저리 꺼지라고</i> 했소. 당신네들은 이미 충분히 숲을 위험에 빠뜨려 왔소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LairDoor
#. Speaker = Stone Door
#. NodeID = 996dc0a6-ac38-36e2-8a0a-011defc835bd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LairDoor:996dc0a6-ac38-36e2-8a0a-011defc835bd
msgctxt "h84829e86g72d6g42a8gbab3g273d9b7e0a42"
msgid "<i>Move away. </i>"
msgstr "<i>저리 가시오. </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LairDoor
#. Speaker = Player
#. NodeID = a67abc8a-33a8-e809-b008-6838e496cc29
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_Knows_WhyDoorIsClosed = False
#. SetFlags:
#.   Global:
#.     - DEN_AttackOnDen_Knows_WhyDoorIsClosed = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LairDoor:a67abc8a-33a8-e809-b008-6838e496cc29
msgctxt "he6f779c0g8648g43a4g91d8g75764d4cd60d"
msgid "What's going on here?"
msgstr "무슨 일이죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LairDoor
#. Speaker = Player
#. NodeID = af106641-0f4e-cf9a-4db4-f263ad03e593
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_Knows_WhyDoorIsClosed = True
#.   Tag:
#.      - DRUID(1) = True
#. SetFlags:
#.   Object:
#.     - DEN_AttackOnDen_Event_TryConvinceLairDoor(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LairDoor:af106641-0f4e-cf9a-4db4-f263ad03e593
msgctxt "h6685464eg5469g46cdg97b6g4d48f3e2dffe"
msgid "You're a disgrace to this sacred grove. You should wither with shame."
msgstr "너는 이 신성한 숲의 망신이다. 수치를 안고 시들어버려야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LairDoor
#. Speaker = Player
#. NodeID = b570ac0d-8ce9-bfbd-97ae-24c01d0c20f3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_Knows_WhyDoorIsClosed = True
#. SetFlags:
#.   Object:
#.     - DEN_AttackOnDen_Event_TryConvinceLairDoor(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LairDoor:b570ac0d-8ce9-bfbd-97ae-24c01d0c20f3
msgctxt "h2c114044g6139g4f96g9359g4175c845f525"
msgid "Coward. Innocents are going to die, thanks to you."
msgstr "겁쟁이 녀석. 무고한 사람들이 죽을 거다. 네 덕분에."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LairDoor
#. Speaker = Doni
#. NodeID = ce9c3c0d-171e-9b38-e2de-e94cbf1598c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LairDoor:ce9c3c0d-171e-9b38-e2de-e94cbf1598c0
msgctxt "h1530c0b8g9089g4becg994ag3d1445a1148a"
msgid "*Grunt.*"
msgstr "*끙.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LairDoor
#. Speaker = Stone Door
#. NodeID = d440b6de-fbe8-d67d-07dd-ce988ffc1ff2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_LairDoor(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LairDoor:d440b6de-fbe8-d67d-07dd-ce988ffc1ff2
msgctxt "hbbd7a0e3gcb35g4edcg8d43g9d0fd37cb35e"
msgid "You people have endangered the grove for long enough. Go away!"
msgstr "당신네들은 이미 충분히 이 숲을 위험에 빠뜨려 왔소. 저리 가시오!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LairDoor
#. Speaker = Stone Door
#. NodeID = d579a3de-613c-7485-cf5e-becf0f789b01
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LairDoor:d579a3de-613c-7485-cf5e-becf0f789b01
msgctxt "h2ac13b65g4dcfg46e0g8830gc3fd78a70eb8"
msgid "Then this sacred grove can be a comfort to them in their final moments."
msgstr "그럼 이 신성한 숲이 최소한 마지막 순간만은 지켜봐 주겠구려."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LairDoor
#. Speaker = Doni
#. NodeID = d69ca0ee-61bb-4f12-0beb-13916b00e031
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_LairDoor(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LairDoor:d69ca0ee-61bb-4f12-0beb-13916b00e031
msgctxt "ha1bcd418ge3cdg4fa5g84acga7561fabff69"
msgid "*Grunt.*"
msgstr "*끙.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LairDoor
#. Speaker = Stone Door
#. NodeID = d7438911-690f-8cdd-e400-ab9416091645
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LairDoor:d7438911-690f-8cdd-e400-ab9416091645
msgctxt "h18572f33g836cg42b0gb280g68b8503562b6"
msgid "This door is staying closed until you're gone, one way or another."
msgstr "이 문은 절대로 열리지 않을 것이오. 당신들이 떠날 때까지 말이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LairDoor
#. Speaker = Stone Door
#. NodeID = da7e18ff-df26-b077-0b92-6cb112ce87bd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LairDoor:da7e18ff-df26-b077-0b92-6cb112ce87bd
msgctxt "h4cb75cc9g54e3g4726g9a19gfb5a2ed8eb5d"
msgid "Go away! There's nothing in here for you - for <i>any </i>of you."
msgstr "저리 가시오! 당신네들에게 내줄 자리는 없소. <i>한 자리도</i> 말이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LairDoor
#. Speaker = Stone Door
#. NodeID = e5d7fc32-0aab-2634-8a17-be2a50f8e05a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LairDoor:e5d7fc32-0aab-2634-8a17-be2a50f8e05a
msgctxt "hcd179fa8g471fg4847g9bfcg9445d971ec4e"
msgid "But this door is staying closed. Now leave!"
msgstr "허나 이 문은 절대로 열지 않을 것이오. 그러니 가시오!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LairDoor
#. Speaker = Stone Door
#. NodeID = ee0c85d3-3035-3de7-22f7-7b199da36221
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_LairDoor(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LairDoor:ee0c85d3-3035-3de7-22f7-7b199da36221
msgctxt "h791a6d09g3738g45bega4beg62529d087b04"
msgid "You're wasting your time. This door is staying shut."
msgstr "시간만 낭비하는군. 이 문은 열지 않을 것이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LairDoor
#. Speaker = Player
#. NodeID = fe17dfbe-f71b-3445-d2fd-f63a624c61d2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LairDoor:fe17dfbe-f71b-3445-d2fd-f63a624c61d2
msgctxt "ha0263ce5gb7a7g4b32g9093ge2437f93c978"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid
#. Speaker = Mol
#. NodeID = 08bbab89-349d-cb8d-0a69-576d26d5b5bc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid:08bbab89-349d-cb8d-0a69-576d26d5b5bc
msgctxt "hac05a651g84bfg4449gabbag6af3dc3d3348"
msgid ""
"The singer keeps telling us that if we're good and quiet, we'll all be safe."
msgstr "그 가수는 맨날 만일 우리 보고 착하고 조용하게 지내면 모두 안전할 거라고 하던데"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid
#. Speaker = Player
#. NodeID = 1582a650-8a53-05cd-bb08-86a8f9259bd2
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_AgreedStealIdol = True
#.      - DEN_Thieflings_Event_RefusedGiveIdol = False
#.      - DEN_Thieflings_Event_GaveMolIdol = False
#.   Object:
#.      - DEN_Thieflings_State_HasIdol(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid:1582a650-8a53-05cd-bb08-86a8f9259bd2
msgctxt "hc6ea67a5gbfc7g4fd1g8febg8be8690458e1"
msgid "I couldn't get the idol you asked about."
msgstr "네가 얘기한 신상을 못 가져왔어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid
#. Speaker = Mol
#. NodeID = 16969fa9-814b-b09a-24fd-9a10fb4ec443
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid:16969fa9-814b-b09a-24fd-9a10fb4ec443
msgctxt "hcc50e4c2g5b89g4392g9919gd48c16a999e2"
msgid "Just another fairy tale though, isn't it?"
msgstr "그저 또 다른 동화일 뿐이야, 그렇지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid
#. Speaker = Mol
#. NodeID = 29b01c18-bfb8-9994-bce9-5a2bfa59f2b0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingLeader_State_PermaDefeated = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid:29b01c18-bfb8-9994-bce9-5a2bfa59f2b0
msgctxt "h0a24e35fg5da6g4526g9117gdd6d01cbc2c9"
msgid ""
"Take it up with Asharak. Apparently I'm 'too young' to fight on the wall."
msgstr "아샤락과 얘기해. 나는 장벽에서 싸우기엔 명백하게도 '너무 어리니까' 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid
#. Speaker = Mol
#. NodeID = 29d32d9e-1cfe-c550-f74f-a80db9c7bb7e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_LeaderKidVictory(1) = True
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid:29d32d9e-1cfe-c550-f74f-a80db9c7bb7e
msgctxt "h63d39d7cgd598g4f7egb710gf5596fd4a98f"
msgid "What? I've said thank you. Should I write you a poem, too?"
msgstr "뭐 또? 고맙다고 했잖아. 시라도 써주랴?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid
#. Speaker = Mol
#. NodeID = 382445c5-e673-f06a-67a5-cf1d3b59d7b7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid:382445c5-e673-f06a-67a5-cf1d3b59d7b7
msgctxt "h6498046bg6035g44c5gb799g44ffebc95ffa"
msgid "Always a deal to be done - even now."
msgstr "거래는 어딜 가나 이루어지는 법이지 - 이런 상황에서도."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid
#. Speaker = Mol
#. NodeID = 40910f88-1a4f-01c4-427c-86f650d800c3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid:40910f88-1a4f-01c4-427c-86f650d800c3
msgctxt "h3ccd56a6g5995g44dbg8de2g1cb09167d797"
msgid "You're a terrible liar. We had a deal."
msgstr "거짓말인 거 다 알아. 우린 거래하기로 약속했잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid
#. Speaker = Player
#. NodeID = 427db533-de94-82f8-5d2c-d93e27166d00
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Thieflings_State_HasIdol(1) = True
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Event_GaveMolIdol = True
#.   Object:
#.     - DEN_Thieflings_Event_TransferIdol(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid:427db533-de94-82f8-5d2c-d93e27166d00
msgctxt "h6089e148g350ag40d6g9c5ag306078068535"
msgid "Fine. Take it."
msgstr "괜찮아. 이거 받아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid
#. Speaker = Mol
#. NodeID = 47a19685-9e48-630a-8fb2-8f5874af07ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid:47a19685-9e48-630a-8fb2-8f5874af07ae
msgctxt "h40965b67g239cg43ccga56cg9753fec92f0e"
msgid ""
"If you honestly believe that, maybe it's best you hide down here with the "
"other children."
msgstr "그 말을 진짜 믿는 거면 너도 다른 애들이랑 함께 숨는 게 낫겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid
#. Speaker = Mol
#. NodeID = 4a8ff81c-a35d-50a5-7f29-0e41a08854b8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_GaveMolIdol = True
#.   Object:
#.      - DEN_Thieflings_State_HasIdol(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid:4a8ff81c-a35d-50a5-7f29-0e41a08854b8
msgctxt "hfcd5f519g4184g47d2ga071g5ca3acb7e266"
msgid "If any of your stuff goes missing, just let me know. You're family now."
msgstr "혹시 물건이 없어지거나 하면, 바로 말해줘. 넌 이제 가족이니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid
#. Speaker = Mol
#. NodeID = 4d28063f-54ea-aee5-7f63-dae3c15ae310
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Hideout_Event_BefriendedThieflings = False
#.     - DEN_Thieflings_Event_RefusedGiveIdol = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid:4d28063f-54ea-aee5-7f63-dae3c15ae310
msgctxt "h2e419a9bg4f46g4258gb15dgd17bdcf856bc"
msgid "Sounds more like a challenge than advice. Keep an eye on your pack."
msgstr "조언보다는 참견같이 들리는데. 배낭 잘 간수하라구."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid
#. Speaker = Mol
#. NodeID = 5a2146a7-74e9-7beb-1b67-1c9452dfab31
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid:5a2146a7-74e9-7beb-1b67-1c9452dfab31
msgctxt "hbb77361eg675dg42cag9c70g4f0b2a3a7e99"
msgid ""
"Listening to stories - I think you're a little old for them. Or are you "
"looking for a place to hide when the end comes?"
msgstr "옛날 이야기를 들을 나이는 아니지 않아? 아니면 종말이 오면 숨을 곳을 찾는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid
#. Speaker = Mol
#. NodeID = 6012c8f0-acf6-ef36-b865-b9f763976eeb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid:6012c8f0-acf6-ef36-b865-b9f763976eeb
msgctxt "h3b5ab665g3c8cg4f73gb6f4gb5c5bfdfab40"
msgid ""
"Brave words when you're hiding down here with the rest of us. Listening to "
"stories and waiting for the end like the rest of the children?"
msgstr "우리랑 같이 여기 숨어 있는 주제에 퍽이나 용감한 말이네. 다른 애들처럼 이야기나 들으면서 최후를 기다리려는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid
#. Speaker = Mol
#. NodeID = 61535971-c893-209f-a3b1-6fe12a3a49c6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_LeaderKid(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid:61535971-c893-209f-a3b1-6fe12a3a49c6
msgctxt "hda77f186g8fadg4a45g8a45gd7ade4aa34c3"
msgid "Zaki told me about you, toad-lady. Your kind scared Zorru real bad."
msgstr "자키가 당신에 대해 말해줬어, 두꺼비 아가씨. 당신의 친절이 조르를 진짜 겁먹게 했더군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid
#. Speaker = Mol
#. NodeID = 6650a903-1553-49a5-9037-37990b2c4f84
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Hideout_Event_BefriendedThieflings = False
#.     - DEN_Thieflings_Event_RefusedGiveIdol = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid:6650a903-1553-49a5-9037-37990b2c4f84
msgctxt "h6be14461g1bf4g4fd4ga838g43386d1d6930"
msgid "Fine. Hope the damn thing's cursed."
msgstr "좋아. 그 망할 물건에 저주나 깃들라지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid
#. Speaker = Player
#. NodeID = 69e3ec99-ad0f-ff6f-ed17-5a50857821ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid:69e3ec99-ad0f-ff6f-ed17-5a50857821ec
msgctxt "he74a0d47g6d3cg4b60gb751g27e0d46b2958"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid
#. Speaker = Mol
#. NodeID = 767fb063-e93d-33d1-b027-d47ecc4d8445
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_LeaderKidVictory(1) = True
#.   Global:
#.      - DEN_Refugees_State_LeadersAreDead = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid:767fb063-e93d-33d1-b027-d47ecc4d8445
msgctxt "haecaf6eeg17ccg4bd0g8c4agf978447e58d8"
msgid "Yes? I've got places to be - I'm sure you do, too."
msgstr "뭐야? 난 가야 할 곳이 많아 - 너도 그럴 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid
#. Speaker = Mol
#. NodeID = 7754e7fa-205a-6a8e-c0cf-75fe212e5138
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_LeaderKid(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid:7754e7fa-205a-6a8e-c0cf-75fe212e5138
msgctxt "hf04f6cc5gbfbbg4085ga565gba162ee2c38b"
msgid ""
"You're a little old for story-time. Looking for a place to hide when the end "
"comes?"
msgstr "옛날 이야기 들을 나이는 아니지 않아? 아니면 종말을 대비해 숨을 곳을 찾는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid
#. Speaker = Mol
#. NodeID = 7ab249a1-bee4-67ea-c5a1-eb94d098a0d8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_NoStoryteller = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_LeaderKid(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid:7ab249a1-bee4-67ea-c5a1-eb94d098a0d8
msgctxt "h4b580a51ga94fg456dgbd63ge8f63b0f4e9d"
msgid ""
"Come to say your goodbyes before the end comes? Wish I could fight with you."
msgstr "종말이 오기 전에 작별인사하러 왔어? 나도 너랑 같이 싸울 수 있으면 좋겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid
#. Speaker = Mol
#. NodeID = 8fa25b55-930a-cbfb-63cb-13cf8d167bd6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingBard_State_Unavailable = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid:8fa25b55-930a-cbfb-63cb-13cf8d167bd6
msgctxt "h11ef6717ga432g4f01gb3aag85b7eda6137f"
msgid ""
"Mirkon keeps telling the other kids they'll all be safe if they stay hidden."
msgstr "미르콘이 다른 아이들에게 계속 숨어만 있으면 모두 안전할 거라고 말해주고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid
#. Speaker = Mol
#. NodeID = 9773c30c-8e28-1af6-9e66-56b9ce29e1b5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid:9773c30c-8e28-1af6-9e66-56b9ce29e1b5
msgctxt "h286ae635g8693g4e93gbecegeba2ffd88ee4"
msgid "Doesn't matter. The fight will come to us, no matter what he says."
msgstr "상관없어. 그가 뭐라 하든 우린 결국 싸우게 될 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid
#. Speaker = Player
#. NodeID = 9ab030d5-b4b4-09d8-911a-f52fb317f2a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid:9ab030d5-b4b4-09d8-911a-f52fb317f2a5
msgctxt "h3326e559g16a8g4a57g8f38gf666fbe06dd0"
msgid "The end's not coming today. I promise."
msgstr "종말이 오늘 닥치지는 않을 거야. 약속해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid
#. Speaker = Mol
#. NodeID = 9ea0e17b-23ee-44a6-e305-4e85f1fc6b4f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_GaveMolIdol = True
#.   Object:
#.      - DEN_Thieflings_State_HasIdol(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid:9ea0e17b-23ee-44a6-e305-4e85f1fc6b4f
msgctxt "hc9fac03eg458ag4c40g922dg87684ef6a46e"
msgid "Somebody stole the idol. If I find out who it was... I'll recruit 'em."
msgstr "누군가 우상을 훔친 거야. 누구였는지 알아내면... 걔네들을 고용할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid
#. Speaker = Mol
#. NodeID = 9ef6fd49-82de-2cdf-0747-6c7e335590dd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_LeaderKid(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid:9ef6fd49-82de-2cdf-0747-6c7e335590dd
msgctxt "h112f21d8ga998g4a33ga28bga3023746a9a3"
msgid "Still here? The smart ones ran a long while back."
msgstr "아직 여기 있나? 똑똑한 녀석들은 이미 한참 전에 도망갔는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid
#. Speaker = Mol
#. NodeID = bcf69e6f-9a93-d2bd-6c6d-1d5022c7092c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingLeader_State_PermaDefeated = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid:bcf69e6f-9a93-d2bd-6c6d-1d5022c7092c
msgctxt "hd53aff94g571bg44b7gbe7cg4703d1cc1640"
msgid ""
"Take it up with Zevlor. Apparently I'm 'too young' to fight on the wall."
msgstr "제블로어한테 말해봐. 내가 벽 위에서 싸우기엔 '너무 어리다'고 하잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid
#. Speaker = Player
#. NodeID = be1d7c63-473d-f6a8-8f7e-5a32cae90b66
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid:be1d7c63-473d-f6a8-8f7e-5a32cae90b66
msgctxt "h526a1f31ge26eg4747g9340g304dea2c7a4e"
msgid "I'm looking to trade."
msgstr "거래를 하고 싶은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid
#. Speaker = Mol
#. NodeID = c5680bdd-b968-ea95-4a51-bcd96a694150
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Hideout_Event_BefriendedThieflings = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid:c5680bdd-b968-ea95-4a51-bcd96a694150
msgctxt "hfb5abc6ega060g45a3g88b4g8b6ede8eda5d"
msgid ""
"Thanks. See you in Baldur's Gate, I hope. Now scram, before I get emotional."
msgstr "고마워. 발더스 게이트에서 보면 좋겠네. 이제 꺼져, 감정적으로 되기 전에."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid
#. Speaker = Mol
#. NodeID = c929942b-9c1b-c1ab-f01c-b672aacde7b5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid:c929942b-9c1b-c1ab-f01c-b672aacde7b5
msgctxt "hc6dab929g7191g4ab8gb96dgde5d28224a1c"
msgid "But... I'm glad you did."
msgstr "그치만... 잘 왔어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid
#. Speaker = Player
#. NodeID = cb1f8112-f67f-59f2-a473-83d607d49bc1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_AgreedStealIdol = True
#.      - DEN_Thieflings_Event_RefusedGiveIdol = False
#.      - DEN_Thieflings_Event_GaveMolIdol = False
#.   Object:
#.      - DEN_Thieflings_State_HasIdol(1) = True
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Event_GaveMolIdol = True
#.   Object:
#.     - DEN_Thieflings_Event_TransferIdol(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid:cb1f8112-f67f-59f2-a473-83d607d49bc1
msgctxt "he1141b57g1db9g4a36ga593gf85346410d25"
msgid "Here - the idol you wanted."
msgstr "여기 - 네가 갖고 싶어한 조각상이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid
#. Speaker = Mol
#. NodeID = d3d3c418-2a46-0ae4-d6ac-5794dbe98a42
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_LeaderKidVictory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid:d3d3c418-2a46-0ae4-d6ac-5794dbe98a42
msgctxt "h721abae7gbd0fg498fgbc75gdd9586b6f9ec"
msgid "You were stupid to come back."
msgstr "돌아오다니 어리석군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid
#. Speaker = Player
#. NodeID = d5241f45-d25d-2a94-9d26-3b8d1d7e7784
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid:d5241f45-d25d-2a94-9d26-3b8d1d7e7784
msgctxt "hcf6b14e0g4268g49e2g8d69gaa1331b5b5e8"
msgid "Are you any good with those knives? We need every blade."
msgstr "혹시 칼을 잘 다루나? 칼 쓸 수 있는 사람은 모두 필요해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid
#. Speaker = Mol
#. NodeID = e223b6b7-017e-b3d0-9e30-185cd102ea99
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid:e223b6b7-017e-b3d0-9e30-185cd102ea99
msgctxt "h8658c5b4g4662g4d8dg948dgb86d542609e6"
msgid "Try not to die up there."
msgstr "죽지는 말라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid
#. Speaker = Player
#. NodeID = e463876a-27aa-91de-d039-43df8e214660
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid:e463876a-27aa-91de-d039-43df8e214660
msgctxt "h63430248gf672g4466g8ab4g55db111825bf"
msgid ""
"You're never too old for stories. The plots just get a bit more... "
"complicated."
msgstr "이야기 들을 나이라고 정해진 건 없어. 줄거리가 그냥 조금... 복잡해지는 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid
#. Speaker = Mol
#. NodeID = e7781457-3c32-513c-55fc-755184307731
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Event_RefusedGiveIdol = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid:e7781457-3c32-513c-55fc-755184307731
msgctxt "h89d3c42cgb253g431bg82b2g1c81d0489dcb"
msgid "Damn it. Having that stashed away would have made life a lot easier."
msgstr "망할. 그걸 손에 넣었다면 삶이 좀 폈을 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid
#. Speaker = Player
#. NodeID = f18e7875-c341-bd43-be02-7915f969a611
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid:f18e7875-c341-bd43-be02-7915f969a611
msgctxt "hd32110bbg3652g4ff4ga5bcgee322ee828bf"
msgid "Your kind scare easily."
msgstr "너희 종족은 금방 놀라는구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid
#. Speaker = Player
#. NodeID = f8f7d0b4-c95b-7027-ebe8-59dec05e62bd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid:f8f7d0b4-c95b-7027-ebe8-59dec05e62bd
msgctxt "hac123a3cg6baeg42feg8d11gde6c18c95a44"
msgid "Quiet, hatchling. What are you doing down here?"
msgstr "닥쳐라, 햇병아리. 여기서 뭘 하고 있는 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid
#. Speaker = Player
#. NodeID = f993af34-569c-2e75-76f6-3de77ebd6920
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid:f993af34-569c-2e75-76f6-3de77ebd6920
msgctxt "h8cf689cdg22b5g49ddgaca3ge850f55086d5"
msgid "You look a little old for this yourself."
msgstr "이럴 나이는 지난 것 같아 보이는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid
#. Speaker = Player
#. NodeID = fab85a69-1037-20df-8472-eb854af49d9a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid:fab85a69-1037-20df-8472-eb854af49d9a
msgctxt "h39302e58g51cbg4d34g9158g0e66df27b305"
msgid "Tough - I'm keeping it."
msgstr "힘들겠군 - 내가 갖고 있겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid
#. Speaker = Player
#. NodeID = fb360cfb-5680-704a-ae05-e109d8b9d2c6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_AgreedStealIdol = True
#.      - DEN_Thieflings_Event_RefusedGiveIdol = False
#.      - DEN_Thieflings_Event_GaveMolIdol = False
#.   Object:
#.      - DEN_Thieflings_State_HasIdol(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid:fb360cfb-5680-704a-ae05-e109d8b9d2c6
msgctxt "hc7bd7d58g06fcg4668gbec2gda9273910d01"
msgid "I don't have the idol you were after."
msgstr "네가 찾던 조각상을 가지고 있지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid
#. Speaker = Player
#. NodeID = fb899dcc-3a8a-b700-c3a9-ca418d8983d4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ROGUE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid:fb899dcc-3a8a-b700-c3a9-ca418d8983d4
msgctxt "hf73616eage1b0g414dgbecag5d6e289cb0f0"
msgid "Some advice - if you want something, don't ask. Just take."
msgstr "충고 좀 할까 - 원하는 게 있으면, 달라고 하지 말고 그냥 가져 가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid
#. Speaker = Mol
#. NodeID = fc7c7c70-6fc0-87b1-4f37-7bc52ab5185c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Refugees_State_LeadersAreDead = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_LeaderKidVictory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LeaderKid:fc7c7c70-6fc0-87b1-4f37-7bc52ab5185c
msgctxt "h04db1abcga8afg4bd7g8f9egd3234ea7905a"
msgid ""
"You do good work. If you can handle more than goblins, might be I'll have "
"use of you in Baldur's Gate."
msgstr "일을 잘하는군. 고블린보다 더 한 것도 처리할 수 있다면 발더스 게이트에서도 쓸모가 있겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LockdownDrow
#. Speaker = Player
#. NodeID = 037491b2-85dd-e38f-0a4c-ea39543184e8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LockdownDrow:037491b2-85dd-e38f-0a4c-ea39543184e8
msgctxt "h36de1a4cg8a61g4984ga42eg01161afb6d89"
msgid ""
"An enchantment seals the gates - the druids are stronger than I expected."
msgstr "환혹계로 문이 봉인됐어. 드루이드가 생각보다 강한데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LockdownDrow
#. Speaker = Nightwarden Minthara
#. NodeID = 2939284f-d1de-e321-a646-fdda7acbacd1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LockdownDrow:2939284f-d1de-e321-a646-fdda7acbacd1
msgctxt "hfc737015g18b7g4ab0g831ag416513abbade"
msgid "Then you are worthless."
msgstr "그럼 넌 쓸모없군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LockdownDrow
#. Speaker = Nightwarden Minthara
#. NodeID = 2e54cc89-edb0-376e-7933-86635ebc4dc4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_DrowCommander_Event_ToldAboutLockdown = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LockdownDrow:2e54cc89-edb0-376e-7933-86635ebc4dc4
msgctxt "he64ac5c0g3e02g4451g9767g854943f6b3ab"
msgid ""
"The druids' enchantment is impassable. You should have killed them before "
"they sealed their grove."
msgstr "드루이드의 마법을 뚫는 건 불가능해. 놈들이 숲을 봉쇄하기 전에 모두 죽여 버렸어야 했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LockdownDrow
#. Speaker = Nightwarden Minthara
#. NodeID = 40042380-e9f1-a897-ed67-373978878386
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LockdownDrow:40042380-e9f1-a897-ed67-373978878386
msgctxt "hc0985042g6039g41d0ga82fg82185688993e"
msgid "And you are weaker than I hoped."
msgstr "그리고 넌 생각보다도 약하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LockdownDrow
#. Speaker = Player
#. NodeID = 52a63fd6-1848-d042-4525-db20e34d3263
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LockdownDrow:52a63fd6-1848-d042-4525-db20e34d3263
msgctxt "hc4480113g7c81g4ad1g87bfg885624ed7554"
msgid "I don't follow your orders."
msgstr "네 명령은 따르지 않을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LockdownDrow
#. Speaker = Nightwarden Minthara
#. NodeID = 592fd348-b1a4-d88d-f300-c4b222bbbba0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LockdownDrow:592fd348-b1a4-d88d-f300-c4b222bbbba0
msgctxt "hbc215f3dg4f11g4d7ag9875gd93f0b5f1c5d"
msgid "You are alive? Not for long."
msgstr "살아 있군? 곧 죽겠지만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LockdownDrow
#. Speaker = Player
#. NodeID = 5b9b3147-2f2f-ba93-c8a8-7817b7c80178
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LockdownDrow:5b9b3147-2f2f-ba93-c8a8-7817b7c80178
msgctxt "h77f03483g1de1g4ea0gb302g2831f05aa60b"
msgid "I'm sorry - what can I do to make this right?"
msgstr "미안해- 어떻게 만회할 수 있을까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LockdownDrow
#. Speaker = Player
#. NodeID = 5c038b18-ff33-4f1c-98b7-2d0afd0c0030
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LockdownDrow:5c038b18-ff33-4f1c-98b7-2d0afd0c0030
msgctxt "hc7739c9eg47c2g4799g9285g3b0283dfc8d9"
msgid ""
"You can't blame me for this - the druids' magic is stronger than I expected."
msgstr "나를 비난하진 마- 드루이드의 마법이 생각보다 강했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LockdownDrow
#. Speaker = Nightwarden Minthara
#. NodeID = 8aa943f4-2db4-b0d3-5560-b7211f55b78e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_DrowCommander_Event_ToldAboutDeaths = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LockdownDrow:8aa943f4-2db4-b0d3-5560-b7211f55b78e
msgctxt "h00bad12bg5683g4fc1ga33dgb035343f7f07"
msgid ""
"Your overeagerness to spill blood has led the inhabitants to cower behind "
"this enchantment."
msgstr "살육에 대한 네놈의 과욕이 이 겁쟁이들을 마법 뒤로 숨어버리게 만들었다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LockdownDrow
#. Speaker = Nightwarden Minthara
#. NodeID = 97a26c8f-c551-c788-cf68-6c44618231b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LockdownDrow:97a26c8f-c551-c788-cf68-6c44618231b3
msgctxt "ha112ad42gf305g40cegb1d7ga7b1ab59f62c"
msgid ""
"Your orders were to infiltrate this place so we could purge it together."
msgstr "우리가 함께 여기 있는 놈들을 제거할 수 있도록 침투 하는 게 네게 내린 명령 이었을 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LockdownDrow
#. Speaker = Nightwarden Minthara
#. NodeID = edc0da79-a98c-f2cf-9d87-7447f243e0a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LockdownDrow:edc0da79-a98c-f2cf-9d87-7447f243e0a3
msgctxt "h949179f2gfc79g493cga110g3b76a6fdc615"
msgid "Kill them!"
msgstr "놈들을 죽여라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LockdownDrow
#. Speaker = Nightwarden Minthara
#. NodeID = f385b1a3-1fb1-6ec8-cc1e-23c54d2fb06f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_LockdownDrow:f385b1a3-1fb1-6ec8-cc1e-23c54d2fb06f
msgctxt "h18b5a8a2g12acg4936g87d9g306b26541a8d"
msgid "Die <i>quickly</i>. I have squandered enough time on you already."
msgstr "빠르게 <i>죽어라</i>. 너한테는 이미 충분한 시간을 낭비했다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Melee_001
#. Speaker = Warrior Jawn
#. NodeID = 2dc773b5-1dc0-f7f1-46fe-43b3ae458af3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Melee_001:2dc773b5-1dc0-f7f1-46fe-43b3ae458af3
msgctxt "h0f4d4447g885ag4a1cgba95g4cdc5aeeddba"
msgid "<i>Kherek-nor!</i>"
msgstr "<i>케렉-노르!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Melee_001
#. Speaker = Warrior Jawn
#. NodeID = 5f0f438f-bffb-9cae-66e5-fb92b348bebf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_AttackOnDen_State_Victorious(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Melee_001:5f0f438f-bffb-9cae-66e5-fb92b348bebf
msgctxt "h860f4319ge3ecg4892gb5feg0fe9ffe4ed14"
msgid "Praise the Absolute!"
msgstr "절대자님을 찬양하라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_MindMeldAfterCombat
#. Speaker = Nightwarden Minthara
#. NodeID = 10ee87b6-d757-d685-db25-4535561edfa7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_CaveTieflingsDead = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_MindMeldAfterCombat:10ee87b6-d757-d685-db25-4535561edfa7
msgctxt "h83e9b19bg91e5g4550g897age5032d9b6b46"
msgid ""
"<i>The way is clear. Now we can cleanse this place completely. Kill "
"</i>everyone<i>.</i>"
msgstr "<i>길이 열렸군. 이제 이곳을 완전히 정화할 수 있겠어. 모두</i> 죽여라<i>.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_MindMeldAfterCombat
#. Speaker = Nightwarden Minthara
#. NodeID = 52d4c7f4-0f91-b300-1f54-460e7a0816d4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_General_State_GateOpened = False
#. SetFlags:
#.   Global:
#.     - DEN_AttackOnDen_Event_OpenGateAfterCombat = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_MindMeldAfterCombat:52d4c7f4-0f91-b300-1f54-460e7a0816d4
msgctxt "h6eec50e5gaf97g4dfbgb95fg0b8f3beef840"
msgid "<i>Open the gate.</i>"
msgstr "<i>문을 열어라.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_MindMeldAfterCombat
#. Speaker = Nightwarden Minthara
#. NodeID = a3eaa7e2-c945-dc80-8e32-1d535b0f0f68
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_CaveTieflingsDead = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_MindMeldAfterCombat:a3eaa7e2-c945-dc80-8e32-1d535b0f0f68
msgctxt "he3b0107ag56c1g4f33gb82egd8e8279a9822"
msgid ""
"<i>Exquisite work, True Soul. Now we must make sure nothing is hidden in "
"their lair. Join me there.</i>"
msgstr "<i>훌륭하게 해치웠구나, 참된 영혼이여. 놈들의 은신처에 숨겨진 건 없는지 확인할 차례군. 거기서 합류해라.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_MindMeldAfterCombat
#. Speaker = Narrator
#. NodeID = cc076f21-7b75-4f7a-b491-d6f1c2ed02f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_MindMeldAfterCombat:cc076f21-7b75-4f7a-b491-d6f1c2ed02f4
msgctxt "h9bac1079gc8ecg4cb7gbb14gea1822ccfa8b"
msgid "*A splinter of ice works its way into your mind.*"
msgstr "*머릿속으로 얼음장 같은 파편이 파고듭니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Mule1
#. Speaker = Bored Ox
#. NodeID = 10cd1597-6670-5e4c-c898-bfa06f116f76
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Mule1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Mule1:10cd1597-6670-5e4c-c898-bfa06f116f76
msgctxt "h4ff96c84g8e7fg44bfgb1fag9109cce1eaaf"
msgid "Please - don't let the evil ones in."
msgstr "제발. 사악한 것들이 들어오게 두지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Mule1
#. Speaker = Bored Ox
#. NodeID = 564dcfb5-efe2-4dd7-10e5-5f86db98004b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#.   Tag:
#.      - PETPAL(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Mule1Victory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Mule1:564dcfb5-efe2-4dd7-10e5-5f86db98004b
msgctxt "haae78f2bgae0fg4fa9gab3dg9ef318fa7d0a"
msgid ""
"The younglings are a nuisance, but the road would not be the same without "
"them. Thank you."
msgstr "어린 것들은 성가시긴 하다만, 걔네를 잃었다면 여행길이 예전만 못했을 거야. 고마워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Mule1
#. Speaker = Bored Ox
#. NodeID = cf3397b3-4a14-6ce5-664c-4a7e26acf181
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Mule1:cf3397b3-4a14-6ce5-664c-4a7e26acf181
msgctxt "he133aeedg735dg485eg8362ge387eb1df2e1"
msgid "<i>Hrnnng!</i>"
msgstr "<i>후으응!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Mule1
#. Speaker = Bored Ox
#. NodeID = d68d1692-aa85-c8da-c618-0eb21a633ef8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Mule1Victory(1) = True
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Mule1:d68d1692-aa85-c8da-c618-0eb21a633ef8
msgctxt "hf9aed514g78f5g4be1g8a1bg935f3bcdeeb1"
msgid ""
"I yearn for fresh grass and a clear sky. I hope we can leave this place soon."
msgstr "신선한 풀이랑 맑은 하늘이 그리워 죽겠어. 여길 빨리 뜰 수 있기만 바랄 뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Mule1
#. Speaker = Bored Ox
#. NodeID = d9922859-8dce-2205-b80b-bc8a2eb5bad3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Mule1(1) = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Mule1:d9922859-8dce-2205-b80b-bc8a2eb5bad3
msgctxt "h468fbc39g828eg4f3agbe84gcad3a3acc657"
msgid "Protect the small ones! Hurry!"
msgstr "어린 것들을 보호해! 어서!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Mule2
#. Speaker = Hungry Ox
#. NodeID = 78ae932f-4095-24f0-68ab-fd4ace822659
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Mule2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Mule2:78ae932f-4095-24f0-68ab-fd4ace822659
msgctxt "h26d4ec65g58bfg4a52g9c73gf9f246a804d9"
msgid ""
"If you are afraid, hide beneath my legs - like a good calf. I will stop them."
msgstr "무섭다면 내 다리 밑으로 들어와 숨어. 착한 송아지처럼. 내가 놈들을 막을게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Mule2
#. Speaker = Hungry Ox
#. NodeID = 864b47b0-f751-fdab-99c8-e4428fcc0407
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Mule2Victory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Mule2:864b47b0-f751-fdab-99c8-e4428fcc0407
msgctxt "h35fcf76cg4f14g4651gaf87gd40151111abd"
msgid "That was fun! I want to stomp more of the small, dirty two-legs."
msgstr "재미있었어! 저 작고 더러운 두 다리 것들을 더 짓밟아 뭉개고 싶네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Mule2
#. Speaker = Hungry Ox
#. NodeID = b6bc4ab6-cc42-7aa1-4ce0-16394f14971f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Mule2Victory(1) = True
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Mule2:b6bc4ab6-cc42-7aa1-4ce0-16394f14971f
msgctxt "hcb8a5657g1069g4689gb3a1g42290dc14839"
msgid ""
"Let us go. I wish to feel the road beneath my hooves - taste the fresh grass!"
msgstr "얼른 가자. 내 발굽으로 길을 다시 걸어보고 싶어. 신선한 풀을 맛보고 싶다고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Mule2
#. Speaker = Hungry Ox
#. NodeID = d01759cd-8381-5258-fcdc-d1c47757468f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Mule2:d01759cd-8381-5258-fcdc-d1c47757468f
msgctxt "ha9bf1240g7ffeg4436gb6f0gfb6581e1b025"
msgid "*Bellow.*"
msgstr "*음머.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Mule2
#. Speaker = Hungry Ox
#. NodeID = f2703116-41f6-da02-4552-42d7c34873a1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Mule2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Mule2:f2703116-41f6-da02-4552-42d7c34873a1
msgctxt "h318e4fd8g073dg4859ga8a3g06ccaee797ca"
msgid "Let them come. I will <i>bite</i>. I will <i>stamp</i>."
msgstr "덤벼보라지. <i>물어뜯어 버릴</i> 거야. <i>밟아버릴</i> 거라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_OpenGateBetrayal
#. Speaker = Zevlor
#. NodeID = 0c3f40a9-a025-430d-c0d1-aba2181e36fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_OpenGateBetrayal:0c3f40a9-a025-430d-c0d1-aba2181e36fc
msgctxt "h86891ec3g614ag4fe4gb165gcffa80412ba1"
msgid "You're... with <i>them, </i>aren't you?"
msgstr "<i>저 놈들</i>이랑... 한패구나, 그렇지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_OpenGateBetrayal
#. Speaker = Zevlor
#. NodeID = 273041a1-995e-87ca-7021-dbbdcbfee8e8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_AttackOnDen_Event_TieflingsGoHostile = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_OpenGateBetrayal:273041a1-995e-87ca-7021-dbbdcbfee8e8
msgctxt "h6d7311b0ga9d4g4477ga244g733f4005b560"
msgid ""
"<i>Birna mrag. </i>May the crows feed on you<i>,</i> you godsdamned "
"<i>zurgnak </i>bastard!"
msgstr "<i>버나 므락.</i> 까마귀가 네 시체를 파먹기를, 망할 <i>주르그낙</i> 새끼같으니!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_OpenGateBetrayal
#. Speaker = Asharak
#. NodeID = 675419cb-f3cf-7db3-d382-8dec6792f49d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_OpenGateBetrayal:675419cb-f3cf-7db3-d382-8dec6792f49d
msgctxt "ha7f34eeag337dg43b0gac15g2464239bb9d5"
msgid "Oh, <i>mrag.</i> You sold us out? To the bloody <i>drow?</i>"
msgstr "이런, <i>므락.</i> 우릴 팔아넘긴 거야? 망할 <i>드로우한테?</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_OpenGateBetrayal
#. Speaker = Asharak
#. NodeID = 7dddd16b-c75f-e7ec-3770-4168362b73c0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_AttackOnDen_Event_TieflingsGoHostile = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_OpenGateBetrayal:7dddd16b-c75f-e7ec-3770-4168362b73c0
msgctxt "hbe5f3406g2429g4652g89fegc8109be441a2"
msgid ""
"<i>Birna mrag. </i>May the crows feed on you<i>,</i> you godsdamned turncoat!"
msgstr "<i>버나 므락.</i> 까마귀가 네 시체를 파먹기를. 빌어먹을 배신자 녀석!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_OpenGateBetrayal
#. Speaker = Asharak
#. NodeID = 829d1585-2ca9-f331-d2a2-682a317e8463
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_OpenGateBetrayal:829d1585-2ca9-f331-d2a2-682a317e8463
msgctxt "h45d8b0c5gac95g4169gaa84ga8f2b221cc54"
msgid "What in the Nine Hells -"
msgstr "대체 무슨 -"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_OpenGateBetrayal
#. Speaker = Zevlor
#. NodeID = e5fc34c1-3383-8660-ea15-4e1c436de3e0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_OpenGateBetrayal:e5fc34c1-3383-8660-ea15-4e1c436de3e0
msgctxt "h66e66030gceaeg4db1gae2dg74efed6bd274"
msgid "<i>Are you mad?! Close the gate before -</i>"
msgstr "<i>미쳤어?! 빨리 문을 닫...</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PAD_DeadKids
#. Speaker = Player
#. NodeID = 88b6cca1-92ee-13a6-cec3-2beefada83b6
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PAD_DeadKids:88b6cca1-92ee-13a6-cec3-2beefada83b6
msgctxt "h1a050658g3769g42e2gbaf2g16c9bd128d5d"
msgid "Well. What's a little more blood on one's hands."
msgstr "그래. 손에 피 좀 더 묻히는 게 뭐라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PAD_DeadKids
#. Speaker = Player
#. NodeID = 88b6cca1-92ee-13a6-cec3-2beefada83b6
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PAD_DeadKids:88b6cca1-92ee-13a6-cec3-2beefada83b6
msgctxt "hc8432ee7gcfd7g47edgab79ga4bf55a33a89"
msgid "We did this. Such depravity cannot be erased."
msgstr "우리가 벌인 짓이야. 이런 끔찍한 일은 쉽게 잊을 수 없겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PAD_DeadKids
#. Speaker = Player
#. NodeID = 88b6cca1-92ee-13a6-cec3-2beefada83b6
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PAD_DeadKids:88b6cca1-92ee-13a6-cec3-2beefada83b6
msgctxt "hf5865b82g9c5cg48fbg8559g0c04d9c32299"
msgid "I've seen the Hells... this is worse. What have we done?"
msgstr "여러 지옥을 봐왔지만... 이건 그보다 끔찍해. 대체 우리가 무슨 짓을 한 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PAD_DeadKids
#. Speaker = Player
#. NodeID = 88b6cca1-92ee-13a6-cec3-2beefada83b6
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PAD_DeadKids:88b6cca1-92ee-13a6-cec3-2beefada83b6
msgctxt "h6acdd1b1ge3a7g47abg93fbg905ae23fe92c"
msgid "Younglings or not, the weak must be culled."
msgstr "나이 어린 애들이라도 약하다면 도태되는 법이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PAD_DeadKids
#. Speaker = Player
#. NodeID = 88b6cca1-92ee-13a6-cec3-2beefada83b6
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PAD_DeadKids:88b6cca1-92ee-13a6-cec3-2beefada83b6
msgctxt "h61a0b0aegc0fdg4756ga678gae01930c54df"
msgid "This is what we sowed. Shar's darkness will embrace the children now."
msgstr "우리가 내린 선택의 결과야. 이제 샤의 어둠이 애들을 감싸줄 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PAD_DeadKids
#. Speaker = Player
#. NodeID = 88b6cca1-92ee-13a6-cec3-2beefada83b6
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PAD_DeadKids:88b6cca1-92ee-13a6-cec3-2beefada83b6
msgctxt "hd7a0f35cg99feg48a6gbc6ag301b707fad85"
msgid "Helm forgive me - what have I done?"
msgstr "헬름이여 저의 죄를 사하여 주옵소서. 내가 무슨 짓을 한 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PAD_DeadKids
#. Speaker = Player
#. NodeID = 88b6cca1-92ee-13a6-cec3-2beefada83b6
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PAD_DeadKids:88b6cca1-92ee-13a6-cec3-2beefada83b6
msgctxt "hf8608c3cgef32g4798gb821gfc423a191f74"
msgid "Butchered. They didn't stand a chance."
msgstr "학살당했군. 이들은 애초에 승산이 없었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PAD_LairDoorBlocked
#. Speaker = Player
#. NodeID = 02304f2d-8bc1-0f42-8d0c-712963e8e3d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PAD_LairDoorBlocked:02304f2d-8bc1-0f42-8d0c-712963e8e3d8
msgctxt "h67548b3dgd846g4de5ga8c3gfceae6285f8f"
msgid "Locked from the inside."
msgstr "안에서 잠겼어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ParentA
#. Speaker = Locke
#. NodeID = 422e4a11-3329-6ca2-90b7-6901998c3e51
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_ParentAVictory(1) = True
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ParentA:422e4a11-3329-6ca2-90b7-6901998c3e51
msgctxt "h5527decag4308g413fga9f1ge3c5b66fe78e"
msgid "My horns for a normal day."
msgstr "가지 많은 나무에 바람 잘 날 없구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ParentA
#. Speaker = Locke
#. NodeID = 518eea8f-1888-3509-2507-cd1c9877cc16
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_ParentA(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ParentA:518eea8f-1888-3509-2507-cd1c9877cc16
msgctxt "h1fb6de94gd482g4768g9c76gb2a4e75d1819"
msgid "We <i>won't </i>be taken alive."
msgstr "우리는 생포되지 <i>않을 거야</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ParentA
#. Speaker = Locke
#. NodeID = 7076a0ae-3897-fa9a-8814-5e217dad1adf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_ParentAVictory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ParentA:7076a0ae-3897-fa9a-8814-5e217dad1adf
msgctxt "h026581b0g8a97g4081g9f54gb31b6e62dd2f"
msgid "One sorrow ended. The next soon to begin."
msgstr "슬픈 일 하나는 끝났군. 곧 다음 슬픈 일이 시작되겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ParentA
#. Speaker = Locke
#. NodeID = 7a581f02-3161-9d1a-edb4-45c25a878976
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_ParentA(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ParentA:7a581f02-3161-9d1a-edb4-45c25a878976
msgctxt "h7f6505eag1d68g4afcg907bg44b29e25f800"
msgid "This place is cursed."
msgstr "여긴 저주받았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ParentB
#. Speaker = Komira
#. NodeID = 04ba0d47-2895-134d-85f3-195997fe5b25
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_ParentBVictory(1) = True
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ParentB:04ba0d47-2895-134d-85f3-195997fe5b25
msgctxt "hd4976b18gc097g42edg8cf1gcb4a74573c13"
msgid "I pray next time I square up to a goblin, you're there again."
msgstr "다음 번에 또 고블린과 마주치면 널 다시 만나길 기도할게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ParentB
#. Speaker = Komira
#. NodeID = 12c77f73-069e-6bd6-3c5b-1444b8cb35f0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#.      - DEN_AttackOnDen_State_DenVictory = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_ParentBVictory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ParentB:12c77f73-069e-6bd6-3c5b-1444b8cb35f0
msgctxt "hccfb52a0gd48dg4b04g92d7g1dc885c4759d"
msgid ""
"I'd have let the goblins take me if it meant Arabella lived. Why even fight?"
msgstr "아라벨라가 살 수만 있다면 고블린한테 잡혀라도 가겠어. 대체 왜 싸우는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ParentB
#. Speaker = Komira
#. NodeID = 85d5a3e3-64e1-edd9-08da-b853617f28d9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_ParentBVictory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ParentB:85d5a3e3-64e1-edd9-08da-b853617f28d9
msgctxt "h03b5362fg9994g41cegb265g63186b8f8226"
msgid "We didn't die today. Tomorrow, perhaps. But not today. Thanks to you."
msgstr "오늘 우린 살아남았어. 내일은 몰라도, 오늘만큼은 아니야. 당신 덕분이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ParentB
#. Speaker = Komira
#. NodeID = 9bc93784-800a-97a7-c26c-a68f6724685c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_ParentB(1) = True
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ParentB:9bc93784-800a-97a7-c26c-a68f6724685c
msgctxt "he9e521d9gac5eg4ea7ga058g9dde1a80653f"
msgid "They're <i>coming.</i>"
msgstr "놈들이 <i>온다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ParentB
#. Speaker = Komira
#. NodeID = ad90f98d-1ffc-c95e-6032-6ab8fbfc172e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_ParentBVictory(1) = True
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#.      - DEN_AttackOnDen_State_DenVictory = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ParentB:ad90f98d-1ffc-c95e-6032-6ab8fbfc172e
msgctxt "hecf45eddg3ab6g4cb0ga0efg8ccc92d3140a"
msgid "None of it matters. Not anymore."
msgstr "모든 게 다 필요 없어. 이제 더 이상은."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ParentB
#. Speaker = Komira
#. NodeID = b0db66be-495d-d7a4-384a-45976ab7559f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_ParentB(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ParentB:b0db66be-495d-d7a4-384a-45976ab7559f
msgctxt "hde9788f7gc173g4f2cg8e65gda4c0bcafb63"
msgid "Everyone? Stay close."
msgstr "붙어 계세요 여러분."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ParentB
#. Speaker = Komira
#. NodeID = d520bbfe-8e16-b337-fd92-1e13447e00b9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_ParentB(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ParentB:d520bbfe-8e16-b337-fd92-1e13447e00b9
msgctxt "h3a71a3b4gdf81g43a4ga4e8g788295020d3c"
msgid ""
"I pray Arabella is safe with the other kids. Knowing her, she's fashioned a "
"weapon out of a rock and some string."
msgstr "아라벨라가 다른 아이들과 함께 무사하기를. 아라벨라는 돌이나 끈으로 무기 만들기를 좋아했거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Pet002
#. Speaker = Silver
#. NodeID = 6e4ae39a-0be9-63f7-3b62-d97d784f6939
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_Pet002_HasMet(1) = False
#.   Tag:
#.      - PETPAL(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_Pet002_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Pet002:6e4ae39a-0be9-63f7-3b62-d97d784f6939
msgctxt "h45776746g6e09g4d9ag8f8eg3ea9f86ec3d6"
msgid "I must protect him. I must."
msgstr "그를 보호해야 해. 꼭 그래야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Pet002
#. Speaker = Silver
#. NodeID = 8b6dc5ac-e7f9-f4eb-4548-f057181c4fde
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_Pet002_HasMet(1) = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Pet002:8b6dc5ac-e7f9-f4eb-4548-f057181c4fde
msgctxt "h9fe8831ag902fg4723g95fag9a7fe4b347bd"
msgid "Blood everywhere. The smell is so strong."
msgstr "온통 피바다군. 냄새가 너무 강해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Pet002
#. Speaker = Silver
#. NodeID = a4c87f54-8ce1-1a8a-11bd-4eaea155fda3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_Pet002_HasMet(1) = False
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#.   Tag:
#.      - PETPAL(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_Pet002_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Pet002:a4c87f54-8ce1-1a8a-11bd-4eaea155fda3
msgctxt "he8f36f5fg955cg4e87gb7d9gc856e878ff97"
msgid "Quiet at last - don't interrupt it."
msgstr "드디어 조용하군 - 침묵을 깨지 마라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Pet002
#. Speaker = Silver
#. NodeID = b4518daa-c2f4-795a-efd7-70e17d513654
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Pet002:b4518daa-c2f4-795a-efd7-70e17d513654
msgctxt "h743d9acag6d64g4bd7ga5a6g665da33d241f"
msgid "*Growl.*"
msgstr "*으르렁.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Pet002
#. Speaker = Silver
#. NodeID = d0e401cb-7503-4a46-4f0b-4b605bc34d73
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_Pet002_HasMet(1) = True
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Pet002:d0e401cb-7503-4a46-4f0b-4b605bc34d73
msgctxt "h2082010dge3fbg4fc1g8cabg890286c55f78"
msgid "Leave me. I want rest."
msgstr "방해하지 마라. 쉬고 싶다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Pet002
#. Speaker = Silver
#. NodeID = e55f9204-723e-5230-effd-c0bbd98267e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Pet002:e55f9204-723e-5230-effd-c0bbd98267e6
msgctxt "h65b6e3a7gaac9g45a7ga074g615c169eaae1"
msgid "*Growl.*"
msgstr "*으르렁.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Pet003
#. Speaker = Topaz
#. NodeID = 30f493cb-30f1-7019-72e7-85405aaaeeb7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Pet003:30f493cb-30f1-7019-72e7-85405aaaeeb7
msgctxt "h24963bbag92e9g4d18gb64eg57a95763484a"
msgid "Ahh, my nest is still whole! Those monsters didn't touch it."
msgstr "아, 내 둥지는 아직 온전해! 그 괴물들이 건드리지 않았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Pet003
#. Speaker = Topaz
#. NodeID = bc1ab775-09ed-28fa-0d13-63d4430c7b2d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidPet_003_State_NoCoinNearby = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Pet003:bc1ab775-09ed-28fa-0d13-63d4430c7b2d
msgctxt "hcb019962gf3ecg4370g89e4g918808553fd8"
msgid "No, no, no - it's gone. My coin is gone!"
msgstr "안 돼, 안 돼, 안 돼 - 사라졌어. 내 금화가 사라졌어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Pet003
#. Speaker = Topaz
#. NodeID = fe0ed670-ad2a-82fc-96ed-bcdecaa91228
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Pet003:fe0ed670-ad2a-82fc-96ed-bcdecaa91228
msgctxt "h66d35fc1ge937g4a8fg81a5g80650c7fa0e9"
msgid "*Chirp!*"
msgstr "*짹짹!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Pet004
#. Speaker = Tusk
#. NodeID = 1dd357b0-7903-69d6-f14d-856bfb3a3bef
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_Pet004_HasMet(1) = False
#.   Tag:
#.      - PETPAL(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_Pet004_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Pet004:1dd357b0-7903-69d6-f14d-856bfb3a3bef
msgctxt "hbe2012bfg616bg4aa1ga74ege3aa8b387151"
msgid ""
"Don't you smell it? The monsters are gone, and the air is fresh with new "
"beginnings."
msgstr "코로 느껴져? 괴물들은 죽었고, 대기는 새로운 시작으로 상쾌해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Pet004
#. Speaker = Tusk
#. NodeID = 78f59a82-b4cd-8e4a-96d4-65b9b5a49f67
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Pet004:78f59a82-b4cd-8e4a-96d4-65b9b5a49f67
msgctxt "h87953737gf943g437bg9c25gc829353fb51f"
msgid "*Grunt!*"
msgstr "*끙!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Pet004
#. Speaker = Tusk
#. NodeID = 8cc8420a-bf9c-98fd-3768-69ec2cad7480
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_Pet004_HasMet(1) = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Pet004:8cc8420a-bf9c-98fd-3768-69ec2cad7480
msgctxt "hdea9c191g763ag4260g9180gf148ebad52e5"
msgid "And speaking of new beginnings... I think it's time I found a mate."
msgstr "새로운 시작이라 하니 말인데... 짝을 찾을 때인 것 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Pickpocket
#. Speaker = Silfy
#. NodeID = 3d55b644-9afa-7178-d8c7-f344543dee20
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_PickpocketVictory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Pickpocket:3d55b644-9afa-7178-d8c7-f344543dee20
msgctxt "h19401d9dg3b7eg4bdeg9ebeg61b66e8e15e2"
msgid "Mattis says we should say thank you."
msgstr "매티스가 당신에게 고마워 해야한다더군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Pickpocket
#. Speaker = Silfy
#. NodeID = 3e04e398-fd1f-eddb-8270-0848d6f60cbf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Pickpocket(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Pickpocket:3e04e398-fd1f-eddb-8270-0848d6f60cbf
msgctxt "h9a0edae1g28bcg4386g80b9g111c66cc26d1"
msgid "Sshhh - you have to be <i>quiet.</i>"
msgstr "쉬이, <i>조용히</i> 해야 해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Pickpocket
#. Speaker = Silfy
#. NodeID = 41e60ce1-113d-734d-c08d-5f614de7f5bd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Pickpocket(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Pickpocket:41e60ce1-113d-734d-c08d-5f614de7f5bd
msgctxt "h7caa2723g2d92g4bf7g89b5g9de924ff05e2"
msgid "Don't worry - Mattis says the goblins can't get inside if we're quiet."
msgstr "괜찮아 - 조용히 있으면 고블린이 못 들어올 거라고 매티스가 그랬어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Pickpocket
#. Speaker = Silfy
#. NodeID = cf348f50-aea1-7cfb-4da2-8150ef942c08
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_PickpocketVictory(1) = True
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Pickpocket:cf348f50-aea1-7cfb-4da2-8150ef942c08
msgctxt "h2b282d2fgb3dfg4d8bg8082g0f57fe6a45f3"
msgid "<i>Thank you.</i>"
msgstr "<i>고마워.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PickpocketTrader
#. Speaker = Player
#. NodeID = 0ba61735-18aa-8697-cbcd-7c62f81e3b48
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PickpocketTrader:0ba61735-18aa-8697-cbcd-7c62f81e3b48
msgctxt "hed4b83aeg7bccg4d56ga0a8g659bd97c39bd"
msgid "Let's see what you have."
msgstr "뭘 가지고 있는지 보여줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PickpocketTrader
#. Speaker = Player
#. NodeID = 0bcf1a74-7233-2a88-bca2-e0822a341476
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PickpocketTrader:0bcf1a74-7233-2a88-bca2-e0822a341476
msgctxt "h39e2262bg26bfg4363g9bc3g79177443e553"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PickpocketTrader
#. Speaker = Mattis
#. NodeID = 26b29902-5dcc-c4ad-b4c5-640d96453e08
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PickpocketTrader:26b29902-5dcc-c4ad-b4c5-640d96453e08
msgctxt "hda61c535gc70ag4846ga647gcac29ac729cd"
msgid "You think my sister and I will last long in the city with no money?"
msgstr "나랑 내 누이가 돈 한 푼 없이 도시에서 살아남을 수 있다고 생각해?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PickpocketTrader
#. Speaker = Player
#. NodeID = 2feba70f-1a8d-998c-5c78-b149b3514d32
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PickpocketTrader:2feba70f-1a8d-998c-5c78-b149b3514d32
msgctxt "ha2f49433g00d0g4788gb86fga0be85c8bc32"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PickpocketTrader
#. Speaker = Mattis
#. NodeID = 3e8f2be7-a6f0-b666-ef29-22d94c84db35
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_PickpocketTrader(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PickpocketTrader:3e8f2be7-a6f0-b666-ef29-22d94c84db35
msgctxt "h7c4528c7g4c6bg4c46gb825gd9e8b7744614"
msgid "Need something else?"
msgstr "다른 게 필요해?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PickpocketTrader
#. Speaker = Mattis
#. NodeID = 43138a9c-2680-5076-cb55-adb07fdc39fe
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_PickpocketTrader(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PickpocketTrader:43138a9c-2680-5076-cb55-adb07fdc39fe
msgctxt "h0f88fc50gb247g4c91g8da2gf1e07bd42a02"
msgid ""
"Need anything before the fighting starts? All that coin will just slow you "
"down."
msgstr "싸움에 나서기 전에 필요한 게 있어? 동전을 지니고 있으면 몸만 둔해질 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PickpocketTrader
#. Speaker = Player
#. NodeID = 47522b2b-d670-b0c4-9679-fec0bc1abe21
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PickpocketTrader:47522b2b-d670-b0c4-9679-fec0bc1abe21
msgctxt "hcb5d951bg0a41g4efbg987fg1d4d72c40cb7"
msgid "Let's see what you have."
msgstr "뭘 가지고 있는지 보여줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PickpocketTrader
#. Speaker = Mattis
#. NodeID = 5813d113-1e09-d36f-c89c-fefb27a069d7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PickpocketTrader:5813d113-1e09-d36f-c89c-fefb27a069d7
msgctxt "ha21ac989g5ac7g4872g98f3ge4da74896918"
msgid "Huh. Fair enough. Can always get my money back when you're dead."
msgstr "허. 알았어. 네가 죽으면 돈은 언제든지 돌려받을 수 있으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PickpocketTrader
#. Speaker = Player
#. NodeID = 5fb3ddd9-f380-9035-9432-bdd6d8cf0c63
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. TagRule: ROGUE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PickpocketTrader:5fb3ddd9-f380-9035-9432-bdd6d8cf0c63
msgctxt "h01ee7b89gdbc6g483eg8c71g055f6faebbef"
msgid "What about a discount? I'm about to risk my life."
msgstr "할인은 안 돼? 내 목숨을 걸고 있잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PickpocketTrader
#. Speaker = Mattis
#. NodeID = 616bfeb0-73ab-354d-3ae3-9a939b1f798f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PickpocketTrader:616bfeb0-73ab-354d-3ae3-9a939b1f798f
msgctxt "h67840964g03cag4c85g9e3fgbbe477bf93b9"
msgid "Good luck out there."
msgstr "행운을 빌어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PickpocketTrader
#. Speaker = Player
#. NodeID = 6e12b043-c9ae-b805-c26c-164513ba3e63
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PickpocketTrader:6e12b043-c9ae-b805-c26c-164513ba3e63
msgctxt "h0f03ed66g22d6g42f8gaa3agd95546375862"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PickpocketTrader
#. Speaker = Mattis
#. NodeID = 8a07e476-0ab6-a609-2c2c-a78f855a12d8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_PickpocketTraderVictory(1) = True
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PickpocketTrader:8a07e476-0ab6-a609-2c2c-a78f855a12d8
msgctxt "h6249bc58ga2d2g4fd2gb6e7g3919121397d6"
msgid "Finally. A city full of <i>real</i> coin."
msgstr "드디어. <i>진짜</i> 동전이 가득한 도시군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PickpocketTrader
#. Speaker = Mattis
#. NodeID = 8cdd5cdc-11a1-fb4a-b84a-6c08a03bab58
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PickpocketTrader:8cdd5cdc-11a1-fb4a-b84a-6c08a03bab58
msgctxt "h122581beg1573g4452gbd36gb351af0fd78b"
msgid "Thanks. Don't die."
msgstr "고마워. 죽지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PickpocketTrader
#. Speaker = Mattis
#. NodeID = 9c445b3f-cd85-1f38-a36c-39baef8ec115
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_PickpocketTraderVictory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PickpocketTrader:9c445b3f-cd85-1f38-a36c-39baef8ec115
msgctxt "h50af338bg15bdg4492gbab5g78ddab81b448"
msgid ""
"I'm... glad you didn't die. No discounts once I'm running the Wide in "
"Baldur's Gate, mind."
msgstr "당신이... 죽지 않아 기뻐요. 발더스 게이트의 와이드를 운영하게 될 때까진 값을 깎아줄게요, 알아 둬요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PickpocketTrader
#. Speaker = Player
#. NodeID = aeaa5222-642c-fdce-0998-aa90f6024d6f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PickpocketTrader:aeaa5222-642c-fdce-0998-aa90f6024d6f
msgctxt "h789da0a8g2647g40c2gbdafga4db01684b16"
msgid "Is this really the time to worry about coin?"
msgstr "지금 동전을 걱정할 때야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PickpocketTrader
#. Speaker = Mattis
#. NodeID = b11e45f2-0fdc-8339-dbfa-bb66c988c771
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_Pickpocket1_CoinGame1(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_PickpocketTrader(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PickpocketTrader:b11e45f2-0fdc-8339-dbfa-bb66c988c771
msgctxt "h4346da06gf873g4795g9786gf906327df361"
msgid "Need anything before the fighting starts? No tricks this time, promise."
msgstr "싸우기 전에 필요한 거 있어? 이번엔 장난 안 칠게, 약속해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PickpocketTrader
#. Speaker = Mattis
#. NodeID = bb17cff6-af0a-e84a-c8fc-9a838152f0eb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PickpocketTrader:bb17cff6-af0a-e84a-c8fc-9a838152f0eb
msgctxt "h3f1656e0g73c4g4a22g838cga152068fc90e"
msgid ""
"A big hero like you, with no gold? Best go pluck some from a goblin, then."
msgstr "너 같은 유명한 영웅이 돈도 한 푼 없어? 고블린한테라도 가서 좀 뺏어 와."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PickpocketTrader
#. Speaker = Mattis
#. NodeID = cf1a7827-5eb4-4f24-917c-fa4d8daa424b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PickpocketTrader:cf1a7827-5eb4-4f24-917c-fa4d8daa424b
msgctxt "had5fc6acg4fb3g4c9cg9f27gfed3fdccd551"
msgid "Good luck out there."
msgstr "행운을 빌어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PickpocketTrader
#. Speaker = Player
#. NodeID = d4626637-9400-0e5b-5df6-57796807d882
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PickpocketTrader:d4626637-9400-0e5b-5df6-57796807d882
msgctxt "h27243671g6038g486dg84aag0ef03398c6e4"
msgid "Fair enough. Let's see what you're selling."
msgstr "알았어. 뭘 팔고 있는 지 보여줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PickpocketTrader
#. Speaker = Mattis
#. NodeID = e8f50d11-7c57-8215-2d5f-37aebbb6a2db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PickpocketTrader:e8f50d11-7c57-8215-2d5f-37aebbb6a2db
msgctxt "ha069e87ag79d4g4244g98aaga541f4e5058d"
msgid ""
"It's your job to make sure we get that far. So why don't <i>you</i> go take "
"care of <i>that?</i>"
msgstr "우리가 무사히 도시로 갈 수 있도록 하는 게 네 일이야. 그러니 <i>그 일이나</i> 신경 쓰는 게 어때?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PrisonGuard
#. Speaker = Tilses
#. NodeID = 2d8d2a45-6d19-651f-182f-ebc4245583db
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_PrisonGuard(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PrisonGuard:2d8d2a45-6d19-651f-182f-ebc4245583db
msgctxt "h03d26365gc551g4f28ga3f9g6782764093c5"
msgid ""
"Glad you're here with us. A bunch of ratty goblins aren't gonna send us "
"running. We've been <i>surviving </i>long enough. Time to start living."
msgstr ""
"네가 함께 있어서 다행이야. 쥐새끼같은 고블린 패거리 따위에 쫓겨다닐 순 없지. 하루하루 <i>연명</i>만 하긴 질렸다고. 이젠 "
"사람답게 살겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PrisonGuard
#. Speaker = Tilses
#. NodeID = d38c212a-f867-1239-8e73-2e0e29f4530e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_PrisonGuardVictory(1) = True
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PrisonGuard:d38c212a-f867-1239-8e73-2e0e29f4530e
msgctxt "h924f64b7g5b37g49b6g8c58gf0b9d5fef483"
msgid ""
"Hope you won't miss this place. Don't think we'll be coming back any time "
"soon."
msgstr "여기에 미련 같은 거 남지 않았으면 해. 우리네는 어지간해선 돌아올 일 없을 것 같거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PrisonGuard
#. Speaker = Tilses
#. NodeID = d4e945e8-3fcc-8584-0c0e-e03e8cf2a471
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_PrisonGuardVictory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PrisonGuard:d4e945e8-3fcc-8584-0c0e-e03e8cf2a471
msgctxt "hbd3db96dg80a7g488dg9fdbg32d3b51a2d32"
msgid ""
"That's it. We can head to the city. Dunno about you, but I'm ready to start "
"my life again."
msgstr "이제 됐다. 도시로 갈 수 있게 됐다고. 넌 어떤지 몰라도, 난 새 인생을 맞을 준비가 됐어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PrisonGuard
#. Speaker = Tilses
#. NodeID = e8d5aadb-c6c6-43fc-74ea-874e969d60d1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_PrisonGuard(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_PrisonGuard:e8d5aadb-c6c6-43fc-74ea-874e969d60d1
msgctxt "hfa06da07ga1c9g4d40ga47ege10222eb536d"
msgid ""
"Good to see a familiar face. I have the strangest feeling every time you "
"pass by. Like you're meant to be here."
msgstr "낯익은 얼굴을 보니 반가운걸. 네가 지나칠 때마다 참 묘한 기분이 든단 말이지. 네가 여기 온 게 운명이란 그런 기분이."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Prodigy
#. Speaker = Rolan
#. NodeID = 046b1bfd-70e0-9ce6-e44b-b747b201b641
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Refugees_State_LeadersAreDead = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Prodigy(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Prodigy:046b1bfd-70e0-9ce6-e44b-b747b201b641
msgctxt "hf12c9bd4gb8a5g407dg825bgaecb0398b9db"
msgid ""
"I nearly dispatched those goblins myself, but it seems you managed well "
"enough."
msgstr "손수 고블린을 보낼 뻔했지만, 네가 충분히 잘 처리한 것 같네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Prodigy
#. Speaker = Rolan
#. NodeID = 205f34a8-f3e6-f71a-db33-c2ac849f16ff
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Prodigy(1) = True
#.   Global:
#.      - DEN_Refugees_State_LeadersAreDead = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Prodigy:205f34a8-f3e6-f71a-db33-c2ac849f16ff
msgctxt "hb2e15a5eg3c16g4cbaga6c1gfaaef82b916b"
msgid ""
"They'll sing songs about this, you know. They simply don't know any better."
msgstr "사람들이 이 얘기로 노래를 만들 거야. 더 나은 방법을 모를 테니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Prodigy
#. Speaker = Rolan
#. NodeID = 26d3150e-2ff5-63c6-0dc4-fe6a54231422
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Prodigy:26d3150e-2ff5-63c6-0dc4-fe6a54231422
msgctxt "h2612d0a2g8dfbg4b4fgabccgfef90d0090b9"
msgid "Nevertheless... I suppose it was decent of you to return."
msgstr "그래도... 당신이 돌아온 건 나쁘지 않은 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Prodigy
#. Speaker = Rolan
#. NodeID = 9a45af99-5038-5b73-21ef-fc2beb3e403d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Prodigy(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Prodigy:9a45af99-5038-5b73-21ef-fc2beb3e403d
msgctxt "h9fdec745gd4bcg4657gba05g9618bd45041b"
msgid "We could've handled those goblins on our own."
msgstr "우리끼리도 고블린들을 잘 처리할 수 있었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Prodigy
#. Speaker = Rolan
#. NodeID = b3f27bee-6b33-45ec-c536-f6b42b040749
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Prodigy:b3f27bee-6b33-45ec-c536-f6b42b040749
msgctxt "h0772d4c1g19b9g42b1g8976gcd5148b98182"
msgid ""
"And why wield a masterwork where a butcher's blade will do? My thanks, truly."
msgstr "짐승들 도축하는 데 최고의 검이 나설 필요가 있었나 싶은데? 고마워, 진심으로."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Prodigy
#. Speaker = Rolan
#. NodeID = f443e0c8-f383-d826-cf63-8704e992d37d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Prodigy(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Prodigy:f443e0c8-f383-d826-cf63-8704e992d37d
msgctxt "h61dc046cg5d7fg42e7g845cgb4df6d24bf8f"
msgid "All that fuss and for what? I'd barely call that a fight."
msgstr "그 난리를 친 결과가 이거야? 그건 싸움도 아니었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyBrother
#. Speaker = Cal
#. NodeID = 5343ffac-a349-7b5c-4519-8be2883c1fdf
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_ProdigyBrother(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyBrother:5343ffac-a349-7b5c-4519-8be2883c1fdf
msgctxt "h81d9b7bbgec7dg413eg9582g31ce47a1d506"
msgid ""
"Glad to see some goblin blood spilled for a change. I was sick of running "
"from those rats."
msgstr "여느 때와 다르게 고블린이 피를 흘린 걸 보고 기뻤어. 그 쥐새끼들을 피해 도망다니는 건 지긋지긋했거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyBrother
#. Speaker = Cal
#. NodeID = bd6b44d2-a63c-2198-8ef3-162d69cf4314
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_ProdigyBrother(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyBrother:bd6b44d2-a63c-2198-8ef3-162d69cf4314
msgctxt "h4c3c7e03gfc5fg44f8g84d6gdc568b943019"
msgid ""
"The roads ought to be safer now there's a few less goblins skulking about."
msgstr "이제 걸리적거리는 고블린이 줄었으니 길도 훨씬 안전해질 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigySister
#. Speaker = Lia
#. NodeID = 43ed4429-95b3-f043-70c4-dcef73cd4121
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_ProdigySister(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigySister:43ed4429-95b3-f043-70c4-dcef73cd4121
msgctxt "hcf38a429gc687g4a5fg8608gc2e3e8ee3062"
msgid ""
"I don't think there's a bit of me that isn't hurting after that fight. Worth "
"it, though."
msgstr "싸움 후에 다친 곳이 없다면 거짓말이겠지만, 그래도 그럴 가치가 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigySister
#. Speaker = Lia
#. NodeID = 7415d555-99c1-30ae-3323-b4335299d739
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_ProdigySister(1) = True
#.   Global:
#.      - DEN_Refugees_State_LeadersAreDead = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigySister:7415d555-99c1-30ae-3323-b4335299d739
msgctxt "hcdcd331agabe1g43fdg869dgbdebede6feba"
msgid "Looks like we're good to go. I'm glad."
msgstr "이제 가도 될 것 같네. 기뻐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigySister
#. Speaker = Lia
#. NodeID = cf0d1645-278c-5f2c-d417-9370e4132565
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Refugees_State_LeadersAreDead = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_ProdigySister(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigySister:cf0d1645-278c-5f2c-d417-9370e4132565
msgctxt "h3b3641d6gf70eg44b6g87d5ga33b3c2aed6e"
msgid ""
"It was you, right? Who took care of the goblins? I knew you were a good one."
msgstr "당신 맞지? 고블린을 손봐준 사람이? 착한 사람일 줄 알았다구."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigySister
#. Speaker = Lia
#. NodeID = d6f25ae9-d674-3e95-1d14-f25a1859f127
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigySister:d6f25ae9-d674-3e95-1d14-f25a1859f127
msgctxt "h8f5481afg328eg43cfg9d17g5637bb92673e"
msgid "Thanks - for keeping these people safe. For keeping <i>us </i>safe."
msgstr "사람들을 안전하게 지켜 줘서 고마워. 우릴 지켜 줘서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigySister
#. Speaker = Lia
#. NodeID = d8a069b0-252d-3024-bf7a-fe0fec02cd87
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_ProdigySister(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigySister:d8a069b0-252d-3024-bf7a-fe0fec02cd87
msgctxt "h69b41ac8g2323g4666gad91gb4523abb638c"
msgid "The road to Baldur's Gate will be easy compared to that."
msgstr "발더스 게이트로 가는 길은 그에 비하면 쉬울 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio
#. Speaker = Rolan
#. NodeID = 01b68327-76c4-3bf0-f8e2-89a5f73b1c6f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio:01b68327-76c4-3bf0-f8e2-89a5f73b1c6f
msgctxt "h445b973cg9af3g468ega621g0e58c7149e16"
msgid "I'm merely pointing out this whole strategy is sorely lacking..."
msgstr "전략이 너무 부족하다는 점을 지적하는 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio
#. Speaker = Lia
#. NodeID = 1a94ae84-4f63-7448-df2f-0af7e7de5b9c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio:1a94ae84-4f63-7448-df2f-0af7e7de5b9c
msgctxt "h27de7b93g65b3g4409g914fge1440b89eeae"
msgid "Another word and it won't be the goblins you have to worry about!"
msgstr "한 마디만 더 하면 고블린이 아니라 다른 걸 걱정해야 할 거야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio
#. Speaker = Rolan
#. NodeID = 2304b7e3-3aa0-9e0a-8f4e-4a5a455b0f36
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio:2304b7e3-3aa0-9e0a-8f4e-4a5a455b0f36
msgctxt "h318cfcd0gf37ag4d07g8017gcd21b9c20a34"
msgid ""
"That's to say me at the front while the others stay back and do as I say?"
msgstr "말인즉슨, 나는 앞에 나서고 다른 사람들은 뒤에서 내 말대로 하고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio
#. Speaker = Player
#. NodeID = 278ad4c1-a424-cf1e-f292-ec862766b409
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_State_ProdigyTrioAdviceGiven(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio:278ad4c1-a424-cf1e-f292-ec862766b409
msgctxt "hc9384836g2d68g4827g86feg7aa7c0df8eff"
msgid "Battle formation. <i>Now.</i>"
msgstr "전투 대형으로. <i>당장.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio
#. Speaker = Lia
#. NodeID = 2dfc0eec-a9cf-c8b1-533d-ca5220279e73
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio:2dfc0eec-a9cf-c8b1-533d-ca5220279e73
msgctxt "hba54ca8ag0debg4bf5g8bcbg6d43d33836fe"
msgid "Oh, share your tactical wisdom with us then!"
msgstr "오, 그럼 네 지혜로운 전술을 좀 나눠 주지 그래!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio
#. Speaker = Rolan
#. NodeID = 322ef4af-1a6d-7431-fbda-5d8cd284c54b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_State_ProdigyTrioAdviceGiven(3) = False
#.      - DEN_AttackOnDen_HasMet_ProdigyTrio(3) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_ProdigyTrio(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio:322ef4af-1a6d-7431-fbda-5d8cd284c54b
msgctxt "h3f26a9b6ga372g4160gac2dgf4abd2125f93"
msgid ""
"Look at this place. Like a pen of hogs waiting for the butcher's knife. We "
"need to act!"
msgstr "여기 좀 봐. 도살장에서 죽음을 기다리는 돼지들과 다를 게 없어. 뭐라도 해야 해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio
#. Speaker = Lia
#. NodeID = 38ddd4e2-a2fa-42d1-ddb5-84cf0d875be2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio:38ddd4e2-a2fa-42d1-ddb5-84cf0d875be2
msgctxt "h565f97eage7f0g4772g9622g665ff25621d4"
msgid "There you go, Rolan - the glory of dying first is all yours. Happy?"
msgstr "됐네, 롤란- 영광스러운 첫 죽음은 네 거야. 행복해?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio
#. Speaker = Rolan
#. NodeID = 465bb52f-4369-1fdb-dc25-24c6739c2098
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio:465bb52f-4369-1fdb-dc25-24c6739c2098
msgctxt "h67a8ed46gdcb7g473cgae7fg530c2fbac87b"
msgid ""
"Oh, perish the thought they overhear a little <i>honesty</i> once in their "
"short lives -"
msgstr "애들이 우리랑 사는 동안 <i>정직한</i> 말을 한 번이라도 들었을 거란 생각은 집어치워 -"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio
#. Speaker = Lia
#. NodeID = 484d4c61-e051-a808-b8fc-b6a2d0f2cb45
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio:484d4c61-e051-a808-b8fc-b6a2d0f2cb45
msgctxt "hc2fe6be0gd70eg42f3ga2c9g7e6e4fe5a904"
msgid "Trust me, I'm feeling both anger <i>and </i>despair."
msgstr "진짜야. 분노 <i>그리고</i> 절망을 동시에 느끼고 있다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio
#. Speaker = Rolan
#. NodeID = 4eb6c6b2-b29b-2966-d204-c96dbf57af0b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio:4eb6c6b2-b29b-2966-d204-c96dbf57af0b
msgctxt "ha5e819f6g3a61g4b24g891dgdf9c675e12e7"
msgid "Exceedingly happy. But I won't be dying."
msgstr "너무 행복하군. 하지만 난 죽지 않을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio
#. Speaker = Cal
#. NodeID = 50faf811-01ec-bca8-5929-4a545d0cba12
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio:50faf811-01ec-bca8-5929-4a545d0cba12
msgctxt "h6025a800g03f5g450fgaef5g2c8a41cb6f8e"
msgid "Please! I can hardly hear myself think over the pair of you."
msgstr "그만! 너희 둘 때문에 생각을 못하겠잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio
#. Speaker = Player
#. NodeID = 5261258b-5227-d853-288f-ed2ef444a144
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio:5261258b-5227-d853-288f-ed2ef444a144
msgctxt "h6623e6acg550dg4220g9046g0b3e13c68682"
msgid "Rolan in back, where he has time to cast. You two are his shield."
msgstr "롤란은 주문을 시전해야 하니 후방으로 가. 너희 둘이 그동안 방패가 되어 주는 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio
#. Speaker = Cal
#. NodeID = 677e0c0d-f50b-3197-71ba-f2f4cc61a375
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio:677e0c0d-f50b-3197-71ba-f2f4cc61a375
msgctxt "h40761486g0dbcg4e15g9235gf1508143e1e2"
msgid "Enough! <i>Both </i>of you!"
msgstr "그만! <i>너희</i> 둘 다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio
#. Speaker = Lia
#. NodeID = 78425542-577f-cbc0-37f8-a929b68a71dd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio:78425542-577f-cbc0-37f8-a929b68a71dd
msgctxt "h62396305g2002g4814gb163g68f070ddec7a"
msgid "Shut it just for once, you insufferable, oafish -"
msgstr "제발 한 번이라도 입 좀 다물어 봐라, 이 거슬리는 바보야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio
#. Speaker = Rolan
#. NodeID = 7b9a5598-de3e-0280-221c-fb501f9ccd56
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio:7b9a5598-de3e-0280-221c-fb501f9ccd56
msgctxt "h6c593df1gd8ddg45d1ga2d0gee03acfca7d0"
msgid "Fine, fine. Agreed."
msgstr "그래, 그래. 동의해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio
#. Speaker = Cal
#. NodeID = 84adca45-5845-ac9c-f600-c5bb15c3b66b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio:84adca45-5845-ac9c-f600-c5bb15c3b66b
msgctxt "hb2915e80g47f5g42f7g8eb0g9f1e8c9219a3"
msgid "... Rolan...?"
msgstr "... 롤란...?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio
#. Speaker = Player
#. NodeID = 8c5f8c97-eded-9507-4235-9dc5f3a8e7d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio:8c5f8c97-eded-9507-4235-9dc5f3a8e7d4
msgctxt "h46d71589ge24dg44ccg8967ga836b5d2e247"
msgid ""
"Rolan front and centre - you two don't want to get caught in his crossfire."
msgstr "롤란이 전방 한가운데로 - 너희 둘, 눈 먼 포화에 휩쓸리고 싶진 않겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio
#. Speaker = Cal
#. NodeID = 8cc9503e-3d71-c52d-d752-fc1f913e1b20
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio:8cc9503e-3d71-c52d-d752-fc1f913e1b20
msgctxt "h63bb3c60g58dcg45afgada4g3b3ffa3de1f8"
msgid "Stop it! Listen to someone else for once."
msgstr "그만해! 한 번만이라도 다른 사람 얘길 좀 들어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio
#. Speaker = Rolan
#. NodeID = 9ac95234-42a9-958a-8d73-a3f543371eee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio:9ac95234-42a9-958a-8d73-a3f543371eee
msgctxt "h9f67ec5fg610cg46c0g945dg9eb9fba9fcb5"
msgid "Why, I think I'm almost in agreement with you on that score."
msgstr "왜, 그 점에 대해서는 너한테 대부분 동의해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio
#. Speaker = Lia
#. NodeID = 9ca23093-7eac-aca0-b3a7-da5e945a2601
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio:9ca23093-7eac-aca0-b3a7-da5e945a2601
msgctxt "h7e85e269g3ed6g4712g8332g74e56c78895c"
msgid "Quiet! Some of the children might hear you."
msgstr "조용히! 애들이 듣잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio
#. Speaker = Cal
#. NodeID = ad0dfc23-7d5a-ec16-76e5-7d445e757112
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio:ad0dfc23-7d5a-ec16-76e5-7d445e757112
msgctxt "hf7d35e75gff08g4affga15cg30a5a6f72470"
msgid "I can live with that... I hope. What about you two?"
msgstr "난 그런대로...괜찮아. 너희 생각은 어때?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio
#. Speaker = Lia
#. NodeID = aee4bf9b-bda2-2b77-dca8-50dde41f1711
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio:aee4bf9b-bda2-2b77-dca8-50dde41f1711
msgctxt "h340992a2g685eg4910g9410gdcb05f505fbe"
msgid "Or shot through with goblin arrows."
msgstr "아니면 고블린 과녁이 되거나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio
#. Speaker = Lia
#. NodeID = b4ecd0c6-0e19-13ef-8380-e4ae898ea38c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio:b4ecd0c6-0e19-13ef-8380-e4ae898ea38c
msgctxt "hc21ea166g972fg4088g9810g1d0b115e377c"
msgid ""
"Fine. As long as I don't have to listen to any complaints in the meantime."
msgstr "알았어. 그동안 내 귀에 불평 소리만 안 들린다면."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio
#. Speaker = Lia
#. NodeID = bb150eed-2f58-a0bb-9c43-4c184b43e677
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio:bb150eed-2f58-a0bb-9c43-4c184b43e677
msgctxt "hfd53be11gb1d2g4a71gb5b9gd5d1b63e0c55"
msgid "Agreed."
msgstr "동의해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio
#. Speaker = Cal
#. NodeID = bd4113ac-df7a-8234-5217-1be96c13b982
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_State_ProdigyTrioAdviceGiven(3) = True
#.      - DEN_AttackOnDen_HasMet_ProdigyTrio(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio:bd4113ac-df7a-8234-5217-1be96c13b982
msgctxt "h3f23f1c8g62aag4501gb53bg72a5249e800e"
msgid "Let's just stick to the plan, now that we have one. Agreed?"
msgstr "일단 계획을 세웠으니 그대로만 하자. 동의해?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio
#. Speaker = Player
#. NodeID = c4af5912-33b6-e73b-9a2d-9ce8d417c267
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio:c4af5912-33b6-e73b-9a2d-9ce8d417c267
msgctxt "hf8ff6fe0geb0cg4d7dga811gdc4f7a3e0008"
msgid "You three are making me root for the goblins."
msgstr "너희 셋을 보자니 고블린 편을 들고 싶어 지는 군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio
#. Speaker = Player
#. NodeID = c883d0c1-1ae0-1d84-e9d5-b41db70738ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio:c883d0c1-1ae0-1d84-e9d5-b41db70738ad
msgctxt "ha7447040g1853g4451gb98bg244190facc92"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio
#. Speaker = Player
#. NodeID = d6dcc98c-1e4f-dad3-19e7-70fb36120ed5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio:d6dcc98c-1e4f-dad3-19e7-70fb36120ed5
msgctxt "h1f6f3ccfg2be0g44fdg9238g16de4b63293b"
msgid "Let them argue. Right now, anger's more useful than despair."
msgstr "싸우게 내버려 둬. 지금으로서는 절망보단 분노가 낫지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio
#. Speaker = Cal
#. NodeID = e050ed7d-7bf6-7f3d-e5f7-d2b9405888e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio:e050ed7d-7bf6-7f3d-e5f7-d2b9405888e6
msgctxt "h0f8e40f2g7310g4595ga324gafbebc6838ac"
msgid ""
"That's as close to an agreement as we're likely to get. Let's keep it that "
"way."
msgstr "우리가 할 수 있는 합의에 어느 정도 가까워졌군. 계속 그렇게 가자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio
#. Speaker = Cal
#. NodeID = e744d783-6fde-e030-1348-17d69cbdca2e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio:e744d783-6fde-e030-1348-17d69cbdca2e
msgctxt "hd5f6be90g38ccg4b08ga027gbe0d6bf6581c"
msgid "No, don't - please."
msgstr "그러지 마, 제발."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio
#. Speaker = Rolan
#. NodeID = eb742bb6-ee1b-6ac9-55cc-7bf3e9ba1431
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_State_ProdigyTrioAdviceGiven(3) = False
#.      - DEN_AttackOnDen_HasMet_ProdigyTrio(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio:eb742bb6-ee1b-6ac9-55cc-7bf3e9ba1431
msgctxt "h99e1793dg7c10g4fdfgb37ag9a9ca7a9abd5"
msgid "We could've been far away from this place by now."
msgstr "지금쯤 여기서 훨씬 먼 곳까지 가 있었을 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio
#. Speaker = Rolan
#. NodeID = eba02f28-0a44-8ffb-24cd-4b1d5ad433f7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ProdigyTrio:eba02f28-0a44-8ffb-24cd-4b1d5ad433f7
msgctxt "hb558185dg144eg4df3g82edg8bd3389aaabf"
msgid "So be it. I'll take a mediocre plan over nothing."
msgstr "어쩔 수 없군. 덜떨어진 계획이라도 있는 편이 낫겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderArrogant
#. Speaker = Sharp-Eye Neem
#. NodeID = 803c419f-01ad-c5af-c943-d2ddfacb60ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderArrogant:803c419f-01ad-c5af-c943-d2ddfacb60ec
msgctxt "h4d23bbe1g5bc0g4675gbc1agd31ea0f2845e"
msgid "They'll be worg meat soon enough!"
msgstr "놈들은 금방 워그 밥 신세가 될 거다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderArrogant
#. Speaker = Sharp-Eye Neem
#. NodeID = 8451e337-7df1-5b52-7348-40ef3de19332
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_DrowCommander_State_AboutToLeave(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderArrogant:8451e337-7df1-5b52-7348-40ef3de19332
msgctxt "h21f6225cg4e4ag498egaaccge4760bad63d1"
msgid "We'll rip them tiefs to shreds!"
msgstr "우린 티플링놈들을 갈가리 찢어버릴 거야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderArrogant
#. Speaker = Sharp-Eye Neem
#. NodeID = b369222b-126b-c3cc-a4e0-bbb79dc3149f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_AttackOnDen_State_Victorious(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderArrogant:b369222b-126b-c3cc-a4e0-bbb79dc3149f
msgctxt "h95a783fbgee79g459bga312gaade3a8db0c9"
msgid "Ain't seen much good loot."
msgstr "딱히 좋은 전리품은 없구만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderBold
#. Speaker = Warrior Clack
#. NodeID = 231515a3-e521-4217-d235-1fab2ba5a866
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderBold:231515a3-e521-4217-d235-1fab2ba5a866
msgctxt "h083bc17cg3c67g4c05gb624g33b16bffc61c"
msgid "TEAR 'EM APART!"
msgstr "놈들을 찢어버려!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderBold
#. Speaker = Warrior Clack
#. NodeID = 2792dd52-4658-b19d-7d81-38cb6e074ee3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_AttackOnDen_State_Victorious(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderBold:2792dd52-4658-b19d-7d81-38cb6e074ee3
msgctxt "h8c9697ffg1c36g4b5egaa40g7538f081804e"
msgid "<i>Rhaal'tuuch!</i>"
msgstr "<i>라아알'투우치!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderBold
#. Speaker = Warrior Clack
#. NodeID = 2ecd4704-e156-868b-3900-178c0bb78354
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_DrowCommander_State_AboutToLeave(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderBold:2ecd4704-e156-868b-3900-178c0bb78354
msgctxt "hc5668930gfdbeg4ef1gbf05g235fc8edc918"
msgid "Come on, lads! This'll be a <i>slaughter</i>."
msgstr "덤벼, 자식들아! <i>살육</i>을 벌여 보자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderBossy
#. Speaker = Goblin Sharp-Eye
#. NodeID = 5b1b5276-7de9-65ab-c622-f3bbdc68a98d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_AttackOnDen_State_Victorious(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderBossy:5b1b5276-7de9-65ab-c622-f3bbdc68a98d
msgctxt "h8ac812b1gac97g4771gbfa4g00f939c8b8bf"
msgid "I see a lot o' red blades around; the Absolute'll be chuffed."
msgstr "피로 물든 칼날이 많이 보이는군. 절대자께서 기뻐하시겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderBossy
#. Speaker = Goblin Sharp-Eye
#. NodeID = a5e57170-8573-8ccc-1038-78b528c37425
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderBossy:a5e57170-8573-8ccc-1038-78b528c37425
msgctxt "hd3294c9dg36b6g4aaag9ec8g14acaadcd7c4"
msgid "That's the last of 'em! Ground's sopping with heretic blood!"
msgstr "이제 끝이다! 땅이 이단자의 피로 흠뻑 젖었구나!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderChieftain
#. Speaker = Skrut
#. NodeID = c8910c48-73c0-035d-3f71-2fce0ec50c82
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderChieftain:c8910c48-73c0-035d-3f71-2fce0ec50c82
msgctxt "hf26b11a1g8e2fg4240g8dc6g27eabefbbd24"
msgid "... gonna try an' catch one. Be a nice plaything for my little 'uns."
msgstr "... 한 놈 붙잡아야겠어. 어린 넘들이 갖고 놀기 아주 좋은 장난감이 될 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderChieftain
#. Speaker = Skrut
#. NodeID = d859c832-114b-0476-d400-1be7d007df88
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderChieftain:d859c832-114b-0476-d400-1be7d007df88
msgctxt "h59323376g65c9g4e27g99ddgff1616b3c901"
msgid "Drow sez they've got kids in there..."
msgstr "드로우가 거기 꼬마들이 있다던디..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderChieftain
#. Speaker = Skrut
#. NodeID = fc13e64a-ca75-d36e-fdc6-9b9c5786c2ff
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_AttackOnDen_State_Victorious(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderChieftain:fc13e64a-ca75-d36e-fdc6-9b9c5786c2ff
msgctxt "h3641e6bdge0b7g49b6g9c23gd0a2be331705"
msgid "Meant to keep one alive fer a pet - they broke too easy."
msgstr "애완동물 하나 삼을까 했는디 - 너무 쉽게 부러지잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderCrafty
#. Speaker = Warrior Trunk
#. NodeID = 1b4e75f3-b957-2d1c-6649-c868279e9e29
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_AttackOnDen_State_Victorious(0) = True
#.   Tag:
#.      - TIEFLING(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderCrafty:1b4e75f3-b957-2d1c-6649-c868279e9e29
msgctxt "h86080addg1f5eg42cdg96acg525baa1016cc"
msgid "All these horns'll make fer good trophies... uh, no offence."
msgstr "요 뿔들 좋은 전리품이 되겠는데... 아, 실례."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderCrafty
#. Speaker = Warrior Trunk
#. NodeID = 2e74e9a3-91b9-4ae2-43a1-1ec3cf6faf07
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderCrafty:2e74e9a3-91b9-4ae2-43a1-1ec3cf6faf07
msgctxt "he63627e0g5e88g4f08gb12cg2168930c0e09"
msgid "Chop the horns off 'em!"
msgstr "놈들의 뿔을 잘라버려!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderCrafty
#. Speaker = Warrior Trunk
#. NodeID = c45d7f05-7d2e-46ea-ba67-938bbaf9cd7f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_AttackOnDen_State_Victorious(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderCrafty:c45d7f05-7d2e-46ea-ba67-938bbaf9cd7f
msgctxt "h05ee00b4gd147g4ad4g883cg1d93a8c5f095"
msgid "All these horns'll make fer good trophies."
msgstr "요 뿔들 좋은 전리품이 되겠는걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderCunning
#. Speaker = Sharp-Eye Nass
#. NodeID = 4be27f1c-bb36-4177-5e8f-4147ac21129f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_AttackOnDen_State_Victorious(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderCunning:4be27f1c-bb36-4177-5e8f-4147ac21129f
msgctxt "h3a536e1bgffd8g4adcga8c2gdcc2ada58c28"
msgid "Hope we weren't s'posed to take any prisoners..."
msgstr "포로를 잡았어야 하는 건 아니었으면 좋겠는데..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderCunning
#. Speaker = Sharp-Eye Nass
#. NodeID = 788e1377-4ec8-196a-b55b-62589d2ea757
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderCunning:788e1377-4ec8-196a-b55b-62589d2ea757
msgctxt "hd53ab165gfaaeg4b72g8d70g977290915741"
msgid "Let's <i>mash</i> 'em!"
msgstr "빨랑 <i>으깨버리자</i>!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderFunny
#. Speaker = Sharp-Eye Sneem
#. NodeID = 951f0676-b91f-149d-3440-d47fe25a6f81
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_AttackOnDen_State_Victorious(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderFunny:951f0676-b91f-149d-3440-d47fe25a6f81
msgctxt "hdad9375ag707dg477fga223g8dddea950502"
msgid "All this killin'... for the Absolute!"
msgstr "이 모든 살육... 절대자를 위하여!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderFunny
#. Speaker = Sharp-Eye Sneem
#. NodeID = 98644cac-71f4-924c-b6ba-028224f9bd6e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderFunny:98644cac-71f4-924c-b6ba-028224f9bd6e
msgctxt "h189160f3g6c96g4ff5g9ac3g6a6f34643ae0"
msgid "Praise the Absolute!"
msgstr "절대자를 찬양하라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderHardy
#. Speaker = Brawler Gurd
#. NodeID = 102e3475-bd97-8153-0b1f-09c4a96a8b36
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderHardy:102e3475-bd97-8153-0b1f-09c4a96a8b36
msgctxt "h9645307dg5e7fg4217gb165g319a9eebf2a9"
msgid "Drow's in charge - follow 'er lead!"
msgstr "드로우가 대빵이다 - 대빵을 따라라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderHardy
#. Speaker = Brawler Gurd
#. NodeID = b15cc571-6288-fcd7-ad27-970dcac63787
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_AttackOnDen_State_Victorious(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderHardy:b15cc571-6288-fcd7-ad27-970dcac63787
msgctxt "h3d11769dg5cb0g4ba9gad94g227b283410a5"
msgid "Drow'll be pleased with us - proper good raid, that was."
msgstr "드로우가 마음에 들어하겠어 - 겁나 멋진 습격이었다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderHefty
#. Speaker = Sharp-Eye Zami
#. NodeID = 2012965e-acca-d8de-0844-9724d37a5d09
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderHefty:2012965e-acca-d8de-0844-9724d37a5d09
msgctxt "hd2e69512ga818g4c5cgad14gf36b4a60d8ae"
msgid "Just funnin', mate. We know you're one of us. Cold-blooded killer."
msgstr "장난이야, 친구. 우리 편도 못 알아보겠냐고. 냉혈한 살인자 양반."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderHefty
#. Speaker = Sharp-Eye Zami
#. NodeID = 22836b9a-5656-1980-2c37-8ecfbc1d03d3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_AttackOnDen_State_Victorious(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderHefty:22836b9a-5656-1980-2c37-8ecfbc1d03d3
msgctxt "h80f7eb0fgececg4970g9c38g087a40307ad6"
msgid ""
"Thought their horns would be bigger. What's the use if ya can't even drink "
"from 'em?"
msgstr "뿔이 좀 더 클 줄 알았는데. 술도 못 따르면 어따 써먹으라는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderHefty
#. Speaker = Sharp-Eye Zami
#. NodeID = 6217ad8f-28c1-2fbf-aa2f-c4d5cdd086e7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_Event_HeftyTieflingQuip(1) = False
#.   Tag:
#.      - TIEFLING(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_Event_HeftyTieflingQuip(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderHefty:6217ad8f-28c1-2fbf-aa2f-c4d5cdd086e7
msgctxt "h5ae79588g2db5g418dg943cg20c7a29e612b"
msgid "Oh look, we missed a teef in all the slaughter!"
msgstr "요것 봐라, 티플링 한 놈이 용케 살아 있었잖아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderHefty
#. Speaker = Sharp-Eye Zami
#. NodeID = c723f1d5-8681-35a4-af83-1a4a296920d5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderHefty:c723f1d5-8681-35a4-af83-1a4a296920d5
msgctxt "h0b97a8c2g17ebg4ebdgb759g1318d0f6028b"
msgid ""
"Drow says we can do what we want with the corpses. Gonna take their horns as "
"trophies!"
msgstr "드로우가 시체는 맘대로 하랬어. 저것들 뿔을 잘라서 장식품으로 꾸밀 거야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderMurderous
#. Speaker = Warrior Rua
#. NodeID = 85091e23-8481-eb1b-6e0a-42a782869f28
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderMurderous:85091e23-8481-eb1b-6e0a-42a782869f28
msgctxt "h404d571cg7325g4c20g9e64g7ce4ad6b940d"
msgid "Killed my first human when I was five years old. Tieflings are soft."
msgstr "처음 인간을 죽여 본 게 다섯 살 때였나. 티플링들은 연약해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderMurderous
#. Speaker = Warrior Rua
#. NodeID = b13a4423-56d4-164d-8049-e6bf38bfa143
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderMurderous:b13a4423-56d4-164d-8049-e6bf38bfa143
msgctxt "h4221a722gc9d4g4813g8b27g58140bc072ce"
msgid "Goblin kids would 'ave put up a better fight."
msgstr "고블린 꼬맹이들이 더 잘 싸우겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderStupid
#. Speaker = Sharp-Eye Eef
#. NodeID = 62920631-88c7-1cc1-c962-18acbce4411e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_AttackOnDen_State_Victorious(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderStupid:62920631-88c7-1cc1-c962-18acbce4411e
msgctxt "hbddf015eg129eg4969gb4afg1511c8f14565"
msgid ""
"You'd think devil spawn would put up a better fight, wouldn't ya? It's like "
"they didn't even wanna live."
msgstr "데빌스폰은 더 잘 싸울 거 같지? 살기 싫은 것처럼 싸운다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderStupid
#. Speaker = Sharp-Eye Eef
#. NodeID = d4ab0a7e-e6d5-e0c2-1188-7312cce188db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderStupid:d4ab0a7e-e6d5-e0c2-1188-7312cce188db
msgctxt "hd8856e20gc3b5g4b60gb51dg180d50efa661"
msgid ""
"Remember, you'll be worg food if you drop 'ere. Don't matter if yer friend "
"or foe."
msgstr "명심해, 여서 떨어지는 순간 워그밥이 될 거여. 니가 아군이건 적군이건 말이제."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderThirsty
#. Speaker = Warrior Kramp
#. NodeID = 75eeca46-fbef-09ca-9bcd-02428aafc0d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderThirsty:75eeca46-fbef-09ca-9bcd-02428aafc0d4
msgctxt "h3ace3dbfg4a94g4213gb0dfg250d09d7edc6"
msgid "Must be getting soft - almost felt bad for 'em."
msgstr "내가 마음이 약해졌나, 거의 미안할 지경이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderViolent
#. Speaker = Goblin Sharp-Eye
#. NodeID = b1ddc7aa-b468-ad41-6109-57091446378f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_AttackOnDen_State_Victorious(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderViolent:b1ddc7aa-b468-ad41-6109-57091446378f
msgctxt "h150793afg1335g4f68g8097g1dd67ed68858"
msgid "Geroff. These're my music boxes - find yer own."
msgstr "꺼져. 내 음악 상자야. 네꺼 찾아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderViolent
#. Speaker = Goblin Sharp-Eye
#. NodeID = fa4cdbd3-6764-6770-89ee-21a9b0a0d7a2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaiderViolent:fa4cdbd3-6764-6770-89ee-21a9b0a0d7a2
msgctxt "h6b898320g7194g41cegaebag84a02031fd28"
msgid "Get ready. Or the fun'll be over before you get any of it."
msgstr "준비해. 아니면 재미는 시작도 되기 전에 끝나버릴 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveAfterFight
#. Speaker = Nightwarden Minthara
#. NodeID = 3ededf44-2d2b-bcea-d395-4850f4af68bf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_CaveTieflingsDead = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveAfterFight:3ededf44-2d2b-bcea-d395-4850f4af68bf
msgctxt "h58e1a355g9cc5g4860gbf2cg0d233c7023e1"
msgid ""
"<i>The way is clear. Now we can cleanse this place completely. Kill "
"</i>everyone<i>.</i>"
msgstr "<i>길이 열렸군. 이제 이곳을 완전히 정화할 수 있겠어. 모두</i> 죽여라<i>.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveAfterFight
#. Speaker = Nightwarden Minthara
#. NodeID = a8437255-3b14-9d82-2797-9577ad2e5d06
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_General_State_GateOpened = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveAfterFight:a8437255-3b14-9d82-2797-9577ad2e5d06
msgctxt "h7872ffc5g9c60g46b3gb5ddg9cc3db7fd204"
msgid "<i>Open the gate.</i>"
msgstr "<i>문을 열어라.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveAfterFight
#. Speaker = Narrator
#. NodeID = b468dd09-2db5-817c-2add-0a34bbd5c93d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_AttackOnDen_Event_EnemiesAppear = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveAfterFight:b468dd09-2db5-817c-2add-0a34bbd5c93d
msgctxt "h3c6f5a55ga22eg45dcg9231g5e63ef917c87"
msgid ""
"*A splinter of ice works its way into your mind, drowning out the goblins' "
"battle cries.*"
msgstr "*얼음 파편이 마음속으로 파고들고, 고블린들의 함성 소리가 점점 작아집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveAfterFight
#. Speaker = Nightwarden Minthara
#. NodeID = d78011e7-c862-1673-65f7-c9ed9c72919d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_CaveTieflingsDead = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveAfterFight:d78011e7-c862-1673-65f7-c9ed9c72919d
msgctxt "h377e5ad1gaf7dg49cagb4bag19dfe4ddef20"
msgid ""
"<i>Exquisite work, True Soul. Now we must make sure nothing is hidden in "
"their lair. Join me there.</i>"
msgstr "<i>훌륭하게 해치웠구나, 참된 영혼이여. 놈들의 은신처에 숨겨진 건 없는지 확인할 차례군. 거기서 합류해라.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Asharak
#. NodeID = 07671f1e-847c-2d86-6d5a-80d7577305f1
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: !TIEFLING
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:07671f1e-847c-2d86-6d5a-80d7577305f1
msgctxt "hf56f1a64ge96cg4e79g8cb8g08bf4293fbd7"
msgid "You're in league with the damned drow?"
msgstr "저 망할 드로우와 한패라고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Asharak
#. NodeID = 07671f1e-847c-2d86-6d5a-80d7577305f1
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: TIEFLING
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:07671f1e-847c-2d86-6d5a-80d7577305f1
msgctxt "h69f90e3bg7b54g42ddg903egc2d4615ace47"
msgid "You're siding with that monster against your own people?"
msgstr "동족들에게 등을 돌리고 저 괴물들 편에 서겠다고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Nightwarden Minthara
#. NodeID = 07735f95-e34e-0827-d758-652ef5f7513d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:07735f95-e34e-0827-d758-652ef5f7513d
msgctxt "h068633c3g748ag421dg81fbge3243657093f"
msgid ""
"<i>Traitor! You think you can stand against me </i>and<i> the Absolute? </i>"
msgstr "<i>배신자! 나</i>와 <i>절대자님을 거스를 수 있을 거라 생각했나? </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Nightwarden Minthara
#. NodeID = 08295635-5110-9994-4f8a-b7722f35fd62
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:08295635-5110-9994-4f8a-b7722f35fd62
msgctxt "h86d7010dgc17dg48c0g8238g4f492438c590"
msgid ""
"<i>Now slit his throat, and open that gate. The Absolute wants all of them "
"dead.</i>"
msgstr "<i>이제 그의 목을 베고, 관문을 열어라. 절대자님께서 그들 모두의 죽음을 원하신다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Nightwarden Minthara
#. NodeID = 099531ba-2b22-4d27-30b2-b2d15f422358
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:099531ba-2b22-4d27-30b2-b2d15f422358
msgctxt "h4cf56df3gd7e7g4f06g837agccdab38f26d2"
msgid "<i>I'll dissect you.</i>"
msgstr "<i>널 산산조각 내주지.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Player
#. NodeID = 0e85fc6b-ac4b-51e7-e01b-7a150d386022
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_AttackOnDen_Event_TieflingsGoHostile = True
#.   Object:
#.     - DEN_AttackOnDen_Event_PlayerOpensGate(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:0e85fc6b-ac4b-51e7-e01b-7a150d386022
msgctxt "h38f62cbag870cg420dga6b7g12b334b6f04e"
msgid "<i>Obey and open the gate.</i>"
msgstr "<i>명령에 따라 관문을 연다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Zevlor
#. NodeID = 12492114-853e-c8b4-7cd9-94fa1d629f5a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_General_State_GateOpened = True
#. SetFlags:
#.   Global:
#.     - DEN_AttackOnDen_Event_CloseGate = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:12492114-853e-c8b4-7cd9-94fa1d629f5a
msgctxt "h69881b25geaa7g450cg8f04gf8633800d68f"
msgid "Get that damn gate closed!"
msgstr "저 망할 관문을 닫아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Player
#. NodeID = 12dcd4b5-6583-32a2-b276-037e2e3020dd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:12dcd4b5-6583-32a2-b276-037e2e3020dd
msgctxt "he78bd14fg4a48g4cb7g8270ga8a2a3e3de29"
msgid ""
"I'm truly sorry. I need healing - and the drow and her god are my best "
"chance."
msgstr "정말 미안해. 난 치유가 필요하고, 저 드로우와 그녀가 섬기는 신이 가장 가능성이 높아 보여."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Player
#. NodeID = 15f65f46-af85-4b7a-5b67-d0bbe93e83bf
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_GOOD or CLERIC_NEUTRAL or PALADIN_GOOD or PALADIN_NEUTRAL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:15f65f46-af85-4b7a-5b67-d0bbe93e83bf
msgctxt "he1c2df16g6b66g461bg849cg0f7462f6c6b4"
msgid "No. I'll show the Absolute the power of a <i>true</i> god."
msgstr "아니. 절대자에게 <i>진정한</i> 신의 힘이 무엇인지 보여주겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Player
#. NodeID = 18635578-464c-bb22-cf2a-f8e52e7c2541
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TIEFLING(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:18635578-464c-bb22-cf2a-f8e52e7c2541
msgctxt "h77ad310ag0578g4468gbc3egbae8da14b274"
msgid "My people? I'm loyal only to myself."
msgstr "내 사람들이라고? 난 내 자신에게만 충성해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Zevlor
#. NodeID = 1d159cd1-93e4-db54-9cd8-fd02baa441be
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:1d159cd1-93e4-db54-9cd8-fd02baa441be
msgctxt "h646e999fg9576g49a5gb725g91ce647566e5"
msgid ""
"We have never been handed the easy choices, or the gentle paths. And this is "
"no different."
msgstr "쉬운 선택이나, 안정적인 길 따위는 한 번도 주어진 적이 없었소. 이번도 다를 바 없소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Player
#. NodeID = 2514288c-728a-928e-61eb-f09216337afa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SHADOWHEART(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:2514288c-728a-928e-61eb-f09216337afa
msgctxt "hdc610bfcg66c7g4eddga8c3g1d619d161459"
msgid "I serve Shar, not the Absolute. The gate stays closed."
msgstr "난 절대자가 아니라 샤님을 섬긴다. 관문이 열릴 일은 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Zevlor
#. NodeID = 28d46899-649c-ee89-9464-939eee83b342
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:28d46899-649c-ee89-9464-939eee83b342
msgctxt "h2887fe3eg6f47g4330g9c29g5cbad5e6c638"
msgid "Gods forgive me... I've doomed them all."
msgstr "신이시여 용서하소서... 내가 이들 모두를 파멸시킨 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Nightwarden Minthara
#. NodeID = 294a59e4-6088-740e-3514-085a40e5b73c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:294a59e4-6088-740e-3514-085a40e5b73c
msgctxt "h00474d72g56f8g41b3g8c71ge2628730a6b8"
msgid "<i>You will die here. And your god will die with you.</i>"
msgstr "<i>넌 여기서 죽는다. 그리고 네 신도 너와 함께 죽을 것이다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Player
#. NodeID = 2a0cafa2-09d1-05cb-8b32-377b201a0fbe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - KARLACH(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:2a0cafa2-09d1-05cb-8b32-377b201a0fbe
msgctxt "hfd4e5f56g8a72g4c5bgbdbdg56842051134a"
msgid "These people are under my protection - but I'll see you in the Hells."
msgstr "이 사람들은 내 보호 아래 있다. 넌 지옥에서 만나지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Player
#. NodeID = 2d6ceace-edb5-c4f3-429e-efda7109a725
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DROWELF(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:2d6ceace-edb5-c4f3-429e-efda7109a725
msgctxt "h168daeb2gbae0g4080gb738g2d52285dd089"
msgid "Obviously."
msgstr "당연하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Asharak
#. NodeID = 2eebffee-94bf-f434-40a2-d328a54ee60a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:2eebffee-94bf-f434-40a2-d328a54ee60a
msgctxt "h2b3463edg6494g4ab0g8e3agdc5e0d5e1911"
msgid "Nothing personal? You betrayed us!"
msgstr "개인적인 감정은 없다고? 우릴 배신했잖나!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Zevlor
#. NodeID = 310b266f-96ee-9376-0b72-d7e1934c1a99
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:310b266f-96ee-9376-0b72-d7e1934c1a99
msgctxt "h5e25c23cg8710g4657gbc5bgd5e94a071551"
msgid "You're mad. How did I not see it?"
msgstr "완전히 미쳤군. 이걸 왜 이제서야 눈치챈 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Zevlor
#. NodeID = 34a63d76-0d17-8324-9429-194ca2369676
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:34a63d76-0d17-8324-9429-194ca2369676
msgctxt "h29907969g4069g47e0g8d0dg2cb8f40957f1"
msgid "You <i>bastard</i>."
msgstr "이 <i>개자식</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Asharak
#. NodeID = 3d92d564-4103-4c91-3364-e61424b044c1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:3d92d564-4103-4c91-3364-e61424b044c1
msgctxt "haa16333dg1c0bg4b4ag8ae8g65a7240eca60"
msgid "Impspit!"
msgstr "임프똥 같은 자식!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Player
#. NodeID = 42187d36-2af4-d70f-1c0f-92784417187f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TIEFLING(3) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:42187d36-2af4-d70f-1c0f-92784417187f
msgctxt "h9f7a7bedg4347g469agb371g1d1f017ea30d"
msgid "It's nothing personal."
msgstr "개인적인 감정은 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Zevlor
#. NodeID = 444cdf69-821c-4c18-e41e-1ea12c42e2e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:444cdf69-821c-4c18-e41e-1ea12c42e2e7
msgctxt "h6bfca205g592cg4c51g9e98gbff149c2e27b"
msgid ""
"These creatures would take our lives, our children... our future. And we "
"must <i>resist</i>!"
msgstr "이 괴물들이 우리 삶, 아이들... 미래를 빼앗으려 하고 있소. 우리는 <i>맞서 싸워야만</i> 하오!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Player
#. NodeID = 48d214be-ec5d-5382-0316-996082acb140
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - UNKNOWN_TAG_308b1975(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:48d214be-ec5d-5382-0316-996082acb140
msgctxt "hc337de47gdf9fg4ce3ga681g463a519cbd27"
msgid ""
"I will not. Boo will not. And if you think to triumph here today, drow - "
"<i>you will not</i>."
msgstr "난 안 한다. 부도 안 한다. 오늘 너희가 여기서 승리할 거라고 생각했다면, 드로우 - <i>그런 일은 없을 거다</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Nightwarden Minthara
#. NodeID = 64602197-8486-44fd-5a14-aa5ac94432e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:64602197-8486-44fd-5a14-aa5ac94432e2
msgctxt "h65895a08g688cg4bcbgae6bg455fe8478ef0"
msgid "<i>Sacred? It is filth. It will burn, and you will burn with it.</i>"
msgstr "<i>신성하다고? 이곳은 오물에 불과해. 너와 함께 모두 타오를 것이다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Zevlor
#. NodeID = 6928012f-eb78-fa03-489c-f278a4c675d2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:6928012f-eb78-fa03-489c-f278a4c675d2
msgctxt "h8b0c3fdbga3cdg4c2dg8a50g0bd8a1a39c92"
msgid ""
"I know that you are all afraid... but I also know that you have been "
"fighting your whole lives."
msgstr "분명 그대 모두가 두려울 것이오... 하지만 나는 그대들이 평생 동안 싸워왔다는 사실도 알고 있소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Player
#. NodeID = 6bd63ed3-e332-9a1a-4b2a-ac637e5e1e4d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_AttackOnDen_Event_TieflingsGoHostile = True
#.   Object:
#.     - DEN_AttackOnDen_Event_PlayerOpensGate(3) = True
#. TagRule: CLERIC_EVIL or PALADIN_EVIL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:6bd63ed3-e332-9a1a-4b2a-ac637e5e1e4d
msgctxt "h8dcee4a2g4a03g4abdg9362g73392d4eda1c"
msgid "Of course - as does my god."
msgstr "물론, 내가 섬기는 신께서도 그걸 원하실 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Player
#. NodeID = 6c0706d5-e224-b22d-8093-c397007a32fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:6c0706d5-e224-b22d-8093-c397007a32fe
msgctxt "hf5632674g5180g490cga324g41d83e10db6d"
msgid "At least you'll die before the goblins find the children."
msgstr "적어도 고블린이 아이들을 찾기 전엔 당신이 죽어있을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Player
#. NodeID = 70b062c9-e60a-af26-966a-91dccc86dbe2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WYLL(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:70b062c9-e60a-af26-966a-91dccc86dbe2
msgctxt "hb5621e64g59e3g4514gbf34g15bb3113ddb4"
msgid "Not so fast. You've just walked into my trap."
msgstr "그렇겐 안되지. 넌 방금 내 함정으로 걸어들어온 거라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Asharak
#. NodeID = 73452f94-44b9-96af-d407-5d8690e59e5a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:73452f94-44b9-96af-d407-5d8690e59e5a
msgctxt "h4c6fde66gcbf1g41d2g998dgb1956ef3c0a8"
msgid "Oh, hells."
msgstr "이런 젠장."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Player
#. NodeID = 78823f71-dd0d-5a10-abde-c8745ae0e487
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_EVIL or CLERIC_GOOD or CLERIC_NEUTRAL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:78823f71-dd0d-5a10-abde-c8745ae0e487
msgctxt "h0e62cfddge562g4902g9c5fgb9cdae8429ea"
msgid "Your god has no power here."
msgstr "네 신은 여기서 어떤 힘도 행하지 못한다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Player
#. NodeID = 822b6bf2-3436-5115-0622-c68b8d488e00
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRUID(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:822b6bf2-3436-5115-0622-c68b8d488e00
msgctxt "h79389be9g6fa1g4f28ga82cg2eae33c0cc3c"
msgid "This place is sacred to Silvanus - the Absolute has no power here."
msgstr "이곳은 실바누스님의 성역이다. 절대자는 이곳에 어떠한 힘도 행사하지 못해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Player
#. NodeID = 87cb98dd-ea52-763b-fa67-72b4e2d41152
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(3) = True
#.      - OATHBREAKER(3) = True
#. SetFlags:
#.   Global:
#.     - DEN_AttackOnDen_Event_TieflingsGoHostile = True
#.   Object:
#.     - DEN_AttackOnDen_Event_PlayerOpensGate(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:87cb98dd-ea52-763b-fa67-72b4e2d41152
msgctxt "h5c25b669g3214g4d7bg9f0aga95cabb9b760"
msgid "<i>They still think I'm on their side. Poor fools.</i>"
msgstr "<i>아직 내가 자기들 편인 줄 아는군. 불쌍한 멍청이들 같으니.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Asharak
#. NodeID = 889b135b-468e-4c3b-2d51-45e6ef9dc3b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:889b135b-468e-4c3b-2d51-45e6ef9dc3b3
msgctxt "hef2ef521g1e69g4082gac9ag2e0b607fda74"
msgid "Anyone who takes down a worg gets their choice of cut tonight..."
msgstr "워그를 쓰러뜨리는 자에게는 원하는 부위를 내어 주마..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Wyll
#. NodeID = ac7118c3-8bef-02b2-8962-1e44e7fefc2a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - AVATAR(4) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:ac7118c3-8bef-02b2-8962-1e44e7fefc2a
msgctxt "h0f5c2167g90aeg4ceega757g671d0b3f59d0"
msgid "Traitor! The Blade now comes for <i>you</i>."
msgstr "배신자! 칼날이 이제 <i>네놈</i>을 겨누리라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Asharak
#. NodeID = af6f6673-cd91-47f5-8857-3a32973092df
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:af6f6673-cd91-47f5-8857-3a32973092df
msgctxt "ha1bab7a2g33d4g4a20ga3fbgd31e522bdf73"
msgid "By Amaunator's Eternal Sun, none of us are dying today!"
msgstr "아마우네이터의 영원한 태양 아래, 그 누구도 오늘 죽지 않으리라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Zevlor
#. NodeID = b28a4376-1468-bf34-3a3b-04d3c4845483
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:b28a4376-1468-bf34-3a3b-04d3c4845483
msgctxt "hcce0d021g8062g470ega0c1g8f8afbb6c609"
msgid "This is it. Everything turns on this."
msgstr "이거야. 이걸로 모든 게 바뀔 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Asharak
#. NodeID = b81cb1b9-d7ee-bcd1-7e9d-e34fbd072be3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:b81cb1b9-d7ee-bcd1-7e9d-e34fbd072be3
msgctxt "hc928780ag5429g45c8g972cgb3ec872abf05"
msgid "This is it, people. Weapons ready, eyes to the front."
msgstr "여러분, 때가 되었습니다. 무기를 준비하고 전방을 주시하십시오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Narrator
#. NodeID = bd0aa9e5-e4f1-c336-d88b-c9b69f038043
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:bd0aa9e5-e4f1-c336-d88b-c9b69f038043
msgctxt "h36249f31gb3acg4dbegba32g5c3ed7de8736"
msgid "*A splinter of ice works its way into your mind.*"
msgstr "*머릿속으로 얼음장 같은 파편이 파고듭니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Player
#. NodeID = c11057e5-dbdd-87d3-88c2-892b5e65a3d5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ASTARION(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:c11057e5-dbdd-87d3-88c2-892b5e65a3d5
msgctxt "h984dba1ag17dag4fd5g8be0gdf92df2f52d4"
msgid "New plan - I tear out <i>your</i> throat."
msgstr "새 계획이다. <i>네놈</i> 목을 찢어주겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Zevlor
#. NodeID = c402bdb7-ec44-1acb-b301-9164887bb90c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:c402bdb7-ec44-1acb-b301-9164887bb90c
msgctxt "h71817505g77cdg4b83gba42g287560e0fe12"
msgid "Oh gods..."
msgstr "신이시여..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Asharak
#. NodeID = d1710571-143b-19eb-6151-33b4d1776d29
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:d1710571-143b-19eb-6151-33b4d1776d29
msgctxt "h989105bcg1a82g4a2fg93a2g587d86f13d89"
msgid "You'll burn in the Hells for this."
msgstr "이번 일로 지옥에서 평생 타오를 걸세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Player
#. NodeID = d5cdc9d5-194f-c34c-d950-466324010bad
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - LAEZEL(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:d5cdc9d5-194f-c34c-d950-466324010bad
msgctxt "h5923fc00gcf5dg42e0g927cgc0a55aa9dcef"
msgid "There's been a change of plan."
msgstr "계획이 좀 바뀌었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Nightwarden Minthara
#. NodeID = e0a3ab1d-b204-fea5-95b3-8c9eaa8fb02d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:e0a3ab1d-b204-fea5-95b3-8c9eaa8fb02d
msgctxt "hacbce0a3g2c44g44cdgaedeg5466d7901bb5"
msgid "<i>A pretty speech. It almost brings a tear to my eye. </i>"
msgstr "<i>귀여운 연설이군. 거의 눈물을 흘릴 뻔했어. </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Player
#. NodeID = e5e84cb4-6d8c-b35b-9dec-58ed264aef1a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:e5e84cb4-6d8c-b35b-9dec-58ed264aef1a
msgctxt "h466f2a01g08e0g4db5g886egeeb63980cdd1"
msgid "No. This grove is under my protection."
msgstr "아니. 이 숲은 내 보호 아래 있다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Player
#. NodeID = e8424f37-23e4-c061-615b-15b5776da73f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:e8424f37-23e4-c061-615b-15b5776da73f
msgctxt "h93907b2ag6f7ag4d1fga243g4bbb68da2196"
msgid "Die in fear, afore a waking nightmare."
msgstr "각성한 악몽 앞에서 두려움에 떨며 죽어라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Asharak
#. NodeID = eb8efb66-be04-b74f-4b2a-5daa2df90077
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_General_State_GateOpened = True
#. SetFlags:
#.   Global:
#.     - DEN_AttackOnDen_Event_CloseGate = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:eb8efb66-be04-b74f-4b2a-5daa2df90077
msgctxt "ha1bab19eg2720g419fg8a84ga7f2d3992349"
msgid "Get that damn gate closed!"
msgstr "저 망할 관문을 닫아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Asharak
#. NodeID = ec3a0123-0d66-11ba-4371-0e1990e3d5aa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:ec3a0123-0d66-11ba-4371-0e1990e3d5aa
msgctxt "h1dc60598g9998g401fg96dagd045508baf6e"
msgid ""
"If I don't see you after the battle... tell the children I took out the drow."
msgstr "전투가 끝나고 절 보지 못하시면... 아이들에게 제가 드로우를 해치웠다고 해주세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Zevlor
#. NodeID = ed65831f-3997-1d5f-6385-0e110f6eedf1
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: !TIEFLING
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:ed65831f-3997-1d5f-6385-0e110f6eedf1
msgctxt "h0a68a593g8926g4a82g8cd5gb84206dbcfba"
msgid "...Hells. You're <i>with</i> them, aren't you?"
msgstr "...망할. 자네 <i>저자들</i> 편에 선 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Zevlor
#. NodeID = ed65831f-3997-1d5f-6385-0e110f6eedf1
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: TIEFLING
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:ed65831f-3997-1d5f-6385-0e110f6eedf1
msgctxt "hfb68b802g497cg4a51g95f7g70a9106eacce"
msgid "...Hells. You're siding <i>with</i> them, against your own people?"
msgstr "...망할. 자네 동족을 배신하고 <i>저들</i> 편에 선 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Nightwarden Minthara
#. NodeID = f6c79467-c0a6-3794-888a-bf4ea7ab1479
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:f6c79467-c0a6-3794-888a-bf4ea7ab1479
msgctxt "hd3d81818g3175g49fbgaef7g105d9f53e1f2"
msgid ""
"<i>You cower behind a doomed god when the Absolute promised you such "
"power?</i>"
msgstr "<i>절대자께서 그런 힘을 약속하셨는데, 이미 운이 다한 신 뒤에 숨겠다는 건가?</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Player
#. NodeID = f963b7d2-c71a-f8cf-a82b-960a35749da1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(3) = True
#.      - OATHBREAKER(3) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:f963b7d2-c71a-f8cf-a82b-960a35749da1
msgctxt "h505cf15dgf37dg40bag990bg157a977e4294"
msgid "<i>I will not bring death to this sacred place, Minthara.</i>"
msgstr "<i>이 신성한 곳에 죽음을 불러들이진 않겠다, 민타라.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Zevlor
#. NodeID = fe6beb1d-5fda-b69a-08eb-dbabce7b53e1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:fe6beb1d-5fda-b69a-08eb-dbabce7b53e1
msgctxt "hc2b79fa9g6480g4f7cg8400g3abe122cf91f"
msgid "Nothing personal? You betrayed us!"
msgstr "개인적인 감정은 없다고? 우릴 배신했잖나!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Zevlor
#. NodeID = fe6fcfac-f272-330b-110f-8fda61383af7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:fe6fcfac-f272-330b-110f-8fda61383af7
msgctxt "h42e69febgbee7g409fga3cbg34c1d71d87e3"
msgid "What are you doing? They'll kill us all..."
msgstr "뭘 하는 건가? 그들이 우릴 다 죽여버릴 거야..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight
#. Speaker = Asharak
#. NodeID = ff89ebf5-2b7c-1263-6bb8-6f084a2dcb0f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RaidersArriveBeforeFight:ff89ebf5-2b7c-1263-6bb8-6f084a2dcb0f
msgctxt "hfe4317fagd0abg45f9g9e48g55f8d38ef4e5"
msgid "You <i>monster</i>!"
msgstr "이런 <i>괴물</i>!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Ranged_001
#. Speaker = Booyahg Benta
#. NodeID = 4b706fa4-4074-ed62-ddc0-668eb6c9c848
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Ranged_001:4b706fa4-4074-ed62-ddc0-668eb6c9c848
msgctxt "h4023946eg8be9g454cga330g94bc33c66b7e"
msgid ""
"Only 'avin a laugh - ain't to be messed with, your kind. Whatever you are."
msgstr "거드름 피우지 말고 그냥 웃어 넘겨 - 예쁜 얼굴 구기지 말고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Ranged_001
#. Speaker = Booyahg Benta
#. NodeID = 6a0ad9aa-3d9e-6f17-f7aa-fe8ee7fdf125
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Ranged_001:6a0ad9aa-3d9e-6f17-f7aa-fe8ee7fdf125
msgctxt "hb876b714gd3bag4a44ga0eag531d15b5c8fb"
msgid ""
"<i>Uff. </i>Absolute has me feelin' pow'ful enough to run <i>over </i>that "
"shitey gate."
msgstr "<i>웁. </i>절대자께서 저 망할 문을 <i>넘을</i> 수 있게 힘을 주시는구만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Ranged_001
#. Speaker = Booyahg Benta
#. NodeID = b2838427-e16a-e732-2f79-389b07db88bf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_AttackOnDen_State_Victorious(0) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_Ranged_001_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Ranged_001:b2838427-e16a-e732-2f79-389b07db88bf
msgctxt "hb281ad12g8260g47a4g916fge58b3e4c4668"
msgid "<i>Rhaal'tuuch! </i>Grab the meat while it's fresh, mate!"
msgstr "<i>라알'투우우우쉬! </i>아직 신선할 때 고기를 집으라고, 친구!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Ranged_001
#. Speaker = Booyahg Benta
#. NodeID = c2637926-c5e7-f98a-0636-ca9ebf127008
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_Ranged_001_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Ranged_001:c2637926-c5e7-f98a-0636-ca9ebf127008
msgctxt "h11ad734ag0853g40c6g8316g1b220d9beb25"
msgid "<i>Rhaal'tuuuuuch! </i>"
msgstr "<i>라알'투우우우쉬! </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Ranged_001
#. Speaker = Booyahg Benta
#. NodeID = d63e9660-53c4-25c0-81e9-663ad0b79fcf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_AttackOnDen_State_Victorious(1) = True
#.   Tag:
#.      - GITHYANKI(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_Ranged_001_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Ranged_001:d63e9660-53c4-25c0-81e9-663ad0b79fcf
msgctxt "h76a94155g22d5g460cg9236gd204f1de3a82"
msgid "Hey, good-lookin'. Betcha killed your share with that face alone, eh?"
msgstr "이봐, 예쁜이. 표정을 보니 베챠가 네 몫을 가로챈 모양이지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Refugee001
#. Speaker = Eramas
#. NodeID = 0f371c69-4583-c787-3082-2d96b1a971ee
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Refugee001Victory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Refugee001:0f371c69-4583-c787-3082-2d96b1a971ee
msgctxt "h5eb1039bg1ea9g42fagbe02g59c38e8fd74d"
msgid "We made it, somehow. Now we just need to get to Baldur's Gate."
msgstr "어쨌든 해냈어요. 이제 발더스 게이트로 가기만 하면 돼요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Refugee001
#. Speaker = Eramas
#. NodeID = 11295978-3b52-4ae2-c23c-45736a38e827
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Refugee001:11295978-3b52-4ae2-c23c-45736a38e827
msgctxt "h9cc98fa6ga546g4f99gb991g54008a91bb19"
msgid "Should've taken my own bloody advice."
msgstr "나 참, 누구한테 충고를 하고 있는 건지 원."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Refugee001
#. Speaker = Eramas
#. NodeID = 45b7efd9-ca0d-f2d5-6ad4-61221f97e013
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_General_Refugee1_HasMet(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Refugee001(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Refugee001:45b7efd9-ca0d-f2d5-6ad4-61221f97e013
msgctxt "h1c2b5b44gf6e8g4b8ag9c74g8c24f9e6caff"
msgid "Told you to get out while you could, didn't I?"
msgstr "떠날 수 있을 때 떠나라고 하지 않았던가요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Refugee001
#. Speaker = Eramas
#. NodeID = 47d100e6-9cb0-d267-25f7-5ce514c00ad9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Refugee001(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Refugee001:47d100e6-9cb0-d267-25f7-5ce514c00ad9
msgctxt "h93e12a68gaeddg46cdgb969gb8650f32351c"
msgid ""
"I would run if I were you. Though it's probably too late for that already."
msgstr "제가 당신이었다면 도망쳤을 거예요. 그러기엔 이미 늦었겠지만요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Refugee001
#. Speaker = Eramas
#. NodeID = 53416372-97fa-03b4-967e-04d736b11293
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Refugee001Victory(1) = True
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Refugee001:53416372-97fa-03b4-967e-04d736b11293
msgctxt "hd8d7159egcee2g4900g97f7g08aead4e1889"
msgid "I shouldn't have doubted you. Or the others."
msgstr "당신과 다른 사람들을 의심하지 말았어야 했는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Refugee001
#. Speaker = Eramas
#. NodeID = 7ba966a0-e046-5fbc-4b23-879619986500
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Refugee001(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Refugee001:7ba966a0-e046-5fbc-4b23-879619986500
msgctxt "hef8a0c8cgfdf0g4e7cg90c8gbde522f9fb50"
msgid ""
"This place will be a death trap if the goblins breach the wall. Mark my "
"words."
msgstr "고블린들이 방책을 돌파하면 이 지역은 살벌한 함정이 될 거예요. 기억해 둬요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Refugee001
#. Speaker = Eramas
#. NodeID = f30af434-9e50-f40b-19fa-b17ef8ff2c7d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_General_Refugee1_HasMet(1) = True
#.      - DEN_AttackOnDen_HasMet_Refugee001(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Refugee001:f30af434-9e50-f40b-19fa-b17ef8ff2c7d
msgctxt "h4cedbfe5g46c8g4fb6gbb74gacc4f3d911d0"
msgid "You were a fool to come back here."
msgstr "당신이 여기로 돌아온 건 멍청한 짓이었어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Refugee002
#. Speaker = Danis
#. NodeID = 5bad5264-549c-6929-fd6c-b895ffdcff97
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Refugee002Victory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Refugee002:5bad5264-549c-6929-fd6c-b895ffdcff97
msgctxt "h0890bd59gb892g4671g9a17g0202bcd377b5"
msgid ""
"Gods, it seems we might actually make it to the city now. Hope the "
"neighbours are a bit more welcoming."
msgstr "이야, 이젠 진짜로 도시에 닿는 게 가능하겠다 싶은걸. 부디 거기 사람들은 좀 더 살갑게 반겨주면 좋겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Refugee002
#. Speaker = Danis
#. NodeID = 668cc468-ab62-b3e4-abba-a82bf791c722
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Refugee002Victory(1) = True
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Refugee002:668cc468-ab62-b3e4-abba-a82bf791c722
msgctxt "h7009efeag4733g4484gab4egc159dda4bbf4"
msgid "Thank you, truly. You've given us a chance. We'll make good on it."
msgstr "고마워. 정말로. 넌 우리에게 기회를 준 거야. 헛되이 하지 않을게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Refugee002
#. Speaker = Danis
#. NodeID = e06895c5-9c58-6d1c-1f0e-5bb4a513647d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Refugee002(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Refugee002:e06895c5-9c58-6d1c-1f0e-5bb4a513647d
msgctxt "hc86c2e59g627eg4329g861ag081bd8df7aa0"
msgid ""
"When they see you on the walls, they might just turn and run the other way, "
"eh?"
msgstr "네가 방벽에 떡하니 있는 걸 보면 놈들이 그대로 뒤돌아 내뺄지도 모르겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Refugee002
#. Speaker = Danis
#. NodeID = e7c65b4b-2bb2-4377-4707-91ca7e9fd3e2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Refugee002(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Refugee002:e7c65b4b-2bb2-4377-4707-91ca7e9fd3e2
msgctxt "hd18a4fd8g61e1g496bg9befg286a5f7815d8"
msgid ""
"I wish I could help on the walls, but... I wasn't a <i>soldier</i>, really. "
"Just a trumped-up guard."
msgstr "나도 방책에 나가 보탬이 되고 싶지만... 난 <i>군인</i>이었던 적이 없다고. 땜빵용 경비 노릇이나 해봤지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Refugee002
#. Speaker = Danis
#. NodeID = e959d637-1529-b7ed-db49-96e5187b89e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Refugee002:e959d637-1529-b7ed-db49-96e5187b89e6
msgctxt "h6bd714e3gb604g4ee0g8c61g29e9cd016cf3"
msgid "I... I can't. I'm sorry."
msgstr "나... 난 못 하겠어. 미안해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Refugee003
#. Speaker = Bex
#. NodeID = 17856809-91be-3f9a-a35a-ff0066d44152
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Refugee003Victory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Refugee003:17856809-91be-3f9a-a35a-ff0066d44152
msgctxt "h781f8a9agef86g4241g9d17g3cbfd2330fce"
msgid "Still alive. Still <i>alive</i>. Thank you."
msgstr "살아남았다. 아직 <i>살아있다고</i>. 고마워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Refugee003
#. Speaker = Bex
#. NodeID = 3386311b-78c0-4e7c-fe98-fdf7d8f365da
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Refugees_State_LeadersAreDead = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Refugee003Victory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Refugee003:3386311b-78c0-4e7c-fe98-fdf7d8f365da
msgctxt "hb2bef755g2297g49ecgb223g41bda36e529c"
msgid ""
"I knew this would come right if we just stayed positive. Not that your blade "
"didn't help too."
msgstr "긍정만 잃지 않으면 결국 다 잘 풀릴 줄 알았다니까. 물론 그쪽 무력 덕도 봤지만 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Refugee003
#. Speaker = Bex
#. NodeID = 35189f99-dfbd-48f3-b787-f0ae6521595b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Refugee003Victory(1) = True
#.   Global:
#.      - DEN_Refugees_State_LeadersAreDead = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Refugee003:35189f99-dfbd-48f3-b787-f0ae6521595b
msgctxt "hefd96eceg39d7g48abgb985g9f054806256c"
msgid ""
"This place... it's a pity we can't stay. Doubt there's this much green in "
"the entire city."
msgstr "이곳 말인데... 여기 머물지 못하는 건 아쉽네. 도시에선 어디서도 이만한 녹음은 누리기 힘들 거잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Refugee003
#. Speaker = Bex
#. NodeID = 457e22fa-2117-1567-19f3-60e1319cd575
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Refugee003(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Refugee003:457e22fa-2117-1567-19f3-60e1319cd575
msgctxt "hbd63cd89gff9cg420cg9284g7952042671b5"
msgid "Stay safe up there. Neither of us want me stitching you up."
msgstr "부탁인데 몸조심 해. 내 솜씨론 네 몸 꿰맬 일 없는 편이 낫다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Refugee003
#. Speaker = Bex
#. NodeID = 6a2f5dcc-d5e1-2445-24ee-aaef241c303c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Refugee003(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Refugee003:6a2f5dcc-d5e1-2445-24ee-aaef241c303c
msgctxt "hc1028804ge87ag43a2gb95bg8ae69228752e"
msgid "Someone decided we were the best suited to see to any wounded."
msgstr "누가 우리는 부상자 돌보는 편이 딱 맞겠다고 판단한 모양이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Refugee003
#. Speaker = Bex
#. NodeID = 984673b1-8416-6a30-dcfe-75d652c7859f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Refugee003:984673b1-8416-6a30-dcfe-75d652c7859f
msgctxt "h7f4130b0gb882g4de2g8f5fgafe934950156"
msgid "Better all 'round if you keep everyone in one piece up there. Trust me."
msgstr "차라리 네가 모두를 사지 멀쩡히 지켜내는 편이 나을걸. 정말로 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Refugee003
#. Speaker = Bex
#. NodeID = ddbefb6f-7842-ce2a-b692-ba7a2d94f743
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Refugee003Victory(1) = True
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Refugee003:ddbefb6f-7842-ce2a-b692-ba7a2d94f743
msgctxt "hc2f553begab6dg47dbgbfe7g814f7dd58eb1"
msgid ""
"On to Baldur's Gate! And if they slam the gate on us, we'll bloody well "
"knock it down."
msgstr "발더스 게이트로 간다! 거기 양반들이 문을 열어주지 않으면, 때려 부숴서라도 열어주겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Refugee004
#. Speaker = Toron
#. NodeID = 24cc9343-b436-207d-34c0-6b3133a46fb5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Refugees_State_LeadersAreDead = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Refugee004Victory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Refugee004:24cc9343-b436-207d-34c0-6b3133a46fb5
msgctxt "h5960bf1cg202dg498eg8f04g1838a7dbdd2e"
msgid ""
"Thought you'd left us to our fate, running off like you did. Glad I was "
"wrong."
msgstr "그리 훌쩍 떠나버리길래 우리 버리는 줄만 알았어. 아니어서 다행이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Refugee004
#. Speaker = Toron
#. NodeID = ac00c9dd-a183-50fb-ed99-185fb3fc36b0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Refugee004Victory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Refugee004:ac00c9dd-a183-50fb-ed99-185fb3fc36b0
msgctxt "he9324435g0a38g49c9ga859g9f5930d51fcc"
msgid "That was too close, Tymora smile on us."
msgstr "정말 아슬아슬했어. 티모라께서 미소를 지어주셨군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Refugee004
#. Speaker = Toron
#. NodeID = b195809b-bdeb-7c2f-63b9-63ce25675df3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Refugee004Victory(1) = True
#.   Global:
#.      - DEN_Refugees_State_LeadersAreDead = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Refugee004:b195809b-bdeb-7c2f-63b9-63ce25675df3
msgctxt "h0a42af9cge493g4e94gbab7g62a6403789dd"
msgid ""
"The things the children are saying about you. At least when they were "
"scared, they were <i>quiet.</i>"
msgstr "애들이 그쪽 얘기를 하도 쑥덕거리더라고. 겁에 질려있었을 땐 그나마 <i>조용하기라도 했는데.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Refugee004
#. Speaker = Toron
#. NodeID = b73f0b5b-174b-2747-88c5-f9fc463407ec
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Refugee004Victory(1) = True
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Refugee004:b73f0b5b-174b-2747-88c5-f9fc463407ec
msgctxt "hfd9489a2g2875g49deg9719g57ba8d6f4ba2"
msgid "Let's hope our luck holds out until Baldur's Gate."
msgstr "발더스 게이트에 닿을 때까지 운이 쭉 따라주길 빌어야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Refugee004
#. Speaker = Toron
#. NodeID = b8cbe821-53d4-d56e-fccf-72c5bf824506
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Refugee004(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Refugee004:b8cbe821-53d4-d56e-fccf-72c5bf824506
msgctxt "h4434f532g17a1g424dgbadag4bb686d5490e"
msgid "We can talk after this is over - if we're alive."
msgstr "이 난리통 다 끝난 후에 얘기하자. 그때도 살아있다면."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Refugee004
#. Speaker = Toron
#. NodeID = fb132347-8083-6bdc-9e12-ba172d210807
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Refugee004(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Refugee004:fb132347-8083-6bdc-9e12-ba172d210807
msgctxt "h078871d0g96c7g4a99gb95bg77e3d43223e5"
msgid "Whatever it is, I don't have time."
msgstr "뭔 볼일이든 어울려 줄 시간 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RitualDruid001
#. Speaker = Aelar
#. NodeID = 1500a3e6-19c5-13ac-21a5-2a34ad96cde3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_RitualDruid001(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RitualDruid001:1500a3e6-19c5-13ac-21a5-2a34ad96cde3
msgctxt "h0f488f99g0818g4c70gbe39gc6ae59f4f098"
msgid "None of this feels real. Not yet."
msgstr "이 모든 게 아직 꿈만 같군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RitualDruid001
#. Speaker = Aelar
#. NodeID = 43e4e4a1-e4c9-3c50-268f-0ab02d7d3636
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_RitualDruid001(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_RitualDruid001(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RitualDruid001:43e4e4a1-e4c9-3c50-268f-0ab02d7d3636
msgctxt "h871c5319gd7c7g4ac1g8019g8cf626e3b674"
msgid "Goblins at our gates... you spared us a nightmare."
msgstr "코 앞에 고블린들이라니... 당신이 우리가 악몽을 겪지 않게 해주었군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RitualDruid002
#. Speaker = Karrik
#. NodeID = 2acde161-ee42-58f5-34b0-b96b6952f647
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_RitualDruid002(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_RitualDruid002(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RitualDruid002:2acde161-ee42-58f5-34b0-b96b6952f647
msgctxt "hc6ed45b9g2930g4843gb082g6ac5a4203b99"
msgid "After everything that's happened, you still fought beside us."
msgstr "그 모든 일이 있고서도 그대가 우리 곁에서 싸웠다니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RitualDruid002
#. Speaker = Karrik
#. NodeID = 5b78fb45-e197-52af-9d46-18efbd8a936c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_RitualDruid002(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RitualDruid002:5b78fb45-e197-52af-9d46-18efbd8a936c
msgctxt "h036fb61fgdadag4ac6g872cge24bbb8461dd"
msgid "I hope we learn from this. We have to."
msgstr "이 일로 우리가 배우는 게 있으면 좋겠군. 그래야만 하네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RitualDruid002
#. Speaker = Karrik
#. NodeID = 6d9ec8f0-b02b-d4ae-0f2d-77e134bd23fa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RitualDruid002:6d9ec8f0-b02b-d4ae-0f2d-77e134bd23fa
msgctxt "hf0067273gaf9cg4734gaef6g9d99f2607f75"
msgid "I don't know if we deserved your help, but I'm glad we got it."
msgstr "우리가 그대의 도움을 받을 자격이 있었는지 모르겠지만 받아서 다행이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RitualDruid003
#. Speaker = Inwe
#. NodeID = 71aa0573-a692-6974-042c-0b55fbb9bb3f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_RitualDruid003(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_RitualDruid003(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RitualDruid003:71aa0573-a692-6974-042c-0b55fbb9bb3f
msgctxt "h3f6647abga4cbg492aga9bfg8fc343a6e9b8"
msgid ""
"I'm tempted to leave with the rest of you... but I can't abandon my home."
msgstr "당신들과 떠나고 싶은 마음이 들지만... 집을 버리고 떠날 수는 없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RitualDruid003
#. Speaker = Inwe
#. NodeID = e5775710-f10a-d1c5-663e-47e73f573184
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_RitualDruid003(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RitualDruid003:e5775710-f10a-d1c5-663e-47e73f573184
msgctxt "h09576f08g344cg4dfdg9fbag6477ae35bc2b"
msgid "I pray your road is safe. If only I could walk it myself..."
msgstr "여정이 안전하기를 빌겠어요. 같이 갈 수만 있었다면..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RitualDruid005
#. Speaker = Tahan
#. NodeID = 39ff590d-78ca-3bf3-27d5-bd77b0a6d8bf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_RitualDruid005(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RitualDruid005:39ff590d-78ca-3bf3-27d5-bd77b0a6d8bf
msgctxt "hed7e60f8g2844g47feg9f90g122c73a657b9"
msgid "Every drop of druid blood is on your hands. Remember that."
msgstr "드루이드가 흘린 모든 피는 네 탓이야. 그걸 기억하라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RitualDruid005
#. Speaker = Tahan
#. NodeID = 8cbc4fed-b31d-3ff0-f3ee-27a75c33ccf3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RitualDruid005:8cbc4fed-b31d-3ff0-f3ee-27a75c33ccf3
msgctxt "h9bc54a04gb572g4de2gbdf9g8a62aef313ab"
msgid "It wasn't our fight. You dragged us into it."
msgstr "이건 우리의 싸움이 아니었어. 네가 끌어들인 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RitualDruid005
#. Speaker = Tahan
#. NodeID = a14111fa-3499-75c5-c8e5-0981649091f9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_RitualDruid005(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_RitualDruid005(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RitualDruid005:a14111fa-3499-75c5-c8e5-0981649091f9
msgctxt "h9c11e627g13e9g4b94ga31egdeb8f545da48"
msgid ""
"I'm not singing your praises. You and the tieflings brought violence to this "
"place."
msgstr "난 널 칭송하지 않겠어. 너와 티플링들이 이곳에 폭력을 불러왔는걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RobberKid
#. Speaker = Player
#. NodeID = 1244375b-6db6-6b2c-1e48-a7d3cf587938
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RobberKid:1244375b-6db6-6b2c-1e48-a7d3cf587938
msgctxt "h6b27a00cg9d2ag46c5g8bbage7b05b8541b7"
msgid ""
"If I fall today, my killer will have earned my hide as a ceremonial display."
msgstr "내가 오늘 죽으면, 놈들이 내 가죽을 벗겨 기념품으로 멋드러지게 삼겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RobberKid
#. Speaker = Meli
#. NodeID = 12a50220-5448-58b7-7711-c08065c62b6b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RobberKid:12a50220-5448-58b7-7711-c08065c62b6b
msgctxt "h067cd30cg15dbg4387g9aeega811dbee851f"
msgid "So you say - survived Avernus, though. More than you've done."
msgstr "어련하실까. 근데 난 아베르누스에서도 살아남았어. 댁보단 잘 살 거라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RobberKid
#. Speaker = Meli
#. NodeID = 23f78eed-6d73-8607-fc94-853caaf71b15
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_RobberKid(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RobberKid:23f78eed-6d73-8607-fc94-853caaf71b15
msgctxt "h777d291dg4cb4g4c70ga49eg55073cb772be"
msgid "Hope you've picked your last words."
msgstr "미리 유언 잘 골라놨길 바라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RobberKid
#. Speaker = Meli
#. NodeID = 2c19bb99-9e22-6b4e-f2a4-20265c671d7b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RobberKid:2c19bb99-9e22-6b4e-f2a4-20265c671d7b
msgctxt "h700771b9g92f2g4db5gb4efgb53d5e91a96f"
msgid ""
"Dunno what that means. But the goblins might think you're on their side - "
"you're ugly enough."
msgstr "그게 뭔 소리래. 고블린들은 댁이 자기네 편인 줄 알 걸? 존나 못생겼거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RobberKid
#. Speaker = Meli
#. NodeID = 59dbc4b3-8b19-72ee-5cc3-d22895e75f66
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RobberKid:59dbc4b3-8b19-72ee-5cc3-d22895e75f66
msgctxt "hdce04c74g20e2g4c5ag9cfbgec7032f47a7c"
msgid "Goblins strip the dead down to the last stitch, so I hear."
msgstr "고블린들은 죽은 놈을 싹 다 벗겨 먹는 대거든. 듣기론 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RobberKid
#. Speaker = Player
#. NodeID = 661834c4-5eda-988f-f828-664e847aedf9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RobberKid:661834c4-5eda-988f-f828-664e847aedf9
msgctxt "h4013dc56gbd46g4815gb3fcg61f297f70ed5"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RobberKid
#. Speaker = Meli
#. NodeID = 86e57c01-2ea6-621a-c878-7bf1c853848c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_RobberKid(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RobberKid:86e57c01-2ea6-621a-c878-7bf1c853848c
msgctxt "hf4810e53gc83fg4174g9ea3gc5eabd45e247"
msgid "You can leave your valuables with me if you like."
msgstr "뭐하면 귀중품은 나한테 맡겨놓고 가도 돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RobberKid
#. Speaker = Player
#. NodeID = 874f19bd-7077-64e0-7d6c-52ed829cdf31
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RobberKid:874f19bd-7077-64e0-7d6c-52ed829cdf31
msgctxt "hb9b8c554g7dedg43fdgb72fg570183ab023a"
msgid "Best pray they don't kill me, then - they'll get you next."
msgstr "내가 놈들한테 죽지 않기나 빌어. 나 죽으면 다음 차례는 너니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RobberKid
#. Speaker = Meli
#. NodeID = 8c905907-fe49-e7d4-06d5-01df2862653e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RobberKid:8c905907-fe49-e7d4-06d5-01df2862653e
msgctxt "h8f77f6cag9f09g4d13gaca7g118767796971"
msgid "<i>See you later</i>, then."
msgstr "그렇다면 <i>나중에 봐</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RobberKid
#. Speaker = Meli
#. NodeID = 97445ae0-c82f-945e-3396-85fa871b1f65
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RobberKid:97445ae0-c82f-945e-3396-85fa871b1f65
msgctxt "he84778d9g310eg4287ga96ag11baae2aae98"
msgid "Prefer lies, do you?"
msgstr "거짓말이 낫다는 쪽이셔?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RobberKid
#. Speaker = Meli
#. NodeID = ac53c3c8-ac3f-99b3-4f0e-79bc86120995
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_RobberKidVictory(1) = True
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RobberKid:ac53c3c8-ac3f-99b3-4f0e-79bc86120995
msgctxt "h61426141g15ebg44c3g9742ge78016bae4a1"
msgid ""
"An actual city, though. Lotta fat arses with full purses in a <i>city.</i>"
msgstr "그래도 진짜 도시로 가네. 두둑한 지갑 찬 덩어리들이 널린 <i>도시로.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RobberKid
#. Speaker = Player
#. NodeID = ecdaf8be-cceb-65ae-67af-5edb36868c33
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RobberKid:ecdaf8be-cceb-65ae-67af-5edb36868c33
msgctxt "hb4bd9bbfg56e8g4431g9e6fg9935be0dd9b8"
msgid "No one's going to die today. I promise."
msgstr "오늘은 아무도 죽지 않아. 장담해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RobberKid
#. Speaker = Meli
#. NodeID = f2d57e56-d96c-5d85-4b34-18943cbd94a1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_RobberKidVictory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_RobberKid:f2d57e56-d96c-5d85-4b34-18943cbd94a1
msgctxt "h199130b9g2562g4436gbf0cg49086fb967fb"
msgid "Don't know why everyone's cheering. We're just going back on the road."
msgstr "다들 뭐가 좋다고 난리인 걸까. 그냥 도로 갈 길 나서게 된 것뿐인데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Sapper_001
#. Speaker = Sapper Moke
#. NodeID = 0c1bf195-d391-f0c6-848c-56ccaa9d4ae9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Sapper_001:0c1bf195-d391-f0c6-848c-56ccaa9d4ae9
msgctxt "h2c6ae9f3g2251g4c35g87f8g9973b8bd70ff"
msgid "Back off! Got enough powder to blow us all to bits!"
msgstr "물러나! 존나게 많은 화약이다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Sapper_001
#. Speaker = Sapper Moke
#. NodeID = f540a3d4-7fec-7352-2cd6-3acae0e9d4da
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_AttackOnDen_State_Victorious(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Sapper_001:f540a3d4-7fec-7352-2cd6-3acae0e9d4da
msgctxt "h369c93dbg5cf1g4a95ga29fg3b803b0919fa"
msgid "This place is <i>ours</i> now."
msgstr "이제 여긴 <i>우리 거야</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Sapper_002
#. Speaker = UNKNOWN_CHARACTER
#. NodeID = 2e47ca09-da37-398b-1f19-5c8d7a927afe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Sapper_002:2e47ca09-da37-398b-1f19-5c8d7a927afe
msgctxt "h7bd391d9gbca6g444cgba14gd5ea5884e5a0"
msgid "... when I hit 'em with this stuff, it'll barely leave a stain."
msgstr "... 이걸로 한 방이면 흔적도 안 남을 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Sapper_002
#. Speaker = UNKNOWN_CHARACTER
#. NodeID = 4a58596f-6fd8-d43b-1e03-513dc9c4dc32
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_AttackOnDen_State_Victorious(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Sapper_002:4a58596f-6fd8-d43b-1e03-513dc9c4dc32
msgctxt "h9532c868gb24ag40b2g8682gd3ef7689375b"
msgid "Plenty of tieflin' meat for the lads back at camp..."
msgstr "야영지에 있는 녀석들에게 줄 티플링 고기들이 넉넉하겠는데..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Sapper_002
#. Speaker = UNKNOWN_CHARACTER
#. NodeID = 973cf871-ca29-c012-047e-fd806a3ba27e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Sapper_002:973cf871-ca29-c012-047e-fd806a3ba27e
msgctxt "h11bb7057gc87eg435fg9941g7f21db183ae4"
msgid "Guess we ain't takin' prisoners..."
msgstr "포로를 데려갈 일은 없겠군..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Sapper_003
#. Speaker = Sapper Dextor
#. NodeID = 938a3afa-0ab5-2216-c77a-3cc18e2e580b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_AttackOnDen_State_Victorious(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Sapper_003:938a3afa-0ab5-2216-c77a-3cc18e2e580b
msgctxt "hf4f1dcaagdb80g421eg9eaagb3cc3ff0c5a6"
msgid "Don't be nickin' the best loot for yerself."
msgstr "니네 전리품만 챙기지들 말라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Sapper_003
#. Speaker = Sapper Dextor
#. NodeID = a919d076-4c43-0fc9-175f-0b74ea354efb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Sapper_003:a919d076-4c43-0fc9-175f-0b74ea354efb
msgctxt "hf360c89bge496g4ce1gb749g23fb69e28e5f"
msgid "BURN IT DOWN!"
msgstr "<b>다 태워버려</b>!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Sapper_004
#. Speaker = Sapper Gald
#. NodeID = 084ac0db-3ff0-fd00-2996-5aef0f457098
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_AttackOnDen_State_Victorious(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Sapper_004:084ac0db-3ff0-fd00-2996-5aef0f457098
msgctxt "hba38c47fge6f8g4a1fgae89g6d33bd9e5ec5"
msgid "Tieflin's ain't so tough..."
msgstr "약해 빠진 티플링 놈들..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Sapper_004
#. Speaker = Sapper Gald
#. NodeID = 37827a50-29a1-b070-0e99-532bd0d2b1ca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Sapper_004:37827a50-29a1-b070-0e99-532bd0d2b1ca
msgctxt "h3b6af522g6168g4515gb49bg8c79eb9b6043"
msgid "For the Absolute!"
msgstr "절대자님을 위해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ScoutCaptive
#. Speaker = Findal
#. NodeID = 1f15a4e1-c753-79cc-9f62-656d1e70e30c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_ScoutCaptive(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ScoutCaptive:1f15a4e1-c753-79cc-9f62-656d1e70e30c
msgctxt "hae075ab3gdf71g42beg816cg0eebc84abb32"
msgid "You're starting to feel like my personal bodyguard. I wish you were."
msgstr "당신이 제 경호원인 것만 같아요. 진짜였으면 좋겠는데요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ScoutCaptive
#. Speaker = Findal
#. NodeID = d28896ae-e029-b7b6-2b63-fca256777017
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_ScoutCaptive(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ScoutCaptive:d28896ae-e029-b7b6-2b63-fca256777017
msgctxt "he9b5cc4ag3fe5g4544gb5a8gd544a59a3e7a"
msgid "Farewell, friend."
msgstr "잘 가요, 친구."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant001
#. Speaker = UNKNOWN_CHARACTER
#. NodeID = 77906877-02c8-3881-c06e-4a8fd00d29d8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Servant001Victory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant001:77906877-02c8-3881-c06e-4a8fd00d29d8
msgctxt "hbf8ac4b4g41b0g41bbgb3eegef6d545f5ab4"
msgid "This is a holy sanctuary, not a bazaar. Please leave."
msgstr "이곳은 신성한 성역이지, 시장 바닥이 아닙니다. 그만 떠나주세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant001
#. Speaker = UNKNOWN_CHARACTER
#. NodeID = b9a15d29-fd82-c2ec-e90c-31cba9456a53
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Servant001Victory(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Servant001Victory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant001:b9a15d29-fd82-c2ec-e90c-31cba9456a53
msgctxt "he604668bgd15bg4d87gaf97g357f2bcd5726"
msgid ""
"You've exhausted the goodwill of this place. Leave, before you bring more "
"danger."
msgstr "더 이상의 호의는 없습니다. 이곳을 더 위험하게 만들지 말고 떠나십시오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant002
#. Speaker = Player
#. NodeID = 095952d8-e98e-dc55-43f7-694eb23b10a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant002:095952d8-e98e-dc55-43f7-694eb23b10a5
msgctxt "hd7c725b2g3ed1g4bcbg894dg16a1aa8c9447"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant002
#. Speaker = Marcoryl
#. NodeID = 224ce7f6-4f15-a4e6-0e93-52ab7272ae73
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant002:224ce7f6-4f15-a4e6-0e93-52ab7272ae73
msgctxt "hbc9be488gbb3dg4cd7g908fg278ecc11422a"
msgid "Besides, you survived. I'll not apologise for my actions."
msgstr "어쨌든 당신은 살아 남았죠. 내가 했던 일에 대해선 사과하지 않을 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant002
#. Speaker = Player
#. NodeID = 246a32a9-8a6c-c1c4-0d38-5c1f8fd6afce
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_LairDoor(1) = True
#.   Local:
#.      - 0e0c00af-ca53-9294-317d-4dc94bf79247_Den_AttackOnDen_Servant002_Q1 = False
#. SetFlags:
#.   Local:
#.     - 0e0c00af-ca53-9294-317d-4dc94bf79247_Den_AttackOnDen_Servant002_Q1 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant002:246a32a9-8a6c-c1c4-0d38-5c1f8fd6afce
msgctxt "h1b103950g3692g42e4g9f62ga044c9a9b9e8"
msgid "And before the attack - were you 'sheltering', or just plain cowering?"
msgstr "공격하기 전에, 방금 그건 '보호 행위'였나, 아니면 그냥 겁먹은 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant002
#. Speaker = Marcoryl
#. NodeID = 27f63954-7552-b714-f6d4-6cb9395fdba9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant002:27f63954-7552-b714-f6d4-6cb9395fdba9
msgctxt "ha053eeecg3e82g44bcg938ag12cc1469bc8c"
msgid ""
"The dignity of the grove comes first. It cannot be tended to if its "
"custodians are dead."
msgstr "숲의 존엄이 먼저입니다. 수호자가 죽더라도 변하지 않아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant002
#. Speaker = Player
#. NodeID = 2bbf1659-b4ea-3774-2d53-4d012d5df5f7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 0e0c00af-ca53-9294-317d-4dc94bf79247_Den_AttackOnDen_Servant002_Q1 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant002:2bbf1659-b4ea-3774-2d53-4d012d5df5f7
msgctxt "h32e46fe2gab31g4ac2gbad5ge1aa2be1c597"
msgid "You disgust me."
msgstr "역겹군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant002
#. Speaker = Player
#. NodeID = 32d1e23a-368b-022c-7578-cdbb476fe990
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_Servant002_Apologetic(1) = False
#.   Local:
#.      - 0e0c00af-ca53-9294-317d-4dc94bf79247_Den_AttackOnDen_Servant002_Q1 = False
#.   Tag:
#.      - DRUID(1) = True
#. SetFlags:
#.   Local:
#.     - 0e0c00af-ca53-9294-317d-4dc94bf79247_Den_AttackOnDen_Servant002_Q1 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant002:32d1e23a-368b-022c-7578-cdbb476fe990
msgctxt "h113f0541gb722g48dfg9760gcb108087461d"
msgid ""
"Do not presume to speak for this place - not when you did nothing to defend "
"it."
msgstr "이 숲을 위해 말하는 척하지 마라. 네가 여길 지키는 데 아무것도 하지 않았다면 특히."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant002
#. Speaker = Marcoryl
#. NodeID = 44c515be-1307-0643-351b-f905a08c58a1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant002:44c515be-1307-0643-351b-f905a08c58a1
msgctxt "h3decde95gcea0g4033gbc29g2a32e5081170"
msgid "I answer to Silvanus and Silvanus only. And you are not the Oak Father."
msgstr "나는 실바누스께만 답합니다. 그리고 당신은 실바누스가 아니고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant002
#. Speaker = Marcoryl
#. NodeID = 6454b012-c1a3-a0e9-b099-2b8c251c71d1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant002:6454b012-c1a3-a0e9-b099-2b8c251c71d1
msgctxt "h1aafab95gb154g446bga24ag7b26267e49c7"
msgid "Make it quick. You're disrupting the harmony of this holy place."
msgstr "빨리 가세요. 당신들은 이 성역의 조화를 해치고 있습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant002
#. Speaker = Marcoryl
#. NodeID = 678ac664-0072-c205-a783-f7b104f49d71
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Servant002Victory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant002:678ac664-0072-c205-a783-f7b104f49d71
msgctxt "hbc82de5agac07g42e5g827ag99ccb84f9ef7"
msgid ""
"We cannot restore balance to the grove while you continue <i>loitering</i>. "
"Please leave."
msgstr "당신들이 이곳을 <i>싸돌아다니는</i> 동안에는 숲의 조화를 회복할 수 없습니다. 제발 가주세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant002
#. Speaker = Marcoryl
#. NodeID = 73a3ecbc-2f26-d046-e887-5da0ae4c1c85
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant002:73a3ecbc-2f26-d046-e887-5da0ae4c1c85
msgctxt "h3ee9bb1bga71eg4d20g9eb8g47518843c7d8"
msgid ""
"Within the inner sanctum, of course. It is not for us to fight <i>your "
"</i>battles."
msgstr "물론 내부 성소에 있었죠. <i>당신네 </i>싸움에 우리가 끼어들 건 아니었으니까요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant002
#. Speaker = Marcoryl
#. NodeID = 913f0e33-185a-ea38-b543-dcdffe67d01a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant002:913f0e33-185a-ea38-b543-dcdffe67d01a
msgctxt "hae61ca18gdcf0g4c05gad87g774ecc476327"
msgid "I assure you - the feeling is mutual."
msgstr "동감합니다. 그 감정은 피차일반입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant002
#. Speaker = Player
#. NodeID = a1aa7de4-adf7-a8c8-9ecb-a4175228cd9e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_LairDoor(1) = False
#.   Local:
#.      - 0e0c00af-ca53-9294-317d-4dc94bf79247_Den_AttackOnDen_Servant002_Q1 = False
#. SetFlags:
#.   Local:
#.     - 0e0c00af-ca53-9294-317d-4dc94bf79247_Den_AttackOnDen_Servant002_Q1 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant002:a1aa7de4-adf7-a8c8-9ecb-a4175228cd9e
msgctxt "h3847cba3g6b10g4c0dga798g6ba864286130"
msgid "Where were you during the attack?"
msgstr "습격 당시에는 어디에 있었지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant002
#. Speaker = Player
#. NodeID = bf328a63-1dd4-86aa-2592-20e9b1477504
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 0e0c00af-ca53-9294-317d-4dc94bf79247_Den_AttackOnDen_Servant002_Q1 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant002:bf328a63-1dd4-86aa-2592-20e9b1477504
msgctxt "h9e6e9689g8d46g497fg82bag515f0ecfea97"
msgid "I'll be on my way soon."
msgstr "곧 내 갈 길 가지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant002
#. Speaker = Marcoryl
#. NodeID = eaa13e1e-0493-24d3-2979-003efc792a5e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Servant002Victory(1) = False
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Servant002Victory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant002:eaa13e1e-0493-24d3-2979-003efc792a5e
msgctxt "hdaa30c9dgbe8cg4b73g9662gc5f31e27ea10"
msgid ""
"I think it's high time you all left - our sacred grove has sheltered you "
"enough."
msgstr "이제 당신네 모두 떠날 때가 된 것 같습니다. 저희 신성한 숲이 여러분을 충분히 보호해줬습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant003
#. Speaker = Loic
#. NodeID = 0920bf14-79b5-5972-bffb-1db2b4efdb1b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Servant003Victory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant003:0920bf14-79b5-5972-bffb-1db2b4efdb1b
msgctxt "h63ce61a1g8592g4b19g9802ga7fb311eecf6"
msgid "The others are leaving - why don't you do the same?"
msgstr "남들은 다 떠났습니다. 당신도 그러시는 게 어떠십니까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant003
#. Speaker = Loic
#. NodeID = a4cb56b1-6582-74fa-fef3-b83aa5e70790
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Servant003Victory(1) = True
#.   Global:
#.      - DEN_TieflingRefugees_State_LeftDen = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant003:a4cb56b1-6582-74fa-fef3-b83aa5e70790
msgctxt "h8f0ab0deg0228g4db0gb1ecg8cab3cfa195f"
msgid "You're the only one still dawdling here. We need some quiet."
msgstr "여기서 꾸무럭대는 건 당신 하나 뿐입니다. 이제 좀 조용하게 있고 싶네요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant003
#. Speaker = Loic
#. NodeID = e176eda5-9ea9-b4c4-f2df-46fbb0ffb5dd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Servant003Victory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant003:e176eda5-9ea9-b4c4-f2df-46fbb0ffb5dd
msgctxt "h288b046bg5379g400agac59g4b4b526d4807"
msgid "You did this grove a great favour. Now leave the rest to us."
msgstr "당신은 이 숲에 엄청난 호의를 베푸셨죠. 이제 나머진 저희에게 맡기세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant004
#. Speaker = Elwyn
#. NodeID = 5c2e1c2e-dfe7-1661-79af-b73399097a66
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Servant004Victory(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Servant004Victory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant004:5c2e1c2e-dfe7-1661-79af-b73399097a66
msgctxt "hd9e879b1g7f4cg4050g8beeg83a2a00224a1"
msgid ""
"I didn't think we'd survive the goblins. I kept imagining the screams, the "
"blood..."
msgstr "고블린들에게서 살아남지 못할 줄 알았어요. 비명들, 그리고 흥건한 피가 머릿속에서 좀처럼 떠나지 않아요..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant004
#. Speaker = Elwyn
#. NodeID = cc6f4014-ac1d-568c-e381-381c6dbbd7fe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Servant004Victory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant004:cc6f4014-ac1d-568c-e381-381c6dbbd7fe
msgctxt "h498c2284ge8edg4d11g8b65g62d7328c5c4f"
msgid "I feel like we can finally breathe. Thank you."
msgstr "이제야 겨우 숨이 좀 놓이네요. 고맙습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant005
#. Speaker = Arron
#. NodeID = 07a202d1-8ce5-84c1-c214-c42528c43c4f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant005:07a202d1-8ce5-84c1-c214-c42528c43c4f
msgctxt "hee17bc50g7e29g4c9dgac6dgc559695d97ae"
msgid "As am I. And I'm sure those poor refugees would quite agree."
msgstr "나도 그렇소. 그리고 다른 불쌍한 피난민도 분명 같은 생각일 것이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant005
#. Speaker = Arron
#. NodeID = 388d49ae-dc19-2400-64f2-e5194b4d2d17
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Refugees_State_LeadersAreDead = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Servant005Victory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant005:388d49ae-dc19-2400-64f2-e5194b4d2d17
msgctxt "hf455c214gfa9bg4c14gb0fdgb0feacabd08c"
msgid ""
"So it's true. You scattered the goblins. Peace can finally return to this "
"corner of the Sword Coast. Thank you."
msgstr "과연 사실이군. 당신이 고블린을 소탕했어. 마침내 소드 코스트의 이 외딴 곳에도 평화가 찾아오겠군. 고맙소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant005
#. Speaker = Arron
#. NodeID = 3cc7eb04-6d42-4492-13b4-756ffc856680
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KaghaIsDead = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Servant005Victory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant005:3cc7eb04-6d42-4492-13b4-756ffc856680
msgctxt "hef2dc139ge5b6g4b12g8210g43e5a41ba976"
msgid ""
"By the trees, I never liked the ritual, but when I saw that drow, I admit I "
"wished we'd finished it."
msgstr "나무에 맹세코, 그 의식이 마음에 들진 않았지만, 그 드로우를 보니 의식을 끝마쳤어야 한다는 생각이 들었소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant005
#. Speaker = Arron
#. NodeID = 4a71aa7f-733c-fc86-7f28-efbef868c6a2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant005:4a71aa7f-733c-fc86-7f28-efbef868c6a2
msgctxt "h8835a016g07e2g4274g9706gb4c14db7f243"
msgid "Of course."
msgstr "물론."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant005
#. Speaker = Arron
#. NodeID = 58db17fb-535c-0d68-607d-6f83eeda4325
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Servant005Victory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant005:58db17fb-535c-0d68-607d-6f83eeda4325
msgctxt "hfcd6e12eg45fag4385gad35geaf4f7619885"
msgid ""
"It'll take a while for us all to recover, but you've helped us take the "
"first step."
msgstr "모두가 회복하려면 시간이 걸리겠지만, 당신 덕에 첫 번째 난관은 넘었소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant005
#. Speaker = Player
#. NodeID = 7ab60779-880d-0237-f24c-e1a9e7c95b35
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant005:7ab60779-880d-0237-f24c-e1a9e7c95b35
msgctxt "h81bc63faga85cg408dg9b88g7e29214de032"
msgid "I want to trade, if you have anything good."
msgstr "거래를 하고 싶군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant005
#. Speaker = Arron
#. NodeID = a9fd172b-6a3a-3beb-57cf-ea5dcbfaeaad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant005:a9fd172b-6a3a-3beb-57cf-ea5dcbfaeaad
msgctxt "h5d61af87gf7f1g4835gaf95g36aa891b1383"
msgid "I don't know what we would have done without you."
msgstr "당신이 없었다면 우리가 어떻게 했을지 모르겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant005
#. Speaker = Player
#. NodeID = ab05648b-177c-d92c-2a6b-ea1b52c820fc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_Servant005_Answered(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_Servant005_Answered(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant005:ab05648b-177c-d92c-2a6b-ea1b52c820fc
msgctxt "h5d312577gba06g4f9egbd43g04f520157c3c"
msgid "I'm just glad I could help."
msgstr "도와줄 수 있어서 기쁠 따름입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant005
#. Speaker = Arron
#. NodeID = b4aa4756-398e-4164-0760-fe13fb0ee5e0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant005:b4aa4756-398e-4164-0760-fe13fb0ee5e0
msgctxt "h514bb75bgc365g4651g9529gf67f251bb50f"
msgid "Well! To each their own."
msgstr "그래! 각자의 사정이 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant005
#. Speaker = Arron
#. NodeID = b852117a-7e5c-c18b-18b8-cac3ab4599a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant005:b852117a-7e5c-c18b-18b8-cac3ab4599a7
msgctxt "hbcc51f92g9a55g4cc8g9499ga2395b70fa8f"
msgid "But you've solved both those problems in one go."
msgstr "하지만 그대는 두 문제를 한번에 해결했소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant005
#. Speaker = Player
#. NodeID = c47d177b-651b-aa4e-14f6-ec58c25fb1ef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant005:c47d177b-651b-aa4e-14f6-ec58c25fb1ef
msgctxt "h9e724a1ag3379g4da2g86c0gdf679c4fd119"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant005
#. Speaker = Arron
#. NodeID = d3853b34-e7f3-ca5d-a3c6-91a79012d30d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant005:d3853b34-e7f3-ca5d-a3c6-91a79012d30d
msgctxt "h47b513f9gb015g46ecg85b3gd869746ed045"
msgid "May you keep balance."
msgstr "조화가 그대와 함께하길."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant005
#. Speaker = Arron
#. NodeID = d6299c69-1ab0-eff0-2017-a510d68672ac
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Servant005Victory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant005:d6299c69-1ab0-eff0-2017-a510d68672ac
msgctxt "h653ab227gc909g4d27gbbbbgb4d2d971e5b0"
msgid ""
"By the trees! I don't know what I dreaded more - the goblins, or being stuck "
"here with Kagha for the rest of my days."
msgstr "나무여 맙소사! 남은 일생 동안 카그하와 이곳에 갇혀있어야 한다는 사실과 고블린 놈들 중에 무엇이 더 두려웠는지 모르겠소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant005
#. Speaker = Player
#. NodeID = d907e17c-cf1f-2137-ec10-4c436c806f78
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_Servant005_Answered(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_Servant005_Answered(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Servant005:d907e17c-cf1f-2137-ec10-4c436c806f78
msgctxt "h659001b9g450cg4091ga522ga0d593f74671"
msgid "Any excuse to gut some goblins."
msgstr "고블린을 도륙낼 구실은 얼마든지 있죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_SnakeKid
#. Speaker = Arabella
#. NodeID = 32f64e23-82bc-b4e5-c24c-8fd5e00b07f6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_SnakeKid(1) = True
#.   Global:
#.      - DEN_AttackOnDen_State_NoStoryteller = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_SnakeKid:32f64e23-82bc-b4e5-c24c-8fd5e00b07f6
msgctxt "h5df584eegcce6g4394g9315g9eeecfd8e7c0"
msgid "Even if goblins get in, they can't find us here. Mum said."
msgstr "고블린이 쳐들어와도 여기까진 찾아오지 못할걸요. 엄마가 그랬어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_SnakeKid
#. Speaker = Arabella
#. NodeID = 5e269cf9-ec12-e4ca-74a2-c1471e934810
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_SnakeKid(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_SnakeKid:5e269cf9-ec12-e4ca-74a2-c1471e934810
msgctxt "hd4727849g5846g420bga1dbga51a01457830"
msgid "She's talking!"
msgstr "좀 들어봐요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_SnakeKid
#. Speaker = Arabella
#. NodeID = a03df34e-8db1-8ae1-9a63-f030a613a59e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_SnakeKidVictory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_SnakeKid:a03df34e-8db1-8ae1-9a63-f030a613a59e
msgctxt "h0f3934b5gaafeg4027gbb91gd6f74e3039a4"
msgid "Baldur's Gate, we're coming!"
msgstr "발더스 게이트야, 우리가 간다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_SnakeKid
#. Speaker = Arabella
#. NodeID = c1a3c947-b6c3-a4ea-3506-434a8101220e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_NoStoryteller = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_SnakeKid(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_SnakeKid:c1a3c947-b6c3-a4ea-3506-434a8101220e
msgctxt "hee50faacgcb54g4cdbg8b02g21fbfd74a9e0"
msgid "You'll be safe in here. Don't worry."
msgstr "여기 있으면 안전할 거예요. 걱정 마요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_SnakeKid
#. Speaker = Arabella
#. NodeID = c248056f-a8be-27da-53cf-4597ae005ee7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_SnakeKid(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_SnakeKid:c248056f-a8be-27da-53cf-4597ae005ee7
msgctxt "h578e9674ga117g4b3fgbf84ged1694dad0a4"
msgid "I can't hear!"
msgstr "들을 수가 없잖아요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_SnakeKid
#. Speaker = Arabella
#. NodeID = ca36113e-d3be-6602-5020-61f6caf12c57
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_SnakeKidVictory(1) = True
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_SnakeKid:ca36113e-d3be-6602-5020-61f6caf12c57
msgctxt "he488e819g3789g41afg8126g05722aa5de52"
msgid "Let's go. Everyone's so slow."
msgstr "좀 갑시다. 다들 느려터졌어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_SonOfChef
#. Speaker = Ikaron
#. NodeID = b1464cc9-da8c-3c48-90ac-3918aafc9cf1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Tiefling008Victory(1) = True
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_SonOfChef:b1464cc9-da8c-3c48-90ac-3918aafc9cf1
msgctxt "hcb60278cgdf35g44a6g80fdga198764b7034"
msgid "Stay safe out there, you hear?"
msgstr "부디 몸조심 해, 알았지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_SonOfChef
#. Speaker = Ikaron
#. NodeID = b4ffe156-be6d-135c-e097-6f8e7efe9d63
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Tiefling008(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_SonOfChef:b4ffe156-be6d-135c-e097-6f8e7efe9d63
msgctxt "hfbaf44c2g5583g4e2eg9a97g4948e7f0b05a"
msgid "Leave me be. The attack could happen any moment."
msgstr "귀찮게 굴지 마. 공격이 언제 시작될지 모른다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_SonOfChef
#. Speaker = Ikaron
#. NodeID = d6adfe0d-158c-9ebd-eefe-38d4f478ddc4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Tiefling008Victory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_SonOfChef:d6adfe0d-158c-9ebd-eefe-38d4f478ddc4
msgctxt "h9bb84c46g76b6g4b40ga02fg5867cc98034e"
msgid "We couldn't have held them back on our own. Thank you."
msgstr "우리끼리만으론 놈들을 막지 못했을 거야. 고마워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_SonOfChef
#. Speaker = Ikaron
#. NodeID = dc4ce72f-fcd3-5d42-2425-702d364089c2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Tiefling008(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_SonOfChef:dc4ce72f-fcd3-5d42-2425-702d364089c2
msgctxt "h20531f54g30bag493fga833g81f019923789"
msgid "So many people left - I'm glad someone stuck around."
msgstr "튄 사람이 너무 많아. 그래도 누구는 남아줬으니 다행이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Stargazer
#. Speaker = Nadira
#. NodeID = 0488c5af-e265-9e01-cc04-04bf7389f079
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Stargazer(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Stargazer:0488c5af-e265-9e01-cc04-04bf7389f079
msgctxt "hb07d4159gf2beg4b2cga4eeg72530eb4c432"
msgid ""
"First druids, now goblins. Lady Doom really has it out for us, doesn't she?"
msgstr "처음에는 드루이드, 이제는 고블린까지. 불행의 여신에게 놀아나는 기분이네요. 안 그래요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Stargazer
#. Speaker = Nadira
#. NodeID = acb55d87-0742-5488-bb18-db690c023a68
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Stargazer(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Stargazer:acb55d87-0742-5488-bb18-db690c023a68
msgctxt "h7bd01b86g8356g466dg9c36g57b30e5082b8"
msgid "Hells. Maybe I should have stayed in Avernus after all."
msgstr "제기랄. 차라리 아베르누스에 남을걸 그랬어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Stargazer
#. Speaker = Nadira
#. NodeID = acfc3ee5-a4ad-dee4-97fa-ca24cc0039bb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_StargazerVictory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Stargazer:acfc3ee5-a4ad-dee4-97fa-ca24cc0039bb
msgctxt "he83a6e1ag15d1g48b0ga33ag33dfacfc7409"
msgid "What a mess. Wonder if the goblins have anything valuable on them."
msgstr "완전 난장판이네요. 고블린놈들, 털어먹을 게 좀 있었으면 좋겠는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Stargazer
#. Speaker = Nadira
#. NodeID = cd88e9e6-b692-78db-8346-4a3998e754f5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_StargazerVictory(1) = True
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Stargazer:cd88e9e6-b692-78db-8346-4a3998e754f5
msgctxt "h864e974bgad55g464eg9a71g33074df6c722"
msgid ""
"I'm ready to try my luck in Baldur's Gate. I hear a lot of people make bad "
"bets there."
msgstr "발더스 게이트에서 운을 좀 시험해 보려고요. 많은 사람들이 거기서 고약한 내기를 벌인다고 들었거든요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling001
#. Speaker = Rikka
#. NodeID = 0e6e9cb7-f945-17ce-11f2-7fc0ab915e4d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling001:0e6e9cb7-f945-17ce-11f2-7fc0ab915e4d
msgctxt "h18c2fb90g06a8g4b6eg95f8g1309cb5a874c"
msgid "We won't seal it up until he's safe with the rest."
msgstr "걔도 딴 애들처럼 무사히 들이기 전엔 동굴 닫을 순 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling001
#. Speaker = Player
#. NodeID = 13c40836-3da2-fde4-cbba-158fa876e24b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling001:13c40836-3da2-fde4-cbba-158fa876e24b
msgctxt "hb388f815gbd94g449ag821ege9158a1299e5"
msgid "There's a battle coming - I have slightly more pressing concerns."
msgstr "전투가 목전이라고. 난 조금 더 시급한 일에 집중해야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling001
#. Speaker = Player
#. NodeID = 149e40a1-bb33-2491-3262-d97120bf366c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling001:149e40a1-bb33-2491-3262-d97120bf366c
msgctxt "h49164ccbge1aag4e0dg8d60gd6c4f7bb899b"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling001
#. Speaker = Rikka
#. NodeID = 250ae2f3-d6cd-b439-7551-b08c0dcd3450
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_StoryMother(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling001:250ae2f3-d6cd-b439-7551-b08c0dcd3450
msgctxt "h730e1348g4a49g4a83g88d1g9f3168c0c34f"
msgid ""
"Go to the barricades. I can hold this place, if a few goblins slip through."
msgstr "그쪽은 방벽으로 가. 이쪽에 고블린 몇 놈 슬쩍 들어와도 내가 지켜낼 수 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling001
#. Speaker = Rikka
#. NodeID = 2e832779-2a05-fe19-de24-52285bd25d1a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling001:2e832779-2a05-fe19-de24-52285bd25d1a
msgctxt "hd2c66e84g1832g44acg8395g3211d313a066"
msgid "The kids found a hidden cave. We're going to hide them there."
msgstr "애들이 찾아낸 숨겨진 동굴이 있거든. 그곳에 아이들을 감추기로 했지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling001
#. Speaker = Player
#. NodeID = 402669a5-69a3-38df-176f-e5300a2b74c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling001:402669a5-69a3-38df-176f-e5300a2b74c0
msgctxt "h66019eedg1fdag40a5gaf10g2505240a6d33"
msgid "What cave?"
msgstr "동굴이라니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling001
#. Speaker = Rikka
#. NodeID = 4b3d02b2-fce6-0f6b-7915-9dff1c5a192f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Tiefling001Victory(1) = True
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling001:4b3d02b2-fce6-0f6b-7915-9dff1c5a192f
msgctxt "h14a6b769gf733g48f3gae64g2387d90d7e1f"
msgid ""
"It won't be easy in Baldur's Gate, but I hope it'll be better than here, at "
"least."
msgstr "발더스 게이트에서도 고생은 하겠지만, 여기보다야는 나을 거라고 바라고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling001
#. Speaker = Player
#. NodeID = 4fec53b3-997e-8f1f-884f-8caf8ab6a3c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling001:4fec53b3-997e-8f1f-884f-8caf8ab6a3c6
msgctxt "hcb63d431g31eag43bcg81dcge83e91fdfa7f"
msgid "No - but I'll keep an eye out for him."
msgstr "못 봤어. 그래도 돌아다닐 때 잘 살펴볼게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling001
#. Speaker = Rikka
#. NodeID = 780ab191-4479-96aa-0fee-9ce869f8df2e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_StoryMother(1) = True
#.   Quest:
#.     - DEN_FindingDoni.ReturnedRikka(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling001:780ab191-4479-96aa-0fee-9ce869f8df2e
msgctxt "h137f6702gd4a2g4e1dgaf06gdb5f3b6b01ad"
msgid ""
"Thanks for finding Doni. Knowing the children are safe makes all this a "
"little easier."
msgstr "도니를 찾아줘서 고마워. 아이들 안전이 파악되니 마음이 조금은 한결 놓이게 됐어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling001
#. Speaker = Rikka
#. NodeID = 8b6fe153-0fc5-f003-eac6-926d6e564938
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Tiefling001(1) = True
#.   Global:
#.      - DEN_AttackOnDen_State_MissingDoni = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling001:8b6fe153-0fc5-f003-eac6-926d6e564938
msgctxt "h4fc1ceb5g2ae9g4a8fg9aa8g25541171810e"
msgid "I need to find Doni!"
msgstr "도니를 찾아야 해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling001
#. Speaker = Player
#. NodeID = 8cf3c528-7814-532d-220b-c53f22e57e80
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GNOME(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling001:8cf3c528-7814-532d-220b-c53f22e57e80
msgctxt "h05d3e6e2gffc0g4cd4ga1aagbd8fe2f7404e"
msgid ""
"Hmm. Perhaps he slipped into a pocket plane - happened to an uncle of mine."
msgstr "흠. 어쩌면 주머니 차원으로 쑥 떨어져버린 걸지도 몰라. 우리 삼촌이 그런 적 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling001
#. Speaker = Rikka
#. NodeID = 97bef0fb-2b4c-0289-8542-e175b8f543ff
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_MissingDoni = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Tiefling001(1) = True
#.   Quest:
#.     - DEN_FindingDoni.RikkaAskedQuest(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling001:97bef0fb-2b4c-0289-8542-e175b8f543ff
msgctxt "h4ee0c3bdg6073g40b1g9a57g751d41f7c996"
msgid "Please. Have you seen Doni anywhere? Young boy, doesn't talk?"
msgstr "저기, 혹시 도니란 애 본 적 있어? 사내아이에 말이 없는?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling001
#. Speaker = Rikka
#. NodeID = 984be6c2-fc68-829f-d26f-832169d26580
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling001:984be6c2-fc68-829f-d26f-832169d26580
msgctxt "h00877f94g9d24g427egab94gdac9d13319fd"
msgid "We need to get him into the cave before the goblins come."
msgstr "고블린이 쳐들어오기 전에 동굴로 피신시켜야 하는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling001
#. Speaker = Rikka
#. NodeID = b965edf4-11ca-7133-36ac-efe549e47f3e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling001:b965edf4-11ca-7133-36ac-efe549e47f3e
msgctxt "h17ee5819g4976g44e1gbaffgfafdaaad2541"
msgid "I appreciate it. He's the one who showed us the cave to begin with."
msgstr "그래준다니 고마워. 애초에 동굴을 발견한 건 다 그 애 덕이거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling001
#. Speaker = Rikka
#. NodeID = d6e5a405-5b93-de87-ad4b-b8974bb38a17
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling001:d6e5a405-5b93-de87-ad4b-b8974bb38a17
msgctxt "h6f09aab9gead4g479fgb7abg10405572b1e9"
msgid "I don't have time for this. We can't seal up without him."
msgstr "그쪽 장단 맞춰 줄 시간 없어. 애가 없어서 동굴 못 닫고 있다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling001
#. Speaker = Rikka
#. NodeID = de1a667e-4506-39ab-f7ae-ed7d65e37b72
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Tiefling001Victory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling001:de1a667e-4506-39ab-f7ae-ed7d65e37b72
msgctxt "h6536926dge68bg4075gb0f3g6d7e88e7152d"
msgid ""
"Elturel didn't want us, and those druids sure as hells didn't either, but "
"you... you risked your life for us."
msgstr "엘투렐은 우릴 원하지 않았고, 저 드루이드들도 그건 빌어먹게 마찬가지였지. 근데 당신은... 우릴 위해 목숨을 걸어줬어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling001
#. Speaker = Rikka
#. NodeID = e3d1b061-6018-61e6-b57e-004caa5dc824
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling001:e3d1b061-6018-61e6-b57e-004caa5dc824
msgctxt "h045fe352g0323g4351g8135g59ef1c2e1c69"
msgid "But we can't seal it up until we find Doni."
msgstr "하지만 도니를 못 찾은 상태로 거길 닫을 순 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling001
#. Speaker = Rikka
#. NodeID = e73394f8-bf0f-ba3b-1670-da0305904dc2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling001:e73394f8-bf0f-ba3b-1670-da0305904dc2
msgctxt "h1f11c778g8f93g472eg9b35g3329dd77e350"
msgid "Then stop wasting my time. I have a child to find."
msgstr "그럼 내 시간 낭비나 하지 마. 찾아야 할 애가 있단 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling003
#. Speaker = Okta
#. NodeID = 578c6f29-c9e9-c265-d215-703364e59c53
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling003:578c6f29-c9e9-c265-d215-703364e59c53
msgctxt "h5b1953c1g74fag43b8g97dfgec86cec8a454"
msgid "... well, that's not a bad problem to have. Thank you, truly."
msgstr "... 뭐, 나쁜 문제는 아니야. 고맙네, 진심으로."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling003
#. Speaker = Okta
#. NodeID = 90f7b49a-fec4-b4c4-a40e-fc960391ac2b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Tiefling003(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling003:90f7b49a-fec4-b4c4-a40e-fc960391ac2b
msgctxt "h0dbb6917gea2ag4784gbdadge1e2415114b2"
msgid ""
"Sorry, I've got nothing to offer. What little there is has to go to the "
"young ones."
msgstr "미안하게 됐구먼. 나눌 게 없어. 조금이나마 남은 것들은 아이들 먹여야 하지 않겠나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling003
#. Speaker = Okta
#. NodeID = ce1e4033-0883-b727-a106-a718ed72fbff
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Tiefling003Victory(1) = True
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling003:ce1e4033-0883-b727-a106-a718ed72fbff
msgctxt "h89709966gcac8g46a7g8920g53f8d5c5f210"
msgid "This lot better get used to berries."
msgstr "베리류에 입맛 좀 들이는 게 좋을 게야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling003
#. Speaker = Okta
#. NodeID = e84a9a1b-cd42-de78-9b98-1e153876c6b2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Tiefling003(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling003:e84a9a1b-cd42-de78-9b98-1e153876c6b2
msgctxt "h6c96b0c7gf9b2g45f4g83d4g349a2f383d79"
msgid ""
"We were just about prepared for travel rations. Not a bloody <i>siege</i>."
msgstr "우리는 여행 식량을 준비하던 참이었네. 망할 <i>공성전</i>이 아니라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling003
#. Speaker = Okta
#. NodeID = ee7e3151-7aec-e6d5-084d-1200dd0d4add
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Tiefling003Victory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling003:ee7e3151-7aec-e6d5-084d-1200dd0d4add
msgctxt "h30dc7c6bgc55bg41bfg8923g7074ea70b6f9"
msgid ""
"Back to worrying about road rations it is. So many mouths to feed, but..."
msgstr "여행 식량을 다시 걱정해야겠구먼. 먹여야 할 입이 너무 많지만..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling004
#. Speaker = Kaldani
#. NodeID = 17898fa3-1612-fd55-5b0c-fb6e7dd0e6a6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Tiefling004(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling004:17898fa3-1612-fd55-5b0c-fb6e7dd0e6a6
msgctxt "hd5e6f8c5g1330g43c2g9235g4fc7abc848bc"
msgid ""
"If you're looking for something to do, they could probably use a hand down "
"in the cave."
msgstr "할 일 찾고 있는 거라면, 동굴 쪽에 도움이 필요한 거 같은데 가서 손 좀 빌려 줘 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling004
#. Speaker = Kaldani
#. NodeID = 553be191-88c5-032e-74a8-88b8c0401f15
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Tiefling004Victory(1) = True
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling004:553be191-88c5-032e-74a8-88b8c0401f15
msgctxt "h64335e71g55abg4099gbdc8gcd51e13891db"
msgid "Maybe there's a real chance that we'll get to Baldur's Gate now."
msgstr "지금이라면 발더스 게이트에 무사히 다다르는 게 꿈이 아닐 거 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling004
#. Speaker = Kaldani
#. NodeID = 835c77a4-afa2-5125-0755-78868e125b8a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Tiefling004Victory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling004:835c77a4-afa2-5125-0755-78868e125b8a
msgctxt "h4b9b0f9eg7c06g4c8cg9ae6g54adc88d071a"
msgid ""
"When I heard they had a drow... gods, but I can't believe we did it. <i>You</"
"i> did it."
msgstr "놈들 편에 드로우가 있단 걸 들었을 때는 참... 맙소사, 우리가 해냈다는 게 믿기지 않아. <i>당신</i> 덕이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling004
#. Speaker = Kaldani
#. NodeID = 995d4674-77bd-671a-49a8-ad46649648e2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Tiefling004(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling004:995d4674-77bd-671a-49a8-ad46649648e2
msgctxt "h508ba2a9g21dag4d36gb8eag59739bcd2fa7"
msgid ""
"Admiring my beautiful barricades? Might not be pretty, but they'll stop a "
"charging worg."
msgstr "내가 지은 이 멋드러진 방책 감탄스럽지? 우아하진 않지만 달려드는 워그들은 잘 막아세울 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling004
#. Speaker = Kaldani
#. NodeID = c1326724-b8c5-6389-da95-d52be14746b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling004:c1326724-b8c5-6389-da95-d52be14746b4
msgctxt "hdc0fa0bbge0afg4bedg93a3g430044fdc1ac"
msgid "Probably."
msgstr "아마도."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling004
#. Speaker = Kaldani
#. NodeID = cfa9cd44-afed-c119-4b8b-31f7769e81e8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Refugees_State_LeadersAreDead = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Tiefling004Victory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling004:cfa9cd44-afed-c119-4b8b-31f7769e81e8
msgctxt "h004408bbg3071g415egb5e6g85d49398b670"
msgid "You took care of the goblins? Nice work."
msgstr "고블린들을 처리한 거야? 아주 잘 했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005
#. Speaker = Pandirna
#. NodeID = 00ab4900-549a-0e21-eb9a-4cc554efefdd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Tiefling005(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005:00ab4900-549a-0e21-eb9a-4cc554efefdd
msgctxt "he1b6171dg3007g4fe1g9a9fga16f807f5964"
msgid "The goblins... do they fight well?"
msgstr "고블린들... 놈들은 잘 싸우는 편인가요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005
#. Speaker = Pandirna
#. NodeID = 040858d3-13c7-b7f8-425e-220251f0c25f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_AngeredPandirnaBefore = True
#.      - DEN_AttackOnDen_State_DenVictory = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Tiefling005Victory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005:040858d3-13c7-b7f8-425e-220251f0c25f
msgctxt "h80f9bae9gefc4g4b1aga7cdgb2ecdefbaa3d"
msgid "I had my doubts, but you came through. Thank you."
msgstr "의구심이 들지만 솔깃한 제안이군요. 고마워요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005
#. Speaker = Player
#. NodeID = 0f4588f8-1ab3-a7fd-b088-62bed11b6d60
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_HALFLING(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005:0f4588f8-1ab3-a7fd-b088-62bed11b6d60
msgctxt "hb9ddea02g9981g4968g8c19gc9f66c5f0c59"
msgid ""
"Never mind that - focus on the party we're going to have when all this is "
"over."
msgstr "신경 쓰지 마요. 이 모든 일을 해치운 뒤에 벌일 파티에나 집중하자고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005
#. Speaker = Player
#. NodeID = 1fd5a987-bb12-734d-4f89-efabd434c8e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005:1fd5a987-bb12-734d-4f89-efabd434c8e6
msgctxt "h64e0abe0gdf24g4f1bgab1dg7381bab947dd"
msgid ""
"Well enough. But you have what they don't - something to fight <i>for.</i>"
msgstr "그럭저럭요. 하지만 당신들은 놈들에게 없는 것을 가졌어요. 싸워서 <i>지켜야 할</i> 것들을."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005
#. Speaker = Pandirna
#. NodeID = 386797a9-cc27-9445-3c79-5f300cb2367f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005:386797a9-cc27-9445-3c79-5f300cb2367f
msgctxt "h2c31911fg27acg46eag84eag236f706ac4b8"
msgid ""
"Some of us have more of that than others. I'll just be glad to live out the "
"day."
msgstr "그렇다면 몇몇 사람들은 더 치열하게 싸워야 하겠군요. 그저 무탈하게 하루하루를 보낼 수만 있다면 기쁘겠어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005
#. Speaker = Pandirna
#. NodeID = 3934abbf-a76a-923e-cdbb-bd8f8ba85d88
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Tiefling005Victory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005:3934abbf-a76a-923e-cdbb-bd8f8ba85d88
msgctxt "hbf430c68g37a3g459bgb255g76c1d116b6b1"
msgid ""
"The goblins... look so small. Hard to believe I was ever afraid of them."
msgstr "고블린 놈들... 정말 작잖아요. 겨우 이런 놈들을 겁냈다니 믿기지 않아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005
#. Speaker = Player
#. NodeID = 4ae07dfb-3786-8efe-88ca-9ad79e760944
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - FIGHTER(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005:4ae07dfb-3786-8efe-88ca-9ad79e760944
msgctxt "hbd00051egde60g4063g9e9cgeb191fb5a3e4"
msgid "They don't have skill, but numbers and luck can matter more."
msgstr "싸움에 재주는 없다 한들, 물량과 변수가 판세를 좌우할 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005
#. Speaker = Pandirna
#. NodeID = 4bd4b692-a573-7485-4f46-aea92ce0be66
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005:4bd4b692-a573-7485-4f46-aea92ce0be66
msgctxt "h797cbf8dgb71ag429egbbfcgfe7780b6d930"
msgid "Hah! I wish I had your confidence. But... thank you."
msgstr "당신만큼 자신감이 넘쳤으면 좋겠네요. 그래도... 고마워요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005
#. Speaker = Pandirna
#. NodeID = 51cf9705-d08b-afba-de98-d66ee9ba0670
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005:51cf9705-d08b-afba-de98-d66ee9ba0670
msgctxt "h6903cda8g9426g420bgbd3dg0250d367fe91"
msgid "Why don't you find your own stretch of wall to die on?"
msgstr "뒈질 묫자리는 다른 데서 찾지 그래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005
#. Speaker = Player
#. NodeID = 584bc7a8-42a5-51f6-7754-7bcfd321e3df
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_Event_AngeredTiefling005(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005:584bc7a8-42a5-51f6-7754-7bcfd321e3df
msgctxt "h401a33b7g27f4g45bcg8ee6g62d83e86e33e"
msgid "I'm just here for the show. Make it a good one, won't you?"
msgstr "전 그냥 구경 온 거예요. 좋은 볼거리를 만들어줄 거죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005
#. Speaker = Pandirna
#. NodeID = 72eba453-2010-636d-18b9-c1aa0ca237ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005:72eba453-2010-636d-18b9-c1aa0ca237ad
msgctxt "hce4fc000gbea9g4c6agafaagc27949090b02"
msgid ""
"Heh, that obvious? But you're right. Can't swing a sword if I'm shaking like "
"a leaf."
msgstr "하, 뻔한 답이군요? 그래도 당신 말이 맞아요. 나뭇잎처럼 벌벌 떨면 칼 한번 휘두르지 못하는 법이니까요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005
#. Speaker = Pandirna
#. NodeID = 786e4a92-83cf-84b4-1213-481fa80bc592
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Tiefling005Victory(1) = True
#.   Global:
#.      - DEN_Refugees_State_LeadersAreDead = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005:786e4a92-83cf-84b4-1213-481fa80bc592
msgctxt "hae931ddegfd6ag4df1g9406g033f7928c018"
msgid ""
"Take care. I'll feel better on the roads knowing you're out there somewhere."
msgstr "잘 지내요. 당신이 저 바깥에서 잘 지낼 걸 생각하면 피난길이 한결 가벼워질 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005
#. Speaker = Player
#. NodeID = 7ac83b47-46f0-7b75-0474-ebea7eecc366
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005:7ac83b47-46f0-7b75-0474-ebea7eecc366
msgctxt "h77b7c804g8128g420agb94cg19dbe57bacb0"
msgid ""
"Wrong question. You don't need to fight better than them - you just need to "
"fight <i>harder.</i>"
msgstr "틀렸다. 놈들보다 잘 싸울 필요는 없다. 네가 해야 할 일은 <i>빡세게</i> 싸우는 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005
#. Speaker = Pandirna
#. NodeID = 7d5798e0-2049-4a1a-016a-212fa077e234
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Tiefling005(1) = True
#.   Global:
#.      - DEN_AttackOnDen_State_AngeredPandirnaBefore = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005:7d5798e0-2049-4a1a-016a-212fa077e234
msgctxt "h0b15a819g83c5g4fb0gbf5bg21650382f260"
msgid "Leave me alone. I don't want company."
msgstr "혼자 있을래요. 어울릴 기분이 아니에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005
#. Speaker = Player
#. NodeID = 8495c6e2-6f25-9b89-fa30-941fa7a53269
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_TIEFLING(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_Event_AngeredTiefling005(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005:8495c6e2-6f25-9b89-fa30-941fa7a53269
msgctxt "h3cfaa325g9336g4917g9c14gd5bc7c625247"
msgid "Better than a mob of undisciplined tieflings."
msgstr "오합지졸 티플링 무리보다야 낫지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005
#. Speaker = Pandirna
#. NodeID = 8da5055f-d195-2761-af49-70225cfcdb55
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005:8da5055f-d195-2761-af49-70225cfcdb55
msgctxt "h49a07085gea95g4f6egbf86g0a17373c40f7"
msgid ""
"You're right. Blood or not, the people here are family. And I won't let "
"goblins take that away - not again."
msgstr "당신이 옳아요. 피가 섞였든 아니든 이곳 사람들은 가족입니다. 고블린들 손에 빼앗기지 않겠어요. 다시는요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005
#. Speaker = Player
#. NodeID = 91ed8104-5235-79ab-0138-da6a6afcecfd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005:91ed8104-5235-79ab-0138-da6a6afcecfd
msgctxt "h5a3b6290gf816g481cg90a8g29c28dd0e00f"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005
#. Speaker = Player
#. NodeID = 9e6a25d5-2010-5f67-abaf-7b87d4e930c0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DRAGONBORN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005:9e6a25d5-2010-5f67-abaf-7b87d4e930c0
msgctxt "ha1d27170g5c91g42c2g908ag8fb5f2d01055"
msgid "They're a mob. Take heart - you fight with clan beside you."
msgstr "한 무리의 불량배들일 뿐이에요. 용기를 가져요. 당신은 일족과 함께 싸우잖아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005
#. Speaker = Player
#. NodeID = abba9f0b-8b9a-69c4-0741-8f301dbf3b80
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005:abba9f0b-8b9a-69c4-0741-8f301dbf3b80
msgctxt "h7f474766gb044g4756gb541gf75bec69fbae"
msgid "They're not well-trained, just vicious."
msgstr "잘 훈련되어 있진 않아요, 잔인할 뿐이죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005
#. Speaker = Pandirna
#. NodeID = bec7b595-fe8a-fdd3-6ccc-ffe9d6eec56e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_Event_AngeredTiefling005(1) = True
#.      - DEN_AttackOnDen_HasMet_Tiefling005(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005:bec7b595-fe8a-fdd3-6ccc-ffe9d6eec56e
msgctxt "hf201204ag2353g4225g841ag4c9d748f3140"
msgid "Go charm someone else."
msgstr "다른 사람이나 알아보세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005
#. Speaker = Player
#. NodeID = c7685713-9660-dd10-8fff-78e51f9092fa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005:c7685713-9660-dd10-8fff-78e51f9092fa
msgctxt "hb1886ddeg7e32g4a68gb029gbae9192ec48c"
msgid "Like drunk children. <i>Worse</i> than drunk children - you'll be fine."
msgstr "취한 꼬맹이들 같아요. 아니, 그것보다 <i>더 심각</i>하죠 - 당신은 괜찮을 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005
#. Speaker = Pandirna
#. NodeID = cc5c5cb7-89ff-15d7-22d2-1b78f3fe4bf2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Refugees_State_LeadersAreDead = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Tiefling005Victory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005:cc5c5cb7-89ff-15d7-22d2-1b78f3fe4bf2
msgctxt "h33e54300g09e9g475eg9096g04265d800135"
msgid "All that talk of fighting... you spared us that. Thank you."
msgstr "싸움에 관한 조언들... 덕분에 살았어요. 고맙습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005
#. Speaker = Pandirna
#. NodeID = d3531130-e328-4e7b-808b-1b028abeebab
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Refugees_State_LeadersAreDead = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Tiefling005Victory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005:d3531130-e328-4e7b-808b-1b028abeebab
msgctxt "h2e3e770eg7c95g47aag98eag6c73818ce47c"
msgid ""
"I'd have put good coin on you running off into the sunset, but you did it. "
"You stopped the goblins. Thank you."
msgstr "당신이 해질녘 몰래 도망칠 거라는 데 내기를 걸었지만, 내가 졌네요. 고블린 놈들을 막으셨어요. 고마워요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005
#. Speaker = Pandirna
#. NodeID = d548e770-2b51-1044-fa59-ac2a18179db9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Tiefling005Victory(1) = True
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005:d548e770-2b51-1044-fa59-ac2a18179db9
msgctxt "hba7e4759gdec5g44e5g9d24gaa9761ee76ab"
msgid ""
"After that... well, I pity whatever tries us on the road to Baldur's Gate."
msgstr "앞으로는... 글쎄요, 발더스 게이트로 가는 길에 우리를 가로막을 자들이 있다면 미리 동정해 두죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005
#. Speaker = Pandirna
#. NodeID = db734f56-f713-81c2-8e9e-88672fa8d7a2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_Event_AngeredTiefling005(1) = False
#.      - DEN_AttackOnDen_HasMet_Tiefling005(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005:db734f56-f713-81c2-8e9e-88672fa8d7a2
msgctxt "ha680941ag4be1g4e99g8e05g8f4180e3a8f3"
msgid "Gods, I almost wish they were here. I just want this done."
msgstr "세상에, 놈들이 빨리 쳐들어왔으면 좋겠어요. 이 모든 일이 빨리 끝나버리게요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005
#. Speaker = Pandirna
#. NodeID = df19d72a-2028-86e3-918d-6fe44e50aa9b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005:df19d72a-2028-86e3-918d-6fe44e50aa9b
msgctxt "h058431c9gf1ecg4742ga505g5cbda830e444"
msgid "You... mean that to be comforting, I'm sure."
msgstr "당신은 분명... 안심시키려는 것이겠죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005
#. Speaker = Pandirna
#. NodeID = e5f1c922-8a7e-8347-bbe3-e8dd2b62e420
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005:e5f1c922-8a7e-8347-bbe3-e8dd2b62e420
msgctxt "h5ca558d2gb2c5g4d1dg83c7g93163cdbab91"
msgid "Wonderful. I hope you brought both in equal measure."
msgstr "멋지군. 당신이 병력과 행운 모두를 가져 오셨기를 바라요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005
#. Speaker = Pandirna
#. NodeID = f6e219c3-2792-fdd8-fb3a-f2d62784f329
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_AngeredPandirnaBefore = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Tiefling005(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005:f6e219c3-2792-fdd8-fb3a-f2d62784f329
msgctxt "h49f3a991g0bd8g4607g9b4bgbec85a6d46d3"
msgid "You again. Just when I thought today couldn't get any worse."
msgstr "또 당신인가요. 오늘 하루가 이보다 더 나빠지지 않기를 바랐는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005
#. Speaker = Player
#. NodeID = fc85c74f-e474-de70-e92b-5ee07b36e623
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - MONK(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005:fc85c74f-e474-de70-e92b-5ee07b36e623
msgctxt "h3bd832d7ga8f9g4f51g808cgd4e34c1b9678"
msgid ""
"It doesn't matter. The true opponent is fear - and you've faced it before. "
"Everyone has."
msgstr "그건 문제가 되지 않소. 진정한 상대는 오직 두려움뿐이오. 다른 모두와 같이, 그대가 일찍이 직면했던 바로 그것 말이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005
#. Speaker = Pandirna
#. NodeID = ff83efb3-1837-9f93-040a-ab64ec5cd568
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling005:ff83efb3-1837-9f93-040a-ab64ec5cd568
msgctxt "h52675491g3d9bg4bf2g9791gea62dda1fb18"
msgid ""
"Heh. Damn straight - to the Nine Hells with them. We won't go down without a "
"fight."
msgstr "헤, 두말하면 잔소리죠. 놈들을 아홉 지옥으로 데려갑시다. 싸워 보지도 않고 쓰러지지는 않을 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling007
#. Speaker = Guex
#. NodeID = 0330441b-1765-ffb6-883b-90daad524c89
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling007:0330441b-1765-ffb6-883b-90daad524c89
msgctxt "h18d992ecgf878g4427ga0bcg6e9c3d3f44e6"
msgid "Sounds a fine one to me, so long as it's goblins doing the dying."
msgstr "나는 보기 괜찮을 거 같은데. 당할 놈들이 고블린이라면 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling007
#. Speaker = Player
#. NodeID = 248da65c-fe75-cbfa-8e33-112752a4e534
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling007:248da65c-fe75-cbfa-8e33-112752a4e534
msgctxt "hc5cf8cadg3b5cg4f51gb199gab9da51dfea6"
msgid "You want to use flaming arrows? In a <i>wood grove?</i>"
msgstr "불화살을 쓰고 싶다고? 이 <i>삼림</i>에서 함부로?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling007
#. Speaker = Guex
#. NodeID = 43ab20dd-05c9-fd02-fb1a-6262ea528a5e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Tiefling007Victory(1) = True
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling007:43ab20dd-05c9-fd02-fb1a-6262ea528a5e
msgctxt "hd4f61e1aga3f1g414dg960cg903f4fc54c6f"
msgid "Now it's back to the road, I suppose. It never ends, does it?"
msgstr "이제 다시 길을 나설 시간이 온 거 같네. 쉴 겨를은 꿈도 못 꾸겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling007
#. Speaker = Guex
#. NodeID = 5dadc095-1b40-5dc6-4249-94ebb1fa5f57
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling007:5dadc095-1b40-5dc6-4249-94ebb1fa5f57
msgctxt "h3949ec7agd9c8g4ea3g9204g07a16e7edcec"
msgid ""
"What I <i>want</i> is to kill goblins. This place is better off a pile of "
"ash than their latrine pit."
msgstr "내가 <i>원하는</i> 건 고블린들 죽이는 거야. 놈들 변소가 되느니 잿더미가 되는 편이 여기로서도 나을 거라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling007
#. Speaker = Player
#. NodeID = 5fc8078c-dba5-2119-be9a-4f6448bab246
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling007:5fc8078c-dba5-2119-be9a-4f6448bab246
msgctxt "h8fac2236g10fag421dg93a1g9472b08e587d"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling007
#. Speaker = Guex
#. NodeID = 68bb63f9-a608-7308-43dd-28640152b0a8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Tiefling007Victory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling007:68bb63f9-a608-7308-43dd-28640152b0a8
msgctxt "h1f34d55bge543g4f0agafb4gd3ad1513f53b"
msgid "I'm glad you came through it alive. We owe you, more than we can repay."
msgstr "살아 돌아오다니 다행이야. 당신한테 갚지 못할 빚을 졌어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling007
#. Speaker = Player
#. NodeID = 6a1861f9-62fc-cd08-47fd-355eb31107ee
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - FIGHTER(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling007:6a1861f9-62fc-cd08-47fd-355eb31107ee
msgctxt "h6e4adfb7g4873g462egaf1dg1c60518c9ed8"
msgid "I've seen death by fire before. Not a pleasant way to go."
msgstr "누가 불타 죽는 걸 본 적 있어. 그런 광경은 보기 썩 유쾌하지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling007
#. Speaker = Guex
#. NodeID = 7ce29e2d-c806-240c-dff6-fd263b62f68f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Tiefling007(1) = False
#.   Tag:
#.      - FIGHTER(1) = False
#.      - DRUID(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Tiefling007(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling007:7ce29e2d-c806-240c-dff6-fd263b62f68f
msgctxt "h817ccf7dge955g45beg8c5bg66efd45ba3cf"
msgid ""
"Don't spare the fire-arrows. Let's see if goblins are prettier with a coat "
"of burning oil on."
msgstr "불화살 아끼지 말고 써. 고블린 놈들이 불타는 기름 뒤집어 쓰면 얼마나 보기 좋을지 보자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling007
#. Speaker = Player
#. NodeID = afd44ee1-f7b2-c6ac-a212-88c623f825dd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling007:afd44ee1-f7b2-c6ac-a212-88c623f825dd
msgctxt "hfa0f12b1gc062g4658gbbebg088476c22dfe"
msgid "Those barrels make a fine target - one strike could set you alight."
msgstr "이 기름통들은 표적이 되기 딱 좋아. 한 발만 맞아도 네 몸이 불에 휩싸일걸?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling007
#. Speaker = Guex
#. NodeID = b0600fd3-9e70-717e-ef70-5d15a76c26b5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Tiefling007(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling007:b0600fd3-9e70-717e-ef70-5d15a76c26b5
msgctxt "hc7dada35g81dbg4bdag822dga0ab5dadd7b5"
msgid "Don't worry - we'll be ready when they come."
msgstr "걱정 마. 우린 놈들을 맞을 준비됐어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling007
#. Speaker = Guex
#. NodeID = cbd2d526-41db-f6ef-a624-5db1bf461534
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling007:cbd2d526-41db-f6ef-a624-5db1bf461534
msgctxt "hedb7b91bg58adg401eg928cge2fa81caff75"
msgid ""
"I'm not afraid of fire. They call us 'hellspawn' - maybe it's time they face "
"a bit of hell in return."
msgstr "불 따위 하나도 안 무서워. 우리 멸칭이 '지옥 종자'잖아. 이참에 이름값대로 지옥불 맛 좀 조금 보여 줘야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling007
#. Speaker = Guex
#. NodeID = f8a7d7f5-8412-c78c-b23c-254b6e699e1f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Tiefling007(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Tiefling007(1) = True
#. TagRule: DRUID or FIGHTER
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling007:f8a7d7f5-8412-c78c-b23c-254b6e699e1f
msgctxt "h07db8a2dg443fg4a43g97d5g4f929b66d3d8"
msgid ""
"Don't spare the fire-arrows. Let's see if goblins are prettier with a coat "
"of burning oil on."
msgstr "불화살 아끼지 말고 써. 고블린 놈들이 불타는 기름 뒤집어 쓰면 얼마나 보기 좋을지 보자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010
#. Speaker = Lakrissa
#. NodeID = 0033eed8-8965-3e53-6b23-e8c83e87aad4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_Tiefling010_PickedRogue(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010:0033eed8-8965-3e53-6b23-e8c83e87aad4
msgctxt "h2a197e7cg1175g437dga938g6adf09abf4f9"
msgid "It'd be even better if we won, of course. But still."
msgstr "물론, 우리가 이기는 편이 좋겠지만. 그래도."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010
#. Speaker = Lakrissa
#. NodeID = 0c3f1d4d-3fb4-a8c3-58f2-ba891cad39cd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_Tiefling010_PickedRogue(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010:0c3f1d4d-3fb4-a8c3-58f2-ba891cad39cd
msgctxt "hc51eb4bbg2c00g4a64gae35ge53c91d5a661"
msgid "And I'll take either one. Good to have you here."
msgstr "둘 중 어떤 것이라도 괜찮아. 당신이 여기 있어서 기뻐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010
#. Speaker = Player
#. NodeID = 1231f08d-3d06-3257-ec95-b1baaef4fb6d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010:1231f08d-3d06-3257-ec95-b1baaef4fb6d
msgctxt "h2b8018d7gf932g4a90g89e0g6e31c32b9bd7"
msgid "Buy me a drink and we'll call it even."
msgstr "술이나 한잔 사주면 그걸로 대신하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010
#. Speaker = Player
#. NodeID = 27a52bb6-476d-d6e3-8b8a-44183bd12b0e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010:27a52bb6-476d-d6e3-8b8a-44183bd12b0e
msgctxt "h791ff110gd185g4125ga778gf825afcdf46f"
msgid "Don't flatter yourself. I'm here for me."
msgstr "뭘 아는 척이라도 하지 마. 난 나를 위해서 여기 왔으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010
#. Speaker = Lakrissa
#. NodeID = 2828290b-27a1-a5ac-98f8-4ee7c6000ce5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010:2828290b-27a1-a5ac-98f8-4ee7c6000ce5
msgctxt "hbc99fb84g2a94g499eg8d82g9d803f62b5c5"
msgid "Assuming something else doesn't kill me first."
msgstr "다른 무언가가 날 죽이지 않는다고 가정한다면 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010
#. Speaker = Player
#. NodeID = 2b7b0bb6-8859-7149-7f99-afea78bfe8fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010:2b7b0bb6-8859-7149-7f99-afea78bfe8fd
msgctxt "hc859d9f0gaafag490bg956eg76f781f3a545"
msgid "Forget about the gold. You survived, that's all that matters."
msgstr "금화는 잊어버려. 당신은 살아남았고, 중요한 건 그것뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010
#. Speaker = Lakrissa
#. NodeID = 33b8fbee-74d5-721d-1a60-a25511fc5235
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010:33b8fbee-74d5-721d-1a60-a25511fc5235
msgctxt "h266a7f9cgc052g4208g8f31g7c47db21baa6"
msgid "Doesn't look like any of us are going to make it to Baldur's Gate."
msgstr "우리 중 누구도 발더스 게이트에 도착하진 못할 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010
#. Speaker = Lakrissa
#. NodeID = 344de121-d577-0bad-dfa8-d0bf768e2d71
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Tiefling010(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010:344de121-d577-0bad-dfa8-d0bf768e2d71
msgctxt "h43ee788cg7c5bg4e2egaac9gca12f47af2c6"
msgid "Almost time for the killing to start again. Hooray."
msgstr "살육의 시간이 다시 다가오는 것 같네. 만세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010
#. Speaker = Lakrissa
#. NodeID = 355c8524-77eb-b1f9-007a-91941f7fee93
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Tiefling010Victory(1) = True
#.      - DEN_General_TieflingGuard10_PromisedDrink(1) = True
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010:355c8524-77eb-b1f9-007a-91941f7fee93
msgctxt "he22a89f7g16d7g4c72gab95gd4a6a1e351a1"
msgid "See you in Baldur's Gate. Looking forward to that drink."
msgstr "발더스 게이트에서 다시 만나자. 술은 기대하고 있을게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010
#. Speaker = Lakrissa
#. NodeID = 3838001e-2e08-399b-dd3c-00b5331d6aa6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_General_TieflingGuard10_PromisedDrink(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010:3838001e-2e08-399b-dd3c-00b5331d6aa6
msgctxt "h76c62506gada2g488fgadddg7250e6e9c032"
msgid "You know, that actually sounds pretty good."
msgstr "그거 꽤 괜찮을 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010
#. Speaker = Lakrissa
#. NodeID = 402c8575-601f-ff49-eca6-2d2f96ce0dcb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010:402c8575-601f-ff49-eca6-2d2f96ce0dcb
msgctxt "hd9a6fb11ge8f0g48cega5adg8b1d5b429b03"
msgid "Let's stick with gold. I hate to mix business and pleasure."
msgstr "금화로 해결하자. 공과 사는 구분해야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010
#. Speaker = Lakrissa
#. NodeID = 4391a9d5-feed-a481-1ae4-f73bfe227705
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Tiefling010Victory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010:4391a9d5-feed-a481-1ae4-f73bfe227705
msgctxt "h19ecb280gb0ffg4ebbg951bg17e0ff35f453"
msgid "We survived. Who would've thought?"
msgstr "우리가 살아남다니. 누가 알았겠어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010
#. Speaker = Lakrissa
#. NodeID = 53b01101-726c-11ad-5a4f-239d81a7e279
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - DEN_General_TieflingGuard10_MadeBet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010:53b01101-726c-11ad-5a4f-239d81a7e279
msgctxt "h3841c667g1c05g43b3ga34cgce60b7df268f"
msgid "Or are you just keeping me alive to win that bet?"
msgstr "아니면 그냥 내기에서 이기고 싶어서 날 살려두는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010
#. Speaker = Lakrissa
#. NodeID = 5d024538-01a2-d962-5c63-bbe24bc851fb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010:5d024538-01a2-d962-5c63-bbe24bc851fb
msgctxt "h26cea653ge754g4b46ga69dg7fe9959d3dc4"
msgid ""
"Only the long road to Baldur's Gate to worry about now. Let's hope our luck "
"holds out."
msgstr "이제 걱정할 건 발더스 게이트로 가는 길 뿐이야. 이 행운이 계속되기를."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010
#. Speaker = Lakrissa
#. NodeID = 6dc597d2-e0bb-d140-2c50-c571a7072e8c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - DEN_General_TieflingGuard10_MadeBet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010:6dc597d2-e0bb-d140-2c50-c571a7072e8c
msgctxt "h9e817e7cg01ccg4d03g8aaegcb2232b88837"
msgid ""
"It looks I might have to pay you after all. Once we get to the city, of "
"course."
msgstr "보아하니 결국 너한테 돈을 줘야 할 것 같네. 물론, 우리가 도시에 도착한다면 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010
#. Speaker = Lakrissa
#. NodeID = 6e7a67f7-6d07-8c39-fc27-fb98ab08b4b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010:6e7a67f7-6d07-8c39-fc27-fb98ab08b4b4
msgctxt "h98cb2c73gb54bg4340gb3c7gb7e9e4202229"
msgid "Oh, you charmer."
msgstr "오, 너 정말 매력적이구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010
#. Speaker = Lakrissa
#. NodeID = 786d8ba2-813c-af11-eacf-dc5716188189
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Tiefling010Victory(1) = True
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010:786d8ba2-813c-af11-eacf-dc5716188189
msgctxt "h348484a6g1cf5g4dd4ga861g5163fd7dd5a0"
msgid ""
"I'd tell you to stay safe out there, but after today, I doubt there's "
"anything you can't handle."
msgstr "밖에선 안전히 다니라고 말해 주고 싶지만, 오늘 일을 보니, 네가 감당하지 못할 건 없을 것 같네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010
#. Speaker = Lakrissa
#. NodeID = 795dd306-7ca2-6246-8c08-08201c89eba6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_General_TieflingGuard10_PromisedDrink(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010:795dd306-7ca2-6246-8c08-08201c89eba6
msgctxt "h4ed3d034g15eag47a0gb05cg2217ed94f374"
msgid "You know, that actually sounds pretty good."
msgstr "그거 꽤 괜찮을 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010
#. Speaker = Lakrissa
#. NodeID = 8a3ea396-4af6-3aeb-202e-6b6023d2ab71
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_General_TieflingGuard10_PromisedDrink(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010:8a3ea396-4af6-3aeb-202e-6b6023d2ab71
msgctxt "h119e77a7gb7d7g45d1ga2e4ge3130a912dd6"
msgid "...I'd best see you there. I owe you a drink."
msgstr "…거기서 보도록 하지. 술 한 잔 사겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010
#. Speaker = Lakrissa
#. NodeID = 985b5821-a8ad-aba0-444b-fd1872af82c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010:985b5821-a8ad-aba0-444b-fd1872af82c6
msgctxt "h3db5052fg4ec1g484ag8562gccca8a0e6aa0"
msgid "If you drink as well as you fight, we'll have a lot of fun."
msgstr "네가 싸움 실력 만큼이나 술도 잘 마신다면, 굉장한 시간이 될 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010
#. Speaker = Player
#. NodeID = a93de349-a459-2526-0982-3cfdcf04d583
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010:a93de349-a459-2526-0982-3cfdcf04d583
msgctxt "h53673ec5g091ag46d7g969bga58b4ad1b2c9"
msgid "Good. I'll be there to collect."
msgstr "좋아. 돈은 거기서 받지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010
#. Speaker = Lakrissa
#. NodeID = b18a9650-cb5d-8bed-5c40-686a576114c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010:b18a9650-cb5d-8bed-5c40-686a576114c9
msgctxt "hd9520dc0g5707g41f5g985fg93ef0b42bc30"
msgid "You know, whatever happens, I'm glad we've got you on our side."
msgstr "일이 어떻게 되더라도, 당신이 우리 편에 서서 기뻐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010
#. Speaker = Player
#. NodeID = b3dbaad8-ab1e-82c4-3429-4770e4729b0c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010:b3dbaad8-ab1e-82c4-3429-4770e4729b0c
msgctxt "h029b23d1g2aa8g4b34g9ec3g2006e8058eba"
msgid "They won't take the grove. Not while I can still hold a weapon."
msgstr "그들이 숲을 차지하진 못할 거야. 내가 손에 무기를 쥐고 있는 한 그럴 일은 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010
#. Speaker = Lakrissa
#. NodeID = b9da9c99-5fcf-4262-fb2f-8423ba92596d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010:b9da9c99-5fcf-4262-fb2f-8423ba92596d
msgctxt "hf338703fgcf92g4ff2g9acbgc27d46543301"
msgid "Let's stick with gold. I hate to mix business and pleasure."
msgstr "금화로 해결하자. 공과 사는 구분해야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010
#. Speaker = Lakrissa
#. NodeID = ba1631a2-4074-bc74-4f11-913972c87c32
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010:ba1631a2-4074-bc74-4f11-913972c87c32
msgctxt "h9fbea20fg4afbg410cgb320g5e140edff444"
msgid "If you drink as well as you fight, we'll have a lot of fun."
msgstr "네가 싸움 실력 만큼이나 술도 잘 마신다면, 굉장한 시간이 될 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010
#. Speaker = Lakrissa
#. NodeID = bb2e4e52-4c2a-d92e-9e39-9f21f9992d44
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Tiefling010(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010:bb2e4e52-4c2a-d92e-9e39-9f21f9992d44
msgctxt "hbc35d118g4340g4a36gb19cg1e1f1b22726f"
msgid "Came back to join our heroic last stand?"
msgstr "우리 영웅적인 최후의 저항을 함께하러 왔어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010
#. Speaker = Lakrissa
#. NodeID = c1315fd9-f9d6-1a36-0136-639725d05856
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_General_TieflingGuard10_PromisedDrink(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010:c1315fd9-f9d6-1a36-0136-639725d05856
msgctxt "h6708a97dga36cg473cgaf69gfb57b0dcbc1c"
msgid ""
"I'm not forgetting that drink in Baldur's Gate. Dying doesn't get you off "
"the hook."
msgstr "네가 발더스 게이트에서 산다는 술은 절대 까먹지 않을 거야. 죽음도 그걸 막을 순 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010
#. Speaker = Player
#. NodeID = c2ead3f2-dcf4-bb01-29d1-d4d925fcd60b
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010:c2ead3f2-dcf4-bb01-29d1-d4d925fcd60b
msgctxt "hf45e9befga0c8g4cffg8cc6g21dcd491d33c"
msgid "Buy me a drink and we'll call it even."
msgstr "술이나 한잔 사주면 그걸로 대신하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010
#. Speaker = Lakrissa
#. NodeID = c467e25d-5e24-1382-8387-7c4fe616d38e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Refugees_State_LeadersAreDead = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Tiefling010Victory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010:c467e25d-5e24-1382-8387-7c4fe616d38e
msgctxt "hf3497c3fg7664g454eg91a6g84f66d06ec07"
msgid ""
"With the goblins dead, we might <i>actually </i>make it to Baldur's Gate..."
msgstr "고블린들이 죽었으니, 마침내 <i>정말로 </i>발더스 게이트에 도착할 수 있을지도 모르겠어..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010
#. Speaker = Lakrissa
#. NodeID = c9044dcf-8d0e-7a7f-d21b-8bbb2ae2877e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_Tiefling010_PickedRogue(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010:c9044dcf-8d0e-7a7f-d21b-8bbb2ae2877e
msgctxt "h097e8247g480bg4fb7gaaacg1003dfd168ce"
msgid "You're all right. Don't die, if you can avoid it."
msgstr "넌 괜찮아. 죽지만 마, 피할 수 있다면."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010
#. Speaker = Player
#. NodeID = d30187a9-c32b-a0e3-3eb6-a8c02115e81a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010:d30187a9-c32b-a0e3-3eb6-a8c02115e81a
msgctxt "h80ecce94g7405g4b0fg8c16g9804fb1f78ae"
msgid "I can do both."
msgstr "난 둘 다 할 수 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010
#. Speaker = Lakrissa
#. NodeID = dbfad584-f5aa-2665-3fae-99dd38ad5719
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_General_TieflingGuard10_PromisedDrink(1) = True
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Tiefling010Victory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010:dbfad584-f5aa-2665-3fae-99dd38ad5719
msgctxt "hef5babadga803g4a08gaf1eg0ea1d752d374"
msgid "You didn't die. I didn't die. Seems we're destined for that drink."
msgstr "너도 죽지 않았어. 나도 마찬가지고. 우리가 나눌 술은 운명인 것 같네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010
#. Speaker = Lakrissa
#. NodeID = e1485764-8b13-17ae-c255-0f203a0f8f8f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Tiefling010Victory(1) = True
#.   Global:
#.      - DEN_Refugees_State_LeadersAreDead = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010:e1485764-8b13-17ae-c255-0f203a0f8f8f
msgctxt "h5b883819ga1e2g4502g9d97gbd58c80c4f74"
msgid ""
"May I never see this place again. <i>Gods. \n"
"</i>"
msgstr ""
"이곳을 다시는 보지 않기를. <i>신이시여. \n"
"</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010
#. Speaker = Lakrissa
#. NodeID = e6cfc6df-f341-324e-5515-11445c69527a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_General_TieflingGuard10_RefusedBet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010:e6cfc6df-f341-324e-5515-11445c69527a
msgctxt "h24e92f0dgad35g482fgb948gadc597478c24"
msgid ""
"Should've taken that bet, my friend. I'd owe you big once we got to Baldur's "
"Gate."
msgstr "그 내기를 받았어야지, 친구. 우리가 발더스 게이트에 도착하면 네게 크게 빚졌을 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010
#. Speaker = Lakrissa
#. NodeID = f178fa77-a424-56a1-c67d-55bb20322b74
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010:f178fa77-a424-56a1-c67d-55bb20322b74
msgctxt "hfc873c19g1ae2g47d9g9a85g5d40ff4f83b2"
msgid "I'll see you in Baldur's Gate, then."
msgstr "그럼, 발더스 게이트에서 보자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010
#. Speaker = Lakrissa
#. NodeID = f67da232-ca8f-c277-7aec-039c1054d2f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Tiefling010:f67da232-ca8f-c277-7aec-039c1054d2f3
msgctxt "h8b928208g988eg42f6gab68g47a18a3d5a31"
msgid "No no! A bet's a bet. I'll see you in Baldur's Gate."
msgstr "아니, 아니! 내기는 내기야. 발더스 게이트에서 보자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 0071652c-6f71-4864-827f-38b2d37769d9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - DEN_Conflict_SUB_AoD.GotBriefed(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:0071652c-6f71-4864-827f-38b2d37769d9
msgctxt "h998d1b5eg6b60g4b17gbfcbga19b3cd1882f"
msgid "Sound the horn, then."
msgstr "그럼, 나팔을 울리게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 02a0b947-569f-9b92-deee-82252d16d2b0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:02a0b947-569f-9b92-deee-82252d16d2b0
msgctxt "he463afeeg81c0g4745ga310g6958091799ca"
msgid ""
"This drow is no fool - she knows the smart thing is to be patient, starve us "
"out."
msgstr "그 드로우는 바보가 아닐세. 그녀는 인내심을 갖고 우리를 굶겨 죽이는 게 현명한 방법이라는 사실을 알고 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Player
#. NodeID = 047ae860-86e4-da5b-5f9a-223246d2cd02
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:047ae860-86e4-da5b-5f9a-223246d2cd02
msgctxt "hb73c504eg5c28g4b34g810fg7e27682358c3"
msgid ""
"She tricked the location out of me. It was a mistake - but I mean to make up "
"for it."
msgstr "그녀가 날 속여 위치를 알아냈습니다. 실수였어요. 하지만 만회할 생각입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 0bcbc14a-319d-4985-a801-92e1ac80ff01
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:0bcbc14a-319d-4985-a801-92e1ac80ff01
msgctxt "h664a5661gc4abg44c7g966ag988e989e36a8"
msgid "Well. There's nothing for it, now - a fight it will have to be."
msgstr "그래. 이제 다른 방법은 없겠군. 싸울 수밖에 없겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 0c42857a-089d-69eb-8410-d5995c72fcf0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_RaidersAtDen = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:0c42857a-089d-69eb-8410-d5995c72fcf0
msgctxt "hd0505504g0b9fg47f2ga8b9g313b04c5728a"
msgid "I think... I think that's the last of them."
msgstr "그것이... 그것이 마지막 놈인 것 같네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Player
#. NodeID = 0d0c89e4-7720-4bd1-699a-3a2375d21192
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:0d0c89e4-7720-4bd1-699a-3a2375d21192
msgctxt "h7976d795g59c3g4fc2gb47bg1071c644632d"
msgid "Don't look for reasons - it's nothing personal."
msgstr "이유는 찾지 마. 악감정은 없으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Player
#. NodeID = 0e827509-535d-176d-552f-a120f836e5a9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:0e827509-535d-176d-552f-a120f836e5a9
msgctxt "h973c5fecga984g465fga0e2g31a27d5be840"
msgid "Their drow leader found the grove. I couldn't stop it - I'm sorry."
msgstr "그들의 드로우 지도자가 숲을 찾았어요. 전 막을 수 없었습니다. 죄송합니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 10c6da12-95bb-3a5b-31ba-9d7a54cfef25
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:10c6da12-95bb-3a5b-31ba-9d7a54cfef25
msgctxt "h3f5edcbbg076bg41f1gb51dgb0df75882235"
msgid "So... what? We're to be bait for this drow? Gods above, I..."
msgstr "뭐... 어쨌다고? 우릴 드로우의 미끼로 썼다는 말인가? 천상의 신들이시여, 나는..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 11bc88c6-2217-e25a-61a4-dca336cfd91b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:11bc88c6-2217-e25a-61a4-dca336cfd91b
msgctxt "h8a363cbeg4a6cg45fbgad8egba60054f63af"
msgid "But perhaps..."
msgstr "허나 어쩌면..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 15fc2e97-d4d6-8104-ff41-c9e3b5d62d8b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_Event_PassedByEntrance = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_TieflingLeader(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:15fc2e97-d4d6-8104-ff41-c9e3b5d62d8b
msgctxt "h9b2c0859gc3c3g4bb8gae70g39afb41fc079"
msgid ""
"Gods above, you're alive. A little light, just as the day seems darkest."
msgstr "신들이시여, 자네 살아있었군. 가장 어두운 순간의 희미한 빛처럼 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 18ad2fe6-abce-81ab-7247-5860d2115bbf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:18ad2fe6-abce-81ab-7247-5860d2115bbf
msgctxt "h7efa759bg89beg45c5g8a32g22c874178a1c"
msgid "But she'll find you waiting, too."
msgstr "하지만 그녀는 자네도 상대해야 할 걸세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Player
#. NodeID = 1cbfb391-dea3-e51d-2d64-b7fa96c4c66a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:1cbfb391-dea3-e51d-2d64-b7fa96c4c66a
msgctxt "h4c255831gf732g4939g88a6g528ac5bc60f4"
msgid "I didn't turn on anyone. I look out for myself."
msgstr "나는 누구도 신경 쓰지 않아. 나 자신만을 생각하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 1d401659-7bdf-70b9-4eb0-06cd79127f50
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:1d401659-7bdf-70b9-4eb0-06cd79127f50
msgctxt "h9cb6c934gc35ag4427ga835g4fe317b91b80"
msgid "I'd sooner start this on our terms than theirs."
msgstr "그들이 짠 장기판보다는 우리에게 유리한 판에서 곧바로 개시하고 싶네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 2010ae85-a501-b65d-c12e-e4e293162ce7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:2010ae85-a501-b65d-c12e-e4e293162ce7
msgctxt "h1e3f9271g0338g4ce3gb476g991d678e510f"
msgid ""
"Every ounce of oil that we could spare has been buried out in front of the "
"gate."
msgstr "우리가 찾은 마지막 한 방울의 기름까지 관문 앞에 묻어있네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 26c648dd-2cd7-af9f-9917-a319ebeabdb5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:26c648dd-2cd7-af9f-9917-a319ebeabdb5
msgctxt "h3ed93994g27d2g4c4eg967ag0ea70f05d765"
msgid "Gods, it's done. It's <i>over</i>. Just... just give me a moment."
msgstr "신이시여, 해냈어. 이제 <i>끝났어</i>. 잠시... 잠시 시간을 주게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Player
#. NodeID = 30561db8-684a-a56e-6e1c-006a52aeaa4b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC_GOOD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:30561db8-684a-a56e-6e1c-006a52aeaa4b
msgctxt "haf8235a4g6484g46bdg87c4g3c7e780ac87c"
msgid "Take heart. My god is watching over us."
msgstr "용기를 가지십시오. 나의 주신께서 우리를 보우하고 계십니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Player
#. NodeID = 34b885a4-27f6-26ee-8d5b-c7c0958a096c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:34b885a4-27f6-26ee-8d5b-c7c0958a096c
msgctxt "ha7db1c59geba3g4699g95aagef2b2c3a4960"
msgid "Take me through the plan again."
msgstr "계획을 다시 설명해 주세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 3bd1d0af-5fbb-baa0-913b-79120c74bc41
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:3bd1d0af-5fbb-baa0-913b-79120c74bc41
msgctxt "h2e26556bg79ffg4660g8e6agf0768fe123cb"
msgid "We've spotted goblins in the woods - what happened at their camp?"
msgstr "우리 정찰병이 숲에서 고블린들을 발견했네. 야영지에서 무슨 일이 있었던 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 3c945c8d-9086-5b3a-b983-eb0603442282
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:3c945c8d-9086-5b3a-b983-eb0603442282
msgctxt "h18aea318gc495g4c48g87c8gf4298fe57d00"
msgid "You haven't - and so we place our faith in you instead."
msgstr "자네는 그러지 않았지. 그래서 우리는 대신 자네에게 믿음을 걸기로 했네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 3d82c278-3713-dcac-8a32-9cd91877abdf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:3d82c278-3713-dcac-8a32-9cd91877abdf
msgctxt "h522ebfd6gd1dag48ccg96cbgb5aab8c34d83"
msgid ""
"We threw them back once. If you're with us... perhaps we can do it again."
msgstr "우리는 그들을 물리친 적이 있어. 자네가 우리와 함께한다면... 우리가 또 해낼 수 있을지도 몰라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Player
#. NodeID = 40a9ab5c-1974-aa35-8c24-86f27c2d80ca
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - FIGHTER(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:40a9ab5c-1974-aa35-8c24-86f27c2d80ca
msgctxt "h68c0c786g3c79g4829gbb2agf9b5a59c78f8"
msgid "You've fortified the place well - we're ready for them."
msgstr "당신은 이곳을 훌륭한 요새로 만들었습니다. 우린 놈들을 맞을 준비가 되어 있습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 4156ab13-5e1a-7579-81d9-69f5ed57e1a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:4156ab13-5e1a-7579-81d9-69f5ed57e1a5
msgctxt "h9dc05ac1g1105g4126g8d08gbd0b34aa2016"
msgid ""
"The horn - damn thing's loud as thunder. It'll give our people a chance to "
"take shelter, too."
msgstr "뿔 나팔, 저 망할 물건은 뇌우만큼 우렁차다네. 안쪽의 피난민들도 듣고 대피할 수 있겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 42a54f8b-7b61-4522-f3af-d0bb41fda44e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:42a54f8b-7b61-4522-f3af-d0bb41fda44e
msgctxt "h9cda6eabgefdag4b0cgba75g533fb1f77949"
msgid ""
"I suspect we'll need it before the day is done. The fact is, we cannot "
"withstand a siege."
msgstr "오늘이 끝나기 전에 그놈의 신이 필요해질 걸세. 지금 우리는 공성전을 감당할 수 없는 형편이니 말일세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Player
#. NodeID = 4598b47d-6337-6cee-aad0-5fd97c8c3199
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:4598b47d-6337-6cee-aad0-5fd97c8c3199
msgctxt "h8975c09ag924ag4ef2ga53fgc85eab8c686d"
msgid "Why? For the glory of the Absolute, of course!"
msgstr "왜냐고? 당연히 절대자님의 영광을 위해서지!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 45b10353-978c-ef42-06ab-4f0c0efeeb95
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:45b10353-978c-ef42-06ab-4f0c0efeeb95
msgctxt "h2abbc09dg5840g4346g855fga0fc9d3b0139"
msgid ""
"Gods! You have a habit of turning up where you're least expected - but no "
"less welcome for that."
msgstr "신들이시여! 자네 사람 놀래키는 재주가 있구만... 그렇다고 반갑지 않은 건 아닐세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Player
#. NodeID = 4a732c0b-0929-d49b-28f0-c132be7cee44
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:4a732c0b-0929-d49b-28f0-c132be7cee44
msgctxt "he8364510gbda3g49a9g88b1gc0a12de7326a"
msgid "She'll take the bait - and with the defences ready, we'll win the day."
msgstr "그녀는 분명 미끼를 물 겁니다. 방어에 만전을 기한다면, 오늘은 승리의 날이 될 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 4ca8c664-0f63-54aa-32c2-22f3af64cf77
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_TieflingLeader(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:4ca8c664-0f63-54aa-32c2-22f3af64cf77
msgctxt "hb63f09d4ge7acg4adagbe2bge8a0e38e1192"
msgid "How did you -"
msgstr "자네가 어떻게 -"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 5076be8f-4a16-1354-d720-0e5c877f254c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_Event_VictorySpeech = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:5076be8f-4a16-1354-d720-0e5c877f254c
msgctxt "h70333661g5321g4ccdgbbcdgd99a3d1550e9"
msgid "We're ready to head to your camp - are you?"
msgstr "우리는 준비를 마쳤네, 자네는 어떤가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Player
#. NodeID = 53e8f69a-0842-dd31-b179-18eb55d1a704
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:53e8f69a-0842-dd31-b179-18eb55d1a704
msgctxt "h83ce221bg3067g45e1ga5c3g278e4d546931"
msgid "Surely there's a better option."
msgstr "분명 더 나은 방법이 있을 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 5571c3c7-856b-a751-d740-a0ef48271281
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - DEN_Conflict_SUB_AoD.GotBriefed(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:5571c3c7-856b-a751-d740-a0ef48271281
msgctxt "hb95d5803ge4d4g47fagbb86g598a52fd2401"
msgid ""
"Make what preparations you deem necessary, and then sound the horn. Let's "
"have this done."
msgstr "자네에게 필요한 준비를 한 후, 나팔을 울려주게. 이 위기를 끝내세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 5cd54382-4373-a566-b78b-690fe8fca3f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:5cd54382-4373-a566-b78b-690fe8fca3f4
msgctxt "hda395e9eg9631g4433gb17eg59e650377282"
msgid ""
"We'll blow the horn to draw them in, and pray our fire-arrows strike true."
msgstr "우리는 저들을 끌어들이기 위해 나팔을 불 걸세. 그리고 우리 불화살이 적중하길 기도하는 수밖에."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Player
#. NodeID = 60d5d9ee-d3f2-5886-51fe-db4e10cb5e5a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:60d5d9ee-d3f2-5886-51fe-db4e10cb5e5a
msgctxt "h03ab9ec3ge53cg4718g8341g7bbff72e0e40"
msgid "Simple. This grove belongs to the Absolute now."
msgstr "간단해. 현 시간부로 이 숲은 절대자 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 61212517-0986-9af5-6321-6cb1e441cea0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - DEN_Conflict_SUB_AoD.GotBriefed(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:61212517-0986-9af5-6321-6cb1e441cea0
msgctxt "h2a064601g4006g40eeg9a2eg74b5d9f9eb5c"
msgid "See to your preparations and then sound the horn. Let's have this done."
msgstr "준비 상태를 확인한 후 나팔을 울려주게. 이 위기를 끝내세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Player
#. NodeID = 6483a736-3c48-31d1-6c0b-9ca733cf9fd2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:6483a736-3c48-31d1-6c0b-9ca733cf9fd2
msgctxt "hd57a5c87g10d6g420dga601g70e085b3e0f8"
msgid "Trust me - she thinks we're on the same side."
msgstr "절 믿으세요. 그녀는 제가 자기 편이라고 생각하고 있어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 64be7563-6fe0-8703-5ff7-9e700ab2ac04
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:64be7563-6fe0-8703-5ff7-9e700ab2ac04
msgctxt "h1bdfd818g7a20g4a55gb516g330b3770b8d1"
msgid ""
"A mistake? It's a <i>damned</i> - gods damn it, we're not ready for this."
msgstr "실수라고? 그건 <i>재앙</i>이라네. 망할, 신들이시여. 우린 아직 이런 싸움에 준비되지 않았단 말일세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 66d452fa-be84-564a-c667-bae071ee1f1c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:66d452fa-be84-564a-c667-bae071ee1f1c
msgctxt "habfb5cd0g5a62g4669g891ag20315a489db9"
msgid "When the Blade told me of what you'd done, I was loathe to believe it."
msgstr "칼날이 자네가 무엇을 했는지 말했을 때, 나는 그걸 받아들이기 힘들었네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 67aa2160-c7ee-ee3e-0fb5-e3c40d2657cd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:67aa2160-c7ee-ee3e-0fb5-e3c40d2657cd
msgctxt "hed3e2422g4fd1g43ecg9d7agb4103875d077"
msgid ""
"<i>Mrag. </i>It... it doesn't matter now, I suppose. You have nothing to "
"apologise for."
msgstr "<i>므라그. </i> 지금 와서는... 상관없을 것 같군. 사과할 것 없네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Player
#. NodeID = 6936790f-4c1b-a351-019b-e7510d98b184
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#. SetFlags:
#.   Object:
#.     - ORI_DarkUrge_Event_IndulgedUrge(1) = True
#.     - ORI_DarkUrge_Event_HadUrge(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:6936790f-4c1b-a351-019b-e7510d98b184
msgctxt "h8d865bd6gcd8dg4645gb7dcg384fdd0b91f6"
msgid "I am just here for the show. I want to see you all die."
msgstr "난 단지 공연을 보기 위해 여기 있는 거다. 너희들 모두가 죽는 걸 보고 싶군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 6b26b6ea-647d-636c-4f45-841150c21c9d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:6b26b6ea-647d-636c-4f45-841150c21c9d
msgctxt "h22d09e08g1cdag4be2gb435g0f469e0670b8"
msgid ""
"I know we can make a stand here. We <i>have </i>to. Your help will be "
"welcome."
msgstr "나는 우리가 여기서 방어해야 한다는 것을 알고 있네. <i>해야만</i> 하지. 자네의 도움은 환영일세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Player
#. NodeID = 6c5aece1-8261-bf3c-3ad4-2744d8579175
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:6c5aece1-8261-bf3c-3ad4-2744d8579175
msgctxt "he623fb72gf918g4c3ag8f1fg20688f53dac3"
msgid "Relax - this is a trap, and now she's walking right into it."
msgstr "진정하세요. 이건 함정이고 그녀는 완전히 걸려들 참이니까요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 6d2f13ff-6229-c3d6-8d44-07a65cb0b2fa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:6d2f13ff-6229-c3d6-8d44-07a65cb0b2fa
msgctxt "h3ed466aega39eg4e06g8155gb17951ea1e30"
msgid ""
"I'd given you up for dead at the goblin camp - I'm damn glad to be wrong."
msgstr "난 자네가 고블린 야영지에서 죽은 줄 알고 자네를 단념하려 했는데, 내가 틀려서 끝내주게 다행이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 75fb83c6-a3e6-1ad8-8158-7f5b7070bb4b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:75fb83c6-a3e6-1ad8-8158-7f5b7070bb4b
msgctxt "h88939af6gd548g44e5g8bd5g9aba35c1d6ba"
msgid ""
"We need to thin the goblin numbers quickly if we're to have any chance of "
"survival."
msgstr "생존할 일말의 가능성이라도 찾으려면 고블린들의 숫자를 최대한 빨리 줄여야 하네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Player
#. NodeID = 79d8741f-d722-79d9-a91d-ba975fdc65c2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:79d8741f-d722-79d9-a91d-ba975fdc65c2
msgctxt "hc591d178g7682g4bddga0ddg1e3b71b1b4cb"
msgid "With you? You misunderstand - I'm with <i>them</i>."
msgstr "당신들과? 잘못 알고 있군. 나는 <i>그들</i>과 함께야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 7cef595e-750a-63dd-ee62-f20336821427
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:7cef595e-750a-63dd-ee62-f20336821427
msgctxt "h335eebfagd663g47c5g9853g259a46de404c"
msgid "I wish it were as complicated as all that."
msgstr "계획이 기대한 만큼 복잡했으면 좋겠네만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 7d0677a6-950c-e0a9-3d34-626004abfde5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_TieflingLeader(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:7d0677a6-950c-e0a9-3d34-626004abfde5
msgctxt "he5b8df6fgf21dg445dg8ddegc8f7dc754d28"
msgid "Well, are you ready? Are we?"
msgstr "그럼, 준비되었나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Player
#. NodeID = 7dbf3b48-07a6-c0ea-3869-d0879c868d8a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:7dbf3b48-07a6-c0ea-3869-d0879c868d8a
msgctxt "h43d9b73ag2cfdg40afg9b78gbe6fe87973d8"
msgid "The goblins are coming - and they're led by a drow."
msgstr "고블린들이 오고 있습니다. 드로우 한 명이 그들을 이끌고 있죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Player
#. NodeID = 7f46498e-a6ae-6a2b-1cf6-d6eb039d7b6b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:7f46498e-a6ae-6a2b-1cf6-d6eb039d7b6b
msgctxt "h15ccbe3fg2a64g4ce6g82c0g33fc3590f8b8"
msgid "Not just yet."
msgstr "아직은 아닙니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 8186a3d9-784e-4a24-d4a1-69bf40cfe5bb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:8186a3d9-784e-4a24-d4a1-69bf40cfe5bb
msgctxt "h7a66ab57gd4b7g4c0cgae6egdaee9b2128c9"
msgid ""
"Our trap? I can't help but feel that we're the ones backed into a corner."
msgstr "우리 쪽 함정이라고? 미안하지만 우리가 궁지에 몰렸다는 기분을 지울 수가 없군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 8da1fda5-00b8-2196-01a7-098f6bc1b5ba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:8da1fda5-00b8-2196-01a7-098f6bc1b5ba
msgctxt "h477c75edg5a15g4ffbg9722g5daa0791a638"
msgid ""
"If it's to be battle, sooner is better than later. We need to ready "
"ourselves and goad this drow into attacking."
msgstr "어차피 치러야 할 전투라면 빨리 치르는 편이 낫겠지. 우리는 만전을 기한 다음 드로우가 공격에 나서도록 끌어내야 하네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 8ea7ad7d-c14f-bc01-e78f-e1194541d4f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:8ea7ad7d-c14f-bc01-e78f-e1194541d4f4
msgctxt "h0dc8a09ag92d3g4d92ga72ag85a70c015e50"
msgid ""
"We have the barricades - just not the warriors to man them. If we're to "
"survive, we'll need to thin the goblin numbers quickly."
msgstr "우리에게는 방책이 있지만, 이를 지켜낼 전사가 없네. 살아남으려면 우선 놈들의 숫자를 빠르게 줄여야 할 걸세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 92672cc2-0f58-b533-73ce-5f274ca037af
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:92672cc2-0f58-b533-73ce-5f274ca037af
msgctxt "ha90ca686g9370g44cdgb3c7gf847494a7265"
msgid ""
"From what little I've learned of goblins, they won't resist an invitation "
"like that."
msgstr "고블린에 대해 아는 건 많지 않지만, 그들은 이런 초대를 거부하지 않는다고 하더군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 98605762-3f18-a471-e18c-03c457c6e1a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:98605762-3f18-a471-e18c-03c457c6e1a5
msgctxt "h8e65cd2eg6ac7g4cf2gbc84g58ca24f80620"
msgid ""
"But... if you say you're a match for this drow, I suppose that's the best "
"chance we have."
msgstr "허나... 자네가 이 드로우를 상대할 수 있다면, 역으로 기회가 될 수도 있겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 9a7ff7e3-84d6-2921-9ebb-55813f029321
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:9a7ff7e3-84d6-2921-9ebb-55813f029321
msgctxt "h78692a3bgc0a1g4be2gb610g65438b56ff11"
msgid "I'm glad to see his fears weren't as bad as he imagined."
msgstr "나는 그의 공포가 그의 상상만큼 나쁘진 않아 보여서 기쁘네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 9aea0fc4-f14a-550c-ccef-476c17c89656
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - DEN_Conflict_SUB_AoD.GotBriefed(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:9aea0fc4-f14a-550c-ccef-476c17c89656
msgctxt "he76f4f2dge3d1g4f1ag8254gc89d550ee085"
msgid ""
"I mean to prick at her pride - give her no choice but to be stupid. Sound "
"the horn - let's have this done."
msgstr "나는 그녀의 자존심을 건드려서 멍청한 짓을 강요하려고 하네. 나팔을 불게. 이 위기를 끝내세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 9f4329f1-647e-9010-40d7-bc2194f6f13a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:9f4329f1-647e-9010-40d7-bc2194f6f13a
msgctxt "h44fab500g43e3g45efgafcbg9b45990e9c4c"
msgid ""
"Hah. What I have is no choice - we need to thin their numbers quickly if "
"we're to survive."
msgstr "하. 나에게 선택권은 없네. 우리가 살아남으려면 적의 숫자를 빨리 줄여야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Player
#. NodeID = 9f7aa865-44cc-284e-4488-e73c8372fdb5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:9f7aa865-44cc-284e-4488-e73c8372fdb5
msgctxt "h4c607d3eg1fedg487bg865agb740707c9b35"
msgid "We'll get through this, I swear to you."
msgstr "우린 이겨낼 것이오. 맹세하오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = a04d9400-8b85-1a59-6c13-4c90ee694318
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_Event_PassedByEntrance = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:a04d9400-8b85-1a59-6c13-4c90ee694318
msgctxt "hdb823d37g063bg4a16g8556gca66467571a9"
msgid "But what happened? We've seen them massing in the woods."
msgstr "그런데 무슨 일인가? 우리는 그들이 숲에 집결하는 걸 봤네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = a2b40dff-c3c5-b9e3-0194-692f851a30fa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:a2b40dff-c3c5-b9e3-0194-692f851a30fa
msgctxt "he2ab130dg0fc4g4848ga237g8b3d9be77668"
msgid "If it must be bloodshed after all, I'm glad to have you with us."
msgstr "결국 피를 흘려야 한다면, 자네가 우리와 함께여서 다행일세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Player
#. NodeID = ac288dd2-7821-d91b-9dc4-805c903fd966
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:ac288dd2-7821-d91b-9dc4-805c903fd966
msgctxt "ha37d2507g278cg46f7g8c18ge96be3f7e2e2"
msgid "As we'll ever be."
msgstr "만전의 상태입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = ae094086-c93b-cee7-0d33-794c43925187
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - DEN_Conflict_SUB_AoD.GotBriefed(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:ae094086-c93b-cee7-0d33-794c43925187
msgctxt "hdc364b1ag1228g4dc3g9485g8155b319eb4c"
msgid ""
"Do what you must, but quickly. Once you sound the horn, they'll come running."
msgstr "빨리 해야 할 일을 하게. 나팔을 울리면, 그들이 몰려올 걸세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Player
#. NodeID = aeadfc84-f94d-7136-54b2-72b2d280e312
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_BHAAL or CLERIC_MYRKUL or PALADIN_BHAAL or PALADIN_MYRKUL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:aeadfc84-f94d-7136-54b2-72b2d280e312
msgctxt "he12fb0e7g3f56g47bfg9f29g30f9a6481999"
msgid "I follow a god of death. That requires the occasional offering."
msgstr "나는 죽음의 신을 섬긴다. 그러기 위해서는 이따금 제물이 필요하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = b42c65a8-098d-22fa-c477-9ded3c669492
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:b42c65a8-098d-22fa-c477-9ded3c669492
msgctxt "heff0bc74g183bg4e71g92d6g80dbe5cf4da7"
msgid "I don't... Oh, gods."
msgstr "그건 무슨... 오, 이럴 수가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Player
#. NodeID = b52c0daa-862f-641b-eab0-80cb7859ed01
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:b52c0daa-862f-641b-eab0-80cb7859ed01
msgctxt "hca5bd86ag5a77g41cfgbb85gcec64008d936"
msgid "I met the drow leading them - and led her here."
msgstr "그들의 지도자인 드로우를 만났습니다. 그리고 그녀를 이곳으로 끌어들였죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = b62d41c5-70ea-cdc5-d630-877030c7fc8c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_AttackOnDen_Event_BetrayTieflingsBeforeFight = True
#.     - DEN_AttackOnDen_Event_WyllLeaves = True
#.   Quest:
#.     - ORI_COM_Wyll.CompanionLowRelation(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:b62d41c5-70ea-cdc5-d630-877030c7fc8c
msgctxt "hb6aee059g63b8g463bga56cg0f00d5d58c37"
msgid "Guards! Guards, help!"
msgstr "경비병! 경비병, 도와주게!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Player
#. NodeID = b6c87375-0216-8dc5-bd84-414dab518b69
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:b6c87375-0216-8dc5-bd84-414dab518b69
msgctxt "hcb4a58fcgc30cg4c25g9527g9015a3962946"
msgid ""
"I want to see droves, piles, heaps of dead. I want to climb a corpsed "
"mountain."
msgstr "죽은 자의 시체가 산더미처럼 쌓이는 걸 보고 싶어. 시체로 쌓아올린 산을 오르고 싶어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = b8e9309f-9c39-aef0-ffd3-283eb75f6b1b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:b8e9309f-9c39-aef0-ffd3-283eb75f6b1b
msgctxt "hc2ebe6afg6217g41f1g8d28g7661442194e1"
msgid "You've turned on us? Hells, <i>why</i>?"
msgstr "우리를 배신한 건가? 젠장, <i>어째서</i>?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = bfee149c-5d5b-b336-f290-0552041c83de
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:bfee149c-5d5b-b336-f290-0552041c83de
msgctxt "hbd8561a0g77bag4b53g8a41g0bcbb858aa27"
msgid ""
"Believe me, I've prayed to find one - but the gods have seen fit to stay out "
"of this."
msgstr "날 믿어주게. 내가 그 방법을 찾길 기도했지만, 신들께선 이 일에서 눈을 돌리는 것이 적절하다고 판단하신 것 같네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Player
#. NodeID = c24c75b9-bcdd-6cfd-b141-0ea0fe3e946f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:c24c75b9-bcdd-6cfd-b141-0ea0fe3e946f
msgctxt "hbbd2de16g771dg4947g9813gfb1227daee46"
msgid ""
"I... don't know. I'm sorry. I wanted to save you, but it seems I'm too weak."
msgstr "... 모르겠습니다. 미안하군요. 나는 당신들을 구하고 싶었는데, 그러기엔 너무 약한 모양입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = c2778efe-0790-4510-f1a1-e9ed11d1e117
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:c2778efe-0790-4510-f1a1-e9ed11d1e117
msgctxt "h92d9a9a7gb706g4ffdga6a5gd1c1720f29a3"
msgid "Just give the word."
msgstr "말만 하세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Player
#. NodeID = c677d739-d680-6242-3a4e-192501eb8019
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:c677d739-d680-6242-3a4e-192501eb8019
msgctxt "hf405cf21gacb6g4e8bga27eg520b0147a1c5"
msgid "A challenge for all to witness. She'll have a hard time resisting."
msgstr "모두가 지켜볼 도전이지요. 그녀가 거부하긴 힘들 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = d06f72d9-87a9-0510-505e-9ae8d6343c41
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:d06f72d9-87a9-0510-505e-9ae8d6343c41
msgctxt "h60a69e8bg5529g4fc7gbcfeg70358c72719f"
msgid ""
"Truly? Hells, I didn't expect her to... We were almost ready to <i>leave</i>."
msgstr "정말인가? 제기랄, 그녀는 예상하지 못했는데... 우리는 거의 <i>떠날</i> 준비가 되어 있었네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = d3412c3c-057e-c456-46ca-cd5b798aee88
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:d3412c3c-057e-c456-46ca-cd5b798aee88
msgctxt "hdc9a2123g5633g4ea7g8e1dgf94968542f22"
msgid "You led the <i>drow</i> here? By the Nine Hells, <i>why</i>?"
msgstr "자네가 <i>그 드로우</i>를 여기로 이끌었다고? 신들이시여, 대체 <i>왜</i>?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Player
#. NodeID = d5135851-668d-c704-012a-b25906249629
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:d5135851-668d-c704-012a-b25906249629
msgctxt "h546c59c6gfe8fg4588ga336ga016f5445782"
msgid "No point waiting around then. What do you need?"
msgstr "그럼 가만히 기다리는 건 소용 없겠군요. 필요한 게 뭐죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = d6d1058e-e4db-be01-422c-1cf3bd62d07c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_AttackOnDen_Event_GoToCamp = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:d6d1058e-e4db-be01-422c-1cf3bd62d07c
msgctxt "h31d819fdgfbc2g4b9bgb4ebgf6845bace8c9"
msgid "Excellent - lead the way."
msgstr "훌륭하군 - 앞장서게나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = dc8e963b-c0ff-28fa-84c6-9c1c8b23a830
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:dc8e963b-c0ff-28fa-84c6-9c1c8b23a830
msgctxt "hdda37727g2ed9g4742g8560g5b276e227c26"
msgid ""
"The horn. If you seek to draw her in, that damned thing's loud as thunder. "
"It'll give our people a chance to take shelter, too."
msgstr "뿔피리. 만약 드로우를 끌어들이겠다면, 저 망할 물건이 천둥 같은 소리를 내줄 걸세. 우리 피난민들도 듣고 대피할 수 있겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Player
#. NodeID = dca027c5-1e93-b56c-406d-63473b19521f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN_GOOD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:dca027c5-1e93-b56c-406d-63473b19521f
msgctxt "h7f5739f9g7378g4f8egbafagabbad2029d5c"
msgid "Take heart. My god is watching over us."
msgstr "용기를 가지십시오. 나의 주신께서 우리를 보우하고 계십니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = dee5aa98-7ca6-8903-a6ec-36341609b014
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:dee5aa98-7ca6-8903-a6ec-36341609b014
msgctxt "h44055122g1808g49efga73bg0e3b74cb8d61"
msgid ""
"Your courage is catching, it seems. Or perhaps I've finally lost my reason."
msgstr "자네의 용기가 전해진 것 같네. 아니면 내가 끝내 이성을 잃은 것일 수도 있지만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Wyll
#. NodeID = df494502-0e36-480f-a7cb-8320cde64888
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - AVATAR(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:df494502-0e36-480f-a7cb-8320cde64888
msgctxt "h8396d280ge2f6g4097g96c8g649b7a15445c"
msgid "No - you can't! I <i>trusted</i> you!"
msgstr "아니야- 그럴 수 없어! 널 <i>믿었는데</i>!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = e33cebcd-b444-0242-c9d8-3fbd7fe199df
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_DrowCommander_Event_WyllLeaves = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_TieflingLeader(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:e33cebcd-b444-0242-c9d8-3fbd7fe199df
msgctxt "hd89e7cd6gbe89g4d0cg8c76gfe91a47a0780"
msgid "You can understand why we've had to be cautious at the gates."
msgstr "자네는 우리가 관문에서 왜 그리 조심스러울 수 밖에 없었는지 이해할 수 있을 걸세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Player
#. NodeID = e3d7e07d-6886-cb31-0241-28c6ec70e316
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:e3d7e07d-6886-cb31-0241-28c6ec70e316
msgctxt "h09a3826bg9860g44cdgab3ag0e5ae728dfeb"
msgid "Yes - let's go."
msgstr "저도 준비됐어요 - 가시죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Player
#. NodeID = e608146b-419f-cdbe-1f0d-cbb8062cb623
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:e608146b-419f-cdbe-1f0d-cbb8062cb623
msgctxt "h1429b4beg5694g4544gbff2gb28e5d826a25"
msgid "It's who I am. Sin incarnate."
msgstr "죄악의 화신. 그게 나다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Player
#. NodeID = e694a899-f0a2-609d-3f24-c2918f3b91ff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:e694a899-f0a2-609d-3f24-c2918f3b91ff
msgctxt "h095c2908g2143g410bgb019gd7c97298eb13"
msgid "I can't tell if that's a really good plan or an <i>awful</i> one."
msgstr "그게 좋은 계획인지 끔찍한 계획인지 모르겠군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Player
#. NodeID = ed968b29-dced-9f9b-852a-aa3492e2cbae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:ed968b29-dced-9f9b-852a-aa3492e2cbae
msgctxt "hdc64aba3g2037g4309ga206gc1a27ca408a5"
msgid "Not yet - I need more time."
msgstr "아직입니다. 시간이 더 필요해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = f0a7d31a-2d81-8036-3e0e-cb48e216c067
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:f0a7d31a-2d81-8036-3e0e-cb48e216c067
msgctxt "h725ccfc7g3e1cg4989ga9a5g6f28a301284e"
msgid ""
"Good. She's expecting to find us weak and desperate - and she's not wrong."
msgstr "좋네. 그 여자는 우리가 나약하고 절박한 상태라고 생각하겠지, 그리고 틀린 생각도 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Player
#. NodeID = f35c4fae-040d-18f7-ae8c-530e48c1e158
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:f35c4fae-040d-18f7-ae8c-530e48c1e158
msgctxt "hff1230ebg1d9cg4454ga6e8g108558da6b47"
msgid "Do you have a plan?"
msgstr "계획은 있습니까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Wyll
#. NodeID = f5b7610e-1466-4bab-8c75-4842f88b2258
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - AVATAR(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:f5b7610e-1466-4bab-8c75-4842f88b2258
msgctxt "h03dba394g1b9cg4fa6ga0a0g8147ccea08b3"
msgid "Traitor. The Blade now comes for <i>you</i>."
msgstr "배신자. 이 칼날이 <i>너를</i> 벨 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = fbde7aa4-6003-94c3-1d73-39a4cd0fcc13
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:fbde7aa4-6003-94c3-1d73-39a4cd0fcc13
msgctxt "h43ffec70g4142g42b6g8f4ag133ea54c880e"
msgid "Of <i>course </i>it's personal."
msgstr "<i>물론</i> 그렇게 말하겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Player
#. NodeID = fe25a56f-207c-1fcb-d658-9f9f32fba517
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#. SetFlags:
#.   Object:
#.     - ORI_DarkUrge_Event_IndulgedUrge(1) = True
#.     - ORI_DarkUrge_Event_HadUrge(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:fe25a56f-207c-1fcb-d658-9f9f32fba517
msgctxt "h05051a96ga68ag4ea1gba53gee195fee99dc"
msgid "They are my horde. Together, we shall feast upon you."
msgstr "그건 내 무리야. 같이 너희를 먹어치울 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader
#. Speaker = Zevlor
#. NodeID = fefa56c3-0b21-d026-c0fb-68fab55306c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingLeader:fefa56c3-0b21-d026-c0fb-68fab55306c8
msgctxt "h176b8ecbgb80ag4f33gbfe1gc6690c3e0826"
msgid ""
"If this is what it has come to, then... so be it. You'll need to draw her "
"attention."
msgstr "결국 이렇게 될 운명이었다면, 좋아... 그렇게 하지. 자네가 드로우의 주의를 끌어야 하네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingVictory
#. Speaker = Zevlor
#. NodeID = 093e633f-5321-fd79-af30-2aca0fc6c793
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingVictory:093e633f-5321-fd79-af30-2aca0fc6c793
msgctxt "hf0b48c05g7558g49c0g9712g21347e509a2e"
msgid "We did it! Watching gods, <i>you </i>did it."
msgstr "우리가 해냈소! 신들께서 보살피시어, <i>그대들</i>이 해냈소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingVictory
#. Speaker = Zevlor
#. NodeID = 26da5baf-155c-7be4-90f0-dfa807edc147
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingVictory:26da5baf-155c-7be4-90f0-dfa807edc147
msgctxt "h712e3e59g0f7dg4b10g9f53g9373eae01aeb"
msgid ""
"But we need not speak of departures just yet. We have time - the road is "
"clear."
msgstr "하지만 아직은 작별 인사를 하지 않아도 될 것 같네. 길이 정리되었으니 아직 시간은 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingVictory
#. Speaker = Zevlor
#. NodeID = 2829747d-56e3-35d9-eea0-ae3e8c66d5fb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingVictory:2829747d-56e3-35d9-eea0-ae3e8c66d5fb
msgctxt "hf11532e4g2e01g431egbb5cg27f14cff628d"
msgid "Should you ever need it, you have family in Baldur's Gate."
msgstr "자네가 도움이 필요하면, 발더스 게이트에 자네의 가족이 있을 것이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingVictory
#. Speaker = Zevlor
#. NodeID = 715f3522-0b0d-23b2-101c-dfe7d395dfc6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingVictory:715f3522-0b0d-23b2-101c-dfe7d395dfc6
msgctxt "h491f7383g252fg4c1cg8a8ag74faf6326943"
msgid ""
"That's... that's the last of them. Tymora smile on me... they're <i>dead.</i>"
msgstr "그것이... 그것이 마지막 놈이었소. 티모라께서 나에게 미소 짓고 계시오... 저들은 <i>죽었소.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingVictory
#. Speaker = Zevlor
#. NodeID = 776277ab-31b9-77f4-9748-e73d2ce6d3c3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_AttackOnDen_Event_HalsinSpotted = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingVictory:776277ab-31b9-77f4-9748-e73d2ce6d3c3
msgctxt "h75504494g99f1g42c8g91e4gafed4c7cda8e"
msgid ""
"Go! Speak to him. Return when you wish to travel to your camp. We have twice "
"the reason to celebrate."
msgstr "가서 그와 이야기 나눠 보게! 그리고 야영지로 돌아가기 전에 다시 들러주길. 축하할 일이 두 배로 늘었으니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingVictory
#. Speaker = Zevlor
#. NodeID = 77cdc4cd-0d1c-20cf-8dbd-8244877f0852
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingVictory:77cdc4cd-0d1c-20cf-8dbd-8244877f0852
msgctxt "had25131ag04e5g4c16g80abgacc59600f415"
msgid ""
"I don't care. You were a friend when we needed it, and we won't forget that."
msgstr "나는 신경 쓰지 않네. 자네는 우리가 필요할 때 친구가 되어주었고, 우리는 이를 잊지 않을 것이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingVictory
#. Speaker = Zevlor
#. NodeID = 8245998c-0d0e-e9ea-2ce6-645ead2525a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingVictory:8245998c-0d0e-e9ea-2ce6-645ead2525a3
msgctxt "heb6a953fg4d78g4d91ga256gbd78b16fd921"
msgid "By all the watching gods... that's <i>Halsin.</i> <i></i>"
msgstr "신들께서 보우하사... <i>할신</i>이 돌아왔군. <i></i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingVictory
#. Speaker = Zevlor
#. NodeID = 8a689132-d6e8-fa30-0d21-57a3649ec359
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingVictory:8a689132-d6e8-fa30-0d21-57a3649ec359
msgctxt "h5f7a099fg40f0g4999g9b6fg54bf795904b0"
msgid ""
"But the blood of those who fell today ran as pure as any hero's - so I call "
"us by another name."
msgstr "하지만 오늘 쓰러진 이들의 피는 그 어떤 영웅의 피만큼 순수하게 흘렀소. 그러니 나는 우리를 다른 이름으로 부를 것이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingVictory
#. Speaker = Zevlor
#. NodeID = 9dfc9aff-6e5c-ab40-92dc-b834f8fccb94
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingVictory:9dfc9aff-6e5c-ab40-92dc-b834f8fccb94
msgctxt "hb9de5e6cg16aag4ec4g83f8gda91d00fcbf8"
msgid ""
"You. I don't know if you were sent here by gods, or fate, or sheer bloody "
"luck."
msgstr "자네를 이곳으로 보낸 것이 신인지, 운명인지, 아니면 그저 지독한 운인지는 모르겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingVictory
#. Speaker = Zevlor
#. NodeID = 9ee17644-6196-1bf7-5c65-ca401b47ae27
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KaghaIsDead = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingVictory:9ee17644-6196-1bf7-5c65-ca401b47ae27
msgctxt "hd3f22429g1ce9g4cf0g98f4g91edf3df3116"
msgid "He'll have some hard words for Kagha, I expect."
msgstr "바라건대 카그하가 꾸지람을 좀 들었으면 좋겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingVictory
#. Speaker = Zevlor
#. NodeID = ba804735-35f6-4abd-e340-eaae506b165b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_AttackOnDen_Event_VictorySpeech = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingVictory:ba804735-35f6-4abd-e340-eaae506b165b
msgctxt "h33e9a458gc860g4b6cg81beg943b623335c3"
msgid "They name us outcasts. Hellspawn. <i>Foulblood.</i>"
msgstr "우리는 추방자라고 불렸소. 지옥의 자손이자, <i>더러운 혈통</i>이라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingVictory
#. Speaker = Zevlor
#. NodeID = c430c72d-531f-b362-d9c0-dd232d7342e0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_AttackOnDen_Event_HalsinSpotted = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingVictory:c430c72d-531f-b362-d9c0-dd232d7342e0
msgctxt "habbee799ga809g42f2ga47dg9960babd3e17"
msgid ""
"Go speak to him. You're the reason he has a grove to return to at all. We'll "
"be here when you're ready to travel."
msgstr "가서 얘기해 보시게. 그가 숲으로 돌아갈 수 있게 된 건 전적으로 자네 덕분이잖나. 여행할 준비가 되면 우린 여기 있겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingVictory
#. Speaker = Zevlor
#. NodeID = dccb9900-272b-a235-bf6d-8fd7c86d7f05
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingVictory:dccb9900-272b-a235-bf6d-8fd7c86d7f05
msgctxt "he4fe5b17g0fa5g4d4ag9f4egcc30aca788b8"
msgid ""
"We are survivors. We are <i>family. </i>The road to Baldur's Gate is a long "
"one yet."
msgstr "우리는 생존자들이오. 우리는 <i>가족이오.</i> 아직 발더스 게이트로 향하는 길은 멀지만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingVictory
#. Speaker = Zevlor
#. NodeID = f6de2163-8b89-074d-39d5-54ce1af68f9a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingVictory:f6de2163-8b89-074d-39d5-54ce1af68f9a
msgctxt "h5f5eddcag5cd7g415agaa2bg04d621c0de59"
msgid ""
"But you have earned every stride so far. Make your preparations - we leave "
"as soon as we're able."
msgstr "우리는 지금까지 매 걸음을 내딛었소. 준비하시오 - 우리는 가능한 빨리 출발할 것이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingVictory
#. Speaker = Zevlor
#. NodeID = f9b91888-5778-de26-f555-2a1017abb3fb
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - DEN_Conflict.SidedTieflings_Celebrate(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TieflingVictory:f9b91888-5778-de26-f555-2a1017abb3fb
msgctxt "hf2607341gb609g4497gbbe3g1ce772626ea3"
msgid ""
"And I, for one, could use a bloody drink. We'll join your camp tonight, if "
"you'll have us."
msgstr "그리고 나는 독한 술을 마셨으면 좋겠군. 자네만 괜찮다면, 우리는 오늘 밤 자네 야영지에 합류하겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TorturedAdventurer
#. Speaker = Narrator
#. NodeID = 656eac7b-ae74-af16-b3c7-a0d23942af1c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TorturedAdventurer:656eac7b-ae74-af16-b3c7-a0d23942af1c
msgctxt "h49709c52g2488g4ce9g91c8g535d3c2ca1fb"
msgid ""
"*Despite the chaos in the camp, the adventurer sleeps soundly, wounds "
"expertly bandaged.*"
msgstr "*아영지의 혼란에도 불구하고 모험가는 곯아떨어져 있고 상처엔 능숙한 솜씨로 붕대가 감아져 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainee001
#. Speaker = Umi
#. NodeID = 0d0b0490-c17d-21da-6f53-705ab3cace52
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Trainee001Victory(1) = True
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainee001:0d0b0490-c17d-21da-6f53-705ab3cace52
msgctxt "h6462cc0dgeadfg4b70gad9cg8117aadfa647"
msgid "I'm not fighting anymore. Not even if someone calls me names."
msgstr "나는 더 이상 안 싸울 거예요. 누가 욕해도 상관없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainee001
#. Speaker = Umi
#. NodeID = 3fc0f756-72de-4cde-6aed-063deea5334c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Trainee001Victory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainee001:3fc0f756-72de-4cde-6aed-063deea5334c
msgctxt "h34429cf6g1ab9g48ddgb532g4fb118bc6598"
msgid ""
"I left my sword in the cave. Don't tell, but... I don't want to touch it "
"again."
msgstr "동굴에 내 검 냅두고 왔어요. 이건 비밀인데... 다신 그거 잡고 싶지 않아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainee001
#. Speaker = Umi
#. NodeID = baf76a0a-4c0f-aa70-7eed-2384c6a80383
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Trainee001(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainee001:baf76a0a-4c0f-aa70-7eed-2384c6a80383
msgctxt "h014c37c9g1dd7g4ac8ga7f7gd68d5a502e10"
msgid "I don't <i>want</i> to fight goblins. You can't make me!"
msgstr "난 고블린이랑 싸우고 싶지 <i>않아요</i>. 억지로 시키지 마요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainee001
#. Speaker = Wyll
#. NodeID = c3c9caf7-a5d4-6257-8852-fe7b52358957
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainee001:c3c9caf7-a5d4-6257-8852-fe7b52358957
msgctxt "h15d9d81ag4440g41dbg9befg383a98eb03e1"
msgid "It's all right. Don't tell anyone - but I was afraid, too."
msgstr "괜찮아. 비밀 지켜줄게. 솔직히 말하면, 나도 무서웠단다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainee001
#. Speaker = Lae'zel
#. NodeID = c613429c-a2a5-d4b1-268a-900727ab0ea5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_4 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainee001:c613429c-a2a5-d4b1-268a-900727ab0ea5
msgctxt "hd83fbd61g085bg47edg937dgeb680684908f"
msgid ""
"Bah! At your age, I'd already spilled my own cousin's blood. Face your fear, "
"or it will devour you."
msgstr "하! 내가 네 나이 땐, 내 사촌의 피를 손에 직접 묻혔다고. 공포를 피하기만 하면 그것이 널 집어삼킬 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainee001
#. Speaker = Umi
#. NodeID = d4ebd100-7a42-0de0-8fa8-46422f877095
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Trainee001(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainee001:d4ebd100-7a42-0de0-8fa8-46422f877095
msgctxt "h79e56c8eg1994g4524ga993g325b10e893ff"
msgid "Go away. Please, make them all just <i>go away!</i>"
msgstr "쫓아내 주세요. 제발, 저놈들 다 <i>쫓아내 줘요!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainee002
#. Speaker = Ide
#. NodeID = 45b41d0a-c818-15a6-feb0-ac476065c1e8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Trainee002Victory(1) = True
#.   Global:
#.      - DEN_Refugees_State_LeadersAreDead = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainee002:45b41d0a-c818-15a6-feb0-ac476065c1e8
msgctxt "hd31db384g1883g417cgb802g16510ce7fc5c"
msgid "I can't wait to go. This place is <i>boring.</i>"
msgstr "얼른 떠나고 싶어요. 여긴 정말 <i>따분해요.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainee002
#. Speaker = Ide
#. NodeID = 4db789ca-1d29-8435-3ba8-9326c18875df
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Trainee002(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainee002:4db789ca-1d29-8435-3ba8-9326c18875df
msgctxt "he6ba39cdgf044g4b90gb424g6b488fbf9ea5"
msgid "You can hide in here if you like. No one's getting past us."
msgstr "원한다면 여기 숨으세요. 저희가 아무도 못 지나가게 할게요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainee002
#. Speaker = Ide
#. NodeID = 51f58619-e66e-bde0-0082-c5599f62c2ad
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Trainee002(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainee002:51f58619-e66e-bde0-0082-c5599f62c2ad
msgctxt "hd99125a7gee86g4660g8daeg2a98e08ca19e"
msgid "Asharak says goblins are just little like us. Easy."
msgstr "아샤라크 아저씨가 고블린은 우리처럼 쪼그맣대요. 만만하죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainee002
#. Speaker = Ide
#. NodeID = c18edda5-b1b1-a1b3-bcc4-aba2974eac40
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Trainee002Victory(1) = True
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainee002:c18edda5-b1b1-a1b3-bcc4-aba2974eac40
msgctxt "hfa654428g85f3g498eg9de2ga542db73ac7c"
msgid "Hope we meet some monsters on the road. I want to <i>practice.</i>"
msgstr "가는 길에 괴물 좀 만나면 좋겠어요. <i>연습</i> 상대가 필요하다고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainee002
#. Speaker = Ide
#. NodeID = daf7833c-d8f4-2e66-bab0-0af348ff94f9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Trainee002Victory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainee002:daf7833c-d8f4-2e66-bab0-0af348ff94f9
msgctxt "h2ba39ea1g92d3g4d15gb16cgd1477c38f30f"
msgid "I told you I wasn't afraid. Those goblins look <i>tiny.</i>"
msgstr "제가 저놈들 안 무섭다고 했죠? 고블린놈들 <i>쥐똥</i>만 하더라고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainee002
#. Speaker = Ide
#. NodeID = f009cb4e-a6af-b727-c61a-287d6633fb65
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Refugees_State_LeadersAreDead = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Trainee002Victory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainee002:f009cb4e-a6af-b727-c61a-287d6633fb65
msgctxt "h9a82cb68g06f9g4551g930eg96f7d8ed2e92"
msgid ""
"I'm glad you killed all the goblins. I hope you made them <i>scared.</i>"
msgstr "고블린들 싹 다 죽여줘서 고마워요. 놈들이 <i>무서워했다면</i> 좋겠어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainee003
#. Speaker = Gan
#. NodeID = 14c9bbd0-4e8c-0af7-2733-e1d542f0a801
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Trainee003(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainee003:14c9bbd0-4e8c-0af7-2733-e1d542f0a801
msgctxt "h24f0bb9bg07d9g49eagb9f3g18db3c5ce701"
msgid "Just shout if you need help up there."
msgstr "도움이 필요하면 불러만 줘요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainee003
#. Speaker = Gan
#. NodeID = 37657e38-19a7-4782-4631-7ef14e3cd0c7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Trainee003Victory(1) = True
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainee003:37657e38-19a7-4782-4631-7ef14e3cd0c7
msgctxt "hcd835599gcfc3g4912g89b3g24a962e574a2"
msgid "I know people are hurt, but don't worry. I'll guard them on the road."
msgstr "환자들이 있긴 하지만 걱정 마요. 여정 나서면 제가 그분들 지킬 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainee003
#. Speaker = Gan
#. NodeID = 41129951-1e6d-694a-74c9-91918278aec7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Refugees_State_LeadersAreDead = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Trainee003Victory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainee003:41129951-1e6d-694a-74c9-91918278aec7
msgctxt "h4194fb66ged69g4255ga5c5g76c3a7b970d4"
msgid ""
"I hate you. You killed all the goblins and now we can't practise swords "
"anymore."
msgstr "당신 싫어요. 고블린 다 죽여버린 바람에 우린 이제 검술 연습 못하게 됐다고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainee003
#. Speaker = Gan
#. NodeID = 7f3fbce6-84f8-5dbb-877d-a7a286728010
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Trainee003Victory(1) = True
#.   Global:
#.      - DEN_Refugees_State_LeadersAreDead = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainee003:7f3fbce6-84f8-5dbb-877d-a7a286728010
msgctxt "h1963e0adgc528g42e9gb002gdaa79c5b1728"
msgid ""
"I wanted to fight, like you. Now they're just going to make me feed the "
"animals again."
msgstr "저도 그쪽처럼 싸우고 싶었는데. 어른들이 시키는대로 다시 동물들 밥이나 주게 생겼어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainee003
#. Speaker = Gan
#. NodeID = c236696c-d9ec-5a27-a442-b5e833f8d405
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Trainee003(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainee003:c236696c-d9ec-5a27-a442-b5e833f8d405
msgctxt "h682c9b8agd552g4e47g8535ge8b24ebdb215"
msgid ""
"You should be manning the wall. I wanted to, but Asharak says I'm needed "
"here."
msgstr "그쪽은 방벽 지키고 있어야죠. 그거 제가 하고 싶었는데 아샤라크 아저씨가 여기 있으랬어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainee003
#. Speaker = Gan
#. NodeID = c6de21ea-bb51-4b4d-0c48-3d119091e89a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Trainee003Victory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainee003:c6de21ea-bb51-4b4d-0c48-3d119091e89a
msgctxt "ha8fbb5ebg007ag4d0bgba77g98ee222468dd"
msgid "Everyone looks so tired. You should have let me <i>help</i>."
msgstr "다들 엄청 지쳐 보여요. 그러게 저도 <i>돕게</i> 해줬어야죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = 0054c2fc-b55c-c1ef-6495-2ef65dfb8716
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - DEN_Conflict_SUB_AoD.GotBriefed(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:0054c2fc-b55c-c1ef-6495-2ef65dfb8716
msgctxt "h87121a8fg4d85g4429gb967g45868361ca05"
msgid ""
"That horn can be heard half the world away - let's issue a challenge, shall "
"we?"
msgstr "저 뿔피리는 세상 반대편에서도 들리겠군. 도전장을 내밀어 보자고. 어떤가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Wyll
#. NodeID = 017b2566-3e9d-14ad-5a22-862391073d18
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - AVATAR(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:017b2566-3e9d-14ad-5a22-862391073d18
msgctxt "h40850886ga738g460dgb0f4g9d30d9a9b284"
msgid "No - you can't! I <i>trusted</i> you!"
msgstr "아니야- 그럴 수 없어! 널 <i>믿었는데</i>!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Player
#. NodeID = 02210a38-2c88-e9f7-a2fe-063880a0d51f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:02210a38-2c88-e9f7-a2fe-063880a0d51f
msgctxt "h798903f0g4155g4017gbdc0g89e705b143bd"
msgid "No, you don't get it. I'm with <i>them</i>."
msgstr "아니, 이해를 못하는군. 난 <i>그들의</i> 편이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Player
#. NodeID = 06ebfa90-b7c1-a8e8-d695-d65aa7956aba
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:06ebfa90-b7c1-a8e8-d695-d65aa7956aba
msgctxt "h70439e61g8770g4978g965egd9987cfbd689"
msgid "What do you think? Ready for battle - and leave the drow to me."
msgstr "뭐일 것 같아? 싸울 준비나 해. 그 드로우는 내게 맡기고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Player
#. NodeID = 0b83b8ae-702c-422c-cfb7-a6ac40fbbd8e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:0b83b8ae-702c-422c-cfb7-a6ac40fbbd8e
msgctxt "h23043a51ga425g40f2g8b29gffccad8ca4c8"
msgid "A bold plan - but a risky one."
msgstr "대담한 계획이군. 하지만 위험한 계획이기도 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = 0c529ec9-eea3-85c1-04c3-b4aa389e6971
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:0c529ec9-eea3-85c1-04c3-b4aa389e6971
msgctxt "hfee51395gcdf9g448egb27fgef383266d612"
msgid ""
"Simplest strategy there is: draw them in and burn them faster than they can "
"burn us."
msgstr "간단하기 그지없는 전략이지. 놈들을 끌어들이고, 불태우는 거야. 놈들이 우리를 불태우기 전에."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = 0ec4d00a-78b3-7b8c-9d0b-eec57f18ec61
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:0ec4d00a-78b3-7b8c-9d0b-eec57f18ec61
msgctxt "h470f0315g782cg42e6g8ab4g3f1fd8e2ad4c"
msgid ""
"That's why our every ounce of anything that goes boom is buried out in front "
"of that gate."
msgstr "그래서 우리가 터트릴 수 있는 물건이란 물건은 죄다 저 문 앞에 묻어둔 거지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Player
#. NodeID = 172f3b96-a79c-fd60-c2fb-bfed33ff4901
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:172f3b96-a79c-fd60-c2fb-bfed33ff4901
msgctxt "h0e1eeefcg0ba4g4e21ga173g491ee6032346"
msgid "That's the stupidest damn plan I've ever heard."
msgstr "내가 들어본 것 중 가장 멍청한 빌어먹을 계획이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Player
#. NodeID = 188a804e-cdff-2fb9-5a76-c21ea70f6353
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:188a804e-cdff-2fb9-5a76-c21ea70f6353
msgctxt "h131e2072g5e9dg4bb3gbcc9g311c47156f3d"
msgid "Hold on - what's the plan again?"
msgstr "잠깐, 계획이 뭐라고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = 1b5c30ef-1b1e-cc9c-1539-fa0c68bcf51f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#.      - DEN_TieflingLeader_State_PermaDefeated = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:1b5c30ef-1b1e-cc9c-1539-fa0c68bcf51f
msgctxt "h39b0c4aag8e43g4a40g9bcege321beb1ff70"
msgid ""
"On to the city. After what you showed us, I damn well pity any who try and "
"keep us out."
msgstr "도시로 가자고. 자네 실력을 보고 나니, 우리 앞길을 막으려는 놈들이 어지간히 불쌍하게 느껴지는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = 1d05d5f7-9ba8-723d-e806-05ca2deaa798
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:1d05d5f7-9ba8-723d-e806-05ca2deaa798
msgctxt "he49be64agb650g4b18gb70bge5f95a77c909"
msgid "Who knows - with your help, might be we can even make a fight of it."
msgstr "모를 일이지. 자네가 돕는다면, 제대로 맞서 싸울 수 있을지도."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = 1d1dc9b7-f1e2-865c-2a37-25a473369ad6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:1d1dc9b7-f1e2-865c-2a37-25a473369ad6
msgctxt "h6270087ag7330g47e2g9d40g97c19f295550"
msgid "What happened?! We've spotted goblins massing in the woods."
msgstr "무슨 일이 있었나?! 숲에 고블린들이 모여 있는 걸 발견했는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = 1eb0f65f-84ac-a85a-5edf-8deb3652f113
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:1eb0f65f-84ac-a85a-5edf-8deb3652f113
msgctxt "h29999758g941eg46cfga640gcbb8904bfdb5"
msgid ""
"Hah! Enough warriors to make this a fair fight. Failing that, we've got the "
"means to make it <i>unfair</i>."
msgstr "하! 이제야 좀 공정한 싸움이 되겠군. 자네가 거절했다면 최대한 우리 쪽으로 균형을 <i>기울여야</i> 했을 걸세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Player
#. NodeID = 214ad2e8-b025-003d-12f2-400eda4c2bb4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:214ad2e8-b025-003d-12f2-400eda4c2bb4
msgctxt "heef66552gf3afg4d47g93c2ga4d0fc15ebd3"
msgid "For the glory of the Absolute. Why else?"
msgstr "절대자의 영광을 위하여. 다른 이유가 있겠어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Player
#. NodeID = 219feac6-38ce-7bdc-9efe-5999152db877
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:219feac6-38ce-7bdc-9efe-5999152db877
msgctxt "h8ce2f0abg22a6g4ff8ga2bcg3aea1c4e9d0a"
msgid "To burn the grove, of course. For the glory of the Absolute."
msgstr "당연히 숲을 불태우기 위해서지. 절대자님의 영광을 위하여."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = 26ea45fc-be81-b93a-ca25-ebc6f6a1a8d8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_AttackOnDen_Event_GoToCamp = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:26ea45fc-be81-b93a-ca25-ebc6f6a1a8d8
msgctxt "he5b5acdfg178dg4502g8c85g8a58031ac571"
msgid "Best news I've heard all day."
msgstr "듣던 중 반가운 소식이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = 2737a96f-e9d2-4ef1-0d37-b39f7d7e614a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:2737a96f-e9d2-4ef1-0d37-b39f7d7e614a
msgctxt "h3e391443gd322g4aacg9408g9a8266793694"
msgid "No two ways about it, now - a fight it'll have to be."
msgstr "이제 다른 길은 없네. 싸우는 수밖에."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = 2941d2b5-ebfa-4dfc-195c-e801c51f7a9f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Trainer(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:2941d2b5-ebfa-4dfc-195c-e801c51f7a9f
msgctxt "h7032a005g685bg42b7gb68bg5f6892a19442"
msgid ""
"Well - are we ready? Tymora's spun her coin, and I would see which way it "
"lands."
msgstr "자, 준비됐나? 행운의 여신 티모라께서 동전을 던지셨네. 그게 어느 쪽에 떨어질지 지켜보세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = 2c2700e0-f8d5-4e9d-02c9-252cbcfe684f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - DEN_Conflict_SUB_AoD.GotBriefed(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:2c2700e0-f8d5-4e9d-02c9-252cbcfe684f
msgctxt "h19996c85g60d9g4ecdgaca1ga195264a42ed"
msgid ""
"That horn can be heard half the world away - let's issue a challenge, eh?"
msgstr "저 뿔피리는 세상 반대편에서도 들리겠군. 도전장을 내밀어 보자고. 어떤가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Player
#. NodeID = 30cac2cc-e018-7fc1-a880-4dae92109175
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC_MYRKUL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:30cac2cc-e018-7fc1-a880-4dae92109175
msgctxt "hdbe2f53bg370eg460dg822cg62f6413b81c8"
msgid "I have a god to please, and Myrkul loves a slaughter."
msgstr "제가 기쁘게 해드려야 할 신, 미르쿨은 살육을 사랑합니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = 31cb8a10-87df-759d-1254-818a42045972
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:31cb8a10-87df-759d-1254-818a42045972
msgctxt "h305bda51gcfa7g424dg9c60g2fd298d7367a"
msgid ""
"I'd given you up for dead at the goblin camp - and our hopes along with you."
msgstr "난 자네가 고블린 야영지에서 죽은 줄 알고 자네를 단념하려 했어. 더구나 자네에게 우리 희망이 달렸으니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = 32ce101a-88f7-c567-790c-6e6b702539cd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:32ce101a-88f7-c567-790c-6e6b702539cd
msgctxt "h04263697g52feg4311gb53bgfb735a8e4ec3"
msgid ""
"But if you're willing to spit in Lady Doom's eye along with us, I won't turn "
"you down."
msgstr "허나 자네가 우리와 함께 파멸의 여신의 면전에 침을 뱉겠다면, 말리지 않겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = 36c38bfd-fc94-7a47-b189-985c779b3662
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:36c38bfd-fc94-7a47-b189-985c779b3662
msgctxt "ha335cd78ge1ffg481dg96bcg6b537ec614da"
msgid "A trap? We're the ones backed into a corner here, I'd say."
msgstr "함정이라고 했나? 궁지에 몰린 건 우리 쪽인 것 같네만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Player
#. NodeID = 38916e57-d1f7-79a6-ddd6-c0ebb1364dcf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:38916e57-d1f7-79a6-ddd6-c0ebb1364dcf
msgctxt "h85d5bb0cge52ag4a71gbff5g0ee92e7531a7"
msgid ""
"All part of the plan. I'll give the signal and she'll march into our trap."
msgstr "모두 계획의 일부입니다. 내가 신호하면, 함정을 향해 제 발로 걸어 들어올 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = 39c2e3e2-7f2d-b48c-f724-eb3c5878c48d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:39c2e3e2-7f2d-b48c-f724-eb3c5878c48d
msgctxt "h9003494bg4263g461fg8aedgd19b2d77073e"
msgid "Gods damn it, I'm sorry. I know you wouldn't draw her on us."
msgstr "젠장, 미안하네. 자네가 일부러 그랬을 거라고 생각하지는 않네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = 3f47df72-7700-bd0c-34b0-647e9c9fc0c5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingRefugees_Quest_HuntRewardOffered = False
#. SetFlags:
#.   Global:
#.     - DEN_TieflingRefugees_Quest_HuntRewardOffered = True
#.   Object:
#.     - DEN_GoblinHunt_Event_GiveRewardBag(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:3f47df72-7700-bd0c-34b0-647e9c9fc0c5
msgctxt "ha65bd06cg5564g4609g99a0gd3b85180da1e"
msgid ""
"Here - it's not much, but it's yours. Zevlor ordered a collection, before..."
msgstr "여기 - 많지는 않지만 받아 두게. 제블로어가 거두어들였던 것들이네. 가기 전에..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = 42b6b02a-c9e5-8cdc-ffb2-2303af67d7d3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Trainer(1) = False
#.   Global:
#.      - DEN_TieflingLeader_State_PermaDefeated = False
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Trainer(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:42b6b02a-c9e5-8cdc-ffb2-2303af67d7d3
msgctxt "h614d8530gf55ag4088g8371g1e6dafa8c4dd"
msgid ""
"Won't pretend I expected to see you back again. Bloody <i>glad</i>, mind."
msgstr "다시 보게 될 줄은 전혀 예상 못했어. 끝내주게 <i>기쁘군</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = 42c7bd5f-633f-36f4-19fb-5034a31d9b9b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:42c7bd5f-633f-36f4-19fb-5034a31d9b9b
msgctxt "h3532432agdd24g47d6gb17fg28551fe5db80"
msgid "Let the bastards know we're waiting for them."
msgstr "그 개자식들에게 우리가 기다리고 있다는 걸 알려줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = 46f55692-79bb-1962-77c1-10f0aca11adc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Refugees_State_LeadersAreDead = False
#.      - DEN_AttackOnDen_Event_TieflingPartyInvitation = True
#.      - DEN_AttackOnDen_State_DenVictory = True
#.      - DEN_TieflingLeader_State_PermaDefeated = True
#. SetFlags:
#.   Quest:
#.     - DEN_Conflict_SUB_Goblin.LearnedLeaving(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:46f55692-79bb-1962-77c1-10f0aca11adc
msgctxt "h9560a50bgc4e4g46cdgb71fgff66745e4ed2"
msgid "We're ready to celebrate. Are you?"
msgstr "우린 축하할 준비가 됐는데. 그쪽은?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = 4bba8404-8fd5-5d98-7caa-3eb7d919b934
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:4bba8404-8fd5-5d98-7caa-3eb7d919b934
msgctxt "h22f5d5cdg0e5cg4ec4g8e91g48d69af1b3f1"
msgid "Gods, they're going to want a bloody <i>speech</i>, aren't they?"
msgstr "신들이시여, 사람들이 망할 놈의 <i>연설</i>을 기다리겠군, 안 그런가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Player
#. NodeID = 570df940-a025-ede0-0a30-347933168e9c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:570df940-a025-ede0-0a30-347933168e9c
msgctxt "ha13cbe95g2046g4ecdg8597g0f9a1be2135d"
msgid "Give me a moment. I have more to do."
msgstr "잠시만. 아직 할 일이 남았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = 5dae3610-ccc8-9cbe-e71b-d1727273711b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:5dae3610-ccc8-9cbe-e71b-d1727273711b
msgctxt "hd92fbf7eg5836g4e72gb95bg743aafe6e662"
msgid ""
"...A drow. Right - I'd say I'm surprised, but Beshaba's had her mark on us "
"since Elturel."
msgstr "...드로우라. 좋아, 불행의 여신 베샤바가 엘투렐부터 줄곧 따라다니고 있으니 새삼스러울 것도 없군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = 610cb75b-8f8e-2655-9874-fd663fbdf41f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Trainer(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:610cb75b-8f8e-2655-9874-fd663fbdf41f
msgctxt "h83c1a6d6g75ecg4bc1g94fag2632417700c5"
msgid "<i>How did you -</i>"
msgstr "<i>어떻게...</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Player
#. NodeID = 64400436-28d3-621f-75d9-3796f865fcd2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN_BHAAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:64400436-28d3-621f-75d9-3796f865fcd2
msgctxt "h77104c5dgea30g4715g836eg45c8b44354af"
msgid "I have a god to please, and Bhaal loves murder."
msgstr "제가 기쁘게 해드려야 할 신, 바알은 살인을 사랑합니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = 64db6922-3d22-0f23-c7ec-e509ea904df9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:64db6922-3d22-0f23-c7ec-e509ea904df9
msgctxt "ha805b498ga611g4fe9g80c5g7c2e40375d08"
msgid ""
"Fact is, we can't beat 'em - not in a fair fight. So best make it as unfair "
"as possible, eh?"
msgstr "사실, 우리는 그들을 이길 수 없어. 공정한 싸움에서는 말이지. 그러니 가능한 한 불공평하게 만드는 게 최선 아니겠나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = 6585dac8-b6d3-7125-c51e-b5686fea0cc8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingLeader_State_PermaDefeated = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:6585dac8-b6d3-7125-c51e-b5686fea0cc8
msgctxt "h79f13237gb87bg4a46g8292ge5695f1c3fbf"
msgid ""
"My students are down in the cave. With wooden bloody swords, Torm spare me."
msgstr "내 제자들이 동굴 아래 모여 있네. 염병할 목검을 들고 말이네. 톰께 자비를."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = 6a7b2c9c-c80d-c5ce-444a-74105d09d9b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:6a7b2c9c-c80d-c5ce-444a-74105d09d9b4
msgctxt "h7f498e2bga321g40b5gbdddg3ab98b57ff5f"
msgid "I'd sooner start this on our terms than theirs."
msgstr "그들이 짠 장기판보다는 우리에게 유리한 판에서 곧바로 개시하고 싶네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Player
#. NodeID = 6b8a366e-a0df-3ec8-0301-50919ba5e979
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN_MYRKUL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:6b8a366e-a0df-3ec8-0301-50919ba5e979
msgctxt "ha6a4cbc3gd46bg427bg8d07gc2addf7d2ce3"
msgid "I have a god to please, and Myrkul loves a slaughter."
msgstr "제가 기쁘게 해드려야 할 신, 미르쿨은 살육을 사랑합니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Player
#. NodeID = 7117c323-6582-385f-3588-47bf164a9a10
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:7117c323-6582-385f-3588-47bf164a9a10
msgctxt "h4508efb8g825eg47edg848bg9a2d4c25897b"
msgid "She tricked me. But I mean to make up for it."
msgstr "드로우가 나를 속였어요. 이제 되갚아주려는 참입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = 726628fd-aafa-0f79-326d-628bed3b07dc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Trainer_HasMet_GoblinHuntDone(1) = False
#.   Global:
#.      - DEN_Refugees_State_LeadersAreDead = True
#.      - DEN_TieflingLeader_State_PermaDefeated = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Trainer_HasMet_GoblinHuntDone(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:726628fd-aafa-0f79-326d-628bed3b07dc
msgctxt "h57d13bc3gccb9g4d1bg8718g5a2f13373d5a"
msgid ""
"We've just got word - the goblins have cleared out. And I hear it's you we "
"have to thank."
msgstr "방금 고블린들이 처리되었다는 소식을 들었어. 감사할 대상이 당신이라는 것도."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = 7976b739-5f90-a41b-ace1-4eede5e0b804
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_AttackOnDen_Event_BetrayTieflingsBeforeFight = True
#.     - DEN_AttackOnDen_Event_WyllLeaves = True
#.   Quest:
#.     - ORI_COM_Wyll.CompanionLowRelation(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:7976b739-5f90-a41b-ace1-4eede5e0b804
msgctxt "h61cc26cbgd387g45a8g832cg4c6bbc4fe6b3"
msgid "Well to the hells with you - and your god and all. Guards! Weapons!"
msgstr "그럼 지옥에나 가시지. 네 신도 마찬가지다. 경비병! 무기를 들어라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Player
#. NodeID = 83c97573-b144-11c3-38b0-fd01c8312623
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:83c97573-b144-11c3-38b0-fd01c8312623
msgctxt "h8136d53bg33b3g48b3gb9fag0917fc45a3c2"
msgid "As we'll ever be. Let's go."
msgstr "만전의 상태야. 가자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = 8a04ac02-44f5-4af8-91b4-f9cf43e7a33a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:8a04ac02-44f5-4af8-91b4-f9cf43e7a33a
msgctxt "h8fd5d917g34a2g481egb977g72cacd6824f0"
msgid "We'll need every blade if we're to make a fight of this."
msgstr "칼만 쥘 수 있다면 애들 손이라도 빌려야 할 판이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Wyll
#. NodeID = 8ac20405-8857-a3b2-59f9-1dfef43739fd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - AVATAR(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:8ac20405-8857-a3b2-59f9-1dfef43739fd
msgctxt "haffe545egcea6g4c06ga11dg31ac7d0508ba"
msgid "Come. It's time to paint the place red."
msgstr "가자. 이곳을 붉게 물들일 시간이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = 8bcec4de-c8e9-d239-5121-dd2d8a10783f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KaghaIsDead = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:8bcec4de-c8e9-d239-5121-dd2d8a10783f
msgctxt "h13478fe6g7221g44eeg98d0g4435df6170bf"
msgid ""
"He's having words with Kagha. Reckon you don't want to miss that, but come "
"find us after."
msgstr "분명 카그하와 담판을 지으려 하겠지. 그런 광경은 놓치지 않는 게 좋겠군. 나중에 다시 들러주게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = 8f37f0b0-1ded-9450-cf1f-044227d62c55
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:8f37f0b0-1ded-9450-cf1f-044227d62c55
msgctxt "h0f6050ebg835eg4bd6gb2f2gc30b39895390"
msgid ""
"Burning drow sounds a pretty good option to me - but we'll have to get her "
"here first."
msgstr "드로우를 불태워버리는 건 괜찮은 선택지라네. 여기로 끌어낼 수만 있다면 말이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = 8fbb5b6d-08eb-197a-13d1-c0239b1c2c6a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:8fbb5b6d-08eb-197a-13d1-c0239b1c2c6a
msgctxt "hcef12872g9e7fg45b6gb39fgc2f29bdc7afa"
msgid ""
"Not <i>so</i> risky. Drow are cunning buggers, aye - but proud too, the way "
"I hear it."
msgstr "<i>그렇게</i> 위험하지는 않네. 그래, 드로우는 교활한 족속들이지. 하지만 내가 알기로 그만큼 오만하기도 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = 90de7560-16c6-8c01-e61c-a0a4cbfab0d1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:90de7560-16c6-8c01-e61c-a0a4cbfab0d1
msgctxt "ha618c807ga03bg49b3gbcd5ga72769cdf004"
msgid ""
"Gods, thought I was seeing a bloody ghost. How did you survive the goblin "
"camp?"
msgstr "신이시여, 내가 빌어먹을 유령이라도 보고 있는 줄 알았네. 대체 고블린 야영지에서 어떻게 살아남은 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = 97f08621-5d17-9ce3-df81-676bac1b2cff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:97f08621-5d17-9ce3-df81-676bac1b2cff
msgctxt "ha2c900d4g5439g4f6bga81agd081aac793bb"
msgid "'Make up for it'? How the bloody hells -"
msgstr "'되갚아주겠다'고? 이런 망할 -"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Player
#. NodeID = 9b5a3555-ea4b-148e-da16-45d60dc182ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:9b5a3555-ea4b-148e-da16-45d60dc182ae
msgctxt "h44e0ac7ag63d0g454bgb371ge4b21d45ba1e"
msgid "Of course. Tell me what you need."
msgstr "물론이죠. 말씀만 하세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = 9bb8a45f-657e-6238-d311-cac2270cfbd2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:9bb8a45f-657e-6238-d311-cac2270cfbd2
msgctxt "he7341ad7g9cabg4c77g9ecbg49cdbbe3297d"
msgid "A... a drow? Why the hells would you bring her <i>here</i>?"
msgstr "드... 드로우라고? 도대체 무슨 생각으로 놈을 <i>여기</i>로 데려온 거냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = a8a0da50-816e-bbd6-5406-f70a9d2f465c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_AttackOnDen_Event_BetrayTieflingsBeforeFight = True
#.     - DEN_AttackOnDen_Event_WyllLeaves = True
#.   Quest:
#.     - ORI_COM_Wyll.CompanionLowRelation(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:a8a0da50-816e-bbd6-5406-f70a9d2f465c
msgctxt "he0d728d0g24e1g4366g9df7ge233c09e6292"
msgid "Well to the hells with you, then. Guards - weapons!"
msgstr "그럼 지옥에나 가시지. 경비병 - 무기를 들어라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Player
#. NodeID = a8b69118-b923-c163-4994-35c844945c46
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_TIEFLING
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:a8b69118-b923-c163-4994-35c844945c46
msgctxt "h9f3e50d8gd2feg4a03g8b59g2b628dbb3768"
msgid "What? You think a bloodline makes us allies?"
msgstr "뭐? 혈통 따위로 우릴 아군이라고 생각했어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Player
#. NodeID = a8b69118-b923-c163-4994-35c844945c46
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:a8b69118-b923-c163-4994-35c844945c46
msgctxt "ha85fd286g2acfg4decg9e0agf62744ada4a5"
msgid "Simple - the goblins are a lot more useful to me."
msgstr "간단해. 고블린이 훨씬 더 쓸모가 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Player
#. NodeID = a8e31092-ca4d-181b-0362-c7d0981bdc79
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_DrowCommander_Event_OrderedToJoinHunt(1) = True
#.   Global:
#.      - GOB_DrowCommander_State_ReadyToGo = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:a8e31092-ca4d-181b-0362-c7d0981bdc79
msgctxt "h4915cc95g5186g4befga074g3f3de4abe936"
msgid "I met the drow commanding them - and led her here."
msgstr "놈들을 지휘하는 드로우를 만났고, 여기로 끌어들였습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Player
#. NodeID = a982c29d-830b-2ae2-58d3-4eddb1a357aa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC_BHAAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:a982c29d-830b-2ae2-58d3-4eddb1a357aa
msgctxt "h4c25e3b9g63f6g48fdgbd4cg7cd5a8397565"
msgid "I have a god to please, and Bhaal loves murder."
msgstr "제가 기쁘게 해드려야 할 신, 바알은 살인을 사랑합니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = ae6b4016-7aae-d4b8-0c6f-034681e46488
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:ae6b4016-7aae-d4b8-0c6f-034681e46488
msgctxt "hbf038796g86dbg4438g8ccbg045a2e644d68"
msgid "If we've got any chance at all, it'll be with you on our side."
msgstr "만약 일말의 기회라도 있다면, 자네가 우리 편이라는 사실 정도겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = afca0e44-2378-a0a9-7591-ceb89a8f72ba
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Trainer_HasMet_GoblinHuntDone(1) = False
#.   Global:
#.      - DEN_Refugees_State_LeadersAreDead = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Trainer_HasMet_GoblinHuntDone(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:afca0e44-2378-a0a9-7591-ceb89a8f72ba
msgctxt "hae800876g510cg48e6gb47eg61995a5984be"
msgid ""
"Watching gods - while I was training children, you were out cutting down an "
"entire goblin camp."
msgstr "신들께서 보우하사 - 내가 제자들을 가르치는 동안 자네는 고블린 야영지를 쑥대밭으로 만들었구만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = b3456089-658a-8dba-9048-18dd6c23ed3b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_AttackOnDen_Event_TieflingPartyInvitation = True
#.   Quest:
#.     - DEN_Conflict_SUB_Goblin.LearnedLeaving(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:b3456089-658a-8dba-9048-18dd6c23ed3b
msgctxt "h9707aaa3gd964g41ceg81b1g197cfe0f7599"
msgid ""
"My people would be honoured to join your camp tonight, if you'll have us. "
"We're ready to go when you are."
msgstr "오늘 밤 자네 야영지에 우리를 받아준다면 영광이겠네. 자네만 괜찮다면 말이네. 언제든 말만 하게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Player
#. NodeID = b999bd70-6a3e-33cf-f686-328ac51d373e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:b999bd70-6a3e-33cf-f686-328ac51d373e
msgctxt "h077473d4g9a90g449dg8fb8g4fe021182e2b"
msgid "I'll let you know when I'm ready."
msgstr "준비되면 말하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = b9eec92e-0835-7174-7e0f-175366f3e1b2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:b9eec92e-0835-7174-7e0f-175366f3e1b2
msgctxt "h3a4afc95g5de3g4f67g9be3gb365fa8ee028"
msgid "Aye, fair enough. Just don't take too long."
msgstr "그래, 좋아. 너무 오래 걸리지만 말라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = ba2e0ddf-ac98-18e7-e8ed-e33547985e14
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:ba2e0ddf-ac98-18e7-e8ed-e33547985e14
msgctxt "h064637a6g3f99g494cgb66eged5ebf0c0a1f"
msgid ""
"Oh aye, we've been busy. Fact is, we won't win in a fair fight - so best "
"make it as unfair as we can."
msgstr "오, 그래. 그간 좀 바빴지. 공정하게 맞붙어서는 이길 수 없네. 그러니 최대한 균형을 우리 쪽으로 기울여야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = bd63174f-bd22-4386-ac7a-6ede4d9e2d44
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_DrowCommander_Event_WyllLeaves = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Trainer(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:bd63174f-bd22-4386-ac7a-6ede4d9e2d44
msgctxt "hdbd8664eg3f27g406agbf10gbe5913805fb5"
msgid ""
"Wyll told me you gave us up to the goblins - bloody glad he had it wrong."
msgstr "고블린에게 우릴 넘겼다고 윌이 말했는데, 그 말이 틀렸다니 정말 다행이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = be6b83bd-04c2-edfc-f701-06a7095f1319
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Refugees_State_LeadersAreDead = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:be6b83bd-04c2-edfc-f701-06a7095f1319
msgctxt "he9603bd9gfaf3g4fb7g86cag45688bdd394a"
msgid "You've cleared the way for us - as clear as it gets, anyway. Thank you."
msgstr "자네가 우리에게 길을 열어주었네. 이보다 더 깨끗할 수 없겠군. 고맙네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = c3bb2077-f6a9-7084-e33e-ddd99fb40c6c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_Event_PassedByEntrance = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Trainer(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:c3bb2077-f6a9-7084-e33e-ddd99fb40c6c
msgctxt "he791ded6gebaag4d93gafc0g4ac787fc8e61"
msgid ""
"Watching <i>gods</i>, but you're a prettier sight than any I expected to see "
"today."
msgstr "<i>신들께서</i> 보우하사, 자네는 오늘 내가 기대했던 볼거리들 가운데 가장 봐줄 만하군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = c42bd4ac-9ac5-248f-47da-9e72d7013d88
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:c42bd4ac-9ac5-248f-47da-9e72d7013d88
msgctxt "h7c4237d1g0614g4988g8f12g3e28399b83e0"
msgid "You've turned on us? Hells, <i>why</i>?"
msgstr "우리를 배신한 건가? 젠장, <i>어째서</i>?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = c51c8367-db7f-6839-00e6-72f2f28e6918
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:c51c8367-db7f-6839-00e6-72f2f28e6918
msgctxt "h7ce861e4gc618g4e5dgae4bg0328f6172335"
msgid ""
"But... aye, I trust you, Torm spare me. You've seen us right once before."
msgstr "그래도... 좋아, 괴롭지만 자네를 믿어 보겠네. 자네도 우리를 선하게 봐줬으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Player
#. NodeID = c6f2a598-b051-1833-f305-2014629c990f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:c6f2a598-b051-1833-f305-2014629c990f
msgctxt "h107b622dg44a8g4ee5g825ag78b4d68bbf1e"
msgid ""
"It's a trap - and she's waiting for my signal. Don't quibble with me now."
msgstr "함정입니다. 제 신호만을 기다리고 있죠. 그러니까 왈가왈부할 필요 없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = c7c0732a-9f9c-728c-1baf-2f8b157c04dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:c7c0732a-9f9c-728c-1baf-2f8b157c04dc
msgctxt "h27dac1f5gb35bg4cf9g97a3g8d7eb4866282"
msgid ""
"You don't owe us any apologies - but I'll take your help, if you're offering."
msgstr "자네는 우리에게 아무 것도 빚진 게 없지만, 자네만 괜찮다면 도움을 구하고 싶네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = c8e47012-e28f-817a-f3a6-bf09bde235cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:c8e47012-e28f-817a-f3a6-bf09bde235cb
msgctxt "h02b993ceg83d6g423egbdaeg57b2dc6c812a"
msgid "Trap a <i>drow</i>? Easier trap a spider in its own damned web!"
msgstr "<i>드로우</i>를 상대로 함정을 팠다고? 차라리 거미가 제 거미줄에 갇혔다고 말하지 그러나!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Player
#. NodeID = cf8197ac-620a-ce31-40e6-ee529feab156
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:cf8197ac-620a-ce31-40e6-ee529feab156
msgctxt "h1840a6e1g4a57g472cg9480g79be38f2186c"
msgid "That's it? Please tell me you've thought of another option."
msgstr "그게 전부인가? 제발 다른 방법들도 생각해 뒀다고 말해줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = d15b8f90-fb25-f57d-343a-a74f82ecf9f6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:d15b8f90-fb25-f57d-343a-a74f82ecf9f6
msgctxt "h3f7db565gf804g48c1ga524g0fb1d397a257"
msgid ""
"Before he passed. But the time for mourning's done. I mean to celebrate."
msgstr "그러니까 죽기 전에 말이네. 허나 애도할 시간은 끝났네. 축하할 시간이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = d258941a-668d-adf6-d9f3-8ba6e2754fbf
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_AttackOnDen_Event_HalsinSpotted = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:d258941a-668d-adf6-d9f3-8ba6e2754fbf
msgctxt "hbe2cf4ddg07e3g42fdg83e3gc7b88d4499a5"
msgid ""
"Though - you might want to speak to Halsin first. He turned up a short while "
"ago."
msgstr "물론 - 할신과 먼저 대화하고 싶겠지. 호랑이도 제 말하면 온다더니, 지금 막 나타났군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = d340fc22-8e21-efc1-4053-78d0210dd1eb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:d340fc22-8e21-efc1-4053-78d0210dd1eb
msgctxt "h044f329fgda95g46a0g8bdcgd1f6bc5beaec"
msgid ""
"She's expecting to find us broken - let's show her just what a mistake she's "
"made."
msgstr "드로우는 우리가 꺾이기만을 기다리고 있네. 그게 얼마나 오판이었는지 일깨워주자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = d55cc10e-c65c-0e37-fe24-10ae204f0e38
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:d55cc10e-c65c-0e37-fe24-10ae204f0e38
msgctxt "h2a68471eg48cfg4a81g83ecg83197fdbabcd"
msgid ""
"You said it's a drow in charge, yeah? They ain't stupid, so I hear - but "
"they <i>are</i> proud."
msgstr "자네, 드로우가 대장이라고 했었지? 내가 알기로 놈들은 멍청하지 않아. <i>다만</i> 오만할 뿐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = d5d873aa-8ca7-4950-660d-09ef797df7ce
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_TrainerVictory(1) = False
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#.      - DEN_TieflingLeader_State_PermaDefeated = False
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_TrainerVictory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:d5d873aa-8ca7-4950-660d-09ef797df7ce
msgctxt "he76e2a3egf9aeg4dd5g8acbgf260eb86e974"
msgid ""
"To think I was scared of a bloody drow. Should've known better - we had you."
msgstr "망할 드로우를 겁냈다는 사실이 부끄러워지는군. 우리에겐 자네가 있는데 말일세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Player
#. NodeID = d61bbb8b-73e8-9fd2-1ecb-ebf2f3707989
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:d61bbb8b-73e8-9fd2-1ecb-ebf2f3707989
msgctxt "h7fb3a931gadc2g4a10gbf20g5afbf0b4894d"
msgid "Their drow commander found the grove - and she means to take it."
msgstr "드로우 사령관이 숲을 찾아냈어. 이곳을 차지하려 온 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Player
#. NodeID = d6614589-6008-10c6-dc14-6e548a32a86b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:d6614589-6008-10c6-dc14-6e548a32a86b
msgctxt "h8768bf39g1c88g4ce9gb8b4g4d70cb6532e2"
msgid "It's a full war-band, led by a drow."
msgstr "드로우가 군사를 잔뜩 끌고 왔어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = db923301-850f-3992-7470-f8041ad2beed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:db923301-850f-3992-7470-f8041ad2beed
msgctxt "h43664b21g8a11g4b5dgb059g1e608db79057"
msgid ""
"Not after you've already saved us once before. We'll need your help again "
"now."
msgstr "이미 한 번 우리를 구해내지 않았나. 자네 도움이 다시 한 번 필요하네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = dcf5850b-7b3e-00a8-cf6f-40c462c844fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:dcf5850b-7b3e-00a8-cf6f-40c462c844fc
msgctxt "h80145fb9gd852g40b3g9a4ag9fb5dc04a492"
msgid "I don't... Oh, gods."
msgstr "그건 무슨... 오, 이럴 수가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Player
#. NodeID = e2c17eab-74c6-bbf7-6fc8-931ed233e466
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - FIGHTER(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:e2c17eab-74c6-bbf7-6fc8-931ed233e466
msgctxt "h1a14bbbegecfdg43cbg80eegeb5422f16eeb"
msgid "You've reinforced the place - those barricades might even hold."
msgstr "당신은 이곳을 요새로 만들었습니다. 방책은 굳건할 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Wyll
#. NodeID = e4bbd0b1-0ebd-a9c5-e60c-c9d9ac5c0d02
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - AVATAR(2) = False
#.      - REALLY_WYLL(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:e4bbd0b1-0ebd-a9c5-e60c-c9d9ac5c0d02
msgctxt "hcd6b691age71cg449fgaf8dg4afc4c030757"
msgid "Traitor. The Blade now comes for <i>you</i>."
msgstr "배신자. 이 칼날이 <i>너를</i> 벨 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = e55ae303-00b2-2062-372c-8926c07bbf25
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:e55ae303-00b2-2062-372c-8926c07bbf25
msgctxt "hd80c79a1g7ed5g4c34gb70bgfd8cc783484e"
msgid "Just give the word."
msgstr "말만 하게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = e5a73772-6f51-ba29-0c14-da39bf5caa63
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:e5a73772-6f51-ba29-0c14-da39bf5caa63
msgctxt "hccf9e209ga897g4345g8d81gaaa96141069e"
msgid "People are scared. Zevlor's doing what he can, but..."
msgstr "사람들이 겁에 질려 있어. 제블로어는 최선을 다하고 있지만…"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = ea842c49-ce1d-d400-17d1-cdad130402cc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:ea842c49-ce1d-d400-17d1-cdad130402cc
msgctxt "h04adbd71g017bg4e7bg8d34gd66c029375f6"
msgid ""
"Well. Seeing you on the walls might put the steel in their spines. Mine, too."
msgstr "그래. 성벽 위에 있는 너를 보면, 다들 사기가 진작될지도 몰라. 나도 그렇고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = ed1cc8f3-5ab9-fd52-ae38-96beff498089
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:ed1cc8f3-5ab9-fd52-ae38-96beff498089
msgctxt "h2e074701gc4b0g4151g8ebfg7da84d4cfa1f"
msgid ""
"No doubt - but thick as I might be, I reckon this drow is likely twice as "
"proud."
msgstr "두말할 나위 없지. 장담할 수는 없네만, 드로우들은 다른 종족들보다 두 배는 더 오만하다고 들었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = f0bb63d8-86fb-bc44-09d8-6f956d01533d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:f0bb63d8-86fb-bc44-09d8-6f956d01533d
msgctxt "h0df6282dgaad1g48d8ga870gb5baa1d79ae6"
msgid "You helped us throw them back once before - fancy doing it again?"
msgstr "자네는 이미 한 번 놈들을 물리친 적이 있지. 인상 한번 제대로 남기지 않겠나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = f29d08fa-431c-306d-da4b-0ffd94476ff4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - DEN_Conflict_SUB_AoD.GotBriefed(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:f29d08fa-431c-306d-da4b-0ffd94476ff4
msgctxt "h972a3c20g305bg495ega42egba3c3dc9b657"
msgid "Sound the horn - let the bastards know we're waiting for them."
msgstr "나팔을 울려라. 놈들에게 우리가 기다리고 있다고 알려라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = f3e26d90-4a89-3a2d-ccdd-3e5dae9ef2ee
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_TrainerVictory(1) = False
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#.      - DEN_TieflingLeader_State_PermaDefeated = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_TrainerVictory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:f3e26d90-4a89-3a2d-ccdd-3e5dae9ef2ee
msgctxt "h6ffb603ag1a2eg414bgbd4bg7412e48a09ff"
msgid "We won. We bloody <i>won</i>."
msgstr "우리가 이겼네. 우리가 염병할 <i>이겼다고</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Player
#. NodeID = f560bc8c-6505-fca0-0803-a5f7d3523af1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:f560bc8c-6505-fca0-0803-a5f7d3523af1
msgctxt "hf672d7e5geaa3g4221g98abga6b7834d06ec"
msgid "We'll have to lure them in first."
msgstr "먼저 놈들을 유인해야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = fa039a2e-6f8f-d339-8cc4-0378af782620
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - DEN_Conflict_SUB_AoD.GotBriefed(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:fa039a2e-6f8f-d339-8cc4-0378af782620
msgctxt "h8c36f995ge0cdg450ega139gba8752c51b65"
msgid "Sound the horn, then."
msgstr "그럼, 나팔을 울리게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = fa9c65ff-8fa4-c194-9a84-6fc3b7eaa89a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:fa9c65ff-8fa4-c194-9a84-6fc3b7eaa89a
msgctxt "he2023288gff1dg4030g9078gdda2e599d132"
msgid ""
"...A drow. Right - I'd say I'm surprised, but Beshaba's had her mark on us "
"since Elturel."
msgstr "...드로우라. 좋아, 불행의 여신 베샤바가 엘투렐부터 줄곧 따라다니고 있으니 새삼스러울 것도 없군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Player
#. NodeID = faa288f4-a25a-1ad5-a95d-f46298aebeb4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:faa288f4-a25a-1ad5-a95d-f46298aebeb4
msgctxt "h300af3e4g1f8cg4d55ga4b2g2e04418de88f"
msgid "What's the plan?"
msgstr "계획이 뭡니까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = fb70f8ec-801c-f6bc-9bca-23e2bc47222b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:fb70f8ec-801c-f6bc-9bca-23e2bc47222b
msgctxt "h0201da54g0f4cg45a7g9995g875d3ab28619"
msgid ""
"More importantly - what happened? We've spotted them massing in the woods."
msgstr "더 중요한 건, 무슨 일이 있었나? 고블린들이 숲에 모여 있는 걸 발견했는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = fbd72c10-f8c9-501d-78e5-de8e15f52e87
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:fbd72c10-f8c9-501d-78e5-de8e15f52e87
msgctxt "h855ffd0cg47acg47b2g91e6gc864c0f58c0c"
msgid ""
"Once we're ready, we'll draw 'em in to that spot. Then it's down to fire-"
"arrows and prayer."
msgstr "준비를 마치면, 놈들을 저기로 끌어들일 걸세. 그 다음에는 불화살을 퍼붓고 기도하는 수밖에."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Player
#. NodeID = fc4561d6-c050-4b1a-0096-8e9f8cfc4487
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:fc4561d6-c050-4b1a-0096-8e9f8cfc4487
msgctxt "h23be2189g2bccg4802g80ffg1d89fa580134"
msgid "I'm ready to go to camp now."
msgstr "야영지로 갈 준비가 됐어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer
#. Speaker = Asharak
#. NodeID = ffefa9ca-e97f-c928-b901-e08bf403bac8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Trainer:ffefa9ca-e97f-c928-b901-e08bf403bac8
msgctxt "hf5973f62g30f7g464cgb751g16ddd31d4192"
msgid ""
"...A drow. Right - I'd say I'm surprised, but Beshaba's had her mark on us "
"since Elturel."
msgstr "...드로우라. 좋아, 불행의 여신 베샤바가 엘투렐부터 줄곧 따라다니고 있으니 새삼스러울 것도 없군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TrainerVictory
#. Speaker = Asharak
#. NodeID = 0ab6ec14-b801-88c7-fbb3-dc9319901820
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TrainerVictory:0ab6ec14-b801-88c7-fbb3-dc9319901820
msgctxt "h456566c1gd1cfg4517gb976g999e4de55704"
msgid ""
"Gods, I'm inclined to carry you there myself - but I know you've unfinished "
"business out here."
msgstr "세상에, 자네를 직접 그곳에 데려다 주고 싶은 마음이야. 허나 자네가 이곳에서 아직 끝내지 못한 일이 있다는 점도 알고 있네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TrainerVictory
#. Speaker = Asharak
#. NodeID = 15b61153-af56-c39a-e5c2-b69c4e71dccf
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_AttackOnDen_Event_HalsinSpotted = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TrainerVictory:15b61153-af56-c39a-e5c2-b69c4e71dccf
msgctxt "h678fb92fg27f3g455eg8faagcf2ed5bb602f"
msgid "Find us once you're done. Twice the reason to celebrate now, eh?"
msgstr "다 끝나는 대로 찾아오게. 거 축하할 이유가 두 배로 늘었구먼그래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TrainerVictory
#. Speaker = Asharak
#. NodeID = 493d4d48-61f1-bbbd-5f88-ff1dfe770d03
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TrainerVictory:493d4d48-61f1-bbbd-5f88-ff1dfe770d03
msgctxt "h5a74e762g39cbg4098g9a10g05de5db306f1"
msgid ""
"So I've got another name for you. Nothing so grand as warriors, or heroes. "
"Something better."
msgstr "그래서 자네에게 붙일 이름을 따로 생각해 뒀지. 전사니 영웅이니 그런 거창한 건 아니고. 그보다 나은 이름이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TrainerVictory
#. Speaker = Asharak
#. NodeID = 578eba7c-fee1-217a-32d1-46f5b628fbf9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - DEN_Conflict.SidedTieflings_Celebrate(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TrainerVictory:578eba7c-fee1-217a-32d1-46f5b628fbf9
msgctxt "h8328b5ceg0b30g42c5gba3bg596224dbbca1"
msgid ""
"Gather your people and I'll gather mine. We can leave together, when you're "
"ready."
msgstr "자네쪽 인원을 모으게. 난 우리쪽을 모을 테니. 같이 떠나면 될 거야. 자네가 준비되는 대로."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TrainerVictory
#. Speaker = Asharak
#. NodeID = 76f6b73f-e567-295c-b1e1-8b3ecceca2f9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TrainerVictory:76f6b73f-e567-295c-b1e1-8b3ecceca2f9
msgctxt "hd8a50655g6384g442cga125g103d58ca03d4"
msgid ""
"You're bloody <i>survivors.</i> It's a long road yet to Baldur's Gate, but "
"I'm not worried."
msgstr "자네는 아주 그냥 <i>생존자</i>라네. 발더스 게이트까지 갈 길이 아직 머네만 난 전혀 걱정되지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TrainerVictory
#. Speaker = Asharak
#. NodeID = 9b79223c-12c6-1377-f994-ee6b08abb2b8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TrainerVictory:9b79223c-12c6-1377-f994-ee6b08abb2b8
msgctxt "h0367f2c0gc3e9g4833g985cgb9a896c5d554"
msgid "They call you outcasts. Hellspawn<i>. Foulblood.</i>"
msgstr "전부 널 추방자라고 해. 지옥의 자손이자, <i>더러운 혈통</i>이라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TrainerVictory
#. Speaker = Asharak
#. NodeID = a381b091-58fb-3ac5-78cc-5e940b3d6223
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TrainerVictory:a381b091-58fb-3ac5-78cc-5e940b3d6223
msgctxt "haefc644fg9477g49c6g83e5ge9ff22bf7c5f"
msgid ""
"I'll leave the worrying to whatever god or mortal is dumb enough to stand in "
"your way."
msgstr "내 걱정은 그 어떤 신이건 필멸자건 자네 갈 길을 가로막을 정도로 멍청한 자들을 위해 남겨두겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TrainerVictory
#. Speaker = Asharak
#. NodeID = be540f9f-aff2-37e5-b326-16d39c917fff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TrainerVictory:be540f9f-aff2-37e5-b326-16d39c917fff
msgctxt "hcbc37f2fg131eg4904gbebag7c1158c588ce"
msgid ""
"But it won't be for want of trying - know that you have kin in Baldur's Gate."
msgstr "하지만 그렇다고 시도조차 안 할 순 없지. 자네 동족이 발더스 게이트에 있는 것으로 아네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TrainerVictory
#. Speaker = Asharak
#. NodeID = c666fbbb-3871-3d4c-65ea-97d5a9e86473
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TrainerVictory:c666fbbb-3871-3d4c-65ea-97d5a9e86473
msgctxt "h7ef48982g159ag4bf2g8442g6fd13b6708c6"
msgid ""
"If you're inclined, we'll join you at your camp. I mean to drink you under "
"the table."
msgstr "자네만 괜찮다면 우리가 자네 야영지로 합류하지. 코가 비뚤어질 때까지 마실 작정이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TrainerVictory
#. Speaker = Asharak
#. NodeID = c800f1fb-9b61-0f9d-76b9-4d57c84ce0f9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TrainerVictory:c800f1fb-9b61-0f9d-76b9-4d57c84ce0f9
msgctxt "h5c6dd3b1gf789g4dfdgbf6fg20646fe9e0ca"
msgid ""
"But take a look out there, and tell me whose blood is staining the rocks."
msgstr "밖을 한번 보고 누구 피가 바위를 적시고 있는지 말해 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TrainerVictory
#. Speaker = Asharak
#. NodeID = cca35b22-31fb-d035-0b61-55674bece9e3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TrainerVictory:cca35b22-31fb-d035-0b61-55674bece9e3
msgctxt "h6b61934eg2d2fg44dbg93d5gd80beea5489c"
msgid ""
"Gods above, is that... <i>Halsin?</i> After everything, he appears just "
"before the party. Wish I had his timing."
msgstr ""
"천상의 신이시여, 저거 혹시... <i>할신</i>인가? 이 난리가 났는데 저 작자는 마침 파티 직전에 나타나는군. 나도 저런 절묘한 "
"감각이 있었으면 좋겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TrainerVictory
#. Speaker = Asharak
#. NodeID = d77700b0-8340-9c36-1931-835ea94dfbcb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TrainerVictory:d77700b0-8340-9c36-1931-835ea94dfbcb
msgctxt "h303a38efg8c05g43d4ga149geaf1571a5770"
msgid ""
"You. I don't have the words or the means to thank you for what you did here."
msgstr "이보게. 내 어떤 말로도 재간으로도 자네가 이곳에서 해준 일에 감사할 길이 없네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TrainerVictory
#. Speaker = Asharak
#. NodeID = d892d60f-9b5f-f03c-5b6b-3628a6ad6128
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KaghaIsDead = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TrainerVictory:d892d60f-9b5f-f03c-5b6b-3628a6ad6128
msgctxt "h4f2c79f9gc75eg4a84gb2c3gec9e22d69659"
msgid ""
"Wouldn't like to be in Kagha's shoes about now - but he'll have kinder words "
"for you, I wager."
msgstr "지금 이 시기에 카그하의 자리를 메우라면 그리 달갑지 않겠지. 그래도 할신이 자네한테는 말을 곱게 할 거야, 내 장담함세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TrainerVictory
#. Speaker = Asharak
#. NodeID = d9663bf4-934f-cff9-811a-b43f3aed8db8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TrainerVictory:d9663bf4-934f-cff9-811a-b43f3aed8db8
msgctxt "he7fdd86dg1138g4575gb09cg5c393402c465"
msgid "Because you know who you are, now - what you can do."
msgstr "자네는 본인이 어떤 사람인지 알고, 무엇을 할 수 있는지도 아니까 말일세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TrainerVictory
#. Speaker = Asharak
#. NodeID = dd90d8c7-76eb-e020-1d5c-5939db636546
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_AttackOnDen_Event_HalsinSpotted = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_TrainerVictory:dd90d8c7-76eb-e020-1d5c-5939db636546
msgctxt "h7e4f2759g5518g40abga3dega95b616e02ec"
msgid "Go on, you'd best go down and... explain. Better you than me."
msgstr "가 봐, 내려가서... 설명하는 게 좋지 않겠나. 나보단 자네가 낫겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_VoloBear
#. Speaker = Bosk
#. NodeID = 39cebcb4-698d-77f9-1879-5dd8b993d592
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_VoloBear_HasMet(1) = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_VoloBear:39cebcb4-698d-77f9-1879-5dd8b993d592
msgctxt "h8319ffaeg499bg4531gbbb9g73294e1f9fce"
msgid "You smell like blood. Like fighting. Be gone."
msgstr "너 피 냄새 나. 싸움 냄새. 썩 사라져버려."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_VoloBear
#. Speaker = Bosk
#. NodeID = c99ed12c-c733-4b0a-5444-e30e6a304d1c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_VoloBear_HasMet(1) = False
#.   Tag:
#.      - PETPAL(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_VoloBear_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_VoloBear:c99ed12c-c733-4b0a-5444-e30e6a304d1c
msgctxt "h0e18b483g8bd4g4748gb9d5g804aef645bd0"
msgid ""
"It smells like blood. Like thick, tainted blood. We should leave. We should "
"all leave."
msgstr "피 냄새 같은데. 끈적한, 오염된 피. 우린 달아나야 돼. 우리 모두 달아나야 돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_VoloBear
#. Speaker = Bosk
#. NodeID = ee057a65-e7bc-ff01-fcb2-943365a45ab1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_VoloBear:ee057a65-e7bc-ff01-fcb2-943365a45ab1
msgctxt "h34175c35gcf05g4020g8fe2g2af00bebffa4"
msgid "*Huff.*"
msgstr "*흥.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_WarchiefBrave
#. Speaker = Rozzak
#. NodeID = b3d1474d-576e-843d-e137-47fbc83e930c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_AttackOnDen_State_Victorious(0) = True
#. TagRule: TIEFLING
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_WarchiefBrave:b3d1474d-576e-843d-e137-47fbc83e930c
msgctxt "hbbd4b3a3g2b29g46ddg98d3gd04cc3258202"
msgid ""
"One of 'em was prayin' when I slit its throat. Who do you devils even pray "
"to?"
msgstr "내가 숨통을 그어놓는 와중에도 한 놈이 기도하더라고. 너희 데빌놈들은 대체 누구한테 기도를 하냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_WarchiefBrave
#. Speaker = Rozzak
#. NodeID = b3d1474d-576e-843d-e137-47fbc83e930c
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_AttackOnDen_State_Victorious(0) = True
#. TagRule: !TIEFLING
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_WarchiefBrave:b3d1474d-576e-843d-e137-47fbc83e930c
msgctxt "h639db990gfad4g4d9fg9608gd16ac0d08152"
msgid ""
"One of 'em was prayin' when I slit its throat. Who do devils even pray to?"
msgstr "내가 숨통을 그어놓는 와중에도 한 놈이 기도하더라고. 너희 데빌놈들은 대체 누구한테 기도를 하냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_WarchiefBrave
#. Speaker = Rozzak
#. NodeID = be9c0095-07c0-2502-0f74-f27912621ef3
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: !TIEFLING
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_WarchiefBrave:be9c0095-07c0-2502-0f74-f27912621ef3
msgctxt "h80472416gc4eag4d87g8d2dg8a1857b84020"
msgid "Kill anythin' with horns an' a tail!"
msgstr "뿔이랑 꼬리 달린 것들은 다 죽여라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_WarchiefBrave
#. Speaker = Rozzak
#. NodeID = be9c0095-07c0-2502-0f74-f27912621ef3
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: TIEFLING
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_WarchiefBrave:be9c0095-07c0-2502-0f74-f27912621ef3
msgctxt "haa054551g8d65g4517gbcfbg7a84e26c1831"
msgid "Enjoy killin' yer own kind, do ya?"
msgstr "동족 살해를 즐기시는구만 그래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_WarchiefGrumpy
#. Speaker = Zurga
#. NodeID = 4d8da437-aa3a-d20b-18cd-49e0331063c7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TIEFLING(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_WarchiefGrumpy:4d8da437-aa3a-d20b-18cd-49e0331063c7
msgctxt "ha6c0f86dg8626g4e6bga68bgcaa97efb99b4"
msgid "Oi. Have you lot really got black, boilin' blood? Freaks."
msgstr "인마. 너희 떼거지 진짜로 까매졌냐? 피가 펄펄 끓어서? 괴물 새끼들."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_WarchiefGrumpy
#. Speaker = Zurga
#. NodeID = 761a8ae1-5587-704c-1f3d-82cbdfc76a85
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_WarchiefGrumpy:761a8ae1-5587-704c-1f3d-82cbdfc76a85
msgctxt "h60095613g5d50g4140g87c7gfa4a496e8a48"
msgid ""
"Ya ever kill a tieflin'? I heard they got black, boilin' blood when ya slice "
"'em up."
msgstr "티플링 죽여 봤냐? 듣기로 그 놈들은 까매진다던데, 쑤셔버리면 피가 펄펄 끓는 바람에."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_WarchiefGrumpy
#. Speaker = Zurga
#. NodeID = 822ee5e7-e7a7-5344-1fb9-d40cae69aee2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_AttackOnDen_State_Victorious(0) = True
#.   Tag:
#.      - TIEFLING(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_WarchiefGrumpy:822ee5e7-e7a7-5344-1fb9-d40cae69aee2
msgctxt "h43148be3g59eag461fgad9fgfca779035283"
msgid ""
"Last one I gutted looked just like you - ain't got any long lost sisters "
"have you?"
msgstr "최근에 배 갈랐던 놈이 딱 너처럼 생겼는데. 너 뭐 오래 전에 헤어진 누나나 동생 그딴 거 없냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_WarchiefGrumpy
#. Speaker = Zurga
#. NodeID = e9d7dc4a-3035-4316-9c04-53ab431ea4a0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_AttackOnDen_State_Victorious(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_WarchiefGrumpy:e9d7dc4a-3035-4316-9c04-53ab431ea4a0
msgctxt "h1eea367egf90dg469bg9d53g80aff26cfdb2"
msgid "Ever wondered what devil flesh tastes like? My bet's on stench kow."
msgstr "데빌 고기가 무슨 맛일지 궁금해본 적 없냐? 난 스텐치 카우 같다에 건다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Weaponsmith
#. Speaker = Player
#. NodeID = 13eabbc9-098c-084e-16f6-30bad2039928
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Weaponsmith:13eabbc9-098c-084e-16f6-30bad2039928
msgctxt "hfd6570ccgcca6g4f00gaef6g60e7d439676d"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Weaponsmith
#. Speaker = Dammon
#. NodeID = 16ba17cf-3b36-6de1-d00f-8fe671c5ad8f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_Weaponsmith(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Weaponsmith:16ba17cf-3b36-6de1-d00f-8fe671c5ad8f
msgctxt "h4976389agd68eg41c2gb109g4f6ec9e94518"
msgid "I hope you're here to fight. You look a sight tougher than the others."
msgstr "여기 싸우러 왔길 바라요. 당신은 다른 사람들보다 척 봐도 세 보이는군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Weaponsmith
#. Speaker = Dammon
#. NodeID = 31ebef3f-4534-3d46-205c-166be1985457
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Weaponsmith:31ebef3f-4534-3d46-205c-166be1985457
msgctxt "h59a44a1egcd07g4c89gb56eg421291eb642a"
msgid "I wish I had better but this is all I have."
msgstr "더 있었다면 좋았겠지만, 지금은 이게 전부에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Weaponsmith
#. Speaker = Dammon
#. NodeID = 37c37971-76fd-a643-a10c-58409887d813
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Weaponsmith:37c37971-76fd-a643-a10c-58409887d813
msgctxt "h2806f387g0a24g4cd0gabc5gfa6ae0b9c823"
msgid "May Tymora's luck twist your way."
msgstr "티모라의 행운이 당신의 길을 비틀길."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Weaponsmith
#. Speaker = Dammon
#. NodeID = 7d9279b2-3f27-8560-0bf8-478d3cef2f4b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_HasMet_WeaponsmithVictory(1) = True
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Weaponsmith:7d9279b2-3f27-8560-0bf8-478d3cef2f4b
msgctxt "hefe33339g4a88g4e4fga461g65dcf18eaba1"
msgid ""
"Who do I pray to for a real forge? Moradin? He... probably wouldn't listen "
"to me."
msgstr "진짜 대장간을 바란다면 누구에게 기도해야 할까요? 모라딘? 그는... 아마 제 말을 듣진 않으시겠죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Weaponsmith
#. Speaker = Dammon
#. NodeID = 9ba46ecd-25e7-01b3-2a53-4e31f5e95f37
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Weaponsmith:9ba46ecd-25e7-01b3-2a53-4e31f5e95f37
msgctxt "h10d09987g3466g47bfga23cgf07662902c39"
msgid "Need a weapon? I still have a few left."
msgstr "무기가 필요하신가요? 아직 좀 남은 게 있어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Weaponsmith
#. Speaker = Dammon
#. NodeID = a9149b66-1fe4-5fdd-4684-8c28bb2b02ec
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Weaponsmith(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Weaponsmith:a9149b66-1fe4-5fdd-4684-8c28bb2b02ec
msgctxt "h5010175dgb48dg4ff3gb20eg8a749d5c78b8"
msgid "You're back. Nice to see a familiar face."
msgstr "돌아오셨군요. 익숙한 얼굴을 보니 좋네요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Weaponsmith
#. Speaker = Dammon
#. NodeID = c1ca9b3c-8c55-27b6-846c-11251f814d02
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_WeaponsmithVictory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Weaponsmith:c1ca9b3c-8c55-27b6-846c-11251f814d02
msgctxt "ha0d50b17g65bfg4fe3ga9b1g032fb3573cca"
msgid "You saved us. I wasn't sure we'd make it through."
msgstr "당신이 우릴 구했어요. 우리가 살아남을 거라곤 확신하지 못했었는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Weaponsmith
#. Speaker = Player
#. NodeID = f891198d-4077-cb48-03ec-f7c275c266f6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Weaponsmith:f891198d-4077-cb48-03ec-f7c275c266f6
msgctxt "h442f4865g344eg476fgaa11gc817f27a1555"
msgid "Let me see your wares."
msgstr "뭘 파는지 보여줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Wyll
#. Speaker = Wyll
#. NodeID = 06ef6d7e-2cfd-a9f4-2e16-96d3a4b63c3e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Wyll(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Wyll:06ef6d7e-2cfd-a9f4-2e16-96d3a4b63c3e
msgctxt "h52aa77ddg427bg4394ga591g38063f8ef5cb"
msgid "Blow the horn - the trap has been set. Today, we write our own legends!"
msgstr "함정이 준비됐으니 뿔나팔을 불어라. 오늘, 우리 손으로 전설을 쓴다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Wyll
#. Speaker = Narrator
#. NodeID = 42874e74-5dae-fd3f-0f91-cecda75c062f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Wyll:42874e74-5dae-fd3f-0f91-cecda75c062f
msgctxt "hd199d30dg4438g41c5g9af4g77c90eb71f3d"
msgid ""
"*You know this man's face - but you can't quite place it. He knows you too, "
"judging from his quizzical expression.*"
msgstr ""
"*당신은 이 사내의 얼굴을 알고 있지만 정확히 누구인지는 모르겠습니다. 당혹스러워 보이는 표정으로 미루어 볼 때 그도 당신을 알고 있는 "
"것 같습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Wyll
#. Speaker = Wyll
#. NodeID = a113fad1-10a0-c364-d1d7-58fb43de76dc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Wyll(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Wyll:a113fad1-10a0-c364-d1d7-58fb43de76dc
msgctxt "h9f2a5e77gcc77g4c2eg90bfga212f9126f92"
msgid "Blow the horn - the trap has been set."
msgstr "함정이 모두 준비되었으니 뿔피리를 불어라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Wyll
#. Speaker = Wyll
#. NodeID = aa22f413-71f8-356e-11d7-fbefc480f0b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Wyll:aa22f413-71f8-356e-11d7-fbefc480f0b3
msgctxt "h3f42eadagd5d3g4ba3g850dgb14534af1216"
msgid "Blow the horn - the trap has been set. Today, we write our own legends!"
msgstr "함정이 준비됐으니 뿔나팔을 불어라. 오늘, 우리 손으로 전설을 쓴다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Wyll
#. Speaker = Wyll
#. NodeID = ea344eec-aff6-213d-8f29-9d1461318322
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Wyll_HasMet(1) = True
#.      - DEN_AttackOnDen_HasMet_Wyll(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_HasMet_Wyll(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Wyll:ea344eec-aff6-213d-8f29-9d1461318322
msgctxt "ha2c9caabg725eg40a6g9261g05ce47fe924c"
msgid "Ah - a familiar face. Didn't think I'd see you again!"
msgstr "오호라. 익숙한 얼굴이군. 다시 볼 줄은 몰랐어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Wyll
#. Speaker = Wyll
#. NodeID = fcb6ebdf-fa16-35be-39d4-0dec366a2e0f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_Wyll:fcb6ebdf-fa16-35be-39d4-0dec366a2e0f
msgctxt "h0b8cc840gb635g44cbgbf7bgb1d0514eb564"
msgid "I've never been more thrilled to be wrong."
msgstr "내 생각이 틀렸는데 이렇게 흥겨운 건 처음이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ZenBear
#. Speaker = Ormn
#. NodeID = 557a007c-97e2-6baf-f3a4-8725394fbf2b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_ZenBear_HasMet(1) = False
#.   Global:
#.      - GLO_Halsin_State_PermaDefeated = False
#.   Tag:
#.      - PETPAL(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_ZenBear_HasMet(1) = True
#.   Quest:
#.     - HIDDEN_WLD_Boosters.DEN_ZenBear_Helped(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ZenBear:557a007c-97e2-6baf-f3a4-8725394fbf2b
msgctxt "h3fb4cdb6g3280g4b9bg94dbge058d75985ad"
msgid "He's back! You brought Halsin back!"
msgstr "돌아왔다! 네가 할신을 다시 데려왔구나!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ZenBear
#. Speaker = Ormn
#. NodeID = abf687d0-97a1-7ec6-eb57-719e95455060
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_ZenBear_HasMet(1) = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ZenBear:abf687d0-97a1-7ec6-eb57-719e95455060
msgctxt "h35dc9ddcg0b80g411cgb4ccgf2371ad29268"
msgid "Please - let me mourn."
msgstr "부탁이야. 슬퍼하게 놔 둬."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ZenBear
#. Speaker = Ormn
#. NodeID = bbeb3c78-dbbd-8f9c-398f-6c7601b9b68e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ZenBear:bbeb3c78-dbbd-8f9c-398f-6c7601b9b68e
msgctxt "hc705f231g970eg4e86gad49g31560cefafb3"
msgid "*Hrrm.*"
msgstr "*우물우물.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ZenBear
#. Speaker = Ormn
#. NodeID = cc36ba46-ed9c-d671-5941-c193c3e8a3fb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AttackOnDen_ZenBear_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ZenBear:cc36ba46-ed9c-d671-5941-c193c3e8a3fb
msgctxt "h9772841dgc365g46a4g9e3bg4f3bed07f01d"
msgid "He's gone... His scent is gone."
msgstr "할신이 사라졌어... 냄새가 사라졌어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ZenBear
#. Speaker = Ormn
#. NodeID = fc45a891-0cf4-56af-17b2-c9da4db62f5e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AttackOnDen_ZenBear_HasMet(1) = True
#.   Global:
#.      - GLO_Halsin_State_PermaDefeated = False
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_ZenBear:fc45a891-0cf4-56af-17b2-c9da4db62f5e
msgctxt "h9eb97041g76a1g428fgb587g433541efbae8"
msgid ""
"Thank you for finding my master. May your hibernations be long and calm."
msgstr "우리 주인님을 찾아줘서 고마워. 네 동면이 길고 고요하기를."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CGB_Apprentice
#. Speaker = Nettie
#. NodeID = 1c82c10b-e313-afbd-003d-7526cff5eb43
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_Event_RevealedTadpole(1) = True
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Event_NettieTurnsHostile = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CGB_Apprentice:1c82c10b-e313-afbd-003d-7526cff5eb43
msgctxt "h34ddf156g8e71g41bbg89dfg9871464c0353"
msgid ""
"I tried to make this easy on you and give you some time. But if you won't "
"stop, I'll have to stop you."
msgstr "좀 편하게 해드리려고 충분한 시간을 드렸어요. 하지만 스스로 하실 수 없겠다면, 제가 할 수밖에 없겠군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CGB_Apprentice
#. Speaker = Nettie
#. NodeID = 4bb5f121-b2ed-23fe-2ce2-55cfce9ac68b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_Event_RevealedTadpole(1) = False
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Event_NettieTurnsHostile = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CGB_Apprentice:4bb5f121-b2ed-23fe-2ce2-55cfce9ac68b
msgctxt "h6e3cbe82gde10g460dga4aagb22bd90694f0"
msgid "Fine. If you won't stop trying to help her, I'll have to stop you both."
msgstr "좋아. 그녀를 돕는 것을 멈추지 않는다면 내가 너희를 막아야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CGB_Apprentice
#. Speaker = Player
#. NodeID = 5db2a053-7d89-c54c-70a6-2ba626bc622d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CGB_Apprentice:5db2a053-7d89-c54c-70a6-2ba626bc622d
msgctxt "h82861365g6352g4ab5g81c0gc9aca2bc3ed2"
msgid "Then help me. Give me a chance to beat this."
msgstr "그러면 도와줘. 이걸 이겨내볼 기회를 달라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CGB_Apprentice
#. Speaker = Player
#. NodeID = 65eda23f-b851-3402-2337-e55e8d2aaaff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CGB_Apprentice:65eda23f-b851-3402-2337-e55e8d2aaaff
msgctxt "hfe33a37eg625dg427dg8d6eg94638e1f9618"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CGB_Apprentice
#. Speaker = Nettie
#. NodeID = 6c0559ac-c3ea-aea2-4717-ed425e5d181b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CGB_Apprentice:6c0559ac-c3ea-aea2-4717-ed425e5d181b
msgctxt "h8db285ceg2464g4e7bg93e3g6f6bbbea09d0"
msgid "I can't. I can't let you endanger this camp."
msgstr "아니. 네가 이 야영지를 위험에 빠뜨리는 걸 두고만 볼 수 는 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CGB_Apprentice
#. Speaker = Nettie
#. NodeID = 7110e109-849c-d98c-b667-21c90077aee4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_Event_RevealedTadpole(1) = True
#.      - DEN_Apprentice_Event_MessedAroundTooMuch(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CGB_Apprentice:7110e109-849c-d98c-b667-21c90077aee4
msgctxt "h93f08187g96ddg46efg95c1gfe64c75778fe"
msgid "Stop it! You're not going to find the antidote."
msgstr "그만 둬! 넌 해독제를 찾지 못 할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CGB_Apprentice
#. Speaker = Nettie
#. NodeID = 8abdf818-8bbc-873b-7b58-59431c4d298d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_Event_RevealedTadpole(1) = False
#.      - DEN_Apprentice_Event_MessedAroundTooMuch(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CGB_Apprentice:8abdf818-8bbc-873b-7b58-59431c4d298d
msgctxt "h1c3356eag6941g4fc1gaba0gfccb6339d4d9"
msgid ""
"Stop it! I know you want to help her, but I can't let you find the antidote."
msgstr "그만해! 그녀를 돕고 싶어하는 마음은 알지만, 네가 해독제를 찾게 둘 수는 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CGB_Apprentice
#. Speaker = Player
#. NodeID = 9bae6df2-583c-f278-d854-90abe5044734
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Event_NettieTurnsHostile = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CGB_Apprentice:9bae6df2-583c-f278-d854-90abe5044734
msgctxt "hc4703253g8f22g4ea8g8fbdgce2cb7793502"
msgid "<i>Attack her.</i>"
msgstr "<i>그녀를 공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CGB_Apprentice
#. Speaker = Nettie
#. NodeID = a22030fc-7258-6e03-1566-4194e87eb7e7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_Event_RevealedTadpole(1) = False
#.      - DEN_Apprentice_State_HasGenderNeutralTadpoled(0) = True
#.      - DEN_Apprentice_Event_MessedAroundTooMuch(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CGB_Apprentice:a22030fc-7258-6e03-1566-4194e87eb7e7
msgctxt "h0adeca51g02a8g4f11gb44bg073aca5e921a"
msgid ""
"Stop it! I know you want to help them, but I can't let you find the antidote."
msgstr "그만해! 그들을 돕고 싶어하는 마음은 알지만, 네가 해독제를 찾게 둘 수는 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CGB_Apprentice
#. Speaker = Nettie
#. NodeID = a9ed6d13-67e3-4b97-ab4e-5b6fa438fef3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_Event_RevealedTadpole(1) = False
#.      - DEN_Apprentice_State_HasGenderNeutralTadpoled(0) = True
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Event_NettieTurnsHostile = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CGB_Apprentice:a9ed6d13-67e3-4b97-ab4e-5b6fa438fef3
msgctxt "h10ae4d83gbff8g44f4g82aeg5b9db6d6b23c"
msgid ""
"Fine. If you won't stop trying to help them, I'll have to stop you both."
msgstr "좋아. 그들을 돕는 걸 멈추지 않는다면, 내가 너희를 막아야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CGB_Apprentice
#. Speaker = Nettie
#. NodeID = afde9778-1d81-b519-f02d-080cc641ceea
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_HasMaleTadpoled(0) = True
#.      - DEN_Apprentice_Event_RevealedTadpole(1) = False
#.      - DEN_Apprentice_Event_MessedAroundTooMuch(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CGB_Apprentice:afde9778-1d81-b519-f02d-080cc641ceea
msgctxt "h10f26fd0g1bbag43c5gac7fg95cbd425753b"
msgid ""
"Stop it! I know you want to help him, but I can't let you find the antidote."
msgstr "그만해! 그를 돕고 싶어하는 마음은 알지만, 네가 해독제를 찾게 둘 수는 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CGB_Apprentice
#. Speaker = Nettie
#. NodeID = b8939633-5881-cdb3-a1f9-eca4447f0a51
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CGB_Apprentice:b8939633-5881-cdb3-a1f9-eca4447f0a51
msgctxt "h20cb4e8dgdd40g49b7g9913g0406af92222b"
msgid "Please, just sit down. Make your prayers. Let things take their course."
msgstr "제발, 그냥 앉아. 네 신께 기도를 올려. 모든 걸 순리에 맡기란 말야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CGB_Apprentice
#. Speaker = Nettie
#. NodeID = ede04f18-f06e-6080-b882-ea6b8ceecc7a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Apprentice_State_HasMaleTadpoled(0) = True
#.      - DEN_Apprentice_Event_RevealedTadpole(1) = False
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Event_NettieTurnsHostile = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CGB_Apprentice:ede04f18-f06e-6080-b882-ea6b8ceecc7a
msgctxt "hb16fae19g1dd5g4a2dgafe5gd40d11979963"
msgid "Fine. If you won't stop trying to help him, I'll have to stop you both."
msgstr "좋아. 그를 돕는 걸 멈추지 않는다면, 내가 너희를 막아야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 01a752a7-e5dd-ce0f-d8f8-4c510385b9d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:01a752a7-e5dd-ce0f-d8f8-4c510385b9d8
msgctxt "h2582ddebg2e18g4e26g90cbg2aa9cec60762"
msgid "What are ya... what are ya doin'?"
msgstr "뭐... 뭐 하는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = 01bbf365-5a7a-cf08-e3b0-08c1aa7bc5b7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:01bbf365-5a7a-cf08-e3b0-08c1aa7bc5b7
msgctxt "h5ff92aaag6eb9g4b1cga1eag6ef40762c9fc"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = 02091c02-f832-51c3-8712-1101b4faf1cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:02091c02-f832-51c3-8712-1101b4faf1cf
msgctxt "hcc97e082g13d7g48e0g803cg0145c6e4e296"
msgid "A tribe like yours must have plenty of treasure. Where's it hiding?"
msgstr "네 부족은 보물을 많이 가지고 있겠지. 어디다 숨겼지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 02fa1436-bb67-57b8-e22f-3bfbbc824f4a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:02fa1436-bb67-57b8-e22f-3bfbbc824f4a
msgctxt "hc8b63b2cgd5ffg4b92g8edeg4b35802128e9"
msgid "Will do."
msgstr "그렇게 하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 04e3b2b2-fbac-af16-65ad-214a3be4a0a9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - DEN_CapturedGoblin.MetGoblin(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:04e3b2b2-fbac-af16-65ad-214a3be4a0a9
msgctxt "h53a42ba6ga0deg43c8gba8dgd1b99881c517"
msgid "Then hurry up an' do it. My tribe ain't as friendly as I am."
msgstr "그럼 서둘러. 내 부족은 나만큼 친절하지 않을 테니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 0556cfcc-4699-d20c-25eb-add50d8a055b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:0556cfcc-4699-d20c-25eb-add50d8a055b
msgctxt "hfed0efebg6863g43acgaff6gacf92416bbc2"
msgid "Never break a promise unless there's somefin' in it for me."
msgstr "나한테 뭐 떨어지는 게 없으면, 약속은 절대 어기지 않는다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 09a28c76-0895-ad65-654d-53eac5f3283b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:09a28c76-0895-ad65-654d-53eac5f3283b
msgctxt "hb6b69213g0e4ag4cd9g9a1bg5202221333f1"
msgid "No, I'll talk, I'll talk!"
msgstr "제발, 말할게, 말한다니까!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 0c28975e-adde-1e34-2552-83fac9bdd799
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:0c28975e-adde-1e34-2552-83fac9bdd799
msgctxt "he4cca997g2ad5g464eg895fgd72221d70b6c"
msgid "I guess yer right - I'm worgmeat either way."
msgstr "그런 것 같네 - 어느 쪽이든 난 워그밥이 될 테니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 0c6e2958-ea72-aa2c-7214-d146dd58e9d7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_CapturedGoblin_State_AtDrow = True
#.      - GOB_CapturedGoblin_State_Spared = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:0c6e2958-ea72-aa2c-7214-d146dd58e9d7
msgctxt "he4d024a7g2097g46cdgb5e9g517b214ef3c4"
msgid "Those teeth. Those 'orrible teeth."
msgstr "그 이빨들. 그 무시무시한 이빨들."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 0e6b9eb2-13a2-80a7-4450-143730f6887d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_CapturedGoblin_HasMet(1) = False
#.   Global:
#.      - DEN_CapturedGoblin_State_GrieflingPermaDefeated = True
#.      - DEN_CapturedGoblin_Event_GuardCombat = True
#. SetFlags:
#.   Dialog:
#.     - DEN_CapturedGoblin_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:0e6b9eb2-13a2-80a7-4450-143730f6887d
msgctxt "h086e888fgeaffg4f33g9c06gf6468b7907cc"
msgid "Ain't sure why ya killed yer own to protect me. Don't care, neither."
msgstr "왜 네 동족을 죽여가면서 까지 날 보호했는진 모르겠지만, 난 신경 안써."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 1300c28d-0fc7-abe6-2b1f-eacc5af473f3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_CapturedGoblin_QuestReward = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:1300c28d-0fc7-abe6-2b1f-eacc5af473f3
msgctxt "h1d42921egc830g4459gbe08gd27d7b339e2d"
msgid "I won't bother ya any more. I swear."
msgstr "더 이상 귀찮게 굴지 않을게. 맹세해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 169c64a4-152d-7a6c-c2bf-c9dad947467e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_CapturedGoblin_HasMet(1) = False
#.   Global:
#.      - DEN_CapturedGoblin_Event_GuardCombat = True
#. SetFlags:
#.   Dialog:
#.     - DEN_CapturedGoblin_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:169c64a4-152d-7a6c-c2bf-c9dad947467e
msgctxt "hfb0c92f9gf7f4g46fcgbc60gbecc6bf3d6df"
msgid "No point turnin' on yer own if yer just gonna give 'em a little tap."
msgstr "그냥 한대 쥐어박고 말거면 굳이 네 동족의 뒤통수를 칠 필요는 없었잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = 16d25fbf-0770-6baf-8c11-56182d8cb0b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:16d25fbf-0770-6baf-8c11-56182d8cb0b1
msgctxt "h364d6d6ag4e71g4fc4g8134ga06ddc30473a"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 17b6ab68-af79-8f2a-6297-adc699a310c5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:17b6ab68-af79-8f2a-6297-adc699a310c5
msgctxt "hde3cc517g8d6bg4359g80ffg3671efc5b2ba"
msgid ""
"<i>O' course, I'll prob'ly be a rat's breakfast myself if I </i>don't "
"<i>tell this one something.</i>"
msgstr "<i>물론, 이 녀석한테 뭐라도 말하지 않는다면 </i>난 쥐새끼들의 <i>아침식사가 되고 말겠지.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 21d82040-b3c3-f642-0b07-dc919bfb623c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:21d82040-b3c3-f642-0b07-dc919bfb623c
msgctxt "h2000bdf5g0f0bg48ccgb0b8g429c12a45fb3"
msgid "I ain't sayin' nuffin' else. They'll kill me an' kill me slow."
msgstr "이제 아무말도 안할 거야. 걔들이 나를 천천히 죽일 거라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = 21d8ddfd-3cfb-43c6-531a-4763ca7326f2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_CapturedGoblin_Knows_Priestess = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:21d8ddfd-3cfb-43c6-531a-4763ca7326f2
msgctxt "hc385290eg8df8g472egbdd1ga9fe17a0d4ad"
msgid "Gratitude doesn't help me. Tell me about that priestess."
msgstr "감사 인사는 필요 없어. 그 여사제에 대해 말해 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = 2242f7f7-0de3-6670-c8a3-e5e99f482940
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_CapturedGoblin_Follow(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:2242f7f7-0de3-6670-c8a3-e5e99f482940
msgctxt "h2821ef82g2deag4a3dga079gbfc359208a72"
msgid "In a moment. Stay here and keep out of the way."
msgstr "잠시만. 방해되지 않게 여기 남아줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = 2253db06-65c8-8d92-c5ed-a772d0737bdc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_CapturedGoblin_State_GoblinMentionedAbsolute = False
#. TagRule: CLERIC
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:2253db06-65c8-8d92-c5ed-a772d0737bdc
msgctxt "h0cceae74g17d8g43bagbe92g63fd057d6c05"
msgid "I know plenty of deities, but the Absolute's a new god to me."
msgstr "나는 수 많은 신들의 이름을 알고 있지만, 절대자라는 이름은 처음 들어보는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = 2253db06-65c8-8d92-c5ed-a772d0737bdc
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_CapturedGoblin_State_GoblinMentionedAbsolute = False
#. TagRule: WIZARD
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:2253db06-65c8-8d92-c5ed-a772d0737bdc
msgctxt "hdf7ddb5dgfb2bg4424ga33dgca21e311a700"
msgid "The Absolute? I've read nothing of this god in my studies."
msgstr "절대자라고? 그런 이름은 들어본 적이 없는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = 2253db06-65c8-8d92-c5ed-a772d0737bdc
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_CapturedGoblin_State_GoblinMentionedAbsolute = False
#. TagRule: PLANAR
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:2253db06-65c8-8d92-c5ed-a772d0737bdc
msgctxt "h9ef61645g7281g4d7ega10ag891a75da39ec"
msgid ""
"Another god? I swear Toril has more deities than there are stars in the sky."
msgstr "또 다른 신인가? 세상에, 토릴에는 신이 밤하늘의 별보다도 많나 보군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = 2253db06-65c8-8d92-c5ed-a772d0737bdc
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_CapturedGoblin_State_GoblinMentionedAbsolute = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:2253db06-65c8-8d92-c5ed-a772d0737bdc
msgctxt "h0fb84885gd953g40d9g9372g3a2634461a29"
msgid "I've never heard of this god of yours."
msgstr "네가 섬기는 신은 처음 듣는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 2a9ec91b-4faf-6629-28d9-db94b8683a7b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:2a9ec91b-4faf-6629-28d9-db94b8683a7b
msgctxt "hce610343g7cb6g4115ga694g380915e42756"
msgid ""
"Get me outta here, and I'll take you to meet her and the rest of my tribe."
msgstr "날 여기서 내보내 주면, 그녀와 내 부족원들을 만나게 해 주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = 2c014cef-c941-90a1-5b40-c98e8feedbe2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GNOME(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:2c014cef-c941-90a1-5b40-c98e8feedbe2
msgctxt "h6ce2af44ga610g42cbgbd7bg63781b3d4b14"
msgid "With the way things are going, I could use a blessing."
msgstr "요즘 일어나는 일들을 봐서는, 축복을 받을면 좋겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 2c5ed976-2c75-e7b0-b54d-d14bb1ebeb92
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:2c5ed976-2c75-e7b0-b54d-d14bb1ebeb92
msgctxt "h3a024f84gb978g450egb0bdg7862b7f3cc0d"
msgid "'Course I do. We all do."
msgstr "물론이지. 우리 모두 그런다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = 2d3a6de2-e4f5-5dc8-09d1-1f13c8d05725
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:2d3a6de2-e4f5-5dc8-09d1-1f13c8d05725
msgctxt "h11e4b8a4g3d49g44e2g9ef4g63cf1367c263"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = 2e65b401-636e-5f1c-06bd-da2c9b366e2c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:2e65b401-636e-5f1c-06bd-da2c9b366e2c
msgctxt "h51ff2592g29e1g4367ga1bcg592bb583c604"
msgid "Sorry, follow me."
msgstr "미안해, 따라와."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 2fa9ffe2-b7de-6395-fe47-64f040397c64
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_CapturedGoblin_State_GoblinMentionedAbsolute = True
#. SetFlags:
#.   Global:
#.     - GLO_Absolute_Knows_Name = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:2fa9ffe2-b7de-6395-fe47-64f040397c64
msgctxt "hbdfc7a3ega86bg40d3g8bacg379dd9262c80"
msgid ""
"They're gonna burn this pretty place for the glory of the Absolute and 'ang "
"ya by yer guts."
msgstr "놈들이 절대자님의 영광을 위해 여길 불태워 버리고 네 내장을 꺼내버릴 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = 30788c83-098a-9906-81ab-01545269f18e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_CapturedGoblin_PromisedHelp(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_CapturedGoblin_PromisedHelp(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:30788c83-098a-9906-81ab-01545269f18e
msgctxt "h5c07a5a4g2d67g42a4g8bedgfb8c3968ae35"
msgid "All right. You've captured my interest."
msgstr "좋아. 내 관심을 끄는데 성공했군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 309d5aca-4fb4-417a-3342-bd70484ddf4f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_CapturedGoblin_Knows_Priestess = True
#.   Quest:
#.     - GLO_Tadpole_SUB_Priestess.LearnPriestess(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:309d5aca-4fb4-417a-3342-bd70484ddf4f
msgctxt "h95670324gf9d3g44a5g9c08g3839106907f2"
msgid "We'll be heroes, blessed by Priestess Gut in the name of the Absolute."
msgstr "절대자님의 이름으로, 여사제 거트님의 축복을 받아 우린 영웅이 될 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = 31dc304e-3002-61a8-7e89-20e724a036f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:31dc304e-3002-61a8-7e89-20e724a036f5
msgctxt "h9cda5144ga1f2g45bfga6b1gc4e86e5eabd6"
msgid "An all-powerful goddess that couldn't get you out of a cage?"
msgstr "널 철창에서 꺼내줄 수는 없는 전능하신 여신이시군?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 31ec4793-3017-ba1c-ed2d-410a1e141f5c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_CapturedGoblin_State_AtDrow = True
#.      - GOB_CapturedGoblin_State_Spared = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:31ec4793-3017-ba1c-ed2d-410a1e141f5c
msgctxt "hcb002dc9gac79g43e4gb61fg2640b045b21b"
msgid "'Ello again. Commander's waitin' to meet ya. Don't be shy."
msgstr "돌아왔군. 대장님이 기다리신다. 부끄러워하지 말라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = 38671f2c-ccfd-07a5-8d19-31a120c9a4cd
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:38671f2c-ccfd-07a5-8d19-31a120c9a4cd
msgctxt "habba0a94g7a57g426cg8e7dg5dae82f2deb2"
msgid "I've saved your hide twice now. You owe me."
msgstr "이제 나한테 두 번이나 빚진 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = 3f5a7a57-2e8a-9d38-7be5-92a601dedac3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_CapturedGoblin_State_GoblinMentionedAbsolute = True
#. TagRule: CLERIC
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:3f5a7a57-2e8a-9d38-7be5-92a601dedac3
msgctxt "h002e5e64g2dd6g4b63g8e84g26f20fd75421"
msgid "Who is this god you keep mentioning?"
msgstr "계속 얘기하고 있는 그 신은 누구야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = 3f5a7a57-2e8a-9d38-7be5-92a601dedac3
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_CapturedGoblin_State_GoblinMentionedAbsolute = True
#. TagRule: WIZARD
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:3f5a7a57-2e8a-9d38-7be5-92a601dedac3
msgctxt "hb4009ffcg202cg40c0ga4e4g7e08a2353ea2"
msgid "You keep mentioning this god, but I've never seen them in my studies."
msgstr "네가 계속 얘기하고 있는 그 신은 한번도 들어본 적이 없는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = 3f5a7a57-2e8a-9d38-7be5-92a601dedac3
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_CapturedGoblin_State_GoblinMentionedAbsolute = True
#. TagRule: PLANAR
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:3f5a7a57-2e8a-9d38-7be5-92a601dedac3
msgctxt "h14a947ccg00f9g4edfg852bg8615bb62eae8"
msgid ""
"Another god? I swear, Toril has more deities than there are stars in the sky."
msgstr "또 다른 신인가? 세상에, 토릴에는 신이 밤하늘의 별보다도 많나 보군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = 3f5a7a57-2e8a-9d38-7be5-92a601dedac3
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_CapturedGoblin_State_GoblinMentionedAbsolute = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:3f5a7a57-2e8a-9d38-7be5-92a601dedac3
msgctxt "h695c1548g1bf7g4ea7g80d1g3448f2afaf8f"
msgid "This god of yours is new to me."
msgstr "너희들의 신은 처음 들어 보는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 3f738c97-6755-59b1-304f-3b37e5afa408
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_CapturedGoblin_State_AtDrow = False
#.      - DEN_CapturedGoblin_Event_GoblinEscaped = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:3f738c97-6755-59b1-304f-3b37e5afa408
msgctxt "h6b583865g2272g43ceg8e06g042e4de87c42"
msgid "Gonna go tell the commander 'bout you. All nice things, 'course."
msgstr "대장님께 너희들에 대해 보고할 거다. 물론 좋은 얘기만이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 4005a957-5b92-834a-b39f-8f264b732c75
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:4005a957-5b92-834a-b39f-8f264b732c75
msgctxt "he2fdb501g6c22g4e38gace0g48f16b238610"
msgid "Unless... unless ya listen to me. I can save ya."
msgstr "혹은... 내 말을 듣는다면 다르지. 내가 널 살려줄 수 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = 43235539-0a4a-a28a-2bc6-fd62f75508d5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_CapturedGoblin_Range = True
#. SetFlags:
#.   Global:
#.     - DEN_CapturedGoblin_Range = False
#.   Object:
#.     - GLO_State_StopFollow(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:43235539-0a4a-a28a-2bc6-fd62f75508d5
msgctxt "h6926c84cg78b6g4e07gb583gf63ab5113e2b"
msgid "We're moving. Keep close to me."
msgstr "움직일 거야. 바짝 따라 오라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 456314bf-07f8-be96-8a1c-32370c37e9ef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:456314bf-07f8-be96-8a1c-32370c37e9ef
msgctxt "h456abfbegccb9g4b06g8ebfgbb29321f77c1"
msgid ""
"You won't believe what you can do once you've got the blessin' of the "
"Absolute."
msgstr "절대자의 축복을 받으면 뭐가 가능해 지는지 믿지도 못할걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 497b05d3-3499-ecbf-a891-c3276cafa9d5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:497b05d3-3499-ecbf-a891-c3276cafa9d5
msgctxt "h5b72fb82ge929g48e2gb4b5g817f7c78d011"
msgid ""
"Oh, we like it when people run - makes 'em taste sweeter when ya catch 'em."
msgstr "오, 우리는 사람들이 도망가면 좋아해 - 도망가는 거 잡을때 고기가 더 달거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 49d39727-4b4f-30a5-cc0f-a941bcb0a2cf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_CapturedGoblin_State_LeftDen = True
#.      - DEN_CapturedGoblin_Event_GoblinEscaped = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:49d39727-4b4f-30a5-cc0f-a941bcb0a2cf
msgctxt "h140ba160gd051g402dg8e47gb14de3565796"
msgid "Ah, thought I was never gonna get outta there."
msgstr "아, 거기서 못 빠져나가는 줄 알았네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 4a9f091f-f915-e9de-e872-9bfb87ea3b44
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:4a9f091f-f915-e9de-e872-9bfb87ea3b44
msgctxt "h8759427fgab32g4a95gb929g59180947fdce"
msgid ""
"Yeah. Take me back to the tribe, and we'll tell the boss all about this "
"pretty little place so she can burn it to the ground."
msgstr "그래. 부족한테 데려가줘. 그리고 대장한테 이 예쁜 곳을 알려줘서 이곳을 몽땅 태워버리게 하자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 4b35c0b8-6265-b595-ad1e-a22c39b04181
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:4b35c0b8-6265-b595-ad1e-a22c39b04181
msgctxt "hb3f3b8abg6919g49dfg9834ge00dfccb3ac6"
msgid "I tell ya anything, and my life ain't worth a rat's breakfast."
msgstr "만약 내가 뭐라도 분다면, 내 목숨은 쥐새끼 아침식사 거리도 못될 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 4c47db34-5495-dc8d-89e1-412c677ba832
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:4c47db34-5495-dc8d-89e1-412c677ba832
msgctxt "hd8569f47g177dg4aa2gb57bg238ac662d7f7"
msgid ""
"You're not mates with the tiefs, are you? You need to get back to your own "
"people before you go soft."
msgstr "너 티플링놈들 친구는 아니지, 응? 더 물렁해지기 전에 동족들한테 돌아가지 그래."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = 4c75b3b5-7730-8f20-eb1c-a8a28d0b7fb3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 2f8984e8-ac10-157a-04a8-6ac68085727a_DEN_CapturedGoblin_CruelDrow = True
#.   Tag:
#.      - REALLY_SELDARINEDROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:4c75b3b5-7730-8f20-eb1c-a8a28d0b7fb3
msgctxt "h2874f112g27c2g434bg938bgc21307c89adf"
msgid "If she's as cruel as you say, she'll crush your tribe under her heel."
msgstr "만약 그녀가 너가 말한만큼 잔인하다면, 너희 부족을 아주 짓밟아 버릴 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = 4edee77a-f518-c9cd-1b22-eca5bac33155
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 0
#. CheckFlags:
#.   Script:
#.      - GEN_CanDetectThoughts_2 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:4edee77a-f518-c9cd-1b22-eca5bac33155
msgctxt "h872f4f90gef43g4fa7gbc50gfdd01c77ec28"
msgid "<i>Read her mind.</i>"
msgstr "<i>그녀의 생각을 읽는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = 511d1267-0482-dcfd-4edc-004a733acd23
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:511d1267-0482-dcfd-4edc-004a733acd23
msgctxt "hd1ccee79g62abg4e4dg86e4g54f05490ff27"
msgid "No one deserves to be locked up like that."
msgstr "누구도 그런 식으로 갇혀 있어서는 안되지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 5241d638-c62b-849a-bd9d-e5b30c36c563
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_CapturedGoblin_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_CapturedGoblin_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:5241d638-c62b-849a-bd9d-e5b30c36c563
msgctxt "hf3a687aag4c44g4005g8504gf3bb0b7a40e1"
msgid "Why'd ya open my cage? Think we're gonna be friends?"
msgstr "내 우리는 왜 열었어? 우리가 친구라도 될 줄 알았어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = 525fdbad-4c8a-e773-9d2e-67e10647298e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:525fdbad-4c8a-e773-9d2e-67e10647298e
msgctxt "hb2385f0eg41dcg4021gb629g0fee0d0c4792"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 54207bbc-a6fb-4f59-95ef-a857c91d5128
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_CapturedGoblin_HasMet(1) = False
#.   Tag:
#.      - DUERGARDWARF(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_CapturedGoblin_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:54207bbc-a6fb-4f59-95ef-a857c91d5128
msgctxt "h6522b4fbg9f43g4d1cga082gdfde938292b9"
msgid "<i>Yer</i> a long way from home, ain't ya, underdwarf?"
msgstr "<i>너</i> 집에서 아주 멀리도 나오셨구만, 안그래 언더드워프?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = 56ef73ac-00fa-f298-b520-f7fcd4523221
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:56ef73ac-00fa-f298-b520-f7fcd4523221
msgctxt "hadb52f5ag0017g46f4gb591g229e71e8db84"
msgid ""
"I'll do a lot worse than that cage if you don't make this worth my while."
msgstr "네가 그만한 가치가 있는 일을 해주지 않으면, 그 우리보다 더 험한 꼴을 당하게 만들어주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 56fe34a8-f629-8a02-f58c-4ddf81df1d79
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_CapturedGoblin_Event_GoblinEscaped = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:56fe34a8-f629-8a02-f58c-4ddf81df1d79
msgctxt "h9a843691g534eg42fag8967gd3d837ea1b67"
msgid ""
"I'll introduce ya to my whole tribe and put in a good word for ya - see ya "
"at the camp."
msgstr "부족 전체에 너를 소개하고 좋게 말해줄게. 야영지에서 보자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = 588b3577-5922-0b5d-df13-5509efc52db0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_CapturedGoblin_Knows_Priestess = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:588b3577-5922-0b5d-df13-5509efc52db0
msgctxt "h941f9f2agf51eg40fega26egf37546e4eebf"
msgid "What could a tribe of goblins possibly offer me?"
msgstr "고블린 부족이 내게 대체 뭘 줄수 있을까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 59ab03d8-98af-7faa-f921-0f08a80ce7bc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_CapturedGoblin_HasMet(1) = False
#.   User:
#.      - DEN_CapturedGoblin_State_UserMet(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_CapturedGoblin_HasMet(1) = True
#.     - DEN_CapturedGoblin_PromisedHelp(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:59ab03d8-98af-7faa-f921-0f08a80ce7bc
msgctxt "hcc5ae5f4g2e72g4cd0g8a10gcfe2963ea511"
msgid "I met your friend. Ready to go?"
msgstr "네 친구를 만났었지. 갈 준비 된 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 5bbb1778-8456-2746-ad32-b88e0b32b0b3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_CapturedGoblin_State_Executed = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:5bbb1778-8456-2746-ad32-b88e0b32b0b3
msgctxt "h0e08f4b9g9e0cg49e6g902eg862b45eb2630"
msgid ""
"Let me go. I'll sneak off and become a hermit - won't cause trouble for "
"nobody."
msgstr "풀어줘. 몰래 나간 다음 찌그러져서 지낼 테니까 - 아무 문제 안 일으킬게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 5cf2c3c8-bde0-de51-a20b-f1c261f7e2d8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_CapturedGoblin_State_GoblinMentionedAbsolute = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:5cf2c3c8-bde0-de51-a20b-f1c261f7e2d8
msgctxt "h59bf77e4g7e26g4b6cgbb20g4dcc16a941fd"
msgid ""
"Things are changin'. The Absolute's bringin' us all together - goblins, "
"drow, duergar, gnolls."
msgstr "상황이 변하고 있어. 절대자가 우리 모두를 끌어모으고 있다고. 고블린, 드로우, 듀에르가, 놀."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 5e19808d-dca3-1594-ec5f-376630cfddb3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_CapturedGoblin_HasMet(1) = True
#.      - DEN_CapturedGoblin_PromisedHelp(1) = True
#.   Object:
#.      - DEN_CapturedGoblin_Follow(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:5e19808d-dca3-1594-ec5f-376630cfddb3
msgctxt "h9d947aaeg0d3fg4453g9813gedc5c520f086"
msgid "Ready to go meet my tribe? Just say the word."
msgstr "내 부족을 만나러 갈 준비됐나? 그럼 말만 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 642f2742-1565-308f-8071-e8f283191b04
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:642f2742-1565-308f-8071-e8f283191b04
msgctxt "hfe1aa9bag4fe8g41bagab8cg2235f00ca95a"
msgid "Yeah, 'ow many were there? Four?"
msgstr "그래, 몇이나 있었는데? 넷?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 677548ec-1d58-5849-4b29-f19ac0be0e70
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:677548ec-1d58-5849-4b29-f19ac0be0e70
msgctxt "hb6ebbea3g34f4g4ff6g8294gea6972c2f925"
msgid "Dunno. I don't repay 'em, as a rule."
msgstr "몰라. 갚지 않는 게 내 신조야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 67aaca47-5d4d-0415-bfb6-3fad15656006
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:67aaca47-5d4d-0415-bfb6-3fad15656006
msgctxt "haa41f6e9gaa25g4294ga9c3gb7ac11b74764"
msgid "Is that it? Can I go?"
msgstr "됐지? 이제 가도 돼?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 68c264cd-9156-a216-4539-1aa0369e9210
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:68c264cd-9156-a216-4539-1aa0369e9210
msgctxt "ha999f2e3gdcd2g4d02g9c5eg66ff10904bae"
msgid "Dunno - never repaid anything. But you been square with me, true."
msgstr "몰라 - 아무것도 안 갚을 거야. 하지만 네가 솔직하게 대해준 건 맞아, 사실이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 6b05473d-b8ec-2a24-1782-71a179750169
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:6b05473d-b8ec-2a24-1782-71a179750169
msgctxt "h804fa194g5db2g4170gb9cdg5150beb97dc9"
msgid "It ain't safe here. Hurry back."
msgstr "여긴 안전하지 않아. 빨리 돌아와."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 6c6fdb09-ba2d-4db4-d3a0-ec67b90749e8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:6c6fdb09-ba2d-4db4-d3a0-ec67b90749e8
msgctxt "he5d8b286g839bg476bg9b0bgf7271ec0064e"
msgid "'Appily. Lead the way."
msgstr "기꺼이. 앞장서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = 6e529804-a2a8-7570-a9e3-15700c83c9c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:6e529804-a2a8-7570-a9e3-15700c83c9c1
msgctxt "h9d608a4ega9e9g4daagb557g1fd5c52982e8"
msgid "You're in trouble no matter what. You may as well talk."
msgstr "어찌 됐든 넌 곤경에 처한 거야. 그냥 말하는 게 좋을 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 6f934d8d-b672-e2e7-e03d-8990d6eec4bc
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:6f934d8d-b672-e2e7-e03d-8990d6eec4bc
msgctxt "h6e4ece31g0ce4g4d2dg86a2g0b80c680ea11"
msgid ""
"Don't believe you. You ain't got enough scars to be one of her playthings."
msgstr "못 믿겠는데. 그녀의 장난감이라고 하기엔 넌 흉터가 너무 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 6f934d8d-b672-e2e7-e03d-8990d6eec4bc
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:6f934d8d-b672-e2e7-e03d-8990d6eec4bc
msgctxt "hb50eedbegda50g423ag8007ge883fcb0390c"
msgid "Don't believe you. There's something a bit soft about you."
msgstr "넌 못 믿겠어. 부드러운 구석이 있는 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 71f1954e-701e-141e-f1af-2c59e94e7665
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:71f1954e-701e-141e-f1af-2c59e94e7665
msgctxt "h70fdd754gdae3g4caag9c6cg960d312a1c03"
msgid ""
"The Absolute is gold from the sky, She is. The blessin' in the storm an' the "
"storm itself."
msgstr "절대자님은 하늘에서 내려온 보물이시지, 암. 폭풍의 축복이시자, 폭풍 그 자체시고 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = 7754d909-12b3-6277-a565-db373d2e0064
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Absolute_Knows_Name = True
#.      - DEN_CapturedGoblin_State_GoblinMentionedAbsolute = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:7754d909-12b3-6277-a565-db373d2e0064
msgctxt "h46b2bee0g3f65g44e2g9119gdbf60890a55e"
msgid "Ah, the 'Absolute'. Is this the deity you're bowing to?"
msgstr "아, '절대자'라. 이게 네가 숭배하는 그 신격체인가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = 77adbf4c-37ea-46a9-e6d8-98a51f1d49a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:77adbf4c-37ea-46a9-e6d8-98a51f1d49a4
msgctxt "h6f4a5e8cg3c47g43ebgb610g30fb18482f1e"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = 79be6b36-a731-7907-6dea-e59b4210fe00
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_CapturedGoblin_Range = False
#. SetFlags:
#.   Global:
#.     - DEN_CapturedGoblin_Range = True
#.   Object:
#.     - GLO_State_StopFollow(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:79be6b36-a731-7907-6dea-e59b4210fe00
msgctxt "h019c5b75g0cc7g43acg9729g074f39cd177f"
msgid "Stop following me so closely."
msgstr "날 너무 가까이 따라오지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 7a238c31-23ba-d590-9bac-74461b3f9e1d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:7a238c31-23ba-d590-9bac-74461b3f9e1d
msgctxt "h841575aag1f13g4e01g8fe4gf97eba99fbbe"
msgid "Unless... unless ya listen to me. I can save ya."
msgstr "혹은... 내 말을 듣는다면 다르지. 내가 널 살려줄 수 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = 7a4b6844-78d4-cc04-25bd-33bd4c1bf654
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_CapturedGoblin_State_GoblinMentionedAbsolute = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:7a4b6844-78d4-cc04-25bd-33bd4c1bf654
msgctxt "ha10d89cbga548g4478g9f49gf088123ca5fa"
msgid "Who is this Absolute?"
msgstr "절대자라는 게 누구야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = 7ba54519-c579-d1f7-aee4-cce7c7797153
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:7ba54519-c579-d1f7-aee4-cce7c7797153
msgctxt "h908e58b0g65c7g4396gab36gfde4cd68a977"
msgid "Who's your 'boss lady'?"
msgstr "네 '대장님'이라는 게 누구야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 7e879a34-f09f-4f51-59b1-25112a66136a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_CapturedGoblin_PCDiscussedAbsoluteWithSazza(1) = True
#.   Global:
#.     - GLO_Absolute_Knows_GoblinsWorship = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:7e879a34-f09f-4f51-59b1-25112a66136a
msgctxt "h90a5ee98g838eg4ab1gb96bgc7f061649204"
msgid "We're burnin' Her name across the face o' the world, we are."
msgstr "그분의 이름이 온 세상을 불태우게 만들 거야, 우리가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 80fac02d-ff18-574b-9b71-7404ee4f6c30
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_CapturedGoblin_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_CapturedGoblin_HasMet(1) = True
#. TagRule: DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:80fac02d-ff18-574b-9b71-7404ee4f6c30
msgctxt "ha5c979e6gd789g4da7g8509g96e6f3748974"
msgid ""
"Didn't expect to see a drow in here. Did the boss lady send you to rescue me?"
msgstr "여기서 드로우를 만날 줄은 몰랐는데. 대장마님께서 나를 구하라고 보내셨나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 8192e160-0c91-f041-1a35-57114cafeeb1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:8192e160-0c91-f041-1a35-57114cafeeb1
msgctxt "h3dc10a82gf64eg4493gbd83g388a01134265"
msgid "I ain't surprised. Tell you wot."
msgstr "그러시겠지. 내가 제안 하나 할게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 82818135-dd13-61d9-2328-9ba455b9e5c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:82818135-dd13-61d9-2328-9ba455b9e5c6
msgctxt "h5b9e52c2g6d74g4b37g9e5egc795120ce698"
msgid ""
"Think my tribe'll care? They'll peel yer face off and nail it to a wall!"
msgstr "내 부족이 신경이라도 쓸것 같아? 니 얼굴가죽을 벗겨서 벽에다가 못 박아 버릴 거라고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 85bf9cf1-4147-c09c-2c2f-6b46a5be7927
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:85bf9cf1-4147-c09c-2c2f-6b46a5be7927
msgctxt "h2d7551bdg0ed4g4b11g8c67gbc01df2ab312"
msgid "Just lemme go."
msgstr "이제 보내줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 85d24c30-2d1f-5b18-3562-cf8cf48f0ae1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:85d24c30-2d1f-5b18-3562-cf8cf48f0ae1
msgctxt "h85efc859ge51fg4935g97f4gb759a58228c2"
msgid "An' that's all I know, I swear."
msgstr "그게 아는 전부야, 맹세코."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = 8791c26f-0478-4f89-7ec7-8a507a7c0c12
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:8791c26f-0478-4f89-7ec7-8a507a7c0c12
msgctxt "hdfa39236g93cfg4ea8gae77ge3e4a364e75f"
msgid "You made me a promise, remember?"
msgstr "넌 나와 약속을 했어, 기억나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 88247145-b711-f105-c1ee-8fe5a41d17f7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:88247145-b711-f105-c1ee-8fe5a41d17f7
msgctxt "h8e979bd7g29a8g4a9dgae89gef1bff4f7abc"
msgid ""
"Well, maybe She sent ya to 'elp me. An' ya <i>will</i>, if ya wanna save yer "
"skin."
msgstr "뭐, 날 도와주기 위해서 널 보내신걸수도 있지. 그리고 넌 <i>그래야 할 거야</i>, 목숨줄 유지하고 싶으면."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = 89a9d533-a528-bfb2-05e2-8d579e431034
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SELDARINEDROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:89a9d533-a528-bfb2-05e2-8d579e431034
msgctxt "h87eac866g2156g486dg9539gb2ae34c831a2"
msgid "I've made some strange alliances, but... is she really your 'mate'?"
msgstr "여태껏 이상한 동맹을 맺은적은 있었다만... 그녀가 진짜로 네 '동료'야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 91464d6a-3196-0bc7-7b2a-c74789cf38c2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:91464d6a-3196-0bc7-7b2a-c74789cf38c2
msgctxt "hadc75087gb4d7g4a01g9544gf064847fe151"
msgid "What do ya wanna know?"
msgstr "뭘 알고 싶은 건데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 94ea691f-80d9-1b50-7710-b69fd5b3b9b2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:94ea691f-80d9-1b50-7710-b69fd5b3b9b2
msgctxt "h74d7e38agc57dg4bd6gb89cg3f1c66e0b187"
msgid "You want it? It's yours! It's all yours!"
msgstr "원해? 너 거야! 전부 말이야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 9573ba06-52d3-1f5d-68db-36a001853a55
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:9573ba06-52d3-1f5d-68db-36a001853a55
msgctxt "hc0bc1b8fg2cb1g438egb011g8c28877eb94f"
msgid "Sure fing. I'll 'ang back a little."
msgstr "알았어. 후방에 머물러 있을게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = 9a95ee9b-fa2b-bdca-f5c5-063872280f69
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:9a95ee9b-fa2b-bdca-f5c5-063872280f69
msgctxt "hce1c5633g393ag4923gbdf2g161c36d01f67"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 9f123675-f449-ad6f-2e2f-263974bb1d2c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:9f123675-f449-ad6f-2e2f-263974bb1d2c
msgctxt "ha9d8ecacg6aeag49dega27dge66cc0602c50"
msgid "Uh... sure they don't."
msgstr "어… 물론 그러면 안되지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = a0fb1eb7-039c-93f4-0fdf-41045bbd9fab
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:a0fb1eb7-039c-93f4-0fdf-41045bbd9fab
msgctxt "h9358d20cgdadcg481agbc06g3ab1164b8122"
msgid "Yes, she sent me. Ready to get out of here?"
msgstr "그래, 그분이 날 보냈어. 나갈 준비 됐어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = a63c0a99-52f8-5944-13d6-cb4a532e6a6a
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#. TagRule: BERSERKER
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:a63c0a99-52f8-5944-13d6-cb4a532e6a6a
msgctxt "h3ae2ec73g373fg4a81g932bga2114de01d6e"
msgid "<b>TELL ME, OR YOU'LL BE MY BREAKFAST.</b>"
msgstr "<b>불든가, 아니면 내 아침 식사가 되든가.</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = a63c0a99-52f8-5944-13d6-cb4a532e6a6a
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:a63c0a99-52f8-5944-13d6-cb4a532e6a6a
msgctxt "h803838c7gbabag492dg87a1g4fde172ded4b"
msgid "Tell me, or you'll be <i>my </i>breakfast."
msgstr "불어라, 아니면 네가 <i>내</i> 아침 식사가 될 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = a7752c3a-4e96-a968-c9da-4a5cc601954e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:a7752c3a-4e96-a968-c9da-4a5cc601954e
msgctxt "he4d35774g3f55g41fbgb6b4g01c026bd5ee2"
msgid "'Appily. Lead the way."
msgstr "기꺼이. 앞장서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = a85a505c-2f20-2b1b-3bcf-c9ee295518a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:a85a505c-2f20-2b1b-3bcf-c9ee295518a6
msgctxt "h94d57ab2g87b6g419fg881bgb14b7c8339bf"
msgid ""
"We got more than ya can 'andle. We're gonna tear yer gate down an' peel yer "
"skins off."
msgstr "우린 너가 감당키 어려울만큼 많이 있어. 이 문을 박살내고 니 가죽을 벗겨내주마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = a8f2f73c-ce94-b304-d7f8-257cfb7c4fa5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:a8f2f73c-ce94-b304-d7f8-257cfb7c4fa5
msgctxt "h0f1a3db3gfab9g412dga199gaa0542a60d2c"
msgid ""
"I saw Dror Ragzlin stash some stuff behind the waterfall near the bridge."
msgstr "드롤 라그즐린이 다리 근처 폭포 뒤에 어떤 물건을 숨기는 걸 봤어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = aa4a7489-369e-3234-9bac-59cf76ca3934
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_CapturedGoblin_Knows_Priestess = True
#.   Quest:
#.     - GLO_Tadpole_SUB_Priestess.LearnPriestess(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:aa4a7489-369e-3234-9bac-59cf76ca3934
msgctxt "h28ef8e84g9cd0g40acgaf81g7228a50c3813"
msgid ""
"Take me home, and Priestess Gut will brand you so you can join the tribe as "
"well."
msgstr "집으로 데려가줘, 그러면 여사제 거트가 너가 부족에 들어올수 있도록 낙인을 찍어 주실거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = b07fc5ce-0f56-2ec3-9f1a-a17e955bc321
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_CapturedGoblin_PromisedHelp(1) = True
#. SetFlags:
#.   Object:
#.     - DEN_CapturedGoblin_Follow(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:b07fc5ce-0f56-2ec3-9f1a-a17e955bc321
msgctxt "h0fcd0076gf44ag4b31gbfccgbf413b27db5e"
msgid "Follow me. I'll keep you safe."
msgstr "날 따라와. 내가 너를 안전하게 지켜줄게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = b2316c1f-830e-2ac1-6ed4-3d0fa4fe27b5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_CapturedGoblin_State_PlayerRescuedGoblin = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:b2316c1f-830e-2ac1-6ed4-3d0fa4fe27b5
msgctxt "h3150f183g79b0g4b2cg92b3ga9287dacd4e5"
msgid "I just saved your life. Show some gratitude."
msgstr "내가 방금 네 목숨을 구했어. 감사 정도는 표현해 줬으면 하는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = b3366685-5651-fb39-f6da-078ca226aa48
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:b3366685-5651-fb39-f6da-078ca226aa48
msgctxt "h376e7bacgda3fg4f99g8960g8dc2cf8db3d9"
msgid ""
"She's got all kinds of <i>booyahg</i>. Sickly tastin' stuff - might make "
"your limbs grow back, but it's as sour as a bugbear's widdle."
msgstr ""
"그녀는 온갖 <i>부야그</i>를 가지고 있어. 맛이 역겨운 물건이야. 네 팔다리를 다시 자라게 할 수도 있지만, 버그베어의 오줌만큼 "
"시큼해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = b52fb698-1ec0-34e9-dd71-3d07e6b4ac2c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 2f8984e8-ac10-157a-04a8-6ac68085727a_DEN_CapturedGoblin_CruelDrow = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:b52fb698-1ec0-34e9-dd71-3d07e6b4ac2c
msgctxt "h6065b5bdg605ag4c49ga673gf816068a28a1"
msgid ""
"The lady that sent me here's the cruellest drow I ever met. You could learn "
"a thing or two from her."
msgstr "내가 만났던 드로우 중 제일 잔혹한 분이지. 너도 한 두 가지 정도는 배울 수 있을 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = b825c56b-9c3d-48da-a25a-b37c37970a89
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:b825c56b-9c3d-48da-a25a-b37c37970a89
msgctxt "hc90042a4g3373g40d3g8050g9cf659178368"
msgid "Too late for that, worgmeat. My tribe's comin'."
msgstr "그러기엔 너무 늦었어, 워그밥 자식아. 내 부족이 오고 있다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = c19c6096-5825-7e7f-5fa7-b59e44318d3d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:c19c6096-5825-7e7f-5fa7-b59e44318d3d
msgctxt "h0ac6e449gc522g4b53gb09dgd9f25185c19a"
msgid "Good to be free again, gotta say."
msgstr "이 말은 해야겠어, 다시 자유로워지니 좋네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = c41246cc-932e-319e-7760-9b7f0d25c670
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LOLTHDROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:c41246cc-932e-319e-7760-9b7f0d25c670
msgctxt "h15fccc34g8d50g44e4g868eg8b72c6e369dd"
msgid "No drow would sully themselves in a goblin tribe. That's madness."
msgstr "스스로를 고블린 부족과 엮여서 더럽히는 드로우는 없어. 그건 미친 짓이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = c47a887a-b53b-6475-7e14-ac57281208c2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:c47a887a-b53b-6475-7e14-ac57281208c2
msgctxt "h02c83dd5g1b1cg41a4g995eg5d89eb2b9145"
msgid "Then you can come to our camp an' learn all about the Absolute. Deal?"
msgstr "그리고 우리 야영지에 와서 절대자에 대해 배워보는 거야, 어때?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = c595977d-698c-d04e-db42-ae9d3e71d20d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:c595977d-698c-d04e-db42-ae9d3e71d20d
msgctxt "h42250ad6g599dg4501g96d5ga4c1482ca162"
msgid "I tell ya anyfing, they'll toss me back in the pit!"
msgstr "아무것도 얘기 안 할 거야, 구덩이에 던져질 거라고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = c8fac77e-a38d-fc77-8d38-ee9b4ef34c3a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:c8fac77e-a38d-fc77-8d38-ee9b4ef34c3a
msgctxt "hac849bc6g378ag4f0cg8ca1gcdfb37038c34"
msgid "Somebody 'elp me!"
msgstr "누가 좀 도와줘!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = ca4562b7-77ac-d4c9-f2a8-dc0000025214
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:ca4562b7-77ac-d4c9-f2a8-dc0000025214
msgctxt "h24a094bbg15f7g471bg80c8g65c281ef7f41"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = cacbe8e4-918e-14d1-8a96-97a2c65c2e48
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_CapturedGoblin_Event_Waypoint = True
#. SetFlags:
#.   Global:
#.     - DEN_CapturedGoblin_Event_Waypoint = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:cacbe8e4-918e-14d1-8a96-97a2c65c2e48
msgctxt "hf9c85ed9gdc7fg4c0dg9108g8aa1af2f0eb8"
msgid ""
"Oi! Don't leave yer pal Sazza behind! I can't follow yer fancy "
"<i>booyahg</i>."
msgstr "야! 네 친구 삿자를 두고 가지 마! 난 네 화려한 <i>부야그</i>를 따라갈 수 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = cc1c6a5b-2758-67db-efdc-7c7628bed727
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_CapturedGoblin_State_PlayerRescuedGoblin = False
#. TagRule: REALLY_HALFORC
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:cc1c6a5b-2758-67db-efdc-7c7628bed727
msgctxt "h7f852472g0aeag4800gada6g24f4bcca1518"
msgid ""
"Do I look like I'm scared of goblins? I'll smash 'em, like the last lot."
msgstr "내가 고블린들한테 겁먹은 거 같냐? 지난번 녀석들처럼 박살 낼 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = cc1c6a5b-2758-67db-efdc-7c7628bed727
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_CapturedGoblin_State_PlayerRescuedGoblin = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:cc1c6a5b-2758-67db-efdc-7c7628bed727
msgctxt "he2f5028ag9ee3g4f82gbdb2gf761bd8ffd29"
msgid "They can try, but they won't be the first goblins I've killed today."
msgstr "노력은 할 수 있겠지. 하지만 전에도 고블린들은 많이 죽여 봤다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = ccd2de96-cbdc-fa3e-0932-bd4132cffe71
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:ccd2de96-cbdc-fa3e-0932-bd4132cffe71
msgctxt "hc4c1f3fagc8ceg46ebgb178g54d65948b794"
msgid "Nobody sent me."
msgstr "날 보낸 사람 같은 건 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = ccd9935b-e749-0391-f09c-4380b845ef25
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_CapturedGoblin_QuestReward = False
#. SetFlags:
#.   Global:
#.     - GOB_CapturedGoblin_QuestReward = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:ccd9935b-e749-0391-f09c-4380b845ef25
msgctxt "h577d23d1gdaf9g45a5g8d36gd7714329069a"
msgid ""
"Take this. It's everything I've got. I won't try an' get ya killed again, "
"promise."
msgstr "받아. 내가 가진 전부야. 다신 널 죽이려고 하지 않을게, 약속해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = cf9402af-dd3c-d4c7-6280-d4a902e590a2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:cf9402af-dd3c-d4c7-6280-d4a902e590a2
msgctxt "h33299275gc29eg49afga0a8g550e9a1c8a0d"
msgid "Goddess."
msgstr "여신님이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = d14c1b42-e4e6-d718-7dc7-a04854cd7c6f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:d14c1b42-e4e6-d718-7dc7-a04854cd7c6f
msgctxt "h247374c1gacfag4923gbafdg3dda44e994ab"
msgid "What's in your priestess' chapel?"
msgstr "여사제 예배당에 뭐가 있는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = d1b2b7b3-c28b-fff9-9325-a1e718eda28e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:d1b2b7b3-c28b-fff9-9325-a1e718eda28e
msgctxt "h19260713g4bb2g4a92gb8f7g5c9a66380eec"
msgid "Help me escape, an' I'll tell my mates to leave ya alone."
msgstr "탈출을 도와주면, 애들한테 너 건들지 말라고 할게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = d5587b40-2bbd-7a5d-e9d3-1196194aab3f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:d5587b40-2bbd-7a5d-e9d3-1196194aab3f
msgctxt "h345c7316gd5adg4484g869dgd5c0a92d19b6"
msgid "Slow down. I have questions for you."
msgstr "멈춰봐. 물어볼 게 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = d64866e5-b8f3-8be1-5440-40e70695a440
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:d64866e5-b8f3-8be1-5440-40e70695a440
msgctxt "h895ef1e3g600bg4bf6gba55g2fe90a5db8bf"
msgid "Get me outta 'ere, an' I'll introduce you to my tribe. You'd like 'em."
msgstr "날 여기서 꺼내줘, 그럼 널 우리 부족에게 소개해 줄게. 마음에 들 걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = df2fbb33-9a0f-c173-5dde-7a4d39a7f6ed
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - DEN_CapturedGoblin.MetGoblin(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:df2fbb33-9a0f-c173-5dde-7a4d39a7f6ed
msgctxt "h86f49e97g6fb3g49b0g9251g3a87270021c2"
msgid "You won't regret it, promise."
msgstr "후회하지 않을 거야, 약속할게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = e15439ad-ed04-969a-ac92-7ed0fef9be75
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_CapturedGoblin_PromisedHelp(1) = True
#. SetFlags:
#.   Object:
#.     - DEN_CapturedGoblin_Follow(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:e15439ad-ed04-969a-ac92-7ed0fef9be75
msgctxt "hc898b32eg4c3bg42e6gbb3eg4e0cf925cbf5"
msgid "Follow me. I'll keep you safe."
msgstr "날 따라와. 내가 너를 안전하게 지켜줄게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = e1599eec-7ff0-e84b-8187-e4126daf8e26
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:e1599eec-7ff0-e84b-8187-e4126daf8e26
msgctxt "h1827457fg8cf2g4641gad4fg528473675062"
msgid "It's too late to make friends, worgmeat. My tribe's comin'."
msgstr "친구를 만들고 싶다면 이미 늦었어, 워그 고기야. 내 부족이 오고 있으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = e22220fa-b8a8-3eb8-e2a3-ea00477c178e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:e22220fa-b8a8-3eb8-e2a3-ea00477c178e
msgctxt "hdbd858fegcdf6g4732g8195ge56061e889ad"
msgid "Bad news for me. Good news for the spiders."
msgstr "나한테는 나쁜 소식이군. 거미들에게는 좋은 소식이지만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = e2f00095-1299-ee11-c2c7-972aa77dfab4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_CapturedGoblin_State_GoblinMentionedAbsolute = False
#. SetFlags:
#.   Global:
#.     - GLO_Absolute_Knows_Name = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:e2f00095-1299-ee11-c2c7-972aa77dfab4
msgctxt "h9f1fd838g350eg49begbf95gded69478e754"
msgid ""
"They're gonna burn this pretty camp for the glory of the Absolute and 'ang "
"ya by yer guts."
msgstr "놈들이 절대자님의 영광을 위해 여길 불태워 버리고 네 내장을 꺼내버릴 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = e3306bbd-9f94-eca4-276f-a4b489e2a575
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_CapturedGoblin_Knows_Priestess = False
#. SetFlags:
#.   Global:
#.     - DEN_CapturedGoblin_Knows_Priestess = True
#.     - DEN_CapturedGoblin_State_GoblinMentionedAbsolute = True
#.   Quest:
#.     - GLO_Tadpole_SUB_Priestess.LearnPriestess(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:e3306bbd-9f94-eca4-276f-a4b489e2a575
msgctxt "h79728801g5648g46b5g93ccg1c1599cb1d6b"
msgid ""
"Priestess Gut will give a little under-dweller like you all the blessings of "
"the Absolute."
msgstr "너같이 조그마한 언더다크 출신한테는 여사제 거트께서 절대자의 축복을 아주 많이 내려주실 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = e5cd99a5-000d-bf60-46af-0093fb8613b1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GNOME(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:e5cd99a5-000d-bf60-46af-0093fb8613b1
msgctxt "hb53fb520g8ab3g4a16g99b8g30491f54c864"
msgid ""
"<i>Fascinating.</i> It sounds like nonsense, but I'm intrigued nevertheless."
msgstr "<i>흥미롭군.</i> 허무맹랑하게 들리지만, 구미가 당겨."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = e6730fd2-75c4-61b0-7b6f-1515dfd0d8d2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_CapturedGoblin_PromisedHelp(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_CapturedGoblin_PromisedHelp(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:e6730fd2-75c4-61b0-7b6f-1515dfd0d8d2
msgctxt "h1aba6a7agdc7dg4fe6gbcb8g61a14cf9d8dc"
msgid "It's a deal, signed and struck."
msgstr "줄 긋고 도장 찍고, 거래 성립이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = e8ec3df9-6a84-b5f0-78ed-b071daac49a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:e8ec3df9-6a84-b5f0-78ed-b071daac49a3
msgctxt "h7d51f963g6e9cg4c0ag9f9dg984740ad3aa8"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = ec542757-772f-759e-64b2-4fe760069951
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:ec542757-772f-759e-64b2-4fe760069951
msgctxt "hbd0f5a62g80bag4a1bgb5degd514a8bcae4f"
msgid "<i>Let her go.</i>"
msgstr "<i>놔준다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Player
#. NodeID = ecf857f5-7b77-e683-082b-9502a0ed6cfd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:ecf857f5-7b77-e683-082b-9502a0ed6cfd
msgctxt "hba5a14c0g1f66g4a6ag9a88g47a438949e4a"
msgid "Don't worry, I'll be gone before the killing starts."
msgstr "걱정 마, 살육이 벌어지기 전에 난 여기 없을 테니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = ee5ec2b2-45ab-9b86-d729-88b69fc8e095
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_CapturedGoblin_HasMet(1) = True
#.      - DEN_CapturedGoblin_PromisedHelp(1) = False
#.   Object:
#.      - DEN_CapturedGoblin_Follow(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:ee5ec2b2-45ab-9b86-d729-88b69fc8e095
msgctxt "hf6ca412fg1463g44c8g9baegc90e84145d22"
msgid ""
"Door's open, I see. 'Elp me escape, an' I'll introduce ya to my tribe, all "
"friendly-like."
msgstr "문이 열려있네. 탈출 좀 도와줘. 그러면 우리 부족을 소개해 줄 테니, 다들 친절하다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = f051ae88-99fc-a051-ba7b-d240471c187f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:f051ae88-99fc-a051-ba7b-d240471c187f
msgctxt "h42dd8318gc8b9g4140g880eg00c3440b0b45"
msgid ""
"Another drow - she's one of my best mates. Thought you might work for her."
msgstr "다른 드로우 - 내 절친 중 한 명이지. 그녀 밑에서 일하는 놈인 줄 알았네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = f5aa7f89-7f7c-6a2f-dabf-3598f6e4d80f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_CapturedGoblin_Follow(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:f5aa7f89-7f7c-6a2f-dabf-3598f6e4d80f
msgctxt "h780fe180ge2c8g43c8g87a4g4ed892589faa"
msgid "Bloody tiefs everywhere. We movin' or wot?"
msgstr "망할 티플링들 사방에 깔렸네. 갈 거야 말 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = f6ad5ba2-4073-ca0c-9235-eb826da592bd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:f6ad5ba2-4073-ca0c-9235-eb826da592bd
msgctxt "hbd5ff42fgcfd4g4cf8g9f72g05c568780cda"
msgid "Wot do ya say? We 'ave a deal?"
msgstr "어때? 할 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = fb5e5e02-a8ff-24e5-d7ca-be71c9092a71
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_CapturedGoblin_Knows_Priestess = True
#.     - DEN_CapturedGoblin_State_GoblinMentionedAbsolute = True
#.   Quest:
#.     - GLO_Tadpole_SUB_Priestess.LearnPriestess(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:fb5e5e02-a8ff-24e5-d7ca-be71c9092a71
msgctxt "h75e07222g121cg4900gb0ecga9d7e9e0bb84"
msgid ""
"The power of the Absolute, of course! Priestess Gut will tell you all about "
"Her and get ya branded."
msgstr "당연히 절대자의 힘이지! 여사제 거트께서 절대자님에 관해 모든 걸 알려주고 낙인도 찍어 주실 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin
#. Speaker = Sazza
#. NodeID = feccac4d-6e83-9c6a-ab6d-ecbc89bf32e0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin:feccac4d-6e83-9c6a-ab6d-ecbc89bf32e0
msgctxt "hc46f770fg373cg473cga45fg2eebc26ee27d"
msgid ""
"Help me escape, an' I'll tell my tribe to leave ya alone when they murder "
"this place."
msgstr "탈출하는 거 도와주면, 부족한테 여기 박살 낼 때 넌 놔두라고 일러둘게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin_AD
#. Speaker = Sazza
#. NodeID = 03285a55-6df3-774d-cc82-2ae4a66aa6ca
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_CapturedGoblin_State_Released = False
#.   Local:
#.      - c3ff3724-a314-5d3c-a1aa-bac8a62dd4a6_B = True
#.      - c3ff3724-a314-5d3c-a1aa-bac8a62dd4a6_C = True
#.      - c3ff3724-a314-5d3c-a1aa-bac8a62dd4a6_A = True
#. SetFlags:
#.   Local:
#.     - c3ff3724-a314-5d3c-a1aa-bac8a62dd4a6_B = False
#.     - c3ff3724-a314-5d3c-a1aa-bac8a62dd4a6_C = False
#.     - c3ff3724-a314-5d3c-a1aa-bac8a62dd4a6_A = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin_AD:03285a55-6df3-774d-cc82-2ae4a66aa6ca
msgctxt "h8e8840deg264cg4230g9899gbc6146869bce"
msgid "Let me out, ya bunch of softies!"
msgstr "날 꺼내줘, 나약한 것들아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin_AD
#. Speaker = Sazza
#. NodeID = 1545e9ed-ba4d-a80e-b950-270eed8d8ea2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_CapturedGoblin_State_Released = False
#.   Local:
#.      - c3ff3724-a314-5d3c-a1aa-bac8a62dd4a6_B = False
#.      - c3ff3724-a314-5d3c-a1aa-bac8a62dd4a6_C = False
#.      - c3ff3724-a314-5d3c-a1aa-bac8a62dd4a6_A = False
#. SetFlags:
#.   Local:
#.     - c3ff3724-a314-5d3c-a1aa-bac8a62dd4a6_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin_AD:1545e9ed-ba4d-a80e-b950-270eed8d8ea2
msgctxt "hdc6442cfg4d18g4bf9g8cedgc1a408d0339b"
msgid "Yer gonna be sorry. Every last one of ya!"
msgstr "후회하게 될 거다. 너네 전부 다 말야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin_AD
#. Speaker = Sazza
#. NodeID = 31965661-b408-b966-ee2d-0896ac5dd882
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin_AD:31965661-b408-b966-ee2d-0896ac5dd882
msgctxt "h2385a54ag4170g4fa4gb995g68a8e6ccea8e"
msgid "I'll repay ya for the favour, 'ave no doubt."
msgstr "은혜는 꼭 갚을게, 두고 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin_AD
#. Speaker = Sazza
#. NodeID = 546a56b5-cd16-d992-9189-8a53c41ce9dd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_CapturedGoblin_State_Released = False
#.   Local:
#.      - c3ff3724-a314-5d3c-a1aa-bac8a62dd4a6_B = False
#.      - c3ff3724-a314-5d3c-a1aa-bac8a62dd4a6_C = False
#.      - c3ff3724-a314-5d3c-a1aa-bac8a62dd4a6_A = True
#. SetFlags:
#.   Local:
#.     - c3ff3724-a314-5d3c-a1aa-bac8a62dd4a6_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin_AD:546a56b5-cd16-d992-9189-8a53c41ce9dd
msgctxt "hbca9f648gd2eeg4cb4g91a9g697fd3a049c9"
msgid "You tiefs are all borin'! Even yer <i>cages</i> are borin'!"
msgstr "너네 티프들 모두 지루해! <i>우리</i> 조차도 지루하다고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin_AD
#. Speaker = Sazza
#. NodeID = 92683670-278a-c48f-b477-621b5a72eef1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin_AD:92683670-278a-c48f-b477-621b5a72eef1
msgctxt "h2fd34393gb7adg4275g98e3gd03e33d05cbe"
msgid "Bloody tiefs everywhere."
msgstr "망할 티플링 놈들 천지구먼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin_AD
#. Speaker = Sazza
#. NodeID = b1bc44d0-1343-d69b-1622-01d21ec4cba2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_CapturedGoblin_State_LeftDen = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin_AD:b1bc44d0-1343-d69b-1622-01d21ec4cba2
msgctxt "h9be5158eg823eg45c4ga0c0gfc8a309fc8a7"
msgid "Ah, feels good to be free."
msgstr "아, 자유로워지니 기분 좋네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin_AD
#. Speaker = Sazza
#. NodeID = d2a5d1a8-8740-a504-0844-b75c0727a147
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_CapturedGoblin_State_Released = False
#.   Local:
#.      - c3ff3724-a314-5d3c-a1aa-bac8a62dd4a6_B = True
#.      - c3ff3724-a314-5d3c-a1aa-bac8a62dd4a6_C = False
#.      - c3ff3724-a314-5d3c-a1aa-bac8a62dd4a6_A = True
#. SetFlags:
#.   Local:
#.     - c3ff3724-a314-5d3c-a1aa-bac8a62dd4a6_C = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin_AD:d2a5d1a8-8740-a504-0844-b75c0727a147
msgctxt "hb771f38eg066ag46c1gbb3dgf24ccecc218b"
msgid "I'm gonna bite the 'eads off yer kids. An' yer birdies. An' yer dogs!"
msgstr "네 애새끼들의 대가리를 뜯어버리겠어. 새새끼들도. 개새끼들도!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin_AD_Guards
#. Speaker = Memnos
#. NodeID = 002df32d-55f1-49d7-0664-5f50541d6463
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin_AD_Guards:002df32d-55f1-49d7-0664-5f50541d6463
msgctxt "h5c40be80g6bd3g4495g9c1agd27de7629ff7"
msgid "Arka, no."
msgstr "아르카, 안 돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin_AD_Guards
#. Speaker = Sazza
#. NodeID = 05004601-d94e-3763-239d-0698f1e01229
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin_AD_Guards:05004601-d94e-3763-239d-0698f1e01229
msgctxt "h22cd0fa5ge761g4b25gaa68g152091fa7b7f"
msgid "Stop talking an' shoot me. If you even can."
msgstr "그만 지껄이고 쏴 보셔. 그럴 깜냥이나 있냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin_AD_Guards
#. Speaker = Arka
#. NodeID = 0b6751fe-9ec8-9754-65b3-e846981c98c4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_CapturedGoblin_State_InTransit = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin_AD_Guards:0b6751fe-9ec8-9754-65b3-e846981c98c4
msgctxt "hcb349862gfb5bg4da5g91f2ga0a549036de4"
msgid "That bloody goblin..."
msgstr "그 망할 고블린..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin_AD_Guards
#. Speaker = Arka
#. NodeID = 0ef83edf-c75f-7516-0fba-2d0c147fe48b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_CapturedGoblin_Event_GuardsStayed = True
#. SetFlags:
#.   Local:
#.     - 9d5fb485-8f36-c21b-52d1-c92a1ce047de_Local_Idle_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin_AD_Guards:0ef83edf-c75f-7516-0fba-2d0c147fe48b
msgctxt "h9b77a975g8e90g43f4g997cg27896e501317"
msgid "I wonder when the goblins will come."
msgstr "고블린 놈들이 언제 또 오려나 궁금하네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin_AD_Guards
#. Speaker = Arka
#. NodeID = 1e9d091f-56d9-ce2d-decd-4ceaec0dee25
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin_AD_Guards:1e9d091f-56d9-ce2d-decd-4ceaec0dee25
msgctxt "h0ea5e3e1g9011g4669ga212g650dd6bd6045"
msgid "Kanon didn't deserve this."
msgstr "카논은 그리 죽어선 안 됐어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin_AD_Guards
#. Speaker = Arka
#. NodeID = 25a9e56b-2824-ac5f-6d54-ee21d086909c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_CapturedGoblin_State_LeftPrison = False
#.      - DEN_CapturedGoblin_Event_Foiled = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin_AD_Guards:25a9e56b-2824-ac5f-6d54-ee21d086909c
msgctxt "hb2f84c19g7387g43adga8b4g646aa45b2a68"
msgid "Someone got to her first. Damn it."
msgstr "누가 이년을 먼저 죽였군. 망할."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin_AD_Guards
#. Speaker = Arka
#. NodeID = 471ed060-6d4d-db5c-565b-e16dac24e52d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin_AD_Guards:471ed060-6d4d-db5c-565b-e16dac24e52d
msgctxt "h0bb9a7beg2c87g4987ga8ccg4a92a2098767"
msgid "No! Get up, Kanon!"
msgstr "안 돼! 일어나, 카논!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin_AD_Guards
#. Speaker = Arka
#. NodeID = 4c4d8ed8-4317-e6f8-02c3-353c31a23924
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin_AD_Guards:4c4d8ed8-4317-e6f8-02c3-353c31a23924
msgctxt "hdb926d1dg22eag43fagbb5cga46077a39c69"
msgid "I could use some target practice."
msgstr "표적 연습 거리가 필요하니까 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin_AD_Guards
#. Speaker = Arka
#. NodeID = 57212b07-ce1d-0903-8b75-3d95f250688b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_CapturedGoblin_State_Avenge = True
#.      - DEN_CapturedGoblin_State_AvengeReady = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin_AD_Guards:57212b07-ce1d-0903-8b75-3d95f250688b
msgctxt "h8d199ee4g80aeg40a6gb6c5g3dca5ac90936"
msgid "You don't deserve to live."
msgstr "너 같은 건 살 자격 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin_AD_Guards
#. Speaker = Memnos
#. NodeID = 5d5b3ee3-20e6-a2f3-b079-4fe739da44ef
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin_AD_Guards:5d5b3ee3-20e6-a2f3-b079-4fe739da44ef
msgctxt "h09359e9fgd2d3g4729g8e77g0431135abcee"
msgid "Arka, no."
msgstr "아르카, 안 돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin_AD_Guards
#. Speaker = Arka
#. NodeID = 60e86161-c338-4db9-20eb-414e60e6cab7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_CapturedGoblin_Event_GoblinShot = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin_AD_Guards:60e86161-c338-4db9-20eb-414e60e6cab7
msgctxt "h2432e022g3cf0g4d33gba0bg0a6d2b4b1ab6"
msgid "Shut up!"
msgstr "닥쳐!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin_AD_Guards
#. Speaker = Memnos
#. NodeID = 6a71558f-d9d4-d63e-9ff8-bfc959803b7a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin_AD_Guards:6a71558f-d9d4-d63e-9ff8-bfc959803b7a
msgctxt "h1d7d7317g5d91g4cf9ga379gf0c014224223"
msgid "You say that like you're looking forward to it."
msgstr "꼭 그렇게 되길 기대한다는 것처럼 들리는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_CapturedGoblin_AD_Guards
#. Speaker = Arka
#. NodeID = 6f178d0d-0ed2-68c7-d477-5810eaf8dc68
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
