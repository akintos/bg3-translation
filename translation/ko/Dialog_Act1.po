#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#.   Tag:
#.      - REALLY_ASTARION(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter_Dead:b1b98b9b-96dc-0e99-7760-bc56c6318211
msgctxt "h635fb8c2g336cg449dgb74eg2c0681e5ba17"
msgid "Who sent you? Was it Cazador?"
msgstr "누가 너를 보냈지? 카사도어가 보냈나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter_Dead
#. Speaker = Gandrel
#. NodeID = b3ea0041-c42d-3269-cee3-c6570d6d4a09
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter_Dead:b3ea0041-c42d-3269-cee3-c6570d6d4a09
msgctxt "h999d4044ga065g4ec8g825dg6dcd0634bd1c"
msgid "Gandrel... hunter..."
msgstr "간드렐... 사냥꾼..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter_Dead
#. Speaker = Player
#. NodeID = be982296-5649-8708-3bc4-5420fd193797
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_GurHunter_State_MentionedAstarion = True
#.      - ORI_Astarion_HasMet = False
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#.   Tag:
#.      - REALLY_ASTARION(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter_Dead:be982296-5649-8708-3bc4-5420fd193797
msgctxt "h5df2dd07gbdb6g4971ga7b7g2e3b5730ebbb"
msgid "What's your business with this Astarion?"
msgstr "이 아스타리온이라는 자와 무슨 볼일이 있었지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter_Dead
#. Speaker = Gandrel
#. NodeID = c4abdbc4-7e13-a531-e080-85bf7773ab83
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAG_GurHunter_Dead_KnowsUnblemished = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter_Dead:c4abdbc4-7e13-a531-e080-85bf7773ab83
msgctxt "h5aaeb189gad0dg400agb62agd23bbf3f6a21"
msgid "Our children... he knows... where they are..."
msgstr "우리의 아이들... 그가 알아... 어디에 있는지..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter_Dead
#. Speaker = Player
#. NodeID = d46efcb4-618a-174b-68f6-b38477204363
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_GurHunter_Dead_Knows_Hunter = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter_Dead:d46efcb4-618a-174b-68f6-b38477204363
msgctxt "h5621474bgc2e4g45dcga8c6g6127934c7fa0"
msgid "What are you hunting?"
msgstr "무엇을 사냥하고 있던 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter_Dead
#. Speaker = Gandrel
#. NodeID = dc87ff38-d56d-dfda-426e-1cc4415e102c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAG_GurHunter_Dead_KnowsUnblemished = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter_Dead:dc87ff38-d56d-dfda-426e-1cc4415e102c
msgctxt "h34685961g10e7g48cbgb12ag6962bf63e818"
msgid "Our children... you know... where they are..."
msgstr "우리 아이들... 어디 있는지... 넌 알고 있어..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter_Dead
#. Speaker = Gandrel
#. NodeID = e4bfe054-afc7-9c63-531e-09537652e993
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAG_GurHunter_Astarion_Knows_WiseWoman = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter_Dead:e4bfe054-afc7-9c63-531e-09537652e993
msgctxt "h6785b4a7g3c3eg4fcfg8232geec56fc9ab30"
msgid "Wise... woman... questions..."
msgstr "현명한... 여인... 질문을..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter_Dead
#. Speaker = Player
#. NodeID = f1469bf6-19ad-8d30-d4e1-b8c613effce3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter_Dead:f1469bf6-19ad-8d30-d4e1-b8c613effce3
msgctxt "hcc533b1fg9141g473cg9b7aga201093a2d35"
msgid "What brought you to this place?"
msgstr "이 곳에는 왜 온 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter_Dead
#. Speaker = Player
#. NodeID = f18769ba-a48c-d75f-9ee8-1bc7b1de0988
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_GurHunter_State_MentionedAstarion = True
#.      - ORI_Astarion_HasMet = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#.   Tag:
#.      - REALLY_ASTARION(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter_Dead:f18769ba-a48c-d75f-9ee8-1bc7b1de0988
msgctxt "h55e7a681g5d33g4ff2g8d48g8b06fb3aa308"
msgid "What's your business with Astarion?"
msgstr "아스타리온에게 무슨 볼일이 있던 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_HagAmbush_AD_Argument
#. Speaker = Demir
#. NodeID = 1a8f2a13-6fd4-754a-d751-f0de968be7e9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 44846287-38a3-5421-71dc-505f64479e78_Node1 = False
#.      - 44846287-38a3-5421-71dc-505f64479e78_Node2 = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_HagAmbush_AD_Argument:1a8f2a13-6fd4-754a-d751-f0de968be7e9
msgctxt "h9cf3efd6g27f3g403egaf10g8005a54d05d7"
msgid "She went to see you. We <i>know </i>she did."
msgstr "마지막으로 당신을 보러 갔지. 뭐 때문인지 다 <i>안다고</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_HagAmbush_AD_Argument
#. Speaker = Johl
#. NodeID = 23d24e7a-5b7e-cef6-a46d-3d9560eca7a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_HagAmbush_AD_Argument:23d24e7a-5b7e-cef6-a46d-3d9560eca7a8
msgctxt "hf3ad09aag6c7fg4baag8e23ga7e39b8fa51e"
msgid "<i>Enough. </i>We know you have her."
msgstr "<i>그만.</i> 우린 네가 동생을 데리고 있단걸 알고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_HagAmbush_AD_Argument
#. Speaker = Johl
#. NodeID = 2543dc59-0850-b76b-6236-1d9a4f3a1e99
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 44846287-38a3-5421-71dc-505f64479e78_Node1 = False
#.     - 44846287-38a3-5421-71dc-505f64479e78_Node2 = False
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_HagAmbush_AD_Argument:2543dc59-0850-b76b-6236-1d9a4f3a1e99
msgctxt "hec053f30g8c09g44a4gb1cfgff7aca28d722"
msgid "Drop the act!"
msgstr "시치미 떼지 마!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_HagAmbush_AD_Argument
#. Speaker = Auntie Ethel
#. NodeID = 534b2b59-b91b-dc7f-9ba0-42c857a2c314
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_HagAmbush_AD_Argument:534b2b59-b91b-dc7f-9ba0-42c857a2c314
msgctxt "h95b001b4g3dabg448fg9849ge23bc356e3b1"
msgid "You know absolutely nothing, you eejit."
msgstr "넌 아무것도 몰라, 이 멍청아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_HagAmbush_AD_Argument
#. Speaker = Demir
#. NodeID = 5646b37d-e651-f0e5-d0c2-1fd180cc3d9d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_HagAmbush_AD_Argument:5646b37d-e651-f0e5-d0c2-1fd180cc3d9d
msgctxt "h3e18ee74g076eg43d9ga0afg0ce39238cdce"
msgid "Just tell us where she is. We don't want any trouble."
msgstr "어디 있는지만 말해주세요. 곤란한 일 만들지 말고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_HagAmbush_AD_Argument
#. Speaker = Auntie Ethel
#. NodeID = 6d0fcabc-39ad-25a0-9705-192c7172a609
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 44846287-38a3-5421-71dc-505f64479e78_Node1 = True
#.      - 44846287-38a3-5421-71dc-505f64479e78_Node2 = False
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_HagAmbush_AD_Argument:6d0fcabc-39ad-25a0-9705-192c7172a609
msgctxt "h407ef2begf352g4406g9732g31d1ae3ebd11"
msgid "Do you harass every old woman you meet?"
msgstr "평소에도 이렇게 힘도 없는 할미를 괴롭히고 다니니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_HagAmbush_AD_Argument
#. Speaker = Auntie Ethel
#. NodeID = c82f1d09-9b4a-1805-e230-4f850d8c42e7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 44846287-38a3-5421-71dc-505f64479e78_Node1 = False
#.      - 44846287-38a3-5421-71dc-505f64479e78_Node2 = False
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_HagAmbush_AD_Argument:c82f1d09-9b4a-1805-e230-4f850d8c42e7
msgctxt "h48b77d8cg834eg4b0cg92e4g76ce2e3346be"
msgid "You're both <i>this</i> close to getting a slap."
msgstr "너희 둘 다 <i>한 발짝</i>만 더 오면 뺨 맞을 줄 알아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_HagAmbush_AD_Argument
#. Speaker = Johl
#. NodeID = d19d47bc-5d82-9a02-6ec3-8d14ce87fd4e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 44846287-38a3-5421-71dc-505f64479e78_Node1 = False
#.     - 44846287-38a3-5421-71dc-505f64479e78_Node2 = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_HagAmbush_AD_Argument:d19d47bc-5d82-9a02-6ec3-8d14ce87fd4e
msgctxt "h9cb46257g540eg42d0g9ae1gdf4395abe850"
msgid "But you're bloody getting some if you don't 'fess up."
msgstr "하지만 자백하지 않으면 피 좀 보게 될 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_HagAmbush_AD_Argument
#. Speaker = Demir
#. NodeID = e0cb0f4d-892b-0d9a-a9d5-4a1050d30404
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 44846287-38a3-5421-71dc-505f64479e78_Node1 = True
#.     - 44846287-38a3-5421-71dc-505f64479e78_Node2 = False
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_HagAmbush_AD_Argument:e0cb0f4d-892b-0d9a-a9d5-4a1050d30404
msgctxt "hf17626d3g85f8g43cfgbc86g319a54cc221f"
msgid "Please, we just want Mayrina back."
msgstr "제발, 우린 그저 메이리나가 돌아오기만을 원해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_HagAmbush_AD_HagDisappear
#. Speaker = Auntie Ethel
#. NodeID = 3057bb67-858d-df9d-020b-df395bebb4c3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_HagAmbush_AD_HagDisappear:3057bb67-858d-df9d-020b-df395bebb4c3
msgctxt "hd8a6e07fg7174g4ad7g9adeg80b594ff650e"
msgid "Bye-bye, my lovelies!"
msgstr "안녕히, 이쁜이들아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_HagAmbush_AD_HagThankPlayer
#. Speaker = Auntie Ethel
#. NodeID = ae614908-4919-4d6d-8b2d-1302c22c3e14
