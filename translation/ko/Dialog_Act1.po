msgctxt "h2c6e9613ga09bg4424g9715g8a882694ef05"
msgid "Is that so? Then his efficiency is to be commended. As is  yours. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointWarning
#. Speaker = Player
#. NodeID = fdfebe00-42e0-3d08-b8b9-36d4622bc906
