msgid "Not a chance."
msgstr "어림 없지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Narrator
#. NodeID = 4e0d71be-c1a3-dcff-d2ba-61bd666392ad
