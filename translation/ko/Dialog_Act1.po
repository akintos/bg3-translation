#, fuzzy
msgctxt "hc5f433b3g6562g4e30gb10ag261cae5395f6"
msgid "<i>Aggeniculamur in umbra tua, Pater Arborum.</i>"
msgstr "<i>아제네쿨라무르 인 움브라 투아, 파테르 아르보룸.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_RitualDruid5
#. Speaker = Tahan
#. NodeID = 563079cc-a5f3-f1ad-9898-ba8a4c0b1d67
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_SacredPond_Event_RitualChantE = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_RitualDruid5:563079cc-a5f3-f1ad-9898-ba8a4c0b1d67
#, fuzzy
msgctxt "h5533b7acg134fg4243gb55fgd41ff215a7a2"
msgid "<i>In umbram cretus, sanguine iuratus.</i>"
msgstr "<i>인 움브람 크레투스, 상귀네 이우라투스.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_RitualDruid5
#. Speaker = Tahan
#. NodeID = 70f0e717-9ed2-23ba-2cbd-8c6dc90fb262
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_SacredPond_Event_RitualChantA = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_RitualDruid5:70f0e717-9ed2-23ba-2cbd-8c6dc90fb262
msgctxt "he905be13g4ef6g4b3fgadabg4b1f56ff9db7"
msgid "<i>Hostes subeunt. Protege nos. Muni nos.</i>"
msgstr "<i>호스테스 수베운트. 프로테제 노스. 무니 노스.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_RitualDruid5
#. Speaker = Tahan
#. NodeID = 720db670-a14e-256a-8517-dac8dc7a82d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_RitualDruid5:720db670-a14e-256a-8517-dac8dc7a82d0
msgctxt "hc11be85cgaf7cg4264g9839g66df774bd08f"
msgid "Sooner or later, other outsiders will bring trouble to the grove."
msgstr "조만간 또 다른 외부인들이 이 숲에 문제를 불러올 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_RitualDruid5
#. Speaker = Tahan
#. NodeID = 9f869784-6ddc-b41b-c884-08be8ecfdb98
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_RitualDruid_HasMet_Left5(1) = False
#.   Global:
#.      - DEN_Refugees_State_LeadersAreDead = True
#. SetFlags:
#.   Dialog:
#.     - DEN_RitualDruid_HasMet_Left5(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_RitualDruid5:9f869784-6ddc-b41b-c884-08be8ecfdb98
msgctxt "hd1a6f5f5g8894g49d4g83f9g7433c7561541"
msgid "You think you saved us? You just prolonged the inevitable."
msgstr "당신이 우릴 구했다고 생각해? 당신은 그저 피할 수 없는 운명을 미뤘을 뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_RitualDruid5
#. Speaker = Tahan
#. NodeID = a6f6e4fa-55e0-899a-bae4-811fd8b0c593
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_RitualDruid5:a6f6e4fa-55e0-899a-bae4-811fd8b0c593
msgctxt "h98c6a1ccgac1bg4864gaca3g28eb9c49215e"
msgid "You had no right to intervene. You're not one of us."
msgstr "당신이 간섭할 권리는 없었어. 우리 일원도 아니면서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_RitualDruid5
#. Speaker = Tahan
#. NodeID = bcc54734-dc49-9ae6-978f-e533d6806416
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_RitualDruid_HasMet_Pacified5(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_RitualDruid5:bcc54734-dc49-9ae6-978f-e533d6806416
msgctxt "he289e910g278bg4d70g843ag4f9be91e6eb9"
msgid "I've got nothing to say to you, outsider."
msgstr "당신에게 할 말은 없습니다, 이방인이여."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_RitualDruid5
#. Speaker = Tahan
#. NodeID = bfb2bf2e-1d2b-5d23-4bdf-f641778f5551
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
