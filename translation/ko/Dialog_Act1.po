msgctxt "h82f59713gb9ecg4e70g8907gcf17722afd35"
msgid "Who are you?"
msgstr "넌 누구지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_General_Dead_SnakeKid
#. Speaker = Arabella
#. NodeID = e0f38908-d0bd-4322-8089-817c8e413195
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_General_Dead_SnakeKid:e0f38908-d0bd-4322-8089-817c8e413195
msgctxt "h61d912bbg8655g4b70gb0c5g07079b84928f"
