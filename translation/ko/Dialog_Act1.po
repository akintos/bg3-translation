msgctxt "hb7271bfcg302bg4b90g85c1g17c35676b42f"
msgid "An <i>istik</i> allowed to soil our halls? <i>Chk</i>."
msgstr "<i>이스틱</i>이 우리의 회랑을 더럽힌다고? <i>쳇</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_CaptainGuard
#. Speaker = Raider Chy'raagh
#. NodeID = 85ce797a-9096-cc3d-04c3-bc28995a7bfd
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
