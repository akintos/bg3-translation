msgctxt "hbf203995ge255g4b4dg887fgcdcaaefac6c9"
msgid "Where you, chicken?"
msgstr "어디 있니, 닭아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_Ogre_00
#. Speaker = Guard Gurgon
#. NodeID = 430ebe40-eadb-8ffe-18b2-398b482cd423
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
