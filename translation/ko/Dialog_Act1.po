msgctxt "h1f704e2cg0d73g460dg8d81g7dcb25c1c1f5"
msgid "You're coming with me, 'fore... Oh! Looks like I've got company."
msgstr "넌 나랑 간다, 이... 아! 손님이 나타난 모양이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene
#. Speaker = Nymessa
#. NodeID = e678917a-580b-3de6-7069-daf103be54b5
