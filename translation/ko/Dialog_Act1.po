#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:b9eed68c-7aaa-4389-ae89-613bbe9f7d27
msgctxt "h9fe42bddg6574g4ce3g8bd1ga4f639bb9ba2"
msgid "Mind the True Soul. He will - he - he..."
msgstr "참된 영혼을 따라라. 그가... 그... 그가..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Edowin
#. NodeID = b9eed68c-7aaa-4389-ae89-613bbe9f7d27
