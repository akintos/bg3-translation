msgctxt "h2f7b8523g06c5g477bg8801g3ba483146af1"
msgid "*Belch.*"
msgstr "*꺼억.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Brewery_AD_DrunkCheering
#. Speaker = Kobold Looter
#. NodeID = 8b2eed2c-df1a-466d-b0d0-5980c6cda564
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Brewery_AD_DrunkCheering:8b2eed2c-df1a-466d-b0d0-5980c6cda564
msgctxt "h0b1ddbf2g07f4g443ag8e78gd36831642c70"
msgid "Pints of <i>wine</i>, Baz. Pints. Of. Wine."
msgstr "많은 <i>와인</i>이라고, 바즈. 많은. 와인."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Brewery_AD_DrunkCheering
#. Speaker = Kobold Scout
#. NodeID = ab92c4b4-58c6-491c-bbb6-1cef9ada5853
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Brewery_AD_DrunkCheering:ab92c4b4-58c6-491c-bbb6-1cef9ada5853
msgctxt "h6c0d1421g1cf1g44d3g94fcg0072e1c31ee6"
msgid "That was a fiery one, mate - nearly singed my pits!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Brewery_AD_DrunkCheering
#. Speaker = Kobold Looter
#. NodeID = c953a3b3-6aec-497c-84fa-08aef033e74c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Brewery_AD_DrunkCheering:c953a3b3-6aec-497c-84fa-08aef033e74c
msgctxt "h5591dbeag53e9g4579g9bf4g6c9a76f1fc81"
msgid "Wine's evil Baz, it's <i>evil</i>. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Brewery_AD_DrunkCheering
#. Speaker = Kobold Scout
#. NodeID = cef41356-4c7f-4219-956b-fe0e470f8029
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Brewery_AD_DrunkCheering:cef41356-4c7f-4219-956b-fe0e470f8029
msgctxt "h75783f14gbcf3g45f3ga9a9g035cf8bb4a67"
msgid "Come on, Kev... Know what'll cheer you up?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Brewery_AD_DrunkCheering
#. Speaker = Kobold Scout
#. NodeID = da028b8c-558c-4f06-99b0-ebcdd1183538
