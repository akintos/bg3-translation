#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HookHorror_Hermit_Dead:2b78b03c-b395-439a-a0d6-661b3531d794
msgctxt "h0fe794fega682g41f2g85dfg9b510fc554c8"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HookHorror_Hermit_Dead
#. Speaker = Player
#. NodeID = 3724a441-6fb3-3bd9-ddf9-ed312ac3b24f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_HookHorrorDrowDead_State_MentionedForge = False
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HookHorror_Hermit_Dead:3724a441-6fb3-3bd9-ddf9-ed312ac3b24f
msgctxt "h8562d074g79f1g49eag96c1g61b266710a92"
msgid "How did you come to be here?"
msgstr "어쩌다 여기에 왔지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HookHorror_Hermit_Dead
#. Speaker = Player
#. NodeID = 4aebbe2a-a3f2-7f6e-31ee-01564934ec54
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HookHorror_Hermit_Dead:4aebbe2a-a3f2-7f6e-31ee-01564934ec54
msgctxt "hda5ef1f8g6605g4c60ga42dg5253cacfa67c"
msgid "The glowing tree - what is it?"
msgstr "빛나는 나무는 뭐지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HookHorror_Hermit_Dead
#. Speaker = Filro the Forgotten
#. NodeID = 51ca251d-6194-f73d-65ac-15708d27ca5b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_HookHorrorDrowDead_State_MentionedForge = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HookHorror_Hermit_Dead:51ca251d-6194-f73d-65ac-15708d27ca5b
msgctxt "hb7257827gbffeg4578g8d69g53e521452335"
msgid "Chasing... mystery...  riddle... <i>lie</i>... the Adamantine Forge..."
msgstr "신비를... 쫓았어... 수수께끼... <i>거짓말</i>... 아다만틴 대장간..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HookHorror_Hermit_Dead
#. Speaker = Player
#. NodeID = 5322e37a-0325-18c3-663d-009f8f340875
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - ec5a6a29-18c8-62d7-4036-5f669d4508f9_MentionedOthers = True
#.      - ec5a6a29-18c8-62d7-4036-5f669d4508f9_ExplainedOthers = False
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HookHorror_Hermit_Dead:5322e37a-0325-18c3-663d-009f8f340875
msgctxt "hc86e3d29g991fg4645g97bfgdb1c9202a0f3"
msgid "What others?"
msgstr "남들이 누군데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HookHorror_Hermit_Dead
#. Speaker = Filro the Forgotten
#. NodeID = 53dab6a4-1a9d-b817-c8b5-0ea7d4fa858b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - ec5a6a29-18c8-62d7-4036-5f669d4508f9_MentionedOthers = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HookHorror_Hermit_Dead:53dab6a4-1a9d-b817-c8b5-0ea7d4fa858b
msgctxt "hd88514dag69d7g4f92ga739gb455944001df"
msgid "It... stills the Weave... protects me from... the others..."
msgstr "위브를... 가라앉혀... 남들에게서... 나를 지켜줘..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HookHorror_Hermit_Dead
#. Speaker = Filro the Forgotten
#. NodeID = 620f891b-8f23-2686-cda6-47e06796d677
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HookHorror_Hermit_Dead:620f891b-8f23-2686-cda6-47e06796d677
msgctxt "h8885af6bg878bg4ddfgb11cg408ae7062b96"
msgid "... I... I <i>obey</i>..."
msgstr "... 나...나는 <i>복종해</i>..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HookHorror_Hermit_Dead
#. Speaker = Filro the Forgotten
#. NodeID = 6ad7275b-bb3a-f708-3fab-1d80dd68bc79
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HookHorror_Hermit_Dead:6ad7275b-bb3a-f708-3fab-1d80dd68bc79
msgctxt "h66e0c3fdg3358g4bc2g9a98g5fcfdd896d8f"
msgid "Yes... so beautiful..."
msgstr "그래... 너무나 아름다워..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HookHorror_Hermit_Dead
#. Speaker = Player
#. NodeID = 82962f6d-ff92-dfd3-563b-53b6b8a72f79
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. TagRule: SORCERER or WARLOCK
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HookHorror_Hermit_Dead:82962f6d-ff92-dfd3-563b-53b6b8a72f79
msgctxt "h7d75eb90g05cfg453egb7fagf935e704116a"
msgid "You are in my power. I do not ask, I <i>command.</i>"
msgstr "너는 내 힘 아래에 있다. 나는 부탁하는 게 아니고, <i>명령한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HookHorror_Hermit_Dead
#. Speaker = Narrator
#. NodeID = 836157da-1eab-a006-3d6e-f33a932373b5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_HookHorrorDrowDead_State_RecognizedKiller(1) = True
#.   Object:
#.      - GLO_SpeakWithDead_State_Killer(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HookHorror_Hermit_Dead:836157da-1eab-a006-3d6e-f33a932373b5
msgctxt "h5a910b70g77b2g4e3ag973fg1e4939b59e22"
msgid "*The corpse seems willing to speak - but not to its killer.*"
msgstr "*시체는 말할 의지가 있지만, 자신을 죽인 자와 대화하고 싶지는 않은 듯 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HookHorror_Hermit_Dead
#. Speaker = Player
#. NodeID = 8cd64365-282d-f6f6-cb02-5ca18c6e7a33
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. TagRule: CLERIC_KELEMVOR or PALADIN_KELEMVOR
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HookHorror_Hermit_Dead:8cd64365-282d-f6f6-cb02-5ca18c6e7a33
msgctxt "ha3c6f05fg8e3fg46bdgb5degf00aad9392bb"
msgid "If you wish to see your beloved in the afterlife, I can smooth the way."
msgstr "사후세계에서 네가 사랑하는 사람들을 보고 싶은 거라면, 내가 도와줄 수 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HookHorror_Hermit_Dead
#. Speaker = Filro the Forgotten
#. NodeID = 923bb883-882f-b9f8-cffc-7dc58c65df6a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - ec5a6a29-18c8-62d7-4036-5f669d4508f9_ExplainedOthers = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HookHorror_Hermit_Dead:923bb883-882f-b9f8-cffc-7dc58c65df6a
msgctxt "h7d6755d1gffe2g4b1bg8341gaad931a65ab9"
msgid "Three seek... Adamantine Forge... only one of us... may <i>find</i>..."
msgstr "세 명이 찾아... 아다만틴 대장간... 우리 중 하나만이... <i>찾을</i>지도..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HookHorror_Hermit_Dead
#. Speaker = Filro the Forgotten
#. NodeID = a1769628-cba8-45bf-9499-d35910cce971
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HookHorror_Hermit_Dead:a1769628-cba8-45bf-9499-d35910cce971
msgctxt "h79dd7b65g4794g441fg8a3egf5de95528b9f"
msgid "Protector... of the Adamantine Forge..."
msgstr "아다만틴 대장간의... 수호자..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HookHorror_Hermit_Dead
#. Speaker = Filro the Forgotten
#. NodeID = a1a11142-b47b-f02c-a5a6-dbfdd81aa666
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_AdamantineForge_Knows_WhatForgeIs = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HookHorror_Hermit_Dead:a1a11142-b47b-f02c-a5a6-dbfdd81aa666
msgctxt "h32aa39f4gfcfcg4fa6g8066ga0129e449a00"
msgid "Workshop... of great Silouv... Yali..."
msgstr "위대한 실루브... 얄리의... 작업장에서..."

