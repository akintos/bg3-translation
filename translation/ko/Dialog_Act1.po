msgctxt "h280cb5b7g3679g4688g83a2gee8ba66d3aee"
msgid "Hello? Over here!"
msgstr "저기? 여기 좀 봐!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AstarionRecruitment_Recruitment_AD
#. Speaker = Astarion
#. NodeID = c0abbcf5-6fee-3baf-fb58-70e614774edf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3b911555-52e5-7791-d2ac-44fe62465fa1_Loop2 = False
#.      - 3b911555-52e5-7791-d2ac-44fe62465fa1_Loop1 = False
#.      - 3b911555-52e5-7791-d2ac-44fe62465fa1_Loop3 = False
#. SetFlags:
#.   Local:
#.     - 3b911555-52e5-7791-d2ac-44fe62465fa1_Loop2 = False
#.     - 3b911555-52e5-7791-d2ac-44fe62465fa1_Loop1 = True
#.     - 3b911555-52e5-7791-d2ac-44fe62465fa1_Loop3 = False
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AstarionRecruitment_Recruitment_AD:c0abbcf5-6fee-3baf-fb58-70e614774edf
msgctxt "hb02485f4g3314g42cdgac92g260e46de3f00"
msgid "You there! Come here - I need help."
msgstr "거기! 이리 와 봐. 도움이 필요해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Narrator
#. NodeID = 02f2660e-fdcd-c1a8-085a-7507e705ebee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:02f2660e-fdcd-c1a8-085a-7507e705ebee
msgctxt "h0e6fad68g076dg4896ga430g124ad514bd8e"
msgid "*But it'll all be for nothing if you don't find help soon.*"
msgstr "*빨리 도움을 받지 못하면 전부 부질없게 될 테지만 말입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Narrator
#. NodeID = 096d2abd-36e7-ecdb-510f-611e6d08c641
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:096d2abd-36e7-ecdb-510f-611e6d08c641
msgctxt "hf7c4fd94g13a3g4c91ga8cege869916e685d"
msgid "*What delicacies might abound? Only one way to find out...*"
msgstr "*어떤 맛난 먹잇감들이 있을까요? 알아볼 방법은 하나뿐이겠죠...*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Narrator
#. NodeID = 0ad82895-46bc-e528-4134-c394c25c20e0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:0ad82895-46bc-e528-4134-c394c25c20e0
msgctxt "h99ed6fc4g7576g43f8g9899g53558b1a237e"
msgid ""
"*The chaos of the crash site confuses the landscape. You'll need to find a "
"settlement or landmark.*"
msgstr "*추락의 여파로 원래 풍광을 알아보기가 힘듭니다. 주거지나 랜드마크를 찾아야 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Player
#. NodeID = 0c8cac99-d445-792d-1832-a7833bcd7318
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:0c8cac99-d445-792d-1832-a7833bcd7318
msgctxt "h3b009151g88c6g4068gbb5ag596ea2e7ced4"
msgid "<i>Recall everything you know about illithid tadpoles.</i>"
msgstr "<i>일리시드 올챙이에 관해 알고 있는 모든 걸 떠올려본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Player
#. NodeID = 0d80f086-d6ab-df33-441a-f2e97b705131
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:0d80f086-d6ab-df33-441a-f2e97b705131
msgctxt "h7bf0a2d2gccadg4924g8f23gb36ab56b871f"
msgid "<i>Ponder your miraculous survival.</i>"
msgstr "<i>이 기적적인 생존에 대해 곰곰이 생각해본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Narrator
#. NodeID = 10681791-c4b9-38aa-bef7-7e8fd5ef66ac
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:10681791-c4b9-38aa-bef7-7e8fd5ef66ac
msgctxt "h18937effg0703g4995g99b0gc2e8b6af3b7b"
msgid ""
"*You half-expected your memories to return once you were free of the mind "
"flayer ship, but your past is still an aching void.*"
msgstr "*마인드 플레이어의 함선에서 벗어나면 기억이 돌아올지 모른다고 다소 기대했건만, 과거는 여전히 쓰라린 공허로 메워져 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Narrator
#. NodeID = 10f58a05-1597-3c76-8915-bf563c2714e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:10f58a05-1597-3c76-8915-bf563c2714e7
msgctxt "hf499c6f3g8dceg478eg86bcgd0eb3781a3df"
msgid ""
"*And, of course, you'll be feeding for two now, thanks to your guest. Until "
"it deigns to feast on your brains and split you open to reveal a newborn "
"mind flayer...*"
msgstr ""
"*당연한 얘기지만, 이제 머릿속 손님까지 2인분은 먹어치워야 합니다. 그 손님이 당신의 뇌로 포식하고, 몸을 쪼개 마인드 플레이어로 "
"탈바꾸기 전까진 말이죠...*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Player
#. NodeID = 15370e18-0775-b585-16e8-2c25109ff2cc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:15370e18-0775-b585-16e8-2c25109ff2cc
msgctxt "h71bcf81dge10eg40d5ga41dg11e6fedb2561"
msgid ""
"<i>Forget the parasite and savour the warmth of the sun. You are reborn.</i>"
msgstr "<i>기생충은 잊어버리고 따뜻한 햇빛을 즐긴다. 당신은 다시 태어났다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Player
#. NodeID = 21f41655-d0eb-051e-2649-a272b7acd5aa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:21f41655-d0eb-051e-2649-a272b7acd5aa
msgctxt "hed0d61begf34dg4107gb308g4be1a611c466"
msgid "I did it. I got out."
msgstr "해냈어. 탈출했다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Player
#. NodeID = 2358c742-e36c-3eb1-d44d-a053c4ee1f7e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:2358c742-e36c-3eb1-d44d-a053c4ee1f7e
msgctxt "h6882bcabg3ac5g4fcag9bd1g9bbaeb87148e"
msgid "Forget the hunter. I'm more afraid of the parasite in my head."
msgstr "사냥개는 잊어버리자. 머릿속에 든 기생충 쪽이 더 걱정스럽다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Player
#. NodeID = 25d40554-80af-3a01-9e68-239dc1e6cfe9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:25d40554-80af-3a01-9e68-239dc1e6cfe9
msgctxt "h64183fe1g5c29g45fag8eaega6bcbae1c54c"
msgid ""
"Don't be daft. That parasite will turn me into a mind flayer if I don't find "
"a cure."
msgstr "바보처럼 굴지 마라. 치료법을 찾지 못하면 그 기생충이 날 마인드 플레이어로 바꿔버릴 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Narrator
#. NodeID = 35c521cc-252d-c7f7-cd61-67865aa936b1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GALE(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:35c521cc-252d-c7f7-cd61-67865aa936b1
msgctxt "h17c2317dg2328g4ca5gb8bcg4aaf7cf74a21"
msgid ""
"*Despite your recent fall from the nautiloid, you are miraculously unharmed. "
"Apart from the volatile orb of Netherese magic buried within your chest, of "
"course.*"
msgstr ""
"*방금 막 노틸로이드에서 추락한 것 치곤, 기적적으로 멀쩡합니다. 물론 당신 가슴에 담긴 불안정한 네더릴 마법 보주를 제외하면 말이죠.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Narrator
#. NodeID = 35f39b55-1296-66e9-2d0f-ce378b9c38f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:35f39b55-1296-66e9-2d0f-ce378b9c38f1
msgctxt "h71925094g680eg464fgac83gc28b713545e0"
msgid ""
"*But only if you can find a cure first. The tadpole must be evicted - be it "
"by blade, magic, or any other means you can find.*"
msgstr ""
"*그러려면 치료법부터 찾아내야겠지만 말이죠. 올챙이는 반드시 축출되어야 합니다. 칼이든, 마법이든, 무슨 방법을 써서라도 말입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Narrator
#. NodeID = 3c2a8c2e-c12e-1d56-c04f-3a535bbaa574
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:3c2a8c2e-c12e-1d56-c04f-3a535bbaa574
msgctxt "hccc91ab7gd5fag4a0bgb591gfb3268d7504f"
msgid ""
"*You feel nothing. But of course, Lady Shar is no crass teacher, bludgeoning "
"you with her instructions.*"
msgstr "*아무것도 느껴지지 않는군요. 샤님께선 가르침을 억지로 쑤셔 넣는 형편없는 교사가 아니니 당연한 일입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Player
#. NodeID = 3cce3176-9efc-9730-7b52-661526eacae7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:3cce3176-9efc-9730-7b52-661526eacae7
msgctxt "h3de99c91g2c7ag4642gbab2g00683a85d7d6"
msgid ""
"Forget the hunter <i>and</i> the parasite. I'm more concerned about the "
"infernal engine burning out."
msgstr "사냥개고 기생충이고 <i>다</i> 잊어버리자. 지옥불 엔진이 완전히 불타 꺼져버리는 것이 더 걱정 된다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Narrator
#. NodeID = 3d947e18-b0b0-60a0-9567-00cb29bf232d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:3d947e18-b0b0-60a0-9567-00cb29bf232d
msgctxt "h4fb7b55ag7866g4b20ga162g627e6d09f008"
msgid ""
"*According to what you've read, you have but seven days to find a cure... or "
"that's the end of you. Better get moving.*"
msgstr "*당신이 전에 읽었던 대로라면, 일주일 안에 치료법을 찾지 못할 경우... 가망이 없습니다. 이만 움직여야 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Player
#. NodeID = 464a9e4a-2e70-55e5-e166-8cb8d6f46ce4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:464a9e4a-2e70-55e5-e166-8cb8d6f46ce4
msgctxt "h25af1e0egf792g494ag8915g18ae51a86a14"
msgid ""
"Better ten bugs than another day in the Hells. Than another <i>hour</i>."
msgstr "지옥에서 하루 더 보내느니 그 벌레 열 마리 욱여넣는 게 나아. 아니, <i>한 시간</i>도 아깝네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Player
#. NodeID = 474383ed-8f7f-ceaf-338c-e6fdba7e7f84
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:474383ed-8f7f-ceaf-338c-e6fdba7e7f84
msgctxt "h14b9de4eg618ag495dgaa18gcdb58b523c49"
msgid ""
"Yes. YES! Should be able to follow the river straight to Baldur's Gate. Easy."
msgstr "그래. 그렇지! 강을 쭉 따라가다 보면 발더스 게이트에 도착할 거야. 쉽네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Narrator
#. NodeID = 4977e4ea-1c5b-bb5a-1fff-c6714fe94937
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:4977e4ea-1c5b-bb5a-1fff-c6714fe94937
msgctxt "h4fd5f1d5g076dg4068g8f17g5ac7b0497a8b"
msgid ""
"*But not as alien as the creature hiding deep inside your head. You must get "
"rid of it.*"
msgstr "*하지만 당신 머릿속에 깊이 숨어든 생명체만큼 이질적이진 않죠. 반드시 놈을 제거해야 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Player
#. NodeID = 4bcb58b3-7219-a224-d082-05252e784351
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:4bcb58b3-7219-a224-d082-05252e784351
msgctxt "h46e7c638gd77bg492fgb23cg5499fbe26529"
msgid ""
"<i>Removing the tadpole is all that matters now. Unless you find a cure, "
"your hunting days are over.</i>"
msgstr "<i>지금 중요한 건 올챙이를 제거하는 것이다. 치료법을 찾지 못한다면, 사냥은 꿈도 못 꾸게 될 거다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Player
#. NodeID = 4e747db6-5119-6b56-0258-c4763d3453c9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:4e747db6-5119-6b56-0258-c4763d3453c9
msgctxt "h92287cb7g53e5g4a17gb0f5g5d350a999333"
msgid ""
"If it looks like the Sword Coast, smells like the Sword Coast, and <i>feels</"
"i> like the fucking Sword Coast..."
msgstr "소드 코스트처럼 생겼고, 소드 코스트 냄새도 나고, <i>느낌</i>도 그냥 씨발 소드 코스트 같으니..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Narrator
#. NodeID = 4eb99fe3-a5b1-6f7e-1eef-46e42acc97da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:4eb99fe3-a5b1-6f7e-1eef-46e42acc97da
msgctxt "h89d57ec9g7c20g4075gad0agf11f5f62c406"
msgid "*It's safe with you - Lady Shar's mission can still be fulfilled.*"
msgstr "*무사히 잘 있군요. 샤님의 임무는 아직 달성 가능합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Player
#. NodeID = 5024b947-988a-95c0-2626-f2db8307fd8b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:5024b947-988a-95c0-2626-f2db8307fd8b
msgctxt "h27ac8afag1c01g46c5g9571gbe1eb0657346"
msgid "<i>Orient yourself - where did you land?</i>"
msgstr "<i>주변 상황을 파악한다. 어디에 떨어진 걸까?</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Player
#. NodeID = 57b8dcef-dc8a-225c-c5ae-e096c2dbab15
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:57b8dcef-dc8a-225c-c5ae-e096c2dbab15
msgctxt "hdaceececg6db9g4a4cg9e46g0a85111a75ba"
msgid ""
"I'll sort it. I always do. Might even have a little fun bashing devil "
"bootlickers along the way."
msgstr "해결하면 돼. 늘 그랬듯이 말이야. 겸사겸사 데빌 발바닥 핥는 것들 때려잡는 재미도 볼 수 있을지 모르지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Narrator
#. NodeID = 5a6d9f65-cc43-4d8c-d818-e79322043086
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:5a6d9f65-cc43-4d8c-d818-e79322043086
msgctxt "he8032364g8378g498bg9491gbaae10cee2ff"
msgid ""
"*Other than the infection, you're more or less intact. A miracle, given "
"everything you've been through.*"
msgstr "*올챙이 감염을 제외하면, 당신의 상태는 거의 멀쩡합니다. 당신이 겪은 일을 생각하면 기적이죠.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Player
#. NodeID = 5c7bd503-bfb3-cdd3-1e2d-ab0ea7764ae1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:5c7bd503-bfb3-cdd3-1e2d-ab0ea7764ae1
msgctxt "h9c0004b3gb7a3g4d1fg99a9g0c5179ba329c"
msgid ""
"<i>Perhaps you are being too harsh. The tadpole gifted you the sun, after "
"all...</i>"
msgstr "<i>너무 나쁘게만 느끼는 것 같기도 하다. 바로 그 올챙이가 당신에게 햇빛을 선물했잖은가...</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Player
#. NodeID = 5d37441f-7aae-aee2-a9b6-75bd8dfb8741
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:5d37441f-7aae-aee2-a9b6-75bd8dfb8741
msgctxt "hd7a38632g3c99g4fd3ga3e2g7885c7011278"
msgid "INFECTED BY A MIND FLAYER PARASITE!"
msgstr "마인드 플레이어 기생충에 감염됐다니!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Narrator
#. NodeID = 6319b2d6-93b2-837a-cb74-f014438234d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:6319b2d6-93b2-837a-cb74-f014438234d9
msgctxt "ha7d3e06cg19f5g4c58gb799g5b758e409a31"
msgid "*As you wake, the tadpole squirms in your skull.*"
msgstr "*깨어나자마자, 두개골 속 올챙이가 꿈틀거립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Narrator
#. NodeID = 6789acf0-aa88-47df-d156-d92e24d21f25
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:6789acf0-aa88-47df-d156-d92e24d21f25
msgctxt "hc17fc93fg968eg4591g8f31g0fe23110628a"
msgid ""
"*The opposite, in fact. Your skin tingles pleasantly. Like the caress of a "
"lover who doesn't know any better yet.*"
msgstr "*사실, 그 반대이죠. 살갗이 기분 좋게 간질거립니다. 마치 아직 사랑에 미숙한 연인과 애무를 나누는 것 같군요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Player
#. NodeID = 6a390504-b9c4-6817-8368-3b9d4e88add5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:6a390504-b9c4-6817-8368-3b9d4e88add5
msgctxt "h9eefaedegbb56g4b75g8928gd9e055f85f47"
msgid ""
"Been through a lot, but I draw the line at becoming a mind flayer. I'll sort "
"it. I always do."
msgstr "산전수전 다 겪어봤지만, 마인드 플레이어가 되는 것만은 사절이야. 해결해야지. 항상 그랬듯이."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Narrator
#. NodeID = 6e19668a-6d00-dfd8-4876-de6e0c0cae3f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:6e19668a-6d00-dfd8-4876-de6e0c0cae3f
msgctxt "h4fe87d5bgaea6g4712gb23fg989dac938cb0"
msgid ""
"*The tadpole is a death sentence, and the clock is ticking. You need a cure.*"
msgstr "*올챙이의 존재는 사형 선고이며, 시간은 째깍째깍 흐르고 있습니다. 치료를 받아야 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Narrator
#. NodeID = 6e4968da-fef8-c0e9-71aa-85bf1d8e52a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:6e4968da-fef8-c0e9-71aa-85bf1d8e52a6
msgctxt "h726ae3a7g9818g4a2ag93f1gdc011a9e1cf2"
msgid ""
"*Perhaps it would be wise to focus on finding a cure. As wonderful as the "
"sun is, you can hardly enjoy it if your face rips open.*"
msgstr ""
"*치료법 찾기에 집중하는 편이 상책일지도 모르겠습니다. 햇빛이 환상적이긴 하지만, 얼굴이 뜯겨 나간 채로 즐길 수는 없는 노릇이니까요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Narrator
#. NodeID = 6e940661-e580-ea7a-8365-757607665dfd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:6e940661-e580-ea7a-8365-757607665dfd
msgctxt "h77e98f42g5decg4245g926bgd1f7d5ad5cd5"
msgid ""
"*Perhaps. But you need to help her before she can return the favour. High "
"time you got back to the hunt.*"
msgstr "*그럴지도요. 그러려면 당신이 먼저 그 여자에게 도움이 되어야겠지만요. 다시 사냥에 나설 때가 왔군요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Player
#. NodeID = 787fca47-6931-b36f-4cd9-99a2d9417f16
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:787fca47-6931-b36f-4cd9-99a2d9417f16
msgctxt "h50b14454ge8beg4131g9baag948877116083"
msgid "<i>Maybe your patron can help with the tadpole.</i>"
msgstr "<i>후원자가 올챙이를 제거하는데 도움을 줄지도 모른다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Player
#. NodeID = 813a28dc-1ec1-d9d2-f104-a687e4329c8e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:813a28dc-1ec1-d9d2-f104-a687e4329c8e
msgctxt "hedba39adg5029g4b6dg848agefc7bed067e8"
msgid "ALIVE!"
msgstr "살아있다니!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Narrator
#. NodeID = 8453a9c7-b005-ab5e-2b2b-220ed309117b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:8453a9c7-b005-ab5e-2b2b-220ed309117b
msgctxt "h27f5e520gc1f4g4833gb5e5gb1d8817fde2d"
msgid "*And you'll need to do it quickly.*"
msgstr "*그것도 빠르게 말이죠.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Player
#. NodeID = 8ad38437-71f2-a283-921b-bb1aecbf1263
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:8ad38437-71f2-a283-921b-bb1aecbf1263
msgctxt "h690fad00gcb08g4685g961eg6ab010ef83cf"
msgid ""
"<i>You'll find a way to fix this. You are Gale of Waterdeep, after all.</i>"
msgstr "<i>해결할 방법을 찾아낼 것이다. 당신은 바로 그 워터딥의 게일이잖은가.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Narrator
#. NodeID = 8c086ec8-4457-ae18-dfaa-53a0b058b606
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:8c086ec8-4457-ae18-dfaa-53a0b058b606
msgctxt "h599800e5g66d7g4de4gb030g6521266419fc"
msgid ""
"*Sunlight. Your first instinct is to flinch from it and hide in the safety "
"of shadows. But to your astonishment, there is no pain.*"
msgstr "*햇빛. 빛을 받자마자 몸이 움츠러들고 안전한 그림자 속으로 숨고 싶어집니다. 하지만 놀랍게도 고통이 느껴지지 않습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Player
#. NodeID = 8f1b148f-6198-6289-fa7c-ab9ce81cac77
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:8f1b148f-6198-6289-fa7c-ab9ce81cac77
msgctxt "hffc45c3egb039g4d34gb771g845354129bcf"
msgid "OUT OF THE HELLS!"
msgstr "지옥에서 탈출하다니!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Player
#. NodeID = 8f9b30f8-b3c9-de4e-7d54-535f85f15eec
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:8f9b30f8-b3c9-de4e-7d54-535f85f15eec
msgctxt "hf15f264fg5415g4260g8406g28019f4aeef4"
msgid "Yeah, yeah, one crisis at a time, hm?"
msgstr "그래, 그래, 하나씩 차근차근 해결하자고, 응?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Player
#. NodeID = 8ff1ea7c-0b0f-78a5-077a-91890fbe70f8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:8ff1ea7c-0b0f-78a5-077a-91890fbe70f8
msgctxt "h19f2f99fg39afg41f3g8ebfg8a205f255da0"
msgid ""
"No doubt Zariel will be on my trail soon. Think I even spotted one of her "
"hunters on the ship. I better get moving."
msgstr "자리엘은 무조건 내 뒤를 쫓겠지. 그 함선에서 그년의 사냥개 중 한 놈을 본 거 같기도 하네. 이만 움직여야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Player
#. NodeID = 95b00a18-0551-fff8-2d65-fc9e1510a473
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:95b00a18-0551-fff8-2d65-fc9e1510a473
msgctxt "h12dfd44cg819dg427dg946dg0cfb29a130e2"
msgid "<i>The artefact. You need to make sure it's secure.</i>"
msgstr "<i>아티팩트가 잘 있는지 확인해 본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Narrator
#. NodeID = 9ac4a5ce-a9cc-de96-4e29-c5219a520c5b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:9ac4a5ce-a9cc-de96-4e29-c5219a520c5b
msgctxt "h79113a5bgb218g431egb7b1ga1d1cc13336f"
msgid ""
"*Your head whispers vengeance: you cannot wait to slice your way forth, "
"seeking whatever wrought this tragedy upon you.*"
msgstr ""
"*머리가 복수를 속삭입니다. 앞길을 막는 것들을 베어가르며, 당신에게 이 비극을 초래한 존재를 찾아나설 생각에 좀이 쑤시는군요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Narrator
#. NodeID = 9bfd41a0-2d83-5b12-1cb4-6f9a446c97a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:9bfd41a0-2d83-5b12-1cb4-6f9a446c97a3
msgctxt "h75a79bdegb2bag468fg9f7eg013987ac3fa0"
msgid ""
"*That great mind is little more than a playground for a parasite right now. "
"The tadpole must be disposed of.*"
msgstr "*그 대단한 위인은 이제 기생충의 놀이터에 지나지 않습니다. 올챙이는 반드시 제거되어야 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Narrator
#. NodeID = 9d70d3ad-5360-690d-2fce-3caf62977874
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:9d70d3ad-5360-690d-2fce-3caf62977874
msgctxt "hcbebf01dg9aabg4292ga9d7g0be801337165"
msgid ""
"*Your mind doesn't want to cooperate. Every time you try to focus on the "
"hunt before you, thoughts of the tadpole brush it aside. You have to find a "
"cure.*"
msgstr "*마음이 영 따라주지 않습니다. 사냥에 집중하려 들 때마다, 올챙이에 대한 잡념으로 흐지부지됩니다. 치료법을 찾아야 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Narrator
#. NodeID = a8296ec5-1d8b-e34a-1381-c37de43967aa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:a8296ec5-1d8b-e34a-1381-c37de43967aa
msgctxt "h8a6eb2dagca34g48e1ga53dg91d50adaa3d6"
msgid ""
"*You know a good deal about illithids and the process known as "
"ceremorphosis. None of it good.*"
msgstr "*당신은 일리시드와 뇌변이로 알려진 과정에 대해 제법 많은 걸 알고 있습니다. 그중 좋은 얘기는 하나도 없죠.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Narrator
#. NodeID = ac16a23b-4268-63d7-5da5-f43ba2db7a50
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:ac16a23b-4268-63d7-5da5-f43ba2db7a50
msgctxt "hec5b19ccgd86cg41d0g9a62g12407db81330"
msgid ""
"*If you don't find a way to remove the tadpole burrowed in your brain soon, "
"your future will be as blank as your past.*"
msgstr "*뇌 속에 파고든 올챙이를 제거할 방법을 빨리 찾아내지 못하면, 당신의 미래도 과거처럼 공백으로 채워지게 되겠죠.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Player
#. NodeID = ad77a614-ccef-0292-c2e6-d48559ea6076
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:ad77a614-ccef-0292-c2e6-d48559ea6076
msgctxt "h2cbce543gb2c9g4b4eg8e0dgf3a1d4e28121"
msgid "<i>Check yourself for injuries.</i>"
msgstr "<i>부상 여부를 확인한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Narrator
#. NodeID = b325ae8a-d017-a8b0-6af5-5be82cb7e9e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:b325ae8a-d017-a8b0-6af5-5be82cb7e9e6
msgctxt "h37f22f28gb992g4860g8fe3gb68783f35048"
msgid ""
"*Tentacles. Horror. Blood. Oblivion. Only some of those sound appealing.*"
msgstr "*촉수, 공포, 피, 망각. 이 중 마음에 드는 단어는 일부뿐이군요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Narrator
#. NodeID = b7255f35-78da-1e8a-8ef1-c07dd8036316
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:b7255f35-78da-1e8a-8ef1-c07dd8036316
msgctxt "h46f2220eg42acg4a43ga03ag39f86ae9c16a"
msgid ""
"*It hurts just to think, but you need to get your bearings. You went to "
"Avernus as a hunter, but you've left it as prey. Not to devils, but to the "
"tadpole in your brain.*"
msgstr ""
"*생각만 해도 괴롭지만, 그래도 견뎌내야 합니다. 당신은 사냥꾼으로서 아베르누스에 들어갔지만, 먹잇감 신세로 빠져나왔죠. 데빌이 아닌, "
"뇌 속 올챙이의 먹잇감으로 말입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Narrator
#. NodeID = b95ee2f5-8ee9-0f2b-c978-23b1a0f5fbcc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:b95ee2f5-8ee9-0f2b-c978-23b1a0f5fbcc
msgctxt "h35ef9ba2gb6beg4edega06dgaf509ae63a9b"
msgid ""
"*Your stomach rudely announces itself to you with a twinge. Unfortunately, "
"you cannot eat sunlight. Time you found some prey.*"
msgstr "*위가 살짝 욱신거리며 교양 없이 신호를 보냅니다. 불행하게도, 햇빛은 먹을 수가 없죠. 먹잇감을 찾을 시간입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Narrator
#. NodeID = b994ff59-4e0e-9da2-861e-95740208eb97
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:b994ff59-4e0e-9da2-861e-95740208eb97
msgctxt "h435fb675gf2e0g46efga604gded8c83e213f"
msgid ""
"*But beneath the skin, flesh, and bone, there is a much more unpleasant "
"sensation. Something nibbles and burrows where it does not belong. The "
"tadpole, nestled in your brain.*"
msgstr ""
"*하지만 피부와 살, 뼈보다 깊은 곳에서 이를 훨씬 웃도는 불쾌한 감각이 올라옵니다. 초대받지 않은 침입자가 굴을 파고 갉아 먹는 감각. "
"당신의 두뇌에 자리 잡은 그 올챙이입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Narrator
#. NodeID = b9aead81-2616-7cb5-1f7d-e59291dc24ff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:b9aead81-2616-7cb5-1f7d-e59291dc24ff
msgctxt "h2cf67395g3ee5g4245gb3edg5f32b98f2c22"
msgid ""
"*It stirs softly. Soon it will hunger, and when that time comes it <i>must </"
"i>be fed. Starve it, and you risk triggering a cataclysmic explosion of raw, "
"unfettered Weave.*"
msgstr ""
"*보주는 고요히 흔들거립니다. 곧 허기가 동할 것이고, 그때가 오면 <i>반드시</i> 먹이를 줘야 합니다. 굶겼다간 풀려난 위브가 "
"경천동지할 폭발을 일으킬지도 모릅니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Narrator
#. NodeID = bc843cb1-0ecc-f7fa-6982-ea20c47260f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:bc843cb1-0ecc-f7fa-6982-ea20c47260f5
msgctxt "hc937f128gd012g4084g8376g27e6a6eef3e4"
msgid ""
"*It was indeed miraculous... and perhaps a little suspicious. But it will "
"have been for nothing if you don't find a way to remove the tadpole. And "
"quickly.*"
msgstr ""
"*실로 기적이라고밖에 할 수 없군요... 살짝 수상쩍기도 하고요. 하지만 올챙이를 제거할 방법을 찾지 못하면 다 부질없는 고민이 될 "
"겁니다. 시간도 촉박하죠.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Narrator
#. NodeID = bf9dbe3b-02d5-d472-3e00-c7ebe4952e81
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:bf9dbe3b-02d5-d472-3e00-c7ebe4952e81
msgctxt "h5bf7280cg081dg499fgba65gce8c729ed48d"
msgid ""
"*Your patron might see things differently. But if the tadpole has its way, "
"in a few days you won't be worrying about her or anything else.*"
msgstr ""
"*당신의 후원자는 생각이 다를 수도 있지만, 올챙이를 이대로 내버려두면, 며칠 내로 그 여자든 뭐든 염려조차 할 수 없는 신세가 되고 말 "
"겁니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Narrator
#. NodeID = c14f3cf3-bf0c-d891-5597-1ff05d634c2d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:c14f3cf3-bf0c-d891-5597-1ff05d634c2d
msgctxt "h293fa539g9914g4423gb08fg56b6a7d64c29"
msgid ""
"*Your head spins as you gather yourself. Fresh air and firm ground feel "
"almost <i>alien </i>to you.*"
msgstr "*몸을 추스리니 머리가 어지럽습니다. 신선한 공기와 단단한 지면이 거의 <i>이질적으로 </i>느껴집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Player
#. NodeID = ca004b52-8346-c73c-64f7-78eca9b82f0a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:ca004b52-8346-c73c-64f7-78eca9b82f0a
msgctxt "hb3153cc3gd25cg48e1g9229gd5b9207d4587"
msgid "Ye gods! Can it be... I'm... I'm..."
msgstr "신이시여! 설마... 내가... 내가..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Player
#. NodeID = ce5eab48-8316-a142-13f1-899dc462e7db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:ce5eab48-8316-a142-13f1-899dc462e7db
msgctxt "h393ad563gb7e4g43a2gbd1fg797cc2c5de33"
msgid "<i>Focus. You have a devil called Karlach to hunt.</i>"
msgstr "<i>집중하자. 칼라크라는 데빌을 사냥해야 하잖은가.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Player
#. NodeID = cec5b612-aa3a-924a-160b-2f789ef7da1e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:cec5b612-aa3a-924a-160b-2f789ef7da1e
msgctxt "h186e6081g21f8g4c85g917bg3d5e2e3451dc"
msgid ""
"<i>Just the thought of nibbling reminds you - it's high time you found some "
"prey to sup on.</i>"
msgstr "<i>갉아 먹는다는 부분에서 떠오르는 게 있다. 먹잇감을 찾아내 배를 채울 시간이 됐단 것 말이다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Player
#. NodeID = d4f3ae7e-1c8d-e0ac-d927-2cd0efdf8b64
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:d4f3ae7e-1c8d-e0ac-d927-2cd0efdf8b64
msgctxt "h49f22bb4g08dcg4adag9725g0f854cbd0832"
msgid "HOME!"
msgstr "집에 오다니!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Narrator
#. NodeID = d6e9aa2a-7e50-0819-811c-337e7c99c9de
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:d6e9aa2a-7e50-0819-811c-337e7c99c9de
msgctxt "h88b5fdd3g4573g4734g9f85gafee7042d16f"
msgid ""
"*She wants you to solve this on your own - prove yourself to her. First the "
"parasite, then the mission. You are on the right track already.*"
msgstr ""
"*그분은 당신이 스스로 해결하길 원합니다. 자질을 증명해보이는 것이죠. 기생충 건을 시작으로, 그다음은 임무까지. 당신은 이미 올바른 "
"궤도에 올라 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Player
#. NodeID = d8e84cca-ac76-7703-dd18-ec50d87c04da
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:d8e84cca-ac76-7703-dd18-ec50d87c04da
msgctxt "h2e6f3de4g5d73g4955g95dbg7fcf6cffe89f"
msgid "Now - time to march. I've got a life to live. <i>Finally.</i>"
msgstr "자, 나아갈 시간이야. 살아갈 인생이 생겼잖아. <i>마침내.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Narrator
#. NodeID = db5a8f8a-aa3c-72ca-aa10-68039832e07a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:db5a8f8a-aa3c-72ca-aa10-68039832e07a
msgctxt "h59a720e3g4274g481bg9fe0gaa0cd0a0fceb"
msgid ""
"*But it will also bring transformation, given time. Into a mind flayer.*"
msgstr "*하지만 시간이 지나면 당신을 바꿔놓기도 하겠죠. 마인드 플레이어로 말입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Player
#. NodeID = de2e526b-7a5c-5e27-0982-91d4b1f3d848
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:de2e526b-7a5c-5e27-0982-91d4b1f3d848
msgctxt "hfcdf5376gd6b4g42aega122g8ac2495d19ce"
msgid "For good. Forever. No matter what."
msgstr "다 끝났어. 영원히. 누가 뭐라 해도."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Player
#. NodeID = dfb07716-9814-9dc2-68b0-25a295fab915
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:dfb07716-9814-9dc2-68b0-25a295fab915
msgctxt "h1e54daebg0a42g407eg9ed3gaff6f7351bc0"
msgid ""
"<i>Offer the Dark Lady silent thanks for your survival this far. Beg her for "
"guidance.</i>"
msgstr "<i>여태 목숨이 붙어있는 것에 대해 어둠의 여신께 조용히 감사를 올린다. 그분의 인도를 갈구해 본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Player
#. NodeID = e7758e25-c770-912c-f88d-3cb56f6709ff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:e7758e25-c770-912c-f88d-3cb56f6709ff
msgctxt "h4ff0f0c0g77abg4d7bg8affg8d0697421621"
msgid ""
"Forget the hunter, the parasite, and the engine. I'M HOME, GODS DAMN IT! "
"HOME!"
msgstr "사냥개고, 기생충이고, 엔진이고 싹 다 잊어버리자. 난 집에 왔다! 제기랄! 집이라고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Narrator
#. NodeID = eacc7085-6884-49bd-f36d-4c4c3976f68f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:eacc7085-6884-49bd-f36d-4c4c3976f68f
msgctxt "ha6a8c09bg3363g47bbgad6dg1d61ce71551c"
msgid ""
"*Such an explosion will be unavoidable, if the tadpole in your skull "
"triggers ceremorphosis. An outcome definitely best avoided.*"
msgstr "*당신의 머리 속 올챙이가 뇌변이를 촉발시킨다면, 그 폭발은 불가피하게 벌어지겠죠. 절대 맞이하고 싶지 않은 최후입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Player
#. NodeID = f1d5f66c-6d4e-a039-51e9-2eb05db91c9a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:f1d5f66c-6d4e-a039-51e9-2eb05db91c9a
msgctxt "h729183c1g60beg4045gb24fgc7227e6ac05f"
msgid ""
"Step one: get far away from anything with tentacles. Step two: stay calm and "
"don't burn anything down. Step three: find allies who won't mind a friend "
"who spends a lot of time talking to herself."
msgstr ""
"첫째 : 촉수 달린 것들과 관련된 건 멀리 하기. 둘째 : 차분히 굴며 아무것도 불태우지 말기. 셋째 : 하루 종일 혼잣말을 하더라도 "
"개의치 않는 동료를 찾기."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp
#. Speaker = Player
#. NodeID = f825e2b8-3e70-62f4-5618-1e5a22140f38
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_AvatarWakesUp:f825e2b8-3e70-62f4-5618-1e5a22140f38
msgctxt "h70fd1e7age31bg4141gb85fg693dbbe231d3"
msgid "And not a devil to be found. This is it. I'm finally free."
msgstr "데빌은 단 한 놈도 보이지 않아. 됐어. 난 드디어 자유야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Crash/CRA_Boosters_PAD_DeadGuide
#. Speaker = Player
#. NodeID = 1bb70e6d-abf3-4f8a-87b9-5216c879a410
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act1/Crash/CRA_Boosters_PAD_DeadGuide:1bb70e6d-abf3-4f8a-87b9-5216c879a410
msgctxt "h2b622b13g55b8g4306ga518g9af63cf8e98b"
msgid "Losiir is gone. His spirit now swims the Astral Sea."
msgstr "로시르가 죽었군. 그의 영혼은 이제 아스트랄 바다를 헤엄치리라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Crash/CRA_Boosters_PAD_DeadGuide
#. Speaker = Player
#. NodeID = 1bb70e6d-abf3-4f8a-87b9-5216c879a410
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act1/Crash/CRA_Boosters_PAD_DeadGuide:1bb70e6d-abf3-4f8a-87b9-5216c879a410
msgctxt "hd90728efgf6afg4a5aga022gf016492bb6a0"
msgid "Our guide suffered a harder landing than we did."
msgstr "우리 가이드는 우리가 겪었던 것 보다 힘든 착륙을 경험했나 보군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Crash/CRA_Boosters_PAD_DeadGuide
#. Speaker = Player
#. NodeID = 1bb70e6d-abf3-4f8a-87b9-5216c879a410
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act1/Crash/CRA_Boosters_PAD_DeadGuide:1bb70e6d-abf3-4f8a-87b9-5216c879a410
msgctxt "h69e2c683g7900g42a1gab87g081cbb585841"
msgid "Our gith helper didn't make it. So how were we spared...?"
msgstr "기스 친구는 죽었네. 우린 어떻게 살아남은 거지...?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Crash/CRA_Boosters_PAD_DeadGuide
#. Speaker = Player
#. NodeID = 1bb70e6d-abf3-4f8a-87b9-5216c879a410
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act1/Crash/CRA_Boosters_PAD_DeadGuide:1bb70e6d-abf3-4f8a-87b9-5216c879a410
msgctxt "hbcd8024bgb5c0g4c31g8a2cg1976dadf5ce8"
msgid "The gith from the nautiloid. Why did I survive, when he did not?"
msgstr "노틸로이드에 있던 기스군. 왜 저 자만 죽고 난 살아남은 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Crash/CRA_Boosters_PAD_DeadGuide
#. Speaker = Player
#. NodeID = 1bb70e6d-abf3-4f8a-87b9-5216c879a410
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act1/Crash/CRA_Boosters_PAD_DeadGuide:1bb70e6d-abf3-4f8a-87b9-5216c879a410
msgctxt "h46e8eff8g9c13g4996ga268g703019c18f01"
msgid "Rest in peace, Losiir. Thanks for your help."
msgstr "편히 쉬길, 로시르. 도와줘서 고마웠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Crash/CRA_Boosters_PAD_DeadGuide
#. Speaker = Player
#. NodeID = 1bb70e6d-abf3-4f8a-87b9-5216c879a410
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Crash/CRA_Boosters_PAD_DeadGuide:1bb70e6d-abf3-4f8a-87b9-5216c879a410
msgctxt "h470282ccgf965g4dbdgb638g3ce2656b6a4a"
msgid "The githyanki from the mind flayer ship. A shame he didn't survive."
msgstr "마인드 플레이어 함선에 있던 기스양키잖아. 죽었다니 안타깝군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Crash/CRA_Boosters_PAD_DeadGuide
#. Speaker = Player
#. NodeID = 1bb70e6d-abf3-4f8a-87b9-5216c879a410
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act1/Crash/CRA_Boosters_PAD_DeadGuide:1bb70e6d-abf3-4f8a-87b9-5216c879a410
msgctxt "h6ee6b31dg5866g4b84ga781ga52b6baaf122"
msgid "Oh dear - rather a graceless landing from our githyanki guide."
msgstr "이런. 우리 기스양키 친구는 착륙이 좀 서툴렀네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_DeadFisherman2_Dead
