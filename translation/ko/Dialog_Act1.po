msgctxt "h1b7eeaf5g58ddg4c67gb0c7gf5a00c2a58c5"
msgid "We don't just lie down and die!"
msgstr "우리는 가만히 앉아서 죽을 생각은 없다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_Trainer
#. Speaker = Asharak
#. NodeID = 69912007-3721-c07d-8c4f-0e8aada91aa8
