msgctxt "h8b9718dbg227ag442ega6c1gf29c02511733"
msgid "Shouldn't you be getting home? The grove ain't safe."
msgstr "집에 가야 하지 않겠어? 이 숲은 이제 위험하다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader_VB_HagLeaves
#. Speaker = Player
#. NodeID = b3316dac-b4d5-6504-8152-876da8e7bf7d
#. HandlePath = TaggedText[0].TagText[0]
