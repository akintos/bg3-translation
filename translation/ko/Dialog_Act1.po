#. NodeID = edf46cf8-28c0-f87a-fd01-b11de2e7eb07
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Absolute_Knows_GoblinsWorship = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinBrash:edf46cf8-28c0-f87a-fd01-b11de2e7eb07
msgctxt "ha4fddcebgfb71g44a4g8b3cg3f6622161125"
msgid ""
"Ain't just a mark on the flesh: it's <i>magic.</i> Only them what follows "
"the Absolute can see it."
msgstr "단순한 표식이 아니야: <i>마법</i>이라고. 절대자님을 따르는 이들만이 그걸 이해하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinBrash
#. Speaker = Warlock Greez
#. NodeID = f451108e-882a-0bbb-199f-aa45674c062d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinBrash:f451108e-882a-0bbb-199f-aa45674c062d
msgctxt "hdc76496cgba0fg440bgadc1g357fb9187618"
msgid ""
"Priestess'll sort you out. Only thing she likes more than prayin' is burnin' "
"folk..."
msgstr "여사제님이 처리해 줄 거야. 그녀는 기도하는 것보다 사람을 지지는 걸 더 좋아하지..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinFavorite
#. Speaker = Warlock Bolt
#. NodeID = 5eed2543-e0f1-5edd-bdeb-d5ffa942c4b8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_GoblinKing_HasMet(1) = True
