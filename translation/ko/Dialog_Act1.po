msgctxt "h6f6a674ag22a9g4849gb697g96b8b5264692"
msgid "They slaughtered everyone. Miri..."
msgstr "다 학살해 버렸구나. 미리..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_AD_Searching
