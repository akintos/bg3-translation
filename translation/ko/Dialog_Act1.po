msgctxt "h35d46446g8b84g424cgb2ecg5906012b8bf4"
msgid "THEN LOWER THE PRICE. OR <b>DIE</b>."
msgstr "<b>그럼 가격을 낮춰. 그게 싫으면 목숨을 내놓던가</b>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03
#. Speaker = Player
#. NodeID = 502af067-4de0-6bc7-0fb7-4cbb503085b4
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
