msgctxt "hcf46bf31g32afg4a46gbc7cgebb9d23b3b6f"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SecludedSpot_Trespassing
#. Speaker = Player
#. NodeID = 1e3a8941-bfc1-a597-7530-2f4a9831a445
#. HandlePath = TaggedText[0].TagText[0]
