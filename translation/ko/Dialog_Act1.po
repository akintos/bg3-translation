msgctxt "hbc7bdf46g4180g4a39gb6e2gd10907ab708e"
msgid "Broken. Must have been here a while."
msgstr "망가져 있어. 방치된 지 꽤 오래됐나 본데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Forest_VB_Trap
#. Speaker = Player
#. NodeID = c527aba4-6726-bb4d-0b6a-db0c0881de58
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
