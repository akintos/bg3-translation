msgctxt "heb8c367fga9b6g4737gbb33gd851ec35a499"
msgid "A fine entrance, your drowship, but we got orders. Lads, intruder!"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_AlarmUsedReaction
#. Speaker = Sentinel Olak
#. NodeID = 712ee53f-962c-344e-0e87-25191b76a440
#. HandlePath = TaggedText[0].TagText[0]
