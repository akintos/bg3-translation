msgctxt "hc57ae0a2gad63g4061g9628gfb902cd690a2"
msgid "I don't have that kind of money."
msgstr "그런 돈은 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03
#. Speaker = Player
#. NodeID = 24dd76c0-eee3-c0dd-be77-d1537662e280
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03:24dd76c0-eee3-c0dd-be77-d1537662e280
msgctxt "h4c74981agaa21g417bga169g42e526251301"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03
#. Speaker = Brem
#. NodeID = 250e5359-f680-b0b1-f231-ab100ea100df
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - GLO_DoubtingArtist.ZhentDungeon_FreedByBribe(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03:250e5359-f680-b0b1-f231-ab100ea100df
msgctxt "h3273bc63g12f6g44bdgaf59g6a0b4a33f4c9"
msgid "He's all yours. Don't forget to feed him - he bawls something proper."
msgstr "이제 그는 당신 겁니다. 먹이 주는 걸 잊지 마세요. 안 그러면 제대로 울어대거든요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03
#. Speaker = Player
#. NodeID = 2899b36a-f8b3-1e7e-d798-fdf45133e278
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03:2899b36a-f8b3-1e7e-d798-fdf45133e278
msgctxt "heaa53919gfc66g4f9bga6bfg9e3f23452c8f"
msgid "I <i>do</i> cut a fine figure. I'll take one."
msgstr "내가 <i>수려하기는</i> 하지. 하나 살게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03
