msgctxt "he9a92257gbf29g4b59gbf90g041db4fc9700"
msgid "What're you waitin' for?"
msgstr "뭘 기다리는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarLoyalPatroller_01_AD_TauntingPrisoner
#. Speaker = Murmath
#. NodeID = 1ec8f4c1-d80a-f83f-c39c-3c7c4c3954a0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarLoyalPatroller_01_AD_TauntingPrisoner:1ec8f4c1-d80a-f83f-c39c-3c7c4c3954a0
msgctxt "h00f37628g4409g40ecga33fgfa7dc89c0868"
msgid "Stinkin' snitch<i>. </i>No one <i>drughs</i> with Clan Flameshade."
msgstr "썩을 놈의 밀고자 녀석. 아무도 플레임셰이드 일족을 <i>엿먹일</i> 수 없다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarLoyalSergeant_AD_CaveInDestroyed
#. Speaker = Sergeant Thrinn
#. NodeID = 4af4f697-d571-4cdb-8a69-b1b3c5412942
#. HandlePath = TaggedText[0].TagText[0]
