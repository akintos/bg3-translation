#.     - UND_MushroomHunter_Event_GiveBackpack(0) = True
#. TagRule: REALLY_DARK_URGE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter:947051bc-dcc5-404d-2539-a16e0112b7bb
msgctxt "hd04ada32g44edg4fe1g9252g91c8aa335f92"
msgid "<i>Deny yourself the firework show. Give him the bag.</i>"
msgstr "<i>불꽃놀이를 보고 싶은 마음을 참는다. 그에게 가방을 넘긴다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Player
#. NodeID = 947051bc-dcc5-404d-2539-a16e0112b7bb
