msgctxt "hb9e36baegc99eg4fdaga2fdgd088cc1db054"
msgid "Is it a chest? A door? Can you show me where it is?"
msgstr "상자? 문? 어디 있는지 보여줄래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_GruntingKid
#. Speaker = Narrator
#. NodeID = bad87002-c5fb-e8ec-054c-7778d193ce43
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_GruntingKid:bad87002-c5fb-e8ec-054c-7778d193ce43
msgctxt "h4054b950g07ddg4922g961egbd71e3aa102f"
msgid "*You see nothing out of the ordinary.*"
msgstr "*그다지 특이한 점은 발견하지 못했습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_GruntingKid
#. Speaker = Player
