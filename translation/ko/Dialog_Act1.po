msgctxt "h6d7ec9dagd71dg4350gbe99gfbe09c8706ec"
msgid "An invitation to speak with the <i>ch'r'ai</i>? You are honoured."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_IntelligenceOfficer04
#. Speaker = Ardent Jhe'rezath
