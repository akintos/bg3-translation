msgctxt "h322189c2g42d8g4b3dgb3ccg0a20138e85f1"
msgid "I hear shouting. Someone needs help."
msgstr "함성 소리가 들리는군. 누군가 도움이 필요한 것 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_TollCollector001_Dead
