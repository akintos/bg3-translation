msgctxt "hb7ae2567g89cbg4895gbd2dg7a22107ec1d5"
msgid "Ha! Weren't expecting <i>that</i>, were you, <i>k'chakhi</i>?"
msgstr "하! <i>이걸</i> 기대한 거 아니었어, <i>크차키</i>?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_MageHandKid01
