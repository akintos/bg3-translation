#. SetFlags:
#.   Global:
#.     - FOR_UnfortunateGnome_State_NonCharlatanAccess = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:71eacf1d-a4bd-ce4a-83c5-958675b65c51
msgctxt "h683edee2g005dg40cegb74dgce51bbb91aaf"
msgid ""
"I'm not bargaining with you. Free him, or I swear on my oath, you will "
"<i>die</i>."
msgstr "난 흥정하는 게 아니야. 그를 풀어주던가, 아니면 맹세코 널 <i>죽이겠어</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = 7476cfd3-12b6-437b-ed94-85e52ed03c71
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_UnfortunateGnome_State_Still = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:7476cfd3-12b6-437b-ed94-85e52ed03c71
msgctxt "hb4540921gb9d3g4cedg9e40g4f7c95bb56c5"
msgid "Heh, funny. That's what our birdie wanted."
msgstr "헤, 재밌네. 우리 새도 그러고 싶어했지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = 74c1ee98-a1f4-ab18-383d-a7ccb28d7d10
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:74c1ee98-a1f4-ab18-383d-a7ccb28d7d10
msgctxt "h35076e57g7ffbg452bg8c06g101d16408fd8"
msgid "Erm, p-pardon, sir. Didn't mean to doubt you. I know my place."
msgstr "음, 시-실례했습니다, 나으리. 당신을 의심하려던 건 아니었어요. 제 분수는 잘 알고 있습니다요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = 74c1ee98-a1f4-ab18-383d-a7ccb28d7d10
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:74c1ee98-a1f4-ab18-383d-a7ccb28d7d10
msgctxt "h9e3ed38cg8334g4d98g86d9g1f4a723ed586"
msgid "Erm, p-pardon, madam. Didn't mean to doubt you. I know my place."
msgstr "음, 시-실례했습니다, 마님. 당신을 의심하려던 건 아니었어요. 제 분수는 잘 알고 있습니다요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = 74c1ee98-a1f4-ab18-383d-a7ccb28d7d10
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:74c1ee98-a1f4-ab18-383d-a7ccb28d7d10
msgctxt "h72b634b9g926fg4326g9c4agfec7e75f480d"
msgid "Erm, p-pardon. Didn't mean to doubt you. I know my place."
msgstr "음, 시-실례했습니다. 당신을 의심하려던 건 아니었어요. 제 분수는 잘 알고 있습니다요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Goblin Devout
#. NodeID = 78009ddc-18b3-1643-2bcd-f16a8949bee4
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: GNOME
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:78009ddc-18b3-1643-2bcd-f16a8949bee4
msgctxt "h8cbc601agf7d6g4eaeg9769gf485a24d1582"
msgid "What about the other gnome? Ain't we s'posed to bring him to -"
msgstr "다른 노움은 어떡하고? 우리가 그를 데려가기로 한 거 -"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Goblin Devout
#. NodeID = 78009ddc-18b3-1643-2bcd-f16a8949bee4
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:78009ddc-18b3-1643-2bcd-f16a8949bee4
msgctxt "h7dae1b0bg16dbg4a22g9607g85c2a114b1b3"
msgid "What about the gnome? Ain't we s'posed to bring him to -"
msgstr "이 노움은 어떡하고? 우리가 그를 데려가기로 한 거 -"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = 799a1b31-101c-8d31-e88d-73026da402ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:799a1b31-101c-8d31-e88d-73026da402ae
msgctxt "h62a89be3g4da9g4c41g8bdeg1c1f86f7ba34"
msgid "Erm... n-not much to it: pull a lever an' enjoy the squeals."
msgstr "음... 벼-별 거 없어요: 레버를 당겨서 비명을 즐기시면 됩니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = 7a344b23-b46b-8c4d-37bc-ccee96211ce1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_UnfortunateGnome_State_Still = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:7a344b23-b46b-8c4d-37bc-ccee96211ce1
msgctxt "h852bc83fgc2ceg4b20gb2b4g675f2e0d5c1f"
msgid "'Less you wanna join him up there, you'd best pay the toll."
msgstr "저 위에 있는 애랑 같이 있고 싶지 않으면, 통행료를 내는 게 좋을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Narrator
#. NodeID = 7a77602e-3424-da2a-d860-c832f227fb4f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - GLO_TadpoleIntro_NPC(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:7a77602e-3424-da2a-d860-c832f227fb4f
msgctxt "hd0b4cb8age6c5g4728g9ac7gcc338b2105d1"
msgid "*As the symbol glows, power courses through you. <i>Authority</i>.*"
msgstr "*문양이 빛나며, 몸에 흐르는 힘이 느껴집니다. <i>권위</i>.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Player
#. NodeID = 7aeed9e4-93b9-430a-17c2-109a6aea37e2
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:7aeed9e4-93b9-430a-17c2-109a6aea37e2
msgctxt "h1e77df16gea96g496agb1c0gb7dcbf9253ed"
msgid "Wait! Just let me go... <i>please</i>."
msgstr "잠깐! 그냥 보내주세요... <i>제발</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Player
#. NodeID = 7c3d4354-38c8-ab64-e78e-6a4124c20f9f
#. HandlePath = TaggedText[0].TagText[0]
