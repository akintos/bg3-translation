#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:7fa8eb66-4772-4d0e-46ca-72a3e29cbef3
msgctxt "h244a0bcag1874g4239g864egabe7eeabf742"
msgid "<b>Mine.</b>"
msgstr "<b>내 거다.</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = 82b63592-c85d-64b7-d3bb-abe8c434d8b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:82b63592-c85d-64b7-d3bb-abe8c434d8b1
msgctxt "h3f2c3a79g4a73g49fbgb214g9b52095ad7bd"
msgid "If you ain't with the Absolute, you're the enemy."
msgstr "네가 절대자님과 함께하지 않는다면, 넌 적이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = 88b51c96-f233-3290-8118-433baa0b172d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:88b51c96-f233-3290-8118-433baa0b172d
msgctxt "h2ac7bab2gbf6bg4354ga624g3e6ef9fb847f"
msgid ""
"How do you like <i>that</i>? ([GEN_CheckMagicPocketGold_2_463b0f43-5410-412d-"
"aba3-875cf81c38ca])"
msgstr ""
"<i>이건</i> 어떠냐? ([GEN_CheckMagicPocketGold_2_463b0f43-5410-412d-"
"aba3-875cf81c38ca])"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = 8979d5b7-4a34-cd45-7b25-2c5cb8e3bccd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:8979d5b7-4a34-cd45-7b25-2c5cb8e3bccd
msgctxt "hc524e57cgd979g4a3egbafbg7dc37d78f0c4"
msgid "You're not... not blessed?"
msgstr "당신은 축복받은 자가 아니… 아니라고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Player
#. NodeID = 8cc684ba-e2c7-cd91-2f09-f1fc73e046fc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - WLD_UnfortunateGnome_Why(2) = True
#. TagRule: REALLY_GNOME and !REALLY_DEEPGNOME
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:8cc684ba-e2c7-cd91-2f09-f1fc73e046fc
msgctxt "he5b4c219gdb05g4e03g951fga06310ac2f2d"
msgid "Release that deep gnome at once - he's a kin of sorts to me."
msgstr "저 딥 노움을 당장 풀어줘. 그는 내 먼 동족이라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Player
#. NodeID = 8cc684ba-e2c7-cd91-2f09-f1fc73e046fc
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - WLD_UnfortunateGnome_Why(2) = True
#. TagRule: REALLY_DEEPGNOME
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:8cc684ba-e2c7-cd91-2f09-f1fc73e046fc
msgctxt "hc991f62ag5dceg45a5gbe7fg312e3c691e5a"
msgid "Fun's over - release my kin at once."
msgstr "즐거움은 끝이다. 내 동족을 당장 풀어줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Player
#. NodeID = 8cc684ba-e2c7-cd91-2f09-f1fc73e046fc
