#.      - PALADIN(1) = True
#. TagRule: PALADIN_VENGEANCE and NOT_FOR_EA
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000:ac18f6c6-38dd-d969-d85e-fc4e914eb733
msgctxt "hb9df570fg3d09g4b22gb3e4g8ce9367b7114"
msgid "I seek retribution for those who cannot."
msgstr "난 힘없는 이들을 위한 응징을 꾀한다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000
#. Speaker = Player
#. NodeID = ac18f6c6-38dd-d969-d85e-fc4e914eb733
