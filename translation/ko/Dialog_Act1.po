msgctxt "h47d22a91g0f9dg4b3bga096g874ff80427f1"
msgid "*The corpse does not stir. It will answer no more questions.*"
msgstr "*시체는 움직이지 않습니다. 더 이상 질문을 받지 않을 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_Derryth_Dead
#. Speaker = Derryth Bonecloak
#. NodeID = bf0583d3-443c-5834-83a3-80b0ddbe4d2a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_Derryth_Dead:bf0583d3-443c-5834-83a3-80b0ddbe4d2a
msgctxt "h7239662fg66f8g4b22ga10fg531dbd5a6805"
msgid "Don't know... don't care..."
msgstr "몰라... 신경 안 써..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_Derryth_Dead
#. Speaker = Narrator
#. NodeID = c02c457a-d291-4b8d-ae4c-f915148e254f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
