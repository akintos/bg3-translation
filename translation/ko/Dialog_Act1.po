msgctxt "hc28d18afg3944g4541gaf1bge918cbbc876b"
msgid "I'm reporting here for tadpole extraction, as protocol demands."
msgstr "규칙 대로, 올챙이를 적출하기 위해 보고하러 왔다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Doctor
