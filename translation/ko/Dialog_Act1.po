msgctxt "hca585b92g89cbg47bbgbe14g345fee954816"
msgid "She's dead."
msgstr "죽었군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_FoundWife
#. Speaker = Player
#. NodeID = f5f3a235-94a0-e60e-fb7e-68316c1bba8c
