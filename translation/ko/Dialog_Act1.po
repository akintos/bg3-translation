#.      - MONK(3) = True
#. SetFlags:
#.   Local:
#.     - 4b9219b6-9074-0463-e4e0-1ff4c30e087b_SkippedHelp = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene:b1975035-40d2-af7b-acde-49a38a000fa5
msgctxt "h543429dbgec49g43eeg9e55g5ec59764d2df"
msgid ""
"The githyanki's an intelligent creature, just like you. Release her, and let "
"us converse civilly."
msgstr "기스양키는 그쪽처럼 지성을 가진 존재야. 풀어주고 교양있게 얘기를 나눠 보자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene
#. Speaker = Lae'zel
#. NodeID = b425742f-f9f0-e9d8-a5c2-82cd1df1fb68
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene:b425742f-f9f0-e9d8-a5c2-82cd1df1fb68
msgctxt "h21da9d0egb014g4374g921age8a502c62baa"
msgid "<i>Get rid of her.</i>"
msgstr "<i>저년을 없애.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene
#. Speaker = Lae'zel
#. NodeID = b62402d8-d9fb-7d8c-9a92-bf4eb62646df
