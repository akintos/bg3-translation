#.     - GLO_Companion_Combat(8) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:c1c4377c-ee69-4123-a1c6-149ed7763f14
msgctxt "hf84337acg0abdg4bb6gb7adgfbe2b61fa867"
msgid "Take Karlach."
msgstr "칼라크를 데려가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Player
#. NodeID = c727d128-d406-a6a0-f156-43340a385966
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:c727d128-d406-a6a0-f156-43340a385966
msgctxt "h52351035g3fbcg4eedg8bcbg22a14ef1b2ab"
msgid "I'll just kill you and claim it for myself."
msgstr "그냥 너를 죽이고 스스로 얻을게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Player
#. NodeID = ca278562-41da-2c6b-f100-75533dc6a35f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:ca278562-41da-2c6b-f100-75533dc6a35f
msgctxt "hd011a1c3gdddeg4c8dgbdf0g43be2a6a4afd"
msgid "I won't let you enslave them any longer."
msgstr "네가 더는 이들을 노예로 부리지 못하게 하겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Pooldripp the Zealous
#. NodeID = ca439453-9ad0-a60e-6748-3f5feb70cc86
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:ca439453-9ad0-a60e-6748-3f5feb70cc86
#, fuzzy
msgctxt "hb01e1d46gde23g4e80gbad0g2c2c2f92769d"
msgid "...No. <i>No! You lie!</i>"
msgstr "... 아냐. <i>아냐! 거짓말이야!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = BOOOAL
#. NodeID = cbab793f-f5b7-e134-f265-701b7ae0b09d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:cbab793f-f5b7-e134-f265-701b7ae0b09d
msgctxt "h98a25b1fg29cdg4ebeg996eg809ad50a6e84"
msgid "OI, PRIEST! YOU GONNA LET THIS'UN GIVE CHEEK TO YOUR GOD?"
msgstr "어이, 사제여! 너는 이 '언'이 너의 신에게 건방진 소리를 하도록 내버려둘 텐가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Player
#. NodeID = cc302ec5-ac9a-4412-9abd-950416aec6f3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_KuoToaGod_State_PresentForSacrifice(5) = True
#. SetFlags:
#.   Object:
#.     - UND_KuoToaGod_State_SacrificedCompanion(5) = True
#.     - GLO_Companion_Combat(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:cc302ec5-ac9a-4412-9abd-950416aec6f3
msgctxt "h473ecd92g0956g4b04g8326ge805e13f3516"
msgid "Take Lae'zel."
msgstr "레이젤을 데려가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = BOOOAL
#. NodeID = cd64d8c4-4357-5f47-b9c4-7fce87b0d261
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_KuoToaGod_Event_ChallengedBOOOAL = True
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:cd64d8c4-4357-5f47-b9c4-7fce87b0d261
msgctxt "hf4c03921g29e3g4f17g9417g950da83efde3"
msgid "Kiss my arse. <i>I'm </i>the Lord of Murder - I'll show you <i>why.</i>"
msgstr "내 엉덩이에 키스나 해. <i>나는 </i>살인의 군주다. <i>왜인지</i> 너에게 보여주겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Narrator
#. NodeID = ceedb3e9-ffb4-a98f-caf4-efcccbd4969d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:ceedb3e9-ffb4-a98f-caf4-efcccbd4969d
msgctxt "h67ba3768g22eag46ebg85b6gb002e62b856e"
msgid ""
"*A wave of pure devotion washes over you - and with every surge, you feel a "
"presence <i>grow</i> in response.*"
msgstr "*순수한 헌신의 파도가 당신을 스칩니다. 그리고 그에 따라, 어떤 존재가 자라고 있는 것이 느껴집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = BOOOAL
#. NodeID = cffa7b1e-4cbc-e680-9c66-597c1dfa870b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:cffa7b1e-4cbc-e680-9c66-597c1dfa870b
msgctxt "h38b94ff9g99a0g490cg83ddgff89015980c6"
msgid "WHAT YOU GOT FOR BLESSED BOOOAL?"
msgstr "축복받은 부알을 위해 무엇을 바칠 것이지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = BOOOAL
#. NodeID = d1d97f01-ba06-d387-404c-3620a5a04117
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_KuoToaGod_State_HasSickle(1) = False
#. SetFlags:
#.   Global:
#.     - UND_KuoToaGod_Event_GiveBlessing = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:d1d97f01-ba06-d387-404c-3620a5a04117
msgctxt "hb2a6cc69g8837g448cg9b8bgee90ee4c05ba"
msgid ""
"GO WITH MY BLESSING, CHOSEN. TELL THE WORLD THAT BOOOAL IS COMING. SHOW THEM "
"MY POWER."
msgstr "내 축복을 받아가라. 선택받은 자여. 온 세상에 부알이 온다고 전해라. 내 힘을 보여줘라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = BOOOAL
#. NodeID = d30fe3d7-497c-9d64-ea86-a6e031a5e259
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:d30fe3d7-497c-9d64-ea86-a6e031a5e259
msgctxt "h031c5313g8beag45c9gadf8ga9b5f0ea9ea4"
msgid ""
"Kiss my arse, then. This Lord of Murder <i>likes</i> doing his own dirty "
"work."
msgstr "내 엉덩이에 키스나 해, 살인의 군주는 그의 더러운 작업을 <i>좋아</i>한다구."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = BOOOAL
#. NodeID = d5f83baa-387a-a01f-1ab7-fa8c1ec2bd29
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_KuoToaGod_State_PlayerIsChosen = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:d5f83baa-387a-a01f-1ab7-fa8c1ec2bd29
msgctxt "hc5dc04b9ge822g41fdga474gbe6d7ea5e7a1"
msgid "AH. BETTER. YOU ENT HALF-BAD - I THINK I'LL KEEP YOU."
msgstr "아. 좀 낫네. 넌 그렇게 나쁘지 않군. 내가 너를 계속 두고 있어도 되겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = BOOOAL
#. NodeID = d8b088a9-537f-ea70-0d76-0e0a7257a292
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:d8b088a9-537f-ea70-0d76-0e0a7257a292
msgctxt "h278c1b24g5958g447bgba64ga931f2355f59"
msgid "BUT <i>YOU FIRST.</i>"
msgstr "그리고 <i>네가 첫 번째다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Player
#. NodeID = ddaa1fea-d02d-2548-71ca-a5b9d7671fc3
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Object:
#.      - UND_KuoToaGod_State_KnowsGodIsFake(2) = True
#.   Tag:
#.      - BARD(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:ddaa1fea-d02d-2548-71ca-a5b9d7671fc3
msgctxt "hda7c9c83g3907g47e7g9919ge2d8a8f3f689"
msgid "YOU ARE LISTENING TO A FALSEHOOD. HE IS NOT YOUR <i>REAL </i>GOD."
msgstr "너희는 가짜 신의 말을 듣고 있어. 그는 너희 <i>진짜 </i>신이 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Narrator
#. NodeID = de0c7e9a-e8a8-0ea0-b734-784dea87bb21
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:de0c7e9a-e8a8-0ea0-b734-784dea87bb21
msgctxt "ha1b7622fg57bcg44d1g9109ga06f4ced6218"
msgid ""
"*In the outburst of emotion, you feel the divine presence falter - then "
"revert to its basic, cruel nature.*"
msgstr "*신성한 존재가 감정의 분출로 흔들리는 것이 느껴집니다. 그리고 보잘것없고 잔인한 본모습으로 되돌아갑니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Player
#. NodeID = df27d6d5-d516-4583-abe3-34d3b206cfa1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_KuoToaGod_State_PresentForSacrifice(6) = True
#. SetFlags:
#.   Object:
#.     - UND_KuoToaGod_State_SacrificedCompanion(6) = True
#.     - GLO_Companion_Combat(6) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:df27d6d5-d516-4583-abe3-34d3b206cfa1
msgctxt "h09b7789cg4f85g4cdbgabbdgb7fc5e7fd2be"
msgid "Take Wyll."
msgstr "윌을 데려가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Player
#. NodeID = e230c074-4c28-4778-9b70-0e638c35882f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_KuoToaGod_State_PresentForSacrifice(4) = True
#. SetFlags:
#.   Object:
#.     - UND_KuoToaGod_State_SacrificedCompanion(4) = True
#.     - GLO_Companion_Combat(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:e230c074-4c28-4778-9b70-0e638c35882f
msgctxt "hd24a810bgf4a5g4d25g8f0cg6f4127bbc72f"
msgid "Take Shadowheart."
msgstr "섀도하트를 데려가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Narrator
#. NodeID = e3ff318b-9049-2d9f-391b-531738452cca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:e3ff318b-9049-2d9f-391b-531738452cca
msgctxt "h3ed2bad4gf275g46ffg843bg058f0390c212"
msgid ""
"*You feel the presence waver - one moment a god of awesome power, the "
"next... a common redcap.*"
msgstr "*그 존재가 흔들리는 것이 느껴집니다. 놀라운 힘을 가진 신이 순식간에... 흔한 레드캡이 되었습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Lae'zel
#. NodeID = e9f9ff13-c2f7-43a5-b6a7-fb4d5cc8ce75
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:e9f9ff13-c2f7-43a5-b6a7-fb4d5cc8ce75
msgctxt "h512dc167g57b6g449cgb434g3b9451eb0d9a"
msgid "Fool. <i>Htak'a!</i>"
msgstr "멍청이. <i>흐타카!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = BOOOAL
#. NodeID = eb316c9c-2fe6-4006-96b6-7b3e8da4bb10
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:eb316c9c-2fe6-4006-96b6-7b3e8da4bb10
msgctxt "ha44e19aeg82a1g4c44gbc56gdecd6f8b5baf"
msgid "OH, DON'T WORRY. REST O' THE WORLD WILL KNOW ME SOON ENOUGH."
msgstr "오, 걱정하지 마라. 머지 않아 온 세상이 나를 알게 되리니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Pooldripp the Zealous
#. NodeID = f20e22b6-1e8c-493b-9a30-625afffabbfc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:f20e22b6-1e8c-493b-9a30-625afffabbfc
msgctxt "h895ed204g70cdg44a1g9230g2de161fe4fbf"
msgid "BLOOD! BOOOAL DEMANDS BLOOD!"
msgstr "피! 부알께서 피를 원하신다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = BOOOAL
#. NodeID = f2b4308f-51da-9881-2689-97f9b6bc2a5b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:f2b4308f-51da-9881-2689-97f9b6bc2a5b
msgctxt "hba1479dbgcaaeg4256g902dg26635eef35f3"
msgid ""
"LITTLE?! I'M A <i>GOD</i>. AND I'M GONNA <i>RIP</i> YOU - <i>TEAR</i> YOU - "
"WEAR YOU FOR A <i>HAT</i> -"
msgstr ""
"조금? 난 <i>신</i>이다. 그리고 너를 <i>찢고</i> - 너를 다시 <i>발겨서</i> - <i>모자</i>로 써 주지 -"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Player
#. NodeID = f9f1d82a-5d82-65e5-dca7-674d2d19c68f
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 15
#. CheckFlags:
#.   Object:
#.      - UND_KuoToaGod_State_HasSickle(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:f9f1d82a-5d82-65e5-dca7-674d2d19c68f
msgctxt "hdcbb8c00g6719g4c6dg808agd6ec383579f1"
msgid "<i>Get your bearings. What have you stumbled in on?</i>"
msgstr "<i>상황을 파악한다. 우연히 무엇을 발견할 수 있을지도?</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = BOOOAL
#. NodeID = fa0a5bcb-f530-c880-dec8-1211efb03681
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:fa0a5bcb-f530-c880-dec8-1211efb03681
msgctxt "h10f3d3ccg7445g4bc5gb6d6g013536389b1c"
msgid "Kill! KILL FOR BOOOAL!"
msgstr "죽여라! 부알을 위해 죽여라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = BOOOAL
#. NodeID = fc476443-ca7b-2dde-2794-1b32f5ed5f48
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:fc476443-ca7b-2dde-2794-1b32f5ed5f48
msgctxt "hd83e4601g88afg4c0fg8a7agbcce7b30cedc"
msgid "Ah. Bollocks."
msgstr "아. 제기랄."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Narrator
#. NodeID = fd494696-1a90-3850-3993-4a04be0778f9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:fd494696-1a90-3850-3993-4a04be0778f9
msgctxt "hc7930144g293dg4ccdgae1eg31edc6371bdd"
msgid ""
"*You don't recognise the creatures - but this voice seems to have a hold "
"over them.*"
msgstr "*당신은 이 생명체들을 알아보지 못합니다 - 그러나 이 목소리가 마치 이들을 지배하는 것처럼 보입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = 01a9e323-e322-5d19-d363-c0f4270fc853
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:01a9e323-e322-5d19-d363-c0f4270fc853
msgctxt "hbc4fe9bag1948g4b75gb217g81e5ca28a5d0"
msgid "Brief me, then."
msgstr "그럼 무슨 일인지 좀 알려줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 051946c0-2aa4-abd7-17ec-9c79f401b72d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:051946c0-2aa4-abd7-17ec-9c79f401b72d
msgctxt "h25a9a0cdga341g4563g8b41g4b9532d9388f"
msgid "Huh. So that's how it's going to be."
msgstr "허어. 그렇게 나오시겠다 그거지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = 05296bea-c986-2837-62b6-d5115c947234
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_LoneDuergar_Knows_Myconids(1) = False
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:05296bea-c986-2837-62b6-d5115c947234
#, fuzzy
msgctxt "hb7b77c89g7516g492bg8f6ag39f3b01c4924"
msgid "Alone. Afraid. Easily forgotten. Sounds like just my type."
msgstr "외로워하고, 두려워하며, 쉽게 잊혀지는군. 나와 비슷한 부류 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = 059092eb-cbe9-a1ea-0582-cda85eedfd0a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:059092eb-cbe9-a1ea-0582-cda85eedfd0a
msgctxt "hf59807aeg9003g4541g9a62g34205ce0ff77"
msgid "What are you doing here?"
msgstr "여기서 뭐 하는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 063eb51f-d43e-e65f-79bf-3a6ecdc1b3f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:063eb51f-d43e-e65f-79bf-3a6ecdc1b3f3
msgctxt "h8962c4d1gcd5cg479egacc4gab4da69a3c47"
msgid "Sergeant told me to."
msgstr "하사관이 그렇게 하라고 했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 07b9a1b2-d12f-6c1b-4e8a-29359dd88f41
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:07b9a1b2-d12f-6c1b-4e8a-29359dd88f41
msgctxt "heabb3a9fga2e2g454dg8aa6g07eb590cac16"
msgid ""
"Oh, you're a right miserable piece of work. Let's show that whelp what the "
"Absolute's warriors can do."
msgstr "오, 아주 제대로 맛이 간 놈이구만. 그 새끼한테 절대자의 전사들이 뭘 할 수 있는지 보여주자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 09d98f85-7939-c10d-e240-879211854b9a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_LoneDuergar_Knows_DuergarHuntGnome = True
#.   Quest:
#.     - UND_LoneDuergar.GaveQuest(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:09d98f85-7939-c10d-e240-879211854b9a
msgctxt "h93de8fedg5dfcg4c0cgb1fag3d4b1ad7c352"
msgid "Tracking a runaway slave - deep gnome. Stole boots from my sergeant."
msgstr "탈주 노예를 쫓고 있다. 딥 노움이지. 우리 하사관에게서 부츠를 훔쳐 달아났다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 0beb621e-1e34-4b22-8b2b-dd0b389b3a85
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:0beb621e-1e34-4b22-8b2b-dd0b389b3a85
msgctxt "hdfef0a4eg4c7eg4b09g930ag7bc8309ecd2b"
msgid "The boots should give her away."
msgstr "부츠를 보면 알아볼 수 있겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = 0da77915-9ca9-18c6-6ac6-202f750f9b62
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_InjuredGnome_State_HasBoots(1) = True
#. SetFlags:
#.   Quest:
#.     - UND_LoneDuergar.ShownBoots(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:0da77915-9ca9-18c6-6ac6-202f750f9b62
msgctxt "hdeab52edga9bag40eag9b36g67137286aecd"
msgid "Got the boots right here."
msgstr "여기 부츠를 가져왔어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = 0dbb7175-4e27-b908-4dc0-0aac482f1768
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:0dbb7175-4e27-b908-4dc0-0aac482f1768
msgctxt "hcc7c5002gfdcdg43f2g811eg3384575f47dd"
msgid "<i>Attack him.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 0dd269b5-e5ac-122e-bf17-f2729590a4b8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:0dd269b5-e5ac-122e-bf17-f2729590a4b8
msgctxt "h575100beg5b4dg4849g9f25g3c60c3a80e74"
msgid "Good. Do well and there might be a reward for you back at camp."
msgstr "좋아. 일을 잘 해내면 야영지로 갔을 때 보상이 있을지도 모르지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 0e341eed-9cf8-4d32-7297-752eca03aa08
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_LoneDuergar_DrowOrTrueSoulLeave(1) = True
#.      - UND_LoneDuergar_Knows_PlayerIsTrueSoul(1) = True
#.   Global:
#.      - UND_LoneDuergar_Quest_AttackMyconids = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:0e341eed-9cf8-4d32-7297-752eca03aa08
msgctxt "h5dbab369g767cg4e06gae60g7122b9bb2ffa"
msgid "Changed your mind?"
msgstr "생각이 바뀌었나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 0f056ebe-56b2-f012-3a44-8427f5102269
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:0f056ebe-56b2-f012-3a44-8427f5102269
msgctxt "hd8507850gb1f7g49a1g87ddgc456dcaf5f48"
msgid ""
"Sergeant Thrinn will cough up big to hear that slave's got her comeuppance."
msgstr "하사관 쓰린은 그 노예 년이 마땅한 벌을 받았다는 걸 알게 되면 놀라서 기침할 것이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = 10735465-d58f-38ad-05b1-3638a070fe8c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Absolute_Knows_Name = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:10735465-d58f-38ad-05b1-3638a070fe8c
msgctxt "h42046071g9e84g4729g8a71gb8c5a778f85e"
msgid "Absolute...? I don't know what you mean."
msgstr "절대자라니...? 무슨 얘기를 하는 건지 모르겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = 1077bfd1-d3cf-5a1f-fac6-e06093c1fee3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:1077bfd1-d3cf-5a1f-fac6-e06093c1fee3
msgctxt "h9dfc87b1g1157g4adcg8edbg14a829e3c6c0"
msgid "This is your concern, not mine."
msgstr "이건 너희 관심사이지. 나는 상관 없다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 11ca9998-2930-86eb-46a1-778bfea17065
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:11ca9998-2930-86eb-46a1-778bfea17065
msgctxt "h00f27a8dgc4ccg4cabg8a53g272c6d10d317"
msgid "...Did something to upset Disciple Z'rell?"
msgstr "...신봉자 즈렐을 화나게 만들 행동을 했나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 1464f5db-4010-1fad-4295-445dfa3929a2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:1464f5db-4010-1fad-4295-445dfa3929a2
msgctxt "h3fe8ce16g1575g49aegbfd3g5b8d274c493e"
msgid ""
"Anyone who stands against Her - stands against <i>us</i> - is gonna wind up "
"a slave or a corpse."
msgstr "그녀에게 맞서는 자들은, <i>우리</i>에게 맞서는 자들은... 노예가 되거나 시체가 될 뿐이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = 14e4738b-e19c-7dc0-7392-06f87a620d43
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:14e4738b-e19c-7dc0-7392-06f87a620d43
msgctxt "ha63fbfbfg8525g4123gb0c1g887230332ea2"
msgid "You thought wrong."
msgstr "잘못 생각했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = 17cc7dc5-4d7c-fa59-d1d9-5109fdaed833
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_State_Wiped = False
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule: OATHBREAKER
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:17cc7dc5-4d7c-fa59-d1d9-5109fdaed833
msgctxt "hf03b445eg64eag4822gbf2fg3154da47c02a"
msgid "The slave freed itself - free it will <i>stay</i>."
msgstr "그 노예는 스스로를 해방시켰다. 그리고 자유롭게 머물 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = 17cc7dc5-4d7c-fa59-d1d9-5109fdaed833
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_State_Wiped = False
#.   Tag:
#.      - PALADIN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:17cc7dc5-4d7c-fa59-d1d9-5109fdaed833
msgctxt "h18fb7ffagb3aeg404dg8aecg6c8ef8c2ab60"
msgid "You'll do no such thing, slavekeeper. You die here."
msgstr "그럴 수는 없다, 노예관리인. 너는 여기서 죽는다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 190b18cf-5847-be7c-2fe1-ee271131644a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DROWELF(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:190b18cf-5847-be7c-2fe1-ee271131644a
msgctxt "h6a22dd7agb201g41b1g9fb9gb262b2379941"
msgid "Not that it's all too smart to question a True Soul."
msgstr "참된 영혼을 탐문하는 건 별로 똑똑한 행동은 아니지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 1c347e31-e0a9-a15d-d102-d2d67791fb99
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:1c347e31-e0a9-a15d-d102-d2d67791fb99
msgctxt "h79444413g3d71g4b4eg8dbbg9f55b5f6a049"
msgid "Right then. Let's get you out of the way."
msgstr "좋아. 비켜주도록 하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = 1eb10721-fc09-d80d-d7df-fba524808036
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:1eb10721-fc09-d80d-d7df-fba524808036
msgctxt "h193ed013g6125g4eccgbb59g5c1f8ee35519"
msgid "<i>Turn to leave.</i>"
msgstr "<i>돌아서서 떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = 1f2dc760-f482-4282-441d-0b0b08ff737a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DUERGARDWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:1f2dc760-f482-4282-441d-0b0b08ff737a
msgctxt "hb101a2a5gba84g4ee0g88adg3dc2ef8c19c4"
msgid "I'm a duergar, idiot - we're practically kin."
msgstr "나도 듀에르가야, 멍청아. 우린 친족이나 다름없다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = 2070ff70-4f80-a2d2-b94c-cb2b28e85120
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_LoneDuergar_State_AskedAboutCamp(1) = False
#. SetFlags:
#.   Dialog:
#.     - UND_LoneDuergar_State_AskedAboutCamp(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:2070ff70-4f80-a2d2-b94c-cb2b28e85120
msgctxt "hb895e35agc459g46d9gb105gb7e0975b91ea"
msgid "What's on the other side of the lake?"
msgstr "호수의 반대편에는 뭐가 있는데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 20c5b6e8-3228-585f-0e6e-36de6a0e17b0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Moonrise_Knows_Prisoners = False
#. SetFlags:
#.   Global:
#.     - GLO_Moonrise_Knows_Prisoners = True
#.     - GLO_Absolute_Knows_MoonriseTowers = True
#.     - GLO_Moonrise_Knows_AbsoluteAtGrymforge_NoName = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:20c5b6e8-3228-585f-0e6e-36de6a0e17b0
msgctxt "hd0607696g48f4g4ed4gb01dg05cc3e867318"
msgid ""
"We're using 'em for excavation. There's some more ruins Moonrise wants us to "
"make a path to - there's something hidden in 'em. Something the Absolute "
"wants."
msgstr ""
"놈들을 이용해서 발굴을 하고 있다. 문라이즈에서 우리보고 길을 내기를 원하는 폐허가 몇 군데 더 있지. 거기에 뭔가가 숨겨져 있다더군. "
"절대자께서 원하시는 게 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = 23db0391-47e2-5eb0-6cfc-d47e11612ac9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:23db0391-47e2-5eb0-6cfc-d47e11612ac9
msgctxt "h968e381ag65b2g4621g97a8g9022425c6a56"
msgid "Your problems are your own - I'm leaving."
msgstr "너희 문제는 너희가 알아서 해. 나는 떠난다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 2411a086-a789-9d28-5ba7-9a6d80ef5bb7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:2411a086-a789-9d28-5ba7-9a6d80ef5bb7
msgctxt "hd363d245g3d5ag4a40gaf6cg7cf448c901e0"
msgid "No... something's wrong. You're no True Soul."
msgstr "아냐... 뭔가 잘못됐어. 너는 참된 영혼이 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 2471a2a2-057a-95d1-ff77-b4ebc3f5f386
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:2471a2a2-057a-95d1-ff77-b4ebc3f5f386
msgctxt "h6641e6c4gcfa1g4883g88b7ged4bf9d05e24"
msgid "Huh. Burning those into just anyone now, are they?"
msgstr "허. 그 낙인도 이제 아무한테나 막 찍어주는 모양이군. 안 그래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Narrator
#. NodeID = 268b69b5-bf7e-1211-4fdd-a60cd05bf248
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount6(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount6(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:268b69b5-bf7e-1211-4fdd-a60cd05bf248
msgctxt "h732bb4e6ge422g4dceg8dd9g84ab714aaf2b"
msgid ""
"*The presence deep in your mind is awake, unblinking. This is it. A single "
"word pervades your consciousness: 'Soon'.*"
msgstr ""
"*당신의 정신 속 깊이 자리잡은 존재가 태연스레 깨어납니다. 올 것이 왔군요. 한 단어가 당신의 의식 속으로 스며듭니다. ‘곧’*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = 26984180-32cd-e8b6-31ce-48aa7bb6d440
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_LoneDuergar_Knows_Property(1) = True
#.   Global:
#.      - UND_MyconidCircle_State_Wiped = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:26984180-32cd-e8b6-31ce-48aa7bb6d440
msgctxt "hb4096c7eg2ffdg4c23g819cg5f068004a606"
msgid "I already took care of the myconids and the gnome they were sheltering."
msgstr "그 마이코니드들과 녀석들이 보호해 주던 딥 노움은 이미 내가 처리했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 291321b6-4bff-8317-b357-9bdbb7da5553
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:291321b6-4bff-8317-b357-9bdbb7da5553
msgctxt "he582dd42g8ae1g4401g9defgf09a9bf4172f"
msgid "No matter. You weren't getting any."
msgstr "상관없다. 넌 아무 것도 못 받을 거였어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 2daa0ab3-7383-8031-1eb1-4fb28a5c57f1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:2daa0ab3-7383-8031-1eb1-4fb28a5c57f1
msgctxt "hf7b7b86bgb475g43d2g9b68g28206a6e30c2"
msgid "Well ain't that a crying shame for you..."
msgstr "이것 참, 눈물 날 정도로 부끄럽게 됐구만..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 2e642c0d-d04c-1501-e634-36009f054ed1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DEEPGNOME(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:2e642c0d-d04c-1501-e634-36009f054ed1
msgctxt "h557350dcgfa4dg4affg809dg418de8f24ef6"
msgid "You're not the gnome I'm hunting..."
msgstr "너는 내가 쫓는 노움이 아니잖아..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = 2e678511-a872-9533-0837-2d071fdbf44c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#.      - REALLY_DARK_URGE(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:2e678511-a872-9533-0837-2d071fdbf44c
msgctxt "ha1664ca2g7a2fg442egb397g2e5b35e248c0"
msgid "Back down, or <b>bleed.</b>"
msgstr "물러서라. 아니면 <b>피 흘리게</b> 해주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 3205da99-a2f0-3a2a-8f55-65446ae22192
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 9b7e00b4-cc99-c6fd-735e-30480ed23e3f_MindConnected = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:3205da99-a2f0-3a2a-8f55-65446ae22192
msgctxt "haebdb242ga9d1g4ee9g9f9dg1f8a86770a29"
msgid ""
"<i>Sooner I get rid of this one, the sooner I can get back to doing the "
"Absolute's work...</i>"
msgstr "<i>이 자식을 빨리 끝장내버리면, 절대자가 내리신 일에 더 빨리 착수할 수 있겠지...</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 32662448-ac88-3dd7-6366-a5031617506b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:32662448-ac88-3dd7-6366-a5031617506b
msgctxt "h2a9a5172g5395g4b7ag9833gf7c515f0bb73"
msgid ""
"Not that it's all too smart to question a drow <i>and </i>a True Soul, mind "
"you."
msgstr "참된 영혼인 드로우를 탐문하는 건 별로 똑똑한 행동은 아니라고나 할까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 3281868c-c6a1-eeb9-00d5-6dd01bcd59a5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_LoneDuergar_Quest_AttackMyconids = False
#.      - UND_LoneDuergar_Quest_ReadyToLeave = False
#.   Tag:
#.      - DEEPGNOME(1) = False
#.      - UNDERDARK(1) = False
#.      - DROWELF(1) = False
#. SetFlags:
#.   Dialog:
#.     - UND_LoneDuergar_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:3281868c-c6a1-eeb9-00d5-6dd01bcd59a5
msgctxt "hd39aed29g9050g4583g9559gc9d7c4380c76"
msgid "Too loud, sun-scum. Heard you stumbling. Can hear you <i>blinking</i>."
msgstr "너무 시끄럽다고, 태양의 쓰레기 자식아. 비틀거리는 소리가 들렸어. 네놈이 <i>눈 깜빡이는</i> 소리까지 들린다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 343e7476-c201-41ba-56ef-c3cf28457c23
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:343e7476-c201-41ba-56ef-c3cf28457c23
msgctxt "h0a924f0eg9797g4af7ga137gcb734ce3e5a9"
msgid "Anyway. The hunt's not over yet."
msgstr "아무튼 간에. 아직 사냥은 안 끝났다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 348c90f8-0ec4-f49a-3820-c125025f55e1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_LoneDuergar_Knows_PlayerIsTrueSoul(1) = False
#.   Global:
#.      - UND_LoneDuergar_Quest_AttackMyconids = True
#.   Tag:
#.      - DROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:348c90f8-0ec4-f49a-3820-c125025f55e1
msgctxt "hdc07c84dg38b4g4136g83ecg7a862c0216b2"
msgid "Any sign of the runaway?"
msgstr "탈주자의 흔적은 없나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 34dc548e-3e16-797d-0c13-2950103ae39a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:34dc548e-3e16-797d-0c13-2950103ae39a
msgctxt "h8b34d047g220ag4333g85a7g34052f6cf309"
msgid ""
"Well look at that! Swift work - you could teach our slaves a thing or two."
msgstr "이것 보게! 빠른 일처리구만. 우리 노예들에게 몇 가지 가르쳐줄 수도 있겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 3531f793-ca0e-aac9-8a46-fbf783560eda
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:3531f793-ca0e-aac9-8a46-fbf783560eda
msgctxt "h86ba4cb0g4ae4g4f65ga416g695d03e66081"
msgid "Let's make this quick."
msgstr "빨리 해치우자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 355e9766-35c1-9ee3-c60b-af33d1890172
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:355e9766-35c1-9ee3-c60b-af33d1890172
msgctxt "h109f2325ged24g41dagbf1cg40c15100d9b0"
msgid "Help? You don't even know what you'd be up against."
msgstr "도와준다고? 넌 뭘 상대하는지도 모르잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 366a2a9b-721c-a04b-5bcb-9831287d8229
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:366a2a9b-721c-a04b-5bcb-9831287d8229
msgctxt "hda102ad0gb275g4078g8fa4ge04cbb804cb5"
msgid ""
"She's with the rest of our expedition, across the lake. Special mission for "
"the Absolute."
msgstr "그녀는 호수 건너로 가는 나머지 탐사대와 함께 있어. 절대자를 위한 특별임무지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = 36851206-05f4-41ff-29b6-4c75af65cc62
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:36851206-05f4-41ff-29b6-4c75af65cc62
msgctxt "heec83f5dg7551g4d54g854fg736f0a73d6b8"
msgid "What does this runaway look like?"
msgstr "이 탈주자가 어떻게 생겼지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = 36b2a65d-8ccb-1a65-b513-030f54fa5ef7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Absolute_Knows_Name = True
#.   Local:
#.      - 9b7e00b4-cc99-c6fd-735e-30480ed23e3f_MindConnected = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:36b2a65d-8ccb-1a65-b513-030f54fa5ef7
msgctxt "hbb8a5207g98c9g44f9gb1dcg30bce4f42360"
msgid "I follow the Absolute. Take your hand off that weapon."
msgstr "나는 절대자를 따른다. 무기에서 손 떼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = 37027ba1-1fed-e28c-d3f7-c4d6e26ea643
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - REALLY_HALFORC(1) = True
#.      - REALLY_DARK_URGE(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:37027ba1-1fed-e28c-d3f7-c4d6e26ea643
msgctxt "h3e96ae1ag6b13g4134gabd0gff72bc3de927"
msgid ""
"I'm hungry for a fight, but you're barely a morsel. Choose your next move "
"carefully."
msgstr "난 싸움이 고프지만, 넌 한입거리도 안 돼. 잘 생각해서 행동해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 38b016be-1db7-2aa9-b414-3b88afbae07f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_LoneDuergar_State_StoleRaft = True
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:38b016be-1db7-2aa9-b414-3b88afbae07f
msgctxt "hb42707a7gec38g414bg9f6bg0898fcd9046e"
msgid ""
"Now you're a boat thief if I ever saw one. But nice of you to come back, so "
"I can split your skull."
msgstr "보아하니 내 배를 훔쳐간 도둑놈이구나. 돌아와 줘서 고맙군. 이제 네 녀석의 두개골을 쪼개줄 수 있겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = 38cfa6da-f4c5-fc59-60d1-cc568dcebf3a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:38cfa6da-f4c5-fc59-60d1-cc568dcebf3a
msgctxt "h0c1f83afgf241g419fg9d5fg327579ec5a5b"
msgid "I'm still looking."
msgstr "아직 둘러보고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = 391d40bd-b893-8cb9-f2ef-f4cdd203dff6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:391d40bd-b893-8cb9-f2ef-f4cdd203dff6
msgctxt "h45dc16fag41bag485ag86e8g640c05e514b7"
msgid "How will I recognise Sergeant Thrinn?"
msgstr "하사관 쓰린을 어떻게 알아보지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 39453141-ac48-cd02-654b-0da99878fca9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:39453141-ac48-cd02-654b-0da99878fca9
msgctxt "h324dec6dgd40bg4971g926eg082e1e39cc1b"
msgid "Oh we'll see. Have no fear of that."
msgstr "오 두고 보자고. 무서워할 필요 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 39832504-f724-0a18-f43a-d17951ddbe77
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:39832504-f724-0a18-f43a-d17951ddbe77
msgctxt "h435cbf90gcb4fg4db7g844fg9a598fc6cc29"
msgid "A deep gnome with boots too good for a slave. That's all I know."
msgstr "노예가 신기엔 너무 좋은 부츠를 신은 딥 노움이었어. 내가 아는 건 그게 다야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 39ce82cd-4575-e1c6-3df9-4a34393cbcc9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_LoneDuergar_Knows_DuergarHuntGnome = True
#.   Quest:
#.     - UND_LoneDuergar.ToldQuest(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:39ce82cd-4575-e1c6-3df9-4a34393cbcc9
msgctxt "h525f5089gcefdg474fga6f1ge3b21eff746f"
msgid "Still, got to get through them and hunt down some runaway property."
msgstr "그래도, 그들을 통과해서 도망자를 추적해야돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Narrator
#. NodeID = 3a62d02b-3c2e-1368-fc77-6b619da4980f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:3a62d02b-3c2e-1368-fc77-6b619da4980f
msgctxt "h6c42e697g6e2eg4e54gbf1bg804ef3bc57ab"
msgid "*A shiver runs across your mind... You feel sated.*"
msgstr "*전율이 불현듯 머릿속을 스쳐 지나가고... 만족감이 듭니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Narrator
#. NodeID = 3b386ccc-fbd8-3f7b-58dc-818c174d66c0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:3b386ccc-fbd8-3f7b-58dc-818c174d66c0
msgctxt "he21d1466gd237g41ecgba6eg7ac6141550d9"
msgid ""
"*The mark glows, but you feel nothing in response. Your illithid power is "
"beyond reach until you rest.*"
msgstr "*문양이 빛나지만, 어떤 반응도 느껴지지 않습니다. 일리시드 능력을 더 사용하려면 휴식을 취해야 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 3c652b4b-c678-1c6b-b30e-a41834ec673e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UN_LoneDuergar_Knows_PlayerIsCultist(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:3c652b4b-c678-1c6b-b30e-a41834ec673e
msgctxt "hc2c44e00gddb4g45dcg9099ge00a2aa85d72"
msgid ""
"Do really well and who knows? Maybe the Absolute'll have space for you in "
"Her ranks."
msgstr "정말 잘해낸다면 누가 알아? 어쩌면 절대자 아래에 널 위한 자리가 있을지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 3f3a9dc3-106d-7287-1ef2-65cb62ebc02c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:3f3a9dc3-106d-7287-1ef2-65cb62ebc02c
msgctxt "hda2c8be6ge0a3g436bg9168g429b8f60a988"
msgid "Serving the Absolute ought to be reward enough. But no matter..."
msgstr "절대자를 섬기는 건 충분한 보상이 되겠지. 하지만 상관없나..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 3f95897e-f398-c77b-6fe8-9c3a70b78635
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:3f95897e-f398-c77b-6fe8-9c3a70b78635
msgctxt "h7e9805c4g2200g4948ga94cg80569a540805"
msgid ""
"Not too sharp, are you? Look for a duergar with a sour mug and bare feet."
msgstr "너, 별로 예리한 녀석은 아니로군? 표정이 죽상이고 맨발인 듀에르가를 찾아보도록 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 40cd848d-93d8-63b2-ff60-33f1e3c02aef
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_LoneDuergar_Event_ProblemSolvedHasmet(1) = True
#.   Global:
#.      - UND_LoneDuergar_Quest_AttackMyconids = True
#.      - UND_LoneDuergar_Quest_ReadyToLeave = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:40cd848d-93d8-63b2-ff60-33f1e3c02aef
msgctxt "h9f0591ddg97d5g4dbag9f17g96a72761352b"
msgid "Well? You done mucking about yet?"
msgstr "그래, 헛소리는 다 했나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = 422f59cc-ef63-aa49-0e8e-e851f0e19eed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:422f59cc-ef63-aa49-0e8e-e851f0e19eed
msgctxt "h7e10c821g739cg41c5g9f98g50ede9aa00c2"
msgid "<i>Attack him.</i>"
msgstr "<i>그를 공격한다</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = 448d35a9-9597-4ae3-c3cd-10de1fd1bc1f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:448d35a9-9597-4ae3-c3cd-10de1fd1bc1f
msgctxt "hcf72ecbfgd3a0g40a7ga7e4gf40f301e33c3"
msgid "What do you want?"
msgstr "뭘 원하지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Narrator
#. NodeID = 45b8ee8b-119b-88ea-c199-8fa8191ca54a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount3(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount3(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:45b8ee8b-119b-88ea-c199-8fa8191ca54a
msgctxt "he54e11bbgbb0dg42a3gaaa1gdce990816691"
msgid "*Your mind lurches, reeling suddenly as if... bitten.*"
msgstr "*뭔가에 깨물린 것처럼 느닷없이 정신이 휘청거립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = 465bd474-6360-8b23-45c4-07b6aed31816
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:465bd474-6360-8b23-45c4-07b6aed31816
msgctxt "h3883a9deg86bfg4624gaab6gcb0fe9fb83ea"
msgid "No. You'll just have to take my word for it."
msgstr "아니. 넌 그냥 내 말을 믿어야돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = 46d4fec0-8ebd-b26b-2ccc-87cc1b9c7b26
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:46d4fec0-8ebd-b26b-2ccc-87cc1b9c7b26
msgctxt "h3b042e3eg54bbg4b44g8c42g0d2e91246b81"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 488d1501-7ac9-77ae-0701-4473ba1f817e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Moonrise_Knows_Prisoners = True
#.     - GLO_Absolute_Knows_MoonriseTowers = True
#.     - GLO_Moonrise_Knows_AbsoluteAtGrymforge_NoName = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:488d1501-7ac9-77ae-0701-4473ba1f817e
msgctxt "hb5aedbe5gac0eg4414ga492g090e4b07f5b3"
msgid ""
"Got 'em clearing rubble. We've got orders from Moonrise to reach some old "
"ruins - there's something the Absolute wants, tucked away in there."
msgstr "잔해를 정리하게 시켰어. 우린 문라이즈로부터 오래된 유적에 가라는 명령을 받았어. 그곳엔 절대자가 원하는 무언가가 숨겨져있다지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 48ca8ad4-72e9-9ec6-fd61-71b41c821ee6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:48ca8ad4-72e9-9ec6-fd61-71b41c821ee6
msgctxt "hb2d67332ga1d9g45begb90cgd58e1f50da0a"
msgid "Ha! A pure-bred dog of war, from that snarl. You can walk."
msgstr "하! 으르렁거리는 소리가 순종 투견이로구나. 지나가도 좋다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 49b116d8-9fc1-1f24-c314-4d0f708e40a7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UN_LoneDuergar_Knows_PlayerIsCultist(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:49b116d8-9fc1-1f24-c314-4d0f708e40a7
msgctxt "ha0c268b5gfe37g4e12gb88dg5408b1e3126d"
msgid "Hold it. You swore an oath to the Absolute. Time to make good on it."
msgstr "멈춰. 네가 절대자님에게 맹세한 서약을 지킬 때야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = 4ae5de2b-a133-baec-b97d-d4381a57c33d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:4ae5de2b-a133-baec-b97d-d4381a57c33d
msgctxt "had85efb7gb4e6g45a6gb82egd6d15c137c1c"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Narrator
#. NodeID = 4c4053bf-4139-2f5f-985e-353d9a207553
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:4c4053bf-4139-2f5f-985e-353d9a207553
msgctxt "ha1d99539g8581g4c1egbd12g115ff85c0578"
msgid "*His gnarled fist grips an axe.*"
msgstr "*그의 울퉁불퉁한 주먹이 도끼를 쥐고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 4c7fe01c-c1dd-d106-fc6c-66a816317809
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:4c7fe01c-c1dd-d106-fc6c-66a816317809
msgctxt "h440b8c8dg277cg4539ga264g212c5ddd7e49"
msgid ""
"You're a liability, hook-bait. I'll decide how many steps and breaths you've "
"got left."
msgstr "넌 위험부담이자 미끼일 뿐이야. 너가 몇 걸음을 더 걷고, 숨을 얼마나 더 쉬는지는 내가 결정한다, 이말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = 4f069bd0-1d6c-324d-3f66-f22c5d51cd87
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 10
#. CheckFlags:
#.   Dialog:
#.      - UND_LoneDuergar_Knows_IsAbsoluteFollower(1) = True
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#.      - ILLITHID(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:4f069bd0-1d6c-324d-3f66-f22c5d51cd87
msgctxt "h69d44c44g4b11g4d12ga8ffge8a3c507f533"
msgid "Stand down. I am a True Soul."
msgstr "물러서라. 나는 참된 영혼이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 50120e88-0294-d882-300a-186540b17cd0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_LoneDuergar_Quest_ReadyToLeave = True
#. SetFlags:
#.   Dialog:
#.     - UND_LoneDuergar_HasMet(1) = True
#. TagRule: DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:50120e88-0294-d882-300a-186540b17cd0
msgctxt "h25292c7fga552g470dg8128ge4c868a9e926"
msgid ""
"All's settled around here. I reckon it's a good time for you to see the "
"others across the Ebonlake."
msgstr "이곳의 일들은 해결되었어. 이제 칠흑호수 너머의 다른 이들을 보러갈 시간인 거 같네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 50120e88-0294-d882-300a-186540b17cd0
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_LoneDuergar_Quest_ReadyToLeave = True
#. SetFlags:
#.   Dialog:
#.     - UND_LoneDuergar_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:50120e88-0294-d882-300a-186540b17cd0
msgctxt "hc3e3d1f3g1b15g42b7gab77g0406b2f9b441"
msgid ""
"Nothing for you here. Cross the Ebonlake to the sergeant. Or drown in it for "
"all I care."
msgstr "여기 널 위한 건 없어. 칠흑호수를 건너서 하사관에게 가. 아님 물에 코 박고 뒈지든지, 알게 뭐람."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 50685a53-1492-def6-37ad-5cccc8b832cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:50685a53-1492-def6-37ad-5cccc8b832cf
msgctxt "hb36d0544g6705g4336g88e1gb6cf08aa04b7"
msgid "She's just some deep gnome slave. They all look much the same to me."
msgstr "그녀는 또 하나의 딥 노움 노예일뿐이야. 내게는 모두 똑같이 보인다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = 5205c002-40b3-56f1-2c88-4b52adcd4447
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_UNDERDARK(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:5205c002-40b3-56f1-2c88-4b52adcd4447
msgctxt "hb5ff8d09ga6d3g4b99g97dfg96e28bfe32c6"
msgid "What's the terrain ahead like - anything useful you can share?"
msgstr "전방의 지형은 어떤가 - 뭐라도 유용한 정보를 알려줄 수 있나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 52a6aa61-12f5-c49f-17c9-713fcb0a9dcb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:52a6aa61-12f5-c49f-17c9-713fcb0a9dcb
msgctxt "h85d3f197gff8eg411ag843fg4fc03469e2a8"
msgid "She's a deep gnome slave with fancy boots - the only one down here."
msgstr "그녀는 이 아래서는 유일하게 고급 부츠를 신은 딥 노움 노예야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 52c83bea-b3c1-f875-5669-5cbbd4060e18
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:52c83bea-b3c1-f875-5669-5cbbd4060e18
msgctxt "he9f8a172g7a99g4baegbaefgb2272b97572b"
msgid ""
"I ain't the sort to question a drow... but that was the rottenest lie to "
"ever meet my ears."
msgstr "난 드로우를 의심하는 부류는 아니지만.. 방금 그건 내가 이제껏 들어본 최악의 거짓말이었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Narrator
#. NodeID = 52e98adb-ec2e-9a06-f1a8-090453218328
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount3(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount3(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:52e98adb-ec2e-9a06-f1a8-090453218328
msgctxt "h03986a0eg6f8bg4130g8ee3g1612e14ef953"
msgid "*Your mind lurches, reeling suddenly as if... bitten.*"
msgstr "*뭔가에 깨물린 것처럼 느닷없이 정신이 휘청거립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 542ccd2e-d09c-493a-6f37-daf0cd8723ee
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_LoneDuergar_Quest_RewardWaitingInCamp = True
#.     - UND_LoneDuergar_Quest_ReadyToLeave = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:542ccd2e-d09c-493a-6f37-daf0cd8723ee
msgctxt "h410164c2g0292g4594ga508g5848b927edcc"
msgid ""
"I'll stay back here, see if I can find some more gnomes. A few more and I "
"reckon I could become a True Soul."
msgstr "난 여기서 기다리면서 잡아갈 노움이 더 있는지 한번 보겠다. 몇 놈만 더 잡아가면 나도 참된 영혼으로 거듭날지도 모르지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 56255569-d8f2-c571-49d5-4402132b3f8c
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:56255569-d8f2-c571-49d5-4402132b3f8c
msgctxt "hd42f1710gb357g4f8ag9bb6g781002d8f091"
msgid ""
"The stolen boots will do nicely as proof. And a True Soul like yerself could "
"name his prize then, I reckon."
msgstr "훔친 부츠는 훌륭한 증거가 될 거야. 그리고 아마도 당신 같은 참된 영혼은 보상을 요구할 수 있겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 56255569-d8f2-c571-49d5-4402132b3f8c
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:56255569-d8f2-c571-49d5-4402132b3f8c
msgctxt "ha47e8a32g5168g4412g85dag96c42df2da3d"
msgid ""
"The stolen boots will do nicely as proof. And a True Soul like yerself could "
"name her prize then, I reckon."
msgstr "훔친 부츠는 훌륭한 증거가 될 거다. 그리고 아마도 당신 같은 참된 영혼은 보상을 요구할 수 있겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 56255569-d8f2-c571-49d5-4402132b3f8c
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:56255569-d8f2-c571-49d5-4402132b3f8c
msgctxt "h83ebc220g3dd0g419dgbf25ged199c0722d1"
msgid ""
"The stolen boots will do nicely as proof. And a True Soul like yerself could "
"name their prize then, I reckon."
msgstr "도둑맞은 부츠는 훌륭한 증거가 될 거다. 그리고 아마도 당신 같은 참된 영혼은 보상을 요구할 수 있겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 5880b369-26a6-065e-9579-e4b8b2ebc073
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_LoneDuergar_Knows_PlayerIsTrueSoul(1) = False
#.   Global:
#.      - UND_LoneDuergar_Quest_AttackMyconids = True
#. SetFlags:
#.   Dialog:
#.     - UND_LoneDuergar_HasMet(1) = True
#.     - UND_LoneDuergar_Event_ProblemSolvedHasmet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:5880b369-26a6-065e-9579-e4b8b2ebc073
msgctxt "h5d734c2bg73fag41f4g9442g89cdfe44122b"
msgid "Get the leather. I ain't wasting more words on you until it's done."
msgstr "그 가죽쪼가리나 빨리 가지고 와. 일 끝내기 전에는 더 이상 너와 대화하지 않겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 595c8de2-93ce-41a1-ca79-93e84e0586d0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - UND_LoneDuergar_Knows_PlayerIsTrueSoul(1) = True
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:595c8de2-93ce-41a1-ca79-93e84e0586d0
msgctxt "hc95636b6g4a1fg40edg9b61gfa73f1f08a8f"
msgid "Well met, <i>sir</i>."
msgstr "잘 만났네, <i>나으리</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 595c8de2-93ce-41a1-ca79-93e84e0586d0
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - UND_LoneDuergar_Knows_PlayerIsTrueSoul(1) = True
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:595c8de2-93ce-41a1-ca79-93e84e0586d0
msgctxt "h2cf12f74g3223g439bga68aga35f4a7798e8"
msgid "Well met, <i>madam</i>."
msgstr "만나서 반갑네, <i>아가씨</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 595c8de2-93ce-41a1-ca79-93e84e0586d0
#. HandlePath = TaggedText[2].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - UND_LoneDuergar_Knows_PlayerIsTrueSoul(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:595c8de2-93ce-41a1-ca79-93e84e0586d0
msgctxt "h7a72957bg0f13g4176gb7acg3b596bf2c039"
msgid "Eh - well met."
msgstr "어, 반갑네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Narrator
#. NodeID = 5a05d31d-56ff-b505-3ee6-47b660a309a4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:5a05d31d-56ff-b505-3ee6-47b660a309a4
msgctxt "hb5f1e5cag5145g4c00g93a5g0a882b7ce44e"
msgid ""
"*The mark glows, but you feel nothing in response. Your illithid power is "
"beyond reach until you rest.*"
msgstr "*문양이 빛나지만, 어떤 반응도 느껴지지 않습니다. 일리시드 능력을 더 사용하려면 휴식을 취해야 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Narrator
#. NodeID = 5a71c9f9-5b1e-c56e-3edf-49a2f3571906
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - GLO_TadpoleIntro_NPC(1) = False
#. SetFlags:
#.   User:
#.     - GLO_TadpoleIntro_NPC(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:5a71c9f9-5b1e-c56e-3edf-49a2f3571906
msgctxt "hb76ed749g0a83g41daga711gb06c583120ed"
msgid ""
"*A strange symbol glows, marked on their flesh, and something within you "
"stirs in response.*"
msgstr "*그들의 살갗에 새겨진 기묘한 상징이 빛나고, 이에 반응하여 당신 내면의 무언가가 꿈틀거립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 5b6d3f1e-b9c8-2fe2-0ced-5df593e54e16
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - UN_LoneDuergar_Knows_PlayerIsCultist(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:5b6d3f1e-b9c8-2fe2-0ced-5df593e54e16
msgctxt "h909f0b63g030dg4f8ega7abg0c63b11f2596"
msgid ""
"That so? Maybe you're less useless than you look. Absolute's work needs "
"doing right here."
msgstr "그렇단 말이지? 넌 보기보다 쓸모 없는 거 같기도. 절대자님의 대업은 지금 당장 행해져야한다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = 5d2a82cd-5a71-5f02-f6d2-371f442f8baf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:5d2a82cd-5a71-5f02-f6d2-371f442f8baf
msgctxt "h058f1efcgfce2g443bg9dddgac5ee9b95e53"
msgid "Show some respect - I am a True Soul."
msgstr "존중을 좀 보이라고. 난 참된 영혼이니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = 5e0aab68-f356-5333-6d54-61fb6d22ea07
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:5e0aab68-f356-5333-6d54-61fb6d22ea07
msgctxt "ha01f9cdfg89fdg4bacg9798g1656cf27a22c"
msgid "<i>Attack him.</i>"
msgstr "<i>그를 공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 5e3354a2-2e08-b187-8a8d-cbb820cdf010
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:5e3354a2-2e08-b187-8a8d-cbb820cdf010
msgctxt "h74bcf27egb02cg41f6gbc31gcf42391bd82b"
msgid ""
"Falling down a deep, dark hole is the kindest death you'll find in the "
"Underdark."
msgstr "깊고 어두운 구멍으로 떨어져 죽는 건 언더다크에서 맞이할 수 있는 가장 친절한 죽음이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 5ec8c5c4-d3a5-ca5e-5333-f58c5681b9bd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:5ec8c5c4-d3a5-ca5e-5333-f58c5681b9bd
msgctxt "h16e5f0a5g6b20g4d2ag88b0gaac932d7c224"
msgid ""
"...Huh. Absolute's teachings say that anyone who doesn't bow to Her is the "
"enemy."
msgstr "...허. 절대자님의 가르침에 따르면, 그분께 절하지 않는 자들은 모두 그분의 적이라고 했다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 5f84973e-751b-c837-695d-aad819454264
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:5f84973e-751b-c837-695d-aad819454264
msgctxt "h07cffcb3gf1a3g46d9gbbb9g13de818c1c75"
msgid ""
"...but a slave's a slave. Try not to fight too much. You've no use if you're "
"damaged."
msgstr "...하지만 노예는 노예일 뿐이지. 너무 열심히 싸우지는 말도록 해. 너는 손상되면 가치가 없으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 5fa2203e-237e-8e33-9cc9-a287aebe532f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Moonrise_Knows_Prisoners = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:5fa2203e-237e-8e33-9cc9-a287aebe532f
msgctxt "hd4a3ab40g5735g4ec5g9aafgf1311f1175f4"
msgid ""
"Excavation. We've got orders to clear a passage through to some ruins. "
"There's something in there the Absolute wants."
msgstr "발굴 중이야. 우린 유적을 통과하는 길을 뚫으란 명령을 받았어. 그곳엔 절대자님이 원하는 뭔가가 있다지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 60085372-ae0a-afa6-3c76-043133f83135
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UN_LoneDuergar_Knows_PlayerIsCultist(1) = True
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:60085372-ae0a-afa6-3c76-043133f83135
msgctxt "hf0b8d407gb5a5g4cc2g8b30gb13aa9e0fc9c"
msgid "Backstabbing <i>swine</i>. Absolute'll be stronger once you're dead."
msgstr "뒷통수 치는 <i>돼지</i> 녀석. 네가 죽고 나면 절대자님은 더욱 더 강해질 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = 611971b9-560b-cd6d-6d1b-ce1425274786
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:611971b9-560b-cd6d-6d1b-ce1425274786
msgctxt "h9d7f6f57g8c89g4c32g83ccg5aafcd9d9bee"
msgid "What do you have in mind?"
msgstr "무슨 생각 중이야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Narrator
#. NodeID = 618ae310-1019-defc-8bcd-b7aad831cdc8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - GLO_TadpoleIntro_NPC(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:618ae310-1019-defc-8bcd-b7aad831cdc8
msgctxt "h23ac2f32gadc5g4fc0g8cb2g3cc677000500"
msgid "*As the symbol glows, power courses through you. <i>Authority</i>.*"
msgstr "*문양이 빛나며, 몸에 흐르는 힘이 느껴집니다. <i>권위</i>.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 6269a29d-61f0-f324-a5c5-13a48d2b5085
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DROWELF(1) = True
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:6269a29d-61f0-f324-a5c5-13a48d2b5085
msgctxt "h7fca20edgc406g4f19ga8a1g0e94a87c1168"
msgid ""
"The stolen boots will do nicely as proof. A drow such as yerself could name "
"his prize then, I reckon."
msgstr "도둑맞은 부츠는 훌륭한 증거가 될 거다. 그리고 아마도 당신 같은 드로우는 보상을 요구할 수 있겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 6269a29d-61f0-f324-a5c5-13a48d2b5085
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DROWELF(1) = True
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:6269a29d-61f0-f324-a5c5-13a48d2b5085
msgctxt "h1aebff85g5920g4b6egb9c4ga6a2529a4d8b"
msgid ""
"The stolen boots will do nicely as proof. A drow such as yerself could name "
"her prize then, I reckon."
msgstr "훔친 부츠는 훌륭한 증거가 될 거다. 그리고 아마도 당신 같은 드로우는 보상을 요구할 수 있겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 6269a29d-61f0-f324-a5c5-13a48d2b5085
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:6269a29d-61f0-f324-a5c5-13a48d2b5085
msgctxt "h4f4c7afag30ffg4cf8gbea6ge6f68ba462c6"
msgid ""
"The stolen boots will do nicely as proof. A drow such as yerself could name "
"their prize then, I reckon."
msgstr "도둑맞은 부츠는 훌륭한 증거가 될 거다. 그리고 아마도 당신 같은 드로우는 보상을 요구할 수 있겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 65059ca0-32ba-13f1-b153-6602fe4cb719
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UN_LoneDuergar_Knows_PlayerIsCultist(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:65059ca0-32ba-13f1-b153-6602fe4cb719
msgctxt "h9bf2b9fdgdec3g4542gb7f7gf5139a8bbb3d"
msgid ""
"Didn't say you could leave, did I? Another step and you'll get a kiss off my "
"axe."
msgstr "너더러 떠나도 된다고 했던가? 한 발자국만 더 가면 내 도끼와 키스하게 될 줄 알아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 6560a301-2dd7-83a7-c5ec-0506d959bf34
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_LoneDuergar_Quest_RewardWaitingInCamp = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:6560a301-2dd7-83a7-c5ec-0506d959bf34
msgctxt "hd9c9adb4gf8e8g46ccg860fgd91f4cdb22cc"
msgid ""
"Should be with the slave, or whatever's left of her. Find 'em and Sergeant "
"Thrinn'll reward you."
msgstr "노예, 적어도 그 남은 부분과 같이 있을 거다. 그걸 찾으면 하사관 쓰린이 보상을 내리겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 65bdc5bf-80f0-81e2-8b79-e9cf56264263
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:65bdc5bf-80f0-81e2-8b79-e9cf56264263
msgctxt "h22e15893ga92ag4f30g9c91ge2bd0c9a619c"
msgid "Not as alone as we'd like."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = 66518b3b-f537-9807-81ed-101477748f0b
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:66518b3b-f537-9807-81ed-101477748f0b
msgctxt "h677a665cg9cecg46d8g8813g06e468a2ed9e"
msgid "I'm a rabid dirty dog, and I <i>bite</i>."
msgstr "난 더러운 미친개다. 그것도 <i>무는</i> 개지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 690d57ae-55ce-8cb3-4f4d-5679c011b144
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:690d57ae-55ce-8cb3-4f4d-5679c011b144
msgctxt "hb81d6e33g712bg46a0gab5eg22477f515096"
msgid "What a hunt. Maybe you'll find a belt next."
msgstr "멋진 사냥이야. 어쩌면 다음엔 벨트를 찾을 수도."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = 6a3a51f4-9182-067a-790d-2f01bc2d5df1
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = False
#.      - REALLY_HALFORC(1) = False
#.      - REALLY_DARK_URGE(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:6a3a51f4-9182-067a-790d-2f01bc2d5df1
msgctxt "hbfc97badg86e7g40bfg9284g2d8c2aec2c06"
msgid "Take your hand off that axe before you lose it."
msgstr "그 손모가지 날아가기 전에 도끼에서 손 떼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 7041b783-573c-1dc1-2121-755848a43458
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:7041b783-573c-1dc1-2121-755848a43458
msgctxt "h66ad3fe4g3526g4dabg86b7g53ce4989dcdd"
msgid "Could've tried that before. Saved me some time."
msgstr "시도해 볼 수도. 그건 날 여러 번 구해줬어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 706651bf-d40e-1e85-7a18-11544ef011b2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_InjuredGnome_State_HasBoots(1) = False
#. SetFlags:
#.   Global:
#.     - UND_LoneDuergar_Quest_AttackMyconids = True
#.     - UND_LoneDuergar_Quest_ReadyToLeave = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:706651bf-d40e-1e85-7a18-11544ef011b2
msgctxt "hbed3071bg78cbg4b49g88f7ga5f7a13bfa17"
msgid "I'll keep watch here. Gnome might make a run for it."
msgstr "난 여기서 경계를 서지. 그 노움이 도망쳐 올 수도 있으니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = 70736488-212f-7842-d529-5c23eaa88c13
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_LoneDuergar_Knows_Myconids(1) = True
#.   Global:
#.      - UND_MyconidCircle_State_Wiped = False
#.      - UND_LoneDuergar_Quest_RewardWaitingInCamp = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:70736488-212f-7842-d529-5c23eaa88c13
msgctxt "h435ceb2egc46bg4156gaccdg19c865a1abe7"
msgid "I'll help you."
msgstr "도와주도록 하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 70e60ca8-3912-4315-fdb8-f82166df2752
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:70e60ca8-3912-4315-fdb8-f82166df2752
msgctxt "h1d4ed37agbe19g49d9gabdag432a6d24e9b6"
msgid ""
"But your blood earns you one more chance. Got enough on my plate as it is."
msgstr "당신의 피가 한 번의 기회를 더 벌어줍니다. 이미 문젯거리가 차고 넘칩니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = 7160394e-2914-93bc-e0b6-c710f12561d5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_LoneDuerar_Knows_SlaveCamp(1) = False
#. SetFlags:
#.   Dialog:
#.     - UND_LoneDuerar_Knows_SlaveCamp(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:7160394e-2914-93bc-e0b6-c710f12561d5
msgctxt "hf9b49b5bg9ed5g4b2dga6bdg74517359b414"
msgid "Who's this Sergeant Thrinn you mentioned?"
msgstr "네가 말한 이 하사관 쓰린은 누구지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 722c5324-3780-bc93-73ea-9e64760fcd7f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:722c5324-3780-bc93-73ea-9e64760fcd7f
msgctxt "h00011aceg6d1bg4430g8e5cg8672138c6d82"
msgid "And if you ain't who you say you are, I reckon you're fair game."
msgstr "그리고 네 정체가 너가 말한대로가 아니라면 정당한 공격대상으로 간주하겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 723322fe-cf12-4820-57a9-f15786a6f06f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_LoneDuergar_Knows_Hunting(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:723322fe-cf12-4820-57a9-f15786a6f06f
msgctxt "h89828c26gda5dg4490ga8d0ga9c8b02e0369"
msgid "Told you: hunting. Slave ran away. Took Sergeant Thrinn's boots."
msgstr "말했잖아, 사냥하는 거라고. 노예가 도망을 치면서 하사관 쓰린의 부츠도 가져갔지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 753d89bf-681d-5519-ea62-19aa2ab9ff1e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UN_LoneDuergar_Knows_PlayerIsCultist(1) = False
#. SetFlags:
#.   Global:
#.     - UND_LoneDuergar_Quest_AttackMyconids = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:753d89bf-681d-5519-ea62-19aa2ab9ff1e
msgctxt "hb9bf2791gb729g4627g8723g72b258a825e7"
msgid "Show you're worthy of serving the Absolute."
msgstr "네가 절대자님을 섬길만한 그릇이 된다는걸 증명해 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 7662db27-e180-5067-06ed-1daa81b3e755
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:7662db27-e180-5067-06ed-1daa81b3e755
msgctxt "h5737812cg4b80g44ccg857fg411eafd286d9"
msgid "I take nothing I don't want to. Time you stopped sucking air."
msgstr "난 내가 원치 않는 것은 아무것도 받지 않아. 그만 귀찮게 구시지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = 77a6c2d9-7ee3-c76c-b1bc-5538d23c1ff9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:77a6c2d9-7ee3-c76c-b1bc-5538d23c1ff9
msgctxt "h1e76c3f7g6929g4b2eg9947g506b8dfd4b7f"
msgid "What does this runaway look like?"
msgstr "이 도망자는 어떻게 생겼나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = 78201207-7c81-6537-6fb3-31845ce5a58a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:78201207-7c81-6537-6fb3-31845ce5a58a
msgctxt "h393492a3g9a9dg426bg93c2g5adadfaeb507"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 7ad29e8d-bc6d-bea2-91de-1e621b4f296d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - UND_LoneDuergar_Knows_Hunting(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:7ad29e8d-bc6d-bea2-91de-1e621b4f296d
msgctxt "ha3088bdfg45f3g44a5gab4cgd48e75753ead"
msgid "But spoil my hunt, and you're dead."
msgstr "하지만 내 사냥에 훼방이라도 놓았다간, 너는 죽은 목숨이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = 7b83a644-5e64-b11b-d597-123811a5970c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:7b83a644-5e64-b11b-d597-123811a5970c
msgctxt "h74958ffbg762eg447eg8fdegc8770f677287"
msgid "Nothing like the sweating, shaking scent of cornered prey!"
msgstr "몰아넣은 먹잇감이 풍기는 땀흘리며 벌벌 떠는 냄새가 최고지!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 7ba6de21-196d-63d6-5927-2a5268bd0ee2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:7ba6de21-196d-63d6-5927-2a5268bd0ee2
msgctxt "h984eff5dg61bdg4fcbg8463gd70cc8b3792e"
msgid "Won't happen again."
msgstr "다시는 이런 일 없을 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 7c590d0f-0401-ced8-9c53-6832e6d39587
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:7c590d0f-0401-ced8-9c53-6832e6d39587
msgctxt "he5d60bf5g1a70g4cc2gb368g305f3eb644a3"
msgid "Fine. I'll let you live."
msgstr "좋다. 목숨은 살려주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = 7e23b682-4aa3-70cb-b7e5-7f0e1a4649fc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_LoneDuergar_Quest_AttackMyconids = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:7e23b682-4aa3-70cb-b7e5-7f0e1a4649fc
msgctxt "h0cca1072g7d78g4733g8742g5fe73fbb4bd3"
msgid "What hunt? Explain yourself."
msgstr "무슨 사냥? 설명해 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 7f63ef20-550e-2ec4-dcbe-d69b3b352915
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:7f63ef20-550e-2ec4-dcbe-d69b3b352915
msgctxt "h9b85f43fgc6e8g4e22gb5cdg40bafcd59346"
msgid "Fine. Suppose I'll just eat you then."
msgstr "좋아. 그럼 널 먹어야겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = 8138936b-12b0-6f8f-ace8-1418984459b3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:8138936b-12b0-6f8f-ace8-1418984459b3
msgctxt "hddfd852cg5b0bg4b20g8348g0341380e50c5"
msgid "Do you need the body intact? I like to play with my food."
msgstr "온전한 시체여야 돼? 난 먹거리를 갖고 놀기 좋아하거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 81898ffb-7959-ed78-e131-d5c7fec063da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:81898ffb-7959-ed78-e131-d5c7fec063da
msgctxt "h1e78c79bg4161g44a5g8397g662824280389"
msgid ""
"<i>Myconids.</i> Those bloody walking rotflowers left half my squad dead."
msgstr "<i>마이코니드.</i> 그 망할 걸어다니는 썩은 식물 놈들이 내 분대의 절반을 죽여버렸어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = 81ac2d1d-b117-3a49-69f7-ff2cc9e4834f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_InjuredGnome_State_HasBoots(1) = True
#. SetFlags:
#.   Quest:
#.     - UND_LoneDuergar.ShownBoots(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:81ac2d1d-b117-3a49-69f7-ff2cc9e4834f
msgctxt "h883182d5g5394g4ac7gb063gd57c5129498e"
msgid "I have the boots."
msgstr "내게 부츠가 있다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 820593de-7b96-df6d-5a23-5e63a52eada7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_LoneDuergar_Quest_RewardWaitingInCamp = False
#. SetFlags:
#.   Global:
#.     - UND_LoneDuergar_Quest_RewardWaitingInCamp = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:820593de-7b96-df6d-5a23-5e63a52eada7
msgctxt "h6b2e7177gd4c7g4067gb527g718dbff80fc7"
msgid ""
"You'll want to take those boots to Sergeant Thrinn in the camp across the "
"Ebonlake."
msgstr "이 부츠를 칠흑호수 너머 야영지의 하사관 쓰린에게 가져가는 게 좋을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Narrator
#. NodeID = 8246f018-bc51-93be-f47d-4ffe952e92aa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount2(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:8246f018-bc51-93be-f47d-4ffe952e92aa
msgctxt "h7c97d6c0g6906g4e90ga381gaafb6a26f9f5"
msgid ""
"*Something stirs deep within you, hungry and alert... it's taking something "
"you'll never get back.*"
msgstr "*몸 깊숙한 데서 굶주리고 기민한 존재가 꿈틀댑니다... 잃으면 되찾지 못할 뭔가를 좀먹고 있군요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 828df897-480b-5f4c-2434-e271de6629e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:828df897-480b-5f4c-2434-e271de6629e6
msgctxt "h6e0820e1g0b91g425eg8f91g4ad164f6a0b7"
msgid "My god. Going to turn the world on its head."
msgstr "세상에. 이게 모든 걸 바꿀거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Narrator
#. NodeID = 832795f2-37a3-b800-7960-9abe350918e5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Tag:
#.     - TRUESOUL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:832795f2-37a3-b800-7960-9abe350918e5
msgctxt "ha77e5a15g901ag4f75gb36cg26737589b7af"
msgid ""
"*Your mind is full, bursting with ecstasy and terror. Finally, it is coming. "
"You are becoming.*"
msgstr "*당신의 정신이 황홀경과 공포로 가득 차오릅니다. 마침내, 때가 됐군요. 당신은 변화 중입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 871be8dd-3dc6-d6f3-c5b6-87797db65c45
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_LoneDuergar_Knows_PlayerIsTrueSoul(1) = True
#.   Global:
#.      - UND_LoneDuergar_Quest_ReadyToLeave = True
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:871be8dd-3dc6-d6f3-c5b6-87797db65c45
msgctxt "h75ddc772g4b9ag45abg86dbg4034a57c9d21"
msgid ""
"Time you got across the Ebonlake, sir. Nothing more to be done on this side."
msgstr "칠흑호수를 건너갈 시간이야. 여기서 더 이루어질건 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 871be8dd-3dc6-d6f3-c5b6-87797db65c45
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_LoneDuergar_Knows_PlayerIsTrueSoul(1) = True
#.   Global:
#.      - UND_LoneDuergar_Quest_ReadyToLeave = True
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:871be8dd-3dc6-d6f3-c5b6-87797db65c45
msgctxt "h1a976de0geec1g4b95gaf7fgbf98c8ac1199"
msgid ""
"Time you got across the Ebonlake, madam. Nothing more to be done on this "
"side."
msgstr "칠흑호수를 건너갈 시간이야. 여기서 더 이루어질건 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 871be8dd-3dc6-d6f3-c5b6-87797db65c45
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_LoneDuergar_Knows_PlayerIsTrueSoul(1) = True
#.   Global:
#.      - UND_LoneDuergar_Quest_ReadyToLeave = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:871be8dd-3dc6-d6f3-c5b6-87797db65c45
msgctxt "h84a37fd9gd5d0g4b8bgb4e3gbbdf462ff8b5"
msgid ""
"Time you got across the Ebonlake, True Soul. Nothing more to be done on this "
"side."
msgstr "칠흑호수를 건너갈 시간이야, 참된 영혼. 여기서 더 이루어질건 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 87ad180f-586f-3112-3b52-2009c64222dd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:87ad180f-586f-3112-3b52-2009c64222dd
msgctxt "h8c36fe5ag5217g477fg965bg33adc7b424ba"
msgid "... might help make shorter work of this mess..."
msgstr "...이 문제를 빨리 해결하는데 이로울지도 모르겠는데..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 88b81b05-e5a8-a043-5e57-284024ca738a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:88b81b05-e5a8-a043-5e57-284024ca738a
msgctxt "h23932791gbd3dg4a2egaa53g2952875c8de5"
msgid "Bad enough you're making a racket. Worse that you're lying as well."
msgstr "소란을 피우는 건 둘째 치더라도 거짓말까지 하다니, 최악이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = 8a9d55ff-900b-1379-e396-b2d7c6a96dac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:8a9d55ff-900b-1379-e396-b2d7c6a96dac
msgctxt "h3f629f57g5637g44e3gaadfg6c33821662b5"
msgid "Describe my quarry."
msgstr "내 표적을 묘사해 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = 8adb48a1-0171-3630-6fd5-ffe215b5b224
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_LoneDuergar_State_AskedAboutCamp(1) = False
#. SetFlags:
#.   Dialog:
#.     - UND_LoneDuergar_State_AskedAboutCamp(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:8adb48a1-0171-3630-6fd5-ffe215b5b224
msgctxt "h6b59ca10g19b5g4e5fgb4fdgeae6311c3036"
msgid "What's on the other side of the lake?"
msgstr "호수 건너편에는 뭐가 있지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = 90c4668a-2dd3-bb17-28f9-58adbc2e5315
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:90c4668a-2dd3-bb17-28f9-58adbc2e5315
msgctxt "h8caee978gd18eg4ae5gb159g511751175f3a"
msgid "<i>Attack him.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = 916d2b7b-d383-8376-b282-12feeb0e7bed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:916d2b7b-d383-8376-b282-12feeb0e7bed
msgctxt "h550d0181g6ec7g4393gabfcg3f48c345c0bd"
msgid "<i>Turn to leave.</i>"
msgstr "<i>돌아서서 떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = 922d301e-6271-4245-8d19-276e8ac6219a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule: DROWELF or DROWHALFELF or PALADIN
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:922d301e-6271-4245-8d19-276e8ac6219a
msgctxt "h86c075b8g9eb8g4394ga912gc2e5764b0bf5"
msgid "Some of my people keep slaves - I do not. You disgust me."
msgstr "우리 동족 일부는 노예를 부리지만, 나는 아니다. 날 역겹게 하는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = 922d301e-6271-4245-8d19-276e8ac6219a
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule: PALADIN and !PALADIN_VENGEANCE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:922d301e-6271-4245-8d19-276e8ac6219a
msgctxt "hb1402309gae1fg4e67g8812gc0a827e3fae2"
msgid "I've half a mind to push you off one myself, slavecatcher."
msgstr "반쯤 내가 직접 떠밀고 싶어졌어, 노예잡이."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = 922d301e-6271-4245-8d19-276e8ac6219a
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule: PALADIN_VENGEANCE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:922d301e-6271-4245-8d19-276e8ac6219a
msgctxt "h743dfd61g92acg47f4gaeddg8533e8f4e95d"
msgid "They deserved it - disgusting slavecatchers."
msgstr "그래도 싸지, 역겨운 노예잡이 놈들."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 94a30444-0d35-1a80-742b-89d40792199b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:94a30444-0d35-1a80-742b-89d40792199b
msgctxt "hdedccd66g33f1g4787g992cgeeb1c6ac5f97"
msgid "Any kin of mine ought to have more sense moving through the Underdark."
msgstr "내 동족이라면 누구든 언더다크를 가로지르는걸 신중히 결정할 거라네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 968021c9-c4c6-3162-5f68-f97cd9f460e0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:968021c9-c4c6-3162-5f68-f97cd9f460e0
msgctxt "h97fae9dcgcfa0g4b92g9816g391d81835c99"
msgid "More like us. And a bunch of gnome slaves."
msgstr "우리처럼 말이야. 그리고 노움 노예들과도 같지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = 985f1b06-1000-3c0c-051c-b736c3adbe94
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 5
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#.      - ILLITHID(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:985f1b06-1000-3c0c-051c-b736c3adbe94
msgctxt "h988ed3abgdc3ag494agaadeg281d075777e4"
msgid "Show some respect - I am a True Soul."
msgstr "예의를 갖춰라. 나는 참된 영혼이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = 9add3c73-56ff-eac1-c17b-2b3d4fba410f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BRANDED(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:9add3c73-56ff-eac1-c17b-2b3d4fba410f
msgctxt "h32f2842dg1070g49d2g9581gcea3ae459c80"
msgid "I don't have a brand."
msgstr "나는 낙인을 지니고 있지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Narrator
#. NodeID = 9b6dc432-29c6-4a22-509c-9a72f4bbbdaa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - GLO_TadpoleIntro_NPC(1) = False
#. SetFlags:
#.   User:
#.     - GLO_TadpoleIntro_NPC(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:9b6dc432-29c6-4a22-509c-9a72f4bbbdaa
msgctxt "h2e8cb531gf39bg4617gb9d2g8792ab395ee3"
msgid ""
"*A strange symbol glows, marked on their flesh, and something within you "
"stirs in response.*"
msgstr "*그들의 살갗에 새겨진 기묘한 상징이 빛나고, 이에 반응하여 당신 내면의 무언가가 꿈틀거립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 9b8e8c05-2058-fb81-cf2e-71e3422fe191
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_LoneDuergar_Knows_PlayerIsTrueSoul(1) = True
#.   Global:
#.      - UND_LoneDuergar_Quest_AttackMyconids = True
#.   Tag:
#.      - DROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:9b8e8c05-2058-fb81-cf2e-71e3422fe191
msgctxt "he6b10965g7b16g4161gbb5cg819a00a7c1b3"
msgid ""
"Both True Soul and drow - that slave'd jump off a ledge if she knew who was "
"after her."
msgstr "참된 영혼과 드로우- 둘 중 하나라도 그녀를 추격하고 있다는 걸 안다면 차라리 절벽에서 뛰어내릴겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 9c5ad085-b101-057e-8fb0-46da9c49e719
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - UN_LoneDuergar_Knows_PlayerIsCultist(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:9c5ad085-b101-057e-8fb0-46da9c49e719
msgctxt "hc56efdafg11d9g4182g9b76gc80a0524704c"
msgid ""
"That so? No bad thing to have more of the Absolute's warriors to hand I "
"suppose..."
msgstr "그렇단 말이지? 절대자의 전사들을 더 기용할 수 있어서 나쁠 건 없겠지..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 9c5f2029-9a0f-77fd-dfdf-eb34fbbdf122
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:9c5f2029-9a0f-77fd-dfdf-eb34fbbdf122
msgctxt "h1095e8c0g7ea2g40e6g921eg305ca2667712"
msgid "That so? Show me your brand then."
msgstr "그렇단 말이지? 그럼 낙인을 보여봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 9da83ba4-ab66-b603-04d4-5bcb1a0929d6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_LoneDuergar_Quest_RewardWaitingInCamp = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:9da83ba4-ab66-b603-04d4-5bcb1a0929d6
msgctxt "ha3af31e0g8501g480aga9a2g73b974ce5ea9"
msgid "If you take those boots to Sergeant Thrinn, she'll owe you."
msgstr "이 부츠를 하사관 쓰린에게 가져다준다면 그녀는 네게 빚을 지게될 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = 9e776f43-e5f8-8355-7dd6-1ec913a9b544
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:9e776f43-e5f8-8355-7dd6-1ec913a9b544
msgctxt "h606445cbg17d0g4b1dgb36fgb3aa34086132"
msgid ""
"Hrrm. I suppose the sound of me cracking your nut would carry down here..."
msgstr "흐음. 네 불알 깨는 소리가 멀리까지 들리긴 하겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = a03fe1b0-402f-8a4b-20e7-47416e5743bd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_LoneDuergar_Quest_AttackMyconids = False
#.      - UND_LoneDuergar_Quest_ReadyToLeave = False
#.   Tag:
#.      - DEEPGNOME(1) = False
#.      - UNDERDARK(1) = True
#.      - DROWELF(1) = False
#. SetFlags:
#.   Dialog:
#.     - UND_LoneDuergar_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:a03fe1b0-402f-8a4b-20e7-47416e5743bd
msgctxt "h11cfe9cbg74a4g4ad9g8c51gafdeab7a72b9"
msgid "You're not sun-scum. You should know not to make that much noise."
msgstr "네가 쓰레기 새끼가 아닌 이상 그렇게 큰 소리를 내면 안된다는 건 알아야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = a0dc6712-5ba0-f3a3-f910-ef4b9fc28990
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:a0dc6712-5ba0-f3a3-f910-ef4b9fc28990
msgctxt "hc0782ba9gc7efg44e9gac5fg5158f20827f8"
msgid ""
"Make yourself useful, or maybe there'll be a little culling in the "
"Absolute's ranks..."
msgstr "네 유용함을 증명해, 아니면 절대자님의 측근 목록에 약간의 변화가 있을지도..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = a126cf62-af46-15d4-2753-42f171e1c859
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_LoneDuergar_Knows_PlayerIsTrueSoul(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:a126cf62-af46-15d4-2753-42f171e1c859
msgctxt "he4ba6f9ege03dg46fdg8953g6a8e9291c73b"
msgid "Not that you need me to tell you that."
msgstr "네가 나에게 알려줘야 된다는 건 아니고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = a12c6851-ad25-8597-d9f0-f7202866ed25
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:a12c6851-ad25-8597-d9f0-f7202866ed25
msgctxt "hd82e525ag4ebag4890g8764g72c2b0cb6dc9"
msgid "I'm here at the Absolute's bidding. That's all you need to know."
msgstr "나는 절대자님의 명령에 따라 이곳에 있다. 그게 네가 알아야 할 전부다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Narrator
#. NodeID = a45d4c30-af66-50ed-693a-8280995cefd9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount5(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount5(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:a45d4c30-af66-50ed-693a-8280995cefd9
msgctxt "h6280d85agff02g4e4egaeefgcec416a106f9"
msgid ""
"*Your blood runs quicker, feeding the gnawing absence at the centre of your "
"mind.*"
msgstr "*피가 더 빨리 흐르면서, 당신의 정신 한가운데를 좀먹는 허전함을 양분으로 채웁니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = a50cf226-c701-5459-6802-23b234ac1a50
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:a50cf226-c701-5459-6802-23b234ac1a50
msgctxt "ha4ffd69dgfb4bg46begbfa4g6cbb6e103568"
msgid "<i>Attack him.</i>"
msgstr "<i>그를 공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = a5894a9e-8d08-1c47-52e9-05c3cbea0792
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_LoneDuergar_DrowOrTrueSoulLeave(1) = True
#.      - UND_LoneDuergar_Knows_PlayerIsTrueSoul(1) = False
#.   Global:
#.      - UND_LoneDuergar_Quest_AttackMyconids = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:a5894a9e-8d08-1c47-52e9-05c3cbea0792
msgctxt "h4e5ebbbbgc2d3g434egbd13gd32989e0c5cb"
msgid "Changed your mind?"
msgstr "마음을 바꿨나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = a5a68bab-8dd8-2082-6e26-8dadb096555a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_InjuredGnome_State_HasBoots(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:a5a68bab-8dd8-2082-6e26-8dadb096555a
msgctxt "h2df938aegeba4g41bfgb866g425f63ffe456"
msgid "What does the runaway look like?"
msgstr "도망자는 어떻게 생겼지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = a6c24c14-d759-9b1d-2272-f500bb41cd67
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:a6c24c14-d759-9b1d-2272-f500bb41cd67
msgctxt "h0b196b43g2810g4a64g857agf179f2867247"
msgid "How will I recognise Sergeant Thrinn?"
msgstr "하사관 쓰린을 어떻게 알아보지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = a751762e-7f4b-eb9c-45cf-cb5253aa5303
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - FIGHTER(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:a751762e-7f4b-eb9c-45cf-cb5253aa5303
msgctxt "h030edee8g44dbg422dg96eeg9afd38741226"
msgid "Fights tend to make quite a racket, if that's what you want to avoid."
msgstr "싸움은 꽤 큰 소동을 피우곤 하지, 그게 네가 피하고자 하는 거라면 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = aa77a60f-455c-cbf4-32fd-8965a6e7f6bc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:aa77a60f-455c-cbf4-32fd-8965a6e7f6bc
msgctxt "hd3190a4fgcdbdg4990ga2eag4fa8a3bfa4d9"
msgid "<i>Attack him.</i>"
msgstr "<i>그를 공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Narrator
#. NodeID = aae3225c-4f35-44bd-b611-754eb0ec86a3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - UND_LoneDuergar_Knows_IsAbsoluteFollower(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:aae3225c-4f35-44bd-b611-754eb0ec86a3
msgctxt "he636a026g2e04g4a23ga5cfg43744bce4f50"
msgid ""
"*His fist grips an axe. On his gnarled, grey skin, you see the Absolute's "
"brand.*"
msgstr "*그의 주먹은 도끼를 쥐고 있습니다. 그의 울퉁불퉁한 회색 피부에 절대자의 낙인이 보입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = abc802af-ff2c-9c74-ecb3-17d4758fcaf1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:abc802af-ff2c-9c74-ecb3-17d4758fcaf1
msgctxt "h1f0ea927g7f51g4cfbga95ag7f7f00a856c8"
msgid "Finished flapping that mouth of yours? Good."
msgstr "입은 다 퍼덕거렸나? 좋아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = ac5a46b8-16ce-70ac-3387-a27031f5784d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Absolute_Knows_Symbol = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:ac5a46b8-16ce-70ac-3387-a27031f5784d
msgctxt "hedeee8bdgda55g4dc5g8ec5g2a11bcc2fe67"
msgid ""
"Noise gets you eaten down here. Reckon I'll hush you, before something "
"hungry comes along."
msgstr "여기서 소음을 내면 잡아먹히는 법이지. 배고픈 녀석이 나타나기 전에 내가 널 조용히 만들어줄게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = ad16d6ed-29df-7bdd-e906-b732d40c69d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:ad16d6ed-29df-7bdd-e906-b732d40c69d9
msgctxt "hf85239b9gecbdg4285g9973g121dacda127b"
msgid "A True Soul... yes. Should've seen it right away."
msgstr "참된 영혼이라... 그렇군. 바로 알아봤어야 하는 건데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = ad5ce7b6-fcdc-aaea-eb62-af75de8d606d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 9b7e00b4-cc99-c6fd-735e-30480ed23e3f_KillForBoots = False
#. SetFlags:
#.   Local:
#.     - 9b7e00b4-cc99-c6fd-735e-30480ed23e3f_KillForBoots = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:ad5ce7b6-fcdc-aaea-eb62-af75de8d606d
msgctxt "hf1028bbeg1ee7g4b34g9472g74bff087dc13"
msgid "Would you really kill someone for a pair of boots?"
msgstr "진짜로 부츠 한 짝 때문에 사람을 죽일 거라는 말이야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Narrator
#. NodeID = ae846fd4-51fd-cc5d-2be2-f7d70ce0ede9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount6(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount6(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:ae846fd4-51fd-cc5d-2be2-f7d70ce0ede9
msgctxt "hef2f81fag047ag4711g8c85g6803f4928aef"
msgid ""
"*The presence deep in your mind is awake, unblinking. This is it. A single "
"word pervades your consciousness: 'Soon'.*"
msgstr ""
"*당신의 정신 속 깊이 자리잡은 존재가 태연스레 깨어납니다. 올 것이 왔군요. 한 단어가 당신의 의식 속으로 스며듭니다. ‘곧’*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = aeaecd4f-de0d-8a70-6f91-aa93904ff1f9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_LoneDuergar_Knows_Property(1) = False
#.   Global:
#.      - UND_MyconidCircle_State_Wiped = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:aeaecd4f-de0d-8a70-6f91-aa93904ff1f9
msgctxt "hf5b4fa87g3dfeg4ffegbbbagc7a16727d87e"
msgid "I wiped out a myconid circle and a deep gnome sheltering with them."
msgstr "마이코니드 일원들과, 같이 지내던 딥 노움 피난민들을 싹 다 정리해버렸지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Narrator
#. NodeID = af6b870f-1f7b-2e87-1b6c-312092e5fa04
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Tag:
#.     - TRUESOUL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:af6b870f-1f7b-2e87-1b6c-312092e5fa04
msgctxt "h1cf86ffdg427eg43e7g9f7bg1a8d0e8230d0"
msgid ""
"*Your mind is full, bursting with ecstasy and terror. Finally, it is coming. "
"You are becoming.*"
msgstr "*당신의 정신이 황홀경과 공포로 가득 차오릅니다. 마침내, 때가 됐군요. 당신은 변화 중입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = af7dc22a-547f-d83e-6be1-d7d96a11bbcd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_LoneDuergar_Knows_Myconids(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:af7dc22a-547f-d83e-6be1-d7d96a11bbcd
msgctxt "hbbc5a4cdga891g401egb45ag808f41fbb773"
msgid "Maybe I could help."
msgstr "내가 도와줄 수도 있는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = af9c4468-2788-2f2c-2103-12732a25731f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:af9c4468-2788-2f2c-2103-12732a25731f
msgctxt "hdf120572g2414g4538g9fb0g8d4c1d3f3d24"
msgid "I'm already on a mission for the Absolute."
msgstr "난 이미 절대자님의 미션을 수행중이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = afb44520-4ea3-d297-2c85-3b9d3b48d45c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:afb44520-4ea3-d297-2c85-3b9d3b48d45c
msgctxt "h680c0612g35c5g40c5gbb32g558d29110a84"
msgid "What are you doing with slaves?"
msgstr "노예들을 데리고 뭘 하는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = b04d7f52-efa0-24ea-37b4-492df70964a2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:b04d7f52-efa0-24ea-37b4-492df70964a2
msgctxt "hc3266c3dg70f0g4ef9gbf9dg19252865eb67"
msgid "I'll see what can be done - but I expect a reward."
msgstr "뭘 할 수 있을지 알아보지. 다만 합당한 보상을 기대하겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = b1f5e290-649d-c2fe-34ed-9bdd7837303a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_State_Wiped = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:b1f5e290-649d-c2fe-34ed-9bdd7837303a
msgctxt "h9001082fg76e0g4f78g9b48g552fde704a80"
msgid "I killed the escapee and the myconids sheltering her."
msgstr "도주자와 그녀를 돌봐주던 마이코니드들을 죽였어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = b35a0ea8-2746-db19-d968-c0858e91c050
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:b35a0ea8-2746-db19-d968-c0858e91c050
msgctxt "hb78290dfgd17fg4a5fgbe40gef6d0dc53644"
msgid "<i>Turn to leave.</i>"
msgstr "<i> 몸을 돌려 떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = b5696d21-c1e9-89c1-cda7-4dc0e3e18a99
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:b5696d21-c1e9-89c1-cda7-4dc0e3e18a99
msgctxt "ha7e5a013g8ef9g41a1ga5cege25473aea604"
msgid "As you like. I guess you'll be heading to the camp across the Ebonlake."
msgstr "좋을 대로. 넌 이제 칠흑호수 건너 야영지로 향하겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = b6d60643-b2fd-c1d4-c422-e4706ecb6fb9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:b6d60643-b2fd-c1d4-c422-e4706ecb6fb9
msgctxt "h1720e003gd2cfg4bc4gbe44g1809384408fb"
msgid "I'll wait here. She'll make a run for it eventually. Then I'll get her."
msgstr "난 여기서 기다린다. 언젠가는 빠져나와야 할 테니, 그때를 기다려 잡아야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Narrator
#. NodeID = b7581e93-b299-a20f-875c-5020d9b36f60
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount2(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:b7581e93-b299-a20f-875c-5020d9b36f60
msgctxt "h2becf132g01b2g4b23gb11cg9d3e55d96384"
msgid ""
"*Something stirs deep within you, hungry and alert... it's taking something "
"you'll never get back.*"
msgstr "*몸 깊숙한 데서 굶주리고 기민한 존재가 꿈틀댑니다... 잃으면 되찾지 못할 뭔가를 좀먹고 있군요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = b824bc72-3b75-2206-09ba-63caf3ea47b9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:b824bc72-3b75-2206-09ba-63caf3ea47b9
msgctxt "hb1625170ge4e9g4cfeg92ebg57a54af6963e"
msgid "I'll help you."
msgstr "널 도울게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = b865fef9-56e0-4ac1-c329-409593d583a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:b865fef9-56e0-4ac1-c329-409593d583a8
msgctxt "h0a6b61a3g05a9g4e91g8034gc2e52f690bfd"
msgid "Anything for the Absolute."
msgstr "절대자님을 위해서라면 뭐든지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = b8abfac6-60a9-4c8e-51e2-cae97513c969
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Absolute_Knows_Name = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:b8abfac6-60a9-4c8e-51e2-cae97513c969
msgctxt "h649e6f93g52adg4a8cg8d81gbe49db41cd69"
msgid "I'm not with the Absolute."
msgstr "난 절대자를 모시지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = b96d1daa-bbb2-bf99-d9a4-636222f5c39a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:b96d1daa-bbb2-bf99-d9a4-636222f5c39a
msgctxt "hf2b5c631gd68dg43a7g828agd054fa6bee6f"
msgid "Well then, drow or not... I reckon I don't have to answer to you."
msgstr "뭐 그럼, 드로우든 뭐든 간에 네게 대답할 의무는 없는 거 같네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = be6fbd47-8046-fb99-dc09-63e235c9784e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:be6fbd47-8046-fb99-dc09-63e235c9784e
msgctxt "h48fc13bdg704dg43d3gbbf0g99b001e45def"
msgid ""
"Good - and  good riddance. You'd best have proof though - Thrinn will want "
"more than just your word."
msgstr "좋아, 속 시원하구만. 그래도 증거는 갖고 있어야 할 거야. 쓰린이 네 말만 찰떡같이 믿진 않을 테니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = bec945f3-54ed-6000-e0b0-e85f40b9b489
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:bec945f3-54ed-6000-e0b0-e85f40b9b489
msgctxt "h2fbf60ecgdd8ag4e37g8e2bg654fbc5aba08"
msgid "I'm to kill the runaway - but she's holed up with <i>myconids</i>."
msgstr "도망자를 제거할 거다 - 그런데 그년이 <i>마이코니드</i> 무리에 숨어들었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = c2398896-8ccb-2200-962b-2569a9d42d8d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_State_Wiped = False
#.   Tag:
#.      - PALADIN(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:c2398896-8ccb-2200-962b-2569a9d42d8d
msgctxt "h235d4db5g0acfg42b8gb60agc9aa85bf1f9b"
msgid "I'm not helping a slave-catcher."
msgstr "난 노예 사냥꾼을 돕지 않겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = c24cdd4e-b9c4-de50-3563-79a089da99e8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_LoneDuergar_DrowOrTrueSoulLeave(1) = False
#.      - UND_LoneDuergar_Knows_PlayerIsTrueSoul(1) = False
#.   Global:
#.      - UND_LoneDuergar_Quest_AttackMyconids = False
#.   Tag:
#.      - DROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:c24cdd4e-b9c4-de50-3563-79a089da99e8
msgctxt "h3358a18fg987ag4c4ag8b59ga7f4237be870"
msgid ""
"Wasn't expecting one of you drow to join the hunt... Praise the Absolute."
msgstr "드로우 일원이 사냥에 합류할 거라곤 생각지 못했는데 말야... 절대자님께 찬사를."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = c2628c0c-51ae-0923-a66d-b1f987cfde0a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_LoneDuergar_State_SawSovereign = True
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:c2628c0c-51ae-0923-a66d-b1f987cfde0a
msgctxt "h19453b8fg9881g4a0cg87a9g84769f5666f0"
msgid ""
"You got a bloody <i>rotflower </i>for company? Must've let it get in your "
"head. My axe'll fix that in no time..."
msgstr "저 망할 <i>꽃대가리</i>를 동료로 두고 있다고? 정신을 못 차리는 거 같은데 기다려봐, 내 도끼가 고쳐줄거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = c3ac45fe-5cda-9449-0f70-a4c2d610b40a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:c3ac45fe-5cda-9449-0f70-a4c2d610b40a
msgctxt "h40ca5ea4gc6cfg48a6g9b8bg72cf93e5f443"
msgid "Sounds like a runt that needs putting down."
msgstr "밟아 줄 필요가 있는 약골 같은 소리를 내는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = c410d2b5-8499-6916-a1b0-648de7f08b54
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - UND_LoneDuergar_Knows_MyconidsAttackedGekh(1) = True
#.     - UND_LoneDuergar_Knows_Myconids(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:c410d2b5-8499-6916-a1b0-648de7f08b54
msgctxt "hab0459d5g8e9eg4174gbaceg32945a36ef36"
msgid ""
"Slave's got herself some protection - hiding up there in a <i>myconid "
"circle</i>."
msgstr "노예년이 <i>마이코니드 공동체</i>에 숨어서 보호를 받고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = c50f8768-f61a-6a57-fd55-14fcf524eaaa
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:c50f8768-f61a-6a57-fd55-14fcf524eaaa
msgctxt "h40450e67g8612g41c1g8e4eg6b9a99470c65"
msgid "Guess what that makes you."
msgstr "그게 널 어떻게 보이게 하는지 생각해 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = c63506ce-af33-bb7f-f38c-60c1ffcb72ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:c63506ce-af33-bb7f-f38c-60c1ffcb72ad
msgctxt "h4e7440c8g02e7g4804ga984g98886deb958e"
msgid "Thought you were here to help."
msgstr "네가 도와줄려고 여기 있다고 생각했는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = c7f35a4c-22e7-d949-52ea-1d2237cadc40
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_LoneDuergar_Quest_AttackMyconids = False
#.      - UND_LoneDuergar_State_Surprised = True
#.      - UND_LoneDuergar_Quest_ReadyToLeave = False
#.   Object:
#.      - UND_LoneDuergar_State_LowGround(1) = False
#. SetFlags:
#.   Dialog:
#.     - UND_LoneDuergar_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:c7f35a4c-22e7-d949-52ea-1d2237cadc40
msgctxt "h8943659agedbdg450bgbaffg65d98d2913f0"
msgid "What's this? Got ourselves an <i>infiltrator?</i>"
msgstr "이건 뭐지? 우리가 <i>침입자</i>를 찾은 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = c8c7a193-ed2e-15cc-9d91-b38c199ce2ab
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BRANDED(1) = True
#. SetFlags:
#.   Dialog:
#.     - UN_LoneDuergar_Knows_PlayerIsCultist(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:c8c7a193-ed2e-15cc-9d91-b38c199ce2ab
msgctxt "h7c261187g6140g4d24ga8e7g12c9f781a794"
msgid "<i>Show him your brand.</i>"
msgstr "<i>표식을 보여준다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Narrator
#. NodeID = c9164671-9fba-e39b-dd24-4a2f80dd0e20
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount4(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount4(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:c9164671-9fba-e39b-dd24-4a2f80dd0e20
msgctxt "h5b0369f8ge935g4d65gbbcfg37b78a46b4a8"
msgid ""
"*A shadow swims across your vision, and a familiar voice tells you to be "
"calm. You are loved.*"
msgstr "*그림자가 낀 듯이 눈앞이 흐려지더니, 익숙한 목소리가 당신을 달래줍니다. 사랑이 느껴집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = cc40b396-e4bc-659f-b1ec-7d8f6cd314e7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_LoneDuergar_State_Surprised = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:cc40b396-e4bc-659f-b1ec-7d8f6cd314e7
msgctxt "hac2d7839gf5e3g4365gb171g923a448346ce"
msgid ""
"I could've killed you before you even noticed me, but didn't. Stand down."
msgstr "네가 날 알아채기 전에 내가 널 죽일 수 있었지만, 그러지 않았어. 물러서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = cd7d1375-2b3f-03a8-22e3-c52ddd896c54
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:cd7d1375-2b3f-03a8-22e3-c52ddd896c54
msgctxt "h1d994248gb68ag48c3g91dfg5d99675aeae1"
msgid "No harm in checking."
msgstr "조심해서 나쁠건 없지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = d036b39d-5ede-c0d8-5c9a-5951ba981e3b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:d036b39d-5ede-c0d8-5c9a-5951ba981e3b
msgctxt "h780a4b15ge26ag4c1bgaf8cg9b533831ba8a"
msgid ""
"Clumsy, sun-scum. I felt you, fumbling about in my head. You'll pay for that."
msgstr "이 쓰레기야, 네가 내 머릿속을 어설프게 헤집고 다니는 거, 다 느꼈거든? 대가를 치르게 될 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = d061eecd-832b-775e-3cc4-a5c9f27d77fc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UN_LoneDuergar_Knows_PlayerIsCultist(1) = False
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:d061eecd-832b-775e-3cc4-a5c9f27d77fc
msgctxt "h628122ccg0be6g4fdcg8925gbe2cb0ac377d"
msgid "Come on then, hookbait. I want to get this over with quick..."
msgstr "덤벼 미끼놈아. 빨리 끝내버리자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = d3062e91-3957-4489-966f-d3fba0e5809e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_LoneDuerar_Knows_SlaveCamp(1) = True
#.   Global:
#.      - GLO_Absolute_Knows_Name = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:d3062e91-3957-4489-966f-d3fba0e5809e
msgctxt "h724a42efg52b9g4348gb5abg45da334d4fbf"
msgid "Who or what is the Absolute?"
msgstr "절대자라는 게 누구지? 물건인가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = d49b5761-6f8f-a08b-1b0a-72878bedfcb6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_LoneDuergar_Knows_IsAbsoluteFollower(1) = True
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:d49b5761-6f8f-a08b-1b0a-72878bedfcb6
msgctxt "h1e8a85c7g1cfag4e34g8b75gfe8196ac920a"
msgid "Stand down. I am a True Soul."
msgstr "진정해. 난 참된 영혼이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = d5a3fe2a-22a3-d8a4-439c-3aca3b0141d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:d5a3fe2a-22a3-d8a4-439c-3aca3b0141d6
msgctxt "h2a6b7395gfdf2g475eg9988gebfe1a8364a8"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = d6d923e7-e5eb-178e-e245-4827a405d9c5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_LoneDuergar_Knows_MyconidsAttackedGekh(1) = False
#.   Tag:
#.      - REALLY_UNDERDARK(1) = True
#. SetFlags:
#.   Dialog:
#.     - UND_LoneDuergar_Knows_MyconidsAttackedGekh(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:d6d923e7-e5eb-178e-e245-4827a405d9c5
msgctxt "hfd30008eg9308g49cegad01g1f8823f11687"
msgid "What has you so cautious. Hook horrors? Basilisks?"
msgstr "뭐가 널 그렇게 움츠려들게 했지? 갈고리? 바실리스크?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = d6ead4e4-45c4-a2df-6fce-7e00d29a3f37
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:d6ead4e4-45c4-a2df-6fce-7e00d29a3f37
msgctxt "h3caf8fe0g3e30g4ac0ga67dgec3e3a0606fa"
msgid ""
"I'm on a hunt. Got a runaway slave to kill. Need to fetch back the boots she "
"stole from Sergeant Thrinn."
msgstr "난 추적 중이야. 도망친 노예를 제거하고 그녀가 하사관 쓰린에게서 훔쳐간 부츠를 회수해야해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Narrator
#. NodeID = d6fe26c4-cbcc-6fa2-bc53-a50d3eb68c24
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - GLO_TadpoleIntro_NPC(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:d6fe26c4-cbcc-6fa2-bc53-a50d3eb68c24
msgctxt "hcf024f2fgd12dg48c2gb49cg0278790b999b"
msgid "*As the symbol glows, power courses through you. <i>Authority</i>.*"
msgstr "*문양이 빛나며, 몸에 흐르는 힘이 느껴집니다. <i>권위</i>.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = d739e11c-744e-0754-09a2-c740bc24a60d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_LoneDuergar_Knows_Myconids(1) = True
#.   Global:
#.      - UND_MyconidCircle_State_Wiped = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:d739e11c-744e-0754-09a2-c740bc24a60d
msgctxt "h54c1d663gb040g487fg8123g1da185f67d57"
msgid "I don't work for free."
msgstr "난 무료봉사를 하지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = d768a19d-f237-0547-0340-d5868b7feffd
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:d768a19d-f237-0547-0340-d5868b7feffd
msgctxt "h5775ad23g0036g4937gbd69g743682322f30"
msgid "I can be discreet. No need for bloodshed."
msgstr "난 조심할 수 있어. 유혈사태는 필요 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = d7ba7ac1-88f0-25b5-0566-dd1a2cd4be94
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Absolute_Knows_Name = False
#.   Local:
#.      - 9b7e00b4-cc99-c6fd-735e-30480ed23e3f_MindConnected = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:d7ba7ac1-88f0-25b5-0566-dd1a2cd4be94
msgctxt "hd725447aga9c3g43e9gbfffga9c2ec44a64f"
msgid "No need for violence. I do the Absolute's work."
msgstr "유혈은 필요없다. 나는 절대자님의 대업을 수행중이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = d95ef35b-aa1e-70f6-b979-be6f8d0657f8
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 15
#. CheckFlags:
#.   Dialog:
#.      - UND_LoneDuergar_Knows_IsAbsoluteFollower(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:d95ef35b-aa1e-70f6-b979-be6f8d0657f8
msgctxt "h1d8ef350g4d04g46f8gaa2bgb8d7096d5a47"
msgid "Stand down - I'm a follower of the Absolute, just like you."
msgstr "물러서- 난 너와 같은 절대자님의 추종자다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = dbc20ea0-2ce9-a01d-61b9-5433777f6375
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UN_LoneDuergar_Knows_PlayerIsCultist(1) = False
#. SetFlags:
#.   Global:
#.     - UND_LoneDuergar_Quest_AttackMyconids = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:dbc20ea0-2ce9-a01d-61b9-5433777f6375
msgctxt "haa606870g12d8g4609ga54bge89c8014bd10"
msgid "Maybe you'll even be allowed into the Absolute's ranks."
msgstr "어쩌면 너도 절대자님의 측근이 될 수도 있겠는걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = dcfef7ea-61b3-bd21-caf1-4cb79aa9bfdd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:dcfef7ea-61b3-bd21-caf1-4cb79aa9bfdd
msgctxt "h2b2a54e5g0cd9g40d4g8f97g1a14c5160b22"
msgid "A bleeding heart, are you? Reckon I'll just roast an' eat it."
msgstr "너, 착해빠진 녀석이구나? 구워서 먹어치워버릴까보다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = dd62b6d9-c3e3-19e5-0203-d0fd2967c0cd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:dd62b6d9-c3e3-19e5-0203-d0fd2967c0cd
msgctxt "h2f0fd4acgb65bg4fecgaf80ga82cc4fd2386"
msgid "The whole lot? Did you find boots on that gnome?"
msgstr "그걸 다? 노움에게서 부츠는 찾았어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = dda39af4-a557-6f81-fb66-5f307a7e050b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - UND_LoneDuergar_Knows_PlayerIsTrueSoul(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:dda39af4-a557-6f81-fb66-5f307a7e050b
msgctxt "h115fe4c3g6223g49d3g8613gc0cd4f7bb783"
msgid ""
"Not like me to overlook one of the Absolute's Chosen. Let myself get "
"distracted..."
msgstr "절대자님의 선택 받은 자를 얕잡아 본건 나 답지 않은데. 정신이 팔렸었군.."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = de65d42a-5861-3792-16ad-498e7f886a90
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_InjuredGnome_State_HasBoots(1) = True
#. SetFlags:
#.   Quest:
#.     - UND_LoneDuergar.ShownBoots(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:de65d42a-5861-3792-16ad-498e7f886a90
msgctxt "h9ecb8397g6002g4d36g8225g1e9ef457b7c6"
msgid "I've done as you asked - I have the boots."
msgstr "네가 부탁한 일을 했어- 내게 부츠가 있다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = dfc72f14-2eef-2b50-0c2f-900715cf29ee
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_InjuredGnome_State_HasBoots(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:dfc72f14-2eef-2b50-0c2f-900715cf29ee
msgctxt "h00616208gb70fg4735gb513gbea4af8002b2"
msgid "I don't have the boots."
msgstr "나에겐 부츠가 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = e0f369cf-d8d4-6f51-6db0-54c9b67fa269
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:e0f369cf-d8d4-6f51-6db0-54c9b67fa269
msgctxt "h23fc60a1gdc59g44bcga42fg7fb1298fb6a3"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = e12445b7-5194-4cd1-bf29-3f059a6d8a03
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:e12445b7-5194-4cd1-bf29-3f059a6d8a03
msgctxt "hbaf2325ag4438g41d6g91fbgb3ffb18046a6"
msgid ""
"<i>Share? </i>You really are in the wrong place, sun-scum. Try this for "
"useful:"
msgstr "<i>알려줘? </i>넌 진짜 잘못 찾아왔어, 이 쓰레기야. 이 말이나 새겨둬:"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = e143d0cf-e36b-243e-7673-87c468d4e117
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - DETECTTHOUGHTS(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:e143d0cf-e36b-243e-7673-87c468d4e117
msgctxt "h25809b86g96fdg4787g9378g5c1ae731f166"
msgid "<i>Read the duergar's thoughts.</i>"
msgstr "<i>듀에르가의 생각을 읽는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = e22739cf-a00f-3dce-3194-12cfad085640
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BRANDED(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:e22739cf-a00f-3dce-3194-12cfad085640
msgctxt "hddaa3df7g1654g48d5gb38dg596b8dc637e4"
msgid ""
"Especially if you don't have a brand. Ought to see to that... all due "
"respect."
msgstr "특히 네게 낙인이 없다면 말이지... 실례되지만 있나 봐야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = e22f9e80-7bde-514a-ffd3-980880c95c47
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - UND_LoneDuergar_DrowOrTrueSoulLeave(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:e22f9e80-7bde-514a-ffd3-980880c95c47
msgctxt "hc01070a3g5d9ag4353gbd9bgbd8441d21cf7"
msgid "Have fun with the slaves while I'm stuck here."
msgstr "내가 여기 쳐박혀있을 동안 노예들이랑 재미 좀 보라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = e2b7c673-2730-b4d3-ecb5-e9a4a1288fa5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_LoneDuerar_Knows_SlaveCamp(1) = True
#.   Global:
#.      - GLO_Absolute_Knows_Name = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:e2b7c673-2730-b4d3-ecb5-e9a4a1288fa5
msgctxt "h4cbdc377g83d0g4bd1g939fg683599f957dc"
msgid "What do you need slaves for?"
msgstr "노예들은 뭐 때문에 필요한데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = e39aa769-ae7c-26eb-5c75-addfd336c608
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:e39aa769-ae7c-26eb-5c75-addfd336c608
msgctxt "hc6f19044g0686g4947gbdcdg068fc3743d02"
msgid ""
"In fact, if you ain't with the Absolute, I reckon you're more like the "
"<i>enemy</i>."
msgstr "사실, 네가 절대자님의 수하라기보단.. <i>적</i>에 가까운거 같단말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = e3b5fd12-c4c1-ed2c-755d-7ed46836a70b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:e3b5fd12-c4c1-ed2c-755d-7ed46836a70b
msgctxt "h322b995dg8034g4f2dg8992g7f0ba20c6b00"
msgid "What part of 'not wasting words' didn't penetrate your skull?"
msgstr "'필요한 말만 해'의 어떤 부분이 네 대가리론 이해할 수 없는 거냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = e47d1738-f4d2-03ad-7e07-bb198858e64f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:e47d1738-f4d2-03ad-7e07-bb198858e64f
msgctxt "h4f7b3542g51a8g4125g9789gd46006c1f8ab"
msgid "Squad of my kin camping in some ruins. Pack of gnome slaves there, too."
msgstr "내 동족들이 어떤 유적에서 야영 중이야. 노움 노예 한 무리도 같이 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = e52c7e00-e69d-3adb-3fdd-7b6aaf2be664
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:e52c7e00-e69d-3adb-3fdd-7b6aaf2be664
msgctxt "h3b85e6dbgd981g4631g87deg5f20b7aca01d"
msgid "Besides, we're talking about a slave."
msgstr "게다가, 우린 노예에 대해 말하고 있잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = e5466132-e57b-3980-ceb6-9f3bcefe081d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:e5466132-e57b-3980-ceb6-9f3bcefe081d
msgctxt "h8ff4d6b7gb895g41f3g89f5g0cb8b6ee4847"
msgid "... that's right. You are a True Soul."
msgstr "...맞아, 넌 참된 영혼이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = e56fb502-2a5b-6b34-ac8d-02644687965c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:e56fb502-2a5b-6b34-ac8d-02644687965c
msgctxt "he8dd4671g3419g41b8g8c97g6fa56308fd71"
msgid "Funny. You looked like the sort to beg for mercy."
msgstr "재밌네, 자비를 구걸할 타입처럼 보였는데 말야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = e63a387f-85ee-511a-97b3-bd779585d408
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:e63a387f-85ee-511a-97b3-bd779585d408
msgctxt "h6386ff16gf590g4befgac9dg3df92eb6c78d"
msgid "Do what you will with the body... I couldn't care less."
msgstr "시체는 네 맘대로 해... 난 신경 안 쓸 테니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = e81b9ff8-46b2-4558-8752-905de5db5da8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_LoneDuergar_Knows_PlayerIsTrueSoul(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:e81b9ff8-46b2-4558-8752-905de5db5da8
msgctxt "h4795d5bbgf400g4b7bg915bgd0dad7bb567e"
msgid "Bet a True Soul can make those mushrooms choke on their spores."
msgstr "참된 영혼이라면 이 버섯대가리들이 포자에 질식하게 만들 수 있을 거라고 장담하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = e8fe61dc-8aa3-dcfb-e92c-c6281b3dd08b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:e8fe61dc-8aa3-dcfb-e92c-c6281b3dd08b
msgctxt "h156d9303g6f44g40c2gb2afg35d30f954c35"
msgid "Listen up then."
msgstr "그럼 잘 들어봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = ea4c2b9d-a7d3-8abc-3cf6-4bbf9d1d768a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_LoneDuergar_Knows_PlayerIsTrueSoul(1) = True
#.   Global:
#.      - UND_LoneDuergar_Quest_AttackMyconids = True
#.   Tag:
#.      - DROWELF(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:ea4c2b9d-a7d3-8abc-3cf6-4bbf9d1d768a
msgctxt "h428df19eg63f9g463aga3a4g7f1caff5002f"
msgid "How goes the hunt?"
msgstr "추적은 어떻게 돼 가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = eb4583aa-cb45-9c4a-7be6-b33600820b85
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:eb4583aa-cb45-9c4a-7be6-b33600820b85
msgctxt "h9979de73g341dg4131gb764gb686d58ee370"
msgid ""
"Doesn't look like you're showering yourself in glory so far, bumbling around "
"down here."
msgstr "이 아래에 처박혀서 삽질이나 하고 있는 걸 보니 명예를 얻긴 그른 거 같네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = eb4aa917-5d97-b9e2-94f2-99027a809fbc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DROWELF(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:eb4aa917-5d97-b9e2-94f2-99027a809fbc
msgctxt "h20ebdc15g71d1g44e3gbbe5g83145adafe5a"
msgid "You move pretty quietly. Not quietly enough for my liking, though."
msgstr "너는 꽤 조용히 움직이는군. 하지만 내 마음에 들 정도로 조용하지는 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Narrator
#. NodeID = eb64f8cc-9189-f604-7577-68bcd9393129
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount4(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount4(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:eb64f8cc-9189-f604-7577-68bcd9393129
msgctxt "hfef1851fg9eeag4c74gb184gf7f34fc52c64"
msgid ""
"*A shadow swims across your vision, and a familiar voice tells you to be "
"calm. You are loved.*"
msgstr "*그림자가 낀 듯이 눈앞이 흐려지더니, 익숙한 목소리가 당신을 달래줍니다. 사랑이 느껴집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = ebcf70c9-8aa2-00b0-b69f-0354caab9c36
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_LoneDuergar_Quest_RewardWaitingInCamp = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:ebcf70c9-8aa2-00b0-b69f-0354caab9c36
msgctxt "hdf210be8g6053g4a99gbb80g6722a5ebbaef"
msgid "Get those boots, then we can talk rewards."
msgstr "부츠를 가져와, 그럼 보상에 대해 이야기하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = ecbdfce0-1c7c-9fd9-25f4-a9470c4337f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:ecbdfce0-1c7c-9fd9-25f4-a9470c4337f1
msgctxt "h538dfb89g097fg4c1cg82b4g77b481ce6b8a"
msgid ""
"Look for a duergar with bare feet and a face like thunder. You can't miss "
"her."
msgstr "맨발에 번개같은 얼굴의 듀에르가를 찾고있어. 지나치기 힘들거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = ed3b1170-91a5-db60-6fba-a5e39e915b64
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Moonrise_Knows_Prisoners = False
#. SetFlags:
#.   Global:
#.     - GLO_Moonrise_Knows_Prisoners = True
#.     - GLO_Absolute_Knows_MoonriseTowers = True
#.     - GLO_Moonrise_Knows_AbsoluteAtGrymforge_NoName = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:ed3b1170-91a5-db60-6fba-a5e39e915b64
msgctxt "h0c857803g6181g4fceg8588g872367da98d7"
msgid ""
"Got them moving rubble. Need to clear a path through to some ruins. The "
"Absolute wants something tucked away in there, and we're to find it."
msgstr ""
"놈들을 이용해서 돌무더기를 치우고 있지. 무슨 폐허로 들어갈 길을 뚫어야 해. 절대자께서는 그 안에 있는 무언가를 원하시지, 우리가 그걸 "
"찾기를 원하시고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = ee2e0d41-5f9c-74d7-9b98-6cfb6eceec2d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:ee2e0d41-5f9c-74d7-9b98-6cfb6eceec2d
msgctxt "h1e1f9c34g2982g41bdg921age5a0ff090113"
msgid "Try, if you like. We'll see who gets hushed."
msgstr "시도해 보든가. 누가 닥치게 될지 보자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = ef580bd4-b2dd-030b-63e5-bdcddceeb2f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:ef580bd4-b2dd-030b-63e5-bdcddceeb2f5
msgctxt "hc3ba518dga9a0g41abga314gde769f2fbdfa"
msgid ""
"Deep gnome slave - they all look the same, but this one's got fancy boots."
msgstr "딥 노움 노예들은 다 똑같이 생겼지. 근데 이 녀석은 멋진 부츠가 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Narrator
#. NodeID = efe2d0f4-eb93-bb3f-6008-9f682b0fca82
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount5(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount5(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:efe2d0f4-eb93-bb3f-6008-9f682b0fca82
msgctxt "had61d36bg7058g41ebgbd24gdfbfd12865c3"
msgid ""
"*Your blood runs quicker, feeding the gnawing absence at the centre of your "
"mind.*"
msgstr "*피가 더 빨리 흐르면서, 당신의 정신 한가운데를 좀먹는 허전함을 양분으로 채웁니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = f017f741-765e-309b-2971-f76e10d4c44c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_LoneDuergar_Quest_ReadyToLeave = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:f017f741-765e-309b-2971-f76e10d4c44c
msgctxt "h4b0ba939g9cc2g4bd1gbef7g47a4257b6087"
msgid ""
"Right, I'll mop up here. You get across the Ebonlake - find Sergeant Thrinn. "
"She'll reward you."
msgstr "여긴 내가 정리하지. 칠흑호수를 건너 하사관 쓰린을 찾아. 그녀가 보상을 줄거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = f0deb8a0-a4bd-cf23-c18c-500b564581b9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_LoneDuergar_Knows_DuergarHuntGnome = True
#.   Quest:
#.     - UND_LoneDuergar.ToldQuest(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:f0deb8a0-a4bd-cf23-c18c-500b564581b9
msgctxt "h0a69b124ga5b9g4b60g9f76gcb3e1a88a9e9"
msgid ""
"Got to kill the slave and fetch back the leather, or the bosses in "
"Moonrise'll have Thrinn's hide."
msgstr "노예를 죽이고 부츠를 되찾지 못하면, 문라이즈의 윗사람들이 쓰린의 가죽을 벗길 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = f447edcb-3e43-1456-bc8a-6926c51c630a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_LoneDuergar_Quest_AttackMyconids = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:f447edcb-3e43-1456-bc8a-6926c51c630a
msgctxt "h17bfeda4gff25g4bc0g9e0bg90e89eed5962"
msgid ""
"But that comes later. Boots first, then you'll get what's coming to you."
msgstr "그건 나중이야. 부츠 먼저, 그럼 뭔가를 얻을 수 있을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Narrator
#. NodeID = f57d868c-6ae2-096a-662d-2a5e499e7fff
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:f57d868c-6ae2-096a-662d-2a5e499e7fff
msgctxt "h37974340g39ebg4c3eg8370geffe402565fa"
msgid "*A shiver runs across your mind... You feel sated.*"
msgstr "*전율이 불현듯 머릿속을 스쳐 지나가고... 만족감이 듭니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Player
#. NodeID = f5ceb9a8-045f-fb36-5d49-5b767fa9a87a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:f5ceb9a8-045f-fb36-5d49-5b767fa9a87a
msgctxt "h98de523agf937g4d51g9af5gcb0646ec95d3"
msgid "A hunt? Charming, do tell!"
msgstr "사냥이라고? 끌리는데, 말해 봐!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = f7ef9419-427f-de65-ce81-a3d06c914b5a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:f7ef9419-427f-de65-ce81-a3d06c914b5a
msgctxt "hea7ed501g2ddfg488fgbaacg0f7afcba60c8"
msgid ""
"Can't get past those rotflowers. They get in your head, make you see things. "
"Half my squad jumped off a cliff, <i>laughing</i>."
msgstr ""
"이 썩은 꽃들을 지나가지 못하겠어. 이것들은 네 머릿속으로 들어가, 없는 것들을 보게 만들지. 분대 절반이 절벽에서 뛰어내렸다니깐, "
"<i>웃으면서 말이야</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = f853b6d1-f9b2-32ec-c94f-cd350a37dd33
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:f853b6d1-f9b2-32ec-c94f-cd350a37dd33
msgctxt "ha5219b2eg6f71g43a4gbc8agc7cec313fc40"
msgid ""
"You're either brave or stupid to be worried about your purse in these parts."
msgstr "여기서 네 지갑이나 걱정하는 건 용감하거나 멍청한 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = f993194f-ddeb-f31d-b21d-a3cb3f78c4ee
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:f993194f-ddeb-f31d-b21d-a3cb3f78c4ee
msgctxt "hedefb3fcg400ag40bcg8bc5gf60955b63fe3"
msgid "I'll fix that. Real quick and quiet."
msgstr "내가 고쳐줄게. 아주 빠르고 조용하게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = fae34f1c-e268-493f-761a-7cf762a9dfd8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:fae34f1c-e268-493f-761a-7cf762a9dfd8
msgctxt "he2b6282dgbca6g4675gbdc5g9a423abfc48d"
msgid "Shut up and listen."
msgstr "닥치고 좀 들어봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = fb0bd020-4afa-97c4-85eb-ec83eb0ee954
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:fb0bd020-4afa-97c4-85eb-ec83eb0ee954
msgctxt "h2bb0b2f8geb71g45b9g87cdg631ea1a93afe"
msgid ""
"No harm. Every army needs grunts to run in and die first. Even the "
"Absolute's."
msgstr "상관없어. 절대자님의 군대 또한 선봉에 서서 희생하는 총알받이가 필요한 법."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = fb67306e-d3c8-2e25-1ee7-56b1bcbda40c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:fb67306e-d3c8-2e25-1ee7-56b1bcbda40c
msgctxt "haa525b07g34eeg4b34g94ccg52c07aaeb730"
msgid ""
"You drow can be light on your feet. Must've been why you were sent to join "
"the hunt... Praise the Absolute."
msgstr "너희 드로우는 발이 가벼워. 추적에 합류하게 된 이유겠지... 절대자님 만세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = fb96cae7-a50f-f39a-9494-28622288f488
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_LoneDuergar_Knows_Hunting(1) = False
#. SetFlags:
#.   Dialog:
#.     - UND_LoneDuergar_Knows_Hunting(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:fb96cae7-a50f-f39a-9494-28622288f488
msgctxt "h62c854c2ge93ag44cfgbfe3gf0920694e4f4"
msgid "Hunting. Slave ran away. Took Sergeant Thrinn's boots."
msgstr "추적중이야. 노예가 도망갔어. 하사관 쓰린의 부츠를 들고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = fcd703aa-3639-2581-4a35-7fbb47839e38
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_LoneDuergar_Quest_ReadyToLeave = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:fcd703aa-3639-2581-4a35-7fbb47839e38
msgctxt "h81557ed8ge83fg4e95g9046g2a88c8fd5911"
msgid "You'll want to take those to Sergeant Thrinn - in the camp."
msgstr "이걸 야영지에 있는 하사관 쓰린에게 가져다 주는 게 좋을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = fd2702e5-8623-e779-63dd-1decac7cb497
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:fd2702e5-8623-e779-63dd-1decac7cb497
msgctxt "h56e7dfebge7feg4019gab94gf471bad5a38e"
msgid "Good. Can't let some runt make fools o' the Absolute's warriors."
msgstr "좋아. 어떤 찌끄레기가 절대자님의 전사를 놀려먹게 할 수는 없지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar
#. Speaker = Gekh Coal
#. NodeID = ffe23183-2bb3-e95f-df0f-72645ec5d1a5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_LoneDuergar_Quest_ReadyToLeave = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar:ffe23183-2bb3-e95f-df0f-72645ec5d1a5
msgctxt "hb477ff94g6491g439dgab62ga1ad89a1b4b6"
msgid ""
"I'll stay back here, see if I can find some more gnomes. A few more and I "
"reckon I could become a True Soul."
msgstr "난 여기서 기다리면서 잡아갈 노움이 더 있는지 한번 보겠다. 몇 놈만 더 잡아가면 나도 참된 영혼으로 거듭날지도 모르지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Underdark/UND_LoneDuergar_AD_AnimateDead
#. Speaker = Gekh Coal
#. NodeID = 4320423d-bea0-4334-8ced-9258d92b9db2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Underdark/UND_LoneDuergar_AD_AnimateDead:4320423d-bea0-4334-8ced-9258d92b9db2
msgctxt "he38c51e7g94e3g45a7g9141g725b9b02d436"
msgid "Death, be conquered!"
msgstr "죽어라, 굴복해라!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Underdark/UND_LoneDuergar_AD_CombatTurn
#. Speaker = Gekh Coal
#. NodeID = 8d3faf4e-e041-7504-6d46-c949a5fdab15
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Underdark/UND_LoneDuergar_AD_CombatTurn:8d3faf4e-e041-7504-6d46-c949a5fdab15
msgctxt "h1016d359ge809g41dfg8d89gd16cc8040024"
msgid "I am pain, I am torment, I am death."
msgstr "나는 고통이자, 고문이며, 죽음이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar_DeadDuergar_Dead
#. Speaker = Shattered Duergar
#. NodeID = 04f13a12-f8b1-0948-bc26-db4c9da201c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar_DeadDuergar_Dead:04f13a12-f8b1-0948-bc26-db4c9da201c1
msgctxt "h6b4b475bgf585g4aeaga56eg0fd8410a41bc"
msgid "Myconids... made me... hurt myself..."
msgstr "마이코니드가... 나를... 자해하게 만들었어..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar_DeadDuergar_Dead
#. Speaker = Narrator
#. NodeID = 09ce2cba-038c-f0d1-79ea-2d760f253cd6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar_DeadDuergar_Dead:09ce2cba-038c-f0d1-79ea-2d760f253cd6
msgctxt "h6a051c81g6f7dg4ae5gb30bga9535760a331"
msgid "*The corpse does not stir. It will answer no more questions.*"
msgstr "*시체는 움직이지 않습니다. 더 이상 어떤 질문에도 대답하지 않을 겁니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar_DeadDuergar_Dead
#. Speaker = Narrator
#. NodeID = 1d76ed8f-6614-12e2-a484-6fbe1806f485
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar_DeadDuergar_Dead:1d76ed8f-6614-12e2-a484-6fbe1806f485
msgctxt "he9355574gf23ag46b6gb4f9gb737cd3f0a34"
msgid "*The corpse does not stir. It will answer no more questions.*"
msgstr "*시체는 움직이지 않습니다. 더 이상 질문을 받지 않을 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar_DeadDuergar_Dead
#. Speaker = Narrator
#. NodeID = 27a7caf6-ad27-60e5-9511-30c96bc3c60b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar_DeadDuergar_Dead:27a7caf6-ad27-60e5-9511-30c96bc3c60b
msgctxt "h9c0a0ae7g0dc4g4253ga023g8419517d1625"
msgid "*The corpse regards you lifelessly.*"
msgstr "*시체가 생기 없는 모습으로 당신을 맞이합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar_DeadDuergar_Dead
#. Speaker = Player
#. NodeID = 52ed25a7-6431-d9c0-48bf-ce5d63603894
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar_DeadDuergar_Dead:52ed25a7-6431-d9c0-48bf-ce5d63603894
msgctxt "h62e853cag73f6g4c32g8fcfg62db5fd56e29"
msgid "What was your profession?"
msgstr "무슨 일을 했나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar_DeadDuergar_Dead
#. Speaker = Shattered Duergar
#. NodeID = 614975b2-75d1-2207-8e0f-cfc59b2d94eb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar_DeadDuergar_Dead:614975b2-75d1-2207-8e0f-cfc59b2d94eb
msgctxt "h82889a20g5acbg47c3gb8b5g7c1c931d0262"
msgid "Hunter... reaver... warrior of... the Absolute..."
msgstr "사냥꾼... 약탈자... 절대자의... 전사..."

