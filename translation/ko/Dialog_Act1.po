msgctxt "hf1004f2dg4697g452fg9806gfc0e6545cc6d"
msgid "*The corpse seems willing to speak - but not to its killer.*"
msgstr "*시체는 말할 의지가 있지만, 자신을 죽인 자와 대화하고 싶지는 않은 듯 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander_Dead
#. Speaker = Player
#. NodeID = a0d673b6-1688-b084-f12a-73027a86aefd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
