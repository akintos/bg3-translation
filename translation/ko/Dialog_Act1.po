#.     - GLO_Tadpoled_UsedToday1(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:8f77e9c8-6492-6efa-50ca-01f750282215
msgctxt "h4232e280g9d84g42dag8708gb25d4e1cfbb8"
msgid "I am a True Soul. Now once again - release the gnome."
msgstr "나는 참된 영혼이다. 자, 다시 말하지 - 저 노움을 풀어줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = 93a1cf22-2559-4339-dd80-af2342038f0e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_GnomeGoblinsPromisedLeave = True
#. SetFlags:
#.   Global:
#.     - WLD_FOR_GnomeGoblinsAngry = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:93a1cf22-2559-4339-dd80-af2342038f0e
msgctxt "ha35c1f59gccc4g4267g9617g182fe5fb1eb6"
msgid ""
"Back again? I gave my last bloody warning already. You've got a death wish, "
"I reckon..."
msgstr "다시 왔나? 지난번에 확실하게 경고해 준 것 같은데. 그렇다면, 죽고 싶은가 보군..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Narrator
#. NodeID = 93dedc86-6285-b8ab-ce94-cdae4cd1b54c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount6(2) = False
#.   Tag:
#.      - TRUESOUL(2) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount6(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:93dedc86-6285-b8ab-ce94-cdae4cd1b54c
msgctxt "hccb1a9e2g8f48g4890ga461g7c9dbda75fce"
msgid ""
"*The presence deep in your mind is awake, unblinking. This is it. A single "
"word pervades your consciousness: 'Soon'.*"
msgstr ""
"*당신의 정신 속 깊이 자리잡은 존재가 태연스레 깨어납니다. 올 것이 왔군요. 한 단어가 당신의 의식 속으로 스며듭니다. ‘곧’*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Player
#. NodeID = 95f0bcc4-500e-37a8-92c7-e36c272acebc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - WLD_UnfortunateGnome_Why(2) = True
#. SetFlags:
#.   Dialog:
#.     - WLD_UnfortunateGnome_PayShow(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:95f0bcc4-500e-37a8-92c7-e36c272acebc
msgctxt "hfb996939gdb8ag4264gac1dg55437ad25b4a"
msgid "It does look funny, I'll admit. Mind if I stay and watch a while?"
msgstr "인정하지, 확실히 재밌어 보이긴 하는군. 잠깐 같이 구경해도 될까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = 96515bf8-b30c-5551-c4b6-6a27caacd1c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:96515bf8-b30c-5551-c4b6-6a27caacd1c6
msgctxt "hb0ef1cb9g4786g4de0g9c31ge381883bf777"
msgid "Oh."
msgstr "아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Narrator
#. NodeID = 966ad163-17ad-9c49-4ef1-15fc56f62364
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TRUESOUL(2) = False
#. SetFlags:
#.   Tag:
#.     - TRUESOUL(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:966ad163-17ad-9c49-4ef1-15fc56f62364
msgctxt "h123ab157gab3bg442dgb543gd385f648bc3c"
msgid ""
"*Your mind is full, bursting with ecstasy and terror. Finally, it is coming. "
"You are becoming.*"
msgstr "*당신의 정신이 황홀경과 공포로 가득 차오릅니다. 마침내, 때가 됐군요. 당신은 변화 중입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Player
#. NodeID = 96945d7d-09b4-0d1d-816b-e84f28886ec5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:96945d7d-09b4-0d1d-816b-e84f28886ec5
msgctxt "hdd448925g9207g4d6dg8078g6464fbcd23cb"
msgid "<i>Attack the goblins.</i>"
msgstr "<i>고블린을 공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Player
#. NodeID = 9706fe96-290c-2590-34ae-bc93c0422e54
#. HandlePath = TaggedText[0].TagText[0]
