msgctxt "h28d483dcgc9a6g4693g8c25g7dadeaebc538"
msgid "*The door remains intact, despite your efforts.*"
msgstr "*당신의 노력에도 불구하고 문은 굳건히 서 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_TavernInvestigation_DesireDoor
#. Speaker = Player
#. NodeID = 91de0793-4b4b-90f2-d7ad-0519e9b9d301
#. HandlePath = TaggedText[0].TagText[0]
