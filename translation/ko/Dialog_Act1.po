msgctxt "h8637d5eagd599g40d4g912ag43fce7c37924"
msgid "What do you know about Orpheus?"
msgstr "오르페우스에 대해 뭘 알고 있지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_PAD_AnatomicalSketchesComment
#. Speaker = Player
#. NodeID = c1bac892-bf49-40cb-965e-8c97c975f0d2
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_PAD_AnatomicalSketchesComment:c1bac892-bf49-40cb-965e-8c97c975f0d2
msgctxt "h4ffc6456g4338g4ce7ga333g6925ca570204"
msgid "Is that a... <i>Ugh.</i> These mind flayer diagrams are too detailed."
msgstr "이건 좀...<i>으으.</i> 이 마인드 플레이어 그림은 너무 자세한데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_PAD_AnatomicalSketchesComment
#. Speaker = Player
#. NodeID = c1bac892-bf49-40cb-965e-8c97c975f0d2
