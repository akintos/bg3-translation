msgctxt "hd56b5329g12eag440bgb362gf54bf10385db"
msgid "The statue <i>speaks.</i> A warning from the past, no less."
msgstr "동상이 <i>말을 하는군.</i> 그것도 과거의 경고를."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_MagicMouthKnowledgeCheck
#. Speaker = Player
#. NodeID = 2420c80f-d697-492d-bac6-7c31ebddded4
