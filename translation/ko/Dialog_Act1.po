msgctxt "hfaad2dbbg0937g4a03g8e36g8433743a34f2"
msgid "Right away."
msgstr "지금 바로요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_UnfortunateGnome_SlowDown
#. Speaker = Fezzerk
#. NodeID = 55b3f128-5bcc-7b26-dd4c-24d8f8227af1
