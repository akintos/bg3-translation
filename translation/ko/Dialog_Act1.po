msgctxt "h3c56f04dg05e9g458egb1bfg0cd003744745"
msgid "Pretty pin. Might be worth a few coins."
msgstr "예쁜 핀이네. 적당한 값에 팔 수 있겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_DuergarCamp_PAD_HarperPin
#. Speaker = Player
#. NodeID = 6a26e383-a2af-480a-8bf4-32f0f9939cc6
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_DuergarCamp_HarperPin_HistoryPassed(0) = False
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_DuergarCamp_PAD_HarperPin:6a26e383-a2af-480a-8bf4-32f0f9939cc6
msgctxt "hd2fc1d3dgf0abg4bafga1bcg1f95dc45727f"
msgid "That pin's design looks familiar, but I can't seem to place it."
msgstr "저 핀이 뭔가 익숙하긴 한데, 뭔지는 모르겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_DuergarCamp_PAD_HarperPin
#. Speaker = Player
#. NodeID = 6a26e383-a2af-480a-8bf4-32f0f9939cc6
