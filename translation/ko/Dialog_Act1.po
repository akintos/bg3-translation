#. CheckFlags:
#.   Global:
#.      - FOR_IncompleteMasterwork_Knows_ApprenticePlans = True
#. TagRule: REALLY_GENERIC
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Blueprints_PAD:ff177c6c-cd38-4e45-8c47-35bb5ab48cd2
msgctxt "h4fe15bffged41g4b83g9ce5gc947d23d6598"
msgid "The blacksmith's blueprints. Weapons, from the looks of it."
msgstr "대장장이의 청사진이야. 무기를 위한 것이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_AD_EttercapDisturbanceWarning
#. Speaker = GROUP_Act1_FOR_BottomlessEttercaps
#. NodeID = 8d96025a-17e6-5f09-b710-3f062bf866ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_AD_EttercapDisturbanceWarning:8d96025a-17e6-5f09-b710-3f062bf866ad
msgctxt "h309468b6g0ec4g4f43gba89gfcf699cc63c9"
msgid "*Screech.*"
msgstr "*끼익.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_InteractWithWell
#. Speaker = Player
#. NodeID = 0df1cf04-fd74-bf53-d43f-a67665322255
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - FOR_BottomlessWell_InteractWithWell_Knows_ThrewCopper(1) = False
#.   Script:
#.      - GEN_CheckPocketGold_2 = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_InteractWithWell:0df1cf04-fd74-bf53-d43f-a67665322255
msgctxt "ha3c643fag2090g4bb7gbd45g7ce30991f254"
msgid "<i>Throw a coin into the well.</i>"
msgstr "<i>우물 속으로 동전을 던져본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_InteractWithWell
#. Speaker = Player
#. NodeID = 10440ba9-39c9-8489-75b1-76426b9be5a1
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 10
#. CheckFlags:
#.   Dialog:
#.      - FOR_BottomlessWell_InteractWithWell_Knows_LookedDown(1) = False
#. SetFlags:
#.   Dialog:
#.     - FOR_BottomlessWell_InteractWithWell_Knows_LookedDown(1) = True
#.   Party:
#.     - FOR_Bottomless_State_InteractedWithWell(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_InteractWithWell:10440ba9-39c9-8489-75b1-76426b9be5a1
msgctxt "h6e9476begef03g4140gb26fg241183abb5a3"
msgid "<i>Peer into the well.</i>"
msgstr "<i>우물 속을 살펴본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_InteractWithWell
#. Speaker = Narrator
#. NodeID = 30ef8488-f55a-4093-8df4-9bfdd7e39a52
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Party:
#.      - FOR_Bottomless_State_InteractedWithWell(1) = False
#. SetFlags:
#.   Party:
#.     - FOR_Bottomless_State_InteractedWithWell(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_InteractWithWell:30ef8488-f55a-4093-8df4-9bfdd7e39a52
msgctxt "h7f12e361ga763g41acga1b4ga4c778a09183"
msgid "*Apart from an overgrowth of moss, the well looks unremarkable.*"
msgstr "*이끼가 무성하게 자란 것을 제외하면, 우물은 별다른 특징이 없어 보입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_InteractWithWell
#. Speaker = Narrator
#. NodeID = 33b533fa-826d-5740-8f5a-7791ada8bd35
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Party:
#.     - FOR_BottomlessWell_InteractWithWell_Knows_LookedDownSuccess(1) = True
#.     - FOR_Bottomless_State_FoundWellEntrance(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_InteractWithWell:33b533fa-826d-5740-8f5a-7791ada8bd35
msgctxt "h6a445f1fg4cbfg447bgaf9ege12fdb79359f"
msgid ""
"*Dry stones line the wall. At the bottom, something gleams in the dappled "
"light.*"
msgstr "*마른 돌들이 벽에 늘어서 있습니다. 바닥에는 얼룩덜룩한 빛에 반짝이는 무언가가 있는 것 같습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_InteractWithWell
#. Speaker = Narrator
#. NodeID = 406d14d5-b438-8d03-34f0-ac1bf6a62e62
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_InteractWithWell:406d14d5-b438-8d03-34f0-ac1bf6a62e62
msgctxt "h9980d0d6g338fg467ag89d2g1e837da1e9d1"
msgid "*Dry stones line the wall, but the darkness below is impenetrable.*"
msgstr "*마른 돌들이 벽을 따라 늘어서 있지만, 그 아래는 너무 어두워 볼 수 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_InteractWithWell
#. Speaker = Narrator
#. NodeID = 4ef3dfaf-585a-0d99-6ba2-f26c19ee258c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Party:
#.      - FOR_Bottomless_State_FoundWellEntrance(1) = True
#.   Script:
#.      - GEN_CheckPocketGold = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_InteractWithWell:4ef3dfaf-585a-0d99-6ba2-f26c19ee258c
msgctxt "h73e244d5g2d9fg40f6g9ca3g6232a15821ae"
msgid ""
"*The coin disappears into the darkness, landing with a soft <i>clink</i>.*"
msgstr "*동전이 부드러운 <i>짤랑</i> 소리와 함께 어둠 속으로 사라집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_InteractWithWell
#. Speaker = Narrator
#. NodeID = 4f10c5a1-8b04-85ed-7f3a-fc1b2ff88751
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FOR_BottomlessWell_InteractWithWell_Knows_ThrewCopper(1) = True
#.   Party:
#.     - FOR_Bottomless_State_FoundWellEntrance(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_InteractWithWell:4f10c5a1-8b04-85ed-7f3a-fc1b2ff88751
msgctxt "h3e9ff28bg4915g424cg9cfeg11398536892e"
msgid ""
"*The coin disappears into the well. After a moment, you hear a soft <i>clink "
"</i>- not a splash.*"
msgstr "*동전이 우물 속으로 사라집니다. 잠시 후, 물에 빠지는 소리가 아닌, 부드럽게<i> 짤랑 </i>하는 소리가 들려옵니다. *"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_InteractWithWell
#. Speaker = Narrator
#. NodeID = 5e044c12-b2ad-d4fb-df77-7762d7cb6903
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Party:
#.      - FOR_Bottomless_State_FoundWellEntrance(1) = True
#.      - FOR_Bottomless_State_InteractedWithWell(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_InteractWithWell:5e044c12-b2ad-d4fb-df77-7762d7cb6903
msgctxt "hbefc41c4g0d59g4cd1g9462g276173b4c629"
msgid ""
"*The well doesn't look too deep, and the old bucket rope feels strong "
"enough.*"
msgstr "*우물이 너무 깊어 보이지 않고 오래된 양동이 밧줄도 충분히 튼튼해 보입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_InteractWithWell
#. Speaker = Player
#. NodeID = 64bb783e-8a74-70af-4c56-f258216f6a1a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Party:
#.      - FOR_Bottomless_State_FoundWellEntrance(1) = True
#. SetFlags:
#.   Global:
#.     - FOR_Bottomless_Event_DescendedWell = True
#.   Party:
#.     - FOR_Bottomless_State_FoundWellEntrance(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_InteractWithWell:64bb783e-8a74-70af-4c56-f258216f6a1a
msgctxt "h43d68721gd896g4e56g9188g3b943552a0d3"
msgid "<i>Climb down the bucket rope.</i>"
msgstr "<i>양동이 밧줄을 잡고 아래로 내려간다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_InteractWithWell
#. Speaker = Player
#. NodeID = c1f1bea8-68d1-8693-790b-e3989130f88c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_InteractWithWell:c1f1bea8-68d1-8693-790b-e3989130f88c
msgctxt "hc6149c0bg2727g4631gb206g67892d2d6f4d"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_InteractWithWell
#. Speaker = Narrator
#. NodeID = f705d706-477f-5b2a-6b33-7b55a1f23910
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Party:
#.      - FOR_Bottomless_State_FoundWellEntrance(1) = False
#.      - FOR_Bottomless_State_InteractedWithWell(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_InteractWithWell:f705d706-477f-5b2a-6b33-7b55a1f23910
msgctxt "hd92e7283gf9a2g4d60gad07g2cd420e8f2d1"
msgid "*The well stands, as it has for ages.*"
msgstr "*우물은 오래전부터 그랬던 것처럼 그대로 서 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_PAD_WebWarning
#. Speaker = Player
#. NodeID = 8b8f9633-6b35-7cf5-15a6-e1cc5aac505e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_Bottomless_State_SurvivalCheckSuccess = True
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_PAD_WebWarning:8b8f9633-6b35-7cf5-15a6-e1cc5aac505e
msgctxt "h532333abg63feg43bcg9190g4391c3356549"
msgid "Better not touch the webs. I'd hate to disturb the locals."
msgstr "거미줄은 건들지 말자고. 동네방네 들쑤셔서 좋을 거 없잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_PAD_WebWarning
#. Speaker = Player
#. NodeID = 8b8f9633-6b35-7cf5-15a6-e1cc5aac505e
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_Bottomless_State_SurvivalCheckSuccess = True
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_PAD_WebWarning:8b8f9633-6b35-7cf5-15a6-e1cc5aac505e
msgctxt "h95a1104dg4af0g44aag9982g5a7eb73cf97b"
msgid ""
"Better not disturb these webs. Whatever wove them would be much too large "
"for my liking."
msgstr "거미줄은 들쑤시지 말자고. 누가 거미줄을 쳤는지는 몰라도 몸집이 상당하겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_PAD_WebWarning
#. Speaker = Player
#. NodeID = 8b8f9633-6b35-7cf5-15a6-e1cc5aac505e
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_Bottomless_State_SurvivalCheckSuccess = True
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_PAD_WebWarning:8b8f9633-6b35-7cf5-15a6-e1cc5aac505e
msgctxt "hdb674e72gd27fg4079gbc46gd2bbfd1fc87a"
msgid "Keep clear of the webs, and the spiders might not notice us.\n"
msgstr "거미줄만 안 건드리면 거미들한테 들키지 않을지도 몰라.\n"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_PAD_WebWarning
#. Speaker = Player
#. NodeID = 8b8f9633-6b35-7cf5-15a6-e1cc5aac505e
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_Bottomless_State_SurvivalCheckSuccess = True
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_PAD_WebWarning:8b8f9633-6b35-7cf5-15a6-e1cc5aac505e
msgctxt "hd6e44ee8gd05eg46f7g9f74g369bc7d22544"
msgid "Giant webs. They'll alert their spinners with a mere touch."
msgstr "거대 거미줄. 만지기만 해도 거미들에게 들킬거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_PAD_WebWarning
#. Speaker = Player
#. NodeID = 8b8f9633-6b35-7cf5-15a6-e1cc5aac505e
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_Bottomless_State_SurvivalCheckSuccess = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_PAD_WebWarning:8b8f9633-6b35-7cf5-15a6-e1cc5aac505e
msgctxt "hc3b9ecdbgc21eg4bc9gba7cgff6287d5bd93"
msgid "Best not touch those webs or I'll end up as a meal."
msgstr "먹거리가 되고 싶지 않다면 거미줄을 건드리지 않는 게 좋겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_PAD_WebWarning
#. Speaker = Player
#. NodeID = 8b8f9633-6b35-7cf5-15a6-e1cc5aac505e
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_Bottomless_State_SurvivalCheckSuccess = True
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_PAD_WebWarning:8b8f9633-6b35-7cf5-15a6-e1cc5aac505e
msgctxt "h55ebf178gf258g4bdbga797g604addb4fea2"
msgid "Those webs are huge. Tread lightly, or become dinner."
msgstr "저 거미줄은 거대하군. 조심히 밟아. 안 그러면 식사가 될 테니까.\n"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_PAD_WebWarning
#. Speaker = Player
#. NodeID = 8b8f9633-6b35-7cf5-15a6-e1cc5aac505e
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_Bottomless_State_SurvivalCheckSuccess = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_PAD_WebWarning:8b8f9633-6b35-7cf5-15a6-e1cc5aac505e
msgctxt "he2d4b475g3fc7g4686ga41dg45cf11c972ed"
msgid "Better be careful - those webs carry vibrations."
msgstr "조심하는 게 좋겠어, 저 거미줄은 진동을 감지해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_PAD_WebWarning
#. Speaker = Player
#. NodeID = c40173f7-98c7-e141-7880-8c3aaedde327
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_Bottomless_State_SurvivalCheckSuccess = False
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_PAD_WebWarning:c40173f7-98c7-e141-7880-8c3aaedde327
msgctxt "hf6716d00gc839g4891g8a75gf6908116716b"
msgid "Webs everywhere. Feels like home."
msgstr "거미줄투성이로군. 집에 온 기분이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_PAD_WebWarning
#. Speaker = Player
#. NodeID = c40173f7-98c7-e141-7880-8c3aaedde327
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_Bottomless_State_SurvivalCheckSuccess = False
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_PAD_WebWarning:c40173f7-98c7-e141-7880-8c3aaedde327
msgctxt "hf9d08f87g0763g4c5fg8702g30a63fbd626a"
msgid ""
"Impressive webbing. Though I should probably worry about its creators.\n"
"\n"
msgstr ""
"거미줄이 예술인걸. 그러고 보니 한가롭게 감상하고 있을 때가 아니지.\n"
"\n"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_PAD_WebWarning
#. Speaker = Player
#. NodeID = c40173f7-98c7-e141-7880-8c3aaedde327
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_Bottomless_State_SurvivalCheckSuccess = False
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_PAD_WebWarning:c40173f7-98c7-e141-7880-8c3aaedde327
msgctxt "h6b8cd956g9414g47dfg9b02g6ea105d499f0"
msgid ""
"Oh good. Spiders.\n"
"\n"
msgstr ""
"환장하겠군. 거미 소굴이잖아.\n"
"\n"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_PAD_WebWarning
#. Speaker = Player
#. NodeID = c40173f7-98c7-e141-7880-8c3aaedde327
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_Bottomless_State_SurvivalCheckSuccess = False
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_PAD_WebWarning:c40173f7-98c7-e141-7880-8c3aaedde327
msgctxt "h643db924gd4f1g4171gbaeag6c3b8a90e495"
msgid "Webs everywhere. Which means spiders anywhere."
msgstr "사방이 거미줄이군. 그 말은 거미도 사방에 깔려 있다는 거지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_PAD_WebWarning
#. Speaker = Player
#. NodeID = c40173f7-98c7-e141-7880-8c3aaedde327
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_Bottomless_State_SurvivalCheckSuccess = False
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_PAD_WebWarning:c40173f7-98c7-e141-7880-8c3aaedde327
msgctxt "h227f1ad3gd169g4486gb6dag00cff30e89f4"
msgid "You could spin a cloak from all these cobwebs."
msgstr "이 정도 거미줄이면 망토를 짤 수도 있겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_PAD_WebWarning
#. Speaker = Player
#. NodeID = c40173f7-98c7-e141-7880-8c3aaedde327
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_Bottomless_State_SurvivalCheckSuccess = False
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_PAD_WebWarning:c40173f7-98c7-e141-7880-8c3aaedde327
msgctxt "he64e2b9bg0785g4253ga6a8g3e00ff396832"
msgid "Lovely. The webs are <i>everywhere.</i>\n"
msgstr "죽여 주네. <i>사방이</i> 거미줄이야.\n"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_PAD_WebWarning
#. Speaker = Player
#. NodeID = c40173f7-98c7-e141-7880-8c3aaedde327
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_Bottomless_State_SurvivalCheckSuccess = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_PAD_WebWarning:c40173f7-98c7-e141-7880-8c3aaedde327
msgctxt "h9706f9d5g3271g4eefgb73egd92aa9ab5b3f"
msgid "These webs are everywhere.\n"
msgstr "사방이 거미줄투성이야.\n"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_VB_DiscoverUnderdarkEntrance
#. Speaker = Player
#. NodeID = ca3490ba-c4bd-ee27-a9c3-fd7aba7dbf5d
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_VB_DiscoverUnderdarkEntrance:ca3490ba-c4bd-ee27-a9c3-fd7aba7dbf5d
msgctxt "ha623ed06ge1fcg4a6cgac2ega1202cd9bd8a"
msgid "I smell adventure! And rain water."
msgstr "모험의 냄새가 나! 빗물 냄새도 나고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_VB_DiscoverUnderdarkEntrance
#. Speaker = Player
#. NodeID = ca3490ba-c4bd-ee27-a9c3-fd7aba7dbf5d
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_VB_DiscoverUnderdarkEntrance:ca3490ba-c4bd-ee27-a9c3-fd7aba7dbf5d
msgctxt "h43f99954g5406g4335ga4c5gda0a99dc3b8e"
msgid "Lead the way."
msgstr "앞장서라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_VB_DiscoverUnderdarkEntrance
#. Speaker = Player
#. NodeID = ca3490ba-c4bd-ee27-a9c3-fd7aba7dbf5d
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_VB_DiscoverUnderdarkEntrance:ca3490ba-c4bd-ee27-a9c3-fd7aba7dbf5d
msgctxt "h0f33ca89g58fbg438agbdeag882562bf1683"
msgid ""
"Mind your footing. The bones of the careless are probably littered down "
"there."
msgstr "발밑 조심해. 덤벙대다 죽은 자들의 뼈가 가득할 테니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_VB_DiscoverUnderdarkEntrance
#. Speaker = Player
#. NodeID = ca3490ba-c4bd-ee27-a9c3-fd7aba7dbf5d
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_VB_DiscoverUnderdarkEntrance:ca3490ba-c4bd-ee27-a9c3-fd7aba7dbf5d
msgctxt "h7c203fd2g5617g49e9g9850ge102ef8fc25c"
msgid "By all means - you first."
msgstr "기꺼이 양보할게, 먼저 내려가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_VB_DiscoverUnderdarkEntrance
#. Speaker = Player
#. NodeID = ca3490ba-c4bd-ee27-a9c3-fd7aba7dbf5d
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_VB_DiscoverUnderdarkEntrance:ca3490ba-c4bd-ee27-a9c3-fd7aba7dbf5d
msgctxt "hd565e4f3g6b6eg474cg86dfgbb22945b163d"
msgid "This is a bad idea."
msgstr "안 좋은 예감이 드는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_VB_DiscoverUnderdarkEntrance
#. Speaker = Player
#. NodeID = ca3490ba-c4bd-ee27-a9c3-fd7aba7dbf5d
#. HandlePath = TaggedText[5].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_VB_DiscoverUnderdarkEntrance:ca3490ba-c4bd-ee27-a9c3-fd7aba7dbf5d
msgctxt "h3fa5f468g1d99g426ega87egfdaf9e37a14b"
msgid "Well. After you."
msgstr "그럼 먼저 가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_VB_DiscoverUnderdarkEntrance
#. Speaker = Player
#. NodeID = d9f64d14-09f4-83cf-c276-15bb3544797b
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_VB_DiscoverUnderdarkEntrance:d9f64d14-09f4-83cf-c276-15bb3544797b
msgctxt "h2a9d4c5ag5c8cg4c9bg835agf3e79bd70bc8"
msgid ""
"There's something hiding in that deep unknown... Get behind me, I can look "
"first."
msgstr "저 깊은 미지의 세계에 뭔가가 숨어 있군... 내 뒤에 있어. 내가 먼저 볼게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_VB_DiscoverUnderdarkEntrance
#. Speaker = Player
#. NodeID = d9f64d14-09f4-83cf-c276-15bb3544797b
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_VB_DiscoverUnderdarkEntrance:d9f64d14-09f4-83cf-c276-15bb3544797b
msgctxt "h819974c7gbbffg4aa7gb23dg3f80ccdf616c"
msgid "Feel that? A breeze. Something's down there."
msgstr "미세한 바람이 느껴져? 저 아래에 뭔가 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_VB_DiscoverUnderdarkEntrance
#. Speaker = Player
#. NodeID = d9f64d14-09f4-83cf-c276-15bb3544797b
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_VB_DiscoverUnderdarkEntrance:d9f64d14-09f4-83cf-c276-15bb3544797b
msgctxt "h74c54e9fgc778g48acg9756g6138bf360607"
msgid "Endless dark. Transfixing, isn't it? Who knows what's down there."
msgstr "끝없는 어둠이네. 발이 안 떨어지지? 저 밑에 뭐가 있는지 누가 알겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_VB_DiscoverUnderdarkEntrance
#. Speaker = Player
#. NodeID = d9f64d14-09f4-83cf-c276-15bb3544797b
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_VB_DiscoverUnderdarkEntrance:d9f64d14-09f4-83cf-c276-15bb3544797b
msgctxt "h3ec08dd6g398eg4cf4gaec4gbf0d5c5fd88d"
msgid "I wonder what's hiding down in all that darkness."
msgstr "저 어둠 너머에 뭐가 숨어 있을지 궁금한걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_VB_DiscoverUnderdarkEntrance
#. Speaker = Player
#. NodeID = d9f64d14-09f4-83cf-c276-15bb3544797b
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_VB_DiscoverUnderdarkEntrance:d9f64d14-09f4-83cf-c276-15bb3544797b
msgctxt "h84273055g3f22g49ccgb44cge08a4ba7f954"
msgid "How far down does it go?"
msgstr "얼마나 깊은 걸까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_VB_DiscoverUnderdarkEntrance
#. Speaker = Player
#. NodeID = d9f64d14-09f4-83cf-c276-15bb3544797b
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_VB_DiscoverUnderdarkEntrance:d9f64d14-09f4-83cf-c276-15bb3544797b
msgctxt "h179f94b2g1ec3g4437g9fe1gf2711899c3f2"
msgid "There's something ominous about such depths. I wonder how deep it goes."
msgstr "이런 지하엔 뭔가 불길한 점이 있어. 얼마나 깊을지 궁금한걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_VB_DiscoverUnderdarkEntrance
#. Speaker = Player
#. NodeID = d9f64d14-09f4-83cf-c276-15bb3544797b
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_VB_DiscoverUnderdarkEntrance:d9f64d14-09f4-83cf-c276-15bb3544797b
msgctxt "h578acaf5g0dfcg444dgafacg0af6554b741e"
msgid "I feel a breeze - I wonder what's down there."
msgstr "미세한 바람이 느껴져 - 저 아래에 뭐가 있을지 궁금한걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_VB_EnterNest
#. Speaker = Player
#. NodeID = 19e881f1-bcae-6ecd-5694-f7faffa3e65b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BottomlessWell_VB_EnterNest:19e881f1-bcae-6ecd-5694-f7faffa3e65b
msgctxt "h4109d546g8db6g4681gbfd7g7afff6487704"
msgid "Oh, <i>hells</i>."
msgstr "아, <i>젠장.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Bottomless_PAD_PlayerHeardEttercapWarning
#. Speaker = Player
#. NodeID = 7c7aea5f-7383-af90-0ce4-73aa1a1e8c99
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Bottomless_PAD_PlayerHeardEttercapWarning:7c7aea5f-7383-af90-0ce4-73aa1a1e8c99
msgctxt "h1a501e25g148ag47e8g9153g75222a82e41b"
msgid "Well, that can't be good."
msgstr "이런, 좋은 일은 아닌 것 같네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Bottomless_PAD_PlayerHeardEttercapWarning
#. Speaker = Player
#. NodeID = 7c7aea5f-7383-af90-0ce4-73aa1a1e8c99
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Bottomless_PAD_PlayerHeardEttercapWarning:7c7aea5f-7383-af90-0ce4-73aa1a1e8c99
msgctxt "he830e442g96d0g4820g8b5eg250de9b0bad2"
msgid "We woke something. Most likely not from a beauty sleep."
msgstr "무언가를 깨운 것 같아. 숙면을 방해한 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Bottomless_PAD_PlayerHeardEttercapWarning
#. Speaker = Player
#. NodeID = 7c7aea5f-7383-af90-0ce4-73aa1a1e8c99
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Bottomless_PAD_PlayerHeardEttercapWarning:7c7aea5f-7383-af90-0ce4-73aa1a1e8c99
msgctxt "h06bef99bg8840g485fgb68dg384ff5ffce35"
msgid "Come out and fight me.\n"
msgstr "이리 나와! 정정당당하게 싸우자!\n"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Bottomless_PAD_PlayerHeardEttercapWarning
#. Speaker = Player
#. NodeID = 7c7aea5f-7383-af90-0ce4-73aa1a1e8c99
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Bottomless_PAD_PlayerHeardEttercapWarning:7c7aea5f-7383-af90-0ce4-73aa1a1e8c99
msgctxt "h3aefca58g7cc7g4093g9956g0dd99a2ca00b"
msgid "We woke something up. And it isn't happy."
msgstr "뭔가 깨어난 것 같아. 기뻐 보이진 않는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Bottomless_PAD_PlayerHeardEttercapWarning
#. Speaker = Player
#. NodeID = 7c7aea5f-7383-af90-0ce4-73aa1a1e8c99
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Bottomless_PAD_PlayerHeardEttercapWarning:7c7aea5f-7383-af90-0ce4-73aa1a1e8c99
msgctxt "h55cc7504g19f1g4513ga0dbgc1583a097a98"
msgid "Sounds like something's less than pleased..."
msgstr "기분이 좋아 보이진 않는데..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Bottomless_PAD_PlayerHeardEttercapWarning
#. Speaker = Player
#. NodeID = 7c7aea5f-7383-af90-0ce4-73aa1a1e8c99
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Bottomless_PAD_PlayerHeardEttercapWarning:7c7aea5f-7383-af90-0ce4-73aa1a1e8c99
msgctxt "h8d5e93f6gbfb3g40a8ga8b1g2dc8014f6011"
msgid "Uh-oh. What is it they say about curiosity and cats?"
msgstr "이런. 호기심과 고양이랑 관련된 속담이 뭐더라?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Bottomless_PAD_PlayerHeardEttercapWarning
#. Speaker = Player
#. NodeID = 7c7aea5f-7383-af90-0ce4-73aa1a1e8c99
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Bottomless_PAD_PlayerHeardEttercapWarning:7c7aea5f-7383-af90-0ce4-73aa1a1e8c99
msgctxt "h8daecb1fgca17g4e2bgbcedg974041f18618"
msgid "Something didn't like that."
msgstr "뭔가 화가 난 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear
#. Speaker = Player
#. NodeID = 0b5e1ad7-7ce9-2a0a-0c9b-7fbcb4bb7cfc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear:0b5e1ad7-7ce9-2a0a-0c9b-7fbcb4bb7cfc
msgctxt "hca6a8cb0g7147g43bag9bfbg20e2a8ac7baf"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear
#. Speaker = Player
#. NodeID = 13b5d507-a37f-d63c-f9f3-2b4f02b3daa0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear:13b5d507-a37f-d63c-f9f3-2b4f02b3daa0
msgctxt "hb6407c05gfff7g4eedg9304ga31b5087b57a"
msgid "<i>Open the door anyway.</i>"
msgstr "<i>무시하고 문을 연다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear
#. Speaker = Grukkoh
#. NodeID = 16fa2b5d-db08-bbb1-6a5d-bf6e77356051
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear:16fa2b5d-db08-bbb1-6a5d-bf6e77356051
msgctxt "h4d9a9935g002cg4b44g965egf3d3226ed808"
msgid "Puny?! I'll show you puny!"
msgstr "보잘것없다고?! 내가 보잘것없는 게 뭔지 보여주지!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear
#. Speaker = Narrator
#. NodeID = 1fac0de2-625e-9302-c091-f9e8dd9f1fae
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_BugBear_EavesdroppingSucceeded = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear:1fac0de2-625e-9302-c091-f9e8dd9f1fae
msgctxt "hac86c845g1991g4e23g87c2g9e8992b61d26"
msgid ""
"*Then a low moan. Someone - or <i>something </i>- is having a bit of fun.*"
msgstr "*그러더니 낮은 신음소리가 들립니다. 누군가, 또는 <i>무언가가 </i>즐거운 시간을 보내고 있는 것 같습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear
#. Speaker = Astarion
#. NodeID = 27ade790-8de8-f606-7826-4e68acab3020
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_BugBearLove_State_CompanionIntervened = False
#.   Script:
#.      - GEN_IsSpeakerPresent_6 = True
#. SetFlags:
#.   Global:
#.     - FOR_BugBearLove_State_CompanionIntervened = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear:27ade790-8de8-f606-7826-4e68acab3020
msgctxt "h61ab873dg9a37g4466g9fc2gdc0c80dabdc1"
msgid "Wait! Don't interrupt them."
msgstr "잠깐! 그들을 방해하지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear
#. Speaker = Player
#. NodeID = 39e82735-0b5a-f5c9-d59a-8bf0cb7dea64
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_BugBear_Knows_InterruptedOnce(2) = False
#. SetFlags:
#.   Dialog:
#.     - FOR_BugBear_Knows_InterruptedOnce(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear:39e82735-0b5a-f5c9-d59a-8bf0cb7dea64
msgctxt "h029e9dcag7503g461cga1aegd66a0fc7a281"
msgid "Hello? Anybody in there?"
msgstr "저기? 안에 누군가 있나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear
#. Speaker = Grukkoh
#. NodeID = 3a1029da-a15e-7114-5c94-ec86910b43f6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear:3a1029da-a15e-7114-5c94-ec86910b43f6
msgctxt "ha3da113dg3616g4614g9133ga8e9b048656a"
msgid "Tell of my rutting? My virility?"
msgstr "내 허리 놀림에 대해서 이야기 하는 거야? 내 정력에 대해?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear
#. Speaker = Player
#. NodeID = 47186c1e-f22b-1f12-cda8-9acbfdd340fc
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARD(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear:47186c1e-f22b-1f12-cda8-9acbfdd340fc
msgctxt "h6e64c08bg2101g4c65gb6e4ge1a77a253df5"
msgid ""
"Do carry on. There's bookshops in Baldur's Gate that'd pay well for this "
"kind of smut."
msgstr "계속해. 발더스 게이트에는 이런 종류의 음란물을 비싸게 팔 수 있는 서점이 있으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear
#. Speaker = Narrator
#. NodeID = 4e8f5da9-1e2e-ea8d-17a5-d38043f0f062
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_BugBearLove_State_UsingDoor = True
#.      - FOR_BugBearLove_HasMet = False
#. SetFlags:
#.   Global:
#.     - FOR_BugBearLove_HasMet = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear:4e8f5da9-1e2e-ea8d-17a5-d38043f0f062
msgctxt "h600eedfeg9b1ag49bfg9a2bg0dbc6f7d04e8"
msgid ""
"*As you approach, a guttural scream and a succession of quick bangs rattle "
"the door.*"
msgstr "*가까이 다가가자, 목 뒷부분에서 나오는 듯한 신음과 재빠른 흔들림에 문이 흔들리고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear
#. Speaker = Player
#. NodeID = 510d5cfc-9f92-5982-7b30-87443e1f3b6a
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear:510d5cfc-9f92-5982-7b30-87443e1f3b6a
msgctxt "h97f8f73ege896g4cc0g8025ge3e8a97e3429"
msgid "<b>I'M LAUGHING AT YOUR PUNY RUTTING.</b>"
msgstr "<b>네 보잘것없는 정력에 웃음이 나는군.</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear
#. Speaker = Player
#. NodeID = 599f0a01-8174-583e-e9e3-a72ffe0f695d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear:599f0a01-8174-583e-e9e3-a72ffe0f695d
msgctxt "hd0d55244g67e5g45f1g9e15g197801e3a469"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear
#. Speaker = Buthir
#. NodeID = 6d14f174-6bd4-a102-d001-a85d4460f5a5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_BugBear_Event_Intimidated = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear:6d14f174-6bd4-a102-d001-a85d4460f5a5
msgctxt "hb598f6c9g8ab2g4c44g8e76gf7dea177cef2"
msgid ""
"ENOUGH! Moment ruined. Passion squished like slow goat under foot. We leave."
msgstr "<b>그만</b>! 분위기가 깨졌잖아. 뜨거운 사랑이 느려터진 염소처럼 짓밟혔어. 우린 떠난다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear
#. Speaker = Grukkoh
#. NodeID = 6f494b02-ba08-099e-1972-cf478e6c4a21
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear:6f494b02-ba08-099e-1972-cf478e6c4a21
msgctxt "h6037b257g20a7g42d2g856fg6b8ea42a8d27"
msgid "Puny?! I am strong! I am virile! I am -"
msgstr "보잘것없다고?! 난 강해! 정력이 넘친다고! 난..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear
#. Speaker = Player
#. NodeID = 78172827-827b-cb24-e34a-0f0bc6fbe235
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear:78172827-827b-cb24-e34a-0f0bc6fbe235
msgctxt "h53fa2742g9c39g48a3g9725g2c8d91f3aa09"
msgid "Please do the honours."
msgstr "그렇다면, 영광은 네게 돌리지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear
#. Speaker = Narrator
#. NodeID = 89a17e39-46b2-23c9-d3b8-2559bd7c9f4d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_BugBearLove_State_UsingDoor = True
#.      - FOR_BugBearLove_HasMet = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear:89a17e39-46b2-23c9-d3b8-2559bd7c9f4d
msgctxt "hf4ee329dg808fg4236gb810g604b4eb7b1ad"
msgid ""
"*You hear another muffled cry. The two inside are still in the throes of... "
"passion.*"
msgstr "*또다시 희미한 울음소리가 들립니다. 안쪽의 두 사람은 여전히... 뜨거운 소용돌이 속에 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear
#. Speaker = Player
#. NodeID = 8d953238-96dd-cee8-3adb-702a9c7eccfa
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_BugBearLove_Event_CoupleHostile = True
#.     - FOR_BugBearLove_Knows_Lovemaking = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear:8d953238-96dd-cee8-3adb-702a9c7eccfa
msgctxt "h314dc14bg0ffbg41caga19fg849a78191145"
msgid "<i>Attack the couple.</i>"
msgstr "<i>둘을 공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear
#. Speaker = Buthir
#. NodeID = 8e117745-8204-7512-b1df-c2fa5aaa788c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear:8e117745-8204-7512-b1df-c2fa5aaa788c
msgctxt "h4c70e5ceg0f54g4ea1gb996g47b62e2b9bb9"
msgid "Don't want this puny rutting written down."
msgstr "이런 보잘것없는 허리 놀림에 대해 쓰고 싶진 않군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear
#. Speaker = Player
#. NodeID = 93228ca7-baf2-f8d0-a777-81bd3077dcc4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear:93228ca7-baf2-f8d0-a777-81bd3077dcc4
msgctxt "h5e098361gb05bg401ag96c1g9dcce8976424"
msgid "<i>Back away slowly.</i>"
msgstr "<i>천천히 뒤로 물러난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear
#. Speaker = Shadowheart
#. NodeID = 94866875-2979-ce5c-8ec8-cb77161ed79b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_BugBearLove_State_CompanionIntervened = False
#.   Script:
#.      - GEN_IsSpeakerPresent_4 = True
#. SetFlags:
#.   Global:
#.     - FOR_BugBearLove_State_CompanionIntervened = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear:94866875-2979-ce5c-8ec8-cb77161ed79b
msgctxt "hd7410105gfbf8g4f1egb99dg8262a947647e"
msgid ""
"Leave it. Whoever's inside doesn't want an audience, and I don't want a "
"fight."
msgstr "그만둬. 안쪽에 있는 게 누군진 모르겠지만, 불청객을 반기진 않을 거야, 그리고 난 싸우고 싶지 않고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear
#. Speaker = Grukkoh
#. NodeID = 9d23b151-e4b9-472b-127f-c47a6135661e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear:9d23b151-e4b9-472b-127f-c47a6135661e
msgctxt "hb8138ba5gd701g4915g8106g339d419da1eb"
msgid "Puny?! I am strong! I am virile! I am -"
msgstr "보잘것없다고?! 난 강해! 정력이 넘친다고! 난..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear
#. Speaker = Player
#. NodeID = ad595a4b-d6ca-61e0-aa96-d4d471aa8b27
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear:ad595a4b-d6ca-61e0-aa96-d4d471aa8b27
msgctxt "hc0ec603ega8d6g4a17g968aga584ae6e4c42"
msgid "Apologies. I didn't mean to interrupt."
msgstr "사과하지. 방해하려던 건 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear
#. Speaker = Astarion
#. NodeID = ad6161bf-1eb6-d469-313d-8090ad7ca881
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear:ad6161bf-1eb6-d469-313d-8090ad7ca881
msgctxt "hd3823a10g6d02g4c37ga8ecg36ba4f9fc07a"
msgid "Let me do it. They sound <i>disgusting</i>."
msgstr "내가 하게 해줘. 소리가 아주 <i>역겨운데</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear
#. Speaker = Wyll
#. NodeID = b3b6ec26-00b8-426c-79ba-b479be9ce762
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_BugBearLove_State_CompanionIntervened = False
#.   Script:
#.      - GEN_IsSpeakerPresent_5 = True
#. SetFlags:
#.   Global:
#.     - FOR_BugBearLove_State_CompanionIntervened = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear:b3b6ec26-00b8-426c-79ba-b479be9ce762
msgctxt "h07525c21gcd46g4b55gbfafg12f8ae8e2071"
msgid "Let's leave them alone, I don't want to be invited to the wedding."
msgstr "쟤네 내버려 둬. 난 하객이 되고 싶진 않다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear
#. Speaker = Player
#. NodeID = be75c293-fc25-5c95-a347-2ed7828a4b1a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_BugBear_EavesdroppingSucceeded = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear:be75c293-fc25-5c95-a347-2ed7828a4b1a
msgctxt "h704c8b69g44f7g4563ga176g0bd660c2da3e"
msgid "You were making a lot of noise - I wanted to join the fun."
msgstr "소리가 크게 들리길래, 나도 즐거움에 동참하고 싶었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear
#. Speaker = Grukkoh
#. NodeID = c912d374-947e-f6af-2b7e-56c465aac732
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FOR_BugbearLove_State_InterruptedCouple(2) = True
#.     - FOR_BugBearLove_Event_MovePlayerInside(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear:c912d374-947e-f6af-2b7e-56c465aac732
msgctxt "h76a001fag63e7g4372g9b50g08f95cadb08c"
msgid "Ngh. W-what the hells are you doin'?"
msgstr "으윽. 대, 대체 뭐 하는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear
#. Speaker = Grukkoh
#. NodeID = e0c238c2-2a5f-0dc5-760e-301046e4063f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear:e0c238c2-2a5f-0dc5-760e-301046e4063f
msgctxt "hff41ba63g745ag4a13g8e28g55ba1ed3bcf1"
msgid "Go away."
msgstr "꺼져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear
#. Speaker = Buthir
#. NodeID = e38cafc6-f255-04b8-fa45-dd951abc95ff
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_BugBearLove_Event_CoupleHostile = True
#.     - FOR_BugBearLove_Knows_Lovemaking = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear:e38cafc6-f255-04b8-fa45-dd951abc95ff
msgctxt "h0eebb9dcga90fg4d5bg9176g912bf82cc921"
msgid "Ruined! Smash - I'll SMASH YOU!"
msgstr "망했어! 뭉개 - 널 <b>뭉개 버리겠어</b>!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear
#. Speaker = Buthir
#. NodeID = ed529ab1-1e41-8395-4355-d7b02ad6c0a7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_BugBear_Event_Intimidated = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear:ed529ab1-1e41-8395-4355-d7b02ad6c0a7
msgctxt "h249bfee2g75a8g4515g9f49gebd90522c3e3"
msgid ""
"ENOUGH! Moment ruined. Passion squished like slow goat under foot. We leave."
msgstr "<b>그만</b>! 분위기가 깨졌잖아. 뜨거운 사랑이 느려터진 염소처럼 짓밟혔어. 우린 떠난다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear
#. Speaker = Player
#. NodeID = fbc20e44-7df9-0951-7cd0-d7ad5adf57ee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear:fbc20e44-7df9-0951-7cd0-d7ad5adf57ee
msgctxt "h6aea3f99ga1e9g4621gaf2dge2ba7c195a31"
msgid "<i>Open the door.</i>"
msgstr "<i>문을 연다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear_AD_Combat
#. Speaker = Grukkoh
#. NodeID = 4c43824f-bae6-95d6-ed89-6400036ecd90
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear_AD_Combat:4c43824f-bae6-95d6-ed89-6400036ecd90
msgctxt "heb76f52eg90feg4878g808bga5bd3108f50b"
msgid "Get out! OUT!"
msgstr "나가! <b>나가라고</b>!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear_VB_Scholar
#. Speaker = Player
#. NodeID = 6c62e4ac-68c0-3944-e14b-a50e57e0c6d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_BugBear_VB_Scholar:6c62e4ac-68c0-3944-e14b-a50e57e0c6d8
msgctxt "h1867f55cg247ag4890gb452gf17fcac2022a"
msgid "Yikes, don't disturb a half-ogre in the making!"
msgstr "이크, 하프 오우거 만들어지는 현장을 방해하면 안 되지!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_BugbearLove_PAD_AfterFight
#. Speaker = Player
#. NodeID = c1c05258-8dc1-45ba-bad0-dde84da8c805
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_BugbearLove_PAD_AfterFight:c1c05258-8dc1-45ba-bad0-dde84da8c805
msgctxt "h3b1536e5g6cc8g4355gbd6bga7318dcab9e3"
msgid "It certainly set my heart to beating. A shame we had to still theirs."
msgstr "확실히 내 심장을 뛰게 했지. 그들의 심장을 멈추게 했다니 안타깝군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_BugbearLove_PAD_AfterFight
#. Speaker = Player
#. NodeID = c1c05258-8dc1-45ba-bad0-dde84da8c805
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_BugbearLove_PAD_AfterFight:c1c05258-8dc1-45ba-bad0-dde84da8c805
msgctxt "h3583bdf0g4485g43a9g9e52g51bfa801823f"
msgid ""
"I'll refrain from detailing my conquests, lest you die of embarrassment."
msgstr "내 업적들에 대해 자세히 말하지 않을게. 네가 부끄러워서 죽을려고 하면 안되잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_BugbearLove_PAD_AfterFight
#. Speaker = Player
#. NodeID = c1c05258-8dc1-45ba-bad0-dde84da8c805
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_ASTARION and REALLY_GNOME
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_BugbearLove_PAD_AfterFight:c1c05258-8dc1-45ba-bad0-dde84da8c805
msgctxt "h59645d57gc01bg4282ga870g01aef465cacc"
msgid "Oh I've seen worse. Gnomes can be - well, I'm sure you know."
msgstr "오, 더 심한 것도 봤지. 노움들은, 뭐어, 알 거라 믿어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_BugbearLove_PAD_AfterFight
#. Speaker = Player
#. NodeID = c1c05258-8dc1-45ba-bad0-dde84da8c805
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_ASTARION and !REALLY_GNOME
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_BugbearLove_PAD_AfterFight:c1c05258-8dc1-45ba-bad0-dde84da8c805
msgctxt "h6a23ea77g664fg459cgb036gb5dafba268cc"
msgid "Oh I've seen worse. Gnomes can be... ugh."
msgstr "오, 더한 것도 봤어. 노움들은... 으."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_BugbearLove_PAD_AfterFight
#. Speaker = Player
#. NodeID = c1c05258-8dc1-45ba-bad0-dde84da8c805
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_BugbearLove_PAD_AfterFight:c1c05258-8dc1-45ba-bad0-dde84da8c805
msgctxt "hc12e57b0g74e3g45d8g8ca5g7c6ae0b6b41b"
msgid "Let's just put this behind us. <i>Far </i>behind us."
msgstr "방금 본 건 잊어버리자. <i>철저하게 </i> 잊어버려."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_BugbearLove_PAD_AfterFight
#. Speaker = Player
#. NodeID = c1c05258-8dc1-45ba-bad0-dde84da8c805
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_BugbearLove_PAD_AfterFight:c1c05258-8dc1-45ba-bad0-dde84da8c805
msgctxt "ha4d5b519ge228g4ec8gbc30g1d521f92b28b"
msgid "Pity we interrupted them."
msgstr "우리가 방해했다니 안타까워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_BugbearLove_PAD_AfterFight
#. Speaker = Player
#. NodeID = c1c05258-8dc1-45ba-bad0-dde84da8c805
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_BugbearLove_PAD_AfterFight:c1c05258-8dc1-45ba-bad0-dde84da8c805
msgctxt "h71913679ga95eg47b9ga497g28835f765a30"
msgid ""
"One moment they were embracing each other in intimacy, the next they're "
"embracing only death."
msgstr "한 순간 친밀하게 서로를 껴안고 있었는데, 바로 다음 순간엔 죽음만을 끌어안는구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_BugbearLove_PAD_AfterFight
#. Speaker = Player
#. NodeID = c1c05258-8dc1-45ba-bad0-dde84da8c805
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: REALLY_GENERIC
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_BugbearLove_PAD_AfterFight:c1c05258-8dc1-45ba-bad0-dde84da8c805
msgctxt "h5e764f32g69d9g4b14g9076gca6eecbf78ed"
msgid "Everytime I close my eyes, I can see... <i>it.</i>"
msgstr "눈을 감을 때마다, 보여... <i>그게.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_BugbearLove_PAD_AfterFight
#. Speaker = Player
#. NodeID = d0857ceb-2992-4bbf-91c7-9e4297d4b43f
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_BugbearLove_PAD_AfterFight:d0857ceb-2992-4bbf-91c7-9e4297d4b43f
msgctxt "h6557043egd609g4e82g9d49g83f255a01e1e"
msgid "An ogre and a... bugbear? An untraditional pairing, I reckon."
msgstr "오우거와... 버그베어라? 꽤나 색다른 조합이군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_BugbearLove_PAD_AfterFight
#. Speaker = Player
#. NodeID = d0857ceb-2992-4bbf-91c7-9e4297d4b43f
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_BugbearLove_PAD_AfterFight:d0857ceb-2992-4bbf-91c7-9e4297d4b43f
msgctxt "h16031476gc412g4511g8d2aga7061c9519d7"
msgid "Some Baldurians would pay good coin for a tussle like that."
msgstr "어떤 발더인들은 저런 몸부림에 좋은 값을 치르겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_BugbearLove_PAD_AfterFight
#. Speaker = Player
#. NodeID = d0857ceb-2992-4bbf-91c7-9e4297d4b43f
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_BugbearLove_PAD_AfterFight:d0857ceb-2992-4bbf-91c7-9e4297d4b43f
msgctxt "hf3c55f05g3cffg4dbdgb61agc951da60ec92"
msgid "An ogre and a bugbear. Not an eyeful I'd care to experience twice."
msgstr "오우거와 버그베어라. 두 번 다시 저런 눈요기는 경험하고 싶지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_BugbearLove_PAD_AfterFight
#. Speaker = Player
#. NodeID = d0857ceb-2992-4bbf-91c7-9e4297d4b43f
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_BugbearLove_PAD_AfterFight:d0857ceb-2992-4bbf-91c7-9e4297d4b43f
msgctxt "h9559a871g6cceg4363g8a40g4184a1528117"
msgid "I doubt those beasts were expecting... visitors."
msgstr "저 짐승들이... 방문객을 기대하진 않았을 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_BugbearLove_PAD_AfterFight
#. Speaker = Player
#. NodeID = d0857ceb-2992-4bbf-91c7-9e4297d4b43f
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_BugbearLove_PAD_AfterFight:d0857ceb-2992-4bbf-91c7-9e4297d4b43f
msgctxt "hfccc7348ga9bdg4ee5gaa74ga4f4c283c1fa"
msgid "An ogre and a bugbear... A torrid tryst indeed."
msgstr "오우거와 버그베어라...아주 강렬한 밀회였어."

