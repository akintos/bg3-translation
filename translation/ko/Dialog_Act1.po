#.      - GEN_IsSpeakerPresent_1 = True
#. SetFlags:
#.   Local:
#.     - 8c546376-2838-10d2-9587-0b24d79bca24_LocalFlag2 = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_MyconidCircle_AD_GnomesSaved:bb446c47-c5c6-4b8c-a7c4-23c1e1dfbaad
msgctxt "h68cfa0c9ga019g4d85gbfe3ge9c9b2fc03e7"
msgid ""
"We're done down here. Can't believe I'm saying it, but I miss the damn sun."
msgstr "이제 여긴 질렸어. 이런 말을 하게 될 줄은 몰랐지만, 망할 햇빛을 좀 보고 싶네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_MyconidCircle_AD_GnomesSaved
#. Speaker = Lunkbug
#. NodeID = c0620204-0674-143f-9a68-422e7137a103
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_InjuredGnome_State_SporeServant = True
#.   Local:
#.      - 8c546376-2838-10d2-9587-0b24d79bca24_LocalFlag2 = False
#.      - 8c546376-2838-10d2-9587-0b24d79bca24_LocalFlag1 = True
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#.      - GEN_IsSpeakerPresent_1 = False
#. SetFlags:
#.   Local:
#.     - 8c546376-2838-10d2-9587-0b24d79bca24_LocalFlag2 = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_MyconidCircle_AD_GnomesSaved:c0620204-0674-143f-9a68-422e7137a103
msgctxt "hbae600ddg65f3g43eegab6eg35df0166d5aa"
msgid "Thulla... why didn't you keep <i>running?</i>"
msgstr "툴라... 왜 계속 <i>도망치지 않았어?</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_MyconidCircle_AD_GnomesSaved
#. Speaker = Lunkbug
#. NodeID = d1451720-b17c-9836-56a8-ac4797e7f343
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_GnomeForeman_State_PermaDefeated = True
#.   Local:
#.      - 8c546376-2838-10d2-9587-0b24d79bca24_LocalFlag2 = False
#.      - 8c546376-2838-10d2-9587-0b24d79bca24_LocalFlag1 = True
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#.      - GEN_IsSpeakerPresent_1 = False
#. SetFlags:
#.   Local:
#.     - 8c546376-2838-10d2-9587-0b24d79bca24_LocalFlag2 = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_MyconidCircle_AD_GnomesSaved:d1451720-b17c-9836-56a8-ac4797e7f343
msgctxt "h5667adf0g67cfg4f63g9527gfe9c69638fd4"
msgid ""
"Beldron, you bastard. You were supposed to lead us out. Not... leave us "
"behind."
msgstr "벨드론, 이 개자식. 넌 우릴 이끌었어야 했잖아. 우릴... 뒤에 버려두는 게 아니라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_MyconidCircle_AD_GnomesSaved
#. Speaker = Lunkbug
#. NodeID = d145a12b-c5b9-4c39-b9ae-1a27826d73ea
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 8c546376-2838-10d2-9587-0b24d79bca24_LocalFlag2 = True
#.      - 8c546376-2838-10d2-9587-0b24d79bca24_LocalFlag1 = True
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#.      - GEN_IsSpeakerPresent_1 = True
#. SetFlags:
#.   Local:
#.     - 8c546376-2838-10d2-9587-0b24d79bca24_LocalFlag2 = False
#.     - 8c546376-2838-10d2-9587-0b24d79bca24_LocalFlag1 = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_MyconidCircle_AD_GnomesSaved:d145a12b-c5b9-4c39-b9ae-1a27826d73ea
msgctxt "h44d55afeg1f28g4c3cg8370g9f3c936aba83"
msgid "We've had some rest. Maybe we can still go back for the others."
msgstr "이제 좀 쉬었어. 아직 다른 이들에게 돌아갈 수 있을지도 몰라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_MyconidCircle_AD_GnomesSaved
#. Speaker = Thulla
#. NodeID = edf55a27-854a-4baf-b8cc-6c4aa4c6fbcf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_MyconidCircle_AD_GnomesSaved:edf55a27-854a-4baf-b8cc-6c4aa4c6fbcf
msgctxt "h958bf780gcb23g4133g8bb1gb0bcc04a7f02"
msgid ""
"Thanks boss. Would be looking a lot worse if not for help from a friend."
msgstr "고마워 대장. 친구의 도움을 받지 못했다면 더 끔찍한 상태였을지도 몰라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_MyconidCircle_AD_GnomesSaved
#. Speaker = Lunkbug
#. NodeID = f79560bb-48ea-401b-9532-01b0994ecdd6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 8c546376-2838-10d2-9587-0b24d79bca24_LocalFlag2 = True
#.      - 8c546376-2838-10d2-9587-0b24d79bca24_LocalFlag1 = True
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#.      - GEN_IsSpeakerPresent_1 = False
#. SetFlags:
#.   Local:
#.     - 8c546376-2838-10d2-9587-0b24d79bca24_LocalFlag2 = False
#.     - 8c546376-2838-10d2-9587-0b24d79bca24_LocalFlag1 = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_MyconidCircle_AD_GnomesSaved:f79560bb-48ea-401b-9532-01b0994ecdd6
msgctxt "h499436a0gae61g4e95gbcd0g3677f199175c"
msgid "We should've stayed in the city - Wulbren's quest be damned."
msgstr "애초에 도시에서 나오는 게 아니었어, 망할 울브렌의 임무 같으니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_MyconidCircle_AD_RevealHiddenCave
#. Speaker = Mossy Myconid
#. NodeID = a746ed51-9a6e-3732-e145-f7fb860c03a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_MyconidCircle_AD_RevealHiddenCave:a746ed51-9a6e-3732-e145-f7fb860c03a8
msgctxt "h676e5d44gd80dg49cbgb638gd6734756f658"
msgid "((*come. come*))"
msgstr "((*와라. 와라*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_MyconidCircle_InjuredGnome_AD_PainGrunt
