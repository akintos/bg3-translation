msgid "*The corpse regards you lifelessly.*"
msgstr "*시체가 생기 없는 모습으로 당신을 맞이합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_DeadPrisoner_Dead
#. Speaker = Abducted Nobleman
#. NodeID = d65eca42-cfe6-d55b-ca9e-ce724bf2a2ba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_DeadPrisoner_Dead:d65eca42-cfe6-d55b-ca9e-ce724bf2a2ba
msgctxt "h7d005820gb188g4f7cg8fc1gd6bafcd4c068"
msgid "Fire... screaming... then <i>crunch</i>. Nothing..."
msgstr "불... 비명 소리... 그리곤 <i>콰직</i>. 끝..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_DeadPrisoner_Dead
#. Speaker = Abducted Nobleman
#. NodeID = d7461db7-c534-d053-2e58-ad74f7d4f4ee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_DeadPrisoner_Dead:d7461db7-c534-d053-2e58-ad74f7d4f4ee
msgctxt "hb02c05bdgc834g4588g9247g9086993dd890"
msgid "No... took everyone... peasants... lords... took them all..."
msgstr "아니... 누구든 납치됐어... 천것이든... 귀족이든... 모조리 다..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_DeadPrisoner_Dead
