msgctxt "hfb51ab17g2599g4439g8bf7g5df602e7329a"
msgid ""
"Oh, gods! You've caught a scout; the gith invasion force is right behind me -"
" save yourselves!"
msgstr "이런, 맙소사! 놈들 정찰병을 잡았잖아. 기스 침략자들이 지척에 있어. 살고 싶으면 도망치라고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene
#. Speaker = Nymessa
#. NodeID = a504c36f-564e-b8b9-bec5-3cb07e95cf9a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CHA_LaezelRecruitment_Event_TieflingsGetLaeZel = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene:a504c36f-564e-b8b9-bec5-3cb07e95cf9a
msgctxt "h4f5b3aabgeefcg4282g973fg3c260ef775bb"
msgid "You're with me, toad."
msgstr "넌 나랑 간다, 두꺼비."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene
#. Speaker = Narrator
#. NodeID = a5f23a4c-d1d1-5838-f1e8-c4f16bfafd0e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene:a5f23a4c-d1d1-5838-f1e8-c4f16bfafd0e
msgctxt "heb816682g50ddg4c2fg9ff8g8f77c5286ac8"
msgid "*Your words flow to her, though you never speak them aloud.*"
msgstr "*소리로 내지 않았는데도, 당신의 말이 저 여자에게 전해집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene
#. Speaker = Player
#. NodeID = a7ad4837-e5b6-ac47-162b-4eea84e7e0c2
#. HandlePath = TaggedText[0].TagText[0]
