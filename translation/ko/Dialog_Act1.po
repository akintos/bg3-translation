msgid "Change of plan. I'm going to kill you."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Narrator
#. NodeID = a5b69b52-caf2-4312-be7f-393c9ebff62a
