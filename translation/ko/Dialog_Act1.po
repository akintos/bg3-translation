#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_DrowLeaves
#. Speaker = Nightwarden Minthara
#. NodeID = 27448972-b7db-38bb-08e4-02e364ef7ae8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_DrowLeaves:27448972-b7db-38bb-08e4-02e364ef7ae8
