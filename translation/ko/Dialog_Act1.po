msgctxt "hcb44c319g77a8g43d0g989ege05d048a811e"
msgid "That dowry? I'm keeping it."
msgstr "그 결혼 지참금 말이지, 내가 가지겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Player
#. NodeID = 0f1100af-57be-a078-ab62-edefccd05609
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Quest:
#.      - PLA_StuckHalfElf.KnowDowry(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:0f1100af-57be-a078-ab62-edefccd05609
msgctxt "h35aaa2d9g2383g491bg9e9bgbf2f370b2918"
msgid "What was that about a dowry?"
msgstr "그 결혼 지참금 이야기는 뭐지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Player
#. NodeID = 11e7b31f-2e18-83c9-2475-45d11f9ff68e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC(1) = True
#.      - CLERIC_EVIL(1) = False
#. TagRule: CLERIC_GOOD or CLERIC_NEUTRAL
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:11e7b31f-2e18-83c9-2475-45d11f9ff68e
msgctxt "h17abd723g2df1g4e48ga124g57972a213c66"
msgid "I can pray for her, if you like."
msgstr "괜찮다면 내가 그녀를 위해 기도해 주겠소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Benryn
#. NodeID = 1c8b39a2-e3ac-c086-a9c3-71294dc9e65d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - PLA_StuckHalfElf_State_PlayerAngered(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:1c8b39a2-e3ac-c086-a9c3-71294dc9e65d
msgctxt "h8421ea33gd006g4833gac09g81b739c4fc59"
msgid "Go to hell."
msgstr "지옥에나 떨어져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Benryn
#. NodeID = 1ceb4321-b5a3-d55b-7ed4-ceba865305c2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:1ceb4321-b5a3-d55b-7ed4-ceba865305c2
msgctxt "hb345a860g65b1g40f5g9e3bg544f617b5d91"
msgid "What am I going to do? She's all I had."
msgstr "이제 어떻게 하지? 그녀는 내 전부였는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Player
#. NodeID = 1f919b6f-e157-4a98-c95f-dba1d3335ea8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:1f919b6f-e157-4a98-c95f-dba1d3335ea8
msgctxt "hbe15c45ag5d51g4855ga0degbb151d491467"
msgid "<i>Pray to your own god instead.</i>"
msgstr "<i>네가 믿는 신에게나 기도해라.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Benryn
#. NodeID = 1ffcc7b7-8035-aee5-c3c4-d26bc7ffe1fd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_StuckDwarf_HasMet_Searching(1) = True
#.   Global:
#.      - PLA_TavernInvestigation_State_HalfElfFoundWife = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:1ffcc7b7-8035-aee5-c3c4-d26bc7ffe1fd
msgctxt "hd1de5b36gdc25g4edaga108g6db5ce046ead"
msgid "Have you found my Miri?"
msgstr "나의 미리를 찾으셨나요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Player
#. NodeID = 26c3e0c6-a7df-7b0a-e2f9-2a422b4b1d76
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:26c3e0c6-a7df-7b0a-e2f9-2a422b4b1d76
msgctxt "hb9d90654g820dg4880gb9bbg99fb1ff6f81d"
msgid "This isn't on you. There was no way you could have known."
msgstr "당신 탓이 아니야. 미리 알 방법이 없었잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Benryn
#. NodeID = 26f5c28e-a01b-8f49-b079-b37aaef1c977
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:26f5c28e-a01b-8f49-b079-b37aaef1c977
msgctxt "hebca09adg3dbdg4a1eg8ca7g201cc30d961e"
msgid "You don't know that!"
msgstr "그건 모르는 거잖아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Gale
#. NodeID = 2be1b5e4-cbb2-f9f0-bb2e-d66bccb36683
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_StuckHalfElf_Freed_Laezel(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:2be1b5e4-cbb2-f9f0-bb2e-d66bccb36683
msgctxt "h97427b51gdbcfg4a8eg8f4ag184fa5834253"
msgid ""
"Allow me to apologise on Lae'zel's behalf, sir. Her lack of tact is a burden "
"to us all."
msgstr "레이젤을 대신해 제가 사과드리죠. 도통 눈치가 없어서 우리 모두에게 짐이 되는군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Player
#. NodeID = 2d012676-6a7c-22c7-8cc7-088f1c9fcaf2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_StuckHalfElf_Knows_ExplainedDowry = False
#.   Quest:
#.      - PLA_StuckHalfElf.KeptGold(1) = False
#.   User:
#.      - PLA_StuckHalfElf_Knows_MentionedDowry(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:2d012676-6a7c-22c7-8cc7-088f1c9fcaf2
msgctxt "he5104b3dg237fg47d1gb10dg01dd7a016e48"
msgid "Didn't you say something about a dowry?"
msgstr "결혼 지참금에 대해서 얘기하지 않았나요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Player
#. NodeID = 3282aa38-707c-36df-f062-bc63b42f64fd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - PLA_TavernInvestigation_Knows_WifeLookingForHusband(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:3282aa38-707c-36df-f062-bc63b42f64fd
msgctxt "hbb439556g1f01g45e1gb60bgf9e1466fea53"
msgid "She was trying to get back to you."
msgstr "당신에게 돌아가려고 했군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Benryn
#. NodeID = 34d454b2-da9a-f483-a440-93d1d10098ce
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_StuckHalfElf_State_PlayerAngered(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:34d454b2-da9a-f483-a440-93d1d10098ce
msgctxt "hf1e1a9efg8c78g4e51g9839g0f9f9288eb10"
msgid "Maybe I judged you too quickly. Thank you."
msgstr "당신을 너무 빨리 넘겨짚은 것 같군요. 고맙습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Player
#. NodeID = 37b72a17-1460-5773-a190-1bfcfff1390d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:37b72a17-1460-5773-a190-1bfcfff1390d
msgctxt "h29cb6069g66a5g4722g978dg5d8f36c8dfa3"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Player
#. NodeID = 3f7ada09-1496-a89a-a360-0aacdcb049ab
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Quest:
#.      - PLA_StuckHalfElf.LearnedWife(1) = False
#. SetFlags:
#.   Quest:
#.     - PLA_StuckHalfElf.LearnedWife(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:3f7ada09-1496-a89a-a360-0aacdcb049ab
msgctxt "h41b5dca9gdfc1g4f02gad41gbd2fd8eb7d2b"
msgid "Can you tell me what she looks like?"
msgstr "어떻게 생겼는지 알려주겠어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Benryn
#. NodeID = 40f564aa-c30b-3d76-7e5a-8be55be90c97
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:40f564aa-c30b-3d76-7e5a-8be55be90c97
msgctxt "h7a0315c1g6817g4014g8458g13e41008d81d"
msgid "Please, just go. I need a moment with her."
msgstr "부디, 그냥 가세요. 그녀와 잠시 있게 해줘요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Benryn
#. NodeID = 44c6f4c4-8db8-4797-995f-8c1f6a56bc58
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:44c6f4c4-8db8-4797-995f-8c1f6a56bc58
msgctxt "hfe969b60gfb50g4f9bg8bc9g5e20ec09eba7"
msgid "Please, it'd mean so much to her."
msgstr "제발, 그녀에게 정말 의미가 깊은 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Player
#. NodeID = 46ba9323-a9ac-7766-e444-28418f8426f5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Quest:
#.      - PLA_StuckHalfElf.FoundWife(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:46ba9323-a9ac-7766-e444-28418f8426f5
msgctxt "h6abe7eadg7fadg4454g9751g2e902dfd461c"
msgid "I found her body."
msgstr "그녀의 시신을 찾았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Player
#. NodeID = 46eec6a4-1d4b-93f5-8ec9-ce03dc2bbe0c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:46eec6a4-1d4b-93f5-8ec9-ce03dc2bbe0c
msgctxt "hbdac4913g4159g40d3g84d1g931e987f8280"
msgid "Count your blessings. At least you're still alive."
msgstr "축복이라고 생각해. 적어도 당신은 살았잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Player
#. NodeID = 4b0e341f-5f34-eef6-85d9-cc52894bad97
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - PLA_StuckHalfElf_State_HasDowry(1) = True
#.   Quest:
#.      - PLA_StuckHalfElf.KnowDowry(1) = True
#.      - PLA_StuckHalfElf.ReturnedGold(1) = False
#.      - PLA_StuckHalfElf.KeptGold(1) = False
#. SetFlags:
#.   Object:
#.     - PLA_StuckHalfElf_Event_GiveDowry(0) = True
#.   Quest:
#.     - PLA_StuckHalfElf.ReturnedGold(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:4b0e341f-5f34-eef6-85d9-cc52894bad97
msgctxt "he18245aaga686g4c40g8160g20120ebc484c"
msgid "I found the dowry. Here."
msgstr "결혼 지참금을 찾았어. 여기."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Gale
#. NodeID = 4c77b299-2f94-1b6f-c728-ae439b2281ed
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_StuckHalfElf_Freed_Astarion(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:4c77b299-2f94-1b6f-c728-ae439b2281ed
msgctxt "hc38605dbg031eg4309ga0c0gc06c5f178335"
msgid ""
"Allow me to apologise on Astarion's behalf, sir. His lack of tact is a "
"burden to us all."
msgstr "아스타리온을 대신해 제가 사과드리죠. 도통 눈치가 없어서 우리 모두에게 짐이 되는군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Benryn
#. NodeID = 4d717166-e907-5f20-66a0-ab093dba33c7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:4d717166-e907-5f20-66a0-ab093dba33c7
msgctxt "h6b5736f0g5534g419bgb600gea51faef8058"
msgid "Her body's not even cold and you're questioning her faith?"
msgstr "아직 그녀의 시신이 식지도 않았는데 신앙에 의문을 제기한다고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Player
#. NodeID = 53285c3c-c1c0-f20c-80f5-806d6eddf1eb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:53285c3c-c1c0-f20c-80f5-806d6eddf1eb
msgctxt "hb9bd64bfg9a5eg4cc4gae37g2ba55ee94e1d"
msgid "It wouldn't have made a difference."
msgstr "차이가 없었을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Benryn
#. NodeID = 53671b0f-0e8a-eb7b-521a-84d78fdab069
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:53671b0f-0e8a-eb7b-521a-84d78fdab069
msgctxt "hd7fb0c02g46f4g4437g913dg3e8485da92cf"
msgid "She said I'd never see her again. She was right."
msgstr "나더러 다시는 자기를 못 볼 거라고 했죠. 그 말이 맞았어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Benryn
#. NodeID = 53d89a85-b19f-9073-ac44-1a2622f8ee6e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:53d89a85-b19f-9073-ac44-1a2622f8ee6e
msgctxt "h3ac9df34g8c2eg44a9g89d9g5c64e5c43391"
msgid "I was in our room. We had a fight."
msgstr "나는 우리 객실 안에 있었죠. 우리는 싸웠었어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Benryn
#. NodeID = 59c46777-28c7-5e3f-a123-b29146c86abb
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - PLA_StuckHalfElf.LearnedWife(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:59c46777-28c7-5e3f-a123-b29146c86abb
msgctxt "h0e013de0g7926g4a20g83efgb96ba336576e"
msgid "My wife. She was outside when the goblins came."
msgstr "제 아내 말이에요. 고블린이 쳐들어왔을 때 바깥에 있었어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Benryn
#. NodeID = 5f52fd94-b1d7-f778-bab2-d33c3d73515a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:5f52fd94-b1d7-f778-bab2-d33c3d73515a
msgctxt "hc3f431cfgbe9bg400bgbcabg8ea9b784e000"
msgid "Have you seen her?"
msgstr "본 적 있나요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Benryn
#. NodeID = 65ee180e-db1e-ca75-45fb-5edbda411263
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   User:
#.     - PLA_StuckHalfElf_Knows_MentionedDowry(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:65ee180e-db1e-ca75-45fb-5edbda411263
msgctxt "h2f338441g2e7cg41f6gb6acgd2a89c64a054"
msgid ""
"If I'd just kept my mouth shut about that bloody dowry, she'd... she'd still "
"be here."
msgstr "제가 그 망할 결혼 지참금 이야기만 안 했어도, 그녀는... 그녀는 아직 여기 있었을 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Player
#. NodeID = 681387e4-8487-cabb-0a49-0367d645fdcd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Quest:
#.      - PLA_StuckHalfElf.FoundWife(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:681387e4-8487-cabb-0a49-0367d645fdcd
msgctxt "h2d1c7191g35e7g4308ga76egdb311b55a46e"
msgid "She's dead. I found her body in one of the burned buildings."
msgstr "그녀는 죽었어. 불타버린 건물들 중 하나에서 그녀의 시체를 찾았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Wyll
#. NodeID = 6b29fd48-978d-0d6b-7709-0ab49617e40f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_WYLL(6) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:6b29fd48-978d-0d6b-7709-0ab49617e40f
msgctxt "h8646abd2ge7e4g43f7g9f96g8962a4c976ae"
msgid "By the hells' fires, has your heart shrunk so small?"
msgstr "망할 지옥의 불길이 네 심장을 쪼그라들게 했나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Benryn
#. NodeID = 6cf33bcf-63e5-a75a-8bce-bd7285ca85c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:6cf33bcf-63e5-a75a-8bce-bd7285ca85c8
msgctxt "h799520ecgc90ag474bga423g0b35a27724c5"
msgid ""
"You do? Please, can you return it to me? She'd want her sister to have it."
msgstr "그래요? 제발, 제게 돌려주실 수 있나요? 그녀는 자기 동생이 그걸 가지길 원할 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Player
#. NodeID = 6d321c85-5dae-a592-3a83-9098ae29a4d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:6d321c85-5dae-a592-3a83-9098ae29a4d9
msgctxt "h4347e921g438fg46bcga4fbg2308834790e3"
msgid "No, I haven't."
msgstr "아니, 아직 못찾았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Player
#. NodeID = 705eea45-541d-5ff3-9a75-87e6e0b84e2a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - PLA_StuckHalfElf_State_HasDowry(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:705eea45-541d-5ff3-9a75-87e6e0b84e2a
msgctxt "hab5c3ac2g2df6g490bgb51egdb4dd0338d3e"
msgid "I'm keeping it. Consider it payment for saving your life."
msgstr "내가 가지도록 하지. 네 목숨을 구해준 대가라고 생각해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Player
#. NodeID = 709eada4-8faa-8ed0-6c3c-992036c3b7be
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - PLA_StuckHalfElf_State_HasDowry(1) = True
#.   Quest:
#.      - PLA_StuckHalfElf.KnowDowry(1) = True
#. SetFlags:
#.   User:
#.     - PLA_StuckHalfElf_Knows_PlayerFoundDowry(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:709eada4-8faa-8ed0-6c3c-992036c3b7be
msgctxt "hfee16ab9g813fg45e1g97f3g94006fc14172"
msgid "About that dowry - pretty sure I found it."
msgstr "그 결혼 지참금 말이야, 찾은 것 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Gale
#. NodeID = 755b9ec9-df74-d6dd-b7fa-99ff1e5f87dc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_GALE(7) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:755b9ec9-df74-d6dd-b7fa-99ff1e5f87dc
msgctxt "hc6b18ef0g9c5ag4607g96dfg759ebd738d38"
msgid "That was a rather unimpressive display of pettiness, if you ask me."
msgstr "내 의견을 말하자면, 다소 인상적이지 않은 옹졸함이었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Astarion
#. NodeID = 77cd2f7a-b936-6df0-b4bb-c49099c10cf5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#. SetFlags:
#.   Dialog:
#.     - PLA_StuckHalfElf_Freed_Astarion(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:77cd2f7a-b936-6df0-b4bb-c49099c10cf5
msgctxt "h6cdd118bg6e0cg4a7cg8645g7e3f28435ca7"
msgid "You took the gold? I was rather hoping for the body..."
msgstr "금을 가져왔다고요? 시신을 가져오길 바랐는데..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Benryn
#. NodeID = 809ac048-eef0-4e77-c08e-95bd219ab92a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:809ac048-eef0-4e77-c08e-95bd219ab92a
msgctxt "h7989f4b9gde01g4fa6g8e61g08b4ab73815d"
msgid "You did? Please - she'd want her sister to have it."
msgstr "그래요? 제발, 그녀는 자기 동생이 그걸 가지길 원했을 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Benryn
#. NodeID = 8291421c-4b11-51ab-8ba5-53b15c3af056
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_StuckDwarf_HasMet_FoundWife(1) = False
#.   Global:
#.      - PLA_TavernInvestigation_State_HalfElfFoundWife = True
#. SetFlags:
#.   Dialog:
#.     - PLA_StuckDwarf_HasMet_FoundWife(1) = True
#.   Quest:
#.     - PLA_StuckHalfElf.ReachedWife(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:8291421c-4b11-51ab-8ba5-53b15c3af056
msgctxt "h662ece2dge574g4486gaf52g303cc174cb18"
msgid "Miri, no... gods, no, no, no!"
msgstr "미리, 안 돼... 신이시여, 안 돼, 안 돼, 안 돼!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Player
#. NodeID = 89fed933-4987-6cda-8a14-cf75bc3bd1c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:89fed933-4987-6cda-8a14-cf75bc3bd1c9
msgctxt "h2cf40538gdc40g4492g901cg0a1c4e7cd055"
msgid "You'll be all right, with time."
msgstr "시간이 지나면 괜찮아질 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Benryn
#. NodeID = 8a9e631b-6d5a-0900-c24c-d35fca896c9b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:8a9e631b-6d5a-0900-c24c-d35fca896c9b
msgctxt "h3ec2b11bg0a8fg4054gb6cdgacd006fe8961"
msgid "MIRI!"
msgstr "미리!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Lae'zel
#. NodeID = 8ce51863-6470-0219-5e3e-e2926d51c856
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
#. SetFlags:
#.   Dialog:
#.     - PLA_StuckHalfElf_Freed_Laezel(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:8ce51863-6470-0219-5e3e-e2926d51c856
msgctxt "hd1b4baaag381dg4de6gb6a7g67a0ccc63375"
msgid "What's a few coins? The sister won't miss them."
msgstr "동전 몇 닢이 무슨 의미죠? 그 여동생은 그런 건 그리워하지 않을 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Benryn
#. NodeID = 8e5c99e1-ceea-5b9d-1cd4-1c8216918f66
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:8e5c99e1-ceea-5b9d-1cd4-1c8216918f66
msgctxt "h873673c4g40d8g44fagb171g0332df3de9d3"
msgid "I have to keep looking. Miri!"
msgstr "계속 찾아야 해요. 미리!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Benryn
#. NodeID = 906a8ca9-f5fa-8980-7b43-96f2c395cabf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:906a8ca9-f5fa-8980-7b43-96f2c395cabf
msgctxt "h6bb3e4a2ga0eeg4396g96ddg16d9103a579f"
msgid "How is this a blessing?"
msgstr "이게 어떻게 축복이죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Player
#. NodeID = 95bff8b9-2ac3-5ca8-45a1-8b77e48037cc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - PLA_StuckHalfElf_State_HasDowry(1) = False
#.   Quest:
#.      - PLA_StuckHalfElf.KnowDowry(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:95bff8b9-2ac3-5ca8-45a1-8b77e48037cc
msgctxt "h24363384g3950g4c72g8075ga12850b77e63"
msgid "About that dowry - I know where it is."
msgstr "결혼 지참금 말이야, 어디에 있는지 알고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Player
#. NodeID = 963529dd-8673-3c1e-a5a0-4a54b63ee47c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - PLA_StuckDwarf_Asked_WhatHappened(1) = False
#. SetFlags:
#.   User:
#.     - PLA_StuckDwarf_Asked_WhatHappened(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:963529dd-8673-3c1e-a5a0-4a54b63ee47c
msgctxt "hd0a6fc2ag8936g48dfgadd8g95cff8ce784c"
msgid "How did you two get separated?"
msgstr "어떻게 헤어진 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Benryn
#. NodeID = 9fc5313f-1e3b-8fce-e75b-4b275933d93d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:9fc5313f-1e3b-8fce-e75b-4b275933d93d
msgctxt "h153e37abg0f76g4729gbe4egd373220011d1"
msgid "That's... thank you. I hope your god listens."
msgstr "그건... 고마워요. 당신의 신이 응답하기를."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Player
#. NodeID = a34a053f-12e1-524b-be8a-b1e575089136
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:a34a053f-12e1-524b-be8a-b1e575089136
msgctxt "h55b8ee7cge6e0g4e4dgb33ag6b0d0bebf7ec"
msgid "I pray to thee, Gond - guide Miri to peace in death."
msgstr "곤드여, 그대에게 기도합니다. 미리를 죽음에서 평온으로 인도해 주소서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Player
#. NodeID = a5bdd6ee-83aa-aaeb-716d-50749154cc86
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:a5bdd6ee-83aa-aaeb-716d-50749154cc86
msgctxt "hb5651871gba0bg48d9g9f4age82b2eb6a6aa"
msgid "Miri? Who are you looking for?"
msgstr "미리? 누굴 찾고 있는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Player
#. NodeID = a69036a2-ca6b-f9dd-1450-f94d9ea01acb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:a69036a2-ca6b-f9dd-1450-f94d9ea01acb
msgctxt "hb1c9c58cg8671g47c2g8b0bg1ca885279a55"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Player
#. NodeID = b1bbfa0b-c06f-6c66-6b4e-f65f07358512
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - PLA_StuckHalfElf_State_HasDowry(1) = True
#. SetFlags:
#.   User:
#.     - PLA_StuckHalfElf_Knows_PlayerFoundDowry(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:b1bbfa0b-c06f-6c66-6b4e-f65f07358512
msgctxt "h542e6e1agefd8g4cb8ga91bg5531ae6a7f2e"
msgid "I think I found the dowry."
msgstr "결혼 지참금을 찾은 것 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Benryn
#. NodeID = b3f17dc0-034a-6c9d-cce3-c10e2b818128
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:b3f17dc0-034a-6c9d-cce3-c10e2b818128
msgctxt "hbf4f6967gcd8ag41f4g81abgd486060a60d5"
msgid "Fine. I hope you choke on it."
msgstr "좋아. 목이 막혀 뒤지기를 기원하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Player
#. NodeID = b461bcdd-1a57-8455-f59e-1782c3cdead9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Quest:
#.      - PLA_StuckHalfElf.FoundWife(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:b461bcdd-1a57-8455-f59e-1782c3cdead9
msgctxt "h9dc8b1cbg9b2fg435cga484g38670a063451"
msgid "Save your breath. There aren't any survivors."
msgstr "숨을 아껴. 생존자는 없을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Benryn
#. NodeID = b83531be-151e-43e8-5070-28271345dd08
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:b83531be-151e-43e8-5070-28271345dd08
msgctxt "h40deb888g2b90g42d7gb5b1g4bb617ae8f2a"
msgid "I'd need some time alone with her... to say goodbye."
msgstr "그녀와 단둘이 있을 시간이 좀 필요해요... 작별할 시간이요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Benryn
#. NodeID = b955a734-3448-257b-b53e-3c967e26138c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:b955a734-3448-257b-b53e-3c967e26138c
msgctxt "h309f4677gc9deg4ec5g8b6dgf20b09e0bf6d"
msgid "I know this doesn't change anything, but it helps. Thank you."
msgstr "이래도 바뀌는 건 없다는 건 알지만, 도움이 됐어요. 고마워요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Player
#. NodeID = bac94877-058f-94e7-6b2d-6bc1c3e69721
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - PLA_StuckDwarf_Event_AgreedToFindWife(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:bac94877-058f-94e7-6b2d-6bc1c3e69721
msgctxt "h422f4ba7g0e47g4a0eg894agdab984de4a9a"
msgid "Sorry, I haven't. But I can look for her."
msgstr "미안해, 본 적 없어. 하지만 그녀를 찾아보도록 하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Benryn
#. NodeID = bcd61020-b081-a36f-509b-b7242a50e02b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   User:
#.     - PLA_StuckHalfElf_Knows_MentionedDowry(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:bcd61020-b081-a36f-509b-b7242a50e02b
msgctxt "h0947be8bg21bfg4352gad9eg6dd9fcbec0d7"
msgid ""
"She would've survived! If only I'd kept my mouth shut about that bloody "
"dowry..."
msgstr "그녀는 분명 살아남았을 거예요! 제가 그 망할 결혼 지참금 이야기만 안 꺼냈어도..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Player
#. NodeID = be205ce9-3d8d-90a5-0b12-edf06f2d8fbb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:be205ce9-3d8d-90a5-0b12-edf06f2d8fbb
msgctxt "hb4981742g7326g4f97gb034ge1b1af6684ad"
msgid "Sorry, but I don't have it anymore."
msgstr "미안해, 하지만 이제 가지고 있지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Karlach
#. NodeID = bfafd57b-5b4e-ea7b-a7b6-ac61d5472617
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_KARLACH(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:bfafd57b-5b4e-ea7b-a7b6-ac61d5472617
msgctxt "h4d032a22g1aacg4a48ga926g33c336a57676"
msgid "I ought to smack some manners into you, you know that?"
msgstr "너 좀 예의가 뭔지 배워야겠다, 정신 안 차려?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Benryn
#. NodeID = c23c8039-6791-0069-afba-72ac0afb0313
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:c23c8039-6791-0069-afba-72ac0afb0313
msgctxt "he8a42b32g8e4cg4534gaabfg7d8f233eeedf"
msgid "No. No! Why didn't you run? Why didn't you hide?"
msgstr "안 돼. 안 돼! 왜 도망가지 않았어? 왜 숨지를 않은 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Benryn
#. NodeID = c2930af4-b945-3c2e-1f86-65c969546d80
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - PLA_StuckHalfElf_State_PlayerAngered(1) = True
#.   Quest:
#.     - PLA_StuckHalfElf.KeptGold(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:c2930af4-b945-3c2e-1f86-65c969546d80
msgctxt "h4c47321eg9c35g47c9g92f5g129412d4615d"
msgid "You... what?"
msgstr "당신이... 뭐라고요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Karlach
#. NodeID = c64802fd-0719-94d8-de44-d3ab0e2f8244
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:c64802fd-0719-94d8-de44-d3ab0e2f8244
msgctxt "h37f2241dg6229g49d9gb99ag75c0f22e2f18"
msgid "Wow. I mean. <i>Wow.</i>"
msgstr "와. 아니 진짜. <i>와...</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Benryn
#. NodeID = ca4a60af-52fa-dc93-47f9-3e9b3cd7bd61
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:ca4a60af-52fa-dc93-47f9-3e9b3cd7bd61
msgctxt "h9bd2e091gf1f9g4d52gb557ge8c79d4eb0b3"
msgid "She follows - <i>followed</i>  Gond."
msgstr "그녀가 믿는... <i>믿었던</i> 신은 곤드였어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Player
#. NodeID = ce7467c2-2d57-c301-f413-44eeb519b275
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Quest:
#.      - PLA_StuckHalfElf.FoundWife(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:ce7467c2-2d57-c301-f413-44eeb519b275
msgctxt "h3ce924f4g9113g4f6dg8a26ga00530ca43fb"
msgid "She's almost certainly dead."
msgstr "그녀는 죽은 게 분명해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Benryn
#. NodeID = cf8f515a-5ee7-574e-2281-fa2241c962d6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_StuckHalfElf_State_PlayerAngered(1) = True
#. SetFlags:
#.   Quest:
#.     - PLA_StuckHalfElf.ReachedWife(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:cf8f515a-5ee7-574e-2281-fa2241c962d6
msgctxt "hbb386333ge3b8g4821gacefg5260eaeadc56"
msgid "Leave us alone."
msgstr "우릴 가만히 내버려 둬."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Benryn
#. NodeID = d875356e-c246-fa77-9fc3-7b092e98df82
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:d875356e-c246-fa77-9fc3-7b092e98df82
msgctxt "h9b9ee904ga427g4ebagba71g49c613e93b4a"
msgid "The gods won't listen to me. It's my fault she's dead."
msgstr "신들이 응답하질 않아요. 그녀가 죽은 건 제 잘못이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Benryn
#. NodeID = dad443ef-1dfc-e42f-8c02-42510c9e3d5c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_StuckHalfElf_Knows_ExplainedDowry = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:dad443ef-1dfc-e42f-8c02-42510c9e3d5c
msgctxt "h3a391b7cg3541g4bdegb3f9gfb5d7866d973"
msgid "It's for her sister's wedding. I made a stupid joke about keeping it."
msgstr "처제의 결혼식을 위해 준비한 거였어요. 그걸 그냥 우리가 가지자고, 멍청한 농담도 했었죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Benryn
#. NodeID = dfbdd607-5c02-566d-7172-75b11c3d53a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:dfbdd607-5c02-566d-7172-75b11c3d53a8
msgctxt "h87d3fa7fg1707g45e3g846fga1d42d0c80cd"
msgid "Thank you. She would've like that."
msgstr "고마워요. 그녀도 분명 좋아했을 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Benryn
#. NodeID = e1a30499-4948-be54-a24d-afef3a1547c1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_StuckDwarf_HasMet_FoundWife(1) = True
#.   Global:
#.      - PLA_TavernInvestigation_State_HalfElfFoundWife = True
#. SetFlags:
#.   Quest:
#.     - PLA_StuckHalfElf.ReachedWife(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:e1a30499-4948-be54-a24d-afef3a1547c1
msgctxt "hcd40ebefg9b32g4482g9e0dgdaeca12999d8"
msgid "*Sob.*"
msgstr "*훌쩍.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Benryn
#. NodeID = e3b33a15-6d25-734b-a3c9-21c23221fa02
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:e3b33a15-6d25-734b-a3c9-21c23221fa02
msgctxt "h121ce5e6ga51eg47beg9ad4g3a426859ddb2"
msgid "Then get it back! I'm sorry, it's just... it's important."
msgstr "그럼 돌려줘요! 미안해요, 그건... 그건 정말 중요한 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Benryn
#. NodeID = e407e6c6-6772-d177-521f-29cc4d0b3806
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:e407e6c6-6772-d177-521f-29cc4d0b3806
msgctxt "h2da1ea10g9dd0g45fegb4bbg38c4172a8a83"
msgid "This is all my fault. We were arguing. She ran off."
msgstr "다 제 잘못이에요. 한바탕 말다툼을 벌이고 나서. 그녀가 떠나가 버렸어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Benryn
#. NodeID = e5a7b404-21cd-bf39-95bc-b291f2d39013
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Quest:
#.      - PLA_StuckHalfElf.ReturnedGold(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:e5a7b404-21cd-bf39-95bc-b291f2d39013
msgctxt "ha576a2fege919g4c07g92dfgdcabd8a23e7e"
msgid "I won't forget what you did for me. For <i>her</i>. Thank you."
msgstr "당신이 제게 베푼 은혜는 절대 잊지 않을게요. <i>미리</i>에게 베푼 것도요. 정말 고마워요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Player
#. NodeID = e78b05be-e12f-321b-1179-d29f59b6990d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_StuckHalfElf_Knows_ExplainedDowry = True
#.   Object:
#.      - PLA_StuckHalfElf_State_HasDowry(1) = True
#.   Quest:
#.      - PLA_StuckHalfElf.ReturnedGold(1) = False
#.      - PLA_StuckHalfElf.KeptGold(1) = False
#. SetFlags:
#.   Object:
#.     - PLA_StuckHalfElf_Event_GiveDowry(0) = True
#.   Quest:
#.     - PLA_StuckHalfElf.ReturnedGold(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:e78b05be-e12f-321b-1179-d29f59b6990d
msgctxt "h97a49ae2g70d2g4c52g9d28ge5e000649bee"
msgid "I found this chest - I think it's yours."
msgstr "이 상자를 찾았는데, 당신 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Benryn
#. NodeID = e90da42d-d565-790a-bcd0-293af1c247d2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:e90da42d-d565-790a-bcd0-293af1c247d2
msgctxt "ha799bddag8955g42c8gb331g9ea9a936772f"
msgid "You should've let me burn."
msgstr "그냥 내가 타죽게 내버려뒀어야 했어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Player
#. NodeID = e93fe090-7e34-09bf-338e-5c9e6e38a5ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:e93fe090-7e34-09bf-338e-5c9e6e38a5ac
msgctxt "h9d29e641g474fg48f4gace2ge275acaebd07"
msgid "There is no Gond."
msgstr "곤드는 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Shadowheart
#. NodeID = ede2246d-4982-207a-ad82-79ea314371e4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#. SetFlags:
#.   Dialog:
#.     - PLA_StuckHalfElf_Freed_SH(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:ede2246d-4982-207a-ad82-79ea314371e4
msgctxt "h2a71c799g838cg4f9ag8a29g113792b04ebb"
msgid "He can afford it - he's got one less mouth to feed now."
msgstr "그 정도는 감당할 수 있을 거야, 이제 먹일 입도 하나 줄었으니 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Benryn
#. NodeID = ee23f438-468f-b0ee-560d-3a552e412648
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:ee23f438-468f-b0ee-560d-3a552e412648
msgctxt "h3bcb4d98gf965g48bbg8ae5g7802ee81ba0a"
msgid "We argued about it for hours. Then she took the dowry and left."
msgstr "몇 시간 동안이나 그 주제로 말다툼을 벌였어요. 그리곤 그녀가 결혼 지참금을 가지고 떠나버렸죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Benryn
#. NodeID = f2dae74e-856d-13d8-bb6c-a4ac9356c012
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:f2dae74e-856d-13d8-bb6c-a4ac9356c012
msgctxt "h3b9f4c71g9806g41f5g85aag6f7066f75521"
msgid "You should've stayed... you should've been with me."
msgstr "나랑 있지 그랬어... 그냥 나하고 있었더라면..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Benryn
#. NodeID = f455a80c-a22b-7349-0f31-c359fdba1a27
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - PLA_StuckHalfElf_State_HeadingToWife(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:f455a80c-a22b-7349-0f31-c359fdba1a27
msgctxt "h8f7289f9gd30fg439ag87e5g516a2eaf5e4d"
msgid "No. No, it can't be. I need to see."
msgstr "안 돼. 그게 사실일 리 없어요. 직접 봐야겠어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Wyll
#. NodeID = f99fc6f7-2943-3c80-3b99-15c6210c1979
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:f99fc6f7-2943-3c80-3b99-15c6210c1979
msgctxt "h0fb7dc41g193eg42ddg8477gb4d88b2b6b6f"
msgid "I'm <i>overwhelmed</i> by your selflessness."
msgstr "당신의 이타심에 <i>감탄</i>이 나오네요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Benryn
#. NodeID = fa2eb1f7-1e16-142f-a4dc-da7be8cb3334
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_StuckDwarf_HasMet_Searching(1) = False
#.   Global:
#.      - PLA_TavernInvestigation_State_HalfElfFoundWife = False
#. SetFlags:
#.   Dialog:
#.     - PLA_StuckDwarf_HasMet_Searching(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:fa2eb1f7-1e16-142f-a4dc-da7be8cb3334
msgctxt "h1ff16d2eg21d7g4031g868agee5a6af3476e"
msgid "Miri... MIRI!"
msgstr "미리... 미리!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Gale
#. NodeID = fc26b0ae-6918-6738-518f-face1436cdc8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_StuckHalfElf_Freed_SH(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:fc26b0ae-6918-6738-518f-face1436cdc8
msgctxt "ha797e38ega63ag4ee8g944fgc320510a776b"
msgid ""
"Allow me to apologise on Shadowheart's behalf, sir. Her lack of tact is a "
"burden to us all."
msgstr "섀도하트를 대신해 제가 사과드리죠. 도통 눈치가 없어서 우리 모두에게 짐이 되는군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Benryn
#. NodeID = ffe6d4c8-446e-f5a7-dc3a-667437cdfff5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:ffe6d4c8-446e-f5a7-dc3a-667437cdfff5
msgctxt "h0a5d0bc6g4885g4cd8gbfaeg6bd5f9d88943"
msgid "She was wearing a green blouse. Brown hair, about this tall."
msgstr "녹색 블라우스를 입고 있었어요. 머리는 갈색이고, 키는 이 정도."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Benryn
#. NodeID = fffebf92-39a8-75cd-06cb-43bb9870e028
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed:fffebf92-39a8-75cd-06cb-43bb9870e028
msgctxt "hd987ddd1g089ag4fc4ga7c2gc133c3934f21"
msgid "I'm sorry, Miri. I'm so sorry."
msgstr "미안해, 미리. 정말 미안해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_Door
#. Speaker = Player
#. NodeID = 793eaa4c-939e-a68a-3917-812acd06b4cf
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_Door:793eaa4c-939e-a68a-3917-812acd06b4cf
msgctxt "h05e32c43gd402g4c32g9a9bg21fccc490dfe"
msgid "Cautious steps. Open that door and we go up in flames."
msgstr "조심히 걷자. 저 문 열면 불길이 들이닥칠 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_Door
#. Speaker = Player
#. NodeID = 793eaa4c-939e-a68a-3917-812acd06b4cf
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_Door:793eaa4c-939e-a68a-3917-812acd06b4cf
msgctxt "h116d2237ga943g485cgaa81g93acffd17c5f"
msgid "Yank open that door and it's <i>kaboom</i>. We need a plan."
msgstr "저 문을 그냥 열면 <i>콰광</i>하며 터져버릴 거야. 계획이 필요해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_Door
#. Speaker = Player
#. NodeID = 793eaa4c-939e-a68a-3917-812acd06b4cf
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_Door:793eaa4c-939e-a68a-3917-812acd06b4cf
msgctxt "h3eb2e8cdg4ffdg4605gbf24g9ff75adaad46"
msgid "That door feels like a furnace. Best be careful opening it."
msgstr "문이 용광로처럼 뜨겁군. 열 때 조심하는 게 좋겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_Door
#. Speaker = Player
#. NodeID = 793eaa4c-939e-a68a-3917-812acd06b4cf
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_Door:793eaa4c-939e-a68a-3917-812acd06b4cf
msgctxt "h0e2ebda7ga923g48f3gb38cg3b0088aeb199"
msgid "That door's radiating heat. Time for caution, I think."
msgstr "저 문은 열기를 내뿜고 있어. 내가 보기에는 조심하는 게 좋을 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_Door
#. Speaker = Player
#. NodeID = 793eaa4c-939e-a68a-3917-812acd06b4cf
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_Door:793eaa4c-939e-a68a-3917-812acd06b4cf
msgctxt "hc4f0f54fg6753g442aga991g04c8b7d081ab"
msgid "Door's gonna blow. If we open it, there's an inferno waiting for us."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_Door
#. Speaker = Player
#. NodeID = 793eaa4c-939e-a68a-3917-812acd06b4cf
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_Door:793eaa4c-939e-a68a-3917-812acd06b4cf
msgctxt "hd4b07baagafd0g4ef2gb802g7395cac78961"
msgid "That door is like a cork. Pop it and we'll be served a firestorm."
msgstr "저 문은 코르크 마개나 다름없어. 팡 터뜨리면 불의 폭풍이 나오겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_Door
#. Speaker = Player
#. NodeID = 793eaa4c-939e-a68a-3917-812acd06b4cf
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_Door:793eaa4c-939e-a68a-3917-812acd06b4cf
msgctxt "h355ed706g55a8g4d09g83abgda75eafee5ed"
msgid "The heat coming off that door... opening it could spell trouble."
msgstr "저 문에서 뿜어져 나오는 열기... 열면 문제가 생기겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_FoundChest
#. Speaker = Player
#. NodeID = 2fdf4029-3342-4346-ab7a-2dfb4638bc86
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_StuckHalfElf_Event_FoundChestInHay = True
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_FoundChest:2fdf4029-3342-4346-ab7a-2dfb4638bc86
msgctxt "hdcc11b7dgcb29g4591gabafg56df315b44c7"
msgid "Very nice. And to think I was expecting a needle."
msgstr "아주 좋군. 건초 더미에서 기껏해야 바늘이라도 찾을까 싶었는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_FoundChest
#. Speaker = Player
#. NodeID = 2fdf4029-3342-4346-ab7a-2dfb4638bc86
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_StuckHalfElf_Event_FoundChestInHay = True
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_FoundChest:2fdf4029-3342-4346-ab7a-2dfb4638bc86
msgctxt "hb98202cegc884g4d00g8793gaba260e2872b"
msgid "Look at that: there's a chest hidden in the hay."
msgstr "이것 좀 보게, 건초 속에 숨겨진 상자가 있군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_FoundChest
#. Speaker = Player
#. NodeID = 2fdf4029-3342-4346-ab7a-2dfb4638bc86
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_StuckHalfElf_Event_FoundChestInHay = True
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_FoundChest:2fdf4029-3342-4346-ab7a-2dfb4638bc86
msgctxt "h5f0affb0g2ae5g4db3g97c2g2a4527d86f97"
msgid "Hey! There's a chest in here."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_FoundChest
#. Speaker = Player
#. NodeID = 2fdf4029-3342-4346-ab7a-2dfb4638bc86
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_StuckHalfElf_Event_FoundChestInHay = True
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_FoundChest:2fdf4029-3342-4346-ab7a-2dfb4638bc86
msgctxt "h0b16bc75ga901g4033g81e3gc27286eca3d9"
msgid "Someone's hidden a chest in the hay."
msgstr "건초 안에 누군가가 상자를 숨겨 놓았군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_FoundChest
#. Speaker = Player
#. NodeID = 2fdf4029-3342-4346-ab7a-2dfb4638bc86
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_StuckHalfElf_Event_FoundChestInHay = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_FoundChest:2fdf4029-3342-4346-ab7a-2dfb4638bc86
msgctxt "hb1150da9g8a3ag4009g9a7fg9128b2fb7f6f"
msgid "There's something hidden in here, in the hay."
msgstr "건초더미 안에 무언가가 숨겨져 있군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_FoundChest
#. Speaker = Player
#. NodeID = 2fdf4029-3342-4346-ab7a-2dfb4638bc86
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_StuckHalfElf_Event_FoundChestInHay = True
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_FoundChest:2fdf4029-3342-4346-ab7a-2dfb4638bc86
msgctxt "h9e11289dg4f2fg4dc5g8e5bg76d8fa674ba1"
msgid "Something's hidden in that hay."
msgstr "건초더미 안에 무언가가 숨겨져 있군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_FoundChest
#. Speaker = Player
#. NodeID = 2fdf4029-3342-4346-ab7a-2dfb4638bc86
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_StuckHalfElf_Event_FoundChestInHay = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_FoundChest:2fdf4029-3342-4346-ab7a-2dfb4638bc86
msgctxt "h5239e879g4138g42e8gae47gd6a82a5ac518"
msgid "Looks like there's a chest buried in that hay."
msgstr "건초 속에 묻어놓은 상자가 하나 있는 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_FoundChest
#. Speaker = Player
#. NodeID = 89151b65-46be-445a-828a-e338a2489189
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_StuckHalfElf_Event_FoundChestInHay = False
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_FoundChest:89151b65-46be-445a-828a-e338a2489189
msgctxt "h81a026a3g72a9g4019gae5ag864347f23e1b"
msgid "Feed for the beasts."
msgstr "가축 먹이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_FoundChest
#. Speaker = Player
#. NodeID = 89151b65-46be-445a-828a-e338a2489189
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_StuckHalfElf_Event_FoundChestInHay = False
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_FoundChest:89151b65-46be-445a-828a-e338a2489189
msgctxt "h169e7f16gce13g453ag904bg0bdf0c4673c5"
msgid "An untouched stack of hay. Mustn't be any horses around."
msgstr "건초 더미가 그대로군. 주위에 말은 한 마리도 없을 게 분명해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_FoundChest
#. Speaker = Player
#. NodeID = 89151b65-46be-445a-828a-e338a2489189
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_StuckHalfElf_Event_FoundChestInHay = False
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_FoundChest:89151b65-46be-445a-828a-e338a2489189
msgctxt "h31311eccg3a50g4d99ga444gd3f11b6a4088"
msgid "Hay there."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_FoundChest
#. Speaker = Player
#. NodeID = 89151b65-46be-445a-828a-e338a2489189
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_StuckHalfElf_Event_FoundChestInHay = False
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_FoundChest:89151b65-46be-445a-828a-e338a2489189
msgctxt "h7b1f818fga899g4d45g9f6fg610be6b5c129"
msgid "Horse feed - unburned, for now."
msgstr "아직 불타기 전의 말 먹이로군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_FoundChest
#. Speaker = Player
#. NodeID = 89151b65-46be-445a-828a-e338a2489189
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_StuckHalfElf_Event_FoundChestInHay = False
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_FoundChest:89151b65-46be-445a-828a-e338a2489189
msgctxt "h72804538ga4a0g4349gbb81g18936688e1db"
msgid "You'd think some starving beast would've eaten this hay by now..."
msgstr "지금쯤 왠 굶주린 짐승이 건초를 먹어치웠을 거라고 생각하겠지..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_FoundChest
#. Speaker = Player
#. NodeID = 89151b65-46be-445a-828a-e338a2489189
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_StuckHalfElf_Event_FoundChestInHay = False
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_FoundChest:89151b65-46be-445a-828a-e338a2489189
msgctxt "hfe196008g6c37g48edgb9a1g57c995b7ce28"
msgid "How has this hay not gone up in flames?"
msgstr "이 건초는 용케도 불에 타지 않았군?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_FoundChest
#. Speaker = Player
#. NodeID = 89151b65-46be-445a-828a-e338a2489189
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_StuckHalfElf_Event_FoundChestInHay = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_FoundChest:89151b65-46be-445a-828a-e338a2489189
msgctxt "h1a19525cg3d8dg4663gae44g16c02be224ee"
msgid "Surprised this hay hasn't gone up in flames yet."
msgstr "이 건초더미가 아직 잿더미가 되지 않았다니 놀랍군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_FoundWife
#. Speaker = Player
#. NodeID = 6afa5a52-44bb-a5e7-9830-ec49b12224b0
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_FoundWife:6afa5a52-44bb-a5e7-9830-ec49b12224b0
msgctxt "h0e6edf6bge6f5g43d6g8b35gdfea8581cc1a"
msgid "Brown hair? Green dress? Looks like we found Miri."
msgstr "갈색 머리? 초록 드레스? 미리를 찾은 것 같네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_FoundWife
#. Speaker = Player
#. NodeID = 6afa5a52-44bb-a5e7-9830-ec49b12224b0
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_FoundWife:6afa5a52-44bb-a5e7-9830-ec49b12224b0
msgctxt "h74f619c9g1778g42eag8bbbgb0cb2660bd82"
msgid "Looks like Benryn's wife."
msgstr "벤린의 아내인 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_FoundWife
#. Speaker = Player
#. NodeID = 6afa5a52-44bb-a5e7-9830-ec49b12224b0
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_FoundWife:6afa5a52-44bb-a5e7-9830-ec49b12224b0
msgctxt "hc1129ef0g098ag480eg98f6ge7b55dab3c7a"
msgid "Green blouse, brown hair - must be Benryn's wife, Miri."
msgstr "초록 블라우스에, 갈색 머리 - 벤린의 아내, 미리인 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_FoundWife
#. Speaker = Player
#. NodeID = 6afa5a52-44bb-a5e7-9830-ec49b12224b0
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_FoundWife:6afa5a52-44bb-a5e7-9830-ec49b12224b0
msgctxt "h78cb6d34gd3abg49d3gb9cfgf58cf27c965a"
msgid "Look there - Benryn's wife. Miri, was it?"
msgstr "저길 봐, 벤린의 아내야. 미리라고 했나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_FoundWife
#. Speaker = Player
#. NodeID = 6afa5a52-44bb-a5e7-9830-ec49b12224b0
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_FoundWife:6afa5a52-44bb-a5e7-9830-ec49b12224b0
msgctxt "h716c5029g9614g40f8gb010g3a8b8dd72aed"
msgid "It's Miri - it's got to be."
msgstr "미리야, 분명해."

