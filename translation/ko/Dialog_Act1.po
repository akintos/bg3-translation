#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_NoticeStashSeal:78906681-bbcc-2880-1d5d-052ca046af30
msgctxt "hd91e6d45gd2b7g420cga13ag7c642ee0ed62"
msgid "There's magic at play here - a spell keeping this chest shut."
msgstr "마법이 느껴져, 저 상자를 누군가 마법으로 봉인해뒀군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_NoticeStashSeal
#. Speaker = Player
#. NodeID = 78906681-bbcc-2880-1d5d-052ca046af30
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_SeluneStash_State_StashSealCheckSuccess = True
#. SetFlags:
#.   User:
#.     - FOR_SeluneStash_NoticeStashSeal_CommentedOnSeal(0) = True
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_NoticeStashSeal:78906681-bbcc-2880-1d5d-052ca046af30
msgctxt "h9ef45cf7gfd92g43e6gbd91gb7cc9a5b8f68"
msgid "Feel that? Magic. A spell's sealed that chest tight."
msgstr "느껴져? 마법이야. 주문으로 저 상자를 봉인해뒀군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_OpenStashAsSelunite
#. Speaker = Player
#. NodeID = 1cf98390-55af-4074-800b-394b6b169300
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_OpenStashAsSelunite:1cf98390-55af-4074-800b-394b6b169300
msgctxt "h178d5079g5e93g4e1cg8facg8e1327978236"
msgid "Moonmaiden's grace! It's open!"
msgstr "달처녀의 축복이야! 열렸군!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_OpenStashWithPrayer
#. Speaker = Player
#. NodeID = 76bdea89-6b50-092b-9691-add2810f80cc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
