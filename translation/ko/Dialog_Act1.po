msgctxt "h5cb24af5gcdd8g4301g8f1cge113c309e9db"
msgid "Open. <b>Now.</b>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_TalkingDoor
#. Speaker = Narrator
#. NodeID = f09306a3-f536-77fb-af09-5f66923ded1f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAG_HagLair_State_PlayerPassedDoor(2) = True
#.   Global:
#.      - HAG_Hag_State_HagInLair = True
#. SetFlags:
#.   Dialog:
#.     - HAG_HagLair_TalkingDoor_HasMet(2) = True
#.   User:
#.     - HAG_HagLair_Knows_DoorWasAlive(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_TalkingDoor:f09306a3-f536-77fb-af09-5f66923ded1f
msgctxt "h7269ace7g6f2cg4942g89c4ge39a9687ff27"
msgid ""
"*The door trembles at the thought of the hag. She would be furious if she "
"caught intruders here.*"
msgstr "*해그를 떠올리자 문이 두려움에 흔들립니다. 그녀가 침입자들을 이곳에서 찾아낸다면 분개할 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_TalkingDoor
#. Speaker = Player
#. NodeID = f655a216-8f48-6093-a614-2a0b674a16f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_TalkingDoor:f655a216-8f48-6093-a614-2a0b674a16f1
msgctxt "hd93e0772g35d5g4426gad9bgec3ec5b24f07"
msgid "The hag will be the least of your problems if you don't open up."
msgstr "문을 열지 않으면 해그 이전에 나부터 걱정해야 될 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_TalkingDoor
#. Speaker = Player
#. NodeID = fb0573db-2b08-9334-663e-d5798f688046
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - PALADIN_ANCIENTS(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_TalkingDoor:fb0573db-2b08-9334-663e-d5798f688046
msgctxt "h37ab9804g6c1cg4d24g97acg2fa51eb1d690"
msgid ""
"The hag is perversion of nature, and I am sworn to strike her down - you "
"have nothing to fear from me."
msgstr "해그는 자연의 뒤틀림이고, 나는 이를 처단하기를 맹세하였다. 나를 두려워하지 않아도 된다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_TalkingDoor
#. Speaker = Narrator
#. NodeID = ffe9eb32-6d55-cfd8-287c-ffc676df95af
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_Hag_State_IsDead = True
#.   User:
#.      - HAG_HagLair_Knows_DoorWasAlive(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_TalkingDoor:ffe9eb32-6d55-cfd8-287c-ffc676df95af
msgctxt "h40cbb3f3g93b3g42fdgaa49gea264abe165c"
msgid "*You feel a whisper of thanks as the door's prisoner fades away.*"
msgstr "*문에 사로잡혔던 영혼이 풀려나면서 감사하다는 속삭임을 남깁니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_VB_BurningCage
#. Speaker = Player
#. NodeID = 8566e0f4-c7b9-487b-f258-d003e16f87f4
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_VB_BurningCage:8566e0f4-c7b9-487b-f258-d003e16f87f4
msgctxt "hec282950gdea6g40a9gaa92g40210e3ea66c"
msgid "That girl hasn't got long, if you planned to save her."
msgstr "그 여자애를 구할 계획이라면 시간이 얼마 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_VB_BurningCage
#. Speaker = Player
#. NodeID = 8566e0f4-c7b9-487b-f258-d003e16f87f4
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_VB_BurningCage:8566e0f4-c7b9-487b-f258-d003e16f87f4
msgctxt "h240e5941gdcebg4408ga83cg76b4b6b6173b"
msgid "The cage is burning! There isn't much time to save her!"
msgstr "새장이 불타고 있어! 그녀를 구할 시간이 많지 않아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_VB_BurningCage
#. Speaker = Player
#. NodeID = 8566e0f4-c7b9-487b-f258-d003e16f87f4
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_VB_BurningCage:8566e0f4-c7b9-487b-f258-d003e16f87f4
msgctxt "h386ad120gdfddg4ae3gae31g028f30577c57"
msgid "The cage is going to drop. We've got to help her!"
msgstr "새장이 떨어지려고 해. 그녀를 도와줘야 해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_VB_BurningCage
#. Speaker = Player
#. NodeID = 8566e0f4-c7b9-487b-f258-d003e16f87f4
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_VB_BurningCage:8566e0f4-c7b9-487b-f258-d003e16f87f4
msgctxt "h23b0f9adg7bdag4c6dg9abag3e2622dafe3b"
msgid "The cage won't last long. Nor will the girl."
msgstr "저 새장은 오래 가지 않을 거야. 여자애도 마찬가지야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_VB_BurningCage
#. Speaker = Player
#. NodeID = 8566e0f4-c7b9-487b-f258-d003e16f87f4
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_VB_BurningCage:8566e0f4-c7b9-487b-f258-d003e16f87f4
msgctxt "h170d6e7eg1459g4101gb0a9g174578f685e5"
msgid "She'll be roast like a goose if that fire isn't put out."
msgstr "불을 끄지 않으면 그녀는 거위처럼 구워질 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_VB_BurningCage
#. Speaker = Player
#. NodeID = 8566e0f4-c7b9-487b-f258-d003e16f87f4
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_VB_BurningCage:8566e0f4-c7b9-487b-f258-d003e16f87f4
msgctxt "h47159f93g4b12g4050g9535g1d98f6f30dac"
msgid "Damn it... the cage! Got to put out that fire."
msgstr "젠장... 저 새장! 불을 꺼야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_VB_BurningCage
#. Speaker = Player
#. NodeID = 8566e0f4-c7b9-487b-f258-d003e16f87f4
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_VB_BurningCage:8566e0f4-c7b9-487b-f258-d003e16f87f4
msgctxt "h7b6c5de9g07c9g4a29g88d1g90ee01edd2a7"
msgid "That cage won't last!"
msgstr "저 새장은 오래가지 못해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_VB_EnteredGallery
