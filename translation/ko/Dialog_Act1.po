msgctxt "h426e872cga753g41a9g9c46ga55136765395"
msgid "Thulla, what have they done to you..."
msgstr "툴라, 놈들이 네게 무슨 짓을 한 거야..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_MyconidCircle_AD_GnomesSaved
