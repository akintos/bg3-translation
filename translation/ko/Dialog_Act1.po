msgctxt "hd4f3f514g26e0g4237ga47egde475b7bf723"
msgid "Capture... return... Baldur's Gate..."
msgstr "잡아서... 돌려보내야... 발더스 게이트로..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter_Dead
#. Speaker = Narrator
#. NodeID = 6f167dcf-5192-5464-9626-5beac7a41faf
