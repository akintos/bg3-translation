msgctxt "h3ba57f40g898fg4737g83aeg1b3824baa9a7"
msgid "*The dog remains at the dead man's side, as if in mourning.*"
msgstr "*개는 애도를 하듯 죽은 남자 곁에 머뭅니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Player
#. NodeID = 5c64cd5b-57c3-387e-2f9e-0e318a92ab72
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:5c64cd5b-57c3-387e-2f9e-0e318a92ab72
msgctxt "hdfab90b7geffbg497bg9ad0gc59792a77a17"
msgid "What happened here?"
msgstr "여기서 무슨 일이 있었지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Scratch
#. NodeID = 5e6a2cc2-ab06-d88c-511a-d92f9abcbfbe
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
