msgctxt "h050cffbcg6026g4f88g91b4ga9b33f7af943"
msgid ""
"*You feel the rat twitching on the edge of panic - something waits in the "
"great hollow below.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RatRacket_LocalRat_002
#. Speaker = Narrator
#. NodeID = 0b94b338-65c3-120e-f731-014458b40f91
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RatRacket_LocalRat_002:0b94b338-65c3-120e-f731-014458b40f91
msgctxt "h9bbafbe6g44a6g493cgbfd3g7db857fb96f0"
msgid ""
"*There is a light here, in the tight space beneath the floor. Secret things "
"that <i>shine</i>.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RatRacket_LocalRat_002
#. Speaker = Rat
#. NodeID = 5e81d36b-452d-b9f5-3aaa-f37f247eaa87
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
