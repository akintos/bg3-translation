msgctxt "h3ac28ebbg6ea4g4442gb559gf6bfdc51e99b"
msgid "*In spite of your reservations, she's telling the truth.*"
msgstr "*당신의 의심에도 불구하고, 그녀는 진실을 말하고 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/AstralPlane/CRE_AstralPrison_Daisy
#. Speaker = Narrator
#. NodeID = 443f6bfe-5635-5394-8cbf-0cecd115ff18
