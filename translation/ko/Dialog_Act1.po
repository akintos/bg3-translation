#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:4d0ba93f-922f-4045-b899-33d2f8a94799
msgctxt "h5b9d6156g23d8g4eceg988dga1ee994770b6"
msgid "I won't do that."
msgstr "그렇겐 못 하겠는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Player
#. NodeID = 4e331e92-5629-4eea-b26f-d028e8a2e0b2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:4e331e92-5629-4eea-b26f-d028e8a2e0b2
msgctxt "h44d462e1g176bg44aagbfb1gdf4945470034"
msgid "You want me to sacrifice one of my friends?"
msgstr "내가 친구 한 명을 희생시키길 원하나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Gale
#. NodeID = 4e4e52e8-0f2d-499f-b8bd-b548ae1567e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:4e4e52e8-0f2d-499f-b8bd-b548ae1567e2
msgctxt "he965940dga811g4b83g9877g18fc52d263d3"
msgid "Not treading carefully, then? Out with a bang it is."
msgstr "조심스러운 접근은 때려치자고? 막나가보자고 그럼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Player
#. NodeID = 50995633-9df6-66b0-f12b-357348ed8271
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:50995633-9df6-66b0-f12b-357348ed8271
msgctxt "hcfa5b63cg1b08g4a46gbc62gc28fc7a3031e"
msgid "<i>[To priest]</i> Well? Bow before BOOOAL's Chosen!"
msgstr "<i>[사제에게]</i> 알겠어? 부알의 선택받은 자에게 고개를 조아려라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Player
#. NodeID = 529d0f28-a66a-83d4-e83d-c90fed6fc3f8
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Object:
#.      - UND_KuoToaGod_KnowsGodIsFey(2) = True
#.      - UND_KuoToaGod_State_KnowsGodIsFake(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:529d0f28-a66a-83d4-e83d-c90fed6fc3f8
msgctxt "h120a465eg7777g4428g9399g3da14b01ffe4"
msgid "Are your followers aware you're just a rabid little fey creature?"
msgstr "너의 신도들은 네가 광견병 걸린 작은 페이 생명체에 불과하다는 걸 알고 있나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Astarion
#. NodeID = 5303cfe0-9f4a-43b5-b65e-9bac77256e3e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:5303cfe0-9f4a-43b5-b65e-9bac77256e3e
msgctxt "hde24182fgb749g487ag9fd4g9d171ec4d2c9"
msgid "What? You're bowing to this gutter-throated idol?"
msgstr "뭐야? 이 웃기게 생긴 우상에게 머리를 숙이고 있는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Astarion
#. NodeID = 5a45e4ae-37c2-b19a-305b-bca197a8c628
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:5a45e4ae-37c2-b19a-305b-bca197a8c628
msgctxt "hbc352e26gce83g453fg823ag6bd64cb6896b"
msgid "You wretched little worm. I'll show you murder worthy of a god!"
msgstr "이 하찮은 벌레놈아. 내가 신에게 걸맞은 살인을 보여주겠다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Player
#. NodeID = 6656d111-1a3a-b41f-9c8f-593a8d41a6a1
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_DARK_URGE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:6656d111-1a3a-b41f-9c8f-593a8d41a6a1
#, fuzzy
msgctxt "ha92c0c84gaeaeg40deg8feegcf7611fcbdc5"
msgid "A demonstration of what a <i>real </i>champion of death can do."
msgstr "<i>진짜</i> 살육의 군주가 뭘 할 수 있는지 보여주는 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Player
#. NodeID = 6656d111-1a3a-b41f-9c8f-593a8d41a6a1
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: CLERIC
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:6656d111-1a3a-b41f-9c8f-593a8d41a6a1
msgctxt "h0c173e16g812eg4184g84c0g2b3700cd7707"
msgid "The wrath of a far greater god - let me show you."
msgstr "훨씬 더 위대한 신의 분노를 너에게 보여주겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Player
#. NodeID = 6656d111-1a3a-b41f-9c8f-593a8d41a6a1
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:6656d111-1a3a-b41f-9c8f-593a8d41a6a1
msgctxt "h1d428685g0770g4398g9f85gb4f11f5f2955"
msgid "The mercy of a quick death."
msgstr "빠른 죽음의 자비다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = BOOOAL
#. NodeID = 6749842f-416f-9840-cd4e-b3e56e441429
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:6749842f-416f-9840-cd4e-b3e56e441429
msgctxt "h0ba660fegb967g4236gb8b4g2f794f15747f"
msgid "THAT SO, CUTLET? I'M A GOD, AND I FANCY A BIT OF MURDER. SIMPLE ENOUGH."
msgstr "그래서 어떻다는 거지, 고깃덩이야? 난 신이고, 살인을 좀 원하는 것이다. 간단하다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Lae'zel
#. NodeID = 686b4ce9-4b3f-46bd-97ec-afd4a1c3a5bb
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - UND_KuoToaGod_State_PresentForSacrifice(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:686b4ce9-4b3f-46bd-97ec-afd4a1c3a5bb
msgctxt "h1d4241a8g78dfg419egbde1ga22fa6aa526b"
msgid ""
"You wouldn't <i>dare</i> betray a child of Gith on the whims of this web-"
"toed wonder."
msgstr "네가 <i>감히</i> 이 물갈퀴 달린 놈의 변덕에 따라 기스의 아이를 배반하진 않겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Player
#. NodeID = 68fcac0e-dd84-3735-1285-347848d272ff
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_KuoToaGod_State_KnowsGodIsFake(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:68fcac0e-dd84-3735-1285-347848d272ff
msgctxt "h10b99ee6g6f79g4621g99dcg94162ad224dd"
msgid "You can give it a rest. Your 'god' isn't real."
msgstr "이제 그만해. 너희 '신'은 진짜가 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Narrator
#. NodeID = 69b3f66f-e439-7bb3-c3a1-33f5e853f3b6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - UND_KuoToaGod_State_KnowsGodIsRedcap(2) = True
#.     - UND_KuoToaGod_KnowsGodIsFey(2) = True
#.     - UND_KuoToaGod_State_KnowsGodIsFake(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:69b3f66f-e439-7bb3-c3a1-33f5e853f3b6
msgctxt "h78855ab1g1551g4769g8bbcgd671a95478d4"
msgid ""
"*That sickle blade - it's no religious totem. It belongs to a common redcap, "
"fey creatures known for their bloodlust.*"
msgstr ""
"*시클 칼날이 있군요. 이건 종교적인 상징물이 아닙니다. 피를 갈망하는 것으로 알려진 페이 생명체인 레드캡이 흔히 소지하는 물건입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Karlach
#. NodeID = 6a4f8f57-ced6-43e5-b868-6919c50b7c67
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:6a4f8f57-ced6-43e5-b868-6919c50b7c67
msgctxt "h54bafc43g2bbdg43cbg8264g2e3ab39d446a"
msgid ""
"Godsdammit soldier, I trusted you! And now I have to kill you <i>and </i>all "
"these weird fish lads. Ugh!"
msgstr "젠장할 신참, 널 믿었는데! 이제 <i>너와 </i>그 물고기 녀석들을 다 죽여야 하잖아. 윽!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = BOOOAL
#. NodeID = 6c296e9f-1046-c356-3038-2700196a86cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:6c296e9f-1046-c356-3038-2700196a86cb
msgctxt "hd2dee83dge9a7g4148gb118ga38a4004b521"
msgid "BUT CHOSEN... JUST DON'T FORGET WHERE YOU GOT IT FROM."
msgstr "하지만 선택받은 자여... 네가 이것을 어디서 얻었는지는 잊지 말아라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = BOOOAL
#. NodeID = 6d137585-c9f9-9a26-f52e-7839f8bbf9a0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:6d137585-c9f9-9a26-f52e-7839f8bbf9a0
msgctxt "h2726ca04gea7cg4053g8358g4e3f2f7bebd6"
msgid ""
"YES, PRIEST. TRUST BOOOAL. THAT'UN'S A HERETIC - SO <i>START CUTTING.</i>"
msgstr "그렇다, 사제여. 부알을 믿어라. 이 녀석은 이단자다. 그러니 <i>절개를 시작하라.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = BOOOAL
#. NodeID = 6e9ad438-221d-08d2-ff08-16364c93ee3d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_KuoToaGod_Event_BetrayedBOOOAL = True
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:6e9ad438-221d-08d2-ff08-16364c93ee3d
msgctxt "hde72d6a3gba03g487cg8125gc7ebf4e1f385"
msgid "No, no, NO! I'm the Lord of Murder, ME!"
msgstr "아냐, 아냐, 아냐! 내가 살인의 군주다, 내가!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Player
#. NodeID = 6f1ba5f9-b083-7146-2722-5995f5ec027c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:6f1ba5f9-b083-7146-2722-5995f5ec027c
msgctxt "h15ffe4a2gbcffg4302ga952g2c4e3fe1c86b"
msgid "I don't need your power - or theirs."
msgstr "나는 너의 힘 필요 없어. 저들의 힘도."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = BOOOAL
#. NodeID = 6fc00bd6-fdd5-1e61-0de5-aa05c5dd9a83
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:6fc00bd6-fdd5-1e61-0de5-aa05c5dd9a83
msgctxt "h5a25e4bcg8a12g4bffg84deg672697b7abda"
msgid ""
"HERE. THIS BLADE IS MY TONGUE - AND I WANT A TASTE OF EVERY LIFE YOU TAKE."
msgstr "이것이다. 이 칼날은 내 혀와 같노라. 나는 네가 빼앗는 모든 생명의 맛을 보고 싶구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Player
#. NodeID = 72eb064b-c04b-2f39-233b-62fcdd5d6529
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 20
#. CheckFlags:
#.   Tag:
#.      - PALADIN(2) = True
#.      - OATHBREAKER(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:72eb064b-c04b-2f39-233b-62fcdd5d6529
msgctxt "h6fcab7f3g8da2g4a76g90a0g02ed2aec96a1"
msgid "I need no god to claim my power. I will show them the way of my oath."
msgstr "내가 힘을 얻는 데는 어떤 신도 필요 없어. 이들에게 내 맹세의 길을 보이겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Wyll
#. NodeID = 73ac9d39-1ebe-4b5a-a914-3e5d4794860d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:73ac9d39-1ebe-4b5a-a914-3e5d4794860d
msgctxt "h896bfdc4g86a0g47f9gb2adg5f4696c90f34"
msgid "So it's like that, is it? So be it - the Blade does not yield!"
msgstr "그러겠다는 거지? 그렇게 해. 내 칼날은 굴복하지 않는다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = BOOOAL
#. NodeID = 773f7c65-9330-4ce0-ba87-38c26665aa5d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:773f7c65-9330-4ce0-ba87-38c26665aa5d
msgctxt "h3c5885bbga3b4g4423gbbb4g925587deb7f5"
msgid "GONNA BREAK YOU UNDER MY BOOTS! GONNA BATHE IN YOUR BLOOD!"
msgstr "너를 내 신발로 밟아 부숴버리겠다! 네 피로 목욕을 하겠다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = BOOOAL
#. NodeID = 7956b2c4-ecd2-4d69-ace1-dc53b14b21bb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:7956b2c4-ecd2-4d69-ace1-dc53b14b21bb
msgctxt "he5887d7cg9f76g4b47g86a3g7877e228c98e"
msgid "OH? WHAT'S THAT, THEN? SEE YOU GOT MEAT TO SPARE."
msgstr "<b>오? 그게 뭐지? 여분의 고기를 갖고 있는 거 같네</b>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Player
#. NodeID = 7a4d766a-78fc-f321-6b55-7f7d18225158
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 20
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:7a4d766a-78fc-f321-6b55-7f7d18225158
msgctxt "h4a53c9d0ge484g40f0g9e37gd2afd9fe4e85"
msgid "<i>Try to determine who - or what - they're talking to.</i>"
msgstr "<i>그들이 누군가, 아니면 무엇을 향해 말하고 있는지 파악하려 노력한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = BOOOAL
#. NodeID = 7b9bed77-c0fc-f558-563b-08740429fa62
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:7b9bed77-c0fc-f558-563b-08740429fa62
msgctxt "h1488a431g6788g45b7g9e3eg491dfe7dced7"
msgid "WELL, PRIEST? BOOOAL WANTS A SACRIFICE! BOOOAL WANTS <i>BLOOD.</i>"
msgstr "알겠나, 사제여? 부알이 희생을 원한다! 부알이 <i>피</i>를 원한다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Player
#. NodeID = 7dc71eec-c8a5-4f7b-bcbb-e0f968b93287
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 20
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:7dc71eec-c8a5-4f7b-bcbb-e0f968b93287
msgctxt "hfb374724g627cg44d7gafe8geca7cb0007f0"
msgid "I have only one life. But I can kill many more in your name."
msgstr "내 생명은 하나밖에 없어. 하지만 내가 너의 이름으로 더 많은 이들을 죽일 수 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Narrator
#. NodeID = 7f997c4d-46e4-fafa-d045-49c33c589939
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - UND_KuoToaGod_State_KnowsGodIsFake(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:7f997c4d-46e4-fafa-d045-49c33c589939
#, fuzzy
msgctxt "h47fd5507g613eg469bg91e9gba5dd8b58a32"
msgid ""
"*'Boooal' is not a recorded kuo-toa god, but the species is susceptible to "
"mind control and trickery. This wouldn't be their first pretender god.*"
msgstr ""
"*'부알'은 기록되어 있는 쿠오토아 신이 아니지만, 이 종들은 마인드 컨트롤과 속임수에 취약합니다. 이 자가 그들에게 처음 신을 행세한 "
"자는 아닐 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = BOOOAL
#. NodeID = 81814366-ab0f-c621-a640-324accf41050
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:81814366-ab0f-c621-a640-324accf41050
msgctxt "h1849099eg9c82g49adg8358gaf67d55cfbf5"
msgid "NO! NO! <i>Stop that!</i>"
msgstr "안 돼! 안 돼! <i>그만둬!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Pooldripp the Zealous
#. NodeID = 82c578d3-5b53-5d98-4797-0810563e6b22
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN_ANCIENTS(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:82c578d3-5b53-5d98-4797-0810563e6b22
msgctxt "h9498c099gd469g47b5ga8fega5f6370db880"
msgid ""
"Yes. <i>Yes</i> - I sense light. <i>Love. </i>A new god, to show us the way!"
msgstr "그래. <i>이거야</i> - 빛. <i>사랑</i>이 느껴져. 우리의 길을 보여줄 새로운 신이다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Pooldripp the Zealous
#. NodeID = 86a92a64-7327-a449-8973-d91bf1fbb55a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:86a92a64-7327-a449-8973-d91bf1fbb55a
msgctxt "h01b25173gc1e2g4621gb6f0g7f89bd61e2a8"
msgid "... blessed Boooal... what...?"
msgstr "... 축복받은 부알이시여... 뭐라고요...?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = BOOOAL
#. NodeID = 8a05e9d4-45b8-6f39-9c44-8d9c5588418d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:8a05e9d4-45b8-6f39-9c44-8d9c5588418d
msgctxt "h835d9864gc3e7g48a0g9968g9d825bd1125e"
msgid "WELL IT ISN'T MURDER IF YOU'RE <i>WILLING</i> - IS IT, CUTLET?"
msgstr "네가 <i>자청하면</i> 살인이 아니지. 안 그런가, 고깃덩이야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Player
#. NodeID = 93662200-8da2-31c2-3236-a7a2d9c6bf82
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_DarkUrge_State_SuspectedAlfiraMurder = True
#.      - NIGHT_DarkUrge_MurderOfAlfira = True
#.   Tag:
#.      - REALLY_DARK_URGE(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:93662200-8da2-31c2-3236-a7a2d9c6bf82
msgctxt "hdb139758gb423g4545ga644g52b477343046"
msgid "Fool. I kill in my sleep. If you seek death, death itself is here."
msgstr "바보. 난 자면서도 죽여. 죽음 그 자체가 바로 여기 있는 거잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = BOOOAL
#. NodeID = 9613bbf8-c5c0-498e-8856-991e0f5f80fe
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - UND_KuoToaGod_State_KnowsGodIsRedcap(2) = True
#.     - UND_KuoToaGod_State_KnowsGodIsFake(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:9613bbf8-c5c0-498e-8856-991e0f5f80fe
msgctxt "heb334a14gbd1ag4de1gafb6gd2c2ca1d2ddc"
msgid "YES! GOOD - <i>MORE!</i>"
msgstr "그래! 좋아 - <i>더 들려줘!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Pooldripp the Zealous
#. NodeID = 98f9c238-42b1-7ca1-eb9b-9ac70677296a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:98f9c238-42b1-7ca1-eb9b-9ac70677296a
msgctxt "h4d9e4b0dg6d34g4784g80afg8b2c9aed0de8"
msgid "Not... real?"
msgstr "진짜가... 아니라고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Player
#. NodeID = 990b4f72-d999-a3bd-e1e1-c9513928c34b
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:990b4f72-d999-a3bd-e1e1-c9513928c34b
msgctxt "h2405e835gfee9g49b5gb5efgc9987e3bb2c8"
msgid "<i>Murmur a prayer. Wherever you go, </i>your <i>god holds sway.</i>"
msgstr "<i>기도문을 읊는다. 당신이 어디를 가든 </i>당신의 <i>신은 굽어살피신다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Player
#. NodeID = 9a71de39-f618-477b-9eaf-15157d505203
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_KuoToaGod_State_PresentForSacrifice(7) = True
#. SetFlags:
#.   Object:
#.     - UND_KuoToaGod_State_SacrificedCompanion(7) = True
#.     - GLO_Companion_Combat(7) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:9a71de39-f618-477b-9eaf-15157d505203
msgctxt "h3abd7dfdgd431g4b86g8c58g569a2dcf72ee"
msgid "Take Gale."
msgstr "게일을 데려가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Player
#. NodeID = 9d33b54c-f475-550a-9db6-4f5da33c0ddd
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 15
#. CheckFlags:
#.   Object:
#.      - UND_KuoToaGod_State_KnowsGodIsFake(2) = False
#.   Tag:
#.      - BARD(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:9d33b54c-f475-550a-9db6-4f5da33c0ddd
#, fuzzy
msgctxt "h336d56abg822fg441cgb0d5g708e0231c17c"
msgid ""
"<i>Think back to your studies of kuo-toa and their gods for any useful "
"information. </i>"
msgstr "<i>유용한 정보를 찾아 쿠오토아와 그들의 신에 대해 연구했던 기억을 떠올린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Pooldripp the Zealous
#. NodeID = 9df285d0-3053-013d-c167-3adc69c13b05
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Not_For_EA = True
#.   Tag:
#.      - PALADIN_VENGEANCE(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:9df285d0-3053-013d-c167-3adc69c13b05
msgctxt "hf4df0336gc346g42cbg8866g9a3656ddaadb"
msgid ""
"Yes. <i>Yes</i> - I sense judgement. <i>Retribution. </i>A new god, to show "
"us the way!"
msgstr "그래. <i>이거야</i> - 심판. <i>응징</i>이 느껴져. 우리의 길을 보여줄 새로운 신이다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Player
#. NodeID = 9fd075fb-b15f-4706-a4a8-0e713fa5749a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_KuoToaGod_State_PresentForSacrifice(3) = True
#. SetFlags:
#.   Object:
#.     - UND_KuoToaGod_State_SacrificedCompanion(3) = True
#.     - GLO_Companion_Combat(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:9fd075fb-b15f-4706-a4a8-0e713fa5749a
msgctxt "hb861201dgb31ag41ddga406g5f5aa9d27bb1"
msgid "Take Astarion."
msgstr "아스타리온을 데려가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = BOOOAL
#. NodeID = a02aebd2-ab84-d3e3-f59a-74a316af33b2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_KuoToaGod_Event_GiveBlessing = True
#.     - UND_KuoToaGod_State_PlayerIsChosen = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:a02aebd2-ab84-d3e3-f59a-74a316af33b2
msgctxt "h97dc7df8g5be8g4c3bga81cg7c80d4936ebe"
msgid "GO WITH MY BLESSING - SHOW THE WORLD THE POWER OF BOOOAL!"
msgstr "<b>나의 축복을 받아가라- 세상에 부알의 힘을 알려라</b>!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Player
#. NodeID = a0d36776-2040-c66f-b7fc-a7c29d40bf42
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 20
#. CheckFlags:
#.   Local:
#.      - 6bfbe501-bd79-080a-7cb0-1ada96aab23f_HasChallengedBoooal = True
#.   Tag:
#.      - BARD(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:a0d36776-2040-c66f-b7fc-a7c29d40bf42
msgctxt "hb1f18a40g173cg49e1g8f7bga5dee5bacad8"
msgid "<i>LIAR</i>. DESTROY THE PRETENDER GOD, MY CHOSEN!"
msgstr "<i>거짓말쟁이</i>. 신을 사칭하는 자를 파괴하라, 선택받은 자여!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Player
#. NodeID = a64edecd-134d-4c2e-9e04-fbc786fdc8b3
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_BHAAL or PALADIN_BHAAL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:a64edecd-134d-4c2e-9e04-fbc786fdc8b3
msgctxt "h58ca3041g214ag4422g9b77g18e9a335d034"
msgid ""
"Bhaal is the true Lord of Murder. Perhaps I should offer <i>you</i> instead."
msgstr "진짜 살인의 군주는 바알이다. 대신에 <i>널</i> 공물로 바쳐도 되겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Wyll
#. NodeID = aac55442-5356-4fd4-8827-83346951093d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - UND_KuoToaGod_State_PresentForSacrifice(6) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:aac55442-5356-4fd4-8827-83346951093d
#, fuzzy
msgctxt "he2325434gb609g4209g9aaag601bf20cf24c"
msgid ""
"Don't be rash, now. I may be tolerant, but I won't let myself be fed to the "
"fishes."
msgstr "성급해하지 마라, 지금은 말이지. 칼날은 마음이 널을지언정, 스스로 물고기밥이 되려 하진 않을 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Player
#. NodeID = ace32451-b3ba-4977-af80-8f11e65e9837
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:ace32451-b3ba-4977-af80-8f11e65e9837
msgctxt "h37f9dc3egda81g4923g8decgb1801cd7836b"
msgid "'BOOOAL'? <i>Bhaal</i> is the god of murder."
msgstr "'부알'? 살인의 신은 <i>바알</i>인데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Narrator
#. NodeID = b1942b22-d890-f49f-ced0-104d31016bbb
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - UND_KuoToaGod_State_KnowsKuoToa(2) = True
#.     - UND_KuoToaGod_State_KnowsGodIsFake(2) = True
#. TagRule: REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:b1942b22-d890-f49f-ced0-104d31016bbb
msgctxt "h2b876328g8a94g4be9g9998g8639c927a34d"
msgid ""
"*These beings are kuo-toa - former <i>ghaik</i> playthings that manifest "
"their gods through sheer <i>belief</i>.*"
msgstr ""
"*이 존재들은 쿠오토아입니다. 과거에는 <i>게이크</i>의 노리개였으며, 순전한 <i>믿음</i>으로 자신들의 신을 불러옵니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Narrator
#. NodeID = b1942b22-d890-f49f-ced0-104d31016bbb
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Object:
#.     - UND_KuoToaGod_State_KnowsKuoToa(2) = True
#.     - UND_KuoToaGod_State_KnowsGodIsFake(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:b1942b22-d890-f49f-ced0-104d31016bbb
msgctxt "hd803f58fge6ccg46efgb041g453173746375"
msgid ""
"*These beings are kuo-toa - former mind flayer slaves that manifest their "
"gods through sheer <i>belief</i>.*"
msgstr "*이 존재들은 쿠오토아입니다. 과거에는 마인드 플레이어의 노예였으며, 순전한 <i>믿음</i>으로 자신들의 신을 불러옵니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Astarion
#. NodeID = b2c3904f-3727-46f5-920a-b9adc08dd9f6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - UND_KuoToaGod_State_PresentForSacrifice(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:b2c3904f-3727-46f5-920a-b9adc08dd9f6
msgctxt "h300d321eg0d1bg4dc9g851cg51844c47891c"
msgid ""
"I want to wake up beside a handsome virgin every morning, but life doesn't "
"give us what we want. Can we kill this 'god' now?"
msgstr ""
"매일 아침 잘 생긴 총각 옆에서 깨어나고 싶지만, 인생은 우리가 원하는 걸 다 주진 않잖아. 이제 우리가 이 '신'을 죽일 수 있을까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Narrator
#. NodeID = b512b96d-cf59-4616-2056-6b7cd083f62e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - UND_KuoToaGod_KnowsGodIsFey(2) = True
#.     - UND_KuoToaGod_State_KnowsGodIsFake(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:b512b96d-cf59-4616-2056-6b7cd083f62e
msgctxt "hfde8a77bg0a4eg48f0g95f7gea5190232af9"
msgid ""
"*This presence... the magic is not divine, but fey. And it is "
"<i>murderous</i>.*"
msgstr "*이 기운... 이건 신성 마법이 아니라, 페이의 것입니다. 그리고 <i>살인적인</i> 의도를 품고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Player
#. NodeID = b94d4b65-b7b4-3f9f-c8ac-3526ffb7b2bb
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARD(2) = True
#. SetFlags:
#.   Local:
#.     - 6bfbe501-bd79-080a-7cb0-1ada96aab23f_HasChallengedBoooal = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:b94d4b65-b7b4-3f9f-c8ac-3526ffb7b2bb
msgctxt "h3a1a0e04g38c3g4061gaa2cgefe1e52fa7c2"
msgid ""
"<i>I</i> AM BOOOAL, LORD OF MURDER, VISCOUNT OF VIOLENCE. THIS ONE "
"<i>LIES</i>."
msgstr "<b>나는 살인의 군주, 폭력의 주인인 부알이다. 이 놈은 거짓말을 하는군</b>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = BOOOAL
#. NodeID = bcedd5bd-2da5-4a8c-b6aa-20af06a9d365
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_KuoToaGod_State_PlayerIsChosen = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:bcedd5bd-2da5-4a8c-b6aa-20af06a9d365
msgctxt "hf2259126g047fg48a3g8d79g1aad9515572e"
msgid "THAT SOUNDS LIKE A LOT MORE BLOOD. A LOT MORE MESS. <i>GOOD.</i>"
msgstr "훨씬 더 많은 피. 훨씬 더 많은 소동을 보겠구나. <i>좋아.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Player
#. NodeID = bd425e7c-7a25-cc4e-975d-73cf940a095a
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:bd425e7c-7a25-cc4e-975d-73cf940a095a
msgctxt "h3fec1970gb659g4e1bg999fg43668ae5d21c"
msgid "He's a fabrication. Whatever you created him for, you don't need him."
msgstr "그는 허구의 존재야. 너희가 무엇을 위해 그를 나타나게 하든, 너희에겐 필요 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Shadowheart
#. NodeID = befe8277-f84e-475b-920a-b6e7ed36ab4d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - UND_KuoToaGod_State_PresentForSacrifice(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL:befe8277-f84e-475b-920a-b6e7ed36ab4d
msgctxt "h103b7df1g451fg45f7gbc0fg591b7cea95c9"
msgid "Well don't look at <i>me</i>."
msgstr "날 쳐다보지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_KuoToaGod_SpeakWithBOOOAL
#. Speaker = Player
