msgctxt "hb3cb43e3g0a22g4f8fga0e0gb8d9ac5a2fa2"
msgid "'Scuse me. The other drow are inside. Planning an' such."
msgstr "실례합니다만, 다른 드로우는 안에 있어요. 계획을 세우고 있죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = 3ee30493-b955-a004-976e-3a04728e5c4a
