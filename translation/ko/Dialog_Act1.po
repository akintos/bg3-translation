#. RollAbility: Charisma
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:c2f63bcc-c907-0f32-5606-ade52a3dcf9b
msgctxt "h44231eb7gd064g46dbgb37fg112b9e391457"
msgid "Your leader summoned me."
msgstr "너의 지도자가 나를 불렀다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = c444570e-c9df-4d26-cf56-9596d148356f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:c444570e-c9df-4d26-cf56-9596d148356f
msgctxt "hec39f8a0ga233g47d5g82b8g6c14bc1c523b"
msgid ""
"Them's the rules. You follow 'em now or you follow 'em dead. What'll it be?"
msgstr "그게 규칙이거든. 지금 따르지 않으면 너는 죽은 녀석들을 따라가게 될 거야. 어떻게 할래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Player
#. NodeID = c4e26be6-8e4c-f884-6619-724d7b1de132
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:c4e26be6-8e4c-f884-6619-724d7b1de132
msgctxt "h8ce33792g7cdeg4edeg9acaga52330f1f76d"
msgid "I think I'm just going to leave."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = c808e09c-a689-67f3-9cf7-b0f97d48b85e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:c808e09c-a689-67f3-9cf7-b0f97d48b85e
msgctxt "h4c18f239gc2f2g4a03g9768g31bd9c42e7c7"
msgid ""
"Be a shame if you came all this way without havin' a look. But I can't let "
"you pass just like that."
msgstr "여기까지 오면서 구경도 안하고 지나쳤다면 부끄러운 일이야. 하지만 그렇게 그냥 지나칠 수는 없지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = c857a5ac-bc1d-4bd2-2bf9-3c535694feab
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_Knows_LeaderNameKing = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:c857a5ac-bc1d-4bd2-2bf9-3c535694feab
msgctxt "h824bff8fg726dg4333g9b32gd7049ddc5a80"
msgid "Don't know Dror Ragzlin's name? Bit odd, don't you think, lads?"
msgstr "드롤 라그즐린의 이름을 몰라? 좀 이상하지 않냐, 아그들아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = cbc2e57e-38d7-394f-b289-4cdcaf732573
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:cbc2e57e-38d7-394f-b289-4cdcaf732573
msgctxt "h95ddc6cfg198cg4b42g98c5gbc64e1f08ba0"
msgid "You'll eat my blade first!"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = cbd6ebc6-34ad-a902-6bc6-40c79a76465c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:cbd6ebc6-34ad-a902-6bc6-40c79a76465c
msgctxt "h42542555g8f09g44acg9cfcgffba217c2d98"
msgid "'Course. Ripped out three bellies on our last raid alone."
msgstr "당연하지. 지난번 습격에서만 배때기를 세 개나 뜯어냈어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = ccb9bd56-e765-6696-8c4a-e5320e606cb8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_Checkpoint_State_GainedAccess = True
#.     - GOB_Checkpoint_State_PretendedToBeTrueSouls = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:ccb9bd56-e765-6696-8c4a-e5320e606cb8
msgctxt "h6207b842g46d1g4c91g9a00gea2764cd0877"
msgid "Enjoy the party!"
msgstr "파티를 즐겨!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Player
#. NodeID = cec59578-3630-f69a-58d2-eadbeef5d4e4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:cec59578-3630-f69a-58d2-eadbeef5d4e4
msgctxt "hb0dd068fgd228g4f8aga22cgeeb1850f1560"
msgid "Stand aside."
msgstr "비켜."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Wyll
#. NodeID = d0481d84-36d8-1edd-b46a-7b9c2932ef9a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_WYLL(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:d0481d84-36d8-1edd-b46a-7b9c2932ef9a
#, fuzzy
msgctxt "hc0d3109fg8688g444ag92c0g47d14399ae57"
msgid ""
"'Down in the pits'? Either Halsin's in a foul mood, or he awaits rescue. "
"Likely both."
msgstr "'구덩이 아래'? 할신은 지금 기분이 몹시 안 좋거나, 용맹한 구조를 기다리고 있겠군. 둘 다일 수도 있고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Player
#. NodeID = d1e3b134-f952-0b1b-e280-14e22b313999
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:d1e3b134-f952-0b1b-e280-14e22b313999
msgctxt "hfb7404f9g3b62g4f04g9affgefbdec2fbd01"
msgid "Fun indeed. Why don't you get in on it?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Gale
#. NodeID = d37f39c6-79e1-2acd-775f-31d8157e5c12
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(2) = True
#.   Tag:
#.      - REALLY_GALE(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:d37f39c6-79e1-2acd-775f-31d8157e5c12
msgctxt "hebdc9a26gf116g4645gb23agc33945906d6e"
msgid ""
"'Down in the pits', no less. Sounds ominous among creatures that love "
"bloodsports. Better step to it."
msgstr "역시 '구덩이 아래'인가. 피의 스포츠를 좋아하는 생물들과 같이 있기에는 불길한 장소 같군. 빨리 가보는 게 좋겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Player
#. NodeID = d915c7f8-47a7-9b50-08fd-67d48798e06c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - RANGER(1) = False
#.      - DRUID(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:d915c7f8-47a7-9b50-08fd-67d48798e06c
msgctxt "h61879105g53d8g4962g8d40g81ee5d1d2f82"
msgid ""
"Glossy coat on that animal. Does she belong to the <i>Nordiland worgata "
"</i>family?"
msgstr "저 동물의 털에서 광택이 나는군. <i>노르디랜드 워가타</i> 과에 속하나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = dc846a4f-c2d9-4397-360d-6327e2b016e5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_Knows_LeaderNameDrow = True
#.     - DEN_GroveConflict_Knows_LeaderNamePriest = True
#.     - DEN_GroveConflict_Quest_Learnt3LeadersNoName = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:dc846a4f-c2d9-4397-360d-6327e2b016e5
msgctxt "h6895d3ceg7748g4b26g9d30g110738703c41"
msgid ""
"I'm sure the higher-ups'll make sure you get the best of the spoils, your "
"excelness. The boss is in the temple inside. Minthara, too. A-and Priestess "
"Gut can show you how many new recruits we got!"
msgstr ""
"윗분들이 당신께 최상의 전리품들을 가질 수 있게 해주실 겁니다, 나으리. 두목님은 신전 안쪽에 있어요. 민타라도요. 그-그리고 거트 "
"여사제님은 우리가 얼마나 많은 신병들을 모집했는지 보여줄 거예요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = dddfa7f7-a4ae-3c88-64cb-eb1574bd1e5d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:dddfa7f7-a4ae-3c88-64cb-eb1574bd1e5d
msgctxt "h77ea1879g959dg4465g9a9ag0079ba6f33bc"
msgid ""
"Ripped the guts outta Waukeen's Rest, we did. Inns are good fer guttin'."
msgstr "와우킨의 쉼터의 내장을 뜯어냈지, 우리가. 여관은 내장을 뜯어내기 좋은 곳이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Player
#. NodeID = de302116-8ee0-de04-cac0-afde3914a813
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:de302116-8ee0-de04-cac0-afde3914a813
msgctxt "h6bccc63bg4ec6g49feg8633g4972471b77ba"
msgid "Unless you want seconds, we're done here."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Player
#. NodeID = e00fe89a-c54a-8bda-0db5-305d632b1ae0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Checkpoint_State_AskedAboutCamp(1) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_Checkpoint_State_AskedAboutCamp(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:e00fe89a-c54a-8bda-0db5-305d632b1ae0
msgctxt "h04ab0e0cga7c6g4e33gbfd3gdf723e720724"
msgid "That noise coming from behind you: good or bad?"
msgstr "너의 뒤에서 들리는 소리 말인데, 좋은 건가, 나쁜 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = e06f20eb-d6f8-ba8d-624c-7d8c0a9013bf
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_Checkpoint_OlakToldPaint(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:e06f20eb-d6f8-ba8d-624c-7d8c0a9013bf
msgctxt "h5934fd09g77f2g46a7g8201gffc53146cbed"
msgid "Celebratin' a raid, we are. You'll need to wear our war colours."
msgstr "습격을 축하하고 있었어, 우린. 넌 우리 전투 페인트를 칠해야 할 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Gale
#. NodeID = e088974b-0797-346f-f540-a3c8e4b26415
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - eaea790d-b9b8-b786-370a-5466a9185c91_GaleCommented = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:e088974b-0797-346f-f540-a3c8e4b26415
msgctxt "h605cb5b6g47deg4ec9g961ag10b900d91123"
msgid ""
"Let's try to be diplomatic, shall we? Goblins don't come by the handfuls, "
"but by the dozens."
msgstr "외교적으로 가볼까? 고블린은 한 줌이 아니라 수십 마리가 몰려오니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = e4815459-40ad-c0ce-d8f8-24211256e0a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:e4815459-40ad-c0ce-d8f8-24211256e0a6
msgctxt "hacc79514gdcb4g4de3g891agf0c27e58ac77"
msgid "<i>You?</i>"
msgstr "<i>너를?</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Player
#. NodeID = e6a6eeff-a1bc-3971-3f3f-9505365813bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:e6a6eeff-a1bc-3971-3f3f-9505365813bf
msgctxt "h9e52ac9eg7ee2g4e6cgb04agcdf2b358f8c8"
msgid "You can't be serious."
msgstr "설마 진심은 아니겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = eb35b0b1-f1f1-2346-b787-4aeb4e4db109
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:eb35b0b1-f1f1-2346-b787-4aeb4e4db109
msgctxt "hf3c2adb6g0656g436bga344gbef8c44e5712"
msgid "I... erm..."
msgstr "난... 음..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Player
#. NodeID = ec959fdf-bc12-a8fa-a378-6553f2fcac3a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_Checkpoint_State_AskedAboutHalsin(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:ec959fdf-bc12-a8fa-a378-6553f2fcac3a
msgctxt "hb3d2c4a9g4525g4799g987bg8309a114ae32"
msgid "Have you seen a druid named Halsin?"
msgstr "할신이라는 드루이드를 본 적이 있나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = ecb393db-1590-6c6a-94ff-b2476880d7e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:ecb393db-1590-6c6a-94ff-b2476880d7e6
msgctxt "h98f0c87cgb495g4462g9d93gb03918da4a3b"
msgid "Hey! Watch it, you daft <i>ranga</i>!"
msgstr "야! 조심해, 이 멍청한 <i>원숭이</i>!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = f01b2f08-b2eb-d53a-d946-b191066a48aa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:f01b2f08-b2eb-d53a-d946-b191066a48aa
msgctxt "h46917c13g4399g4dceg8ba2g6e1f3321cdc6"
msgid ""
"Nah, you're all hot air. Nice bit of war paint'll put you in your place."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = f2a32442-a729-0c8e-0472-5c3f7cce4397
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - GLO_Tadpole_SUB_Druid.LearnedPit(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:f2a32442-a729-0c8e-0472-5c3f7cce4397
msgctxt "heb77d20egf9c5g4cedgbe90g761401c1d151"
msgid "Hal-who? Dunno, might be he's the prisoner down in the pits."
msgstr "할-누구? 낸들 아나, 그 구덩이 아래에 있는 포로 중 하나겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Player
#. NodeID = f2b4283e-4950-19ee-aa83-6fadf5d667a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:f2b4283e-4950-19ee-aa83-6fadf5d667a3
msgctxt "hb1c533e0ge8e7g463aga60bg71f6e4abfa2f"
msgid "Hah! An excellent remedy for a boring afternoon."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Narrator
#. NodeID = f5760e07-5b53-f3ac-5f07-d75e6b56b3da
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - GLO_TadpoleIntro_NPC(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:f5760e07-5b53-f3ac-5f07-d75e6b56b3da
msgctxt "h1e917df2g1754g4f13g8c9bg9dea210aa3a2"
msgid "*As the symbol glows, power courses through you. <i>Authority</i>.*"
msgstr "*문양이 빛나며, 몸에 흐르는 힘이 느껴집니다. <i>권위</i>.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Player
#. NodeID = f674a4ac-46b8-f95e-969a-9cacdbdb7341
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Checkpoint_Guard001_Drow_WarColours(1) = False
#.   Object:
#.      - GOB_Checkpoint_OlakToldPaint(1) = True
#. SetFlags:
#.   Dialog:
#.     - GOB_Checkpoint_Guard001_Drow_WarColours(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:f674a4ac-46b8-f95e-969a-9cacdbdb7341
msgctxt "h4862dce5g13bdg46aagb789g53bf6ab1fbd6"
msgid "I hear wearing the local 'war colours' is the price of entry."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = f67e3694-17e4-4478-6b1c-eb57d82a6ccb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:f67e3694-17e4-4478-6b1c-eb57d82a6ccb
msgctxt "h60d7deb2gc2f1g4fefgb197g70e328c42211"
msgid "Where you goin'? Camp's that way, idiot."
msgstr "어디 가냐? 야영지는 저쪽이야, 멍청아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = f693b1a5-4f90-c6ec-cd0c-7ff38562739a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:f693b1a5-4f90-c6ec-cd0c-7ff38562739a
msgctxt "h10b78d19g8db5g4d0eg9393g9c93ac666cb6"
msgid "Blech! Hope that was worth it, <i>deadie</i>."
