msgctxt "h653887c9g613cg47b3gab87gd58099c990fe"
msgid "An outsider. Just what we needed."
msgstr "외부인이라. 딱 필요하던 거구만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarLoyalFocused
