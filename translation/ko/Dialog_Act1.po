msgctxt "h8bdacf2cgc93eg4aa0gb3d9g51136cf4954a"
msgid "If I knew praying could be useful, I would've started years ago."
msgstr "기도가 이렇게 쓸모 있는 줄 알았으면 진작부터 할 걸 그랬네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_OpenStashWithPrayer
#. Speaker = Player
#. NodeID = 76bdea89-6b50-092b-9691-add2810f80cc
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Object:
#.      - FOR_SeluneStash_State_SuccessfullyReadPrayer(0) = True
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_OpenStashWithPrayer:76bdea89-6b50-092b-9691-add2810f80cc
msgctxt "h23611ff1g0506g4e30ga550gae4acdf6f149"
msgid "And there we go. Never knew prayer could be so practical."
msgstr "열렸군. 기도가 이렇게 쓸모 있을 줄은 몰랐어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_OpenStashWithPrayer
#. Speaker = Player
#. NodeID = 76bdea89-6b50-092b-9691-add2810f80cc
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Object:
#.      - FOR_SeluneStash_State_SuccessfullyReadPrayer(0) = True
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_OpenStashWithPrayer:76bdea89-6b50-092b-9691-add2810f80cc
msgctxt "h947aa96fgd5e8g4be9g9941g3b324d15b88a"
msgid "Prayer works? I might have to rethink a few things."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_OpenStashWithPrayer
#. Speaker = Player
#. NodeID = 76bdea89-6b50-092b-9691-add2810f80cc
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Object:
#.      - FOR_SeluneStash_State_SuccessfullyReadPrayer(0) = True
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_OpenStashWithPrayer:76bdea89-6b50-092b-9691-add2810f80cc
msgctxt "hd3a253c9g673dg474eg9facg13820aba070b"
msgid "The chest's unlocked. Simple magic."
msgstr "궤짝이 열렸어. 간단한 마법이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_OpenStashWithPrayer
#. Speaker = Player
#. NodeID = 76bdea89-6b50-092b-9691-add2810f80cc
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Object:
#.      - FOR_SeluneStash_State_SuccessfullyReadPrayer(0) = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_OpenStashWithPrayer:76bdea89-6b50-092b-9691-add2810f80cc
msgctxt "hcdd4e5dcgc92bg4c6bga853gc421c3d76008"
msgid "That's it? A few pious words and the magic's dispelled?"
msgstr "이게 끝인가? 말 몇 마디 내뱉었다고 마법이 풀려?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_OpenStashWithPrayer
#. Speaker = Player
#. NodeID = 76bdea89-6b50-092b-9691-add2810f80cc
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Object:
#.      - FOR_SeluneStash_State_SuccessfullyReadPrayer(0) = True
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_OpenStashWithPrayer:76bdea89-6b50-092b-9691-add2810f80cc
msgctxt "h0f366f0ag745dg4ff4g8958g6a3b0d44c8d4"
msgid "Nice. Time to see what's inside."
msgstr "좋아. 안에 뭐가 들었는지 볼까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_OpenStashWithPrayer
#. Speaker = Player
#. NodeID = 76bdea89-6b50-092b-9691-add2810f80cc
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Object:
#.      - FOR_SeluneStash_State_SuccessfullyReadPrayer(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_OpenStashWithPrayer:76bdea89-6b50-092b-9691-add2810f80cc
msgctxt "hbaae955fg8356g4eb8g803dg19d0e59b728e"
msgid "Chest's unlocked. My prayers are answered."
msgstr "궤짝이 열렸어. 내 기도에 응답했군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_OpenStashWithPrayer
