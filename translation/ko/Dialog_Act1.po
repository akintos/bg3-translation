msgctxt "h4946bd5ag31b0g4c9cga7e1g5e4ef0f220f5"
msgid "ARGH. You knuckle-dragging gobshite."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_PAD_Fled
#. Speaker = Player
#. NodeID = 4a216a17-743c-7b91-3009-705fb384d184
