msgid "Oh look how she struggles! Don't do yourself a mischief, now."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter
#. Speaker = True Soul Gut
#. NodeID = bd8b7414-e7e8-5d41-875f-91806d945f1d
