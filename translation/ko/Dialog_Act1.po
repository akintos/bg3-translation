msgctxt "he35a4558g3ca9g47b7ga352g6fb357d6b6fc"
msgid "<i>Chk. </i>Stuck."
msgstr "<i>츠크.</i> 단단히 막혀 있군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_StatuePuzzle_PAD_AthleticsCheckFailed
