#.     - FOR_DangerousBook_Found = True
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_PAD_FindBook:2bb9b79a-0788-6e0b-1e4d-8bf8e28c10b2
msgctxt "h0d827fccg50a7g4d21g893cg42ce80b3f58e"
msgid ""
"A Thayan book about necromancy. Not for the faint of heart. All the more for "
"the decayed of heart."
msgstr "강령술에 대한 테이의 책이네. 심약한 사람보단, 타락한 사람에게 어울리는 책이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_PAD_FindBook
#. Speaker = Player
#. NodeID = 2bb9b79a-0788-6e0b-1e4d-8bf8e28c10b2
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_NeedsMagicItems = False
#. SetFlags:
#.   Global:
#.     - FOR_DangerousBook_Found = True
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_PAD_FindBook:2bb9b79a-0788-6e0b-1e4d-8bf8e28c10b2
msgctxt "hbfcb5e64g8e21g4f9eg88fcg4722c4505441"
msgid "Hm. Funny book. I don't like it."
msgstr "흠. 웃기는 책이군. 마음에 안 들어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_PAD_FindBook
#. Speaker = Player
#. NodeID = 2bb9b79a-0788-6e0b-1e4d-8bf8e28c10b2
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_NeedsMagicItems = False
#. SetFlags:
#.   Global:
#.     - FOR_DangerousBook_Found = True
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_PAD_FindBook:2bb9b79a-0788-6e0b-1e4d-8bf8e28c10b2
msgctxt "h8918cc07g1a2dg4572gaec1g94e6d089c192"
msgid "A book of death magic. Let's see what spirits lurk within."
msgstr "죽음의 마법에 대한 책이네. 어떤 영혼이 들어가 있는지 보자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_PAD_FindBook
#. Speaker = Player
#. NodeID = 2bb9b79a-0788-6e0b-1e4d-8bf8e28c10b2
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_NeedsMagicItems = False
#. SetFlags:
#.   Global:
#.     - FOR_DangerousBook_Found = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_PAD_FindBook:2bb9b79a-0788-6e0b-1e4d-8bf8e28c10b2
msgctxt "he90986d7g87a9g4486ga6c4gc8d64904dda9"
msgid "'The Necromancy of Thay'? Not a children's book, I assume."
msgstr "'테이의 강령술 책'? 애들이 읽을만한 책은 아니겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_PAD_FindBook
#. Speaker = Player
#. NodeID = 2bb9b79a-0788-6e0b-1e4d-8bf8e28c10b2
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_NeedsMagicItems = False
#. SetFlags:
#.   Global:
#.     - FOR_DangerousBook_Found = True
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_PAD_FindBook:2bb9b79a-0788-6e0b-1e4d-8bf8e28c10b2
msgctxt "h8b192fb1g7afag43cfg9f61g1a9ae5e772fb"
msgid "A tome of necromancy? Best keep that thing <i>shut.</i>"
msgstr "강령술 책? <i>덮어두는 게</i> 최선이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_PAD_FindBook
#. Speaker = Player
#. NodeID = 2bb9b79a-0788-6e0b-1e4d-8bf8e28c10b2
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_NeedsMagicItems = False
#. SetFlags:
#.   Global:
#.     - FOR_DangerousBook_Found = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_PAD_FindBook:2bb9b79a-0788-6e0b-1e4d-8bf8e28c10b2
msgctxt "he5089bd2g7790g4eb5g8f42ge9ec297352d0"
msgid "'The Necromancy of Thay'? Sounds ominous."
msgstr "'테이의 강령술'? 불길해 보이는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_PAD_FindBook
#. Speaker = Player
#. NodeID = 4ae5341a-95aa-38cd-437e-29fdb5db26a2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_NeedsMagicItems = True
#. SetFlags:
#.   Global:
#.     - FOR_DangerousBook_Found = True
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_PAD_FindBook:4ae5341a-95aa-38cd-437e-29fdb5db26a2
msgctxt "he92358d4ga9b7g4a89gac69gd9076cd3c0c0"
msgid "A book of necromancy? Gale would love to get his hands on this."
msgstr "강령술 책이네? 게일이 꼭 갖고 싶어 하겠는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_PAD_FindBook
#. Speaker = Player
#. NodeID = 4ae5341a-95aa-38cd-437e-29fdb5db26a2
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_NeedsMagicItems = True
#. SetFlags:
#.   Global:
#.     - FOR_DangerousBook_Found = True
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_PAD_FindBook:4ae5341a-95aa-38cd-437e-29fdb5db26a2
msgctxt "h3bdaf17ag9421g4039g8220ge7f920addd7f"
msgid ""
"A Thayan book about necromancy. Not for the faint of heart. All the more for "
"the decayed of heart. Much magic to be absorbed indeed."
msgstr "강령술에 대한 테이의 책이라니. 심약한 사람보단, 타락한 사람에게 어울리는 책이야. 분명 흡수할 마법도 많겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_PAD_FindBook
#. Speaker = Player
#. NodeID = 4ae5341a-95aa-38cd-437e-29fdb5db26a2
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_NeedsMagicItems = True
#. SetFlags:
#.   Global:
#.     - FOR_DangerousBook_Found = True
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_PAD_FindBook:4ae5341a-95aa-38cd-437e-29fdb5db26a2
msgctxt "h976ddf50g67c3g4b05ga517g9e8bb4058628"
msgid "Hm. Seems like Gale's kind of kindling."
msgstr "흠. 게일 같은 부류가 흥미로워 할 것 같네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_PAD_FindBook
#. Speaker = Player
#. NodeID = 4ae5341a-95aa-38cd-437e-29fdb5db26a2
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_NeedsMagicItems = True
#. SetFlags:
#.   Global:
#.     - FOR_DangerousBook_Found = True
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_PAD_FindBook:4ae5341a-95aa-38cd-437e-29fdb5db26a2
msgctxt "hbe53f87bg8705g48e8ga18fg304069aa617d"
msgid "A book of death magic. Gale might put it to good use."
msgstr "죽음의 마법에 관한 책. 아마 게일에게 유용하게 쓸 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_PAD_FindBook
#. Speaker = Player
#. NodeID = 4ae5341a-95aa-38cd-437e-29fdb5db26a2
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_NeedsMagicItems = True
#. SetFlags:
#.   Global:
#.     - FOR_DangerousBook_Found = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_PAD_FindBook:4ae5341a-95aa-38cd-437e-29fdb5db26a2
msgctxt "h119f5c51ga397g44bdgaf65gdebcc7d1d5d4"
msgid ""
"'The Necromancy of Thay'? Not a children's book, I assume. Gale may want it "
"though."
msgstr "'테이의 강령술'? 애들 읽을 거린 안 되겠네. 게일이 분명 원할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_PAD_FindBook
#. Speaker = Player
#. NodeID = 4ae5341a-95aa-38cd-437e-29fdb5db26a2
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_NeedsMagicItems = True
#. SetFlags:
#.   Global:
#.     - FOR_DangerousBook_Found = True
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_PAD_FindBook:4ae5341a-95aa-38cd-437e-29fdb5db26a2
msgctxt "h3138757cgfa12g40b1gb50cg76a84c17ddd6"
msgid "'The Necromancy of Thay'? I bet Gale could use this."
msgstr "'테이의 강령술'? 게일에게 쓸만하겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_PAD_FindBook
#. Speaker = Player
#. NodeID = 4ae5341a-95aa-38cd-437e-29fdb5db26a2
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_NeedsMagicItems = True
#. SetFlags:
#.   Global:
#.     - FOR_DangerousBook_Found = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_PAD_FindBook:4ae5341a-95aa-38cd-437e-29fdb5db26a2
msgctxt "h2e9f67a3gc8b9g4376gb68ag88047170efea"
msgid "'The Necromancy of Thay'? Ominous, but Gale might find it useful."
msgstr "'테이의 강령술' ? 불길하지만, 게일에겐 유용할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_PAD_PlayerTriedToTakeTome
#. Speaker = Player
#. NodeID = d4ce8cc4-dc94-40bc-9630-a553fb0d9c52
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_PAD_PlayerTriedToTakeTome:d4ce8cc4-dc94-40bc-9630-a553fb0d9c52
msgctxt "h972d244fg10e8g4a33g8f78gb10c94c1804a"
msgid "Oh no, that book is <i>mine</i>."
msgstr "오 이런, 저 책은 <i>내 꺼</i>야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_PAD_PlayerTriedToTakeTome
#. Speaker = Player
#. NodeID = d4ce8cc4-dc94-40bc-9630-a553fb0d9c52
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_PAD_PlayerTriedToTakeTome:d4ce8cc4-dc94-40bc-9630-a553fb0d9c52
msgctxt "h3c5a88f5gec0fg4890gb40fg7baf3c03fb91"
msgid "Sorry, but that book is spoken for - by me."
msgstr "미안하지만, 그 책은 이미 - 내가 예약했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Astarion
#. NodeID = 005c7962-efb0-64cf-2d1a-516979c42147
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:005c7962-efb0-64cf-2d1a-516979c42147
msgctxt "h37e00570gb7fbg4a07ga993g35e8becaa02d"
msgid ""
"Well. Quite the page turner. I'll get back to it when I have more time to "
"focus."
msgstr "아주 흥미로운 책이네. 다음에 집중할 시간이 생기면 다시 읽어봐야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = 071e5fb1-da1e-143f-db1d-705ae2bf406c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:071e5fb1-da1e-143f-db1d-705ae2bf406c
msgctxt "h292f49e9g06d5g4b6eg9befg8e6546e92cb4"
msgid ""
"*But your will is iron and you brush past these shades of the past, "
"devouring every secret the book has to offer.*"
msgstr "*하지만 당신은 강철과 같은 의지로 이 과거의 그늘을 지나쳐 책이 제공하는 모든 비밀을 흡수합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = 07c0ed2f-2ead-de63-410c-3724da3e499d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:07c0ed2f-2ead-de63-410c-3724da3e499d
msgctxt "h39e4cf59gb124g4737ga633g5968767c805c"
msgid ""
"*You try to examine the book, but the longer you stare, the more those "
"piercing, amethyst eyes draw you in.*"
msgstr "*책을 살펴보려고 하지만 오래 응시할수록 그 날카로운 자수정 같은 눈빛에 더 빠져들게 됩니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Astarion
#. NodeID = 09c3c39d-0e7d-14b5-6195-675a3d70a2aa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_DangerousBook_AstarionWants = False
#. SetFlags:
#.   Global:
#.     - FOR_DangerousBook_AstarionWants = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:09c3c39d-0e7d-14b5-6195-675a3d70a2aa
msgctxt "h2b3d98f8g87c6g4b6cga6d4ge85d4e0d5d6b"
msgid "That looks terribly heavy. Why don't you let me carry it for you?"
msgstr "그 책 정말 무거워 보이는데. 내가 대신 들어줘도 될까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = 09ceea0e-ac69-1b17-55c0-b65b2e62bd51
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_DangerousBook_State_BookFinished = False
#.      - FOR_DangerousBook_State_Bound = True
#.   Object:
#.      - FOR_DangerousBook_State_BookOwner(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:09ceea0e-ac69-1b17-55c0-b65b2e62bd51
msgctxt "h7c4c1e7fg71b2g44a4g8ef1ge1978f7401ce"
msgid ""
"*You feel its connection. Its longing to be opened - to share its secrets.*"
msgstr "*열리고자 하는 책의 갈망이, 비밀을 공유하고자 하는 열망이 느껴집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Player
#. NodeID = 0b01fba5-7a19-c4e7-87c9-0d18cb7d03e1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FOR_DangerousBook_Event_DroppedBook(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:0b01fba5-7a19-c4e7-87c9-0d18cb7d03e1
msgctxt "h8f5b1167g0207g41eegbb5dgedae1c9adf8f"
msgid "<i>Drop the tome, ready to destroy it.</i>"
msgstr "<i>고서를 떨어뜨리고, 파괴할 준비를 한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Player
#. NodeID = 0e61bd29-1d13-ce80-59b8-302d9c1f8e2a
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SavingThrow
#. RollAbility: Wisdom
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:0e61bd29-1d13-ce80-59b8-302d9c1f8e2a
msgctxt "hf6f99d07g33c9g4cd6g95bdg1e02d6a40ff0"
msgid "<i>Turn another page.</i>"
msgstr "<i>다른 페이지로 넘어간다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Player
#. NodeID = 1058ca72-052f-c5a9-b2a5-c77409205f0b
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:1058ca72-052f-c5a9-b2a5-c77409205f0b
msgctxt "hcd70eaccg31b5g4edcg8165g2d73d26d942e"
msgid "<i>Face the darkness with your own, delve deeper.</i>"
msgstr "<i>내면의 어둠을 마주하고 더 깊이 파고든다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Player
#. NodeID = 137c80ad-2568-8aa5-feea-d4b94651e812
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SavingThrow
#. RollAbility: Wisdom
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:137c80ad-2568-8aa5-feea-d4b94651e812
msgctxt "h0c39a263gc992g4d06ga689g4cf69534c4a0"
msgid "<i>Force the book closed.</i>"
msgstr "<i>강제로 책을 닫는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Player
#. NodeID = 16866137-3f1d-70de-9dcd-0186f1f98451
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:16866137-3f1d-70de-9dcd-0186f1f98451
msgctxt "h350a4586ga6eeg4e6ag826fgd35c3826d83d"
msgid "<i>Slam the book shut.</i>"
msgstr "<i>책을 세차게 닫는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = 19f9830e-303f-a443-cbf3-ea4a7161b882
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - LOW_SorcerousSundries_State_LastPageThayRead = True
#.     - LOW_SorcerousSundries_CursedTome_State_NecromancyActive = True
#.   Object:
#.     - LOW_SorcerousSundries_Event_CursedTomeEffect_Necromancy(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:19f9830e-303f-a443-cbf3-ea4a7161b882
msgctxt "h6d4486d3gdc4ag47e5ga2fbg54b2369de00f"
msgid ""
"*You see now, life and death are malleable as clay, to be bent and reshaped "
"by your will. By your power.*"
msgstr ""
"*당신은 삶과 죽음이 마치 점토처럼 다듬을 수 있다는 사실을 깨닫습니다. 삶과 죽음은 의지에 따라 구부러지고 재생될 수 있습니다. 바로 "
"당신의 힘으로 말입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Wyll
#. NodeID = 205e9453-8966-b526-0498-5a08ac130e9e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_DangerousBook_State_WyllOpinion(1) = False
#. SetFlags:
#.   Dialog:
#.     - FOR_DangerousBook_State_WyllOpinion(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:205e9453-8966-b526-0498-5a08ac130e9e
msgctxt "h72198362gf2d6g4844gada6g51a29a42f8a5"
msgid ""
"We surely shouldn't just leave such a threat out, where anyone could stumble "
"across it."
msgstr "이런 위험한 물건을 그냥 밖에 버려둘 순 없잖아. 누가 와서 집을지 어떻게 알고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = 208308f2-964b-623b-ba08-b70ee70a1821
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:208308f2-964b-623b-ba08-b70ee70a1821
msgctxt "ha30c9d26g91e8g44dbg80a0g7398387f8e8c"
msgid "*You feel better the second the book is out of your hands.*"
msgstr "*책이 손을 떠나자마자 기분이 한결 편해집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Astarion
#. NodeID = 217a48c7-370a-aeb7-9b0e-4e5ba65373ab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:217a48c7-370a-aeb7-9b0e-4e5ba65373ab
msgctxt "h7458a12bged47g4c97gb8f1g310a4b4c1412"
msgid "Excellent."
msgstr "훌륭해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = 2328d232-ac7c-93d7-c26c-5ea36427ad47
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:2328d232-ac7c-93d7-c26c-5ea36427ad47
msgctxt "hfb1756c9g99eag4caeg876aga945e91848eb"
msgid ""
"*Within the pages, you feel a feral thrashing. Living magic, driven mad by "
"what it was used for...*"
msgstr "*책장을 넘기니, 사나운 전율이 느껴집니다. 살아있는 마법, 사용 목적에 빠진 광기...*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = 284a62b9-32d2-58cc-39f5-9078917a2218
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_DangerousBook_State_BookFinished = True
#.      - FOR_DangerousBook_State_Bound = True
#.      - LOW_SorcerousSundries_CursedTome_State_NecromancyActive = False
#.   Object:
#.      - FOR_DangerousBook_State_BookOwner(1) = True
#.      - LOW_SorcerousSundries_Event_CypherRead(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:284a62b9-32d2-58cc-39f5-9078917a2218
msgctxt "hec48fab8g668bg439eg8f0ag0861bda78ada"
msgid ""
"*The book radiates power, but the words you read in the Codex echo in your "
"mind, guiding your eyes safely across the page.*"
msgstr "*책은 힘을 발산하지만, 코덱스에서 읽는 글귀는 마음속에서 울려 퍼지며 페이지를 따라 눈을 안전하게 안내합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Player
#. NodeID = 2b52faa7-6ab4-9c1c-a9aa-ad065fcaa8aa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_DangerousBook_State_BookUnlocked = False
#.   Object:
#.      - FOR_DangerousBook_State_HasTomeKey(1) = True
#. SetFlags:
#.   Global:
#.     - FOR_DangerousBook_State_BookUnlocked = True
#.   Object:
#.     - FOR_DangerousBook_Event_RemoveTomeKey(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:2b52faa7-6ab4-9c1c-a9aa-ad065fcaa8aa
msgctxt "h7a38ae85gfc76g448ag8337ge491cad8561e"
msgid "<i>Place the amethyst in the slot on the book's cover.</i>"
msgstr "<i>책 표지의 홈에 자수정을 삽입한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Player
#. NodeID = 2ddd7eed-5226-4821-89bc-e97e1b0f218a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - FOR_DangerousBook_State_HasTome(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:2ddd7eed-5226-4821-89bc-e97e1b0f218a
msgctxt "h98805a93gb910g4321g884dg7c5989589457"
msgid "<i>Leave the book be.</i>"
msgstr "<i>책을 내버려 둔다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = 2e0ccac6-aeec-0ae2-44f5-13b751d2d507
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_DangerousBook_State_Bound = False
#.      - FOR_DangerousBook_State_BookUnlocked = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:2e0ccac6-aeec-0ae2-44f5-13b751d2d507
msgctxt "hcb7b5048gc6c1g4952g8bc2g4b7421a461a7"
msgid ""
"*As you look into the book's amethyst eyes, you can almost hear a voice. You "
"just have to open the book, and it will be yours. Forever.*"
msgstr "*책의 자수정 같은 눈동자를 들여다보면 목소리가 들리는 듯합니다. 책을 펼치기만 하면 당신의 것이 될 것입니다. 영원히.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = 315204d3-0c6c-534b-88f1-57b882d0e193
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:315204d3-0c6c-534b-88f1-57b882d0e193
msgctxt "h9c5740c3g33cfg41c4ga0ceg171a8e0c7260"
msgid ""
"*Black strands of Weave curl all about you, only to sink as into graves as "
"you try to grab hold. Necromantic spells - tantalisingly powerful - slip "
"away forever.*"
msgstr ""
"*검은 위브 가닥이 주위를 휘감아 돌다가 붙잡으려는 순간 무덤 속으로 가라앉습니다. 황홀할 정도로 강력한 강령술 주문이 영원히 "
"사라집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = 315204d3-0c6c-534b-88f1-57b882d0e193
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: CLERIC or DRUID or WIZARD
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:315204d3-0c6c-534b-88f1-57b882d0e193
msgctxt "he75bdaecga151g4292g8f59g61b6b7ba55e6"
msgid ""
"*You struggle to cling to scraps of what you know - powerful necromancy, "
"you're sure - but it darts away, leaving only Hells' screams.*"
msgstr "*강력한 강령술이라는 확신에 지식을 붙잡아 보려 노력하지만, 지옥의 비명만을 남긴 채 사라집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Player
#. NodeID = 39c8fa2a-0d04-940c-1362-ffebd17c4eb1
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SavingThrow
#. RollAbility: Intelligence
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - WIZARD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:39c8fa2a-0d04-940c-1362-ffebd17c4eb1
msgctxt "h8bb69edfg22e6g4403ga62dgce35cbbe4947"
msgid "<i>Turn to the next page, wary of any arcane tricks.</i>"
msgstr "<i>비전 함정이 있지는 않은지 경계하며, 페이지를 넘긴다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Player
#. NodeID = 3bc03f60-75f0-b79a-b007-9821f83a30f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:3bc03f60-75f0-b79a-b007-9821f83a30f1
msgctxt "h68b6f998g7279g4fddga663g279a039fac83"
msgid "<i>Turn the page.</i>"
msgstr "<i>페이지를 넘긴다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Player
#. NodeID = 3cef9373-a335-1dd9-ed64-524eea403d0c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:3cef9373-a335-1dd9-ed64-524eea403d0c
msgctxt "h0d2c6126geddbg4c0eg8d5bgba13a32dbc86"
msgid "<i>Close the book.</i>"
msgstr "<i>책을 덮는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = 3f8d4c3a-1cda-3726-ca0a-cafb03420b5c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:3f8d4c3a-1cda-3726-ca0a-cafb03420b5c
msgctxt "ha12b4673gef22g4869g9c6age46c8bee3135"
msgid ""
"*Your limerick's final line pierces something within the book's roiling, "
"vengeful magic.*"
msgstr "*당신이 부른 오행시의 마지막 줄이 책 속 무언가를 꿰뚫어 복수심에 불타는 마법이 요동칩니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Player
#. NodeID = 402329ef-ea87-c156-6587-9f6c472bdd54
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(1) = True
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:402329ef-ea87-c156-6587-9f6c472bdd54
msgctxt "ha39b5ebdg3113g4e02ga2c4g5ef2ad356124"
msgid "<i>Drink in the darkness, embracing it, and turn the page.</i>"
msgstr "<i>어둠을 마시고, 어둠을 끌어안으며, 페이지를 넘긴다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Gale
#. NodeID = 40ebdd2d-a494-8f8c-2290-179d93cc8d12
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_DangerousBook_GaleWants = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:40ebdd2d-a494-8f8c-2290-179d93cc8d12
msgctxt "h53afa523g4444g4165gb09egd6a535144169"
msgid "What are you doing? That's no way to treat a book!"
msgstr "뭐 하는 거야? 책을 그런 식으로 대하다니!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = 413db36b-584d-d3c3-6d3c-efc6b1570da2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:413db36b-584d-d3c3-6d3c-efc6b1570da2
msgctxt "h2bdf3678gf8a9g4cb8g8c0eg0cb7497631d8"
msgid ""
"*The whispers, the pain - it all disappears in an instant. You are yourself "
"again.*"
msgstr "*속삭임도, 고통도, 모든 것이 순식간에 사라집니다. 당신은 원래대로 되돌아옵니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = 4151a0fb-2145-799e-85f4-1fb2d0241242
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:4151a0fb-2145-799e-85f4-1fb2d0241242
msgctxt "ha090c254gac5cg4ccfg8b7cgd0c74541ca82"
msgid "*...but they have no hold on you. All you have to do is strike.*"
msgstr "*...하지만 그걸로는 당신을 막을 수 없습니다. 일격이면 충분합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = 4310f3af-f4d3-4af0-ee4a-38a94585d991
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_DangerousBook_State_BookFinished = True
#.   Object:
#.     - FOR_DangerousBook_State_SuccessfullyRead(1) = True
#.     - FOR_DangerousBook_Event_GrantForbiddenKnowledge(1) = True
#.   Quest:
#.     - FOR_DangerousBook_SUB_UseTome.InvestigateMissingKnowledge(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:4310f3af-f4d3-4af0-ee4a-38a94585d991
msgctxt "h9b474153gcfe8g4ae3g880eg657ee7f40398"
msgid ""
"*The book snaps closed. You've seen too much. What profane knowledge is now "
"seared inside of you, you should never have known.*"
msgstr "*책이 쾅 하고 닫힙니다. 너무 많은 것을 봤습니다. 절대 알지 말았어야 할 불경한 지식이 당신의 머릿속에 새겨졌습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = 482463ba-b5d6-eec0-4f9f-f2b8bc2e6e1b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FOR_DangerousBook_Event_FailedWisdomSave(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:482463ba-b5d6-eec0-4f9f-f2b8bc2e6e1b
msgctxt "hc6a151afg6c85g4940g87e7g47e0f53673c0"
msgid ""
"*The magic inside the book is too strong. The voices grow louder - a "
"cacophony.*"
msgstr "*책 속에 있는 마법이 너무나 강력합니다. 목소리가 점점 커집니다. 불협화음이 들려옵니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Karlach
#. NodeID = 4e0fe072-3552-6fc5-62d2-32475336ec1c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_DangerousBook_State_KarlachOpinion(1) = False
#. SetFlags:
#.   Dialog:
#.     - FOR_DangerousBook_State_KarlachOpinion(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:4e0fe072-3552-6fc5-62d2-32475336ec1c
msgctxt "h821b5e54g8973g4698g9a4cg5e91e11fbe3d"
msgid "Please don't open the creepy book."
msgstr "그 오싹한 책은 열지 말아줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Player
#. NodeID = 54726551-0b5f-e27d-c7e3-0d1220de15c4
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SavingThrow
#. RollAbility: Wisdom
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:54726551-0b5f-e27d-c7e3-0d1220de15c4
msgctxt "ha69b3332g77c2g4411gac7fg576d164bfb1e"
msgid "<i>Turn to the next page.</i>"
msgstr "<i>다음 장을 넘긴다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Player
#. NodeID = 5753c513-260a-05af-7e18-de476342c9da
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - FOR_DangerousBook_State_HasTome(1) = False
#. SetFlags:
#.   Object:
#.     - FOR_DangerousBook_Event_TakeBook(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:5753c513-260a-05af-7e18-de476342c9da
msgctxt "h69a61c7fgb418g4880g9c4fge79edebef84a"
msgid "<i>Tuck the book into your pack.</i>"
msgstr "<i>책을 가방 속에 챙긴다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Player
#. NodeID = 5e1d2cfd-dbb2-73f1-df14-320bf4c0cff3
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SavingThrow
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - WARLOCK(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:5e1d2cfd-dbb2-73f1-df14-320bf4c0cff3
msgctxt "h39277e7bg6badg4fedgba79g759792ad8b2f"
msgid "<i>Ask your patron to guard your mind and turn to the next page.</i>"
msgstr "<i>당신의 후원자에게 정신을 보호해달라고 요청한 뒤 다음 페이지로 넘어간다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Player
#. NodeID = 5f3978bd-6519-f08d-e26c-b08fb2f463b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:5f3978bd-6519-f08d-e26c-b08fb2f463b4
msgctxt "hd7194e82g7ef3g41degb54eg283752d46391"
msgid "<i>Close the book.</i>"
msgstr "<i>책을 닫는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Player
#. NodeID = 5f853e78-0576-b4bb-3e88-0fc3db6a547a
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - SORCERER(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:5f853e78-0576-b4bb-3e88-0fc3db6a547a
msgctxt "had747104gfc6ag4aefg8b0cg64001cdf91d1"
msgid ""
"<i>Concentrate your energy on the book. Channel a sense of calm onto its "
"pages.</i>"
msgstr "<i>에너지를 책에 집중한다. 페이지들을 차분하게 진정시킨다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Player
#. NodeID = 6140a959-9b3a-b343-2584-feca09f193d7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_DangerousBook_State_BookUnlocked = True
#. SetFlags:
#.   Global:
#.     - FOR_DangerousBook_State_Bound = True
#.   Object:
#.     - FOR_DangerousBook_State_BookOwner(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:6140a959-9b3a-b343-2584-feca09f193d7
msgctxt "h35d5dd14g7e67g43d7ga4e1g77eef11f044a"
msgid "<i>Open the book.</i>"
msgstr "<i>책을 열어본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Player
#. NodeID = 62e4e0a2-2ee9-8153-9d55-5fc00abde461
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SavingThrow
#. RollAbility: Wisdom
#. DifficultyClass: 20
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:62e4e0a2-2ee9-8153-9d55-5fc00abde461
msgctxt "h11642c1fgb008g4168g9dceg0d01dcb45f47"
msgid "<i>Read on and wrest the book's power from it.</i>"
msgstr "<i>책의 나머지 부분을 읽고 그 힘을 캐낸다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = 6467060c-8ad0-cd8b-53b8-d0f59041734e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_DangerousBook_State_Bound = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:6467060c-8ad0-cd8b-53b8-d0f59041734e
msgctxt "h695998c6g95f4g4356g89a8gae3087bcee73"
msgid ""
"*You don't know what he read, but it had an effect. His eyes are hungry, but "
"pained.*"
msgstr "*그가 읽는 게 무엇인지는 모르지만, 영향은 있습니다. 그의 눈빛은 굶주린 눈빛이 되지만, 동시에 고통스러운 눈빛입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = 65650c37-4524-0f34-840d-d60786cc124a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_DangerousBook_State_FirstPageRead = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:65650c37-4524-0f34-840d-d60786cc124a
msgctxt "h66748cb5g74a7g447ag9a18ge53f5fb2604e"
msgid ""
"*The symbols move aggressively, probing your mental defences. Your patron is "
"there to defend you, but there's only so much they can do.*"
msgstr ""
"*기호들이 공격적으로 움직이며 당신의 정신적 방어력을 시험합니다. 후원자가 보호해 주고 있지만, 그들이 할 수 있는 것에도 한계가 "
"있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = 67091504-1765-5eca-d9a1-3152da078986
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:67091504-1765-5eca-d9a1-3152da078986
msgctxt "h79e7dbd9ge1a2g4ffag9b4fg59fd5a609de6"
msgid ""
"*As you parse the strange glyphs, you can feel the book resisting. Ghostly "
"voices whisper at you from the dark - probing and fighting your mind.*"
msgstr ""
"*이상한 문자를 해독하다 보니, 책이 저항하는 것이 느껴집니다. 어둠 속에서 유령 같은 목소리가 속삭이며 당신의 정신을 탐색하며 공격하고 "
"있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = 69025dce-6ab3-6730-bc6d-b0d73a1a7ea8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FOR_DangerousBook_Event_FailedWisdomSave(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:69025dce-6ab3-6730-bc6d-b0d73a1a7ea8
msgctxt "hf7660582g0a2eg4bcagab8dg0a1d407fa68d"
msgid ""
"*You try to close the book, but claws tear at you from the darkness. You can "
"feel them on your body - in your soul, scratching and tearing at your "
"sanity.*"
msgstr ""
"*책을 닫으려 노력하지만, 어둠 속에서 발톱이 나타나 당신을 할큅니다. 그것들이 당신의 몸과 영혼을 할퀴고 정신을 찢어버리는 것이 "
"느껴집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = 6a0ff00b-299d-43a6-94ac-f0ec65cf5a64
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:6a0ff00b-299d-43a6-94ac-f0ec65cf5a64
msgctxt "h0a4504c7gbbfbg4fb0ga27dge1360394fd89"
msgid ""
"*The glyphs scream, branding your mind with strange runes. You see time "
"rewritten - fate undone - your future thrumming with power.*"
msgstr ""
"*문자가 비명을 지르며 기묘한 룬으로 당신의 정신에 낙인을 찍습니다. 시간이 다시 쓰이는 것이 보입니다. 운명이 되돌려지고, 당신의 "
"미래가 힘으로 가득 차 윙윙거립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = 6bbe4531-af85-643d-10e7-ad0ef86a594c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - LOW_SorcerousSundries_CursedTome_State_NecromancyActive = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:6bbe4531-af85-643d-10e7-ad0ef86a594c
msgctxt "hb58a5587g6008g4fcegbcfeg6403e71b2a80"
msgid ""
"*Necromantic power flows from the pages of the book. There is nothing more "
"for you here.*"
msgstr "*책에서 사령술의 힘이 흘러나옵니다. 그 외에는 별다른 게 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Player
#. NodeID = 6cc1a243-8f67-128f-f627-8e69f3f5278f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:6cc1a243-8f67-128f-f627-8e69f3f5278f
msgctxt "he6d9e72cg98ffg41c9g9396g6fde0ecfb154"
msgid "<i>Close the book.</i>"
msgstr "<i>책을 닫는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Player
#. NodeID = 6d556b54-87df-8dc4-f433-fa391e9d609c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - FOR_DangerousBook_State_HasTome(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:6d556b54-87df-8dc4-f433-fa391e9d609c
msgctxt "hacbedd5fgafc1g4dcdg9d0fg83b49434c087"
msgid "<i>Put the book away.</i>"
msgstr "<i>책을 치운다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Player
#. NodeID = 6de96fb3-707f-36c8-b8a3-813bb0d677c4
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - SORCERER(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:6de96fb3-707f-36c8-b8a3-813bb0d677c4
msgctxt "h77ff8f1bgee48g4e33gbacagfe03f3f6b79e"
msgid ""
"<i>Stay on the page, listen to the book. Try to connect with the magic bound "
"within it.</i>"
msgstr "<i>페이지에 집중하고, 책의 소리를 듣는다. 책이 묶여있는 마법에 연결하려고 노력한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = 6fb54892-58a6-7ef5-4e4b-093fc7427786
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FOR_DangerousBook_Event_FailedWisdomSave(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:6fb54892-58a6-7ef5-4e4b-093fc7427786
msgctxt "h0f1a1bbdg8191g4217gb9efgf437a16e95e2"
msgid ""
"*The glyphs scream, searing your mind. You feel lost, tossed in a sea of "
"arcane power you can neither control nor comprehend.*"
msgstr ""
"*문자가 비명을 지르며 당신의 정신을 불태웁니다. 통제할 수도, 이해할 수도 없는 신비한 힘의 바다에 던져진 듯 길을 잃은 기분이 "
"듭니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Player
#. NodeID = 7557632c-f0df-36b5-b4fa-75517c161859
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:7557632c-f0df-36b5-b4fa-75517c161859
msgctxt "h27dfe474g0117g490dgb605ge42d80ab2ff3"
msgid "<i>Close the book.</i>"
msgstr "<i>책을 닫는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = 7784f3bf-8b63-e6d3-9704-db62cec285da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:7784f3bf-8b63-e6d3-9704-db62cec285da
msgctxt "he2d59f69g3e98g46c8g8be2g8ff9c5cebc32"
msgid ""
"*Necromancy. The magical energies of all living things were stolen, "
"corrupted, and sealed in this vile book. It wants someone to share in its "
"insanity.*"
msgstr ""
"*강령술입니다. 이 사악한 책에는 모든 생명체의 마법 에너지가 도난당하고 타락하여 봉인되어 있습니다. 이 책은 누군가가 자신의 광기를 "
"공유하길 원하고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = 78656dde-0d43-7080-2acc-0df9e3f1bdbf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:78656dde-0d43-7080-2acc-0df9e3f1bdbf
msgctxt "hd8a05d4ag1a9dg4820g8847g4a1a48c2c1c1"
msgid ""
"*The glyphs swarm impatiently. The book wants you to turn the page, to delve "
"deeper. It's <i>hungry</i>.*"
msgstr ""
"*문자가 정신 없이 몰려듭니다. 책은 당신이 페이지를 넘기고 더 깊이 파고들기를 원합니다. <i>배가 고픈 것 같습니다</i>.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Player
#. NodeID = 7d0abc33-f1a9-05ea-8e9a-ac5dfd07bb5e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - SORCERER(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:7d0abc33-f1a9-05ea-8e9a-ac5dfd07bb5e
msgctxt "hcbc9ca0agbd94g4ff2g9699g324e05f3b7cb"
msgid ""
"<i>Refuse the book. Muster your willpower and force the magic to reveal its "
"nature.</i>"
msgstr "<i>책을 거부한다. 의지력을 강화하고 책의 진정한 본질을 끌어낸다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = 7e709620-8c1c-bd8a-9e84-3ee1d41dfe4b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_DangerousBook_State_FirstPageRead = True
#.   Object:
#.     - FOR_DangerousBook_Event_FailedWisdomSave(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:7e709620-8c1c-bd8a-9e84-3ee1d41dfe4b
msgctxt "h27b7758eg7639g4cefgb966g7ae7aa915f24"
msgid ""
"*All you can see are those symbols. All you can hear are the whispers - "
"there is nothing else.*"
msgstr "*보이는 것은 기호들뿐입니다. 속삭이는 소리만 들릴 뿐 그 외에는 아무것도 들리지 않습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = 821930dc-f779-0a8e-9cff-4ec1e03cb091
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - FOR_DangerousBook_SUB_UseTome.FinishTome(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:821930dc-f779-0a8e-9cff-4ec1e03cb091
msgctxt "h26d75bd4g0e11g4868ga493g847775442eb9"
msgid ""
"*Glyphs shift gently before your eyes. Words slip into your mind, onto your "
"lips, forming words you don't understand. And <i>something </i>is trying to "
"reply.*"
msgstr ""
"*문자가 눈앞에서 부드럽게 움직입니다. 단어가 마음속으로, 입술로 미끄러져 들어와 이해할 수 없는 단어가 만들어집니다. 그리고 "
"<i>무언가가</i> 대답하고 싶어 하는 것 같습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = 8315b422-d5e1-4868-22b1-c389205cc69e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SORCERER(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:8315b422-d5e1-4868-22b1-c389205cc69e
msgctxt "h4aeb1a14g94fcg40begbf03gf9c5eb6f741d"
msgid ""
"*Beneath the allure, you feel the faintest echo of torment. There is great "
"power in this book, but also great suffering.*"
msgstr "*매혹적인 표면의 이면에서 희미한 고통의 메아리가 느껴집니다. 이 책에는 위대한 힘도 있지만 엄청난 고통도 뒤따르고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = 8712c78a-c476-676d-91b7-52699e7b9ac5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FOR_DangerousBook_Event_FailedWisdomSave(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:8712c78a-c476-676d-91b7-52699e7b9ac5
msgctxt "h6767fe72g0103g4fb0gadf9ge5a3b30af0d2"
msgid ""
"*Pain grips your mind. The book will not be denied - it will make you read "
"on, or force you to retreat.*"
msgstr ""
"*고통이 당신의 정신을 사로잡습니다. 책을 거부할 수는 없습니다. 책의 의지로 계속 읽게 하거나, 강제로 포기하게 만들 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = 8e132b38-6e94-d34b-3d53-9ac3e513d60c
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_EVIL or PALADIN_EVIL or REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:8e132b38-6e94-d34b-3d53-9ac3e513d60c
msgctxt "h69d0745cg4390g4b15ga9fagbeb5ab8990d2"
msgid "*You feel the darkness radiating from the book. It's delicious.*"
msgstr "*책에서 발산되는 어둠이 느껴집니다. 맛있어 보입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = 8e132b38-6e94-d34b-3d53-9ac3e513d60c
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE or WIZARD
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:8e132b38-6e94-d34b-3d53-9ac3e513d60c
#, fuzzy
#| msgid ""
#| "*You've seen similar books in wizard's libraries - a tome on Thayan magic. A "
#| "rare and expensive find, but people have gone mad reading less dangerous "
#| "texts.*"
msgctxt "hcfb43da7g9f88g4597g9a7fg306562821180"
msgid ""
"*You've seen similar books in wizards' libraries - a tome on Thayan magic. A "
"rare and expensive find, but people have gone mad reading less dangerous "
"texts.*"
msgstr ""
"*위저드 도서관에서 비슷한 책을 본 기억이 떠오릅니다. 테이의 마법에 관한 고서였습니다. 희귀하고 값비싼 책이었지만, 사람들은 그보단 덜 "
"위험한 책을 읽느라 정신이 없었던 것 같습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = 90195b46-993f-769a-1bb0-af83e41f7c27
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FOR_DangerousBook_Event_FailedWisdomSave(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:90195b46-993f-769a-1bb0-af83e41f7c27
msgctxt "haf6a6c37gb37bg4d2bg9f7ag40a30ca11a35"
msgid ""
"*Assailed from all sides, you careen through the text, absorbing knowledge "
"you can barely comprehend. And yet, for all the violence, you start to see.*"
msgstr ""
"*사방에서 가해지는 고통을 견디며 글자를 읽고, 간신히 이해할 수 있는 지식을 흡수합니다. 하지만 그 모든 폭력에도 불구하고, 당신은 "
"뭔가 보이기 시작합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = 916250c1-0de9-378b-34df-ea5a92026fb1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_DangerousBook_State_FirstPageRead = False
#.      - FOR_DangerousBook_State_SecondPageRead = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:916250c1-0de9-378b-34df-ea5a92026fb1
msgctxt "h59a54cb0g8f5ag4862gb7f6g8f0fa83f0c0c"
msgid ""
"*You open the book to the first page, with its shifting glyphs and strange "
"whispers.*"
msgstr "*책을 펼쳐 첫 페이지를 넘기니, 변화무쌍한 문자들과 기묘한 속삭임이 펼쳐집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = 942cdaa2-63b8-646b-250e-f0a583db4608
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - FOR_DangerousBook_SUB_EvilTome.DestroyTome_Radiant(1) = True
#. TagRule: CLERIC_GOOD or DRUID or PALADIN
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:942cdaa2-63b8-646b-250e-f0a583db4608
msgctxt "h942b68edg416fg449dgb3dcgb914da6a5717"
msgid "*You can sense something dark about this tome - something profane.*"
msgstr "*이 고서에서 어둡고 불경한 기운이 느껴집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Player
#. NodeID = 9bc1d22c-ef3a-d429-5759-6eba80ecde56
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SavingThrow
#. RollAbility: Wisdom
#. DifficultyClass: 20
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:9bc1d22c-ef3a-d429-5759-6eba80ecde56
msgctxt "h1c363afeg2e25g4771gadc5g50980495ae24"
msgid "<i>Urge your hand to turn another page.</i>"
msgstr "<i>충동적으로 책의 다음 장으로 넘어간다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = a2521ac3-cf3d-b92d-d68d-7cad79b13392
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_DangerousBook_State_BookUnlocked = False
#. SetFlags:
#.   Quest:
#.     - FOR_DangerousBook_SUB_EvilTome.DestroyTome(1) = True
#.     - FOR_DangerousBook_SUB_UseTome.FindKey(1) = True
#.     - FOR_DangerousBook.InvestigateTome(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:a2521ac3-cf3d-b92d-d68d-7cad79b13392
msgctxt "h17de0831ga5d2g498bg9a01g8f5b46b37374"
msgid ""
"*The book is locked tight, with no visible keyhole - only an oval recess in "
"the cover's mouth.*"
msgstr "*책은 단단히 잠겨있으며, 열쇠 구멍은 보이지 않습니다. 다만 표지의 입에 타원형의 홈이 나 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = a8302445-7d15-b5c9-215f-77acac7ed4c5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_DangerousBook_State_BookFinished = True
#.   Object:
#.     - FOR_DangerousBook_State_SuccessfullyRead(1) = True
#.     - FOR_DangerousBook_Event_GrantForbiddenKnowledge(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:a8302445-7d15-b5c9-215f-77acac7ed4c5
msgctxt "h5541c7e2g639dg467ag8f7cg3089e3d79b80"
msgid "*The heavy cover thumps shut with a strange finality.*"
msgstr "*무거운 덮개가 묘한 마무리와 함께 쿵 닫힙니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = aa334fba-cef9-2db6-a324-a7f410c673ed
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_DangerousBook_State_FirstPageRead = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:aa334fba-cef9-2db6-a324-a7f410c673ed
msgctxt "h82599fe7g2da6g4e3bga235g10eee50b183f"
msgid ""
"*The symbols move aggressively, probing your mental defences, but you hold "
"strong. For now.*"
msgstr "*기호들이 공격적으로 움직이며 정신력을 시험하지만, 당신은 강하게 버텨냅니다. 당분간은 말입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = ae742875-bedd-5cc5-c080-ba931c53329c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:ae742875-bedd-5cc5-c080-ba931c53329c
msgctxt "h8411fd08gbc26g4817g806bg84d41392fc17"
msgid ""
"*The once-indecipherable glyphs now feel dangerously familiar, promising "
"unholy power to those who can take it.*"
msgstr "*한때 해독할 수 없었던 문양은 이제 위험할 정도로 친숙하게 느껴지며, 이를 손에 넣는 자에게는 부정한 힘을 약속합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = afffab9f-c1b8-a836-9c9b-4666a004dd42
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_DangerousBook_State_FirstPageRead = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:afffab9f-c1b8-a836-9c9b-4666a004dd42
msgctxt "h60ebff9eg71c1g48b7gab11g9b2e74ba7bf7"
msgid ""
"*The symbols dart beneath your eyes, warping and twisting. Your head throbs, "
"but you almost understand.*"
msgstr "*기호들이 눈 아래를 스쳐 지나가며 뒤틀리고 뒤틀립니다. 머리가 쿵쾅거리지만 거의 알아들을 수 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Player
#. NodeID = b06ba426-1311-c91f-8644-b8a2461938be
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#. SetFlags:
#.   Local:
#.     - 48b3a9be-e6ff-2ce6-24e5-a623e147a1c6_BARDLimerickStage1 = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:b06ba426-1311-c91f-8644-b8a2461938be
msgctxt "h4efad0c0g90a0g4495gb22agd30f156cb63a"
msgid ""
"<i>Drown the book's voice with verse. 'There was a young hero called "
"Barry...' </i>"
msgstr "<i>책이 내는 목소리를 잠재우기 위해 시를 읊는다. '한때 배리라는 젊은 영웅이 있었다네...'</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = baa28c04-91d6-5681-a601-960bccf0fb61
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:baa28c04-91d6-5681-a601-960bccf0fb61
msgctxt "hb0926195g459cg49b5ga9b0g28e6cc9dbd88"
msgid ""
"*The voices falter, the anger quells. The magic seems to grow still and "
"quiet, like a soothed beast.*"
msgstr "*목소리가 흔들리고 분노가 가라앉습니다. 마법은 진정된 짐승처럼 고요하고 조용해집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = bafbe48c-d2f3-b8e4-d05e-12f093dd00bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:bafbe48c-d2f3-b8e4-d05e-12f093dd00bf
msgctxt "he65ebd9bg0d7cg46d3g9f4bg9d31d1ccb671"
msgid ""
"*The world around you is gone - you can only see those glyphs, only hear "
"those voices.*"
msgstr "*당신을 둘러싼 세상이 사라집니다. 눈에는 오직 기호들만이 보이고, 귀에는 속삭이는 목소리만이 들려옵니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = bc293a07-2d04-5fa1-85d5-b196e57a6a27
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_DangerousBook_State_Bound = True
#.   Object:
#.      - FOR_DangerousBook_State_BookOwner(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:bc293a07-2d04-5fa1-85d5-b196e57a6a27
msgctxt "hf762c766g6b6ag4933g9dfdg21bfdb68e378"
msgid "*The book refuses to open - for you, at least.*"
msgstr "*책이 열리기를 거부합니다. 적어도, 당신에게는 말입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = bc691d3b-c0f8-a8cb-6853-2140434e7a86
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:bc691d3b-c0f8-a8cb-6853-2140434e7a86
msgctxt "h334a3321g8221g4a91gb0c0g54ec1454d91e"
msgid ""
"*Nothing. Just old parchment covered in arcane symbols. The magic sleeps.*"
msgstr "*아무것도 없습니다. 그저 비전 기호들이 새겨진 오래된 양피지일 뿐. 마법은 잠들어 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Player
#. NodeID = bdf886cf-3340-b2f4-e6cb-bd80347851ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:bdf886cf-3340-b2f4-e6cb-bd80347851ed
msgctxt "h1f5fc4e2ga10dg4ee6g8ae3gf9e9daa40a8f"
msgid "<i>Close the book.</i>"
msgstr "<i>책을 닫는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Player
#. NodeID = c287da55-adba-56b6-dd31-30faba158b70
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_DangerousBook_State_GaveBookAway = True
#.     - FOR_DangerousBook_Event_GaveBookToAstarion = True
#.   Object:
#.     - FOR_DangerousBook_State_BookOwner(1) = True
#.     - FOR_DangerousBook_Event_TakeBook(1) = True
#. TagRule: REALLY_ASTARION and !AVATAR
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:c287da55-adba-56b6-dd31-30faba158b70
msgctxt "h38389529g1149g40e9g8914gd8d5468970f9"
msgid ""
"Well. Quite the page turner. I'll get back to it when I have more time to "
"focus."
msgstr "아주 흥미로운 책이네. 다음에 집중할 시간이 생기면 다시 읽어봐야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = c3421af8-07bb-b30e-a6bb-547545dc602a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FOR_DangerousBook_Event_FailedWisdomSave(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:c3421af8-07bb-b30e-a6bb-547545dc602a
msgctxt "hdc35b535gb5a0g44f6gbc4bga4edb5a14b19"
msgid ""
"*Every symbol seems to burn your eyes. You can feel them searing into your "
"mind - into your soul.*"
msgstr "*모든 기호가 당신의 눈을 태우는 것 같습니다. 그 기호들이 당신의 마음과 영혼 속으로 스며드는 것이 느껴집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = c7035544-4f7f-9896-2f09-a83dc0f9c482
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_DangerousBook_State_FirstPageRead = False
#.     - FOR_DangerousBook_State_SecondPageRead = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:c7035544-4f7f-9896-2f09-a83dc0f9c482
msgctxt "hbe8c9b03gfa81g4489gbaabgb7b553955f50"
msgid ""
"*You feel claws moving in the shadows. They pull at you, dragging you "
"closer.*"
msgstr "*그림자 속을 거니는 발톱들이 느껴집니다. 그것들이 당신을 끌어당기고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = c7795c47-d7e9-e71d-2b78-7778c521b49a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_DangerousBook_State_BookUnlocked = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:c7795c47-d7e9-e71d-2b78-7778c521b49a
msgctxt "h94e98341gaa97g4791g8b80g427348bf4be9"
msgid ""
"*The book's pull is irresistible; you feel changed, bettered, for having "
"opened it. Suddenly, you are capable of anything - felling mountains, "
"darkening suns, conversing with the dead.*"
msgstr ""
"*책의 유혹에 저항할 수 없습니다. 열었다는 사실만으로 당신은 변화하고, 나아진 기분입니다. 갑자기, 당신은 무엇이라도 할 수 있을 듯한 "
"기분이 듭니다. 산을 무너뜨리고, 태양을 가리고, 죽은 이와도 대화할 수 있을 것만 같습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Player
#. NodeID = c955353b-0114-6bbd-0661-c555d2eaf2cd
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 10
#. TagRule: PALADIN_EVIL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:c955353b-0114-6bbd-0661-c555d2eaf2cd
msgctxt "h7c99c69ag3babg4a49gaa2bg079201170a93"
msgid "<i>Welcome the darkness in the name of your god and turn the page.</i>"
msgstr "<i>당신이 따르는 신의 이름에 따라 어둠을 환영하고 페이지를 넘긴다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Player
#. NodeID = c955353b-0114-6bbd-0661-c555d2eaf2cd
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 10
#. TagRule: CLERIC_EVIL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:c955353b-0114-6bbd-0661-c555d2eaf2cd
msgctxt "h1f96d6dcgf572g4114g8742ga67260244eee"
msgid "<i>Welcome the darkness in the name of your god and turn the page.</i>"
msgstr "<i>당신이 따르는 신의 이름에 따라 어둠을 환영하고 페이지를 넘긴다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Shadowheart
#. NodeID = cdfaea9e-da9b-958c-65ef-cd066d8f0bf6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_DangerousBook_State_ShadowheartOpinion(1) = False
#. SetFlags:
#.   Dialog:
#.     - FOR_DangerousBook_State_ShadowheartOpinion(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:cdfaea9e-da9b-958c-65ef-cd066d8f0bf6
msgctxt "h6903888cg43fag4169g9427gbeb7da557c2d"
msgid ""
"Curious. Why don't you take a closer look... I'll observe from back here."
msgstr "흥미롭네. 어디 자세히 살펴봐... 난 멀찌감치 뒤에서 관찰할게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = ced71e8f-592c-cf7f-abde-b75b41d96009
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_DangerousBook_State_FirstPageRead = True
#.   Object:
#.     - FOR_DangerousBook_Event_FailedWisdomSave(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:ced71e8f-592c-cf7f-abde-b75b41d96009
msgctxt "h63a25518g79abg4fcdga328g6202bee3484d"
msgid ""
"*All you can see are those symbols. All you can hear are the whispers - "
"there is nothing else.*"
msgstr "*보이는 것은 기호들뿐입니다. 속삭이는 소리만 들릴 뿐 그 외에는 아무것도 들리지 않습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Player
#. NodeID = dd5ad812-d4a2-210f-aa2a-8b975dc094a8
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Local:
#.      - 48b3a9be-e6ff-2ce6-24e5-a623e147a1c6_BARDLimerickStage1 = True
#.   Tag:
#.      - BARD(1) = True
#. SetFlags:
#.   Local:
#.     - 48b3a9be-e6ff-2ce6-24e5-a623e147a1c6_BARDLimerickStage2 = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:dd5ad812-d4a2-210f-aa2a-8b975dc094a8
msgctxt "hb63d56f5g7d19g47a0gbd4eg9b9e859966e2"
msgid ""
"<i>'... Who had to best a tough quest and not tarry. It was going quite "
"well, 'til he fell under a spell...'</i>"
msgstr "<i>'...쉬지 않고 힘든 임무를 수행해야 했다네. 어느 한 마법에 걸리기 전까진 그는 아무런 문제가 없었네...'</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = dda62d2a-05f3-6af7-bcd5-6643b5c409b7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_DangerousBook_State_SecondPageRead = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:dda62d2a-05f3-6af7-bcd5-6643b5c409b7
msgctxt "hcdb04367g3975g4bafg8ebeg151cf7f39eed"
msgid ""
"*You open the book where you left off, and the voices return, chiding you "
"for your indecision.*"
msgstr "*전에 중단한 부분을 다시 펼치자, 목소리가 돌아와 당신의 우유부단함을 꾸짖습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Astarion
#. NodeID = de0ea13b-18b2-d295-3178-95a68068be3d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_DangerousBook_AstarionWants = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:de0ea13b-18b2-d295-3178-95a68068be3d
msgctxt "hbb6730e2g6c42g4e57g8a38g603db4510e79"
msgid "You can't be serious. Give it to me this instant!"
msgstr "진심은 아니겠지. 당장 이리 내놔!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = dfbe07a6-fd74-90a4-2a1b-8f949ce681c3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SORCERER(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:dfbe07a6-fd74-90a4-2a1b-8f949ce681c3
msgctxt "h43247de1gc96ag4dcfga256gaedfe17def70"
msgid "*So much promised... but what is sought in return?*"
msgstr "*너무나 많은 것들을 약속하지만... 그 대가는 뭘까요?*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = e3a51c90-94b9-de0a-d890-38ef3410e626
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_DangerousBook_State_BookFinished = True
#.      - FOR_DangerousBook_State_Bound = True
#.      - LOW_SorcerousSundries_State_LastPageThayRead = False
#.   Object:
#.      - FOR_DangerousBook_State_BookOwner(1) = True
#.      - LOW_SorcerousSundries_Event_CypherRead(1) = False
#. SetFlags:
#.   Quest:
#.     - FOR_DangerousBook_SUB_UseTome.FindWayToDecypherPage(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:e3a51c90-94b9-de0a-d890-38ef3410e626
msgctxt "hbf966639g3428g4e46g9bf5g86fae804abd6"
msgid ""
"*You've seen much of the book, but its most powerful secrets are guarded by "
"indecipherable glyphs. Without a key, they may be locked away forever.*"
msgstr ""
"*책이 담고 있는 대부분의 내용은 읽었지만, 가장 강력한 비밀은 해독할 수 없는 문자로 보호되어 있습니다. 열쇠 없이는 영원히 읽을 수 "
"없을지도 모릅니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = e49f2f75-e12e-f447-9f38-e680c5e500d7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:e49f2f75-e12e-f447-9f38-e680c5e500d7
msgctxt "h98371185gf59dg4314g95fcg4ce3df60d416"
msgid "*The glyphs seem to burn your inner eye, outraged at your denial.*"
msgstr "*문양은 당신의 부정에 분노하여 내면의 눈을 불태우는 것 같습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = e8629488-3c71-eeb1-f490-0fbeb5ed4145
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:e8629488-3c71-eeb1-f490-0fbeb5ed4145
msgctxt "hdaec0107gea5ag4561g8cc2g6de8e27cf38d"
msgid ""
"*The claws try to grip your hands, try to stop you, but you slam the book "
"shut before they can take you.*"
msgstr "*발톱들이 당신의 손을 붙잡아 막아보려 하지만, 그 전에 당신은 쾅 하고 책을 닫아 버립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Player
#. NodeID = ec49e945-4b72-3c4b-d36d-6b8a781f7920
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_DangerousBook_State_Bound = False
#.      - FOR_DangerousBook_AstarionWants = True
#.      - FOR_DangerousBook_State_BookUnlocked = True
#.   Tag:
#.      - REALLY_ASTARION(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:ec49e945-4b72-3c4b-d36d-6b8a781f7920
msgctxt "h90436a0bg1b66g4e8bgb025gb2d702af177f"
msgid "<i>Give the book to Astarion.</i>"
msgstr "<i>책을 아스타리온에게 준다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = eeb344e6-5c6f-6912-cb45-5bb86039f937
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_DangerousBook_State_Bound = False
#.      - FOR_DangerousBook_State_BookUnlocked = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:eeb344e6-5c6f-6912-cb45-5bb86039f937
msgctxt "h7bdce19fg7843g4457gb2dcgc151e3574fd4"
msgid ""
"*As you look into the book's amethyst eyes, you can almost hear a voice. You "
"just have to open the book, and it will be yours. Forever.*"
msgstr "*책의 자수정 같은 눈동자를 들여다보면 목소리가 들리는 듯합니다. 책을 펼치기만 하면 당신의 것이 될 것입니다. 영원히.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = f1fff469-3882-4da9-d826-8684327c3582
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_DangerousBook_State_BookFinished = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:f1fff469-3882-4da9-d826-8684327c3582
msgctxt "hd739956fge7feg4d0egb0a3gd687e1917d88"
msgid "*The book refuses to open.*"
msgstr "*책이 열리길 거부합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = f36721ea-f0eb-dde7-3e4c-1bcfae7fd6ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:f36721ea-f0eb-dde7-3e4c-1bcfae7fd6ea
msgctxt "h72fee232g7e72g44f4gb6e0g942559639b55"
msgid "*The voices return. Louder. Stronger. Commanding you to stop...*"
msgstr "*목소리가 다시 들려옵니다. 더 커지고. 더 강해졌습니다. 멈추라고 명령하고 있습니다...*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Player
#. NodeID = f65e2667-4824-f713-9e34-cd125bb3f2bf
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Local:
#.      - 48b3a9be-e6ff-2ce6-24e5-a623e147a1c6_BARDLimerickStage2 = True
#.   Tag:
#.      - BARD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:f65e2667-4824-f713-9e34-cd125bb3f2bf
msgctxt "h760d481fg768eg40e9g8f70g0efaa2157056"
msgid ""
"<i>Channel your magic into the final line. 'Now poor Barry's got a hag he "
"must marry.'</i>"
msgstr "<i>마지막 대사에 마법을 불어넣는다. '이제 불쌍한 배리는 결혼해야 할 해그가 생겼다.'</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = f7c631aa-0267-81fd-e614-8285f26c8d9b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:f7c631aa-0267-81fd-e614-8285f26c8d9b
msgctxt "h3660f320g25fbg48f5gafffg03233e67058e"
msgid ""
"*But as you close the book, a nagging doubt whispers in your mind. What "
"consequences will there be for calling the dead from their rest?*"
msgstr "*하지만 책을 덮으니 마음속에서 잔잔한 의심이 피어오릅니다. 죽은 자를 안식처에서 불러내면 어떤 결과가 초래될까요?*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = fae7529f-38f2-4a0e-6694-d099567d6c22
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_DangerousBook_State_FirstPageRead = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:fae7529f-38f2-4a0e-6694-d099567d6c22
msgctxt "h3e1d6940g886bg4fd6g88d7gcf2e807c5d7a"
msgid ""
"*You open the book where you left off, the glyphs dancing before your eyes.*"
msgstr "*전에 읽던 부분을 다시 펼치자, 눈앞에서 문양들이 춤을 춥니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Lae'zel
#. NodeID = fb638d88-ac74-6882-fac1-6d594344cb10
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_DangerousBook_State_LaezelOpinion(1) = False
#. SetFlags:
#.   Dialog:
#.     - FOR_DangerousBook_State_LaezelOpinion(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:fb638d88-ac74-6882-fac1-6d594344cb10
msgctxt "h2112a66dgcf6cg4c86g81deg8d0682a3fff0"
msgid ""
"A cursed book? How obvious. Whoever opens it deserves the fate that befalls "
"them."
msgstr "저주받은 책? 너무 뻔하군. 그걸 여는 자는 무슨 운명이 들이닥치든 당해도 싸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome
#. Speaker = Narrator
#. NodeID = fdfa9313-9e22-39c2-a4df-6f7c09830d3b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_Tome:fdfa9313-9e22-39c2-a4df-6f7c09830d3b
msgctxt "h6817b9a1g0cdbg4435gafc0g77e0e4a7a46d"
msgid ""
"*The whispers, the pain - it all disappears in an instant. You are yourself "
"again.*"
msgstr "*속삭임도, 고통도, 모든 것이 순식간에 사라집니다. 당신은 원래대로 되돌아옵니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_VB_BookDestroyed
#. Speaker = Player
#. NodeID = 41778831-0aee-dc1b-eb16-180a194d2e21
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_VB_BookDestroyed:41778831-0aee-dc1b-eb16-180a194d2e21
msgctxt "h178f3718ga0cdg4c7cg92a4g44bcacbcd68f"
msgid "You damn fool! Who knows what power it contained?"
msgstr "이런 빌어먹을 멍청이 같으니! 그 책에 어떤 힘이 담겨 있었을 줄 알고 그런 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_VB_BookDestroyed
#. Speaker = Player
#. NodeID = 41778831-0aee-dc1b-eb16-180a194d2e21
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_VB_BookDestroyed:41778831-0aee-dc1b-eb16-180a194d2e21
msgctxt "h3c11d1e7gfa35g4521ga424gbb475be33bcc"
msgid "It's a barbarian act to destroy a book!"
msgstr "책을 파괴하다니 야만스러운 행위야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_VB_BookDestroyed
#. Speaker = Player
#. NodeID = 41778831-0aee-dc1b-eb16-180a194d2e21
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_VB_BookDestroyed:41778831-0aee-dc1b-eb16-180a194d2e21
msgctxt "h237ea6aeg3b94g41a7g809agcd8d0a7d3f5f"
msgid "Good riddance."
msgstr "속이 다 시원하군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_VB_BookDestroyed
#. Speaker = Player
#. NodeID = 41778831-0aee-dc1b-eb16-180a194d2e21
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_VB_BookDestroyed:41778831-0aee-dc1b-eb16-180a194d2e21
msgctxt "h69493dcbg348cg4772gaf43g47be48c70bcc"
msgid "The book may have been useful. What were you <i>thinking?</i>"
msgstr "그 책은 유용하게 쓰일 수도 있었어. 무슨 <i>생각을 한 거야?</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_VB_BookDestroyed
#. Speaker = Player
#. NodeID = 41778831-0aee-dc1b-eb16-180a194d2e21
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_VB_BookDestroyed:41778831-0aee-dc1b-eb16-180a194d2e21
msgctxt "hcbd0c537g9895g4957g88e2gb394b41fe4ae"
msgid "Hmm. Probably wise of you to get rid of that thing."
msgstr "흠. 그런 물건은 파괴하는 게 현명한 일이었겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_VB_BookDestroyed
#. Speaker = Player
#. NodeID = 41778831-0aee-dc1b-eb16-180a194d2e21
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_VB_BookDestroyed:41778831-0aee-dc1b-eb16-180a194d2e21
msgctxt "hcb19166agfb91g461dg81fag58aefb8a7788"
msgid "Well played. Who knows what curses we might have unleashed?"
msgstr "잘했어. 그 책이 우리에게 어떤 저주를 불러왔을지 모르잖아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_VB_BookDestroyed
#. Speaker = Player
#. NodeID = 41778831-0aee-dc1b-eb16-180a194d2e21
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_VB_BookDestroyed:41778831-0aee-dc1b-eb16-180a194d2e21
msgctxt "hab21451cgfc08g4c49gbeecg4ccd2bd478c0"
msgid "Well done. The world's better off without it."
msgstr "잘했어. 그 책은 없어지는 편이 세상에 좋아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_DeathOfATrueSoul_PAD_TadpoleLeaves
#. Speaker = Player
#. NodeID = a761b569-5e1b-413f-a6ca-f777b0055819
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_DeathOfATrueSoul_PAD_TadpoleLeaves:a761b569-5e1b-413f-a6ca-f777b0055819
msgctxt "h88c860cagaf5ag4f80g9604g4ae29722cefb"
msgid "Ugh. Can't believe one of those things lives in my brain."
msgstr "으. 저런 게 내 뇌 속에 살고 있다니 믿기지가 않는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_DeathOfATrueSoul_PAD_TadpoleLeaves
#. Speaker = Player
#. NodeID = a761b569-5e1b-413f-a6ca-f777b0055819
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_DeathOfATrueSoul_PAD_TadpoleLeaves:a761b569-5e1b-413f-a6ca-f777b0055819
msgctxt "h9ced0f3cg2aa6g4760g969ege2c5ce5935c9"
msgid "Come - we'll not find purification here."
msgstr "떠나자, 여기에서는 정화를 찾을 수 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_DeathOfATrueSoul_PAD_TadpoleLeaves
#. Speaker = Player
#. NodeID = a761b569-5e1b-413f-a6ca-f777b0055819
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_DeathOfATrueSoul_PAD_TadpoleLeaves:a761b569-5e1b-413f-a6ca-f777b0055819
msgctxt "h84371d07gbfdfg4e7ag97b6g97d0ff97d2ab"
msgid ""
"Let's forget it for now? The less I think about that thing swimming about in "
"my skull, the happier I'll be."
msgstr "지금은 무시하는 게 어때? 내 머릿속을 헤엄치고 다니는 놈에 관해서라면 덜 생각할수록 더 행복할 것 같거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_DeathOfATrueSoul_PAD_TadpoleLeaves
#. Speaker = Player
#. NodeID = a761b569-5e1b-413f-a6ca-f777b0055819
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_DeathOfATrueSoul_PAD_TadpoleLeaves:a761b569-5e1b-413f-a6ca-f777b0055819
msgctxt "h4c711c81gcf8cg4e1eg8d0fg608ce64a441c"
msgid "All the more reason to rid ourselves of our own uninvited guests."
msgstr "우리 안의 불청객을 제거해야 될 이유가 또 늘었을 뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_DeathOfATrueSoul_PAD_TadpoleLeaves
#. Speaker = Player
#. NodeID = a761b569-5e1b-413f-a6ca-f777b0055819
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_DeathOfATrueSoul_PAD_TadpoleLeaves:a761b569-5e1b-413f-a6ca-f777b0055819
msgctxt "h4f84506eg3099g4f9cgb8e9g80c156c05dfe"
msgid "Here's hoping there's a cure apart from kicking the cart."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_DeathOfATrueSoul_PAD_TadpoleLeaves
#. Speaker = Player
#. NodeID = a761b569-5e1b-413f-a6ca-f777b0055819
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_DeathOfATrueSoul_PAD_TadpoleLeaves:a761b569-5e1b-413f-a6ca-f777b0055819
msgctxt "h462718f3g1bc4g445cgb145g1af9376aacad"
msgid ""
"I wish mine would give up so easily. Though without requiring such extreme "
"motivation, of course."
msgstr "내 올챙이도 이렇게 순순히 단념해 주면 좋겠군. 물론 이렇게 극단적인 동기 부여 없이 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_DeathOfATrueSoul_PAD_TadpoleLeaves
#. Speaker = Player
#. NodeID = a761b569-5e1b-413f-a6ca-f777b0055819
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_GENERIC
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_DeathOfATrueSoul_PAD_TadpoleLeaves:a761b569-5e1b-413f-a6ca-f777b0055819
msgctxt "h3b1ddf1fgdc67g48d9gb8e9gdf7571673491"
msgid ""
"The longer we wait, the likelier that we share in this fate, or worse. Let's "
"get rid of these things."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_DeathOfATrueSoul_PAD_TadpoleLeaves
#. Speaker = Player
#. NodeID = c47c934a-c6df-4fc1-9e55-48f8294c65fc
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_DeathOfATrueSoul_PAD_TadpoleLeaves:c47c934a-c6df-4fc1-9e55-48f8294c65fc
msgctxt "h3398accdg1d00g442ega248gf70394268986"
msgid "Is it just my imagination, or is this bug-plague spreading?"
msgstr "이 벌레 전염병이 퍼지고 있는 것 같은데, 단지 내 망상일 뿐일까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_DeathOfATrueSoul_PAD_TadpoleLeaves
#. Speaker = Player
#. NodeID = c47c934a-c6df-4fc1-9e55-48f8294c65fc
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_DeathOfATrueSoul_PAD_TadpoleLeaves:c47c934a-c6df-4fc1-9e55-48f8294c65fc
msgctxt "hd2b0d0abg531fg4e9dg8cacg6204e2e8a291"
msgid ""
"Slithering away the moment its host is dead. Not that I expected loyalty "
"from a worm."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_DeathOfATrueSoul_PAD_TadpoleLeaves
#. Speaker = Player
#. NodeID = c47c934a-c6df-4fc1-9e55-48f8294c65fc
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_DeathOfATrueSoul_PAD_TadpoleLeaves:c47c934a-c6df-4fc1-9e55-48f8294c65fc
msgctxt "h33faae91g197ag4a57g92e6gf331f69cff46"
msgid ""
"That tadpole wasted no time in abandoning its host. Not sentimental "
"creatures, clearly."
msgstr "저 올챙이는 숙주를 버리는데 전혀 망설이지 않았어. 확실히 감상적인 생명체는 아닌 것 같네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_DeathOfATrueSoul_PAD_TadpoleLeaves
#. Speaker = Player
#. NodeID = c47c934a-c6df-4fc1-9e55-48f8294c65fc
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_DeathOfATrueSoul_PAD_TadpoleLeaves:c47c934a-c6df-4fc1-9e55-48f8294c65fc
msgctxt "hd13798c1gdc56g4db2g99ffg56b811f69ebf"
msgid "Horrid creature. That one lives inside me is... repulsive."
msgstr "끔찍한 생명체야. 저게 내 안에서 자라고 있다니... 혐오스러운데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_DeathOfATrueSoul_PAD_TadpoleLeaves
#. Speaker = Player
#. NodeID = c47c934a-c6df-4fc1-9e55-48f8294c65fc
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_DeathOfATrueSoul_PAD_TadpoleLeaves:c47c934a-c6df-4fc1-9e55-48f8294c65fc
msgctxt "h04dc42c5gbdb4g4f94g8ba2g6affc731e653"
msgid "Ew!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_DeathOfATrueSoul_PAD_TadpoleLeaves
#. Speaker = Player
#. NodeID = c47c934a-c6df-4fc1-9e55-48f8294c65fc
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_DeathOfATrueSoul_PAD_TadpoleLeaves:c47c934a-c6df-4fc1-9e55-48f8294c65fc
msgctxt "hf476106bg49feg4026gbda0g9185037c84ac"
msgid ""
"I have to say, it's one thing to have a parasite in your head, quite another "
"not to know it's there."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_DeathOfATrueSoul_PAD_TadpoleLeaves
#. Speaker = Player
#. NodeID = c47c934a-c6df-4fc1-9e55-48f8294c65fc
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_GENERIC
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_DeathOfATrueSoul_PAD_TadpoleLeaves:c47c934a-c6df-4fc1-9e55-48f8294c65fc
msgctxt "hb06c465ega576g4d6bgb65dg480768226e00"
msgid ""
"These things abandon their hosts as soon as they need to. Vile parasites..."
msgstr "이것들은 그럴 이유가 생기자마자 숙주를 버리는 군. 역겨운 기생충 같으니..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Player
#. NodeID = 006ad019-f850-c67e-cf4c-d3479dfff5fd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Absolute_Knows_TrueSoul = False
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(2) = False
#.   Tag:
#.      - TRUESOUL(2) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:006ad019-f850-c67e-cf4c-d3479dfff5fd
msgctxt "hc4f41de4g9348g4f83g9470g0e8a8d75478b"
msgid "You <i>will</i> release the gnome. That's an order."
msgstr "너는 노움을 <i>풀어줄 것</i>이다. 그게 명령이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = 016704a4-01d1-7365-f7dd-24551bf21b76
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_GnomeGoblinsPromisedLeave = False
#.   Tag:
#.      - DROWELF(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:016704a4-01d1-7365-f7dd-24551bf21b76
msgctxt "hda8cdd4eg6724g4f78ga607g88d1abb0b6eb"
msgid "What've we got 'ere...? Oh."
msgstr "이게 누구신가…? 오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Player
#. NodeID = 03f6801b-de09-9f82-30ba-4eff40258e9f
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Script:
#.      - GEN_CheckPocketGold_5 = False
#. SetFlags:
#.   Dialog:
#.     - FOR_GnomeGoblin1_PlayerNonAggressiveOptions(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:03f6801b-de09-9f82-30ba-4eff40258e9f
msgctxt "hffa56c73g50d9g4639gb477g10e5f1a27fd5"
msgid ""
"<i>Haggle with the goblin, though you lack even a modest sum of gold.</i>"
msgstr "<i>고블린과 흥정한다. 비록 주머니에 돈도 거의 없지만.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Player
#. NodeID = 047fbbff-ce7e-ad0b-4e9e-b38c966c84bd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:047fbbff-ce7e-ad0b-4e9e-b38c966c84bd
msgctxt "hfa9ce416g08a5g4102gbe05gdb786a320be7"
msgid "Leave, immediately. This prisoner is mine now."
msgstr "당장 떠나. 이 포로는 지금부터 내 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = 068be901-953c-e216-9338-c34acda584f9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_GnomeGoblinsPacified = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:068be901-953c-e216-9338-c34acda584f9
msgctxt "h3572b3f6g25c5g4bd5g936bg523506f372de"
msgid "High time we got out of here."
msgstr "얼른 여길 떠야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Player
#. NodeID = 0760eb6a-ee44-e0f5-c3b5-8a53e852192a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - WLD_UnfortunateGnome_WhatTheyDoing(2) = True
#.      - WLD_UnfortunateGnome_Why(2) = False
#. SetFlags:
#.   Dialog:
#.     - WLD_UnfortunateGnome_Why(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:0760eb6a-ee44-e0f5-c3b5-8a53e852192a
msgctxt "hcfd6ee3fga980g4f2fg9bfag5eb428db8a79"
msgid "Let me rephrase that - <i>why </i>are you doing this?"
msgstr "질문을 다시 하지 - <i>왜 </i>이런 짓을 하는 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = 0771803c-2a2b-7db4-de53-f9fa26ac506d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:0771803c-2a2b-7db4-de53-f9fa26ac506d
msgctxt "heb4a3c55g451ag4eeega450g1f7c1158672f"
msgid ""
"W-well, that's that... We'll be on our way. Do as you like with the "
"pipsqueak..."
msgstr "그-그럼, 이만... 우린 갈 길 가겠습니다. 이 볼품없는 녀석은 마음대로 하십쇼..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Narrator
#. NodeID = 0776df39-cc89-088b-aa7b-56e5d467306e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount5(2) = False
#.   Tag:
#.      - TRUESOUL(2) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount5(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:0776df39-cc89-088b-aa7b-56e5d467306e
msgctxt "ha9d8c827gb2d3g4e2dgae2fgf887912ecb43"
msgid ""
"*Your blood runs quicker, feeding the gnawing absence at the centre of your "
"mind.*"
msgstr "*피가 더 빨리 흐르면서, 당신의 정신 한가운데를 좀먹는 허전함을 양분으로 채웁니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = 0b04b89e-2b01-f9cb-a220-d517075205aa
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - WLD_GnomeGoblin1_NoGoldPersuade(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:0b04b89e-2b01-f9cb-a220-d517075205aa
msgctxt "h60123888gdb58g420cgb1ddg7e0ae17ec1a4"
msgid "A haggler, are ya? How 'bout this: you live..."
msgstr "흥정해 보시겠다? 이러면 어때. 곱게 보내 주는 대신..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Player
#. NodeID = 0c8b9d5e-28ea-a598-ac7d-79bbc7b7205a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_CheckPocketGold_2 = True
#. SetFlags:
#.   Object:
#.     - GEN_TransferNPCPayment_2(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:0c8b9d5e-28ea-a598-ac7d-79bbc7b7205a
msgctxt "h212e997age758g4b8dg8ec2g0c3cee1a1a6f"
msgid "<i>Pay the 'higher' sum to the goblin.</i>"
msgstr "<i>고블린에게 '더 높은' 금액을 지불한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Player
#. NodeID = 0d9e41d8-7d86-959c-4c6f-e4c74a4571d5
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(2) = False
#.      - PALADIN(2) = False
#. SetFlags:
#.   Global:
#.     - FOR_UnfortunateGnome_State_NonCharlatanAccess = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:0d9e41d8-7d86-959c-4c6f-e4c74a4571d5
msgctxt "h8d85bc4cg3e13g4660g9669gccc79b3c6dea"
msgid "<i>Say nothing. Stare down the gibbering coward.</i>"
msgstr "<i>아무 말 없이 횡설수설하는 겁쟁이를 내려다 본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Narrator
#. NodeID = 0f71d325-c8d2-6578-abc1-e0e5764e859d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:0f71d325-c8d2-6578-abc1-e0e5764e859d
msgctxt "he37df9fbgf6e7g4cafgaaf3g481de2dc7c04"
msgid ""
"*The goblin's nostrils flare, as if trying to judge you through smell "
"alone...*"
msgstr "*고블린의 콧구멍이 냄새로만 당신을 판단하려는 듯 벌렁입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Barcus Wroot
#. NodeID = 123a3723-be42-96fa-dd6d-9ebea86d5868
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_UnfortunateGnome_State_Still = True
#. SetFlags:
#.   Object:
#.     - FOR_GnomeGoblin1_HasMet(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:123a3723-be42-96fa-dd6d-9ebea86d5868
msgctxt "h0cf9e400ge8aag4b0ag94fagf3800a614a56"
msgid "Let me dowwwn!"
msgstr "내려줘어어어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Player
#. NodeID = 15ec990e-5c4b-7cf2-2ef1-ece9324c7ea1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - WLD_GnomeGoblin1_DrowKeepGoing(2) = True
#.   Tag:
#.      - BRANDED(2) = True
#. SetFlags:
#.   Global:
#.     - FOR_UnfortunateGnome_State_NonCharlatanAccess = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:15ec990e-5c4b-7cf2-2ef1-ece9324c7ea1
msgctxt "h3cb24441g33c9g4af4g9493g241cf1e814c1"
msgid "<i>Show them your brand and tell them to carry on.</i>"
msgstr "<i>낙인을 보여주며 계속하라고 지시한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = 170d1ad9-17bf-5b64-a660-57bacd37c06c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - WLD_UnfortunateGnome_UsedAmulet(2) = True
#. SetFlags:
#.   Global:
#.     - FOR_GnomeGoblinsPacified = True
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:170d1ad9-17bf-5b64-a660-57bacd37c06c
msgctxt "ha1c36b6bg03a2g4ea6gb3f6g07918ea3925a"
msgid ""
"Apologies, sir. We didn't mean to doubt a <i>True Soul</i>. We'll be off."
msgstr "죄송합니다, 나으리. <i>참된 영혼</i>을 의심하려던 건 아니었어요. 저흰 떠나겠습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = 170d1ad9-17bf-5b64-a660-57bacd37c06c
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - WLD_UnfortunateGnome_UsedAmulet(2) = True
#. SetFlags:
#.   Global:
#.     - FOR_GnomeGoblinsPacified = True
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:170d1ad9-17bf-5b64-a660-57bacd37c06c
msgctxt "h9804806fgd9d9g4c92g96ddg5f5135987aec"
msgid ""
"Apologies, m'lady. We didn't mean to doubt a <i>True Soul</i>. We'll be off."
msgstr "죄송합니다, 마님. <i>참된 영혼</i>을 의심하려던 건 아니었어요. 저흰 떠나겠습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = 170d1ad9-17bf-5b64-a660-57bacd37c06c
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - WLD_UnfortunateGnome_UsedAmulet(2) = True
#. SetFlags:
#.   Global:
#.     - FOR_GnomeGoblinsPacified = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:170d1ad9-17bf-5b64-a660-57bacd37c06c
msgctxt "h40f6eb94g7f9ag4536g813ag0f5cc5d567d0"
msgid ""
"Apologies, your grace. We didn't mean to doubt a <i>True Soul</i>. We'll be "
"off."
msgstr "죄송합니다, 존귀한 분이시여. 저희가 <i>참된 영혼</i>을 의심하려던 건 아니었어요. 저흰 떠나겠습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Barcus Wroot
#. NodeID = 18a3cfc4-bc2e-f94b-1d61-5cc191648f05
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:18a3cfc4-bc2e-f94b-1d61-5cc191648f05
msgctxt "h817f288egc471g47c0g8b2fgd6a342e2187b"
msgid "...Release me this instant, you <i>beasts</i>!"
msgstr "...당장 날 풀어줘, 이 <i>짐승아</i>!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Narrator
#. NodeID = 18b930d9-bbce-e849-9c31-7c656ffe155e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - WLD_UnfortunateGnome_UsedAmulet(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:18b930d9-bbce-e849-9c31-7c656ffe155e
msgctxt "hd8137534ge055g454bgb1a0g0cc4729e06d5"
msgid ""
"*The goblin's nostrils flare nervously. All of his bluster seems to vanish.*"
msgstr "*고블린의 콧구멍이 불안하게 벌렁입니다. 그의 엄포가 모두 사라지는 듯합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Barcus Wroot
#. NodeID = 1d493165-c8ca-84e4-053b-fabc6da096f5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_UnfortunateGnome_State_Still = False
#. SetFlags:
#.   Object:
#.     - FOR_GnomeGoblin1_HasMet(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:1d493165-c8ca-84e4-053b-fabc6da096f5
msgctxt "he49038a8g8e8bg4aa3ga0b6g674f52976e26"
msgid "Stop this thiiiing!"
msgstr "이것 좀 멈춰어어어어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = 1eb9b860-a4fe-4924-67d8-5e2513783c62
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - WLD_GnomeGoblin1_AbandonNegotiations(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:1eb9b860-a4fe-4924-67d8-5e2513783c62
msgctxt "h5656635cgc8dfg4418g8318g89b97c9f1a42"
msgid "Like who? <i>You?</i>"
msgstr "가령 누구? <i>너?</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = 20bf2b3d-3a6c-474e-3195-147c3a4dc984
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:20bf2b3d-3a6c-474e-3195-147c3a4dc984
msgctxt "hde8421d0g5b82g45eega6e4g06d4232675f4"
msgid "Oh, that's how it is, is it...?"
msgstr "아, 그렇게 나오겠다 이거지...?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Narrator
#. NodeID = 21459a2a-5c4b-7829-1fec-16243c283c02
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount1(2) = False
#.   Tag:
#.      - TRUESOUL(2) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount1(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:21459a2a-5c4b-7829-1fec-16243c283c02
msgctxt "hd867f20bgddbdg49bag8dd7g4a99d3233f9f"
msgid "*A shiver runs across your mind... You feel sated.*"
msgstr "*전율이 불현듯 머릿속을 스쳐 지나가고... 만족감이 듭니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = 21c9453e-1f61-91b2-a675-aa3bee510ede
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_GnomeGoblin1_Quest_RecognisedAbsolute = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:21c9453e-1f61-91b2-a675-aa3bee510ede
msgctxt "h3faaeed6g2199g4b5fg9aa3geb0638d66b4a"
msgid ""
"Well... all right, take 'im. But he still counts as my catch, not yours!"
msgstr "그럼... 좋아, 데려가. 하지만 그는 여전히 내가 잡은 거야, 네 놈이 아니라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Player
#. NodeID = 21fa890d-8dc1-acff-2fd8-5d722a4fd2cd
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Dialog:
#.      - WLD_GnomeGoblin1_AbandonNegotiations(2) = True
#.   Object:
#.      - WLD_PriestsOfTheConqueringGod_HasAmulet(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:21fa890d-8dc1-acff-2fd8-5d722a4fd2cd
msgctxt "h881f54dfgb6bcg45e5gad47g1dc8d92cac03"
msgid "We're allies, you and I. Servants of the Absolute."
msgstr "우린 서로 아군이야. 같은 절대자님의 종복이잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Narrator
#. NodeID = 22a3c8e0-4599-b103-dd97-5179198b9a10
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount4(2) = False
#.   Tag:
#.      - TRUESOUL(2) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount4(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:22a3c8e0-4599-b103-dd97-5179198b9a10
msgctxt "hff283206gab9dg4eadg83d2gc343c6bc510f"
msgid ""
"*A shadow swims across your vision, and a familiar voice tells you to be "
"calm. You are loved.*"
msgstr "*그림자가 낀 듯이 눈앞이 흐려지더니, 익숙한 목소리가 당신을 달래줍니다. 사랑이 느껴집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = 22a9539a-cebc-6fc4-c273-d143d0f3c46e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:22a9539a-cebc-6fc4-c273-d143d0f3c46e
msgctxt "hecc78167g8ea5g4c9agb3a6g9a1103b260c7"
msgid ""
"Yehehueh! Enjoyin' yerself? Sun ain't too bright in those beady little eyes?"
msgstr "헤헤헤헤! 재미있냐? 그 조그만 눈깔이 햇살에 눈이 부셔?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Barcus Wroot
#. NodeID = 257eb847-d401-dc1f-3dbf-d8ff0536875f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:257eb847-d401-dc1f-3dbf-d8ff0536875f
msgctxt "h74783680g21cbg4970ga571gbd90328df9f6"
msgid "Stop! Pleeaaase!"
msgstr "그만해! 제에에에발!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Player
#. NodeID = 25a683a3-0bda-37fd-defc-09057e2d2c13
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Script:
#.      - GEN_CheckPocketGold_5 = False
#. SetFlags:
#.   Dialog:
#.     - FOR_GnomeGoblin1_PlayerNonAggressiveOptions(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:25a683a3-0bda-37fd-defc-09057e2d2c13
msgctxt "hd27929c8ga432g4d8ag9358ge5661124cd32"
msgid "I can pay twice that much. I just have to go and fetch it."
msgstr "두 배도 내줄 수 있는데, 지금은 없어서 가지러 가야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Player
#. NodeID = 25c6a681-697f-122e-bc8a-a266e3ef8e98
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 5
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(2) = False
#.   Tag:
#.      - TRUESOUL(2) = False
#.      - ILLITHID(2) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:25c6a681-697f-122e-bc8a-a266e3ef8e98
msgctxt "h19a24277g943dg48c5ga687g535f9c069981"
msgid "I am a True Soul. Your prisoner is now mine."
msgstr "나는 참된 영혼이다. 너의 포로는 이제 내 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Narrator
#. NodeID = 26615ee4-559e-6502-73d3-cbb2c4d9018b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount4(2) = False
#.   Tag:
#.      - TRUESOUL(2) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount4(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:26615ee4-559e-6502-73d3-cbb2c4d9018b
msgctxt "h20a4507ag48e1g4f16gad52g600e45f26776"
msgid ""
"*A shadow swims across your vision, and a familiar voice tells you to be "
"calm. You are loved.*"
msgstr "*그림자가 낀 듯이 눈앞이 흐려지더니, 익숙한 목소리가 당신을 달래줍니다. 사랑이 느껴집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Narrator
#. NodeID = 26a3d816-485d-b33d-1337-6eea46ef8c37
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:26a3d816-485d-b33d-1337-6eea46ef8c37
msgctxt "h5cca6df9gd7c2g429aga481g8a4986fe5535"
msgid ""
"*The mark glows, but you feel nothing in response. Your illithid power is "
"beyond reach until you rest.*"
msgstr "*문양이 빛나지만, 어떤 반응도 느껴지지 않습니다. 일리시드 능력을 더 사용하려면 휴식을 취해야 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Narrator
#. NodeID = 27ec7ef9-6afd-be72-33df-bf9dcd94ca3e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - GLO_TadpoleIntro_NPC(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:27ec7ef9-6afd-be72-33df-bf9dcd94ca3e
msgctxt "h28df3945g8095g41d8gbab1g18093d687b7c"
msgid "*As the symbol glows, power courses through you. <i>Authority.</i>*"
msgstr "*문양이 빛나며, 힘이 당신을 타고 흐릅니다. <i>권위.</i>*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Player
#. NodeID = 28105622-f36c-084c-c0c8-ecc5fc2ac9f8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - WLD_UnfortunateGnome_PayPassage(2) = False
#.   Script:
#.      - GEN_CheckPocketGold_2 = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:28105622-f36c-084c-c0c8-ecc5fc2ac9f8
msgctxt "h10273ccega4cfg484dg9ae1g5a0116389600"
msgid "I'm not haggling with you. Stand down or die."
msgstr "너랑 흥정할 생각 없어. 물러서거나 죽어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = 2844c1df-4283-5d0a-21e1-e3c21885f5ac
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - WLD_GnomeGoblin1_AbandonNegotiations(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:2844c1df-4283-5d0a-21e1-e3c21885f5ac
msgctxt "h591dd9a1g8649g43e2gb11fg59d2988bfa92"
msgid "Hurrh... I reckon we could do better than this runt, aye..."
msgstr "흐으... 저 난쟁이보다 더 나은 놈을 찾아봐야겠군, 그래..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = 2a0efecb-1d26-1dfb-14c6-b627155b90b0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_GnomeGoblinsPacified = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:2a0efecb-1d26-1dfb-14c6-b627155b90b0
msgctxt "h029ed00dg1dcfg448dgab05g71d1d51d6570"
msgid "Erm... ask the pipsqueak on the spinny tower - we're out of here!"
msgstr "음... 회전탑 위에 있는 볼품없는 녀석에게 물어봐 주세요. 우린 여기서 떠나겠습니다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = 2a58e01d-10b9-9abd-4048-ee8c68c97aed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:2a58e01d-10b9-9abd-4048-ee8c68c97aed
msgctxt "he0d9584eg79d9g4edag9eefg3aceb4c5614c"
msgid ""
"I might just look into that... after I'm through squeezin' some gold outta "
"you right now."
msgstr "한번 살펴보도록 하지... 일단 너한테 금화를 쥐어짜내고 나서 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Player
#. NodeID = 2aae0f5f-672b-3dcd-b13c-01462e85fcbb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_CheckPocketGold = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:2aae0f5f-672b-3dcd-b13c-01462e85fcbb
msgctxt "h775e97a7gd455g470bg9f56g833d59db04da"
msgid "<i>Pay the goblin.</i>"
msgstr "<i>고블린에게 돈을 준다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = 2c99bffe-f34f-dba9-9440-d7ee3d09be45
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_GnomeGoblin1_PlayerNonAggressiveOptions(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:2c99bffe-f34f-dba9-9440-d7ee3d09be45
msgctxt "he9af6f20g05dbg4406gbbd5g92a072f2dcb4"
msgid "You picked the wrong time to be cheap..."
msgstr "거저 먹으려는 타이밍을 잘못 잡으셨군..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Narrator
#. NodeID = 2f6bf14f-d850-e0b3-090e-628cfc48265b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount2(2) = False
#.   Tag:
#.      - TRUESOUL(2) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount2(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:2f6bf14f-d850-e0b3-090e-628cfc48265b
msgctxt "hb8aa1639g7769g4fe8g8badgefcada2fe27d"
msgid ""
"*Something stirs deep within you, hungry and alert... it's taking something "
"you'll never get back.*"
msgstr "*몸 깊숙한 데서 굶주리고 기민한 존재가 꿈틀댑니다... 잃으면 되찾지 못할 뭔가를 좀먹고 있군요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = 2fbc617d-e7a6-0242-173e-590b0a176fb5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - f8d20378-d64f-2863-d81e-394cd4a9fa41_HaggleMindBeenRead = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:2fbc617d-e7a6-0242-173e-590b0a176fb5
msgctxt "hc03e1b5bg03d4g44aeg9ec5g07f8bd03a5a1"
msgid "<i>That's a lot of coin. I think.</i>"
msgstr "<i>그거면 많은 돈이겠지. 아마.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Narrator
#. NodeID = 301708c9-2774-3bff-fe4a-330b36355706
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:301708c9-2774-3bff-fe4a-330b36355706
msgctxt "h069b2c6fg9a03g489agb2b4g5adde28cf2d8"
msgid ""
"*The mark glows, but you feel nothing in response. Your illithid power is "
"beyond reach until you rest.*"
msgstr "*문양이 빛나지만, 어떤 반응도 느껴지지 않습니다. 일리시드 능력을 더 사용하려면 휴식을 취해야 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = 3552ab38-4de5-cbed-9377-7a325fa7bc06
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:3552ab38-4de5-cbed-9377-7a325fa7bc06
msgctxt "h30662540g2c4dg4c57ga68cg7348bea0cbbe"
msgid "You... you are blessed, ain't ya? A <i>True Soul</i>?"
msgstr "당신... 당신은 축복받지 않았습니까? <i>참된 영혼</i>이시죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Narrator
#. NodeID = 3599274e-eec2-21d5-374a-c6d2fd4a47bd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - GLO_TadpoleIntro_NPC(2) = False
#. SetFlags:
#.   User:
#.     - GLO_TadpoleIntro_NPC(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:3599274e-eec2-21d5-374a-c6d2fd4a47bd
msgctxt "hb37f96f7gf3bbg4131g8d08gc0bb6e5ceba1"
msgid ""
"*A strange symbol glows, marked on their flesh, and something within you "
"stirs in response.*"
msgstr "*그들의 살갗에 새겨진 기묘한 상징이 빛나고, 이에 반응하여 당신 내면의 무언가가 꿈틀거립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Player
#. NodeID = 35b3a9e2-d1b8-f43f-db08-dd8d6ad78fc4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - WLD_GnomeGoblin1_DrowKeepGoing(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:35b3a9e2-d1b8-f43f-db08-dd8d6ad78fc4
msgctxt "h42fecce7g8558g4ecdgb94fg8f05fc3b9f9e"
msgid "Wait - I haven't dismissed you. Continue the show."
msgstr "기다려 - 난 너를 보내준 적 없어. 쇼를 계속하도록."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Player
#. NodeID = 3947ab7b-c9df-f349-f8f9-4158660cf194
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - WLD_UnfortunateGnome_WhatTheyDoing(2) = True
#. SetFlags:
#.   Dialog:
#.     - WLD_UnfortunateGnome_PayPassage(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:3947ab7b-c9df-f349-f8f9-4158660cf194
msgctxt "h25317083ge088g4179gab90g2103f42e80b8"
msgid "I won't interfere. I just want to pass by."
msgstr "방해하려는 건 아니야. 그냥 지나가고 싶을 뿐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = 3965b6f3-577f-bdeb-d5fe-5dcde25026d4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - WLD_GnomeGoblin1_AbandonNegotiations(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:3965b6f3-577f-bdeb-d5fe-5dcde25026d4
msgctxt "h24bc532dg5d47g465cgb30cg2dcdfed69b08"
msgid "Y'hear that? This one wants us to bugger off so he can poach our prize!"
msgstr "들었냐? 우리 물건을 꿀꺽해야겠으니 여기서 꺼지랍신다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Player
#. NodeID = 3e868254-2c79-4e5a-4302-c6a47bd88952
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - PALADIN(2) = True
#. SetFlags:
#.   Global:
#.     - FOR_UnfortunateGnome_State_NonCharlatanAccess = True
#. TagRule: PALADIN_ANCIENTS
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:3e868254-2c79-4e5a-4302-c6a47bd88952
msgctxt "h155e377fgb220g4a5egaa7fgede9c749263f"
msgid ""
"I am nature's vanguard, you are but a stench on the breeze. <i>Begone</i>."
msgstr "난 대자연의 선봉장이고 넌 바람에 흩날리는 악취일 뿐이야. <i>꺼져버리렴</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Player
#. NodeID = 3e868254-2c79-4e5a-4302-c6a47bd88952
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - PALADIN(2) = True
#. SetFlags:
#.   Global:
#.     - FOR_UnfortunateGnome_State_NonCharlatanAccess = True
#. TagRule: PALADIN_DEVOTION
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:3e868254-2c79-4e5a-4302-c6a47bd88952
msgctxt "h32e4dbfbg8307g4632g9dc7g727fa96e2ace"
msgid ""
"I am duty bound to Virtue itself. <i>You</i> are in my way. Leave this place."
msgstr "난 미덕을 따르는 의무의 화신이다. <i>거슬리게</i> 하지 말고 당장 여기서 떠나라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Player
#. NodeID = 3e868254-2c79-4e5a-4302-c6a47bd88952
#. HandlePath = TaggedText[2].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - PALADIN(2) = True
#. SetFlags:
#.   Global:
#.     - FOR_UnfortunateGnome_State_NonCharlatanAccess = True
#. TagRule: PALADIN_VENGEANCE and NOT_FOR_EA
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:3e868254-2c79-4e5a-4302-c6a47bd88952
msgctxt "h354a1de1g0baeg42f7g8815g7eb281895863"
msgid ""
"I am the fear-dream of disloyal whelps. <i>You</i> are starting to irk me. "
"Leave. "
msgstr "난 버릇없는 햇병아리들의 악몽과도 같은 존재다. <i>감히</i> 말대답을 하다니. 꺼져라. "

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = 40255649-60f0-087e-e550-0eb56ac1ca7d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_UnfortunateGnome_State_NonCharlatanAccess = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:40255649-60f0-087e-e550-0eb56ac1ca7d
msgctxt "hc600de8fg7074g438cg9185g965dded1b800"
msgid ""
"Y-you're a True Soul... I didn't know. Wouldn't dare question you, never!"
msgstr "다-당신은 참된 영혼… 몰랐어요. 감히 당신을 거역할 생각은 절대 아니었어요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = 405ef38a-ccdf-598a-a0ad-60b3ba1abb6c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Absolute_Knows_Symbol = False
#. TagRule: DEEPGNOME or GNOME
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:405ef38a-ccdf-598a-a0ad-60b3ba1abb6c
msgctxt "hf113705bgc5d0g4b54g9a66g00f586d61dd8"
msgid "Not a chance! He's <i>ours</i>!"
msgstr "그럴 일은 없어! 그는 <i>우리 거다</i>!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = 405ef38a-ccdf-598a-a0ad-60b3ba1abb6c
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Absolute_Knows_Symbol = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:405ef38a-ccdf-598a-a0ad-60b3ba1abb6c
msgctxt "hfd5529a8g6011g402fg83ceg41f89e89a820"
msgid "Find your own! He's <i>ours</i>!"
msgstr "네 거나 찾아! 쟤는 <i>우리 거</i>야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = 409065d7-8c3e-566f-cbcb-90d8fa45edae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:409065d7-8c3e-566f-cbcb-90d8fa45edae
msgctxt "h5eef584cg7133g4e33g971fgae4b90bd448b"
msgid "I said we're <i>leaving</i>!"
msgstr "<i>떠난다</i>고 했을 텐데!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Player
#. NodeID = 4106bfcc-4d19-1926-7362-b0d4bdfa89ac
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Script:
#.      - GEN_CheckPocketGold_4 = True
#. SetFlags:
#.   Dialog:
#.     - FOR_GnomeGoblin1_PlayerNonAggressiveOptions(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:4106bfcc-4d19-1926-7362-b0d4bdfa89ac
msgctxt "h7b6935cage903g46b0g98b3g0a08b8ddb6d1"
msgid ""
"That's a ridiculous amount. I'll make you a realistic offer. "
"([GEN_CheckMagicPocketGold_4_5dac5eea-faeb-459c-b675-46c51519b784])"
msgstr ""
"터무니없는 금액이잖아. 내가 현실적인 제의를 하지.([GEN_CheckMagicPocketGold_4_5dac5eea-faeb-"
"459c-b675-46c51519b784])"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = 4206f7de-f80d-cf45-fa63-729bddd4f18f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:4206f7de-f80d-cf45-fa63-729bddd4f18f
msgctxt "h31e86294g3cb4g4326g8536g79d71cd6be23"
msgid "W-what do you want, or, I mean... what do you need?"
msgstr "뭐-뭘 원합니까, 그러니까, 제 말은… 어떤 게 필요하십니까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Player
#. NodeID = 424b3f54-5a02-e88f-7b3e-09fe4902fd9f
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Dialog:
#.      - WLD_GnomeGoblin1_AbandonNegotiations(2) = True
#.   Tag:
#.      - BARBARIAN(2) = False
#. SetFlags:
#.   Dialog:
#.     - FOR_GnomeGoblin1_PlayerNonAggressiveOptions(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:424b3f54-5a02-e88f-7b3e-09fe4902fd9f
msgctxt "hbeb21dacge811g4b78g9b80g4d6729ad588c"
msgid "You've had your fun - it's high time you found someone else to torment."
msgstr "재미있게 놀았으니, 너희는 이제 괴롭힐 다른 사람을 찾을 시간이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Player
#. NodeID = 42cfbd21-98f2-025d-64ba-0385fd6718ac
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Script:
#.      - GEN_CheckPocketGold_3 = True
#. SetFlags:
#.   Dialog:
#.     - FOR_GnomeGoblin1_PlayerNonAggressiveOptions(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:42cfbd21-98f2-025d-64ba-0385fd6718ac
msgctxt "h80c9daddg6ba2g4444g99cbgda9d92841f63"
msgid ""
"Here's my counter-offer: a far more reasonable sum. "
"([GEN_CheckMagicPocketGold_3_01f129ea-b4dc-44b6-8154-9a948f876a82])"
msgstr ""
"내 역제안을 하지: 훨씬 더 합리적인 금액이야. ([GEN_CheckMagicPocketGold_3_01f129ea-b4dc-"
"44b6-8154-9a948f876a82])"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = 44790412-8c27-eec2-fc81-b3ae017c090e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - WLD_FOR_GnomeGoblinsAngry = True
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:44790412-8c27-eec2-fc81-b3ae017c090e
msgctxt "h96174808g2f5ag46eaga63egbe4de9b9a4a9"
msgid "Kill 'im!"
msgstr "죽여!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = 44790412-8c27-eec2-fc81-b3ae017c090e
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Global:
#.     - WLD_FOR_GnomeGoblinsAngry = True
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:44790412-8c27-eec2-fc81-b3ae017c090e
msgctxt "h6ee0b751g464fg4241ga576g2e51836d86d9"
msgid "Kill 'er!"
msgstr "죽여!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = 44790412-8c27-eec2-fc81-b3ae017c090e
#. HandlePath = TaggedText[2].TagText[0]
#. SetFlags:
#.   Global:
#.     - WLD_FOR_GnomeGoblinsAngry = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:44790412-8c27-eec2-fc81-b3ae017c090e
msgctxt "ha9895889g5fd1g4e15gba69g3b8d2eeb6059"
msgid "Kill 'em!"
msgstr "죽여!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = 448df87b-0746-5d15-8aed-93afc4ee0826
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:448df87b-0746-5d15-8aed-93afc4ee0826
msgctxt "h1b6c199cg9e1fg4e0cg9cbcg979cbd59eadd"
msgid "...It's, erm, it's back at our camp. The boss will be expectin' us."
msgstr "...거기가, 음, 저희 야영지 뒷쪽입니다. 대장이 저희를 기다리고 있을겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = 455a3abe-fcd2-0626-a6d1-181f187bb7dc
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:455a3abe-fcd2-0626-a6d1-181f187bb7dc
msgctxt "h1421cea2g97acg40a1g84a1g093090dbb469"
msgid ""
"Erm... well, y'see, sir... I just remembered... our boss - he's the same as "
"you."
msgstr "어... 그게 말이죠... 방금 기억이 났는데... 그게, 저희 대장도 당신과 똑같은 분인데 말이죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = 455a3abe-fcd2-0626-a6d1-181f187bb7dc
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:455a3abe-fcd2-0626-a6d1-181f187bb7dc
msgctxt "h94775908g0f1bg436cg8a70gdef2455935d2"
msgid ""
"Erm... well, y'see, madam... I just remembered... our boss - he's the same "
"as you."
msgstr "어... 그게 말이죠... 방금 기억이 났는데... 그게, 저희 대장도 당신과 똑같은 분인데 말이죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = 455a3abe-fcd2-0626-a6d1-181f187bb7dc
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:455a3abe-fcd2-0626-a6d1-181f187bb7dc
msgctxt "h9ac01848g64ddg4c2fgaccfg59a839274b5c"
msgid ""
"Erm... well, y'see... I just remembered... our boss - he's the same as you."
msgstr "어... 그게 말이죠... 방금 기억이 났는데... 그게, 저희 대장도 당신과 똑같은 분인데 말이죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Narrator
#. NodeID = 479bde57-5fc7-1569-9a49-e10abb06de57
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TRUESOUL(2) = False
#. SetFlags:
#.   Tag:
#.     - TRUESOUL(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:479bde57-5fc7-1569-9a49-e10abb06de57
msgctxt "ha8b511f9g76a9g498cga668g7ad35da1fd56"
msgid ""
"*Your mind is full, bursting with ecstasy and terror. Finally, it is coming. "
"You are becoming.*"
msgstr "*당신의 정신이 황홀경과 공포로 가득 차오릅니다. 마침내, 때가 됐군요. 당신은 변화 중입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Player
#. NodeID = 48237ebb-d02e-3856-2fb3-ed4d9743761d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - BRANDED(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:48237ebb-d02e-3856-2fb3-ed4d9743761d
msgctxt "h45b36c7cg4856g47b2g859cg5862b31e5c5e"
msgid ""
"<i>Show him your brand and say you're taking the gnome. The Absolute wills "
"it.</i>"
msgstr "<i>낙인을 보여주고 노움을 데려간다고 말한다. 절대자의 뜻이다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = 4993fbad-31ac-51cd-7a0b-c69e51f64064
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:4993fbad-31ac-51cd-7a0b-c69e51f64064
msgctxt "h82a5b370g0eaeg4cdegb393g898ee9945b3b"
msgid ""
"We're gettin' gold from you even if we 'ave to take the fillings from your "
"teeth!"
msgstr "돈이 없으면 네놈 이빨에 박힌 금이라도 뗴어가야겠다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Player
#. NodeID = 4af46a1c-704b-5ebf-a591-19b04ffde895
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 5
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(2) = False
#.   Tag:
#.      - TRUESOUL(2) = False
#.      - ILLITHID(2) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:4af46a1c-704b-5ebf-a591-19b04ffde895
msgctxt "hab0482d5g6121g45a9gafdega92bcb11d824"
msgid "I'm going to pay nothing, and you and your cronies are going to leave."
msgstr "난 한 푼도 내지 않을 거야. 그리고 너와 네 무리는 떠나도록 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Player
#. NodeID = 4c45b91b-a5e2-5193-19c8-cb1854efbde9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:4c45b91b-a5e2-5193-19c8-cb1854efbde9
msgctxt "h42f8c941geab6g42d8g9dbcg3d9eba40d48d"
msgid ""
"An explanation - tell me what you're doing with that deep gnome, at once."
msgstr "설명. 그 딥 노움으로 무엇을 하고 있는지 당장 말해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = 4ca8b7da-3235-1c2e-7f50-7855d8bd78d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:4ca8b7da-3235-1c2e-7f50-7855d8bd78d9
msgctxt "h5776ffcfg62acg4791g9dedg3d1f08573603"
msgid ""
"Bah, now you've gone and spoiled the fun. I like it better when they've got "
"some fight in 'em."
msgstr "에이, 너 때문에 흥이 떨어졌잖아. 난 투지가 있는 녀석을 상대하고 싶다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Narrator
#. NodeID = 4d9d6472-6ce1-20c9-57de-65bc1fe6f9f6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount3(2) = False
#.   Tag:
#.      - TRUESOUL(2) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount3(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:4d9d6472-6ce1-20c9-57de-65bc1fe6f9f6
msgctxt "h93351cd9ge4bdg4247gb916gcb565056d545"
msgid "*Your mind lurches, reeling suddenly as if... bitten.*"
msgstr "*뭔가에 깨물린 것처럼 느닷없이 정신이 휘청거립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Narrator
#. NodeID = 4e0b96fb-15eb-cd6f-d965-9ad6d147915f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount1(2) = False
#.   Tag:
#.      - TRUESOUL(2) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount1(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:4e0b96fb-15eb-cd6f-d965-9ad6d147915f
msgctxt "h857ec4a1g2563g47e5g89c3gf7e2d8112133"
msgid "*A shiver runs across your mind... You feel sated.*"
msgstr "*전율이 불현듯 머릿속을 스쳐 지나가고... 만족감이 듭니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Narrator
#. NodeID = 4e3f209a-260a-71fd-eb3a-d19e97c60b49
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FOR_GnomeGoblin1_HasMet(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:4e3f209a-260a-71fd-eb3a-d19e97c60b49
msgctxt "hfecf20cegadbag418dgaca3ga4e604952736"
msgid "*The goblin seems unsure whether to bow to you or attack.*"
msgstr "*이 고블린은 당신을 공격해야 할지, 당신에게 절을 해야 할지 헷갈리는 듯합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Player
#. NodeID = 4e49d597-3c2a-fa0a-0063-a14075cd8b3f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - WLD_UnfortunateGnome_WhatTheyDoing(2) = False
#. SetFlags:
#.   Dialog:
#.     - WLD_UnfortunateGnome_WhatTheyDoing(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:4e49d597-3c2a-fa0a-0063-a14075cd8b3f
msgctxt "hcc77ae3dgdb42g4ac0g9a68ge82ca1fb011e"
msgid "What the hells are you doing?"
msgstr "대체 무슨 짓이야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Player
#. NodeID = 4e6cf7c6-1e1c-3dee-5703-a971dbe78ce2
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 0
#. CheckFlags:
#.   Local:
#.      - f8d20378-d64f-2863-d81e-394cd4a9fa41_HaggleMindBeenRead = False
#.   Script:
#.      - GEN_CanDetectThoughts_3 = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:4e6cf7c6-1e1c-3dee-5703-a971dbe78ce2
msgctxt "h34c7f3d8g3797g40f7ga8dfg09a5b102a02e"
msgid "<i>Read the goblin's mind.</i>"
msgstr "<i>고블린의 생각을 읽는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = 512c919e-dcb8-6334-c193-24e5c0cdb9cb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GOBLIN(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:512c919e-dcb8-6334-c193-24e5c0cdb9cb
msgctxt "hd6abc4e5g9ddfg4d29g9d9fgd54f80133af0"
msgid "We're leaving."
msgstr "우린 떠난다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = 536b8bf0-d2f9-cb2a-dba0-9397599f2fd3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_UnfortunateGnome_State_NonCharlatanAccess = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:536b8bf0-d2f9-cb2a-dba0-9397599f2fd3
msgctxt "h097a566ag93bcg4823gb878g84fc80406d2c"
msgid "Oofh! That's a... a big bloody sack o' gold. <i>Neheuhuerh...</i>"
msgstr "우와! 그것 참... 엄청난 양의 금화로군. <i>느헤헤헤헤...</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Player
#. NodeID = 53b1d208-96b4-f99f-da84-7068cf29c667
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
