msgctxt "h697c0f33gcb9bg4722ga0e7g1d807f71c717"
msgid "Can't get any privacy around here..."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = caa86280-0887-f083-75dd-b2e0a41a879a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:caa86280-0887-f083-75dd-b2e0a41a879a
msgctxt "h7d6b2e2bg066fg4261gb2c2gb032f5ee1015"
msgid "<i>Sever the connection.</i>"
msgstr "<i>연결을 끊는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = caef3f84-adde-fe9a-3f51-2a1f3747fb2f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:caef3f84-adde-fe9a-3f51-2a1f3747fb2f
msgctxt "h7d1a8068gcce8g4d40ga176g6b90c83c9084"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = cca2a183-2595-8b0a-7046-af387872670f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:cca2a183-2595-8b0a-7046-af387872670f
msgctxt "h912123a9gc468g4cb9gb77dg3f2d53af2f47"
msgid "<i>Allow her to rummage through your memories.</i>"
msgstr "<i>그녀가 자신의 기억을 헤집도록 허락한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = cd70aa48-0086-5167-0397-10602167779b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:cd70aa48-0086-5167-0397-10602167779b
msgctxt "hfceb5fa8g0420g4703ga65cgb4477fb124b3"
msgid "Let me take a closer look. I ain't seen anything like this before."
msgstr "내가 더 자세히 살펴보겠다. 전에는 이런 것을 본 적이 없거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = cdff81ac-58e6-5af0-8555-9d84f2cd91a4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_GoblinPriest_PrivateMeeting(1) = False
#.      - GOB_GoblinPriest_AcceptedHelp(1) = False
#.   Global:
#.      - GOB_GoblinPriest_AskedForPrivacy = True
#.   Object:
#.      - GOB_GoblinPriest_PlayerAcceptedHelp(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:cdff81ac-58e6-5af0-8555-9d84f2cd91a4
msgctxt "hc6909896g2f0fg49b0ga3b0gfd690fae365d"
msgid ""
"One of your mates asked to talk in private, so here we are. What's botherin' "
"you?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = d23c4cdc-0399-548f-4b10-c3d5c09e0553
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = False
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:d23c4cdc-0399-548f-4b10-c3d5c09e0553
msgctxt "hf2ce9265g26f5g4d95gb331g46e6acc04da4"
msgid "I'm a prodigious murderer, and I'm going to treat you to my brilliance."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = d2eb16ca-c5e2-6c7a-9cfe-b268553551f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:d2eb16ca-c5e2-6c7a-9cfe-b268553551f5
msgctxt "hc79b219ag4b16g4295gbad6ga2dd592cc19a"
msgid "<i>Push deeper into her mind.</i>"
msgstr "<i>그녀의 정신을 더 깊이 파고든다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = d33bfa40-5576-4c66-89f6-77e1639b9ad4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:d33bfa40-5576-4c66-89f6-77e1639b9ad4
msgctxt "hcf517679gc67fg4d08ga224g64acbc0fe20d"
msgid "You won't regret this."
msgstr "넌 후회하지 않을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = d40d4250-f08e-cc3f-2fa0-666a5bea793c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:d40d4250-f08e-cc3f-2fa0-666a5bea793c
msgctxt "h5ce5bc4aged39g483ag9d8dg2cb80378312e"
msgid ""
"But there's no secrets between us, True Soul. Lemme take a look and find out "
"what it did to you."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = de7c14aa-5688-2335-589e-cd5503e18fba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:de7c14aa-5688-2335-589e-cd5503e18fba
msgctxt "h318d0c23g9615g4d24gbd19gc813120d2b33"
msgid "You've come to the right place."
msgstr "넌 제대로 찾아온 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = dee40b59-7e25-1c79-7464-c5093ac427fd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_GoblinPriest_AcceptedHelp(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:dee40b59-7e25-1c79-7464-c5093ac427fd
msgctxt "hf2778a6fgec64g4ebfgab51g5efc8e627a16"
msgid "With the Absolute's will, I can fix <i>anything</i>."
msgstr "절대자님의 의지로, 난 <i>뭐든</i>고칠 수 있다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = e014ac9d-6021-ff4b-eced-5f5249c06dc1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:e014ac9d-6021-ff4b-eced-5f5249c06dc1
msgctxt "haa8fdf95gbba6g4a79gb5adg0db634f132f5"
msgid "What exactly does your plan involve?"
msgstr "네 계획이 정확히 뭔데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = e5ebdc47-7cb6-f891-9827-a13e8f2f8882
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:e5ebdc47-7cb6-f891-9827-a13e8f2f8882
msgctxt "h4ea4e664gaaaag4d70gbc03g95a43cd0682e"
msgid ""
"Priestess Gut needs to touch you, too. Hold out your arm so I can mark you."
msgstr "여사제 거트께서도 널 만져야겠어. 표식을 새겨줄 테니, 팔을 뻗어봐라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = ead6dc58-84df-ba0f-6249-a0a61c151ff8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_GoblinPriest_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_GoblinPriest_HasMet(1) = True
#.   Global:
#.     - GLO_Absolute_Knows_Name = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:ead6dc58-84df-ba0f-6249-a0a61c151ff8
msgctxt "h21c115d9g2b47g4bebg9b02g1b0beb70a130"
msgid ""
"Another special visitor. You've been touched by the Absolute, haven't you?"
msgstr "또 하나의 특별한 방문객이로군. 절대자님의 은총을 받지 않았니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = ee28cc4a-64ad-a60b-4011-761892e302dd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:ee28cc4a-64ad-a60b-4011-761892e302dd
msgctxt "hb397b8e0gc8a5g4d12gb808g408d3f51db2f"
msgid "Do whatever you have to. Just get rid of it."
msgstr "필요한 건 뭐든지 해. 그걸 제거해 주기만 하면 돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = ef10cbcb-3c4c-64c5-52f5-ff934473b9b8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:ef10cbcb-3c4c-64c5-52f5-ff934473b9b8
msgctxt "h5da30917g0563g47c6g83ccgc4781768eb30"
msgid "No need to panic, though."
msgstr "하지만 걱정할 것 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = f36902ea-8121-b7d7-b21d-688a07677907
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:f36902ea-8121-b7d7-b21d-688a07677907
msgctxt "hacc494b2gbd2ag4ea7gae94g74029af94ee9"
msgid "I guess we're doing this the hard way, then."
msgstr "그럼 번거로운 방법으로 이 일을 처리해야겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
