msgctxt "hbda4801cgeefag43dbg8116g987a9e6e40ea"
msgid "Quick - hide! Everyone!"
msgstr "빨리- 숨어! 다들!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ParentA
#. Speaker = Locke
#. NodeID = ff651706-2d14-3cd7-83ae-534f7b6dee3a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 7ffcf0de-e30b-ef58-fcc5-8d3a1482fa59_b = True
#.      - 7ffcf0de-e30b-ef58-fcc5-8d3a1482fa59_a = True
#. SetFlags:
#.   Local:
#.     - 7ffcf0de-e30b-ef58-fcc5-8d3a1482fa59_b = False
#.     - 7ffcf0de-e30b-ef58-fcc5-8d3a1482fa59_a = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ParentA:ff651706-2d14-3cd7-83ae-534f7b6dee3a
msgctxt "haecf8dc8gd78bg4de1g8b85g6e9fc2b1ceba"
msgid "Stay close. We'll get through this."
msgstr "바짝 붙어. 우린 해낼거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ParentsAfterAttack
#. Speaker = Locke
#. NodeID = 0094319d-80ae-d9df-b631-9426891ae9c8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 698f5a3b-6d88-3d9e-ee4f-26d9c1fc5b6b_A = True
#. SetFlags:
#.   Local:
#.     - 698f5a3b-6d88-3d9e-ee4f-26d9c1fc5b6b_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ParentsAfterAttack:0094319d-80ae-d9df-b631-9426891ae9c8
msgctxt "h0220893dged8bg4d50g8743gaacbcb3b8cd8"
msgid "Think she'll be all right with the other kids?"
msgstr "다른 아이들과 함께 잘 있겠지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ParentsAfterAttack
#. Speaker = Locke
#. NodeID = 0c19bb07-ba5f-4692-ea4d-50c968ccefef
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 698f5a3b-6d88-3d9e-ee4f-26d9c1fc5b6b_B = True
#. SetFlags:
#.   Local:
#.     - 698f5a3b-6d88-3d9e-ee4f-26d9c1fc5b6b_B = False
#.     - 698f5a3b-6d88-3d9e-ee4f-26d9c1fc5b6b_A = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ParentsAfterAttack:0c19bb07-ba5f-4692-ea4d-50c968ccefef
msgctxt "hed780489g43abg4274gbdfbgcabb197016aa"
msgid "Mol isn't exactly my first choice as a guardian."
msgstr "몰을 믿고 맡겨도 좋을지 모르겠소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ParentsAfterAttack
#. Speaker = Komira
#. NodeID = 0c7a760a-9bff-6551-a537-42d6ea592d6e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#.   Local:
#.      - 698f5a3b-6d88-3d9e-ee4f-26d9c1fc5b6b_C = True
#. SetFlags:
#.   Local:
#.     - 698f5a3b-6d88-3d9e-ee4f-26d9c1fc5b6b_C = False
#.     - 698f5a3b-6d88-3d9e-ee4f-26d9c1fc5b6b_B = False
#.     - 698f5a3b-6d88-3d9e-ee4f-26d9c1fc5b6b_A = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ParentsAfterAttack:0c7a760a-9bff-6551-a537-42d6ea592d6e
msgctxt "h5bf59e8ega6b8g413cga668gb0d856737217"
msgid "Locke. I can't do this."
msgstr "로크. 난 못하겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ParentsAfterAttack
#. Speaker = Locke
#. NodeID = 159b23fb-c72f-093c-7a3d-eb58d9771a81
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ParentsAfterAttack:159b23fb-c72f-093c-7a3d-eb58d9771a81
msgctxt "habe2c72bg298cg4135g8272g241f14d4c9c9"
msgid "Better there than here."
msgstr "여기 있는 것보단 나아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ParentsAfterAttack
#. Speaker = Komira
#. NodeID = 1bd1abf0-7ad9-c2d2-a752-fae7709b1db9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ParentsAfterAttack:1bd1abf0-7ad9-c2d2-a752-fae7709b1db9
msgctxt "h4012417ag4148g472dg8d27ga7654460583d"
msgid "I miss her too."
msgstr "나도 보고 싶어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ParentsAfterAttack
#. Speaker = Locke
#. NodeID = 204fc4b7-d6d5-2bde-6bb5-949f2236c6b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ParentsAfterAttack:204fc4b7-d6d5-2bde-6bb5-949f2236c6b4
msgctxt "hd3175e75g4884g457cg906agaecf0eca80e4"
msgid "Our baby's gone. There could <i>never </i>be a point."
msgstr "우리 애가 죽었소. 의미 있는 일은 <i>절대</i> 있을 수 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ParentsAfterAttack
#. Speaker = Locke
#. NodeID = 31f901e1-1f6e-3f1d-c27c-17da016a4fd8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ParentsAfterAttack:31f901e1-1f6e-3f1d-c27c-17da016a4fd8
msgctxt "h3862b668g0238g4d41g8e72g77278bcae25e"
msgid "We have to."
msgstr "해야만 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ParentsAfterAttack
#. Speaker = Komira
#. NodeID = 3751077a-c32a-7229-c5c4-e5b7ce953b47
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ParentsAfterAttack:3751077a-c32a-7229-c5c4-e5b7ce953b47
msgctxt "hd82ddc1fg6be2g450fg8070g78d8cdde5f7d"
msgid ""
"Goblins are ruthless, but have you <i>met </i>that kid? She'll look after "
"Arabella. No doubt."
msgstr "물론 고블린은 사납죠. 하지만 그 아이를 <i>만나보긴</i> 했습니까? 틀림없이 아라벨라를 잘 지켜줄 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ParentsAfterAttack
#. Speaker = Komira
#. NodeID = 46d450ef-8df4-4c8a-76fb-5b269fe2f7ec
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#. SetFlags:
#.   Local:
#.     - 698f5a3b-6d88-3d9e-ee4f-26d9c1fc5b6b_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ParentsAfterAttack:46d450ef-8df4-4c8a-76fb-5b269fe2f7ec
msgctxt "h09824af8gf0f7g4e1fg897dg71e7eb58810f"
msgid "Pointless. This is all pointless."
msgstr "의미 없어. 이런 거 다 의미 없다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ParentsAfterAttack
#. Speaker = Komira
#. NodeID = 871daa61-8ce4-2870-b047-51baa92c95f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ParentsAfterAttack:871daa61-8ce4-2870-b047-51baa92c95f5
msgctxt "hc2d66436gcdc0g4ce6ga2b0gce9d3f342ef4"
msgid "Mol will keep an eye on her."
msgstr "몰이 잘 돌봐줄 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ParentsAfterAttack
#. Speaker = Komira
#. NodeID = 92bff089-dfef-02d1-aabf-3e0f99ef0be0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 698f5a3b-6d88-3d9e-ee4f-26d9c1fc5b6b_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ParentsAfterAttack:92bff089-dfef-02d1-aabf-3e0f99ef0be0
msgctxt "h95dae0dbg1704g49f8gacb0g93017398d326"
msgid "Arabella is holed up with the others."
msgstr "아라벨라는 다른 아이들하고 숨어 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ParentsAfterAttack
#. Speaker = Komira
#. NodeID = 9d0e0329-c307-0fd6-80ec-152046c48b13
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#.   Local:
#.      - 698f5a3b-6d88-3d9e-ee4f-26d9c1fc5b6b_A = True
#. SetFlags:
#.   Local:
#.     - 698f5a3b-6d88-3d9e-ee4f-26d9c1fc5b6b_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ParentsAfterAttack:9d0e0329-c307-0fd6-80ec-152046c48b13
msgctxt "h4a18e089g2d4eg4bd6ga16dg43648cfde4d3"
msgid "Do you think she's watching us?"
msgstr "우리 딸이 우릴 지켜보고 있을까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ParentsAfterAttack
#. Speaker = Locke
#. NodeID = a383f868-4e9a-e2a4-d39b-b8db841bf02b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#.   Local:
#.      - 698f5a3b-6d88-3d9e-ee4f-26d9c1fc5b6b_B = True
#. SetFlags:
#.   Local:
#.     - 698f5a3b-6d88-3d9e-ee4f-26d9c1fc5b6b_C = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ParentsAfterAttack:a383f868-4e9a-e2a4-d39b-b8db841bf02b
msgctxt "hb1191f58g5104g4cf5g85bbgd5affaeb2cbb"
msgid "Let the bloody goblins take us. I miss my baby."
msgstr "고블린들이 우릴 죽이건 말건... 난 내 딸이 보고 싶어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ParentsAfterAttack
#. Speaker = Locke
#. NodeID = b97d4b44-add6-8a48-9eea-18c311280015
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ParentsAfterAttack:b97d4b44-add6-8a48-9eea-18c311280015
msgctxt "h6c2882c2g078fg4ffdg848ag5c7eb6822ec1"
msgid "I don't know anything. Not anymore."
msgstr "이젠 아무것도 모르겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ProtestersAfterAttack
#. Speaker = Rechel
#. NodeID = 064c72f7-8276-eab3-109c-b4875aaf3eec
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 1493763b-776c-959c-259a-89f34f326e04_A = False
#. SetFlags:
#.   Local:
#.     - 1493763b-776c-959c-259a-89f34f326e04_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ProtestersAfterAttack:064c72f7-8276-eab3-109c-b4875aaf3eec
msgctxt "h2e635fefgaad0g4edfg94ffgf8fe8395edf8"
msgid "What a disaster."
msgstr "대참사로군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ProtestersAfterAttack
#. Speaker = Amek
#. NodeID = 2d6cc7b9-2ecc-82be-04d2-427bd3142e70
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ProtestersAfterAttack:2d6cc7b9-2ecc-82be-04d2-427bd3142e70
msgctxt "h40e0b741gb408g4358g9243g576d566d3a87"
msgid "Couldn't be helped. Those druids left us no choice."
msgstr "어쩔 수가 없었어. 이 드루이드들은 우리 선택의 여지를 남겨두지 않았다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ProtestersAfterAttack
#. Speaker = Rechel
#. NodeID = 37321e02-b00f-602f-7e73-5f0c5c9bb9c5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ProtestersAfterAttack:37321e02-b00f-602f-7e73-5f0c5c9bb9c5
msgctxt "h7e607929g48d5g4a84g97dcg8014594ac810"
msgid ""
"Druids, goblins... and then what? There'll be other things looking to kill "
"us. There always is."
msgstr "드루이드, 고블린... 다음은 또 뭐야? 또 다른 놈들이 우리를 죽이려 하겠지. 항상 그랬으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ProtestersAfterAttack
#. Speaker = Xeph
#. NodeID = 38e75636-0285-ded0-2752-fdf1651e89a1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 1493763b-776c-959c-259a-89f34f326e04_B = True
#.      - 1493763b-776c-959c-259a-89f34f326e04_A = True
#. SetFlags:
#.   Local:
#.     - 1493763b-776c-959c-259a-89f34f326e04_B = False
#.     - 1493763b-776c-959c-259a-89f34f326e04_A = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ProtestersAfterAttack:38e75636-0285-ded0-2752-fdf1651e89a1
msgctxt "h8a5caf3eg2838g4c5fg849eg0f63725e9709"
msgid "Still got to face the goblins before we can go anywhere."
msgstr "어쨌거나 다른 곳으로 가려면 결국 고블린과 맞서야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ProtestersAfterAttack
#. Speaker = Amek
#. NodeID = 482447e7-f014-cb63-fef7-d232cde86491
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 1493763b-776c-959c-259a-89f34f326e04_B = False
#.      - 1493763b-776c-959c-259a-89f34f326e04_A = True
#. SetFlags:
#.   Local:
#.     - 1493763b-776c-959c-259a-89f34f326e04_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ProtestersAfterAttack:482447e7-f014-cb63-fef7-d232cde86491
msgctxt "hf78292a4gbbf2g4d07g92f0g1162683c8d39"
msgid "I wonder what'll happen to this place now...?"
msgstr "이제 여기는 어떻게 되는 걸까...?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ProtestersAfterAttack
#. Speaker = Xeph
#. NodeID = a8d7992a-7607-524d-e525-f2d7f0439898
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ProtestersAfterAttack:a8d7992a-7607-524d-e525-f2d7f0439898
msgctxt "h850085fcgb961g4574g8ec7g7c5aa04f5157"
msgid ""
"It can rot for all I care. The sooner we can safely leave this place behind, "
"the better."
msgstr "그냥 확 썩어버리라지. 최대한 빨리 여기를 무사히 떠나는 데나 집중하자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_RangerTraderLootingAfterAttack
#. Speaker = Eramas
#. NodeID = 1808b22e-72e5-b538-6133-6cec6051b098
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 9aa2b35c-a27b-5b66-335f-282daf0b7940_C = True
#. SetFlags:
#.   Local:
#.     - 9aa2b35c-a27b-5b66-335f-282daf0b7940_B = False
#.     - 9aa2b35c-a27b-5b66-335f-282daf0b7940_C = False
#.     - 9aa2b35c-a27b-5b66-335f-282daf0b7940_A = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_RangerTraderLootingAfterAttack:1808b22e-72e5-b538-6133-6cec6051b098
msgctxt "h8c8b1d40g28c5g4645g9b43g2fca178cfa02"
msgid "At least this looks sharp."
msgstr "적어도 이건 괜찮아 보이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_RangerTraderLootingAfterAttack
#. Speaker = Eramas
#. NodeID = 1e1947f0-dc17-cf4c-d491-943bc4b89eac
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 9aa2b35c-a27b-5b66-335f-282daf0b7940_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_RangerTraderLootingAfterAttack:1e1947f0-dc17-cf4c-d491-943bc4b89eac
msgctxt "h333b0d6cg943bg4cfegb634gfbca8c71686d"
msgid "I can't believe they just left this all behind."
msgstr "이걸 전부 두고 가다니 믿을 수 없군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_RangerTraderLootingAfterAttack
#. Speaker = Eramas
#. NodeID = 9134771c-fdbd-01fd-7034-8ae5ac0647ef
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 9aa2b35c-a27b-5b66-335f-282daf0b7940_B = True
#. SetFlags:
#.   Local:
#.     - 9aa2b35c-a27b-5b66-335f-282daf0b7940_C = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_RangerTraderLootingAfterAttack:9134771c-fdbd-01fd-7034-8ae5ac0647ef
msgctxt "h3fac06b0gfc9fg444ega766g8dad4ed73fff"
msgid "Gah! When was the last time these were washed?"
msgstr "으윽! 도대체 이 자식들이 마지막으로 씻은 게 언제야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_RangerTraderLootingAfterAttack
#. Speaker = Eramas
#. NodeID = d3a7aae3-4fde-2c8c-0ae9-abe9c77dc1f6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 9aa2b35c-a27b-5b66-335f-282daf0b7940_A = True
#. SetFlags:
#.   Local:
#.     - 9aa2b35c-a27b-5b66-335f-282daf0b7940_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_RangerTraderLootingAfterAttack:d3a7aae3-4fde-2c8c-0ae9-abe9c77dc1f6
msgctxt "h68c490a3g1b7ag43d6gbbbfg5d6eca6eb351"
msgid "There <i>has</i> to be something useful in here."
msgstr "뭔가 쓸만한 게 여기 <i>있었을</i> 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_Refugee004
#. Speaker = Toron
#. NodeID = 241fcf66-f63f-75c2-ac22-d24134f6ef06
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - d97f72ff-8fb1-8a4c-f169-89751bd6e125_b = False
#.      - d97f72ff-8fb1-8a4c-f169-89751bd6e125_a = True
#. SetFlags:
#.   Local:
#.     - d97f72ff-8fb1-8a4c-f169-89751bd6e125_b = True
