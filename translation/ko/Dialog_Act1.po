#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_State_SavedAnimal = False
#.      - ORI_Shadowheart_State_IncurableWound_Unavailable = False
#.      - GLO_Not_For_EA = True
#.   Tag:
#.      - AVATAR(1) = True
#.      - REALLY_SHADOWHEART(1) = True
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_State_SavedAnimal = True
#.     - ORI_Shadowheart_Event_IncurableWoundFlared = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_OwlBear_LastCub:e461a4ec-4f68-4280-9a6c-443a5ecc2b2f
msgctxt "h0f2e451dg3ab1g4c04g9accg7ae6d6fba098"
msgid ""
"*Searing pain erupts from the wound on your hand. A strange, half-familiar "
"image comes to you: a dead mouse, seen through a veil of tears - <i>your </"
"i>tears. The image fades.*"
msgstr ""
"*타는 듯한 고통이 당신 손 위 상처에서 터져나옵니다. 이상하지만 반쯤 친숙한 심상이 당신에게 떠오릅니다. 죽은 쥐가 눈물 장막 너머로 "
"보입니다. <i>당신의</i> 눈물입니다. 심상이 사라집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_OwlBear_LastCub
#. Speaker = Narrator
#. NodeID = ec853132-bc97-75e8-b09c-366bde39fcf8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - ab98ba0b-432b-9a79-1b10-514ee6454278_DidPDD = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_OwlBear_LastCub:ec853132-bc97-75e8-b09c-366bde39fcf8
msgctxt "hfaf757aag5cf7g401fg8525g25cf2444927d"
msgid "*The cub looks from you to his dead mother.*"
msgstr "*새끼는 당신을 보더니 죽은 어미 쪽으로 고개를 돌립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_OwlBear_LastCub
#. Speaker = Shadowheart
#. NodeID = f22e8592-772a-4b71-8989-2d23162dd9d3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_State_SavedAnimal = False
#.      - ORI_Shadowheart_State_IncurableWound_Unavailable = False
#.      - GLO_Not_For_EA = True
#. SetFlags:
