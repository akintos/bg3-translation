msgctxt "h8636bd4dga45dg4765gac06gac6550f79cf4"
msgid "*The rothé tenses, then nods.*"
msgstr "*로테가 긴장하더니, 고개를 끄덕입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_002
#. Speaker = Player
