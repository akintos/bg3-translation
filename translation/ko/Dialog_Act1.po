msgctxt "h5756a04bgbe03g48b8g9198g3c4851dc1d5c"
msgid "This is only the beginning. An army soon crosses the coast."
msgstr "이건 시작에 불과해. 곧 군대가 해안을 가로지를 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidLeader
#. Speaker = Kagha
#. NodeID = 9c35195f-55b1-d35f-f977-0aa85f34dc61
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidLeader:9c35195f-55b1-d35f-f977-0aa85f34dc61
msgctxt "hd008405dg665dg4cb6gad9fg7d5c1ad32a7e"
msgid "Silvanus willing, we might heal before then."
msgstr "실바누스께서 우릴 구원하신다면, 그 전에 치유 할 수 있을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidLeader
#. Speaker = Kagha
#. NodeID = a31899c0-fd47-6c9f-509e-d723c5ea719d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidLeader:a31899c0-fd47-6c9f-509e-d723c5ea719d
msgctxt "h5e587203g915cg486bga63dga537dce43053"
msgid ""
"We will execute the Rite of Thorns, and you will give no more complaint. In "
"fact..."
msgstr "우리는 가시의 의식을 수행할 것이야. 더 이상 불평하지 말도록 해. 그리고..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidLeader
#. Speaker = Kagha
#. NodeID = aefe1071-8814-e8b5-5882-ae61145da315
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidLeader:aefe1071-8814-e8b5-5882-ae61145da315
msgctxt "h5fec6c54gc6d6g4d81g8ccbge5fda4d86984"
msgid "...you will be gone before the sun next sets on the grove."
msgstr "...너는 내일 해가 뜨기 전에 숲을 떠나도록 할 것이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_DruidLeader
