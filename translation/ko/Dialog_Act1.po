msgctxt "h2f4571b1g304eg4a2aga7a5gbaef0ba0dfa8"
msgid "Come now, Mayrina! Time to go."
msgstr "이리 오렴, 메이리나! 갈 시간이란다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_AD_TeleportSurrogateMother
