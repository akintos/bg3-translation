#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_PAD_TunnelBlocked:a2554fa0-4fb3-40ca-acc5-3262b7def704
msgctxt "h06864ff7ge18fg4935g8293g16c650b269f1"
msgid "Blocked. Nothing a quick blast of magic won't clear."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_PAD_TunnelBlocked
#. Speaker = Player
#. NodeID = a2554fa0-4fb3-40ca-acc5-3262b7def704
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_PAD_TunnelBlocked:a2554fa0-4fb3-40ca-acc5-3262b7def704
msgctxt "h4c726654g3070g4cd5g8a36gac964fb222d2"
msgid "Tunnel's still blocked. It'll take a bit more effort to clear it."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_PAD_TunnelBlocked
#. Speaker = Player
#. NodeID = a2554fa0-4fb3-40ca-acc5-3262b7def704
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_PAD_TunnelBlocked:a2554fa0-4fb3-40ca-acc5-3262b7def704
msgctxt "h40506f50g6292g4286g9d2egd9d841e1e133"
msgid "Still blocked. But shouldn't take much effort to clear it."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_PAD_TunnelBlocked
#. Speaker = Player
#. NodeID = a2554fa0-4fb3-40ca-acc5-3262b7def704
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_PAD_TunnelBlocked:a2554fa0-4fb3-40ca-acc5-3262b7def704
msgctxt "h41c52078g37b5g4b47ga5ceg17832d6a0f3f"
msgid "Blocked. I need a bit of extra harumph."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_PAD_TunnelBlocked
#. Speaker = Player
#. NodeID = a2554fa0-4fb3-40ca-acc5-3262b7def704
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_PAD_TunnelBlocked:a2554fa0-4fb3-40ca-acc5-3262b7def704
msgctxt "haf38d949g641bg4baag82f0gaa9ea9076d89"
msgid "Still blocked - but should be easy enough to clear."
msgstr "여전히 막혔군. 그렇지만 충분히 쉽게 정리할 수 있겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_Tunnel
#. Speaker = Narrator
#. NodeID = 6d328f21-dac3-4575-8741-dc7fcc5df149
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_Tunnel:6d328f21-dac3-4575-8741-dc7fcc5df149
msgctxt "h1dc919e3g9ad2g494cg98a2gcd7255807196"
msgid "*Decaying legs protrude from the hole - a failed escape, it seems.*"
msgstr "*부패한 다리가 구멍에서 튀어나와 있습니다. 실패한 탈출의 흔적 같군요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_Tunnel
#. Speaker = Player
#. NodeID = 9821d7cc-6219-d72c-d91b-4865b4b025ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_Tunnel:9821d7cc-6219-d72c-d91b-4865b4b025ac
msgctxt "h90770ab7gb088g444bgaaefg57831c768bb1"
msgid "<i>Pull the body free.</i>"
msgstr "<i>시체를 끌어낸다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_Tunnel
#. Speaker = Narrator
#. NodeID = 9da63ac8-6cd6-4376-8279-71564d41a994
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_PrisonEscape_State_BodyIsFree = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_Tunnel:9da63ac8-6cd6-4376-8279-71564d41a994
msgctxt "h16a8e5cbg588dg4a1cga51dg3362d401a44e"
msgid ""
"*The body comes loose, revealing a tunnel. Perhaps you can escape where he "
"failed.*"
msgstr "*시체가 끌려 나오자, 땅굴이 드러납니다. 그는 실패했지만, 당신이라면 성공할지도 모릅니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_Tunnel
#. Speaker = Narrator
#. NodeID = a75d1b42-3eac-4428-8b85-14f196e49c12
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_PrisonEscape_NoticedHeart = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_Tunnel:a75d1b42-3eac-4428-8b85-14f196e49c12
msgctxt "h96efaab1g708eg4d97g8462gc439e630681b"
msgid ""
"*It seems the tunnel collapsed mid-dig and suffocated him. A crooked heart "
"is embroidered on his left shoe.*"
msgstr "*땅굴을 파던 중 무너져 그 속에서 질식한 것 같습니다. 그의 왼쪽 신발에는 비뚤어진 심장이 수놓아져 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_Tunnel
#. Speaker = Player
#. NodeID = da125714-c3b7-b1d4-081d-941b176bf550
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 5
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_Tunnel:da125714-c3b7-b1d4-081d-941b176bf550
msgctxt "h776ac171g6bdcg4fafg9484g1cbfab131326"
msgid "<i>Inspect the body.</i>"
msgstr "<i>시체를 수색한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_Tunnel
#. Speaker = Narrator
#. NodeID = da525eaf-f0e1-6bd7-f044-8d30cf6e5708
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_Tunnel:da525eaf-f0e1-6bd7-f044-8d30cf6e5708
msgctxt "hb07454c6g15f2g43bcgaf19g81c18f3ac8e2"
msgid "*You notice the corpse is very dead, but that's all.*"
msgstr "*시체가 죽어 있다는 건 알겠지만, 그 이상은 알 수 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_Tunnel
#. Speaker = Player
#. NodeID = e13dc1b8-9082-4cf5-b57b-861d5b735f0b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_Tunnel:e13dc1b8-9082-4cf5-b57b-861d5b735f0b
msgctxt "h536b1e5dge7efg4751g841ag70eb35e0919e"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Roah Moonglow
#. NodeID = 0315ae2b-7c6b-1997-3c0e-ba114bad5bd4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:0315ae2b-7c6b-1997-3c0e-ba114bad5bd4
msgctxt "hae2d42cbgbd11g4fd8gaac9gd54caec0a379"
msgid ""
"Half-right, sharp-eyes - a Zhent <i>is</i> a normal trader. Just a matter of "
"what's for sale."
msgstr "눈썰미가 좋네, 반은 맞아. <i>젠트도</i> 평범한 상인이야. 판매하는 물품이 다를 뿐이라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Roah Moonglow
#. NodeID = 05a36494-cb24-1245-6ecd-89bb46cd775a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:05a36494-cb24-1245-6ecd-89bb46cd775a
msgctxt "h541fe36egbb77g4b62g8a60g6711c0a2af28"
msgid ""
"No judgement, no right and wrong - just good deals and bad. That a problem "
"for you?"
msgstr "옳고 그름을 떠나서 남는 장사인지 아닌지만 따지거든. 뭐 불만 있어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Player
#. NodeID = 0db1ce08-7859-fca2-d3ea-269211e1d8f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:0db1ce08-7859-fca2-d3ea-269211e1d8f5
msgctxt "h6809deeag61cfg4647g991cg4d9f5e004d07"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Player
#. NodeID = 0e985d69-aa5f-4d6e-a5f9-68f3c61a695b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:0e985d69-aa5f-4d6e-a5f9-68f3c61a695b
msgctxt "h3e799b2bg85e8g4b50g978dga7203f4ddef0"
msgid "Let me see your wares."
msgstr "갖고 있는 걸 보여줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Player
#. NodeID = 15634566-bc2b-a443-8cc6-f6e6993b68d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:15634566-bc2b-a443-8cc6-f6e6993b68d6
msgctxt "h628e450fg9473g48cdg92b6g99605974d016"
msgid "Let me see your wares."
msgstr "파는 물건을 보여줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Player
#. NodeID = 16956ce2-5d1a-3793-330a-fd0e4ca19d77
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_QuartermasterFlimsy_State_Traded(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:16956ce2-5d1a-3793-330a-fd0e4ca19d77
msgctxt "h1ae839ccgf8ceg447eg8be8g3141ac18b052"
msgid "No problem at all. Let me see your wares."
msgstr "전혀 문제 없어. 당신 물건을 보여줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Player
#. NodeID = 191aed8d-2c99-54aa-88f4-700b2f4e6e04
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_QuartermasterFlimsy_State_KnowsZhentDisapproves(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:191aed8d-2c99-54aa-88f4-700b2f4e6e04
msgctxt "h58108303geaf4g4a29gb77ag6ecc8ef37b24"
msgid "I have no interest in trading with a Zhent."
msgstr "나는 젠타림과의 거래에 관심 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Roah Moonglow
#. NodeID = 1b3b5a43-09aa-ae10-b1a3-15c6a882d37b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:1b3b5a43-09aa-ae10-b1a3-15c6a882d37b
msgctxt "he1550a70ga6bdg4104gb824gaf4c64461ff9"
msgid "See? Just business."
msgstr "봤지? 사업은 사업일 뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Player
#. NodeID = 1bb37f88-7e26-5a8d-8eeb-faba296204b7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_QuartermasterFlimsy_State_Traded(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:1bb37f88-7e26-5a8d-8eeb-faba296204b7
msgctxt "hf683dcb3gcd3ag4b23ga655g77942b80f27f"
msgid "Let me see your wares."
msgstr "뭘 파는지 볼까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Player
#. NodeID = 1bb3d364-546f-f31c-22cb-61c11fb51478
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:1bb3d364-546f-f31c-22cb-61c11fb51478
msgctxt "hae4a6187g388ag4b9agb01bgc5602f01916c"
msgid "Let me see your wares."
msgstr "뭘 판매하는지 보여줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Player
#. NodeID = 1d9a0474-a790-4e8b-37cf-64cc3a95df80
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:1d9a0474-a790-4e8b-37cf-64cc3a95df80
msgctxt "h574b5ac5g76cfg483fgaaf5g0fd07a23756f"
msgid "What business do you have in a goblin camp?"
msgstr "고블린 야영지에서 무슨 사업을 하고 있는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Roah Moonglow
#. NodeID = 209cd0ad-b24f-7804-4f95-e0e3bb44613c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:209cd0ad-b24f-7804-4f95-e0e3bb44613c
msgctxt "h4dcab3d5g96ddg4fffgbbd9g338cff737fd7"
msgid "Pleasure."
msgstr "즐거웠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Roah Moonglow
#. NodeID = 2203e9df-85bd-6d35-f0d0-137b6ea47639
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:2203e9df-85bd-6d35-f0d0-137b6ea47639
msgctxt "h55b165c5g331dg46ecg8403g85e6fdbdda19"
msgid "Now - much obliged for the chat, but I'm here to <i>trade.</i>"
msgstr "부득이하게 잡담이 길어졌지만, 나는 이곳에 <i>거래</i>를 위해 왔어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Player
#. NodeID = 22e49c86-2bf2-167b-4c87-c90870a7e481
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:22e49c86-2bf2-167b-4c87-c90870a7e481
msgctxt "hebd06370gd056g474bg8810gff4ea7f5e162"
msgid "It's slaves you're buying - not prisoners."
msgstr "당신이 산 건 포로들이 아니라 노예들이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Narrator
#. NodeID = 23eaaa93-2aa4-dd51-f45a-840d0eaaf8e9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Zhentarim_Knows_Zhentarim = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:23eaaa93-2aa4-dd51-f45a-840d0eaaf8e9
msgctxt "had79b4b2ged7fg42bbg87d7g36aec3cf3b6f"
msgid ""
"*You recognise the crest she bears - the winged serpent of the Zhentarim.*"
msgstr "*당신은 그녀가 지닌 젠타림의 날개 달린 뱀의 문장을 알아봅니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Roah Moonglow
#. NodeID = 259849a1-572c-f55e-cc40-b6f6337412b8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:259849a1-572c-f55e-cc40-b6f6337412b8
msgctxt "h89d3ac95ge64eg46c2gb0fdg5ca96dc26743"
msgid ""
"You joking? Goblins sell the best prisoners - cheap, quiet, and eager to be "
"elsewhere."
msgstr "농담해? 고블린들은 가장 좋은 포로들을 판매한다고 - 값싸고, 조용하고, 다른 곳에 가고 싶어하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Player
#. NodeID = 26185a82-7a02-0016-3f7d-3958034196d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:26185a82-7a02-0016-3f7d-3958034196d4
msgctxt "h3bbbf9c2g6605g4b22gabb4g3458037d26e6"
msgid "You're no normal trader, are you? You're part of the Black Network."
msgstr "당신은 평범한 상인이 아니지? 당신도 검은 조직망의 일부잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Roah Moonglow
#. NodeID = 2bdf9a1a-725a-c63c-4f23-13bbdde15987
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:2bdf9a1a-725a-c63c-4f23-13bbdde15987
msgctxt "hce56428eg8c0cg4d21g977fgcc9d3dbaaa8d"
msgid ""
"Oh dry your eyes, Ilmater. It's me or a goblin cookpot - I know which I'd "
"choose."
msgstr "오, 눈물을 멈추세요, 일메이터시여. 내 목숨과 고블린 냄비 중에 택하라면, 나는 어느 쪽을 택해야 할지 알고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Player
#. NodeID = 38725639-d589-99c2-0a45-9a1e1718af82
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:38725639-d589-99c2-0a45-9a1e1718af82
msgctxt "hf5ea7817gdae5g40a6g9cf0g5cceede7c668"
msgid "Let me see your wares."
msgstr "뭘 파는지 보여줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Player
#. NodeID = 3e80c247-da10-8025-8eec-80fe42cea00c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#.      - OATHBREAKER(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:3e80c247-da10-8025-8eec-80fe42cea00c
msgctxt "h40396865g4c03g4bd6g98cdgfe398d46f656"
msgid ""
"You Zhentarim tend to trade in misery - that why you're at a goblin camp?"
msgstr "당신네 젠타림은 불행을 사고 팔지. 그게 당신이 고블린 야영지에 있는 이유인가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Player
#. NodeID = 4062080e-a6a0-486f-2b6e-bdb648890359
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:4062080e-a6a0-486f-2b6e-bdb648890359
msgctxt "h15e7040ag2df4g4e75g87fbgad10044099e2"
msgid "Let me see your wares."
msgstr "뭘 파는지 보여줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Roah Moonglow
#. NodeID = 4240592d-7d31-7f49-642d-0e39b60fbf10
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:4240592d-7d31-7f49-642d-0e39b60fbf10
msgctxt "haa2bfa84g7c9eg474bga592g6d6f2e9ce7d3"
msgid ""
"Bit <i>quieter</i>, if you please. This crowd just burned that inn to the "
"ground, you might recall."
msgstr "부탁인데 좀 <i>조용히</i> 말하라고. 너도 알다시피 우리 손님들이 방금 그 여관을 불태우고 온 참이니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Player
#. NodeID = 42e822fe-c164-ba6f-97a2-50a085427b7f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_ZhentDungeon_Zhent01_HasMet(1) = True
#.   Global:
#.      - PLA_ZhentDungeon_State_AllDead = True
#. SetFlags:
#.   Global:
#.     - GOB_QuartermasterFlimsy_State_ZhentEnemy = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:42e822fe-c164-ba6f-97a2-50a085427b7f
msgctxt "h2b9027afg08d2g4148g9c26gd22809ac565a"
msgid "I killed your friends at Waukeen's Rest - is <i>that</i> a problem?"
msgstr "난 와우킨의 쉼터에서 네 친구들을 죽였어. <i>그건</i> 문제 없나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Roah Moonglow
#. NodeID = 4717186a-7e8f-d253-c406-00e3a05b53cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:4717186a-7e8f-d253-c406-00e3a05b53cf
msgctxt "he91ebffbg364bg4559gb364g02e7e5b9df75"
msgid ""
"All I need to - there's an awful lot of folk flowing that way, and coin is "
"sure to follow."
msgstr "내가 알아야 할 건 한 가지야. 엄청나게 많은 사람들이 그쪽으로 몰려들면, 동전이 반드시 따라온다는 것."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Roah Moonglow
#. NodeID = 4833a9f7-a944-7107-6063-c59d6b1384e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:4833a9f7-a944-7107-6063-c59d6b1384e7
msgctxt "h0c576a9fga4c7g4d71ga1cega2fcdebdab60"
msgid ""
"Folk up here like to quiver over right and wrong - until the coin starts "
"clinking, anyway."
msgstr "이 위쪽에 사는 이들은 옳고 그름을 따지길 좋아하거든, 어차피 동전이 떨어지기 시작하면 다 똑같지만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Player
#. NodeID = 488e4ed5-9433-6ace-9dbc-41d4b98af515
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Zhentarim_Knows_Zhentarim = True
#.   Tag:
#.      - PALADIN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:488e4ed5-9433-6ace-9dbc-41d4b98af515
msgctxt "h17b89b04g5ed1g46e1gbb56g65db19547ff3"
msgid ""
"I knew the Zhent were heartless, but the goblin slave trade? <i>Really?</i>"
msgstr "젠타림이 무정한 이들이라는 건 알았지만, 고블린과 노예 무역을 한다고? <i>정말이야?</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Player
#. NodeID = 49375194-d037-7adb-898a-4013c7cc58c7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:49375194-d037-7adb-898a-4013c7cc58c7
msgctxt "h2ffb2159g26a0g4a84gbeb4g6a83bc2f56ab"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Roah Moonglow
#. NodeID = 4c47f782-bc27-4b81-4c4b-7df7b6678e6f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_QuartermasterFlimsy_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:4c47f782-bc27-4b81-4c4b-7df7b6678e6f
msgctxt "h5c674f78gab38g4a11gbad7g5619c2b24995"
msgid "Need something?"
msgstr "뭐가 필요하신가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Roah Moonglow
#. NodeID = 4fd67349-e266-f742-e0fd-e19471473989
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:4fd67349-e266-f742-e0fd-e19471473989
msgctxt "h1faf086eg9391g4755gbee7g8eb1c2e8353c"
msgid ""
"But the Black Network pays like for like. They - <i>we</i> - will be after "
"you now."
msgstr "하지만 검은 조직망은 언제나 받은 만큼 갚아 주지. 이제 넌 그들, 아니, <i>우리</i>에게 쫓기는 신세야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Roah Moonglow
#. NodeID = 5042ca5a-d447-25ba-7cbb-6e4766fd7504
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:5042ca5a-d447-25ba-7cbb-6e4766fd7504
msgctxt "h2320a163g31f7g40adgb5e8gbc1c9a49a1f8"
msgid ""
"... <i>assuming</i> I believe you - not really, no. Never much liked Zarys, "
"truth be told."
msgstr "... 내가 널 믿는다고 <i>가정</i>해 보자. 별로 내키진 않지만. 솔직히 자리스가 맘에 들진 않았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Player
#. NodeID = 5122138c-b861-0369-83a4-02449a5700c1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:5122138c-b861-0369-83a4-02449a5700c1
msgctxt "h2d3cd3c7gc2a0g4611g80degc40016bd7d2f"
msgid "Your insignia; I've seen it before - in the Underdark."
msgstr "네 휘장; 본 적이 있어, 언더다크에서 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Roah Moonglow
#. NodeID = 5eff5398-418c-5f65-f9ef-2c2323d9e701
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Absolute_Knows_MoonriseTowers = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:5eff5398-418c-5f65-f9ef-2c2323d9e701
msgctxt "h32e30f76gf609g4910g860cg8d1bf1c4b968"
msgid "Might have to find my faith and see this Absolute for myself, eh?"
msgstr "내 믿음을 찾아서 절대자라는 분을 직접 만나봐야겠네, 안 그래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Roah Moonglow
#. NodeID = 6d58710f-7e86-4ca6-093c-3ee790554c46
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_UNDERDARK(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:6d58710f-7e86-4ca6-093c-3ee790554c46
msgctxt "hd8000a20gb743g42d9g9a03gd5c084c522e0"
msgid "Already turned quite the profit today, so I'm feeling generous."
msgstr "내가 오늘 꽤 많은 수익을 내서, 지금 마음이 후한 상태야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Roah Moonglow
#. NodeID = 752233cd-443c-3b1c-78fc-d3fc8150171d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:752233cd-443c-3b1c-78fc-d3fc8150171d
msgctxt "h89dfbe5eg0c3fg4e5agb04cg2695390c1bb4"
msgid "Still some deals to be done here, though - you want to trade, or what?"
msgstr "그래도 아직 여기서 해야 할 거래가 남아있어. 너도 거래할래, 뭘 원해?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Roah Moonglow
#. NodeID = 777d8507-b7eb-c87c-e200-04911da02222
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:777d8507-b7eb-c87c-e200-04911da02222
msgctxt "hec6d26eag20e3g48d8gbdf0g813e839fa5f5"
msgid ""
"But for now, I see no reason we can't make a civilised trade. I reckon "
"you'll be wanting some steel."
msgstr "하지만 지금은, 교양 있는 거래를 하지 않을 이유가 없을 것 같은데. 무기가 좀 필요하겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Roah Moonglow
#. NodeID = 799c8aab-381b-3e2e-b73e-cd3681e381b7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_QuartermasterFlimsy_HasMet(1) = True
#.   Global:
#.      - GOB_QuartermasterFlimsy_State_ZhentEnemy = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:799c8aab-381b-3e2e-b73e-cd3681e381b7
msgctxt "he5a98fbag920fg4194g8a42gbae6fa5deb31"
msgid ""
"Reckon we've said all there is to say, eh? But don't worry - the Network'll "
"be in touch soon."
msgstr "할 얘기는 다 한 것 같은데, 응? 걱정하지 말라고. 조직에서 곧 기별이 있을 테니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Player
#. NodeID = 79ccbe88-07d0-4b77-e02e-083c6cb85cf4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DEEPGNOME(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:79ccbe88-07d0-4b77-e02e-083c6cb85cf4
msgctxt "h363ec10fgfb10g45c1gb38fg1ccf0d4f40e7"
msgid "Your insignia; I've seen it before - in the Underdark."
msgstr "네 휘장; 본 적이 있어, 언더다크에서 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Player
#. NodeID = 836e2e8f-a36b-6d1f-8109-a9f735b1fa4c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:836e2e8f-a36b-6d1f-8109-a9f735b1fa4c
msgctxt "h912ad4beg6ae1g4a68g9cc8g5f5b30abd46b"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Roah Moonglow
#. NodeID = 846f58ff-0256-c9f7-16e2-75a9f10d6aac
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Zhentarim_Knows_Zhentarim = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:846f58ff-0256-c9f7-16e2-75a9f10d6aac
msgctxt "h3487345agdeb3g4dd9g9037g50ce526e8ad5"
msgid ""
"Aye, so you have. It's one place the Zhentarim can trade openly, thank the "
"gods."
msgstr "아, 그랬군. 젠타림이 공개적으로 거래할 수 있는 곳은 거기밖에 없거든, 신들께 감사를."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Roah Moonglow
#. NodeID = 8dc5935d-794f-cf10-79fe-def34d586426
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_QuartermasterFlimsy_State_KnowsZhentDisapproves(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:8dc5935d-794f-cf10-79fe-def34d586426
msgctxt "hb92b562cg4312g4c61gbecdg5bf433584585"
msgid "Ah - need something then, do you?"
msgstr "아 - 그럼 뭔가 필요하구나, 그치?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Player
#. NodeID = 94e5fe73-a649-2531-d65b-55420949aefb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:94e5fe73-a649-2531-d65b-55420949aefb
msgctxt "hc065aeb9g265cg43dbg8592g94e36ab2082c"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Player
#. NodeID = 972f3810-b33c-ffac-7ae1-e775e7a6c774
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_QuartermasterFlimsy_State_KnowsZhentDisapproves(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:972f3810-b33c-ffac-7ae1-e775e7a6c774
msgctxt "h4f11df89g2958g44d1ga49bgf29648a0228e"
msgid "I'm not interested in trading with a Zhent."
msgstr "젠타림과 거래하는 데에는 관심 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Player
#. NodeID = 9e2f9e2f-9c90-22d6-e729-6acebe9eed80
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:9e2f9e2f-9c90-22d6-e729-6acebe9eed80
msgctxt "h18a71006g478fg426fg92dfg178ae507fb45"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Roah Moonglow
#. NodeID = aedbfa6d-5cc1-c5ae-a1ee-3a6f574cca99
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:aedbfa6d-5cc1-c5ae-a1ee-3a6f574cca99
msgctxt "hc6211c2egf768g4b89gb84cg5045a0e00590"
msgid ""
"Not my concern, so long as I'm paid. Speaking of - something to trade, or "
"what?"
msgstr "나는 돈만 받으면 되니 내가 상관할 바 아니지만. 말이 나왔으니 말인데, 거래할 만한 것 있어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Roah Moonglow
#. NodeID = b1eafa87-3235-56dc-daa5-f391ab4e1d19
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:b1eafa87-3235-56dc-daa5-f391ab4e1d19
msgctxt "he6f77a5cgd30bg4c07g8317g908eafff866f"
msgid "But good - that means Zarys and her little operation weren't found."
msgstr "그래도 다행이야. 자리스와 그년의 어설픈 작전이 아직 들통나지 않았나 보네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Roah Moonglow
#. NodeID = b4aa9347-1444-7166-6e04-811b1763c7ae
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_UNDERDARK(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:b4aa9347-1444-7166-6e04-811b1763c7ae
msgctxt "h7f1db6d6g60eeg429eg8094g8b5a35e08469"
msgid "Already turned quite the profit today, so I'm feeling generous."
msgstr "내가 오늘 꽤 많은 수익을 내서, 지금 마음이 후한 상태야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Player
#. NodeID = b646a6ae-4216-58f2-5505-8cd4b1025c9a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:b646a6ae-4216-58f2-5505-8cd4b1025c9a
msgctxt "hd82a2cc9g5758g4119g8dcfg0a92bd68d099"
msgid "What business does a Zhent have with goblins?"
msgstr "젠타림이 고블린들이랑 거래할 게 뭐가 있지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Roah Moonglow
#. NodeID = bcad5fc0-2cdd-c908-1dad-acc866aabc75
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:bcad5fc0-2cdd-c908-1dad-acc866aabc75
msgctxt "ha4af2f6dgc6e1g4eeagbf44gd85aa5a400f5"
msgid "Till next time."
msgstr "다음에 보자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Roah Moonglow
#. NodeID = bf948223-f628-3972-6494-cedb617cb38e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:bf948223-f628-3972-6494-cedb617cb38e
msgctxt "hb6e700c9gf2dag487cgb10bg1efbc3fe888b"
msgid ""
"Suit yourself. You'll be back when you have need - just make sure you have "
"coin, too."
msgstr "마음대로 해. 필요하면 다시 돌아오겠지 - 동전만 준비해두라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Roah Moonglow
#. NodeID = c0b0501e-da19-5ecc-ce0b-378c6f9bd905
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:c0b0501e-da19-5ecc-ce0b-378c6f9bd905
msgctxt "h48c3b1d0gb8d4g4a4bg8197gef229012d9ab"
msgid ""
"Ask that kin of yours they're all bowing to. The glint in her eye is bad "
"news for <i>someone.</i>"
msgstr "그건 놈들이 따르고 있는 네 동족한테 가서 물어보라고. 그녀가 눈이라도 깜짝하면 <i>놈들이 벌벌 떠니까.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Roah Moonglow
#. NodeID = c0b0501e-da19-5ecc-ce0b-378c6f9bd905
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:c0b0501e-da19-5ecc-ce0b-378c6f9bd905
msgctxt "h4159ce1egc674g4ce2gb05egffe32e9da2a3"
msgid ""
"Ask the drow they're all bowing to. That glint in her eye is bad news for "
"<i>someone</i>."
msgstr "그들이 복종하는 드로우에게 물어봐. 그녀 눈에서 번뜩이는 그 눈빛은 <i>누군가</i>에게 나쁜 문제일 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Player
#. NodeID = c0d72d07-a632-a6da-3b64-78237a5c0acc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_ZhentDungeon_Zhent01_HasMet(1) = True
#.   Global:
#.      - PLA_ZhentDungeon_State_AllDead = False
#. SetFlags:
#.   Global:
#.     - GOB_QuartermasterFlimsy_State_ZhentFriend = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:c0d72d07-a632-a6da-3b64-78237a5c0acc
msgctxt "he52b2929g14eag493cgaa30g5e4af3dede5f"
msgid "I've already done business with your kind - beneath Waukeen's Rest."
msgstr "이미 너희 동료와 거래를 한 적 있어. 와우킨의 쉼터 밑에 있더군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Roah Moonglow
#. NodeID = c4d7415c-dde4-6d52-36e9-a75cea010c12
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:c4d7415c-dde4-6d52-36e9-a75cea010c12
msgctxt "h095913fdgc470g4f0dg9449g5d98f682bd59"
msgid "Already turned quite the profit today, so I'm feeling generous."
msgstr "내가 오늘 꽤 많은 수익을 내서, 지금 마음이 후한 상태야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Player
#. NodeID = c6d566ee-4f60-f93b-9864-108d8e202b98
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:c6d566ee-4f60-f93b-9864-108d8e202b98
msgctxt "h061ae52cgeb91g4a80g81ecgd6c74cd505ec"
msgid "Let me see your wares."
msgstr "어떤 걸 갖고 있는지 볼까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Roah Moonglow
#. NodeID = c7cbe182-e49d-2091-6616-9fde92b482ab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:c7cbe182-e49d-2091-6616-9fde92b482ab
msgctxt "h1fab508eg4e62g47ecgbcdbgb673a69320f6"
msgid ""
"Weapons and other... <i>exotic </i>goods, true enough. But most of all, we "
"offer discretion."
msgstr "무기라든지, 또... <i>이색</i> 상품들을 취급하긴 하지. 하지만 우리는 고객의 비밀을 지켜."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Player
#. NodeID = c8cac57e-160d-92dd-87cb-93c0e02e188a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:c8cac57e-160d-92dd-87cb-93c0e02e188a
msgctxt "h080cb892g4057g4bb1ga8edg80a9e5cccebf"
msgid "What do the goblins want smokepowder for?"
msgstr "고블린들이 화약은 왜 찾는 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Player
#. NodeID = ca7c1226-5450-e556-2ed3-f48fb60ebcde
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:ca7c1226-5450-e556-2ed3-f48fb60ebcde
msgctxt "h75b13fceg84a0g43ccg980bg2db08d89179b"
msgid "What business does someone like you have in a goblin camp?"
msgstr "당신 같은 사람이 고블린 야영지에서 무슨 사업을 하고 있는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Roah Moonglow
#. NodeID = d74131dc-36aa-4485-66d0-08efb12112c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:d74131dc-36aa-4485-66d0-08efb12112c8
msgctxt "h7d61eeb2g9d52g4441gbe5ag6a68ca91f120"
msgid ""
"Till this crowd converted and started sending their captives to Moonrise "
"Towers, at least."
msgstr "적어도 이 무리가 개종하여 포로들을 문라이즈 타워로 보내기 전까지는 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Roah Moonglow
#. NodeID = d92e0cd7-8e80-ae0d-e7a9-6f694825754b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:d92e0cd7-8e80-ae0d-e7a9-6f694825754b
msgctxt "h0a2097a4g6a2fg466cgbd46g88369201f8c2"
msgid ""
"No complaints, mind - I just sold enough smokepowder to cover the loss ten "
"times over."
msgstr "불평, 걱정 마. 나는 손실을 10배로 메울 수 있을 만큼의 화약을 팔았을 뿐이니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Player
#. NodeID = de372f0d-fb71-081c-34fd-21b7d4ef7302
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:de372f0d-fb71-081c-34fd-21b7d4ef7302
msgctxt "hab433b42g7b3bg493dgb62cg5db6f92c8c52"
msgid "What do you know about Moonrise Towers?"
msgstr "문라이즈 타워에 대해 무엇을 알고 있지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Player
#. NodeID = df660912-8c70-b92b-1f8f-663526a95872
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:df660912-8c70-b92b-1f8f-663526a95872
msgctxt "h086f6cb1g31acg4600ga53eg99ccbef7b06d"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Roah Moonglow
#. NodeID = dfe6114e-150d-4d0f-0271-0c4ace3d1001
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:dfe6114e-150d-4d0f-0271-0c4ace3d1001
msgctxt "h3bad9137g7465g4dbdga74bgccf44d5f6ba3"
msgid ""
"It's just business. If there was money in being good, the Zhentarim would be "
"pure as paladins."
msgstr "그냥 사업일 뿐이야. 돈으로 선함을 살 수 있었다면, 젠타림은 팔라딘들 만큼이나 순수했을 거라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Roah Moonglow
#. NodeID = e38255f8-fd14-cde0-18d3-b29340cd5116
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_QuartermasterFlimsy_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:e38255f8-fd14-cde0-18d3-b29340cd5116
msgctxt "hd5595dc3gf527g4bebg9b12gc2f346043505"
msgid "That the jingle of coin I hear? You've timed it well, my friend."
msgstr "내가 들은 거 동전 소리 맞아? 타이밍을 잘 맞췄어, 친구."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Player
#. NodeID = e434b8ef-1104-1323-369e-0c6466cba982
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_QuartermasterFlimsy_State_Traded(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:e434b8ef-1104-1323-369e-0c6466cba982
msgctxt "h1d4b6f9bg0c97g4528g9181gfe2aae5fd7f4"
msgid "Let me see your wares."
msgstr "뭘 파는지 보여줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Roah Moonglow
#. NodeID = e4f11e31-9c95-429f-0e81-6c809546564f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_QuartermasterFlimsy_State_Traded(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:e4f11e31-9c95-429f-0e81-6c809546564f
msgctxt "haf70be15ga8e7g457fgbd45g6afdbeadd910"
msgid "Need something else?"
msgstr "다른 게 필요해?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Roah Moonglow
#. NodeID = e940b568-4bbf-5600-b7b1-9307dbaa84ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:e940b568-4bbf-5600-b7b1-9307dbaa84ec
msgctxt "heb7cbcd8g8d4bg4f3cgab52g220952ecfd12"
msgid "Be seeing you. Sooner than you'd like, I expect."
msgstr "또 보게 될 것 같네. 네 바람보단 더 빨리 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Player
#. NodeID = ee1fb519-7d80-2113-0547-3d4571dbce91
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:ee1fb519-7d80-2113-0547-3d4571dbce91
msgctxt "h31ef71acg1d9bg41d8g9e5ag87bc8b48cc30"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Roah Moonglow
#. NodeID = f5d06bf4-5d05-ebd9-bb20-922ebfadffaf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:f5d06bf4-5d05-ebd9-bb20-922ebfadffaf
msgctxt "h6b7f47fegabe4g4a7fg93d5g706113eded3f"
msgid ""
"Seems you're a friend of the family. That warrants a discount - a <i>small "
"</i>one."
msgstr "넌 우리 가족의 친구인 것 같은데. 할인을 좀 해줄게, <i>조금은 </i>말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Player
#. NodeID = f6626fac-b106-916e-c888-225ebb3db961
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:f6626fac-b106-916e-c888-225ebb3db961
msgctxt "h8b87b53eg0018g42e0g8ac3gf1bcd8640380"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Player
#. NodeID = f7a797c5-6ba6-1e7d-482c-f20a6fc70f0e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DUERGARDWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:f7a797c5-6ba6-1e7d-482c-f20a6fc70f0e
msgctxt "h6746ceccg3538g4b0bga135g86bd85c8e844"
msgid "Your insignia; I've seen it before - in the Underdark."
msgstr "네 휘장; 본 적이 있어, 언더다크에서 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy
#. Speaker = Roah Moonglow
#. NodeID = fbfe3242-accf-c0d0-5e54-72ae12e87dd7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_QuartermasterFlimsy_HasMet(1) = True
#.   Global:
#.      - GOB_QuartermasterFlimsy_State_ZhentFriend = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_QuartermasterFlimsy:fbfe3242-accf-c0d0-5e54-72ae12e87dd7
msgctxt "hfb9a87eag4cd4g4de2g9e54g5547dfd70cc1"
msgid "Ah, the family friend! Need something?"
msgstr "아, 가족의 친구로군! 필요한 것이 있나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderArrogant
#. Speaker = Sharp-Eye Neem
#. NodeID = 7c2246ee-40c5-2117-0d4e-ef6337e94b5b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_RaiderArrogant_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderArrogant:7c2246ee-40c5-2117-0d4e-ef6337e94b5b
msgctxt "h92414eb2gf042g4b2ag8f05ge5d6c038c97a"
msgid ""
"Don't let our little pet scare ya, mate. Bloody <i>bugbear</i> couldn't "
"break those bars."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderArrogant
#. Speaker = Sharp-Eye Neem
#. NodeID = dac6e7ca-2b0d-4b2f-c13d-ff1def7e31b2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_RaiderArrogant_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderArrogant:dac6e7ca-2b0d-4b2f-c13d-ff1def7e31b2
msgctxt "hab2aa1aeg2168g4c02gb612g03be60a13705"
msgid "Headin' t'see our new pet? It didn't tame easy, I'll give it that."
msgstr "우리 새 애완동물을 보러 가는 중이야? 길들이기가 쉽지는 않았지, 확실히."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderBold
#. Speaker = Warrior Clack
#. NodeID = 8aeab226-07da-2a19-974a-14bd8391c684
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_RaiderBold_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_RaiderBold_HasMet(1) = True
#. TagRule: BESTIAL or GITHYANKI or PLANAR or RARE
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderBold:8aeab226-07da-2a19-974a-14bd8391c684
msgctxt "hdc53b6f7gdcd9g49f0g9b64g98c6f9fc1e4f"
msgid ""
"I seen flumphs an' owlbears an' squiddies. But never seen nothin' like you."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderBold
#. Speaker = Warrior Clack
#. NodeID = 8aeab226-07da-2a19-974a-14bd8391c684
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_RaiderBold_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_RaiderBold_HasMet(1) = True
#. TagRule: DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderBold:8aeab226-07da-2a19-974a-14bd8391c684
msgctxt "h85a57063g8e2bg4cf6ga0dcg7f144ef6be73"
msgid "Thought you drow had already gone off to the tower."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderBold
#. Speaker = Warrior Clack
#. NodeID = 8aeab226-07da-2a19-974a-14bd8391c684
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_RaiderBold_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_RaiderBold_HasMet(1) = True
#. TagRule: DWARF or GNOME or HALFLING
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderBold:8aeab226-07da-2a19-974a-14bd8391c684
msgctxt "h019e65efg7029g4584g9973g8fe980033e52"
msgid "Keep yer distance, squattie."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderBold
#. Speaker = Warrior Clack
#. NodeID = 8aeab226-07da-2a19-974a-14bd8391c684
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_RaiderBold_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_RaiderBold_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderBold:8aeab226-07da-2a19-974a-14bd8391c684
msgctxt "hbea82780g5b28g47ffgacb7g267889f8347d"
msgid "If yer close enough to talk with me, then yer too damn close."
msgstr "니가 내게 말 걸 정도면, 너무 가까이 왔다는겨."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderBold
#. Speaker = Warrior Clack
#. NodeID = c1b77982-d87b-bcbd-0b1f-aa080c1b1211
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_RaiderBold_HasMet(1) = True
#. TagRule: BESTIAL or GITHYANKI or PLANAR or RARE
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderBold:c1b77982-d87b-bcbd-0b1f-aa080c1b1211
msgctxt "h596c695dg3e1dg4dffg8636g5362bc105cdf"
msgid ""
"Gotta sharpen these spears. No time for conversin' with... whatever it is "
"you are."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderBold
#. Speaker = Warrior Clack
#. NodeID = c1b77982-d87b-bcbd-0b1f-aa080c1b1211
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_RaiderBold_HasMet(1) = True
#. TagRule: DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderBold:c1b77982-d87b-bcbd-0b1f-aa080c1b1211
msgctxt "hc4322833g78d1g455agb0e7ge77b3d76bd0f"
msgid "Sorry - ain't got time for conversin'."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderBold
#. Speaker = Warrior Clack
#. NodeID = c1b77982-d87b-bcbd-0b1f-aa080c1b1211
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_RaiderBold_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderBold:c1b77982-d87b-bcbd-0b1f-aa080c1b1211
msgctxt "h6f6b979dgfc5dg445dg92d7gffac14442028"
msgid "I gotta sharpen these spears - ain't got time for conversin'."
msgstr "이 창들을 갈아야해 - 떠들 시간 없다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderChieftain
#. Speaker = Skrut
#. NodeID = 002c12ba-6b02-e056-2083-dca8f3c2fc97
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderChieftain:002c12ba-6b02-e056-2083-dca8f3c2fc97
msgctxt "h1dbef2ceg8da7g4df1gbebagbb89780dd54b"
msgid ""
"<i>What? </i>You must have some plug in ya! Ah, wait. You're some messer. "
"Had me well fooled."
msgstr "<i>뭐?</i> 어디 나오는 구멍은 있어야 할 거 아냐! 아, 잠깐. 놀리는 거군. 한 방 먹었구만그래. "

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderChieftain
#. Speaker = Player
#. NodeID = 0617b736-b854-c925-0c6f-cab8cb82fab5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderChieftain:0617b736-b854-c925-0c6f-cab8cb82fab5
msgctxt "h5dabb956gf033g4085gb423ga54756a2ca88"
msgid "It can look all it likes. I've got nothing to hide."
msgstr "마음대로 보라고 해. 난 숨길 거 없으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderChieftain
#. Speaker = Skrut
#. NodeID = 0c283c19-135a-b0dc-1a6f-74e0014acbed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderChieftain:0c283c19-135a-b0dc-1a6f-74e0014acbed
msgctxt "hf2496369ge767g4a2bg9710g0675f3ddea15"
msgid ""
"It's a floatin' <i>eye</i>, mate. Yer bosses at Moonrise enjoy spyin' on us."
msgstr "떠다니는 <i>눈</i>이잖아, 친구. 문라이즈에 있는 네 상관이 염탐을 즐기는 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderChieftain
#. Speaker = Skrut
#. NodeID = 0f9e50f8-0fa3-6c5d-c65c-ac89945b6c79
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderChieftain:0f9e50f8-0fa3-6c5d-c65c-ac89945b6c79
msgctxt "hedeffbc9g62c8g4b72gab67g933d7861cbc6"
msgid ""
"... unless you like playin' hide an' seek when yer tryin' to take a dump."
msgstr "... 똥 쌀 때도 숨바꼭질 하고 싶은 게 아니라면."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderChieftain
#. Speaker = Skrut
#. NodeID = 16bac0f1-6d8c-00da-67bf-7af15842db53
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DROWELF(1) = True
#. SetFlags:
#.   Dialog:
#.     - GOB_RaiderCaptain_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderChieftain:16bac0f1-6d8c-00da-67bf-7af15842db53
msgctxt "hc740ff80gfa11g4700gb83eg11452523c002"
msgid "Any questions? Minthara is the one yer after."
msgstr "궁금한 거라도? 볼일은 민타라에게 가면 되는데. "

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderChieftain
#. Speaker = Skrut
#. NodeID = 3008dadf-88d9-e883-9807-523965db4322
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderChieftain:3008dadf-88d9-e883-9807-523965db4322
msgctxt "hbe07e50fg1e1ag455bg884bgf491c4bbe4ef"
msgid ""
"It's a floatin' <i>eye</i>, mate. What do you reckon? Bloody spyin' on us."
msgstr "떠다니는 <i>눈</i>이잖아, 친구. 뭐겠어? 우릴 염탐하고 있는 거라고. "

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderChieftain
#. Speaker = Player
#. NodeID = 3213eaf5-f542-c573-9da1-17c22ce55805
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderChieftain:3213eaf5-f542-c573-9da1-17c22ce55805
msgctxt "h0bde15bcg2250g4c36g9fb9g47e8fe2365f3"
msgid "What <i>is </i>it?"
msgstr "<i>저건</i> 뭐지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderChieftain
#. Speaker = Skrut
#. NodeID = 3754f6e8-717d-83ca-0523-079f4bfe58b6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_RaiderCaptain_HasMet(1) = True
#.   Tag:
#.      - DROWELF(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderChieftain:3754f6e8-717d-83ca-0523-079f4bfe58b6
msgctxt "h69fbfa5eg4a30g432cg8e2cg701a5d1a675e"
msgid "You fancy me or somethin'? Leave off!"
msgstr "나한테 관심 있냐? 좀 꺼져!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderChieftain
#. Speaker = Skrut
#. NodeID = 39fa866d-fbc1-36d4-40d1-d666531a428b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderChieftain:39fa866d-fbc1-36d4-40d1-d666531a428b
msgctxt "hd94abc0bg7ccdg44eegb5dfgf12457c8b797"
msgid ""
"Load o' trollop. Jus' don't trust us to do what we do best - killin' things."
msgstr "제기랄. 그냥 우리가 못 미더운 거겠지. 죽이는 건 우리가 제일 잘하는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderChieftain
#. Speaker = Player
#. NodeID = 5e10c1d7-0af2-7922-6755-3c2c2ae0ddd2
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_BESTIAL or REALLY_RARE
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderChieftain:5e10c1d7-0af2-7922-6755-3c2c2ae0ddd2
msgctxt "he8d1a79ag3094g441bga9dfg3dacb700a841"
msgid "Heh. It's a good thing my kind do not need to defecate."
msgstr "헤. 우리 종족은 똥 같은 거 안 싸도 돼서 다행이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderChieftain
#. Speaker = Player
#. NodeID = 831fa227-ad16-f42d-205d-96b31c126403
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderChieftain:831fa227-ad16-f42d-205d-96b31c126403
msgctxt "hf0663872gb6f0g4170ga545g06ab0d3fa712"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderChieftain
#. Speaker = Skrut
#. NodeID = 86dc9e86-f8ed-8429-9d69-2229b5fd99e7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#. SetFlags:
#.   Dialog:
#.     - GOB_RaiderCaptain_HasMet_Eye(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderChieftain:86dc9e86-f8ed-8429-9d69-2229b5fd99e7
msgctxt "hc89b5457gb432g4d24g99ceg4dc9d86ab942"
msgid ""
"You see that eye wotsit floatin' about? Best hope it don't take a fancy to "
"you..."
msgstr "저기 떠다니는 눈깔 같은 거 보여? 저게 너한테 관심 없길 기도해..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderChieftain
#. Speaker = Skrut
#. NodeID = 8eff2b82-9541-4174-ee0b-715a6adbbd50
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderChieftain:8eff2b82-9541-4174-ee0b-715a6adbbd50
msgctxt "he7ae67a7ga18fg407dgaba5ga1df00a960b1"
msgid "The bigwigs at Moonrise like to 'be involved', the drow says."
msgstr "문라이즈에 있는 높으신 것들은 '관여'하길 좋아해. 드로우가 그러던데. "

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderChieftain
#. Speaker = Skrut
#. NodeID = 94b13411-b620-15c9-5443-f2137d4bc492
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DROWELF(1) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_RaiderCaptain_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderChieftain:94b13411-b620-15c9-5443-f2137d4bc492
msgctxt "h9082a43fgd610g452ag9630gb3e30b974e13"
msgid "Whatcha staring at? Move along, ugly."
msgstr "뭘 봐? 가던 길 가, 못생긴 놈아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderChieftain
#. Speaker = Skrut
#. NodeID = a5285e97-7f40-7f73-6550-c112922f8f93
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderChieftain:a5285e97-7f40-7f73-6550-c112922f8f93
msgctxt "hff060035g4b9dg46bdg9c43ga3aadab18b4f"
msgid "If that's how you get yer kicks, ain't no business o' mine."
msgstr "니가 그런 취향인 건, 내 알 바 아니거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderChieftain
#. Speaker = Skrut
#. NodeID = b2ef3f9f-75ba-467b-03c1-e708e7a6192b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderChieftain:b2ef3f9f-75ba-467b-03c1-e708e7a6192b
msgctxt "hf4bcd077g4cfbg40e9gbab1g574b96062b9d"
msgid ""
"But when yer takin' a tinkle, or whatever you lot do with your bits, give it "
"a wave, eh? The bigwigs at Moonrise <i>love </i>a good show."
msgstr ""
"니가 쌀 때 거시기를 꺼내는지는 몰라도, 그럴 때 있으면 한번 흔들어주라고, 응? 문라이즈의 높으신 것들은 그런 거 아주 "
"<i>좋아하거든</i>. "

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderChieftain
#. Speaker = Skrut
#. NodeID = d2925e7f-76f8-3538-4240-b33b8734a13f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_RaiderCaptain_HasMet(1) = True
#.   Tag:
#.      - DROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderChieftain:d2925e7f-76f8-3538-4240-b33b8734a13f
msgctxt "hce78319eg72edg4300g8b43g2d5387a3b87f"
msgid "You seen that scryin' eye wotsit about? Handy, that."
msgstr "저 엿보기 눈깔 봤어? 유용하지. "

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderChieftain
#. Speaker = Skrut
#. NodeID = e7133ee9-08b4-cf4e-eb3b-dfae284cfdd3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderChieftain:e7133ee9-08b4-cf4e-eb3b-dfae284cfdd3
msgctxt "heba31ba1g18f0g4e27gaf6dg42a136f1e893"
msgid "Eh? You dunno? Hah! A grunt like the rest of us, eh?"
msgstr "어? 잘 모른다구? 하! 우리 같은 쫄따구였구만, 안 그래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderChieftain
#. Speaker = Skrut
#. NodeID = ee418631-2a3a-e64d-f1c1-6e411c3d9f93
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_RaiderCaptain_HasMet_Eye(1) = True
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderChieftain:ee418631-2a3a-e64d-f1c1-6e411c3d9f93
msgctxt "h066324b6g1d97g4735gb818g6024dbdef407"
msgid "I'm fed up with that bloody eye. Peep on someone else, you hear!"
msgstr "저 망할 눈깔은 이제 지긋지긋해. 딴 놈이나 훔쳐보라고, 알겠냐!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderChieftain
#. Speaker = Skrut
#. NodeID = f24e3ad7-e826-2deb-2ee2-2feef98a6d0b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BESTIAL(1) = False
#.      - RARE(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderChieftain:f24e3ad7-e826-2deb-2ee2-2feef98a6d0b
msgctxt "h3d07e5d1gd7cfg4e58gaf6bg0090d2f51513"
msgid ""
"But when yer takin' a tinkle, be sure to wave, eh? The bigwigs at Moonrise "
"<i>love </i>a good show."
msgstr "근데 니가 오줌쌀 때는, 한번 흔들어주라고, 응? 문라이즈의 높으신 것들은 그런 거 아주 <i>좋아하거든</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderClumsy
#. Speaker = Warrior Huk
#. NodeID = 83e7f6bc-60d7-6a9a-7620-f1cd4c60d736
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_RaiderClumsy_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderClumsy:83e7f6bc-60d7-6a9a-7620-f1cd4c60d736
msgctxt "h1a2a3faaga7ecg49bcg8b20gea721e9ec9f1"
msgid "Hmph."
msgstr "흐음."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderClumsy
#. Speaker = Warrior Huk
#. NodeID = 9b1efeb8-6ef2-4f20-f419-6f016b7c5366
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_RaiderClumsy_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_RaiderClumsy_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderClumsy:9b1efeb8-6ef2-4f20-f419-6f016b7c5366
msgctxt "hce483ac9g5dd1g4f68gb1f1ge5b5d68cbdef"
msgid "Shh! Boss!"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderCunning
#. Speaker = Sharp-Eye Nass
#. NodeID = 01cac531-976e-cd68-8262-dc802d8c9751
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_RaiderCunning_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderCunning:01cac531-976e-cd68-8262-dc802d8c9751
msgctxt "hf9950847gd6c8g4194gb491g8cb11dea28ec"
msgid "Aye? Little busy bleedin', if y'don't mind."
msgstr "뭐? 피 흘리느라 상대해줄 정신 없거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderCunning
#. Speaker = Sharp-Eye Nass
#. NodeID = 0310a945-d559-3c98-cb0c-e501b6f4241e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_RaiderCunning_HasMetHealing(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderCunning:0310a945-d559-3c98-cb0c-e501b6f4241e
msgctxt "hb0e9be93g5fefg43a9g9e15g2207d4b64f83"
msgid ""
"Tried the priest, but she says the Absolute'll set me right in time for the "
"next raid."
msgstr "사제님 찾아갔는데, 다음 습격 갈 때 되면 절대자께서 고쳐주실 거래."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderCunning
#. Speaker = Sharp-Eye Nass
#. NodeID = 18831769-80ac-653c-406e-5625c6c75eb0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_RaiderCunning_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderCunning:18831769-80ac-653c-406e-5625c6c75eb0
msgctxt "h8e907f43g1df6g4c30g8468g39b260c8b03f"
msgid ""
"Ain't none can stand against us now. Not with the Absolute in our corner."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderCunning
#. Speaker = Player
#. NodeID = 35eb15fd-0d9b-6c9f-8beb-b9154330be1d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderCunning:35eb15fd-0d9b-6c9f-8beb-b9154330be1d
msgctxt "h740270f3gb3d0g42aaga00dg2cd5da68045b"
msgid "You fought Flaming Fist?"
msgstr "플레이밍 피스트와 싸웠다고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderCunning
#. Speaker = Sharp-Eye Nass
#. NodeID = 3b1ecbc0-db0c-9613-706f-9abaa7b44d62
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderCunning:3b1ecbc0-db0c-9613-706f-9abaa7b44d62
msgctxt "h4b3864ccgab3fg4d5eg8a62g259f976cf8fd"
msgid "Fiercest thing about 'em was the wailing, 'til we put an end to it."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderCunning
#. Speaker = Sharp-Eye Nass
#. NodeID = 4257666a-ee1f-7a5c-ee22-68e40bc5c9c4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_RaiderCunning_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_RaiderCunning_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderCunning:4257666a-ee1f-7a5c-ee22-68e40bc5c9c4
msgctxt "h79c32909g9ef8g4c41gb769ga2216e4a1bee"
msgid ""
"Seen this mess? Flamin' Fist thuggo took a chunk outta me arm last raid out."
msgstr "이거 보여? 지난 전투에서 플레이밍 피스트가 내 팔을 이 지경으로 만들었지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderCunning
#. Speaker = Sharp-Eye Nass
#. NodeID = 480629e1-a610-15dc-8f70-54b4ff9ac0f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderCunning:480629e1-a610-15dc-8f70-54b4ff9ac0f3
msgctxt "h88f4c2cdgd938g47ffg946cgea2b3c517625"
msgid ""
"That last inn we 'it. They were guardin' some uppity noble 'n his friends."
msgstr "여관에서 함 싸웠지. 어느 잘난 귀족 양반이랑 친구들을 지키고 있더라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderCunning
#. Speaker = Sharp-Eye Nass
#. NodeID = 592b7d47-e7b1-a8de-3254-4c39cce1f1a3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_RaiderCunning_HasMet(1) = True
#. TagRule: DROWELF or DROWHALFELF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderCunning:592b7d47-e7b1-a8de-3254-4c39cce1f1a3
msgctxt "hf7f7cdd7ge2d4g462bg89c6g3a5e66b588c5"
msgid ""
"Not very well, mind. Yer drow pals carried him off, left the <i>real</i> "
"spoils to us."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RaiderCunning
#. Speaker = Sharp-Eye Nass
#. NodeID = 8a5fa83b-407c-9a14-16ff-2a018f2dbaf4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_RaiderCunning_HasMetHealing(1) = True
