msgctxt "h13d9caa0g65d5g4a6fgbcc1g6613fb3ff0a6"
msgid "What should we toast to, eh?"
msgstr "뭘 위해 건배할까, 응?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Sharp-Eye Mirg
#. NodeID = ef3e887d-b59d-10d2-2243-05f760fc5e7b
