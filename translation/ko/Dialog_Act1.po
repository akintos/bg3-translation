msgid "How did you die?"
msgstr "어떻게 죽게 되었지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_Dead_PostEA
#. Speaker = Narrator
#. NodeID = 056d4f36-5d81-497c-806f-ea5d44ee4fee
