msgctxt "h5692ea5fg4eebg4dd0gab50g7bc4b5c95534"
msgid "How about a taste of your own medicine?"
msgstr "네가 대신 당해 보는 건 어때?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear
#. Speaker = Halsin
#. NodeID = a5166dd7-d0d7-b487-dcbc-bc84f6a9812a
