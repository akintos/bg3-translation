msgctxt "h3453d57cg4140g4e28gb738g117c18ca6c9f"
msgid "<i>Where are the others? Mari, Barton? Did she kill them...?</i>"
msgstr "<i>나머지 애들은 어떻게 된 거야? 마리랑 바튼은? 설마 이년 손에 죽었나...?</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_BanditBackInteraction_Spotted
#. Speaker = Gimblebock
#. NodeID = 6cd70d92-cb8b-9e09-e0cc-5bee381040af
