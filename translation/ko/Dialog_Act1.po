#.     - UND_RaftEvent_State_ClaimedWasTrueSoul = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent:80c849ed-aab7-10d1-d7c0-8b5938d03029
msgctxt "h8852a678g9ac0g4615g87feg7a0d3015e809"
msgid "See this brand? Let me pass."
msgstr "이 표식 보여? 지나가게 해줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent
#. Speaker = Player
#. NodeID = 86f5b6d3-9248-8912-ddb6-105855a037d7
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BERSERKER(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent:86f5b6d3-9248-8912-ddb6-105855a037d7
msgctxt "h76d7d7f5g11cbg4f19g96b8g7cd27cb4e38b"
msgid "MOVE YOUR BOAT, OR SINK. <b>MAKE THE CHOICE. </b>"
msgstr "<b>선박을 치우든지, 가라앉든지. 선택해. </b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent
#. Speaker = Player
#. NodeID = 8ba612f5-f13a-b206-dfa0-69f5fa6f63e1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent:8ba612f5-f13a-b206-dfa0-69f5fa6f63e1
msgctxt "h50f5cd36g3efeg4e64g9f29g316980404a72"
msgid "Who?"
msgstr "누구라고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent
#. Speaker = Corsair Greymon
#. NodeID = 8d44816e-d116-07da-3149-cd181e4983bc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent:8d44816e-d116-07da-3149-cd181e4983bc
msgctxt "ha49bb129ga593g4d00g8cc4g8934d294852f"
msgid ""
"I don't care what you've got scrawled on your skin. I don't like your "
"<i>face</i>."
msgstr "네 피부 속에 뭘 숨겨놨는지 따위는 관심 없어. 그냥 네 <i>얼굴이</i> 마음에 안 드는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent
#. Speaker = Player
#. NodeID = 8d52d74e-da9d-b4c8-7402-18ca7f88d295
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Strength
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent:8d52d74e-da9d-b4c8-7402-18ca7f88d295
msgctxt "h23904a8ag6e0dg435dg9003ge4ba0b1f7b3a"
msgid "<i>Push the duergar into the water.</i>"
msgstr "<i>듀에르가를 호수로 밀어버린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent
#. Speaker = Corsair Greymon
#. NodeID = 8f88bcc2-7eb7-90d5-4916-cd9c72a8a17b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent:8f88bcc2-7eb7-90d5-4916-cd9c72a8a17b
msgctxt "hfb398da0g2f36g4378g8013g45ab5631b6a8"
msgid "You don't know Gekh? How'd you... ugh, whatever - I don't care."
msgstr "게크를 모른다고? 그럼 어떻게... 쳇, 상관없어. 어차피 신경 쓰고 싶지도 않고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent
#. Speaker = Corsair Greymon
#. NodeID = 9717de12-9958-709e-3966-f63a484422c6
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: TIEFLING
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent:9717de12-9958-709e-3966-f63a484422c6
msgctxt "haf1bee25g98c5g4565gb5e8gb542362d2024"
msgid "All right, all right. No reason to get your horns in a twist."
msgstr "알았어, 알았어. 그렇게 흥분할 필요는 없잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent
#. Speaker = Corsair Greymon
#. NodeID = 9717de12-9958-709e-3966-f63a484422c6
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent:9717de12-9958-709e-3966-f63a484422c6
msgctxt "hebab3d2bg3ee2g4e39g8d98g5d95f77d1d02"
msgid "All right, all right. No reason to get your tongue in a twist."
msgstr "알았어, 알았어. 그렇게 흥분할 필요는 없잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_RaftEvent
