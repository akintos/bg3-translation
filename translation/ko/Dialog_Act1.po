#.      - PALADIN(1) = True
#. TagRule: PALADIN_DEVOTION
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:af79339d-1c4f-1f2a-6835-e260c064f686
msgctxt "h260796b6g7e8fg4eafga578g4baf8134f450"
msgid "'<i>Us </i>True Souls?'  You disgust me. I swear no fealty to your god."
msgstr "'<i>우리 </i>참된 영혼?' 역겹군.  나는 너희 신에게 충성을 맹세하지 않았다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = Player
#. NodeID = af79339d-1c4f-1f2a-6835-e260c064f686
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule: PALADIN_VENGEANCE and NOT_FOR_EA
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:af79339d-1c4f-1f2a-6835-e260c064f686
msgctxt "hc83a70a7g79bcg478eg9b4dg2c9d15102f1d"
msgid ""
"As if I'd trust a creature like you to meddle in my mind. Time to die, True "
"Soul. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = True Soul Gut
#. NodeID = aff446d1-3258-2a5c-6ce7-582f6c97f484
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:aff446d1-3258-2a5c-6ce7-582f6c97f484
msgctxt "h369ed79bg1734g4876g804fg6b2268241957"
msgid "With the Absolute's will, I can fix <i>anythin'</i>."
msgstr "절대자님의 의지로, 난 <i>뭐든</i> 고칠 수 있다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = Gale
#. NodeID = b291a4ca-42bf-1b71-159a-48a49b1fe7bd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_GALE(7) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:b291a4ca-42bf-1b71-159a-48a49b1fe7bd
msgctxt "h16075ccdg7815g41f3gb08cgc6ec7847d4c1"
msgid ""
"Whoa! There are a lot of guts to go around in this place. Are you sure "
"you...? Never mind. Too late."
msgstr "와, 여기선 배짱이 많이 필요하겠는데! 근데 너 정말로...? 아냐, 이미 늦었네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = Narrator
#. NodeID = b7f0fcfc-a054-8d09-34c6-0ab39e2d558e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:b7f0fcfc-a054-8d09-34c6-0ab39e2d558e
msgctxt "hafbd97adg090ag41b4gb2a5g9575646b393f"
msgid "*Your minds brush against one another but are swiftly parted.*"
msgstr "*두 사람의 정신이 서로 스치지만 금세 헤어집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = True Soul Gut
#. NodeID = ba3e7baa-887c-67bf-e81a-82309fc04f1e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_GoblinPriest_AcceptedHelp(1) = True
#.   Global:
#.     - GOB_GoblinPriest_State_LeftBranding = True
#.     - GOB_GoblinPriest_AnotherPlayerProblem = True
#.   Object:
#.     - GOB_GoblinPriest_Event_StopBranding(0) = True
#.     - GOB_GoblinPriest_Event_StartMovingToChapel(0) = True
#.   Quest:
#.     - GLO_Tadpole_SUB_Priestess.GotBranded(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:ba3e7baa-887c-67bf-e81a-82309fc04f1e
msgctxt "h871e6a68g3568g4f9ag8ad2g1658ee2d7e25"
msgid ""
"Let's deal with this in my chapel. It's private. Don't want this lot "
"interfering with True Soul business."
msgstr "내 예배당에서 처리하자고. 거기는 사적인 공간이야. 이 무리에게 참된 영혼 용무를 방해받는 건 원치 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = True Soul Gut
#. NodeID = c391fb23-dc75-720e-9cca-8b949af4372c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:c391fb23-dc75-720e-9cca-8b949af4372c
msgctxt "h33b43825g8d29g434aga1a6g12c5b2c486eb"
msgid ""
"Maybe I can help with that. Us True Souls got to look out for one another."
msgstr "그 문제에 관해 내가 도와줄 수도 있다. 우리 참된 영혼끼리는 서로 도와줘야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = Player
#. NodeID = c862d284-0bb0-2775-e943-4f4af9373edc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:c862d284-0bb0-2775-e943-4f4af9373edc
msgctxt "h2b186e4dg9812g40e1g9e9fg32d699c7fad7"
msgid "Ignore him. Tell me about the mark, priestess."
msgstr "그는 무시해라. 여사제, 표식에 대해 말해 봐라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = True Soul Gut
#. NodeID = cb90b627-7f70-b3f4-8492-d7ae7b84c5c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:cb90b627-7f70-b3f4-8492-d7ae7b84c5c0
msgctxt "hb07152ddgcf77g41c6g992dgdc9110cd3c50"
msgid "Let me take a closer look. I ain't seen anything like this before."
msgstr "내가 더 자세히 살펴보겠다. 전에는 이런 것을 본 적이 없거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = Player
#. NodeID = d01be1ec-63d9-c317-7079-7ce679c3eb05
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:d01be1ec-63d9-c317-7079-7ce679c3eb05
msgctxt "h9dc7a903g292dg472ag91e1g108e6533fce9"
msgid "I know what's wrong - there's a creature inside my brain."
msgstr "뭐가 문제인지 알아 - 뇌 속에 생명체가 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = Player
#. NodeID = d28cab15-d871-bcc7-f3a2-812a93f7d64b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:d28cab15-d871-bcc7-f3a2-812a93f7d64b
msgctxt "hc682636ag2e60g429egac4egd68040928e3d"
msgid "I doubt that, but go ahead."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = True Soul Gut
#. NodeID = db35f4da-8d02-e48e-89af-69979e405c11
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:db35f4da-8d02-e48e-89af-69979e405c11
msgctxt "hbdfb7b59g97c2g448aga78ag8ae9493df940"
msgid "You ready? Brace yourself - this'll sting."
msgstr "준비됐나? 마음을 단단히 먹거라. 따끔할 테니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = Player
#. NodeID = dbdf8611-0724-c488-9678-a30929d6483c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:dbdf8611-0724-c488-9678-a30929d6483c
msgctxt "h6066d582g209cg4174ga207g506db5ddbce5"
msgid "Fine. Do what you can."
msgstr "좋아. 네가 할 수 있는 일을 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = Player
#. NodeID = def7253a-0fe0-9ab2-4314-c670c3c32437
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:def7253a-0fe0-9ab2-4314-c670c3c32437
msgctxt "h8bc5e74agef9eg431fga527g7a430f3d8325"
msgid "<i>Nod to Wyll and prepare to attack.</i>"
msgstr "<i>윌에게 고개를 끄덕이고 공격을 준비한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = Player
#. NodeID = e2a86eb9-1553-8aec-fc9c-fbbb08c17839
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:e2a86eb9-1553-8aec-fc9c-fbbb08c17839
msgctxt "h7b60bd3eg0a3eg4ed6ga519g4ce18ac8aaac"
msgid "No, but by my oath, I am ready to take <i>your </i>head."
msgstr "아니, 하지만 내 맹세에 따라 <i>네</i> 머리를 가져갈 준비는 됐어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = Player
#. NodeID = ea65dec6-6c0d-c7e5-64e1-e9c95e59357b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:ea65dec6-6c0d-c7e5-64e1-e9c95e59357b
msgctxt "hbcdcace2gc325g4501ga4cbg78d503514109"
msgid "I assume this mark has a purpose."
msgstr "이 표식은 용도가 따로 있는 거겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = Narrator
#. NodeID = eef92822-a358-3779-82ab-48e41adab935
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:eef92822-a358-3779-82ab-48e41adab935
msgctxt "hfb870e48gaa7ag430cgbe65g8ffac9cae55c"
msgid ""
"*Darkness seems to swallow the temple, leaving you with a vision of the "
"goblin priestess, receiving instruction from a handsome young man. One of "
"the Chosen...*"
msgstr ""
"*어둠이 신전을 집어삼킨 뒤, 잘생긴 청년에게 가르침을 받는 고블린 여사제의 모습이 당신에게 나타납니다. 선택받은 자들 중 "
"하나입니다...*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = True Soul Gut
#. NodeID = f510a98c-b2b9-9ffd-c302-2c53f0a8ff74
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:f510a98c-b2b9-9ffd-c302-2c53f0a8ff74
msgctxt "hb6369cc1ga852g4e6bga109ga4ba4cba1eec"
msgid "Whole camp'll be branded soon. An' you should be, too."
msgstr "곧 야영지 전체에 낙인이 새겨질 것이다. 너 또한 마찬가지다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = Player
#. NodeID = f815b91e-708b-e366-ea1e-f581cf231241
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:f815b91e-708b-e366-ea1e-f581cf231241
msgctxt "h23d6373cga940g49ecg8b36ge023bf11b9a5"
msgid "<i>Hold out your hand.</i>"
msgstr "<i>손을 내민다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding
#. Speaker = Player
#. NodeID = faea9537-044b-a563-a834-b8163936ca5f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Branding:faea9537-044b-a563-a834-b8163936ca5f
msgctxt "h4990f00bg8fd8g4cf2g9546g5ba5144e18db"
msgid "I'm not letting you burn me for life on a whim."
msgstr "내 살에 영구적인 화상을 입히게 두진 않을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Cellar
#. Speaker = True Soul Gut
#. NodeID = 0f2d5806-d325-1319-f6cc-d1007ae43744
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_GoblinPriest_Event_AwaitCeremorphosis(0) = True
#.      - GOB_GoblinPriest_Quest_WasChained(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Cellar:0f2d5806-d325-1319-f6cc-d1007ae43744
msgctxt "h5b351a8fgb8d9g4511gb7f2gc052d307e950"
msgid "What are you doing in here?"
msgstr "여기서 뭐 하는 거냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Cellar
#. Speaker = True Soul Gut
#. NodeID = 5795dead-e436-8412-c60f-608ae21670d3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Cellar:5795dead-e436-8412-c60f-608ae21670d3
msgctxt "hd4809c7ag103dg425fgafa9g7b950765bcea"
msgid "I'm gonna split your head open!"
msgstr "너의 머리를 갈라주마!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Cellar
#. Speaker = True Soul Gut
#. NodeID = ae548d90-03a4-eb17-63e5-38b3d335da30
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_GoblinPriest_Event_AwaitCeremorphosis(0) = True
#.      - GOB_GoblinPriest_Quest_WasChained(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Cellar:ae548d90-03a4-eb17-63e5-38b3d335da30
msgctxt "h955cd87eg57ebg4c93g8536gb5ccf5eccccb"
msgid "You ain't going nowhere!"
msgstr "넌 아무 데도 못 가!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Cellar
#. Speaker = True Soul Gut
#. NodeID = b8e7cac8-2672-e82b-e76c-b49373baf131
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_GoblinPriest_Quest_PlayerEscaped = True
#.   Object:
#.      - GOB_GoblinPriest_Quest_WasChained(1) = True
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Cellar:b8e7cac8-2672-e82b-e76c-b49373baf131
msgctxt "h866b4517g4edeg4fd1ga4fbgc88ae136846a"
msgid "How'd you escape? I'll chop you to messes!"
msgstr "어떻게 도망친 거야? 내 널 썰어서 다져주마!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Cellar
#. Speaker = True Soul Gut
#. NodeID = c5c19d01-47d8-024c-5b07-13dcd6a2ddff
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_GoblinPriest_Quest_PlayerEscaped = True
#.   Object:
#.      - GOB_GoblinPriest_Quest_WasChained(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Cellar:c5c19d01-47d8-024c-5b07-13dcd6a2ddff
msgctxt "h7a544300gad23g425dgb54ege8c43bcbd5ec"
msgid ""
"Careful - there's monsters on the loose. And I ain't talking about worgs and "
"ogres."
msgstr "조심해. 괴물들이 풀려났으니까. 워그나 오우거 따위를 말하고 있는 게 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Cellar
#. Speaker = True Soul Gut
#. NodeID = c9d884f5-85a8-c53d-ff78-a21f6cabcb8f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Cellar:c9d884f5-85a8-c53d-ff78-a21f6cabcb8f
msgctxt "h9081e05eg203dg4be2ga50dg79cdc0881646"
msgid "Clear off!"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Cellar
#. Speaker = True Soul Gut
#. NodeID = e7b370bd-dd98-cc1d-fc5c-86b753aa604f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Cellar:e7b370bd-dd98-cc1d-fc5c-86b753aa604f
msgctxt "h538754e2g4079g4188gb8deg2bcdb93f69c6"
msgid "I'm gonna split your head open!"
msgstr "너의 머리를 갈라주마!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter
#. Speaker = Player
#. NodeID = 0c972ede-b573-f9fb-05d1-2bdc2c41a6cf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter:0c972ede-b573-f9fb-05d1-2bdc2c41a6cf
msgctxt "hcf40b628gde1fg42ecgb83dgd066da1c3429"
msgid "I am the Blade of Frontiers. You don't frighten me."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter
#. Speaker = Player
#. NodeID = 0e9f7cd9-7e8c-ae02-1e75-e8c7fdee9e24
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter:0e9f7cd9-7e8c-ae02-1e75-e8c7fdee9e24
msgctxt "h1037e6feg86bfg4689ga168g9c48af43d1e5"
msgid "I'll make you pay for this, goblin."
msgstr "이 일의 대가를 치르게 해주마, 고블린."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter
#. Speaker = Player
#. NodeID = 115444f7-f9dc-fa7b-94ee-f194ad7d6f30
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter:115444f7-f9dc-fa7b-94ee-f194ad7d6f30
msgctxt "h13146b09g44b7g4099g86c9g6985eda55da8"
msgid "I am Lae'zel. And I have slaughtered the likes of you ten times over."
msgstr "난 레이젤이다. 그리고 너 같은 족속들은 수도 없이 베어왔지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter
#. Speaker = True Soul Gut
#. NodeID = 1302ac42-f42f-4848-f9f2-0bbc61a5e56f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter:1302ac42-f42f-4848-f9f2-0bbc61a5e56f
msgctxt "h305f7b28ge38eg415agbc7dg3f64b2703b5a"
msgid "Stop trying to confuse me. You're a liar."
msgstr "날 동요시키려 하지 마. 이 거짓말쟁이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter
#. Speaker = True Soul Gut
#. NodeID = 16b46ec4-3bb5-53a0-d151-2c9169b0cc2a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter:16b46ec4-3bb5-53a0-d151-2c9169b0cc2a
msgctxt "h8ce5a256gffd5g40d4g84e6g560a93e01e6c"
msgid "Think you're special, do you? You're not."
msgstr "네가 특별하다고 생각하는 건가? 그렇지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter
#. Speaker = True Soul Gut
#. NodeID = 1c5f4df4-f4d7-8cc9-a785-5ac7ac6e51c4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_GoblinPriest_Event_AwaitCeremorphosis(0) = True
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter:1c5f4df4-f4d7-8cc9-a785-5ac7ac6e51c4
msgctxt "hc3ae4cffg1c0dg47deg8f81ga52919c94986"
msgid ""
"You're so handsome when you're angry, pet. Pity those looks'll be torn open "
"before long. Ah well..."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter
#. Speaker = True Soul Gut
#. NodeID = 1c5f4df4-f4d7-8cc9-a785-5ac7ac6e51c4
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_GoblinPriest_Event_AwaitCeremorphosis(0) = True
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter:1c5f4df4-f4d7-8cc9-a785-5ac7ac6e51c4
msgctxt "hec095d17ge80cg41c7g8e97gc3c1df19e2c4"
msgid ""
"You're so pretty when you're angry, pet. Pity those looks'll be torn open "
"before long. Ah well..."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter
#. Speaker = True Soul Gut
#. NodeID = 1c5f4df4-f4d7-8cc9-a785-5ac7ac6e51c4
#. HandlePath = TaggedText[2].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_GoblinPriest_Event_AwaitCeremorphosis(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter:1c5f4df4-f4d7-8cc9-a785-5ac7ac6e51c4
msgctxt "h85ccf35egc9f4g4f41gbc43g56562b2aea96"
msgid ""
"You're so adorable when you're angry, pet. Pity those looks'll be torn open "
"before long. Ah well..."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter
#. Speaker = True Soul Gut
#. NodeID = 1fb863d6-99d7-2e04-3cbe-52601f094813
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter:1fb863d6-99d7-2e04-3cbe-52601f094813
msgctxt "h12c33fd8gaeb0g4818g8753ge069ab551950"
msgid "Do you even know who you are anymore?"
msgstr "네가 누군지는 알고 있나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter
#. Speaker = Player
#. NodeID = 22856a7b-cee4-7a0b-1d44-c81f0ba85acf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter:22856a7b-cee4-7a0b-1d44-c81f0ba85acf
msgctxt "h669f133dg10deg4a1fg9699g5b9da4c76d4d"
msgid "I have... powers. Something's changing in me."
msgstr "나에게... 힘이 있다. 내 안에서 뭔가가 변하고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter
#. Speaker = True Soul Gut
#. NodeID = 28af7fbb-c5ef-3720-6c58-297bafedc74c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter:28af7fbb-c5ef-3720-6c58-297bafedc74c
msgctxt "h784b6a6bgc878g4439g8d22g4c87e779dd3e"
msgid ""
"It's not me you need to be frightened of - it's what that thing in your head "
"is gonna do to you."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter
#. Speaker = True Soul Gut
#. NodeID = 3af5e161-33f4-6371-1d26-39cb01233ded
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter:3af5e161-33f4-6371-1d26-39cb01233ded
msgctxt "h8e330586g0f4eg445ag96b3g92b96dd08fa4"
msgid ""
"And I know what happens next. Your teeth fall out, your skin rips off, and "
"you turn into one of them."
msgstr "그 다음에 무슨 일이 벌어질지도 알고 있단다. 넌 이빨이 빠지고, 피부가 벗겨진 뒤, 그것들 중 하나로 변하겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter
#. Speaker = Player
#. NodeID = 40ef1770-be14-c491-87fd-fe0bfcd43025
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter:40ef1770-be14-c491-87fd-fe0bfcd43025
msgctxt "h764e37e8gce8dg4b7bgb7a2g56dcb1b9f026"
msgid "I know I'm going to kill you. How about that?"
msgstr "내가 너를 죽일 거라는 건 알고 있지. 어때?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter
#. Speaker = Player
#. NodeID = 41cef891-78ee-a320-9f5a-c5fc282743e3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter:41cef891-78ee-a320-9f5a-c5fc282743e3
msgctxt "h5fd59bf8ge685g4662g9574g8e6830896ce1"
msgid "You won't live to see it, trust me."
msgstr "너는 살아서 그 모습을 볼 수 없을 거야. 내 장담하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter
#. Speaker = True Soul Gut
#. NodeID = 42736227-5f9f-dab1-e928-5d9c19d998d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter:42736227-5f9f-dab1-e928-5d9c19d998d0
msgctxt "h7eb51178gfa4ag48f9g933dg16154918dbf5"
msgid ""
"That creature's turning your brain into broth, boiling away your memories."
msgstr "그 생물은 너의 기억을 삶으면서 네 뇌를 국물로 만들고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter
#. Speaker = True Soul Gut
#. NodeID = 4ff048a5-7e0b-9364-0289-b29ae7e2ccad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter:4ff048a5-7e0b-9364-0289-b29ae7e2ccad
msgctxt "hdd23919dg2789g40e7g8486g8868796ede66"
msgid ""
"Can't beat you too hard, though. Got to keep you alive for what comes next."
msgstr "그래도 너무 세게 때릴 순 없지. 다가올 일을 위해 널 살려둬야 하니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter
#. Speaker = True Soul Gut
#. NodeID = 51e8e011-ddc1-d4b2-1705-a6921477e7e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter:51e8e011-ddc1-d4b2-1705-a6921477e7e2
msgctxt "h40911aeag61bfg45d2ga05eg9ffe9b5468d6"
msgid "I know that much. I saw the whole horrible story in your memories."
msgstr "그건 잘 알고 있어. 네 기억 속에서 불쾌한 줄거리를 전부 봤으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter
#. Speaker = True Soul Gut
#. NodeID = 55338d02-d197-11d7-3849-741cb0098ad6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter:55338d02-d197-11d7-3849-741cb0098ad6
msgctxt "hc00a0a60g956fg486fgaa74gc4a53825173f"
msgid ""
"If I set you free, you'll be sucking out my brains as soon as I turn my "
"back. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter
#. Speaker = True Soul Gut
#. NodeID = 5eebcddd-8ad3-f0ae-1621-02b97faa38da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter:5eebcddd-8ad3-f0ae-1621-02b97faa38da
msgctxt "hfd48dd20g39bcg49a1g88acga8569712884a"
msgid "It's too late to help you. It already was."
msgstr "널 돕기에는 너무 늦었어. 이미 한참 전에도 늦었지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter
#. Speaker = Player
#. NodeID = 5fd0dbf7-5776-b4ae-44b2-aaa052084be1
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Strength
#. DifficultyClass: 20
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter:5fd0dbf7-5776-b4ae-44b2-aaa052084be1
msgctxt "hdf0430c7g00c4g46eag858ag55a50c22c004"
msgid "<b><i>BREAK FREE.</i></b>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter
#. Speaker = True Soul Gut
#. NodeID = 61c07f4d-790a-c12d-ddbb-a7e6b64a4fd1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter:61c07f4d-790a-c12d-ddbb-a7e6b64a4fd1
msgctxt "h637cb244g31a9g4882g98e1g2080e38c71fd"
msgid "Maybe that's wot the creature <i>wants</i> you to think. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter
#. Speaker = True Soul Gut
#. NodeID = 6268262f-b505-b860-13d5-84f077f4abf6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter:6268262f-b505-b860-13d5-84f077f4abf6
msgctxt "h1dfc99b6gb173g4492gb89bg896f969dce62"
msgid ""
"You might think you're in charge - but you ain't a drow anymore. Yer a <i"
">flesh-puppet</i>."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter
#. Speaker = Player
#. NodeID = 640d0f71-4b44-7a5b-d565-ed6ff839c20c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_GobilinPriest_ToldInfected(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter:640d0f71-4b44-7a5b-d565-ed6ff839c20c
msgctxt "h29593f32g2c78g43d2gb13cgbcbf07f15d45"
msgid "You're infected. It's going to happen to you, too."
msgstr "너는 감염되었어. 그 일이 너에게도 일어날 수 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter
#. Speaker = True Soul Gut
#. NodeID = 67b24cd2-573e-1cd5-2aa5-41aa7e8f828a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter:67b24cd2-573e-1cd5-2aa5-41aa7e8f828a
msgctxt "h4a33736ag88cfg45c3gbfa5ge3bcab64c19a"
msgid "Powers? No. They're delusions. That thing's eating your brain."
msgstr "힘? 아니, 그건 망상이다. 괴물이 네 뇌를 먹고 있다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter
#. Speaker = True Soul Gut
#. NodeID = 6bb82654-ce26-57b0-9cba-a4e6df1b1d6e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter:6bb82654-ce26-57b0-9cba-a4e6df1b1d6e
msgctxt "h8fd55ed1ge696g40aag9197g8d5386f561e7"
msgid ""
"But you? You're on your own. Nothing more than a skin-suit for that monster "
"inside you."
msgstr "하지만 넌? 혼자잖아. 네 안의 그 괴물을 위한 허물일 뿐이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter
#. Speaker = Player
#. NodeID = 6bc4030f-2048-945d-f3b0-877094ec6c0b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter:6bc4030f-2048-945d-f3b0-877094ec6c0b
msgctxt "hb0f86baag8150g44a5gad12ga7b8d87ae6c7"
msgid "I was abducted... A mind flayer infected me with this thing."
msgstr "나는 납치되었어... 어떤 마인드 플레이어가 그걸로 나를 감염시켰지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter
#. Speaker = True Soul Gut
#. NodeID = 6dffe431-9606-5349-0d56-3bb8479f8beb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter:6dffe431-9606-5349-0d56-3bb8479f8beb
msgctxt "hd81fe8ebge0bag41cegbbaag13c9a838262f"
msgid "Lies! I'm stronger than ever. And I've got the Absolute on my side."
msgstr "거짓말! 난 어느 때보다 강해. 그리고 내 편에는 절대자님이 계신다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter
#. Speaker = Player
#. NodeID = 74733088-10da-345e-d28c-0ddca7a911dc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter:74733088-10da-345e-d28c-0ddca7a911dc
msgctxt "h68f6e396g8db6g4d7fgb1beg017d7ec4efb0"
msgid "I am the Demonsbane, champion of Avernus. You don't frighten me."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter
#. Speaker = Player
#. NodeID = 82f75e30-22dc-8478-8034-3e439da59abb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter:82f75e30-22dc-8478-8034-3e439da59abb
msgctxt "h227f1d72ga672g4fd3gbee7ga65a6f98706b"
msgid "<i>Wail a rabid scream.</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter
#. Speaker = True Soul Gut
#. NodeID = 849f8020-a7b0-1561-95c3-473362ba993d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter:849f8020-a7b0-1561-95c3-473362ba993d
msgctxt "hbe2c1b58gba53g4ebfgb288g2d12eb361c7c"
msgid "Wakey wakey. Don't bother strugglin' - you ain't goin' nowhere."
msgstr "기상 기상. 넌 아무 데도 갈 수 없으니 힘들게 애쓰지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter
#. Speaker = True Soul Gut
#. NodeID = 859ae0c0-85c1-53ae-a2d8-13e8947d9942
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter:859ae0c0-85c1-53ae-a2d8-13e8947d9942
msgctxt "h08340ab3gcd32g491fg9304g70a41e9e1353"
msgid ""
"Liar! We've both seen the monster that put it there. And I know what happens "
"next."
msgstr "거짓말쟁이! 우리 둘 다 거기에 올챙이를 넣는 괴물을 봤잖아. 그 다음에 무슨 일이 일어날지 난 알고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter
#. Speaker = True Soul Gut
#. NodeID = 9cbb2f48-b932-5d58-9174-e20af0375152
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_GoblinPriest _HearVoiceOfGod = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter:9cbb2f48-b932-5d58-9174-e20af0375152
msgctxt "hee97af9cg0d4bg430fgabbbg2bfbb9168fe8"
msgid ""
"The Absolute wants to know all about that critter in your head. So start "
"talkin'!"
msgstr "절대자님은 네 머릿속에 있는 그 생물에 대해 알고 싶어하신다. 그러니 입을 열거라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter
#. Speaker = True Soul Gut
#. NodeID = a0202e80-2b71-7de4-f4cf-b92cb15394d7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter:a0202e80-2b71-7de4-f4cf-b92cb15394d7
msgctxt "hb828e666gb2c1g4117g91c7gf9258eeae67f"
msgid ""
"And I don't have to do nothing but wait. That thing inside your head is "
"gonna eat your brain from the inside out."
msgstr "그리고 난 아무것도 하지 않고 기다리기만 하면 돼. 네 머릿속의 그 괴물이 네 뇌를 안에서부터 먹어치울 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter
#. Speaker = True Soul Gut
#. NodeID = a4154e23-cb36-d77f-dc78-1e3591d55cc6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter:a4154e23-cb36-d77f-dc78-1e3591d55cc6
msgctxt "h2a58215dga242g49f2g947bgf8d50e06b6c3"
msgid "You'll pay for talking back!"
msgstr "넌 말대꾸한 대가를 치르게 해주마!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter
#. Speaker = Player
#. NodeID = a8c07d38-ba40-a1cf-a1cb-efc9e249f01f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter:a8c07d38-ba40-a1cf-a1cb-efc9e249f01f
msgctxt "hcc4224c4g9e25g46f8gaecfgbb5f30f727c0"
msgid "Then stop this! Heal me."
msgstr "그럼 그걸 멈춰줘! 나를 치유해달란 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_ChainedCharacter
#. Speaker = True Soul Gut
