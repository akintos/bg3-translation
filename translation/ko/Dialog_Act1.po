msgctxt "hd917fee0g74bcg4228gbb6eg862dfb59c8f5"
msgid "I could drown in that song..."
msgstr "이 노래에 파묻혀도 좋아..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerCharmed
