msgctxt "h3c7e4a29gbda8g4315ga396gaa4f3db9aba0"
msgid "<i>Scan his mind.</i>"
msgstr "<i>그의 생각을 읽는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = bd50e05b-1048-6d95-7954-3ee6e9af6af7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_DrunkGoblin_Event_StartFistFight(4) = True
