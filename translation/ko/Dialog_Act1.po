msgctxt "h7df6e45bgfde4g4526g858dg630552fda9ea"
msgid "Well? Tell me everything."
msgstr "자 그럼 다 털어놔 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/AstralPlane/CRE_AstralPrison_PAD_ComingOutOfCave
#. Speaker = Player
#. NodeID = ddb20ef1-7153-4d38-9f66-ad5b04757510
#. HandlePath = TaggedText[6].TagText[0]
