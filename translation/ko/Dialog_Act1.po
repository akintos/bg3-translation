#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation:b229b2db-7594-2bb4-84ef-f289a1a4abb7
msgctxt "h06dbd042gaf79g4fe3g811fg1a1503b3d6ee"
msgid "<i>Read her mind.</i>"
msgstr "<i>그녀의 생각을 읽는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation
#. Speaker = GROUP_Act1_GOB_Festivities
#. NodeID = bb8ce079-7ebe-d650-3ea0-82e38a28088c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_GoblinToast_PlayerWasNoticedPoisoning(1) = False
#.      - GOB_GoblinToast_GoblinNoticedPoisoning(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation:bb8ce079-7ebe-d650-3ea0-82e38a28088c
msgctxt "h7d2f0b0fg1e0ag47e8ga69fgbefd30a66027"
msgid "You! Outsider! You poisoned us!"
msgstr "너! 외지인 자식! 네 녀석이 독을 탔지!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation
#. Speaker = GROUP_Act1_GOB_Festivities
#. NodeID = c086f22e-4f6a-f9da-cae5-a693e32c652b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation:c086f22e-4f6a-f9da-cae5-a693e32c652b
msgctxt "h2d2d8c3cg8427g49c1g978ag5f65e66471f6"
msgid "P-please don't! I won't rat you out, I swear! J-just leave me be."
msgstr "제, 제발 하지 마세요! 밀고하지 않겠습니다. 맹세합니다! 그냥 저를 내버려 두세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation
#. Speaker = GROUP_Act1_GOB_Festivities
#. NodeID = cdb8446f-82b6-6d20-d1f9-b7ab2e301d9e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_GoblinToast_State_ConfrontedAboutPoisoning = True
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation:cdb8446f-82b6-6d20-d1f9-b7ab2e301d9e
msgctxt "hfd504babgcf58g412fg8207g15cbef50515b"
msgid "What are you... this one's tryin' to control my mind or somethin'!"
msgstr "지금 무슨... 이 녀석이 내 정신을 조종하려는 건지 뭘 건든다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation
#. Speaker = Narrator
#. NodeID = d0962252-20fb-97a1-2c0a-eec25fb3bd74
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount4(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount4(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation:d0962252-20fb-97a1-2c0a-eec25fb3bd74
msgctxt "h28b257a5g7ae2g4651g9142gfcafedcf8b46"
msgid ""
"*A shadow swims across your vision, and a familiar voice tells you to be "
"calm. You are loved.*"
msgstr "*그림자가 낀 듯이 눈앞이 흐려지더니, 익숙한 목소리가 당신을 달래줍니다. 사랑이 느껴집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation
#. Speaker = GROUP_Act1_GOB_Festivities
#. NodeID = d4d31b6f-8a17-1927-d6e7-5e69b61bb0c3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_GoblinToast_State_ConfrontedAboutPoisoning = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation:d4d31b6f-8a17-1927-d6e7-5e69b61bb0c3
msgctxt "hde82c034g3d7eg405agb3bag23a80298c463"
msgid ""
"A-allergic? You mean just the beer can kill us?! G-get out of my way. I need "
"some fresh air."
msgstr "아, 알레르기? 지금 맥주 때문에 우리가 죽을 수도 있다고? 비, 비켜! 바람 좀 쐬어야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation
#. Speaker = Narrator
#. NodeID = e12d3ffd-c5b9-6c78-8bfa-a6438c5db1ee
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation:e12d3ffd-c5b9-6c78-8bfa-a6438c5db1ee
msgctxt "h5491cd80gf016g4c47g9563g419e19dc5edc"
msgid "*A shiver runs across your mind... You feel sated.*"
msgstr "*전율이 불현듯 머릿속을 스쳐 지나가고... 만족감이 듭니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation
#. Speaker = Player
#. NodeID = e2fd8487-3b33-77cf-3961-ef9272f27f7c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation:e2fd8487-3b33-77cf-3961-ef9272f27f7c
msgctxt "h44bd5c18g75dbg439bg813eg07764c6d56c4"
msgid "If I'd poisoned you, do you really think I'd still be here?"
msgstr "내가 독을 탔다면, 아직 여기서 이러고 있겠어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation
#. Speaker = GROUP_Act1_GOB_Festivities
#. NodeID = ecd167b2-f957-11c8-9f0d-c18b720a3ae2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation:ecd167b2-f957-11c8-9f0d-c18b720a3ae2
msgctxt "h108416a9g234cg4f50g84b9ga1b6ef39b276"
msgid "You! You poisoned us!"
msgstr "너! 네 녀석이 독을 탔지!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation
#. Speaker = Narrator
#. NodeID = fa0a978c-f371-c7c5-0727-1053aba6309c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Tag:
#.     - TRUESOUL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_PoisoningInterrogation:fa0a978c-f371-c7c5-0727-1053aba6309c
msgctxt "hba13a0e9g5c66g4d6cg902egb90cbaf0943f"
msgid ""
"*Your mind is full, bursting with ecstasy and terror. Finally, it is coming. "
"You are becoming.*"
msgstr "*당신의 정신이 황홀경과 공포로 가득 차오릅니다. 마침내, 때가 됐군요. 당신은 변화 중입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinWily
#. Speaker = Tracker Tozad
#. NodeID = 50254d64-ce2e-0622-fb75-5fd64c063b40
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_GoblinWily_HasMet(1) = False
