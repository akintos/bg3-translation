msgctxt "hb3e5bde0ga758g4198ga00cgba37f0bd42e7"
msgid "<i>*Squeak.*</i>"
msgstr "<i>*찍찍.*</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RatRacket_LocalRat_002
#. Speaker = Narrator
