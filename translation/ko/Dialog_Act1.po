msgid ""
"'E... 'e kissed someone's feet. D'you think...?  I... I wonder what it's "
"like..."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_Friend1
