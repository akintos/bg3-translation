#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_AdamantineForge_PAD_ForgingIncomplete:dea6118f-63b8-419e-83c6-49fe06f11244
msgctxt "h58835f4dgdc15g420eg958bgf9765aa9c088"
msgid ""
"The hammer can't do much without a little heat to move things along. The "
"lava."
msgstr "망치가 움직이려면 열기가 필요해. 용암이면 되겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_AdamantineForge_PAD_ForgingIncomplete
#. Speaker = Player
#. NodeID = dea6118f-63b8-419e-83c6-49fe06f11244
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_AdamantineForge_State_HaveCrafted = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_AdamantineForge_PAD_ForgingIncomplete:dea6118f-63b8-419e-83c6-49fe06f11244
msgctxt "hd4faff0eg76fcg4bbag9da4gc8eeee4d3b57"
msgid "Ore and mould - but they still need the lava to bind them."
msgstr "광석과 주형은 준비됐어 - 하지만 두 개를 결합하려면 용암이 있어야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_AdamantineForge_PAD_SpawnedEnemies
#. Speaker = Player
#. NodeID = 83fb75ce-ca5c-4160-bd53-15fe794c0ad8
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
