msgid "*In spite of your reservations, they're telling the truth.*"
msgstr "*당신의 의심에도 불구하고, 그들은 진실을 말하고 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/AstralPlane/CRE_AstralPrison_Daisy
#. Speaker = Player
#. NodeID = 4728e42e-1c78-452c-574c-ffbda1340a25
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/AstralPlane/CRE_AstralPrison_Daisy:4728e42e-1c78-452c-574c-ffbda1340a25
msgctxt "h24f8db44ga96dg4a74g8212ge3434ff89a93"
msgid "What's the power?"
msgstr "그 힘이 대체 뭐지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/AstralPlane/CRE_AstralPrison_Daisy
#. Speaker = GROUP_Daisy
#. NodeID = 4806415f-b8b5-1fb5-4bf6-4ba1ccf42bc8
