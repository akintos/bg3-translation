#.      - BARBARIAN(1) = True
#. SetFlags:
#.   Dialog:
#.     - PLA_DoubtingArtist_State_FailPriceLowered(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03:502af067-4de0-6bc7-0fb7-4cbb503085b4
msgctxt "h1d644607ga688g411egbf28g23cf5f36ee75"
msgid ""
"Too much. Cut your price down to size or I'll cut <i>you </i>down to size."
msgstr "너무 비싸. 가격을 줄이지 않으면 <i>당신을</i> 조각내서 크기를 줄여주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03
#. Speaker = Brem
#. NodeID = 53928605-45a3-14eb-9ccd-7b492452c87a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03:53928605-45a3-14eb-9ccd-7b492452c87a
msgctxt "h5ae34e14ge7cag40e6g8db4g408a25924e78"
msgid "The price is the price. Pay up or get lost."
msgstr "가격은 가격입니다. 지불하거나 꺼지세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03
#. Speaker = Player
#. NodeID = 5867f4be-1d15-615f-7fd7-89cd66096241
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_DoubtingArtist_State_Dead = False
#.      - PLA_DoubtingArtist_Knows_Kidnapped = True
#.      - PLA_DoubtingArtist_Event_FreedByPersuade = False
#.   Quest:
#.      - GLO_DoubtingArtist.ZhentDungeon_FreedByBribe(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03:5867f4be-1d15-615f-7fd7-89cd66096241
msgctxt "hcfb762fagea62g4e49g9b16g5accf28b391e"
msgid "I'm here to buy your prisoner."
msgstr "당신의 인질을 사러 왔어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03
#. Speaker = Player
#. NodeID = 5c2fbb05-3e48-79a0-4c74-1ed33ca705dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03:5c2fbb05-3e48-79a0-4c74-1ed33ca705dc
msgctxt "h1f6e4f0dg91f8g4eb1gaa64g29dacc90f4d9"
msgid "I want to trade."
msgstr "거래를 하고 싶어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03
#. Speaker = Player
#. NodeID = 62ef7345-f851-8d48-83e8-e7a66fd591c4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_DoubtingArtist_State_Dead = False
#.      - PLA_DoubtingArtist_Knows_Kidnapped = True
#.      - PLA_DoubtingArtist_Event_FreedByPersuade = False
#.   Quest:
#.      - GLO_DoubtingArtist.ZhentDungeon_FreedByBribe(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03:62ef7345-f851-8d48-83e8-e7a66fd591c4
msgctxt "hbe86c16dg7bb3g4968ga6bbga5ddb1185aa0"
msgid "It's not the art I want to buy - it's the artist."
msgstr "내가 사고 싶은 건 예술 작품이 아니라 예술가야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03
#. Speaker = Brem
#. NodeID = 655b38c0-32a1-bf9e-3ec0-0a102d4b450d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_ZhentDungeon_Zhent03_HasMet(1) = True
#.      - PLA_ZhentDungeon_Zhent03_FailedPersuade(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03:655b38c0-32a1-bf9e-3ec0-0a102d4b450d
msgctxt "hcb1ccfebgc47eg4ae7g81f3g670f341c54ab"
msgid "Well now! If we're talking, my guess is you've got coin to spend."
msgstr "자 이제! 이런 대화를 나눈다는 건, 당신이 쓸 돈이 있다는 뜻이겠지요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03
#. Speaker = Brem
#. NodeID = 692131ee-9e10-7db3-2037-b9df20538133
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentDungeon_State_AllowedSpecialTrade = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03:692131ee-9e10-7db3-2037-b9df20538133
msgctxt "hf38e10b2g9494g4505g9577g7ed6fd061092"
msgid "Plenty, if the finer things don't appeal."
msgstr "충분하죠, 비싼 것들이 마음에 들지 않으신다면 말입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03
#. Speaker = Brem
#. NodeID = 715b840f-e18f-00c7-dd54-09b0106f2a34
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Quest:
#.      - GLO_DoubtingArtist.ZhentDungeon_LowerPrice(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03:715b840f-e18f-00c7-dd54-09b0106f2a34
msgctxt "h847a13e4g68a3g40c0g9f16g74c3f69a8644"
msgid ""
"Then it's the same price I gave you before. No more haggling. "
"([GEN_CheckMagicPocketGold_2_463b0f43-5410-412d-aba3-875cf81c38ca])"
msgstr ""
"그렇다면 저번에 말씀드린 것과 같은 가격이겠군요. 더 이상 흥정해 드릴 순 없습니다. "
"([GEN_CheckMagicPocketGold_2_463b0f43-5410-412d-aba3-875cf81c38ca])"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03
#. Speaker = Player
#. NodeID = 742abf0f-52cf-3730-df47-71f280d6984a
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 20
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03:742abf0f-52cf-3730-df47-71f280d6984a
msgctxt "h84288702g319ag4ac2ga4ccgec0d462cd638"
msgid "If he's as talented as you say, someone will be looking for him."
msgstr "만약 당신 말대로 그가 재능 있다면, 누군가가 그를 찾고 있겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03
#. Speaker = Player
#. NodeID = 7603357c-3859-40c2-6301-a0371a5d0e93
#. HandlePath = TaggedText[0].TagText[0]
