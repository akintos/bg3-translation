msgctxt "h5dc777dag8f8dg470bg94beg6fdd357759d4"
msgid "Hush now. Go back to sleep."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinSleeper_02
#. Speaker = Player
#. NodeID = 326fddd0-4c8a-08ee-6a14-b767e0d8b965
