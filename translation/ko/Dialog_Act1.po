#.      - HALFLING(1) = True
#. SetFlags:
#.   Local:
#.     - 3d850796-62b9-081e-45e7-a4bfd2041faf_B = False
#.     - 3d850796-62b9-081e-45e7-a4bfd2041faf_A = False
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_AD_ViciousMockery:ef5ecf8b-8a9b-1532-f5d3-6c2939241957
msgctxt "h83b7ebd1g430cg4389ga88dg6d3d37c51980"
msgid "A tiny, sweet morsel. Just for me."
msgstr "나만을 위한 작고 달콤한 한 입 거리구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_AD_ViciousMockery
#. Speaker = Auntie Ethel
#. NodeID = f2a89c35-1e47-e859-0eea-9a927970f53b
