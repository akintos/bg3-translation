msgctxt "hb2a837e7gdbdcg44e2ga047g860920afe3f5"
msgid "Are you the only hag around here?"
msgstr "이 주변에 해그는 너뿐인가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead
#. Speaker = Auntie Ethel
#. NodeID = ff09509c-10dd-7e6b-f4d8-f84d6bc471a8
#. HandlePath = TaggedText[0].TagText[0]
