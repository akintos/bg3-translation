msgctxt "h723d26f6g941dg487bg8e90gd4f0f1056ea4"
msgid ""
"<i>Ghaik</i> have infected this land. I need this crèche's help to purify it."
msgstr "<i>게이크</i>가 이 땅을 감염시켰다. 정화를 위해 이 양성소의 도움이 필요하다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointWarning
#. Speaker = Player
#. NodeID = 5708995f-e2dd-3c3d-a811-65bdaf1966e0
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointWarning:5708995f-e2dd-3c3d-a811-65bdaf1966e0
msgctxt "hc4ca56ebgc7c9g4e16gb9c0ga8e00d79be67"
msgid ""
"A nautiloid crashed on your doorstep. Illithids are infecting the "
"population. I need your help."
msgstr "노틸로이드가 너희 앞마당에 떨어졌고, 일리시드가 사람들을 감염시키고 있다. 도움이 필요하다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointWarning
#. Speaker = Player
#. NodeID = 6904caf4-b791-c105-0c5a-c750e775a25c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointWarning:6904caf4-b791-c105-0c5a-c750e775a25c
msgctxt "hfd2ffcbcga269g4cb0gb5aag33bfccabcd89"
msgid "I have important business with your <i>Kith'rak</i>. Step aside."
msgstr "너희 <i>키스락</i>에게 중요한 용무가 있다. 비켜라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointWarning
#. Speaker = Warrior Khunaruth
#. NodeID = 9ce0679d-0e14-c841-fbe7-5926350f43d5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_UpperGuards_State_GainedAccess = False
#.      - CRE_UpperGuards_State_MainPrimaryGuardDefeated = True
