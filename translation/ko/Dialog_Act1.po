msgctxt "h4cca38ffg191bg40f0gac1eg7cdae4f90aa0"
msgid "We'll protect the grove, no matter the cost."
msgstr "무슨 대가를 치르더라도, 우리는 숲을 지킬 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_Apprentice
