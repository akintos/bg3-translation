msgctxt "hb9518a1fgc9b9g4a2dga5b1ge46ce6c2dbb9"
msgid "Didn't want... the girl... wanted her... <i>babe. </i>"
msgstr "그녀를 원한 게... 아니야... 그녀의... <i>아기를 원했지. </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead
#. Speaker = Player
#. NodeID = feaf130c-5348-34dc-3ac2-a7ac03c2ecc0
