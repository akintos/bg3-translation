msgid "<i>Kneel in submission.</i> My duergar companion means you no harm."
msgstr "<i>복종의 의미로 무릎을 꿇는다.</i> 내 듀에르가 동료는 너에게 해를 가하려는 게 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002
#. Speaker = Narrator
#. NodeID = 19db5fcf-392e-f9a5-8281-ef82c0970021
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002:19db5fcf-392e-f9a5-8281-ef82c0970021
msgctxt "h38ce752dg3413g4b7eg977dg2c1e39aa0e7b"
msgid ""
"*You see a vision: your lifeless body, wrapped in fungal tendrils. The "
"sovereign is <i>threatening</i> you.*"
msgstr "*환상이 보입니다: 곰팡이 덩굴손에 싸인 생명 없는 당신의 몸입니다. 군주가 당신을 <i>위협하고</i> 있는 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002
#. Speaker = Sovereign Spaw
#. NodeID = 1f29420d-2ca1-c5d1-8a79-8ee1ba9441d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002:1f29420d-2ca1-c5d1-8a79-8ee1ba9441d0
msgctxt "h92ce01fegd18fg4441gb86agf122d9620cac"
msgid "((*descend to me. let us speak in flesh*))"
msgstr "((*내게 와라. 육체로 대화하자*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002
#. Speaker = Restless Myconid
#. NodeID = 21ba6d51-3a56-4f8e-6a34-cddd57a53ff3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_MyconidSovereignReward = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002:21ba6d51-3a56-4f8e-6a34-cddd57a53ff3
msgctxt "h9a380b01gbf94g43ceg965cgfe92a44ce6c1"
msgid "((*you are worthy. be among us*))"
msgstr "((*넌 자격이 있군. 우리와 함께해라.*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002
#. Speaker = Narrator
#. NodeID = 2a88f389-1744-5551-ab88-f03d58c294bf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_State_DuergarInParty = True
#.      - UND_MyconidCircle_State_GainedAccess = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002:2a88f389-1744-5551-ab88-f03d58c294bf
msgctxt "hdec5ac78gb363g4b3egae40g1a3e9ad27caa"
msgid ""
"*You are swallowed by a chorus of frenzied music. Through one creature sing "
"many voices: the harmony of a myconid collective.*"
msgstr "*당신은 광란의 음악에 집어삼켜집니다. 하나의 생명체가 다양한 목소리로 노래합니다: 마이크로니드 집단체의 화음입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002
#. Speaker = Player
#. NodeID = 40b7e0c6-8fd2-6bfa-2749-1f2761494830
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Local:
#.      - c9f41e9b-ee03-a40d-ec89-c332e0b175d4_PassedInsight = False
#.   Tag:
#.      - BARBARIAN(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002:40b7e0c6-8fd2-6bfa-2749-1f2761494830
msgctxt "h2b98f58fg8967g46fbg93d2g9a48134d7372"
msgid "If I wanted you dead, you would be. Don't tempt me."
msgstr "네가 죽길 바랐다면 벌써 그렇게 됐을 거다. 날 시험하지 마라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002
#. Speaker = Player
#. NodeID = 44c69f72-5309-bf0e-b4e4-ab0758fd4dd5
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 5
#. CheckFlags:
#.   Local:
#.      - c9f41e9b-ee03-a40d-ec89-c332e0b175d4_PassedInsight = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002:44c69f72-5309-bf0e-b4e4-ab0758fd4dd5
msgctxt "h783aaa99gda83g4215g93cbgb0ea1528da9b"
msgid "<i>Seek understanding. Focus on the sovereign's song.</i>"
msgstr "<i>이해하려고 한다. 군주의 노래에 집중한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002
#. Speaker = Narrator
#. NodeID = 46063b1f-1358-baea-2313-47edd8255f8a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002:46063b1f-1358-baea-2313-47edd8255f8a
msgctxt "h80c04fe9g1a52g4006g9b10g41e71e620710"
msgid "*The persistent music coaxes you forward. The sovereign expects you.*"
msgstr "*지속되는 음악이 당신에게 앞으로 나아가라고 구슬립니다. 군주가 당신을 기다립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002
#. Speaker = Player
#. NodeID = 476a0d4a-692d-cbb2-4bd4-c16fb964448c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Local:
#.      - c9f41e9b-ee03-a40d-ec89-c332e0b175d4_PassedInsight = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002:476a0d4a-692d-cbb2-4bd4-c16fb964448c
msgctxt "hec3013cfgb71bg4712g92c8gf0a9ed2d350d"
msgid "<i>Conjure tranquil memories in hopes of calming the sovereign.</i>"
msgstr "<i>군주를 진정시키기 위해 평온한 기억을 떠올린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002
#. Speaker = Restless Myconid
#. NodeID = 48e7244e-b4ae-86c5-c423-2afdb9695fc6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_State_DuergarInParty = True
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002:48e7244e-b4ae-86c5-c423-2afdb9695fc6
msgctxt "h632ce2e7g45c9g4681gace1ga9a3069de285"
msgid "((*Sovereign. he has come. the Rot has come*))"
msgstr "((*군주님. 그가 왔습니다. 썩은 자가 이곳에 당도했습니다.*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002
#. Speaker = Restless Myconid
#. NodeID = 48e7244e-b4ae-86c5-c423-2afdb9695fc6
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_State_DuergarInParty = True
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002:48e7244e-b4ae-86c5-c423-2afdb9695fc6
msgctxt "he3da383bgfcdeg413cgb660g2af8fd48283f"
msgid "((*Sovereign. she has come. the Rot has come*))"
msgstr "((*군주님. 그녀가 왔습니다. 썩은 자가 이곳에 당도했습니다.*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002
#. Speaker = Restless Myconid
#. NodeID = 48e7244e-b4ae-86c5-c423-2afdb9695fc6
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_State_DuergarInParty = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002:48e7244e-b4ae-86c5-c423-2afdb9695fc6
msgctxt "hb8bdae91g7f4bg4dbbg9a1fg0755ee99e028"
msgid "((*Sovereign. they have come. the Rot has come*))"
msgstr "((*군주님. 그 자가 왔습니다. 썩은 자가 이곳에 당도했습니다.*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002
#. Speaker = Restless Myconid
#. NodeID = 4aeb2730-b08d-c715-4aa3-d34a83d5ef2a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_SpokeWithSovereign = False
#.      - UND_MyconidCircle_State_GainedAccess = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002:4aeb2730-b08d-c715-4aa3-d34a83d5ef2a
msgctxt "h4abd6bacg8357g4f37gb28agd7a142dd7413"
msgid "((*hush. the Sovereign awaits*))"
msgstr "((*쉿. 군주께서 기다리신다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002
#. Speaker = Narrator
#. NodeID = 4dc021a1-68ce-fa2c-275f-6de1e4b8efd3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002:4dc021a1-68ce-fa2c-275f-6de1e4b8efd3
msgctxt "h9664e43ag2321g4da1g8ae4g1621168b397e"
msgid "*Fungal roots weave through your mind, poking you, warning you...*"
msgstr "*포자 뿌리가 찌르고 경고하면서 당신의 정신을 휘젓고 다닙니다...*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002
#. Speaker = Sovereign Spaw
#. NodeID = 4e5712b6-540c-7a81-c1b0-5738b001b1b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002:4e5712b6-540c-7a81-c1b0-5738b001b1b4
msgctxt "h0c1abc42gc053g4ffbgafacg647fc17bd6a7"
msgid "((*state your purpose*))"
msgstr "((*너의 목적을 말하라*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002
#. Speaker = Narrator
#. NodeID = 4f42b165-b7a7-2e6c-4cfc-b8c861615692
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002:4f42b165-b7a7-2e6c-4cfc-b8c861615692
msgctxt "hffff17e6g6212g444egb9c0gd8fcd69d0848"
msgid ""
"*The fright-choir fades. A single melody rises above the others, brassy and "
"commanding.*"
msgstr "*무서운 노래가 사그라듭니다. 깊게 울리며 두드러지는 단 하나의 멜로디가 다른 멜로디들 위로 떠오릅니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002
#. Speaker = Player
#. NodeID = 5e50789f-acf4-9d84-356e-9e161e783234
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule: PALADIN_ANCIENTS
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002:5e50789f-acf4-9d84-356e-9e161e783234
msgctxt "he566669dg4264g4063ga2d4g6c1b9390426f"
msgid "I am nature's bulwark. Where good things grow, I lend my protection."
msgstr "나는 대자연의 보루다. 좋은 것들이 자라는 곳에 나는 보호를 제공하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002
#. Speaker = Player
#. NodeID = 5e50789f-acf4-9d84-356e-9e161e783234
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule: PALADIN_DEVOTION
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002:5e50789f-acf4-9d84-356e-9e161e783234
msgctxt "h4cffcf60g9467g4f58gbe2dga7f6a79810e5"
msgid "To do what is right. To do my duty."
msgstr "옳은 일을 하는 것, 내 의무를 다하는 거지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002
#. Speaker = Player
#. NodeID = 5e50789f-acf4-9d84-356e-9e161e783234
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule: PALADIN_VENGEANCE and NOT_FOR_EA
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002:5e50789f-acf4-9d84-356e-9e161e783234
msgctxt "h47e06f2dg11beg429cga440gc788899b1d76"
msgid "I seek retribution for those who cannot."
msgstr "난 힘없는 이들을 위한 응징을 꾀한다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002
#. Speaker = Player
#. NodeID = 5e50789f-acf4-9d84-356e-9e161e783234
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule: OATHBREAKER
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002:5e50789f-acf4-9d84-356e-9e161e783234
msgctxt "hc3056b73g7570g440bgb8c8g9f06f471511f"
msgid "I have no 'purpose'. I simply <i>am</i>. That is enough."
msgstr "난 '목적'따윈 없어. 이게 단순히 <i>나란 존재</i>일 뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002
#. Speaker = Player
#. NodeID = 61bd5c83-05c0-0157-08fb-704ade18b597
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Local:
#.      - c9f41e9b-ee03-a40d-ec89-c332e0b175d4_PassedInsight = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002:61bd5c83-05c0-0157-08fb-704ade18b597
msgctxt "h4dc1b7ccg4240g4cccga34egfb78cebaf2ff"
msgid "I am a traveller seeking adventure."
msgstr "나는 모험을 갈구하는 여행자야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002
#. Speaker = Narrator
#. NodeID = 65cf28dc-b079-12b0-ad61-2fee01febbed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002:65cf28dc-b079-12b0-ad61-2fee01febbed
msgctxt "h8dd14b17ga5d0g4d84ga91ege50e4b78f319"
msgid "*The parasite is quiet. You feel no bond with the creature.*"
msgstr "*기생충이 조용합니다. 당신은 이 생명체와 어떠한 결속도 느끼지 못합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002
#. Speaker = Sovereign Spaw
#. NodeID = 755eb17d-4028-a43a-c74c-6af64e6b9259
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DUERGARDWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002:755eb17d-4028-a43a-c74c-6af64e6b9259
msgctxt "h72c0e528gea1ag4fc5ga722gc46a0f22df61"
msgid "((*<b>I am Sovereign. and you are duergar. you are <i>Rot</i></b>*))"
msgstr "((*<b>짐은 군주다. 너는 듀에르가군. 너는 <i>썩은 자</i>다.</b>*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002
#. Speaker = Player
#. NodeID = 7cd57f01-bc6c-ed02-7ef6-242c992f9864
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002:7cd57f01-bc6c-ed02-7ef6-242c992f9864
msgctxt "h9b90fecagf140g4860g8a65gf91cdece5b55"
msgid "Never you mind. Stand down, or be knocked down."
msgstr "네 알 바 아니다. 물러서지 않으면, 다칠 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002
#. Speaker = Player
#. NodeID = 80b03d57-3ffc-44a9-9286-ae8211311ef6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - c9f41e9b-ee03-a40d-ec89-c332e0b175d4_PassedInsight = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002:80b03d57-3ffc-44a9-9286-ae8211311ef6
msgctxt "hf69c350agff40g4babga185g83b4318c60d1"
msgid "I sense your fear. I've come to aid you."
msgstr "네 두려움이 느껴지는군. 도우러 왔다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002
#. Speaker = Player
#. NodeID = 8321beb3-7ed5-10b9-0272-9a113cce27ab
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Local:
#.      - c9f41e9b-ee03-a40d-ec89-c332e0b175d4_PassedInsight = False
#.   Tag:
#.      - REALLY_DUERGARDWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002:8321beb3-7ed5-10b9-0272-9a113cce27ab
msgctxt "h0918bb69g37ebg48caga193g31e2b1546d27"
msgid ""
"<i>Counter with your own memory. Duergar builders, not burners. Not rot.</i>"
msgstr "<i>온전한 그대의 기억으로 떠 올려라. 듀에르가 장인들을, 방화광들이 아닌, 썩은자들이 아닌.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000
#. Speaker = Player
#. NodeID = 9a1431b4-a8f7-6542-3fd4-133f7c2a2dd0
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = False
#. 
#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002
#. Speaker = Player
#. NodeID = 9432fc57-f012-0e7b-07d0-7b6139759d36
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000:9a1431b4-a8f7-6542-3fd4-133f7c2a2dd0
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002:9432fc57-f012-0e7b-07d0-7b6139759d36
msgctxt "hd99f768fg763cg48a4g9a22g6e0f5d9205c8"
msgid "My purpose is private. Let me pass, and I will leave you unharmed."
msgstr "내 목적은 사적인 것이다. 지나가게 해주면 널 가만히 냅둬주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002
#. Speaker = Narrator
#. NodeID = 961e588d-7206-7d22-1576-50c3ef102884
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_State_GainedAccess = False
#. TagRule: REALLY_UNDERDARK
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002:961e588d-7206-7d22-1576-50c3ef102884
msgctxt "h31fe873dg4c9fg4746gb360g90d97752ed6a"
msgid ""
"*You are swallowed by a chorus of turbulent music. Through one creature sing "
"many voices: the harmony of a myconid collective.*"
msgstr "*당신은 넘실대는 음악에 집어삼켜집니다. 하나의 생명체가 다양한 목소리로 노래합니다: 마이크로니드 집단체의 화음입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002
#. Speaker = Narrator
#. NodeID = 961e588d-7206-7d22-1576-50c3ef102884
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_State_GainedAccess = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002:961e588d-7206-7d22-1576-50c3ef102884
msgctxt "h50ddbe6egd80ag41cag86acg6574721bfac0"
msgid ""
"*You are swallowed by a chorus of turbulent music. Through one creature sing "
"many voices: the harmony of an entire collective.*"
msgstr "*당신은 넘실대는 음악에 집어삼켜집니다. 하나의 생명체가 다양한 목소리로 노래합니다: 마이크로니드 집단체의 화음입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002
#. Speaker = Player
#. NodeID = a7ef4526-c29d-993a-0336-4fbfe8e69535
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Quest:
#.      - UND_LoneDuergar.ToldQuest(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002:a7ef4526-c29d-993a-0336-4fbfe8e69535
msgctxt "h6dec0a06ge7cfg47a1g9da8g1767a5a0a2e7"
msgid "Let me pass. I've come for the runaway gnome."
msgstr "지나가게 해줘. 도망친 노움을 잡으러 왔다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002
#. Speaker = Restless Myconid
#. NodeID = ac81e1a6-98ba-8e24-a11f-e18fb712f758
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002:ac81e1a6-98ba-8e24-a11f-e18fb712f758
msgctxt "h08903579g4326g4c85g878fg80a786fe93c0"
msgid "((*Sovereign. he has come. he is here*))"
msgstr "((*군주님. 그가 왔습니다. 그가 도착했습니다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002
#. Speaker = Restless Myconid
#. NodeID = ac81e1a6-98ba-8e24-a11f-e18fb712f758
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002:ac81e1a6-98ba-8e24-a11f-e18fb712f758
msgctxt "h8f3ef3deg7c34g4190g8029g8bbe2990c6af"
msgid "((*Sovereign. she has come. she is here*))"
msgstr "((*군주님. 그녀가 왔습니다. 그녀가 도착했습니다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002
#. Speaker = Restless Myconid
#. NodeID = ac81e1a6-98ba-8e24-a11f-e18fb712f758
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002:ac81e1a6-98ba-8e24-a11f-e18fb712f758
msgctxt "hdb4e8cefgb9e9g48cfg94a9g14b9db5f1da4"
msgid "((*Sovereign. they have come. they are here*))"
msgstr "((*군주님. 그들이 왔습니다. 그들이 도착했습니다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002
#. Speaker = Sovereign Spaw
#. NodeID = b1accd35-ee01-3f59-f8f1-780cc18d6a18
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - c9f41e9b-ee03-a40d-ec89-c332e0b175d4_PassedHealing = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002:b1accd35-ee01-3f59-f8f1-780cc18d6a18
msgctxt "h28835ed5ge947g413dg9765g7ebc1ac836d1"
msgid "((*I can mend neither skin nor spirit. but we still might commune*))"
msgstr "((*나는 육체도, 영혼도 고칠 수 없다. 그래도 우리는 교감할 수 있다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002
#. Speaker = Narrator
#. NodeID = b304b2fb-87a2-7df1-1569-b5b7ddb22b27
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002:b304b2fb-87a2-7df1-1569-b5b7ddb22b27
msgctxt "h85641b21ga417g4d51g816dg98aba849345c"
msgid ""
"*The choir fades. A single melody rises above the others, brassy and "
"commanding.*"
msgstr "*노래가 사그라듭니다. 깊게 울리며 두드러지는 단 하나의 멜로디가 다른 멜로디들 위로 떠오릅니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002
#. Speaker = Narrator
#. NodeID = b56306be-83e7-add2-1137-bde351f5552f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002:b56306be-83e7-add2-1137-bde351f5552f
msgctxt "hdfcb84d0g9087g437dga828ga72277b31d34"
msgid "*You discern no information or intention in the sovereign's song.*"
msgstr "*당신은 군주의 노래에서 어떠한 정보나 의도를 알아채지 못합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002
#. Speaker = Sovereign Spaw
#. NodeID = ba0e56ff-03d1-aae7-3647-6c7c8945f7a2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002:ba0e56ff-03d1-aae7-3647-6c7c8945f7a2
msgctxt "hcc73c9c5gf93eg4d0cga5b6gce3a00cda5fe"
msgid "((*<i>vile beast</i>*))"
msgstr "((*<i>추악한 짐승이군</i>*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002
#. Speaker = Restless Myconid
#. NodeID = bbe32d6a-f036-1600-7ba3-4a8ba9fd4f5b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_SpokeWithSovereign = True
#.      - UND_MyconidCircle_State_GainedAccess = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002:bbe32d6a-f036-1600-7ba3-4a8ba9fd4f5b
msgctxt "h553127f7gaf61g4cfdgbc6dg6780f51ce755"
msgid "((*the Sovereign spoke its word. you will obey*))"
msgstr "((*군주께서 말하셨다. 복종해라*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002
#. Speaker = Narrator
#. NodeID = c4677f47-e8b5-b986-13e1-a8316b4535a0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002:c4677f47-e8b5-b986-13e1-a8316b4535a0
msgctxt "h49d3affcg63e3g4b55g8feagedd6e7f7741e"
msgid "*...<i>strangling</i> you.*"
msgstr "*...당신의 <i>목을 조이고 있습니다</i> .*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002
#. Speaker = Sovereign Spaw
#. NodeID = ccbec945-805b-9180-269c-291f0cfd1bba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002:ccbec945-805b-9180-269c-291f0cfd1bba
msgctxt "h3dd979a8gf9e5g4d60g9b48g6e6668ae5c17"
msgid "((*<b>I am Sovereign</b>*))"
msgstr "((*<b>짐은 군주다</b>*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002
#. Speaker = Narrator
#. NodeID = e5a983e2-d724-0d2d-2e6d-9ed330853aa8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - c9f41e9b-ee03-a40d-ec89-c332e0b175d4_PassedInsight = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002:e5a983e2-d724-0d2d-2e6d-9ed330853aa8
msgctxt "ha22d2105gfbc3g4845gb8d6g306e40b18072"
msgid ""
"*You detect a distinct quiver in every note. These creatures have "
"experienced recent tragedy.*"
msgstr "*당신은 매 음절에서 분명한 떨림을 감지합니다. 이 생명체들은 최근 비극을 겪었습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002
#. Speaker = Player
#. NodeID = e624de3e-558e-2a32-b14b-5bb642168b36
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_DUERGARDWARF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002:e624de3e-558e-2a32-b14b-5bb642168b36
msgctxt "h800eb885g8d30g49d1g92a2g6c959f68e56a"
msgid "You dare call me rot? I'll kill you."
msgstr "감히 나보고 썩었다고 했겠다? 널 죽여주마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002
#. Speaker = Player
#. NodeID = e624de3e-558e-2a32-b14b-5bb642168b36
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002:e624de3e-558e-2a32-b14b-5bb642168b36
msgctxt "h12aa9d82g3789g4548g8178gd70e05a41390"
msgid "These tricks of the mind don't frighten me - I'll kill you!"
msgstr "이런 속임수 따윈 두렵지 않다- 널 죽여버리겠어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002
#. Speaker = Restless Myconid
#. NodeID = f30aa46a-fe4f-0303-c23c-6ef0843b8dc9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_MyconidCircle_State_Hostile = True
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002:f30aa46a-fe4f-0303-c23c-6ef0843b8dc9
msgctxt "h8f254e0fg6cd7g467bgb031g987606655427"
msgid "((*cure the Rot. <b>end it</b>*))"
msgstr "((*부패를 치유해라. <b>저것을 끝내라</b>*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002
#. Speaker = Player
#. NodeID = f5fb4454-c3b4-7281-c3cc-f46e6bffb85f
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DEEPGNOME or DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002:f5fb4454-c3b4-7281-c3cc-f46e6bffb85f
msgctxt "h05fc15d0gff84g4fb5g908fg4f1c2566501e"
msgid "The Underdark is my home - I don't need your permission to pass."
msgstr "언더다크는 내 고향이다 - 지나가는데 네 허락따윈 필요없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002
#. Speaker = Narrator
#. NodeID = fb59d3f8-27bb-c5e5-b03c-43aae04d3bb5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_MyconidCircle_State_GainedAccess = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_002:fb59d3f8-27bb-c5e5-b03c-43aae04d3bb5
msgctxt "hcab02046gfc3bg48e0gab56g62e74aa5c5b6"
msgid "*Then the sovereign drones a new melody, cautious but welcoming.*"
msgstr "*그 후 군주는 새로운 멜로디를 웅웅거립니다. 조심스럽지만 환영하는 멜로디입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_003
#. Speaker = Mossy Myconid
#. NodeID = 400ab63a-857e-0b0c-bcbb-993d6a20030f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_State_GainedAccess = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_003:400ab63a-857e-0b0c-bcbb-993d6a20030f
msgctxt "h3191dd72g8b53g432egbbc2g7558d1a48583"
msgid "((*flesh-stench. go, go, away*))"
msgstr "((*악취나는 존재여. 가라, 떠나라*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_003
#. Speaker = Mossy Myconid
#. NodeID = 54ea6f7d-1a65-4f29-d598-871feefed4b6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_MyconidSovereignReward = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_003:54ea6f7d-1a65-4f29-d598-871feefed4b6
msgctxt "ha5231e71g8923g4e89gade4ga0871dc9ef4f"
msgid "((*Rot is cleansed. breathe free*))"
msgstr "((*부패가 정화되었다. 안심해라*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_003
#. Speaker = Narrator
#. NodeID = b5d0ae50-b842-fa34-79c2-34ef2718f36b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_State_GainedAccess = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_003:b5d0ae50-b842-fa34-79c2-34ef2718f36b
msgctxt "ha5475e83gc39dg4e61g9322g1df8ef54de27"
msgid "*The creature's song rumbles within you, neither warm nor welcoming.*"
msgstr "*이 생명체의 노래가 당신 안에서 울립니다, 그런데 노래는 따뜻하지도, 환영하지도 않습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_004
#. Speaker = Noxious Myconid
#. NodeID = 2db9c530-b6d4-8a40-f1b0-e8ec38ceec20
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_State_GainedAccess = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_004:2db9c530-b6d4-8a40-f1b0-e8ec38ceec20
msgctxt "h43f246ddga457g4b38g903bg13e6bffd1d26"
msgid "((*no peace*))"
msgstr "((*평화란 없다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_004
#. Speaker = Noxious Myconid
#. NodeID = 8e5b9d00-f77f-94c0-6f5a-1e8ba526de2f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_MyconidSovereignReward = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_004:8e5b9d00-f77f-94c0-6f5a-1e8ba526de2f
msgctxt "hc3166d44g96d4g4f21g850dg6866f255f6ee"
msgid "((*the song is steady*))"
msgstr "((*화음이 안정되었다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_004
#. Speaker = Noxious Myconid
#. NodeID = dfffd23f-3f2f-36d7-8981-7865700693a0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_State_GainedAccess = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_004:dfffd23f-3f2f-36d7-8981-7865700693a0
msgctxt "h83221e33g65fcg4b34g9b12gc734d46dce0b"
msgid "((*go forth*))"
msgstr "((*나아가라*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DeadMyconid_Dead
#. Speaker = Player
#. NodeID = 030e15a7-bb3d-1d22-f0ce-7f6c0cd88829
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DeadMyconid_Dead:030e15a7-bb3d-1d22-f0ce-7f6c0cd88829
msgctxt "h39bc6fa5g7837g4e1bg8f64g5044b5a2ed2a"
msgid "Where do you keep your riches?"
msgstr "네가 지닌 재물은 어디에 뒀지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DeadMyconid_Dead
#. Speaker = Narrator
#. NodeID = 0763a6a3-ec81-d32c-b74b-fe9b02fdac6c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 93fa7ba7-5780-5205-9758-d6bf730ed1f3_localflag2 = False
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Local:
#.     - 93fa7ba7-5780-5205-9758-d6bf730ed1f3_localflag2 = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DeadMyconid_Dead:0763a6a3-ec81-d32c-b74b-fe9b02fdac6c
msgctxt "h895d1351g437eg460fga150g8b04c5f864c9"
msgid "*The corpse twitches in response to the spell...*"
msgstr "*시체는 주문에 반응하며 흔들립니다...*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DeadMyconid_Dead
#. Speaker = Narrator
#. NodeID = 1f2e43bf-3d93-60e3-1e06-d40184cac5f7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_UNDERDARK(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DeadMyconid_Dead:1f2e43bf-3d93-60e3-1e06-d40184cac5f7
msgctxt "he2a43339g3b02g4b2cga970g53f83da3f664"
msgid "*...and you note its delicate filaments. It had been merely a child.*"
msgstr "*...그것의 섬세한 가닥들이 눈에 띕니다. 이 개체는 단지 아이에 불과했습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DeadMyconid_Dead
#. Speaker = Player
#. NodeID = 359f9f4f-ee28-146b-6322-afc3d6628806
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 93fa7ba7-5780-5205-9758-d6bf730ed1f3_localflag3 = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DeadMyconid_Dead:359f9f4f-ee28-146b-6322-afc3d6628806
msgctxt "h58a489e1g83dfg410cgb4e3gce4cbcaa6e06"
msgid "How do I get past the door to your treasure?"
msgstr "너희 보물을 보관한 곳의 문을 어떻게 뚫고 들어가지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DeadMyconid_Dead
#. Speaker = Dead Myconid Sprout
#. NodeID = 3667f02d-8dbe-2c90-4360-b8a24988be47
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DeadMyconid_Dead:3667f02d-8dbe-2c90-4360-b8a24988be47
msgctxt "hab1aae9fg289eg4f28g89ceg6cf32c6a868b"
msgid "((*...to grow. to know. to be one with the Circle...*))"
msgstr "((*...자라고. 배우고. 공동체의 일원이 되기 위해...*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DeadMyconid_Dead
