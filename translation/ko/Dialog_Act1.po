msgid "*Baldur's Gate: Northwest. Elturel: South. Moonrise Towers: West.*"
msgstr "*발더스 게이트: 북서쪽. 엘투렐: 남쪽. 문라이즈 타워: 서쪽.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Ellyka
#. NodeID = 02ffe41b-48e6-0869-10b9-9f14965caba4
#. HandlePath = TaggedText[0].TagText[0]
