msgctxt "hbed20a44ge4a9g443fg9d5cgf117dbcad666"
msgid "Footprints, I wager. I should look closer."
msgstr "발자국인 것 같은데. 더 자세히 봐야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ThullaHint_PAD
