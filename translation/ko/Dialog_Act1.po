msgctxt "ha1f71ddcg44b4g4052g8f75g6ebbde1ae2ad"
msgid "The <i>ch'r'ai</i>. Now."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_IntelligenceOfficer04
#. Speaker = Ardent Jhe'rezath
#. NodeID = 925affd8-2e93-9dbb-4b6b-3174f98ebdda
