#.      - 9caf82c3-be62-a101-6e04-7d3916926e85_MindHasBeenRead = False
#.   Script:
#.      - GEN_CanDetectThoughts_2 = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:569d3b1a-f10f-4694-bfc0-0e7c354dfa4c
msgctxt "h494b9671g39d0g48a6g9494g9767f70dac6a"
msgid "<i>Cast Detect Thoughts.</i>"
msgstr "<i>생각 탐지를 시전한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Wyll
#. NodeID = 588cd504-00f1-4580-8db2-cc02b041b2e3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_WYLL(6) = True
#. SetFlags:
#.   Local:
#.     - 9caf82c3-be62-a101-6e04-7d3916926e85_Inclusion = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:588cd504-00f1-4580-8db2-cc02b041b2e3
msgctxt "h64876d09g2e4dg4db5gaf13g3754aecb7e39"
msgid "Hells. Whatever you do, don't set her off."
msgstr "지옥이여. 네가 뭘 하든, 그녀를 화나게 하진 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = 5b2d8166-43c4-cb3f-893c-5bd033e44776
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:5b2d8166-43c4-cb3f-893c-5bd033e44776
msgctxt "h05d30c10gc072g43f1gbf53ge08cf1c614a8"
msgid "What good is a single vial?"
msgstr "고작 한 병을 어디에 쓰라고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = 5e86ace3-82bc-dd82-f676-c5da48972320
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:5e86ace3-82bc-dd82-f676-c5da48972320
msgctxt "h28f818cagff9cg461bg973cg029260f891fb"
msgid "Where will you go now?"
msgstr "이제 어디로 갈 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = 5ee6881d-02ff-4266-875a-76d4340e5899
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:5ee6881d-02ff-4266-875a-76d4340e5899
msgctxt "h13b9d722g0bd3g42d6gae53gb9cb5aea20f8"
msgid "Holy hells. Have you gone mad?"
msgstr "이런 세상에. 정신이 나가버린 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Shadowheart
#. NodeID = 6020a0b1-417e-404c-9150-41dc7511a1df
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:6020a0b1-417e-404c-9150-41dc7511a1df
msgctxt "h8d2bb81agc740g4f4fga10ag84c9e3fca975"
msgid "I'm not sure I blame her. Though Laridda might."
msgstr "그녀를 탓할 수 있는지는 모르겠어. 라리다는 생각이 다르겠지만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = 602301d2-8085-3664-b569-4e37e391a6ea
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 9caf82c3-be62-a101-6e04-7d3916926e85_Inclusion = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:602301d2-8085-3664-b569-4e37e391a6ea
msgctxt "h79ad78b5g160dg4fb8ga4bbgba52f66a485e"
msgid "Shut your mouth, <i>hoon</i>, or I'll shut you down."
msgstr "입 닥쳐, <i>훈</i>, 아니면 내가 직접 닥치게 해 줄 테니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = 61d087f4-f050-9813-4ea9-739d5378a40e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ROGUE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:61d087f4-f050-9813-4ea9-739d5378a40e
msgctxt "h851b1089ga87fg47a6g86dbg00d48bba9694"
msgid "Don't be dumb. Check your exits - you've got nowhere to go."
msgstr "멍청한 짓 하지 마. 주변을 살펴보라고, 도망칠 곳은 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = 65452f1b-a768-72aa-6a71-ee1c66776668
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:65452f1b-a768-72aa-6a71-ee1c66776668
msgctxt "h61f174d8gbebag43e5gaf1eg8172ff496048"
msgid ""
"Look. We're freedom fighters. We need this powder to a prove a point. To "
"people who really need a point proven to them."
msgstr "이봐. 우린 자유의 투사야. 우리를 증명하려면 이 가루가 필요해. 증명할 필요가 있는 사람들이 있거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = 655a79ab-a233-dd7c-df67-14365ce48627
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_GOOD or PALADIN_GOOD
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:655a79ab-a233-dd7c-df67-14365ce48627
msgctxt "h2a7db805g91d3g4c38gade1gbb99b06c406e"
msgid "I'm not here to hurt you. You have my word."
msgstr "널 해치려고 온 거 아니야. 장담하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = 66ca86f7-174d-4e9d-9145-21b41f657594
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:66ca86f7-174d-4e9d-9145-21b41f657594
msgctxt "h4805ec3dg0bdeg4a62ga597g7e9852c4f866"
msgid "Calm down. Let's talk this through."
msgstr "진정해. 말로 해결하자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = 68140292-833f-66d3-6c94-4d1714002e1e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:68140292-833f-66d3-6c94-4d1714002e1e
msgctxt "hf758ab05gf29fg496ag9898g5414a126c315"
msgid "A vial's all I got... wait..."
msgstr "용기 하나가 내가 가진 전부... 잠깐..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = 68680da3-d80c-4829-8e9b-0bdc2ae70180
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:68680da3-d80c-4829-8e9b-0bdc2ae70180
msgctxt "hd0614b11ga15ag4cc0gbad6gc4a1df963572"
msgid ""
"Now you're getting it. I'd sooner walk the Hells than be tortured at "
"Moonrise!"
msgstr "이제 이해했군. 문라이즈에서 고문을 받을 바엔 지옥에 가겠어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = 693c6501-77a7-3577-4044-a197d024d47f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:693c6501-77a7-3577-4044-a197d024d47f
msgctxt "h5d10128cg3129g4c3fg8e0cg6ea71bcf9e6e"
msgid "I'm not stupid, you know. No such thing in Grymforge as kind hearts."
msgstr "난 바보가 아니야. 그림포지에 친절한 마음 같은 건 없다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Gale
#. NodeID = 6b91b282-dfd3-4b84-9ddd-3ecc73d7a204
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_GALE(7) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:6b91b282-dfd3-4b84-9ddd-3ecc73d7a204
msgctxt "h83482dc1g969fg46ecga9a0g5bf458d41c18"
msgid ""
"She has a heart made of stone, this one - that only smokepowder can break."
msgstr "이 여자는 돌과 같은 심장을 지녔군. 화약만이 부술 수 있겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = 6c724aa9-ecb3-4665-a7f5-af0a6995e286
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:6c724aa9-ecb3-4665-a7f5-af0a6995e286
msgctxt "ha6b91e8bg75beg4cabgbf40g1620c4ba2d4f"
msgid "I know what you are - one of Nere's cult-goons. Sailed right in."
msgstr "네 정체가 뭔지 알아, 니어의 사이비 건달 중 하나잖아. 아까 배를 타고 들어오는 걸 봤어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = 6c802374-da43-96cd-51d3-b2ed2ffa60df
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:6c802374-da43-96cd-51d3-b2ed2ffa60df
msgctxt "h41e3eeaagde6ag41bcga70fg7af0112402d6"
msgid "It's the whole damn reason we're here, and I'm not leaving without it."
msgstr "이게 애초에 우리가 여기에 온 이유야, 그리고 이걸 두고 갈 생각은 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = 6e24d28e-9914-faff-aa5e-cdc4fe62fe3c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_ArguingGnomes_Event_LearnedAboutPhilomeen = True
#.   Tag:
#.      - ROGUE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:6e24d28e-9914-faff-aa5e-cdc4fe62fe3c
msgctxt "hbb000a35g3b88g4562g80f1gbbd71aa31b95"
msgid "Ah, 'playing dead'? A classic ploy."
msgstr "아, '죽은 척'을 하는 건가? 전형적인 속임수군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Narrator
#. NodeID = 70a825db-9b3c-d86a-02f8-9e506f236d61
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_IronhandGnomes_Knows_Runepowder = True
#.   Local:
#.     - 9caf82c3-be62-a101-6e04-7d3916926e85_HeardRunepowder = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:70a825db-9b3c-d86a-02f8-9e506f236d61
msgctxt "h7dc02e1fgf02fg442ag8289gf5620845de37"
msgid ""
"*Runepowder is gnomish folklore - an explosive of awesome power, handed down "
"to the gnomes by their war-god Gaerdal Ironhand.*"
msgstr "*룬파우더란 노움의 민간 전승으로 그들이 섬기는 전쟁의 신 게르 아이언핸드가 노움에게 물려준 엄청난 힘을 지닌 폭발물입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = 70eddcb3-241f-3345-c5f6-ad66ec685e09
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:70eddcb3-241f-3345-c5f6-ad66ec685e09
msgctxt "h3379f2cegeb3eg4cc2ga5c0g85fe7f4f6097"
msgid "Don't talk of my clan like you understand."
msgstr "내 일족에 대해 네가 이해하는 것마냥 이야기하지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = 71e13b5d-ce6b-1dd3-1d59-68fab28fae2a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:71e13b5d-ce6b-1dd3-1d59-68fab28fae2a
msgctxt "h30534593g189cg49a0ga9a7g548547e7185e"
msgid "I'll spare you a vial."
msgstr "네게 용기 하나를 나눠 주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = 74e4f32e-943f-a1f6-c1f6-40abf8b1176a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:74e4f32e-943f-a1f6-c1f6-40abf8b1176a
msgctxt "h5932314aged3eg411bg971eg51a4a9b540e0"
msgid "Just make it work, all right?"
msgstr "그냥 어떻게든 해내, 알겠지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = 767b002a-df71-678e-e51c-5b970ee63706
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:767b002a-df71-678e-e51c-5b970ee63706
msgctxt "h6f98d8c8gfc8fg4096g9e85g4022ac0d5257"
msgid "I want nothing from you, I swear."
msgstr "네게 바라는 건 아무것도 없어, 맹세할게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = 78aea220-ef1c-4509-a574-041ca72ef469
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:78aea220-ef1c-4509-a574-041ca72ef469
msgctxt "hba72840dgd6c0g43d3gb81cgac22d2c2f43b"
msgid ""
"Better to die in this shit-heap than rot in Moonrise. You want me? <i>Come "
"get me.</i>"
msgstr "이 개똥 같은 곳에서 죽는 게 문라이즈에서 썩어가는 것보단 낫겠지. 날 원해? <i>와서 잡아 봐.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = 78c676cc-0461-ea02-29f4-2f94230a4f2a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_HiddenGnome_HasVial(0) = False
#. SetFlags:
#.   Global:
#.     - UND_PanicRoom_Event_GnomeSuicide = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:78c676cc-0461-ea02-29f4-2f94230a4f2a
msgctxt "h72875e7ag96efg4bd5gb98dg27a8686e3cd1"
msgid "... it's gone? You damned <i>rat. </i>I knew I couldn't trust you!"
msgstr "...사라졌다고? 이 망할 <i>쥐새끼. </i>네가 믿을 수 없는 놈이란 건 진작에 알았어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = 7ad73c3c-4e0e-5ec6-861d-898e3f86cdeb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:7ad73c3c-4e0e-5ec6-861d-898e3f86cdeb
msgctxt "h8ce18b9eg0667g4489gbcfbg708865c4c341"
msgid "Probably. She's the gullible sort."
msgstr "아마도. 그녀는 잘 속는 편이거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = 7db439eb-2dcf-3e80-40bc-8ee3cd445786
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_EscapedGnome_Event_KnowsTookSmokepowder = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:7db439eb-2dcf-3e80-40bc-8ee3cd445786
msgctxt "h70dba613g73a3g456agac61ge0f2beb41dba"
msgid "'Course I am. You got the runepowder. So now you cut and run."
msgstr "당연하지. 네가 룬파우더를 가졌잖아. 그럼 이제 끊고 도망가겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = 803a53c5-2b63-41e7-e7b1-11333588ae45
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GNOME(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:803a53c5-2b63-41e7-e7b1-11333588ae45
msgctxt "h89f450d0ga93eg4d48g9e01g297b46d95f0c"
msgid ""
"Smokepowder's no toy. Whatever happens to me, it will be far worse for you."
msgstr "화약은 장난감이 아니야. 내게 무슨 일이 일어나든, 넌 더 끔찍한 결과를 맞게 될 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = 815fa9ee-706c-40c4-aba1-0db509cdc689
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:815fa9ee-706c-40c4-aba1-0db509cdc689
msgctxt "h073bb5dag1051g4cd7gb980g823a25d87bec"
msgid "I don't care. Go on, blow us up."
msgstr "난 상관없어. 해봐, 우릴 터뜨려 보라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = 83d68c7c-eaed-4ded-a8ad-16bdbda65ff6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_TheDrowNere_State_GnomesExecuted = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:83d68c7c-eaed-4ded-a8ad-16bdbda65ff6
msgctxt "h61da8c6bgd4ecg40c4g8c6dgdfffc27e3f33"
msgid ""
"Your friends are dead. And you will be too if you don't flee this place."
msgstr "네 친구들은 죽었어. 그리고 너도 여기서 도망치지 않으면 같은 운명을 맞게 될 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = 83edf091-4660-4223-8be2-d6d7d0655d4e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:83edf091-4660-4223-8be2-d6d7d0655d4e
msgctxt "h329fda95ge62cg4530ga310gae6f9dde7ea9"
msgid ""
"Laridda? Ruddy mind games. I... I know all about your tricks, True Soul."
msgstr "라리다? 망할 속임수야. 난... 난 너희 기만질에 대해서 다 알고 있다고, 참된 영혼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = 88057484-aff0-4789-b3ec-2d2feb33c514
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:88057484-aff0-4789-b3ec-2d2feb33c514
msgctxt "h3a35c30cgc3bag4756gafcdg30cf14152bd4"
msgid ""
"Oh, for... I'm gonna blow, and you're getting chummy? <i>Drugh</i> off, "
"prickslit."
msgstr "오, 그럼... 내가 말해 주면, 네가 친절해지겠다는 거야? <i>엿이나 먹어</i>, 좆만아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = 885ec35a-bbde-ee39-2e68-46dc52f2fadb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_HiddenGnome_HasVial(0) = True
#. SetFlags:
#.   Local:
#.     - 9caf82c3-be62-a101-6e04-7d3916926e85_Mission = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:885ec35a-bbde-ee39-2e68-46dc52f2fadb
msgctxt "hecf98e6eg74b8g43f3g9bccgd1944d4d42af"
msgid ""
"A vial's all I got left. And I'm not parting with it for <i>nothing.</i>"
msgstr "이 용기가 내게 남은 전부야. 그리고 이건 <i>그 무엇과도 바꿀 수 없어.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = 894d35ee-c66b-4fd2-ad70-e9d7fac30c2c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:894d35ee-c66b-4fd2-ad70-e9d7fac30c2c
msgctxt "h562aaeeeg03e1g443cga4a0g84ce951cdf67"
msgid "Don't do this. Don't pretend you - you give a shit about me."
msgstr "이러지 마. 네가 나에 대해 좆도 신경 쓰는 척하지 말라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = 89e25e68-3fb5-8170-42e2-d6f5347f49f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:89e25e68-3fb5-8170-42e2-d6f5347f49f5
msgctxt "h01149e90g073eg4fcbg9bdcg2a5483d2abcc"
msgid "Well, it's real, and I need to bring it back to Baldur's Gate."
msgstr "뭐, 이건 진짜야, 그리고 이걸 발더스 게이트로 가져가야만 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = 8ce3839f-7e49-ddf2-7851-0fbaeab4a1fa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:8ce3839f-7e49-ddf2-7851-0fbaeab4a1fa
msgctxt "hd2317365g60d0g457fg9506gb757db603cc2"
msgid "Beloved? I might have been hers. She sure as hells wasn't mine."
msgstr "사랑받는다고? 그녀가 날 아꼈을진 모르지. 하지만 난 그녀를 전혀 아끼지 않았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = 8da28364-989a-ff44-e67f-8e57f09dd6f2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_EscapedGnome_State_GnomeSaved = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:8da28364-989a-ff44-e67f-8e57f09dd6f2
msgctxt "h9b6d6720g4f5cg4687g9c3fg0b9c2d9b75b3"
msgid "I'm getting gone. You ought to do the same."
msgstr "난 이제 갈 거야. 당신들도 그러는 게 좋을걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = 8f9c4482-1995-83ba-4579-301c66d9c3df
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:8f9c4482-1995-83ba-4579-301c66d9c3df
msgctxt "h546424c7g331cg411dg8121g95cf48a19e1f"
msgid "I'll do worse to Nere's lapdog, <i>hoon. </i>"
msgstr "니어의 애완동물에겐 더한 짓도 할 수 있어, <i>훈</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = 9299c982-ac2b-240e-c121-272060297f5b
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_EVIL or PALADIN_EVIL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:9299c982-ac2b-240e-c121-272060297f5b
msgctxt "h3bc45b70g7e19g42d2gb756gf54f809de544"
msgid "Do it. I could do with a show."
msgstr "해 봐. 좋은 구경거리가 되겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Narrator
#. NodeID = 93bbb5ab-35ec-1aec-d580-a17ff9544d8d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 9caf82c3-be62-a101-6e04-7d3916926e85_PowderSmellsDifferent = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:93bbb5ab-35ec-1aec-d580-a17ff9544d8d
msgctxt "hb6329758g6568g463ega4f8g2febe5ca226b"
msgid ""
"*But the scent is acrid, as if contaminated somehow. Or much, <i>much </"
"i>more concentrated.*"
msgstr "*하지만 왠지 오염된 듯 매캐한 향이 납니다. 그게 아니라면, 훨씬, <i>훨씬</i> 더 농축되어 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Astarion
#. NodeID = 960fc446-2c3a-4c2c-b5ec-37a96da12286
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:960fc446-2c3a-4c2c-b5ec-37a96da12286
msgctxt "h1270b235g05b1g4964gb416g8f851ee4fd1f"
msgid ""
"Ah, nothing says 'true love' like faking your own death to avoid someone."
msgstr "아, 누군가를 피하고자 자기 죽음을 가장하는 것만큼 '진정한 사랑'을 표현하는 것도 없지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Shadowheart
#. NodeID = 99e3704a-d329-49ee-8aaf-8d9670c3d513
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#. SetFlags:
#.   Local:
#.     - 9caf82c3-be62-a101-6e04-7d3916926e85_Inclusion = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:99e3704a-d329-49ee-8aaf-8d9670c3d513
msgctxt "ha18e1496g4e78g41d9gb437g8d92b46afd9e"
msgid "Careful. I'd rather not have to pick bits of gnome from my hair."
msgstr "조심해. 내 머리카락에서 노움 살점을 떼어내고 싶진 않으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = 9d132c14-1244-d9b2-a75d-c792e26e17f6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_EscapedGnome_Event_KnowsTookSmokepowder = True
#.      - UND_ArguingGnomes_Quest_Accepted = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:9d132c14-1244-d9b2-a75d-c792e26e17f6
msgctxt "hdc7201c5gef44g4c40g8412g3d7f78af421c"
msgid ""
"Calm down. Beldron's trapped in a cave-in, and I needed the smokepowder."
msgstr "진정해. 벨드론이 낙석에 갇혔어, 그리고 그 화약이 필요해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Gale
#. NodeID = 9f13e5c2-989d-40f9-9fc3-daba5de745f4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_GALE(7) = True
#. SetFlags:
#.   Local:
#.     - 9caf82c3-be62-a101-6e04-7d3916926e85_Inclusion = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:9f13e5c2-989d-40f9-9fc3-daba5de745f4
msgctxt "hd3db45deg0826g4c6ag95fbg60dd611ae05d"
msgid ""
"As an expert on the subject, my dear lady - I'd like to point out that "
"blowing oneself up is never the solution."
msgstr "친애하는 아가씨, 그 분야엔 내가 전문가라 한마디 하자면, 스스로를 터뜨리는 건 절대 해결책이 될 수 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = a848df49-e3cd-44c3-05db-c2bb94bcee2b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GNOME(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:a848df49-e3cd-44c3-05db-c2bb94bcee2b
msgctxt "hb7469795gee7dg46d9ga81eg2a6c79ac0c81"
msgid "'Runepowder'? I thought that was a burrow-tale."
msgstr "'룬파우더'라고? 그건 그냥 소설 속의 이야기인 줄 알았는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = ad244789-0ccb-c9aa-fa03-f0ed2f42d365
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_EscapedGnome_Event_KnowsTookSmokepowder = False
#.      - UND_ArguingGnomes_Quest_Accepted = False
#. SetFlags:
#.   Global:
#.     - UND_EscapedGnome_Quest_OfferedPowder = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:ad244789-0ccb-c9aa-fa03-f0ed2f42d365
msgctxt "h44078ee5g8feag4077g86d1g6566637ffd5c"
msgid "I don't want you. I will take that smokepowder, though."
msgstr "넌 필요 없어. 하지만 그 화약은 가져가지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = b394a270-ac93-46d2-99c9-0f397ea5d09a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:b394a270-ac93-46d2-99c9-0f397ea5d09a
msgctxt "h1bd849e5g599cg46b4g8ee6g1c144ffa0884"
msgid ""
"Friends? Cowards, more like. Gave them a good blast as cover, and they sat "
"on their bony arses. Done for good with them."
msgstr "친구라고? 겁쟁이겠지. 도망치라고 폭발을 일으켜 줬는데, 그냥 멀뚱히 궁둥이를 붙이고 앉아있더군. 그들과는 이제 끝이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = b5a1db0d-abc9-8697-74a9-37fd0e8817d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:b5a1db0d-abc9-8697-74a9-37fd0e8817d9
msgctxt "he10d65e4gd31fg4f60g96d6g7fa438132576"
msgid "<i>Liar.</i>"
msgstr "<i>거짓말쟁이.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = bd36c421-4b1b-e027-3559-d232ec788e8f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_EscapedGnome_Event_KnowsTookSmokepowder = False
#.      - UND_ArguingGnomes_Quest_Accepted = True
#. SetFlags:
#.   Global:
#.     - UND_EscapedGnome_Quest_OfferedPowder = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:bd36c421-4b1b-e027-3559-d232ec788e8f
msgctxt "hcca1abd4g06d4g4195g9f83g585cb4a401bc"
msgid "Calm down. Beldron's trapped in a cave-in, and I need the smokepowder."
msgstr "진정해. 벨드론이 낙석에 갇혔는데, 그 화약이 필요해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = bdd69df7-12e1-4b1e-98a8-b6529c572c9a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_GnomeWorkers_Event_Leave = True
#. SetFlags:
#.   Global:
#.     - UND_EscapedGnome_Event_OthersFreed = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:bdd69df7-12e1-4b1e-98a8-b6529c572c9a
msgctxt "h017c5968g73deg4c96g8a55g7acdaaa97462"
msgid ""
"Your friends are freed and gathering across the lake. You should join them."
msgstr "네 친구들은 풀려나서 호수를 건너고 있어. 너도 같이 가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = c1d07f39-cff0-4a65-a4c0-5c3a85128d76
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_ArguingGnomes_Event_LearnedAboutPhilomeen = True
#. SetFlags:
#.   Global:
#.     - UND_HiddenGnome_Event_BreakingUp = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:c1d07f39-cff0-4a65-a4c0-5c3a85128d76
msgctxt "hd84e808egaeb0g4d8dga979g23c6634776c1"
msgid ""
"You see Laridda at the dig? Tell her I'm dead. Impaled, half-eaten... I "
"don't care - make up a story."
msgstr ""
"굴에서 라리다를 만나거든, 내가 죽었다고 전해 줘. 꿰뚫렸다고 하든, 반쯤 먹혀버렸다고 하든... 난 상관없어, 알아서 이야기를 지어내."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = c2360a55-2a86-4118-831b-eee48f2f2447
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_EscapedGnome_Event_KnowsTookSmokepowder = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:c2360a55-2a86-4118-831b-eee48f2f2447
msgctxt "h9da2ebbbg84b6g41d6ga1b2g8b50f5680bff"
msgid "Well aren't <i>you</i> sweet?"
msgstr "아주 상냥하구나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = c2ff190b-bfdc-4e66-9445-243bc53d2ba5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:c2ff190b-bfdc-4e66-9445-243bc53d2ba5
msgctxt "h783dbfcege021g4675g9318gc5a5f4c1bda5"
msgid "Go on, drag me to Moonrise. I'll make you cult-nutters <i>suffer.</i>"
msgstr "어서, 날 문라이즈로 끌고 가. 너희 이교도 미치광이들을 <i>힘들게 해줄 테니까.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = c40e1a29-2060-8358-58d6-33f13c8fbb44
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GNOME(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:c40e1a29-2060-8358-58d6-33f13c8fbb44
msgctxt "h76837fbdg3152g4bedg81a7g1fac7399b571"
msgid "'Runepowder'? I thought that was a burrow-tale."
msgstr "'룬파우더'라고? 그건 그냥 소설 속의 이야기인 줄 알았는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = c7781281-3251-d1fa-10f8-ba308eaf4b57
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:c7781281-3251-d1fa-10f8-ba308eaf4b57
msgctxt "h42246855ga8d5g49c9ga09ag7742876f6d5b"
msgid "Then let it be done."
msgstr "그럼 그렇게 되도록 놔둬."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = c8ec855b-0967-462c-8c1e-ec7090a3f75f
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - UND_ArguingGnomes_Quest_Accepted = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:c8ec855b-0967-462c-8c1e-ec7090a3f75f
msgctxt "h1d8f86caga59fg46e6g9d5eg06df65130082"
msgid "Laridda sent me. The gnomes need your help."
msgstr "라리다가 날 보냈어. 노움들에게 네 도움이 필요해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = cb0089e9-d5ef-56d3-d44e-e912eb2e2365
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:cb0089e9-d5ef-56d3-d44e-e912eb2e2365
msgctxt "hfec95093g3e5eg4dc7g8d0bg4c9f15d539dc"
msgid "Fine - I've heard all I need."
msgstr "좋아 - 들을 만큼 들었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = cb4c5c19-ca8d-119c-0226-7287f5c4a5ca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:cb4c5c19-ca8d-119c-0226-7287f5c4a5ca
msgctxt "h381a79bagd7c6g40d2g97f4g0edf7d7a67f9"
msgid ""
"Look. You have no idea what you're dealing with. Any true Ironhand would "
"trade their life for a <i>grain </i>of this stuff."
msgstr ""
"이봐. 넌 지금 네가 뭐에 대해 이야기하고 있는지 몰라. 진정한 아이언핸드라면 이 물건의 조그만 티끌에도 자기 목숨을 바칠 거라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = cc2d979b-efd4-4cf8-5bf0-54f5da698fdf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:cc2d979b-efd4-4cf8-5bf0-54f5da698fdf
msgctxt "hfde3ba8ag48ffg4976ga2d7g72cc0c7b40e6"
msgid "Deal."
msgstr "좋아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = cd4392d4-7788-497c-9f7c-cd9627a88256
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:cd4392d4-7788-497c-9f7c-cd9627a88256
msgctxt "hdf4e23bagf696g4588gb28bga03b28e7458e"
msgid "Gaerdal Ironhand, hear me now - <i>set me free!</i>"
msgstr "게르달 아이언핸드시여, 제 기도를 들어 주소서, <i>절 자유롭게 해주소서!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = cfa48c5e-062f-4075-93b0-1f2aa2359789
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BERSERKER(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:cfa48c5e-062f-4075-93b0-1f2aa2359789
msgctxt "h53ef4683gd923g492cg903bg68bfb32e3eee"
msgid ""
"If I was a True Soul, you'd be dead. Stand down before you hurt yourself."
msgstr "내가 참된 영혼이었다면, 넌 이미 죽었을 거야. 다치기 전에 그거 내려놔."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = d19c74e7-586f-242c-2f4f-3f05108dd7ab
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DEEPGNOME(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:d19c74e7-586f-242c-2f4f-3f05108dd7ab
msgctxt "hd6178b42gc8ddg43b8g8346g9b2481789c86"
msgid "Look at me - I'm not here to hurt my own."
msgstr "날 봐, 난 동족을 해치러 온 게 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = d1a51794-bc10-173e-4e85-d78b9e83d48a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_IronhandGnomes_Knows_Runepowder = True
#.   Tag:
#.      - GNOME(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:d1a51794-bc10-173e-4e85-d78b9e83d48a
msgctxt "he66825d3gfb2cg4241gbef4gb17273270d56"
msgid "'Runepowder'? I thought that was a children's story."
msgstr "'룬파우더'라고? 그건 아이들의 동화에나 나오는 건 줄 알았는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = d2792814-63a0-6f36-e49b-1df4754232a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:d2792814-63a0-6f36-e49b-1df4754232a7
msgctxt "h91b2c195g7dcbg4038gab00g24520174e61d"
msgid "Shit. I can't do it."
msgstr "젠장. 못하겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = d2f76669-a9c2-46d6-3fca-e8a22d125ff0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_ArguingGnomes_Event_LearnedAboutPhilomeen = True
#.   Tag:
#.      - REALLY_DEEPGNOME(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:d2f76669-a9c2-46d6-3fca-e8a22d125ff0
msgctxt "h6acd643bgd444g4115gbcb0gb67e443ef1be"
msgid "Laridda needs you. So does your crew - your <i>burrow.</i>"
msgstr "라리다가 널 필요로 해. 너희 조직원들 모두, 네 <i>편이잖아.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = d63db9ae-50d3-44da-8c72-864b1218a4c7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:d63db9ae-50d3-44da-8c72-864b1218a4c7
msgctxt "h47d98855g42e6g4259gaedcg941bcd99b70b"
msgid "What the <i>drugh</i>? You - you know nothing of me, damn it."
msgstr "이 무슨 <i>드루그</i> 같은? 너, 넌 나에 대해서 아무것도 몰라, 망할."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = d7dec2f7-0b44-9768-9822-d7f0d9e0625a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:d7dec2f7-0b44-9768-9822-d7f0d9e0625a
msgctxt "h56a63705gd697g447eg93b4gf69cb796f24b"
msgid "Very generous of you - I accept."
msgstr "아주 관대하군. 수락하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Narrator
#. NodeID = dac1c0ac-3bf0-49e5-8f01-fe121891354b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_PanicRoom_State_GnomeBarrelPresent = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:dac1c0ac-3bf0-49e5-8f01-fe121891354b
msgctxt "h4ac728b4g9244g4ecdg84b4gf4e1699cdb6a"
msgid "*An ashen scent fills the air. The barrel is filled with smokepowder.*"
msgstr "*재 향기가 공기 중에 가득합니다. 저 통은 화약으로 가득 차 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = dd1a1a10-397b-4c0a-d1ba-63408753f1c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:dd1a1a10-397b-4c0a-d1ba-63408753f1c6
msgctxt "h04cd8a60g41f1g4446g9c32g6c7b7f453ea6"
msgid ""
"Well it's real, and I need to bring it back to Baldur's Gate. I'd rather my "
"clan were with me, but..."
msgstr "뭐 이건 실존해, 그리고 난 이걸 가지고 발더스 게이트로 돌아가야 해. 내 일족도 함께라면 좋겠지만, 하지만..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = de2add54-f853-408e-b05b-23978b68050e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:de2add54-f853-408e-b05b-23978b68050e
msgctxt "hb4cd93b7g97f6g4e01g8179ga2348b266416"
msgid "I'd rather have the pleasure of killing you with my own hands."
msgstr "널 내 손으로 죽여버리는 편이 더 재밌을 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = de6392c8-6d33-7ecb-4479-382c0ce61753
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - MONK(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:de6392c8-6d33-7ecb-4479-382c0ce61753
msgctxt "h2e757364g95efg4b64g8059g25ed44dc9ebb"
msgid "<i>Raise your hands in a show of peace.</i>"
msgstr "<i>평화의 의미로 손을 들어 보인다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = def5f47b-f213-4553-be06-2026ca247432
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:def5f47b-f213-4553-be06-2026ca247432
msgctxt "he36762f5g9a98g4f80g8b19gcf3308355cf5"
msgid "Damned nutter. You - you think I fear death?"
msgstr "망할 멍청한 자식. 내 - 내가 죽음을 두려워할 것 같아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = dfda3b24-c5ce-498c-bd72-06541ef1f2cf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_PanicRoom_Event_GnomeSuicide = True
#. SetFlags:
#.   Global:
#.     - UND_EscapedGnome_Event_KnowsTookSmokepowder = True
#.     - UND_PanicRoom_Event_GnomeSuicide = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:dfda3b24-c5ce-498c-bd72-06541ef1f2cf
msgctxt "h2423ae63gc6d5g49ecg8df7gbed8c1d40698"
msgid "Bugger it all - you moved them."
msgstr "제기랄, 네가 옮겼잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = e0dfaa5d-b638-4850-b988-6d5e33738ad7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_EscapedGnome_State_GnomeSaved = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:e0dfaa5d-b638-4850-b988-6d5e33738ad7
msgctxt "h9ddefe25g3a4ag4487ga233g341e43c9d9c5"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = e1292f35-30bb-dd99-df4b-070142747083
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:e1292f35-30bb-dd99-df4b-070142747083
msgctxt "h37a670ecg78d4g467dg84afgb088da567779"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = e37bda38-8257-45c3-8755-7ddb4d29d4ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:e37bda38-8257-45c3-8755-7ddb4d29d4ed
msgctxt "had37dcf3gd29cg44bcg80dfg6be4b01205e1"
msgid "<i>Drugnin' </i>liars. Wouldn't know truth if it slapped you broadside."
msgstr "<i>드루그닌</i> 거짓말쟁이. 네 입맛대로 이야기를 지어낸 건지 내가 어떻게 알아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = e4e68cdc-b390-5b28-8027-4287847cf689
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BERSERKER(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:e4e68cdc-b390-5b28-8027-4287847cf689
msgctxt "h5c301f23g2bdeg4699ga3a0gd85464f19059"
msgid "KILL THE FIRE. OR DIE. <b>PAINFULLY.</b>"
msgstr "<b>불을 끄거나. 죽어라. 고통스럽게.</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = e63721a8-c6fb-41fc-9390-21ddd2ba04e0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:e63721a8-c6fb-41fc-9390-21ddd2ba04e0
msgctxt "h59a7b168g385cg450fgbb4dg7c27618df674"
msgid "I'm not taking you anywhere. You're free to go."
msgstr "널 끌고 갈 생각은 없어. 넌 자유야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = e7701ae8-ad17-1e9d-f331-9bc71cfbf259
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:e7701ae8-ad17-1e9d-f331-9bc71cfbf259
msgctxt "he24e2b12gdbaeg4baegbddcg035c7e731e65"
msgid "It's the whole damn reason we're here."
msgstr "이게 우리가 애초에 이 망할 곳에 온 이유야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = e7fb1514-894f-63cb-f618-18faad314e23
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:e7fb1514-894f-63cb-f618-18faad314e23
msgctxt "h1c013e75g881ag4345gb9eege5aaef8b0ddf"
msgid "That's the point, genius."
msgstr "그게 내 요점이야, 천재님."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = e9ce6486-3dad-052d-b491-592cf34f8029
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_ArguingGnomes_Event_LearnedAboutPhilomeen = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:e9ce6486-3dad-052d-b491-592cf34f8029
msgctxt "hac4bdc65g6e85g416bg8eedg6908800ed318"
msgid "I'll pass on the word - right after I kill you."
msgstr "이야기는 전해 주지, 널 죽여버린 다음에 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = ed193950-bc6b-b16d-7953-e22f81e5f622
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 20
#. CheckFlags:
#.   Tag:
#.      - GNOME(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:ed193950-bc6b-b16d-7953-e22f81e5f622
msgctxt "h99dabdd1g7fe6g4303ga2d8g3374faade78e"
msgid ""
"<i>'Ironhand'. 'Runepowder'. Where have you heard these terms before?</i>"
msgstr "<i>'아이언핸드.' '룬파우더.' 이 이야기들을 어디선가 들어본 적 있을까? 고민한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = ef4d6a48-57a7-0b1f-0b59-8342f8b06f2f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_ArguingGnomes_Event_LearnedAboutPhilomeen = True
#.   Tag:
#.      - REALLY_BESTIAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:ef4d6a48-57a7-0b1f-0b59-8342f8b06f2f
msgctxt "h254831deg4427g402fgb0e3gb519354d92c3"
msgid "I could tell her I ate you. Think she'd believe me?"
msgstr "내가 널 먹여버렸다고 하지. 그래도 날 믿을까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = efcb1119-4da9-4be1-a9c6-1db78ee02212
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:efcb1119-4da9-4be1-a9c6-1db78ee02212
msgctxt "h7ce60558g426ag457fgb9d9g6667e7c55cf9"
msgid "I know what you're doing. And it ends, here and now."
msgstr "네가 뭘 하려는 지 알아. 그리고 그건 지금, 여기서 끝난다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = f0f93ca3-6964-4fd2-8142-42345ad5c9fb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:f0f93ca3-6964-4fd2-8142-42345ad5c9fb
msgctxt "h845e4818g6a23g42aagb03bgc885d881b4ad"
msgid "Try me, you prick."
msgstr "해 보든가, 이 좆만아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = f1de1b71-6bc2-3cae-984e-24390acdbe9f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:f1de1b71-6bc2-3cae-984e-24390acdbe9f
msgctxt "h6db1c2c7g362cg42e5gb080g3ecc4db4cd20"
msgid ""
"We've heard the same ones, I bet. A fistful of fire that can turn cities to "
"dust."
msgstr "우리도 같은 이야기를 들어본 것 같은데. 저것 한 주먹과 불만 있으면 도시 전체를 가루로 만들어 버릴 수 있다더군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Astarion
#. NodeID = f59d795a-1c38-4f64-a539-654a2cfda1f2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#. SetFlags:
#.   Local:
#.     - 9caf82c3-be62-a101-6e04-7d3916926e85_Inclusion = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:f59d795a-1c38-4f64-a539-654a2cfda1f2
msgctxt "hf14a5783g56e7g461cg8c6fga81543d09b20"
msgid "Easy now, let's not do anything hilarious."
msgstr "진정해, 미친 짓은 하지 말자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = f6b5205d-d640-99af-e421-761ee532f291
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:f6b5205d-d640-99af-e421-761ee532f291
msgctxt "h7ea7772agc3dfg4900ga06ag54d93fd75a4b"
msgid ""
"A barrel of this could light up the Underdark. A vial is plenty - just let "
"me go my way."
msgstr "이거 한 통이면 언더다크 전체를 불태울 수 있어. 작은 병 하나도 충분하니까 그냥 날 보내줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = f74e6155-3468-4e4e-a63d-00af930a27df
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:f74e6155-3468-4e4e-a63d-00af930a27df
msgctxt "h857fe461g8f89g4b7agbfc4gcc206a59e277"
msgid "You wouldn't dare - you don't have the courage."
msgstr "어차피 못하잖아, 그럴 용기가 없어 보이는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Wyll
#. NodeID = f8544feb-a1eb-4b01-8277-5eb84e2885d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:f8544feb-a1eb-4b01-8277-5eb84e2885d0
msgctxt "hcdfbf3a2g8a57g4a4fg8aeag50b9644e585a"
msgid "No. No, please!"
msgstr "안 돼. 안 돼, 제발!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = fb0a547e-5733-4112-9a85-096298419362
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_EscapedGnome_Event_OthersFreed = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:fb0a547e-5733-4112-9a85-096298419362
msgctxt "h00f81b79g7fccg4b84g8439gc775ce96196e"
msgid "Get moving. I'll be doing the same."
msgstr "어서 움직여. 나도 그럴 거니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = fb59fa63-b16d-fab1-be5b-e131f404914f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:fb59fa63-b16d-fab1-be5b-e131f404914f
msgctxt "h882c5af8ge759g4b24gb94bg86ade452eb6f"
msgid "No deal."
msgstr "그건 안 되겠는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_PAD
#. Speaker = Player
#. NodeID = f86b1c23-514b-418c-81ed-aaa5e523afb8
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_PAD:f86b1c23-514b-418c-81ed-aaa5e523afb8
msgctxt "hd1fd0683gc077g41f7g9211g2d9b8dc5b4b6"
msgid "Beasts and Hellknights? You can hardly blame him for being a coward."
msgstr "야수와 헬나이트라고? 그를 겁쟁이라고 놀리기엔 너무한데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_PAD
#. Speaker = Player
#. NodeID = f86b1c23-514b-418c-81ed-aaa5e523afb8
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_PAD:f86b1c23-514b-418c-81ed-aaa5e523afb8
msgctxt "h4349fdf4ge3fag4009gaf03g04ed97be5a0e"
msgid "He tried to outrun the furies of hell. Looks like he hit a dead end."
msgstr "그는 지옥의 분노에게서 도망치려고 했어. 결국 막다른 골목에 다다른 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_PAD
#. Speaker = Player
#. NodeID = f86b1c23-514b-418c-81ed-aaa5e523afb8
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_PAD:f86b1c23-514b-418c-81ed-aaa5e523afb8
msgctxt "h8df5b87cg0b5dg458eg854dg869e12286c61"
msgid "Can't blame him for trying to outrun an orthon. Any sane person would."
msgstr "오르쏜으로부터 달아나려고 했겠지. 제정신이라면 누구든 그랬을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_PAD
#. Speaker = Player
#. NodeID = f86b1c23-514b-418c-81ed-aaa5e523afb8
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_PAD:f86b1c23-514b-418c-81ed-aaa5e523afb8
msgctxt "h20e5ac13g72c5g4e06g9327g5bb2f3774105"
msgid ""
"<i>Chk. </i>Better to face a hellbeast than to leave a record of your own "
"cowardice."
msgstr "<i>츠크. </i>본인이 겁쟁이임을 나타내는 기록을 남길 바에 지옥의 야수에 맞서는 편이 낫지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_PAD
#. Speaker = Player
#. NodeID = f86b1c23-514b-418c-81ed-aaa5e523afb8
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_PAD:f86b1c23-514b-418c-81ed-aaa5e523afb8
msgctxt "h0cbd0645g2dc9g46b0g98fcge3fef2ca739b"
msgid "Tried to hide from the merregons. Not that it helped."
msgstr "메레곤들에게서 숨으려고 했군. 딱히 도움이 된 것 같진 않지만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_PAD
#. Speaker = Player
#. NodeID = f86b1c23-514b-418c-81ed-aaa5e523afb8
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_PAD:f86b1c23-514b-418c-81ed-aaa5e523afb8
#, fuzzy
msgctxt "hcfcf7e1egbfa8g4ab7gb26bg5af059ee9955"
msgid "A grim fate. When devils give chase, you're living on borrowed time."
msgstr "암울한 운명이군. 데빌들이 문을 두드리기 시작했다면 그들이 허락한 시간 안에서 살아가는 셈이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_PAD
#. Speaker = Player
#. NodeID = f86b1c23-514b-418c-81ed-aaa5e523afb8
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_PAD:f86b1c23-514b-418c-81ed-aaa5e523afb8
msgctxt "hf4f40cf1g844fg4216g9f79gad5162618dc5"
msgid "He hid from the Hells' forces - but they still got to him."
msgstr "지옥의 세력으로부터 숨었지만, 결국 들키고 말았군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_002
#. Speaker = Petrified Drow
#. NodeID = 1364d55a-3c5e-2edf-4783-4ae3b40ef171
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_002:1364d55a-3c5e-2edf-4783-4ae3b40ef171
msgctxt "h2b4262dag66a6g4f25g9531gaac7d45b9356"
msgid ""
"Now that the monster's dead, might it wear off...? You, begone - I must "
"think."
msgstr "괴물이 죽었으니, 이제 효과가 사라질지도 모르는 건가...? 당신, 저리 가세요. 생각을 좀 해야겠군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_002
#. Speaker = Petrified Drow
#. NodeID = 2b5b2886-1ebd-10a0-3d47-7d3407d8d220
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_002:2b5b2886-1ebd-10a0-3d47-7d3407d8d220
msgctxt "h77517ea3g60a7g46eegaa1fgd83077333bfd"
msgid "Home to Menzoberranzan, once I've caught my breath."
msgstr "집인 멘조베렌잔으로 향해야지, 일단 숨 좀 돌리고 나서 말야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_002
#. Speaker = Player
#. NodeID = 2e54bb5e-4446-d64b-2ee0-72b213d106fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_002:2e54bb5e-4446-d64b-2ee0-72b213d106fd
msgctxt "h055efb13g6494g4ffcg8f19gda28dc7b0d1d"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_002
#. Speaker = Petrified Drow
#. NodeID = 36f80d44-2084-8883-f0f2-92433f39c302
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_PetrifiedDrow_HasMet_Drow_002(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_002:36f80d44-2084-8883-f0f2-92433f39c302
msgctxt "h41fd07e4gb9b2g4310ga51fg0b3bfd92e83b"
msgid "No more chatter."
msgstr "잡담은 이만하죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_002
#. Speaker = Petrified Drow
#. NodeID = 3fb9c4a5-0fe3-7e91-bbf0-e8c85063c776
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_PetrifiedDrow_State_SomeOtherDrowPetrified(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_002:3fb9c4a5-0fe3-7e91-bbf0-e8c85063c776
msgctxt "h7b4c9ebaga240g4cb6g8890g63b8c270ae10"
msgid "I will free the others. And we will return home."
msgstr "일단 다른 이들부터 풀어줘야겠지. 그리고는 집으로 돌아갈 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_002
#. Speaker = Player
#. NodeID = 427ff933-73a7-0adf-5e01-a20a48abdeda
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - UND_PetrifiedDrow_State_AskedWizardFriend(1) = False
#.      - UND_PetrifiedDrow_State_AskedWhatHappened(1) = True
#. SetFlags:
#.   User:
#.     - UND_PetrifiedDrow_State_AskedWizardFriend(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_002:427ff933-73a7-0adf-5e01-a20a48abdeda
msgctxt "h0353b181gaf4cg480ag85adgba04871f6789"
msgid "What did Xargrim and Dhourn fight about?"
msgstr "자그림과 도운은 뭐 때문에 싸운 거죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_002
#. Speaker = Player
#. NodeID = 451ca1d8-e9a4-d19d-7d38-98156902a0e9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - UND_PetrifiedDrow_State_AskedWhatHappened(1) = False
#. SetFlags:
#.   User:
#.     - UND_PetrifiedDrow_State_AskedWhatHappened(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_002:451ca1d8-e9a4-d19d-7d38-98156902a0e9
msgctxt "h1a90ca74g6a71g46adg9e39g1a31f22b47fa"
msgid "Did you pick a fight with that spectator?"
msgstr "당신이 저 스펙테이터와 싸움을 건 건가요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_002
#. Speaker = Petrified Drow
#. NodeID = 4e8342d6-cd27-4204-4966-f800fae31f5c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_002:4e8342d6-cd27-4204-4966-f800fae31f5c
msgctxt "hf5fc7ddfgb495g4febg8779g177b8bbb8d36"
msgid ""
"An unusual spectator at that, adept at petrification. I was... unprepared."
msgstr "일반적인 스펙테이터와 다르게, 석화가 특기더군. 난... 준비가 되지 않았었다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_002
#. Speaker = Player
#. NodeID = 68e500fa-1845-3c1e-9ee2-0f82e59471ae
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - UND_PetrifiedDrow_State_AskedPlans(1) = False
#. SetFlags:
#.   User:
#.     - UND_PetrifiedDrow_State_AskedPlans(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_002:68e500fa-1845-3c1e-9ee2-0f82e59471ae
msgctxt "hcf1eb551g1dfbg45efg87fegde799a707736"
msgid "Where will you go from here?"
msgstr "이제 어디로 갈 생각이죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_002
#. Speaker = Petrified Drow
#. NodeID = 74164aca-26c0-d06c-e4f6-ad6ec72782b9
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DROWHALFELF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_002:74164aca-26c0-d06c-e4f6-ad6ec72782b9
msgctxt "had302252g18e5g430bg9771g452cc5199e8f"
msgid "Half-breed you might be, but my thanks are yours."
msgstr "당신이 잡종이긴 하지만, 제 감사 인사를 건네죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_002
#. Speaker = Petrified Drow
#. NodeID = 74164aca-26c0-d06c-e4f6-ad6ec72782b9
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: LOLTHDROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_002:74164aca-26c0-d06c-e4f6-ad6ec72782b9
msgctxt "h685daa2eg8bbdg4f1dgb564gad21f2f715af"
msgid ""
"Fleshcarver grant you your enemies' blood and the wealth of their houses."
msgstr "플레쉬카버는 당신의 적들의 피와 그들의 집과 재산을 당신에게 허락하였다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_002
#. Speaker = Petrified Drow
#. NodeID = 74164aca-26c0-d06c-e4f6-ad6ec72782b9
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_002:74164aca-26c0-d06c-e4f6-ad6ec72782b9
msgctxt "hb1f6544bgc0dbg49a0g8cdeg1b5f76bd52a0"
msgid ""
"Your spirit is mighty, and your will strong. Let these words alone be my "
"thanks."
msgstr "당신의 영혼은 강력하고, 당신의 의지는 강하다. 이런 말 뿐이더라도 나의 감사가 되길 바란다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_002
#. Speaker = Petrified Drow
#. NodeID = 801672dc-f98b-7472-25bb-1be196f1d1f9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_PetrifiedDrow_HasMet_Drow_002(1) = False
#.   Global:
#.      - UND_PetrifiedDrow_State_WizardPetrified = True
#. SetFlags:
#.   Dialog:
#.     - UND_PetrifiedDrow_HasMet_Drow_002(1) = True
#.   Global:
#.     - UND_PetrifiedDrow_Knows_WizardIsDhourn = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_002:801672dc-f98b-7472-25bb-1be196f1d1f9
msgctxt "ha57e1124g11d7g47fdga1b5g3cac3d4d9af9"
msgid "Dhourn!"
msgstr "도운!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_002
#. Speaker = Petrified Drow
#. NodeID = 879e8555-e3c9-9202-a1ad-db9c7dea7f45
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_MyconidDrowDead_Knows_DhournSearchingForge = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_002:879e8555-e3c9-9202-a1ad-db9c7dea7f45
msgctxt "h25d9ab82g6751g41eag924fg71b05f056564"
msgid ""
"I hardly paid notice. There was talk of a pact - and a forge, as I recall."
msgstr "나는 거의 주의를 기울이지 않았다. 계약 - 대장간에 대한 이야기가 있었던 것으로 기억한다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_002
#. Speaker = Player
#. NodeID = 95d1d0b3-2570-23be-7bba-a716940028fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_002:95d1d0b3-2570-23be-7bba-a716940028fe
msgctxt "hf94510cdg430cg46cegb4d9gb61a354afa57"
msgid "A word of thanks would not be out of order."
msgstr "먼저 감사를 표하는 게 순서 아닌가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_002
#. Speaker = Petrified Drow
#. NodeID = 9ec0c814-f898-b7d3-f344-e080a5b016c3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_002:9ec0c814-f898-b7d3-f344-e080a5b016c3
msgctxt "h7e74c9caga11eg4286g8abfg29469b0e4d5c"
msgid ""
"A man called Xargrim stepped from the shadows. They argued until their words "
"turned to screams. Xargrim summoned the spectator - and fled."
msgstr ""
"그림자 속에서 자그림이라는 남자가 걸어나왔고, 그들은 말다툼을 하다가 결국에는 소리를 지르기 시작했지. 그리고 자그림은 스펙테이터를 "
"소환한 후 도망쳤다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_002
#. Speaker = Petrified Drow
#. NodeID = a39d5a32-c1be-f6df-48f7-74012086b20b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_002:a39d5a32-c1be-f6df-48f7-74012086b20b
msgctxt "h5b366b18g0e72g4442g90a9g3eb8a502545a"
msgid "<i>Gh'rack</i>! There's no time to waste. You must free Dhourn."
msgstr "<i>그'락</i>! 낭비할 시간이 없다. 도운을 해방해줘야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_002
#. Speaker = Petrified Drow
#. NodeID = a3f36674-48fc-b860-d29b-382562c9b165
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_PetrifiedDrow_State_SomeOtherDrowAlive(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_002:a3f36674-48fc-b860-d29b-382562c9b165
msgctxt "h1778e0aeg19bcg4b4cgab67ga018b6b10815"
msgid "We will gather our wits and return to Menzoberranzan."
msgstr "정신을 차리고 멘조베렌잔으로 돌아갈 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_002
#. Speaker = Petrified Drow
#. NodeID = aefd5a48-2fe7-3c5e-a491-9e6fb9b147c4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_PetrifiedDrow_Knows_WizardIsDhourn = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_002:aefd5a48-2fe7-3c5e-a491-9e6fb9b147c4
msgctxt "h02a3d375gbd13g461ega6deg58efdcfd3b8f"
msgid "<i>Gh'rack</i>! A pity Dhourn cannot say the same."
msgstr "<i>그'락</i>! 도운도 그리 말할 수 없어 유감이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_002
#. Speaker = Petrified Drow
#. NodeID = b97a1d9d-347c-eddc-0b6e-0708962bfd37
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_PetrifiedDrow_HasMet_Drow_002(1) = True
#.   Global:
#.      - UND_PetrifiedDrow_State_WizardUnpetrified = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_002:b97a1d9d-347c-eddc-0b6e-0708962bfd37
msgctxt "ha96918bcgb602g45f6gb269g388f7503afc2"
msgid "You have my thanks. That will suffice."
msgstr "나의 고마움을 받아줘. 그걸로 충분할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_002
#. Speaker = Petrified Drow
#. NodeID = bf92dd31-250e-6e63-8096-736d090e9253
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_002:bf92dd31-250e-6e63-8096-736d090e9253
msgctxt "h1ba7bb02g7adfg4c8fg8f86g42769909ab5d"
msgid ""
"I came here with the wizard Dhourn. He vowed to share his fortunes in "
"exchange for protection."
msgstr "나는 위저드 도운과 함께 이곳에 왔다. 그는 보호를 대가로 자신의 운명을 공유하겠다고 맹세했지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_002
#. Speaker = Petrified Drow
#. NodeID = c5cfa3ae-79f0-419b-ad0f-4afa7d3f20d3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_PetrifiedDrow_HasMet_Drow_002(1) = True
#.   Global:
#.      - UND_PetrifiedDrow_State_WizardPetrified = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_002:c5cfa3ae-79f0-419b-ad0f-4afa7d3f20d3
msgctxt "h3f592acegff67g4b2bg8ccdg169a578ec4e6"
msgid "Must I repeat myself? Release Dhourn!"
msgstr "내가 다시 말해야 해? 도운을 풀어 줘!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_002
#. Speaker = Petrified Drow
#. NodeID = dc7188e9-0cb7-31c0-48dc-7cfde6e7f288
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_002:dc7188e9-0cb7-31c0-48dc-7cfde6e7f288
msgctxt "h5c84fbeaga687g4e1eg8cc9g2a42d4c446f9"
msgid "You still breathe after taking that tone. Let that be your thanks."
msgstr "내게 그런 식으로 말하고도 아직 숨이 붙어있는 것, 그게 내 보답이라 생각해라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_002
#. Speaker = Petrified Drow
#. NodeID = e255764e-26ab-fdeb-9c15-51e39be4bd0e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_002:e255764e-26ab-fdeb-9c15-51e39be4bd0e
msgctxt "h73656001g26b7g44a6g97a9g95f6b5e697e8"
msgid "Hardly."
msgstr "그럴 리가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_002
#. Speaker = Petrified Drow
#. NodeID = f0ff7e92-3e13-4262-82ab-dc084ace179d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_PetrifiedDrow_HasMet_Drow_002(1) = False
#.   Global:
#.      - UND_PetrifiedDrow_State_WizardUnpetrified = True
#. SetFlags:
#.   Dialog:
#.     - UND_PetrifiedDrow_HasMet_Drow_002(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_002:f0ff7e92-3e13-4262-82ab-dc084ace179d
msgctxt "h2a358125gd494g4074g9142g0555807a60fc"
msgid "<i>Ol zhah xunor, t'yin. </i>Flesh once more."
msgstr "<i>Ol zhah xunor, t'yin. </i>다시 육신으로 돌아왔군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_003
#. Speaker = Petrified Drow
#. NodeID = 00777112-b27d-088f-644e-44c5904bdce3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_003:00777112-b27d-088f-644e-44c5904bdce3
msgctxt "h76394687g758bg465eg8325g2eb5b3a753e7"
msgid "First I rest. Then... the long journey home."
msgstr "먼저 쉬어야지. 그 다음에는... 집으로 가는 긴 여정."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_003
#. Speaker = Petrified Drow
#. NodeID = 01f57a8d-8313-fbc7-7bd9-c37f2ac7d686
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_PetrifiedDrow_State_SomeOtherDrowPetrified(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_003:01f57a8d-8313-fbc7-7bd9-c37f2ac7d686
msgctxt "h649c7fc2gd319g4800gbb23g2f651c215e5b"
msgid "I need to free the rest. Somehow."
msgstr "나머지를 해방시켜야 합니다. 어떻게든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_003
#. Speaker = Petrified Drow
#. NodeID = 15d83810-3b39-4e0f-aab9-5aeb9e9896cf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_PetrifiedDrow_HasMet_Drow_003(1) = True
#.   Global:
#.      - UND_PetrifiedDrow_State_WizardPetrified = True
#. SetFlags:
#.   Dialog:
#.     - UND_PetrifiedDrow_HasMet_Drow_003(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_003:15d83810-3b39-4e0f-aab9-5aeb9e9896cf
msgctxt "h4d42b707g7b7bg4510g8d28gc04938a757df"
msgid "I - by the Demonweb, it has been so long."
msgstr "난... 데몬웹이여 맙소사, 너무 오랜 시간이 지났군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_003
#. Speaker = Petrified Drow
#. NodeID = 49eb2b09-8e51-14b9-9b8d-e18a10493698
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_PetrifiedDrow_Knows_WizardIsDhourn = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_003:49eb2b09-8e51-14b9-9b8d-e18a10493698
msgctxt "h7f7bc873gab5dg4ab8g87dbge224694c1feb"
msgid "Free the wizard. Dhourn. Please..."
msgstr "그 위저드를 해방시켜줘. 도운. 제발..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_003
#. Speaker = Player
#. NodeID = 5fe3a59f-1f07-822d-0b0a-127d80341aa7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - UND_PetrifiedDrow_State_AskedPlans(1) = False
#. SetFlags:
#.   User:
#.     - UND_PetrifiedDrow_State_AskedPlans(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_003:5fe3a59f-1f07-822d-0b0a-127d80341aa7
msgctxt "hf1a50d75g5f21g4850gaab4ge6f5b7af34f1"
msgid "What comes next for you?"
msgstr "이제 어떻게 할 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_003
#. Speaker = Petrified Drow
#. NodeID = 64336e29-d37f-55d0-ffb7-82bc4ba007fd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_PetrifiedDrow_HasMet_Drow_003(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_003:64336e29-d37f-55d0-ffb7-82bc4ba007fd
msgctxt "hca1e86fdgb952g4da6g8b7ega5aa4b7428f0"
msgid "Think. <i>Think.</i>"
msgstr "생각해. <i>생각해.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_003
#. Speaker = Petrified Drow
#. NodeID = 67a451c6-e88c-1653-d304-a37d287ea339
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_003:67a451c6-e88c-1653-d304-a37d287ea339
msgctxt "ha3a1d224g7181g4b6fgaf4ag5fcfb0788652"
msgid ""
"Came with the wizard - Dhourn. He was looking for treasure and promised a "
"cut. Or so he said."
msgstr "위저드 도운과 함께 왔습니다. 그는 보물을 찾고 있었고, 나에게 몫을 주겠다고 약속했습니다. 적어도 그렇게 말했습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_003
#. Speaker = Petrified Drow
#. NodeID = 6cd110e0-1318-f2b5-9abc-a6dcc520e3d7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_PetrifiedDrow_Knows_WizardIsDhourn = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_003:6cd110e0-1318-f2b5-9abc-a6dcc520e3d7
msgctxt "h77749bf2g8dc7g468fgbf3cgc2e281fc2bbc"
msgid "Dhourn... dead. I need to think."
msgstr "도운... 죽었어. 생각할 필요가 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_003
#. Speaker = Petrified Drow
#. NodeID = 73638def-5e9c-489f-a982-d04fa9bf5e58
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_PetrifiedDrow_HasMet_Drow_003(1) = True
#.   Global:
#.      - UND_PetrifiedDrow_State_WizardUnpetrified = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_003:73638def-5e9c-489f-a982-d04fa9bf5e58
msgctxt "h870562cbga4fcg4cd5ga4deg377ab58a9788"
msgid "Please, just let me rest."
msgstr "제발, 그냥 쉬게 해주세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_003
#. Speaker = Player
#. NodeID = 7f85cf4e-d404-51ad-723c-fcdeeb5d71a7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - UND_PetrifiedDrow_State_AskedWhatHappened(1) = False
#. SetFlags:
#.   User:
#.     - UND_PetrifiedDrow_State_AskedWhatHappened(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_003:7f85cf4e-d404-51ad-723c-fcdeeb5d71a7
msgctxt "h7fab2d43g5aa9g4c5eg9f59ga7cb8829313c"
msgid "What were you thinking, fighting a spectator?"
msgstr "대체 무슨 생각을 한 거야, 스펙테이터와 싸우다니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_003
#. Speaker = Petrified Drow
#. NodeID = 84eca2a3-7887-696e-2539-32f59b0e0af3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_MyconidDrowDead_Knows_DhournSearchingForge = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_003:84eca2a3-7887-696e-2539-32f59b0e0af3
msgctxt "h106d2288gecc4g4c28g9fe0g0cdf82bb56f6"
msgid ""
"Hard to tell - more spittle than words. Something about a forge, I think. "
"Not certain though."
msgstr "말하기 어렵네요. 말하는 소리보다 침이 더 많이 튀었습니다. 대장간에 대한 얘기였던 것 같은데, 확실하지는 않습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_003
#. Speaker = Petrified Drow
#. NodeID = 9277513e-4250-4be8-88df-d57d64420be2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_PetrifiedDrow_HasMet_Drow_003(1) = True
#.   Global:
#.      - UND_PetrifiedDrow_State_WizardPetrified = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_003:9277513e-4250-4be8-88df-d57d64420be2
msgctxt "h15ff8924gac29g4697g90f9gac9bfd10529b"
msgid "Please. Free the wizard."
msgstr "제발. 그 위저드를 풀어 주세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_003
#. Speaker = Petrified Drow
#. NodeID = 9511fe44-2554-12cf-45ca-2b791c6dc5c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_003:9511fe44-2554-12cf-45ca-2b791c6dc5c0
msgctxt "h1bef8c27gb04fg4ac1ga052gc37702797e90"
msgid "The others are... Think, damn it, think."
msgstr "나머지들은... 생각해, 제길, 생각하라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_003
#. Speaker = Player
#. NodeID = a5dc53bf-50c6-26dc-faa2-4d8e9017c96f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - UND_PetrifiedDrow_State_AskedWizardFriend(1) = False
#.      - UND_PetrifiedDrow_State_AskedWhatHappened(1) = True
#. SetFlags:
#.   User:
#.     - UND_PetrifiedDrow_State_AskedWizardFriend(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_003:a5dc53bf-50c6-26dc-faa2-4d8e9017c96f
msgctxt "h2475622ag94dag4e46gb32ag66251dc4eb6a"
msgid "What were Dhourn and Xargrim fighting about?"
msgstr "도운과 자그림은 무엇을 두고 싸웠지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_003
#. Speaker = Petrified Drow
#. NodeID = b3f713f8-3651-1cdd-c997-8d7c0d8b8bd9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_003:b3f713f8-3651-1cdd-c997-8d7c0d8b8bd9
msgctxt "he670edfcgf438g4a93gb22ag73d56f36f450"
msgid ""
"A rival of his popped out of nowhere. 'Xargrim'... something like that. "
"Unpleasant fellow."
msgstr "그의 라이벌이 갑자기 나타났어요. '자그림'... 그런 이름이었나? 불쾌한 녀석이더군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_003
#. Speaker = Player
#. NodeID = cf2aa28c-d74e-10e6-5d26-44cfda433a10
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_003:cf2aa28c-d74e-10e6-5d26-44cfda433a10
msgctxt "hc9c8d463g380eg479dg90f4g91a14ea0545c"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_003
#. Speaker = Petrified Drow
#. NodeID = f6699339-b5da-852c-fa78-066bebb026d1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_003:f6699339-b5da-852c-fa78-066bebb026d1
msgctxt "h4b837019g00e4g452egb9c4g6fd859df85a0"
msgid ""
"They had words. Nasty ones. Xargrim summoned the spectator. Never saw one "
"like that - petrified us all."
msgstr ""
"그들은 대화를 나눴습니다. 심한 말이었어요. 자그림은 스펙테이터를 소환하더군요. 그런 건 결코 본 적이 없던 것이었습니다. 우리 모두를 "
"돌로 만들어 버렸고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_003
#. Speaker = Petrified Drow
#. NodeID = f6957519-ebab-46e5-b8ba-c4cd5cf7b5d2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_PetrifiedDrow_HasMet_Drow_003(1) = False
#.   Global:
#.      - UND_PetrifiedDrow_State_WizardUnpetrified = True
#. SetFlags:
#.   Dialog:
#.     - UND_PetrifiedDrow_HasMet_Drow_003(1) = True
#.   Global:
#.     - UND_PetrifiedDrow_Knows_WizardIsDhourn = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_003:f6957519-ebab-46e5-b8ba-c4cd5cf7b5d2
msgctxt "heb919a56gb0aeg40d5g85e8g81301618b80a"
msgid "Talk to Dhourn. I... I must rest."
msgstr "도운에게 말해. 난... 난 좀 쉬어야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_003
#. Speaker = Petrified Drow
#. NodeID = f6c52444-4f1d-56c5-1174-3a80f48ed640
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_003:f6c52444-4f1d-56c5-1174-3a80f48ed640
msgctxt "hb01b6d75gf59eg444ega587g073fff8b0346"
msgid "A mistake. All of it."
msgstr "실수였어요. 전부 다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_004
#. Speaker = Player
#. NodeID = 1528f36a-baf9-11e0-b738-6079f964b935
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_004:1528f36a-baf9-11e0-b738-6079f964b935
msgctxt "hdf82de1dg58f1g4ba5gb5e7g9873d7829ea5"
msgid "Dhourn? Who is that?"
msgstr "도운이라고? 그게 누구지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_004
#. Speaker = Petrified Drow
#. NodeID = 3e3a680d-a374-ad41-1e3f-13c55717df8c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_PetrifiedDrow_State_WizardPermaDefeated = True
#.   Object:
#.      - UND_PetrifiedDrow_State_SomeOtherDrowPetrified(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_004:3e3a680d-a374-ad41-1e3f-13c55717df8c
msgctxt "hf052d20bgd0a9g4e5aga669g74d7ff08f8e9"
msgid "Spectator's dead. The spell could fade..."
msgstr "스펙테이터가 죽었어. 주문의 효과가 사라질지도..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_004
#. Speaker = Petrified Drow
#. NodeID = 4a17b687-5900-0c64-ee2d-47a06cb395bc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_004:4a17b687-5900-0c64-ee2d-47a06cb395bc
msgctxt "h513bf779g687ag42baga55dgc41ed0bb0898"
msgid "Home."
msgstr "집."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_004
#. Speaker = Petrified Drow
#. NodeID = 53cfaa32-1096-4a32-b05c-5fe6dc630345
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_PetrifiedDrow_HasMet_Drow_004(1) = False
#.   Global:
#.      - UND_PetrifiedDrow_State_WizardPetrified = True
#. SetFlags:
#.   Dialog:
#.     - UND_PetrifiedDrow_HasMet_Drow_004(1) = True
#.   Global:
#.     - UND_PetrifiedDrow_Knows_WizardIsDhourn = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_004:53cfaa32-1096-4a32-b05c-5fe6dc630345
msgctxt "h1ee85304g6861g4912gac60g804b1451535e"
msgid "Dhourn."
msgstr "도운."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_004
#. Speaker = Player
#. NodeID = 5f2b9c8f-552d-16df-22d9-5d945fb50985
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_004:5f2b9c8f-552d-16df-22d9-5d945fb50985
msgctxt "h1c70984age721g4f71g958dg5aa2d80d84f8"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_004
#. Speaker = Narrator
#. NodeID = 5fca8271-8756-537b-9651-065e8f4ff63f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_004:5fca8271-8756-537b-9651-065e8f4ff63f
msgctxt "h9e2b9ad3gb383g48e0gac85g0e4e937ba19b"
msgid "*The drow is silent.*"
msgstr "*드로우는 아무런 말도 하지 않습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_004
#. Speaker = Narrator
#. NodeID = 68938c62-c51e-4cb9-b62e-cefb3ace4940
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_PetrifiedDrow_HasMet_Drow_004(1) = True
#.   Global:
#.      - UND_PetrifiedDrow_State_WizardUnpetrified = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_004:68938c62-c51e-4cb9-b62e-cefb3ace4940
msgctxt "h74d3894ag2976g4114g9d24g46a9d5f3fc71"
msgid "*The drow eyes you warily.*"
msgstr "*드로우의 눈이 당신을 신중히 바라봅니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_004
#. Speaker = Petrified Drow
#. NodeID = 68cca9be-85bc-e44a-341f-fe8f1f4f353a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_004:68cca9be-85bc-e44a-341f-fe8f1f4f353a
msgctxt "h367f0bf0gda51g4d67g90e5gc3e39552712c"
msgid "The wizard. Our employer."
msgstr "위저드. 우리 고용주."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_004
#. Speaker = Petrified Drow
#. NodeID = 84039de4-407b-5c7d-132e-711865c4ba93
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_PetrifiedDrow_HasMet_Drow_004(1) = False
#.   Global:
#.      - UND_PetrifiedDrow_State_WizardUnpetrified = True
#. SetFlags:
#.   Dialog:
#.     - UND_PetrifiedDrow_HasMet_Drow_004(1) = True
#.   Global:
#.     - UND_PetrifiedDrow_Knows_WizardIsDhourn = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_004:84039de4-407b-5c7d-132e-711865c4ba93
msgctxt "h53bfbfcdg2f1eg4dcdg9ad4gef9f31356a29"
msgid "Speak with Dhourn."
msgstr "도운과 대화해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_004
#. Speaker = Narrator
#. NodeID = 91a62a11-75c0-43df-9654-85986955ee55
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_PetrifiedDrow_HasMet_Drow_004(1) = True
#.   Global:
#.      - UND_PetrifiedDrow_State_WizardPetrified = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_004:91a62a11-75c0-43df-9654-85986955ee55
msgctxt "h0d5d3751geedbg4257g826fg9de945538ef0"
msgid "*The drow says nothing more, his eyes wide with shock.*"
msgstr "*드로우는 아무 말도 하지 않고, 충격으로 눈을 크게 떴습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_004
#. Speaker = Petrified Drow
#. NodeID = 91fe0ab6-a7ab-5763-36d0-04af868bae35
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_004:91fe0ab6-a7ab-5763-36d0-04af868bae35
msgctxt "h3d7c9af2g1ff8g4977gadb9gefe0c7c253c9"
msgid "Too late for Dhourn."
msgstr "도운은 이제 너무 늦었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_004
#. Speaker = Petrified Drow
#. NodeID = 9455a7c7-d209-3a98-5a4a-aa361da663a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_004:9455a7c7-d209-3a98-5a4a-aa361da663a4
msgctxt "h7cdebb94geae6g4902gb52fgd36ae5529d10"
msgid "They fought. Loud and nasty. Xargrim summoned the spectator and ran."
msgstr "그들은 싸웠다. 시끄럽고 끔찍하게. 자그림은 스펙테이터를 소환하고 도망쳤다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_004
#. Speaker = Player
#. NodeID = 9cf49e46-1244-6958-c14b-378320a48ea4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - UND_PetrifiedDrow_State_AskedWizardFriend(1) = False
#.      - UND_PetrifiedDrow_State_AskedWhatHappened(1) = True
#. SetFlags:
#.   User:
#.     - UND_PetrifiedDrow_State_AskedWizardFriend(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_004:9cf49e46-1244-6958-c14b-378320a48ea4
msgctxt "haabb1183gbc66g4e54g971ag6e70d85ebffb"
msgid "Tell me more about this fight between Dhourn and Xargrim."
msgstr "도운과 자그림 사이에 있었던 이 싸움에 대해 더 말해줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_004
#. Speaker = Player
#. NodeID = a3e32c30-79d1-048d-7267-a780266f3e71
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_004:a3e32c30-79d1-048d-7267-a780266f3e71
msgctxt "hd70d49b0gdf9fg4a1dg97cegc7a1969e7d65"
msgid "You seem distressed. Will you be all right?"
msgstr "당신 불안해 보이는데. 괜찮아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_004
#. Speaker = Petrified Drow
#. NodeID = a97beb6e-5e9d-b2fb-d41c-71dce89d9ec0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_004:a97beb6e-5e9d-b2fb-d41c-71dce89d9ec0
msgctxt "h6063f855g8bcdg4d10gad72g65044647e9d2"
msgid "Yes."
msgstr "그래."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_004
#. Speaker = Petrified Drow
#. NodeID = ac8af1ea-8d21-b27e-c661-b67091ab244e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_PetrifiedDrow_State_SomeOtherDrowPetrified(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_004:ac8af1ea-8d21-b27e-c661-b67091ab244e
msgctxt "h1bebeb98gd661g4627gb321g72230841111f"
msgid "Help them. Then home."
msgstr "그들을 도와. 그리고 돌아가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_004
#. Speaker = Petrified Drow
#. NodeID = bcc8597e-e3c7-a8fe-56ac-76b9bad451af
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_004:bcc8597e-e3c7-a8fe-56ac-76b9bad451af
msgctxt "h7175bb3dg1c46g4f98g9344g630b383e304c"
msgid ""
"Dhourn hired us. Promised riches. Then Xargrim came. Dhourn's old friend."
msgstr "도운이 우리를 고용했다. 그는 우리에게 부유함을 약속했다. 그때 자그림이 왔다. 도운의 오랜 친구였다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_004
#. Speaker = Player
#. NodeID = cc05a314-54f3-0609-2891-7b56d141bbcf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - UND_PetrifiedDrow_State_AskedPlans(1) = False
#. SetFlags:
#.   User:
#.     - UND_PetrifiedDrow_State_AskedPlans(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_004:cc05a314-54f3-0609-2891-7b56d141bbcf
msgctxt "ha1748533g37f4g4265ga50cg681550fa3b7d"
msgid "Where will you go next?"
msgstr "다음은 어디로 갈건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_004
#. Speaker = Petrified Drow
#. NodeID = e817c948-b47c-7576-3628-8097b8881255
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_MyconidDrowDead_Knows_DhournSearchingForge = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_004:e817c948-b47c-7576-3628-8097b8881255
msgctxt "h82640fcfg0697g4f39ga09ag59d2cf53c1d7"
msgid ""
"First they argued. About a pact, a forge. Then came spells. You know the "
"rest."
msgstr "처음엔 그들이 다퉜지. 계약, 대장간에 대해. 그 때 주문이 시전됐고. 나머지는 당신이 아는 거고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_004
#. Speaker = Player
#. NodeID = ea2b9a0c-5482-09af-f5b5-c4b18ba6f99d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - UND_PetrifiedDrow_State_AskedWhatHappened(1) = False
#. SetFlags:
#.   User:
#.     - UND_PetrifiedDrow_State_AskedWhatHappened(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_004:ea2b9a0c-5482-09af-f5b5-c4b18ba6f99d
msgctxt "hd4cfbe40gceb0g4ab2gbcfdg1b0a253d12cf"
msgid "Looks like the spectator got the best of you. Weren't you prepared?"
msgstr "스펙테이터가 당신을 이기고 말았네. 준비가 안됐었나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_004
#. Speaker = Petrified Drow
#. NodeID = f1a7213e-7ef3-a725-75cb-d745186c6288
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_004:f1a7213e-7ef3-a725-75cb-d745186c6288
msgctxt "h9c0dc6d9g6deag486agbcaeg7a308afd5787"
msgid "No. Not this time."
msgstr "아니. 이번엔 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_005
#. Speaker = Petrified Drow
#. NodeID = 20fd45d5-f8fd-b6e4-93bd-d80fc00f4c6f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_005:20fd45d5-f8fd-b6e4-93bd-d80fc00f4c6f
msgctxt "h4fef49d3gebe6g4f47gaec0gd1a4f9f9805c"
msgid ""
"Came across Xargrim... his friend - a fight broke out. He summoned a "
"spectator. <i>Fool.</i>"
msgstr "자그림을 우연히 만났어... 그의 친구였는데, 싸움이 벌어졌어. 그는 스펙테이터를 소환했어. <i>바보 같이.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_005
#. Speaker = Player
#. NodeID = 2a05add2-2baa-b0e2-e612-3c7754a5a4a6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - UND_PetrifiedDrow_State_AskedPlans(1) = False
#. SetFlags:
#.   User:
#.     - UND_PetrifiedDrow_State_AskedPlans(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_005:2a05add2-2baa-b0e2-e612-3c7754a5a4a6
msgctxt "h3c59b371gedd8g4ef0gae0eg1e1ea1688dc8"
msgid "What will you do now?"
msgstr "이제 어떻게 할 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_005
#. Speaker = Petrified Drow
#. NodeID = 2f8e2c23-d170-d120-80e3-026a842b8042
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_PetrifiedDrow_State_SomeOtherDrowPetrified(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_005:2f8e2c23-d170-d120-80e3-026a842b8042
msgctxt "h2f557017ga30ag4ac9g83d4g65d9256bcdbf"
msgid "The others... need to get them out..."
msgstr "다른 사람들... 그들을 구해야 해..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_005
#. Speaker = Petrified Drow
#. NodeID = 32e51cf2-1384-b0c4-1aba-44b38c7b2591
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_PetrifiedDrow_State_WizardPermaDefeated = True
#.   Object:
#.      - UND_PetrifiedDrow_State_SomeOtherDrowAlive(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_005:32e51cf2-1384-b0c4-1aba-44b38c7b2591
msgctxt "h6d2ade02gd961g48acgb5b3g78aa25d25bda"
msgid "Thank you. Your help was... appreciated. We'll be leaving soon."
msgstr "감사합니다. 당신의 도움은... 감사했습니다. 우리는 곧 떠날 것입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_005
#. Speaker = Petrified Drow
#. NodeID = 4d3891f6-a8b5-bcb3-f8d9-a47902b72a29
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_MyconidDrowDead_Knows_DhournSearchingForge = True
#.     - UND_PetrifiedDrow_Knows_WizardIsDhourn = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_005:4d3891f6-a8b5-bcb3-f8d9-a47902b72a29
msgctxt "h68616952g3dd3g4e19gb1b3g34dbacbe4ee9"
msgid "Wizard Dhourn hired us... find a... forge."
msgstr "위저드 도운이 우리를 고용했어... 대장간을... 찾으려고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_005
#. Speaker = Petrified Drow
#. NodeID = 69c6ccb3-707c-4b8e-a613-5891bddbb98c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_PetrifiedDrow_HasMet_Drow_005(1) = False
#.   Global:
#.      - UND_PetrifiedDrow_State_WizardPetrified = True
#. SetFlags:
#.   Dialog:
#.     - UND_PetrifiedDrow_HasMet_Drow_005(1) = True
#.   Global:
#.     - UND_PetrifiedDrow_Knows_WizardIsDhourn = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_005:69c6ccb3-707c-4b8e-a613-5891bddbb98c
msgctxt "ha52cd88ag6815g4c7cga4c3g3b08b6159078"
msgid "Dhourn - free him!"
msgstr "도운 - 그를 해방해 줘!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_005
#. Speaker = Petrified Drow
#. NodeID = 7ee94cbc-913b-65d7-aefd-aa147d4dd32f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_005:7ee94cbc-913b-65d7-aefd-aa147d4dd32f
msgctxt "hcd623f41g7736g4567g897eg095f4c528bd9"
msgid "He escaped. His spectator petrified us... somehow."
msgstr "그는 도망쳤고 스펙테이터가 어떤 식으로... 우리를 석화시켰지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_005
#. Speaker = Petrified Drow
#. NodeID = 951c5094-a101-7e3e-8eb9-e2caa0e4513f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_005:951c5094-a101-7e3e-8eb9-e2caa0e4513f
msgctxt "h1d5070e4g27fag4f8fgbeffg694472946717"
msgid "Rest. Return home. Alone."
msgstr "쉬고. 집으로 돌아가야죠. 혼자서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_005
#. Speaker = Petrified Drow
#. NodeID = 99aec724-7121-9876-248f-c88e0e5fa6d8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_PetrifiedDrow_State_SomeOtherDrowAlive(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_005:99aec724-7121-9876-248f-c88e0e5fa6d8
msgctxt "hac5c01a6g8354g49bbg8a8egf54880bd1bd7"
msgid "Rest. Go home. Soon as the others are ready."
msgstr "쉬고. 집으로 돌아가야죠. 다른 사람들이 준비가 되는 대로."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_005
#. Speaker = Petrified Drow
#. NodeID = a624fd99-1703-4cb6-97f9-14076f2aac09
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_PetrifiedDrow_HasMet_Drow_005(1) = True
#.   Global:
#.      - UND_PetrifiedDrow_State_WizardUnpetrified = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_005:a624fd99-1703-4cb6-97f9-14076f2aac09
msgctxt "h7639f3c4g55a1g4d2bga0b8gd907bb672f60"
msgid "I need rest."
msgstr "휴식이 필요해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_005
#. Speaker = Petrified Drow
#. NodeID = b09932f9-cfb8-47a3-8838-8a687077073b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_PetrifiedDrow_HasMet_Drow_005(1) = True
#.   Global:
#.      - UND_PetrifiedDrow_State_WizardPetrified = True
#. SetFlags:
#.   Global:
#.     - UND_PetrifiedDrow_Knows_WizardIsDhourn = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_005:b09932f9-cfb8-47a3-8838-8a687077073b
msgctxt "h59eef4f7g4c22g48c1gb300g589a11cdddcb"
msgid "We can't  leave Dhourn behind. We'll find a way."
msgstr "도운을 남겨둘 순 없습니다. 방법을 찾을 것입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_005
#. Speaker = Player
#. NodeID = bb113266-064d-d6c0-d351-09748f226d39
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_005:bb113266-064d-d6c0-d351-09748f226d39
msgctxt "h087daf80g45ceg4843g9996g07d2c6563f0d"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_005
#. Speaker = Petrified Drow
#. NodeID = c791f4bd-ec26-4739-e0fb-7741604e20ee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_005:c791f4bd-ec26-4739-e0fb-7741604e20ee
msgctxt "h807e572eg5392g4481g8a26g44eb0620a7c0"
msgid "The forge... he wanted the forge..."
msgstr "대장간... 그는 그 대장간을 원했어..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_005
#. Speaker = Player
#. NodeID = cf9ada9f-61bc-85ff-19fe-b78bd838f0c8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - c476347b-e9db-8afc-4ed3-c418caaa57d7_Xargrism = True
#.   User:
#.      - UND_PetrifiedDrow_State_AskedWizardFriend(1) = False
#. SetFlags:
#.   User:
#.     - UND_PetrifiedDrow_State_AskedWizardFriend(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_005:cf9ada9f-61bc-85ff-19fe-b78bd838f0c8
msgctxt "h185b63b1g0cf9g432bgaee8g1e6d45804ff6"
msgid "What can you tell me about Xargrim?"
msgstr "자그림에 대해 뭘 말해 줄 수 있어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_005
#. Speaker = Player
#. NodeID = d6df3ca8-5328-ba31-e193-9f5b34edd71b
