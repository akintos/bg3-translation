msgctxt "h306d0714g1c1cg428bgbb93g3e0c392aca91"
msgid "Dragon! Look out!"
msgstr "드래곤이다! 조심해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_DragonShadow
