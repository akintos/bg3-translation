msgid "*The spell's power wanes. You can ask no more questions.*"
msgstr "*주문의 힘이 약해집니다. 더 이상 질문할 수 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_DeadPrisoner_Dead
#. Speaker = Player
#. NodeID = bf168d2f-d7f7-ce5b-6314-b5322c7cc891
