#, fuzzy
msgctxt "hcccaabe9g565dg4cc6gb85dge3d2f5375b0b"
msgid "Me too. But - noblestalk. You... you have it?"
msgstr "나도. 하지만 - 귀족줄기. 네가... 네가 그걸 가지고 있어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Player
#. NodeID = b4d50a7e-c79b-e03f-a6b3-a869c57c52af
