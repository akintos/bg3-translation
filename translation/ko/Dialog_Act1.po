msgctxt "h43f885d2g36c9g49bcgb91cg3c6173543c9e"
msgid "Please - don't!"
msgstr "제발... 그만해!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_AD_GithBoy_AssaultReaction
#. Speaker = Youth Varrl
#. NodeID = e4974276-dfa7-4612-854a-4b6c4cd9c83e
