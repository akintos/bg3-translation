#.     - GOB_PainPriest_Event_Mercy = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:ceebd620-17ea-f952-91e4-28e77d8b9945
msgctxt "h5a73d4bfged0cg4f0eg9356gd66ca723f7b9"
msgid "<i>Yelp loudly and dramatically beg for mercy.</i>"
msgstr "<i>큰 소리로 비명을 지르며 요란하게 자비를 구한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Abdirak
#. NodeID = cf7305ac-5733-d2dc-5a02-fd456b42f67c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_PainPriest_Event_ReactToMocking = True
#.     - GOB_PainPriest_Event_BadReaction = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:cf7305ac-5733-d2dc-5a02-fd456b42f67c
msgctxt "ha12612fcg5df3g4c7fg9d0dgc68ec128d734"
msgid "Come now, child. You can do better than that."
msgstr "어서, 아이야. 더 잘할 수 있잖니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Abdirak
#. NodeID = d3c5b379-f65d-1125-fbc8-e3f214efa698
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_PainPriest_Event_BadReaction = True
#.     - GOB_PainPriest_Event_ReactToSilence = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:d3c5b379-f65d-1125-fbc8-e3f214efa698
msgctxt "hcfce8403g7874g44bfga750g458e9273d5eb"
msgid "Come now, child. Do not hold it in!"
msgstr "이런, 아이야. 참지 말거라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Abdirak
#. NodeID = d5f807be-d3d8-b983-576e-d3d6e3141be4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_PainPriest_Event_BadReaction = True
#.     - GOB_PainPriest_Event_ReactToSilence = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:d5f807be-d3d8-b983-576e-d3d6e3141be4
msgctxt "h4e5b36cagf327g4b01g9129g3b860228795a"
msgid "Do not keep quiet, dear one. Let me hear you."
msgstr "묵묵히 있지 마라, 얘야. 내가 너를 듣게 해다오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Abdirak
#. NodeID = da2eb7bd-75e1-b9e6-7f41-2ae9251d02bf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_PainPriest_Event_SecondHitDone = False
#.      - GOB_PainPriest_Event_ReactToMocking = True
#.      - GOB_PainPriest_Event_FirstHitDone = True
#. SetFlags:
#.   Global:
#.     - GOB_PainPriest_Event_SecondHitDone = True
#.     - GOB_PainPriest_Event_ReactToMocking = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:da2eb7bd-75e1-b9e6-7f41-2ae9251d02bf
msgctxt "ha13a2d25g0e30g45cbgb272g3b9050425c37"
msgid "You will regret such mockery."
msgstr "방금 그 조롱을 후회하게 될 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Abdirak
#. NodeID = deaebe76-3f41-c32c-c97c-122a0e5eef06
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_PainPriest_Event_ReactToCry = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:deaebe76-3f41-c32c-c97c-122a0e5eef06
msgctxt "he7170519g8a01g4f6egad8fga75f8c17e7bb"
msgid "Your voice sounds so sweet, dear one. Keep going!"
msgstr "너의 목소리가 너무나 감미롭구나, 얘야. 계속해라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Abdirak
#. NodeID = e11b08cb-0cdf-a8e5-03bc-a5cb37ade38e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:e11b08cb-0cdf-a8e5-03bc-a5cb37ade38e
msgctxt "h14a71976g43a0g4942g8d22g50257dbd971e"
msgid "As you wish, dear one."
msgstr "그렇게 하마, 얘야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Player
#. NodeID = e754c7b8-d178-065a-d39a-4ded7b49ca72
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_PainPriest_Event_MonkTwice = False
#.      - GOB_PainPriest_Event_Monk = True
#. SetFlags:
#.   Global:
#.     - GOB_PainPriest_Event_MonkTwice = True
#.     - GOB_PainPriest_Event_ReactToSilence = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:e754c7b8-d178-065a-d39a-4ded7b49ca72
msgctxt "h7f5a8b98g0ef3g4cdaga3b6g9d55e77e34ea"
msgid "<i>Slow your heart and sink deeper into the stillness.</i>"
msgstr "<i>호흡을 진정시키고 고요 속으로 더욱 침잠한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Abdirak
#. NodeID = eb93d139-9438-7ecf-f6b0-1c43889a957c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_PainPriest_Event_ReactToCry = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:eb93d139-9438-7ecf-f6b0-1c43889a957c
msgctxt "hf8e8ef12gd500g4fb4g8ebeg98f1a899e5bf"
msgid "Is that a moan I hear? <i>Delightful. </i>"
msgstr "신음소리가 들리는 것 같은데? <i>아름다워.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Player
#. NodeID = fabec443-88be-a635-176f-244204d4c3b5
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - GOB_PainPriest_Event_MercyTwice = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:fabec443-88be-a635-176f-244204d4c3b5
msgctxt "h09790fe0gc250g4fd4gadeeg29b462156620"
msgid "Ah, mercy! I can't take it... it's too much!"
msgstr "살려주세요! 더는 못 버티겠어요... 너무 아파요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_PostPenance
#. Speaker = Abdirak
#. NodeID = 33348e45-96ad-2ef9-9124-66de616e9d0e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_PostPenance:33348e45-96ad-2ef9-9124-66de616e9d0e
msgctxt "ha80c2380g8fecg470bg99d2gde666daa5547"
msgid "And on a personal note, thank you. That was positively <i>divine. </i>"
msgstr "개인적으로도 고맙다. 정말 <i>신성했어. </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_PostPenance
#. Speaker = Abdirak
#. NodeID = 346c7f07-80a0-5109-35d8-af2494be424d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_PostPenance:346c7f07-80a0-5109-35d8-af2494be424d
msgctxt "hbf466293gfc50g454fgbb88g1021a61e072d"
msgid ""
"Loviatar herself found your performance<i> inspiring </i>and wishes to bless "
"you."
msgstr "로비아타님이 친히 너의 공연을 <i>인상 깊게</i> 보셨다. 그리고 너에게 축복을 내리고자 하신다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_PostPenance
#. Speaker = Abdirak
#. NodeID = 4f5da17d-846a-896a-d913-663564ba6fa5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_PostPenance:4f5da17d-846a-896a-d913-663564ba6fa5
msgctxt "h92155023g80a1g4303gb3d5g9d405652b3bb"
msgid "Excuse me - I must rest and think."
msgstr "실례하지만, 쉬고 생각해 봐야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_PostPenance
#. Speaker = Abdirak
#. NodeID = 59017772-53c8-d8fb-3f42-8878e3375c01
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_PainPriest_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_PainPriest_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_PostPenance:59017772-53c8-d8fb-3f42-8878e3375c01
msgctxt "hca5f6497gea01g48d4ga7c1gd49473800572"
msgid ""
"A most <i>invigorating </i>session - but even as the soul sings, the flesh "
"fades. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_PostPenance
#. Speaker = Abdirak
#. NodeID = 6194cb1f-e8e7-7304-cffd-0f691237f77e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_PainPriest_State_ReactedToPenance = True
#.   Object:
#.     - GOB_PainPriest_Event_Reward(1) = True
#.   Quest:
#.     - HIDDEN_WLD_Boosters.GOB_PainPriest_Penanced(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_PostPenance:6194cb1f-e8e7-7304-cffd-0f691237f77e
msgctxt "he9fbb2a7g0753g476eg8214g6f8273fd2054"
msgid "Simply be still, dear one."
msgstr "가만히 있기만 하면 된다, 얘야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_PostPenance
#. Speaker = Abdirak
#. NodeID = 87440f1c-eb4c-8670-08ec-ebe6d597b4ea
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_PainPriest_State_WasPenitent(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_PostPenance:87440f1c-eb4c-8670-08ec-ebe6d597b4ea
msgctxt "hdbbe6758g0e0bg40b5g9912g2c6b9419360b"
msgid "My beautiful, penitent child."
msgstr "내 아름답고 참회하는 아이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_PostPenance
#. Speaker = Player
#. NodeID = 8e8a56ef-bc42-1644-6f10-0041cbdb7b31
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_PostPenance:8e8a56ef-bc42-1644-6f10-0041cbdb7b31
msgctxt "hc469446dg3593g419bg93f8g89444d00680f"
msgid "What would such a blessing entail?"
msgstr "그 축복에는 어떤 결과가 따르지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_PostPenance
#. Speaker = Abdirak
#. NodeID = d451fd94-13be-4cb2-7fa3-c31e4a0eb9c1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_PainPriest_State_ReactedToPenance = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_PostPenance:d451fd94-13be-4cb2-7fa3-c31e4a0eb9c1
msgctxt "h9736ff0dg0fbbg453ag9af6g683467fa5d5e"
msgid "You have already enjoyed my ministrations - do not be greedy."
msgstr "너는 이미 내 봉사를 즐겼다. 욕심 부리지 말거라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_PostPenance
#. Speaker = Player
#. NodeID = da1347e3-460e-224a-c63d-848bb9733dc2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_PostPenance:da1347e3-460e-224a-c63d-848bb9733dc2
msgctxt "h1f405486g0a27g438bgb31bg5c4f9cab87ee"
msgid "<i>Leave. </i>"
msgstr "<i>떠난다. </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_PostPenance
#. Speaker = Abdirak
#. NodeID = f26c6b65-cc82-f211-493c-b5cd9d118614
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_PostPenance:f26c6b65-cc82-f211-493c-b5cd9d118614
msgctxt "h28343503gdedcg46b6ga7afg6931675b63cd"
msgid "So it is with the Lady's embrace. Excuse me - I must rest and think."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_RewardPenance
#. Speaker = Player
#. NodeID = 04390cda-1c6d-fd96-d424-2ab452ba38de
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_RewardPenance:04390cda-1c6d-fd96-d424-2ab452ba38de
msgctxt "h1697b3b8g4067g4a95gb258g7d6e13d53b29"
msgid "Thank you. I enjoyed myself."
msgstr "고마워. 나 스스로도 즐겼어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_RewardPenance
#. Speaker = Abdirak
#. NodeID = 127a1743-5e46-edf5-08b2-f6f30f641772
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_RewardPenance:127a1743-5e46-edf5-08b2-f6f30f641772
msgctxt "hdbf5924bgf901g4d70gb28fg305190e7b53f"
msgid "Wait, penitent one."
msgstr "기다리거라, 참회하는 이여."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_RewardPenance
#. Speaker = Abdirak
#. NodeID = 1c693b5a-fc5c-2457-5441-14dbae6d5eeb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_PainPriest_Event_PickSlashing = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_RewardPenance:1c693b5a-fc5c-2457-5441-14dbae6d5eeb
msgctxt "h2b48609egb19fg4fe8g89a6g742007e9b953"
msgid "I could feel Loviatar's pleasure with every swing of my axe."
msgstr "내가 도끼를 휘두를 때마다 로비아타님의 기쁨을 느낄 수 있었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_RewardPenance
#. Speaker = Abdirak
#. NodeID = 25b7c8bb-cc94-d9f7-f88f-1132d28e3521
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_PainPriest_State_WasPenitent(1) = True
#.     - GOB_PainPriest_State_Penitent(1) = False
#.     - GOB_PainPriest_State_CancelledPenitent(1) = False
#.   Global:
#.     - GOB_PainPriest_State_ReactedToPenance = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_RewardPenance:25b7c8bb-cc94-d9f7-f88f-1132d28e3521
msgctxt "h7cc33595g1bd6g47e4g962dg200c5127e279"
msgid ""
"Sweet child. While I enjoyed that, I'm afraid your reaction was... lacking."
msgstr "감미로운 아이야, 나는 즐거웠지만, 너의 반응이… 부족했던 모양이구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_RewardPenance
#. Speaker = Abdirak
#. NodeID = 264f231b-6ea5-d4d4-765f-264b448d03ba
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_PainPriest_Event_PickScourge = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_RewardPenance:264f231b-6ea5-d4d4-765f-264b448d03ba
msgctxt "h2c467c06g1017g4c57gb476g4349f9756b0f"
msgid "I could feel Loviatar's pleasure with every sting of my scourge."
msgstr "채찍을 맞을 때마다 로비아타님의 환희가 느껴졌어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_RewardPenance
#. Speaker = Abdirak
#. NodeID = 304bd072-3fd6-bb43-b722-43d890c01ade
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_RewardPenance:304bd072-3fd6-bb43-b722-43d890c01ade
msgctxt "ha7672307g80dfg4107ga3b8g723b23dd9321"
msgid "I am proud to have served you this penance."
msgstr "내가 너의 고행을 도와준 게 자랑스러울 정도야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_RewardPenance
#. Speaker = Abdirak
#. NodeID = 3b8401bb-73d9-9bbf-ba1d-a7021a1dc1ff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_RewardPenance:3b8401bb-73d9-9bbf-ba1d-a7021a1dc1ff
msgctxt "h65749661ge198g4089ga1feg6b04fa52ddec"
msgid "As did I, dear one."
msgstr "나도 그랬단다, 얘야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_RewardPenance
#. Speaker = Abdirak
#. NodeID = 3e1031f0-5dc5-ae8c-158f-22c9fbab3375
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_RewardPenance:3e1031f0-5dc5-ae8c-158f-22c9fbab3375
#, fuzzy
msgctxt "hdd9201c0g880fg4705ga53dgd3fb52ef75ac"
msgid ""
"To gain Loviatar's favour, every <i>single </i>strike should be met with an "
"honest cry of pain - or perhaps a touch of begging."
msgstr "로비아타님의 총애를 얻으려면, <i>한 번</i>의 타격이라도 정직한 고통의 외침, 혹은 애원하는 손길로 맞이해야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_RewardPenance
#. Speaker = Player
#. NodeID = 5dc7167b-4d23-0df4-b38b-0f1d853636a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_RewardPenance:5dc7167b-4d23-0df4-b38b-0f1d853636a3
msgctxt "hc042718bg0f1fg4eadgaadfgdbe905e0c5fe"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_RewardPenance
#. Speaker = Abdirak
#. NodeID = 67fdb5f8-560c-d67e-596e-f20f667c1dc5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_RewardPenance:67fdb5f8-560c-d67e-596e-f20f667c1dc5
msgctxt "hd4b51f07g7e21g474ag8efag3b5bbaaad3a5"
msgid "You're starting to sound like the goddess herself, dear one."
msgstr "마치 여신님 본인과 같은 말을 하기 시작하는군, 사랑스러운 이여."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_RewardPenance
#. Speaker = Abdirak
#. NodeID = 6fbd4947-664f-560c-0b92-5f51e31b21bb
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_PainPriest_State_ReactedToPenance = True
#.   Object:
#.     - GOB_PainPriest_Event_Reward(1) = True
#.   Quest:
#.     - HIDDEN_WLD_Boosters.GOB_PainPriest_Penanced(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_RewardPenance:6fbd4947-664f-560c-0b92-5f51e31b21bb
msgctxt "he681969dge587g4575g9ca4gd250178c2759"
msgid ""
"Loviatar herself found your performance... inspiring. She has deemed you "
"worthy of her blessing."
msgstr "로비아타님이 친히 너의 공연을 보시고... 감명 받으셨다. 그분은 네가 축복 받을 자격이 있다고 판단하셨어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_RewardPenance
#. Speaker = Abdirak
#. NodeID = 75e8d6a0-e994-8a45-63ce-97296e057a68
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_RewardPenance:75e8d6a0-e994-8a45-63ce-97296e057a68
msgctxt "h5492093dgf01dg4698g966bg9818dca06f53"
msgid "Interesting is an understatement, dear one."
msgstr "흥미롭다는 말로는 부족하지, 얘야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_RewardPenance
#. Speaker = Player
#. NodeID = 8d7a99e1-ce2f-bc73-60b0-4a2d9659ff3e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_PainPriest_Event_HarderTwice = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_RewardPenance:8d7a99e1-ce2f-bc73-60b0-4a2d9659ff3e
msgctxt "hd45c5dcbga759g4d68gbf90ge10764c349c2"
msgid "You could have hit me much harder."
msgstr "날 더 세게 때렸어야 했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_RewardPenance
#. Speaker = Player
#. NodeID = bb33b58c-be40-bc5b-ac41-5086d78c739d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_RewardPenance:bb33b58c-be40-bc5b-ac41-5086d78c739d
msgctxt "hcc797c5fg3b73g4e6cg9853g6512f15b8125"
msgid "It was an... interesting experience."
msgstr "참... 흥미로운 경험이었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_RewardPenance
#. Speaker = Abdirak
#. NodeID = cfe89faf-3353-4903-b2ff-30644b2fd50c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_RewardPenance:cfe89faf-3353-4903-b2ff-30644b2fd50c
msgctxt "hc5bc4d07gafc9g454cgaaf7gf14851b58eba"
msgid "And on a personal note, thank you. That was positively <i>divine. </i>"
msgstr "개인적으로도 고맙다. 정말 <i>신성했어. </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_RewardPenance
#. Speaker = Abdirak
#. NodeID = d51c4eb9-9a12-63aa-04bc-d25e2176185d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_RewardPenance:d51c4eb9-9a12-63aa-04bc-d25e2176185d
msgctxt "h294b3d60gcb2cg43e8ga5d0gba9b1d1fcc37"
msgid ""
"Nevertheless, thank you. And I pray you've learned from today's little... "
"lesson."
msgstr "그래도 감사하네. 그리고 네가 오늘의 작은... 교훈에서 많은 것을 배웠기를 빌지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_RewardPenance
#. Speaker = Abdirak
#. NodeID = d9420d36-9717-7dc6-7af0-fd148dcd162b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_PainPriest_Event_PickPiercing = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_RewardPenance:d9420d36-9717-7dc6-7af0-fd148dcd162b
msgctxt "hb904cfa9gf891g4af9g935bg231d675d6166"
msgid "I could feel Loviatar's pleasure with every slice of my dagger."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_RewardPenance
#. Speaker = Abdirak
#. NodeID = e748c2cc-d020-22f3-0c28-dd789977a6f2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_RewardPenance:e748c2cc-d020-22f3-0c28-dd789977a6f2
msgctxt "h3285aae3gf478g44c8g8a94g6c98816d50c7"
msgid "I know, dear one. That was my favourite part."
msgstr "나도 알아, 얘야. 그게 내가 가장 좋아하는 부분이었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_RewardPenance
#. Speaker = Abdirak
#. NodeID = e84e73da-b931-3d59-73dc-c142a8f2aeac
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_PainPriest_Event_SecondHitDone = True
#.      - GOB_PainPriest_Event_BadReaction = False
#.      - GOB_PainPriest_Event_FirstHitDone = True
#. SetFlags:
#.   Dialog:
#.     - GOB_PainPriest_State_WasPenitent(1) = True
#.     - GOB_PainPriest_State_Penitent(1) = False
#.     - GOB_PainPriest_State_CancelledPenitent(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_RewardPenance:e84e73da-b931-3d59-73dc-c142a8f2aeac
msgctxt "h77c7fcc2g9a0ag4bfega9f6g0a556a79bfc0"
msgid "Sweet child, you bore the pain like a true believer."
msgstr "감미로운 아이야, 너는 진정한 신자처럼 고통을 감내했구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_RewardPenance
#. Speaker = Player
#. NodeID = ff20f8e5-712a-0bce-813c-ff872f4d9c0d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_PainPriest_Event_MercyTwice = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_RewardPenance:ff20f8e5-712a-0bce-813c-ff872f4d9c0d
msgctxt "h4ccfd247ga95dg4c39ga758g96bb28dbdc52"
msgid "I asked you for mercy!"
msgstr "자비를 구했잖아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PriestsOfConqueringGod_SpottedHostilePlayer
#. Speaker = GROUP_WLD_Priests
#. NodeID = fdd44057-50d9-6b9b-6ab9-b975aafbbffd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PriestsOfConqueringGod_SpottedHostilePlayer:fdd44057-50d9-6b9b-6ab9-b975aafbbffd
msgctxt "h42d38c1ag34a8g4676g9d81g002b586a6c15"
msgid ""
"You! I remember you from the forest. You should <i>never </i>have come here."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_Escapee_Dead
#. Speaker = Player
#. NodeID = 185c457b-72ff-464e-bfc6-620f5a994be4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_Escapee_Dead:185c457b-72ff-464e-bfc6-620f5a994be4
msgctxt "hbd5615f0g876bg4b6bga1e8ge557b1769d89"
msgid "How did you get trapped in the tunnel?"
msgstr "어쩌다가 굴에 갇히게 된 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_Escapee_Dead
#. Speaker = Player
#. NodeID = 1aeb2442-1b8d-48d6-adf2-ba2149883795
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_Escapee_Dead:1aeb2442-1b8d-48d6-adf2-ba2149883795
msgctxt "hae51456dg9cecg4a7aga2bcgd6151c04351f"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_Escapee_Dead
#. Speaker = Dead Elf
#. NodeID = 51b266e6-671f-456f-b7c7-b1c61c2cd39f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_Escapee_Dead:51b266e6-671f-456f-b7c7-b1c61c2cd39f
msgctxt "h5899148ag904dg4764gaf65g8cbb090f8227"
msgid ""
"Digging... too quickly. Felt tunnel... collapsing. Kept going. Better dead "
"than... worg meat."
msgstr "너무... 빨리 팠어. 굴이 무너지는 걸... 느꼈어. 계속 들어갔어. 워그 먹이가 되느니... 죽는 게 나으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_Escapee_Dead
#. Speaker = Player
#. NodeID = 5b995cb2-78c2-4bff-8512-043440082686
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_Escapee_Dead:5b995cb2-78c2-4bff-8512-043440082686
msgctxt "ha09a269cgd906g4831ga032geba01ac98d73"
msgid "Were you the only prisoner here?"
msgstr "여기 갇힌 포로는 너뿐이었나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_Escapee_Dead
#. Speaker = Player
#. NodeID = 7ca62077-df7d-4850-be05-55e32e6a254e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_WolfPens_State_Swept = False
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_Escapee_Dead:7ca62077-df7d-4850-be05-55e32e6a254e
msgctxt "h8c91e7begde76g4eb6g8c95g53ccd6ec08f3"
msgid "There's a bear in one of the other cells. Where did it come from?"
msgstr "다른 감방에 곰이 갇혀 있던데. 어디서 온 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_Escapee_Dead
#. Speaker = Player
#. NodeID = 7e50775a-c87c-3e8e-eaba-4dad7f0d59eb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_PrisonEscape_NoticedHeart = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_Escapee_Dead:7e50775a-c87c-3e8e-eaba-4dad7f0d59eb
msgctxt "h2195700eg6229g4e77g8494g7b274462c613"
msgid "Why is there a heart on one of your shoes?"
msgstr "네 신발 중 한 쪽에 하트가 그려져 있던데, 왜지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_Escapee_Dead
#. Speaker = Dead Elf
#. NodeID = 8c5e9b7b-1a2f-a323-35b6-8e3db20581dd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_Escapee_Dead:8c5e9b7b-1a2f-a323-35b6-8e3db20581dd
msgctxt "h1210096dg400bg433dg96d5gd440a0102107"
msgid ""
"My son Galan... did it. If I ever missed him... could look down and... "
"remember him."
msgstr "내 아들 갈란이... 그렸어. 아들이 그리워지곤 하면... 신발을 내려다보고... 떠올릴 수 있었지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_Escapee_Dead
#. Speaker = Narrator
#. NodeID = 9a3d796a-2489-06b0-96d3-5f1f97b96ed7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_Escapee_Dead:9a3d796a-2489-06b0-96d3-5f1f97b96ed7
msgctxt "h65768b95ga788g45b8g9973ge4a02c9e1baa"
msgid "*The corpse does not stir. It will answer no more questions.*"
msgstr "*시체는 움직이지 않습니다. 더 이상 질문을 받지 않을 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_Escapee_Dead
#. Speaker = Player
#. NodeID = 9ecbda45-2743-49f0-9642-9f4483049004
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_Escapee_Dead:9ecbda45-2743-49f0-9642-9f4483049004
msgctxt "hda6806c6g7366g48a4g836dg97fb757246c4"
msgid "How did you end up here?"
msgstr "어쩌다 여기까지 오게 된 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_Escapee_Dead
#. Speaker = Dead Elf
#. NodeID = a70acb60-9150-4766-a52a-4bf98829c9d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_Escapee_Dead:a70acb60-9150-4766-a52a-4bf98829c9d8
msgctxt "h00594ea3g5efcg4431gabe5gf223b8a07fc6"
msgid "Taeglyn... carpenter. Father of... two."
msgstr "태글린... 목수. 두 아이의... 아버지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_Escapee_Dead
#. Speaker = Narrator
#. NodeID = b8c0dfb5-cf87-4118-b77c-f916196969ff
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_Escapee_Dead:b8c0dfb5-cf87-4118-b77c-f916196969ff
msgctxt "h292f0915g51dfg49d7ga14bgfe8b193b7eab"
msgid "*The corpse regards you lifelessly.*"
msgstr "*시체가 생기 없는 모습으로 당신을 맞이합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_Escapee_Dead
#. Speaker = Player
#. NodeID = bd71535a-3387-425e-8d30-da7695cdfe74
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_Escapee_Dead:bd71535a-3387-425e-8d30-da7695cdfe74
msgctxt "h939582a4g83bcg40bcg9c94g7742b396c3c3"
msgid "Who are you?"
msgstr "너는 누구지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_Escapee_Dead
#. Speaker = Dead Elf
#. NodeID = c5867168-c6cc-4f7c-850b-5c2ba8281047
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_Escapee_Dead:c5867168-c6cc-4f7c-850b-5c2ba8281047
msgctxt "h5178faacgd11cg45aag9eaeg13e1a6b5db30"
msgid "Heading to... Baldur's Gate. Didn't hear... goblin patrol."
msgstr "발더스 게이트로... 향하고 있었어. 고블린 순찰대의 소리를... 못 들었지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_Escapee_Dead
#. Speaker = Narrator
#. NodeID = c973ce48-5867-48c2-aa96-50d527fdabc1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_Escapee_Dead:c973ce48-5867-48c2-aa96-50d527fdabc1
msgctxt "h310f8da7g114cg4506gb30cg81ae183f87f1"
msgid "*The spell's power wanes. You can ask no more questions.*"
msgstr "*주문의 힘이 약해집니다. 더 이상 질문을 할 수 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_Escapee_Dead
#. Speaker = Dead Elf
#. NodeID = d820ea9c-a6e7-48c0-8234-f0e0e8c80e3d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_Escapee_Dead:d820ea9c-a6e7-48c0-8234-f0e0e8c80e3d
msgctxt "hf89f869cg22a1g4bacg9a63g03b8502e6be0"
msgid "Goblins took... my friends. Cut them up... for the worgs. For meat."
msgstr "내 친구들을... 고블린이 데려갔어. 잘라서... 워그 먹이로 줬어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_Escapee_Dead
#. Speaker = Dead Elf
#. NodeID = f706b645-8a5b-4292-80ad-5138fbc17ea5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_Escapee_Dead:f706b645-8a5b-4292-80ad-5138fbc17ea5
msgctxt "hcf688534gc518g4ce2g946ag3139da5c8961"
msgid "Not... bear."
msgstr "곰이... 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_Guard
#. Speaker = Warrior Plig
#. NodeID = 8c91ec56-cfec-4620-a343-80cbb559e477
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_PrisonEscape_Guard_Hasmet(1) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_PrisonEscape_Guard_Hasmet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_Guard:8c91ec56-cfec-4620-a343-80cbb559e477
msgctxt "h19287b55gdc7eg4426ga150g95920950d7ce"
msgid ""
"Steal somethin' or act the bollocks, will ya? I'm itching to throw someone "
"in the brig. It'll be fun. I <i>promise.</i>"
msgstr ""
"뭔가를 훔치거나 헤집어 놓기만 해봐, 응? 아무나 영창에 쳐넣고 싶어서 근질거리던 참이니까. 재밌을 거야. <i>약속하지.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_Guard
#. Speaker = Warrior Plig
#. NodeID = eb338590-78e3-06b0-2be6-31051daac563
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_PrisonEscape_Guard_Hasmet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_Guard:eb338590-78e3-06b0-2be6-31051daac563
msgctxt "hcc2a5957g0d24g49b7gaa3cg8b9fa2b51e45"
msgid ""
"Either 'cause some trouble or bugger off. Ain't got time for <i>boring.</i>"
msgstr "문제를 일으킬 거 아니면 꺼져. <i>지루한</i> 일에 쓸 시간 없다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_PAD_TunnelBlocked
#. Speaker = Player
#. NodeID = a2554fa0-4fb3-40ca-acc5-3262b7def704
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_PAD_TunnelBlocked:a2554fa0-4fb3-40ca-acc5-3262b7def704
msgctxt "hc991ec91g6c5ag462bgab72g60c5ffa629db"
msgid "The debris didn't shift - perhaps a little more oomph is required."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PrisonEscape_PAD_TunnelBlocked
#. Speaker = Player
#. NodeID = a2554fa0-4fb3-40ca-acc5-3262b7def704
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
