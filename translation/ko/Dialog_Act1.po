#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice:d5b8c62b-fd7c-8ff8-4729-58bcc23d4428
msgctxt "hc0449ad5gb4cdg4255g8ba4g7efd5d0764b8"
msgid "<i>Soothe the spiders with a calming lullaby.</i>"
msgstr "<i>차분한 자장가로 거미들을 달랜다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice
#. Speaker = Narrator
#. NodeID = e34a12ac-88a3-ccde-70a7-d53a5f86f0f5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_Outpost_State_BagOut = False
#. SetFlags:
