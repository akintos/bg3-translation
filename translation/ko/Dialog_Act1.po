msgctxt "h0a437e0cg9621g4e3fga07eg4ed21bd78ff3"
msgid "What are you doing?"
msgstr "무슨 짓이야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_AD_GithBoy_AssaultReaction
#. Speaker = Youth Varrl
#. NodeID = 5dcfd8a6-036a-4293-90e3-730de3e2ba44
