#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_KethericOrdersRead_PAD:377ef671-78e7-49a5-a522-86ad27d8f71a
msgctxt "hbafaebe1gdb67g4c7bg809ag5b6ff3ab88fd"
msgid "It's settled, then. I must make my way to Moonrise."
msgstr "그럼 결정됐어. 난 문라이즈로 나아가야만 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_KethericOrdersRead_PAD
#. Speaker = Player
#. NodeID = 7f22d09f-e260-4ebc-b71f-65d3880f94ac
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
