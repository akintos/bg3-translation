#.      - REALLY_GITHYANKI(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03:f9767938-dddc-52a4-6b6c-e9f3a903afc0
msgctxt "h94087d4dgc0d3g4c9cg911bg690124f885a1"
msgid "Here's my offer: give me your slave, or become mine."
msgstr "이게 내 제안이야: 당신 노예를 내놓던가, 당신이 내 노예가 되던가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03
#. Speaker = Player
#. NodeID = fff866b7-8c3d-6cc9-fa9d-be1b51c6759b
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03:fff866b7-8c3d-6cc9-fa9d-be1b51c6759b
msgctxt "h2786ad55g9c25g44b2ga997g7ad2acabfc6f"
msgid ""
"If this artist were to <i>tragically</i> expire, his portfolio would become "
"finite - therefore <i>priceless</i>."
msgstr "이 예술가가 <i>안타깝게도 </i>세상을 떠난다면, 그의 작품집도 유한해지겠지. 자연히 <i>가격도 오를 테고</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03_AD_ArtCritics
#. Speaker = Brem
#. NodeID = afc1379f-35ba-19cd-392c-f6ec83b0b422
