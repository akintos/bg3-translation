#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_AD_DrowDebrief:0d50bb1f-7ab0-b500-83e2-3a97ae371f75
msgctxt "hd2b7eee9gd375g4c2dgb891g061ccc1eae66"
msgid "They hid their gate with ivy."
msgstr "덩굴로 관문을 가렸답니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_AD_DrowDebrief
#. Speaker = Nightwarden Minthara
#. NodeID = 3414b9f6-c52b-0215-ff77-69e579ce6400
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_AD_DrowDebrief:3414b9f6-c52b-0215-ff77-69e579ce6400
msgctxt "hfae46003gabc9g4ae4g8a12gd2437d6e570d"
msgid "Get ready. We'll leave before they can flee."
msgstr "준비해라. 놈들이 도망치기 전에 이곳을 떠나야 한다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_AD_DrowDebrief
#. Speaker = Torturer Spike
#. NodeID = 5a5d09da-3d71-32af-e53e-982ba47079e3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_Torturers_State_KnowDen = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_AD_DrowDebrief:5a5d09da-3d71-32af-e53e-982ba47079e3
msgctxt "hbbaad748ge7cfg4593g9cd7g0c6a4fb1a7b1"
msgid "We did it, Miss True Soul! We know where those nigglin' thieves are!"
msgstr "우리가 해냈어요, 참된 영혼 아가씨! 저 멍청한 도둑놈들이 어디 있는지 알아냈다고요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_AD_DrowDebrief
#. Speaker = Nightwarden Minthara
#. NodeID = 6c756ba5-c60a-55fb-0ae0-4f4e685eda93
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_AD_DrowDebrief:6c756ba5-c60a-55fb-0ae0-4f4e685eda93
msgctxt "h07a4bc45gee53g4be1gbc35g71584fc6ee5e"
msgid "Good."
msgstr "좋아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_AD_DrowDebrief
#. Speaker = Torturer Spike
#. NodeID = ad4749e8-0d9c-a7a7-2564-a1cf04e619b0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_AD_DrowDebrief:ad4749e8-0d9c-a7a7-2564-a1cf04e619b0
msgctxt "h276cd02fg66e2g4c0fgb2ddg0a81e8a23381"
msgid "They got a grove to the east. Past the ruins and over the bridge."
msgstr "동쪽 숲에 있답니다. 폐허를 지나 다리 건너편 말이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_AD_WatchingPainPriest
#. Speaker = Torturer Spike
#. NodeID = 388f7e9a-643b-2f2e-f58d-e213d6a65f9f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - d555f7c6-db40-e6e6-dc31-06953fa410f1_A = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_AD_WatchingPainPriest:388f7e9a-643b-2f2e-f58d-e213d6a65f9f
msgctxt "h9d67e3degba4dg4133gaa1eg633f025f35af"
msgid "What's he doin'? It's just the same thing over an' over."
msgstr "뭘 하는 거지? 아까부터 계속 똑같은 짓거리잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_AD_WatchingPainPriest
#. Speaker = Torturer Spike
#. NodeID = 6c9fe4ac-5cfa-8eda-a9a2-4c1b8e022e65
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - d555f7c6-db40-e6e6-dc31-06953fa410f1_A = True
#. SetFlags:
#.   Local:
#.     - d555f7c6-db40-e6e6-dc31-06953fa410f1_B = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_AD_WatchingPainPriest:6c9fe4ac-5cfa-8eda-a9a2-4c1b8e022e65
msgctxt "haab213adgd541g447cgbd3agb69b375e9b25"
msgid "C'mon! You can do better than that!"
msgstr "어서! 더 잘할 수 있잖아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_AD_WatchingPainPriest
#. Speaker = Torturer Spike
#. NodeID = b69546c3-65cb-b20f-358c-48aaf1c0d0ce
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - d555f7c6-db40-e6e6-dc31-06953fa410f1_C = True
#. SetFlags:
#.   Local:
#.     - d555f7c6-db40-e6e6-dc31-06953fa410f1_C = False
#.     - d555f7c6-db40-e6e6-dc31-06953fa410f1_A = False
#.     - d555f7c6-db40-e6e6-dc31-06953fa410f1_B = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_AD_WatchingPainPriest:b69546c3-65cb-b20f-358c-48aaf1c0d0ce
msgctxt "h5eb832c9g481dg41fbg91b7g5d1d0c38c307"
msgid "You got candles all 'round ya! Use 'em!"
msgstr "사방에 널린 촛불을 쓰란 말야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_AD_WatchingPainPriest
#. Speaker = Lookout Grush
#. NodeID = cda57e89-8bba-fa3e-8cbc-b166c1127b73
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_PainPriest_State_Penitent(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_AD_WatchingPainPriest:cda57e89-8bba-fa3e-8cbc-b166c1127b73
msgctxt "h80d5dab7gd2bbg4ef8ga88dg9685e0177309"
msgid "Oh yes! Everyone howls when they're on fire!"
msgstr "오 그거야! 불붙은 놈들은 하나같이 악을 쓰더라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_AD_WatchingPainPriest
#. Speaker = Torturer Spike
#. NodeID = eb37584e-e7ba-1543-ad8e-961efa445d1a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - d555f7c6-db40-e6e6-dc31-06953fa410f1_B = True
#. SetFlags:
#.   Local:
#.     - d555f7c6-db40-e6e6-dc31-06953fa410f1_C = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_AD_WatchingPainPriest:eb37584e-e7ba-1543-ad8e-961efa445d1a
msgctxt "h7b0a1eafgad91g417dga104g2e90e9b9509f"
msgid ""
"Didn't he call himself a master? Would've thought he'd be more creative."
msgstr "자신을 마스터라 칭하지 않았던가? 좀 더 창의적인 방법을 쓸 줄 알았건만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_MoveOut_AD
#. Speaker = Torturer Spike
#. NodeID = 0e412675-8738-bcb2-1a3a-31f620414768
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_MoveOut_AD:0e412675-8738-bcb2-1a3a-31f620414768
msgctxt "hee946559gc810g4234g932bg537683f09a16"
msgid "C'mon. I wanna watch that weird priest next door."
msgstr "어서. 옆 방의 그 이상한 사제나 구경하러 가자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_MoveOut_AD
#. Speaker = Torturer Spike
#. NodeID = 101fb158-7c7f-c787-9373-4564d9cd3a05
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_MoveOut_AD:101fb158-7c7f-c787-9373-4564d9cd3a05
msgctxt "hc4899b02g0798g429dg84f4gbdf9568d82ac"
msgid "Oh, forget about 'im. There'll be more of them soon."
msgstr "오, 놈은 잊어버려. 금방 더 많은 놈들이 올 테니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_MoveOut_AD
#. Speaker = Torturer Spike
#. NodeID = 2225fe34-79e5-2021-64bb-92ad56fdfd59
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_MoveOut_AD:2225fe34-79e5-2021-64bb-92ad56fdfd59
msgctxt "hf8e7a888ge267g4df0gbab5gbee6303fe723"
msgid "C'mon. I bet we'll even get some of the spoils."
msgstr "가자. 잘하면 전리품 좀 챙길 수 있을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_MoveOut_AD
#. Speaker = Lookout Grush
#. NodeID = 2663210c-0b75-fbd8-5a26-ce088e3be5e4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_MoveOut_AD:2663210c-0b75-fbd8-5a26-ce088e3be5e4
msgctxt "hc6c68d87g7784g4b96gaba6g5cc6b5b3b743"
msgid "But... the prisoner -"
msgstr "하지만... 저 죄수놈 -"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_MoveOut_AD
#. Speaker = Torturer Spike
#. NodeID = 695eb21c-2f91-01df-21f3-55b6f5d9e701
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Torturers_State_KnowDen = False
#.      - GOB_Torturers_State_TorturedEnough = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_MoveOut_AD:695eb21c-2f91-01df-21f3-55b6f5d9e701
msgctxt "h0db0650fg5ec3g4315gb9b2gadd8284fb33d"
msgid "O-ho, this is good."
msgstr "오호, 이거 좋은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_MoveOut_AD
#. Speaker = Torturer Spike
#. NodeID = 696cc22b-813c-7971-0d25-1b66707921de
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_MoveOut_AD:696cc22b-813c-7971-0d25-1b66707921de
msgctxt "hded08933g070bg4a1eg8ca5gd217223d674e"
msgid "Sounded like he was beatin' somethin' up. Yeh, beatin' it <i>good</i>."
msgstr "뭔가를 때리는 소리가 나던데. 그래, 뭔가를 <i>흠씬</i> 패는 소리가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_Rat_AD
#. Speaker = Rat
#. NodeID = 1df68b6f-2287-79af-df20-89d80761f7dd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_Rat_AD:1df68b6f-2287-79af-df20-89d80761f7dd
msgctxt "hed870b37g9447g40afg9a34g202552985d40"
msgid "*Squeak.*"
msgstr "*찍찍.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_Torture_AD
#. Speaker = Torturer Spike
#. NodeID = 06d95d7f-2db6-bbe3-a8a1-bd0600a48c11
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_Torture_AD:06d95d7f-2db6-bbe3-a8a1-bd0600a48c11
msgctxt "h05adb7e2gbcafg448fg845agb85da3becc7f"
msgid "I'll set my rats on ya. My cute, little girls."
msgstr "네놈에게 쥐를 풀 거야. 우리 귀엽고 사랑스러운 아가씨들."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_Torture_AD
#. Speaker = Torturer Spike
#. NodeID = 265afe0a-9c52-8e14-a1e7-24319f5c2502
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_Torture_AD:265afe0a-9c52-8e14-a1e7-24319f5c2502
msgctxt "hbdfd0194g83d7g442cgbe25g33e0aabe7846"
msgid "They'll eat through yer belly button..."
msgstr "걔들은 네놈 배꼽부터 파먹겠지..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_Torture_AD
#. Speaker = Torturer Spike
#. NodeID = 27f56539-57bb-3368-519b-9f0508716ab1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_Torture_AD:27f56539-57bb-3368-519b-9f0508716ab1
msgctxt "h19af79cag0758g430eg8da6ge9c3d5cdfd71"
msgid "MAKE IT AGONISING."
msgstr "가능한 고통스럽게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_Torture_AD
#. Speaker = Torturer Spike
#. NodeID = 3b887637-1a70-7cfa-5a0b-e709655ef8e0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Torturers_State_KnowDen = True
#.   Local:
#.      - e06f2bf8-8151-82fa-8edc-5b34ab28eac1_Said1stBranch = False
#. SetFlags:
#.   Local:
#.     - e06f2bf8-8151-82fa-8edc-5b34ab28eac1_Said1stBranch = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_Torture_AD:3b887637-1a70-7cfa-5a0b-e709655ef8e0
msgctxt "heeda5946g3cf2g49a0ga590gaec327668ae4"
msgid "C'mon, you know what I want."
msgstr "자, 내가 뭘 원하는지 알잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_Torture_AD
#. Speaker = Torturer Spike
#. NodeID = 3df9a7a5-adeb-288f-6160-d7f1431a2bdd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_Torture_AD:3df9a7a5-adeb-288f-6160-d7f1431a2bdd
msgctxt "h984a778dg29ffg4434g8815g3047ecd4f377"
msgid "... right down to your guts. Munch, munch!"
msgstr "... 내장까지 바로 내려가는 거지. 우적우적, 우적우적!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_Torture_AD
#. Speaker = Torturer Spike
#. NodeID = 4b816fc9-a9c1-6c20-5dd5-bd5c6a226421
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Torturers_State_KnowDen = True
#.   Local:
#.      - e06f2bf8-8151-82fa-8edc-5b34ab28eac1_Said1stBranch = True
#. SetFlags:
#.   Local:
#.     - e06f2bf8-8151-82fa-8edc-5b34ab28eac1_Said1stBranch = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_Torture_AD:4b816fc9-a9c1-6c20-5dd5-bd5c6a226421
msgctxt "hcc0cbe8fg393fg4fc4ga54eg10888ffa8560"
msgid "Ya learned yer lesson yet?"
msgstr "아직도 말귀를 못 알아먹나 보군?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_Torture_AD
#. Speaker = Torturer Spike
#. NodeID = 54bcaa76-0bb6-04cd-edff-ffc52c6d3368
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Torturers_State_KnowDen = False
#.   Local:
#.      - e06f2bf8-8151-82fa-8edc-5b34ab28eac1_Said1stBranch = True
#. SetFlags:
#.   Local:
#.     - e06f2bf8-8151-82fa-8edc-5b34ab28eac1_Said1stBranch = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_Torture_AD:54bcaa76-0bb6-04cd-edff-ffc52c6d3368
msgctxt "hed5e28b0g1ed5g4534g9ee9gb87fd122f042"
msgid "You'll tell me, right?"
msgstr "금방 불 거야, 맞지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_Torture_AD
#. Speaker = Lookout Grush
#. NodeID = 623e0ef9-8c9d-cb02-7a2c-379d2dd689fa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_Torture_AD:623e0ef9-8c9d-cb02-7a2c-379d2dd689fa
msgctxt "h8d9d92e5g556fg4708g9702ga2de6bd05256"
msgid "Can I rip off 'is ears? Tear out his eyes?"
msgstr "놈의 귀때기를 찢어도 될깝쇼? 눈을 파 내도 될깝쇼?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_Torture_AD
#. Speaker = Torturer Spike
#. NodeID = 8e4e34e3-a260-ba83-7bad-a97a97971b52
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_Torture_AD:8e4e34e3-a260-ba83-7bad-a97a97971b52
msgctxt "h6ab121aegdab4g41c7gacafgdac72eb4a37b"
msgid "Later. I gotta take it slow."
msgstr "이따가. 천천히 즐기고 싶거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_Torture_AD
#. Speaker = Torturer Spike
#. NodeID = 91589b89-0d1e-3f93-5353-8230d5eb58a5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Torturers_State_KnowDen = False
#.   Local:
#.      - e06f2bf8-8151-82fa-8edc-5b34ab28eac1_Said1stBranch = False
#. SetFlags:
#.   Local:
#.     - e06f2bf8-8151-82fa-8edc-5b34ab28eac1_Said1stBranch = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_Torture_AD:91589b89-0d1e-3f93-5353-8230d5eb58a5
msgctxt "h9bf14780ga275g4fc6gb985gf5dfbd977057"
msgid "Tell me where yer hideout is. Ain't so 'ard, is it?"
msgstr "늬들 은신처가 어딘지 불어. 힘든 일도 아니잖아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_Torture_AD
#. Speaker = Torturer Spike
#. NodeID = 95915a2f-0820-0543-0e9f-984d6aca4a38
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_Torture_AD:95915a2f-0820-0543-0e9f-984d6aca4a38
msgctxt "h307ac1abgf73dg4f36g84d7ga43fcc959cc5"
msgid "JUST TELL ME!"
msgstr "그냥 말하라고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_Torture_AD
#. Speaker = Torturer Spike
#. NodeID = b34eb145-dd3e-bbaf-7c45-8f928f12d9e5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_Torture_AD:b34eb145-dd3e-bbaf-7c45-8f928f12d9e5
msgctxt "h80a73386gd799g41dcgbb23gc56303c50b7d"
msgid "Some good SCREAMS."
msgstr "듣기 좋은 비명 소리지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_Torture_AD
#. Speaker = Torturer Spike
#. NodeID = edfa2673-30a2-087a-7d47-4974b44734b7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Torturers_Torture_AD:edfa2673-30a2-087a-7d47-4974b44734b7
msgctxt "hde089231g3941g4681g937dg97109754e3a5"
msgid "Or you'll SCREAM."
msgstr "아님 비명을 지르든가."

