#.      - GITHYANKI(3) = False
#.      - DUERGARDWARF(3) = False
#.      - DROWELF(3) = False
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene:9bbb01d7-d23f-bf04-d0ea-d149a6d9be9b
msgctxt "h6d340fc5g4608g4989g8558gc695078e2330"
msgid "You're coming with me, 'fore... Oh! Looks like I've got company."
msgstr "넌 나랑 간다, 이... 아! 손님이 나타난 모양이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene
#. Speaker = Player
#. NodeID = 9bbf1769-161e-5977-0288-92203627cf30
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
