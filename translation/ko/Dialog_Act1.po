msgctxt "hd10d3df0ga0d8g41cfg94f0g49b793753bbb"
msgid "Heh. No harm gettin' the buggers off their arses, eh?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_AlarmUsedReaction
#. Speaker = Sentinel Olak
#. NodeID = 07552412-cc2e-1278-bc03-30ee03152519
