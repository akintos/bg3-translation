msgctxt "hc2cd1caag899bg4f31ga720g1208f455008e"
msgid "*You see the shadowed outline of a figure.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_004
#. Speaker = Narrator
#. NodeID = 9979f89d-a569-9786-0acb-d67b9cebb22e
