msgctxt "h3434e037g0239g4ac3gb3a9g7313d658af4a"
msgid "It's lovely..."
msgstr "너무 아름다운 소리야..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerCharmed
#. Speaker = Player
