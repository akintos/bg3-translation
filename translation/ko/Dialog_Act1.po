#.     - CRA_DeadFisherman5_KnowsHell(1) = True
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_DeadFisherman5_Dead:d749ca34-9e28-7ad5-4dcd-2b8c1cf3b737
msgctxt "haa6a338cg8c29g470ag8991g6b7670051ed0"
msgid "Elturel? Are we close to the city?"
msgstr "엘투렐? 가까이에 도시가 있는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_DeadFisherman5_Dead
#. Speaker = Narrator
#. NodeID = fa101b5d-249a-7f10-131d-103fa61cad28
