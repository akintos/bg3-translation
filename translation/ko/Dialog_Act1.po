msgctxt "hd3737e9cg088fg480bgb070gd72760ebd612"
msgid "Nowhere the faithless can hide. It's the Absolute's world now!"
msgstr "불신자들이 숨어들 곳은 없다. 절대자님의 세상이 왔어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Bravado_Goblin_003
