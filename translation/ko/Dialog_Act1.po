#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_DragonShadow:2420a414-311f-a483-b89d-d618377667e1
msgctxt "hf556c67fg3170g44fcg8c54g0865ed4feead"
msgid ""
"The size of that thing. Looks so much bigger when it's flying above you..."
msgstr "저 크기 좀 봐. 위에서 날아다니면 훨씬 더 커 보인다니까..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_DragonShadow
#. Speaker = Player
#. NodeID = 2420a414-311f-a483-b89d-d618377667e1
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Object:
#.      - PLA_GithChokepoint_State_FailedFrightenedSV(2) = True
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_DragonShadow:2420a414-311f-a483-b89d-d618377667e1
msgctxt "hd17ed357gda0eg40ecga6beg9b0b61a572f5"
msgid "Let's hope we don't catch its eye."
msgstr "시선을 끌지 않기를 바라자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_DragonShadow
#. Speaker = Player
#. NodeID = 2420a414-311f-a483-b89d-d618377667e1
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Object:
#.      - PLA_GithChokepoint_State_FailedFrightenedSV(2) = True
#. TagRule: REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_DragonShadow:2420a414-311f-a483-b89d-d618377667e1
msgctxt "haa394ab3ge3bcg4981gbfd7g78868cc335c5"
msgid "Beautiful. And terrifying."
msgstr "아름다워. 동시에 공포스럽기도 하고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_DragonShadow
#. Speaker = Player
#. NodeID = 2420a414-311f-a483-b89d-d618377667e1
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Object:
#.      - PLA_GithChokepoint_State_FailedFrightenedSV(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_DragonShadow:2420a414-311f-a483-b89d-d618377667e1
msgctxt "h3e344776ge828g45ccg9896g98b6d1209f45"
msgid "Hope it doesn't see us."
msgstr "우릴 보지 않기를 바라자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_DragonShadow
