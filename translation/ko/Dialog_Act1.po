msgctxt "h95d1e658gb392g4f0agae2eg837acf8e1d2e"
msgid "Shit, this doesn't seem good."
msgstr "젠장, 이건 좋지 않아 보여."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_ControlledByMask
#. Speaker = Karlach
#. NodeID = 63f791be-4f30-401d-a51a-f82168566da5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom2(4) = True
#.   Tag:
#.      - REALLY_KARLACH(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_ControlledByMask:63f791be-4f30-401d-a51a-f82168566da5
msgctxt "h8049f434gc9d0g4e33g8891g85ababe8a1bb"
msgid "It's the mask! Get that thing off your face!"
msgstr "가면이다! 얼굴에서 당장 치워!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_ControlledByMask
#. Speaker = Player
#. NodeID = 6a847aa6-1c10-715d-8507-de1fa822f186
