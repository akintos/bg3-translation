#. NodeID = 51f67837-820e-112a-1a43-a0b3269ec48c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_MemoryCrystal:51f67837-820e-112a-1a43-a0b3269ec48c
msgctxt "h8026b83cg2c66g4d2agaecdg54320ee87740"
msgid "*A dull crystal, glowing only faintly.*"
msgstr "*희미하게 빛나는 칙칙한 수정입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_MemoryCrystal
#. Speaker = Narrator
#. NodeID = 5dfb5cda-3ba3-360b-4ed5-4b2f4ae2ec46
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_PetrifiedDrow_State_LearnedForgeFromMap = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_MemoryCrystal:5dfb5cda-3ba3-360b-4ed5-4b2f4ae2ec46
msgctxt "hcb7fd412g636fg4e38ga38bg68a08716add5"
msgid ""
"*The crystal's glow swells, drawing you into its depths. You are transported "
"- somewhere deep, loud, and hot as the Hells themselves.*"
msgstr ""
"*수정의 빛이 부풀어 오르며 당신을 수정 속으로 끌어당깁니다. 당신은 수정에 의해 마치 지옥처럼 깊고 시끄럽고 뜨거운 곳으로 "
"이동했습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_MemoryCrystal
#. Speaker = Player
#. NodeID = 689729a6-05d6-ba9b-9e09-26a7a5670c74
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - UND_PetrifiedDrow_Knows_MemoryCrystal = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_MemoryCrystal:689729a6-05d6-ba9b-9e09-26a7a5670c74
msgctxt "h6d9fa3f5gee6fg400dga01fgfc220db9b849"
msgid "Try to determine its function."
msgstr "작동 방법을 알아본다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_MemoryCrystal
#. Speaker = Narrator
#. NodeID = 75c42c52-697c-53be-feef-48242c4c296e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - UND_PetrifiedDrow_Event_MemoryCrystalRejected(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_MemoryCrystal:75c42c52-697c-53be-feef-48242c4c296e
msgctxt "h60f1a625g514dg40fbg85efga33321934bf7"
msgid "*Whoever you are, you are not worthy of the secrets within.*"
msgstr "*당신이 누구이든 간에, 이 속에 담긴 비밀을 알아낼 자격은 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_MemoryCrystal
#. Speaker = Player
#. NodeID = 7b4468f6-bd05-6364-f5df-f759f50b3ae2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_MemoryCrystal:7b4468f6-bd05-6364-f5df-f759f50b3ae2
msgctxt "h5e772235g76ebg4636g9eccgb68fdde013a3"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_MemoryCrystal
#. Speaker = Narrator
#. NodeID = 7d93b36b-9789-c2bd-d7c8-92ed2ce881c2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_MemoryCrystal:7d93b36b-9789-c2bd-d7c8-92ed2ce881c2
msgctxt "h8838e0cegfefag4936ga11fg36c70071b8b8"
msgid ""
"*The crystal <i>probes</i> back - and none too gently. You're left with a "
"sudden and sinking feeling of inadequacy.*"
msgstr ""
"*수정이 <i>역으로</i> 찔러옵니다. 상당히 거친 느낌입니다. 이제 그저 무능아가 된 듯한 우울한 느낌만이 느껴질 뿐입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_MemoryCrystal
#. Speaker = Player
#. NodeID = 80350c12-2eea-2b4c-2b37-bb83daedf8ef
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_FurnaceSearch_State_ReadMap = False
#.      - UND_PetrifiedDrow_Knows_PassPhrase = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_MemoryCrystal:80350c12-2eea-2b4c-2b37-bb83daedf8ef
msgctxt "hb6fb4495gd2fbg4a75gae9fga6ee5a8875dd"
msgid "<i>Speak the pass-phrase.</i>"
msgstr "<i>통과 구호를 읊는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_MemoryCrystal
#. Speaker = Narrator
#. NodeID = 85b2ae6a-9aae-6668-5884-bf80f052c5fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_MemoryCrystal:85b2ae6a-9aae-6668-5884-bf80f052c5fd
msgctxt "h4dc30d40g064ag48fdg8485gbf30fb45066c"
msgid "*Yours is not the mind it was expecting.*"
msgstr "*당신은 수정이 기대했던 정신이 아닙니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_MemoryCrystal
#. Speaker = Narrator
#. NodeID = 92c2b936-0dcd-ac10-d705-d95fdf51d0df
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_MemoryCrystal:92c2b936-0dcd-ac10-d705-d95fdf51d0df
msgctxt "h71d919fbg3c10g46daga2b6g47129535acbd"
msgid ""
"*An echoing clang and you're back to yourself - left only with a firm sense "
"of a place. A grand forge.*"
msgstr "*메아리치는 소리가 들리더니, 정신이 듭니다. 그리곤 기억 속에 한 장소의 강렬한 인상이 남아 있습니다. 거대한 대장간입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_MemoryCrystal
#. Speaker = Narrator
#. NodeID = 9a9fd47b-2033-dd57-fafd-fc8f97a5d1f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_MemoryCrystal:9a9fd47b-2033-dd57-fafd-fc8f97a5d1f0
#, fuzzy
msgctxt "h7ae5b7ecg01d5g4710gb9c8gfd3712e820e5"
msgid ""
"*You rack your brains but it is - for all intents and purposes - a "
"particularly pretty rock.*"
msgstr "*의도와 목적을 알아내려 머리를 쥐어짜 보지만, 그저 예쁜 돌로밖에 보이지 않습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_MemoryCrystal
#. Speaker = Player
#. NodeID = 9ad32592-7d91-2c36-6b09-38daf0d4a1e1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_MemoryCrystal:9ad32592-7d91-2c36-6b09-38daf0d4a1e1
msgctxt "ha1a8a931ga72bg447ag9adbg7dfce4792225"
msgid "<i>Focus on the glow.</i>"
msgstr "<i>광채에 집중한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_MemoryCrystal
#. Speaker = Narrator
#. NodeID = c4118605-ec96-3595-ce23-7fdffe354edb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_MemoryCrystal:c4118605-ec96-3595-ce23-7fdffe354edb
msgctxt "h38fba429g1834g41b2g840fg89f294238df7"
msgid ""
"*Within the Underdark's bowels, beyond an ancient stronghold, hovers a giant "
"hammer, waiting to fall.*"
msgstr "*언더다크 깊은 곳, 고대의 요새 너머에 거대한 망치가 떨어지기를 기다리며 허공에 떠 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_MemoryCrystal
#. Speaker = Narrator
#. NodeID = cd08c282-4455-bcf8-67b2-9610ad0f2985
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_PetrifiedDrow_Knows_MemoryCrystal = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_MemoryCrystal:cd08c282-4455-bcf8-67b2-9610ad0f2985
msgctxt "hc58724ccgfff3g4424ga410g74a8c01a916d"
msgid ""
"*The crystal shines only faintly. A memory shard, the wizard had called it.*"
msgstr "*수정은 희미하게 빛날 뿐입니다. 그 위저드는 기억 조각이라고 불렀습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_MemoryCrystal
#. Speaker = Narrator
#. NodeID = efb57a8e-76bb-cd32-affe-88f401664ac5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_PetrifiedDrow_Knows_MemoryCrystal = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_MemoryCrystal:efb57a8e-76bb-cd32-affe-88f401664ac5
msgctxt "h2347b8f5gc175g42bag9c0agf521a82e1be3"
msgid ""
"*You heard its like described before - a memory shard, used to store brief "
"mental impressions from the user's mind.*"
msgstr "*당신이 아는 바에 의하면, 기억 파편은 사용자의 정신에 떠오른 짧은 인상을 저장하는 데 이용됩니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_MemoryCrystal
#. Speaker = Player
#. NodeID = f3198812-739f-4b48-b22f-787ab35abd0b
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - UND_PetrifiedDrow_Knows_MemoryCrystal = True
#.      - UND_FurnaceSearch_State_ReadMap = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_MemoryCrystal:f3198812-739f-4b48-b22f-787ab35abd0b
msgctxt "h7ba75a75gb227g424egb1ebgbb30913cc0af"
msgid "<i>Gently probe the thoughts within.</i>"
msgstr "<i>속에 담긴 기억을 조심스레 찔러본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = 00cfe9d4-bdbb-a75a-0492-00191ee11408
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_PetrifiedDrow_State_HasMap(0) = True
#. SetFlags:
#.   Global:
#.     - UND_PetrifiedDrow_Wizard_Event_GaveCrystal = True
#.   Object:
#.     - UND_PetrifiedDrow_Event_GiveMap(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:00cfe9d4-bdbb-a75a-0492-00191ee11408
msgctxt "he76d2df2g6b14g41deg91dcg4c982477395e"
msgid ""
"Forgive me... <i>mistress. </i>I would of course be honoured to pass my "
"research onto you."
msgstr "용서하십시오... <i>아가씨. </i>물론 제 연구 결과를 당신께 넘기는 것을 영광으로 알겠습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Player
#. NodeID = 057c83b4-b565-83b9-83ff-6452d6bcb405
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:057c83b4-b565-83b9-83ff-6452d6bcb405
msgctxt "h99f4c3d1g7e22g4ef9g85a7g3de3b7f76e07"
msgid "Pretty. I'll take it."
msgstr "예쁘네. 내가 가져가겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Player
#. NodeID = 086bccfa-c73c-0b15-9626-5948da155e66
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_FurnaceSearch_Knows_XargrimSummonedSpectator = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:086bccfa-c73c-0b15-9626-5948da155e66
msgctxt "h6f8ef2c5ge9bbg4d8fgbbbcgd949e17a0908"
msgid "Ah, you must be the one Xargrim battled."
msgstr "아, 당신이 자그림과 경쟁하던 이로군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Player
#. NodeID = 09164ec8-9ec2-ca82-2cd5-c298c07de303
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:09164ec8-9ec2-ca82-2cd5-c298c07de303
msgctxt "heb2e9245g0a6fg442cgae2bg7e794432a47e"
msgid "Why would I tell you?"
msgstr "내가 그걸 왜 알려줘야 하죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Player
#. NodeID = 0dcdca95-cbdd-1bf4-e13f-887f2ed3733f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidDrowDead_State_ToldFurnaceSearch = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:0dcdca95-cbdd-1bf4-e13f-887f2ed3733f
msgctxt "h24decf45gac3fg41d7g93ffga56eb1798d87"
msgid "Xargrim's dead. His body's rotting in a myconid circle."
msgstr "자그림은 죽었어요. 그의 신체는 마이코니드 군락에서 썩어가고 있죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = 0e967ece-3cad-b752-8a7e-bba55766e717
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_PetrifiedDrow_HasMet_Wizard(1) = False
#. SetFlags:
#.   Dialog:
#.     - UND_PetrifiedDrow_HasMet_Wizard(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:0e967ece-3cad-b752-8a7e-bba55766e717
msgctxt "hd13b96d9gcc6eg4638gb90ag761414d4e444"
msgid "Dust. On.<i> </i>My. <i>Tongue!</i>"
msgstr "혀에. 먼지가. <i>묻었잖아!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = 0f1f10f9-68da-2dcd-e30a-39410f536ad4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:0f1f10f9-68da-2dcd-e30a-39410f536ad4
msgctxt "h23e57e94gaa35g40a2ga8d1ga9b4c92ad983"
msgid "Hmm. Perhaps you are telling the truth. Perhaps not."
msgstr "흠. 당신이 사실을 말하고 있을지도 모르죠. 아닐지도 모르지만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = 14637609-b58a-5fb7-32cd-ccc2b581c731
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_PetrifiedDrow_State_HostileResolution = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:14637609-b58a-5fb7-32cd-ccc2b581c731
msgctxt "hb74f7988gee3bg45b9gb87eg27888faa5454"
msgid ""
"Gods. Gods. I might have to raise your corpse just so I can <i>kill you "
"twice.</i>"
msgstr "신이시여. 신이시여. 당신을 죽인 다음 <i>다시 죽이기</i> 위해 시체를 되살려야 할지도 모르겠군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = 1704f444-4681-7c7b-1a28-53e57a878805
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_PetrifiedDrow_HasMet_Wizard(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:1704f444-4681-7c7b-1a28-53e57a878805
msgctxt "h191b3862g454cg4a4ega47bg4ab85266d62f"
msgid ""
"Not to sound ungrateful, but you couldn't have saved some of my guards? I'm "
"left to carry my own luggage."
msgstr "감사하지 않다는 건 아니지만, 내 경비 몇 명을 더 구하실 순 없었나요? 이제 짐을 스스로 들어야겠군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = 17b4af9a-2487-06f2-5021-183b60c5d853
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:17b4af9a-2487-06f2-5021-183b60c5d853
msgctxt "h932e5328g0dfdg4b20gab3cga40f2437fae3"
msgid "Far, far longer than I realised."
msgstr "제 생각보다 훨씬, 훨씬 길었죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Player
#. NodeID = 17fa28d1-beda-0d9e-9e52-f27efca6dd3a
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - LOLTHDROWELF(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:17fa28d1-beda-0d9e-9e52-f27efca6dd3a
msgctxt "h8a928b3cg206cg4e82ga9d6g336cac794e88"
msgid "I'm above house politics myself - but I'll still kill for what I want."
msgstr "난 비록 집안 정치에는 관심 없지만, 원하는 걸 위해서라면 살생을 마다하지 않지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = 1888a0a9-2071-6240-6471-bb3481192f8b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_PetrifiedDrow_HasMet_Wizard(1) = True
#.   Object:
#.      - UND_PetrifiedDrow_State_SomeOtherDrowAlive(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:1888a0a9-2071-6240-6471-bb3481192f8b
msgctxt "h3017a430gca83g4226gb002g57ae70493cdd"
msgid "We'll be moving, just as soon as my guards are done moaning."
msgstr "제 호위들이 정신을 차리고 나면, 이동할 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = 18afa55b-2d1a-2ac3-b4bb-94669947e9e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:18afa55b-2d1a-2ac3-b4bb-94669947e9e7
msgctxt "h148588b1g3dcbg44ebg9988g30b39cf5e94e"
msgid ""
"Well now. It seems his rather <i>unique</i> mind made itself useful. Clever "
"of you to see through his cypher."
msgstr "이런 이런. 보아하니 그의 다소 <i>독특한</i> 정신이 나름 쓸모가 있었나 봅니다. 그의 암호를 간파하다니 영리하시군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = 1a6d60e4-660d-1606-f85e-97d1dfd0904e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_PetrifiedDrow_State_HostileResolution = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:1a6d60e4-660d-1606-f85e-97d1dfd0904e
msgctxt "hde4ed8efg4fb2g422bg9615g24ef17a76487"
msgid "You think it clever to steal from a statue, do you?"
msgstr "석상에게서 도둑질을 하다니, 그게 영리한 일이라고 생각하시는군요, 그렇지 않습니까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Player
#. NodeID = 1ef6b720-a5f2-b6e2-2e25-d693a92e26d3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:1ef6b720-a5f2-b6e2-2e25-d693a92e26d3
msgctxt "hf3cc403dg8747g4b84g82b5g07c4e382a311"
msgid "Perhaps we can claim the forge together, split the proceeds."
msgstr "함께 대장간을 찾아 나설 수도 있을 것 같은데요, 전리품은 나눠 가지고 말이죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = 1f95fda0-78b8-f0b0-8df0-dc13bd09ea49
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_PetrifiedDrow_State_HostileResolution = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:1f95fda0-78b8-f0b0-8df0-dc13bd09ea49
msgctxt "hb31eede3g8bf8g4d8egbc9fgb30ef4ffb7e8"
msgid ""
"I've already been made a living statue for this damn crystal. A little pain "
"will not deter me."
msgstr "이 망할 수정을 두고 전 이미 살아있는 석상이 되었었습니다. 약간의 고통이 절 주저하게 만들진 않죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = 242017db-6669-313e-7b5f-bdd812a2be56
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_PetrifiedDrow_Knows_PassPhrase = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:242017db-6669-313e-7b5f-bdd812a2be56
msgctxt "hb872743bg7036g4dcega3ffga7e780bd19e1"
msgid ""
"... I... rather infuriatingly, I seem to have <i>lost </i>it. Should you "
"locate it, the knowledge within can be unlocked with the pass-phrase "
"'<i>Dhourn, Lord Archmage'.</i>"
msgstr ""
"...저... 꽤나 짜증나게도, 저는 그것을 <i>잃어버린 것</i> 같습니다. 만약 여러분이 그것을 찾으신다면, 그 안의 지식은 "
"<i>'로드 아크메이지, 도운'</i>이라는 암호로 해제할 수 있을 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = 24b4d535-738a-ff43-d63d-48ad16eeb1ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:24b4d535-738a-ff43-d63d-48ad16eeb1ec
msgctxt "h659fc390g408ag4e46gb34fg4cf20509b3c5"
msgid "Now - you are?"
msgstr "그래서 - 당신은 누구죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Player
#. NodeID = 29845d40-b8ae-5ae7-64a7-c777593a5380
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - BERSERKER(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:29845d40-b8ae-5ae7-64a7-c777593a5380
msgctxt "h148c4ec3ga907g454dgb5c0g3ce1af046afd"
msgid "HAND IT OVER, <b>BOY</b>. OR <b>ELSE.</b>"
msgstr "<b>넘기라고 했지. 교육이 부족한 거냐.</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Player
#. NodeID = 2b1860e1-15b7-6acf-631c-2e9136f732e8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_FurnaceSearch_Knows_Filro = True
#.      - UND_FurnaceSearch_State_FilroDead = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:2b1860e1-15b7-6acf-631c-2e9136f732e8
msgctxt "hfd8f685cg3f18g4ef0ga06ag5b3f89b789d3"
msgid "Filro went mad. I had to kill him."
msgstr "필로는 정신이 나가버렸어요. 그를 죽여야만 했죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = 2cebcaec-1cf6-3cdd-16f6-57fa9bccd26e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:2cebcaec-1cf6-3cdd-16f6-57fa9bccd26e
msgctxt "h542775acgb3aag4ff5g833fg63740c0b56c5"
msgid ""
"By any chance... did you find anything of interest on dear Xargrim's corpse?"
msgstr "혹시나 말인데... 친애하는 자그림의 시체에서 뭔가 흥미로운 것을 찾진 못하셨나요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = 3013b7b8-7386-8067-3dff-3a2440d722f9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:3013b7b8-7386-8067-3dff-3a2440d722f9
msgctxt "he9b945c9gd435g456dg9f61gcf9194292fad"
msgid ""
"You don't understand. A memory shard ought to hold its glow for years - and "
"look at it! It's <i>fading.</i>"
msgstr ""
"이해를 못 하는군요. 기억 조각은 원래 수년이 지나도 밝기를 잃지 않아요. 그런데 이걸 보세요! 거의 <i>희미해졌잖아요.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = 35003c80-c5e5-7b72-0da5-247d217f2e77
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:35003c80-c5e5-7b72-0da5-247d217f2e77
msgctxt "h60344d2fgf85bg4963gb623g87bebe25f5b6"
msgid ""
"Enterprising of you - the others knew of the forge's defences, its "
"operation... but I am the only one who knows its <i>location.</i>"
msgstr ""
"진취적인 분이시군요. 다른 이들은 대장간의 방어 체계, 작동 방법 등을 알고 있었습니다... 하지만 저만이 그 <i>위치를 알고 "
"있죠.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = 353685f7-3049-ef17-0ab4-98b5c7ae50f2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_PetrifiedDrow_State_HostileResolution = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:353685f7-3049-ef17-0ab4-98b5c7ae50f2
msgctxt "hef510ec4g0ff9g49aega0ebg8d5f3b036b08"
msgid ""
"I simply cannot suffer another rival in this. So killing you is a "
"compliment, if you think about it."
msgstr "이 일에 더 이상 경쟁자를 만들 순 없습니다. 그러니 잘 생각해 보시면, 제가 당신을 죽여야 한다는 사실은 칭찬이지요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = 362d0b5c-e2a6-f42b-2130-bc2dba2f02c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:362d0b5c-e2a6-f42b-2130-bc2dba2f02c8
msgctxt "h18bbbc6bg65f0g4186g9f44g338b02a1c198"
msgid "Liar. <i>How?</i>"
msgstr "거짓말. <i>어떻게?</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = 38922cf6-f194-af09-7109-f53614de7fd9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:38922cf6-f194-af09-7109-f53614de7fd9
msgctxt "h4a204b3dg313bg46e5g85e4g5c0697e82bc0"
msgid ""
"The rest I can figure out with time, now I am the only one searching. Or... "
"<i>almost</i> the only one."
msgstr ""
"나머지는 시간만 있으면 결국 알아낼 수 있겠죠, 이제 나만이 그걸 찾고 있으니 말입니다. 아니... <i>거의</i> 마지막 한 명이라고 "
"할 수 있겠군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = 4336e4e0-2e9d-921b-4f6e-141fb41668f4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_PetrifiedDrow_State_HostileResolution = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:4336e4e0-2e9d-921b-4f6e-141fb41668f4
msgctxt "h9da4117bgb92ag4268g981agb7c6db9753c0"
msgid "In fact - you've served your purpose now, so allow me to demonstrate."
msgstr "사실, 당신의 목적을 달성하셨으니, 제가 직접 보여드리죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = 44b1cb4c-a759-328c-24e7-648df0d4366e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_PetrifiedDrow_Wizard_ToldHimHouseNeedsHim(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:44b1cb4c-a759-328c-24e7-648df0d4366e
msgctxt "hd5d4becag4906g40c3ga604g665f6ec027a9"
msgid ""
"I bid you luck at the forge. All that labour - not fitting for Dhourn, "
"<i>first</i> son of House Ba'Tol."
msgstr "대장간에서 행운이 따르시기를 빌죠. 그 모든 노역들은, 바톨 집안의 <i>장남</i> 도운에게 어울리지 않습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = 462ee115-6487-6c0c-cb0a-3a70b1b08ade
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_PetrifiedDrow_State_PeacefulResolution = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:462ee115-6487-6c0c-cb0a-3a70b1b08ade
msgctxt "h6717d921g9808g4219g8e12g862667608ef4"
msgid ""
"But should you find it, mistress - the pass-phrase is <i>'Dhourn, Lord "
"Archmage'. </i>A rather... aspirational title, I know - but no longer needed."
msgstr ""
"하지만 그걸 찾으신다면, 아가씨. 암호는 <i>'로드 아크메이지, 도운' 입니다. </i>꽤... 포부가 넘치는 이름인 건 압니다. "
"하지만 더 이상은 필요 없겠죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = 4750cb99-7b23-4545-f1c4-e571cb651774
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:4750cb99-7b23-4545-f1c4-e571cb651774
msgctxt "h0355ff29gaffdg4a1eg8e3cg452f84ff5c8c"
msgid ""
"But I'm afraid I can't. You've proven a little too resourceful, and I really "
"can't suffer another rival for this prize."
msgstr "하지만 그럴 순 없겠어. 당신이 능력을 증명해 보였으니, 보상을 앞둔 지금 싹을 잘라 두는 게 당연하잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = 48a5e3b8-bcc7-b70e-a4b7-383f756b5947
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_PetrifiedDrow_State_HostileResolution = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:48a5e3b8-bcc7-b70e-a4b7-383f756b5947
msgctxt "h45b093acg4ba3g4f38g9887g7b8e0fa01190"
msgid ""
"... you were so <i>very</i> close. If only you had just a little less cheek, "
"I might have let you live."
msgstr "...당신은 <i>정말</i> 아깝게 됐군요. 조금만 더 겸손했다면, 당신을 살려둘 수도 있었을 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = 49daebb7-bb7a-a2e2-9b48-e56552476e9d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_PetrifiedDrow_State_HostileResolution = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:49daebb7-bb7a-a2e2-9b48-e56552476e9d
msgctxt "h47d67838gf19ag4306ga371g94818f9a4bca"
msgid ""
"Well. This knowledge is only useful so long as I am the only one who holds "
"it. My apologies."
msgstr "글쎄요. 이 지식은 저 혼자만이 가지고 있어야만 유용합니다. 사과드리죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = 4a2ef612-b822-159e-443e-6e4276539b79
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_PetrifiedDrow_State_HostileResolution = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:4a2ef612-b822-159e-443e-6e4276539b79
msgctxt "hf3dc3b9dg91abg4359gadf6gec47e40a7c23"
msgid "So try to take this as a compliment, yes?"
msgstr "그러니 칭찬으로 받아들이라고. 알겠나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = 4ae63470-0ba3-041a-e77e-3ba2353f7a1e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:4ae63470-0ba3-041a-e77e-3ba2353f7a1e
msgctxt "h50c290fcg7a40g45e7ga9eagd7cd0d6efd61"
msgid ""
"They knew of the forge's defences, its operation, true enough. But I know "
"its <i>location.</i>"
msgstr "그들은 대장간의 방어 체계와 작동법을 알고 있었죠, 맞습니다. 하지만 난 그 <i>위치를</i> 알고 있어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Player
#. NodeID = 4b307819-33db-015c-ff1e-11de85df7955
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:4b307819-33db-015c-ff1e-11de85df7955
msgctxt "h52731205g1bb7g4941ga983g30ec32dba419"
msgid "Wait. I'll take that crystal of yours as thanks."
msgstr "잠깐. 감사 인사로 그 수정을 가져가지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = 50ed12ea-d19a-a7bb-2eeb-364352c07722
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:50ed12ea-d19a-a7bb-2eeb-364352c07722
msgctxt "h840bea75gec75g4f4fgb9ccgc20d643887e3"
msgid ""
"I mean to say, mistress - I have undertaken this research myself, beholden "
"to no house or hold."
msgstr "그러니까, 아가씨 - 이 연구는 제 혼자 힘으로 진행했어요, 어떤 가문이나 집안의 후원도 받지 않았습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = 517c1620-24f0-25bc-41fd-273a5aef0b01
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - UND_PetrifiedDrow_Wizard_ToldHimHouseNeedsHim(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:517c1620-24f0-25bc-41fd-273a5aef0b01
msgctxt "ha174e70ag34bfg4d69gad79ga7009ee7ff26"
msgid ""
"Hah, just as my fortunes turn for the better. Rather lucky for me - less so "
"for you, mistress."
msgstr "하, 제 운이 좀 좋아지려는 것 같군요. 제겐 잘 된 일이지만, 당신께는 아니겠군요, 아가씨."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Player
#. NodeID = 52eed447-0342-90da-81e8-8dc0e86ca2a5
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - LOLTHDROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:52eed447-0342-90da-81e8-8dc0e86ca2a5
msgctxt "h60033b5ag59a5g49eag9efag51009c20ac79"
msgid ""
"Every house is beholden to Lolth - as every male is beholden to their "
"betters."
msgstr "모든 집안은 롤쓰님의 은혜를 입었지, 모든 남성이 그들 상위자의 은혜를 입었듯이 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Player
#. NodeID = 54f90fb1-ec78-d365-0db0-0b5a7dc09125
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:54f90fb1-ec78-d365-0db0-0b5a7dc09125
msgctxt "h99df9d1dg2b4eg43c5g8420ge2111afd14e8"
msgid "You first."
msgstr "당신부터 말해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = 568a6edb-d68f-6423-6930-35fd3a3b4243
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:568a6edb-d68f-6423-6930-35fd3a3b4243
msgctxt "h55340309gccfag4356g80efg56502a3a7595"
msgid ""
"... do you know how many years we spent searching? Studying? For you to "
"simply <i>stumble</i> on it?"
msgstr "... 저희가 얼마나 많은 세월을 찾아다녔는지 아시나요? 연구하면서? 그런데 당신이 그걸 <i>우연히</i> 발견했다고요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = 571deb63-3800-645b-ec8e-704d97d47531
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_PetrifiedDrow_Knows_MemoryCrystal = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:571deb63-3800-645b-ec8e-704d97d47531
msgctxt "h8d56496bg0be6g454cg9952g60b63b669791"
msgid ""
"A memory shard. They hold their glow for years<i> </i>- and it's <i>fading. "
"</i>"
msgstr "기억 조각입니다. 수년 동안 빛을 유지하죠, 그런데 그게 <i>희미해지고 있어요. </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = 5b3df4c3-ab90-74b8-2a49-f6ac300e6b5c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:5b3df4c3-ab90-74b8-2a49-f6ac300e6b5c
msgctxt "heda04aedgb13cg4a39gb509g1d66963a948b"
msgid ""
"And you <i>fell</i> for it. You clearly don't have the intellect to pose a "
"threat... but you <i>did</i>  manage to kill a spectator."
msgstr "그리고 당신은 그것에 <i>속았죠.</i> 분명 위협이 될 지능은 없어 보이지만...  스펙테이터를 죽이는 데는 성공했군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Player
#. NodeID = 5dad3a93-7cc9-ee04-394c-6bd41970e823
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:5dad3a93-7cc9-ee04-394c-6bd41970e823
msgctxt "hc0bea809ge3ddg43a7g9423g2ccc5b47f467"
msgid "What forge?"
msgstr "무슨 대장간을 말하는 거죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = 5e302317-a223-7889-290e-2a5721a3a1c8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_PetrifiedDrow_State_MentionedForge = True
#.   Local:
#.     - af35db62-4019-d634-5f27-0b436ca25eba_KnowsFurnace = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:5e302317-a223-7889-290e-2a5721a3a1c8
msgctxt "h9615f5c9g913eg4771g9666gdf5314270282"
msgid ""
"Impossible. The master of the Adamantine Forge would be known - and feared - "
"throughout the Underdark."
msgstr "불가능해요. 아다만틴 대장간의 주인이라면 언더다크 전역에 널리 알려지고, 두려움의 대상이 되었을 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Player
#. NodeID = 608f4a22-384d-094d-d5c1-67cf840939bf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_FurnaceSearch_State_FoundDisguisedJournal = True
#.      - UND_FurnaceSearch_State_FoundForgeManual = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:608f4a22-384d-094d-d5c1-67cf840939bf
msgctxt "h6b66598agbc3ag41c5g93e2g6950529dfaa0"
msgid "Just a book. He had some particular literary tastes."
msgstr "그냥 책이었어요. 특이한 문학 취향을 가지고 있더군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = 66a89408-86f9-35fa-c428-7727e06f914b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_PetrifiedDrow_State_HasMap(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:66a89408-86f9-35fa-c428-7727e06f914b
msgctxt "h15d15fc1g6f3dg47fdgb62dg025c319c3530"
msgid "... oh. Oh no no my dear dark GODS BELOW, <i>NO!</i>"
msgstr "... 오 이런. 오 안 돼, 안 돼, 저 아래의 어두운 신들이시여, <i>안 돼!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Player
#. NodeID = 697cc588-6e76-caaf-1f29-53ba24aaa9c7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_PetrifiedDrow_State_PeacefulResolution = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:697cc588-6e76-caaf-1f29-53ba24aaa9c7
msgctxt "h6ca12920g1ecag4c4dg89d9g9157cfa64ef0"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = 6b78d144-8ace-6bf3-6fa0-0025c1f7a9d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:6b78d144-8ace-6bf3-6fa0-0025c1f7a9d4
msgctxt "h8511df96g5916g4713g9906g78970e64d389"
msgid ""
"Unless... hah. Hah! The fools must have turned back. Or better yet, died in "
"the search. <i>Good.</i>"
msgstr "그렇지 않다는 건... 하. 하! 그 등신들이 중간에 포기한 게 분명해요. 아니면, 중간에 죽었거나. <i>아주 좋군요.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Player
#. NodeID = 6bf0f7bd-34aa-63ec-25e2-c346cb029e00
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:6bf0f7bd-34aa-63ec-25e2-c346cb029e00
msgctxt "h62189a90g907dg4cc3gb82fgfe0ee163961f"
msgid "What knowledge does the crystal contain, exactly?"
msgstr "그 수정에 정확히 어떤 지식이 들어있는 거죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Player
#. NodeID = 6ea0998c-f6c0-fd93-2a01-92d4827d9d86
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - UND_AdamantineForge_Knows_SawForge = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:6ea0998c-f6c0-fd93-2a01-92d4827d9d86
msgctxt "h7badc0aeg9bcfg4346gae78gaff113a0b926"
msgid ""
"Do you speak of the Adamantine Forge? It's still hidden, as far as I know."
msgstr "아다만틴 대장간에 대해서 말하는 건가요? 내가 알기론, 아직 숨겨져 있는 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = 6f2788ed-f9db-09bc-00ee-81897b04621e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:6f2788ed-f9db-09bc-00ee-81897b04621e
msgctxt "h7ad34ccbg6bd9g4da1g8068g7421f32b4e29"
msgid ""
"It contains knowledge that is precious to me. If it has grown this dull..."
msgstr "이 안에는 내게 소중한 지식이 담겨 있죠. 이렇게까지 희미해졌다는 건..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Player
#. NodeID = 72c50646-12e5-14a0-6f1e-e99174f19335
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:72c50646-12e5-14a0-6f1e-e99174f19335
msgctxt "h858e922fg7639g4820g8208gbbc39ef29def"
msgid "I was exploring across the lake."
msgstr "호수 너머를 탐험하고 있었어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = 738dac62-f5fb-e3c3-b429-e584b452272d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:738dac62-f5fb-e3c3-b429-e584b452272d
msgctxt "h1425d0f3g6aa2g4a5cgb4dagf7c970a5b0fd"
msgid ""
"Pah. A rival - a mere footnote to my legend. You should be more concerned "
"with who <i>I</i> am."
msgstr ""
"하. 내 라이벌이에요, 내 명성에 비하면 새 발의 피에 불과한 녀석이지만. 그보단 <i>내가</i> 누구인지 걱정하는 게 좋을 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = 741f5af3-4d8b-7b94-785f-6e266defa554
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:741f5af3-4d8b-7b94-785f-6e266defa554
msgctxt "h6a7bcc0cg40b7g42d3gb758gadcf40393b8a"
msgid ""
"I'll put them to better use. And, on the off chance you've read them "
"yourself..."
msgstr "제가 그것들을 더 잘 사용할 수 있을 겁니다. 그리고, 우연히 당신이 그것들을 직접 읽은 경우엔..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = 7430d365-ece9-c9af-79e0-19d41d4c7366
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_PetrifiedDrow_State_HostileResolution = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:7430d365-ece9-c9af-79e0-19d41d4c7366
msgctxt "h8d3a4af4g7e29g4c06ga362g1fe8d730f9e2"
msgid ""
"Why indeed. I think I'll find you easier to speak to once you're a "
"<i>corpse.</i>"
msgstr "왜일까요. 당신이 <i>시체</i>가 되는 편이 대화하기에 더 수월할 것 같군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Player
#. NodeID = 74c771e1-0ba9-c976-fbc5-72a049edf86a
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - UND_FurnaceSearch_State_FoundDisguisedJournal = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:74c771e1-0ba9-c976-fbc5-72a049edf86a
msgctxt "h80bd83a1g46fag4ab7g88c0g96e30477dddf"
msgid "I'm afraid I didn't."
msgstr "아쉽게도 그러지 않았어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Player
#. NodeID = 752c50e9-1e53-7c28-3888-8852c346303b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_FurnaceSearch_Knows_Filro = True
#.      - UND_FurnaceSearch_State_FilroDead = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:752c50e9-1e53-7c28-3888-8852c346303b
msgctxt "h163bdfb8g7b68g418bg9f94g6da6ff6f0840"
msgid "Filro's gone mad. He joined a pack of hook horrors."
msgstr "필로는 정신이 나가버렸어요. 후크 호러와 함께하고 있더군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = 7bf63ebe-dd6b-6657-0f68-45aa2b1cfddb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:7bf63ebe-dd6b-6657-0f68-45aa2b1cfddb
msgctxt "h602549dcga22ag4c5ag967cg6f38ce4c99f0"
msgid ""
"'Battled'? Please - that implies rivalry. He will but a footnote in my "
"legend."
msgstr ""
"'경쟁을 했다'? 부탁입니다. 그건 마치 그가 제 라이벌이라도 되었던 것처럼 들리잖습니다. 그는 제 전설을 위한 발판일 뿐이라고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = 7f279cc5-0ece-3b16-b034-aac2a71481b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:7f279cc5-0ece-3b16-b034-aac2a71481b1
msgctxt "hff08cd0bgc0abg4c3fgb531g63a7ff5b0f08"
msgid ""
"... then my brothers have perished in my absence? With no sons to replace "
"them..."
msgstr "...그러니까 제가 없는 사이 형제들이 죽었단 말입니까? 그들을 대신할 자식도 없으니..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Player
#. NodeID = 806825c4-cfd5-41f0-88e9-4c734e8e00ed
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - FEMALE(1) = True
#.      - DROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:806825c4-cfd5-41f0-88e9-4c734e8e00ed
msgctxt "hb6687ed8gbfa9g4581gad24gbe9b582804d4"
msgid "You'll claim nothing. Hand over the crystal - I'll take it from here."
msgstr "네가 가질 건 아무것도 없어. 그 수정을 이리 넘겨, 이제부턴 내가 맡지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = 81eeb9aa-8c93-c1fc-5f07-3d13270124ec
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_PetrifiedDrow_State_PeacefulResolution = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:81eeb9aa-8c93-c1fc-5f07-3d13270124ec
msgctxt "h35e5ef17g5fcdg483eg9b79g27d2bfab0e2d"
msgid "... just an... aspiration for a wizard of my talents, mistress."
msgstr "... 그저... 제 위저드로써의 야망을 나타내는 겁니다, 아가씨."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = 823cd2ef-8b6c-e665-0321-1e44cc766e0d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:823cd2ef-8b6c-e665-0321-1e44cc766e0d
msgctxt "haca8f6a8gb981g41dcgb649g3a3fcb300d80"
msgid ""
"I have plenty of time, now I'm the only one hunting for the forge. Or... "
"<i>almost </i>the only one."
msgstr "저는 충분한 시간을 가지고 있고, 이제 대장간을 찾고 있는 유일한 사람이죠. 아니... <i>거의</i> 유일하다고 해야겠군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = 83f535f4-836e-3613-c158-8088151c0330
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:83f535f4-836e-3613-c158-8088151c0330
msgctxt "h87ec6c26g1634g4698g9c55g355345c73216"
msgid ""
"Consider it mercy - or pest control. Filro was never <i>fully</i> right."
msgstr "자비나 해충 구제라고 생각하세요. 필로는 결코 <i>온전하지</i> 않았으니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = 84de3a19-ae9a-c754-307f-4e4ee7dcc7af
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:84de3a19-ae9a-c754-307f-4e4ee7dcc7af
msgctxt "h355131eegab74g4723ga713gdb915be063d1"
msgid ""
"Then my enemies have already found the forge. Which bastard stole my glory - "
"Xargrim? Filro?"
msgstr "이미 내 적들이 대장간을 찾았다는 뜻이겠군요. 어떤 개자식이 내 영광을 훔쳤죠? 자그림? 필로?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = 8560a196-65e9-d083-09af-fffb7841fb5c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - af35db62-4019-d634-5f27-0b436ca25eba_KnowsFurnace = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:8560a196-65e9-d083-09af-fffb7841fb5c
msgctxt "he16e0e9dgfe65g4beeg85aag1b0021f46d2d"
msgid "Impossible. My rivals would have stopped at nothing."
msgstr "불가능해요. 내 경쟁자 녀석들은 어떤 일에도 멈추지 않았을 거라고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Player
#. NodeID = 85aee5ed-acbf-7d51-7b88-b46e50d9aa61
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:85aee5ed-acbf-7d51-7b88-b46e50d9aa61
msgctxt "h4ad8fbd3g28c1g417eg9fbeg6df3cae5e245"
msgid "Neither bastard rings a bell, I'm afraid."
msgstr "미안하지만, 양쪽 개자식 다 전혀 모르겠군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Player
#. NodeID = 88b2016d-aca9-bfa9-244a-86690adec540
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_FurnaceSearch_Event_SucceedMadRecords = False
#.      - UND_FurnaceSearch_State_FoundMadRecords = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:88b2016d-aca9-bfa9-244a-86690adec540
msgctxt "h24ecf78fgfb4ag4332g80b4g0119ab2a3e6e"
msgid "Some text - but it's written in code."
msgstr "어떤 글자였어요 - 하지만 암호로 적혀있더군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = 8b40d3a3-a51b-4362-4b83-166f25498556
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:8b40d3a3-a51b-4362-4b83-166f25498556
msgctxt "hbea5045eg06c8g4bfdgb6begfda7918665fb"
msgid ""
"You release me <i>and</i> hand-deliver such a prize? I ought to keep you."
msgstr "날 풀어준 데다, 이런 선물을 직접 전달해 준다고요? 당신은 꼭 간직해야겠군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = 8df4d3c8-8aa9-7c92-5111-5ceca13ba52e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:8df4d3c8-8aa9-7c92-5111-5ceca13ba52e
msgctxt "h8383b511g2c2cg46b1g8414gba884d6e3091"
msgid ""
"I offer to parley, and he brings a <i>spectator</i>? Twit. Quite ruined my "
"ambush."
msgstr "협상하자고 불렀더니, <i>스펙테이터를</i> 끌고 오다니? 멍청한 자식. 내 매복을 망쳐놨군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = 92ecdd64-a7a5-6ade-62b0-5c906fd0e80c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_FurnaceSearch_Knows_Rivalry = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:92ecdd64-a7a5-6ade-62b0-5c906fd0e80c
msgctxt "h0462615agb0e7g4a7eg9e82g8fdc745449c6"
msgid ""
"But no - they hoarded their knowledge, left each of us clinging to scraps."
msgstr "하지만 그 자식들은 자신이 가진 정보들을 꽁꽁 숨겼죠, 그 덕에 각자 정보의 찌꺼기만 가지고 다투고 말입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = 93707a13-4bf9-7444-f8f4-7afaafdaf4b7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_PetrifiedDrow_State_HostileResolution = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:93707a13-4bf9-7444-f8f4-7afaafdaf4b7
msgctxt "h7f6f9754g3db8g4467gb798ge4b7a8491bf6"
msgid "I believe I'll have to kill you and ask again."
msgstr "널 죽여버리고 다시 물어야겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Player
#. NodeID = 943bc429-b194-d507-b83a-6666cceccdf9
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - LOLTHDROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:943bc429-b194-d507-b83a-6666cceccdf9
msgctxt "h2d98cdefgf09bg4270gb4f2gce0fc7856127"
msgid ""
"I must have misheard you. Perhaps you'll speak louder from a rack in "
"Menzoberranzan."
msgstr "내가 잘못 들은 것 같군. 멘조베란잔에 가서 매달아 놓으면 좀 더 크게 말할지도 모르겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Player
#. NodeID = 9b5768fc-c62d-82a1-6bef-873c35bb093e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_FurnaceSearch_Knows_XargrimSummonedSpectator = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:9b5768fc-c62d-82a1-6bef-873c35bb093e
msgctxt "h8017e47fg9a9cg49e1g97e4gf385dec12f60"
msgid "I'm more concerned with this 'twit' who set a spectator on you."
msgstr "당신에게 스펙테이터를 보냈다는 이 '멍청이'가 더 걱정되는데요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Player
#. NodeID = 9f121610-18e8-969d-5a91-794277d09737
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - UND_FurnaceSearch_State_FoundMadRecords = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:9f121610-18e8-969d-5a91-794277d09737
msgctxt "h2234801bg4c4eg4b17ga36egfb5beedaee3a"
msgid "Nothing."
msgstr "아무것도."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = a07d6289-a22f-79cc-0d6d-a1d0afd1ae1b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_PetrifiedDrow_State_MentionedForge = True
#.   Local:
#.     - af35db62-4019-d634-5f27-0b436ca25eba_KnowsFurnace = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:a07d6289-a22f-79cc-0d6d-a1d0afd1ae1b
msgctxt "hdfaefcb3g8f7cg40d0g9a9ag4d6f10cdd0be"
msgid ""
"The <i>Adamantine Forge?</i>  If it had been found, the name would ring "
"throughout the Underdark."
msgstr "물론 <i>아다만틴 대장간이겠죠?</i>  만약 발견되었다면, 그 이름이 언더다크 전역에 퍼져나갔을 것이 분명해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = a087a6f6-2960-edef-2146-4b71defad0b8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:a087a6f6-2960-edef-2146-4b71defad0b8
msgctxt "h9a33f5e4g62a1g40acg89adg48a8a9365a78"
msgid "Truly? Perhaps they've improved his manner."
msgstr "정말인가요? 아마도 놈들이 그 녀석의 태도를 개선했을지도 모르죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = a1c34d36-b289-b33d-4fc9-e125137e04e5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_PetrifiedDrow_State_HasMap(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:a1c34d36-b289-b33d-4fc9-e125137e04e5
msgctxt "h8af3cb1fg236bg4932gbfedg914d798d35f3"
msgid "Take the shard then, please- only... I seem to have lost it."
msgstr "그렇다면 조각을 가져가세요, 부탁입니다 - 다만... 이미 사라진 것 같군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Player
#. NodeID = a1f37a23-90b3-012e-17b0-a3fea52320e7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_FurnaceSearch_Event_SucceedMadRecords = True
#.      - UND_FurnaceSearch_State_FoundMadRecords = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:a1f37a23-90b3-012e-17b0-a3fea52320e7
msgctxt "h67362416g50eag4deeg8fa4g62f13bc6b9c9"
msgid ""
"I decoded his notes - he'd written about some guardian of the Adamantine "
"Forge."
msgstr "그가 남긴 기록을 해독했어요, 아다만틴 대장간에 있는 어떤 수호자에 대해 적어뒀더군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = a4bc311a-ebb3-32e5-9485-819907117d6d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:a4bc311a-ebb3-32e5-9485-819907117d6d
msgctxt "h63faa65bg5212g49bcg98dcga49032da9242"
msgid ""
"Bold of you to ask. The others knew of the forge's defences, its "
"operation... but <i>I</i> know where to find it."
msgstr ""
"그걸 묻다니 용감하군요. 다른 이들은 대장간의 방어 체계, 작동 방법 같은 걸 알고 있었죠... 하지만 <i>나만이</i> 그 위치를 "
"알고 있어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = a6a24d5b-3212-60e6-0318-6475535c2a77
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:a6a24d5b-3212-60e6-0318-6475535c2a77
msgctxt "h7af5400fg07d9g4af7g9fafg7c6d29b398d7"
msgid ""
"So the bastard was hiding something. Trust Xargrim to require "
"<i>instructions.</i>"
msgstr "결국 그 개자식이 숨기는 게 있었군요. 자그림이 <i>작동 방법을</i>을 가지고 있을 거라 믿다니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = a889b39b-4a7f-88ef-f969-8604979770b0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_PetrifiedDrow_Knows_PassPhrase = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:a889b39b-4a7f-88ef-f969-8604979770b0
msgctxt "he2a1e62ag94eeg4ab2g9409g60909687c774"
msgid ""
"This memory shard holds the location of the lost Adamantine Forge. It "
"answers to the pass-phrase <i>'Dhourn, Lord Archmage'.</i>"
msgstr ""
"이 기억 조각에는 잃어버린 아다만틴 대장간의 위치가 기록되어 있어요. <i>'로드 아크메이지, 도운'</i>라고 하면 조각을 들여다 볼 "
"수 있을 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = a989c7ec-351c-e30a-b089-c0a170347559
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_FurnaceSearch_Knows_Rivalry = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:a989c7ec-351c-e30a-b089-c0a170347559
msgctxt "h9e6f04abg1fcdg49e4ga6ffg04c908513a03"
msgid ""
"We were friends once, three of us working together to find a lost wonder. "
"Until the others grew jealous, began to guard their secrets."
msgstr "우리 셋은 한때 친구였습니다, 사라진 경이를 찾고 있었어요. 하지만 곧 서로를 질투하게 되었고, 비밀을 지키기 시작했죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Player
#. NodeID = aa493d4b-dea8-9f5e-6320-964e0cc9c1b8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:aa493d4b-dea8-9f5e-6320-964e0cc9c1b8
msgctxt "hc786c23fgf25eg483eg90ccg2b4de5dcf1ad"
msgid "All right. I'll let you get back to whatever this is."
msgstr "알겠어. 뭔진 모르겠지만 네가 하던 일로 돌아가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = aab4da2f-97f4-2a55-f1fc-7c895a13edb5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:aab4da2f-97f4-2a55-f1fc-7c895a13edb5
msgctxt "h38b3c3b7ge753g4947gb399g9152220112c0"
msgid ""
"Xargrim had no taste at all. But enough low cunning to use an illusion? "
"Absolutely."
msgstr ""
"자그림은 고상함이라곤 찾아볼 수 없는 놈이었죠. 하지만 환영을 사용할 어느 정도의 교활함은 충분히 가지고 있었냐 하면? 당연한 말씀."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = b1944cf3-d72f-c50d-2935-d470de044597
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:b1944cf3-d72f-c50d-2935-d470de044597
msgctxt "h3d080132gde13g4b7fgb257g767b1ee1b6ba"
msgid "Did he have anything...  interesting in his possession?"
msgstr "그가 어떤...  흥미로운 물건을 가지고 있진 않던가요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Player
#. NodeID = b1c941b0-8659-4896-c83c-869874f4a943
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:b1c941b0-8659-4896-c83c-869874f4a943
msgctxt "h86c42297g0559g4422g8e20ge61494480343"
msgid "What's that?"
msgstr "그건 뭐죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Narrator
#. NodeID = b1d07c0d-5df4-053d-42fc-e92d4b657824
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_PetrifiedDrow_Knows_MemoryCrystal = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:b1d07c0d-5df4-053d-42fc-e92d4b657824
msgctxt "h8c9586c9g0a21g49f6g8d33g68326bceb4e5"
msgid ""
"*A memory shard. A container onto which brief mental impressions are "
"projected, and stored for years at a time.*"
msgstr "*기억 조각. 짧은 정신의 인상을 투영해, 수년 동안 기록할 수 있는 장치입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = b3a70fbd-c137-be08-de85-4987af6908f2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_PetrifiedDrow_State_HostileResolution = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:b3a70fbd-c137-be08-de85-4987af6908f2
msgctxt "h7d7c085ega619g42e2ga15ag8d66d8275f71"
msgid ""
"You proved your power in freeing me - but I need no more rivals. Try to take "
"this as a compliment, yes?"
msgstr "당신은 날 풀어줌으로써 힘을 증명했지만, 이제 경쟁자는 더 필요 없어서 말입니다. 칭찬으로 들으세요, 아시겠죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Player
#. NodeID = b4aad685-0c4a-4f68-c556-52a7f0665377
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:b4aad685-0c4a-4f68-c556-52a7f0665377
msgctxt "h1dae9bf5g6eabg4b57g959ag6edc633e9b04"
msgid "You're asking if I robbed your friend?"
msgstr "당신 친구 물건을 훔쳤냐고 물어보는 겁니까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Player
#. NodeID = b52748c3-f9b9-00a3-f2ed-8abfeb0783f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:b52748c3-f9b9-00a3-f2ed-8abfeb0783f5
msgctxt "hbb36f0d6ga349g42adgb865gbb10ad4a95d3"
msgid "It's fading - it seems you've been frozen like that for a while."
msgstr "희미해지고 있군요, 그렇게 얼어붙은 지 오랜 시간이 지난 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Player
#. NodeID = b55be02c-81e2-04be-53ba-764e529b3d44
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:b55be02c-81e2-04be-53ba-764e529b3d44
msgctxt "h81532bd3geea6g4635g8ee3gfbd492eb37cc"
msgid "It sounds like you were each as bad as the other."
msgstr "들어보니 다들 하나같이 멍청한 것 같은데요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Player
#. NodeID = b6a25398-389f-8e25-8d10-aed0745d2b83
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_AdamantineForge_Knows_SawForge = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:b6a25398-389f-8e25-8d10-aed0745d2b83
msgctxt "h71d35595g749eg4d88ga65bgb0676fc62f67"
msgid ""
"Do you speak of the Adamantine Forge? It's still hidden, as far as I know."
msgstr "아다만틴 대장간에 대해서 말하는 건가요? 내가 알기론, 아직 숨겨져 있는 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = b6bef768-8a1d-68a9-4b8e-d72925cd58ba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:b6bef768-8a1d-68a9-4b8e-d72925cd58ba
msgctxt "h894c6fc0g1bc6g48dagb39bgf9b7d744f304"
msgid "Truly? Excellent - he might actually serve some purpose feeding fungus."
msgstr "정말인가요? 훌륭합니다 - 그는 실제로 곰팡이를 기르는데 어떤 도움을 줬을 수 있어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = ba1debe5-8b05-54e8-e119-91466f80a4b9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_PetrifiedDrow_Knows_WizardIsDhourn = True
#.     - UND_FurnaceSearch_HasMet_Dhourn = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:ba1debe5-8b05-54e8-e119-91466f80a4b9
msgctxt "h7a14e047gbad4g45ddga7a8g1ac92b690cca"
msgid ""
"I am Dhourn. Third son of House Ba'Tol, first rank evoker, and initiate of "
"Gravenhollow's..."
msgstr "전 도운이라고 합니다. 바톨 집안의 셋째 아들이자, 일등 기원사, 그리고 그레이븐할로우의 조직원..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = be689b52-bd21-1986-3638-723384fd9e2e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:be689b52-bd21-1986-3638-723384fd9e2e
msgctxt "h85727f66ga59cg4ab7gbcd2g634e3cb86a02"
msgid "... my apologies, mistress. I am still coming back to my senses."
msgstr "... 사과드리죠, 아가씨. 아직 제정신이 돌아오지 않아서 말입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = bf9b9631-32e5-5275-5350-4afdc9b97b8a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:bf9b9631-32e5-5275-5350-4afdc9b97b8a
msgctxt "he5aa2369g0ff6g4465g91bdgca902045297f"
msgid "We simply haven't time for <i>all</i> of my titles."
msgstr "제 칭호를 <i>다</i> 부를 시간이 없군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Player
#. NodeID = c063be26-1275-899e-8f06-14a6a50e6f95
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - UND_FurnaceSearch_State_FoundMadRecords = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:c063be26-1275-899e-8f06-14a6a50e6f95
msgctxt "h825137a6g67f5g4974ga469gb6cf9b7d495f"
msgid "Nothing."
msgstr "아무것도."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = c1d686ac-a5fb-aade-ade7-8c59f0857095
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:c1d686ac-a5fb-aade-ade7-8c59f0857095
msgctxt "hae5d81c4g73eeg4750g9acdg14f8c0dea093"
msgid ""
"If you didn't, you're a fool. The dead have no use for what's in their "
"pockets."
msgstr "그렇지 않았다면, 바보가 따로 없군요. 죽은 이들 호주머니에 뭘 남겨봤자 그게 무슨 소용입니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = c346d9d0-efaf-df4e-7dca-9ba166594419
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - af35db62-4019-d634-5f27-0b436ca25eba_KnowsFurnace = True
#. SetFlags:
#.   Global:
#.     - UND_PetrifiedDrow_Knows_PassPhrase = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:c346d9d0-efaf-df4e-7dca-9ba166594419
msgctxt "h10bfdef2g38cdg45c1gb7c7g6d11daf087f9"
msgid ""
"The memory shard answers to the pass-phrase '<i>Dhourn, Lord Archmage</i>'."
msgstr "기억 조각에 '<i>로드 아크메이지, 도운</i>'이라고 말하면 될 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Player
#. NodeID = c579b60f-10a6-1815-8c6f-11d82058c675
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:c579b60f-10a6-1815-8c6f-11d82058c675
msgctxt "h8d87cd09ga94bg4964gbaceg12f5ab5e0f2b"
msgid ""
"House Ba'Tol, you said? You'll be welcomed back - all the male heirs died, I "
"believe."
msgstr "바톨 가문이라고 했나? 돌아가면 환영받을 수 있겠군, 내가 알기로 그들의 모든 남성 상속자는 죽었거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Player
#. NodeID = c6452d87-7f97-fbb4-dfc9-278b1472cd41
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_FurnaceSearch_State_FoundForgeManual = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:c6452d87-7f97-fbb4-dfc9-278b1472cd41
msgctxt "h6c09ce88g260dg4f4cg8b21g7b3933a87c36"
msgid "He had this manual on him."
msgstr "그에게 이 설명서가 있었어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Player
#. NodeID = c71e9f4b-190c-3942-a8fc-3411271f8eeb
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - UND_FurnaceSearch_State_FoundDisguisedJournal = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:c71e9f4b-190c-3942-a8fc-3411271f8eeb
msgctxt "hc600275ag9d19g4b75gb844gae9defdb4a15"
msgid "I'm afraid I didn't."
msgstr "아쉽게도 그러지 않았어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = ccf73b4b-fbf6-5b23-da66-c8cc027df55a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:ccf73b4b-fbf6-5b23-da66-c8cc027df55a
msgctxt "h79447c33gc7ecg45a2g9c56g40002ee4753c"
msgid "Disappointing. But he's out of the way, so small blessings I suppose."
msgstr "실망스럽군요. 하지만 적어도 그는 사라졌으니, 조금은 감사할 일이겠죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = cd4b8684-817d-ed69-fafa-e678cf0b6fad
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_PetrifiedDrow_State_HasMap(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:cd4b8684-817d-ed69-fafa-e678cf0b6fad
msgctxt "h9c1c59e0ge5d2g4401g93c6g927361b4b1ba"
msgid "... my crystal. My memory shard. <i>Where is it?</i>"
msgstr "... 내 수정. 내 기억 조각. <i>어디 갔지?</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Player
#. NodeID = ce036938-16e1-1f18-585f-be1ca68d1b4c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_AdamantineForge_Knows_SawForge = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:ce036938-16e1-1f18-585f-be1ca68d1b4c
msgctxt "h225e06bfgd304g492fgbf32g1e2fb321bc7b"
msgid "The Adamantine Forge? That was me, actually."
msgstr "아다만틴 대장간 말인가요? 그건 사실 나였어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Player
#. NodeID = cf7274ea-f343-149f-f52c-a55807c9297c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - FEMALE(1) = True
#.      - DROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:cf7274ea-f343-149f-f52c-a55807c9297c
msgctxt "h0cc0e2aeg1d81g4344ga976gd4680b77710a"
msgid "Not your concern. Hand over your research - I'll take over from here."
msgstr "네가 걱정할 바는 아니야. 네 연구자료를 넘겨, 이제 내가 맡을 테니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = d09f6ba9-b295-db59-f5d1-485bd034b2d4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_PetrifiedDrow_HasMet_Wizard(1) = True
#.   Object:
#.      - UND_PetrifiedDrow_State_SomeOtherDrowPetrified(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:d09f6ba9-b295-db59-f5d1-485bd034b2d4
msgctxt "hba8036b9gf96eg4e01gb155ga1f31b69a954"
msgid ""
"Away. I must gather my strength and free my companions here. I'm not going "
"to carry my <i>own</i> luggage."
msgstr "저리 가세요. 제 힘을 모아 여기서 내 동료들을 구해야 하니. 제 <i>소유</i>의 화물을 직접 들고 갈 순 없지 않습니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Player
#. NodeID = d1217d6a-1a2b-e423-f73a-c82213002aaa
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DROWELF and FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:d1217d6a-1a2b-e423-f73a-c82213002aaa
msgctxt "hc2d9d4c6g46b9g4bf9g8f0agc5084594c316"
msgid "Accustomed to a little more respect from a male."
msgstr "남성에게선 조금 더 존중받는 편이 익숙한데 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Player
#. NodeID = d272a02d-fb49-b7b2-796a-30a6b052cc61
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:d272a02d-fb49-b7b2-796a-30a6b052cc61
msgctxt "hc85755a3g06e3g4287ga4f4gca9b68e38a28"
msgid "I haven't the slightest idea what you're talking about."
msgstr "당신이 무슨 이야기를 하는 건지 전혀 모르겠군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = d43b52ce-c985-a5bc-b3bb-2d2a5ffefeaa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:d43b52ce-c985-a5bc-b3bb-2d2a5ffefeaa
msgctxt "h4ac27705g924fg4bfag97bagd19c5b69abdc"
msgid ""
"If they had just surrendered their research to me, we might have found the "
"forge together."
msgstr "그냥 자신들이 가진 연구 결과를 내게 넘기기만 했다면, 함께 대장간을 찾을 수 있었을 텐데 말이죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = d6eb7366-2c8a-1fcf-71cd-e3235c4f739b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - UND_PetrifiedDrow_Wizard_ToldHimHouseNeedsHim(1) = True
#.   Global:
#.     - UND_PetrifiedDrow_State_PeacefulResolution = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:d6eb7366-2c8a-1fcf-71cd-e3235c4f739b
msgctxt "h67788893ge9cfg425ag8f55g5469122d4fa0"
msgid ""
"Just an... aspiration, mistress. But if my house now has room to honour me "
"as I deserve, I have no need to chase relics any longer."
msgstr ""
"그냥... 제 야망을 나타낼 뿐입니다, 아가씨. 하지만 집안에 제가 누릴 영광이 생겼으니, 더 이상 유물이나 찾아다닐 필요는 없겠죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = d730f11b-a007-d1f2-5ed9-e35298d4a6c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:d730f11b-a007-d1f2-5ed9-e35298d4a6c6
msgctxt "h3d7b46b2gb9d8g4719g8c72g18cbbd538e73"
msgid ""
"Does it? Then I'll be sure to give my telling a little polish for the "
"history books."
msgstr "그런가요? 그럼 역사책에 실릴 내 이야기에 약간의 각색을 해두겠습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = d7603866-104c-e988-2029-204de72fc835
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:d7603866-104c-e988-2029-204de72fc835
msgctxt "h57ff2651g1506g46cag970eg015b952261fa"
msgid ""
"A little too clever. I'd rather not lose one rival only to have another "
"sprout in his place."
msgstr "하지만 지나치게 영리했어. 이제 막 경쟁자 하나를 제꼈는데, 또 다른 경쟁자를 만들 순 없지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = d8f47daa-8737-6a86-38bd-a15948cb11f9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_PetrifiedDrow_State_HasMap(0) = True
#. SetFlags:
#.   Global:
#.     - UND_PetrifiedDrow_Wizard_Event_GaveCrystal = True
#.     - UND_PetrifiedDrow_State_PeacefulResolution = True
#.     - UND_PetrifiedDrow_Knows_PassPhrase = True
#.   Object:
#.     - UND_PetrifiedDrow_Event_GiveMap(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:d8f47daa-8737-6a86-38bd-a15948cb11f9
msgctxt "h5215e4c3gf345g4167gaaeagbf23fbf66ecd"
msgid ""
"Take the shard, then - it holds the location of the lost Adamantine Forge. "
"It answers to the pass-phrase <i>'Dhourn, Lord Archmage'.</i>"
msgstr ""
"그 조각을 가져가세요. 거기엔 잃어버린 아다만틴 대장간의 위치가 담겨 있습니다. <i>'로드 아크메이지, 도운'</i> 이라는 암호에 "
"응답할 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = dbbcd97e-a0fd-fe19-e402-588444ea7d3a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:dbbcd97e-a0fd-fe19-e402-588444ea7d3a
msgctxt "hc255ad24gbcb0g4c31gb3aag9970b6ddcd9d"
msgid ""
"<i>Rescue.</i> Helpless babes are rescued. <i>I</i> allowed you to assist me."
msgstr "<i>구조라.</i> 어린 아이들이나 구조되는 거죠. 이건 <i>내가</i> 당신이 날 도와줄 수 있도록 허가한 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = ea0adb57-9668-f4bc-201a-fa700b31c607
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:ea0adb57-9668-f4bc-201a-fa700b31c607
msgctxt "ha203dad7g892cg4445g8b69g5f6432214a98"
msgid ""
"I had the good sense to lock mine away in the memory shard. And now I can "
"claim the forge alone."
msgstr "내 좋은 감으로 정보를 기억 조각에 저장해 놓길 다행이군요. 이제 나 혼자서 대장간을 차지하게 될 테니 말이죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = eaaaec53-9904-7966-80f6-a9a427d92a9e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:eaaaec53-9904-7966-80f6-a9a427d92a9e
msgctxt "ha7a0bf5agdabag40dbga09cgd0fc3d55f9c9"
msgid "You <i>bloody</i> well -"
msgstr "이런 <i>빌어먹을</i> -"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Player
#. NodeID = f1afc305-e5fe-31b5-1c48-5ff0ddf7e8d7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidDrowDead_State_ToldFurnaceSearch = False
#.      - UND_FurnaceSearch_Knows_Xargrim = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:f1afc305-e5fe-31b5-1c48-5ff0ddf7e8d7
msgctxt "h66695866gb02eg4c25ga2a3g22c77e8d9c07"
msgid "Xargrim's dead. His body's rotting in a myconid circle."
msgstr "자그림은 죽었어요. 그의 신체는 마이코니드 군락에서 썩어가고 있죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = f25175c8-24e2-aef7-9a9e-c16f7da76f81
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:f25175c8-24e2-aef7-9a9e-c16f7da76f81
msgctxt "hc4b22b97g61c2g408fg8c22g352a063fa51d"
msgid ""
"Well. I have some business I am <i>long </i>overdue in completing, and I'm "
"sure you have... something to do."
msgstr ""
"글쎄요. 저는 완료하기엔 너무 <i>오래 지난</i> 몇 가지 일을 갖고 있고, 당신도... 무언가 해야 할 게 있다고 확신해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Petrified Drow
#. NodeID = f6233304-2c06-afdf-9ab6-ac439d660009
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_PetrifiedDrow_HasMet_Wizard(1) = True
#.   Global:
#.      - UND_PetrifiedDrow_Wizard_Event_GaveCrystal = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:f6233304-2c06-afdf-9ab6-ac439d660009
msgctxt "h229870a6g9243g4c2eg92fcgbfd37bad222e"
msgid ""
"Respectfully - you have already taken my life's work. What else could you "
"possibly need?"
msgstr "정중히 말씀드리지만, 당신이 이미 제 평생의 업적을 가져가셨습니다. 더 이상 뭐가 필요하신가요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Player
#. NodeID = fbf56a71-e4f3-8ec1-ef75-679a2a133f83
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:fbf56a71-e4f3-8ec1-ef75-679a2a133f83
msgctxt "ha368def0g1849g497eg917eg2247c8f790d8"
msgid "'Alone'? Don't you still need your rivals' research?"
msgstr "'혼자서'? 아직 당신 경쟁자들의 정보가 필요한 거 아닌가요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard
#. Speaker = Player
#. NodeID = fe34cff5-a0b7-52eb-d7d8-c65360a26f92
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Wizard:fe34cff5-a0b7-52eb-d7d8-c65360a26f92
msgctxt "ha76b3c6eg31c6g4279gb5d7g1f26398bf216"
msgid ""
"I'm [GEN_PlayerName_c11eee1e-7815-6143-7233-f2427799fa53]. You're welcome "
"for the rescue."
msgstr ""
"난 [GEN_PlayerName_c11eee1e-7815-6143-7233-f2427799fa53](이)라고 해요. 구조해 줘서 고맙다는 "
"인사는 됐어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ScryingEye
#. Speaker = Narrator
#. NodeID = 3c8f25b3-e355-248a-21f6-78677814b759
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_ScryingEye_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - UND_ScryingEye_HasMet(1) = True
#.   Global:
#.     - UND_ScryingEye_State_Encountered = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ScryingEye:3c8f25b3-e355-248a-21f6-78677814b759
msgctxt "h44574fa2gf2d3g4eddg9e51g6fe8080fc53a"
msgid "*You stare into the eye. Your reflection stares back.*"
msgstr "*당신은 이 눈을 응시합니다. 표면에 비친 당신의 시선으로 돌아옵니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ScryingEye
#. Speaker = Narrator
#. NodeID = 4728fb98-e6b3-323b-65aa-27d9dc51d4b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ScryingEye:4728fb98-e6b3-323b-65aa-27d9dc51d4b6
msgctxt "h0ddc0a3eg3a69g4ec9g95cbg218069a08618"
msgid "*The scrying eye doesn't blink.*"
msgstr "*감시하는 수정구는 깜빡이지도 않습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ScryingEye
#. Speaker = Player
#. NodeID = 55daf404-e754-3dfd-67b2-39aa6f5f4670
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - UND_ScryingEye_Event_AttackEye(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ScryingEye:55daf404-e754-3dfd-67b2-39aa6f5f4670
msgctxt "hbb83c722g7fb2g4918g8f5ag120632158686"
msgid "<i>Attack the eye.</i>"
msgstr "<i>수정구를 공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ScryingEye
#. Speaker = Narrator
#. NodeID = 59739f4e-982c-bb0e-1c0f-180cf62f97df
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ScryingEye:59739f4e-982c-bb0e-1c0f-180cf62f97df
msgctxt "ha35deae9g04a3g4021gba28gc343835f2580"
msgid "*The eye is unbothered by your prodding.*"
msgstr "*당신이 찔러봐도 눈은 신경 쓰지 않습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ScryingEye
#. Speaker = Player
#. NodeID = 8374f50e-c1fa-a2cf-3a5d-21a843de27dd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 6a836085-25f1-8cb8-5ac9-c63bedbaf73d_ScryingEyeAttitude = False
#. SetFlags:
#.   Local:
#.     - 6a836085-25f1-8cb8-5ac9-c63bedbaf73d_ScryingEyeAttitude = True
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ScryingEye:8374f50e-c1fa-a2cf-3a5d-21a843de27dd
msgctxt "h6162c0ebg85b5g4712g911eg3cef7eb55f18"
msgid "<i>Give it your meanest glare.</i>"
msgstr "<i>최대한 심술궂게 노려본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ScryingEye
#. Speaker = Player
#. NodeID = 8374f50e-c1fa-a2cf-3a5d-21a843de27dd
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 6a836085-25f1-8cb8-5ac9-c63bedbaf73d_ScryingEyeAttitude = False
#. SetFlags:
#.   Local:
#.     - 6a836085-25f1-8cb8-5ac9-c63bedbaf73d_ScryingEyeAttitude = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ScryingEye:8374f50e-c1fa-a2cf-3a5d-21a843de27dd
msgctxt "h08d304e0ged26g415bg8433g221691857a45"
msgid "<i>Smile and wave.</i>"
msgstr "<i>미소 지으며 손을 흔든다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ScryingEye
#. Speaker = Player
#. NodeID = 974d04d3-969c-2d4e-1488-d5152ff5f873
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 6a836085-25f1-8cb8-5ac9-c63bedbaf73d_ScryingEyeAttitude = False
#. SetFlags:
#.   Local:
#.     - 6a836085-25f1-8cb8-5ac9-c63bedbaf73d_ScryingEyeAttitude = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ScryingEye:974d04d3-969c-2d4e-1488-d5152ff5f873
msgctxt "h24bf8226g29c3g4bb4g9957ge25cbe1e29ed"
msgid "<i>Poke the eye.</i>"
msgstr "<i>눈을 찔러본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ScryingEye
#. Speaker = Player
#. NodeID = 997ac3c5-0ca7-c6e8-55b0-c384ca5fc5d7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ScryingEye:997ac3c5-0ca7-c6e8-55b0-c384ca5fc5d7
msgctxt "hddb433d0g1dd3g4878gbc2cgdf6c21644e75"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ScryingEye
#. Speaker = Narrator
#. NodeID = bbce7b21-a0af-5dfa-1046-1e5c50c410e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ScryingEye:bbce7b21-a0af-5dfa-1046-1e5c50c410e7
msgctxt "hd43b2a3eg9f82g425agb640gcf3de9211b3f"
msgid ""
"*The longer you stare, the more uneasy you feel. There is a presence. You "
"are <i>seen</i>.*"
msgstr "*더 오래 응시할수록, 불편한 감각이 커집니다. 존재감이 느껴집니다. 누군가 <i>지켜보고</i> 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ScryingEye
#. Speaker = Player
#. NodeID = c0996a54-d801-d5c1-a660-4a008193c178
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 6a836085-25f1-8cb8-5ac9-c63bedbaf73d_ScryingEyeAttitude = False
#. SetFlags:
#.   Local:
#.     - 6a836085-25f1-8cb8-5ac9-c63bedbaf73d_ScryingEyeAttitude = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ScryingEye:c0996a54-d801-d5c1-a660-4a008193c178
msgctxt "hef0e6237ge1a9g4563gae55g326a9c19a18b"
msgid "<i>Reach out to the presence.</i>"
msgstr "<i>물체에 접근한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ScryingEye
#. Speaker = Narrator
#. NodeID = c1ad5a27-cc7c-a2a5-d5a3-f75468e188f1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_ScryingEye_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ScryingEye:c1ad5a27-cc7c-a2a5-d5a3-f75468e188f1
msgctxt "hcef4525fg5a0eg4fcdg9bc6g041627d9dd00"
msgid "*The scrying eye seems oblivious to you.*"
msgstr "*미래를 보는 눈은 당신에게 관심이 없는 듯 보입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ScryingEye
#. Speaker = Narrator
#. NodeID = da6d7da9-67d2-7af8-428e-d13eaf39fcb4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_ScryingEyes_State_FeltGaze = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ScryingEye:da6d7da9-67d2-7af8-428e-d13eaf39fcb4
msgctxt "h8686c4a5g0fb5g4239g9d7eg11aad8645b55"
msgid ""
"*Your consciousness surges into the orb. First there is blackness - then a "
"pair of unblinking, red eyes.*"
msgstr "*당신의 의식이 보주로 말려 들어갑니다. 처음엔 어둠만이 있다가 - 깜빡이지 않는 한 쌍의 붉은 눈이 나타납니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ScryingEye
#. Speaker = Narrator
#. NodeID = ebf88b0c-7899-bd02-277a-f38b43254815
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ScryingEye:ebf88b0c-7899-bd02-277a-f38b43254815
msgctxt "hc6e99496g9a9dg4e69g87a0g2ce45d87e6ac"
msgid ""
"*Pain grips your skull as the eyes stare into you - then look away. The "
"connection is broken.*"
msgstr "*눈이 당신을 꿰뚫어보자 두개골이 고통으로 뒤흔들리다가, 눈길이 사라지자 연결이 끊깁니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Underdark/UND_Shadowheart_PAD_RefuseNobleStalk
#. Speaker = Shadowheart
#. NodeID = a6337ba2-e071-4516-96aa-bf6f3eff64ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Underdark/UND_Shadowheart_PAD_RefuseNobleStalk:a6337ba2-e071-4516-96aa-bf6f3eff64ea
msgctxt "h515a4e0bg7ad6g48a1ga241g3cf57143eaa1"
msgid ""
"Eating strange mushrooms can be dangerous, you know. At least let's talk "
"about it first..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Underdark/UND_Shadowheart_PAD_NobleStalk
#. Speaker = Shadowheart
#. NodeID = fe9894f0-13a6-4d6e-8188-9451b2f65478
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_State_NobleStalkMemory = True
#: Mods/GustavDev/Story/Dialogs/Act1/Underdark/UND_Shadowheart_PAD_NobleStalk:fe9894f0-13a6-4d6e-8188-9451b2f65478
msgctxt "hfc2f7e77g2477g44cbg9a7ega8ff356b0841"
msgid ""
"Strange... I remember a tiefling boy. Purple hair... <i>Rennald</i>. Who is "
"that?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Underdark/UND_Shadowheart_PAD_RefuseNobleStalk
#. Speaker = Shadowheart
#. NodeID = a0826fc4-9b32-4873-8552-4e0ac3863073
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - AVATAR(0) = True
#: Mods/GustavDev/Story/Dialogs/Act1/Underdark/UND_Shadowheart_PAD_RefuseNobleStalk:a0826fc4-9b32-4873-8552-4e0ac3863073
msgctxt "h35b0f485g8566g4264g951cg290eea67199f"
msgid "Hardly the time for a repast. Later, maybe..."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SharranTargetPractice_PAD
#. Speaker = Player
#. NodeID = 39130467-3115-416a-98b0-1becc2130b3a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_SharranTargetPractice_HistoryCheckPassed = True
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SharranTargetPractice_PAD:39130467-3115-416a-98b0-1becc2130b3a
msgctxt "h220531a4g4922g49a6g9b3eg85b32d6e2627"
msgid "No duergar made this. The design looks Sharran..."
msgstr "듀에르가가 이걸 만들었을 리가 없어. 샤 숭배자들의 양식 같은데..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SharranTargetPractice_PAD
#. Speaker = Player
#. NodeID = 39130467-3115-416a-98b0-1becc2130b3a
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_SharranTargetPractice_HistoryCheckPassed = True
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SharranTargetPractice_PAD:39130467-3115-416a-98b0-1becc2130b3a
msgctxt "h6ff80b6agdb06g48f4ga294g9fb6a23a22cf"
msgid ""
"This crossbow was exquisitely designed. No duergar crafted this... its dark "
"grace is most definitely Sharran in origin."
msgstr "이 쇠뇌는 아주 정교하게 만들어졌어. 듀에르가의 작품이 아니군... 이 어두운 은총은 샤 숭배자들의 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SharranTargetPractice_PAD
#. Speaker = Player
#. NodeID = 39130467-3115-416a-98b0-1becc2130b3a
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_SharranTargetPractice_HistoryCheckPassed = True
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SharranTargetPractice_PAD:39130467-3115-416a-98b0-1becc2130b3a
msgctxt "h174a2cabgfca8g4832g86d0gd57b17109b4e"
msgid ""
"Wow, what a crossbow. Looks more Sharran than duergar, if I know my weapons."
msgstr "우와, 멋진 크로스보우군. 내가 맞다면 이건 듀에르가들 보다는 샤의 신도들이 사용하는 양식 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SharranTargetPractice_PAD
#. Speaker = Player
#. NodeID = 39130467-3115-416a-98b0-1becc2130b3a
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_SharranTargetPractice_HistoryCheckPassed = True
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SharranTargetPractice_PAD:39130467-3115-416a-98b0-1becc2130b3a
msgctxt "h24379bbag167bg4ef0gbf2bgada2b9c6cd2f"
msgid ""
"Hardy but graceful - a fine crossbow. Made by Sharran hands, if my teachings "
"keep true."
msgstr "강인하면서도 우아하군, 훌륭한 쇠뇌야. 내 지식이 정확하다면 샤 숭배자들의 작품 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SharranTargetPractice_PAD
#. Speaker = Player
#. NodeID = 39130467-3115-416a-98b0-1becc2130b3a
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_SharranTargetPractice_HistoryCheckPassed = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SharranTargetPractice_PAD:39130467-3115-416a-98b0-1becc2130b3a
msgctxt "h43366fc3gdfb1g4b5cg8fadged13bd672bb4"
msgid "Not a duergar design... this crossbow is meant for a warrior of Shar."
msgstr "듀에르가의 양식이 아니야... 이 쇠뇌는 샤를 따르는 전사의 것이었군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SharranTargetPractice_PAD
#. Speaker = Player
#. NodeID = 39130467-3115-416a-98b0-1becc2130b3a
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_SharranTargetPractice_HistoryCheckPassed = True
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SharranTargetPractice_PAD:39130467-3115-416a-98b0-1becc2130b3a
msgctxt "ha668b2fcgf582g40e7g8191ge89c57c86d3f"
msgid "Remarkable crossbow. Sharran-made, if I'm not mistaken."
msgstr "아주 훌륭한 쇠뇌야. 잘못 본 게 아니라면 샤 숭배자의 작품인 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SharranTargetPractice_PAD
#. Speaker = Player
#. NodeID = 39130467-3115-416a-98b0-1becc2130b3a
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_SharranTargetPractice_HistoryCheckPassed = True
#. TagRule: CLERIC_SHAR or PALADIN_SHAR
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SharranTargetPractice_PAD:39130467-3115-416a-98b0-1becc2130b3a
msgctxt "hf099d2b1g84f4g4e78ga24fg4c43e897d1a0"
msgid "A Sharran crossbow. As magnificent as the Dark Lady herself."
msgstr "샤 숭배자의 쇠뇌야. 어둠의 여인 본인 만큼이나 아름답군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SharranTargetPractice_PAD
#. Speaker = Player
#. NodeID = 39130467-3115-416a-98b0-1becc2130b3a
#. HandlePath = TaggedText[7].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_SharranTargetPractice_HistoryCheckPassed = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SharranTargetPractice_PAD:39130467-3115-416a-98b0-1becc2130b3a
msgctxt "h02d6b42bgac7ag4235g8033ge94b9c524da6"
msgid "I know this design - Shar's faithful wield crossbows like these."
msgstr "익숙한 형태야. 샤 신도들이 이런 쇠뇌를 사용하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SharranTargetPractice_PAD
#. Speaker = Player
#. NodeID = 681f3ffa-d0e5-4e35-881e-2ed07ff29852
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SharranTargetPractice_PAD:681f3ffa-d0e5-4e35-881e-2ed07ff29852
msgctxt "h8085502eg8c16g4081ga8a6g302f736ab9c7"
msgid "Oh this is far too nice to be duergar-made."
msgstr "이건 듀에르가가 만들었다기엔 너무 훌륭한데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SharranTargetPractice_PAD
#. Speaker = Player
#. NodeID = 681f3ffa-d0e5-4e35-881e-2ed07ff29852
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SharranTargetPractice_PAD:681f3ffa-d0e5-4e35-881e-2ed07ff29852
msgctxt "h04237d9bg4571g478dgb3dbg8797f11e5df2"
msgid ""
"This crossbow was exquisitely designed. No duergar crafted it, that much is "
"obvious."
msgstr "이 쇠뇌는 아주 정교하고 우아하게 만들어졌어. 확실한 건, 듀에르가의 작품은 아니군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SharranTargetPractice_PAD
#. Speaker = Player
#. NodeID = 681f3ffa-d0e5-4e35-881e-2ed07ff29852
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SharranTargetPractice_PAD:681f3ffa-d0e5-4e35-881e-2ed07ff29852
msgctxt "h307c4362g87fdg4cd8ga7f0g39db698a4154"
msgid "Nice crossbow. Doesn't look like grey dwarf work."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SharranTargetPractice_PAD
#. Speaker = Player
#. NodeID = 681f3ffa-d0e5-4e35-881e-2ed07ff29852
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SharranTargetPractice_PAD:681f3ffa-d0e5-4e35-881e-2ed07ff29852
msgctxt "h4a79b1c8g983dg4b1bg8067g5d2ef00e3c5f"
msgid ""
"Graceful, powerful. I could ask no more of a crossbow. Are the duergar so "
"capable?"
msgstr "우아하고, 강력하군. 이보다 좋은 쇠뇌를 찾기도 힘들겠어. 듀에르가가 이런 걸 만들 수 있었나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SharranTargetPractice_PAD
#. Speaker = Player
#. NodeID = 681f3ffa-d0e5-4e35-881e-2ed07ff29852
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SharranTargetPractice_PAD:681f3ffa-d0e5-4e35-881e-2ed07ff29852
msgctxt "ha21766fcg8c08g4d6fgaf3cg6310689a95cb"
msgid "A fine crossbow. Too fine to be duergar-made."
msgstr "훌륭한 쇠뇌야. 듀에르가가 만들었다기엔 과하군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SharranTargetPractice_PAD
#. Speaker = Player
#. NodeID = 681f3ffa-d0e5-4e35-881e-2ed07ff29852
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SharranTargetPractice_PAD:681f3ffa-d0e5-4e35-881e-2ed07ff29852
#, fuzzy
msgctxt "hfafdc5c2gef62g4080gab77gafce34820b70"
msgid "Magnificent bow. Not of duergar make, I wager."
msgstr "엄청난 활이야, 칼날에게 어울리는군. 듀에르가가 만든 것 같진 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SharranTargetPractice_PAD
