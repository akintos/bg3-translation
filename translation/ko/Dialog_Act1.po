msgctxt "h8ec69468g60ffg4767gb74dg2788a049e90b"
msgid ""
"*Your wicked heart won't mourn. Deaths are to be celebrated. Every one.*\n"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted_Solo
