#.     - 9d5fb485-8f36-c21b-52d1-c92a1ce047de_Local_Idle_B = False
#.     - 9d5fb485-8f36-c21b-52d1-c92a1ce047de_Local_Idle_A = False
#.     - 9d5fb485-8f36-c21b-52d1-c92a1ce047de_Local_Idle_C = False
