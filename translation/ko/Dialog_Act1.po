#. CheckFlags:
#.   Global:
#.      - DEN_CapturedGoblin_State_GoblinMentionedAbsolute = True
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = False
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene:5e81c637-f22d-8d6d-83ba-2d7406ec2768
msgctxt "h9feb84e0g7a9dg4ce5gaeabgf2066dc51b04"
msgid "The Absolute, eh? Same name that goblin Sazza mentioned."
msgstr "절대자라? 고블린 삿자가 언급했던 이름과 똑같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene
#. Speaker = Player
#. NodeID = 5e81c637-f22d-8d6d-83ba-2d7406ec2768
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_CapturedGoblin_State_GoblinMentionedAbsolute = True
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene:5e81c637-f22d-8d6d-83ba-2d7406ec2768
msgctxt "hdd1be9a1g74d7g4436gb918g8f96f0e45c27"
msgid "They spoke of the Absolute - same as that goblin, Sazza. Curious."
msgstr "절대자에 대해 언급했어, 고블린 삿자가 말했던 신과 같은 이름이군. 흥미로워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_VB_DiscoverPriests
#. Speaker = Player
#. NodeID = 6eedbcb8-61af-131e-7a33-5bca63128a18
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_VB_DiscoverPriests:6eedbcb8-61af-131e-7a33-5bca63128a18
msgctxt "ha607824dg93f4g4759g9545g7da0c9a54d33"
msgid "People up ahead. Something's wrong..."
msgstr "앞에 사람들이 있어. 뭔가 잘못된 것 같은데..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGods_VB_OwlBearPrints
#. Speaker = Player
#. NodeID = 73adc0b0-bd9b-2093-e053-40046b52a64d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WLD_PriestsOfTheConqueringGods_OwlBearPrints_PassedCheck = False
#. SetFlags:
#.   Party:
#.     - WLD_PriestsOfTheConqueringGods_OwlBearPrints_UsedPrints(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGods_VB_OwlBearPrints:73adc0b0-bd9b-2093-e053-40046b52a64d
msgctxt "h255c3c43g1348g49fbg9c7eg6962d25f6ffa"
msgid "Looks like a beast came through here - a big one too."
msgstr "야수가 지나간 흔적인 것 같은데. 아주 큰 놈이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGods_VB_OwlBearPrints
#. Speaker = Player
#. NodeID = c3c647c9-2abb-46a7-1f36-95c997bbb992
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - WLD_PriestsOfTheConqueringGods_OwlBearPrints_PassedCheck = True
#. SetFlags:
#.   Party:
#.     - WLD_PriestsOfTheConqueringGods_OwlBearPrints_UsedPrints(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGods_VB_OwlBearPrints:c3c647c9-2abb-46a7-1f36-95c997bbb992
msgctxt "hddca072egbe0bg4b04gb904g11a5f0b02dc6"
msgid "Owlbear tracks. Its nest must be nearby."
msgstr "아울베어 흔적이야. 근처에 있는 게 분명해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Lump the Enlightened
#. NodeID = 0012af53-d085-8ef9-0be6-dc601a54e13c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:0012af53-d085-8ef9-0be6-dc601a54e13c
msgctxt "hf8a4c359g35d6g4654ga811gd80c8ac63d43"
msgid "Unh. <i>Dissatisfying.</i>"
msgstr "어허. <i>실망스럽군요.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Lump the Enlightened
#. NodeID = 04f53ad6-2ec2-f148-4879-c32400edaa9e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - c2212640-3b30-8873-1471-458bd88e8688_PassedCheck = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:04f53ad6-2ec2-f148-4879-c32400edaa9e
msgctxt "he89a590dg31c2g4e1fg862fga0bfaeab1c4a"
msgid "...and you, a delicacy - were I so lucky."
msgstr "...당신은 미식이겠죠. 제가 운만 좋았더라면."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Lump the Enlightened
#. NodeID = 08143da5-a17c-d0ed-4bfb-8e19c2b9041a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:08143da5-a17c-d0ed-4bfb-8e19c2b9041a
msgctxt "h22fbeb91g266bg47d9gb10agad8bdbe6b23e"
msgid ""
"Stranger: be you friend or food? The mark is Her measure: show us the brand "
"of the Absolute."
msgstr "낯선 이여. 당신은 친구입니까, 음식입니까? 표식이 그녀의 척도죠. 절대자의 표식을 보여주세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Lump the Enlightened
#. NodeID = 0cb15cf8-a7d5-16ea-8378-ce9af1d73a13
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_State_OfferedLatePayment = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:0cb15cf8-a7d5-16ea-8378-ce9af1d73a13
msgctxt "h72d88b64g17a2g4bdbg8be0g27cc89a90bcc"
msgid "A twice-played serenade to my ears, my tasty kibble. We have a bargain!"
msgstr "우리 맛있는 친구분의 말이 마치 꾀꼬리가 지저귀듯 달콤하군요. 거래 성립입니다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Player
#. NodeID = 0f28d8a7-a7de-c534-f472-9f4220bfb989
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToIndivPlayerAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:0f28d8a7-a7de-c534-f472-9f4220bfb989
msgctxt "hd9e820f5gc79cg4780gac2ag81e4039ac1ff"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Lump the Enlightened
#. NodeID = 10a0321c-debd-b611-12ef-5eedf0a0cb7f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:10a0321c-debd-b611-12ef-5eedf0a0cb7f
msgctxt "h59a1dfffg34cbg49a8ga251g6701ab375c9d"
msgid "Now speak or go, before my cravings conquer me."
msgstr "할 말이 없으면 가시죠. 제가 식욕에 굴복하기 전에."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Lump the Enlightened
#. NodeID = 11601e27-931c-1d03-0bce-cc4003da3eb1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:11601e27-931c-1d03-0bce-cc4003da3eb1
msgctxt "h97fbc729gf1a9g495cg8a26g49f0e580ead1"
msgid "I am by all accounts a student of higher commerce and extortion."
msgstr "저는 모든 면에서 상술과 갈취의 대가라고 할 수 있지요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Lump the Enlightened
#. NodeID = 1463854a-1528-d4b6-5e8c-41c8d381649b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_SchoolOgres_State_PassedHasMet = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:1463854a-1528-d4b6-5e8c-41c8d381649b
msgctxt "h3fb11890g4d15g42d8gadf7ga666da266b32"
msgid "Mm. Temptation knocks."
msgstr "음. 유혹이 문을 두드리는군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Lump the Enlightened
#. NodeID = 16017e54-5611-07a1-b9b1-e67a98f59ea1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToIndivPlayerAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:16017e54-5611-07a1-b9b1-e67a98f59ea1
msgctxt "hdfa62c45gff28g4a26gb698g02052370b921"
msgid "<i>Dinnertime!</i>"
msgstr "<i>저녁 시간이다!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Player
#. NodeID = 17272eeb-36db-634c-5f9d-6d14619d8412
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_SchoolOgres_Knows_AskedBoss(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:17272eeb-36db-634c-5f9d-6d14619d8412
msgctxt "h8e2ba48ag7c3bg4a0fg848dg11b5e6b61461"
msgid "I notice you don't bear a brand of your own."
msgstr "너는 표식이 없는 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Player
#. NodeID = 195a5954-3225-684f-eb2a-40fb7ce3f0ca
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_SchoolOgres_Knows_AskedSpeech(1) = False
#. SetFlags:
#.   Dialog:
#.     - FOR_SchoolOgres_Knows_AskedSpeech(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:195a5954-3225-684f-eb2a-40fb7ce3f0ca
msgctxt "h7a0c1e41ge182g45d4ga908g6e9e07ce976a"
msgid "You're rather well-spoken for one of your kind."
msgstr "너희 종족답지 않게 말을 잘 하는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Player
#. NodeID = 197265b2-5f18-e61a-2da8-0c6a338b12c5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_SchoolOgres_Knows_AskedBoss(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:197265b2-5f18-e61a-2da8-0c6a338b12c5
msgctxt "h0308be69g3556g4634gb4f6ge0078fa71b3b"
msgid "Forget the goblins - why not work for me instead?"
msgstr "고블린은 됐고, 그냥 내 밑에서 일하는 게 어때?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Lump the Enlightened
#. NodeID = 1c43c66c-aa62-105e-d889-11a191c97483
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:1c43c66c-aa62-105e-d889-11a191c97483
msgctxt "h7f8828a1gec85g4006gad45g9e785916b55c"
msgid ""
"I've no use for the Absolute - or any god. I follow two masters only: "
"gluttony and greed."
msgstr "저에겐 절대자도, 다른 신도 필요가 없습니다. 전 식욕과 탐욕이라는 두 주인만을 섬기니까요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Player
#. NodeID = 273837db-8a2f-48a7-2f29-78db02d52277
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Dialog:
#.      - FOR_SchoolOgres_Event_AttemptedFirstSkillCheck(1) = True
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:273837db-8a2f-48a7-2f29-78db02d52277
msgctxt "h35b0a4a2g4b89g40fcg8d7bg2b37371b0688"
msgid "I'm not your friend, and I'm not food. <b>Back off.</b>"
msgstr "난 네 친구도 아니고, 음식도 아니야. <b>물러서.</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Lump the Enlightened
#. NodeID = 2a216ef1-601d-02ce-a22f-238933e1c334
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:2a216ef1-601d-02ce-a22f-238933e1c334
msgctxt "h40258987gd3b5g401cg8691gbd63c7877216"
msgid "I will keep close. When you are ready, sound the horn."
msgstr "근처에 있겠습니다. 때가 되면 뿔나팔을 부세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Lump the Enlightened
#. NodeID = 2b2baae5-b961-7135-e9aa-4d503594e090
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_Knows_FailedPersuade = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:2b2baae5-b961-7135-e9aa-4d503594e090
msgctxt "hbf7468aag6115g4335ga378gb5b52cfd3953"
msgid "A slip of the tongue - you meant to make a better offer, surely."
msgstr "말실수를 했군요. 분명 더 나은 제안을 하려 했던 것이겠지요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Player
#. NodeID = 35a16e7d-5afa-19fd-ffff-87fbb350290d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Dialog:
#.      - FOR_SchoolOgres_Knows_AskedBoss(1) = True
#.      - FOR_SchoolOgres_Knows_TeasedOgre(1) = False
#.   Global:
#.      - FOR_SchoolOgres_Knows_FailedPersuade = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:35a16e7d-5afa-19fd-ffff-87fbb350290d
msgctxt "hd8c96c7fgdb4eg4e7fga5b6g46d8f0cf0772"
msgid ""
"I'll give you [463b0f43-5410-412d-aba3-875cf81c38ca] gold - <i>after</i> you "
"fight for me."
msgstr ""
"[463b0f43-5410-412d-aba3-875cf81c38ca] 골드를 주겠다. <i>단</i> 날 위해 <i>먼저</i> 싸우고 "
"나서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Lump the Enlightened
#. NodeID = 38dd925f-22e4-7e5c-742d-aeac30205d97
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:38dd925f-22e4-7e5c-742d-aeac30205d97
msgctxt "hb905c516ga368g459bga121gaf06ce839cdc"
msgid ""
"Am I not astonishing? A robust diet makes for a shrewd mind, you see. I am a "
"<i>gourmand...</i>"
msgstr "감탄스럽지 않습니까? 왕성한 식단이 영리한 정신을 이루는 법이지요. <i>저는 대식가랍니다...</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Player
#. NodeID = 3cac6300-7ae5-4a43-024d-0489c4dc8068
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Dialog:
#.      - FOR_SchoolOgres_Knows_AskedBoss(1) = True
#.      - FOR_SchoolOgres_Knows_TeasedOgre(1) = True
#.   Global:
#.      - FOR_SchoolOgres_Knows_FailedPersuade = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:3cac6300-7ae5-4a43-024d-0489c4dc8068
msgctxt "h791893c3g68d5g4388gb855gf0c79586ba96"
msgid "I'll pay you in the flesh of the fallen - you'll have your fill."
msgstr "대가는 죽은 자들의 고기로 지불하지. 네 배를 채울 수 있잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Lump the Enlightened
#. NodeID = 3df2d41e-0619-f370-f88e-dc53e457d913
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = False
#. SetFlags:
#.   Local:
#.     - c2212640-3b30-8873-1471-458bd88e8688_PassedCheck = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:3df2d41e-0619-f370-f88e-dc53e457d913
msgctxt "h23c58bc6g490eg431aga04eg444310b2d1a7"
msgid "Indeed? How regrettable, that your meat must go unsavoured."
msgstr "정말인가? 안타깝군요. 당신의 고기를 음미할 수 없다니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Lump the Enlightened
#. NodeID = 411656b1-275e-2352-19a5-193e865f78ca
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - FOR_SchoolOgres_Knows_TeasedOgre(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:411656b1-275e-2352-19a5-193e865f78ca
msgctxt "hc3c46a55g0ee6g4fb3ga37ag06a5bd6e0c5e"
msgid "Unh. You <i>wound</i> me, creature. I can hardly resist you."
msgstr "아아. 당신은 내 마음에 상처를 입히는군요. 저항하기 참 어렵군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Player
#. NodeID = 41808e8c-10f0-8d36-cfc9-fd538e7c58ba
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_SchoolOgres_Knows_AskedBoss(1) = True
#.      - FOR_SchoolOgres_Knows_TeasedOgre(1) = True
#.   Global:
#.      - FOR_SchoolOgres_Knows_FailedPersuade = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:41808e8c-10f0-8d36-cfc9-fd538e7c58ba
msgctxt "haf2b4964g17a4g4765gb112ga995ebfe4130"
msgid ""
"I'll give you [463b0f43-5410-412d-aba3-875cf81c38ca] gold - <i>after</i> you "
"fight for me."
msgstr ""
"[463b0f43-5410-412d-aba3-875cf81c38ca] 골드를 주겠다. <i>단</i> 날 위해 <i>먼저</i> 싸우고 "
"나서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Player
#. NodeID = 4207a94c-321e-bc88-bf0d-17e5507b2669
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:4207a94c-321e-bc88-bf0d-17e5507b2669
msgctxt "hf9c1c618g190fg4937ga6b0ge738c5724d70"
msgid "Even sweeter still."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Lump the Enlightened
#. NodeID = 423267d1-f80d-2f01-bae0-e16835e46132
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - c2212640-3b30-8873-1471-458bd88e8688_FailedCheck = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:423267d1-f80d-2f01-bae0-e16835e46132
msgctxt "hf41c9c6agc63cg49bbg84f7g6901d675a2ba"
msgid "I expect more than your word. Show me your <i>flesh.</i>"
msgstr "그냥 말로는 부족하지요. <i>살갗</i>을 보여주시지요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Player
#. NodeID = 437cb622-401b-33a8-6c9f-1d4dc7c247ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:437cb622-401b-33a8-6c9f-1d4dc7c247ae
msgctxt "hac81dff3g7549g4b3dg8618gaa1c176ac490"
msgid "I'll leave that to your imagination."
msgstr "상상에 맡기지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Lump the Enlightened
#. NodeID = 4ab13392-c56d-c818-7997-846b2b2470f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:4ab13392-c56d-c818-7997-846b2b2470f8
msgctxt "hc6a695a3g1818g4813gb352g5847ef2ef9c7"
msgid ""
"Mm, mm, <i>mm. </i>Fortune favours my belly, for there is no meat more "
"succulent than a stranger's."
msgstr "음, 흠. <i>으음.</i>내 배는 운도 좋군요. 낯선 이의 고기보다 더 환상적인 진미가 없거늘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Lump the Enlightened
#. NodeID = 50cb3841-0dd8-76ce-b2e4-1eac9cf11219
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:50cb3841-0dd8-76ce-b2e4-1eac9cf11219
msgctxt "h42c3cd29g9a80g471egb7ceg796df44de889"
msgid ""
"Tell me, sweet creature: does your flesh taste as honeyed as I could hope "
"for?"
msgstr "귀여운 생물이여, 알려주시지요. 내 바라건대 당신의 살점은 꿀과 같은 맛이 나나요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Player
#. NodeID = 56ceb32d-cccd-bef1-bc16-21b16780c6be
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:56ceb32d-cccd-bef1-bc16-21b16780c6be
msgctxt "h4ea7c20dga5b2g4be6g9941ge2873c0b8b54"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Lump the Enlightened
#. NodeID = 5a3c656a-09b2-4838-3e98-8bb6e8def39d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:5a3c656a-09b2-4838-3e98-8bb6e8def39d
msgctxt "hfecd2d10g6096g45c8g8b6fg54187cd4df93"
msgid "And this land proves particularly... fruitful."
msgstr "그리고 이 땅은 특히나... 풍요롭지요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Lump the Enlightened
#. NodeID = 5fc0e9e5-4f44-a84c-5de0-3f770b46e42c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:5fc0e9e5-4f44-a84c-5de0-3f770b46e42c
msgctxt "h2f13eb9eg86eag4e3fga24ega623cedb1172"
msgid "...and the rest sate my hunger for <i>meat.</i>"
msgstr "...나머지 다른 것들은 제 <i>고기를 향한</i> 갈망을 채워주고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Player
#. NodeID = 632aaa1d-0ba6-d000-c400-8bcb1376377a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BRANDED(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:632aaa1d-0ba6-d000-c400-8bcb1376377a
msgctxt "h8654226fgb3d7g4023gb2f9gf7a3370985f6"
msgid "I bear no such brand."
msgstr "그런 표식은 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Player
#. NodeID = 63805fcb-4738-2e96-6d5c-8fbd7aac572e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BRANDED(1) = True
#. SetFlags:
#.   Local:
#.     - c2212640-3b30-8873-1471-458bd88e8688_PassedCheck = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:63805fcb-4738-2e96-6d5c-8fbd7aac572e
msgctxt "h6b23e791g46c4g4e81gb4beg7141d09277ff"
msgid "<i>Show him your brand.</i>"
msgstr "<i>낙인을 보여준다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Lump the Enlightened
#. NodeID = 6a86e454-dffe-df1c-d4f8-3ada072e63fa
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - c2212640-3b30-8873-1471-458bd88e8688_PassedCheck = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:6a86e454-dffe-df1c-d4f8-3ada072e63fa
msgctxt "h15f98ef6gda0eg4159ga795g771b1a0e0e83"
msgid "Spoken with the confidence only a True Soul could muster!"
msgstr "참된 영혼만이 가질 수 있는 자신감으로 말하시는군요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Lump the Enlightened
#. NodeID = 6d968756-488c-2ddb-481e-2d14703a6be6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - FOR_SchoolOgres_Knows_AskedBoss(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:6d968756-488c-2ddb-481e-2d14703a6be6
msgctxt "h9be6a78bg9276g4ac3g8b90g9d3f8dfa1986"
msgid "The goblins understand my appetites. They sate my hunger for gold..."
msgstr "고블린은 내 식욕을 이해하지요. 황금에 대한 갈망도 채워준답니다..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Lump the Enlightened
#. NodeID = 7108780f-b574-dfad-b0aa-bfb9e07f2518
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:7108780f-b574-dfad-b0aa-bfb9e07f2518
msgctxt "h94f05226g6985g4809g9015gd24be58d50a6"
msgid "Oh, but you <i>do</i> love to tease."
msgstr "아아, 하지만 <i>당신은</i> 애태우는 걸 참으로 좋아하는군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Lump the Enlightened
#. NodeID = 7183d8a0-d500-b9b8-7bdb-fb4807fa0a26
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#. SetFlags:
#.   Local:
#.     - c2212640-3b30-8873-1471-458bd88e8688_PassedCheck = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:7183d8a0-d500-b9b8-7bdb-fb4807fa0a26
msgctxt "h605db9b9g5ea7g4afcgadb4g01e8f51bacfb"
msgid ""
"How regrettable. Tell me, sweet creature: does your flesh taste as honeyed "
"as I could hope for?"
msgstr "안타깝기 그지없어라. 귀여운 생물이여, 알려주시지요. 내 바라건대 당신의 살점은 꿀과 같은 맛이 나나요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Lump the Enlightened
#. NodeID = 7531b0e3-4142-db1d-7948-b99d9a3fc03b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:7531b0e3-4142-db1d-7948-b99d9a3fc03b
msgctxt "h31590907gf200g451cgaa61g3313183a69bb"
msgid "Make an offer. <i>Tempt me.</i>"
msgstr "제안해 보시지요. 절 <i>유혹하란</i> 말입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Lump the Enlightened
#. NodeID = 781a8bc1-8541-3f52-95d6-d45f06f5cbba
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:781a8bc1-8541-3f52-95d6-d45f06f5cbba
msgctxt "hd98a5680ge0cfg46d7g9d6eg610ca5455475"
msgid "Mm - your candour makes you all the more enticing."
msgstr "으흠, 당신의 그 태도 덕분에 더욱 탐스럽게 보이는군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Lump the Enlightened
#. NodeID = 79560640-2286-9144-19be-c6d8632ce820
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_State_PassedHasMet = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:79560640-2286-9144-19be-c6d8632ce820
msgctxt "h9b74bfbcgada8g4f51g8b5cgf3e64ba654a8"
msgid "Alas - not so much as a nibble."
msgstr "아아, 한 입조차 안 되다니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Player
#. NodeID = 847f37e8-bef1-1973-3723-d0e84539b8d7
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 20
#. CheckFlags:
#.   Dialog:
#.      - FOR_SchoolOgres_Knows_AskedBoss(1) = True
#.      - FOR_SchoolOgres_Knows_TeasedOgre(1) = False
#.   Global:
#.      - FOR_SchoolOgres_Knows_FailedPersuade = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:847f37e8-bef1-1973-3723-d0e84539b8d7
msgctxt "h5a5d6814g1afeg4e97g8149g51a34c0e3f5a"
msgid "I'll pay you in the flesh of the fallen - you'll have your fill."
msgstr "대가는 죽은 자들의 고기로 지불하지. 네 배를 채울 수 있잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Lump the Enlightened
#. NodeID = 9611500c-68be-d4a7-84c8-273d0af5f6cc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:9611500c-68be-d4a7-84c8-273d0af5f6cc
msgctxt "ha3372799gca8bg4f52g86c6g57ae5ff41f30"
msgid "Use it when the need arises - and never a moment before."
msgstr "필요할 때 사용하고, 한 순간도 일찍 사용하지 마시지요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Lump the Enlightened
#. NodeID = 97d50d7c-75df-6ce1-f2b9-6997cd1845b2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:97d50d7c-75df-6ce1-f2b9-6997cd1845b2
msgctxt "h83739023gc618g450dga553g53757d6a89db"
msgid ""
"Take my bonehorn. One blow, and... just a moment. It's been thieved - and I "
"know the culprit."
msgstr "내 뿔나팔을 가져가시지요. 한 번 불면... 잠시만, 누군가가 절도해갔군요. 범인이 누군지는 알겠네요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Lump the Enlightened
#. NodeID = a27664bb-c8bc-6eff-7698-44173c8a1ef1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:a27664bb-c8bc-6eff-7698-44173c8a1ef1
msgctxt "haec9016dg5e2eg499cg88dfg8067f198983e"
msgid "I see it. How regrettable, that your meat must go unsavoured."
msgstr "알겠습니다. 당신의 고기를 음미해줄 이가 없다니 참으로 유감이군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Player
#. NodeID = a6323ff5-631c-3905-7a62-8f9a4094ee78
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_SchoolOgres_Knows_AskedBoss(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:a6323ff5-631c-3905-7a62-8f9a4094ee78
msgctxt "he9f2256dg946cg472egbb7eg19bd50e8559b"
msgid "Would you like to work for me?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Lump the Enlightened
#. NodeID = b37ee926-8176-48e6-eba6-e1739fe34502
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:b37ee926-8176-48e6-eba6-e1739fe34502
msgctxt "h1fd1d016g4391g4823g82a1g466dcb16b906"
msgid "How regrettable, that your meat must go unsavoured."
msgstr "당신의 고기를 음미할 수 없다니 참으로 유감이군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Player
#. NodeID = ba4a0070-e598-c977-0ad0-98d40e925c08
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:ba4a0070-e598-c977-0ad0-98d40e925c08
msgctxt "h93851d09g2818g4406ga013g8463d00b1af3"
msgid "I've changed my mind. Forget about it."
msgstr "마음을 바꿨어. 없던 일로 하자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Lump the Enlightened
#. NodeID = bb2a9eb6-35fe-aa2e-90ac-92e3984a13ac
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_Knows_FailedPersuade = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:bb2a9eb6-35fe-aa2e-90ac-92e3984a13ac
msgctxt "ha2a4b569g753bg4c6fga2a5g159613cc2324"
msgid "Come, now. An ogre feasts not on promises."
msgstr "이런, 오우거는 약속을 먹고 살지 않는다고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Player
#. NodeID = bcbaca9b-ed0e-f3f5-9d03-8d0ed9bc86ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:bcbaca9b-ed0e-f3f5-9d03-8d0ed9bc86ea
msgctxt "hc08305f6g3be0g48ddgaba3g204327158af7"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Lump the Enlightened
#. NodeID = bd4a2074-825e-cc8f-e86f-5ea1da3e2329
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:bd4a2074-825e-cc8f-e86f-5ea1da3e2329
msgctxt "h927e9ae6g3652g482bgb9cfg02d27cb2c7f3"
msgid "I follow the scents of blood and gold to all lands fertile, friend."
msgstr "난 피와 황금이 있는 곳이라면 그 어떤 풍요의 땅이라도 찾아갑니다, 친구여."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Lump the Enlightened
#. NodeID = becde210-533e-b48e-0ca2-2942e95d1464
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:becde210-533e-b48e-0ca2-2942e95d1464
msgctxt "h24c4cde3ga977g44a5gb256gf0c4c647cd0c"
msgid "I simply look for marks. Gold is more than sufficient compensation."
msgstr "난 그저 표식을 확인할 뿐입니다. 지금 받는 금이라면 그 대가로 충분하지요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Lump the Enlightened
#. NodeID = c4630a65-1d2b-8615-30c9-3bf32254d68c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - FOR_SchoolOgres_State_HasHorn(0) = True
#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_State_Hired = True
#.   Object:
#.     - FOR_SchoolOgres_Event_GiveHorn(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:c4630a65-1d2b-8615-30c9-3bf32254d68c
msgctxt "h739756abgc5deg4023g866ag26e119415bee"
msgid ""
"Take my bonehorn. One blow, and the ground will quake with my family name."
msgstr "내 뿔나팔을 가져가시지요. 한 번 불면, 땅이 내 일족의 이름으로 떨릴 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Lump the Enlightened
#. NodeID = cb0e25ba-f465-2982-33e6-24d6a865ab4a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_SchoolOgres_State_OfferedMeat = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:cb0e25ba-f465-2982-33e6-24d6a865ab4a
msgctxt "h1dc13127gd15cg4003g8e83g9eeb45d13101"
msgid ""
"A brilliant notion, and a boon to my aching belly. We have a deal, my tasty "
"kibble!"
msgstr "총명한 발상이요, 내 주린 배에 들어오는 축복이로구나! 거래 성립이요, 우리 맛난 친구!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Player
#. NodeID = ccccbdd4-711a-b800-a40f-abc6d1a7be74
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_SchoolOgres_Knows_AskedBoss(1) = True
#.   Script:
#.      - GEN_CheckPocketGold = True
#. SetFlags:
#.   Object:
#.     - GEN_TransferNPCPayment(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:ccccbdd4-711a-b800-a40f-abc6d1a7be74
msgctxt "hf4755c6eg1781g46d1gb181gd26e6ca20e0a"
msgid ""
"I'll give you [6057ad05-9492-4630-9f0a-be548b134c54] gold if I can call you "
"into battle."
msgstr "전투를 도와준다면 [6057ad05-9492-4630-9f0a-be548b134c54] 골드를 주겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Lump the Enlightened
#. NodeID = d6454bc9-0624-a9fb-8c2e-5b313643d7d7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:d6454bc9-0624-a9fb-8c2e-5b313643d7d7
msgctxt "h4d1aa64ag4d33g4ce5g8532gc124d27cfe98"
msgid ""
"A serenade to my ears, and a boon to my belly. We've a bargain, my tasty "
"kibble!"
msgstr "내 귀에 들려오는 세레나데, 내 배에 들어오는 축복이로구나! 거래 성립이요, 맛난 음식!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Lump the Enlightened
#. NodeID = d664a8b9-a571-4639-141b-9c5ae3026bb2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#. SetFlags:
#.   Local:
#.     - c2212640-3b30-8873-1471-458bd88e8688_PassedCheck = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:d664a8b9-a571-4639-141b-9c5ae3026bb2
msgctxt "h98addc02ge800g43efg8e35g5c5ccd2c7179"
msgid ""
"Yes, yes - the mark is unmistakable. Tell me, sweet creature: does your "
"flesh taste as honeyed as I could hope for?"
msgstr "그래, 그래. 분명히 표식이 있군. 귀여운 생물이여, 알려주시지요. 내 바라건대 당신의 살점은 꿀과 같은 맛이 나나요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Lump the Enlightened
#. NodeID = d7556701-a621-b796-7315-833ac5494a89
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:d7556701-a621-b796-7315-833ac5494a89
msgctxt "h15834f2fg46d9g462fga698g3b43746b0fa1"
msgid "Ha! Did you expect The Enlightened to fall for such a crude ruse?"
msgstr "하! 깨우친 자가 그토록 조잡한 계략에 넘어갈 거라 생각한 것인지요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Lump the Enlightened
#. NodeID = ddd70c6a-94e4-e677-95e0-8f7cc768cc45
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:ddd70c6a-94e4-e677-95e0-8f7cc768cc45
msgctxt "hded1033dgee67g448bgb1d0g85af71258efe"
msgid ""
"How regrettable. Tell me, sweet creature: does your flesh taste as honeyed "
"as I could hope for?"
msgstr "안타깝기 그지없어라. 귀여운 생물이여, 알려주시지요. 내 바라건대 당신의 살점은 꿀과 같은 맛이 나나요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Player
#. NodeID = e9cf8f12-9bfe-92d2-1e76-bde010ac54a4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_SchoolOgres_Knows_AskedSpeech(1) = False
#.   Local:
#.      - c2212640-3b30-8873-1471-458bd88e8688_FailedCheck = False
#. SetFlags:
#.   Dialog:
#.     - FOR_SchoolOgres_Knows_AskedSpeech(1) = True
#. TagRule: REALLY_ELF
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:e9cf8f12-9bfe-92d2-1e76-bde010ac54a4
msgctxt "h13e6c28dgd3dag41eag892cg539bdfac69c4"
msgid "You speak with an eloquence unusual for your kind."
msgstr "이런 화려한 언변은 너희 종족에 드문데 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Player
#. NodeID = e9cf8f12-9bfe-92d2-1e76-bde010ac54a4
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_SchoolOgres_Knows_AskedSpeech(1) = False
#.   Local:
#.      - c2212640-3b30-8873-1471-458bd88e8688_FailedCheck = False
#. SetFlags:
#.   Dialog:
#.     - FOR_SchoolOgres_Knows_AskedSpeech(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:e9cf8f12-9bfe-92d2-1e76-bde010ac54a4
msgctxt "h72711f0eg1cafg4dc0g94f1ga22605bdde04"
msgid "You're quite eloquent for an ogre."
msgstr "오우거치고는 꽤 말을 유창하게 하는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Player
#. NodeID = ea0965e8-e1ee-3b01-e892-83964f063638
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_SchoolOgres_Knows_AskedOgres(1) = False
#. SetFlags:
#.   Dialog:
#.     - FOR_SchoolOgres_Knows_AskedOgres(1) = True
#. TagRule: REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:ea0965e8-e1ee-3b01-e892-83964f063638
msgctxt "h1fac5404gf594g48a2gad21g57513bf13d08"
msgid "I know of your kind, but you're among the first I've seen."
msgstr "난 너희 부류를 알지만, 직접 본 것은 처음이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Player
#. NodeID = ea0965e8-e1ee-3b01-e892-83964f063638
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_SchoolOgres_Knows_AskedOgres(1) = False
#. SetFlags:
#.   Dialog:
#.     - FOR_SchoolOgres_Knows_AskedOgres(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:ea0965e8-e1ee-3b01-e892-83964f063638
msgctxt "h3f53804dg9fd0g470eg96ceg45781b94b433"
msgid "I've seen few other ogres in these parts."
msgstr "이 지역에서 오우거는 별로 본 적 없는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Lump the Enlightened
#. NodeID = f40fa2cd-8913-9802-38fa-09774323a8d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:f40fa2cd-8913-9802-38fa-09774323a8d9
msgctxt "he67d1962g7e57g4c0fgaaeeg1ea303866c3c"
msgid "...and you, a delicacy - unless you bear the mark, of course."
msgstr "...당신은 미식이겠죠. 물론 표식이 없다면 말입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Lump the Enlightened
#. NodeID = f769a4c3-1807-cbe2-22b6-dc1526399cdd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = False
#. SetFlags:
#.   Local:
#.     - c2212640-3b30-8873-1471-458bd88e8688_PassedCheck = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:f769a4c3-1807-cbe2-22b6-dc1526399cdd
msgctxt "h6fabffd3ge45eg42c2ga705g01c9eba29df6"
msgid ""
"Yes, yes - the mark is unmistakable. How regrettable, that your meat must go "
"unsavoured."
msgstr "그래, 그래요. 분명히 표식이 있군. 당신의 고기를 음미해줄 이가 없다니 참으로 유감이군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Player
#. NodeID = fd8dc909-b335-6ddf-d140-f18f16344222
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:fd8dc909-b335-6ddf-d140-f18f16344222
msgctxt "h1e403540g529fg42aagb7f4ge7d6f625beaf"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1
#. Speaker = Player
#. NodeID = fdd5d56b-5a88-dbaa-b9b3-086938e9fa5c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. SetFlags:
#.   Dialog:
#.     - FOR_SchoolOgres_Event_AttemptedFirstSkillCheck(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre1:fdd5d56b-5a88-dbaa-b9b3-086938e9fa5c
msgctxt "h09e6f6ddg6001g4d20ga341g28c1f894d1b5"
msgid "I'll do you one better - I'm one of her chosen disciples."
msgstr "그 정도가 아니지. 난 그분에게 선택받은 특별한 제자다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre2
#. Speaker = Fank
#. NodeID = 21b72953-408a-b152-3120-4bc98425206a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre2:21b72953-408a-b152-3120-4bc98425206a
msgctxt "hc702e280g8338g45cfg82d7g45eddfba75bc"
msgid "Chicken?"
msgstr "닭?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre2
#. Speaker = Fank
#. NodeID = a91905c0-5f32-d298-3f69-3ca1439dadfc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre2:a91905c0-5f32-d298-3f69-3ca1439dadfc
msgctxt "hd1c1fa9bg4c73g4699gb8efg49fe8916b1a4"
msgid "No. You not chicken."
msgstr "아니. 너 닭 아니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre3
#. Speaker = Chock
#. NodeID = 2a3f081a-6277-2d21-fc50-fa5e5dd1ddb6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre3:2a3f081a-6277-2d21-fc50-fa5e5dd1ddb6
msgctxt "h4a061cf3g1135g4a3fgab8ega4f368058448"
msgid "Friend. No eat friend."
msgstr "친구. 친구 안 먹는다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre_Corpse_Dead
#. Speaker = Dead Tiefling
#. NodeID = 1b67163c-27b1-4bfe-3e72-9dd15d70c60c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 873bc4e0-3d3c-1eac-903b-e94920fd6306_sawgithyanki = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre_Corpse_Dead:1b67163c-27b1-4bfe-3e72-9dd15d70c60c
msgctxt "h900f71fegd3b2g4b8fg9b6cg9a8c4e86840d"
msgid "Strange warriors... gold skin... silver blades..."
msgstr "이상한 전사들... 금빛 피부에... 은검을 들고..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre_Corpse_Dead
#. Speaker = Dead Tiefling
#. NodeID = 2dc02b59-9bc6-92da-8e52-63b76dc8af13
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre_Corpse_Dead:2dc02b59-9bc6-92da-8e52-63b76dc8af13
msgctxt "hbac54f68g9860g4170g9611gb62445cc621e"
msgid "True sight... no... coin..."
msgstr "진실의 시야... 동전은... 없어..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre_Corpse_Dead
#. Speaker = Player
#. NodeID = 355a0a2a-6c6f-d037-563c-4e1e7c3a478d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre_Corpse_Dead:355a0a2a-6c6f-d037-563c-4e1e7c3a478d
msgctxt "hbfc20c51gec77g4000g9f36ga5ac83e8839a"
msgid "Where are you from?"
msgstr "어디서 왔지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre_Corpse_Dead
#. Speaker = Narrator
#. NodeID = 690a9f60-7508-ac05-72a5-9866be4969e1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre_Corpse_Dead:690a9f60-7508-ac05-72a5-9866be4969e1
msgctxt "he334062dgd7f0g4f32g95b6g150bcf1111bd"
msgid "*You realise the tiefling's body has been torn open by huge hands.*"
msgstr "*오우거의 손이 티플링의 몸을 찢어버렸다는 걸 깨닫습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre_Corpse_Dead
#. Speaker = Player
#. NodeID = 6d878775-4310-7dbd-ff91-269d13684349
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 873bc4e0-3d3c-1eac-903b-e94920fd6306_sawgithyanki = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#.   Tag:
#.      - REALLY_GITHYANKI(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre_Corpse_Dead:6d878775-4310-7dbd-ff91-269d13684349
msgctxt "hd4f33055g74ddg483fgae96ga59081689b65"
msgid "Where did you see those warriors?"
msgstr "이 전사들을 어디서 봤지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre_Corpse_Dead
#. Speaker = Player
#. NodeID = 6e821ab4-625c-148d-46d7-a2798163b6f9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre_Corpse_Dead:6e821ab4-625c-148d-46d7-a2798163b6f9
msgctxt "h676ef9d1g8fdfg4014gab67g2a54ffb3a239"
msgid "Anything of value you happen to have?"
msgstr "귀중한 물건을 가지고 있었나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre_Corpse_Dead
#. Speaker = Lae'zel
#. NodeID = 8eea1411-06d4-62cf-9957-bf0ac79807c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre_Corpse_Dead:8eea1411-06d4-62cf-9957-bf0ac79807c8
msgctxt "hf905e33agf070g48d4gb32ag5842a7f93a56"
msgid "Quick of foot, this one, to avoid githyanki hunters."
msgstr "이 자는 발이 날랬군. 기스양키 사냥꾼들을 피하기 충분했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre_Corpse_Dead
#. Speaker = Narrator
#. NodeID = 94333566-64aa-97c5-e655-f58cced6d737
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre_Corpse_Dead:94333566-64aa-97c5-e655-f58cced6d737
msgctxt "h6ce1fdcfg4e44g4e27g9cd9g1837fe74faea"
msgid "*The spell's power wanes. You can ask no more questions.*"
msgstr "*주문의 힘이 약해집니다. 더 이상 질문을 할 수 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre_Corpse_Dead
#. Speaker = Dead Tiefling
#. NodeID = c155bf1f-f566-d6f2-fb7f-836dc145a7e9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre_Corpse_Dead:c155bf1f-f566-d6f2-fb7f-836dc145a7e9
msgctxt "hbc2c908cg6613g43e6g927bg7b237c40892e"
msgid "Ogres... hungry... bloodied... screams..."
msgstr "배고픈... 오우거들... 피투성이... 비명..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre_Corpse_Dead
#. Speaker = Dead Tiefling
#. NodeID = c3978192-e22b-555c-a0f8-bec6240cc1a3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_GithChokepoint_Knows_NearMountain = True
#.   Object:
#.     - ORI_Laezel_Quest_TalkedToDeadTiefling(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre_Corpse_Dead:c3978192-e22b-555c-a0f8-bec6240cc1a3
msgctxt "hfb20fd13g62c9g4433gb883g8b322fc238cc"
msgid "Mountains... road... gate..."
msgstr "산... 길... 게이트..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre_Corpse_Dead
#. Speaker = Player
#. NodeID = d7f8d1fa-a34e-249f-c7dd-df78c2a63f09
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre_Corpse_Dead:d7f8d1fa-a34e-249f-c7dd-df78c2a63f09
msgctxt "hf40dd705gd26ag49d9g8970g2b0b2dca08b2"
msgid "Who did this to you?"
msgstr "누가 널 이렇게 만들었지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre_Corpse_Dead
#. Speaker = Player
#. NodeID = e4304f5e-437c-7224-5b0f-806761452354
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre_Corpse_Dead:e4304f5e-437c-7224-5b0f-806761452354
msgctxt "he7a1e47bgb48fg4780g8558gf74818be53f3"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre_Corpse_Dead
#. Speaker = Player
#. NodeID = e436d4fb-f150-02f7-4316-d4df149ae883
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre_Corpse_Dead:e436d4fb-f150-02f7-4316-d4df149ae883
msgctxt "h309e70dcg2596g477dgae02g667eb7cc690a"
msgid "What brought you to the village?"
msgstr "마을에는 왜 오게 된 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre_Corpse_Dead
#. Speaker = Narrator
#. NodeID = eac8c639-5d6b-df91-36ca-ddd8f915c78a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre_Corpse_Dead:eac8c639-5d6b-df91-36ca-ddd8f915c78a
msgctxt "hf34ea28dgc598g43a2gaf3egbff94fd680f6"
msgid "*The tiefling's corpse stirs with the spell.*"
msgstr "*주문을 외우자 티플링의 시신이 움직입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre_Corpse_Dead
#. Speaker = Narrator
#. NodeID = ef86d2eb-f327-18b7-a746-35869a9edf5c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre_Corpse_Dead:ef86d2eb-f327-18b7-a746-35869a9edf5c
msgctxt "hb5e38313ge95eg4089g89e3gcc5da42c1a0b"
msgid "*The corpse does not stir. It will answer no more questions.*"
msgstr "*시체는 움직이지 않습니다. 더 이상 질문을 받지 않을 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre_Corpse_Dead
#. Speaker = Dead Tiefling
#. NodeID = f9340c14-caf8-e1c4-5fe1-71ce2551a92d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre_Corpse_Dead:f9340c14-caf8-e1c4-5fe1-71ce2551a92d
msgctxt "hcb367f7bgea45g4b79gad25gb52bb3d50fed"
msgid "Elturel... Zorru... friend..."
msgstr "엘투렐... 조르... 친구..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre_Corpse_Dead
#. Speaker = Player
#. NodeID = fcf5035f-bcb2-a263-823e-94b4b11fd245
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 873bc4e0-3d3c-1eac-903b-e94920fd6306_sawgithyanki = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#.   Tag:
#.      - REALLY_GITHYANKI(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgre_Corpse_Dead:fcf5035f-bcb2-a263-823e-94b4b11fd245
msgctxt "hf5a7716cg882ag4b90g9affgc1645f7e63f7"
msgid "You saw githyanki. Where were they?"
msgstr "기스양키를 봤군. 어디서 봤지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AD
#. Speaker = Chock
#. NodeID = 02f6311b-a22c-4d10-398b-6f4343018b58
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AD:02f6311b-a22c-4d10-398b-6f4343018b58
msgctxt "hd52fde5dg38edg4806ga467g8da48cdd3a89"
msgid "Hm?"
msgstr "흠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AD
#. Speaker = Chock
#. NodeID = 3ba14b4b-68bd-9dca-f161-1e8b8dd2f6d2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AD:3ba14b4b-68bd-9dca-f161-1e8b8dd2f6d2
msgctxt "h2b25b2bbgf03cg4918g9a6fg0377c5da6047"
msgid "Dwarf better. Dwarf sweet like honey."
msgstr "드워프가 낫다. 드워프 꿀맛 난다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SchoolOgres_AD
