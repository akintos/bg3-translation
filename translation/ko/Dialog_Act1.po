msgctxt "h64fabed3g15f9g4f70ga168g1b575fd64c33"
msgid "<i>Try to force it open.</i>"
msgstr "<i>억지로 열려고 한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_TavernInvestigation_DesireDoor
#. Speaker = Player
#. NodeID = dd9b59c5-f09d-f59e-a5c8-c97479207911
