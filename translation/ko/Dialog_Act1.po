msgctxt "h95ac0423g5181g4910g8f7fg09efea5e8c30"
msgid "It's just..."
msgstr "이건 그저..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter_ThreewayDialogAfterBaelenAteMushroom
#. Speaker = Derryth Bonecloak
#. NodeID = c8621bee-51a1-e6a5-c62c-719353f27254
