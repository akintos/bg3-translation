#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_Trainer:309de998-a7f0-6cc8-1529-6cf2e900724b
msgctxt "h321aec97g2c2bg4c17g83d6g5b1f91f81c0f"
msgid "Come on then!"
msgstr "그럼 덤벼!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_Trainer
#. Speaker = Asharak
#. NodeID = 366072ec-1c54-c804-935f-0591e3dc62ae
