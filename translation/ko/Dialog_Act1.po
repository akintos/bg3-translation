msgctxt "h651ee9a1g864ag4bf1g9dcdgf033aeba9b82"
msgid "Red dragon! Take cover!"
msgstr "레드 드래곤이다! 숨어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_DragonShadow
#. Speaker = Player
