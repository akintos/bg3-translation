msgid ""
"Wake! Hungry!<i>\n"
"</i>"
msgstr ""
"일어나요! 배고파요!<i>\n"
"</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_OwlBear_LastCub
#. Speaker = Player
#. NodeID = 32049546-e23a-4f2d-a906-b2c99dce9a2d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_OwlBear_LastCub:32049546-e23a-4f2d-a906-b2c99dce9a2d
msgctxt "h0fbe0fcdgf588g45dbga2f0g334e074d8081"
msgid "<i>It was nothing. Put it out of your mind.</i>"
msgstr "<i>아무 일도 아니었다. 마음 속에서 치워 버린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_OwlBear_LastCub
#. Speaker = Narrator
#. NodeID = 41c08419-45b9-4978-b6c3-a25bcd29bd09
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_OwlBear_LastCub:41c08419-45b9-4978-b6c3-a25bcd29bd09
msgctxt "hf56ed3e3gbed5g4961g90d4g596b41205148"
msgid "*She offers you nothing.*"
msgstr "*여신은 아무 것도 내려 주지 않습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_OwlBear_LastCub
#. Speaker = Narrator
#. NodeID = 41f1b0be-9171-4054-a499-f562fff2b07f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_OwlBear_LastCub:41f1b0be-9171-4054-a499-f562fff2b07f
msgctxt "h87d61933g0d61g4bc9gb056g4756e7917c3f"
msgid ""
"*Is Lady Shar punishing you? Or perhaps testing you? Is it the tadpole, or a "
"curse? You cannot say.*"
msgstr ""
"*샤 여신님이 당신을 벌하고 있는 걸까요? 아니면 시험하고 있는 걸까요? 올챙이 때문일까요, 아니면 저주 때문일까요? 당신은 대답하지 "
"못합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_OwlBear_LastCub
#. Speaker = Owlbear Cub
#. NodeID = 607821e8-4c2c-229c-dd4e-efc840480fbe
