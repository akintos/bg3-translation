msgctxt "ha3670476g25f2g4d61gb901g99403a41f9b3"
msgid "<i>You again.</i>"
msgstr "<i>또 너로군.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaezelRecruitment_TieflingsSceneFallback
#. Speaker = Narrator
#. NodeID = e8d767af-4606-4e4c-bb24-c347cc336e56
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_LaezelRecruitment_Event_ArchPosition = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaezelRecruitment_TieflingsSceneFallback:e8d767af-4606-4e4c-bb24-c347cc336e56
msgctxt "h507473f1gb569g4089g83adg2b64f73f3a82"
msgid ""
"*Your skull pounds in response to the prisoner's white-hot stare. Her lips "
"don't move, yet you hear her voice.*"
msgstr "*잡혀 있는 여자의 강렬한 눈빛에 반응하며 두개골이 진동합니다. 입도 벙긋하지 않지만, 목소리가 들리는군요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaezelRecruitment_TieflingsSceneFallback
#. Speaker = Narrator
#. NodeID = f1e52fd9-56c2-459f-aa39-ad1ad252ab25
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaezelRecruitment_TieflingsSceneFallback:f1e52fd9-56c2-459f-aa39-ad1ad252ab25
msgctxt "h0c478c77gd5ecg4152gbf28gd7424eb1d226"
msgid ""
"*Your skull pounds in response to the prisoner's white-hot stare. Her lips "
"don't move, yet you hear her voice.*"
msgstr "*잡혀 있는 여자의 강렬한 눈빛에 반응하며 두개골이 진동합니다. 입도 벙긋하지 않지만, 목소리가 들리는군요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaezelRecruitment_TieflingsSceneFallback
#. Speaker = Narrator
#. NodeID = f2ddbeea-22f3-4497-9ce9-76b147863dd8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CHA_LaezelRecruitment_MindMeld(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaezelRecruitment_TieflingsSceneFallback:f2ddbeea-22f3-4497-9ce9-76b147863dd8
msgctxt "h5e50a7abga3cbg461dgb014g58671ddba76f"
msgid ""
"*Your skull briefly aches - and you are <i>her. </i>You feel her irritation "
"and indignity.*"
msgstr "*머리가 잠시 욱신거리더니, <i>저쪽</i>과 하나가 됩니다. 짜증과 모멸감이 전해지는군요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaezelRecruitment_TieflingsSceneFallback
#. Speaker = Lae'zel
#. NodeID = f8600a78-31ab-4fb5-8c77-540cd88b9c22
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_LaezelRecruitment_State_Tiefling1Missing = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaezelRecruitment_TieflingsSceneFallback:f8600a78-31ab-4fb5-8c77-540cd88b9c22
msgctxt "h7c930020gea21g458egb90age712aff59242"
msgid "<i>Get rid of him.</i>"
msgstr "<i>놈을 없애.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaezelRecruitment_TieflingsSceneFallback
#. Speaker = Narrator
#. NodeID = f8f0c062-e56e-4f3f-8842-5e407857e6a0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_LaezelRecruitment_Event_WagonPosition = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaezelRecruitment_TieflingsSceneFallback:f8f0c062-e56e-4f3f-8842-5e407857e6a0
msgctxt "h288d3f0ag6f7cg48c7gb539gb1a3eb1e0193"
msgid ""
"*Your skull pounds in response to the prisoner's white-hot stare. Her lips "
"don't move, yet you hear her voice.*"
msgstr "*잡혀 있는 여자의 강렬한 눈빛에 반응하며 두개골이 진동합니다. 입도 벙긋하지 않지만, 목소리가 들리는군요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice
#. Speaker = Narrator
#. NodeID = 064bb5c6-8c65-cec8-4e25-db67fd875b58
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice:064bb5c6-8c65-cec8-4e25-db67fd875b58
msgctxt "h3d1e972eg4dabg4f61ga40fg603f714639e9"
msgid ""
"*The creatures clutch the pouch possessively. You have no doubt: a spider "
"egg is nestled within.*"
msgstr "*그것들은 주머니에 집착하고 있습니다. 의심에 여지가 없습니다. 주머니 안에 거미 알이 자리를 잡았습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice
#. Speaker = Player
#. NodeID = 0c6b09a4-c59b-874b-45f2-68ea5acf7d82
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice:0c6b09a4-c59b-874b-45f2-68ea5acf7d82
msgctxt "hfcfd26degf0a7g4456gb450g5b584aeb2176"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice
#. Speaker = Narrator
#. NodeID = 0d4552b0-9a5f-e0a4-6f42-d0cc8c772a5c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_Outpost_State_BagOut = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice:0d4552b0-9a5f-e0a4-6f42-d0cc8c772a5c
msgctxt "hab85a4b1g591eg4af8g8aa0g01d3a0267c82"
msgid "*Your fingers search, but find no bag. Was it a trick of the light?*"
msgstr "*손을 움직이며 찾아봤지만 주머니를 찾지 못했습니다. 빛에 의한 착시였을까요?*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice
#. Speaker = Player
#. NodeID = 1378fa15-8010-afee-2e3a-083a13b9adf1
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Dexterity
#. DifficultyClass: 15
#. CheckFlags:
#.   Dialog:
#.      - CHA_Outpost_Event_Bit(0) = True
#.   Global:
#.      - CHA_Outpost_Event_Calmed = False
#.   Tag:
#.      - ROGUE(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice:1378fa15-8010-afee-2e3a-083a13b9adf1
msgctxt "h0cc8f324g7bb4g44bdg8ffbg93141a180e90"
msgid "<i>Dart your hand in once more, hoping to snatch the bag.</i>"
msgstr "<i>다시 한번 주머니를 향해 손을 안쪽에 집어넣는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice
#. Speaker = Player
#. NodeID = 24aaf407-f3db-cff8-8280-310710987934
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Dexterity
#. DifficultyClass: 15
#. CheckFlags:
#.   Dialog:
#.      - CHA_Outpost_Event_Bit(0) = False
#.   Global:
#.      - CHA_Outpost_Event_Calmed = False
#.   Tag:
#.      - ROGUE(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice:24aaf407-f3db-cff8-8280-310710987934
msgctxt "h88e0a86fg032fg4e4dgae42g81b74b17711a"
msgid "<i>Dart your hand in, hoping to snatch the bag.</i>"
msgstr "<i>주머니를 얻기 위해 손을 안쪽에 집어넣는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice
#. Speaker = Narrator
#. NodeID = 2ac350f2-b31b-6d48-35eb-76bcc04c65b6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice:2ac350f2-b31b-6d48-35eb-76bcc04c65b6
msgctxt "h16203a15g500fg45e0g9aa0g9feb9a4c29d1"
msgid ""
"*Agitated clacking chokes your thoughts. The spiders skitter about, more "
"nervous than before.*"
msgstr "*동요하는 타닥타닥 소리가 당신을 조여옵니다. 거미는 긴장한 듯 이리저리 뛰어다닙니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice
#. Speaker = Narrator
#. NodeID = 39c74d46-024d-0d18-893b-106b9a6b2346
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CHA_Outpost_Event_SnakeOut = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice:39c74d46-024d-0d18-893b-106b9a6b2346
msgctxt "h4b9ee723ga0a9g46bfgaa8dg8874f61d9bb2"
msgid ""
"*The infuriated spiders pour in all directions like sand. The swarm is "
"coming.*"
msgstr "*화난 거미들이 모래처럼 온 방향에서 쏟아져 팔을 뒤덮습니다. 거미 떼가 몰려옵니다. *"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice
#. Speaker = Narrator
#. NodeID = 3e2a66a1-a771-3507-ff55-9ff0798b057b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice:3e2a66a1-a771-3507-ff55-9ff0798b057b
msgctxt "h96ca6d55g5b17g4d23gb7aeg27a40097e6a4"
msgid ""
"*Your voice draws their attention. They are suspicious, then curious, and "
"finally at peace.*"
msgstr "*당신의 목소리에 거미들이 관심을 보였습니다. 처음에는 의심과 호기심을 드러내다 마침내 평온해졌습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice
#. Speaker = Narrator
#. NodeID = 41a28c1e-5235-6ab3-8966-1365dbcea72a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CHA_Outpost_Event_SnakeOut = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice:41a28c1e-5235-6ab3-8966-1365dbcea72a
msgctxt "h5583e812g2694g45ffg8ff1g4dac884e1a56"
msgid ""
"*The infuriated spiders pour in all directions like sand. The swarm is "
"coming.*"
msgstr "*화난 거미들이 모래처럼 온 방향에서 쏟아져 팔을 뒤덮습니다. 거미 떼가 몰려옵니다. *"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice
#. Speaker = Narrator
#. NodeID = 42823096-c436-59d6-4f30-34031c853764
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice:42823096-c436-59d6-4f30-34031c853764
msgctxt "h8702f87ege51cg459ega817g5305da57057c"
msgid ""
"*The creatures clutch the pouch possessively. Is gold so precious to "
"spiders?*"
msgstr "*그 생물들은 주머니에 집착합니다. 거미는 동전이 그렇게나 소중한 걸까요?*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice
#. Speaker = Player
#. NodeID = 4cdf9629-3f24-ef44-0dc0-593a54567a50
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 10
#. CheckFlags:
#.   Dialog:
#.      - CHA_Outpost_Event_Handled(0) = False
#.   Global:
#.      - CHA_Outpost_Event_Calmed = False
#. SetFlags:
#.   Dialog:
#.     - CHA_Outpost_Event_Handled(0) = True
#. TagRule: DRUID or RANGER
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice:4cdf9629-3f24-ef44-0dc0-593a54567a50
msgctxt "ha0401f8fg2ec4g4f02gaf71g6f9c78f2acb6"
msgid "<i>Speak softly to the spiders in hopes of calming them.</i>"
msgstr "<i>거미들이 진정되기를 기대하며 부드럽게 말을 건다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice
#. Speaker = Narrator
#. NodeID = 50e0d570-832b-45b2-a611-2380a945d9ae
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CHA_Outpost_Event_Calmed = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice:50e0d570-832b-45b2-a611-2380a945d9ae
msgctxt "hb30f194dged9fg47cdg86cbg2b9675ecb17f"
msgid ""
"*One by one, the spiders retreat to the rear of the crevice, lulled by your "
"murmurs.*"
msgstr "*당신의 속삭임에 진정된 거미들은 한 마리씩 틈새 안쪽으로 물러갔습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice
#. Speaker = Narrator
#. NodeID = 614de078-784c-7c69-c1ef-12e69177398f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CHA_Outpost_Event_Bit(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice:614de078-784c-7c69-c1ef-12e69177398f
msgctxt "h638fed4egc048g43a9ga1ceg8dfe75f9cbbd"
msgid ""
"*Pincers pierce your flesh, and pain shoots up your arm and across your "
"back.*"
msgstr "*거미가 살을 물어 뜯자 고통이 팔을 통해 등까지 전해집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice
#. Speaker = Narrator
#. NodeID = 7867ed1d-cc08-08eb-16d0-b7016476f774
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_Outpost_State_BagOut = False
#. SetFlags:
#.   Object:
#.     - CHA_Outpost_Event_GiveBag(0) = True
#.   Quest:
#.     - HIDDEN_WLD_Boosters.CRA_HarperBooster_Looted(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice:7867ed1d-cc08-08eb-16d0-b7016476f774
msgctxt "h5466ad8cg52f0g492egb633gbc40f2e2b687"
msgid "*You stash the bag in your pack. Something clinks among the coins.*"
msgstr "*주머니를 소지품 안에 넣었습니다. 동전 사이에서 무언가가 덜그럭 소리를 냅니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice
#. Speaker = Player
#. NodeID = 786b8451-98c3-dd17-ba96-c803ecaedb79
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice:786b8451-98c3-dd17-ba96-c803ecaedb79
msgctxt "h0cd04bd3g2870g496fg8745g391f79907b49"
msgid "<i>Reach in to crush the spiders.</i>"
msgstr "<i>거미들을 혼쭐내주기 위해 손을 뻗는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice
#. Speaker = Player
#. NodeID = 7bc02ae1-60f2-d34f-b609-51cb911aa167
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 687a5077-5eb0-495c-a974-06fced65d325_SpiderCheck = True
#. TagRule: RANGER
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice:7bc02ae1-60f2-d34f-b609-51cb911aa167
msgctxt "ha22518cega98fg4c72gb53eg87c0c9df5a4c"
msgid "<i>Watch the spiders, and remain ready to strike.</i>"
msgstr "<i>공격 태세를 유지하며 거미들을 관찰한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice
#. Speaker = Player
#. NodeID = 7bc02ae1-60f2-d34f-b609-51cb911aa167
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Local:
#.     - 687a5077-5eb0-495c-a974-06fced65d325_SpiderCheck = True
#. TagRule: DRUID
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice:7bc02ae1-60f2-d34f-b609-51cb911aa167
msgctxt "h655c0897g364cg4a5ag8a1bga94147459173"
msgid "<i>Attune yourself to the spiders' natural rhythm.</i>"
msgstr "<i>거미의 리듬에 맞추어 스스로를 조율한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice
#. Speaker = Narrator
#. NodeID = 7ed99c9d-f356-3ed2-d8b9-7e1b370da818
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice:7ed99c9d-f356-3ed2-d8b9-7e1b370da818
msgctxt "hd0882d7dg4e12g4765g893bg97a9012e64f7"
msgid ""
"*Your voice draws their attention. They are suspicious, then curious, and "
"finally at peace.*"
msgstr "*당신의 목소리에 거미들이 관심을 보였습니다. 처음에는 의심과 호기심을 드러내다 마침내 평온해졌습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice
#. Speaker = Narrator
#. NodeID = 83c71627-2b82-4814-9694-b373a0aaab4d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_Outpost_Event_Calmed = True
#.      - CHA_Outpost_State_BagOut = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice:83c71627-2b82-4814-9694-b373a0aaab4d
msgctxt "h13b06251g4bf4g470bgbbcfg7daab7da3c74"
msgid "*Several spiders rest in the rear of the crevice.*"
msgstr "*거미 여럿이 틈새 뒷편에서 쉬고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice
#. Speaker = Narrator
#. NodeID = 8484186d-2a48-6185-709a-83f0a73d67c3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_Outpost_State_BagOut = False
#.   Tag:
#.      - PETPAL(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice:8484186d-2a48-6185-709a-83f0a73d67c3
msgctxt "h4490561dg92b8g40eaga827g25fefae438a0"
msgid "*The spiders scatter. You feel their panic; the beloved was taken!*"
msgstr "*거미들이 흩어지고, 당신에게 그들의 혼란스러움이 느껴집니다; 우리들의 사랑이 납치됐다!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice
#. Speaker = Narrator
#. NodeID = 8a9841e4-ddbd-8e13-4934-c8eb3a3d3388
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_Outpost_Event_SnakeOut = True
#.      - CHA_Outpost_State_BagOut = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice:8a9841e4-ddbd-8e13-4934-c8eb3a3d3388
msgctxt "h36c947d6g6c1bg46dcg8154g7d4ed857b8c1"
msgid "*This crevice is empty, save a bit of dust.*"
msgstr "*이 틈새는 비어있습니다, 약간의 먼지만이 있군요*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice
#. Speaker = Player
#. NodeID = 8ac26e17-8cfe-951d-2840-0cb815baf412
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice:8ac26e17-8cfe-951d-2840-0cb815baf412
msgctxt "h591c0f8bg8774g4a48g8a7bg8f05f85f7883"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice
#. Speaker = Player
#. NodeID = 8b1c11d7-a379-bb53-70be-a97b243a1a50
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Dexterity
#. DifficultyClass: 10
#. CheckFlags:
#.   Dialog:
#.      - CHA_Outpost_Event_Bit(0) = True
#.   Global:
#.      - CHA_Outpost_Event_Calmed = False
#.   Tag:
#.      - ROGUE(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice:8b1c11d7-a379-bb53-70be-a97b243a1a50
msgctxt "h172f9886gb8f4g41e3gb73fgadf6dcda274b"
msgid "<i>Dart your hand in once more, hoping to snatch the bag.</i>"
msgstr "<i>다시 한번 주머니를 향해 손을 안쪽에 집어넣는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice
#. Speaker = Player
#. NodeID = 91479947-a5b3-f9eb-8ec5-732471a68ccf
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 15
#. CheckFlags:
#.   Dialog:
#.      - CHA_Outpost_Event_Handled(0) = False
#.   Global:
#.      - CHA_Outpost_Event_Calmed = False
#.   Tag:
#.      - BARD(0) = False
#. SetFlags:
#.   Dialog:
#.     - CHA_Outpost_Event_Handled(0) = True
#. TagRule: !(DRUID and RANGER)
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice:91479947-a5b3-f9eb-8ec5-732471a68ccf
msgctxt "hebedd6e0g6fc3g4916ga00eg656470904252"
msgid "<i>Speak softly to the spiders in hopes of calming them.</i>"
msgstr "<i>거미들이 진정되기를 기대하며 부드럽게 말을 건다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice
#. Speaker = Narrator
#. NodeID = 9aacb539-b506-b2fc-c890-506daf8c276f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_Outpost_State_BagOut = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice:9aacb539-b506-b2fc-c890-506daf8c276f
msgctxt "he8068a33g7615g4ef6ga360g654cba1193cf"
msgid ""
"*The spiders scatter, but your hand comes up empty. Was the bag a trick of "
"the light?*"
msgstr "*거미들은 흩어졌지만 손에는 아무것도 잡히지 않았습니다. 주머니는 빛에 의한 착시였을까요?*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice
#. Speaker = Narrator
#. NodeID = a21a8495-9cf5-ad4e-34a0-b6fb7a06c629
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(0) = True
#. SetFlags:
#.   Dialog:
#.     - CHA_Outpost_Event_Bit(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice:a21a8495-9cf5-ad4e-34a0-b6fb7a06c629
msgctxt "hc1a4b4efg1713g4fe9gadd5gffcaf1a1f940"
msgid ""
"*Pincers pierce your flesh. Their chitters became giggles - the intruder is "
"punished!*"
msgstr "*집게턱이 당신의 살을 뚫습니다. 그들의 재잘거림이 웃음으로 바뀝니다 - 침입자를 벌하였다!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice
#. Speaker = Narrator
#. NodeID = a88f6790-5c86-b86d-b9bb-7ba91bae6e07
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_Outpost_Event_SnakeOut = False
#.      - CHA_Outpost_State_BagOut = False
#.   Local:
#.      - 687a5077-5eb0-495c-a974-06fced65d325_SpiderCheck = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice:a88f6790-5c86-b86d-b9bb-7ba91bae6e07
msgctxt "h76395869gb89fg4603g9288g6d1571526811"
msgid ""
"*At the back of the crevice lies a bag, enfolded in the chitinous squabbling "
"of spiders. A shiny gold coin pokes from its mouth.*"
msgstr "*틈새 안에 거미들의 치열한 영역다툼으로 뒤덮인 주머니가 있습니다. 주머니에서 삐져나온 금화 한 닢이 반짝입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice
#. Speaker = Narrator
#. NodeID = b4788542-0237-106e-14fe-64f3d0597090
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_Outpost_Event_SnakeOut = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice:b4788542-0237-106e-14fe-64f3d0597090
msgctxt "hfa7becafg6503g4fe8g88b4g0f429cea3c27"
msgid ""
"*A bag lies within the crevice, enfolded in the chitinous squabbling of "
"spiders. A shiny gold coin pokes from its mouth.*"
msgstr "*틈새 안에 거미들의 치열한 영역다툼으로 뒤덮인 주머니가 있습니다. 주머니에서 삐져나온 금화 한 닢이 반짝입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice
#. Speaker = Narrator
#. NodeID = b8f6b061-f8ad-b7c0-e4b2-6817583daffd
