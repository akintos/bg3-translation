#. SetFlags:
#.   Local:
#.     - 6fa2b72d-fde1-4ee3-e1d1-f184232f693d_B = False
#.     - 6fa2b72d-fde1-4ee3-e1d1-f184232f693d_C = False
#.     - 6fa2b72d-fde1-4ee3-e1d1-f184232f693d_A = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid2:7ef8439c-09ba-92f7-7f83-9876d2c73234
msgctxt "hcc4531fag1e46g4fecg9a9cg9f8f5977729d"
msgid "Kagha - even her name tastes sour."
msgstr "카그하. 이젠 이름조차 씁쓸하군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid2
#. Speaker = Karrik
#. NodeID = 8b48e99c-f3c5-6b8f-598a-04cea318386a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#. SetFlags:
#.   Local:
#.     - 6fa2b72d-fde1-4ee3-e1d1-f184232f693d_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid2:8b48e99c-f3c5-6b8f-598a-04cea318386a
msgctxt "h56551718gd2feg4d58g8498g6b196aece556"
msgid "We'll be stronger for all of this."
msgstr "이번 일을 통해 우린 더 강해질 것이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid2
#. Speaker = Karrik
#. NodeID = 8e11905c-2c5f-ba0d-ae0f-710ae8271ed2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 6fa2b72d-fde1-4ee3-e1d1-f184232f693d_B = True
#. SetFlags:
#.   Local:
#.     - 6fa2b72d-fde1-4ee3-e1d1-f184232f693d_C = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid2:8e11905c-2c5f-ba0d-ae0f-710ae8271ed2
msgctxt "h8fdc28c5g60e7g44a1gae0cg3a4695202839"
msgid "I won't forgive her. I can't."
msgstr "카그하를 용서 못해. 용서 할 수 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid2
#. Speaker = Karrik
#. NodeID = b098e5eb-26eb-2f7c-8182-0a192fe314d4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 6fa2b72d-fde1-4ee3-e1d1-f184232f693d_A = True
#. SetFlags:
#.   Local:
#.     - 6fa2b72d-fde1-4ee3-e1d1-f184232f693d_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid2:b098e5eb-26eb-2f7c-8182-0a192fe314d4
msgctxt "h1f63b4fag364dg4c0fga2c1g963532c30231"
msgid "Shadow Druids! What was she thinking?"
msgstr "그림자 드루이드들이라니! 대체 무슨 생각을 했던 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_AD_RitualDruid2
#. Speaker = Karrik
#. NodeID = d5ae9d15-02d8-3a5d-dd71-641cb8ea0c93
