msgctxt "h29a1db15g35a6g4bc2gb0f7g188a168becd8"
msgid "Guess we ought to cut it into worg meat like the others."
msgstr "다른 자식들처럼 워그 먹이로 만들어야겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear
#. Speaker = Narrator
#. NodeID = 00d6a308-5484-fc54-248f-6f9f1fcb8ba3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
