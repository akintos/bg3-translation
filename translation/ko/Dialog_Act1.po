msgctxt "hf099afd2g37c9g4d35gb7ddg425bcf30884f"
msgid "*A shiver runs across your mind... You feel sated.*"
msgstr "*전율이 불현듯 머릿속을 스쳐 지나가고... 만족감이 듭니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Trespassing
#. Speaker = GROUP_GOB_Checkpoint_Guards
#. NodeID = 678c3205-6418-aae2-0071-e758a3d47357
