msgctxt "h0b6415f2g5086g40e7ga617gb08ab78f4b6d"
msgid "Hear, hear, my good True Soul!"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Player
#. NodeID = 66599e83-eb93-3f9a-0846-cab6cc4a0ac6
