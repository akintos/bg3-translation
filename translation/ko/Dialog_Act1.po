#.     - GOB_NerdyGoblinSage_State_TriedPersuasion(1) = True
#. TagRule: BERSERKER
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:133e8412-7842-e589-562f-3cbb05bb4157
msgctxt "h2a575911g2cb7g459fgb4dfgc0d867f81209"
msgid "<b>MANUSCRIPT. NOW.</b>"
msgstr "<b>원고. 당장.</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Player
#. NodeID = 133e8412-7842-e589-562f-3cbb05bb4157
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#.   UserShape:
#.      - GOB_NerdyGoblinSage_State_TriedPersuasion(1) = False
#. SetFlags:
#.   UserShape:
#.     - GOB_NerdyGoblinSage_State_TriedPersuasion(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:133e8412-7842-e589-562f-3cbb05bb4157
msgctxt "h05d161a5gd92fg49aagae87g0591a1b01c38"
msgid "A lifetime can be <b>very short</b>. Hand over the manuscript."
msgstr "그 평생이란 게 <b>아주 짧아질</b> 수도 있다. 그 원고 내놔."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Booyahg Piddle
#. NodeID = 13663dfe-7606-e588-b95a-005ae5c90650
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:13663dfe-7606-e588-b95a-005ae5c90650
msgctxt "h53798660g26a4g46eeg8ad0g0f49d9ac93bb"
msgid ""
"That's wot the bloke who wrote this said! Proper impressed by my brain-"
"smarts, he woz."
msgstr "이걸 쓴 친구도 그런 말을 했었지! 내 똑똑한 머리에 감명을 받았단 말씀."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Player
#. NodeID = 17ecff54-c2eb-cfb7-738b-a7dcd64d7d18
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = False
#.   UserShape:
#.      - GOB_NerdyGoblinSage_State_TriedPersuasion(1) = False
#. SetFlags:
#.   UserShape:
#.     - GOB_NerdyGoblinSage_State_TriedPersuasion(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:17ecff54-c2eb-cfb7-738b-a7dcd64d7d18
msgctxt "h7e332537g4869g4a57ga83ag8fb195ac8658"
msgid ""
"It'll be a very <i>short </i>lifetime if you don't hand me the manuscript."
msgstr "그 원고를 넘기지 않으면 아주 <i>짧은</i> 평생이 될 수도 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Player
#. NodeID = 17f154bd-cc98-48fd-f787-258f659602c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:17f154bd-cc98-48fd-f787-258f659602c0
msgctxt "h5fcb5427g1ea8g4180gb5b2g4361e18abbea"
msgid "Can I see the manuscript?"
msgstr "나도 좀 볼 수 있을까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Booyahg Piddle
#. NodeID = 18f90575-a46b-66ef-1606-4a39f74c6749
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:18f90575-a46b-66ef-1606-4a39f74c6749
msgctxt "h5040df22g4711g414dg9380gb55f9f831bdc"
msgid "You <i>made</i> me do that... didn't have no choice, did I?"
msgstr "방금 날 <i>조종한</i> 건가... 난 선택권이 없었지 않았어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Booyahg Piddle
#. NodeID = 1b338674-342c-db0e-7931-0216ff186cf8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:1b338674-342c-db0e-7931-0216ff186cf8
msgctxt "h1a272ebfg6fccg454dgb77cg96098613fda3"
msgid ""
"Nah. We're keepin' him as our own little plaything, so long as he don't ask "
"any more awkward questions."
msgstr "에이, 아니야. 우리 장난감으로 데리고 있지. 또 이상한 질문을 캐묻지만 않으면."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Player
#. NodeID = 1df4ae7c-ac9e-0763-9c48-d23500ab34d2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:1df4ae7c-ac9e-0763-9c48-d23500ab34d2
msgctxt "h2c33cf5egda1eg4223gaf03g5cf57d186383"
msgid "That's quite the compliment. It means you're extremely intelligent."
msgstr "그건 엄청난 칭찬인데. 네가 굉장히 똑똑하다는 뜻이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Player
#. NodeID = 1e045162-f24c-f522-7244-935f188aba6f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:1e045162-f24c-f522-7244-935f188aba6f
msgctxt "he00038f5gbe3dg48afgb507gd44259f53105"
msgid "You will give me the book."
msgstr "그 책 내놔."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Narrator
#. NodeID = 1e80044c-c213-f53e-d398-b241a2425dc9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount2(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:1e80044c-c213-f53e-d398-b241a2425dc9
msgctxt "h58048c39g0aebg4032g9b18gc343441ee20f"
msgid ""
"*Something stirs deep within you, hungry and alert... it's taking something "
"you'll never get back.*"
msgstr "*몸 깊숙한 데서 굶주리고 기민한 존재가 꿈틀댑니다... 잃으면 되찾지 못할 뭔가를 좀먹고 있군요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Player
#. NodeID = 2568b8f1-97ea-c32b-7aef-3effb5c0bea4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:2568b8f1-97ea-c32b-7aef-3effb5c0bea4
msgctxt "h097ee386g3bbeg4c67g8adfg539f1747bd4f"
msgid "Most goblins I've met aren't terribly interested in reading."
msgstr "읽기에 관심이 있는 고블린은 거의 본 적이 없는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Booyahg Piddle
#. NodeID = 278963da-cf9f-3692-7a8e-de8b838f2e39
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_NerdyGoblinSage_HasMet(1) = True
#.   Object:
#.      - GOB_HasVoloGoblinManuscript(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:278963da-cf9f-3692-7a8e-de8b838f2e39
msgctxt "hfe22c9eeg8e46g4dd8ga0f6g184cd5e04f1b"
msgid "You should go get a drink before the party dies down."
msgstr "가서 파티가 끝나기 전에 한잔 받지 그래."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Booyahg Piddle
#. NodeID = 2c2ddce0-8f7a-49e3-3639-a2062caf4f7c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_GiveVoloGoblinManuscript(1) = True
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:2c2ddce0-8f7a-49e3-3639-a2062caf4f7c
msgctxt "h1e84b0f7gcd72g46acgab8egd67a52931c6b"
msgid "Of course, mistress."
msgstr "물론입니다, 마님."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Booyahg Piddle
#. NodeID = 2c2ddce0-8f7a-49e3-3639-a2062caf4f7c
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_GiveVoloGoblinManuscript(1) = True
#. TagRule:
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:2c2ddce0-8f7a-49e3-3639-a2062caf4f7c
msgctxt "h12410e32gb79eg4cbbg91beg93b3fcc164e4"
msgid "Of course, master."
msgstr "물론입니다, 주인님."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Booyahg Piddle
#. NodeID = 2e93880e-cbb9-df26-aad5-50189a501f91
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_GoblinToast_State_RealizedPoison = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:2e93880e-cbb9-df26-aad5-50189a501f91
msgctxt "hb9b5e290g4108g4d58gbbe4g0cb5cf05a8df"
msgid "Someone's got it out for us. Find the bastard!"
msgstr "웬 놈이 우리를 해코지했군. 그 자식 찾아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Player
#. NodeID = 309209b2-06f2-2d24-845f-3ba22069ab92
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_Volo_HasMet_Personally(1) = True
#. SetFlags:
#.   UserShape:
#.     - GOB_NerdySage_ToldVoloName(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:309209b2-06f2-2d24-845f-3ba22069ab92
msgctxt "hc5d23bf4gb9d9g4cf4g8ab2g8306eb4dda0a"
msgid "That 'bloke' was Volothamp Geddarm, famed chronicler of the Realms."
msgstr "네가 '친구'라고 부르는 사람은 볼로뎀프 게담이야. 렐름의 유명한 저자라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Player
#. NodeID = 316f86b3-c514-3b5c-00db-05651e03eaa9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:316f86b3-c514-3b5c-00db-05651e03eaa9
msgctxt "h513a1b56gc62bg4c98gbd08g7ac8d1f714cd"
msgid "It means 'smelly' and 'noisy'."
msgstr "'냄새나고 시끄럽다'는 뜻이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Narrator
#. NodeID = 34328d3a-bca0-8051-4bb0-4151d94da39b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - GLO_TadpoleIntro_NPC(1) = False
#. SetFlags:
#.   User:
#.     - GLO_TadpoleIntro_NPC(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:34328d3a-bca0-8051-4bb0-4151d94da39b
msgctxt "h5dd562edgdf5eg420bgb292g04a0cf4646a0"
msgid ""
"*A strange symbol glows, marked on their flesh, and something within you "
"stirs in response.*"
msgstr "*그들의 살갗에 새겨진 기묘한 상징이 빛나고, 이에 반응하여 당신 내면의 무언가가 꿈틀거립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Booyahg Piddle
#. NodeID = 3788ba88-6730-3013-7962-985f1e965f59
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:3788ba88-6730-3013-7962-985f1e965f59
msgctxt "h0bc6849dg5fedg44e6g8f99gf21898b81abb"
msgid "Get out of my head!"
msgstr "내 머리에서 나가!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Booyahg Piddle
#. NodeID = 37ff1f13-4106-642b-ec25-3203eb07a553
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_Checkpoint_State_Paint(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:37ff1f13-4106-642b-ec25-3203eb07a553
msgctxt "hdb3605b0g6d45g469bga8fbg8ab42ab62623"
msgid ""
"Smelliest thing around here is you, mate. That dung on yer mug's makin' my "
"eyes water."
msgstr "여기서 제일 냄새나는 건 댁인데. 그쪽 면상에 묻은 똥 때문에 눈이 아리는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Player
#. NodeID = 3973aa9a-4dfc-6c56-7936-b4ec5bb3210d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:3973aa9a-4dfc-6c56-7936-b4ec5bb3210d
msgctxt "h2f248276g94f7g463eg94ccg1b5c209f3416"
msgid "Could I see his manuscript?"
msgstr "그 원고를 봐도 될까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Booyahg Piddle
#. NodeID = 39ff8175-110c-89e1-e213-5b4723a69546
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_Quest_Learnt3LeadersTwoNames = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:39ff8175-110c-89e1-e213-5b4723a69546
msgctxt "h8e1daf3cge34dg464ag8e31g0d4dff98d27f"
msgid ""
"Yeah - priestess Gut is fearsome powerful now. So's Ragzlin, our boss. "
"Them's True Souls now. Just like that drow."
msgstr ""
"그래, 거트 여사제가 이제 무시무시하게 강해졌지. 우리 두목 라그즐린도 마찬가지고. 이제 둘 다 참된 영혼이라 이거야. 그 드로우처럼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Player
#. NodeID = 3c57acc5-d21f-4f71-7581-a8f2b44fbd4b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:3c57acc5-d21f-4f71-7581-a8f2b44fbd4b
msgctxt "h3a146d49g5f58g494dg8b3dg8889f2f040ee"
msgid "What kind of awkward questions?"
msgstr "어떤 이상한 질문을 했는데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Booyahg Piddle
#. NodeID = 416264bf-144b-f57c-6585-24a13a717afc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:416264bf-144b-f57c-6585-24a13a717afc
msgctxt "h4864c8b9g09a6g4e6dga93cg0ea7704cc188"
msgid "Are you trying to scare me? Cuz it ain't working. Clear off."
msgstr "지금 날 겁주려는 거야? 소용 없거든. 저리 가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Booyahg Piddle
#. NodeID = 4402c793-ed38-3d2a-9d36-16114f8318fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:4402c793-ed38-3d2a-9d36-16114f8318fd
msgctxt "h780c6855g1756g4535gbad4g7df4c84f9e50"
msgid ""
"Hang about, you're jest trying to get my book, aintcha? Cheeky bastard. Get "
"your own."
msgstr "잠만, 지금 내 책 가져가려고 이러는 거 아니여? 약아가지고는. 다른 책이나 찾아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Booyahg Piddle
#. NodeID = 454c6626-75e7-1e52-e9a7-37aea3fa3c95
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_VoloBallad_State_OnStage = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:454c6626-75e7-1e52-e9a7-37aea3fa3c95
msgctxt "h1546c868g0cc8g4387g9c16ge198137270b4"
msgid "... think they've locked 'im in the cells already."
msgstr "... 벌써 감옥으로 데려간 모양이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Narrator
#. NodeID = 4b875cda-ae41-dc12-4186-30765d1dee7f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:4b875cda-ae41-dc12-4186-30765d1dee7f
msgctxt "h374e8f88ge206g4ecbg8c5eg4437d585b19f"
msgid ""
"*The mark glows, but you feel nothing in response. Your illithid power is "
"beyond reach until you rest.*"
msgstr "*문양이 빛나지만, 어떤 반응도 느껴지지 않습니다. 일리시드 능력을 더 사용하려면 휴식을 취해야 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Booyahg Piddle
#. NodeID = 4dcd833d-a1d0-de15-2e56-34334ad2d5c3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:4dcd833d-a1d0-de15-2e56-34334ad2d5c3
msgctxt "h874763acged7bg4d1cga1beg134042d4e1dc"
msgid ""
"Said he's writin' a book about the Absolute. Lads didn't like that - said he "
"was a spy or some such..."
msgstr "절대자를 다루는 책을 쓰겠다고 하더구먼. 다른 애들은 안 좋아했지. 그놈이 무슨 첩자 아니냐면서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Player
#. NodeID = 4f8f61f2-49ee-8d99-2a0c-2a4516dcb77e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:4f8f61f2-49ee-8d99-2a0c-2a4516dcb77e
msgctxt "he60ece2cgdd80g4d43gae0cgc2d6c0754f78"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Booyahg Piddle
#. NodeID = 58260fa1-4b15-5665-b684-0968b64e9b53
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_GiveVoloGoblinManuscript(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:58260fa1-4b15-5665-b684-0968b64e9b53
msgctxt "ha20ec19bg9d79g4651gbe74gfb2fff87e263"
msgid ""
"Take it. Maybe if I pray hard enough I can get some of that <i>booyahg</i> "
"for myself."
msgstr "가져가. 내가 열심히 기도하면 나도 그 <i>부야그</i>를 얻을 수 있을지도 몰라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Player
#. NodeID = 5d1d861c-6b0b-c0f2-f2e8-53870b11132e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:5d1d861c-6b0b-c0f2-f2e8-53870b11132e
msgctxt "hc728f22agd13fg4518g8028g02e9d584fea1"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Narrator
#. NodeID = 605bc0ad-e281-1455-53b5-8278ba2fc3fb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Tag:
#.     - TRUESOUL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:605bc0ad-e281-1455-53b5-8278ba2fc3fb
msgctxt "h1930e08bga046g4744g94cbg6387509488f1"
msgid ""
"*Your mind is full, bursting with ecstasy and terror. Finally, it is coming. "
"You are becoming.*"
msgstr "*당신의 정신이 황홀경과 공포로 가득 차오릅니다. 마침내, 때가 됐군요. 당신은 변화 중입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Player
#. NodeID = 61599032-2732-81d9-b8de-b63dddcbb6d1
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:61599032-2732-81d9-b8de-b63dddcbb6d1
msgctxt "hc60486d1gfbe8g48d0ga515g3a6a9c571c1d"
msgid ""
"We both know this book's rubbish, Piddle. Write your own, and I'll edit it "
"for you."
msgstr "이 책이 쓰레기라는 거 알잖아, 피들. 네가 직접 써. 내가 편집해 줄게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Booyahg Piddle
#. NodeID = 6246723b-17de-0512-29de-62bec0441264
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - GLO_Tadpole_SUB_Druid.LearnedPit(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:6246723b-17de-0512-29de-62bec0441264
msgctxt "hf4ffb58dg522ag43dega193gae8c93e8f354"
msgid ""
"He's probably down in the pens, fattenin' up the worgs like all the rest."
msgstr "아마 다른 놈들처럼 우리에서 워그 밥으로 쓰이고 있겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Booyahg Piddle
#. NodeID = 63bb9963-32dc-0249-d7d3-5852cdb3c07f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   User:
#.     - GOB_NerdyGoblinSage_State_ReadMind(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:63bb9963-32dc-0249-d7d3-5852cdb3c07f
msgctxt "h01c63709g545eg46a2ga069g5e3458ee5c7a"
msgid ""
"<i>This stuff ain't bad... but somebody who </i>really<i> knows the Absolute "
"should be writin' Her story.</i>"
msgstr "<i>이거 꽤 괜찮은데... 하지만 절대자님을 <i>제대로</i> 아는 놈이 그분 이야기를 써야 할 텐데 말이지.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Booyahg Piddle
#. NodeID = 642c9e37-e9d2-36e9-3964-377222e84344
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:642c9e37-e9d2-36e9-3964-377222e84344
msgctxt "hf60a26a9gf43bg4c9aga523g2af0158526ba"
msgid "S'pose you're right. Absolute rewards faith, not book-learnin'."
msgstr "그 말도 맞는 것 같네. 절대자님은 책 보는 게 아니라 신앙심을 원하시니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Booyahg Piddle
#. NodeID = 65cc5d68-a0db-48c2-7a1e-7974c88b142d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:65cc5d68-a0db-48c2-7a1e-7974c88b142d
msgctxt "h75d8edc3g0662g4cc7g8c55ga2f16b689bec"
msgid ""
"Still - only other stuff to read around 'ere is the filth Klagga scrawls in "
"the latrines."
msgstr "어쨌든, 여기 다른 읽을 거라고는 클라가가 변소에 끄적인 낙서밖에 없단 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Booyahg Piddle
#. NodeID = 71533abf-ba41-3a20-1522-d12c4f603b5a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:71533abf-ba41-3a20-1522-d12c4f603b5a
msgctxt "h705af916ga3a7g4c96gb447gb1e9cb053afc"
msgid ""
"Oh... Of <i>course</i>. Yeah, I'd have 'ad said that. Bit wordy though, "
"innit?"
msgstr "아... <i>물론이지.</i> 그래, 나도 그런 말을 하고 싶었어. 좀 단어가 고상하긴 하지, 안 그래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Player
#. NodeID = 71a2a539-4f8e-250a-f7eb-1ae968a9f0aa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   UserShape:
#.      - GOB_NerdySage_ToldVoloName(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:71a2a539-4f8e-250a-f7eb-1ae968a9f0aa
msgctxt "hf21e47bag6f43g43adg9639ga4e77cfa2677"
msgid "This writer - will he be fed to the worgs too?"
msgstr "이 작가 말인데, 그 사람도 워그 먹이가 될 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Narrator
#. NodeID = 74514161-3a9b-219f-3db8-3b6ab448c7e1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount6(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount6(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:74514161-3a9b-219f-3db8-3b6ab448c7e1
msgctxt "h40512154g57ebg4442ga8b2g32a9ea35018a"
msgid ""
"*The presence deep in your mind is awake, unblinking. This is it. A single "
"word pervades your consciousness: 'Soon'.*"
msgstr ""
"*당신의 정신 속 깊이 자리잡은 존재가 태연스레 깨어납니다. 올 것이 왔군요. 한 단어가 당신의 의식 속으로 스며듭니다. ‘곧’*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Booyahg Piddle
#. NodeID = 74a7634b-13b4-3f61-b0c1-faa4409aa7dd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:74a7634b-13b4-3f61-b0c1-faa4409aa7dd
msgctxt "h2ea2324cg10c2g44d2ga740g2079f743f5fc"
msgid "Bloody hell - an' people say <i>goblins</i> are savage."
msgstr "빌어먹을 - 이런데도 <i>고블린이</i> 야만적이라고 한다니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Player
#. NodeID = 767764b9-ab0a-3e24-94d2-32d70731b380
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:767764b9-ab0a-3e24-94d2-32d70731b380
msgctxt "h6bb94c48gc6b1g4290g9110g41a149582f22"
msgid "It means 'mephitic and vociferous.'"
msgstr "'극히 훤소하며 부취가 독하다.'란 뜻이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Player
#. NodeID = 77a34e59-cb12-26fa-9130-0187d086a2e0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:77a34e59-cb12-26fa-9130-0187d086a2e0
msgctxt "hf075aadbg8651g42ccg8d0dg0d6e144dafa4"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Player
#. NodeID = 77d8b18c-93b3-b1e4-1f62-522a4964ff2e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:77d8b18c-93b3-b1e4-1f62-522a4964ff2e
msgctxt "hea385e22g4151g4a86g96f8gfac96935293b"
msgid "What's <i>booyahg</i>?"
msgstr "<i>부야그</i>가 뭐야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Player
#. NodeID = 79419667-f88a-195d-c44f-6a81f9276e2d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   UserShape:
#.      - GOB_NerdySage_ToldVoloName(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:79419667-f88a-195d-c44f-6a81f9276e2d
msgctxt "h019ac136g4bdfg4e18g8e3cg7ac504b1f715"
msgid "And Volo - will he be fed to the worgs too?"
msgstr "그럼 볼로는, 그 사람도 워그 먹이가 될 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Booyahg Piddle
#. NodeID = 7a24f29b-7d7a-62cc-1e4b-5bbf05ab5308
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_NerdyGoblinSage_HasMet(1) = True
#.   Object:
#.      - GOB_HasVoloGoblinManuscript(0) = True
#.   UserShape:
#.      - GOB_NerdyGoblinSage_State_TriedPersuasion(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:7a24f29b-7d7a-62cc-1e4b-5bbf05ab5308
msgctxt "he5dbcc6bg152eg4805g937bgb76bf0723cd2"
msgid "Huh? What do you want? I'm <i>tryin'</i> to concentrate on readin'!"
msgstr "엉? 뭐야? 이거 읽는 데 <i>좀</i> 집중하려고 하잖아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Booyahg Piddle
#. NodeID = 7ad650cd-0eae-17f3-ca65-881fadbe793d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:7ad650cd-0eae-17f3-ca65-881fadbe793d
msgctxt "h08ba9c8cg0df4g4bebga571gc1dc7cbd6b8b"
msgid ""
"There were some troublemakers, but they're either dead or wishing they were. "
"Don't know if there was a druid though."
msgstr "문제를 일으키던 놈들은 있었는데, 이제 다 죽거나 죽여달라고 빌고 있지. 드루이드가 있었는지는 모르겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Booyahg Piddle
#. NodeID = 7fc952c2-8f01-2b5c-0178-badae93951ff
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_State_WyllLearnedAllLeaders = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:7fc952c2-8f01-2b5c-0178-badae93951ff
msgctxt "h55410aeeg7eb2g4130g8d85g343b05121d0a"
msgid ""
"They have the kinda <i>booyahg</i> that comes from bein' chosen by a "
"<i>god</i>."
msgstr "다들 <i>신</i>에게 선택받아야 가능한 <i>부야그</i>가 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Booyahg Piddle
#. NodeID = 82394cc1-0109-7adc-b590-c7f28ab8e4bb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:82394cc1-0109-7adc-b590-c7f28ab8e4bb
msgctxt "h5b770e9cg5167g4922gb78ag2df76aae8f50"
msgid "That's some impressive <i>booyahg</i>. Absolute must <i>like</i> ya."
msgstr "그거 참 대단한 <i>부야그</i>군. 절대자께서 댁을 정말로 <i>좋아하시는</i> 모양이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Player
#. NodeID = 8a1d62d7-eae3-0030-515d-af90930febe8
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - CLERIC(1) = True
#.   UserShape:
#.      - GOB_NerdyGoblinSage_State_TriedPersuasion(1) = False
#. SetFlags:
#.   UserShape:
#.     - GOB_NerdyGoblinSage_State_TriedPersuasion(1) = True
#. TagRule: CLERIC or PALADIN
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:8a1d62d7-eae3-0030-515d-af90930febe8
#, fuzzy
msgctxt "h1e875ae4gacecg4251gb401g53ffa74db38f"
msgid "You should spend your time in prayer - not reading this nonsense."
msgstr "그럴 시간에 기도를 더 하는 게 어떨까, 이런 허무맹랑한 헛소리는 그만 읽고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Booyahg Piddle
#. NodeID = 8aab7053-809c-256c-997e-d1b0ba27a000
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_State_WyllLearnedAllLeaders = True
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_Quest_Learnt3LeadersTwoNames = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:8aab7053-809c-256c-997e-d1b0ba27a000
msgctxt "h5321155bge4eeg4962g95b6gbec4beb44be7"
msgid ""
"Priestess Gut and our boss Ragzlin, are fearsome powerful now. Same as that "
"drow."
msgstr "거트 여사제와 우리 대장 라그즐린. 둘 다 이제 무시무시하게 강해졌지. 그 드로우처럼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Player
#. NodeID = 9382b53f-8da8-dab3-ec6c-2ec75e729973
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - CLERIC(1) = False
#.   UserShape:
#.      - GOB_NerdyGoblinSage_State_TriedPersuasion(1) = False
#. SetFlags:
#.   UserShape:
#.     - GOB_NerdyGoblinSage_State_TriedPersuasion(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:9382b53f-8da8-dab3-ec6c-2ec75e729973
msgctxt "h8287a6f8g0eefg4f0dga0aegdcf079947f64"
msgid "You should spend your time in prayer - not reading this nonsense."
msgstr "그럴 시간에 기도를 더 하는 게 어떨까, 이런 허무맹랑한 헛소리는 그만 읽고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Player
#. NodeID = 99b72386-3a6e-9a3e-e797-5f859666f580
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_IsMissing = True
#. SetFlags:
#.   UserShape:
#.     - GOB_NerdyGoblinSage_DiscussedHalsin(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:99b72386-3a6e-9a3e-e797-5f859666f580
msgctxt "hb07251f9g31bcg4c8ag98e8g5b75330477ee"
msgid "Have you met any other interesting people? A druid, perhaps?"
msgstr "다른 재미있는 사람은 안 만났나? 드루이드라든가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Booyahg Piddle
#. NodeID = 9bba27fb-6bc0-4246-e528-40ec12cc2526
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_GiveVoloGoblinManuscript(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:9bba27fb-6bc0-4246-e528-40ec12cc2526
msgctxt "hbbce01e9g3944g4751gb6e8g52e35a572a7e"
msgid "It ain't worth fightin' over. Take it!"
msgstr "겨우 이런 걸로 싸우겠나. 가져가!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Player
#. NodeID = a4b758c5-0a49-7044-ef2a-0b742999c0ec
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 0
#. CheckFlags:
#.   Script:
#.      - GEN_CanDetectThoughts_2 = True
#.   User:
#.      - GOB_NerdyGoblinSage_State_ReadMind(1) = False
#.   UserShape:
#.      - GOB_NerdyGoblinSage_State_TriedReadMind(1) = False
#. SetFlags:
#.   UserShape:
#.     - GOB_NerdyGoblinSage_State_TriedReadMind(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:a4b758c5-0a49-7044-ef2a-0b742999c0ec
msgctxt "he88f1b1dgd68bg40b7g828bg63a84d4a9667"
msgid "<i>Scan his mind.</i>"
msgstr "<i>그의 생각을 읽는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Narrator
#. NodeID = aa1138c7-4a03-e1e5-8eb4-c326c5daf24b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount3(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount3(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:aa1138c7-4a03-e1e5-8eb4-c326c5daf24b
msgctxt "hde69dbd2gaa8eg4548gbe32g581fa1571f12"
msgid "*Your mind lurches, reeling suddenly as if... bitten.*"
msgstr "*뭔가에 깨물린 것처럼 느닷없이 정신이 휘청거립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Player
#. NodeID = abf46b53-d44e-a78f-9d12-76750b436113
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:abf46b53-d44e-a78f-9d12-76750b436113
msgctxt "h7f569752gad9fg4933g97fcgf7d0069ee039"
msgid "And? Has your tribe's power increased?"
msgstr "그럼? 너희 부족의 힘은 증가했나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Booyahg Piddle
#. NodeID = b1ecc0c2-c758-d81b-ed46-1e6d233b9c2f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:b1ecc0c2-c758-d81b-ed46-1e6d233b9c2f
msgctxt "h7f0e5d67g3524g4ee5g86b2gbcc4c8e42c7e"
msgid "And that's what I'm gonna do. So buzz off."
msgstr "지금 그러려고 하는 중이고. 그러니 꺼지쇼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Booyahg Piddle
#. NodeID = b2338c3e-1c69-4e86-fbe5-c7293750772d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_Checkpoint_State_Paint(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:b2338c3e-1c69-4e86-fbe5-c7293750772d
msgctxt "h64f6dc21g8a2bg42e5g9669g8e1675349b20"
msgid "Ain't that the truth! Proper stink around here now we've settled in."
msgstr "맞는 말이네! 이제 우리가 자리를 잡으니 슬슬 냄새가 제대로 난다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Narrator
#. NodeID = b98c34ba-a576-7620-fa7b-2980cd4d5e5e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - GLO_TadpoleIntro_NPC(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:b98c34ba-a576-7620-fa7b-2980cd4d5e5e
msgctxt "h56ffa91fge31bg4ed1gb122g3c68ddaf23f7"
msgid "*As the symbol glows, power courses through you. <i>Authority</i>.*"
msgstr "*문양이 빛나며, 몸에 흐르는 힘이 느껴집니다. <i>권위</i>.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Narrator
#. NodeID = bafa63ee-fd74-238b-03d0-422c5eaa67ce
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount5(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount5(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:bafa63ee-fd74-238b-03d0-422c5eaa67ce
msgctxt "hba0e79f7g4b95g4df4g924agf74d32f5ba4a"
msgid ""
"*Your blood runs quicker, feeding the gnawing absence at the centre of your "
"mind.*"
msgstr "*피가 더 빨리 흐르면서, 당신의 정신 한가운데를 좀먹는 허전함을 양분으로 채웁니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Player
#. NodeID = bec3605b-437d-3f55-f85f-54742b18873b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:bec3605b-437d-3f55-f85f-54742b18873b
msgctxt "h6b9a919dgb26cg4208ga276ga30c0e5071be"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Booyahg Piddle
#. NodeID = c77da644-e221-18fc-bc02-d97df8b3fd81
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_State_WyllLearnedAllLeaders = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:c77da644-e221-18fc-bc02-d97df8b3fd81
msgctxt "h087ba3b3g8175g4469ga388g38fb51469e1d"
msgid ""
"They have the kinda <i>booyahg</i> that comes from bein' chosen by a "
"<i>god</i>."
msgstr "다들 <i>신</i>에게 선택받아야 가능한 <i>부야그</i>가 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Booyahg Piddle
#. NodeID = cce37446-54b8-463a-fd94-fcd4063f5441
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:cce37446-54b8-463a-fd94-fcd4063f5441
msgctxt "h227cd646gab6fg4d1bgb77age2734b645040"
msgid "Wanna fight? Take your best shot."
msgstr "싸우자고? 어디 한번 해 보든가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Booyahg Piddle
#. NodeID = d1eb7a7c-7b8c-ae5b-dbb1-58c0a7260421
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:d1eb7a7c-7b8c-ae5b-dbb1-58c0a7260421
msgctxt "hd3c73dbeg3c97g4dc7gab76gb58f24cba66f"
msgid "Hard enough readin' this without you stinkin' up the place."
msgstr "안 그래도 읽기 힘든데 고약한 냄새까지 풍기고 있잖수."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Booyahg Piddle
#. NodeID = d706da56-83d5-b11a-773e-f467e04771fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:d706da56-83d5-b11a-773e-f467e04771fe
msgctxt "hb9ccc490g8696g4827g9688ge614c7af4498"
msgid ""
"You're right! What does some bleedin' outsider know that I don't? I'll be "
"famous!"
msgstr "맞아! 이 망할 외부인 놈이 대체 나보다 뭘 더 잘 안다고? 내가 유명해져야지!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Booyahg Piddle
#. NodeID = d7f38d78-954d-fc1b-8824-4e9ede5f8afe
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_NerdyGoblinSage_DropBook(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:d7f38d78-954d-fc1b-8824-4e9ede5f8afe
msgctxt "h2840bc1fgea6bg4249gb13bga44b3bfaaadf"
msgid "And <i>nobody </i>will remember this pack of lies."
msgstr "<i>아무도</i> 이런 거짓부렁이는 기억도 못 하겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Player
#. NodeID = d84f7de5-da44-0a6f-c1e8-50bb936ffe49
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - GOB_NerdyGoblinSage_State_ReadMind(1) = True
#.   UserShape:
#.      - GOB_NerdyGoblinSage_State_TriedPersuasion(1) = False
#. SetFlags:
#.   UserShape:
#.     - GOB_NerdyGoblinSage_State_TriedPersuasion(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:d84f7de5-da44-0a6f-c1e8-50bb936ffe49
msgctxt "hac4cd093g6f6dg4aa8g8cf9ge7ef1b822162"
msgid ""
"You're an authority on the Absolute <i>- you </i>should be the one writing "
"about it."
msgstr "넌 절대자에 대해 잘 알잖아. 오히려 <i>네가</i> 글을 써야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Booyahg Piddle
#. NodeID = dbf27ff0-548a-ed39-4c2f-1d5f8b244c2a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:dbf27ff0-548a-ed39-4c2f-1d5f8b244c2a
msgctxt "h1a1f7a87ga63fg428ag85cega4e468497d94"
msgid "An' all that ruckus makes it hard to concentrate on reading."
msgstr "소란 때문에 읽는 데 집중을 못 하겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Booyahg Piddle
#. NodeID = de690d01-54af-8b0c-e26f-930fe8508928
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:de690d01-54af-8b0c-e26f-930fe8508928
msgctxt "h0666181cgeca0g4ad5g8463g49a55922ffb0"
msgid ""
"Belonged to some bloke that showed up here askin' questions. Bold as a "
"bugbear, he woz!"
msgstr "여기 갑자기 마구 질문하러 찾아왔던 친구 물건이지. 용기는 버그베어 뺨치더만!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Booyahg Piddle
#. NodeID = dffd71ca-4315-3255-9a72-4d07925e7cea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:dffd71ca-4315-3255-9a72-4d07925e7cea
msgctxt "hbfb938b2g7d79g41eag85abg251dcc2f3be1"
msgid "Yeah, he mentioned that. About a thousand times."
msgstr "그래, 그런 말을 했지. 한 수천 번을."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Player
#. NodeID = e228d120-ee36-05e9-65fa-12d8974ead05
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 5
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#.      - ILLITHID(1) = True
#.   UserShape:
#.      - GOB_NerdyGoblinSage_State_TriedPersuasion(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(1) = True
#.   UserShape:
#.     - GOB_NerdyGoblinSage_State_TriedPersuasion(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:e228d120-ee36-05e9-65fa-12d8974ead05
msgctxt "hb4ddafc8ge318g42fcg92c1gb36b00bdaeb3"
msgid "You will give me the book."
msgstr "그 책 내놔."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Player
#. NodeID = e7756bbd-2cbc-36ec-b8bb-fcd09b2044bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:e7756bbd-2cbc-36ec-b8bb-fcd09b2044bf
msgctxt "hbd608850g2ec4g4505ga555g5939d235554c"
msgid "What was so interesting about him?"
msgstr "그 사람이 뭐가 그렇게 흥미로웠는데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Booyahg Piddle
#. NodeID = f01e9845-7075-8d40-f03b-c5c2abe5fd7f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_NerdyGoblinSage_HasMet(1) = False
#.   Object:
#.      - GOB_HasVoloGoblinManuscript(0) = True
#. SetFlags:
#.   Dialog:
#.     - GOB_NerdyGoblinSage_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:f01e9845-7075-8d40-f03b-c5c2abe5fd7f
msgctxt "h7b2b907ag455dg4cdega146g30c9bb3e0dfd"
msgid ""
"Here - help us out. Sez here that 'goblinoids are obstreperous and "
"malodorous<i>'</i>. What's that mean?"
msgstr "이봐, 이것 좀 봐주쇼. 여기 <i>'고블린 종들은 요란하고 악취를 풍긴다.'</i>고 적혀있는데, 뭔 뜻이여?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Booyahg Piddle
#. NodeID = f04c2e5d-15a4-62e4-502b-759b21501343
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:f04c2e5d-15a4-62e4-502b-759b21501343
msgctxt "he0386994g0fb8g427fgba35gc43bbb8be9e6"
msgid "Half the camp'll tear into ya before you have a chance to regret it."
msgstr "아차하는 사이에 여기 놈들 절반이 그쪽을 찢어놓을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Wyll
#. NodeID = f10a4608-98a7-ec30-0fda-bec2df3ab0e1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_State_WyllLearnedAllLeaders = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:f10a4608-98a7-ec30-0fda-bec2df3ab0e1
msgctxt "hd6c23cd3g6494g48ddg8bd2g1a05917e3712"
msgid "Seems we've pegged all three marks. Let the boss hunt begin."
msgstr "목표 셋을 모두 찾은 것 같아. 우두머리 사냥을 시작하자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Booyahg Piddle
#. NodeID = f230da56-ebbb-fa46-18dd-41ec9909836a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:f230da56-ebbb-fa46-18dd-41ec9909836a
msgctxt "haa26deecgcca9g420fgad5fge6c232136b9a"
msgid ""
"Bit confusin', cuz it sez we're 'feeble-minded weaklings' right before that."
msgstr "좀 이상하네. 여기 바로 앞에서는 '저능아 약골'이라고 적었거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Booyahg Piddle
#. NodeID = f331fcb2-9429-37cc-e23d-3a4b412a122e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:f331fcb2-9429-37cc-e23d-3a4b412a122e
msgctxt "h748f0833gbdb4g4d0bg9d5agc693d5f849d8"
msgid ""
"I ain't finished with it! There's enough readin' here to last me a lifetime."
msgstr "나도 아직 안 끝났어! 여기 있는 글이면 평생 읽을 수 있겠는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Booyahg Piddle
#. NodeID = f40d28b7-07fa-dd9f-0929-ee27d30997a0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:f40d28b7-07fa-dd9f-0929-ee27d30997a0
msgctxt "h878e1aa4g88deg48ddgbf24g1798195aac4f"
msgid "Don't matter how <i>famed</i> he is; he's gonna end up as supper."
msgstr "얼마나 <i>유명하든</i> 무슨 소용이람. 어차피 저녁 식사가 될 건데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Booyahg Piddle
#. NodeID = f6dec422-0f93-c49b-3383-3cf130d4142c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_State_WyllLearnedAllLeaders = False
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_Quest_Learnt3LeadersTwoNames = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:f6dec422-0f93-c49b-3383-3cf130d4142c
msgctxt "h03bfe8d5gc0f0g4f63g9c8bg6a372282919e"
msgid ""
"Priestess Gut and our boss Ragzlin, are fearsome powerful now. Same as that "
"drow."
msgstr "거트 여사제와 우리 대장 라그즐린. 둘 다 이제 무시무시하게 강해졌지. 그 드로우처럼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Booyahg Piddle
#. NodeID = f708c11d-da90-b623-dc6c-50af16c1e644
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_NerdyGoblinSage_HasMet(1) = False
#.   Global:
#.      - GOB_VoloBallad_State_NerdySageGotVolosBook = True
#.   Object:
#.      - GOB_HasVoloGoblinManuscript(0) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_NerdyGoblinSage_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:f708c11d-da90-b623-dc6c-50af16c1e644
msgctxt "hdfc1b953gc141g4951g82a8g907f5becd916"
msgid "Wish I had my book back - think it was one of your mates who took it."
msgstr "내 책이 있었으면 좋겠어. 당신 친구 중 하나가 가져간 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Booyahg Piddle
#. NodeID = f7fe0446-f0b1-54ba-b8dc-b68fbdcc7ca4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:f7fe0446-f0b1-54ba-b8dc-b68fbdcc7ca4
msgctxt "h68fa6191g67abg4d95g965egfcb9b5567be4"
msgid ""
"I pray plenty. Day and night. Don't mean I can't educate myself as well."
msgstr "난 기도는 이미 많이 해. 밤낮으로. 그거랑 내가 교양을 쌓는 건 별개지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Booyahg Piddle
#. NodeID = f8753056-a2ce-4e9c-8808-5630ddd61bd2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:f8753056-a2ce-4e9c-8808-5630ddd61bd2
msgctxt "h696bd9fag8d63g4aeag9429ge3935cd688fc"
msgid "I had a good chinwag with him though. Interestin' bloke."
msgstr "그래도 나는 같이 수다 좀 재밌게 떨었어. 흥미로운 친구였지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Booyahg Piddle
#. NodeID = f89ede8d-07f4-8f3f-903c-1dfffcca70c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:f89ede8d-07f4-8f3f-903c-1dfffcca70c4
msgctxt "h99f6a679g7252g40cagb6e0g0368b067942b"
msgid "Magic. Them wot the Absolute chooses are brimmin' with it."
msgstr "마법. 절대자님이 선택한 자는 마법의 힘이 흘러넘쳐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute
#. Speaker = Narrator
#. NodeID = 00ac9799-df04-cf66-5aec-85fe4d761c3f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute:00ac9799-df04-cf66-5aec-85fe4d761c3f
msgctxt "h911def7eg50ddg45dcg84c1gcce920466238"
msgid ""
"*Then, there are three figures before you. An armoured male elf, exuding "
"power and command. A handsome younger man with a quick, easy smile. And a "
"pale young woman with even paler eyes...*"
msgstr ""
"*그러더니 눈 앞에 세 명의 인물이 나타납니다. 갑옷을 착용하고 강력한 힘과 권위가 느껴지는 엘프 남성, 조금 더 어리고 밝은 미소를 "
"띠고 있는 잘생긴 남성. 그리고 창백한 피부와 그보다 더 창백한 눈을 지닌 어린 여성...*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute
#. Speaker = Player
#. NodeID = 0f0a1493-ba93-db55-8674-2b45c1e442e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute:0f0a1493-ba93-db55-8674-2b45c1e442e2
msgctxt "h07ed1f0cg3a4dg41acg99a7g53a8b2d98756"
msgid "<i>Examine the artefact.</i>"
msgstr "<i>아티팩트를 조사한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute
#. Speaker = Karlach
#. NodeID = 28858ac3-e7ff-4fea-b21d-60cffc410539
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute:28858ac3-e7ff-4fea-b21d-60cffc410539
msgctxt "hef929bd8g46a2g43ecg8f9eg2b5899004633"
msgid "That thing's shielding us. Incredible."
msgstr "저게 우릴 보호해주고 있어. 놀라운걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute
#. Speaker = Astarion
#. NodeID = 2b3b450c-4939-9724-f4ea-1d4e700dcc1b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute:2b3b450c-4939-9724-f4ea-1d4e700dcc1b
msgctxt "h0296221fg1cc7g412dg8c72g77bd01d4ac53"
msgid "What are you doing?! My head - I can't..."
msgstr "뭐 하는 거야?! 내 머리. 이런..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute
#. Speaker = Lae'zel
#. NodeID = 35882ff8-45b0-4b88-811d-53eb6ec2d6b9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute:35882ff8-45b0-4b88-811d-53eb6ec2d6b9
msgctxt "h9eff8235g804cg46acgb9d9g87802e258f62"
msgid "The voice is quelled. The artefact's doing..."
msgstr "목소리가 사라졌다. 아티팩트 덕분이군..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute
#. Speaker = Wyll
#. NodeID = 39d3876a-7919-4451-bd17-8f8e4c37a85d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(6) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute:39d3876a-7919-4451-bd17-8f8e4c37a85d
msgctxt "heb5c61fcg3aa5g4484gb0b6g8c39da0a14b0"
msgid "Gone - just like that. That relic works in mysterious ways."
msgstr "사라졌군, 아주 간단히 말이야. 그 신비로운 유물이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute
#. Speaker = Narrator
#. NodeID = 4069e1d1-722f-8220-12dd-cbf949068640
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute:4069e1d1-722f-8220-12dd-cbf949068640
msgctxt "hf518ac10gf4c1g4117g882cgc172e94147ec"
msgid ""
"*Your vision clouds, leaving you in a dark, featureless shadowscape. "
"Nothingness in every direction.*"
msgstr "*시야가 흐려지고, 주변의 모든 것이 사라지며 칠흑 같은 어둠만이 남습니다. 어떤 방향을 둘러봐도 아무것도 보이지 않습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute
#. Speaker = Disembodied Voice
#. NodeID = 4947f97e-62bc-4ec2-8869-808ac5560670
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute:4947f97e-62bc-4ec2-8869-808ac5560670
msgctxt "h837a288eg52b6g42d3g962eg05108eb8c5de"
msgid "<b><i>These are my Chosen. They speak for me.</i></b>"
msgstr "<b><i>이들은 내가 선택한 자들이니. 내 목소리를 대변하노라.</i></b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute
#. Speaker = Disembodied Voice
#. NodeID = 577bab33-2ae3-2763-6295-54644ad78495
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Orpheus_State_PartyWasFaintedByVoice = True
#.      - GLO_InfernalBox_State_TeamHasBox = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute:577bab33-2ae3-2763-6295-54644ad78495
msgctxt "he786346ag2c0bg46aeg94afgace30997ffd4"
msgid ""
"<b><i>There is no escape from my voice. There is no escape from your "
"destiny.</i></b>"
msgstr "<b><i>내 목소리에서 벗어날 순 없다. 네 운명에서 벗어날 순 없다.</i></b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute
#. Speaker = Wyll
#. NodeID = 675f3fc0-2823-df89-bc4f-3fcf5c40560d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(6) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute:675f3fc0-2823-df89-bc4f-3fcf5c40560d
msgctxt "hc8a8cd3fg286dg429bg9049g6c8782d71bcb"
msgid "Gods damn it. My head..."
msgstr "이런 망할. 내 머리..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute
#. Speaker = Karlach
#. NodeID = 82d35382-4ebf-7eec-022c-26048f9ade85
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute:82d35382-4ebf-7eec-022c-26048f9ade85
msgctxt "hf55919fag540ag4beagb2fag74c439927a5a"
msgid "My head... oh gods, my <i>head!</i>"
msgstr "머리가... 윽, 맙소사, <i>머리가 아파!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute
#. Speaker = Gale
#. NodeID = 890a0972-4d79-46bd-b991-a22180fc1a8a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GALE(7) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute:890a0972-4d79-46bd-b991-a22180fc1a8a
msgctxt "h7b80c011g44d6g44cfg9339gb105234ab130"
msgid "The artefact is... protecting us? And not a moment too soon."
msgstr "아티팩트가... 우릴 지키고 있어? 극적인 타이밍이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute
#. Speaker = Narrator
#. NodeID = a84061ac-fe7a-44ed-6515-2eba5c6161eb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute:a84061ac-fe7a-44ed-6515-2eba5c6161eb
msgctxt "h566532e7g0dfbg4dfcgaee2g2a99795d9823"
msgid ""
"*The voice is irresistible. Every word is drenched with a power and "
"authority that you do not understand, but cannot deny.*"
msgstr "*거역할 수 없는 목소리입니다. 모든 단어에 이해할 수 없는 힘과 권위가 느껴지며, 거부할 수 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute
#. Speaker = Narrator
#. NodeID = afe0baf1-e902-ab11-2d72-1445031e6a63
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute:afe0baf1-e902-ab11-2d72-1445031e6a63
msgctxt "h9b5fb047g3263g4fb8gb59eg3d5defc781f7"
msgid "*...then there is nothing. Only darkness and silence.*"
msgstr "*...그러더니 아무것도 남지 않습니다. 어둠과 침묵만이 남아 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute
#. Speaker = Narrator
#. NodeID = bdf8c9a8-c9a8-1a10-5d47-ebade8136481
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Tadpoled_PartyUsed = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute:bdf8c9a8-c9a8-1a10-5d47-ebade8136481
msgctxt "h0dd2ec71g4a20g40d2g940fg1f5f204e8773"
msgid ""
"*The voice is irresistible. You recognise the overwhelming authority that "
"you've used on others, only infinitely stronger...*"
msgstr ""
"*거역할 수 없는 목소리입니다. 당신이 다른 이들에게 사용했던 압도적인 권위와 비슷하다는 사실을 깨닫습니다, 하지만 그것과는 비교도 할 "
"수 없을 만큼 강력합니다...*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute
#. Speaker = Narrator
#. NodeID = c128193f-a2f9-6a46-0412-db16e1366177
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute:c128193f-a2f9-6a46-0412-db16e1366177
msgctxt "h34d6b837ga4fbg4ab6g829agc4a34e9e14cc"
msgid ""
"*The pain in your head swells, pushing out any thoughts. The three figures "
"fade away...*"
msgstr "*고통이 머릿속을 가득 채우며, 다른 생각은 떠오르지도 않습니다. 세 인물이 점점 사라집니다...*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute
#. Speaker = Narrator
#. NodeID = c726907d-8122-b974-97e5-d0aef06a3a51
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute:c726907d-8122-b974-97e5-d0aef06a3a51
msgctxt "hd40e077ag3351g4d30gbe3cg482b62d3db66"
msgid ""
"*No answer presents itself. The artefact is dormant. The voice and visions "
"are gone.*"
msgstr "*어떤 답도 들려오지 않습니다. 아티팩트는 다시 휴면 상태로 돌아갔습니다. 목소리와 환영도 사라졌습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute
#. Speaker = Narrator
#. NodeID = c880b68b-8380-13c2-6ef1-98439391d1bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute:c880b68b-8380-13c2-6ef1-98439391d1bf
msgctxt "hcc2b9d46g10b9g49c5gaa90g10c311b54bcd"
msgid "*Whatever power the artefact possesses, it shows no sign of it now.*"
msgstr "*아티팩트에 어떤 힘이 담겨있는지는 모르지만, 이제 어떤 기운도 느껴지지 않습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute
#. Speaker = Player
#. NodeID = d73e5ae4-ffb1-cd5f-3df5-2dd4942d1b72
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute:d73e5ae4-ffb1-cd5f-3df5-2dd4942d1b72
msgctxt "h277ff1edg27d5g454agb94cg629c5ccf82d9"
msgid "That voice... those visions. What just happened?"
msgstr "그 목소리... 환영. 방금 무슨 일이 있었던 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute
#. Speaker = Disembodied Voice
#. NodeID = d852f9ae-f43d-daff-7fca-308b690e9099
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute:d852f9ae-f43d-daff-7fca-308b690e9099
msgctxt "he24c3b47g3917g4577g8489g3511391ae072"
msgid ""
"<b><i>My power grows. My forces gather. The reckoning draws near...</i></b>"
msgstr "<b><i>내 힘이 커진다. 내 군세가 모인다. 심판의 시간이 다가오고 있노라...</i></b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute
#. Speaker = Disembodied Voice
#. NodeID = dad1e754-92b5-f53d-5bce-e080e94a0168
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute:dad1e754-92b5-f53d-5bce-e080e94a0168
msgctxt "h4b70250bg56dfg4b0bga2b4g3d7abc538f4e"
msgid "<b><i>Hear my voice. Obey my command.</i></b>"
msgstr "<b><i>내 목소리를 들어라. 내 명령에 따르라.</i></b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute
#. Speaker = Lae'zel
#. NodeID = dfb206a7-7c70-67f9-9abf-65ee13fa1848
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute:dfb206a7-7c70-67f9-9abf-65ee13fa1848
msgctxt "h9fddf997gae1dg405fg895ag0a16bb7c8140"
msgid "By Vlaakith, get out of my head!"
msgstr "블라키스의 이름으로, 내 머리에서 당장 나가!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute
#. Speaker = Astarion
#. NodeID = e2540694-5c76-429b-bf5c-c0fc490df061
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute:e2540694-5c76-429b-bf5c-c0fc490df061
msgctxt "had884719g0db0g44a3g8486ge5ab06fca3fe"
msgid "How is it shielding us? And why? Not that I'm complaining."
msgstr "어떻게 우릴 지켜주고 있는 거지? 어째서? 불만이라는 건 아니지만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute
#. Speaker = Gale
#. NodeID = f1e18b33-cf2a-6c63-0e48-5f9ee9b1657e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GALE(7) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute:f1e18b33-cf2a-6c63-0e48-5f9ee9b1657e
msgctxt "h98562d7cgd741g4f0cg9b6egfe431ba154f3"
msgid "My brain is bursting from my temples..."
msgstr "관자놀이가 터질 듯이 아파..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute
#. Speaker = Disembodied Voice
#. NodeID = f62bc40b-6093-9374-533a-4b2fe33e1375
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute:f62bc40b-6093-9374-533a-4b2fe33e1375
msgctxt "hdf63a020gbe9dg4349g9aa9gd35af40d0cd4"
msgid ""
"<b><i>Aid their search for the weapon, and you will be worthy to stand "
"beside them. In my presence.</i></b>"
msgstr "<b><i>이들의 무기 수색을 도와라, 그리하면 내 곁에서 이들과 나란히 할 자격을 얻을 것이다.</i></b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute
#. Speaker = Narrator
#. NodeID = f76b540c-a550-142f-9059-e98a768eaaf7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_InfernalBox_State_TeamHasBox = True
#. TagRule: REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute:f76b540c-a550-142f-9059-e98a768eaaf7
msgctxt "he7a58e4bg5ed7g4628g9a29ga947df1ade78"
msgid ""
"*The visions fade and the voice falters. A strange energy swells around you. "
"The githyanki heirloom - somehow, you understand it's repelling the "
"presence.*"
msgstr ""
"*환영과 목소리가 사라집니다. 묘한 에너지가 당신을 에워쌉니다. 어떻게 된 것인지는 모르겠지만, 기스앙키 보물이 당신을 지켜주고 있다는 "
"사실이 이해됩니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute
#. Speaker = Narrator
#. NodeID = f76b540c-a550-142f-9059-e98a768eaaf7
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_InfernalBox_State_TeamHasBox = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute:f76b540c-a550-142f-9059-e98a768eaaf7
msgctxt "h32b30a90g2ec2g4232g9b24g28b10d8b3111"
msgid ""
"*The visions fade and the voice falters as a strange energy swells around "
"you. The many-sided artefact - somehow, you understand it's repelling the "
"presence.*"
msgstr ""
"*묘한 에너지가 당신을 감싸더니, 환영과 목소리가 사라집니다. 어떻게 된 것인지는 모르겠지만, 다면체 아티팩트가 당신을 지켜주고 있다는 "
"사실이 이해됩니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute
#. Speaker = Player
#. NodeID = fa377e55-d96c-2cc1-fbc1-42bfab88589f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute:fa377e55-d96c-2cc1-fbc1-42bfab88589f
msgctxt "h16b16435gb52eg45b4g90c5g1a733de86c62"
msgid "<i>Put the artefact away.</i>"
msgstr "<i>아티팩트를 집어넣는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Player
#. NodeID = 0000a0c1-c196-40c4-d746-38232526ab0f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ShadowHeart_InParty_Knows_SharWorshipper = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:0000a0c1-c196-40c4-d746-38232526ab0f
msgctxt "hc2abc374g9a1eg48e3ga491g22061c1ca24c"
msgid "If you don't know what it is, how do you have it?"
msgstr "이게 뭔지도 모른다면서, 어떻게 들고 있는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Player
#. NodeID = 01b324c4-912e-7a29-43d8-5203d09c41b2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:01b324c4-912e-7a29-43d8-5203d09c41b2
msgctxt "h6f59c06bg9085g4bcbgb6e6g3e3d955a328b"
msgid "I don't know how I feel about this."
msgstr "이걸 어떻게 받아들여야 할지 모르겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Player
#. NodeID = 04d8ee9b-96d4-a892-9a08-c00d858855d7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox_SharDiscussed(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:04d8ee9b-96d4-a892-9a08-c00d858855d7
msgctxt "h7c032367g8275g4096ga18fg1ecbf04711c7"
msgid "Your faith is your own concern, not mine."
msgstr "네 믿음은 내 알 바 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Player
#. NodeID = 07526001-f602-a8bb-eed8-2460845da64d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:07526001-f602-a8bb-eed8-2460845da64d
msgctxt "h427f4a0agf8a6g49a5gbb99g5e5410974453"
msgid "Agreed."
msgstr "그러자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Player
#. NodeID = 08641a93-fb45-0b1f-fc0d-24df3d85ae6f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox_BoxDiscussed(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:08641a93-fb45-0b1f-fc0d-24df3d85ae6f
msgctxt "h711b2454gff2ag48aag83bcg9dd43f255119"
msgid "How did you come into possession of that artefact exactly?"
msgstr "그 아티팩트를 정확히 어떻게 가지게 된 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Player
#. NodeID = 0976e0b4-a44b-9c38-1bdf-0219b6cd6317
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:0976e0b4-a44b-9c38-1bdf-0219b6cd6317
msgctxt "hb424d561g1ed9g4f4agaccdg30be5b3b326d"
msgid "You've got some explaining to do first - what is that thing you have?"
msgstr "설명부터 해줘야겠는데. 네가 들고 있는 그 물건은 뭐야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Player
#. NodeID = 0c27fa67-cae8-2277-1a98-798099e23bab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:0c27fa67-cae8-2277-1a98-798099e23bab
msgctxt "hd0346782g36bfg4011g9e9eg8c9132b68e7e"
msgid "<i>Drop the matter.</i>"
msgstr "<i>이야기를 관둔다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Shadowheart
#. NodeID = 0d3758ac-e136-c016-947e-9bd73877dd16
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:0d3758ac-e136-c016-947e-9bd73877dd16
msgctxt "h4568bb3egb3bag4fceg940bge64355651dee"
msgid "It's nothing, I swear."
msgstr "아무것도 아니야. 맹세해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Player
#. NodeID = 0f221d9d-e919-edbb-8bc6-8b85df2abc7a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:0f221d9d-e919-edbb-8bc6-8b85df2abc7a
msgctxt "hbd6fba04g2d60g48c7gaf10gd2347ca9adaa"
msgid "In future, I expect you to be honest. Let's leave it at that for now."
msgstr "앞으로는 네가 더 솔직하기를 기대할게. 지금은 여기까지만 말하자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Gale
#. NodeID = 1303b4df-80fc-e7ce-6af3-1d2571a27e00
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GALE(7) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:1303b4df-80fc-e7ce-6af3-1d2571a27e00
msgctxt "h4aead6b6g5c6fg45a8gb58dg75f4f75ff640"
msgid ""
"You worship Shar? Blimey. She and my beloved Mystra are not exactly friends."
msgstr "샤를 섬기고 있었다고? 어이쿠. 내 사랑 미스트라와 샤는 좋은 사이가 아닌데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Player
#. NodeID = 143251ff-201a-76d0-a2c4-bd9408f50fb9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox_BoxDiscussed(2) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox_BoxDiscussed(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:143251ff-201a-76d0-a2c4-bd9408f50fb9
msgctxt "h85b7861egd040g4b20gbb83g7fec73ba9015"
msgid "Hold on - at least tell me what it is first."
msgstr "잠깐, 최소한 그게 뭔지부터 설명해 줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Player
#. NodeID = 1484bc99-c35d-55fa-46d3-9067be5e9124
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:1484bc99-c35d-55fa-46d3-9067be5e9124
msgctxt "h77a07de4g4682g4317g8a27g957ebe14a054"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Shadowheart
#. NodeID = 160defeb-7acc-617b-dd16-8f7bdfb98a63
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:160defeb-7acc-617b-dd16-8f7bdfb98a63
msgctxt "hc38a0417gc813g491dg9ca0gfec2d34f43c8"
msgid "Gather your thoughts. Then perhaps we can talk some more."
msgstr "생각을 정리해. 그런 다음 다시 이야기하자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Narrator
#. NodeID = 18747611-546d-3adc-535f-27e6ee5d2eab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:18747611-546d-3adc-535f-27e6ee5d2eab
msgctxt "h8157c074g6918g42a2g9d45g9fda6281c2bd"
msgid ""
"*Your vision clouds, leaving you in a dark, featureless shadowscape. "
"Nothingness in every direction.*"
msgstr "*시야가 흐려지고, 주변의 모든 것이 사라지며 칠흑 같은 어둠만이 남습니다. 어떤 방향을 둘러봐도 아무것도 보이지 않습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Shadowheart
#. NodeID = 1b24cd98-2105-7af3-d0f1-20f8f6f0fced
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_Recruited(0) = True
#. SetFlags:
#.   Global:
#.     - GOB_Orpheus_State_HadVoiceOfAbsoluteEvent = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:1b24cd98-2105-7af3-d0f1-20f8f6f0fced
msgctxt "h016ff6a1ge902g499fgbe92gb2187d565516"
msgid ""
"Don't give me that look. I don't know what just happened any more than you "
"do. We should keep going."
msgstr "그런 눈으로 보지 마. 나도 방금 무슨 일이 벌어진 건지 전혀 모르니까. 계속 가자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Player
#. NodeID = 1c2a04f5-4939-dcb5-c6ee-110140555d15
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:1c2a04f5-4939-dcb5-c6ee-110140555d15
msgctxt "h2ed559bcg1cbcg4977ga08cg2b35435869af"
msgid "Not good enough. Explain yourself, or I'll cut you loose."
msgstr "충분하지 않아. 더 자세히 설명해, 아니면 널 추방할 테니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Player
#. NodeID = 1cc69985-6429-63b8-d201-25a024d02da9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:1cc69985-6429-63b8-d201-25a024d02da9
msgctxt "hea0b9b06g7e02g497egb7acg7a5c452dd69e"
msgid "Give me the artefact. Better if I hold onto it."
msgstr "아티팩트를 내놔. 내가 가지고 있는 게 더 좋겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Shadowheart
#. NodeID = 1d17dd19-22ac-57bf-a500-3d89b264b35e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:1d17dd19-22ac-57bf-a500-3d89b264b35e
msgctxt "h6f205653gd8afg4930gb794g1204df828919"
msgid ""
"True. I didn't think you'd react so pragmatically. Perhaps I should have "
"told you sooner."
msgstr "맞아. 네가 그렇게 합리적으로 받아들일 줄은 몰랐어. 더 일찍 말하는 게 나았을지도 모르겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Shadowheart
#. NodeID = 205fab4f-4a13-6360-7b03-02c7298425b1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - b11c5c4f-e06d-12fe-fa3e-f21f3a4f4708_LaezelInclusion = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:205fab4f-4a13-6360-7b03-02c7298425b1
msgctxt "hbc4cff7fg57b1g40ecga161g66c4c12a863b"
msgid ""
"Yes, and a lot of my people died in the process. I won't fail them - not "
"after what I saw your kind do to them."
msgstr ""
"그래, 그리고 그 과정에서 내 동료들이 많이 죽었어. 그들의 죽음을 헛되이 하지 않겠어, 네 동족들이 그들에게 한 짓을 본 후엔 그 "
"결심이 더 커졌을 뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Shadowheart
#. NodeID = 22033c99-76f5-9045-7ebc-94cb0ff4f62e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:22033c99-76f5-9045-7ebc-94cb0ff4f62e
msgctxt "hd530761cge2efg43c5gbcf2g447c295e0f81"
msgid "There - you have the truth, for all it's worth. Let's continue."
msgstr "자, 이게 네가 원하던 진실이야. 하고 싶은 말이 있으면 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Disembodied Voice
#. NodeID = 23f21170-99d2-3975-d978-16735d30985e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:23f21170-99d2-3975-d978-16735d30985e
msgctxt "h2d68bb07g0020g4086gb0c3g386a63bd76d8"
msgid ""
"<b><i>Aid their search for the Prism, and you will be worthy to stand beside "
"them. In my presence.</i></b>"
msgstr "<b><i>그들이 프리즘을 찾는 것을 도와라. 그리하면 내 곁에서 그들과 나란히 서게 되리라.</i></b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Player
#. NodeID = 256f909f-6aaa-a2e1-e9e6-09216a4f67f7
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_SHAR or PALADIN_SHAR
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:256f909f-6aaa-a2e1-e9e6-09216a4f67f7
msgctxt "hc8b23498g85f6g4c59gad59g2cad574e6c42"
msgid ""
"It's been some time since I met another faithful of Shar. Are you versed in "
"her teachings?"
msgstr "다른 샤 여신의 신도를 만난 건 아주 오랜만이네. 그녀의 가르침에 대해 잘 알고 있어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Shadowheart
#. NodeID = 26b0b38b-5b81-c786-945f-5f84b668e4df
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:26b0b38b-5b81-c786-945f-5f84b668e4df
msgctxt "h94b40abegd5d8g4cbag92c7g8356c2741809"
msgid "I wouldn't quite say that, but it'll be safe with me. Let's go."
msgstr "그렇다고는 못하겠지만, 나와 있으면 안전할 거야. 가자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Shadowheart
#. NodeID = 2769c257-db29-d2d5-4cfa-80a8c83ca03a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - Approval_AtLeast_10_For_Sp3(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:2769c257-db29-d2d5-4cfa-80a8c83ca03a
msgctxt "hf14c6fa6g4c54g4b70gbf51gd792f1af4f17"
msgid ""
"I don't know... not exactly. All I know is it's important I get it back to "
"Baldur's Gate. At any cost."
msgstr "나도 몰라... 정확히는. 내가 아는 건 이걸 발더스 게이트로 가져가는 것이 중요하다는 것뿐이야. 어떤 대가를 치러서라도."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Player
#. NodeID = 2bf80dd5-6fbc-1103-1c32-a56e86becff5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ShadowHeart_InParty_Knows_SharWorshipper = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:2bf80dd5-6fbc-1103-1c32-a56e86becff5
msgctxt "h42f58269gcc46g4926g8cf2gdf114436b03f"
msgid "There must be more to it - I need you to level with me."
msgstr "분명 뭔가 더 있을 거야. 내게 솔직하게 말해 줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Disembodied Voice
#. NodeID = 31cbda11-f3bb-8e67-4be3-dce68e6aa7e9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:31cbda11-f3bb-8e67-4be3-dce68e6aa7e9
msgctxt "h9691bfd0gbb5eg4124g8531gab109021b511"
msgid ""
"<b><i>My power grows. My forces gather. The reckoning draws near...</i></b>"
msgstr "<b><i>내 힘이 커진다. 내 군세가 모인다. 심판의 시간이 다가오고 있노라...</i></b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Player
#. NodeID = 31f41f99-a698-bf72-3aed-385b08f1df1c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:31f41f99-a698-bf72-3aed-385b08f1df1c
msgctxt "h91ac9a9eg0b75g431bg96b3gdb620c53c972"
msgid "Well, thank you for sharing."
msgstr "음, 말해 줘서 고마워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Shadowheart
#. NodeID = 33aa62b1-734e-2a80-8728-dfb2910abde2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:33aa62b1-734e-2a80-8728-dfb2910abde2
msgctxt "hbc2a32a6g7f4dg48e0ga83bg7130bccaf51e"
msgid "Trust me, I will. Let's keep going."
msgstr "날 믿어. 계속 나아가자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Player
#. NodeID = 3835fcc6-a723-3319-a8f2-6240a8a90534
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox_SharDiscussed(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:3835fcc6-a723-3319-a8f2-6240a8a90534
msgctxt "hd685223ag8a0bg4660g98c4g07ad34d7645d"
msgid "I want to know about your Shar worship before we go any farther."
msgstr "더 이상 나아가기 전에 네 샤 숭배에 대해 알아야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Player
#. NodeID = 3be8efd3-6091-1218-8b3b-dcd8bd6c4eaa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ShadowHeart_InParty_Knows_SharWorshipper = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:3be8efd3-6091-1218-8b3b-dcd8bd6c4eaa
msgctxt "hc86a1ce1g508fg4a17g9c65ga9d4afb5a047"
msgid "What's in Baldur's Gate?"
msgstr "발더스 게이트에 뭐가 있는데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Shadowheart
#. NodeID = 3d0eb178-5f44-15d5-db48-5e64cb154ed8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:3d0eb178-5f44-15d5-db48-5e64cb154ed8
msgctxt "hb5b9c994g10ccg4be7g86dfg837f233a3ff1"
msgid "Out of the question. This is my mission - I won't just give it away."
msgstr "그건 불가능해. 이건 내 임무야, 그냥 내줄 순 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Shadowheart
#. NodeID = 3e0e0553-369c-39df-230e-f3174ac86d2e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:3e0e0553-369c-39df-230e-f3174ac86d2e
msgctxt "h8a0baa33g7dd1g4478gb8dfgff7ae86301c8"
msgid "Trust me, I'll guard it with my life. Let's keep going."
msgstr "날 믿어, 목숨을 바쳐 지킬 테니. 계속 나아가자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Shadowheart
#. NodeID = 42a44891-3a0c-89f2-3c66-d55a9f899e2d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:42a44891-3a0c-89f2-3c66-d55a9f899e2d
msgctxt "hc90c02b0g96f8g4555ga290g9d64285ce2b4"
msgid ""
"I... yes, she must. I'll offer thanks to her in my prayers - and we should "
"speak more later. Alone, ideally."
msgstr "난... 그래, 분명 그럴 거야. 그분께 감사기도를 올릴게 나중에 더 얘기하자. 둘이서만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Narrator
#. NodeID = 479ea08f-9e10-928e-2f27-02aff2fb8cb3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Orpheus_Knows_GithArtefact = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:479ea08f-9e10-928e-2f27-02aff2fb8cb3
msgctxt "h28d336bdg7cbag47acgb4d8gfc476039bfbf"
msgid "*No doubt the githyanki will seek to reclaim that which is theirs.*"
msgstr "*틀림없이 기스양키 또한 그들의 물건을 회수하기 위해 움직일 겁니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Player
#. NodeID = 4acf3bff-3aa9-ba8b-3ff8-5b727fe49630
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC_SHAR(2) = False
#.      - PALADIN_SHAR(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:4acf3bff-3aa9-ba8b-3ff8-5b727fe49630
msgctxt "h9281d372ge5c8g4bdcgb58agbc0426c56ea0"
msgid ""
"Let's see how open-minded I can be then: tell me more about your Shar "
"worship."
msgstr "그럼 내가 얼마나 열린 마음을 가질 수 있는지 한번 보자. 너의 샤 숭배에 대해 더 자세히 말해 줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Player
#. NodeID = 4b06a157-9030-6d9f-8691-4759295aad84
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:4b06a157-9030-6d9f-8691-4759295aad84
msgctxt "h6c5bcc33g51b2g4947g8670g395b49669e8c"
msgid "I can't trust you. Best if we travel separately for now."
msgstr "널 믿을 수 없어. 지금부터는 따로 여행하자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Shadowheart
#. NodeID = 4b475906-97b3-4dd0-d6c3-fa00b3290b55
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:4b475906-97b3-4dd0-d6c3-fa00b3290b55
msgctxt "h184b94a3ga571g460fg8e5bga8c59355fd07"
msgid "Talk to me later. We've got more pressing matters to see to right now."
msgstr "나중에 이야기하자. 지금 당장 처리해야 할 일들이 있잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Shadowheart
#. NodeID = 4b93a17c-ec7e-ee0f-96ca-a43d4915b3ac
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - b11c5c4f-e06d-12fe-fa3e-f21f3a4f4708_LaezelInclusion = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:4b93a17c-ec7e-ee0f-96ca-a43d4915b3ac
msgctxt "he8415eb5g10e7g4b86g909dgc1f4a2adb06e"
msgid ""
"I just saved you. Keep that in mind, next time you want to air your "
"grievances."
msgstr "내가 방금 널 구했어. 다음번에 네 불만을 얘기할 땐 그 점을 기억해 줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Lae'zel
#. NodeID = 4f163576-d156-4220-866e-40b6be74af51
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - b11c5c4f-e06d-12fe-fa3e-f21f3a4f4708_LaezelInclusion = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:4f163576-d156-4220-866e-40b6be74af51
msgctxt "haf8eb22ag2bacg4e60gb018gd07c39d2cb0f"
msgid ""
"I know those symbols - githyanki runes. Ancient as Vlaakith herself. You "
"stole that from my people."
msgstr "그 문양, 기스양키의 룬이잖아. 블라키스 님 본인만큼이나 오래된 것이지. 네가 내 동족에게서 훔친 것이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Shadowheart
#. NodeID = 4fc40aa0-dc50-5029-f879-f589e923bbdd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:4fc40aa0-dc50-5029-f879-f589e923bbdd
msgctxt "h318f57c4gca29g436bgb4c1g93d4a6e9fc1f"
msgid ""
"No need to thank me - this is out of pure necessity - pure <i>desperation</"
"i>, in fact."
msgstr "고마워 할 필요 없어. 이건 순수하게 필요해서 말하는 거니까.  정말  <i>간절하거든</i>. 그것 뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Lae'zel
#. NodeID = 50b9633e-f1f2-5e3a-e3a7-2ab6b02fe25d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:50b9633e-f1f2-5e3a-e3a7-2ab6b02fe25d
msgctxt "hd93752beg28a9g4b33g9765g26fe2fc34ead"
msgid "The goddess of secrets? How <i>telling.</i>"
msgstr "비밀의 여신? <i>솔직하네.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Narrator
#. NodeID = 51c32157-3da0-8a9f-d924-c1361880f231
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:51c32157-3da0-8a9f-d924-c1361880f231
msgctxt "hcc834c80gde06g4cd1g839bga08ee8292043"
msgid ""
"*The three figures in the vision - the Chosen - are searching for it. With "
"the cultists' aid, it will not be long before they find it, before they find "
"<i>you</i>."
msgstr ""
"*환영 속의 세 인물, 소위 선택받은 자들이 유물을 찾고 있습니다. 이교도들의 협력 아래, 그들은 아티팩트를 찾아낼 겁니다. <i>당신</"
"i>을 찾아낼 겁니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Player
#. NodeID = 54bd38eb-bc9e-b04a-bd3d-27b78906c5c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:54bd38eb-bc9e-b04a-bd3d-27b78906c5c6
msgctxt "ha4da6460g5119g47ebgacd3g78783ec4b463"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Shadowheart
#. NodeID = 5624b4ae-8110-4e54-8b3c-35ddff80f1ae
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ShadowHeart_InParty_Knows_SharWorshipper = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:5624b4ae-8110-4e54-8b3c-35ddff80f1ae
msgctxt "hc4667921g99b0g49b8gb763g04c7440ece08"
msgid ""
"I... I am a servant of Shar. My home is a secret cloister in Baldur's Gate. "
"I need to bring that artefact back there, no matter what."
msgstr ""
"나... 난 샤님의 종복이야. 내 집은 발더스 게이트에 있는 비밀 수도원이야. 그 어떤 대가를 치르더라도 그 아티팩트를 그곳으로 가져가야 "
"해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Player
#. NodeID = 5a0a1238-a23d-1dbe-7224-7ff13d2d3ebb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:5a0a1238-a23d-1dbe-7224-7ff13d2d3ebb
msgctxt "hb6876912g9059g41b1gb968gf21bbb9cfa2b"
msgid "Keep that thing safe - seems we'll need it."
msgstr "그걸 안전히 지켜, 우리에게 필요한 것 같으니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Player
#. NodeID = 608ddcdf-31c8-5f1d-33d2-58e5266e8441
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox_BoxDiscussed(2) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox_BoxDiscussed(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:608ddcdf-31c8-5f1d-33d2-58e5266e8441
msgctxt "hb8a02446g259eg4d0agb37fg584aa0218ca6"
msgid "You must know something about what that thing is."
msgstr "그 물건의 정체에 대해 뭔가는 아는 게 있겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Player
#. NodeID = 6456f618-2ed3-0c36-1b01-62aafee09361
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:6456f618-2ed3-0c36-1b01-62aafee09361
msgctxt "h0514f3c3gdfd5g4a98gb5d4g28f32e8cc5ca"
msgid "You've got some explaining to do first - why do you carry a gith relic?"
msgstr "설명을 좀 듣고 싶군. 왜 기스 유물을 들고 다니는 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Shadowheart
#. NodeID = 675bd276-cd05-5428-7b24-b5e87060d08b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:675bd276-cd05-5428-7b24-b5e87060d08b
msgctxt "h9c2ff214gb643g46bcga861g52365fd0e581"
msgid "Then it's your own fault for not asking."
msgstr "그럼 묻지 않은 네 잘못이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Player
#. NodeID = 696dba50-5eca-b1ac-487f-b79e96b9f11c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:696dba50-5eca-b1ac-487f-b79e96b9f11c
msgctxt "h878528ebgec60g472egb0c5ga53e12faa25a"
msgid "Let's press on."
msgstr "계속하자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Shadowheart
#. NodeID = 69abd5b9-65df-a413-d99c-0cda0b1aa480
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:69abd5b9-65df-a413-d99c-0cda0b1aa480
msgctxt "h6654ebd9g9c73g4223gabe2gfb64e50142a7"
msgid "Though perhaps that might change, if you can show an open mind."
msgstr "하지만, 미안해질지도 모르지, 네가 열린 마음을 보여준다면 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Gale
#. NodeID = 6a1a20e2-c2fb-dc84-83fa-46c85e323599
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GALE(7) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:6a1a20e2-c2fb-dc84-83fa-46c85e323599
msgctxt "h1f969022g14aeg4240g8bc7gbd15a6d58ce9"
msgid ""
"That's an unusual artefact you have there, Shadowheart. A most unlikely "
"protector..."
msgstr "아주 특이한 아티팩트네 섀도하트. 예상치 못한 수호자야..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Shadowheart
#. NodeID = 6c275b24-c5c1-6e5f-9d1e-6034ca102687
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Quest:
#.      - ORI_COM_ShadowHeart.LearnedMemorySupressed(2) = False
#. SetFlags:
#.   Quest:
#.     - ORI_COM_ShadowHeart.LearnedMemorySupressed(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:6c275b24-c5c1-6e5f-9d1e-6034ca102687
msgctxt "hfb150b52g537fg46deg8a53gc20dc830e37d"
msgid ""
"If I reach my contact in the city, I'll have my memories restored. Until "
"then, I have to guard the artefact with my life."
msgstr "도시에 있는 접선지에 도착하면, 내 기억이 복구될 거야. 그때까진, 이 아티팩트를 목숨 바쳐 지키는 게 내 임무야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Player
#. NodeID = 6cc1008c-a66b-43a4-afb3-d8e413450c5e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - b11c5c4f-e06d-12fe-fa3e-f21f3a4f4708_LaezelInclusion = True
#. SetFlags:
#.   Local:
#.     - b11c5c4f-e06d-12fe-fa3e-f21f3a4f4708_LaezelInclusion = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:6cc1008c-a66b-43a4-afb3-d8e413450c5e
msgctxt "h3b508275g0b34g42f6ga072g04a548b39730"
msgid "Enough, both of you. We need to work together."
msgstr "둘 다 그만해. 우린 서로 협력해야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Shadowheart
#. NodeID = 6d654350-5d91-27d1-80ef-00ef62cf30a1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:6d654350-5d91-27d1-80ef-00ef62cf30a1
msgctxt "hf1bbaa23g0916g46c2g85c8g1543dc21cbf3"
msgid "Who says you have to feel anything?"
msgstr "네가 뭘 느껴야 한다고 누가 그래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Player
#. NodeID = 6df0b735-71e3-048a-4f94-2f7093591f9d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:6df0b735-71e3-048a-4f94-2f7093591f9d
msgctxt "h23ff291dg75eag4eb9gb343gddf5ec5c9fd3"
msgid ""
"Just take care of it. Seems like it's as important to me as it is to you."
msgstr "잘 간수해. 네게 중요한 만큼 나에게도 중요한 것 같으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Narrator
#. NodeID = 6ecbadef-bfff-d926-2c27-b04f0f400fe3
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:6ecbadef-bfff-d926-2c27-b04f0f400fe3
msgctxt "h2b528a6fg76b2g40caga3d1gbbfa95ca9f93"
msgid ""
"*Incomprehensible gith runes adorn the artefact. It lifts the pain from you, "
"pushing the voice away.*"
msgstr "*읽어낼 수 없는 기스 룬이 아티팩트에 새겨져 있습니다. 유물은 당신의 고통을 덜어주고 목소리를 밀어냅니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Narrator
#. NodeID = 6ecbadef-bfff-d926-2c27-b04f0f400fe3
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:6ecbadef-bfff-d926-2c27-b04f0f400fe3
msgctxt "h60cc2164gce34g4ad5g9a69ge0d8a008f763"
msgid ""
"*You feel energy pulsing from the artefact. Lifting the pain from you. "
"Pushing the voice away.*"
msgstr "*아티팩트에서 에너지가 뿜어져 나오는 것이 느껴집니다. 당신의 고통을 덜어주고 있습니다. 목소리를 밀어내고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Wyll
#. NodeID = 6fb3003e-453c-7ed6-218a-45389abb5a71
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(6) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:6fb3003e-453c-7ed6-218a-45389abb5a71
msgctxt "h630b2af7g3fb9g46b7g888fg6827e769066c"
msgid "A Shar worshipper? Not my usual quarry - nor my usual ally."
msgstr "샤 숭배자? 내가 평소에 만나는 적도, 동료도 아니군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Shadowheart
#. NodeID = 718d9591-92de-141c-3b40-c15c22ff74dd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - Approval_AtLeast_10_For_Sp3(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:718d9591-92de-141c-3b40-c15c22ff74dd
msgctxt "h08e46223g497bg4bd3ga307g37e1fe8f7b67"
msgid ""
"I trust you more than most, but I'm sorry - that's too much to ask. This is "
"<i>my </i>responsibility."
msgstr "널 대부분의 사람보단 신뢰하지만, 미안해, 그건 들어줄 수 없는 부탁이야. 이건 <i>내 </i>책무야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Player
#. NodeID = 744506a1-4ec7-f751-a459-f9809cfb0c5f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox_BoxDiscussed(2) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox_BoxDiscussed(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:744506a1-4ec7-f751-a459-f9809cfb0c5f
msgctxt "h741bf84bg3a47g4c8eg84b5g6bffee2f2e3b"
msgid "Tell me about the artefact. What just happened?"
msgstr "그 아티팩트에 대해 알려줘. 방금 무슨 일이 일어난 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Shadowheart
#. NodeID = 75276e9d-27ec-ab62-f83b-e0449e4d5e5a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:75276e9d-27ec-ab62-f83b-e0449e4d5e5a
msgctxt "hbbfb73d5g0dfcg4793ga6a7gdd60436fea2c"
msgid ""
"There's nothing more I can tell you. All I remember is that I have to get "
"back to my contact in the city."
msgstr "나도 네게 알려줄 수 있는 게 없어. 내가 기억하는 건 이걸 도시에 있는 접선지에 가져가야 한다는 것뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Player
#. NodeID = 7d1a1605-17b4-7608-d343-4b94441b86a4
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(2) = True
#. TagRule: BERSERKER
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:7d1a1605-17b4-7608-d343-4b94441b86a4
msgctxt "hbe5b36ebg7d28g4054gb0e2g24679a01087b"
msgid "SPEAK, OR I BREAK IT, <b>THEN YOU</b>."
msgstr "<b>말해, 그렇지 않으면 부숴버릴 테니, 그 다음엔 널 부숴버리겠어</b>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Player
#. NodeID = 7d1a1605-17b4-7608-d343-4b94441b86a4
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:7d1a1605-17b4-7608-d343-4b94441b86a4
msgctxt "hc0b86805g8738g43b3g9b91g51d859ea1c0b"
msgid "I'll have answers, or I'll have blood."
msgstr "대답하지 않으면, 피를 흘리게 될 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Shadowheart
#. NodeID = 8065e0ee-8b9e-73a5-746e-72e73df57ca5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_Shadowheart_Event_BoxMissionBackground(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:8065e0ee-8b9e-73a5-746e-72e73df57ca5
msgctxt "he490e0a8g3699g47c8ga0a3ged7c41cef86a"
msgid ""
"Because it was our mission to retrieve it - me and... the others. I'm the "
"only one who made it."
msgstr "그걸 회수하는 게 우리 임무였어. 나와... 다른 이들의 임무. 그중 살아남은 건 나뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Shadowheart
#. NodeID = 80671d07-5850-ca74-16cc-59b1c2cc687d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:80671d07-5850-ca74-16cc-59b1c2cc687d
msgctxt "h0485a97aga9b8g47b3g8f26gcf12c109228a"
msgid "All we can do is try, I suppose..."
msgstr "시도해볼 수 밖에 없겠지, 아마도..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Narrator
#. NodeID = 81170674-d615-24e8-66d4-ed38813d237e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Tadpoled_PartyUsed = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:81170674-d615-24e8-66d4-ed38813d237e
msgctxt "h43769a7cg3a70g49f0g9db7g0a4e01adb536"
msgid ""
"*The voice is irresistible. You recognise the overwhelming authority that "
"you've used on others, only infinitely stronger, and turned against you...*"
msgstr ""
"*거역할 수 없는 목소리입니다. 그 속에서 당신이 다른 이들에게 사용했던 압도적인 권위가 느껴집니다. 다만 무한히 더 강력하고, 당신에게 "
"사용되고 있다는 점이 다를 뿐입니다...*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Narrator
#. NodeID = 818f6ce3-67ac-8714-458d-127337b7236f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:818f6ce3-67ac-8714-458d-127337b7236f
msgctxt "hde9a553bg37d6g4edcgaaafg8d03ca32eaa1"
msgid ""
"*The voice is irresistible. Every word is drenched with a power and "
"authority that you do not understand, but cannot deny.*"
msgstr "*거역할 수 없는 목소리입니다. 모든 단어에 이해할 수 없는 힘과 권위가 느껴지며, 거부할 수 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Shadowheart
#. NodeID = 89656902-ea6f-16c7-9114-dfa23dd01fa6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:89656902-ea6f-16c7-9114-dfa23dd01fa6
msgctxt "h8ca089fag460cg4210ga5a0g062b35c0bc1c"
msgid "I'm not sure I want to know - but it's gone now. We should keep moving."
msgstr "나도 내가 뭘 알고 싶은지 확실히 모르겠어. 하지만 이제 상관없으니, 계속 나아가자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Player
#. NodeID = 913d89bc-8fe8-61e1-3124-e492a4958c83
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:913d89bc-8fe8-61e1-3124-e492a4958c83
msgctxt "h7b43bb83g521eg45c3g8141g94cccc2e15ae"
msgid "Forget it."
msgstr "잊어버려."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Shadowheart
#. NodeID = 91de910e-2c9d-6091-e272-0d725f1abaec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:91de910e-2c9d-6091-e272-0d725f1abaec
msgctxt "h7fe68aafgaa11g4032g86d7g91e3112d0aba"
msgid "I told you already, now forget it. Let's keep going."
msgstr "이미 말해줬잖아, 이제 잊어버려. 계속 나아가자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Player
#. NodeID = 942b5874-bdd1-767a-96a3-f5b73349fbfb
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:942b5874-bdd1-767a-96a3-f5b73349fbfb
msgctxt "h292db3e9gf8e7g4bb1ga977gd658561eabd5"
msgid "That was far from nothing. Tell me what you know, please."
msgstr "그건 아무것도 아닌 거랑은 거리가 멀었어. 네가 아는 게 뭔지 알려줘, 제발."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Disembodied Voice
#. NodeID = 94b106b4-554f-ee90-d2af-c7fdd71e9e87
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:94b106b4-554f-ee90-d2af-c7fdd71e9e87
msgctxt "h3ad5ecdagce7bg44fega325g481183dac836"
msgid "<b><i>Hear my voice. Obey my command.</i></b>"
msgstr "<b><i>내 목소리를 들어라. 내 명령에 따르라.</i></b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Shadowheart
#. NodeID = 9579babb-a3c6-98a8-63be-4e2a67fa6ecc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Absolute_Knows_Name = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:9579babb-a3c6-98a8-63be-4e2a67fa6ecc
msgctxt "hada89922g04d8g47f7g8045g5df2c4c09e4a"
msgid ""
"I think that was the Absolute speaking to us... but we managed to shield "
"ourselves. We should keep moving."
msgstr "내 생각엔 절대자가 우리에게 말을 한 것 같아... 하지만 우리 스스로를 보호할 수 있었지. 계속 나아가자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Narrator
#. NodeID = 963ad4c9-abcc-a7af-2772-d944383921ff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:963ad4c9-abcc-a7af-2772-d944383921ff
msgctxt "hfca6e22fg6567g4165g8ec2gfcc9ebbabe64"
msgid ""
"*You have evaded them so far. Thanks, it seems, to the artefact itself. But "
"how long can such protection last?*"
msgstr ""
"*당신은 지금까지 그들을 잘 피해 왔습니다. 아티팩트 덕분으로 보입니다. 하지만 이 같은 보호가 얼마나 오래 지속될 수 있을까요?*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Player
#. NodeID = 96b409d0-fa75-f958-a9d5-497f2f356abb
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox_SharDiscussed(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:96b409d0-fa75-f958-a9d5-497f2f356abb
msgctxt "h77d69660gfedcg42ceg87a7g460e19a265cd"
msgid "I didn't agree to join up with a Shar worshipper."
msgstr "샤 신봉자랑 같이 다니기로 동의한 적은 없는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Shadowheart
#. NodeID = 981f7001-647d-2c97-f1d6-4407a6c2e07c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - OriginRemoveFromPartyAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:981f7001-647d-2c97-f1d6-4407a6c2e07c
msgctxt "h371b2a79gd252g435dga5b7g63391e97aef8"
msgid "If you insist. Don't expect to fare well without me to save you."
msgstr "네가 원한다면. 하지만 내가 구해 주지 않아도 잘 지낼 수 있을 거라고 기대하진 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Player
#. NodeID = 99aa0d21-b34e-286b-7a1d-3f3702e8bcdb
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox_SharDiscussed(2) = True
#. TagRule: CLERIC_SHAR or PALADIN_SHAR
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:99aa0d21-b34e-286b-7a1d-3f3702e8bcdb
msgctxt "h160744b7gb82ag459bg8763gc8e4ce47c0af"
msgid ""
"I bow to Shar also. The Dark Lady must favour us, to have brought us "
"together."
msgstr "나도 샤 여신을 섬겨. 어둠의 여신께서 호의를 베푸신 게 분명해, 우릴 모이게 했잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Player
#. NodeID = 9dd8a7ea-4ba7-2f6c-cbe0-00bc8490b789
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:9dd8a7ea-4ba7-2f6c-cbe0-00bc8490b789
msgctxt "had0e9dccgff74g4bdag9be7ge464e2d7d19f"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Narrator
#. NodeID = 9fefa190-2b90-1881-8eeb-8be36eb9e690
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:9fefa190-2b90-1881-8eeb-8be36eb9e690
msgctxt "h668df7edgee5fg455ega930g54b5dd18b8d6"
msgid "*And you still do not know what it even is.*"
msgstr "*그리고 당신은 여전히 그것의 정체를 모릅니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Disembodied Voice
#. NodeID = a05aeaf8-0f5f-976b-0153-2a3bd0592f45
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:a05aeaf8-0f5f-976b-0153-2a3bd0592f45
msgctxt "h2064a0c1g7dddg4d19ga43fg7e0eec752b12"
msgid "<b><i>These are my Chosen. They speak for me.</i></b>"
msgstr "<b><i>이들은 내가 선택한 자들이니. 내 목소리를 대변하노라.</i></b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Lae'zel
#. NodeID = a21794b3-d92d-d2ed-6980-adc36ed28106
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(3) = True
#. SetFlags:
#.   Local:
#.     - b11c5c4f-e06d-12fe-fa3e-f21f3a4f4708_LaezelInclusion = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:a21794b3-d92d-d2ed-6980-adc36ed28106
msgctxt "h7764d554gab8bg4c6eg9ed9ge0e788bd8075"
msgid "For now. But any crimes against my kin will be answered for, in time."
msgstr "당장은 그러도록 하지. 하지만 내 동족을 향한 그 어떤 범죄도 결국 대가를 치르게 될 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Shadowheart
#. NodeID = a30185d4-146b-3d94-0c86-7e5cff08ddc7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:a30185d4-146b-3d94-0c86-7e5cff08ddc7
msgctxt "h7283da66g7c5fg4726gb2cegdd1e5607501d"
msgid "Then go ahead. It won't change what I have to say to you."
msgstr "마음대로 해. 그런다고 해서 내가 너에게 알려줄 건 바뀌지 않을 테니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Shadowheart
#. NodeID = aa879a3f-13bd-1b0a-1192-67724e4b8160
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:aa879a3f-13bd-1b0a-1192-67724e4b8160
msgctxt "h2716899dg316ag4123g9bb3g247e76df4b96"
msgid "Gladly."
msgstr "기꺼이."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Narrator
#. NodeID = ac5e7d89-edeb-e94f-fb82-a4097d280ed4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:ac5e7d89-edeb-e94f-fb82-a4097d280ed4
msgctxt "h29249e57g7f74g40d0g8568g5694285e0999"
msgid ""
"*Shadowheart has made her position clear - she will see that it is taken to "
"its destination. At any cost.*"
msgstr "*섀도하트가 자신의 입장을 확실히 밝혔습니다. 그녀는 이 물건을 목적지까지 가져가려 할 겁니다. 무슨 수를 써서라도.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Shadowheart
#. NodeID = b00247f5-fc48-184a-c344-dd7e644f1be5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:b00247f5-fc48-184a-c344-dd7e644f1be5
msgctxt "hf8a91ef0g7896g4c54g824bg3e20db9394bb"
msgid "If you insist. But make it quick - we have <i>far </i>bigger concerns."
msgstr "네가 원한다면. 하지만 서둘러, 우리에겐 훨씬 큰 걱정거리들이 남아있으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Shadowheart
#. NodeID = b2ef8ff0-8234-e72b-998b-f2841cb6df73
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:b2ef8ff0-8234-e72b-998b-f2841cb6df73
msgctxt "hb7875e55gb423g4c04gb4bcg35b15c0fba02"
msgid "Agreed. There's too much at stake for petty squabbles."
msgstr "동의해. 사소한 말다툼이나 하고 있기엔 너무 많은 것들이 걸려있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Karlach
#. NodeID = b5fb0843-7bf6-b1ab-58ab-fb6ed9170050
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:b5fb0843-7bf6-b1ab-58ab-fb6ed9170050
msgctxt "h25547775g295cg45fagacb9g497e673a3a6b"
msgid "I <i>knew </i>it."
msgstr "그럴 줄 <i>알았지</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Narrator
#. NodeID = b7742c81-a867-44a7-8516-03e83112e28f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:b7742c81-a867-44a7-8516-03e83112e28f
msgctxt "h95661f08g2997g4fc2ga120ga4289a2f50dd"
msgid ""
"*A powerful artefact indeed, to have caught the attention of so many. Not "
"least, the Absolute itself.*"
msgstr "*그토록 많은 이들의 이목을 끌 만큼 실로 강력한 아티팩트입니다. 특히, 절대자의 주목 말입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Player
#. NodeID = b9ef13f0-8709-02ff-7ddb-b87e3ddf905f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:b9ef13f0-8709-02ff-7ddb-b87e3ddf905f
msgctxt "h4d79ae8ag1f92g46f9g9bd7g61e19c3918d7"
msgid "The vision... that voice - what was it?"
msgstr "그 환영과... 목소리... 대체 뭐였을까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Shadowheart
#. NodeID = bdce3d66-ed82-2b5a-00e7-49f5869732d9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ShadowHeart_InParty_Knows_SharWorshipper = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:bdce3d66-ed82-2b5a-00e7-49f5869732d9
msgctxt "h1e1557abgc5b7g4dbfgb976g64c3bd0e2a35"
msgid ""
"I suppose if we're to continue together, I may as well tell you. I serve "
"Shar. My home is a secret cloister in Baldur's Gate."
msgstr "우리가 계속 함께 나아가려면, 알려주는 게 좋겠지. 난 샤님을 섬겨. 내 집은 발더스 게이트에 있는 비밀 수도원이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Astarion
#. NodeID = be9c78cf-e1e5-1a2a-6248-d4f42b94200f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:be9c78cf-e1e5-1a2a-6248-d4f42b94200f
msgctxt "hf253da4fgfb0ag4987g94b5g9a6820e46d03"
msgid "I don't know what that toy of hers is, but I'm glad it's on our side."
msgstr "그녀가 가진 저 장난감이 뭔진 모르겠지만, 우리 편이라 다행이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Player
#. NodeID = c14fb77c-e8c5-8328-42cd-f68272bca6c5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC_SHAR(2) = False
#.      - PALADIN_SHAR(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:c14fb77c-e8c5-8328-42cd-f68272bca6c5
msgctxt "he8a1edfagec06g4610g82a9g8fc9b4f95e81"
msgid "Now that the truth's out, tell me more."
msgstr "이제 진실이 밝혀졌으니, 더 자세히 알려줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Player
#. NodeID = c397e4ce-9cb7-8ce0-a1d9-3f41730b4db9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Tadpoled_PartyUsed = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:c397e4ce-9cb7-8ce0-a1d9-3f41730b4db9
msgctxt "h8bbb6d41g4853g49a1gac7fg0961df3cc23d"
msgid ""
"That power... is that what happens to others, when we use the parasite on "
"them?"
msgstr "그 힘... 우리가 기생충의 힘을 다른 이들에게 사용하면 이런 일이 일어나는 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Shadowheart
#. NodeID = c5c46660-1962-a0e6-459a-76c48a283c09
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:c5c46660-1962-a0e6-459a-76c48a283c09
msgctxt "hd14ac9b5g7533g448cga03cgce07bea3432b"
msgid "I'm not sorry I kept this from you. Not one bit."
msgstr "이 사실을 숨겨서 미안한 감정은 없어. 전혀."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Shadowheart
#. NodeID = c5d8d3f2-12de-5f9f-2871-c0422c343c3d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_State_Recruited(0) = False
#. SetFlags:
#.   Global:
#.     - GOB_Orpheus_State_HadVoiceOfAbsoluteEvent = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:c5d8d3f2-12de-5f9f-2871-c0422c343c3d
msgctxt "hd79f802fg7debg42c2gad77g6b99f4a82599"
msgid "I imagine you must have questions. We should talk."
msgstr "분명 궁금한 점이 많겠지. 얘기 좀 하자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Player
#. NodeID = c5febd91-e7c4-8c12-6d80-f16971053824
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:c5febd91-e7c4-8c12-6d80-f16971053824
msgctxt "ha4e92161g0868g4af8g9473gf4613a12724f"
msgid ""
"We can discuss this later. But let's just try a little more honesty going "
"forward."
msgstr "이 부분에 대해서는 나중에 논의하자. 하지만 앞으로는 조금 더 솔직해지도록 노력해 줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Narrator
#. NodeID = c8a3b27f-ff3b-b94e-1bbf-b27b939492c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:c8a3b27f-ff3b-b94e-1bbf-b27b939492c4
msgctxt "hb3f7395ag5ee1g46e7g9465gb1048b76068b"
msgid ""
"*Then, there are three figures before you. An armoured male elf, exuding "
"power and command. A handsome younger man with a quick, easy smile. And a "
"pale young woman with even paler eyes...*"
msgstr ""
"*그러더니 눈 앞에 세 명의 인물이 나타납니다. 갑옷을 착용하고 강력한 힘과 권위가 느껴지는 엘프 남성, 조금 더 어리고 밝은 미소를 "
"띠고 있는 잘생긴 남성. 그리고 창백한 피부와 그보다 더 창백한 눈을 지닌 어린 여성...*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Karlach
#. NodeID = cd4bde5d-b8d3-9466-f152-6ad0a5435e0a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:cd4bde5d-b8d3-9466-f152-6ad0a5435e0a
msgctxt "h55c51fa1g6d98g4f42g99a3g574cc89bbfad"
msgid ""
"Nice one, Shadowheart. That thing in your pocket seems powerful as hell."
msgstr "방금 좋았어, 섀도하트. 네 주머니 안에 있는 물건 존나게 강력한 것 같네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Player
#. NodeID = d0107a28-7f5e-427b-55fc-736f662d6770
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ShadowHeart_InParty_Knows_SharWorshipper = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:d0107a28-7f5e-427b-55fc-736f662d6770
msgctxt "h1bdc051eg14d4g44c3g92e2g66551226a3fc"
msgid "Why Baldur's Gate? What aren't you telling me?"
msgstr "왜 발더스 게이트지? 뭘 알려주지 않고 있는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Shadowheart
#. NodeID = d4b056f3-e9d6-fe8e-2320-3ec9213df064
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:d4b056f3-e9d6-fe8e-2320-3ec9213df064
msgctxt "hc647716bga097g4ccdga530g70c39c32a314"
msgid ""
"Your blindness as much as my deception, Selûnite. We can talk about this "
"later - if you're willing."
msgstr "넌 셀루네에 대한 신앙으로 눈이 멀어있네. 우리 나중에 다시 대화하자. 너가 원한다면 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Wyll
#. NodeID = d60ca210-c644-46de-6c6d-e7df81f7a094
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(6) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:d60ca210-c644-46de-6c6d-e7df81f7a094
msgctxt "hc9e5efd9g11b4g46e4gb595g5973521d0345"
msgid ""
"Isn't that something? The artefact scattered the voice to the four winds."
msgstr "대단하지 않아? 그 아티팩트가 목소리를 사방으로 흩뜨려놨어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Shadowheart
#. NodeID = d6203a48-0ed2-5f1d-522a-ea1db6134937
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:d6203a48-0ed2-5f1d-522a-ea1db6134937
msgctxt "h093aa3a8ga797g41a8gbba9ga28887e4ab83"
msgid "Perhaps, but whatever it was, I don't want to experience it again."
msgstr "그럴지도, 하지만 그게 뭐였든 간에, 다시 경험하고 싶진 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Lae'zel
#. NodeID = d93cd7f9-f906-0c35-8a99-99fed6f72916
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(3) = True
#. SetFlags:
#.   Global:
#.     - GLO_Orpheus_Knows_GithArtefact = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:d93cd7f9-f906-0c35-8a99-99fed6f72916
msgctxt "h103da69bg9600g48ddg978cgefc4663b624f"
msgid ""
"The voice is gone - muted by this... this gith relic. Why does a <i>half-elf "
"</i>carry it?"
msgstr "목소리가 사라졌어. 이... 기스 유물이 막아줬군. 왜 <i>하프 엘프</i>가 이걸 가지고 있는 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Shadowheart
#. NodeID = db39866e-986b-bdbe-4826-7b084d3e2b3d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:db39866e-986b-bdbe-4826-7b084d3e2b3d
msgctxt "h97711602ga87eg4b13g9589g9c91e8b7b934"
msgid ""
"Forever, ideally. And you assume too much about what I can and cannot tell."
msgstr "이상적으로는, 영원히. 그리고 내가 말해줄 수 있고, 그렇지 못한 것에 대해서 너무 쉽게 판단하지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Shadowheart
#. NodeID = df362b1f-59c3-09c2-db52-16088ba2b846
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:df362b1f-59c3-09c2-db52-16088ba2b846
msgctxt "h226a92bbg0489g4822gaa8fg6f66ebb274ba"
msgid ""
"Secrecy is everything for Shar's children. It's our code, our creed, our "
"shield."
msgstr "샤의 자녀들에겐 비밀이 전부야. 그게 우리의 규약이자, 신조이며 방패지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Player
#. NodeID = e0f8d82a-fc05-ed3a-e5bf-9e6b16d06668
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox_BoxDiscussed(2) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox_BoxDiscussed(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:e0f8d82a-fc05-ed3a-e5bf-9e6b16d06668
msgctxt "h9046f854ge8bcg477eg85eeg85381b35a176"
msgid "And exactly what did retrieving the artefact entail?"
msgstr "그래서 그 아티팩트를 회수하기 위해 어떤 일이 있었던 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Player
#. NodeID = e3a284ef-e814-4f3e-d9ab-d3b4779f780c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox_BoxDiscussed(2) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox_BoxDiscussed(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:e3a284ef-e814-4f3e-d9ab-d3b4779f780c
msgctxt "h1bd4b19bga35cg46d1g837bgbedb2d8d7e64"
msgid "I don't care who you worship. Tell me about that artefact."
msgstr "네가 누구를 섬기든지 알 바 아냐. 그 상자에 대해 말해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Shadowheart
#. NodeID = ea71a20c-3fb6-6368-ba3d-dfaade92c8c4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Quest:
#.      - ORI_COM_ShadowHeart.LearnedMemorySupressed(2) = False
#. SetFlags:
#.   Quest:
#.     - ORI_COM_ShadowHeart.LearnedMemorySupressed(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:ea71a20c-3fb6-6368-ba3d-dfaade92c8c4
msgctxt "h2137d926ga26ag491bgabbbg2026058f6b2e"
msgid ""
"I even keep secrets from myself - I had my memories suppressed, so that "
"nothing I knew could be used against the Dark Lady. Once I prove myself, my "
"memories will be restored."
msgstr ""
"난 심지어 나 자신한테도 비밀이 있어. 혹시라도 내가 아는 지식이 어둠의 여신께 반해서 사용되는 일이 없도록 기억이 억제되어 있거든. "
"내가 스스로를 증명해내면 내 모든 기억들이 돌아올 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Player
#. NodeID = eacead5b-0979-efc4-9bc1-09654df402e6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox_BoxDiscussed(2) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox_BoxDiscussed(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:eacead5b-0979-efc4-9bc1-09654df402e6
msgctxt "h7ed2bf50g9b4bg4588g8aa2ga6d63a2e80ce"
msgid "Hold on - that artefact seemed to stop the voice. What is it?"
msgstr "잠깐, 그 아티팩트가 목소리를 막은 것 같아. 그게 뭐지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Shadowheart
#. NodeID = ece4bb2b-d7bd-b89d-68f8-00ed218dd8df
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:ece4bb2b-d7bd-b89d-68f8-00ed218dd8df
msgctxt "h3aed5f1bg0143g4de6g8b6ag815a7832e8bc"
msgid ""
"<i>Wait. </i>I don't know what this thing is. All I know is that I've to get "
"it to Baldur's Gate, at any cost. That's all I have for you."
msgstr ""
"<i>잠깐. </i>나도 이게 정확히 뭔지 몰라. 내가 아는 사실은 이걸 발더스 게이트로 가져가야 한다는 것뿐이야. 무슨 수를 써서라도. "
"그게 내가 알려줄 수 있는 전부야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Shadowheart
#. NodeID = ee74f27c-b53c-186c-8c2c-3b72cc42d95b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:ee74f27c-b53c-186c-8c2c-3b72cc42d95b
msgctxt "hb5e18cbcg9a02g44cag9514g236892dd19e9"
msgid ""
"A group of us were sent to retrieve the artefact. Now I'm the only one left. "
"I can't afford to fail."
msgstr "아티팩트를 회수하기 위해 나와 동료들이 파견되었어. 그리고 이제 나만 남았지. 실패할 수는 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Player
#. NodeID = f07c1e01-ee47-15be-fac4-dcaae04407a3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox_SharDiscussed(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:f07c1e01-ee47-15be-fac4-dcaae04407a3
msgctxt "h778eb87fg6feeg4549g86e0ga5389756741b"
msgid "You've been lying to me. How long were you going to keep this secret?"
msgstr "나한테 거짓말을 하고 있었잖아. 얼마나 오랫동안 이 비밀을 간직하려고 했던 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Shadowheart
#. NodeID = f18e1b1e-414f-6b14-52dc-296994409ee8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:f18e1b1e-414f-6b14-52dc-296994409ee8
msgctxt "ha35306f5g189ag4d46ga21fg362135564e79"
msgid "Agreed."
msgstr "동의해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Player
#. NodeID = f703e834-85ba-3285-35a6-27de4b1520bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:f703e834-85ba-3285-35a6-27de4b1520bf
msgctxt "h5a4f1df8g77deg4b70gac35g24739d375350"
msgid "Seems that trinket's important. Keep it close."
msgstr "중요한 유물인 것 같네. 잘 간수해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Astarion
#. NodeID = f7bad66d-6dc9-3107-3ea2-8172f30a3893
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:f7bad66d-6dc9-3107-3ea2-8172f30a3893
msgctxt "h6becebcfgdce8g4063g9ea7g031858cee8ff"
msgid "Heavens forbid. We're all entitled to our secrets."
msgstr "그럴 일 없어. 우린 모두 자신만의 비밀을 지킬 권리가 있으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Shadowheart
#. NodeID = f8724c70-1642-6923-db4f-385eaae792b9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Quest:
#.      - ORI_COM_ShadowHeart.LearnedMemorySupressed(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:f8724c70-1642-6923-db4f-385eaae792b9
msgctxt "h80a26e63g4090g441agb83eg971dc89f47b9"
msgid ""
"I can't tell you any more. This mission required utmost secrecy - we all "
"submitted to having our memories suppressed so that we couldn't betray "
"Shar's confidence."
msgstr ""
"더 이상은 알려줄 수 없어. 이 임무는 비밀 엄수가 극도로 중요해. 샤님의 신뢰를 배신하지 않기 위해 우린 모두 자신의 기억이 "
"억제되어있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Player
#. NodeID = f8edd6ba-f487-8059-b774-01bf9d213172
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox_SharDiscussed(2) = True
#. TagRule: CLERIC_SELUNE or PALADIN_SELUNE
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:f8edd6ba-f487-8059-b774-01bf9d213172
msgctxt "ha1ede9b3g5900g4df1gad4eg0567af18fd76"
msgid "Shar is an abomination. You deceived me."
msgstr "샤는 혐오스러운 존재야. 날 속였군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Shadowheart
#. NodeID = f9082a62-a053-e59b-12f9-9dea9efe1ddf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:f9082a62-a053-e59b-12f9-9dea9efe1ddf
msgctxt "hadd2e1dbg47a5g4db7g9d5dgf0fdb05e3579"
msgid "Of course I am. But we can talk about this later - let's go."
msgstr "물론이지. 하지만 이 이야기는 다음에 하자. 일단 이동해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox
#. Speaker = Shadowheart
#. NodeID = fedd7836-3cf6-fc17-1612-12cf12900d52
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Orpheus_VoiceOfAbsolute_ShadowheartHasBox:fedd7836-3cf6-fc17-1612-12cf12900d52
msgctxt "he4af6bf3g4a64g4a4fg820dg3c7ee3164e82"
msgid "My home - a cloister of Shar followers, hidden in the city."
msgstr "내 집, 샤 추종자들의 수도원이야, 도시에 숨겨져 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = 028c6ae5-ffcf-f931-56c2-8c138143d90d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:028c6ae5-ffcf-f931-56c2-8c138143d90d
msgctxt "h7e23daf8g2255g4658gb2d9gec8d7cbc9f69"
msgid ""
"But very well. You are clearly too closed-minded for the ways of Loviatar. "
msgstr "그래, 좋아. 넌 로비아타님의 방식에 대해 너무 닫힌 생각을 가지고 있구나. "

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Player
#. NodeID = 02db2c3b-673d-bd6f-6f34-3dbbdfc7c8ef
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:02db2c3b-673d-bd6f-6f34-3dbbdfc7c8ef
msgctxt "hd8768aecg9e31g47d1g8510gbcbe368e9599"
msgid "As Vlaakith says: we cannot know pleasure without pain."
msgstr "블라키스께서 말씀하셨듯, 고통 없이는 쾌락도 알 수 없는 법이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = 02f4f775-13a7-dd98-0b5c-094b68431d21
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:02f4f775-13a7-dd98-0b5c-094b68431d21
msgctxt "h08a69842g6022g4b86g8938g28d40e1b89fe"
msgid "Oh, I do believe we are <i>both </i>going to enjoy this."
msgstr "오, 우리 <i>둘 다</i> 이걸 즐길거라 확신해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = 071e1557-2bf0-c4a7-1a60-07463a6bda0f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:071e1557-2bf0-c4a7-1a60-07463a6bda0f
msgctxt "h9f559b87g212dg4ab4g9f16g164d130c4e38"
msgid "Well, perhaps you'd be interested in finishing what they started? "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Player
#. NodeID = 0987ab55-ccb8-ab62-898e-f9fba2cbc5a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:0987ab55-ccb8-ab62-898e-f9fba2cbc5a6
msgctxt "h91c9a043g2bc6g4242g9ae5gc440a9428af6"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Player
#. NodeID = 0d645c6f-cf30-66d8-47df-1b5071343cb5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:0d645c6f-cf30-66d8-47df-1b5071343cb5
msgctxt "h0fea9773g74d6g48ccg9290g8c63fd00368d"
msgid "I don't need any 'alleviating', thanks."
msgstr "고맙지만, 나는 어떤 '완화'도 필요 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = 0e441fc2-9988-fb54-e634-176f3803efdc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_PainPriest_HasMet(1) = False
#.   Global:
#.      - GOB_PainPriest_Knows_PenanceIsPain = True
#. SetFlags:
#.   Dialog:
#.     - GOB_PainPriest_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:0e441fc2-9988-fb54-e634-176f3803efdc
msgctxt "hb2f6cdbeg5743g437bgb03fgd4c81523e1cc"
msgid ""
"Greetings, child. I fear your companion could not fully embrace my penance."
msgstr "환영한다, 아이야. 너의 친구가 내 고행을 온전히 받아들이지 못할까봐 두렵구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Player
#. NodeID = 1005433c-cc4d-4f38-df3f-919113c1c8c3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:1005433c-cc4d-4f38-df3f-919113c1c8c3
msgctxt "h719978a7gd1e5g42b2g896eg1e97bb62dbab"
msgid "Not everyone feels that way."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Player
#. NodeID = 11bdc8cf-85a9-f8ff-7c20-1e64655c7bf7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_PainPriest_Event_CheckHP(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:11bdc8cf-85a9-f8ff-7c20-1e64655c7bf7
msgctxt "h3063f0fdg231bg4f26g9f46g555d2f2eac50"
msgid "I'm ready."
msgstr "준비됐어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = 13a23e7b-2fc7-0ea3-7499-cd7919645e45
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_PainPriest_State_TooLowHP(1) = False
#.      - GOB_PainPriest_State_NeedMoreHP(1) = True
#. SetFlags:
#.   Object:
#.     - GOB_PainPriest_State_NeedMoreHP(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:13a23e7b-2fc7-0ea3-7499-cd7919645e45
msgctxt "hc3607b99g14fdg4cc5g89f0g6eaf558e6340"
msgid ""
"I see you are whole once again. Tell me, child - would you care to begin?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = 171e0817-9aad-d3e0-6b20-d0cc3a4998ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:171e0817-9aad-d3e0-6b20-d0cc3a4998ec
msgctxt "h003ead4bg3c09g4a40g865cg49585db41ebf"
msgid ""
"Well met, dear child. Would you enjoy some hands-on worship of Loviatar, "
"Maiden of Pain?"
msgstr "잘 만났다, 아이야. 고통의 처녀, 로비아타님의 사랑을 직접 즐겨보겠니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Player
#. NodeID = 196b7594-119d-8385-58a3-9e901f18eade
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_PainPriest_Event_PickSlashing = True
#.   Object:
#.     - GOB_PainPriest_Event_CheckHP(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:196b7594-119d-8385-58a3-9e901f18eade
msgctxt "hfb231b02g1031g4596gb277g09031a496af6"
msgid "Take the handaxe and show me your worst."
msgstr "손도끼를 들어서 당신 최악의 모습을 보여주세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Player
#. NodeID = 19f0400d-19f9-945e-d8b5-8e18a1786b39
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:19f0400d-19f9-945e-d8b5-8e18a1786b39
msgctxt "h3ab5e56eg0cdcg410dga484gbcd1a6b53377"
msgid "I'm only passing through."
msgstr "나는 지나가고 있었을 뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = 1a90cfcc-114b-92ec-24f8-57f00f06e4b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:1a90cfcc-114b-92ec-24f8-57f00f06e4b6
msgctxt "hd52e5401g035ag4819gbbfcg93394799e489"
msgid ""
"While I was thrilled to be invited here, I must confess I find the goblins "
"and their methods... crude and primitive."
msgstr "이곳에 초대되어 기뻤지만, 솔직히 고백하자면 고블린과 그들의 방식은... 조잡하고 원시적이라는 결론을 내렸지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Player
#. NodeID = 1e83f8d9-f43f-7742-434f-d2c849596663
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_PainPriest_Event_CheckHP(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:1e83f8d9-f43f-7742-434f-d2c849596663
msgctxt "h2c9e6441g67c2g4b9bgaa9eg074b375fa0c7"
msgid "I'm ready."
msgstr "준비됐어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Player
#. NodeID = 20d1a849-b3d1-034b-5b6f-9b3c369e0b40
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Torturers_Assisted(1) = True
#.   Tag:
#.      - REALLY_DARK_URGE(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:20d1a849-b3d1-034b-5b6f-9b3c369e0b40
msgctxt "h3c14efc1g7095g4789g9990g3538c2148de0"
msgid "I talked with the torturers. Amateurs."
msgstr "그 고문 기술자들과 얘기하고 왔지. 아마추어들."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = 23a06a30-b67d-06e7-602a-d10fb9fbfa8a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:23a06a30-b67d-06e7-602a-d10fb9fbfa8a
msgctxt "hca7007ebg8976g4196g8923ge00644e4cbaa"
msgid ""
"<i>Please. </i>The things they are doing to that man... so crude and "
"primitive."
msgstr "<i>들어봐. </i>저 자들이 그 남자에게 하고 있는 짓은... 조잡하고 원시적이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = 23e17652-dea9-2e0e-bd33-7e961d953bed
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_PainPriest_State_Penitent(1) = True
#.   Global:
#.     - GOB_PainPriest_Event_PenanceScene = True
#.   Object:
#.     - GOB_PainPriest_Event_PenancePlayer(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:23e17652-dea9-2e0e-bd33-7e961d953bed
msgctxt "h1271e2f0gfc50g4ad5gb185gd7427ed779d5"
msgid "Simply face the wall, and we can <i>begin. </i>"
msgstr "단순히 이 벽을 바라보기만 하면, <i>시작할 수 있을 거야.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = 26f43ac0-369e-3012-b676-bfde4e9b3ac6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:26f43ac0-369e-3012-b676-bfde4e9b3ac6
msgctxt "h44191340g4868g4901gabeagc3cc6532ca74"
msgid "A pity though. You would know such sweet relief at my hands."
msgstr "하지만 유감이군. 내 손이 얼마나 달콤한 안도감을 주는지 알게 될 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Player
#. NodeID = 29f7b9cf-a1df-4b6f-4264-18d416f1e0d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:29f7b9cf-a1df-4b6f-4264-18d416f1e0d8
msgctxt "h3908eefegabe0g4274gade8g9e346804bf57"
msgid "What do you mean?"
msgstr "무슨 뜻이야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = 2a5169df-b6ac-4a27-44b0-a4f1915dff7a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:2a5169df-b6ac-4a27-44b0-a4f1915dff7a
msgctxt "h8d31baf7g6760g4728gac61g59e8d2ea6722"
msgid "...through penance - administered by my skilled hand."
msgstr "... 고행을 통해, 즉 내 숙련된 손으로 때리는 것이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Player
#. NodeID = 2b59b7e2-ff6f-f3ce-56bc-64771fed676d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:2b59b7e2-ff6f-f3ce-56bc-64771fed676d
msgctxt "h7a41cef0g0110g479dga2a7g32179ab98a8f"
msgid "Then why are you beating yourself?"
msgstr "그럼 왜 스스로를 때리는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = 2cda29d0-ab22-be14-9937-a83decc42a4b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:2cda29d0-ab22-be14-9937-a83decc42a4b
msgctxt "hffb59e4agc4a4g467fgbd82g7e77a95c5322"
msgid "I pity them. They've missed out on the true intimacies of pain..."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = 2ec2ed3a-b8fa-c67a-ee95-68e00e5c8829
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:2ec2ed3a-b8fa-c67a-ee95-68e00e5c8829
msgctxt "hb10166e7gcf86g4af1gaab2g59419bca359a"
msgid ""
"I was invited to teach them some of my... techniques. I live for pain and "
"its intricacies, you see."
msgstr "나는 저 자들에게 내... 기술을 가르쳐달라고 초대를 받았어. 그런데 말이야, 나는 고통과 그 복잡성을 추구해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Player
#. NodeID = 31d6d57d-a12e-70ef-aaf9-e6a1b927348e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_PainPriest_Event_CheckHP(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:31d6d57d-a12e-70ef-aaf9-e6a1b927348e
msgctxt "hc81f2103g6e1ag4f0egac1bg03e0f00fd2ac"
msgid "All right, why not?"
msgstr "좋아, 안될 이유가 뭐가 있어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = 31fe6845-7676-4745-363d-70b8b226a4cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:31fe6845-7676-4745-363d-70b8b226a4cf
msgctxt "hebe7d92egd16fg4848g85efgfe44e0945b9f"
msgid ""
"Exactly. And should your friend lack such qualities, that is not their "
"fault. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = 359e9949-9d91-47ff-bf78-e04c89b24fe7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_God_Knows_Loviatar = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:359e9949-9d91-47ff-bf78-e04c89b24fe7
msgctxt "he965700dg16deg4367g847fgdfd865b6569e"
msgid ""
"Ah, you are familiar with the Scourge Mistress? Good. I am simply spreading "
"her message, friend. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = 37fc76ca-f63b-67b3-c326-cad7d91db947
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:37fc76ca-f63b-67b3-c326-cad7d91db947
msgctxt "h1ec44e34ga026g4653ga300g07d678249056"
msgid ""
"Pain is intimate and <i>loving</i>. But trying to discuss that with these "
"creatures..."
msgstr "고통은 친밀하고 <i>애정 어린</i> 것이야. 하지만 저 생물들과 그걸 논하려고 애써봤자..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Player
#. NodeID = 39ba8cc0-93ff-2d10-bb88-84b97ccf89c1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:39ba8cc0-93ff-2d10-bb88-84b97ccf89c1
msgctxt "hd7e380aeg779fg4450gbfc0g4232c467529c"
msgid "I'm trying to resist my drive to do harm, but it's very difficult."
msgstr "남을 해치려는 욕구에 저항하고 있는데, 너무 어려워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Player
#. NodeID = 3a9ff89e-937d-fab7-71ed-b05de8bf52d4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:3a9ff89e-937d-fab7-71ed-b05de8bf52d4
msgctxt "h8915d93bg822dg433fg8b96gc9da2f29d148"
msgid "As long as the story ends in death, it's all the same to me."
msgstr "죽음으로 끝나는 이상 나한텐 다 똑같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Player
#. NodeID = 3aeb4440-84ee-c4e4-a964-67eeae8010e8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_PainPriest_Event_CheckHP(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:3aeb4440-84ee-c4e4-a964-67eeae8010e8
msgctxt "h44d3bfb0g04e3g49bdg84b2g9e5a9ca41b7a"
msgid "I <i>am </i>curious."
msgstr "<i>궁금하군</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Player
#. NodeID = 3af63e94-1d1e-0374-d137-b97bd0070b32
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_PainPriest_Knows_PenanceIsPain = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:3af63e94-1d1e-0374-d137-b97bd0070b32
msgctxt "h3f5f181egc556g49c6gad72g14dcea25b43f"
msgid "I know of your penance - my companion has tried it."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = 3c3699bf-bae7-b704-ae79-870691e11576
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:3c3699bf-bae7-b704-ae79-870691e11576
msgctxt "h85f4ef2dgf886g401dgbe6fge9cdd26dc478"
msgid "Care to expand your horizons? It will be worth it - you have my word."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = 3ea45f14-04a1-8142-491d-03d981131264
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:3ea45f14-04a1-8142-491d-03d981131264
msgctxt "hb71cb3b4g5003g4be3g81e5gc3333a659f2b"
msgid ""
"Do not be ashamed, child. What I see in your eyes, in your <i>soul</i>, is "
"only natural."
msgstr "부끄러워하지 마렴, 아이야. 너의 눈, 너의 <i>영혼</i>에서 보이는 것은 단지 자연스러운 것이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Karlach
#. NodeID = 40785498-ba17-48a8-89d6-71a98fd814a5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.      - GOB_PainPriest_State_CompanionReactedToPenanceOffer(4) = False
#.   Tag:
#.      - REALLY_KARLACH(4) = True
#. SetFlags:
#.   Object:
#.     - GOB_PainPriest_State_CompanionReactedToPenanceOffer(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:40785498-ba17-48a8-89d6-71a98fd814a5
msgctxt "h7d8ccd9fgbc1bg4f2bg879egff2869c0b1f4"
msgid "Hahaha. Go on. I <i>have </i>to see this."
msgstr "하하하. 해봐. <i>꼭</i> 봐야겠는걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = 4206ffec-37e0-1308-26ee-6173ce60b55f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:4206ffec-37e0-1308-26ee-6173ce60b55f
msgctxt "h411ac4ccg1a3eg44ddga019g31948defb09a"
msgid "But alas, these goblins seem to thrive on the crude and primitive."
msgstr "하지만 유감스럽게도, 이 고블린들은 조잡하고 원시적인 것을 즐기는 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = 42815f09-b4a1-a239-af90-0cb1fdf6f0cd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:42815f09-b4a1-a239-af90-0cb1fdf6f0cd
msgctxt "h2018cf05g5620g4fb3gae16gd046e2261b80"
msgid ""
"Forgive me, but that look in your eyes - something terrible has happened to "
"you."
msgstr "실례지만, 너의 그 눈빛을 보니, 뭔가 끔찍한 일이 일어난 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Player
#. NodeID = 4361196e-2728-0b55-9f3b-92fa0103357a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_PainPriest_Knows_PenanceIsPain = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:4361196e-2728-0b55-9f3b-92fa0103357a
msgctxt "hc2fba9cfga14eg49dfg9b04g13f875c66b59"
msgid "And how would you do that?"
msgstr "어떻게 할 생각이지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = 4451f2eb-2a14-49c4-69ea-c5f27f5773ce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:4451f2eb-2a14-49c4-69ea-c5f27f5773ce
msgctxt "h61768266ga3b5g4bd5ga94dge32d8916acab"
msgid "Most excellent! Then I shall speak plainly. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Player
#. NodeID = 44a4ebdd-6e16-f2ee-0e75-a4fbe3258956
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ShadowHeart_InParty_Knows_SharWorshipper = False
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:44a4ebdd-6e16-f2ee-0e75-a4fbe3258956
msgctxt "hb454eaafgb07eg4730g865dg1786d8166db6"
msgid "No - I already belong to another."
msgstr "아니, 난 이미 다른 분께 속해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = 45e723ab-4d4b-7e02-6f93-dc861b0cb6d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:45e723ab-4d4b-7e02-6f93-dc861b0cb6d9
msgctxt "h41887f32g7a4ag49f0gb12bg43a6221ec001"
msgid ""
"You see, pain is a <i>loving</i> thing. But trying to explain it to these "
"goblins has proven..."
msgstr "고통은 <i>애정 어린</i> 것이야. 하지만 이를 고블린들에게 설명해봤자..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Player
#. NodeID = 48f13198-02fd-99dd-dcb6-12d33b926632
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_PainPriest_Event_PickPiercing = True
#.   Object:
#.     - GOB_PainPriest_Event_CheckHP(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:48f13198-02fd-99dd-dcb6-12d33b926632
msgctxt "h03f98e55g682ag49ddg8dbagdbd5cf3c3a70"
msgid "I'm not in a gentle mood. Use the dagger."
msgstr "노닥거릴 기분이 아니네요. 단검으로 하죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Player
#. NodeID = 490d59b2-f5fe-00e7-08e6-26e1b6ea2ec9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:490d59b2-f5fe-00e7-08e6-26e1b6ea2ec9
msgctxt "hbfc59204gb6c4g4946g82f0g4e4c61d5b37d"
msgid "Why are you so interested?"
msgstr "왜 그렇게 관심을 가지는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Narrator
#. NodeID = 4e2a7b40-07ec-3d91-0cdd-0919ed44a1e8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:4e2a7b40-07ec-3d91-0cdd-0919ed44a1e8
msgctxt "h2855e978g7982g44d9ga442gd0c86b5f4cfb"
msgid ""
"*This man is of common stock. Only the poorest of men need settle for the "
"spectacle of their <i>own</i> gore.*"
msgstr "*이자는 특별한 게 없습니다. <i>자신</i>의 유혈이 낭자한 광경에 만족하는 자들이 가장 안타까운 법이죠.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = 4ea0ccdd-1310-e5de-d5bf-460b799756bd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:4ea0ccdd-1310-e5de-d5bf-460b799756bd
msgctxt "h636eb64dg2d9dg4246g815bg8cb77805389a"
msgid "To understand pain and its intimacies..."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Player
#. NodeID = 4ef92796-c30f-4fcf-2d8f-014e13173055
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:4ef92796-c30f-4fcf-2d8f-014e13173055
msgctxt "h7c90f0c5g5363g4250ga295g77358111c5ab"
msgid "I couldn't agree more."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = 4f0e9891-069d-bdcc-d433-d4a23ee5d56c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_PainPriest_Event_PickScourge = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:4f0e9891-069d-bdcc-d433-d4a23ee5d56c
msgctxt "hec7dfdf4gf151g4c4agb653gc7a3455a7c80"
msgid "Oh, I have something <i>exquisite</i> in mind."
msgstr "오, 내가 아주 <i>강렬한</i> 것을 생각해 두었지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = 50ffde27-88f1-f303-f644-2078219ba549
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:50ffde27-88f1-f303-f644-2078219ba549
msgctxt "hdef842cag1b3fg4a09g8fa3g695fa18519a7"
msgid "But alas, they insist on being <i>so </i>primitive."
msgstr "하지만 안타깝게도, 그들은 <i>너무나</i> 원시적인 방식을 고수하더군. "

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = 53294b8e-a1dc-408b-f41e-da17de1245f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:53294b8e-a1dc-408b-f41e-da17de1245f3
msgctxt "h70b9ab5dg633eg4e3dgb017g9f9747a7667a"
msgid "A pity. You would know such sweet relief at my hands."
msgstr "유감이군. 내 손이 얼마나 달콤한 안도감을 주는지 알게 될 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = 532d4a3e-1062-7ae5-e291-383aeadf8f59
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:532d4a3e-1062-7ae5-e291-383aeadf8f59
msgctxt "hc7ff5c53g5d93g4623gaccfgadc67fc43d12"
msgid "Should you realise you need my assistance, come back. I'll be waiting."
msgstr "내 도움이 필요해지면, 돌아와라. 기다리고 있겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Player
#. NodeID = 53787466-649b-c7c0-cfe7-d5a435f014b0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = False
#. TagRule: CLERIC_EVIL or PALADIN_EVIL
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:53787466-649b-c7c0-cfe7-d5a435f014b0
msgctxt "he4c69bc4g4d08g4495g9703g77d34099d1b8"
msgid "My god is a possessive one - I better refrain."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Lae'zel
#. NodeID = 547b5e38-f07c-4ade-8c2e-91ee66281523
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(2) = True
#.      - GOB_PainPriest_State_CompanionReactedToPenanceOffer(2) = False
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
#. SetFlags:
#.   Object:
#.     - GOB_PainPriest_State_CompanionReactedToPenanceOffer(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:547b5e38-f07c-4ade-8c2e-91ee66281523
msgctxt "h5c991e62ge130g484dg804agdebc1d2ec8c5"
msgid "By all means - let us see what his 'skilled hand' might get up to."
msgstr "얼마든지, 그의 '숙련된 손'이 무슨 짓을 할지 기대되는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Wyll
#. NodeID = 58da8808-297e-4bff-a90c-4e8a2a184ddc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.      - GOB_PainPriest_State_CompanionReactedToPenanceOffer(6) = False
#.   Tag:
#.      - REALLY_WYLL(6) = True
#. SetFlags:
#.   Object:
#.     - GOB_PainPriest_State_CompanionReactedToPenanceOffer(6) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:58da8808-297e-4bff-a90c-4e8a2a184ddc
msgctxt "ha3725302gf6b5g483ag96cdgb613009bf6ed"
msgid "I wouldn't let his 'skilled hand' anywhere <i>near</i> me."
msgstr "나는 그의 '숙련된 손'을 어디든 <i>가까이</i> 두고 싶지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = 5a98781c-4651-1548-37dd-779087c56f6b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_PainPriest_State_SpikeIsInRoom = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:5a98781c-4651-1548-37dd-779087c56f6b
msgctxt "h2e3d2746ga57dg4c2dg90e4g311a6660457c"
msgid ""
"Yes. He's just over there. Between you and I, his claims of mastery over "
"pain are <i>unfounded.</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Player
#. NodeID = 5bcb760f-5665-e04c-ea39-b833a059c0de
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - NIGHT_DarkUrge_ButlerIntro = True
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:5bcb760f-5665-e04c-ea39-b833a059c0de
msgctxt "he643b7b4gb22eg4ecfg9305g300c40a09ea0"
msgid "I'm a contemptible blood-pervert."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = 5f340092-5ce8-a403-c69c-f477f57d1ada
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:5f340092-5ce8-a403-c69c-f477f57d1ada
msgctxt "h8b3a117eg4781g46a3gb68aga9f8ef481dc3"
msgid ""
"A shame - the Mistress of the Night and the Maiden of Pain could have such "
"<i>fun </i>together."
msgstr "아쉽군. 밤의 여인님과 고통의 처녀님이 함께 <i>즐길</i> 수도 있었는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = 62b280e1-85be-b877-63f7-c7bab977ba0f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_PainPriest_HasMet(1) = False
#.   Global:
#.      - GOB_PainPriest_Knows_PenanceIsPain = False
#. SetFlags:
#.   Dialog:
#.     - GOB_PainPriest_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:62b280e1-85be-b877-63f7-c7bab977ba0f
msgctxt "h37399e9cga7d5g4dbegbc6agf117d2cadb15"
msgid "Greetings, child. I've met few aside from goblins here."
msgstr "환영한다, 아이야. 여기서 고블린 말고는 사람을 거의 못 봤는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = 664f9020-e8f4-fd38-9fd1-680d5f7daf50
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:664f9020-e8f4-fd38-9fd1-680d5f7daf50
msgctxt "h44940cadgf05eg4d4dg9b34ge4fc6f81a124"
msgid ""
"Exactly, pain is an <i>intimate</i> thing. It should be delivered with a "
"loving and measured hand."
msgstr "그렇고 말고. 고통은 <i>친밀한</i> 것이야. 애정과 정성이 어린 손으로 전해야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Shadowheart
#. NodeID = 67d8640d-f6fb-4185-a843-fccd94f93f91
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.      - GOB_PainPriest_State_CompanionReactedToPenanceOffer(3) = False
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#. SetFlags:
#.   Object:
#.     - GOB_PainPriest_State_CompanionReactedToPenanceOffer(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:67d8640d-f6fb-4185-a843-fccd94f93f91
msgctxt "hb895290ageab1g4ed2g9e6bgd00fd3856528"
msgid "Go ahead - I'm sure you're in need of a little <i>penance...</i>"
msgstr "해봐 - 네겐 약간의 <i>속죄...</i>가 필요해 보여."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = 67eda683-d619-3dfd-8bed-62c4bc1a5e4d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:67eda683-d619-3dfd-8bed-62c4bc1a5e4d
msgctxt "hc0b10b72gf0d4g44feg9e0eg97c18087442f"
msgid "Now, if you'll excuse me, I should return to my own worship."
msgstr "그럼, 실례되지 않는다면, 나는 다시 나만의 숭배 행위를 계속하겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Player
#. NodeID = 6ab356b7-b85e-7c2b-f0fe-66c3c2d77ff3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:6ab356b7-b85e-7c2b-f0fe-66c3c2d77ff3
msgctxt "ha30e7c80g6653g40f5gbf78g8a914e3efeb2"
msgid "Touch me and you'll lose your hand."
msgstr "날 건드리면 그 손을 잃을 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = 6c4f7aba-a0c0-684e-f053-042c0f0d6995
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:6c4f7aba-a0c0-684e-f053-042c0f0d6995
msgctxt "h3f6d6693g5b6cg42b7g8516g63bc305b9e91"
msgid ""
"But I understand. Pain is something that requires <i>commitment</i>, "
"wouldn't you say? "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = 6db9338d-d4f5-9ae7-1830-5161215f025b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:6db9338d-d4f5-9ae7-1830-5161215f025b
msgctxt "h8fe64fceg6e39g4e4cg98c6g709f7b97b55c"
msgid ""
"I was invited to discuss pain and its intricacies, but even I find these "
"goblins crude and, well - primitive."
msgstr "나는 고통과 그 복잡성에 대해 논의하라고 초대 받았지만, 나조차도 이 고블린들은 조잡하고 원시적이라고 생각해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = 6e83ffa2-8dcb-4dc3-b523-25352f44b3dd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:6e83ffa2-8dcb-4dc3-b523-25352f44b3dd
msgctxt "h89d33ca1gd5b7g4d62gb4e9g76a72df4dd0e"
msgid "Please let me alleviate this pain."
msgstr "부디 내가 그 고통을 완화하게 해줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = 6fe587c5-2104-83f8-d684-c76d3e1bf1c4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_PainPriest_State_NeedMoreHP(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:6fe587c5-2104-83f8-d684-c76d3e1bf1c4
msgctxt "hb3b2b4aag46c0g4827g9a08gffd5c7cff9b6"
msgid ""
"But wait - you are hurt. Please tend to your wounds before we begin your "
"penance."
msgstr "하지만 잠깐, 너 다쳤구나. 고행을 시작하기 전에 앞서 상처를 치료하고 오렴."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Gale
#. NodeID = 72ca44c5-e14b-4c53-bb67-aa6a037a818a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.      - GOB_PainPriest_State_CompanionReactedToPenanceOffer(7) = False
#.   Tag:
#.      - REALLY_GALE(7) = True
#. SetFlags:
#.   Object:
#.     - GOB_PainPriest_State_CompanionReactedToPenanceOffer(7) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:72ca44c5-e14b-4c53-bb67-aa6a037a818a
msgctxt "h26c036c0gd0deg4444gaf1ag69c08ddf16f0"
msgid "Your hide, your choice. Not quite my cup of tea though."
msgstr "네 목숨이니 네가 알아서 해. 하지만 내 취향은 아닌걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Player
#. NodeID = 72cdee95-5080-91f9-f428-a3ae209d5089
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_PainPriest_State_CancelledTwice(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:72cdee95-5080-91f9-f428-a3ae209d5089
msgctxt "hf9ac914dg1f5dg4116g8fa0g3d312c72411a"
msgid "I think I can do without."
msgstr "전 괜찮아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = 7b4eb527-1435-0c86-26b1-275c7d5ed04b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:7b4eb527-1435-0c86-26b1-275c7d5ed04b
msgctxt "he3b6f6c7g0020g4d9ag8b90ga9616b7943dc"
msgid ""
"I was invited to to teach them. I live for pain and its intricacies, you "
"see, but alas..."
msgstr "나는 저 자들을 가르쳐달라고 초대를 받았어. 나는 고통과 그 복잡성을 추구하지만... 아아..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Player
#. NodeID = 7e3665a0-6efb-951b-b72f-e116f11eda09
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:7e3665a0-6efb-951b-b72f-e116f11eda09
msgctxt "h0b5b5fabg3112g4b71g8e7dgac7025dbd88d"
msgid "Clever man. How did you know?"
msgstr "영리하군. 어떻게 알았지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Player
#. NodeID = 84bdcf44-4010-c5f9-44db-c20be5a0f63c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_God_Knows_Loviatar = True
#.   Tag:
#.      - CLERIC(1) = False
#.      - PALADIN(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:84bdcf44-4010-c5f9-44db-c20be5a0f63c
msgctxt "hc9fbafebgccd8g4cbeg9030g610ab8a46393"
msgid "I thought a follower of Loviatar would approve of pain."
msgstr "로비아타의 신도는 고통을 좋아할 줄 알았는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Player
#. NodeID = 856a3079-6967-b9ab-1fba-0dfb2dc5069c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:856a3079-6967-b9ab-1fba-0dfb2dc5069c
msgctxt "hf257bd32g9f97g4abegab60g6e9e8db29877"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = 86db7118-01e9-5e16-bf09-49747a415024
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:86db7118-01e9-5e16-bf09-49747a415024
msgctxt "hdeee869agb692g409egab60g496f8be3045f"
msgid ""
"True. But isn't that why it's important to try it? To expand your horizons?"
msgstr "맞아. 하지만 그렇기에 시도하는 게 중요하지 않은가? 네 경험을 확장하는 것이?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = 878b9880-f7e9-37e3-7a42-50e6706b6744
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:878b9880-f7e9-37e3-7a42-50e6706b6744
msgctxt "h5e380fbeg9b06g4f1cga48dg09bd8fba7cdd"
msgid ""
"And should our pain delight her - should we <i>embrace</i> such a gift - she "
"will grant her most sacred of blessings."
msgstr ""
"그리고 우리의 고통이 그분을 기쁘게 할 수 있다면, 우리가 그 선물을 <i>포용할</i> 수 있다면, 그분이 가장 신성한 축복을 하사해 "
"주실 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = 8b6b94e7-4f86-a89f-ad7e-cb46f267488f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_PainPriest_Event_PickScourge = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:8b6b94e7-4f86-a89f-ad7e-cb46f267488f
msgctxt "hb254f8f2g04e5g4d4fg92beg138ae1c0ca75"
msgid "Oh, I have something <i>exquisite</i> in mind."
msgstr "오, 내가 아주 <i>강렬한</i> 것을 생각해 두었지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = 8b74c36c-8016-622a-9dc6-8f9091e48eda
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_PainPriest_State_CancelledPenitent(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:8b74c36c-8016-622a-9dc6-8f9091e48eda
msgctxt "h401cf17fg7375g40bbg8ee9ge366ab428c69"
msgid ""
"Dear child, tell me: would you like to continue your worship of Loviatar, "
"Maiden of Pain?"
msgstr "아이야, 말해보렴: 로비아타, 고통의 처녀를 계속 섬기고 싶니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = 8cde0a25-f347-f128-5a65-03eea071802f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:8cde0a25-f347-f128-5a65-03eea071802f
msgctxt "h655445f5g13b0g4852gaf58g372ba56c2d47"
msgid "I prefer a <i>fresh</i> canvas."
msgstr "난 <i>깨끗한</i> 캔버스인 쪽이 좋거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = 8d384716-4660-c0ee-f8c3-21945708bca8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:8d384716-4660-c0ee-f8c3-21945708bca8
msgctxt "h9df654bdgce3cg4df8gb31agc09c5db4b05e"
msgid ""
"You know the Maiden of Pain? How refreshing. But there is more to us than "
"that."
msgstr "고통의 처녀님을 알고 있나? 흥미롭군. 하지만 우리에게 고통은 더 많은 의미를 갖고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = 8dde52a9-9b95-a46a-2529-81f4d4ccc1f7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:8dde52a9-9b95-a46a-2529-81f4d4ccc1f7
msgctxt "h1a0d7b75gd1d5g4621g90b9g6e1848958e2b"
msgid ""
"Hah. I realise this looks strange, but I assure you, it is a most "
"<i>intimate</i> form of worship."
msgstr "하. 내가 이상해 보일 줄 알았어. 하지만 장담컨대, 이는 가장 <i>친밀한</i> 숭배 행위라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = 90ea1d6a-3128-ecb9-bf05-b40bc6be6f19
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:90ea1d6a-3128-ecb9-bf05-b40bc6be6f19
msgctxt "h17f769dcg5239g4f9ag9c3cg52539e3ee568"
msgid "A most <i>excellent </i>choice."
msgstr "<i>정말</i> 훌륭한 선택이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = 92112233-8eaf-9079-7e90-f89d2d82d8eb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:92112233-8eaf-9079-7e90-f89d2d82d8eb
msgctxt "h8870a1f8g3b7dg4f3dg9c23g200c3dac79fe"
msgid ""
"Quite right. I was invited to teach them. I live for pain and its "
"intricacies, you see."
msgstr "정확하군. 나는 저 자들에게 내... 기술을 가르쳐달라고 초대를 받았어. 그런데 말이야, 나는 고통과 그 복잡성을 추구해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Player
#. NodeID = 99a54f37-d00b-2dbf-67e9-84fd42bedbba
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Torturers_Assisted(1) = True
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:99a54f37-d00b-2dbf-67e9-84fd42bedbba
msgctxt "hd872151fg1f5dg4583gac85gac7ccb5ecec2"
msgid "I showed them what a master can do."
msgstr "달인은 어떤 걸 할 수 있는지 보여줬지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = 9ad1f3e6-124d-7a9c-4308-6e86321dcaa2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:9ad1f3e6-124d-7a9c-4308-6e86321dcaa2
msgctxt "h92a8e4d5g6a90g4e9ag83fag5c18e55123b9"
msgid "But trying to discuss such subtleties with these creatures is simply..."
msgstr "하지만 그 중요한 것을 이 생물들과 논하려고 애써봤자 단지..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Player
#. NodeID = 9b054fc0-9794-c142-5b53-9f67342cff25
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:9b054fc0-9794-c142-5b53-9f67342cff25
msgctxt "h20bc6c8dg5275g47b6ga22bgd7bd1fe47a1e"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Player
#. NodeID = 9b72a347-3932-0150-eda5-50ca42d09040
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:9b72a347-3932-0150-eda5-50ca42d09040
msgctxt "h924c0818g87e9g470fga09agf616d03c31f1"
msgid "What's a follower of the Maiden of Pain doing here?"
msgstr "고통의 처녀를 추종하는 자가 여기에서 뭘 하는 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Player
#. NodeID = 9c605648-c662-4c6d-402b-5c6a97c35f6c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_PainPriest_Knows_PenanceIsPain = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:9c605648-c662-4c6d-402b-5c6a97c35f6c
msgctxt "h2bd15242g7b98g4d41g8cd5g9aca0cc1da5d"
msgid "I'm interested in this penance."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Player
#. NodeID = 9ec6cebd-60e8-ecb4-4ef8-a34d993d48ce
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:9ec6cebd-60e8-ecb4-4ef8-a34d993d48ce
msgctxt "h05ab4eb4g2b52g4dc8gad92g85233e1d2f74"
msgid "I often feel I like raw pain <i>too much</i>. It scares me."
msgstr "생생한 고통이 <i>너무</i> 좋다고 느낄 때가 자주 있어. 걱정될 정도야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = a14549c5-1bbe-869c-ea50-f2a7064117b9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:a14549c5-1bbe-869c-ea50-f2a7064117b9
msgctxt "h3cbe9b12gba73g422egbb45g79e153d66c58"
msgid ""
"The Mistress would approve. Indicate which instrument calls to you, and let "
"us put it to work."
msgstr "여신께선 개의치 않으실거네. 어떤 도구가 마음에 드는지 알려주면 바로 시작하도록 하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = a2fb4891-4f01-e093-3365-c2322839aaa4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:a2fb4891-4f01-e093-3365-c2322839aaa4
msgctxt "he66d9a4dgf142g4a03g87efg42e2ce2daf4b"
msgid "I thought you would prove interesting... I guess I was mistaken."
msgstr "네가 흥미로울 거라 생각했는데... 착각했나보군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Player
#. NodeID = a6d0eff3-2ba6-1e1b-a6ce-3fe0e218a8de
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:a6d0eff3-2ba6-1e1b-a6ce-3fe0e218a8de
msgctxt "hde21d5a4g0d69g419dgb993gdedbe0e4c0ea"
msgid "That's none of your concern."
msgstr "그건 당신이 신경쓸 바 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = a7cf5c6f-3b9e-e5e2-cb52-0b329a9df8ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:a7cf5c6f-3b9e-e5e2-cb52-0b329a9df8ea
msgctxt "h6d2bff95gfb66g4393gbb10gc63eb9ec1738"
msgid "Yes. One who claims to be a master of pain. Tch."
msgstr "그래. 고통의 대가라고 주장하는 놈이지. 쯧."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = a9250cae-a6b0-b516-aff1-1d9cd4da841b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:a9250cae-a6b0-b516-aff1-1d9cd4da841b
msgctxt "hc7ae2c1fg6d85g42d4g9493g98cf3e978063"
msgid "Ah, but of course!"
msgstr "아, 물론!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Player
#. NodeID = ab8aa574-b997-5127-d3e0-2cc4fbe46ab6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_PainPriest_Event_CheckHP(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:ab8aa574-b997-5127-d3e0-2cc4fbe46ab6
msgctxt "h0b70b55fg5e31g4501gbda1g35c1f6abc3e2"
msgid "All right, why not?"
msgstr "좋아, 안될 이유가 뭐가 있어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Player
#. NodeID = b2b009fa-e63d-506d-cdc7-8e8615cc4460
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Torturers_HasMet_Spike(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:b2b009fa-e63d-506d-cdc7-8e8615cc4460
msgctxt "h8668dac9gadbeg49c7g8789ged85d3e08892"
msgid "You mean the one they are <i>torturing</i>?"
msgstr "저 녀석들이 <i>고문하고 있는</i> 사람을 말하는 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = b31c9b7a-8953-246f-f68a-1403e9daac45
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:b31c9b7a-8953-246f-f68a-1403e9daac45
#, fuzzy
msgctxt "h1048a0e1g3cdcg42f6g8642gf71d1de4d77d"
msgid "If you would permit it, I can show you first-hand."
msgstr "만약 네가 허락한다면, 내가 너에게 직접 보여줄 수 있다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = b4b8c187-2d56-1b8b-1de6-5f1e159e3029
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:b4b8c187-2d56-1b8b-1de6-5f1e159e3029
msgctxt "h6759f6f6g31cfg40d6gb5e0g72b8c6a494e7"
msgid "Pity. You do not understand the gift you refuse."
msgstr "불쌍한 것. 어떤 선물을 거절한 건지 이해 못 하는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Player
#. NodeID = b5315b17-1abc-66f5-34b9-dabf2d6cf74a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(1) = False
#. TagRule: CLERIC_ILMATER or PALADIN_ILMATER
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:b5315b17-1abc-66f5-34b9-dabf2d6cf74a
msgctxt "h48c311ffgd023g4529ga5efgbb38d8f42100"
msgid "<i>You know the value of suffering. Prepare for the coming pain.</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = b6841694-0a1f-3112-8d0f-142dd7852f9e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:b6841694-0a1f-3112-8d0f-142dd7852f9e
msgctxt "h87c55079g4f7dg40cfg8cf4g58f1292bb359"
msgid "My - an eager student indeed. Those are <i>advanced </i>devotions."
msgstr "이런 - 실로 열의가 넘치는 학생이로구나. <i>대단한</i> 헌신이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = b94a675f-eb85-95ab-e434-3fe4bf2b4b0b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:b94a675f-eb85-95ab-e434-3fe4bf2b4b0b
msgctxt "h179139c3gdb37g4e1fga17fg99c384050d4d"
msgid "Unfortunate. Loviatar is always happy to share her pleasures."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = b9516baa-6dee-eabc-f29a-02b38cc96c1a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:b9516baa-6dee-eabc-f29a-02b38cc96c1a
msgctxt "h8eb1a0b3g1ecag4f11g8659g11ea1ec4c6a5"
msgid "Because I see those same eyes when I look in the mirror, dear one."
msgstr "내가 거울을 볼 때도 똑같은 눈이 보이기 때문이지, 얘야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = ba9b945b-81e1-49f5-b2e7-d656ac952ede
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_PainPriest_State_TooLowHP(1) = True
#.      - GOB_PainPriest_State_NeedMoreHP(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:ba9b945b-81e1-49f5-b2e7-d656ac952ede
msgctxt "h1292804bg5044g43a4g8a18geb38b11ac2f3"
msgid ""
"Dear child, I told you - take care of those wounds, and we will begin your "
"penance."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = bb48a312-6c42-4e9f-ff94-699ee27aa674
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:bb48a312-6c42-4e9f-ff94-699ee27aa674
msgctxt "hb3aebcdeg82efg4b80gb1a8g4df159c5e04e"
msgid "Is that a promise?"
msgstr "그렇게 약속했나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = bdceffb4-6fbc-6ca0-01bf-698f0ca192fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:bdceffb4-6fbc-6ca0-01bf-698f0ca192fd
msgctxt "h8a3ff860g7704g4ae1ga5ddg6cb62579f260"
msgid ""
"We've all suffered in these dark times. It is little wonder you bear scars "
"of pain and anguish."
msgstr "우리 모두 이 암울한 시기에 고통을 겪었잖아. 고통과 고뇌의 상처를 안고 있는 것은 당연한 일이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = be1b5750-138d-6b75-0704-f9c7e8985b45
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:be1b5750-138d-6b75-0704-f9c7e8985b45
msgctxt "h84d61943g007cg4eecgb7c2gab9f54769432"
msgid ""
"My work can grant peace and serenity - the likes of which few experience. It "
"will be worth it - I promise."
msgstr "내 과정은 평화와 평온을 가져다줄 수 있어. 다른 데서는 이런 경험을 할 수 없을 거야. 그만한 가치가 있을 거라고 장담하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Player
#. NodeID = be66915a-d35d-1fd8-3642-190404fff2e0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_PainPriest_Knows_Book = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:be66915a-d35d-1fd8-3642-190404fff2e0
msgctxt "h28a9b9e6ga553g4f9ega36eg462179e0faf5"
msgid "I saw your book. I'd like to try some of <i>those </i>techniques."
msgstr "당신의 책을 봤어요. <i>몇 가지</i>를 시도해 보고 싶은데요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = bfdd80d5-3420-8fd1-478b-7cf1e7a199f6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:bfdd80d5-3420-8fd1-478b-7cf1e7a199f6
#, fuzzy
msgctxt "h60863a9bg413fg435fg88ccgc397c04ccbd5"
msgid "If you would permit it, I can show you first-hand."
msgstr "만약 네가 허락한다면, 내가 너에게 직접 보여줄 수 있다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Player
#. NodeID = c14044ae-8c4c-9796-139e-9855715e324f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = False
#.      - PALADIN_EVIL(1) = False
#.      - CLERIC_EVIL(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:c14044ae-8c4c-9796-139e-9855715e324f
msgctxt "h7e9e2d2ag3dfeg4ee2gaa1ega3a657e3c3da"
msgid "I've no interest in the teachings of such an evil goddess."
msgstr "사악한 여신의 교리 따위엔 관심 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = c3709b8d-ca03-e329-73c1-3fea4d26d9d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:c3709b8d-ca03-e329-73c1-3fea4d26d9d8
msgctxt "h644d7d82gd8bag458egaf72g84c09aa3a6c5"
msgid "Pity. You do not understand the gift you refuse."
msgstr "불쌍한 것. 어떤 선물을 거절한 건지 이해 못 하는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Player
#. NodeID = c88b2ddc-0bf4-6546-9ec8-e1a56dadc96e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:c88b2ddc-0bf4-6546-9ec8-e1a56dadc96e
msgctxt "h2e6ccaabg014ag473bga9f3g26ffcad14310"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = cbf514ed-2608-e3c6-de6c-c9582745b4b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:cbf514ed-2608-e3c6-de6c-c9582745b4b6
msgctxt "h10bc4d28ga851g44e8g9c58g2f309f3c6aa8"
msgid ""
"The gentleman being held next door. My acquaintance is working on him, I "
"believe."
msgstr "옆방에 붙들려 있는 신사 말이야. 내 지인이 그에게 할 일이 있는 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = cd258d42-f115-71f7-1a8f-5a8602d53128
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_God_Knows_Loviatar = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:cd258d42-f115-71f7-1a8f-5a8602d53128
msgctxt "h68f6302bgefbdg4e6fgb0a4gf6f28df66329"
msgid ""
"Well - the Maiden of Pain, Loviatar, teaches us that pain is a most powerful "
"and sacred sensation."
msgstr "그건 말이지, 고통의 처녀 로비아타님이 고통은 가장 강력하고 신성한 감각이라고 가르쳐주셨다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = cdaf628f-8bde-1d20-91ac-57283f720e7f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:cdaf628f-8bde-1d20-91ac-57283f720e7f
msgctxt "h285164a4g3159g4b04g92cdg189edd1e08ae"
msgid "Ah, are you also here to assist with the prisoner?"
msgstr "아, 너도 그 포로를 도우러 왔나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = cef66534-15bb-308d-f935-d7f3a9f676cb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Torturers_State_SpikeIsDead = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:cef66534-15bb-308d-f935-d7f3a9f676cb
msgctxt "he1914401g1f5eg42a9g97fag838f19066104"
msgid ""
"Pain should be intimate and <i>loving</i> - not violent and brutish. Alas, "
"he..."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Player
#. NodeID = d031d80a-e8fd-8301-f967-4975cdf0edbe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Torturers_HasMet_Spike(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:d031d80a-e8fd-8301-f967-4975cdf0edbe
msgctxt "hb4150a08ga05dg4d8bg9c1ag7e592eed96f6"
msgid "What prisoner?"
msgstr "어느 포로 말이지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Astarion
#. NodeID = d21d7fc6-7346-414f-933f-d12db3948fd5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.      - GOB_PainPriest_State_CompanionReactedToPenanceOffer(5) = False
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#. SetFlags:
#.   Object:
#.     - GOB_PainPriest_State_CompanionReactedToPenanceOffer(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:d21d7fc6-7346-414f-933f-d12db3948fd5
msgctxt "hba7eff73gf4fdg405fg8824g8032cc2f8dd2"
msgid "I must see this. Don't you dare say no."
msgstr "이건 꼭 봐야지. 거절하기만 해봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Player
#. NodeID = d2661cfa-f8be-6352-fa2d-4118c7805912
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_PainPriest_Event_PickScourge = True
#.   Object:
#.     - GOB_PainPriest_Event_CheckHP(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:d2661cfa-f8be-6352-fa2d-4118c7805912
msgctxt "h02170301gee70g4da5gb0d5gc39d6a9f85b7"
msgid "I'll have what you're having."
msgstr "당신이 고르는 걸로 하죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = d4e75f3a-1f76-d2c9-e016-fe7782537e15
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:d4e75f3a-1f76-d2c9-e016-fe7782537e15
msgctxt "h8bf8cebag80f4g4ccfg8810gaa33f9da9741"
msgid ""
"Would you care experience it first-hand? To know peace and serenity, the "
"likes of which few experience? "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Player
#. NodeID = d882bda9-2fa2-7279-e757-af2efba3f61f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:d882bda9-2fa2-7279-e757-af2efba3f61f
msgctxt "h5c97f32ag8489g4a8bg9841gea0ce8dd756a"
msgid "<i>Prepare for the coming pain.</i>"
msgstr "<i>다가올 고통에 대비한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Player
#. NodeID = d9d39e96-43b1-b50c-b3c2-5e9af84d744f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:d9d39e96-43b1-b50c-b3c2-5e9af84d744f
msgctxt "hf3d69059gd4e0g412bga10dg06edf83c44f5"
msgid "I feel an endless nausea, that only goes away when I'm killing."
msgstr "메스꺼움이 끝없이 느껴지는데, 살인을 해야만 사라져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = dcc12eed-54bf-bf0a-eade-1c15814564df
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_PainPriest_State_CancelledTwice(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:dcc12eed-54bf-bf0a-eade-1c15814564df
msgctxt "h447383beg061eg4f3dg84cbg3412d19697ac"
msgid ""
"You have refused the gift of penance, dear one. I will waste no more time "
"asking you."
msgstr "아이야, 넌 속죄의 선물을 거부했잖니. 네게 더 시간을 낭비하진 않을 거란다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Player
#. NodeID = dd2560c2-7391-0592-a5ae-b8788e079c8c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_PainPriest_Knows_Book = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:dd2560c2-7391-0592-a5ae-b8788e079c8c
msgctxt "hd4f3f974g306ag46b7g85f3gad6fa850d239"
msgid "I saw your book. Let me try some of those techniques."
msgstr "당신의 책을 봤어요. 몇 가지를 시도해 볼래요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Player
#. NodeID = dd7f6f53-ddb0-d00e-1fc7-4934b8923e98
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ShadowHeart_InParty_Knows_SharWorshipper = True
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:dd7f6f53-ddb0-d00e-1fc7-4934b8923e98
msgctxt "h24b79e89g26d8g4914ga384gce56c36e3611"
msgid "No - Shar has already claimed me."
msgstr "싫어, 이미 샤님이 내 임자라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Player
#. NodeID = e54afa6c-44c8-b4d8-121c-a68fee8699dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:e54afa6c-44c8-b4d8-121c-a68fee8699dc
msgctxt "h4e55f51cg9529g4d75g9cf5g1205446d5f30"
msgid "Who invited you? A goblin?"
msgstr "누가 너를 초대했지? 고블린인가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = e9fc0ab2-0805-d149-a5b6-4596946dc816
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_PainPriest_State_TooLowHP(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:e9fc0ab2-0805-d149-a5b6-4596946dc816
msgctxt "h0630c33egfb21g4510g9a1bg3fa1e69042e9"
msgid "Both Loviatar and I are interested in how you handle pain, dear one."
msgstr "로비아타님과 나는 네가 고통을 어떻게 다루는지 관심 있단다, 얘야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Player
#. NodeID = ea0f672b-2d11-ab38-2c13-cef2c02d08c3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:ea0f672b-2d11-ab38-2c13-cef2c02d08c3
msgctxt "heb44171ag92b2g42e1ga818gd63a2b132cd9"
msgid "I think I can do without."
msgstr "전 괜찮아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Player
#. NodeID = ecaca919-e01b-e7fa-cda7-cb2707d1a371
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:ecaca919-e01b-e7fa-cda7-cb2707d1a371
msgctxt "had78ea66g7f92g40c3g878fg1ac82250cea9"
msgid "It's appalling."
msgstr "흉측하군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Narrator
#. NodeID = eef3a101-88cc-b60c-3b3e-bc41ffb7f940
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_God_Knows_Loviatar = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:eef3a101-88cc-b60c-3b3e-bc41ffb7f940
msgctxt "hd2faaf79g3612g46ccg9eb9gf41a43aae4e8"
msgid ""
"*You recognise the scourge - this man is a follower of Loviatar, goddess of "
"pain.*"
msgstr "*당신은 채찍을 알아봅니다. 이 남자는 고통의 여신 로비아타의 신도입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = ef07a49e-2fb9-b58a-6895-e9bc56d454a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:ef07a49e-2fb9-b58a-6895-e9bc56d454a6
msgctxt "h6f415fb1gb30fg4a0bg93a9g10ccbc7976f0"
msgid "Your tastes must turn to the exotic, if you would stop here by choice."
msgstr "이곳에 제 발로 들르다니, 취향이 독특하구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = ef81eb57-1f13-304a-d358-8c0130dc524b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:ef81eb57-1f13-304a-d358-8c0130dc524b
msgctxt "h962570a8g6519g4692gb535gb79d3e61fba2"
msgid ""
"Or claimed, rather. Pain should be intimate and <i>loving</i> - not violent "
"and brutish. Perhaps in death he..."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = f4c9f97e-6b74-d21f-d91e-2229871f3769
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:f4c9f97e-6b74-d21f-d91e-2229871f3769
msgctxt "h5be3ae7bg206cg4388g957dgf56ed5d194f2"
msgid ""
"Yes, we worship her through pain - often our own. But it is an intimate and "
"<i>loving</i> thing and one we offer up."
msgstr ""
"그래, 우리는 고통을 통해 그녀를 숭배하지. 때로는 우리 자신의 고통도 마다하지 않아. 하지만 고통은 친밀하고 <i>애정 어린</i> "
"것이며, 우리가 올리는 선물이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = f4ef2c8a-0bb6-571c-56fb-e09f5741ed39
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:f4ef2c8a-0bb6-571c-56fb-e09f5741ed39
msgctxt "h03bd40acg1572g450ag8a5dg6421395c5ef1"
msgid "Pain is pain, dear one. It is above 'good' and 'evil'. "
msgstr "고통은 그저 고통일 뿐이다, 선하다거나 악한 게 아니라. "

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = f70f179f-ec96-37f7-52ed-4cc2d599a9fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:f70f179f-ec96-37f7-52ed-4cc2d599a9fe
msgctxt "h4ed6f873g10b3g4333g8b53g43ce6537802b"
msgid ""
"I worship her through pain - usually my own. But I have a skilled hand when "
"it comes to its infliction. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = fa192b0c-2357-041c-7546-ddb945dc17c7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:fa192b0c-2357-041c-7546-ddb945dc17c7
msgctxt "h8d7f0814g8027g4cf8gaad5ga0f3e9974b46"
msgid ""
"And should you delight her, you will most assuredly receive her gracious "
"blessing - trust me."
msgstr "그리고 네가 그분을 기쁘게 해드리면, 반드시 그분의 은혜로운 축복을 받게 될 거야. 믿어봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = fdcc825d-b3c4-f697-eaa5-bea2ce0f2a19
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_God_Knows_Loviatar = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:fdcc825d-b3c4-f697-eaa5-bea2ce0f2a19
msgctxt "h612bd873g0a37g40bdg828bge43951f82a04"
msgid "As the Maiden of Pain, the goddess Loviatar, teaches us..."
msgstr "고통의 처녀 로비아타 여신님의 가르침에 따라..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest
#. Speaker = Abdirak
#. NodeID = ff6db07a-99a0-16c9-4edb-47aa7dfd67ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest:ff6db07a-99a0-16c9-4edb-47aa7dfd67ed
msgctxt "h695c0ad5g8ebfg438bgb74dg4d899ef647f4"
msgid "Pain without purpose is a terrible thing, wouldn't you agree?"
msgstr "목적 없는 고통은 흉측한 것이거늘, 너도 동의하지 않나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Battlestation
#. Speaker = Abdirak
#. NodeID = 43391e4a-5b88-00d3-8744-b1a1b9cb01ac
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_PainPriest_State_WasPenitent(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Battlestation:43391e4a-5b88-00d3-8744-b1a1b9cb01ac
msgctxt "h2c595fabgb687g4633gb4f7g464841a4b506"
msgid ""
"My penitent child, the goblins have blood on their minds. I am leaving - I "
"suggest you do the same. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Battlestation
#. Speaker = Abdirak
#. NodeID = 76340790-6c3c-52c0-13e4-5a8a17839dcd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_PainPriest_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_PainPriest_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Battlestation:76340790-6c3c-52c0-13e4-5a8a17839dcd
msgctxt "h68ea780ag9ad9g49d6gbb32g55b2a564ba4b"
msgid ""
"These goblins have blood on their minds. I am leaving - I suggest you do the "
"same. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Battlestation
#. Speaker = Abdirak
#. NodeID = 8b05fdff-1585-4288-d16d-01182dddf57f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_PainPriest_State_Penitent(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Battlestation:8b05fdff-1585-4288-d16d-01182dddf57f
msgctxt "hece26b29ga8f9g4652gaa41g3d170bd14f53"
msgid ""
"I fear we must abandon your penance. These goblins have death on their "
"minds. I am leaving - I suggest you do the same."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Battlestation
#. Speaker = Abdirak
#. NodeID = c74ec65e-4d77-59ea-4bb9-65b0aae20a4d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Battlestation:c74ec65e-4d77-59ea-4bb9-65b0aae20a4d
msgctxt "h51ea70b5ga641g4525gb16ega17538f2f927"
msgid ""
"Dear child, the goblins have blood on their minds. I am leaving - I suggest "
"you do the same. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_DuringPenance
#. Speaker = Abdirak
#. NodeID = 0aa4c5b3-2e8b-fc67-6f62-c7882e4fb409
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_PainPriest_State_Penitent(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_DuringPenance:0aa4c5b3-2e8b-fc67-6f62-c7882e4fb409
msgctxt "h2bf8e505geaddg4631g8c81gd1e1645ebb90"
msgid "Come now, dear child. It is time to repent."
msgstr "이리 오거라, 사랑스러운 아이야. 회개의 시간이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_DuringPenance
#. Speaker = Player
#. NodeID = 2441c017-9398-e720-4c50-ea5b0612c31c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_PainPriest_Event_FirstHitDone = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_DuringPenance:2441c017-9398-e720-4c50-ea5b0612c31c
msgctxt "h8b6fbd4cgbcddg488bg95f5gfa2ad835b7d5"
msgid "What do you want me to do?"
msgstr "내가 무엇을 하길 원하지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_DuringPenance
#. Speaker = Abdirak
#. NodeID = 7a0ab6f6-d6c9-41d6-9d7d-26ca4116bdfe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_DuringPenance:7a0ab6f6-d6c9-41d6-9d7d-26ca4116bdfe
msgctxt "hf0524830g65b3g4226gae3age163fb49b915"
msgid "A pity. We would have such <i>fun</i> together."
msgstr "유감이군. 함께 <i>즐거운</i> 시간을 보낼 수 있었을 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_DuringPenance
#. Speaker = Abdirak
#. NodeID = 7e36334f-6e04-db09-2c78-0a15be183bfc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_DuringPenance:7e36334f-6e04-db09-2c78-0a15be183bfc
msgctxt "ha8aa4e22g6720g4ac5g9112g05a6fabc8986"
msgid "Now, now - I'm dealing with your friend. I'll be just a moment."
msgstr "자, 자 - 나는 네 친구를 다루고 있어. 금방 끝날 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_DuringPenance
#. Speaker = Abdirak
#. NodeID = 81341268-9ce1-2ee1-4170-7ff35f6c3c95
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_DuringPenance:81341268-9ce1-2ee1-4170-7ff35f6c3c95
msgctxt "haece99dag4badg4bcdgbaccg963e1885aeb4"
msgid ""
"And there is more to come, but I promise it shall be worth it. Now, face the "
"wall - and stay <i>absolutely </i>still."
msgstr "아직 할 게 남았어, 하지만 이럴 가치가 있을 거라 약속하지. 이제 벽을 보고 서 - 그리고 <i>털 하나</i> 움직이지마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_DuringPenance
#. Speaker = Abdirak
#. NodeID = b2ac3062-e9d7-8ca1-ad19-564c41928701
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_DuringPenance:b2ac3062-e9d7-8ca1-ad19-564c41928701
msgctxt "hb9debac5gf42cg4cd9gb473g96102ecf2a4e"
msgid "Simply face that wall - and stay <i>absolutely </i>still."
msgstr "단순히 그 벽을 보고 <i>완전히</i> 가만 있으면 돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_DuringPenance
#. Speaker = Player
#. NodeID = b545110d-2120-55ca-4d0f-1d7205eaa6fb
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_PainPriest_State_Penitent(1) = False
#.     - GOB_PainPriest_State_CancelledPenitent(1) = True
#.   Global:
#.     - GOB_PainPriest_Event_CancelPenance = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_DuringPenance:b545110d-2120-55ca-4d0f-1d7205eaa6fb
msgctxt "h05fe0535g2fcbg4468g9687g1c5e1a16a443"
msgid "I've changed my mind."
msgstr "생각이 바뀌었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_DuringPenance
#. Speaker = Abdirak
#. NodeID = c5887b98-2ac6-bf8d-a652-85722e79a272
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_PainPriest_State_NeedMoreHP(1) = True
#. SetFlags:
#.   Object:
#.     - GOB_PainPriest_State_NeedMoreHP(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_DuringPenance:c5887b98-2ac6-bf8d-a652-85722e79a272
msgctxt "ha1b41c48g7b7fg49ccgbdc0g5a96c9e007b1"
msgid "I'm afraid someone took your place, dear one."
msgstr "누군가가 너의 자리를 차지한 것 같구나, 얘야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_DuringPenance
#. Speaker = Player
#. NodeID = e71e269f-8f41-3e82-ba3a-dfc9c1055959
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_PainPriest_Event_FirstHitDone = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_DuringPenance:e71e269f-8f41-3e82-ba3a-dfc9c1055959
msgctxt "h2d3a47d8ge9b0g42a9gac26gcb27f71b964f"
msgid "Hurry up and hit me already."
msgstr "어서 날 때려."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_DuringPenance
#. Speaker = Player
#. NodeID = ec60ab71-fa25-09a2-8227-ea1e3dfc2f83
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_DuringPenance:ec60ab71-fa25-09a2-8227-ea1e3dfc2f83
msgctxt "h092c0aa0g6fc1g456agaf2bg156a2f45c9e3"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Player
#. NodeID = 059a9895-aa2a-71e9-13b3-56f90fe2612e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - GOB_PainPriest_Event_MercyTwice = False
#.      - GOB_PainPriest_Event_Mercy = True
#. SetFlags:
#.   Global:
#.     - GOB_PainPriest_Event_MercyTwice = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:059a9895-aa2a-71e9-13b3-56f90fe2612e
msgctxt "ha2b1dea1gc869g4438g8f2ag3f951f14e093"
msgid "<i>Writhe in exaggerated agony and cry out.</i>"
msgstr "<i>과장된 몸짓으로 고통에 몸부림치며 비명지른다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Player
#. NodeID = 070126f1-e3d1-7995-4341-c0273dc6a6e5
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - GOB_PainPriest_Event_Harder = False
#.   Tag:
#.      - BARBARIAN(1) = True
#. SetFlags:
#.   Global:
#.     - GOB_PainPriest_Event_Harder = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:070126f1-e3d1-7995-4341-c0273dc6a6e5
msgctxt "hc461a831g282fg48bagb9c2g46f0469b280c"
msgid "More."
msgstr "더."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Abdirak
#. NodeID = 1481e6a8-85cf-d194-c627-5c780880867b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_PainPriest_Event_SecondHitDone = True
#.      - GOB_PainPriest_Event_BadReaction = False
#.      - GOB_PainPriest_Event_ReactToCry = True
#.      - GOB_PainPriest_Event_ThirdHitDone = False
#. SetFlags:
#.   Global:
#.     - GOB_PainPriest_Event_ThirdHitDone = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:1481e6a8-85cf-d194-c627-5c780880867b
msgctxt "h9ffa78bfgf105g44eag9459gcf4f5495af28"
msgid "You are doing so well - do not give in now!"
msgstr "잘하고 있어, 지금 포기하지 말거라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Astarion
#. NodeID = 16fe893c-e178-dae6-a90f-24ab9d2f588a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_PainPriest_State_AstarionSecondReactionDone(3) = False
#.   Tag:
#.      - REALLY_ASTARION(3) = True
#. SetFlags:
#.   Object:
#.     - GOB_PainPriest_State_AstarionSecondReactionDone(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:16fe893c-e178-dae6-a90f-24ab9d2f588a
msgctxt "h7b7d4b54g0825g4e76g908fg510dd3e8e166"
msgid "It was a fine strike. Excellent form!"
msgstr "좋은 일격이었어. 탁월한 솜씨군!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Player
#. NodeID = 177868fb-fb04-08c3-63d4-ee2abbf626aa
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Constitution
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - GOB_PainPriest_Event_BracedTwice = False
#.      - GOB_PainPriest_Event_Braced = True
#. SetFlags:
#.   Global:
#.     - GOB_PainPriest_Event_BracedTwice = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:177868fb-fb04-08c3-63d4-ee2abbf626aa
msgctxt "h10917302g97e7g46c1g9a99gc06564eb4825"
msgid "<i>Take a deep breath and close your eyes.</i>"
msgstr "<i>크게 숨을 들이마시고 눈을 감는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Player
#. NodeID = 1a31ebee-1829-d27e-345f-35d15251b8ba
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Global:
#.      - GOB_PainPriest_Event_HarderTwice = True
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:1a31ebee-1829-d27e-345f-35d15251b8ba
msgctxt "h555110e2g45f1g4a9bgbd54g911812540e84"
msgid "<b>MORE!</b>"
msgstr "<b>더 해봐!</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Abdirak
#. NodeID = 1a523f21-26dd-8b4b-3d00-8a53ccfc2248
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_PainPriest_Event_ThirdHitDone = False
#. SetFlags:
#.   Global:
#.     - GOB_PainPriest_Event_ThirdHitDone = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:1a523f21-26dd-8b4b-3d00-8a53ccfc2248
msgctxt "h27a9e056g9fa6g4e29gbc10gfea70522de18"
msgid "Almost there, dear one."
msgstr "거의 다 됐다, 아이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Abdirak
#. NodeID = 1c956ed7-c707-ee41-0163-f2614010c02d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_PainPriest_Event_BadReaction = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:1c956ed7-c707-ee41-0163-f2614010c02d
msgctxt "heab847fag329cg4110g8cbagb14ec7e8e164"
msgid "Heh. Do not tease what you will not deliver, dear one."
msgstr "하. 지키지도 못할 약속으로 날 애태우지 말거라, 아이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Abdirak
#. NodeID = 1fc890e6-9c8e-6b03-55bd-ab9440485867
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_PainPriest_Event_ReactToMocking = True
#.     - GOB_PainPriest_Event_BadReaction = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:1fc890e6-9c8e-6b03-55bd-ab9440485867
msgctxt "h0e8c2575g5f18g41beg87d1gcdcba6d06b74"
msgid "Tch. Beg sincerely or don't beg at all!"
msgstr "쯧. 진심을 담아 애원할 게 아니면 아예 하지를 마라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Astarion
#. NodeID = 26122827-16fc-4a2e-9e5b-f0d95207c0b0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:26122827-16fc-4a2e-9e5b-f0d95207c0b0
msgctxt "haeebcfdeg8cf3g4f6cg9363gfc3d833aaca7"
msgid "I mean, I had my hopes."
msgstr "오히려 그런 취향이길 기대했는걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Player
#. NodeID = 28d80e31-7c1d-09ff-b2d5-dfc75c328d7b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_PainPriest_Event_MonkTwice = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:28d80e31-7c1d-09ff-b2d5-dfc75c328d7b
msgctxt "he1bb0580g2680g424eg979eg3dc3e14e5044"
msgid ""
"<i>Let the world recede. You neither hear the priest nor feel the blow.</i>"
msgstr "<i>주위의 소리를 잊는다. 사제의 말도, 고통스런 타격도 느껴지지 않는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Astarion
#. NodeID = 2bca217b-ccdc-4689-a54f-0e9491f46aa9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_PainPriest_State_AstarionFirstReactionDone(3) = False
#.   Tag:
#.      - REALLY_ASTARION(3) = True
#. SetFlags:
#.   Object:
#.     - GOB_PainPriest_State_AstarionFirstReactionDone(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:2bca217b-ccdc-4689-a54f-0e9491f46aa9
msgctxt "h65799062g1a64g4ccfg954agd8fa1824811e"
msgid "Oh, bravo! Encore!"
msgstr "오, 브라보! 더 해줘!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Abdirak
#. NodeID = 2e9a9a80-df46-844d-64a8-7c9ae0c97dfc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:2e9a9a80-df46-844d-64a8-7c9ae0c97dfc
msgctxt "h0ade63c5g9150g4eb6g9b30g9e6b5e8e7bb7"
msgid "Offer your pain to Loviatar - and you shall be rewarded."
msgstr "네 고통을 로비아타 님께 바치거라. 그러면 상을 받을 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Abdirak
#. NodeID = 2eceffa6-4ac5-6c49-a4a9-c1b0bd029e03
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:2eceffa6-4ac5-6c49-a4a9-c1b0bd029e03
msgctxt "hc7ba244cgf71fg407aga08ag2003a6e85894"
msgid "Yes, my child! More for Loviatar! MORE!"
msgstr "좋아, 얘야! 로비아타님을 위해 더! 더!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Player
#. NodeID = 2f4bac22-7789-5bea-573b-1cec0990fbad
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Constitution
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - GOB_PainPriest_Event_BracedTwice = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:2f4bac22-7789-5bea-573b-1cec0990fbad
msgctxt "h11959bfbgeba9g4e29gaa9cga9d9cb23352e"
msgid "<i>Grit your teeth and keep still.</i>"
msgstr "<i>이를 악물고 가만히 버틴다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Abdirak
#. NodeID = 3388b25c-f93f-652c-4f06-ec8a024d1197
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_PainPriest_Event_SecondHitDone = True
#.      - GOB_PainPriest_Event_BadReaction = False
#.      - GOB_PainPriest_Event_ReactToEnthusiasm = True
#.      - GOB_PainPriest_Event_ThirdHitDone = False
#. SetFlags:
#.   Global:
#.     - GOB_PainPriest_Event_ThirdHitDone = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:3388b25c-f93f-652c-4f06-ec8a024d1197
msgctxt "h70b14c05gb6bbg44f6gb398g7b4ebcf5435d"
msgid "That's it! Welcome the pain. Let it become part of you!"
msgstr "그거야! 고통을 환영해라. 그게 너의 일부가 되게 해라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Abdirak
#. NodeID = 34523b14-0100-ac00-706d-63e5d8d72899
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_PainPriest_Event_ReactToCry = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:34523b14-0100-ac00-706d-63e5d8d72899
msgctxt "hb283a584g5818g4a95g9d32g4bc6517eb9fa"
msgid "That's it, dear one! Let Loviatar hear you!"
msgstr "바로 그거다, 얘야! 로비아타 님의 귀에 닿도록!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Abdirak
#. NodeID = 4412c0fa-2ae0-bf75-6a5d-50259be4b5a3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_PainPriest_Event_SecondHitDone = True
#.      - GOB_PainPriest_Event_ReactToSilence = True
#.      - GOB_PainPriest_Event_ThirdHitDone = False
#. SetFlags:
#.   Global:
#.     - GOB_PainPriest_Event_ThirdHitDone = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:4412c0fa-2ae0-bf75-6a5d-50259be4b5a3
msgctxt "hfdc52e95g0575g431cgbd77gf1c8ecc296cc"
msgid "Such resilience!"
msgstr "참으로 견고하구나!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Abdirak
#. NodeID = 44ae01bb-2b3a-ef8b-fbb9-2d7cef30c4fe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_PainPriest_Event_FirstHitDone = False
#. SetFlags:
#.   Global:
#.     - GOB_PainPriest_Knows_PenanceIsPain = True
#.     - GOB_PainPriest_Event_FirstHitDone = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:44ae01bb-2b3a-ef8b-fbb9-2d7cef30c4fe
msgctxt "h3fe5ee5ag8ce3g4d8bg8e0bg24729db6dd31"
msgid "The pain you suffer will cleanse you - do not fight it."
msgstr "네가 겪는 고통이 너를 정화할 것이다. 맞서지 말거라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Player
#. NodeID = 470001cd-ecbb-66ed-fe04-efc41e24f2aa
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Constitution
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - GOB_PainPriest_Event_Braced = False
#. SetFlags:
#.   Global:
#.     - GOB_PainPriest_Event_Braced = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:470001cd-ecbb-66ed-fe04-efc41e24f2aa
msgctxt "h8bfc508agb7b2g44c0g8f9cgdfa16f612b77"
msgid "<i>Try to hold back your cries.</i>"
msgstr "<i>비명을 참으려 애쓴다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Player
#. NodeID = 477903f5-a20f-6f44-e94a-a27e8a70eb8d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Global:
#.      - GOB_PainPriest_Event_HarderTwice = True
#.   Tag:
#.      - BARBARIAN(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:477903f5-a20f-6f44-e94a-a27e8a70eb8d
msgctxt "h8fa1a825gbf92g4bd6g886ag119e8c6908b4"
msgid "Hit me as hard as you can - or I'll return the favour."
msgstr "최선을 다해 쳐라. 안 그럼 대신 내가 똑같이 해줄 테니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Abdirak
#. NodeID = 49996c62-83d5-9cd0-6670-3cc01ca9bae3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_PainPriest_Event_ReactToEnthusiasm = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:49996c62-83d5-9cd0-6670-3cc01ca9bae3
msgctxt "hf0e6c596gf275g4959ga31ag882c8c68f2f7"
msgid "Hah! You want more? As you wish, dear one."
msgstr "하! 더 원하나? 바라는 대로 해줄게, 얘야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Player
#. NodeID = 4a8e9dd1-2ee6-4189-5a6c-1645e780b74b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_PainPriest_Event_EntertainerTwice = False
#.      - GOB_PainPriest_Event_Entertainer = True
#. SetFlags:
#.   Global:
#.     - GOB_PainPriest_Event_EntertainerTwice = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:4a8e9dd1-2ee6-4189-5a6c-1645e780b74b
msgctxt "hfaf4e39bgf262g4a38g9efcgb5ba41a661e9"
msgid "<i>Howl at the PAIN, the AGONY of it all.</i>"
msgstr "<i>고함을 지른다. 이 고통, 이 격통을 향해서!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Abdirak
#. NodeID = 4ef54f88-822b-a9b0-44dd-d336040d4ede
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:4ef54f88-822b-a9b0-44dd-d336040d4ede
msgctxt "h203627a5gf951g44cfgbd81gd31d7549af16"
msgid "Hah! I hope that's a promise, dear one."
msgstr "하! 그 약속 꼭 지키길 바란다, 아이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Player
#. NodeID = 50ed3761-b56d-9df7-d64a-c8738800fb54
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - GOB_PainPriest_Event_Harder = True
#.      - GOB_PainPriest_Event_HarderTwice = False
#.   Tag:
#.      - BARBARIAN(1) = True
#. SetFlags:
#.   Global:
#.     - GOB_PainPriest_Event_HarderTwice = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:50ed3761-b56d-9df7-d64a-c8738800fb54
msgctxt "h4848aedbg01e8g4cf7gafc6g7b64bb684375"
msgid "MORE."
msgstr "더."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Abdirak
#. NodeID = 5133bf8d-27e7-de66-d0a8-33de0569697c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_PainPriest_Event_FullMercy(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:5133bf8d-27e7-de66-d0a8-33de0569697c
msgctxt "h7db16634gd463g4d0fgbd8ag3905584d67fc"
msgid ""
"Yes you can, child. Take the pain and offer it up to Loviatar. Offer it all!"
msgstr "버틸 수 있다, 아이야. 고통을 받아들여 로비아타 님께 바치거라. 전부 다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Abdirak
#. NodeID = 565f23f2-0529-5e15-02a0-00abc3bbe505
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_PainPriest_Event_SecondHitDone = False
#.      - GOB_PainPriest_Event_ReactToEnthusiasm = True
#.      - GOB_PainPriest_Event_FirstHitDone = True
#. SetFlags:
#.   Global:
#.     - GOB_PainPriest_Event_SecondHitDone = True
#.     - GOB_PainPriest_Event_ReactToEnthusiasm = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:565f23f2-0529-5e15-02a0-00abc3bbe505
msgctxt "hc835b0a3g0a89g4e32g98aagd49fbb36e00d"
msgid "Ahaha! Wonderful, just <i>wonderful. </i>"
msgstr "아하하! 놀라워, 그저 <i>놀라워.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Player
#. NodeID = 576e0356-c83c-9307-f40b-39f5d821ea0a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_PainPriest_Event_Monk = False
#.   Tag:
#.      - MONK(1) = True
#. SetFlags:
#.   Global:
#.     - GOB_PainPriest_Event_BadReaction = True
#.     - GOB_PainPriest_Event_ReactToSilence = True
#.     - GOB_PainPriest_Event_Monk = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:576e0356-c83c-9307-f40b-39f5d821ea0a
msgctxt "h3402064dgeefag44a0gbc67gd511c3c49a68"
msgid "<i>Slow your breathing to attain silence, inside and out.</i>"
msgstr "<i>호흡을 늦추고 내면과 외면의 고요를 되찾는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Abdirak
#. NodeID = 61358a62-3ff1-36e1-1324-564757d55c0d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_PainPriest_Event_ReactToMocking = True
#.     - GOB_PainPriest_Event_BadReaction = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:61358a62-3ff1-36e1-1324-564757d55c0d
msgctxt "h463132fagd46fg47degb199gc33036b69642"
msgid ""
"Heh. You are shaking, dear one. And now is not the time for a brave face."
msgstr "하. 떨고 있구나, 얘야. 그리고 지금은 용감한 시늉을 할 때가 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Abdirak
#. NodeID = 63c0f9e0-622a-d7b9-4ca6-1773423a83a9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_PainPriest_Event_ReactToEnthusiasm = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:63c0f9e0-622a-d7b9-4ca6-1773423a83a9
msgctxt "h6ecc665eg782cg40ffg8cdeg8f3dc44cebec"
msgid "Hah! Wonderful. You want more? I'll give it to you."
msgstr "하! 훌륭해. 더 원해? 더 해주마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Abdirak
#. NodeID = 6a1474b3-ab65-92b1-a2a9-e3a1ed35eea7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_PainPriest_Event_ReactToCry = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:6a1474b3-ab65-92b1-a2a9-e3a1ed35eea7
msgctxt "h66908457g28abg4d3dga75bg94eb3dbb4efd"
msgid "I heard you, dear one. Whimper, cry, beg - let it all out!"
msgstr "내게는 들린단다, 얘야. 너의 울부짖음, 울음. 애원. 모두 표출해라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Abdirak
#. NodeID = 6aa8fc11-13fc-8b5c-5c64-f0a7ac1d0cef
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_PainPriest_Event_BadReaction = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:6aa8fc11-13fc-8b5c-5c64-f0a7ac1d0cef
msgctxt "h7e979338gd195g4906gbc4aga1059d92b83b"
msgid "You claim to want more, but I feel you flinching, dear one."
msgstr "말로는 더 원한다 하지만, 움찔거리는 것이 느껴지는구나, 얘야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Abdirak
#. NodeID = 6f51d035-6348-c4ab-9cc8-66377169b696
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:6f51d035-6348-c4ab-9cc8-66377169b696
msgctxt "hb786193fgb349g4cb7ga1cbgf9a785525442"
msgid "You whimper so softly - so sweetly!"
msgstr "참으로 애처롭게 신음하는구나. 달콤하기도 하지!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Player
#. NodeID = 732df99b-dbf0-e165-27ff-fa569ac61ed1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_PainPriest_Event_EntertainerTwice = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:732df99b-dbf0-e165-27ff-fa569ac61ed1
msgctxt "h74033cb3ged3ag4754g991dgaaacc668c99f"
msgid "<i>Sing out in pain and pleasure. You've never felt so ALIVE.</i>"
msgstr "<i>고통과 쾌락의 신음을 노래한다. 이토록 <b>살아있는</b> 감정을 느껴본 적 없다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Shadowheart
#. NodeID = 781c524e-e98f-487a-a2ff-038176403f58
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_PainPriest_State_ShadowheartFirstReactionDone(2) = False
#.   Tag:
#.      - REALLY_SHADOWHEART(2) = True
#. SetFlags:
#.   Object:
#.     - GOB_PainPriest_State_ShadowheartFirstReactionDone(2) = True
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance:781c524e-e98f-487a-a2ff-038176403f58
msgctxt "hd35b7a68g8b8ag4cfbg88feg24201d135c74"
msgid "Don't wear him out entirely, priest. I might have use for him yet."
msgstr "설 힘 정도는 조금 남겨 둬, 사제. 아직 얘가 필요할 수도 있으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_PainPriest_Penance
#. Speaker = Shadowheart
#. NodeID = 781c524e-e98f-487a-a2ff-038176403f58
#. HandlePath = TaggedText[1].TagText[0]
