msgctxt "h0d58429cgc407g4d3cg8a6ag16efd5f1514f"
msgid "Another drow. Just what we needed."
msgstr "또 다른 드로우다. 딱 필요하던 거구만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarLoyalFocused
