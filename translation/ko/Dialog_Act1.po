msgctxt "h2d0fb964g4ea3g4de7gbb22g0a994489d7ce"
msgid "Doesn't matter. We were bored anyway."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_MageHandKid01
#. Speaker = Zel'i
#. NodeID = c98216c9-df2d-1ce5-c14e-8ff8f3914f66
