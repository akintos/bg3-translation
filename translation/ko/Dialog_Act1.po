msgctxt "h63a69798gce5dg4940ga379g4eefbcc88441"
msgid "Stupid kids. Utter waste of time."
msgstr "멍청한 애새끼들. 완전 시간낭비야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain
#. Speaker = Zel'i
#. NodeID = 5f990512-7192-25da-483f-020d810373d1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain:5f990512-7192-25da-483f-020d810373d1
msgctxt "h6444578dg0c31g4bb6g91afg93154c341d58"
msgid "You did."
msgstr "했지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain
#. Speaker = Zel'i
#. NodeID = 61ce6742-262a-ac11-bdd0-f5e4560a2b6d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet_MageHandMain(3) = False
#. SetFlags:
#.   Dialog:
#.     - CRE_General_HasMet_MageHandMain(3) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain:61ce6742-262a-ac11-bdd0-f5e4560a2b6d
msgctxt "h827fb417g836bg411eg918fgadadb08c2a79"
msgid "Not now, <i>k'chakhi</i>! We're <i>busy</i>."
msgstr "지금 말고, <i>크차키</i>! 우린 <i>바빠</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain
#. Speaker = Ra'jak
#. NodeID = 68311a8a-75e1-d484-b5e4-bc0e8502629a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain:68311a8a-75e1-d484-b5e4-bc0e8502629a
msgctxt "h1ac5a32cg872eg48e4g9156g9ba6f99eabd2"
msgid "We'll share our box with you, how about that?"
msgstr "상자를 너랑 공유할게, 어때?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain
#. Speaker = Player
#. NodeID = 69ccb2fb-f76f-b741-7eeb-5938d8e3b83b
#. HandlePath = TaggedText[0].TagText[0]
