msgctxt "ha6cb4c55g6369g4995g8ba1gbace4ef1f729"
msgid "On it."
msgstr "알겠습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_UnfortunateGnome_SlowDown
#. Speaker = Goblin Sharp-Eye
#. NodeID = 39eb0dc1-174c-3ccb-b6b2-ff502f2eac46
