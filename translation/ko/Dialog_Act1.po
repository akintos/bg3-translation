msgctxt "h5261b03bge385g4da6ga9b9g39afc5b2e26a"
msgid "<i>Leave. </i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_ForestIllusion_IllusionRedcap
#. Speaker = Narrator
