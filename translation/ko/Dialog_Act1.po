msgctxt "he055dbd1g899bg4f3cg997cg497270eda22f"
msgid "So yer followin' me? Think yer intimidatin' now?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_Friend2
#. Speaker = Brawler Tiny
#. NodeID = 5f34a721-064f-7173-af9f-b30bb0acde71
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_Friend2:5f34a721-064f-7173-af9f-b30bb0acde71
msgctxt "hb154dd3cgf530g4a57gab7fg9a7f851a0d28"
msgid "I ain't scared. I'll claw yer eyes out if you come any closer."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_Friend2
#. Speaker = Brawler Tiny
#. NodeID = 8d856976-b59d-98e8-feb1-b8ee6277d030
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_DrunkGoblin_Friend2_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_Friend2:8d856976-b59d-98e8-feb1-b8ee6277d030
msgctxt "h2409298eg1fbdg4840gbd7dg6a12200fc04e"
msgid "Why d'ya keep botherin' me? One more step and I'll bite yer nose off."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_Friend2
#. Speaker = Brawler Tiny
#. NodeID = a113b93b-7e09-bff9-39f4-d940d789db21
