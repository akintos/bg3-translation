msgctxt "hb78d03cag9428g45cfg86bcg09dff06a1d5a"
msgid "That was altogether too close."
msgstr "너무 아슬아슬했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance
#. Speaker = Player
#. NodeID = 412905f8-2c4b-48a4-a51d-31e16b9e8421
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#.   Tag:
#.      - REALLY_LAEZEL(0) = False
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance:412905f8-2c4b-48a4-a51d-31e16b9e8421
msgctxt "h47b90581gf8a3g4da7g85e9g33e0559ffc4a"
msgid "That could have ended very poorly."
msgstr "아주 좋지 않은 결말로 끝날 뻔했네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance
#. Speaker = Player
#. NodeID = 412905f8-2c4b-48a4-a51d-31e16b9e8421
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#.   Tag:
#.      - REALLY_LAEZEL(0) = False
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance:412905f8-2c4b-48a4-a51d-31e16b9e8421
msgctxt "h17ec8bc7g9203g420dg8281g4da3f41335e5"
msgid "Phew. That was way too close."
msgstr "휴. 방금은 정말 위험했어.\n"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance
#. Speaker = Player
#. NodeID = 412905f8-2c4b-48a4-a51d-31e16b9e8421
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#.   Tag:
#.      - REALLY_LAEZEL(0) = False
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance:412905f8-2c4b-48a4-a51d-31e16b9e8421
msgctxt "hb64ee524g2002g4060gbabbgcb34b4c5b780"
msgid "That was a little too close for comfort."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance
#. Speaker = Player
#. NodeID = 412905f8-2c4b-48a4-a51d-31e16b9e8421
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#.   Tag:
#.      - REALLY_LAEZEL(0) = False
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance:412905f8-2c4b-48a4-a51d-31e16b9e8421
msgctxt "h72250497gafefg4b24g889fg2fc7059d6896"
msgid "Well - tragedy averted, I suppose."
msgstr "뭐, 비극은 피한 것 같네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance
#. Speaker = Player
#. NodeID = 412905f8-2c4b-48a4-a51d-31e16b9e8421
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#.   Tag:
#.      - REALLY_LAEZEL(0) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance:412905f8-2c4b-48a4-a51d-31e16b9e8421
msgctxt "h6bdc46d9g3582g436cgaecagac2d0320e2ee"
msgid "That could've gone <i>terribly</i>."
msgstr "자칫하면 <i>큰일</i> 날 뻔했어. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance
#. Speaker = Player
#. NodeID = 5fafe8b0-08df-4aca-98fd-272c276d1c46
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#.   Tag:
#.      - REALLY_LAEZEL(0) = True
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance:5fafe8b0-08df-4aca-98fd-272c276d1c46
msgctxt "h136bee9cga734g43e9gbfb2g5f1d785f4bf5"
msgid "We endangered the crèche and its people - and to what end?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance
#. Speaker = Player
#. NodeID = aded2a0b-9cc5-424d-1845-9868d106bc95
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance:aded2a0b-9cc5-424d-1845-9868d106bc95
msgctxt "h5060fcdeg3b2bg43baga9cfg525f1f4151d1"
msgid ""
"Such insouciance. You cannot comprehend the destruction we nearly triggered."
msgstr "이런 무관심이라니. 우리가 거의 일으킬 뻔한 참사를 넌 이해하지 못 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance
#. Speaker = Player
#. NodeID = b2448b29-0960-4d49-ba85-4ca37f27159c
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance:b2448b29-0960-4d49-ba85-4ca37f27159c
msgctxt "ha2ac9062g520dg4e0bg9f02g861b44d10b23"
msgid "We'll be more cautious in future. Probably. Maybe..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance
#. Speaker = Player
#. NodeID = b2448b29-0960-4d49-ba85-4ca37f27159c
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance:b2448b29-0960-4d49-ba85-4ca37f27159c
msgctxt "h4c333714gadb0g4fe5g8464gbf7716e6f4bf"
msgid "A little more care and attention may stand to us in future, I think."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance
#. Speaker = Player
#. NodeID = b2448b29-0960-4d49-ba85-4ca37f27159c
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance:b2448b29-0960-4d49-ba85-4ca37f27159c
msgctxt "h1b4b8b4ag5c08g4f6bga0e0ge0e5b71ce897"
msgid "Maybe we'll take a lighter touch next time. Maybe.\n"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance
#. Speaker = Player
#. NodeID = b2448b29-0960-4d49-ba85-4ca37f27159c
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance:b2448b29-0960-4d49-ba85-4ca37f27159c
msgctxt "h9165e3eag5472g48c7ga284g9115754999e5"
msgid ""
"A little more caution in future won't kill us. Quite the opposite, actually."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance
#. Speaker = Player
#. NodeID = b2448b29-0960-4d49-ba85-4ca37f27159c
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance:b2448b29-0960-4d49-ba85-4ca37f27159c
msgctxt "hbd1d5822gcb04g44fdgaa30g978bf9406e18"
msgid "Let's think twice before getting grabby in the future, yeah?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance
#. Speaker = Player
#. NodeID = b2448b29-0960-4d49-ba85-4ca37f27159c
#. HandlePath = TaggedText[5].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance:b2448b29-0960-4d49-ba85-4ca37f27159c
msgctxt "haca34df7g889bg4109g922bg1833cd7c2e9d"
msgid "Perhaps we should exercise a <i>touch</i> more caution in future."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance
#. Speaker = Player
#. NodeID = e027e933-1ef9-4ebd-853f-59618e71dbff
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance:e027e933-1ef9-4ebd-853f-59618e71dbff
msgctxt "ha7e9d5a9gb92bg486aga506gcb2d3e0c4d29"
msgid "We may have caused all that, but we also stopped it. You're welcome."
msgstr "우리가 벌인 일이긴 하지만, 멈춘 것도 우리야. 감사는 접어두라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance
#. Speaker = Player
#. NodeID = e027e933-1ef9-4ebd-853f-59618e71dbff
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
