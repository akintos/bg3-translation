msgctxt "h090f2e13gee40g450ega71fg7834a725769a"
msgid "<i>Listen quietly.</i>"
msgstr "<i>조용히 들어본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim
#. Speaker = Player
#. NodeID = 88bd43a6-cc03-3b27-157a-f0b50fb38c40
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim:88bd43a6-cc03-3b27-157a-f0b50fb38c40
msgctxt "hf74d89bcge58cg4841gad95g2c029b81a14f"
msgid "I don't hear anything. Come back to shore."
msgstr "아무것도 안 들려. 뭍으로 올라와."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim
#. Speaker = Player
#. NodeID = 8b28f42a-f4f2-c17f-2e4b-d35b1916741d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim:8b28f42a-f4f2-c17f-2e4b-d35b1916741d
msgctxt "h653b705bgb729g4ca8ga9a3g045d92ffec8c"
msgid "<i>Listen quietly.</i>"
msgstr "<i>조용히 들어본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim
#. Speaker = Player
#. NodeID = 8d6f68f9-7132-db7f-2c71-a1154ec6cbb5
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#. TagRule: BERSERKER
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim:8d6f68f9-7132-db7f-2c71-a1154ec6cbb5
msgctxt "h780ba514g12a8g4e88g8595ge76a98b4fa7f"
msgid "<b><i>ROAR. OVER. THE VOICE.</i></b>"
msgstr "<b><i>포효한다. 노랫소리를. 압도한다.</i></b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim
#. Speaker = Player
#. NodeID = 8d6f68f9-7132-db7f-2c71-a1154ec6cbb5
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim:8d6f68f9-7132-db7f-2c71-a1154ec6cbb5
msgctxt "h0b474c74g4b81g4ab5g8487gce1f6a12098d"
msgid "<i>Drown out the harpies with a <b>ROAR.</b></i>"
msgstr "<i>하피들을 방해한다. <b>함성을 내질러서.</b></i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim
#. Speaker = Mirkon
#. NodeID = 93d5825d-4e8e-a3c9-8c6a-b105ea12f54a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_HarpyMeal_Event_LeaderDialogEnter(1) = True
#.     - DEN_HarpyMeal_Event_OverpowerSong(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim:93d5825d-4e8e-a3c9-8c6a-b105ea12f54a
msgctxt "h16808f64gd429g49bcg9ad3ge8d0e9bc4296"
msgid "Auch! My ears! Wait - why am I wet?"
msgstr "아야! 귀 아퍼! 뭐야, 왜 다리가 축축하지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim
#. Speaker = Player
#. NodeID = 9cfdfd24-5e77-c8f4-6c30-4e8f2e279264
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim:9cfdfd24-5e77-c8f4-6c30-4e8f2e279264
msgctxt "h468f6de9gb444g49bfga3b5g47c7e6163ea5"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim
#. Speaker = Player
#. NodeID = a1d3ce50-5203-9063-1c3a-42ef12d9be42
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - SORCERER(1) = True
#. TagRule: SORCERER_DRACONIC
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim:a1d3ce50-5203-9063-1c3a-42ef12d9be42
msgctxt "he3bf0121gb6c9g4719g81e8g137b90615355"
msgid ""
"<i>Foul creatures - mere carrion birds compared to your bloodline. Focus the "
"will of the dragon against their song.</i>"
msgstr "<i>저급한 생물들. 용의 혈통에 비하면 그저 청소부 새일 뿐이다. 드래곤의 의지로 노래에 저항한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim
#. Speaker = Player
#. NodeID = a1d3ce50-5203-9063-1c3a-42ef12d9be42
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: RawAbility
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - SORCERER(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim:a1d3ce50-5203-9063-1c3a-42ef12d9be42
msgctxt "h46126dd5gbd5eg4946gb6e9g3cdbb0231011"
msgid "<i>Focus your will. Improvise a magical shell to dampen the music.</i>"
msgstr "<i>의지를 집중한다. 노랫소리를 막는 마법 결계를 즉흥적으로 만든다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim
#. Speaker = Mirkon
#. NodeID = a35c8fb4-4c44-2cea-c41c-c24d797c412d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim:a35c8fb4-4c44-2cea-c41c-c24d797c412d
msgctxt "hfef46752ga52bg42a3g985fgfced96030d44"
msgid "Don't touch me! You won't stop me! Just a little closer..."
msgstr "건드리지 마세요! 절 막진 못할 거예요! 조금만 더 가까이..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim
#. Speaker = Player
#. NodeID = a864e54c-7afc-fab3-e6a9-8918a4311e0c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim:a864e54c-7afc-fab3-e6a9-8918a4311e0c
msgctxt "ha44182a2g18bcg44eagb7c9gd3f6fd15803e"
msgid "<i>Focus and try to hear what he hears.</i>"
msgstr "<i>집중해서 들어보려고 노력한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim
#. Speaker = Mirkon
#. NodeID = b5e0c75d-1685-cf5d-51f0-61c3535e36c8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_HarpyMeal_Event_VictimWalkToWater = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim:b5e0c75d-1685-cf5d-51f0-61c3535e36c8
msgctxt "hec66d922gaf6bg495fgaac0g7342919a80ea"
msgid "Shh. I can't hear!"
msgstr "쉿. 안 들리잖아요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim
#. Speaker = Narrator
#. NodeID = b8fe0aed-74fe-8691-e338-bbc1444704b5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#. SetFlags:
#.   Object:
#.     - ORI_DarkUrge_Event_HadUrge(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim:b8fe0aed-74fe-8691-e338-bbc1444704b5
msgctxt "hf96629d6g5bfcg4919gabaag55e34121241a"
msgid ""
"*Your favourite drownings all take place in shallow water... Just a slice of "
"the ankle tendons...*"
msgstr "*얕은 물에서 익사시키는 것만큼 당신의 취향인 건 없습니다... 발목 힘줄을 살짝만 그어도...*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim
#. Speaker = Karlach
#. NodeID = c40ae58f-45d6-4eb2-3000-feab6532f86e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim:c40ae58f-45d6-4eb2-3000-feab6532f86e
msgctxt "h5f0b8d83gfef5g4eeeg81e1g0a699adf59b5"
msgid "Ah, come on. That's cold."
msgstr "아, 그러지 말자. 정말 냉정하네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim
#. Speaker = Player
#. NodeID = cf427ffe-e686-246c-13b4-1945760461f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim:cf427ffe-e686-246c-13b4-1945760461f8
msgctxt "h8905d099g07b8g443dg8521g5fd1e6f92743"
msgid "You shouldn't be standing out in the water. It's dangerous."
msgstr "물가에 서 있으면 안 돼. 위험하다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim
#. Speaker = Narrator
#. NodeID = d26ab175-7996-fae7-c506-594428a4b1ee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim:d26ab175-7996-fae7-c506-594428a4b1ee
msgctxt "h833c7ef2g2746g4324g8896g7445e1a1a262"
msgid "*A sweet melody beckons you. It vibrates with magic - a harpy's charm.*"
msgstr "*감미로운 멜로디가 당신을 유혹합니다. 멜로디는 마법으로 진동합니다. 하피의 매혹입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim
#. Speaker = Player
#. NodeID = e45446ae-8a78-2dfd-adfc-36d0b0c6abfa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim:e45446ae-8a78-2dfd-adfc-36d0b0c6abfa
msgctxt "h8e1bf73age6e2g45bag83fbg648d42c9f067"
msgid "<i>Close your eyes and listen to the song.</i>"
msgstr "<i>눈을 감고 노래를 들어본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim
#. Speaker = Mirkon
#. NodeID = e4fa8a2b-abcc-a73e-7394-14550b856dbf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim:e4fa8a2b-abcc-a73e-7394-14550b856dbf
msgctxt "hfd43ba34g7bffg42c0ga123g8443f914f36e"
msgid "Don't you hear it? It's so peaceful."
msgstr "안 들리세요? 정말 평화로워요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim
#. Speaker = Shadowheart
#. NodeID = e5b8b03d-2778-da83-e044-85db369f85ba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim:e5b8b03d-2778-da83-e044-85db369f85ba
msgctxt "h1a771cd2g303fg4c2bgaf63gbae6e21a2aa0"
msgid "Nicely done. I hope you're intending to share."
msgstr "잘했어. 같이 나눠서 잘 쓰자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim
#. Speaker = Narrator
#. NodeID = ec0e1181-ef1e-6c2a-9a51-8e363f7364ca
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_CheckPocketGold = True
#. SetFlags:
#.   Object:
#.     - GEN_TransferNPCPayment(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim:ec0e1181-ef1e-6c2a-9a51-8e363f7364ca
msgctxt "hf96a595bgdfd4g47d7g9cb1gaa28475a4454"
msgid ""
"*You lift the child's gold pouch as he stumbles deeper into the water, "
"oblivious.*"
msgstr "*당신은 아이가 물속으로 비틀거리며 들어가는 사이, 금화 주머니를 낚아챕니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim
#. Speaker = Mirkon
#. NodeID = f2f57219-0363-a5b1-34ff-d57a79665215
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim:f2f57219-0363-a5b1-34ff-d57a79665215
msgctxt "h6330dbd1g3f89g4e08g9e87g4e5622112ae8"
msgid "Shhh! You're ruining it. I just want to - just a little closer..."
msgstr "쉬잇! 분위기 망치지 마요. 노래를 좀 더... 가까이 듣고 싶어요..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim
#. Speaker = Player
#. NodeID = f5c52084-a7bc-1f7c-58d9-57a5d0fed325
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Local:
#.      - 9b644c9c-a50c-b817-81fa-fff6509e9644_StartedBardSong = False
#.   Tag:
#.      - BARD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim:f5c52084-a7bc-1f7c-58d9-57a5d0fed325
msgctxt "hee5ffd56g50e8g440agbcc3gafc4f64d4d8e"
msgid ""
"<i>Sing:</i> <i>'There once was a lady who met with a merrow, and tried to "
"disclose it to her foolish fellow...'</i>"
msgstr "<i>노래한다:</i> <i>'인어를 만난 여인이 있었다네, 그런데 한심한 친구에게 비밀을 말하고 말았다네...'</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim_Wildshape
#. Speaker = Mirkon
#. NodeID = 41e48ea5-6356-4f4e-a295-6db4d545e3d3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_HarpyMeal_Event_VictimWalkToWater = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim_Wildshape:41e48ea5-6356-4f4e-a295-6db4d545e3d3
msgctxt "h3b309cbegab77g4a0eg9685g247dbb3e7f05"
msgid "Yes, everything's gonna be fine... once I get there..."
msgstr "그래, 모든 게 괜찮아질 거야... 저기 다다르기만 하면..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim_Wildshape
#. Speaker = Mirkon
#. NodeID = 5abeccbf-973d-4e8b-ba32-efcdfc11cd17
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim_Wildshape:5abeccbf-973d-4e8b-ba32-efcdfc11cd17
msgctxt "hce378c00gf313g4951gbc34g284e9b491f48"
msgid "Shh! Listen."
msgstr "쉬이잇! 들어봐요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim_Wildshape
#. Speaker = Mirkon
#. NodeID = dbb4564b-b57d-404a-b05d-2237d3c6aa00
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_HarpyMeal_Event_VictimWalkToWater = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim_Wildshape:dbb4564b-b57d-404a-b05d-2237d3c6aa00
msgctxt "hfb3ff475g207fg4cffg8766gcc94d586512c"
msgid "Shh. I can't hear!"
msgstr "쉿. 안 들리잖아요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_InHideout
#. Speaker = Mirkon
#. NodeID = 0961836b-785e-9e09-5758-ca89c386ef19
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_HarpyMeal_InHideout_WasMean = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_InHideout:0961836b-785e-9e09-5758-ca89c386ef19
msgctxt "hb95fabf0g06b7g46d5g9343g6ca9f6f5d3d6"
msgid "Oh. Umm... okay, I'll... keep it."
msgstr "아. 음... 알겠어요, 그만... 할게요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_InHideout
#. Speaker = Mirkon
#. NodeID = 0e30b4c1-cbcb-8efa-60ef-f60a6d18d254
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_HarpyMeal_State_HasStory(0) = True
#. SetFlags:
#.   Global:
#.     - DEN_HarpyMeal_InHideout_AcceptedGift = True
#.   Object:
#.     - DEN_HarpyMeal_Event_TransferStory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_InHideout:0e30b4c1-cbcb-8efa-60ef-f60a6d18d254
msgctxt "h6c33beb8g31fdg4683g9fe3g84dab96a47a7"
msgid "It's about you! I hope you like it."
msgstr "당신에 관한 이야기예요! 마음에 들었으면 좋겠어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_InHideout
#. Speaker = Mirkon
#. NodeID = 1030064a-4825-2b75-3737-2a6682318899
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_InHideout:1030064a-4825-2b75-3737-2a6682318899
msgctxt "h7bf7aaa2g8c1eg4e60g9a62gc2b42925072e"
msgid "Uh... h-hi."
msgstr "어... 아, 안녕하세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_InHideout
#. Speaker = Player
#. NodeID = 246fcc53-a878-a83e-fe2a-9080710c8b23
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_InHideout:246fcc53-a878-a83e-fe2a-9080710c8b23
msgctxt "ha4a66accg389eg460fga2feg6ec200c1b6e0"
msgid "That's not how I usually get paid for killing monsters."
msgstr "보통 괴물을 죽이고 받는 사례는 그런 게 아닌데 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_InHideout
#. Speaker = Mirkon
#. NodeID = 3d3f8099-187c-465b-9d23-1d449cd584b4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_HarpyMeal_State_HasStory(0) = False
#. SetFlags:
#.   Global:
#.     - DEN_HarpyMeal_InHideout_WasMean = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_InHideout:3d3f8099-187c-465b-9d23-1d449cd584b4
msgctxt "h70aa4784g0eb1g4e1fg8868g673b916ab684"
msgid "Ah - ummm, it's gone. I had it just now, I'm - I'm sorry."
msgstr "앗, 음, 없어졌어요. 방금까지만 해도 있었는데, 그... 미안해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_InHideout
#. Speaker = Mirkon
#. NodeID = 3fc7e5e4-b601-03aa-43cc-8173db286904
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_InHideout:3fc7e5e4-b601-03aa-43cc-8173db286904
msgctxt "haa8266acg5feeg4b22g8c8dgb90f9784755a"
msgid "So I wrote you a story!"
msgstr "그래서 당신을 위해 이야기를 썼어요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_InHideout
#. Speaker = Mirkon
#. NodeID = 579c1af9-3439-6264-2b1c-bee231ee7076
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_HideoutAbandoned = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_InHideout:579c1af9-3439-6264-2b1c-bee231ee7076
msgctxt "he5d44af4g41dbg46c8g886egbcd8689cc50d"
msgid "I wish the harpies would've killed you!"
msgstr "하피가 당신을 죽였다면 좋았을 텐데!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_InHideout
#. Speaker = Mirkon
#. NodeID = 6db8a953-94cf-22ac-819f-575fda0fe261
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_HarpyMeal_InHideout_WasMean = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_InHideout:6db8a953-94cf-22ac-819f-575fda0fe261
msgctxt "h97551cfdgefcbg4850ga40fg05adee43e7c6"
msgid "*Sniffle.*"
msgstr "*훌쩍.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_InHideout
#. Speaker = Mirkon
#. NodeID = 76592969-2457-0ef6-d6be-1d78f78d699d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_InHideout:76592969-2457-0ef6-d6be-1d78f78d699d
msgctxt "h33bbed48gbec5g4626ga94dg984d00e88a83"
msgid "I - I don't have any gold. Sorry."
msgstr "도... 돈은 가진 게 없어요. 미안해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_InHideout
#. Speaker = Mirkon
#. NodeID = 79bb884e-ab9e-b3ad-5fb6-05dc8df0cc8b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_HarpyMeal_State_HelpedSaveVictim(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_InHideout:79bb884e-ab9e-b3ad-5fb6-05dc8df0cc8b
msgctxt "h70084367g125dg43aegaffeg9cbd54909e02"
msgid ""
"You came! I have - here! Mol said I should thank you properly. For the "
"harpies."
msgstr "오셨군요! 저... 이거 받아요! 몰이 당신에게 제대로 사례해야 한다고 했어요. 하피로부터 구해주신 일 말이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_InHideout
#. Speaker = Mirkon
#. NodeID = 79f39e45-f888-d54c-4e2f-e8391af3df98
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_HarpyMeal_InHideout_AcceptedGift = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_InHideout:79f39e45-f888-d54c-4e2f-e8391af3df98
msgctxt "h94cea82dgd77cg48b2gb721gc4a8e83906e7"
msgid "I'm gonna be like you some day. Killing all the scary monsters!"
msgstr "언젠가 당신 같은 사람이 될 거예요. 무서운 괴물을 모조리 무찌르고 다니는 사람!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_InHideout
#. Speaker = Player
#. NodeID = ad3a239e-8808-cd8b-a708-c3479e7c037f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_InHideout:ad3a239e-8808-cd8b-a708-c3479e7c037f
msgctxt "hd4a2df46ged19g45e0gaff3g0a9657880837"
msgid "I've heard enough of your chatter. I don't need more."
msgstr "네 재잘거림은 충분히 들었어. 이제 더는 듣고 싶지 않군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_InHideout
#. Speaker = Player
#. NodeID = fee03e5a-1c0a-0560-85b3-420fa098430d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_InHideout:fee03e5a-1c0a-0560-85b3-420fa098430d
msgctxt "hf38b4f98g9585g4a09g9a73g3043284bcc63"
msgid "Aren't you the clever one? That's very kind."
msgstr "재주가 많은 아이구나? 정말 착하네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_VB_FoundHarpyNest
#. Speaker = Player
#. NodeID = 1ab5c8c1-38f1-b972-93f0-f96276e9b237
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_HarpyMeal_Event_HarpyLeaderEntered = False
#.      - DEN_HarpyMeal_Knows_HarpyNestClimb = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_VB_FoundHarpyNest:1ab5c8c1-38f1-b972-93f0-f96276e9b237
msgctxt "h8f787336gff59g431bgb1e1g99cdfa2a2178"
msgid "A giant nest... let's see what we can find."
msgstr "커다란 둥지군... 뭐가 있는지 한번 살펴보자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_VB_FoundHarpyNest
#. Speaker = Player
#. NodeID = 35499658-9b68-360c-1129-75ed283ad328
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_HarpyMeal_Knows_HarpyNestClimb = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_VB_FoundHarpyNest:35499658-9b68-360c-1129-75ed283ad328
msgctxt "hef1a18b2gd6c9g4480g9e76g5b1ac3219a42"
msgid "Must be what that kid was talking about."
msgstr "아까 그 애가 얘기하던 게 이건가 보군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_VB_FoundHarpyNest
#. Speaker = Player
#. NodeID = c0931cfb-a93b-5876-97bd-d00aff7dcb97
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_HarpyMeal_Event_HarpyLeaderEntered = True
#.      - DEN_HarpyMeal_Knows_HarpyNestClimb = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_VB_FoundHarpyNest:c0931cfb-a93b-5876-97bd-d00aff7dcb97
msgctxt "h43c21391g8975g40efg983eg1c644a063054"
msgid "Let's see what those harpies were hoarding."
msgstr "하피 녀석들이 뭘 잔뜩 숨겨 뒀는지 살펴보자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_VB_PlayerWarnings
#. Speaker = Player
#. NodeID = a9ed7e03-d297-738e-c6c7-f227bf627062
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_VB_PlayerWarnings:a9ed7e03-d297-738e-c6c7-f227bf627062
msgctxt "hb19cfc3fgb18bg4e29gb8bdg04011386ef59"
msgid "It's beautiful..."
msgstr "아름다워..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_VB_PlayerWarnings
#. Speaker = Player
#. NodeID = d77998f6-80cd-08bf-54c2-1a16615f9c80
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_VB_PlayerWarnings:d77998f6-80cd-08bf-54c2-1a16615f9c80
msgctxt "h74aec7fbg97ccg44aeg899fgc37f847315cb"
msgid "Is someone... singing?"
msgstr "누가... 노래하고 있는 건가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Hideout_AD_DarkUrgeSeesDeadChild
#. Speaker = GROUP_ORI_DU
#. NodeID = 4bc823fa-b923-49e2-abdf-ba3fe4bb9452
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Hideout_AD_DarkUrgeSeesDeadChild:4bc823fa-b923-49e2-abdf-ba3fe4bb9452
msgctxt "hc1076622ge231g4576g96e3g05122dbce8d5"
msgid "Is this the first time I've caused a child's death?"
msgstr "내가 어린아이를 죽게 만든 게 이번이 처음이 맞나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Guex
#. NodeID = 0020ce51-2456-cd50-08c7-b8da84275661
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:0020ce51-2456-cd50-08c7-b8da84275661
msgctxt "h42fba4ceg8e54g4526g9007g79898eb44885"
msgid "Ha! Not so spineless now, am I?"
msgstr "하! 이제는 기개가 제법 잘 보이지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Guex
#. NodeID = 01634b3c-813d-6245-f0a3-772cefa7aabc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_IrritatedTiefling_HasMet1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:01634b3c-813d-6245-f0a3-772cefa7aabc
msgctxt "h15a4ff4fg7e80g443egbb14gf1b20f82f4ea"
msgid "Swing, parry, strike - nngh. Damn, damn, damn!"
msgstr "베고, 쳐내고, 공격... 아오! 망할, 망할, 망할!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Guex
#. NodeID = 04cdbf8d-9a9b-c8f1-46b4-aeceb78c124c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_IrritatedTiefling_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_IrritatedTiefling_HasMet(1) = True
#. TagRule: GITHYANKI or HALFORC
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:04cdbf8d-9a9b-c8f1-46b4-aeceb78c124c
msgctxt "h12ed0725g95a0g46acgac54ga8c2e77280a5"
msgid "Step, parry, strike - damn it! It's just not... agh!"
msgstr "딛고, 쳐내고, 공격... 젠장! 자꾸만... 으악!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Guex
#. NodeID = 070556ca-e18d-eb52-4ff6-55b885b7ab32
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_IrritatedTiefling_State_Improved = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:070556ca-e18d-eb52-4ff6-55b885b7ab32
msgctxt "h1cc0b06eg667fg407cgbd97gc105da5bf80a"
msgid "Like <i>this, </i>you mean? Step-step, strike! <i>Yes!</i>"
msgstr "<i>이렇게</i> 하라는 거지? 딛고, 또 딛고, 공격! <i>됐다!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Player
#. NodeID = 073adeb6-d867-6569-0cda-05096b4d2d0b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:073adeb6-d867-6569-0cda-05096b4d2d0b
msgctxt "hd5d8d093gcb17g4bfcgacf1ga0ea5214fc12"
msgid ""
"You're spineless. You should practice grovelling on your knees, not "
"swordplay."
msgstr "기개가 없는 녀석이군. 검 놀이보단 무릎 꿇고 목숨 구걸 연습이나 하는 게 낫겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Player
#. NodeID = 0d672410-2616-d004-5fdf-d72b548fe1a0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - FIGHTER(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:0d672410-2616-d004-5fdf-d72b548fe1a0
msgctxt "h0b71f6baga8b2g4b8fg8cb6gb27d3ce618de"
msgid "Try hitting the target."
msgstr "표적을 좀 제대로 맞춰 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Guex
#. NodeID = 0f8ecd52-66a8-6afe-60c8-79c0bd0ab508
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:0f8ecd52-66a8-6afe-60c8-79c0bd0ab508
msgctxt "h45e86aceg802bg41e5gbf6fg6878433fa4eb"
msgid "A question? I suppose it's worth a try..."
msgstr "질문이라? 시도해 봐서 나쁠 건 없겠지..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Player
#. NodeID = 18e81fa4-2fe4-cb33-e5b2-f1904be7a8d0
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 7
#. CheckFlags:
#.   Tag:
#.      - REALLY_HALFORC(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:18e81fa4-2fe4-cb33-e5b2-f1904be7a8d0
msgctxt "h6e2b02f5g4ac7g4f8ega448gd621847a5aa1"
msgid ""
"<i>Show him how to coil his shoulder muscles into a more intimidating stance "
"before striking.</i>"
msgstr "<i>공격하기 전, 어깨 근육을 휘감듯이 웅크려 좀 더 기선 제압적인 자세를 취하는 방법을 보여준다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Player
#. NodeID = 1a3e2160-41d4-b6b0-4002-d03ff0a1312b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:1a3e2160-41d4-b6b0-4002-d03ff0a1312b
msgctxt "he8fa64fdg5dceg4297gb731gec900aa0c6a3"
msgid "Resume your flailing then, before I give you real cause to yelp."
msgstr "그럼 계속 깨방정이나 떨라고. 진짜 까무러치게 만들어 주기 전에 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Guex
#. NodeID = 1ed064db-4c78-8ba8-5dae-b71d6e1e5fdb
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_IrritatedTiefling_State_NoImprovement = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:1ed064db-4c78-8ba8-5dae-b71d6e1e5fdb
msgctxt "h1923c96dg9b3ag4bc8gaf71g7584c073d0d1"
msgid "Like this? All right... step-step, strike - UGH!"
msgstr "이렇게? 좋아... 딛고, 딛고, 공격! <b>아오</b>!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Guex
#. NodeID = 2048f26e-34de-686d-6aaf-513b888e2cc1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - HIDDEN_WLD_Boosters.DEN_IrritatedTiefling_Trained(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:2048f26e-34de-686d-6aaf-513b888e2cc1
msgctxt "h91014128g25b6g45fdgbdd2g335d828dc05d"
msgid "Good advice - If I had two copper, I'd owe you one."
msgstr "잘 배웠어. 내게 동전 두어 개 있었다면, 하나 턱 줬을 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Guex
#. NodeID = 24716e8b-d0db-796b-c705-5da4f1cd0e0c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:24716e8b-d0db-796b-c705-5da4f1cd0e0c
msgctxt "h27a934e3ged88g4457gb103g54cd47ada73e"
msgid ""
"Sorry, sorry. I've just never seen... your face is... well. I should get "
"back to it."
msgstr "미안, 미안. 그쪽 같은 사람은 처음이라... 얼굴이 참... 어, 하던 거나 마저 해야겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Guex
#. NodeID = 2788a717-ef82-82bc-9466-be000b209cf8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:2788a717-ef82-82bc-9466-be000b209cf8
msgctxt "h1b0a3355g937ag473dgbd4fg2f59e94efa4c"
msgid "<i>Spineless? </i>Well I'll show you!"
msgstr "<i>기개가 없다고?</i> 어디 한 번 보시지!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Guex
#. NodeID = 3890019b-e9ff-bc63-02fd-00a589fc1242
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_IrritatedTiefling_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:3890019b-e9ff-bc63-02fd-00a589fc1242
msgctxt "hb6d385c8g5505g450agbae0g6a64972781e4"
msgid "Step, parry, strike - ugh. Again, again."
msgstr "딛고, 쳐내고, 공격... 어휴. 다시. 다시 하자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Player
#. NodeID = 38a957c8-948b-0964-33d8-0124a9ba944a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - FIGHTER(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:38a957c8-948b-0964-33d8-0124a9ba944a
msgctxt "h60945b89g906fg49b5g83b7g0b5ac11fb3bb"
msgid "I could show you a thing or two, if you're a willing pupil."
msgstr "배울 마음이 있다면, 내가 몇 가지 가르쳐 줄 수도 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Guex
#. NodeID = 39b5e7d5-7bbf-1279-db9a-ed93ca476201
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_IrritatedTiefling_State_Improved = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:39b5e7d5-7bbf-1279-db9a-ed93ca476201
msgctxt "h2c89097fg80e2g4c27ga7e5gd2694966eb0d"
msgid "RrrrrarghWAGGH! Brace and step, swivel, swing! <i>Yes!</i>"
msgstr "그으으으아아아! 버티고, 딛고, 돌고, 베기! <i>됐다!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Guex
#. NodeID = 39bbd8d9-6a10-c68c-388f-5160f5241645
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:39bbd8d9-6a10-c68c-388f-5160f5241645
msgctxt "hbd2bbcc0ga756g41bcg8fdbgb7ab1d24f616"
msgid "Out of my head!"
msgstr "내 머릿속에서 나가!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Guex
#. NodeID = 39d3886e-1963-72f1-f8bc-9748dfd72e62
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:39d3886e-1963-72f1-f8bc-9748dfd72e62
msgctxt "h0b11091fge1a8g4119gb4fegd877dd6e1c7a"
msgid "You're right. I need to clear my head."
msgstr "맞는 말이네. 머릿속을 비워야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Guex
#. NodeID = 4d4487ff-f571-9a03-175b-f9ccebf3d609
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: BARBARIAN
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:4d4487ff-f571-9a03-175b-f9ccebf3d609
msgctxt "hf34f7632g6759g4d74gb257gf74da581a8c1"
msgid ""
"Don't let the druids hear you say that - they're itching for an excuse to "
"get rid of us."
msgstr "드루이드들 듣는 데선 그런 말 하지 마. 우릴 치워버릴 빌미 잡으려고 안달이거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Guex
#. NodeID = 4d4487ff-f571-9a03-175b-f9ccebf3d609
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:4d4487ff-f571-9a03-175b-f9ccebf3d609
msgctxt "h592213eegd9dfg4b6fgb8e4g2ad2298dd21a"
msgid ""
"I'll suffer embarrassment so long as I survive. I just hope the druids don't "
"make that harder than it is already."
msgstr "살아남을 수만 있다면 창피는 얼마든지 감수할 수 있어. 드루이드들까지 그러기 더 힘들게 만들지 않길 바랄 뿐이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Guex
#. NodeID = 4d4487ff-f571-9a03-175b-f9ccebf3d609
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:4d4487ff-f571-9a03-175b-f9ccebf3d609
msgctxt "h68a7cc19gcf30g4f9fg8fceg8b22e7bcca60"
msgid ""
"Hopefully it's just the goblins we have to worry about - the druids are "
"treating us like vermin."
msgstr "걱정헤야 할 거리가 고블린 뿐이길 바랄 따름이지. 드루이드들이 우릴 해충 취급하는 판이거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Guex
#. NodeID = 4e43514c-7316-b87e-9ebf-2ba1d35ab1c9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 411dc1bf-99f6-6c72-3ef4-c667ca195948_DetectThoughtsPassed = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:4e43514c-7316-b87e-9ebf-2ba1d35ab1c9
msgctxt "h8c343b38g3396g4693g86f5g7dbefcf7259c"
msgid ""
"<i>He was only a boy. And I just... just froze while the worg tore his head "
"clean off. Never again.</i>"
msgstr "<i>아직 어린 아이였는데. 근데 난 그저... 워그가 걔 머리통을 뜯어내는 걸 지켜만 봤지. 다시 그래선 안 돼.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Guex
#. NodeID = 554377df-b30f-f2ce-df4c-07f4d3e1b99b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_IrritatedTiefling_State_NoImprovement = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:554377df-b30f-f2ce-df4c-07f4d3e1b99b
msgctxt "h389855d4g07deg48b0ga422g849499d1060c"
msgid "Swing, parry, strike - nngh. Damn, damn, damn!"
msgstr "베고, 쳐내고, 공격... 아오! 망할, 망할, 망할!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Player
#. NodeID = 5add8e5d-4fd8-cf2b-df65-cc42e20002f4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - FIGHTER(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:5add8e5d-4fd8-cf2b-df65-cc42e20002f4
msgctxt "hcfa2d530gff11g496bg80e7g706a460e3ab0"
msgid "Put one foot in front of the other. Let momentum aid your strikes."
msgstr "한쪽 발을 다른 발 앞에 딛도록 해. 공격에 탄력을 싣는 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Player
#. NodeID = 5bf7e33b-7a2c-1d53-a9f2-a5aadcfac1dd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - MONK(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:5bf7e33b-7a2c-1d53-a9f2-a5aadcfac1dd
msgctxt "he5b68ea3ge542g45d3ga4bfg2c5e9aa53d04"
msgid ""
"You need discipline, focus. Fix your gaze to a point, then guide your "
"strikes to it."
msgstr "그쪽한테 필요한 건 절제와 집중이야. 시선을 한 군데에 딱 집중하고 거기로 공격을 날려."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Player
#. NodeID = 5e3c60d0-fb31-9433-6c27-d77a8fb92172
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = True
#. SetFlags:
#.   Local:
#.     - 411dc1bf-99f6-6c72-3ef4-c667ca195948_Gith_WarCry_Advice = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:5e3c60d0-fb31-9433-6c27-d77a8fb92172
msgctxt "hb892bd2agf5c5g4466g9cf7g20fe1b15a02f"
msgid ""
"Inspire fear with a war cry - loosen bowels before you spill them - <i>hrath "
"ajak!</i>"
msgstr "전투 함성으로 공포를 일으켜라. 적의 내장을 쏟아내기 전에 내용물을 지리게 해버려. <i>흐라쓰 아자크!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Guex
#. NodeID = 645c6e89-05b2-56d6-d8cd-f0091db8026c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:645c6e89-05b2-56d6-d8cd-f0091db8026c
msgctxt "h2e82cdb7g5d12g4ebagac0ege6e990fe5f43"
msgid "You have a better way? 'Cause I'm all ears."
msgstr "더 좋은 방법 있어? 어디 들어보자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Player
#. NodeID = 657cf8ec-f61c-ba07-8639-6e59cf3da1ab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:657cf8ec-f61c-ba07-8639-6e59cf3da1ab
msgctxt "he1f810e1g8b4ag44ddgbb7dg78c67f9701d0"
msgid ""
"One last thing - don't shout out your moves like that. Spoils the surprise "
"for your foe."
msgstr "마지막으로 한 가지. 네 동작을 일일이 말로 내뱉지 마. 적이 미리 알아차리고 대비할 테니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Guex
#. NodeID = 7012937a-dca6-9e0a-2d3d-b48c6fa27be2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:7012937a-dca6-9e0a-2d3d-b48c6fa27be2
msgctxt "hc5fc591ag56d0g407bg95c6g86c2e32bfc07"
msgid "I think you made it worse. Keep the advice to yourself next time."
msgstr "괜히 더 이상해진 것 같잖아. 다음 번부턴 남한테 훈수질 접어둬."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Guex
#. NodeID = 73ca9230-fd80-b9eb-2093-a0394ac2a738
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_IrritatedTiefling_HasMet(1) = False
#.   Tag:
#.      - HALFORC(1) = False
#.      - GITHYANKI(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_IrritatedTiefling_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:73ca9230-fd80-b9eb-2093-a0394ac2a738
msgctxt "hf72b9a2eg5eaeg4ddeg9e1fg23c12d4e4145"
msgid "Step, parry, strike - damn it! It's just not landing."
msgstr "딛고, 쳐내고, 공격... 젠장! 자꾸 엇박자 나네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Player
#. NodeID = 78c49809-7d8a-a0b9-6937-f28ea2638953
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - HALFORC(1) = True
#.      - REALLY_HALFORC(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:78c49809-7d8a-a0b9-6937-f28ea2638953
msgctxt "h97dbd60agf380g403fgadb2g869b0d8fd22d"
msgid "Relax - I'm not really a half-orc."
msgstr "진정해. 난 진짜 하프 오크가 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Player
#. NodeID = 796b4c75-8854-96e2-6df0-6ccbf7dcfcce
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 411dc1bf-99f6-6c72-3ef4-c667ca195948_DetectThoughtsPassed = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:796b4c75-8854-96e2-6df0-6ccbf7dcfcce
msgctxt "h3be5c6a0g37bbg416bgb06bgba648346ffaa"
msgid ""
"Clear your mind. Past mistakes don't matter. Focus on the present, the "
"target."
msgstr "마음을 비워. 지난 실수는 신경 쓰지 마. 현재에, 표적에 집중하는 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Player
#. NodeID = 79e7d6bd-a3dc-4264-0930-e504cc43acad
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_HALFORC(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:79e7d6bd-a3dc-4264-0930-e504cc43acad
msgctxt "h3f4b50bfg1a45g400fg9fd3gd2fc2c0105a5"
msgid "You yelp like a frightened dog because of my <i>face?</i>"
msgstr "너 지금 내 <i>얼굴</i> 보고 잔뜩 쫀 개처럼 깨갱거린 거냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Guex
#. NodeID = 7b5e09d7-a07b-df5a-6294-015f09650652
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 411dc1bf-99f6-6c72-3ef4-c667ca195948_Gith_WarCry_Advice = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:7b5e09d7-a07b-df5a-6294-015f09650652
msgctxt "h4e4d75bfg30d0g4aaag8a2agcf5efdb3eb62"
msgid ""
"Oh... yes. When the time comes, it'll be nothing but battle cries from me."
msgstr "아... 그렇지. 나중에 실전에 나서면 전투의 함성만 채우도록 할게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Guex
#. NodeID = 7e5b87e2-66d5-e0e2-28d6-68b94f5b201d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_IrritatedTiefling_State_NoImprovement = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:7e5b87e2-66d5-e0e2-28d6-68b94f5b201d
msgctxt "hdbdc41d3g3e4fg4d74gb395gc2006b5e4061"
msgid "What do you think I'm doing? Brace, parry, swing - UGH!"
msgstr "내가 뭘 하는 걸로 보이는데? 버티고, 쳐내고, 베기... <b>아오!</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Player
#. NodeID = 7e9a0130-8ec8-cc62-85ba-d489d5fa9a31
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:7e9a0130-8ec8-cc62-85ba-d489d5fa9a31
msgctxt "hb2c67e58gbd8fg4e21g8d1bg7bbfca051276"
msgid "Interesting technique. Having some trouble?"
msgstr "거 참 흥미로운 기술인걸. 뭔 문제라도 있어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Guex
#. NodeID = 81246e76-c25f-77d0-fc44-d61419a05c0b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:81246e76-c25f-77d0-fc44-d61419a05c0b
msgctxt "h829f6fc0g6bc9g4472g97b9g5612c1b03ec6"
msgid "We need to be ready for a fight - but I'm <i>useless </i>with a sword."
msgstr "우린 싸움에 대비해야 해. 근데 난 칼 솜씨가 <i>젬병</i>이라서 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Guex
#. NodeID = 8550da52-22e7-1536-04a1-ad7a1b585c64
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_IrritatedTiefling_State_Improved = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:8550da52-22e7-1536-04a1-ad7a1b585c64
msgctxt "h8fc0400fg3458g4c83gb45dg212d324b94f1"
msgid "Step, parry, step-and-<i>swing!</i> Yes!"
msgstr "딛고, 쳐내고, 딛고, <i>베기!</i> 좋아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Player
#. NodeID = 86663525-a65b-020d-a58d-9c7465c9e997
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:86663525-a65b-020d-a58d-9c7465c9e997
msgctxt "h1ea2c5d9ga0f4g45c0g9f66g9d341b8ab774"
msgid "You'd better surrender - that target's a far better fighter."
msgstr "포기하는 게 좋을 거 같은데. 허수아비가 그쪽보단 훨씬 잘 싸우겠거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Guex
#. NodeID = 88755960-a554-5706-ed70-64736ddfb04a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:88755960-a554-5706-ed70-64736ddfb04a
msgctxt "hec4bdb4cgcfd0g4053g805dgd72edf269f62"
msgid ""
"N-no offence meant. I was just surprised - concentrating on this blasted "
"target."
msgstr "나, 나쁜 뜻은 없었어. 갑자기 놀라서 그만... 이 망할 표적에 집중하다가 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Player
#. NodeID = 8a8d7021-03c9-2d6e-a6b7-0c5be7537767
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#.      - REALLY_GITHYANKI(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:8a8d7021-03c9-2d6e-a6b7-0c5be7537767
msgctxt "h40d64601g9d37g499bgbd9cg276d9a49c1d0"
msgid "Calm down - I'm not really githyanki."
msgstr "진정해. 난 진짜 기스양키가 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Player
#. NodeID = 969ce626-cc63-2a69-174d-858b1a9d9d9b
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 0
#. CheckFlags:
#.   Local:
#.      - 411dc1bf-99f6-6c72-3ef4-c667ca195948_DetectThoughtsTried = False
#.   Script:
#.      - GEN_CanDetectThoughts_2 = True
#. SetFlags:
#.   Local:
#.     - 411dc1bf-99f6-6c72-3ef4-c667ca195948_DetectThoughtsTried = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:969ce626-cc63-2a69-174d-858b1a9d9d9b
msgctxt "h1d01f81dg2e1fg43b5g9b37gdda16aa3462b"
msgid "<i>Read his thoughts.</i>"
msgstr "<i>그의 생각을 읽는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Guex
#. NodeID = 972b050a-9dda-9c9b-7ea1-3e80fc81ce16
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:972b050a-9dda-9c9b-7ea1-3e80fc81ce16
msgctxt "h43f6d9dbg80aag499bg8a6fgb93ea118897e"
msgid ""
"Nothing <i>but</i>. Goblins in the wilds, out for blood. And the druids in "
"here, looking to kick us out - or worse."
msgstr ""
"죄다 <i>문제지. </i>저 밖에선 고블린이 피 보려고 벼르고 있고, 여기 드루이드들은 우릴 내쫓으려 수작 중이니. 더 나쁜 걸 수 "
"있고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Guex
#. NodeID = 97e88fa1-457e-b382-b74b-92a8f922b31f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_IrritatedTiefling_State_Improved = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:97e88fa1-457e-b382-b74b-92a8f922b31f
msgctxt "he265b152ga822g47f3g8459g8a67b64e3ad9"
msgid "Har... <i>hrath ajak!</i> And swing! Yes!"
msgstr "하...<i>흐라쓰 아자크!</i> 그리고 베기! 됐다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Guex
#. NodeID = 9a58e4ee-9114-a02e-c7a8-0e48c065043b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:9a58e4ee-9114-a02e-c7a8-0e48c065043b
msgctxt "h8e13e0e5g7da1g4afdg8e9ag2d869f9e7fa5"
msgid "Well, I'm in no position to turn down help."
msgstr "뭐, 내가 도움을 마다할 처지는 아니지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Guex
#. NodeID = 9b6857aa-164a-eecc-b541-2edb71e34567
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_IrritatedTiefling_State_Improved = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:9b6857aa-164a-eecc-b541-2edb71e34567
msgctxt "h40f9b090gedd0g400aga14bg069252d57e9c"
msgid ""
"Step-step - hello maggot face, how's your mother? - <i>strike! </i>It "
"worked! Well I'll be."
msgstr "딛고, 또 딛고 - 안녕, 구더기 면상아. 니 애미는 잘 계시냐? - <i>공격! </i>성공이다! 이런 세상에."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Guex
#. NodeID = 9b960618-99c0-275a-721f-a63d7dfaa3cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:9b960618-99c0-275a-721f-a63d7dfaa3cf
msgctxt "h4ef739e1ge4b3g48c2g8a36gc4b339097650"
msgid "I'll have to keep practising."
msgstr "하던 연습이나 계속해야겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Guex
#. NodeID = a6de77dd-b142-3671-70cf-31ed6dfe15a5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_IrritatedTiefling_State_Improved = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:a6de77dd-b142-3671-70cf-31ed6dfe15a5
msgctxt "h01601198gc12cg497fgb420gb98a2e2cb2d1"
msgid "And... step, parry, step-step, swing. <i>Yes.</i>"
msgstr "그럼... 딛고, 쳐내고, 딛고 또 딛고, 베기. <i>됐다!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Player
#. NodeID = acbddf17-030d-44ed-e269-5d5cccaa0906
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Strength
#. DifficultyClass: 12
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:acbddf17-030d-44ed-e269-5d5cccaa0906
msgctxt "h4a6020a8gce84g4190g9e36g54646ebb69f5"
msgid ""
"<i>Demonstrate a swing - show him the fluidity of movement he lacks.</i>"
msgstr "<i>베기 동작을 시연해 그에게 부족한 유연성을 보여준다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Guex
#. NodeID = b3a979d3-9e8e-09b7-3352-b0e339a55e06
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:b3a979d3-9e8e-09b7-3352-b0e339a55e06
msgctxt "h0f0ccfd2g57efg4926gbf48g8143cd07c8bc"
msgid "Oh... yes. I'll bite my tongue when the time comes."
msgstr "아... 그렇지. 나중에 실전에 나가게 되면 입은 꾹 다물게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Guex
#. NodeID = b5593f5e-d859-9a17-e182-4d1313e5530b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:b5593f5e-d859-9a17-e182-4d1313e5530b
msgctxt "h083c4c15g268fg4ea5ga6c5gbf622103f49c"
msgid "Still not landing."
msgstr "여전히 잘 안 돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Guex
#. NodeID = b9375e35-33ae-24d7-35ff-69574ebd34f7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:b9375e35-33ae-24d7-35ff-69574ebd34f7
msgctxt "hc57791ebg4c8bg461ag9f8cg40bf65a6ae4b"
msgid ""
"You're not...? For the best, I suppose. I wouldn't have fared well against "
"the real thing."
msgstr "아니라고...? 그렇다면 다행이다 싶네. 진짜였다면 안 좋은 꼴을 당하고 말았을 테니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Player
#. NodeID = baafbb97-fae0-6771-4479-d85222b6b1ef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:baafbb97-fae0-6771-4479-d85222b6b1ef
msgctxt "h43320783gdfccg4b65g877dg5071f6f46db9"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Guex
#. NodeID = bcc867ea-2493-b99f-61c1-7d3f767c5fa1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_IrritatedTiefling_State_Improved = True
#.     - DEN_IrritatedTiefling_State_RogueImprovement = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:bcc867ea-2493-b99f-61c1-7d3f767c5fa1
msgctxt "h61de2223g2429g40d8g80a9g347a725441e6"
msgid "Let's see then. Feint, kick, and - thrust!"
msgstr "한번 해 볼게. 속이고, 차고, 찌르기!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Guex
#. NodeID = bfeaa36f-8757-3613-d04a-fa13fe563a7c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_IrritatedTiefling_State_HasReward(0) = True
#. SetFlags:
#.   Object:
#.     - DEN_IrritatedTiefling_Event_GiveReward(1) = True
#.   Quest:
#.     - HIDDEN_WLD_Boosters.DEN_IrritatedTiefling_Trained(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:bfeaa36f-8757-3613-d04a-fa13fe563a7c
msgctxt "he7d72ea1gea94g4153gb7a2gea5de0d32d07"
msgid ""
"You really know what you're doing! Found this by the road - bet you'll put "
"it to good use."
msgstr "정말 족집게 선생이 따로없는걸! 이거 길에서 주운 건데, 분명 그쪽한테 요긴할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Guex
#. NodeID = c1883e4e-3435-aaa4-8f48-5584376b7d81
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_IrritatedTiefling_State_Improved = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:c1883e4e-3435-aaa4-8f48-5584376b7d81
msgctxt "h08f0d65ag7decg4783g9658g075f08f40c23"
msgid "Brace and step, swivel, swing! <i>Yes!</i>"
msgstr "버티고, 딛고, 돌고, 베기! ! <i>됐다!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Player
#. NodeID = c18a3076-848c-f2ce-cb24-241cf8ee9848
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:c18a3076-848c-f2ce-cb24-241cf8ee9848
msgctxt "h2a8a1ac0g4e98g4463g8456g1a623ac4e4ea"
msgid "Then you're not angry enough, whelp! Again!"
msgstr "그럼 덜 빡쳐서 그런 거지, 좆만아! 다시!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Player
#. NodeID = c1d8a0e7-7519-d6ce-caf4-2fb9869a133a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:c1d8a0e7-7519-d6ce-caf4-2fb9869a133a
msgctxt "h31361c78g0026g40a3g8503g11f221f765ab"
msgid "Don't waste good anger on your thoughts - use it on that target!"
msgstr "좋은 분노를 속으로만 삭이지 마. 표적에다 쏟아부어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Player
#. NodeID = c4a7f7d4-e3f6-9521-76ab-d414cbce792e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_IrritatedTiefling_HasMet1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:c4a7f7d4-e3f6-9521-76ab-d414cbce792e
msgctxt "h37f3b9c3g1a96g4a56g8cc1gffd1607bea76"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Player
#. NodeID = c4eb2a10-0d6d-f98f-06f0-5193def248a4
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: BARBARIAN
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:c4eb2a10-0d6d-f98f-06f0-5193def248a4
msgctxt "h6b5ed34ag458ag4a99g8ad4g1faa791bfe03"
msgid ""
"Keep training. When the time comes, you'll drown this place in goblin blood."
msgstr "꾸준히 훈련해. 때가 오면, 이곳을 고블린 피로 푹 적셔버릴 수 있을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Player
#. NodeID = c4eb2a10-0d6d-f98f-06f0-5193def248a4
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:c4eb2a10-0d6d-f98f-06f0-5193def248a4
msgctxt "h6d9ed5fdg0a89g4fceg8417gc471ee5071fb"
msgid ""
"One strike means nothing. Keep training, and you may not embarrass yourself "
"in battle."
msgstr "겨우 한 번 성공했다고 들뜰 것 없어. 꾸준히 훈련해. 그럼 전투 때 창피 당할 일은 아마 없을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Player
#. NodeID = c4eb2a10-0d6d-f98f-06f0-5193def248a4
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:c4eb2a10-0d6d-f98f-06f0-5193def248a4
msgctxt "h84a45537g081fg4c8eg8c87g2a95bff7e49d"
msgid "Keep training. In time, you'll make short work of any goblins."
msgstr "꾸준히 훈련해. 조만간 고블린쯤은 단숨에 해치울 수 있을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Guex
#. NodeID = c9ee57dc-83ca-912f-c62b-9c676ae4d220
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_IrritatedTiefling_State_Improved = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:c9ee57dc-83ca-912f-c62b-9c676ae4d220
msgctxt "hf12e4797gf8a9g49edg9830g1dfa09934c3d"
msgid ""
"I'll try and brace them better - like <i>so. </i>Step-brace, parry, swing! "
"<i>Yes!</i>"
msgstr "그럼 한 번 자세 잡고 잘 유지해 볼게. <i>그러니까...</i> 딛고, 버티고, 쳐내고, 베기! <i>됐다!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Player
#. NodeID = cfc473c2-a723-045b-a98a-11d3355c9ba5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#.      - REALLY_GITHYANKI(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:cfc473c2-a723-045b-a98a-11d3355c9ba5
msgctxt "h1a7da89fg0fffg4e69g8f42gb8a62c11f9bf"
msgid ""
"Try confusing your foe, like when you first saw me. Shout a question at them."
msgstr "내 얼굴 처음 봤을 때 그랬듯이 적에게 혼란을 줘 봐. 난데없는 질문을 내질러 보라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Guex
#. NodeID = dc88eb3d-341c-c3ce-c796-e847f43664ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:dc88eb3d-341c-c3ce-c796-e847f43664ae
msgctxt "h9b2573ccgddc1g40ddg8f8eg7bfeca8f7bbe"
msgid "But I'll keep at it. Thank you."
msgstr "아무튼 쭉 정진할게. 고마워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Guex
#. NodeID = e009ed62-5f41-56b9-e909-f2e16430d3bc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:e009ed62-5f41-56b9-e909-f2e16430d3bc
msgctxt "h0e12ee19ge6e7g4356gbcd7g972e97fca625"
msgid "Rage, you say? RrrrrrrrrARGH! Step-brace, parry, swing - ugh."
msgstr "분노하란 말이지? <b>그아아아아악!</b> 딛고, 버티고, 쳐내고, 베고... 아오!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Player
#. NodeID = e9f95159-7691-2f07-26fa-0e034841e6c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:e9f95159-7691-2f07-26fa-0e034841e6c1
msgctxt "had6e9fa1g0cabg441fg8e03gfa70dd1512fd"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Guex
#. NodeID = ebd53abb-37dd-512c-829a-ba5c09b81351
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_IrritatedTiefling_State_Improved = True
#.      - DEN_IrritatedTiefling_State_RogueImprovement = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:ebd53abb-37dd-512c-829a-ba5c09b81351
msgctxt "h6a0364d8g225eg4d13ga7e4g2fdfa5d08955"
msgid "Feint, wait - and thrust!"
msgstr "속이고, 기다렸다... 찌르기!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Guex
#. NodeID = ed759ad0-7db4-ad64-f524-b5445f5281d7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_IrritatedTiefling_State_NoImprovement = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:ed759ad0-7db4-ad64-f524-b5445f5281d7
msgctxt "h8caafd2bgb55cg4391g91b0g3a420decf334"
msgid "All right, so like <i>this. </i>Step-step, swivel - UGH!"
msgstr "좋아, <i>이렇게</i> 말이지? 딛고, 또 딛고, 돌기... 으윽!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Player
#. NodeID = eefbba9d-c190-5e0e-8b82-f392e2d115cf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:eefbba9d-c190-5e0e-8b82-f392e2d115cf
msgctxt "h84543500g7b10g4c62ga96bg3878c52a1843"
msgid "Try this swing. A little number I call 'The Legend's Strike'."
msgstr "한 번 이렇게 베어 봐. 내가 '전설의 일격'이라고 부르는 기술이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Player
#. NodeID = f2680219-cfb1-a1c5-bd0a-0b8efe9bcb04
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = False
#.      - FIGHTER(1) = False
#.      - REALLY_HALFORC(1) = False
#.      - MONK(1) = False
#.      - REALLY_GITHYANKI(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:f2680219-cfb1-a1c5-bd0a-0b8efe9bcb04
msgctxt "h1a5f9436ga22dg4e21g80a1g1bd9f600369e"
msgid ""
"No wonder you're struggling - you've no balance. Space your feet farther "
"apart."
msgstr "쩔쩔매는 게 당연하군. 자세 균형이 전혀 안 맞잖아. 발을 더 넓게 벌려 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Player
#. NodeID = f925c94e-1146-deae-7207-b973a1d943ff
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ROGUE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:f925c94e-1146-deae-7207-b973a1d943ff
msgctxt "h7a7d6ad6g2d03g4356gbfddge0cc4fe69f57"
msgid ""
"This isn't a joust. Feint with your sword, then kick between the 'legs' "
"instead."
msgstr "시합용 대결 하는 게 아니잖아. 검으로 동작을 속이고, '다리' 사이를 걷어차버려."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling
#. Speaker = Guex
#. NodeID = fe6037b0-6c66-c629-f77d-53c1ed2e1475
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_IrritatedTiefling_State_Improved = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling:fe6037b0-6c66-c629-f77d-53c1ed2e1475
msgctxt "hf6459029g74deg4558gbe3dg9db8e2a49915"
msgid "Like <i>this, </i>then. Focus... focus... and strike! <i>Yes!</i>"
msgstr "그럼 <i>이렇게</i> 해 볼게. 집중… 집중… 이제 공격! <i>됐다!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling_AD
#. Speaker = Guex
#. NodeID = 04bad0ea-0d2b-7c8e-61ad-ea9a58ef9779
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_IrritatedTiefling_State_Improved = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling_AD:04bad0ea-0d2b-7c8e-61ad-ea9a58ef9779
msgctxt "hfe8cb813g7d8bg4151gab31gcdba4a077e2a"
msgid "Step-parry-swing, and lunge."
msgstr "딛고, 쳐내고, 베고, 찌르기."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling_AD
#. Speaker = Guex
#. NodeID = 04bad0ea-0d2b-7c8e-61ad-ea9a58ef9779
#. HandlePath = TaggedText[0].TagText[1]
#. CheckFlags:
#.   Global:
#.      - DEN_IrritatedTiefling_State_Improved = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling_AD:04bad0ea-0d2b-7c8e-61ad-ea9a58ef9779
msgctxt "h26bf7b04gd480g47ffg9f74g68fb57c4c20b"
msgid "Hold-and-step. Swing, parry, swing."
msgstr "멈추고, 딛고. 베고, 쳐내고, 베기."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling_AD
#. Speaker = Guex
#. NodeID = 04bad0ea-0d2b-7c8e-61ad-ea9a58ef9779
#. HandlePath = TaggedText[0].TagText[2]
#. CheckFlags:
#.   Global:
#.      - DEN_IrritatedTiefling_State_Improved = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling_AD:04bad0ea-0d2b-7c8e-61ad-ea9a58ef9779
msgctxt "h6aea9fc2g63ceg4116g984bgdcf3353b7626"
msgid "Swing-and-swivel. Wait... wait... now lunge!"
msgstr "베고, 돌고, 기다리고... 기다렸다... 찌르기!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling_AD
#. Speaker = Guex
#. NodeID = 16a4f013-4fc9-57a4-f322-059d50b750be
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling_AD:16a4f013-4fc9-57a4-f322-059d50b750be
msgctxt "h7a843f2aga15fg4fa3ga0a5g4244f1aef85d"
msgid "One more time."
msgstr "한 번 더 하자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling_AD
#. Speaker = Guex
#. NodeID = 16a4f013-4fc9-57a4-f322-059d50b750be
#. HandlePath = TaggedText[0].TagText[1]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling_AD:16a4f013-4fc9-57a4-f322-059d50b750be
msgctxt "headc55d6g0efcg4bf3g85c9g00620b990ba7"
msgid "Excellent!"
msgstr "좋았어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling_AD
#. Speaker = Guex
#. NodeID = 1b0ad383-dacd-2bbc-51b9-ab3f3d73f461
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling_AD:1b0ad383-dacd-2bbc-51b9-ab3f3d73f461
msgctxt "h75fe1b72g132bg4a3eg8236g93265f5d9b67"
msgid "Again. Swing-and-swing-and-parry-and-nnnGGH!"
msgstr "다시. 베고, 또 베고, 쳐내고, 으으으으!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling_AD
#. Speaker = Guex
#. NodeID = 2ef4236b-65bf-f2bf-527e-82cb871987e5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling_AD:2ef4236b-65bf-f2bf-527e-82cb871987e5
msgctxt "h9dc45c83g1e04g48e1gadf4g00478eb7e055"
msgid "And again."
msgstr "한 번 더."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling_AD
#. Speaker = Guex
#. NodeID = b2605a5a-83c4-5f41-c0f8-967c54dc1bef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_IrritatedTiefling_AD:b2605a5a-83c4-5f41-c0f8-967c54dc1bef
msgctxt "h6bfbaa3bgdd98g479dga9b0g4772902944a3"
msgid "Swing, swing-and-unGH!"
msgstr "베고, 또 베고, 또... 아오!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Jailbreak_PAD_DiscoverTrap
#. Speaker = Player
#. NodeID = 3b80fe24-9de5-42ab-9f0d-377dd7a55f05
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Jailbreak_PAD_DiscoverTrap:3b80fe24-9de5-42ab-9f0d-377dd7a55f05
msgctxt "h3e5ca8c1gdbf1g42d3gb6adgb4b575de5e14"
msgid "That's an unruly-looking mushroom. Best not get too close."
msgstr "상당히 불안정하게 생긴 버섯이군. 가까이 가지 않는 게 좋겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Jailbreak_PAD_DiscoverTrap
#. Speaker = Player
#. NodeID = 3b80fe24-9de5-42ab-9f0d-377dd7a55f05
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Jailbreak_PAD_DiscoverTrap:3b80fe24-9de5-42ab-9f0d-377dd7a55f05
msgctxt "hfc37cd9cg439ag40eag8a51g1b4d6e71418b"
msgid "Something's... off about that mushroom. Best keep my distance."
msgstr "저 버섯은 뭔가... 이상해. 조심해야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Jailbreak_PAD_DiscoverTrap
#. Speaker = Player
#. NodeID = 3b80fe24-9de5-42ab-9f0d-377dd7a55f05
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Jailbreak_PAD_DiscoverTrap:3b80fe24-9de5-42ab-9f0d-377dd7a55f05
msgctxt "h7205c9c6g999ag4ed0ga234gb743115c8894"
msgid "Danger mushroom."
msgstr "위험한 버섯이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Jailbreak_PAD_DiscoverTrap
#. Speaker = Player
#. NodeID = 3b80fe24-9de5-42ab-9f0d-377dd7a55f05
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Jailbreak_PAD_DiscoverTrap:3b80fe24-9de5-42ab-9f0d-377dd7a55f05
msgctxt "h34b816dag8f12g4f64g8f1fg2dc191d2152f"
msgid "That mushroom is... unusual. Not sure I should get too close."
msgstr "저 버섯은... 이상해. 너무 가까이 가지 않는 게 좋겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Jailbreak_PAD_DiscoverTrap
#. Speaker = Player
#. NodeID = 3b80fe24-9de5-42ab-9f0d-377dd7a55f05
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Jailbreak_PAD_DiscoverTrap:3b80fe24-9de5-42ab-9f0d-377dd7a55f05
msgctxt "hf68d247bgc6c9g4937g91deg11f5038aa194"
msgid "Something tells me I should give that mushroom a wide berth."
msgstr "뭔가 저 버섯에서 멀리 떨어져 있어야겠다는 느낌이 와."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Jailbreak_PAD_DiscoverTrap
#. Speaker = Player
#. NodeID = 3b80fe24-9de5-42ab-9f0d-377dd7a55f05
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Jailbreak_PAD_DiscoverTrap:3b80fe24-9de5-42ab-9f0d-377dd7a55f05
msgctxt "h556f5218g1b99g456bg9f89g24f88ff66a43"
msgid "That's one strange mushroom - I think I'll stay clear."
msgstr "수상하게도 생긴 버섯이군... 거리를 둬야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Jailbreak_PAD_DiscoverTrap
#. Speaker = Player
#. NodeID = 3b80fe24-9de5-42ab-9f0d-377dd7a55f05
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Jailbreak_PAD_DiscoverTrap:3b80fe24-9de5-42ab-9f0d-377dd7a55f05
msgctxt "hf6c1dbb2g7209g4a2bg9719g99a9dd2cf14e"
msgid "I don't like the look of that mushroom. I should stay clear."
msgstr "저 버섯 생긴게 맘에 안 들어. 정신차리고 있어야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_LaezelGeneral_VB_FishOutofWater
#. Speaker = Lae'zel
#. NodeID = 0c7ab616-93a1-a88d-73d7-9594381f8442
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_LaezelGeneral_VB_FishOutofWater:0c7ab616-93a1-a88d-73d7-9594381f8442
msgctxt "hb1083600g473bg4d4dga958g7d1c81223f84"
msgid "Judicious advice. How puzzling."
msgstr "현명한 조언이라니. 당황스럽군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_LaezelGeneral_VB_FishOutofWater
#. Speaker = Lae'zel
#. NodeID = 0c7ab616-93a1-a88d-73d7-9594381f8442
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_LaezelGeneral_VB_FishOutofWater:0c7ab616-93a1-a88d-73d7-9594381f8442
msgctxt "h1464319fg85afg4307g959dg58a3b964847a"
msgid "Hmph. And you'd deny me the pleasure?"
msgstr "흥. 그럼 내 즐거움은 뺏어가겠다는 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_LaezelGeneral_VB_FishOutofWater
#. Speaker = Lae'zel
#. NodeID = 0c7ab616-93a1-a88d-73d7-9594381f8442
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_LaezelGeneral_VB_FishOutofWater:0c7ab616-93a1-a88d-73d7-9594381f8442
msgctxt "hb6452616g5f82g4ca6gac78g686d1ca061c7"
msgid "I fail to see the distinction."
msgstr "둘의 차이를 모르겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_LaezelGeneral_VB_FishOutofWater
#. Speaker = Player
#. NodeID = 4e81212c-5b5c-f859-15d9-8fe551640e04
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_LaezelGeneral_VB_FishOutofWater:4e81212c-5b5c-f859-15d9-8fe551640e04
msgctxt "he8bc1305g54cfg45bdgbfc2g188d5c078751"
msgid "They make good bait, drawing attention away from us."
msgstr "티플링은 적의 주의를 돌려줄 좋은 미끼야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_LaezelGeneral_VB_FishOutofWater
#. Speaker = Player
#. NodeID = 4e81212c-5b5c-f859-15d9-8fe551640e04
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_LaezelGeneral_VB_FishOutofWater:4e81212c-5b5c-f859-15d9-8fe551640e04
msgctxt "hc930e58bgb724g4a5cg9457gbe329564434a"
msgid "Let the goblins kill them. At least they'll enjoy it."
msgstr "고블린들이 죽이도록 내버려 둬라. 최소한 그들은 즐길 테니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_LaezelGeneral_VB_FishOutofWater
#. Speaker = Player
#. NodeID = 4e81212c-5b5c-f859-15d9-8fe551640e04
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_LaezelGeneral_VB_FishOutofWater:4e81212c-5b5c-f859-15d9-8fe551640e04
msgctxt "h436ce98ag681fg4a68g93d4ge432e81e0f2e"
msgid "Calm yourself. They're survivors, not soldiers."
msgstr "진정해. 그들은 생존자지, 군인이 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_LaezelGeneral_VB_FishOutofWater
#. Speaker = Lae'zel
#. NodeID = 705e1f39-902b-15ea-2bc4-5f7c4a606c5d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_LaezelGeneral_VB_FishOutofWater:705e1f39-902b-15ea-2bc4-5f7c4a606c5d
msgctxt "hd76769e7ge2e5g44dbga649gaff92b5281c2"
msgid "These tieflings prove fragile. I've a mind to end their misery myself."
msgstr "이 티플링들은 허약하기 짝이 없군. 내가 직접 그들의 한심한 인생을 끝내주겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_LaezelGeneral_VB_FishOutofWater_WithWyll
#. Speaker = Lae'zel
#. NodeID = 0476c650-2d04-8ad0-9d23-f8edc3589579
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_LaezelGeneral_VB_FishOutofWater_WithWyll:0476c650-2d04-8ad0-9d23-f8edc3589579
msgctxt "hc44f7386ga632g4a66ga8afgdec266f1a49e"
msgid "These tieflings prove fragile. I've a mind to end their misery myself."
msgstr "이 티플링들은 허약하기 짝이 없군. 내가 직접 그들의 한심한 인생을 끝내주겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_LaezelGeneral_VB_FishOutofWater_WithWyll
#. Speaker = Wyll
#. NodeID = 23d4d488-124f-7ff2-ca71-d7f0ae82c5d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_LaezelGeneral_VB_FishOutofWater_WithWyll:23d4d488-124f-7ff2-ca71-d7f0ae82c5d9
msgctxt "h769c6d16g0d4bg4903gb21cg63a59291866d"
msgid "Harsh. Remind me to stay on your good side."
msgstr "가혹하네. 난 네 편이라는 사실은 기억해 줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_LaezelGeneral_VB_FishOutofWater_WithWyll
#. Speaker = Lae'zel
#. NodeID = 6f97fec1-38f5-5367-0575-0ba02755ae62
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_LaezelGeneral_VB_FishOutofWater_WithWyll:6f97fec1-38f5-5367-0575-0ba02755ae62
msgctxt "hfc9aaeccg40e5g4b3fg9cfag190f328893f4"
msgid "You were never on my good side."
msgstr "넌 한번도 내 편이었던 적이 없다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Attack
#. Speaker = Player
#. NodeID = 48c088b6-7e13-a70a-a611-4d72496efca0
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Attack:48c088b6-7e13-a70a-a611-4d72496efca0
msgctxt "h17d3fb16g9c0cg47b9g9a9cg4f3ba31139f2"
msgid "It's no good - they're impossibly strong."
msgstr "끄떡도 없군... 말도 안 되게 튼튼해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Attack
#. Speaker = Player
#. NodeID = 48c088b6-7e13-a70a-a611-4d72496efca0
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Attack:48c088b6-7e13-a70a-a611-4d72496efca0
msgctxt "h3d9a86a9g4652g42a0ga348ge15f10f3feab"
msgid "Useless. Like hewing granite with a spoon."
msgstr "어림도 없어. 계란으로 바위 치는 꼴인데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Attack
#. Speaker = Player
#. NodeID = 48c088b6-7e13-a70a-a611-4d72496efca0
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Attack:48c088b6-7e13-a70a-a611-4d72496efca0
msgctxt "h3d668b14ge984g46beg9a37gacbea27a2ef3"
msgid "Argh! No point - I can't get through it."
msgstr "악! 흠집도 없군. 뚫고 지나갈 순 없겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Attack
#. Speaker = Player
#. NodeID = 48c088b6-7e13-a70a-a611-4d72496efca0
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Attack:48c088b6-7e13-a70a-a611-4d72496efca0
msgctxt "h6a0ac33fgdcb0g46a6ga405g8d99b4b2c139"
msgid "Useless. A silver sword couldn't slice through."
msgstr "어림도 없군. 은검조차도 벨 수가 없다니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Attack
#. Speaker = Player
#. NodeID = 48c088b6-7e13-a70a-a611-4d72496efca0
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Attack:48c088b6-7e13-a70a-a611-4d72496efca0
msgctxt "hdfd632a7g6f54g4366g9437g14b62319d362"
msgid "I won't be getting through these things - nor will anyone else."
msgstr "이건 도저히 뚫을 수가 없겠는데. 누가 시도해도 소용없겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Attack
#. Speaker = Player
#. NodeID = 48c088b6-7e13-a70a-a611-4d72496efca0
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Attack:48c088b6-7e13-a70a-a611-4d72496efca0
msgctxt "h62a6b83ege4c8g48cfgb5c0gdc6707c1095f"
msgid "Not even the Blade can hack through that mess."
msgstr "칼로도 벨 수 없는 덩굴이라니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Attack
#. Speaker = Player
#. NodeID = 48c088b6-7e13-a70a-a611-4d72496efca0
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: DRUID
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Attack:48c088b6-7e13-a70a-a611-4d72496efca0
msgctxt "hb4c9d920g94e0g42a7gad13gf051744e1fb6"
msgid "It's hopeless. Silvanus' will holds these vines in place."
msgstr "답이 없군. 실바누스가 이 덩굴을 단단히 잡아놓고 있는 모양이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Attack
#. Speaker = Player
#. NodeID = 48c088b6-7e13-a70a-a611-4d72496efca0
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: RANGER
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Attack:48c088b6-7e13-a70a-a611-4d72496efca0
msgctxt "hfac3f2efgf3cfg4c23g9062g2847ecef1f0e"
msgid "The bark's like iron. This is a waste of time."
msgstr "껍질이 쇳덩이처럼 단단하군. 시간 낭비야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Attack
#. Speaker = Player
#. NodeID = 48c088b6-7e13-a70a-a611-4d72496efca0
#. HandlePath = TaggedText[8].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Attack:48c088b6-7e13-a70a-a611-4d72496efca0
msgctxt "h47a43a89ga650g4305g9f0fg2a0c45468ef2"
msgid "It'd take an age to hack through all this."
msgstr "이걸 뚫고 지나가려면 한 세월 걸리겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Comment
#. Speaker = Player
#. NodeID = 6fa2053b-495e-905b-2a7a-d6291eec75e9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4aa98a50-3b87-f47a-811c-25097eb0198b_A = False
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_Knows_Lockdown = True
#.   Local:
#.     - 4aa98a50-3b87-f47a-811c-25097eb0198b_A = True
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Comment:6fa2053b-495e-905b-2a7a-d6291eec75e9
msgctxt "h1a93f41bg0927g4b89g9279g5b358c511094"
msgid "Well. It seems we're not invited."
msgstr "흠. 아무래도 우리는 초대받지 못한 모양인데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Comment
#. Speaker = Player
#. NodeID = 6fa2053b-495e-905b-2a7a-d6291eec75e9
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4aa98a50-3b87-f47a-811c-25097eb0198b_A = False
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_Knows_Lockdown = True
#.   Local:
#.     - 4aa98a50-3b87-f47a-811c-25097eb0198b_A = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Comment:6fa2053b-495e-905b-2a7a-d6291eec75e9
msgctxt "ha29f5f68g212ag4f4dgad61gad5ae57c727f"
msgid "All entrances sealed tight."
msgstr "모든 입구가 단단히 봉쇄됐어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Comment
#. Speaker = Player
#. NodeID = 6fa2053b-495e-905b-2a7a-d6291eec75e9
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4aa98a50-3b87-f47a-811c-25097eb0198b_A = False
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_Knows_Lockdown = True
#.   Local:
#.     - 4aa98a50-3b87-f47a-811c-25097eb0198b_A = True
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Comment:6fa2053b-495e-905b-2a7a-d6291eec75e9
msgctxt "h9b7683fegc807g4b28gac13g0b60934803ad"
msgid ""
"Look at all those vines spread like vices over the grove. A sour harvest in "
"the making."
msgstr "숲을 뒤덮고 악덕처럼 퍼져나가는 저 수많은 덩굴을 봐. 곪은 수확물이 맺혀가는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Comment
#. Speaker = Player
#. NodeID = 6fa2053b-495e-905b-2a7a-d6291eec75e9
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4aa98a50-3b87-f47a-811c-25097eb0198b_A = False
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_Knows_Lockdown = True
#.   Local:
#.     - 4aa98a50-3b87-f47a-811c-25097eb0198b_A = True
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Comment:6fa2053b-495e-905b-2a7a-d6291eec75e9
msgctxt "h013c8a57g7108g4cddgb9d3g543cb17bd0e9"
msgid "Vines everywhere. They did it. They really did it."
msgstr "덩굴로 완전히 뒤덮였군. 드루이드들이 저질렀어. 정말 의식을 마쳐 버렸어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Comment
#. Speaker = Player
#. NodeID = 6fa2053b-495e-905b-2a7a-d6291eec75e9
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4aa98a50-3b87-f47a-811c-25097eb0198b_A = False
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_Knows_Lockdown = True
#.   Local:
#.     - 4aa98a50-3b87-f47a-811c-25097eb0198b_A = True
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Comment:6fa2053b-495e-905b-2a7a-d6291eec75e9
msgctxt "he8a45fdfg08bag4d7ag9925gaf0ad3b45ecd"
msgid "Let's not linger - the ritual is complete."
msgstr "여기를 떠야겠군. 의식이 마쳐졌어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Comment
#. Speaker = Player
#. NodeID = 6fa2053b-495e-905b-2a7a-d6291eec75e9
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4aa98a50-3b87-f47a-811c-25097eb0198b_A = False
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_Knows_Lockdown = True
#.   Local:
#.     - 4aa98a50-3b87-f47a-811c-25097eb0198b_A = True
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Comment:6fa2053b-495e-905b-2a7a-d6291eec75e9
msgctxt "h84fd85cdgaedag4123g9fd2g94c5a5fa1dad"
msgid "That's it, then. The druids got what they wanted."
msgstr "그럼, 이걸로 끝인가 보군. 드루이드들이 원하던 대로 됐어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Comment
#. Speaker = Player
#. NodeID = 6fa2053b-495e-905b-2a7a-d6291eec75e9
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4aa98a50-3b87-f47a-811c-25097eb0198b_A = False
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_Knows_Lockdown = True
#.   Local:
#.     - 4aa98a50-3b87-f47a-811c-25097eb0198b_A = True
#. TagRule: REALLY_TIEFLING
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Comment:6fa2053b-495e-905b-2a7a-d6291eec75e9
msgctxt "h94252005gb893g4ec7ga977g2ec7aa2da2b7"
msgid "They wanted tieflings out. They got their wish."
msgstr "그들은 티플링들을 쫓아내고 싶어했지. 원하는 대로 됐군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Comment
#. Speaker = Player
#. NodeID = 6fa2053b-495e-905b-2a7a-d6291eec75e9
#. HandlePath = TaggedText[7].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4aa98a50-3b87-f47a-811c-25097eb0198b_A = False
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_Knows_Lockdown = True
#.   Local:
#.     - 4aa98a50-3b87-f47a-811c-25097eb0198b_A = True
#. TagRule: DRUID
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Comment:6fa2053b-495e-905b-2a7a-d6291eec75e9
msgctxt "h31c75fbfg8ed4g461eg9f5cg81b778f88e02"
msgid "To summon those vines... the power's impressive."
msgstr "이만한 덩굴을 불러내다니... 정말 엄청난 힘이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Comment
#. Speaker = Player
#. NodeID = 6fa2053b-495e-905b-2a7a-d6291eec75e9
#. HandlePath = TaggedText[8].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4aa98a50-3b87-f47a-811c-25097eb0198b_A = False
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_Knows_Lockdown = True
#.   Local:
#.     - 4aa98a50-3b87-f47a-811c-25097eb0198b_A = True
#. TagRule: RANGER
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Comment:6fa2053b-495e-905b-2a7a-d6291eec75e9
msgctxt "hea724d53gd82cg4dc0ga90cg9cf48ecd988c"
msgid "There's a darkness coursing through those vines."
msgstr "이 덩굴들 속엔 어둠이 도사리고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Comment
#. Speaker = Player
#. NodeID = 6fa2053b-495e-905b-2a7a-d6291eec75e9
#. HandlePath = TaggedText[9].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 4aa98a50-3b87-f47a-811c-25097eb0198b_A = False
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_Knows_Lockdown = True
#.   Local:
#.     - 4aa98a50-3b87-f47a-811c-25097eb0198b_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Comment:6fa2053b-495e-905b-2a7a-d6291eec75e9
msgctxt "hadc4adbdg285cg4d9ag8c67g4690202ac8d5"
msgid "Looks like the ritual worked. The whole grove is walled in."
msgstr "의식이 정말 완수됐나 보군. 온 숲이 벽으로 둘러싸였어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Comment
#. Speaker = Player
#. NodeID = 8bb8271e-0055-3e77-63dc-373ddd42674e
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Comment:8bb8271e-0055-3e77-63dc-373ddd42674e
msgctxt "h71ee1a3bg273dg4e37gbf23gc431059b0f32"
msgid "No one's getting in. Impressive, if a little dramatic."
msgstr "아무도 못 들어가겠군. 대단한데. 약간 극적이기까지 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Comment
#. Speaker = Player
#. NodeID = 8bb8271e-0055-3e77-63dc-373ddd42674e
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Comment:8bb8271e-0055-3e77-63dc-373ddd42674e
msgctxt "h9140044cgd8c5g4adagb225g3b767b4a7120"
msgid "Impressive, as weeds go."
msgstr "잡초 치곤 제법이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Comment
#. Speaker = Player
#. NodeID = 8bb8271e-0055-3e77-63dc-373ddd42674e
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Comment:8bb8271e-0055-3e77-63dc-373ddd42674e
msgctxt "h4955572dg181cg4ce7g8b6eg80c375275196"
msgid "Impenetrable. But why would we even bother?"
msgstr "절대 못 들어가겠군. 뭐 들어갈 필요도 없겠지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Comment
#. Speaker = Player
#. NodeID = 8bb8271e-0055-3e77-63dc-373ddd42674e
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Comment:8bb8271e-0055-3e77-63dc-373ddd42674e
msgctxt "hc62316c2g3e7ag440dgb509g1b6395df02be"
msgid "Forget it. Even the Blade can't slice through those."
msgstr "포기하자. 칼로도 벨 수가 없는 덩굴이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Comment
#. Speaker = Player
#. NodeID = 8bb8271e-0055-3e77-63dc-373ddd42674e
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Comment:8bb8271e-0055-3e77-63dc-373ddd42674e
msgctxt "hc92231b1g6632g4b7agbbf1g06ceb2e9d995"
msgid "The vines are inpenetrable."
msgstr "도저히 뚫을 수가 없는 덩굴이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Comment
#. Speaker = Player
#. NodeID = 8bb8271e-0055-3e77-63dc-373ddd42674e
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Comment:8bb8271e-0055-3e77-63dc-373ddd42674e
msgctxt "hc600387aga64eg42e8gb5b9gc407249cbf94"
msgid "No point. I can't get through."
msgstr "안되겠는데. 헤치고 지나갈 수가 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Comment
#. Speaker = Player
#. NodeID = 8bb8271e-0055-3e77-63dc-373ddd42674e
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: DRUID
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Comment:8bb8271e-0055-3e77-63dc-373ddd42674e
msgctxt "h0200a9c8g9e3dg4adcg855dg41f904ff7c8b"
msgid "There's no getting past those vines. The ritual was thorough."
msgstr "덩굴을 헤치고 지나갈 도리가 없겠군. 철저한 의식이었나 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Comment
#. Speaker = Player
#. NodeID = 8bb8271e-0055-3e77-63dc-373ddd42674e
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: RANGER
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Comment:8bb8271e-0055-3e77-63dc-373ddd42674e
msgctxt "h98c7e7b2g5b12g424cg922cgb5d53c60df3c"
msgid "A mouse couldn't squeeze through those vines."
msgstr "쥐새끼 한 마리도 이 덩굴을 비집고 들어갈 수 없겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Comment
#. Speaker = Player
#. NodeID = 8bb8271e-0055-3e77-63dc-373ddd42674e
#. HandlePath = TaggedText[8].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Lockdown_PAD_Comment:8bb8271e-0055-3e77-63dc-373ddd42674e
msgctxt "hfd92b0c8g5928g40f8ga1eag03fb20ee1042"
msgid "There's no getting through."
msgstr "지나갈 방법이 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Minthara_VB_ReturnedToGrove
#. Speaker = Player
#. NodeID = 66d27aee-e766-b08d-cec2-ebfa6ef82020
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Minthara_Event_VisitedGoblinCampAfterSCL = True
#. TagRule: REALLY_MINTHARA
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Minthara_VB_ReturnedToGrove:66d27aee-e766-b08d-cec2-ebfa6ef82020
msgctxt "ha3309a41g0c40g4398gb1deg56d02caefafc"
msgid ""
"I was a slave when we were last here. I do not appreciate being reminded of "
"that."
msgstr "우리가 마지막으로 여기에 왔을 때 나는 노예였지. 그다지 떠올리고 싶은 기억은 아니군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Minthara_VB_ReturnedToGrove
#. Speaker = Player
#. NodeID = 7feb56ad-30ae-a588-69bc-4b25f57fb638
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_MINTHARA
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_Minthara_VB_ReturnedToGrove:7feb56ad-30ae-a588-69bc-4b25f57fb638
msgctxt "hece87030ga30fg4d61g9ed9g5fad031731ef"
msgid "There is nothing but bad memories here. We should leave."
msgstr "이곳엔 나쁜 기억밖에 없다. 떠나자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_CapturedGoblin_Crime
#. Speaker = Narrator
#. NodeID = 0d8c8e96-8e97-73a9-21a9-56860b790b94
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_CapturedGoblin_Crime:0d8c8e96-8e97-73a9-21a9-56860b790b94
msgctxt "h2640140cgeff1g4b3bgbb2eg70286523b005"
msgid "*You are persuasive enough. You, and the goblin, are free to go.*"
msgstr "*당신의 말은 충분히 설득력 있습니다. 당신과 고블린은 가도 좋습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_CapturedGoblin_Crime
#. Speaker = Player
#. NodeID = 19dcae58-2e45-3417-fe55-80cd06fc04d5
#. HandlePath = TaggedText[0].TagText[0]
#. RollType:
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_IsMissing = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_CapturedGoblin_Crime:19dcae58-2e45-3417-fe55-80cd06fc04d5
msgctxt "hddafb929gad65g460ag83bfga8d7745dc3d0"
msgid "Before he left, Halsin told me to set this goblin free."
msgstr "할신이 떠나기 전에 이 고블린을 풀어주라고 말했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_CapturedGoblin_Crime
#. Speaker = Player
#. NodeID = 1c99a216-0aed-c548-3cc5-8fa14d5062de
#. HandlePath = TaggedText[0].TagText[0]
#. RollType:
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_CapturedGoblin_Crime:1c99a216-0aed-c548-3cc5-8fa14d5062de
msgctxt "h239dca24g8825g4b1fg8031g01006eef0529"
msgid "Anyone who wants to hurt Sazza will face me first."
msgstr "누구든 삿자를 해치길 원한다면 나부터 상대해야 할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_CapturedGoblin_Crime
#. Speaker = Narrator
#. NodeID = 39702211-d1cb-c3d6-b522-e5b0a1b942bc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_CapturedGoblin_Crime:39702211-d1cb-c3d6-b522-e5b0a1b942bc
msgctxt "h97d78026g03e8g40e9gb3abgcefe12ce3597"
msgid ""
"*Your words are futile. The goblin will not be allowed to leave. Neither "
"will you.*"
msgstr "*당신의 말은 소용없습니다. 이 고블린은 떠나지 못할 것입니다. 당신도 마찬가지고요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_CapturedGoblin_Crime
#. Speaker = Player
#. NodeID = 6401222a-0665-1c63-0288-994f970bb541
#. HandlePath = TaggedText[0].TagText[0]
#. RollType:
#. RollAbility: Charisma
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_CapturedGoblin_Crime:6401222a-0665-1c63-0288-994f970bb541
msgctxt "h9fd31fecg5105g4ef3gbcd7g36f7bfc62699"
msgid "<i>Quiet</i>. She's going to help me destroy her old camp."
msgstr "<i>조용히 해</i>. 그녀는 자기가 속했던 야영지를 파괴하는 것을 돕고 있으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_CapturedGoblin_Crime
#. Speaker = Player
#. NodeID = 6c2fceb2-d6ae-a74c-4ec5-02875e467e80
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_CapturedGoblin_Event_GoblinBetrayed = True
#.     - DEN_CapturedGoblin_Event_LeftGoblin = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_CapturedGoblin_Crime:6c2fceb2-d6ae-a74c-4ec5-02875e467e80
msgctxt "h700b6910g6363g4934g80f1g89218eab1d80"
msgid "<i>Hand the goblin over.</i>"
msgstr "<i>고블린을 넘겨준다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_CapturedGoblin_Crime
#. Speaker = Player
#. NodeID = 85e09ade-a7b8-2910-c4b9-1befe2bc302a
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_CapturedGoblin_Crime:85e09ade-a7b8-2910-c4b9-1befe2bc302a
msgctxt "hd99b351ag0de9g4c4egb9deg30671f950938"
msgid "STAND DOWN. OR I <b>BREAK </b>YOU."
msgstr "물러서. 안 그럼 널 <b>박살내버리겠어</b>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_CapturedGoblin_Crime
#. Speaker = Player
#. NodeID = a60905a3-a24b-976d-98cb-7e258197f7e5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_CapturedGoblin_Event_GoblinBetrayed = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_CapturedGoblin_Crime:a60905a3-a24b-976d-98cb-7e258197f7e5
msgctxt "hb614212fg01d1g4fdcg938ag3755e442a048"
msgid "<i>Attack the goblin.</i>"
msgstr "<i>고블린을 공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_CapturedGoblin_Crime
#. Speaker = Narrator
#. NodeID = c3ab642a-1fbf-5d92-e138-2c5ebc847302
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_CapturedGoblin_Crime:c3ab642a-1fbf-5d92-e138-2c5ebc847302
msgctxt "he6f24f9cg1246g4d8bgba54g1c2dd583f549"
msgid ""
"*Your rescue attempt has been noticed. Choose your next move carefully.*"
msgstr "*당신의 구출 시도가 발각되었습니다. 당신의 다음 행동을 신중히 택하세요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_GroveConflict_IdolCrime
#. Speaker = Narrator
#. NodeID = 014dfab7-4bbc-6cfd-9c83-c5b4df75eed0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CRIME_PersuasionFailed(1) = True
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_GroveConflict_IdolCrime:014dfab7-4bbc-6cfd-9c83-c5b4df75eed0
msgctxt "h492b4872g4952g4976ga6b0g1c8c0998a7a2"
msgid ""
"*The druid realises you're the thief. The idol will not be allowed to leave. "
"Neither will you.*"
msgstr "*이 드루이드가 당신이 도둑이라는 것을 알아챘습니다. 우상은 떠나지 못할 것입니다. 당신도 마찬가지고요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_GroveConflict_IdolCrime
#. Speaker = Player
#. NodeID = 1079914a-77be-d56d-1746-77e2b468c809
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_GroveConflict_IdolCrime:1079914a-77be-d56d-1746-77e2b468c809
msgctxt "hee3f4d00g1e9eg487egbc59g0c64896e9096"
msgid "IT'S <b>MINE</b>. <b>PISS OFF.</b>"
msgstr "이건 <b>내 거</b>야. <b>꺼져.</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_GroveConflict_IdolCrime
#. Speaker = Player
#. NodeID = 6d0bde38-e49a-a014-dc0d-84a4d4327777
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_GroveConflict_IdolCrime:6d0bde38-e49a-a014-dc0d-84a4d4327777
msgctxt "hb459ba2dgade3g4ddag8f74g6d0504b5d98d"
msgid "I'm afraid I haven't seen it, sorry."
msgstr "본 적 없는 거 같아, 미안."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_GroveConflict_IdolCrime
#. Speaker = Narrator
#. NodeID = 708bd4ed-651d-77f8-6c53-a87da12f340c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CRIME_FoundGuiltyPlayer(0) = True
#.     - CRIME_AgreedToForgiveCrime(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_GroveConflict_IdolCrime:708bd4ed-651d-77f8-6c53-a87da12f340c
msgctxt "ha92fd2f8gae12g4668g89fag7b21182a6b9d"
msgid ""
"*You return the relic, but your guilt is not so easily discarded. You will "
"be closely watched.*"
msgstr "*유물을 돌려줬지만, 쉽게 넘어갈 수 없는 죄입니다. 다들 당신의 행동을 감시할 겁니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_GroveConflict_IdolCrime
#. Speaker = Player
#. NodeID = 73d9f2ce-951c-dd09-5560-67ed62b1be7d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CRIME_FoundGuiltyPlayer(0) = True
#.     - CRIME_Resist_Search(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_GroveConflict_IdolCrime:73d9f2ce-951c-dd09-5560-67ed62b1be7d
msgctxt "h28881601gecf6g4c4bgbb3fgd3d9f5c69c33"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_GroveConflict_IdolCrime
#. Speaker = Player
#. NodeID = 7b58a2f1-df3b-c573-57ac-e4bfb426baf7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CRIME_FoundEvidenceCurrentCrime(0) = True
#. SetFlags:
#.   Object:
#.     - DEN_GroveConflict_Event_ReturnIdol(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_GroveConflict_IdolCrime:7b58a2f1-df3b-c573-57ac-e4bfb426baf7
msgctxt "h69dcf749gdc37g4a60ga5e3gd398281bfa76"
msgid "<i>Return the idol and apologise.</i>"
msgstr "<i>우상을 돌려주고 사과한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_GroveConflict_IdolCrime
#. Speaker = Narrator
#. NodeID = 9f8f6588-e2fd-a3b8-1533-45fbbe1b7fe4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_GroveConflict_IdolCrime:9f8f6588-e2fd-a3b8-1533-45fbbe1b7fe4
msgctxt "he514523cg5e9bg4ddfg86c6geebd54b8df98"
msgid "*You certainly are <i>convincing</i>. The druid is letting you leave.*"
msgstr "*당신의 말은 확실히 <i>설득력이</i> 있습니다. 드루이드가 당신을 놓아줍니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_GroveConflict_IdolCrime
#. Speaker = Narrator
#. NodeID = b3f77148-ee3c-e8e6-72f7-12b5743dca5a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_GroveConflict_Event_StoleIdolAttempt(1) = True
#.   Object:
#.     - CRIME_Allow_Search(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_GroveConflict_IdolCrime:b3f77148-ee3c-e8e6-72f7-12b5743dca5a
msgctxt "h5f5c6441g9e39g4d92g9fa8g35cbc297e9c7"
msgid ""
"*It seems the Idol of Silvanus has been stolen. Choose your next move "
"carefully.*"
msgstr "*실바누스의 우상이 도둑맞은 듯합니다. 당신의 다음 행동을 신중하게 택하세요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_GroveConflict_IdolCrime
#. Speaker = Player
#. NodeID = ca3af89d-c5fe-fe43-dd64-4ebc8266c007
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_GroveConflict_IdolCrime:ca3af89d-c5fe-fe43-dd64-4ebc8266c007
msgctxt "h37dd60fbgf059g45dcg9409g0836a1327909"
msgid "It's in my bag. But if you tell anyone, I'll rip your tongue out."
msgstr "내 가방에 있지. 하지만 네가 가서 알렸다간 혀를 뽑아버릴 줄 알아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_GroveConflict_IdolCrime
#. Speaker = Narrator
#. NodeID = d1f2b692-26a9-995c-0621-2df55f843147
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_GroveConflict_Event_StoleIdolAttempt(1) = True
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_GroveConflict_IdolCrime:d1f2b692-26a9-995c-0621-2df55f843147
msgctxt "h40625c02g3534g4b2eg9336g125b31d20538"
msgid ""
"*Your second attempt has gone no better than the first - you've been caught "
"stealing the idol. The punishment is death.*"
msgstr "*두 번째 시도도 똑같이 실패했습니다. 우상을 훔치다가 걸린 죄의 대가는 죽음입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_NGB_GroveConflict_IdolWarningTheft
#. Speaker = Player
#. NodeID = 3efce009-c34a-4fe7-93b5-c6a4ab8a0304
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_NGB_GroveConflict_IdolWarningTheft:3efce009-c34a-4fe7-93b5-c6a4ab8a0304
msgctxt "hb60c6e1fg72ccg4e77g86d7gd644a06ff01b"
msgid "<i>Apologise. You were mistaken to touch their holy relic.</i>"
msgstr "<i>사과한다. 이들의 성물을 건드린 것은 실수였다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_NGB_GroveConflict_IdolWarningTheft
#. Speaker = Player
#. NodeID = 5b446c37-0c61-4d27-a2ff-7f5dbfd82874
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_NGB_GroveConflict_IdolWarningTheft:5b446c37-0c61-4d27-a2ff-7f5dbfd82874
msgctxt "h73428e00gdbf0g4698ga516g98de1daa7614"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_NGB_GroveConflict_IdolWarningTheft
#. Speaker = Narrator
#. NodeID = 6c019449-c442-9b73-26ba-70a29ea482e7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_GroveConflict_Event_StoleIdolAttempt(1) = True
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_NGB_GroveConflict_IdolWarningTheft:6c019449-c442-9b73-26ba-70a29ea482e7
msgctxt "h2adbad1ag0316g4d0dg9efegf926817593d5"
msgid ""
"*The punishment for tampering with the idol a second time is simple: Death.*"
msgstr "*우상을 두 번씩이나 건드린 죄의 대가는 간단합니다: 죽음입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_NGB_GroveConflict_IdolWarningTheft
#. Speaker = Narrator
#. NodeID = c878ea92-9b7c-1d52-aa1d-8155692ec1f3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_GroveConflict_Event_StoleIdolAttempt(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_NGB_GroveConflict_IdolWarningTheft:c878ea92-9b7c-1d52-aa1d-8155692ec1f3
msgctxt "hcc7fea5fg3447g4a0bg85cdg44b7dfbb0f47"
msgid ""
"*The druids will not stand by while you abscond with their idol. Your next "
"move will decide your fate.*"
msgstr "*드루이드들은 당신이 우상을 훔쳐 가는 걸 보고만 있지 않을 겁니다. 당신의 운명은 당신의 다음 행동에 달려있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_NGB_GroveConflict_IdolWarningTheft
#. Speaker = Narrator
#. NodeID = d1265d44-3bc1-4643-b1b6-e6498c5742e0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_NGB_GroveConflict_IdolWarningTheft:d1265d44-3bc1-4643-b1b6-e6498c5742e0
msgctxt "h27a62dc9g2b48g42d9gacb5g85d4b591239e"
msgid "*You are forgiven - this time.*"
msgstr "*당신은 용서받았습니다. 이번엔 말이죠.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_Thieflings_HideoutTrespassCaught_Crime
#. Speaker = Narrator
#. NodeID = 007e7ec6-d085-475a-f8d5-afe378d2a7fa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_Thieflings_HideoutTrespassCaught_Crime:007e7ec6-d085-475a-f8d5-afe378d2a7fa
msgctxt "h8e140fb1g6750g4296gba82g6cce44734ebe"
msgid ""
"*Your words may be false, but they ring truer than Mol's tales. You're off "
"the hook.*"
msgstr "*거짓말일지는 모르나, 몰의 말보단 더 믿을만 합니다. 당신은 혐의를 벗습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_Thieflings_HideoutTrespassCaught_Crime
#. Speaker = Player
#. NodeID = 0b6f2af9-c563-8190-38ae-6a3b45376efb
#. HandlePath = TaggedText[0].TagText[0]
#. RollType:
#. RollAbility: Charisma
#. DifficultyClass: 12
#. CheckFlags:
#.   Tag:
#.      - WIZARD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_Thieflings_HideoutTrespassCaught_Crime:0b6f2af9-c563-8190-38ae-6a3b45376efb
msgctxt "hf39078cdgec13g4b8bga9b7gf680948bca5e"
msgid ""
"I explore the secrets of the universe. I don't have time to threaten "
"children."
msgstr "난 우주의 신비를 탐구하는 사람이야. 어린애나 협박하고 있을 시간 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_Thieflings_HideoutTrespassCaught_Crime
#. Speaker = Player
#. NodeID = 1c7e937b-27fa-189b-fe12-9e5d8f03eb40
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GEB_Arrest_HavePrison(0) = True
#.   Tag:
#.      - CIVILIAN(0) = False
#.      - BADASSCIVILIAN(0) = False
#. SetFlags:
#.   Object:
#.     - Allow_Arrest(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_Thieflings_HideoutTrespassCaught_Crime:1c7e937b-27fa-189b-fe12-9e5d8f03eb40
msgctxt "h3d345208geae0g48bdg9a98g9bfb89388765"
msgid "<i>Surrender and go to prison.</i>"
msgstr "<i>항복하고 감옥에 간다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_Thieflings_HideoutTrespassCaught_Crime
#. Speaker = Player
#. NodeID = 1d09200d-7130-6a8e-5857-f815f37ad6f8
#. HandlePath = TaggedText[0].TagText[0]
#. RollType:
#. RollAbility: Charisma
#. DifficultyClass: 12
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_Thieflings_HideoutTrespassCaught_Crime:1d09200d-7130-6a8e-5857-f815f37ad6f8
msgctxt "h0fe3da2ag6db3g4f1fg9993gfa8dc4c53838"
msgid "Oh those kids - they're playing a joke on me."
msgstr "아 그 꼬맹이들... 나를 갖고 농담을 한 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_Thieflings_HideoutTrespassCaught_Crime
#. Speaker = Narrator
#. NodeID = 1fbb8bbb-e007-d299-3f0a-8f12968e7dbb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_Thieflings_HideoutTrespassCaught_Crime:1fbb8bbb-e007-d299-3f0a-8f12968e7dbb
msgctxt "hd9853df1g5cc9g4eb5g874cgfcdfc5ac156c"
msgid "*Your claims fall flat. Things could turn ugly here, very rapidly.*"
msgstr "*당신의 주장은 전혀 통하지 않습니다. 분위기가 아주 급속히 나빠집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_Thieflings_HideoutTrespassCaught_Crime
#. Speaker = Narrator
#. NodeID = 212a6043-f102-7c5b-ab29-16738ab0816a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_Thieflings_HideoutTrespassCaught_Crime:212a6043-f102-7c5b-ab29-16738ab0816a
msgctxt "h9b66858eg7fd0g403dg867cg06e3c3de4ad0"
msgid "*Your menacing words fizzle out like a match dropped in a latrine.*"
msgstr "*당신의 위협적인 발언은 변소에 던져진 성냥불처럼 피식 꺼집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_Thieflings_HideoutTrespassCaught_Crime
#. Speaker = Player
#. NodeID = 2172180d-48bf-7b53-6236-a2858db63cbc
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_Thieflings_HideoutTrespassCaught_Crime:2172180d-48bf-7b53-6236-a2858db63cbc
msgctxt "h62472d22g1a19g4d8egbeb0g1f6e033c3cd1"
msgid "<b>YOU </b>CHOOSE. LEAVE OR <b>DIE</b>."
msgstr "<b>네가</b> 선택해 봐. 꺼지든지 <b>뒈지든지</b>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_Thieflings_HideoutTrespassCaught_Crime
#. Speaker = Player
#. NodeID = 225077a8-add7-ad5a-cd5a-31bb9441dbb0
#. HandlePath = TaggedText[0].TagText[0]
#. RollType:
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = False
#.      - ROGUE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_Thieflings_HideoutTrespassCaught_Crime:225077a8-add7-ad5a-cd5a-31bb9441dbb0
msgctxt "h18e7478ag29d4g4cadg8d60gc9ed0bfb8ccc"
msgid "I'm a dab hand at threatening adults as well. Want to see?"
msgstr "난 어른을 협박하는 일에도 달인이지. 한 번 보여줄까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_Thieflings_HideoutTrespassCaught_Crime
#. Speaker = Narrator
#. NodeID = 51df65bb-4023-f19d-6b5f-4d92250ea6c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_Thieflings_HideoutTrespassCaught_Crime:51df65bb-4023-f19d-6b5f-4d92250ea6c0
msgctxt "hce79eb51g7beag4d8cg8e02gee9ad829cd84"
msgid ""
"*Threats landed you in trouble, but more threats have set you free again. "
"Wonderful.*"
msgstr "*위협은 당신에게 문제를 일으켰지만, 더 많은 위협은 당신을 풀어줬습니다. 훌륭하군요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_Thieflings_HideoutTrespassCaught_Crime
#. Speaker = Narrator
#. NodeID = 8401ed23-6664-fafe-7cda-45017f7219f9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_Thieflings_HideoutTrespassCaught_Crime:8401ed23-6664-fafe-7cda-45017f7219f9
msgctxt "h799c6a9fg42a7g48b8g94acgf50cf76a1881"
msgid ""
"*Your lies only inflame the matter further. Things could turn ugly, very "
"rapidly.*"
msgstr "*당신의 거짓말은 문제를 더 키울 뿐입니다. 상황이 매우 빠르게 나빠질 수 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_Thieflings_HideoutTrespassCaught_Crime
#. Speaker = Player
#. NodeID = 9b547225-f661-cedf-b876-a94e66c5c9e0
#. HandlePath = TaggedText[0].TagText[0]
#. RollType:
#. RollAbility: Charisma
#. DifficultyClass: 20
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_Thieflings_HideoutTrespassCaught_Crime:9b547225-f661-cedf-b876-a94e66c5c9e0
msgctxt "ha6e03c3agc2deg4d07g9b6cg63413e9bb709"
msgid "Children? I haven't spoken to any children."
msgstr "아이? 나는 아이와 대화한 적 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_Thieflings_HideoutTrespassCaught_Crime
#. Speaker = Player
#. NodeID = b346c447-2420-3a45-6b78-4655a38076e0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_Thieflings_HideoutTrespassCaught_Crime:b346c447-2420-3a45-6b78-4655a38076e0
msgctxt "h398a954bge778g4958g9856g6c94aeead856"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_Thieflings_HideoutTrespassCaught_Crime
#. Speaker = Narrator
#. NodeID = b739f88a-6f7e-87a6-9705-3cf13a78ef38
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_Thieflings_HideoutTrespassCaught_Crime:b739f88a-6f7e-87a6-9705-3cf13a78ef38
msgctxt "hc08a46eagb058g408cg9ce1g252b7778b7eb"
msgid ""
"*Your attempt at bribery only inflames the matter further. Things could turn "
"ugly, very rapidly.*"
msgstr "*당신의 매수 시도는 오히려 상황을 악화시켰습니다. 분위기가 아주 급속해 나빠집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_Thieflings_HideoutTrespassCaught_Crime
#. Speaker = Player
#. NodeID = cf2e9130-a9ce-85d7-55e2-c5d86af9ad36
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - No Bribiing = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_Thieflings_HideoutTrespassCaught_Crime:cf2e9130-a9ce-85d7-55e2-c5d86af9ad36
msgctxt "h04886611g5ca1g4baag9156gd0df8727b053"
msgid "<i>Resort to bribery.</i>"
msgstr "<i>매수하려 해 본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_Thieflings_HideoutTrespassCaught_Crime
#. Speaker = Narrator
#. NodeID = d05cc065-2c97-a306-ae28-14e3019f5415
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_Thieflings_HideoutTrespassCaught_Crime:d05cc065-2c97-a306-ae28-14e3019f5415
msgctxt "he3e694a6g0729g4d95ga79aga179c9a6b5b3"
msgid ""
"*Your words are heavy with righteousness and sincerity. Enough to get you "
"off the hook, this time.*"
msgstr "*당신의 말은 묵직한 진심과 성실함을 담고 있습니다. 이번 한 번은 당신의 혐의를 벗겨줄 수 있을 정도로요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_Thieflings_HideoutTrespassCaught_Crime
#. Speaker = Narrator
#. NodeID = d109cf19-9c68-8892-3c6b-cf9a6f46884a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_Thieflings_HideoutTrespassCaught_Crime:d109cf19-9c68-8892-3c6b-cf9a6f46884a
msgctxt "h4335f4fag2688g4f4egbb8agf44fce6e8d4b"
msgid ""
"*An unorthodox defence - but one that seems to have worked. You are free to "
"go.*"
msgstr "*독특한 변론방식이지만 어쨌든 통한 것 같습니다. 당신의 혐의는 벗겨졌습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_Thieflings_HideoutTrespassCaught_Crime
#. Speaker = Player
#. NodeID = e67cb4b0-4804-cfd2-54d2-1cc909e53784
#. HandlePath = TaggedText[0].TagText[0]
#. RollType:
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#.      - PALADIN_EVIL(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_Thieflings_HideoutTrespassCaught_Crime:e67cb4b0-4804-cfd2-54d2-1cc909e53784
msgctxt "h07cdf972g7205g490dgbc0cg48be59b50f3f"
msgid "I would <i>never </i>threaten a child. I can't even imagine it."
msgstr "난 <i>절대</i> 아이를 위협하지 않아. 나로선 상상도 못할 일인걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_Thieflings_HideoutTrespassCaught_Crime
#. Speaker = Narrator
#. NodeID = eee032b6-0bcd-9bb2-d063-9ef32f1dc0ea
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_Thieflings_Event_HideoutTrespassCrimeResolved(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_Thieflings_HideoutTrespassCaught_Crime:eee032b6-0bcd-9bb2-d063-9ef32f1dc0ea
msgctxt "h141dcbfag54c1g4405g8607g990fe5ebaa1a"
msgid ""
"*It seems Mol was as good as her word. She's reported that you've been "
"threatening children.*"
msgstr "*몰은 자기 말대로 한 것 같습니다. 그녀는 당신이 아이들을 협박했다고 신고했습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_Thieflings_HideoutTrespassCaught_Crime
#. Speaker = Player
#. NodeID = f484781c-ccbb-e88b-77db-204ba81c5675
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_NGB_Thieflings_HideoutTrespassCaught_Crime:f484781c-ccbb-e88b-77db-204ba81c5675
msgctxt "hb8f9c1d6g9b25g4e5bgb71cg2bcbceff39d0"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_PrisonGuard
#. Speaker = Tilses
#. NodeID = 24484744-fcc5-4c76-acf0-25c721c06cbd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_PrisonGuard_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_PrisonGuard:24484744-fcc5-4c76-acf0-25c721c06cbd
msgctxt "h2d503b0fg1ad7g481eg9f33g7c7c05d3492b"
msgid ""
"You're the one who helped at the gate? Glad to have another sword - we might "
"need it."
msgstr "관문에서 도움을 준 그 사람이구나? 싸울 수 있는 사람이 더 생겨서 좋네. 형편이 안 좋거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_PrisonGuard
#. Speaker = Tilses
#. NodeID = 6a3ee5bd-c441-2f6f-0b53-a07a4a7a9a92
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_RaidingParty_Event_KnockOutTiefling = True
#.      - DEN_RaidingParty_Event_PlayerDidTheKO = True
#. SetFlags:
#.   Dialog:
#.     - DEN_PrisonGuard_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_PrisonGuard:6a3ee5bd-c441-2f6f-0b53-a07a4a7a9a92
msgctxt "h71e465a2ge4bbg42b9g84f1gaa8d46c25127"
msgid ""
"Zevlor says you helped with the goblins. But lay hands on him again, and "
"we'll be having a little chat."
msgstr "네가 고블린 막는 걸 도왔다고 제블로어한테 들었어. 그래도 그분한테 또 손찌검하면 가만 안 있을 줄 알아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_PrisonGuard
#. Speaker = Tilses
#. NodeID = 6b37fa3c-55ca-968f-fac2-8553d008deb1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_PrisonGuard_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_PrisonGuard:6b37fa3c-55ca-968f-fac2-8553d008deb1
msgctxt "hec9e222ag7decg4620g9ee8ge39c937f36b2"
msgid "Keep your steel sharp."
msgstr "늘 대비를 해두도록 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_PrisonGuard
#. Speaker = Tilses
#. NodeID = 8e047ba5-f211-5302-0b06-92e5702b6cb2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_PrisonGuard_HasMet(1) = True
#.   Global:
#.      - DEN_RaidingParty_Event_KnockOutTiefling = True
#.      - DEN_RaidingParty_Event_PlayerDidTheKO = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_PrisonGuard:8e047ba5-f211-5302-0b06-92e5702b6cb2
msgctxt "h7f61b3eeg8652g4848gbfaag96c4266f0282"
msgid "Keep your steel sharp."
msgstr "늘 대비를 해두도록 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = 045022d1-5a25-cab4-9aa7-f17b33eb6e67
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:045022d1-5a25-cab4-9aa7-f17b33eb6e67
msgctxt "he14bebe6g7ff8g44a0g934bg7353a8064df9"
msgid "Both his magic and political sway are forces to be reckoned with."
msgstr "그의 마법과 정치력 모두 가공할만한 힘이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Player
#. NodeID = 04669ce9-817a-c608-e9f3-c3fce7919daa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:04669ce9-817a-c608-e9f3-c3fce7919daa
msgctxt "ha4cfcd87g7dd2g42e0gac4bg6d50ea612ee1"
msgid "There's every chance you'll die on the road."
msgstr "가다가 당신이 죽을 가능성은 얼마든지 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = 0524cf37-a714-d6df-ecee-12c8da38ea24
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:0524cf37-a714-d6df-ecee-12c8da38ea24
msgctxt "hb6957b96g5be1g4ea7g86b5g349e36eadeae"
msgid "You are looking at Lorroakan's newest apprentice."
msgstr "네 앞에 있는 게 바로 로로아칸의 새로운 수습생이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Player
#. NodeID = 07351fdd-f465-d7d3-ffd7-dbf9abfcae40
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PLANAR(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:07351fdd-f465-d7d3-ffd7-dbf9abfcae40
msgctxt "h819f1129g7cb8g495fg9627g5a3742127fda"
msgid ""
"What's so special about Baldur's Gate? Everyone here is so focused on it."
msgstr "발더스 게이트가 그렇게 특별한 곳인가? 다들 거기에 집착하던데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = 09c52afa-faf1-84e7-487a-c82d6763b947
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:09c52afa-faf1-84e7-487a-c82d6763b947
msgctxt "h487ffc65g2250g4cbdga5b6g7c01cde97be7"
msgid ""
"You are in for a treat, my otherworldly friend. There is no city in the "
"Realms like Baldur's Gate."
msgstr "기대해도 좋아, 이계의 친구. 발더스 게이트 같은 도시는 세상 어디에도 없다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Gale
#. NodeID = 0a479a3b-1b47-7518-7238-2f664b1172bb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:0a479a3b-1b47-7518-7238-2f664b1172bb
msgctxt "hcee8a8e4gc474g44bcg9cdegc08efcb83346"
msgid "Merely planning ahead. Besides, never hurts to befriend a wizard."
msgstr "그냥 앞으로의 계획을 세우는 것뿐이야. 게다가, 위저드를 친구 삼아서 나쁠 건 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = 11f17723-5dfe-5511-a42c-7da49b2cfeee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:11f17723-5dfe-5511-a42c-7da49b2cfeee
msgctxt "h7f5410bdg077dg405dg8ee0gb85caf168f42"
msgid "In that case, it is I you should befriend."
msgstr "그렇다면, 나를 친구 삼아야 할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Player
#. NodeID = 13f71fb8-e7c8-3776-101c-05453c84c7c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:13f71fb8-e7c8-3776-101c-05453c84c7c1
msgctxt "hbe4e24b0g1b63g478dgb66fgb22943970bfc"
msgid "Hold on. I'm not sure about this Lorroakan."
msgstr "잠시만. 이 로로아칸이란 자에 대해 확신이 안 서는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = 23acac1c-7666-ae60-abf0-b71a83063031
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:23acac1c-7666-ae60-abf0-b71a83063031
msgctxt "h88cbbdb2g9034g4c8eg91c0g1ede1bc5fcc3"
msgid ""
"I'll be warmly received, besides. You are looking at Lorroakan's newest "
"apprentice."
msgstr "게다가 나는 따뜻한 환대를 받게 될 거라고. 네 앞에 있는 게 바로 로로아칸의 새로운 수습생이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = 288f929f-a4a4-377a-f009-dcdd2cba4bc2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:288f929f-a4a4-377a-f009-dcdd2cba4bc2
msgctxt "h56c53097g828fg46cegba7ega4c2847f7cd1"
msgid ""
"I've admired Lorroakan for <i>years.</i> Never dreamed he'd answer my letter."
msgstr "<i>수년 동안</i> 로로아칸을 동경해 왔다고. 내 편지에 답장을 보낼 줄은 꿈에도 몰랐지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = 28d583b9-0da4-2374-89a6-451988ac1941
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:28d583b9-0da4-2374-89a6-451988ac1941
msgctxt "h4d589c48gcb3bg4469g9bb9gf92065ca67cf"
msgid "Forgive me. Of course someone like you wouldn't know."
msgstr "용서해 줘. 물론 너 같은 사람이 알 리가 없겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = 29210e26-a4e0-674f-879d-595853efae8c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:29210e26-a4e0-674f-879d-595853efae8c
msgctxt "hc1546222g9f2eg40a5g880fg1ad37cf48631"
msgid ""
"Bah. I couldn't abandon her. No matter how prestigious the apprenticeship."
msgstr "흥. 그녈 두고 갈 순 없었어. 견습 기회가 얼마나 중요하던 간에 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Player
#. NodeID = 299545e4-6fca-65bf-7983-66257c890158
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#.      - BALDURIAN(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:299545e4-6fca-65bf-7983-66257c890158
msgctxt "h3b6f0f03gf862g4c06g9494gbf4971284bda"
msgid "There are many things I feel I <i>should </i>know... but I don't."
msgstr "알아야 <i>할</i> 것 같은데... 생각 안 나는 것들이 많아서 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = 2d7ff074-04b1-6598-73e9-6fdc3d638594
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:2d7ff074-04b1-6598-73e9-6fdc3d638594
msgctxt "hf10d8aa3g040ag499bgafe6g4762fc0044c3"
msgid ""
"My apprenticeship with Lorroakan begins shortly. I <i>cannot </i>be late."
msgstr "로로아칸 휘하의 수습생 교육이 곧 시작될 거야. 늦게 갈 수는 <i>없어</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = 2f4572c3-96e8-291c-29d2-0319b694de6a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:2f4572c3-96e8-291c-29d2-0319b694de6a
msgctxt "h9c909c4egfb5bg431agb790g68c42fdc7960"
msgid "Few can match me - in either magic or talent."
msgstr "나와 마법이나 재능으로 견줄 수 있는 자는 많지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = 32e0ef8c-473e-f4cb-dc78-0fd2fa2ad26e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:32e0ef8c-473e-f4cb-dc78-0fd2fa2ad26e
msgctxt "hd2c4f7fdgc4cag4adeg923fgd73381b1e2bc"
msgid "I have been offered an apprenticeship by none other than Lorroakan."
msgstr "다른 누구도 아닌 바로 그 로로아칸에게서 수습생 교육을 제의받았다니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = 36350867-4081-f217-22c5-5ab9d7664e6c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:36350867-4081-f217-22c5-5ab9d7664e6c
msgctxt "hc15547b0ged6ag435agb365gf412158d21cb"
msgid "You don't understand."
msgstr "넌 이해 못해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = 36d7b20e-c5ed-d979-f1a8-cc50a89028a0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:36d7b20e-c5ed-d979-f1a8-cc50a89028a0
msgctxt "hdc4303f1g0208g4604g9924g570aed63c251"
msgid "Common gossip! The by-products of ignorance and jealousy."
msgstr "흔해빠진 음해에 불과해! 무지와 질투의 부산물일 뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = 3af17684-06eb-01ee-98d0-9482069d418b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:3af17684-06eb-01ee-98d0-9482069d418b
msgctxt "hb8eb1beeg84cfg49dag870cg5291ce1ece7c"
msgid "I couldn't agree more."
msgstr "전적으로 동의해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = 3da211c7-2002-e205-03e9-2cefae114fd3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_Inclusion_Gale(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:3da211c7-2002-e205-03e9-2cefae114fd3
msgctxt "hc5cf1562g1794g45d9g8ee6g111313d411a0"
msgid "Yes - that Lorroakan. The greatest wizard in Baldur's Gate."
msgstr "그래. 그 로로아칸 말이야. 발더스 게이트에서 제일가는 위저드지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = 3f934ce4-9ba1-3421-cba1-f26ff1b4be8b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:3f934ce4-9ba1-3421-cba1-f26ff1b4be8b
msgctxt "hae9b1a66g9fabg4b72g8021g95684578e299"
msgid "It is if we end up <i>dead.</i>"
msgstr "그러다 <i>죽으면</i> 실수야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Gale
#. NodeID = 4234eb0e-1bf4-50f6-1247-c57b7560b179
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:4234eb0e-1bf4-50f6-1247-c57b7560b179
msgctxt "h3c3685b8gd273g4b56g92c2g74b139cb8ee8"
msgid ""
"In that case, I'd very much appreciate it if you could arrange an "
"introduction should we reach the city."
msgstr "그렇다면, 도시에 도착해서 그와 만남을 주선해준다면 고맙겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Player
#. NodeID = 42b50db2-06e1-a794-8518-8ab64560b7ee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:42b50db2-06e1-a794-8518-8ab64560b7ee
msgctxt "h1b4e755fgce72g4fcfgaf17g80e74713ea2b"
msgid "We need to go. We have a more pressing problem, remember?"
msgstr "서둘러 가자. 우리한텐 더 중요한 문제가 있잖아, 기억나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = 4809c1e8-8fe0-db83-6bf0-7a0a48182e2c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:4809c1e8-8fe0-db83-6bf0-7a0a48182e2c
msgctxt "h7c97b3b8g6223g4ff2gb72bg5329c6aa583e"
msgid "Few can match him in terms of raw power and talent. Until now, that is."
msgstr "그 사람의 순수한 힘과 재능에 필적할 만한 사람은 거의 없어. 지금까지는 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = 482fb5cd-e174-0011-97c2-2195707c2427
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:482fb5cd-e174-0011-97c2-2195707c2427
msgctxt "h22dc4747gacfdg49c5gb603g929013eccfa6"
msgid ""
"But I've worked myself to the bone for this. Few can match me - in either "
"magic or talent."
msgstr "하지만 난 이를 위해 뼈를 깎는 노력을 기울여 왔어. 마법이든 재능이든, 나와 견줄 수 있는 자는 많지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = 48ac888f-04ce-3819-d387-302ebc44908e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:48ac888f-04ce-3819-d387-302ebc44908e
msgctxt "h0861fbb3gc482g40c2g9283g17653aa9c400"
msgid ""
"From its sights, to its smells, to the fortunes you can make. I myself am "
"set to make history there..."
msgstr "그 광경에, 냄새에, 벌 수 있는 돈에. 난 거기에서 역사를 만들거야..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Player
#. NodeID = 4cb52ba4-ade6-5b80-9b3e-b266cbc05815
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_HALFLING(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:4cb52ba4-ade6-5b80-9b3e-b266cbc05815
msgctxt "h3a22d4d7g0c3fg4e18g8804g66d6cb812b5b"
msgid "Worrying won't help. I'm sure you'll be fine."
msgstr "걱정해봤자 의미 없어. 분명 넌 괜찮을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Player
#. NodeID = 4ce4a8e3-18c5-ca14-6bcf-7125bf1b3919
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - MONK(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:4ce4a8e3-18c5-ca14-6bcf-7125bf1b3919
msgctxt "hb894f2c2g2e8ag4139gba6cg54e99bbf244f"
msgid "Perhaps the right master can rid you of your arrogance."
msgstr "알맞은 스승을 만나기만 한다면 네 오만함을 해결할 수 있을지도 모르지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = 554e63fb-08af-7a58-03a6-0a42c434e2c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:554e63fb-08af-7a58-03a6-0a42c434e2c0
msgctxt "hb7fd1204g330fg4449ga8e9g57aaeb4c9fd8"
msgid ""
"This place, and its people, are lost. The only way we'll make it to Baldur's "
"Gate is on our own."
msgstr "여기, 그리고 여기 사람들은 이미 끝났어. 발더스 게이트에는 우리끼리 가야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Player
#. NodeID = 565f5342-78c2-cf09-599e-993e1d4fd8f7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:565f5342-78c2-cf09-599e-993e1d4fd8f7
msgctxt "h42978ddbg5111g4162gae60g3003fde8bc20"
msgid "If you want to go, then <i>go.</i>"
msgstr "가고 싶다면, <i>가.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Gale
#. NodeID = 57bb8c1a-fb1d-55cf-16f9-778be1945a22
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GALE(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:57bb8c1a-fb1d-55cf-16f9-778be1945a22
msgctxt "h62d85be4ge892g4b18g80cbgafb852b20df2"
msgid ""
"I've heard that name before. A young man, yes? Lives in Ramazith's Tower in "
"the Upper City?"
msgstr "그 이름 들어본 적이 있어. 젊은 남자 맞지? 상부 도시에 있는 라마지스의 탑에서 살고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = 5ddaa891-d7dc-6d96-69dd-a73d594a4366
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:5ddaa891-d7dc-6d96-69dd-a73d594a4366
msgctxt "hccb29195gfb85g48adg878egce27bbcba687"
msgid ""
"If it's powerful acquaintances you're after, you have to look no further "
"than yours truly."
msgstr "강력한 사람과의 친분을 원한다면, 더 찾아볼 것도 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = 5de3875c-4ca0-ffcb-9793-a9ed03a5b4dd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:5de3875c-4ca0-ffcb-9793-a9ed03a5b4dd
msgctxt "h83786370gd08eg4fbeg8a50gdac534a49946"
msgid "The very same!"
msgstr "맞아! 그 사람이야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = 5eaa3f90-d816-21b9-3ae1-1d4de1cdbdb2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:5eaa3f90-d816-21b9-3ae1-1d4de1cdbdb2
msgctxt "h37673c6cg7a76g4465g8e94gc0f372c3503b"
msgid "Other than a desire to avoid impending death?"
msgstr "임박한 죽음을 피하고 싶다는 욕구 외에 말이야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = 5f956d62-3ade-3117-ceed-05cee291c3a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:5f956d62-3ade-3117-ceed-05cee291c3a7
msgctxt "h95f74a7bgfcb9g4de3gb825g44048ef2a92a"
msgid "I don't believe in sacrifices for a lost cause."
msgstr "무의미한 일로 스스로를 희생하는 건 바보 같은 짓이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Player
#. NodeID = 600d5c48-e2d4-3603-d639-c9635444b7e5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:600d5c48-e2d4-3603-d639-c9635444b7e5
msgctxt "hf820c251g608bg412eg999egc49f8fa99eb7"
msgid "Good idea: powerful acquaintances never hurt."
msgstr "좋은 생각이야, 강력한 사람과 친분을 얻어서 나쁠 건 없지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Player
#. NodeID = 605950a2-b1ee-3c01-3217-3dd147b5f1f2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_TIEFLING(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:605950a2-b1ee-3c01-3217-3dd147b5f1f2
msgctxt "h82202567gfa82g48fdg85ddgb0975c573de8"
msgid "So eager to go to Baldur's Gate - do they even welcome tieflings?"
msgstr "발더스 게이트에 가고 싶어서 안달이 났군, 거기서 티플링을 환영하긴 해?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = 62a6c312-cbac-443d-7b69-39dace29ea95
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:62a6c312-cbac-443d-7b69-39dace29ea95
msgctxt "h40d8f4dbg0720g429dg8435g2b6dc4fce1b2"
msgid "His name is known far and wide, I see."
msgstr "보아하니 그의 이름이 널리 퍼진 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = 6644f592-4548-6ea9-1d2e-ba65c24a3790
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:6644f592-4548-6ea9-1d2e-ba65c24a3790
msgctxt "he4ad0c57g54e3g408ag8555gbcb9e4c70231"
msgid "And I think one of her is quite enough in my life. Good day to you."
msgstr "내 삶에 그런 사람은 하나면 충분하거든. 그럼 안녕."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Player
#. NodeID = 668a0bf3-be4b-3a73-cb87-558f2b0e74af
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Prodigy_Event_ToldToLeave(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:668a0bf3-be4b-3a73-cb87-558f2b0e74af
msgctxt "h5d29d5d2gf3d9g4460g951bg18cafbb55ef4"
msgid "You're cheerful for someone about to abandon his kin."
msgstr "동족을 버리려는 사람치고는 신나 보이는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = 67747e3b-0a24-09c2-3f17-8ab17a2a9e31
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Prodigy_HasMet(1) = False
#.   Global:
#.      - DEN_Prodigy_State_Staying = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Prodigy_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:67747e3b-0a24-09c2-3f17-8ab17a2a9e31
msgctxt "hf0a34c56g9313g4af4ga8f7gc513d9588b58"
msgid "We should have left by now. Damnation."
msgstr "지금쯤이면 떠났어야 했는데. 제기랄."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Player
#. NodeID = 68cda123-2a28-9628-726d-fa565e8af366
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BALDURIAN(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:68cda123-2a28-9628-726d-fa565e8af366
msgctxt "h04823bc6g4ee9g4650g856fge02e3c1b3b06"
msgid "Never heard of him. Who is he?"
msgstr "들어본 적 없는걸. 누군데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = 6b12f09e-71fb-db93-af80-ec023ac9a88a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Prodigy_HasMet(1) = True
#.   Global:
#.      - DEN_Prodigy_State_Leaving = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:6b12f09e-71fb-db93-af80-ec023ac9a88a
msgctxt "hc48b2fb9g72a1g46c7g8c53gfc16c01204f9"
msgid "I wonder what Lorroakan will have me do first? Complex magic, no doubt."
msgstr "로로아칸은 내게 어떤 것부터 하라고 할까? 복잡한 마법이겠지, 분명."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Player
#. NodeID = 6d940925-49e0-f8cb-f031-dbf2b04ded64
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(1) = False
#.      - BALDURIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:6d940925-49e0-f8cb-f031-dbf2b04ded64
msgctxt "h0416cb2bga970g457cgbc01ge521d6b9ceb9"
msgid "Is this Lorroakan of Ramazith's Tower?"
msgstr "라마지스의 탑에 있는 그 로로아칸 말이야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Player
#. NodeID = 6eb10200-4f35-d3d1-bc07-d5e28ed06772
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:6eb10200-4f35-d3d1-bc07-d5e28ed06772
msgctxt "hd66253f5g4bb0g4fc3gafdag75c5850905f6"
msgid "Leave on your own. Why wait?"
msgstr "혼자 떠나면 되잖아. 뭘 기다리고 있는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = 7076b345-2d35-8065-b2f2-8f02523ef598
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Prodigy_HasMet(1) = False
#.   Global:
#.      - DEN_Prodigy_State_Leaving = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Prodigy_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:7076b345-2d35-8065-b2f2-8f02523ef598
msgctxt "h96fa8f0bgaf94g443fgadf1g4c84bf648783"
msgid ""
"I can spare but a moment - Baldur's Gate awaits! Oh, I can almost <i>smell</"
"i> the city."
msgstr "더는 못 기다리겠어. 발더스 게이트가 기다린다고! 아. 벌써 그 도시의 <i>냄새</i>가 느껴지려고 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = 710668b8-a3b8-c6d8-d21b-f4c3cc216454
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:710668b8-a3b8-c6d8-d21b-f4c3cc216454
msgctxt "hfff3990fgec26g4bb3g999age8f30c4b17a1"
msgid ""
"As if I would be found in such a place. No, I am destined for greater things."
msgstr "애초에 난 그런 곳엔 가지 않아. 아니, 난 훨씬 위대한 운명을 타고났어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = 71fc0274-30e6-2352-3df7-2e7eee617f07
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:71fc0274-30e6-2352-3df7-2e7eee617f07
msgctxt "hf0ad3981g600eg447eg832eg9a5ce694dc2d"
msgid "We're leaving for Baldur's Gate. And <i>we</i> will make it."
msgstr "우린 발더스 게이트로 떠날 거야. <i>우리</i>는 거기 도착할 거라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Player
#. NodeID = 72cf1151-82cd-cc71-92a5-490b7689cc6a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Prodigy_State_Staying = True
#. TagRule: !REALLY_TIEFLING
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:72cf1151-82cd-cc71-92a5-490b7689cc6a
msgctxt "h09bb5ecfgc41cg4481g9dabg7a67af1f3e8f"
msgid "You're doing the right thing. The tieflings need help."
msgstr "옳은 일을 하고 있는 거야. 이 티플링들은 도움이 필요해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Player
#. NodeID = 72cf1151-82cd-cc71-92a5-490b7689cc6a
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Prodigy_State_Staying = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:72cf1151-82cd-cc71-92a5-490b7689cc6a
msgctxt "h9fb6fc6fg4dbbg4d14g91b9g3f1b4a8427e8"
msgid "You're doing the right thing. The others need help."
msgstr "옳은 일을 하고 있는 거야. 다른 이들은 도움이 필요해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = 7394ee05-fff8-e725-a3e0-033401d7697e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:7394ee05-fff8-e725-a3e0-033401d7697e
msgctxt "h622a68e9g3bf8g4497ga0cbgc71e24044994"
msgid "That is tempting..."
msgstr "그것도 끌리긴 하는데..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Player
#. NodeID = 757020d5-269b-7dc8-d036-ab6b5134019c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:757020d5-269b-7dc8-d036-ab6b5134019c
msgctxt "hb2f2c728g4eddg40e0g8844g2186878012c1"
msgid "You don't wish to help your fellow tieflings?"
msgstr "티플링 친구들을 돕고 싶지는 않은건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Player
#. NodeID = 7acd3171-7dad-3a2a-3f8b-2df87c09c1d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:7acd3171-7dad-3a2a-3f8b-2df87c09c1d0
msgctxt "h3ac391e4g1a96g4295gaa17gbbf4e565d7a0"
msgid "Are you always this selfish?"
msgstr "원래 그렇게 이기적인가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = 847d1dae-0233-543d-eefd-e6372c908755
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:847d1dae-0233-543d-eefd-e6372c908755
msgctxt "hd1969918g532fg499bgb58egf0f41664a842"
msgid "I'm to study under Lorroakan, you see."
msgstr "보다시피, 로로아칸 밑에서 공부할 몸이거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = 88f97709-a176-6524-8ba3-d3ba2a284702
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:88f97709-a176-6524-8ba3-d3ba2a284702
msgctxt "h8bef7d9ag75feg40e8g98a5g11a6b18f5cce"
msgid ""
"Yes - that Lorroakan. The greatest wizard in Baldur's Gate. This will change "
"<i>everything. </i>"
msgstr "그래. 그 로로아칸 말이야. 발더스 게이트에서 제일가는 위저드지. 이건 <i>모든 걸</i> 바꿔놓을 거라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = 8a70e3c3-6189-613a-e96f-fd560d3c6d40
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:8a70e3c3-6189-613a-e96f-fd560d3c6d40
msgctxt "haba0a7d2g2cf7g4067ga4fbgd0144bac05ad"
msgid "Please - this is confidence, not arrogance."
msgstr "이봐, 이건 오만이 아니라 자신감이라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Player
#. NodeID = 8e03a6ee-34db-aa3b-de91-921399f20172
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:8e03a6ee-34db-aa3b-de91-921399f20172
msgctxt "h142ed125g5285g4005gbceeg5e0b93a54cd0"
msgid "Why the rush to leave?"
msgstr "왜 그리 서둘러 떠나려는 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = 92b9bf81-06e6-17ec-922c-134db871fef1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:92b9bf81-06e6-17ec-922c-134db871fef1
msgctxt "he36c9291g667bg465bg9c3agd1505a6c2fec"
msgid ""
"Don't be fooled by mere gossip! The by-products of ignorance and jealousy."
msgstr "소문 따위에 놀아나지 마! 무지와 질투의 산물일 뿐이니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = 9853d855-9b10-c524-3f06-2c71b85e7c56
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:9853d855-9b10-c524-3f06-2c71b85e7c56
msgctxt "h63e6511ag70ceg410cgaba3g93e74ce18159"
msgid ""
"And what about us? There's every chance we've doomed ourselves by helping "
"these people."
msgstr "그럼 우리는 어쩌고? 이 사람들을 도울 때마다 우리 운명을 파멸로 몰아가고 있는 것일 수도 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = 9d80040f-956d-c0fd-66f9-37d074c28fdd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:9d80040f-956d-c0fd-66f9-37d074c28fdd
msgctxt "h35e7ab42gbee0g4398gb60bgd7a7f6bd2138"
msgid "And we <i>will </i>make it. I know it."
msgstr "그리고 우린 <i>반드시</i> 도착할 거야. 확신해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Player
#. NodeID = 9e25a645-6315-e844-5663-e1364d10ef54
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:9e25a645-6315-e844-5663-e1364d10ef54
msgctxt "hc47600f3g0345g4d46gab95g226cd01da34c"
msgid "Standing by your people is never a mistake."
msgstr "동족과 함께 하는 것은 절대 실수가 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = a3e5046b-5a33-0020-3a2f-3ba1d4f95654
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:a3e5046b-5a33-0020-3a2f-3ba1d4f95654
msgctxt "h052d167ag1fe9g4a26g8dbag8f4a063aa6ed"
msgid ""
"... as apprentice to Lorroakan, the greatest wizard in Baldur's Gate. This "
"will change <i>everything.</i>"
msgstr "... 로로아칸의 수습생으로서 말이야. 발더스 게이트에서 제일가는 위저드 말이지. 이건 <i>모든 걸</i> 바꿔놓을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Player
#. NodeID = aa245b4a-9c09-5ff0-3f65-37824888bfb3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SELDARINEDROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:aa245b4a-9c09-5ff0-3f65-37824888bfb3
msgctxt "h69491472ga244g4849g8b83gc1e2a6530373"
msgid "You're leaving? Good. Save your own skin to fight another day."
msgstr "떠나려는 건가? 좋아, 하루 더 살아야 하루 더 싸울 수 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = accde182-9935-a7f3-623d-5d48acfd6e84
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:accde182-9935-a7f3-623d-5d48acfd6e84
msgctxt "h102c3f45g2c55g49d4ga18dg45be100d419b"
msgid ""
"More than most. A few strangers may stare - but they'll keep their daggers "
"sheathed."
msgstr "다른 곳들보다야. 쳐다보는 사람은 있겠지만, 단검을 뽑진 않을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = ae5285ef-5d69-d68b-279c-9faac1d2b810
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:ae5285ef-5d69-d68b-279c-9faac1d2b810
msgctxt "h1b6d4efdg9c84g4049gb703g9b3e053f6ad7"
msgid "I cannot leave Lorroakan waiting."
msgstr "로로아칸이 기다리게 할 수는 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Player
#. NodeID = b1229837-f019-41cb-74f9-8457b5898b42
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:b1229837-f019-41cb-74f9-8457b5898b42
msgctxt "hf558102ag93bcg4b20gb305gacc9bd4ce23e"
msgid "Hold on. Why are you so eager to reach the city?"
msgstr "잠깐만. 왜 그렇게 도시에 가고 싶어서 안달하는 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = b1be4c7a-3dad-e0db-9cdc-cde42fdb3f61
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:b1be4c7a-3dad-e0db-9cdc-cde42fdb3f61
msgctxt "h553aa89agf2beg426eg8fc3gb3d7f4e98556"
msgid ""
"In years to come, you will boast of this meeting - I can assure you. May we "
"meet again in Baldur's Gate, my friend."
msgstr "몇 년만 지나면 넌 이 만남을 자랑하고 다니게 될 거야. 장담하지. 발더스 게이트에서 다시 만나자고, 친구."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = b31b12f0-d706-09c6-bcb1-28f043982c20
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:b31b12f0-d706-09c6-bcb1-28f043982c20
msgctxt "ha106a8d2g9d4fg4268g81d5g6ca604f5d26c"
msgid "Of course <i>I</i> will be. As if there was any doubt."
msgstr "당연히 <i>난</i> 괜찮겠지. 당연한 소리를 하고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Player
#. NodeID = b5c34d01-23e6-822b-41de-5953d0ef7708
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:b5c34d01-23e6-822b-41de-5953d0ef7708
msgctxt "h71141a28g9520g4bdeg814bg0117235a770b"
msgid "Run, then. And run <i>scared</i>."
msgstr "그러면 도망쳐라. <i>공포에 질려서</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = b71665c6-11a3-457b-b1d5-626e7e60095e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BESTIAL(1) = False
#.      - PLANAR(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:b71665c6-11a3-457b-b1d5-626e7e60095e
msgctxt "hd14afd73gb4deg44abg8225ga21ba35c9c5d"
msgid "What? You don't know of him? I've admired him for <i>years.</i>"
msgstr "뭐? 로로아칸을 몰라? 내가 <i>수년간</i> 동경해온 사람이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Player
#. NodeID = bc1a68a9-63d6-9e34-d8bc-5a19bff28161
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BALDURIAN(1) = True
#. TagRule: REALLY_DARK_URGE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:bc1a68a9-63d6-9e34-d8bc-5a19bff28161
msgctxt "h3eed6933gf4dcg49a5ga6e2ge3c1a1bd61f7"
msgid "I think I've heard stories about Lorroakan. Bad ones."
msgstr "로로아칸이라고 하면 들은 이야기가 몇 있긴 한데. 안 좋은 이야기가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Player
#. NodeID = bc1a68a9-63d6-9e34-d8bc-5a19bff28161
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BALDURIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:bc1a68a9-63d6-9e34-d8bc-5a19bff28161
msgctxt "h62bacc97g2e3ag4c9dg884dg910394d859e8"
msgid "I've heard stories about Lorroakan - not all of them good."
msgstr "로로아칸에 대한 이야기를 좀 들었는데, 다 좋은 얘기들은 아니더군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Player
#. NodeID = bcccb5a4-5a3b-132b-aa4f-609aa75c8d27
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:bcccb5a4-5a3b-132b-aa4f-609aa75c8d27
msgctxt "h743c09d9g2e69g4b58g8d58gee8675ad38f3"
msgid "You sound excited."
msgstr "신나 보이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Player
#. NodeID = c01c8b12-cae9-49cc-9782-1fc1e0d90e29
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Prodigy_Event_ToldToLeave(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:c01c8b12-cae9-49cc-9782-1fc1e0d90e29
msgctxt "hd4a77a9bgd991g489agacd3gdb551d076b05"
msgid "You made the right choice. This place isn't safe."
msgstr "옳은 선택을 한 거야. 여긴 안전하지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = c23a4d57-5452-15af-40cd-f2fd3b3ef189
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:c23a4d57-5452-15af-40cd-f2fd3b3ef189
msgctxt "ha9fcd00fgfb50g46e2ga128g98d62aaa06e7"
msgid "Tch. You're as bad as Lia."
msgstr "쯧, 너도 리아만큼 글러먹었구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = c3bcb80c-458d-6916-ae92-7079099e6715
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:c3bcb80c-458d-6916-ae92-7079099e6715
msgctxt "hb19abd9ag50b7g4f59g8c90g8886cc70e029"
msgid "... but I could never leave Lia behind, as irksome as she may be."
msgstr "...하지만 리아를 두고 갈 순 없어. 귀찮기는 하지만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = c73cc94b-751d-025e-c345-9cedb575bdd1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:c73cc94b-751d-025e-c345-9cedb575bdd1
msgctxt "hc5aef69dg97e2g4505g8d0fg8fa2fd11c2e7"
msgid ""
"Our best chance to make it to Baldur's Gate is on our own. This place is "
"lost."
msgstr "발더스 게이트로 갈 최선의 방법은 그냥 우리끼리 가는 거라고. 여긴 틀렸어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = d0646d8c-7711-2296-45ec-fce32d5d53d5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:d0646d8c-7711-2296-45ec-fce32d5d53d5
msgctxt "h2b515d58gee1fg44fcgb4aage40847fd1644"
msgid ""
"We <i>must</i> leave soon. My apprenticeship with the wizard begins shortly."
msgstr "우린 <i>반드시</i> 빨리 떠나야 해. 위저드 수습생 교육이 곧 시작된다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Player
#. NodeID = d0c834a9-9a5f-011f-611a-5e08244dc15c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BALDURIAN(1) = True
#. TagRule: REALLY_DARK_URGE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:d0c834a9-9a5f-011f-611a-5e08244dc15c
msgctxt "h7c17f37ege281g4f71gb905g585fbe9808d3"
msgid ""
"I've forgotten much. But I could never forget the aroma of the Outer City."
msgstr "많은 것을 잊었지만, 외부 도시의 냄새만큼은 잊히지 않는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Player
#. NodeID = d0c834a9-9a5f-011f-611a-5e08244dc15c
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BALDURIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:d0c834a9-9a5f-011f-611a-5e08244dc15c
msgctxt "hfa37a413gedabg4a20g8645g6dee5d425ab0"
msgid "The aroma of the Outer City is pretty unique."
msgstr "외부 도시 냄새가 또 독특하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = d14e1566-2b43-198b-0616-b6a95573c096
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:d14e1566-2b43-198b-0616-b6a95573c096
msgctxt "h4d633eafg869bg4301ga4c2gb555fd16f460"
msgid "Quite right. Lia can be stubborn at times."
msgstr "맞는 말이야. 리아도 가끔 보면 고집이 세다니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Player
#. NodeID = d4371ec4-5dab-6c8a-867b-517cd7dd24a2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:d4371ec4-5dab-6c8a-867b-517cd7dd24a2
msgctxt "hc7c7eca3g490fg45f6g8e62g7fd9e13c22fa"
msgid "Why burden yourself with companions? You should slip away - alone."
msgstr "동료를 신경 쓰는 이유가 뭐지? 혼자 빠져나갈 수 있을 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = d7de1e8d-212d-637c-f941-9c974ed7b1b8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:d7de1e8d-212d-637c-f941-9c974ed7b1b8
msgctxt "h576cd6abg0868g485bg9182g1d33cd1d1617"
msgid ""
"The names 'Rolan' and 'Lorroakan' will be known far and wide. You'll see."
msgstr "'롤란'과 '로로아칸'이라는 두 이름이 널리 떨치게 될 거야. 두고 보라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = dbea0ffc-fa39-4bf9-a1f0-cf862277ea5d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:dbea0ffc-fa39-4bf9-a1f0-cf862277ea5d
msgctxt "h47ba66a4gb64bg4704ga248g2ad39b1fa932"
msgid ""
"If we stop and help every wounded foal, we'll end up dead, or worse. Lia "
"just can't see it."
msgstr "다친 망아지를 볼 때마다 일일히 멈춰서 도와주면, 우린 결국 죽거나, 더한 꼴을 당하게 될 거야. 리아는 그냥 그걸 몰라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Player
#. NodeID = e1bfba96-baa9-7c8b-704f-b1c2e58bbb7f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_HALFLING(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:e1bfba96-baa9-7c8b-704f-b1c2e58bbb7f
msgctxt "hce5378d0g722fg4653gb377g1ce76840e45e"
msgid "I've heard the Elfsong Tavern makes a mean bowl of stew."
msgstr "엘프송 주점의 스튜가 그렇게 맛있다던데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = e34963ab-9484-6ae3-d7de-a53a3b6421af
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:e34963ab-9484-6ae3-d7de-a53a3b6421af
msgctxt "h53b22095g30c0g4711gb7d8ge1bd8f354f39"
msgid "Please. I can handle myself. It's others that are the issue."
msgstr "이봐, 내 앞가림은 할 줄 알거든. 문제는 다른 녀석들이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = e5420fde-205b-2b24-c928-0370e9eddba0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:e5420fde-205b-2b24-c928-0370e9eddba0
msgctxt "h4334db4fgb118g4d51g980cg549ce1f3737a"
msgid "But thank you for your concern. It was touching."
msgstr "그래도 걱정해 줘서 고마워. 참 감동적이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = e8d8786b-96dd-015c-112a-352978a82f6f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:e8d8786b-96dd-015c-112a-352978a82f6f
msgctxt "hcab1b8cagef62g4fbfga920g3bf7fb72c5d0"
msgid ""
"We will end up fodder for some goblin's blade - all because Lia insists on "
"helping every wounded foal we see."
msgstr "우린 고블린 칼날의 먹잇감이 되어버릴 거라고. 그 이유는 리아가 부상당한 새끼들을 볼때마다 도와주자고 하고 있어서야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = e9762758-cb9e-bc2b-7e01-8736cb9682d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:e9762758-cb9e-bc2b-7e01-8736cb9682d0
msgctxt "h235d0721gb49fg4d79g8452g9eacac4ba892"
msgid "Common gossip! The by-products of ignorance and jealousy."
msgstr "흔해빠진 음해에 불과해! 무지와 질투의 부산물일 뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Player
#. NodeID = e9a3e6c9-7a00-3d93-455b-7280cf7db414
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WIZARD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:e9a3e6c9-7a00-3d93-455b-7280cf7db414
msgctxt "h5b2ae3a8g95d2g4147gb12dg195e3ebce61e"
msgid "I've heard he's quite the scoundrel."
msgstr "그 사람 무척 불한당이라고 들었는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = eae4c2ba-5a58-b7ec-9598-11597979532a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:eae4c2ba-5a58-b7ec-9598-11597979532a
msgctxt "h6b7bbe4eg0607g4243gb7e8gd3ed88f20259"
msgid ""
"Of course he is! The greatest spellcaster along the Sword Coast. As if I'd "
"settle for a lesser mentor."
msgstr "물론이지! 소드 코스트 전역에서 가장 뛰어난 주문시전자야. 그런 이가 아니라면 내가 배움을 얻으러 갈 이유가 없지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = f15f54dd-4c3a-53ad-57d1-5cab2672cbdc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:f15f54dd-4c3a-53ad-57d1-5cab2672cbdc
msgctxt "ha8ad6566g36d9g41a5gabb4g6907107ae228"
msgid ""
"Instead we're just <i>sitting</i> here - practically begging to be attacked. "
"Staying is a mistake."
msgstr "그런데 여기서 그냥 <i>앉아</i>나 있다니, 공격해달라고 빌고 있는 거나 마찬가지야. 머무르는 건 실수라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = f4dcc2ea-ba44-9c93-d1e3-5c0c9c03f727
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Prodigy_HasMet(1) = True
#.   Global:
#.      - DEN_Prodigy_State_Staying = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:f4dcc2ea-ba44-9c93-d1e3-5c0c9c03f727
msgctxt "h8b2cfe03g028dg48eega1a2g57143b5d75a2"
msgid "My Thunderwave will make quick work of any goblin - just you wait."
msgstr "내 천둥파가 어떤 고블린이든 처리할 거야. 보기나 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = f5440663-1511-14e1-9591-8b92dcfa29e3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:f5440663-1511-14e1-9591-8b92dcfa29e3
msgctxt "h8d48b33eg7132g498dga89bg4587f69bb812"
msgid ""
"If only she understood. The longer we wait, the longer the horrors of the "
"wilds imperil us."
msgstr "그녀가 이해하기만 한다면 좋을 텐데. 우리가 기다릴수록, 야생의 공포가 우리를 위협하는 시간이 길어져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Player
#. NodeID = f66068c3-afa9-04c9-9df2-e72d0bbd8506
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:f66068c3-afa9-04c9-9df2-e72d0bbd8506
msgctxt "hbd91198cgee29g44dega5bagb91a863a83fe"
msgid "Baldur's Gate isn't going anywhere. Why the hurry?"
msgstr "발더스 게이트가 어디 가기라도 해? 왜 그렇게 서둘러?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = f6f2b684-d9d8-7575-6d4b-61aa67b387ab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:f6f2b684-d9d8-7575-6d4b-61aa67b387ab
msgctxt "hfcd74ba6gf45eg4268gae9fgad5905dec665"
msgid ""
"Rest assured, the names 'Rolan' and 'Lorroakan' will be known to you soon "
"enough. You'll see."
msgstr "내 장담하건대, '롤란'과 '로로아칸'이라는 두 이름이 네게도 알려지게 될 거야. 두고 보라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Gale
#. NodeID = f7132e64-4bd1-5172-0793-2c3e44ed9c2f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:f7132e64-4bd1-5172-0793-2c3e44ed9c2f
msgctxt "ha3ef36d0g4c4bg4a95g80dfg987504663bed"
msgid ""
"Word in Waterdeep has it he's a bit of a cad. But you say he's an "
"accomplished wizard?"
msgstr "워터딥에서 도는 소문에 의하면 좀 비열한 사람이라던데. 그런데 뛰어난 위저드라고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Player
#. NodeID = f7d4dac9-b947-1970-bf11-b14cf455bf76
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:f7d4dac9-b947-1970-bf11-b14cf455bf76
msgctxt "h81db5c91ga855g4dc7gbbf4ga8d960f1e12d"
msgid "Why the rush to leave?"
msgstr "왜 그렇게 서둘러서 떠나는 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy
#. Speaker = Rolan
#. NodeID = fc0fefbe-e53d-685c-92c7-698151c3a69e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy:fc0fefbe-e53d-685c-92c7-698151c3a69e
msgctxt "h184af6f2ga13ag4ce9g927fg549f9f955ead"
msgid "Well, you're here, aren't you? You can help them if you want."
msgstr "뭐, 네가 여기 있잖아, 안 그래? 네가 원한다면 그들을 도울 수 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD
#. Speaker = Rolan
#. NodeID = 0279249e-909c-790f-76fb-b460f00d6a7f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD:0279249e-909c-790f-76fb-b460f00d6a7f
msgctxt "hc76525b0gbae5g4a14g91f5g92c95739edef"
msgid "I am <i>not </i>grumpy."
msgstr "난 심술 <i>안 났어</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD
#. Speaker = Rolan
#. NodeID = 042d8729-1b1a-aefa-f938-a19ffce1e015
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD:042d8729-1b1a-aefa-f938-a19ffce1e015
msgctxt "h508a7381gda7ag41b5g8523gae5aa37e4cad"
msgid "You're going to get us killed!"
msgstr "그러다 우리까지 다 죽어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD
#. Speaker = Cal
#. NodeID = 07f75afd-916e-006c-a5c1-e75c31f7a61b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD:07f75afd-916e-006c-a5c1-e75c31f7a61b
msgctxt "h72ff1ffbg72f3g4b5dg9542g0fd727ae9a56"
msgid "Can we stop shouting? No?"
msgstr "소리 좀 그만 치면 안 돼? 응?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD
#. Speaker = Lia
#. NodeID = 0f047829-a257-19d0-97b1-2b1ce1ecea45
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Prodigy_State_Staying = False
#.      - DEN_Prodigy_State_Leaving = False
#.   Local:
#.      - 12c3bf70-6622-e9db-0f6a-7ed590fd0039_P1 = False
#. SetFlags:
#.   Local:
#.     - 12c3bf70-6622-e9db-0f6a-7ed590fd0039_P1 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD:0f047829-a257-19d0-97b1-2b1ce1ecea45
msgctxt "ha4607060g0a1bg49fega0fbg63ce2f5ec8c7"
msgid "This is about your <i>precious</i> Baldur's Gate."
msgstr "넌 그 <i>잘난</i> 발더스 게이트 가는 데 급급한 거잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD
#. Speaker = Rolan
#. NodeID = 16c9f137-e56f-60e8-e024-5647870758b9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD:16c9f137-e56f-60e8-e024-5647870758b9
msgctxt "h6585d828gdc60g4d39gb279g596b0ce947c1"
msgid "Of course it does. You would choose strangers over us!"
msgstr "당연히 중요하지. 우리보다 생판 남을 챙기겠단 거니까!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD
#. Speaker = Rolan
#. NodeID = 2c04bcf1-6ef0-5354-6b0a-efd083f93a1a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD:2c04bcf1-6ef0-5354-6b0a-efd083f93a1a
msgctxt "hb6d15880g8c3cg4aacgb4e9gc3d0ac88af7e"
msgid "Depends. How often are you going to ask that?"
msgstr "상황에 달렸지. 그 질문 대체 몇 번이나 할 셈이야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD
#. Speaker = Lia
#. NodeID = 2f71df29-331d-9bda-0d16-38fe3e51975d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD:2f71df29-331d-9bda-0d16-38fe3e51975d
msgctxt "h968b61a9g553dg4ba1gb385g6199c357d1ac"
msgid "Depends. How many people are dumb enough to ask?"
msgstr "상황에 달렸지. 그거 보여달라 졸라댈 바보가 얼마나 있을까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD
#. Speaker = Cal
#. NodeID = 32c5ea33-fd30-89a1-9689-8c6adf1e7cf3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Prodigy_State_Staying = False
#.      - DEN_Prodigy_State_Leaving = True
#.   Local:
#.      - 12c3bf70-6622-e9db-0f6a-7ed590fd0039_P2 = True
#. SetFlags:
#.   Local:
#.     - 12c3bf70-6622-e9db-0f6a-7ed590fd0039_P2 = False
#.     - 12c3bf70-6622-e9db-0f6a-7ed590fd0039_P1 = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD:32c5ea33-fd30-89a1-9689-8c6adf1e7cf3
msgctxt "h824ce1c5g0593g420dgbab9g7776184fd8ef"
msgid "How long will it take to get to Baldur's Gate?"
msgstr "발더스 게이트까지 얼마나 걸릴까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD
#. Speaker = Lia
#. NodeID = 368e664d-67a3-f289-c2d4-5e86a7ef8322
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD:368e664d-67a3-f289-c2d4-5e86a7ef8322
msgctxt "h33bc2734ga5eeg4ccfg8569g8d48edb84a87"
msgid "That doesn't matter."
msgstr "그런 건 중요하지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD
#. Speaker = Cal
#. NodeID = 3d8474d1-be18-9378-d384-89eb2db7fa2b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD:3d8474d1-be18-9378-d384-89eb2db7fa2b
msgctxt "hd5376a5cg5d55g4adcga78bgfdfbe93460a6"
msgid "The scowl on your face would frighten a troll."
msgstr "그 팍 찌푸린 얼굴 보면 트롤도 놀라자빠질걸?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD
#. Speaker = Rolan
#. NodeID = 3ff0bde1-3655-0481-7ff4-08b4d60be429
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD:3ff0bde1-3655-0481-7ff4-08b4d60be429
msgctxt "h49a2ecb3g6ee5g40ffg8bf5g76739a194730"
msgid "Yes, mother."
msgstr "늬예, 엄마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD
#. Speaker = Rolan
#. NodeID = 5803de06-6ca6-3cc9-9c1f-2f6f617d980f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD:5803de06-6ca6-3cc9-9c1f-2f6f617d980f
msgctxt "h1995b7c4g6665g4c27g97cdg09857e181323"
msgid "I'll have to burn them."
msgstr "그냥 태워버려야겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD
#. Speaker = Rolan
#. NodeID = 59203330-075f-10dd-442c-38569645e99c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD:59203330-075f-10dd-442c-38569645e99c
msgctxt "h52e62692gb07ag4ba8g9f48g5e6da3abb6cd"
msgid "I'll never get the smell out of my clothes."
msgstr "옷에서 악취가 도저히 빠질 것 같지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD
#. Speaker = Lia
#. NodeID = 5dd457c2-dfc9-09e1-8cf3-a8fcdd71e99e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD:5dd457c2-dfc9-09e1-8cf3-a8fcdd71e99e
msgctxt "h86cc3ebbga9ceg4941gaa2dge96e55ff967e"
msgid "I won't leave them behind!"
msgstr "난 이 사람들 버리고 못 떠나!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD
#. Speaker = Cal
#. NodeID = 6062720f-a6f9-91d7-5c38-47f2b2c441b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD:6062720f-a6f9-91d7-5c38-47f2b2c441b3
msgctxt "h1dbf323bg18beg4983gb026g790e52950479"
msgid "Hey, sis. How long will it take to get to Baldur's Gate?"
msgstr "저기, 누나. 발더스 게이트까지 얼마나 걸릴까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD
#. Speaker = Rolan
#. NodeID = 607af67e-f2fc-7723-58a8-04f052fd30a1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD:607af67e-f2fc-7723-58a8-04f052fd30a1
msgctxt "h817e1db5g3786g450eg84cag21fab95f2cce"
msgid "I swear, I've never met such a pair of cheapskates."
msgstr "정말이지 니들 같은 빈대는 살면서 따로 못 봤어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD
#. Speaker = Rolan
#. NodeID = 6b6d821b-6940-fc54-de6a-cccecfdab089
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Prodigy_State_Staying = False
#.      - DEN_Prodigy_State_Leaving = False
#.   Local:
#.      - 12c3bf70-6622-e9db-0f6a-7ed590fd0039_P1 = True
#. SetFlags:
#.   Local:
#.     - 12c3bf70-6622-e9db-0f6a-7ed590fd0039_P2 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD:6b6d821b-6940-fc54-de6a-cccecfdab089
msgctxt "h474ce319gf772g4b97gbcb9gd71e6ba8dc06"
msgid "We don't even know these people!"
msgstr "우린 저들이랑 아는 사이도 아니라고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD
#. Speaker = Rolan
#. NodeID = 71563ffe-bb5b-d18a-4264-617e53ca7612
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Prodigy_State_Staying = False
#.      - DEN_Prodigy_State_Leaving = True
#.   Local:
#.      - 12c3bf70-6622-e9db-0f6a-7ed590fd0039_P1 = False
#. SetFlags:
#.   Local:
#.     - 12c3bf70-6622-e9db-0f6a-7ed590fd0039_P1 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD:71563ffe-bb5b-d18a-4264-617e53ca7612
msgctxt "h13f3fdc8g147fg4aefga99fg640bf401e0fb"
msgid "We should add the Elfsong Tavern to the list."
msgstr "엘프송 주점도 들릴 데 목록에다 넣어놓자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD
#. Speaker = Rolan
#. NodeID = 7b65093c-9edf-f078-4348-3326ab757ef3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD:7b65093c-9edf-f078-4348-3326ab757ef3
msgctxt "h873fdca7g3ef5g48e0g9d98g7839bee68c34"
msgid "Heh. You're an idiot."
msgstr "하. 실없는 자식 같으니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD
#. Speaker = Lia
#. NodeID = 7fe5d321-e2c4-2374-8200-452c5d51c790
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD:7fe5d321-e2c4-2374-8200-452c5d51c790
msgctxt "head5ccd8gc0dcg4000gbfc1g5c8d7999d1f3"
msgid "That's <i>not </i>what I said."
msgstr "내 뜻은 그게 <i>아니야</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Prodigy_AD
#. Speaker = Cal
#. NodeID = 83d56de8-d74a-e21c-cbd0-e61aebeb73b5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Prodigy_State_Staying = True
#.      - DEN_Prodigy_State_Leaving = False
