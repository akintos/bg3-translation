msgid ""
"<i>Kith'rak</i> Therezzyn shares your concerns. You should seek her within."
msgstr "<i>키스락</i> 테레진께서 네 고민을 들어주실 것이다. 들어가서 그분을 찾아라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointWarning
#. Speaker = Warrior Khunaruth
