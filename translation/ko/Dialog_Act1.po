msgid "Zhentarim... trading post..."
msgstr "젠타림... 교역소..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Dead
#. Speaker = Zarys
#. NodeID = dadd31d5-2b95-08e6-2ee7-c491e5fa77ee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Dead:dadd31d5-2b95-08e6-2ee7-c491e5fa77ee
msgctxt "hc41768d3ge505g4adag9364gdf7c79dd6544"
msgid "... east... caravan delayed..."
msgstr "... 동쪽... 상단이 늦춰졌어..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Dead
#. Speaker = Narrator
