msgctxt "hc795a561ge090g41f3gb3b6g0d5f801bb191"
msgid "Do you know where the githyanki crèche is?"
msgstr "기스양키 양성소가 어디있는 지 아나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithCaptain_Dead
#. Speaker = Sarth Baretha
#. NodeID = be8d6c17-85df-4875-972d-482ee2e430c4
