msgctxt "h30e89af4g71a3g44f0g8084g28c554595ecd"
msgid "*The spell's power wanes. You can ask no more questions.*"
msgstr "*주문의 힘이 약해집니다. 더 이상 질문을 할 수 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander_Dead
#. Speaker = Narrator
#. NodeID = 9d904d2a-97c7-9e7b-3306-5b7acf79899b
