msgctxt "h560660c3g2ba8g4049g9f2agb425801c7e0d"
msgid ""
"*Your mind is full, bursting with ecstasy and terror. Finally, it is coming. "
"You are becoming.*"
msgstr "*당신의 정신이 황홀경과 공포로 가득 차오릅니다. 마침내, 때가 됐군요. 당신은 변화 중입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinSleeper_02
#. Speaker = Narrator
#. NodeID = 5f4bd620-1710-4073-db7e-027cd6081b93
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount4(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount4(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinSleeper_02:5f4bd620-1710-4073-db7e-027cd6081b93
msgctxt "hbbc61182g7f22g493fg89a6g8bd98c6e4e51"
msgid ""
"*A shadow swims across your vision, and a familiar voice tells you to be "
"calm. You are loved.*"
msgstr "*그림자가 낀 듯이 눈앞이 흐려지더니, 익숙한 목소리가 당신을 달래줍니다. 사랑이 느껴집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinSleeper_02
#. Speaker = Booyahg Culk
#. NodeID = 62c77aca-3179-3368-6a88-e9bdabce0347
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinSleeper_02:62c77aca-3179-3368-6a88-e9bdabce0347
msgctxt "h746106b4gb03eg4fb0g86b5g8a46ea71570c"
msgid ""
"Happily. But the next noisy bastard that comes through here gets gutted."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinSleeper_02
#. Speaker = Booyahg Culk
#. NodeID = 73024fb9-4e1e-6671-1ebc-c2d14c574daa
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_Festivities_SleepersFight(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinSleeper_02:73024fb9-4e1e-6671-1ebc-c2d14c574daa
msgctxt "hf49eb7eeg8adfg4945gabfagea1f8776bb1e"
msgid "Hold up - who are you? Intruder!"
msgstr "잠깐, 넌 누구야? 침입자다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinSleeper_02
#. Speaker = Booyahg Culk
#. NodeID = 77d6a83a-889c-2467-8e50-1f787e402f35
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinSleeper_02:77d6a83a-889c-2467-8e50-1f787e402f35
msgctxt "hfd1bf01bg5124g48e5g92a5gb888ecf0288e"
msgid "Go away..."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinSleeper_02
#. Speaker = Player
#. NodeID = 78d247b6-6fe9-c211-04c5-50b84f451f96
