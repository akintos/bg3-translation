msgctxt "h607c79abg1a6eg46f8gafafgc6cf39b53ca1"
msgid ""
"*Your call echoes as it plunges downward, before gradually fading away.*"
msgstr "*당신의 외침은 구덩이 아래로 울려 퍼지다가 이내 사라집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DeepHole
#. Speaker = Voice from the Deep Hole
#. NodeID = df3ca606-2502-92a8-59c5-2aaa4a23ca37
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DeepHole:df3ca606-2502-92a8-59c5-2aaa4a23ca37
msgctxt "hf0c00ee6g147fg437eg9ba5g4e8dbb446259"
msgid "You disturb me still. Enough - away from here."
msgstr "여전히 귀찮게 굴고 있는군. 그만, 여기서 꺼져라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DeepHole
