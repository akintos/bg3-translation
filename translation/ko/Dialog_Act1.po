msgctxt "hf666a8cdgcff7g4f65g9298g7d36b51bc40e"
msgid "An unlikely place for such a fortunate find."
msgstr "이런 횡재를 할만한 곳은 아닌걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_VB_DeadDrow1Armor_WithDrow
#. Speaker = Player
#. NodeID = e3895d1a-064c-0aab-69fc-b9f19d68eecb
