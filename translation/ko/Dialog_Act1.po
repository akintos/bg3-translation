#.      - UND_MushroomHunter_Knows_Missing = True
#.      - UND_MushroomHunter_State_Saved = False
#.   Local:
#.      - 09983dce-d7d0-c108-506f-dcadc4044b0a_Derryth_SwD_WhereIsBaelen = False
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Local:
#.     - 09983dce-d7d0-c108-506f-dcadc4044b0a_Derryth_SwD_WhereIsBaelen = True
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_Derryth_Dead:e6c7c587-2e5d-b026-d2f9-5875ead3b46d
msgctxt "hd360db96g90e3g4a42gbef0gfd2092d9edba"
msgid "Where is Baelen?"
msgstr "베일렌은 어디 있지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_Derryth_Dead
#. Speaker = Narrator
#. NodeID = f771d420-b658-4fce-a039-9cdaa29a53c1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_Derryth_Dead:f771d420-b658-4fce-a039-9cdaa29a53c1
msgctxt "h410800adg9f2eg4b9bg87eeg709cb5ddb604"
msgid "*The spell's power wanes. You can ask no more questions.*"
msgstr "*주문의 힘이 약해집니다. 더 이상 질문을 할 수 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_Derryth_Dead
#. Speaker = Derryth Bonecloak
#. NodeID = f8f0d911-e2bc-4520-affa-5b4db4c3e728
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_Derryth_Dead:f8f0d911-e2bc-4520-affa-5b4db4c3e728
msgctxt "ha2b87f9ag5275g472cg9667g44c9fbc99fb8"
msgid "Mushroom. Heals anything... Very rare. Very valuable..."
msgstr "버섯이지. 만병통치... 정말 드물고. 정말 귀해..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_Derryth_Dead
#. Speaker = Narrator
#. NodeID = fc7d21b8-12dd-4560-ada8-e1fe33f5fca6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_Killer(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_Derryth_Dead:fc7d21b8-12dd-4560-ada8-e1fe33f5fca6
msgctxt "h498ad355g2299g4b45gadddg9b47b638ee23"
msgid "*The corpse seems willing to speak - but not to its killer.*"
msgstr "*시체는 말할 의지가 있지만, 자신을 죽인 자와 대화하고 싶지는 않은 듯 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_Derryth_Dead
#. Speaker = Derryth Bonecloak
#. NodeID = fd71da1d-b653-4e26-b3e3-67407a51f552
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_Derryth_Dead:fd71da1d-b653-4e26-b3e3-67407a51f552
msgctxt "hec00a151gb6e1g454dg9f80g72f9438f197d"
msgid "No valuables... only my ring..."
msgstr "없어... 내 반지 말고는..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Morghal
#. NodeID = 02be775c-b14f-876d-b03f-7735afbda5b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:02be775c-b14f-876d-b03f-7735afbda5b6
msgctxt "h20905bb6g02b9g44f8g858cg3bed4c289158"
msgid "Well, shit. Good thing I was just takin' the piss."
msgstr "이런 썅. 그냥 장난질 좀 쳐봤어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Corsair Greymon
#. NodeID = 04208ed6-9636-07f8-aee2-f3c79938f303
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:04208ed6-9636-07f8-aee2-f3c79938f303
msgctxt "hb57ad19fgc24bg4de0gb2bega4a06decc06d"
msgid "Spit it out. Sergeant finally choked on True Soul Nere's prick?"
msgstr "뭔데. 하사관이 참된 영혼 니어의 좆을 빨다가 끝내 숨 막혀 뒈졌냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Player
#. NodeID = 04294696-3157-8bca-2018-482a5a219c0b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DUERGARDWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:04294696-3157-8bca-2018-482a5a219c0b
msgctxt "hefd211beg40b7g4f74gbe13g082a4f1fb970"
msgid "Is that a threat? Because that <i>is</i> a problem."
msgstr "그걸 위협이라고 하는 거냐? 왜냐면 <i>그건</i> 문제가 맞거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Morghal
#. NodeID = 09ab995c-c44b-9711-b8ed-c9726fa511dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:09ab995c-c44b-9711-b8ed-c9726fa511dc
msgctxt "h3cd2bbb6g6b3fg4939gb6fag01650642ead6"
msgid "Hold up, <i>jargh</i>. You ain't goin'... nngh..."
msgstr "멈춰라, <i>자그</i>. 넌 못 지나간... 으윽..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Shadowheart
#. NodeID = 0a07f8e6-1a99-7b84-7399-da1fa6b21d47
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(6) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:0a07f8e6-1a99-7b84-7399-da1fa6b21d47
msgctxt "hb3eb985eg990eg448agad73gb49c46ef5c64"
msgid ""
"Might be worth talking to some of the gnome slaves - before they're worked "
"to death, that is."
msgstr "노움 노예들과 이야기를 좀 해보는 게 좋겠어. 물론 혹사당해서 죽어버리기 전에 해야겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Stone Guard Orgarth
#. NodeID = 0eb428b4-80e2-d599-37ce-9c88e7875534
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:0eb428b4-80e2-d599-37ce-9c88e7875534
msgctxt "he7914d1dgdff0g4ecdg8bdcg3ab4717f7fb1"
msgid "Coupla gnome slaves stuck with him too, little bastards."
msgstr "노움 노예 몇 명도 그와 함께 갇혔지. 좆만한 새끼들."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Corsair Greymon
#. NodeID = 15c999e8-526e-5bf0-c293-c39b6df8d1a1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_DarkLake_State_ClaimedGekhWasDead = True
#.   Object:
#.      - UND_DarkLake_State_CampIntro(3) = True
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:15c999e8-526e-5bf0-c293-c39b6df8d1a1
msgctxt "h6b68b024g3cb0g40c0gaec0g79a3f82735ef"
msgid ""
"Aye. He sniffed up Gekh's corpse. Found the <i>hoon</i> sailing his skiff."
msgstr "그래. 게크의 시체를 발견했다더군. 이 <i>훈</i>이 그의 배를 몰고 있더라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Corsair Greymon
#. NodeID = 15c999e8-526e-5bf0-c293-c39b6df8d1a1
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_DarkLake_State_ClaimedGekhWasDead = True
#.   Object:
#.      - UND_DarkLake_State_CampIntro(3) = True
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:15c999e8-526e-5bf0-c293-c39b6df8d1a1
msgctxt "hfebbd2c7ga75bg4b86g95c6g04089bb20911"
msgid ""
"Aye. She sniffed up Gekh's corpse. Found the <i>hoon</i> sailing his skiff."
msgstr "그래. 게크의 시체를 발견했다더군. 이 <i>훈</i>이 그의 배를 몰고 있더라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Corsair Greymon
#. NodeID = 15c999e8-526e-5bf0-c293-c39b6df8d1a1
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_DarkLake_State_ClaimedGekhWasDead = True
#.   Object:
#.      - UND_DarkLake_State_CampIntro(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:15c999e8-526e-5bf0-c293-c39b6df8d1a1
msgctxt "h3b69e6a0g3eb0g48f1gb8bfged86b5b289ca"
msgid ""
"Aye. They sniffed up Gekh's corpse. Found the <i>hoon</i> sailing his skiff."
msgstr "그래. 게크의 시체를 발견했다더군. 이 <i>훈</i>이 그의 배를 몰고 있더라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Player
#. NodeID = 1680addb-99bb-6b1c-603b-0d6b3ef64fde
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GNOME(1) = True
#. SetFlags:
#.   Local:
#.     - 40830d3a-5624-0c94-e8aa-f6d8a592de7c_HatesSlavers = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:1680addb-99bb-6b1c-603b-0d6b3ef64fde
msgctxt "h8e801f4fg49c4g4884ga0c3ge7503191019b"
msgid "If there's a mark on those gnomes, it will be."
msgstr "그 노움들중에 표식이 있는자가 있다면, 문제가 되겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Player
#. NodeID = 179f084f-cfcd-f71f-3483-6989fd8f4bba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:179f084f-cfcd-f71f-3483-6989fd8f4bba
msgctxt "h063e87b2g1a82g4f43gbf52gcfbdd6cd7657"
msgid "Forget I mentioned it."
msgstr "신경 쓰지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Player
#. NodeID = 1a94081e-49f9-31b0-3030-9d63222e8839
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 40830d3a-5624-0c94-e8aa-f6d8a592de7c_HatesSlavers = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:1a94081e-49f9-31b0-3030-9d63222e8839
msgctxt "haef2e380gb168g44a6g84f0ga78a7d7d7af6"
msgid "I've got no use for slavers. Including you."
msgstr "노예상 놈들한텐 볼일 없어. 너희도 포함해서 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Player
#. NodeID = 1c0d2354-fc97-95fe-5a77-204f78ee0e03
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:1c0d2354-fc97-95fe-5a77-204f78ee0e03
msgctxt "hb89fa395ge98cg4708gb496ge91cf5d31ded"
msgid "On second thought, forget it."
msgstr "다시 생각해봤는데, 그냥 잊어버려."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Gale
#. NodeID = 1c16a379-f56d-8cb0-0480-5ba93af916c8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(9) = True
#.   Tag:
#.      - REALLY_GALE(9) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:1c16a379-f56d-8cb0-0480-5ba93af916c8
msgctxt "h8fd331feg541ag47cag9956g4f023dbd3ee9"
msgid ""
"There's the matter of the gnomes, too. Wouldn't do to stand by and keep them "
"enslaved."
msgstr "노예가 된 노움 문제도 있지. 가만히 서서 지켜만 보고 있을 순 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Morghal
#. NodeID = 1cff246c-9228-9743-bf28-89d11571aba1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:1cff246c-9228-9743-bf28-89d11571aba1
msgctxt "h7ce7c2fege6a6g432cg9792g0e6819a6ce52"
msgid ""
"Pity for you. A good plough might dislodge that stick from your... nngh..."
msgstr "불쌍한 놈. 좋은 쟁기라면 너의 그 막대기로... 으윽..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Player
#. NodeID = 1ee70e68-1b22-e87a-2565-f2251bed3ab8
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_SELDARINEDROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:1ee70e68-1b22-e87a-2565-f2251bed3ab8
msgctxt "he0f08f7bg982bg4d9cgacf3g1f03ddc65184"
msgid "Lolth's bootlickers would make you their slave. I'll just kill you."
msgstr "롤쓰의 아첨꾼 놈들은 널 노예로 삼으려 하겠지. 그냥 널 죽여주마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Player
#. NodeID = 1ee70e68-1b22-e87a-2565-f2251bed3ab8
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:1ee70e68-1b22-e87a-2565-f2251bed3ab8
msgctxt "h49542699gd5dfg4a6cgb6d3g72322e6db8b2"
msgid "I'll just kill you, then. No problem at all."
msgstr "그냥 널 죽여버리면, 아무 문제가 없지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Morghal
#. NodeID = 2160fbcd-2958-186b-1de9-c5e41694be33
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_DarkLake_State_CampIntro(3) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:2160fbcd-2958-186b-1de9-c5e41694be33
msgctxt "hae53299fgddfag42e1ga2e4gc1f86e2f8d11"
msgid "We'll see about... nngh..."
msgstr "그건 두고 보자고... 으윽..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Karlach
#. NodeID = 234fec16-7ff8-4a84-9e1b-a1cc32edca03
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_KARLACH(7) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:234fec16-7ff8-4a84-9e1b-a1cc32edca03
msgctxt "hf32bce0bgb76cg4c48g9c09ge1f454c9d630"
msgid ""
"I'm ready to go, but maybe we should wait before provoking these pricks."
msgstr "난 준비됐지만, 이 개자식들을 자극하기보다 기다리는 게 낫지 않을까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Player
#. NodeID = 23a53948-e783-ec00-671a-500457e9affe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:23a53948-e783-ec00-671a-500457e9affe
msgctxt "hbe7df7c6g628ag4964g841dgda18621781f1"
msgid "I'm not giving you a single coin."
msgstr "너한테 줄 돈은 한 푼도 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Player
#. NodeID = 24786fbc-8f87-0a97-1d22-fc4d61e72857
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:24786fbc-8f87-0a97-1d22-fc4d61e72857
msgctxt "hc697a3cbg781eg493agba9aga21668101d1c"
msgid "Just let me through. I'm not looking for trouble."
msgstr "그냥 지나가게 해줘. 문제를 일으키고 싶진 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Morghal
#. NodeID = 24be25c4-1f6c-c60a-3f4c-cbb01a510c61
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:24be25c4-1f6c-c60a-3f4c-cbb01a510c61
msgctxt "ha670b24ag849ag41e2gb1b3gfd205cfcf09a"
msgid "Got any reason I shouldn't sever your head and toss it to the rothé?"
msgstr "내가 네놈 목을 베어버리고 로테에게 던져주지 말아야 할 이유가 하나라도 있나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Player
#. NodeID = 266e763d-e832-04e2-af4c-de96895ed18b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DUERGARDWARF(1) = True
#. SetFlags:
#.   Local:
#.     - 40830d3a-5624-0c94-e8aa-f6d8a592de7c_HatesSlavers = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:266e763d-e832-04e2-af4c-de96895ed18b
msgctxt "h803696c5g89a5g440fga012g0897c1ac8666"
msgid "Is that a threat? Because that <i>is</i> a problem."
msgstr "협박하는 거냐? 그렇다면 문제가 생기겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Karlach
#. NodeID = 290fdab1-1868-c09f-1ee3-dd6978fa1de8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_KARLACH(7) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:290fdab1-1868-c09f-1ee3-dd6978fa1de8
msgctxt "hadb8f719gbb8eg4f4dga7e8g6dfe84e2f0e7"
msgid ""
"Free the drow, take his head, get out of here in one piece. Easy as one, "
"two, three."
msgstr "드로우를 구하고, 그의 머리를 가지고, 여기서 단숨에 탈출한다. '하나, 둘, 셋' 처럼 쉬워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Player
#. NodeID = 2fc264a3-d784-156f-21f2-c2c66ffe62d5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GNOME(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:2fc264a3-d784-156f-21f2-c2c66ffe62d5
msgctxt "he8753884g7abeg42bdga9f1gf8980e06281c"
msgid "If there's a mark on those gnomes, it will be."
msgstr "그 노움들중에 표식이 있는자가 있다면, 문제가 되겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Gale
#. NodeID = 301586e2-6c51-3d03-19fc-521e6d902215
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(9) = True
#.   Tag:
#.      - REALLY_GALE(9) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:301586e2-6c51-3d03-19fc-521e6d902215
msgctxt "he6ca94f9g8367g4a2dgb942ga8060d502195"
msgid ""
"Let's not get into another scrape, shall we? Still catching my breath after "
"the last one."
msgstr "우리, 이번엔 싸움을 걸지 않는 게 어떨까? 지난 전투로부터 아직 숨을 돌리는 중이라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Morghal
#. NodeID = 3d4a04db-ca36-bf24-efc7-02e03deaf6ee
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:3d4a04db-ca36-bf24-efc7-02e03deaf6ee
msgctxt "h5363def8gcb12g4ca8g8b40gf652bea521c5"
msgid ""
"Ooh - that one's feisty. Thrinn's gonna knock the snot right out of her."
msgstr "우우, 아주 사나운 년이구만. 쓰린이 아주 혼쭐을 내주겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Lae'zel
#. NodeID = 3f5f142d-2827-4498-baec-dc53ea0bb9b5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_LAEZEL(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:3f5f142d-2827-4498-baec-dc53ea0bb9b5
msgctxt "he69abfcdgadc6g4e54g8109gc30c184faafd"
msgid ""
"If you lust for blood, so be it - though scouting may be the wiser option."
msgstr "피를 갈망한다면, 마음대로 해. 하지만 지켜보는 게 더 현명한 선택일지도 모른다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Morghal
#. NodeID = 40c78b3a-5d44-13f1-f391-6cf90d5a5d52
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:40c78b3a-5d44-13f1-f391-6cf90d5a5d52
msgctxt "ha608021cg3f4ag4a89gb809g8d8e1f8fc871"
msgid ""
"Shit - you're as plucky as you are pretty. Sergeant might have <i>two</i> "
"uses for you."
msgstr "망할, 예쁘장한데 성깔은 대단하군. 하사관이 너를 <i>두 가지</i> 용도로 쓸 수도 있겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Wyll
#. NodeID = 4177d6c8-63db-48ff-bd9f-f0e4c97c3788
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(8) = True
#.   Tag:
#.      - REALLY_WYLL(8) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:4177d6c8-63db-48ff-bd9f-f0e4c97c3788
msgctxt "h3db8ccf1g12cbg48d9g94eag3ca59024a7b8"
msgid ""
"I reckon this place is swarming with slavers. I hope you know what you're "
"doing."
msgstr "이 장소는 노예상들로 붐비는 것 같아. 네가 뭘 하고 있는지 인지했으면 좋겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Morghal
#. NodeID = 427febe7-1eb7-da7d-df80-e8e4b5702882
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_DuergarCamp_Checkpoint_CameAlone = True
#. SetFlags:
#.   Global:
#.     - UND_DuergarCamp_Knows_NereIsTrapped = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:427febe7-1eb7-da7d-df80-e8e4b5702882
msgctxt "haa26050ag4128g4ad3gabf2ge425adbd23fe"
msgid ""
"In that case, let's talk <i>business</i>. Your Twat-Soul friend Nere caused "
"a rockfall. Trapped tighter than a hornet's arse."
msgstr ""
"그렇다면, <i>사업</i> 얘기를 좀 해보자. 네 참된 씹것 친구, 니어가 낙석을 일으켰어. 말벌의 궁뎅이보다 더 빡빡하게 갇혀 있다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Stone Guard Orgarth
#. NodeID = 44e04a57-6464-4c5e-92dc-56c44ffe7cc4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:44e04a57-6464-4c5e-92dc-56c44ffe7cc4
msgctxt "h0d02ec44g4dbcg4462g950agc6d33f5897b5"
msgid "Deep gnomes, mostly. Easy to feed, fat thumbs for digging."
msgstr "대부분 딥 노움이지. 먹이기 쉽고, 손가락이 두꺼워서 땅을 잘 파거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Morghal
#. NodeID = 47bd1e42-b4fc-fc1a-efa1-3cd386a38435
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:47bd1e42-b4fc-fc1a-efa1-3cd386a38435
msgctxt "h83b66d1eg2b4bg47b6gb78cg4f69cc99867d"
msgid "You shithead - time you showed up. We got trouble."
msgstr "이 멍청한 새끼. 언제 오나 했다. 문제가 생겼어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Astarion
#. NodeID = 48610323-9211-136c-fb6e-adcfc37f85fa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:48610323-9211-136c-fb6e-adcfc37f85fa
msgctxt "h1b07a8ebg0abcg4730g931fgd70842e845a0"
msgid ""
"We have to free Nere before we can take his head? Sounds like a lot of "
"wasted effort."
msgstr "니어의 머리를 얻기 위해서는 그를 먼저 구해 줘야 한다고? 쓸데 없는 노력이 많이 들어 가는 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Karlach
#. NodeID = 4f674909-7b0e-a390-0a21-24b0e805b365
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_KARLACH(7) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:4f674909-7b0e-a390-0a21-24b0e805b365
msgctxt "he9dfcc61gc50bg4c3dgb7e8g9fc6f569b3e9"
msgid "Not in the mood for another fight, believe it or not. Can we play nice?"
msgstr "믿기지 않겠지만 또 싸우고 싶진 않아. 얘기로 잘 풀어나갈 수 없을까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Player
#. NodeID = 504b8c87-effa-e5eb-e9af-c2ac2aab9bb1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - LOLTHDROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:504b8c87-effa-e5eb-e9af-c2ac2aab9bb1
msgctxt "h19cc0ca5gabcfg4cc2ga1c1gd7f8b278be6e"
msgid "Keep talking to me like that, and I'll clap you in irons myself."
msgstr "계속 내게 그딴식으로 말하면, 내가 손수 감옥에 넣어주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Astarion
#. NodeID = 519ab94f-1dac-771b-dc00-259d22d1b140
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:519ab94f-1dac-771b-dc00-259d22d1b140
msgctxt "h33e8f188g806dg4f82gaac7g61d279b1a320"
msgid "Another belligerent dwarf? This is getting tiresome."
msgstr "또 다른 날선 드워프라고? 점점 지치는걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Corsair Greymon
#. NodeID = 544120e2-dbed-b08e-81f2-24cd0ef44b6e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:544120e2-dbed-b08e-81f2-24cd0ef44b6e
msgctxt "hd9677ef0g7828g4d87ga554gd7e5bf635108"
msgid "You're shitting me. He pay up?"
msgstr "지랄하지 마. 그 자식이 돈은 다 냈어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Player
#. NodeID = 55422793-0364-5d22-2501-7ee27a9e4fc2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:55422793-0364-5d22-2501-7ee27a9e4fc2
msgctxt "h66085386g5e11g482cgbed4g0f992d9b526c"
msgid "Not a problem in the slightest."
msgstr "전혀 문제 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Lae'zel
#. NodeID = 55e004d5-af4a-3502-9102-3b10091a017f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_LAEZEL(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:55e004d5-af4a-3502-9102-3b10091a017f
msgctxt "h535fc964g7478g420ag8a85g28bef6013215"
msgid ""
"Come - and pay no heed to their slaves. A bleeding heart is an unnecessary "
"burden."
msgstr "가자. 그리고 노예들은 신경 쓰지 마. 동정심은 불필요한 부담이니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Player
#. NodeID = 57f3e889-e87f-7521-34bc-62b193ad67c7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_DarkLake_State_CampIntro(3) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:57f3e889-e87f-7521-34bc-62b193ad67c7
msgctxt "he600cdb4gf0b3g4778g91e6g19cfe8e3562c"
msgid "I don't care about slaves. Now if you'll excuse me."
msgstr "노예들에겐 관심 없어. 실례하도록 하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Morghal
#. NodeID = 5beb213a-66d4-ab63-0b14-618eefc2c480
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:5beb213a-66d4-ab63-0b14-618eefc2c480
msgctxt "hd9d694d0g6e6bg4e73g8f20g8bda7e918977"
msgid ""
"Shit. Would love to see <i>that</i>. Now unclog your dwarf-hole - I'm just "
"bustin' your 'nads."
msgstr "씨발. <i>그거</i> 한번 보고 싶은데. 이제 네 목을 지켜. 짖궃은 농담 좀 한 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Gale
#. NodeID = 60060adb-8e0f-f6ab-1d13-5795160373ac
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(9) = True
#.   Tag:
#.      - REALLY_GALE(9) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:60060adb-8e0f-f6ab-1d13-5795160373ac
msgctxt "h0e4b478fg0251g4660g88e7g8cbd02e89905"
msgid ""
"So we must save the drow first, then sever his head after... Pleasantries "
"like that make me quite homesick."
msgstr "그러면 먼저 드로우를 구하고, 목을 자르고... 기분 좋은 얘기를 들었더니 고향이 보고 싶어지는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Morghal
#. NodeID = 62fc0bf1-6dc1-4db1-8049-749f3e78374c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 40830d3a-5624-0c94-e8aa-f6d8a592de7c_ProblemWithSlaves = True
#. TagRule: DEEPGNOME
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:62fc0bf1-6dc1-4db1-8049-749f3e78374c
msgctxt "ha5cdced9gf180g4fa1g85c2gf699504db159"
msgid ""
"A prick-squeak like you should fit <i>right</i> in. That a problem for you?"
msgstr "너 같은 땅딸보에게 <i>딱</i> 어울리겠군. 문제라도 있나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Morghal
#. NodeID = 62fc0bf1-6dc1-4db1-8049-749f3e78374c
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Local:
#.     - 40830d3a-5624-0c94-e8aa-f6d8a592de7c_ProblemWithSlaves = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:62fc0bf1-6dc1-4db1-8049-749f3e78374c
msgctxt "h59f0d208g8504g44b8g94e7g6aa83d07f6b1"
msgid "That a problem for you?"
msgstr "문제라도 있나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Player
#. NodeID = 63686b50-4f08-8d44-e02e-f9c0c77b8927
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_DarkLake_Knows_GnomeHunt = True
#.   Object:
#.      - UND_InjuredGnome_State_HasBoots(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:63686b50-4f08-8d44-e02e-f9c0c77b8927
msgctxt "h1c825e4cg27e0g4c75g8cf0g889d0d87295c"
msgid "I'm here to see the sergeant. I have her boots."
msgstr "하사관을 만나러 왔다. 그녀의 부츠를 가지고 있거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Morghal
#. NodeID = 648880f0-8463-f517-fc45-b3ff77c2665f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_DuergarCamp_Checkpoint_CameAlone = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:648880f0-8463-f517-fc45-b3ff77c2665f
msgctxt "h49782f6bgd319g447dg9167gbd4191173a85"
msgid ""
"Your Twat-Soul chum owes us a load of coin. You want through? Make a "
"donation. ([GEN_CheckMagicPocketGold_6057ad05-9492-4630-9f0a-be548b134c54])"
msgstr ""
"너희 참된 씹것 친구가 동전을 꽤나 많이 빚졌거든. 지나가고 싶으면 기부 좀 하지 그래. "
"([GEN_CheckMagicPocketGold_6057ad05-9492-4630-9f0a-be548b134c54])"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Player
#. NodeID = 66629163-a4bd-f949-f614-b86220ab01e5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:66629163-a4bd-f949-f614-b86220ab01e5
msgctxt "h7f0621bega93fg449egb510g662af9f69091"
msgid "Don't worry about what I'm here for - I'll be on my way."
msgstr "내가 뭐 때문에 왔는지는 걱정하지 마. 바로 가볼 테니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Morghal
#. NodeID = 6da2ed30-f6a5-4471-dbd5-55fc9d8e5678
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:6da2ed30-f6a5-4471-dbd5-55fc9d8e5678
msgctxt "h0225a757g95e9g4db9gbe67ga84c7a4bf9c9"
msgid "That so? I... nngh..."
msgstr "그렇단 말이지? 나는... 으음..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Morghal
#. NodeID = 7092830f-bc31-45d9-ce74-79ac9e2feb77
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:7092830f-bc31-45d9-ce74-79ac9e2feb77
msgctxt "h8ac07cd9gdf08g4c60g9940g99d42c64a9de"
msgid "That what you think? Shit. The Weaver herself couldn't... nngh..."
msgstr "그건 네 생각이지? 망할. 롤쓰님도 그러지는 못... 으윽..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Morghal
#. NodeID = 71e4876d-9aef-48e9-193c-e7274c25ec4f
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DUERGARDWARF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:71e4876d-9aef-48e9-193c-e7274c25ec4f
msgctxt "h9f40ef82g5bd1g440aga6d6g0ce84e0e4f89"
msgid "Not seen a face like yours in all of Grymforge, <i>clan-sen</i>."
msgstr "그림포지 전역에서 너 같은 얼굴은 본적이 없어, <i>클란센</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Morghal
#. NodeID = 71e4876d-9aef-48e9-193c-e7274c25ec4f
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DEEPGNOME
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:71e4876d-9aef-48e9-193c-e7274c25ec4f
msgctxt "h71ca5914g33ccg4acdgb7dagda9c921436eb"
msgid "You got nerve sailing to Grymforge, short-arse."
msgstr "그림포지에 올 생각을 하다니, 제법 용감한 땅딸보로군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Morghal
#. NodeID = 71e4876d-9aef-48e9-193c-e7274c25ec4f
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:71e4876d-9aef-48e9-193c-e7274c25ec4f
msgctxt "hc752d41dgf571g42c3gb807g140459d96fff"
msgid "What do we got here? Dead <i>hoon</i> walking, seems like."
msgstr "이게 누구신가? 뒈진 <i>훈</i>이 걸어 다니고 있는 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Morghal
#. NodeID = 72ccdba7-9c66-bb62-170a-ac4805785b05
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:72ccdba7-9c66-bb62-170a-ac4805785b05
msgctxt "h3f4a0886g24e9g4660g80dfgd30cbae88bb5"
msgid "I hear you right? You want a thrashing?"
msgstr "내가 제대로 들은 건가? 채찍질을 당하고 싶어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Player
#. NodeID = 75e40f39-e1b7-e658-fbfd-2914aa1d45f0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 40830d3a-5624-0c94-e8aa-f6d8a592de7c_HatesSlavers = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:75e40f39-e1b7-e658-fbfd-2914aa1d45f0
msgctxt "h6d6ecddag9661g4601ga3cdgdd8dad399feb"
msgid "I don't think you understand - I'm gutting you here and now."
msgstr "내 말을 못 알아들은 것 같군. 지금 이 자리에서 네 내장을 꺼내주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Narrator
#. NodeID = 78303c84-2f4f-3ee0-06eb-2325c8bc87cc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:78303c84-2f4f-3ee0-06eb-2325c8bc87cc
msgctxt "h70ff19ceg3c7bg4176ga220g759c9b120858"
msgid ""
"*You feel the slightest of stirrings in your head. The duergar is not "
"infected, yet your minds resonate.*"
msgstr "*머릿속에서 미세한 흔들림이 느껴집니다. 이 듀에르가는 감염되지 않았지만, 여전히 서로의 정신이 공명합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Shadowheart
#. NodeID = 79b0af7c-71ea-4ab4-bf7f-b96a6e97c091
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(6) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:79b0af7c-71ea-4ab4-bf7f-b96a6e97c091
msgctxt "hdc545b80g5522g4718g9cedg5513be2ae42e"
msgid ""
"There could be scores of duergar here. Let's not pick a fight until we know "
"how the odds are stacked."
msgstr "이곳에 듀에르가 수십 명이 있을지도 몰라. 승산이 얼마나 있는지 알기 전까지는 싸움을 벌이지 말자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Player
#. NodeID = 7de6ae66-5e83-4699-c7a2-800ecede6130
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 40830d3a-5624-0c94-e8aa-f6d8a592de7c_TrueSoulPath = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:7de6ae66-5e83-4699-c7a2-800ecede6130
msgctxt "he8446d67g423bg4dd1ga568g31333b0cd64b"
msgid ""
"It's a problem, all right. I'm a True Soul, and you will treat me like one."
msgstr "당연히 문제가 있지. 난 참된 영혼이다. 제대로 대우하도록."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Player
#. NodeID = 7f9616eb-0ca7-e70a-91f8-b6690dd7acce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:7f9616eb-0ca7-e70a-91f8-b6690dd7acce
msgctxt "haa46d00ag3c88g4478ga552g683d7e4b61d9"
msgid "You keep slaves here?"
msgstr "노예를 잡아두고 있다고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Wyll
#. NodeID = 7fa05163-79cc-01ff-34b5-3552fd981a65
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(8) = True
#.   Tag:
#.      - REALLY_WYLL(8) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:7fa05163-79cc-01ff-34b5-3552fd981a65
msgctxt "he4813e71ga5a8g4a7bgbd7bgbcbb5947ad45"
msgid "I reckon diplomacy may be in order. The Blade could use a breather."
msgstr "외교적 접근법이 필요하다고 생각하는데. 칼날도 숨을 돌릴 필요가 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Morghal
#. NodeID = 83b4e473-0dcc-53a3-0373-03812ef63b44
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:83b4e473-0dcc-53a3-0373-03812ef63b44
msgctxt "ha0c38a40gd7dag498fg95d9g68b766ad90f0"
msgid ""
"I don't make threats - I <i>educate</i>. Now hand over the coin and get "
"moving."
msgstr "난 협박하지 않아. <i>교육</i>을 시킬 뿐이지. 빨리 돈이나 내고 가라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Astarion
#. NodeID = 86f3b4b3-8693-4307-b02f-5d6e12dda6d2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:86f3b4b3-8693-4307-b02f-5d6e12dda6d2
msgctxt "h92e93eefg500ag4aa9ga162gedd33318a195"
msgid "Call me 'slave' again, and I'll feed you your own stomach."
msgstr "한 번만 더 날 '노예'라고 불렀다간, 널 갈가리 찢어서 네 입에 넣어주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Morghal
#. NodeID = 88019e30-8727-fd80-4b41-7505b4fb2bee
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 40830d3a-5624-0c94-e8aa-f6d8a592de7c_TrueSoulPath = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:88019e30-8727-fd80-4b41-7505b4fb2bee
msgctxt "h32497abfg1dc1g4fa2g930dg0800d4ca5396"
msgid "I'll be - you ain't shittin'. Felt the tingle."
msgstr "젠장, 헛소리하는 게 아니었군. 머리가 따끔거리는 게 느껴졌어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Karlach
#. NodeID = 8cc7df85-465f-45e0-cfa9-2cb1d8e2ca70
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_KARLACH(7) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:8cc7df85-465f-45e0-cfa9-2cb1d8e2ca70
msgctxt "h1fa666c2g1561g497fga2d5g9ba0498d7cfd"
msgid ""
"I've seen nasty, but these guys are on their own level. I have a feeling "
"this is gonna end badly."
msgstr "더러운 꼴은 많이 봤지만, 이 녀석들은 정도가 좀 다르네. 뭔가 안 좋은 결말이 날 것 같은 느낌이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Shadowheart
#. NodeID = 8d54d306-02b2-553b-e80c-595bac1d4179
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(6) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:8d54d306-02b2-553b-e80c-595bac1d4179
msgctxt "h7ee4dfd3g0769g4459gace6g34ddc199e680"
msgid ""
"Charming - and slave drivers to boot. Might be worth talking to the gnomes "
"before they're worked to death."
msgstr "매력 있네. 게다가 노예 감독관이라니. 노움들이 일하다 죽기전에 얘기해 보는 것도 괜찮겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Morghal
#. NodeID = 8ec0a005-0668-b33b-6bdf-f38481e65434
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DUERGARDWARF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:8ec0a005-0668-b33b-6bdf-f38481e65434
msgctxt "h6a2cb4eegdfb1g412fg8470g7d446a7b2d6f"
msgid "Who's the <i>clan-sen</i> - another merc to help the slaves dig?"
msgstr "저 <i>클란센</i>은 누구야, 작업에 참여하러 온 다른 용병인가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Morghal
#. NodeID = 8ec0a005-0668-b33b-6bdf-f38481e65434
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:8ec0a005-0668-b33b-6bdf-f38481e65434
msgctxt "he972e0b2g0a87g40ffg965cgef228e89881d"
msgid "Who's the <i>hoon</i> - friend of Nere's? Or you ploughin' drow now?"
msgstr "이 <i>훈</i>은 또 뭐야, 니어의 친구인가? 아니면 이제 드로우랑 박아대기라도 하는 거냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Morghal
#. NodeID = 8ec0a005-0668-b33b-6bdf-f38481e65434
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:8ec0a005-0668-b33b-6bdf-f38481e65434
msgctxt "h6606d2b9gb552g4b2ag8f8ag46c11446b336"
msgid "Who's the <i>hoon</i>, Greymon - another slave for the dig?"
msgstr "이 <i>훈</i>은 누구야, 그레이몬. 땅 파는 노예를 더 데려온 거냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Shadowheart
#. NodeID = 8f9d7230-808a-5fdb-714c-f5139a7c730f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(6) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:8f9d7230-808a-5fdb-714c-f5139a7c730f
msgctxt "h3bcfb058g948dg41aeg8f90g8d33de554af2"
msgid ""
"Seems we'll have to free Nere before we can collect the bounty on his head."
msgstr "니어의 현상금에 대한 보상을 받으려면 우선 그를 구해줘야 할 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Player
#. NodeID = 919f5157-049e-a0c2-42c0-f1d1550c2342
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:919f5157-049e-a0c2-42c0-f1d1550c2342
msgctxt "h5f2e8cc0g9d28g4b0ag9474gcb0b899d28f9"
msgid "I've got no use for slavers. Including you."
msgstr "노예상 놈들한텐 볼일 없어. 너희도 포함해서 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Morghal
#. NodeID = 9beb2eee-6728-7ed3-2b7b-7ed419973f1f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:9beb2eee-6728-7ed3-2b7b-7ed419973f1f
msgctxt "hb985ac21gad43g4e76gb3b3g5e5a75f2bb24"
msgid "Good. Now cough up the coin - I got shit to do."
msgstr "좋아. 그럼 금화나 뱉어내 - 난 바쁜 몸이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Gale
#. NodeID = 9e3e9ebb-08b2-4e7f-bd98-f698d9a0be29
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(9) = True
#.   Tag:
#.      - REALLY_GALE(9) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:9e3e9ebb-08b2-4e7f-bd98-f698d9a0be29
msgctxt "h04624026g94a6g4feag8492g3c619567f6cd"
msgid ""
"Uhm - I think you might be about to bite off more duergar than you can chew."
msgstr "어음- 내 생각엔 네가 감당할 수 있는 것보다 더 많은 듀에르가에 맞서려는 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Morghal
#. NodeID = 9e62dc64-8f0d-3b20-a7e8-4ed0b5e95f3e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:9e62dc64-8f0d-3b20-a7e8-4ed0b5e95f3e
msgctxt "h07c98c42g1490g4a4dgb73fgb282f2419380"
msgid ""
"Well la-dee-damn-da. I'm empress of this dock, and when I say 'jump', you "
"ask 'how high?'"
msgstr "이런 제기랄. 난 이 부두의 여왕이다. 내가 '뛰어'라고 하면, '얼마나 높이?'라고만 물으면 되는 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Morghal
#. NodeID = 9f88fd02-65ad-db34-2674-f830c8071838
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:9f88fd02-65ad-db34-2674-f830c8071838
msgctxt "hb611c34fgb022g4b85ga711g0b5db1bd7bf8"
msgid ""
"Ooh - this one's feisty. Thrinn's gonna knock the snot right out of him."
msgstr "우우, 아주 사나운 놈이구만. 쓰린이 아주 혼쭐을 내주겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Morghal
#. NodeID = a02c2a8e-20ab-d16f-d6c2-37ec0a0d70f6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:a02c2a8e-20ab-d16f-d6c2-37ec0a0d70f6
msgctxt "h4ecb728dg2d6fg4428gbe80gca87304aba58"
msgid "That right? And just what do... nngh..."
msgstr "그래? 그럼 뭘... 으윽..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Morghal
#. NodeID = a10e968f-5ce1-fdbf-76bd-65620749694c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_DuergarCamp_State_DocksHostile = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:a10e968f-5ce1-fdbf-76bd-65620749694c
msgctxt "h8b1c0426gb434g4c3fgae93g7bf0da5a32d9"
msgid "I'll choke the life out of you, shit-for-brains."
msgstr "이 똥대가리 자식, 네 인생을 끝장내주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Morghal
#. NodeID = a5d51fdb-c8d5-f5f1-2bb8-040d8fe460e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:a5d51fdb-c8d5-f5f1-2bb8-040d8fe460e6
msgctxt "he0655d96g0011g4baagbbcbg63aa88f89b01"
msgid ""
"You Absolute-shaggers owe us a crap-load of coin. You want through? Make a "
"donation. ([GEN_CheckMagicPocketGold_6057ad05-9492-4630-9f0a-be548b134c54])"
msgstr ""
"너희 절대자 노리개들은 우리에게 엄청난 양의 동전을 빚졌어. 통과하고 싶어? 기부 좀 해. "
"([GEN_CheckMagicPocketGold_6057ad05-9492-4630-9f0a-be548b134c54])"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Player
#. NodeID = a91de5c8-5fb6-9c67-397b-f46bf6ae682f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_DarkLake_State_CampIntro(3) = True
#. TagRule: DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:a91de5c8-5fb6-9c67-397b-f46bf6ae682f
msgctxt "hc36b076cg4363g4489gb1d9g1eef358ba7c2"
msgid "I don't care about slaves. I'm here for the sergeant."
msgstr "노예는 내 관심사가 아니야. 난 하사관을 찾으러 왔다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Player
#. NodeID = a91de5c8-5fb6-9c67-397b-f46bf6ae682f
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_DarkLake_State_CampIntro(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:a91de5c8-5fb6-9c67-397b-f46bf6ae682f
msgctxt "hf43b38f0gb7ebg4aa3gb3a1gc1bdd0ecdf15"
msgid "I'm not here to work. I'm here for the sergeant."
msgstr "난 여기 일하러 온 게 아니다. 하사관을 찾으러 왔어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Wyll
#. NodeID = a9b1c6fd-9ebc-8a11-9b1b-5e5b11e49ebc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(8) = True
#.   Tag:
#.      - REALLY_WYLL(8) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:a9b1c6fd-9ebc-8a11-9b1b-5e5b11e49ebc
msgctxt "hddae3436gdce6g4a75g8cf7ge45c683e3672"
msgid ""
"Not to mention - they keep gnomes as slaves. Though not for much longer, if "
"I have a say."
msgstr "말할 것도 없이, 놈들은 노움을 노예로 부리고 있어. 하지만 내게 결정권이 있다면, 더는 그렇게 하지 못할거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Player
#. NodeID = ab031adf-9f53-1b7b-8dcc-c3df8ae2e07b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:ab031adf-9f53-1b7b-8dcc-c3df8ae2e07b
msgctxt "ha01dc687g7fa0g47feg8758g113d9cf198d0"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Wyll
#. NodeID = ab3fce87-0af4-8103-3fa5-1b5deacf4ae2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(8) = True
#.   Tag:
#.      - REALLY_WYLL(8) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:ab3fce87-0af4-8103-3fa5-1b5deacf4ae2
msgctxt "h4e832b77g2195g4278ga1cfga7e75e1a323d"
msgid ""
"Did I hear right - they keep gnomes as slaves? Not for much longer, if the "
"Blade has a say."
msgstr "내가 제대로 들은 건가? 노움을 노예로 부린다고? 칼날에게 결정권이 있다면, 더는 그러지 못할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Morghal
#. NodeID = acaa1c22-a484-5211-7004-d05656786cfa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:acaa1c22-a484-5211-7004-d05656786cfa
msgctxt "h5e2aa46agb36fg4143g85f2g09953b85aa1d"
msgid "Yeah, I bet you'll mess us up good, squeaker. Now pay up, or sod off."
msgstr "그래, 분명 우릴 엉망으로 만들겠지, 꽥꽥아. 이제 돈을 내든가 꺼져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Player
#. NodeID = b4a9f54b-c77d-5d55-0350-2af4eb37b769
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_DarkLake_State_CampIntro(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:b4a9f54b-c77d-5d55-0350-2af4eb37b769
msgctxt "h01a14d58gb436g46bbga66dg26b9e9e2f924"
msgid "I was told to report to the sergeant."
msgstr "하사관한테 보고하라고 하던데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Morghal
#. NodeID = b808b1ee-de36-4bc5-5b76-d607eb292c43
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:b808b1ee-de36-4bc5-5b76-d607eb292c43
msgctxt "hfd9f1a97g6e40g4f6egb840gaa2053c59bf5"
msgid "Shit. You think a runt like you's gonna... nngh..."
msgstr "씨발. 네가 생각하기에 너 같은 새끼가... 으윽..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Morghal
#. NodeID = b98be0a5-0c4c-eac6-110c-22bf66cdf987
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:b98be0a5-0c4c-eac6-110c-22bf66cdf987
msgctxt "he9a1c374gd87bg4153gb280g00d377708ecf"
msgid "Shit. Just 'cause you're duergar don't make you clan. What... nngh..."
msgstr "씨발. 네가 듀에르가라고 해서 우리 편이 되는 건 아니라고. 뭐지... 으윽..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Player
#. NodeID = ba9ec58d-8024-664a-04e7-16ffd33fa6b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:ba9ec58d-8024-664a-04e7-16ffd33fa6b6
msgctxt "hf62913ccg0ce8g4ddegb330g6742c577413a"
msgid "I'll take your head before you take my gold."
msgstr "내 금화를 가져가기 전에 네놈 머리통이 날아갈 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Corsair Greymon
#. NodeID = bbf608cf-bac7-472e-1c51-73743699e4e3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_DarkLake_State_CampIntro(3) = True
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:bbf608cf-bac7-472e-1c51-73743699e4e3
msgctxt "ha7e10858g8843g4ccag8242g2f6c62597523"
msgid "Aye, he speaks true. Found the <i>hoon</i> sailing Gekh's skiff."
msgstr "그래, 사실이야. 이 <i>훈</i>이 게크의 배를 몰고 있는 걸 찾았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Corsair Greymon
#. NodeID = bbf608cf-bac7-472e-1c51-73743699e4e3
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_DarkLake_State_CampIntro(3) = True
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:bbf608cf-bac7-472e-1c51-73743699e4e3
msgctxt "h42d0ccd9g14c0g4b5eg9052gee36c0fb5e38"
msgid "Aye, she speaks true. Found the <i>hoon</i> sailing Gekh's skiff."
msgstr "그래, 사실이야. 이 <i>훈</i>이 게크의 배를 몰고 있는 걸 찾았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Corsair Greymon
#. NodeID = bbf608cf-bac7-472e-1c51-73743699e4e3
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_DarkLake_State_CampIntro(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:bbf608cf-bac7-472e-1c51-73743699e4e3
msgctxt "h4cc0e817g71e4g4dc3g8a63gc133263004cf"
msgid "Aye, they speak true. Found the <i>hoon</i> sailing Gekh's skiff."
msgstr "그래, 사실이야. 이 <i>훈</i>이 게크의 배를 몰고 있는 걸 찾았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Astarion
#. NodeID = bd13cf8a-dd7e-06df-238c-11bb0e54f3d0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:bd13cf8a-dd7e-06df-238c-11bb0e54f3d0
msgctxt "hba03b613g38c1g42c6gaa01g29a90be22a2f"
msgid ""
"All the charm and wit you'd expect from a slaver. Even a slaver of gnomes."
msgstr "노예상의 전형적인 매력과 재치를 지니고 있군. 노움 노예상이긴 하지만 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Morghal
#. NodeID = c297e42c-ad3e-5220-216f-493153f17e5b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_DuergarCamp_Knows_NereIsTrapped = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:c297e42c-ad3e-5220-216f-493153f17e5b
msgctxt "h2c00c452gd42ag4154gb51agb6687d7949e8"
msgid ""
"<i>Drugh</i> no. The Twat-Soul caused a rockfall. Trapped tighter than a "
"ring on a fat finger."
msgstr "<i>지랄</i>, 당연히 아니지. 우리 참된 씹것이 낙석을 일으켜서, 뚱뚱한 손가락에 낀 반지처럼 꽉 갇혀버렸다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Morghal
#. NodeID = c36e6ad1-cf0a-85c9-23de-5d05592fcad0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:c36e6ad1-cf0a-85c9-23de-5d05592fcad0
msgctxt "hbd134214gf01eg4e59g94bdg87d12b340b46"
msgid ""
"That's the trouble - he's got the gold on him. Sergeant's arm is falling off "
"with all the gnome slaves she's been beating."
msgstr "그게 문제야, 돈은 그놈이 다 들고 있어. 노움 노예들을 채찍질하느라 하사관의 팔이 빠질 지경이라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Karlach
#. NodeID = c534fdff-3786-1616-8533-1481ce554682
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_KARLACH(7) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:c534fdff-3786-1616-8533-1481ce554682
msgctxt "h221fcbc6gb9c9g4309g9e3agb7db1fb12800"
msgid "Don't forget the gnomes. I'm not leaving them with their captors."
msgstr "노움들을 잊지 마. 그들을 노예로 두고 떠나지 않을 테니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Morghal
#. NodeID = c569ea5e-aeff-d908-eae4-e04e87438805
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:c569ea5e-aeff-d908-eae4-e04e87438805
msgctxt "h967e3ae8gf0dag42e7gadb5gce5c868dda7a"
msgid "I'll be. You're one of them cult-freaks. Felt the tingle."
msgstr "이런. 너는 그 광신도 새끼들이랑 한패로군. 머리가 따끔거리는 게 느껴졌어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Player
#. NodeID = c6649796-1a3f-3f39-7216-82b6a82264e1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - LAEZEL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:c6649796-1a3f-3f39-7216-82b6a82264e1
msgctxt "h0083c3d7gab52g4fabg9694g4ceec6ba7ff1"
msgid ""
"I am Lae'zel - daughter of Gith, defender of Queen Vlaakith. And I am no "
"slave."
msgstr "난 기스의 딸, 블라키스 여왕님의 수호자, 레이젤이다. 그리고 난 노예가 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Player
#. NodeID = cc18c692-1123-89bb-c8f1-691f99b5282b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:cc18c692-1123-89bb-c8f1-691f99b5282b
msgctxt "h9d0a360fg1bfag4400g8a97ge4f61eb6f380"
msgid "I want you to try to give me one."
msgstr "한번 그렇게 해 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Player
#. NodeID = d195d04b-207e-e2ce-74c6-285d2017f39e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_DarkLake_State_CampIntro(3) = True
#.   Tag:
#.      - DROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:d195d04b-207e-e2ce-74c6-285d2017f39e
msgctxt "h4a6f289fg5ea8g4182g90fbg30dc4959b71d"
msgid "Disgusting. I assure you, we are not 'ploughing'."
msgstr "역겹군. 확실히 말해주지, 우린 '쟁기'가 아니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Astarion
#. NodeID = d23fcaa6-84e0-302b-6788-5fa942a3b061
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:d23fcaa6-84e0-302b-6788-5fa942a3b061
msgctxt "h81d0cee5g82a4g45f5g8a98gd437d0fc1f37"
msgid ""
"Let's do the job and get out of here. All this talk of slaves is just "
"depressing."
msgstr "빨리 일을 끝내고 여기서 빠져나가자고. 노예 이야기를 들으니 우울해지는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Lae'zel
#. NodeID = d38e21cb-2c4a-43e3-873b-b16a8eafa67b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:d38e21cb-2c4a-43e3-873b-b16a8eafa67b
msgctxt "h2767b30dg31c6g4fc0gbde3gba5e532af46b"
msgid ""
"I am Lae'zel - daughter of Gith, defender of Vlaakith. And I am no slave."
msgstr "난 기스의 딸, 블라키스 님의 수호자, 레이젤이다. 그리고 난 노예가 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Player
#. NodeID = d53b8492-b0eb-4d9b-f6c1-c78ffa37d46a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:d53b8492-b0eb-4d9b-f6c1-c78ffa37d46a
msgctxt "hddc59df3gf108g4a54gb78fg8fa2984b7a10"
msgid "Did you say you keep slaves here?"
msgstr "방금 노예라고 했나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Morghal
#. NodeID = d7a78040-846e-98b4-026f-375f5bd0949a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:d7a78040-846e-98b4-026f-375f5bd0949a
msgctxt "h4b3e4007g27e4g42ddg8f83g736a4509ed81"
msgid ""
"But I'm warning you - that Twat-Soul ain't settle up soon, there'll be hell "
"to pay for the lot of you cult-buggers."
msgstr "하지만 경고 하나 해주지. 그 참된 씹것 일이 빨리 해결되지 않으면, 너희 광신도 새끼들이 갚아야 할 돈이 아주 많아질 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Player
#. NodeID = d8e499b5-3397-a50a-c57c-1509270ce9f7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:d8e499b5-3397-a50a-c57c-1509270ce9f7
msgctxt "h79ee9a9ag8792g4a37ga731g0f790d0908b9"
msgid "I'll be severing yours if it's all the same."
msgstr "누구 머리든 상관없다면 내가 네 목을 잘라주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Player
#. NodeID = daaef396-195b-af95-2906-9298b131056e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:daaef396-195b-af95-2906-9298b131056e
msgctxt "hd7f3b4f7g37f5g4230ga605g6ad44286b8e3"
msgid "Call me 'slave' again, and I'll feed you your own stomach."
msgstr "한 번만 더 날 '노예'라고 불렀다간, 널 갈가리 찢어서 네 입에 넣어주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Player
#. NodeID = db58c2d1-034d-fb8b-2eb3-a26615167623
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:db58c2d1-034d-fb8b-2eb3-a26615167623
msgctxt "ha3313565g29e3g444bg970fg58e9f97e34e8"
msgid "To bind another in slavery is abhorrent. As are <i>you</i>."
msgstr "다른 이들을 노예로 부리는 건 혐오스러운 일이야. <i>너처럼</i> 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Morghal
#. NodeID = dd53f993-39f6-5d9b-84ed-315c92d04446
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:dd53f993-39f6-5d9b-84ed-315c92d04446
msgctxt "ha8791e38g1b41g4175gb3afg31774a28b901"
msgid "Unclog your hole - just shitting around."
msgstr "똥구멍에 힘 빼, 그냥 장난친 것뿐이니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Corsair Greymon
#. NodeID = e182542d-344a-f00f-ee55-c036207f4f30
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:e182542d-344a-f00f-ee55-c036207f4f30
msgctxt "h497fd91bg7d15g4269gb590g2751999b02b0"
msgid "Well I'll be ploughed sideways - we got a welcoming party."
msgstr "저쪽으로 가야겠어, 환영 인파가 기다리고 있구만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Lae'zel
#. NodeID = e1c4722e-4b73-3c95-16ed-f4a4989bd4e6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_LAEZEL(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:e1c4722e-4b73-3c95-16ed-f4a4989bd4e6
msgctxt "h4d457772gc7e6g48fdgb743gd72841b3cdb7"
msgid ""
"As for the gnome slaves, pay no heed. A bleeding heart is an unnecessary "
"burden."
msgstr "노움 노예들에 대해선 신경 쓰지 마. 동정심은 불필요한 짐이니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Gale
#. NodeID = e214ed17-2316-f207-b176-53f71741dc42
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(9) = True
#.   Tag:
#.      - REALLY_GALE(9) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:e214ed17-2316-f207-b176-53f71741dc42
msgctxt "h62d14548gbe12g4baag9206g21d510297f7c"
msgid ""
"She really oozes charm, this one. Perhaps we should spare a thought for the "
"wretches she's enslaved."
msgstr "이 여자는 아주 매력이 넘치는군. 그녀가 노예로 삼은 불쌍한 이들을 생각해 줘야 할지도 모르겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Player
#. NodeID = e2285e16-6ff4-a2f0-5cd7-1a82dd58bec4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_CheckPocketGold = True
#. SetFlags:
#.   Object:
#.     - GEN_TransferNPCPayment(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:e2285e16-6ff4-a2f0-5cd7-1a82dd58bec4
msgctxt "hff8cc5fbg8151g4992g8876g3684ddbe96fb"
msgid "Fine - take it."
msgstr "좋아. 가져가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Wyll
#. NodeID = e3d652fa-fd95-6190-c2b6-53ca84267d6f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(8) = True
#.   Tag:
#.      - REALLY_WYLL(8) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:e3d652fa-fd95-6190-c2b6-53ca84267d6f
msgctxt "h16321f09g3134g4e88g8958ga4de9904b9cd"
msgid ""
"We're closing in on Nere. But if we want his head, we'll need to free him "
"first."
msgstr "우리는 니어를 포위하려 해. 하지만 그의 머리를 원한다면, 그를 풀어주는 것이 우선이겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Stone Guard Orgarth
#. NodeID = e4ecb7d4-534b-dfc7-fbd1-03cceac36f52
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_DuergarCamp_Checkpoint_CameAlone = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:e4ecb7d4-534b-dfc7-fbd1-03cceac36f52
msgctxt "he2a68780g2e23g430agb37ag5ab037e9842b"
msgid "Weapon at ready, lass - company's calling."
msgstr "무기를 챙겨, 누군가 다가오고 있군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Player
#. NodeID = e5129a35-cdca-4479-737f-f51e47f6993b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:e5129a35-cdca-4479-737f-f51e47f6993b
msgctxt "h22d3b669g24a2g40e4g9005gf6a73eeb15be"
msgid ""
"I'd rather cut my own throat than hand my coin to a bloody <i>duergar</i>."
msgstr "내 돈을 망할 <i>듀에르가</i>에게 줄 바엔 내 목을 자르겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Corsair Greymon
#. NodeID = e5e580f1-fc03-efeb-80e7-01bb0cdbaa95
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_DarkLake_State_CampIntro(3) = True
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:e5e580f1-fc03-efeb-80e7-01bb0cdbaa95
msgctxt "h88628ac2g0495g4aa3gbe73g805041048e5d"
msgid ""
"Close your hatch, Morghal. He's one of those Absolute crackpots. Found the "
"<i>hoon</i> sailing Gekh's skiff."
msgstr "입 닥쳐, 모르갈. 이 자는 절대자 떨거지들 중 하나야.이 <i>훈</i>이 게크의 배를 몰고 있더군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Corsair Greymon
#. NodeID = e5e580f1-fc03-efeb-80e7-01bb0cdbaa95
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_DarkLake_State_CampIntro(3) = True
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:e5e580f1-fc03-efeb-80e7-01bb0cdbaa95
msgctxt "he0bc283dg5aa8g4eb3g9187g154ec506c122"
msgid ""
"Close your hatch, Morghal. She's one of those Absolute crackpots. Found the "
"<i>hoon</i> sailing Gekh's skiff."
msgstr "입 닥쳐, 모르갈. 이자는 절대자 떨거지들 중 하나야. 이 <i>훈</i>이 게크의 배를 몰고 있더군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Corsair Greymon
#. NodeID = e5e580f1-fc03-efeb-80e7-01bb0cdbaa95
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_DarkLake_State_CampIntro(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:e5e580f1-fc03-efeb-80e7-01bb0cdbaa95
msgctxt "h8ff40e3dg6284g4c71g879bgb4ff668b096a"
msgid ""
"Close your hatch, Morghal. They're one of those Absolute crackpots. Found "
"the <i>hoon</i> sailing Gekh's skiff."
msgstr "입 닥쳐, 모르갈. 이자는 절대자 떨거지들 중 하나야. 이 <i>훈</i>이 게크의 배를 몰고 있더군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Morghal
#. NodeID = e74fcbf4-c579-9d65-34a2-b12ec4415b56
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:e74fcbf4-c579-9d65-34a2-b12ec4415b56
msgctxt "h1e602fc1g6878g402cgb092g6fffcfdd8c7d"
msgid "I'll be shagged to Shanatar. Shit's looking up."
msgstr "좋아서 샤난타르 가버리겠네. 거렁뱅이 신세 나아지겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Morghal
#. NodeID = e82ba3c4-d150-f466-fb27-5421f44986b9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:e82ba3c4-d150-f466-fb27-5421f44986b9
msgctxt "h8924a6a6g7670g4a6eg8556g78fbe0c4d30e"
msgid "Fine. Now pay the toll, <i>jargh</i>. I'm tired of your face."
msgstr "좋아. 이제 통행료를 내, <i>자그</i>. 네 면상 보는 것도 지겨우니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Lae'zel
#. NodeID = e8837003-8cca-7dd2-c78a-86798894de7e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_LAEZEL(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:e8837003-8cca-7dd2-c78a-86798894de7e
msgctxt "h30b03838gbb03g4b4fgad1ag8afbde015cb0"
msgid "Let her try. My thirst for blood has yet to be quenched."
msgstr "어디 한번 해보라 그래. 아직 내 피에 대한 갈증이 풀리질 않았으니까 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Player
#. NodeID = e98fc369-17b3-75f0-76e0-971de54d511d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 40830d3a-5624-0c94-e8aa-f6d8a592de7c_TrueSoulPath = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:e98fc369-17b3-75f0-76e0-971de54d511d
msgctxt "hf09ae86dg2145g495dgbaf5g3caf7f7b6333"
msgid "I am a True Soul. And you <i>will</i> treat me with respect."
msgstr "난 참된 영혼이다. 예를 갖춰 대하도록."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Morghal
#. NodeID = ee41fb85-1797-b2dd-d800-66bcc8f0f28b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:ee41fb85-1797-b2dd-d800-66bcc8f0f28b
msgctxt "hbdc09a06g0658g43c2g9693g6a9482288c90"
msgid "You'll work through it, <i>jargh</i>. Now pay up - don't got all day."
msgstr "그럼 잘 참아야 할 거다, <i>자그</i>.이제 돈을 내, 시간이 하루 종일 있진 않으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Corsair Greymon
#. NodeID = eec05ba0-523d-0d3a-69bb-e3aab090a997
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_DarkLake_State_CampIntro(3) = True
#. SetFlags:
#.   Local:
#.     - 40830d3a-5624-0c94-e8aa-f6d8a592de7c_TrueSoulPath = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:eec05ba0-523d-0d3a-69bb-e3aab090a997
msgctxt "hfc24e820g466fg4d93g9cedgd8aa2e753c00"
msgid ""
"Aye. One of those Absolute crackpots. Found the <i>hoon</i> sailing Gekh's "
"skiff."
msgstr "그래. 그 절대자 미치광이 놈들 중 하나야. 이 <i>훈</i>이 게크의 배를 몰고 있더군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Astarion
#. NodeID = ef58bba4-336a-4e87-b13a-36228f464471
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:ef58bba4-336a-4e87-b13a-36228f464471
msgctxt "h63e502ceg1cabg47dbg906bg8ad959d389b8"
msgid "And I was worried we weren't on the same page. Let's spill their guts."
msgstr "마침 같은 생각을 하고 있는지 의심스러워 걱정이었는데. 놈들의 내장을 쏟아내 보자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Lae'zel
#. NodeID = f1365075-5c24-8051-e2e3-5663e657842b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_LAEZEL(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:f1365075-5c24-8051-e2e3-5663e657842b
msgctxt "h1bb93021g30c7g4571gae18g80e556fa12e2"
msgid ""
"I am keen to sever Nere's head. A shame we must do the favour of freeing him "
"first."
msgstr "니어의 머리를 빨리 잘라 내고 싶은데, 그를 먼저 구해줘야 한다니. 치욕스럽군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Player
#. NodeID = f326de00-b922-90a6-da8f-c41083a03127
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_CheckPocketGold = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:f326de00-b922-90a6-da8f-c41083a03127
msgctxt "hdb8acfcfg5354g4fd9ga9aeg93f304754a9d"
msgid "I don't have that kind of gold on me."
msgstr "그만큼의 금화는 없는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Shadowheart
#. NodeID = f53b9098-7004-4c36-e7b8-30c039a67feb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(6) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:f53b9098-7004-4c36-e7b8-30c039a67feb
msgctxt "h803f43e0g10abg4a4bgb549gd58590a49f1d"
msgid ""
"Let's try and keep this diplomatic. I'd rather not jump into another fight "
"quite so soon."
msgstr "외교적으로 해결해 보자고. 또 성급히 싸움에 휘말리고 싶진 않으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Morghal
#. NodeID = f5c8a548-3355-1724-1b28-2ff5cdfb0672
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:f5c8a548-3355-1724-1b28-2ff5cdfb0672
msgctxt "h10fb074bgf99ag4a6ag9c30g3296d0e9d4b8"
msgid "That's what I figured. I... nngh..."
msgstr "내가 생각했던 대로군. 난... 으윽..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Player
#. NodeID = f5e9d720-083f-5d59-4ccc-fd9da3029fe2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:f5e9d720-083f-5d59-4ccc-fd9da3029fe2
msgctxt "h18a93a4fgb9b0g4132gbf9eg8c3c5276d49b"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint
#. Speaker = Morghal
#. NodeID = f9654a99-dca9-1b67-142d-58d0a5ec75c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Checkpoint:f9654a99-dca9-1b67-142d-58d0a5ec75c9
msgctxt "hef4cf54eg6ebag4caag8580gf1f33addb445"
msgid "It's time we... nngh..."
msgstr "이제 우리가... 으윽..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning
#. Speaker = Lae'zel
#. NodeID = 00be8ccd-0db9-3950-076d-e334374b1d4e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_LAEZEL(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning:00be8ccd-0db9-3950-076d-e334374b1d4e
msgctxt "h81f06658g01b5g42a4ga2a9g2fa9d8121b2f"
msgid ""
"<i>Chk </i>- more time wasted. If only you feared the <i>ghaik</i> parasite "
"half as much as you fear the dark."
msgstr "<i>츠크</i>, 벌써 시간을 낭비했어. <i>게이크</i>를 어둠의 반만이라도 두려워해봐라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning
#. Speaker = Player
#. NodeID = 0460763b-0d3b-406c-0544-a44c1effbf90
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning:0460763b-0d3b-406c-0544-a44c1effbf90
msgctxt "h9c6a9a51g4941g40d9ga489g5592d6f46617"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning
#. Speaker = Player
#. NodeID = 102a626c-5114-44e5-8153-3d76e27d16a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning:102a626c-5114-44e5-8153-3d76e27d16a7
msgctxt "h41df9a15g5a57g4b53ga1c0gf0eec8df578e"
msgid "Whatever. I'm not afraid of a few shadows."
msgstr "알게 뭐야. 약간 어두운 거 따윈 두렵지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning
#. Speaker = Player
#. NodeID = 160f55b8-165d-4558-78c7-76e89dea59ab
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - UND_ElevatorWarning_Event_ClaimedHaveMoonlantern(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning:160f55b8-165d-4558-78c7-76e89dea59ab
msgctxt "h9ce59d0agc23cg4745gb8bfg0db2779e135d"
msgid "Of course I do. Why do you ask?"
msgstr "물론이지. 그건 왜 묻는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning
#. Speaker = Ward Magmar
#. NodeID = 17c18cdc-3ac7-ab95-eddf-e3a060bee034
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning:17c18cdc-3ac7-ab95-eddf-e3a060bee034
msgctxt "hfe1fd381g463eg4d67g95bcg92212de51892"
msgid ""
"One of them pixie-lamps. If you're headin' to Moonrise, you won't last "
"without it."
msgstr "달등불 말이야. 문라이즈로 가는 거면 달등불이 없으면 못 버틴다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning
#. Speaker = Astarion
#. NodeID = 23552e94-a25b-3f0f-7895-fe0cfc8808dc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_ASTARION(6) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning:23552e94-a25b-3f0f-7895-fe0cfc8808dc
msgctxt "hc1000264gacbbg44c4ga61cg5318226c24a0"
msgid "Afraid of the dark, are we? Very well - let us save Nere, if we must."
msgstr "어둠이 두려운가 봐? 그래, 그럼. 꼭 그래야겠다면 니어를 구하자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning
#. Speaker = Karlach
#. NodeID = 26ea2e8d-00f5-713e-07bc-80aa39bdbc80
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_KARLACH(5) = True
#. SetFlags:
#.   Local:
#.     - 99dbbd00-5f23-e332-76f2-491ecdf6d17d_Inclusion = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning:26ea2e8d-00f5-713e-07bc-80aa39bdbc80
msgctxt "hed8bb846g4e84g4df9g963ege51d365f1e47"
msgid "Sounds like bad news. I'd just as soon get that Moonlantern off Nere."
msgstr "귀찮게 되었네. 빨리 니어에게서 그 달등불을 얻어내야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning
#. Speaker = Player
#. NodeID = 2945bb7a-2285-090b-73e2-c9e2223f27cd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 99dbbd00-5f23-e332-76f2-491ecdf6d17d_Inclusion = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning:2945bb7a-2285-090b-73e2-c9e2223f27cd
msgctxt "h6e6be4cag5cb3g4e92g8a9ag88e986089c74"
msgid "We need to press on. Nere is a distraction."
msgstr "계속 가야 해. 니어는 방해만 될 뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning
#. Speaker = Wyll
#. NodeID = 29cf6af0-54ab-1959-a756-e5b8f0bd6c90
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_WYLL(7) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning:29cf6af0-54ab-1959-a756-e5b8f0bd6c90
msgctxt "hfd348cfdg5391g4fedgb341gd98f615472a1"
msgid "There we have it. Let 'Operation Free Nere' commence."
msgstr "그럼 결정이네. '니어 구출 작전'을 개시하자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning
#. Speaker = Karlach
#. NodeID = 2bc976cb-1d97-45a3-8d95-b48fa9485ba8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_KARLACH(5) = True
#. SetFlags:
#.   Local:
#.     - 99dbbd00-5f23-e332-76f2-491ecdf6d17d_Inclusion = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning:2bc976cb-1d97-45a3-8d95-b48fa9485ba8
msgctxt "h62cc81b7gd11ag43aeg8104gc29371474bf2"
msgid ""
"Must be the shadow curse. We'll need Nere's lantern if we want to get "
"through it."
msgstr "그림자의 저주인가 봐. 통과하려면 니어의 등불이 필요해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning
#. Speaker = Karlach
#. NodeID = 2f62e9c1-630e-7a5e-1ca5-ca084f0fedee
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_KARLACH(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning:2f62e9c1-630e-7a5e-1ca5-ca084f0fedee
msgctxt "h65185967ga34cg4752g853fg55e90e14e209"
msgid ""
"You just want me to die in a cursed cloud so you can take my boots. Finally, "
"the plot revealed."
msgstr "내가 저주받은 구름속에서 죽으면 부츠를 가져가려고 하는 거구나. 마침내 수수깨끼가 풀렸네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning
#. Speaker = Shadowheart
#. NodeID = 3226ee5e-9353-27b8-755c-e6707aea09d1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning:3226ee5e-9353-27b8-755c-e6707aea09d1
msgctxt "hccdfca38g4b76g4073g9ea6g78412a503b15"
msgid "Let's just hope you're right. Otherwise we're just aiding the enemy."
msgstr "네 판단이 옳기를 빌자고. 아니면 적들을 돕는 꼴일 테니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning
#. Speaker = Ward Magmar
#. NodeID = 3a405162-7c87-a336-c2df-348b1c341c33
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning:3a405162-7c87-a336-c2df-348b1c341c33
msgctxt "h33582ef7gcd43g4c9cga222ge0dd223b6843"
msgid "I ask 'cause you ain't gettin' far without one of them pixie-lamps."
msgstr "그 픽시 등불이 없이는 몇 걸음 떼지도 못할 테니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning
#. Speaker = Gale
#. NodeID = 46d019a2-759a-f1b7-1b48-eedfff1ae74a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(8) = True
#.   Tag:
#.      - REALLY_GALE(8) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning:46d019a2-759a-f1b7-1b48-eedfff1ae74a
msgctxt "h445be7e1ga15dg4540gb3ecg8edb74107b5c"
msgid "A stab in the dark it is..."
msgstr "어둠 속을 헤매는 느낌이군..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning
#. Speaker = Gale
#. NodeID = 4d6cd054-d123-2fac-7fc4-472682c2346f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(8) = True
#.   Tag:
#.      - REALLY_GALE(8) = True
#. SetFlags:
#.   Local:
#.     - 99dbbd00-5f23-e332-76f2-491ecdf6d17d_Inclusion = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning:4d6cd054-d123-2fac-7fc4-472682c2346f
msgctxt "h3fb43446g247ag4696g994cga32c8c135274"
msgid ""
"'Death-dark' doesn't sound very inviting. Can't say I fancy our chances "
"without freeing Nere and getting that Moonlantern."
msgstr "'죽음의 어둠'은 별로 매력적이지 않은데. 니어를 풀어주고 달등불을 얻지 못하면 성공 확률이 그다지 높지 않아 보이는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning
#. Speaker = Player
#. NodeID = 5288324b-a87a-14fe-79e5-cfbe44ffdba8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning:5288324b-a87a-14fe-79e5-cfbe44ffdba8
msgctxt "hc202d426gcc3cg449dgbf1bg17317a0f58f1"
msgid "'Death-dark'? Sounds like my kind of thing. What is it?"
msgstr "'죽음의 암흑'? 그게 뭐야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning
#. Speaker = Lae'zel
#. NodeID = 5436e415-ff43-b140-af70-e1c7750c1a3a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_LAEZEL(3) = True
#. SetFlags:
#.   Local:
#.     - 99dbbd00-5f23-e332-76f2-491ecdf6d17d_Inclusion = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning:5436e415-ff43-b140-af70-e1c7750c1a3a
msgctxt "hb66a2754g19c9g4ec3g92f5ge008c3bcfa52"
msgid ""
"The surface is within reach. But it may be foolish to press on before "
"finding this Nere."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning
#. Speaker = Astarion
#. NodeID = 56181bcd-d8ca-f2d4-2ae6-b3e36310e7eb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_ASTARION(6) = True
#. SetFlags:
#.   Local:
#.     - 99dbbd00-5f23-e332-76f2-491ecdf6d17d_Inclusion = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning:56181bcd-d8ca-f2d4-2ae6-b3e36310e7eb
msgctxt "h9ca438c4gd70eg4bb0g9cf2gd8941ca87873"
msgid ""
"I'm one of the reasons people fear the shadows, but even I'd rather "
"investigate this Moonlantern before going to the surface."
msgstr ""
"다들 그림자를 두려워하는 이유 중 하나가 바로 나야. 하지만 아무리 이런 나라도 지상으로 올라가기 전에 먼저 달등불을 조사하겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning
#. Speaker = Karlach
#. NodeID = 61265790-dc5b-375c-6ea8-43c1527659eb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_KARLACH(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning:61265790-dc5b-375c-6ea8-43c1527659eb
msgctxt "h8cc5c2afgaee6g4734g8536g6218b8e020ac"
msgid "Agreed. Next stop: Nere."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning
#. Speaker = Player
#. NodeID = 669029b4-5c4b-1674-a749-dced3293765f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning:669029b4-5c4b-1674-a749-dced3293765f
msgctxt "hfe4c4614gf8eeg464agb6b6g7157124a8de2"
msgid "A Moonlantern? What's that?"
msgstr "달등불이라고? 그게 뭐야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning
#. Speaker = Player
#. NodeID = 69a8df54-c9a8-0850-b0b6-ca839fbf1324
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning:69a8df54-c9a8-0850-b0b6-ca839fbf1324
msgctxt "h2360cefbg5233g4876gbf4cgdcc53636f476"
msgid "I've seen much death already... I'll be careful."
msgstr "죽음이라면 신물나게 봤어...알아서 조심할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning
#. Speaker = Player
#. NodeID = 6d685a1f-db33-406a-9d04-24a1851577cf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning:6d685a1f-db33-406a-9d04-24a1851577cf
msgctxt "h86d2cd3ag6258g4038g8d87g04f467e33e36"
msgid "'Death-dark'? What are you talking about?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning
#. Speaker = Player
#. NodeID = 6e9787c0-ce38-ec00-8df4-7099b2f3fff6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning:6e9787c0-ce38-ec00-8df4-7099b2f3fff6
msgctxt "h12e89f5fge957g4f30g8133g3a0008c11fc9"
msgid "Thanks for sharing. I'll keep it in mind."
msgstr "알려줘서 고마워. 명심할게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning
#. Speaker = Player
#. NodeID = 83daac19-b56a-3edf-522a-4f878a2576a1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 99dbbd00-5f23-e332-76f2-491ecdf6d17d_Inclusion = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning:83daac19-b56a-3edf-522a-4f878a2576a1
msgctxt "h1b5eda5bge1a6g4a30gb568g26fb1d908473"
msgid "That Moonlantern is key to our survival. And that means freeing Nere."
msgstr "달등불은 우리 생존의 열쇠야. 그 말인즉슨 니어를 구출해야 한다는 거지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning
#. Speaker = Wyll
#. NodeID = 84047d39-4101-7e58-e9a7-1840e4a0ca3d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_WYLL(7) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning:84047d39-4101-7e58-e9a7-1840e4a0ca3d
msgctxt "h4d7d4889gac4ag4fd2gb1c1g4981f95fc062"
msgid ""
"So we're going up there without the lantern? I hope you know what you're "
"doing."
msgstr "저길 달등불 없이 올라가겠다고? 네가 뭘 하려는지 알길 바라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning
#. Speaker = Lae'zel
#. NodeID = 84ad8cce-ac8f-42e3-9908-a8c29f03d17c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_LAEZEL(3) = True
#. SetFlags:
#.   Local:
#.     - 99dbbd00-5f23-e332-76f2-491ecdf6d17d_Inclusion = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning:84ad8cce-ac8f-42e3-9908-a8c29f03d17c
#, fuzzy
msgctxt "hb1d736a2g025ag49d8gb835gbf68f7291d1c"
msgid ""
"He speaks of the shadow curse. Moonrise must be close, but it would be "
"foolish to press on before seeking out this Nere."
msgstr "그는 그림자 저주를 말하는 거야. 니어와 달등불은 잊어버려 - 우리가 이만큼 가까이 왔다면 위험을 무릅쓰고 나아가야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning
#. Speaker = Wyll
#. NodeID = 88249686-8185-4c3f-bcd3-f5ee94163ec5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_WYLL(7) = True
#. SetFlags:
#.   Local:
#.     - 99dbbd00-5f23-e332-76f2-491ecdf6d17d_Inclusion = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning:88249686-8185-4c3f-bcd3-f5ee94163ec5
msgctxt "hf402518fgcaccg44d4gadb1gecd573e94f6b"
msgid ""
"The shadow curse. We'll need that Moonlantern from Nere to survive the "
"journey to Moonrise Towers."
msgstr "그림자 저주야. 문라이즈 타워로 향하는 여정에서 살아남으려면 니어가 가진 그 달등불이 필요해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning
#. Speaker = Player
#. NodeID = 8969c46a-a999-f514-7474-ab4662b5faed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning:8969c46a-a999-f514-7474-ab4662b5faed
msgctxt "h2bd1f416g50edg462eg8f85ga74245396bc3"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning
#. Speaker = Player
#. NodeID = 952780a5-e567-bce1-01f2-fe9ac98be93f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning:952780a5-e567-bce1-01f2-fe9ac98be93f
msgctxt "hb7c2ab8cg2350g4f9dgabbagd89cf51f441c"
msgid "No. So what?"
msgstr "없는데, 왜?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning
#. Speaker = Gale
#. NodeID = 96361cf9-b860-e48a-bd55-dd2d9cbb973a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(8) = True
#.   Tag:
#.      - REALLY_GALE(8) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning:96361cf9-b860-e48a-bd55-dd2d9cbb973a
msgctxt "h5d593ad8g9c95g4d30gaa63g64d1e0c80ecb"
msgid "My thoughts exactly."
msgstr "내 생각도 그래."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning
#. Speaker = Player
#. NodeID = 9c7f0f00-3444-b4bc-0728-520da6659e66
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 99dbbd00-5f23-e332-76f2-491ecdf6d17d_Inclusion = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning:9c7f0f00-3444-b4bc-0728-520da6659e66
msgctxt "h9829f162g4426g40eeg8c36g2e2b2366a425"
msgid "That Moonlantern is key to our survival. And that means freeing Nere."
msgstr "달등불은 우리 생존의 열쇠야. 그 말인즉슨 니어를 구출해야 한다는 거지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning
#. Speaker = Shadowheart
#. NodeID = a4ddfc20-6ecc-484d-8125-80799d459cf6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(4) = True
#. SetFlags:
#.   Local:
#.     - 99dbbd00-5f23-e332-76f2-491ecdf6d17d_Inclusion = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning:a4ddfc20-6ecc-484d-8125-80799d459cf6
#, fuzzy
msgctxt "h26ad3f59g44ffg4cbeg840ag3ae49f8331f9"
msgid ""
"Sounds like the shadow curse. We must be getting close to Moonrise. Perhaps "
"we should seek out this Nere while we can, though."
msgstr "그림자 저주처럼 들리는데. 가까이 온 것이 틀림없어. 니어와 달등불은 잊어버려 - 계속 강행하자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning
#. Speaker = Lae'zel
#. NodeID = adeb8a71-693d-c754-d339-375a673b940b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_LAEZEL(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning:adeb8a71-693d-c754-d339-375a673b940b
msgctxt "he02d7f98gfe11g433eg9579gf69c70407c47"
msgid "Forward, then. No curse will keep me from purification."
msgstr "그러면 전진하는 거다. 그 어떤 저주도 나의 정화를 막을 순 없지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning
#. Speaker = Player
#. NodeID = b09096df-f7dd-a576-7961-7e46872ceb87
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 99dbbd00-5f23-e332-76f2-491ecdf6d17d_Inclusion = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning:b09096df-f7dd-a576-7961-7e46872ceb87
msgctxt "ha297573fg3b2eg4042g8d33gd82d152c4293"
msgid ""
"Moonrise Towers holds the answers we seek. Curse or not, we can't turn back "
"now."
msgstr "문라이즈 타워가 우리가 찾는 답을 쥐고 있어. 저주가 걸렸더라도 지금 돌아설 수는 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning
#. Speaker = Gale
#. NodeID = b6b9bfd0-736a-4831-a713-c6eec249741c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(8) = True
#.   Tag:
#.      - REALLY_GALE(8) = True
#. SetFlags:
#.   Local:
#.     - 99dbbd00-5f23-e332-76f2-491ecdf6d17d_Inclusion = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning:b6b9bfd0-736a-4831-a713-c6eec249741c
msgctxt "hba34caa1gf0c0g4177gbd91g49afdb585118"
msgid ""
"We were warned about the curse. Can't say I fancy our chances without a "
"Moonlantern."
msgstr "저주에 대해서는 미리 경고를 받았었지. 달등불 없이는 성공 확률이 그다지 높지 않아 보이는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning
#. Speaker = Shadowheart
#. NodeID = b92a5107-e411-bed7-2fd6-ea87ae3ff08d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(4) = True
#. SetFlags:
#.   Local:
#.     - 99dbbd00-5f23-e332-76f2-491ecdf6d17d_Inclusion = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning:b92a5107-e411-bed7-2fd6-ea87ae3ff08d
msgctxt "h0b9d1937gfadbg400cga6b8g07df8824ae62"
msgid ""
"No surprises that there's danger ahead, but we're getting closer. Perhaps we "
"should seek out Nere while we can, though."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning
#. Speaker = Ward Magmar
#. NodeID = c8934dd2-58cc-4b4e-853b-8d61481eda08
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning:c8934dd2-58cc-4b4e-853b-8d61481eda08
msgctxt "hb401df8ega462g4217gaac6gb0c530e03eb8"
msgid ""
"You daft? It's there in the name. Shadows up there, black as the Lowerdark. "
"A few sniffs could fell an ogre."
msgstr "바보냐? 이름대로잖아. 그림자로 가득 차 있고 로어다크처럼 깜깜하다고. 몇 번만 킁킁대도 오거도 쓰러질걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning
#. Speaker = Shadowheart
#. NodeID = cb3b36eb-53ad-eb3f-4916-a2f52b866ade
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning:cb3b36eb-53ad-eb3f-4916-a2f52b866ade
msgctxt "h097ac2eeg665ag4ffbgb5c6g9ce1da7137a9"
msgid "Good. After all we've been through, this is hardly the time to falter."
msgstr "좋아. 지금까지 고생했는데 머뭇거릴 때가 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning
#. Speaker = Astarion
#. NodeID = d4cff485-81b1-4354-994e-ed8ab3895418
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_ASTARION(6) = True
#. SetFlags:
#.   Local:
#.     - 99dbbd00-5f23-e332-76f2-491ecdf6d17d_Inclusion = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning:d4cff485-81b1-4354-994e-ed8ab3895418
msgctxt "hf76f95efg661cg48acg8815gbb3452edc42d"
msgid ""
"If the cure's in Moonrise, we should go, Nere and his lantern be damned. "
"After all, 'shadows' will be the least of our worries if we start to turn."
msgstr ""
"문라이즈에 치료법이 있다면 가야해. 니어랑 그 달등불은 개나 주라지. 만약 변이가 시작된다면 '그림자' 따위는 눈에 들어오지도 않을거라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning
#. Speaker = Ward Magmar
#. NodeID = d9f25bb1-471e-7af1-52ab-a77755da60c0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_Elevator_Event_GotWarning = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning:d9f25bb1-471e-7af1-52ab-a77755da60c0
msgctxt "h006a5fd5g731bg48b9gb366gf4a6645bb2ae"
msgid "Shit. You got one of Nere's Moonlanterns, <i>jargh</i>?"
msgstr "젠장. 너 니어의 달등불을 갖고 있긴 하냐, <i>자그</i>?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning
#. Speaker = Astarion
#. NodeID = ddec92b3-5d72-d815-17bc-53657eeb5ca3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_ASTARION(6) = True
#. TagRule: !REALLY_DUERGARDWARF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning:ddec92b3-5d72-d815-17bc-53657eeb5ca3
msgctxt "hb332885bg5903g45deg90a3gd3ee44f4d89c"
msgid ""
"Excellent. The less time I have to spend with these underdwarves, the better."
msgstr "훌륭해. 이 언더드와프들이랑은 더 빨리 헤어질수록 더 좋지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning
#. Speaker = Astarion
#. NodeID = ddec92b3-5d72-d815-17bc-53657eeb5ca3
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_ASTARION(6) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning:ddec92b3-5d72-d815-17bc-53657eeb5ca3
msgctxt "hb7c52f08gca25g464ega42bgd35ebf6a0f90"
msgid ""
"Excellent. The less time I have to spend with these underdwarves, the "
"better. Present company excluded, of course."
msgstr "훌륭해. 이 언더드와프들이랑 더 적은 시간을 보낼수록 더 좋지. 물론 여기 있는 분은 제외하고 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning
#. Speaker = Ward Pistle
#. NodeID = e2e79526-3cef-4662-84bc-bae9d562898b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Shadowcurse_Knows_FromDuergar = True
#.     - GLO_Player_Knows_MoonlanternExists = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning:e2e79526-3cef-4662-84bc-bae9d562898b
#, fuzzy
msgctxt "h24ca37a4g2d27g4f6bgb049geee2887e4264"
msgid "Top-lands are clogged with the death-dark, choke you in no time."
msgstr "위쪽 땅은 죽음의 그림자로 뒤덮여서 널 순식간에 질식시켜버릴걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning
#. Speaker = Ward Magmar
#. NodeID = e3ab0fda-0dca-61db-ffba-82608257ae7f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning:e3ab0fda-0dca-61db-ffba-82608257ae7f
msgctxt "hbdfc01b1g0286g42c8gb37agaba31b8da78d"
msgid ""
"Go on, get some air. But don't go cursing me if that shadow-shit snuffs you."
msgstr "맘대로 해, 가서 위 공기 좀 쐬든가. 그 그림자 새끼가 네 횃불을 꺼버려도 날 책망하진 말고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning
#. Speaker = Ward Magmar
#. NodeID = e9b031fe-4a72-4883-98ef-58d4ae3daf6a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning:e9b031fe-4a72-4883-98ef-58d4ae3daf6a
msgctxt "h59524e8ag9d4bg44d3gbaa8g8446b3b6b6a5"
msgid ""
"Well, damn. Then go on up, take a stroll. Long as you keep your lips off our "
"ale, I don't give two shits."
msgstr "대단하시네. 그럼 올라가서 산책이나 한 바퀴 도시던가. 그 주둥아리가 에일을 축내지만 않는다면야 좆도 신경 안 써."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning
#. Speaker = Wyll
#. NodeID = ed2e8f39-98d4-717e-c6ab-a59b733617a8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_WYLL(7) = True
#. SetFlags:
#.   Local:
#.     - 99dbbd00-5f23-e332-76f2-491ecdf6d17d_Inclusion = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning:ed2e8f39-98d4-717e-c6ab-a59b733617a8
msgctxt "h1b1106b4gce73g4f8ag8c21ga19be767f56d"
msgid ""
"I'm not so keen on taking a shadow-nap, myself. We need to free Nere and get "
"that Moonlantern."
msgstr "그림자 속에서 낮잠에 빠지는 건 별로 달갑지 않은걸. 니어를 구하고 그 달등불을 얻어야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning
#. Speaker = Ward Magmar
#. NodeID = eede64f2-58db-fe50-2941-9cd9b6220d07
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarning:eede64f2-58db-fe50-2941-9cd9b6220d07
msgctxt "h4d5f1d29ge847g4059gac73g956311034b4e"
msgid ""
"So if you're headin' Moonrise-way, you ain't gettin' far. Not without one of "
"Nere's pixie-lamps."
msgstr "문라이즈 쪽으로 가는 거면 멀리 못 갈 거야. 니어의 달등불이 없으면 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome
#. Speaker = Lae'zel
#. NodeID = 0bba96ff-ae14-de6a-5322-3088f550ac26
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(2) = True
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome:0bba96ff-ae14-de6a-5322-3088f550ac26
msgctxt "h0b4ae8d3g9c80g43cdg813cgd2f864c6102b"
msgid "Forward, then. No curse will keep me from purification."
msgstr "그러면 전진하는 거다. 그 어떤 저주도 나의 정화를 막을 순 없지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome
#. Speaker = Player
#. NodeID = 0d027b29-d2ce-4a26-ba49-f6baad9f446a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome:0d027b29-d2ce-4a26-ba49-f6baad9f446a
msgctxt "hdb40997cg9167g4462gac76gf2ee84239cf2"
msgid "Whatever. I'm not afraid of the dark."
msgstr "뭐래. 어둠따윈 무섭지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome
#. Speaker = Player
#. NodeID = 10c9cfb4-a46e-4dd4-9f29-934ff05f129d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - UND_ElevatorWarning_Event_ClaimedHaveMoonlantern(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome:10c9cfb4-a46e-4dd4-9f29-934ff05f129d
msgctxt "h6217a4ceg07a1g44aegb468g559a27f7d4a1"
msgid "I do have a Moonlantern, as it happens. Right here in my pouch."
msgstr "그러고보니 달등불이 있었네. 바로 여기 내 배낭 안에 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome
#. Speaker = Skickpit
#. NodeID = 1318a0bc-03ec-436b-9de4-075af5e79317
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome:1318a0bc-03ec-436b-9de4-075af5e79317
msgctxt "h4f5d8008g49f2g4472ga867g4a01908376ae"
msgid "One of Nere's magic lamps. You won't last without one."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome
#. Speaker = Karlach
#. NodeID = 1eb47031-7dda-200a-b5ef-aa485e0cf0b9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_KARLACH(4) = True
#. SetFlags:
#.   Local:
#.     - 5f10543d-c03b-da24-5b4f-89f6b9c86de2_Inclusion = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome:1eb47031-7dda-200a-b5ef-aa485e0cf0b9
msgctxt "h79f676fdg3ea9g43a6g8cb9gf5e96f35c1ed"
msgid ""
"Must be the shadow curse. I <i>really </i>don't think we should go wandering "
"in without protection."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome
#. Speaker = Gale
#. NodeID = 376555d1-09fd-38a5-cf2b-9d55a2690242
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_GALE(7) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome:376555d1-09fd-38a5-cf2b-9d55a2690242
msgctxt "h8d4fa069gf27eg4f3dgba4dgb86ea8ff86a5"
msgid "My thoughts exactly."
msgstr "내 생각도 그래."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome
#. Speaker = Lae'zel
#. NodeID = 3870e67a-0057-f657-e5c1-4761820ad3b8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(2) = True
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
#. SetFlags:
#.   Local:
#.     - 5f10543d-c03b-da24-5b4f-89f6b9c86de2_Inclusion = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome:3870e67a-0057-f657-e5c1-4761820ad3b8
msgctxt "h64535b17g6458g4e16g811ag11f1c647ea84"
msgid ""
"He speaks of the shadow curse. Forget Nere and the Moonlantern - if we're "
"this close to the surface, we must chance the journey."
msgstr "그는 그림자 저주를 말하는 거야. 니어와 달등불은 잊어버려 - 우리가 이만큼 가까이 왔다면 위험을 무릅쓰고 나아가야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome
#. Speaker = Astarion
#. NodeID = 3d080eef-57a4-999b-a441-2d71d2a10c30
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#. TagRule: !REALLY_DUERGARDWARF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome:3d080eef-57a4-999b-a441-2d71d2a10c30
msgctxt "h3628d3d4g56d6g4b5ag95d9g0c0f01da2c3b"
msgid ""
"Excellent. The less time I have to spend with these underdwarves, the better."
msgstr "훌륭해. 이 언더드와프들이랑 더 빨리 헤어질수록 더 좋지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome
#. Speaker = Astarion
#. NodeID = 3d080eef-57a4-999b-a441-2d71d2a10c30
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome:3d080eef-57a4-999b-a441-2d71d2a10c30
msgctxt "he7cf824fgd495g4ef9g9990gdaeffa16cd8f"
msgid ""
"Excellent. The less time I have to spend with these underdwarves, the "
"better. Present company excluded, of course."
msgstr "훌륭해. 이 언더드와프들이랑 더 적은 시간을 보낼수록 더 좋지. 여기 있는 분은 당연히 제외하고 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome
#. Speaker = Wyll
#. NodeID = 3e238319-8831-7b73-04c7-4097496948a1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_WYLL(6) = True
#. SetFlags:
#.   Local:
#.     - 5f10543d-c03b-da24-5b4f-89f6b9c86de2_Inclusion = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome:3e238319-8831-7b73-04c7-4097496948a1
msgctxt "h380ccd7eg4adag4344ga0f1g81923a895cfb"
msgid ""
"The shadow curse. We'll need that Moonlantern from Nere to survive the "
"journey to Moonrise Towers."
msgstr "그림자 저주야. 문라이즈 타워로 향하는 여정에서 살아남으려면 니어가 가진 그 달등불이 필요해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome
#. Speaker = Wyll
#. NodeID = 46fe9c22-acdc-51a8-8ba9-c3667ad70759
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_WYLL(6) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome:46fe9c22-acdc-51a8-8ba9-c3667ad70759
msgctxt "h6227aa4ega462g4e1agaa50g9e62358d4d8b"
msgid ""
"So we're going up there without the lantern? I hope you know what you're "
"doing."
msgstr "저길 달등불 없이 올라가겠다고? 네가 뭘 하려는지 알길 바라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome
#. Speaker = Shadowheart
#. NodeID = 4a96407f-c272-20a6-3489-a819913debe4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#. SetFlags:
#.   Local:
#.     - 5f10543d-c03b-da24-5b4f-89f6b9c86de2_Inclusion = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome:4a96407f-c272-20a6-3489-a819913debe4
msgctxt "hd59abb5cg8d91g4556g9401g542a78774805"
msgid ""
"Sounds like the shadow curse. We must be getting close. Forget Nere and the "
"Moonlantern -  let's just press on."
msgstr "그림자 저주처럼 들리는데. 가까이 온 것이 틀림없어. 니어와 달등불은 잊어버려 - 계속 강행하자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome
#. Speaker = Karlach
#. NodeID = 66117a8e-41b2-bf7e-9825-ec1d2d847f5d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_KARLACH(4) = True
#. SetFlags:
#.   Local:
#.     - 5f10543d-c03b-da24-5b4f-89f6b9c86de2_Inclusion = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome:66117a8e-41b2-bf7e-9825-ec1d2d847f5d
msgctxt "he9e6c23fg1030g4979gbc51ge62b2043df62"
msgid ""
"Erm. Shouldn't we go grab that Moonlantern before wandering into what sounds "
"an awful lot like an <i>abyss?</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome
#. Speaker = Skickpit
#. NodeID = 6818208b-2123-442f-a00c-008f40923023
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome:6818208b-2123-442f-a00c-008f40923023
msgctxt "h3efac06egd0adg4073g810eg8cc74941302d"
msgid "Shit - good thing, too. You won't get far without one."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome
#. Speaker = Shadowheart
#. NodeID = 701d6c31-2be7-6d9c-2572-9739feb2c425
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome:701d6c31-2be7-6d9c-2572-9739feb2c425
msgctxt "h25290e78g94c9g467bgb418g6b4c4892f71d"
msgid "Let's just hope you're right. Otherwise we're just aiding the enemy."
msgstr "네 판단이 옳기를 빌자고. 아니면 적들을 돕는 꼴일 테니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome
#. Speaker = Lae'zel
#. NodeID = 7338641f-1cf9-1442-3212-c1d46e222060
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(2) = True
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome:7338641f-1cf9-1442-3212-c1d46e222060
msgctxt "h33811abeg1c8bg4afcg852cga37893b5757f"
msgid ""
"<i>Chk </i>- more time wasted. If only you feared the <i>ghaik</i> parasite "
"half as much as you fear the dark."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome
#. Speaker = Gale
#. NodeID = 79b3114f-96f0-3ddb-8f09-9714bb22328b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_GALE(7) = True
#. SetFlags:
#.   Local:
#.     - 5f10543d-c03b-da24-5b4f-89f6b9c86de2_Inclusion = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome:79b3114f-96f0-3ddb-8f09-9714bb22328b
msgctxt "h89046aedgb74cg43fcg8e69g41b8e30347e3"
msgid ""
"We were warned about the curse. Can't say I fancy our chances without a "
"Moonlantern."
msgstr "저주에 대해서는 미리 경고를 받았었지. 달등불 없이는 성공 확률이 그다지 높지 않아 보이는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome
#. Speaker = Player
#. NodeID = 8eeb42c1-00db-4b36-b281-ac4b52f8f3e8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome:8eeb42c1-00db-4b36-b281-ac4b52f8f3e8
msgctxt "ha93f73a3g423dg4445g8e91g1805a269ec3d"
msgid "A Moonlantern? What's that?"
msgstr "달등불? 그게 뭔데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome
#. Speaker = Karlach
#. NodeID = 8f5d6eee-bd7f-9aab-8fbf-70e9c07f1ab4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_KARLACH(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome:8f5d6eee-bd7f-9aab-8fbf-70e9c07f1ab4
msgctxt "h87ecb904g226bg421cg97fbgb59cdfef6665"
msgid "Gotta be done. Let's go."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome
#. Speaker = Player
#. NodeID = 96ee0244-22a7-49a4-abe9-06df9a555010
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome:96ee0244-22a7-49a4-abe9-06df9a555010
msgctxt "h93d9055ag9cbbg4ca7g9dd9ged8bdb68a9aa"
msgid "'Death-dark'? What are you talking about?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome
#. Speaker = Player
#. NodeID = 99317378-28cf-5468-c1d1-596c508e7fc1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 5f10543d-c03b-da24-5b4f-89f6b9c86de2_Inclusion = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome:99317378-28cf-5468-c1d1-596c508e7fc1
msgctxt "h8d088b4eg98ecg4ad9g928cg274123d5f660"
msgid "That Moonlantern is key to our survival. And that means freeing Nere."
msgstr "달등불은 우리 생존의 열쇠야. 그 말인즉슨 니어를 구출해야 한다는 거지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome
#. Speaker = Astarion
#. NodeID = 9c926baa-ad94-3c99-2fd6-149f9d62df33
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#. SetFlags:
#.   Local:
#.     - 5f10543d-c03b-da24-5b4f-89f6b9c86de2_Inclusion = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome:9c926baa-ad94-3c99-2fd6-149f9d62df33
msgctxt "h39d343e1gad2cg45f3ga2a8g0c8634a5f0e2"
msgid ""
"If the cure's in Moonrise, we should go, Nere and his lantern be damned. "
"After all, 'shadows' will be the least of our worries if we start to turn."
msgstr ""
"문라이즈에 치료법이 있다면 가야해. 니어랑 그 달등불은 개나 주라지. 만약 변이가 시작된다면 '그림자' 따위는 눈에 들어오지도 않을거라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome
#. Speaker = Skickpit
#. NodeID = 9effab9d-a79f-94e8-e54d-90cef4b1721c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome:9effab9d-a79f-94e8-e54d-90cef4b1721c
msgctxt "hf7d434cfgb297g4836ga3e2g8842fca7d95b"
msgid "Go on up, if you fancy. Me? I'd sooner take a swim in the Darklake."
msgstr "그렇게 원하면 올라가봐. 나는 차라리 칠흑호수에서 수영하는 걸 택하겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome
#. Speaker = Player
#. NodeID = 9f2348ed-dc06-434b-bc5c-90d67762a696
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome:9f2348ed-dc06-434b-bc5c-90d67762a696
msgctxt "h6981882cg7394g4ef7g955cgb6c92b9d0e7e"
msgid "Thanks for sharing. I'll keep it in mind."
msgstr "알려줘서 고마워. 명심할게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome
#. Speaker = Gale
#. NodeID = 9fae5659-7aa5-3784-547b-34c3319db78a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_GALE(7) = True
#. SetFlags:
#.   Local:
#.     - 5f10543d-c03b-da24-5b4f-89f6b9c86de2_Inclusion = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome:9fae5659-7aa5-3784-547b-34c3319db78a
msgctxt "he975df00g4c5cg4d77gb05egd3a280804bd2"
msgid ""
"'Death-dark' doesn't sound very inviting. Can't say I fancy our chances "
"without freeing Nere and getting that Moonlantern."
msgstr "'죽음의 어둠'은 별로 매력적이지 않은데. 니어를 풀어주고 달등불을 얻지 못하면 성공 확률이 그다지 높지 않아 보이는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome
#. Speaker = Astarion
#. NodeID = a5d0deda-9041-bab6-9ddc-b3dbc7a06d28
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#. SetFlags:
#.   Local:
#.     - 5f10543d-c03b-da24-5b4f-89f6b9c86de2_Inclusion = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome:a5d0deda-9041-bab6-9ddc-b3dbc7a06d28
msgctxt "hcbe6fe65gd9fdg4947gbb8ag312ad6b4896d"
msgid ""
"Let's just go, Nere and the Moonlantern be damned. After everything we've "
"been through, I think we can handle a few shadows."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome
#. Speaker = Gale
#. NodeID = a6b2412c-5c82-681b-f41e-2c02d9bb091f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_GALE(7) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome:a6b2412c-5c82-681b-f41e-2c02d9bb091f
msgctxt "h6fc0b42fg2187g4336g9358g1898b5444e7b"
msgid "A stab in the dark it is..."
msgstr "어둠 속을 헤매는 느낌이군..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome
#. Speaker = Astarion
#. NodeID = a8622c01-96c3-387d-b351-1a097e103fb1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome:a8622c01-96c3-387d-b351-1a097e103fb1
msgctxt "hce6f4eb3g6436g4709g8dcag5340887597ac"
msgid "Afraid of the dark, are we? Very well - let us save Nere, if we must."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome
#. Speaker = Player
#. NodeID = b716c6a6-178f-2842-6991-b95048ecbcfb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome:b716c6a6-178f-2842-6991-b95048ecbcfb
msgctxt "ha0668c53gc1deg4a48g89c1gcf51ddb0b404"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome
#. Speaker = Player
#. NodeID = b87910f1-e6be-46f7-97c6-8ded021ccd6f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome:b87910f1-e6be-46f7-97c6-8ded021ccd6f
msgctxt "h64c35872g8bb7g4a57g80eagbe8bb74d76d0"
msgid "I don't have a Moonlantern. So what?"
msgstr "달등불 없는데, 그래서 뭐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome
#. Speaker = Lae'zel
#. NodeID = b92fe34d-0d26-4c35-9991-d22f3d5aa7b7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(2) = True
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
#. SetFlags:
#.   Local:
#.     - 5f10543d-c03b-da24-5b4f-89f6b9c86de2_Inclusion = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome:b92fe34d-0d26-4c35-9991-d22f3d5aa7b7
msgctxt "h4b5510fbg2639g45c1gb65fge3c43c691cd4"
msgid ""
"The surface is within reach. Forget Nere, forget the Moonlantern - I hardly "
"fear a few shadows."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome
#. Speaker = Karlach
#. NodeID = c3365c1d-6764-22ab-9a80-43581556d1b0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_KARLACH(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome:c3365c1d-6764-22ab-9a80-43581556d1b0
msgctxt "hd0d7be39gc810g4853g9e6bgfbe89c7445a8"
msgid "It's your funeral. And mine. I'm not ready!"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome
#. Speaker = Wyll
#. NodeID = d36126dc-a938-fa37-d3ac-358f4c73a045
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_WYLL(6) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome:d36126dc-a938-fa37-d3ac-358f4c73a045
msgctxt "h84df4490gd0f6g44dcg8683g64c70515d3b6"
msgid "There we have it. Let 'Operation Free Nere' commence."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome
#. Speaker = Player
#. NodeID = d5c4aad7-d57f-118c-d850-c3ffbfb0157d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 5f10543d-c03b-da24-5b4f-89f6b9c86de2_Inclusion = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome:d5c4aad7-d57f-118c-d850-c3ffbfb0157d
msgctxt "h5e23fa3fg9a79g4150gb86eg2de8e0d8d9a5"
msgid "We should move on, 'death-dark' or not."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome
#. Speaker = Shadowheart
#. NodeID = de00a486-3aa5-2108-07e0-47eaa2ee9f87
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome:de00a486-3aa5-2108-07e0-47eaa2ee9f87
msgctxt "h87174c71ge359g4322gb866g2621f83afae0"
msgid "Good. After all we've been through, this is hardly the time to falter."
msgstr "좋아. 지금까지 고생했는데 머뭇거릴 때가 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome
#. Speaker = Player
#. NodeID = e01cfcff-8994-e4a8-9af3-b32eed98b231
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 5f10543d-c03b-da24-5b4f-89f6b9c86de2_Inclusion = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome:e01cfcff-8994-e4a8-9af3-b32eed98b231
msgctxt "h214f1560g2d79g4eafg8b72gdcaf6ae72693"
msgid "That Moonlantern is key to our survival. And that means freeing Nere."
msgstr "달등불은 우리 생존의 열쇠야. 그 말인즉슨 니어를 구출해야 한다는 거지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome
#. Speaker = Skickpit
#. NodeID = e08ab750-4e5d-40cb-a2b3-1f6d55c8faf8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome:e08ab750-4e5d-40cb-a2b3-1f6d55c8faf8
msgctxt "h87b71e97gfcaag40b1gb967g54897121c19f"
msgid ""
"Shadows - thick as a duerro's skull. Sucks the breath right out of your "
"lungs."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome
#. Speaker = Player
#. NodeID = e5582c71-2c72-9809-c83b-0dd81c67d22f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 5f10543d-c03b-da24-5b4f-89f6b9c86de2_Inclusion = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome:e5582c71-2c72-9809-c83b-0dd81c67d22f
msgctxt "hdde3bc66g01c2g4b2agad86g1dd2c66b324d"
msgid ""
"Moonrise Towers holds the answers we seek. Curse or not, we can't turn back "
"now."
msgstr "문라이즈 타워가 우리가 찾는 답을 쥐고 있어. 저주가 걸렸더라도 지금 돌아설 수는 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome
#. Speaker = Skickpit
#. NodeID = ee0814de-d21f-4349-8d8a-e2bd6adc7ae7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_Elevator_Event_GotWarning = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome:ee0814de-d21f-4349-8d8a-e2bd6adc7ae7
msgctxt "h2cdf536bg3903g423fg92f9ge6d642814d92"
msgid ""
"You're going up <i>there? </i>You've either got iron guts - or one of those "
"Moonlanterns."
msgstr "<i>저길</i> 올라가겠다고? 강철 심장을 가졌거나 달등불이 있나보네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome
#. Speaker = Wyll
#. NodeID = f1ce6929-1df1-7634-c25c-85f0dfc703e3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_WYLL(6) = True
#. SetFlags:
#.   Local:
#.     - 5f10543d-c03b-da24-5b4f-89f6b9c86de2_Inclusion = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome:f1ce6929-1df1-7634-c25c-85f0dfc703e3
msgctxt "hb5754597g8a79g4af9g9245gb3f8e78ae252"
msgid ""
"I'm not so keen on taking a shadow-nap, myself. We need to free Nere and get "
"that Moonlantern."
msgstr "그림자 속에서 낮잠에 빠지는 건 별로 달갑지 않은걸. 니어를 구하고 그 달등불을 얻어야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome
#. Speaker = Shadowheart
#. NodeID = f8b7fb0a-ea73-56d9-a824-a98f477f33ee
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#. SetFlags:
#.   Local:
#.     - 5f10543d-c03b-da24-5b4f-89f6b9c86de2_Inclusion = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome:f8b7fb0a-ea73-56d9-a824-a98f477f33ee
msgctxt "hbd363d58gb62dg4aecgaf0eg07d621c2bc2b"
msgid ""
"No surprises that there's danger ahead, but at least we're getting closer. "
"Leave Nere to rot - we should press on."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome
#. Speaker = Skickpit
#. NodeID = fa94ce8a-f681-4f4b-bcf1-12deb84f1aee
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Player_Knows_MoonlanternExists = True
#.     - GLO_Shadowcurse_Knows_FromGnome = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome:fa94ce8a-f681-4f4b-bcf1-12deb84f1aee
#, fuzzy
msgctxt "he9854161g2fe6g4d9eg9f8bg5a8faac7243a"
msgid ""
"The death-dark's clogged the top-land, clear to Moonrise Towers. Only a "
"Moonlantern dispels it."
msgstr "위쪽 땅은 죽음의 그림자가 문라이즈 타워까지 뒤덮었어. 오직 달등불만이 그림자를 헤쳐 없앨 수 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome
#. Speaker = Player
#. NodeID = fb45bb4d-39ff-c8bc-19f4-15f1e2eb0769
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome:fb45bb4d-39ff-c8bc-19f4-15f1e2eb0769
msgctxt "h32490593g6252g45cag9f51gf7a9599beb20"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome
#. Speaker = Skickpit
#. NodeID = fdd02a3c-4a8e-412c-8263-f138c1033bb2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome:fdd02a3c-4a8e-412c-8263-f138c1033bb2
msgctxt "hbb72ad66g47efg4ca9g90b9g0d3b76ac8dd2"
msgid "Well you should be. That stuff will end you in two flaps of a batwing."
msgstr "무서워해야 할걸. 그건 박쥐가 날갯짓을 두 번 하기도 전에 널 끝장낼 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome
#. Speaker = Skickpit
#. NodeID = ff422f62-9205-45da-b689-80153708ff99
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_ElevatorWarningGnome:ff422f62-9205-45da-b689-80153708ff99
msgctxt "ha9cfd4e1gaca8g4731g808bgcd4693815030"
msgid "So you won't be getting far - not without one of Nere's magic lamps."
msgstr "그럼 멀리 못 가겠네 - 니어의 마법 등불들 중 하나가 없으면 어림도 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_HangedDrow_Dead
