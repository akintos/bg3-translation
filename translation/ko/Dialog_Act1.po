msgctxt "hbc51b55fge278g4ee5ga326g0bc4eb541c0a"
msgid "NO! He's OURS!"
msgstr "<b>안 돼!</b> 이 녀석은 <b>우리 꺼야!</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerCharmed
