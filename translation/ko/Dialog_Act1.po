msgctxt "h7e6de3b2g9f41g46bagb6beg66429183ac3e"
msgid "*The corpse regards you lifelessly.*"
msgstr "*시체가 생기 없는 모습으로 당신을 맞이합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_DeadPrisoner_Dead
#. Speaker = Abducted Nobleman
#. NodeID = 0481be5d-7651-6037-5974-c85a08e3fe60
