msgctxt "h7ec28001g7b53g41f8gb04agecf2e1309914"
msgid "The crèche <i>must</i> be near."
msgstr "양성소가 근처에 있는 게 분명하다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_LaezelPostConfrontation
#. Speaker = Lae'zel
#. NodeID = 578901a1-9b1d-5fb5-3951-eea63c45dabe
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 0d6dbe21-1644-b9bf-8297-dd60d820bd99_A = False
#.     - 0d6dbe21-1644-b9bf-8297-dd60d820bd99_C = False
#.     - 0d6dbe21-1644-b9bf-8297-dd60d820bd99_B = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_LaezelPostConfrontation:578901a1-9b1d-5fb5-3951-eea63c45dabe
msgctxt "hc3189dd9gd4d9g4dc2gbd09g0a8e3c3c247a"
msgid "Protocol is clear. I <i>will </i>be purified."
msgstr "행동 절차는 명확해. 난 정화될 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_LaezelPostConfrontation
#. Speaker = Lae'zel
#. NodeID = 64b385aa-7e46-2299-6769-b97118a1dd69
