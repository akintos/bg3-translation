msgctxt "h70883a1fgcc2fg4642g8edegc9e71b53cec3"
msgid "It will be dangerous. You appear ill-equipped."
msgstr "위험할 거야. 넌 대비가 안 된 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = 5ac4a279-87b4-af0a-0122-1127d3a544f8
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_Quest_LoneDuergar_Defeated = False
#.   Local:
#.      - b8c4620d-f1a4-a9a7-27ae-fc5df8100d88_AcknowledgedDanger = False
#. SetFlags:
#.   Local:
#.     - b8c4620d-f1a4-a9a7-27ae-fc5df8100d88_AcknowledgedDanger = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:5ac4a279-87b4-af0a-0122-1127d3a544f8
msgctxt "h30819ba2gcfc2g4c75gbef4g63c8d3ca3eda"
msgid "Are you sure? It's going to be dangerous."
msgstr "확실해? 위험할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = 5be4cfaf-03b7-f4aa-12b3-5edcc57aa07c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:5be4cfaf-03b7-f4aa-12b3-5edcc57aa07c
msgctxt "h023437eeg9cfag4d8egbecagdfbbb16948e2"
msgid "The same as before. One sovereign or the other, it doesn't matter."
msgstr "전과 똑같아. 난 어느 쪽이 군주가 되든 상관없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Sovereign Glut
#. NodeID = 6058c845-5cb1-bf8e-99cf-842eda8ba63e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidRevenge_State_QuestCompleted = False
#. SetFlags:
#.   Global:
#.     - UND_MyconidCircle_BroodingSovereign_State_KingBringer = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:6058c845-5cb1-bf8e-99cf-842eda8ba63e
msgctxt "h98d18904g0b1eg4638ga7c1g93fa9bc1423c"
msgid "((*you have served well, King-Bringer. but our work is not done*))"
msgstr "((*잘 따라 주었다, 왕위 인도자여. 허나 우리의 대업은 끝나지 않았다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = 65788db8-de92-3fb7-88af-4fb9cb7a4d7c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:65788db8-de92-3fb7-88af-4fb9cb7a4d7c
#, fuzzy
msgctxt "h88ccc375g73f7g4b16gadb0gf2eec4fc5dd7"
msgid "<i>Think back to your days in your father's family home.</i>"
msgstr "<i>가족의 부유한 영지를 떠올린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Sovereign Glut
#. NodeID = 66f1ed8f-b55b-6f4d-250d-dbd03bf4367b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:66f1ed8f-b55b-6f4d-250d-dbd03bf4367b
msgctxt "hc65d1830gc01eg4f1fg8f85gdbfe9a1d6bd7"
msgid "((*you will cleanse the duergar Rot. I will join you*))"
msgstr "((*듀에르가의 부패를 정화할 생각이라면 그대에게 합류하겠다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = 69a80259-5bc4-2d7a-4b9b-1d110ea7fe66
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:69a80259-5bc4-2d7a-4b9b-1d110ea7fe66
msgctxt "h299cad4eg51cdg4df5gb122g739c64b49a0c"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = 6a8cf07c-2bd8-770e-9d9f-6edc2da267e7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:6a8cf07c-2bd8-770e-9d9f-6edc2da267e7
msgctxt "hfd55c9eaga96fg4acfg8510g0643d969fa81"
msgid ""
"<i>Imagine Crèche K'liir - rocky and cold - orbiting Toril with the Tears of "
"Selûne.</i>"
msgstr "<i>셀루네의 눈물과 함께 토릴 주위를 공전하는, 클리르 양성소의 바위가 많고 추운 환경을 떠올려본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Sovereign Glut
#. NodeID = 6ba7568f-a918-26ba-7e98-beb9a2d56cfa
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_MyconidRevenge_State_QuestCompleted = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:6ba7568f-a918-26ba-7e98-beb9a2d56cfa
msgctxt "hdc08c045g0221g49e3gb11eg171549f64e47"
msgid "((*then you reap no reward. this will be the way*))"
msgstr "((*그러면 넌 아무 보상도 받지 못한다. 내 말을 따라야 한다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = 6ed2b309-3a82-73fa-8838-cd7e33cbe7ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:6ed2b309-3a82-73fa-8838-cd7e33cbe7ed
msgctxt "hce02c723g730dg4468gba6eg6d2fbc201afd"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Sovereign Glut
#. NodeID = 70e27003-494a-8ebb-8ecb-2bee327599ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:70e27003-494a-8ebb-8ecb-2bee327599ea
msgctxt "hc13ad9b3g9dc2g4943gabf4g5335eb1ed25d"
msgid "((*bring me his head - a coronation gift*))"
msgstr "((*그의 머리를 가져와라 - 대관식 선물이다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = 72abd370-f5ff-074d-26ca-ae406f325243
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#.      - OATHBREAKER(1) = False
#. TagRule: PALADIN_ANCIENTS
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:72abd370-f5ff-074d-26ca-ae406f325243
msgctxt "h03deb072gd233g44d1gaa2cg9a4de7f478d0"
msgid "Then let us go together. The Rot must be cleansed."
msgstr "그럼 같이 가자. 부패는 정화되어야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = 72abd370-f5ff-074d-26ca-ae406f325243
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#.      - OATHBREAKER(1) = False
#. TagRule: PALADIN_DEVOTION
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:72abd370-f5ff-074d-26ca-ae406f325243
msgctxt "h885bd36ag504eg4c3ag8438gf11ddbf7dcd1"
msgid "For you to still fight for this Circle is admirable. We go together."
msgstr "이 공동체를 위해 여전히 싸우다니 대단하군. 함께 가자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = 72abd370-f5ff-074d-26ca-ae406f325243
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#.      - OATHBREAKER(1) = False
#. TagRule: PALADIN_VENGEANCE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:72abd370-f5ff-074d-26ca-ae406f325243
msgctxt "hdb3eadeage3d8g4d97g8857g88de14a75114"
msgid "You mean to take revenge - a noble cause. Join me."
msgstr "복수라, 고귀한 명분이지. 합류하도록 해라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = 730967c7-0b13-474f-5e53-59ca9026cc88
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:730967c7-0b13-474f-5e53-59ca9026cc88
msgctxt "hd4673616g6965g4216gbca0gdefa8ebb10bc"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Sovereign Glut
#. NodeID = 731f2f7b-fbfe-0e61-418d-b1f892b61541
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_MyconidRevenge_State_QuestCompleted = True
#.   Quest:
#.     - UND_MyconidRevenge.RewardedGlut(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:731f2f7b-fbfe-0e61-418d-b1f892b61541
msgctxt "h70d773d0g1b5dg4db8gb59bg08247b18ea8b"
msgid ""
"((*as commanded. a capable servant you have made, <b>King-Bringer</b>. you "
"have earned my favour*))"
msgstr "((*그대는 유능한 신하임을 증명해냈다, <b>왕위 인도자</b>여. 그대는 짐의 환심을 샀노라*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = 74e55cdc-464c-4b60-70a4-f7ddb0ae8f2a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:74e55cdc-464c-4b60-70a4-f7ddb0ae8f2a
msgctxt "h451757fagef0bg4754g8dccga56dad635070"
msgid "I don't have a home."
msgstr "나는 집이 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = 75952eff-bae6-91e5-0d05-22e68aac1558
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:75952eff-bae6-91e5-0d05-22e68aac1558
msgctxt "h5b5b7fe8g2a7dg4c6dgbb5agf6fdab0edc9a"
msgid "A kingdom that I handed to you."
msgstr "내가 네게 가져다 바친 왕국."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Sovereign Glut
#. NodeID = 77799642-ac47-2c88-acc7-1ccbd5839397
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_BroodingSovereign_State_AskedCircle = True
#.   Quest:
#.     - UND_BroodingSovereign.AskedCircle(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:77799642-ac47-2c88-acc7-1ccbd5839397
msgctxt "heb1f08deg3b6cg45f0g8317g4b4a960be5ee"
msgid "((*...there may be no <b>Spaw</b>. eliminate the other Sovereign*))"
msgstr "((*...<b>스포</b>는 없을 것이다. 다른 군주를 제거하라.*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = 78035a0f-1099-a1db-789a-b9976f60494e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule: PALADIN_ANCIENTS
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:78035a0f-1099-a1db-789a-b9976f60494e
msgctxt "h2a04b712g879cg4250g9850g1a147dc6009d"
msgid "<i>Bring to mind your oath: a verdant glade safe from harm. </i>"
msgstr "<i>당신의 맹세, 안전한 신록의 숲을 떠올려본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = 78035a0f-1099-a1db-789a-b9976f60494e
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule: PALADIN_DEVOTION
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:78035a0f-1099-a1db-789a-b9976f60494e
msgctxt "hfea2a4e9g1783g4f5fg8ce5g753338c7fdf6"
msgid "<i>Bring to mind your oath: an outstretched hand, a promise kept.</i>"
msgstr "<i>당신의 맹세, 앞으로 내민 도움의 손길과 지켜낸 약속을 떠올려본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = 78035a0f-1099-a1db-789a-b9976f60494e
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule: PALADIN_VENGEANCE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:78035a0f-1099-a1db-789a-b9976f60494e
msgctxt "hc7c07c86g77bfg430egb88fg65ab3d1d517f"
msgid "<i>Bring to mind your oath: a deep well of simmering fury.</i>"
msgstr "<i>당신의 맹세, 끓어오르는 분노로 가득 찬 깊은 샘을 떠올려본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = 78035a0f-1099-a1db-789a-b9976f60494e
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule: OATHBREAKER
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:78035a0f-1099-a1db-789a-b9976f60494e
msgctxt "h72b81eb6gdf0bg49d6gae48g2d29cff6df5c"
msgid "<i>Remember the oath you swore - and why you broke it.</i>"
msgstr "<i>맹세를 했던 사실과 그 맹세를 왜 파기했는지 기억해낸다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Sovereign Glut
#. NodeID = 7c537f46-7e57-9ebb-947f-131f05006d3a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:7c537f46-7e57-9ebb-947f-131f05006d3a
msgctxt "hebf2926ag06a1g45cdg9ff5g0caf2b1efaf6"
msgid "((*a fate it has <b>earned</b>*))"
msgstr "((*본인이 <b>자초한</b> 운명이다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Sovereign Glut
#. NodeID = 7cd7e4bb-44f1-3b96-1cc3-902d3ee7a0b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:7cd7e4bb-44f1-3b96-1cc3-902d3ee7a0b1
msgctxt "hde00fda5gdc59g41c9gb4ddg5d695d15043c"
msgid ""
"((*here, I break ground. from the dark will a mighty Circle <b>rise</b>. my "
"song will fill the Grotto!*))"
msgstr ""
"((*이곳에서, 나는 터를 갈고 닦을 것이다. 어둠 속에서 강력한 공동체가 <b>굴기하고</b>, 내 노래가 동굴을 메울 것이다!*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Karlach
#. NodeID = 7f1e8cc2-5f16-4b67-bdf1-6ac1c1756397
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_KARLACH(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:7f1e8cc2-5f16-4b67-bdf1-6ac1c1756397
msgctxt "h6dda6ebag8d73g4420gb7c4gcc817b9257c6"
msgid "Well, our to-do list is certainly filling out fast."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Narrator
#. NodeID = 802c2d35-4d98-cc1b-e9bb-08e67fff68a9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:802c2d35-4d98-cc1b-e9bb-08e67fff68a9
msgctxt "h4183d63dg3733g47b7g8e63g0d33c61acde8"
msgid ""
"*Spaw's old song falters in the myconids' minds, swallowed by a new rhythm - "
"the song of Glut.*"
msgstr "*스포의 오래된 노래가 마이코니드의 마음에서 힘을 잃고, 글럿의 노래에 묻힙니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = 81d7bf0f-e8b5-bf92-33b7-faeda7d39c7a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:81d7bf0f-e8b5-bf92-33b7-faeda7d39c7a
msgctxt "h61bf79cbgcf82g42ccg863ag4fa4f4b9f13b"
msgid "I've had my fill of taking your orders."
msgstr "네 명령을 듣는 것은 이제 지쳤어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = 8613fd8e-9774-3f1a-5ecb-765c1c3a6635
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_BroodingSovereign_State_CantReachDuergar = False
#.      - UND_MyconidCircle_BroodingSovereign_State_InParty = False
#. SetFlags:
#.   Global:
#.     - UND_MyconidCircle_BroodingSovereign_State_InParty = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:8613fd8e-9774-3f1a-5ecb-765c1c3a6635
msgctxt "h895d4e9ag6474g472agbccdg2bf3fab5c327"
msgid "<i>Invite Glut to your party.</i>"
msgstr "<i>글럿을 일행에 초대한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Sovereign Glut
#. NodeID = 87e5efe2-4e1f-4601-e4d7-405d2496f0b6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DUERGARDWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:87e5efe2-4e1f-4601-e4d7-405d2496f0b6
msgctxt "h15b5bf58g6f9fg441fgb6d9g317987f991e6"
msgid "((*far you've come. reach into memory - tell me of home*))"
msgstr "((*멀리서 왔구나. 기억을 더듬어봐라. 너의 고향에 대해 말해다오*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Lae'zel
#. NodeID = 88a94374-fc7d-410e-b2a6-a074016603d4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(2) = True
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:88a94374-fc7d-410e-b2a6-a074016603d4
msgctxt "h6bab87d4gfe05g4af0g99b0g611704739b19"
msgid "Is our sole purpose to settle this one's petty feuds?"
msgstr "우리의 주된 목표가 이놈의 별것도 아닌 문제를 해결하는 거였나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Narrator
#. NodeID = 894df357-0bf3-1421-b3c3-e6a3c4f0d2ee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:894df357-0bf3-1421-b3c3-e6a3c4f0d2ee
msgctxt "h040a6a72ga3a3g4ba7ga8fegb71a22a49388"
msgid "*It shudders, twisted by your brutal honesty.*"
msgstr "*그는 당신의 잔혹한 정직함에 뒤틀려 몸서리칩니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = 8ad34145-0f88-16df-d665-5f58f44099a0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_Sovereign_State_PermaDefeated = False
#. SetFlags:
#.   Global:
#.     - UND_MyconidCircle_BroodingSovereign_Quest_AcceptedCircleWipe = True
#.   Quest:
#.     - UND_BroodingSovereign.AcceptedCircle(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:8ad34145-0f88-16df-d665-5f58f44099a0
msgctxt "h1b550438g07c3g4691g91fdgc2c9e340040a"
msgid "Why not. Spaw's time is done."
msgstr "안될 것 없지. 스포의 시대는 끝났어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Sovereign Glut
#. NodeID = 8cf5900f-8879-7471-9928-f36ac4bd1ae5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_BroodingSovereign_State_SawDuergar = True
#.      - UND_MyconidCircle_BroodingSovereign_State_LoneDuergar_IsDead = False
#.      - UND_MyconidCircle_BroodingSovereign_State_AcceptedHelp = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:8cf5900f-8879-7471-9928-f36ac4bd1ae5
msgctxt "hcdde9e45ged95g45f4g985ag99ad24a4f71b"
msgid "((*the tumour is excised. <b>the way is clear</b>*))"
msgstr "((*종양이 제거되었다. <b>이 길은 안전하다</b>*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Wyll
#. NodeID = 8ffbf8ee-7269-49c4-bcd5-2dac7f8feb04
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_WYLL(6) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:8ffbf8ee-7269-49c4-bcd5-2dac7f8feb04
#, fuzzy
msgctxt "h8e198b42g3493g4d79gbdc8g989cad64a421"
msgid ""
"I'm starting to feel less a protector of the people, and more of an errand "
"boy."
msgstr "내가 영웅이 아니라 심부름꾼이 된 거 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = 9021f69f-574b-a04d-2329-00b0a8280d8b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:9021f69f-574b-a04d-2329-00b0a8280d8b
msgctxt "h221c0aa5gccc3g4bdag8c51g18f5b18ec580"
msgid ""
"Me blanketed in flayed skin, fireplace burning flesh, sipping a glass of "
"gall."
msgstr "벗겨진 살갗으로 뒤덮인 나, 살점을 태우는 모닥불, 한 잔 마시는 쓸개즙."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Narrator
#. NodeID = 90d6863b-3a57-27be-4193-b24b24672d26
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#. SetFlags:
#.   Global:
#.     - UND_MyconidCircle_BroodingSovereign_State_InParty = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:90d6863b-3a57-27be-4193-b24b24672d26
msgctxt "h747f8522gb64ag4dfdg8852gcda973329c62"
msgid ""
"*You know it for what it is: a chant of war. Glut's reign would not be one "
"of peace - but terror.*"
msgstr "*당신은 이게 뭔지 압니다. 전쟁의 성가죠. 글럿의 통치는 평화가 아니라 공포인 듯 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Sovereign Glut
#. NodeID = 925e1de5-acf0-eaec-cf84-4c84a5404e29
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_BroodingSovereign_Done = False
#.   Quest:
#.      - UND_BroodingSovereign.AcceptedCircle(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:925e1de5-acf0-eaec-cf84-4c84a5404e29
msgctxt "h233454e0g95eag4b03g9d46gca8a7818ada7"
msgid "((*eliminate Spaw. the Circle must pay for its failures!*))"
msgstr "((*스포를 제거하라. 공동체는 실수의 대가를 치러야 한다!*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Sovereign Glut
#. NodeID = 9272a086-4542-d458-b644-2064369907a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:9272a086-4542-d458-b644-2064369907a3
msgctxt "hdf2b76a1g0a71g4583gbcafg607f6db059c7"
msgid ""
"((*<b>I</b> am the danger, and <b>I</b> am the cure. they erased my people; "
"I will erase theirs*))"
msgstr ""
"((*<b>내가</b> 바로 위험이며, <b>내가</b> 바로 치료제다. 내 일족을 없앴으니, 나도 그들의 일족을 없애리라.*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = 9666a855-af9b-f114-5f59-f22b6ce2103b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:9666a855-af9b-f114-5f59-f22b6ce2103b
msgctxt "h4d5359cfg30c3g44e6g8a70g038f551c9992"
msgid ""
"The Astral citadel of Tu'narath, at the court of Queen Vlaakith. That is my "
"place."
msgstr "투나라스에 있는 블라키스 여왕님의 궁정, 그 안의 아스트랄 성채. 그곳이 내 집이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Narrator
#. NodeID = 96696416-efef-d08d-f959-2c78a2cbe8ca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:96696416-efef-d08d-f959-2c78a2cbe8ca
msgctxt "h357cdcd5gfe4ag4e09g9631g18d5c95db60c"
msgid "*It cringes in response to your sunny vision.*"
msgstr "*그는 당신이 그린 화창한 광경에 반응하여 움찔합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Sovereign Glut
#. NodeID = 96e06d6c-8203-b48b-08bf-9920d7d3a38d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:96e06d6c-8203-b48b-08bf-9920d7d3a38d
msgctxt "h7949cff4g6886g402dgb662g3618f7280cf5"
msgid ""
"((*ah, the Circle sings to you its truth. your voice is forever welcome in "
"our harmonies*))"
msgstr "((*아, 공동체가 너에게 진실을 노래하는군. 너의 목소리는 영원토록 우리의 합창에 환영받을 것이다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Sovereign Glut
#. NodeID = 98b7c9b2-f802-6b85-5a15-606daeaa9a9d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_BroodingSovereign_Event_Enlarged = True
#.     - UND_BroodingSovereign_State_RefusedCircle = True
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#.   Quest:
#.     - UND_BroodingSovereign.RefusedCircle(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:98b7c9b2-f802-6b85-5a15-606daeaa9a9d
msgctxt "h0d93794dg1ca9g4c14g8876gffdf5feae2b5"
msgid "((*<b>your corpse will birth my Circle!</b>*))"
msgstr "((*<b>너의 시체가 내 공동체를 탄생시킬 것이다!</b>*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Narrator
#. NodeID = 9c1facc2-82cb-1efb-b43b-7fa462eaed01
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_BroodingSovereign_State_SawDuergar = True
#.      - UND_MyconidCircle_BroodingSovereign_State_LoneDuergar_IsDead = True
#.      - UND_MyconidCircle_BroodingSovereign_State_AcceptedHelp = True
#.   Tag:
#.      - REALLY_DUERGARDWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:9c1facc2-82cb-1efb-b43b-7fa462eaed01
msgctxt "h94f14e5dg52acg435cg9c57g5c87dd9e957c"
msgid "*You consider your kin, dead by your hand.*"
msgstr "*당신에게 살해된 동족을 떠올립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Shadowheart
#. NodeID = 9ccf4aa9-2b19-45e4-a7ad-6eb5dfc1d0cd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:9ccf4aa9-2b19-45e4-a7ad-6eb5dfc1d0cd
msgctxt "hcd3e734bg76a3g44abgbcd7g023fa53d8ac0"
msgid "I never thought I'd become a fungal errand girl, yet here I am."
msgstr "곰팡이 심부름이나 하게 될 줄은 몰랐지만 이렇게 됐네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Sovereign Glut
#. NodeID = 9decc777-2957-7998-7f7c-eca575f7a99a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:9decc777-2957-7998-7f7c-eca575f7a99a
msgctxt "h48bdd254gc140g4db6ga714gf4f4599a8ae4"
msgid "((*it is the <b>Circle</b> that thirsts - and Glut must slake*))"
msgstr "((*<b>공동체</b>는 목이 마르고, 글럿은 목을 축여야 한다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Gale
#. NodeID = 9f41c5e2-00f5-45db-8ed3-d2a7d9eae85c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_GALE(7) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:9f41c5e2-00f5-45db-8ed3-d2a7d9eae85c
msgctxt "h4d21b195gb0b1g4d82gbfa5gf579cf0f2656"
msgid "Scarcely crowned and already issuing orders. Hail Glut, hm?"
msgstr "겨우 왕관 쓴 주제에 벌써 명령이시네. 글럿 만세구먼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Sovereign Glut
#. NodeID = a1029614-806f-c0da-e655-084c4571437e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_State_DeclinedBroodingSovereign = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:a1029614-806f-c0da-e655-084c4571437e
msgctxt "h646765cdgf985g41cagae5eg75e8aa5e4f2a"
msgid "((*the Rot still spreads. let me join you, so I may cleanse it*))"
msgstr "((*부패는 여전히 확산되고 있다. 나도 함께 정화하겠다.*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = a4307f7d-8505-72f8-2fc4-02a6c2321427
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidRevenge_State_HeadInaccessible = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:a4307f7d-8505-72f8-2fc4-02a6c2321427
msgctxt "h525e5247g7492g4714g8154gf2451bb510fe"
msgid "Nere is dead, but his head is lost to me."
msgstr "니어는 죽었지만, 그의 머리는 내게 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = a632d781-d9eb-f421-9ea5-49f29a3c1ace
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:a632d781-d9eb-f421-9ea5-49f29a3c1ace
msgctxt "hc1d3e09bg885cg4582gb45eg3daecbe71f47"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = a6adf31a-0f7d-59e0-30be-f149165e3c88
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule: PALADIN_ANCIENTS
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:a6adf31a-0f7d-59e0-30be-f149165e3c88
msgctxt "h6acfa343gfc4eg4ba4g82dcg679ef1660abe"
msgid "This Circle could finally see peace - why would you do this to Spaw?"
msgstr "공동체에 겨우 평화가 찾아왔는데, 왜 스포한테 그런 짓을 하지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = a6adf31a-0f7d-59e0-30be-f149165e3c88
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule: PALADIN_DEVOTION
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:a6adf31a-0f7d-59e0-30be-f149165e3c88
msgctxt "h836036f7g2043g4783g9010g1f22860b7107"
msgid "Spaw sheltered you, and now you betray it? Turncoat. <i>Coward</i>."
msgstr "스포는 널 받아줬는데, 그걸 배신하겠다고? 변절자. <i>겁쟁이</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = a6adf31a-0f7d-59e0-30be-f149165e3c88
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule: PALADIN_VENGEANCE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:a6adf31a-0f7d-59e0-30be-f149165e3c88
msgctxt "h9e5ece53g1cedg4966g820bg6794521c4415"
msgid "Retribution requires righteous cause, Glut. Why betray Spaw?"
msgstr "복수에는 명분이 필요해, 글럿. 왜 스포를 배신하지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = a6adf31a-0f7d-59e0-30be-f149165e3c88
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule: OATHBREAKER
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:a6adf31a-0f7d-59e0-30be-f149165e3c88
msgctxt "h0664ddffg3fedg4b43ga966gc0e742540878"
msgid "The old ways die, and something new takes its place. Intriguing."
msgstr "옛것이 죽고 새로운 것이 그 자리를 대체한다라. 흥미로운걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Sovereign Glut
#. NodeID = a8c0f845-8355-a230-eb47-c998737b2083
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - UND_MyconidCircle_BroodingSovereignHasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:a8c0f845-8355-a230-eb47-c998737b2083
msgctxt "h313ac97eg112dg460dg9bc2gdf66298a0ecc"
msgid "((*I do not belong here; I am not welcomed here*))"
msgstr "((*난 이곳에 속하지 않는다; 나는 환영받지 못한다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Sovereign Glut
#. NodeID = a9b651b9-32ba-3a19-cfab-f8889304f189
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_AcceptedQuest = True
#. SetFlags:
#.   Dialog:
#.     - UND_MyconidCircle_BroodingSovereignHasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:a9b651b9-32ba-3a19-cfab-f8889304f189
msgctxt "hcb55c16cg1b24g4385ga85cg26a6188ca1d9"
msgid "((*this Circle does not welcome me*))"
msgstr "((*이 공동체는 나를 환영하지 않는다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = aac35d77-c170-7d6b-ca48-1baff17ef8d0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_Quest_LoneDuergar_Defeated = True
#.      - UND_MyconidCircle_BroodingSovereign_State_LoneDuergar_IsDead = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:aac35d77-c170-7d6b-ca48-1baff17ef8d0
msgctxt "h1c4def88gd1e7g4ce5g8206g7fc2bceec4f3"
msgid "The duergar are dealt with."
msgstr "듀에르가는 처리했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Sovereign Glut
#. NodeID = b20b77a7-4db9-2e12-faa3-45e0ce6305a7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidRevenge_State_GlutNere = False
#.      - UND_MyconidCircle_BroodingSovereign_State_KingBringer = False
#.      - UND_MyconidCircle_BroodingSovereign_Done = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:b20b77a7-4db9-2e12-faa3-45e0ce6305a7
msgctxt "hb093ced4gaa32g41a3g929fg2e89647fac6a"
msgid ""
"((*<b>King of Kings, I am.</b> let this place be sacred: <b>Circle Glut </"
"b>takes root!*))"
msgstr "((*<b>나는 왕중의 왕이니.</b> 여기를 성지로 정해 <b>글럿의 공동체</b>가 뿌리 내릴 것이다!*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Sovereign Glut
#. NodeID = b3b20578-3a30-63d9-2f2c-20668eda9d32
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:b3b20578-3a30-63d9-2f2c-20668eda9d32
msgctxt "hdb1b8cd6gd192g4f99ga6cfg4d5d3c41a44e"
msgid "((*come to the Circle. I will await there*))"
msgstr "((*공동체로 와라. 거기서 기다리겠다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = b66cb651-ab50-8295-a7ac-3236302dcb84
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:b66cb651-ab50-8295-a7ac-3236302dcb84
msgctxt "h11aec114g1c74g4a90gabd2g5fdb8703631a"
msgid "I don't need your help."
msgstr "네 도움 따윈 필요 없다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = b8649a1e-fb41-b275-907b-89e8a7a72022
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:b8649a1e-fb41-b275-907b-89e8a7a72022
msgctxt "hd3cdc670g536dg4175g8c72ge11b492c22e6"
msgid "A petty little fiefdom. I will rule over grander."
msgstr "보잘것없이 작은 영지. 난 더 장대한 영지를 다스릴 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Sovereign Glut
#. NodeID = b8da8264-50ba-dc4f-799b-9e0be88f155e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_MyconidCircle_BroodingSovereignHasMet(1) = True
#.   Global:
#.      - UND_MyconidCircle_AcceptedQuest = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:b8da8264-50ba-dc4f-799b-9e0be88f155e
msgctxt "h7abcc4e6g6058g4cf2g9a5fgaca5914ac3c9"
msgid "((*I grow among them. yet I am not <i>of</i> them*))"
msgstr "((*나는 그들 사이에서 자란다. 하지만 그들의 <i>일원은</i> 아니다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = ba19cb05-336e-5509-420d-8cef7580ecb8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_BroodingSovereign_State_InParty = True
#. SetFlags:
#.   Global:
#.     - UND_MyconidCircle_BroodingSovereign_State_InParty = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:ba19cb05-336e-5509-420d-8cef7580ecb8
msgctxt "hae072a4egc401g44a1ga2b9gf598d2e6021a"
msgid "<i>Dismiss Glut.</i>"
msgstr "<i>글럿을 내보낸다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Sovereign Glut
#. NodeID = ba68b457-eb54-c7f3-4a23-2af28a742053
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_MyconidCircle_State_DeclinedBroodingSovereign = True
#.   Quest:
#.     - UND_BroodingSovereign.RefusedJoin(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:ba68b457-eb54-c7f3-4a23-2af28a742053
msgctxt "h43463a71ge075g438ag9e6cg314d7cd45647"
msgid "((*then a nomad I remain*))"
msgstr "((*그럼 나는 떠돌이로 남겠군*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = bad4899d-f858-6fb9-4c15-80a8a2a28d79
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_MyconidCircle_BroodingSovereign_State_InParty = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:bad4899d-f858-6fb9-4c15-80a8a2a28d79
msgctxt "h7b1f1bc2g9753g41ffg8fa0g17bdae095bd7"
msgid "I'll have no part of this."
msgstr "이런 일에 끼지 않겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Sovereign Glut
#. NodeID = be9df6e9-ced8-2cd9-a223-f160d47cfba0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:be9df6e9-ced8-2cd9-a223-f160d47cfba0
msgctxt "h3f4aa140gd038g46d9g826ega92243f1c83e"
msgid "((*a gift of <b>Circle Glut</b>*))"
msgstr "((*<b>글럿의 공동체</b>가 주는 선물이다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Sovereign Glut
#. NodeID = bf5ff562-c32c-1600-9932-7ef1ee041b06
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:bf5ff562-c32c-1600-9932-7ef1ee041b06
msgctxt "h3eca134dg2376g4112gbb60ge48121a5dc3b"
msgid "((*my Circle long suffered while the duergar flourished*))"
msgstr "((*내 공동체는 듀에르가가 번성하는 동안 오랜 고통을 겪었다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = bf7a81ab-d0fc-cf29-af58-5c827398825f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BALDURIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:bf7a81ab-d0fc-cf29-af58-5c827398825f
msgctxt "ha015ab5fg61e6g4020gb59cgb82c100ed41c"
msgid "<i>Envision the banks of the Chionthar: green and fertile.</i>"
msgstr "<i>푸르고 비옥한 치온타르 강둑을 머릿속에 그린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = c0bf79f2-990d-214d-abdc-8982a9d8651c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_MOUNTAINDWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:c0bf79f2-990d-214d-abdc-8982a9d8651c
msgctxt "h8f90b601g4837g460fg8032g2553508fdbcc"
msgid ""
"<i>Recall the majesty of the northern ranges, untamed and unforgiving.</i>"
msgstr "<i>길들여지지 않은 척박한 북부 산맥의 장엄함을 떠올린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Narrator
#. NodeID = c173b607-f97b-54be-9fe8-98676d7a2d6f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:c173b607-f97b-54be-9fe8-98676d7a2d6f
msgctxt "h1e9d0aa8g3cd8g432bga96cg34f76bc44a71"
msgid "*It shivers in understanding.*"
msgstr "*그는 이해한 듯 몸을 떱니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Astarion
#. NodeID = c32bc6df-dead-45bb-98c4-a4d330bcded0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:c32bc6df-dead-45bb-98c4-a4d330bcded0
msgctxt "h2c14937ag1e5ag4e3dgaa2cg1bcd52f2d507"
msgid "Look, I'm all for killing him, but what's in this for us?"
msgstr "이봐, 그를 죽이는 건 찬성하지만, 우리에게 무슨 이득이 있지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Narrator
#. NodeID = c5b1388a-76d8-0ad3-7d20-62a93cde766a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:c5b1388a-76d8-0ad3-7d20-62a93cde766a
msgctxt "h7cf88b42g64beg4be7ga69bg3dfd3fc694a3"
msgid "*The creature cringes, overwhelmed by the throngs.*"
msgstr "*이 생명체는 군중에 압도된 듯, 움찔합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = ca2b949a-7295-deab-b751-d5f78d686908
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_Quest_LoneDuergar_Defeated = False
#.   Local:
#.      - b8c4620d-f1a4-a9a7-27ae-fc5df8100d88_myconidhelp = False
#.      - b8c4620d-f1a4-a9a7-27ae-fc5df8100d88_AcknowledgedDanger = False
#. SetFlags:
#.   Local:
#.     - b8c4620d-f1a4-a9a7-27ae-fc5df8100d88_myconidhelp = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:ca2b949a-7295-deab-b751-d5f78d686908
msgctxt "h070ec167gd77cg42b4gb3dbg5f4f2e482ab9"
msgid "Join me? That depends - can you make yourself useful?"
msgstr "나에게 합류하려고? 그건 네가 얼마나 유용한지에 달렸지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Sovereign Glut
#. NodeID = ca9dee6b-8745-9d07-a50f-fbd85f0ec793
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:ca9dee6b-8745-9d07-a50f-fbd85f0ec793
msgctxt "hd4686445gbf39g4a9fg8fc9gdb5364c54085"
msgid "((*a tune of division, yours forever to sing*))"
msgstr "((*네가 영원히 노래할 수 있는 분열의 곡*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = cab248de-6538-2a7c-81f2-9b7470258d08
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidRevenge_State_HeadInaccessible = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:cab248de-6538-2a7c-81f2-9b7470258d08
msgctxt "h20fe8dfdg90d5g4b2fgb6adgaea6679fd992"
msgid "I assume there'll be another reward in this for me."
msgstr "다른 보상도 있을 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Sovereign Glut
#. NodeID = cb28eb9a-a4f5-2ec6-d20a-d20030506051
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:cb28eb9a-a4f5-2ec6-d20a-d20030506051
msgctxt "h2a159bf0g73bcg4fe3gb7acg4778807c702b"
msgid ""
"((*do not feign understanding of the Circle's melody. you were a useful "
"servant - but your service is done*))"
msgstr "((*공동체의 화음을 이해하는 척하지 마라. 넌 쓸모 있는 하인이었지만, 임무는 끝났다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Sovereign Glut
#. NodeID = cc2ef2ea-6d99-755e-74e2-40365add97e2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidRevenge_State_GlutNere = True
#.      - UND_MyconidRevenge_State_QuestCompleted = False
#.      - UND_MyconidCircle_BroodingSovereign_State_KingBringer = True
#.      - UND_MyconidCircle_BroodingSovereign_Done = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:cc2ef2ea-6d99-755e-74e2-40365add97e2
msgctxt "h39318ccag26f5g48d7g8f87ga7535759b90d"
msgid "((*<b>Circle Glut</b> is eternal*))"
msgstr "((*<b>글럿의 공동체</b>는 영원하다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = ccb0c2e8-d5a5-adc6-feaa-a52022d3fc99
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_HALFLING(1) = False
#.      - REALLY_DARK_URGE(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:ccb0c2e8-d5a5-adc6-feaa-a52022d3fc99
msgctxt "h3677b83fg7bdag41edgbe22g5e2cb4222919"
msgid "My home is wherever I travel."
msgstr "내가 가는 곳이 곧 집이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Sovereign Glut
#. NodeID = ce0a58e6-3ace-7341-d997-380e5f0e438e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:ce0a58e6-3ace-7341-d997-380e5f0e438e
msgctxt "h51ecdfbdg2f8fg4115g95f6g5202681a130c"
msgid ""
"((*I sang to Spaw for help. yet it cowered in the Grotto and let my people "
"be slaughtered*))"
msgstr "((*난 스포에게 도음의 노래를 청했지만, 놈은 동굴에 숨어 내 동족이 학살당하는 걸 방관했다.*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Sovereign Glut
#. NodeID = cec50245-b513-0605-2aba-389d85cc30b7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:cec50245-b513-0605-2aba-389d85cc30b7
msgctxt "hb2ea27ebgbc12g48bdg8b8eg445cf2b01d13"
msgid ""
"((*my spawn will rise, and sing of your might. you will be called <b>King-"
"Bringer</b>!*))"
msgstr "((*내 자손이 일어나, 그대의 힘을 노래할지니. 그대를 <b>왕위 인도자</b>라 할 것이다!*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Sovereign Glut
#. NodeID = d14d9bae-535f-e5af-bc57-c5e5d4404bb7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_BroodingSovereign_Event_Enlarged = True
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:d14d9bae-535f-e5af-bc57-c5e5d4404bb7
msgctxt "h01fb26e7g7ef7g46d2ga380g40cacb7ba4ff"
msgid ""
"((*you will <b>serve</b>, King-Bringer. to feed my Circle, if nothing else*))"
msgstr "((*그대는 <b>섬기게</b>될 거다, 왕위 인도자여. 내 공동체의 식량이 되어서라도*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Sovereign Glut
#. NodeID = d51d6cd8-e617-26f3-0c79-81d3ff0e5895
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:d51d6cd8-e617-26f3-0c79-81d3ff0e5895
msgctxt "hfeff2d53g89e8g4a01gbacdg235d0b5d454a"
msgid "((*come, then. bring me to Spaw and I will sing its doom*))"
msgstr "((*그럼, 가자. 스포에게 데려가 다오. 놈의 파멸을 노래할 테니*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Narrator
#. NodeID = d5927466-940f-6cdd-0d52-88f59c1d4333
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:d5927466-940f-6cdd-0d52-88f59c1d4333
msgctxt "h7adb5d4bge6cdg4a26gac00g7c7bfa461cf7"
msgid ""
"*It sighs, though from your hollow words, or believing your false dreams, "
"you know not.*"
msgstr "*그는 한숨을 쉽니다. 당신의 공허한 말 때문인지, 당신의 가짜 꿈을 믿어서인지는 모르겠지만요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Sovereign Glut
#. NodeID = dbc56670-8a5e-e026-448a-a5c6b2529f8b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DUERGARDWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:dbc56670-8a5e-e026-448a-a5c6b2529f8b
msgctxt "hed2f0e58gdcfdg4371gb7aegadd46941a77b"
msgid ""
"((*flesh-walker, tongue-talker. you look like the Rot, yet your presence "
"soothes me*))"
msgstr "((*육체로 걷는 자, 혀로 말하는 자군. 너는 썩은 자인 것 같지만, 너의 존재가 나를 안심시키는구나*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = dc30cbb6-01ba-ab95-5b8a-e831542f417b
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WOODELF or REALLY_WOODHALFELF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:dc30cbb6-01ba-ab95-5b8a-e831542f417b
msgctxt "haf98df02gd96cg4f60g8745gb2747beb46a5"
msgid ""
"<i>Visualise the forests of Faerûn. Your home lies there, in the dappled "
"light between trees.</i>"
msgstr "<i>페이룬의 숲을 상상한다. 나무 사이의 얼룩덜룩한 빛이 비치는 곳, 당신의 고향은 그곳에 있다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Narrator
#. NodeID = dd337174-788c-f801-a3b1-11fe799f91b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:dd337174-788c-f801-a3b1-11fe799f91b4
msgctxt "h932a9c4dgb746g46cag9396gb36b13282c16"
msgid "*It mourns, moved by your emptiness.*"
msgstr "*그는 당신의 공허함에 슬퍼합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = ddd9a662-274d-e857-ce24-ab625cf5461a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidRevenge_State_HeadInaccessible = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:ddd9a662-274d-e857-ce24-ab625cf5461a
#, fuzzy
msgctxt "h3af6e762gea8dg41cagb3c0g8e72aa28b624"
msgid "You're a bloodthirsty one."
msgstr "당신은 피에 목 말랐군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = df09eae3-52f3-9bdc-2ff8-ff9aaad7aeb0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_BroodingSovereign_State_InParty = True
#. SetFlags:
#.   Global:
#.     - UND_MyconidCircle_BroodingSovereign_State_InParty = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:df09eae3-52f3-9bdc-2ff8-ff9aaad7aeb0
msgctxt "hba18fe05g20e5g4e90gb6e4ga8d3bfeed06b"
msgid "<i>Dismiss Glut.</i>"
msgstr "<i>글럿을 내보낸다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Sovereign Glut
#. NodeID = df1e8ff9-2fe4-a8e9-c6b7-fbace4398bf9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:df1e8ff9-2fe4-a8e9-c6b7-fbace4398bf9
msgctxt "h29d9b356ge547g48e6gaf6fg5d961ffb5edb"
msgid ""
"((*once, I sang to you of <b>home</b>. Look now on Glut's domain, and tell "
"me what you see*))"
msgstr "((*내 고향의 노래를 해줬던 적이 있지. 지금 글럿의 땅을 보고 뭐가 보이는지 말해보라*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = e3f097bd-6186-b493-8be6-632b9dad7405
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BALDURIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:e3f097bd-6186-b493-8be6-632b9dad7405
msgctxt "h33ff19f4gfdf6g477ag8716ga50d45d5b9a1"
msgid "<i>Imagine the bustle of the city's marketplace: the Wide.</i>"
msgstr "<i>발더스 게이트 광장의 북적거리는 시장을 떠올린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = e4552fac-0a4d-4c9a-1c1d-70e8fec25b57
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:e4552fac-0a4d-4c9a-1c1d-70e8fec25b57
msgctxt "hbe3dd619ga68eg47b0gb4c8g72d51c62916e"
msgid "Make it worth my while."
msgstr "그에 걸맞는 보상을 줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = e4e19676-a09f-55a2-537a-26a024cf7d7e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_HILLDWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:e4e19676-a09f-55a2-537a-26a024cf7d7e
msgctxt "h88afb3b0g5adfg4148g92bcgc846ba1bc474"
msgid ""
"<i>Recall the shadowed grottos and winding tunnels of the Great Rift.</i>"
msgstr "<i>그림자가 짙게 깔린 대계곡의 동굴과 굽이진 지하 통로를 떠올린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Sovereign Glut
#. NodeID = e7572d1a-ebfd-f2cf-3d0a-2d180dbe3ef9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:e7572d1a-ebfd-f2cf-3d0a-2d180dbe3ef9
msgctxt "h3bdc1427gf172g4b3fga68eg2bea243245c5"
msgid "((*flesh-walker, tongue-talker, far you've come*))"
msgstr "((*육체로 걷는 자, 혀로 말하는 자군. 멀리서 왔구나*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = e7f35345-59ca-9f5d-a23a-98b21192d5d6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidRevenge_State_QuestCompleted = False
#.      - UND_TheDrowNere_State_PermaDefeated = True
#.   Object:
#.      - UND_MyconidRevenge_State_HasNereHead(1) = True
#. SetFlags:
#.   Object:
#.     - UND_MyconidRevenge_Event_GiveNereHead(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:e7f35345-59ca-9f5d-a23a-98b21192d5d6
msgctxt "h441d78f0g75adg4304gb939g7ab755ec095d"
msgid "I've brought you Nere's head."
msgstr "니어의 머리를 가져왔어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = ea540923-1a8c-a2d1-9d13-2bb413c800ca
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_HALFLING(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:ea540923-1a8c-a2d1-9d13-2bb413c800ca
msgctxt "h0d95ad1ag18a6g4bd5gb54fgf14fbb70b2fb"
msgid ""
"Wherever there's love, light, and laughter. A warm hearth doesn't hurt, "
"either."
msgstr "사랑, 빛, 웃음이 있는 곳이라면 어디든지. 따뜻한 난로가 있다면 더 좋군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = ebb41b3e-4d76-2291-dbf2-163e002c33a5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:ebb41b3e-4d76-2291-dbf2-163e002c33a5
msgctxt "h5f8c2719g0af5g4f30gbed5gaee3e62f9947"
msgid ""
"<i>Make up the kind of treasured memories you expect the sane to feel.</i>"
msgstr "<i>제정신인 사람이 느낄 수 있는 소중한 추억을 떠올린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Sovereign Glut
#. NodeID = ebf8bddd-56e1-3ad1-71f5-908374142e19
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:ebf8bddd-56e1-3ad1-71f5-908374142e19
msgctxt "haabcd4a4gc7f4g4497ga11dg5102e992a724"
msgid "((*you shout, but you will never sing*))"
msgstr "((*너는 소리만 지르지, 노래는 못 부르겠군*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Sovereign Glut
#. NodeID = efdaeadf-56d6-e363-76a6-2d3d795083cf
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_MyconidCircle_BroodingSovereign_State_AcceptedHelp = True
#.     - UND_MyconidCircle_BroodingSovereign_State_InParty = True
#.     - UND_MyconidCircle_State_DeclinedBroodingSovereign = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:efdaeadf-56d6-e363-76a6-2d3d795083cf
msgctxt "h08bc2245g698eg44fdg943fg0d13b71bc5f8"
msgid ""
"((*remain in the Underdark, and I will follow. we cleanse the Rot together*))"
msgstr "((*네가 언더다크에 남아있는 동안, 너를 따르겠다. 함께 썩은 것을 정화하자*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = f171fef5-2ca1-7f4f-e01b-f9f5e3e6a41c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:f171fef5-2ca1-7f4f-e01b-f9f5e3e6a41c
msgctxt "h57f26ed7gb6fag46c9ga54bg23ccb8d99914"
msgid "A circle with a bright future, thanks to you."
msgstr "네 덕분에 공동체의 미래가 밝아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = f174e6e3-c300-d374-8bbe-6eebb0fd740c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_Quest_LoneDuergar_Defeated = False
#.   Local:
#.      - b8c4620d-f1a4-a9a7-27ae-fc5df8100d88_myconidhelp = False
#.      - b8c4620d-f1a4-a9a7-27ae-fc5df8100d88_AcknowledgedDanger = True
#. SetFlags:
#.   Local:
#.     - b8c4620d-f1a4-a9a7-27ae-fc5df8100d88_myconidhelp = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:f174e6e3-c300-d374-8bbe-6eebb0fd740c
msgctxt "h73054769g7cf8g40aagbd5cgd9e4d9daf221"
msgid "What threat do you pose to duergar?"
msgstr "듀에르가에게 네가 어떤 위협이 되지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Sovereign Glut
#. NodeID = f1b65cb6-8287-11b8-ff82-7d6f1e9c8b60
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:f1b65cb6-8287-11b8-ff82-7d6f1e9c8b60
msgctxt "h5b11f20fg2931g42ebg937dg8acea253c9cb"
msgid ""
"((*flesh-walker, tongue-talker. you hail from the Dark - yet far you've "
"come*))"
msgstr "((*육신을 이끄는 자, 혀로 말하는 자군. 어둠으로부터 왔지만, 아직도 멀리 남았구나*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Sovereign Glut
#. NodeID = f2469c82-e48a-eed3-ef63-d4d90d704519
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - b8c4620d-f1a4-a9a7-27ae-fc5df8100d88_BroodingDuergar_GaveReward = False
#. SetFlags:
#.   Local:
#.     - b8c4620d-f1a4-a9a7-27ae-fc5df8100d88_BroodingDuergar_GaveReward = True
#.   Object:
#.     - UND_BroodingSovereign_Event_GiveReward(1) = True
#.   Quest:
#.     - UND_BroodingSovereign.Rewarded(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:f2469c82-e48a-eed3-ef63-d4d90d704519
msgctxt "hc05a2f47g9345g4cd0g90c5g7029eb4a1934"
msgid ""
"((*take my gift of song. cry it low or loud - but cry it proud, <b>King-"
"Bringer</b>! so it is certain, and so you are known!*))"
msgstr ""
"((*노래의 선물을 받아라. 작든, 크든, 당당하게 외칠지어다, <b>왕위 인도자</b>여! 그대 이름이 선명하게 알려지리라!*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Sovereign Glut
#. NodeID = f2999304-47cd-c2d6-a709-94ad99733d3a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_BroodingSovereign_Event_OfferedQuest = True
#.   Quest:
#.     - UND_BroodingSovereign.Start(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:f2999304-47cd-c2d6-a709-94ad99733d3a
msgctxt "hedf7c207gfd5cg4755ga703gc6db1ea9ffd3"
msgid ""
"((*but I have heard the song. you mean to cleanse the duergar Rot. I mean to "
"join you*))"
msgstr "((*하지만 나는 노래를 들었다. 네가 썩은 듀에르가를 정화한다고. 너에게 합류하고자 한다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = f2d3634d-fd34-9fdc-f0fe-ab6246f1c866
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_Sovereign_State_PermaDefeated = True
#. SetFlags:
#.   Global:
#.     - UND_MyconidCircle_BroodingSovereign_State_InParty = False
#.   Quest:
#.     - UND_BroodingSovereign.UND_BroodingSovereign_TalkToGlutAtCircle(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:f2d3634d-fd34-9fdc-f0fe-ab6246f1c866
msgctxt "h21ce706dg1a9dg482eg834bgfa453e2a0948"
msgid "Spaw is destroyed - the circle is no more."
msgstr "스포를 물리쳤다. 이제 공동체는 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Sovereign Glut
#. NodeID = f3958841-5b8c-281b-0089-eaf19868690f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:f3958841-5b8c-281b-0089-eaf19868690f
msgctxt "h64a9bba7gbca9g4834g83a0g524bdcaadb6f"
msgid ""
"((*you have received your payment - now go. this Circle sings only the song "
"of <b>Glut</b>. you are <b>discord</b>*))"
msgstr "((*보수는 주었다. 이제 가라. 이 공동체는 <b>글럿</b>의 노래만 해야 하고, 그대는 <b>불협화음</b>이니*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = f4e24a29-47fd-099e-7994-879aaf5dde97
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_Quest_LoneDuergar_Defeated = True
#.      - UND_MyconidCircle_BroodingSovereign_State_LoneDuergar_IsDead = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:f4e24a29-47fd-099e-7994-879aaf5dde97
msgctxt "h9ed4dc96ga81bg4fe3ga1acg314d320fb301"
msgid "The duergar are already dead."
msgstr "그 듀에르가는 이미 죽었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Narrator
#. NodeID = f4f53175-c824-c929-b6f3-8e52da846d86
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidRevenge_State_SentKillNere = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:f4f53175-c824-c929-b6f3-8e52da846d86
msgctxt "h76094e00gb57cg4dc2g9296g27b163f0920c"
msgid ""
"*You see Glut's old grotto once more, but this time wreathed in flame. Amid "
"the slaughter strides a drow.*"
msgstr "*글럿의 동굴에 한번 더 왔는데, 불길에 휩싸여 있습니다. 학살극 한가운데 어떤 드로우가 보입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Sovereign Glut
#. NodeID = f646bff1-8d83-6a00-a429-ba98d3e4e2c5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:f646bff1-8d83-6a00-a429-ba98d3e4e2c5
msgctxt "h3bdc460fg5559g4896g8cc7ga2669d06c670"
msgid "((*the tumour is excised. <b>the duergar are dead</b>*))"
msgstr "((*종양이 제거되었다. <b>듀에르가가 죽었다</b>*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Sovereign Glut
#. NodeID = f68fe597-daf9-77d5-f310-d2de15d0acfa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_MyconidCircle_BroodingSovereignHasMet(1) = True
#.   Global:
#.      - UND_MyconidCircle_AcceptedQuest = True
#. SetFlags:
#.   Quest:
#.     - UND_BroodingSovereign.Start(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:f68fe597-daf9-77d5-f310-d2de15d0acfa
msgctxt "h9e668a0dg5e72g483fgaa68g26531253029d"
msgid "((*toe-prancer. Sovereign Spaw has sung your fate*))"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Sovereign Glut
#. NodeID = f6c0aa3c-41f8-850d-e0dd-77f4ad7bf720
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_MyconidCircle_BroodingSovereign_State_InParty = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:f6c0aa3c-41f8-850d-e0dd-77f4ad7bf720
msgctxt "h33ee8356ge4bcg4eefga0feg1ec006f16248"
msgid "((*<b>the Age of Glut begins</b>*))"
msgstr "((*<b>글럿의 시대가 시작된다</b>*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Player
#. NodeID = f7419a57-1c09-e402-8402-1b8160662185
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:f7419a57-1c09-e402-8402-1b8160662185
msgctxt "h06f64457g38d6g47b2g8bb6ga6fcd123f753"
msgid ""
"<i>Imagine the battlefields of Avernus. Hell had been your home for too "
"long.</i>"
msgstr "<i>아베르누스의 잔혹한 전장을 떠올린다. 지옥을 집으로 여길 만큼 너무나도 오래 있었다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Sovereign Glut
#. NodeID = fa490dab-114d-1ed2-fde8-eddf5f92c3dd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_BroodingSovereign_Event_Enlarged = True
#.     - UND_BroodingSovereign_State_RefusedCircle = True
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#.   Quest:
#.     - UND_BroodingSovereign.RefusedCircle(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:fa490dab-114d-1ed2-fde8-eddf5f92c3dd
msgctxt "h2abf35fbgafe8g4404g8695gd83a898b6361"
msgid "((*you shall never again know <b>home</b>*))"
msgstr "((*너는 <b>고향</b>을 다시 보지 못할 것이다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Sovereign Glut
#. NodeID = fb7d401f-0562-a0f3-b097-0977d7d1a45d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:fb7d401f-0562-a0f3-b097-0977d7d1a45d
msgctxt "h6143f9f7g7156g4e19g8325g93dc27b93576"
msgid "((*duergar destroyed my people. I am a Sovereign with no Circle*))"
msgstr "((*듀에르가가 내 백성을 몰살했다. 나는 공동체 없는 군주다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign
#. Speaker = Sovereign Glut
#. NodeID = ffcbd530-90d5-2fd1-e7f1-8527525a4360
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign:ffcbd530-90d5-2fd1-e7f1-8527525a4360
msgctxt "hfbe1b9dfga58bg44f0gad3dgbce9bb131f3b"
msgid ""
"((*keep your allies steady, and your foes fearful. melodies of peace, even "
"in war*))"
msgstr "((*아군을 안정시키고, 적을 두려움에 빠뜨린다. 전투 중에도 평화로운 멜로디다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign_Leave
#. Speaker = Sovereign Glut
#. NodeID = 0c971e1d-37ef-173c-e69c-eb8b95205a3e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_MyconidCircle_Evenet_BroodingLeaveHasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - UND_MyconidCircle_Evenet_BroodingLeaveHasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign_Leave:0c971e1d-37ef-173c-e69c-eb8b95205a3e
msgctxt "h39dbc25fgfdddg4fdfgaf0bg566ddeab0d07"
msgid "((*no - no. I feel the faerzress... fading...*))"
msgstr "((*안 돼 - 안 돼. 페어즈레스가 사라지고... 있다...*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign_Leave
#. Speaker = Sovereign Glut
#. NodeID = 355c3ee8-d804-3af0-0564-f4adbee52748
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign_Leave:355c3ee8-d804-3af0-0564-f4adbee52748
msgctxt "h56d5fc79g9f3cg4ba7g8a71gd906fed729b6"
msgid "((*turn back. I am... weak...*))"
msgstr "((*돌아가. 난... 약하다...*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign_Leave
#. Speaker = Narrator
#. NodeID = 4f794b1c-8ec8-5eb0-245a-f59ebc2e1810
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - UND_MyconidCircle_Event_BroodingSovereignPassedFaerzressCheck(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign_Leave:4f794b1c-8ec8-5eb0-245a-f59ebc2e1810
msgctxt "hca27db71g8736g4efbg892cg9d2396753a0e"
msgid ""
"*You recall the faerzress - the energy of the Underdark. The myconid might "
"die if isolated from it.*"
msgstr "*당신은 페어즈레스, 언더다크의 에너지를 떠올립니다. 이 에너지를 차단하면 마이코니드는 죽을 수도 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign_Leave
#. Speaker = Player
#. NodeID = 5620ea64-11b7-4696-17fb-82f033b73b40
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_MyconidCircle_BroodingSovereign_State_InParty = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign_Leave:5620ea64-11b7-4696-17fb-82f033b73b40
msgctxt "he2d71888g5703g49bbg9ea7gd0fc04c3e170"
msgid "<i>Remain in the Underdark. This myconid is useful.</i>"
msgstr "<i>언더다크에 남는다. 이 마이코니드는 쓸모가 있을지도.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign_Leave
#. Speaker = Sovereign Glut
#. NodeID = 56eb54ec-8e2f-8a33-6952-be2f1e5b4c17
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign_Leave:56eb54ec-8e2f-8a33-6952-be2f1e5b4c17
msgctxt "hc209e93cg1b6cg43f6g863bg80f5084319e3"
msgid ""
"((*it nourishes us all. the Circles, the drow - we drink of its essence*))"
msgstr "((*그건 우리 모두를 풍요롭게 한다. 공동체, 드로우 - 우리는 그 정수를 마신다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign_Leave
#. Speaker = Player
#. NodeID = 77ea1165-6665-dbea-b238-207eacfefef7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_MyconidCircle_Event_BroodingSovereignPassedFaerzressCheck(1) = False
#.   Tag:
#.      - REALLY_UNDERDARK(1) = False
#. TagRule: BARD or CLERIC or REALLY_ELF or SORCERER or WARLOCK or WIZARD
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign_Leave:77ea1165-6665-dbea-b238-207eacfefef7
msgctxt "h5d691190g9b0ag446bga353gcef4dcc62116"
msgid "'Faerzress'? I've heard the word, but don't know its meaning."
msgstr "'페어즈레스'? 그 단어를 들어본 적은 있지만, 의미는 몰랐어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign_Leave
#. Speaker = Player
#. NodeID = 77ea1165-6665-dbea-b238-207eacfefef7
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_MyconidCircle_Event_BroodingSovereignPassedFaerzressCheck(1) = False
#.   Tag:
#.      - REALLY_UNDERDARK(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign_Leave:77ea1165-6665-dbea-b238-207eacfefef7
msgctxt "hd2cf8632gf556g443eg83dcg8962e4688924"
msgid "'Faerzress'? What are you talking about?"
msgstr "'페어즈레스'? 무슨 말을 하는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign_Leave
#. Speaker = Sovereign Glut
#. NodeID = 874c298d-6e16-76ac-770f-a182fbd268bc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_MyconidCircle_Evenet_BroodingLeaveHasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign_Leave:874c298d-6e16-76ac-770f-a182fbd268bc
msgctxt "h6631e1ecgbb49g4df3g9750gefbaf9385ee2"
msgid "((*please... I cannot leave the Underdark...*))"
msgstr "((*제발... 난 언더다크를 떠날 수 없다...*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign_Leave
#. Speaker = Player
#. NodeID = 9b8cdd9a-111a-54f1-0b2a-403cbdb8a5bb
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_MyconidCircle_BroodingSovereign_Event_Leave = True
#.     - UND_MyconidCircle_BroodingSovereign_State_InParty = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign_Leave:9b8cdd9a-111a-54f1-0b2a-403cbdb8a5bb
msgctxt "h7c1f48aeg579cg454cgabdbgcbf76f3572a1"
msgid "<i>Dismiss the myconid and move forward.</i>"
msgstr "<i>마이코니드를 보내주고 나아간다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign_Leave
#. Speaker = Sovereign Glut
#. NodeID = d686f51f-1af4-39dc-6343-2c8d4611ad6b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign_Leave:d686f51f-1af4-39dc-6343-2c8d4611ad6b
msgctxt "hff83aabcg273eg416aga5e2g5da699a05797"
msgid "((*I cannot leave the Underdark...*))"
msgstr "((*난 언더다크를 떠날 수 없다...*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign_Leave
#. Speaker = Narrator
#. NodeID = da15686a-970f-7d1c-c183-99a40e3bdd42
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_GALE or REALLY_UNDERDARK
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign_Leave:da15686a-970f-7d1c-c183-99a40e3bdd42
msgctxt "h0bce1f06g581dg41ceg8152g0f56d138c1e7"
msgid ""
"*You feel it too: the Underdark's magical energy - the faerzress - slipping "
"from your grasp.*"
msgstr "*당신도 느껴집니다: 언더다크의 마법 에너지 - 페어즈레스가 당신에게서 빠져나가고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign_Leave
#. Speaker = Sovereign Glut
#. NodeID = fdc2326a-d9af-a8bc-48c3-b7770987996d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_BroodingSovereign_Leave:fdc2326a-d9af-a8bc-48c3-b7770987996d
msgctxt "he0f58b76gc9f8g413cg93fbgc96d048d7923"
msgid "((*I will refresh myself near Spaw's Circle*))"
msgstr "((*스포의 공동체 근처에서 쉬고 있겠다 *))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000
#. Speaker = Sovereign Spaw
#. NodeID = 00d43750-3cf3-bbe4-3a5c-05c64eafebf2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000:00d43750-3cf3-bbe4-3a5c-05c64eafebf2
msgctxt "h6ff5cd6bg245fg4695gaa9eg6df09ce65ce2"
msgid "((*<i>vile beast</i>*))"
msgstr "((*<i>추악한 짐승이군</i>*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000
#. Speaker = Narrator
#. NodeID = 04fba7c5-6514-ed12-e2ce-cac956be40c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000:04fba7c5-6514-ed12-e2ce-cac956be40c0
msgctxt "hd55bf5d8g3c93g4c8eg88b6g215759eab7f1"
msgid ""
"*The choir fades. A single melody rises above the others, brassy and "
"commanding.*"
msgstr "*노래가 사그라듭니다. 깊게 울리며 두드러지는 단 하나의 멜로디가 다른 멜로디들 위로 떠오릅니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000
#. Speaker = Player
#. NodeID = 08a3cd80-8408-409d-82ad-e29c1a4ac354
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - e7a21b36-5594-2163-2bff-1b451a365984_PassedInsight = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000:08a3cd80-8408-409d-82ad-e29c1a4ac354
msgctxt "hf5439f8egc987g4da9gb458g7352bcc6dad7"
msgid "I sense your fear. I've come to aid you."
msgstr "네 두려움이 느껴지는군. 도우러 왔다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000
#. Speaker = Narrator
#. NodeID = 0d689d8a-173e-fc7e-b5f2-00a8552ec490
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_State_GainedAccess = False
#. TagRule: REALLY_UNDERDARK
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000:0d689d8a-173e-fc7e-b5f2-00a8552ec490
msgctxt "h21838eeag29cfg4e45g8ce6g3e79967080a3"
msgid ""
"*You are swallowed by a chorus of turbulent music. Through one creature sing "
"many voices: the harmony of a myconid collective.*"
msgstr "*당신은 넘실대는 음악에 집어삼켜집니다. 하나의 생명체가 다양한 목소리로 노래합니다: 마이크로니드 집단체의 화음입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000
#. Speaker = Narrator
#. NodeID = 0d689d8a-173e-fc7e-b5f2-00a8552ec490
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_State_GainedAccess = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000:0d689d8a-173e-fc7e-b5f2-00a8552ec490
msgctxt "h53e790a7gd013g45dfgbf13gd25d3e0b9d6e"
msgid ""
"*You are swallowed by a chorus of turbulent music. Through one creature sing "
"many voices: the harmony of an entire collective.*"
msgstr "*당신은 넘실대는 음악에 집어삼켜집니다. 하나의 생명체가 많은 목소리로 노래합니다: 운명체의 화음입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000
#. Speaker = Narrator
#. NodeID = 159911f0-184c-08c4-d069-97d9dd3aa2c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000:159911f0-184c-08c4-d069-97d9dd3aa2c4
msgctxt "h62757602g0ec5g4b65g9a70ga0869091c5eb"
msgid "*Fungal roots weave through your mind, seeking your true intent.*"
msgstr "*포자 뿌리들이 당신 내면을 휘저으며 속마음을 알아내려 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000
#. Speaker = Restless Myconid
#. NodeID = 19056cf0-4394-904c-b4e9-43855584714a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_MyconidSovereignReward = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000:19056cf0-4394-904c-b4e9-43855584714a
msgctxt "h26393f47g0957g43dfg820dgca8242ff297e"
msgid "((*you are worthy. be among us*))"
msgstr "((*넌 자격이 있군. 우리와 함께해라.*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000
#. Speaker = Restless Myconid
#. NodeID = 19586bd6-5b7a-af61-e94d-73ba2340bb66
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_MyconidCircle_State_Hostile = True
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000:19586bd6-5b7a-af61-e94d-73ba2340bb66
msgctxt "h5b7a72c9gecc8g4b00gb12ag6d36cde23132"
msgid "((*cure the Rot. <b>end it</b>*))"
msgstr "((*부패를 치유해라. <b>저것을 끝내라</b>*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000
#. Speaker = Player
#. NodeID = 1d2167b4-16a3-1ef9-654c-a9bb999e7eee
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#. TagRule: REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000:1d2167b4-16a3-1ef9-654c-a9bb999e7eee
msgctxt "h5505eb62ga007g437bg9289ge50827368748"
msgid "<i>Mumble an ancient gith axiom in rhythm with the sovereign.</i>"
msgstr "<i>군주와 리듬에 맞춰 고대 기스양키 격언을 중얼거립니다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000
#. Speaker = Player
#. NodeID = 1d2167b4-16a3-1ef9-654c-a9bb999e7eee
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000:1d2167b4-16a3-1ef9-654c-a9bb999e7eee
msgctxt "h055e1586g84c9g4ab7g8bb9g81f433459574"
msgid "<i>Hum a peaceful tune in harmony with the sovereign.</i>"
msgstr "<i> 군주와 화음을 맞춰 평화로운 곡조를 흥얼거린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000
#. Speaker = Narrator
#. NodeID = 1e9ba57b-9f54-39ba-4b5e-99cca3c4ecb5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000:1e9ba57b-9f54-39ba-4b5e-99cca3c4ecb5
msgctxt "h7668287dg4868g47e4gac99g12424913ea9c"
msgid "*...<i>strangling</i> you.*"
msgstr "*...당신의 <i>목을 조이고 있습니다</i> .*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000
#. Speaker = Player
#. NodeID = 21831088-b6c1-c7b9-af59-1b74ca3f56cf
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_DUERGARDWARF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000:21831088-b6c1-c7b9-af59-1b74ca3f56cf
msgctxt "h3df5b127g367fg4c8fga0bagafc69a0e14f1"
msgid "You dare call me rot? I'll kill you."
msgstr "나보고 감히 썩었다고? 널 죽여주마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000
#. Speaker = Player
#. NodeID = 21831088-b6c1-c7b9-af59-1b74ca3f56cf
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000:21831088-b6c1-c7b9-af59-1b74ca3f56cf
msgctxt "h90bcfc7dg4ecag415fga6eagc0c4ef50150b"
msgid "These tricks of the mind don't frighten me - I'll kill you!"
msgstr "이런 속임수 따윈 두렵지 않다- 널 죽여버리겠어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000
#. Speaker = Restless Myconid
#. NodeID = 21cf23d7-2a10-a40c-0f45-5f320279100b
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000:21cf23d7-2a10-a40c-0f45-5f320279100b
msgctxt "hf605a73agfa61g4245gb091g0a344d09c0fb"
msgid "((*Sovereign. he has come. he is here*))"
msgstr "((*군주님. 그가 왔습니다. 그가 도착했습니다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000
#. Speaker = Restless Myconid
#. NodeID = 21cf23d7-2a10-a40c-0f45-5f320279100b
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000:21cf23d7-2a10-a40c-0f45-5f320279100b
msgctxt "he370730cg97b2g42a3g882bg62e003c980ef"
msgid "((*Sovereign. she has come. she is here*))"
msgstr "((*군주님. 그녀가 왔습니다. 그녀가 도착했습니다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000
#. Speaker = Restless Myconid
#. NodeID = 21cf23d7-2a10-a40c-0f45-5f320279100b
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000:21cf23d7-2a10-a40c-0f45-5f320279100b
msgctxt "h20c21fdfg637bg41e8gbe24ga8552e074e29"
msgid "((*Sovereign. they have come. they are here*))"
msgstr "((*군주님. 그들이 왔습니다. 그들이 도착했습니다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000
#. Speaker = Narrator
#. NodeID = 327cdc06-18b5-105a-3403-5af567b94b82
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_MyconidCircle_State_GainedAccess = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000:327cdc06-18b5-105a-3403-5af567b94b82
msgctxt "ha55e9398g3a45g4462g965bgdd16129de891"
msgid "*Then the sovereign drones a new melody, cautious but welcoming.*"
msgstr "*그 후 군주는 새로운 멜로디를 웅웅거립니다. 조심스럽지만 환영하는 멜로디입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000
#. Speaker = Narrator
#. NodeID = 3df6a61c-7bb8-09ee-3a15-12f69516bf1a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000:3df6a61c-7bb8-09ee-3a15-12f69516bf1a
msgctxt "he593739dg1924g42f0ga432g9091bfc4c353"
msgid "*The persistent music coaxes you forward. The sovereign expects you.*"
msgstr "*지속되는 음악이 당신에게 앞으로 나아가라고 구슬립니다. 군주가 당신을 기다립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000
#. Speaker = Sovereign Spaw
#. NodeID = 44dee491-f7e7-91db-4325-d90580f840ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000:44dee491-f7e7-91db-4325-d90580f840ea
msgctxt "h587c8911ge48ag4e03g961bgaf297d8fe0d5"
msgid "((*<b>I am Sovereign</b>*))"
msgstr "((*<b>짐은 군주다</b>*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000
#. Speaker = Restless Myconid
#. NodeID = 50d4006c-e010-6319-8054-7d5176482bbb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_SpokeWithSovereign = True
#.      - UND_MyconidCircle_State_GainedAccess = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000:50d4006c-e010-6319-8054-7d5176482bbb
msgctxt "hd0541d98g79dcg4d73g8987gc0ef97a9d8b3"
msgid "((*the Sovereign spoke its word. you will obey*))"
msgstr "((*군주께서 말하셨다. 복종해라*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000
#. Speaker = Narrator
#. NodeID = 54837ddb-865a-2ea6-41ca-4a5f615489ce
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - e7a21b36-5594-2163-2bff-1b451a365984_PassedInsight = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000:54837ddb-865a-2ea6-41ca-4a5f615489ce
msgctxt "h265a6355g5e28g49f9g9861g112bee81d94b"
msgid ""
"*You detect a distinct quiver in every note. These creatures have "
"experienced recent tragedy.*"
msgstr "*당신은 매 음절에서 분명한 떨림을 감지합니다. 이 생명체들은 최근 비극을 겪었습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000
#. Speaker = Player
#. NodeID = 6944200f-c1d4-7969-15da-29179ff93060
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Local:
#.      - e7a21b36-5594-2163-2bff-1b451a365984_PassedInsight = False
#. TagRule: REALLY_DUERGARDWARF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000:6944200f-c1d4-7969-15da-29179ff93060
msgctxt "h9ad12924gaabcg43d4gab2bg67e8081044a6"
msgid "<i>Kneel in submission. </i>I mean no harm to you."
msgstr "<i>복종의 의미로 무릎을 꿇는다. </i> 너에게 해를 가할 의도는 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000
#. Speaker = Player
#. NodeID = 6944200f-c1d4-7969-15da-29179ff93060
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Local:
#.      - e7a21b36-5594-2163-2bff-1b451a365984_PassedInsight = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000:6944200f-c1d4-7969-15da-29179ff93060
msgctxt "ha4b2a86dg06edg4d11g89d0g6bcb0e74bd92"
msgid "<i>Kneel in submission. </i>My duergar companion means you no harm."
msgstr "<i>무릎을 꿇어 복종합니다. </i>듀에르가 동료는 당신에게 해를 가할 의도가 없습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000
#. Speaker = Restless Myconid
#. NodeID = 6db54152-1fba-8ad9-9cbe-bd715e4b9fa1
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000:6db54152-1fba-8ad9-9cbe-bd715e4b9fa1
msgctxt "h3c2367f6ge4b1g4282ga283ge127cbbe98b9"
msgid "((*Sovereign. he has come. the Rot has come*))"
msgstr "((*군주님. 그가 왔습니다. 썩은 자가 이곳에 당도했습니다.*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000
#. Speaker = Restless Myconid
#. NodeID = 6db54152-1fba-8ad9-9cbe-bd715e4b9fa1
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000:6db54152-1fba-8ad9-9cbe-bd715e4b9fa1
msgctxt "hf8a247ebg0e3eg44deg8f99g5e1be0475baf"
msgid "((*Sovereign. she has come. the Rot has come*))"
msgstr "((*군주님. 그녀가 왔습니다. 썩은 자가 이곳에 당도했습니다.*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000
#. Speaker = Restless Myconid
#. NodeID = 6db54152-1fba-8ad9-9cbe-bd715e4b9fa1
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000:6db54152-1fba-8ad9-9cbe-bd715e4b9fa1
msgctxt "h796c2db6g23d5g4539g9173gc4898c1d6e54"
msgid "((*Sovereign. they have come. the Rot has come*))"
msgstr "((*군주님. 그 자가 왔습니다. 썩은 자가 이곳에 당도했습니다.*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000
#. Speaker = Player
#. NodeID = 7252344d-f1b9-1dcd-337e-e5c287c1c692
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BERSERKER(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000:7252344d-f1b9-1dcd-337e-e5c287c1c692
msgctxt "h6d314ed9g39aeg4077g986cg2f603c023c9c"
msgid "<b><i>ROAR.</i></b>"
msgstr "<b><i>크아아.</i></b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000
#. Speaker = Player
#. NodeID = 74e20e06-1dcb-dbba-c021-c61fe5668f5d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - e7a21b36-5594-2163-2bff-1b451a365984_PassedInsight = False
#. SetFlags:
#.   Local:
#.     - e7a21b36-5594-2163-2bff-1b451a365984_PassedHealing = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000:74e20e06-1dcb-dbba-c021-c61fe5668f5d
msgctxt "h9a137e8egdd46g4262gb8abge240e3315008"
msgid ""
"<i>Tell the truth of the parasite. You only seek safe passage in your search "
"for treatment.</i>"
msgstr "<i>기생충의 진실을 말한다. 치료제를 모색하기 위해 안전한 길을 찾는 것뿐이다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000
#. Speaker = Player
#. NodeID = 7a827fef-44ef-eda2-0750-e16a5390cd50
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Quest:
#.      - UND_LoneDuergar.ToldQuest(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000:7a827fef-44ef-eda2-0750-e16a5390cd50
msgctxt "h38bc963egb64ag4b3cg8f97gb66adeca5f54"
msgid "Let me pass. I've come for the runaway gnome."
msgstr "지나가게 해줘. 도망친 노움을 잡으러 왔다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000
#. Speaker = Narrator
#. NodeID = 8235b1ad-29c9-3e0b-19d1-1d96648d1094
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000:8235b1ad-29c9-3e0b-19d1-1d96648d1094
msgctxt "hd3ec1f2ag3767g4ab7gbc42g5510978e1334"
msgid "*The parasite is quiet. You feel no bond with the creature.*"
msgstr "*기생충이 조용합니다. 당신은 이 생명체와 어떠한 결속도 느끼지 못합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000
#. Speaker = Player
#. NodeID = 845b5e19-2fd9-be5a-4e03-432f14e48faf
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Local:
#.      - e7a21b36-5594-2163-2bff-1b451a365984_PassedInsight = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000:845b5e19-2fd9-be5a-4e03-432f14e48faf
msgctxt "h6eadc67eg323fg4aa0gb520g71a9c245e2bb"
msgid "I am a traveller seeking adventure."
msgstr "나는 모험을 갈구하는 여행자야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000
#. Speaker = Player
#. NodeID = 8b1baa9b-0302-a4c1-fb35-51cb326f503e
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DEEPGNOME or DROWELF or DROWHALFELF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000:8b1baa9b-0302-a4c1-fb35-51cb326f503e
msgctxt "h6043ddf9g824fg4726g8ad7gef272394d52f"
msgid "The Underdark is my home - I don't need your permission to pass."
msgstr "언더다크는 나의 집- 당신의 허락 따윈 필요하지 않습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000
#. Speaker = Sovereign Spaw
#. NodeID = 8b9519aa-ca15-894c-a440-8ab9b835382b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - e7a21b36-5594-2163-2bff-1b451a365984_PassedHealing = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000:8b9519aa-ca15-894c-a440-8ab9b835382b
msgctxt "h2355a585gf264g4a25ga104gb70efa837019"
msgid "((*I can mend neither skin nor spirit. but we still might commune*))"
msgstr "((*나는 육체도, 영혼도 고칠 수 없다. 그래도 우리는 교감할 수 있다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000
#. Speaker = Sovereign Spaw
#. NodeID = 8f6ae10b-a0b8-3e41-0701-bae775952cd4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000:8f6ae10b-a0b8-3e41-0701-bae775952cd4
msgctxt "h4cba5c13g7791g4aefgab93gb0b1d3ac74d5"
msgid "((*descend to me. let us speak in flesh*))"
msgstr "((*내게 와라. 육체로 대화하자*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000
#. Speaker = Narrator
#. NodeID = 91b8e10c-9262-4611-67d8-0065da0b1198
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000:91b8e10c-9262-4611-67d8-0065da0b1198
msgctxt "h2302e7d0g0077g4be4g8dabg0297b82b911f"
msgid "*You discern no information or intention in the sovereign's song.*"
msgstr "*당신은 군주의 노래에서 어떠한 정보나 의도를 알아채지 못합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000
#. Speaker = Narrator
#. NodeID = 93e95ec9-082f-68da-ce76-4dd269b77657
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000:93e95ec9-082f-68da-ce76-4dd269b77657
msgctxt "h09ad4a47g3d40g4d31ga475g4e0aa3a171c4"
msgid ""
"*The fright-choir fades. A single melody rises above the others, brassy and "
"commanding.*"
msgstr "*무서운 노래가 사그라듭니다. 깊게 울리며 두드러지는 단 하나의 멜로디가 다른 멜로디들 위로 떠오릅니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000
#. Speaker = Player
#. NodeID = 94bd674c-18d4-5c15-4d8f-259047be7d55
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Local:
#.      - e7a21b36-5594-2163-2bff-1b451a365984_PassedInsight = False
#.   Tag:
#.      - REALLY_DUERGARDWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000:94bd674c-18d4-5c15-4d8f-259047be7d55
msgctxt "h0b744966g852bg4d6fgab6dg3eb4f817d7d7"
msgid ""
"<i>Counter with your own memory. Duergar builders, not burners. Not rot.</i>"
msgstr "<i>기억을 떠올립니다. 방화광이 아니며, 썩지 않은 듀에르가 장인들을 말입니다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000
#. Speaker = Narrator
#. NodeID = 9e176fb4-3eb7-8e83-9ce0-af1f03d54500
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000:9e176fb4-3eb7-8e83-9ce0-af1f03d54500
msgctxt "hc811f4c4gead2g44adg84ceg346f7df669d1"
msgid ""
"*You see a vision: your lifeless body, wrapped in fungal tendrils. The "
"sovereign is <i>threatening</i> you.*"
msgstr "*환상이 보입니다: 곰팡이 덩굴손에 싸인 생명 없는 당신의 몸입니다. 군주가 당신을 <i>위협하고</i> 있는 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000
#. Speaker = Narrator
#. NodeID = 9fceb53e-3633-1b3e-7712-5a417be81166
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_State_DuergarInParty = True
#.      - UND_MyconidCircle_State_GainedAccess = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000:9fceb53e-3633-1b3e-7712-5a417be81166
msgctxt "hb1b68b27g07c1g4795g9e62gcbfaba66a62e"
msgid ""
"*You are swallowed by a chorus of frenzied music. Through one creature sing "
"many voices: the harmony of a myconid collective.*"
msgstr "*당신은 광란의 음악에 집어삼켜집니다. 하나의 생명체가 다양한 목소리로 노래합니다: 마이크로니드 집단체의 화음입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000
#. Speaker = Sovereign Spaw
