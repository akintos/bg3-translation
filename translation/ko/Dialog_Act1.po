msgctxt "he5227342g5996g4dbega8f9g10a5b8cfbca7"
msgid "Ngh! <i>Vlaakith tavki na'zin. Vlaakith tavki na'zin!</i>"
msgstr "으윽! <i>블라키스 타브키 나진. 블라키스 타브키 나진!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
