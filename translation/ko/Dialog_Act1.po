msgctxt "h8b6cbde3g8242g4b40ga335g9ecab8cab57b"
msgid "A bone? Somewhere out there, a skeleton's missing a piece."
msgstr "뼈라고? 저기 어딘가 어떤 해골의 잃어버린 조각인 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_WormWall_PAD_Empty3
