#.      - FOR_ApothecaryGoblins_Goblin01_HasMet(1) = True
#.   Tag:
#.      - DROWELF(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_ApothecaryGoblins_Goblin_01:a13a615d-2e45-3463-5f67-11e11af438c3
msgctxt "hfa98bfffg091ag4d19gbc0cg5644118d0eae"
msgid "All the good bits is yours, of course."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_ApothecaryGoblins_Goblin_01
