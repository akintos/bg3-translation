msgctxt "hf0a1cb31g92a2g481egbc77ga636fa94b408"
msgid "That was no ordinary bear... better investigate the corpse."
msgstr "저건 평범한 곰이 아니었군... 시체를 조사해 봐야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/VBs/GOB_Halsin_PAD_HalsinDead
