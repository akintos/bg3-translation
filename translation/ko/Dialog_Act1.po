msgctxt "h217aac04gbe10g4838g8f4eg45b21589da2c"
msgid "Danis?"
msgstr "다니스?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover_AD_Shared
#. Speaker = Danis
#. NodeID = 06e356ed-02e7-f123-1e5e-e35df14873bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover_AD_Shared:06e356ed-02e7-f123-1e5e-e35df14873bf
msgctxt "hb639ae6dge1ebg4caeg9ffcg5aa4e579a2a3"
msgid "You sound like your father."
msgstr "꼭 아버님처럼 말하네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover_AD_Shared
#. Speaker = Bex
#. NodeID = 08e9ec03-d795-64c1-2084-21247ed0f01c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover_AD_Shared:08e9ec03-d795-64c1-2084-21247ed0f01c
msgctxt "h1a23fe5egdf5ag4840g998egcb84e919c54a"
msgid ""
"My love, you were a caravan escort for three days, and you quit in the "
"middle of your shift."
msgstr "자기야, 자기는 상단 경비 사흘 밖에 안 했고, 그마저도 중간에 그만뒀잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover_AD_Shared
#. Speaker = Danis
#. NodeID = 1de23ac8-6733-df67-646d-930e0573b7e5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover_AD_Shared:1de23ac8-6733-df67-646d-930e0573b7e5
msgctxt "h3b324342g8235g4eb9gb360gf7cd152f494b"
msgid "Whatever we want!"
msgstr "뭐든 할 수 있지!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover_AD_Shared
#. Speaker = Bex
#. NodeID = 2537cd59-69f6-37c3-40a5-c603cb767809
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover_AD_Shared:2537cd59-69f6-37c3-40a5-c603cb767809
msgctxt "h5d012d73g967cg4a20g9a68gdecfd1834897"
msgid "Well, it was his caravan."
msgstr "그야, 우리 아빠 상단이었으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover_AD_Shared
#. Speaker = Bex
#. NodeID = 4b63b948-7361-32f6-66a4-c3c83bd2aea8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - d44a680c-908f-7060-0893-d1120252abb2_Switch = True
#. SetFlags:
#.   Local:
#.     - d44a680c-908f-7060-0893-d1120252abb2_Switch = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover_AD_Shared:4b63b948-7361-32f6-66a4-c3c83bd2aea8
msgctxt "hd62f71ccg6a6fg4021g86f2g63e3e5c9b0ea"
msgid "What will we do for work when we get to the city?"
msgstr "도시에 닿으면 뭘로 먹고살아야 할까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover_AD_Shared
#. Speaker = Bex
#. NodeID = 69493db6-111a-f7d6-4005-8192cf7a2cfc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover_AD_Shared:69493db6-111a-f7d6-4005-8192cf7a2cfc
msgctxt "hd59ae9c3g1d37g4570gbffbg459121c9c8e1"
msgid "Sure. Blood excites me."
msgstr "그럼. 피를 보면 짜릿하더라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover_AD_Shared
#. Speaker = Danis
#. NodeID = b3972089-a213-15a4-d121-672dbc7c07bb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - d44a680c-908f-7060-0893-d1120252abb2_Switch = False
#. SetFlags:
#.   Local:
#.     - d44a680c-908f-7060-0893-d1120252abb2_Switch = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover_AD_Shared:b3972089-a213-15a4-d121-672dbc7c07bb
msgctxt "h2717dd3dgde44g45f8g839dg51057cc5e524"
msgid "I'll talk to the guards in Baldur's Gate. I speak their language."
msgstr "난 발더스 게이트 경비대에 들어갈 거야. 나름 경험이 있으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover_AD_Shared
#. Speaker = Bex
#. NodeID = b6bfbe15-c00b-85e1-c6bb-c2343b173e95
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover_AD_Shared:b6bfbe15-c00b-85e1-c6bb-c2343b173e95
msgctxt "h54b396a4g3ea8g4676gaf70gbbadc245f3c8"
msgid "I think I'd make a fine teacher. Or a baker. Or a butcher."
msgstr "난 좋은 선생님이 될 수 있을 것 같아. 제빵사도 괜찮고. 도축업자도 좋지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover_AD_Shared
#. Speaker = Danis
#. NodeID = d3f21827-f6b9-b760-c3db-04e0c3323025
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover_AD_Shared:d3f21827-f6b9-b760-c3db-04e0c3323025
msgctxt "hc89c85bcg4dc4g4522g9883ga061153c9180"
msgid "Erm... right."
msgstr "음... 그래."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover_AD_Shared
#. Speaker = Danis
#. NodeID = f3e18335-98a8-48ce-6576-3fa876112a79
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover_AD_Shared:f3e18335-98a8-48ce-6576-3fa876112a79
msgctxt "h012b7466g4ca1g4d76g81a2g65d3a735c704"
msgid "A butcher? Really?"
msgstr "도축업자? 진심이야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ZenBear_AD
#. Speaker = Ormn
#. NodeID = be3bd09b-7099-4471-d4ee-9749af0dbf4f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_ZenBear_AD:be3bd09b-7099-4471-d4ee-9749af0dbf4f
msgctxt "h00729f98g4413g4065gbf6cgbb5603a6d686"
msgid "*Grunt.*"
msgstr "*끙.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/GEB_DEN_CapturedGoblin_AD_Crime
#. Speaker = GROUP_Civilians
#. NodeID = 61bd0953-9a2c-7e3d-f2c5-8222c2724c86
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/GEB_DEN_CapturedGoblin_AD_Crime:61bd0953-9a2c-7e3d-f2c5-8222c2724c86
msgctxt "h7209c111gffcdg4eb5gb443g096e0c617e54"
msgid "The goblin is escaping! Kill it!"
msgstr "고블린이 도망친다! 죽여!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/GEB_DEN_DruidAttack_AD_NoticedIdolStolen
#. Speaker = GROUP_Act1_DEN_DruidAttackInvestigators
#. NodeID = c4c73f5e-8e9d-19cd-02f7-0458cf0224ad
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_DruidAttack_Event_SaidCrimeAD = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/GEB_DEN_DruidAttack_AD_NoticedIdolStolen:c4c73f5e-8e9d-19cd-02f7-0458cf0224ad
msgctxt "h81e2254cg62f4g4084gbce5g9dc61a8c730d"
msgid "The idol is gone. Round up the intruders - we've been patient enough."
msgstr "성상이 사라졌다. 침입자를 몰아내. 그동안 참을 만큼 참았다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/GEB_DEN_DruidAttack_AD_NoticedIdolTampered
#. Speaker = GROUP_Act1_DEN_DruidAttackInvestigators
#. NodeID = f2ec813e-b57e-98e3-b6c8-533dfb730104
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_DruidAttack_Event_SaidCrimeAD = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/GEB_DEN_DruidAttack_AD_NoticedIdolTampered:f2ec813e-b57e-98e3-b6c8-533dfb730104
msgctxt "h4b1cc734g00d5g43fbgbdb0g6c6d9027ea0f"
msgid ""
"The Idol of Silvanus! Round up the intruders - we've been patient enough."
msgstr "실바누스 성상이! 침입자를 몰아내. 우린 참을 만큼 참았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/SFX_DEN_RaidingParty_PleaAtTheGate
#. Speaker = Remira
#. NodeID = a392f302-82ea-636b-5667-faa3a619ef00
