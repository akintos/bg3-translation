msgctxt "h429677bfg07eag4ab4g92cdg1803f1b4b37b"
msgid ""
"*Your mind is full, bursting with ecstasy and terror. Finally, it is coming. "
"You are becoming.*"
msgstr "*당신의 정신이 황홀경과 공포로 가득 차오릅니다. 마침내, 때가 됐군요. 당신은 변화 중입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinSleeper_01
#. Speaker = Tracker Dullwill
#. NodeID = 36637808-a318-0efe-c11e-aad49bc14e05
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_Festivities_SleepersFight(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinSleeper_01:36637808-a318-0efe-c11e-aad49bc14e05
msgctxt "h7b1801e5g6f9bg4d8fgb3d6g527740646ef0"
msgid "Who the hells are you, giving me orders? I'll cut ya!"
msgstr "네가 뭔데 명령질이야? 베어주마!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinSleeper_01
