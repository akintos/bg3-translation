#.      - GOB_GoblinBrash_HasMet(1) = True
#.   Tag:
#.      - BRANDED(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinBrash:cb9931e4-bda9-f6e0-7399-33f5cdda5ca6
msgctxt "he10d86a8gc60cg4bbbg8f7ag028bde93addd"
msgid "Still loiterin'?"
msgstr "아직도 얼쩡거려?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinBrash
#. Speaker = Player
#. NodeID = e2d828db-b895-8b69-d021-f66bd8b23aef
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_GoblinPriest_State_LeftBranding = True
#.   Tag:
#.      - BRANDED(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinBrash:e2d828db-b895-8b69-d021-f66bd8b23aef
msgctxt "hdfa23455g689eg49ffg9adcg163a5a8cebab"
msgid "I have more guts than most. Brand me."
msgstr "나보다 용감한 이는 몇 없을걸. 표식을 새겨봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinBrash
#. Speaker = Player
#. NodeID = e8215cc6-c849-425c-4acb-ae46b9ac8914
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_GoblinPriest_State_LeftBranding = False
#.   Tag:
#.      - BRANDED(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinBrash:e8215cc6-c849-425c-4acb-ae46b9ac8914
msgctxt "h28592a89ga5afg4fa7g905egeee1f3aecb23"
msgid "I'll be marked soon, don't worry."
msgstr "곧 표식이 생길 거야, 걱정하지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinBrash
