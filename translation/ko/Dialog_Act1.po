msgctxt "h171d8ce5gc6a7g4ec1gb73cga02efd50d2cb"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointWarning
#. Speaker = Warrior Khunaruth
#. NodeID = a9779526-3b33-809e-b00a-c92a7582a554
