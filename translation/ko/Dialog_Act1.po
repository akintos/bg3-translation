#.      - CHA_LaezelRecruitment_State_Tiefling2Missing = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaezelRecruitment_TieflingsSceneFallback:8573316b-9cf8-4dee-901c-7749a0c38351
msgctxt "h533c37b9g1d6eg4d68gb9d5g2c5b5199b0ef"
msgid "<i>Get rid of her.</i>"
msgstr "<i>저년을 없애.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaezelRecruitment_TieflingsSceneFallback
#. Speaker = Lae'zel
#. NodeID = a0bad115-c229-445a-9cc3-633ae283e7b4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_Laezel_State_StartedTieflingsSceneAtCage(3) = True
