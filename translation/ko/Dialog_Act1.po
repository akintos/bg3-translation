msgctxt "h161e6b1dgca28g4352ga387gbfbdaeb15dbf"
msgid "Enjoy playing with your new friends. Bye-bye!"
msgstr "새 친구들과 즐겹게 놀려무나. 안녕!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_AD_TeleportSurrogateMother
#. Speaker = Auntie Ethel
