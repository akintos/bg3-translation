#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount3(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SecludedSpot_Trespassing:4dcbd63d-4342-2893-ba78-99d4908f9aa8
msgctxt "had31f87eg58b9g48dcgb9a1gafcaeebc4dd8"
msgid "*Your mind lurches, reeling suddenly as if... bitten.*"
msgstr "*뭔가에 깨물린 것처럼 느닷없이 정신이 휘청거립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SecludedSpot_Trespassing
#. Speaker = Brawler Rancer
#. NodeID = 5b6c52f2-37ec-05de-c8e7-2789fa5e582e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_Checkpoint_State_GainedAccess = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SecludedSpot_Trespassing:5b6c52f2-37ec-05de-c8e7-2789fa5e582e
msgctxt "hfa2c140bg1602g4208ga533ga2e6c9f39702"
msgid "Bye then."
msgstr "그럼 안녕."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SecludedSpot_Trespassing
#. Speaker = Player
#. NodeID = 5c786f74-1e2c-673e-f64c-254ba2e84978
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SecludedSpot_Trespassing:5c786f74-1e2c-673e-f64c-254ba2e84978
msgctxt "h8a807f5ag5501g45a0g8d97g7ab8f1de150b"
msgid "A True Soul - the ones you obey <i>on pain of death</i>."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SecludedSpot_Trespassing
#. Speaker = Narrator
#. NodeID = 628144a1-eade-1bdd-1519-d1c8c152ccdb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - GLO_TadpoleIntro_NPC(1) = False
#. SetFlags:
#.   User:
#.     - GLO_TadpoleIntro_NPC(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SecludedSpot_Trespassing:628144a1-eade-1bdd-1519-d1c8c152ccdb
msgctxt "h1ae520fcg2145g4f34g896ag4a438bad4f30"
msgid ""
"*A strange symbol glows, marked on their flesh, and something within you "
"stirs in response.*"
msgstr "*그들의 살갗에 새겨진 기묘한 상징이 빛나고, 이에 반응하여 당신 내면의 무언가가 꿈틀거립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SecludedSpot_Trespassing
#. Speaker = Narrator
#. NodeID = 70d0a299-0f4c-1873-6528-bd0abe0990e5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SecludedSpot_Trespassing:70d0a299-0f4c-1873-6528-bd0abe0990e5
msgctxt "hbc8814a4g1b19g41ccg96cdge6c64734ca6d"
msgid ""
"*The mark glows, but you feel nothing in response. Your illithid power is "
"beyond reach until you rest.*"
msgstr "*문양이 빛나지만, 어떤 반응도 느껴지지 않습니다. 일리시드 능력을 더 사용하려면 휴식을 취해야 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SecludedSpot_Trespassing
