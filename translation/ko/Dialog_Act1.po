msgctxt "hd7cc7e82ga982g48c6ga21eg1ed2ebfa2ec4"
msgid "A book of necromancy? <i>Interesting</i>."
msgstr "강령술 책이네? <i>흥미롭군</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_DangerousBook_PAD_FindBook
#. Speaker = Player
#. NodeID = 2bb9b79a-0788-6e0b-1e4d-8bf8e28c10b2
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Gale_Knows_NeedsMagicItems = False
