msgctxt "h4ade00ebge8a7g432ag92b9g145a66e942d0"
msgid "*The door gives way with a loud crack.*"
msgstr "*커다란 파열음과 함께 문이 무너집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_TavernInvestigation_DesireDoor
#. Speaker = Narrator
#. NodeID = 2e4bb550-d43b-47c2-33f7-161b4f05b66b
