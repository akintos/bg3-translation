msgctxt "hf8b59c5dg31a4g4867ga301gfb731a779943"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarLoyalSergeant
#. Speaker = Player
