msgid "Let's... let's just keep going, all right?"
msgstr "그냥... 그냥 계속 가자, 알겠지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_LaezelKilledByGith
#. Speaker = Player
#. NodeID = 1266e90b-d755-3d93-67ef-d8c2f802c395
