msgctxt "hd744e59eg9737g4b59g8298g0a7cf87a0ca8"
msgid "To Ilmater, who always endures!"
msgstr "언제나 인내하는 자, 일메이터를 위하여!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Player
#. NodeID = f29720cb-f396-5e5a-5900-5ac9cee1fea4
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: CLERIC_MYSTRA or PALADIN_MYSTRA
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:f29720cb-f396-5e5a-5900-5ac9cee1fea4
msgctxt "h48595184g6762g4f42g91feg61299617bc0d"
msgid "To Mystra, mother of the Weave!"
msgstr "위브의 어머니, 미스트라를 위하여!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Player
#. NodeID = f29720cb-f396-5e5a-5900-5ac9cee1fea4
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: CLERIC_HELM or PALADIN_HELM
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:f29720cb-f396-5e5a-5900-5ac9cee1fea4
msgctxt "h09a34e05gdbf1g4c0aga798gd32528249d76"
msgid "To Helm, ever-vigilant!"
msgstr "영원히 경계하는 자, 헬름을 위하여!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Player
#. NodeID = f29720cb-f396-5e5a-5900-5ac9cee1fea4
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: CLERIC_KELEMVOR or PALADIN_KELEMVOR
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:f29720cb-f396-5e5a-5900-5ac9cee1fea4
msgctxt "hf4b11da5gd4bbg4a75gaa0eg69dae61cddff"
msgid "To Kelemvor, who judges us all!"
msgstr "우리 모두를 심판하는 자, 켈렘보르를 위하여!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Player
#. NodeID = f29720cb-f396-5e5a-5900-5ac9cee1fea4
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: CLERIC_OGHMA or PALADIN_OGHMA
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:f29720cb-f396-5e5a-5900-5ac9cee1fea4
msgctxt "h1b7a85a4g6a45g40ddga12ag949ca94422d2"
msgid "To Oghma, father of knowledge!"
msgstr "지식의 아버지, 오그마를 위하여!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Player
#. NodeID = f29720cb-f396-5e5a-5900-5ac9cee1fea4
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: CLERIC_TEMPUS or PALADIN_TEMPUS
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:f29720cb-f396-5e5a-5900-5ac9cee1fea4
msgctxt "hd370a7ccg119eg4078g98b1gfdddde6b6822"
msgid "To Tempus, who crushes his foes!"
msgstr "적들을 쳐부수는 자, 템푸스를 위하여!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Player
#. NodeID = f29720cb-f396-5e5a-5900-5ac9cee1fea4
#. HandlePath = TaggedText[8].TagText[0]
#. TagRule: CLERIC_SHAR or PALADIN_SHAR
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:f29720cb-f396-5e5a-5900-5ac9cee1fea4
msgctxt "h9551ef85g066fg4c31gb5d3g1364e4973088"
msgid "To Shar, mistress of the night!"
msgstr "밤의 정부, 샤를 위하여!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Player
#. NodeID = f29720cb-f396-5e5a-5900-5ac9cee1fea4
#. HandlePath = TaggedText[9].TagText[0]
#. TagRule: CLERIC_BHAAL or PALADIN_BHAAL
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:f29720cb-f396-5e5a-5900-5ac9cee1fea4
msgctxt "h712119ecgb61ag4039gba2dgf907f4b71e2e"
msgid "To Bhaal, who bleeds the world dry!"
msgstr "세계의 피를 말리는 자, 바알을 위하여!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Player
#. NodeID = f29720cb-f396-5e5a-5900-5ac9cee1fea4
#. HandlePath = TaggedText[10].TagText[0]
#. TagRule: CLERIC_BANE or PALADIN_BANE
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:f29720cb-f396-5e5a-5900-5ac9cee1fea4
msgctxt "haa2ddf10gf4ffg499ega99fga323bb45ef6f"
msgid "To Bane, rightful ruler!"
msgstr "정당한 지배자, 베인을 위하여!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Player
#. NodeID = f29720cb-f396-5e5a-5900-5ac9cee1fea4
#. HandlePath = TaggedText[11].TagText[0]
#. TagRule: CLERIC_MYRKUL or PALADIN_MYRKUL
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:f29720cb-f396-5e5a-5900-5ac9cee1fea4
msgctxt "hd7c4798eg355fg415fgab3bgd5ecd9d570df"
msgid "To Myrkul, lord of bones!"
msgstr "뼈의 군주, 머큘을 위하여!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Sharp-Eye Mirg
#. NodeID = f434f9bf-1fbd-ed83-6ef6-14fea56392f7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:f434f9bf-1fbd-ed83-6ef6-14fea56392f7
msgctxt "h6909df20g083dg475cga099gff4ea15077e7"
msgid "Go on, drink up!"
msgstr "뭐해, 마셔!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Sharp-Eye Mirg
#. NodeID = f4c1c872-61cd-8cb8-faee-40be1ed4f437
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DUERGARDWARF or DWARF
