msgctxt "hdfae7309gda2cg4b73gb398g5957dc894c66"
msgid "<i>Free him.</i>"
msgstr "<i>그를 풀어준다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_UnfortunateGnome_TiedUp
#. Speaker = Barcus Wroot
#. NodeID = f4db18df-7bfc-46cf-5e82-4581b3d15a68
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_UnfortunateGnome_TiedUp:f4db18df-7bfc-46cf-5e82-4581b3d15a68
msgctxt "h00f68d4dg91d6g4a9dga10age34e8cb0f586"
msgid "Free me and find out."
msgstr "날 풀어주면 알게 되겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_VillageHole_PAD
#. Speaker = Player
#. NodeID = 320f1f2d-2047-4abd-ad0e-572a22ba793f
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_VillageHole_PAD:320f1f2d-2047-4abd-ad0e-572a22ba793f
msgctxt "hf8855995g4b66g4e4bga30ag54de9b8a857c"
msgid "Ah, someone had good taste in books."
msgstr "아, 여기 책 좀 아는 사람이 있네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_VillageHole_PAD
#. Speaker = Player
#. NodeID = 320f1f2d-2047-4abd-ad0e-572a22ba793f
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_VillageHole_PAD:320f1f2d-2047-4abd-ad0e-572a22ba793f
msgctxt "h57c5e3a9g1d07g47bfg8832g2ee58071fb98"
msgid ""
"Well, well! Come for the words, stay for the wine. The owner of this tome "
"must have been quite the jolly fellow."
msgstr "이거 봐라! 글을 읽으러 왔다가 와인을 즐긴달까. 이 책의 주인은 꽤나 재밌는 사람이었겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_VillageHole_PAD
#. Speaker = Player
#. NodeID = 320f1f2d-2047-4abd-ad0e-572a22ba793f
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_VillageHole_PAD:320f1f2d-2047-4abd-ad0e-572a22ba793f
msgctxt "hd8702c92gf3f5g426aga250gdc2bd35a1dca"
msgid "Heh. A scholar after my own heart."
msgstr "헤. 나랑 잘 맞는 학자분이시군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_VillageHole_PAD
#. Speaker = Player
#. NodeID = 320f1f2d-2047-4abd-ad0e-572a22ba793f
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_VillageHole_PAD:320f1f2d-2047-4abd-ad0e-572a22ba793f
msgctxt "h7a9dc125g2834g4805g8ac3g325c8bb1930c"
msgid "Wine. A reader with decadent tastes, perhaps."
msgstr "와인이라. 향락에 젖은 독자인가 보군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_VillageHole_PAD
#. Speaker = Player
#. NodeID = 320f1f2d-2047-4abd-ad0e-572a22ba793f
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_VillageHole_PAD:320f1f2d-2047-4abd-ad0e-572a22ba793f
msgctxt "ha7f1bbb4g0f50g4d1dg95d4ga16271c3cce8"
msgid "Hmm. Seems like someone liked their books to have a twist."
msgstr "흐음. 반전 스토리를 좋아하는 독자인가 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_VillageHole_PAD
#. Speaker = Player
#. NodeID = 320f1f2d-2047-4abd-ad0e-572a22ba793f
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_VillageHole_PAD:320f1f2d-2047-4abd-ad0e-572a22ba793f
msgctxt "h2c64bf51g4193g4135g98f5g1db0e1d42881"
msgid ""
"A bottle of wine? And a rare one at that. This book's owner had excellent "
"taste."
msgstr "와인 병? 그것도 꽤나 귀한 건데. 이 책의 주인은 술을 잘 아네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_VillageHole_PAD
#. Speaker = Player
#. NodeID = 320f1f2d-2047-4abd-ad0e-572a22ba793f
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_VillageHole_PAD:320f1f2d-2047-4abd-ad0e-572a22ba793f
msgctxt "h820858c5g99c6g4fb2gad92g47fd3a495f55"
msgid "A wine bottle? A scholar with good taste, perhaps."
msgstr "와인 병? 뭘 좀 아는 학자인가 보군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_VillageHole_PAD
#. Speaker = Player
#. NodeID = 906ad70e-c219-4810-bdbd-843f6baea7a7
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_VillageHole_PAD:906ad70e-c219-4810-bdbd-843f6baea7a7
msgctxt "h1ed9a1ebg9690g4a1ag880dg6906ea8e406e"
msgid "Ah, someone had good taste in books."
msgstr "아, 여기 책 좀 아는 사람이 있네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_VillageHole_PAD
#. Speaker = Player
#. NodeID = 906ad70e-c219-4810-bdbd-843f6baea7a7
