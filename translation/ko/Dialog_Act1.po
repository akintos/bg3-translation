msgctxt "h1d668735gba22g4950g864dg116f39fc4019"
msgid "<i>Examine the rocks for anything out of the ordinary.</i>"
msgstr "<i>이상한 점은 없는지 바위를 조사해 본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_GruntingKid
