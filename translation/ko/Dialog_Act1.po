#.      - FOR_ThayanCellar_Event_TriedToTrick(1) = False
#. SetFlags:
#.   Object:
#.     - FOR_ThayanCellar_Event_TriedToTrick(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:207e223a-34d8-ddf7-b667-7c0da23751fc
msgctxt "h99f57f91ga807g4d95g9994g1a1025556b0a"
msgid "I'm invisible - my enemies are close. I have to get in <i>now</i>."
msgstr "난 투명하고, 내 적들이 가까이 있어. <i>당장</i> 들어가야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Ornate Mirror
#. NodeID = 23069451-2da3-648a-0753-a494dc4ff124
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror:23069451-2da3-648a-0753-a494dc4ff124
msgctxt "h28cb671cg1f71g49d6g8dccg8f0b99db1213"
msgid "What th-ink you of the zulkir known as Szass Tam?"
msgstr "스자스 탐이라는 이름의 줄키르에 대해 어떻게 생각하는가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
#. Speaker = Ornate Mirror
#. NodeID = 26399463-fd5d-aaef-f8e4-b142181b642e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
