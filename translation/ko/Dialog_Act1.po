#.     - UND_PetrifiedDrow_HasMet_Drow_005(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_005:e133d338-9114-427d-ed28-dbcaef5c87f6
msgctxt "h67c2d867g7e3fg462dg8048g88cf2de790fe"
msgid "Ngh... my head..."
msgstr "으윽... 머리야..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_005
#. Speaker = Petrified Drow
#. NodeID = ea9df7d7-72aa-41bb-b71c-cde08e9d9539
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_PetrifiedDrow_HasMet_Drow_005(1) = False
#.   Global:
#.      - UND_PetrifiedDrow_State_WizardUnpetrified = True
#. SetFlags:
#.   Dialog:
#.     - UND_PetrifiedDrow_HasMet_Drow_005(1) = True
#.   Global:
#.     - UND_PetrifiedDrow_Knows_WizardIsDhourn = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_005:ea9df7d7-72aa-41bb-b71c-cde08e9d9539
msgctxt "hcd0cffe3gc5dcg4772gb72bg716ee77b111d"
msgid "Dhourn's your man."
msgstr "도운에게 가서 말해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_005
#. Speaker = Petrified Drow
#. NodeID = f30c9d5f-9ff0-1192-e5db-6e1b9ba5ca3c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_005:f30c9d5f-9ff0-1192-e5db-6e1b9ba5ca3c
msgctxt "h2c493c62g6d68g43aeg9478g9bb9a0728729"
msgid "I appreciate your help. I'll be leaving... soon enough."
msgstr "당신의 도움에 감사드립니다. 저는... 곧 떠날 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_005
#. Speaker = Petrified Drow
#. NodeID = fdf8e52b-e768-7a4e-442a-278f9ae476cf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_PetrifiedDrow_State_WizardPermaDefeated = True
#.   Object:
#.      - UND_PetrifiedDrow_State_SomeOtherDrowPetrified(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_005:fdf8e52b-e768-7a4e-442a-278f9ae476cf
msgctxt "h50096f47g6b36g4dcfg94fbgfbb9645f9d45"
msgid "Others might be all right... now the spectator's dead."
msgstr "다른 사람들은 괜찮을 것 같아요... 이제 스펙테이터가 죽었으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_006
#. Speaker = Petrified Drow
#. NodeID = 01b5301c-09f8-8980-4389-8dc9b1cac70c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_006:01b5301c-09f8-8980-4389-8dc9b1cac70c
msgctxt "hbe18036dg37abg4bb6gb6cfg9f9036058a51"
msgid ""
"Thanks for your help. I'll be on my way soon enough. Just need to decide "
"where to."
msgstr "당신의 도움에 감사합니다. 저는 곧 제 갈길로 갈 것입니다. 그저 어디로 갈지만 결정할 필요가 있죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_006
#. Speaker = Petrified Drow
#. NodeID = 034dca0c-1146-d954-e880-a2f771b87eb5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_006:034dca0c-1146-d954-e880-a2f771b87eb5
msgctxt "h475fc469g94e0g469cga4edg722bad5f4dab"
msgid "What a saga. We were hired by the wizard - looking for some forge."
msgstr "정말이지, 대단한 일이었죠. 우리는 위저드에게 고용되어 대장간을 찾고 있었어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_006
#. Speaker = Petrified Drow
#. NodeID = 0967687d-e904-dc42-eb11-9fbe8b2e15c6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_PetrifiedDrow_State_WizardPermaDefeated = True
#.   Object:
#.      - UND_PetrifiedDrow_State_SomeOtherDrowPetrified(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_006:0967687d-e904-dc42-eb11-9fbe8b2e15c6
msgctxt "h653a2bdfgad70g44c2g9e2cg78442d93d3fb"
msgid ""
"Bloody wizard up and died on us, but my mates should be all right. "
"Petrification'll wear off now that the spectator's dead... I hope."
msgstr ""
"빌어먹을 위저드가 우리를 버리고 죽었습니다만, 내 동료들은 괜찮을 것입니다. 스펙테이터가 죽었으니, 이제 석화가 풀릴 것입니다... "
"아마도요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_006
#. Speaker = Petrified Drow
#. NodeID = 151a7467-b0e5-5f79-3ec3-726354a7367e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_PetrifiedDrow_State_SomeOtherDrowAlive(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_006:151a7467-b0e5-5f79-3ec3-726354a7367e
msgctxt "ha85384dcgc62ag4804g9e54g20f8afc84f95"
msgid ""
"Get our bearings. Make our way home. Hope we don't run into any more trouble."
msgstr "정신을 차리고. 고향으로 향해야죠. 또 곤란스러운 상황에 빠지지 않길 바랄 뿐입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_006
#. Speaker = Petrified Drow
#. NodeID = 16ee0db8-80e1-ed09-3635-2a771d672006
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_PetrifiedDrow_State_SomeOtherDrowPetrified(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_006:16ee0db8-80e1-ed09-3635-2a771d672006
msgctxt "h201e3a6cg2f8dg450fg93acgeb93d6c0a94b"
msgid ""
"Gotta get my mates free. We came in here together; we'll leave together."
msgstr "친구들을 풀어줘야죠. 우린 이곳에 함께 왔습니다. 떠날 때도 함께 가야죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_006
#. Speaker = Petrified Drow
#. NodeID = 23ed4b5e-a865-ca3e-a8f0-c57359b705d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_006:23ed4b5e-a865-ca3e-a8f0-c57359b705d9
msgctxt "ha2b43daag854ag4072ga8d5g1edcee0666ba"
msgid ""
"Ran into some old buddy of his - Xargrim. Fight broke out, we had his back "
"to a wall, but he summoned a - an enhanced spectator. Never seen anything "
"like it."
msgstr ""
"그의 오랜 친구인 자그림을 만났어요. 싸움이 벌어졌고, 우리가 그를 몰아붙였지만, 놈이 강화된 스펙테이터를 소환했어요. 그런 건 생전 "
"처음 봤죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_006
#. Speaker = Petrified Drow
#. NodeID = 354b7523-662a-4e89-b71d-379cc23dc9b5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_PetrifiedDrow_HasMet_Drow_006(1) = False
#.   Global:
#.      - UND_PetrifiedDrow_State_WizardPetrified = True
#. SetFlags:
#.   Dialog:
#.     - UND_PetrifiedDrow_HasMet_Drow_006(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_006:354b7523-662a-4e89-b71d-379cc23dc9b5
msgctxt "h5697b308g9c2eg40cdga6a7g959f42325f2c"
msgid ""
"Reckon the wizard'll be all right soon enough, now that creature's dead."
msgstr "곧 저 위저드도 괜찮아질 겁니다. 이제 저 생물체도 죽었으니 말이죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_006
#. Speaker = Petrified Drow
#. NodeID = 372bcd7e-b689-5568-0402-fc0e4ccaff84
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_006:372bcd7e-b689-5568-0402-fc0e4ccaff84
msgctxt "had6d5631g0ba3g4907g8356g3c20b7b3a228"
msgid ""
"Well, that turned the tables. He ran off. Left us to deal with the bloody "
"thing. I guess it's obvious what happened after that."
msgstr ""
"뭐, 그게 전황을 바꿔놓았죠. 그는 도망갔습니다. 우리만 남아서 그 빌어먹을 괴물을 상대해야 했어요. 그 뒤로 무슨 일이 일어났는지는 "
"뻔하겠죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_006
#. Speaker = Petrified Drow
#. NodeID = 43aa23aa-0c84-6a5a-dc37-8d9d38e4dffd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_PetrifiedDrow_Knows_WizardIsDhourn = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_006:43aa23aa-0c84-6a5a-dc37-8d9d38e4dffd
msgctxt "h2ced668egfbd1g4c84gb5a1g3db664d908a1"
msgid "By Lolth... of course. Dhourn - damn."
msgstr "롤스시여... 물론입니다. 도운 - 젠장."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_006
#. Speaker = Player
#. NodeID = 55c40a15-24bd-3e89-06fe-960a2e2972b4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - UND_PetrifiedDrow_State_AskedPlans(1) = False
#. SetFlags:
#.   User:
#.     - UND_PetrifiedDrow_State_AskedPlans(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_006:55c40a15-24bd-3e89-06fe-960a2e2972b4
msgctxt "h6523344egd824g4035gb243gc34b5a9dcbc1"
msgid "What's next for you?"
msgstr "이제 어떻게 할 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_006
#. Speaker = Petrified Drow
#. NodeID = 6291253f-eacc-72e8-3c6c-cc34d4cbeb24
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_PetrifiedDrow_HasMet_Drow_006(1) = False
#.   Global:
#.      - UND_PetrifiedDrow_State_WizardPermaDefeated = True
#. SetFlags:
#.   Dialog:
#.     - UND_PetrifiedDrow_HasMet_Drow_006(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_006:6291253f-eacc-72e8-3c6c-cc34d4cbeb24
msgctxt "h30e5976eg4de6g477dgb263gbfc10dc4bdbe"
msgid "What... what <i>happened?</i>"
msgstr "무슨... 어떻게 <i>된 거죠?</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_006
#. Speaker = Petrified Drow
#. NodeID = 7ce11e24-0327-1fb8-d30c-e4d1362b9555
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_006:7ce11e24-0327-1fb8-d30c-e4d1362b9555
msgctxt "h140b9969gd212g42fcgbcfbge81920e112c0"
msgid "Rest up. Go home. If I still <i>have </i>a home."
msgstr "잠깐 쉬고. 고향으로 가야죠. 그곳이 <i>남아 있긴</i> 하다면 말입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_006
#. Speaker = Player
#. NodeID = 92bc2f2f-afb0-077c-7f66-938fabeab5f6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 651c63c5-0141-08d3-c5cd-f7c765d7dafa_Xagrism = True
#.   User:
#.      - UND_PetrifiedDrow_State_AskedWizardFriend(1) = False
#. SetFlags:
#.   User:
#.     - UND_PetrifiedDrow_State_AskedWizardFriend(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_006:92bc2f2f-afb0-077c-7f66-938fabeab5f6
msgctxt "h87416e38g01a4g4251g81c9gcefb31c80d4c"
msgid "Do you know anything else about Xargrim?"
msgstr "자그림에 대해 뭔가 더 알고 있는 건 없나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_006
#. Speaker = Player
#. NodeID = b60869f0-ac81-d228-bda6-c42a92ac0351
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_006:b60869f0-ac81-d228-bda6-c42a92ac0351
msgctxt "h8b1f684dg2bc3g4a85g97a2g3013b0319842"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_006
#. Speaker = Petrified Drow
#. NodeID = bba28bca-fb2d-0d4a-3493-8e3547c5a96e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_PetrifiedDrow_State_WizardPermaDefeated = True
#.   Object:
#.      - UND_PetrifiedDrow_State_SomeOtherDrowAlive(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_006:bba28bca-fb2d-0d4a-3493-8e3547c5a96e
msgctxt "hf1c8e156g44cag4157g8757g7a6898c904f9"
msgid ""
"Thanks for your help. I... appreciate it. Truly. We'll be out of here in a "
"little - soon as we get our bearings."
msgstr "도와줘서 고맙습니다. 정말... 감사합니다. 진심으로요. 잠시 정신을 차린 뒤에, 여길 빠져나가야겠습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_006
#. Speaker = Petrified Drow
#. NodeID = c3da0dc7-39e6-4e4a-8eb4-8b940c015bdb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_PetrifiedDrow_HasMet_Drow_006(1) = True
#.   Global:
#.      - UND_PetrifiedDrow_State_WizardUnpetrified = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_006:c3da0dc7-39e6-4e4a-8eb4-8b940c015bdb
msgctxt "h366d59fag14c0g49dag908bg8f7dee9d81a6"
msgid "Dhourn's your man for a chat. I need to think."
msgstr "도운에게 가서 말씀하세요. 전 생각을 좀 해야겠습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_006
#. Speaker = Player
#. NodeID = cee48f23-b715-3377-860a-f0576f7dd053
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - UND_PetrifiedDrow_State_AskedWhatHappened(1) = False
#. SetFlags:
#.   Local:
#.     - 651c63c5-0141-08d3-c5cd-f7c765d7dafa_Xagrism = True
#.   User:
#.     - UND_PetrifiedDrow_State_AskedWhatHappened(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_006:cee48f23-b715-3377-860a-f0576f7dd053
msgctxt "h13e3ebaeg22d6g4be2ga909g8b082f5649d5"
msgid "What happened here?"
msgstr "여기서 무슨 일이 있었던 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_006
#. Speaker = Petrified Drow
#. NodeID = cfaf6fad-385e-41fe-bfee-e72b9066ec41
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_PetrifiedDrow_HasMet_Drow_006(1) = True
#.   Global:
#.      - UND_PetrifiedDrow_State_WizardPetrified = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_006:cfaf6fad-385e-41fe-bfee-e72b9066ec41
msgctxt "h1dd2948cgc149g4143g81d9gcafcd8171991"
msgid "Will head on out as soon as Dhourn's back in action."
msgstr "도운이 정신을 차리면 여기서 빠져나갈 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_006
#. Speaker = Petrified Drow
#. NodeID = ec059d93-4b91-9b44-6e3f-9f2199993ab3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_MyconidDrowDead_Knows_DhournSearchingForge = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_006:ec059d93-4b91-9b44-6e3f-9f2199993ab3
msgctxt "h39e8b6bcgfa05g483dg80dbg143ead9cd4ad"
msgid ""
"He's after the forge. Whatever's in there must be worth a lot of trouble."
msgstr "그는 대장간을 찾고 있어요. 거기 뭐가 있는진 모르겠지만 이 난장판을 치를 가치가 있을 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_006
#. Speaker = Petrified Drow
#. NodeID = fb6df4f6-ac6c-4c0d-99bf-d2ff767b8c6d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_PetrifiedDrow_HasMet_Drow_006(1) = False
#.   Global:
#.      - UND_PetrifiedDrow_Knows_WizardIsDhourn = True
#.      - UND_PetrifiedDrow_State_WizardUnpetrified = True
#. SetFlags:
#.   Dialog:
#.     - UND_PetrifiedDrow_HasMet_Drow_006(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_006:fb6df4f6-ac6c-4c0d-99bf-d2ff767b8c6d
msgctxt "hf9d1feeegc1adg4869gbdb7g3b9f6d4b03f5"
msgid ""
"Go on and sidle up to the wizard. He'll talk your ear off if you let him."
msgstr "가서 위저드와 말씀하세요. 내버려 두면 귀에 딱지가 생길 때까지 떠들 테니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_Dead_Wizard
#. Speaker = Player
#. NodeID = 021b6cef-1378-4f3c-b19a-9c879a6324d5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
