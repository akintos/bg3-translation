#. CheckFlags:
#.   Global:
#.      - DEN_GruntingKid_State_HatchOpened = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_GruntingKid:bbd45492-66fb-5cec-ebf7-a8a9fccfd2ff
msgctxt "hdcf5090dg408cg466bgb7bbgab403dc8b6bf"
msgid "<i>Turn around to see what has his attention.</i>"
msgstr "<i>그의 관심을 사로잡은 것을 향해 고개를 돌린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_GruntingKid
#. Speaker = Player
#. NodeID = c08a1fdf-48e5-2753-82aa-f0dfb2804080
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GruntingKid_State_HatchOpened = False
#.      - DEN_HarpyMeal_Knows_HideoutPassword = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_GruntingKid:c08a1fdf-48e5-2753-82aa-f0dfb2804080
msgctxt "h98789c4agd1b8g4d94g98cfg76a55213c094"
msgid "Doni, isn't it? I want to see the Dragon's Lair."
msgstr "도니, 맞지? 드래곤의 동굴을 보고 싶어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_GruntingKid
