#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD_WithBird:8f1ebd9c-d417-548f-a615-ee890dc9e381
msgctxt "hdfc7ba8cgfef0g4e0cga3ddg3a217573c731"
msgid "It's messy, but we'll fix you up."
msgstr "좀 엉망이지만, 말끔히 나을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD_WithBird
#. Speaker = Nettie
#. NodeID = 94bbe155-3df6-5b42-a3fb-e553644cc9e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD_WithBird:94bbe155-3df6-5b42-a3fb-e553644cc9e2
msgctxt "hd9183066gb45bg4658ga4e8g4fe492113b79"
msgid "Does that hurt?"
msgstr "아프니?"

