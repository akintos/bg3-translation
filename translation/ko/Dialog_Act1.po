msgctxt "h057af24cge1c2g4ce1ga65cg9c9da29a6439"
msgid "Goblins. I can smell trouble ahead."
msgstr "고블린이야. 앞쪽에 문제가 있는 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_PAD_SpottedAmbush
#. Speaker = Player
#. NodeID = c29822c6-aeb2-fee4-59ee-6eb89b6f0468
