msgctxt "he527a681g2863g4b7aga004g133cd8690d0c"
msgid "Adamantine... enhancement... from mithral..."
msgstr "아다만틴... 강화된... 미스랄..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001_Dead
#. Speaker = Player
#. NodeID = e5c065ec-d939-1ed9-cf9e-854b7108cf47
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_FearfulRotheGuard001_Event_MentionedForge(1) = True
#.   Global:
#.      - UND_TheDrowNere_Event_HadMindMeld = True
#.      - UND_DuergarCamp_State_CaveInCleared = False
