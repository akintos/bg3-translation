#.     - FOR_SeluneStash_NoticeStashSeal_CommentedOnSeal(0) = True
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_NoticeStashSeal:78906681-bbcc-2880-1d5d-052ca046af30
msgctxt "ha9f8aa04g03efg491agb4b2g1cf303118927"
msgid "A wizard sealed this chest. Wasn't an amateur either."
msgstr "위저드가 상자를 봉인해뒀어. 초짜의 실력이 아닌데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_NoticeStashSeal
