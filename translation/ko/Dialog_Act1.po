msgctxt "h6ded3cbcg3580g48d9gb98ag337a8f998439"
msgid "We are Clan Lur. Xanta is not."
msgstr "우리는 루르 일족이야. 잔타는 아니고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_Spider03
