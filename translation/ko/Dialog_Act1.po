#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_002:cb2ee75e-541c-4d06-82dc-568ac0bd9990
msgctxt "hbb01d540gef09g493bgb9b6g41956aa81fb1"
msgid "Don't want to move rocks. Bad smells. Death smells."
msgstr "바위 옮기기 싫어. 냄새 나빠. 죽음의 냄새."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_002
#. Speaker = Player
