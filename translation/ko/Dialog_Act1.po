#.     - DEN_GruntingKid_Event_TryUnderstandAgain(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_GruntingKid:ebf59d38-01de-616c-a07b-1689f1dc5fd5
msgctxt "h7677c748gf79ag489eg82dag4cc242214267"
msgid "*Grunt.*"
msgstr "*끙.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_GruntingKid
#. Speaker = Narrator
#. NodeID = f23bdccc-c1a4-a728-9f7b-d880edc792e0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_GruntingKid:f23bdccc-c1a4-a728-9f7b-d880edc792e0
msgctxt "h4157d157g7a9eg4cbfg8796gbf84bd0b130f"
msgid "*As you turn back, the child slips between the rocks.*"
msgstr "*당신이 돌아서자, 아이는 바위 사이로 들어갑니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_GruntingKid
#. Speaker = Narrator
#. NodeID = f749811e-d273-9778-524e-9a7a4f5e924c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_GruntingKid:f749811e-d273-9778-524e-9a7a4f5e924c
msgctxt "h03c85187g7f21g43a2gac03g06554642dffc"
msgid ""
"*His eyes flicker to yours for an instant, then away, as if it hurts to look "
"at you.*"
msgstr "*당신을 보는 것이 고통스러운 듯 잠시 눈을 깜빡이더니 다시 시선을 돌립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_GruntingKid
#. Speaker = Doni
#. NodeID = f87e7011-d1a6-c2e9-da4c-783a9c031d40
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_GruntingKid:f87e7011-d1a6-c2e9-da4c-783a9c031d40
msgctxt "h1310113cgd1f8g460cg9280g14d160830526"
msgid ""
"<i>Got to keep watch... but it's so bright and noisy here. Want to be back "
"in the hideout.</i>"
msgstr "<i>계속 감시해야 해... 하지만 여긴 너무 밝고 시끄러워. 은신처로 돌아가고 싶어.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_GruntingKid_Hideout
#. Speaker = Doni
#. NodeID = a533b0e9-41df-4bf0-8fa4-67ef025d910d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_GruntingKid_Hideout:a533b0e9-41df-4bf0-8fa4-67ef025d910d
msgctxt "h2d85ec11ge811g402dg9f78gc44442920f9b"
msgid "*Grunt.*"
msgstr "*끙.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1
#. Speaker = Player
#. NodeID = 00a2c908-e996-d2f3-f1bc-1b58cc2a7936
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1:00a2c908-e996-d2f3-f1bc-1b58cc2a7936
msgctxt "h163a7944g86d3g4daegab16g14a1072d5447"
msgid "You complain a lot."
msgstr "불만이 많군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1
#. Speaker = Bored Ox
#. NodeID = 05522844-63dd-bc03-0107-4ecb1be39830
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1:05522844-63dd-bc03-0107-4ecb1be39830
msgctxt "h26d26f61gc0e9g429fg9598g4ebff6051cc6"
msgid "To live like you, I could learn to be ugly."
msgstr "너희처럼 살려면, 추하게 사는 법을 배워야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1
#. Speaker = Bored Ox
#. NodeID = 0651932f-882c-d2dd-827b-0a2012811d00
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1:0651932f-882c-d2dd-827b-0a2012811d00
msgctxt "h200110acg7fefg4b00g82b6g257a48a73107"
msgid ""
"Hmph. When the horned ones leave this place, I will lie in the back, and "
"<i>you</i> will pull. Noble one."
msgstr "끄응. 그럼 뿔 달린 종자들이 여기 떠날 때, 나는 수레에 누워 있을 테니 <i>네</i>가 대신 옮겨 봐. 고귀한 것아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1
#. Speaker = Bored Ox
#. NodeID = 077870ab-5d85-8425-1cb0-1c2582bb91ca
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_General_HasMet_Mule1(1) = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1:077870ab-5d85-8425-1cb0-1c2582bb91ca
msgctxt "hae5d36e3gca4fg41c2g9f43gd303376a32eb"
msgid ""
"I have no more to say. Even old hay tastes better than your idle chatter."
msgstr "더 나눌 말 없어. 너랑 쓸데없이 떠드느니 묵은 건초 씹는 게 차라리 나아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1
#. Speaker = Bored Ox
#. NodeID = 09129bcf-b3e9-c645-bc68-3b96f336ead6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1:09129bcf-b3e9-c645-bc68-3b96f336ead6
msgctxt "h16d17fe7gca72g4250gb466g2b11396ea808"
msgid ""
"They become birds, to hunt on the wing. Bears, to tear flesh with teeth. But "
"for me - only oxen. Only same old hay."
msgstr ""
"그들은 새로 변해 그 날개로 사냥에 나서. 곰으로 변해선 이빨로 살점을 찢지. 근데 난 늘 황소일 뿐이야. 맨날 묵은 건초만 씹는."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1
#. Speaker = Player
#. NodeID = 21890895-6746-e17f-36e0-1bd429689351
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1:21890895-6746-e17f-36e0-1bd429689351
msgctxt "h26500b4eg8e8cg4accgb7e6g71ac4a0a1024"
msgid "You'll never be like me."
msgstr "네가 나같이 될 일은 절대 없을걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1
#. Speaker = Bored Ox
#. NodeID = 2530d3f8-3ed5-0e80-ce2f-bd6c781702d0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_General_HasMet_Mule1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1:2530d3f8-3ed5-0e80-ce2f-bd6c781702d0
msgctxt "h322eee9eg6cb4g4e64g87bfg832a7b8ba4c3"
msgid "Another one. What are you under there, then? Ant? Aurochs?"
msgstr "또 하나 왔네. 네 속엔 뭔 동물이 있냐? 개미? 들소?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1
#. Speaker = Bored Ox
#. NodeID = 413afb21-e752-525c-dcf5-b6c1e005c2dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1:413afb21-e752-525c-dcf5-b6c1e005c2dc
msgctxt "h1ded206ege5dfg436fg8a5cgf83434ddaf84"
msgid ""
"It is not the form - it is the <i>freedom</i>. Your kind walk free, and "
"other beasts carry your burdens."
msgstr "관건은 형태가 아니야. <i>자유</i>가 관건이지. 너희 것들은 자유로이 다니면서, 짐은 딴 짐승들에게 떠맡기잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1
#. Speaker = Bored Ox
#. NodeID = 41ad99ed-c102-f1c2-ef96-81dfd37af773
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1:41ad99ed-c102-f1c2-ef96-81dfd37af773
msgctxt "h2ccd29a4g55aag4dc0gb8d2g09a949d16eec"
msgid "No - I will be <i>better</i>. I have studied the keepers here."
msgstr "아니, 너보다 <i>더</i> 잘 될 거야. 난 여기 수호자들 하는 걸 봐왔다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1
#. Speaker = Bored Ox
#. NodeID = 475bc3c3-733a-59e9-e9b1-1d1492675ede
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1:475bc3c3-733a-59e9-e9b1-1d1492675ede
msgctxt "h801a68bage5c1g42acgbb4cg43fe10d82d80"
msgid "Your kind give us your burdens. But who will carry ours?"
msgstr "너희 것들은 우리한테 짐을 떠맡기지. 근데 우리 짐은 누가 짊어주든?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1
#. Speaker = Player
#. NodeID = 4a0694a6-1db4-2510-d0e4-dd92a892cff4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1:4a0694a6-1db4-2510-d0e4-dd92a892cff4
msgctxt "hfb721a72g8603g465cg87e2gfbdaba01b404"
msgid "Cheer up - you do a noble thing, carrying burdens for those who can't."
msgstr "힘내. 넌 고귀한 일을 하고 있다고. 사람들의 무거운 짐을 옮겨 주잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1
#. Speaker = Player
#. NodeID = 4a324f95-38c9-7cb6-8cca-0f9c1793b253
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1:4a324f95-38c9-7cb6-8cca-0f9c1793b253
msgctxt "hf7dcdba6g5506g46c8gb86agcfe89389848f"
msgid "Ant? Are you calling me small?"
msgstr "개미? 나보고 작다고 놀리는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1
#. Speaker = Player
#. NodeID = 4d76730e-372d-8b52-cfe4-8c91705a76fe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = True
#. SetFlags:
#.   Global:
#.     - GLO_DEN_General_Mule1_AskedAboutTwoLegs = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1:4d76730e-372d-8b52-cfe4-8c91705a76fe
msgctxt "h4ed3137bg9bd2g43e9g9634g55600a0160e6"
msgid "Maybe you could learn to change as we druids do."
msgstr "너도 우리 드루이드처럼 변신을 배워보면 어떨까 싶은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1
#. Speaker = Player
#. NodeID = 4d7f0ab7-f3ec-6ad6-00ba-50f5410e82a2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1:4d7f0ab7-f3ec-6ad6-00ba-50f5410e82a2
msgctxt "h89ee4d4agff7ag4418g8876g1fc4354e4c6f"
msgid "Meditation - a lot of it."
msgstr "명상을 해. 아주 많이."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1
#. Speaker = Bored Ox
#. NodeID = 4deee34a-042c-5504-e55f-5c27fde83747
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_General_Knows_HayChest = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1:4deee34a-042c-5504-e55f-5c27fde83747
msgctxt "h06a102f1g2fd6g4156gbf8ag0fcf01f11aab"
msgid ""
"Sometimes I eat the shiny bits, and they have to go looking for them on the "
"<i>other</i> end."
msgstr "가끔 내가 반짝이를 먹어버리면, 내가 <i>싼</i> 자리를 하릴없이 뒤적거려야 하거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1
#. Speaker = Player
#. NodeID = 5e1b6ce0-1ddf-0a14-90c6-9ac6f554a125
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1:5e1b6ce0-1ddf-0a14-90c6-9ac6f554a125
msgctxt "h87812823ga470g470bgb698ge94059e5e380"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1
#. Speaker = Bored Ox
#. NodeID = 705a0e44-7095-bc6e-ffe4-88b7ce72ce45
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1:705a0e44-7095-bc6e-ffe4-88b7ce72ce45
msgctxt "h16dd4b04g9fb3g44a3gb597g922372e0911f"
msgid "The keepers of this place. They change their form to fit their need."
msgstr "이 장소의 수호자들 말인데, 그네들은 필요에 따라 자기 형상을 바꿔."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1
#. Speaker = Bored Ox
#. NodeID = 825894a1-86ba-5368-d3bf-f78abb33a5d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1:825894a1-86ba-5368-d3bf-f78abb33a5d0
msgctxt "h5a8f8243gb8deg4bf8gbe4dg3fa4c6f1bfe3"
msgid ""
"Perhaps <i>we</i> are the true keepers. I will learn to walk on two legs, "
"friend. Then perhaps <i>I</i> will teach <i>them.</i>"
msgstr ""
"어쩌면 <i>우리</i>가 진짜 수호자일지도. 꼭 두 다리로 걷는 법을 터득하겠어, 친구. 그러면 거꾸로 <i>내가</i> 한 수 "
"가르치는 거지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1
#. Speaker = Bored Ox
#. NodeID = 86c59abc-5303-37d4-e642-ac2a3cbd23e3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1:86c59abc-5303-37d4-e642-ac2a3cbd23e3
msgctxt "hc2294ca4g312bg4b53g8c4cg9d4b9dc8b485"
msgid ""
"One day, I will stride as you do. And perhaps <i>you </i>will carry <i>my "
"</i>burdens."
msgstr "언젠가는 너처럼 버젓이 걷게 될 거야. 그러면 <i>네</i>가 <i>내</i>짐을 지게 될지도 모르지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1
#. Speaker = Player
#. NodeID = 8b3cf888-1eff-477c-6f9e-baaa9e1d6e37
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1:8b3cf888-1eff-477c-6f9e-baaa9e1d6e37
msgctxt "h3e8982f2gd930g48d2g939cgcc827e209c33"
msgid "Surely you could pick a better form than mine."
msgstr "나보다 더 나은 형태는 얼마든지 있을 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1
#. Speaker = Bored Ox
#. NodeID = 8de40695-3faa-73f6-cebb-64ee10f24df3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1:8de40695-3faa-73f6-cebb-64ee10f24df3
msgctxt "h2b734cb3g4c9fg48bcga65cg8e4dfd970601"
msgid "*Low!*"
msgstr "*음머!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1
#. Speaker = Bored Ox
#. NodeID = 97107050-5235-b55c-89b2-8be1bc03b935
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1:97107050-5235-b55c-89b2-8be1bc03b935
msgctxt "hd8b99ea4g82cdg4691g943bgbdc75a403cc5"
msgid ""
"You mean when the keepers stand and sleep, all at once? My kind learned to "
"do this long ago."
msgstr "수호자들이 선 상태로 잠자는 그거 말이야? 우리 종족은 진작에 그러는 법을 익혔는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1
#. Speaker = Player
#. NodeID = 9cd02bff-d38c-27f4-0cd5-373303e1bcc6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1:9cd02bff-d38c-27f4-0cd5-373303e1bcc6
msgctxt "h561ab144ge7deg44aeg9c89gb7af34583518"
msgid "'Shiny bits'? The tieflings put something in your hay?"
msgstr "'반짝이'라고? 티플링이 네 건초에다 뭔가 넣어 놓는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1
#. Speaker = Player
#. NodeID = a443f199-851d-f98f-96c1-840398cd908b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1:a443f199-851d-f98f-96c1-840398cd908b
msgctxt "h8392e864g7185g45a7g9c6ag20baa6b70d75"
msgid "What are you talking about?"
msgstr "뭔 소리를 하는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1
#. Speaker = Player
#. NodeID = b02e3830-9970-2d75-5605-a0fd87f2112c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1:b02e3830-9970-2d75-5605-a0fd87f2112c
msgctxt "ha3133296g877fg4d6bg80bdg89efb516e853"
msgid "Aurochs describes me well, yes."
msgstr "굳이 따지자면 들소가 어울리겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1
#. Speaker = Bored Ox
#. NodeID = bed9ad8d-03d0-2eeb-d491-b157644ff4f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1:bed9ad8d-03d0-2eeb-d491-b157644ff4f3
msgctxt "h3fc18ad0gf3f5g4460g9f83g4352c87a5673"
msgid "Yes. <i>Yes</i>. I would change into a two-legs like you. But how?"
msgstr "그래. <i>그렇지</i>. 너 같은 두 다리 것들로 변하면 좋겠어. 근데 어떻게?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1
#. Speaker = Bored Ox
#. NodeID = c5277cdf-ad31-1149-e1c5-46594e2d20db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1:c5277cdf-ad31-1149-e1c5-46594e2d20db
msgctxt "h39215f3dg1957g4d85gbb26g4c2e57d7146d"
msgid ""
"And I cannot even eat it, because the horned ones hide their shiny bits "
"inside."
msgstr "그 건초조차 잘 먹지도 못해. 뿔 달린 종자들이 저 안에 반짝이를 숨겨놓거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1
#. Speaker = Bored Ox
#. NodeID = c6322335-ddae-858d-fbb1-ba5c50d0a340
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1:c6322335-ddae-858d-fbb1-ba5c50d0a340
msgctxt "h4a97be65g3e22g44d1gbb71g1b32d8fedb70"
msgid "Hiding things, thinking they are clever. Not clever."
msgstr "이것저것 숨겨. 지들이 똑똑한 줄 알지. 헛똑똑이들."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1
#. Speaker = Bored Ox
#. NodeID = c7569f33-d277-7bd0-cb44-2ee85eb796b9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1:c7569f33-d277-7bd0-cb44-2ee85eb796b9
msgctxt "ha8683a7fg88d9g4a50g8aa8g7c998dc27198"
msgid ""
"Big, and slow? The keepers of this place choose different forms. Better ones."
msgstr "크고 굼뜬 놈들? 여기 수호자들은 다른 형태를 골라잡던데. 더 나은 것들로."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1
#. Speaker = Player
#. NodeID = c8c29072-57c3-9008-a46c-de9277b2d478
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1:c8c29072-57c3-9008-a46c-de9277b2d478
msgctxt "h0dceb4aeg5653g42c5g9f8dg7052721a3ed2"
msgid "Maybe I'm an ox too."
msgstr "너 같은 황소일지도 모르지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1
#. Speaker = Bored Ox
#. NodeID = cb42923e-e5ae-4d8c-4d9a-44262e98d9bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1:cb42923e-e5ae-4d8c-4d9a-44262e98d9bf
msgctxt "h38a384abg4826g4a3ag827eg9a1f16ed6c2f"
msgid ""
"If you do not like your form, then choose another. That is what the keepers "
"of this place do."
msgstr "네 모습이 마음에 안 들면 딴 모습으로 변하라고. 여기 수호자들은 그렇게 하던걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1
#. Speaker = Bored Ox
#. NodeID = cdd87e33-46b6-6cbc-36c6-0a509071e8cb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_General_HasMet_Mule1(1) = True
#.   Tag:
#.      - DRUID(1) = True
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1:cdd87e33-46b6-6cbc-36c6-0a509071e8cb
msgctxt "h61ad8d35g5605g4815gb5b5gdc629fcdfb29"
msgid "<i>Hmmm - </i>away. I dream of two-legs. <i>Hmmmmmmmm.</i>"
msgstr "<i>끄응.</i> 저리 가. 두 다리 된 꿈 꾸고 있었는데. <i>끄으으으응.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1
#. Speaker = Bored Ox
#. NodeID = d3ff3767-eef2-b2b1-7188-2b96d20756a2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule1:d3ff3767-eef2-b2b1-7188-2b96d20756a2
msgctxt "h62751371g77f0g483eg97ffga0e937884d25"
msgid ""
"You have the smell - but I do not think so. You are not like the keepers "
"here."
msgstr "냄새는 나는데, 그래도 아니다 싶은걸. 넌 여기 수호자들이랑은 달라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule2
#. Speaker = Hungry Ox
#. NodeID = 142918f4-a9c1-b7a3-37e3-351f5f63e921
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_General_Mule2_HasMet(1) = False
#.   Tag:
#.      - PETPAL(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_General_Mule2_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule2:142918f4-a9c1-b7a3-37e3-351f5f63e921
msgctxt "hcff6172cgfa5cg43cdgbf42g46343957f72d"
msgid "Be gone. I am hungry."
msgstr "저리 가. 나 배고프다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule2
#. Speaker = Hungry Ox
#. NodeID = 61cfb5bc-2e62-debb-7051-e561de216905
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule2:61cfb5bc-2e62-debb-7051-e561de216905
msgctxt "h6d81ef48g94efg4415g9f67g10c200b135e8"
msgid "*Bellow.*"
msgstr "*음머.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule2
#. Speaker = Hungry Ox
#. NodeID = eed63647-0354-1696-e495-669d5e2320c6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_General_Mule2_HasMet(1) = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Mule2:eed63647-0354-1696-e495-669d5e2320c6
msgctxt "h72cf0e98g5f04g4cf1g9dd4g252bbcf9286e"
msgid "Mmhm. Grass."
msgstr "으으음. 풀맛이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_PAD_BearStatue
#. Speaker = Narrator
#. NodeID = b80588d4-9749-54c8-acbd-a193f4b4d324
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_PAD_BearStatue:b80588d4-9749-54c8-acbd-a193f4b4d324
msgctxt "h6d9745edg434eg4087g8b91g6b49eecfd0ee"
msgid "*By Silvanus, the Forest Father, we are granted balance.*"
msgstr "*나무 아버지 실바누스에 의해 우리는 균형을 이루게 되었다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_PAD_ElevatorUnusable
#. Speaker = Player
#. NodeID = 803d0336-1768-03ab-1c25-ef83f391429a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_PAD_ElevatorUnusable:803d0336-1768-03ab-1c25-ef83f391429a
msgctxt "h51130876g83e2g404dg8856gb5c2ed0875f4"
msgid "Won't budge."
msgstr "꿈쩍도 않는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_PAD_ElkStatue
#. Speaker = Narrator
#. NodeID = 5721e56a-ce31-410f-ca5e-d2aca7ea9157
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_PAD_ElkStatue:5721e56a-ce31-410f-ca5e-d2aca7ea9157
msgctxt "hf8765179g4ef9g44eeg86eegf0c4fb56510f"
msgid "*By Silvanus, the Old Oak, all death begets life.*"
msgstr "*고대의 참나무 실바누스에 의해 모든 죽음은 생명을 부른다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_PAD_EntranceStatue
#. Speaker = Narrator
#. NodeID = 0ad1ae9f-aff0-675c-928f-6f31a63f5135
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_PAD_EntranceStatue:0ad1ae9f-aff0-675c-928f-6f31a63f5135
msgctxt "he49ca159g9a23g4863gb882g02b9be20fbe2"
msgid "*This grove is kept by Silvanus' faithful.*"
msgstr "*이 숲은 실바누스의 신도들이 지키고 있노라.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_PAD_ShadowheartBook
#. Speaker = Shadowheart
#. NodeID = 3d53a741-387a-a014-bbc1-3cbdeb65a4da
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_PartyProgress_EnteredSharTemple = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_PAD_ShadowheartBook:3d53a741-387a-a014-bbc1-3cbdeb65a4da
msgctxt "h6f34def1g09c1g44dbg8571g1eedebad0c77"
msgid "A temple of Shar? Where? And what's this about a curse?"
msgstr "샤의 사원이라고? 어디지? 그리고 이 저주라는 건 뭐야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_PAD_ShadowheartBook
#. Speaker = Shadowheart
#. NodeID = 745dde96-d625-ae27-a40b-c2c5adaa1e81
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - SHA_PartyProgress_EnteredSharTemple = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_PAD_ShadowheartBook:745dde96-d625-ae27-a40b-c2c5adaa1e81
msgctxt "ha761f04bgd328g47bcg9662g4cb2f045e65a"
msgid "The Shar temple is one thing, but what's this about a shadow curse?"
msgstr "샤의 사원은 그렇다 치더라도, 그림자 저주라는 게 뭐야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_PAD_WolfStatue
#. Speaker = Narrator
#. NodeID = 192ab703-8902-34d4-dee3-dc136ddb4bc0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_PAD_WolfStatue:192ab703-8902-34d4-dee3-dc136ddb4bc0
msgctxt "h05211e79g6167g418dgb6e0g833e81c997cb"
msgid "*By Silvanus, the Treefather, our turmoil is calmed.*"
msgstr "*나무 아버지 실바누스에 의해 혼란이 진정되었노라.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat
#. Speaker = Player
#. NodeID = 000dbbfc-aff3-59f9-6912-18e448439477
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat:000dbbfc-aff3-59f9-6912-18e448439477
msgctxt "hbca56348g0729g4a61gb79cg85d778b524a4"
msgid "What's wrong?"
msgstr "뭐가 문제야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat
#. Speaker = Rat
#. NodeID = 000ece9d-8720-5adb-b0d1-f3839ce0bff1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Rat_Event_MoveToShack = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat:000ece9d-8720-5adb-b0d1-f3839ce0bff1
msgctxt "h91a5aadfg5f44g40d7g98d0gd45dd04385ca"
msgid "In the box. Follow me, I'll show you!"
msgstr "상자 안에. 따라와 봐, 보여줄게!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat
#. Speaker = Player
#. NodeID = 042f5ed1-e943-836f-57f5-97725046f744
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat:042f5ed1-e943-836f-57f5-97725046f744
msgctxt "h05607c9dg177cg4283g827dg54ef43660a27"
msgid "Were you trying to eat it?"
msgstr "먹으려고 했던 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat
#. Speaker = Rat
#. NodeID = 0d05643d-8f5e-ba9c-5b40-0551c5d02031
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_CampGeneral_Rat_PCPissedHimOff(1) = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat:0d05643d-8f5e-ba9c-5b40-0551c5d02031
msgctxt "h28a6783cg4941g4c97g985bg2d0eca38474b"
msgid "Leave me alone!"
msgstr "날 내버려 둬!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat
#. Speaker = Player
#. NodeID = 17140042-3965-6d70-07a4-c1f17084b710
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat:17140042-3965-6d70-07a4-c1f17084b710
msgctxt "hdf88e2d7g71eag45dag9ee8gf5b33b3baf8f"
msgid "Or else <i>what</i>?"
msgstr "<i>안 그러면?</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat
#. Speaker = Narrator
#. NodeID = 18ff630c-241a-77a4-9a76-8b463428d202
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_CampGeneral_Rat_PCPissedHimOff(1) = True
#.   Local:
#.      - 40734a27-a1e9-b806-9105-3720f53e6d2b_AnimalHandlingSuccess = True
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat:18ff630c-241a-77a4-9a76-8b463428d202
msgctxt "hc2fb4106gf723g4e09ga351gfb6acdec1d78"
msgid "*The rat hisses at you, his eyes flashing distrustfully.*"
msgstr "*쥐가 당신을 향해 쉿 소리를 내며, 불신에 찬 눈빛을 깜빡입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat
#. Speaker = Player
#. NodeID = 1b978f26-f08b-a570-ca05-2c9060680609
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat:1b978f26-f08b-a570-ca05-2c9060680609
msgctxt "h506e9e48ga24bg4511g93b0gc67b3608dbd2"
msgid "That's what gluttony will get you."
msgstr "탐욕이 과하면 그렇게 되는 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat
#. Speaker = Rat
#. NodeID = 26ebf4c3-e2e9-e891-4fd4-d18ee1b301ae
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Rat_Event_RemovedKey = True
#.      - DEN_Rat_Event_MoveToShack = True
#.   Local:
#.      - 40734a27-a1e9-b806-9105-3720f53e6d2b_AnimalHandlingSuccess = False
#.   Tag:
#.      - PETPAL(1) = False
#. SetFlags:
#.   Global:
#.     - DEN_Rat_Event_EnteredPotatoCrate = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat:26ebf4c3-e2e9-e891-4fd4-d18ee1b301ae
msgctxt "h156ed642g29cfg483bga2e0g6ebce2c5509d"
msgid "*Eek!*"
msgstr "*찍!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat
#. Speaker = Narrator
#. NodeID = 28aab9f8-efbe-5f6a-9d51-091184e2e761
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat:28aab9f8-efbe-5f6a-9d51-091184e2e761
msgctxt "h3d15f537ga711g4651g92c2g61ab58fda2d1"
msgid "*'Gluttony'? The rat squeaks in interest.*"
msgstr "*'탐욕'이라고? 쥐가 관심을 보이며 찍찍거립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat
#. Speaker = Narrator
#. NodeID = 291a04cb-f406-2664-b221-d2a5fc1ebfc3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat:291a04cb-f406-2664-b221-d2a5fc1ebfc3
msgctxt "h517c7bc3g7e41g4923gaef5gb4ba6bc6d49c"
msgid ""
"*The rat pauses, gauging whether his chipped tooth is, in fact, life "
"threatening.*"
msgstr "*쥐는 멈춰서서, 깨진 이빨이 정말 삶과 죽음의 문제인지 고찰합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat
#. Speaker = Rat
#. NodeID = 2a69ac69-8179-26d9-9420-2ea6f70298c5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_CampGeneral_Rat_PCPissedHimOff(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat:2a69ac69-8179-26d9-9420-2ea6f70298c5
msgctxt "h159deab1g4594g4ae7g929cgdd7966b4de20"
msgid "*Eek!*"
msgstr "*찍!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat
#. Speaker = Rat
#. NodeID = 2bc53151-9212-d393-4b91-7d3bd18f2084
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_CampGeneral_RufusHasMet(1) = False
#.   Tag:
#.      - PETPAL(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_CampGeneral_RufusHasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat:2bc53151-9212-d393-4b91-7d3bd18f2084
msgctxt "hc9c10b55gcab0g4ddfgba80g9d4f9103a4cb"
msgid "Stay back, or else!"
msgstr "물러나, 안 그러면!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat
#. Speaker = Player
#. NodeID = 353efde1-8125-67dc-4322-66c75649285c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_CampGeneral_RufusHasMet(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat:353efde1-8125-67dc-4322-66c75649285c
msgctxt "hfd0aa98eg43d1g4251ga70cg8a49c40c27ac"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat
#. Speaker = Narrator
#. NodeID = 35e67fb3-ac69-f762-782d-fc35e76f2bc6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Rat_Event_MoveToShack = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat:35e67fb3-ac69-f762-782d-fc35e76f2bc6
msgctxt "h0be69e80gc9b6g4901gaff1gbf197fd536ab"
msgid "*With an enthusiastic chitter, he urges you to follow.*"
msgstr "*쥐가 열정적으로 찍찍대며, 당신에게 따라오라고 재촉합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat
#. Speaker = Rat
#. NodeID = 386ee1b7-b931-931a-7cbf-dc43795d82f7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat:386ee1b7-b931-931a-7cbf-dc43795d82f7
msgctxt "hbe1ca31cgb0eag4a5fg8d1bga550c13cbc55"
msgid "It's not funny!"
msgstr "재미없거든!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat
#. Speaker = Narrator
#. NodeID = 396e79d7-341a-536e-0b49-96838513928c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_CampGeneral_RufusHasMet(1) = True
#.   Local:
#.      - 40734a27-a1e9-b806-9105-3720f53e6d2b_AnimalHandlingSuccess = True
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat:396e79d7-341a-536e-0b49-96838513928c
msgctxt "h8a76bcbagdefcg4defgb60ag716b9db79a9d"
msgid "*The rat chitters angrily - whatever broke his tooth is in this room.*"
msgstr "*쥐는 화난 것 같은 찍찍 소리를 냅니다. - 쥐의 앞니를 깨트린 것이 방 안에 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat
#. Speaker = Rat
#. NodeID = 3a512ab9-2d1c-0e50-f1fe-e2ee8aa1c487
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat:3a512ab9-2d1c-0e50-f1fe-e2ee8aa1c487
msgctxt "h1652288cgad8bg4480gb1c8g0137e78b941e"
msgid "Nothing's wrong! Just get back!"
msgstr "아무 문제 없어! 그냥 저리가!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat
#. Speaker = Narrator
#. NodeID = 40a094cd-b02d-d279-1620-0d3659d138e5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_CampGeneral_Rat_PCPissedHimOff(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat:40a094cd-b02d-d279-1620-0d3659d138e5
msgctxt "h038b322dg8a3eg4045gaa65g545fb7d17a8a"
msgid "*The rat bristles with an offended hiss.*"
msgstr "*쥐는 공격적인 찍찍 소리를 내며 털을 세웁니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat
#. Speaker = Player
#. NodeID = 42ebce24-4b97-178a-9c17-5e56d8e508e3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat:42ebce24-4b97-178a-9c17-5e56d8e508e3
msgctxt "h781b99dagdb6dg4579g9341g6be4b7ae26ac"
msgid "<i>Nod. He'll be fine.</i>"
msgstr "<i>고개를 끄덕인다. 별 문제 없을 것이다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat
#. Speaker = Player
#. NodeID = 4a8f27ca-ab41-5e55-cffd-b43ffb5c353e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat:4a8f27ca-ab41-5e55-cffd-b43ffb5c353e
msgctxt "h0ed4707ag6f61g4480g9eeegaca55d21df5e"
msgid "<i>Hiss back.</i>"
msgstr "<i>쉿 소리를 되돌려 준다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat
#. Speaker = Rat
#. NodeID = 4b09300e-0b2f-9b5f-0ac0-ed6ba1c1df98
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat:4b09300e-0b2f-9b5f-0ac0-ed6ba1c1df98
msgctxt "h807fe0dbg0f4ag45bcgbd29g7660b706a804"
msgid "It's the front one. I chipped it on the evil thing."
msgstr "앞쪽에 있는 이빨이야. 사악한 것 때문에 이가 깨졌네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat
#. Speaker = Player
#. NodeID = 539cd7c6-74ae-6d84-7b43-06bfdf364b2b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat:539cd7c6-74ae-6d84-7b43-06bfdf364b2b
msgctxt "h7c4e6f91g54f6g4216g93bdg449b5457d057"
msgid "What 'evil thing'?"
msgstr "'사악한 것'?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat
#. Speaker = Narrator
#. NodeID = 57016179-ebfe-3659-93f8-712fd105e341
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 40734a27-a1e9-b806-9105-3720f53e6d2b_AnimalHandlingSuccess = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat:57016179-ebfe-3659-93f8-712fd105e341
msgctxt "h58380373g7f36g4f11g8329g9341c8f5ba33"
msgid "*The rat's eyes soften as he emits a pained squeak.*"
msgstr "*고통에 찬 찍찍소리를 내뱉으며 쥐의 눈길이 부드러워집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat
#. Speaker = Rat
#. NodeID = 5dee5ea4-4c56-82f7-bce6-912f05e85d3c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_CampGeneral_Rat_PCPissedHimOff(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat:5dee5ea4-4c56-82f7-bce6-912f05e85d3c
msgctxt "he0e535f1ga95fg4453g8bf2gf25b6fc9a414"
msgid "You're no help!"
msgstr "쓸모 없는 것!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat
#. Speaker = Player
#. NodeID = 65cc49c2-927e-a097-fec1-3c10eacf4edb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat:65cc49c2-927e-a097-fec1-3c10eacf4edb
msgctxt "hfde270ddgc961g4ccfg89c2ge3ed45cf1b40"
msgid "Sounds like your problem, not mine."
msgstr "나랑 상관없는 네 문제 같네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat
#. Speaker = Rat
#. NodeID = 6a8d82e2-cf98-19e1-c181-987d3c6eb421
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat:6a8d82e2-cf98-19e1-c181-987d3c6eb421
msgctxt "h2c6b493bg0c17g4685g83b8gc4677c24f60b"
msgid "Ow! My tooth..."
msgstr "아야! 내 이빨..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat
#. Speaker = Rat
#. NodeID = 6c448c25-5943-9690-e024-672c404a7f5d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat:6c448c25-5943-9690-e024-672c404a7f5d
msgctxt "h0990be91g23d9g40e4g8994g98eec3331574"
msgid "I chipped it on the evil thing. It was horrible."
msgstr "사악한 것이 앞니를 깨뜨렸어. 끔찍했지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat
#. Speaker = Player
#. NodeID = 6ceec226-c28e-2375-3ee1-413f8067d048
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat:6ceec226-c28e-2375-3ee1-413f8067d048
msgctxt "h6a51c17fg7bf0g4a69ga5d9g3b9bf11872bc"
msgid "<i>Bare your own teeth at him.</i>"
msgstr "<i>당신의 이를 과시한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat
#. Speaker = Rat
#. NodeID = 74528535-8b07-170c-25eb-a756b90110e5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat:74528535-8b07-170c-25eb-a756b90110e5
msgctxt "h1d4e0e17g35beg4dc3g9e85gb9eea39e44e1"
msgid "Wait - you're big. You can get rid of the evil thing!"
msgstr "잠깐- 너 크구나! 그 사악한 것을 처리할 수 있겠어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat
#. Speaker = Player
#. NodeID = 76e8d0fc-29aa-654f-025d-c06d4b93f8f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat:76e8d0fc-29aa-654f-025d-c06d4b93f8f3
msgctxt "h57207ea5gf57ag4811gb9e7g35c58253d141"
msgid "Good luck with that."
msgstr "행운을 빌게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat
#. Speaker = Rat
#. NodeID = 7c66885b-f464-3ada-9728-223df6105ee1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_CampGeneral_Rat_PCPissedHimOff(1) = True
#.     - DEN_Rat_State_AnimalHandlingFailed(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat:7c66885b-f464-3ada-9728-223df6105ee1
msgctxt "h3ac0d0dfgec17g4389ga133g91213cfe1e29"
msgid "*Hiss!*"
msgstr "*쉬익!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat
#. Speaker = Rat
#. NodeID = 821c3ece-86bb-3559-1b97-33a0f4f3d2d6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_CampGeneral_RufusHasMet(1) = False
#.   Tag:
#.      - PETPAL(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_CampGeneral_RufusHasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat:821c3ece-86bb-3559-1b97-33a0f4f3d2d6
msgctxt "hab1c0377ga747g4b87gbf82ge616ceba0c4d"
msgid "*Hiss!*"
msgstr "*쉬익!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat
#. Speaker = Rat
#. NodeID = 8ae2eb1d-3da5-8f90-3cd6-8757f18bd4a3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_CampGeneral_RufusHasMet(1) = True
#.   Local:
#.      - 40734a27-a1e9-b806-9105-3720f53e6d2b_AnimalHandlingSuccess = False
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat:8ae2eb1d-3da5-8f90-3cd6-8757f18bd4a3
msgctxt "h3f7d30a9gfedfg48bag8b8bgb84f4df90524"
msgid "*Eek! Eek!*"
msgstr "*찍! 찍!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat
#. Speaker = Player
#. NodeID = 93a9550c-6d26-8ed4-5fbf-96767042016c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 10
#. CheckFlags:
#.   Dialog:
#.      - DEN_Rat_State_AnimalHandlingFailed(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat:93a9550c-6d26-8ed4-5fbf-96767042016c
msgctxt "h7736a9cegaf10g4990gaaadg59ba38198a21"
msgid "<i>Calm the creature.</i>"
msgstr "<i>진정시킨다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat
#. Speaker = Rat
#. NodeID = 949923d6-0687-0455-7296-2ca5fdfe8f57
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat:949923d6-0687-0455-7296-2ca5fdfe8f57
msgctxt "h1e4ba0beg2712g4537ga81agb5b9d709231d"
msgid "Does it? Oh, thank goodness."
msgstr "그래? 휴, 다행이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat
#. Speaker = Player
#. NodeID = 9ba3b0d8-6005-2e9a-c877-5f20f3ef4850
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_CampGeneral_RufusHasMet(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat:9ba3b0d8-6005-2e9a-c877-5f20f3ef4850
msgctxt "h6a15e825g9350g4606g988dg6682a9455aef"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat
#. Speaker = Narrator
#. NodeID = 9f360121-08e9-0c85-456f-2ce90077d668
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat:9f360121-08e9-0c85-456f-2ce90077d668
msgctxt "h9e2be064g839dg4670gb0bbg7fa0966c312a"
msgid "*His dark eyes stare at you, eager for this danger to be banished.*"
msgstr "*어두운 눈이 당신을 응시하며, 위험이 사라지기를 열망하고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat
#. Speaker = Player
#. NodeID = a1f082ea-ffdb-6bd9-d190-856a57bc541b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat:a1f082ea-ffdb-6bd9-d190-856a57bc541b
msgctxt "hc1456078g1175g4dcag99f1gb4811eebd6a7"
msgid "<i>Laugh at him.</i>"
msgstr "<i>비웃는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat
#. Speaker = Rat
#. NodeID = a3b6598b-10d6-5e35-028b-26f375e97479
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_CampGeneral_RufusHasMet(1) = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat:a3b6598b-10d6-5e35-028b-26f375e97479
msgctxt "h5cbf5216g4e26g4536ga690g823893d80f9b"
msgid "The evil thing's in the chest."
msgstr "상자 안에 사악한 게 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat
#. Speaker = Narrator
#. NodeID = a848bc17-6f75-1bb0-2e6f-5b48626f8a5a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Rat_Event_RemovedKey = True
#.      - DEN_Rat_Event_MoveToShack = True
#.   Local:
#.      - 40734a27-a1e9-b806-9105-3720f53e6d2b_AnimalHandlingSuccess = True
#.   Tag:
#.      - PETPAL(1) = False
#. SetFlags:
#.   Global:
#.     - DEN_Rat_Event_EnteredPotatoCrate = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat:a848bc17-6f75-1bb0-2e6f-5b48626f8a5a
msgctxt "h48034249g7d4eg406ega051g478eb8043acd"
msgid "*The rat squeaks excitedly - the chest is free from danger once again.*"
msgstr "*쥐가 흥분하여 찍찍댑니다. 그 상자는 다시 한번 위험에서 자유로워졌습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat
#. Speaker = Rat
#. NodeID = b3fc5ae2-507c-cd86-0025-8fe50d22a111
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Rat_Event_MoveToShack = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat:b3fc5ae2-507c-cd86-0025-8fe50d22a111
msgctxt "hb7910279ga0eag4586gb30fg39e02bf07615"
msgid "Follow me. But be ready for anything."
msgstr "날 따라와. 마음의 준비를 해둬."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat
#. Speaker = Player
#. NodeID = b4e99785-062a-8bd4-b8d1-b1967169312b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat:b4e99785-062a-8bd4-b8d1-b1967169312b
msgctxt "h26f3c2dag09d0g4e87g9dfdg3dae189afb1c"
msgid "It looks fine to me."
msgstr "그래도 괜찮아 보여."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat
#. Speaker = Rat
#. NodeID = bf9b666b-4ddb-67ee-64c0-6561e2cf6adb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat:bf9b666b-4ddb-67ee-64c0-6561e2cf6adb
msgctxt "h5a910c21g5e33g41adg9ff6gcc79568ae630"
msgid "Maybe. I didn't think it would bite me back."
msgstr "그럴지도. 그게 다시 나를 물줄은 몰랐지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat
#. Speaker = Player
#. NodeID = ca9ad31c-d4e3-9376-557c-bf4a7e3d1bdf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat:ca9ad31c-d4e3-9376-557c-bf4a7e3d1bdf
msgctxt "hb4f1dc9fg2263g4186g83feg93ecf7c6d2d9"
msgid "Let me take a look."
msgstr "내가 좀 봐줄게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat
#. Speaker = Narrator
#. NodeID = d05a37ad-40d3-10f0-9d8d-430d8376d007
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Rat_Event_MoveToShack = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat:d05a37ad-40d3-10f0-9d8d-430d8376d007
msgctxt "hf10d8d7eg47b4g4911gb1a0g26edcefa194f"
msgid "*Apparently satisfied, he beckons you with a squeak - follow.*"
msgstr "*쥐는 만족한 듯, 당신을 찍찍대며 따라오라고 부릅니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat
#. Speaker = Rat
#. NodeID = d87c0148-15bd-707f-00c8-8b31947458ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat:d87c0148-15bd-707f-00c8-8b31947458ad
msgctxt "h5c4c164cgdba3g4cf4g8d89gf7e0a7cff57f"
msgid "Or else, I'll - I'll bite you!"
msgstr "안 그러면, 널- 널 물어버릴 거야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat
#. Speaker = Narrator
#. NodeID = d99553e6-0cb5-0563-4638-d3bf18cb7ae7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat:d99553e6-0cb5-0563-4638-d3bf18cb7ae7
msgctxt "h290653f0gb318g434dgbc22gccd3b8ae1ad1"
msgid ""
"*You realise the source of his discomfort - one of his front teeth is "
"chipped.*"
msgstr "*당신은 쥐가 고통스러워 하는 원인을 깨닫습니다 - 앞니 하나가 깨져 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat
#. Speaker = Rat
#. NodeID = de5657d4-6b5f-915c-31e2-bfa1fefb2d4b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Rat_Event_RemovedKey = True
#.      - DEN_Rat_Event_MoveToShack = True
#.   Tag:
#.      - PETPAL(1) = True
#. SetFlags:
#.   Global:
#.     - DEN_Rat_Event_EnteredPotatoCrate = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat:de5657d4-6b5f-915c-31e2-bfa1fefb2d4b
msgctxt "hab767e66gc7cag44b0g8309g95eaa1921ce7"
msgid "The evil thing's gone! Now, where was I..."
msgstr "사악한 게 사라졌어! 그럼 이제 나는 하던 일로..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat
#. Speaker = Narrator
#. NodeID = e962cfec-76a4-31ab-37f9-1edf97372a1b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat:e962cfec-76a4-31ab-37f9-1edf97372a1b
msgctxt "hf9b5306bgd01ag4badg8d1bg6061ee01111e"
msgid "*He relaxes, an appreciative squeak escaping his tiny mouth.*"
msgstr "*그는 진정되었고, 작은 입으로 고마운듯 찍찍 거리는 소리를 냅니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat
#. Speaker = Player
#. NodeID = f50f0be8-cf99-2f21-62d0-0f567a9e7b13
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat:f50f0be8-cf99-2f21-62d0-0f567a9e7b13
msgctxt "hfdf33a95gb909g46f7ga6edg170f53832413"
msgid "<i>Soothe him.</i>"
msgstr "<i>그를 진정시킨다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat
#. Speaker = Rat
#. NodeID = f8020cf4-607e-3045-54e8-ee0e0f74f230
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_CampGeneral_Rat_PCPissedHimOff(1) = True
#.   Local:
#.      - 40734a27-a1e9-b806-9105-3720f53e6d2b_AnimalHandlingSuccess = False
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Rat:f8020cf4-607e-3045-54e8-ee0e0f74f230
msgctxt "hafb5c031g3aa4g4b17g8a60gf7481859b599"
msgid "*Hiss!*"
msgstr "*쉬익!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Refugee1
#. Speaker = Eramas
#. NodeID = 382e4bcf-c1ec-a9e8-0001-99f8b8e446cd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Refugee1:382e4bcf-c1ec-a9e8-0001-99f8b8e446cd
msgctxt "h15e5251aga9b9g4fc3gaba4g1e9d81d39643"
msgid "Grab what you can and get out, that's my advice."
msgstr "챙길 수 있는 건 챙겨서 여길 떠나세요. 그게 제 조언이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Refugee1
#. Speaker = Eramas
#. NodeID = a7f16b1d-0e54-3f9d-3d26-aa99d9da596c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_General_Refugee1_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_General_Refugee1_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Refugee1:a7f16b1d-0e54-3f9d-3d26-aa99d9da596c
msgctxt "h3ae41a9bgd725g4c35ga728gc6a0c94a1b40"
msgid "Goblins. Druids. This grove is a death trap."
msgstr "고블린. 드루이드. 이 숲은 죽음의 함정이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Refugee1
#. Speaker = Eramas
#. NodeID = b7e27d1a-9853-42bb-25cc-9035dc724259
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_General_Refugee1_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Refugee1:b7e27d1a-9853-42bb-25cc-9035dc724259
msgctxt "h29175bb3g4cc5g4a61g89d5gf191bea03c82"
msgid "I can pack or talk, and right now I'm packing."
msgstr "난 짐을 싸든 이야기를 하든 할 수 있지만, 지금은 짐을 쌀래요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Refugee4
#. Speaker = Toron
#. NodeID = 4fd349c6-b7d1-8cbe-6e94-9181b6a05259
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Refugees_State_LeadersAreDead = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Refugee4:4fd349c6-b7d1-8cbe-6e94-9181b6a05259
msgctxt "h7f5402c4gdf85g42c3g801egb54b46adcf47"
msgid "We should get moving. Goblins are bound to regroup eventually."
msgstr "얼른 출발해야 해. 고블린 놈들은 결국 세력을 회복할 거라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Refugee4
#. Speaker = Toron
#. NodeID = c0f26547-a50d-da15-bd8f-fe2f53316ef4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_General_Refugee4_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_General_Refugee4_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Refugee4:c0f26547-a50d-da15-bd8f-fe2f53316ef4
msgctxt "h9e21ba83ge6a9g480dga8c7g0b43ffc50b4b"
msgid ""
"This place is a bloody death trap, not a sanctuary. You should clear off "
"while you can."
msgstr "여긴 안식처가 아니라 빌어먹을 묫자리야. 뜰 수 있을 때 뜨는 게 좋을 거라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Refugee4
#. Speaker = Toron
#. NodeID = c153ee8f-e4bb-1f7e-bdfb-f8103e41186e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_General_Refugee4_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Refugee4:c153ee8f-e4bb-1f7e-bdfb-f8103e41186e
msgctxt "h2adb8797gab88g41efga579g0ec062fe4484"
msgid ""
"We're cornered in this place. Even the bloody druids look like they might "
"turn on us."
msgstr "우린 독 안에 든 쥐 신세야. 저 망할 드루이드들까지 우리를 치려 들 거 같다니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef
#. Speaker = Okta
#. NodeID = 0d250ad4-d17c-6f60-21c2-e15da215eaa4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_RefugeeChef_State_CauldronGone = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef:0d250ad4-d17c-6f60-21c2-e15da215eaa4
msgctxt "hc3a0536cg3d33g4919gad86g3fd49d580ebd"
msgid "Not now. Someone's been messing with my bloody cooking pot."
msgstr "지금은 안 돼. 누군가 내 망할 요리 솥에 장난을 친 것 같구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef
#. Speaker = Player
#. NodeID = 17f2b31c-abb9-2ce9-c01b-588147ecd47f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_DarkUrge_Event_ResistedUrge(1) = True
#.     - DEN_Thieflings_Event_TookGruel(1) = True
#.     - ORI_DarkUrge_Event_HadUrge(1) = True
#. TagRule: REALLY_DARK_URGE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef:17f2b31c-abb9-2ce9-c01b-588147ecd47f
msgctxt "h09e8404cg1d2ag48dag987ag82f76a4170b8"
msgid "<i>Stop thinking about delicious dwarf and take the bowl.</i>"
msgstr "<i>맛있는 드워프에 대한 생각은 그만두고 그릇을 받아든다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef
#. Speaker = Player
#. NodeID = 17f2b31c-abb9-2ce9-c01b-588147ecd47f
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_DarkUrge_Event_ResistedUrge(1) = True
#.     - DEN_Thieflings_Event_TookGruel(1) = True
#.     - ORI_DarkUrge_Event_HadUrge(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef:17f2b31c-abb9-2ce9-c01b-588147ecd47f
msgctxt "h4d6bfda7gc163g411dg8591g2a2e10222ea4"
msgid "<i>Take a bowl.</i>"
msgstr "<i>그릇을 받는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef
#. Speaker = Okta
#. NodeID = 1e103c1a-4bc2-7954-6562-b9fef3d7befe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef:1e103c1a-4bc2-7954-6562-b9fef3d7befe
msgctxt "hb0a60811g3aa6g4311g8575g80d9cf9ac462"
msgid "We'll need every bit of strength to make it to Baldur's Gate. Trust me."
msgstr "발더스 게이트로 가려면 젖 먹던 힘까지 짜내야 할 거란다. 날 믿으렴."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef
#. Speaker = Okta
#. NodeID = 21f47a2f-3086-05cc-2ca4-db70ef0cf17b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef:21f47a2f-3086-05cc-2ca4-db70ef0cf17b
msgctxt "h4b9269f5g84ebg4415gb421g7680810c1416"
msgid ""
"If a gnoll catches your scent, you'll need every bit of strength. Trust me."
msgstr "놀이 네 냄새를 맡으면, 젖 먹던 힘까지 다 짜내야 할 거야. 내 말 믿으렴."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef
#. Speaker = Okta
#. NodeID = 2227dc72-6f67-670b-06b2-2439c78914ab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef:2227dc72-6f67-670b-06b2-2439c78914ab
msgctxt "h82c053ccgf9b2g41b8g9be0g25a7228917d8"
msgid "Ha! That's a good attitude."
msgstr "하! 좋은 태도로구먼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef
#. Speaker = Okta
#. NodeID = 320164c2-5b4e-e09e-a1e0-38c0d98caacc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_Thieflings_Event_TookGruel2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef:320164c2-5b4e-e09e-a1e0-38c0d98caacc
msgctxt "h9afad0bagf0e9g47e9g9fd2ga08b4ff39bb8"
msgid ""
"Here. Have more. We'll need every bit of strength to make it to Baldur's "
"Gate. Trust me."
msgstr "여기. 더 먹어. 발더스 게이트에 도착하려면 젖 먹던 힘까지 짜내야 할 거란다. 내 말 믿으렴."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef
#. Speaker = Okta
#. NodeID = 3493fd43-07aa-f8ec-c60e-c2f94e311ad7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef:3493fd43-07aa-f8ec-c60e-c2f94e311ad7
msgctxt "h24f2461eg030ag4253g9bd0g8a8576a72eb7"
msgid ""
"See how you feel when your pack is empty - it'll be this or a handful of "
"weeds."
msgstr "음식 다 떨어졌을 때 두고 보라고. 이걸 먹든지 아니면 잡초 뽑아 먹어야 할 걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef
#. Speaker = Okta
#. NodeID = 39654506-7c65-e537-0fd8-c7ff2d346f18
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_HasMet_Chef(1) = True
#.   Object:
#.      - DEN_Thieflings_Event_TookGruel(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef:39654506-7c65-e537-0fd8-c7ff2d346f18
msgctxt "h71c0637eg8653g4e44gb568gc84b17b31b2a"
msgid "You've had your share. Leave some for the rest."
msgstr "이미 먹었잖니. 다른 이들을 생각해서 남겨주려무나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef
#. Speaker = Okta
#. NodeID = 45a41e22-7e90-d75a-fc23-fe72ef8aeb7f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef:45a41e22-7e90-d75a-fc23-fe72ef8aeb7f
msgctxt "h703d91aagb0b6g4bb1ga9d7gb892cd6fe072"
msgid "Hm. Look in your eyes says otherwise."
msgstr "흠. 네 눈은 다른 생각을 하는 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef
#. Speaker = Player
#. NodeID = 48e4d0b2-c39e-df8e-ee36-3c4eeff0a593
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef:48e4d0b2-c39e-df8e-ee36-3c4eeff0a593
msgctxt "he14ebb2fgcfa7g4d77gbba3gff17f067db12"
msgid "It's all in the past."
msgstr "다 지난 일이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef
#. Speaker = Okta
#. NodeID = 59cdc7a4-2644-f1d2-d0f3-2125852be144
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef:59cdc7a4-2644-f1d2-d0f3-2125852be144
msgctxt "h653de426g36bag4664gbd6fg706560c4f1c5"
msgid "Fancy a bowl?"
msgstr "한 그릇 줄까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef
#. Speaker = Player
#. NodeID = 632e1b44-0c71-15b7-832c-47ba6e0f197d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef:632e1b44-0c71-15b7-832c-47ba6e0f197d
msgctxt "hf645e330g1797g4953gb502g438124c81fab"
msgid "No, thank you. The smell is more than enough."
msgstr "아니요, 괜찮아요. 냄새만으로 충분하네요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef
#. Speaker = Okta
#. NodeID = 76ba8898-e68f-626d-e352-14a69aad6e1c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef:76ba8898-e68f-626d-e352-14a69aad6e1c
msgctxt "hafaa5ea8g85bag4671ga6f8g5127f877caa2"
msgid "You been on hard times too, huh?"
msgstr "너도 꽤 어려운 시절을 보냈나 보구나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef
#. Speaker = Okta
#. NodeID = 7ad405bf-abfc-d729-9e27-a454bc422bec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef:7ad405bf-abfc-d729-9e27-a454bc422bec
msgctxt "hc80b9b87gfcb8g4703g8f50g499ce3466616"
msgid ""
"Ha! You're a far cry from such things. But if I fooled your nose, I must be "
"doing something right."
msgstr "하! 그런 것들과는 거리가 멀지. 네 코를 속였다면, 내가 분명 뭔가 제대로 만들었나 보구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef
#. Speaker = Player
#. NodeID = 7bc7b0ec-11f5-bf08-e5f1-f911f9a059b7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DRAGONBORN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef:7bc7b0ec-11f5-bf08-e5f1-f911f9a059b7
msgctxt "hafab1f3ag7fe0g4d2fg86ebg557bee408910"
msgid "Agreed. Hungry warriors make for easy prey."
msgstr "동의해. 배고픈 전사는 쉬운 먹잇감이 되지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef
#. Speaker = Player
#. NodeID = 8f90e569-ac57-cc10-1f8c-9cfeeb621ec8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef:8f90e569-ac57-cc10-1f8c-9cfeeb621ec8
msgctxt "habf58ee6g402bg423ega136g717c6a7acdbf"
msgid "No worse than what you're facing now."
msgstr "당신이 지금 처한 상황보단 나쁘지 않았죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef
#. Speaker = Okta
#. NodeID = 954cc45d-3f88-6090-a975-eb9632aa62fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef:954cc45d-3f88-6090-a975-eb9632aa62fd
msgctxt "h71d23801g2bdbg4797g9137g5135f4ae451f"
msgid ""
"Suit yourself, but the only way we'll make it to Baldur's Gate is to run, "
"and run hard."
msgstr "좋을 대로 하렴. 하지만 발더스 게이트까지 갈 수 있는 유일한 방법은 열심히 달리는 것뿐이란다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef
#. Speaker = Okta
#. NodeID = 958e7fd1-ce69-0415-e988-3357465733b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef:958e7fd1-ce69-0415-e988-3357465733b4
msgctxt "hcebde28bg9aadg4759ga1bdg7048d7ae22cc"
msgid "Best to fill your belly now - while we still can."
msgstr "배를 채울 수 있을 때 채워 두는 게 좋을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef
#. Speaker = Player
#. NodeID = 9ba54d5e-8fd4-cbce-297f-6f993d08e315
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef:9ba54d5e-8fd4-cbce-297f-6f993d08e315
msgctxt "he46f46fbg78a9g4ab4gb078g4f2938a2f609"
msgid "I'm not hungry."
msgstr "배 안 고파요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef
#. Speaker = Player
#. NodeID = 9e06841c-a9bd-4225-dc3a-dd6aad316686
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - HALFLING(1) = True
#. SetFlags:
#.   Object:
#.     - DEN_Thieflings_Event_TookGruel(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef:9e06841c-a9bd-4225-dc3a-dd6aad316686
msgctxt "hea919bdeg3fb4g4924g9542g85ce713dc0e0"
msgid "I never turn down a free meal."
msgstr "공짜 식사를 거부할 순 없죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef
#. Speaker = Okta
#. NodeID = 9f61f32b-993c-3f0a-654a-3e1f91577f1f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef:9f61f32b-993c-3f0a-654a-3e1f91577f1f
msgctxt "h5e96a535g313dg4f5ag9ae0gdd9d98443f80"
msgid "Look. It ain't much, but it might make all the difference."
msgstr "알아. 별건 아니지만, 이게 대단한 차이를 만들어낼지 누가 아니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef
#. Speaker = Okta
#. NodeID = a267f4e5-1594-b209-a1b6-3bc1ae991081
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef:a267f4e5-1594-b209-a1b6-3bc1ae991081
msgctxt "he2e6f1d1gfeceg4a40gbb5fgc3967ac69940"
msgid "The only way we'll make it to Baldur's Gate is to run, and run hard."
msgstr "우리가 발더스 게이트에 도착할 방법은 뛰는 것 밖엔 없어, 최대한 빨리 뛰어야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef
#. Speaker = Okta
#. NodeID = a58a1ced-3b5b-bd3f-40ec-804cebfd20cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef:a58a1ced-3b5b-bd3f-40ec-804cebfd20cf
msgctxt "he2d6da7cgb6e2g4af1g8c05ga4da07cba72d"
msgid "You're an easy one to please, aren't you?"
msgstr "별로 안 까다로운 녀석이구나, 그렇지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef
#. Speaker = Player
#. NodeID = a8cead2b-d5e9-739a-4fa1-17274b05519f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(1) = False
#.      - REALLY_GALE(1) = False
#.      - DROWELF(1) = False
#. SetFlags:
#.   Object:
#.     - DEN_Thieflings_Event_TookGruel(1) = True
#. TagRule: REALLY_DARK_URGE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef:a8cead2b-d5e9-739a-4fa1-17274b05519f
msgctxt "h02b3b9c2ga2d5g49ecgb837gc4a737722825"
msgid ""
"Grey goo... I think I ate things like this in the past. When I was desperate."
msgstr "회색 꿀꿀이죽... 옛날에 이런 걸 먹곤 했지. 절박했던 시절에 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef
#. Speaker = Player
#. NodeID = a8cead2b-d5e9-739a-4fa1-17274b05519f
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(1) = False
#.      - REALLY_GALE(1) = False
#.      - DROWELF(1) = False
#. SetFlags:
#.   Object:
#.     - DEN_Thieflings_Event_TookGruel(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef:a8cead2b-d5e9-739a-4fa1-17274b05519f
msgctxt "he70c8fb2g6053g4500g90d6g1c352edb7220"
msgid "A bowl of grey goo. Reminds me of home."
msgstr "물컹한 회색 죽이라. 집이 생각나는군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef
#. Speaker = Player
#. NodeID = ad993fda-378c-d6dd-8ae7-851e3646142b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_PLANAR(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef:ad993fda-378c-d6dd-8ae7-851e3646142b
msgctxt "hd1e6b09dg5a43g46b6gbfcag95710d857fe8"
msgid "This is a delicacy of your land? I'll try anything once."
msgstr "이게 당신네 지역의 별미입니까? 뮈라도 한 번 먹어보겠습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef
#. Speaker = Okta
#. NodeID = aee5f2db-5676-1542-c22e-7a687ed78f22
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_HasMet_Chef(1) = True
#.   Object:
#.      - DEN_Thieflings_Event_TookGruel(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef:aee5f2db-5676-1542-c22e-7a687ed78f22
msgctxt "he15d3c38g0a2bg44b2gbc11gaeb86895d932"
msgid "We'll be leaving soon. Make sure you stock up."
msgstr "곧 떠날 거야. 짐 챙겨."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef
#. Speaker = Okta
#. NodeID = b42b2333-a2b3-a189-39aa-3e13708669c5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_HasMet_Chef(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_HasMet_Chef(1) = True
#.   Object:
#.     - PreventTradeWithPlayer(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef:b42b2333-a2b3-a189-39aa-3e13708669c5
msgctxt "h3646f1c1g08feg4e8fg813dgde99fc00cda8"
msgid "You. Saw you fighting those slimy bastards."
msgstr "너로구나. 네가 그 끈적끈적한 개자식들을 상대로 싸우는 걸 봤어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef
#. Speaker = Okta
#. NodeID = b93cfd29-2b8f-7b35-ea05-a197d60a2314
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef:b93cfd29-2b8f-7b35-ea05-a197d60a2314
msgctxt "hdf6fc301g975fg46dagb485g504fd0bfd524"
msgid "Didn't think the food was <i>that</i> bad."
msgstr "음식이 <i>그렇게 </i>나쁘진 않았던 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef
#. Speaker = Player
#. NodeID = badd63b6-fd37-5e9f-0c50-3a83ea34cb46
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_Thieflings_Event_TookGruel(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef:badd63b6-fd37-5e9f-0c50-3a83ea34cb46
msgctxt "h055bd294gc09ag4decgb32fg0ef9371ec816"
msgid "<i>Take the bowl.</i>"
msgstr "<i>그릇을 받는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef
#. Speaker = Player
#. NodeID = c7c5c9e4-9277-4125-5dbc-8cb4ee51b8e3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef:c7c5c9e4-9277-4125-5dbc-8cb4ee51b8e3
msgctxt "h76496babg1212g4227gb699g74d15dcf2f9e"
msgid "I'm good, thanks."
msgstr "전 괜찮아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef
#. Speaker = Player
#. NodeID = cb9d8fd7-8929-d6c4-6c04-bd567fc6a26f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GNOME(1) = True
#. SetFlags:
#.   Object:
#.     - DEN_Thieflings_Event_TookGruel(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef:cb9d8fd7-8929-d6c4-6c04-bd567fc6a26f
msgctxt "h021ff0c0g00fag45f1gaba9g7a39261d7951"
msgid "Thank you. What's in this? Oats? Honey?"
msgstr "고마워요. 안에 든 게 뭐죠? 귀리? 꿀?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef
#. Speaker = Player
#. NodeID = d9bcac2b-a2af-56de-6770-79cfbe7a3992
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_DROWELF or REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef:d9bcac2b-a2af-56de-6770-79cfbe7a3992
msgctxt "h9ae27d3dgac9ag4409g9246gd0cd91cda904"
msgid "This slop is beneath me."
msgstr "이런 수준 떨어지는 건 못 먹겠네요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef
#. Speaker = Okta
#. NodeID = e3c30cb0-f9ff-7b7b-39db-4d85f810783c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef:e3c30cb0-f9ff-7b7b-39db-4d85f810783c
msgctxt "ha1f79a0fg788eg4ecegbd24gd7aafd72a68a"
msgid "Go ahead. Turn that pretty nose of yours up."
msgstr "한번 쭉 들이켜봐. 그 예쁜 코를 쭉 올려서 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef
#. Speaker = Okta
#. NodeID = eda24044-a368-d5e4-c430-f31b4635c194
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef:eda24044-a368-d5e4-c430-f31b4635c194
msgctxt "hc3a3d02bg42edg46f1gb2ecg8da5f4ced8f3"
msgid "That doesn't mean it's behind us though, does it?"
msgstr "그 말은 이 상황도 우리에게 끝났다는 말은 아니지, 그렇지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef
#. Speaker = Okta
#. NodeID = f15863f7-c34b-ada5-a4c7-fb941c8783da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef:f15863f7-c34b-ada5-a4c7-fb941c8783da
msgctxt "h00dc1b76gff30g4592g921cgdb9cdb12a52a"
msgid "Food. You want it or not?"
msgstr "음식이지. 먹을 거야 말 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef
#. Speaker = Player
#. NodeID = f557feca-deed-5956-381b-7b41963521d3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef:f557feca-deed-5956-381b-7b41963521d3
msgctxt "h893c0575gc850g4852gb0a1g495d349d775c"
msgid "What is it, exactly?"
msgstr "그게 정확히 뭐에요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef
#. Speaker = Player
#. NodeID = f8fbb8da-593e-8b69-cd91-e12db32cfade
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#. SetFlags:
#.   Object:
#.     - ORI_DarkUrge_Event_IndulgedUrge(1) = True
#.     - ORI_DarkUrge_Event_HadUrge(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_RefugeeChef:f8fbb8da-593e-8b69-cd91-e12db32cfade
msgctxt "h8203f607gfdc6g4d1egaffag4a4fd7fe17cb"
msgid "I much prefer roasted dwarf."
msgstr "난 드워프 구이가 좋아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Narrator
#. NodeID = 000f90ac-570c-65d4-41e7-33cdee5cb0b2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - cb9d5939-7bd4-2ed3-e7ec-63780fdda4d9_AnimalHandlingSuccess = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:000f90ac-570c-65d4-41e7-33cdee5cb0b2
msgctxt "hfbf83619ga446g425bg9e14gcfe92f640b3b"
msgid "*The squirrel flees, shrieking with indignant terror.*"
msgstr "*다람쥐가 공포심에 분개하며 도망칩니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Timber
#. NodeID = 032593ff-86d5-35b9-0dda-2a7585aae586
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:032593ff-86d5-35b9-0dda-2a7585aae586
msgctxt "h1a2d065fg5350g4645gac81g181805f074b6"
msgid "I doubt you could muster more than a bit of smoke."
msgstr "연기도 못 낼 거 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Timber
#. NodeID = 06b3c558-5f13-7e7f-1aff-13021340820c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Squirrel_HasMet(1) = False
#.   Tag:
#.      - PETPAL(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Squirrel_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:06b3c558-5f13-7e7f-1aff-13021340820c
msgctxt "he52ca5d0gcb9cg44acgbc9cgcd671d6037d7"
msgid "Get out!"
msgstr "나가!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Player
#. NodeID = 122e1553-b649-56b0-b5bd-facafbda6474
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 10
#. CheckFlags:
#.   Dialog:
#.      - DEN_Squirrel_State_AnimalHandlingFailed(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:122e1553-b649-56b0-b5bd-facafbda6474
msgctxt "h4c9d6ab1g24d2g4cacg8bd6gc738a4076825"
msgid "<i>Study the creature's behaviour.</i>"
msgstr "<i>생명체의 행동을 관찰한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Narrator
#. NodeID = 132775fb-8891-ba3a-3470-19bbe859f7f3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_General_Squirrel_LearnedTerritory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:132775fb-8891-ba3a-3470-19bbe859f7f3
msgctxt "ha9fcbe67ga540g4aadg925fg1d0e9f503cf3"
msgid ""
"*Looking around, 'her territory' extends from one end of the grove to "
"another.*"
msgstr "*주위를 둘러보니, '그녀의 구역'은 숲 전체를 아우르는 모양입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Player
#. NodeID = 1372f15b-6810-3e1e-1806-a9b12229c705
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#. TagRule: BERSERKER
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:1372f15b-6810-3e1e-1806-a9b12229c705
msgctxt "h6c1b0452g98fbg4b99g9fd6g96346b75a725"
msgid "<b><i>ROAR. I WILL EAT YOU.</i></b>"
msgstr "<b><i>크아아. 널 삼켜버리겠다.</i></b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Player
#. NodeID = 1372f15b-6810-3e1e-1806-a9b12229c705
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:1372f15b-6810-3e1e-1806-a9b12229c705
msgctxt "h8873f97dgc0b5g4565gb984ge3f3674b0b64"
msgid ""
"I could eat you whole - you can pretend I'm gone, once you're in the dark of "
"my belly."
msgstr "널 통째로 삼킬 수도 있어. 내 뱃속에 들어가고 나면, 내가 사라진 척을 해도 될 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Player
#. NodeID = 18c65592-aba2-20dd-27f2-810b3819a52e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_CampGeneral_Squirrel_PCFailedRawStrength_Punch(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:18c65592-aba2-20dd-27f2-810b3819a52e
msgctxt "h279737b9gc032g4ebegb476g8b8989f322a6"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Timber
#. NodeID = 1947c8cb-6449-462b-a6cc-70d0b16fd297
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:1947c8cb-6449-462b-a6cc-70d0b16fd297
msgctxt "h85d408f3g5fa5g461egb803g1eec0b6d9ef1"
msgid "Okay, okay, calm down. We can make a deal."
msgstr "알겠어, 알겠어, 진정해. 거래를 하자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Narrator
#. NodeID = 1c052399-de96-ce9a-bd83-1701ca226ff6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_General_Squirrel_PCPunchedSquirrel(1) = True
#.   Object:
#.     - ORI_DarkUrge_Event_IndulgedUrge(1) = True
#.     - ORI_DarkUrge_Event_HadUrge(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:1c052399-de96-ce9a-bd83-1701ca226ff6
msgctxt "h6e0300f4gfe2ag44dag9ee9geda4cb31c4aa"
msgid "*The swirling bile-cauldron of your brain is cooking up a poison stew.*"
msgstr "*소용돌이치는 증오의 가마솥과도 같은 당신의 두뇌는 현재 독이 든 스튜를 끓여내고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Narrator
#. NodeID = 23db700d-7a91-effa-a556-f59e2b7a6748
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Squirrel_HasMet(1) = False
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#.      - PETPAL(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:23db700d-7a91-effa-a556-f59e2b7a6748
msgctxt "h30c42a43gf505g4727gaf4dg406cbb8febe5"
msgid ""
"*This squirrel might be the single most adorable creature you can recall in "
"all your stunted memory!*"
msgstr "*이 다람쥐야말로 당신의 망가진 기억력으로 떠올릴 수 있는 한 세상에서 제일 귀여운 생물입니다!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Player
#. NodeID = 250bcfaf-9653-75b6-d2bc-816809b624a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:250bcfaf-9653-75b6-d2bc-816809b624a5
msgctxt "h4b1e4b33g1700g41acgac55gf372837c9e06"
msgid "My instincts are sharp, daggered things. Stay out of their way."
msgstr "내 본능은 날이 바짝 선 단검과 같지. 칼날 근처에 얼쩡거리지 말라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Karlach
#. NodeID = 279964b1-d3de-4c56-b0a8-9c3877af2555
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(8) = True
#.   Tag:
#.      - REALLY_KARLACH(8) = True
#. SetFlags:
#.   Local:
#.     - cb9d5939-7bd4-2ed3-e7ec-63780fdda4d9_HadKickingInclusion = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:279964b1-d3de-4c56-b0a8-9c3877af2555
msgctxt "h8ea6c69eg6f5ag454bg9e8fg0b9840b96003"
msgid "What. The. Hells."
msgstr "무슨. 대체. 왜."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Narrator
#. NodeID = 27e3ea7b-db6f-c938-5f02-3894adc8920d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Squirrel_HasMet(1) = True
#.   Local:
#.      - cb9d5939-7bd4-2ed3-e7ec-63780fdda4d9_AnimalHandlingSuccess = True
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:27e3ea7b-db6f-c938-5f02-3894adc8920d
msgctxt "h7cb2d8ccg67c9g4a19g80d1g8d2e520e051c"
msgid "*The squirrel flicks her tail at you and turns away.*"
msgstr "*다람쥐가 당신에게 자신의 꼬리를 잽싸게 튕기고는 뒤돌아섭니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Player
#. NodeID = 29497bbe-9385-0255-14ef-dd93b756e39f
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:29497bbe-9385-0255-14ef-dd93b756e39f
msgctxt "h6ddda042gdecag4df8g8760g7b5ee05204a9"
msgid "<i>Scold her with a click of your tongue.</i>"
msgstr "<i>혀를 차서 꾸짖는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Player
#. NodeID = 2b1e34ca-f2f9-c065-c834-a9c12a7bf5d9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:2b1e34ca-f2f9-c065-c834-a9c12a7bf5d9
msgctxt "h4ea7bc6cg2277g406bgba79g17b0058482ba"
msgid "Last words I won't remember."
msgstr "그 유언은 기억 안 해주마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Player
#. NodeID = 2bf3b362-574d-cf5a-ecef-4d276fd175bd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:2bf3b362-574d-cf5a-ecef-4d276fd175bd
msgctxt "h6337183bg1713g4269g85d7g6b9c27888c19"
msgid "<i>Take fright: your thoughts just possessed you.</i>"
msgstr "<i>경악합니다. 당신의 사고가 방금 당신을 지배했습니다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Narrator
#. NodeID = 2f0e2a47-854c-435f-894b-79c479085b73
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:2f0e2a47-854c-435f-894b-79c479085b73
msgctxt "h3e15c7d2ge3e6g4123g9c16g43f82d7a6eca"
msgid "*Useless. The pain grips tight, sapping all composure out of you...*"
msgstr "*무의미 합니다. 고통이 당신을 강하게 붙잡고, 모든 평정심을 빼앗아갑니다...*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Player
#. NodeID = 2f1aa33a-0bac-880a-4547-da7ddfcfb712
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:2f1aa33a-0bac-880a-4547-da7ddfcfb712
msgctxt "h686ef77eg0245g45cfgb150ga33704fd344a"
msgid "What is this bizarre creature?"
msgstr "이 특이한 생명체는 뭐지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Timber
#. NodeID = 2fd9acef-57e1-860e-eddd-6bd6069a3c22
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:2fd9acef-57e1-860e-eddd-6bd6069a3c22
msgctxt "h3653753eg487eg471cga0d5g67b342bab8a5"
msgid "Try it again. I dare you."
msgstr "도전해 봐. 다시 해 보라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Player
#. NodeID = 2ff98782-e74f-487e-a881-32cf830fa960
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_State_SavedAnimal = False
#.      - ORI_Shadowheart_State_IncurableWound_Unavailable = False
#.      - GLO_Not_For_EA = True
#.   Tag:
#.      - AVATAR(1) = False
#.      - REALLY_SHADOWHEART(1) = True
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_State_SavedAnimal = True
#.     - ORI_Shadowheart_Event_IncurableWoundFlared = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:2ff98782-e74f-487e-a881-32cf830fa960
msgctxt "h0a18ded2g7d5dg4e0dgafe2gec35fa2256dc"
msgid "<i>Ngh</i>... it hurts..."
msgstr "<i>으</i>...아파..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Player
#. NodeID = 327b4512-0190-48c6-b2dd-134d7a8760c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:327b4512-0190-48c6-b2dd-134d7a8760c8
msgctxt "hcc269d64g7195g493aga8e5g5b72010ed28e"
msgid "<i>Breathe. Try to push past the sensation.</i>"
msgstr "<i>호흡합니다. 그 감각을 밀어 젖히기 위해 시도합니다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Player
#. NodeID = 3428229b-0426-4b19-bc78-ffe13065ae7d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:3428229b-0426-4b19-bc78-ffe13065ae7d
msgctxt "h8f25277eg5fe9g48b7g9ffeg4d0ab508390a"
msgid "What's your problem?"
msgstr "넌 뭐가 문제야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Player
#. NodeID = 35078f3a-85c9-7aa2-7b6b-c01c6a7912e1
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Strength
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#. TagRule: BERSERKER
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:35078f3a-85c9-7aa2-7b6b-c01c6a7912e1
msgctxt "h13e9982bg7b13g4e26g9e02gcfc6c094042e"
msgid "<b><i>ROAR.</i></b>"
msgstr "<b><i>크아아.</i></b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Player
#. NodeID = 35078f3a-85c9-7aa2-7b6b-c01c6a7912e1
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Strength
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:35078f3a-85c9-7aa2-7b6b-c01c6a7912e1
msgctxt "hec9246deg3e97g415dg8514g17eff9a5a1f6"
msgid "<i>Growl threateningly.</i>"
msgstr "<i>위협적으로 으르렁거린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Player
#. NodeID = 35776221-9774-6d6b-7a10-46b4172812ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:35776221-9774-6d6b-7a10-46b4172812ae
msgctxt "h15f1a4d1gd66cg4f08g96abg0ea8ca23177a"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Player
#. NodeID = 35f84d25-b9ce-b5fa-7b3e-a6ebefeef51b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:35f84d25-b9ce-b5fa-7b3e-a6ebefeef51b
msgctxt "hb3fe268fg78edg40a7g9b7cg23534c96fa5d"
msgid "<i>Reach for your weapon.</i>"
msgstr "<i>무기에 손을 뻗는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Narrator
#. NodeID = 36692d85-63de-4d3b-b71a-db759b233e42
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:36692d85-63de-4d3b-b71a-db759b233e42
msgctxt "had88ae33gb54eg4045g844bg1856217afc5c"
msgid ""
"*Is Lady Shar punishing you? Or perhaps testing you? Is it the tadpole, or a "
"curse? You cannot say.*"
msgstr ""
"*샤 여신님이 당신을 벌하고 있는 걸까요? 아니면 시험하고 있는 걸까요? 올챙이 때문일까요, 아니면 저주 때문일까요? 당신은 대답하지 "
"못합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Astarion
#. NodeID = 39bcdb3f-4822-e28c-2653-d7f0ba4fc910
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:39bcdb3f-4822-e28c-2653-d7f0ba4fc910
msgctxt "h64917135g8220g49d4g8a1cg67249a1f25bc"
msgid "Oh, it's everywhere. You ruined a perfectly good snack."
msgstr "아주 박살 나 버렸네. 어떻게 이런 좋은 간식거리를 버릴 수가 있니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Timber
#. NodeID = 3da2cb38-c219-8e8c-d7bd-a3c68ccecaf0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:3da2cb38-c219-8e8c-d7bd-a3c68ccecaf0
msgctxt "hba98b847g9bceg4e57ga482g3fdca103077f"
msgid "The sort that's in charge around here."
msgstr "이 주변을 책임지고 있는 종이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Narrator
#. NodeID = 3ed6ebf3-a4a1-1baf-84d0-938722d5a502
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_General_Squirrel_MadeFriends(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:3ed6ebf3-a4a1-1baf-84d0-938722d5a502
msgctxt "hf39d2a78g73b3g4980g91cfgdcd491f090cd"
msgid ""
"*After a final squeak of warning - break the rules, and there will be "
"trouble - she scurries away.*"
msgstr "*규칙을 어기면 재미없을 거란 마지막 경고를 담아 찍찍거린 다람쥐가 황급히 도망갑니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Narrator
#. NodeID = 42d68a10-2579-885b-dcad-2080a5d5f4e0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - cb9d5939-7bd4-2ed3-e7ec-63780fdda4d9_AnimalHandlingSuccess = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:42d68a10-2579-885b-dcad-2080a5d5f4e0
msgctxt "h82443c36g9948g4f70gb8e3gd0859cc3e575"
msgid ""
"*You follow the squirrel's gaze to a pair of clumsy, ugly feet. Your own, on "
"<i>her</i> territory.*"
msgstr "*시선을 따라가 보니 지저분하고 못생긴 발 한 쌍이 보입니다. <i>다람쥐의</i> 영역을 침범한 당신의 발입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Timber
#. NodeID = 4d2a8eb1-5212-63eb-7dde-d48f7a5e6d5f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Squirrel_HasMet(1) = False
#.   Tag:
#.      - REALLY_DARK_URGE(1) = False
#.      - PETPAL(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_Squirrel_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:4d2a8eb1-5212-63eb-7dde-d48f7a5e6d5f
msgctxt "ha2421de8g2fb1g4c42gb3degb8a3d51e4d6c"
msgid "*Cht cht!*"
msgstr "*쭛 쭛!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Timber
#. NodeID = 4f99d5ab-684c-05f3-b55c-5e0ef7318af3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:4f99d5ab-684c-05f3-b55c-5e0ef7318af3
msgctxt "h08f14be3g3320g4751g8a48g7cf6f0ad2d89"
msgid "I better not catch you around here again."
msgstr "다신 여기서 내 눈에 띄지 않는 게 좋을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Player
#. NodeID = 51743ddd-af9a-7a65-9a6a-22de8f02814e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:51743ddd-af9a-7a65-9a6a-22de8f02814e
msgctxt "ha97dbb8bg83efg4a00g8f6fg6dc70322a08e"
msgid "Calm down - I'm a friend."
msgstr "진정해. 난 친구야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Player
#. NodeID = 544f275e-ae5c-4088-b58e-c1c6e5610403
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:544f275e-ae5c-4088-b58e-c1c6e5610403
msgctxt "h1d806184ge514g498eg99fdgf969e213072d"
msgid "<i>Try to understand what's happening.</i>"
msgstr "<i>무슨 일이 일어나는지 이해하려 애쓴다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Timber
#. NodeID = 54535623-e0b1-8067-60be-16e078229a5f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Squirrel_HasMet(1) = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:54535623-e0b1-8067-60be-16e078229a5f
msgctxt "h8e26474cga0a7g49fcg8e14g09004cae393f"
msgid "What did I tell you? Clear out!"
msgstr "내가 뭐랬어? 여기서 나가라고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Player
#. NodeID = 54cb82b9-d8bd-7aca-5a00-87e042adce94
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Dexterity
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:54cb82b9-d8bd-7aca-5a00-87e042adce94
msgctxt "hbccca81bgd90cg4855g86f6g7daac6624b07"
msgid "<i>Kick her.</i>"
msgstr "<i>발로 찬다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Timber
#. NodeID = 56e63f43-223d-bf63-d8f7-ba058fce6697
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_General_Squirrel_LearnedTerritory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:56e63f43-223d-bf63-d8f7-ba058fce6697
msgctxt "hdf646fd4g072dg4d1bg8ce5gd6f1db9a244e"
msgid "You're trespassing. This is <i>my</i> territory."
msgstr "넌 무단침입을 범하고 있어. 여긴 <i>내</i> 영토야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Lae'zel
#. NodeID = 57f2f175-0581-46fa-8d5f-0faf6732a127
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_LAEZEL(5) = True
#. SetFlags:
#.   Local:
#.     - cb9d5939-7bd4-2ed3-e7ec-63780fdda4d9_HadKickingInclusion = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:57f2f175-0581-46fa-8d5f-0faf6732a127
msgctxt "hc7c9c2f9g8fd5g4b02g82cag205267f7d8bd"
msgid "Terrific. If I'm ever harangued by a rodent, I'll know who to call for."
msgstr "훌륭하군. 언젠가 설치 동물에게 괴롭힘을 당하게 된다면, 누구를 불러야 될지 알겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Timber
#. NodeID = 584df300-7984-4528-2651-7146a3df8d83
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Squirrel_HasMet(1) = True
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:584df300-7984-4528-2651-7146a3df8d83
msgctxt "h3752a0a1g3154g4978gae9egeb5e7bdf23f4"
msgid "*Cht!*"
msgstr "*쭛!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Player
#. NodeID = 5a2a522d-05c8-cb49-662f-74dbc36343ad
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Dexterity
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:5a2a522d-05c8-cb49-662f-74dbc36343ad
msgctxt "hffd1cd5agab96g4c6dga27bge25c6046028a"
msgid "<i>Kick the squirrel.</i>"
msgstr "<i>다람쥐를 발로 찬다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Player
#. NodeID = 5e31ea04-d10c-f8d8-2166-3f2451e79499
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:5e31ea04-d10c-f8d8-2166-3f2451e79499
msgctxt "h117f4a75g8b72g4ae4g9f5dg5f8315f1fecd"
msgid "<i>Forget about it. It was a waste of space.</i>"
msgstr "<i>잊어 버려. 공간 낭비였을 뿐이야.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Timber
#. NodeID = 6158a58e-bdf2-b801-8f52-f7ec1792c442
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:6158a58e-bdf2-b801-8f52-f7ec1792c442
msgctxt "h5809850fg9da8g4832gb237ga058f9998fa1"
msgid "Now get moving. I'm tired of looking at you."
msgstr "이제 가봐. 널 쳐다보는 것도 지치니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Narrator
#. NodeID = 6206a7b5-b70b-3429-3474-7668be04bb84
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:6206a7b5-b70b-3429-3474-7668be04bb84
msgctxt "hbc8576bfg70cdg418ag8d39gff59b234e1ab"
msgid "*It is unnecessarily odd. A small, noisy pest with a bushy tail.*"
msgstr "*쓸데없이 이상한 녀석입니다. 꼬리가 덥수룩한 데다 작고 시끄러운 쥐새끼군요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Player
#. NodeID = 66d577cc-5f93-1e80-9dd5-5a6d64debc68
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:66d577cc-5f93-1e80-9dd5-5a6d64debc68
msgctxt "hb97620e9g2daag4671g9e43gcd137e42c230"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Timber
#. NodeID = 6b265dde-683e-dfdc-dfc5-b5311a0f9967
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:6b265dde-683e-dfdc-dfc5-b5311a0f9967
msgctxt "h847d76e4ga230g44fcg86b0gc55432d6e36d"
msgid ""
"I'll even sweeten the pot. Found some weird smelling stuff on the ground. "
"You can keep it. But..."
msgstr "특별히 조건도 후하게 해 주지. 이상한 냄새가 나는 걸 땅에서 찾았어. 가져도 좋아. 하지만..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Narrator
#. NodeID = 6e8086f7-69bb-40f0-9fa5-7078a395297e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:6e8086f7-69bb-40f0-9fa5-7078a395297e
msgctxt "h36ae1908ga395g4006gb3b9g0c63e33d67e2"
msgid "*She offers you nothing.*"
msgstr "*여신은 아무 것도 내려 주지 않습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Wyll
#. NodeID = 77e0ea3d-98ab-4a82-a8a8-e17c40aa7315
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_WYLL(6) = True
#. SetFlags:
#.   Local:
#.     - cb9d5939-7bd4-2ed3-e7ec-63780fdda4d9_HadKickingInclusion = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:77e0ea3d-98ab-4a82-a8a8-e17c40aa7315
msgctxt "h31ffbd40g6e3dg4535g80e5g8210b3e1ab47"
msgid "Gods! What in the deepest Hell is wrong with you?"
msgstr "세상에! 도대체 뭐가 문제였던 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Player
#. NodeID = 88afdfc0-0941-9f34-bf72-2769bac8c7e8
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Dexterity
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:88afdfc0-0941-9f34-bf72-2769bac8c7e8
msgctxt "h5c58141ag52fbg4599gb6d7g192c1cfed0a8"
msgid "<i>Kick her.</i>"
msgstr "<i>발로 찬다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Narrator
#. NodeID = 89c8e301-9f6a-41a7-e9c5-bbbf513d3589
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_DarkUrge_State_KilledSquirrel = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:89c8e301-9f6a-41a7-e9c5-bbbf513d3589
msgctxt "h16fb181ag8425g4a0eg9b7eg7cd1b6fdcd63"
msgid "*It would be ever so twee if it were climbing a tree!*"
msgstr "*만약 이 녀석이 나무까지 탄다면 정말로 사랑스럽겠죠!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Player
#. NodeID = 8e92e37e-8a94-cea5-f7a4-02b3a97ced7c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:8e92e37e-8a94-cea5-f7a4-02b3a97ced7c
msgctxt "hd0153e4dg968fg49aega1eegf67b4269ab65"
msgid "My body moved without my command... I couldn't control it."
msgstr "몸이 제멋대로 움직였어... 통제할 수 없었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Narrator
#. NodeID = 90a4f55d-e448-4bb1-a170-f349b1a0ca74
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_State_SavedAnimal = False
#.      - ORI_Shadowheart_State_IncurableWound_Unavailable = False
#.      - GLO_Not_For_EA = True
#.   Tag:
#.      - AVATAR(1) = True
#.      - REALLY_SHADOWHEART(1) = True
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_State_SavedAnimal = True
#.     - ORI_Shadowheart_Event_IncurableWoundFlared = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:90a4f55d-e448-4bb1-a170-f349b1a0ca74
msgctxt "h19b77988g7c83g463cg956agdf96c1bb9111"
msgid ""
"*Intense pain flares from the wound on your hand. A strange, half-familiar "
"image comes to you: a dead mouse, seen through a veil of tears. The image "
"fades.*"
msgstr ""
"*당신의 손에 난 상처에서 강렬한 고통이 터져 나옵니다. 이상하지만 반쯤 친숙한 장면이 떠오릅니다. 눈물의 장막 너머로 죽은 쥐가 "
"보입니다. 장면은 곧 희미해집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Narrator
#. NodeID = 91dbab86-8466-f94e-5350-85573cecff11
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:91dbab86-8466-f94e-5350-85573cecff11
msgctxt "ha6398f70g24e8g4e3cgb2a2gfe59ef7d12dc"
msgid "*The squirrel lunges at your foot and bites it.*"
msgstr "*다람쥐가 당신에게 달려들어 발을 깨뭅니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Timber
#. NodeID = 91e5a078-1ddd-cf3d-7636-5b1c75c45b70
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:91e5a078-1ddd-cf3d-7636-5b1c75c45b70
msgctxt "h9e0cfc00g0ccag4ac4ga435g39040234f7b1"
msgid ""
"How about this - you can stay if you keep those ugly feet on the ground."
msgstr "이건 어때 - 그 못생긴 발을 땅에 딛고만 있으면 여기서 머무르게 해 주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Player
#. NodeID = 95fcc733-ba2c-6d8b-f2e6-0a72f700793f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:95fcc733-ba2c-6d8b-f2e6-0a72f700793f
msgctxt "h92f40de5ge78dg4f56gb11dg04bf9a720573"
msgid "It's horrible! I'm horrible!"
msgstr "소름 끼치는군! 나는 대체!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Narrator
#. NodeID = 9776f751-b5bf-f821-d159-8bce7839ace3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_General_Squirrel_LearnedTerritory(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_General_Squirrel_PCPunchedSquirrel(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:9776f751-b5bf-f821-d159-8bce7839ace3
msgctxt "h6b6e0ed8g7a34g408dgbe80g7ef7991b23d4"
msgid ""
"*You claim victory over the squirrel, though you're not sure why you were "
"fighting to begin with.*"
msgstr "*다람쥐와의 혈전에서 승리를 쟁취했습니다. 어쩌다 싸우게 됐는지는 잘 모르겠지만 말이죠.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Narrator
#. NodeID = 97c74391-e5cc-4cfc-e07c-1802e8149aa6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:97c74391-e5cc-4cfc-e07c-1802e8149aa6
msgctxt "h6c7f828ag2f61g4df4gb8fcgfa77d41392dc"
msgid "*With a shriek, the squirrel flees.*"
msgstr "*날카로운 비명을 지르고는, 다람쥐가 도망쳐버립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Timber
#. NodeID = 9ca00378-135c-3e4f-33a5-3a0c316def67
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:9ca00378-135c-3e4f-33a5-3a0c316def67
msgctxt "h10f54407g6da8g454ega890g13f72311712a"
msgid "You don't scare me. I got bears on my side."
msgstr "난 네가 하나도 두렵지 않아. 내 곁에는 곰들이 있거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Shadowheart
#. NodeID = 9cd57736-92cc-4d05-9639-de24af6d2458
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(4) = True
#. SetFlags:
#.   Local:
#.     - cb9d5939-7bd4-2ed3-e7ec-63780fdda4d9_HadKickingInclusion = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:9cd57736-92cc-4d05-9639-de24af6d2458
msgctxt "h1747c217gf226g4dfagacb5g554361b6b5d9"
msgid ""
"How heroic. I was wondering if we'd survive encountering such a fearsome "
"beast."
msgstr "영웅적이기도 하셔라. 저런 무시무시한 야수한테서 우리가 살아남을 수 있을지 궁금했는데 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Narrator
#. NodeID = a0790c5f-eff4-f5f9-e3a7-efef317eafc0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_Squirrel_State_AnimalHandlingFailed(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:a0790c5f-eff4-f5f9-e3a7-efef317eafc0
msgctxt "he2969cc3gd824g4377gbccdg3ab67102fe16"
msgid ""
"*Her motivations elude you. Distracted by your thoughts, you let your guard "
"down.*"
msgstr "*녀석의 의도를 잡아내지 못했습니다. 당신은 생각에 정신이 팔린 나머지 경계를 소홀히 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Player
#. NodeID = a1f9b254-e476-8d22-f686-cc470bddf4a9
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:a1f9b254-e476-8d22-f686-cc470bddf4a9
msgctxt "h26f43f69gc223g48b4gb121gef983fc84614"
msgid "There's plenty of room for both of us."
msgstr "우리 둘 다 머물 공간은 충분히 있잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Player
#. NodeID = a40e1ce0-478f-0f4d-32cc-cf58f0f65e1e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:a40e1ce0-478f-0f4d-32cc-cf58f0f65e1e
msgctxt "h4161c76agdd4dg45e4g8f6bgaf4014683f32"
msgid "<i>Keep quiet.</i>"
msgstr "<i>침묵을 유지한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Narrator
#. NodeID = a4911269-e953-df5a-a12f-5d934e7901cd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:a4911269-e953-df5a-a12f-5d934e7901cd
msgctxt "he432e4b2gf512g414dgae66gef838640d65a"
msgid "*She studies you for a moment before twitching her ears. Compromise.*"
msgstr "*그녀가 당신을 잠시 바라보더니, 자기 귀를 잡아당깁니다. 타협을 선택한 것 같습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Narrator
#. NodeID = a75050be-202f-ba39-d54b-9ef694d40bf5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:a75050be-202f-ba39-d54b-9ef694d40bf5
msgctxt "hb116b65dg5790g4617gabebg00eb63798723"
msgid "*The squirrel chitters scornfully as your foot whistles over her head.*"
msgstr "*당신의 발이 허공을 가르자 다람쥐가 비웃듯 찍찍거립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Timber
#. NodeID = aa6fbded-2806-8c7b-2ace-8eb12fd3e05e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:aa6fbded-2806-8c7b-2ace-8eb12fd3e05e
msgctxt "ha5bca4a7g127dg46c7gaadfga4290a933a38"
msgid "No, there's plenty of room for <i>me</i>."
msgstr "아니, <i>날</i> 위한 공간뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Player
#. NodeID = aa91d750-bfbb-ac36-4793-efaf59835e92
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:aa91d750-bfbb-ac36-4793-efaf59835e92
msgctxt "h8a748c5egcc16g444bgae38g77d102a93c9d"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Narrator
#. NodeID = ae9f32a2-aec1-2dbe-f70b-a92eb5b65633
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:ae9f32a2-aec1-2dbe-f70b-a92eb5b65633
msgctxt "h5d87b245gd6acg4c89g9366g6e2b03fb56cc"
msgid "*The squirrel freezes, muscles tensed in alarm. She gets the message.*"
msgstr "*다람쥐가 얼어붙고, 녀석의 근육은 긴장감으로 곤두섭니다. 그녀는 메시지를 알아들은 것 같습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Player
#. NodeID = af170804-7129-f82e-33ad-2920ea869312
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:af170804-7129-f82e-33ad-2920ea869312
msgctxt "h17a25d46ge312g432bg8fccgf2f13b651d10"
msgid "What was that for?"
msgstr "뭐 때문에 그런 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Narrator
#. NodeID = af30fbf4-8f7c-5292-093d-32647bb753c1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_CampGeneral_Squirrel_PCFailedRawStrength_Punch(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:af30fbf4-8f7c-5292-093d-32647bb753c1
msgctxt "h2cfcdd25g13ebg49aegb15cg7f33b8e39583"
msgid "*The squirrel moves too quickly - your foot finds only air.*"
msgstr "*다람쥐가 너무 재빠릅니다. 당신의 발은 허공을 가릅니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Narrator
#. NodeID = af66ca4e-7e05-083c-1442-35b3e1e70a2a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:af66ca4e-7e05-083c-1442-35b3e1e70a2a
msgctxt "haef55652g5dd7g4258g8d34gd9c0638e699e"
msgid "*Tail rigid with irritation, she scampers off.*"
msgstr "*그녀는 짜증 난 듯 꼬리를 뻣뻣이 세우고는 도망칩니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Timber
#. NodeID = b00f07a6-fb3d-2097-fdeb-ad287d1e07e6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_General_Squirrel_MadeFriends(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:b00f07a6-fb3d-2097-fdeb-ad287d1e07e6
msgctxt "h254cb500gfe24g4c32gab26g9fca6e7a3f75"
msgid ""
"The trees are mine. Follow the rules, and I won't have to <i>intervene</i>. "
"Got it?"
msgstr "이 나무들은 내 거야. 내가 <i>끼어들</i> 일이 없게 규칙을 따르라고. 알아들었어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Player
#. NodeID = b0343387-ca2c-980d-03fa-e0a20f3402d3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:b0343387-ca2c-980d-03fa-e0a20f3402d3
msgctxt "h3a8a1de0ga67fg40a2ga884gf36031f5f775"
msgid "All right, you win. I'm leaving."
msgstr "알았어, 네가 이겼어. 떠날게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Timber
#. NodeID = b23130ab-772f-cb46-a016-a8b36ed097cc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Squirrel_HasMet(1) = True
#.      - DEN_General_Squirrel_MadeFriends(1) = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:b23130ab-772f-cb46-a016-a8b36ed097cc
msgctxt "hcb488068g6fa9g42d1g8fb3gd82288422cfd"
msgid "Remember our deal, now."
msgstr "우리 조건을 기억하라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Player
#. NodeID = b33c9bb6-6596-ee46-5f7e-8bee512e6717
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. TagRule: SORCERER or WARLOCK or WIZARD
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:b33c9bb6-6596-ee46-5f7e-8bee512e6717
msgctxt "hb4bbb8dbgca22g48b4g8292g6bdbd6610d75"
msgid "One word and I could fry you to a crisp."
msgstr "한마디만 더 하면 널 바싹하게 튀겨줄 수도 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Timber
#. NodeID = b3c5c43f-29b5-25ba-5431-791f471d9d30
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:b3c5c43f-29b5-25ba-5431-791f471d9d30
msgctxt "he4cd13d0ga65bg459dg8882g52b098cf55df"
msgid "You barged in without an invitation. I wouldn't call that friendly."
msgstr "초대장도 없이 쳐들어왔잖아. 그걸 친근하다고 부르진 않는데 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Gale
#. NodeID = b5145dbb-6b49-45db-9a01-7ce7ac7cbeb7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_GALE(7) = True
#. SetFlags:
#.   Local:
#.     - cb9d5939-7bd4-2ed3-e7ec-63780fdda4d9_HadKickingInclusion = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:b5145dbb-6b49-45db-9a01-7ce7ac7cbeb7
msgctxt "heb43c94ag963dg4371gb046gcb0444a2899f"
msgid ""
"Surely you should be reserving your foot for more deserving foes? That poor "
"creature was harmless!"
msgstr "더 가치있는 적을 위해 발을 좀 쉬게 뒀어야 하지 않았을까? 저 불쌍한 생물은 무해했어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Astarion
#. NodeID = b66be8f1-7e84-444f-b6b0-2a931eb9b880
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_ASTARION(3) = True
#. SetFlags:
#.   Local:
#.     - cb9d5939-7bd4-2ed3-e7ec-63780fdda4d9_HadKickingInclusion = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:b66be8f1-7e84-444f-b6b0-2a931eb9b880
msgctxt "h2599e2b8gc84eg4229g8f02ga48530f48a8f"
msgid "Do you always take on such terrifying foes?"
msgstr "너는 항상 그런 무서운 적들과 맞서는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Narrator
#. NodeID = b7ed999d-581a-9533-62fe-c76c8d03cd6b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:b7ed999d-581a-9533-62fe-c76c8d03cd6b
msgctxt "h0955f698g366eg41d2ga8a1g3b460fc86a0d"
msgid "*You cannot imagine what purpose such a creature could possibly serve.*"
msgstr "*이런 생명체가 어떤 목적을 지니고 있을지 감히 상상조차 할 수 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Player
#. NodeID = bd815301-87e4-81d0-2f78-e11d83df2f1c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - REALLY_BESTIAL(1) = False
#.      - HALFORC(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:bd815301-87e4-81d0-2f78-e11d83df2f1c
msgctxt "h4e7a83cdgdda2g483ag9906gf7b5eac266b5"
msgid "Get out of here. Now."
msgstr "당장 꺼져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Narrator
#. NodeID = caa4e99e-84e4-508d-3de2-ec0d345b308d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - NIGHT_DarkUrge_ButlerIntro = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:caa4e99e-84e4-508d-3de2-ec0d345b308d
msgctxt "h8caea02cg0595g492eg8d8bg1572fe6b6f24"
msgid "*Served and seasoned by that venomous Butler.*"
msgstr "*그 악랄한 집사에 의해 양념되고 또 제공된 것이죠.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Narrator
#. NodeID = cb77333d-aa68-690f-f0dc-46e36c140f66
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_CampGeneral_Squirrel_PCFailedRawStrength_Punch(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:cb77333d-aa68-690f-f0dc-46e36c140f66
msgctxt "hf889ec6bgf3e1g4930gaca0g72b48021a56e"
msgid "*With a cocky flick of her tail, the squirrel scampers away.*"
msgstr "*우쭐대듯 꼬리를 흔들고는, 다람쥐가 총총거리며 사라집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Timber
#. NodeID = cbcde8d3-b491-9c22-4902-829f36593eb9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_General_Squirrel_LearnedTerritory(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:cbcde8d3-b491-9c22-4902-829f36593eb9
msgctxt "h9ea4cd97g2eeeg4153g91aagbdfdce22ae1d"
msgid "See, you're in <i>my</i> territory. And I want you gone."
msgstr "이봐, 넌 지금 <i>내</i> 영토 안에 있다고. 네가 떠나줬으면 좋겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Player
#. NodeID = cd663e08-6c1f-e218-8c75-79eea52e8798
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:cd663e08-6c1f-e218-8c75-79eea52e8798
msgctxt "he999c94eg2883g4dd0gb92bge4c80b6d5fdb"
msgid ""
"Let me pass, or I'll spread word about this wonderful patch of land ripe for "
"the taking."
msgstr "지나가게 해주지 않으면, 이 비옥한 땅이 수확을 위해 무르익었다는 소문을 퍼뜨리겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Player
#. NodeID = cf2dd364-2909-29a7-ad8e-c4d39c378463
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:cf2dd364-2909-29a7-ad8e-c4d39c378463
msgctxt "h35063cadg2a53g49e6g8c07gd714d3f3f78c"
msgid "Let's start over. Friends?"
msgstr "다시 해보자고. 친구?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Narrator
#. NodeID = d04f144e-e00e-44ea-e2ce-781a7128b991
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:d04f144e-e00e-44ea-e2ce-781a7128b991
msgctxt "hbfa2bc08g2c40g48e0gbba7gefcb83641b12"
msgid "*The squirrel bites your foot again.*"
msgstr "*다람쥐가 다시 당신의 발을 뭅니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Narrator
#. NodeID = d1280998-e726-9ebe-b3ae-33adbfff41d1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:d1280998-e726-9ebe-b3ae-33adbfff41d1
msgctxt "h3e913aefgeefdg4d0eg93b8g1c0a9bfca0fd"
msgid ""
"*You stare at the body before you. You have no idea what just happened.*"
msgstr "*당신은 눈 앞에 놓인 사체를 바라봅니다. 방금 무슨 일이 벌어진 건지 도무지 이해할 수가 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Shadowheart
#. NodeID = d462597a-8a9e-4884-81dd-fd9b2d65a439
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_State_SavedAnimal = False
#.      - ORI_Shadowheart_State_IncurableWound_Unavailable = False
#.      - GLO_Not_For_EA = True
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_State_SavedAnimal = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:d462597a-8a9e-4884-81dd-fd9b2d65a439
msgctxt "he26d01c7g4daag4c09gb7cbge5758bce9e74"
msgid "<i>Ngh</i>... it hurts..."
msgstr "<i>으</i>...아파..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Player
#. NodeID = dc07a2ee-d960-0b75-1663-dc33470e480a
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Dexterity
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:dc07a2ee-d960-0b75-1663-dc33470e480a
msgctxt "he86f7b87gbc74g411fg878fgcdb72c845f3b"
msgid "<i>Try to kick her again.</i>"
msgstr "<i>그녀에게 다시 발길질을 한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Narrator
#. NodeID = de173ff4-77fb-d4ae-2208-5328673c6ab9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:de173ff4-77fb-d4ae-2208-5328673c6ab9
msgctxt "he520f456gf530g4216gb5dcg12f6c25d6887"
msgid "*This also misses.*"
msgstr "*다시 한번 빗맞습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Player
#. NodeID = e1b895ed-debb-0eb1-95db-b0f2eb4bb9fa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:e1b895ed-debb-0eb1-95db-b0f2eb4bb9fa
msgctxt "h62ac8c8eg4be2g4d31gad55g71daa066aedf"
msgid "<i>Take heart: your instincts are dagger-sharp!</i>"
msgstr "<i>용기를 가지십시오. 당신의 본능은 단검처럼 날카로웠습니다!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Timber
#. NodeID = e45b95cc-f1a2-6a84-7d31-2dbbb7f17c2b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:e45b95cc-f1a2-6a84-7d31-2dbbb7f17c2b
msgctxt "h9570581ag5fb0g4452g97dcgf9b254d0c1c2"
msgid "You'd have to catch me first. Can't say I'm worried."
msgstr "날 먼저 붙잡아야 할 거야. 딱히 걱정이 되진 않는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Narrator
#. NodeID = e53ff306-ba48-8513-8aa2-6b585f4213f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:e53ff306-ba48-8513-8aa2-6b585f4213f3
msgctxt "h284d4a60gfe02g422ag8a81g0848c95ae43c"
msgid "*She chatters back, louder and at length.*"
msgstr "*그녀가 큰 소리로 더 길게 조잘댑니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Player
#. NodeID = ea876124-28af-44a3-8c9d-1b40b8d59b60
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:ea876124-28af-44a3-8c9d-1b40b8d59b60
msgctxt "h4e060d44g5121g4247g99e0g77f8679ec883"
msgid "<i>Silently petition Lady Shar for guidance.</i>"
msgstr "<i>조용히 샤 여신의 인도를 청원한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Player
#. NodeID = ec3eb76c-30dd-5a6a-18b4-ce6807487c3a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:ec3eb76c-30dd-5a6a-18b4-ce6807487c3a
msgctxt "he78e90afgddf5g4f79g9068gee7f609dc656"
msgid "It came right at me!"
msgstr "저쪽에서 다가온 거야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Timber
#. NodeID = ed9cf49a-6df7-abc3-e4f3-56aa042e377c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:ed9cf49a-6df7-abc3-e4f3-56aa042e377c
msgctxt "h6fee03ebg8e9dg472bg9f6fg963dd6ba6728"
msgid "Not even close. To think I took you for a threat."
msgstr "어림도 없지. 내가 널 위협이라고 받아들였다고 생각하지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Astarion
#. NodeID = f22801ef-6d3f-9014-6321-9e267d2ebf38
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:f22801ef-6d3f-9014-6321-9e267d2ebf38
msgctxt "h9f6af5f4g39cbg44c6gaa13g959e4e0fed28"
msgid "No! What did you do?!"
msgstr "안 돼! 무슨 짓을 한 거야?!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Narrator
#. NodeID = f33242a5-f50a-e58b-9268-81f2b3ec76ab
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_General_Squirrel_LearnedTerritory(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_General_Squirrel_PCPunchedSquirrel(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:f33242a5-f50a-e58b-9268-81f2b3ec76ab
msgctxt "h17dac5c9g6e3dg481cgbbb0g6378c99d0dfd"
msgid ""
"*It seems you've claimed the squirrel's territory by right of conquest.*"
msgstr "*당신이 다람쥐의 영역을 차지한 것 같습니다. 정복자의 권리죠.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Player
#. NodeID = f589feb7-aae5-77e5-b475-7a2ad3cb7d75
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = False
#. TagRule: REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:f589feb7-aae5-77e5-b475-7a2ad3cb7d75
msgctxt "h6e7f2f85g6cbag4614g9c71gc67b973d64a7"
msgid "I'm not to be trifled with, creature."
msgstr "날 무시하지 마라, 생물."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Player
#. NodeID = f589feb7-aae5-77e5-b475-7a2ad3cb7d75
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:f589feb7-aae5-77e5-b475-7a2ad3cb7d75
msgctxt "hed4ebe9cg8a50g48fdg9734g0a72c3cecb47"
msgid "Back off, squirrel. Or I'll make you."
msgstr "물러서라, 다람쥐. 아니면 강제로 물러나게 해줄 테니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Narrator
#. NodeID = f8904456-7245-eada-314d-d4fbc27da4f1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - cb9d5939-7bd4-2ed3-e7ec-63780fdda4d9_AnimalHandlingSuccess = True
#. SetFlags:
#.   Dialog:
#.     - DEN_CampGeneral_Squirrel_PCFailedRawStrength_Punch(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:f8904456-7245-eada-314d-d4fbc27da4f1
msgctxt "hfa562e28g2d48g4c42gb07cg78048fe22173"
msgid "*The squirrel bounds away, chittering wildly.*"
msgstr "*끊임없이 재잘거리며, 다람쥐가 떠나갑니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Narrator
#. NodeID = f918c494-03e1-8b93-841d-58a365899229
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Squirrel_HasMet(1) = True
#.      - DEN_General_Squirrel_MadeFriends(1) = True
#.   Local:
#.      - cb9d5939-7bd4-2ed3-e7ec-63780fdda4d9_AnimalHandlingSuccess = True
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:f918c494-03e1-8b93-841d-58a365899229
msgctxt "h1aeb7d1bg1653g4103gb4f6gc347f2658d05"
msgid "*The squirrel's tail twitches in a lukewarm salute.*"
msgstr "*다람쥐가 꼬리를 씰룩거리며 미지근한 인사를 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Player
#. NodeID = f9d03ef8-4799-2037-5ad5-988cd6ff277c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:f9d03ef8-4799-2037-5ad5-988cd6ff277c
msgctxt "hb1e9da30gf0c0g4826gab0bga8655b3d0801"
msgid "What sort of creature are you?"
msgstr "넌 뭐 하는 생명체야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel
#. Speaker = Narrator
#. NodeID = fc52e8c5-0408-28a4-b267-7077bd197e9b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Squirrel:fc52e8c5-0408-28a4-b267-7077bd197e9b
msgctxt "heb770dcbg6b31g4af8g829ega58f16a30782"
msgid ""
"*Before you can think twice, your lustful body speaks its profane language.*"
msgstr "*다시 생각하기도 전에 당신의 탐욕스러운 몸이 불경스러운 말을 건넵니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Tiefling001
#. Speaker = Rikka
#. NodeID = 0100d797-fdad-989b-1a81-c084a92947a2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Tiefling001:0100d797-fdad-989b-1a81-c084a92947a2
msgctxt "h9191e8a9g5dcag4145gab2ag5f484b5c5fb9"
msgid ""
"I don't know if I <i>want </i>that. But... if that's how I get through "
"this..."
msgstr "그게 내가 <i>원하는</i> 바일지 모르겠는데. 하지만... 이 일을 견뎌낼 방법이 그뿐이라면..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Tiefling001
#. Speaker = Rikka
#. NodeID = 01a11abb-546b-257d-8903-2eb58ad5f189
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Tiefling001:01a11abb-546b-257d-8903-2eb58ad5f189
msgctxt "hf26c26e8g4983g43bcgaed9g06764efb95c4"
msgid "I'm sorry, I just... the goblins, the killing - it scares me."
msgstr "미안. 난 그냥... 고블린, 살육... 그런 게 두려워서 그래."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Tiefling001
#. Speaker = Player
#. NodeID = 1b9f4d09-0b7e-8630-dd18-65c2b7e12a49
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Tiefling001:1b9f4d09-0b7e-8630-dd18-65c2b7e12a49
msgctxt "h2eafa069g95afg4e52gb59eg38c34d182582"
msgid ""
"Just embrace it - the adrenaline, the excitement, the <i>power</i>. It makes "
"you stronger."
msgstr "그냥 받아들여. 그 아드레날린, 흥분, 그리고 <i>힘</i>을. 그게 널 강하게 만들어 줄 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Tiefling001
#. Speaker = Rikka
#. NodeID = 1bc3bf45-20ab-1b4c-c3b0-66e8d04ebc2c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Tiefling001:1bc3bf45-20ab-1b4c-c3b0-66e8d04ebc2c
msgctxt "hc5feba07g7412g4325gbd44g212b1da09199"
msgid "I - I guess it's better that way."
msgstr "모... 못하는 게 약일 수도 있겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Tiefling001
#. Speaker = Rikka
#. NodeID = 21af6e79-d8e5-54d5-db43-f553b71ce57d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Tiefling001:21af6e79-d8e5-54d5-db43-f553b71ce57d
msgctxt "h9ca087bfgc619g42ddga574g9b3d1b64cb8d"
msgid "That's what Zevlor said, too. I hope you're right."
msgstr "제블로어도 그렇게 말하더라. 그쪽 말대로라면 좋겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Tiefling001
#. Speaker = Rikka
#. NodeID = 28a95ea3-c350-0e11-0cc0-0d89192a108a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Tiefling001:28a95ea3-c350-0e11-0cc0-0d89192a108a
msgctxt "hb1e30804g5dfbg451ag9832g73b8d900c044"
msgid ""
"I <i>want </i>to help - I just didn't think it would <i>feel </i>like this."
msgstr "나도 도움은 되고 <i>싶어</i>. 다만 이런 <i>느낌</i>일 거라곤 생각지도 못했지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Tiefling001
#. Speaker = Rikka
#. NodeID = 405f77fa-71f0-5c66-304d-3edb12e13361
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_General_State_KanonCorpseClear = True
#.      - DEN_General_State_KanonTryBurial = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Tiefling001:405f77fa-71f0-5c66-304d-3edb12e13361
msgctxt "h91f5eacfgd50bg4fb7gb115g47d3996e3da0"
msgid "Not now. Please."
msgstr "나중에 얘기해. 부탁이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Tiefling001
#. Speaker = Player
#. NodeID = 41d3df47-154d-bf9a-e88c-99735d645375
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Tiefling001:41d3df47-154d-bf9a-e88c-99735d645375
msgctxt "h722378e0ge581g4deaga71cg989ebb27ff7c"
msgid "Wish I'd seen that. It's boring when they just drop dead."
msgstr "나도 봤다면 좋았을 텐데. 바로 죽어버리는 건 시시하거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Tiefling001
#. Speaker = Player
#. NodeID = 46ae79af-7fe4-fc39-e17b-528907d14f26
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Tiefling001:46ae79af-7fe4-fc39-e17b-528907d14f26
msgctxt "h52bae926gd6e3g4beeg9ffdgfbd0895c0ce5"
msgid "I find no pleasure in killing, only regret."
msgstr "난 살육 따위 즐기지 않아. 회한만 들지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Tiefling001
#. Speaker = Rikka
#. NodeID = 5ef62935-ce58-b62a-6e45-195f405eb45c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Tiefling001:5ef62935-ce58-b62a-6e45-195f405eb45c
msgctxt "h136fa918gc4dcg4b63gb1c2g1ce9ecd89298"
msgid "I had the same thought. And it's just going to keep happening..."
msgstr "나도 그렇게 생각해. 앞으로도 그런 일은 계속 생길 테고 말이지..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Tiefling001
#. Speaker = Rikka
#. NodeID = 7b2a5368-27d4-2cdd-7979-7d5f4464fd8d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_General_Tiefling001_HasMet(1) = True
#. TagRule: LOLTHDROWELF
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Tiefling001:7b2a5368-27d4-2cdd-7979-7d5f4464fd8d
msgctxt "hc8f4a344g3801g4082g909bg3966ad52a94c"
msgid ""
"How do you drow do that - find pleasure in killing? I got a goblin myself, "
"yesterday. Shot her through the throat."
msgstr "당신들 드로우는 어떻게 그래? 살육을 즐기는 거 말이야. 나도 어제 직접 고블린 하나 죽였어. 그년의 목을 꿰뚫어 버렸지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Tiefling001
#. Speaker = Player
#. NodeID = 83734ab9-5654-6ab6-1684-93604b0854f2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Tiefling001:83734ab9-5654-6ab6-1684-93604b0854f2
msgctxt "hbcfcf8cagb957g4dffg92b5gf847202e7bbb"
msgid "Your first kill? Don't worry - it gets easier."
msgstr "첫 살인이었어? 걱정 마. 차츰 익숙해질 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Tiefling001
#. Speaker = Rikka
#. NodeID = 9190413d-6be3-a105-1ee2-14efed6327dd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Tiefling001:9190413d-6be3-a105-1ee2-14efed6327dd
msgctxt "h00e21511g1a16g4c93g9c88g01e5d9ec9a37"
msgid ""
"That should've killed her, but... she kept <i>gasping</i>. Clawing at the "
"arrow."
msgstr "바로 죽을 줄 알았는데... 계속 숨을 헐떡대더라고. 박힌 화살을 긁어대면서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Tiefling001
#. Speaker = Rikka
#. NodeID = ab41a845-297a-2c01-67fc-0e1dcad92424
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_General_Tiefling001_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Tiefling001:ab41a845-297a-2c01-67fc-0e1dcad92424
msgctxt "h33f58bd5g7c95g4163ga3b7g1c5725fdb016"
msgid "You made it look so easy, the killing."
msgstr "참 손쉽다는 듯이 적을 죽여대던걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Tiefling001
#. Speaker = Player
#. NodeID = b11b8009-30be-51a2-9d89-e2f5407f9e65
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Tiefling001:b11b8009-30be-51a2-9d89-e2f5407f9e65
msgctxt "h8e09a0e1gf11dg4275ga16dge2956103eacc"
msgid "It's a refined taste - someone like you would never understand."
msgstr "살육은 아주 세련된 기호지. 너 같은 자들은 절대 이해하지 못할걸?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Tiefling001
#. Speaker = Rikka
#. NodeID = bdb3ae6f-1bd5-0be9-ad64-8ee3b7718db9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Tiefling001:bdb3ae6f-1bd5-0be9-ad64-8ee3b7718db9
msgctxt "h6b59457dg4e4ag49f7gbe8bg242660f8386f"
msgid "Why? It was terrible. I should've just looked away."
msgstr "왜? 그건 끔찍했다고. 차라리 보지 말 걸 그랬단 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Tiefling001
#. Speaker = Player
#. NodeID = bf7f3c36-8c37-2df1-dc8f-ca0965d92f01
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Tiefling001:bf7f3c36-8c37-2df1-dc8f-ca0965d92f01
msgctxt "hfb2bf413gd199g468ega6cagd137c93859c1"
msgid "We don't all enjoy killing - I just do what I must."
msgstr "우리라고 다 살육을 즐기진 않아. 난 필요한 경우에만 죽여."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Tiefling001
#. Speaker = Rikka
#. NodeID = c5c5ec26-6cb0-5e03-5586-609649af7116
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_General_Tiefling001_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Tiefling001:c5c5ec26-6cb0-5e03-5586-609649af7116
msgctxt "h03ebb8ccg4b49g453dg9cafg8194804a97b4"
msgid ""
"Glad you were here for those goblins. Picked one off yesterday, myself. Shot "
"her through the throat."
msgstr "고블린 상대할 때 도와줘서 고마워. 나도 어제 직접 한 녀석 해치웠지. 그년의 목을 꿰뚫어 버렸어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Tiefling001
#. Speaker = Player
#. NodeID = e638f0a7-2043-951f-b4d7-81f86ced377a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Tiefling001:e638f0a7-2043-951f-b4d7-81f86ced377a
msgctxt "hef3777c7g7ed4g455agb4c6g56b8db969d2b"
msgid ""
"Taking life always has a cost. You have to feel it, or you'll lose who you "
"are."
msgstr "생명을 앗는 건 대가가 따르는 법이야. 그걸 인식해야 돼. 안 그럼 본래의 자신을 잃고 말아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Tiefling001
#. Speaker = Rikka
#. NodeID = ee89a77b-54a5-cf73-f8b3-b7fc24687d89
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Tiefling001:ee89a77b-54a5-cf73-f8b3-b7fc24687d89
msgctxt "h8480a045g4587g4cb7g8fd7g22755b0318ea"
msgid ""
"So even someone like you... feels like this? This is how it is? And it's "
"just going to keep happening..."
msgstr "그러니까 당신네들도... 그리 느낀다고? 원래 이런 느낌인 거야? 앞으로도 이런 일은 계속 생길 텐데..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Tiefling001
#. Speaker = Rikka
#. NodeID = f4d7275d-2474-7b2d-6bfa-7bc93b9809b5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Refugees_State_LeadersAreDead = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_Tiefling001:f4d7275d-2474-7b2d-6bfa-7bc93b9809b5
msgctxt "hc2393ab9gea3ag429fg9433g84da2f486cd2"
msgid "You killed all those goblins, and we couldn't even manage a handful..."
msgstr "고블린들을 죄다 해치워버렸네. 우린 겨우 몇 놈도 감당 못했는데..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10
#. Speaker = Player
#. NodeID = 056f0c23-6d67-607d-9d0c-f0600556739c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10:056f0c23-6d67-607d-9d0c-f0600556739c
msgctxt "hbb6e4607g3d54g446cgbc62g27eeaec7de8b"
msgid "With trained worgs on your scent? Not likely."
msgstr "훈련된 워그들한테 쫓기면서? 글쎄."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10
#. Speaker = Lakrissa
#. NodeID = 05b048c6-aabc-574d-8a98-402b7739e0d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10:05b048c6-aabc-574d-8a98-402b7739e0d4
msgctxt "haf55df39ge8eeg4584g93c1g9223b13407bd"
msgid ""
"I've seen what the goblins can do to a vulnerable caravan, so I'm not as "
"confident."
msgstr "고블린들이 취약한 상단에 무슨 짓을 할 수 있는지 봐서 그럴 자신이 없는걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10
#. Speaker = Player
#. NodeID = 1d5f1515-fd80-acbe-053f-d76fa983b4c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10:1d5f1515-fd80-acbe-053f-d76fa983b4c9
msgctxt "h4458ec1dgceafg4dbbg8057g1403b934acef"
msgid "No, I won't waste my time."
msgstr "싫어, 시간 낭비는 안 하겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10
#. Speaker = Lakrissa
#. NodeID = 205615b9-0235-3911-0844-5cdc8f0d8ca9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   User:
#.     - DEN_General_TieflingGuard10_MadeBet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10:205615b9-0235-3911-0844-5cdc8f0d8ca9
msgctxt "h3ac1eb65g9991g49fegb2b5g3da88113dfd7"
msgid ""
"Excellent! And since I ain't one to leave a debt unpaid, that means we're "
"destined to meet in Baldur's Gate."
msgstr "훌륭해! 말해 두는데, 난 빚지고 못 사는 성격이라고. 우린 발더스 게이트에서 다시 만날 운명인 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10
#. Speaker = Lakrissa
#. NodeID = 2449c8ae-8c58-72b1-fb68-ed0daab30fd7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10:2449c8ae-8c58-72b1-fb68-ed0daab30fd7
msgctxt "h663bbc34g2ad3g49c7gbe0ag9e77cee8e58d"
msgid "Even if the light is just as bleak as everything else, and..."
msgstr "그 빛조차도 캄캄하다고 해도, 적어도..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10
#. Speaker = Lakrissa
#. NodeID = 2bc09930-a047-2056-0b14-6df7491e8061
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10:2bc09930-a047-2056-0b14-6df7491e8061
msgctxt "h5aa8bcc5g02feg4f23gbabfg9bc97d6df76f"
msgid "...you know what? Never mind. It wasn't that funny."
msgstr "...그거 알아? 아니다 됐어. 별로 재밌는 것도 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10
#. Speaker = Player
#. NodeID = 2dbe814d-29ae-e5c7-a646-7b34e991a455
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_CheckPocketGold = True
#. SetFlags:
#.   Object:
#.     - GEN_TransferNPCPayment(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10:2dbe814d-29ae-e5c7-a646-7b34e991a455
msgctxt "h2978951cg56a9g45bdgac35g33543a40a1b5"
msgid ""
"Sure, it's a bet. ([GEN_CheckMagicPocketGold_6057ad05-9492-4630-9f0a-"
"be548b134c54])"
msgstr ""
"좋아, 여기. ([GEN_CheckMagicPocketGold_6057ad05-9492-4630-9f0a-be548b134c54])"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10
#. Speaker = Player
#. NodeID = 2f43a570-e359-3f23-88de-9c8641310dc8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10:2f43a570-e359-3f23-88de-9c8641310dc8
msgctxt "h588a3589gbd85g456bgad55g597c68516e3e"
msgid "How are you going to take my gold if you're dead?"
msgstr "그러다 죽으면 금화는 어떻게 가져갈 건데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10
#. Speaker = Player
#. NodeID = 36c8d48d-b995-b34d-9f44-fa77f8e1732d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10:36c8d48d-b995-b34d-9f44-fa77f8e1732d
msgctxt "he0b6c9ccgf0feg45b9ga368ge23104f94d20"
msgid "It is not funny."
msgstr "재미 없는 농담이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10
#. Speaker = Lakrissa
#. NodeID = 38c56d97-34e3-73bc-461d-4206dff392f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10:38c56d97-34e3-73bc-461d-4206dff392f5
msgctxt "h21503230g68d2g4850gb1b9ga0bfd18681db"
msgid "Thanks for your helpful feedback, but I think we're done here."
msgstr "유용한 조언은 고맙지만, 우린 이제 끝인 것 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10
#. Speaker = Lakrissa
#. NodeID = 3a18350a-d811-6284-abea-458de57908a9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_CaveGuard_002_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10:3a18350a-d811-6284-abea-458de57908a9
msgctxt "h1d08262dg765cg4839g86d0gb114ae07f099"
msgid "We need to move. No point staying here - twiddling our thumbs."
msgstr "어서 움직여야 해. 여기 가만히 앉아 기다리고만 있을 순 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10
#. Speaker = Lakrissa
#. NodeID = 3d08e8f2-e842-f23a-0569-1b2627201012
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10:3d08e8f2-e842-f23a-0569-1b2627201012
msgctxt "hd3fa1de1gb3f7g48f8gb30eg69efa6cc685a"
msgid "Come on. What do you say?"
msgstr "말해 봐. 어때?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10
#. Speaker = Player
#. NodeID = 4506de8c-db60-ed86-5cd3-fac99ca39e6d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10:4506de8c-db60-ed86-5cd3-fac99ca39e6d
msgctxt "h5a115ba8g6ee5g415fga02egaef8fa46cf49"
msgid "If you survived the Hells, you'll survive this."
msgstr "지옥에서 살아돌아왔다면, 이 정도도 살아남을 수 있을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10
#. Speaker = Player
#. NodeID = 47226b16-17c8-a876-bf0e-f1a95749bb0d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10:47226b16-17c8-a876-bf0e-f1a95749bb0d
msgctxt "h030f54e2g7075g49b4ga910gfa830252d258"
msgid "Try not to keel over with the first blade drawn."
msgstr "첫 방에 속수무책으로 쓰러지지 않도록 조심해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10
#. Speaker = Player
#. NodeID = 4bfc9a31-8a44-e28f-6587-abd65ad66fb7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10:4bfc9a31-8a44-e28f-6587-abd65ad66fb7
msgctxt "h789da3f9gcc62g4094gbd16g052076af435d"
msgid "A defeat is a defeat. There is no glory in that."
msgstr "패배는 패배야. 거기에 영광 따윈 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10
#. Speaker = Player
#. NodeID = 4dc2cbbc-6c4c-75c8-30ea-b3c614bec8e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10:4dc2cbbc-6c4c-75c8-30ea-b3c614bec8e6
msgctxt "h229baa63g3eb5g4fbcg909dgdf2e72674486"
msgid "Not with that attitude. Fight and win!"
msgstr "그런 태도로는 안 돼. 싸워서 이겨야지!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10
#. Speaker = Lakrissa
#. NodeID = 57541c08-9372-59e0-4d14-1488fc8e34a1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10:57541c08-9372-59e0-4d14-1488fc8e34a1
msgctxt "h22091e5cgfd10g41e7gbba7g6ebc5cfb2df7"
msgid "No, I - it's a joke."
msgstr "그게 아니라, 그냥 농담이었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10
#. Speaker = Lakrissa
#. NodeID = 5b71b122-5e7c-98d1-0da7-eab8ea3e71e5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10:5b71b122-5e7c-98d1-0da7-eab8ea3e71e5
msgctxt "h4e4f8a53g3b62g4e04gbc62g75b4df6cb1b7"
msgid "But if you're so sure we will, why not put a little gold on the line?"
msgstr "정말로 우리가 살아남을 거라고 생각한다면 돈이라도 걸어보지 않겠어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10
#. Speaker = Lakrissa
#. NodeID = 64850ffd-6bf2-49db-369a-6f21ee685c83
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10:64850ffd-6bf2-49db-369a-6f21ee685c83
msgctxt "h6b2695c3g8ee5g41ceg8b02g5150123fc72f"
msgid "Thanks. You're all right."
msgstr "고마워. 너도 괜찮아 보이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10
#. Speaker = Player
#. NodeID = 64f89c92-3328-6bff-8435-798d44123636
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10:64f89c92-3328-6bff-8435-798d44123636
msgctxt "hcd1ecd76gadbag441aga9cag6dd2dd339e87"
msgid "Oh, I see. Quite amusing."
msgstr "아, 그렇군. 꽤 재밌네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10
#. Speaker = Lakrissa
#. NodeID = 6d1c639c-f57a-0576-4324-4f2dc49670f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10:6d1c639c-f57a-0576-4324-4f2dc49670f1
msgctxt "h3b97d738g2908g4d17g83dagd0ee4aa227bd"
msgid ""
"Plenty of us fell to monsters already. I don't see the rest of us lasting "
"long out there."
msgstr "이미 많은 수가 괴물에게 쓰러졌어. 남은 이들도 저 밖에서 오래 버틸 수는 없을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10
#. Speaker = Player
#. NodeID = 6fa9a7db-f472-f39d-b76f-25d9ec0faa4b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10:6fa9a7db-f472-f39d-b76f-25d9ec0faa4b
msgctxt "h88d49256g0f5fg4d8fg9f65gd1f2d7e3ac56"
msgid "I'm not the wagering type."
msgstr "도박엔 관심 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10
#. Speaker = Player
#. NodeID = 78ad7d76-d606-2147-fed3-11dde246ef9d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_CheckPocketGold = True
#. SetFlags:
#.   Object:
#.     - GEN_TransferNPCPayment(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10:78ad7d76-d606-2147-fed3-11dde246ef9d
msgctxt "ha050202ag23bcg493dg823fg215a90dc69a9"
msgid ""
"All right, you're on. ([GEN_CheckMagicPocketGold_6057ad05-9492-4630-9f0a-"
"be548b134c54])"
msgstr ""
"좋아, 이거 받아. ([GEN_CheckMagicPocketGold_6057ad05-9492-4630-9f0a-be548b134c54])"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10
#. Speaker = Lakrissa
#. NodeID = 7abcfb14-24c3-5f58-fd43-61d0679d3dee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10:7abcfb14-24c3-5f58-fd43-61d0679d3dee
msgctxt "ha163ba09ge592g4b03g9f45gfbec59f61775"
msgid "Who knows, some of us might even make it to Baldur's Gate."
msgstr "누가 알겠어? 우리 중 일부는 발더스 게이트에 도착할지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10
#. Speaker = Player
#. NodeID = 8214008c-6cdc-02dc-35df-f99402b951dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10:8214008c-6cdc-02dc-35df-f99402b951dc
msgctxt "haab3f9fdgc94fg4de2gb01ag7078f1ffcb26"
msgid "You have an odd sense of humour. This isn't really funny."
msgstr "유머 감각이 이상하네. 전혀 재미있지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10
#. Speaker = Lakrissa
#. NodeID = 886127df-8721-cee4-09f8-69fba890bbc3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10:886127df-8721-cee4-09f8-69fba890bbc3
msgctxt "hac23709cgd7cfg4470ga76dgcce91b0bf328"
msgid "After seeing you at the gate, I'm sure you'll last longer than us."
msgstr "관문에서의 활약상을 보고 나니, 그쪽이 우리보다 더 오래 버틸 거라는 확신이 들어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10
#. Speaker = Lakrissa
#. NodeID = 8ba8e03b-512c-4e77-096a-169cc121e598
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10:8ba8e03b-512c-4e77-096a-169cc121e598
msgctxt "hd6fbd7c1g2c5fg4f2cgaa74gfc3b97b9bf1c"
msgid "Be safe out there, whatever comes your way."
msgstr "바깥에서 무슨 일이 닥쳐도 안전하길."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10
#. Speaker = Lakrissa
#. NodeID = 8c2fabbc-5e23-026d-5eee-54fd74d58b69
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10:8c2fabbc-5e23-026d-5eee-54fd74d58b69
msgctxt "h44e4fab8g798ag4019ga2a9g5026a4f73fe8"
msgid "You are just a ray of sunshine, aren't you?"
msgstr "넌 한 줄기 햇살과도 같아, 그렇지 않아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10
#. Speaker = Lakrissa
#. NodeID = 8d5a0f8f-ba8b-7a6e-4174-c9b91a22f284
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10:8d5a0f8f-ba8b-7a6e-4174-c9b91a22f284
msgctxt "h47a3756fg067fg45c7g9fd2g25c595e1a509"
msgid "There's optimism and then there's stupid, hun."
msgstr "낙관적이지만 멍청한 면도 있네, 자기."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10
#. Speaker = Lakrissa
#. NodeID = 96da5c5f-46f5-3778-1a49-00be145626cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10:96da5c5f-46f5-3778-1a49-00be145626cf
msgctxt "h736e8e9eg123cg4270g8020g64bd66db7ee8"
msgid ""
"It's taking a really bleak situation and trying to find some light in it."
msgstr "그러니까 정말 암울한 상황 속에서도 한 줄기 빛을 찾아보잔 거지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10
#. Speaker = Lakrissa
#. NodeID = 9a7ccca7-2576-c818-ab1a-48d6b8ad01ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10:9a7ccca7-2576-c818-ab1a-48d6b8ad01ea
msgctxt "ha9e015ffg5f20g4945g9458g7ab528cb371c"
msgid "Well, we came through Avernus. We might not look it, but we're tough."
msgstr "저기, 우린 아베르누스에서도 살아남았거든. 이래 봬도 제법 강인하다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10
#. Speaker = Player
#. NodeID = a58f942e-f15e-5bf9-7df6-f70cafd632ab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10:a58f942e-f15e-5bf9-7df6-f70cafd632ab
msgctxt "h516a4227ge2d6g4f15gbc89g9cce5886b9d7"
msgid "Explain it."
msgstr "설명해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10
#. Speaker = Lakrissa
#. NodeID = ade3a8a8-2383-f7a0-f509-8557e62e6ba8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10:ade3a8a8-2383-f7a0-f509-8557e62e6ba8
msgctxt "h70916c77gc225g4b3fga5ddg423de08378b1"
msgid ""
"But if you are, why not put a little gold on the line? "
"([GEN_CheckMagicPocketGold_6057ad05-9492-4630-9f0a-be548b134c54])"
msgstr ""
"당신 말이야, 금화 좀 걸어보는 건 어때? ([GEN_CheckMagicPocketGold_6057ad05-9492-4630-9f0a-"
"be548b134c54])"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10
#. Speaker = Lakrissa
#. NodeID = b456f984-bdd8-1c85-5ef5-4f6b9c62ac42
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10:b456f984-bdd8-1c85-5ef5-4f6b9c62ac42
msgctxt "h96afeb5cg64cdg4a96g8b74gce4f525864a4"
msgid "No. No, I suppose it isn't."
msgstr "응. 맞아, 그런 것 같네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10
#. Speaker = Lakrissa
#. NodeID = bbe98247-b038-21e6-1ba6-82d6bcf520aa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10:bbe98247-b038-21e6-1ba6-82d6bcf520aa
msgctxt "hc3236ac4gba7eg4f62gaf4fg29fc2e35b5ba"
msgid "Looking forward to it."
msgstr "기대하고 있을게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10
#. Speaker = Player
#. NodeID = c97374f9-85b0-b891-03ac-c36a33c3f759
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10:c97374f9-85b0-b891-03ac-c36a33c3f759
msgctxt "h780d3df5g3e4dg45bdgbb2aga41dfa86796c"
msgid "Will you? I don't see many soldiers."
msgstr "그래? 병사가 많아 보이진 않는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10
#. Speaker = Player
#. NodeID = d22c3467-4c70-0e8e-9213-d54e926e28da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10:d22c3467-4c70-0e8e-9213-d54e926e28da
msgctxt "h7ea475c1gac06g4f54g8d1fg6dd74e14f9af"
msgid "Maybe you'll catch a glimpse of Baldur's Gate before they cut you down."
msgstr "어쩌면 그놈들이 너희를 베어넘기기 전에 발더스 게이트 모습을 엿볼 수는 있겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10
#. Speaker = Lakrissa
#. NodeID = d3c92b4c-96b9-1476-d653-5ccbd6c396ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10:d3c92b4c-96b9-1476-d653-5ccbd6c396ea
msgctxt "h2a05050bg17bcg49a1g9d8eg18d7453c3e38"
msgid "Ohh, well aren't you an optimist?"
msgstr "오, 낙관주의자였구나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10
#. Speaker = Lakrissa
#. NodeID = d6901565-350d-69ac-862c-be46f2a1e558
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_CaveGuard_002_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10:d6901565-350d-69ac-862c-be46f2a1e558
msgctxt "hb559e636g2bd9g4b65g90a5g246b631ff987"
msgid ""
"Used to think the goblins'd kill us the second we set foot outside. But "
"after hearing what you did at the gate..."
msgstr "밖으로 나가면 얼마 못 가 고블린에게 떼죽음 당할 거라 생각했어. 하지만 당신이 관문에서 활약한 걸 듣고 나니..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10
#. Speaker = Lakrissa
#. NodeID = d6b301ae-082c-e07c-4aed-87ef46b75a27
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_CaveGuard_002_HasMet(1) = True
#.   User:
#.      - DEN_General_TieflingGuard10_MadeBet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10:d6b301ae-082c-e07c-4aed-87ef46b75a27
msgctxt "h23550d2eg3ae5g4664g90bag765f4ec4a3fd"
msgid "I'd best see you in Baldur's Gate."
msgstr "꼭 살아서 발더스 게이트에서 보자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10
#. Speaker = Lakrissa
#. NodeID = d81c709b-59b4-178a-dee5-7f79bf3b273d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10:d81c709b-59b4-178a-dee5-7f79bf3b273d
msgctxt "he205c68ega4e9g4b1cg85f9g8c93c3b52c9a"
msgid "I'm sure you're good for it. Just leave the gold on my corpse."
msgstr "그럴 일 없게 하면 되잖아. 어쨌든 금화는 내 시체 위에 올려 둬."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10
#. Speaker = Lakrissa
#. NodeID = dcd257f0-642e-f829-175e-fa6a6a9f16a2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_General_TieflingGuard10_RefusedBet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10:dcd257f0-642e-f829-175e-fa6a6a9f16a2
msgctxt "h1b22df3egee6cg4c2ag8351g5dcdeb902791"
msgid "No? Shame, I thought you might enjoy a little fun."
msgstr "그래? 아쉽네. 재미 좀 볼 줄 알 거라 생각했는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10
#. Speaker = Lakrissa
#. NodeID = e4059717-ce3a-d4e8-a43c-70068249a887
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10:e4059717-ce3a-d4e8-a43c-70068249a887
msgctxt "hd09837c0g006cg4c13gae6dgcdcf83cca85f"
msgid ""
"... well, I still think they'll kill us. But at least we can put up a fight."
msgstr "... 글쎄, 그래도 놈들이 우릴 죽일 것 같아. 하지만 적어도 우린 싸우다 죽을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10
#. Speaker = Lakrissa
#. NodeID = ea2c3d45-f228-9309-efca-10ad32ce0aee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10:ea2c3d45-f228-9309-efca-10ad32ce0aee
msgctxt "ha300ceb2gaea2g41f1gb11ag022be4f98d5a"
msgid ""
"No, it's not. None of this is funny. But at least this way there's something "
"to play for."
msgstr "그래, 재밌지 않아. 하나도 재미없어. 하지만 뭔가 걸어볼 순 있잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10
#. Speaker = Lakrissa
#. NodeID = fcfc7b6d-3c5d-0d7d-3c79-2850a816ec6d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard10:fcfc7b6d-3c5d-0d7d-3c79-2850a816ec6d
msgctxt "hcec1f1ceg45e9g42ceg8dafge91381410733"
msgid ""
"We're tougher than we look. We've survived persecution. Survived Avernus."
msgstr "우리는 보기보다 강인해. 우리는 박해에서 살아남았어. 아베르누스에서도 살아남았고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard11
#. Speaker = Zorru
#. NodeID = 1ba9ced2-27ac-7fac-1c0f-6e1699240224
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_TieflingGuard11_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_TieflingGuard11_HasMet(1) = True
#.   Global:
#.     - DEN_Tiefling011_State_Met = True
#.     - ORI_Laezel_Quest_FoundZorru = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard11:1ba9ced2-27ac-7fac-1c0f-6e1699240224
msgctxt "h80f6a0f8g3d2fg427bg8512g74ec6e919176"
msgid "How long d'you think we've got before the goblins come?"
msgstr "고블린들이 오기 전에 얼마나 시간이 남았을까요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard11
#. Speaker = Player
#. NodeID = 3360bd79-f40b-5562-cd8c-d4beb5978de6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard11:3360bd79-f40b-5562-cd8c-d4beb5978de6
msgctxt "hdfaaaba2g1ce9g4ab0g9b36g8241e2776171"
msgid "I fought for your people at the gate. Show some gratitude."
msgstr "난 당신네들을 위해 문 밖에서 싸웠어. 좀 고마워 하라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard11
#. Speaker = Player
#. NodeID = 43ea077b-f91f-1f33-7dca-f43da5fb792e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard11:43ea077b-f91f-1f33-7dca-f43da5fb792e
msgctxt "hb1411159g915dg44ecgbeeeg3a73401489c7"
msgid "Speak to me in such a way again, and I will."
msgstr "또다시 그런 식으로 말했다간, 그렇게 해주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard11
#. Speaker = Zorru
#. NodeID = 440ac2d9-f98f-f0f1-6d58-4a31a11d78e2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ThingLikeMe_State_AnimateForLaezel = True
#.   Object:
#.      - DEN_ThingLikeMe_State_TieflingKneel(0) = True
#. TagRule: LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard11:440ac2d9-f98f-f0f1-6d58-4a31a11d78e2
msgctxt "h7e2ad6eagf92ag470fgbf06g56a666f48ede"
msgid "Leave m-me alone. I b-beg you."
msgstr "나 좀 내버려둬. 제발."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard11
#. Speaker = Zorru
#. NodeID = 440ac2d9-f98f-f0f1-6d58-4a31a11d78e2
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ThingLikeMe_State_AnimateForLaezel = True
#.   Object:
#.      - DEN_ThingLikeMe_State_TieflingKneel(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard11:440ac2d9-f98f-f0f1-6d58-4a31a11d78e2
msgctxt "h787ec430g5cd8g4ac7g8a15g42e989ed40cd"
msgid "Please. I've... I've been through enough."
msgstr "제발. 저는... 저는 충분히 고통 받았어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard11
#. Speaker = Zorru
#. NodeID = 4a13bce0-1776-3beb-914c-7731390c45c2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_ThingLikeMe_Knows_AboutYul = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard11:4a13bce0-1776-3beb-914c-7731390c45c2
msgctxt "ha32d27c6ga728g4d0cga93eg4063e2b35f50"
msgid ""
"It saw <i>us</i> 'fore we saw <i>it.</i> Jammed its blade through Yul's "
"belly, straight to the other side."
msgstr "<i>우리보다</i> 먼저 <i>놈이</i> 우리를 봤어요. 놈의 카-카-칼날이 율의 배를 뚫고 곧장 반대편으로 날아갔습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard11
#. Speaker = Zorru
#. NodeID = 501235d3-ae78-d68d-2909-c24d23b13211
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ThingLikeMe_State_AnimateForLaezel = True
#.   Object:
#.      - DEN_ThingLikeMe_State_TieflingBow(0) = True
#. TagRule: LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard11:501235d3-ae78-d68d-2909-c24d23b13211
msgctxt "hedfe4ca6g0eb3g4717g8caag61de91358daa"
msgid "P-p-please."
msgstr "ㅈ..제...제발."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard11
#. Speaker = Zorru
#. NodeID = 501235d3-ae78-d68d-2909-c24d23b13211
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ThingLikeMe_State_AnimateForLaezel = True
#.   Object:
#.      - DEN_ThingLikeMe_State_TieflingBow(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard11:501235d3-ae78-d68d-2909-c24d23b13211
msgctxt "h96405850g10fag4395gb35bgd141877146f1"
msgid "Please. I've... I've been through enough."
msgstr "제발. 저는... 저는 충분히 고통 받았어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard11
#. Speaker = Zorru
#. NodeID = 7030cfc6-17b8-04f1-97c5-91863cb08190
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_TieflingGuard11_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard11:7030cfc6-17b8-04f1-97c5-91863cb08190
msgctxt "hdfdb8df1gbca7g4e17gb777g4a0e043890f8"
msgid ""
"We should be getting drunk, at least. It's no fun waiting for death sober."
msgstr "우리는 취해야 해요, 적어도요. 술에 취하지 않고 죽음을 기다리는 것은 재미가 없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard11
#. Speaker = Zorru
#. NodeID = 72957c93-d02f-ca6c-19cc-ca44e6d5c824
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard11:72957c93-d02f-ca6c-19cc-ca44e6d5c824
msgctxt "h61e1ec9dg5cceg4373gbcd7g6cccf3cdf82e"
msgid "Now get away from me!"
msgstr "이제 나 좀 내버려둬!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard11
#. Speaker = Player
#. NodeID = 7bc52d43-4e8d-ef9d-2691-9fb38e2828d9
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Global:
#.      - PLA_GithChokepoint_State_SceneDone = False
#.   Tag:
#.      - BARBARIAN(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard11:7bc52d43-4e8d-ef9d-2691-9fb38e2828d9
msgctxt "hdd0b1412gf2f8g4b41g8577g306896f3e6c0"
msgid "You've seen other githyanki? Tell me where - or I'll have your head."
msgstr "다른 기스양키를 본 적이 있다고? 어디였는지 당장 말하지 않으면 네 머리를 잘라 버릴 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard11
#. Speaker = Zorru
#. NodeID = 83776006-5522-a100-7f11-e46cc5937d81
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ThingLikeMe_State_AnimateForLaezel = True
#.   Object:
#.      - DEN_ThingLikeMe_State_TieflingStand(0) = True
#. TagRule: LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard11:83776006-5522-a100-7f11-e46cc5937d81
msgctxt "hb9807d8bg8d7ag4f3ag973fg651f5f59b1cf"
msgid "P-please. Just leave me alone."
msgstr "제, 제발. 그냥 절 내버려 둬요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard11
#. Speaker = Zorru
#. NodeID = 83776006-5522-a100-7f11-e46cc5937d81
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ThingLikeMe_State_AnimateForLaezel = True
#.   Object:
#.      - DEN_ThingLikeMe_State_TieflingStand(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard11:83776006-5522-a100-7f11-e46cc5937d81
msgctxt "h7a4cdcc2gef77g4522ga306ga0adb2ed11fa"
msgid "Please. I've... I've been through enough."
msgstr "제발. 저는... 저는 충분히 고통 받았어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard11
#. Speaker = Player
#. NodeID = 883cce6b-b1fa-a9f8-2396-ab500e68c066
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Global:
#.      - PLA_GithChokepoint_State_SceneDone = False
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard11:883cce6b-b1fa-a9f8-2396-ab500e68c066
msgctxt "h59660431g9732g4edega1a6g1c4e5332d195"
msgid "<b>OTHER GITHYANKI - WHERE?</b>"
msgstr "<b>다른 기스양키? 어디?</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard11
#. Speaker = Zorru
#. NodeID = 8bfda13e-5121-0e7e-b0cf-82fc2e5231b7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard11:8bfda13e-5121-0e7e-b0cf-82fc2e5231b7
msgctxt "h8359d915g9515g46b6gaa8eg8b28556b3eed"
msgid "I'll t-tell you. Just stay back, all right?"
msgstr "마..말할게요. 그러니 제발 뒤로 물러서줘요, 알겠죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard11
#. Speaker = Player
#. NodeID = 8d9a8b74-42c9-70fb-2dfa-ad3606fe0345
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard11:8d9a8b74-42c9-70fb-2dfa-ad3606fe0345
msgctxt "h755ee59cg46f3g46e4gbe0ag52132c7c37ac"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard11
#. Speaker = Zorru
#. NodeID = 8f2fbfd4-434e-ceb1-fc36-36d932a9e56c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard11:8f2fbfd4-434e-ceb1-fc36-36d932a9e56c
msgctxt "h7d81c788g96beg4463ga37bgc14da1162305"
msgid "Leave me alone, toad, or... or... just leave me alone!"
msgstr "날 내버려 둬, 두꺼비, 아니면... 아니면... 그냥 날 내버려 둬!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard11
#. Speaker = Zorru
#. NodeID = 91400052-9cab-e95b-20be-8f89f7ad2b8a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard11:91400052-9cab-e95b-20be-8f89f7ad2b8a
msgctxt "he36771fbg5669g475egaea9g349cc50346c6"
msgid "Stand back, toad. I owe you nothing!"
msgstr "물러서, 이 두꺼비야! 네게 말해 줄 의무는 없어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard11
#. Speaker = Zorru
#. NodeID = aa93eb0e-a831-0d7d-f4aa-fcfeeed08605
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard11:aa93eb0e-a831-0d7d-f4aa-fcfeeed08605
msgctxt "hbc501ce9g6126g4fbfg98b2gc5d6201a3f29"
msgid "My friend's blood not enough? Come to rip me open too?"
msgstr "내 친구의 피로는 부족했나? 나도 찢어 죽이러 왔지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard11
#. Speaker = Zorru
#. NodeID = ac2f9050-77bb-f2b8-d4f5-2d0a23a0eb2a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard11:ac2f9050-77bb-f2b8-d4f5-2d0a23a0eb2a
msgctxt "h9dd3c739ged7eg425bgb397g6b1ba7907b9b"
msgid "And I just... I just <i>ran.</i>"
msgstr "그리고 난... 난 그냥... <i>도망쳤어요.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard11
#. Speaker = Zorru
#. NodeID = c60d6ae7-f983-9fec-75b8-86ad34ead4a7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_GithChokepoint_Knows_NearMountain = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard11:c60d6ae7-f983-9fec-75b8-86ad34ead4a7
msgctxt "h588f5ddeg31b3g46cagbb86g6cef84ef7839"
msgid "They were on the road to Baldur's Gate, near the mountain p-pass."
msgstr "그들은 산길 근처 발더스 게이트로 가는 길에 있었습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard11
#. Speaker = Zorru
#. NodeID = ea87987f-d718-aaeb-4644-3d33f076f8c1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_TieflingGuard11_HasMet(1) = True
#.   Tag:
#.      - LAEZEL(1) = False
#.      - GITHYANKI(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard11:ea87987f-d718-aaeb-4644-3d33f076f8c1
msgctxt "hcfc28261ge4d8g4091ga698ge03284f15fc6"
msgid "Leave m-me alone. I b-beg you."
msgstr "저, 저 좀 내버려 둬요. 부... 부탁할게요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard11
#. Speaker = Zorru
#. NodeID = f544f3b8-de57-27e7-6b9b-34596646dbb7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_TieflingGuard11_HasMet(1) = False
#.   Global:
#.      - DEN_ThingLikeMe_Event_LaezelStartedOM = False
#.   Tag:
#.      - LAEZEL(1) = False
#.      - GITHYANKI(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_TieflingGuard11_HasMet(1) = True
#.   Global:
#.     - DEN_Tiefling011_State_Met = True
#.     - ORI_Laezel_Quest_FoundZorru = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard11:f544f3b8-de57-27e7-6b9b-34596646dbb7
msgctxt "hf4afcb33g3c5cg4a4ag9ea4ge7b10c4354a5"
msgid "By Mordai's eyes, another one."
msgstr "모르다이의 눈이여, 또 다른 놈이라니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard11
#. Speaker = Zorru
#. NodeID = fa884b4a-c058-b293-cce0-a0475890c29b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard11:fa884b4a-c058-b293-cce0-a0475890c29b
msgctxt "hab6702cegce74g4956g8e61g080791579679"
msgid "You did not fight to aid us. You simply craved the taste of blood."
msgstr "넌 우릴 돕기 위해 싸운 게 아니잖아. 그저 피 맛을 갈망했을 뿐이겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard4
#. Speaker = Kaldani
#. NodeID = 159d88e8-c9ba-0650-f56c-6ba2be7cca22
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard4:159d88e8-c9ba-0650-f56c-6ba2be7cca22
msgctxt "h9d1f6f4bgb2edg4d99g9404g72eb87c8014f"
msgid "It's appreciated, trust me."
msgstr "정말 고마워. 진심이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard4
#. Speaker = Kaldani
#. NodeID = 18321fc8-ee9d-71a8-4c09-c7f90e09f9d2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard4:18321fc8-ee9d-71a8-4c09-c7f90e09f9d2
msgctxt "h4c9174a6g83ceg4755g8487g23019454ebba"
msgid "Ain't that Beshaba's bitter truth?"
msgstr "베샤바의 씁쓸한 현실이 따로 없는걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard4
#. Speaker = Kaldani
#. NodeID = 1c2fbe64-78cb-3fda-d067-8d0e7a207559
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_RaidingParty_Quest_ConfrontationResolved = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard4:1c2fbe64-78cb-3fda-d067-8d0e7a207559
msgctxt "h5b34a818g273fg48d5gbcc8gd002ecff693f"
msgid "No more trouble... yet."
msgstr "다른 문젯거린 안 보여... 당장은."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard4
#. Speaker = Player
#. NodeID = 1dd2879f-0445-3e85-7a7b-cc2880145a08
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard4:1dd2879f-0445-3e85-7a7b-cc2880145a08
msgctxt "hf6219149ga973g436bgb925g3036a1491037"
msgid "Sounds like you've crossed paths with Aradin before."
msgstr "아라딘이랑 마주한 적이 전에도 있나 보군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard4
#. Speaker = Kaldani
#. NodeID = 35630b12-e329-a2a3-9170-07d0b0f846d3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_General_TieflingGuard4_BrushedOff(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard4:35630b12-e329-a2a3-9170-07d0b0f846d3
msgctxt "h289d488fg938ag45a1g830dg97d598c8f35f"
msgid "Fair enough. Didn't mean to get too friendly."
msgstr "그러지, 뭐. 엄청 친해질 생각도 아닌데 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard4
#. Speaker = Kaldani
#. NodeID = 538078bb-2ef2-b23f-8df7-594207325157
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard4:538078bb-2ef2-b23f-8df7-594207325157
msgctxt "h8bdbd992gc280g4555g8319g52f5a6df658e"
msgid "If you want a healer, look to the druids."
msgstr "치유사가 필요하면, 드루이드들을 찾아봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard4
#. Speaker = Kaldani
#. NodeID = 5f74f08a-636b-4450-c33f-7c4d9e9be815
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard4:5f74f08a-636b-4450-c33f-7c4d9e9be815
msgctxt "hd6db1214gcd60g4aa9g82f8gbdaf4be3ccac"
msgid "And I'm tired of good people dying. That's for sure."
msgstr "좋은 사람이 자꾸 죽어나가니 진절머리 나. 정말이지 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard4
#. Speaker = Kaldani
#. NodeID = 6811de53-47a8-f94b-0ffd-33a96a22e8ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard4:6811de53-47a8-f94b-0ffd-33a96a22e8ed
msgctxt "h3d25cc12g5b50g4073ga8d7g94e4cca05643"
msgid ""
"Yeah, when he ran off with the druid that saved our hides the first time."
msgstr "맞아. 그치가 처음 우릴 구해줬던 그 드루이드를 데리고 여길 나설 때였지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard4
#. Speaker = Kaldani
#. NodeID = 7ba5d00c-c093-af4e-3c92-82f05ae938e5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard4:7ba5d00c-c093-af4e-3c92-82f05ae938e5
msgctxt "hc33b82f3gf919g4c12gbe11gf99d56fba378"
msgid "By all rights, he was a good man. I saw enough of him to agree."
msgstr "누가 봐도 좋은 사람이었으니까. 내 눈에도 두말할 것 없었고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard4
#. Speaker = Player
#. NodeID = 7f780627-1018-401d-8ee2-6fe7da164ef8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_IsMissing = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard4:7f780627-1018-401d-8ee2-6fe7da164ef8
msgctxt "hda31008eg3041g47b6g9915g491d740c7208"
msgid "Who's Halsin?"
msgstr "할신이 누군데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard4
#. Speaker = Player
#. NodeID = 9001ea1e-29b0-5284-42f4-f18a6ef90df7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard4:9001ea1e-29b0-5284-42f4-f18a6ef90df7
msgctxt "h5916f197g48b1g42c2gac66g5f432aafdba3"
msgid "Sorry to disappoint."
msgstr "거 미안하게 됐네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard4
#. Speaker = Kaldani
#. NodeID = 9515926a-1328-ff3b-8038-8990560cae2b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard4:9515926a-1328-ff3b-8038-8990560cae2b
msgctxt "h43215d7bg4a29g4bacg805eg5fcf6563140a"
msgid "The druid in charge of this grove. At least, he was."
msgstr "이 숲을 이끄는 드루이드야. 이제는 옛말이지만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard4
#. Speaker = Kaldani
#. NodeID = a3da6dff-759f-974c-3c60-5cccfb3bb712
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Knows_IsMissing = True
#.   Quest:
#.     - GLO_Tadpole_SUB_Druid.LearnedLostHalsin(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard4:a3da6dff-759f-974c-3c60-5cccfb3bb712
msgctxt "h88ac6935g4755g482egb942g7b747eab9292"
msgid "Guess if he didn't come back with Aradin, that might not be the case."
msgstr "아라딘이랑 같이 돌아오지 못한 모양이니, 그가 다시 이끌 일은 없겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard4
#. Speaker = Player
#. NodeID = abf4eeb8-ceeb-19e9-a692-637b6dac1497
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TIEFLING(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard4:abf4eeb8-ceeb-19e9-a692-637b6dac1497
msgctxt "h1da2214bge776g4af9gb62bg41350d39a165"
msgid "If I don't help my kin, who will?"
msgstr "동족인 나 아니면, 누가 돕겠어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard4
#. Speaker = Kaldani
#. NodeID = c8c4c6e5-da05-c5c9-ba15-2793083546db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard4:c8c4c6e5-da05-c5c9-ba15-2793083546db
msgctxt "h21d130bdgea1bg4871gb6d5g21236d6c3246"
msgid "Without Halsin... this grove's not so friendly, I'll tell you that."
msgstr "할신이 없으면… 이 숲은 그리 우호적인 곳이 아니야. 미리 알아 둬."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard4
#. Speaker = Player
#. NodeID = cf0e39ba-0118-cf6e-d50e-088ee892e2aa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard4:cf0e39ba-0118-cf6e-d50e-088ee892e2aa
msgctxt "h36a5f772gb223g4a28g8ba4ga9ddd47500df"
msgid "I'm looking for a healer. Let's skip the local drama."
msgstr "나는 치유사를 찾는 중이야. 이 동네 사정 얘기는 건너뛰자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard4
#. Speaker = Kaldani
#. NodeID = e6945e7c-fab2-80b5-f990-5101703e54ce
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_CampGeneral_PCGotLore(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_CampGeneral_PCGotLore(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard4:e6945e7c-fab2-80b5-f990-5101703e54ce
msgctxt "h78bf0679g77a0g4965gbcd6gd168494d02c8"
msgid ""
"Aradin's back with his tail between his legs. I'm glad for your help, but "
"I'd hoped you were Halsin."
msgstr "아라딘이 꼬리 말고 돌아와버렸군. 도와줘서 고맙긴 한데, 그쪽이 할신이었으면 했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard4
#. Speaker = Kaldani
#. NodeID = e728fe80-67f3-3bc0-b2ea-8b22adcd9d3c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_General_State_KanonCorpseClear = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard4:e728fe80-67f3-3bc0-b2ea-8b22adcd9d3c
msgctxt "h3b6c47b4gf6e1g43f5g8088g070176d9d576"
msgid "Have some respect. This <i>really</i> isn't the time to talk."
msgstr "예의 좀 갖춰. 지금은 <i>도저히</i> 얘기 나눌 상황 아니라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard4
#. Speaker = Player
#. NodeID = e9e79dcc-7f85-986e-f660-bdde4eea6aaa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_IsMissing = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard4:e9e79dcc-7f85-986e-f660-bdde4eea6aaa
msgctxt "h718f41c7g95b3g483egba30g2fad62764428"
msgid "Seems like a lot of people are looking for that druid."
msgstr "그 드루이드를 찾는 사람이 퍽 많아 보이는걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard4
#. Speaker = Kaldani
#. NodeID = ef201584-31ae-7745-e015-789e37a0ddc8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard4:ef201584-31ae-7745-e015-789e37a0ddc8
msgctxt "h4f43b437gf1b6g485bgb0f1ge8e7b1a74f8b"
msgid "Keep your wits about you. Things are tense with the druids here."
msgstr "정신 바짝 차리고 있어. 드루이드들 때문에 여긴 조마조마한 상태야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard4
#. Speaker = Kaldani
#. NodeID = f548b7df-d62d-5888-c0f1-f142a5848cb0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard4:f548b7df-d62d-5888-c0f1-f142a5848cb0
msgctxt "h6e92bdbfg8d35g4b7dgb758g89261f96b239"
msgid ""
"Hells, I didn't mean it that way. Halsin's important, but you're the first "
"bit of good faith we've had since he left."
msgstr "아니, 난 무안 주려던 게 아니야. 할신이 중요하긴 해도, 그가 여길 뜬 뒤 우리한테 선의를 베푼 건 댁이 처음이라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard4
#. Speaker = Kaldani
#. NodeID = f5dc22db-0df3-6d1e-be2e-491399302517
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_CampGeneral_PCGotLore(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard4:f5dc22db-0df3-6d1e-be2e-491399302517
msgctxt "h95d8952dge935g42aaga0e9g31f933cf89d5"
msgid "No more trouble... yet."
msgstr "다른 문젯거린 안 보여... 당장은."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard4
#. Speaker = Kaldani
#. NodeID = fa685b4f-19f1-6559-d937-a27ac95cc3f2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_General_TieflingGuard4_BrushedOff(1) = True
#.      - DEN_CampGeneral_PCGotLore(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard4:fa685b4f-19f1-6559-d937-a27ac95cc3f2
msgctxt "h9cc973dfga396g4801g9b59g11b415de8544"
msgid "Don't mind me. I'll stay out of your way."
msgstr "난 신경 쓰지 마. 네 앞을 막을 일은 없을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Player
#. NodeID = 03799101-13f2-cdfe-3695-40d91b475abf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:03799101-13f2-cdfe-3695-40d91b475abf
msgctxt "h80f0f883g65b4g4868ga4d3g317a4baaa26f"
msgid "Hah! You look ridiculous."
msgstr "하! 너 우스꽝스러워 보이는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Player
#. NodeID = 04aa1c20-452a-57ef-f6ac-38d7c79461ba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:04aa1c20-452a-57ef-f6ac-38d7c79461ba
msgctxt "h38a841feg71f8g4480ga69cg719b9e17b835"
msgid "Crate-guarding is a serious job."
msgstr "상자 지킴이는 매우 진지한 일이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = 083f1b00-d56a-7e1b-2506-11d61dee3b93
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Tiefling5_Event_Warned = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Tiefling5_State_TurnedHostile(0) = True
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#.     - CRIME_CallGuardsFromDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:083f1b00-d56a-7e1b-2506-11d61dee3b93
msgctxt "h18a9f6a3g79feg4b30g9e4agac2092b8f8a5"
msgid "Guards! GUARDS!"
msgstr "경비병! <b>경비병!</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = 08de1b58-1652-bced-5d87-f67dc831c315
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(7) = True
#. SetFlags:
#.   Object:
#.     - GEN_TransferNPCPayment(0) = True
#.     - DEN_General_State_MadeParalyzedTieflingPay(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:08de1b58-1652-bced-5d87-f67dc831c315
msgctxt "h6f1c547dg00ebg4e84g811eg42c29dc41f36"
msgid ""
"All right... I guess being fearless won't help if an arrow comes flying "
"right at me. Here."
msgstr "알았어요... 겁이 아무리 없어도 화살이 정통으로 날아오면 어쩔 도리가 없겠네요. 자 여기요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Player
#. NodeID = 114fecc7-2940-cfad-2b88-1e7c500f5185
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:114fecc7-2940-cfad-2b88-1e7c500f5185
msgctxt "he700db08gd9c0g48c1gb34cgd9796a8516d8"
msgid "<i>Attack her.</i>"
msgstr "<i>그녀를 공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = 163b45ae-f36e-52af-ad94-58b61c35d102
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:163b45ae-f36e-52af-ad94-58b61c35d102
msgctxt "hd3577db8g6ecag40afga8fag8bc0b6314c87"
msgid "I wish I could, but... I have nothing left."
msgstr "그러면 좋겠지만... 가진 게 아무것도 없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = 173f5574-c788-42bf-87af-180f592abb2a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Tiefling5_HasMet(1) = True
#. SetFlags:
#.   Global:
#.     - DEN_Tiefling5_Event_Warned = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:173f5574-c788-42bf-87af-180f592abb2a
msgctxt "h389522e2gbf15g47ecgb417gd5cb1d71fcdd"
msgid "Is there an empty space between your ears? Out! I won't say it again!"
msgstr "귀가 쳐 막힌거야? 나가! 두 번 말 안 해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Player
#. NodeID = 1827f743-5708-e7bf-6c97-6d3c145b582a
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. TagRule: BARD or CLERIC or DRUID or PALADIN
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:1827f743-5708-e7bf-6c97-6d3c145b582a
msgctxt "h2349fa86gc01cg45c7gaa23gd0243b04d671"
msgid ""
"You'll be dead in seconds if the goblins come. I can heal you. For a price."
msgstr "고블린이 쳐들어오면 죽은 목숨이나 다름없을 거야. 내가 치료해 줄게. 약간의 보상은 받고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = 1d22160d-828b-d6eb-333c-157fb5693069
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:1d22160d-828b-d6eb-333c-157fb5693069
msgctxt "h4609062ag039dg407bga539ga325c967a53d"
msgid "Yes, thanks. I know. Should've never taken that bloody potion."
msgstr "그래, 고마워. 그 망할 포션을 마셔서는 안됐다는 건 나도 알아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Player
#. NodeID = 1ea72b4f-356a-07d8-2d0c-7ad74eeb79c5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:1ea72b4f-356a-07d8-2d0c-7ad74eeb79c5
msgctxt "h59c7d611g8b99g4f9fga68dg3c095fcd6f1c"
msgid "My health doesn't concern you."
msgstr "내 건강에 관심 끄시지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = 1fd17cd2-34ab-a24e-5df1-e7efd64dd098
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Tiefling5_Event_PersuadeSuccess = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:1fd17cd2-34ab-a24e-5df1-e7efd64dd098
msgctxt "hc47acd0bgdfe7g4c3cg9cebg81ce574123bc"
msgid "If this isn't the most boring post in the grove, I don't know what is."
msgstr "정말 따분한 일이야, 이 숲에서 여기만큼 지루한 보직은 없을걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Player
#. NodeID = 21e69377-29c0-8856-bb45-3ee86822a415
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:21e69377-29c0-8856-bb45-3ee86822a415
msgctxt "h5327c6d7g5792g41feg9bf7g5a0c7269d9f5"
msgid "Hush, girl. Another word and I'll snap your neck."
msgstr "소녀야 조용히 하렴. 한마디 더 하면 목을 부러뜨려줄게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Player
#. NodeID = 23fb2f7e-c6c2-88fd-dd1d-6a129fab69ba
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_PaladinOathbreaker_Event_BrokeOath(1) = True
#.     - ORI_DarkUrge_Event_IndulgedUrge(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:23fb2f7e-c6c2-88fd-dd1d-6a129fab69ba
msgctxt "h99bee426g6ea9g424fg8f79gaa550c716657"
msgid "<i>She's helpless. You could ensure she never stands again.</i>"
msgstr "<i>그녀는 무력하다. 다시는 일어나지 못하게 만들 수 있다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = 253a147c-6d13-5860-bdb8-05d87534d254
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_General_State_TieflingGuardWaitingForHeal = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:253a147c-6d13-5860-bdb8-05d87534d254
msgctxt "h271244a0g28dcg4705g89f2g2c91b6bc433d"
msgid "Wait - but... all right. Don't be long."
msgstr "잠깐, 하지만... 알았어. 너무 늦지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Player
#. NodeID = 27ff5273-5e3a-7681-3bbc-1969c7dcdbb0
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: BARD or CLERIC or DRUID or PALADIN
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:27ff5273-5e3a-7681-3bbc-1969c7dcdbb0
msgctxt "hbbc9b881g2dc4g4b71gbc49g88ee78b3dba5"
msgid "That doesn't sound like a side effect at all. Let me heal you."
msgstr "전혀 부작용 같지 않은데. 내가 치료해줄게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = 2b3f9a64-7ca1-1f68-49f7-e962ffe61049
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_General_State_TieflingGuardWaitingForHeal = True
#.      - DEN_General_Event_WaitingForHealCastedNonHeal = True
#.   Object:
#.      - DEN_General_State_PotionTieflingHealed(0) = False
#. SetFlags:
#.   Global:
#.     - DEN_General_Event_WaitingForHealCastedNonHeal = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:2b3f9a64-7ca1-1f68-49f7-e962ffe61049
msgctxt "h0a4e46fcgc544g444bgb064g4d2f586b49ba"
msgid "Did that...? No, damn it. Still nothing."
msgstr "그게 방금...? 아니, 젠장. 아직도 아무 일 없잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = 2f0710e6-cd8f-58c0-2ca6-812381bbca3f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:2f0710e6-cd8f-58c0-2ca6-812381bbca3f
msgctxt "h89743350g8c17g431dg8a7fg92c205063809"
msgid ""
"Maybe - maybe it just needs time to wear off. Fingers crossed the goblins "
"don't return any time soon."
msgstr "어쩌면, 어쩌면 그저 시간이 필요한 걸 수도 있어. 고블린이 조만간 돌아오지 않길 바랄 뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = 30d6851e-8eb4-8461-f5a8-f30e69b03d4e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - f2cb0a83-a7da-a9b2-a995-a97fb392a7dd_Failedpersuasion = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:30d6851e-8eb4-8461-f5a8-f30e69b03d4e
msgctxt "h90cb2df8g36ceg475eg8655g6b7c6a1579b0"
msgid "That's bull. Get the hells out of here - before I call the guards."
msgstr "헛소리. 여기서 당장 나가. 경비병을 부르기 전에."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = 341f350d-9b0f-cd19-71f2-95935f27bbaf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:341f350d-9b0f-cd19-71f2-95935f27bbaf
msgctxt "h249591d6g0caag497egb71dg05cba7458e7e"
msgid ""
"The old lady warned me that this might happen. That it was a side effect!"
msgstr "그 늙은 부인이 이런 일이 일어날 수도 있다고 경고해줬어요. 부작용이 있을 수 있다고요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Player
#. NodeID = 34d18893-6798-4512-6347-a1b5253386b5
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:34d18893-6798-4512-6347-a1b5253386b5
msgctxt "h7f4c6a5bgee35g4738g9d88gaa7ea95db72c"
msgid "<i>Study her face and try to read her emotions.</i>"
msgstr "<i>그녀의 표정을 읽어 어떤 감정을 느끼고 있는지 알아낸다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = 36aadbb1-6d4f-10d0-91f0-03c9a67748f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:36aadbb1-6d4f-10d0-91f0-03c9a67748f0
msgctxt "h95982f60g7823g41d9ga362ge1d16530638d"
msgid ""
"No need. Should be able to stand soon enough - once this bloody potion wears "
"off."
msgstr "그럴 필요 없어요. 이 망할 포션의 약효가 곧 떨어지기만 하면 일어날 수 있을 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = 37b9ea55-5daf-0f06-396a-613d48117bd3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:37b9ea55-5daf-0f06-396a-613d48117bd3
msgctxt "h5eec0822g3310g436dgad32gc18c38ea3268"
msgid "Do what you gotta do - sorry if I don't show you around."
msgstr "네가 해야 할 일을 해. 안내하지 못해 미안해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Player
#. NodeID = 3bc4c704-9faa-7e86-ebe0-c940f82204ff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:3bc4c704-9faa-7e86-ebe0-c940f82204ff
msgctxt "h345fabe2g3dbdg4d5cg9094g44c03d3f5c2e"
msgid "Nothing. Do you need a hand?"
msgstr "아무것도 아냐. 도와줄까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = 3d3f47dc-1298-5597-823d-fde9125e5bcc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_TieflingGuard5_Event_CharlatanPersuade = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:3d3f47dc-1298-5597-823d-fde9125e5bcc
msgctxt "h98a63bcegfd31g4e58gb418gc45ed19e5093"
msgid "Figured it was a pity post anyway."
msgstr "그냥 동정심에 직책을 맡겼었나 봐요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Player
#. NodeID = 3e328a22-5363-c2e7-6da6-15f8ed0753b2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:3e328a22-5363-c2e7-6da6-15f8ed0753b2
msgctxt "h48720881g8d05g4138ga8f6g03a4d52a7908"
msgid "Sounds like you've been duped."
msgstr "넌 속은 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Narrator
#. NodeID = 41ff4453-b888-d9ea-e0f5-36456b454246
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:41ff4453-b888-d9ea-e0f5-36456b454246
msgctxt "h6cc8749dg4803g4cddg9b93g9669c8b070f2"
msgid "*You note her grimace of pain. Something is wrong with her legs.*"
msgstr "*고통에 찬 그녀의 표정이 보입니다. 다리에 뭔가 문제가 생긴 것 같습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Player
#. NodeID = 42194cd2-f046-b709-594d-8bb9a8f3593c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_General_State_MadeParalyzedTieflingPay(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:42194cd2-f046-b709-594d-8bb9a8f3593c
msgctxt "ha1dc1801g9757g45b7ga6f1g3815a50067c5"
msgid "Sit tight. I'll be back soon."
msgstr "잠깐만 기다려. 금방 돌아올게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = 42adab1f-1c35-1a80-b515-07bed473e1a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:42adab1f-1c35-1a80-b515-07bed473e1a4
msgctxt "hb50aeb53ge68bg461ag9a87gcb4721db6f4d"
msgid "Relax. I'll be up and about once this potion - wait."
msgstr "진정해요. 약효만 가시면 금방 일어날... 잠깐만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = 42c3414e-cd2b-6e03-4abb-3bfc3324b16c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Tiefling5_HasMet(1) = True
#.   Object:
#.      - DEN_General_State_PotionTieflingHealed(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:42c3414e-cd2b-6e03-4abb-3bfc3324b16c
msgctxt "h6ab1c8d1gd4dfg4da6g8844gddebdc7ab6bc"
msgid ""
"Look, between us? You're not supposed to be here, but I'll turn a blind eye."
msgstr "저기요, 우리끼리 얘긴데 말이죠. 여기 있으면 안 되지만 눈 감아 줄게요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Player
#. NodeID = 44865e0a-6e77-08e2-79aa-e9f7cc0d32e4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:44865e0a-6e77-08e2-79aa-e9f7cc0d32e4
msgctxt "h4d0bc1a9gb0d3g4ad9g926dg2be4d6ff3cb4"
msgid "You must feel pretty useless."
msgstr "엄청 무력감을 느끼고 있겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = 461aca95-2e10-35f6-30d2-d12468d1d115
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:461aca95-2e10-35f6-30d2-d12468d1d115
msgctxt "ha144043fg4907g4bc5gb20fg71bf3d26c157"
msgid "This place is off-limits. <i>Leave.</i>"
msgstr "여기는 출입금지에요. <i>나가주세요.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = 48cf6f39-94aa-b835-d6ac-1ed0bcc1e4b0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:48cf6f39-94aa-b835-d6ac-1ed0bcc1e4b0
msgctxt "hf8fcb9b7g379cg4596gb137gce473c2d006d"
msgid ""
"...Sorry, I need a moment. I'm not - not feeling the best. But I'm sure "
"it'll pass."
msgstr "...미안해, 잠시 시간이 필요해. 상태가 - 그리 좋지 않아. 하지만 금방 회복될 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = 49c3fa7d-d589-d88f-a8da-a5241af92d76
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:49c3fa7d-d589-d88f-a8da-a5241af92d76
msgctxt "hc34b1377g916fg4a86g942bg898d2378159c"
msgid "Why are you looking at me like that?"
msgstr "왜 그런 눈으로 보는 거죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = 49f9e4a6-44a9-f09d-ac5b-73bbd1ec7423
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_Tiefling5_State_TurnedHostile(0) = True
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#.     - CRIME_CallGuardsFromDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:49f9e4a6-44a9-f09d-ac5b-73bbd1ec7423
msgctxt "h387ece69g40fdg4d03g81fbg431ae1e4e6a5"
msgid "What?! Wait! You promised! Guards!!"
msgstr "뭐야?! 잠깐만요! 약속했잖아요! 경비병!!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = 4cbc86e7-81bd-fa7b-b883-a344a3eb2161
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:4cbc86e7-81bd-fa7b-b883-a344a3eb2161
msgctxt "hbde78db7g17e6g47b2g87a7g90a3aae58f34"
msgid "I wish I could, but... I have nothing left."
msgstr "그러면 좋겠지만... 가진 게 아무것도 없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = 4d5b7c74-e3f8-4ce0-a1b7-a9a937869f83
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Tiefling5_Event_PersuadeSuccess = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:4d5b7c74-e3f8-4ce0-a1b7-a9a937869f83
msgctxt "hd139710eg42edg41ccgb885g4e55e07572cd"
msgid ""
"Look, you're not <i>really</i> supposed to be here, but I'll turn a blind "
"eye. Just don't touch anything, all right?"
msgstr "원래 여기에 있으면 안되지만 이번 한 번만 눈 감아 드릴게요. 여기 있는 물건만 손대지 말아주세요. 알겠죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = 517d61ff-f03f-3a95-6c8f-4b938f404812
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Event_TieflingGuard5_Threatened = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:517d61ff-f03f-3a95-6c8f-4b938f404812
msgctxt "h932aabdbg663dg4a0eg9e7cg415c705cc181"
msgid "...I won't say anything... just don't hurt me - please."
msgstr "...아무 말도 하지 않을게요... 절 해치지만 말아 주세요. 제발요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = 51c0672d-6f3a-77ef-c369-7d47aae6f38f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:51c0672d-6f3a-77ef-c369-7d47aae6f38f
msgctxt "h84336fe8gb542g40b9g8e71g43a369fb58c6"
msgid ""
"Well, I won't be knocking a potion back any time soon - I can tell you that."
msgstr "뭐, 당분간 물약을 허겁지겁 들이키는 일은 없겠죠. 그건 확실해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = 5be8b053-6398-c2a5-d4c0-893c2aba5e2e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - f2cb0a83-a7da-a9b2-a995-a97fb392a7dd_Failedpersuasion = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:5be8b053-6398-c2a5-d4c0-893c2aba5e2e
msgctxt "ha0d374cdgf5e9g4acegad0ag2b114fdb32e6"
msgid "Well, look elsewhere."
msgstr "그럼 다른 데나 둘러봐요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Player
#. NodeID = 63317c6c-a376-3e55-e3dd-5d20897268b3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_CheckPocketGold_2 = True
#. SetFlags:
#.   Object:
#.     - GEN_TransferNPCPayment(1) = True
#.     - DEN_General_State_MadeParalyzedTieflingPay(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:63317c6c-a376-3e55-e3dd-5d20897268b3
msgctxt "ha5520ae0gaffbg43e9g98aag11c691d75cec"
msgid "Forget it. I don't need your money."
msgstr "됐어. 돈은 주지 않아도 괜찮아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = 66140317-5c53-4d35-4f33-4dfe6d1846df
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:66140317-5c53-4d35-4f33-4dfe6d1846df
msgctxt "h459f4f1agd533g47c5gb345gce455d1f5676"
msgid ""
"Course she also warned of side effects. Should have listened. Now I'm stuck "
"guarding <i>crates</i>."
msgstr "당연히 그녀는 부작용을 경고해줬죠. 그때 들었어야 하는데. <i>상자들</i>이나 지키고 있는 꼴이라니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Player
#. NodeID = 68b0661c-759d-dadd-532f-53c782ed5543
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_General_State_TieflingGuardWaitingForHeal = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:68b0661c-759d-dadd-532f-53c782ed5543
msgctxt "h292de63eg4233g4247g83e6g866cd8cc499f"
msgid "Hold still and I'll cast the spell."
msgstr "가만히 있으면 주문을 걸어 줄게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = 6ae6d260-88cb-2959-897e-84705fe9e15a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:6ae6d260-88cb-2959-897e-84705fe9e15a
msgctxt "h7d2c2053g8c53g4e45gaf9bg998e904e6403"
msgid ""
"They, erm, have some side effects, but they work. I'm as strong as a bugbear."
msgstr "그 물약들은, 음, 부작용이 좀 있긴 하지만 효과가 있어요. 전 버그베어처럼 강해졌다고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Player
#. NodeID = 7780a948-a7e5-77cb-c646-fc36d63f7a48
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:7780a948-a7e5-77cb-c646-fc36d63f7a48
msgctxt "hcb28bcb1g20eag4864g8ddeg04593d0d1c35"
msgid "I guess that's possible."
msgstr "그럴 수도 있겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Player
#. NodeID = 792c21f7-f34d-5d40-567c-518f2f719b03
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:792c21f7-f34d-5d40-567c-518f2f719b03
msgctxt "h82246f8bg7aaeg4a68g9a30gea9e0ae27e5a"
msgid "You show too much weakness. You'll be left behind."
msgstr "약한 모습을 너무 많이 보이고 있군. 그러다 버려질 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Player
#. NodeID = 7ae91923-f89f-7eb5-0a10-9e5080a4e55c
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_DARK_URGE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:7ae91923-f89f-7eb5-0a10-9e5080a4e55c
msgctxt "h8f10528dge044g4d4egb218g6f3d1330fca5"
msgid "<i>Resist the urge to break her legs. Ask about the potion.</i>"
msgstr "<i>그녀의 다리를 부러트리고 싶은 충동을 참아낸다. 포션에 대해 질문하자.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Player
#. NodeID = 7ae91923-f89f-7eb5-0a10-9e5080a4e55c
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:7ae91923-f89f-7eb5-0a10-9e5080a4e55c
msgctxt "h27a0627cg78d7g437cgb1adg3f4fb6272ac0"
msgid "Where did you get this potion?"
msgstr "이 물약은 어디서 난 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Wyll
#. NodeID = 7cac4f25-3f3d-bddc-093f-8fe6789c59b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:7cac4f25-3f3d-bddc-093f-8fe6789c59b4
msgctxt "h97eacb6ag57c2g4ca4g9615g1ce0e5e28403"
msgid "How generous. Do you charge by the bell, or the spell?"
msgstr "친절도 하셔라. 요금은 시간당으로 받나, 아니면 주문당으로 받나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = 7f3545a6-e868-57e3-72b2-0cbc9fb26f04
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_General_State_HealedTieflingResponded = False
#.      - DEN_General_State_TieflingGuardWaitingForHeal = True
#.   Object:
#.      - DEN_General_State_PotionTieflingHealed(0) = True
#. SetFlags:
#.   Global:
#.     - DEN_General_State_HealedTieflingResponded = True
#.     - DEN_General_State_TieflingGuardWaitingForHeal = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:7f3545a6-e868-57e3-72b2-0cbc9fb26f04
msgctxt "h7e1c92b1ga444g4fcega057g21446a170d93"
msgid "My foot! It moved! Thank you. Thank you so much."
msgstr "내 발이! 움직이잖아! 감사합니다. 정말 감사해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = 7f82fa84-0a49-eea4-7299-808a8e4b661f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Tiefling5_Event_PersuadeSuccess = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:7f82fa84-0a49-eea4-7299-808a8e4b661f
msgctxt "h9e1767cdgdee3g4824g92b7g77127ad688b8"
msgid "You can stay. Just keep your hands to yourself, all right?"
msgstr "여기 계셔도 돼요. 물건에 손대지만 마세요, 아시겠죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = 8063a362-f123-7d87-a9e7-51965b41d4cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:8063a362-f123-7d87-a9e7-51965b41d4cb
msgctxt "ha844e7dagc8a5g4175g8022g46137fb04df3"
msgid ""
"Sorry, I didn't mean - I bought it off the old woman in the cave. Sells "
"potions."
msgstr "죄송해요, 그런 뜻은 아니었는데. 동굴에 있는 노파에게서 샀어요. 물약을 팔더라고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = 81b8a690-2c39-4116-0ccf-d43bd9a86cdb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:81b8a690-2c39-4116-0ccf-d43bd9a86cdb
msgctxt "h4741fc86gb65bg4748gb2c5gf8d9f827d58d"
msgid "I know. Though I can feel it wearing off. Bloody potion."
msgstr "저도 알아요. 그래도 점점 효과가 가라앉는 게 느껴져요. 망할 물약 같으니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = 836dfb96-d690-aa7c-5353-6d14ba8648c2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:836dfb96-d690-aa7c-5353-6d14ba8648c2
msgctxt "h4a465654geaecg4014g8bbcg5348270aa9de"
msgid "I <i>told</i> you - I'll be fine. It'll wear off soon."
msgstr "<i>말했잖아요,</i> 금방 괜찮아질 거라고요. 곧 효과가 사라질 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Player
#. NodeID = 85af0264-cf73-8602-ed82-ec5f04738d46
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ROGUE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:85af0264-cf73-8602-ed82-ec5f04738d46
msgctxt "h94928d5ag307ag4661g874bg16973761f004"
msgid "I'd wager your 'potion' was a paralysing agent."
msgstr "네 '물약'이라는 게 사실 마비약이었던 것 같네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = 85eadd73-abda-93e5-4211-e29f016accf0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_General_State_PotionTieflingHealed(0) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Tiefling5_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:85eadd73-abda-93e5-4211-e29f016accf0
msgctxt "h6777d914g64b8g4e10g8f52g528cd352bbb1"
msgid ""
"Any goblin comes near me now, and they'll regret it. I feel <i>amazing</i>."
msgstr "고블린 한 놈이라도 다가오면, 후회하게 만들어 줄 거야. 기분이 <i>끝내줘요</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Player
#. NodeID = 873e6107-85f8-441a-9d0b-27bc73007a87
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:873e6107-85f8-441a-9d0b-27bc73007a87
msgctxt "he9f88cb1g593cg4360ga8d6g45e97bc2ad43"
msgid "I think you should worry about yourself."
msgstr "당신 걱정이나 하는 게 좋을 것 같은데요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = 887f8052-4766-2e8c-0d40-4d3499dd5490
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:887f8052-4766-2e8c-0d40-4d3499dd5490
msgctxt "he5134ccdg140bg4a3eg941cg19caa17cc5dc"
msgid ""
"I just meant - if you're feeling ill, there's an old woman in the cave. "
"Sells potions."
msgstr "제 말은... 만약 어디 아픈 것 같다면 동굴에 할머니가 한 분 계세요. 물약을 팔고 있죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = 8b5a233b-1996-134d-5618-0de59246cd74
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GEN_TransferNPCPayment(0) = True
#.     - DEN_General_State_MadeParalyzedTieflingPay(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:8b5a233b-1996-134d-5618-0de59246cd74
msgctxt "h396b0c65ge233g447bg97b4g629de8c1263d"
msgid ""
"All right... I guess being fearless won't help if an arrow comes flying "
"right at me. Here."
msgstr "알았어요... 겁이 아무리 없어도 화살이 정통으로 날아오면 어쩔 도리가 없겠네요. 자 여기요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = 8b652e2a-1b54-8435-99ea-bf23f5918dbd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Tiefling5_Event_PersuadeSuccess = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:8b652e2a-1b54-8435-99ea-bf23f5918dbd
msgctxt "h3a9c580eg92e1g481bga3dfg52614f130781"
msgid ""
"Damn it, was inventory today? I'm sorry. Nerves are shot after the attack."
msgstr "젠장, 오늘 재고 조사하는 날이었어? 미안해. 그 공격 이후로 신경이 곤두서 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = 8e628029-ceba-1542-5f25-1e003015a2ca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:8e628029-ceba-1542-5f25-1e003015a2ca
msgctxt "h7935e981gcda5g4c7bg8f68gd96931e98000"
msgid "No. She's been nothing but kind to me. Why would she..."
msgstr "아냐. 그녀는 나에게 친절하기만 했어. 왜 그녀가..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = 9251ae95-c0aa-68cd-1e16-e1f82652b49e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:9251ae95-c0aa-68cd-1e16-e1f82652b49e
msgctxt "h7218de1cgdd37g4d0agb5e6g6271031669ba"
msgid "And then some - just hope this wears off soon."
msgstr "그것도 그렇지만 빨리 약효가 빠졌으면 좋겠어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Player
#. NodeID = 95bfaf6f-c356-ae38-74ce-85c92f71a7cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:95bfaf6f-c356-ae38-74ce-85c92f71a7cf
msgctxt "hed7c01e0g4a43g47c8gb7fcg0a32461eab5f"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = 95ef80c7-9c5b-c911-20bb-6a6995d947cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:95ef80c7-9c5b-c911-20bb-6a6995d947cb
msgctxt "h57ce77aag4545g4f88g9523g3bc3fbb4e520"
msgid ""
"I wanted an edge against the goblins, and I got it - I'm as strong as a "
"bugbear. And fearless."
msgstr "고블린을 상대하는 이점을 얻고 싶었어요. 결국 얻어내긴 했죠, 전 버그베어만큼 강하답니다. 용맹하기도 하고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Player
#. NodeID = 98541ac9-0122-bd7c-0672-16f01116a23a
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:98541ac9-0122-bd7c-0672-16f01116a23a
msgctxt "h33330a56g2548g478fg9088ge432b1dd1e91"
msgid "Don't worry. I'm here to help."
msgstr "걱정하지 마. 도와주러 온 거니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = 9a676a8d-a759-d2c3-1e77-b6c7cef6c09f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Tiefling5_HasMet(1) = True
#.   Local:
#.      - f2cb0a83-a7da-a9b2-a995-a97fb392a7dd_Failedpersuasion = True
#. SetFlags:
#.   Global:
#.     - DEN_Tiefling5_Event_Warned = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:9a676a8d-a759-d2c3-1e77-b6c7cef6c09f
msgctxt "h414c256cg9052g4700g9bcbg1e8ea004fe4d"
msgid "Out! Now! I won't say it again!"
msgstr "나가요! 당장! 마지막 경고야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = a01aea5d-90d5-8a46-128d-c3bb4f5759a0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Event_TieflingGuard5_Threatened = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:a01aea5d-90d5-8a46-128d-c3bb4f5759a0
msgctxt "hdaaea767g2843g4069gb11bg414611c8c69d"
msgid "..."
msgstr "..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Player
#. NodeID = a15b6c19-e706-18ea-ca1f-af0016195096
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:a15b6c19-e706-18ea-ca1f-af0016195096
msgctxt "h42f09ef7g0a44g4ffdg85ffge76f981e1e9b"
msgid "You mentioned a potion. What did you drink?"
msgstr "물약에 대해 말했잖아. 어떤 걸 마신 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = a2b2284a-511d-dd7f-d0e4-43bf7693d4ba
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - f2cb0a83-a7da-a9b2-a995-a97fb392a7dd_Failedpersuasion = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:a2b2284a-511d-dd7f-d0e4-43bf7693d4ba
msgctxt "hdf21baaag1b6fg4b04g819dg0745c0884e83"
msgid "<i>Bull. </i>Get the hells out, before I call the guards."
msgstr "<i>웃기시네.</i> 당장 꺼져. 경비들 부르기 전에."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Player
#. NodeID = a3bddea5-195a-ab2b-08d3-32f6c3bf08a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:a3bddea5-195a-ab2b-08d3-32f6c3bf08a5
msgctxt "h104dad9eg7541g4008gbe7dg78b9baa0427d"
msgid "<i>Bare your fangs and lunge at her throat.</i>"
msgstr "<i>송곳니를 꺼내고 그녀의 목을 물어버린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = a468cc73-2cad-f8a5-8be4-0945aca5419e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:a468cc73-2cad-f8a5-8be4-0945aca5419e
msgctxt "h94c24db2gb816g49d8ga60ag8dd027ad75fa"
msgid "I'm not <i>drunk</i>. I just can't... stand."
msgstr "<i>취한 거</i> 아니에요. 지금... 일어설 수가 없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = a6b7a90b-b6f0-26f4-fa8c-3ec111d08c73
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:a6b7a90b-b6f0-26f4-fa8c-3ec111d08c73
msgctxt "h702f4c44g17ebg4030gb316g60ed058fcfb3"
msgid "No. I'm just an idiot."
msgstr "아니요. 전 그냥 멍청이일 뿐이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = a711a71b-fd69-ee56-c369-07e87c43aee9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_General_State_PotionTieflingHealer(1) = True
#.      - DEN_Tiefling5_HasMet(1) = False
#.   Global:
#.      - DEN_General_State_HealedTieflingResponded = False
#.      - DEN_General_State_TieflingGuardWaitingForHeal = False
#.   Object:
#.      - DEN_General_State_PotionTieflingHealed(0) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Tiefling5_HasMet(1) = True
#.   Global:
#.     - DEN_General_State_HealedTieflingResponded = True
#.     - DEN_General_State_TieflingGuardWaitingForHeal = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:a711a71b-fd69-ee56-c369-07e87c43aee9
msgctxt "hbfb7164agab7bg4416g8a67g82e0f1a1e23e"
msgid "My legs - I can stand again. Did you do that? I - Thank you!"
msgstr "내 다리가, 다시 설 수 있잖아. 당신이 한 건가요? 전... 감사합니다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Player
#. NodeID = abf7f1dc-d7b5-0ae6-ae4f-a0d54d068c15
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:abf7f1dc-d7b5-0ae6-ae4f-a0d54d068c15
msgctxt "h6cafe7b2ga0e5g4f94g915bg17877063cdf2"
msgid ""
"Don't worry. You're not the only one to have trouble standing after too many "
"'potions'."
msgstr "걱정 마. '물약'을 너무 많이 마셔서 문제가 생긴 게 당신 혼자는 아니니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = ad71b45a-1804-8430-24d7-2e29caafaa39
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(5) = True
#. SetFlags:
#.   Object:
#.     - GEN_TransferNPCPayment(0) = True
#.     - DEN_General_State_MadeParalyzedTieflingPay(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:ad71b45a-1804-8430-24d7-2e29caafaa39
msgctxt "h0f5e3bf3g79b3g4380ga024ged7e9129adb5"
msgid ""
"All right... I guess being fearless won't help if an arrow comes flying "
"right at me. Here."
msgstr "알았어요... 겁이 아무리 없어도 화살이 정통으로 날아오면 어쩔 도리가 없겠네요. 자 여기요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = b1890475-9ab0-23d6-762e-232d5d6ba573
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:b1890475-9ab0-23d6-762e-232d5d6ba573
msgctxt "h5873b2beg28a0g478ega625ge64085d40a4b"
msgid "She might be able to help with... that."
msgstr "그녀가 아마...도와줄 수 있을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = b214c7dd-6e0e-fe48-7968-d8f01181afe2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:b214c7dd-6e0e-fe48-7968-d8f01181afe2
msgctxt "h4037be78g1fdag4abdg8b53g52b67e517f34"
msgid "What in the Nine Hells happened to your face? Are you all right?"
msgstr "아홉 지옥이여 맙소사, 당신 얼굴에 무슨 일이 일어난 거야? 괜찮아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = b75de630-6de3-67cc-c202-9057fc175408
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:b75de630-6de3-67cc-c202-9057fc175408
msgctxt "h4eb5459dg2368g4761g91e6ge794dbd4dd83"
msgid "To her credit, it worked. I'm as strong as a bugbear. And fearless."
msgstr "그녀가 장담한 대로 물약은 효과가 있었어요. 버그베어만큼이나 강해진데다, 두려울 건 없죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = bc30f1d9-789b-6a27-aa73-ef43f6d3363c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_Tiefling5_State_TurnedHostile(0) = True
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#.     - CRIME_CallGuardsFromDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:bc30f1d9-789b-6a27-aa73-ef43f6d3363c
msgctxt "hd50c8fe3g7aa5g420fga6eeg928334984c56"
msgid "Damn it! HELP! Someone, HELP!"
msgstr "젠장! 도와주세요! 누가 좀 도와줘요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = be620e79-20bd-cf02-d112-e907e3ee356a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:be620e79-20bd-cf02-d112-e907e3ee356a
msgctxt "h9a30cbc8gb4d5g4d0bgb695g0e4e4255db3b"
msgid "Damn it. Don't... don't look at me like that."
msgstr "젠장. 날... 그렇게 보지 마세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Player
#. NodeID = c10d48b9-ffb9-a00e-eedf-e56250622132
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:c10d48b9-ffb9-a00e-eedf-e56250622132
msgctxt "h63821160g5522g42ffg9a0bg3c0063339ac7"
msgid "Need a hand up?"
msgstr "일으켜줄까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Player
#. NodeID = c246d499-91ff-95ac-37fb-c021b6b343f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:c246d499-91ff-95ac-37fb-c021b6b343f1
msgctxt "hcc360107gadd4g4ef5gbec9g198ee73717a1"
msgid "I'm just looking around."
msgstr "그냥 둘러보던 것뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = c37b9900-ea6e-1151-62a2-ef23e5928a2e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:c37b9900-ea6e-1151-62a2-ef23e5928a2e
msgctxt "h5e241524g4530g4819gb047g0ec41794fec9"
msgid ""
"But the old lady - she warned me of side effects. Should have listened. Now "
"I'm stuck guarding <i>crates</i>."
msgstr "그 노인네가 부작용을 경고해줬을 때 들었어야 하는데. 여기서 <i>상자들</i>이나 지키고 있는 꼴이라니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = c4b4bf35-9dca-135d-16ca-fbf18c0df3ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:c4b4bf35-9dca-135d-16ca-fbf18c0df3ae
msgctxt "h423fcb1aga2f9g4a01g857bgd7d113137c60"
msgid "You got something to say?"
msgstr "할 말이라도 있어요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = c806e2dd-c153-fc59-bd1b-8a4a6fd5aad4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_Tiefling5_State_TurnedHostile(0) = True
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:c806e2dd-c153-fc59-bd1b-8a4a6fd5aad4
msgctxt "hbab9e52fg42e2g4560gb3ccge2cc1c05cb85"
msgid "WAIT! Come back!"
msgstr "기다려요! 돌아와요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Wyll
#. NodeID = cc515313-3b4f-51d7-5559-1786e334c87e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(7) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:cc515313-3b4f-51d7-5559-1786e334c87e
msgctxt "hc4c9ffb8g93ecg483dgb66cg386c6af73da3"
msgid "How generous. Do you charge by the bell, or the spell?"
msgstr "친절도 하셔라. 요금은 시간당으로 받나, 아니면 주문당으로 받나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = cda10fb1-3eba-76b5-d1ab-dc0134bb5550
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:cda10fb1-3eba-76b5-d1ab-dc0134bb5550
msgctxt "h62dcdcf3ge27dg4934ga5d2ge665051429dd"
msgid ""
"All right... I guess being fearless won't help if an arrow comes flying "
"right at me."
msgstr "알겠어요. 화살이 날아오는 판에 용기는 별 도움이 안 될 것 같군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Shadowheart
#. NodeID = d26b940e-c25a-81c9-276e-d97d2e5f5f14
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:d26b940e-c25a-81c9-276e-d97d2e5f5f14
msgctxt "h83f15451g21dag4cfagbd14g097e6b395a48"
msgid "Very mercenary of you. I wouldn't have done it any differently."
msgstr "아주 용병다운 모습이네. 나라도 똑같이 했을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Player
#. NodeID = d361103f-d1a9-11f9-59ee-ea4160e027ab
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WIZARD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:d361103f-d1a9-11f9-59ee-ea4160e027ab
msgctxt "h4dd24b1dg2715g4c4fgbd65g47ab6f274b8c"
msgid ""
"Strong brews sometimes have lasting effects. You should prepare for the "
"worst."
msgstr "강력한 추출물의 효과는 쉽게 사라지지 않기도 하지. 최악의 상황을 대비하는 게 좋을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Player
#. NodeID = d5518f4f-6eaa-a706-1779-e563c8672e5e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_General_State_MadeParalyzedTieflingPay(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:d5518f4f-6eaa-a706-1779-e563c8672e5e
msgctxt "he069fdb4g9f70g469fg804eg23a423e149f7"
msgid "<i>Pocket the money and leave.</i>"
msgstr "<i>돈을 뺏고 떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = d6c49183-051d-76f1-d4b3-6a7137360fcb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingGuard5_Event_CharlatanPersuade = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:d6c49183-051d-76f1-d4b3-6a7137360fcb
msgctxt "ha1c2d275g5738g4610g8c34g4ac0d0a8cf9b"
msgid "If this isn't the most boring post in the grove, I don't know what is."
msgstr "정말 따분한 일이야, 이 숲에서 여기만큼 지루한 보직은 없을걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Narrator
#. NodeID = d77208b4-accd-117e-2f9c-4dbc6d856e30
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_DarkUrge_TieflingGuard5_BrokeLegs = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:d77208b4-accd-117e-2f9c-4dbc6d856e30
msgctxt "h9e8c5a2fgfebfg4cdeg81degfac6f544a5d6"
msgid ""
"*The symphony already plays in your head: every toe snapping like a twig.*"
msgstr "*당신의 머릿속에서 교향곡이 울려 퍼집니다: 발가락 하나하나가 나뭇가지처럼 꺾입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Player
#. NodeID = d81dee9e-4a61-ab94-fb74-f1cc74f77f5c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:d81dee9e-4a61-ab94-fb74-f1cc74f77f5c
msgctxt "h63ee4cf7gd3e1g436dg93e2g35aeec40d28d"
msgid "<i>Glare - show her the rage burning in your eyes.</i>"
msgstr "<i>눈빛 발사 - 불타는 분노를 담아 그녀를 쏘아본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = daeaf725-2b9b-22a2-1219-f36a44348e4a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:daeaf725-2b9b-22a2-1219-f36a44348e4a
msgctxt "hae96bd14ga9bbg46b6gb37cg15223f0e4da4"
msgid "But Zevlor said I... Damn it."
msgstr "하지만 제블로어가... 망할."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = db688a42-513b-f896-a1f4-fc72d08cc58d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:db688a42-513b-f896-a1f4-fc72d08cc58d
msgctxt "h8b13cea5gd4cfg4d75g9fb9g5ed850e3f3b3"
msgid ""
"What?! No, no. She said it wouldn't be permanent. It <i>can't</i> be! It'll "
"wear off soon - it <i>has</i> to."
msgstr ""
"네?! 아니야, 아니에요. 이 증상이 영구적인 건 아니라고 했어요. 그럴 리가 <i>없어요!</i> 곧 사라질 거예요. "
"<i>그래야만</i>해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = db72747f-1309-052c-46a6-710be3bf3297
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Tiefling5_Event_PersuadeSuccess = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:db72747f-1309-052c-46a6-710be3bf3297
msgctxt "h6ca399e5g8f1ag4d39ga6fbg991638120573"
msgid "Just don't touch anything, all right?"
msgstr "그냥 아무 것도 만지지 마. 알겠지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = e4d2addb-763f-763c-f712-cb326f0c7ae9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:e4d2addb-763f-763c-f712-cb326f0c7ae9
msgctxt "h6ba80a48g7edeg419cgbcaeg2b137e23886f"
msgid "Bloody potion!"
msgstr "망할 물약 같으니라고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = e51ac82f-a85e-3a7a-97cc-3dcdf869c617
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:e51ac82f-a85e-3a7a-97cc-3dcdf869c617
msgctxt "h452f1f1eg839eg445egb38eg8b25027e5e89"
msgid "I'd just fall back down - legs are as steady as a foal's."
msgstr "그래봤자 도로 넘어질 거예요. 다리가 갓 태어난 망아지마냥 후들거려서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Player
#. NodeID = ed31e2ba-6651-60fa-5d3c-c18be01920da
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:ed31e2ba-6651-60fa-5d3c-c18be01920da
msgctxt "hfb3d02b3g1b42g47d1g8cafg7e118db9c187"
msgid "I'm a cleric. Let me heal you."
msgstr "난 클레릭이야. 치료해 줄게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = ed32996d-9bcd-d46c-2262-48ad1527cdad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:ed32996d-9bcd-d46c-2262-48ad1527cdad
msgctxt "ha52eeb60g3ffeg4feeg9d0agca3d357baff7"
msgid ""
"Hah. <i>Deadly </i>serious. Still - the sooner this wears off, the better."
msgstr "하하. <i>굉장히</i> 진지한 일이죠. 그래도 약효가 빨리 빠질수록 더 좋겠어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Player
#. NodeID = f0d609d2-44de-df18-a4e3-6ac62dd9ca20
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:f0d609d2-44de-df18-a4e3-6ac62dd9ca20
msgctxt "h6fa60fa0g2fc3g4765gbedbgd6f938deda30"
msgid "Sounds like it was quite the dodgy brew."
msgstr "꽤나 위험한 포션처럼 들리는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = f2eb76d1-9721-d197-5dc4-6aef87b43095
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:f2eb76d1-9721-d197-5dc4-6aef87b43095
msgctxt "h224f70b0g1b12g426dg83d8g18afae3fc950"
msgid "From the old lady in the cave - the one with the 'lotions and potions'."
msgstr "동굴 안쪽에 '로션과 포션'을 운영하는 한 늙은 부인한테서 얻었죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Player
#. NodeID = f6d1969c-16a2-2c2f-61f8-0dde07e99a85
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:f6d1969c-16a2-2c2f-61f8-0dde07e99a85
msgctxt "h69083815ga11bg495bg8da3gcd23ef471b7f"
msgid "<i>She is vulnerable. Helpless. And you are </i>hungry<i>.</i>"
msgstr "<i>그녀는 취약해. 무력해. 그리고 너는</i> 배고프지<i>.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Narrator
#. NodeID = f6d4f0e4-abc0-53ae-4e51-0d476c4053c7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#. SetFlags:
#.   Object:
#.     - ORI_DarkUrge_Event_HadUrge(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:f6d4f0e4-abc0-53ae-4e51-0d476c4053c7
msgctxt "h98c6ccf6g78bcg45e9ga988g2c63180782dd"
msgid ""
"*In a secluded place, all alone... it would be too easy to do away with her. "
"Far beneath your talents.*"
msgstr "*이런 외딴 곳에 혼자라... 그녀를 없애는 건 너무 쉬워 보입니다. 당신의 재능에 비하면 식은 죽 먹기죠.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Player
#. NodeID = f8f2a541-c926-6569-ad4d-d7c73b7537c0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Tiefling5_State_HasBag(0) = True
#. SetFlags:
#.   Object:
#.     - DEN_Tiefling5_Event_GaveBag(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:f8f2a541-c926-6569-ad4d-d7c73b7537c0
msgctxt "h1472f42cg39b7g48c5gacf0g88e6511721a2"
msgid "<i>She can't come after you. Take her bag and leave. </i>"
msgstr "<i>따라오지 못 할 것 같다. 가방을 집어들고 떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Player
#. NodeID = f90b00c7-1902-eab5-804a-3c2b142b4e66
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:f90b00c7-1902-eab5-804a-3c2b142b4e66
msgctxt "h14b45f7cg238eg40d5gae28g75832c4acbde"
msgid "I'm afraid I can't. I've been placed in charge of this area."
msgstr "그렇게는 못할 거 같은데. 난 이 지역의 책임자로 임명됐어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Player
#. NodeID = f92e5a9e-d8d2-93b8-821e-cdff878511ca
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DRUID or RANGER
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:f92e5a9e-d8d2-93b8-821e-cdff878511ca
msgctxt "ha195d363gfdd7g4c81gb640g3ed865e61a79"
msgid "It might've been nightshade, maybe hemlock - poison, basically."
msgstr "나이트셰이드인 것 같은데, 독미나리거나. 어쨌든 독이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = fad64b19-6b8f-86d8-24c3-1aec21ae5a4f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:fad64b19-6b8f-86d8-24c3-1aec21ae5a4f
msgctxt "h7e4ceda1gbfb0g486fgbce9ge8987f8138fd"
msgid ""
"<i>What?</i> No, the potion worked! I'm strong as a bugbear. And fearless."
msgstr "<i>뭐?</i> 아니, 그 물약은 효과가 있었어! 난 버그베어만큼 강해. 그리고 두려움도 없고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = fb2e9a44-6a05-e3fb-f0fb-ead0df23589b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:fb2e9a44-6a05-e3fb-f0fb-ead0df23589b
msgctxt "h66f7c5d8gc32dg46a3g980dg04f1d036a237"
msgid "Oh, eh, thank you. You'll still heal me, right?"
msgstr "오, 어, 고마워요. 그래도 치료는 해 주는 거죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = fdfa240e-5c5a-8d0e-37b2-2039263f2440
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_Tiefling5_State_TurnedHostile(0) = True
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#.     - CRIME_CallGuardsFromDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:fdfa240e-5c5a-8d0e-37b2-2039263f2440
msgctxt "h15de33d7gf47fg4db8g808cg82e693bdde58"
msgid "Gods, HELP! SOMEONE HELP!"
msgstr "신이시여, 도와줘! 누가 제발 도와줘!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = ff190bba-eb35-27b7-655a-768b7e795bb3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_Tiefling5_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard5:ff190bba-eb35-27b7-655a-768b7e795bb3
msgctxt "h47718271ga35bg4decgb2e1g7c2c45642f6f"
msgid "Stop!"
msgstr "멈춰!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard8
#. Speaker = Ikaron
#. NodeID = 48eacbc0-60e6-1e85-e576-9ed5d6532132
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: TIEFLING and FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard8:48eacbc0-60e6-1e85-e576-9ed5d6532132
msgctxt "hb87ac9b9g403fg44e9g9fa3g7bd75ba3825c"
msgid "Sister."
msgstr "자매."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard8
#. Speaker = Ikaron
#. NodeID = 48eacbc0-60e6-1e85-e576-9ed5d6532132
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: TIEFLING and MALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard8:48eacbc0-60e6-1e85-e576-9ed5d6532132
msgctxt "hbdb6e629g1481g416eg99dag2cc41a00ae6b"
msgid "Brother."
msgstr "형제."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard8
#. Speaker = Ikaron
#. NodeID = 48eacbc0-60e6-1e85-e576-9ed5d6532132
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard8:48eacbc0-60e6-1e85-e576-9ed5d6532132
msgctxt "h5cd67789ga774g425cg9f22g6da7e5e01730"
msgid "Move along."
msgstr "갈 길 가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard8
#. Speaker = Ikaron
#. NodeID = 64c61089-82bb-592b-39c4-cc0e64b79271
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard8:64c61089-82bb-592b-39c4-cc0e64b79271
msgctxt "h1f9ff978g83c6g4136g864eg6ffee13be1ee"
msgid "Don't be the cause of more."
msgstr "그럴 일 더 만들진 말아줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard8
#. Speaker = Ikaron
#. NodeID = bfbf1ab6-853e-2083-7589-6d5b2b50b665
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - Den_Thieflings_InterferingGuard_PCGotLore(1) = False
#. SetFlags:
#.   Dialog:
#.     - Den_Thieflings_InterferingGuard_PCGotLore(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_TieflingGuard8:bfbf1ab6-853e-2083-7589-6d5b2b50b665
msgctxt "heb5cac7bg64a1g4709gb737gd820bccaf6b4"
msgid "We've known enough grief this tenday, traveller."
msgstr "우린 지난 열흘 내내 슬픈 일 충분히 겪었어, 여행자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_VB_Grave_AdventurerLeader
#. Speaker = Narrator
#. NodeID = e8365928-3f70-a6db-22f8-78a531744080
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_VB_Grave_AdventurerLeader:e8365928-3f70-a6db-22f8-78a531744080
msgctxt "h42d49f24g52cag441fg97b4g338359633aef"
msgid "*Here lies Aradin. He yearned for glory and adventure. And he got it.*"
msgstr "*여기 아라딘이 묻히다. 그는 영광과 모험을 갈망했고, 결국 얻어냈다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_VB_Grave_Kanon
#. Speaker = Narrator
#. NodeID = db70b4ef-07d1-0a73-1547-8f8893ee233b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_VB_Grave_Kanon:db70b4ef-07d1-0a73-1547-8f8893ee233b
msgctxt "h236b71c4g2882g4e20g807eg9baefb53a080"
msgid ""
"*Here lies Kanon. He gave his life defending others. He will be missed.*"
msgstr "*여기 카논이 묻히다. 그는 다른 이들을 보호하기 위해 자신의 목숨을 바쳤다. 우리는 그를 그리워할 것이다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_VB_Grave_TieflingLeader
#. Speaker = Narrator
#. NodeID = 37ee6582-4069-615a-fa13-7789da36fb0c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_VB_Grave_TieflingLeader:37ee6582-4069-615a-fa13-7789da36fb0c
msgctxt "h8a643f4egf9c0g40f0g9d73g66346ab5614e"
msgid ""
"*Here lies Zevlor. He saved us when all hope seemed lost. Thank you, friend.*"
msgstr "*여기 제블로어가 묻히다. 우리 희망이 모두 사라진 듯 보였을 때, 그가 우리 모두를 구했다. 고마워, 친구.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinRaider_Captain_AD_TakingTurn_Combat
#. Speaker = Za'krug
#. NodeID = a3034de6-5fe3-9135-5357-adbbc4cbf613
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinRaider_Captain_AD_TakingTurn_Combat:a3034de6-5fe3-9135-5357-adbbc4cbf613
msgctxt "h733fa68egeb7bg40e2g9d58gb9b5aa2095cf"
msgid "I'll bleed every last one of you!"
msgstr "모조리 피를 쏟게 만들어 주마!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts
#. Speaker = Warrior Gresh
#. NodeID = 446dfc9e-c3e4-693c-42b9-71331c09a263
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts:446dfc9e-c3e4-693c-42b9-71331c09a263
msgctxt "h9377178bge1acg4dcdgbf2fg18e34984768f"
msgid "I'll be tellin' the boss myself! Kill 'em!"
msgstr "내가 직접 두목에게 말할 거야! 저들을 죽여라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts
#. Speaker = Sazza
#. NodeID = 851abb0d-702f-04ec-e328-2bfd961042b4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_6 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts:851abb0d-702f-04ec-e328-2bfd961042b4
msgctxt "h72af1c7cg8333g4abdgb212gbdacbc475638"
msgid "What are you doin'? It's me, Sazza!"
msgstr "뭐하는 짓이야? 나야, 삿자라고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts
#. Speaker = Warrior Gresh
#. NodeID = c08131fe-3a00-077f-b6f9-cde5bc31b73e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts:c08131fe-3a00-077f-b6f9-cde5bc31b73e
msgctxt "h4169e721g63c5g431ag805bgbdc01cd8e79b"
msgid "Kill 'em!"
msgstr "죽여!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts
#. Speaker = Warrior Gresh
#. NodeID = f60bd7be-971d-dedb-f0c2-23230267eee4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts:f60bd7be-971d-dedb-f0c2-23230267eee4
msgctxt "h2399f642g845cg4037ga229gae09a409c32a"
msgid ""
"You and them other idiots mucked up the whole raid. The Absolute don't like "
"failures."
msgstr "너와 그 다른 머저리들이 습격을 전부 망쳤어. 절대자님은 실패를 용납하지 않으신다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts
#. Speaker = Warrior Gresh
#. NodeID = f7f38042-7fa9-77b1-969a-e26225cf3092
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts:f7f38042-7fa9-77b1-969a-e26225cf3092
msgctxt "h648a4f5dg6e21g4880g99a1g22c7377c566b"
msgid ""
"Did some bleeding hearts show up to save the druid? I'll cut ya to pieces."
msgstr "어떤 착해빠진 녀석들이 드루이드를 구하려 나타났네? 전부 조각내주마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts
#. Speaker = Sazza
#. NodeID = fad72fc7-9d16-a63f-0cab-4c3a58ce3e10
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts:fad72fc7-9d16-a63f-0cab-4c3a58ce3e10
msgctxt "h043bdfc6gfb66g4ca0gb83ega11c0766c4df"
msgid ""
"I ain't a failure - I'll be a hero when I tell the boss about this place. "
"And you'll be maggot food."
msgstr "난 실패자가 아니야. 두목에게 이곳에 대해 말하면 난 영웅이 될 거야. 넌 구더기 밥이 될 거고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD
#. Speaker = Tracker Worm
#. NodeID = 04421ffb-16a0-05fd-2c0e-ad8d35e83c9e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 5311a1fa-6db9-52f2-e5f7-099250634a91_B = True
#. SetFlags:
#.   Local:
#.     - 5311a1fa-6db9-52f2-e5f7-099250634a91_C = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD:04421ffb-16a0-05fd-2c0e-ad8d35e83c9e
msgctxt "h6e1a8fd5g796cg469ega80fgd2203c58764f"
msgid "Minthara's gonna skin us. No one knows about this damn weapon."
msgstr "민타라가 우리 가죽을 벗길거야. 아무도 이 망할 무기가 뭔지 모르잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD
#. Speaker = Tracker Worm
#. NodeID = 0acc9a23-05cd-9c10-3d50-61c27f0bf7f8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 5311a1fa-6db9-52f2-e5f7-099250634a91_A = True
#. SetFlags:
#.   Local:
#.     - 5311a1fa-6db9-52f2-e5f7-099250634a91_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD:0acc9a23-05cd-9c10-3d50-61c27f0bf7f8
msgctxt "h2d555844gc589g4198g95f0g593567963d29"
msgid "This was more fun when he was screamin'."
msgstr "그가 소리지를 때 더 재밌었지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD
#. Speaker = Tracker Torrack
#. NodeID = 0aed5f64-3742-2636-4d99-88c13148c5a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD:0aed5f64-3742-2636-4d99-88c13148c5a8
msgctxt "hb181b817gef5ag456bgb0dbgd985ba2a6474"
msgid "That's why I've been stabbin' all the rats. Might be spies."
msgstr "그래서 내가 쥐들을 찌르고 다니는 거야. 첩자일지도 모른다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD
#. Speaker = Sharp-Eye Gurza
#. NodeID = 0d56a9ec-c3a1-9376-99c1-70ba0f21a38f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD:0d56a9ec-c3a1-9376-99c1-70ba0f21a38f
msgctxt "hb52bdf1bg909eg479eg9dfegf5be80f97a11"
msgid "Yeah. She'll kill us dead if we go back without it."
msgstr "그래. 그것 없이 돌아간다면 그녀가 우릴 죽일걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD
#. Speaker = Warrior Gresh
#. NodeID = 392c3c59-0f87-edc1-df30-f9b7904a231c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD:392c3c59-0f87-edc1-df30-f9b7904a231c
msgctxt "h97f22e1bg0faeg4b7ag84c7g4f2ade32f3e0"
msgid "Shut it. Boss would rip ya for talking that way."
msgstr "닥쳐. 그런식으로 얘기하면 대장이 널 찢어놓을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD
#. Speaker = Warrior Gresh
#. NodeID = 536184d2-0c5c-22d0-cb84-5bba5cc0dcca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD:536184d2-0c5c-22d0-cb84-5bba5cc0dcca
msgctxt "hb005e819gbf90g47bcg824egde79daa1f790"
msgid "We'll get the druid talking. Grove's got to be full of magic."
msgstr "그 드루이드 입을 열게 할 거야. 숲에는 마법이 가득 차 있겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD
#. Speaker = Tracker Worm
#. NodeID = 68c5d421-87e5-7868-ae4c-e5d1674abdc6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD:68c5d421-87e5-7868-ae4c-e5d1674abdc6
msgctxt "h5c9498bfg8ee4g4ba2g801eg4b05b3cbdcb6"
msgid "Maybe we can set him on fire."
msgstr "이 녀석을 불태워 버릴까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD
#. Speaker = Tracker Torrack
#. NodeID = 78c11ee7-90f3-830d-a189-0d2bddd281d2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 5311a1fa-6db9-52f2-e5f7-099250634a91_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD:78c11ee7-90f3-830d-a189-0d2bddd281d2
msgctxt "h41b10866gc782g4704g87f2g334be9e4e70e"
msgid "No sign of the others yet. You think the fight up front went... bad?"
msgstr "아직 다른 사람들의 흔적이 없어. 앞에서 벌어진 싸움은... 안 좋게 끝났을까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD
#. Speaker = Sharp-Eye Gurza
#. NodeID = 8dcefaa7-cd51-5730-3322-e9e373eb669e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD:8dcefaa7-cd51-5730-3322-e9e373eb669e
msgctxt "h917353c6ge13fg4f9dg8592gf9dfe9521c62"
msgid "He's boring. Let's find another one."
msgstr "이 녀석 지루해. 다른 놈을 찾아보자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD
#. Speaker = Warrior Gresh
#. NodeID = 9adb71a8-a594-8ffd-419b-bce32d0e1686
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD:9adb71a8-a594-8ffd-419b-bce32d0e1686
msgctxt "hf96cfde6gd758g4c52g803ag7cd3b85200fe"
msgid "Don't wear his voice out. We still need answers."
msgstr "그의 목소리를 지치게 하지 마. 우리는 아직 답이 필요하다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD
#. Speaker = Tracker Worm
#. NodeID = b026670f-1b59-b755-6063-e0ec93cbbe2b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD:b026670f-1b59-b755-6063-e0ec93cbbe2b
msgctxt "h612dc1e1ge0d6g455bgb83bgc0ba874fa333"
msgid "Least we got the druid to keep ourselves entertained."
msgstr "적어도 우릴 계속 즐겁게 해 줄 드루이드가 있잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD
#. Speaker = Sharp-Eye Gurza
#. NodeID = b0be4feb-82e7-61cc-ef23-76648bb3ba22
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD:b0be4feb-82e7-61cc-ef23-76648bb3ba22
msgctxt "hc91d6db9g50fbg4492gb49bg9a964f01743c"
msgid "Yeah. Give him somethin' to cry about."
msgstr "그래. 그 녀석 좀 울게 해줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD
#. Speaker = Tracker Torrack
#. NodeID = be0f50d6-779c-4b1a-f63c-f360dd64eafb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 5311a1fa-6db9-52f2-e5f7-099250634a91_C = True
#. SetFlags:
#.   Local:
#.     - 5311a1fa-6db9-52f2-e5f7-099250634a91_B = False
#.     - 5311a1fa-6db9-52f2-e5f7-099250634a91_C = False
#.     - 5311a1fa-6db9-52f2-e5f7-099250634a91_A = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD:be0f50d6-779c-4b1a-f63c-f360dd64eafb
msgctxt "h085a05aeg86e2g490bgb1e3g149de4f7ec1d"
msgid "Pretty stubborn for a man wearin' leaves."
msgstr "잎사귀를 입은 남자치고는 꽤 고집이 세군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD
#. Speaker = Tracker Torrack
#. NodeID = ec1951b1-243c-5656-c592-ba0b075396b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD:ec1951b1-243c-5656-c592-ba0b075396b1
msgctxt "hd57a879bg1503g4f8dgae4bg6af6743f0b1d"
msgid "Could wake him up by choppin' off a toe. That'd be funny."
msgstr "발가락 하나를 잘라서 그를 깨워줄까? 재미있겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD
#. Speaker = Sharp-Eye Gurza
#. NodeID = fd920950-145a-f613-7cef-e933ee7e97f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD:fd920950-145a-f613-7cef-e933ee7e97f5
msgctxt "hf3855fe4gd4e3g434eg9746g5a523a51ba3c"
msgid "We should set the whole grove on fire."
msgstr "숲 전체를 불로 덮어 버릴 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD_Captive
#. Speaker = Findal
#. NodeID = 32ecd52a-0506-4100-87db-88f3e56fd2aa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 683cb55e-08b9-c865-78a6-4e047ee62a24_A = True
#. SetFlags:
#.   Local:
#.     - 683cb55e-08b9-c865-78a6-4e047ee62a24_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD_Captive:32ecd52a-0506-4100-87db-88f3e56fd2aa
msgctxt "h90f160b5g1f19g4325ga47eg515de5ec7c76"
msgid "The little thieves would have picked the whole grove clean."
msgstr "그 조그만 도둑놈들이 온 숲을 싹 털어갔을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD_Captive
#. Speaker = Findal
#. NodeID = 65c98d0d-ea84-4762-a3fa-7709626526ce
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 683cb55e-08b9-c865-78a6-4e047ee62a24_B = True
#. SetFlags:
#.   Local:
#.     - 683cb55e-08b9-c865-78a6-4e047ee62a24_C = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD_Captive:65c98d0d-ea84-4762-a3fa-7709626526ce
msgctxt "h2683d677ga72dg4f49g94a3g56da716c115b"
msgid "Worthless junk."
msgstr "쓸모없는 쓰레기."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD_Captive
#. Speaker = Findal
#. NodeID = d2c0a716-d10b-4d51-b492-3837a64913e7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 683cb55e-08b9-c865-78a6-4e047ee62a24_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD_Captive:d2c0a716-d10b-4d51-b492-3837a64913e7
msgctxt "h54436054gf858g4dc8gb72eg182a5569b2cb"
msgid "Where did they find all of this clutter?"
msgstr "이 잡동사니들은 어디서 찾은 거람?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD_Captive
#. Speaker = Findal
#. NodeID = d41a28b8-09e0-4feb-8b71-addd3f53b310
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 683cb55e-08b9-c865-78a6-4e047ee62a24_C = True
#. SetFlags:
#.   Local:
#.     - 683cb55e-08b9-c865-78a6-4e047ee62a24_B = False
#.     - 683cb55e-08b9-c865-78a6-4e047ee62a24_C = False
#.     - 683cb55e-08b9-c865-78a6-4e047ee62a24_A = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD_Captive:d41a28b8-09e0-4feb-8b71-addd3f53b310
msgctxt "h955e84cag6a19g4b06ga78eg7fb513050420"
msgid "A litter of piglets would have kept the place tidier."
msgstr "돼지 새끼도 이것보단 깔끔하게 하고 살았겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD_CapturedGoblin
#. Speaker = Sazza
#. NodeID = 5bf97a8d-8505-e604-7583-7fbb8610d417
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD_CapturedGoblin:5bf97a8d-8505-e604-7583-7fbb8610d417
msgctxt "h72b74da6g4b8eg4e24gb934g92ce30bc6ab2"
msgid "They ain't as friendly as me. Not as clever either. Kill 'em."
msgstr "쟤들은 나처럼 친절하지 않아. 똑똑하지도 않고. 죽여버려."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD_Tracks
#. Speaker = Player
#. NodeID = 37b40733-f10e-f65d-66e0-67c865ae6ac2
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD_Tracks:37b40733-f10e-f65d-66e0-67c865ae6ac2
msgctxt "h3d0eba0dg6854g4cd0gb29fga274fb23289d"
msgid "Goblin tracks. You can practically smell the filth."
msgstr "고블린 흔적이야. 아직도 뚜렷한 악취가 남아있군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD_Tracks
#. Speaker = Player
#. NodeID = 37b40733-f10e-f65d-66e0-67c865ae6ac2
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD_Tracks:37b40733-f10e-f65d-66e0-67c865ae6ac2
msgctxt "h2016f9f1g0d12g47f5g982fg17f19b139f0f"
msgid "Goblin tracks. And far too many of them too."
msgstr "고블린 흔적이야. 엄청난 숫자군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD_Tracks
#. Speaker = Player
#. NodeID = 37b40733-f10e-f65d-66e0-67c865ae6ac2
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD_Tracks:37b40733-f10e-f65d-66e0-67c865ae6ac2
msgctxt "h1d7de9cfg0276g457fga01bgf75ebc284669"
msgid "Tracks. Mephits or... no, <i>goblins.</i>"
msgstr "자국이다. 메피트들인가 아니면... 이런, <i>고블린들이야.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD_Tracks
#. Speaker = Player
#. NodeID = 37b40733-f10e-f65d-66e0-67c865ae6ac2
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD_Tracks:37b40733-f10e-f65d-66e0-67c865ae6ac2
msgctxt "he7140763gb063g4d7dgaaecgb918f488f702"
msgid "Tracks. Small, bipedal. Goblins, perhaps."
msgstr "흔적이야. 작고, 두 다리로 걷는군. 아마 고블린일 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD_Tracks
#. Speaker = Player
#. NodeID = 37b40733-f10e-f65d-66e0-67c865ae6ac2
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD_Tracks:37b40733-f10e-f65d-66e0-67c865ae6ac2
msgctxt "hb888aabagaf0dg43c1ga7dbgb0fae0a4f5ba"
msgid "These tracks... squat, bow-legged... goblins, I'd say."
msgstr "이 흔적... 키가 작고, 안짱다리라... 고블린인 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD_Tracks
#. Speaker = Player
#. NodeID = 37b40733-f10e-f65d-66e0-67c865ae6ac2
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD_Tracks:37b40733-f10e-f65d-66e0-67c865ae6ac2
msgctxt "hc2da7b8fg4001g4182ga504g1b0fe35852e3"
msgid ""
"Tracks like these puncture the soil across the Sword Coast. Goblins, of "
"course."
msgstr "이 흙에 난 자국 같은 흔적들이 소드 코스트를 가로지르고 있어. 당연히 고블린들이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD_Tracks
#. Speaker = Player
#. NodeID = 37b40733-f10e-f65d-66e0-67c865ae6ac2
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_AD_Tracks:37b40733-f10e-f65d-66e0-67c865ae6ac2
msgctxt "hefe4dd12gd4d8g460ag9e6dg8c5c2054252a"
msgid "These tracks... goblins?"
msgstr "이 흔적... 고블린인가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_Captive
#. Speaker = Findal
#. NodeID = 05333995-5321-2c51-0d85-b30a9b114723
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_Captive:05333995-5321-2c51-0d85-b30a9b114723
msgctxt "h72dcafb1g538ag4e90gb011ge777731e4a3d"
msgid ""
"I told them - the only weapons here are the ones the foulbloods brought."
msgstr "전 그들에게 이곳의 무기는 더러운 혈통들이 가져온 무기밖에 없다고 말했죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_Captive
#. Speaker = Player
#. NodeID = 22f569c1-a7c0-8acf-1cf5-19f7439234ca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_Captive:22f569c1-a7c0-8acf-1cf5-19f7439234ca
msgctxt "h0e5b5386g26a7g4d73g8aa9g58ef29f2f46b"
msgid "How did those goblins slip into the grove?"
msgstr "그 고블린들은 어떻게 숲에 들어온 거죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_Captive
#. Speaker = Findal
#. NodeID = 38efffae-323f-b518-a1e5-cd5defc2c433
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_State_Returned = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_Captive:38efffae-323f-b518-a1e5-cd5defc2c433
msgctxt "h4b18cf93g1e27g409fga0d0gbbcfed36d7d0"
msgid "Peace is returning to the grove. We have you to thank for that."
msgstr "숲에 평화가 돌아오고 있어. 당신 덕분이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_Captive
#. Speaker = Findal
#. NodeID = 3ed6e1c4-4721-cc24-d153-83c4dcfda22f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_Captive:3ed6e1c4-4721-cc24-d153-83c4dcfda22f
msgctxt "he6033c76g69beg4cccgb487g6b1035b55aa0"
msgid "What? No!"
msgstr "뭐라고요? 안 돼!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_Captive
#. Speaker = Player
#. NodeID = 73372e3d-61d6-eb91-b8a0-487033970f9d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_Captive:73372e3d-61d6-eb91-b8a0-487033970f9d
msgctxt "hb40fb282gf520g451dga2c8gacf814a1959b"
msgid "I'm surprised the goblins didn't gut you on sight. Why didn't they?"
msgstr "고블린들이 만나자마자 당신 내장을 꺼내지 않은 게 놀랍군요. 왜 안 그런 건가요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_Captive
#. Speaker = Findal
#. NodeID = 74f3b35f-5dfe-a104-557c-935d70d60eeb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TIEFLING(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_Captive:74f3b35f-5dfe-a104-557c-935d70d60eeb
msgctxt "hd243c18cg01afg4d2dg9c63g309e4db0ea80"
msgid "I told them - the only weapons here are the ones the tieflings brought."
msgstr "여기엔 티플링이 가져온 무기밖에 없다고 말했죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_Captive
#. Speaker = Narrator
#. NodeID = 8eeceecb-90b7-434f-b1cc-15c426aa17ae
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GoblinScouts_Event_SavedCaptive = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_Captive:8eeceecb-90b7-434f-b1cc-15c426aa17ae
msgctxt "h172bb363ga6bdg46b6g8f17g60fd7e6c9b8c"
msgid ""
"*His breaths are shallow, his wounds deep. He doesn't respond to your voice.*"
msgstr "*그의 숨이 가파르고 상처가 깊습니다. 그는 당신의 목소리에 반응하지 않습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_Captive
#. Speaker = Player
#. NodeID = 9bd83404-2573-5893-67d9-527f51ac2fc4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_GoblinScouts_State_SavedDruid = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_Captive:9bd83404-2573-5893-67d9-527f51ac2fc4
msgctxt "hdf47acd2g28a8g4c58ga088g7c738d632dc2"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_Captive
#. Speaker = Findal
#. NodeID = a6402dfd-fb83-6a5a-31d7-9e2001b5869a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_GoblinScouts_HasMet_Captive(1) = True
#.   Quest:
#.     - HIDDEN_WLD_Boosters.DEN_GoblinScouts_SavedDruid(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_Captive:a6402dfd-fb83-6a5a-31d7-9e2001b5869a
msgctxt "h30b8afa1g8bf7g472ag898fg64329ac45163"
msgid "Oh, thank you, thank you. I thought I was going to die down here."
msgstr "오, 감사합니다, 감사합니다. 여기서 죽는 줄 알았습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_Captive
#. Speaker = Findal
#. NodeID = b844c4e2-f289-8a49-a22b-0a38cfc7cbdb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_Captive:b844c4e2-f289-8a49-a22b-0a38cfc7cbdb
msgctxt "hf7ef300eg1acbg454ega4c6g6cb450898397"
msgid "They were asking questions - about a weapon."
msgstr "그놈들은 제게 무기에 대한 질문을 했습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_Captive
#. Speaker = Findal
#. NodeID = b9e4e9ab-a86b-8cd5-87b0-73f075554e63
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_Captive:b9e4e9ab-a86b-8cd5-87b0-73f075554e63
msgctxt "hcfc4cd0egf866g4782gbea3g80a64477a7ad"
msgid ""
"No. I'd still be outside gathering herbs if I hadn't run into the goblins."
msgstr "없었습니다. 고블린을 만나지 않았다면 전 지금도 밖에서 약초를 채집하고 있었을 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_Captive
#. Speaker = Findal
#. NodeID = bfd77d57-2de0-cee2-349e-ef87753886f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_Captive:bfd77d57-2de0-cee2-349e-ef87753886f0
msgctxt "h6cf5da1fg38a5g4fa5g88a3gd6151e3529d8"
msgid ""
"It's my fault. I thought I'd given them the slip, but they followed me "
"through the tunnel back there."
msgstr "제 잘못입니다. 저는 그들을 따돌렸다고 생각했지만, 그들은 저 뒤의 터널을 통해 저를 따라왔습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_Captive
#. Speaker = Findal
#. NodeID = c0b16b9b-7909-c244-af03-32a89636f6f4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_GoblinScouts_State_SavedDruid = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_Captive:c0b16b9b-7909-c244-af03-32a89636f6f4
msgctxt "h476de8d7g364bg4ea7g9510g25038b204616"
msgid ""
"I must tell the others what happened. Step careful - there are traps in "
"these tunnels. And thank you again."
msgstr ""
"다른 이들에게 무슨 일이 있었는지 말해야겠습니다. 이 굴에는 함정이 다수 있으니 조심히 지나가세요. 그리고 다시 한 번 감사합니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_Captive
#. Speaker = Player
#. NodeID = eda4ef83-1249-d107-93ee-172ab6402e6f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_Captive:eda4ef83-1249-d107-93ee-172ab6402e6f
msgctxt "hb1e71fd8g94f6g4b54ga730gb2caf5d92946"
msgid "Was no one looking for you?"
msgstr "당신을 찾는 사람은 아무도 없었습니까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_Captive
#. Speaker = Findal
#. NodeID = efee4ca9-011a-e16c-b797-fbf0e1f018aa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GoblinScouts_State_SavedDruid = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_Captive:efee4ca9-011a-e16c-b797-fbf0e1f018aa
msgctxt "h2e8c0007g319fg4344ga9degf465cf63f975"
msgid "My saviour. I wish you could have visited in better times."
msgstr "은인이시군요. 분위기가 더 괜찮을 때 찾아오셨다면 좋았을 텐데요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_Captive
#. Speaker = Findal
#. NodeID = f0516396-c745-c26a-37e8-0bffe91fbb2d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Refugees_State_LeadersAreDead = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_Captive:f0516396-c745-c26a-37e8-0bffe91fbb2d
msgctxt "h8d9301f6gaeabg422cg8c82g61b4a30074fc"
msgid "From what I hear, you're making a habit of slaying goblins."
msgstr "듣자 하니, 고블린 죽이는 습관이 들고 있다던데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_Captive
#. Speaker = Player
#. NodeID = ff641221-9de5-02af-0a3c-21fe2a65e09b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GoblinScouts_Captive:ff641221-9de5-02af-0a3c-21fe2a65e09b
msgctxt "h1b55f40dg897bg4913g806fgf54dbd242957"
msgid "Don't thank me yet. I'm here to finish what they started."
msgstr "고마워하기는 일러. 난 그들이 시작한 일을 마무리하러 왔거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance
#. Speaker = Mino
#. NodeID = 05efba43-97a9-f981-d980-f70036f71f54
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance:05efba43-97a9-f981-d980-f70036f71f54
msgctxt "h8218e76bg0bcbg46cdgafbeg34c04c277848"
msgid "A moment, Jeorna."
msgstr "지오르나, 잠시."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance
#. Speaker = Player
#. NodeID = 0d7204fb-8469-5108-598b-a3aa8cb2dd0f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance:0d7204fb-8469-5108-598b-a3aa8cb2dd0f
msgctxt "h10172bdag234eg42aagb284g3da7bd59566a"
msgid "I'm not looking for trouble. Can't you just let me by?"
msgstr "문제를 일으키려는 건 아니야. 그냥 지나가게 해주면 안 될까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance
#. Speaker = Player
#. NodeID = 150fbe7e-ee56-84fb-1354-156bdb5f52c0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TeleportOutOfTrespass(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance:150fbe7e-ee56-84fb-1354-156bdb5f52c0
msgctxt "hac1a9943g3757g46e1ga366g78121a03bf72"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance
#. Speaker = Player
#. NodeID = 15efb51e-3e22-f6aa-0096-9d9415bfcbf2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 0884581d-9f92-0a34-9440-6a54c0813bbe_TryPushingPast = True
#. SetFlags:
#.   Global:
#.     - DEN_GuardedEntrance_Event_StartDruidAttack = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance:15efb51e-3e22-f6aa-0096-9d9415bfcbf2
msgctxt "h8a6d6253gc270g48aega6d5g7deb25e19d82"
msgid "<i>Attack them.</i>"
msgstr "<i>이들을 공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance
#. Speaker = Player
#. NodeID = 163f694c-2b30-42eb-b004-9c8d16ba0b60
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 0884581d-9f92-0a34-9440-6a54c0813bbe_WhyNoEntry = False
#. SetFlags:
#.   Local:
#.     - 0884581d-9f92-0a34-9440-6a54c0813bbe_WhyNoEntry = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance:163f694c-2b30-42eb-b004-9c8d16ba0b60
msgctxt "h0b3c2975g222eg42edg8683gc8b478e6fd82"
msgid "No need for threats. Why can't I move around freely here?"
msgstr "위협할 필요는 없잖아. 왜 마음대로 돌아다녀선 안되는 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance
#. Speaker = Jeorna
#. NodeID = 1795d162-2a7f-4276-a909-9a22201885b5
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance:1795d162-2a7f-4276-a909-9a22201885b5
msgctxt "h8a79f411gbc98g4455ga58fg1d17cfc0321d"
msgid "Calm, Maggran. Give him a chance."
msgstr "진정해, 마그란. 그에게 말할 기회는 줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance
#. Speaker = Jeorna
#. NodeID = 1795d162-2a7f-4276-a909-9a22201885b5
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance:1795d162-2a7f-4276-a909-9a22201885b5
msgctxt "hfc5304c4gf8e3g4dbcgbfb7g104ed069b182"
msgid "Calm, Maggran. Give her a chance."
msgstr "진정해, 마그란. 그녀에게 말할 기회는 줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance
#. Speaker = Jeorna
#. NodeID = 1795d162-2a7f-4276-a909-9a22201885b5
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance:1795d162-2a7f-4276-a909-9a22201885b5
msgctxt "h04e4554fgaed6g4717gacf9g33722621fd0a"
msgid "Calm, Maggran. Give them a chance."
msgstr "진정해, 마그란. 그들에게 말할 기회는 줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance
#. Speaker = Jeorna
#. NodeID = 1a53981e-236e-82a4-0117-068a4b0e05ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance:1a53981e-236e-82a4-0117-068a4b0e05ec
msgctxt "hbcd826a5gf0f6g44ddg9a0eg62280823be2f"
msgid ""
"Druid or not, you're still an outsider to <i>this </i>place. Entry is "
"forbidden."
msgstr "드루이드건, 아니건 당신은 <i>이 </i>장소에서 외부인이야. 출입은 금지되어 있다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance
#. Speaker = Jeorna
#. NodeID = 1fb45947-3553-7bd1-dca4-61f5cabd24cb
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance:1fb45947-3553-7bd1-dca4-61f5cabd24cb
msgctxt "h9ffd7adcg598dg4ed1gb7ffg680f21e62596"
msgid "What...? Why would she allow one of them? I... I suppose so, yes."
msgstr "뭐라고...? 그녀가 왜 저들 중 한 명을 허락한 거지? 나... 나는, 좋아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance
#. Speaker = Jeorna
#. NodeID = 1fb45947-3553-7bd1-dca4-61f5cabd24cb
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance:1fb45947-3553-7bd1-dca4-61f5cabd24cb
msgctxt "hb5d48bebge930g4344g8af2gcc35586407c7"
msgid "What...? Oh. I understand."
msgstr "뭐...? 아. 그래."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance
#. Speaker = Maggran
#. NodeID = 26fb3122-41ac-5f6f-7aea-229a27aa665b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance:26fb3122-41ac-5f6f-7aea-229a27aa665b
msgctxt "h640fbf5fgbe74g4278ga7d2g7ae185ca0c38"
msgid "*Roar!*"
msgstr "*으르렁!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance
#. Speaker = Jeorna
#. NodeID = 3ae97224-4be6-a4b6-2dbc-2b2211e13826
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DROWELF(1) = False
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_Knows_KaghaRequestedPlayers = True
#.     - DEN_GuardedEntrance_State_ClearToPass = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance:3ae97224-4be6-a4b6-2dbc-2b2211e13826
msgctxt "h629de9bfge4f2g4114gaf68g8035ea13b9fd"
msgid "You - apparently Kagha wants to see you. Go ahead."
msgstr "당신, 듣자 하니 카그하가 당신을 만나고 싶은 것 같네. 들어와."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance
#. Speaker = Jeorna
#. NodeID = 55849bdc-01bd-92b9-5321-5e49328fa895
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GuardedEntrance_Event_ApproachingFromPool = True
#. SetFlags:
#.   Dialog:
#.     - DEN_GuardedEntrance_HasMet(1) = True
#. TagRule: DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance:55849bdc-01bd-92b9-5321-5e49328fa895
msgctxt "h1e3e4a63g8968g4fb3gabd4gb91990a308b4"
msgid "<i>Stop!</i> Move back at once. We'll not tolerate drow in our grove."
msgstr "<i>정지!</i> 당장 물러서라. 우리 숲에 드로우를 허용할 순 없다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance
#. Speaker = Jeorna
#. NodeID = 55849bdc-01bd-92b9-5321-5e49328fa895
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GuardedEntrance_Event_ApproachingFromPool = True
#. SetFlags:
#.   Dialog:
#.     - DEN_GuardedEntrance_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance:55849bdc-01bd-92b9-5321-5e49328fa895
msgctxt "h273d6bcbga00dg4c4fgb7c5gfe98f071302e"
msgid "<i>Stop! </i>Move back at once."
msgstr "<i>정지! </i>당장 물러서라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance
#. Speaker = Jeorna
#. NodeID = 579bff3c-3fe6-f1b0-b2e4-d34a8419437f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance:579bff3c-3fe6-f1b0-b2e4-d34a8419437f
msgctxt "hf621c679gfa6eg44c6g99d5g74993e61a6f6"
msgid "Keep back. Force my hand, and I'll show you its claws."
msgstr "물러서. 내가 손을 쓰도록 재촉하면 발톱을 보여주겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance
#. Speaker = Jeorna
#. NodeID = 5b62401a-a401-4e3a-fc7b-9c609140d9f2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance:5b62401a-a401-4e3a-fc7b-9c609140d9f2
msgctxt "h7c04ee90g3bafg4e69g8eeegbdb2d8ed8098"
msgid ""
"<i>Stop!</i> Another step and Maggran will tear you open like a sack of "
"grain."
msgstr "<i>정지!</i> 한 발짝이라도 더 다가왔다간 마그란이 네놈을 보릿자루처럼 찢어놓을 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance
#. Speaker = Player
#. NodeID = 694abd2c-f2da-b9c2-5a94-5bfaab437c55
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 0884581d-9f92-0a34-9440-6a54c0813bbe_TryPushingPast = False
#. SetFlags:
#.   Local:
#.     - 0884581d-9f92-0a34-9440-6a54c0813bbe_TryPushingPast = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance:694abd2c-f2da-b9c2-5a94-5bfaab437c55
msgctxt "h5cd37763geb45g4accg89b5g2127fdcdbff9"
msgid "<i>Ignore them and proceed.</i>"
msgstr "<i>그들을 무시하고 지나간다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance
#. Speaker = Jeorna
#. NodeID = 7488d17a-3804-954a-3708-05913396780f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance:7488d17a-3804-954a-3708-05913396780f
msgctxt "h22b57f93g8201g4f9dg9eadgb569dea46d56"
msgid "It's forbidden to outsiders - Kagha's orders."
msgstr "외부인에게는 금지되어 있다. 카그하 님의 명령이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance
#. Speaker = Player
#. NodeID = 877e9f96-46c3-735b-622b-79aabb1bf7d4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = True
#. TagRule: TIEFLING
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance:877e9f96-46c3-735b-622b-79aabb1bf7d4
msgctxt "h6807686cgf49cg4d7eg87f1g8468ab29374d"
msgid ""
"I am a druid first, tiefling second. Allow me to enter and pay my respects."
msgstr "티플링이긴 하지만, 드루이드가 내 정체성이다. 날 존중하고 지나가게 해줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance
#. Speaker = Player
#. NodeID = 877e9f96-46c3-735b-622b-79aabb1bf7d4
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = True
#. TagRule: DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance:877e9f96-46c3-735b-622b-79aabb1bf7d4
msgctxt "h62743324g2c96g4a8cgaca8ga8820b77750d"
msgid "I am a druid first, drow second. Allow me to enter and pay my respects."
msgstr "드로우이긴 하지만, 드루이드가 내 정체성이다. 날 존중하고 지나가게 해줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance
#. Speaker = Player
#. NodeID = 877e9f96-46c3-735b-622b-79aabb1bf7d4
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance:877e9f96-46c3-735b-622b-79aabb1bf7d4
msgctxt "h23d68de3g98f9g4fe3ga787g4630d841015e"
msgid ""
"I am a druid, same as yourself. Allow me to pass and pay my respects. Please."
msgstr "나도 너처럼 드루이드잖아. 날 존중하고 지나가게 해줘. 제발."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance
#. Speaker = Jeorna
#. NodeID = 9b69ed72-4db4-5a2a-7aa0-a84ea77a1a7f
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: TIEFLING
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance:9b69ed72-4db4-5a2a-7aa0-a84ea77a1a7f
msgctxt "h8e8ef417g597dg453ag9aecg9e17a8658b5a"
msgid "You - step back. Go join the other tieflings."
msgstr "당신 - 뒤로 물러나. 다른 티플링들한테나 가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance
#. Speaker = Jeorna
#. NodeID = 9b69ed72-4db4-5a2a-7aa0-a84ea77a1a7f
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DROWELF or DROWHALFELF
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance:9b69ed72-4db4-5a2a-7aa0-a84ea77a1a7f
msgctxt "h818bcf00g2602g4db8g9a81gf24c4e912677"
msgid "You - step back. We'll not tolerate drow in here."
msgstr "너, 뒤로 물러서. 여긴 드로우 따위 받아주지 않는다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance
#. Speaker = Jeorna
#. NodeID = 9b69ed72-4db4-5a2a-7aa0-a84ea77a1a7f
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance:9b69ed72-4db4-5a2a-7aa0-a84ea77a1a7f
msgctxt "hcc8f08c9g37c9g4795gba7dged90945308ff"
msgid "You - get back."
msgstr "당신 - 뒤로 물러나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance
#. Speaker = Maggran
#. NodeID = a59011d5-894e-fa2f-3f77-5c6924c6268c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance:a59011d5-894e-fa2f-3f77-5c6924c6268c
msgctxt "haefa6f62g719eg4315gbe01g2e2659d2edfd"
msgid "*Roar!*"
msgstr "*으르렁!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance
#. Speaker = Player
#. NodeID = a5ad4f88-3171-1407-3bc0-264296b88832
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 0884581d-9f92-0a34-9440-6a54c0813bbe_ProceedToSecondStage = False
#. SetFlags:
#.   Local:
#.     - 0884581d-9f92-0a34-9440-6a54c0813bbe_ProceedToSecondStage = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance:a5ad4f88-3171-1407-3bc0-264296b88832
msgctxt "h294aada7ga639g4435gb36eg1de6adea8948"
msgid ""
"If it weren't for me, you'd be overrun by goblins by now. I'll go where I "
"please."
msgstr "내가 아니었다면, 너흰 고블린 밥이 되었을 거야. 난 내 마음대로 다니겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance
#. Speaker = Jeorna
#. NodeID = bb6859a5-478b-2ae8-97e8-81fba9fad2fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance:bb6859a5-478b-2ae8-97e8-81fba9fad2fc
msgctxt "hb13777abgefd0g48abg9f5eg2ccfc416aed7"
msgid ""
"<i>No.</i> And you'll find trouble all the same, unless you get out of my "
"sight."
msgstr "<i>안 돼.</i>내 시야에서 벗어나지 않으면, 어차피 문제가 생길 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance
#. Speaker = Maggran
#. NodeID = cc9989e5-31b2-2f12-9136-f028602282f9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_GuardedEntrance_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_GuardedEntrance_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance:cc9989e5-31b2-2f12-9136-f028602282f9
msgctxt "hf604e812g25d3g4747g9858g1580fdf49d58"
msgid "*Roar!*"
msgstr "*으르렁!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance
#. Speaker = Jeorna
#. NodeID = d11abf4e-cf61-39e0-6b24-ca3b78309eb0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_GuardedEntrance_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance:d11abf4e-cf61-39e0-6b24-ca3b78309eb0
msgctxt "h12d17760g47f5g4e04g8d79ga95fa174cdf8"
msgid ""
"You're testing my patience. Leave, unless you want to see my other face."
msgstr "내 인내심을 시험하는군. 떠나라, 내 다른 얼굴을 보고 싶지 않다면 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance
#. Speaker = Jeorna
#. NodeID = db9f7ad9-9aa1-fb2c-5f93-9d1179e2a6ed
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_GuardedEntrance_State_ClearToPass = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance:db9f7ad9-9aa1-fb2c-5f93-9d1179e2a6ed
msgctxt "h8774fbaag7d76g4f26g9e3eg8f68d7666e19"
msgid ""
"But a word of warning. One wrong move and every single animal here will tear "
"you apart."
msgstr "하지만 경고 하나 해 두지. 한 발짝이라도 잘못 움직였다간 이곳의 모든 동물이 네놈을 찢어버릴 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance
#. Speaker = Player
#. NodeID = f7aa708b-a214-706c-fcd6-aef185522be3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 0884581d-9f92-0a34-9440-6a54c0813bbe_WhyNoEntry = False
#. SetFlags:
#.   Local:
#.     - 0884581d-9f92-0a34-9440-6a54c0813bbe_WhyNoEntry = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance:f7aa708b-a214-706c-fcd6-aef185522be3
msgctxt "h6971b210g0d6eg4033ga56cg0bb6c8fc523b"
msgid "Why? What's so special down here?"
msgstr "어째서지? 이 아래에 뭐가 그렇게 특별한 게 있는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_Parents
#. Speaker = Locke
#. NodeID = 24c1f59a-c4b2-4aa4-09c4-8ea059cc97ac
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GuardedEntrance_State_ParentsKnowDeath = True
#.   Local:
#.      - 3483cea8-0c11-9432-2421-6b95b9140d95_B = True
#. SetFlags:
#.   Local:
#.     - 3483cea8-0c11-9432-2421-6b95b9140d95_A = False
#.     - 3483cea8-0c11-9432-2421-6b95b9140d95_B = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_Parents:24c1f59a-c4b2-4aa4-09c4-8ea059cc97ac
msgctxt "h6af4d694g55f0g4e9bg960dg227294b99026"
msgid "Arabella. No. NO."
msgstr "아라벨라. 안 돼. 안 돼!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_Parents
#. Speaker = Komira
#. NodeID = 274b5f4d-6ca9-10d8-476d-5ee23c6a0834
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3483cea8-0c11-9432-2421-6b95b9140d95_B = True
#. SetFlags:
#.   Local:
#.     - 3483cea8-0c11-9432-2421-6b95b9140d95_A = False
#.     - 3483cea8-0c11-9432-2421-6b95b9140d95_B = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_Parents:274b5f4d-6ca9-10d8-476d-5ee23c6a0834
msgctxt "h47472aa8g1144g4030g9442g90e353f77c44"
msgid "I could take one of the guards. Maybe two."
msgstr "경비 한 명 정도는 때려눕힐 수 있어. 잘 하면 두 명까지도."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_Parents
#. Speaker = Locke
#. NodeID = 33e2fc69-27db-6bcb-e3d0-ab673ba60e8b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_Parents:33e2fc69-27db-6bcb-e3d0-ab673ba60e8b
msgctxt "hcc27e6c3gb785g44fega433g5e15b7d62dc7"
msgid "What about the bear? I'd like to keep our guts on the inside."
msgstr "저 곰은 어쩔 건데? 내장 찢기는 건 싫다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_Parents
#. Speaker = Locke
#. NodeID = 3cbf3211-b6ec-b9e0-0e75-920d85b493f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_Parents:3cbf3211-b6ec-b9e0-0e75-920d85b493f1
msgctxt "h730c4a66g75c9g463dg867cg2b992b8a636b"
msgid "I bet she's giving them hell. She's not our kid for nothing."
msgstr "혼쭐을 내주고 있을 거야. 괜히 우리 애가 아니잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_Parents
#. Speaker = Komira
#. NodeID = 3d3a0978-3d39-08a9-e857-2fab5ff75cdd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_Parents:3d3a0978-3d39-08a9-e857-2fab5ff75cdd
msgctxt "h4c0dcdeeg0ad2g4bedga3bfg3183b19c8e7d"
msgid "Shh. Love. Not here."
msgstr "쉿. 여보. 여기선 안돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_Parents
#. Speaker = Komira
#. NodeID = 47c0e637-5001-5888-3d57-32762bf85a4f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_Parents:47c0e637-5001-5888-3d57-32762bf85a4f
msgctxt "h0a204d3bga136g4c8bgbb75g755a87a52673"
msgid "We didn't do this, do you hear me? It was <i>Kagha</i>."
msgstr "우리가 그런 게 아니잖아. 내 말 들려? <i>카그하</i> 그 년 짓이라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_Parents
#. Speaker = Locke
#. NodeID = 4ed230b9-80a2-1276-9874-fbf1400afe4c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_Parents:4ed230b9-80a2-1276-9874-fbf1400afe4c
msgctxt "h633428e9g34c3g4f32gbee7g785d40dd0fc8"
msgid "Cursed druids. I hate them all."
msgstr "망할 드루이드 놈들. 그 새끼들 다 싫어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_Parents
#. Speaker = Komira
#. NodeID = 548061d1-9be0-36a2-20cd-9cb9d0f1070c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3483cea8-0c11-9432-2421-6b95b9140d95_A = True
#. SetFlags:
#.   Local:
#.     - 3483cea8-0c11-9432-2421-6b95b9140d95_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_Parents:548061d1-9be0-36a2-20cd-9cb9d0f1070c
msgctxt "hfd9ebaf2g5a01g45b5g979dgb2dc65282783"
msgid "Gods. She must be terrified."
msgstr "세상에. 잔뜩 겁에 질려 있을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_Parents
#. Speaker = Locke
#. NodeID = 7c84b003-2299-dcce-a887-098bb625e625
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 3483cea8-0c11-9432-2421-6b95b9140d95_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_Parents:7c84b003-2299-dcce-a887-098bb625e625
msgctxt "hf3e0bf49g952eg4f0dg8484gd451c904bf61"
msgid "I could try grease some palms - ease things over."
msgstr "돈을 좀 주고 상황을 원만하게 해결해 볼 수도 있었을 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_Parents
#. Speaker = Komira
#. NodeID = 910df529-fbdb-7a50-70b9-77bd96783116
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_Parents:910df529-fbdb-7a50-70b9-77bd96783116
msgctxt "h1da5b4f5ga1a8g4e78ga800gb7d296481ac5"
msgid "Because that went so well last time."
msgstr "왜냐하면 전에도 잘 먹혔기 때문이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_Parents
#. Speaker = Locke
#. NodeID = 938961c8-0e55-414f-f6df-2578541230d8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GuardedEntrance_State_ParentsKnowDeath = True
#.   Local:
#.      - 3483cea8-0c11-9432-2421-6b95b9140d95_A = True
#. SetFlags:
#.   Local:
#.     - 3483cea8-0c11-9432-2421-6b95b9140d95_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_Parents:938961c8-0e55-414f-f6df-2578541230d8
msgctxt "hd50a6ce9ge1efg4670g92f4gefbfb16f2595"
msgid "Why didn't we stop her? We should've stopped her!"
msgstr "왜 막지 않았을까? 막았어야만 했어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_Parents
#. Speaker = Locke
#. NodeID = ae0c229e-47e2-101c-ab2f-2c831f65f05d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GuardedEntrance_State_ParentsKnowDeath = True
#. SetFlags:
#.   Local:
#.     - 3483cea8-0c11-9432-2421-6b95b9140d95_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_Parents:ae0c229e-47e2-101c-ab2f-2c831f65f05d
msgctxt "h7581017agc45dg4060g8ec4gdb82fb7586ef"
msgid "I'll kill her - I'll kill the snake."
msgstr "그 년을 죽여버릴 거야, 그 뱀 년을 죽일 거라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_Parents
#. Speaker = Komira
#. NodeID = d8e5cdee-ef68-e129-56c7-be8b4c140fee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_Parents:d8e5cdee-ef68-e129-56c7-be8b4c140fee
msgctxt "h9772743cgbe12g4f4bgb566g44a86390e22c"
msgid "I've got you. I'm here."
msgstr "괜찮아 여보. 내가 있잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_ParentsLeaving
#. Speaker = Locke
#. NodeID = 1b9c0aa6-0d62-82ba-1a1d-9ffb07a84fe1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_ParentsLeaving:1b9c0aa6-0d62-82ba-1a1d-9ffb07a84fe1
msgctxt "h5e8dfa14g632bg41f1gb81fg7f075ad1ffc1"
msgid "I'd rather you not get eaten by a <i>bear.</i>"
msgstr "난 당신이 <i>곰</i>에게 먹히길 바라지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_ParentsLeaving
#. Speaker = Komira
#. NodeID = f565ab51-744b-ccb4-2620-c1ab7abe5046
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_ParentsLeaving:f565ab51-744b-ccb4-2620-c1ab7abe5046
msgctxt "hab360f3dg87c6g4610g85b2g7056db887a36"
msgid "Damn it. We could have taken those guards."
msgstr "젠장. 저 경비병들을 처리할 수 있었을 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_ParentsScene
#. Speaker = Jeorna
#. NodeID = 19c540c5-2f5c-433e-38f4-932c989577a1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_ParentsScene:19c540c5-2f5c-433e-38f4-932c989577a1
msgctxt "hf47eff39ga85eg4d3egb236g08920968cc04"
msgid "Step back - you sully our holy ground!"
msgstr "물러서. 당신이 우리 신성한 땅을 더럽히고 있잖아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_ParentsScene
#. Speaker = Komira
#. NodeID = 35bd698f-063d-af9b-bdb5-059974c3fbf3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - fbfd203c-2da1-e3f1-0b02-3ac43e6305d4_A = True
#. SetFlags:
#.   Local:
#.     - fbfd203c-2da1-e3f1-0b02-3ac43e6305d4_A = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_ParentsScene:35bd698f-063d-af9b-bdb5-059974c3fbf3
msgctxt "hfb2af4fbgb14cg4f97gbcb2gf99931538f79"
msgid "You tree-hugging bastard!"
msgstr "이 나무 성애자 개자식들!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_ParentsScene
#. Speaker = Locke
#. NodeID = 427fa17f-7310-0bc7-cf18-2ee1766e3487
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - fbfd203c-2da1-e3f1-0b02-3ac43e6305d4_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_ParentsScene:427fa17f-7310-0bc7-cf18-2ee1766e3487
msgctxt "ha563d92dg0614g4f89g8538g30878f64aee5"
msgid "Please - let us through."
msgstr "제발 - 우릴 지나가게 해줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_ParentsScene
#. Speaker = Jeorna
#. NodeID = 9fde9dc2-1b59-e16f-a10b-53c9177d0233
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_ParentsScene:9fde9dc2-1b59-e16f-a10b-53c9177d0233
msgctxt "h57a5c98cg7d97g4556ga9bbg07554dfea8ee"
msgid "It is forbidden!"
msgstr "여긴 통행 금지다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_ParentsSeeCorpse
#. Speaker = Komira
#. NodeID = 14c3ceb6-bb4f-162d-1d3c-86335d087b8b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GuardedEntrance_State_ParentsKnowDeath = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_ParentsSeeCorpse:14c3ceb6-bb4f-162d-1d3c-86335d087b8b
msgctxt "hdd8baba9g148eg4af7g9f3cg47179dd891d8"
msgid "*Sob.*"
msgstr "*훌쩍.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_ParentsSeeCorpse
#. Speaker = Komira
#. NodeID = 6df4d303-9f42-0535-3016-9ad5d28fd6dd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_ParentsSeeCorpse:6df4d303-9f42-0535-3016-9ad5d28fd6dd
msgctxt "h4be5b5c8gfc87g4270gaa2egc65332a2ec0f"
msgid "My baby. My baby girl."
msgstr "내 아이. 내 소중한 아이."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_ParentsSeeCorpse
#. Speaker = Locke
#. NodeID = 8279ed93-6f48-e479-6660-12312a9d34b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_ParentsSeeCorpse:8279ed93-6f48-e479-6660-12312a9d34b4
msgctxt "h79e39fddgf99eg4db8g9c0fg80e47d717b79"
msgid "No. <i>Please. </i>"
msgstr "안 돼. <i>제발. </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_ParentsSeeCorpse
#. Speaker = Komira
#. NodeID = c2a1e0e3-e4a1-a42c-7b36-1d7228aa3946
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_GuardedEntrance_State_ParentsKnowDeath = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_ParentsSeeCorpse:c2a1e0e3-e4a1-a42c-7b36-1d7228aa3946
msgctxt "h5579cbe5g5e2eg4c4bga044g27eb9e5f627c"
msgid "ARABELLA."
msgstr "<b>아라벨라</b>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_ParentsWithKid
#. Speaker = Komira
#. NodeID = 1410d896-66ad-4ad6-e4c5-d1e19321a7a2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_ParentsWithKid:1410d896-66ad-4ad6-e4c5-d1e19321a7a2
msgctxt "h05528976g93f6g41a1g9362g76f144ed7faf"
msgid "Quiet, you pup."
msgstr "조용히 해, 요 녀석아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_ParentsWithKid
#. Speaker = Locke
#. NodeID = 23d01ab5-7081-7a35-604f-da8c4416f1e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_ParentsWithKid:23d01ab5-7081-7a35-604f-da8c4416f1e6
msgctxt "h6d6344a4g79a6g406agb06egbc4c0787e873"
msgid "Your mother was a heartbeat away from fighting a bear."
msgstr "너의 엄마는 곰과 싸우기 직전이었지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_ParentsWithKid
#. Speaker = Komira
#. NodeID = 425e1bfd-07d8-ce39-3720-c1d55e3bae32
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - abb79b97-ca94-26b9-b46e-63c0ca8c5661_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_ParentsWithKid:425e1bfd-07d8-ce39-3720-c1d55e3bae32
msgctxt "h8cf94589g6f01g47fdg990egd15e4f71c8da"
msgid "Stealing the idol - what were you thinking?"
msgstr "우상을 훔치다니, 대체 무슨 생각을 한 거니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_ParentsWithKid
#. Speaker = Arabella
#. NodeID = 4c596db6-cd5c-74bb-9b88-d81164d12761
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_ParentsWithKid:4c596db6-cd5c-74bb-9b88-d81164d12761
msgctxt "hb5d892e1ga256g4eefgb613gc135ef51e133"
msgid "Isn't that how mum usually is?"
msgstr "엄마는 항상 그렇지 않아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_ParentsWithKid
#. Speaker = Locke
#. NodeID = 52da5a5a-1c37-d794-6fb3-55dcb6538e4f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_ParentsWithKid:52da5a5a-1c37-d794-6fb3-55dcb6538e4f
msgctxt "hb2e7f0cbg0c6ag4d27g8271gb211c157f819"
msgid "That girl. I don't care what Mol says. That was stupid and reckless."
msgstr "그 애가. 몰이 뭐라 하는진 상관 없어. 그건 멍청하고 무모한 행동이었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_ParentsWithKid
#. Speaker = Locke
#. NodeID = 868ea7cf-5daa-ef39-dc4d-515dd2322bcd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - abb79b97-ca94-26b9-b46e-63c0ca8c5661_A = True
#. SetFlags:
#.   Local:
#.     - abb79b97-ca94-26b9-b46e-63c0ca8c5661_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_ParentsWithKid:868ea7cf-5daa-ef39-dc4d-515dd2322bcd
msgctxt "hc469e936g3c4cg4cb2ga895g5be354633514"
msgid "Bells, it's our job to get us out of here safely - not yours."
msgstr "벨, 우릴 여기서 안전하게 빠져나가게 하는 건 우리 일이란다, 네 책임이 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_ParentsWithKid
#. Speaker = Arabella
#. NodeID = 8f51075b-9251-3852-cf3c-8a68ef4e778f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_ParentsWithKid:8f51075b-9251-3852-cf3c-8a68ef4e778f
msgctxt "hf369e0cbgc3aag4ee0g973dg204f75a1ebd6"
msgid "It's my job too. The druids don't care about us. No one does."
msgstr "제 일이기도 해요. 드루이드들은 우리한테 아무 관심도 없어요. 모두가 그래요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_ParentsWithKid
#. Speaker = Arabella
#. NodeID = ada062d9-f221-92fa-d3d5-20135385d381
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_ParentsWithKid:ada062d9-f221-92fa-d3d5-20135385d381
msgctxt "h30aff41cg63f9g49abgb276g6ed0a1501bc5"
msgid "I was<i> trying </i>to help."
msgstr "그저 <i>도우려고</i> 한 것뿐이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_ParentsWithKid
#. Speaker = Arabella
#. NodeID = b00e6d87-0205-4989-683b-123b08edcb75
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - abb79b97-ca94-26b9-b46e-63c0ca8c5661_B = True
#. SetFlags:
#.   Local:
#.     - abb79b97-ca94-26b9-b46e-63c0ca8c5661_B = False
#.     - abb79b97-ca94-26b9-b46e-63c0ca8c5661_A = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_ParentsWithKid:b00e6d87-0205-4989-683b-123b08edcb75
msgctxt "hc434ce47g14b0g419ega692g734fdb347247"
msgid "Stop. I was fine."
msgstr "그만해요. 전 괜찮다고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_ParentsWithKid
#. Speaker = Arabella
#. NodeID = f47207b7-7f4b-9581-eb20-31b5d4f91738
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_ParentsWithKid:f47207b7-7f4b-9581-eb20-31b5d4f91738
msgctxt "haf16cce7g494eg44ceg90cbgbcfa0bcef4b3"
msgid "We have to look after ourselves. That's what Mol says."
msgstr "우린 서로를 챙겨야 해요. 몰이 그랬어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_ParentsWithKid
#. Speaker = Locke
#. NodeID = fc5e350f-077d-6267-4402-7128160da4c2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_ParentsWithKid:fc5e350f-077d-6267-4402-7128160da4c2
msgctxt "h2a806fafg88e9g4534g8157gcceb44caca33"
msgid ""
"You nearly died, do you hear me? What would your mother and I have done?"
msgstr "거의 죽을 뻔했잖아, 알아 들어? 네 엄마와 내가 어떤 심정이었는지 모르겠니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_Protesters
#. Speaker = Rechel
#. NodeID = 0a12f3c3-db94-73b9-d412-dbe67bf7e46e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 62fae314-93ea-8fdb-5194-527d37ac3e55_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_Protesters:0a12f3c3-db94-73b9-d412-dbe67bf7e46e
msgctxt "h21354569g8df1g423ag9043gffecff039f8e"
msgid "Do all the damn rituals you want - we're not leaving 'til it's safe!"
msgstr "망할 의례나 마음껏 치르라지. 안전해질 때까진 떠나지 않을 거니까!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_Protesters
#. Speaker = Amek
#. NodeID = 5db5d417-2598-4a9d-17dc-7f1dcfd5bc18
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_Protesters:5db5d417-2598-4a9d-17dc-7f1dcfd5bc18
msgctxt "hb30ead71g89fbg4645gab03gb02d56e65ef6"
msgid "At least they've calmed down now."
msgstr "적어도 이젠 잠잠해졌잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_Protesters
#. Speaker = Xeph
#. NodeID = 60c6d331-f8d3-0334-719b-dfd41272dda6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_Protesters:60c6d331-f8d3-0334-719b-dfd41272dda6
msgctxt "hdf02d343gfeeag4924gad50gc96c12a94a3d"
msgid ""
"Probably hoarding supplies for themselves. Seems like something they'd do."
msgstr "자기네들 쓸 보급품이라도 쌓아 뒀나 보지. 그놈들은 그러고도 남아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_Protesters
#. Speaker = Amek
#. NodeID = 6b14fcc5-564f-b9c8-14ee-8fbaf76232d1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_Protesters:6b14fcc5-564f-b9c8-14ee-8fbaf76232d1
msgctxt "hd0296550g27a6g4326gbd16ge985d54999d3"
msgid "We're not scared of you!"
msgstr "당신네들 무섭지 않다고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_Protesters
#. Speaker = Xeph
#. NodeID = 6b18c3f7-bcd1-cc9a-2ada-a4d3acb32edc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 62fae314-93ea-8fdb-5194-527d37ac3e55_C = True
#. SetFlags:
#.   Local:
#.     - 62fae314-93ea-8fdb-5194-527d37ac3e55_B = False
#.     - 62fae314-93ea-8fdb-5194-527d37ac3e55_C = False
#.     - 62fae314-93ea-8fdb-5194-527d37ac3e55_A = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_Protesters:6b18c3f7-bcd1-cc9a-2ada-a4d3acb32edc
msgctxt "heb1567ceg552ag43acg853dg60f06c6fd36f"
msgid "You lot're the same as those bloody goblins!"
msgstr "당신네는 고블린이랑 똑같아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_Protesters
#. Speaker = Xeph
#. NodeID = 7cdd744d-6e9a-ee1d-cfc5-add5e54954be
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 62fae314-93ea-8fdb-5194-527d37ac3e55_A = True
#. SetFlags:
#.   Local:
#.     - 62fae314-93ea-8fdb-5194-527d37ac3e55_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_Protesters:7cdd744d-6e9a-ee1d-cfc5-add5e54954be
msgctxt "h40329800g1feeg417ag86a5g7e659f5c1614"
msgid "Keep this up an' you'll have blood on your hands!"
msgstr "계속 이러다가는 손에 피를 묻히게 될 거야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_Protesters
#. Speaker = Rechel
#. NodeID = 8712e75d-cf21-8aba-d600-2acfd6a0feaa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_State_DruidsPacified = True
#.   Local:
#.      - 62fae314-93ea-8fdb-5194-527d37ac3e55_A = False
#. SetFlags:
#.   Local:
#.     - 62fae314-93ea-8fdb-5194-527d37ac3e55_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_Protesters:8712e75d-cf21-8aba-d600-2acfd6a0feaa
msgctxt "hf76de5acgac62g4747g9159g5d204417399a"
msgid "Bloody druids. Making more hassle for us over nothing."
msgstr "망할 드루이드 놈들. 쓸데없는 걸로 우릴 들들 볶고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_Protesters
#. Speaker = Amek
#. NodeID = 945f6a30-dfbe-da14-585c-0714b6ba2389
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 62fae314-93ea-8fdb-5194-527d37ac3e55_B = True
#. SetFlags:
#.   Local:
#.     - 62fae314-93ea-8fdb-5194-527d37ac3e55_C = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_Protesters:945f6a30-dfbe-da14-585c-0714b6ba2389
msgctxt "h66a2ad63g57edg4014g9e14g373b6ead7c60"
msgid "Your master let us in here. We're your guests!"
msgstr "네 주인이 여기 들어오는걸 허락했어. 우린 손님이란 말이다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_Protesters
#. Speaker = Rechel
#. NodeID = 9dbc4257-8623-ac06-9730-69c3bfd6738f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_Protesters:9dbc4257-8623-ac06-9730-69c3bfd6738f
msgctxt "h0ef2640ag58b1g4679gade0gc6f16523820d"
msgid "They don't care - look at 'em!"
msgstr "저들은 그런 건 상관도 안 해. 보라고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_Protesters
#. Speaker = Xeph
#. NodeID = b27b97ab-27a1-f898-9534-127d6b3c1e72
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_State_DruidsPacified = True
#.   Local:
#.      - 62fae314-93ea-8fdb-5194-527d37ac3e55_B = True
#.      - 62fae314-93ea-8fdb-5194-527d37ac3e55_A = True
#. SetFlags:
#.   Local:
#.     - 62fae314-93ea-8fdb-5194-527d37ac3e55_B = False
#.     - 62fae314-93ea-8fdb-5194-527d37ac3e55_A = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_Protesters:b27b97ab-27a1-f898-9534-127d6b3c1e72
msgctxt "h9b0e66a7g030ag45f2gbeb9gbe8e8aab1684"
msgid "Doesn't change much. We're still trapped."
msgstr "여전히 그대로야. 우리는 아직 갇혔어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_Protesters
#. Speaker = Amek
#. NodeID = bc799ca0-8a0e-1f42-35ad-5da2cae68544
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_State_DruidsPacified = True
#.   Local:
#.      - 62fae314-93ea-8fdb-5194-527d37ac3e55_B = False
#.      - 62fae314-93ea-8fdb-5194-527d37ac3e55_A = True
#. SetFlags:
#.   Local:
#.     - 62fae314-93ea-8fdb-5194-527d37ac3e55_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_Protesters:bc799ca0-8a0e-1f42-35ad-5da2cae68544
msgctxt "h3a430df2g09fcg4594g8a76ge8e3303f9365"
msgid "Don't see what's so special about this part. Just more Grove."
msgstr "여기가 뭐가 특별한 지 모르곘어. 그저 숲만 보이는걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_Protesters
#. Speaker = Rechel
#. NodeID = fa4849c3-dcdb-7a3c-e80a-23f5263a9637
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_AD_Protesters:fa4849c3-dcdb-7a3c-e80a-23f5263a9637
msgctxt "hd8d9fd52ge800g440egb768g2c9ea2a11f7a"
msgid "A little more room to hide from goblins, at least."
msgstr "적어도 고블린들로부터 숨을 약간의 공간은 있네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Guard1
#. Speaker = Jeorna
#. NodeID = 0e9b1ea3-1156-a723-685a-633ade14b766
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_GuardedEntrance_HasMet_Guard1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Guard1:0e9b1ea3-1156-a723-685a-633ade14b766
msgctxt "h2878ce9agd388g4069g94d1g5d7b186676b5"
msgid ""
"Your companion vouched for you, but you're being watched. Respect our grove."
msgstr "당신의 동료가 당신을 보증했지만, 당신은 감시당하고 있어. 우리의 숲을 존중해줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Guard1
#. Speaker = Jeorna
#. NodeID = 1e784808-d787-31c6-1180-3226afa429e0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_GuardedEntrance_HasMet_Guard1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Guard1:1e784808-d787-31c6-1180-3226afa429e0
msgctxt "he86d76c4gbcfag4f07gb49ega2c07998a3a6"
msgid "Kagha is expecting you. Go."
msgstr "카그하가 너를 기다리고 있어. 가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Guard1
#. Speaker = Jeorna
#. NodeID = 2f3f66cb-5451-2666-bb02-8c44b9f45a90
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_State_DruidsPacified = True
#. SetFlags:
#.   Dialog:
#.     - DEN_GuardedEntrance_Guard1_RitualStoppedHasmet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Guard1:2f3f66cb-5451-2666-bb02-8c44b9f45a90
msgctxt "h4dc48529gdea0g44f6g9229g7e76873b58cf"
msgid ""
"We've ceased our ritual, but that's not an invitation for you to do as you "
"please. Be respectful of this place."
msgstr "의식은 중단했지만, 그렇다고 당신 마음대로 할 수 있는 건 아니야. 이 장소를 존중해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Guard1
#. Speaker = Jeorna
#. NodeID = 45a9fb05-d8f8-da4c-bef8-b4bca504c2bb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_SnakesCourtDone = True
#. TagRule: DRUID
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Guard1:45a9fb05-d8f8-da4c-bef8-b4bca504c2bb
msgctxt "h80c8818fge202g42cdg8596gf46413bce584"
msgid ""
"These outsiders should show some dignity and leave. They burden our grove."
msgstr "이방인들은 자존심을 지키고 떠나야 해. 우리의 숲에 짐이 되고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Guard1
#. Speaker = Jeorna
#. NodeID = 45a9fb05-d8f8-da4c-bef8-b4bca504c2bb
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_SnakesCourtDone = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Guard1:45a9fb05-d8f8-da4c-bef8-b4bca504c2bb
msgctxt "h03f21799g4c00g4bbfgb5cbg0239c1705c49"
msgid ""
"Show some dignity and leave. You've burdened this place with your troubles "
"long enough."
msgstr "자존심을 지키고 떠나. 당신은 당신의 문제들로 이곳을 오랫동안 괴롭혔어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Guard1
#. Speaker = Jeorna
#. NodeID = 8bef53fe-5b2e-f8e1-e0fc-9bbe0e6e073f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_GuardedEntrance_Guard1_RitualStoppedHasmet(1) = True
#.   Global:
#.      - DEN_GroveConflict_State_DruidsPacified = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Guard1:8bef53fe-5b2e-f8e1-e0fc-9bbe0e6e073f
msgctxt "ha319e575gcfc2g4d7ag980dg9b3e60654568"
msgid "On your way, outsider. You've taken up enough of my time."
msgstr "갈 길 가도록 해, 외부인. 이미 내 시간 충분히 뺏었으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Guard1
#. Speaker = Jeorna
#. NodeID = 91a9bf75-fa49-2ba5-28b8-dffc55e6628c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_GuardedEntrance_HasMet(1) = True
#.      - DEN_GuardedEntrance_State_FailedPersuasion(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_GuardedEntrance_HasMet_Guard1(1) = True
#. TagRule: TIEFLING
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Guard1:91a9bf75-fa49-2ba5-28b8-dffc55e6628c
msgctxt "h0f1a604eg4a0bg4f5cga399gc66abf3ad88f"
msgid ""
"Your kin will be held accountable for your actions, tieflings. Respect our "
"grove, or face our claws."
msgstr "너희 족속은 자기 행동에 책임을 져야 할 것이야, 티플링. 우리 숲을 존중해라. 그게 싫다면 우리 발톱을 맛보든가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Guard1
#. Speaker = Jeorna
#. NodeID = 91a9bf75-fa49-2ba5-28b8-dffc55e6628c
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_GuardedEntrance_HasMet(1) = True
#.      - DEN_GuardedEntrance_State_FailedPersuasion(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_GuardedEntrance_HasMet_Guard1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Guard1:91a9bf75-fa49-2ba5-28b8-dffc55e6628c
msgctxt "h8e5d332agf6aeg4f0cg87f3gb0bfb44f013a"
msgid ""
"Your welcome can easily be withdrawn, outsider. Respect our grove, or face "
"our claws."
msgstr "네 환영은 언제든 철회될 수 있다, 이방인. 우리 숲을 존중하거나, 우리 발톱을 맛봐야 할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Guard2
#. Speaker = Maggran
#. NodeID = 0467acb4-6972-aeac-63ee-94bfb27b5f9e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BEAR(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Guard2:0467acb4-6972-aeac-63ee-94bfb27b5f9e
msgctxt "h55ad5614g82fdg4723gad60g7f942802c7d8"
msgid "*Roar.*"
msgstr "*으르렁.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Guard2
#. Speaker = Maggran
#. NodeID = 479819a1-1440-e5fa-5bc6-6c0dafb8cc5d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_State_DruidsPacified = True
#. SetFlags:
#.   Dialog:
#.     - DEN_GuardedEntrance_Guard2_RitualStoppedHasmet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Guard2:479819a1-1440-e5fa-5bc6-6c0dafb8cc5d
msgctxt "hefd5bd75ge931g40d1gbb79gc7268fa0c907"
msgid "The rite has been stopped - for now. But I'm still watching you."
msgstr "의식은 중단되었다. 지금은 말이지. 나는 여전히 당신을 지켜보고 있다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Guard2
#. Speaker = Maggran
#. NodeID = 614d6bf7-14b1-e2c0-0f22-6274611efb2b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_State_DruidsPacified = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Guard2:614d6bf7-14b1-e2c0-0f22-6274611efb2b
msgctxt "hb110bd48g90b7g4fa2g975agd20a7c730721"
msgid "You're lucky I'm not in my bear form. Back off."
msgstr "내가 곰 형태가 아님을 다행으로 여겨라. 물러서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Guard2
#. Speaker = Maggran
#. NodeID = c7bc8b08-cd22-b719-0c1f-d4d7ae7badf6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_GuardedEntrance_Guard2_RitualStoppedHasmet(1) = True
#.   Global:
#.      - DEN_GroveConflict_State_DruidsPacified = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Guard2:c7bc8b08-cd22-b719-0c1f-d4d7ae7badf6
msgctxt "he9f0a626g6c91g4e92gb966g2e08c2eb9de5"
msgid "Do not squander our generosity - respect the grove."
msgstr "우리가 베푸는 관용을 탕진하지 마라. 숲을 존중해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Guard3
#. Speaker = Mino
#. NodeID = 09ebdd8d-41c2-e151-f062-65139492edcc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_GuardedEntrance_HasMet_Guard3(1) = True
#. TagRule: DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Guard3:09ebdd8d-41c2-e151-f062-65139492edcc
msgctxt "hb0b33108gf267g41a6ga486g5f590dfeb0d0"
msgid "I'm watching you, drow. We all are."
msgstr "널 지켜보겠다, 드로우. 우리 모두가 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Guard3
#. Speaker = Mino
#. NodeID = 09ebdd8d-41c2-e151-f062-65139492edcc
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_GuardedEntrance_HasMet_Guard3(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Guard3:09ebdd8d-41c2-e151-f062-65139492edcc
msgctxt "h63f82438gf315g4dbegbc66g66b442b84fa5"
msgid ""
"Few outsiders are allowed in here - be respectful and do<i> not "
"</i>interfere."
msgstr "이곳에 들어올 수 있는 이방인은 많지 않아, 예를 갖추고, 관여할 생각은 <i>절대</i> 하지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Guard3
#. Speaker = Mino
#. NodeID = 35861f30-f4c4-9047-adc5-6cc84efccdb1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_GuardedEntrance_HasMet_Guard3(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Guard3:35861f30-f4c4-9047-adc5-6cc84efccdb1
msgctxt "h62e99f3fgc102g4cabgb7d5gc83fde59864e"
msgid "See to your business here quickly - then leave."
msgstr "제발 빨리 일이나 마치고 - 떠나라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Guard3
#. Speaker = Mino
#. NodeID = 623c5172-a7ce-4415-4da5-db3bbadd509f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_GuardedEntrance_Guard3_RitualStoppedHasmet(1) = True
#.   Global:
#.      - DEN_GroveConflict_State_DruidsPacified = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Guard3:623c5172-a7ce-4415-4da5-db3bbadd509f
msgctxt "h512f549dg4642g4adfgbcd2gb56454ecd671"
msgid "Remember, outsider - you are tolerated more than you are welcome."
msgstr "기억해라, 이방인. 넌 환영받는 게 아니라 관용받는 것임을."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Guard3
#. Speaker = Mino
#. NodeID = 67a0a429-d42c-fb39-bbb7-db2e8f37f249
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_State_DruidsPacified = True
#. SetFlags:
#.   Dialog:
#.     - DEN_GuardedEntrance_Guard3_RitualStoppedHasmet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Guard3:67a0a429-d42c-fb39-bbb7-db2e8f37f249
msgctxt "h9c6c3753ga261g443cga828g65939eb3fac0"
msgid ""
"The Rite of Thorns has ceased; it seems you will be allowed to stay - but "
"behave."
msgstr "가시의 의식이 중단되었으니 머물러도 좋지만 행동은 조심해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Player
#. NodeID = 0185f7b3-3459-35b3-5993-828c6ceb4523
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_GuardedEntrance_HasMet_LiedAboutDeath(2) = True
#.   Quest:
#.     - DEN_SnakeCourt.ParentLied(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:0185f7b3-3459-35b3-5993-828c6ceb4523
msgctxt "hf48c7db8g8e31g4a37gbb57g2cdd58b5865c"
msgid "Kagha will release her soon, just hold on."
msgstr "카그하가 곧 풀어줄 거야. 기다려."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Player
#. NodeID = 0f3c6494-426d-a950-1b6e-04a0f8650476
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:0f3c6494-426d-a950-1b6e-04a0f8650476
msgctxt "h65a6d4e5g4954g4db8g91ccg5be46edca538"
msgid "Thieves deserve to be punished. It's as simple as that."
msgstr "도둑은 대가를 치러야지. 당연한 일이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Player
#. NodeID = 0fa22595-775e-7a20-29af-3329ec7749f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:0fa22595-775e-7a20-29af-3329ec7749f4
msgctxt "hca0966f4ga303g4ff5g8c96gec707ec0838d"
msgid "Arabella is gone. I'm sorry for your loss."
msgstr "아라벨라는 죽었어. 애도를 표하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Astarion
#. NodeID = 126f9482-6bdd-dfd5-4462-f7e4fc289462
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_ASTARION(6) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:126f9482-6bdd-dfd5-4462-f7e4fc289462
msgctxt "h5799363dg747eg4de8gaf0eg16f16060929f"
msgid ""
"Breaking into druid chambers to steal a sacred relic? Oh, she sounds like "
"<i>fun</i>."
msgstr "신성한 유물을 훔치러 드루이드 구역에 침입했다고? 참 <i>재미있는</i> 애로군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Player
#. NodeID = 12d5400d-7c81-e8ce-b3b2-097f644446f7
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_TYR
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:12d5400d-7c81-e8ce-b3b2-097f644446f7
msgctxt "h97b80ef3g36fcg45c6g8c08ga6ce554522db"
msgid "Tyr will not let this injustice go unpunished."
msgstr "티르께서 이 부당함을 결코 가만히 넘어가시지 않을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Player
#. NodeID = 14e44250-612b-d477-8164-8b290d65dcc1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GuardedEntrance_State_ParentsSceneStarted = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:14e44250-612b-d477-8164-8b290d65dcc1
msgctxt "hb0e50c86gc982g4643gb61bgd9da214b1e9a"
msgid "What's going on here?"
msgstr "무슨 일이야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Locke
#. NodeID = 19309765-c1d5-2eec-8a0f-094ad994e569
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:19309765-c1d5-2eec-8a0f-094ad994e569
msgctxt "h7c3e9a15gfaabg42e6gb6cbgb0aee83015b9"
msgid "No... no."
msgstr "아니야... 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Komira
#. NodeID = 193e0185-3631-19ee-5099-a7f084590814
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:193e0185-3631-19ee-5099-a7f084590814
msgctxt "ha7a94906gc361g4454g96f4g544e2068c8cf"
msgid "Locke, it's not true. Locke!"
msgstr "로크, 말도 안 돼. 로크!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Komira
#. NodeID = 1aec8a36-0c91-8f50-d13d-a62d9e507fac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:1aec8a36-0c91-8f50-d13d-a62d9e507fac
msgctxt "h4b06185bg3021g409bg8131g71229547fe63"
msgid "Then piss off."
msgstr "그럼 꺼져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Player
#. NodeID = 1e0cf2d8-6e27-b5ef-f148-953de778d476
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:1e0cf2d8-6e27-b5ef-f148-953de778d476
msgctxt "h42862ed7g5559g454bga0adg8ed1e5e47ade"
msgid "She was bitten by a snake. It happened quickly. She felt no pain."
msgstr "아라벨라는 뱀한테 물렸어. 순식간이어서 아픈지도 몰랐을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Player
#. NodeID = 1e95f821-873b-70e1-b581-269e177dbab0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GuardedEntrance_State_ParentsSceneStarted = False
#.   Quest:
#.      - DEN_Conflict.MetKagha(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:1e95f821-873b-70e1-b581-269e177dbab0
msgctxt "h702dc3c7gc66cg4fcega7b5g5d6e89c95dca"
msgid "Snake? You must really dislike Kagha."
msgstr "뱀년이라고? 카그하를 정말 싫어하나 보군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Komira
#. NodeID = 22467310-6965-18f7-bf9b-8711cc8fe917
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:22467310-6965-18f7-bf9b-8711cc8fe917
msgctxt "h998761e2g77e1g4d77g88f3g99482f2c6fb4"
msgid ""
"I'd sooner trek through the Nine Hells than trust that snake. <i>Argh. </i>"
msgstr "그 뱀년을 믿을 바에 아홉 지옥을 산책하겠어. <i>으으. </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Locke
#. NodeID = 252a8b06-3b2f-5d74-38dc-5dafdbce79f0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GuardedEntrance_State_KidIsBack = True
#.   User:
#.      - DEN_GuardedEntrance_HasMet_Parents(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:252a8b06-3b2f-5d74-38dc-5dafdbce79f0
msgctxt "h3a7ea9efg8156g41c3gaf09g70207d327829"
msgid ""
"The road to Baldur's Gate looks a little less daunting now that we're all "
"back together."
msgstr "이제 우리 가족이 모두 모였으니, 발더스 게이트로 가는 길은 좀 덜 험난하겠군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Player
#. NodeID = 266bbae0-4418-d2b4-6264-c73e6cea4bca
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_VLAAKITH or PALADIN_VLAAKITH
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:266bbae0-4418-d2b4-6264-c73e6cea4bca
msgctxt "h70d9d586gfe12g444aga49dg52a07bc4c211"
msgid ""
"Your daughter should have slain the snake - instead she fell to its venom."
msgstr "네 딸은 그 뱀을 베어버렸어야 했어. 하지만 그 대신 뱀의 독에 당했지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Komira
#. NodeID = 26daa934-6dea-7f12-312a-98d9f81466de
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:26daa934-6dea-7f12-312a-98d9f81466de
msgctxt "he6187454gad3fg4a2fga75dg8eb46e2ae20b"
msgid "THAT SNAKE! THAT - THAT - AUUUGHH."
msgstr "<b>그 뱀 년이! 그, 그 년이, 아아아악</b>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Player
#. NodeID = 27879cfb-352f-310f-5aa0-9a7b1ac8cb9f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:27879cfb-352f-310f-5aa0-9a7b1ac8cb9f
msgctxt "h36e30bc9g3894g42dbgbbb8gbf70261ae736"
msgid "Your daughter is dead."
msgstr "당신 딸은 죽었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Komira
#. NodeID = 2d4a89d0-fff8-04ca-eb30-c82c23ac8086
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:2d4a89d0-fff8-04ca-eb30-c82c23ac8086
msgctxt "h8723093ag3f02g4ec5g9588g0c265d468579"
msgid "Are you having a laugh? Is this funny to you?"
msgstr "지금 농담이 나와? 그딴 게 재밌어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Komira
#. NodeID = 2e20e378-0a64-b74f-d1e5-f85af1e28051
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:2e20e378-0a64-b74f-d1e5-f85af1e28051
msgctxt "he72d5996g2d54g4d30gb268g0fc451882696"
msgid "No. NO."
msgstr "안 돼. <b>안 돼</b>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Player
#. NodeID = 318f7aeb-7565-baf1-805a-02b3a3d7c950
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - DEN_SnakeCourt.MetParent(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:318f7aeb-7565-baf1-805a-02b3a3d7c950
msgctxt "hf132eb73g85bfg447bg9c85g50a64d7a6b39"
msgid "She's just a child - the druids are overreacting. I'll talk to them."
msgstr "그저 아이일 뿐인데, 드루이드들이 과민반응하고 있군. 내가 한 번 말해보지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Komira
#. NodeID = 38fe2b84-365f-dcb2-4792-3dabe0f47a2f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:38fe2b84-365f-dcb2-4792-3dabe0f47a2f
msgctxt "hbc84daaeg00e1g4b4bg90e1g53c1637e46fc"
msgid "Speaking of - we don't have time to gabber. You'd best move on."
msgstr "말이 나왔으니 말인데, 지금 수다나 떨 시간이 없어요. 가보세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Komira
#. NodeID = 3c65866b-fa73-c498-7d11-dfe60028b979
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:3c65866b-fa73-c498-7d11-dfe60028b979
msgctxt "h0335d783g835bg4e13g9226gbc21c7d2b8da"
msgid "No. Locke. <i>Locke.  </i>"
msgstr "안 돼. 로크.  <i>로크.  </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Locke
#. NodeID = 3d0b0f58-3733-9f56-b660-3825a749deea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:3d0b0f58-3733-9f56-b660-3825a749deea
msgctxt "h206b1c2agc9bag41d5ga961g105ed8b7c04d"
msgid "She'll release Arabella soon. I'm sure."
msgstr "아라벨라는 곧 풀려날 거야. 확실해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Locke
#. NodeID = 3e77fe4f-b46a-bfe4-75ea-eebd63d5422b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:3e77fe4f-b46a-bfe4-75ea-eebd63d5422b
msgctxt "h449aede6gc685g491cg82c2gd868f8866a1c"
msgid "What are you saying?"
msgstr "그게 무슨 말입니까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Komira
#. NodeID = 419d6382-0b67-327f-bd50-40d41c2bc377
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:419d6382-0b67-327f-bd50-40d41c2bc377
msgctxt "h8de9e216g0c00g4e59g99a4gd0801201cff8"
msgid "And you should bugger off. Now."
msgstr "그러는 당신은 당장 꺼지시죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Locke
#. NodeID = 435996e7-f204-dd72-c253-1a5febbb586f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:435996e7-f204-dd72-c253-1a5febbb586f
msgctxt "h9472ea46g5658g4c8dgbb88g42c7c245eebf"
msgid "Loss? What are you on about?"
msgstr "잃다니요? 무슨 소리를 하는 겁니까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Komira
#. NodeID = 4488ec45-9a72-5e79-f7fe-f7f95b9cfce6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   User:
#.     - DEN_GuardedEntrance_HasMet_Parents(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:4488ec45-9a72-5e79-f7fe-f7f95b9cfce6
msgctxt "he8ca1a5cg9851g4ad8g81f8g90a7560306b1"
msgid "We need to get Arabella out. <i>Now. </i>"
msgstr "아라벨라를 꺼내와야 해. <i>당장. </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Player
#. NodeID = 4656402b-e36c-ba7d-52c6-f710d6588918
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_GuardedEntrance_HasMet_LiedAboutDeath(2) = True
#.   Quest:
#.     - DEN_SnakeCourt.ParentLied(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:4656402b-e36c-ba7d-52c6-f710d6588918
msgctxt "h810fe6ceg9f56g4e91gbb5bg174d1c5cf48f"
msgid "I've involved myself too much already. No more."
msgstr "주제넘은 참견이었어. 이만 물러나지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Komira
#. NodeID = 47c26a9e-77a8-15b1-85fc-c18d848c5c1d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:47c26a9e-77a8-15b1-85fc-c18d848c5c1d
msgctxt "haa6854f3g1c19g44c1ga663g77d2cd1acfec"
msgid "No. You're not saying? You're wrong. You're <i>wrong. </i>Bells..."
msgstr "아니야. 거짓말이지? 그럴 리가 없잖아. 그럴 리가 <i>없다고.</i> 벨..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Player
#. NodeID = 4dbe5aa8-5f4e-81e3-9756-f26587afa200
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_OGHMA
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:4dbe5aa8-5f4e-81e3-9756-f26587afa200
msgctxt "he07f8733g4a8cg4bcfga35egca167f33ca43"
msgid ""
"Truth is better than ignorance - no matter how dark it may be. Your child is "
"gone."
msgstr "아무리 어두운 진실이라도 모르는 것보단 낫지. 당신 딸은 죽었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Komira
#. NodeID = 51ed0a95-1619-9b53-17ed-501166020c13
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_GuardedEntrance_HasMet_LiedAboutDeath(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:51ed0a95-1619-9b53-17ed-501166020c13
msgctxt "h221e7cdfgc3d1g4885gbc60g1e6f43f684b2"
msgid "How long is Kagha gonna take?"
msgstr "언제까지 붙잡고 있을 생각인 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Wyll
#. NodeID = 53427d24-a0cb-2be1-0402-fb48b49e6736
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_WYLL(7) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:53427d24-a0cb-2be1-0402-fb48b49e6736
msgctxt "hc6b55b73gd59dg4b05g9508g5351d5e7d393"
msgid "Horrifying. We should check on the girl."
msgstr "끔찍하군. 그 소녀를 찾아보자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Komira
#. NodeID = 551b7365-be65-fe71-c20c-06177e109b17
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - DEN_GuardedEntrance_HasMet_Parents(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:551b7365-be65-fe71-c20c-06177e109b17
msgctxt "h15030677gdb21g44c4gba59g2b3c9b6709e2"
msgid "I'll rush the guards. You sprint past."
msgstr "내가 경비들을 밀칠게. 당신이 최대한 빨리 뛰어가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Komira
#. NodeID = 587836fb-af4d-3792-b6f0-45aeb654619b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#.      - DEN_ShadowDruid_State_SnakesCourtDone = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:587836fb-af4d-3792-b6f0-45aeb654619b
msgctxt "h7e06b90dg409eg4b06g8df4ge4b434a72139"
msgid "Unless you have news of Arabella I don't want to hear it."
msgstr "아라벨라의 소식 말고는 듣고 싶지 않아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Komira
#. NodeID = 59cc6558-2d8b-9f06-a13e-5ee0dbb04c42
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GuardedEntrance_State_ParentsKnowDeath = True
#. SetFlags:
#.   Quest:
#.     - DEN_SnakeCourt.ParentDevastated(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:59cc6558-2d8b-9f06-a13e-5ee0dbb04c42
msgctxt "h06bb4a80gd107g44degb7b0ga15af1a3adc4"
msgid "LEAVE ME."
msgstr "<b>날 내버려 둬요</b>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Player
#. NodeID = 59fba6b9-65b5-dff4-cec5-73c65aa6d2bc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_GuardedEntrance_HasMet_PlayerAnnouncedDeath = True
#.     - DEN_GuardedEntrance_State_ParentsKnowDeath = True
#.   Quest:
#.     - DEN_SnakeCourt.ParentDevastated(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:59fba6b9-65b5-dff4-cec5-73c65aa6d2bc
msgctxt "hfadf0482g3f05g47bbgaafcg39e0517ea59c"
msgid "It was an accident. I wish it weren't true."
msgstr "사고였어. 나도 이게 사실이 아니면 좋겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Locke
#. NodeID = 5cb6e5b9-9e32-82e4-035d-17d0f4c09bd2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:5cb6e5b9-9e32-82e4-035d-17d0f4c09bd2
msgctxt "h051921begcd3ag4ab5g929fgcf122557e9e7"
msgid ""
"Now Arabella is being judged by a bunch of druids who hate us. That's not "
"right."
msgstr "이제 아라벨라는 우리를 증오하는 드루이드들한테 심판을 받게 생겼어요. 이건 옳지 않아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Player
#. NodeID = 5d0da609-c078-82c8-ca7f-0847bf074701
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_YONDALLA
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:5d0da609-c078-82c8-ca7f-0847bf074701
msgctxt "hc0aa0d65gd0c9g4fafgad08gb19e245d3491"
msgid ""
"Little is more important than family. Yondalla will watch over your daughter "
"- I promise."
msgstr "가족보다 중요한 건 없지. 욘달라께서 당신 딸을 돌보실 거야. 약속하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Locke
#. NodeID = 5e044049-b117-cd73-39ec-0a1036fa100c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   User:
#.     - DEN_GuardedEntrance_State_OfferedHelpParents(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:5e044049-b117-cd73-39ec-0a1036fa100c
msgctxt "h0680ba5dg6f17g4ca7ga060g123e5a0a7f37"
msgid "Thank you. They won't give us the time of day."
msgstr "감사합니다. 저들이 우리에게 상황을 알려줄 것 같진 않군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Player
#. NodeID = 625f0d53-d1b1-a910-cf58-e1175d428676
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_KELEMVOR
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:625f0d53-d1b1-a910-cf58-e1175d428676
msgctxt "h03760ef6gd7ccg407eg83bcg0c834de9991b"
msgid ""
"Kelemvor has taken her by the hand and guided her to the afterlife. She is "
"safe now."
msgstr "켈렘보르가 그 아이를 내세로 인도했어. 이제 안전해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Player
#. NodeID = 6383bb87-5f55-a6f5-bb1e-774eaf562c63
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GuardedEntrance_State_ParentsSceneStarted = False
#.   Quest:
#.      - DEN_Conflict.MetKagha(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:6383bb87-5f55-a6f5-bb1e-774eaf562c63
msgctxt "hbc183189g0932g4287gb286g02a5eb382f76"
msgid "Snake? You must really dislike this Kagha."
msgstr "뱀년이라고? 카그하라는 자를 정말 싫어하나 보군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Locke
#. NodeID = 66424c9a-3fa2-63b6-8eff-ffc246f23897
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:66424c9a-3fa2-63b6-8eff-ffc246f23897
msgctxt "h73435948gb343g44ecgad6ag373e093152ea"
msgid "Please - is Arabella all right?"
msgstr "제발, 사실 아라벨라는 무사한 거죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Locke
#. NodeID = 6b15c5e1-b761-41b1-33d7-8cddb9f5716c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_GuardedEntrance_Knows_KaghaHoldsChild = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:6b15c5e1-b761-41b1-33d7-8cddb9f5716c
msgctxt "hbcb16e52gda15g4bbfg81dfg5316fb32f422"
msgid "You heard the guards - they're waiting on Kagha to give word."
msgstr "당신도 경비가 하는 말 들었잖아. 카그하가 명령을 내릴 때까지 그들도 기다려야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Player
#. NodeID = 6efcd28b-d767-4c14-b011-243c51d98af9
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_SELUNE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:6efcd28b-d767-4c14-b011-243c51d98af9
msgctxt "hb4e775adgce98g4e90g82begd7ce82309525"
msgid "She is cradled in the Moonmaiden's embrace now."
msgstr "그 아이는 이제 달처녀의 따스한 품에 안겼어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Player
#. NodeID = 73458dc9-58cb-02e4-afc2-84de96c213a8
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_HELM
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:73458dc9-58cb-02e4-afc2-84de96c213a8
msgctxt "hd2917630ga9bdg4119gac1ag721682cd88e7"
msgid ""
"Under Helm's gaze I saw it. I don't believe Kagha meant to kill the child."
msgstr "헬름의 눈으로 봤어. 카그하도 죽일 의도로 그런 건 아니었을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Locke
#. NodeID = 748e5cf7-076c-e837-f8e9-5e79020c7039
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:748e5cf7-076c-e837-f8e9-5e79020c7039
msgctxt "h5ecde442g2b35g4e41gb931gace3578c7f16"
msgid "Kagha... Kagha did... <i>what? </i>"
msgstr "카그하... 카그하가... <i>뭘 했다고? </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Locke
#. NodeID = 74e45561-dfe3-7332-b801-e4156383592d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GuardedEntrance_State_KidIsBack = True
#. SetFlags:
#.   User:
#.     - DEN_GuardedEntrance_HasMet_Parents(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:74e45561-dfe3-7332-b801-e4156383592d
msgctxt "hee43f203g2c89g4d38ga961g228013794203"
msgid ""
"Arabella has behaved herself - so far. A miracle in itself. Thank you again."
msgstr "아라벨라는 지금까지는 얌전하게 굴었어. 그 자체로 기적이야. 다시 한번 고마워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Komira
#. NodeID = 74eb7a66-d83f-2fb2-ace0-dffc0e7a956e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:74eb7a66-d83f-2fb2-ace0-dffc0e7a956e
msgctxt "h07d42bbfg8701g41d8g9fb2g49a28cfb91c0"
msgid "Don't be <i>ridiculous. </i>What are you on about?"
msgstr "<i>웃기지 마.</i> 무슨 말을 하는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Locke
#. NodeID = 7bfaba7c-315b-44f3-8c1f-804b177d754e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:7bfaba7c-315b-44f3-8c1f-804b177d754e
msgctxt "h4dac55c6ge8a8g4594gbf51g61ffcd13dc55"
msgid "Thanks so much."
msgstr "정말 감사합니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Locke
#. NodeID = 7e03d852-afec-3561-56a2-23bb2f6ec46a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:7e03d852-afec-3561-56a2-23bb2f6ec46a
msgctxt "hb417aad3g1f0fg434bg9217gd193b054cdba"
msgid "Enough. No point mislaying our trust. We'll get Bells back on our own."
msgstr "진정해. 흔들릴 필요 없어. 벨은 우리 힘으로 찾으면 돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Player
#. NodeID = 8a1cbdc2-b0e3-36c2-0d2d-a913657ddfc0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_GuardedEntrance_HasMet_PlayerAnnouncedDeath = True
#.     - DEN_GuardedEntrance_State_ParentsKnowDeath = True
#.   Quest:
#.     - DEN_SnakeCourt.ParentDevastated(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:8a1cbdc2-b0e3-36c2-0d2d-a913657ddfc0
msgctxt "h8fabb7a6gcb39g43d7ga201geb150473dca3"
msgid "Kagha killed your daughter. She called her a 'parasite' and a 'threat'."
msgstr "카그하가 당신 딸을 죽였어. '기생충'이고 '위협'이라고 하더군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Player
#. NodeID = 903ad6dc-2eae-5743-93ff-74980d2c5ce6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GuardedEntrance_State_ParentsSceneStarted = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:903ad6dc-2eae-5743-93ff-74980d2c5ce6
msgctxt "hd333149ag48d5g4fcdgb075g6bb0b458b9b5"
msgid "I saw what happened. Why are the druids holding your daughter?"
msgstr "무슨 일이 있었는지 봤어. 왜 드루이드들이 당신들 딸을 데리고 있는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Komira
#. NodeID = 904ce631-eec2-9461-6893-a9078b1ec664
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:904ce631-eec2-9461-6893-a9078b1ec664
msgctxt "hfa545884gaa22g4847g9584gfde50b3e6068"
msgid "Great. Another one."
msgstr "완벽하네. 똑같은 놈이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Komira
#. NodeID = 94069a66-fe60-3944-dd2c-5180647ef2b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:94069a66-fe60-3944-dd2c-5180647ef2b6
msgctxt "hc0b0cf84g1ed3g4e79gbb60g4b9adef18490"
msgid ""
"I don't give a <i>mrag</i> about me. It's my daughter I'm worried about."
msgstr "저는 <i>므라그</i>도 상관 없어요. 제 딸이 걱정될 뿐이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Komira
#. NodeID = 94cbb871-fc3a-92cb-b731-0647a43475c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:94cbb871-fc3a-92cb-b731-0647a43475c9
msgctxt "h904b7f84g69f7g497ega8dcg7a8fb3e290b6"
msgid "I don't understand. <i>Locke.</i>"
msgstr "이해가 안돼요. <i>로크.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Komira
#. NodeID = 9957a4e1-f353-1de4-26b5-1d1ecc75119d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:9957a4e1-f353-1de4-26b5-1d1ecc75119d
msgctxt "hdffeb717gccdag4f34gb96cg3686294b0c06"
msgid "Wait - what?"
msgstr "잠깐, 뭐라고요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Player
#. NodeID = 99e5d73e-6834-a0ec-2b7a-bb9d64ea0b65
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_MORADIN
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:99e5d73e-6834-a0ec-2b7a-bb9d64ea0b65
msgctxt "hcb5cf247gf007g46e5g9eb9g71a430f2da0f"
msgid ""
"That trial was a farce. Moradin will ensure her death does not go unpunished."
msgstr "그 재판은 엉터리였어. 모라딘께서 반드시 이 죽음에 대한 벌을 내리실 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Komira
#. NodeID = 9f34f397-1be1-8847-2474-b03a73050981
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:9f34f397-1be1-8847-2474-b03a73050981
msgctxt "h276806e6gba1dg46c2gb185g46b6c987b44e"
msgid "Bloody when?!"
msgstr "망할 언제까지?!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Komira
#. NodeID = a18c6267-d1a6-1525-e764-45b6d1f8e5f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:a18c6267-d1a6-1525-e764-45b6d1f8e5f8
msgctxt "h334e93b9g481fg4f88g8e5dgc30efeadd2de"
msgid ""
"Hurry. I'm at the end of my tether as is - can't take this <i>waiting. </i>"
msgstr "서둘러주세요. 지금도 제 인내심이 한계에 다다랐어요. 이대로 <i>기다릴</i> 수는 없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Locke
#. NodeID = a3232bc3-5d8b-8916-4571-e772cb9d8196
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:a3232bc3-5d8b-8916-4571-e772cb9d8196
msgctxt "hf2b242bbg85eeg415cga4eeg9d0c7843ee90"
msgid "I won't risk you too, love. We'll find another way."
msgstr "당신까지 잃을 순 없어, 여보. 다른 방법이 있을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Player
#. NodeID = a85bdac6-3d4c-62ce-9969-0acac72c5221
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:a85bdac6-3d4c-62ce-9969-0acac72c5221
msgctxt "h534873b6g1bb2g4fc4g9c2eg660c8aef956e"
msgid ""
"Do not weep for your loss - wrest control of this place from the druids. "
"Kill them for what they have done."
msgstr "잃은 것 앞에 눈물 흘리지 마. 드루이드에게서 이곳을 빼앗아. 저들이 한 짓에 죽음으로 갚아 줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Locke
#. NodeID = ad1bf205-336b-cf60-137f-05178bf360ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:ad1bf205-336b-cf60-137f-05178bf360ac
msgctxt "hf566e9c5gb1f7g4d0fg957bg78b7ccba9758"
msgid ""
"It's our daughter. Kagha locked her up for stealing the idol - they need it "
"for their precious ritual."
msgstr "카그하가 저희 딸을 가뒀어요. 중요한 의식에 필요한 우상을 훔쳤거든요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Shadowheart
#. NodeID = adfdaeb5-d86d-11ab-fd32-63e996344604
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(4) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_GuardedEntrance_Parents_SHInclusionTriggered(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:adfdaeb5-d86d-11ab-fd32-63e996344604
msgctxt "h36651a58g8fbag4182g9183g73dfd11827bc"
msgid ""
"Sounds like she made the fatal mistake of getting caught. We shouldn't get "
"involved."
msgstr "잡혀버린 건 정말 큰 실수야. 우린 휘말리지 말자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Player
#. NodeID = b3bc0327-9710-b59e-df96-78fb61ba1562
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:b3bc0327-9710-b59e-df96-78fb61ba1562
msgctxt "hee86df00gdc1dg4d56ga8deg5904b9166834"
msgid "Believe me or don't. It won't bring your daughter back."
msgstr "믿거나 말거나. 그래도 당신 딸은 돌아오지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Locke
#. NodeID = b5472537-76b8-d6ce-713a-7dc16f28b190
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:b5472537-76b8-d6ce-713a-7dc16f28b190
msgctxt "h0e7f754dgef85g48cbga57ag00fff61c2784"
msgid ""
"Thank you. Sincerely. I don't know what we'd do without our little girl."
msgstr "감사합니다. 진심으로요. 저희 아이 없이는 어떻게 해야 될지 모르겠네요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Player
#. NodeID = bb7200f2-f50a-c294-b16e-a13951b1ee4f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_GuardedEntrance_HasMet_LiedAboutDeath(2) = True
#.   Quest:
#.     - DEN_SnakeCourt.ParentLied(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:bb7200f2-f50a-c294-b16e-a13951b1ee4f
msgctxt "h8fcbf2bagccadg4d2bgb19bgd02dea1a096c"
msgid "She's fine. Probably."
msgstr "그 애는 괜찮아. 아마도."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Locke
#. NodeID = bc02e53a-359f-d92a-59b8-9c176b466708
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:bc02e53a-359f-d92a-59b8-9c176b466708
msgctxt "h0342f3ddgce1dg4055gb39dg7c98ed77e69d"
msgid "We'll figure something out. We always do."
msgstr "분명 해결할 길이 있을 거예요. 항상 그랬으니까요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Locke
#. NodeID = bf3e5090-d07c-497c-fefe-d2242ab65e09
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:bf3e5090-d07c-497c-fefe-d2242ab65e09
msgctxt "h50c0784eg1fbdg4199g9830gb6f54860eeba"
msgid ""
"Hang on, love. This'll be over soon enough - we just gotta wait a bit longer."
msgstr "진정해, 여보. 곧 있으면 끝날 거야. 조금만 더 기다리면 돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Player
#. NodeID = c0c4363b-489c-d2d6-e3b4-d109506987c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:c0c4363b-489c-d2d6-e3b4-d109506987c9
msgctxt "h6fefca8eg1bbeg417fg9e6eg3f760be20900"
msgid "You've got your work cut out for you."
msgstr "걱정이 이만저만이 아니겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Player
#. NodeID = c5a6957f-0246-0111-5639-3ebe8d8332ef
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_GuardedEntrance_HasMet_LiedAboutDeath(2) = True
#.   Quest:
#.     - DEN_SnakeCourt.ParentLied(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:c5a6957f-0246-0111-5639-3ebe8d8332ef
msgctxt "h1860c227g6846g46f0g8c5ag5c1c25e978df"
msgid "Nothing - bad joke. Arabella's fine. Kagha will release her soon."
msgstr "그냥 썰렁한 농담이었어. 아라벨라는 괜찮아. 곧 풀려날 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Player
#. NodeID = c721bf91-2ffd-7a9d-faf4-8b1be61d928b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:c721bf91-2ffd-7a9d-faf4-8b1be61d928b
msgctxt "hf3775dfcg5a6bg4c50gb5f4g172418d8568d"
msgid "This is none of my concern."
msgstr "내 알 바가 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Gale
#. NodeID = d68da942-3e16-6b2b-a0c2-b12667b9d8af
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(8) = True
#.   Tag:
#.      - REALLY_GALE(8) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:d68da942-3e16-6b2b-a0c2-b12667b9d8af
msgctxt "h2599c25fgbac0g444cg8bcegade9e8c65d97"
msgid ""
"This grove is like a cauldron about to boil over. I say we check in on the "
"child - make sure she comes to no harm."
msgstr "여기 숲은 마치 끓어 넘치려 하는 가마솥 같군. 다치지 않았는지 확인하기 위해 그 아이를 살펴보는 게 좋겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Lae'zel
#. NodeID = d73a4268-1cb7-d264-edce-762199395342
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_LAEZEL(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:d73a4268-1cb7-d264-edce-762199395342
msgctxt "hd7d46519gd6ecg412dg97b9g2c98e5bb6eea"
msgid "She was caught? Foolish child - let them judge her."
msgstr "잡혔다고? 멍청한 아이군. 심판을 받으라고 하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Player
#. NodeID = d7fd0c9a-250a-9737-4647-d33c1caf4a73
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:d7fd0c9a-250a-9737-4647-d33c1caf4a73
msgctxt "h2ede2e3fg92beg4323ga154g0d580845b790"
msgid "Like you said - it's your fault. You should've tried parenting her."
msgstr "당신 입으로 말했듯, 이건 당신 잘못이야. 애를 잘 관리했어야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Locke
#. NodeID = de7731a2-90e5-0d3f-c8a2-222bf160fbb8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:de7731a2-90e5-0d3f-c8a2-222bf160fbb8
msgctxt "hdfddc2a9gccbdg4406gb92bg550997f3732f"
msgid "I - I don't understand."
msgstr "이... 이해가 안돼요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Karlach
#. NodeID = e2ab061f-ba15-9e6d-110d-e458ff42e351
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_KARLACH(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:e2ab061f-ba15-9e6d-110d-e458ff42e351
msgctxt "heaca46f3g591eg4328gb230g79bf29d56588"
msgid ""
"Poor thing must be terrified. Who do they think they are, keeping her away "
"from her folks?"
msgstr "가엽게도 겁에 잔뜩 질려있을 거야. 아이를 가족에게서 떼어놓다니, 무슨 자격으로 그런 짓을 한 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Player
#. NodeID = e4c36ea1-2772-6247-b39e-12f2d8a82735
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_GARLGLITTERGOLD
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:e4c36ea1-2772-6247-b39e-12f2d8a82735
msgctxt "h53a86e3agcb67g4a8dgb4e5gc92ea21a11ca"
msgid ""
"I will pray to Glittergold. He will watch over her - and her soul will be "
"filled with peace and laughter."
msgstr "글리터골드께 기도할게. 그 분이 아라벨라를 돌보시고 그 영혼에 평화와 웃음이 가득하게 할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Player
#. NodeID = e71058ad-3cf7-bf41-e065-9bc4803dd273
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_GuardedEntrance_HasMet_PlayerAnnouncedDeath = True
#.     - DEN_GuardedEntrance_State_ParentsKnowDeath = True
#.   Quest:
#.     - DEN_SnakeCourt.ParentDevastated(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:e71058ad-3cf7-bf41-e065-9bc4803dd273
msgctxt "h3128aae2gdef2g4530g8b4fg985b9262a8de"
msgid "She's dead. I'm sorry."
msgstr "그 애는 죽었어. 정말 유감이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Player
#. NodeID = e838f000-5d9e-0b84-9964-16831e928da4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GuardedEntrance_State_ParentsSceneStarted = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:e838f000-5d9e-0b84-9964-16831e928da4
msgctxt "h22af1792g8c61g490fg9f6bga9aaa2619d40"
msgid "You need to be careful. That bear would've torn you to shreds."
msgstr "조심해. 저 곰이 너를 갈기갈기 찢어버렸을지도 몰라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Locke
#. NodeID = ea7af395-b4a5-0245-cb0c-1448fb5cbcfc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:ea7af395-b4a5-0245-cb0c-1448fb5cbcfc
msgctxt "h4af5a46fg7d6cg4889g8392g3a3ab2eeb61b"
msgid "Please - she's been in there too long. It's not safe."
msgstr "제발요. 너무 오래 갇혀 있었어요. 분명 위험해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Komira
#. NodeID = ece39b06-f575-3867-d00f-b30ce50ab32e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:ece39b06-f575-3867-d00f-b30ce50ab32e
msgctxt "h8b9f685dgc413g40cbg8eafgc8b198a49e35"
msgid ""
"It's all my fault. I told her I wished the wretched thing would just "
"disappear - or better yet, explode."
msgstr "다 내 잘못이야. 내가 그 애한테 저 불쾌한 것이 사라지거나, 아예 터져버렸으면 좋겠다고 했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Komira
#. NodeID = ee77bb0f-8a80-bedb-1643-b45bc9b1327d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - DEN_GuardedEntrance_HasMet_Parents(2) = True
#.      - DEN_GuardedEntrance_State_OfferedHelpParents(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:ee77bb0f-8a80-bedb-1643-b45bc9b1327d
msgctxt "h88d16995g86e0g43d6g9f2fgabb2cc8122d2"
msgid "Unless you have news of Arabella I don't want to hear it."
msgstr "아라벨라의 소식 말고는 듣고 싶지 않아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Player
#. NodeID = ef0d46a2-abce-5cc5-60a1-c9b35d24dc19
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_ILMATER
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:ef0d46a2-abce-5cc5-60a1-c9b35d24dc19
msgctxt "h007e4badg7793g4338gab63g00ae77c32e65"
msgid "Ilmater ensured she was in no pain. She left this world in peace."
msgstr "일메이터의 가호 아래 고통받지 않고 평화롭게 떠났어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Komira
#. NodeID = f064f996-8c0c-5314-3991-5c2d8bf6dd40
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:f064f996-8c0c-5314-3991-5c2d8bf6dd40
msgctxt "h39a47928ga696g4128g966bgcde87ea14e9b"
msgid "<i>Zurgnak </i>grove. <i>Zurgnak</i> druids."
msgstr "이런 <i>주르그낙</i> 숲. <i>주르그낙</i> 드루이드 같으니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Locke
#. NodeID = fce42d7a-8aac-7898-6402-c874c3df4003
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:fce42d7a-8aac-7898-6402-c874c3df4003
msgctxt "h1415a6beg902eg4bddga83fgbe6049566999"
msgid ""
"Arabella tried to steal their idol. Druids lost their damn minds about it - "
"they need it for their precious ritual."
msgstr ""
"아라벨라가 그들의 우상을 훔치려고 했어요. 그것 때문에 드루이드들이 화가 머리끝까지 났죠, 그들의 의식을 위해 꼭 필요한 거거든요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents
#. Speaker = Komira
#. NodeID = ffdf6ef7-8555-cbba-f457-0d726b5d9f8d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Parents:ffdf6ef7-8555-cbba-f457-0d726b5d9f8d
msgctxt "h0d0c2215g39fbg43begb383g0ff1139fbf46"
msgid "Damn right I do. She locked up our daughter."
msgstr "당연히 싫어하고 말고요, 그 년이 제 딸을 가뒀다고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_ParentsScene
#. Speaker = Komira
#. NodeID = 2821f8f2-4746-1c33-1e25-060ec21a3d68
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_GuardedEntrance_State_ParentsSceneStarted = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_ParentsScene:2821f8f2-4746-1c33-1e25-060ec21a3d68
msgctxt "h7047df1cg15ddg49d8gab19g29d7b79db11c"
msgid "Let my daughter go - right now."
msgstr "내 딸을 풀어줘. 지금 당장."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_ParentsScene
#. Speaker = Jeorna
#. NodeID = 8486a0bb-8f38-6c8f-2fa8-7aae829eb6e9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_ParentsScene:8486a0bb-8f38-6c8f-2fa8-7aae829eb6e9
msgctxt "h164d302cga3a2g4982gbe7dgd6955872eeae"
msgid ""
"She's a thief, hellspawn. And you will wait for Kagha's judgement. Now get "
"<i>back</i>."
msgstr "그 애는 도둑이야, 지옥의 자손. 그러니 카그하 님의 판결을 기다리도록. 이제 <i>물러서</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_ParentsScene
#. Speaker = Komira
#. NodeID = 8a6baa58-3859-0aca-067e-a57e8ab081f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_ParentsScene:8a6baa58-3859-0aca-067e-a57e8ab081f4
msgctxt "hf2abc84egcc9ag4623g979bg35d0c9d05b17"
msgid ""
"<i>Argh.</i> Let me through, <i>mragreshem</i>, or I'll rip your damned "
"throat out!"
msgstr "<i>아악.</i> 저리 비켜, <i>므라그레셤</i>, 망할 네 목을 찢어버리기 전에!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_ParentsScene
#. Speaker = Komira
#. NodeID = c0ef313c-6127-5bbb-548f-178baffa1c23
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GuardedEntrance_Event_ApproachingFromPool = True
#. SetFlags:
#.   Global:
#.     - DEN_GuardedEntrance_State_ParentsSceneStarted = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_ParentsScene:c0ef313c-6127-5bbb-548f-178baffa1c23
msgctxt "hcf6bbccdg556dg4ce3g9353g17ad19e329b5"
msgid "Let my daughter go - right now."
msgstr "내 딸을 풀어줘. 지금 당장."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_ParentsScene
#. Speaker = Maggran
#. NodeID = e4075dbc-b176-be32-ed45-d1f5c2ea82c9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_GuardedEntrance_Event_Shapeshift = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_ParentsScene:e4075dbc-b176-be32-ed45-d1f5c2ea82c9
msgctxt "h71cf0e44g8064g4728g907cg72327e58d00e"
msgid "<i>RAWR!</i>"
msgstr "<i><b>으르렁!</b></i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_ParentsWithKid
#. Speaker = Locke
#. NodeID = 019b37da-ff4c-297d-b5f9-a9695518e2b9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - DEN_SnakeCourt.ParentThankful(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_ParentsWithKid:019b37da-ff4c-297d-b5f9-a9695518e2b9
msgctxt "hc2853d35g6b1bg4f40gb89ag8595ca824ed7"
msgid ""
"Our little hellion told us what happened. Thank you - don't know what we'd "
"do without her."
msgstr "저희 작은 말썽꾸러기가 무슨 일이 있었는지 말해줬어요. 감사합니다. 이 애가 없었으면 저희는 어떻게 됐을지 모르겠군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_ParentsWithKid
#. Speaker = Komira
#. NodeID = 26f345a8-bf59-7601-639a-2d8825c0605b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_GuardedEntrance_State_HasKidReward(1) = True
#.   Tag:
#.      - DROWELF(3) = True
#. SetFlags:
#.   Object:
#.     - DEN_ShadowDruid_Event_GiveKidReward(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_ParentsWithKid:26f345a8-bf59-7601-639a-2d8825c0605b
msgctxt "h27afc69fg64c7g4c60gb0b4gdb07e27caccb"
msgid ""
"It's not much, but here. Never thought I'd call a drow 'friend' but know "
"this - if you call, we'll come running. No matter what."
msgstr ""
"별로 대단한 건 아니지만 받으세요. 살면서 드로우를 '친구'라고 부르게 될 줄은 몰랐지만, 아무튼 알아둬요. 당신이 부르면 우린 무슨 "
"일이든 달려갈게요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_ParentsWithKid
#. Speaker = Player
#. NodeID = 3e293a71-3149-f384-0fd2-1aa5d59adb82
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_ShadowDruid_Event_GiveKidReward(3) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_ParentsWithKid:3e293a71-3149-f384-0fd2-1aa5d59adb82
msgctxt "h332ce8f1gaa86g4abeg8172g1a007efac679"
msgid "I saved your daughter - got anything more than a thanks for me?"
msgstr "제가 따님을 구해드렸는데 감사하다는 말 말고는 없나요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_ParentsWithKid
#. Speaker = Arabella
#. NodeID = 564ed2ba-7876-1d54-0415-8d33a91f43cd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_ParentsWithKid:564ed2ba-7876-1d54-0415-8d33a91f43cd
msgctxt "had258f60g6165g4bd8gad7egfd3779067944"
msgid "Yeah. I mean."
msgstr "네. 알겠어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_ParentsWithKid
#. Speaker = Player
#. NodeID = 5a31f767-69b8-78b8-215b-8238783971dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_ParentsWithKid:5a31f767-69b8-78b8-215b-8238783971dc
msgctxt "h8d8c56deg1bc9g49aaga7dbg0598fb8e9c82"
msgid "I hope we'll meet again under better circumstances."
msgstr "다음에 더 나은 상황에서 다시 만나길 기대하겠습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_ParentsWithKid
#. Speaker = Arabella
#. NodeID = 60e0b58e-d5fa-9112-f022-1b30832014c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_ParentsWithKid:60e0b58e-d5fa-9112-f022-1b30832014c1
msgctxt "hed8c9d31g3a21g40eagaae7gc936e653933b"
msgid "Mum. I'm <i>fine. </i>Stop it."
msgstr "엄마. 전 <i>괜찮으니까</i> 그만해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_ParentsWithKid
#. Speaker = Player
#. NodeID = 79ec0538-dd53-a4cf-b42e-ac5173c42959
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_ShadowDruid_Event_GiveKidReward(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_ParentsWithKid:79ec0538-dd53-a4cf-b42e-ac5173c42959
msgctxt "h597c17e1gf1b0g482agbfe4g66874f1ef0a5"
msgid "You're right - it's not much."
msgstr "그 말이 맞아 - 충분치 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_ParentsWithKid
#. Speaker = Arabella
#. NodeID = 81e3255a-66f2-4ff5-330f-f155ae072940
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_ParentsWithKid:81e3255a-66f2-4ff5-330f-f155ae072940
msgctxt "h11444348gc66cg4a22gb3e5gb708ddf664db"
msgid "Thank you. For helping me."
msgstr "고마워요. 저를 도와주셔서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_ParentsWithKid
#. Speaker = Komira
#. NodeID = 8307494e-41ed-4cb3-a4ec-81fb1fab2be5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   User:
#.     - DEN_GuardedEntrance_HasMet_Parents(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_ParentsWithKid:8307494e-41ed-4cb3-a4ec-81fb1fab2be5
msgctxt "h129e2ad7g2ef6g4803gbb38gabc7df9f3be2"
msgid "You ever scare me like that again, and I'll feed you to a gnoll."
msgstr "다음에 또 엄마를 겁먹게 하면, 너를 놀에게 데려갈 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_ParentsWithKid
#. Speaker = Locke
#. NodeID = b5587164-8b55-5132-5bd5-4373aac35c2c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_ParentsWithKid:b5587164-8b55-5132-5bd5-4373aac35c2c
msgctxt "h95a5ead5g6fb9g4da9g8fc8g378cf415ed1c"
msgid "The Nine Hells will sooner freeze over. But we'll try."
msgstr "아홉 지옥이 얼어붙는 게 더 빠르겠군요. 하지만 노력해 보겠습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_ParentsWithKid
#. Speaker = Locke
#. NodeID = c8ef9548-e67d-5aa4-db9a-9447a1d47335
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_ParentsWithKid:c8ef9548-e67d-5aa4-db9a-9447a1d47335
msgctxt "h07369d17g9e42g4ba3g9f2eg86a0cf1849f7"
msgid "Likewise. Arabella?"
msgstr "이쪽도 마찬가지예요. 아라벨라, 인사 드려야지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_ParentsWithKid
#. Speaker = Locke
#. NodeID = cdaeb283-8ff6-2212-2ed3-4691c934d98c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_ParentsWithKid:cdaeb283-8ff6-2212-2ed3-4691c934d98c
msgctxt "h24b8ffd7g047bg4b03g8ad4g48710208f726"
msgid "<i>Marri. </i>All we can offer is our thanks. Arabella?"
msgstr "<i>마리. </i>우리가 드릴 수 있는 것은 감사뿐입니다. 아라벨라?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_ParentsWithKid
#. Speaker = Komira
#. NodeID = d0bd3fc7-3a40-8844-03d1-0939b682abf4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_ParentsWithKid:d0bd3fc7-3a40-8844-03d1-0939b682abf4
msgctxt "h8d8493ccgac50g4fd6g88fage828d225441e"
msgid "Well it's all we got. Arabella?"
msgstr "우리가 가진 건 이게 전부예요. 아라벨라?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_ParentsWithKid
#. Speaker = Player
#. NodeID = d4cc0335-8aeb-f9c1-8e47-c3a4c373885d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_ParentsWithKid:d4cc0335-8aeb-f9c1-8e47-c3a4c373885d
msgctxt "h4afd6a45g51aeg4727g83e4g9353260b329a"
msgid "This could've ended badly - keep her in line from now on."
msgstr "안 좋게 끝날 수도 있었던 일이니, 지금부터라도 그 애를 잘 관리하세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_ParentsWithKid
#. Speaker = Komira
#. NodeID = ecac374e-5be5-02ba-93c0-163fe42d6fe8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_GuardedEntrance_State_HasKidReward(1) = True
#. SetFlags:
#.   Object:
#.     - DEN_ShadowDruid_Event_GiveKidReward(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_ParentsWithKid:ecac374e-5be5-02ba-93c0-163fe42d6fe8
msgctxt "h762de5aegfd43g45edg8e91gd236cfa5a16c"
msgid ""
"It's not much, but here. Know that if you call, we'll come running. No "
"matter what."
msgstr "많지는 않지만 받아주세요. 당신이 도움을 요청하시면, 저희가 바로 달려올게요. 무슨 일이 있어도요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_ParentsWithKid
#. Speaker = Komira
#. NodeID = eff22fea-56c2-755e-10cc-b7543915aad4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_ParentsWithKid:eff22fea-56c2-755e-10cc-b7543915aad4
msgctxt "hcec109b5gab11g4e9egada3gdc6eb392788c"
msgid ""
"I did - but I was robbed. You wouldn't know anything about that, would you?"
msgstr "있었죠. 하지만 강도를 당했어요. 그것에 대해선 아무것도 모르시죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_ParentsWithKid
#. Speaker = Player
#. NodeID = fa2ce1f8-c8e3-5cac-ff49-70e796eb22bb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_ParentsWithKid:fa2ce1f8-c8e3-5cac-ff49-70e796eb22bb
msgctxt "h1601788bg8c55g4f31gb27bg9de5e6d1d22b"
msgid "No more light-fingered antics - right, Arabella?"
msgstr "더 이상 도둑질하는 위험한 행동은 안되겠지, 아라벨라?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_ParentsWithKid
#. Speaker = Locke
#. NodeID = fde8ebaa-f081-2fea-d9b8-4930a9d576bb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_State_DruidsPacified = True
#. SetFlags:
#.   Quest:
#.     - DEN_SnakeCourt.ParentThankful(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_ParentsWithKid:fde8ebaa-f081-2fea-d9b8-4930a9d576bb
msgctxt "h8264dd8cg0708g45daga7efge22235c8a0b4"
msgid ""
"You saved our little girl <i>and</i> stopped the ritual. Thank you - we are "
"in your debt."
msgstr "저희 딸을 구해주신 <i>데다가</i> 의식도 멈춰 주셨군요. 감사해요 - 큰 빚을 졌어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Protester1
#. Speaker = Rechel
#. NodeID = 0dc0ad94-8d80-b41f-0468-6c8b1b639e7d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_GuardedEntrance_HasMet_Protester1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Protester1:0dc0ad94-8d80-b41f-0468-6c8b1b639e7d
msgctxt "hb8ca3934g8ca2g43a3g8c04g6df4be231b6b"
msgid ""
"Lives are at stake, and the cowards only care about their bloody rituals!"
msgstr "수많은 목숨이 경각에 달려 있는데, 겁쟁이들은 망할 의식에만 관심이 있어요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Protester1
#. Speaker = Rechel
#. NodeID = bc4ef036-7c4f-bab3-8869-f384da1e8cbf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_GuardedEntrance_HasMet_Protester1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Protester1:bc4ef036-7c4f-bab3-8869-f384da1e8cbf
msgctxt "hd460edc5g6e59g4c48ga5cega85228382fce"
msgid ""
"Those druids are going to get us killed - nothing sacred about this lot!"
msgstr "저 드루이드들은 우리를 죽게 내버려둘거야. 이 무리들한테는 신성한 게 하나도 없어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Protester1
#. Speaker = Rechel
#. NodeID = fa81ab07-1ad6-497c-2d5c-75e6a0ee3a9d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_State_DruidsPacified = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Protester1:fa81ab07-1ad6-497c-2d5c-75e6a0ee3a9d
msgctxt "h30c5b90fg60beg4b4bg99e0g43787cd8c63c"
msgid ""
"Now they're done messing about with rituals, maybe them lot can make "
"themselves useful."
msgstr "쟤네도 이제 의식으로 난리 치는 건 끝났으니, 쓸모 있는 일을 하겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Protester2
#. Speaker = Amek
#. NodeID = 15175436-4964-8c13-c2a6-1f4f24b5495d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_State_DruidsPacified = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Protester2:15175436-4964-8c13-c2a6-1f4f24b5495d
msgctxt "hdfad7d55g29d9g4727ga722g89391719902e"
msgid "Looks like the druids have eased off some. Small mercies."
msgstr "보아하니 드루이드들이 좀 누그러진 것 같은데. 그나마 다행이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Protester2
#. Speaker = Amek
#. NodeID = 7193dd6c-e3a9-3ca1-3e3b-e5c40413cc04
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_GuardedEntrance_HasMet_Protester2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Protester2:7193dd6c-e3a9-3ca1-3e3b-e5c40413cc04
msgctxt "h9a66d4b0gec61g447dg9ef2g092369593a95"
msgid "Heartless bastards. They deserve to have the goblins burn 'em out."
msgstr "피도 눈물도 없는 자식들 같으니. 고블린들이 싹 다 태워버려도 싼 놈들이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Protester2
#. Speaker = Amek
#. NodeID = d7a57a82-783f-38eb-d10a-9d08a29b332d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_GuardedEntrance_HasMet_Protester2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Protester2:d7a57a82-783f-38eb-d10a-9d08a29b332d
msgctxt "h57da615fg5b4eg4b43g9991g01811e335b8f"
msgid "Those dirt-kissers would let us die for the sake of their bloody grove!"
msgstr "저 망할 진흙 성애자 놈들은 이 망할 숲을 위해서 우릴 죽게 내버려둘 거야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Protester3
#. Speaker = Xeph
#. NodeID = 1860c25a-b820-6ff6-c8cb-c4f339ec6d31
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_State_DruidsPacified = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Protester3:1860c25a-b820-6ff6-c8cb-c4f339ec6d31
msgctxt "h695e9e01g7997g47fdgbf91ga0e85e8f4b75"
msgid "This place ain't so special. Why were the druids so protective of it?"
msgstr "이 장소는 그렇게 특별하지 않아. 드루이드들은 왜 이곳을 유별나게 방어하려고 한 걸까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Protester3
#. Speaker = Xeph
#. NodeID = 75189e43-a309-38b9-f990-496c9d24ab64
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_GuardedEntrance_HasMet_Protester3(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Protester3:75189e43-a309-38b9-f990-496c9d24ab64
msgctxt "hd1467258gffd0g462ag8d55g46a19dcdcfb4"
msgid ""
"We could help each other - fight the goblins together. Instead these fools "
"are trying to chase us away!"
msgstr "같이 싸울 수 있는데, 싸워서 고블린들을 물리칠 수 있을 텐데. 그런데 이 멍청이들은 우릴 내쫓을 궁리만 하고 있다니!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Protester3
#. Speaker = Xeph
#. NodeID = b49c2186-0296-3b0d-44f8-55a0b9d3a8ff
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_GuardedEntrance_HasMet_Protester3(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_Protester3:b49c2186-0296-3b0d-44f8-55a0b9d3a8ff
msgctxt "h746e0000g6e84g44c2g9da8ga18043e00d57"
msgid ""
"Look at them, trying to pretend we don't exist. Hey, you lot - I'm going "
"<i>nowhere!</i>"
msgstr "저놈들 보게. 우릴 없는 사람 취급하려 안달났군. 야, 이 자식들아, 난 <i>아무 데도 안 갈 거야!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentA
#. Speaker = Locke
#. NodeID = 0bcce09b-914a-99fa-8261-cc42410c86ba
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_HasMet_SoloParentB(1) = False
#.   Global:
#.      - DEN_GuardedEntrance_HasMet_PlayerAnnouncedDeath = False
#. SetFlags:
#.   Dialog:
#.     - DEN_HasMet_SoloParentB(1) = True
#.   User:
#.     - DEN_GuardedEntrance_HasMet_Parents(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentA:0bcce09b-914a-99fa-8261-cc42410c86ba
msgctxt "h6ac9410eg3712g4965g8d05gc5d426eaf1a9"
msgid ""
"All Arabella wanted to do is help. But you and half the grove stood by and "
"let her die - alone."
msgstr ""
"아라벨라는 그저 도움이 되고 싶었던 거야. 그런데 당신과 숲의 절반은 팔짱 끼고 서서 그 애가 죽는 걸 지켜보기만 했어. 혼자 쓸쓸히 "
"죽는걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentA
#. Speaker = Locke
#. NodeID = 16eaacdf-e6c4-a624-b206-d2b852f3021a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_HasMet_SoloParentA(1) = False
#.   Global:
#.      - DEN_GuardedEntrance_State_KidIsBack = True
#. SetFlags:
#.   Dialog:
#.     - DEN_HasMet_SoloParentA(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentA:16eaacdf-e6c4-a624-b206-d2b852f3021a
msgctxt "h4e688affg8e89g4bc2g8175g327e1cad44a9"
msgid ""
"The road to Baldur's Gate looks a little less daunting now that we're all "
"back together."
msgstr "이제 우리 가족이 모두 모였으니, 발더스 게이트로 가는 길은 좀 덜 험난하겠군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentA
#. Speaker = Locke
#. NodeID = 1b271097-6af0-6ddf-1689-06acf1fb83b9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentA:1b271097-6af0-6ddf-1689-06acf1fb83b9
msgctxt "ha58634bdgaab5g4cabgb676g2a3f9f1bb3f4"
msgid "<i>Get away.</i>"
msgstr "<i>저리 가시오.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentA
#. Speaker = Locke
#. NodeID = 44c55800-f830-2577-2070-065b87f997e0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GuardedEntrance_HasMet_PlayerAnnouncedDeath = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentA:44c55800-f830-2577-2070-065b87f997e0
msgctxt "h3f1adb17gb1b7g4ff1ga428gf78313a36878"
msgid "<i>Get away.</i>"
msgstr "<i>저리 가시오.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentA
#. Speaker = Locke
#. NodeID = 54e10ed7-7582-1676-345b-04887a1ee7ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentA:54e10ed7-7582-1676-345b-04887a1ee7ec
msgctxt "h6d6986d8g76dag4bb9g9b6agcc6fe6ab157c"
msgid "Get out of my sight. For your own good."
msgstr "내 눈에 띄지 마. 다치기 싫으면."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentA
#. Speaker = Locke
#. NodeID = 80ae5893-955e-9ec2-143f-a896237dee03
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_HasMet_SoloParentB(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_HasMet_SoloParentB(1) = True
#.   User:
#.     - DEN_GuardedEntrance_HasMet_Parents(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentA:80ae5893-955e-9ec2-143f-a896237dee03
msgctxt "h35fb9948ga681g4493gb337g376b60700d4e"
msgid "Leave me."
msgstr "저를 내버려두십시오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentA
#. Speaker = Locke
#. NodeID = 84c857d5-9521-a08e-96f5-c81166c2651f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_HasMet_SoloParentA(1) = True
#.   Global:
#.      - DEN_GuardedEntrance_State_KidIsBack = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentA:84c857d5-9521-a08e-96f5-c81166c2651f
msgctxt "hc8a499f2g3eb2g4ca4g9a42ga0c6826dc7bd"
msgid ""
"Arabella has behaved herself - so far. A miracle in itself. Thank you again."
msgstr "아라벨라는 지금까지는 얌전하게 굴었어. 그 자체로 기적이야. 다시 한번 고마워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentA
#. Speaker = Locke
#. NodeID = 85d37cea-5238-511a-7f06-120217f97b62
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_GuardedEntrance_HasMet_SoloParentBPacified(1) = False
#.   Global:
#.      - DEN_GroveConflict_State_DruidsPacified = True
#. SetFlags:
#.   Dialog:
#.     - DEN_GuardedEntrance_HasMet_SoloParentBPacified(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentA:85d37cea-5238-511a-7f06-120217f97b62
msgctxt "hbe458621gf8d6g428ag85b0g153463da1929"
msgid ""
"Everyone is so excited about leaving now. But without Arabella - it doesn't "
"matter. None of it matters."
msgstr "모두 발더스 게이트로 떠난다는 사실에 신나있어요. 하지만 저흰 아라벨라 없이는 의미가 없어요. 아무것도 의미가 없다고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentA
#. Speaker = Locke
#. NodeID = 9314e2eb-9d73-7454-4c00-1a2e0bac5837
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_GuardedEntrance_HasMet_LiedAboutDeath(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentA:9314e2eb-9d73-7454-4c00-1a2e0bac5837
msgctxt "h1c8416a2gcc03g4769gbee8g19f65f293b00"
msgid "<i>Get away.</i>"
msgstr "<i>저리 꺼져.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentA
#. Speaker = Locke
#. NodeID = 9b4166cc-fd09-f4cb-da72-e59d2229462a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_GuardedEntrance_HasMet_SoloParentAPacified(1) = True
#.   Global:
#.      - DEN_GroveConflict_State_DruidsPacified = True
#.      - DEN_GuardedEntrance_State_KidIsBack = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentA:9b4166cc-fd09-f4cb-da72-e59d2229462a
msgctxt "h86358213gd1b7g4386g902cg213c6852be9b"
msgid "We can prepare for the journey to Baldur's Gate in peace now."
msgstr "이젠 평화롭게 발더스 게이트로 떠날 준비를 할 수 있어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentA
#. Speaker = Locke
#. NodeID = a4b1520a-ef46-ec14-1b36-d7e685cf88ad
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_GuardedEntrance_HasMet_LiedAboutDeath(1) = True
#.      - DEN_HasMet_SoloParentB(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_HasMet_SoloParentB(1) = True
#.   User:
#.     - DEN_GuardedEntrance_HasMet_Parents(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentA:a4b1520a-ef46-ec14-1b36-d7e685cf88ad
msgctxt "h32d70194g2d3eg4acegab99g210abb625895"
msgid "I am not a violent man. But lying to us about Arabella?"
msgstr "난 원래 난폭한 사람은 아닌데, 아라벨라에 대해서 거짓말을 했다고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentA
#. Speaker = Locke
#. NodeID = aa309fb2-225f-fc52-f900-63e335c43f27
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_GuardedEntrance_HasMet_SoloParentAPacified(1) = False
#.   Global:
#.      - DEN_GroveConflict_State_DruidsPacified = True
#.      - DEN_GuardedEntrance_State_KidIsBack = True
#. SetFlags:
#.   Dialog:
#.     - DEN_GuardedEntrance_HasMet_SoloParentAPacified(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentA:aa309fb2-225f-fc52-f900-63e335c43f27
msgctxt "h52e6fc6cgcf29g4ac2g8eabg95100cf53f26"
msgid ""
"You got our little girl home safe, and I can rest easy knowing we won't be "
"turned out on our backsides. I can't say thanks enough."
msgstr ""
"우리 딸을 안전하게 집으로 데려와주셔서 감사합니다. 이제 우리는 쫓겨나지 않을 거라는 걸 알기에 편히 쉴 수 있습니다. 정말 고맙습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentB
#. Speaker = Komira
#. NodeID = 00a2bc27-b04f-34a6-f29f-6e7df0319567
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_HasMet_SoloParentB(1) = True
#.   Global:
#.      - DEN_GuardedEntrance_State_KidIsBack = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentB:00a2bc27-b04f-34a6-f29f-6e7df0319567
msgctxt "hc1fb3510g97f3g40bcgbc37geccb72bc5e4a"
msgid ""
"I'm not letting Bells out of my sight. Should the druids try anything "
"again... well, Kelemvor is going to be busy."
msgstr "벨을 내 눈에서 떼지 않을 거야. 만약 드루이드들이 뭔가를 다시 시도한다면... 하, 켈렘보르가 바빠질거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentB
#. Speaker = Komira
#. NodeID = 238e182d-281d-ba96-5cf4-8068c040bda6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_GuardedEntrance_HasMet_SoloParentBPacified(1) = True
#.   Global:
#.      - DEN_GroveConflict_State_DruidsPacified = True
#.      - DEN_GuardedEntrance_State_KidIsBack = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentB:238e182d-281d-ba96-5cf4-8068c040bda6
msgctxt "ha0e104c6g8169g4a5aga944g2d4b73e69879"
msgid ""
"Because of you, we can leave on our own terms. That'll make all the "
"difference on the road ahead."
msgstr "당신 덕분에, 우리 뜻대로 숲을 떠날 수 있게 되었어요. 앞으로의 여행길에 좋은 의미로 큰 차이가 있을 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentB
#. Speaker = Komira
#. NodeID = 2619e699-f915-b610-1e4b-824dc05cd1e8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_State_DruidsPacified = True
#.      - DEN_ShadowDruid_State_KaghaIsDead = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentB:2619e699-f915-b610-1e4b-824dc05cd1e8
msgctxt "h2c7c893bg671ag44caga08eg4d44e3236f58"
msgid ""
"Everyone else is licking your boots but some advice? Stay the hells away "
"from me - unless you fancy meeting Kelemvor."
msgstr "다들 당신한테 알랑거리느라 정신없어 보이지만 충고 하나 하지. 켈렘보르를 만나고 싶지 않으면 내 근처에 얼씬도 하지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentB
#. Speaker = Komira
#. NodeID = 267c7d11-9596-215c-61ef-e073ab043e72
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_GuardedEntrance_HasMet_SoloParentBPacified(1) = False
#.   Global:
#.      - DEN_GroveConflict_State_DruidsPacified = True
#. SetFlags:
#.   Dialog:
#.     - DEN_GuardedEntrance_HasMet_SoloParentBPacified(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentB:267c7d11-9596-215c-61ef-e073ab043e72
msgctxt "h21eb2314g8331g4e07gba3fg5cf3d7920297"
msgid ""
"The ritual is stopped. That's all Arabella wanted. That's what she tried so "
"hard to do. Please - leave me."
msgstr "의식이 멈췄어요. 아라벨라가 원한 건 그게 전부인데. 아라벨라가 그렇게까지 해서 멈추려던 건데. 부탁해요, 혼자 있고 싶어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentB
#. Speaker = Komira
#. NodeID = 2d81b125-2806-07ee-ef08-1586d7f19f25
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GuardedEntrance_HasMet_PlayerAnnouncedDeath = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentB:2d81b125-2806-07ee-ef08-1586d7f19f25
msgctxt "h778ee0e4g8572g4cfbga6c4g7e0d4148989f"
msgid "LEAVE ME."
msgstr "<b>좀 가라고</b>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentB
#. Speaker = Komira
#. NodeID = 49e29611-d5e4-507c-b763-15be1194a029
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_HasMet_SoloParentB(1) = False
#.   Global:
#.      - DEN_GuardedEntrance_State_KidIsBack = True
#. SetFlags:
#.   Dialog:
#.     - DEN_HasMet_SoloParentB(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentB:49e29611-d5e4-507c-b763-15be1194a029
msgctxt "h3650c9fag3529g4669g85a2g958b9093a346"
msgid ""
"Because of you, I got my little girl back. That's not something I'll forget."
msgstr "당신 덕분에 딸이 무사히 돌아왔죠. 그건 절대 잊지 않을 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentB
#. Speaker = Komira
#. NodeID = 514b1a32-52b5-45cc-3749-28b5b71cfdcb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_GuardedEntrance_HasMet_SoloParentBPacified(1) = False
#.   Global:
#.      - DEN_GroveConflict_State_DruidsPacified = True
#.      - DEN_GuardedEntrance_State_KidIsBack = True
#. SetFlags:
#.   Dialog:
#.     - DEN_GuardedEntrance_HasMet_SoloParentBPacified(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentB:514b1a32-52b5-45cc-3749-28b5b71cfdcb
msgctxt "h27a6a924g08e6g488fgb2beg7e90ed095bda"
msgid ""
"Arabella is back and the druids have stopped their warbling. The day just "
"got a lot brighter - thanks to you."
msgstr "아라벨라가 돌아오고 드루이드들이 중얼거림을 멈췄어요. 덕분에 하루가 훨씬 밝아졌습니다. 감사합니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentB
#. Speaker = Komira
#. NodeID = 5dc593bf-4f0a-fa80-83c7-fc909270fe4a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_HasMet_SoloParentB(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_HasMet_SoloParentB(1) = True
#.   User:
#.     - DEN_GuardedEntrance_HasMet_Parents(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentB:5dc593bf-4f0a-fa80-83c7-fc909270fe4a
msgctxt "h6a5d2e6bg8940g42abg953agdb7b68163064"
msgid "Move on."
msgstr "저리 가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentB
#. Speaker = Komira
#. NodeID = 5e44b943-b809-f578-bd2b-9390bbe617d0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_GuardedEntrance_HasMet_LiedAboutDeath(1) = True
#.      - DEN_HasMet_SoloParentB(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_HasMet_SoloParentB(1) = True
#.   User:
#.     - DEN_GuardedEntrance_HasMet_Parents(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentB:5e44b943-b809-f578-bd2b-9390bbe617d0
msgctxt "hfa884866g28a7g4d22ga030gda565ab61d92"
msgid "You bastard - you lied to me. You said Arabella was all right!"
msgstr "이 개자식, 내게 거짓말을 했어. 아라벨라는 괜찮다고 그랬잖아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentB
#. Speaker = Komira
#. NodeID = 690ccc49-69c6-bfb7-b56f-850782306ddf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentB:690ccc49-69c6-bfb7-b56f-850782306ddf
msgctxt "h831cad10g06a6g41b3g87b8ge453e0eb6106"
msgid ""
"You have any sense? You and that snake Kagha will sleep with one eye open."
msgstr "생각이라는 걸 안 하나? 당신도, 그 독사 같은 카그하 년도 잠자리 조심하라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentB
#. Speaker = Komira
#. NodeID = 74d03e94-176b-213d-29f6-eaecb6a01403
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_GuardedEntrance_HasMet_LiedAboutDeath(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentB:74d03e94-176b-213d-29f6-eaecb6a01403
msgctxt "hfe896241gc277g4cefgb507gb3779b68149c"
msgid "LEAVE ME."
msgstr "<b>좀 가라고</b>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentB
#. Speaker = Komira
#. NodeID = 7a7c7dac-ce0c-f96b-ec3b-492bc14057da
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KaghaIsDead = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentB:7a7c7dac-ce0c-f96b-ec3b-492bc14057da
msgctxt "h9a2500ceg7286g4914g8506g3d11ca0e4c2f"
msgid ""
"And then you kill that snake Kagha? I don't know whose side you're on, but "
"stay the <i>hells </i>away from me."
msgstr ""
"그리고서는 그 독사 같은 카그하 년을 죽인다고? 대체 당신이 누구 편에 서는 건지 모르겠지만, 나에게서 <b>제발</b> 좀 떨어져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentB
#. Speaker = Komira
#. NodeID = 98cb98d9-e0f7-a860-0549-1d0effc63a2e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentB:98cb98d9-e0f7-a860-0549-1d0effc63a2e
msgctxt "h8e7154aag7c8bg460bg9688g1ebfa212be4b"
msgid "LEAVE ME."
msgstr "<b>좀 가라고</b>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentB
#. Speaker = Komira
#. NodeID = a8654cdf-b510-c4a6-21bc-4bda532678db
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_HasMet_SoloParentB(1) = False
#.   Global:
#.      - DEN_GuardedEntrance_HasMet_PlayerAnnouncedDeath = False
#. SetFlags:
#.   Dialog:
#.     - DEN_HasMet_SoloParentB(1) = True
#.   User:
#.     - DEN_GuardedEntrance_HasMet_Parents(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentB:a8654cdf-b510-c4a6-21bc-4bda532678db
msgctxt "h9e0af2f4gb97cg4b3ega445g2d85c589ba81"
msgid "My little girl is <i>dead. </i>You were there! Why didn't you stop it?"
msgstr "내 딸아이가 <i>죽었어. </i>당신도 거기 있었어! 왜 막지를 않은 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentB
#. Speaker = Komira
#. NodeID = f14cce00-21a7-1198-3745-ba4f981a857c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_GuardedEntrance_SoloParentB:f14cce00-21a7-1198-3745-ba4f981a857c
msgctxt "he8152fd6g91b2g4940gbfbeg3ae7a480b615"
msgid "You bastard. Get away! GET AWAY FROM ME!"
msgstr "이 개자식. 저리 꺼져! <b>나한테서 떨어져!</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = 00e071ee-2294-d205-30b8-340d9165f243
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:00e071ee-2294-d205-30b8-340d9165f243
msgctxt "h158dd8a3g3f9cg4d4eg83d0g800d0e0a1530"
msgid "I don't really know what's wrong with me, that's the problem."
msgstr "뭐가 문제인지 저도 모릅니다. 그게 제일 문제죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = 02c537c0-18f5-e642-236c-5f9ad949edda
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - NIGHT_DarkUrge_MurderOfAlfira = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:02c537c0-18f5-e642-236c-5f9ad949edda
msgctxt "hf76edc22gc3deg4463gb87fgf2c077183a10"
msgid "I lost all of my past memory, and worse: I keep losing new parts of it."
msgstr "과거의 기억이 전혀 없는 데다가 새로운 기억도 조금씩 사라져요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 04167bb8-14bb-7963-826c-e02b880f00d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:04167bb8-14bb-7963-826c-e02b880f00d9
msgctxt "hfc066b93gfaa9g4d20g8580g3edb4318489f"
msgid ""
"I'm tempted to smack them all on the backside and tell them to kiss and make "
"up!"
msgstr "모두의 뒤통수를 때려준 뒤 키스하고 화해하라고 말하고 싶단다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = 0419aa77-5e7d-f6d2-4629-7aece8359747
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:0419aa77-5e7d-f6d2-4629-7aece8359747
msgctxt "hc93b79bdgdd76g4df2gb87fg58364238b8aa"
msgid "Isn't that half the fun?"
msgstr "그것도 재미의 일부 아닌가요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = 06c7d74d-ea3c-325a-9da8-6c97b9a5763f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:06c7d74d-ea3c-325a-9da8-6c97b9a5763f
msgctxt "h0063c392g33c2g4931g946agf43a217902ec"
msgid ""
"Real magic is chaos. Turning blue is a small price to pay for such power."
msgstr "원래 마법은 혼돈이죠. 그런 힘을 쓰는데 파랗게 질리는 정도는 사소한 것 같은데 말이죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = 0789924f-04b1-babb-fe23-0228ec41fae0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:0789924f-04b1-babb-fe23-0228ec41fae0
msgctxt "h9ef43111g76a4g4afega5b8gf3feb2d15f77"
msgid "No cure you offer can provide effective purification."
msgstr "네가 주겠다는 치유는 효과적인 정화가 될 수 없다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = 09818198-a832-fdda-36c8-2eb05f2326d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:09818198-a832-fdda-36c8-2eb05f2326d4
msgctxt "h1136bf55g9b77g4727g8a6cg623b52809786"
msgid "<i>Leave. </i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 0e901c11-87a1-31e7-f9ce-6f44800bf69d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:0e901c11-87a1-31e7-f9ce-6f44800bf69d
msgctxt "h0de52158gaddeg425fgbbf8gc8854e10b83e"
msgid "You or the dragon your blood hitched a ride with?"
msgstr "너 말이니, 아니면 네 혈통이 얻어 탔던 그 드래곤?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = 0f6130e9-a0eb-1941-290d-2a26d15fd4e8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:0f6130e9-a0eb-1941-290d-2a26d15fd4e8
msgctxt "ha6ed4cd1g48a8g4ee0g9f21gcb78d821d37f"
msgid ""
"True. Once, I finished a spell, blacked out, and woke up at a wedding. Great "
"party, though."
msgstr "사실이에요. 한번은 주문을 완성했더니, 기절했고, 깨어나보니 결혼식을 하고 있더라고요. 피로연이 썩 대단했는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 105e4199-cf4c-985a-0bbc-97fada92a249
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:105e4199-cf4c-985a-0bbc-97fada92a249
msgctxt "h78e8db76ga83fg4b9fg8f59g4cf93399136e"
msgid "Especially if he has a... tentacle issue."
msgstr "특히 촉수와 관련된 문제가 있다면... 더욱 그렇지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = 13cd0b85-2c54-4915-fdf3-feea07f77bd0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:13cd0b85-2c54-4915-fdf3-feea07f77bd0
msgctxt "h209d3bb0g60f6g4306g9c12g3bf5570d46d5"
msgid "What harm? Show me your wares."
msgstr "본다고 나쁠 건 없겠죠. 뭘 파는지 보여줘요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 14ef3662-9264-89e8-b4f6-bb9a4f0d1bae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:14ef3662-9264-89e8-b4f6-bb9a4f0d1bae
msgctxt "h0b36c749g0172g43c4g9a7dgbbd83850d172"
msgid "I can smell it from here. Like iron and fire - <i>delicious.</i>"
msgstr "여기서도 냄새를 맡을 수 있단다. 마치 철과 불처럼, <i>상큼아.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 1b8b01eb-f736-9317-afcf-f2a8b4f81f39
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:1b8b01eb-f736-9317-afcf-f2a8b4f81f39
msgctxt "h7787c757gdc59g4a07gbf69g670c6a6bbe63"
msgid ""
"Hah! We're two peas in a pod, sweetie. What's life without a little fun, eh?"
msgstr "하! 우린 정말이지 꼭 닮았구나, 얘야. 그런 재미가 없으면 인생을 무슨 맛으로 살겠니, 그치?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = 1bfdda34-3138-79a1-1a68-a468e54b84c5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:1bfdda34-3138-79a1-1a68-a468e54b84c5
msgctxt "h8c619ec0g4501g4cacg8524gbd1a45980f6d"
msgid "My health is my concern, not yours."
msgstr "내 건강 문제는 당신 알 바 아니에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = 21d0d6d2-94ee-c0bf-5dc4-543bf41a1a97
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:21d0d6d2-94ee-c0bf-5dc4-543bf41a1a97
msgctxt "h4fde6016gbf69g488bg869cge6b0f061997e"
msgid "I've been better. It's... difficult to explain."
msgstr "영 좋지는 않아요. 뭐랄까... 설명하긴 힘들지만요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 22ffa005-0630-6f2b-ff44-23e15c818db6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:22ffa005-0630-6f2b-ff44-23e15c818db6
msgctxt "hc11e1e31gb235g4e0fg9338g5b72b0dd5fed"
msgid ""
"Were you hurt recently? An accident of some sorts? That could explain things."
msgstr "최근에 다친 거니? 어떤 종류의 사고? 그게 상황을 설명할 수 있을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = 264f2523-aa51-e192-7efe-07a960fc3c29
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:264f2523-aa51-e192-7efe-07a960fc3c29
msgctxt "haf7c3fbdg1f1eg497bga874gb92aee416422"
msgid "I'm just here to trade."
msgstr "그냥 거래를 좀 하러 왔어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 26d861d4-536f-9bce-7700-53fde8c16b77
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:26d861d4-536f-9bce-7700-53fde8c16b77
msgctxt "he7bd416fg1de7g4634gb706g0daffa95c955"
msgid ""
"Hah! I'm far more than a peddler, dearie. Surprised I had to spell it out - "
"I thought you the observant sort."
msgstr "하! 그저 약재상이 아니란다, 얘야. 내 입으로 말하게 될 줄은 몰랐구나, 넌 좀 더 똑똑한 아이인 줄 알았는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = 27a16f7a-4f2a-2c97-5821-33de70ffbb7d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:27a16f7a-4f2a-2c97-5821-33de70ffbb7d
msgctxt "he916e0fcg9c86g4d40g86e4gca2cd71d465d"
msgid "<i>Leave. </i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = 290ef15d-b3e3-2ed2-b7be-1f43332209a1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:290ef15d-b3e3-2ed2-b7be-1f43332209a1
msgctxt "h4a078b11g0f29g48a8g97e4g5e55d17ef20d"
msgid "Let me see your wares."
msgstr "물건 좀 볼게요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = 2a8e865d-2cc7-8d42-70b9-6fb4b28c74b2
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_GALE or WIZARD
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:2a8e865d-2cc7-8d42-70b9-6fb4b28c74b2
msgctxt "hd06ab068g104ag4fbdga4d0g32871de7e0e5"
msgid ""
"I doubt a simple potion will suffice. This problem calls for strong magic."
msgstr "물약 가지고는 충분하지 않을 것 같은데요. 이 문제엔 더 강한 마법이 필요해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Shadowheart
#. NodeID = 2a8f3f30-6524-f109-6f8f-d829a2f45401
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:2a8f3f30-6524-f109-6f8f-d829a2f45401
msgctxt "h4ec6a5ceg4854g4192g87ecgbaf3a205c122"
msgid "Something doesn't add up about this one. Don't tell her anything."
msgstr "이 자는 뭔가 수상해. 그녀에게 아무것도 말하지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 2bd09f64-5372-fb0d-ab8f-07b282acd55f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:2bd09f64-5372-fb0d-ab8f-07b282acd55f
msgctxt "hc243758eg35b4g4d64g8211g9623cdf74730"
msgid "Not <i>accidentally, </i>no..."
msgstr "<i>실수로</i> 그런 적은 없단다..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = 2bee2e6e-3d3a-3c74-d0fd-41c0a79cdb7c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:2bee2e6e-3d3a-3c74-d0fd-41c0a79cdb7c
msgctxt "hb2652f89g8829g499eg8cd3g34ac3291d169"
msgid "There's something awful about my instincts, about my desires."
msgstr "제 본능과 욕망 안에 끔찍한 것이 있어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 320c3897-a42e-6d0b-8617-aeb0a6a495b4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ASTARION(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:320c3897-a42e-6d0b-8617-aeb0a6a495b4
msgctxt "h8d30c57bg0b79g4d5bgb075gc109fb08a0a0"
msgid ""
"Interesting to see you strutting about in the sun. Ain't seen that before, "
"and Auntie Ethel's seen her fair share."
msgstr "태양빛 아래에서 걷고 있다니 흥미롭구나. 그런 광경은 처음 보네, 이 이모가 꽤나 오래 살았는데도 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 3228b9a8-d900-6801-2653-b68579a324d3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:3228b9a8-d900-6801-2653-b68579a324d3
msgctxt "hec0d9047g377bg41b3gb03bge8f139682b99"
msgid ""
"And encourage you to browse my bits and pieces, of course. Let me know if "
"anything catches your eye - myself included."
msgstr "그리고 물론, 내 물건들을 마음껏 둘러보도록 해. 마음에 드는 게 있으면 알려주렴 - 나를 골라도 좋단다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 323cc05b-d9d9-7ce0-6072-fd5f51a874b8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:323cc05b-d9d9-7ce0-6072-fd5f51a874b8
msgctxt "hfcb5169dg0136g41d4gb08ag34294bc92d28"
msgid "Sure what else am I here for? Bye now, petal."
msgstr "그럼, 내가 여기 온 이유가 뭐겠니? 잘가렴, 얘아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 36a2d890-2ea6-9118-2655-9279c06ed45a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:36a2d890-2ea6-9118-2655-9279c06ed45a
msgctxt "hb8546737g9e3dg49a8g9e63g4d7c462500ea"
msgid "...yes. I may have something at home!"
msgstr "…그래. 집에 가면 뭔가 방법이 있을지도 모르겠구나!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = 36a81292-0338-96da-7787-074eac4259a8
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: SORCERER or WARLOCK
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:36a81292-0338-96da-7787-074eac4259a8
msgctxt "hc7f995cfgddaag4aa6gaaa1gd7cc5dbcde0d"
msgid "There is something <i>strange</i> about you."
msgstr "당신 뭔가 <i>이상한걸</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 37cdff49-7ac8-97e7-6631-c3f6d1953f6e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:37cdff49-7ac8-97e7-6631-c3f6d1953f6e
msgctxt "hfe921904g50e0g4534g90a0g5e763a148c20"
msgid ""
"I'm a simple woman, sweetie. Tea and potions are as exciting as it gets for "
"these old bones."
msgstr "난 평범한 여인이란다, 아이야. 그저 차와 물약을 파는 늙은이일 뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 3981ef6a-f0e6-1389-cc0d-886bda90242b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:3981ef6a-f0e6-1389-cc0d-886bda90242b
msgctxt "h2fae58c1gce83g46bfgaa7egd4fec24c8152"
msgid ""
"Oh, petal, that's how it starts you know - thinking is only a step away from "
"doing."
msgstr "오, 얘아, 그렇게 시작되는 거야. 생각은 행동에서 고작 한 걸음 떨어져 있을 뿐이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = 3afee257-1d7a-bcff-eacd-25a77f437c87
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_HALFLING(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:3afee257-1d7a-bcff-eacd-25a77f437c87
msgctxt "h86d671bbg51cbg4593g8cc3g79650bc21467"
msgid ""
"It would be remiss of me to turn down a homemade brew. Thank you kindly."
msgstr "손수 만드신 포션을 거절하는 건 부끄러운 일이겠죠. 감사합니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 3e97da58-6f5f-3208-1801-3712211310b9
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DWARF or DUERGARDWARF
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:3e97da58-6f5f-3208-1801-3712211310b9
msgctxt "hee0db04dg19dag482bgb0d5g9a20ffc9600e"
msgid ""
"Your cheeks aren't nearly ruddy enough, petal! Are you hurt? Cold? Feverish?"
msgstr "뺨이 아주 홀쭉해졌구나 아이야! 다친 거니? 감기? 열이 나니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 3e97da58-6f5f-3208-1801-3712211310b9
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:3e97da58-6f5f-3208-1801-3712211310b9
msgctxt "h11dc0cdeg23a9g4d2dgb26eg45bdfe081125"
msgid "You look more green then yellow, petal! Are you hurt? Cold? Feverish?"
msgstr "얼굴이 초록빛이구나 얘야! 다친 거니? 감기? 열이 나니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 3e97da58-6f5f-3208-1801-3712211310b9
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: !HALFORC
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:3e97da58-6f5f-3208-1801-3712211310b9
msgctxt "ha5440ea9g1171g452dgb79bg62f324470e5f"
msgid ""
"There isn't a <i>bit</i> of colour in those cheeks, petal! Are you hurt? "
"Cold? Feverish?"
msgstr "얼굴이 완전 창백하구나, 얘야! 다친 거니? 감기? 열이 나니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 3e97da58-6f5f-3208-1801-3712211310b9
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: ELF or LOLTHDROWELF or SELDARINEDROWELF
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:3e97da58-6f5f-3208-1801-3712211310b9
msgctxt "hf9e8ea02g9bfdg41b1gb03cgcbc6e5b9dbc0"
msgid ""
"Those ears are practically drooping, petal! Are you hurt? Cold? Feverish?"
msgstr "정말 지쳐 보이는구나, 얘야! 다친 거니? 감기? 열이 나니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 3e97da58-6f5f-3208-1801-3712211310b9
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: BESTIAL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:3e97da58-6f5f-3208-1801-3712211310b9
msgctxt "h07525f90g7a24g4e04g8fc4g0bc4c0f60915"
msgid ""
"Your cheeks, at least, what I reckon are your cheeks, look a little flushed, "
"love. Are you hurt? Cold? Feverish?"
msgstr "뺨이 좀 붉어 보이는데, 얘야. 어디 다친 거니? 감기? 열이 나니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 3e97da58-6f5f-3208-1801-3712211310b9
#. HandlePath = TaggedText[5].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:3e97da58-6f5f-3208-1801-3712211310b9
msgctxt "h995b7cfeg985ag4c72ga7d4gccda21b4d85d"
msgid ""
"There's an awful slump to those broad shoulders of yours, petal. Are you "
"hurt? Cold? Feverish?"
msgstr "넓은 어깨가 푹 늘어졌구나 얘야. 어디 다친 거니? 감기? 열이 나니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 3ec9efb1-18a8-f38a-2998-03d4247390c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:3ec9efb1-18a8-f38a-2998-03d4247390c8
msgctxt "h0a757c90g831ag44b9g80e4g2d40a76d0fc3"
msgid ""
"I'm sorry, but I can't do much for you here. You could try asking around, "
"but be careful."
msgstr "미안하지만, 여기선 해줄 수 있는 게 많이 없구나. 주변 사람들에게 물어보는 건 괜찮겠지만, 조심하렴."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = 3fe275ad-ceab-d5aa-b607-8f8ae11fe61e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:3fe275ad-ceab-d5aa-b607-8f8ae11fe61e
msgctxt "ha875edb5g9489g4e98g8342ge32f259b52bc"
msgid "I have a condition... an <i>unusual </i>condition."
msgstr "지금 좀 문제가 있어요... 좀 <i>이상한 </i>문제가요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = 4018f7e7-474d-3948-6900-eec7e9600f0e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:4018f7e7-474d-3948-6900-eec7e9600f0e
msgctxt "hbbd7a1d7gba1fg43f4ga4b3gc1260ea4d2b9"
msgid "I have a... condition. But it's complicated."
msgstr "문제가... 좀 있어요. 근데 좀 복잡해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 40540260-9aee-688f-fd1d-d1c50e0b03bc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:40540260-9aee-688f-fd1d-d1c50e0b03bc
msgctxt "h7a54f102gdc18g4ea6g9b22g23a0ed7844dc"
msgid "Take care now, sweetie."
msgstr "몸 관리 잘하려무나, 얘야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 40b73367-b3ee-c013-cba3-51275e5b2305
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_HagDouble_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:40b73367-b3ee-c013-cba3-51275e5b2305
msgctxt "h5d788adfg914bg437cg8d5fge25d5b461969"
msgid "Hello, petal! Need anything? Any lotions or potions?"
msgstr "반갑구나, 아이야! 뭔가 필요한 게 있니? 로션이나 포션이 필요해?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 41fdefa6-4e4e-9881-b3ff-41fdbbb99b1a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:41fdefa6-4e4e-9881-b3ff-41fdbbb99b1a
msgctxt "h623c77eeg35e0g4680gbef8g759a95f78455"
msgid "Are you all right?"
msgstr "괜찮니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 4339dee2-dd44-fa9f-2348-30f614afdc0c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:4339dee2-dd44-fa9f-2348-30f614afdc0c
msgctxt "h7cf6497cgaa89g4371g90e4gbe705bfa0461"
msgid "Petal, the things I've collected would blow your pretty little mind."
msgstr "꽃잎아, 내 수집품을 보면 깜짝 놀랄 거란다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 45d61967-91c0-e905-2abb-a7dcd39cad4e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:45d61967-91c0-e905-2abb-a7dcd39cad4e
msgctxt "hb61f2585g58acg4d98g9c85ga509d796b729"
msgid ""
"Oh, blessed Helm that sounds horrible. I don't know how I'd handle such a "
"thing."
msgstr "오, 그럴수가 정말 끔찍하게 들리는구나. 그런 건 어떻게 다뤄야 할지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 4821003f-be82-d0f0-62a7-6c88f78931ba
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: !(BESTIAL and PLANAR and RARE)
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:4821003f-be82-d0f0-62a7-6c88f78931ba
msgctxt "ha9f5feb0g747eg4770g9c49ge1afa11b74a0"
msgid "Thank goodness you came along when you - oh!"
msgstr "딱 필요할 때 - 이런!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 4821003f-be82-d0f0-62a7-6c88f78931ba
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:4821003f-be82-d0f0-62a7-6c88f78931ba
msgctxt "h10859c70g78fcg4c44g8216gded622eaa91c"
msgid ""
"It's a rare day I see one of you lot about. Thank goodness you came along "
"when you - oh!"
msgstr "너희 같은 애들은 정말 자주 못 보는데 말야. 마침 딱 맞춰서 와줬는 - 이런!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = 48dc0855-d13d-3d37-a1e7-c1625072d593
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:48dc0855-d13d-3d37-a1e7-c1625072d593
msgctxt "hb3250c4dg8ac0g427dgadebg1648566b1bbc"
msgid "You could be friend or foe. Why should I drink anything you prepare?"
msgstr "당신이 적인지 아군인지 모르는데, 어떻게 당신이 주는 걸 믿고 마시라는 거죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 4a370950-308d-f779-1d5e-943ea757b916
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:4a370950-308d-f779-1d5e-943ea757b916
msgctxt "h45231549gd6e0g48a1g8c50g1b86bb384e8a"
msgid ""
"Now that's as serious as serious gets. Our past defines us, petal. Without "
"it - why, we could be anyone!"
msgstr "정말 심각하구나. 우리의 과거만이 우리를 규정한단다, 얘야. 기억이 없다면 우리는 누구도 될 수 있겠지!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = 4a44c47a-11a2-08bb-f127-bf639eb26111
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:4a44c47a-11a2-08bb-f127-bf639eb26111
msgctxt "h894cc200gec9fg4d76ga8f9g556a33ea9546"
msgid "Speak of me or my ancestor like that again and I'll incinerate you."
msgstr "나나 내 선조들에 대해서 그따위로 한 번만 더 말하면 당신을 불태워버리겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 4a6a20d8-0906-af70-112e-6f15de6c7ceb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:4a6a20d8-0906-af70-112e-6f15de6c7ceb
msgctxt "h5423dc13g3c43g4761g863dg35b707084b24"
msgid "Now, do you need anything? I have a few odds and ends for sale."
msgstr "자, 뭔가 필요한 게 있니? 여기 자질구레한 물건들이 좀 있단다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = 4aa2dccf-d6e1-252d-8795-af2ffee15d20
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SORCERER(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:4aa2dccf-d6e1-252d-8795-af2ffee15d20
msgctxt "hd09e66d5gda4ag44degadc3g40bbc148e02d"
msgid "You have magic, but it feels... unusual. Are you a sorcerer too?"
msgstr "마법이 느껴지는데... 뭔가 이상하네요. 당신도 소서러인가요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = 4ab70e79-fb20-8536-4974-fe2194241117
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:4ab70e79-fb20-8536-4974-fe2194241117
msgctxt "h88871f26g3abag494cgab95g71917ab961e1"
msgid "This power is mine and mine alone - make no mistake."
msgstr "이 힘은 나의 것이고 오로지 나만이 가진다. 실수하지 마라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = 4bdf311b-9e4c-4529-3053-bfbcbc283ad9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:4bdf311b-9e4c-4529-3053-bfbcbc283ad9
msgctxt "h990ae8d7gae27g4216gbbd2g745fe8f3d769"
msgid "A being like <i>you </i>knows of the gith?"
msgstr "<i>당신 </i>같은 사람이 기스에 대해서 안다고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = 4c23f699-e54f-30ee-851b-c04d050ae6d1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SORCERER_WILDMAGIC(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:4c23f699-e54f-30ee-851b-c04d050ae6d1
msgctxt "h32be98aagc120g45abg931aga4fd01d3d07e"
msgid "Don't worry, my magic can fix me up! Probably."
msgstr "걱정 마세요, 제 마법으로 해결할 수 있을 테니까요! 아마도 말이죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 4ce034f1-ca06-02a5-3d37-38af04d87d3d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:4ce034f1-ca06-02a5-3d37-38af04d87d3d
msgctxt "h83619f66gf402g4b14g9ae0gdc2d073af681"
msgid ""
"I'm just curious about curiosities, is all. And you seem like quite the "
"curiosity."
msgstr "그냥 순전히 궁금할 뿐이란다, 그것뿐이야. 넌 상당히 흥미로운 아이 같아서 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 4d1ee104-b017-c382-00a1-ede2f0a40b88
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:4d1ee104-b017-c382-00a1-ede2f0a40b88
msgctxt "h9c4e4db8g53c4g4913gad93g27f406f8350b"
msgid ""
"I see no sign of a tentacle yet, but that could change in an instant. You "
"need help, <i>serious </i>help."
msgstr "아직은 촉수가 튀어나온 것 같진 않은데, 언제라도 그렇게 될지 모른단다. 넌 도움이 필요해, 중대한 도움 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = 4d7e3d00-f1f2-91d2-c4e9-8c1fede1843e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:4d7e3d00-f1f2-91d2-c4e9-8c1fede1843e
msgctxt "h8e8fd088g5467g4cf9g8be0gd892674266ce"
msgid ""
"My time could be running short. I can't afford to spend it paying you a "
"house visit."
msgstr "전 한시가 급해요. 당신 집이나 방문하고 있을 시간은 없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = 4e1f16fb-0b5c-4aea-a228-e5bb52de9ce9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - NIGHT_DarkUrge_MurderOfAlfira = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:4e1f16fb-0b5c-4aea-a228-e5bb52de9ce9
msgctxt "hf0741c70g8d8dg492agbd17gc248ee818e52"
msgid "I know nothing of my past, and my brain feels thick as a bog."
msgstr "과거도 전혀 모르겠고 머릿속은 안개가 낀 것 같아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = 4f2db140-11a6-c070-1f75-88b534bad34a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:4f2db140-11a6-c070-1f75-88b534bad34a
msgctxt "h7aa381d6g9691g47ecga26bg90fd9c204f49"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 52bc9bea-e30c-1885-dba9-fc0f717b2847
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:52bc9bea-e30c-1885-dba9-fc0f717b2847
msgctxt "he70594e8ga266g4cacg8a2agc23c17b83b44"
msgid ""
"You've power most can never dream of. I can smell it from here - like iron "
"and fire. Glorious."
msgstr "너는 대부분의 사람들은 꿈도 못 꿀 힘을 가졌군. 여기서도 냄새를 맡을 수 있단다. 철과 불처럼. 기특한 것."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = 55415016-e48f-8c71-fc0e-695454b90f79
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:55415016-e48f-8c71-fc0e-695454b90f79
msgctxt "h2ba4e513ga965g4a6dga40ag1c5ee1f29aca"
msgid "<i>Leave. </i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 5759ccad-3627-7aed-d946-b39bf9b7c077
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:5759ccad-3627-7aed-d946-b39bf9b7c077
msgctxt "hba8e6b58g023eg4395gbaf5gc88b4dae020c"
msgid ""
"Why don't you pop by, and we can have a little chat about it? I do love me a "
"handsome gentleman caller."
msgstr "잠시 들렀다 가는 건 어떻니, 살짝 수다도 좀 떨고? 너같이 잘생긴 녀석이라면 언제나 환영이란다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = 5972fdea-a892-200d-abdf-41a1547d1d64
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ASTARION(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:5972fdea-a892-200d-abdf-41a1547d1d64
msgctxt "h6941ac4cg89abg457cga864g5fa30c247cc3"
msgid "Well, aren't you a perceptive one, madam?"
msgstr "흠, 통찰력이 뛰어나신 분이군요, 부인?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = 599924be-5ef7-20ce-6ebc-19ca1e56444f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WARLOCK(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:599924be-5ef7-20ce-6ebc-19ca1e56444f
msgctxt "h1a1cf44cg17e4g4ecfg8c1ag19f578743d67"
msgid "You have a certain bearing. An almost fey-like quality."
msgstr "특이한 태도를 지니고 계시네요. 거의 페이 같은 느낌이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 59b8d281-40ab-22b6-94fa-b6d66f538d37
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:59b8d281-40ab-22b6-94fa-b6d66f538d37
msgctxt "h14806cc9gc434g4f5cgbfe0g37dc86d1488c"
msgid ""
"Expert? Pfft. I'm more reliable than any of those eejits with 'credentials'."
msgstr "전문가? 흥. 내가 소위 '자격증'이란 걸 지닌 멍청이들보다 훨씬 도움이 될 거란다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = 5a1de940-c3a8-8cb3-f5de-5cee9f87e20a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SORCERER(1) = True
#.      - SORCERER_WILDMAGIC(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:5a1de940-c3a8-8cb3-f5de-5cee9f87e20a
msgctxt "h8977d254gd786g4fd2g936bgad75707cc659"
msgid "I <i>am</i> magic. If I can't cure myself, nothing you concoct will."
msgstr "내가 <i>바로</i> 마법이에요. 전 제 스스로 고칠 수 있어요, 당신은 알 바 아니에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = 5dc4f47a-2fac-2e4d-61ef-2ee37312caa0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WARLOCK(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:5dc4f47a-2fac-2e4d-61ef-2ee37312caa0
msgctxt "h629d3972g4b1dg4239g98acg00b4293d0844"
msgid "I detect something <i>devilish</i>, I think."
msgstr "뭔가 <i>데빌스러운</i> 느낌이 드는 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 5f29e276-46e1-96ad-8c59-85c602423db4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:5f29e276-46e1-96ad-8c59-85c602423db4
msgctxt "h767b66dag87f6g4a73gb540g98e6700a6516"
msgid "...you don't look well. Are you all right?"
msgstr "…어딘가 불편해 보이는구나. 괜찮은 거니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 608bee58-ebee-c1f2-34a7-eb97575afb09
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:608bee58-ebee-c1f2-34a7-eb97575afb09
msgctxt "he9473ddcge2a5g45ceg9206gf8abb586170b"
msgid ""
"Hah! I'm far from innocent, petal. I was raising hell when you were still a "
"spark in your mammy's eye."
msgstr "하! 난 결백함이랑은 거리가 멀단다, 꽃잎아. 네가 엄마 젖이나 빨고 있을 때 난 지옥을 키워내고 있었다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = 6498fd3b-f6af-806c-b9db-3be5997ac568
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:6498fd3b-f6af-806c-b9db-3be5997ac568
msgctxt "h79adcedeg5a60g472aga76ag51651e878634"
msgid ""
"An illithid tadpole wormed into my head... but the others don't have "
"symptoms like me."
msgstr "일리시드 올챙이가 제 머릿속에서 기어다니고 있지만... 다른 사람들은 저와 같은 증상이 없네요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Lae'zel
#. NodeID = 680bcb80-b20d-baf1-bd1a-4c5830a991c9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(2) = True
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:680bcb80-b20d-baf1-bd1a-4c5830a991c9
msgctxt "hb75d766eg9d6ag4f3cgb5abg536990f10ca8"
msgid ""
"She is <i>not</i> to know of the... our ailment. Only a gith healer may make "
"us pure."
msgstr "그녀는 우리 질병에 대해서 아는 게 <i>없을</i> 거다. 오직 기스 치유사만이 우릴 정화할 수 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 6af1fe05-8bc3-0732-febc-93feb463b769
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:6af1fe05-8bc3-0732-febc-93feb463b769
msgctxt "h353f2748gc91cg4e1dgb3a2g59cd456311ff"
msgid "Nae bother."
msgstr "마음껏 둘러보렴."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 6ba91d49-7ec7-99a7-aafe-5cabfc8932b8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_HagDouble_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_HagDouble_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:6ba91d49-7ec7-99a7-aafe-5cabfc8932b8
msgctxt "hc3f0da5bg85dcg4d49gb371g9f69308978e1"
msgid "Ah, if it isn't the talk o' the camp?"
msgstr "아, 야영지의 화젯거리로구나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 6c8a0a26-95d2-a20f-d7b3-4a984f25ab7e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_HagDouble_HasMet(1) = False
#.   Global:
#.      - DEN_HagTrader_State_GavePotion = True
#. SetFlags:
#.   Dialog:
#.     - DEN_HagDouble_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:6c8a0a26-95d2-a20f-d7b3-4a984f25ab7e
msgctxt "h0dba491cgcbe2g4195g80f4g2fe0ceb75660"
msgid "Lotions and potions for all ail - Oh, no!"
msgstr "모든 질병을 위한 로션과 포션도 있 - 아니, 이런!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 6ca5a336-91b8-1042-abdd-0ed6f6b50d14
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: ELF or LOLTHDROWELF or SELDARINEDROWELF
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:6ca5a336-91b8-1042-abdd-0ed6f6b50d14
msgctxt "h3ef1dc7bg2291g4068g9bc0g0e266f27cb51"
msgid ""
"Those ears are practically drooping, dearie! Are you hurt? Cold? Feverish?"
msgstr "귀가 축 늘어졌구나, 아이야! 어디 다쳤니? 감기? 열이 나니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 6ca5a336-91b8-1042-abdd-0ed6f6b50d14
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DWARF or DUERGARDWARF
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:6ca5a336-91b8-1042-abdd-0ed6f6b50d14
msgctxt "hd2874801g5545g40f2g8ae7g8a9ebfb029b1"
msgid ""
"Your cheeks aren't nearly ruddy enough, dearie! Are you hurt? Cold? Feverish?"
msgstr "혈색이 좋지 않구나, 아이야! 다친 거니? 감기? 열이 나니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 6ca5a336-91b8-1042-abdd-0ed6f6b50d14
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:6ca5a336-91b8-1042-abdd-0ed6f6b50d14
msgctxt "h022de3b5g6acfg4426gbe5cgef87c88de677"
msgid "You look more green then yellow, dearie! Are you hurt? Cold? Feverish?"
msgstr "얼굴이 완전 초록빛이구나, 얘야! 다친 거니? 감기? 열이 나니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 6ca5a336-91b8-1042-abdd-0ed6f6b50d14
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: !HALFORC
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:6ca5a336-91b8-1042-abdd-0ed6f6b50d14
msgctxt "h9b87d198ga94cg4ab8ga79dg4d826d0654f9"
msgid ""
"There isn't a <i>bit</i> of colour in those cheeks, dearie! Are you hurt? "
"Cold? Feverish?"
msgstr "얼굴이 창백하구나, 얘야! 다친 거니? 감기? 열이 나니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 6ca5a336-91b8-1042-abdd-0ed6f6b50d14
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: BESTIAL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:6ca5a336-91b8-1042-abdd-0ed6f6b50d14
msgctxt "h41be4839gd778g4dd8gaed7gde029e310fe3"
msgid ""
"Your cheeks, at least what I reckon are your cheeks, look a little flushed, "
"love. Are you hurt? Cold? Feverish?"
msgstr "얼굴이 좀 상기됐구나, 얘야. 다친 거니? 감기? 열이 나니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 6ca5a336-91b8-1042-abdd-0ed6f6b50d14
#. HandlePath = TaggedText[5].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:6ca5a336-91b8-1042-abdd-0ed6f6b50d14
msgctxt "h5185c6afgc943g4b89gb6c6ge6fb5faf4332"
msgid ""
"There's an awful slump to those broad shoulders of yours, petal. Are you "
"hurt? Cold? Feverish?"
msgstr "넓은 어깨가 푹 늘어졌구나 얘야. 어디 다친 거니? 감기? 열이 나니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = 6d8acbc6-a3da-50fc-8430-0c955a6f2177
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:6d8acbc6-a3da-50fc-8430-0c955a6f2177
msgctxt "h47391544gda36g45b3gae2dgb7afae837038"
msgid "I've had such a pounding headache recently."
msgstr "최근에 정말 머리가 심하게 아팠어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Narrator
#. NodeID = 70bb41a7-a639-b52a-e94e-a7756e694f27
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:70bb41a7-a639-b52a-e94e-a7756e694f27
msgctxt "haa87f50fg9e73g429eg9d58g5c073c62f8d1"
msgid "*As you down the potion, a comforting warmth spreads through you.*"
msgstr "*물약을 삼키자, 따뜻한 온기가 몸에 퍼지며 편안해집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = 710d38ae-07a7-d44e-3506-d7d238f0e227
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SORCERER_DRACONIC(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:710d38ae-07a7-d44e-3506-d7d238f0e227
msgctxt "hb146eb68g75f5g4681gad7eg3ff270349c76"
msgid ""
"Do you have a powerful ancestor in your family perhaps? A <i>winged</i> one?"
msgstr "당신 가족 중에 강력한 조상이 있었죠? <i>날개</i>가 달린?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 717a9606-a588-1d66-5c66-5748690e2e95
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:717a9606-a588-1d66-5c66-5748690e2e95
msgctxt "h5d1da035g0611g4924gb933gff361440714a"
msgid "Nae bother."
msgstr "마음껏 둘러보렴."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 73442ca1-c9d4-4152-3f3b-b40644d008b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:73442ca1-c9d4-4152-3f3b-b40644d008b1
msgctxt "hef3cb399gfe61g44a7ga603g6d3744f41482"
msgid ""
"Hah! One time, I drank a bottle of mead so strong I tried to milk a chicken."
msgstr "하! 한번은, 벌꿀주를 너무 많이 마셔서 닭에게서 우유를 짜내려고 한 적도 있단다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = 73b53d21-d7df-4566-a800-2e9be6ee5dfc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:73b53d21-d7df-4566-a800-2e9be6ee5dfc
msgctxt "hf9543a8eg83dfg49e5ga5f6g55f6adbf1865"
msgid "What are you, an alchemist?"
msgstr "뭐 하는 분이죠? 연금술산가요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 75e86feb-85cc-2445-15e4-a7301286bc07
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:75e86feb-85cc-2445-15e4-a7301286bc07
msgctxt "h4040c35fg3ca3g4941g8413g1d308b66e839"
msgid "Don't get your knickers in a twist. I was only asking."
msgstr "너무 예민하게 받아들이지 말려무나. 그냥 물어보는 것뿐이니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 76fd00f3-07f5-2e36-e204-6b651ce6d1ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:76fd00f3-07f5-2e36-e204-6b651ce6d1ed
msgctxt "h219dc553gfe7fg40d7g8120g9d7ad17104b6"
msgid ""
"Besides, that magic of yours, mighty as I'm sure it is, is falling a little "
"short, isn't it? Something is wrong... I can smell it."
msgstr "게다가, 네 마법 말이야, 강력하긴 해보인다만, 슬슬 부족해 보이는데, 그렇지 않니? 뭔가 잘못된 게 분명해... 냄새가 나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Astarion
#. NodeID = 79fae9fd-0c15-571b-4964-ae19efeea940
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:79fae9fd-0c15-571b-4964-ae19efeea940
msgctxt "h6369f825g3aaag462bga516g83e57e60040a"
msgid "Why she sounds positively demented."
msgstr "어쩜 이렇게 긍정적으로 미친소리를 하실까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 7a07b96f-882d-5999-1fb9-3a5e985a7086
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:7a07b96f-882d-5999-1fb9-3a5e985a7086
msgctxt "he219f879g5846g4adaga784g18c1aa14f1f8"
msgid "Yes, and you're as grumpy as I remember. No offence, love but..."
msgstr "그래, 그리고 넌 내가 기억하는 것처럼 심술궂구나. 나쁜 뜻은 아니란다, 얘야 하지만..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 7a778907-55a2-2d8f-5c0e-adb1130ff93e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:7a778907-55a2-2d8f-5c0e-adb1130ff93e
msgctxt "h76be75a3g8627g4591ga95agef86b71cf0b8"
msgid ""
"But your magic, and I say this with love, is falling a little short, right? "
"Something is wrong - Auntie Ethel can always tell."
msgstr ""
"게다가, 네 마법 말이야, 강력하긴 해보인다만, 슬슬 부족해 보이는데, 그렇지 않니? 뭔가 잘못된 게 분명해. 에텔 이모는 뭐든지 알 수 "
"있단다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 7b782095-4b63-348d-eccf-df2202ba0447
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:7b782095-4b63-348d-eccf-df2202ba0447
msgctxt "hf206ab94ga7f6g4b93g8e4eg1f63bfae5ee9"
msgid "Didn't taste half bad either."
msgstr "그 와중에 맛은 그리 나쁘지 않더구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 7c34d1e5-3b12-c208-1cb9-d59ff47280fa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:7c34d1e5-3b12-c208-1cb9-d59ff47280fa
msgctxt "h6c5ba584g1d88g45f9g984fg08effa8bb153"
msgid ""
"As much as I love a good natter, something is awry, isn't it? Auntie Ethel "
"has a nose for these things."
msgstr "이렇게 수다떠는걸 정말 좋아한단다. 그런데, 뭔가 잘못되어 있지 않니? 에텔 이모가 이런 쪽으로 냄새를 잘 맡아서 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 7cd76d2d-ce9f-1f70-88f8-fc6c2b066eae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:7cd76d2d-ce9f-1f70-88f8-fc6c2b066eae
msgctxt "h02376081g95ecg4714gaba3g9274d6f5d059"
msgid ""
"Be careful on the road - I'd <i>hate</i> if something happened to you. Take "
"care, petal."
msgstr "조심히 다니려무나, 네가 다치면 <i>정말</i> 슬플 테니까 말이야. 항상 조심하렴, 아가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = 7d0b74f6-362c-d026-2887-4a592c0cb63c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ROGUE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:7d0b74f6-362c-d026-2887-4a592c0cb63c
msgctxt "h955ec77eg2a15g49d5ga6e0g3179db7a4bf8"
msgid "This is an expertly made healing potion. Nicely done."
msgstr "이건 매우 뛰어난 솜씨로 만든 치유 물약이네요. 품질이 아주 좋아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 7d6df6ae-d9c2-4b3b-acca-b499ca3885f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:7d6df6ae-d9c2-4b3b-acca-b499ca3885f8
msgctxt "h322c0a4egd5eag4b7cgaf1dgce7e6ae4940e"
msgid "Like one of those Red Wizard lich-lickers? <i>Please.</i>"
msgstr "리치 똥구멍이나 빠는 레드 위저드들 말이니? <i>아, 제발.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 7df2074a-5d72-a113-ef78-ce50b9890c90
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:7df2074a-5d72-a113-ef78-ce50b9890c90
msgctxt "he791f2c8gd547g4722gbe8dg20787b6c0c44"
msgid "Oh? Whatever do you mean, petal?"
msgstr "오? 무슨 의미니, 아가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 7fd68677-f785-6683-153d-8db0ea0869c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:7fd68677-f785-6683-153d-8db0ea0869c9
msgctxt "h67680315g85b9g4d71ga85bgbf2b93c8b921"
msgid ""
"Still, you're looking a little <i>pasty</i>, love. I've just the thing to "
"perk you up."
msgstr "그래도, 좀 <i>창백한</i> 것 같구나 아이야. 네게 딱 맞는 게 있단다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = 8027c7fb-230c-49ef-ab72-d9ea526a5c01
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:8027c7fb-230c-49ef-ab72-d9ea526a5c01
msgctxt "h80bcddcegbec7g4b13g9b6dgc74a9376ce8a"
msgid "Thank you - for being nice to me."
msgstr "절 잘 대해주셔셔 감사합니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Karlach
#. NodeID = 81d7e875-f371-983d-f563-35a1bf6bf472
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_KARLACH(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:81d7e875-f371-983d-f563-35a1bf6bf472
msgctxt "h747985f2ga835g4d07g8689g5662c61ea797"
msgid ""
"I hardly think a mad old woman's <i>lotions and potions</i> are going to "
"cure us. We should keep moving."
msgstr "정신나간 할멈의 <i>로션과 포션이</i> 우릴 치유해줄 것 같진 않군. 다른 방법을 찾자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 83b9f32b-c96c-96bf-2153-da292894190b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_HagTrader_State_AgreeMeetTeahouse(1) = True
#.   Quest:
#.     - GLO_Tadpole_SUB_Hag.ToldEthelAboutTadpoleInGrove(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:83b9f32b-c96c-96bf-2153-da292894190b
msgctxt "h18b50c16g7460g4a08g8621g10afd00a9662"
msgid ""
"Let me mark it on your map. I'll be heading back soon, so I can meet you "
"there."
msgstr "네 지도에 표시를 해주마. 할멈은 곧 집으로 떠날 거야, 거기서 만나자꾸나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 84846f13-812e-1b88-5b98-f4300bc9f1bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:84846f13-812e-1b88-5b98-f4300bc9f1bf
msgctxt "h877bcd85gcd79g4bc1ga261g1a59387880bc"
msgid ""
"Bracelets that hold the power of ten men, mirrors that capture the soul..."
msgstr "장정 열 명의 힘을 낼 수 있는 팔찌, 영혼을 붙잡을 수 있는 거울..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = 84c68a8c-7a4b-a388-ad34-f11555a562f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:84c68a8c-7a4b-a388-ad34-f11555a562f5
msgctxt "h170b7444g3f9ag4eecg86d5g33452481e6aa"
msgid "<i>Drink the potion.</i>"
msgstr "<i>물약을 마신다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = 854eaad3-0229-b66e-561d-3bfbf852d61e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:854eaad3-0229-b66e-561d-3bfbf852d61e
msgctxt "h51214c4dgb33eg48d3g8e6agbd0aaaf706d7"
msgid "Do you think I asked for this?"
msgstr "내가 이런 걸 원했다고 생각하나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = 86baefb1-9ee7-3a24-342b-1931c7d6cf68
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:86baefb1-9ee7-3a24-342b-1931c7d6cf68
msgctxt "hce965a4fg8bbcg4cdcg926eg15286ababcf7"
msgid "<i>Let her fuss over you. </i>"
msgstr "<i>당신을 두고 호들갑을 떨도록 내버려 둔다. </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = 86cd94aa-e238-7b66-e985-6c2a8cd2b4e1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:86cd94aa-e238-7b66-e985-6c2a8cd2b4e1
msgctxt "hbd646dabg9eb0g4605g8ef2g64e2c538f587"
msgid "That is a gracious offer, but I need an expert's help."
msgstr "제안은 고맙지만, 전 전문가의 도움이 필요해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = 898b0e0d-5a9c-43c2-9850-b08d744fece3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:898b0e0d-5a9c-43c2-9850-b08d744fece3
msgctxt "h9f9d0359gb07ag476fg9cecg7295ed309b7b"
msgid "And what is this, exactly?"
msgstr "그래서 이게 정확히 뭔가요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 8ae7a32b-f438-2c65-9a36-33d8481cb286
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:8ae7a32b-f438-2c65-9a36-33d8481cb286
msgctxt "h7100d8bdg62c4g456cg9766g6e15561d5680"
msgid "<i>Good. </i>That's how it should be."
msgstr "<i>좋구나.</i> 그렇게 되는 게 맞지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = 8bb0789a-0f17-6b46-b567-4d43c934063d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:8bb0789a-0f17-6b46-b567-4d43c934063d
msgctxt "h89fb7745g03a1g46beg8a56g0d4cb954118f"
msgid "That's precious little use to me, is it?"
msgstr "제게 그렇게 쓸모 있을 것 같지 않은데, 그렇죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 8dda19d6-ef70-e1be-988f-25910f395bb6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:8dda19d6-ef70-e1be-988f-25910f395bb6
msgctxt "h24f10d43g88b9g403dg8c9cgab2aeddb649e"
msgid "Auntie Ethel will sort you out. I've lotions and potions galore!"
msgstr "에텔 이모가 도와주마. 내겐 로션과 포션이 아주 많단다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 8e1e9cfc-9ca1-7c7b-a6c8-d3c2859c8e08
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:8e1e9cfc-9ca1-7c7b-a6c8-d3c2859c8e08
msgctxt "hb2f543aeg9befg4921g860cgca797ca4af73"
msgid "My point is - whatever ails you... I promise I've seen worse."
msgstr "내 말은, 네게 어떤 문제가 있든 간에... 더 심한 것도 많이 봐왔단다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 8e5ab505-5082-1580-e455-d20214519d9e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:8e5ab505-5082-1580-e455-d20214519d9e
msgctxt "h6865d683gcda0g4209g96f7g2d41d2032b8c"
msgid "I've ne'er a potion or lotion here that could do it, but..."
msgstr "여기 있는 로션과 포션으론 해결할 수 없겠지만..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 8f569e9a-fa30-897d-5f52-04a32c589108
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:8f569e9a-fa30-897d-5f52-04a32c589108
msgctxt "hb0ec5aa6gbc51g45e5g882cg4b66e8a7ea05"
msgid "Stop by my place, petal. It'll be worth your while - I promise."
msgstr "우리 집에 한번 들리려무나, 아가야. 네게 도움이 될 거야, 약속해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = 90676c12-8634-af79-29ea-62849f0b7eac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:90676c12-8634-af79-29ea-62849f0b7eac
msgctxt "hf7b9000agb0d7g4170g9ef9g2eb289209b9c"
msgid "A mind flayer parasite infected me."
msgstr "마인드 플레이어 기생충이 절 감염시켰어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 948bea6b-e6e2-138d-ebde-a76e9aa2b624
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_HagTrader_Event_TakePotion(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:948bea6b-e6e2-138d-ebde-a76e9aa2b624
msgctxt "h021df518g4f82g44f3ga56bgb72382b6420a"
msgid "Oh, 'tis just a healing potion. Nothing fancy! Here."
msgstr "오, 그저 평범한 치유 물약이란다. 특별한 건 아니야! 자, 받으렴."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 96aae30e-2202-4aab-d8c5-c7233c3c105c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_HagTrader_State_AgreeMeetTeahouse(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:96aae30e-2202-4aab-d8c5-c7233c3c105c
msgctxt "h8e915ec3g2d60g4d49gb535gedd3a30ce50a"
msgid "Nae bother, love. Come back any time!"
msgstr "신경 쓰지 마렴, 아이야. 언제든 다시 들리렴!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = 97a7065e-6c40-1f18-e3d2-a2752ee944f3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:97a7065e-6c40-1f18-e3d2-a2752ee944f3
msgctxt "heb515005g11b2g4c65g8138g44aa8e3aa2b5"
msgid "This is beyond the skills of a backwater herb peddler."
msgstr "이건 촌구석 약초 행상인이 해결할 수 있는 일이 아닙니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 998a7406-2d3c-49eb-06bc-46c146af06e7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Hag_Knows_Teahouse = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:998a7406-2d3c-49eb-06bc-46c146af06e7
msgctxt "hea7ccd85g1109g4e00g8475g13e2fd2a6a88"
msgid "I've collected some... interesting bits 'n bobs over the years."
msgstr "난 지난 몇 년간... 꽤나 흥미로운 물건들을 모아 왔단다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 9a01db3a-beeb-5f0d-5638-f96cd8fad331
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Hag_Knows_ToldHagTadpole = True
#. SetFlags:
#.   Quest:
#.     - GLO_Tadpole_SUB_Hag.ToldEthelAboutTadpoleInGrove(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:9a01db3a-beeb-5f0d-5638-f96cd8fad331
msgctxt "hc8f74c76g139fg4305ga147g9c2c1addc7f3"
msgid ""
"But enough nattering. I'll be heading home shortly. Here. Let me mark it on "
"your map."
msgstr "그럼 수다는 이만 줄이자꾸나. 곧 집으로 떠날 거야. 자, 여기. 네 지도에 표시해 주마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = 9a5db56b-9503-0b4b-d024-fda12c79492f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:9a5db56b-9503-0b4b-d024-fda12c79492f
msgctxt "h510f68a3g291dg4703g8e49g3306531dd16a"
msgid "I don't know... I just don't know."
msgstr "모르겠어요... 그냥 모르겠어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 9a68119b-4f0f-c52d-bb4b-8f939616155c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:9a68119b-4f0f-c52d-bb4b-8f939616155c
msgctxt "h130f1e4egd933g4edega715g87a0f7b0ffc8"
msgid "Devilishly charming, you mean? Hah!"
msgstr "데빌스러운 매력이 있다, 이 말이지? 하!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 9c67f98f-7613-19b7-5678-941a9e030823
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:9c67f98f-7613-19b7-5678-941a9e030823
msgctxt "h308efcc7g8142g456fga9b4ga3154b5b328d"
msgid "Well, why would you bloody not!"
msgstr "글쎄, 안 그럴 이유는 또 뭐람!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 9cc1e7be-e5ce-b845-82a5-a0d346326efb
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_HagTrader_State_GavePotion = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:9cc1e7be-e5ce-b845-82a5-a0d346326efb
msgctxt "h962ecbf5gf17fg45cdg9507ge9d295464410"
msgid "Aha!"
msgstr "아하!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = 9f4bf0f8-cd4e-0efe-88b1-9814dadb164a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:9f4bf0f8-cd4e-0efe-88b1-9814dadb164a
msgctxt "hf229aa28ge9bcg43b5ga03agb8f4a3b5b6c2"
msgid "How did you know?"
msgstr "어떻게 아셨죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = 9f6a5c9c-bd05-ff77-cd65-4c4a83b43526
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:9f6a5c9c-bd05-ff77-cd65-4c4a83b43526
msgctxt "h21e9b85ag4e1eg4a10gb7a6gf27cdf567563"
msgid "You just look like you might need a pick-me-up."
msgstr "기분 전환이 필요해 보이는 표정이구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = a1c49d10-213f-ea50-4c43-0876044c22b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:a1c49d10-213f-ea50-4c43-0876044c22b4
msgctxt "h8d7593f9gcb33g4194g8a72gc1a66fdbf799"
msgid ""
"If I was back I'd my teahouse, I'd make you a cuppa and tell you to put your "
"feet up. Alas, here I can only tell you to be <i>kind</i> to yourself, petal."
msgstr ""
"이모가 찻집에 돌아가면, 차 한 잔 하면서 다리 쭉 뻗고 쉬게 해줄 텐데. 아이고, 여기서 해줄 수 있는 건 스스로를 <i>소중히</i> "
"여기라는 말뿐이구나, 얘야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = a2674e72-0666-3901-fe2d-12b4339acf23
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:a2674e72-0666-3901-fe2d-12b4339acf23
msgctxt "h10aa2578gf19bg41d3ga01cg3286e56e7587"
msgid "I must say, though - you're looking <i>mighty</i> peaky."
msgstr "분명 이렇게 말하려고 했을 거야, 네가 <i>몹시</i> 피곤해 보인다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = a29cff2a-ffce-fcfc-0d82-7d8f69d6ca36
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 38f4e42c-6cb2-b146-4b6f-f36ebcf71b62_ToldHagAboutUrges = True
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:a29cff2a-ffce-fcfc-0d82-7d8f69d6ca36
msgctxt "h1f03ea5cg7023g4e1dgb7c5gcfaea49db237"
msgid ""
"But I confess, that doesn't explain all your symptoms. Some of the things "
"you told me, why, I've never heard of a parasite doing that! This is "
"<i>serious.</i>"
msgstr ""
"하지만 내가 솔직하게 말하건대, 그게 네 증상을 전부 설명해주진 않는구나. 네가 말해준 것들, 그런 일을 하는 기생충은 들어본 적 없어! "
"이건 <i>심각하단다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = a333931f-1b38-c1d8-5533-f9638bd0c154
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:a333931f-1b38-c1d8-5533-f9638bd0c154
msgctxt "h67f0e75dgd80fg4ccagb170gaf56e03010ee"
msgid ""
"Shhh, it's all right - all you need is a bitta loving care, don't you think?"
msgstr "쉬잇, 괜찮단다. 네게 필요한 건 약간의 애정 어린 보살핌이란다, 그렇지 않니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Wyll
#. NodeID = a33eeb15-d390-2395-bd23-b3bb80db084d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_WYLL(6) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:a33eeb15-d390-2395-bd23-b3bb80db084d
msgctxt "h99cd3901gaa47g4ac1gb8cfgfdf0e0dfe54f"
msgid "Tell her. But if she pulls out a pot of oil, run!"
msgstr "한번 말해 주자고. 하지만 기름 솥을 꺼내들면, 바로 도망치는 거야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = a4a183d9-90ea-98bd-8010-14a60bc1a1af
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:a4a183d9-90ea-98bd-8010-14a60bc1a1af
msgctxt "hb7a709fbg2e16g4380gb90cg0652b14e64de"
msgid "Such as?"
msgstr "예를 들면?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = a5a91a67-441f-8231-2cec-3094d041e6f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:a5a91a67-441f-8231-2cec-3094d041e6f3
msgctxt "hfce497f0g3c0ag42dbg84cfgb452ada4d0d2"
msgid ""
"All I know is that right now, I'm imagining drowning you in the boiling stew "
"over there."
msgstr "제가 지금 아는 건, 저기 끓고 있는 스튜 속에 당신을 익사시키는 상상을 하고 있다는 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = a5b24d74-0a33-1249-0360-960ffb0a0f3b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:a5b24d74-0a33-1249-0360-960ffb0a0f3b
msgctxt "h7c4ecfc9ga0c7g4bfegac35ga232819ddd7a"
msgid ""
"But worry not! I fixed him up and, depending on the lighting, he looks good "
"as new!"
msgstr "하지만 걱정 그만! 이 할멈이 싹 고쳐놨지. 어떻게 빛을 잘 받는 각도에서 보면, 아주 새것처럼 멀쩡하단다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = a6058de8-2d18-2c5a-14c0-3fc4d462e881
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:a6058de8-2d18-2c5a-14c0-3fc4d462e881
msgctxt "h8045ff31gaba4g4da4g89a4g6038437c84fb"
msgid "See you around, petal."
msgstr "다시 만나자꾸나, 꽃잎아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = a61bfe7a-9a56-c536-5e45-d171f02aaef0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:a61bfe7a-9a56-c536-5e45-d171f02aaef0
msgctxt "h6274356dg743dg4af4gb6cdg03dee46a0698"
msgid "Sorry, love. I just lose the run of myself sometimes."
msgstr "미안하다, 아이야. 가끔 내가 무슨 말을 하고 있었는지 까먹곤 한단다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = a80b2c6a-72a0-cd0c-c808-9e29f502a3a8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_HagTrader_Event_StoleFromHag(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:a80b2c6a-72a0-cd0c-c808-9e29f502a3a8
msgctxt "hd2b0da1ag8eb5g4503g9d56ga0500a95010b"
msgid ""
"Oh, and those potions you swiped from me? Keep them - call it a gift from "
"your Auntie Ethel."
msgstr "오, 그리고 네가 슬쩍한 그 물약들? 그냥 가지려무나, 에텔 이모가 주는 선물이라고 생각하렴."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = aa21b137-f5ab-57ed-6116-f805939b1703
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:aa21b137-f5ab-57ed-6116-f805939b1703
msgctxt "h7a72fcd8g7aa4g4b65gbcd2g7220c1d94920"
msgid ""
"Oh, you're a saucy little spitfire, aren't you? Good. I like 'em that way."
msgstr "오, 아주 성격이 드세구나, 그렇지 않니? 좋아. 난 그런 면도 좋단다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = aa6c2810-eec9-fb14-bb74-5921dea5ba14
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:aa6c2810-eec9-fb14-bb74-5921dea5ba14
msgctxt "hbbeb4512gc9dfg4792gba72g205f50133a4d"
msgid "I'm tired, that's all. It's been a long day."
msgstr "그저 피곤할 뿐이에요. 하루가 아주 길었거든요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = ac75ee19-fc63-81ae-b063-6d01669d969e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:ac75ee19-fc63-81ae-b063-6d01669d969e
msgctxt "haf0f5defg6c32g40d6gaf29gb66091e3876f"
msgid ""
"Drop by for a visit, and I'll have a pot brewing. We can chat over a cuppa "
"while I sort you out."
msgstr "한번 들리려무나, 한솥 끓이고 있을 테니. 널 고쳐주는 동안 차나 한잔하자꾸나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = ae2d5d36-736b-3a33-c3aa-22ea072919f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:ae2d5d36-736b-3a33-c3aa-22ea072919f0
msgctxt "ha78db15bg9d8fg4eeegb330g720cbf7376b7"
msgid ""
"Fey? I hope you're not calling me a dryad or, bless us and save us, one of "
"those Eladrin - flightly buggers."
msgstr "페이라고? 날 드라이어드나, 세상에, 엘라드린 같은 더러운 자식들로 오해한 게 아니었으면 하구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = afd0eba8-4791-f461-332e-57edb346e993
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:afd0eba8-4791-f461-332e-57edb346e993
msgctxt "hae223ca4gd1edg40ebg8310g842f5df36ef1"
msgid ""
"Ach, there's nothing like a pain in the noggin to addle you. You need to "
"look after that head of yours."
msgstr "어휴, 두통만큼 골머리를 썩히는 것도 없지. 네 머리를 돌볼 필요가 있겠구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = b0b9b163-9d6c-ed6c-9d12-1b5192d7321a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:b0b9b163-9d6c-ed6c-9d12-1b5192d7321a
msgctxt "h1674bb3dgf418g4b6ag8997g8018de902199"
msgid ""
"I know githyanki make a habit of paranoia, but 'tis just a healing potion."
msgstr "기스양키들이 편집증이 심하다는 건 알고 있지만, 이건 그냥 평범한 치유 물약일 뿐이란다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = b39fb110-aa3e-8a09-c20c-18596682117a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:b39fb110-aa3e-8a09-c20c-18596682117a
msgctxt "h252672eag4229g402cgb776g1a18eb00cc80"
msgid "Ah, don't be grumpy, petal. I only want to help."
msgstr "아, 심술부리지 말렴, 꽃잎아. 그냥 돕고 싶은 것뿐이란다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = b65a607f-de92-94ed-f51b-f2b5e29827c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:b65a607f-de92-94ed-f51b-f2b5e29827c9
msgctxt "hd1e837a4gf39eg47f8gbd26gdf3631593145"
msgid "But something smells off, petal. Something is wrong, isn't it?"
msgstr "하지만 뭔가 이상한 낌새가 느껴지는구나, 꽃잎아. 뭔가 잘못된 거지, 그렇지 않니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = bb8b0f07-5f30-231c-e918-c6123b5a8fe3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_HagTrader_Event_DrinkPotion(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:bb8b0f07-5f30-231c-e918-c6123b5a8fe3
msgctxt "h4f011a92gf00cg464egb1cbg643179e0e365"
msgid "Hmmm. I swear, you're still as <i>peaky</i> looking."
msgstr "흐음. 장담하는데, 아직도 <i>안색</i>이 좋지 않구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = bf01dcb7-35ea-656e-4cdc-2a39662960cc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:bf01dcb7-35ea-656e-4cdc-2a39662960cc
msgctxt "h6df96be9g23ebg4de4ga339gfa811511c2a8"
msgid ""
"Hah! I was quite the wild thing back in the day, but I'm afraid that's long "
"past."
msgstr "하! 나도 예전엔 아주 야생적이었지만, 그건 이제 오래전의 일이란다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = bf9c81c0-ee11-f387-4e4f-a55603a7b241
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:bf9c81c0-ee11-f387-4e4f-a55603a7b241
msgctxt "h11c85dc6gb773g45c6gbd4fg0846fa7c768a"
msgid "Well that depends. What's wrong, lovie?"
msgstr "글쎄, 그건 상황에 따라 다르지. 뭐가 문제니, 얘야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Narrator
#. NodeID = bfb28af5-cef0-44cf-d578-34d312160579
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Hag_Knows_ToldHagTadpole = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:bfb28af5-cef0-44cf-d578-34d312160579
msgctxt "hc7daa7e2gfbfag4a09ga7f1gc01805937446"
msgid ""
"*As you recount your adventure, Auntie Ethel nods along - her eyes wide.*"
msgstr "*당신의 여정을 설명해 주자, 에텔 이모는 고개를 끄덕이며 눈은 점점 커집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = c42fc331-871b-3238-cb50-d5dd563d85fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:c42fc331-871b-3238-cb50-d5dd563d85fe
msgctxt "h9c99dac1g15cfg4afeg8388gdb28bd7dfdc9"
msgid "Oh, I've seen it all!"
msgstr "오, 더한 것도 봤단다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = c584d1e2-69d2-e28f-4ee8-3a8bffaa7525
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:c584d1e2-69d2-e28f-4ee8-3a8bffaa7525
msgctxt "h6cf36a94g5c24g424ag893bg29d2e4b7ad7e"
msgid ""
"Oh, stop with the sweet talk. Here. Take the end of the batch. Just in case."
msgstr "오, 설탕 발린 말은 그만하거라. 여기. 마지막 남은 것 가져가렴. 혹시 모르니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = c6a19225-8a27-783c-e6d6-e285e2c86f80
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SORCERER_DRACONIC(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:c6a19225-8a27-783c-e6d6-e285e2c86f80
msgctxt "hc7c1c461g566fg4e83g9624g267efed6633d"
msgid ""
"Ohhh, someone's confident, aren't they? Be careful, sweetie. How's that "
"saying go..."
msgstr "오오, 아주 자신감이 넘치는구나, 그렇지 않니? 조심하렴, 얘야. 그런 말이 있지..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = c7330f0f-041f-bd85-72dc-c9adb3117c1f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:c7330f0f-041f-bd85-72dc-c9adb3117c1f
msgctxt "h247ab5e9g967cg4878g97a7gef39b38c4931"
msgid "You <i>poor </i>pet. My heart goes out to you, truly."
msgstr "이런 <i>불쌍한 </i>강아지 녀석. 가슴이 아프구나, 진심으로 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = c7517209-9553-de1f-e6ae-a6113b3a86fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:c7517209-9553-de1f-e6ae-a6113b3a86fc
msgctxt "h445ed287g2c9ag411fga599gd3aa53722907"
msgid "Not at all! Wouldn't have the patience for all that magical drama."
msgstr "전혀 아니란다! 그런 마법 같은 이야기를 참을 인내심은 없단다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = c78751c9-a844-c3e7-af43-d3665edbb661
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:c78751c9-a844-c3e7-af43-d3665edbb661
msgctxt "h58a4bed2g967ag442cgb683ge92244784e44"
msgid "I once had a fella who'd been caught dabbling with a dryad."
msgstr "한번은 드라이어드와 놀아나다가 잡힌 녀석이 있었단다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = cb427e6c-ac54-3ff5-3b14-6e5c9095340a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SORCERER(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:cb427e6c-ac54-3ff5-3b14-6e5c9095340a
msgctxt "h854bcd77g8364g4b59gb3fdgf30ef07574fe"
msgid "There is a touch of the wilds about you."
msgstr "네게 야생의 느낌이 풍기는구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = cb49879e-3551-5124-0b20-ae7e40ed19fe
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_HagTrader_State_AgreeMeetTeahouse(1) = True
#.   Quest:
#.     - GLO_Tadpole_SUB_Hag.ToldEthelAboutTadpoleInGrove(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:cb49879e-3551-5124-0b20-ae7e40ed19fe
msgctxt "h1fc2311bg8c62g43d5g9a90g79d5820e2687"
msgid ""
"I'll be heading home soon. Here. Let me mark it on your map - just in case."
msgstr "난 곧 집으로 향할 거란다. 여기. 네 지도에 표시해 주마, 혹시 모르니 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = cb641543-4151-24b6-0155-eb3e148159db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:cb641543-4151-24b6-0155-eb3e148159db
msgctxt "h6a140e1fged1fg43c2gb3bcgcaeeac066e29"
msgid "There's nothing wrong, I swear. Everything's fine."
msgstr "문제는 전혀 없어요, 장담하죠. 다 괜찮아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = cb7bc9e6-2b4c-8c46-7541-10bd63f24640
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:cb7bc9e6-2b4c-8c46-7541-10bd63f24640
msgctxt "h6f946568g4aebg4b4cgbad2gdba9a23dc0d5"
msgid ""
"Oh, you cheeky pup! That might scare someone else, but I know what naughty "
"boys need - a bitta love and care."
msgstr ""
"오, 이 건방진 녀석! 다른 사람이라면 겁먹게 했을 수도 있겠지만, 나는 버릇없는 소년들이 뭘 필요로 하는지 안단다. 바로 약간의 사랑과 "
"보살핌이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = cb7bc9e6-2b4c-8c46-7541-10bd63f24640
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:cb7bc9e6-2b4c-8c46-7541-10bd63f24640
msgctxt "h074a6e0agdf44g42a4g998ag8106c9c2db26"
msgid ""
"Oh, you cheeky pup! That might scare someone else, but I know what naughty "
"girls need - a bitta love and care."
msgstr ""
"오, 이 건방진 녀석! 다른 사람이라면 겁먹게 했을 수도 있겠지만, 나는 버릇없는 소녀들이 뭘 필요로 하는지 안단다. 바로 약간의 사랑과 "
"보살핌이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = cb7bc9e6-2b4c-8c46-7541-10bd63f24640
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:cb7bc9e6-2b4c-8c46-7541-10bd63f24640
msgctxt "hc08dafd2g0ac9g44ccg8d19g8b56ef8c3873"
msgid ""
"Oh, you cheeky pup! That might scare someone else, but I know what naughty "
"kids need - a bitta love and care."
msgstr ""
"오, 이 건방진 녀석! 다른 사람이라면 겁먹게 했을 수도 있겠지만, 나는 버릇없는 아이들이 뭘 필요로 하는지 안단다. 바로 약간의 사랑과 "
"보살핌이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = cc6db4fc-a1e3-90b0-641d-2972a7acbd1d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:cc6db4fc-a1e3-90b0-641d-2972a7acbd1d
msgctxt "h279633deg3a9bg44d1ga05dgab51db9a06f0"
msgid "Oh, nothing as fancy as that!"
msgstr "오, 그렇게 멋진 사람은 아니란다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = d07c910a-bd73-30a1-4ad7-d46c30c0cde3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:d07c910a-bd73-30a1-4ad7-d46c30c0cde3
msgctxt "heefdfc76g1221g4f64ga07fgabbe72a7f787"
msgid "Nothing for now."
msgstr "지금은 없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = d1662baf-60a7-90b5-ecb5-17c5f3a8b685
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:d1662baf-60a7-90b5-ecb5-17c5f3a8b685
msgctxt "h02a2a8c3g890ag4b80g91cfg23b7017177c8"
msgid "That's no concern of yours."
msgstr "그건 당신이 신경 쓸게 아니에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = d1c6cca0-9e0c-fc53-d1c7-59b10c028108
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:d1c6cca0-9e0c-fc53-d1c7-59b10c028108
msgctxt "h35fe1c34gda7bg4646g8fd7gfc9afcde3939"
msgid "What is it, petal? What's wrong?"
msgstr "무슨 일이니, 꽃잎아? 무슨 문제가 있는 거니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = d32f85f6-836d-8323-e33c-efbddc234ed7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:d32f85f6-836d-8323-e33c-efbddc234ed7
msgctxt "h7e87be23g7f0cg41d6gb98egde3d98ba1565"
msgid "As you wish petal!"
msgstr "네 마음대로 하렴 얘야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = d3383c22-3ed7-85fc-07ba-c89603c07351
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_HagTrader_State_AgreeMeetTeahouse(1) = True
#.   Quest:
#.     - GLO_Tadpole_SUB_Hag.ToldEthelAboutTadpoleInGrove(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:d3383c22-3ed7-85fc-07ba-c89603c07351
msgctxt "h2a650319g57f0g4083ga740gc2922c95a588"
msgid ""
"Why don't you come see for yourself? My home ain't far and I'll be there "
"sharpish. Here. I'll mark it on your map."
msgstr "네가 직접 와서 보는 건 어떻니? 내 집이 멀지 않은 곳에 있단다. 나도 곧 그리로 갈 거야. 여기. 네 지도에 표시해 주마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = d51ce6b0-178e-b8a2-be0d-16c5888614ea
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_HagTrader_Event_StoleFromHag(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:d51ce6b0-178e-b8a2-be0d-16c5888614ea
msgctxt "hbc850179g1de8g41b2g856bgbfbf47ecabdb"
msgid ""
"One condition though - you swipe anything in my home? You'll lose a "
"<i>finger</i>. Don't think I didn't notice."
msgstr ""
"한 가지 조건이 있단다. 내 집에 있는 물건에 손댈 생각은 하지 말거라? 네 손가락을 잃게 될 테니까. 내가 모를꺼라고 생각하지 말렴."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = d65270e0-ab80-b527-e824-56e39f849b4d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:d65270e0-ab80-b527-e824-56e39f849b4d
msgctxt "h94d697d6gc02eg4ca1gb607g9a43201a5540"
msgid ""
"While I've done some mad things, I've never fooled around with a dragon. "
"Well, not yet anyway."
msgstr "내가 미친 짓은 많이 해봤지만, 드래곤과 놀아나 본 적은 없단다. 아직은 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = d69dd50c-79c9-78bd-9be6-f84ded72e85c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:d69dd50c-79c9-78bd-9be6-f84ded72e85c
msgctxt "h1bbd3544g06cdg4fb3ga206g13149c04bf6b"
msgid "I'm fine. Just bone-weary after a difficult day."
msgstr "괜찮아요. 그냥 좀 힘든 하루를 보내서 힘들 뿐이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = d8c836b2-7331-4723-2490-d06f71e52b29
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:d8c836b2-7331-4723-2490-d06f71e52b29
msgctxt "h7f6eac9bgf59eg4d31gae0fg969275735c12"
msgid "You'll have to stop by my house - just at the edge of the forest!"
msgstr "내 집에 한번 들르렴, 숲 끝자락에 있단다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = d9eca4c8-8f54-4a99-bbe9-68dce9522cdd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:d9eca4c8-8f54-4a99-bbe9-68dce9522cdd
msgctxt "hb942dde0gcef3g4b64g924ag3dfa97555aa8"
msgid ""
"The wife was none too pleased and introduced him to a pot of boiling oil."
msgstr "아내가 화가 나서 그에게 끓는 기름을 부어버렸지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = da4bbcbc-24b2-bc4c-3bc8-2e67b8e6ce93
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:da4bbcbc-24b2-bc4c-3bc8-2e67b8e6ce93
msgctxt "h250f6612ge1abg4f58g8c20g9a0fbbfdab87"
msgid ""
"Sometimes I think terrible things. Really, really, really terrible things."
msgstr "때때로 전 끔찍한 생각을 해요. 정말, 정말, 정말, 정말 끔찍한 생각이요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = da71e60d-ba56-96ef-a0a7-3229a8a6912a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:da71e60d-ba56-96ef-a0a7-3229a8a6912a
msgctxt "hdbb90119g1fc6g4fd6gbfe3g0bea96ad9a5c"
msgid "Nothing for now."
msgstr "지금은 없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = dcffa73b-fdfd-599c-95c1-fdb89f3662ba
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:dcffa73b-fdfd-599c-95c1-fdb89f3662ba
msgctxt "ha487d461g813cg43ddgadadgc8aeb08f3e54"
msgid "Does anyone fall for this innocent old lady act?"
msgstr "여기 순진한 할머니 연기에 넘아간 사람 있어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = de928f6c-bdc0-4e98-3e1d-79eb7dfb8e53
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:de928f6c-bdc0-4e98-3e1d-79eb7dfb8e53
msgctxt "h70f793feg0ca4g4a14g8f73g752c512ac1c1"
msgid ""
"Oh, stop. Even on a good day, half the camp acts like a bunch of screaming "
"brats."
msgstr "오, 그만하렴. 상태가 좋을때조차, 이 야영지 사람들 중 절반은 소리나 지르는 애들처럼 행동한단다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = df984910-4280-a6ba-69b8-fc2237ac0ba3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_HagTrader_Event_TakePotion(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:df984910-4280-a6ba-69b8-fc2237ac0ba3
msgctxt "hb58a50b8gb481g4de9g8d29gc5374250956a"
msgid "Might this concoction also help with something more... serious?"
msgstr "이 약이 좀... 심각한 상황에도 도움이 될까요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Astarion
#. NodeID = e00ee2e2-5ebe-a591-d607-f31f8131b900
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:e00ee2e2-5ebe-a591-d607-f31f8131b900
msgctxt "ha0852829gb505g46eagbd73ga3c5989910b2"
msgid "I love it! Let's tell her everything."
msgstr "완벽해! 그녀에게 다 말해버리자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = e050973e-fdb9-b091-38aa-77dadcadf9d1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:e050973e-fdb9-b091-38aa-77dadcadf9d1
msgctxt "hef01a262g15a6g4489gbcc0g4156320bbae0"
msgid ""
"I'm sorry to go on about it, but are you all right? You're looking awful "
"peaky."
msgstr "다시 물어서 미안하다만, 정말 괜찮은 거니? 안색이 정말 창백하구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = e30f05a1-8121-0cd0-0e55-d47e0a0a7a91
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 38f4e42c-6cb2-b146-4b6f-f36ebcf71b62_ToldHagAboutUrges = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:e30f05a1-8121-0cd0-0e55-d47e0a0a7a91
msgctxt "h62e73624g97b8g4c8agb9d9gaaa414ae3028"
msgid ""
"Then let old Auntie Ethel have a look at you. First things first - tell me "
"what's at you."
msgstr "그럼 이 늙은 에텔 이모가 널 살펴보게 해주렴. 우선, 무엇이 널 괴롭히고 있는지 말해봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = e3440b68-4f18-3fbe-901e-602a20d89f13
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:e3440b68-4f18-3fbe-901e-602a20d89f13
msgctxt "h28bb9cacgabf4g445agb974gaa4cd0340214"
msgid "You take a sup of that and you'll feel right as rain, sweetie."
msgstr "이거 한 모금만 마시면 말짱하게 나을 거란다, 얘야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = e48e4a56-509c-cc2e-ea37-f7b9c570e8ae
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - NIGHT_FirstNightContemplation = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:e48e4a56-509c-cc2e-ea37-f7b9c570e8ae
msgctxt "h0d69cd19g2f98g4385gb017g030ca9720c24"
msgid "I never sleep. Every night, I endure hours of slaughter in my dreams."
msgstr "잠이 오지 않아요. 매일 밤, 꿈에서 몇 시간 동안이나 살육의 시간을 견뎌야 해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = e518e7be-0b81-5098-7f6b-eeed4d49bbe0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:e518e7be-0b81-5098-7f6b-eeed4d49bbe0
msgctxt "hef0b0828g61fcg4bdeg9c26g096685916c56"
msgid "But I come from a long line of women with a dab hand at such things."
msgstr "하지만 난 그런 일에 능숙한 여성 집안에서 태어나 자랐단다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = e60c69cb-0425-4d0c-a0c4-056f89a1b915
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:e60c69cb-0425-4d0c-a0c4-056f89a1b915
msgctxt "h035769ebg03cdg4156g9ab5geab9ae7d5771"
msgid "... the bigger they act, the bigger the whack?"
msgstr "... 쎈 척 하는 놈일수록 더 쎄게 얻어맞는 법이지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = e70b908d-dff2-65b9-ff06-dd8b73525564
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:e70b908d-dff2-65b9-ff06-dd8b73525564
msgctxt "hafcec457gab43g40c8ga2d2g56027452ed9a"
msgid ""
"Not that they'd listen to little old me. Anyway! Do you need anything? I "
"have a few odds and ends for sale."
msgstr "그런다고 이 늙은이 말을 들어줄 사람은 없을 테지만 말이야! 뭔가 필요한 게 있니? 이것저것 쓸만한 게 많단다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = ec5d18d9-cfa0-52e5-9e86-19674f308c34
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:ec5d18d9-cfa0-52e5-9e86-19674f308c34
msgctxt "hbd1c0713ga273g4a0bg8d65g4c1bc303827c"
msgid ""
"And better blue than a wizard. Stuffy bastards spend more time <i>talking</"
"i> about magic than they do casting. You're worth double 'em, petal."
msgstr ""
"그리고 위저드보다는 덜 파랗지. 그 답답한 자식들은 주문을 시전하는 것보다 마법에 대해 <i>떠드는데</i> 더 많은 시간을 쓰지. 네가 "
"그들보다 두 배는 낫구나, 꽃잎아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = ed52e326-5bc7-0fcf-afe0-4b02ffc348e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:ed52e326-5bc7-0fcf-afe0-4b02ffc348e2
msgctxt "h33bf32d7g79b7g42abgaf4ag4ef4de060b4b"
msgid "I've got a mind flayer parasite in my head."
msgstr "제 머릿속에 마인드 플레이어 기생충이 있어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = ef360e70-c5b9-0810-05e5-07eb311c2034
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - NIGHT_DarkUrge_ButlerIntro = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:ef360e70-c5b9-0810-05e5-07eb311c2034
msgctxt "h1cd4f2f6g7163g4884ga532g485b045d3faa"
msgid ""
"There's a depraved creature that tells me to do horrible deeds... I wonder "
"if he's a hallucination."
msgstr "제게 끔찍한 짓을 하라고 말하는 타락한 생명체가 있어요... 혹시 이것이 환각일까요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = f0a6311c-57ee-edac-e0fd-d69d5e700bcd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:f0a6311c-57ee-edac-e0fd-d69d5e700bcd
msgctxt "h98db8742g654fg4c01ga74ag419b401d3696"
msgid "Most folk won't be as understanding of your little... problem."
msgstr "대다수의 사람들은... 너의 그 사소한 문제를 이해하지 못할거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = f0fc420f-c244-90e7-2886-5a886ae8372c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:f0fc420f-c244-90e7-2886-5a886ae8372c
msgctxt "h863eda0bg19fag4c83gbcb5ga57454c9d5a9"
msgid "Ah, yes, but will your magic cure your ills or turn you blue?"
msgstr "아, 그렇구나. 그런데 네 마법이 네 병을 고칠까, 아니면 파랗게 질리게 할까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = f54b1caf-cff4-2343-0acb-49460f72b360
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Hag_Knows_ToldHagTadpole = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:f54b1caf-cff4-2343-0acb-49460f72b360
msgctxt "hb824b562g136fg4b89gabedg4abf71b9eb88"
msgid "I need help. I've been infected by a mind flayer parasite."
msgstr "도움이 필요해요. 마인드 플레이어 기생충에 감염됐어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = f6464a0a-a8fb-6ead-38e7-4e2db353a0cc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:f6464a0a-a8fb-6ead-38e7-4e2db353a0cc
msgctxt "hc5f995a0g75f1g4288ga9fbg405ed44b3cc5"
msgid "I'd best get back to it, but you take care now, petal."
msgstr "이만 가봐야겠구나. 하지만 이제부턴 몸 조심하렴, 꽃잎아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = f94f4516-469d-9c30-a213-a7b364eb9ad3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:f94f4516-469d-9c30-a213-a7b364eb9ad3
msgctxt "hec7408e2gab2eg4e09g9e9egb7240acad570"
msgid "What harm? Show me your wares."
msgstr "본다고 나쁠 건 없겠죠. 뭘 파는지 보여줘요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = f9a88dcc-a557-e664-f9a4-a5e7e9e3c19f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:f9a88dcc-a557-e664-f9a4-a5e7e9e3c19f
msgctxt "h175acd9fgfc17g42fbgaaaag8bad4c98b051"
msgid "There's no need. I'm fine, really."
msgstr "그럴 필요 없어요. 전 괜찮아요, 정말요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = f9c9ca7e-1469-2b70-8fbb-977877bc5e80
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SORCERER_WILDMAGIC(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:f9c9ca7e-1469-2b70-8fbb-977877bc5e80
msgctxt "hf7788d0dg81d4g4da2g96c2g642be2577434"
msgid "Have you ever accidentally blown something up?"
msgstr "실수로 무언가를 날려버린 적이 있나요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = fa58e5da-97a3-6b26-5c2d-ad438ea2eea9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:fa58e5da-97a3-6b26-5c2d-ad438ea2eea9
msgctxt "hf5724f2dg2430g405cg9a94g3ec765069740"
msgid ""
"You're twitching something fierce, love. And your eyes! You look like you "
"don't know the <i>meaning </i>of the word sleep."
msgstr "자꾸 움찔거리고 있지 않니, 얘야. 그리고 그 눈은 또! <i>생전</i> 한 번도 잠을 못 자본 것처럼 보이는구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Player
#. NodeID = fab7c9c2-d7ea-399b-701c-5835798cc5fd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WARLOCK(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:fab7c9c2-d7ea-399b-701c-5835798cc5fd
msgctxt "h74e56f5dg142bg4d7ag8ba9g14c67fc71aad"
msgid "Might you hail from Thay, perhaps?"
msgstr "설마, 테이 출신인가요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader
#. Speaker = Auntie Ethel
#. NodeID = ffab6c14-a342-b9e2-2bdc-22365a946c1c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_HagTrader_State_AgreeMeetTeahouse(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader:ffab6c14-a342-b9e2-2bdc-22365a946c1c
msgctxt "h24843467g03dag4071g99eegeba1f01cd45c"
msgid ""
"Nae bother, love. By the way, I'll be heading home soon. Be sure to come "
"visit, you hear?"
msgstr "신경 쓰지 마렴, 얘야. 아무튼, 난 곧 집으로 돌아갈 예정이란다. 꼭 한 번 들리도록 하렴, 알겠지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader_AD_Flee
#. Speaker = Auntie Ethel
#. NodeID = eb04d594-3f78-0344-89b3-1fcdf64512ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader_AD_Flee:eb04d594-3f78-0344-89b3-1fcdf64512ed
msgctxt "h5fce3849g87d0g4338gb635g40a0f302ab79"
msgid "Blast it all! I'm going home."
msgstr "다 때려치워! 집에 갈 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader_AD_GreetingPlayer
#. Speaker = Auntie Ethel
#. NodeID = f6a02a94-52f6-f83e-3c8c-a0df0c882b38
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader_AD_GreetingPlayer:f6a02a94-52f6-f83e-3c8c-a0df0c882b38
msgctxt "h10d453bfgf388g4a5fg8e19g6ca297b100ae"
msgid "Why, hello there, sweetness!"
msgstr "오, 반갑구나. 이쁜이!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader_AD_WithChef
#. Speaker = Auntie Ethel
#. NodeID = 0673609e-abed-dfb9-6d58-51f1736806b6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 61f67f30-ff24-52d4-d04f-1388c5412254_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader_AD_WithChef:0673609e-abed-dfb9-6d58-51f1736806b6
msgctxt "ha02438dag2029g4ff4g929egc8dd8182537a"
msgid "Sure I can't tempt you with some spices? That stew is <i>pungent. </i>"
msgstr "향신료를 좀 넣지 않으련? 스튜 향이 너무 <i>콕 쏘는구나. </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader_AD_WithChef
#. Speaker = Okta
#. NodeID = 0ecebfb9-a809-8c11-730b-b0ed96b77844
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader_AD_WithChef:0ecebfb9-a809-8c11-730b-b0ed96b77844
msgctxt "h50c8e615gabc9g4471g94f7gb1443009ee75"
msgid "And how <i>did</i> you make it past all the goblins and gnolls?"
msgstr "그럼 그 많은 고블린과 놀은 <i>어떻게</i> 뚫고 온거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader_AD_WithChef
#. Speaker = Auntie Ethel
#. NodeID = 19a3a21b-cf08-60bf-f04d-6d814b5fa8e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader_AD_WithChef:19a3a21b-cf08-60bf-f04d-6d814b5fa8e2
msgctxt "h29ca193bg9d42g4a2fgac51g19d85a7e032d"
msgid ""
"I had to! Kicked out of your own homes, <i>poor </i>things. How could I stay "
"away?"
msgstr "와야지! 고향에서 쫓겨난 <i>불쌍한</i> 것들이 있는데. 어떻게 보고만 있겠니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader_AD_WithChef
#. Speaker = Okta
#. NodeID = 2448455f-5315-2654-31fb-0aea4cb8d3a9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader_AD_WithChef:2448455f-5315-2654-31fb-0aea4cb8d3a9
msgctxt "h8b1692bdg4ea2g423ega8b6g4d51d5265aaa"
msgid "The smell doesn't matter. It's food in their bellies."
msgstr "냄새가 무슨 상관이야. 배에 들어가면 다 똑같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader_AD_WithChef
#. Speaker = Okta
#. NodeID = 30a73c66-2f0b-e29d-8306-061519f10d33
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 61f67f30-ff24-52d4-d04f-1388c5412254_A = True
#. SetFlags:
#.   Local:
#.     - 61f67f30-ff24-52d4-d04f-1388c5412254_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader_AD_WithChef:30a73c66-2f0b-e29d-8306-061519f10d33
msgctxt "h8f856908gc668g41cag9610g2fb0c07d4f9f"
msgid "Showing up here out of the blue, you've got good timing."
msgstr "이런 곳에 난데없이 나타나다니, 참 시기적절하네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader_AD_WithChef
#. Speaker = Auntie Ethel
#. NodeID = 335a80c8-6e5e-dc85-405a-e09f2c64a94f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader_AD_WithChef:335a80c8-6e5e-dc85-405a-e09f2c64a94f
msgctxt "hd93a4fc9g17a7g4fa5ga2e7ge5fff2565577"
msgid "Leave while folk still need my lotions and potions? I simply couldn't."
msgstr "내 물약과 고약이 필요한 이웃을 두고 떠나라고? 그럴 순 없지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader_AD_WithChef
#. Speaker = Auntie Ethel
#. NodeID = 6463ace8-da7f-2a14-b59b-0ee444260729
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader_AD_WithChef:6463ace8-da7f-2a14-b59b-0ee444260729
msgctxt "hd0282f3fg839bg4f08g8c06gaf429c510d5f"
msgid ""
"Wait for Baldur's Gate, love. The coin you'll make shining shoes and "
"scrubbing chamber pots - you won't know yourself."
msgstr "발더스 게이트까지만 참으렴, 아가. 신발에 광내고 요강 벅벅 닦아서 벌 돈이 얼마일지! 그 돈이면 너도 몰라보게 싹 바뀔 게야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader_AD_WithChef
#. Speaker = Auntie Ethel
#. NodeID = 6d9da869-6348-662f-024a-ecae86ae6949
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader_AD_WithChef:6d9da869-6348-662f-024a-ecae86ae6949
msgctxt "he7f2bec9gda2cg47abg9c58g8f4fc888e39e"
msgid ""
"Well, when you've lived as long as I have, you pick up a few tricks, you "
"know?"
msgstr "글쎄, 이만큼 나이를 먹으면 재주 몇 가지를 익히게 된단다?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader_AD_WithChef
#. Speaker = Okta
#. NodeID = 7d97af2f-014d-5eb3-446d-bb775673edca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader_AD_WithChef:7d97af2f-014d-5eb3-446d-bb775673edca
msgctxt "hfa5e3d73g7652g4134ga2a1gaf010ee7779d"
msgid ""
"So long as my 'art' doesn't choke them on the way down, I call it a job done."
msgstr "내 '예술'을 삼키다가 목구멍에 걸리는 일만 없으면, 내 기준에선 된 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader_AD_WithChef
#. Speaker = Auntie Ethel
#. NodeID = aa1e2373-3611-6a71-fb6d-a7a5bb87d2a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader_AD_WithChef:aa1e2373-3611-6a71-fb6d-a7a5bb87d2a7
msgctxt "hb73bc527g0f59g4350gaa02g0d9042fa35fc"
msgid ""
"Why, you can't call something <i>food</i> if it doesn't smell good - cooking "
"is an art, petal."
msgstr "아휴, 냄새가 좋지 않은 걸 <i>음식</i>이라고 부를 순 없잖니. 요리는 예술이란다, 얘야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader_AD_WithChef
#. Speaker = Okta
#. NodeID = d9cdddae-0b38-3dd2-ba0a-b37769a3a04e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader_AD_WithChef:d9cdddae-0b38-3dd2-ba0a-b37769a3a04e
msgctxt "hc096758dgb004g489cgb5fdga764e8766e6c"
msgid "Couldn't pass up the chance to make some coin, you mean."
msgstr "돈 벌 기회를 놓칠 수는 없었다는 뜻이겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HagTrader_AD_WithChef
#. Speaker = Okta
#. NodeID = e120a5c4-a099-620c-c032-b6b9437da2af
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 61f67f30-ff24-52d4-d04f-1388c5412254_B = True
#. SetFlags:
#.   Local:
#.     - 61f67f30-ff24-52d4-d04f-1388c5412254_A = False
