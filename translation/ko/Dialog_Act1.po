#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount5(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ConflictedFlind_Flind:d83cef8a-4041-48e8-a515-12ec97c049c5
msgctxt "hd86ac570g8e7dg481ag8900gdefbbb692b22"
msgid ""
"*Your blood runs quicker, feeding the gnawing absence at the centre of your "
"mind.*"
msgstr "*피가 더 빨리 흐르면서, 당신의 정신 한가운데를 좀먹는 허전함을 양분으로 채웁니다.*"

