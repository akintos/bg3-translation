msgctxt "h688f145fg67ecg4537g9697g039dab624c5b"
msgid "Stranger! With bones and blood, under your skin. <i>Gimme!</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeWorg2
#. Speaker = Worg
#. NodeID = 2d2992dd-52fe-b8f4-d4a1-22833e4fc734
