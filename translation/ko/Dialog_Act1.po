msgctxt "hb179ea35g2cf4g407eg8269gf38f37f8877d"
msgid "Scram."
msgstr "꺼져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_PatrollingGoblin
#. Speaker = Goblin Brawler
#. NodeID = 3521bef3-645e-b160-4b3f-de62549d82d1
