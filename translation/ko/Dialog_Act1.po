msgctxt "h086b57cdg0454g4c92g836bg6d0587325653"
msgid "No duergar built this place. They don't have the style."
msgstr "듀에르가가 이걸 지었을 리는 없어. 이런 예술을 가지고 있지 않거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_DuergarCamp_Entrance_VB_1P
#. Speaker = Player
#. NodeID = fc267c36-ae34-ea36-20b1-63511f1ef7f6
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_DuergarCamp_Entrance_VB_1P:fc267c36-ae34-ea36-20b1-63511f1ef7f6
msgctxt "h22502d48g3fb7g44e6ga5b4g9fd4014b8cba"
msgid ""
"Fascinating architecture. Doesn't match the style of any Underdark "
"civilisation that I know of."
msgstr "환상적인 건축물이야. 내가 아는 언더다크 문명들의 양식과는 전혀 다르군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_DuergarCamp_Entrance_VB_1P
#. Speaker = Player
#. NodeID = fc267c36-ae34-ea36-20b1-63511f1ef7f6
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
