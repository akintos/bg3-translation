msgctxt "ha92f9a59g5a23g449dgbe2agf6ac9dbf3067"
msgid "By all means, carry on. I'll come running if you need me."
msgstr "얼마든지, 다녀와. 필요하면 달려갈 테니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/AstralPlane/CRE_AstralPrison_DaisyCaveEntrance
#. Speaker = Player
#. NodeID = c6069699-5aeb-46a0-892a-d291a4537087
