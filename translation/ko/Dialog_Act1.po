msgctxt "h8f635d7bg3237g4c0agb046g1471c67e106f"
msgid "We won't tolerate necromancy."
msgstr "강령술은 용납하지 않을 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Refugee_SpokeWithDeadCrime
#. Speaker = GROUP_ZarielCultists
#. NodeID = d93c289b-f103-8a8f-2d71-44a30a846921
