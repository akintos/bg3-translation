msgctxt "hf13b2c4fgd689g4192g996dg5f355845745c"
msgid "Quite the lively little pond, aren't you?"
msgstr "아주 활기찬 웅덩이구나, 안 그래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_MonkAmulet_PAD_EnteredLavaLake
