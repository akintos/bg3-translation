msgctxt "he7607f5fge08bg438dg9d62gba46dacf053c"
msgid "Here dwelt a man blessed with impeccable taste in literature."
msgstr "이곳에는 문학에 아주 흠잡을 데 없는 취향을 가진 사람이 살았군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_ArcaneTower_PAD_Poems
#. Speaker = Player
#. NodeID = 83839bf1-cce1-4457-ab2f-082b4d446929
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
