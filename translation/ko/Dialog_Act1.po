#.      - FOR_UnfortunateGone_TiedUpHasmet(1) = False
#. SetFlags:
#.   Dialog:
#.     - FOR_UnfortunateGone_TiedUpHasmet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_UnfortunateGnome_TiedUp:20b43638-bf66-767c-71fe-b0beecaf392d
msgctxt "h4af48435g7063g4136gbf73gebfc092e1ec0"
msgid "Cut me loose!"
msgstr "풀어줘!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_UnfortunateGnome_TiedUp
#. Speaker = Barcus Wroot
#. NodeID = 260580c7-f06e-4d98-0d42-5bf6b4413eb9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_UnfortunateGone_TiedUpHasmet(1) = True
