msgctxt "h30d890bbgb69dg4d6eg9083g47a25dc69473"
msgid "*The boat floats in the murky waters.*"
msgstr "*범선은 칠흑같은 물 위에 떠 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_DuergarBoatAtCamp
#. Speaker = Player
#. NodeID = 245d9450-8202-309c-9e10-a6e673eebb97
