msgctxt "hd6a22ef5g1599g4d25gb941g4156f0c77ecd"
msgid "Preparing for what?"
msgstr "뭘 준비하고 있었지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_Cultist03_Dead
#. Speaker = Corliss
#. NodeID = b64c3f59-e042-a586-1359-5ae9e0a69d14
