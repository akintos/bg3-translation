#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WaitingBrave
#. Speaker = Rozzak
#. NodeID = 2ab556b2-3f2f-db2f-cae2-4b356b8933c4
