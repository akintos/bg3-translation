msgctxt "h8d3e0c29gebedg4503g9592g2ad28ce2ac4e"
msgid "Your body will attract scavengers. Should I bury you?"
msgstr "네 시체에 짐승들이 꼬일 텐데. 묻어 줄까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_DeadPrisoner_Dead
#. Speaker = Player
#. NodeID = 1c8af136-e122-64f6-4229-0bc71749ec9a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
