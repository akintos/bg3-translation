msgctxt "hdf2802b0gb662g4a96g923fgcf8fd9f320de"
msgid "Keep your paws to yourself, and I won't cut 'em off."
msgstr "손 조심하라고, 그렇지 않으면 잘라버릴테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_ApothecaryGoblins_Goblin_01
#. Speaker = Tracker Slice
#. NodeID = e4be6bc1-924e-8ff6-882a-d4f35dc09888
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_ApothecaryGoblins_Goblin01_HasMet(1) = True
