msgctxt "h57c087b6g68bdg4cd8g9c08gf7b9fbe70e14"
msgid "We're missing something. What?"
msgstr "뭔가 빠트린게 있는데. 뭘까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_AdamantineForge_PAD_ForgingIncomplete
#. Speaker = Player
#. NodeID = 9f1df3e0-76fe-b5d4-ee81-3b13d33a9b2d
