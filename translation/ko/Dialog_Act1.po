msgctxt "h1c06fab8g3cb2g41b0ga641gab58b6c7e703"
msgid "<i>Break the drum so no one can use it.</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_BattleStations_WarDrum
#. Speaker = Narrator
#. NodeID = 0f1eb59e-0fc6-7031-653c-25ad443f53fe
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_BattleStations_Event_ToStation = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_BattleStations_WarDrum:0f1eb59e-0fc6-7031-653c-25ad443f53fe
msgctxt "h740dcc8ag1ac1g4e27g9110g9b3b29c58a76"
msgid ""
"*Chaos ignites in the ruins around you. Goblins howl and spit, clawing for "
"their weapons.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_BattleStations_WarDrum
#. Speaker = Player
#. NodeID = 34cde62f-e886-59c0-8227-fcc5cd0ffa0d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_BattleStations_WarDrum:34cde62f-e886-59c0-8227-fcc5cd0ffa0d
msgctxt "hf4095740g7e60g4b79g8e7ag29eb6ecb2cfb"
msgid "<i>Hit the drum.</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_BattleStations_WarDrum
#. Speaker = Narrator
#. NodeID = 597a941d-338c-d114-7f21-c7c10657a8b0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_GoblinThroneArea_State_Swept = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_BattleStations_WarDrum:597a941d-338c-d114-7f21-c7c10657a8b0
msgctxt "h503fe865g85e4g43f2g93bbg3fc8ea73c97d"
msgid "*As the echo of the drum fades, silence reasserts itself.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_BattleStations_WarDrum
#. Speaker = Narrator
#. NodeID = 99f10f19-48d4-2d22-0ade-84852a073765
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_BattleStations_Event_ToStation = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_BattleStations_WarDrum:99f10f19-48d4-2d22-0ade-84852a073765
msgctxt "h0a4b9c00g0be4g4e22g8eeag31656dbaae28"
msgid "*The drum sits in silence.*"
msgstr "*북이 침묵 속에 놓여 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_BattleStations_WarDrum
#. Speaker = Narrator
#. NodeID = 9eb0ccbf-8f7d-631c-716f-8c851c7d49a9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_BattleStations_HasMet_WarDrum(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_BattleStations_WarDrum:9eb0ccbf-8f7d-631c-716f-8c851c7d49a9
msgctxt "h075ae049g863bg4e8cg810fg7a8392ce1fda"
msgid ""
"*This mighty drum is powerful enough to be heard for miles. You need only "
"strike it.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_BattleStations_WarDrum
#. Speaker = Narrator
#. NodeID = c4cfd2c1-01aa-06e3-5429-bf44dec9b37a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_BattleStations_HasMet_WarDrum(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_BattleStations_WarDrum:c4cfd2c1-01aa-06e3-5429-bf44dec9b37a
msgctxt "h54c45eb9g6370g4e19g8cdfga3943f972b8c"
msgid "*The drum sits in silence.*"
msgstr "*드럼이 침묵 속에 놓여 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_BattleStations_WarDrum
#. Speaker = Player
#. NodeID = dc4f9f7e-32af-fdac-1bd2-fa2be964e589
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_BattleStations_WarDrum:dc4f9f7e-32af-fdac-1bd2-fa2be964e589
msgctxt "h6ab7185dg8403g4907g948cg67137d0df470"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_BattleStations_WarDrum
#. Speaker = Narrator
#. NodeID = fa7532b8-3c7e-bbef-4777-b8e381c4c881
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_BattleStations_Event_ToStation = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_BattleStations_WarDrum:fa7532b8-3c7e-bbef-4777-b8e381c4c881
msgctxt "h6eed2cbdg2ac7g4e22g8a2ega0d4d7afcb1f"
msgid ""
"*The distant chatter of the goblins explodes into angry shouting. They are "
"running your way, swiftly as they can.*"
msgstr "*멀리서 들려오던 고블린들의 재잘거림이 성난 고함소리로 폭발합니다. 고블린들이 최대한 빠르게 달려오고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Bravado_Goblin_001
#. Speaker = Warrior Plagg
