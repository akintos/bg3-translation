#.     - 096b3caa-34cd-4f86-4071-2eed3f98613b_C = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_AD_GithBoy_AssaultReaction:e4974276-dfa7-4612-854a-4b6c4cd9c83e
msgctxt "hf4b35caeg400ag415cg85d4g482b927500fa"
msgid "No!"
msgstr "안돼!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_AD_Student03Combat
#. Speaker = Youth Zar'a'ath
#. NodeID = 795d802f-316c-da1c-463c-92b4a1149068
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_AD_Student03Combat:795d802f-316c-da1c-463c-92b4a1149068
msgctxt "h10c39a23g9546g41d1ga0ccg65147c90e47d"
msgid "Perish by my hand, <i>is'tark</i>!"
msgstr "내 손에 죽어라, <i>이스탁</i>!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_AD_TeacherBeatingBoy
#. Speaker = Youth Varrl
#. NodeID = 1d42d6cf-252f-eb0b-78e9-4bb496df97f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_AD_TeacherBeatingBoy:1d42d6cf-252f-eb0b-78e9-4bb496df97f3
msgctxt "h577a9db4gc178g418dg8ea9gdc5d15042320"
msgid "I'm sorry, <i>Sa'varsh</i>."
msgstr "죄송합니다, <i>사바쉬</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_AD_TeacherBeatingBoy
#. Speaker = Sa'varsh Kethk
#. NodeID = 6da17990-595a-7aea-b0df-74a3e17883c2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_AD_TeacherBeatingBoy:6da17990-595a-7aea-b0df-74a3e17883c2
msgctxt "h58e8bf6bg6f13g41c0gbd8fg720e40227059"
msgid "<i>Pa'vrylk</i>!<i> </i>Stop this insufferable whining!"
msgstr "<i>파브릴크</i>! 이건 정말 참을 수 없군, 징징대지 마라!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_AD_TeacherBeatingBoy
#. Speaker = Youth Varrl
#. NodeID = a2492468-7540-d819-abb6-8aff3276354b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_AD_TeacherBeatingBoy:a2492468-7540-d819-abb6-8aff3276354b
msgctxt "h457444bfgab06g4fddgbecfg13f62ada42cb"
msgid "I'd already disarmed her."
msgstr "이미 걔의 무장을 해제시켰다고요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_AD_TeacherBeatingBoy
#. Speaker = Youth Varrl
#. NodeID = ac42c70a-fa6c-9d39-779b-7568914c3ab8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_AD_TeacherBeatingBoy:ac42c70a-fa6c-9d39-779b-7568914c3ab8
msgctxt "h2532f3b7g4681g4d0egbafag50980e74cd00"
msgid "Stop!"
msgstr "그만 해요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_AD_TeacherBeatingBoy
#. Speaker = Sa'varsh Kethk
#. NodeID = c09afbc3-ec0b-d55b-6b7e-0b5518f505af
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - b0c97447-ac3d-959c-510c-1e5eea66766c_A = True
#. SetFlags:
#.   Local:
#.     - b0c97447-ac3d-959c-510c-1e5eea66766c_B = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_AD_TeacherBeatingBoy:c09afbc3-ec0b-d55b-6b7e-0b5518f505af
msgctxt "h830d3d47g0daeg4713gac36g2773fa0083da"
msgid "This is only a taste of the 'mercy' a <i>ghaik</i> would show you."
msgstr "이건 <i>게이크</i>가 너에게 베풀 '자비'의 맛보기에 불과하다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_AD_TeacherBeatingBoy
#. Speaker = Sa'varsh Kethk
#. NodeID = c9774a3a-da7e-b4bd-4e84-58acb2edaedb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - b0c97447-ac3d-959c-510c-1e5eea66766c_C = True
#. SetFlags:
#.   Local:
#.     - b0c97447-ac3d-959c-510c-1e5eea66766c_B = False
#.     - b0c97447-ac3d-959c-510c-1e5eea66766c_A = False
#.     - b0c97447-ac3d-959c-510c-1e5eea66766c_C = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_AD_TeacherBeatingBoy:c9774a3a-da7e-b4bd-4e84-58acb2edaedb
msgctxt "hd4514f77g0460g4cadg8c0ag77c8e27f1286"
msgid "Your disobedience brings shame on Crèche Y'llek."
msgstr "네놈의 불복종은 일레크 양성소의 수치다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_AD_TeacherBeatingBoy
#. Speaker = Sa'varsh Kethk
#. NodeID = d0155a19-1706-5a7d-8074-7d9863868c92
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - b0c97447-ac3d-959c-510c-1e5eea66766c_B = True
#. SetFlags:
#.   Local:
#.     - b0c97447-ac3d-959c-510c-1e5eea66766c_C = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_AD_TeacherBeatingBoy:d0155a19-1706-5a7d-8074-7d9863868c92
msgctxt "h898264ebg22ffg4c14g9ebege34a0573e775"
msgid "Perhaps a tadpole has already addled your brain? Is that it?"
msgstr "벌써 네놈의 뇌에 올챙이가 심어졌나 보군? 맞지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_AD_TeacherBeatingBoy
#. Speaker = Youth Varrl
#. NodeID = d87d9928-c52a-38ac-e345-999587c90368
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_AD_TeacherBeatingBoy:d87d9928-c52a-38ac-e345-999587c90368
msgctxt "hdfe3d1d4g32bdg4ab3g89f3gd7a4192c6203"
msgid "My brain is fine!"
msgstr "제 뇌는 멀쩡해요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_AD_TeacherBeatingBoy
#. Speaker = Sa'varsh Kethk
#. NodeID = fa4bd599-9ca7-effc-d18e-bec2b2a4cf44
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - b0c97447-ac3d-959c-510c-1e5eea66766c_A = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_AD_TeacherBeatingBoy:fa4bd599-9ca7-effc-d18e-bec2b2a4cf44
msgctxt "h934e7d46g8d87g45b4gbee4g9bdc999d4fa1"
msgid ""
"<i>K'chakhi!</i> When you have the chance to kill your enemy, you take it!"
msgstr "<i>크차키!</i> 적을 죽일 기회가 생기면, 죽이란 말이다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_AD_TeacherClass
#. Speaker = Sa'varsh Kethk
#. NodeID = 08202a5d-4803-4b8e-9493-94e253475296
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 91600fc1-9129-a9da-0f79-0edece98ec81_A = True
#. SetFlags:
#.   Local:
#.     - 91600fc1-9129-a9da-0f79-0edece98ec81_B = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_AD_TeacherClass:08202a5d-4803-4b8e-9493-94e253475296
msgctxt "h765cc9d0g1471g47fcg9464ge2fc7e1bc0b4"
msgid "Strike hard. Slice flesh. No hesitation."
msgstr "내려쳐라. 살점을 썰어라. 망설이지 마라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_AD_TeacherClass
#. Speaker = Sa'varsh Kethk
#. NodeID = 266acd4a-ff9a-42bd-a6db-e31875ea65fe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 91600fc1-9129-a9da-0f79-0edece98ec81_B = True
#. SetFlags:
#.   Local:
#.     - 91600fc1-9129-a9da-0f79-0edece98ec81_C = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_AD_TeacherClass:266acd4a-ff9a-42bd-a6db-e31875ea65fe
msgctxt "ha22ebfadgd762g4f18g8043gb5a0865bc73b"
msgid "Mercy is death. Death is mercy. This is Vlaakith's will."
msgstr "자비는 죽음이다. 죽음은 자비다. 이게 블라키스 님의 의지다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_AD_TeacherClass
#. Speaker = Sa'varsh Kethk
#. NodeID = 32f21fb6-bab9-4e39-957c-84e68c3c61ec
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 91600fc1-9129-a9da-0f79-0edece98ec81_A = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_AD_TeacherClass:32f21fb6-bab9-4e39-957c-84e68c3c61ec
msgctxt "h8ac25fb0gf129g4e95gb3c3gf950e4598084"
msgid "You are well on your way to being <i>ghaik </i>food. Do. Better."
msgstr "네놈은 <i>게이크</i> 밥이 되기 딱 좋구먼. 더, 잘해보란 말이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_AD_TeacherClass
#. Speaker = Sa'varsh Kethk
#. NodeID = ca20c566-e936-476b-942c-9d8f761f5092
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 91600fc1-9129-a9da-0f79-0edece98ec81_C = True
#. SetFlags:
#.   Local:
#.     - 91600fc1-9129-a9da-0f79-0edece98ec81_B = False
#.     - 91600fc1-9129-a9da-0f79-0edece98ec81_C = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_AD_TeacherClass:ca20c566-e936-476b-942c-9d8f761f5092
msgctxt "h7ea0cd99ga0e8g43d7gaf64g9a318091929f"
msgid "Quicker! A <i>ghaik</i> would have smeared you across the floor by now!"
msgstr "더 빨리! <i>게이크</i>가 이미 네놈을 바닥에 곤죽으로 만들었다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_AD_TeacherCombatStart
#. Speaker = Sa'varsh Kethk
#. NodeID = a46ed276-a3ef-81de-344f-f946e21d8dd9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_AD_TeacherCombatStart:a46ed276-a3ef-81de-344f-f946e21d8dd9
msgctxt "h2b28a34fga7e5g4777g9809gc41b44a05788"
msgid "Take up your weapons! Do not fail me!"
msgstr "무기를 들어라! 날 실망하게 하지 마라!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_AD_TeacherCombat_AllYouthDead
#. Speaker = Sa'varsh Kethk
#. NodeID = d361c10c-e184-4765-a1c7-6f512e77f0f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_AD_TeacherCombat_AllYouthDead:d361c10c-e184-4765-a1c7-6f512e77f0f0
msgctxt "h133e0a8dg3b81g4ea9g81e8g2e7c39091c02"
msgid "You purged the weaklings - now I will purge you!"
msgstr "네놈은 약해 빠진 것들을 숙청했다... 이제 내가 너를 숙청하마!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_AD_TeacherCombat_YouthDies
#. Speaker = Sa'varsh Kethk
#. NodeID = 901c05d1-2af4-1efb-256b-7dcf494c66c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_AD_TeacherCombat_YouthDies:901c05d1-2af4-1efb-256b-7dcf494c66c1
msgctxt "hfd49228bg2a76g4a66gb5ffga9328a020821"
msgid "Pathetic <i>weakling</i>!"
msgstr "한심한 <i>약해 빠진 것</i>!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = 0070dd81-643f-fd7a-9295-5bf180d460f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:0070dd81-643f-fd7a-9295-5bf180d460f4
msgctxt "h31e5a406g46c3g407dgbd09g1b4411d9a9ea"
msgid "You're right. This isn't the time. Sa'varsh Kethk might hear us."
msgstr "아, 그래. 지금은 이런 얘기 할 때가 아니지. 사바쉬 케스크가 들을지도 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = 019cffdf-0e08-4c21-b461-2bbf0a4c1156
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 5a509344-b21e-16c1-5b8e-8e95a83fdb80_MindHasBeenRead = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:019cffdf-0e08-4c21-b461-2bbf0a4c1156
msgctxt "he25bc73fg2e5bg4a5fg925dg794883fbb1d4"
msgid "I'm just like Orpheus?"
msgstr "마치 오르페우스 같았다고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = 01c25916-6406-5337-0394-c19d22db8e87
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - FIGHTER(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:01c25916-6406-5337-0394-c19d22db8e87
msgctxt "hc7c9bca7gd75fg48a5gb49dg5b20c64bf3e2"
msgid "Your teacher has forgotten what truly makes a warrior."
msgstr "네 스승은 진정 무엇이 전사를 만드는지 잊은 모양이구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = 026d1e68-8c06-6cd9-6e52-1d46a144309c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:026d1e68-8c06-6cd9-6e52-1d46a144309c
msgctxt "hde5b0f58ga9a9g4cecg9fc8g67e1c21d17c7"
msgid "Yes. Of course that's why you did it."
msgstr "그렇구나. 아무렴 그렇겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = 02826c75-b987-b38d-fddd-7060e1d1eebb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_State_ReadOrpheusChapter1 = True
#.   Object:
#.      - ORI_Laezel_State_HasOrpheusChapter1(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:02826c75-b987-b38d-fddd-7060e1d1eebb
msgctxt "h5ede899cg1d8fg43efg8f34gec459d444307"
msgid "Have a look at my chapter. Perhaps you can find some answers in there."
msgstr "내가 가진 기록도 읽어봐. 거기서 답을 찾을지도 모르잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = 0539ba87-ca55-4ea8-a7b9-7e7ce94c19dc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 5a509344-b21e-16c1-5b8e-8e95a83fdb80_MindHasBeenRead = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:0539ba87-ca55-4ea8-a7b9-7e7ce94c19dc
msgctxt "hffa17e7age6c9g4b63gb3b9g36b53491f919"
msgid "To understand Orpheus?"
msgstr "오르페우스를 이해하고 싶다고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = 07560bc6-37f6-bb35-744e-6214b11136b1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Laezel_State_HasOrpheusChapter2(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:07560bc6-37f6-bb35-744e-6214b11136b1
msgctxt "hd722c7ddg2e8eg4d48gbe90g25de50585341"
msgid "I agree, it's a real page-turner. <i>Show him the book you stole.</i>"
msgstr "그렇더라, 정말 흥미진진하던걸. <i>훔친 기록물을 보여줍니다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = 0ca9beae-2495-af03-eccf-63498a2ffb42
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:0ca9beae-2495-af03-eccf-63498a2ffb42
msgctxt "h0320830fg7cceg4398gbd5ag4415ed126b42"
msgid ""
"But you... You showed compassion, and kindness. You're just like - never "
"mind."
msgstr "하지만 너는... 너는 동정심과 친절함을 보여줬지. 마치 - 아냐, 됐어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = 0de64ce8-6f0d-d037-4f7c-c4752d8ba94b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:0de64ce8-6f0d-d037-4f7c-c4752d8ba94b
msgctxt "hbe152553g4979g4366gbad9g11717c8e8be6"
msgid ""
"<i>Orpheus is so amazing. He saved us from the </i>ghaik<i>s' "
"enslaving...</i>"
msgstr "<i>오르페우스 님은 대단하다네. 우리를 </i>게이크<i>의 마수에서 해방하셨지.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = 0e85049e-f71f-700d-bdfa-2a5d8dbd2ac4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:0e85049e-f71f-700d-bdfa-2a5d8dbd2ac4
msgctxt "h3072169bg51f4g4dd8g8de2g58f7351e9524"
msgid "<i>Don't think about Orpheus. Don't think about Orpheus...</i>"
msgstr "<i>오르페우스 님에 대해 생각해선 안 돼. 오르페우스 님에 대해 생각해선 안 돼...</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = 104910e8-8a88-4ae3-ad86-e51ea7ec5c41
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 5a509344-b21e-16c1-5b8e-8e95a83fdb80_MindHasBeenRead = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:104910e8-8a88-4ae3-ad86-e51ea7ec5c41
msgctxt "hd2e01d20gb46bg406agb75ag0e04f860527d"
msgid "<i>Don't mention Orpheus. Don't mention Orpheus... </i>"
msgstr "<i>오르페우스 님을 언급해선 안 돼. 오르페우스 님을 언급해선 안 돼...</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = 10d304bb-ce86-3e50-9d68-c2c31e835c79
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = False
#. TagRule: !()
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:10d304bb-ce86-3e50-9d68-c2c31e835c79
msgctxt "h1f7c2843gbab5g4524g9faag8d2c840ba2d4"
msgid "Hand it over. Or should I tell your captain to come and confiscate it?"
msgstr "얌전히 넘겨. 아니면 너희 대장한테 와서 압수해가라고 해볼까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = 1204889b-aa7e-4e10-9c6e-0061c6227994
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 5a509344-b21e-16c1-5b8e-8e95a83fdb80_MindHasBeenRead = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:1204889b-aa7e-4e10-9c6e-0061c6227994
msgctxt "h2cce815cg9a3fg486egb303g212670fdab2d"
msgid ""
"<i>Orpheus is so complex. Even the sa'varsh wouldn't understand him.</i>"
msgstr "<i>오르페우스 님은 참 알기 어려운 분이야. 아무리 사바쉬라도 이해하진 못할걸.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = 12daf316-6c28-38a2-13c2-6c04c338585b
#. HandlePath = RollAdvantageReason
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(1) = False
#.      - REALLY_GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:12daf316-6c28-38a2-13c2-6c04c338585b
msgctxt "he964fd87g8a3bg4247ga356g2befce156e4a"
msgid "Githyanki"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = 12daf316-6c28-38a2-13c2-6c04c338585b
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(1) = False
#.      - REALLY_GITHYANKI(1) = True
#. TagRule: !()
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:12daf316-6c28-38a2-13c2-6c04c338585b
msgctxt "h2acadf5fg3b77g4570ga002gc31f62e1d938"
msgid ""
"Hand it over. Or should I tell your <i>sa'varsh</i> to come and confiscate "
"it?"
msgstr "얌전히 넘겨. 아니면 <i>사바쉬</i>한테 와서 압수해가라고 해볼까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = 13eed657-7aa3-ec1b-cac4-d0d60b12f93c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:13eed657-7aa3-ec1b-cac4-d0d60b12f93c
msgctxt "he61fb4c2g5e02g4616g8701g335079a34198"
msgid "At least, that's what Prince Orpheus says."
msgstr "적어도 오르페우스 왕자님은 그렇게 말씀하셨지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = 14c6e431-db74-977f-c8ca-12621207f14b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:14c6e431-db74-977f-c8ca-12621207f14b
msgctxt "ha6bd9e77gc2e0g42cdga750gb3b4bf0d8c2a"
msgid ""
"Wealth often clouds our moral judgement. I'd be happy to ease your burden..."
msgstr "재물이란 대개 우리의 도덕적 판단력을 흐리는 법이지. 기꺼이 네 짐을 덜어주고 싶은데..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = 15e199d4-2678-391a-b9e8-af2fc54cda90
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:15e199d4-2678-391a-b9e8-af2fc54cda90
msgctxt "h3aeadd46g8831g4f86g9ee4g4f96c16ec5f5"
msgid "Next time I won't be there to intervene. Tread carefully."
msgstr "다음에도 내가 끼어들진 못 할 거야. 조심해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = 16318061-3a69-c4f5-bbf1-0621e39ee0ea
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Laezel_State_HasOrpheusChapter2(0) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:16318061-3a69-c4f5-bbf1-0621e39ee0ea
msgctxt "h9249d7f1g2683g40f8gb526ga86cca388160"
msgid "I might care, if you let me read your copy."
msgstr "네 걸 읽게 해주면 관심이 생길 것도 같은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = 17cd5526-dbf3-7e15-c4e0-5dc8c19ba2b5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_Knows_HowToUnlockOrpheusChapters = True
#.   Local:
#.     - 5a509344-b21e-16c1-5b8e-8e95a83fdb80_BoyGaveChapter2 = True
#.   Object:
#.     - CRE_YouthTraining_Event_GiveOrpheusChapter2(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:17cd5526-dbf3-7e15-c4e0-5dc8c19ba2b5
msgctxt "h30ac1956gf2ddg413egbbb6g63d55e9fcf9d"
msgid "Fine, take it."
msgstr "그래, 가져가."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = 17dcb26c-98a5-631e-5806-4aabf7d70081
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:17dcb26c-98a5-631e-5806-4aabf7d70081
msgctxt "h5d68a752gc84bg4c2egb0d9g9755ac79169c"
msgid "I just keep believing I can be better. I hope you will do the same."
msgstr "난 내가 차츰 나아질 거라고 믿어. 너도 그렇게 되길 바라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = 1811f72f-de9e-f1d1-916e-35ca9bf81484
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_YouthTraining_Event_AttackedTeacher = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:1811f72f-de9e-f1d1-916e-35ca9bf81484
msgctxt "h3f49acb3gc95cg427fg8590gbda114423bc7"
msgid "What have you done? You're no better than the <i>sa'varsh</i>."
msgstr "무슨 짓이야? 너도 <i>사바쉬</i>랑 다를 게 없는 놈이었어!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = 1940d22b-956a-7d28-ec62-10a283c4a2a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:1940d22b-956a-7d28-ec62-10a283c4a2a7
msgctxt "h3c40c68fg201eg45begae26gdf8f5271cf33"
msgid "I don't think so. No one I've met."
msgstr "아닐걸. 만났던 사람 중엔 아무도 없었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = 1a36ed6c-de4a-50a3-fd28-854caead6eee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:1a36ed6c-de4a-50a3-fd28-854caead6eee
msgctxt "hcb40f68fg2fe7g4fdegb262gc5ed55667da4"
msgid ""
"I thought you helped me because - because you were a good person. Like him."
msgstr "네가 나를 도와줬던 게 - 그냥 네가 좋은 사람이라 그런 줄 알았어. 그분처럼 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = 1a7f5a3b-670e-44c3-8e5b-1396a5cdaea6
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 0
#. CheckFlags:
#.   Local:
#.      - 5a509344-b21e-16c1-5b8e-8e95a83fdb80_MindHasBeenRead = False
#.   Object:
#.      - ORI_Laezel_State_HasOrpheusChapter2(1) = False
#.   Script:
#.      - GEN_CanDetectThoughts_2 = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:1a7f5a3b-670e-44c3-8e5b-1396a5cdaea6
msgctxt "h7330c318g58ecg43f6gb22eg64ad868d6932"
msgid "<i>Seek the name the boy is holding back.</i>"
msgstr "<i>소년이 감추려 하는 이름을 찾아봅니다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = 1afa9564-0dd3-0838-e57c-0d469ba68fac
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_YouthTraining_HasMet_GithBoy(1) = False
#.   Global:
#.      - CRE_YouthTraining_State_PlayerHealedBoy = True
#.      - CRE_YouthTraining_State_BoyNonFatal = True
#. SetFlags:
#.   Dialog:
#.     - CRE_YouthTraining_HasMet_GithBoy(1) = True
#. TagRule: !GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:1afa9564-0dd3-0838-e57c-0d469ba68fac
msgctxt "h0a103413gd860g4ab1g97adgf8897923d758"
msgid ""
"Thank you, <i>istik.</i> The <i>sa'varsh</i> would have left me there to die."
msgstr "고마워, <i>이스틱.</i> <i>사바쉬</i>는 날 죽게 내버려 뒀을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = 1afa9564-0dd3-0838-e57c-0d469ba68fac
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_YouthTraining_HasMet_GithBoy(1) = False
#.   Global:
#.      - CRE_YouthTraining_State_PlayerHealedBoy = True
#.      - CRE_YouthTraining_State_BoyNonFatal = True
#. SetFlags:
#.   Dialog:
#.     - CRE_YouthTraining_HasMet_GithBoy(1) = True
#. TagRule: GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:1afa9564-0dd3-0838-e57c-0d469ba68fac
msgctxt "h79f4e177ga7d9g4139gb771ga5d052cd9666"
msgid ""
"Thank you, <i>ra'stil. </i>The <i>sa'varsh</i> would have left me there to "
"die."
msgstr "고마워, <i>라스틸.</i> <i>사바쉬</i>는 날 죽게 내버려 뒀을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = 1be0d1ab-98d6-42aa-7e0f-5516f1fea316
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:1be0d1ab-98d6-42aa-7e0f-5516f1fea316
msgctxt "he0d0f676g7152g43c2gb8bbg0789557c37f1"
msgid ""
"Well, if you tell him about the book, then... then I'll tell him I got it "
"from you!"
msgstr "글쎄, 네가 책에 대해 일러바치면... 너한테서 받은 거라고 말할 거야!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = 1c3d83e1-e52a-f9f2-356a-58520e8238af
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = False
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_Knows_HowToUnlockOrpheusChapters = True
#.   Local:
#.     - 5a509344-b21e-16c1-5b8e-8e95a83fdb80_BoyGaveChapter2 = True
#.   Object:
#.     - CRE_YouthTraining_Event_GiveOrpheusChapter2(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:1c3d83e1-e52a-f9f2-356a-58520e8238af
msgctxt "ha2f8b992g0ed8g4c80g9c77g28670e02296a"
msgid "Really? I had no idea <i>istiks</i> cared about githyanki stories."
msgstr "진짜? 나는 <i>이스틱</i>이 우리 이야기에 관심을 가질 거라곤 생각도 못 했는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = 274e12a8-72dc-6baa-334e-cba89d50690b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_Knows_HowToUnlockOrpheusChapters = True
#.   Local:
#.     - 5a509344-b21e-16c1-5b8e-8e95a83fdb80_BoyGaveChapter2 = True
#.   Object:
#.     - CRE_YouthTraining_Event_GiveOrpheusChapter2(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:274e12a8-72dc-6baa-334e-cba89d50690b
msgctxt "h5a5f76e0g8594g48c5g8a56gd2354f38b13f"
msgid ""
"No! Please don't tell the <i>sa'varsh</i> - he'll kill me! Just take it."
msgstr "안돼! 제발 <i>사바쉬</i>한테는 말하지 마, 날 죽이려 들 거야! 그냥 가져가."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = 2c5b4c24-decd-ac9c-ea34-94d46860e664
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:2c5b4c24-decd-ac9c-ea34-94d46860e664
msgctxt "hf92781e2g5875g4d12g9eabgaa6abdcf3a46"
msgid "My sword will be ready. <i>Vlaakith gha'g shkath zai!</i>"
msgstr "제 검을 바칩니다.<i>블라키스 가그 슈카스 자이!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = 316eaee4-e0d9-5537-93aa-3e8d4f74afb6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Laezel_State_HasOrpheusChapter2(0) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:316eaee4-e0d9-5537-93aa-3e8d4f74afb6
msgctxt "h2aa53949ge1d0g4778gbfbdg44e45523850c"
msgid "Please let me give you... Wait, where is it?"
msgstr "부디 내 걸 가져가... 뭐야, 어디 갔지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = 323bf86a-2602-3c0d-dbf3-95d948948b2e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Laezel_State_HasOrpheusChapter2(0) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:323bf86a-2602-3c0d-dbf3-95d948948b2e
msgctxt "hcc3c107egc934g4448gb223g66f1130d9af6"
msgid "Can I have it?"
msgstr "그거 나 줄 수 있을까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = 34f1026c-6762-9621-5047-7a41d1113958
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:34f1026c-6762-9621-5047-7a41d1113958
msgctxt "h3925550agce3ag4cf6ga77ag5e94fa9b85dd"
msgid "I'll do my best to forget what it said. Thank you for taking it."
msgstr "읽은 내용은 최대한 잊도록 해볼게. 처리해 줘서 고마워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = 34f1ad94-66d3-73af-4439-cf1932580bcd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_State_ReadOrpheusChapter3 = True
#.   Object:
#.      - ORI_Laezel_State_HasOrpheusChapter3(1) = True
#.      - ORI_Laezel_State_HasOrpheusChapter1(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:34f1ad94-66d3-73af-4439-cf1932580bcd
msgctxt "he14b89fbgad60g4899g9110g45f5ee3e61ad"
msgid "Have a look at my chapter. Perhaps you can find some answers in there."
msgstr "내가 가진 기록도 읽어봐. 거기서 답을 찾을지도 모르잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = 351592d6-e817-9822-36c4-62f59e3d60e4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:351592d6-e817-9822-36c4-62f59e3d60e4
msgctxt "h6aecebddgb959g43c1gb93ag3a7a5c32f63e"
msgid ""
"I've kept it safe the whole time. There's not even a splash of blood on it!"
msgstr "내가 이걸 얼마나 잘 간수했는데. 핏방울 하나도 안 묻혔다니까!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = 35f548eb-daf1-ed86-95d0-614da95a4e3f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:35f548eb-daf1-ed86-95d0-614da95a4e3f
msgctxt "hac524996gc1e1g4ea1ga12cg80e890a9635e"
msgid ""
"I'm sorry. It's too dangerous. If you get caught, or they find out it was me "
"-"
msgstr "미안해, 너무 위험한 일이야. 네가 잡혀가거나, 출처가 나라는 걸 알아채는 날엔..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = 39bbce12-5039-df92-2bc6-41e036a67617
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_YouthTraining_Knows_BoyWasReadingOrpheus = True
#. TagRule: !()
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:39bbce12-5039-df92-2bc6-41e036a67617
msgctxt "h12b030a2gd87bg4c4bga4c1g047c37724ac1"
msgid "I speak of... of Orpheus. The true prince..."
msgstr "나는... 오르페우스 님을 얘기하는 거였어. 진정한 왕자님이시지..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = 3c1106e3-e2ee-08ab-7049-86734a8b3bc1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:3c1106e3-e2ee-08ab-7049-86734a8b3bc1
msgctxt "h2dbed36eg6bfeg423fg9322g9c83be1547e7"
msgid ""
"He's always telling us how we have to be ruthless, that death is the only "
"mercy we deliver."
msgstr "교관님은 언제나 우리에게 냉혹해져야 한다며, 유일하게 베풀어 줄 자비는 죽음뿐이라고 가르치셨어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = 3dbea1a7-92e4-4a58-b602-69b639f1f14a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:3dbea1a7-92e4-4a58-b602-69b639f1f14a
msgctxt "h349464f4gbb3dg4006g9a7eg7a183f7bea56"
msgid ""
"You're sneaky and... and horrible, like all the rest of them, aren't you? "
"Leave me alone."
msgstr "너는 교활하고... 그리고 끔찍해. 다른 사람들과 다를 바 없었다고. 혼자 있게 내버려 둬."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = 414ad168-9e07-fae6-f5c2-8fbf83b666a7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Laezel_State_HasOrpheusChapter2(0) = True
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_Knows_HowToUnlockOrpheusChapters = True
#.   Local:
#.     - 5a509344-b21e-16c1-5b8e-8e95a83fdb80_BoyGaveChapter2 = True
#.   Object:
#.     - CRE_YouthTraining_Event_GiveOrpheusChapter2(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:414ad168-9e07-fae6-f5c2-8fbf83b666a7
msgctxt "hcb1205d3ga736g496fg87c9gcb729aabcb1c"
msgid "Please, let me give you the fragment I have."
msgstr "부디, 내가 가진 부분을 받아줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = 41f0bf8c-d32d-e87e-4027-cbe748fd8a72
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:41f0bf8c-d32d-e87e-4027-cbe748fd8a72
msgctxt "h21440508g33c5g4b98g8f0ag6ace2561f42b"
msgid "One of the others must have stolen it. <i>Shka'keths</i>."
msgstr "누가 훔쳐간 게 분명해. <i>쉬카케쓰</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = 42b744d0-ed9e-556f-f5ad-a5fbf09e70f2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:42b744d0-ed9e-556f-f5ad-a5fbf09e70f2
msgctxt "h61bccc07g5304g4886g9b2ag849fa59c3bf6"
msgid "Compassion? Kindness? I did it for the gold. Now pay up."
msgstr "동정? 친절? 보상을 바라고 한 일이다. 얌전히 바치도록."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = 457ac3fc-7b50-6753-fa64-eb4e04eaee37
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:457ac3fc-7b50-6753-fa64-eb4e04eaee37
msgctxt "h4cc7a183g35a5g48c8gb158gc68efee55ba3"
msgid "You endanger yourself by carrying this around. It must be disposed of."
msgstr "이걸 가지고 다니다간 분명 곤경에 빠질 날이 올 거야. 없애버리는 게 좋겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = 45ec54a4-4d73-4c46-a194-2f8aa043b931
#. HandlePath = RollAdvantageReason
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(1) = False
#.      - REALLY_GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:45ec54a4-4d73-4c46-a194-2f8aa043b931
msgctxt "hf71556b1g2226g4aa4g9400gbf58b2dae8c9"
msgid "Githyanki"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = 45ec54a4-4d73-4c46-a194-2f8aa043b931
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(1) = False
#.      - REALLY_GITHYANKI(1) = True
#. TagRule: !()
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:45ec54a4-4d73-4c46-a194-2f8aa043b931
msgctxt "h734f8d7cg2c3ag44e0ga65bg09133d46fc22"
msgid ""
"Hand it over. Or should I tell your <i>sa'varsh</i> to come and confiscate "
"it?"
msgstr "얌전히 넘겨. 아니면 <i>사바쉬</i>한테 와서 압수해가라고 해볼까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = 4673253e-9fe5-7faf-8d74-19ec6a6b28a1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:4673253e-9fe5-7faf-8d74-19ec6a6b28a1
msgctxt "h0020b4dag6753g4e83g99f8gadc44fbe107e"
msgid ""
"These words, there's so much more to know about him. I can't believe it."
msgstr "여기 적힌 것 좀 봐, 그분에 대해 알 수 있는 게 너무나도 많잖아. 도저히 믿기질 않네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = 47819c3f-6e3e-6616-e19b-59fefb894d30
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:47819c3f-6e3e-6616-e19b-59fefb894d30
msgctxt "h9fd4e122gbe05g4109ga6b3gc0894b46104e"
msgid "I mean, I don't know what you're talking about."
msgstr "아, 아니. 무슨 말인지 모르겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = 484a0a39-9467-476a-e34e-0cccad9fe622
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_Knows_HowToUnlockOrpheusChapters = True
#.   Local:
#.     - 5a509344-b21e-16c1-5b8e-8e95a83fdb80_BoyGaveChapter2 = True
#.   Object:
#.     - CRE_YouthTraining_Event_GiveOrpheusChapter2(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:484a0a39-9467-476a-e34e-0cccad9fe622
msgctxt "h4a7505c5gd594g45f2gb51cga9e4c2dfaa7c"
msgid "It's yours? Of course! That's why you were so ready to help me."
msgstr "네 거 였다고? 당연히 돌려줘야지! 그래서 기꺼이 나를 도와줬던 거구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = 48e921ee-fefd-1792-54da-a0d84169e94f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:48e921ee-fefd-1792-54da-a0d84169e94f
msgctxt "h7385fc7ag5a3ag4b59g9e34g1ab2b5651c79"
msgid "Fine, keep it. <i>Leave.</i>"
msgstr "됐다, 너 가져라. <i>떠납니다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = 4fa09b35-be55-0446-989f-43a8850bfcb6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:4fa09b35-be55-0446-989f-43a8850bfcb6
msgctxt "h4e077f5bg046bg447ega554g0c3b19aeb244"
msgid ""
"I'll say thank you then, as that's all I have. <i>Raz'erai'ka tavkim "
"krash'ht.</i>"
msgstr "너한테 고맙단 말밖엔 못 하겠네. 그게 내가 가진 전부였으니. <i>라제라이카 타브킴 크라시트</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = 50b79e18-e67d-eb29-70a7-bad729a1f4da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:50b79e18-e67d-eb29-70a7-bad729a1f4da
msgctxt "h3988e647g1eb6g4a9aga66fge5855a16a7b5"
msgid ""
"You're a hero, just like Orpheus. Facing almost certain death to enlighten "
"our people."
msgstr "너는 영웅이야, 진짜 오르페우스 같잖아. 우리 종족을 일깨워주려고 목숨까지 걸다니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = 52fd04df-961e-9e0f-f047-4fca622486b4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_Knows_HowToUnlockOrpheusChapters = True
#.   Local:
#.     - 5a509344-b21e-16c1-5b8e-8e95a83fdb80_BoyGaveChapter2 = True
#.   Object:
#.     - CRE_YouthTraining_Event_GiveOrpheusChapter2(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:52fd04df-961e-9e0f-f047-4fca622486b4
msgctxt "h7d9975a3g41d2g463fg8bdegc9aa8effdc79"
msgid "You'd really tell others about him? That's so brave! Please, take it."
msgstr "정말 다른 사람들에게 전하고 다닐 생각이야? 진짜 용감하잖아! 부디, 가져가 줬으면 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = 56181076-8c5b-6f31-dbb2-df4a329f46eb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:56181076-8c5b-6f31-dbb2-df4a329f46eb
msgctxt "h35a0625egc0b2g4791gac66g840a7c7615d2"
msgid "I will. Though every step I take feels like the wrong one."
msgstr "그럴게. 내가 하는 모든 일이 잘못된 것처럼 느껴지긴 하지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = 57da91fe-8f18-6790-615a-e4c4817be8fb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_General_State_SawOrpheusSymbolOnPortrait = True
#.   Tag:
#.      - REALLY_GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:57da91fe-8f18-6790-615a-e4c4817be8fb
msgctxt "hfaa3b06cg24e7g45a7g9434g4df3c642d7f9"
msgid "His symbol was drawn onto Vlaakith's portrait. Was that you?"
msgstr "그의 상징이 블라키스의 초상화에 그려져 있던데, 네가 한 건가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = 5981167b-2897-6792-6f12-42fc328a3f59
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:5981167b-2897-6792-6f12-42fc328a3f59
msgctxt "h02a854bbge326g40aega2e8g7a94c2e80fca"
msgid ""
"I wanted to know if there was anyone else here like me, someone who'd "
"recognise it."
msgstr "여기에 그걸 알아챌 수 있는, 나 같은 사람이 또 있는지 궁금했거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = 5a2e9c06-d545-1fbe-5d52-6d4c14f053d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:5a2e9c06-d545-1fbe-5d52-6d4c14f053d6
msgctxt "h729a9506g5ac5g43bbg82a8ge822c7262cf0"
msgid "You want me to - No, it's mine! I have to keep it safe."
msgstr "너 뭘 - 싫어, 내 거야! 내가 잘 보관하고 있을 거라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = 5b006638-c593-5674-ddd1-25b04fe35098
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:5b006638-c593-5674-ddd1-25b04fe35098
msgctxt "h1dbdf3c7gf530g4adegba5eg9859e894833d"
msgid "Do others here read these Orpheus stories?"
msgstr "여기 있는 다른 이들도 오르페우스 이야기를 읽나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = 5b535b50-a202-5420-d553-61d17428c126
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:5b535b50-a202-5420-d553-61d17428c126
msgctxt "h380ed72bgd026g4641g8682gfd74969e2734"
msgid "You endanger yourself by carrying this around. It must be disposed of."
msgstr "이걸 가지고 다니다간 분명 곤경에 빠질 날이 올 거야. 없애버리는 게 좋겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = 61be4555-67df-76b2-a9c4-13c66e2847d4
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:61be4555-67df-76b2-a9c4-13c66e2847d4
msgctxt "h75428dc1gc14ag4626gabf8gb141aba1b46d"
msgid "It's mine. Those warriors borrowed it from me."
msgstr "그건 내 거야. 전사들이 나한테서 빌려 갔었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = 6300ef7a-75fd-5098-edf9-a5d39215fcb2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:6300ef7a-75fd-5098-edf9-a5d39215fcb2
#, fuzzy
msgctxt "h5c2c2e6fgf4aeg48a8g9ba8g4449a51f46e2"
msgid "Warriors make war. We fight <i>for</i> something, not just to kill."
msgstr "전사는 전쟁을 일으키지. 우리는 살육을 위해서가 아닌, <i>목적을</i> 위하여 싸운다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = 630c7ef5-5850-ecd5-6fd7-f3671928b64b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:630c7ef5-5850-ecd5-6fd7-f3671928b64b
msgctxt "hedf05403g9534g4a28gb901g873e735eab1f"
msgid "I - I take it back! You're nothing like him at all!"
msgstr "내 말 취소야! 너를 그분이랑 닮았다고 생각했었다니!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Lae'zel
#. NodeID = 63f76286-5b52-4fe0-9b76-93d5675968af
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:63f76286-5b52-4fe0-9b76-93d5675968af
msgctxt "h8c2c37e9g968eg4454gafaega19c24a5d6fd"
msgid ""
"By Vlaakith's blade, child - Orpheus is a traitor to our queen. Shut your "
"mouth before the crèche elders hear your words."
msgstr ""
"블라키스의 검으로서 말하는데, 꼬마야. 오르페우스는 여왕을 배신한 자다. 양성소의 늙은이들이 듣기 전에 그 입을 다무는 게 좋을 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = 66f20b3e-097f-5397-2dac-20bf6b0ed2ff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:66f20b3e-097f-5397-2dac-20bf6b0ed2ff
msgctxt "h8bd3ffb4gc02dg4b79ga729gf8d1eb13b49a"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = 69d4df30-2dcb-d69f-952b-619fb269368e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:69d4df30-2dcb-d69f-952b-619fb269368e
msgctxt "h03e63446g9473g4aa2ga2bbga7e917206c47"
msgid ""
"That's... wise. I think. You sound just like <i>him</i>. Prince Orpheus."
msgstr "그건... 현명한 말이네. 꼭 <i>그분</i> 처럼 말하는구나. 오르페우스 왕자님 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = 6b888904-5438-d13c-497f-b9f6251a5b8b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:6b888904-5438-d13c-497f-b9f6251a5b8b
msgctxt "he0ee7861ge94cg4d6agaea2g27d91f231915"
msgid "He's so strong, and - and wise. And he rides a comet. A comet!"
msgstr "그분은 강하고, 또- 현명하고, 그리고 혜성을 타고 다니신대. 혜성을!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = 6c249242-8b51-724c-183e-d5b483d1c082
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:6c249242-8b51-724c-183e-d5b483d1c082
msgctxt "ha5a9defcg9ec7g452ag9aa0g841ae5805c67"
msgid "Oh, you saw that?"
msgstr "앗, 봤구나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = 6e499932-df54-0cc6-dbc4-e1fc4209205e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:6e499932-df54-0cc6-dbc4-e1fc4209205e
msgctxt "hedd2c421g67b2g4e67g82bfg627c70183d4a"
msgid "You endanger yourself by carrying this around. It must be disposed of."
msgstr "이걸 가지고 다니다간 분명 곤경에 빠질 날이 올 거야. 없애버리는 게 좋겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = 6ee66665-3cf2-7ae4-002d-324b4b66f68b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:6ee66665-3cf2-7ae4-002d-324b4b66f68b
msgctxt "h07ed599fg9251g4266gb9fbgbcf01722c0b4"
msgid ""
"Hand it over. Or should I tell your <i>sa'varsh</i> to come and confiscate "
"it?"
msgstr "얌전히 넘겨. 아니면 <i>사바쉬</i>한테 와서 압수해가라고 해볼까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = 73443468-2d8d-a7cc-3781-e0226a87969e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:73443468-2d8d-a7cc-3781-e0226a87969e
msgctxt "h312ee539g4af5g45f1g9757g89f1741be457"
msgid "<i>Wait! What if the sa'varsh can read my mind?!</i>"
msgstr "<i>잠시만! 사바쉬가 내 마음을 읽을 수 있으면 어쩌지?!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = 756c9530-3b20-40f5-06ff-6de7a80ac93e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Laezel_State_HasOrpheusChapter2(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:756c9530-3b20-40f5-06ff-6de7a80ac93e
msgctxt "hf0e6bd1agd574g4104g94f3g7445e9928e7c"
msgid "Are you sure about that? <i>Show him the book you stole.</i>"
msgstr "잘 갖고 있는 거 맞아? <i>훔친 기록을 보여줍니다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = 770a38e4-830c-c285-5cfb-d58355e5afdf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:770a38e4-830c-c285-5cfb-d58355e5afdf
msgctxt "h0e95e5f3g62e6g42c5g8324gca1bff11f901"
msgid ""
"Whatever. Take it. Read it. Maybe you'll learn how not to be a total "
"<i>shka'keth!</i>"
msgstr "됐어, 가져가 버려. 꼭 읽었으면 좋겠네. 완전 <i>쉬카케쓰</i>까진 되지 않는 방법을 배울지도 모르니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = 7796bc05-2fea-5352-d73f-37cc27edc8b8
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(1) = False
#.      - REALLY_GITHYANKI(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:7796bc05-2fea-5352-d73f-37cc27edc8b8
msgctxt "hfe6e0d03g06aag4f2eg8eeeg20a8bc07b2aa"
msgid "You endanger yourself by carrying this around. It must be disposed of."
msgstr "이걸 가지고 다니다간 분명 곤경에 빠질 날이 올 거야. 없애버리는 게 좋겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = 78c4f662-19d0-3fd7-38ea-796f54be5f32
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Laezel_State_HasOrpheusChapter2(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:78c4f662-19d0-3fd7-38ea-796f54be5f32
msgctxt "h30ba609ag64b3g4e68g822fg602262748dc9"
msgid "Like Orpheus? <i>Show the boy the chapter you stole.</i>"
msgstr "마치 오르페우스처럼? <i>훔친 기록물을 소년에게 보여줍니다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Narrator
#. NodeID = 7e3f3c7d-0542-0562-19d6-db26c6b5ba45
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_YouthTraining_HasMet_GithBoy(1) = False
#.   Global:
#.      - CRE_YouthTraining_State_PlayerHealedBoy = False
#.      - CRE_YouthTraining_State_BoyNonFatal = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:7e3f3c7d-0542-0562-19d6-db26c6b5ba45
msgctxt "h925a13c1gab9ag474eg8c42g7034de0d9b6f"
msgid ""
"*The boy is unconscious, the wound on his chest slowly bleeding him dry...*"
msgstr "*소년은 의식을 잃은 상태입니다. 가슴의 상처가 그를 서서히 죽음으로 이끌고 있군요...*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = 7ea51dc3-437d-fbf5-4a0d-c7c55401c14c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:7ea51dc3-437d-fbf5-4a0d-c7c55401c14c
msgctxt "hde8c052dg9ebag4c7cgadb2g97037d1c8991"
msgid "But nobody did. I must have the only copy."
msgstr "그런데 아무도 모르더라. 내가 가진 게 유일한 사본인가 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = 7ed7ec7f-bd8f-4c39-9294-23618c5210e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:7ed7ec7f-bd8f-4c39-9294-23618c5210e6
msgctxt "h513522c6gf36dg4a05g8fb5ga5ac923ace49"
msgid "You mean, you know who he is?"
msgstr "네 말은, 너도 그분을 아는 거니?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = 859806d3-c001-c41a-a3a1-6d62adbc6f69
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:859806d3-c001-c41a-a3a1-6d62adbc6f69
msgctxt "h3a6ad6f8ged8dg4e72g81b3g6d08a43a9570"
msgid "Yes, yes, very sad. Now about that payment you owe me..."
msgstr "그럼, 그럼, 정말 슬프구나. 그러면 이제 네가 갚아야 할 빚을 한번 따져볼까...."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = 886b7285-7d76-423d-b356-571cdfd3eba7
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 0
#. CheckFlags:
#.   Local:
#.      - 5a509344-b21e-16c1-5b8e-8e95a83fdb80_MindHasBeenRead = False
#.   Object:
#.      - ORI_Laezel_State_HasOrpheusChapter2(1) = False
#.   Script:
#.      - GEN_CanDetectThoughts_2 = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:886b7285-7d76-423d-b356-571cdfd3eba7
msgctxt "h7a0a6855gf9ceg4d00ga83cg6af20cb0bb4e"
msgid "<i>Seek the name the boy refuses to reveal. </i>"
msgstr "<i>소년이 말하려다 만 이름을 찾아봅니다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = 8d8d0c0d-8b7c-7bb7-8da4-88dbc42074e0
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: !GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:8d8d0c0d-8b7c-7bb7-8da4-88dbc42074e0
msgctxt "ha6f2827fgee1fg419ag9f3cg7b410b377662"
msgid ""
"And do you know what happens to outsiders who cause trouble in the crèche?"
msgstr "양성소에서 문제를 일으킨 외부인이 어떻게 되는지 알아?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = 93988595-dbe0-7c21-ae35-cd31e8040aca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:93988595-dbe0-7c21-ae35-cd31e8040aca
msgctxt "h4f0c26bag49bcg4df6gb122g4fb971e66fc8"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = 94151fea-33ce-ea14-08bc-e70afda6237c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:94151fea-33ce-ea14-08bc-e70afda6237c
msgctxt "h1bd5b711g4793g42a6g8b02g0960cb4086ab"
msgid ""
"I drew his symbol where I thought someone might see it and recognise it."
msgstr "그의 상징을 누구든 보고 알아챌 수 있을만한 곳에 그려놨거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = 99188c70-a0aa-f75a-ba3c-eccaaa7f354c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:99188c70-a0aa-f75a-ba3c-eccaaa7f354c
msgctxt "h049c134cg69f6g4fbfgbf2cg04e8e1fed287"
msgid ""
"Yes, you're right... There's more to it than just killing. There <i>has </"
"i>to be."
msgstr "그래, 네 말이 맞아... 목숨을 빼앗는 것만이 전부가 아니야. 확실해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = 9bf41d5a-9e13-0037-c207-f44000761caa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:9bf41d5a-9e13-0037-c207-f44000761caa
#, fuzzy
msgctxt "h1acc1b4fg9562g482cgba9cg6a98963055c5"
msgid "Discipline - a quality your teacher obviously failed to instil."
msgstr "규율이지. 네 스승이 박아넣으려다 실패한 품성이고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = 9f206630-af22-2f14-5a2d-7e22a8cbc158
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Laezel_State_HasOrpheusChapter2(0) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:9f206630-af22-2f14-5a2d-7e22a8cbc158
msgctxt "h92477d0dg0932g4053gbabcga162cb2f02a0"
msgid "I could talk about him, if you gave me your copy to read."
msgstr "네 걸 읽어보게 넘겨준다면 같이 얘기를 못 나눠줄 것도 없는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = a12e4a2c-8a47-03ed-dcdd-28b2474c4080
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:a12e4a2c-8a47-03ed-dcdd-28b2474c4080
msgctxt "h3c88d148g3bfbg4f29g9c11g440c642e8346"
msgid "Where did you get it? What's your favourite line?"
msgstr "어디서 났어? 제일 좋아하는 대사는 뭐야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = a2f7e035-9d1c-5af0-4d34-e5777ef518f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:a2f7e035-9d1c-5af0-4d34-e5777ef518f8
msgctxt "h2fb91a93g17c2g4ed3g916fg243c406b1a3c"
msgid "Sounds like quite the book. Can I have it?"
msgstr "상당히 좋은 기록인가 보네. 나한테 줄 수 있을까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = a35453f0-8a67-2c2c-68dc-feda7fb0d6c6
#. HandlePath = RollAdvantageReason
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 21
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(1) = False
#.      - BARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:a35453f0-8a67-2c2c-68dc-feda7fb0d6c6
msgctxt "hc26b077cg6c8ag4bc0g8835g084a746afb08"
msgid "Bard"
msgstr "그걸 나한테 주면, 그걸 바탕으로 멋진 이야기를 쓸 수 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = a35453f0-8a67-2c2c-68dc-feda7fb0d6c6
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 21
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(1) = False
#.      - BARD(1) = True
#. TagRule: !GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:a35453f0-8a67-2c2c-68dc-feda7fb0d6c6
msgctxt "h1c3273ebgc7edg4e37g893bgd85bdcc410e3"
msgid ""
"There's a powerful song to be written from this tale, if you'll let me have "
"it."
msgstr "이 이야기, 꽤 장엄한 노래가 탄생할 것 같은데. 기록을 양도해 줄 용의가 있으려나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = a35453f0-8a67-2c2c-68dc-feda7fb0d6c6
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 21
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(1) = False
#.      - BARD(1) = True
#. TagRule: GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:a35453f0-8a67-2c2c-68dc-feda7fb0d6c6
msgctxt "hc0e9e302g4f54g4db7g9c66g3ebae27cd821"
msgid ""
"There's a powerful song to be written from this tale, one our kin deserve to "
"hear."
msgstr "이 이야기, 꽤 장엄한 노래가 탄생할 것 같은데. 우리 종족이 꼭 들어봐야 할 명곡이 될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = a3ac73bb-37b1-b5b2-9f9b-a2c8445f4ef3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_YouthTraining_HasMet_GithBoy(1) = True
#.   Local:
#.      - 5a509344-b21e-16c1-5b8e-8e95a83fdb80_BoyGaveChapter2 = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:a3ac73bb-37b1-b5b2-9f9b-a2c8445f4ef3
msgctxt "h462f6c06gd4cfg4f24g8ee4g17e0774201d9"
msgid "Stop distracting me - I'm in enough trouble as it is!"
msgstr "방해하지 마! 이미 충분히 곤란한 상황이라고!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = a3eaf63a-0d61-4346-297e-618dc0fea2db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:a3eaf63a-0d61-4346-297e-618dc0fea2db
msgctxt "h7de00591g8544g4008ga64ag068424c4fdb7"
msgid "Where did you get this book?"
msgstr "어디서 구한 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = a67d8bd1-bbb2-a5f0-3cb7-4fdeb9cc7e90
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: !GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:a67d8bd1-bbb2-a5f0-3cb7-4fdeb9cc7e90
msgctxt "hc88a40ffg5632g4473gab4ag47350db4a971"
msgid ""
"Morality is complex, <i>istik</i>, but I will keep trying to understand it. "
"To understand him."
msgstr "도덕이란 건 참 어려운 말이지, <i>이스틱</i>. 그래도 난 계속 이해하려 해볼 거야. 그분을 이해하고 싶으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = a67d8bd1-bbb2-a5f0-3cb7-4fdeb9cc7e90
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:a67d8bd1-bbb2-a5f0-3cb7-4fdeb9cc7e90
msgctxt "h758b4680gfdd9g4878g9b3dg5c8dc8bbd07c"
msgid ""
"Morality is complex, <i>jhe'stil</i>, but I will keep trying to understand "
"it. To understand him."
msgstr "도덕이란 건 참 어려운 말이지, <i>제스틸</i>. 그래도 난 계속 이해하려 해볼 거야. 그분을 이해하고 싶으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = a6b846f8-c250-614d-5f0d-58de8cb15785
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: !()
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:a6b846f8-c250-614d-5f0d-58de8cb15785
msgctxt "h064ec737gb66dg47b9gb010g759aa73b46b5"
msgid ""
"I found his book... Part of it, anyway. I read it all the time. He's "
"unbelievable."
msgstr "그분에 관한 기록을 찾았는데 말야... 일부이긴 한데, 아무튼. 이걸 매일 읽고 있거든. 정말 대단한 분이셔."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = a88bf59a-a331-c3cc-7234-95c0f21aaf28
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - CRE_YouthTraining_HaveTwoOrpheusChapters = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:a88bf59a-a331-c3cc-7234-95c0f21aaf28
msgctxt "h211b7214g411cg45b3g8239g67237ad3fed0"
msgid "<i>Show him one of the chapters you found.</i>"
msgstr "<i>당신이 찾은 기록 중 하나를 보여줍니다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = a9711b23-09ee-439e-f52b-6e6d0a32484f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Laezel_State_HasOrpheusChapter2(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:a9711b23-09ee-439e-f52b-6e6d0a32484f
msgctxt "hbe92bf04gbe6cg4398ga9bdg9a3d6a93b4ef"
msgid "Without this? <i>Show the boy the chapter you stole.</i>"
msgstr "이거 없이? <i>훔친 기록물을 소년에게 보여줍니다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = ab0455c0-afe2-8ac3-4dcf-e37fa98b6dc5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:ab0455c0-afe2-8ac3-4dcf-e37fa98b6dc5
msgctxt "he741be34g3b5ag4669g8069gf1798b4c7552"
msgid "Nice try. You just want the book for yourself."
msgstr "꽤 그럴싸했어. 이게 그렇게나 탐났나 보지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = ac62330b-6c16-a128-2144-31c563719fd9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:ac62330b-6c16-a128-2144-31c563719fd9
msgctxt "h383e2298g40b3g4a9fg8397g6e4e81fd3318"
msgid "No, that wasn't me!"
msgstr "어? 나 아닌데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = ace1677e-2b3b-2585-bf16-e3d60e8d5e17
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:ace1677e-2b3b-2585-bf16-e3d60e8d5e17
msgctxt "h462c9805g94afg45f3g8620g82072656a90f"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = aceed7ec-991e-8d59-5214-d89e5dc10312
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:aceed7ec-991e-8d59-5214-d89e5dc10312
msgctxt "hb7c86501gf801g4d69g95e9gbbf7e2dba441"
msgid ""
"Sa'varsh Kethk made us clean their armour and... I found it, inside one of "
"the breast plates."
msgstr "사바쉬 케스크가 그들의 갑옷을 닦으라 지시했고... 흉갑 중 하나에서 발견했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = add79642-4c21-c675-6bfc-cb85210c09d8
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:add79642-4c21-c675-6bfc-cb85210c09d8
msgctxt "h461dbd89g19d8g47e7gbfd1g0f225f0e35ad"
msgid ""
"Just like who? If there's a like-minded soul here, I'd love to meet them."
msgstr "마치 뭐? 여기 나랑 비슷한 생각을 하는 사람이 있다면 꼭 만나보고 싶네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = aea3f436-8781-5d9d-9152-e626ac860d5f
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 21
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(1) = False
#.      - BARD(1) = False
#. TagRule: !GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:aea3f436-8781-5d9d-9152-e626ac860d5f
msgctxt "h6d076180g7d59g4890ga3a8g668be5ca58ff"
msgid ""
"This story deserves to be told, and stir the hearts of others as it has "
"yours."
msgstr "이건 다른 이들도 감명받을 수 있게끔 널리 퍼져야 마땅한 이야기라고. 네가 그랬듯이 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = aea3f436-8781-5d9d-9152-e626ac860d5f
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 21
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(1) = False
#.      - BARD(1) = False
#. TagRule: GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:aea3f436-8781-5d9d-9152-e626ac860d5f
msgctxt "h60fcf0beg5c0ag4fe3g86f9g9689bef4d983"
msgid ""
"This story deserves to be told, and stir the hearts of our kin as it has "
"yours."
msgstr "이건 우리 종족이 감명받을 수 있게끔 널리 퍼져야 마땅한 이야기라고. 네가 그랬듯이 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = b31ff73b-9cdc-2e42-6a04-0277282710e0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_State_ReadOrpheusChapter3 = True
#.   Object:
#.      - ORI_Laezel_State_HasOrpheusChapter3(1) = True
#.      - ORI_Laezel_State_HasOrpheusChapter1(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:b31ff73b-9cdc-2e42-6a04-0277282710e0
msgctxt "h54a570cbgf45dg40e8gbf09g9fa8ebad1f64"
msgid "<i>Show him the chapter you found.</i>"
msgstr "<i>당신이 찾은 기록을 보여줍니다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = b450ff32-61b0-1c94-d106-cc999229444d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:b450ff32-61b0-1c94-d106-cc999229444d
#, fuzzy
msgctxt "h6922de6bgf6a7g411ag95f7g35215d6dadd1"
msgid ""
"You... You think so? What... what <i>does </i>it mean to be a warrior, then?"
msgstr "그... 그렇게 생각해? 그렇다면... <i>무엇</i>이 전사를 만드는 걸까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = b53b0b7f-b4d1-b4d2-285e-acb81535ae78
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:b53b0b7f-b4d1-b4d2-285e-acb81535ae78
msgctxt "h06ec95fag4977g454cgb323gee5252ac6772"
msgid "Besides, I - I don't have it with me. So I can't."
msgstr "게다가, 그건 나한테 없어. 그러니 못 주겠네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = bc7f48b2-0593-6d0b-adc0-f7357c56844b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:bc7f48b2-0593-6d0b-adc0-f7357c56844b
msgctxt "h924960c2g5287g4afcg9233g0e9c2f10f725"
msgid "I'm sorry. I will not fail him again. <i>Vlaakith gha'g shkath zai!</i>"
msgstr "잘못했어. 교관님을 다신 실망시키지 않을게. <i>블라키스 가그 슈카스 자이!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = bc839b4e-e615-6d23-806d-334aba86a87c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_General_State_SawOrpheusSymbolOnPortrait = True
#.   Tag:
#.      - REALLY_GITHYANKI(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:bc839b4e-e615-6d23-806d-334aba86a87c
msgctxt "h8fed61f2g735dg4b4bg8457gfd3696f8d487"
msgid "'Comet' you say? Like the one drawn on the portrait of Vlaakith?"
msgstr "'혜성'이라고? 블라키스의 초상화에 그려져 있던 그거?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = bf428e18-1704-4d58-8a08-85682014b7e8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_6 = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:bf428e18-1704-4d58-8a08-85682014b7e8
msgctxt "hb2eaacecgcb61g4181g8094g0e49cc5fe9ba"
msgid ""
"I hope they write stories about you one day, <i>ra'stil.</i> I would tell "
"them proudly."
msgstr "언젠가 사람들이 네 일대기를 적을 날이 오길 바라, <i>라스틸</i>. 그때는 자랑스럽게 네 얘기를 전해줄 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = c21ea77b-6b42-e08e-d92d-cc517565b3a2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - RANGER(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:c21ea77b-6b42-e08e-d92d-cc517565b3a2
#, fuzzy
msgctxt "h802b8de8gab6eg4babgaa90gbb8f05b2e277"
msgid ""
"Empathy is a tool in any good hunter's arsenal - no different to a notched "
"arrow."
msgstr "공감은 훌륭한 사냥꾼이 구비해두는 수단이지. 메겨진 화살과 별다를 바 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = c353b324-7cca-9b32-b63f-40b4d68217fd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:c353b324-7cca-9b32-b63f-40b4d68217fd
msgctxt "hc01cb132g2697g43e0gbecbgfac7874e8bba"
msgid ""
"If I refuse to kill, but get myself killed in the process then I still "
"failed to prevent a death."
msgstr "만약 상대를 죽이지 않더라도, 그 과정에 내가 죽으면 나는 여전히 죽음을 막는데 실패한 거잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = c3fc11f1-4926-ef70-42d8-f6cfc92fc676
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:c3fc11f1-4926-ef70-42d8-f6cfc92fc676
msgctxt "h1ea1ae10ga0f3g4667g8c73g61ec2eaf8f15"
msgid "Make sure you tell it right. Don't leave anything out!"
msgstr "제대로 전해야 해. 아무것도 빠트리지 말고!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = c80adad5-e41f-ae38-7632-74540b41b49d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - CRE_YouthTraining_HaveOneOrpheusChapter = True
#.      - CRE_YouthTraining_HaveTwoOrpheusChapters = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:c80adad5-e41f-ae38-7632-74540b41b49d
msgctxt "h0fa88ccdge58fg4b6fgb3feg4c9717e13cf6"
msgid "<i>Show him the chapter you found.</i>"
msgstr "<i>당신이 찾은 기록을 보여줍니다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = cae7984e-cc47-9fc3-8955-93cf6fe838a8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_General_State_SawOrpheusSymbolOnPortrait = True
#.   Tag:
#.      - GITHYANKI(1) = True
#.      - REALLY_GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:cae7984e-cc47-9fc3-8955-93cf6fe838a8
msgctxt "h8b3efd72g8702g4a77g9ecfg39866142d6ce"
msgid ""
"So you're the <i>k'chakhi</i> who defaced our queen's portrait with this "
"symbol."
msgstr "그렇다면 우리 여왕님의 초상화를 이깟 상징으로 더럽힌 <i>크차키</i>가 너겠구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = d06951ed-38df-2f56-44d7-6d46c4db9d81
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:d06951ed-38df-2f56-44d7-6d46c4db9d81
#, fuzzy
#| msgid "A capacity for mercy is what seperates us from feral beasts. "
msgctxt "h2a3b74b8g8f12g4204g815bg9a3e68163e6c"
msgid "A capacity for mercy is what separates us from feral beasts."
msgstr "자비를 베풀 줄 안다는 것이 우리와 야수의 차이점이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = d1392187-61c8-4ff4-a2d6-921bf9611046
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:d1392187-61c8-4ff4-a2d6-921bf9611046
msgctxt "h98233de7g1973g4cb7g8505g992acfc108f2"
msgid "You - you've heard of him too?"
msgstr "너- 너도 그분에 대해 들어봤구나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = d159831e-c420-801f-0856-e3e48a20b906
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:d159831e-c420-801f-0856-e3e48a20b906
msgctxt "h23d84631ge267g4d6dga3d3gc5b645800787"
msgid "There's nobody here like you. Trust me."
msgstr "여기 너 같은 사람은 아무도 없어. 믿어도 좋아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = d30b0600-ebbd-73bb-88c1-e7b31c38f3ee
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: !()
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:d30b0600-ebbd-73bb-88c1-e7b31c38f3ee
msgctxt "hf68fd91bg16bag4d79gad52g25f61e85ff73"
msgid "A group of warriors came. Outsiders, on a mission for Vlaakith herself."
msgstr "전사들이 방문했어. 블라키스 님을 위한 임무를 수행 중이었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = d386cfb3-0a11-24f1-fc1b-ed1980af462c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:d386cfb3-0a11-24f1-fc1b-ed1980af462c
msgctxt "h0bdf4294gc719g4210g80bfg9848f069908b"
msgid ""
"It wasn't a kindness. Vlaakith needs every sword against the <i>ghaik</i>, "
"even yours."
msgstr "친절을 베푼 게 아니다. 블라키스는 <i>게이크</i>에 대항할 검이 필요하니, 너 같은 놈이라도 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = d3b95221-68c5-965f-289c-32194b4b99e0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:d3b95221-68c5-965f-289c-32194b4b99e0
msgctxt "h1cbcf196g021fg4b36g9615g4f66d1284bbe"
msgid "I don't have anything to give you. I'm just a hatchling."
msgstr "너한테 줄 만한 건 없어. 난 그저 갓난 아이일 뿐이라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = d3be2490-3b65-bd94-7d83-207decb889e7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_Knows_HowToUnlockOrpheusChapters = True
#.   Local:
#.     - 5a509344-b21e-16c1-5b8e-8e95a83fdb80_BoyGaveChapter2 = True
#.   Object:
#.     - CRE_YouthTraining_Event_GiveOrpheusChapter2(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:d3be2490-3b65-bd94-7d83-207decb889e7
msgctxt "hbdd92370gd150g4f9dg9abag04db1efdc3e0"
msgid "A song? That would be so cool! Here - take it."
msgstr "노래라고? 완전 멋있는 생각이야! 자, 가져가."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = d3c78cae-7ed6-8e7f-b50a-b4efec6df6f6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:d3c78cae-7ed6-8e7f-b50a-b4efec6df6f6
msgctxt "h0adc0988g1102g4545g91c5gdfc7c91ddeff"
msgid ""
"Now please, I need to get these swords sharpened, or <i>sa'varsh</i> will "
"sharpen them on me."
msgstr "그럼 난 이만, 이 칼들을 갈아놔야 해서. 아니면 <i>사바쉬가</i> 나를 숫돌로 써버릴 테니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Lae'zel
#. NodeID = d6adc5fe-13a7-4342-8c5d-fb95c021677b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:d6adc5fe-13a7-4342-8c5d-fb95c021677b
msgctxt "ha57298f2geaccg4364gb3c1gf3fb5e62ef0e"
msgid ""
"Are you mad? This <i>legend</i> is a heresy to my Queen. Merely uttering his "
"name is enough to tempt a violent fate."
msgstr ""
"제정신이냐? 이 <i>전설</i>은 여왕님의 신성을 모독하는 것이다. 그 이름을 입 밖에 내기만 해도 끔찍한 운명을 불러오기엔 충분하단 "
"말이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = d7b88a57-a6f3-10d2-45a4-ed26eaa64a5e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:d7b88a57-a6f3-10d2-45a4-ed26eaa64a5e
msgctxt "hc2bf8641g2c1bg4ae4gb77cg980680ffc3a5"
msgid ""
"Oh. Okay. Fine. I thought you might have been different. More like "
"<i>him</i>."
msgstr "아. 그래. 그렇구나. 너만은 다를 줄 알았는데, <i>교관</i>보다 더한 놈이었네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = d80639c6-9afa-af5d-8527-c137eefa0fc3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_State_ReadOrpheusChapter3 = True
#.      - ORI_Laezel_State_ReadOrpheusChapter1 = True
#.   Object:
#.      - ORI_Laezel_State_HasOrpheusChapter3(1) = True
#.      - ORI_Laezel_State_HasOrpheusChapter1(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:d80639c6-9afa-af5d-8527-c137eefa0fc3
msgctxt "h50eb0e82g6cb2g4028ga642g635392bde83a"
msgid ""
"Have a look at one of my chapters. Perhaps you can find some answers in "
"there."
msgstr "내가 가진 기록도 하나 읽어봐. 거기서 답을 찾을지도 모르잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = d8945da7-039a-deba-f4c4-3cabf202bc9e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:d8945da7-039a-deba-f4c4-3cabf202bc9e
msgctxt "hd0e7747dgc0d3g4f86g9c3fga01e6eeb3ea9"
msgid ""
"It was an honour to carry his words so close to my heart. <i>Raz'erai'ka "
"tavkim krash'ht.</i>"
msgstr "그분의 말씀을 소중히 간직할 수 있어서 영광이었어. <i>라제라이카 타브킴 크라시트</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = d909fe69-7fe9-5e33-4df4-ae55eac868df
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:d909fe69-7fe9-5e33-4df4-ae55eac868df
msgctxt "hae09c5a6g809bg4c48g8de6g58b442d3922d"
msgid "No... No. I'm sorry. I can't. It's too dangerous!"
msgstr "아... 아냐, 미안해. 알려줄 수 없어. 큰일 날 거라고!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = d91cca60-a5a2-ecea-c05e-6d282ea4d4a6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Laezel_State_HasOrpheusChapter3(1) = False
#.      - ORI_Laezel_State_HasOrpheusChapter1(1) = False
#.      - ORI_Laezel_State_HasOrpheusChapter2(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:d91cca60-a5a2-ecea-c05e-6d282ea4d4a6
msgctxt "hed4c13ecg23a8g42a4g964egc269afdd8bb8"
msgid ""
"You're right. I don't care about Orpheus. But the book is probably worth a "
"good amount of coin. <i>Show him the book you stole.</i>"
msgstr "맞아. 오르페우스는 내 관심사가 아니지. 그런데 이 기록은 돈이 꽤 될 것 같은걸. <i>당신이 훔친 기록을 보여줍니다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = da23320a-f660-b6d1-f1aa-e652ea6590c3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_YouthTraining_HasMet_GithBoy(1) = True
#.   Local:
#.      - 5a509344-b21e-16c1-5b8e-8e95a83fdb80_BoyGaveChapter2 = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:da23320a-f660-b6d1-f1aa-e652ea6590c3
msgctxt "h65ad7948g6970g44a6gad3cgce23aad21024"
msgid ""
"I can't say any more, the <i>sa'varsh </i>might hear. Now please, let me "
"finish my work!"
msgstr "더 말하긴 힘들 것 같아. <i>사바쉬</i>가 들을지도 모른다고. 이제 그만 날 내버려 둬!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = da65e295-9eaa-ad1f-1916-91bfb22bfda4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:da65e295-9eaa-ad1f-1916-91bfb22bfda4
msgctxt "ha173a321gc954g4d40g80c8g41920448b663"
msgid ""
"You're lying to me! Orpheus' words don't belong in the hands of someone so "
"dishonest."
msgstr "거짓말이지! 오르페우스 님의 말씀을 너 같은 거짓말쟁이가 가지고 있을 리 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = dd7c4348-1a68-8953-3741-b88f5363eb8e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:dd7c4348-1a68-8953-3741-b88f5363eb8e
msgctxt "h587b4c0dg3026g42a6ga163geb4c01c34f0a"
msgid "No one taught me. Not exactly."
msgstr "딱히 누가 알려주신 건 아냐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = ddaceb44-43f7-6438-5ae0-503d8f6480b0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_YouthTraining_HasMet_GithBoy(1) = False
#.   Global:
#.      - CRE_YouthTraining_State_BoySpared = True
#.      - CRE_YouthTraining_State_BoyNonFatal = False
#. SetFlags:
#.   Dialog:
#.     - CRE_YouthTraining_HasMet_GithBoy(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:ddaceb44-43f7-6438-5ae0-503d8f6480b0
msgctxt "hf28eaf81g3106g47f9gb58cgb62e043cffd8"
msgid ""
"That was amazing. I've never seen someone talk the<i> sa'varsh</i> down from "
"a rage like that."
msgstr "정말 대단했어. 저렇게나 화난 <i>사바쉬를</i> 말로 진정시키는 사람이 있을 줄이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = dede2810-ccc9-92af-c359-61b8fa3b8d39
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:dede2810-ccc9-92af-c359-61b8fa3b8d39
msgctxt "h56a796c7gb30bg408eg856dg978c96f2e66d"
msgid "Thank you, <i>ra'stil</i>. <i>Raz'erai'ka tavkim krash'ht.</i>"
msgstr "고마워, <i>라스틸</i>. <i>라제라이카 타브킴 크라시트.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = e1101d85-e696-f830-da27-990eeb207448
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:e1101d85-e696-f830-da27-990eeb207448
msgctxt "ha4f6e6b5gb68eg482fga5a0g1ccbcd542fe5"
msgid "It's so stupid we can't read it. It's just a story, it's not even true."
msgstr "소설조차 읽지 못하게 하다니, 이렇게 멍청할 데가. 실제 있었던 일도 아니잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = e2a7a69b-f77a-b405-534c-0a36ae6d3c6b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:e2a7a69b-f77a-b405-534c-0a36ae6d3c6b
msgctxt "h6fee279cg06dfg42bdg8206gc80f638ed9ad"
msgid "You want... but I... I..."
msgstr "네가 갖고싶... 그치만... 내..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = e4d73b7a-e2d7-fa15-5dad-d99f0e8ed61e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:e4d73b7a-e2d7-fa15-5dad-d99f0e8ed61e
msgctxt "h3fc5bf32g4200g4409ga07eg1f0c483daa15"
msgid "What is it? Is this... another part of the book?!"
msgstr "뭔데? 이건... 기록의 다른 장이잖아?!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = e7180911-9b29-6cee-0881-10f0946d17a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:e7180911-9b29-6cee-0881-10f0946d17a6
msgctxt "hf7d4f3b9g9afag436ega80cgcb3c336c0adb"
msgid "I've been reading about - about Orpheus. The true prince."
msgstr "기록을 읽어봤어... 진정한 왕자이신 오르페우스 님에 대해서 적혀있었지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Wyll
#. NodeID = e8df8520-5582-4cc0-993f-c0647fa44958
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_6 = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:e8df8520-5582-4cc0-993f-c0647fa44958
msgctxt "hd18db80dgb8f5g4212ga6a1gd8edace5b22a"
msgid "Well now - seems I'm in the presence of a gith legend in the making!"
msgstr "이것 참 - 아무래도 내가 기스 전설이 만들어지는 현장에 있는 것 같군!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = ed1ee9e6-3fdd-b904-12a6-5d9a32852bc6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:ed1ee9e6-3fdd-b904-12a6-5d9a32852bc6
msgctxt "h1eeb51f7g19a8g4a99g8cbbg7567cb1223ab"
msgid ""
"I thought maybe I'd find a friend who'd want to talk about Orpheus. But "
"nobody here cares about him."
msgstr "오르페우스 님에 관해 얘기할 수 있는 친구를 찾을 수 있으리라 생각했거든. 그런데 아무도 관심이 없나 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = ee4c6360-7dba-c7be-7056-e83692aa382d
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: !GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:ee4c6360-7dba-c7be-7056-e83692aa382d
msgctxt "hc7b6b5cfg6ab9g4096gbee6g958093b56d7d"
msgid ""
"We're forbidden to talk about him. They say Vlaakith knows if you even "
"<i>think</i> his name."
msgstr "그분과 관련된 말을 꺼내선 안 돼. 이름만 <i>떠올려도</i> 블라키스가 알아챌 거라고들 하거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = ee4c6360-7dba-c7be-7056-e83692aa382d
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:ee4c6360-7dba-c7be-7056-e83692aa382d
msgctxt "h822d57e1gef72g44ddg985cg4d6d42f077fa"
msgid ""
"I know we're forbidden to talk about him. They say Vlaakith can hear you "
"<i>think</i> his name."
msgstr "그분과 관련된 말을 꺼내선 안 된다는 걸 나도 알아. 이름을 <i>떠올리면</i> 블라키스가 알아챌 거라고들 하니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = ef1ad03e-2aa1-47c4-91f3-06b328fd008d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:ef1ad03e-2aa1-47c4-91f3-06b328fd008d
msgctxt "h5462100eg417bg4659g828eg17c535527e0b"
msgid "What are you - are you trying to read my mind?"
msgstr "뭐 하는 - 지금 내 생각을 읽으려고 한 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = f0ca2b1c-11e4-25b6-2e67-90d45f6c3ac7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:f0ca2b1c-11e4-25b6-2e67-90d45f6c3ac7
msgctxt "hfdcb7bbfga4b5g42d2ga56agd9e2310442dc"
msgid "Maybe I could write my own song about him..."
msgstr "어쩌면, 그분에 대한 노래를 직접 쓸 수 있을지도 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = f12dad90-3ad6-ed9b-e538-20d398107c2a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Laezel_State_HasOrpheusChapter2(0) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:f12dad90-3ad6-ed9b-e538-20d398107c2a
msgctxt "h54193ee8g4277g4fadgbb40ga1365fc710cf"
msgid ""
"I wish I knew who it belonged to - I have so many questions! Hopefully one "
"day I'll find them."
msgstr "나도 이게 누구 것인지 알고 싶어, 너무 궁금한 게 많다고! 언젠가 그들을 만날 수 있길."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = f593aaaa-7148-e8b5-43ce-99a8c253c524
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#. CheckFlags:
#.   Object:
#.      - ORI_Laezel_State_HasOrpheusChapter2(0) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:f593aaaa-7148-e8b5-43ce-99a8c253c524
msgctxt "h5c1a20a3ge969g480ega7f7gb6f6835a5d47"
msgid "Tell me, who teaches you to question yourself so?"
msgstr "혹시, 네가 그런 식으로 자문할 수 있게끔 가르쳐준 사람이 있나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = f7baf974-6322-48fb-b2b0-adf2e0df17a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:f7baf974-6322-48fb-b2b0-adf2e0df17a5
msgctxt "h87d7efe4geaf5g4992g9479gb6594e6e2e25"
msgid "I've already said too much. Please, don't mention his name again."
msgstr "이미 너무 많은 말을 한 것 같지만. 부탁할게, 더 이상 그분의 이름을 언급하지 말아줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = f847ef70-e319-bb2b-e3c3-07180e83cf0f
#. HandlePath = RollAdvantageReason
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(1) = False
#.      - REALLY_GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:f847ef70-e319-bb2b-e3c3-07180e83cf0f
msgctxt "h3af36e2egdfdfg4f74g86fcg9b183986643e"
msgid "Githyanki"
msgstr "그 책은 내 것이다. <i>빈'이식</i>, 내게 돌려주도록."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = f847ef70-e319-bb2b-e3c3-07180e83cf0f
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(1) = False
#.      - REALLY_GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:f847ef70-e319-bb2b-e3c3-07180e83cf0f
msgctxt "hcb99235eg06dag433ag9f5egaf8fc850454c"
msgid "That book belongs to me, <i>vin'iisk</i>. Give it back."
msgstr "그 기록은 내 거야, <i>비니스크</i>. 돌려줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = f861809b-8b57-21f6-8f73-8d68597c7b98
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = False
#. TagRule: !()
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:f861809b-8b57-21f6-8f73-8d68597c7b98
msgctxt "h2d78c33eg3c48g4de9g9182g748d41c7657b"
msgid "Hand it over. Or should I tell your captain to come and confiscate it?"
msgstr "얌전히 넘겨. 아니면 너희 대장한테 와서 압수해가라고 해볼까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = fade5ab8-2d12-fef2-03da-0d43cca46fc9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:fade5ab8-2d12-fef2-03da-0d43cca46fc9
msgctxt "h1eca8392g04e5g498ag9805gef6be1a68f5a"
msgid "How did you get the book, if not from someone here?"
msgstr "기록을 여기 사람한테서 얻은 게 아니라니, 어떻게 구한 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Player
#. NodeID = fbb60491-3b4e-f65f-c0b2-5d91996af2aa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:fbb60491-3b4e-f65f-c0b2-5d91996af2aa
msgctxt "h23f2a897g2364g4170ga25fg5746a9917463"
msgid ""
"Hand it over. Or should I tell your <i>sa'varsh</i> to come and confiscate "
"it?"
msgstr "얌전히 넘겨. 아니면 <i>사바쉬</i>한테 와서 압수해가라고 해볼까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = fd111097-629c-945e-a50e-ecc361531b33
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:fd111097-629c-945e-a50e-ecc361531b33
msgctxt "h8be5c004g72dcg464bgacf6gbfbb37f60be2"
msgid ""
"Nobody does. But I've seen <i>Kith'rak </i>Therezzyn's wolves chewing on the "
"leftovers. So keep quiet."
msgstr "아무도 모를거야. 하지만 난 <i>키스락</i> 테레진이 키우는 늑대가 유해 같은걸 씹는 모습을 봤지. 그러니 다물고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy
#. Speaker = Youth Varrl
#. NodeID = ff33fdeb-c2e0-ff39-552e-14b34db47ea6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy:ff33fdeb-c2e0-ff39-552e-14b34db47ea6
msgctxt "h50cd6692gc946g4f29g97abgbd0b55c7e390"
msgid "Is that... mine? You stole it from me?"
msgstr "뭐야 그거... 내 거야? 내 걸 훔쳐 간 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy_Dead
#. Speaker = Player
#. NodeID = 0f5c39d6-60d5-48dc-a5fc-5aec8113784b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_OrpheusChapters_State_ReadOrpheusChapter2 = True
#.   Local:
#.      - 1d7a6554-1938-70c1-d9f4-c115c4b6d354_AskedAboutOrpheus = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy_Dead:0f5c39d6-60d5-48dc-a5fc-5aec8113784b
msgctxt "hfa8ba717gb1a7g41b8g89d0gf2be518eb0a1"
msgid "How did you find out about Orpheus?"
msgstr "오르페우스를 어떻게 알게 됐지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy_Dead
#. Speaker = Player
#. NodeID = 13c5f73e-396d-416b-a8e3-5aa1dbea8d5e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy_Dead:13c5f73e-396d-416b-a8e3-5aa1dbea8d5e
msgctxt "h92bb2a8ega68cg4c95g8b09g17ed94796b29"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy_Dead
#. Speaker = Narrator
#. NodeID = 2d0a5a84-96de-4f9a-8225-4f80f50cff5c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy_Dead:2d0a5a84-96de-4f9a-8225-4f80f50cff5c
msgctxt "h6240868cg136cg4be8g81bag65ddca15f31f"
msgid "*The corpse remains silent. It does not know.*"
msgstr "*시체가 침묵을 유지합니다. 알지 못합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy_Dead
#. Speaker = Youth Varrl
#. NodeID = 3112698a-9e88-4b78-84ac-3b04fb798a29
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 1d7a6554-1938-70c1-d9f4-c115c4b6d354_LearnedOrpheusForbidden = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy_Dead:3112698a-9e88-4b78-84ac-3b04fb798a29
msgctxt "hdcdfaacfga1f0g410bgb66cge7c02758dab4"
msgid "Vlaakith... threatens... punishes..."
msgstr "블라키스... 위협한다... 처벌한다..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy_Dead
#. Speaker = Player
#. NodeID = 31fc7f39-bf09-fd27-84c7-f1d0148a898f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_OrpheusChapters_State_ReadOrpheusChapter2 = True
#.   Local:
#.      - 1d7a6554-1938-70c1-d9f4-c115c4b6d354_LearnedOrpheusForbidden = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy_Dead:31fc7f39-bf09-fd27-84c7-f1d0148a898f
msgctxt "h9f8884a4g1c8eg45bfg9405g169a09301b58"
msgid "Do others here read the Orpheus stories?"
msgstr "여기 있는 다른 이들도 오르페우스 이야기를 읽었나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy_Dead
#. Speaker = Player
#. NodeID = 3268f812-07fb-4861-9fe6-a45f2c6e992b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_OrpheusChapters_State_ReadOrpheusChapter2 = True
#.   Local:
#.      - 1d7a6554-1938-70c1-d9f4-c115c4b6d354_AskedAboutOrpheus = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy_Dead:3268f812-07fb-4861-9fe6-a45f2c6e992b
msgctxt "h9ae8d4a2gb3e8g4968g8713gda79683e583a"
msgid "Do others here believe in Orpheus?"
msgstr "여기 있는 다른 이들도 오르페우스를 믿나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy_Dead
#. Speaker = Player
#. NodeID = 37ce8071-4851-4fd8-b8e0-40fee5f188b2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_OrpheusChapters_State_ReadOrpheusChapter2 = True
#.   Local:
#.      - 1d7a6554-1938-70c1-d9f4-c115c4b6d354_AskedAboutOrpheus = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#.   Tag:
#.      - REALLY_GITHYANKI(1) = False
#. SetFlags:
#.   Local:
#.     - 1d7a6554-1938-70c1-d9f4-c115c4b6d354_BoyMentionedVlaakith = True
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy_Dead:37ce8071-4851-4fd8-b8e0-40fee5f188b2
msgctxt "hadfc4c1fg4ef5g4253gb838g14c885aebe2b"
msgid "Why is he forbidden?"
msgstr "오르페우스는 왜 금지되었지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy_Dead
#. Speaker = Youth Varrl
#. NodeID = 3a44a398-3927-dc86-5555-02ebcc73278a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy_Dead:3a44a398-3927-dc86-5555-02ebcc73278a
msgctxt "h2dc30c44g6dc9g4487g911egd67327ec49b2"
msgid "Refused to kill... cut down by stranger..."
msgstr "죽이기를 거부했다...이방인에게 죽었다..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy_Dead
#. Speaker = Youth Varrl
#. NodeID = 4207122d-bedf-1c4e-621a-10bdee931af6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy_Dead:4207122d-bedf-1c4e-621a-10bdee931af6
msgctxt "hce78b300g3692g42d7g94e0g1d971ea22ef9"
msgid "...everything... I tried not to be..."
msgstr "...하고 싶지 않아 했던...모든 것..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy_Dead
#. Speaker = Youth Varrl
#. NodeID = 5648072e-0c0b-1e2e-57da-e4361570557b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy_Dead:5648072e-0c0b-1e2e-57da-e4361570557b
msgctxt "h62b01a76gbed2g4f01gbdd0ga0c1e8b33013"
msgid "...believer... in the true prince..."
msgstr "...진짜 왕자를...믿는 자..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy_Dead
#. Speaker = Player
#. NodeID = 68ffbe59-1880-304b-e7cc-d623b9f3b7d9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 1d7a6554-1938-70c1-d9f4-c115c4b6d354_AskedWhatHappened = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#.      - CRE_YouthTraining_State_BoyKilledAccidentallyByPlayer(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy_Dead:68ffbe59-1880-304b-e7cc-d623b9f3b7d9
msgctxt "h0f63a0f8ge5c3g4f66gbb7cg2e854079ba19"
msgid "About that. My friend wants to apologise. For accidentally killing you."
msgstr "그거 말인데. 내 친구가 사과하고 싶어해. 실수로 널 죽인 걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy_Dead
#. Speaker = Youth Varrl
#. NodeID = 70f1875d-9784-488c-7318-1ca3b3e5e1fd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_YouthTraining_Knows_BoyWasReadingOrpheus = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy_Dead:70f1875d-9784-488c-7318-1ca3b3e5e1fd
msgctxt "h9f67b2b1g8850g4ac3ga7e0g17de48ba3604"
msgid "Orpheus... inspiration... gives me hope..."
msgstr "오르페우스... 영감... 내게 희망을 준다..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy_Dead
#. Speaker = Youth Varrl
#. NodeID = 72422def-2726-4454-a297-18c593596fe9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy_Dead:72422def-2726-4454-a297-18c593596fe9
msgctxt "h41ecd754g3ae8g4d2cg9554g547aed95758d"
msgid "Armour... Voss' warriors... hidden inside..."
msgstr "갑옷... 보스의 전사들... 안에 숨겨진..."

