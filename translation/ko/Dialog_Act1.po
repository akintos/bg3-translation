#.      - GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointWarning:0b1521b1-c5cc-2cdd-e427-7f59f9076443
msgctxt "h66f02c28gd541g409cg83b3g82da469d4fdb"
msgid "Hold, kin. State your purpose. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointWarning
#. Speaker = Player
#. NodeID = 2eed0628-dba0-4722-96ca-f0204ea8c4c7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointWarning:2eed0628-dba0-4722-96ca-f0204ea8c4c7
msgctxt "h840a14f5g9a93g4877ga3feg01e440b0c68b"
msgid "Sorry, didn't meant to intrude. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointWarning
#. Speaker = Warrior Qen
#. NodeID = 41f3d248-853f-4d8d-918e-3d18773645c8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_UpperGuards_State_HiddenPrimaryGuardDefeated = False
#.      - CRE_UpperGuards_State_GainedAccess = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointWarning:41f3d248-853f-4d8d-918e-3d18773645c8
msgctxt "h8b2c348cg513dg4c12g9d70g5dedc28613ef"
msgid "You! Trespasser! Get back. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointWarning
#. Speaker = Warrior Qen
#. NodeID = 4ac55a26-5fd2-815b-199f-0d533f1bc65c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_UpperGuards_State_GainedAccess = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointWarning:4ac55a26-5fd2-815b-199f-0d533f1bc65c
msgctxt "ha7969e25gecceg4089gb2aeg6fc1e418e919"
msgid ""
"<i>Kith'rak</i> Therezzyn shares your concerns. You should seek her within. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointWarning
#. Speaker = Warrior Qen
#. NodeID = 4cb37042-7bea-d200-8dbe-c4613f515a71
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#. SetFlags:
#.   Global:
#.     - CRE_UpperGuards_State_GainedAccess = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointWarning:4cb37042-7bea-d200-8dbe-c4613f515a71
msgctxt "h1793f2dcgdfb2g436ag94f5gad2222142bb6"
msgid ""
"Wait. You should report to <i>Kith'rak</i> Therezzyn inside - you may be of "
"use to her."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointWarning
#. Speaker = Warrior Qen
#. NodeID = 6835cae5-3a65-4ab9-ba10-b608083b392b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_UpperGuards_State_GainedAccess = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointWarning:6835cae5-3a65-4ab9-ba10-b608083b392b
msgctxt "hd7540843g7a6fg4adfg8eebg878c5fb64c1a"
msgid "That will be for her to decide. Go to her directly. Do not stray. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointWarning
#. Speaker = Player
#. NodeID = 735a3a0a-e8fd-f23f-1977-374b664b617d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_GithChokepoint_State_SpokeToVoss = True
#.      - GLO_GithChokepoint_Quest_GithLeave = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointWarning:735a3a0a-e8fd-f23f-1977-374b664b617d
msgctxt "hba99b8afg29b2g4763gbaa0g9699dd7b56ff"
msgid "I have the githyanki item Captain Voss was hunting for. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointWarning
#. Speaker = Player
#. NodeID = 89876abd-fa46-40d3-877a-da0ded00dd55
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointWarning:89876abd-fa46-40d3-877a-da0ded00dd55
msgctxt "h68f0defcg9ac6g4770gbc51g6a4ac4260d9a"
msgid "I have business with your <i>Kith'rak. </i>Stand aside. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointWarning
#. Speaker = Warrior Qen
#. NodeID = 9ad0c993-ad71-a92f-8cb6-5122e59c4dc4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointWarning:9ad0c993-ad71-a92f-8cb6-5122e59c4dc4
msgctxt "h38894c58g5b2eg417dgbb68g86e6ad725152"
msgid ""
"Kith'rak Voss sent you directly? <i>Chk.</i> We are never informed first."
msgstr "키스락 보스가 너를 직접 보내셨다고? <i>츠크.</i> 그건 사전에 전달받지 못했는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointWarning
#. Speaker = Warrior Qen
#. NodeID = a689e67b-7e4b-74a6-8da0-3abd6046d249
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_UpperGuards_State_GainedAccess = True
#.   Tag:
#.      - GITHYANKI(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointWarning:a689e67b-7e4b-74a6-8da0-3abd6046d249
msgctxt "h47e579c5g7700g4391g9cb7g21e11f6e54a9"
msgid "Leave me alone. The watch must remain undisturbed. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointWarning
#. Speaker = Warrior Qen
#. NodeID = a97afdf3-768a-f7ed-e0dc-654f64e21df4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_UpperGuards_State_GainedAccess = True
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointWarning:a97afdf3-768a-f7ed-e0dc-654f64e21df4
msgctxt "h0c2c1d02gf1c0g4cc2ga15cg6c1f9ade5398"
msgid "I must return to my duty. Walk well, <i>ra'stil</i>. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointWarning
#. Speaker = Warrior Qen
#. NodeID = b2d42757-cd39-f638-ff28-3f44259d3e1d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_UpperGuards_State_GainedAccess = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointWarning:b2d42757-cd39-f638-ff28-3f44259d3e1d
msgctxt "h52517acag89a3g479cgbc8cg02c9249e3d08"
msgid ""
"But if this is true, you do our crèche a great honour. Report to <i>Kith'rak "
"</i>Therezzyn inside. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointWarning
#. Speaker = Player
#. NodeID = b4188a09-c69d-4ef9-a1ad-a04a3bcf4ce4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_UpperGuards_Event_HiddenCheckpointHostile = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointWarning:b4188a09-c69d-4ef9-a1ad-a04a3bcf4ce4
msgctxt "haa62543eg1907g4f5fg8661g960b07cf79c8"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointWarning
#. Speaker = Warrior Qen
#. NodeID = b6b147bd-4a0d-48b1-91d1-5d8e77e58f21
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_UpperGuards_State_HiddenPrimaryGuardDefeated = True
#.      - CRE_UpperGuards_State_GainedAccess = False
#.   Tag:
#.      - GITHYANKI(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointWarning:b6b147bd-4a0d-48b1-91d1-5d8e77e58f21
msgctxt "h3f8f4628ga353g4a75g819bgd58fb1646336"
msgid "You! <i>Istik</i>. Halt. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointWarning
#. Speaker = Warrior Qen
#. NodeID = c6acb568-40a1-dfc5-1b35-00676c28ba8c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_UpperGuards_State_GainedAccess = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointWarning:c6acb568-40a1-dfc5-1b35-00676c28ba8c
msgctxt "hb5c1a26cg815ag4845gac53g4e10a8472590"
msgid ""
"Fine. Enter. If you are lying, <i>Kith'rak</i> Therezzyn will make short "
"work of you. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointWarning
#. Speaker = Player
#. NodeID = d7d0afaf-7e37-8b9d-be49-7b6f7cd58a76
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_GithChokepoint_State_SpokeToVoss = True
#.      - GLO_GithChokepoint_Quest_GithLeave = True
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointWarning:d7d0afaf-7e37-8b9d-be49-7b6f7cd58a76
msgctxt "h7e202bcagf9d8g4ce2gb320g811b784f71d8"
msgid "<i>Kith'rak </i>Voss sent me to find a weapon of our kin. I have it. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointWarning
#. Speaker = Warrior Qen
#. NodeID = e8410ba9-8d83-8db0-6252-1f3eaf812300
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointWarning:e8410ba9-8d83-8db0-6252-1f3eaf812300
msgctxt "h6561b550gb2f9g4d61gaf60g62d89fd49eee"
msgid "And you didn't hand it over? Interesting. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointWarning
#. Speaker = Warrior Qen
#. NodeID = eb173f55-0df3-4a05-a913-ade96b7cc4c0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = False
#. SetFlags:
#.   Global:
#.     - CRE_UpperGuards_Event_HiddenCheckpointHostile = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointWarning:eb173f55-0df3-4a05-a913-ade96b7cc4c0
msgctxt "h550da5bagabf4g486egb824geb9251fa2d20"
msgid "You will <i>die</i>, trespasser! "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointWarning
#. Speaker = Player
#. NodeID = ee9a1449-3a19-4354-8a8c-c8ce085143e2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_GithChokepoint_State_SpokeToVoss = True
#.      - GLO_GithChokepoint_Quest_GithLeave = True
#.   Tag:
#.      - GITHYANKI(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_HiddenCheckpointWarning:ee9a1449-3a19-4354-8a8c-c8ce085143e2
msgctxt "h004cb60ag9617g4135gb3b4gdffe68faf407"
msgid ""
"I have the item you're searching for. Captain Voss asked me to find it. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Gish Far'aag
#. NodeID = 0032bcae-5a0c-3760-8bc0-f3e1fffa1a19
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:0032bcae-5a0c-3760-8bc0-f3e1fffa1a19
msgctxt "hf94c129ag9ce0g4362g90e5g0e0140542d76"
msgid "You claim knowledge beyond <i>us? </i>"
msgstr "감히 <i>우리</i>의 지식을 얕잡아 보는 것이냐?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Gish Far'aag
#. NodeID = 09188341-2b65-fa7d-bb59-3ac2b4cc1cfe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_UpperGuards_MainCheckpointTrespassing_Event_LaezelInclusion1 = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:09188341-2b65-fa7d-bb59-3ac2b4cc1cfe
msgctxt "h3d734865gcfe4g4181gaedfgf766db9cb7c7"
msgid "I expected no visitors, faithful or otherwise. Why have you come?"
msgstr "충신이든 아니든 방문객은 없을 줄 알았는데. 어떤 용무로 왔지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Gish Far'aag
#. NodeID = 0c1e793c-c945-8a3e-4c35-93ad1947f493
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_UpperGuards_State_GainedAccess = True
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:0c1e793c-c945-8a3e-4c35-93ad1947f493
msgctxt "ha2f10531g334cg4e7dg9d2cg1cb7382daf41"
msgid "Walk well within Crèche Y'llek, <i>ra'stil</i>."
msgstr "일레크 양성소 내부에서는 발걸음을 조심해라, <i>라스틸</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Gish Far'aag
#. NodeID = 0f18cf47-cef5-d7ce-ff2a-13a0c6fe4f11
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = False
#. SetFlags:
#.   Global:
#.     - CRE_UpperGuards_State_GainedAccess = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:0f18cf47-cef5-d7ce-ff2a-13a0c6fe4f11
msgctxt "h69a91e52gb66dg46f3gbe8fga7b5d8cf6cf3"
msgid "<i>Tsk'va</i>... It speaks truth. The inquisitor will be most pleased. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Gish Far'aag
#. NodeID = 0f9d6b5d-b531-ee97-1448-85c2768e460d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_UpperGuards_Event_MainCheckpointHostile = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:0f9d6b5d-b531-ee97-1448-85c2768e460d
msgctxt "h8999a687g287bg4081gbbd9g4ec27e6d5801"
msgid "Do not cite protocol to me, <i>shka'keth. </i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Gish Far'aag
#. NodeID = 15174c18-97d3-baca-f7ba-e28234d3b67f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_UpperGuards_Event_MainCheckpointHostile = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:15174c18-97d3-baca-f7ba-e28234d3b67f
msgctxt "he12624d8g6a8dg460cg92a4gb890b940d3a3"
msgid "Try me. <i>Htak'a! </i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Gish Far'aag
#. NodeID = 1612e257-32d9-a4a1-8556-99f52d791509
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 60038785-63c7-d013-bf73-1a26d5360bc8_ProducedBox = True
#. SetFlags:
#.   Global:
#.     - CRE_UpperGuards_State_GainedAccess = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:1612e257-32d9-a4a1-8556-99f52d791509
msgctxt "h20dbe3c0ge05cg49b3g876dgde80a6adbaf5"
msgid "At least the weapon is here. Inquisitor W'wargaz will be pleased."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Gish Far'aag
#. NodeID = 16224bb3-86fd-e124-f638-9208fee4d46a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:16224bb3-86fd-e124-f638-9208fee4d46a
msgctxt "hcdafd7a4gc150g4397g86ecgd46ea809b612"
msgid "Is that so? His efficiency is to be commended then, as is yours."
msgstr "그렇단 말이지? 그분의 능력은 칭송받아 마땅하지. 그대도 마찬가지겠고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Gish Far'aag
#. NodeID = 18a122cf-0534-6ef3-2eaf-ea38b2ec0366
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_UpperGuards_Event_MainCheckpointHostile = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:18a122cf-0534-6ef3-2eaf-ea38b2ec0366
msgctxt "h21a0d229g6561g4ba0ga361g84021a280035"
msgid "Silence! I will tear her name from your impure tongue."
msgstr "무엄하다! 여왕 폐하의 이름으로 네놈의 불결한 혓바닥을 찢어발기겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Player
#. NodeID = 1b50f81f-1d86-a20b-cee4-bf24ea6b8ad1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_UpperGuards_State_ShowedArtefacttoGuard = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:1b50f81f-1d86-a20b-cee4-bf24ea6b8ad1
msgctxt "hfe11a1a7g3364g4bf6ga353g7536c3452bdb"
msgid "<i>Produce the artefact as evidence. </i>"
msgstr "<i>아티팩트를 증거로 보여준다. </i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Gish Far'aag
#. NodeID = 1ba930f4-d5d3-ef5c-4829-b8a8bccd9989
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_UpperGuards_State_GainedAccess = True
#.   Object:
#.     - CRE_ChainofCommand_ToldReportToInfirmary(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:1ba930f4-d5d3-ef5c-4829-b8a8bccd9989
msgctxt "h40d5ad37gf86eg4401g8bfag1cdadd118418"
msgid ""
"Report to the infirmary at once. Step carefully, <i>istik, </i>Crèche Y'llek "
"watches you."
msgstr "즉시 의무실에 보고하도록. 행동을 삼가라, <i>이스틱</i>. 일레크 양성소가 네놈을 지켜보고 있으니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Gish Far'aag
#. NodeID = 1ed19e45-0cfe-cf9f-d71b-83f20c27755f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_UpperGuards_State_GainedAccess = False
#.   Tag:
#.      - GITHYANKI(1) = False
#. SetFlags:
#.   Object:
#.     - ORI_Inclusion_Laezel(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:1ed19e45-0cfe-cf9f-d71b-83f20c27755f
msgctxt "h2d931b83g2404g4ed1g82f9g402bb747d5da"
msgid "Sentries, to arms! <i>Istik</i>. State your purpose. <i>Quickly.</i>"
msgstr "초병들이여, 무장하라! <i>이스틱</i>. 목적을 밝혀라. <i>신속히.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Player
#. NodeID = 23aee81e-af68-766f-5254-60aec2a6544c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_UpperGuards_Event_MainCheckpointHostile = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:23aee81e-af68-766f-5254-60aec2a6544c
msgctxt "h7119db7agaf56g47d3g832ag182845ab17e7"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Gish Far'aag
#. NodeID = 24c735d9-8897-ba68-9936-95b001818c62
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_UpperGuards_Event_MainCheckpointHostile = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:24c735d9-8897-ba68-9936-95b001818c62
msgctxt "h294dd1a5g65f4g42afg9bd7g4e307f0390ed"
msgid ""
"Your insolent species knows nothing of authority, <i>k'chakhi. </i>Let me "
"teach you."
msgstr "너희 건방진 족속은 권위에 대해 아무것도 모르는구나. <i>크차키.</i> 내가 알려주마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Gish Far'aag
#. NodeID = 28c8f760-6916-561b-0b04-01412d224c4a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_UpperGuards_State_GainedAccess = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:28c8f760-6916-561b-0b04-01412d224c4a
msgctxt "h30379781gb405g4b54g88aagfefbd3551c54"
msgid ""
"Very well. Perhaps Inquisitor W'wargaz could use the aid of an adventurer."
msgstr "좋다. 어쩌면 심문관 와르가즈가 모험가의 협조를 필요로 할지도 모르겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Player
#. NodeID = 296d8c57-afda-75d2-6dd5-88e8e346c0f9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
