msgctxt "hf97395cbg14aag4ffdga76fgc7cea3b400aa"
msgid "You're quite lively for a corpse."
msgstr "시체 치고는 아주 생기가 넘치는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead
#. Speaker = Player
#. NodeID = cb8b8645-fa2f-1079-cb37-93c15e8253e5
