#.      - PALADIN(3) = True
#. SetFlags:
#.   Local:
#.     - 4b9219b6-9074-0463-e4e0-1ff4c30e087b_SkippedHelp = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene:a7ad4837-e5b6-ac47-162b-4eea84e7e0c2
msgctxt "h6134c87bg864bg4f26ga05dgacfedb05123a"
msgid ""
"Your quarry looks dangerous, but I've handled worse. Leave it to me, get to "
"safety."
msgstr "그쪽 사냥감은 위험해 보이는군. 하지만 나는 더 위험한 녀석도 다뤄봤지. 저건 나한테 맡기고 안전한 데로 가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene
#. Speaker = Lae'zel
#. NodeID = a7f58cec-ca6e-0116-ef8e-78c7a87dc32c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene:a7f58cec-ca6e-0116-ef8e-78c7a87dc32c
msgctxt "hdfe9c706g3940g4fb5gbfc4g6006753d5b90"
msgid "<i>You again. Get rid of him.</i>"
msgstr "<i>또 만났구나. 놈을 없애버려.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene
#. Speaker = Player
#. NodeID = b0a56cad-4a3a-3523-8dd8-5a4873bb627c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene:b0a56cad-4a3a-3523-8dd8-5a4873bb627c
msgctxt "h5c623854gf38bg4949ga97dg1de9a09a1c0f"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene
#. Speaker = Nymessa
#. NodeID = b1689a24-058e-76dc-761d-868ea36ab10e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CHA_LaezelRecruitment_Event_RevealedGroveLocation = True
#.     - DEN_Apprentice_Knows_HeardAboutNettie_PartialInfo = True
#.   Quest:
#.     - GLO_Tadpole_SUB_Apprentice.LearnedNettieNearby(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene:b1689a24-058e-76dc-761d-868ea36ab10e
msgctxt "hf0838b0ag4de5g43deg9c20g082335bf5e22"
msgid "North-west. Look for Nettie. Whatever your wound, she can mend it."
msgstr "북서쪽으로 가. 네티를 찾으라고. 어떤 상처를 입었든, 그 여자가 고쳐줄 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene
#. Speaker = Player
#. NodeID = b1975035-40d2-af7b-acde-49a38a000fa5
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 7
#. CheckFlags:
