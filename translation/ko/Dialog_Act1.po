msgctxt "hb44d2361g25dbg42faga645g5ffe963db38c"
msgid "Come on! What are you waiting for?!"
msgstr "어서! 뭘 기다리고 있는 거야?!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_UnfortunateGnome_TiedUp
#. Speaker = Player
#. NodeID = 31a24c29-9e4c-d6a8-f443-d618088094d7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_UnfortunateGnome_TiedUp:31a24c29-9e4c-d6a8-f443-d618088094d7
msgctxt "h5dc9b90bg4244g43afg90adg882594e1b370"
msgid "<i>Leave him.</i>"
msgstr "<i>그를 두고 떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_UnfortunateGnome_TiedUp
#. Speaker = Player
#. NodeID = 685ac1da-0416-c672-2d88-05c838a410d5
