msgctxt "haf8f94a7g759dg4c9egbc1dg550ac80d6133"
msgid "Lathander, smiting the undead to make way for new blood."
msgstr "라샌더, 새로운 피를 위해 언데드를 처단하다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Courtyard_PAD_LathanderStatue
#. Speaker = Player
#. NodeID = a098a6d9-c811-480f-ae7d-d10f4a24a52d
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
