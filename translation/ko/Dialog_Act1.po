msgctxt "hd819db72g282ag420dgb1ceg504df838523a"
msgid ""
"The knight has betrayed his Queen's children. <i>He will be punished.</i>"
msgstr "그 기사는 여왕님의 아이를 배신했다. <i>처벌을 받을 것이야.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_LaezelPostConfrontation
#. Speaker = Lae'zel
#. NodeID = 9d2b11fa-22c5-1940-a917-60d1df98110f
