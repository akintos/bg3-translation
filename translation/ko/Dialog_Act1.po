msgctxt "h010102a3gb038g4cc5ga8e3gfa8708feb47a"
msgid "*As the symbol glows, power courses through you. <i>Authority</i>.*"
msgstr "*문양이 빛나며, 몸에 흐르는 힘이 느껴집니다. <i>권위</i>.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Trespassing
#. Speaker = Narrator
#. NodeID = b7a8f37f-f5d6-c739-1aba-0006ac7bcbe9
