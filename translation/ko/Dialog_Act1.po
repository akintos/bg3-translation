msgctxt "h4e1ce367gb8fbg470ag9e5fg97f7391e0ba8"
msgid "<i>Side with the freed bear - attack the goblin jailers.</i>"
msgstr "<i>풀려난 곰의 편에 선다. 고블린 간수를 공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear
