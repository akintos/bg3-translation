msgctxt "h8df23ab2g7bc8g444eg938cgb3995ef888b4"
msgid "Ah, Lathander - Trampler of the Undead."
msgstr "아, 라샌더. 언데드의 압제자여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Courtyard_PAD_LathanderStatue
#. Speaker = Player
#. NodeID = a098a6d9-c811-480f-ae7d-d10f4a24a52d
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
