msgctxt "h827e5aceg5b5dg48b6g8856ge95f6524d909"
msgid "If you fail me, the spiders will feed on your bones!"
msgstr "날 실망하게 하면, 거미들이 뼈까지 먹어 치우게 내버려 두겠다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_DrowLeavingReady
#. Speaker = Nightwarden Minthara
#. NodeID = ba101fc0-c250-1c87-3cf9-6d6b40d60c87
