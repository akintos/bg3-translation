msgctxt "h9157ed54g76c9g4e0ag87b5gb054c7934952"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Backup002
#. Speaker = Devout Wasp
#. NodeID = 5c41aca2-4044-1af3-112e-6a2bb31005f3
#. HandlePath = TaggedText[0].TagText[0]
