msgctxt "he90b0b41geb54g44e2gb22dgcaacd2da0624"
msgid "Do you have anything of value?"
msgstr "값어치가 있는 것을 지니고 있나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter_Dead
#. Speaker = Gandrel
#. NodeID = 6d4f89dc-c68d-c0f7-7050-13383448ccaa
