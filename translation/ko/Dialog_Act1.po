msgctxt "h9d10a4b7g1cd1g42d3ga59cgbb29ab5c6d99"
msgid "Away! <i>Away!</i>"
msgstr "저리가! <i>저리가!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_HarperBooster_ScaredBoar
#. Speaker = Player
#. NodeID = 5d4c855f-64c2-4539-6c9d-9d36fab09d78
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_HarperBooster_ScaredBoar:5d4c855f-64c2-4539-6c9d-9d36fab09d78
msgctxt "h673154e2g0745g48b7ga790g46618a02fcf2"
msgid "<i>Observe the boar to see what it does.</i>"
msgstr "<i>멧돼지가 뭘 하는지 관찰한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_HarperBooster_ScaredBoar
#. Speaker = Narrator
#. NodeID = 9235dc0e-71b0-4126-756b-ab893b32ea94
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - f8c3e46f-6d74-637e-2ebd-6cd6d0289d5b_AnimalHandlingSuccess = True
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_HarperBooster_ScaredBoar:9235dc0e-71b0-4126-756b-ab893b32ea94
msgctxt "h73fb4d27g7950g4712g8d9bg2c4715268611"
msgid "*The boar grunts and eyes you warily with its beady eyes.*"
msgstr "*멧돼지가 꿀꿀거리며 구슬 같은 눈으로 조심스럽게 당신을 바라봅니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_HarperBooster_ScaredBoar
#. Speaker = Player
#. NodeID = 9c2c094f-3227-5e49-65dc-5a0ec8cf2cdf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_HarperBooster_ScaredBoar:9c2c094f-3227-5e49-65dc-5a0ec8cf2cdf
msgctxt "hec6808ebg0c33g43fagb4abgea0dbf67df53"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_HarperBooster_ScaredBoar
#. Speaker = Player
#. NodeID = b4422b11-c738-9d71-0631-9992f1aee610
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_HarperBooster_ScaredBoar:b4422b11-c738-9d71-0631-9992f1aee610
msgctxt "hadd308d5gadcag4e96g8541g6c6d478316fd"
msgid "Clear off - it's dangerous here."
msgstr "달아나. 여긴 위험하다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_HarperBooster_ScaredBoar
#. Speaker = Player
#. NodeID = b6f931e3-7e6a-7dd0-f48c-2c279b95e20a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_HarperBooster_ScaredBoar:b6f931e3-7e6a-7dd0-f48c-2c279b95e20a
msgctxt "h7f948874g7747g41c9gb0bdgd42a8736e2b5"
msgid "Calm down. I won't hurt you."
msgstr "진정해. 나는 널 해치지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_HarperBooster_ScaredBoar
#. Speaker = Player
#. NodeID = b982fe16-800d-0ad6-eb6b-dd7c903a5d6d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_HarperBooster_ScaredBoar:b982fe16-800d-0ad6-eb6b-dd7c903a5d6d
msgctxt "h898aa740g9da9g484dg8f0egabc7f45c9c9f"
msgid "<i>Beckon at the boar silently. Try to lure it closer.</i>"
msgstr "<i>아무 말 없이 멧돼지에게 손짓해, 가까이 오도록 한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_HarperBooster_ScaredBoar
#. Speaker = Player
#. NodeID = bb3b1e46-69d0-4373-b57f-d9914b6a616c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 10
#. CheckFlags:
#.   Dialog:
#.      - CRA_HarperBooster_ScaredBoar_AnimalHandlingFail(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_HarperBooster_ScaredBoar:bb3b1e46-69d0-4373-b57f-d9914b6a616c
msgctxt "h357bdb2bgddbbg4864ga60bg3c98fea1211e"
msgid "<i>Raise your palms to calm the boar.</i>"
msgstr "<i>손바닥을 들어 멧돼지를 진정시킨다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_HarperBooster_ScaredBoar
#. Speaker = Scared Boar
#. NodeID = cb064559-81fe-03b5-68f1-dc9425ef4e31
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CRA_Escape_Event_BoarFlee(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_HarperBooster_ScaredBoar:cb064559-81fe-03b5-68f1-dc9425ef4e31
msgctxt "hae53a893gb262g4e8bg904cgf410e831acf1"
msgid "Yes, I have eyes. Keep away from me!"
msgstr "그래, 나도 눈 달려서 알아. 가까이 오지나 마!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_HarperBooster_ScaredBoar
