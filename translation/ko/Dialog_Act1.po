msgctxt "h7d0c9545g31e3g4c3cgb7ebg449607f7a419"
msgid "Ya lookin' down on me as well? I can get up by myself."
msgstr "너도 날 내려다보는 거냐? 일어나는 것 정도는 혼자 할 수 있다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_FistFight
#. Speaker = Wyll
#. NodeID = 0781cb92-ade4-21bc-e290-649e6c9753d1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_WYLL(6) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_FistFight:0781cb92-ade4-21bc-e290-649e6c9753d1
#, fuzzy
msgctxt "h7eaad82bg6184g45f7gabffg0bdafedda5ca"
msgid "He wants mercy. I say show it to him - decisively."
msgstr "진행해, 그의 목숨을 끊어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_FistFight
#. Speaker = Astarion
#. NodeID = 08169dfe-dced-96f6-67db-2ff452ec7f43
