msgctxt "h247b606fgffefg4c4bg87a1gb5a59b2f5321"
msgid "<i>Seal your mind against the intrusion.</i>"
msgstr "<i>침입에 대항하여 정신을 봉쇄한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = f9c870ff-08cd-4da6-5fcd-abb05b17eceb
