#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_002:185df249-df48-92f3-96cd-1701ee9a8234
msgctxt "h9a3ce458g3ea3g4cdag8413g8f555521cb30"
msgid "Nicely handled. Those rothé old sweethearts of yours or something?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_002
#. Speaker = Grundril
#. NodeID = 2af79f30-7d9d-953f-f771-07c602a21632
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_FearfulRothe_Event_MakeDuergarHostileInDialog = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_002:2af79f30-7d9d-953f-f771-07c602a21632
msgctxt "h406dd8f7g22dag4210g8c22g9e68c9978c0f"
msgid ""
"You think we're letting you near that forge? You're as dumb as you are "
"stupid."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_002
#. Speaker = Grundril
#. NodeID = 3b267594-93cf-457d-be1f-3a3820dcd308
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_FearfulRothe_State_RotheAreDead = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_002:3b267594-93cf-457d-be1f-3a3820dcd308
msgctxt "h3b35215ag1d1cg4b9egbabfg6c047d3c37e6"
msgid "And I thought deep rothé stank while they were <i>alive</i>..."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_002
#. Speaker = Grundril
#. NodeID = 4a4f80a0-9cf5-f30d-222b-a6d4dec8d6b0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_FearfulRothe_Event_MakeDuergarHostileInDialog = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_002:4a4f80a0-9cf5-f30d-222b-a6d4dec8d6b0
msgctxt "h4e9b2038g9677g41a0g988fg7a759c39842f"
msgid "Pity I got to split you - that forge ain't for sharing."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_002
#. Speaker = Grundril
#. NodeID = 4f164ebd-96e6-45c2-ad85-92ba2dc0284b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_FearfulRothe_State_ConvincedRotheToAttackRubble = True
#.      - UND_FearfulRothe_State_RubbleDestroyed = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_002:4f164ebd-96e6-45c2-ad85-92ba2dc0284b
msgctxt "h955b5dcbg49c9g4947gb261g09bdeebad8c0"
msgid "You got a knack. Won't be long before the beasts break through."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_002
#. Speaker = Player
#. NodeID = 91bf38a4-01e3-4464-cc7b-62a0efb64163
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_FearfulRothe_Event_MakeDuergarHostileInDialog = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_002:91bf38a4-01e3-4464-cc7b-62a0efb64163
msgctxt "hf0aaa486g750eg47acgaadeg160770de7999"
msgid "Go ahead. We'll see who ends up split."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_002
#. Speaker = Grundril
#. NodeID = a950f0d6-a2d5-6e79-491d-6972a9255a06
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_FearfulRothe_HasMet_Guard_002(1) = False
#.   Global:
#.      - UND_FearfulRothe_State_ConvincedRotheToAttackRubble = False
#.      - UND_FearfulRothe_State_RotheAreDead = False
#.      - UND_TheDrowNere_State_PermaDefeated = True
#. SetFlags:
#.   Dialog:
#.     - UND_FearfulRothe_HasMet_Guard_002(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_002:a950f0d6-a2d5-6e79-491d-6972a9255a06
msgctxt "he7f2c9ffge21cg47d6g9faegbf03562825f5"
msgid "Nere was soft. No reason for you to strut about like a damn hero."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_002
#. Speaker = Player
#. NodeID = cdab894e-50aa-5a45-784f-3c9746415e13
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_002:cdab894e-50aa-5a45-784f-3c9746415e13
msgctxt "hd4007c32g0b8ag4fa5gb159g156159fd497c"
msgid "I calmed the rothé, and now you want me dead?"
msgstr "내가 로테를 진정시켜줬더니, 이제 날 죽이겠다고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_002
#. Speaker = Grundril
#. NodeID = fb55ee1f-c21d-40c4-973b-62c80d153d58
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_FearfulRothe_HasMet_Guard_002(1) = True
#.   Global:
#.      - UND_FearfulRothe_State_ConvincedRotheToAttackRubble = False
#.      - UND_FearfulRothe_State_RotheAreDead = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_002:fb55ee1f-c21d-40c4-973b-62c80d153d58
msgctxt "hd37cb0f9g9502g46b9g97a3g56f2ed97f60c"
msgid "Don't see you helping. Best you find a ledge and jump."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_003
#. Speaker = Morgya
#. NodeID = 6bee4651-239d-a149-813d-329c63273f03
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_FearfulRothe_State_ConvincedRotheToAttackRubble = True
#.      - UND_FearfulRothe_State_RubbleDestroyed = True
#. SetFlags:
#.   Global:
#.     - UND_FearfulRothe_Event_MakeDuergarHostileInDialog = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_003:6bee4651-239d-a149-813d-329c63273f03
msgctxt "h2e89d75ag2379g4e3agaa6egeb1342137d6a"
msgid "Fantastic work. You're a right master of beasts."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_003
#. Speaker = Morgya
#. NodeID = c6b1058a-6705-4325-937c-643a90dc5468
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_FearfulRothe_HasMet_Guard_003(1) = False
#.   Global:
#.      - UND_FearfulRothe_State_ConvincedRotheToAttackRubble = False
#.      - UND_FearfulRothe_State_RotheAreDead = False
#. SetFlags:
#.   Dialog:
#.     - UND_FearfulRothe_HasMet_Guard_003(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_003:c6b1058a-6705-4325-937c-643a90dc5468
msgctxt "hb1799ca4g3972g47a8gbc25g37e90154dde1"
msgid ""
"Bloody deep rothé. All the hassle of getting them up here. Now they won't "
"work!"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_003
#. Speaker = Morgya
#. NodeID = ce6e7611-e8bf-4960-a0a9-68bb28ae9caf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_FearfulRothe_State_RotheAreDead = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_003:ce6e7611-e8bf-4960-a0a9-68bb28ae9caf
msgctxt "h7a7bd92cg1d3dg4710g930fg713fdf66c0c4"
msgid ""
"Hrrmph. Them deep rothé fought better than most gnomes, I'll give them that."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_003
#. Speaker = Morgya
#. NodeID = d5ffaf34-bdf7-4d93-b0c5-c1ccd21a9bd1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_FearfulRothe_State_ConvincedRotheToAttackRubble = True
#.      - UND_FearfulRothe_State_RubbleDestroyed = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_003:d5ffaf34-bdf7-4d93-b0c5-c1ccd21a9bd1
msgctxt "h6c27cbdeg346bg49b7g9d88g9dd67253e09b"
msgid "Halfway there, I'd wager. Now the beasts need to finish the job."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_003
#. Speaker = Morgya
#. NodeID = e53dfdfd-afcf-ba25-2423-054db7471d0c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_003:e53dfdfd-afcf-ba25-2423-054db7471d0c
msgctxt "hd1f8e0edga4aeg425cgb7e1gc9b71c43aab5"
msgid ""
"But ain't no one but clan need to be using the forge back there - and we "
"can't have you blabbing! "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_003
#. Speaker = Morgya
#. NodeID = f12092ca-c8f4-4cb1-af94-337c3da38476
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_FearfulRothe_HasMet_Guard_003(1) = True
#.   Global:
#.      - UND_FearfulRothe_State_ConvincedRotheToAttackRubble = False
#.      - UND_FearfulRothe_State_RotheAreDead = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_003:f12092ca-c8f4-4cb1-af94-337c3da38476
msgctxt "he00d65afgb5c0g42a6ga390gd9ce82dc69a2"
msgid "Would've thought these beast were too stupid to get scared.\n"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_RotheDeadAttack
#. Speaker = Player
#. NodeID = 51ba5794-5955-e673-187f-2ceb04c1e5e9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_RotheDeadAttack:51ba5794-5955-e673-187f-2ceb04c1e5e9
msgctxt "hba9639d0ge324g4dbeg8473gf243f92bcc1d"
msgid "Don't get surly with me. Those beasts were out of control."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_RotheDeadAttack
#. Speaker = Player
#. NodeID = 852ece6b-d714-e50b-b168-84c9a0298df1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_RotheDeadAttack:852ece6b-d714-e50b-b168-84c9a0298df1
msgctxt "h623c8713g8be2g43dfg8538gdd240b793b80"
msgid "I meant to calm them, not rile them up."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_RotheDeadAttack
#. Speaker = Player
#. NodeID = 90abedfd-24f7-5eb5-814d-2d8e37425d25
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_RotheDeadAttack:90abedfd-24f7-5eb5-814d-2d8e37425d25
msgctxt "h037bcfd2gd954g4032g86d0g2f95557309ce"
msgid "I've gained a taste for rothé meat. I don't see the problem."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_RotheDeadAttack
#. Speaker = Herdmaster Skarjall
#. NodeID = b0dd648e-7260-f5cc-f1c3-a569e1989dee
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
