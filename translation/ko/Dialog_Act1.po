#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ConflictedFlind_Flind:c69d4246-69f5-40ad-b789-87cb2be5d588
msgctxt "he3436b62ge574g4335g9befgc67a8d82bcae"
msgid "*A shiver runs across your mind... You feel sated.*"
msgstr "*전율이 불현듯 머릿속을 스쳐 지나가고... 만족감이 듭니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ConflictedFlind_Flind
#. Speaker = Narrator
#. NodeID = cc3820ee-a1bb-fe48-67c7-53a69bdc4a84
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - PLA_ConflictedFlind_Event_MindControl_KillHerself(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ConflictedFlind_Flind:cc3820ee-a1bb-fe48-67c7-53a69bdc4a84
msgctxt "haecff4a7g6c0dg462cg88a0g3d31135ae74b"
msgid "*Your tadpole wriggles, contented, as she tears out her own throat.*"
msgstr "*놀이 스스로의 목을 뜯어내자, 당신의 올챙이가 만족감에 휩싸여 꿈틀댑니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ConflictedFlind_Flind
#. Speaker = Player
#. NodeID = d4c45824-a91e-a6ef-eb34-c497dc360460
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 10
#. CheckFlags:
