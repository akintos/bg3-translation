#.      - REALLY_ASTARION(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter_Dead:806ebdf6-4da6-0e23-f39c-78967af44fb6
msgctxt "h29454c40ga796g4fbeg826fg182c083984d6"
msgid "What were you going to do to me?"
msgstr "나에게 무슨 짓을 하려 했던 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter_Dead
#. Speaker = Player
#. NodeID = 80f94db0-d002-8f07-4153-436e79c0a2c2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_GurHunter_Dead_Knows_Hunter = False
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Global:
#.     - HAG_GurHunter_Dead_Knows_Hunter = True
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter_Dead:80f94db0-d002-8f07-4153-436e79c0a2c2
msgctxt "h248fd182g0e13g40d5ga47dgc0827874c752"
msgid "Who are you?"
msgstr "너는 누구지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter_Dead
#. Speaker = Player
#. NodeID = a2f0cb20-6aa0-250e-5599-064d749f141b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_GurHunter_Astarion_Knows_GurPlan = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#.   Tag:
#.      - REALLY_ASTARION(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter_Dead:a2f0cb20-6aa0-250e-5599-064d749f141b
msgctxt "h2d09a56dgdd2cg4c1dg8015g878726bab126"
msgid "Why did you need me alive? Why not destroy me?"
msgstr "나를 산 채로 잡아가려 했던 이유가 뭐야? 왜 나를 죽이지 않고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter_Dead
#. Speaker = Narrator
#. NodeID = a9af3c72-7914-0ae6-9298-1be62da51496
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter_Dead:a9af3c72-7914-0ae6-9298-1be62da51496
msgctxt "h563ba5b6g997eg4e8ag90d5gc6ee4cffb01e"
msgid "*The corpse does not stir. It will answer no more questions.*"
msgstr "*시체는 움직이지 않습니다. 더 이상 질문을 받지 않을 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter_Dead
#. Speaker = Player
#. NodeID = b1b98b9b-96dc-0e99-7760-bc56c6318211
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_GurHunter_State_MentionedAstarion = True
#.      - ORI_Astarion_Knows_MaidenFel = False
