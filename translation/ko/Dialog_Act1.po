msgctxt "h92f8ce95gff5eg4727g812cg65fd6d1893d5"
msgid "Wherezzat? Git back here!"
msgstr "어디야? 여기로 돌아와!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SecludedSpot_Trespassing
