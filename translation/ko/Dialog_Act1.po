msgctxt "h058a8843g5bb0g4579ga02ag08710cdb30fa"
msgid "Did I see you drawing something earlier?"
msgstr "아까 네가 뭔가를 그리는 걸 봤던가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03_AD_Zhent04
#. Speaker = Garias
#. NodeID = 5a3e228f-f7ff-3eec-3e19-6b166d9ea311
