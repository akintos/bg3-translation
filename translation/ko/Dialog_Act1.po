msgctxt "h4cc6c49fgbf45g4debgae2bga10710ca0518"
msgid "About drugnin' time!"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarLoyalSergeant_AD_PostMutiny_LineUp
#. Speaker = Sergeant Thrinn
#. NodeID = 5e638c6c-d69f-44a7-70ef-b4daa470e1ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarLoyalSergeant_AD_PostMutiny_LineUp:5e638c6c-d69f-44a7-70ef-b4daa470e1ac
msgctxt "h82b6658ag54c3g4b6egb9e1gafc26242d909"
msgid ""
"The Absolute's called us to Moonrise Towers. And we're not gonna keep Her "
"waiting."
msgstr "절대자님께서 우릴 문라이즈 타워로 부르셨어. 그분을 기다리게 할 순 없지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarLoyalSergeant_AD_PostMutiny_LineUp
#. Speaker = Sergeant Thrinn
#. NodeID = 77e9a7a5-2944-8e1a-8d03-a252de66d3da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarLoyalSergeant_AD_PostMutiny_LineUp:77e9a7a5-2944-8e1a-8d03-a252de66d3da
msgctxt "h90aec40ag6a45g44abg8ea9g64e6f64f381a"
msgid ""
"Even one of you make me look bad in front of the General, and I'll have "
"<i>all</i> your hides."
msgstr "내가 너희 중 하나 때문이라도 장군님에게 잘못 보인다면, <i>모두</i>의 가죽을 벗겨버리겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarLoyalSergeant_AD_PostMutiny_LineUp
#. Speaker = Sergeant Thrinn
#. NodeID = 79dd7d9c-87d3-d817-a8cb-6d71355aa264
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarLoyalSergeant_AD_PostMutiny_LineUp:79dd7d9c-87d3-d817-a8cb-6d71355aa264
msgctxt "hb2b60e59g4ca5g4fb2g99bege760ed963813"
msgid "Pack up your shit and wave Grymforge goodbye."
msgstr "망할 짐 좀 싸고 그림포지에게 작별 인사해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarLoyalSergeant_AD_PostMutiny_LineUp
#. Speaker = Sergeant Thrinn
#. NodeID = 890ca7dc-29e2-7f3b-e357-d6ae96a9c881
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 82ddac38-a0c5-172c-c9b0-60144308d756_A = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarLoyalSergeant_AD_PostMutiny_LineUp:890ca7dc-29e2-7f3b-e357-d6ae96a9c881
msgctxt "h6bbbde0dg72f4g43b5g823eg688468d73118"
msgid "Attention, Clan Flameshade:"
msgstr "모두 주목하시오, 플레임셰이드 일족:"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarLoyalSergeant_AD_PostMutiny_LineUp
#. Speaker = Sergeant Thrinn
#. NodeID = 915c001a-2984-3de3-940e-e617a8a73539
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 82ddac38-a0c5-172c-c9b0-60144308d756_B = True
#. SetFlags:
#.   Local:
#.     - 82ddac38-a0c5-172c-c9b0-60144308d756_B = False
#.     - 82ddac38-a0c5-172c-c9b0-60144308d756_A = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarLoyalSergeant_AD_PostMutiny_LineUp:915c001a-2984-3de3-940e-e617a8a73539
msgctxt "h4416d59dgb6c3g4b9fg9592gf1f4503076bb"
msgid "Absolute's taken a shine to us, clan. But She won't wait forever."
msgstr "절대자께서 우리에게 빛을 내리셨어, 일족이여. 하지만 그분은 영원히 기다려주시진 않을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarLoyalSergeant_AD_PostMutiny_LineUp
#. Speaker = Sergeant Thrinn
#. NodeID = c81427d2-ca85-483a-52d4-3dfb7a593215
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 82ddac38-a0c5-172c-c9b0-60144308d756_A = True
#. SetFlags:
#.   Local:
#.     - 82ddac38-a0c5-172c-c9b0-60144308d756_B = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarLoyalSergeant_AD_PostMutiny_LineUp:c81427d2-ca85-483a-52d4-3dfb7a593215
msgctxt "h01f3b503g64e9g4ec2g9307g04176994d071"
msgid ""
"What'd I tell you pricks? Get your arses moving. We're headed to Moonrise."
msgstr "내가 뭘 하라고 했었지 병신들아? 엉덩이들 움직여. 우린 문라이즈로 향한다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarLoyalSergeant_AD_PostMutiny_LineUp
#. Speaker = Sergeant Thrinn
#. NodeID = e8519b92-52c5-beaa-a317-e6b0e91d1712
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarLoyalSergeant_AD_PostMutiny_LineUp:e8519b92-52c5-beaa-a317-e6b0e91d1712
msgctxt "h79164523g1e8eg445fgbeb3g5a1ccd3201f3"
msgid ""
"In other words, hurry the <i>drugh</i> up or I march to Moonrise without you."
msgstr "바꿔 말하면, <i>겁나게</i> 서두르지 않으면 너흴 두고 문라이즈로 쳐들어가겠다는 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMasons_AD_Stonework
#. Speaker = Stonemason Kith
#. NodeID = 2e0ed437-4aec-5d9d-2b13-1ad7f9f5987e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMasons_AD_Stonework:2e0ed437-4aec-5d9d-2b13-1ad7f9f5987e
msgctxt "h4865b6e6g4692g4581g88c6g559a6fdf579e"
msgid "The skeletons, then."
msgstr "그럼 해골이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMasons_AD_Stonework
#. Speaker = Stonemason Gergerann
#. NodeID = 3489ca90-3019-aeb8-9bb3-a513947f5fc0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMasons_AD_Stonework:3489ca90-3019-aeb8-9bb3-a513947f5fc0
msgctxt "h0e9560bagb139g4fcdg83b5g0177a3c3d8ef"
msgid "Quiet, I'm thinking."
msgstr "조용히 좀 해. 생각 중이잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMasons_AD_Stonework
#. Speaker = Stonemason Gergerann
#. NodeID = 4ee294c4-2b9c-e344-35fc-3e2ba477e491
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMasons_AD_Stonework:4ee294c4-2b9c-e344-35fc-3e2ba477e491
msgctxt "h19843fadgf28ag46aeg81bdge18370acaa25"
msgid "A dumb theory. Half these walls are still standin'."
msgstr "멍청한 이론이야. 이 벽의 절반은 아직 무너지지 않았다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMasons_AD_Stonework
#. Speaker = Stonemason Kith
#. NodeID = 58d6cd4c-8d2e-d4c4-bc09-69dd35038b2c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMasons_AD_Stonework:58d6cd4c-8d2e-d4c4-bc09-69dd35038b2c
msgctxt "h89716259gfba9g493cg9d60gf95e03eeb0f1"
msgid "Human, certainly. A god, perhaps? Why would gnomes make such a thing?"
msgstr "확실히 인간의 형상이야. 어쩌면 신일지도? 왜 노움들이 이런 걸 만든 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMasons_AD_Stonework
#. Speaker = Stonemason Gergerann
#. NodeID = 5e427ed9-9a52-968c-e57f-63dda49b2593
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMasons_AD_Stonework:5e427ed9-9a52-968c-e57f-63dda49b2593
msgctxt "h7d8185e3g7e9fg4878g93dfgb5ab75174fa3"
msgid "You're the expert. Why don't you tell me?"
msgstr "전문가는 너잖아. 알려주지 않겠어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMasons_AD_Stonework
#. Speaker = Stonemason Gergerann
#. NodeID = 61bdd8f7-f4b5-47b5-85bd-9fc919812876
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMasons_AD_Stonework:61bdd8f7-f4b5-47b5-85bd-9fc919812876
msgctxt "hc37f6a64g255ag427fg8b05g921784a902c2"
msgid "Probably inhabited by whoever those skeletons were the others found."
msgstr "다른 이들이 찾아낸 그 해골들이 원래 거주했던 곳인 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMasons_AD_Stonework
#. Speaker = Stonemason Gergerann
#. NodeID = 62abdbf0-ccc1-4ede-8f36-3536a688b839
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - cca196fb-f6f2-0ff1-b4fc-99e40a4f8e04_A = True
#. SetFlags:
#.   Local:
#.     - cca196fb-f6f2-0ff1-b4fc-99e40a4f8e04_B = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMasons_AD_Stonework:62abdbf0-ccc1-4ede-8f36-3536a688b839
msgctxt "hdb41c299gbf97g428ag85ebgc044b096f26b"
msgid "Gold accents aren't too tarnished yet."
msgstr "황금 장식은 아직 빛이 많이 바래지는 않았네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMasons_AD_Stonework
#. Speaker = Stonemason Kith
#. NodeID = 6338f950-f672-0cbe-b2f3-0f2ea7d47242
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMasons_AD_Stonework:6338f950-f672-0cbe-b2f3-0f2ea7d47242
msgctxt "h0e8d1f4bgdc04g4b71gbf28g6dbb158df3e5"
msgid "A quake of some sort, perhaps. Just a theory."
msgstr "일종의 진동 때문이려나. 그냥 이론일 뿐이지만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMasons_AD_Stonework
#. Speaker = Stonemason Gergerann
#. NodeID = 6c31ee14-5929-5f7a-a6af-bbc65fb01e34
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMasons_AD_Stonework:6c31ee14-5929-5f7a-a6af-bbc65fb01e34
msgctxt "ha6f2c62bg519cg4dc4g9461g2698a1e0e3be"
msgid "This again?"
msgstr "또 그러기야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMasons_AD_Stonework
#. Speaker = Stonemason Gergerann
#. NodeID = 713c8431-ded5-4210-a549-dd60e84d3dcd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - cca196fb-f6f2-0ff1-b4fc-99e40a4f8e04_B = True
#. SetFlags:
#.   Local:
#.     - cca196fb-f6f2-0ff1-b4fc-99e40a4f8e04_C = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMasons_AD_Stonework:713c8431-ded5-4210-a549-dd60e84d3dcd
msgctxt "h3375bd1ag735cg455egb7cdgb88fa382fd74"
msgid "What brought it down, you think?"
msgstr "네가 생각하기엔 뭐 때문에 무너진 것 같아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMasons_AD_Stonework
#. Speaker = Stonemason Gergerann
#. NodeID = 97908c41-710b-2f8b-6c17-9008149229c2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMasons_AD_Stonework:97908c41-710b-2f8b-6c17-9008149229c2
msgctxt "hb4acb017g331fg4bfagbc79g8de551cf1556"
msgid "Inhabitants were drow-sized at least."
msgstr "거주자들은 최소한 드로우 정도 크기의 몸집이었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMasons_AD_Stonework
#. Speaker = Stonemason Gergerann
#. NodeID = b2b606fd-28a1-61ee-ba05-7ea4aa063ac1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMasons_AD_Stonework:b2b606fd-28a1-61ee-ba05-7ea4aa063ac1
msgctxt "h4aee142fgc663g4336ga001g4b2e86fec494"
msgid "They didn't live here though. Steps are too big."
msgstr "하지만 그들이 여기 산 건 아니군. 발자국이 너무 커."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMasons_AD_Stonework
#. Speaker = Stonemason Kith
#. NodeID = c795609d-abad-4dc3-9e4a-12b9b4cb4173
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - cca196fb-f6f2-0ff1-b4fc-99e40a4f8e04_A = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMasons_AD_Stonework:c795609d-abad-4dc3-9e4a-12b9b4cb4173
msgctxt "hb465b52egbc21g41f7gbe37gf3a7a64fd0b5"
msgid "The walls are deep gnome make. The chiseling is remarkably intricate."
msgstr "딥 노움이 지은 벽이야. 끌질한 자국이 두드러지게 복잡해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMasons_AD_Stonework
#. Speaker = Stonemason Gergerann
#. NodeID = d166d463-ae25-49de-ab7d-dfc8b056d24e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - cca196fb-f6f2-0ff1-b4fc-99e40a4f8e04_C = True
#. SetFlags:
#.   Local:
#.     - cca196fb-f6f2-0ff1-b4fc-99e40a4f8e04_B = False
#.     - cca196fb-f6f2-0ff1-b4fc-99e40a4f8e04_C = False
#.     - cca196fb-f6f2-0ff1-b4fc-99e40a4f8e04_A = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMasons_AD_Stonework:d166d463-ae25-49de-ab7d-dfc8b056d24e
msgctxt "h63b447c9gd921g48c2g841ege4e3272a52a6"
msgid "Who's the statue, you think?"
msgstr "이 조각상은 누구인 것 같아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMasons_AD_Stonework
#. Speaker = Stonemason Gergerann
#. NodeID = f11b4bdb-3afc-094f-331c-76d4a083e7e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMasons_AD_Stonework:f11b4bdb-3afc-094f-331c-76d4a083e7e6
msgctxt "hd1ca55d3g044fg4b44g9d97g1faed3fb1212"
msgid "We might be able to chip 'em off and melt them."
msgstr "이걸 깎아내서 녹여버릴 수 있을지도."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMasons_AD_Stonework
#. Speaker = Stonemason Kith
#. NodeID = f85964db-b927-5d65-99ec-0b112ec3fd44
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMasons_AD_Stonework:f85964db-b927-5d65-99ec-0b112ec3fd44
msgctxt "h69bf01f5g2758g4661ga928gde47975c4927"
msgid "Absolutely not. You'd be killing history itself."
msgstr "절대 안 돼. 역사 그 자체를 죽이는 짓이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMasons_AD_Stonework
#. Speaker = Stonemason Kith
#. NodeID = fcb043e9-4b4c-d7eb-ffa4-632f4b8942d1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMasons_AD_Stonework:fcb043e9-4b4c-d7eb-ffa4-632f4b8942d1
msgctxt "h57b73be8g332fg4f08g9810g74ae7782376f"
msgid "Yes. This again."
msgstr "그래, 또 이러기야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMutineers_AD
#. Speaker = Elder Brithvar
#. NodeID = 03a03e8b-434d-438d-1534-9690e873e87d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMutineers_AD:03a03e8b-434d-438d-1534-9690e873e87d
msgctxt "h97f1683fg5d76g447aga84egc699230a6aa2"
msgid "We take his gold. And I got more in mind, if shit goes down smooth."
msgstr "우리가 놈의 금화를 갖는 거야. 일이 잘 풀리면 더 생각해둔 것도 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMutineers_AD
#. Speaker = Elder Brithvar
#. NodeID = 40b9f2fe-fcd7-56df-3ed4-eb881eadc91f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMutineers_AD:40b9f2fe-fcd7-56df-3ed4-eb881eadc91f
msgctxt "h13f70f4bgbdcfg4325g9380gf4fba97638f2"
msgid "Besides - I'd like to force-feed him some of that shit he's stirred up."
msgstr "거기에 더해 그놈이 일으킨 이 개판을 놈에게 직접 맛 좀 보여주고 싶네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMutineers_AD
#. Speaker = Elder Brithvar
#. NodeID = 5841384a-f417-66d9-ec4d-7fd8acee7c23
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMutineers_AD:5841384a-f417-66d9-ec4d-7fd8acee7c23
msgctxt "hdd826fe0g5e49g40b1g930fg4533b59629d2"
msgid ""
"Those pricks'll get nowhere with just axes. Thrinn's gone touched in the "
"head."
msgstr "저 새끼들이 곡괭이만 가지고 뭘 할 수 있겠어. 쓰린은 완전 정신이 나갔다니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMutineers_AD
#. Speaker = Elder Brithvar
#. NodeID = 5a242739-f170-cc4e-fce6-e6748f56cea1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMutineers_AD:5a242739-f170-cc4e-fce6-e6748f56cea1
msgctxt "hbe92c749gd08cg452ag907cgd09e2fc39e6f"
msgid ""
"But we got nothin' to lose. It all goes to plan, and our arses get paid."
msgstr "하지만 우린 잃을 게 없지. 계획대로 잘 풀리면 우린 돈을 받는 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMutineers_AD
#. Speaker = Elder Brithvar
#. NodeID = 5b56cca7-ca20-0217-4851-2ac8308c441d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMutineers_AD:5b56cca7-ca20-0217-4851-2ac8308c441d
#, fuzzy
msgctxt "h9721cfb3g1225g4d3bgb9b3g5794c86638b8"
msgid "Dead or alive, we ain't get our coin 'til Nere's dug out."
msgstr "우린 니어가 뒈졌든 살았든, 일단 꺼내야 돈을 받을 수 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMutineers_AD
#. Speaker = Elder Brithvar
#. NodeID = 5d9276e4-4f92-9a32-0957-46aa220ac76b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMutineers_AD:5d9276e4-4f92-9a32-0957-46aa220ac76b
msgctxt "h05bfc612g0fdeg41c3g811cgaed8eb0e6280"
msgid "All that rock-thumping and pud-pounding wrecked your mind-brain?"
msgstr "바위 두드리고 웅덩이 첨벙거리고 지랄하더니 머리가 맛이 갔냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMutineers_AD
#. Speaker = Elder Brithvar
#. NodeID = 61869595-45bc-29cf-2ad6-ca7d56f19462
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMutineers_AD:61869595-45bc-29cf-2ad6-ca7d56f19462
msgctxt "hf3516dccg7373g410cg893dg9bc5eddadd35"
msgid "Shit - 'course I ain't sure. I ain't even trust <i>you </i>most days."
msgstr "썅, 당연히 확신이 안 서지. 요즘 들어 <i>너</i>마저도 못 믿고 있는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMutineers_AD
#. Speaker = Elder Brithvar
#. NodeID = 65e2b71c-4e99-b53b-700a-0c4ec7b97ce8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMutineers_AD:65e2b71c-4e99-b53b-700a-0c4ec7b97ce8
msgctxt "h5590a565g6399g476fg87fag71d098912763"
msgid "If it goes belly-up? We got a scapegoat. It's Nere's game to lose."
msgstr "실패하더라도 그냥 희생양 하나 생기는 샘이지. 결국 니어만 손해 보는 게임이라니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMutineers_AD
#. Speaker = Elder Brithvar
#. NodeID = 69bd41da-34b8-d5b9-1415-d966c0e4eb50
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMutineers_AD:69bd41da-34b8-d5b9-1415-d966c0e4eb50
msgctxt "hebb08e00gdc37g4ab5g9e0eg82e7b3d8df6c"
msgid "Thrinn ain't found a trace. Found a way past the rockfall, is my guess."
msgstr "쓰린은 흔적을 찾지 못했어. 아마 낙석 너머로 지나갈 길을 찾은 모양이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMutineers_AD
#. Speaker = Stone Guard Kur
#. NodeID = 703cf29f-7966-4d60-8865-3d0eba6cc514
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMutineers_AD:703cf29f-7966-4d60-8865-3d0eba6cc514
msgctxt "h1ec12bf6gb628g4e96g8e40gce3bbc6b5e5b"
msgid "<i>Drugh. </i>The cult-pricks are spreading like flies on shit."
msgstr "<i>염병.</i> 교단 새끼들이 똥에 꼬이는 똥파리마냥 불어나고 있구만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMutineers_AD
#. Speaker = Stone Guard Kur
#. NodeID = 742f48e6-ab07-4898-83d4-a3eed0e92b94
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMutineers_AD:742f48e6-ab07-4898-83d4-a3eed0e92b94
msgctxt "he2832c3cgde1dg463eg877ag796cbce86d56"
msgid "That's the cult's doing. Dunnol's joined up too."
msgstr "교단 때문에 그렇게 된 거죠. 둔놀도 놈들과 한패가 됐어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMutineers_AD
#. Speaker = Stone Guard Kur
#. NodeID = 8fa43301-fa54-381b-799a-c86ff7e552c7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 65d3c642-8033-3923-401a-9b13ec51091c_C = True
#. SetFlags:
#.   Local:
#.     - 65d3c642-8033-3923-401a-9b13ec51091c_C = False
#.     - 65d3c642-8033-3923-401a-9b13ec51091c_B = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMutineers_AD:8fa43301-fa54-381b-799a-c86ff7e552c7
msgctxt "hf4138b56g8786g43d9gb5bdg84037a97a27e"
msgid "Let the poison choke Nere and be done with it, I say."
msgstr "니어가 독에 질식해 죽으면 그걸로 끝이잖아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMutineers_AD
#. Speaker = Stone Guard Kur
#. NodeID = 94646bd3-78bb-5d89-c602-22b80b7d3093
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_DuergarCamp_State_RecruitedMutineers = True
#. SetFlags:
#.   Local:
#.     - 65d3c642-8033-3923-401a-9b13ec51091c_B = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMutineers_AD:94646bd3-78bb-5d89-c602-22b80b7d3093
msgctxt "h5fe7b8d1g06c4g46bfg8124gf800078f3cc2"
msgid "So say your chum blows Nere out of there. What then?"
msgstr "그럼 당신 동료들이 니어를 작살낸다고 치면, 그리고 나서는요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMutineers_AD
#. Speaker = Stone Guard Kur
#. NodeID = a35e1778-1006-2f0c-bb58-b1c61abafbea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMutineers_AD:a35e1778-1006-2f0c-bb58-b1c61abafbea
msgctxt "hf5158a96g0980g4edbgb780gef7d5c6a7b2e"
msgid "Skarjall still at it, then?"
msgstr "스카얄은 아직도 하고 있나 보죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMutineers_AD
#. Speaker = Stone Guard Kur
#. NodeID = b0399321-22df-7fbe-334a-f19f06a5eedb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 65d3c642-8033-3923-401a-9b13ec51091c_B = True
#. SetFlags:
#.   Local:
#.     - 65d3c642-8033-3923-401a-9b13ec51091c_C = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMutineers_AD:b0399321-22df-7fbe-334a-f19f06a5eedb
msgctxt "h8abf9ec4gab78g46d1gac12gd7449cb8f469"
msgid "You sure we can trust 'em?"
msgstr "저들을 믿어 봐도 괜찮겠습니까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMutineers_AD
#. Speaker = Elder Brithvar
#. NodeID = b1552158-5aa8-c15c-ae9a-e92f10bdb8c2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_DuergarCamp_State_RecruitedMutineers = False
#.      - UND_Mutineers_Quest_KillEye = False
#. SetFlags:
#.   Local:
#.     - 65d3c642-8033-3923-401a-9b13ec51091c_A = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMutineers_AD:b1552158-5aa8-c15c-ae9a-e92f10bdb8c2
msgctxt "hc4944c9eg1b50g4f0cg8e9fg896877ccea75"
msgid ""
"The gnome bolted. Saw it myself. Thrinn still ain't caught a whiff of her - "
"slaves are paying the price."
msgstr "노움이 탈주했어. 내 직접 봤지. 쓰린은 그 년 못 잡았고, 남은 노예들이 대가를 치르고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarMutineers_AD
#. Speaker = Elder Brithvar
