#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:6bdc5efa-6989-66ed-b2b6-6b6826b228cb
msgctxt "h6f0b1c2eg492fg4431gbf3agbe195a9c408d"
msgid "*Your mind lurches, reeling suddenly as if... bitten.*"
msgstr "*뭔가에 깨물린 것처럼 느닷없이 정신이 휘청거립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Player
#. NodeID = 6c687b51-77b9-efc8-e766-bd6a4aee0e0a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ROGUE(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:6c687b51-77b9-efc8-e766-bd6a4aee0e0a
msgctxt "h9d161574g60d9g440fga577g81ab367b1d91"
msgid "<i>Provide directions to a non-existent cache of gold.</i>"
msgstr "<i>존재하지 않는 금더미의 위치를 알려준다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = 6c93cee1-d6b7-c9f3-949d-af9982fca1a2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_UnfortunateGnome_State_NonCharlatanAccess = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:6c93cee1-d6b7-c9f3-949d-af9982fca1a2
msgctxt "h1c47504fg081ag4905g931bg3450ff714231"
msgid "Y-you're a True Soul..."
msgstr "당-당신은 참된 영혼이시군요..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Narrator
#. NodeID = 6d88dbcb-878b-6e8c-cb94-d49c2adc400d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:6d88dbcb-878b-6e8c-cb94-d49c2adc400d
#, fuzzy
msgctxt "h973345e5gd354g4847g9cabgd66e5c33bc2f"
msgid "*The goblins slink backwards, afraid to take their eyes off you.*"
msgstr "*고블린은 당신에게서 눈을 떼지 못한 채, 뒤로 슬그머니 물러납니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Player
#. NodeID = 70fe9549-2be1-c352-5fe8-adf828d296ff
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Dialog:
#.      - WLD_GnomeGoblin1_AbandonNegotiations(2) = False
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:70fe9549-2be1-c352-5fe8-adf828d296ff
msgctxt "ha2ea355fg1683g4b24gb1fbg41cf99ecc760"
msgid "You dare refuse a <i>githyanki warrior</i>?"
msgstr "감히 <i>기스양키 전사를</i> 막아서겠다?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Player
#. NodeID = 70fe9549-2be1-c352-5fe8-adf828d296ff
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Dialog:
#.      - WLD_GnomeGoblin1_AbandonNegotiations(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:70fe9549-2be1-c352-5fe8-adf828d296ff
msgctxt "haf790eddgf290g4916g8292g8d7df7f84c29"
msgid "I won't let you harm a defenceless being - not without a fight."
msgstr "네가 무방비한 사람을 해치는 걸 맞서지 않고선 두고 볼 수 없겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Player
#. NodeID = 71eacf1d-a4bd-ce4a-83c5-958675b65c51
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
