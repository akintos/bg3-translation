msgctxt "h843e8049g57f4g4d6bg869fg646e814a7feb"
msgid "Where can I find the gith crèche?"
msgstr "기스의 양성소는 어디서 찾을 수 있지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead
#. Speaker = Player
#. NodeID = 73b47e85-f7db-f2a3-1e2b-0e346e5bf9eb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - ffb3cc3a-7e4b-eb7a-40a8-c6fab4614885_SaidGith = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead:73b47e85-f7db-f2a3-1e2b-0e346e5bf9eb
msgctxt "he5683883gff69g4966g97fdg0e9968b2701b"
msgid "Where did this monstrous warrior come from?"
msgstr "이 괴물 같은 전사들이 어디서 왔지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead
#. Speaker = Yul
#. NodeID = 749e8365-38aa-dff2-4980-45eec1637810
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead:749e8365-38aa-dff2-4980-45eec1637810
msgctxt "h1fa1a958g0325g410eg8792g6570a05473c3"
msgid "Like you..."
msgstr "너처럼..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead
#. Speaker = Yul
#. NodeID = 76c9c6fe-308c-f4c0-44bf-2c74a69fb0e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead:76c9c6fe-308c-f4c0-44bf-2c74a69fb0e7
msgctxt "hc4014526gf40ag47f1gafe5g23c756016703"
msgid "Mountain pass..."
msgstr "산길..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead
#. Speaker = Yul
#. NodeID = 7c588600-bef6-c237-78d3-98e445d54f90
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead:7c588600-bef6-c237-78d3-98e445d54f90
msgctxt "hceca292dge895g4cadg805cgccf11561951a"
msgid "Risen road... cross wooden bridge..."
msgstr "치솟은 길... 나무 다리를 건너..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead
#. Speaker = Yul
#. NodeID = 7ccc6f25-1b13-4df0-82c0-3909e7f440ff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead:7ccc6f25-1b13-4df0-82c0-3909e7f440ff
msgctxt "he2ef914fg9047g4713g9350g037885913a0e"
msgid "Seeking path... Baldur's Gate..."
msgstr "발더스 게이트로... 가는 길을 찾으려..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead
#. Speaker = Player
#. NodeID = 82194d5e-3e4b-4ff8-b2d9-90c321c2b0fa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Local:
#.     - ffb3cc3a-7e4b-eb7a-40a8-c6fab4614885_SaidGith = True
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead:82194d5e-3e4b-4ff8-b2d9-90c321c2b0fa
msgctxt "hfc35d44cg252ag4b08gb017g25e1015fadaa"
msgid "How did you die?"
msgstr "어떻게 죽었지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead
#. Speaker = Yul
#. NodeID = 8f736344-471c-375a-01f2-80e48c74b7d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead:8f736344-471c-375a-01f2-80e48c74b7d0
msgctxt "h36a2c0ffg64c0g43cegb8a1gc0ea168a1087"
msgid "Yes... Zorru fled... left me to fight..."
msgstr "그래... 조르는 도망쳤어... 나 혼자 싸우게 놔두고..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead
#. Speaker = Yul
#. NodeID = 93b40745-7d86-924e-1318-7c1e72e66a0c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead:93b40745-7d86-924e-1318-7c1e72e66a0c
msgctxt "hbfc62bacg1f3bg410ega09cgcd3199b73102"
msgid "No... with Zorru... fled to grove..."
msgstr "아니... 조르와 있었지만... 숲으로 도망쳤어..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead
#. Speaker = Player
#. NodeID = 944f1122-afdb-124f-8b79-bcde62ad3c78
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ThingLikeMe_Knows_AboutYul = True
#.   Local:
#.      - ffb3cc3a-7e4b-eb7a-40a8-c6fab4614885_SaidName = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Local:
#.     - ffb3cc3a-7e4b-eb7a-40a8-c6fab4614885_SaidZorru = True
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead:944f1122-afdb-124f-8b79-bcde62ad3c78
msgctxt "h334ae70agc8e4g4a2cg9217g7f4d3710f526"
msgid "Yul? Then you are Zorru's friend?"
msgstr "율이라고? 그럼 조르의 친구가 너로군?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead
#. Speaker = Yul
#. NodeID = a1dbef76-f735-3f32-eee0-8399f4790e47
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead:a1dbef76-f735-3f32-eee0-8399f4790e47
msgctxt "he3566bd0g7cfeg4f04gb8acg83d818899239"
msgid "Miller... in Elturel... before its fall..."
msgstr "엘투렐의... 추락 전에...방앗간 일을 했어..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead
#. Speaker = Yul
#. NodeID = c1aee402-d564-41b7-ab12-d19dd0ee529f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead:c1aee402-d564-41b7-ab12-d19dd0ee529f
msgctxt "hb6797bf4g5169g4f05ga95bgf4696457557e"
msgid "Yul... son of Gara..."
msgstr "율... 가라의 아들..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead
#. Speaker = Narrator
#. NodeID = c8043b1f-0321-4992-b732-1d1750977ee1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead:c8043b1f-0321-4992-b732-1d1750977ee1
msgctxt "he37ee4c3gde36g42fagbbdfge42015b7d7a7"
msgid "*The corpse does not stir. It will answer no more questions.*"
msgstr "*시체는 움직이지 않습니다. 더 이상 질문을 받지 않을 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead
#. Speaker = Narrator
#. NodeID = c901c389-aedf-456d-b34f-3853e91acf0c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead:c901c389-aedf-456d-b34f-3853e91acf0c
msgctxt "hd8ccf5a0g9762g4255ga085g648103f99009"
msgid "*The corpse regards you lifelessly.*"
msgstr "*시체가 생기 없는 모습으로 당신을 맞이합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead
#. Speaker = Player
#. NodeID = ca0564da-0323-45a8-abbc-3f2c27335a60
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Local:
#.     - ffb3cc3a-7e4b-eb7a-40a8-c6fab4614885_SaidName = True
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead:ca0564da-0323-45a8-abbc-3f2c27335a60
msgctxt "h1279363fg683eg4cefgaa1agf4e7e193ffd7"
msgid "Who are you?"
msgstr "너는 누구지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead
#. Speaker = Lae'zel
#. NodeID = d93bc1e8-f45d-f4d1-38be-c1e85c8297a1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - ffb3cc3a-7e4b-eb7a-40a8-c6fab4614885_SaidCreche = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead:d93bc1e8-f45d-f4d1-38be-c1e85c8297a1
msgctxt "he9d863acgb778g42d2g9f27gbe8c114a0c9c"
msgid ""
"He crossed blades with a githyanki. Few survive the ordeal. Fewer still "
"claim victory."
msgstr "기스양키와 칼을 맞댔군. 그 시련에서 살아남는 이는 별로 없지. 승리하는 자는 더 적고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead
#. Speaker = Narrator
#. NodeID = e13ef24b-8ce2-48f5-b568-c33e0215c0ef
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead:e13ef24b-8ce2-48f5-b568-c33e0215c0ef
msgctxt "h1bfdcc88g7f77g40b0g8e47g6530526fa5d9"
msgid "*The spell's power wanes. You can ask no more questions.*"
msgstr "*주문의 힘이 약해집니다. 더 이상 질문을 할 수 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead
#. Speaker = Wyll
#. NodeID = f77f995d-df97-4bde-8b45-fab6ab0c5ba2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead:f77f995d-df97-4bde-8b45-fab6ab0c5ba2
msgctxt "h18c87cf8gc2a4g4de2gabfage1c4ac364e10"
msgid "Zorru abandoned Yul to the githyanki. Damned coward."
msgstr "조르는 율을 기스양키에게 버려두고 도망갔군. 망할 겁쟁이 자식."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead
#. Speaker = Yul
#. NodeID = f8934cda-f2ad-4076-b44a-cf3b600585ce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead:f8934cda-f2ad-4076-b44a-cf3b600585ce
msgctxt "h7fa67942g4f04g4bc7gac4cga56c6fe37c4a"
msgid "Monstrous warriors... keen swords... black spots..."
msgstr "괴물 같은 전사들... 날카로운 검... 검은 점..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead
#. Speaker = Player
#. NodeID = fae03d1c-ce05-b264-fece-9680fe059b9e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - ffb3cc3a-7e4b-eb7a-40a8-c6fab4614885_SaidZorru = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead:fae03d1c-ce05-b264-fece-9680fe059b9e
msgctxt "h8f28f028gcfc3g4a6ag9ed0gc8f8c880f792"
msgid "Were you and Zorru scouting alone?"
msgstr "너와 조르는 각자 혼자 정찰을 했나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead
#. Speaker = Player
#. NodeID = fda80ff3-40f2-4519-c751-6d158cefb936
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead:fda80ff3-40f2-4519-c751-6d158cefb936
msgctxt "h72c322bag5ca0g41e2g8791g80f956b67525"
msgid "What was your profession?"
msgstr "무슨 일을 했나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_HarperSkeleton_PAD
#. Speaker = Player
#. NodeID = 14dbe83d-bc1d-4e8e-8b0a-e4dd9f724255
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_HarperSkeleton_PAD:14dbe83d-bc1d-4e8e-8b0a-e4dd9f724255
msgctxt "ha31bba6egc47dg4334ga8fbga71fcd828b10"
msgid "Some old, forgotten bones."
msgstr "오래되고 잊힌 해골들일 뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_HarperSkeleton_PAD
#. Speaker = Player
#. NodeID = 14dbe83d-bc1d-4e8e-8b0a-e4dd9f724255
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_HarperSkeleton_PAD:14dbe83d-bc1d-4e8e-8b0a-e4dd9f724255
msgctxt "h7cda9d73g40b4g4085g96dega50a8107e7c5"
msgid "These bones speak of some old, long-forgotten tragedy."
msgstr "이 해골들이 오래전 잊힌 비극을 말해주고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_HarperSkeleton_PAD
#. Speaker = Player
#. NodeID = 14dbe83d-bc1d-4e8e-8b0a-e4dd9f724255
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_HarperSkeleton_PAD:14dbe83d-bc1d-4e8e-8b0a-e4dd9f724255
msgctxt "hd226328bg04aag415fga983g0795ec86ea7b"
msgid "Ancient bones, long forgotten."
msgstr "오래 전 잊힌 해골이로군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_HarperSkeleton_PAD
#. Speaker = Player
#. NodeID = 14dbe83d-bc1d-4e8e-8b0a-e4dd9f724255
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_HarperSkeleton_PAD:14dbe83d-bc1d-4e8e-8b0a-e4dd9f724255
msgctxt "h3da842b3gbd2fg4c31gaa69gd5d26e21a17e"
msgid "Fallen warriors, their days of glory long since passed."
msgstr "죽은 전사들이야. 그들이 누렸던 영광의 나날은 오래 전에 지났어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_HarperSkeleton_PAD
#. Speaker = Player
#. NodeID = 14dbe83d-bc1d-4e8e-8b0a-e4dd9f724255
