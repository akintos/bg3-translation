msgctxt "h69d57fb1g9df9g4fcfg8ee0g24f650975e8d"
msgid "To Tyr, maimed and mighty!"
msgstr "강인한 외팔의 신, 티르를 위하여!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Player
#. NodeID = f29720cb-f396-5e5a-5900-5ac9cee1fea4
