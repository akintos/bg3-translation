msgctxt "h4538a1b8ga7d1g491dgbe6dge1a378351f5d"
msgid "Take it down a notch - we managed to stop it, didn't we?"
msgstr "진정해. 우리가 그걸 막아냈잖아, 안 그래?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_DeactivateLance
#. Speaker = Player
#. NodeID = e027e933-1ef9-4ebd-853f-59618e71dbff
