msgctxt "h85947ae8g6403g4107ga93dg95579fac54a3"
msgid "All right."
msgstr "알았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SecludedSpot_Trespassing
#. Speaker = Brawler Rancer
#. NodeID = 25613066-ed8d-9836-5495-68bd8d3c067b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SecludedSpot_Trespassing:25613066-ed8d-9836-5495-68bd8d3c067b
msgctxt "hb1be0ec5g75c5g4e69gbbe5g0a567cbb043e"
msgid "Outta my bowl!"
msgstr "내 그릇에서 꺼져!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SecludedSpot_Trespassing
#. Speaker = Player
#. NodeID = 30847cbd-fa2e-8b23-3db1-ebadffac9d68
