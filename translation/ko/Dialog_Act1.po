msgid "My queen spoke to me. You have failed - your death has been decreed."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_TemplarStartsFight
#. Speaker = Ch'r'ai W'wargaz
