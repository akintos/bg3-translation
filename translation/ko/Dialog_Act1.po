msgctxt "h523644f2ga66fg457dg901bg374688fe291f"
msgid "Gnolls are everywhere. And I do mean <i>everywhere.</i>"
msgstr "놀이 사방에 있다. 진짜 <i>사방에</i> 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_VB_PostFight_3P
#. Speaker = Player
#. NodeID = fed53506-ac7e-5661-f08e-cfaf9032cda5
