#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinKid002_LootingCrime:71301b26-b54d-4b0e-d06a-b85e58417a8e
msgctxt "h2f1a343dgd64dg4e98ga79bgc88f2688a570"
msgid "Oh yeah? I don't need my mum to deal with some crummy pig like you."
msgstr "오 그래? 난 너 같은 더러운 돼지와 싸우는 데 엄마의 도움을 필요로 하지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinKid002_LootingCrime
#. Speaker = Eight
#. NodeID = 7fc040aa-7b07-0e2d-a6f4-7416d69825c2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_Festivities_Event_KidsRun = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinKid002_LootingCrime:7fc040aa-7b07-0e2d-a6f4-7416d69825c2
msgctxt "hde59adedg33f3g42d1ga5ceg8a7a202131a4"
msgid "There is? Shite, let's go, guys, 'fore One realises."
msgstr "그래? 썅, 가자, 얘들아, 첫째가 알아차리기전에."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinKid002_LootingCrime
#. Speaker = Player
#. NodeID = 82f98e41-3ff0-4ff2-7e27-b24c82f00b3f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinKid002_LootingCrime:82f98e41-3ff0-4ff2-7e27-b24c82f00b3f
msgctxt "hd42d5d1age4e8g4fb6gbaf7gab77f9636b8f"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinKid002_LootingCrime
#. Speaker = Narrator
#. NodeID = 85bef99f-a3f2-c5fd-d44c-05bb9d4885b5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount1(1) = False
