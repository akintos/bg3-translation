msgctxt "h85a47439g1cebg4b97ga279g67c15778d4b4"
msgid "Do I look like a bloody tour guide?"
msgstr "내가 뭔 여행 가이드 같아 보이냐?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Blue Jay
#. NodeID = 08f15ab0-05c4-2465-8f40-7c03d3162929
