msgctxt "h74ec9b9eg740bg42cbgb5b6ge0d719d9e4d0"
msgid "Burned from the inside out. Whose work is this, I wonder?"
msgstr "안쪽에서부터 불타올랐어. 대체 누구의 작품일까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/VBs/GOB_WarlockProposal_PAD_OgreBurned
