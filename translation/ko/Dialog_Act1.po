#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Library_PAD_GremiskaCryReaction
#. Speaker = Player
#. NodeID = 5074f54a-e03c-45da-84c1-21f0c0f4515a
