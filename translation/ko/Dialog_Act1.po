msgctxt "h1dca994cg2b18g4da5g8114g45f820b4334d"
msgid "*Hiss!*"
msgstr "*쉬익!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_Spider02
#. Speaker = Lur Jox
#. NodeID = 6ef2a579-6ad5-4af2-9c47-3cb670a36716
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_SpiderFight_Spider02_HasMet_SWA(1) = False
#.   Tag:
#.      - PETPAL(1) = True
#. SetFlags:
#.   Dialog:
#.     - UND_SpiderFight_Spider02_HasMet_SWA(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_Spider02:6ef2a579-6ad5-4af2-9c47-3cb670a36716
msgctxt "h36582cc4g71cbg4848gb0c9gb8e61ebcf99e"
msgid ""
"You heard her. Xanta was a betrayer. We will miss her. But she was "
"<i>wrong.</i>"
msgstr "들었지. 잔타는 배신자였어. 우리는 그녀를 그리워할 거야. 하지만 그녀는 <i>틀렸어.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_Spider02
#. Speaker = Lur Jox
#. NodeID = f5614f7d-84b1-4482-b41b-0912610a406f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_SpiderFight_Spider02_HasMet_SWA(1) = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_Spider02:f5614f7d-84b1-4482-b41b-0912610a406f
msgctxt "h17b9896ag5f9bg4564gac2fg659756955700"
msgid "Watch yourself. We defend Father Murmath. At all costs."
msgstr "조심해. 우린 어떤 대가를 치러서라도 파더 무르마스를 보호할 거니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_Spider02
