msgid "<i>Hah! </i>"
msgstr "<i>하!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_AD_EscortingCultistsChatter
#. Speaker = Mahrin
