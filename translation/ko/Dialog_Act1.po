msgctxt "h39350ed2g8695g4cd0g9c55gced6590362fa"
msgid "You don't need to tell me twice, boss."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinSleeper_02
#. Speaker = Booyahg Culk
#. NodeID = ef4afa6e-c1ca-bc2e-1da0-b671558dec13
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Festivities_GoblinSleeper02_HasMet(1) = False
