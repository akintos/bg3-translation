msgctxt "ha445a673gbf12g4657g89deg48a9d69d8970"
msgid "In Vlaakith's name!"
msgstr "블라키스 님의 이름으로!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_AD_TemplarCombatThirdLine
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = f0b9c64f-1685-44de-bc3d-823cabba798b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_AD_TemplarCombatThirdLine:f0b9c64f-1685-44de-bc3d-823cabba798b
msgctxt "h7cc47c36g1d71g4d80gb7d8g34c55beb455d"
msgid "Impressive resistance. But futile."
msgstr "저항하는 것이 인상적이군. 하지만 쓸모 없는 짓이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_AD_TemplarGreeting
#. Speaker = Ch'r'ai W'wargaz
