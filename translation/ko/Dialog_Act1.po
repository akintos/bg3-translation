msgctxt "h7d085366gc622g45dfga12dg9b999b9d3c97"
msgid "Her... embrace."
msgstr "그녀의... 품속."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Xanta
#. NodeID = 111ed3c8-dc5b-d134-fdb0-ac0b9e7c3464
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:111ed3c8-dc5b-d134-fdb0-ac0b9e7c3464
msgctxt "h745377d9g986cg4cfega0bcg043d13deed03"
msgid ""
"The time for planning is over! Follow me, brothers - into her hairy embrace!"
msgstr "계획 시간은 끝났어! 나를 따라, 형제들이여 - 그녀의 수북한 품속으로!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Fu
#. NodeID = 1126b648-6565-ef84-4e0f-9296a814402c
