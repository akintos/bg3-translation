msgctxt "h8726bc7cg521dg44bdgb8a5g15962baed81d"
msgid "Gods preserve us."
msgstr "신이 우리를 지켜주시길."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_TraineesAfterAttack
#. Speaker = Ide
#. NodeID = 1c718bfe-ad55-f853-1aed-07fd96fbf2b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_TraineesAfterAttack:1c718bfe-ad55-f853-1aed-07fd96fbf2b4
msgctxt "h406edbb9g37eag4daaga222gd4dac47e4046"
msgid "No one likes us. Cause we're tieflings."
msgstr "아무도 우리 안 좋아해. 우린 티플링이잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_TraineesAfterAttack
#. Speaker = Ide
#. NodeID = 325947a0-b85d-75e0-6887-69a22d196c0c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - da38cd0f-efef-6809-231d-26f71308cd07_B = True
#. SetFlags:
#.   Local:
#.     - da38cd0f-efef-6809-231d-26f71308cd07_C = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_TraineesAfterAttack:325947a0-b85d-75e0-6887-69a22d196c0c
msgctxt "ha395c1d7gf7a9g4474gb99cg1083c97ea2bb"
msgid "Were you afraid?"
msgstr "무서웠어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_TraineesAfterAttack
#. Speaker = Ide
#. NodeID = 33dc9c03-d890-4c58-50b1-817b03a1a718
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_TraineesAfterAttack:33dc9c03-d890-4c58-50b1-817b03a1a718
msgctxt "h8e3ffd25g44afg4e1bg8e8eg7be6c47ec78b"
msgid "Don't say that. It's their fault, not ours."
msgstr "그런 말 하지 마. 우리가 아니라 딴 놈들이 나쁜 거라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_TraineesAfterAttack
#. Speaker = Gan
#. NodeID = 40b6d0a7-bbb8-da2c-623d-a94276747c79
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_TraineesAfterAttack:40b6d0a7-bbb8-da2c-623d-a94276747c79
msgctxt "h77c5536ag76d4g4c5eg8ad8ge50b73ec9f4a"
msgid "Did not."
msgstr "아니거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_TraineesAfterAttack
#. Speaker = Gan
#. NodeID = 5735553d-706e-ce11-dbb3-0885f43957bc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - da38cd0f-efef-6809-231d-26f71308cd07_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_TraineesAfterAttack:5735553d-706e-ce11-dbb3-0885f43957bc
msgctxt "he18d2933g0969g4316gb455g96932bd671e5"
msgid "Where do you think your mum is now?"
msgstr "너희 엄마는 지금 어디에 계실 거 같아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_TraineesAfterAttack
#. Speaker = Ide
#. NodeID = 59d96e24-7abe-28ea-f628-62e77215af10
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_TraineesAfterAttack:59d96e24-7abe-28ea-f628-62e77215af10
msgctxt "hd782ec87g14aeg4267g9e4fg5729693c3116"
msgid "I think I was too."
msgstr "나도 그랬던 것 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_TraineesAfterAttack
#. Speaker = Gan
#. NodeID = 6ff1c554-acfb-0213-70ea-5aafbcdea603
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_TraineesAfterAttack:6ff1c554-acfb-0213-70ea-5aafbcdea603
msgctxt "hc0c6b7c0gad08g408bgaedag99b85e7d3da5"
msgid "Yeah. I think so."
msgstr "응. 아마도."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_TraineesAfterAttack
#. Speaker = Gan
#. NodeID = 8eba8ac3-38c1-7d42-6ada-a6b391bdcfcf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_TraineesAfterAttack:8eba8ac3-38c1-7d42-6ada-a6b391bdcfcf
msgctxt "ha6d8869ag12bfg4beeg868ag86dab13015e9"
msgid "Being a tiefling tosses chanks."
msgstr "티플링으로 사는 거 진짜 거지 같네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_TraineesAfterAttack
#. Speaker = Ide
#. NodeID = aa1194f0-0687-ba84-b729-77a196fad620
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_TraineesAfterAttack:aa1194f0-0687-ba84-b729-77a196fad620
msgctxt "h8d2d59ebg75a5g42cfga8fag62ed8d3bf62e"
msgid "You just didn't see."
msgstr "너가 못 본 거겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_TraineesAfterAttack
#. Speaker = Ide
#. NodeID = bc9ed8f5-8515-a6a4-6cf6-e885af3e0e30
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_TraineesAfterAttack:bc9ed8f5-8515-a6a4-6cf6-e885af3e0e30
msgctxt "h70284b9eg8cd5g4ccfgaedag8deddc4c8b37"
msgid "Dunno. Somewhere good. Far away. I hope."
msgstr "몰라. 좋은 데 계시겠지. 아주 먼 곳에. 그럼 좋겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_TraineesAfterAttack
#. Speaker = Ide
#. NodeID = cd2df568-bcca-3cdf-9cdd-2ae6a222ffc6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - da38cd0f-efef-6809-231d-26f71308cd07_C = True
#. SetFlags:
#.   Local:
#.     - da38cd0f-efef-6809-231d-26f71308cd07_C = False
#.     - da38cd0f-efef-6809-231d-26f71308cd07_A = False
#.     - da38cd0f-efef-6809-231d-26f71308cd07_B = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_TraineesAfterAttack:cd2df568-bcca-3cdf-9cdd-2ae6a222ffc6
msgctxt "hb6418c4egc2feg44ebg8d29gceb381f29f01"
msgid "I got three. Or five. I forget."
msgstr "나 셋 해치웠어. 아니 다섯인가. 까먹었다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_TraineesAfterAttack
#. Speaker = Gan
#. NodeID = e42b21ae-2181-106c-f7c8-dc2e42806f42
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - da38cd0f-efef-6809-231d-26f71308cd07_A = True
#. SetFlags:
#.   Local:
#.     - da38cd0f-efef-6809-231d-26f71308cd07_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_TraineesAfterAttack:e42b21ae-2181-106c-f7c8-dc2e42806f42
msgctxt "hc5350d95gdbeag4fefgbe71g3a0ba7ac2392"
msgid "Why didn't those druids like us?"
msgstr "왜 드루이드들은 우릴 좋아하지 않는 걸까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_Trainer
#. Speaker = Asharak
#. NodeID = 05d15e83-a8f7-7c34-7539-342ac92b5d2f
