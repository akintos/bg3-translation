#.     - GOB_Checkpoint_State_Paint(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:8f2cdc27-1b33-0c2f-09fc-bec4c420efd9
msgctxt "h1d6e6ecagc55dg4a9eg9447gfc4782027bb1"
msgid "Go on, mate. Enjoy the festivities. You earned it!"
msgstr "계속 가, 친구. 축제를 즐기라고. 넌 자격을 얻었어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = 8f8bfeb8-4db3-34d9-7b4c-ceb883200aac
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_Checkpoint_State_GainedAccess = True
#.     - GOB_Checkpoint_State_PretendedToBeTrueSouls = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:8f8bfeb8-4db3-34d9-7b4c-ceb883200aac
msgctxt "h01e2d5fagcde1g4eb2g9105g9f8df551a365"
msgid "Easy, lads! We got a True Soul comin' through!"
msgstr "진정해, 얘들아! 참된 영혼이 지나가신다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = 90b6963f-3c39-cd3c-56c1-1c29cc3d6be0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:90b6963f-3c39-cd3c-56c1-1c29cc3d6be0
msgctxt "h8662d549g6544g428bg8440gb4afc48f1abd"
msgid "<i>Nordil... worgater...</i>"
msgstr "<i>노르딜... 워가터...</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Narrator
#. NodeID = 9296982e-4147-248f-ab87-98bf18c6b0dd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount6(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount6(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:9296982e-4147-248f-ab87-98bf18c6b0dd
msgctxt "hb5fdb02bg3486g452cg93ddgb0935cc314aa"
msgid ""
"*The presence deep in your mind is awake, unblinking. This is it. A single "
"word pervades your consciousness: 'Soon'.*"
msgstr ""
"*당신의 정신 속 깊이 자리잡은 존재가 태연스레 깨어납니다. 올 것이 왔군요. 한 단어가 당신의 의식 속으로 스며듭니다. ‘곧’*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Player
#. NodeID = 95d05025-fdfc-0b0a-8204-9945bbcd6d5a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:95d05025-fdfc-0b0a-8204-9945bbcd6d5a
msgctxt "h9c30a537ga4e4g4a06gbe42g13d7a07848f9"
msgid "Absolutely not."
msgstr "절대 안해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Player
#. NodeID = 974b4aba-03b3-86ff-ee77-1191d092be87
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - eaea790d-b9b8-b786-370a-5466a9185c91_MINDREAD = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:974b4aba-03b3-86ff-ee77-1191d092be87
msgctxt "h95ada7d4g386eg4a44ga96cg4184103764e5"
msgid "I'm a messenger - here to see Minthara."
msgstr "나는 전령이다. 민타라를 만나러 왔다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Player
#. NodeID = 992dec89-bfc8-adb6-8a19-cd8a57dcefbb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Checkpoint_State_AskedAboutCamp(1) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_Checkpoint_State_AskedAboutCamp(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:992dec89-bfc8-adb6-8a19-cd8a57dcefbb
msgctxt "h5f0fb6a0gf115g4dd8gb579g6e740e54b715"
msgid "That noise coming from behind you: good or bad?"
msgstr "너의 뒤에서 들리는 소리 말인데, 좋은 건가, 나쁜 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = 993f7a43-0e17-d79e-cb7e-65a64dfd1d46
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:993f7a43-0e17-d79e-cb7e-65a64dfd1d46
msgctxt "h2ed22590g3007g4312g9c42g862d439f1bfd"
msgid "Go on. Don't skimp, neither!"
msgstr "얼른 해. 아낌없이 바르란 말이야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = 9b23cb57-2c38-b65f-c51f-cfd87862cb97
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_Checkpoint_State_SucceededBarbarianIntimidation = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:9b23cb57-2c38-b65f-c51f-cfd87862cb97
#, fuzzy
msgctxt "h9d24ec32g0517g40c3ga159g0439e9ce0f55"
msgid ""
"A-all right! All right! Calm down, I'll do it... just give me a moment to... "
"<i>ugh</i>..."
msgstr "아-알았어! 알았어! 진정해, 할게 그... 잠시만... <i>윽</i>..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = 9cada403-eaf7-6fb0-e3bb-d10a4f44be59
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:9cada403-eaf7-6fb0-e3bb-d10a4f44be59
msgctxt "h618cd20bgcfc9g41f1g8b89g16f0cf935c52"
msgid ""
"Good for you, mate. Now get out of my sight before my worg rips you a new "
"hole."
msgstr "잘됐네, 친구야. 내 워그가 너를 찢어서 새 구멍을 만들기 전에 당장 내 앞에서 꺼져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = 9d049502-c1b5-e684-440e-794c881df119
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_Knows_LeaderNameKing = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:9d049502-c1b5-e684-440e-794c881df119
msgctxt "h68b848c2g1668g4bf4gb5c0gb98582b4f8c9"
msgid ""
"If you're 'ere to see Dror Ragzlin, you'll wanna let 'im and the lads know "
"you're one of us."
msgstr "드롤 라그즐린 님을 보러 왔다면, 그분과 이 애들한테 너가 우리 편이라는 걸 보여줘야 할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = 9f929022-fdfc-1da4-c37b-16fc0223f801
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_Knows_LeaderNameKing = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:9f929022-fdfc-1da4-c37b-16fc0223f801
msgctxt "hf6f59737g031ag4a35gbd1fgbd07ea5a1460"
msgid "Right. Dror Ragzlin's inside, in through the temple."
msgstr "그래. 드롤 라그즐린께선 저 안에 계신다. 신전으로 들어가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = a3bfe113-ed46-13cd-6195-b697ff85352d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:a3bfe113-ed46-13cd-6195-b697ff85352d
msgctxt "ha6b89f3agffe4g404cg946egaeb8c5904e37"
msgid "Heh. Just a bit of fun."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Player
#. NodeID = a90043fe-1de8-4431-9ab9-f291c1ac6bdf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:a90043fe-1de8-4431-9ab9-f291c1ac6bdf
msgctxt "h3df199b0gd4aeg4181ga013g4ae95bf2d472"
msgid "<i>Follow the rules.</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = abeeb5b0-ec47-ee8c-8835-ea62a058a563
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:abeeb5b0-ec47-ee8c-8835-ea62a058a563
msgctxt "h88bc3557g5f2fg4c5cgb2d1g1af271fb23ec"
msgid ""
"Dumb as a rock, but world class at tearin' the throats outta wee ones, she "
"is."
msgstr "돌머리 바보지만, 쬐그만 녀석들의 목을 물어뜯는 데는 세계 최고 수준이라구."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Narrator
#. NodeID = ad3922ea-ff5d-945c-888a-173c8d9be407
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
