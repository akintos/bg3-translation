msgctxt "hfe0e6015g45fag46a5g9de4g2414cbf7448e"
msgid "*As your lips touch filthy flesh, you catch a whiff of... lavender?*"
msgstr "*당신의 입술이 더러운 살갗에 닿자, 어떤 냄새가 풍깁니다... 라벤더 향?*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = 559472fa-1351-3846-ffea-136b04aee6b7
