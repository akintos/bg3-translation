msgctxt "h3b89a1efge2a2g4230g855bgb8ab677cfd83"
msgid "*The corpse regards you lifelessly.*"
msgstr "*시체가 생기 없는 모습으로 당신을 맞이합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FairyRings_Dead
#. Speaker = Narrator
#. NodeID = 23943b3d-4334-e9d7-9827-45616302ca03
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FairyRings_Dead:23943b3d-4334-e9d7-9827-45616302ca03
msgctxt "h00b5ddcfg897fg4765gbfb8g5592fc0cea2f"
msgid "*The corpse does not stir. It will answer no more questions.*"
msgstr "*시체는 움직이지 않습니다. 더 이상 질문을 받지 않을 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FairyRings_Dead
#. Speaker = Narrator
#. NodeID = 355543b8-6321-b414-d3f7-1ca9238cc34c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FairyRings_Dead:355543b8-6321-b414-d3f7-1ca9238cc34c
msgctxt "hc7e62c0bg2126g437eg9072g2fc7a49069d8"
msgid "*The spell's power wanes. You can ask no more questions.*"
msgstr "*주문의 힘이 약해집니다. 더 이상 질문을 할 수 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FairyRings_Dead
