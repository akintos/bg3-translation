msgid "No use trying to figure out what happened a hundred years ago."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted_Solo
#. Speaker = Player
#. NodeID = e6efb7c2-676b-4fdb-9d28-8bc04e9cdbf6
