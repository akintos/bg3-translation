msgctxt "h7cf27d5eg0032g4a51ga5d7g77f80cf3e2aa"
msgid "Off we go, then."
msgstr "그럼 출발해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin7_AD_Leaving
#. Speaker = Goblin Tracker
