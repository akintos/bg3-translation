#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent05_AD_Idle:6550f0db-2110-7629-a198-df8cc917582f
msgctxt "hed9c2451ga6ceg4e9bg8e02g0cf7bc327d30"
msgid "Thought I was paid to crack heads, not stack bloody boxes."
msgstr "대가리를 쪼개라고 돈을 받는 줄 알았는데, 상자나 쌓는 게 아니라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent05_AD_Idle
#. Speaker = Bellar
#. NodeID = 9ab633ff-7c55-db96-6421-0adfb0376be8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 37e0bbad-2869-1ed3-4cee-40f89443cc5a_B = False
#.      - 37e0bbad-2869-1ed3-4cee-40f89443cc5a_C = False
#.      - 37e0bbad-2869-1ed3-4cee-40f89443cc5a_A = False
#. SetFlags:
#.   Local:
#.     - 37e0bbad-2869-1ed3-4cee-40f89443cc5a_A = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent05_AD_Idle:9ab633ff-7c55-db96-6421-0adfb0376be8
msgctxt "h90e8de4bgd4e1g427aga0b5ge45c78355c4b"
msgid "Reckon I might actually miss this place."
msgstr "이곳을 정말로 그리워할지도 모르겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent05_AD_Idle
#. Speaker = Bellar
#. NodeID = cde6a864-f647-92c9-6832-d18aeab78a85
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 37e0bbad-2869-1ed3-4cee-40f89443cc5a_B = False
#.      - 37e0bbad-2869-1ed3-4cee-40f89443cc5a_C = False
#.      - 37e0bbad-2869-1ed3-4cee-40f89443cc5a_A = True
#. SetFlags:
#.   Local:
#.     - 37e0bbad-2869-1ed3-4cee-40f89443cc5a_B = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent05_AD_Idle:cde6a864-f647-92c9-6832-d18aeab78a85
msgctxt "h40c08afeg0005g4fa2g9ccfg185c0be6cba6"
msgid ""
"Belt-knife, check. Boot-knife, check. Jock-kni - argh! Helm's hanging orbs, "
"that hurt."
msgstr "허리칼, 확인. 부츠칼, 확인. 잭나이프 - 악! 헬름의 매달린 보주여 맙소사, 아파라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent05_AD_Idle
#. Speaker = Bellar
#. NodeID = cfd231d6-099d-b2b4-574d-2b926cfec014
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 37e0bbad-2869-1ed3-4cee-40f89443cc5a_B = True
#.      - 37e0bbad-2869-1ed3-4cee-40f89443cc5a_C = False
#.      - 37e0bbad-2869-1ed3-4cee-40f89443cc5a_A = True
#. SetFlags:
#.   Local:
#.     - 37e0bbad-2869-1ed3-4cee-40f89443cc5a_C = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent05_AD_Idle:cfd231d6-099d-b2b4-574d-2b926cfec014
msgctxt "haa29b2e7gc7a4g4ebdgbf27g8b91532b10cb"
msgid "Don't know why we don't just kill those Fist."
msgstr "왜 그 '피스트'들을 그냥 죽여버리지 않는 건지 모르겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent06
#. Speaker = Jarg
#. NodeID = 0e687f70-61db-69e0-ef85-86165d9fc91c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_ZhentDungeon_Zhent06_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent06:0e687f70-61db-69e0-ef85-86165d9fc91c
msgctxt "h4f15329egdb2cg458cg8102g0aa2fff358c1"
msgid ""
"Wanna pick out the true Zhent? Tell 'em they're going down into the "
"Underdark."
msgstr "진짜 젠트를 고르고 싶어? 그들에게 언더다크로 내려가게 될 거라고 말해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent06
#. Speaker = Jarg
#. NodeID = 86b544c9-cba9-a32e-3c02-a9cbb906847f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent06:86b544c9-cba9-a32e-3c02-a9cbb906847f
msgctxt "h1926e27bg45a1g46c1gb0a7gea0661ef9626"
msgid ""
"While everyone else is bawling, they'll be the ones asking about hazard pay."
msgstr "다른 사람들은 소리지르며 울고 있을 때, 그들은 위험수당에 대해 물어볼 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent06
#. Speaker = Jarg
#. NodeID = b6f8e1d9-8026-15fc-a1c3-64b468992d13
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_ZhentDungeon_Zhent06_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - PLA_ZhentDungeon_Zhent06_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent06:b6f8e1d9-8026-15fc-a1c3-64b468992d13
msgctxt "haa817e42g810dg4f05ga659g90d80073c346"
msgid "Had a peach of a shot on you as you came in."
msgstr "당신이 걸어들어올 때 완벽하게 보고 있었다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent06_AD
#. Speaker = Jarg
#. NodeID = 2e5e4fa7-6c7f-f801-e3e7-6c762edac1ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent06_AD:2e5e4fa7-6c7f-f801-e3e7-6c762edac1ed
msgctxt "h960da60eg3425g4468gb178g1e8c1a21f540"
msgid "Rich too, hopefully."
msgstr "부자기도 했으면 좋겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent06_AD
#. Speaker = Jarg
#. NodeID = 55554e3d-e640-9587-42c3-cee1eaa8b2f4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 16193247-ccea-1974-45ec-e8229a7de4ef_A = True
#.      - 16193247-ccea-1974-45ec-e8229a7de4ef_B = True
#.      - 16193247-ccea-1974-45ec-e8229a7de4ef_C = True
#. SetFlags:
#.   Local:
#.     - 16193247-ccea-1974-45ec-e8229a7de4ef_A = False
#.     - 16193247-ccea-1974-45ec-e8229a7de4ef_B = False
#.     - 16193247-ccea-1974-45ec-e8229a7de4ef_C = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent06_AD:55554e3d-e640-9587-42c3-cee1eaa8b2f4
msgctxt "h64bc8275g68fbg42a7g8747gd202b125c86e"
msgid ""
"Gonna take Bellar for all he's worth. Soon as I win my dice back from him..."
msgstr "벨라를 완전히 벗겨 먹을 거야. 내 주사위를 녀석에게서 다시 따내기만 하면..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent06_AD
#. Speaker = Jarg
#. NodeID = b078ee58-6e03-8eb4-a721-fc4a61ea0a9b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 16193247-ccea-1974-45ec-e8229a7de4ef_A = False
#.      - 16193247-ccea-1974-45ec-e8229a7de4ef_B = False
#.      - 16193247-ccea-1974-45ec-e8229a7de4ef_C = False
#. SetFlags:
#.   Local:
#.     - 16193247-ccea-1974-45ec-e8229a7de4ef_A = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent06_AD:b078ee58-6e03-8eb4-a721-fc4a61ea0a9b
msgctxt "h8bd6a01cg4be0g4c96g819eg4b5401ba8b18"
msgid "Another damn day in this cave."
msgstr "또 이 거지 같은 동굴에서의 하루가 시작되었군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent06_AD
#. Speaker = Jarg
#. NodeID = c3f85ee2-5fd0-8ff2-8fd6-ba537c970e58
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 16193247-ccea-1974-45ec-e8229a7de4ef_A = True
#.      - 16193247-ccea-1974-45ec-e8229a7de4ef_B = False
#.      - 16193247-ccea-1974-45ec-e8229a7de4ef_C = False
#. SetFlags:
#.   Local:
#.     - 16193247-ccea-1974-45ec-e8229a7de4ef_B = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent06_AD:c3f85ee2-5fd0-8ff2-8fd6-ba537c970e58
msgctxt "hc7f47f97g9729g42eeg9d89g6b2989586616"
msgid ""
"Down into the Underdark. Reckon I'll be old by the time I see the sun again."
msgstr "언더다크로 가는군. 태양을 다시 보려면 시간이 아주 오래 걸리겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent06_AD
#. Speaker = Jarg
#. NodeID = f082608f-7514-a183-ed73-0589e50eb8f0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 16193247-ccea-1974-45ec-e8229a7de4ef_A = True
#.      - 16193247-ccea-1974-45ec-e8229a7de4ef_B = True
#.      - 16193247-ccea-1974-45ec-e8229a7de4ef_C = False
#. SetFlags:
#.   Local:
#.     - 16193247-ccea-1974-45ec-e8229a7de4ef_C = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent06_AD:f082608f-7514-a183-ed73-0589e50eb8f0
msgctxt "hca1e5449g5988g47bcgbd53g07ec0efb8e07"
msgid "This cut... does <i>not</i> smell right..."
msgstr "이거... 냄새가... 이상한데..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent06_AD_Combat
#. Speaker = Jarg
#. NodeID = 2324ee65-bd0a-4627-b5b3-258430115aa0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent06_AD_Combat:2324ee65-bd0a-4627-b5b3-258430115aa0
msgctxt "h46332712gcba5g4f88g9d8dg19959c093a32"
msgid "You've messed up. At least you won't live to regret it!"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent07
#. Speaker = Vol
#. NodeID = 32d0c48a-b348-860b-5a01-64294af9dab8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_ZhentDungeon_Zhent07_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent07:32d0c48a-b348-860b-5a01-64294af9dab8
msgctxt "h83d8913cgdd57g480egb220g07899bb308c6"
msgid "Didn't I tell you to move along?"
msgstr "내가 가라고 하지 않았나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent07
#. Speaker = Vol
#. NodeID = 6799951a-db55-dee2-689e-bb56552ae1fd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_ZhentDungeon_Zhent07_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - PLA_ZhentDungeon_Zhent07_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent07:6799951a-db55-dee2-689e-bb56552ae1fd
msgctxt "h426b94c8g3fa6g40ddg9a5fgeb5494655b09"
msgid "Nothing to see here. Move along."
msgstr "여긴 볼 거 없어. 저리 가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent07_AD
#. Speaker = Vol
#. NodeID = 0107f6dd-5abd-99c3-924e-e0c16315b280
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - b170f4e0-b35a-7cac-d62e-9b9aafb32220_C = False
#.      - b170f4e0-b35a-7cac-d62e-9b9aafb32220_B = False
#.      - b170f4e0-b35a-7cac-d62e-9b9aafb32220_A = False
#. SetFlags:
#.   Local:
#.     - b170f4e0-b35a-7cac-d62e-9b9aafb32220_A = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent07_AD:0107f6dd-5abd-99c3-924e-e0c16315b280
msgctxt "h41823fa3g59abg4602gbfc5ga51baf891037"
msgid "Be just my luck to have the barrels go off in this damp."
msgstr "이 축축한 곳에서 저 통들을 터뜨리려면 운이 좋아야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent07_AD
#. Speaker = Vol
#. NodeID = 4d7f741d-4fd0-e0d4-bae1-6f5e93701479
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - b170f4e0-b35a-7cac-d62e-9b9aafb32220_C = False
#.      - b170f4e0-b35a-7cac-d62e-9b9aafb32220_B = False
#.      - b170f4e0-b35a-7cac-d62e-9b9aafb32220_A = True
#. SetFlags:
#.   Local:
#.     - b170f4e0-b35a-7cac-d62e-9b9aafb32220_B = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent07_AD:4d7f741d-4fd0-e0d4-bae1-6f5e93701479
msgctxt "hab390150g7dc0g4fa0ga96agdea79acc9157"
msgid ""
"Underdark run is just what this crew needs. Slice away the chaff, bigger "
"shares for the strong."
msgstr "언더다크로 향하는 길이 이 팀에 딱 필요한 거야. 쭉정이들은 잘라내고, 살아남은 이들에게 더 큰 몫을 주는 거지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent07_AD
#. Speaker = Vol
#. NodeID = b2312ed8-f3d4-b6ca-731c-72a8ff317745
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - b170f4e0-b35a-7cac-d62e-9b9aafb32220_C = False
#.      - b170f4e0-b35a-7cac-d62e-9b9aafb32220_B = True
#.      - b170f4e0-b35a-7cac-d62e-9b9aafb32220_A = True
#. SetFlags:
#.   Local:
#.     - b170f4e0-b35a-7cac-d62e-9b9aafb32220_C = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent07_AD:b2312ed8-f3d4-b6ca-731c-72a8ff317745
msgctxt "h9c21202dg3612g4f66gb3d3g43959abe49f4"
msgid "Drip. Drip. Drip. Gods, I am bloody bored."
msgstr "똑. 똑. 똑. 세상에, 지루해 죽겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent07_AD
#. Speaker = Vol
#. NodeID = b72969ab-b1cf-7b7a-32b5-6786a963876f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - b170f4e0-b35a-7cac-d62e-9b9aafb32220_C = True
#.      - b170f4e0-b35a-7cac-d62e-9b9aafb32220_B = True
#.      - b170f4e0-b35a-7cac-d62e-9b9aafb32220_A = True
#. SetFlags:
#.   Local:
#.     - b170f4e0-b35a-7cac-d62e-9b9aafb32220_C = False
#.     - b170f4e0-b35a-7cac-d62e-9b9aafb32220_B = False
#.     - b170f4e0-b35a-7cac-d62e-9b9aafb32220_A = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent07_AD:b72969ab-b1cf-7b7a-32b5-6786a963876f
msgctxt "h90fa417bgf8f2g4c78g9e04gd1c7054d8d2a"
msgid ""
"How the hell did Zarys make Swordhar? Never saw her work a day in her life."
msgstr "도대체 어떻게 자리스가 소드하르가 된 거야? 인생에서 하루라도 일하는 걸 본 적이 없는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent07_AD_TrapsActivated
#. Speaker = Vol
#. NodeID = 405e71b9-1c56-1cb3-d32e-8b40cf51bc19
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent07_AD_TrapsActivated:405e71b9-1c56-1cb3-d32e-8b40cf51bc19
msgctxt "h778c298bgbbf2g4255g89fega7071f7dc747"
msgid "Run! Rugan's friend set off the traps!"
msgstr "도망쳐! 루간의 친구가 함정을 작동시켰어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent08
#. Speaker = Karad
#. NodeID = 7e0ebfd7-772d-4b3c-27f4-48b5d9329b68
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_ZhentDungeon_Zhent08_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent08:7e0ebfd7-772d-4b3c-27f4-48b5d9329b68
msgctxt "hc4eac4d6gc676g4e64ga66eg6f3ab9801ece"
msgid ""
"Bloody Fist - not like they weren't paid well enough to ignore us in the "
"first place."
msgstr "빌어먹을 피스트 놈들, 애초에 우릴 무시할 만큼 보수가 적었던 것도 아니잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent08
#. Speaker = Karad
#. NodeID = 97832898-cf83-9967-e144-542f42735120
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_ZhentDungeon_Zhent08_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - PLA_ZhentDungeon_Zhent08_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent08:97832898-cf83-9967-e144-542f42735120
msgctxt "h3cf6b0edg4349g407fgb2ddg5da260ce16a9"
msgid "Wouldn't linger down here, I were you - see all that smokepowder?"
msgstr "나라면 이 아래에서 머물지 않을 거야, 저 화약들 보여?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent08
#. Speaker = Karad
#. NodeID = cdfd10ef-fcbd-1990-48a6-65ea1836bc55
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent08:cdfd10ef-fcbd-1990-48a6-65ea1836bc55
msgctxt "h6e08d0e6gefa8g447dg8733g551c8a371675"
msgid "The Flaming Fist won't find nothing here but rubble."
msgstr "플레이밍 피스트는 이 아래에서 돌무더기밖에 찾지 못할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent08_AD
#. Speaker = Karad
#. NodeID = 2aa2aa1a-5af7-bf8a-8bbf-bb1935d00259
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - cd4b312f-5a40-b8c1-1ecb-0862c829a479_B = False
#.      - cd4b312f-5a40-b8c1-1ecb-0862c829a479_A = False
#.      - cd4b312f-5a40-b8c1-1ecb-0862c829a479_C = False
#. SetFlags:
#.   Local:
#.     - cd4b312f-5a40-b8c1-1ecb-0862c829a479_A = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent08_AD:2aa2aa1a-5af7-bf8a-8bbf-bb1935d00259
msgctxt "hf89128ddg0651g4d80gb1c6g7c845d916f34"
msgid "Bloody <i>cold </i>down here."
msgstr "이 아래는 더럽게 <i>춥군</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent08_AD
#. Speaker = Karad
#. NodeID = 576d2d3a-f385-522b-b9d7-87bd6dba88ed
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - cd4b312f-5a40-b8c1-1ecb-0862c829a479_B = False
#.      - cd4b312f-5a40-b8c1-1ecb-0862c829a479_A = True
#.      - cd4b312f-5a40-b8c1-1ecb-0862c829a479_C = False
#. SetFlags:
#.   Local:
#.     - cd4b312f-5a40-b8c1-1ecb-0862c829a479_B = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent08_AD:576d2d3a-f385-522b-b9d7-87bd6dba88ed
msgctxt "ha6aad5dag2262g42a1gb65bg41a8392b6efc"
msgid ""
"Hells with this - I was promised steady coin, not some <i>stlarning</i> cave."
msgstr "이런 젠장할, 내가 들은 건 안정된 수입이었는데, 이런 <i>빌어먹을</i> 동굴이 아니라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent08_AD
#. Speaker = Karad
#. NodeID = 83db2941-ec6d-fd03-dde1-47a34fec1e41
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - cd4b312f-5a40-b8c1-1ecb-0862c829a479_B = True
#.      - cd4b312f-5a40-b8c1-1ecb-0862c829a479_A = True
#.      - cd4b312f-5a40-b8c1-1ecb-0862c829a479_C = False
#. SetFlags:
#.   Local:
#.     - cd4b312f-5a40-b8c1-1ecb-0862c829a479_C = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent08_AD:83db2941-ec6d-fd03-dde1-47a34fec1e41
msgctxt "hdcbfb090ge1c8g45a2g98beg445e420f5ddd"
msgid "Should've joined the Flaming Fist."
msgstr "플레이밍 피스트에 지원했어야 했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent08_AD
#. Speaker = Karad
#. NodeID = f3638b18-efbc-8b9e-0b83-3916a32fd4e4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - cd4b312f-5a40-b8c1-1ecb-0862c829a479_B = True
#.      - cd4b312f-5a40-b8c1-1ecb-0862c829a479_A = True
#.      - cd4b312f-5a40-b8c1-1ecb-0862c829a479_C = True
#. SetFlags:
#.   Local:
#.     - cd4b312f-5a40-b8c1-1ecb-0862c829a479_B = False
#.     - cd4b312f-5a40-b8c1-1ecb-0862c829a479_A = False
#.     - cd4b312f-5a40-b8c1-1ecb-0862c829a479_C = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent08_AD:f3638b18-efbc-8b9e-0b83-3916a32fd4e4
msgctxt "hafbe0dd7gc0c9g489fg9a1eg942b34663312"
msgid "I can't wait to get back to the city. I'm bloody horny."
msgstr "빨리 도시로 돌아가고 싶구만. 빨리 물을 빼고 싶은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhents_AD_ZhentAgentEscape
#. Speaker = Bellar
#. NodeID = a195cac4-bb24-55d5-55fa-58fbaa94cb35
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhents_AD_ZhentAgentEscape:a195cac4-bb24-55d5-55fa-58fbaa94cb35
msgctxt "h07ee4dc3gc134g4f7eg8875g3d09797620f5"
msgid "He's legging it! After him!"
msgstr "놈이 도망친다! 쫓아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_AD_BetweenAgents
#. Speaker = Rugan
#. NodeID = 25dd996d-1b40-49ff-ae62-1c4e62482443
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_AD_BetweenAgents:25dd996d-1b40-49ff-ae62-1c4e62482443
msgctxt "h5f626d45g7f23g4202g914agaf80b8f56eec"
msgid ""
"The rest of our crew's half-digested, and you're still alive. That's lucky."
msgstr "다른 대원들은 반쯤 소화됐는데, 넌 아직 살아있잖아. 그게 운이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_AD_BetweenAgents
#. Speaker = Rugan
#. NodeID = 2d061e61-aba1-de8b-5d99-8e897d0e29f7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_AD_BetweenAgents:2d061e61-aba1-de8b-5d99-8e897d0e29f7
msgctxt "h19f8d544g6a09g422agabf1g6719ff8051de"
msgid "I know! But we don't stand a chance out there."
msgstr "나도 알아! 하지만 저 밖에선 희망이 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_AD_BetweenAgents
#. Speaker = Olly
#. NodeID = 3347ea1f-e8c6-cb99-9980-c3017b3fe2df
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ConflictedFlind_State_Gone = False
#.      - PLA_ZhentShipment_State_BothAgentsAreAlive = True
#.   Local:
#.      - fe3291fe-e362-6f38-295e-d32672bb97fe_BanterSwitchA = False
#.      - fe3291fe-e362-6f38-295e-d32672bb97fe_BanterSwitchB = False
#. SetFlags:
#.   Local:
#.     - fe3291fe-e362-6f38-295e-d32672bb97fe_BanterSwitchA = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_AD_BetweenAgents:3347ea1f-e8c6-cb99-9980-c3017b3fe2df
msgctxt "h2f00d8ffged7fg4140g8457gc2cefaeaf217"
msgid "We should make a run for it."
msgstr "도망쳐야 해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_AD_BetweenAgents
#. Speaker = Rugan
#. NodeID = 4b0b02c5-aef6-f1c0-61ae-fcf7e401420d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_AD_BetweenAgents:4b0b02c5-aef6-f1c0-61ae-fcf7e401420d
msgctxt "haf678a5dg02c2g4f5dgac86g4f214c7156e3"
msgid "Maybe."
msgstr "어쩌면."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_AD_BetweenAgents
#. Speaker = Olly
#. NodeID = 4fa3334c-00ca-8918-599d-9a654eefe892
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_AD_BetweenAgents:4fa3334c-00ca-8918-599d-9a654eefe892
msgctxt "h2d4d299dg6e23g476fga874gded102db861d"
msgid "I'd break my neck!"
msgstr "제 목이 부러질 거예요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_AD_BetweenAgents
#. Speaker = Rugan
#. NodeID = 5b95404a-b85d-bc83-6aac-3bd0ea5e4881
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_AD_BetweenAgents:5b95404a-b85d-bc83-6aac-3bd0ea5e4881
msgctxt "hd0c4b2acge58eg4a2ag9a48g4cd98f23d8be"
msgid "Aye. It'd be quicker than having your guts torn out by them beasts."
msgstr "그래. 저 야수들에게 내장이 꺼내져 죽는 것보단 빠르겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_AD_BetweenAgents
#. Speaker = Olly
#. NodeID = 671fe6f6-6b34-2f5f-4468-777f0f7cab9f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_AD_BetweenAgents:671fe6f6-6b34-2f5f-4468-777f0f7cab9f
msgctxt "h8f1bca75g638bg4a1bg8b6dgb36b3b174d67"
msgid "I don't feel lucky."
msgstr "운이 좋은 것 같진 않은데요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_AD_BetweenAgents
#. Speaker = Rugan
#. NodeID = 7e9547bc-5e8d-60f3-9f7a-44095036da15
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_AD_BetweenAgents:7e9547bc-5e8d-60f3-9f7a-44095036da15
msgctxt "h2d88acccg0adcg49d3g888dgb3da01ef9583"
msgid "They'd tear us apart. You saw what happened to the others."
msgstr "놈들이 우릴 갈가리 찢어놓을 거야. 다른 이들이 어떻게 되는지 봤잖나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_AD_BetweenAgents
#. Speaker = Olly
#. NodeID = 91104a2e-fb3c-ed65-e506-2d1fee603f4d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ConflictedFlind_State_Gone = False
#.      - PLA_ZhentShipment_State_BothAgentsAreAlive = True
#.   Local:
#.      - fe3291fe-e362-6f38-295e-d32672bb97fe_BanterSwitchA = True
#.      - fe3291fe-e362-6f38-295e-d32672bb97fe_BanterSwitchB = True
#. SetFlags:
#.   Local:
#.     - fe3291fe-e362-6f38-295e-d32672bb97fe_BanterSwitchA = False
#.     - fe3291fe-e362-6f38-295e-d32672bb97fe_BanterSwitchB = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_AD_BetweenAgents:91104a2e-fb3c-ed65-e506-2d1fee603f4d
msgctxt "hcdd2cb12gdd5eg407eg8cb2g7ad622e78403"
msgid "There must be another way out!"
msgstr "분명 다른 길이 있을 거예요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_AD_BetweenAgents
#. Speaker = Rugan
#. NodeID = 9c068cd1-7a94-42de-9506-4e7d56db3e8f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_AD_BetweenAgents:9c068cd1-7a94-42de-9506-4e7d56db3e8f
msgctxt "h8b24796dge44dg419bg93dfg4da5c7543e4d"
msgid "So, no. I think help's a long way from here."
msgstr "그러니, 아니. 도움을 받긴 그른 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_AD_BetweenAgents
#. Speaker = Olly
#. NodeID = ca4a55a7-54d0-6d9b-264a-cf58fc38c864
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_AD_BetweenAgents:ca4a55a7-54d0-6d9b-264a-cf58fc38c864
msgctxt "hbee6e623g7357g45e2gb8e1g81d51c778cc1"
msgid "That fire won't hold them forever."
msgstr "저 불꽃이 놈들을 영원히 막진 못할 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_AD_BetweenAgents
#. Speaker = Rugan
#. NodeID = cf48875e-4ea1-7b9f-5f31-660327f2942f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_AD_BetweenAgents:cf48875e-4ea1-7b9f-5f31-660327f2942f
msgctxt "hbdd50257g272bg4568gaa39g2d140453eafd"
msgid "There is. Hurl yourself into the chasm back there."
msgstr "있지. 저 뒤 틈새로 네 몸을 끼워 넣어 보라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_AD_BetweenAgents
#. Speaker = Olly
#. NodeID = da71ee43-659a-9f62-683f-552387cb2825
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_AD_BetweenAgents:da71ee43-659a-9f62-683f-552387cb2825
msgctxt "hbf312929g327fg4ad0gb7f1gbe31894ac3b3"
msgid "So help's on its way?"
msgstr "도움이 오고 있는 건가요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_AD_BetweenAgents
#. Speaker = Rugan
#. NodeID = daefbc49-e4ad-cd20-036d-a7dc58b87f09
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ConflictedFlind_State_Gone = True
#.      - PLA_ZhentShipment_State_BothAgentsAreAlive = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_AD_BetweenAgents:daefbc49-e4ad-cd20-036d-a7dc58b87f09
msgctxt "ha66d1747g4acbg4ebdga128gacaf403819a9"
msgid "Well, lad. It's our lucky day after all."
msgstr "글쎄, 친구. 결국 오늘은 우리에게 행운의 날인 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_AD_BetweenAgents
#. Speaker = Olly
#. NodeID = eeec23b0-e890-e34d-6932-91539265d883
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ConflictedFlind_State_Gone = False
#.      - PLA_ZhentShipment_State_BothAgentsAreAlive = True
#.   Local:
#.      - fe3291fe-e362-6f38-295e-d32672bb97fe_BanterSwitchA = True
#.      - fe3291fe-e362-6f38-295e-d32672bb97fe_BanterSwitchB = False
#. SetFlags:
#.   Local:
#.     - fe3291fe-e362-6f38-295e-d32672bb97fe_BanterSwitchB = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_AD_BetweenAgents:eeec23b0-e890-e34d-6932-91539265d883
msgctxt "had3af11egcec2g4ec7g98dcgfdd9a2b3d646"
msgid "Someone must have found the wagon by now."
msgstr "분명 지금쯤이면 누군가 마차를 봤을 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_AD_BetweenAgents
#. Speaker = Rugan
#. NodeID = face9e3c-7ad8-2e36-4c7d-8f9e67827659
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_AD_BetweenAgents:face9e3c-7ad8-2e36-4c7d-8f9e67827659
msgctxt "hf1aa4a54g9ea4g4cc0gb49cgf98451fdba00"
msgid ""
"Only if whoever found the wagon is stupid enough to fight a pack of gnolls."
msgstr "그 마차를 본 사람이 놀 무리와 싸우려는 등신이라면 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = 034cd496-6379-3040-774e-40e428225d2d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:034cd496-6379-3040-774e-40e428225d2d
msgctxt "hc2a3acc3g7d5ag49c8g896cg509d3eb3e6e5"
msgid "Elturgard's a long way from here. Where are you heading?"
msgstr "엘투르가르드는 여기서 멀 텐데. 어디로 가는 중이었나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = 03efbae5-f4c2-d942-9a7f-b1712b469f41
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:03efbae5-f4c2-d942-9a7f-b1712b469f41
msgctxt "hb7375560gd957g4debg85f4g387113ee922b"
msgid ""
"Risen Road's more dangerous than ever. You're the first friendly face we've "
"seen since Elturgard."
msgstr "치솟은 길은 어느 때보다 위험한 상태요. 엘투르가르드를 떠난 이후 우호적인 인물은 당신이 처음이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = 05d8e916-54fa-d1fb-9a98-f21d2794ade1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentDungeon_State_FallBack = True
#. SetFlags:
#.   Local:
#.     - 52b1901d-8f80-fcd2-954a-a5798969b107_PLA_ZhentShipment_SaidFallback = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:05d8e916-54fa-d1fb-9a98-f21d2794ade1
msgctxt "h528abda6g1d1eg40a6g8800gcec9b4015ad1"
msgid "I already met your friends - we didn't get along too well."
msgstr "당신 친구는 이미 만나봤어, 끝이 좋진 않았지만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = 063ab367-4418-66ff-f44a-ed076cc914ff
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentDungeon_State_GnollZhentsPresent = True
#.      - PLA_ZhentShipment_State_Talked = True
#.      - PLA_ZhentShipment_Rugan_Knows_SentByZarys = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:063ab367-4418-66ff-f44a-ed076cc914ff
msgctxt "hd555d9f6g8ad7g46a5gb449g422e5824997e"
msgid ""
"That drink I promised will have to wait. We're moving out. The Elfsong's my "
"local - look me up if you're in the city."
msgstr "내가 약속한 술은 잠시 기다려야겠소. 움직여야 하오. 난 엘프송에 있을 테니, 도시에 온다면 그곳에서 날 찾으시오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = 0669e790-9168-5036-e708-d1c08def34e1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:0669e790-9168-5036-e708-d1c08def34e1
msgctxt "h752d2cf2g5769g40fbga928g97b7bffd0934"
msgid "We're the grease that keeps the wheels of commerce turning."
msgstr "우리는 상업의 수레바퀴를 계속 굴러가게 하는 윤활유라오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = 07b40f74-def0-8c1c-cca6-18f3a42da0ef
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentDungeon_State_GnollZhentsPresent = False
#.      - PLA_ConflictedFlind_State_Gone = True
#.      - PLA_ZhentShipment_State_Talked = True
#.      - PLA_ZhentShipment_State_JoinedFightWithGnolls = True
#.      - PLA_ZhentShipment_State_ReadyToLeaveCave = False
#. SetFlags:
#.   Global:
#.     - PLA_ZhentShipment_State_Talked = True
#.     - PLA_ZhentShipment_State_TalkedAfterKilledGnolls = True
#.   Object:
#.     - PLA_ZhentShipment_Agent_002_StartInclusion(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:07b40f74-def0-8c1c-cca6-18f3a42da0ef
msgctxt "h21a6af98gda81g4fffga421gaa7f311126a1"
msgid ""
"Thank the gods that's over. Wish you'd been with us when the beasts attacked "
"on the road."
msgstr "신이시여 고맙소. 저 야수들이 우릴 처음 공격했을 때 당신이 있었으면 좋았을 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = 087e5835-44d0-7250-4bac-b1a9c1d2e4b7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentDungeon_State_GnollZhentsPresent = True
#.      - PLA_ZhentShipment_State_ChestLost = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:087e5835-44d0-7250-4bac-b1a9c1d2e4b7
msgctxt "hd51b9251ga361g4464g992dgbebb4dfbad33"
msgid "Thanks. You always seem to show up at just the right time."
msgstr "고맙소. 당신은 언제나 제때 나타나는 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = 0a6a7b36-863c-d430-becf-df533a775868
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_ChestLost = False
#.      - PLA_ZhentShipment_State_FlaskInChest = True
#.      - PLA_ZhentShipment_State_ChestNotInPlace = False
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule: OATHBREAKER
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:0a6a7b36-863c-d430-becf-df533a775868
msgctxt "hab28f072g75b7g4848g9ef6g40574e640ea5"
msgid ""
"Whatever oath you've sworn to the Black Hand, it's not worth dying for. Give "
"me the cargo."
msgstr "당신이 블랙 핸드에게 어떤 맹세를 했는지는 모르겠지만, 죽을 가치는 없을 거야. 내게 화물을 넘겨."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = 0a6a7b36-863c-d430-becf-df533a775868
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_ChestLost = False
#.      - PLA_ZhentShipment_State_FlaskInChest = True
#.      - PLA_ZhentShipment_State_ChestNotInPlace = False
#.   Tag:
#.      - PALADIN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:0a6a7b36-863c-d430-becf-df533a775868
msgctxt "hf2c718bfgc842g436dg8661gd511c8f06448"
msgid ""
"You serve your oath to the Zhent impressively, but I'm afraid I'll be taking "
"that cargo. <i>Now</i>."
msgstr "당신들은 젠트의 맹세에 감명 깊을 정도로 충실하지만, 그 화물은 내가 가져가야 할 것 같군. <i>지금</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = 0c3352f1-e198-09b4-7e3c-8d3287f9958c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:0c3352f1-e198-09b4-7e3c-8d3287f9958c
msgctxt "ha82cdc30g0d8dg49edgbb57g87b63c5837cf"
msgid ""
"Hold on now. You made short work of the beasts, and I reckon you'd make "
"shorter of me and the boy."
msgstr "잠깐 기다려주시오. 당신은 그 짐승들도 순식간에 처리했으니, 나와 이 친구는 더 빠르게 처리하겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = 0e80eaad-e890-97f1-7dd7-11f9db49da84
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:0e80eaad-e890-97f1-7dd7-11f9db49da84
msgctxt "hdd1e9a16gb714g4989ga17age173da61ccfb"
msgid "Damn it. Nowhere's safe anymore."
msgstr "젠장. 더는 어느 곳도 안전하지 않겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = 1664fc32-ecfc-39d9-ff61-65877ae4eb9a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_CheckPocketGold = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:1664fc32-ecfc-39d9-ff61-65877ae4eb9a
msgctxt "hd6fdecb6ga679g4db2gab4agfa56db8a8b31"
msgid ""
"I'd have given you my coin already if I had any. I've nothing for you, "
"friend."
msgstr "내게 돈이 있었다면 이미 넘겼을 것이오. 줄 것은 아무것도 없소, 친구."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = 16dc9fde-667d-f570-c6d2-a12e99d2a210
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Zhentarim_Knows_Zhentarim = True
#.     - PLA_ZhentShipment_State_RecognisedZhent = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:16dc9fde-667d-f570-c6d2-a12e99d2a210
msgctxt "hae9614dcg695dg45e6ga341gdf3d7d81c25d"
msgid ""
"But we're not merchants; we're Zhentarim agents. Steal from us, and you'll "
"have a price on your head."
msgstr "하지만 우리는 상인들이 아니오. 젠타림 요원이지. 우리에게서 물건을 훔치면, 당신 머리로 대가를 치르게 될 것이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = 17ac7a1f-ce02-dd04-6064-3cd73c82696e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_ChestLost = False
#.      - PLA_ZhentShipment_State_FlaskInChest = True
#.      - PLA_ZhentShipment_State_ChestNotInPlace = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:17ac7a1f-ce02-dd04-6064-3cd73c82696e
msgctxt "hb89e668dga3f4g45b6gaa6dgbcb1fe45e911"
msgid "What's in the chest? Your cargo?"
msgstr "그 상자에 들어있는 건 뭐지? 당신네 화물인가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = 1d944002-0b41-a9ac-50c2-a37e95a78f57
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:1d944002-0b41-a9ac-50c2-a37e95a78f57
msgctxt "h4f372729ga70cg4effg8e00gdbf9bbe10494"
msgid ""
"Waukeen's Rest. It's just up the road. I'd be enjoying a mug of ale right "
"now if those beasts hadn't jumped us."
msgstr "와우킨의 쉼터요. 길 바로 위쪽에 있소. 그 짐승들이 우릴 덮치지 않았다면, 나는 지금쯤 에일 한 잔을 즐기고 있었을 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = 1f266137-7954-ad76-818d-d0f281db6c0f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Quest:
#.      - PLA_ZhentShipment.AgreedHelp(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:1f266137-7954-ad76-818d-d0f281db6c0f
msgctxt "hc3d948acge385g4b72ga2acg3738b85bc58b"
msgid "All dead. Zarys sent me to secure the cargo."
msgstr "모두 죽었어. 자리스가 화물을 보호하라고 나를 보냈어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = 1fccb3e9-ec60-ac96-4b1a-240ca1ed77bf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_ChestLost = False
#.      - PLA_ZhentShipment_State_FlaskInChest = True
#.      - PLA_ZhentShipment_State_ChestNotInPlace = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:1fccb3e9-ec60-ac96-4b1a-240ca1ed77bf
msgctxt "h8b69c867g374eg4988g8338g09cdf9cd6782"
msgid "What's in the chest?"
msgstr "상자에 뭐가 들어있지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = 1fcd7031-3e28-d93d-2a56-04c30031cec9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:1fcd7031-3e28-d93d-2a56-04c30031cec9
msgctxt "hd1c3e022gb7fcg49c6gb84eg1e8b103961c4"
msgid ""
"And yet here you are. There's not many cause trouble in a Zhent hideout and "
"walk away."
msgstr "그럼에도 당신은 여기 있군. 젠타림의 은신처에 문제를 일으키고 무사히 빠져나갈 방법은 많지 않지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = 275731c7-1786-0d6b-d1dd-6782208ff3fc
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_ChestLost = False
#.      - PLA_ZhentShipment_State_FlaskInChest = True
#.      - PLA_ZhentShipment_State_ChestNotInPlace = False
#.   Tag:
#.      - BARBARIAN(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:275731c7-1786-0d6b-d1dd-6782208ff3fc
msgctxt "h11246e76g1fe5g4744g8fafge0cdaa84d90b"
msgid "This isn't a rescue, it's a robbery. I want the chest."
msgstr "난 당신을 구조하려고 온 게 아니야, 털어버리려고 온 거지. 그 상자를 내놔."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = 2831fd5a-bcad-0af9-a489-c55b11942f95
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_Rugan_Knows_SentByZarys = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:2831fd5a-bcad-0af9-a489-c55b11942f95
msgctxt "h69581d0agf922g40f6ga5bcg3b42b9387d46"
msgid ""
"I'll take the cargo back to Zarys at the hideout. Drop by and see me when "
"you can - I owe you a drink."
msgstr "난 화물을 은신처에 있는 자리스에게 전달하겠소. 시간이 나면 한번 들러서 만나지, 내가 한잔 빚졌으니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = 28adfcc5-3fee-a0ac-df8d-7b1c5e852031
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_ZhentShipment_State_Persuaded = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:28adfcc5-3fee-a0ac-df8d-7b1c5e852031
msgctxt "h6eefcb14g6391g48e8ga78bg8d2263619e0e"
msgid ""
"I like the way you think. Didn't expect to turn this horrorshow to my "
"advantage... but why not?"
msgstr ""
"당신이 생각하는 방식이 마음에 드는군. 이 끔찍한 사건을 내 이점으로 활용해 볼 생각은 한 적 없지만... 안될 건 없지 않겠소?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = 297ae490-8976-92a0-5c11-1846463da954
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:297ae490-8976-92a0-5c11-1846463da954
msgctxt "h27a8e3cag62aag48c1g8ec3g3832bc9ac759"
msgid "Since when does a mule know what it carries?"
msgstr "짐노새가 자기 등에 뭐가 실려있는지 어떻게 알겠소?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = 2b0013c4-c2c7-0446-feb3-909f29c89ab5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:2b0013c4-c2c7-0446-feb3-909f29c89ab5
msgctxt "h3e9c4501g3d17g4e1egad3eg090233dd152e"
msgid "And you think I won't?"
msgstr "내가 못할 거라 생각하나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = 2d89147f-e796-acf7-0bab-38cc49af4072
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_ChestLost = False
#.      - PLA_ZhentShipment_State_FlaskInChest = True
#.      - PLA_ZhentShipment_State_ChestNotInPlace = False
#.   Tag:
#.      - BARBARIAN(1) = True
#. TagRule: BERSERKER
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:2d89147f-e796-acf7-0bab-38cc49af4072
msgctxt "h2268ff97g8320g4a1dgb962g17d8d75b6a7a"
msgid "<b><i>ROAR.</i></b>"
msgstr "<b><i>크아아.</i></b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = 2d89147f-e796-acf7-0bab-38cc49af4072
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_ChestLost = False
#.      - PLA_ZhentShipment_State_FlaskInChest = True
#.      - PLA_ZhentShipment_State_ChestNotInPlace = False
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:2d89147f-e796-acf7-0bab-38cc49af4072
msgctxt "h2d04b70agc327g49fag9c7eg725940acf0e2"
msgid "Enough talking. I'll have that cargo, or I'll have your head."
msgstr "이야기는 그만. 그 화물을 내놓지 않으면, 내가 네 머리를 가져가지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = 2eb05c90-c9b0-b73f-e93d-c32f10f3247c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:2eb05c90-c9b0-b73f-e93d-c32f10f3247c
msgctxt "h22f3cd3ag97a3g4187ga583g042d2ee4db3e"
msgid ""
"We're bound for Baldur's Gate - got some cargo to deliver. But we've a stop "
"to make along the way."
msgstr "발더스 게이트로 가는 중이었소. 전달할 화물이 있어서 말이오. 하지만 가는 길에 들러야 할 곳이 있었소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = 2f405a3d-384e-b5de-21db-557c41eefa37
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_ZhentShipment_State_Persuaded = True
#.     - PLA_ZhentShipment_State_ImpersonatedPereghost = True
#.   Object:
#.     - PLA_ZhentShipment_Event_ClearChestOwner(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:2f405a3d-384e-b5de-21db-557c41eefa37
msgctxt "h52666eb2g5c80g4e61gb6degae2cf59df0dc"
msgid ""
"Zarys won't be happy. But, I suppose she can take it up with the Pereghost "
"herself. Take the chest."
msgstr "자리스가 좋아하진 않겠군. 하지만, 페레고스트와는 그녀가 알아서 해결할 수 있겠지. 궤짝을 가져가시오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = 2f79d4ab-d386-3aaf-a2c5-88713e6559db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:2f79d4ab-d386-3aaf-a2c5-88713e6559db
msgctxt "ha179162bgdf91g4ea0g8f04g25c75ddd03a3"
msgid ""
"You should meet my associates. We've got our <i>own</i> drinking spot by the "
"tavern - invitation only."
msgstr "당신이 내 동료들을 만나줬으면 하오. 선술집 옆에 <i>우리만의</i> 술자리가 마련되어 있지. 초대받은 손님 전용이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = 311bbdbf-7ff9-b3c8-53ff-5a101ac2d652
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentDungeon_State_FallBack = True
#. SetFlags:
#.   Dialog:
#.     - PLA_ZhentShipment_Agent_001_ToldToMeet(1) = True
#.   Global:
#.     - PLA_ZhentShipment_State_RuganToldPassword = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:311bbdbf-7ff9-b3c8-53ff-5a101ac2d652
msgctxt "he3dcecedg1b3eg4945gba1cg09725f8007d5"
msgid ""
"Pass phrase at the door is 'little serpent, long shadow'. I'll tell my "
"associates to expect you."
msgstr "암구호는 '작은 뱀, 긴 그림자'요. 내 동료들에게 당신이 갈 거라고 전해두겠소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = 35ae85b5-1c6f-9288-25b4-f0ff301d91a8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_ZhentShipment_Quest_AttackedAgents = True
#.   Object:
#.     - FactionHostileToIndivPlayerAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:35ae85b5-1c6f-9288-25b4-f0ff301d91a8
msgctxt "h384c73bbg7eaeg41efga287g4f9d57a2e83a"
msgid "Bloody fool. May the Black Hand take you."
msgstr "빌어먹을 멍청이 녀석. 블랙 핸드가 너를 데려가길."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = 3a8b5be9-9244-4b50-4e3a-ad2f9c8fc4bd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Quest:
#.      - PLA_ZhentShipment.AgreedHelp(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:3a8b5be9-9244-4b50-4e3a-ad2f9c8fc4bd
msgctxt "hbf946408g44c4g4c94gb4bfg74de3e9a3a40"
msgid "Zarys sent me to secure the cargo."
msgstr "자리스가 화물을 보호하라고 나를 보냈어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = 3ae58f72-5fe8-ee40-bfd4-267162e2d08d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_RecognisedZhent = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:3ae58f72-5fe8-ee40-bfd4-267162e2d08d
msgctxt "h142221edg61cbg4bc4gb8acgbb642767aa12"
msgid "The Zhentarim aren't known for mercy, true."
msgstr "젠타림은 자비가 없기로 유명하지, 사실이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = 40a57f79-02f6-9207-0acf-fc7583a0bb76
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:40a57f79-02f6-9207-0acf-fc7583a0bb76
msgctxt "h398e1641g8321g4be4g9fefg59bfe9055f4e"
msgid "A lot of people died for those baubles."
msgstr "많은 사람들이 그 볼품없는 짓거리 때문에 죽었겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = 41e1d072-8cb2-440c-2b18-864fd05299ce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:41e1d072-8cb2-440c-2b18-864fd05299ce
msgctxt "h9886db8cg8d9dg4679g929cg1718346ba4d6"
msgid "Where's that?"
msgstr "그건 어디지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = 4393d7bc-4016-6aa9-03a9-93cdfe14dc87
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:4393d7bc-4016-6aa9-03a9-93cdfe14dc87
msgctxt "h7ffeb57fg33b1g43a5g9faegd2711d15738b"
msgid ""
"It's fine. We'd be dead if they hadn't showed up. A little hospitality won't "
"do any harm."
msgstr "괜찮아. 그들이 나타나지 않았다면 우린 죽었을 거야. 약간의 환대는 해로울 것 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = 4456590a-c539-548e-9253-fa7a736a7fbf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:4456590a-c539-548e-9253-fa7a736a7fbf
msgctxt "hbda96c3eg0481g42eega713g1073dc9c3225"
msgid ""
"I know a fence in Baldur's Gate who'll take it off your hands. Nobody will "
"be the wiser."
msgstr "발더스 게이트에 내가 아는 장물아비가 있소. 그에게 판매하는 편이 가장 현명한 선택일 것이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = 4721d124-fec8-a888-c3ea-cb5b773cee95
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:4721d124-fec8-a888-c3ea-cb5b773cee95
msgctxt "hc499c5dbg9126g49afga9dbgb44c3e824a33"
msgid ""
"This is the point when a clever lass like you accepts my gratitude and walks "
"away."
msgstr "당신처럼 영리한 아가씨가 내 감사를 받아들이고 떠날 때는 바로 지금이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = 4721d124-fec8-a888-c3ea-cb5b773cee95
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:4721d124-fec8-a888-c3ea-cb5b773cee95
msgctxt "h12a9a8d9gf591g45e8gb4afg5687e2c894fc"
msgid ""
"This is the point when a clever lad like you accepts my gratitude and walks "
"away."
msgstr "당신처럼 영리한 청년이 내 감사를 받아들이고 떠날 때는 바로 지금이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = 4721d124-fec8-a888-c3ea-cb5b773cee95
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:4721d124-fec8-a888-c3ea-cb5b773cee95
msgctxt "h3da6ace8gbbe2g44f1gae36g588e26973588"
msgid ""
"This is the point when a clever operator like you accepts my gratitude and "
"walks away."
msgstr "당신처럼 영리한 수완가가 내 감사를 받아들이고 떠날 때는 바로 지금이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = 476d0a0f-69b1-0ea3-e156-3f36b1f8ea09
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:476d0a0f-69b1-0ea3-e156-3f36b1f8ea09
msgctxt "h7cffa25dgfe46g499bg9d8egecdf727a567a"
msgid ""
"I don't think so - you sound rattled. Those gnolls put up quite a fight, I "
"bet."
msgstr "내 생각은 다른데, 난처한 상황으로 보여. 저 놀들이랑 꽤 힘든 싸움을 한 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = 48713a73-f0b9-3eba-b4ec-01f068e987a1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentDungeon_State_GnollZhentsPresent = False
#.      - PLA_ZhentShipment_State_ReadyToLeaveCave = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:48713a73-f0b9-3eba-b4ec-01f068e987a1
msgctxt "h0f41f32eg8ce7g4ce5gae5egbbbe88027128"
msgid "Thanks again. We'll head out as soon as we've caught our breath."
msgstr "다시 한번 고맙소. 숨을 돌리는 대로 바로 출발하겠소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = 48ead6c6-1545-7a7e-4e63-b8518d65a0c7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:48ead6c6-1545-7a7e-4e63-b8518d65a0c7
msgctxt "hfc3be7c3g26f2g42c4gaad4g97ee00710567"
msgid "Maybe I should come - see you don't get waylaid again."
msgstr "내가 동행할 수 있어. 당신이 또 방해를 받지 않도록 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = 491f47bb-54a8-bf15-9164-d7f6606af9b0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:491f47bb-54a8-bf15-9164-d7f6606af9b0
msgctxt "h1bc26600gce0fg4345ga93cg5bfec01d470b"
msgid "And we don't take kindly to people who meddle in our business."
msgstr "그리고 우리 사업에 간섭하는 사람을 좋아하지 않소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = 4be154ae-4879-41c7-2328-2bc3a1b85f77
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToIndivPlayerAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:4be154ae-4879-41c7-2328-2bc3a1b85f77
msgctxt "h9e273754g8f44g4401g8308g4449b87e3427"
msgid "Stop picking through my brain!"
msgstr "내 머릿속을 그만 뒤지시오!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = 4cd9b2ea-7b8c-7426-961d-896cbae710ab
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_Intimidated = False
#.      - PLA_ZhentShipment_State_ChestLost = False
#.      - PLA_ZhentShipment_State_FlaskInChest = True
#.      - PLA_ZhentShipment_State_ChestNotInPlace = False
#.   Tag:
#.      - BARBARIAN(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:4cd9b2ea-7b8c-7426-961d-896cbae710ab
msgctxt "h44ecf742g3a12g421cga86eg3db762560e92"
msgid "You can leave - but your cargo stays."
msgstr "떠나도 좋아, 하지만 그 화물은 두고 가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = 4d654741-feda-c816-98e2-05c6811e5682
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_RewardedWithGold = False
#.   Tag:
#.      - BARBARIAN(1) = True
#. TagRule: BERSERKER
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:4d654741-feda-c816-98e2-05c6811e5682
msgctxt "h1e838720g1039g4604ga26eg4fdac808b124"
msgid "MONEY, OR YOUR LIFE. <b>CHOOSE</b>."
msgstr "<b>돈을 내던가, 목숨을 내놔. 선택하시지</b>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = 4d654741-feda-c816-98e2-05c6811e5682
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_RewardedWithGold = False
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:4d654741-feda-c816-98e2-05c6811e5682
msgctxt "h42b1956bg2adfg45b5g9fefg6922d3280a94"
msgid "I'll buy my own drinks. Money. <b>Now.</b>"
msgstr "내 술은 내가 사지. 돈을 내놔. <b>당장.</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = 4e36af22-888d-37d2-369f-a021365d313e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:4e36af22-888d-37d2-369f-a021365d313e
msgctxt "hb6c62dd8g4444g4d9fgb671g33df7fbdca28"
msgid "If your bosses come after the chest, I'll kill them as well."
msgstr "너희 상사들이 이 상자를 노린다면, 그들도 죽일 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = 4fd1afbc-55b7-9e3f-1d78-dd1f0869e319
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_Rugan_Knows_SentByZarys = False
#.      - PLA_ZhentShipment_State_JoinedFightWithGnolls = True
#. SetFlags:
#.   Global:
#.     - PLA_ZhentShipment_State_RecognisedZhent = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:4fd1afbc-55b7-9e3f-1d78-dd1f0869e319
msgctxt "hf97e1e52g09f4g4a90g845cg64fbee96e43f"
msgid "Black Hand be thanked."
msgstr "블랙 핸드에게 감사를."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = 51b18426-bf3a-fbe4-9608-41b35bcf74c0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_ZhentShipment_Rugan_Knows_SentByZarys = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:51b18426-bf3a-fbe4-9608-41b35bcf74c0
msgctxt "hae50779fgecf2g4f9cg8706g74dc4ae1c58d"
msgid ""
"We'll take the chest back to the hideout. I owe you a drink. Lots of drinks."
msgstr "우리는 상자를 갖고 은신처로 복귀할 것이오. 당신에게 한 잔 빚졌소. 한 잔이 아니라 여러 잔을."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = 561c2e70-9c84-18e2-9ed1-bbcf0cf15207
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - PLA_ZhentShipment_Agent_001_ToldToMeet(1) = True
#.   Global:
#.     - PLA_ZhentShipment_State_RuganToldPassword = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:561c2e70-9c84-18e2-9ed1-bbcf0cf15207
msgctxt "h6156f0e5g7d8eg44e7gab6dg6ec495effd73"
msgid ""
"Tell the fellow on the door 'little serpent, long shadow'. He'll take good "
"care of you."
msgstr "문을 지키고 있는 동료에게 '작은 뱀, 긴 그림자'라고 말하면, 그가 당신을 잘 봐줄 것이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = 588f9625-982c-2f5a-1c69-4ca6c3e22d34
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_Intimidated = False
#.      - PLA_ZhentShipment_State_ChestLost = False
#.      - PLA_ZhentShipment_State_FlaskInChest = True
#.      - PLA_ZhentShipment_State_ChestNotInPlace = False
#.   Tag:
#.      - BARBARIAN(1) = True
#. TagRule: BERSERKER
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:588f9625-982c-2f5a-1c69-4ca6c3e22d34
msgctxt "h749e8a0fgca1fg4824ga075gf858794c06c8"
msgid "CARGO'S <b>MINE </b>NOW. <b>GET OUT</b>."
msgstr "<b>화물은 내 것이다. 이제 꺼져</b>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = 588f9625-982c-2f5a-1c69-4ca6c3e22d34
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_Intimidated = False
#.      - PLA_ZhentShipment_State_ChestLost = False
#.      - PLA_ZhentShipment_State_FlaskInChest = True
#.      - PLA_ZhentShipment_State_ChestNotInPlace = False
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:588f9625-982c-2f5a-1c69-4ca6c3e22d34
msgctxt "h720ee01cg4cd9g41ecga7b2ge7081ee22e5d"
msgid "Cargo's mine now. <b>Goodbye.</b>"
msgstr "이제 화물은 내 것이야. <b>잘 가.</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = 5b124210-d668-dea6-968f-846f2134875b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:5b124210-d668-dea6-968f-846f2134875b
msgctxt "hbc52f052gfa42g43cbg9c19gd2b315861d5d"
msgid ""
"You made short work of the gnolls... reckon you'd make shorter work of me "
"and the boy."
msgstr "당신은 그 짐승들도 순식간에 처리했으니, 나와 이 친구는 더 빠르게 처리하겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = 5becc142-bb77-9b23-274f-a4b3a0cb2ad6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:5becc142-bb77-9b23-274f-a4b3a0cb2ad6
msgctxt "h969bc809g8b9dg4563g83dbg7f3a249a94d4"
msgid ""
"If I lose that cargo, my people will do worse to me than the gnolls would've."
msgstr "내가 그 화물을 잃어버리면, 내 사람들이 내게 저 놀들 보다 끔찍한 짓을 할 것이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = 5cee796e-61fb-c272-b4d8-3473425f328a
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_RewardedWithGold = False
#.   Tag:
#.      - BARBARIAN(1) = True
#. TagRule: BERSERKER
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:5cee796e-61fb-c272-b4d8-3473425f328a
msgctxt "h9b6dfaf1g23d8g4164ga643ga8538e08e06f"
msgid "WORDS DON'T PAY. <b>COIN DOES.  </b>"
msgstr "<b>말은 소용없어. 동전을 내놔.  </b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = 5cee796e-61fb-c272-b4d8-3473425f328a
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_RewardedWithGold = False
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:5cee796e-61fb-c272-b4d8-3473425f328a
msgctxt "hd751a691g12e3g4030g90e7g5aac2c1d01e0"
msgid "Not looking for new friends. Looking for coin. <b>Now.</b>"
msgstr "새 친구를 찾고 있는 게 아니야. 돈을 찾는 거지. <b>내놔.</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = 61106a7e-da78-ee91-d43d-23253f107988
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 0
#. CheckFlags:
#.   Local:
#.      - 52b1901d-8f80-fcd2-954a-a5798969b107_PLA_ZhentShipment_ReadMind = False
#.   Quest:
#.      - PLA_ZhentShipment.AgreedHelp(1) = False
#.   Script:
#.      - GEN_CanDetectThoughts_2 = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:61106a7e-da78-ee91-d43d-23253f107988
msgctxt "h456eeb0bga2e1g4c13ga1c4g0acd47debc3a"
msgid "<i>Read his thoughts.</i>"
msgstr "<i>그의 생각을 읽는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = 6173c1ee-9aa2-7a76-edd2-db6002366a7e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Zhentarim_Knows_Zhentarim = True
#.     - PLA_ZhentShipment_State_RecognisedZhent = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:6173c1ee-9aa2-7a76-edd2-db6002366a7e
msgctxt "h80c09a7ag694dg4512g9d5eg61c93fd86529"
msgid ""
"If there are valuable goods on the move, The Black Company's <i>always</i> "
"involved."
msgstr "귀중한 물품이 이동해야 하면, 검은 조직이 <i>항상</i> 함께하오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = 64f7e54a-1994-481e-6fae-c8543f43d41a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:64f7e54a-1994-481e-6fae-c8543f43d41a
msgctxt "he8436a41ge029g4e7fgbc3cgae6a876c5f3e"
msgid "He gets his shiny baubles, we get a handful of Tarenths."
msgstr "그는 반짝이는 싸구려들을 얻고, 우리는 타렌스를 한가득 얻을 예정이었소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = 6530681e-c562-1f0a-72ec-7f37b5b634d7
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_ChestLost = False
#.      - PLA_ZhentShipment_State_FlaskInChest = True
#.      - PLA_ZhentShipment_State_ChestNotInPlace = False
#.   Tag:
#.      - BARBARIAN(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:6530681e-c562-1f0a-72ec-7f37b5b634d7
msgctxt "hde275e86g21ceg4e6fg80f4gb1dd2e314a11"
msgid "Whatever your cargo is, I'll take it as payment."
msgstr "당신네 화물이 무엇이든 간에, 내가 보상으로 가져가겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = 678be125-70b9-31ec-c319-f56bc90fb014
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:678be125-70b9-31ec-c319-f56bc90fb014
msgctxt "h3bf20f96gfd0fg43dbg8b0bgc913e168303d"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = 69d4d1ed-e381-78ec-6450-a5fb48c901fb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:69d4d1ed-e381-78ec-6450-a5fb48c901fb
msgctxt "hd84f06adg5968g47bdgbad7g55c4deeead47"
msgid ""
"Rich men place more value on wine and fine clothes than on the lives of "
"folks like me."
msgstr "부자들은 나같은 서민들의 목숨보다 그들의 와인과 세련된 옷을 더 중요시하는 법이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = 7370d6fc-f30a-5d15-e1f8-9914aa2c90cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:7370d6fc-f30a-5d15-e1f8-9914aa2c90cf
msgctxt "h458aa78egab5eg41b5gb40eg47f5b58283c7"
msgid "We're Zhentarim."
msgstr "우리는 젠타림이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = 7463713d-b51e-714c-448b-d73f1ad82674
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_ChestLost = False
#.      - PLA_ZhentShipment_State_FlaskInChest = True
#.      - PLA_ZhentShipment_State_ChestNotInPlace = False
#.   Tag:
#.      - ROGUE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:7463713d-b51e-714c-448b-d73f1ad82674
msgctxt "hcfdba7eeg90cdg456fg8523g7ed95ee760c3"
msgid ""
"You're missing a golden opportunity. Report the cargo lost - and we can sell "
"it ourselves."
msgstr "황금 같은 기회를 날리고 있군. 그 화물을 잃어버렸다고 해, 그리고 우리끼리 팔아 치우는 거지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = 7f7d8861-85e3-3483-f563-dfcfb1a01db6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_BothAgentsAreAlive = True
#. SetFlags:
#.   Object:
#.     - FactionHostileToIndivPlayerAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:7f7d8861-85e3-3483-f563-dfcfb1a01db6
msgctxt "hc5ef0184g9818g4fecg9e66gac0c9cd64e4b"
msgid "We'll be taking <i>your</i> coin."
msgstr "우리가 <i>당신</i> 돈을 가져가겠소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = 85fe9c12-8585-026f-0db8-05fded2892fb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:85fe9c12-8585-026f-0db8-05fded2892fb
msgctxt "hbd941e9aga1f6g440ega8e3gd086bebfccbc"
msgid ""
"Listen - I'm indebted to you. And that's why I'm giving you a chance to walk "
"away before you get yourself killed."
msgstr "내 말 들어보시오. 난 당신에게 빚을 졌소. 그래서 당신이 자살 행위를 하기 전에 떠날 기회를 주는 것이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = 867af4b7-2006-8db0-6af3-5532a92f1a27
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:867af4b7-2006-8db0-6af3-5532a92f1a27
msgctxt "h455e6923g4ef8g456fga057gcdff0c5ae38e"
msgid "No. It's a grim sight."
msgstr "아니, 암울한 광경이었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = 88839d6f-1d7c-9b17-1a6d-bb828876b56c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:88839d6f-1d7c-9b17-1a6d-bb828876b56c
msgctxt "h65ac40c8g6806g4111g8d9fg57a6f706bad2"
msgid ""
"And no hard feelings, y'hear? I'd have done the same if I were you. Business "
"at the end of a blade is still business."
msgstr "그렇게 하면 악감정은 없겠소? 내가 당신이었어도 똑같이 했을 것이오. 칼끝으로 이룬 사업도 어쨌든 사업이니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = 889bb76b-5c9d-ba85-0b35-c7b59a43705d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_RewardedWithGold = False
#.   Tag:
#.      - BARBARIAN(1) = True
#. SetFlags:
#.   Global:
#.     - PLA_ZhentShipment_State_RewardedWithGold = True
#. TagRule: BERSERKER
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:889bb76b-5c9d-ba85-0b35-c7b59a43705d
msgctxt "h77ac1ab4gec7cg4214g930fg2e7dbb9f01a8"
msgid "<b>PAY UP</b>."
msgstr "<b>돈을 내</b>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = 889bb76b-5c9d-ba85-0b35-c7b59a43705d
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_RewardedWithGold = False
#.   Tag:
#.      - BARBARIAN(1) = True
#. SetFlags:
#.   Global:
#.     - PLA_ZhentShipment_State_RewardedWithGold = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:889bb76b-5c9d-ba85-0b35-c7b59a43705d
msgctxt "hfc63efa9geb79g4e1bga3ffgc34d76c3f6b1"
msgid "Coin first. Then I go."
msgstr "돈 먼저 내. 그럼 가지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = 88ff474a-ae75-bebf-e088-d4bc7a53eed3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_ChestLost = False
#.      - PLA_ZhentShipment_State_FlaskInChest = True
#.      - PLA_ZhentShipment_State_ChestNotInPlace = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:88ff474a-ae75-bebf-e088-d4bc7a53eed3
msgctxt "h064b0f5eg1917g47cfga2e4g3500a8bc7595"
msgid "What are you transporting?"
msgstr "무엇을 수송하고 있었지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = 8979cf59-789d-b65a-12f6-c0788a5922ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:8979cf59-789d-b65a-12f6-c0788a5922ed
msgctxt "h481697e7gc365g434dga669gde873fffd973"
msgid "Are any of my crew still alive out there?"
msgstr "혹시 저 밖에 내 부하들 중 살아남은 이는 없소?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = 8a358009-e355-80a5-de29-236fb03ce889
#. HandlePath = RollAdvantageReason
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_Knows_Pereghost = True
#.   Tag:
#.      - BARD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:8a358009-e355-80a5-de29-236fb03ce889
msgctxt "hd3b731e9g9662g4fefga102g9b6421a89a16"
msgid "You're familiar with the Zhentarim"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = 8a358009-e355-80a5-de29-236fb03ce889
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_Knows_Pereghost = True
#.   Tag:
#.      - BARD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:8a358009-e355-80a5-de29-236fb03ce889
msgctxt "h2d1b0e9eg7338g4981g812dg068cc7d5accf"
msgid ""
"Darkhold was getting concerned. I've been sent to retrieve the shipment."
msgstr "다크홀드가 걱정하기 시작했소. 난 화물을 회수하기 위해 파견된 것이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = 8a40b69f-29b4-b679-dc5d-685e7a011e9f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:8a40b69f-29b4-b679-dc5d-685e7a011e9f
msgctxt "hec6a4531g3f09g459fg8ac0gad141ed94c02"
msgid "Thanks. But that won't be necessary. We'll find help at Waukeen's Rest."
msgstr "제안은 고맙지만 그럴 필요는 없소. 와우킨의 쉼터로 가면 도움을 받을 수 있을 거요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = 8a57c1ce-ca12-ab51-feaa-94bb37f92331
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToIndivPlayerAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:8a57c1ce-ca12-ab51-feaa-94bb37f92331
msgctxt "h272cbb1cga067g4a44g9789gf803c2959d1b"
msgid ""
"You talk big - but I don't believe you took on the whole hideout. This "
"belongs to the Zhent!"
msgstr "말은 거창하게 하는군, 하지만 당신이 은신처 전체를 차지했다는 건 못 믿겠소. 이건 젠타림의 것이오!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = 8e054d09-13d9-1d6b-d3cb-a0a25306e128
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_ChestLost = False
#.      - PLA_ZhentShipment_State_FlaskInChest = True
#.      - PLA_ZhentShipment_State_ChestNotInPlace = False
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:8e054d09-13d9-1d6b-d3cb-a0a25306e128
msgctxt "h7b46dac0g79c7g4d19g965fg879a3a55d829"
msgid "The cargo. Give it to me. Or else."
msgstr "그 화물. 내게 넘겨. 죽고 싶지 않으면."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = 91afca41-2e4a-0798-6b4b-dcc355da8bed
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 12
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_ChestLost = False
#.      - PLA_ZhentShipment_State_FlaskInChest = True
#.      - PLA_ZhentShipment_State_ChestNotInPlace = False
#.   Tag:
#.      - BARD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:91afca41-2e4a-0798-6b4b-dcc355da8bed
msgctxt "hcc069d24g714eg49e7gbc6fg11854947bf41"
msgid ""
"You'll find I'm <i>very </i>persuasive. We can make much more coin than you "
"would with your employers."
msgstr "내 말이 <i>아주 </i>설득력 있다는 걸 알게 될 거야. 당신 고용주가 내줄 돈보다 훨씬 많은 돈을 벌 수 있을 거라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = 962f5675-e2ea-c296-63b4-55438af53a60
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:962f5675-e2ea-c296-63b4-55438af53a60
msgctxt "hed7541cfg69b7g4d28gb5a2ge31e042042ee"
msgid ""
"Doesn't change the plan though - we'll head over there, and check for "
"survivors."
msgstr "하지만 계획을 바꾸지는 않을 것이오. 그곳으로 가서 생존자가 있는지 확인해 봐야겠소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = 981c5986-f628-cff5-3aa4-6888e00cb075
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:981c5986-f628-cff5-3aa4-6888e00cb075
msgctxt "hdf3df5e7ge316g497fgba6ag9f5f652167de"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = 98918696-00ad-a59b-d1bb-02ce35ec8a3c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:98918696-00ad-a59b-d1bb-02ce35ec8a3c
msgctxt "hf85a823bg8352g4ffdgae18g32365debadfa"
msgid "Invoking the Pereghost is a bold lie indeed. A smart lie, too."
msgstr "페레고스트를 언급하다니, 확실히 대담한 거짓말이오. 똑똑하기도 하고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = 9ce97660-8ac5-30a4-21ad-9ef1784f5469
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_ZhentShipment_State_RecognisedZhent = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:9ce97660-8ac5-30a4-21ad-9ef1784f5469
msgctxt "h614112f9g49b8g4f00gb01fgbc7c0aa128c4"
msgid "But we're not plump little merchants you can boss around."
msgstr "하지만 우리는 당신이 쥐고 흔들 수 있는 온순한 상인들이 아니오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Narrator
#. NodeID = a0711449-dff8-35bd-c01a-0d23dbcc0c68
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_ZhentShipment_Knows_ZhentHistoryCheck = True
#.     - GLO_Zhentarim_Knows_Zhentarim = True
#.     - PLA_ZhentShipment_Knows_Pereghost = True
#.     - PLA_ZhentShipment_State_RecognisedZhent = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:a0711449-dff8-35bd-c01a-0d23dbcc0c68
msgctxt "hfae05461gc82eg4c15g9150gde27cb02fcad"
msgid ""
"*Tarenths are the currency of a merchant network called the Zhentarim. Led "
"by the mysterious Pereghost of Darkhold, their dealings are far from "
"scrupulous.*"
msgstr ""
"*타렌스는 젠타림이라는 상인 조직망의 화폐입니다. 다크홀드의 정체불명인 페레고스트가 주선하는 젠타림의 거래는 양심과 거리가 멉니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = a0c4e0a5-6108-4f02-ec1c-9f0e810eb5e4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_ZhentShipment_State_RecognisedZhent = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:a0c4e0a5-6108-4f02-ec1c-9f0e810eb5e4
msgctxt "h4f265387gd24fg4345g92d5g52d3297d4c0c"
msgid "Black Hand be thanked. I didn't think anyone would find us."
msgstr "블랙 핸드에게 감사를. 나는 누가 우리를 찾을 것이라 생각하지도 못했소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = a52875af-9fe2-e028-3410-a7789360f156
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:a52875af-9fe2-e028-3410-a7789360f156
msgctxt "h99737a15gbf61g4dadgb14fg1a90d7ec946b"
msgid ""
"It's a pretty bit of frippery that'll sit on a mantel gathering dust. But "
"the pay for delivering it makes the risk worthwhile."
msgstr "벽난로 위에 먼지 쌓인 채 놓일 아주 적은 양의 사치품이오. 하지만 배송에 대한 보상은 위험을 감수할 만한 가치가 있소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = a8159778-675a-b7c2-b810-3488ef95cd27
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:a8159778-675a-b7c2-b810-3488ef95cd27
msgctxt "h76cb8722g2298g4f75ga6f2g05ba2a3280cf"
msgid ""
"Aye. The whole reason we're in this mess. Trinkets for some rich tosser in "
"Baldur's Gate."
msgstr "그렇소. 우리가 이 지경이 된 이유도 바로 그거요. 발더스 게이트의 졸부에게 팔 장신구들 때문이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = a8798780-2fb2-e1e7-318a-3dadaf6293ed
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_ZhentShipment_Agent_001_ToldToMeet(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:a8798780-2fb2-e1e7-318a-3dadaf6293ed
msgctxt "h84cd77c7g7194g435dg9590ga50bc9fa068a"
msgid ""
"If you haven't stopped by our Waukeen's Rest spot, you should. I'm sure "
"Zarys'd welcome such a... prestigious guest."
msgstr "와우킨의 쉼터에 있는 우리 은신처를 찾지 못했다면, 한번 가보시오. 분명 자리스는 당신 같이... 뛰어난 손님을 환영할 테니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = aa68edb9-5fc8-9f74-485e-3fb774be222b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:aa68edb9-5fc8-9f74-485e-3fb774be222b
msgctxt "h311ac667g282fg4243gabb6g4234e143746d"
msgid "Trinkets for some rich tosser in Baldur's Gate."
msgstr "발더스 게이트에 있는 졸부에게 팔 장신구들이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = acb7b6ae-1eea-3120-eb71-c4f1aee38a21
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_ZhentShipment_Agent_001_ToldToMeet(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:acb7b6ae-1eea-3120-eb71-c4f1aee38a21
msgctxt "hed7b14bdgf339g4666gb115g44eca2ace50e"
msgid ""
"Crafty swine like you could make a name for yourself in the Zhentarim. Make "
"sure to drop by our hideout."
msgstr "당신같이 영리한 자라면 젠타림에서 이름을 꽤 날릴 수 있을 것이오. 우리 은신처에 꼭 한번 들러보시오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = af5dd99f-2e33-f2e8-31e9-e558bf41e10d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_ZhentShipment_State_Intimidated = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:af5dd99f-2e33-f2e8-31e9-e558bf41e10d
msgctxt "h86fe7d4bg7293g4a3ag815bge9fc58a30409"
msgid ""
"Fine - no need for more violence. I'll tell my associates <i>everything</i> "
"was lost in the ambush."
msgstr "알겠소 - 더 이상의 폭력은 불필요하오. 내 동료들에게는 매복으로 <i>모든 것</i>이 털렸다고 말하겠소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = b20b3e27-2cf1-0b30-72b5-5419b8722273
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Zhentarim_Knows_Zhentarim = True
#.     - PLA_ZhentShipment_State_RecognisedZhent = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:b20b3e27-2cf1-0b30-72b5-5419b8722273
msgctxt "hf1162f44ga454g4646ga992gf1efa8a7837b"
msgid ""
"You know who we are - very clever. Then you probably also know it's not "
"smart to interfere with Zhent business."
msgstr "우리가 누구인지 간파했군. 아주 영리하오. 그렇다면 젠트의 사업을 방해하는 것이 현명하지 않다는 것도 알고 있을 것이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = b5f07944-85ee-9ac9-d59a-d8963b4c7104
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_RewardedWithGold = False
#.   Tag:
#.      - BARBARIAN(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:b5f07944-85ee-9ac9-d59a-d8963b4c7104
msgctxt "h54d12ad8g1ac0g4bf1gbd82g8921c664a72a"
msgid "You owe me more than a drink. How about some coin?"
msgstr "술 한잔으로는 부족할 것 같은데. 동전을 좀 내놓는 건 어때?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = baf3b195-a3ef-657d-9827-91406b7a9c20
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:baf3b195-a3ef-657d-9827-91406b7a9c20
msgctxt "h092982a6g7688g44e8gae94geaf4418ac230"
msgid "Listen. You look like you know how to handle yourself."
msgstr "들어보시오. 당신은 행동할 줄 아는 인물인 것 같소만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = bb9e30d8-9b63-1707-0681-9f32aed5612c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_RecognisedZhent = True
#.   Tag:
#.      - PALADIN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:bb9e30d8-9b63-1707-0681-9f32aed5612c
msgctxt "he472c226g46a1g430agbc42g5767e64ee02d"
msgid ""
"You're Zhent - I'd wager more than just your crew have died over these "
"'baubles'."
msgstr "당신은 젠트잖아. 그 '싸구려' 때문에 당신네 조직원만 죽은 건 아닐 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = bcf9eb7f-6742-9c53-9c44-5918d1838b27
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_ChestLost = False
#.      - PLA_ZhentShipment_State_FlaskInChest = True
#.      - PLA_ZhentShipment_State_ChestNotInPlace = False
#.   Tag:
#.      - BARBARIAN(1) = True
#. TagRule: BERSERKER
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:bcf9eb7f-6742-9c53-9c44-5918d1838b27
msgctxt "h28141a4dged4fg4c94gb218gd665885b01c0"
msgid "CHEST<b>. MINE NOW. </b>"
msgstr "<b>화물. 이제 내 거야. </b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = bcf9eb7f-6742-9c53-9c44-5918d1838b27
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_ChestLost = False
#.      - PLA_ZhentShipment_State_FlaskInChest = True
#.      - PLA_ZhentShipment_State_ChestNotInPlace = False
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:bcf9eb7f-6742-9c53-9c44-5918d1838b27
msgctxt "haf23445dg5ce0g4f23g88afg246d7483c3b1"
msgid "The chest is mine now. Only question is if you live or not."
msgstr "이제 이 화물은 내 거야. 이제 남은 질문은 당신이 살아남느냐 마느냐지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = be2a9dc5-1a31-0258-9c95-d0777311b612
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_Tavern_Knows_TavernIsBurning = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:be2a9dc5-1a31-0258-9c95-d0777311b612
msgctxt "h0c00f2b4g01ffg42e7g9504g37a7661478d8"
msgid "Waukeen's Rest has been burned to the ground."
msgstr "와우킨의 쉼터는 불타버렸는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = beac8ce2-ade9-400a-babd-03bfbec01014
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_RecognisedZhent = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:beac8ce2-ade9-400a-babd-03bfbec01014
msgctxt "hfc300b37g2dafg4341g9b33g2511101f2333"
msgid "You're Zhentarim. Your people don't deal in 'baubles'."
msgstr "당신들은 젠타림이군. 당신네 조직원들은 '싸구려'를 취급하지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = bf06c7c4-8b7a-8417-ced2-0bd1640f399c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_RewardedWithGold = False
#.   Tag:
#.      - BARBARIAN(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:bf06c7c4-8b7a-8417-ced2-0bd1640f399c
msgctxt "h9879f9f6g74d3g4ee0ga992g00ca16f52891"
msgid "It's not hospitality I want - it's coin."
msgstr "내게 필요한 건 환대가 아니야, 동전이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = c24fa5e4-020e-0c51-c5f0-95160738c805
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:c24fa5e4-020e-0c51-c5f0-95160738c805
msgctxt "hb753a174gb330g4627g9ce3g926b5b0cd726"
msgid ""
"Coin ain't any use to the dead. And dead's what I'll be if I welch on this "
"deal."
msgstr "시체에게는 동전도 소용 없소. 그리고 이 거래에 응하면 나는 시체가 될 것이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Olly
#. NodeID = c4d5d4a7-1771-c88a-560d-f3a2ce365ff1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:c4d5d4a7-1771-c88a-560d-f3a2ce365ff1
msgctxt "h8685d787g2ddcg4780g9143g0a0341bf3891"
msgid "Rugan!"
msgstr "루간!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = c5d50f8e-f552-8571-81cf-8ef6ce3cbc98
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:c5d50f8e-f552-8571-81cf-8ef6ce3cbc98
msgctxt "h6362020egd2a2g48b9g8d8dg8ef80874c3f0"
msgid "You had your chance. Either way, that cargo's mine."
msgstr "너희는 기회를 날렸어. 어찌 됐든, 그 화물은 내 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = c9bfec3f-5f6e-a48d-1a99-acd137f0fbb2
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:c9bfec3f-5f6e-a48d-1a99-acd137f0fbb2
msgctxt "h0ab8c584gf499g4209ga16fg7c3456dc89a5"
msgid ""
"If I give up that cargo, my associates will do worse to me than you ever "
"could, lad."
msgstr "내가 그 화물을 포기하면, 내 동료들이 내게 당신이 할 수 있는 어떤 것보다 심한 짓을 할 것이오, 청년."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = c9bfec3f-5f6e-a48d-1a99-acd137f0fbb2
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:c9bfec3f-5f6e-a48d-1a99-acd137f0fbb2
msgctxt "h6846a85egba5eg4192ga855g1821f692f22f"
msgid ""
"If I give up that cargo, my associates will do worse to me than you ever "
"could, lass."
msgstr "내가 그 화물을 포기하면, 내 동료들이 내게 당신이 할 수 있는 어떤 것보다 심한 짓을 할 것이오, 아가씨."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = c9bfec3f-5f6e-a48d-1a99-acd137f0fbb2
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:c9bfec3f-5f6e-a48d-1a99-acd137f0fbb2
msgctxt "h0fac71f5g5803g4fbbgbabag5e4eeb3597fb"
msgid "My associates will do worse to me than you ever could."
msgstr "당신이 무슨 짓을 하든, 내 동료들이 내게 더 심한 짓을 할 것이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = ce1c5eb4-d609-75b5-30bb-cb36e5d13f53
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_ZhentShipment_Agent_001_ToldToMeet(1) = True
#. SetFlags:
#.   Object:
#.     - PLA_ZhentShipment_Event_ClearChestOwner(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:ce1c5eb4-d609-75b5-30bb-cb36e5d13f53
msgctxt "hb9c9ccfdgc844g4fabg9fc7g7fb003a40b56"
msgid ""
"Ruthless bastard like you could make a name for yourself in the Zhentarim. "
"Make sure to drop by our hideout."
msgstr "당신 같이 인정사정 없는 무뢰한은 젠타림에서 이름을 꽤 날릴 수 있을 것이오. 우리 은신처에 꼭 한 번 들러보시오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = ce84bcc7-9046-7fc1-dc49-4ec2bc8eec39
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_ChestLost = False
#.      - PLA_ZhentShipment_State_FlaskInChest = True
#.      - PLA_ZhentShipment_State_ChestNotInPlace = False
#.   Tag:
#.      - BARBARIAN(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:ce84bcc7-9046-7fc1-dc49-4ec2bc8eec39
msgctxt "h9faf7b2egf9b7g46dag88c6g9507d4d5ef9f"
msgid "No. This is the point where I stop asking, and start cutting."
msgstr "아니. 질문은 그만두고 절단을 시작할 때지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = d10541f8-135a-e417-8443-1756e6422206
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:d10541f8-135a-e417-8443-1756e6422206
msgctxt "h3a1390c4g9de2g480bgb521gb14cf804b4fc"
msgid ""
"This whole journey's been one grim sight after another. Gnolls, goblins... "
"<i>drow</i>."
msgstr "이 여정 내내 암울한 광경이 계속 이어졌소. 놀, 고블린... 거기다 <i>드로우</i>까지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = d1e65b88-9d3a-156e-36a8-edde246ad204
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:d1e65b88-9d3a-156e-36a8-edde246ad204
msgctxt "h71441af7g6af4g4e7eg8b98g0c94491d0d05"
msgid ""
"You saved my life. I'm grateful for that - Zarys will be too - but I need to "
"deliver the cargo. This is the point when you walk away."
msgstr ""
"당신은 내 목숨을 구해줬소. 그 점은 감사하오. 자리스도 감사할 거요. 하지만 나는 화물을 배달해야 하오. 당신이 떠나야 할 때는 바로 "
"지금이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = d6c74871-de46-63e8-93a4-8c1c6cb6dad5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToIndivPlayerAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:d6c74871-de46-63e8-93a4-8c1c6cb6dad5
msgctxt "heb643d80g4a50g437ag9a77g41befb9b31ed"
msgid "Bloody fool. You don't scare me!"
msgstr "빌어먹을 멍청이 같으니. 넌 하나도 두렵지 않다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = d995a366-b6ac-dc5c-124a-15bff799918f
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_RewardedWithGold = False
#.   Tag:
#.      - BARBARIAN(1) = False
#. SetFlags:
#.   Global:
#.     - PLA_ZhentShipment_State_RewardedWithGold = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:d995a366-b6ac-dc5c-124a-15bff799918f
msgctxt "hd40cf968g5610g43e3gbeb2gdaf62b200932"
msgid "Fair. But I expect to be paid for saving your life."
msgstr "좋아. 하지만 당신네 목숨을 구해준 보상은 받고 싶군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = dccb4131-2e65-363b-5e14-3b9a3c035545
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_ChestLost = False
#.      - PLA_ZhentShipment_State_FlaskInChest = True
#.      - PLA_ZhentShipment_State_ChestNotInPlace = False
#.   Tag:
#.      - BARD(1) = False
#.      - ROGUE(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:dccb4131-2e65-363b-5e14-3b9a3c035545
msgctxt "hda4dea21g0353g46d6gb6c7g480666550390"
msgid ""
"This is your employer's mess - but we can profit. Let's sell the cargo "
"ourselves."
msgstr "너희 고용주의 일은 망했지만, 우리는 이익을 얻을 수 있어. 화물을 직접 판매하는 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = dcfae512-1fbb-ae74-0f41-5672819b5e69
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentDungeon_State_GnollZhentsPresent = False
#.      - PLA_ConflictedFlind_State_Gone = True
#.      - PLA_ZhentShipment_State_Talked = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:dcfae512-1fbb-ae74-0f41-5672819b5e69
msgctxt "hc5d8224cgd4ffg432agab23ge4eb014916a2"
msgid "By the gods, you're a sweet sight."
msgstr "신이시여, 아주 아름다운 등장이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = e2973e7c-581c-c90c-97bd-b25d6a831a2c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentDungeon_State_GnollZhentsPresent = True
#.      - PLA_ZhentShipment_State_Talked = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:e2973e7c-581c-c90c-97bd-b25d6a831a2c
msgctxt "h6bfd476fg99c9g4619g9a68g13058eefb90b"
msgid ""
"Risen Road's more dangerous than ever. Packs of gnolls running wild. Be "
"careful out there."
msgstr "치솟은 길은 어느 때보다 위험하오. 놀 무리가 돌아다니고 있더군. 밖에선 조심하시오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = e554d76e-baab-b695-a295-04f263d358be
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:e554d76e-baab-b695-a295-04f263d358be
msgctxt "h88682546g94c0g4035g935fg99f67ca4daa1"
msgid "All I saw was blood and guts."
msgstr "내가 본 것은 피와 내장뿐이었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = e5cd6ede-f1cf-b3ac-2950-7d542b0119ce
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_Rugan_Knows_SentByZarys = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:e5cd6ede-f1cf-b3ac-2950-7d542b0119ce
msgctxt "h3dc77776gef0eg460fgae55gff82565b1464"
msgid ""
"Might have been more survivors... I don't suppose you saw any of my crew "
"alive out there?"
msgstr "생존자가 더 있을지도 모르는데... 내 동료들 중 살아있는 사람은 못 봤소?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = e7c32f7b-7f44-322e-d452-8f2e0c7c1f76
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentDungeon_State_GnollZhentsPresent = False
#.      - PLA_ZhentShipment_State_Intimidated = True
#.      - PLA_ZhentShipment_State_ReadyToLeaveCave = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:e7c32f7b-7f44-322e-d452-8f2e0c7c1f76
msgctxt "h758aae7agfd31g4621g8ba7gcdc6fa788181"
msgid ""
"The chest's yours. I've got nothing else for you, and I don't want trouble."
msgstr "상자는 당신 것이오. 이제 더 이상 줄 것은 없고, 문제를 일으키고 싶진 않소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = e7dabb03-6d58-b759-e1e4-415efe80a8e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:e7dabb03-6d58-b759-e1e4-415efe80a8e7
#, fuzzy
#| msgid "I'll stay friendly - so long as your hand over all your goods."
msgctxt "h360e4bfeg89aag40a7g9b8fgad7a7d621b5f"
msgid "I'll stay friendly - so long as you hand over all your goods."
msgstr "당신네 모든 물품을 넘겨주지 않으면, 계속 우호적이진 않을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = e8c0f903-e1dd-a570-6996-040dbceff71f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:e8c0f903-e1dd-a570-6996-040dbceff71f
msgctxt "hae92bc0agea20g4459g945cg71f43e9ee702"
msgid "Damn it. I guess that's a no."
msgstr "젠장. 없다는 것이로군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = eae7ef72-6c4d-4a98-b1ef-3fad22fea7e8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Zhentarim_Knows_Zhentarim = True
#.     - PLA_ZhentShipment_State_RecognisedZhent = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:eae7ef72-6c4d-4a98-b1ef-3fad22fea7e8
msgctxt "h8ca1e120g3469g4467gb303g5f04df1d6c45"
msgid ""
"Tougher bastards than you have tried. Let's just go our separate ways, and "
"be thankful we're all in one piece."
msgstr "당신이 만난 누구보다도 거친 무뢰한들이오. 그냥 각자의 길을 가고, 우리 모두 몸이 하나로 붙어있는 것에 감사합시다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = ebf2b589-b2c5-5f35-e0f4-66dbbfca9242
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentDungeon_State_GnollZhentsPresent = False
#.      - PLA_ConflictedFlind_State_Gone = True
#.      - PLA_ZhentShipment_State_Talked = True
#.      - PLA_ZhentShipment_State_JoinedFightWithGnolls = False
#.      - PLA_ZhentShipment_State_ReadyToLeaveCave = False
#. SetFlags:
#.   Global:
#.     - PLA_ZhentShipment_State_Talked = True
#.     - PLA_ZhentShipment_State_TalkedAfterKilledGnolls = True
#.   Object:
#.     - PLA_ZhentShipment_Agent_002_StartInclusion(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:ebf2b589-b2c5-5f35-e0f4-66dbbfca9242
msgctxt "hb35b5a4fgda98g4d41ga730g18563ad9ff67"
msgid "Thank the gods that's over."
msgstr "신이시여, 감사합니다. 사태가 마무리됐어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = ee23fbc1-a928-3a09-d957-aba5560e43ab
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 52b1901d-8f80-fcd2-954a-a5798969b107_PLA_ZhentShipment_ReadMind = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:ee23fbc1-a928-3a09-d957-aba5560e43ab
msgctxt "hcf437f52g8ca4g4585g9ed9g9e040e71df1b"
msgid "Zarys sent me to secure the cargo."
msgstr "자리스가 화물을 보호하라고 나를 보냈어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = ee6a239a-89a9-2750-1928-e59efcf5732b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_CheckPocketGold = True
#. SetFlags:
#.   Object:
#.     - GEN_TransferNPCPayment(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:ee6a239a-89a9-2750-1928-e59efcf5732b
msgctxt "hc08b9d0ag9cb9g46b5gbab8gde941b302f76"
msgid "Of course. I was just about to suggest the same thing."
msgstr "물론이오. 마침 그 제안을 하려고 했소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = eef55098-4f12-949f-6eae-fc7987745f40
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - PLA_ZhentShipment_Event_ClearChestOwner(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:eef55098-4f12-949f-6eae-fc7987745f40
msgctxt "hed7866f1gf25fg4c62g8ed8g62670e1f17f3"
msgid ""
"Don't try to cut me out of the deal though. The Black Network has eyes and "
"blades <i>everywhere</i>."
msgstr "하지만 날 빼놓고 거래할 생각은 하지 마시오. 검은 조직망은 <i>사방에</i> 눈과 칼날을 두고 있으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = ef3f7598-80ed-8444-5660-facadb415e02
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToIndivPlayerAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:ef3f7598-80ed-8444-5660-facadb415e02
msgctxt "hd0c49447g72f5g42a0g9637g89b693ff6b4b"
msgid "I'll be taking <i>your</i> coin."
msgstr "네 동전을 가져가겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = ef5f6bed-0098-1eb7-4378-b6212f520ed7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:ef5f6bed-0098-1eb7-4378-b6212f520ed7
msgctxt "h6e62f8cbg4278g42bcgb6dbg8612c5d4f1eb"
msgid "Let's go our separate ways, and be thankful we're all in one piece."
msgstr "이제 각자의 길을 가고, 우리 모두 몸이 하나로 붙어있는 것에 감사합시다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = f095a2f6-aea0-be7f-0a52-71eb806858c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:f095a2f6-aea0-be7f-0a52-71eb806858c4
msgctxt "hdfb7545cgb0aeg4657ga27dgadc69f99f983"
msgid "Zhentarim agents guarding a single chest. Curious."
msgstr "젠타림 요원들이 지키고 있는 상자라. 그거 호기심이 생기는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = f1eaa55b-99c5-5f99-3a82-6122b7030a1e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:f1eaa55b-99c5-5f99-3a82-6122b7030a1e
msgctxt "hbfc6c1c0g8cf1g405fg9704g2dbad5c63d7c"
msgid ""
"You bloody idiot. If Zarys doesn't get that chest, she'll have us all killed."
msgstr "지독한 멍청이군. 만약 자리스가 그 상자를 가지지 못하면, 그녀가 우리 모두를 죽일 거요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = f3edce7e-a826-2612-44a7-179670a602cb
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 52b1901d-8f80-fcd2-954a-a5798969b107_PLA_ZhentShipment_ReadMind = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:f3edce7e-a826-2612-44a7-179670a602cb
msgctxt "h94fddaf9g7d37g4ab4g8fb4gc5b71b7c3055"
msgid ""
"<i>Shame we lost so many agents. But the chest is all that matters - Zarys'd "
"have our hides if we lost it.</i>"
msgstr ""
"<i>너무 많은 요원들을 잃은 건 안타깝지만 이 상자가 제일 중요해. 우리가 이걸 잃으면 자리스가 우리 가죽을 벗겨낼 거야.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Player
#. NodeID = f4429071-830f-9015-5076-4f33706c212c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:f4429071-830f-9015-5076-4f33706c212c
msgctxt "hc768ead6g53a5g4209g9c16gb08f5b1b615c"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = f47f8278-5401-5d55-0b20-0bceb885cb88
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_Persuaded = True
#.      - PLA_ZhentDungeon_State_GnollZhentsPresent = False
#.      - PLA_ZhentShipment_State_ReadyToLeaveCave = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:f47f8278-5401-5d55-0b20-0bceb885cb88
msgctxt "hb26bed72g2ea0g4270gb7f6g588a98c58e60"
msgid ""
"Remember - getting that chest to Baldur's Gate is your job. Then we share "
"the profits."
msgstr "기억하시오, 당신 역할은 저 상자를 발더스 게이트까지 가지고 가는 것이오. 그런 뒤에 수익을 나누는 거요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = f4a1023c-08f7-2d91-686c-93b5d9fbea1a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:f4a1023c-08f7-2d91-686c-93b5d9fbea1a
msgctxt "h427140dbgd445g41bag96ebga6fb7b6837df"
msgid ""
"The chest's all yours. Damn thing's sealed tighter than a Duke's "
"pursestrings, so there's no point in trying to open it."
msgstr ""
"이 상자에 들어있는 건 모두 당신 것이오. 망할 것이 공작의 지갑 끈보다 더 단단히 봉해져 있어서, 열려고 해도 소용 없을 것이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = f575bfd4-fd49-e1ab-4eb3-57206307f72c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_ZhentShipment_State_Intimidated = True
#.   Object:
#.     - PLA_ZhentShipment_Event_ClearChestOwner(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:f575bfd4-fd49-e1ab-4eb3-57206307f72c
msgctxt "h802c9145gfb1fg4db0gaecag5ef1468ac478"
msgid "Take it. Just let me go - you don't need any more blood on your hands."
msgstr "가져가시오. 그리고 날 그냥 보내주시오, 더 이상 손에 피를 묻힐 필요는 없잖소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Narrator
#. NodeID = fa11d419-4e1d-1eae-678d-8f2357b78340
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_ZhentShipment_Knows_ZhentHistoryCheck = True
#.     - GLO_Zhentarim_Knows_Zhentarim = True
#.     - PLA_ZhentShipment_State_RecognisedZhent = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:fa11d419-4e1d-1eae-678d-8f2357b78340
msgctxt "h7eebced7g74bag43fcg8d4agc824c18c14d7"
msgid ""
"*Tarenths are the currency of the Zhentarim - a network of merchants and "
"mercenaries with few scruples.*"
msgstr "*타렌스는 양심을 찾을 수 없는, 젠타림이라는 상인 및 용병 조직망의 화폐입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = fc038c1b-86a3-fc1d-30cd-899e7386ab6c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:fc038c1b-86a3-fc1d-30cd-899e7386ab6c
msgctxt "hdceab406g5656g4f3dgbb82g686e06b92d4b"
msgid ""
"I'd rather walk away too. So let's say our goodbyes, and speak no more of it."
msgstr "나도 그냥 떠나는 편을 택하겠소. 그러니 작별 인사를 하고 이쯤 헤어지지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = fe2ddced-2628-e2a2-5be0-b719e6517f56
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_ZhentShipment_Agent_001_ToldToMeet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:fe2ddced-2628-e2a2-5be0-b719e6517f56
msgctxt "hbbf40112g3b4dg4c55g8b5fg906e8565fcc8"
msgid ""
"Crafty swine like you could make a name for yourself in the Zhentarim. Make "
"sure to drop by our hideout."
msgstr "당신같이 영리한 자라면 젠타림에서 이름을 꽤 날릴 수 있을 것이오. 우리 은신처에 꼭 한번 들러보시오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001
#. Speaker = Rugan
#. NodeID = ffa25346-12f9-3cda-1cf0-eeaa93422e9f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentDungeon_State_GnollZhentsPresent = True
#.      - PLA_ZhentShipment_State_Talked = True
#.      - PLA_ZhentShipment_Rugan_Knows_SentByZarys = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001:ffa25346-12f9-3cda-1cf0-eeaa93422e9f
msgctxt "h3945b62bg9021g48f1g808dgd23d6a291a2c"
msgid "Thanks again. Hope Zarys treated you to something nice."
msgstr "다시 한번 고맙소. 자리스가 좋은 대접을 해주었길 바라오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave
#. Speaker = Rugan
#. NodeID = 0181bc81-fabc-60d9-219a-daac147425e9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_ZhentShipment_Event_ProvokeGnolls = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave:0181bc81-fabc-60d9-219a-daac147425e9
#, fuzzy
msgctxt "h079bf60cgb3b5g45aag93d8gce629962f0f7"
msgid "Come and get us, you hairy bastards!"
msgstr "와서 우리를 잡아봐라, 털복숭이 개자식들아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave
#. Speaker = Player
#. NodeID = 0791c42e-a99e-ced5-cb79-6481d37274a9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave:0791c42e-a99e-ced5-cb79-6481d37274a9
msgctxt "h39249d05gaaabg41c5g814dg4cd8b44e81a7"
msgid "You're right - it's time."
msgstr "그 말이 맞아. 때가 됐다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave
#. Speaker = Player
#. NodeID = 0b33b01b-44a1-bc55-9906-7b7868d546e8
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Local:
#.      - dfe46b12-bdbe-58e5-1c94-3b8c1313cf9f_PLA_ZhentShipment_State_DiscussedReward = False
#. SetFlags:
#.   Local:
#.     - dfe46b12-bdbe-58e5-1c94-3b8c1313cf9f_PLA_ZhentShipment_State_DiscussedReward = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave:0b33b01b-44a1-bc55-9906-7b7868d546e8
#, fuzzy
msgctxt "h6ed23daeg4a9cg4ca4gbcb6gd0bc4e5aa6f0"
msgid "One of us is getting out of here richer - I don't fight for free."
msgstr "우리 중 한 명은 더 부유하게 이곳을 떠날 수 있지. 나는 무보수로 싸우지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave
#. Speaker = Player
#. NodeID = 0fa936f5-2566-16c7-b5e9-75def57178ef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave:0fa936f5-2566-16c7-b5e9-75def57178ef
msgctxt "h33f69abag64eag4604gbaebg1e0477081d55"
msgid "Fine. Follow my lead."
msgstr "알았어. 내 지시를 따라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave
#. Speaker = Rugan
#. NodeID = 167a47ef-c37c-cb1d-596e-841a0ca875f5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave:167a47ef-c37c-cb1d-596e-841a0ca875f5
msgctxt "h67d5dca6g8bbeg4107gac04gfc765c6d418c"
msgid "Hush, Olly."
msgstr "조용히 해, 올리."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave
#. Speaker = Rugan
#. NodeID = 28465150-3998-a09b-3b83-e446ebfda901
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_ZhentShipment_State_AgreedToHelpInBattle = True
#.     - PLA_ZhentShipment_Event_AgentsAttackGnolls = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave:28465150-3998-a09b-3b83-e446ebfda901
msgctxt "hb76c7727g7ccag4e1egb515gc53220d20a21"
msgid "Let's take them!"
msgstr "저놈들을 상대합시다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave
#. Speaker = Olly
#. NodeID = 2cf9c954-1a8a-54b8-b6cb-82d03b99204e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave:2cf9c954-1a8a-54b8-b6cb-82d03b99204e
msgctxt "h1e66f09eg32bag4c4fg8bacga50426c4cd77"
msgid "You can't leave us!"
msgstr "우리를 버리지 마세요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave
#. Speaker = Player
#. NodeID = 2de6abea-3b81-63cf-401b-3cf2597e97d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave:2de6abea-3b81-63cf-401b-3cf2597e97d4
msgctxt "h08491497g7097g4bdfg9167g45def1d110de"
msgid "You're on your own."
msgstr "당신들 스스로 해결해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave
#. Speaker = Rugan
#. NodeID = 3374f2cc-11d1-cea6-9299-c0de75b6cc78
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_ZhentShipment_State_AgreedToHelpInBattle = True
#.     - PLA_ZhentShipment_Event_AgentsAttackGnolls = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave:3374f2cc-11d1-cea6-9299-c0de75b6cc78
msgctxt "hdb26f622g5a88g4ff1g9f74g3e0ac9f0226e"
msgid ""
"We can handle ourselves - they got the drop on us before, but it's time for "
"payback."
msgstr "우리 앞가림은 할 수 있소. 전에도 저놈들에게 선제공격을 당했지만, 이제 갚아줄 때요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave
#. Speaker = Rugan
#. NodeID = 33874791-a7ab-f095-16af-c09b6c8e73b3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - PLA_ZhentShipment_Agent_002_EndInclusion(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave:33874791-a7ab-f095-16af-c09b6c8e73b3
msgctxt "h3c969a3dge62eg4b4fgaa82g46e673bacb01"
msgid ""
"I know me and the boy are expendable. Comes with the job. But we can fight - "
"no sense in leaving us behind."
msgstr ""
"나와 이 청년이 소모품이라는 건 알고 있소. 이 일에 따르는 결과지. 하지만 우리는 함께 싸울 수 있소. 우리를 버리고 떠날 이유는 "
"없잖소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave
#. Speaker = Player
#. NodeID = 3997eae0-241a-545f-6295-8999a6e8b35f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave:3997eae0-241a-545f-6295-8999a6e8b35f
msgctxt "hddf6ec14g9cb4g45a4g932agb6cc54bc4218"
msgid "There's another way out - follow me."
msgstr "다른 탈출구가 있어. 나를 따라와."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave
#. Speaker = Player
#. NodeID = 3dd669d9-72eb-2491-e771-86772874e779
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Quest:
#.      - PLA_ZhentShipment.AgreedHelp(1) = True
#. SetFlags:
#.   Global:
#.     - PLA_ZhentShipment_Rugan_Knows_SentByZarys = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave:3dd669d9-72eb-2491-e771-86772874e779
#, fuzzy
msgctxt "hc65a9493g1330g4a7cgb4e5g519c8aede055"
msgid "Your Zhentarim friends sent me to retrieve the cargo."
msgstr "당신네 젠타림 친구가 화물을 되찾으라고 나를 보냈어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave
#. Speaker = Rugan
#. NodeID = 4856ecbf-2743-1583-ad6a-3207cd1edf88
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave:4856ecbf-2743-1583-ad6a-3207cd1edf88
msgctxt "hd7dde216gfe6bg4cbbg8d3ag855df794d39c"
msgid "We don't <i>have</i> time. Hurry!"
msgstr "시간이 <i>촉박하오</i>. 서둘러주시오!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave
#. Speaker = Rugan
#. NodeID = 4e55566f-3564-feb8-cbc4-cc6b3a842e29
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_CheckPocketGold = True
#. SetFlags:
#.   Global:
#.     - PLA_ZhentShipment_State_AgreedToHelpInBattle = True
#.     - PLA_ZhentShipment_Event_AgentsAttackGnolls = True
#.   Object:
#.     - GEN_TransferNPCPayment(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave:4e55566f-3564-feb8-cbc4-cc6b3a842e29
msgctxt "h02a3c607ge126g4172g86f6gd56297e07048"
msgid "There, you are fairly bought and paid for. Let's take them!"
msgstr "자, 당신은 공정하게 거래를 맺었고 지불을 약속받았소. 저놈들을 상대합시다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave
#. Speaker = Rugan
#. NodeID = 50c6da40-5fb8-d3f1-f390-60038d2bd3de
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_ZhentShipment_State_RewardedWithGold = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave:50c6da40-5fb8-d3f1-f390-60038d2bd3de
msgctxt "h6f9db435g3fc3g480agb4d9gf750ff299f3c"
msgid "Fine. Money's useless to dead men."
msgstr "좋소. 죽으면 돈도 쓸모가 없으니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave
#. Speaker = Rugan
#. NodeID = 53f50774-7c09-073f-f11b-4a3a7a54ffde
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_TalkedToRugan = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave:53f50774-7c09-073f-f11b-4a3a7a54ffde
msgctxt "h2a79c14cgd846g4b7eg8119gdb7931cc60cb"
msgid ""
"We need to deal with those beasts <i>now</i>. They're hungry enough to brave "
"the fire."
msgstr "<i>지금 당장</i> 저 짐승들을 처리해야 하오. 놈들은 불을 무릅쓰고 달려들 정도로 배가 고파 보이는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave
#. Speaker = Rugan
#. NodeID = 5e806746-c282-9834-8a25-e309e51a0a3f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_TalkedToRugan = False
#.   Object:
#.      - PLA_ZhentShipment_Event_WarnInStandardDialog(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave:5e806746-c282-9834-8a25-e309e51a0a3f
msgctxt "hd4f9a156g729dg4e53g9297gd89e2874b1c7"
msgid "There's nothing in there that'll help - leave it!"
msgstr "거기 도움이 될 만한 것은 없소 - 그냥 두시오!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave
#. Speaker = Player
#. NodeID = 5fb1627e-87e4-0924-ffab-e2b9c29a3ce4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave:5fb1627e-87e4-0924-ffab-e2b9c29a3ce4
msgctxt "hc071ec88g39f2g4087g97d1ga80cb9f220ac"
msgid "Ready? Let's kill those gnolls."
msgstr "준비됐어? 이 놀들을 처치해 버리자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave
#. Speaker = Rugan
#. NodeID = 65728470-0257-6991-63db-411ad25fd668
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_ZhentShipment_State_AgreedToHelpInBattle = True
#.     - PLA_ZhentShipment_Event_AgentsAttackGnolls = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave:65728470-0257-6991-63db-411ad25fd668
msgctxt "h363b3d51gaabcg4b6ag88f1g1e11f6c8b790"
msgid ""
"Thanks. Me and the boy will do what we can to help - we've still got some "
"fight in us."
msgstr "고맙소. 나와 이 청년이 최대한 도울 것이오. 우리에게는 아직 투지가 남아있소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave
#. Speaker = Rugan
#. NodeID = 6ec56c88-78af-c3f4-75ba-56b842adf3bb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_CheckPocketGold = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave:6ec56c88-78af-c3f4-75ba-56b842adf3bb
msgctxt "h4996548cg0bd8g4bd0g8432g20397f488a0e"
msgid "Damn it... must have dropped my purse."
msgstr "망할... 지갑을 떨어뜨린 것 같소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave
#. Speaker = Player
#. NodeID = 70f4635b-170c-3bf7-9cf1-53b2d4cf68f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave:70f4635b-170c-3bf7-9cf1-53b2d4cf68f5
msgctxt "hf16fb5fbg3ff7g4040gb314g96e1beea9cf2"
msgid "I'm here for the cargo - rescuing you isn't part of the plan."
msgstr "나는 화물을 위해 온 거야. 너희를 구해줄 생각은 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave
#. Speaker = Player
#. NodeID = 77253fae-990f-eb47-5c5e-4011f3961812
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave:77253fae-990f-eb47-5c5e-4011f3961812
msgctxt "h1a10fad3g5695g4dcegb115g92cbf6efe512"
msgid "You'll only get in the way."
msgstr "너희는 방해만 될 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave
#. Speaker = Rugan
#. NodeID = 774a31bb-2702-ba0d-5857-9ddbe2e60e70
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_ZhentShipment_Quest_AttackedAgents = True
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave:774a31bb-2702-ba0d-5857-9ddbe2e60e70
msgctxt "h37bb383dg31c4g4ff6g8b6bgdf1fffb07f2e"
msgid "Bloody fool. I hope those monsters tear you to shreds!"
msgstr "빌어먹을 멍청이 같으니. 저 괴물들이 너를 갈가리 찢어버리길!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave
#. Speaker = Rugan
#. NodeID = 78e287e2-5ae3-b763-d714-76fee3e0a851
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave:78e287e2-5ae3-b763-d714-76fee3e0a851
msgctxt "hc2afd4a4g2d35g4844gbe4ag0f0e9dfad305"
msgid ""
"Across the chasm? You might have got in that way, but you're stuck with us "
"now."
msgstr "틈새를 가로질러서? 당신이 그렇게 넘어왔을지라도, 지금은 우리와 함께 갇혀있는 꼴이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave
#. Speaker = Player
#. NodeID = 7e4bf1c4-1ca1-7187-3e1a-e0667634ff90
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave:7e4bf1c4-1ca1-7187-3e1a-e0667634ff90
msgctxt "h7d987ed6g4620g4dd0g9cc9gcac2ecb29c8c"
msgid "Hold the line while I prepare for the fight."
msgstr "내가 전투를 준비하는 동안 자리를 지켜."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave
#. Speaker = Player
#. NodeID = 848874f4-683c-c06f-9f3d-ec97210eb0fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave:848874f4-683c-c06f-9f3d-ec97210eb0fc
msgctxt "h9cf14e87g83e3g4259g9da9g294986923875"
msgid "Fine. Follow my lead."
msgstr "알았어. 내 지시를 따라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave
#. Speaker = Player
#. NodeID = 983e6e4d-be56-b142-a5d7-689c64c98db2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave:983e6e4d-be56-b142-a5d7-689c64c98db2
msgctxt "h10ae3ef6g106eg4f73g9733g3c8297f3e4c7"
msgid "You'll only get in the way."
msgstr "너희는 방해만 될 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave
#. Speaker = Rugan
#. NodeID = afa5f489-0178-03c9-09d3-754d885d621b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ConflictedFlind_State_NotEncountered = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave:afa5f489-0178-03c9-09d3-754d885d621b
msgctxt "h43428336gcbf9g4d91g99fegf5822d1d1541"
msgid "If you're here to help, get to the fight quickly!"
msgstr "여기 도우러 온 것이라면, 빨리 함께 싸우시오!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave
#. Speaker = Player
#. NodeID = b3857959-5885-258f-f40e-aee2ac6b7ea7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave:b3857959-5885-258f-f40e-aee2ac6b7ea7
msgctxt "he1048228g3e75g4598g9c3eg37055bbce4ac"
msgid ""
"You misunderstand. I'm not going to leave you behind - I'm going to kill you."
msgstr "오해하고 있군. 나는 너희를 버리려는 게 아니라, 죽이려는 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave
#. Speaker = Rugan
#. NodeID = be019026-7ca3-2c60-43da-64d70d862b48
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TIEFLING(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave:be019026-7ca3-2c60-43da-64d70d862b48
msgctxt "h297b5cbbg9955g4397g912cgc44570657462"
msgid "Half-devil you might be, but I don't see any wings."
msgstr "당신이 반은 데빌일지 모르겠지만, 날개는 보이지 않는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave
#. Speaker = Player
#. NodeID = c244fa50-d525-dba6-0a30-0b6d1747737c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave:c244fa50-d525-dba6-0a30-0b6d1747737c
msgctxt "h91e9c8d9gde44g4b52g9c97gd483ce4e7996"
msgid "All right. Hold the line while I prepare for battle."
msgstr "알았어. 내가 전투를 준비하는 동안 자리를 지켜."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave
#. Speaker = Rugan
#. NodeID = c4762d5e-0310-3b32-1283-8420e280b398
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave:c4762d5e-0310-3b32-1283-8420e280b398
msgctxt "hde97d486gd74dg42c0g907dga2246820d86e"
msgid ""
"Aye, that we can do. The fire won't hold them forever though. Be quick about "
"it."
msgstr "좋소, 그건 할 수 있지. 하지만 불이 영원히 저놈들을 막지는 못할 것이오. 서둘러주시오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave
#. Speaker = Rugan
#. NodeID = d00a6b07-d41a-13fb-233d-8c6277aac0e0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_ZhentShipment_State_AgreedToHelpInBattle = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave:d00a6b07-d41a-13fb-233d-8c6277aac0e0
msgctxt "h6e369279gfe5bg44bbg8a35g7da0d1125e03"
msgid "Right you are. If we get out of this, I owe you."
msgstr "그러겠소. 우리가 여기서 나간다면, 당신에게 빚을 질 것이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave
#. Speaker = Rugan
#. NodeID = d0385683-3bad-f630-c79e-83a586a7b2bb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave:d0385683-3bad-f630-c79e-83a586a7b2bb
msgctxt "hc1b9d9c4gade8g4e92gb196gb978f93edd32"
msgid "Counter-offer. You fight with us, or you die with us."
msgstr "역제안을 하지. 우리와 함께 싸우던가, 우리와 함께 죽으시오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave
#. Speaker = Player
#. NodeID = d17d2608-f0b4-f913-ec3e-f042f4209e16
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave:d17d2608-f0b4-f913-ec3e-f042f4209e16
msgctxt "h8ae05e31g365fg4af7gb792g14459a230c59"
msgid "There's another way out - follow me."
msgstr "다른 탈출구가 있어. 나를 따라와."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave
#. Speaker = Rugan
#. NodeID = d98686ba-b899-1ed7-e7e7-0c0d8eb704fe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_BothAgentsAreAlive = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave:d98686ba-b899-1ed7-e7e7-0c0d8eb704fe
msgctxt "h3ca13409g3899g400cg8745g5c2b8cd992f6"
msgid ""
"I know I'm expendable. Comes with the job. But I can fight - no sense in "
"leaving me behind."
msgstr ""
"나도 내가 소모품인 건 알고 있소. 일의 특성상 어쩔 수 없는 일이지. 하지만 난 싸울 수 있소, 날 두고 가는 건 비이성적인 일이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave
#. Speaker = Rugan
#. NodeID = da0ff18b-f3c8-c4da-ee2f-2721fc86883d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave:da0ff18b-f3c8-c4da-ee2f-2721fc86883d
msgctxt "h554c40f1gd1cbg4ac1g96fdg7feccb5cec6a"
msgid ""
"You're working for Zarys? Didn't expect that black-hearted vixen to send "
"help. Bloody grateful, mind."
msgstr "자리스의 명령을 받았소? 그 음흉한 여우가 지원을 보낼 줄은 몰랐는데. 기막히게 고맙소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave
#. Speaker = Rugan
#. NodeID = e5ce3f86-eb77-5c10-06df-d0f87bd4875f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_ZhentShipment_State_AgreedToHelpInBattle = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave:e5ce3f86-eb77-5c10-06df-d0f87bd4875f
msgctxt "h20efbad6gd888g44abga10cg5c6e4806e1d3"
msgid ""
"I can handle myself. They got the drop on us before, but it's time for "
"payback."
msgstr "내 몸은 간수할 수 있소. 전에는 놈들이 유리한 위치에 있었지만, 이제 반격의 시간이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave
#. Speaker = Player
#. NodeID = ea3b8ef1-094d-c58c-3eb2-286e1eedb1cc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave:ea3b8ef1-094d-c58c-3eb2-286e1eedb1cc
msgctxt "h78e29136g6694g47f7gbb67g1a0036769cd9"
msgid "I still need more time to prepare."
msgstr "아직 대비할 시간이 더 필요해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave
#. Speaker = Rugan
#. NodeID = ecaff906-d7e0-8198-6ec9-9e7731b2a617
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_TalkedToRugan = False
#.   Object:
#.      - PLA_ZhentShipment_Event_WarnInStandardDialog(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave:ecaff906-d7e0-8198-6ec9-9e7731b2a617
msgctxt "he4744700g04beg4d1egafbfg0a99f3b7c356"
msgid "Who the hells? Get over here and help!"
msgstr "거기 대체 누구요? 와서 도와주시오!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave
#. Speaker = Player
#. NodeID = edc87703-ea17-2065-3615-3b2f5c4e97d5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave:edc87703-ea17-2065-3615-3b2f5c4e97d5
msgctxt "hf827198eg1c54g4790ga658ged690dc55d0c"
msgid ""
"You misunderstand. I'm not going to leave you behind - I'm going to kill you."
msgstr "오해하고 있군. 나는 너희를 버리려는 게 아니라, 죽이려는 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave
#. Speaker = Rugan
#. NodeID = f4edbec9-d45c-4ed0-4523-6c6058a6eb90
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_ZhentShipment_Event_ProvokeGnolls = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave:f4edbec9-d45c-4ed0-4523-6c6058a6eb90
msgctxt "ha17bfb85g1621g43aag923egb4312d4431e7"
msgid ""
"Can't say I wouldn't do the same - but if we're dying here, you're dying "
"with us!"
msgstr "나라고 달랐을 거라 말할 수 없지만, 우리가 여기서 죽는다면, 당신도 함께 갈 것이오!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave
#. Speaker = Rugan
#. NodeID = f506cca1-1894-0bb3-6c77-025573e2844a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_ZhentShipment_State_AgreedToHelpInBattle = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave:f506cca1-1894-0bb3-6c77-025573e2844a
msgctxt "h316a417fgda42g459agac02g13eb99396a88"
msgid "Get us out of this, and I <i>swear</i> we'll make it worth your while."
msgstr "우리가 처한 상황을 해결해 주면, <i>장담하건대</i> 분명 후회하지 않을 거라고 약속하오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave
#. Speaker = Player
#. NodeID = f53aa87e-da28-6593-b91b-61bf815a295c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave:f53aa87e-da28-6593-b91b-61bf815a295c
msgctxt "hc3423885gc1c1g4427ga4e2g40e79d2ecf5c"
msgid "I'll deal with the gnolls."
msgstr "내가 놀들을 처리하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave
#. Speaker = Rugan
#. NodeID = fb00483e-2b23-c6f2-336e-c4c2a17549c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave:fb00483e-2b23-c6f2-336e-c4c2a17549c1
msgctxt "hb92dd181g0276g4366g99d6g803fd0557064"
msgid ""
"If we don't deal with them gnolls, <i>none</i> of us are getting out of here "
"alive."
msgstr "저 놀들을 처리하지 못하면, 우리 중 <i>아무도</i> 여기서 살아서 나갈 수 없을 것이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave
#. Speaker = Rugan
#. NodeID = fbcfd697-76ef-133f-4379-b5b4a0eaaaa7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_ZhentShipment_State_AgreedToHelpInBattle = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Cave:fbcfd697-76ef-133f-4379-b5b4a0eaaaa7
msgctxt "h916d7493gb664g4369gb1acg5e53a13df3d9"
msgid "When the fighting starts, we'll be right alongside you."
msgstr "전투가 시작되면, 우리가 곧바로 당신 편에 서겠소."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Crime
#. Speaker = Rugan
#. NodeID = 0278c71a-24a3-311a-97bf-319a03bd4aa8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ConflictedFlind_State_Gone = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Crime:0278c71a-24a3-311a-97bf-319a03bd4aa8
msgctxt "hf4063bedg1706g4468g8a47g49b5c8122e1a"
msgid "You've my gratitude for helping with the gnolls - but that ain't yours."
msgstr "놀 문제를 도와준 일은 정말 고맙게 생각하지만, 그건 당신 물건이 아니오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Crime
#. Speaker = Rugan
#. NodeID = a8c9c138-cb99-60a4-ad83-60a8d21aaa72
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_001_Crime:a8c9c138-cb99-60a4-ad83-60a8d21aaa72
