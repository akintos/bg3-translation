msgid "What's this rune, now?"
msgstr "이 룬은 뭐지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HarperSpy_PAD_FoundRune
#. Speaker = Player
#. NodeID = 9755bd82-91ad-45e1-a00e-2bc54937bf9a
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
