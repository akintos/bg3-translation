msgctxt "h3f81b1c5g4799g4afdga033gcad9160d1450"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_OwlBear_LastCub
#. Speaker = Player
#. NodeID = a8b21248-7174-448e-b282-285331786121
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_OwlBear_LastCub:a8b21248-7174-448e-b282-285331786121
msgctxt "h5813bdaegfc33g4031gb02dg2440d0bf2900"
msgid "<i>Try to understand what's happening.</i>"
msgstr "<i>무슨 일이 일어나는지 이해하려 애쓴다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_OwlBear_LastCub
#. Speaker = Player
#. NodeID = aa722f89-115a-241c-5396-bce80e8d987d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_OwlBear_LastCub:aa722f89-115a-241c-5396-bce80e8d987d
msgctxt "hc14f65ebgdd97g40ebg9ee6g6e46b642440e"
msgid "<i>Let the creature live.</i>"
msgstr "<i>생물을 살려둔다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_OwlBear_LastCub
