msgctxt "h6dee43c3g82d3g4f77g868cgea85ea061378"
msgid ""
"VO_SFX description: Heavy lifting efforts to try to keep gate open (along "
"with Aradin & Barth). It's too heavy so the gate slams shut"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/SFX_DEN_RaidingParty_PleaAtTheGate
#. Speaker = Kanon
#. NodeID = aa945866-4b46-707c-8ead-63b79df2171a
