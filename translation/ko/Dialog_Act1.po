msgctxt "h56146ff8g2756g43ccg9409g755439a12097"
msgid ""
"<i>Try to recall and invoke the ancient githyanki war rites of parley.</i>"
msgstr "<i>고대 기스양키의 전시 협상 의식을 회상하여 불러낸다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Gish Far'aag
#. NodeID = dbd329bd-6c0d-99ee-dbb3-14f50b98cc7f
#. HandlePath = TaggedText[0].TagText[0]
