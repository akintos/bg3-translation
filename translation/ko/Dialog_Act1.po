#. NodeID = 16aa5b9c-1e9b-43f9-7d95-ed9e41b519f6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:16aa5b9c-1e9b-43f9-7d95-ed9e41b519f6
msgctxt "h36f13a1dgcb9eg43a3ga43dg4e4ad09d7ba0"
msgid ""
"We're celebratin' a raid. Set Waukeen's Rest ablaze - caught ourselves a "
"duke an' all."
msgstr "우린 습격을 축하하고 있었어. 와우킨의 쉽터에 불을 지르고, 우리 힘으로 공작을 붙잡았다구."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = 1854cbb2-b52d-4b5c-feb8-1ae9a404a98e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:1854cbb2-b52d-4b5c-feb8-1ae9a404a98e
msgctxt "h12fd28f3gc9ebg4365g9760g8e519ada6784"
msgid "How'd you know?"
msgstr "어떻게 알았지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Narrator
#. NodeID = 185932c5-33b2-e0be-0f1b-1412a6ee7f57
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:185932c5-33b2-e0be-0f1b-1412a6ee7f57
msgctxt "hd9585ce0gd2d5g4b3bgbf5eg5d533e232640"
msgid "*A shiver runs across your mind... You feel sated.*"
msgstr "*전율이 불현듯 머릿속을 스쳐 지나가고... 만족감이 듭니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Karlach
#. NodeID = 188fb09c-bf73-df0c-75a6-986e11bd0c06
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_KARLACH(6) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:188fb09c-bf73-df0c-75a6-986e11bd0c06
msgctxt "h53abd4adg2237g4d93g9ca7g692e39238168"
msgid "Sounds rancid. Let's see if we can get him out of there."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Player
#. NodeID = 190d1ace-39d8-abaa-0d0a-9631c980000c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#.      - BERSERKER(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:190d1ace-39d8-abaa-0d0a-9631c980000c
msgctxt "hc73ec9a3g9ce3g445bgb023gc0cac9686f85"
msgid "That's nature's bounty. Helps the trees grow. Eat it, or else."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = 1a0ef335-58b7-7e36-6760-19d63e10e6c4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_Checkpoint_State_NonCharlatanAccess = True
#.   Local:
#.     - ea1c936b-d031-511b-6972-f130fc657795_TadpoleSuccess = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:1a0ef335-58b7-7e36-6760-19d63e10e6c4
msgctxt "h8a5dfa5eg5589g47c7gb9ffgcae116422a71"
msgid "Down, Klaw! Bad girl!"
msgstr "얌전히 굴어, 클로! 나쁜 년아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Narrator
#. NodeID = 1c296709-2033-8e49-2956-dc934104da24
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount3(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount3(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:1c296709-2033-8e49-2956-dc934104da24
msgctxt "hecb7293ag945ag400cg9405gf0ce489b5733"
msgid "*Your mind lurches, reeling suddenly as if... bitten.*"
msgstr "*뭔가에 깨물린 것처럼 느닷없이 정신이 휘청거립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = 1d977b73-b428-47a8-60bb-57bfba377942
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:1d977b73-b428-47a8-60bb-57bfba377942
msgctxt "h4f992127g0825g4658gab8fge6989834f463"
msgid "Hhheh! Whatever calls you."
msgstr "흐흐흐헤! 너 맘대로."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Narrator
#. NodeID = 1eee606a-d2f0-34a4-8dfb-496e428f6a43
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - GLO_TadpoleIntro_NPC(1) = False
#. SetFlags:
#.   User:
#.     - GLO_TadpoleIntro_NPC(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:1eee606a-d2f0-34a4-8dfb-496e428f6a43
msgctxt "h74ddb2begac89g4bcagb791g41d6ae7ba590"
msgid ""
"*A strange symbol glows, marked on their flesh, and something within you "
"stirs in response.*"
msgstr "*그들의 살갗에 새겨진 기묘한 상징이 빛나고, 이에 반응하여 당신 내면의 무언가가 꿈틀거립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = 2033f003-900e-e860-6e7f-50e734e0c875
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:2033f003-900e-e860-6e7f-50e734e0c875
msgctxt "ha94f8f0dg41f8g453ag9080g2497a1696b7c"
msgid "Don't know any Halsin, your excelness."
msgstr "어느 할신도 모릅니다, 나으리."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Player
#. NodeID = 22f803e3-f92d-4a2e-02d9-6b36a1977315
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 0
#. CheckFlags:
#.   Local:
#.      - eaea790d-b9b8-b786-370a-5466a9185c91_MINDREAD = False
#.   Script:
#.      - GEN_CanDetectThoughts_2 = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:22f803e3-f92d-4a2e-02d9-6b36a1977315
msgctxt "h7f12868dga043g452fga4f2ga943ae4b70a5"
msgid "<i>Read the goblin's mind.</i>"
msgstr "<i>고블린의 생각을 읽는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = 2572b29a-013d-3f98-6755-fa726ee9f452
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:2572b29a-013d-3f98-6755-fa726ee9f452
msgctxt "hf3e9e43ag91a1g4f36gbee7gcc578fc3ef28"
msgid ""
"Ah, right! Beg pardon - gotta give all visitors the ol' squinty eye, y'know?"
msgstr "아, 맞다! 용서해 주세요 - 여길 찾는 모든 사람을 의심해야 했어요, 이해하시죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Gale
#. NodeID = 26a97c88-9603-ce90-bfd6-7f4e71615d29
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - eaea790d-b9b8-b786-370a-5466a9185c91_GaleCommented = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:26a97c88-9603-ce90-bfd6-7f4e71615d29
msgctxt "h0094444cgf71ag4272gb546g32ed136044c2"
msgid ""
"Let's try to be diplomatic, shall we? Goblins don't come by the handfuls, "
"but by the dozens."
msgstr "외교적으로 가볼까? 고블린은 한 줌이 아니라 수십 마리가 몰려오니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = 26de9672-2822-6af1-6b0e-a41be2831a97
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Checkpoint_State_SucceededBarbarianIntimidation = True
#.      - GOB_Checkpoint_State_GainedAccess = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:26de9672-2822-6af1-6b0e-a41be2831a97
msgctxt "h811cb72cg50dcg4566gbbdeg3d1adb72e794"
msgid ""
"I don't want trouble - learned my lesson. Can still taste it on me gums..."
msgstr "문제를 일으키고 싶진 않아, 배움을 얻었거든. 잇몸에서 아직 맛이 느껴지는 것 같아..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Player
#. NodeID = 27114a25-f7f8-f2b2-b6cd-a41cbafcc0f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:27114a25-f7f8-f2b2-b6cd-a41cbafcc0f4
msgctxt "hfd61ef9bg7680g4389g8483gfa1c9c67ef53"
msgid "<i>Smear the dung across your face. It's not your first time.</i>"
msgstr "<i>얼굴에 똥을 바른다. 이번이 처음은 아니다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = 27338940-c8df-bae1-24e9-fd340a7a0a04
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:27338940-c8df-bae1-24e9-fd340a7a0a04
msgctxt "hfa77dc4cg3133g483fgadaag10f6146b93a1"
msgid "HA! Hahaha! I can't believe you did it! You stupid idiot!"
msgstr "하! 하하하! 진짜로 하다니 믿을 수 없군! 멍청한 얼간이 자식!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = 28179faa-972a-54b1-af46-ca0467ec8fbf
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_Checkpoint_State_GainedAccess = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:28179faa-972a-54b1-af46-ca0467ec8fbf
msgctxt "hc7e93e96g4bceg4c09gadd4g575453e9aaab"
msgid "No! No more for me. On you go."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = 28e3bea5-4be4-e8f6-dd95-53031f2f77b2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:28e3bea5-4be4-e8f6-dd95-53031f2f77b2
msgctxt "ha120faf3g469bg4821g83c1gc993e6ded6ef"
msgid ""
"Lads're celebrating the raid on Waukeen's Rest. Captured a duke, we did! All "
"the way from the city."
msgstr "애들이 와우킨의 쉼터 습격의 축하연을 벌이고 있습니다. 공작을 사로잡았거든요! 저 멀리 도시에서 온 놈이죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = 2ab8a970-bba5-fa26-bdae-f495076315a7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Checkpoint_Guard01_HasMet(1) = True
#.   Global:
#.      - GOB_Checkpoint_State_GainedAccess = False
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:2ab8a970-bba5-fa26-bdae-f495076315a7
msgctxt "h88a8a70ag67b3g4bdcg81f1gf5ce887bdcc3"
msgid "I told you to git."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Player
#. NodeID = 2ad39e6f-0699-c7b6-c35b-685ec103b3f2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:2ad39e6f-0699-c7b6-c35b-685ec103b3f2
msgctxt "hf72572ceg5b79g43d6ga3d0g889eb9ee7ddb"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = 2c751485-bc47-794c-db94-f3c3bfe4ed5a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:2c751485-bc47-794c-db94-f3c3bfe4ed5a
msgctxt "hc7f7e06agbfbbg4f00gb310gbc85df95a94e"
msgid "Do it or don't, you bloody <i>ranga</i>!"
msgstr "할 건지 말 건지 골라, 이 개같은 <i>원숭이</i>야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Player
#. NodeID = 2f7198f6-f78b-86df-7607-fe498d3d5c7c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:2f7198f6-f78b-86df-7607-fe498d3d5c7c
msgctxt "h96cddb68g48ecg4119g8759g6f9f036b099a"
msgid "I don't find it particularly funny. So you'll stop."
msgstr "재밌다는 생각이 들지 않는군. 그러니 멈춰."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Narrator
#. NodeID = 2f754dcc-ad27-6e03-966d-8d4532c46895
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount2(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:2f754dcc-ad27-6e03-966d-8d4532c46895
msgctxt "h99f9a6dfg5fe6g4454g95ebg97b2a1ef26e8"
msgid ""
"*Something stirs deep within you, hungry and alert... it's taking something "
"you'll never get back.*"
msgstr "*몸 깊숙한 데서 굶주리고 기민한 존재가 꿈틀댑니다... 잃으면 되찾지 못할 뭔가를 좀먹고 있군요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Player
#. NodeID = 33158c2f-5dd9-3974-2502-c75502a122a7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:33158c2f-5dd9-3974-2502-c75502a122a7
msgctxt "h4159abffgc6c6g4ed2g8b98gfacc8e99babb"
msgid "Stand aside."
msgstr "비켜."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Player
#. NodeID = 3325972d-c030-082c-ee74-79a741058d24
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:3325972d-c030-082c-ee74-79a741058d24
msgctxt "h7552ae8ag651cg42d7g9c8dg8cecff6e0ff0"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = 36593769-f72f-f66c-f374-805316b27bcf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:36593769-f72f-f66c-f374-805316b27bcf
msgctxt "h4724413bg8626g4036gb69cg4843867eef3d"
msgid "Sure. I'll just..."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = 376178c3-12ec-34d1-3bfa-0d60f413cc78
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Checkpoint_Guard01_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_Checkpoint_Guard01_HasMet(1) = True
#.   Global:
#.     - GOB_Checkpoint_State_GainedAccess = True
#.     - GOB_Checkpoint_State_DrowAutoPass = True
#. TagRule: DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:376178c3-12ec-34d1-3bfa-0d60f413cc78
msgctxt "h3b683b5fg09b7g40dcgbb66g3282c02b4d46"
msgid "Shove over, Klaw! Drow comin' through."
msgstr "저리 비켜, 클로! 드로우 납신다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Player
#. NodeID = 38a296f5-f733-e9e6-ab78-19c6d91be929
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BERSERKER(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:38a296f5-f733-e9e6-ab78-19c6d91be929
msgctxt "he5435ffdg03efg4f68g8452gc470d24a5c8d"
msgid "<b>I said. EAT IT.</b>"
msgstr "<b>말했잖아. 먹으라고.</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = 39558c2c-c06a-915f-747a-749f7a3b345c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_Checkpoint_Event_MakeBlind(0) = True
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:39558c2c-c06a-915f-747a-749f7a3b345c
msgctxt "h4e686b3cgf2ceg493dga539g5757c8d5e60f"
msgid "MY EYES! YOU SHITEY FECK-SHITE!"
msgstr "<b>내 눈! 이 개똥같은 씨발롬이</b>!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = 39eaf383-0668-bd02-4715-d51148ab2cd2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - GLO_Tadpole_SUB_Druid.LearnedPit(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:39eaf383-0668-bd02-4715-d51148ab2cd2
msgctxt "h8903f72age28bg49c7ga43eg4470b08b79fd"
msgid ""
"Oh, one of them thieves? If he ain't dead, he's in the pits with the rest of "
"'em."
msgstr "오, 그 도둑놈 말씀이십니까? 죽지 않았다면, 다른 녀석들과 함께 구덩이에 있을 겁니다."

