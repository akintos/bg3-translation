msgctxt "h04b4d4ecg8cb3g4b6ag8c24g1bc444e28d5c"
msgid "Burned from the inside out. Must've been our warlock friend."
msgstr "안쪽에서부터 불타올랐어. 워락 친구의 작품이 분명해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/VBs/GOB_WolfPens_PAD_Massacre
#. Speaker = Player
#. NodeID = 1af9e03c-fa67-92fe-397b-e423d1006a73
