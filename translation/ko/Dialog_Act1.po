msgctxt "ha52b7ef9ge360g4a35g8e77g121e819c1d8f"
msgid "And if I meet them? What should I tell them?"
msgstr "부모님을 만나게 된다면 뭐라고 전해 줄까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_General_Dead_SnakeKid
