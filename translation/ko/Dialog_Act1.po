msgstr "*주문의 힘이 약해집니다. 더 이상 질문을 할 수 없습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy_Dead
#. Speaker = Youth Varrl
#. NodeID = e7b01368-6a6d-9b33-006f-ce4d0d069ab0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy_Dead:e7b01368-6a6d-9b33-006f-ce4d0d069ab0
msgctxt "h6d0f3882g340dg4ce8g9d3cgc74e2ed25a35"
msgid "Weak-minded... sycophantic... cruel..."
msgstr "나약하고...아첨꾼에...잔혹해..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy_Dead
#. Speaker = Youth Varrl
#. NodeID = ebf9b38d-f076-4a18-afc4-3bed84a8e282
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_YouthTraining_Knows_BoyWasReadingOrpheus = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy_Dead:ebf9b38d-f076-4a18-afc4-3bed84a8e282
msgctxt "h4c716c6bg3c02g4878gb42ag7fe88cc40464"
msgid "Tired of killing... Orpheus... better way..."
msgstr "죽이기에 지쳤다...오르페우스...더 나은 방법..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy_Dead
