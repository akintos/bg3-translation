msgctxt "h09a75865g0abdg47e7gaf3cg6d016f44d06d"
msgid "Drow... master's mistress. No bite."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeWorg2
#. Speaker = Worg
#. NodeID = dd04ca70-29d1-2a9c-a005-4be26462144f
#. HandlePath = TaggedText[1].TagText[0]
