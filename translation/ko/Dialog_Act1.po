msgctxt "h2506f878g9027g460egad33g872bc994a4c4"
msgid "Gather the raiders. It is time."
msgstr "습격대를 모아라. 때가 되었다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_DrowLeaving2
#. Speaker = Nightwarden Minthara
#. NodeID = 665927cb-d021-269b-d2d3-db935286ebab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_DrowLeaving2:665927cb-d021-269b-d2d3-db935286ebab
msgctxt "h04248aadgae70g4adegabeegffbb040b0226"
msgid "Come. We have found our prey."
msgstr "와라. 우리 사냥감을 찾았다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_DrowLeaving3
