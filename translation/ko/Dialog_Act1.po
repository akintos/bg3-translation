msgctxt "he373c173g4550g45f7g9a4bgb23b537945dd"
msgid "You pokin' around in my mush?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = b8fd0543-b82a-3db3-0216-6ce7096a6730
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Karlach_Event_SetUpGoblinPriestBranch = True
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:b8fd0543-b82a-3db3-0216-6ce7096a6730
msgctxt "h1a3dcf36g9aa4g4af1gb1ffgb2dd9d9aba19"
msgid ""
"This could have gone easy for you. Not now, though. I'll tear you to shreds!"
msgstr "이 일은 원만하게 풀릴 수도 있었어. 하지만 이렇게 된 이상은 아니야. 널 갈가리 찢어주마!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = b95440fb-1a1d-b746-47ab-e552146ac211
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
