#, fuzzy
msgctxt "heea1f158ga921g4a66g87a8gb9c5cf290639"
msgid ""
"That lot on the bridge are out for blood. Hope your disguise holds, if you "
"try to get past."
msgstr "저기 다리에 있는 놈들은 피에 목마른 것 같아. 지나가려거든 너의 변장이 통하길 바랄게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Ellyka
#. NodeID = 0fb108e5-ba69-1f7b-4f05-97613b3140be
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:0fb108e5-ba69-1f7b-4f05-97613b3140be
msgctxt "h588cb47eg9b17g4e80gab55ga51e22069576"
msgid ""
"Nobody. Just another <i>hrasting </i>fool trying to stay alive. There's "
"plenty of us around."
msgstr "아무도 아니야. 그저 살아 남으려는 <i>흐라스트</i>할 멍청이일 뿐이지. 나 같은 사람 많잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Player
#. NodeID = 182d1565-0e6e-336e-2a7d-e8bb33b82618
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_GithChokepoint_TieflingScout_Knows_Who(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:182d1565-0e6e-336e-2a7d-e8bb33b82618
msgctxt "he70dc2e0g172cg4eabgad9fg49cf5671cef9"
msgid "Who are you?"
msgstr "너는 누구지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Ellyka
#. NodeID = 1c5d5235-d5fb-ba4e-1d44-56b15fdaff06
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_GithChokepoint_State_MeetsLevel = False
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:1c5d5235-d5fb-ba4e-1d44-56b15fdaff06
msgctxt "h0ce9542agcd63g4857gaaefg5c88c1b8600e"
msgid ""
"Your friends at the bridge are too much for me to take on... but I reckon I "
"can handle you."
msgstr "저기 다리에 있는 네 친구들은 내가 감당하기 힘들겠지만... 너 정도는 상대할 수 있을 것 같네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Player
#. NodeID = 223d8ea7-52ee-642c-d162-b01024b82557
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:223d8ea7-52ee-642c-d162-b01024b82557
msgctxt "hdc51044ag8d7dg44d9g94f7gb7ab7db3f629"
msgid "I have no interest in harming you, unless you force my hand."
msgstr "네가 자초하지만 않는다면, 널 해칠 생각은 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Ellyka
#. NodeID = 252fc561-7674-6a3b-b26c-8b0d08135056
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_GithChokepoint_State_MeetsLevel = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:252fc561-7674-6a3b-b26c-8b0d08135056
msgctxt "hdd39e697g1f5cg42b1gba67g5a2b4ec46018"
msgid ""
"Listen - avoid the bridge. I doubt a fight with that lot would go your way, "
"no offence."
msgstr "들어봐, 다리를 피해가. 너희를 무시하는 건 아니지만, 저놈들이랑 싸워서 결과가 좋게 흘러갈 것 같진 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Player
#. NodeID = 26d16cbd-4d64-5ff4-292b-59461a38e8ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:26d16cbd-4d64-5ff4-292b-59461a38e8ec
msgctxt "h408e47adga764g403agafa6g200d3623fc9e"
msgid "I might've been concerned, had I the slightest idea who 'they' are..."
msgstr "뭐 때문인지는 몰라도 설명을 해줘야 들키든가 말든가 하지..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Ellyka
#. NodeID = 2b9a93c0-d638-4bd6-b79b-6cfbc2037208
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:2b9a93c0-d638-4bd6-b79b-6cfbc2037208
msgctxt "hb86328f4g5bddg4753g9aa4g5e7620f66d43"
msgid "I go my own way. <i>Alone</i>."
msgstr "난 내 길을 가. <i>혼자서</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Player
#. NodeID = 2c4e7930-2db0-28b4-8c61-49eab259fdbb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:2c4e7930-2db0-28b4-8c61-49eab259fdbb
msgctxt "hff1c63d2ge589g48c7g984bg686da5dd83c2"
msgid "First and last warning - lower that weapon."
msgstr "처음이자 마지막 경고야. 무기를 내려."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Player
#. NodeID = 2d0bb3a1-7a2c-1eb6-a889-01952a0f660e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:2d0bb3a1-7a2c-1eb6-a889-01952a0f660e
msgctxt "hc648dd19gab9eg4cd8gb40cg812a4f0ca9bf"
msgid "It's a disguise. I'm not really a gith."
msgstr "변장한 거야. 난 진짜 기스가 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Ellyka
#. NodeID = 31c78115-a15e-1bc0-398e-3ac8ca1ec54f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:31c78115-a15e-1bc0-398e-3ac8ca1ec54f
msgctxt "h849a2070gf4fag44beg95dfg6335e18ce0d9"
msgid ""
"... all right. I'm leaving. I have to get to Baldur's Gate. Don't follow. "
"And not a word to <i>them</i>."
msgstr "...좋아. 난 떠날 거야. 난 발더스 게이트로 가야 하거든. 따라오진 마. 그리고 <i>저놈들</i>한텐 말도 붙이지 말고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Ellyka
#. NodeID = 33aef2a9-6cdf-60c4-4679-95508900102c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:33aef2a9-6cdf-60c4-4679-95508900102c
msgctxt "h88bf331fge46eg4262gafcbge8968720191b"
msgid "I won't let you warn them."
msgstr "네가 그들에게 경고하게 두진 않겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Player
#. NodeID = 341b6822-9cfe-8fbe-5dfc-d487ec0a7f19
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:341b6822-9cfe-8fbe-5dfc-d487ec0a7f19
msgctxt "h2b1cad29g521bg4faag87c8gae0d44e3dee6"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Player
#. NodeID = 347d4ed7-61f0-412b-062e-e9e03fb46061
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:347d4ed7-61f0-412b-062e-e9e03fb46061
msgctxt "hffaa64bcgb11bg4c5egaf17g7a05eea1118b"
msgid ""
"Lower your weapon. I shall let no <i>istik </i>stand between me and my "
"rightful cleansing."
msgstr "무기를 내려라. <i>이스틱</i>이 내 정당한 정화를 막는 건 용납하지 않겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Player
#. NodeID = 38e77df2-78dc-356d-b55b-1edd1947b4c0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:38e77df2-78dc-356d-b55b-1edd1947b4c0
msgctxt "h481ecdfbgc811g4b48g8670g2f16dba1056c"
msgid "I am Lae'zel of K'liir. You <i>will</i> let me pass."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Ellyka
#. NodeID = 3fb0432f-1bc4-2824-4531-0233ab200f51
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:3fb0432f-1bc4-2824-4531-0233ab200f51
msgctxt "h5a54e1fag9349g4da9g8828ge598b6640cbd"
msgid "Come on then, <i>mragreshem! </i>"
msgstr "어서 덤벼, <i>므라그레셤!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Ellyka
#. NodeID = 45fd5fab-be4c-5f24-41b2-954be72b8d26
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:45fd5fab-be4c-5f24-41b2-954be72b8d26
msgctxt "h49862040g5213g49degb6b8gcaedea88c0f3"
msgid "They're out for blood. I hope you're in good standing with them."
msgstr "저들은 피를 노리고 있어. 당신이 그들과 사이가 좋길 바랄게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Ellyka
#. NodeID = 46b8cb6c-34a8-7041-a73b-25d75ab09b7b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:46b8cb6c-34a8-7041-a73b-25d75ab09b7b
msgctxt "h92021c59g7531g4705ga20dg9734c6e40616"
msgid "Don't follow me - find your own way."
msgstr "날 따라오진 마, 네 길은 알아서 찾아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Ellyka
#. NodeID = 46f17446-90ee-8a16-4f1e-462abafd12cd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:46f17446-90ee-8a16-4f1e-462abafd12cd
msgctxt "h1378cbfeg5b32g4c8bga480g637aeac494b3"
msgid ""
"So... you not looking to make trouble for me, are you? Whatever you are?"
msgstr "그래서... 날 곤란하게 하려는 건 아니지? 네가 뭐든 간에 말이지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Player
#. NodeID = 49998de7-5f73-ece9-a86f-23797b214422
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:49998de7-5f73-ece9-a86f-23797b214422
msgctxt "hfd2bdd3dgb140g498egbfa4g5961c41f92c3"
msgid ""
"Seems you have good survival instincts - maybe you should join me instead."
msgstr "좋은 생존 본능을 가지고 있는 것 같네. 날 따라오는 게 좋을 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Ellyka
#. NodeID = 4c9caff9-70b8-83ae-cfa0-0a3567a05023
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_GithChokepoint_State_MeetsLevel = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:4c9caff9-70b8-83ae-cfa0-0a3567a05023
msgctxt "hf6e6e53egee64g4e43gb72cgbc61540585f1"
msgid ""
"They're out for blood. Unless you're in good standing with them, I'd keep "
"clear."
msgstr "저들은 피를 노리고 있어. 저들과 사이가 좋은 게 아니라면, 피해가는 게 좋을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Player
#. NodeID = 4f2a6d27-d3b4-4f0f-f1b9-d3d3aae9fb42
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:4f2a6d27-d3b4-4f0f-f1b9-d3d3aae9fb42
msgctxt "hc5ba20d5g624ag4dcagb088g9960f2ab88b8"
msgid "'Another one'? Explain yourself."
msgstr "'다른 놈'? 설명이 필요할 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Player
#. NodeID = 500b1d81-b22a-aede-0958-82cfa87864eb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:500b1d81-b22a-aede-0958-82cfa87864eb
msgctxt "h9fe69732gb8e8g4fa6gb413g8e39b8312f09"
msgid "I am Lae'zel of K'liir. You <i>will</i> let me pass. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Player
#. NodeID = 520c83e2-da07-6090-f0f7-d3806be8e2cb
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_PLANAR and !REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:520c83e2-da07-6090-f0f7-d3806be8e2cb
msgctxt "h28f27cbbg99b0g47c8gb4efgca50fc23a904"
msgid "I am not with them. But perhaps they will listen to me."
msgstr "난 그들과 한 편이 아니다. 하지만 내 말을 들을지도 모르지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Player
#. NodeID = 520c83e2-da07-6090-f0f7-d3806be8e2cb
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:520c83e2-da07-6090-f0f7-d3806be8e2cb
msgctxt "h5835100ag986fg4329ga137gabbc0f81343c"
msgid "They may be my kin. I will investigate."
msgstr "내 동족일지도 모르겠군. 조사해 보겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Ellyka
#. NodeID = 564538dd-b2e0-01e0-0bdc-683b3e34f2ba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:564538dd-b2e0-01e0-0bdc-683b3e34f2ba
msgctxt "h61727c3ag3c1eg497bg9efag9e66e3e44592"
msgid "I'll drop it when you're dead."
msgstr "네가 죽고 나면 내려놓지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Ellyka
#. NodeID = 599e8bef-b07f-71ee-eaf7-e170dbe15a98
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:599e8bef-b07f-71ee-eaf7-e170dbe15a98
msgctxt "h48da01b9gd3b4g4571g8570g8a8267718ffb"
msgid "Spare me. There's bigger problems right now that my manners. Look..."
msgstr "나 좀 내버려 둬. 지금 내 매너보다 훨씬 중요한 문제가 있어. 봐..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Ellyka
#. NodeID = 5b717556-009a-0d46-504c-ac28b25d3f8f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:5b717556-009a-0d46-504c-ac28b25d3f8f
msgctxt "hd713aedfg6f8cg4cdag85e0g78cab60ba13d"
msgid ""
"Your <i>hrasting </i>friends are swarming all over the bridge down there."
msgstr "네 <i>흐라스트</i>할 친구 놈들이 저 아래의 다리에 떼로 몰려왔어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Player
#. NodeID = 5d97660c-4c2f-031c-737c-4c69ad09d654
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_GithChokepoint_TieflingScout_Knows_Who(1) = False
#. SetFlags:
#.   Dialog:
#.     - PLA_GithChokepoint_TieflingScout_Knows_Who(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:5d97660c-4c2f-031c-737c-4c69ad09d654
msgctxt "h5bfbb668g841ag438dg8f55g2ba500721022"
msgid "And who are you exactly?"
msgstr "그래서 넌 누구야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Player
#. NodeID = 61853295-443a-7142-295e-87c31b53295b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:61853295-443a-7142-295e-87c31b53295b
msgctxt "ha389c265g9997g4377ga1c9g2d4fa6910690"
msgid "I didn't say that..."
msgstr "그런 말은 안 했는데..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Ellyka
#. NodeID = 72c8de0d-25a6-76ae-9d32-587aa935e6c5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:72c8de0d-25a6-76ae-9d32-587aa935e6c5
msgctxt "hd06fcc5agf408g4d89g8f40g12a1f2f324a3"
msgid "What? <i>Why...? </i>"
msgstr "뭐? <i>왜...? </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Ellyka
#. NodeID = 74039216-bf3b-b0f3-1b26-5a020bea304d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:74039216-bf3b-b0f3-1b26-5a020bea304d
msgctxt "hbb1217d6g5a97g4f4ag9518gb325a55ecaf5"
msgid ""
"That bridge was going to be my passage to Baldur's Gate. To <i>safety</i>. "
"Now I've to find another way."
msgstr "저 다리가 내가 발더스 게이트로 가기 위한 길목이었는데. <i>안전</i>하게 말이야. 이제 다른 길을 찾아야겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Ellyka
#. NodeID = 74ba8c5a-a92f-0c73-6cc0-b40e713e6528
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:74ba8c5a-a92f-0c73-6cc0-b40e713e6528
msgctxt "ha0a454d0g92c3g4f0fgacfcgff3664faf393"
msgid ""
"Those things you're masquerading as. Armed to the teeth. And they've a "
"<i>dragon</i>."
msgstr "네가 변장하고 있는 그놈들 말이야. 이빨까지 무장하고 있지. 그리고 <i>드래곤도</i> 있고 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Ellyka
#. NodeID = 756d6959-b45d-889b-3efe-42b3f46dcecb
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:756d6959-b45d-889b-3efe-42b3f46dcecb
msgctxt "h229c391dg5e3ag45f7g9c64gd79cfa1a5ebb"
msgid ""
"Let's see if you're actually as tough as your disguise makes you... come on!"
msgstr "네가 실제로도 변장하고 있는 만큼 튼튼한지 보자고... 덤벼!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Ellyka
#. NodeID = 777c7f1b-875d-c493-d7df-c16d21ab481a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:777c7f1b-875d-c493-d7df-c16d21ab481a
msgctxt "h30e5a8f5g36a1g4e9cgb427g99a5579bf18d"
msgid "... unless you're looking for a fight, that is."
msgstr "...네가 싸움을 일부러 찾아다니는 게 아니라면 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Ellyka
#. NodeID = 7ce61feb-1192-da4e-ff5a-780afb7ad352
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:7ce61feb-1192-da4e-ff5a-780afb7ad352
msgctxt "h7085b208g9ffcg4e75g8de9g081cd5024709"
msgid ""
"Got more important things to watch than my <i>hrasting </i>tongue. Look..."
msgstr "그놈의 <i>흐라스트</i>할 혓바닥보다 조심해야 할 진짜로 중요한 일이야. 봐..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Ellyka
#. NodeID = 7ebd4774-eaad-ebf4-0f48-ed99a9a47eed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:7ebd4774-eaad-ebf4-0f48-ed99a9a47eed
msgctxt "hf5bbe5f5gc853g49c7g9e90g42849ac3acda"
msgid "I'm leaving. Don't follow. Don't tell <i>them</i> you saw me."
msgstr "난 떠날 거야. 따라오지 마. <i>저들에게</i> 날 봤다고도 하지 말고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Ellyka
#. NodeID = 7f0a8110-35f9-ebee-282d-f930f6ac90a4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:7f0a8110-35f9-ebee-282d-f930f6ac90a4
msgctxt "h509c9ae9gda23g45ebga745g7f2a0f9f884a"
msgid "What are you doing?! Hold up, before they see you, <i>mragreshem!</i>"
msgstr "뭐 하는 거야?! 멈춰, 그러다 들키겠어, <i>므라그레셤!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Ellyka
#. NodeID = 7f6bb6fb-8b80-32c1-e7ed-a27d70856bd3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:7f6bb6fb-8b80-32c1-e7ed-a27d70856bd3
msgctxt "h953386ebgb09fg4b5fg99c7gcdaf851897c0"
msgid "What? <i>Why...? </i>Never mind. I don't want to know."
msgstr "뭐? <i>왜...? </i>신경 쓰지 마. 알고 싶지 않으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Ellyka
#. NodeID = 8376c640-ec2f-c8aa-6ae7-1d6f2e7c2b4d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:8376c640-ec2f-c8aa-6ae7-1d6f2e7c2b4d
msgctxt "hb7a112acg4c8ag4fddg9b3fg06b2de937202"
msgid "I'm going to find another way around. You ought to do the same."
msgstr "난 다른 길을 찾아야겠어. 당신들도 그렇게 해야 할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Ellyka
#. NodeID = 83b25a35-4337-fd12-20af-5ae86838f965
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:83b25a35-4337-fd12-20af-5ae86838f965
msgctxt "h78cb432bg08eag4a5bg8808g60a302a1043e"
msgid "What? Just follow you around?"
msgstr "뭐? 널 그냥 따라다니라고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Ellyka
#. NodeID = 83c1092a-e903-4644-70cf-7e96ba27899a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:83c1092a-e903-4644-70cf-7e96ba27899a
msgctxt "hf54e6ba7g567bg41abga4a7g0270cd6805fa"
msgid ""
"<i>Hrast, </i>another one! Keep back, flatface - I know how to handle myself!"
msgstr "<i>흐라스트</i>, 다른 놈이잖아! 물러서, 납작얼굴. 난 자기방어 정도는 할 줄 아니까!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Ellyka
#. NodeID = 8942225b-9d7e-f756-107a-13e2eb1cb48a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:8942225b-9d7e-f756-107a-13e2eb1cb48a
msgctxt "hdf2fc224ge0c8g4c00g9ab2g69faeb6f5e40"
msgid ""
"... aren't you with that other lot? Down at the bridge? The ones with the "
"<i>dragon?</i>"
msgstr "...다른 놈들이랑 한패 아니야? 다리 밑에? <i>드래곤</i>을 데리고 있는?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Ellyka
#. NodeID = 89d8b365-a40b-11fc-d0bf-b6fb9e1c1998
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_GithChokepoint_State_MeetsLevel = False
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:89d8b365-a40b-11fc-d0bf-b6fb9e1c1998
msgctxt "h65013d01g4dd3g4682g869ag0c1cffc016a3"
msgid ""
"That lot are too much for me to take on... but I reckon I can handle you, "
"<i>mragreshem</i>."
msgstr "저놈들을 다 상대하긴 무리겠지만... 너 정도는 상대할 수 있겠지, <i>므라그레셤</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Ellyka
#. NodeID = 8c19263b-91e8-cc3e-9861-7cdc2e4eea41
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:8c19263b-91e8-cc3e-9861-7cdc2e4eea41
msgctxt "h6abf69f8gf4b0g4509g9438g1f92182900b6"
msgid ""
"Now I've got to find another way around. Take your chances against that lot "
"if you like."
msgstr "난 이만 다른 길을 찾아봐야 해서 말이야. 저들에게 네 목숨을 걸고 싶다면 마음대로 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Ellyka
#. NodeID = 91c17d6c-9dff-dd4a-4aba-f150ba4c5369
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:91c17d6c-9dff-dd4a-4aba-f150ba4c5369
msgctxt "he39c67f7g8f98g4833gaf94g01b79dcc179d"
msgid "... good. I've enough trouble as it is - look at that lot down there."
msgstr "... 좋아. 이미 충분히 곤란하거든 - 저 아래 놈들 좀 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Ellyka
#. NodeID = 93bc18e3-6aa1-01ea-7706-776ab615e130
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:93bc18e3-6aa1-01ea-7706-776ab615e130
msgctxt "h04526f6egdd9eg463dg8216g825a9176b468"
msgid ""
"I'm getting out of here. There's got to be another way to Baldur's Gate. "
"Good luck."
msgstr "난 여기서 떠날 거야. 분명 발더스 게이트로 가는 다른 길이 있겠지. 행운을 빌게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Ellyka
#. NodeID = 9671e53d-2858-8056-4d70-ec0f38f0c0f2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:9671e53d-2858-8056-4d70-ec0f38f0c0f2
msgctxt "hc672f142g98bbg4905gbeabg4a61c3a7a981"
msgid ""
"That lot are swarming all over the bridge. I don't know what they want, but "
"it can't be good."
msgstr "저놈들이 다리 전체를 뒤덮고 있어. 뭘 원하는 건진 모르겠지만, 좋은 건 아닐 것 같네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Player
#. NodeID = 972b4a9c-1211-7082-5296-4fe9a4d550f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:972b4a9c-1211-7082-5296-4fe9a4d550f3
msgctxt "h33140a31g250eg4afagbf04g794b55750c05"
msgid "No, you are safe."
msgstr "아니, 넌 안전해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Player
#. NodeID = 9bccdbbb-16ce-ecf9-5560-750e6d1bbbb4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:9bccdbbb-16ce-ecf9-5560-750e6d1bbbb4
msgctxt "h7ba7af56gef07g4d15ga589gd4139398fda0"
msgid "If there are gith at the bridge, they're nothing to me."
msgstr "다리에 기스가 있다면, 그들은 내게 아무것도 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Ellyka
#. NodeID = 9c76ea4f-2cc4-8c09-be84-7841f0135664
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:9c76ea4f-2cc4-8c09-be84-7841f0135664
msgctxt "h362d8e93gab8eg4cd1gb12ag81a2d1bc7a45"
msgid ""
"Actually forget it. I need to get moving; there has to be another way to "
"Baldur's Gate."
msgstr "사실, 됐어. 난 계속 이동해야겠어; 분명 발더스 게이트로 향하는 다른 길이 있을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Player
#. NodeID = 9e1b06b0-f74c-998d-a18c-2e633bb2a4d7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_TIEFLING(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:9e1b06b0-f74c-998d-a18c-2e633bb2a4d7
msgctxt "h4575bf8ag83efg4486gb91ag1c25d4e74237"
msgid "You're the <i>mragreshem </i>for taking that tone with me."
msgstr "그렇게 말하는 네가 <i>므라그레셤</i> 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Ellyka
#. NodeID = 9f23136b-7a5f-c085-948a-8fdd09e892c7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:9f23136b-7a5f-c085-948a-8fdd09e892c7
msgctxt "h796431a0gb27ag458dgbc19ge2e7f34a13e7"
msgid "That's how you want it... fine."
msgstr "그렇게 하고 싶다면... 좋아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Player
#. NodeID = a47df7b4-1d62-9273-b0ea-b4bf9f8ec30e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_TIEFLING(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:a47df7b4-1d62-9273-b0ea-b4bf9f8ec30e
msgctxt "h5e1790aag9ef3g4f2ega4f4g59907ee5f08c"
msgid ""
"Whatever you just called me, I didn't like the sound of it. Watch your "
"tongue."
msgstr "네가 방금 날 뭐라고 불렀는진 모르겠지만, 소리가 마음에 들지 않는군. 말조심하도록."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Player
#. NodeID = ae3a8ccf-610b-ee13-610c-a4e65b563d69
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: (GITHYANKI and REALLY_PLANAR) and !REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:ae3a8ccf-610b-ee13-610c-a4e65b563d69
msgctxt "h371d5f7ag22cbg4e39g8322g39c3dfbb45f0"
msgid "Calm yourself. I am not who you think I am."
msgstr "진정해. 난 네가 생각하는 그런 게 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Ellyka
#. NodeID = b1480ca3-9f37-2034-17a9-4e4a5dc57274
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_GithChokepoint_State_MeetsLevel = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:b1480ca3-9f37-2034-17a9-4e4a5dc57274
msgctxt "h66979fb8gf202g4d71g943cga5db9fe79b94"
msgid ""
"Now I've got to find another way around. If you're smart, you will too. "
"You're no match for that lot."
msgstr "이제 다른 길을 찾아봐야겠네. 똑똑하다면, 당신도 그렇게 하는 게 좋을 거야. 저놈들한텐 상대도 되지 않을 테니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Ellyka
#. NodeID = b5518baa-d3b2-fefd-a95c-26a562a8444f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:b5518baa-d3b2-fefd-a95c-26a562a8444f
msgctxt "h5444444ag9019g4598g82fbgc510bdb70aec"
msgid "What? You going to try get past that lot? Better you than me."
msgstr "뭐? 저놈들 사이를 뚫고 가겠다고? 나만 아니면 됐지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Player
#. NodeID = b900b90c-b6e0-e129-b532-a0d2f77d12ab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:b900b90c-b6e0-e129-b532-a0d2f77d12ab
msgctxt "h713cc89egbc9cg4a50gb0beg0876cad09241"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Ellyka
#. NodeID = b967f9c8-19eb-a935-4c0d-eda640e1066c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:b967f9c8-19eb-a935-4c0d-eda640e1066c
msgctxt "h5dc2ffc8gae0cg4f00ga2e5g79a243b9af21"
msgid "What, apart from the dragon? Look..."
msgstr "뭐? 드래곤이 문제가 아냐. 저기 봐..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Ellyka
#. NodeID = bde477da-8c02-fb03-dad6-6336f9a1cd5a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:bde477da-8c02-fb03-dad6-6336f9a1cd5a
msgctxt "h71f50b5cg32c1g46c9ga603g5508c9e89115"
msgid ""
"Nobody. Just another <i>hrasting </i>fool trying to get to Baldur's Gate in "
"one piece."
msgstr "아무도 아니야. 그저 발더스 게이트로 가려는 <i>흐라스트</i>할 바보일 뿐이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Ellyka
#. NodeID = c0f4db06-b348-dfaf-eb50-e66ccdb3298e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:c0f4db06-b348-dfaf-eb50-e66ccdb3298e
msgctxt "hff16cba0ge3d0g4751g9b0fgba5238b95007"
msgid "Look, down there..."
msgstr "저기, 밑을 봐..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Ellyka
#. NodeID = cac7d8f9-2c03-b4d3-0ad3-6e612cc2ea3f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_GithChokepoint_State_MeetsLevel = False
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:cac7d8f9-2c03-b4d3-0ad3-6e612cc2ea3f
msgctxt "h3bf8ba74g5788g4411g9d9egea45d20cea22"
msgid ""
"Come on, <i>mragreshem! </i>I'll take my chances against you than your "
"friends on the bridge!"
msgstr "덤벼, <i>mragreshem! </i>다리 아래에 있는 네 친구들 보다는 널 상대하는 게 낫겠지!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Ellyka
#. NodeID = cf198f70-3cc5-ee6f-0e9c-3b05f9eaa54d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:cf198f70-3cc5-ee6f-0e9c-3b05f9eaa54d
msgctxt "h7bf6c791g34bfg43c6gb138g4b8e24903215"
msgid ""
"I was counting on crossing that bridge and heading to Baldur's Gate. To "
"<i>safety</i>."
msgstr "저 다리를 건너서 발더스 게이트로 향하려고 했지. <i>안전한</i> 곳으로."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Ellyka
#. NodeID = d33cec43-8801-fbb8-4e5a-76a3064cc72a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_GithChokepoint_State_MeetsLevel = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:d33cec43-8801-fbb8-4e5a-76a3064cc72a
msgctxt "h46e7285fg0222g4786g90dfg448dd1d66e8d"
msgid ""
"I'd keep clear of that lot on the bridge unless you think your disguise'll "
"fool them."
msgstr "변장으로 그들을 속일 수 있다고 생각하지 않는 한 다리에 있는 저놈들을 피하는 편이 좋을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Ellyka
#. NodeID = d36918a1-71a1-2baf-da3d-ddf68306c0f8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_GithChokepoint_State_MeetsLevel = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:d36918a1-71a1-2baf-da3d-ddf68306c0f8
msgctxt "h6f24ff3cg3133g4ea3ga42bg97f4cc00704d"
msgid "I doubt a fight against them would go your way."
msgstr "저 자들이랑 싸우면 승산이 있을 것 같진 않으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Ellyka
#. NodeID = dd3ed121-f8c7-8c32-2f10-cb72da9a3856
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:dd3ed121-f8c7-8c32-2f10-cb72da9a3856
msgctxt "h0a2a67bbgee38g44eag9c4bge0f5dd4e1898"
msgid "I'm going to have to be sure you stay quiet, <i>mragreshem</i>."
msgstr "당신이 조용히 있어 준다고 확신을 줘야겠는데, <i>mragreshem</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Player
#. NodeID = e37cf97b-9136-5b05-ef0c-81e442eb0072
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:e37cf97b-9136-5b05-ef0c-81e442eb0072
msgctxt "h56ae9490g76a8g46c8ga09dg26920c8e81a3"
msgid "I have kin nearby? I should seek them out."
msgstr "근처에 내 동족이 있다고? 그들을 찾아야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Player
#. NodeID = e90900e4-9006-2432-f999-85a22fc91d0e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:e90900e4-9006-2432-f999-85a22fc91d0e
msgctxt "hcb11791agb078g4fbag872ag6ca9537344ff"
msgid "Take it easy, I'm only disguised as a gith."
msgstr "진정해, 기스로 변장했을 뿐이니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Player
#. NodeID = e97a68b7-406a-e52b-53d7-dcac29d38b60
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:e97a68b7-406a-e52b-53d7-dcac29d38b60
msgctxt "hb3720224g453cg4083gbd20ga41335459152"
msgid "What's the matter?"
msgstr "뭐가 문제야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Player
#. NodeID = effb4455-f9ae-4cb0-40c4-64d17dfc27fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:effb4455-f9ae-4cb0-40c4-64d17dfc27fc
msgctxt "h16301eefg0c3fg42e5g836bgfdebecd3e7c7"
msgid "They are nothing to me."
msgstr "그들은 내게 아무것도 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Ellyka
#. NodeID = f10c0842-4ea0-273b-a348-75b4c365d949
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:f10c0842-4ea0-273b-a348-75b4c365d949
msgctxt "h21d5a5e0g27c9g42beg8c1bg7d0269248516"
msgid ""
"Then we've a problem. I can't have you running off to tell your friends "
"about me."
msgstr "그럼 문제가 있겠네. 네가 달아나서 친구들에게 내 이야기를 하면 안되니까 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Ellyka
#. NodeID = f249cad3-0ff1-66f5-75b2-537756857fd7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:f249cad3-0ff1-66f5-75b2-537756857fd7
msgctxt "h07476550gf574g4fecga4a2g1f1495ee5b42"
msgid "All right. Maybe we don't have a problem then. <i>Maybe</i>."
msgstr "좋아. 그럼 문제가 없을지도 모르지. <i>어쩌면</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Ellyka
#. NodeID = f8af844f-62a5-9b1f-9981-692de60a1c45
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_GithChokepoint_State_MeetsLevel = False
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:f8af844f-62a5-9b1f-9981-692de60a1c45
msgctxt "hc109fdf0g3562g4b5cgb0bdg3b83a9f608a1"
msgid ""
"You're not like that lot at the bridge. I reckon I can handler you... come "
"on!"
msgstr "넌 다리에 있는 놈들이랑 다르네. 너 정도라면 상대할 수 있겠어... 덤벼!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Player
#. NodeID = f8b6e993-93d2-628a-ea4c-220d2aaa1887
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:f8b6e993-93d2-628a-ea4c-220d2aaa1887
msgctxt "h4b29eb06g7c7eg4b42g858egc4eff3fbd059"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout
#. Speaker = Ellyka
#. NodeID = fff24f64-7b46-de39-752c-49208daa6634
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_TieflingScout:fff24f64-7b46-de39-752c-49208daa6634
msgctxt "he4412895g6ce7g438ega3b2ge812e0cc94fe"
msgid "Come on then, <i>mragreshem! </i>"
msgstr "그럼 덤벼라, <i>므라그레셤! </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead
#. Speaker = Yul
#. NodeID = 01dbe59d-31e8-1d29-9a8b-d532cbcdc095
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead:01dbe59d-31e8-1d29-9a8b-d532cbcdc095
msgctxt "h5964a43eg3624g4676g8df5g8aff0f72fd0f"
msgid "Fellow scout... druids' grove..."
msgstr "동료 정찰병... 드루이드의 숲..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead
#. Speaker = Player
#. NodeID = 10cc4a04-7b96-43c9-af6e-c12213a96d4a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Local:
#.     - ffb3cc3a-7e4b-eb7a-40a8-c6fab4614885_SaidCity = True
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead:10cc4a04-7b96-43c9-af6e-c12213a96d4a
msgctxt "h840ce4afgd292g40afgb8c5ge58387516f40"
msgid "What were you doing here?"
msgstr "여기서 뭘 하고 있었지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead
#. Speaker = Player
#. NodeID = 159f7c64-30be-49db-9319-5d5663261460
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead:159f7c64-30be-49db-9319-5d5663261460
msgctxt "h3761fe81g71e7g4c64ga826gc10b1e8c3dcf"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead
#. Speaker = Narrator
#. NodeID = 1aea6d1e-be09-43a7-b51d-d9fa63ec8113
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead:1aea6d1e-be09-43a7-b51d-d9fa63ec8113
msgctxt "h43419235gc009g432ag98dag681770787133"
msgid "*The corpse remains silent. It does not know.*"
msgstr "*시체가 침묵을 유지합니다. 알지 못합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead
#. Speaker = Player
#. NodeID = 216c5ba1-83ef-11a2-e3f6-5edb682cf686
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - ffb3cc3a-7e4b-eb7a-40a8-c6fab4614885_SaidCity = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#.   Quest:
#.      - GLO_Tadpole_SUB_Creche.TieflingToldCreche(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead:216c5ba1-83ef-11a2-e3f6-5edb682cf686
msgctxt "hfd906c7bga5f7g4ab2gbcaeg863adf71f903"
msgid "Were you scouting alone?"
msgstr "혼자 정찰을 하고 있었나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_ZorruFriend_Dead
#. Speaker = Player
#. NodeID = 283d4b39-e92b-4fb0-a0a9-1456845ebbb5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
