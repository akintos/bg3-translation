msgid "Now that they're out of earshot, sure."
msgstr "이제 멀리 간 모양이니, 그렇게 할게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaezelRecruitment_AD_LaezelCombatComment
#. Speaker = Lae'zel
#. NodeID = cfe9121c-b5a4-0cee-912b-a667f3ce3783
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaezelRecruitment_AD_LaezelCombatComment:cfe9121c-b5a4-0cee-912b-a667f3ce3783
msgctxt "h5af1d8bcg695fg4e27g97d7g4da57f3e2f5a"
msgid "Let me down, and I'll show you true might!"
msgstr "날 내려놔, 그럼 내가 진정한 힘이 어떤 것인지 보여주도록 하지!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaezelRecruitment_AD_LaezelCombatComment
#. Speaker = Lae'zel
#. NodeID = fb95cd33-65bf-2367-a8c4-30310d8f94df
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
