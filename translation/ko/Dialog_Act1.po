#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:5297ba24-c418-988a-576a-85c86d7a50e8
msgctxt "h7b42db44gc705g44d4g99c9gdb31ee766bde"
msgid "Thought so."
msgstr "그럴 줄 알았지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Karlach
#. NodeID = 53440d33-8219-e689-ecee-81bf09fac824
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:53440d33-8219-e689-ecee-81bf09fac824
msgctxt "h450e28d9gd4e3g42ceg8a67g8d1d99adbebc"
msgid "I have... but that's a story for another time."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Narrator
#. NodeID = 53d665c8-64dd-aff6-9f9a-0be1db3a1fe0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount5(4) = False
