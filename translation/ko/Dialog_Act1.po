msgctxt "hf491d245g6103g4c32gbe51gf4cf2ad61ecf"
msgid "In a way, I suppose you will, <i>istik.</i>\n"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_TemplarStartsFight
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = e3078433-61f8-c6a6-ab00-3f6f6654a87c
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_TemplarStartsFight:e3078433-61f8-c6a6-ab00-3f6f6654a87c
msgctxt "hcaa9a0c1ge10fg40dcgad95g2c9ecc6aaabe"
msgid "In a way, I suppose you will, <i>vin'iisk.</i>\n"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_TemplarStartsFight
#. Speaker = Player
#. NodeID = e39e2eea-7b73-ce08-009b-2fbdb4eef96c
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_TemplarStartsFight:e39e2eea-7b73-ce08-009b-2fbdb4eef96c
msgctxt "he00717d3g850ag46b2g9633g70be5f5901f8"
msgid "Our queen is lying to us, kin."
msgstr "우리의 여왕은 거짓말을 하고 있다, 동지여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_TemplarStartsFight
#. Speaker = Player
#. NodeID = e39e2eea-7b73-ce08-009b-2fbdb4eef96c
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_TemplarStartsFight:e39e2eea-7b73-ce08-009b-2fbdb4eef96c
msgctxt "h0bafef51gbb18g4a07gbac0g723b90eb4246"
msgid ""
"Your queen is lying to you. You shouldn't listen to a damn thing she says."
msgstr "너네 여왕은 네게 거짓말을 하고 있어. 그년이 떠드는 헛소리는 듣지 마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_TemplarStartsFight
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = f61f9b7e-40b2-b824-884b-3023a0371de7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_State_SecurityOfficeHostile = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_TemplarStartsFight:f61f9b7e-40b2-b824-884b-3023a0371de7
msgctxt "hd733c456g741ag4c62gb5fcg983eb6a1a6c0"
msgid "My queen spoke true. And so, you die."
msgstr "여왕께서는 진실만을 말하신다. 그러니 죽어라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_TemplarStartsFight
#. Speaker = Player
#. NodeID = f8d6c2fb-1831-aa5e-5a67-46acf8c30483
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_AstralPrison_State_KilledDaisyDuringDialog = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_TemplarStartsFight:f8d6c2fb-1831-aa5e-5a67-46acf8c30483
msgctxt "h651ade8ag1b45g4896g8a34g7eabe687470b"
msgid "I don't know what you mean. I killed the person inside. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Player
#. NodeID = 054f9587-08df-4325-971d-7a69354a8db7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_State_RefusedVlaakithsOrdersInDialog = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:054f9587-08df-4325-971d-7a69354a8db7
msgctxt "h21a21b2eg4eefg4aa5gb3b2g0a94d868abad"
msgid "My skills and fate are not subject to your whims."
msgstr "저의 기술과 운명은 당신 변덕의 대상이 아닙니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Vlaakith
#. NodeID = 07a1d21a-7ae1-48ca-a4b9-2864e37fe7b4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRAGONBORN(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:07a1d21a-7ae1-48ca-a4b9-2864e37fe7b4
msgctxt "hdefd37c9gdb8cg4f84g8954gc21600b2be97"
msgid "Descendant of noble dragons - you honour us with your allyship."
msgstr "고귀한 용의 후예여, 그대의 의용은 우리를 명예롭게 하는구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Vlaakith
#. NodeID = 07e8262e-1368-df5b-2f25-199322e31dcd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_State_PlanecasterActive = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:07e8262e-1368-df5b-2f25-199322e31dcd
msgctxt "h172be4c0g457fg456dg9947gc44c13ecf0ed"
msgid ""
"W'wargaz - kill it. Enter the Prism yourself. See that protocol is done."
msgstr "와르가즈, 녀석을 죽여라. 네가 직접 프리즘에 들어가거라. 규칙을 이행하도록."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Player
#. NodeID = 0aea8c4b-0f2a-4918-9346-05662bb3ef99
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:0aea8c4b-0f2a-4918-9346-05662bb3ef99
msgctxt "h94d805cfgf2c7g4d40g9d8fgdaa6031e85f1"
msgid "I didn't steal it, it just... found me."
msgstr "훔친 게 아닙니다. 그냥... 이 물건이 절 찾아온 거지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 0ba9fccb-f1bd-4d03-817e-ba4de98dc530
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:0ba9fccb-f1bd-4d03-817e-ba4de98dc530
msgctxt "h24bb55d5g0f4fg4cd6g810bg6cceffa413be"
msgid "<i>Vlaakith gha'g shkath zai!</i>"
msgstr "<i>블라키스 가그 슈카스 자이!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Player
#. NodeID = 0c89b371-6089-2883-f6e0-a133c1302907
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_State_RefusedVlaakithsOrdersInDialog = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:0c89b371-6089-2883-f6e0-a133c1302907
msgctxt "he4b81de5g3539g4c8eg9678ge5219095be3c"
msgid "If you're a god, do it yourself."
msgstr "당신이 신이라면 당신이 알아서 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Vlaakith
#. NodeID = 0c987d86-b019-fe35-1bf5-b73ea851fd9c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:0c987d86-b019-fe35-1bf5-b73ea851fd9c
msgctxt "h10b1b5c0gcbabg4544g8136gffa2de6cb579"
msgid ""
"But know this: my wrath is carried with each of my faithful. It <i>will </"
"i>find you."
msgstr "그러나 이것만은 명심해라. 짐의 분노는 짐의 모든 신도와 함께하니, 도망칠 수는 없을 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Vlaakith
#. NodeID = 10f3db27-0920-f197-62b4-73b3af52fc16
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = False
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:10f3db27-0920-f197-62b4-73b3af52fc16
msgctxt "hb1a7027cg27eag42cdg9b83g49ec7638271c"
msgid "Is that so?"
msgstr "그러한가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Narrator
#. NodeID = 14097d3f-4f13-d183-3e69-91f0f2dcfb40
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#. SetFlags:
#.   Object:
#.     - ORI_DarkUrge_Event_HadUrge(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:14097d3f-4f13-d183-3e69-91f0f2dcfb40
msgctxt "h6529554dg0b2dg42b7gbd8egbc597a2d3881"
msgid ""
"*Hot envy swirls within. Your guts will you to author such cosmic tragedies "
"as she has.*"
msgstr "*뜨거운 질투가 내면에서 소용돌이칩니다. 당신은 그녀처럼 우주적 비극의 작가가 되고 싶다는 야망이 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Vlaakith
#. NodeID = 18bf2e79-a2fc-4446-86f1-d4a4502d08c8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ELF(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:18bf2e79-a2fc-4446-86f1-d4a4502d08c8
msgctxt "hc9a778e2g8cc7g4fa5g9e56gc0b7daed4e8c"
msgid ""
"Your kind's heritage is long and storied. It is an honour to be served by "
"one so noble."
msgstr "그대 종족의 유산은 유서 깊지. 이렇게 고귀한 이를 모시게 되어 영광이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Vlaakith
#. NodeID = 19c2e853-be65-4a9b-4ed3-24dd8bcb87b0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:19c2e853-be65-4a9b-4ed3-24dd8bcb87b0
msgctxt "h88ab8690ga422g4e17g8964g5809fedd5399"
msgid "Who... am... <i>I?</i>"
msgstr "<i>짐이</i>... 누구... 냐고!?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Vlaakith
#. NodeID = 1f1d4dd9-9b62-4701-96ed-fb7e6e7bda2b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_State_PlanecasterActive = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:1f1d4dd9-9b62-4701-96ed-fb7e6e7bda2b
msgctxt "h5db216ccgbf44g4bbbgae84ga064f6ffe37d"
msgid "Use the planecaster's power to enter the Prism."
msgstr "차원전송기의 힘을 이용해 프리즘 안으로 들어가라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Wyll
#. NodeID = 239100e8-85a1-4420-834f-0aa9d5446a34
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(11) = True
#.   Tag:
#.      - REALLY_WYLL(11) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:239100e8-85a1-4420-834f-0aa9d5446a34
msgctxt "he5ba35a3g2e48g47d9g847ag01cd13e278ba"
msgid "By the Nine Hells - she's not going to like <i>that</i>."
msgstr "아홉 지옥에 맹세코 <i>그딴 식으로</i> 말하면 좋아하지 않을 거 같은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Vlaakith
#. NodeID = 250bb9de-c020-53a1-32ea-5c0161042315
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:250bb9de-c020-53a1-32ea-5c0161042315
msgctxt "h941ff8a1gd106g4772ga2fag0626d473693b"
msgid "<i>I WILL BE <b>OBEYED!</b></i>"
msgstr "<i>너는 <b>복종할 </b>것이다!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Gale
#. NodeID = 267ae3b9-df8d-4ddb-a527-96ae78fddfa9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(12) = True
#.   Tag:
#.      - REALLY_GALE(12) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:267ae3b9-df8d-4ddb-a527-96ae78fddfa9
msgctxt "h878111d5g72d2g444agb4aage2fdfb31ca26"
msgid "I don't think she's the type who hears 'no' very often..."
msgstr "저분은 평소에 '안돼'라는 말을 별로 못 들어 봤을 거 같은데..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Player
#. NodeID = 27c9499d-3963-2a1c-39f6-9a2ce5995799
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 0
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:27c9499d-3963-2a1c-39f6-9a2ce5995799
msgctxt "hbf148e98gab51g4174g98c6gfd20997b62af"
msgid "<i>Try to peer into Vlaakith's mind.</i>"
msgstr "<i>블라키스의 생각을 엿본다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Player
#. NodeID = 27c9499d-3963-2a1c-39f6-9a2ce5995799
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 0
#. TagRule: REALLY_GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:27c9499d-3963-2a1c-39f6-9a2ce5995799
msgctxt "h788288c3g9e3fg4a73g8a92g2df68e322739"
msgid "<i>Try to peer into your queen's mind.</i>"
msgstr "<i>당신의 여왕의 생각을 엿본다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Narrator
#. NodeID = 2d5adc41-910c-c70a-a3f1-2c5aa35bd345
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WARLOCK(1) = True
#.      - REALLY_WYLL(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:2d5adc41-910c-c70a-a3f1-2c5aa35bd345
msgctxt "h6ac44494g59fbg4156g9b62gd4c79af8b970"
msgid ""
"*Not exactly a god - but not far off. Your patron recoils, but not before "
"leaving a word of advice - <i>caution</i>.*"
msgstr ""
"*엄밀히 신은 아니지만, 그에 못지 않은 존재입니다. 후원자가 종적을 감추며, 동시에 조언 한 마디를 남기고 떠납니다. "
"<i>조심하라</i>.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Vlaakith
#. NodeID = 2da637ae-26f9-46db-b46e-c375c1c52d26
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:2da637ae-26f9-46db-b46e-c375c1c52d26
msgctxt "hfefe5108gb0a7g4008g997egb796a3613942"
msgid "An unexpected servant. Your will is strong."
msgstr "예상치 못한 종복이로다. 그대의 의지는 강하구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Vlaakith
#. NodeID = 2ea1d246-9da3-39da-6c21-f0c9986019d5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:2ea1d246-9da3-39da-6c21-f0c9986019d5
msgctxt "h890a1378g09cbg4172g8665g1e6852622df4"
msgid "You. YOU!"
msgstr "너. <b>네 이년</b>!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Player
#. NodeID = 2f3d97a5-0156-5bbd-2da8-59987d44e48c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_9 = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:2f3d97a5-0156-5bbd-2da8-59987d44e48c
msgctxt "h9792b338g43cbg4b5aga7e9g83ce282a1627"
msgid "I didn't steal anything, but Shadowheart here..."
msgstr "저는 아무것도 안 훔쳤죠. 그렇지만 여기 섀도하트가..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Vlaakith
#. NodeID = 31a81914-704b-4942-a104-03852610f61e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:31a81914-704b-4942-a104-03852610f61e
msgctxt "h4f922a60gbca7g4fe2g8a29g21449464881b"
msgid "My child. You walk on the path of ascension."
msgstr "나의 자녀여. 그대는 승천의 길에 접어들었다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Vlaakith
#. NodeID = 35728c47-d731-1cc5-c39a-6d9a01570542
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_State_HuntedByVlaakith = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:35728c47-d731-1cc5-c39a-6d9a01570542
msgctxt "h6d67e9e8g5f3cg4351gb285gd31c16ed16d2"
msgid "As long as they live, the Prism is compromised."
msgstr "그것들이 살아있는 한 프리즘은 위험에 빠져 있는 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Vlaakith
#. NodeID = 3afdd56a-dade-425f-843f-1445dc2c5bd3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = False
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_State_PlanecasterActive = True
#.     - CRE_ChainOfCommand_State_RecievedMissionFromVlaakith = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:3afdd56a-dade-425f-843f-1445dc2c5bd3
msgctxt "h00962e8egdc4cg44f6gbba8g5f8d41a1ce65"
msgid ""
"Find the one inside and kill them. Be aware - they are not alone, and they "
"will appeal to your trust. They are not to be believed."
msgstr ""
"안에 있는 존재를 찾아 파괴하라. 그러나 주의하라, 녀석은 혼자가 아니니. 그대의 신뢰를 얻으려 할 것이나, 믿을 수 있는 족속들이 "
"아니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 3e3be4dd-1595-3e77-5175-97188321e8b2
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:3e3be4dd-1595-3e77-5175-97188321e8b2
msgctxt "hf720d596g2fa6g4c59g83eag0dbbc8fa6c70"
msgid ""
"Congratulations are in order, <i>ra'stil</i>. You have been chosen for our "
"holy crusade."
msgstr "<i>라스틸</i>, 축하한다. 너는 우리의 거룩한 성전에서 싸우도록 선택받은 것이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 3e3be4dd-1595-3e77-5175-97188321e8b2
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:3e3be4dd-1595-3e77-5175-97188321e8b2
msgctxt "h0f9613c8g28f4g49d6g9bb1g05961fa5e610"
msgid ""
"An <i>istik</i>... A crusader for my queen... <i>Unimaginable. </i>You are "
"blessed, <i>istik</i>. Do not fail her!"
msgstr ""
"<i>이스틱</i>이... 여왕님의 성전에 참여하다니... <i>상상도 할 수 없는 일이야.</i> 너는 축복받은 거다, <i>이스틱</"
"i>. 여왕님을 실망시키지 마라!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Vlaakith
#. NodeID = 450110d1-3356-8e72-fa3d-457e70737306
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:450110d1-3356-8e72-fa3d-457e70737306
msgctxt "h08778ed1ge613g47f2gb6b5gc2d5d9b501d7"
msgid "INSOLENT FOOL."
msgstr "<b>무례한 멍청이 같으니.</b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Player
#. NodeID = 474a5d01-7089-0556-c760-3e5a68c33660
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:474a5d01-7089-0556-c760-3e5a68c33660
msgctxt "h828b3c7bgf519g41edgbaf6g0cf933be390e"
msgid "<i>Kneel before Vlaakith, your queen.</i>"
msgstr "<i>당신의 여왕, 블라키스 앞에 무릎을 꿇는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Player
#. NodeID = 4c88988e-4ec1-4a5c-a810-feb5fae13d8c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:4c88988e-4ec1-4a5c-a810-feb5fae13d8c
msgctxt "hc57c633eg1d77g4a1aga250g044881f30784"
msgid "<i>Wave politely.</i>"
msgstr "<i>공손히 손을 흔든다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Vlaakith
#. NodeID = 4f327ba8-f81a-3694-4727-b702c99d4831
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:4f327ba8-f81a-3694-4727-b702c99d4831
msgctxt "hd78efba4gbcf1g4f95ga115g3a99605b4cf2"
msgid "At least you brought it back. It is a start."
msgstr "적어도 그것을 가져오기는 하였구나. 이제부터 시작인 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Vlaakith
#. NodeID = 51966ca6-21d8-43d7-9dba-eec6bd81e8cb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TIEFLING(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:51966ca6-21d8-43d7-9dba-eec6bd81e8cb
msgctxt "h34a5bc5fg52c7g44a0g9309gc89fbd68af4b"
msgid ""
"Your kind is not known for trusting strangers. Quite rightly. Yet here you "
"are."
msgstr "그대 종족은 낯선 이를 믿지 않는 것으로 유명하지. 일리가 있다. 하지만 그대는 여기에 있구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Vlaakith
#. NodeID = 532db924-d617-f8d8-c8c9-3ba674128ef7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:532db924-d617-f8d8-c8c9-3ba674128ef7
msgctxt "h512afa8ag0526g4d98g85d6gb83e6c7d92cd"
msgid ""
"I am Vlaakith. Undying Queen of the noble githyanki. God Regent of the Six "
"Arms of Tu'narath."
msgstr "짐의 이름은 블라키스. 영예로운 기스양키를 다스리는 불사의 여왕이자, 튜나라쓰의 여섯 팔을 섭정하는 여신이니라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Player
#. NodeID = 56b8c984-0362-49cb-54e8-3291be944467
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:56b8c984-0362-49cb-54e8-3291be944467
msgctxt "hc907a3d3g97acg48a7gaf72gac09edd68ea0"
msgid "Friend - I came to bring it back to you."
msgstr "친구입니다. 이것을 돌려드리려고 찾아왔습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Player
#. NodeID = 577c2ab3-5deb-6bc3-fc1c-a334503e340b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_State_RefusedVlaakithsOrdersInDialog = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:577c2ab3-5deb-6bc3-fc1c-a334503e340b
msgctxt "h161b8516g07cag4f76g8491g764751c300de"
msgid "No. In fact, maybe I'll free the one inside."
msgstr "안 할 거야. 어쩌면 내가 그들을 풀어줄지도 모르지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Vlaakith
#. NodeID = 577e9aae-ab29-69c2-5d16-2f5e70e264a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:577e9aae-ab29-69c2-5d16-2f5e70e264a4
msgctxt "h9f195549g808bg43c0gb6b6g98d5cf718bef"
msgid "Autonomy begets consequence."
msgstr "자유에는 대가가 따르지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Karlach
#. NodeID = 5981c932-f42c-4195-8101-1556f039977c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(9) = True
#.   Tag:
#.      - REALLY_KARLACH(9) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:5981c932-f42c-4195-8101-1556f039977c
msgctxt "h0575892dga7ffg4e9aga03fgb2c9615b49ca"
msgid "Hey - wait! That's the only thing keeping us from transforming!"
msgstr "이봐, 잠깐! 그건 우리의 변이를 막는 유일한 물건이야!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Vlaakith
#. NodeID = 5c589da1-9070-afc9-20d7-f047fa3a82d1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:5c589da1-9070-afc9-20d7-f047fa3a82d1
msgctxt "ha5155d7cg6e36g4491g937cg28fb7fd774d5"
msgid "Perhaps I misheard. You would not speak ill of a god. Would you?"
msgstr "내가 잘못 들었나 보군. 감히 신을 욕보이는 말을 한 건 아니겠지. 그렇지 않느냐?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Vlaakith
#. NodeID = 5eaf57e1-d5df-4de6-afd2-7c39bace6777
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:5eaf57e1-d5df-4de6-afd2-7c39bace6777
msgctxt "h1b8f6bdfg6e79g4a9agae6bg0fc7a6ddde48"
msgid "<i>FOOL.</i>"
msgstr "<i>어리석은 녀석.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Vlaakith
#. NodeID = 63a2e2b0-e093-4b96-b2f4-1796d12eea59
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DWARF(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:63a2e2b0-e093-4b96-b2f4-1796d12eea59
msgctxt "h9ce9765fgb957g47acg8386gd04406bd159c"
msgid "Your kind's stoic endurance will be a boon to our cause."
msgstr "그대 종족의 금욕적인 인내심은 우리 대의에 큰 도움이 될 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Vlaakith
#. NodeID = 67629f29-2320-e1a8-194d-f267e514dadb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:67629f29-2320-e1a8-194d-f267e514dadb
msgctxt "h535b25e2gf253g45cag918agd0294aa79781"
msgid "You are permitted to look upon me. You are invited to <i>kneel</i>."
msgstr "그대가 알현하는 걸 허락하노니, 그대는 <i>무릎 꿇을</i>지어다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Vlaakith
#. NodeID = 695447ec-2bca-c5d2-bda7-6df40cb33511
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_Event_VlaakithWish = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:695447ec-2bca-c5d2-bda7-6df40cb33511
msgctxt "hde317a71gadc9g43d5ga56bg41abf93ed3e2"
msgid "I <b><i>Wish</i></b> you to end."
msgstr "짐은 네 녀석들의 종말을 <b><i>소망한다</i></b>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Lae'zel
#. NodeID = 698fb89a-6c59-4d33-bb02-5901e1cf0bb7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_LAEZEL(7) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:698fb89a-6c59-4d33-bb02-5901e1cf0bb7
msgctxt "hdb763fe0g6f91g4b6ag8908g252e62cc9a72"
msgid "Vlaakith has spoken. You have listened. This is the way."
msgstr "블라키스께서 말씀하셨고, 넌 들었다. 이것이 길이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Astarion
#. NodeID = 6ce82a50-aa5b-4124-9eff-f79a5b9f91ee
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(10) = True
#.   Tag:
#.      - REALLY_ASTARION(10) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:6ce82a50-aa5b-4124-9eff-f79a5b9f91ee
msgctxt "h4059f831g9536g4f7egb74bg57682922b774"
msgid ""
"Surely there's a more tactful way to say that? One that won't get us killed?"
msgstr "분명히 그것보단 공손하게 말할 수 있지 않았을까? 우리를 죽일 생각까지는 들지 않게?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Wyll
#. NodeID = 6e50d76a-f7a3-491c-a08b-2331611ade8e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(11) = True
#.   Tag:
#.      - REALLY_WYLL(11) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:6e50d76a-f7a3-491c-a08b-2331611ade8e
msgctxt "hb7cbfd0ag75dbg4e51gb37dgb02157029102"
msgid ""
"Are you mad? That artefact's the only thing shielding us from the Absolute's "
"voice."
msgstr "미쳤어? 절대자의 목소리로부터 우리를 보호하는 유일한 물건이 그 아티팩트라고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Narrator
#. NodeID = 724b795d-4092-9c21-5ab9-95fecb685f4a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:724b795d-4092-9c21-5ab9-95fecb685f4a
msgctxt "hd48655e3ga208g4046g84a3gd96cfd1ba4e1"
msgid ""
"*Behind the veil of the god-queen's outer thoughts - death. Fear. "
"<i>Paranoia.</i>*"
msgstr "*장막 너머로 여왕의 다른 생각이 보입니다. - 죽음, 불안, 그리고 <i>걷잡을 수 없는 공포.</i>*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Player
#. NodeID = 74c3862c-d13c-4ac7-ae87-2b5a32edd0b6
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_DARK_URGE
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:74c3862c-d13c-4ac7-ae87-2b5a32edd0b6
msgctxt "h4b8babe7ga7c2g482cg9976g1e10a3673f47"
msgid "<i>Stand tall - you are her equal in iniquity.</i>"
msgstr "<i>당당하게 선다. 당신은 이 여자와 동급으로 사악하다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Player
#. NodeID = 74c3862c-d13c-4ac7-ae87-2b5a32edd0b6
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_SHADOWHEART and !SHADOWHEART_ENEMYOFSHARPATH
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:74c3862c-d13c-4ac7-ae87-2b5a32edd0b6
msgctxt "h16d82011g80f3g48eagafceg9c400a3a4f92"
msgid ""
"<i>Remain standing. You shall kneel before no one but the Dark Lady.</i>"
msgstr "<i>계속 서 있는다. 당신은 어둠의 여신 외에는 아무에게도 무릎을 꿇지 않아야 한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Player
#. NodeID = 74c3862c-d13c-4ac7-ae87-2b5a32edd0b6
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:74c3862c-d13c-4ac7-ae87-2b5a32edd0b6
msgctxt "h00e89ab1g12aag41e1gab5bgd6bc8df94d34"
msgid "<i>Stay standing, just as you are.</i>"
msgstr "<i>있던 대로, 계속 서 있는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Vlaakith
#. NodeID = 79100872-b5e3-478c-9b6d-52b1be288f9c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - HALFLING(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:79100872-b5e3-478c-9b6d-52b1be288f9c
msgctxt "h94a8e7f7gf866g41f3gbb1bg8409e79a66f8"
msgid "You have ventured far from your kind's comforts to serve us."
msgstr "그대는 우리를 돕기 위해 그대 종족의 품으로부터 나와 멀리 모험을 해왔구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 7b7db5ae-2495-42ca-a563-46cdf4c8d237
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_State_SecurityOfficeHostile = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:7b7db5ae-2495-42ca-a563-46cdf4c8d237
msgctxt "hc2ed62bag49d0g44fegb211g02c6fcfde6a2"
msgid "With pleasure, my queen."
msgstr "기꺼이 그러겠습니다, 여왕님."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Vlaakith
#. NodeID = 7c2c7a44-fc87-48fe-827a-6fcfc995f313
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:7c2c7a44-fc87-48fe-827a-6fcfc995f313
msgctxt "hedeb4e7eg1382g4442g9663gb347d27dd708"
msgid "<i>SILENCE, W'wargaz</i>."
msgstr "<i><b>닥쳐라</b>, 와르가즈</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Player
#. NodeID = 7eedff63-f584-9dd8-2da2-b17ed4af3cc7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:7eedff63-f584-9dd8-2da2-b17ed4af3cc7
msgctxt "hd2963281gd717g4f1ag84adg7a06628e7fd0"
msgid "Neither - I came here looking for a cure for my tadpole."
msgstr "둘 다 아닙니다. 저는 올챙이를 없앨 방법을 찾고자 여기에 왔습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Shadowheart
#. NodeID = 7fa03018-b55f-1689-6422-e09511af9688
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:7fa03018-b55f-1689-6422-e09511af9688
msgctxt "hbe5882f9gf395g4651gac53g535dd96c7824"
msgid "That's it. We're dead, thanks to you."
msgstr "이제 끝이군. 너 덕분에, 우린 다 죽었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 8082226c-07a0-4f75-bc94-e5291f3214a6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#. SetFlags:
#.   Dialog:
#.     - CRE_ChainOfCommand_State_RefusedToKneel(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:8082226c-07a0-4f75-bc94-e5291f3214a6
msgctxt "h9f8923e1gcbaag4b8ega30age55d6e874b6a"
msgid "Did your crèche teach you nothing?"
msgstr "양성소에서 배운 게 아무것도 없나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 80b1f819-451e-444d-b6c4-285e54352593
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:80b1f819-451e-444d-b6c4-285e54352593
msgctxt "hfafc9336g2a70g409eg9ac0g2edceeee9f03"
msgid "I shall cleanse it for you, my queen. Tell me how."
msgstr "제가 정화하겠습니다, 여왕이시여. 방법을 알려 주십시오."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Player
#. NodeID = 8485c17e-ccff-0e15-34b3-d85b0112cd5d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:8485c17e-ccff-0e15-34b3-d85b0112cd5d
msgctxt "h845fb2aag90a5g49f2ga9cbg2a19c00774e3"
msgid ""
"So the dream visitor is inside the artefact... I can't kill them. They "
"protect me from the Absolute."
msgstr "그럼 꿈의 방문자가 이 아티팩트 안에 있다는 말입니까... 전 죽일 수 없습니다. 그들이 저를 절대자로부터 지켜주고 있습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Player
#. NodeID = 869db4a5-4f18-4592-a97d-fb3c39c0c163
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:869db4a5-4f18-4592-a97d-fb3c39c0c163
msgctxt "h1fa3c403g5af0g4fa4ga18ag06ca93ddb709"
msgid "I am more than friend. I am your most loyal servant."
msgstr "여왕님의 친구일 뿐만 아니라, 가장 충실한 종복입니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Vlaakith
#. NodeID = 86e4ad7c-421a-4073-b50a-96d4c09b11d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:86e4ad7c-421a-4073-b50a-96d4c09b11d9
msgctxt "h9aa9cab4g2b08g41a4gb97dgd21fc6bee90b"
msgid "We will test you. To assess whether you deserve reward or punishment."
msgstr "짐은 그대에게 보상과 처벌 중에 어떤 것을 내릴지 시험할 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Player
#. NodeID = 8a4c9b33-8e96-4541-9ca2-2a500455b5c5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:8a4c9b33-8e96-4541-9ca2-2a500455b5c5
msgctxt "h8abef4d0gfcf1g4d69g9d5cg9689b7bdfb12"
msgid "It is my greatest honour to obey."
msgstr "명을 받들게 되어 무한한 영광입니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Player
#. NodeID = 8d594f80-4d53-4040-a207-296873c9f7bf
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_SHADOWHEART and !SHADOWHEART_ENEMYOFSHARPATH
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:8d594f80-4d53-4040-a207-296873c9f7bf
msgctxt "h36d55b7fg2ac8g4de0gaf39ge3100e377f4a"
msgid ""
"I was bid to safeguard the artefact - not anything or anyone hiding within "
"it. I shall do as you wish."
msgstr "저의 임무는 이 아티팩트를 보호하는 것이지, 이 안의 누군가를 보호하는 것은 아닙니다. 분부대로 하겠습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Player
#. NodeID = 8d594f80-4d53-4040-a207-296873c9f7bf
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:8d594f80-4d53-4040-a207-296873c9f7bf
msgctxt "h60d4a9e4g529fg43fag82fegba18e0b06279"
msgid "I will do as you wish."
msgstr "분부대로 하겠습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Vlaakith
#. NodeID = 8ebf6064-5ffb-1a31-e9f5-bd5bc9c8ebc6
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:8ebf6064-5ffb-1a31-e9f5-bd5bc9c8ebc6
msgctxt "h4ad8d956g0fb6g489agb0ffg96dbee58908c"
msgid "Obey, my child, and be forgiven."
msgstr "복종하라, 나의 자녀여. 그리하면 용서 받을 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Vlaakith
#. NodeID = 8ebf6064-5ffb-1a31-e9f5-bd5bc9c8ebc6
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:8ebf6064-5ffb-1a31-e9f5-bd5bc9c8ebc6
msgctxt "h0912badag1d7bg451ag9498g158244c4c44d"
msgid "Obey, and be forgiven."
msgstr "복종하라, 그리하면 용서받을 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Player
#. NodeID = 918c3db3-59d0-f3f6-d14d-54ad41b4675b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:918c3db3-59d0-f3f6-d14d-54ad41b4675b
msgctxt "hc79a4584g6252g4e0fgb7ebg24131de8b1a5"
msgid "<i>Kneel: choke down your brutal pride.</i>"
msgstr "<i>당신의 잔혹한 자존심을 내려놓고, 무릎을 꿇는다. </i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Shadowheart
#. NodeID = 91936e2e-e9c2-4d6f-ba04-f316b4220e7b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(8) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(8) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:91936e2e-e9c2-4d6f-ba04-f316b4220e7b
msgctxt "h7d4825f5gf0e3g4e12g9467g7f27a78dcae3"
msgid ""
"Fool - that artefact is the only thing keeping us safe. She cannot have it."
msgstr "멍청아, 그 아티팩트가 우릴 지켜주는 유일한 물건이란 말이야. 이걸 넘길 순 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Vlaakith
#. NodeID = 977500b3-a55c-4ff2-8bdd-c00e9b600803
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:977500b3-a55c-4ff2-8bdd-c00e9b600803
msgctxt "he89c07b8gfe30g4153gbe2cg3ebb0ac5f426"
msgid "The Astral Prism - it is <i>corrupted</i>."
msgstr "아스트랄 프리즘. 그것은 <i>오염</i>되었다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Player
#. NodeID = 9fd8a238-4a38-1093-1af0-d782a501b4fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:9fd8a238-4a38-1093-1af0-d782a501b4fc
msgctxt "h5b49ad7dg5e52g4518gb1acg2f1ad50c6bf7"
msgid "The god-queen of my people cannot kill someone herself?"
msgstr "우리의 여왕신께서는 직접 죽일 수 없단 말입니까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Vlaakith
#. NodeID = a0f9629a-d4f4-8c3c-a5fc-a48e752e616c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:a0f9629a-d4f4-8c3c-a5fc-a48e752e616c
msgctxt "h1a84ad5cg7f62g401cgb2eagc6fa1d48ca18"
msgid ""
"They are an agent of the Grand Design. Sent to sabotage the Astral Prism - "
"our last defence against the return of the Illithid Empire."
msgstr ""
"그것들은 <i>원대한 설계</i>를 실현하려고 하는 족속들이다. 일리시드 제국의 귀환을 막기 위한 우리의 마지막 희망, 아스트랄 프리즘을 "
"파괴하기 위해 보내진 자들이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Vlaakith
#. NodeID = a13357a8-f477-2e13-67c6-29afc6f8c101
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:a13357a8-f477-2e13-67c6-29afc6f8c101
msgctxt "hdb436d4agcd6dg43b2g834dgefbca88878ca"
msgid ""
"To own something is to <i>know </i>it. You know NOTHING of what you carry."
msgstr "무엇인가를 소유한다는 것은 그것을 <i>이해 </i>한다는 것이지. 그런데 네 녀석은 그 물건에 대해서 아무것도 모른다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Gale
#. NodeID = a18f7d4a-bc1f-4f0e-816f-e47f523e07e8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(12) = True
#.   Tag:
#.      - REALLY_GALE(12) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:a18f7d4a-bc1f-4f0e-816f-e47f523e07e8
msgctxt "h88d5cd54gff68g4ebfg94afgf04ff4bd80af"
msgid ""
"How generous of you - but perhaps you've forgotten we need it ourselves? "
"That thing is keeping us safe."
msgstr "얼마나 너그러운지. 이 물건이 우리한테 필요하다는 걸 잊은 거야? 그건 우리를 지켜주고 있단 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Vlaakith
#. NodeID = ac0a4d9d-4ce3-3392-73a2-f7bc04e6a3f6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:ac0a4d9d-4ce3-3392-73a2-f7bc04e6a3f6
msgctxt "h3799932ag98a6g4deeg82c4gd4f72a3f3f67"
msgid "YOU WISH TO SEE <i>GODHOOD?</i>"
msgstr "<b><i>신격</i>이 무엇인지 목도하기를 소망하는 것이냐?</b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Vlaakith
#. NodeID = b42206f9-9067-19e5-1465-73340e4f388c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:b42206f9-9067-19e5-1465-73340e4f388c
msgctxt "h76fef978g78cag4b91gac06g5d44fa73e6cb"
msgid "Hmm. HMMMMM."
msgstr "흠. <b>흐으음.</b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Player
#. NodeID = b45a2377-5a91-4f45-8b49-5a8c8e264b9e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:b45a2377-5a91-4f45-8b49-5a8c8e264b9e
msgctxt "h68b940eagfe37g42bagbd7fgb3e83b0986ec"
msgid "<i>Kneel.</i>"
msgstr "<i>무릎을 꿇는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Vlaakith
#. NodeID = b6cc9c03-be2d-6ca3-cb7e-608e3f91ac92
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:b6cc9c03-be2d-6ca3-cb7e-608e3f91ac92
msgctxt "h684067b5ga4bfg4624g8781ge4aae8c8bf5f"
msgid "And you just happened to STUMBLE on the <i>Astral Prism</i>?"
msgstr "그리고 그냥 <b>우연히</b> <i>아스트랄 프리즘</i>을 찾았다는 말이냐?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Narrator
#. NodeID = b6d39d5b-ed79-b632-3b9f-62143ad918fb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:b6d39d5b-ed79-b632-3b9f-62143ad918fb
msgctxt "h6a471a9eg72fcg400bgb6cbg2ab17540bd53"
msgid "*The veil snaps back. Vlaakith's mind shut out to you forever.*"
msgstr "*장막은 순식간에 닫힙니다. 블라키스의 내면은 당신을 영원히 추방했습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Vlaakith
#. NodeID = b7513ec7-cf5f-f0ae-854d-8810b29cacce
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_State_PlanecasterActive = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:b7513ec7-cf5f-f0ae-854d-8810b29cacce
msgctxt "h1ef76c8cg043ag431eg8f4eg182f843e8ca6"
msgid "Use this to enter the Prism, or deny me. The choice is yours."
msgstr "이것을 사용해서 프리즘으로 들어가라. 거부해도 좋다. 선택은 그대의 몫이니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Player
#. NodeID = b78aeef4-084b-a413-0ec2-89cf7a1f4e5f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:b78aeef4-084b-a413-0ec2-89cf7a1f4e5f
msgctxt "h18366b09g8a8ag4193gb9f7ga603115d68a0"
msgid ""
"Can't you kill the one inside yourself? I thought 'gods' were all-powerful."
msgstr "당신이 안에 있는 존재를 직접 죽이면 되는 거 아닌가? '신'들은 다 전능한 줄 알았는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Player
#. NodeID = b7e46a15-651a-3f4b-e45f-bed197451e66
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:b7e46a15-651a-3f4b-e45f-bed197451e66
msgctxt "h61efe86egd817g4ea3g844ag08c85da1ce4e"
msgid "I spoke too hastily - please forgive me."
msgstr "너무 성급히 말했습니다. 부디 용서해주시길."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = b8f94136-1f6f-42a3-9d78-9927b800f882
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = False
#. SetFlags:
#.   Dialog:
#.     - CRE_ChainOfCommand_State_RefusedToKneel(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:b8f94136-1f6f-42a3-9d78-9927b800f882
msgctxt "hef786527g18efg4fffgb9c0ge139c1968da2"
msgid ""
"I expected little of<i> istik </i>education, but here we <i>kneel </i>before "
"our <i>queen</i>."
msgstr ""
"<i>이스틱</i>놈들의 교육 수준이 낮을 것이라 짐작하긴 했건만, 여기서는 <i>여왕님</i> 앞에서 <i>무릎을 꿇어야</i> 하는 "
"것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Narrator
#. NodeID = ba95065c-a5e9-4699-575b-3b3b016591b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:ba95065c-a5e9-4699-575b-3b3b016591b1
msgctxt "hb347b4bag702ag43fag8249g94ba47a871cc"
msgid ""
"*She <i>fears</i> the one inside the artefact more than anything in the "
"world. But she's hiding something.*"
msgstr "*그녀는 저 아티팩트 안의 존재를 세상 어느 것보다 <i>두려워하고</i> 있습니다. 그렇지만 그녀는 무언가 숨기고 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Narrator
#. NodeID = bd3733ec-2ac5-26c8-0f71-40056a74cc08
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WARLOCK(1) = True
#.      - REALLY_WYLL(1) = False
#. TagRule: ONEEYED and WARLOCK_ARCHFEY
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:bd3733ec-2ac5-26c8-0f71-40056a74cc08
msgctxt "h12f4ea49g4ad9g4094gbcfege499d5f98c16"
msgid ""
"*Your vision thrums green and gold for a moment as your patron borrows your "
"eye to see the vision before you.*"
msgstr "*후원자가 당신의 눈을 빌려 당신 앞의 광경을 보는 잠깐 동안, 당신의 시야는 녹색과 금색으로 반짝입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Narrator
#. NodeID = bd3733ec-2ac5-26c8-0f71-40056a74cc08
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WARLOCK(1) = True
#.      - REALLY_WYLL(1) = False
#. TagRule: WARLOCK_ARCHFEY and !ONEEYED
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:bd3733ec-2ac5-26c8-0f71-40056a74cc08
msgctxt "ha7565996g840bg49bfg90d7g095975afd5ea"
msgid ""
"*The edges of your vision thrum with green and gold for a moment as your "
"patron borrows your eyes to see the vision before you.*"
msgstr "*후원자가 당신의 눈을 빌려 당신 앞의 광경을 보는 잠깐 동안, 당신의 시야 가장자리는 녹색과 금색으로 반짝입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Narrator
#. NodeID = bd3733ec-2ac5-26c8-0f71-40056a74cc08
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WARLOCK(1) = True
#.      - REALLY_WYLL(1) = False
#. TagRule: WARLOCK_FIEND
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:bd3733ec-2ac5-26c8-0f71-40056a74cc08
msgctxt "he02b7305g4f47g406egacbfg34d98545744d"
msgid ""
"*Malignant flame crosses your vision as your patron borrows your gaze - "
"sizing up the vision in front of you.*"
msgstr "*사특한 불꽃이 당신의 눈앞을 가로지릅니다. 후원자가 당신의 눈을 빌려 앞의 존재를 가늠합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Narrator
#. NodeID = bd3733ec-2ac5-26c8-0f71-40056a74cc08
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WARLOCK(1) = True
#.      - REALLY_WYLL(1) = False
#. TagRule: WARLOCK_GREAT_OLD_ONE
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:bd3733ec-2ac5-26c8-0f71-40056a74cc08
msgctxt "h3a8222a4g277bg4c34g9a99g0979899214af"
msgid ""
"*Your vision throbs with ink-black darkness as your patron borrows your gaze "
"- beholding the vision in front of you.*"
msgstr "*당신의 시야는 검은 어둠으로 진동합니다. 후원자가 당신의 눈을 빌려 앞의 존재를 주시합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Vlaakith
#. NodeID = c215e84b-862d-5208-d24b-b7149ab3c9e7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CRE_ChainOfCommand_Event_ShowedArtifactToTemplar(1) = True
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_State_PlanecasterActive = True
#.     - ORI_Laezel_Knows_MetVlaakith = True
#.     - CRE_ChainOfCommand_State_SpokeToVlaakith = True
#.   Object:
#.     - CRE_ChainOfCommand_SecurityOfficer02_StartInclusion(1) = True
#.     - CRE_ChainOfCommand_IntelligenceOfficer02_StartInclusion(1) = True
#.     - CRE_ChainOfCommand_Templar_StartInclusion(1) = True
#.     - CRE_ChainOfCommand_IntelligenceOfficer01_StartInclusion(1) = True
#.     - CRE_ChainOfCommand_SecurityOfficer01_StartInclusion(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:c215e84b-862d-5208-d24b-b7149ab3c9e7
msgctxt "hca5f38d2g79d8g4359g888dgb48678ddd866"
msgid "So - it is found."
msgstr "그래. 찾았구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Vlaakith
#. NodeID = c38d1a10-c262-48ad-974b-b08ce9db4616
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_State_PlanecasterActive = True
#.     - CRE_ChainOfCommand_State_RecievedMissionFromVlaakith = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:c38d1a10-c262-48ad-974b-b08ce9db4616
msgctxt "h58c1ca20gee3cg4aa9g8890g813d1fa6fddb"
msgid ""
"Find the one inside and destroy them. Be aware - they are not alone, and "
"they will appeal to your trust. They are not to be believed."
msgstr ""
"안에 있는 존재를 찾아 파괴하라. 그러나 주의하라, 녀석은 혼자가 아니니. 그대의 신뢰를 얻으려 할 것이나, 믿을 수 있는 족속들이 "
"아니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Narrator
#. NodeID = c3fec65d-b1f1-8568-e252-e792dbfa00c6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:c3fec65d-b1f1-8568-e252-e792dbfa00c6
msgctxt "h163895aegb1e6g4b19ga7c1g664353f059ed"
msgid ""
"*The queen who brings conquest to the heavens, sundering planets, destroying "
"the very stars.*"
msgstr "*하늘을 정복하고 행성을 불태우며 별들을 파괴하는 여왕.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Player
#. NodeID = cb5d79f1-c50d-4c64-b9e6-d55f80f8c7e1
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_SHADOWHEART and !SHADOWHEART_ENEMYOFSHARPATH
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:cb5d79f1-c50d-4c64-b9e6-d55f80f8c7e1
msgctxt "hefd1bb7egd1f8g4adag9b32gba628628ce6d"
msgid ""
"I claimed the artefact for Lady Shar - until I fulfill my mission, it is "
"mine to protect."
msgstr "이건 샤 여신의 아티팩트다. 난 소명을 다할 때까지 이 물건을 보호할 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Player
#. NodeID = cb5d79f1-c50d-4c64-b9e6-d55f80f8c7e1
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:cb5d79f1-c50d-4c64-b9e6-d55f80f8c7e1
msgctxt "h27ad3389g0410g445cg8127gb23d3fa67213"
msgid "Yours? <i>I </i>found it. The artefact is <i>mine</i>."
msgstr "당신 거라고? 내가 찾았어. 아티팩트는 내 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Player
#. NodeID = cb66b2bd-3b7c-4d5d-bef7-1b8da9c20787
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:cb66b2bd-3b7c-4d5d-bef7-1b8da9c20787
msgctxt "h9c8f2b7bg6730g4d26g953fg04c11d3b1924"
msgid "Does it matter? I brought it back to you."
msgstr "상관 있나요? 다시 가지고 왔잖아요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Vlaakith
#. NodeID = cc61d075-c687-fe70-6c11-0af27c5cb62b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:cc61d075-c687-fe70-6c11-0af27c5cb62b
msgctxt "hec21ad25g9427g4eeega769gb13b317d9b58"
msgid "You are being <i>LIED TO</i>."
msgstr "네 녀석은 <i>속고 있는 것이다</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Vlaakith
#. NodeID = cedbaec2-ba89-1f25-8687-502ec2c68b96
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:cedbaec2-ba89-1f25-8687-502ec2c68b96
msgctxt "h4e50b870g87eeg4b0egb5e4gf9d10e4665ad"
msgid "You must accept. Refuse, and know my fury."
msgstr "반드시 수락해야 할 것이다. 거부한다면 짐의 격노를 마주하게 되리니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Vlaakith
#. NodeID = d0713662-143b-bfc0-555a-4b6e91e9dd81
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:d0713662-143b-bfc0-555a-4b6e91e9dd81
#, fuzzy
msgctxt "h0520750fg3dedg4648gba8fg122bc3a8975a"
msgid "Be wary of the creature's lying tongue. Cut it out, if you must."
msgstr "그것의 거짓된 혀를 조심하라. 해야 한다면 그 혀를 잘라내라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Vlaakith
#. NodeID = d4dcecb8-b1fb-9abe-53b8-70706891a828
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_State_PlanecasterActive = True
#.     - ORI_Laezel_Knows_MetVlaakith = True
#.     - CRE_ChainOfCommand_State_SpokeToVlaakith = True
#.   Object:
#.     - CRE_ChainOfCommand_SecurityOfficer02_StartInclusion(1) = True
#.     - CRE_ChainOfCommand_IntelligenceOfficer02_StartInclusion(1) = True
#.     - CRE_ChainOfCommand_Templar_StartInclusion(1) = True
#.     - CRE_ChainOfCommand_IntelligenceOfficer01_StartInclusion(1) = True
#.     - CRE_ChainOfCommand_SecurityOfficer01_StartInclusion(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:d4dcecb8-b1fb-9abe-53b8-70706891a828
msgctxt "h8c66d0d3gf590g47b4g85b6g90b364e1b428"
msgid "Inquisitor W'wargaz was potent. We are <i>impressed</i>."
msgstr "심문관 와르가즈는 강력한 자였다. 짐은 <i>감명</i>받았도다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Vlaakith
#. NodeID = daa8002c-f270-49d6-bc44-62216fc7aaaf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:daa8002c-f270-49d6-bc44-62216fc7aaaf
msgctxt "he0eb586fg1a8bg4fe9ga51agbc51d884c63b"
msgid "You bear that which is ours. But are you friend, or are you thief?"
msgstr "짐의 물건을 지니고 있구나. 그대는 친구인가, 아니면 도둑인가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Vlaakith
#. NodeID = de488041-5551-b961-f764-b279795edba5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:de488041-5551-b961-f764-b279795edba5
msgctxt "he76e78efg8e51g4b71gad1dg89fd024d87f9"
msgid ""
"There is someone inside. Their mind is warped, broken - a <i>blight</i>."
msgstr "이 안에 누군가 있다. 그것의 정신은 왜곡되고 부서졌지. 마치 <i>해충</i>과 같은 것 이니라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Karlach
#. NodeID = de96beaf-d555-4ad7-bcdc-7b3ad103ef87
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(9) = True
#.   Tag:
#.      - REALLY_KARLACH(9) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:de96beaf-d555-4ad7-bcdc-7b3ad103ef87
msgctxt "h2bed52aag4846g4b92g90eaga6afcd73fbfa"
msgid "Gods, she's gonna rip our legs off."
msgstr "맙소사, 이제 저 여자가 네 다리를 찢을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Astarion
#. NodeID = def2ed80-89c1-464e-9fe2-ae187954adc3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(10) = True
#.   Tag:
#.      - REALLY_ASTARION(10) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:def2ed80-89c1-464e-9fe2-ae187954adc3
msgctxt "h5c35fa33g4029g4216g8552g2fdfd3550b6e"
msgid ""
"You're what? That is the only thing keeping us from a gruesome, tentacled-"
"filled future."
msgstr "뭐라고? 그건 우리를 촉수로 가득 찬 끔찍한 미래로부터 지켜주는 유일한 물건인데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Shadowheart
#. NodeID = e336da60-9aee-4369-b013-27e5b8b94e11
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(8) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(8) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:e336da60-9aee-4369-b013-27e5b8b94e11
msgctxt "h0f5395b8gcc80g486ag9a0bg778d0f135144"
msgid ""
"Good. Whatever happens to us, the lich queen must not take the artefact."
msgstr "좋아. 우리한테 무슨 일이 일어나도 리치 여왕이 아티팩트를 가져가선 안 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Player
#. NodeID = e3420065-4544-6af2-9dca-b6cf9180d070
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_State_RefusedVlaakithsOrdersInDialog = True
#. TagRule: REALLY_SHADOWHEART and !SHADOWHEART_ENEMYOFSHARPATH
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:e3420065-4544-6af2-9dca-b6cf9180d070
msgctxt "h66348b47gcdd3g4241g80d6geab8f6914217"
msgid ""
"A real god such as my Lady Shar? You embarass yourself with such a "
"comparison."
msgstr "내가 섬기는 샤 여신과 같은 진짜 신이라고? 그런 식의 비교로 스스로를 부끄럽게 만드는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Player
#. NodeID = e3420065-4544-6af2-9dca-b6cf9180d070
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_State_RefusedVlaakithsOrdersInDialog = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:e3420065-4544-6af2-9dca-b6cf9180d070
msgctxt "hbbf719e7gc28bg4506g9b19g22e37b17acfd"
msgid "I just think a real god could kill whoever she wants."
msgstr "그냥, 진짜 신이라면 원하면 누구든 죽일 수 있을 것 같아서 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Vlaakith
#. NodeID = e4e208fc-93e5-31ad-808f-5a34686f87ff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:e4e208fc-93e5-31ad-808f-5a34686f87ff
msgctxt "h5f323beag8dfcg4cadgaed5gc672ee792bae"
msgid "AND <i>YOU</i>..."
msgstr "<b>그리고 <i>그대는</i>...</b>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Vlaakith
#. NodeID = e6c18ff1-e6ba-44ca-b8d8-1e4bdd045e3b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:e6c18ff1-e6ba-44ca-b8d8-1e4bdd045e3b
msgctxt "h9744cccdg9cc4g47b8g97dfg2ccb10b00d78"
msgid "Your kind will go far for glory. As you have shown by being here."
msgstr "그대의 종족은 영광스러워질 것이다. 그대가 이곳에 당도함으로써 증명한 것처럼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Lae'zel
#. NodeID = e93ecc7c-8176-4227-910a-94e914c14ac6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_LAEZEL(7) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:e93ecc7c-8176-4227-910a-94e914c14ac6
msgctxt "hf8d2da22g6fb3g4dcega380g2fed5cf80567"
msgid "Fool. You speak with the Lich Queen. You do not refuse Vlaakith."
msgstr "멍청하긴. 너는 지금 리치 여왕님을 알현하고 있는 것이다. 그분을 거스르지 마라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Player
#. NodeID = ef72f89c-b623-3d1f-e5a6-4129fc34fb7e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_State_RefusedVlaakithsOrdersInDialog = True
#. TagRule: OATHBREAKER
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:ef72f89c-b623-3d1f-e5a6-4129fc34fb7e
msgctxt "h6ae550ddg5a4fg49f6g9b0dgeba5c002ff00"
msgid "I do not 'obey'. You have misjudged me, lich queen."
msgstr "나는 '복종'하지 않는다. 날 잘 못 판단했어. 리치 여왕."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Player
#. NodeID = ef72f89c-b623-3d1f-e5a6-4129fc34fb7e
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_State_RefusedVlaakithsOrdersInDialog = True
#. TagRule: PALADIN_VENGEANCE
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:ef72f89c-b623-3d1f-e5a6-4129fc34fb7e
msgctxt "had557495gead1g4734g8648g2053b69d4344"
msgid ""
"You are confused, Vlaakith - I serve those in need of justice, not some "
"tyrant god."
msgstr "착각하는군, 블라키스. 나는 정의가 필요한 사람들을 돕는다. 폭군 신이 아니라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Player
#. NodeID = ef72f89c-b623-3d1f-e5a6-4129fc34fb7e
#. HandlePath = TaggedText[2].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_State_RefusedVlaakithsOrdersInDialog = True
#. TagRule: PALADIN_DEVOTION
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:ef72f89c-b623-3d1f-e5a6-4129fc34fb7e
msgctxt "he9c30aa0g082ag4736g86f9ge5d4b8ca0296"
msgid ""
"I serve those of a loyal heart, not some astral god-queen. I will not obey "
"you."
msgstr "나는 고귀한 마음을 가진 사람들을 돕는다. 아스트랄의 여왕신이 아니라. 나는 그대에게 복종하지 않을 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Player
#. NodeID = ef72f89c-b623-3d1f-e5a6-4129fc34fb7e
#. HandlePath = TaggedText[3].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_State_RefusedVlaakithsOrdersInDialog = True
#. TagRule: PALADIN_ANCIENTS
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:ef72f89c-b623-3d1f-e5a6-4129fc34fb7e
msgctxt "h0fcf5120gdd1cg4bceg8d8cgd763e736bbcd"
msgid ""
"My oath is sworn to the ancient magic of this world - not your astral "
"empire. I owe you nothing."
msgstr "내 맹세는 이 세계의 고대 마법에 대한 서약이지, 당신의 아스트랄 제국에 대한 것이 아니야. 난 당신에게 서약한 적 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Vlaakith
#. NodeID = f060fa4d-23b1-37c0-4776-9b8ac8a12528
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:f060fa4d-23b1-37c0-4776-9b8ac8a12528
msgctxt "h7f10a7e8g5e87g41f4g9ce6gc85ebeb646b5"
msgid "That is no answer to my question."
msgstr "그것은 짐의 질문에 대한 대답이 되지 않는다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Vlaakith
#. NodeID = f293e045-b893-9284-d9e7-1658ef12658d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:f293e045-b893-9284-d9e7-1658ef12658d
msgctxt "he0390d58g1cf5g474bgbda2g1364bdfcbdc2"
msgid "BLASPHEMING TONGUE."
msgstr "<b>불경스러운 입이로다</b>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Lae'zel
#. NodeID = f722bfb4-6fbe-457d-bbf3-6f6aaa5d9ff8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:f722bfb4-6fbe-457d-bbf3-6f6aaa5d9ff8
msgctxt "h7479a61cg1b88g4889g9488g0d1845998ca2"
msgid "<i>My queen.</i>"
msgstr "<i>여왕이시여.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Vlaakith
#. NodeID = f8c10033-b828-4c10-984e-08be765b314d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:f8c10033-b828-4c10-984e-08be765b314d
msgctxt "h4f1af220g5f54g43f9gb125g43ce10009569"
msgid ""
"Extend your fealty one step further, and you will be rewarded beyond your "
"mortal reckoning."
msgstr "그대의 충성의 길에 한 발짝 더 나아가라, 그러면 필멸자의 이해를 초월하는 보상을 받게 될 것이니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Player
#. NodeID = f96609bc-a614-bdb9-1cea-1d714a492512
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:f96609bc-a614-bdb9-1cea-1d714a492512
msgctxt "h3e5f3e40g6d03g4dfag848dg6e9bfda388e2"
msgid "Who exactly are you?"
msgstr "당신은 정확히 누구죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Player
#. NodeID = fd2b0c62-5081-f129-9bb4-44b46be73128
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:fd2b0c62-5081-f129-9bb4-44b46be73128
msgctxt "h2393b2f3g40e6g4a08g9485ga082a464fa75"
msgid "Fine. I will go in and kill them."
msgstr "좋아. 들어가서 그들을 죽이겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Player
#. NodeID = fe72940a-6cf5-458d-a421-95211ee0c674
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_State_RefusedVlaakithsOrdersInDialog = True
#. TagRule: REALLY_SHADOWHEART and !SHADOWHEART_ENEMYOFSHARPATH
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:fe72940a-6cf5-458d-a421-95211ee0c674
msgctxt "hd149fb59g32f3g461ega551gd80316b3d0f0"
msgid ""
"No. I answer to no one but Lady Shar - and anything that benefits you must "
"surely harm her."
msgstr "아니. 나는 샤 여신의 부름에만 응답해. 그리고 당신한테 이익이 되는 건 반드시 그분에게 해가 될 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Player
#. NodeID = fe72940a-6cf5-458d-a421-95211ee0c674
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_State_RefusedVlaakithsOrdersInDialog = True
#. TagRule: WARLOCK
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:fe72940a-6cf5-458d-a421-95211ee0c674
msgctxt "h7797ca5agf58bg46f9ga110g9b3c96faadd8"
msgid ""
"I'm afraid I don't do the bidding of extraplanar entities for free - bad for "
"business."
msgstr "유감스럽지만 난 다른 차원의 존재가 주는 의뢰를 공짜로 해주진 않아. 사업적으로 안 좋거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Player
#. NodeID = fe72940a-6cf5-458d-a421-95211ee0c674
#. HandlePath = TaggedText[2].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_State_RefusedVlaakithsOrdersInDialog = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:fe72940a-6cf5-458d-a421-95211ee0c674
msgctxt "h53f5af6dga0bag4c62g956ag34e46f34cb6b"
msgid "No way. I don't work for deluded tyrants."
msgstr "그럴 순 없지. 난 거짓말이나 하는 폭군을 위해서 일하지 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith
#. Speaker = Shadowheart
#. NodeID = fe79c0c6-ab2f-40ac-9c5b-091052b8ff13
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Vlaakith:fe79c0c6-ab2f-40ac-9c5b-091052b8ff13
msgctxt "hc0630487g40e6g49feg90b9g5122b102cd98"
msgid "What are you doing?!"
msgstr "뭐 하는 거야?!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_AD_CaretakerChatter
#. Speaker = Varsh Ko'kuu
#. NodeID = 5ff6c823-8f74-45be-bf17-50afb283a592
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - d57c5fb1-47c7-53a0-86f7-357395860efa_A = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_AD_CaretakerChatter:5ff6c823-8f74-45be-bf17-50afb283a592
msgctxt "hdf965984g712fg490bga23dga32f615d1e79"
msgid "Come on little one, come on now - it's time to come out."
msgstr "조금만 더 힘내렴, 얘야. 이제 나올 때란다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_AD_CaretakerChatter
#. Speaker = Varsh Ko'kuu
#. NodeID = a0a39284-b59d-4047-aae3-201567d0a447
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - d57c5fb1-47c7-53a0-86f7-357395860efa_A = True
#. SetFlags:
#.   Local:
#.     - d57c5fb1-47c7-53a0-86f7-357395860efa_B = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_AD_CaretakerChatter:a0a39284-b59d-4047-aae3-201567d0a447
msgctxt "h040679fag7bd3g48fdgbc28gdc31c3798ef2"
msgid "Don't you want to fight with your brothers and sisters?"
msgstr "어서 나와서 네 형제자매들이랑 싸워야지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_AD_CaretakerChatter
#. Speaker = Varsh Ko'kuu
#. NodeID = c7f3f425-c2ac-4e21-8b4f-13b11edfd898
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - d57c5fb1-47c7-53a0-86f7-357395860efa_C = True
#. SetFlags:
#.   Local:
#.     - d57c5fb1-47c7-53a0-86f7-357395860efa_B = False
#.     - d57c5fb1-47c7-53a0-86f7-357395860efa_C = False
#.     - d57c5fb1-47c7-53a0-86f7-357395860efa_A = False
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_AD_CaretakerChatter:c7f3f425-c2ac-4e21-8b4f-13b11edfd898
msgctxt "h9b953c29gb65eg4fb6g803fg267e32a1d075"
msgid "*Sigh.* Please come out."
msgstr "*하아.* 제발 깨어나렴."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_AD_CaretakerChatter
#. Speaker = Varsh Ko'kuu
#. NodeID = e31d2f1a-7370-4033-aca8-11a66eac4bfa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - d57c5fb1-47c7-53a0-86f7-357395860efa_B = True
#. SetFlags:
#.   Local:
#.     - d57c5fb1-47c7-53a0-86f7-357395860efa_C = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_AD_CaretakerChatter:e31d2f1a-7370-4033-aca8-11a66eac4bfa
msgctxt "hcb1f098fg80f2g4026gac5cg6894765da1b5"
msgid "Fighting a battle already, and it's not even born yet..."
msgstr "다들 싸우고 있는데, 이 녀석은 아직 태어나지도 않았으니..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_AD_CaretakerCombat
#. Speaker = Varsh Ko'kuu
#. NodeID = e71c0655-b41d-4417-98e7-40d60248ba7e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_AD_CaretakerCombat:e71c0655-b41d-4417-98e7-40d60248ba7e
msgctxt "hf5ffa616gdf3cg4d89gbb74g2828949570b2"
msgid "<i>Pa'vrylk!</i> Violator! You will not leave my hatchery alive."
msgstr "<i>파브릴크!</i> 침입자! 내 부화장을 살아서 떠나지 못하리라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_AD_CaretakerEnterCombat
#. Speaker = Varsh Ko'kuu
#. NodeID = 5c1a72ec-8af5-b0c2-20d8-c564eec1afa2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_Hatchery_State_EggTaken = False
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_AD_CaretakerEnterCombat:5c1a72ec-8af5-b0c2-20d8-c564eec1afa2
msgctxt "hd99e6e97gc3fbg44b2gae5bg373c1ee7d633"
msgid "<i>Pa'vrylk! Your </i>future ends now. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_AD_CaretakerEnterCombat
#. Speaker = Varsh Ko'kuu
#. NodeID = f5aae7c2-3901-6577-5437-852ae2d1e00e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_Hatchery_State_EggTaken = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_AD_CaretakerEnterCombat:f5aae7c2-3901-6577-5437-852ae2d1e00e
msgctxt "h8f49f379g11afg49e6g96eege5f500246547"
msgid "I'll make you wish <i>you'd </i>never been born!"
msgstr "<i>네 녀석이</i> 태어난걸 후회하게 만들어주마!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_AD_TeletrapTriggered
#. Speaker = Varsh Ko'kuu
#. NodeID = 8cd55493-f315-4a0e-8a10-b501e52b6ead
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_Hatchery_State_HatcheryFriendly = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_AD_TeletrapTriggered:8cd55493-f315-4a0e-8a10-b501e52b6ead
msgctxt "ha169cb39ge234g4b6egbcc8ga349c74be658"
msgid "Stand down. They have my permission to proceed. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_AD_TeletrapTriggered
#. Speaker = Warrior Vu'un
#. NodeID = 9ac1cdcb-4e0d-e511-29d2-7b416790ad97
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_AD_TeletrapTriggered:9ac1cdcb-4e0d-e511-29d2-7b416790ad97
msgctxt "h4837fceeg77fdg4b5cg9b56g5932b136eef6"
msgid "Very well, sir. As you say."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_AD_TeletrapTriggered
#. Speaker = Varsh Ko'kuu
#. NodeID = ade4dfcd-f5ee-4bfd-8a26-5a8e8adfc5ad
