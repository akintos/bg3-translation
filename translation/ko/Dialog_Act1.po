msgctxt "h85f8dc0dgc166g42bfg8d93ge0e48f34a4e4"
msgid "*Hoo!*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear
#. Speaker = Narrator
#. NodeID = 7642dacd-1a25-d96d-0266-fde25c777da2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_ChickenChase_Event_OwlbearAttack(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear:7642dacd-1a25-d96d-0266-fde25c777da2
msgctxt "ha1fd27c7g23e9g4968gb2c9g5cc89a19df49"
msgid ""
"*The cub's beak snaps in the air, eager to rend<i>, yearning </i>for blood "
"and soft belly-flesh.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear
#. Speaker = Narrator
#. NodeID = 76e6e917-50e9-1c54-ac32-79d176f4296c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_ChickenChase_State_AngeredOwlbear = True
#.   Local:
#.      - 7611fa51-4b1b-3d2c-a8a5-74c04d9db7fa_AnimalHandlingSuccess = True
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear:76e6e917-50e9-1c54-ac32-79d176f4296c
msgctxt "hcdf72064g7233g447cg85bbg696266eb9138"
msgid ""
"*Talons tensed to strike, beak aching to rend - the cub wants you gone.*"
msgstr "*발톱은 공격 태세를 갖추고 있으며, 부리는 찢고 싶어합니다. 새끼는 당신이 사라지길 원합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear
#. Speaker = Player
#. NodeID = 7faad52a-370d-3e64-1f0f-613266942e1e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 10
#. CheckFlags:
#.   Dialog:
#.      - GOB_Owlbear_State_FailedAnimalHandling(1) = False
#.   Local:
#.      - 7611fa51-4b1b-3d2c-a8a5-74c04d9db7fa_AnimalHandlingSuccess = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear:7faad52a-370d-3e64-1f0f-613266942e1e
msgctxt "hae820bafg45e6g497fg8adfg17ad8a6900ff"
msgid "<i>Kneel down - you won't hurt him.</i>"
msgstr "<i>해치지 않는다는 뜻으로 무릎을 꿇는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear
#. Speaker = Narrator
#. NodeID = 802232cb-c37f-4648-afc5-97199ebb0d4e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear:802232cb-c37f-4648-afc5-97199ebb0d4e
msgctxt "h5da3b8d1g37d4g46e9gb2f6g2edbbae947bc"
msgid ""
"*But his mother is gone - taken. All that's left are these <i>creatures</i>.*"
msgstr "*하지만 이제 어미는 없습니다. 빼앗기고 말았죠. 이제 남은 건 이 <i>흉물들</i>뿐입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear
#. Speaker = Owlbear Cub
#. NodeID = 86b0e5af-271c-edfe-4b6b-7b0d51a03f25
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Owlbear_HasMet_Chasing(1) = True
#.   Global:
#.      - GOB_ChickenChase_State_PlayingChase = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear:86b0e5af-271c-edfe-4b6b-7b0d51a03f25
msgctxt "h9656d835g86d3g4e7egb544g436a113cb4cf"
msgid "Run! Get me!"
msgstr "도망쳐! 잡힌다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear
#. Speaker = Owlbear Cub
#. NodeID = 8a701006-69d0-95c3-6b91-48197dc5bb47
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear:8a701006-69d0-95c3-6b91-48197dc5bb47
msgctxt "h03cbc0ddg04a7g4705g9116g645631c30cb2"
msgid "New home...? Maybe."
msgstr "새로운 집이겠지...? 아마도."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear
#. Speaker = Player
#. NodeID = 8e9bc462-ba39-71e0-9d5a-ab1a5e2e4c47
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear:8e9bc462-ba39-71e0-9d5a-ab1a5e2e4c47
msgctxt "h28e28b66gb7fbg41c3gb938g70f72a28a764"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear
#. Speaker = Player
#. NodeID = 8ebdb7f2-93a2-bbb3-48b6-e228d47b8664
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - GOB_ChickenChase_Knows_ChaseRules = True
#.      - GOB_ChickenChase_State_BallOnField = True
#. TagRule: DRUID or RANGER
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear:8ebdb7f2-93a2-bbb3-48b6-e228d47b8664
msgctxt "hf4825920gbab1g40f5ga473g05856c074551"
msgid "They won't hurt you if you run to those posts."
msgstr "네가 골대까지 달려준다면 그들이 널 해치지 않을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear
#. Speaker = Narrator
#. NodeID = 8fdcbb8a-2107-bbb5-fc1d-0401d216ee2a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 7611fa51-4b1b-3d2c-a8a5-74c04d9db7fa_AnimalHandlingSuccess = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear:8fdcbb8a-2107-bbb5-fc1d-0401d216ee2a
msgctxt "h23241cb4g6cb5g47ddg80bega4bdea0198a8"
msgid ""
"*You notice a shiver run through his feathered coat - fear, a desperate "
"longing for the safety of his nest.*"
msgstr "*당신은 깃털 덮인 몸이 떨리는 것을 눈치챘습니다. 두려워하며, 둥지의 안전함을 갈망하고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear
#. Speaker = Narrator
#. NodeID = 94be6338-7fee-2564-fdd7-923c3d471dcc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_ChickenChase_Event_OwlbearAcquired = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear:94be6338-7fee-2564-fdd7-923c3d471dcc
msgctxt "h7a2c94c0gdbf7g41f2gbb75gf4226a06c2e8"
msgid "*He runs away. Only time will tell if he'll reappear.*"
msgstr "*녀석은 달아나 버렸습니다. 다시 보게 될지는 두고 봐야겠지요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear
#. Speaker = Owlbear Cub
#. NodeID = 96e34773-2b73-3ae5-7b2b-1bbb134cb249
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Owlbear_HasMet_NotChasing(1) = False
#.   Global:
#.      - GOB_ChickenChase_State_PlayingChase = False
#.   Tag:
#.      - PETPAL(1) = True
#. SetFlags:
#.   Dialog:
#.     - GOB_Owlbear_HasMet_NotChasing(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear:96e34773-2b73-3ae5-7b2b-1bbb134cb249
msgctxt "h0a97bd90g1c01g405dg95e7gcd5b0c8ea8de"
msgid "Mother gone. Hungry!"
msgstr "엄마가 죽었어. 배고파!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear
#. Speaker = Owlbear Cub
#. NodeID = 9c77ede9-e604-4528-5803-b3282334e686
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear:9c77ede9-e604-4528-5803-b3282334e686
msgctxt "ha6d7b0bfga2ffg43a9gac5eg643d68683c6a"
msgid "*Screech!*"
msgstr "*끼이익!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear
#. Speaker = Player
#. NodeID = 9e73c38f-8dfd-3162-8216-bd1958a2c4a9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear:9e73c38f-8dfd-3162-8216-bd1958a2c4a9
msgctxt "hcbf74d33g5848g44f2gb945g55feb4dea0f0"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear
#. Speaker = Owlbear Cub
#. NodeID = a1ba5ea3-8e4f-7991-9252-94ab78a54dea
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_ChickenChase_Event_OwlbearAcquired = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear:a1ba5ea3-8e4f-7991-9252-94ab78a54dea
msgctxt "h4ce68d40g3959g4be3gb120g81fb3f1c3311"
msgid "Got to get away from here first."
msgstr "먼저 여기서 벗어나야 돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear
#. Speaker = Player
#. NodeID = a7f0f83a-bae6-e867-187c-d87d8f6ec264
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_OwlbearCub_Event_InvitedToCamp = False
#. SetFlags:
#.   Global:
#.     - GOB_OwlbearCub_Event_InvitedToCamp = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear:a7f0f83a-bae6-e867-187c-d87d8f6ec264
msgctxt "hb4585124g4731g4515gac6agd55eccf07b1e"
msgid "<i>Beckon him closer.</i>"
msgstr "<i>그에게 가까이 오라고 손짓한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear
#. Speaker = Owlbear Cub
#. NodeID = aab4a4fb-55b1-3342-f956-2afb0b10a828
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Owlbear_HasMet_Chasing(1) = True
#.   Global:
#.      - GOB_ChickenChase_State_PlayingChase = True
#.   Local:
#.      - 7611fa51-4b1b-3d2c-a8a5-74c04d9db7fa_AnimalHandlingSuccess = False
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear:aab4a4fb-55b1-3342-f956-2afb0b10a828
msgctxt "h273a203bg97b1g4f50g9934g157887705590"
msgid "*Squawk!*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear
#. Speaker = Player
#. NodeID = ba0893c9-6a58-b967-26c4-bdff43565ccf
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 15
#. CheckFlags:
#.   Global:
#.      - GOB_ChickenChase_Knows_ChaseRules = True
#.      - GOB_ChickenChase_State_BallOnField = True
#.   Tag:
#.      - RANGER(1) = False
#.      - DRUID(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear:ba0893c9-6a58-b967-26c4-bdff43565ccf
msgctxt "hb693ab66ga108g4e81g915bg7ce57f633f12"
msgid "<i>Coax the cub toward the goalposts.</i>"
msgstr "<i>새끼를 달래서 골대로 유도한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear
#. Speaker = Player
#. NodeID = c05e06f7-7447-5d1e-c3b9-0f8c4b9fe03c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear:c05e06f7-7447-5d1e-c3b9-0f8c4b9fe03c
msgctxt "h7f27d155g54c8g4a19gabf7g178b2647b12d"
msgid "The goblins are responsible for your pain. Kill them."
msgstr "너의 고통은 고블린들 탓이야. 그들을 죽여."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear
#. Speaker = Narrator
#. NodeID = c15f6433-eab6-00a5-a398-bea919b0ed81
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_ChickenChase_State_AngeredOwlbear = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear:c15f6433-eab6-00a5-a398-bea919b0ed81
msgctxt "hcb63a8d6g512eg4442gb300g3d12d2c786bc"
msgid ""
"*The cub clicks his beak weakly - more scared than afraid. He has no fight "
"left in him.*"
msgstr "*새끼는 걱정스럽기보다는 겁에 질린 듯 부리를 약하게 쪼아댑니다. 싸움의 기운이 전혀 남아 있지 않습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear
#. Speaker = Owlbear Cub
#. NodeID = c38b866b-47c2-327e-ae14-02e49cd19bca
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_ChickenChase_Event_OwlbearAttack(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear:c38b866b-47c2-327e-ae14-02e49cd19bca
msgctxt "hb7ce7b45g381fg46f7gb4e1g8f83e5027edd"
msgid "Bite. Eat! Bite!"
msgstr "깨문다. 베어먹는다! 물어뜯는다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear
#. Speaker = Narrator
#. NodeID = cfe7a8a7-9e71-af68-574d-4effcd6febcc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 7611fa51-4b1b-3d2c-a8a5-74c04d9db7fa_AnimalHandlingSuccess = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear:cfe7a8a7-9e71-af68-574d-4effcd6febcc
msgctxt "h965ce074gc569g4d9fgbef5g71e5fed33a3b"
msgid ""
"*Its talons bite deep into the earth, every muscle trembling. You realise it "
"isn't afraid...*"
msgstr "*아울베어의 발톱이 땅을 깊숙이 파고들고, 모든 근육이 떨립니다. 당신은 그가 두려워하지 않는다는 것을 깨닫습니다...*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear
#. Speaker = Owlbear Cub
#. NodeID = dab0c6d9-f5d1-16f0-ed7d-165cea3948e7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Owlbear_HasMet_Chasing(1) = False
#.   Global:
#.      - GOB_ChickenChase_State_PlayingChase = True
#.   Tag:
#.      - PETPAL(1) = True
#. SetFlags:
#.   Dialog:
#.     - GOB_Owlbear_HasMet_Chasing(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear:dab0c6d9-f5d1-16f0-ed7d-165cea3948e7
msgctxt "hf0389c6dg0e34g4ae4g851dge47ff117bc3a"
msgid "Hurt me! Run! Where?"
msgstr "다친다! 도망쳐! 어디로?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear
#. Speaker = Owlbear Cub
#. NodeID = dab239b8-025b-cf46-1745-d2ebf8cb9d9a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Owlbear_HasMet_NotChasing(1) = True
#.   Global:
#.      - GOB_ChickenChase_State_PlayingChase = False
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear:dab239b8-025b-cf46-1745-d2ebf8cb9d9a
msgctxt "h6ff13678gb2e2g4084g94e0gfb0f84fddae3"
msgid "Go home. Cave. Mother!"
msgstr "집 갈래. 동굴. 엄마!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear
#. Speaker = Owlbear Cub
#. NodeID = ed56084e-b2fb-7db8-fb34-6e760cca72c5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_Owlbear_State_FailedAnimalHandling(1) = True
#.   Global:
#.     - GOB_ChickenChase_State_AngeredOwlbear = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear:ed56084e-b2fb-7db8-fb34-6e760cca72c5
msgctxt "h723322bcge5aag4271g8267g9b02065deeaa"
msgid "*Squawk!*"
msgstr "*꽤애액!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear
#. Speaker = Player
#. NodeID = edd6032f-cca5-df56-4acd-dcf09f49041c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_OwlbearCub_Event_InvitedToCamp = False
#. SetFlags:
#.   Global:
#.     - GOB_OwlbearCub_Event_InvitedToCamp = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear:edd6032f-cca5-df56-4acd-dcf09f49041c
msgctxt "hed469209g21bdg4dddgae73g30e1f437fdc0"
msgid "I have a camp. You're welcome there."
msgstr "나에게 야영지가 있어. 그곳에 가도 좋아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear
#. Speaker = Narrator
#. NodeID = f3bd5f13-69f5-ff6d-8978-ed8593070008
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 7611fa51-4b1b-3d2c-a8a5-74c04d9db7fa_AnimalHandlingSuccess = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear:f3bd5f13-69f5-ff6d-8978-ed8593070008
msgctxt "hb7b3e48bga8a9g4bc2g9cc2g0bcce08ae643"
msgid "*The cub tilts his head. He's considering it.*"
msgstr "*새끼가 고개를 갸우뚱합니다. 그는 고민하고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear
#. Speaker = Owlbear Cub
#. NodeID = fc863274-0cfa-866f-f74d-4dd6723f28c5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_Festivities_BallToldAboutGates(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_ChickenChase_Owlbear:fc863274-0cfa-866f-f74d-4dd6723f28c5
msgctxt "h9e460c92g5a1fg42bdg8b7cgf1e00bf03133"
msgid "Safe. There? Run!"
msgstr "저기. 안전해? 뛰어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Player
#. NodeID = 0911c47c-a807-561d-8a9d-43c94249e816
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:0911c47c-a807-561d-8a9d-43c94249e816
msgctxt "h21e7e741gbd21g4af0g92degc2fe4043842c"
msgid "<i>Keep quiet.</i>"
msgstr "<i>침묵을 유지한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Nightwarden Minthara
#. NodeID = 098510ad-77da-55de-cde8-96604dd41db6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:098510ad-77da-55de-cde8-96604dd41db6
msgctxt "hbfcdba06g576fg4972g9d34gb38cf6d16f87"
msgid ""
"Good. Marshalling the goblins is no simple matter, but my warband will be "
"ready to attack by next light."
msgstr "좋아. 고블린을 집결시키는 건 간단한 일이 아니지만, 다음 날이 밝으면 내 부대가 공격할 준비를 마칠 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Player
#. NodeID = 135915af-4448-c225-d8db-fc4bf2a19850
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_LOLTHDROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:135915af-4448-c225-d8db-fc4bf2a19850
msgctxt "h0afe4d21ga45dg4e0fg9f10g560b0d8c879d"
msgid "Absolute be damned - Lolth is our goddess, and you are a heretic."
msgstr "절대자 따위 집어치우라지 - 우리의 여신은 롤쓰님이시다. 넌 이단자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Player
#. NodeID = 135915af-4448-c225-d8db-fc4bf2a19850
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:135915af-4448-c225-d8db-fc4bf2a19850
msgctxt "hb98dea94g369ag4a13ga94dgafcabf662bb7"
msgid "The Absolute has nothing to do with it. I'm here to kill you."
msgstr "절대자는 아무 것도 못 할 거다. 내가 여기서 널 죽일 테니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Nightwarden Minthara
#. NodeID = 169541c3-a432-c2c7-a7f6-b8a77e0fc5a4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DUERGARDWARF(2) = True
#. TagRule: DUERGARDWARF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:169541c3-a432-c2c7-a7f6-b8a77e0fc5a4
msgctxt "h2bd5a90fg4f1ag42cag8bdag8dc7c27d7406"
msgid ""
"A duergar? Tell me, Sazza, did your misadventures take you to the Underdark?"
msgstr "듀에르가라니? 말해 봐라, 삿자. 잘못해서 언더다크까지 갔다 왔나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Nightwarden Minthara
#. NodeID = 1714148b-ae82-66c7-7ebf-25eb3a5b302f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DROWELF(2) = True
#. TagRule: DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:1714148b-ae82-66c7-7ebf-25eb3a5b302f
#, fuzzy
msgctxt "ha3c4e87ega919g4562gb58bg29b3cfb29a00"
msgid ""
"A drow? Tell me, Sazza, did your misadventures take you to the Underdark?"
msgstr "드로우라니? 말해 봐라, 삿자. 잘못해서 언더다크까지 갔다 왔나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Sazza
#. NodeID = 17ddc54d-f9e3-6897-b796-8ac81d476d25
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:17ddc54d-f9e3-6897-b796-8ac81d476d25
msgctxt "hde2c396bge66fg4540g8c9fga5e1d4e8e549"
msgid ""
"Nah. Can't be... they woz in the grove, hangin' around with the tieflin's."
msgstr "아녜요. 그럴 리가… 이들은 숲에서 티플링들과 어울려 놀고 있었다고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Nightwarden Minthara
#. NodeID = 1c4e82e4-4e67-01cd-664c-f1b69746bc0f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:1c4e82e4-4e67-01cd-664c-f1b69746bc0f
msgctxt "h4176c74agea06g41e1g887dga99d7f617efd"
msgid "Fine."
msgstr "좋아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Nightwarden Minthara
#. NodeID = 20294134-49d2-744f-9a2b-7bee93e729cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:20294134-49d2-744f-9a2b-7bee93e729cb
msgctxt "h7dfda26bg2d54g43ebg8c42gbdf292108047"
msgid "I will gather my warband - we will reach the grove by next light."
msgstr "내 부대를 소집하겠다. 다음날이 밝으면 숲에 도착해있을 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Player
#. NodeID = 20ad89c0-8686-e475-392a-a0da8de88e07
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_State_TooLowTieflings = True
#. SetFlags:
#.   Global:
#.     - GOB_DrowCommander_Event_ToldAboutDeaths = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:20ad89c0-8686-e475-392a-a0da8de88e07
msgctxt "h03136c2egfc93g4bcdgb532geb1e4c648793"
msgid "Many of the inhabitants of the grove are already dead."
msgstr "숲의 거주자들 다수가 이미 죽었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Nightwarden Minthara
#. NodeID = 22f159e3-5d25-9a0f-e20c-f3350034a0fa
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_Knows_LeaderNameDrow = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:22f159e3-5d25-9a0f-e20c-f3350034a0fa
msgctxt "h1036452agdd9dg4b71ga716g12df0f26332a"
msgid ""
"Return to the grove. When my raiding party approaches, throw open the gate "
"and signal me."
msgstr "숲으로 돌아가라. 내 습격대가 도착하면, 관문을 열고 내게 신호를 보내라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Sazza
#. NodeID = 2332b70e-9e2b-2f06-d979-32aa2b32beba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:2332b70e-9e2b-2f06-d979-32aa2b32beba
msgctxt "he823823ag90b1g4a2bg8740g6c689e3678a0"
msgid "Ah... well, the thing about that is... they sorta massacred us."
msgstr "아... 글쎄요, 그건 말이죠... 그들이 어쩌다 우릴 학살했어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Player
#. NodeID = 359579bc-7d21-bc2b-5401-15b6216f2cf1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - LOLTHDROWELF(2) = True
#. TagRule:
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:359579bc-7d21-bc2b-5401-15b6216f2cf1
msgctxt "h43505ac1g6756g4dc8g8d71g1f1bf52d7380"
msgid "You only have to <i>look</i> at me to know I'm your superior, wretch."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Sazza
#. NodeID = 3677baa3-e051-e3fb-4ce8-808947ad21ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:3677baa3-e051-e3fb-4ce8-808947ad21ad
msgctxt "h434b8abegc8ddg4da2g8ae9ged868af8add3"
msgid "I told ya! I was tryin' to follow orders best I could!"
msgstr "제가 말했잖아요! 전 최선을 다해 명령을 따르려고 했어요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Narrator
#. NodeID = 36ab9ad8-dad5-9a7f-e458-fe4a999442f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:36ab9ad8-dad5-9a7f-e458-fe4a999442f4
msgctxt "h38d34a2fgbc0fg4f4bg9a51gb11ea6acff6c"
msgid "*You feel a cold hand caress your mind as the drow appraises you.*"
msgstr "*드로우가 당신을 살펴보면서 차가운 손이 당신의 정신을 어루만지는 것이 느껴집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Player
#. NodeID = 3b2200d5-199c-7423-82b4-482c296ba37f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:3b2200d5-199c-7423-82b4-482c296ba37f
msgctxt "h0e6b6476g4dd0g4608g8bbegab6c8e0e2622"
msgid "I want no part of this."
msgstr "이 일에 동참하고 싶지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Player
#. NodeID = 3e058e73-4bac-b091-7518-672b2e2e8cd9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:3e058e73-4bac-b091-7518-672b2e2e8cd9
msgctxt "h4e09926fga3bdg4852g8aa6gea76b5609fbd"
msgid "She's telling the truth. She didn't know."
msgstr "그녀의 말은 사실이야. 그녀는 모르고 있었거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Nightwarden Minthara
#. NodeID = 401592ca-d539-d38d-ac05-7f32c5462b7e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:401592ca-d539-d38d-ac05-7f32c5462b7e
msgctxt "h8c18a447g084cg463dgb980gb704d0048843"
msgid "I will gather my warband, and reach the grove by next light."
msgstr "내 부대를 소집해서, 다음날이 밝을 때 숲에 도달하겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Nightwarden Minthara
#. NodeID = 433d8deb-b7f7-a815-cfef-82ee8db1ee3f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:433d8deb-b7f7-a815-cfef-82ee8db1ee3f
msgctxt "h251f07f6gf8b7g4070gb42fg904aaba65f6b"
msgid ""
"But we can still fight side by side. Together, we will destroy any who have "
"not died or fled."
msgstr "하지만 우린 아직 곁에 서서 싸울 수 있어. 같이 아직 죽거나 도망치지 않은 것들을 전부 부숴버리자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Nightwarden Minthara
#. NodeID = 47344777-abae-58e7-9de6-62515c774d09
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:47344777-abae-58e7-9de6-62515c774d09
msgctxt "h1eea6c9fg1cffg42c5gaa38g78a0a30fa640"
msgid "I presume you dealt with my prey, and massacred the rest?"
msgstr "내 사냥감을 처리하고, 나머지는 학살했겠지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Nightwarden Minthara
#. NodeID = 4ddaee93-cb69-941f-bbe3-221fdf82d445
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:4ddaee93-cb69-941f-bbe3-221fdf82d445
msgctxt "h4824e6dega45bg47d9g8af4gef5deb81f3bc"
msgid ""
"Through sheer luck, that pathetic worm has brought me the information I need."
msgstr "천운이 따라서, 그 한심한 벌레가 내게 필요한 정보를 주었다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Nightwarden Minthara
#. NodeID = 4eca899a-908b-8a14-d08c-a9457775f5f5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_CapturedGoblin_State_Spared = True
#.     - GOB_CapturedGoblin_Event_Resolved = True
#.   Quest:
#.     - DEN_CapturedGoblin.Saved(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:4eca899a-908b-8a14-d08c-a9457775f5f5
msgctxt "h1f184ad7g824bg4407g8f11g77399602e359"
msgid ""
"Silence, wretch. And remember - you owe your miserable life to this one."
msgstr "입 다물어, 꼴통아. 기억해라 - 너는 이 자에게 한심한 목숨을 빚졌다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Nightwarden Minthara
#. NodeID = 50b2bbf0-6d29-f3ed-3bbc-505c101f4254
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:50b2bbf0-6d29-f3ed-3bbc-505c101f4254
msgctxt "h925723b3g834fg4885gab09g02633995d829"
msgid "You <i>are</i> a True Soul."
msgstr "너는 참된 영혼이 <i>맞군</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Player
#. NodeID = 53b35721-5103-67ac-2272-5d482e6d1cef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:53b35721-5103-67ac-2272-5d482e6d1cef
msgctxt "h24d32a41g4032g46b7g82e7g0d5aa198b6ec"
msgid "I'll get it done."
msgstr "그렇게 하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Nightwarden Minthara
#. NodeID = 53ce7f45-5f80-c142-8124-6ab3b8cd81cf
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_DrowCommander_Knows_Mission(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:53ce7f45-5f80-c142-8124-6ab3b8cd81cf
msgctxt "h7ad9feecgeef1g4072gab36g32f079a9bef9"
msgid ""
"Take care of it <i>quickly</i>. You are needed here, and my patience wears "
"thin."
msgstr "<i>빨리</i> 처리해라. 이곳에는 네가 필요하고, 내 인내심은 약해지고 있으니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Player
#. NodeID = 59493a95-0acd-0d88-20a1-803fb674ffe4
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_LOLTHDROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:59493a95-0acd-0d88-20a1-803fb674ffe4
msgctxt "h96588aabg0ef5g4b3fg89b9gb206e2c87698"
msgid "You turned from Lolth for this Absolute. For that, you die."
msgstr "절대자 따위를 섬긴다고 롤쓰님을 저버렸군. 죽어라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Player
#. NodeID = 59493a95-0acd-0d88-20a1-803fb674ffe4
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:59493a95-0acd-0d88-20a1-803fb674ffe4
msgctxt "hd8169e0eg0fb9g4ee5gb317ge78982863e0e"
msgid "You misunderstand. I'm here to slaughter <i>you</i>."
msgstr "잘못 이해한 것 같은데. <i>널</i> 죽이려고 여기 온 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Nightwarden Minthara
#. NodeID = 5991d1cd-c083-53cd-b1e9-8f1d503c15d2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:5991d1cd-c083-53cd-b1e9-8f1d503c15d2
msgctxt "hf678dcdfg7344g4e62gb520gfb720b033718"
msgid ""
"You are honoured to serve a cause - a <i>god</i>. What greater reward could "
"there be?"
msgstr "대의, 즉 <i>신</i>을 따르는 것만으로도 영광스러운 일이다. 이보다 더 큰 보상이 뭐가 있겠나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Player
#. NodeID = 5a50f354-29d4-594b-a644-17d60b8e57f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:5a50f354-29d4-594b-a644-17d60b8e57f8
msgctxt "h9aab4689g25c5g440dgbe8cg183fe938ed07"
msgid "And I'm happy to do it - for a price."
msgstr "기꺼이 할게. 보상만 준다면."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Sazza
#. NodeID = 5c0a7541-c0a8-dd5f-79b2-7b26924a4ad6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_CapturedGoblin_State_Executed = True
#.     - GOB_CapturedGoblin_Event_Resolved = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:5c0a7541-c0a8-dd5f-79b2-7b26924a4ad6
msgctxt "hcfdbaffdg18f3g4650g8716gdc80df6ae09e"
msgid "You coulda told me who you woz!"
msgstr "네가 누군지 내게 말해줄 수도 있었잖아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Nightwarden Minthara
#. NodeID = 5c874bd1-7a34-efc3-6c5f-66142d98293f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:5c874bd1-7a34-efc3-6c5f-66142d98293f
msgctxt "hf45637fag5ce6g4476ga036gaf2c719f22cf"
msgid "We are servants of the one true <i>god</i>, not mercenaries."
msgstr "우리는 용병이 아니라, 진정한 <i>유일신</i>의 종복이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Nightwarden Minthara
#. NodeID = 6588043b-0f34-6fdb-20cc-aae3f298422f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:6588043b-0f34-6fdb-20cc-aae3f298422f
msgctxt "hfcbb4014g7657g407dga15cgeeccec955b84"
msgid ""
"The Absolute brought you here for a reason - to throw open those gates and "
"crush our enemies."
msgstr "절대자님이 너를 여기 인도하신 이유도, 성문을 열어젖히고 우리의 적들을 짓밟기 위해서일 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Player
#. NodeID = 68a5ddef-aec9-bb35-ddab-c1bb61168a19
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_Knows_Lockdown = True
#. SetFlags:
#.   Global:
#.     - GOB_DrowCommander_Event_ToldAboutLockdown = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:68a5ddef-aec9-bb35-ddab-c1bb61168a19
msgctxt "hced5a51bg376cg4d5dg822cg6feae9f5362a"
msgid "There's a problem - the grove is sealed by a druid ritual."
msgstr "문제가 있다. 드루이드 의식 때문에 숲이 봉쇄되었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Nightwarden Minthara
#. NodeID = 6dd0bd63-5856-b566-1b97-cce166b72b8c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:6dd0bd63-5856-b566-1b97-cce166b72b8c
msgctxt "hc8ac78e9g59a4g49e0g8af1gc777164bdc20"
msgid "A liar as well as a fool? I hope you're at least <i>digestible</i>."
msgstr "멍청이일 뿐만 아니라 거짓말쟁이였나? 네가 적어도 <i>소화는 잘 되길</i> 바라마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Player
#. NodeID = 6e016736-cbb4-0932-4779-794769c07d15
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:6e016736-cbb4-0932-4779-794769c07d15
msgctxt "h9e38bc61g3636g4df8gbf88gb0acfd5639e8"
msgid "You're right. Serving the Absolute is its own reward."
msgstr "맞는 말이야. 절대자님을 섬기는 것 자체가 보상이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Sazza
#. NodeID = 70313269-bc32-5037-4971-c1524a255ad7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:70313269-bc32-5037-4971-c1524a255ad7
msgctxt "hee04e9cag97ccg403bg881dg4f44ee13a5e2"
msgid ""
"No! I mucked up, I'm sorry! But I didn't know who they woz... they didn't "
"tell me nothin'!"
msgstr "안 돼! 제가 실수했습니다, 죄송해요! 하지만 전 그들이 누군지 몰랐어요... 그들이 아무 말도 안해줬어요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Sazza
#. NodeID = 779b792b-c1c3-20c2-1dc1-0c0b42f8d5e1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:779b792b-c1c3-20c2-1dc1-0c0b42f8d5e1
msgctxt "hc464ca2bg5e6cg487bg8fdbg6a60f480adc1"
msgid ""
"And then the Absolute answered my prayers - sent a True Soul to save me!"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Narrator
#. NodeID = 77b5488b-5e2d-6da5-d890-166746d7f592
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:77b5488b-5e2d-6da5-d890-166746d7f592
msgctxt "h704768eag73d5g4b89g87f5g32d2aea5bc42"
msgid ""
"*On the other hand, participating in the slaughter as she asks may be the "
"perfect way to earn her trust, and access to the cult's inner circle.*"
msgstr "*한편, 이 여자가 요구하는 대로 학살에 참여해 신뢰를 얻는다면, 교단 내부의 공동체로 수월하게 잠입할 수 있을 겁니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Sazza
#. NodeID = 7d4496c6-99a9-ea93-775d-ae5a94c38dd3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_DrowCommander_HasMet(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:7d4496c6-99a9-ea93-775d-ae5a94c38dd3
msgctxt "h25e47462g0a22g4c42g8155gbcd796fa68ae"
msgid ""
"Mistress! It's me, yer loyal servant, Sazza. I'm back - an' I brought a "
"friend."
msgstr "마님! 저예요, 당신의 충성스런 수하 삿자가 친구를 데리고 돌아왔어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Nightwarden Minthara
#. NodeID = 7f556b33-da9a-ff70-6d11-db23853513a1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_DrowCommander_Event_RaidersSortie = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:7f556b33-da9a-ff70-6d11-db23853513a1
msgctxt "hed5d59ecg57eeg4edbg8795g1be4c40a6ab2"
msgid ""
"Once we are in position, we will wait for your signal, and then we will "
"break them all."
msgstr "진영을 갖추면 네 신호를 기다릴게. 그다음엔 저놈들을 박살 내는 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Nightwarden Minthara
#. NodeID = 7fd0b3d1-e58a-23a7-1e4d-3c89199e6279
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_DrowCommander_Event_RaidersSortie = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:7fd0b3d1-e58a-23a7-1e4d-3c89199e6279
msgctxt "hf01a563cg2e16g4620gbc3agf19034e9b937"
msgid "The Absolute will reward us."
msgstr "절대자님께서 우리에게 보상을 내려주실 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Nightwarden Minthara
#. NodeID = 834716d5-090d-a0cf-84d1-ecaf7eb7e0de
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:834716d5-090d-a0cf-84d1-ecaf7eb7e0de
msgctxt "h69b64800gbc49g4922g8475g3ab7b7f796fc"
msgid ""
"You must make your way inside. Once I am in position, on your signal, we "
"<i>break</i> them."
msgstr "네가 안으로 가는 길을 확보해야 한다. 내가 자리를 잡고 나서, 네가 신호를 보내면, 우리가 적을 <i>쳐부수는</i> 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Nightwarden Minthara
#. NodeID = 89d41b8f-4299-b6a3-773d-40c5922bf701
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - DEN_Conflict.HeardAboutAoD(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:89d41b8f-4299-b6a3-773d-40c5922bf701
msgctxt "hc430a5bagc89ag497eg9011g31953496625a"
msgid ""
"And it seems that the inhabitants of the grove trust you - we can use that "
"against them."
msgstr "그리고 숲의 거주자들은 너를 신뢰하는 것 같으니, 그들과 맞설 때 그 점을 이용하면 되겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Nightwarden Minthara
#. NodeID = 8c63f8e6-71f2-f057-b1e9-e48163800b1a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:8c63f8e6-71f2-f057-b1e9-e48163800b1a
msgctxt "h9c91dafeg6e57g46d6gbd1ag95ad4ce779f4"
msgid "You would <i>dare</i>...? Guards - to me!"
msgstr "네가 <i>감히</i>...? 경비대, 내게로!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Nightwarden Minthara
#. NodeID = 9384f8a5-c466-9f12-15d1-efc2f089137a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:9384f8a5-c466-9f12-15d1-efc2f089137a
msgctxt "hbe49a48ag2fb0g4b10g927fg4dc701513204"
msgid "And it will be your last. My spiders are hungry, little one..."
msgstr "그리고 이게 네 최후가 될 거다. 내 거미들이 배고프단다, 꼬마야..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Nightwarden Minthara
#. NodeID = 96b021a6-c9d5-b42a-7d1d-62c66914bdcc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:96b021a6-c9d5-b42a-7d1d-62c66914bdcc
msgctxt "h02dafbdeg090bg42afg94e9g145bbce2cff8"
msgid ""
"I do not intend to lead a suicidal charge. The goblins are expendable; I am "
"not."
msgstr "자살 돌격을 주도할 생각은 없다. 고블린은 소모품이지만, 나는 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Player
#. NodeID = 9a8b3321-94e4-618e-8c53-c5bef8644991
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:9a8b3321-94e4-618e-8c53-c5bef8644991
msgctxt "h84e3e5cag30aag4607g9e81gd43bffef7fe9"
msgid "All right. Expect me at the grove."
msgstr "알았어. 숲에서 내 활약을 기대해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Nightwarden Minthara
#. NodeID = 9d2cb5eb-1c1d-c93d-bca5-f293e6b60525
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_DrowCommander_Event_RaidersSortie = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:9d2cb5eb-1c1d-c93d-bca5-f293e6b60525
msgctxt "heeb43acbg9be2g4b75gaf6fgd135040812a2"
msgid ""
"Excellent. When you give the signal, we will break them. The Absolute will "
"reward us."
msgstr "훌륭하군. 네가 신호를 주면, 우리가 그들을 처부수겠다. 절대자님께서 우리에게 보상을 내려주실 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Player
#. NodeID = a04f4512-cac7-5abf-9ad5-8f2814b391d2
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:a04f4512-cac7-5abf-9ad5-8f2814b391d2
msgctxt "hdbee8017gdb35g457fga6dag1d54561743ee"
msgid "I won't be much use to the cause if I'm destitute."
msgstr "가난한 상황에서 대의는 쓸데없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Sazza
#. NodeID = a477ee34-b09f-a5d4-0073-a6dc41d237f6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_Torturers_State_KnowDen = True
#.   Quest:
#.     - DEN_Conflict_SUB_AoD.SazzaToldMinthara(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:a477ee34-b09f-a5d4-0073-a6dc41d237f6
msgctxt "hcdacee67g1864g42f8g9eeag6092cf1ee6db"
msgid ""
"It's past the bridge, to the east! Big ol' gate, covered in ivy! Don't hurt "
"me, mistress. Please!"
msgstr "다리를 지나 동쪽에 있어요! 덩굴로 뒤덮인 큰 관문이에요! 해치지 말아주세요, 마님. 제발요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Nightwarden Minthara
#. NodeID = a874d1cd-22ac-425d-c5c0-802cc02081f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:a874d1cd-22ac-425d-c5c0-802cc02081f8
msgctxt "h45ee6456g3ef8g4d58g8bbfgc8ef8c4d00dc"
msgid "Kill our enemies, and <i>take</i> what you need."
msgstr "우리의 적들을 죽이면, 네가 원하는 것을 <i>챙길</i> 수 있다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Narrator
#. NodeID = ad8a3c48-d612-96f2-26d9-8374a8446625
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:ad8a3c48-d612-96f2-26d9-8374a8446625
msgctxt "hf66ef93dgc555g46b2g9d5bg38a4ec5249ff"
msgid ""
"*Killing the drow here would spare them, but it might be better to face her "
"warband at the grove itself, on familiar ground.*"
msgstr ""
"*여기서 이 드로우를 죽여 모두를 살릴 수도 있지만, 익숙한 전장인 숲으로 끌어들여 전체 군대를 상대하는 편이 나을지도 모릅니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Nightwarden Minthara
#. NodeID = adbd790d-d9c8-490c-dbaa-fa991a61f867
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:adbd790d-d9c8-490c-dbaa-fa991a61f867
msgctxt "hd4f45425gdb6ag4e6ega9f3ge74f9a9a4fd6"
msgid ""
"Undercover, no doubt. Carrying out the Absolute's will. Oh, Sazza - you have "
"made a <i>grave</i> error."
msgstr "분명 위장 잠입이겠지. 절대자님의 뜻을 실행하려 한 거야. 오, 삿자 - 너는 <i>치명적인</i> 실수를 범했구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Nightwarden Minthara
#. NodeID = bc2d3a71-4cfe-10fb-e58f-4b9db49a73f7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:bc2d3a71-4cfe-10fb-e58f-4b9db49a73f7
msgctxt "h8009e3abg1398g4160g825cg41209320e782"
msgid ""
"Oh dear. Your prisoner is one of the Absolute's favourites, Sazza. A True "
"Soul."
msgstr "오, 이런. 네 포로는 절대자님의 총아 중 한 명이구나, 삿자. 참된 영혼이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Sazza
#. NodeID = bec128d3-5ee4-d0c4-faaf-68d044495534
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:bec128d3-5ee4-d0c4-faaf-68d044495534
msgctxt "h12fe8055g240dg4920gae22ged11a97f10c1"
msgid ""
"I got myself nabbed though; ended up all snug in a cage instead of smashed. "
"I'm wily like that."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Nightwarden Minthara
#. NodeID = cc0b8621-59b5-3c20-b505-7ae9bbb2c234
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:cc0b8621-59b5-3c20-b505-7ae9bbb2c234
msgctxt "hdf3f59b6g8dadg46a6g9a40g616b5fde094d"
msgid "How thoughtful. And where did you find this friend?"
msgstr "사려 깊기도 해라. 이 친구는 어디서 찾았지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Nightwarden Minthara
#. NodeID = cd0c0183-46fe-e57f-e173-728ed6f366cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:cd0c0183-46fe-e57f-e173-728ed6f366cf
msgctxt "h5fb58cbcga0cbg4043g8573g25ce663995c7"
msgid ""
"...but before they feast, tell me where that grove is, and I may yet spare "
"your life."
msgstr "...하지만 그들이 포식하기 전에, 그 숲이 어디 있는지 말하면 목숨은 살려줄 수 있다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Nightwarden Minthara
#. NodeID = cd8657ed-48f6-3319-659c-12c473479201
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:cd8657ed-48f6-3319-659c-12c473479201
msgctxt "h92d392e5g20f7g41eeg9259gffe01ea15a4a"
msgid "You have a part to play in this slaughter."
msgstr "네가 이 학살에서 맡을 역할이 있다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Narrator
#. NodeID = d0dbe3da-6f0e-358d-b981-5bfdf2501078
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:d0dbe3da-6f0e-358d-b981-5bfdf2501078
msgctxt "h706c0d0fg4c92g4bffg8d64g3015b6bb3414"
msgid "*The fate of the grove's inhabitants hangs in the balance.*"
msgstr "*숲 주민들의 운명이 저울 위에 매달려 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Player
#. NodeID = d3bb8596-6b7a-1d1c-c496-b47f99a04408
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:d3bb8596-6b7a-1d1c-c496-b47f99a04408
msgctxt "hb500fa39g04fag4bd6ga0cdgf36d032834fe"
msgid "Gold, and lots of it."
msgstr "금화가 있지. 엄청나게 많은 금화가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Sazza
#. NodeID = d41bd143-8cd8-f342-cf2f-10209d0fd365
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_DrowCommander_Event_CompromisedDen(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:d41bd143-8cd8-f342-cf2f-10209d0fd365
msgctxt "he1198aa2g087bg4733ga97agbc7053864290"
msgid ""
"They woz in some rickety druid grove! Mostly full of tieflin's, but them "
"intruders you're after were hidin' out there!"
msgstr ""
"그들은 상황이 심각한 드루이드 숲에 숨어 있었어요! 대부분 티플링들로 가득 차 있지만, 당신이 쫓는 침입자들이 거기 숨어 있더군요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Sazza
#. NodeID = dae6b69d-7fc0-1a85-fbd7-6aa61bcaa475
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_CapturedGoblin_State_Executed = True
#.     - GOB_CapturedGoblin_Event_Resolved = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:dae6b69d-7fc0-1a85-fbd7-6aa61bcaa475
msgctxt "h384a0107g6152g4ea0g93d4g06bfa5c820b9"
msgid "It ain't true! Them's the bloody liars!"
msgstr "그 말은 사실이 아닙니다! 이놈들은 개같은 거짓말쟁이예요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Nightwarden Minthara
#. NodeID = dd18f8a9-7b42-0ebe-8bb4-39508bb7605b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:dd18f8a9-7b42-0ebe-8bb4-39508bb7605b
msgctxt "h63137458g354dg4e87gbdddgcd62a0ca7ef6"
msgid "I will not hurt you. My spiders will have that pleasure."
msgstr "나는 널 해치지 않으마. 내 거미들이 그 기쁨을 누릴 테니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Sazza
#. NodeID = de91c77e-9bfa-f51b-4d2f-a81b4ac11dbc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_DrowCommander_Event_CapturedLeaves(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:de91c77e-9bfa-f51b-4d2f-a81b4ac11dbc
msgctxt "h55de2e42gf3a3g4bafga02cg33698fd8ae62"
msgid "I won't cause any more trouble - I <i>swears</i> it."
msgstr "더는 폐 끼치지 않을게요. <i>맹세해요</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Nightwarden Minthara
#. NodeID = dfaec315-1a85-edd4-9729-0bce2ce65fc7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:dfaec315-1a85-edd4-9729-0bce2ce65fc7
msgctxt "h4988c32bgd78cg4676ga074gbaa453a3724d"
msgid ""
"Their god is weak. Roots and branches will not save them from the Absolute's "
"fury."
msgstr "그놈들의 신은 나약하다. 뿌리와 가지 따위로 절대자님의 분노를 막을 수는 없다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Player
#. NodeID = e1ea878f-9e4c-0a1c-01ea-a251aa36275b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:e1ea878f-9e4c-0a1c-01ea-a251aa36275b
msgctxt "hb6f3b36cg2ba4g4b16gba33g4deca046e04f"
msgid "I explained everything to her. She's just too stupid to understand."
msgstr "나는 삿자에게 모든 걸 설명해줬어. 단지 그녀가 이해하지 못할 정도로 멍청했던 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Nightwarden Minthara
#. NodeID = e7743a65-b49e-3552-98bb-5c972a8bc000
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:e7743a65-b49e-3552-98bb-5c972a8bc000
msgctxt "h837ba7bag4780g4aacgb371g0ac7ef80e080"
msgid "Praise be to Her!"
msgstr "그분께 찬사를!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Player
#. NodeID = ec18b932-49e5-2e93-de93-40956db7b8c2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:ec18b932-49e5-2e93-de93-40956db7b8c2
msgctxt "hd75746b8g4bbcg4eb9g83a4g8a717c57ac1f"
msgid "I have another matter to take care of first."
msgstr "나는 우선 다른 일을 처리해야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Sazza
#. NodeID = ede1e8c4-33fe-6d29-e726-6e973772b458
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Checkpoint_State_PretendedToBeTrueSouls = False
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:ede1e8c4-33fe-6d29-e726-6e973772b458
msgctxt "h72c5017cgdb26g4eb6ga558g1f494364c4bc"
msgid ""
"But this mug helped me to escape. I say we stick a few holes in him... show "
"how grateful we are."
msgstr "하지만 이 얼간이 덕분에 탈출할 수 있었죠. 이놈에게 구멍을 몇 개 내서… 우리가 얼마나 감사한지 보여주자고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Sazza
#. NodeID = ede1e8c4-33fe-6d29-e726-6e973772b458
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Checkpoint_State_PretendedToBeTrueSouls = False
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:ede1e8c4-33fe-6d29-e726-6e973772b458
msgctxt "hf11ebb3ag7e10g4ceeg9763g0b4b51c92ea9"
msgid ""
"This mug helped me to escape though. I say we stick a few holes in her... "
"show how grateful we are."
msgstr "하지만 이 얼간이 덕분에 탈출할 수 있었죠. 이년에게 구멍을 몇 개 내서… 우리가 얼마나 감사한지 보여주자고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Sazza
#. NodeID = ede1e8c4-33fe-6d29-e726-6e973772b458
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Checkpoint_State_PretendedToBeTrueSouls = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:ede1e8c4-33fe-6d29-e726-6e973772b458
msgctxt "hd3246dfcg5c6fg456agab12g16505c317cd8"
msgid ""
"This mug helped me escape though. I say we stick a few holes in them... show "
"how grateful we are."
msgstr "하지만 이 얼간이 덕분에 탈출할 수 있었죠. 이들에게 구멍을 몇 개 내서… 우리가 얼마나 감사한지 보여주자고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Nightwarden Minthara
#. NodeID = f51498f4-59be-36d7-e96b-60625228d197
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:f51498f4-59be-36d7-e96b-60625228d197
msgctxt "h84a235aeg8d02g49c6gbaf1g73a9340639e4"
msgid "You started the slaughter without me? How selfish."
msgstr "나 없이 학살을 시작하려고? 정말 이기적이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog
#. Speaker = Sazza
#. NodeID = f71b5002-02c1-7ed4-5eb0-f916ebb6384a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_DrowCommander_Event_CapturedLeaves(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowAndCaptured_ThreeWayDialog:f71b5002-02c1-7ed4-5eb0-f916ebb6384a
msgctxt "h8cc0f665g5c4fg49dbg88adgbce3c196754f"
msgid "Somebody help!"
msgstr "누가 도와줘!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 00c9ccab-e025-0636-32e9-cf11dea564ce
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_DrowCommander_Event_AskedToTorture(1) = True
#.   Global:
#.     - GOB_DrowCommander_Event_GoTorturePrisoner = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:00c9ccab-e025-0636-32e9-cf11dea564ce
msgctxt "h11d884d8gb35bg4a92gb01fg790af567d686"
msgid "Excellent - be sure not to kill him before he talks."
msgstr "훌륭해, 그가 자백하기전에는 절대 죽이지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Narrator
#. NodeID = 02bc97d9-61a3-5aa5-8f2f-9fe4b8ce015e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:02bc97d9-61a3-5aa5-8f2f-9fe4b8ce015e
msgctxt "hae725ddeg7a9bg49e2g933bg020f8f667a78"
msgid ""
"*The drow's mind closes around yours, her bloodlust like needles in your "
"skull.*"
msgstr "*이 드로우의 정신이 당신의 두개골을 바늘로 찌르는 듯한 혈기로 당신의 주위를 감싸고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 02f1740a-3402-aa50-21f6-8d7399af2aec
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_DrowCommander_Event_Disappointed(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:02f1740a-3402-aa50-21f6-8d7399af2aec
msgctxt "h216f0f42gd5aag4177g9229g37f33dbaad53"
msgid ""
"I trust you have cleared your mind? I hunger for battle. We must find the "
"sanctuary."
msgstr "생각을 정리했겠지? 나는 전투에 굶주렸다. 우리는 그 안식처를 찾아야 한다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 036b0de9-7b46-7cf0-62f6-8089f520df0b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:036b0de9-7b46-7cf0-62f6-8089f520df0b
msgctxt "hc0c5939eg73d7g4955g9406gfc35cfa36666"
msgid "<i>Allow her to read your thoughts.</i>"
msgstr "<i>그녀가 생각을 읽도록 내버려둔다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 03b97240-54bf-aeeb-157a-980c0d2126e3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_State_TooLowTieflings = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:03b97240-54bf-aeeb-157a-980c0d2126e3
msgctxt "hb3119939g4707g40c8gb41egae85e991b568"
msgid ""
"<i>Even with the grove's numbers depleted, dealing with her there may be "
"safer than fighting here.</i>"
msgstr "<i>숲의 인원이 고갈된 상태긴 하지만, 이곳에서 싸우는 것보다 그곳에서 그녀를 상대하는 것이 더 안전할 수 있다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Lae'zel
#. NodeID = 051a038a-3b5f-5576-31d8-dfca1891e95e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:051a038a-3b5f-5576-31d8-dfca1891e95e
msgctxt "hd1119950ge77fg4509ga75aga46ca6826648"
msgid "You'll think of no better, I assure you."
msgstr "더 좋은 방법은 생각 못할걸. 보장할게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Narrator
#. NodeID = 055e6c10-6725-ee1f-7bba-948f68d068f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:055e6c10-6725-ee1f-7bba-948f68d068f1
msgctxt "h8d00127dg71f1g4eb9ga460g27562849f9d2"
msgid ""
"*One of those the voice spoke of. One of the Chosen. The vision fades "
"away...*"
msgstr "*그 목소리가 말한 자들 중 하나입니다. 선택받은 자들 중 하나입니다. 환영이 사라집니다...*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 05e9d3d7-e099-b3fe-642f-9df9aa73fd63
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_Knows_Lockdown = True
#. SetFlags:
#.   Global:
#.     - GOB_DrowCommander_Event_ToldAboutLockdown = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:05e9d3d7-e099-b3fe-642f-9df9aa73fd63
msgctxt "h9b1162e2g0c5eg4291g9072g2e158b2e68e5"
msgid ""
"I visited his grove - but the druids there have cast a protective spell over "
"the place."
msgstr "그의 숲을 방문했었는데, 거기 드루이드들이 그 곳을 보호하는 주문을 시전하고 있었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 0739c298-cd24-b623-4ba8-94cdfc952c5c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:0739c298-cd24-b623-4ba8-94cdfc952c5c
msgctxt "he250c956g216dg43b8g88e6g35e3a9fac98b"
msgid "I will gather my warband and reach the grove by next light."
msgstr "내 부대를 소집해서 다음날이 밝을 때 숲에 도달하겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 07dd1892-64a3-fe13-397f-10d3f87712b9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:07dd1892-64a3-fe13-397f-10d3f87712b9
msgctxt "h33b68c4dg6020g45cfgbb96g7db073098ba2"
msgid "One. We captured a human who knows exactly where it is."
msgstr "하나 있지. 우리는 그곳이 정확히 어디에 있는지 알고 있는 인간 한 놈을 생포했다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 0987acc6-7e82-7879-3579-4b7507327c1e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_Knows_Lockdown = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:0987acc6-7e82-7879-3579-4b7507327c1e
msgctxt "h2fc67969ga99ag41dcg9425g224f03dc7cbf"
msgid ""
"<i>The druids' magic protects the grove, but she may be able to break "
"through.</i>"
msgstr "<i>드루이드의 마법이 숲을 보호하지만, 그녀가 돌파할 수 있을지도 모른다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 0a9425bd-431b-aa51-cd27-cf5ec80bea5f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_DrowCommander_Knows_DrowLeader = True
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule: PALADIN_ANCIENTS
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:0a9425bd-431b-aa51-cd27-cf5ec80bea5f
msgctxt "ha09e19ddg84b4g4516g905fgf11a4ed0ede6"
msgid "Your hunt would desecrate a sacred place - it ends here. As do you."
msgstr "너의 사냥은 신성한 장소를 더럽히는 것이니 여기서 끝난다. 너도 마찬가지다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 0a9425bd-431b-aa51-cd27-cf5ec80bea5f
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_DrowCommander_Knows_DrowLeader = True
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule: PALADIN_DEVOTION
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:0a9425bd-431b-aa51-cd27-cf5ec80bea5f
msgctxt "h153407e2g68ecg49a7gaa1dg34e179bbdc75"
msgid "Your fervour is impressive, but I'm afraid your hunt ends here."
msgstr "너의 열정은 인상적이지만, 안타깝게도 너의 사냥은 여기서 끝난다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 0a9425bd-431b-aa51-cd27-cf5ec80bea5f
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_DrowCommander_Knows_DrowLeader = True
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule: PALADIN_VENGEANCE and NOT_FOR_EA
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:0a9425bd-431b-aa51-cd27-cf5ec80bea5f
msgctxt "hbf334cf8g64e9g4285g9153g6b74e926056b"
msgid "Let me sate your appetite - you die here, True Soul."
msgstr "너의 식욕을 채워주마. 너는 여기서 죽는다, 참된 영혼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 0a9425bd-431b-aa51-cd27-cf5ec80bea5f
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_DrowCommander_Knows_DrowLeader = True
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule: OATHBREAKER
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:0a9425bd-431b-aa51-cd27-cf5ec80bea5f
msgctxt "h663c87b4g5022g4e05g90f0gbf66bfea266f"
msgid "You are too beholden to zealotry, True Soul. I must end your hunt here."
msgstr "넌 너무 광신에 사로잡혀 있다, 참된 영혼. 네 사냥은 여기서 끝내 주겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 0af01b7b-d6cd-be63-cc38-0d4d94d34cb7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_DrowCommander_DenouncedLolth(1) = True
#.   Tag:
#.      - LOLTHDROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:0af01b7b-d6cd-be63-cc38-0d4d94d34cb7
msgctxt "h8b4b344fg9e19g46aagaca7ge86e335219e9"
msgid "You denounce Lolth? Heretic - I'll kill you!"
msgstr "롤쓰님을 저버렸군? 이단자 놈, 죽여주마!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 0b09032d-145f-1394-f7eb-0ccb2b0de4ac
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_Knows_Lockdown = True
#. SetFlags:
#.   Global:
#.     - GOB_DrowCommander_Event_ToldAboutLockdown = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:0b09032d-145f-1394-f7eb-0ccb2b0de4ac
msgctxt "h86e0f109g5568g4152g9987g3bc6d728a3f3"
msgid ""
"There's no way inside - the druids have performed a ritual to seal the place."
msgstr "거긴 못 들어가 - 드루이드들이 입구를 봉인하는 의식을 치렀거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 0b74ed38-e54f-1f07-9460-4c20f06e263f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:0b74ed38-e54f-1f07-9460-4c20f06e263f
msgctxt "hdfc8f390g7312g4082g8707ge5ca077a54d4"
msgid "I have other business to attend to."
msgstr "해야 하는 다른 일이 있다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 0bcf9d89-14d3-4270-fef8-186ccb3aed07
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_DrowCommander_Knows_Mission(1) = True
#.   Global:
#.      - GOB_DrowCommander_State_ReadyToGo = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:0bcf9d89-14d3-4270-fef8-186ccb3aed07
msgctxt "hace04a87g23edg414ega40dg0e56495be15e"
msgid "It is time to continue the hunt, True Soul. I hunger for battle."
msgstr "사냥을 계속할 시간이다, 참된 영혼. 난 전투에 굶주렸다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 0bdf7a4c-d27b-eade-32f2-3ccb6be987c3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:0bdf7a4c-d27b-eade-32f2-3ccb6be987c3
msgctxt "hbb37c90fg255bg4234gb827g586ae28f016e"
msgid "And you allowed them to do this? You were ordered to expose them."
msgstr "그리고 너는 그렇게 하도록 내버려 뒀고? 그들을 노출시키도록 명령 받았을 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 0bee08c9-0c5b-50cd-c996-4beec8259973
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:0bee08c9-0c5b-50cd-c996-4beec8259973
msgctxt "h1491980ag4ecag4db4ga893gf5e687e4cb5f"
msgid ""
"<i>If she finds the grove, everyone there will die. You need to throw her "
"off the trail.</i>"
msgstr "<i>그녀가 숲을 찾아내면, 그곳에 있는 모두가 죽을 것이다. 그녀의 추적을 끊어야 한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 0cf0d818-1130-b33a-6642-cbea5b6f6341
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_DrowCommander_Knows_CommandingGoblins = False
#. SetFlags:
#.   Global:
#.     - GOB_DrowCommander_Knows_CommandingGoblins = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:0cf0d818-1130-b33a-6642-cbea5b6f6341
msgctxt "h8879beb3gcd01g4e7eg914ag983635718f6a"
msgid "How did a drow come to be commanding a tribe of goblins?"
msgstr "어쩌다가 드로우가 고블린 부족을 지휘하게 된 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 0de56881-b4d6-3b93-07ca-80b32b1a7d94
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:0de56881-b4d6-3b93-07ca-80b32b1a7d94
msgctxt "hc7a736f7ge581g48c5g9ca6g9785fc1ace77"
msgid "Interesting. What do you know of this druid?"
msgstr "흥미롭군. 그 드루이드에 대해 무엇을 알고 있나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 0e8daf55-1caa-d753-ac30-d063affe509a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_DrowCommander_Knows_CommandingGoblins = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:0e8daf55-1caa-d753-ac30-d063affe509a
msgctxt "h629442b5g38cdg47c7gb917g44bc6082c26d"
msgid ""
"This tribe is mine to command. If you have business here, then you report to "
"me."
msgstr "이 부족은 내가 지휘한다. 이곳에 일이 있으면, 내게 보고해라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 0ec07d9e-c61c-ffb4-303e-6a9cd4d83e33
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_Knows_LeaderNameDrow = True
#.   Quest:
#.     - DEN_Conflict.HeardAboutAoD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:0ec07d9e-c61c-ffb4-303e-6a9cd4d83e33
msgctxt "h80fb1c1dg9ef0g4a0aga1acgcf3eaa3f6202"
msgid ""
"<i>Perfect.</i> This grove is the place I am seeking. Show me where it is, "
"and we will destroy it together."
msgstr "<i>완벽해.</i> 그 숲은 내가 찾던 장소다. 어디에 있는지 내게 보여라, 그리고 함께 파괴하도록 하자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 0eccac78-5497-6d98-6cf9-540e38a793af
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:0eccac78-5497-6d98-6cf9-540e38a793af
msgctxt "he66d94d3g9f53g4c4egbd92g1b30b2e601bc"
msgid ""
"I see the slaughter has already begun. We will eliminate those who remain "
"together, True Soul."
msgstr "이미 학살이 시작된 것 같군. 우린 함께 남아있는 이들을 제거할 것이다, 참된 영혼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Narrator
#. NodeID = 0effd9c0-7a20-d3b8-2674-c56cb43271d3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:0effd9c0-7a20-d3b8-2674-c56cb43271d3
msgctxt "hb818e39eg9f97g4e44gbf1fg6b743ed3cffa"
msgid "*Her mind enters yours, a splinter of ice piercing your memories.*"
msgstr "*그녀의 정신이 당신의 기억을 꿰뚫는 얼음 조각처럼 당신의 마음 속에 들어옵니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 0f836f71-0c6f-fb29-0991-331e4d35357e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_State_TooLowTieflings = False
#.   Script:
#.      - GEN_IsSpeakerPresent_5 = True
#. SetFlags:
#.   Global:
#.     - GOB_DrowCommander_Event_RaidersSortie = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:0f836f71-0c6f-fb29-0991-331e4d35357e
msgctxt "hd598db21ga813g4c7cg9f33gd3d5f6e3bf80"
msgid "For the Absolute!"
msgstr "절대자님을 위해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 0fc3fe98-0752-61c9-32b9-8e9ecf18e996
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_DrowCommander_Event_ToldOfPrisonerEscape = False
#.      - GOB_Torturers_State_PrisonerFreed = True
#. SetFlags:
#.   Global:
#.     - GOB_DrowCommander_Event_ToldOfPrisonerEscape = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:0fc3fe98-0752-61c9-32b9-8e9ecf18e996
msgctxt "h8b5bdc31g0b2ag4e6dg9399g785d4d52384e"
msgid "Bad news - the prisoner escaped."
msgstr "나쁜 소식이야. 그 포로가 도망쳤어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 0fe0cd09-f440-d788-513d-daa110adce5a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:0fe0cd09-f440-d788-513d-daa110adce5a
msgctxt "h31f3acceg14ccg43a6ga949gea0bb3e44157"
msgid "Patience. Her time will come."
msgstr "참아. 때가 올 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 114b43cd-b67b-c94d-7b2e-2e8c0c00d8d1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:114b43cd-b67b-c94d-7b2e-2e8c0c00d8d1
msgctxt "h5543d010g38a2g4484gb14dgfe626a46c062"
msgid "I will gather a raiding party and move into position."
msgstr "내가 습격대 한 부대를 꾸려서 그 위치로 이동하겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 114cf83b-0987-667c-7496-c62cf0fa8739
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_Knows_Lockdown = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:114cf83b-0987-667c-7496-c62cf0fa8739
msgctxt "hd7d080abgaae4g46a5gb2f0g36764960ad13"
msgid ""
"I visited the grove - the druids have performed a ritual to seal it from "
"intruders."
msgstr "난 그 숲에 다녀왔어, 드루이드들이 침입자를 막기 위해 의식을 수행해 그곳을 봉인해 버렸더군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Narrator
#. NodeID = 12066aac-504b-4be6-dca8-43c8aee8c75d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:12066aac-504b-4be6-dca8-43c8aee8c75d
msgctxt "h77b888abg9bf7g465bgae78g27be0c69aa0f"
msgid "*...and of the weapon. She will seize it, in the Absolute's name.*"
msgstr "*...그리고 그 무기에 대한 생각입니다. 그녀는 절대자의 이름으로 이를 손에 넣으려 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 12e71edc-c149-62bf-f14d-2c281d00bc97
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:12e71edc-c149-62bf-f14d-2c281d00bc97
msgctxt "h85b91adfgf542g4aa6gb653gd1530789e1a2"
msgid "Gold. Lots of it."
msgstr "금화가 있지. 엄청나게 많은 양의 금화가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Narrator
#. NodeID = 130e4ced-05cd-b9be-155c-fb58c4da51b2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:130e4ced-05cd-b9be-155c-fb58c4da51b2
msgctxt "h619bd73dg0838g467dgb352g1d539dec5fdb"
msgid ""
"*As she turns to you, her thoughts mingle with yours, a cold hand caressing "
"your brain.*"
msgstr "*그녀가 당신에게로 향하자, 그녀의 생각이 당신의 생각과 섞이고, 차가운 손이 당신의 뇌를 어루만집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 133a563c-8db7-ecf4-7869-d1e2d52e2b19
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:133a563c-8db7-ecf4-7869-d1e2d52e2b19
msgctxt "hfa206eb9g671bg4f43g8baegdb1bddea5348"
msgid "I will gather my forces - we will reach the grove by next light."
msgstr "내 세력을 모으겠다, 내일이 밝기 전까지 숲에 도착할 것이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 13bef70f-c534-5e6b-c8e7-d462b1f72e74
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:13bef70f-c534-5e6b-c8e7-d462b1f72e74
msgctxt "he7da35acg8bb9g4ce7g91cagdb5347ba8dc0"
msgid "Something is entangling my memories."
msgstr "뭔가 내 기억을 옭아매고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 1495bfa2-d8c3-e8ea-94d6-0f16b9bb288a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:1495bfa2-d8c3-e8ea-94d6-0f16b9bb288a
msgctxt "h979adc1cge74dg4feega722gf1dd81a17134"
msgid "This ends now - so does your life."
msgstr "여기서 끝이다. 네 목숨과 함께 끝내주마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 14a47bf6-ce70-d5a4-a1a0-8404221aa0b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:14a47bf6-ce70-d5a4-a1a0-8404221aa0b6
msgctxt "h3c3f9db5gd62eg4d2fgbc19g0123036ae46c"
msgid "He's been resilient but he'll talk..."
msgstr "놈이 끈질기게 버티고 있지만 곧 입을 열고 말 테지..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 15c3ace0-e9a7-9191-2732-7ff97a64f3a0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_DrowCommander_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:15c3ace0-e9a7-9191-2732-7ff97a64f3a0
msgctxt "h9f246878g8126g4585g90d0g2e120ba9f6ff"
msgid "I do not have time for interruptions from underlings."
msgstr "아랫것들한테 방해받을 시간은 없다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 15c6ae2b-79f7-1adc-569e-7c70a79b0113
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_DrowCommander_State_Hostile = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:15c6ae2b-79f7-1adc-569e-7c70a79b0113
msgctxt "h648ad001g3352g448ag9097g4f8eb3d57fae"
msgid ""
"Your allegiance should be to me and the Absolute. While you hold on to your "
"past, you are worthless."
msgstr "네 충성심은 나와 절대자님께 향해야 한다. 과거를 붙잡고 있으면, 넌 아무 쓸모도 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 15eec92b-837a-6d3e-1d4a-cc3dbfbf638f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_DrowCommander_HasMet(1) = True
#.   Global:
#.      - GOB_Torturers_State_KnowDen = True
#.      - GOB_DrowCommander_State_ReadyToGo = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:15eec92b-837a-6d3e-1d4a-cc3dbfbf638f
msgctxt "h2ff1a9d4gad56g4493g8ef0gce0c94473ef2"
msgid ""
"The goblins tell me that you extracted a confession from our prisoner, True "
"Soul."
msgstr "고블린들이 말하길, 네가 포로에게서 정보를 얻어냈다고 하는군, 참된 영혼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 15f3b617-e538-a67e-b5cc-3c51d72a33bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:15f3b617-e538-a67e-b5cc-3c51d72a33bf
msgctxt "h3674874dgc398g4f1bga4ffg1e22d455ef3a"
msgid "The druids have called on their god to protect the place. No matter."
msgstr "드루이드들이 그 곳을 보호하기 위해 그들의 신을 불렀군. 문제는 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 173ed2a4-e431-114a-2ba1-20252fea9440
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:173ed2a4-e431-114a-2ba1-20252fea9440
msgctxt "hbfd05529g03adg4b14gb718g6b029a7ab357"
msgid "Exquisite. The Absolute chose well when She chose you."
msgstr "절묘하군. 절대자가 당신을 잘 선택했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 175d4dea-03be-fa28-fd67-0f882840c09c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:175d4dea-03be-fa28-fd67-0f882840c09c
msgctxt "h5ddf1892ge591g4bbcg9d4dgbe0a00abb292"
msgid "I visited his grove."
msgstr "그의 숲을 방문 했었지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 2063da73-da57-c0b9-216d-c4517da0fa44
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_DrowCommander_Knows_DrowLeader = True
#.   Tag:
#.      - PALADIN(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:2063da73-da57-c0b9-216d-c4517da0fa44
msgctxt "h623fa493g9df8g47d9gb5adgd93824dca4bf"
msgid "So do I. I'm here to kill you."
msgstr "나도 그래. 널 죽이러 왔으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 20b9642c-1b49-817b-257a-e3955d07900c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_DrowCommander_State_Hostile = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:20b9642c-1b49-817b-257a-e3955d07900c
msgctxt "h9b938a90g9a0cg4453gb051gd6b64be5a01e"
msgid "You would <i>dare</i>...? Guards - to me!"
msgstr "네가 <i>감히</i>...? 경비대, 내게로!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 217d6fa1-d722-132b-cb7c-b1c328234d38
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - DEN_Conflict.HeardAboutAoD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:217d6fa1-d722-132b-cb7c-b1c328234d38
msgctxt "h81c1a07bgecb5g4372g95a0g3dcc4141dc47"
msgid "Enough. Speak only to me, True Soul. The hunt must begin."
msgstr "그만. 나에게만 말해라, 참된 영혼. 사냥을 시작해야 한다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 239c0c8e-2cb2-4ef7-3474-cf64ff518702
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:239c0c8e-2cb2-4ef7-3474-cf64ff518702
msgctxt "h4163fe2eg6486g42f6g889ag71f135be2172"
msgid ""
"Until their sanctuary is found, I will take something precious from you "
"every hour that passes."
msgstr "그들의 안식처가 발견될 때까지, 매 시간마다 네게 소중한 것들을 빼앗아 주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 23dd25b0-2c07-a550-5916-8e5161b88782
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:23dd25b0-2c07-a550-5916-8e5161b88782
msgctxt "h87c63655g5b9eg41f8g847ag2131bdc602f6"
msgid "Ready? Let's take her out."
msgstr "준비됐어? 그녀와 결판을 낼 시간이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 24983010-79cc-bea5-de0c-eccd643f0e6c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:24983010-79cc-bea5-de0c-eccd643f0e6c
msgctxt "h170b3ae2gaaacg4f40gba9cg32d737cb9088"
msgid ""
"Why do you ask? Surely you feel the Absolute moving through me - just as I "
"feel Her in you."
msgstr "왜 묻는 거지? 분명히 너는 내 안에서 절대자님이 움직이는 것을 느끼고 있다. 내가 네 안에서 그분을 느끼는 것처럼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 25b2901e-ff34-c9c7-de32-558f03f22640
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:25b2901e-ff34-c9c7-de32-558f03f22640
msgctxt "h3482ae02g7a13g443agb25dg106db72cf5fa"
msgid "Excellent. Now show it to me! Be my eyes..."
msgstr "훌륭하군. 당장 내게 보여봐라! 나의 눈이 되어라..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Narrator
#. NodeID = 27108b2b-ca22-cc2b-26e4-bcbde9504a2b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(6) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:27108b2b-ca22-cc2b-26e4-bcbde9504a2b
msgctxt "h46fc408dg0dbag4852g9f21g262541a94b99"
msgid ""
"*You feel Shadowheart's anxiety. The weapon the Absolute seeks - it's the "
"artefact that she carries. The same one that protected you as you entered "
"the goblin camp.*"
msgstr ""
"*섀도하트의 불안감이 느껴집니다. 절대자가 찾고 있는 무기, 그건 바로 그녀가 가지고 다니는 아티팩트입니다. 고블린 야영지에 들어올 때 "
"당신을 보호해 준 바로 그 아티팩트 말입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 2c17bb06-e37d-28dc-21dd-0f11373b1adc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:2c17bb06-e37d-28dc-21dd-0f11373b1adc
msgctxt "hf5eeb263g2364g4640ga262gb05ef67e2a20"
msgid ""
"They are servants of the Absolute. In sufficient numbers, they are an "
"effective force. Expendable and willing."
msgstr ""
"그들은 절대자님의 종복들이다. 충분한 수가 있으면, 효과적인 병력이기도 하지. 소모품으로 쓰일 수 있고, 그렇게 되길 환영하니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 2d216f78-8917-9f3d-9d7f-7d4c5f39c649
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:2d216f78-8917-9f3d-9d7f-7d4c5f39c649
msgctxt "ha11f8380g6592g42deg97f4g165f3069a358"
msgid "We're both drow. The Absolute shouldn't come between us."
msgstr "우리 둘 다 드로우잖아. 절대자가 끼면 안되지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 2d81fbb3-757d-8cb0-a370-5386e49e1679
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:2d81fbb3-757d-8cb0-a370-5386e49e1679
msgctxt "h98d2bee4g4b79g4d01gb610gd849a5b70532"
msgid "If I do this, I expect to be rewarded."
msgstr "그렇게 하려면, 보상이 필요하겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 2dba59ff-4b38-1605-6a31-0e69aa97f406
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:2dba59ff-4b38-1605-6a31-0e69aa97f406
msgctxt "hef162fcbgb398g4e2ega0feg590dc2e4ed5a"
msgid "<i>Relent, and open your mind to her.</i>"
msgstr "<i>동의하고, 그녀에게 당신의 정신을 개방한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 2e27ab55-5fe2-1196-a78a-b2eaa1428490
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DROWELF and FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:2e27ab55-5fe2-1196-a78a-b2eaa1428490
msgctxt "heedf40c5g693cg4cf7gb900gf1dc5a3d4099"
msgid "Praise be. A True Soul. Are you here to join the hunt, sister?"
msgstr "찬사를. 참된 영혼이군. 사냥에 동참하러 왔나, 자매여?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 2e27ab55-5fe2-1196-a78a-b2eaa1428490
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DROWELF and MALE
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:2e27ab55-5fe2-1196-a78a-b2eaa1428490
msgctxt "ha7405430g1a5fg4bacga8cag4baebe25c87f"
msgid "Praise be. A True Soul. Are you here to join the hunt, brother?"
msgstr "찬사를. 참된 영혼이군. 사냥에 동참하러 왔나, 형제여?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 2e27ab55-5fe2-1196-a78a-b2eaa1428490
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:2e27ab55-5fe2-1196-a78a-b2eaa1428490
msgctxt "hb8f90abega41ag4298g86f5g3f66f45d0cb5"
msgid "A True Soul? Praise be. Are you here to join my hunt?"
msgstr "참된 영혼이라? 절대자님께 찬사를. 내 사냥에 동참하러 왔나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 2e56b6de-e7f0-007c-bbe1-61a3dc889599
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_DrowCommander_Event_CompromisedDen(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:2e56b6de-e7f0-007c-bbe1-61a3dc889599
msgctxt "h0fdcbc62g9fdfg4758g9f2fgcd13e17390a9"
msgid "<i>Point to the location of the grove on her map.</i>"
msgstr "<i>그녀의 지도에 그 숲의 위치를 가리킨다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 2f99c8c0-95a1-4e27-cf7b-3cfa06eec30d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:2f99c8c0-95a1-4e27-cf7b-3cfa06eec30d
msgctxt "h637c3556ge729g4cceg883dg7d5cc47ab173"
msgid "<i>Open your mind to her.</i>"
msgstr "<i>그녀에게 정신을 개방한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 2fa2fc48-3073-f20c-f71d-ed48cbcd46b9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Torturers_State_KnowDen = True
#.      - GOB_DrowCommander_State_ReadyToGo = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:2fa2fc48-3073-f20c-f71d-ed48cbcd46b9
msgctxt "h69047d65gda38g4051gb62fg999f6ae2b895"
msgid ""
"I have been expecting you. The goblins tell me that you forced a confession "
"from our prisoner."
msgstr "너를 만날 걸 예상하고 있었다. 고블린들이 말하길, 네가 포로를 실토하게 만들었다던데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 3039df42-b1cb-f41a-a1e4-0282c0bf4382
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:3039df42-b1cb-f41a-a1e4-0282c0bf4382
msgctxt "h3c03bc73g7980g4b55gb6d5g436beed256da"
msgid "And once I'm inside?"
msgstr "그리고 일단 안으로 들어가면?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 3118d7d7-c433-055d-1ae9-cdc328c835d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:3118d7d7-c433-055d-1ae9-cdc328c835d4
msgctxt "he37ae2e3g2c53g4287g93b2g37c5ee977f71"
msgid "My patience wears thin, True Soul. The hunt must begin."
msgstr "내 인내심이 바닥을 드러내고 있다, 참된 영혼. 사냥을 시작해야 한다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 32a5b3fb-bf54-7522-143b-5d17a9aaf6d5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_DrowCommander_Knows_DrowLeader = True
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule: OATHBREAKER
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:32a5b3fb-bf54-7522-143b-5d17a9aaf6d5
msgctxt "h63591c87g1975g471ag8341g7179a64c42f2"
msgid "This is where your hunt ends, zealot."
msgstr "네 사냥은 여기서 끝이다, 광신도."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 32a5b3fb-bf54-7522-143b-5d17a9aaf6d5
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_DrowCommander_Knows_DrowLeader = True
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule: PALADIN_ANCIENTS
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:32a5b3fb-bf54-7522-143b-5d17a9aaf6d5
msgctxt "h0d6b7424g66ceg4f33gb819gaab0bc958674"
msgid ""
"Your hunt would desecrate an ancient place of calm. I will not let it happen."
msgstr "네 사냥은 고대로부터 내려온 평화의 장소를 더럽힐 것이다. 그렇게 내버려 두진 않겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 32a5b3fb-bf54-7522-143b-5d17a9aaf6d5
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_DrowCommander_Knows_DrowLeader = True
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule: PALADIN_DEVOTION
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:32a5b3fb-bf54-7522-143b-5d17a9aaf6d5
msgctxt "hdd599ae7g3193g4464g99ceg546af7bf443e"
msgid "You command the Absolute's forces well - you'll do so no more, villain."
msgstr "너는 절대자의 병력을 잘도 지휘하는군. 더는 그럴 수 없을 것이다, 악당아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 32a5b3fb-bf54-7522-143b-5d17a9aaf6d5
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_DrowCommander_Knows_DrowLeader = True
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule: PALADIN_VENGEANCE and NOT_FOR_EA
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:32a5b3fb-bf54-7522-143b-5d17a9aaf6d5
msgctxt "hf563b389g9a38g4b4egb30cge9faf8164b99"
msgid "The hunt of your ill-begotten god ends here, <i>True Soul</i>."
msgstr "네 뒤틀린 신의 사냥도 여기서 끝이다, <i>참된 영혼</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 3399f32e-708a-27d4-91db-473f6139d16c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_DrowCommander_State_Hostile = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:3399f32e-708a-27d4-91db-473f6139d16c
msgctxt "hc7c25529g73f3g46ecg890dg1612b77f0a4f"
msgid "Faith is stronger than blood, traitor!"
msgstr "혈통보단 신앙이 우선이다, 배신자!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 34456fb7-0ae1-6b2a-97ae-d4b095409af3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:34456fb7-0ae1-6b2a-97ae-d4b095409af3
msgctxt "he3802fb3gd783g4c45ga22cg160abd7447e5"
msgid "Quiet. I have everything under control."
msgstr "조용히 해. 모든 건 계획대로야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 3491793e-3703-adf6-aa7f-2c413181e18c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_State_TooLowTieflings = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:3491793e-3703-adf6-aa7f-2c413181e18c
msgctxt "h9a3f9babg2795g4672g97a9gc681ea102a35"
msgid "<i>The grove's inhabitants are weak - it's ready to fall.</i>"
msgstr "<i>숲의 거주자들은 약하다 - 숲은 언제든지 몰락할 것이다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 3686f131-b027-a34a-8766-14b8127e4bd5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_Knows_Lockdown = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:3686f131-b027-a34a-8766-14b8127e4bd5
msgctxt "h3bad5e34g1e67g41a2ga74ag1c4016a2858c"
msgid ""
"<i>The druids' magic protects the grove, but she may be able to break "
"through.</i>"
msgstr "<i>드루이드의 마법이 숲을 보호하지만, 그녀가 돌파할 수 있을지도 모른다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Wyll
#. NodeID = 371dc64f-a0ac-394d-fb21-6c85b0f00c89
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:371dc64f-a0ac-394d-fb21-6c85b0f00c89
msgctxt "hae4392b4gd8c2g4d99gbfc7g08cdb630e4c7"
msgid "Make peace with your Absolute - the Blade comes for your head!"
msgstr "너의 절대자와 작별해라. 이 칼날이 너의 머리를 노리고 있으니!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 38a43ccb-3908-7ae5-0789-b086096e07ae
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:38a43ccb-3908-7ae5-0789-b086096e07ae
msgctxt "h24dbc265ge26dg4d44gb1cfgf8b660bbf341"
msgid "<i>Reject these dreams of a bloodbath.</i>"
msgstr "<i>대학살의 꿈을 거부한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 39d29231-94ec-2222-e8f8-a2af27fff28d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:39d29231-94ec-2222-e8f8-a2af27fff28d
msgctxt "h6abadddbg4c56g4576g8cdfg7b9a758f05e2"
msgid ""
"Perhaps... but your thoughts are troubled. Show me <i>everything</i> you "
"have seen."
msgstr "과연... 하지만 너 불안해 보이는데. 네가 봤던 <i>모든 것</i>을 보여줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 3a8694d5-ba8e-4dab-fedc-d070e2162f93
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_State_TooLowTieflings = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:3a8694d5-ba8e-4dab-fedc-d070e2162f93
msgctxt "h3a16919dg4a13g491cgb8e6g32d4de3d16e7"
msgid ""
"<i>Even with the grove's numbers depleted, dealing with her there may be "
"safer than fighting here.</i>"
msgstr "<i>숲의 인원이 고갈된 상태긴 하지만, 이곳에서 싸우는 것보다 그곳에서 그녀를 상대하는 것이 더 안전할 수 있다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 3bbafd7c-1a3b-2341-ff42-2dac3cf38e21
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Absolute_Knows_MoonriseTowers = True
#.      - GOB_DrowCommander_Quest_AskedAboutPassage = False
#. SetFlags:
#.   Global:
#.     - GOB_DrowCommander_Quest_AskedAboutPassage = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:3bbafd7c-1a3b-2341-ff42-2dac3cf38e21
msgctxt "hfeafb7b5gfa69g431agb11eg5696f5e4fc7e"
msgid "I have business at Moonrise. Can you provide safe passage?"
msgstr "문라이즈 타워에 가서 할 일이 있는데. 안전한 통로를 알려 줄 수 있어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 3cfd2fe1-7e70-f265-1e1b-aa2cc48283ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:3cfd2fe1-7e70-f265-1e1b-aa2cc48283ad
msgctxt "h141cb02ag6775g4254g8de8g022a5793c4f5"
msgid "I'm sorry. I didn't get anything out of him."
msgstr "미안해. 그에게 아무것도 얻어내지 못했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 3fd3e4a5-ff69-a84d-a5ab-76d18278df81
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_WolfPens_State_HalsinIntroHappened = False
#.      - GLO_Halsin_State_PermaDefeated = False
#.      - GLO_Halsin_Knows_IsMissing = True
#. SetFlags:
#.   Global:
#.     - GOB_DrowCommander_Event_ToldDrowOfHalsin = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:3fd3e4a5-ff69-a84d-a5ab-76d18278df81
msgctxt "h9c5306eeg4f33g4adfgaa8egfa05db7bbc87"
msgid "I'm on a hunt of my own. I'm looking for a druid named Halsin."
msgstr "나는 내 사냥을 하고 있다. 할신이라는 이름의 드루이드를 찾고 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 3fd59817-a166-e73a-b3ef-b2d4bbea5170
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TIEFLING(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:3fd59817-a166-e73a-b3ef-b2d4bbea5170
msgctxt "h6aa81100g23f1g47e5gbb55g467cfe278717"
msgid "They'll die thinking I'm their hero."
msgstr "그들은 내가 자기들 영웅인 줄 안 채로 죽을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 3ff3aa6b-a42e-1f10-2c6e-f2ff821fa6b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:3ff3aa6b-a42e-1f10-2c6e-f2ff821fa6b3
msgctxt "h056a9593gc6c8g475dg81eag60cc355df8ff"
msgid ""
"<i>Pathetic.</i> You are polluting the power the Absolute has granted you."
msgstr "<i>한심하군. </i>넌 절대자께서 네게 하사해 주신 힘을 오염시키고 있다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Narrator
#. NodeID = 40aedd73-8643-ce95-3dbf-298fb6c449c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:40aedd73-8643-ce95-3dbf-298fb6c449c9
msgctxt "h4d0e8a12g021fg4a15g8c96gb5cec8461f32"
msgid ""
"*Her excitement is palpable. She lingers on thoughts of victory, of "
"unbelievers' blood spilled...*"
msgstr "*그녀의 흥분이 느껴집니다. 그녀는 생각에 빠져 있습니다. 승리에 대한 생각, 불신자들이 흘릴 피에 대한 생각...*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 40ddc2a0-1bec-d8e6-f63a-b7f5c934d4ed
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_HappyTorturers_Knows_PlayersKnowDenLocation = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:40ddc2a0-1bec-d8e6-f63a-b7f5c934d4ed
msgctxt "hd4579996gdc8bg4a7eg951eg24fa266f36b7"
msgid "He told me everything."
msgstr "그가 나에게 모든 걸 말해줬어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 41bf1074-aa9e-ef0c-1d3a-9f8105dfbc6c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:41bf1074-aa9e-ef0c-1d3a-9f8105dfbc6c
msgctxt "hebd2a826g447dg4a9dga685gc737d0e90f54"
msgid ""
"Did he, now? Let me guess: the snivelling brat's failed his duty. Nothing if "
"not expected."
msgstr "그가 그렇게 말했나? 내가 맞춰보지: 그 투덜대는 애송이가 임무에 실패했겠군. 놀랄 일도 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 41f06136-7957-6023-c8a4-646ad296369d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:41f06136-7957-6023-c8a4-646ad296369d
msgctxt "h0d27bd69g842ag41fbgaaaegbeb5c322f63c"
msgid "A trinket... a tongue... a <i>limb</i>."
msgstr "장신구... 혀... <i>팔 다리</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 436c20fd-7292-dad6-f348-07d72a74d60e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:436c20fd-7292-dad6-f348-07d72a74d60e
msgctxt "h8127b32dg46a5g498cgb4adga69fec8c483e"
msgid ""
"The last I sent did not return. Dead at the hands of those they seek, no "
"doubt."
msgstr "내가 마지막으로 보낸 녀석들이 돌아오지 않았어. 의심할 여지 없이 사냥감들의 손에 죽었겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 4378cfbc-4ce9-6cbf-db93-6a63aa69cc21
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - MALE(1) = True
#.      - DROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:4378cfbc-4ce9-6cbf-db93-6a63aa69cc21
msgctxt "h6f593ee2gd751g4f62gb219g5d152c8c7f57"
msgid "Now - you must obey me and hunt, <i>jaluk</i>. In Her name."
msgstr "자, 너는 나의 명령을 따라야 한다, <i>잘루크</i>. 절대자님의 이름으로."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Narrator
#. NodeID = 44f36783-4986-4504-34ae-2bae38f309f7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_DrowCommander_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_DrowCommander_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:44f36783-4986-4504-34ae-2bae38f309f7
msgctxt "h9912fc96g0a14g4c5bga63bg18a1051f1c12"
msgid "*Her thoughts mingle with yours, a cold hand caressing your brain.*"
msgstr "*그녀의 생각이 당신의 생각과 섞이고, 차가운 손이 당신의 뇌를 어루만집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 451c13f8-ee96-639a-8d12-29c9a50696b0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_DrowCommander_Knows_CommandingGoblins = True
#.      - GOB_DrowCommander_Knows_AboutGoblins = False
#. SetFlags:
#.   Global:
#.     - GOB_DrowCommander_Knows_AboutGoblins = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:451c13f8-ee96-639a-8d12-29c9a50696b0
msgctxt "hc8b067b9ga3edg4a77g8b20gc679a0f24639"
msgid "Why is a drow commanding a tribe of goblins?"
msgstr "어째서 드로우가 고블린 부족을 지휘하는 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 45538028-c052-9536-48c4-7fe9022c0ecf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_DrowCommander_Knows_SentByNere = False
#.      - UND_TheDrowNere_Quest_SentToMinthara = True
#. SetFlags:
#.   Global:
#.     - GLO_DrowCommander_Knows_SentByNere = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:45538028-c052-9536-48c4-7fe9022c0ecf
msgctxt "h6a30b8b3g64f0g4fabga8bbge1017fae7a03"
msgid ""
"I met True Soul Nere in the Underdark. He warned me against working with you."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 45f1aa9e-b074-0b5f-02a2-968cf5b51a46
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:45f1aa9e-b074-0b5f-02a2-968cf5b51a46
msgctxt "h6fceac42gfae4g460dgb989g1b63948e0efc"
msgid "Protect them? Never. My memories are yours."
msgstr "감싼다고? 절대. 내 기억은 네 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Narrator
#. NodeID = 45fb4f2a-b049-95f4-f6e2-9cdb676d6639
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:45fb4f2a-b049-95f4-f6e2-9cdb676d6639
msgctxt "hd11080ceg9790g4ad5g9694g167a490d0d1a"
msgid ""
"*You attune your mind to it. The artefact does not want to part from you. It "
"does not want to fall into the Absolute's clutches.*"
msgstr ""
"*당신은 아티팩트에 당신의 정신을 조율해봅니다. 아티팩트는 당신과 떨어지고 싶지 않습니다. 절대자의 수중에 들어가길 원치 않습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 46b93a37-b167-81f0-b6aa-85357d1e71df
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_DrowCommander_Event_OrderedToJoinHunt(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:46b93a37-b167-81f0-b6aa-85357d1e71df
msgctxt "hba846e52g6d82g416dgadfagb37b87e6f280"
msgid "Gladly. Who are we hunting?"
msgstr "기꺼이. 누구를 사냥 중이지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 472ab32b-9b70-431a-ce5a-8401edf760d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:472ab32b-9b70-431a-ce5a-8401edf760d8
msgctxt "ha69da2e3gd0e8g4091g910bg783ff816d727"
msgid "Let's talk payment first."
msgstr "먼저 보수에 대해 얘기해 보자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 47e0373b-e907-6cf0-a094-9d1f3b94b4a3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - NIGHT_DarkUrge_ButlerIntro = True
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:47e0373b-e907-6cf0-a094-9d1f3b94b4a3
msgctxt "hfa32b4abg0087g4779ga777g7a3bfc06314e"
msgid "Stop! I'm growing aroused!"
msgstr "그만! 점점 흥분되는군!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 4a137e50-f8b2-17b1-298d-23e7a22a3b2f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:4a137e50-f8b2-17b1-298d-23e7a22a3b2f
msgctxt "h954054f3gb657g4659ga708gb119b5b2698d"
msgid ""
"Without your help, they would have extracted nothing but screams and blood."
msgstr "너의 도움이 없었다면, 그놈들은 비명과 피밖에 얻지 못했을 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 4a5e7b46-de76-1303-99f4-cfdd8e55d7c9
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: ELF or HALFELF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:4a5e7b46-de76-1303-99f4-cfdd8e55d7c9
msgctxt "h3c85fa63g915fg4529gb738ga590ff369104"
msgid ""
"A True Soul in such a grotesque form? The Absolute has a place in Her heart "
"even for <i>darthiir</i>."
msgstr "이렇게 기괴한 모습의 참된 영혼이라니? 절대자님은 <i>다시르</i>에게도 마음을 베풀어주시는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 4afaf8d7-dde9-86b8-836a-0deeda9eaa09
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - DEN_Conflict.HeardAboutAoD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:4afaf8d7-dde9-86b8-836a-0deeda9eaa09
msgctxt "h183e501egd287g4e11g8523g43353ae74982"
msgid "The thief whimpering in our dungeon tried to flee to their sanctuary."
msgstr "우리 지하감옥에서 훌쩍이고 있는 도둑놈이 그들의 은신처로 도망치려고 했지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 4bf60bc4-3674-779c-e27d-3c68f59fbe01
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_RaidingParty_Event_StartConfrontation = True
#.      - GOB_HappyTorturers_Knows_PlayersKnowDenLocation = False
#. SetFlags:
#.   Object:
#.     - GOB_DrowCommander_Event_CompromisedDen(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:4bf60bc4-3674-779c-e27d-3c68f59fbe01
msgctxt "h3b2d6363g4a2dg4b8cg8f51g0ab687eda454"
msgid "No, but I've seen the place myself."
msgstr "아니, 하지만 나는 그 장소를 직접 봤다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 4ca718bd-f32b-52b0-004e-a102471f08db
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:4ca718bd-f32b-52b0-004e-a102471f08db
msgctxt "he30c1f90g72f6g43e1g9f78g370ba917bd3f"
msgid "I'm sorry... I stopped by the party. The drink's clouding my mind."
msgstr "미안해... 술자리에 들렀어. 술 때문에 정신이 흐려졌군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 4cc7d59f-1c46-9773-b35d-42eb964cc7a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:4cc7d59f-1c46-9773-b35d-42eb964cc7a5
msgctxt "hce6ac801g1134g4494g900fg907cd796fe4f"
msgid "Beautiful."
msgstr "아름다워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 4cd236aa-7465-bb9c-dc2c-7c5a4ce8593e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:4cd236aa-7465-bb9c-dc2c-7c5a4ce8593e
msgctxt "h9052704fg4b8dg46b7g82cdg2b4507669975"
msgid ""
"We will continue to remove parts of him until he tells us <i>exactly</i> "
"where it is."
msgstr "놈이 무기가 어디 있는지 <i>정확히</i> 털어놓기 전까지 신체 부위를 하나씩 절단할 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 4ce58e6b-4ed9-4f72-afef-4e3c72b979eb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:4ce58e6b-4ed9-4f72-afef-4e3c72b979eb
msgctxt "h84062db3gea0cg4392g9be6g3b98f03a495a"
msgid ""
"You are a poor liar. I do not know why you are protecting them, and I do not "
"care."
msgstr "거짓말에 재능이 없나 보군. 네가 왜 그놈들을 지키려고 하는지는 모르겠지만 내 알 바는 아니지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 4d13797e-237e-e22b-1c4a-dd5ddd3f1121
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - FEMALE(1) = True
#.      - DROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:4d13797e-237e-e22b-1c4a-dd5ddd3f1121
msgctxt "h35d65602ga78dg4bd0g8301gc1e1b1503beb"
msgid "Now - let us hunt together, sister. In Her name."
msgstr "자, 같이 사냥하자, 자매여. 절대자님의 이름으로."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 4d2bb74b-00ee-8c30-a83a-ce5ad1ed52d5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:4d2bb74b-00ee-8c30-a83a-ce5ad1ed52d5
msgctxt "h015c01f6g05f6g4456ga115g7952dbf39f0b"
msgid ""
"Orders from <i>whom</i>? This is my command, and if you were sent here, I "
"would have been told to expect you."
msgstr ""
"<i>누구</i>로부터 명령을 받았지? 이곳의 지휘관은 나야. 게다가 네가 이곳에 올 예정이었다면, 내가 너를 만날 것을 전해들었어야 "
"했는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 4da6ff8c-ef27-c3cf-bd5b-febd6a1507d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:4da6ff8c-ef27-c3cf-bd5b-febd6a1507d0
msgctxt "h97189ddag0f6bg48cfgade1g76cafac7c4ff"
msgid "Good plan. I'll consider it."
msgstr "좋은 계획이군. 고려해 보겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 4ee7ab3b-5a9d-14ec-f1a5-666ce0ab39c5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:4ee7ab3b-5a9d-14ec-f1a5-666ce0ab39c5
msgctxt "ha8e1ac9fg0709g436dg8cedge9609e92dce1"
msgid "You started the slaughter without me? How selfish."
msgstr "나 없이 학살을 시작하려고? 정말 이기적이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 4f944778-21a0-2da7-3636-98a70ac39561
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:4f944778-21a0-2da7-3636-98a70ac39561
msgctxt "hd53f0c32ga727g47e7g8236g936404a3c671"
msgid "<i>Share in her dream of a dance of death.</i>"
msgstr "<i>죽음의 춤에 대한 것을 그녀의 꿈에 공유 한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 4faacf41-2722-0e88-f536-3843e7136300
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:4faacf41-2722-0e88-f536-3843e7136300
msgctxt "h5de03288g66bdg4c7egb662gcf83c6350233"
msgid "I have my own business to take care of."
msgstr "나는 신경 써야 할 나만의 일이 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 4fe15311-c0ff-7811-fd92-0762ebd9b983
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_SecretOfArtefact_MintharaMentionedWeapon = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:4fe15311-c0ff-7811-fd92-0762ebd9b983
msgctxt "h362a6905ge0a9g4741gb002g92c406f9f71b"
msgid ""
"There is a weapon the Absolute seeks - I'm sure those wretches have it "
"hidden away there. We will find it, amongst the dead and the ashes."
msgstr "절대자님이 찾으시는 무기가 있다. 분명 쥐새끼들이 저 멀리 숨겨놨을 거야. 우리는 시체와 잿더미 속에서 그것을 찾을 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 504ce4ae-4735-29c4-cc9a-838825ef6bc1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_RaidingParty_Event_StartConfrontation = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:504ce4ae-4735-29c4-cc9a-838825ef6bc1
msgctxt "h153a8a83gd040g43e2gaaa4gc7afb19992c0"
msgid "I've already found the place - it's a druids' grove, not far from here."
msgstr "나는 그 장소를 이미 알고 있다. 드루이드의 숲이야. 이곳에서 멀지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 50587be1-bcbe-c520-21c1-9f7d16d46d60
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:50587be1-bcbe-c520-21c1-9f7d16d46d60
msgctxt "hc46f75b9g8b5bg4ebdgb14dg4976277dedf9"
msgid "You are sure? Show it to me. Be my eyes."
msgstr "확실한가? 내게 보여봐라. 나의 눈이 되어라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 5116b15a-0493-ca95-4330-392c9c160b75
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_State_TooLowTieflings = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:5116b15a-0493-ca95-4330-392c9c160b75
msgctxt "hbe100d26g88ceg4ae1gb5f3gd9b7c1b24810"
msgid "<i>The grove's inhabitants are weak - it's ready to fall.</i>"
msgstr "<i>숲의 거주자들은 약하다 - 숲은 언제든지 몰락할 것이다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 5122e1db-6e5f-b880-95e5-a25785c686cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:5122e1db-6e5f-b880-95e5-a25785c686cb
msgctxt "h3798860dga522g4a6cga117ga242fe3d43b5"
msgid ""
"You need to prove your value before I give you anything. Join my hunt - that "
"will show your worth."
msgstr "내가 너에게 뭔가를 주기전에 너의 가치를 먼저 증명할 필요가 있겠군. 내 사냥에 동참해라. 그리고 너의 가치를 보여줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 514a4fe5-9d05-66d3-83f8-8e9c9f71305a
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:514a4fe5-9d05-66d3-83f8-8e9c9f71305a
msgctxt "h2dc3617bgffcfg4297g9133g67348cefbdd5"
msgid "<i>Place your finger on a patch of forest, far from the grove.</i>"
msgstr "<i>그 숲에서 멀리 떨어진 작은 산림 한 곳에 손가락을 올려놓는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 51c8c3ed-f8a4-2731-7200-f27141171fce
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_Knows_Lockdown = True
#. SetFlags:
#.   Global:
#.     - GOB_DrowCommander_Event_ToldAboutLockdown = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:51c8c3ed-f8a4-2731-7200-f27141171fce
msgctxt "h30c9d797g367fg409eg8064g706ad393af12"
msgid ""
"The place you seek is a grove - the druids there have performed a ritual to "
"protect it."
msgstr "네가 찾는 장소는 숲이야. 그곳의 드루이드들이 숲을 보호하기 위한 의식을 치뤘지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 544cfe75-3ff2-8ff2-6bc2-e61508e92fd7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:544cfe75-3ff2-8ff2-6bc2-e61508e92fd7
msgctxt "ha6f5d31dgd912g411dga510g350062a9a146"
msgid "Patience. Her time will come."
msgstr "참아. 때가 올 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 559b2820-d63c-f05c-f8ab-bf4ca46c198e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:559b2820-d63c-f05c-f8ab-bf4ca46c198e
msgctxt "h586aea46g4585g4ca3ga57ag31959ca26a9b"
msgid "Speak, True Soul. The hunt must begin soon."
msgstr "말해라, 참된 영혼. 사냥이 곧 시작되어야 한다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Narrator
#. NodeID = 55ae7923-a8b3-cdfc-84ad-76abb6d897b0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_InfernalBox_State_CharacterHasBox(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:55ae7923-a8b3-cdfc-84ad-76abb6d897b0
msgctxt "h6880c06ag7f3ag4dd0ga2edgff8da17c819a"
msgid ""
"*You suddenly feel a strange anxiety take hold - not your own, but that of "
"the gith artefact you carry. Somehow, <i>it's afraid</i>...*"
msgstr ""
"*갑자기 묘한 불안감이 엄습해 옵니다. 하지만 당신이 아닌, 당신이 지니고 있는 기스 아티팩트의 불안입니다. 어째서인지, <i>그것은 "
"두려워하고 있습니다</i>...*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Wyll
#. NodeID = 583c35e7-e691-1eba-0f24-9addf44d51f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:583c35e7-e691-1eba-0f24-9addf44d51f4
msgctxt "hc7bcf5bbg3184g486fg9eeagb291d74f5416"
msgid "Sooner than later, if I've got a say in it."
msgstr "빠를수록 좋을 거야, 내게 발언권이 있다면 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 59678376-9b1c-5c0d-35e9-55eb3b944256
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:59678376-9b1c-5c0d-35e9-55eb3b944256
msgctxt "h0d3fb4adg7a79g4252g9f36g4531a4828fbd"
msgid "And endanger the entire grove? It's too risky."
msgstr "그리고 숲 전체를 위험에 빠뜨린다? 너무 위험해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Narrator
#. NodeID = 596d150e-650b-6261-44d5-ab0c5e91f96a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:596d150e-650b-6261-44d5-ab0c5e91f96a
msgctxt "he07d4ff1gc18cg42b5gaa54gfaab8a38e547"
msgid ""
"*...and then smiles serenely as blood and shadow spread like stains across "
"your memory, erasing all that live there.*"
msgstr "*...그리고 피와 그림자가 당신의 기억에 얼룩처럼 번져, 그곳에 살아있던 모든 것을 지워버리자, 평온한 미소를 짓습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 59a4c192-e87d-9bf7-4f96-64a1a6ebca88
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:59a4c192-e87d-9bf7-4f96-64a1a6ebca88
msgctxt "h7955fadfg7f5ag4136gb266g912edad49ce5"
msgid ""
"The druid makes his home in a nearby sanctuary where his followers worship a "
"false god."
msgstr "그 드루이드는 근처의 성소에서 살고 있으며, 그의 추종자들은 거기서 거짓된 신을 숭배한다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 5a76db05-e728-1a50-ca3e-fccc41c9764b
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: !TIEFLING
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:5a76db05-e728-1a50-ca3e-fccc41c9764b
msgctxt "h2e313db6g7843g4ddfga5b6gbc65e87b1368"
msgid "Your thoughts are... veiled? Why do you protect these devilkin?"
msgstr "너의 생각은... 가려져 있잖아? 어째서 데빌족을 감싸는 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 5a76db05-e728-1a50-ca3e-fccc41c9764b
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: TIEFLING
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:5a76db05-e728-1a50-ca3e-fccc41c9764b
msgctxt "ha077de5agfb2dg4873ga156gb20902dc7264"
msgid ""
"Your thoughts are veiled. Are you protecting these creatures because they "
"share your blood?"
msgstr "너의 생각이 가려져 있다. 그 생물들이 너와 피가 같다는 이유로 그들을 감싸는 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 5a9851cb-76b2-4908-c57f-77926ca88e51
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:5a9851cb-76b2-4908-c57f-77926ca88e51
msgctxt "h6809e883gf382g4ba4gb984gb4eddb0cf6bd"
msgid ""
"You are honoured to serve a cause - a <i>god</i>. You will earn Her love, "
"and the power that flows from that love."
msgstr "너는 <i>신</i>이라는 대의를 위해 봉사하는 명예로운 자다. 너는 그분의 사랑과 그 사랑에서 흘러나오는 힘을 얻을 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 5b5e89d0-7ff7-973d-87ea-a661fac9b204
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:5b5e89d0-7ff7-973d-87ea-a661fac9b204
msgctxt "h85882e74gc6d3g49b4gabd7g1f33619f5324"
msgid "Good plan. I'll consider it."
msgstr "좋은 계획이야. 고려해 볼게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 5c092fc0-1526-c460-8cc5-10f5a9846257
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:5c092fc0-1526-c460-8cc5-10f5a9846257
msgctxt "h78c6dab6g8522g45cag9c7cg30d0de0a23fc"
msgid ""
"Destroying it will demonstrate our power. Soon, all false gods will cower "
"before the Absolute."
msgstr "이를 파괴하면 우리의 힘을 증명할 수 있다. 머지 않아, 모든 가짜 신들이 절대자님 앞에 몸을 숙일 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 5c11f7ee-afdd-dbff-5cd5-5806cfb92988
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:5c11f7ee-afdd-dbff-5cd5-5806cfb92988
msgctxt "h7acc4e96g911cg4261g9f07g94bd01aa0b83"
msgid "How noble. I prefer to <i>win</i>."
msgstr "이 얼마나 고결한가. 나는 <i>이기는 것</i>을 선호해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 5d5ca204-3ede-0d1f-9d51-8af530481ec5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_DrowCommander_Event_CompromisedDen(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:5d5ca204-3ede-0d1f-9d51-8af530481ec5
msgctxt "hbf48a9e5gf0eag4aceg99b0g591b67f18a51"
msgid "Let me see your map. I'll show you where the grove is."
msgstr "너의 지도를 보여줘. 내가 숲이 어디 있는지 보여줄게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 5d9957be-b986-6bb4-f91c-881733cd8a76
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:5d9957be-b986-6bb4-f91c-881733cd8a76
msgctxt "hf47cd658g6921g405agbed9g4a10cb3b2505"
msgid ""
"<i>Untangle</i> them, or you are worthless to me. My patience wears thin."
msgstr "그것을 <i>풀어라</i>. 그렇지 않으면 넌 나에게 쓸모가 없다. 내 인내심이 옅어지는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 5eab4779-7936-326a-d46d-22a419cca431
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_DrowCommander_State_Hostile = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:5eab4779-7936-326a-d46d-22a419cca431
msgctxt "hef7d5878ge6f5g4c34gb3d5g74f41b165dbd"
msgid ""
"No. There is intent behind this deception - and you will pay for it with "
"your life."
msgstr "아니. 이 속임수에는 의도가 있으며, 그 대가를 목숨으로 치르게 될 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 5f0ef8d1-e15a-9d31-54ce-26fedaca7d6c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:5f0ef8d1-e15a-9d31-54ce-26fedaca7d6c
msgctxt "he6edecd3g8af5g442bg8cd9g3a9d5ec0afc2"
msgid "And endanger the entire grove? It's too risky."
msgstr "그리고 숲 전체를 위험에 빠뜨린다? 너무 위험해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 5f6a2873-dea5-bdfc-264c-0410b035e633
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:5f6a2873-dea5-bdfc-264c-0410b035e633
msgctxt "hc4239851g39a7g41f8gad8bgab4ee52b4897"
msgid "Patience. Her time will come."
msgstr "참아. 때가 올 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 60c330ff-5a9e-49fe-053b-fd4c2e20b264
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - FEMALE(1) = True
#.      - DROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:60c330ff-5a9e-49fe-053b-fd4c2e20b264
msgctxt "h3fa1237agbc6eg4b57g9ec1gf2e67cc65971"
msgid "You are a True Soul, sister? It is good to have your assistance."
msgstr "넌 참된 영혼인가, 자매여? 네 도움이 있다니 기쁘군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 61372a80-45d0-4273-d9e3-13ccc7af3a49
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_Knows_LeaderNameDrow = True
#.   Quest:
#.     - DEN_Conflict.HeardAboutAoD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:61372a80-45d0-4273-d9e3-13ccc7af3a49
msgctxt "hcb96a996g26d7g42c0gbacdga16a8d93c540"
msgid "I intend to find it, and destroy it."
msgstr "나는 그걸 찾아내서, 박살을 낼 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 61a02277-4d05-98b3-c1d4-a745c582bac2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - FEMALE(1) = True
#.      - DROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:61a02277-4d05-98b3-c1d4-a745c582bac2
msgctxt "h71266e4dg7b97g4888gb108g04c6f93c0972"
msgid "A True Soul? Praise be, sister. Are you here to join my hunt?"
msgstr "참된 영혼이라? 절대자님께 찬사를. 자매여, 내 사냥에 동참하러 왔나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 62bca0aa-4637-fc3a-eee9-71ecf2f0a5cc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_DrowCommander_Event_Disappointed(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:62bca0aa-4637-fc3a-eee9-71ecf2f0a5cc
msgctxt "hffff2ea7gd614g4d49g8357g85911d0c6643"
msgid ""
"I see only fragments. Your mind is confused - do what you must to clear it."
msgstr "파편들밖에 안 보이잖아. 너의 생각은 혼잡한 상태군. 생각을 정리하기 위해 해야 할 일을 해라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 62f21052-4c06-150c-50dd-41ac22d4e73f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:62f21052-4c06-150c-50dd-41ac22d4e73f
msgctxt "hc24cfda7g5ee9g46e2gb72eg6bc3c32f8250"
msgid "Quiet. We'll handle this my way."
msgstr "조용히 해. 이건 내 방식으로 해결하자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 634e7f1b-464e-2c5d-08b8-8d1a2846a316
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:634e7f1b-464e-2c5d-08b8-8d1a2846a316
msgctxt "h6dddb133g9c50g430aga982g215f7c8a47d8"
msgid "What greater reward could there be?"
msgstr "이보다 더한 보상이 뭐가 있겠나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 64b784d9-60b6-3ed3-8b43-398884778b33
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:64b784d9-60b6-3ed3-8b43-398884778b33
msgctxt "hde4dbdb1g47f5g49cdg9ad4g5afccb3c5bd3"
msgid "I have orders to capture him."
msgstr "그를 잡아오라는 명령을 받았다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Narrator
#. NodeID = 64bbfda2-803f-dfd5-4b05-bc135a338e7a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_State_TooLowTieflings = True
#. SetFlags:
#.   Global:
#.     - GOB_DrowCommander_Event_ToldAboutDeaths = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:64bbfda2-803f-dfd5-4b05-bc135a338e7a
msgctxt "h0df09dc1gc59bg4c3dg935cge218df7f6089"
msgid "*...and then sees the corpses of those who have already died.*"
msgstr "*...그리고는 이미 죽은 사람들의 시체를 봅니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 65b5ca93-d10d-db53-0f72-f47112b57166
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_DrowCommander_Knows_DrowLeader = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:65b5ca93-d10d-db53-0f72-f47112b57166
msgctxt "h1f2127c3g274eg4630g90fdg16580e87f18f"
msgid "I'm on a hunt, too - you're my prey."
msgstr "나도 사냥 중이야 - 네가 내 희생양이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 667e67f3-2a8e-38bc-f4df-509038a18f6d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DROWHALFELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:667e67f3-2a8e-38bc-f4df-509038a18f6d
msgctxt "head78912gfa72g440ag856ag568116e950f1"
msgid ""
"A half-drow, but a True Soul? The Absolute's blessings may atone for the "
"impurities of your blood."
msgstr "반쪽짜리 드로우가 참된 영혼이라? 절대자께서 은총을 베풀어 네 불순한 혈통을 품어주셨구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 66a61936-5b1c-2ced-8cbf-7a699bde9d8c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_DrowCommander_State_Hostile = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:66a61936-5b1c-2ced-8cbf-7a699bde9d8c
msgctxt "h8e30614cg33e6g4852g836dgdefc68efb7a6"
msgid ""
"I would sacrifice a thousand drow if the Absolute commanded it! You will be "
"the first!"
msgstr "절대자님의 명령이라면 드로우 천 명도 희생시킬 수 있어! 네가 첫 번째가 될 것이다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 68d7d1df-4d0a-d969-be05-0a3bd6edcfa4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:68d7d1df-4d0a-d969-be05-0a3bd6edcfa4
msgctxt "hbdf4bd7dg28a7g43afg81e4gadffa11c271b"
msgid ""
"I would take greater pleasure in killing them myself than in sending them to "
"die in the woods."
msgstr "그놈들을 숲에서 죽게 내버려 두는 것보다 직접 죽이는 게 더 즐거울 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 6969c6fb-9227-0a51-7418-065820cb2c40
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:6969c6fb-9227-0a51-7418-065820cb2c40
msgctxt "hb095825bg4a86g4a7ag9807gdefbac63cbab"
msgid ""
"You will open the gates from the inside when the time is right to strike."
msgstr "공격하기 적절한 때가 오면 네가 안에서 성문을 여는 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 6a579c98-33df-cdd2-958b-af034b28970f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_HappyTorturers_Knows_PlayersKnowDenLocation = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:6a579c98-33df-cdd2-958b-af034b28970f
msgctxt "hfd44a672g4823g4f48g9b2cg88ee332817e9"
msgid ""
"The prisoner talked, with a little encouragement. I know where the others "
"are hiding."
msgstr "그 포로가 약간의 자극을 받고 말했다. 다른 놈들이 어디에 숨어 있는지 내가 알아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 6b48ca18-cdd6-91f2-643c-ef0c9ed48e01
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:6b48ca18-cdd6-91f2-643c-ef0c9ed48e01
msgctxt "hf6fae9a4gbb05g4811gb836g40cec99053f0"
msgid "Quiet. We'll handle this my way."
msgstr "조용히 해. 이건 내 방식으로 해결하자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 6bcc2c85-5ae2-0013-c576-af566c961ccc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:6bcc2c85-5ae2-0013-c576-af566c961ccc
msgctxt "h3d0c75ecg5b1cg4191ga367g80ed4842939f"
msgid "No. This ends now, and so do you."
msgstr "아니. 여기서 끝이다. 네 목숨과 함께 끝내주마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 6bf4ef15-dc61-e09f-be2a-e3db934bf052
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:6bf4ef15-dc61-e09f-be2a-e3db934bf052
msgctxt "hd13cdc6ag96aeg4a9ag8630g44df3a7dbedf"
msgid "Prove yourself worthy, and you will have what you seek."
msgstr "네가 가치 있음을 증명해라. 그러면 네가 원하는 것을 얻을 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 6d97fe6d-e95e-05f9-e77a-92a73a8704f7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:6d97fe6d-e95e-05f9-e77a-92a73a8704f7
msgctxt "h77661c74gb6f3g4586ga70cg46583ab94a9a"
msgid "Why not send a goblin scouting party?"
msgstr "왜 고블린 정찰대를 보내지 않는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 6e000c22-15f6-b234-52da-991913a8e0ca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:6e000c22-15f6-b234-52da-991913a8e0ca
msgctxt "hbffa87fbg8916g4157gadcagb6a57150aa1e"
msgid "And the occasional mass execution does <i>wonders</i> for discipline."
msgstr "게다가 때로는 집단 처형이 기강을 <i>바로잡는</i> 데 효과적이기도 하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 6eecc356-55f6-91ba-b925-7111f949bbb0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:6eecc356-55f6-91ba-b925-7111f949bbb0
msgctxt "h12801d19g34e0g4ac7ga32dg792940a18190"
msgid "It shall be so."
msgstr "그렇게 될 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 7045ca31-7948-493e-b58a-6c728b3819d9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_DrowCommander_Event_Disappointed(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:7045ca31-7948-493e-b58a-6c728b3819d9
msgctxt "h5f5e32ccg3bb8g40ddg8b53g1d2b72446f25"
msgid ""
"Purge yourself of these intoxicants, and come back to me when you are "
"capable of serving as you should."
msgstr "취기를 정화한 다음, 제대로 봉사할 수 있을 때 다시 내게 돌아와라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 707d9b63-12c5-1b92-97c7-27e0f1996870
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:707d9b63-12c5-1b92-97c7-27e0f1996870
msgctxt "hc620a520g8013g416agb1bdg16afad3d130a"
msgid ""
"<i>Fool. </i>You have fallen for his lies. We know that area well - there is "
"nothing hidden there."
msgstr "<i>멍청하기는. </i>너는 그의 거짓말에 속았어. 우리는 그 지역을 잘 알고 있지. 그곳에는 아무것도 숨겨져 있지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 7094bfd8-c3d1-cc62-f717-8e7aefc4420b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:7094bfd8-c3d1-cc62-f717-8e7aefc4420b
msgctxt "h0d4b9bc2gf9d4g4abeg8e4cg3a137751e65b"
msgid "You're right. The Absolute's love is enough."
msgstr "네가 맞아. 절대자님의 총애면 충분하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 719aa79d-df7c-e2f8-f965-28b786097ecd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_Knows_Lockdown = True
#. SetFlags:
#.   Global:
#.     - GOB_DrowCommander_Event_ToldAboutLockdown = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:719aa79d-df7c-e2f8-f965-28b786097ecd
msgctxt "h55528ba5g18cbg4412g900dg28249f6d36f6"
msgid ""
"There's a problem - the druids have performed a ritual to seal the grove."
msgstr "문제가 있어. 드루이드들이 그 숲을 봉인하기 위해 의식을 치뤘어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 71b432e5-f2e1-90da-902e-35fd53a9ce18
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_HappyTorturers_Knows_PlayersKnowDenLocation = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:71b432e5-f2e1-90da-902e-35fd53a9ce18
msgctxt "hfb505f52g1bc5g4675ga135g19d0dcb386a0"
msgid "The prisoner gave up his secrets."
msgstr "포로가 자백했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 71b615cd-0c5b-82cd-aea5-d1567d39535f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_DrowCommander_Knows_Mission(1) = True
#.   Global:
#.     - GOB_DrowCommander_State_ReadyToGo = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:71b615cd-0c5b-82cd-aea5-d1567d39535f
msgctxt "ha06308bbgb970g4abbgad53gf8b7e64dc31a"
msgid ""
"Take care of it <i>quickly</i>. You are needed here, and my patience wears "
"thin."
msgstr "<i>빨리</i> 처리해라. 이곳에는 네가 필요하고, 내 인내심은 약해지고 있으니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 72cbe150-d755-230b-ebe9-0b3e9935f31f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_SpiderNest_Event_Executioner_Push = True
#.   Tag:
#.      - DROWELF(1) = True
#. TagRule: LOLTHDROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:72cbe150-d755-230b-ebe9-0b3e9935f31f
msgctxt "h40f8e7aagbc48g4609gac07g48761206a330"
msgid "How can you allow spiders to be used for bloodsport? It's heresy."
msgstr "어떻게 거미를 투기장에 사용하는 것을 허용할 수 있지? 이것은 이단이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 72cbe150-d755-230b-ebe9-0b3e9935f31f
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_SpiderNest_Event_Executioner_Push = True
#.   Tag:
#.      - DROWELF(1) = True
#. TagRule: SELDARINEDROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:72cbe150-d755-230b-ebe9-0b3e9935f31f
msgctxt "h415c1257ge60cg4736ga300gcbf41b57b1a1"
msgid ""
"I thought spiders were sacred to your kind, yet you use them for bloodsport?"
msgstr "나는 거미가 너희 종족에게 신성한 존재라고 생각했는데, 너는 거미들을 투기장에 사용하는 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 733a7f79-5a2b-1001-5cda-4e3642a9f945
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:733a7f79-5a2b-1001-5cda-4e3642a9f945
msgctxt "h3a621617gbcd5g485eg983aga25dcb977c16"
msgid ""
"The Absolute brought you here for a reason - to throw open those gates so we "
"can crush our enemies."
msgstr "절대자님이 너를 이곳에 데려오신 이유도, 성문을 열어젖혀서 우리의 적들을 짓밟기 위함일 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 7380f250-2eeb-e6dd-f832-392791cea857
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:7380f250-2eeb-e6dd-f832-392791cea857
msgctxt "hda2ed7d0ga5d9g40e5ga546g6f30a928f74f"
msgid "Together, we will slaughter any who remain."
msgstr "함께, 우리는 남아 있는 누구든 도륙낼 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 739a8b28-8e94-3ce2-f326-ee738fa93484
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_DrowCommander_State_Hostile = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:739a8b28-8e94-3ce2-f326-ee738fa93484
msgctxt "h212479afg7947g409agaf8bg72a56be71a88"
msgid "You defy me... You defy the Absolute! Traitor!"
msgstr "날 배신했구나... 절대자님을 배신했어! 배신자!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Lae'zel
#. NodeID = 73dd3be3-6004-04d7-3e54-f3736afbbdd9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_4 = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:73dd3be3-6004-04d7-3e54-f3736afbbdd9
msgctxt "h1032303ag53cfg4659g80e1gd4d53bf4d8b8"
msgid "Send her to the grove. Better to face them on familiar ground."
msgstr "그녀를 숲으로 보내. 익숙한 땅에서 대면하는 게 낫지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 74c50811-6e87-b66c-3de5-217cd4869ae5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:74c50811-6e87-b66c-3de5-217cd4869ae5
msgctxt "hb440c004gceedg43bcga5d1g79d8e5f2f468"
msgid ""
"Control yourself - you are as uncouth as the goblins. The slaughter at the "
"Grove will not begin until you have prepared the way."
msgstr "자제해라. 흥분한 고블린을 보는 것 같군. 숲에서의 학살은 네가 길을 준비할 때까지 시작되지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 76131549-e4d6-ccc1-8047-f32264081708
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:76131549-e4d6-ccc1-8047-f32264081708
msgctxt "hb357cca2g9c54g45ecg8160g5cd76a114848"
msgid "I've done enough. The battle is yours to fight."
msgstr "나는 할 만큼 했어. 싸우는 건 네 몫이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Wyll
#. NodeID = 77b9572b-184f-c2dc-7a5f-ab2f4a82555d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_5 = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:77b9572b-184f-c2dc-7a5f-ab2f4a82555d
msgctxt "h644472aeg030ag41aag8411gd1b6fb9c9ea7"
msgid "Don't you dare lead them to the grove. End her - <i>now</i>."
msgstr "감히 그들을 숲으로 안내할 생각도 하지 마. 그녀를 끝장내, <i>당장</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 79dfe07c-6b2f-f81b-e809-35e2799fa6f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:79dfe07c-6b2f-f81b-e809-35e2799fa6f1
msgctxt "hd5799b12ga173g4ce7g9b09g2bc86a5738be"
msgid ""
"<i>The tieflings should be warned. Together, you can outnumber her "
"warband.</i>"
msgstr "<i>티플링들에게 경고해야 한다. 함께라면, 그녀의 습격대를 수적으로 압도할 수 있을 것이다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 7b0c7412-2f37-39b0-ffba-e27eba4ddff0
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Intelligence
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:7b0c7412-2f37-39b0-ffba-e27eba4ddff0
msgctxt "h49b731f1g6f26g41c8ga197g195d0d262d69"
msgid ""
"<i>Obscure memories of the grove with images of half-remembered places.</i>"
msgstr "<i>반쯤 기억에 남는 장소의 이미지로 숲에 대한 기억을 흐린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 7b30e0c7-55f8-3aee-d3b2-292846b0e277
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:7b30e0c7-55f8-3aee-d3b2-292846b0e277
msgctxt "hf9c313c1gdebbg4f59g88dfga2822c3602a2"
msgid "Then do as you were ordered."
msgstr "그럼 명령 받은대로 움직여."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 7e0299e4-3090-f471-f317-28235defb753
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:7e0299e4-3090-f471-f317-28235defb753
msgctxt "h5d4ba56dg86afg4fffgbfadga48f75a48188"
msgid "<i>Perhaps you can misdirect her... or kill her.</i>"
msgstr "<i>어쩌면 민타라를 틀린 길로 안내하거나... 죽여버릴 수 있을 것 같다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 7ff20008-7208-bfcd-42cb-965cd76763db
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - SCL_Drider_State_HasMintharaSpidersLyre(0) = True
#. SetFlags:
#.   Object:
#.     - GOB_DrowCommander_Event_GivePlayerSpiderLyre(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:7ff20008-7208-bfcd-42cb-965cd76763db
msgctxt "hdfc4f496g35d9g4f06gbc50g38f377a259bd"
msgid "Take it - I do not need a guide, I need a hunter. Will you join me?"
msgstr "가져 가. 난 안내자가 필요없어. 사냥꾼이 필요하지. 내게 동참할건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 8192936f-855f-f872-abaf-889400dfc806
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:8192936f-855f-f872-abaf-889400dfc806
msgctxt "h7dedef9fg5fa9g40a3gb496g4dfa8f7d6812"
msgid "Do you have any leads?"
msgstr "단서는 있나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 82eaefae-95a6-8b24-ff1a-e372384b85b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:82eaefae-95a6-8b24-ff1a-e372384b85b3
msgctxt "hc1083f6bg0aa5g4e4agaa72g3054ba852c97"
msgid "They're half-devil refugees... Nobody wants them."
msgstr "그들은 데빌의 피가 섞인 난민들이어서... 아무도 그들을 반기지 않지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 837b5652-a667-546c-733a-7a2b16bdc085
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:837b5652-a667-546c-733a-7a2b16bdc085
msgctxt "h68829eecg4764g4326ga903g583b6d60c87a"
msgid "Ready? Let's take her out."
msgstr "준비됐어? 그녀와 결판을 낼 시간이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 8390ddec-9665-3d4b-d789-b0c934a9ccf3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_State_TooLowTieflings = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:8390ddec-9665-3d4b-d789-b0c934a9ccf3
msgctxt "h4fb936b2gcbfcg4e09gbe9cg25899c0b2c22"
msgid "<i>The grove's inhabitants are weak - it's ready to fall.</i>"
msgstr "<i>숲의 거주자들은 약하다 - 숲은 언제든지 몰락할 것이다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 8484ed16-ddbe-0eea-c370-18e6405de5a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:8484ed16-ddbe-0eea-c370-18e6405de5a4
msgctxt "h282d39f1gd83dg44a6g9d2agb4a8700f6e31"
msgid "Nothing makes the blood hotter. Let's hunt."
msgstr "이보다 더 피를 달아오르게 하는 건 없지. 사냥을 시작하자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 85793d15-3aaf-efd0-976c-a3218243f49e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:85793d15-3aaf-efd0-976c-a3218243f49e
msgctxt "h68df583eg2f79g4069ga2cagd575f4f71ca6"
msgid "Yes. I suppose I might offer passage. But first - we hunt."
msgstr "그래. 내가 통과하게 해줄 수 있을 것이다. 하지만 우선, 우리는 사냥해야 한다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 858d5a1f-ff77-a099-37d4-8d2434e59693
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:858d5a1f-ff77-a099-37d4-8d2434e59693
msgctxt "h492d7d16g12edg4f9agb2fag809020416fe5"
msgid "Now, you must hunt with me. In Her name."
msgstr "이제, 너는 나와 함께 사냥해야 한다. 그분의 이름으로."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 85997b49-5453-cd82-6c4f-cbf705d03129
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_RaidingParty_Event_StartConfrontation = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:85997b49-5453-cd82-6c4f-cbf705d03129
msgctxt "h69a5530bg9e27g4e89g89c9g90f859492298"
msgid "I know the place - it's east of here. A grove of some kind."
msgstr "그 장소를 알아. 여기서 동쪽에 있어. 일종의 숲이더군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 870f6d6c-a546-56b5-d9b1-7a4675e9781d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_DrowCommander_Event_SentScouting(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:870f6d6c-a546-56b5-d9b1-7a4675e9781d
msgctxt "ha01f4060g872bg4f4cga49fged0e678253b4"
msgid "I trust you have found the sanctuary? I hunger for battle."
msgstr "그 안식처를 찾았겠지? 나는 전투에 굶주렸다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 88199c30-1058-52ff-73ad-3b5cbdeabbf5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:88199c30-1058-52ff-73ad-3b5cbdeabbf5
msgctxt "h575b4702g24b3g4effga1c7g434b90214d86"
msgid ""
"So close! Their fate is sealed - and you will be instrumental in the "
"slaughter."
msgstr "이토록 가깝다니! 그들의 운명은 정해졌다. 너는 이 학살에 중요한 역할을 하게 될 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Wyll
#. NodeID = 892639c1-424b-0a31-61e6-c7035da9a1ec
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_5 = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:892639c1-424b-0a31-61e6-c7035da9a1ec
msgctxt "h9d8be34egb367g48a2gb957g2c3fa365c39f"
msgid "We can't let them find the grove. End her - <i>now</i>."
msgstr "그들이 숲을 찾아내게 둘 수는 없어. 그녀와 결판을 내자. <i>당장</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 8957e0a7-2aa6-8039-4e62-9db07e5203b9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule: OATHBREAKER
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:8957e0a7-2aa6-8039-4e62-9db07e5203b9
msgctxt "hde46a7afg6f39g4a0dg8e99g48c31ed17884"
msgid "You cannot bind me to your god's whims, True Soul. I will not let you."
msgstr "너는 나를 네 신의 변덕에 묶을 수 없다, 참된 영혼. 그렇게 두지 않겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 8957e0a7-2aa6-8039-4e62-9db07e5203b9
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:8957e0a7-2aa6-8039-4e62-9db07e5203b9
msgctxt "h32b7d609g876eg4221gad5fg7f2cd4e10197"
msgid "I don't need your fledgling god's favour. My oath is all I need."
msgstr "네 어린 신의 호의는 필요 없다. 내게 필요한 건 맹세뿐이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 899e7131-a5e0-82e9-3474-39287b159bef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:899e7131-a5e0-82e9-3474-39287b159bef
msgctxt "h9574e74cg3a83g4938gb7e7g44be0d9d53c3"
msgid "Did he tell you where his friends are hiding before he fled?"
msgstr "그가 도망치기전에 그의 친구들이 어디 숨어 있는지 말했어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 8a5e49a3-8b13-cc92-5640-26e7ccffa81f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_State_TooLowTieflings = True
#. SetFlags:
#.   Global:
#.     - GOB_DrowCommander_Event_ToldAboutDeaths = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:8a5e49a3-8b13-cc92-5640-26e7ccffa81f
msgctxt "h18befb6cg4d7cg4fc6gbe7dgdc4e423a5c94"
msgid ""
"The place you seek is a grove - many of the inhabitants are already dead."
msgstr "당신이 찾고 있는 곳은 많은 주민들이 이미 죽어 있는 숲이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Narrator
#. NodeID = 8ae269d2-ca34-4036-102b-40ebc0927e2e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:8ae269d2-ca34-4036-102b-40ebc0927e2e
msgctxt "h23f7bdeagcb3dg4037gb411g536e89c68b52"
msgid ""
"*The chamber melts away to reveal a dark, endless nowhere. In it, you see a "
"vision - the drow listens as a pale-eyed young woman whispers in her ear.*"
msgstr ""
"*방이 녹아내리면서 어둡고 끝이 보이지 않는 공간이 드러납니다. 그 안에서, 당신은 환상을 봅니다. 창백한 눈을 가진 젊은 여성이 이 "
"드로우의 귀에 속삭이고, 그녀는 이를 듣습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Rozzak
#. NodeID = 8aede012-a89d-73e8-01d7-9ee5c9bc1e37
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:8aede012-a89d-73e8-01d7-9ee5c9bc1e37
msgctxt "h41b36398gdf71g4756g9052g82c8e6a2c0e4"
msgid ""
"I ain't no use without my limbs! The lads'll make the prisoner squeal soon "
"enough, I swear!"
msgstr "팔 다리가 없으면 전 쓸모가 없습니다! 부하들이 곧 그 죄수를 다 불게 할겁니다. 맹세합니다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 8bce106b-fe6b-cb72-a3c4-48de7ff9eb46
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:8bce106b-fe6b-cb72-a3c4-48de7ff9eb46
msgctxt "h87f06bb8g57b7g41e0gb658g83e7aa3407bf"
msgid ""
"Yes. I suppose I might offer you passage. But first you will raze the grove "
"and honour our mistress."
msgstr "그래. 내가 길을 안내해 줄 수도 있겠지. 하지만 먼저 그 숲을 파괴하여 우리의 여주인을 기려라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 8bf495fe-58c3-5e86-9317-7d2c0f7ac883
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:8bf495fe-58c3-5e86-9317-7d2c0f7ac883
msgctxt "h3119ec6egebc2g42e1gbf6bga8206a40d5f6"
msgid "Praise be to Her!"
msgstr "그분께 찬사를!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Narrator
#. NodeID = 8c5e2ebe-45fa-6de9-6598-b9ec10c9eff0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_Knows_Lockdown = True
#. SetFlags:
#.   Global:
#.     - GOB_DrowCommander_Event_ToldAboutLockdown = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:8c5e2ebe-45fa-6de9-6598-b9ec10c9eff0
msgctxt "he46960a3ge4d8g4773g9d0fge0a41dbc6d39"
msgid ""
"*...and then sees vines covering the entrance, sealing the grove from the "
"inside.*"
msgstr "*...그리고는 덩굴이 입구를 덮고 숲을 안쪽에서 봉쇄하는 것을 봅니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 8d22a2c3-8b46-1f73-0425-8b91a603b690
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#.   User:
#.      - GOB_DrowCommander_UserShortcut(1) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_DrowCommander_HasMet(1) = True
#.   User:
#.     - GOB_DrowCommander_UserShortcut(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:8d22a2c3-8b46-1f73-0425-8b91a603b690
msgctxt "hd7427074gee1dg4f11gba10gdd67a98c1014"
msgid ""
"Your scouting party has not returned, and half of the intruders escaped your "
"guards."
msgstr "정찰대가 돌아오지 않았고, 침입자 중 절반이 경비병을 피해 도망쳤다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 8d7a7e61-1de7-b748-6e86-043522ecaead
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:8d7a7e61-1de7-b748-6e86-043522ecaead
msgctxt "h8f7a8d57ge9e1g4df2ga005g3856375f3b8b"
msgid "You are sure? And how did <i>you</i> find it?"
msgstr "확실한가? 그리고 <i>너는</i> 어떻게 알고 있는 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 8f9dedfd-9987-2a5e-0a8b-396f008c9ba1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Absolute_Knows_MoonriseTowers = True
#.      - GOB_DrowCommander_Quest_AskedAboutPassage = False
#. SetFlags:
#.   Global:
#.     - GOB_DrowCommander_Quest_AskedAboutPassage = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:8f9dedfd-9987-2a5e-0a8b-396f008c9ba1
msgctxt "hf5c4e5dbg2e32g4205g8119g75c713de5872"
msgid "I have business at Moonrise. Can you provide safe passage?"
msgstr "문라이즈 타워에 가서 할 일이 있는데. 안전한 통로를 알려 줄 수 있어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 8fabf31d-b729-2cb4-5250-ec0550cdc936
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:8fabf31d-b729-2cb4-5250-ec0550cdc936
msgctxt "h055dfd47g4ce6g4c84gbcb6gee785f03ad5f"
msgid "Quiet. I have everything under control."
msgstr "조용히 해. 모든 건 계획대로야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 91d89dab-47ff-ed48-0a90-34801d4e7322
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_DrowCommander_Knows_Mission(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:91d89dab-47ff-ed48-0a90-34801d4e7322
msgctxt "h5e70b930ge7e6g4cc4gb5ddg18be8182c9e7"
msgid ""
"Go. Serve our god as you must. But when your work is done, I will be "
"waiting. Together, we will <i>burn</i> that place."
msgstr "가라. 운명대로 우리의 신을 섬겨라. 너의 일이 끝나면 기다리고 있겠다. 함께, 우리는 그 곳을 <i>불 태울</i> 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 92119abf-aa8e-1c37-aa49-3f979773c49a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:92119abf-aa8e-1c37-aa49-3f979773c49a
msgctxt "h372f5e1cgc1d3g4dcfgabc0g8877592d547b"
msgid ""
"Yes - I suppose I might offer you passage. But first you will obey my "
"command in Her mighty name."
msgstr "그래. 내가 길을 안내해 줄 수도 있겠지. 그런데 먼저 네가 나의 명령을 따라야 해. 절대자의 강력한 이름으로."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 9256ad78-1d85-6f9f-67e4-4bcac30a1c52
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:9256ad78-1d85-6f9f-67e4-4bcac30a1c52
msgctxt "h93b9a741g3037g4eb1gb460gbdb3f3d62cff"
msgid ""
"And you believe their god's roots and branches can stand against the "
"Absolute's fury?"
msgstr "그런데 너는 그들 신의 뿌리와 가지들이 절대자의 분노에 맞설 수 있을 거라고 믿나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 92e3becb-a3b8-d15f-679b-3892206bac5d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_DrowCommander_Event_AskedToTorture(1) = True
#.   Global:
#.     - GOB_DrowCommander_Event_GoTorturePrisoner = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:92e3becb-a3b8-d15f-679b-3892206bac5d
msgctxt "h0eb07d35g4626g4c7agaea4g382775661ca1"
msgid ""
"Assist the goblins with their interrogation - the prisoner can tell us what "
"you cannot."
msgstr "고블린들이 심문하는 걸 도와라. 그 포로가 너에게 없는 정보를 말해줄 수도 있으니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 930c83fa-dab4-140c-322b-104aad87687c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:930c83fa-dab4-140c-322b-104aad87687c
msgctxt "he984dfd9g5279g443dgb12bgaa33026ae1e9"
msgid "Here are your new orders."
msgstr "새 명령을 주겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 937bafd8-dd13-b801-46c6-0763854b6089
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:937bafd8-dd13-b801-46c6-0763854b6089
msgctxt "h90755a5cgf526g434fg9ca2g108f3bf8c98a"
msgid "And when they are dead, the Absolute will reward your faith. As will I."
msgstr "그리고 그 녀석들이 죽으면, 절대자님이 너의 충성에 보답해 주실 것이다. 내 보답과 더불어서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 937d1d48-9c7b-29e2-2a2d-269607ae2003
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:937d1d48-9c7b-29e2-2a2d-269607ae2003
msgctxt "h83d0d0ccg8259g4d3cg96a8g8441d4e29279"
msgid "Get out of my mind."
msgstr "내 머릿속에서 나가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 93aed6ba-827f-f788-34ac-d2adae7a7e27
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 20
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:93aed6ba-827f-f788-34ac-d2adae7a7e27
msgctxt "hb610f816ga400g43d2g9e09gbf21f706cf3e"
msgid "Do not question me. I am the Absolute's Chosen."
msgstr "나를 의심하지 마. 나는 절대자님의 선택을 받은 자다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 947b190c-1490-1402-48b2-b21f54549cc7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - FEMALE(1) = True
#.      - DROWELF(1) = True
#. SetFlags:
#.   Dialog:
#.     - GOB_DrowCommander_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:947b190c-1490-1402-48b2-b21f54549cc7
msgctxt "h95b5522dgdeb6g4596g9a41g46cbde24e968"
msgid "I do not have time for interruptions, sister."
msgstr "방해 받을 시간이 없다, 자매여."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 94f41ebd-655c-9183-380c-294adfd7d253
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:94f41ebd-655c-9183-380c-294adfd7d253
msgctxt "h77bbec8cgfa9cg4335g8fbcgdd3af2470da1"
msgid "You'll have to go through me to get to the grove."
msgstr "그 숲에 가려면 나부터 뚫어야 할 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 94f5862b-0f45-e3e4-3ab1-2ca13bd38596
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:94f5862b-0f45-e3e4-3ab1-2ca13bd38596
msgctxt "hbf4a1517gaa8dg4d29gb791g9402dc630689"
msgid "Nothing stays hidden from me."
msgstr "아무것도 내게서 숨을 순 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Wyll
#. NodeID = 952da623-751e-dd28-de05-6d14b85a33ce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:952da623-751e-dd28-de05-6d14b85a33ce
msgctxt "h1bb3bae7g9063g4c35g826egca2505c1bdad"
msgid "Do you, though?"
msgstr "하지만, 진심이야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Lae'zel
#. NodeID = 9545220b-9532-950d-d752-04f13cad7693
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:9545220b-9532-950d-d752-04f13cad7693
msgctxt "hacdb447bgb100g4907gb908g73703d40bcd8"
msgid ""
"Even a <i>kith'rak</i> might struggle to slay them here. At the grove, we "
"have an advantage."
msgstr "<i>키스락</i> 조차도 여기서 그들을 베어버리는 게 벅찰걸. 숲에서는 우리가 유리해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 955a37d2-35c7-a142-98e8-8ba354a60831
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:955a37d2-35c7-a142-98e8-8ba354a60831
msgctxt "h7ba7beb0g64d7g4d49gaa9eg990a28d2daeb"
msgid "But they do not have the wits to lead this hunt with me. Do you?"
msgstr "하지만 나와 함께 이 사냥을 주도할 만한 지혜는 없다. 너는 어떤가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 9745dc18-05e6-7a74-664d-d373913efd9c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_DrowCommander_Knows_DrowLeader = False
#.   Tag:
#.      - ELF(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:9745dc18-05e6-7a74-664d-d373913efd9c
msgctxt "hcf4517e4g2d2ag4832gbef1gb93e1f6b0da2"
msgid "Join you? I'm here to kill you."
msgstr "너에게 합류하라고? 나는 너를 죽이러 온 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 97ea0799-18ab-ff2e-0fc4-ae4d2aecf0db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:97ea0799-18ab-ff2e-0fc4-ae4d2aecf0db
msgctxt "hc5e6eff1gcaddg49dfgaf81gdd6a57453754"
msgid ""
"I have not seen this druid, but he harbours worshippers of a false god in a "
"hidden grove nearby."
msgstr "그 드루이드를 본 적은 없지만, 그는 인근의 숨겨진 숲에 가짜 신을 숭배하는 자들을 수용하고 있다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Wyll
#. NodeID = 98d14e2a-462c-6dcf-e2f7-8661a9fff98a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:98d14e2a-462c-6dcf-e2f7-8661a9fff98a
msgctxt "h9e251ef7g1f33g4074g8aa1g75f77ae11d5c"
msgid ""
"Gods damn it <i>all</i>. To the grove - quickly. We can't let it fall to "
"these vicious bastards."
msgstr "<i>전부</i> 망했잖아. 빨리 숲으로 가자. 그 사악한 개자식들 수중에 떨어지게 둘 순 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 9aee3aba-87b7-88ac-d1b8-3e4c415f31bc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Absolute_Knows_MoonriseTowers = True
#.      - GOB_DrowCommander_Quest_AskedAboutPassage = False
#. SetFlags:
#.   Global:
#.     - GOB_DrowCommander_Quest_AskedAboutPassage = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:9aee3aba-87b7-88ac-d1b8-3e4c415f31bc
msgctxt "he681cedeg9c29g4944gab40gfbb4a34a0bc9"
msgid ""
"I spoke to Nere. He said you could provide safe passage to Moonrise Towers."
msgstr "니어와 대화했다. 네가 문라이즈 타워로 가는 안전한 통로를 제공해 줄 수 있다더군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 9b63ed7d-bdd2-912d-b515-7817cdfaf913
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:9b63ed7d-bdd2-912d-b515-7817cdfaf913
msgctxt "h34f43ec4gdee3g447cg9729g1a8fbbdf2d3c"
msgid "Without gold, I can't serve the Absolute efficiently."
msgstr "금화 없이는, 절대자님을 효과적으로 모실 수 없지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = 9bfe3d8f-c6ff-5836-c25f-05df3107e0d9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_DrowCommander_Knows_DrowLeader = False
#.   Tag:
#.      - ELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:9bfe3d8f-c6ff-5836-c25f-05df3107e0d9
msgctxt "h49b279b3g9e0fg48d0gb636g53ad704b3448"
msgid "Obey you? I'm here to kill you."
msgstr "네게 복종하라고? 난 널 죽이러 왔다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Narrator
#. NodeID = 9c56d8b7-a1ba-1c2e-afe4-208374372bde
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:9c56d8b7-a1ba-1c2e-afe4-208374372bde
msgctxt "h8d1a6a35g4708g4304g9f02gd54ae10c55a1"
msgid ""
"*The masterful painting she depicts of the massacre awakens you hungrily.*"
msgstr "*그녀가 묘사한 학살에 대한 훌륭한 그림은 당신의 배고픔을 일깨워줍니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 9cfe26e6-9842-0cd2-2778-b290d157c3b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:9cfe26e6-9842-0cd2-2778-b290d157c3b3
msgctxt "ha46f9c74g1b00g4606g9b01g82cfc4fdf669"
msgid "You are a True Soul? Little wonder that you serve me so well."
msgstr "참된 영혼이었군? 날 어떻게 그리 잘 섬겼는지 알겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = 9f6996cd-2760-8a37-6112-bc5caa4d2a56
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_DrowCommander_State_Hostile = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:9f6996cd-2760-8a37-6112-bc5caa4d2a56
msgctxt "h4f0633c3g8f90g4710g8e01g5c4717dbc793"
msgid "You would dare...? The darkness will take you, <i>iblith</i>!"
msgstr "네가 감히...? 어둠이 너를 데려갈 것이다, <i>이블리스</i>!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = a088af4e-8678-2dbf-0e3a-6b2019394bf4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:a088af4e-8678-2dbf-0e3a-6b2019394bf4
msgctxt "h4f5d7c52gc1bag45bdga452gf68705852e53"
msgid ""
"And when we destroy the trappings of this false god, the Absolute will "
"reward us with such <i>power</i>."
msgstr "그리고 우리가 가짜 신의 우상들을 파괴하면, 절대자님은 우리에게 엄청난 <i>힘</i>으로 보답해 주실 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = a28fa5a4-82e5-a943-2b4f-0031026c462d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:a28fa5a4-82e5-a943-2b4f-0031026c462d
msgctxt "h0de38bb6g88ecg4185g83c2gb674359821c1"
msgid ""
"These creatures have failed me <i>again</i>? I will deal with those "
"responsible later."
msgstr "이 괴물들이 <i>다시</i> 나를 실망시켰어? 그 일은 나중에 책임을 묻도록 하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Rozzak
#. NodeID = a2a85b4a-bbbc-c2a3-5e7f-9dd72e5b8af7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:a2a85b4a-bbbc-c2a3-5e7f-9dd72e5b8af7
msgctxt "hb688daf9g58e9g40ccgbbd5gd7b946a30349"
msgid "Sorry, mistress. We mucked up."
msgstr "죄송합니다, 마님. 우리가 망쳤어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = a2d5a5a0-2ac6-fafb-457c-7ef1d3a12193
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:a2d5a5a0-2ac6-fafb-457c-7ef1d3a12193
msgctxt "h04bf2ba2g777eg4655g804ag65a48b9187fd"
msgid "Enough. Do not interrupt me!"
msgstr "그만. 방해하지 마!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = a2f023dd-f9db-fee3-7680-1367545c7bdc
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 12
#. CheckFlags:
#.   Global:
#.      - GOB_DrowCommnader_Knows_HasSpiderLyre = True
#.   Object:
#.      - SCL_Drider_State_HasMintharaSpidersLyre(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:a2f023dd-f9db-fee3-7680-1367545c7bdc
msgctxt "h3f8d4a5ag1402g4079g999ag6b0b5d35537d"
msgid "I require something from you - a lyre, capable of summoning a guide."
msgstr "당신으로부터 필요한 게 있어. 안내자를 소환할 수 있는 리라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = a389a25f-feff-4e98-59bd-1a2d57af4e04
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:a389a25f-feff-4e98-59bd-1a2d57af4e04
msgctxt "h7fd2a4f2g733cg48c9g9cdfg63b30977fa41"
msgid "If you played a part in thinning their numbers, I commend your efforts."
msgstr "그들의 수를 줄이는데 일조를 한 것이라면, 너의 수고를 치하하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = a486e075-4171-0b0f-bed0-5cff09cc9b9c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:a486e075-4171-0b0f-bed0-5cff09cc9b9c
msgctxt "h563beca8g14b7g4218gbb10ga6db382f7ba5"
msgid "I will gather my forces nonetheless and reach the grove by next light."
msgstr "어쨌든 나는 군대를 모아서 다음날이 밝기전에 그 숲에 도착하겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = a4a7ef5f-f9b1-f47d-6978-a3b60b9431a5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_State_TooLowTieflings = True
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#. SetFlags:
#.   Global:
#.     - GOB_DrowCommander_Event_ToldAboutDeaths = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:a4a7ef5f-f9b1-f47d-6978-a3b60b9431a5
msgctxt "h48d14624gf311g4b42g926bg72ab2e5c35f9"
msgid "I killed a lot of them already. I couldn't help myself."
msgstr "그들을 이미 많이 죽였어. 어쩔 수 없게도."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = a5692f68-7f60-726b-dc1b-becab5cb1956
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_DrowCommander_State_Hostile = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:a5692f68-7f60-726b-dc1b-becab5cb1956
msgctxt "h2b465d8bg4a68g4a11ga92dg8f3725e44e21"
msgid "If that is true, killing you will prove my superiority."
msgstr "그게 사실이라면, 너를 죽이는 것이 내 우월함을 증명하겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = a5dd1ad6-8695-28d9-6e9f-e51dc4063d8f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:a5dd1ad6-8695-28d9-6e9f-e51dc4063d8f
msgctxt "hb5c9ea9dg99b0g4eecgb3ffg15671c2739dd"
msgid ""
"A drowning creature will cling to a blade if nothing else is offered. Be "
"that blade."
msgstr "물에 빠진 생물은 아무것도 없을 때 칼날에라도 매달릴 것이다. 그 칼날이 되어라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = a8e994e0-d760-84a6-753d-3ab5207234d6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - FEMALE(1) = True
#.      - LOLTHDROWELF(1) = True
#. TagRule: DROWELF and FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:a8e994e0-d760-84a6-753d-3ab5207234d6
msgctxt "hecd0f0a5ga5fcg4795g8c8fg919817f6cf82"
msgid "Yes, sister. Together, we shall burn it to the ground."
msgstr "그래, 자매여. 우리가 같이 불태워버리는 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = a9b5f80d-4867-e6de-cb58-d0e07f48ce44
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_State_TooLowTieflings = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:a9b5f80d-4867-e6de-cb58-d0e07f48ce44
msgctxt "h2efd0b7bga2a5g4ce4gb22cgff900ea1e5c0"
msgid ""
"<i>Leading her to the tieflings might doom them... but it would earn you her "
"trust.</i>"
msgstr "<i>민타라를 안내하면 티플링들이 몰살당할지도 모른다... 하지만 그녀의 신뢰를 얻을 수 있다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = aa33062a-4e45-ea19-c240-20c8e539c69f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:aa33062a-4e45-ea19-c240-20c8e539c69f
msgctxt "h3a1891c0g6159g47afgb0bdg24fea6d616da"
msgid "How do you know I'm a True Soul?"
msgstr "내가 참된 영혼이라는 건 어떻게 알았지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = aaf22cc2-28f3-6d98-17b7-8054755e267b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:aaf22cc2-28f3-6d98-17b7-8054755e267b
msgctxt "h79994151gc39cg44f9g8bb8g7fac94a1011e"
msgid "I've heard rumours that he's a very powerful healer."
msgstr "나는 그가 매우 강력한 치유사라는 소문을 들었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = ab522d86-7da8-1f9d-7bf7-9a589f9dad6b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:ab522d86-7da8-1f9d-7bf7-9a589f9dad6b
msgctxt "h6fe5ef18g336eg4a7eg8460gddc9b035ce08"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = ac29c072-8799-e96f-8c82-c0396c96f269
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:ac29c072-8799-e96f-8c82-c0396c96f269
msgctxt "hbc83cc66gb80ag4086gaefeg8ce16e2f7e79"
msgid "If you were sent here to hunt him, perhaps you can help me."
msgstr "네가 그를 사냥하러 여기 왔다면, 나를 도울 수 있겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = ac2de97f-0d17-547b-f1bd-e1bbfee673eb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:ac2de97f-0d17-547b-f1bd-e1bbfee673eb
msgctxt "h7f8068a3gd960g4809g92bfge066192aff26"
msgid "We are servants of the one true <i>god</i>, not mercenaries."
msgstr "우리는 용병이 아니라, 진정한 <i>유일신</i>의 종복이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = ac4f1d45-c887-336d-1f7e-fe720f3c6243
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_State_TooLowTieflings = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:ac4f1d45-c887-336d-1f7e-fe720f3c6243
msgctxt "h470a52cag9ee5g4acega102gcf7bff028257"
msgid ""
"<i>Even with the grove's numbers depleted, dealing with her there may be "
"safer than fighting here.</i>"
msgstr "<i>숲의 인원이 고갈된 상태긴 하지만, 이곳에서 싸우는 것보다 그곳에서 그녀를 상대하는 것이 더 안전할 수 있다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = aca9cca8-5d7c-c3ee-d42c-879e91f63561
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_DrowCommander_Event_SentScouting(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:aca9cca8-5d7c-c3ee-d42c-879e91f63561
msgctxt "h097a2a8fg49deg42e9g95fegddc6a010c0db"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = ae55af81-2a5c-d815-7ba3-fd4e25861794
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_HappyTorturers_Knows_PlayersKnowDenLocation = False
#. SetFlags:
#.   Quest:
#.     - DEN_Conflict_SUB_AoD.AskedTorture(1) = True
#. TagRule: HALFORC
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:ae55af81-2a5c-d815-7ba3-fd4e25861794
msgctxt "h17229d52g0923g41bagbf14g081e59c2800f"
msgid ""
"If the prisoner is as cowardly as most humans, I just need to pay him a "
"visit."
msgstr "만약 그 죄수가 대부분의 인간들처럼 겁쟁이라면, 그냥 내가 그를 방문하기만 하면 돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = ae55af81-2a5c-d815-7ba3-fd4e25861794
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_HappyTorturers_Knows_PlayersKnowDenLocation = False
#. SetFlags:
#.   Quest:
#.     - DEN_Conflict_SUB_AoD.AskedTorture(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:ae55af81-2a5c-d815-7ba3-fd4e25861794
msgctxt "hdd6264b6g7f32g42feg907egae721e814d90"
msgid "I can be very persuasive - I'll visit the prisoner."
msgstr "내가 아주 잘 설득할 수 있다. 그 포로를 만나보겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = ae662a7d-7121-c05c-c267-f8fd09389919
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_DrowCommander_State_ReadyToGo = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:ae662a7d-7121-c05c-c267-f8fd09389919
msgctxt "h76cbafccg8ee4g412fga171g19b5b0bfb757"
msgid "The cowards found refuge among the desperate. <i>Perfect. </i>"
msgstr "겁쟁이들이 절망적인 자들에게 둘러싸인 피난처를 세웠군. <i>완벽해. </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = ae71dec9-508e-f9de-0c3d-009a69c7327a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:ae71dec9-508e-f9de-0c3d-009a69c7327a
msgctxt "h1c5e13e3gb7d2g430fga17ege4322859b384"
msgid ""
"Her heart is more generous than mine. Join my hunt, <i>faerie</i>. And obey "
"me."
msgstr "나보다 너그러운 심성을 지니셨어. 내 사냥에 동참해라, <i>페어리</i>. 그리고 내 명령에 복종해라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = af1c7e42-8090-3ed6-a56e-e49951d642c2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:af1c7e42-8090-3ed6-a56e-e49951d642c2
msgctxt "he74351d1ga8d9g4a2bgb4efgf46ab7881777"
msgid "<i>Perhaps you can misdirect her... or kill her.</i>"
msgstr "<i>어쩌면 민타라를 틀린 길로 안내하거나... 죽여버릴 수 있을 것 같다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = af760b8c-d6dd-f812-edfb-a0a2f51f747c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:af760b8c-d6dd-f812-edfb-a0a2f51f747c
msgctxt "h230ee2c2g9f9eg4686gab5bga03e653bf4f8"
msgid ""
"They are flocking to the Absolute. In sufficient numbers, they are an "
"effective force. Expendable and willing."
msgstr "그들은 절대자님을 따르고 있다. 적당히 모이면, 효과적인 힘을 발휘하지. 소모품인 주제에 자발적이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = b32ecae7-3af7-fc12-0433-f3c7fed54ccd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_Knows_LeaderNameDrow = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:b32ecae7-3af7-fc12-0433-f3c7fed54ccd
msgctxt "hbbd2c127gdb55g4c7egb8a7gc890165532d9"
msgid ""
"It is time for the raid to begin. The grove, and those who are hiding there, "
"will fall."
msgstr "습격을 시작할 때다. 숲과 그곳에 숨어있는 자들은 몰락하리라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = b40db834-9cdb-721a-4605-603835d00afd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_DrowCommander_Event_RaidersSortie = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:b40db834-9cdb-721a-4605-603835d00afd
msgctxt "h8e4e037bge187g4792ga60bga88aff5a4dca"
msgid "Join me and my warband at the entrance. Either it falls, or you do."
msgstr "입구에서 나랑 내 군대에 합류해. 그 곳이 함락 되든가, 네가 쓰러지든가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = b4f78e69-1e2e-cd75-af7c-42f27e221dd0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:b4f78e69-1e2e-cd75-af7c-42f27e221dd0
msgctxt "headfdebeg41eeg46f7ga34bgf5e67e327168"
msgid ""
"Fine. I will share what I have. But keep it to yourself; the goblins would "
"squander it."
msgstr "좋아. 내가 가진 것을 나눠주지. 하지만 비밀로 해. 고블린들은 탕진해 버릴 거니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = b60903e2-237e-486e-e963-bc7c1974dffd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_DrowCommander_Event_OrderedToJoinHunt(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:b60903e2-237e-486e-e963-bc7c1974dffd
msgctxt "h7527c7d0g3ae1g4376g954ag101cbc9d02b1"
msgid "A hunt? Who's the target?"
msgstr "사냥이라고? 누가 목표지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = b6c191e7-f1d4-5fd7-86a0-97ed769d4f4b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_RaidingParty_Event_StartConfrontation = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:b6c191e7-f1d4-5fd7-86a0-97ed769d4f4b
msgctxt "he86910dbge22dg4af4ga5b0g9ef600281b55"
msgid ""
"We don't need the prisoner. I already know the place you're looking for."
msgstr "그 포로는 필요없어. 나는 이미 네가 찾고 있는 장소를 알고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = b6f51e1b-9b3f-ad75-a4ef-d3cfd53eb6bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:b6f51e1b-9b3f-ad75-a4ef-d3cfd53eb6bf
msgctxt "h37cf1907ge9beg493ag9a3cg4b435b87da0d"
msgid ""
"I do not intend to lead a suicidal charge. The goblins are expendable; I am "
"not."
msgstr "자살 돌격을 주도할 생각은 없다. 고블린은 소모품이지만, 나는 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = b771b5e8-364d-1649-122c-b0c3c8157c88
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:b771b5e8-364d-1649-122c-b0c3c8157c88
msgctxt "he4bd1821g9429g4c43g957bg7b2ccc981620"
msgid "The Absolute guided me."
msgstr "절대자님이 인도해 주셨지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = bb4342f0-9731-36c4-0931-73ba983e6d13
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_HappyTorturers_Knows_PlayersKnowDenLocation = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:bb4342f0-9731-36c4-0931-73ba983e6d13
msgctxt "hf3215acegd741g4eccgbecdg13441513ecb8"
msgid "I spoke to the prisoner. He told me everything."
msgstr "포로와 얘기를 나눴다. 모든 걸 실토하더군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Narrator
#. NodeID = bb6ab14c-9865-2731-2bfe-5ec3e6296fba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:bb6ab14c-9865-2731-2bfe-5ec3e6296fba
msgctxt "ha66033fagda50g4ea9gaeb7gec8854d3b9cd"
msgid ""
"*Her mind focuses - the cultists cannot discover that the weapon they seek "
"is within their grasp.*"
msgstr ""
"*그녀가 정신을 집중합니다. 이 이교도들의 의심을 불러와서는 안 됩니다. 그들이 찾고 있는 무기가 바로 그들 눈앞에 있다는 사실을 알게 "
"할 수는 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = bdd06781-ec1f-981a-0daf-659cd22aeeb3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_DrowCommander_Knows_AskedAboutWeapon = False
#. SetFlags:
#.   Global:
#.     - GOB_DrowCommander_Knows_AskedAboutWeapon = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:bdd06781-ec1f-981a-0daf-659cd22aeeb3
msgctxt "h38370f08ge485g4543ga50dg6a701e22a254"
msgid "What's so important about this sanctuary?"
msgstr "이 안식처가 왜 그렇게 중요하지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = bf1284a4-a66a-3961-6610-a03dd2b1c5ef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:bf1284a4-a66a-3961-6610-a03dd2b1c5ef
msgctxt "h2b9673e9g704cg4178gb751gd5093d92f970"
msgid ""
"We will cleanse the place of infidels and burn it to the ground in the "
"Absolute's name."
msgstr "우리는 절대자님의 이름으로 불경한 자들의 장소를 정화하고 불태울 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = bf33efbd-3df4-649d-b564-8d969e63ae67
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:bf33efbd-3df4-649d-b564-8d969e63ae67
msgctxt "he78deb3dg9076g4433ga782g432e8356a88b"
msgid "<i>Promise yourself: you will save them. From her, and you.</i>"
msgstr "<i>당신 스스로에게 다짐한다. 당신은 그들을 구할 것이다. 그녀로부터, 당신으로부터.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = bfe1af54-e891-0f42-37bf-9540d64dcddf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_State_TooLowTieflings = True
#. SetFlags:
#.   Global:
#.     - GOB_DrowCommander_Event_ToldAboutDeaths = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:bfe1af54-e891-0f42-37bf-9540d64dcddf
msgctxt "hdd1e441ag67fbg4abcgb671gefef2fec0279"
msgid ""
"You might stay hungry. I already dealt with some of the grove's inhabitants."
msgstr "넌 굶주렸을 수도 있겠군. 나는 벌써 그 숲의 몇몇 주민들을 처리했거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Lae'zel
#. NodeID = c021f40c-4034-4041-c7e7-4906fef7bd33
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:c021f40c-4034-4041-c7e7-4906fef7bd33
msgctxt "h814c72c4g9e3fg4a24g9e91g766ff780b5e2"
msgid "Precisely the way I meant to avoid."
msgstr "정확하게 내가 피하려던 방식이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = c069449f-9638-0341-cdf4-9d6bd5ceceb3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TIEFLING(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:c069449f-9638-0341-cdf4-9d6bd5ceceb3
msgctxt "he45d9604g37b8g47bcg8a57gb52ed5b4bbb7"
msgid "I refuse to betray my own kind."
msgstr "나의 동족을 배신 할 생각 없다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = c0fee568-572f-d4c2-12c8-259181ef50a6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - MALE(1) = True
#.      - DROWELF(1) = True
#. TagRule: DROWELF and MALE
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:c0fee568-572f-d4c2-12c8-259181ef50a6
msgctxt "h5f9dfd17g2a93g4f72ga75agc514da8a359b"
msgid ""
"I would expect nothing less, <i>jaluk</i>. Perhaps even you are more capable "
"than these goblins."
msgstr "그 정도는 해 줘야지, <i>잘루크</i>. 너도 이 고블린들보다는 유능하겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = c1b5bccf-07be-c494-1c2d-8a16d8a737e0
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_DRAGONBORN
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:c1b5bccf-07be-c494-1c2d-8a16d8a737e0
msgctxt "h7795e137gbd1dg4206ga14eg97137330b8c2"
msgid "Battle must be conducted with honour. How can you prefer deception?"
msgstr "전투는 명예롭게 수행되어야 한다. 어떻게 속임수를 선호할 수 있지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = c1b5bccf-07be-c494-1c2d-8a16d8a737e0
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:c1b5bccf-07be-c494-1c2d-8a16d8a737e0
msgctxt "h60ecbaf1g3197g4bc5ga2bag3c2f786f0bce"
msgid "I prefer to face my enemies rather than stabbing them in the back."
msgstr "나는 적의 뒤를 치는 것보다 정면으로 맞서는 것을 선호한다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = c201b152-0456-42c7-da72-4e7f0e624578
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_DrowCommander_Event_RaidersSortie = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:c201b152-0456-42c7-da72-4e7f0e624578
msgctxt "h704ab866g0858g414cg9445g7e38e6231fec"
msgid "Join me and my warband at the grove. It <i>will</i> fall."
msgstr "그 숲에서 나랑 내 군대에 합류해. 그것은 <i>분명</i> 함락될 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = c2270bd6-9fb9-df50-89f1-546aaaabc27a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:c2270bd6-9fb9-df50-89f1-546aaaabc27a
msgctxt "h307166b6g7a7bg4020g8403g44241c415e4f"
msgid "I would expect nothing less. Together, we shall burn it to the ground."
msgstr "그 정도는 해 줘야지. 우리는 함께 그곳을 잿더미로 만들 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = c2889565-47af-253b-a3ec-656e749cb3b2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - DEN_Conflict.HeardAboutAoD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:c2889565-47af-253b-a3ec-656e749cb3b2
msgctxt "h65dffed2gd549g4d0ag8e80g0be69dcf7d6b"
msgid "Show me the grove. Be my eyes."
msgstr "그 숲을 보여봐라. 나의 눈이 되어라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = c31b495b-3f37-d14f-eab6-55c41a19585e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:c31b495b-3f37-d14f-eab6-55c41a19585e
msgctxt "hb3542a55g6e0dg4a0dg8cdag9a6dd1ac5629"
msgid "Go to their refuge and make your way inside. As a friend."
msgstr "그들의 피난처로 가서 안으로 들어가라. 친구로서 말이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = c3da89c4-72e8-e187-9574-d12d3c0ccb50
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_RaidingParty_Event_StartConfrontation = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:c3da89c4-72e8-e187-9574-d12d3c0ccb50
msgctxt "h8722a480g1477g4742g8becg252330e2c147"
msgid ""
"We don't need the prisoner. I already know the place you're looking for."
msgstr "그 포로는 필요없어. 나는 이미 네가 찾고 있는 장소를 알고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = c4db9457-3a0b-3185-ab77-3981c8feb5bf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_State_TooLowTieflings = True
#. SetFlags:
#.   Global:
#.     - GOB_DrowCommander_Event_ToldAboutDeaths = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:c4db9457-3a0b-3185-ab77-3981c8feb5bf
msgctxt "h4378b0bdga631g4bf6g8d09g3f1a1c1f7d5a"
msgid "I visited his grove. Many of the inhabitants are already dead."
msgstr "그의 숲을 방문했었지. 거기 주민들은 이미 많이 죽었지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = c550e756-8f43-563f-221e-acf8856106cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:c550e756-8f43-563f-221e-acf8856106cf
msgctxt "h70a3f89ega0a4g40e9g8dbeg8d4975a7f5bc"
msgid ""
"<i>Revealing its location might doom the tieflings - but it'd earn you her "
"trust.</i>"
msgstr "<i>그 위치를 밝히는 것은 티플링들을 파멸시킬 것이다. 하지만 그녀의 신뢰는 얻을 수 있을 것이다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = c674a048-55a5-0ef7-09e6-408a537b1211
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:c674a048-55a5-0ef7-09e6-408a537b1211
msgctxt "hc2810ccegfae7g4773g8486g2baa074efe0f"
msgid ""
"Why She chose <i>iblith</i> such as you, I cannot say. But we must hunt "
"together."
msgstr "왜 절대자님이 너 같은 <i>이블리스</i>를 선택하셨는지, 알 수가 없군. 어쨌든 우리는 같이 사냥해야 한다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = c70b356c-4bf5-f061-8761-8ff6b03f5b3e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:c70b356c-4bf5-f061-8761-8ff6b03f5b3e
msgctxt "h452abe9cgf4feg49e1g9797g2ce545ca49fe"
msgid "Destroying this place is the Absolute's will. Would you defy Her?"
msgstr "그곳을 파괴하는 것이 절대자님의 의지다. 그분을 거역할 셈인가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = c7491871-a796-10be-abd4-de2166e77135
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:c7491871-a796-10be-abd4-de2166e77135
msgctxt "h765b7b2bge11cg4f32g950fgd4b94d706369"
msgid "I'm ready. The grove will fall."
msgstr "난 준비됐어. 그 숲은 함락될 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = c7d48cf1-a945-6119-f1bf-909a011b16b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:c7d48cf1-a945-6119-f1bf-909a011b16b4
msgctxt "h517a9555gaec5g4041g86cdg8cd20370acf7"
msgid ""
"But we can still fight side by side. Together, we will destroy any who have "
"not died or fled."
msgstr "하지만 우리는 여전히 나란히 싸울 수 있어. 우린, 죽지 않았거나 도망친 모든자들을 함께 없애 버릴 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = caa550ae-74d7-8136-75c1-809efe7e6d07
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - MALE(1) = True
#.      - DROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:caa550ae-74d7-8136-75c1-809efe7e6d07
msgctxt "h068fa55bg6698g42e4ga189g51a24419e9a4"
msgid ""
"A True Soul? Do not think that means we are equals, <i>jaluk</i>. Are you "
"here to join my hunt?"
msgstr "참된 영혼? 우리가 동등할 거라는 의미로 생각하지 마라, <i>잘루크</i>. 내 사냥에 동참하러 왔나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Narrator
#. NodeID = caa6d43b-ebde-a1fb-13bb-e3e3957728a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:caa6d43b-ebde-a1fb-13bb-e3e3957728a8
msgctxt "h44045e24g07d9g4601g87aeg8eadf1f1e76e"
msgid ""
"*She is seeking the grove you visited. Already, you feel her mind closing "
"around yours.*"
msgstr "*그녀는 당신이 방문한 숲을 찾고 있습니다. 이미 그녀의 정신이 당신의 정신 주위로 다가오는 것이 느껴집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = cc66b27e-3255-68e6-98c8-430f9e324621
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_DrowCommander_Event_AskedToTorture(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:cc66b27e-3255-68e6-98c8-430f9e324621
msgctxt "h30fd383dgb2cag4f52g9f9dg582739af83bd"
msgid "You serve the Absolute well."
msgstr "절대자님을 잘 섬기는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = ce135c64-3b33-46ea-acb0-057a66c68838
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - NIGHT_DarkUrge_ButlerIntro = False
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:ce135c64-3b33-46ea-acb0-057a66c68838
msgctxt "h54fb694dg5095g4cc6g9ceegfc493e42b639"
msgid "How delightful, I'm very eager to begin."
msgstr "신나는군, 어서 빨리 시작하고 싶어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = ce7ed663-d0ae-a5dd-c3f2-27bb92a5e331
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - DEN_Conflict.HeardAboutAoD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:ce7ed663-d0ae-a5dd-c3f2-27bb92a5e331
msgctxt "h42b96910gedaag4c0dg8376g8efa9fd84baf"
msgid ""
"Enough. Speak only to me while you are in my presence. The hunt must begin "
"soon."
msgstr "그만. 내 앞에서는 나에게만 말하도록. 곧 사냥을 시작해야 한다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Narrator
#. NodeID = d078e943-d07a-817d-5077-50985f648264
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - AVATAR(6) = True
#.      - REALLY_SHADOWHEART(6) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:d078e943-d07a-817d-5077-50985f648264
msgctxt "h988db53ag53f4g4377g8c66gd9c0a290cbf5"
msgid ""
"*You realise that the weapon the drow's mind dwells upon is the gith "
"artefact you carry. You cannot let her discover it - no matter what.*"
msgstr ""
"*드로우의 정신이 집착하는 무기가 자신이 들고 있는 기스 아티팩트라는 것을 깨달았습니다. 무슨 일이 있어도 그녀가 그것을 발견하게 해서는 "
"안됩니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = d1583439-9dbb-177e-e931-a2e0deb69616
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:d1583439-9dbb-177e-e931-a2e0deb69616
msgctxt "hb8993001ge1edg4866gb5d0g4cc0ed0e4747"
msgid ""
"If the inhabitants do not realise you are the knife at their throats, we can "
"use that against them."
msgstr "네가 거주자들의 목을 겨냥할 칼이라는 것을 그들은 알지 못할 것이다. 그들과 맞설 때 그 점을 이용할 수 있을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Narrator
#. NodeID = d2188960-71ae-ec45-bbdd-d7fe92cced56
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:d2188960-71ae-ec45-bbdd-d7fe92cced56
msgctxt "hf5d9229eg89f8g471bgb244g5cec57bfa93b"
msgid ""
"*Tiefling faces flicker into view as she attempts to learn the grove's "
"location.*"
msgstr "*그녀가 숲의 위치를 알아내려고 하자, 티플링 얼굴들이 깜빡거리며 시야에 들어옵니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Narrator
#. NodeID = d280d99e-9c7d-5d06-4318-42a84c94cfe6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:d280d99e-9c7d-5d06-4318-42a84c94cfe6
msgctxt "h0e71bbc0g718cg4834gbe14g859d1d1921c3"
msgid ""
"*Images of the battle at the gate shimmer into view, along with the "
"adventurers pleading to be let inside.*"
msgstr "*성문에서 벌어지는 전투 장면과 함께 안으로 들여보내 달라고 애원하는 모험가들의 모습이 선명하게 보입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = d2bb7670-9d62-46ac-7c47-9df5c1f5f317
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:d2bb7670-9d62-46ac-7c47-9df5c1f5f317
msgctxt "h2722628bg8500g4c8cg9c64g4d09f723fb98"
msgid ""
"<i>Luring her to the grove might expose her, provided you forewarn the "
"tieflings.</i>"
msgstr "<i>그녀를 숲으로 유인해서 노출시키면, 티플링들에게 미리 경고하는 셈이 된다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = d3266903-9346-4c08-da9f-1bb46cc92f35
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:d3266903-9346-4c08-da9f-1bb46cc92f35
msgctxt "h191b26abg85b2g4a8ag9d48g9f3b9755f8a4"
msgid "And then <i>we</i> will be the first among Her favourites."
msgstr "그리하면 <i>우리</i>는 그분의 가장 많은 총애를 받게 되겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Narrator
#. NodeID = d392daef-c8db-f7b5-ae49-9db8af167812
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_DrowCommander_Event_CompromisedDen(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:d392daef-c8db-f7b5-ae49-9db8af167812
msgctxt "h04ff98c8g30d9g4554g8987g0ea7640e989a"
msgid ""
"*She sees the entrance to the grove as the adventurers retreat inside, "
"joining the tieflings...*"
msgstr "*모험가들이 숲 안으로 후퇴하고 티플링과 합류할 때, 그녀는 숲의 입구를 봅니다...*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = d7e54d36-f0d0-11ef-f48b-cfb6c2627c48
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:d7e54d36-f0d0-11ef-f48b-cfb6c2627c48
msgctxt "h7dc447d7g8586g4e44g8b5bg5f8cffe67b03"
msgid ""
"You must make your way inside. Once I am in position, on your signal, we "
"<i>break </i>them."
msgstr "네가 안으로 가는 길을 확보해야 한다. 내가 자리를 잡고 나서, 네가 신호를 보내면, 우리가 적을 <i>쳐부수는</i> 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = d86b3171-bbc3-441c-78dc-85d11b901a41
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ELF(1) = True
#. TagRule: ELF or HALFELF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:d86b3171-bbc3-441c-78dc-85d11b901a41
msgctxt "he4793050g9075g4499gb6f0g313affee357c"
msgid ""
"A True Soul in such a grotesque form? The Absolute has a place in Her heart "
"even for <i>darthiir</i>."
msgstr "이렇게 기괴한 모습의 참된 영혼이라니? 절대자님은 <i>다시르</i>에게도 마음을 베풀어주시는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = d86bf457-0997-7fc9-2046-3c3b1fa7c064
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - MALE(1) = True
#.      - DROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:d86bf457-0997-7fc9-2046-3c3b1fa7c064
msgctxt "h06d842beg131fg48a2g9440g397ea79bc873"
msgid "You are a True Soul, <i>jaluk</i>? Perhaps you are worthy to assist me."
msgstr "너는 참된 영혼인가, <i>잘루크</i>? 나를 도울 자격이 있을지도 모르겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = da850e78-404b-5458-f3a6-010c356973c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:da850e78-404b-5458-f3a6-010c356973c4
msgctxt "hcadf3ff1g0620g47a7g8183g3fe81802d260"
msgid "And endanger the entire grove? It's too risky."
msgstr "그리고 숲 전체를 위험에 빠뜨린다? 너무 위험해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = dcb433bc-595b-2c9d-7f1f-b39e77c1918e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_DrowCommander_Knows_DrowLeader = True
#.   Tag:
#.      - PALADIN(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:dcb433bc-595b-2c9d-7f1f-b39e77c1918e
msgctxt "h0296fc95g8f1fg41f8g9fc5g412fc5767cdc"
msgid "My hunt ends here - you're my prey."
msgstr "내 사냥은 여기서 끝난다. 네가 내 사냥감이니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = ddc38cf2-d46d-79b1-8ea1-5bd09b654d09
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DROWELF(1) = True
#. SetFlags:
#.   Dialog:
#.     - GOB_DrowCommander_Event_OrderedToJoinHunt(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:ddc38cf2-d46d-79b1-8ea1-5bd09b654d09
msgctxt "h262e84a1g9abdg43d0gb161g45160fa7d6c6"
msgid "Join my hunt."
msgstr "내 사냥에 동참해라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = dddaefb8-c0d8-e382-4547-1c2ba1a5b92d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:dddaefb8-c0d8-e382-4547-1c2ba1a5b92d
msgctxt "h64783f72g9a4cg4025g92d1g5be090cc9759"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = decd292d-3057-2084-55b8-7fcff0259ed7
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: BESTIAL or RARE or UNDERDARK
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:decd292d-3057-2084-55b8-7fcff0259ed7
msgctxt "hf54ea134g6c82g4936g86ccg243e231d48e5"
msgid "I don't have the most trustworthy face."
msgstr "나는 그다지 신뢰감을 주는 인물이 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = dfac5b36-c659-8e3b-ffa1-76f18d10353d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_Knows_LeaderNamePriest = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:dfac5b36-c659-8e3b-ffa1-76f18d10353d
msgctxt "h23b4c94fgc6b8g4c7eg8c24ga98872b6c0be"
msgid ""
"There is no power except for the Absolute. If you are sick, speak to the "
"goblins' priestess - she, too, is a True Soul."
msgstr "절대자님 외에는 힘이 없다. 몸이 아프다면 고블린 여사제에게 말해라. 그녀도 참된 영혼이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = e018c406-ab88-88e6-f4dd-f225787f8740
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_State_TooLowTieflings = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:e018c406-ab88-88e6-f4dd-f225787f8740
msgctxt "h519ece22g7acbg4a04g8c2fga7be24241039"
msgid ""
"<i>The tieflings should be warned. Together, you can outnumber her "
"warband.</i>"
msgstr "<i>티플링들에게 경고해 줘야 한다. 함께라면, 그녀의 습격대를 수적으로 압도할 수 있을 것이다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = e0bfe4b8-a9cb-1cca-3567-7eb4c722ba78
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_DrowCommander_DenouncedLolth(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:e0bfe4b8-a9cb-1cca-3567-7eb4c722ba78
msgctxt "h19479f74ga5a4g4b54g89bfg41931433f461"
msgid ""
"They are vermin - sacred only to the false goddess Lolth. She has no power "
"here, among the Absolute's Chosen."
msgstr "그들은 해충이다. 거짓된 여신 롤쓰에게만 신성한 존재지. 그녀는 여기선 힘이 없어. 절대자의 선택을 받은 자들 사이에서 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = e0efa4c7-9ded-2197-7bc8-d5e343b25aed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:e0efa4c7-9ded-2197-7bc8-d5e343b25aed
msgctxt "h8887a360g8d5bg4082g9168g9cafe3bea999"
msgid "Quiet. We'll handle this my way."
msgstr "조용히 해. 이건 내 방식으로 해결하자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = e267f4c8-da10-64b4-7326-bcab83048c88
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule: PALADIN_DEVOTION
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:e267f4c8-da10-64b4-7326-bcab83048c88
msgctxt "hb10cccfag1150g4d3bgb5d2gae4ba4433cc4"
msgid "They are innocents, and on my oath, they are <i>protected</i>."
msgstr "그들은 무고하며, 나의 맹세에 따라, 그들은 <i>보호받는다</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = e267f4c8-da10-64b4-7326-bcab83048c88
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule: PALADIN_ANCIENTS
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:e267f4c8-da10-64b4-7326-bcab83048c88
msgctxt "h86a78ccagda2fg4f12ga31bg84e4c69dcdd7"
msgid ""
"The grove is a tranquil, ageless place. I will not let you desecrate it."
msgstr "그 숲은 고요하고 세월이 흘러도 변하지 않는 곳이다. 그 곳을 더럽히지 못하게 할 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = e267f4c8-da10-64b4-7326-bcab83048c88
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule: PALADIN_VENGEANCE and NOT_FOR_EA
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:e267f4c8-da10-64b4-7326-bcab83048c88
msgctxt "h80d3839dg5740g42e5gb44bgc7fb031c0086"
msgid "Because monsters like you can't be left to run amok."
msgstr "너 같은 괴물이 미쳐 날 뛰는걸 그냥 내버려둘 수는 없으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = e267f4c8-da10-64b4-7326-bcab83048c88
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule: OATHBREAKER
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:e267f4c8-da10-64b4-7326-bcab83048c88
msgctxt "h32b21ab3g445eg4a69g8d04g2a19703d67a4"
msgid ""
"You'd slaughter them on the whim of a capricious god. I find that... "
"<i>distasteful</i>."
msgstr "너는 변덕스러운 신의 변덕에 따라 그들을 학살하겠지. 나는 그것이... <i>불쾌</i>하다고 깨달았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = e477cb17-5cdc-42c0-1c83-f94dd9be9210
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Absolute_Knows_MoonriseTowers = True
#.      - GOB_DrowCommander_Quest_AskedAboutPassage = False
#. SetFlags:
#.   Global:
#.     - GOB_DrowCommander_Quest_AskedAboutPassage = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:e477cb17-5cdc-42c0-1c83-f94dd9be9210
msgctxt "h68016589gc727g48b0g8054g372ad8868b08"
msgid ""
"The Absolute requires my presence at Moonrise. Can you provide safe passage?"
msgstr "절대자께서 내가 문라이즈에 가길 원하셔. 안전한 통로를 제공해 줄 수 있어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = e50bc81c-981f-5b87-cfe4-8fa6fa763a63
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:e50bc81c-981f-5b87-cfe4-8fa6fa763a63
msgctxt "h51f997a6g9217g4dd8g9ec9gea114261ebd3"
msgid "I have nothing to report."
msgstr "보고할 것이 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = e892b030-0b31-3b2f-59f5-f0d8b1dd7588
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:e892b030-0b31-3b2f-59f5-f0d8b1dd7588
msgctxt "h7ae21e6agce82g4f25g82e6g5a37b2f22130"
msgid ""
"Good. Marshalling the goblins is no simple matter, but my warband will be "
"ready to attack by next light."
msgstr "좋아. 고블린을 집결시키는 건 간단한 일이 아니지만, 다음 날이 밝으면 내 부대가 공격할 준비를 마칠 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = e8c0f950-68d0-5145-3634-031af198a4a3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_DrowCommander_Event_OrderedToJoinHunt(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:e8c0f950-68d0-5145-3634-031af198a4a3
msgctxt "hde6f73b4g43c9g45c9g8296g1fc6e8bdbbbf"
msgid "You <i>will </i>join my hunt."
msgstr "너는 내 사냥에 동참<i>할 것이다</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = ea5e1eb4-3ce2-95c4-7043-805aa693085f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:ea5e1eb4-3ce2-95c4-7043-805aa693085f
msgctxt "hff9ccddbg6429g4748g8a17gbf7733d886a4"
msgid "That is hard to believe - your mind is a maze of misdirection."
msgstr "그건 믿기 어렵군. 너의 머릿속은 미로처럼 복잡하게 얽혀있다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = ef3af1f8-c6cc-ab35-8c10-02598ab5c3a9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_State_TooLowTieflings = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:ef3af1f8-c6cc-ab35-8c10-02598ab5c3a9
msgctxt "hf91d7aaeg0cb9g46ebgb42dg2bbc3f5bc1e5"
msgid ""
"I visited the grove you are looking for. Many of its inhabitants are already "
"dead."
msgstr "난 네가 찾던 그 숲을 방문했었어. 그 곳 주민들은 이미 많이 죽었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = efef0d13-89ca-ab2d-3352-e1e5d4d594a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:efef0d13-89ca-ab2d-3352-e1e5d4d594a8
msgctxt "h23755647g5f39g4afdgb55fg50b90958fea2"
msgid "Good plan. I'll consider it."
msgstr "좋은 계획이야. 고려해 볼게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = f01055fb-43e9-c1b0-7f36-430024683dd4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:f01055fb-43e9-c1b0-7f36-430024683dd4
msgctxt "h491e4804gb05cg4dadgac81ge35bf126abcf"
msgid ""
"<i>Leading her to the tieflings might doom them... but it would earn her "
"trust.</i>"
msgstr "<i>민타라를 안내하면 티플링들이 몰살당할지도 모른다... 하지만 그녀의 신뢰를 얻을 수 있다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = f04b4487-7401-8c55-ba65-01ad2b7bc179
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_DrowCommander_Event_SentScouting(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:f04b4487-7401-8c55-ba65-01ad2b7bc179
msgctxt "hee1b16b4g4a98g4bd0g9cb9g584b2885d8b7"
msgid ""
"We will have to do this the hard way. Scour the area and hunt them down, "
"then report back to me."
msgstr "이 일을 어려운 방식으로 해야겠군. 그 지역을 샅샅이 뒤져서 놈들을 찾아내라. 그리고 내게 보고하도록."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = f0978400-88e2-a4a5-1e39-d88f334c60b8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_Knows_LeaderNameDrow = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:f0978400-88e2-a4a5-1e39-d88f334c60b8
msgctxt "h46c43650g7da9g4a70g9ab8gc9c8400678aa"
msgid ""
"Worshippers of a false god. Their existence is an insult to the Absolute's "
"claim on this region."
msgstr "가짜 신을 숭배하는 자들이지. 그들의 존재는 이 지역에 대한 절대자님의 주권에 모욕이 된다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = f09e3945-c6ce-765e-2419-07d54ba9359e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:f09e3945-c6ce-765e-2419-07d54ba9359e
msgctxt "h25e2836cg7ab1g4ae8g97e2g5908988508e0"
msgid ""
"Tell me what you know. The Absolute will reward us with such power if we "
"find this place."
msgstr "네가 아는 것을 말해라. 우리가 그 장소를 찾으면 절대자님이 엄청난 힘을 우리에게 보상해 주실 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = f628055a-8081-d90b-9f20-2db25db9d5e5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:f628055a-8081-d90b-9f20-2db25db9d5e5
msgctxt "haa86987fg5b37g4098gb8e7gf401f75845c9"
msgid "Ready? Let's take her out."
msgstr "준비됐어? 그녀와 결판을 낼 시간이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = f6307790-4296-5d37-5135-f9d6e421582c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = False
#.      - TIEFLING(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:f6307790-4296-5d37-5135-f9d6e421582c
msgctxt "hc625aa78g6812g4bccgbc20g4225232130fa"
msgid "They're innocent, and no danger to you."
msgstr "그들은 무고해, 게다가 너에게 위험하지도 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = f6335eab-ac77-469e-8454-8c90fab9000c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:f6335eab-ac77-469e-8454-8c90fab9000c
msgctxt "h95973a16g0964g433cg86cag8ae871dcb7ac"
msgid ""
"Your connection to the Absolute is strong... but do not think it will "
"protect you if you cross me."
msgstr "절대자와 너의 연결은 강하지만... 나를 거역하더라도 절대자가 너를 지켜줄 거란 생각은 하지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = f72bfa23-a4b0-f341-8447-8146ab3e3fea
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_RaidingParty_Event_StartConfrontation = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:f72bfa23-a4b0-f341-8447-8146ab3e3fea
msgctxt "h9958c840gf573g441eg992eg4c3946f7fb3f"
msgid "I know the place you're looking for - it's a druids' grove."
msgstr "네가 찾고 있는 그 장소를 알고 있다. 그건 드루이드의 숲이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = f74430ed-a588-7464-5caa-907cadcd4c5c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_DrowCommander_Event_AskedToTorture(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:f74430ed-a588-7464-5caa-907cadcd4c5c
msgctxt "hc1456e2ag237ag44f8ga9dag57ea6ab1c324"
msgid ""
"Report. And make it quick - organising these creatures tests my patience."
msgstr "보고해. 그리고 빨리해. 이 괴물들을 조직하는 건 내 인내심을 시험하게 하는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = f8f47a18-3f73-3313-2539-e65377ae234d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:f8f47a18-3f73-3313-2539-e65377ae234d
msgctxt "h9a86d205ge7cfg46fdgb9ebgdbd9a60785af"
msgid "Praise be. And now, through Her will, you can be my eyes."
msgstr "찬사를. 그럼 이제, 그분의 의지를 통해, 네가 내 눈이 될 수 있다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = f9158e1f-387d-3c4c-2813-fc7f5a140df1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_State_TooLowTieflings = True
#. SetFlags:
#.   Global:
#.     - GOB_DrowCommander_Event_ToldAboutDeaths = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:f9158e1f-387d-3c4c-2813-fc7f5a140df1
msgctxt "h5ea32ab8gc0b4g4ec7g8d83g18686afcc3bc"
msgid "That won't be necessary. Many of the inhabitants are already dead."
msgstr "그건 필요하지 않을 거야. 거기 주민들은 이미 많이 죽었거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = f9269d30-ac78-51c3-5afd-98cb33548da0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_DrowCommander_Event_RaidersSortie = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:f9269d30-ac78-51c3-5afd-98cb33548da0
msgctxt "hd9ff6e5bg2b3eg4743g858eg11348aa8834c"
msgid "For the Absolute."
msgstr "절대자를 위하여."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Narrator
#. NodeID = f9d6aeb0-a2d2-848b-f018-22a2359dd620
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:f9d6aeb0-a2d2-848b-f018-22a2359dd620
msgctxt "he916ab4cga30dg4eb4gad1ag66550831b99f"
msgid "*Her mind enters yours, a splinter of ice piercing your memories.*"
msgstr "*그녀의 정신이 당신의 기억을 꿰뚫는 얼음 조각처럼 당신의 마음 속에 들어옵니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = fa15ad1e-7d5a-0665-e79e-8b1dbcad0f15
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TIEFLING(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:fa15ad1e-7d5a-0665-e79e-8b1dbcad0f15
msgctxt "hc7f282cdgf2f2g4e64g8da2g7d4d16b4c12c"
msgid "I won't betray them."
msgstr "그들을 배신할 수 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = fa7a04c5-244e-2268-a8b9-ac1f7befeabc
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 20
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:fa7a04c5-244e-2268-a8b9-ac1f7befeabc
msgctxt "h50afdf6fg6362g4a96g89e1g601365757786"
msgid "The Absolute chose me. <b>I do as I please.</b>"
msgstr "절대자는 나를 택했다. <b>나는 내가 원하는 대로 한다.</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = facd26e2-9478-699c-4186-ab4c7bb0c4db
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_Knows_Lockdown = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:facd26e2-9478-699c-4186-ab4c7bb0c4db
msgctxt "hce88ee57gb8b1g44d7ga385g26ee9cf59c11"
msgid ""
"<i>The druids' magic protects the grove, but she may be able to break "
"through.</i>"
msgstr "<i>드루이드의 마법이 숲을 보호하지만, 그녀가 돌파할 수 있을지도 모른다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = faff05c7-573d-862a-c3d2-f609f828a592
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:faff05c7-573d-862a-c3d2-f609f828a592
msgctxt "h81c8d934g6d69g4de8ga6b7g83f251f95201"
msgid "Silence now, creature. Or I will silence you forever."
msgstr "조용히 해라, 괴물. 아니면 내가 영원히 조용히 시켜주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Nightwarden Minthara
#. NodeID = fc1bfb27-f50e-30c0-8cf6-96ae50121da5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:fc1bfb27-f50e-30c0-8cf6-96ae50121da5
msgctxt "he0b8f41fga2feg44c7gaf6eg57b688c875da"
msgid "Kill the tieflings and <i>take</i> what you need."
msgstr "티플링들을 죽여서 필요한 만큼 <i>가져가</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = fcfdc34f-0837-6a57-798c-2ace683f8cbd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:fcfdc34f-0837-6a57-798c-2ace683f8cbd
msgctxt "h2bbc627agfd45g4691g8945gb835e7100acc"
msgid "You're right. I'll see you at the grove."
msgstr "네 말이 맞군. 숲에서 보자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander
#. Speaker = Player
#. NodeID = feece953-5a73-842f-8a41-7380e56866e3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander:feece953-5a73-842f-8a41-7380e56866e3
msgctxt "h7299585eg82fcg432agb6d7ga23bd69388b1"
msgid "Quiet. I have everything under control."
msgstr "쉿. 모든 건 계획대로야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander_Dead
#. Speaker = Nightwarden Minthara
#. NodeID = 00a0ef75-bdbe-a743-6614-4c934a78d650
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_DrowCommander_Dead_MentionedAbsolute(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander_Dead:00a0ef75-bdbe-a743-6614-4c934a78d650
msgctxt "h2d7e7f9fgebf3g4d3bg9315g3141760250fd"
msgid "... raiding... hunting... the Absolute's will..."
msgstr "... 습격을 하고... 사냥을 했어... 절대자의 의지로..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander_Dead
#. Speaker = Nightwarden Minthara
#. NodeID = 0db99117-7f73-3cc6-6af2-d6ead5f86bdb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander_Dead:0db99117-7f73-3cc6-6af2-d6ead5f86bdb
msgctxt "h1ddf903eg5f18g484cga5eegffea3d999c6c"
msgid "...Minthara... adept... House Baenre..."
msgstr "...민타라... 베인레이 가문의... 숙련자..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander_Dead
#. Speaker = Nightwarden Minthara
#. NodeID = 1b9cdf50-14f0-a783-7c9a-c98270a7c67f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Moonrise_Knows_Prisoners = True
#.     - CAMP_GoblinHuntCelebration_DrowToldMoonrise = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander_Dead:1b9cdf50-14f0-a783-7c9a-c98270a7c67f
msgctxt "ha9556c2cged93g41b3g9a79gb005afbd9c95"
msgid "... Moonrise Towers..."
msgstr "... 문라이즈 타워..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander_Dead
#. Speaker = Nightwarden Minthara
#. NodeID = 22c0a54d-fb65-8e4b-5b97-c5fd4f4423a1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander_Dead:22c0a54d-fb65-8e4b-5b97-c5fd4f4423a1
msgctxt "h44a451e2g29d3g486bgb494ga64369ceb87c"
msgid "... by my side..."
msgstr "... 내 곁에..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander_Dead
#. Speaker = Player
#. NodeID = 2bdf9baa-0e3c-1c04-94b5-9fb95658beb4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander_Dead:2bdf9baa-0e3c-1c04-94b5-9fb95658beb4
msgctxt "h71994eaagf4abg4b65g9a6cg52ec6e1de432"
msgid "What were you doing here?"
msgstr "여기서 뭘 하고 있었지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander_Dead
#. Speaker = Nightwarden Minthara
#. NodeID = 33a03d46-ad47-9ebe-60e1-5ee4f6c62298
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CAMP_GoblinHuntCelebration_Knows_CreaturePath = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander_Dead:33a03d46-ad47-9ebe-60e1-5ee4f6c62298
msgctxt "h7b14220agd3ebg45fbg8bc0g3286fd9b3c85"
msgid "Drider... lantern..."
msgstr "드라이더... 등불..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander_Dead
#. Speaker = Narrator
#. NodeID = 36514c05-a879-4c9b-0e8f-c1cc1e8888b9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander_Dead:36514c05-a879-4c9b-0e8f-c1cc1e8888b9
msgctxt "h31f7c432g82ceg4c4cg9481g32bb65fadd0c"
msgid "*The corpse does not stir. It will answer no more questions.*"
msgstr "*시체는 움직이지 않습니다. 더 이상 질문을 받지 않을 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander_Dead
#. Speaker = Player
#. NodeID = 3aa3de68-0a15-3774-2ad2-df5c04db9757
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_DrowCommander_Dead_MentionedAbsolute(1) = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander_Dead:3aa3de68-0a15-3774-2ad2-df5c04db9757
msgctxt "ha1bb2e55g879dg4790gb9d8gb2cb4f3ad5a4"
msgid "Who is the Absolute?"
msgstr "절대자가 누구지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander_Dead
#. Speaker = Nightwarden Minthara
#. NodeID = 4087566a-8728-a6a1-fdd7-16b11597bebc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander_Dead:4087566a-8728-a6a1-fdd7-16b11597bebc
msgctxt "hc1f4ec61gd05ag4727ga93cg73f9742c4897"
msgid "East... village... well..."
msgstr "동쪽... 마을... 우물..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander_Dead
#. Speaker = Player
#. NodeID = 5df3e948-fae3-23e8-466a-f750469c083e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CAMP_GoblinHuntCelebration_DrowToldMoonrise = True
#.      - UND_TheDrowNere_Quest_SentToMinthara = False
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander_Dead:5df3e948-fae3-23e8-466a-f750469c083e
msgctxt "h345a833dg44bdg4f49gb404gafda04b853a4"
msgid "How can I reach Moonrise Towers safely?"
msgstr "어떻게 해야 문라이즈 타워에 안전하게 갈 수 있지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander_Dead
#. Speaker = Nightwarden Minthara
#. NodeID = 64ee8afa-239d-992b-484e-067dca523853
