msgctxt "h0825312fgbb6bg46c9g952fg22483dbbdcc0"
msgid "You mentioned the Nightsong. Where can I find it?"
msgstr "밤의 노래란 걸 말했었잖아. 그건 어디서 찾을 수 있지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = de07258d-8641-077a-e95f-52c562385b72
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Dialog:
#.      - GOB_TorturedAdventurer_Knows_ShadowheartChainsPersuade(1) = False
#.   Global:
#.      - GOB_TorturedAdventurer_State_Unlocked = False
#.      - GOB_Torturers_State_PrisonerFreed = False
#.   Object:
#.      - GLO_SafeRomance_Enabled(1) = False
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = True
#. SetFlags:
#.   Dialog:
#.     - GOB_TorturedAdventurer_Knows_ShadowheartChainsPersuade(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:de07258d-8641-077a-e95f-52c562385b72
msgctxt "h1c7f09f4g1417g4b6dgbb01g42bfae6e4367"
msgid "I can free you - if you're not afraid of a little pain."
msgstr "내가 당신을 풀어줄 수 있어. 고통을 좀 견딜 준비가 됐다면 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = de2511a2-aac4-79ca-bdbb-44a9f8fe7ea2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_TorturedAdventurer_WasMean(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:de2511a2-aac4-79ca-bdbb-44a9f8fe7ea2
msgctxt "h0080e554g56bcg4c75g8c80gcf49cd5e8772"
msgid "Please! F-free me. Y-you don't need me anymore."
msgstr "제발! 푸-풀어주세요. 제-제가 더 이상 필요 없으시잖아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = de4a03d0-d106-11cb-8e5e-94972aa661b3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Torturers_State_PrisonerFreed = False
#. SetFlags:
#.   Dialog:
#.     - GOB_TorturedAdventurer_PromisedToFree(1) = True
#.   Global:
#.     - GOB_TorturedAdventurer_State_PromisedToFreeNoParty = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:de4a03d0-d106-11cb-8e5e-94972aa661b3
msgctxt "h8fcf5fd9ga262g4d47gb316ge06c72b9966b"
msgid "Thanks for the information. Now let's get you free."
msgstr "정보 고마워. 이제 널 풀어주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = e127c34b-71f4-432d-2f6a-2db5703ffaa3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_TorturedAdventurer_Knows_AskedWhatNightsongDoes(1) = False
#.   Global:
#.      - GLO_AdventurersQuest_Knows_AboutSH = True
#.      - GOB_TorturedAdventurer_Knows_WasLookingForSH = True
#. SetFlags:
#.   Dialog:
#.     - GOB_TorturedAdventurer_Knows_AskedWhatNightsongDoes(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:e127c34b-71f4-432d-2f6a-2db5703ffaa3
msgctxt "h182c4b4bg2bbcg443egb0e4gfa15182f65ad"
msgid "What does the Nightsong do, exactly?"
msgstr "밤의 노래는 정확히 뭐 하는 물건이지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Narrator
#. NodeID = e23af303-fd0a-4762-af88-118d27235e05
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_State_IncurableWound_Unavailable = False
#.      - GLO_Not_For_EA = True
#.   Tag:
#.      - AVATAR(1) = True
#.      - REALLY_SHADOWHEART(1) = True
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_Event_IncurableWoundFlared = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:e23af303-fd0a-4762-af88-118d27235e05
msgctxt "h934775bag3d42g4e54g9df2gf1b4509b8167"
msgid ""
"*Searing agony grips you. For a brief moment, you see another cell, "
"elsewhere. You hesitate before a bound prisoner. A harsh voice demands you "
"inflict pain, for Lady Shar...*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Narrator
#. NodeID = e24095a6-c559-db57-ca86-e497c5d843f8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_TorturedAdventurer_State_Unlocked = True
#.     - GOB_Torturers_State_PrisonerFreed = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:e24095a6-c559-db57-ca86-e497c5d843f8
msgctxt "h59833522g60b8g475cg9deag61c4b09ed09d"
msgid "*The lock clicks and opens.*"
msgstr "*찰칵 소리와 함께 자물쇠가 풀립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = e2e9dae6-9bc8-fb7b-9701-01f9021d9b93
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_PartyProgress_EnteredGrove = False
#.      - GOB_HappyTorturers_Knows_PlayersKnowDenLocation = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:e2e9dae6-9bc8-fb7b-9701-01f9021d9b93
msgctxt "ha000695cg56fcg4713gb34fg022cc6f1112f"
msgid "Tell me where this hideout is."
msgstr "이 은신처가 어디에 있는지 말해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = e3549195-d72c-ad42-5074-f60c46b97750
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:e3549195-d72c-ad42-5074-f60c46b97750
msgctxt "h4261d9fbgef7dg46eag9423g813ecdd7fe24"
msgid "No... no, please! They'll kill me!"
msgstr "안 돼... 안 돼, 제발요! 그들이 절 죽일 거예요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = e4e9e817-90b0-44ae-8869-0a19de49d809
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:e4e9e817-90b0-44ae-8869-0a19de49d809
msgctxt "h109dd211gce2fg4a50ga0a8gb8bc79d2d3c7"
msgid "<i>Silently petition Lady Shar for guidance.</i>"
msgstr "<i>조용히 샤 여신의 인도를 청원한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = e52a5bb2-b1ec-259f-7cb1-c1efc891f838
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_HappyTorturers_Knows_PlayersKnowDenLocation = True
#.   Quest:
#.     - DEN_Conflict_SUB_AoD.GotGroveLocation(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:e52a5bb2-b1ec-259f-7cb1-c1efc891f838
msgctxt "h8c05e11ag8d10g48b0gab5ega54d41086472"
msgid ""
"Th-the grove. To the east. They wanted to know where we came from. They'll k-"
"kill everyone. Please... I need to warn them."
msgstr ""
"수-숲이에요. 동쪽에 있어요. 놈들은 우리가 어디서 왔는지 알고 싶어 했어요. 놈들이 모두를 주-죽일 거예요. 제발... 그들에게 경고해 "
"줘야 해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = e614a360-790d-7aaa-3985-63cd1b111a43
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:e614a360-790d-7aaa-3985-63cd1b111a43
msgctxt "hb637b9dag312cg4fa8gada1gf20349437e3a"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = e719841b-022c-13fc-1c90-4243c74a8864
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:e719841b-022c-13fc-1c90-4243c74a8864
msgctxt "h7c5f91bfg7b42g480dgbc92gb432e3586910"
msgid "Thuh... th-three..."
msgstr "세... 세-셋..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = e739951e-f733-7eb2-c2aa-1f19a14f6b47
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:e739951e-f733-7eb2-c2aa-1f19a14f6b47
msgctxt "h8cae5389g1f55g46bdg8f80g4fe4e1a33cc9"
msgid "Calm down - I'm here to help."
msgstr "진정해. 도와주러 온 거니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = e9ece522-b32f-baa9-473f-f2eb21d76f84
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - GLO_Tadpole_SUB_Druid.LearnedBear(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:e9ece522-b32f-baa9-473f-f2eb21d76f84
msgctxt "ha9e4bdf0g2c6dg4675gaf22g4ebeed141a47"
msgid ""
"I... I don't know. He changed into a bear, but... I lost sight of him. I "
"don't know if he's s-still alive."
msgstr ""
"저... 저도 모르겠어요. 곰으로 변신하는 건 봤는데... 그 이후는 본 적이 없어요. 그가 지-지금 살아있는지조차도 모른다고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = eb7dc092-8cfd-1774-97d7-b8c5fbf9bbd5
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:eb7dc092-8cfd-1774-97d7-b8c5fbf9bbd5
msgctxt "hf5ab8b2bg313ag4737gb176g9efaf5bbb0a3"
msgid "It was the only way to get the goblins to leave."
msgstr "고블린들이 떠나게 하려면 이 방법밖엔 없었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = eda39f1a-f50a-3179-296f-ee1459ea18b2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_TorturedAdventurer_WasMean(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:eda39f1a-f50a-3179-296f-ee1459ea18b2
msgctxt "h79674eceg46d6g4e75gb5aeg9a55ab425f21"
msgid "The pain stops when you answer my questions."
msgstr "내 질문에 대답하면 고통이 멈출 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = ee50dc1e-1005-6bb6-4af5-08f214d794d6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_TorturedAdventurer_WasMean(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:ee50dc1e-1005-6bb6-4af5-08f214d794d6
msgctxt "h225029a4gdbcag4cf8gaaf1g24d8ca6b170c"
msgid "That depends on the answers you give me."
msgstr "그건 당신이 어떤 대답을 하느냐에 달렸지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
