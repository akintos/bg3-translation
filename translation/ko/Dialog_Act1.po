msgctxt "hebefcbeeg6c51g4a99g93a7g94f092ea93f8"
msgid "Remarkably well preserved. A little glimpse into the past."
msgstr "놀랍도록 잘 보존되어 있었군. 과거의 한 조각을 보는 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_EnterGauntlet
#. Speaker = Player
#. NodeID = 4e4c2399-c0c7-4ea3-8ea9-f6059261e55a
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
