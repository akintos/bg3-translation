#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:2dbffd23-fb04-fa33-ac57-c8c443cf7d68
msgctxt "h136067fag8901g42d1gb776g9d44ebddb863"
msgid "NO. KISS <b>MY </b>FOOT."
msgstr "아니. <b>내</b> 발에 키스해라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = 2e223415-1c73-fe9f-263c-ca9facd64e2f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:2e223415-1c73-fe9f-263c-ca9facd64e2f
msgctxt "h95d0c6ffg2acag4a74gb3e2g015420e46a34"
msgid "Good, yes, good."
msgstr "좋아, 그래, 좋아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = 2ea79665-3772-5709-0e9b-01056522f694
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:2ea79665-3772-5709-0e9b-01056522f694
msgctxt "h4b4bda74g5ca2g4fc9g94a9g990de0bfa268"
msgid "What was that?"
msgstr "뭐라고 했어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = 30a92217-1d5f-9ef2-e005-1e93c1d892ba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:30a92217-1d5f-9ef2-e005-1e93c1d892ba
msgctxt "h095e5199gcc29g45f4g8341g392f22890808"
msgid "Hmph. Still red. Looks like you're new, huh."
msgstr "크흠. 아직도 빨갛군. 네 표식은 갓 찍은 것 같은데, 흠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Astarion
#. NodeID = 39728abd-1776-5dab-5337-b3e5ab2e46e5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:39728abd-1776-5dab-5337-b3e5ab2e46e5
msgctxt "h36d58114gd819g47c3ga58fgeb7fc52ea860"
msgid "Well? Go on, give him a nibble."
msgstr "그래? 어서 놈을 한 입 깨물어줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Player
#. NodeID = 3ae842c9-170b-e5d6-b252-bec89066e50d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Dexterity
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - ROGUE(4) = False
#. SetFlags:
#.   Object:
#.     - GOB_DrunkGoblin_Event_KissedGoblinFeet(4) = True
#.     - GOB_DrunkGoblin_Event_KissedFeet(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:3ae842c9-170b-e5d6-b252-bec89066e50d
msgctxt "hf940657ag6ac7g45bcgb602g33976e154102"
msgid "<i>Kiss his foot - and try to slide the ring off his toe.</i>"
msgstr "<i>그의 발에 입을 맞추며, 그의 발가락에 껴진 반지를 빼내려 시도한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Player
#. NodeID = 3b06cce8-4f50-7e15-c4b2-86ec2564f6a0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:3b06cce8-4f50-7e15-c4b2-86ec2564f6a0
msgctxt "hd00f9659g1617g41d2g86feg3a8e2079dc44"
msgid "I'd sooner spit in your face."
msgstr "차라리 네 얼굴에 침을 뱉겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = 3cbad460-848a-89f7-a333-aaf9c4e92787
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:3cbad460-848a-89f7-a333-aaf9c4e92787
msgctxt "h1c56f57dg6fcdg426ag80e2g22a52b913efd"
msgid "...thrashed 'is arm with my bare hands. Weaker than pixies, humans."
msgstr "...내 맨손으로 작살냈다 이 말이야. 픽시보다 약해, 인간놈들은."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = 3e69e225-4998-aa2e-d8ef-92bfd576fec7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_DrunkGoblin_Knows_IntimidateSuccess(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:3e69e225-4998-aa2e-d8ef-92bfd576fec7
msgctxt "heff5ec65gc5f2g45f2g96a7g7a44aff05c64"
msgid "Errgh... look, mate. Just piss off. You're not welcome 'ere."
msgstr "어어... 이봐, 친구. 그냥 저리 가. 넌 여기서 환영받지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
