msgctxt "h18ccf759gdc2bg403cg8040g4096582feee4"
msgid ""
"Barrelstalks, full of poison. The myconids will release it if threatened."
msgstr "통줄기야, 맹독으로 가득하지. 마이코니드들이 위협을 느끼면 저걸 분사할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PAD_BarrelstalkInteraction
#. Speaker = Player
#. NodeID = a319cca9-ccf6-c736-a43c-040d1c333c8c
#. HandlePath = TaggedText[7].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_Knows_Barrelstalks = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PAD_BarrelstalkInteraction:a319cca9-ccf6-c736-a43c-040d1c333c8c
msgctxt "hc8afe9adg7df7g4e7bg8847g40e7af4a9b21"
msgid "Barrelstalks, full of poison - and under myconid control, no doubt."
msgstr "통줄기야, 맹독으로 가득하지. 그리고 분명, 마이코니드들이 통제하고 있는 것 같네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PAD_BarrelstalkInteraction
#. Speaker = Player
#. NodeID = a5c68dfa-9c12-bb06-f217-6b3a844b6948
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_Knows_Barrelstalks = False
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PAD_BarrelstalkInteraction:a5c68dfa-9c12-bb06-f217-6b3a844b6948
msgctxt "he2c3f7a9g21a6g42b1ga2efgd81a01ef2c81"
msgid "That thing reeks of poison. Best not disturb it."
msgstr "저기서 맹독의 악취가 풍겨. 건드리지 않는 게 좋겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PAD_BarrelstalkInteraction
#. Speaker = Player
#. NodeID = a5c68dfa-9c12-bb06-f217-6b3a844b6948
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_Knows_Barrelstalks = False
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PAD_BarrelstalkInteraction:a5c68dfa-9c12-bb06-f217-6b3a844b6948
msgctxt "hd495185fg72b2g4871g84fcgb37b718b242f"
msgid "These things reek of poisonous rot. Best keep a wary distance."
msgstr "이것들에서 독성 부패의 악취가 풍겨. 적당히 거리를 유지하는 편이 좋겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PAD_BarrelstalkInteraction
#. Speaker = Player
#. NodeID = a5c68dfa-9c12-bb06-f217-6b3a844b6948
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_Knows_Barrelstalks = False
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PAD_BarrelstalkInteraction:a5c68dfa-9c12-bb06-f217-6b3a844b6948
msgctxt "h9fc97b75g245cg48bagb543g0087ac64908a"
msgid "Blech. These things smell like <i>death.</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PAD_BarrelstalkInteraction
#. Speaker = Player
#. NodeID = a5c68dfa-9c12-bb06-f217-6b3a844b6948
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_Knows_Barrelstalks = False
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PAD_BarrelstalkInteraction:a5c68dfa-9c12-bb06-f217-6b3a844b6948
msgctxt "h1cec1914g1774g4731g89e8g22c7bbd3b4b1"
msgid "Swollen with vapour. A toxin of some sort."
msgstr "증기로 부풀어 올랐어. 독소인 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PAD_BarrelstalkInteraction
#. Speaker = Player
#. NodeID = a5c68dfa-9c12-bb06-f217-6b3a844b6948
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_Knows_Barrelstalks = False
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PAD_BarrelstalkInteraction:a5c68dfa-9c12-bb06-f217-6b3a844b6948
msgctxt "hfc94711bgfa9bg4ff4g9325g9225f1a8f26e"
msgid ""
"<i>Ugh</i>. Full of poisonous gas, like a dwarf in a brewery. Best left "
"alone."
msgstr "<i>욱</i>. 독성 연기가 가득해, 마치 드워프 양조장에 온 것 같군. 가만히 내버려 두는 편이 좋겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PAD_BarrelstalkInteraction
#. Speaker = Player
#. NodeID = a5c68dfa-9c12-bb06-f217-6b3a844b6948
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_Knows_Barrelstalks = False
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PAD_BarrelstalkInteraction:a5c68dfa-9c12-bb06-f217-6b3a844b6948
msgctxt "hf467810ag2289g4ae8g88e5g93e51c12a1ad"
msgid "I'm not messing with that - thing's filled with poison."
msgstr "저건 건드리지 않는 게 좋겠어, 독소가 가득하군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PAD_BarrelstalkInteraction
#. Speaker = Player
#. NodeID = a5c68dfa-9c12-bb06-f217-6b3a844b6948
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_Knows_Barrelstalks = False
#. TagRule: REALLY_UNDERDARK
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PAD_BarrelstalkInteraction:a5c68dfa-9c12-bb06-f217-6b3a844b6948
msgctxt "h05149cecgf428g4297g8fe0gf50c1aeb27f4"
msgid "Barrelstalk, bloated with poison. Better leave it be."
msgstr "통줄기야, 독으로 부풀어 올랐군. 건드리지 않는 게 좋겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PAD_BarrelstalkInteraction
#. Speaker = Player
#. NodeID = a5c68dfa-9c12-bb06-f217-6b3a844b6948
#. HandlePath = TaggedText[7].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_Knows_Barrelstalks = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PAD_BarrelstalkInteraction:a5c68dfa-9c12-bb06-f217-6b3a844b6948
msgctxt "h1375b534g427fg4bceg8be6g87d619679232"
msgid "It's bloated with poison. Better leave it be."
msgstr "독으로 부풀어 올랐어. 내버려 두는 편이 좋겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PetrifiedDrow_PAD_AfterCombat
#. Speaker = Player
#. NodeID = 9bc72d8c-e079-81b8-4b79-68ccac42ab1d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_PetrifiedDrow_State_CanCommentOnPetrificationRay = False
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PetrifiedDrow_PAD_AfterCombat:9bc72d8c-e079-81b8-4b79-68ccac42ab1d
msgctxt "h17fe1ecbg3d52g46a6g8aa7gfb253fada326"
msgid "Entombed forever in stone. A grim fate."
msgstr "석상으로 영원히 매장되다니. 암울한 운명이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PetrifiedDrow_PAD_AfterCombat
#. Speaker = Player
#. NodeID = 9bc72d8c-e079-81b8-4b79-68ccac42ab1d
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_PetrifiedDrow_State_CanCommentOnPetrificationRay = False
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PetrifiedDrow_PAD_AfterCombat:9bc72d8c-e079-81b8-4b79-68ccac42ab1d
msgctxt "h2f91a2d7g5ccdg4a69g9cddge503d1729a71"
msgid ""
"It's one thing to be sculpted, another to become the sculpture. That was a "
"close call."
msgstr "조각을 하는 거랑, 조각상이 되는 것은 완전히 다른 일이지. 십년감수했군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PetrifiedDrow_PAD_AfterCombat
#. Speaker = Player
#. NodeID = 9bc72d8c-e079-81b8-4b79-68ccac42ab1d
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_PetrifiedDrow_State_CanCommentOnPetrificationRay = False
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PetrifiedDrow_PAD_AfterCombat:9bc72d8c-e079-81b8-4b79-68ccac42ab1d
msgctxt "h1acf21a8ga7d2g485dg821dg529b4ba7b483"
msgid "These used to be living people. What a fate."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PetrifiedDrow_PAD_AfterCombat
#. Speaker = Player
#. NodeID = 9bc72d8c-e079-81b8-4b79-68ccac42ab1d
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_PetrifiedDrow_State_CanCommentOnPetrificationRay = False
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PetrifiedDrow_PAD_AfterCombat:9bc72d8c-e079-81b8-4b79-68ccac42ab1d
msgctxt "h7700a178g5e0fg48e3g9283ga52f8853b5d1"
msgid "Flesh to stone. Powerful magic."
msgstr "육신을 바위로 바꾸다니. 강력한 마법이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PetrifiedDrow_PAD_AfterCombat
#. Speaker = Player
#. NodeID = 9bc72d8c-e079-81b8-4b79-68ccac42ab1d
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_PetrifiedDrow_State_CanCommentOnPetrificationRay = False
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PetrifiedDrow_PAD_AfterCombat:9bc72d8c-e079-81b8-4b79-68ccac42ab1d
msgctxt "h79d3f015gb081g4150g82efgbca2ce104c32"
msgid ""
"That was too close of a fight for my liking. Better be careful down here."
msgstr "너무 아슬아슬한 싸움이었어, 마음에 들지 않는데. 이 아래에선 조심해야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PetrifiedDrow_PAD_AfterCombat
#. Speaker = Player
#. NodeID = 9bc72d8c-e079-81b8-4b79-68ccac42ab1d
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_PetrifiedDrow_State_CanCommentOnPetrificationRay = False
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PetrifiedDrow_PAD_AfterCombat:9bc72d8c-e079-81b8-4b79-68ccac42ab1d
#, fuzzy
msgctxt "h2035ec1bg85bbg4c52g9a36g0a4f5dc7e974"
msgid "Forever petrified. A fate I'm glad to have avoided."
msgstr "영원히 석화되었어. 내가 아니라서 다행이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PetrifiedDrow_PAD_AfterCombat
#. Speaker = Player
#. NodeID = 9bc72d8c-e079-81b8-4b79-68ccac42ab1d
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_PetrifiedDrow_State_CanCommentOnPetrificationRay = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PetrifiedDrow_PAD_AfterCombat:9bc72d8c-e079-81b8-4b79-68ccac42ab1d
msgctxt "h80ee6659g9c72g4a72gbe49g1cb0625a8786"
msgid "One wrong move and I'd have been a statue, imprisoned for eternity..."
msgstr "한 번이라도 잘못 움직였다간 내가 바위가 되어 영원히 감금될 뻔했어..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PetrifiedDrow_PAD_AfterCombat
#. Speaker = Player
#. NodeID = c8254e2b-a632-590e-870a-4b58133227f1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_PetrifiedDrow_State_CanCommentOnPetrificationRay = True
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PetrifiedDrow_PAD_AfterCombat:c8254e2b-a632-590e-870a-4b58133227f1
msgctxt "h1bb96630g7130g49a6g8d04ge2fe759f39b1"
msgid "Since when could spectators turn you to stone?"
msgstr "언제부터 스펙테이터가 석화 마법을 쓸 수 있게 된 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PetrifiedDrow_PAD_AfterCombat
#. Speaker = Player
#. NodeID = c8254e2b-a632-590e-870a-4b58133227f1
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_PetrifiedDrow_State_CanCommentOnPetrificationRay = True
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PetrifiedDrow_PAD_AfterCombat:c8254e2b-a632-590e-870a-4b58133227f1
msgctxt "he86907a8g966dg4c33gb0b4gf163364f7267"
msgid ""
"Spectators don't normally possess the ability to petrify. Something's not "
"adding up."
msgstr "스펙테이터가 석화 능력을 갖는 건 드문 일인데. 뭔가 이상해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PetrifiedDrow_PAD_AfterCombat
#. Speaker = Player
#. NodeID = c8254e2b-a632-590e-870a-4b58133227f1
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_PetrifiedDrow_State_CanCommentOnPetrificationRay = True
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PetrifiedDrow_PAD_AfterCombat:c8254e2b-a632-590e-870a-4b58133227f1
msgctxt "h24a80629g0854g406cga471g7823b8931648"
msgid "A spectator couldn't have done this - could it?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PetrifiedDrow_PAD_AfterCombat
#. Speaker = Player
#. NodeID = c8254e2b-a632-590e-870a-4b58133227f1
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_PetrifiedDrow_State_CanCommentOnPetrificationRay = True
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PetrifiedDrow_PAD_AfterCombat:c8254e2b-a632-590e-870a-4b58133227f1
msgctxt "h2ba74114g0754g420ega927gf70ed59f8d56"
msgid "A spectator. I've battled the likes before, within the Eye of the Sky."
msgstr "스펙테이터군. 이런 놈들과 전에도 싸워본 적이 있지, 창공의 눈에서 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PetrifiedDrow_PAD_AfterCombat
#. Speaker = Player
#. NodeID = c8254e2b-a632-590e-870a-4b58133227f1
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_PetrifiedDrow_State_CanCommentOnPetrificationRay = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PetrifiedDrow_PAD_AfterCombat:c8254e2b-a632-590e-870a-4b58133227f1
msgctxt "h166845a1g93f1g42abgb653g7f970c3c432e"
msgid "Since when can spectators petrify their victims...?"
msgstr "언제부터 스펙테이터가 석화 마법을 쓸 수 있게 된 거야...?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PetrifiedDrow_PAD_AfterCombat
#. Speaker = Player
#. NodeID = c8254e2b-a632-590e-870a-4b58133227f1
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_PetrifiedDrow_State_CanCommentOnPetrificationRay = True
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PetrifiedDrow_PAD_AfterCombat:c8254e2b-a632-590e-870a-4b58133227f1
msgctxt "h421e2eafgfa2dg4322g9e33g3b762812a0ef"
msgid "Odd - I didn't know a spectator could <i>petrify</i> its victims."
msgstr "이상하군. 스펙테이터가 <i>석화</i> 마법을 사용할 수 있는 줄은 몰랐는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PetrifiedDrow_PAD_AfterCombat
#. Speaker = Player
#. NodeID = c8254e2b-a632-590e-870a-4b58133227f1
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_PetrifiedDrow_State_CanCommentOnPetrificationRay = True
#. TagRule: WIZARD
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PetrifiedDrow_PAD_AfterCombat:c8254e2b-a632-590e-870a-4b58133227f1
msgctxt "hec5c6025gb927g427cg956fg550ec0bea92b"
msgid "A petrification ray... someone addled that spectator."
msgstr "석화 광선이라... 누군가 저 스펙테이터를 가지고 장난을 쳐놨군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PetrifiedDrow_PAD_AfterCombat
#. Speaker = Player
#. NodeID = c8254e2b-a632-590e-870a-4b58133227f1
#. HandlePath = TaggedText[7].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_PetrifiedDrow_State_CanCommentOnPetrificationRay = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PetrifiedDrow_PAD_AfterCombat:c8254e2b-a632-590e-870a-4b58133227f1
msgctxt "hd9fb0e86g05f0g4870g8e77gfccbd719d2e2"
msgid "Drow. And worse... What were they doing here?"
msgstr "드로우잖아. 더 심한 놈도 있고... 여기서 뭘 하고 있었던 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PetrifiedDrow_PAD_EnteringArea
#. Speaker = Player
#. NodeID = 0452e224-6f9e-653a-fe8e-fd35438b0cf0
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PetrifiedDrow_PAD_EnteringArea:0452e224-6f9e-653a-fe8e-fd35438b0cf0
msgctxt "h6b421ae6g4348g495aga047ga9a3b503c25c"
msgid "Huh. Drow statues are normally more regal and pompous."
msgstr "흠. 드로우 조각상은 보통 거만하고 웅장한 편인데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PetrifiedDrow_PAD_EnteringArea
#. Speaker = Player
#. NodeID = 0452e224-6f9e-653a-fe8e-fd35438b0cf0
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PetrifiedDrow_PAD_EnteringArea:0452e224-6f9e-653a-fe8e-fd35438b0cf0
msgctxt "h3e1518c9g177cg4148g9540gc43f2600bf0f"
msgid "These aren't statues. These are petrified drow!"
msgstr "이건 조각상이 아니야. 석화된 드로우야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PetrifiedDrow_PAD_EnteringArea
#. Speaker = Player
#. NodeID = 0452e224-6f9e-653a-fe8e-fd35438b0cf0
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PetrifiedDrow_PAD_EnteringArea:0452e224-6f9e-653a-fe8e-fd35438b0cf0
msgctxt "haf4c26eagf1e8g41b7g820ag4954a9df787f"
msgid ""
"Something's off with these statues. I don't think these were carved from "
"stone."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PetrifiedDrow_PAD_EnteringArea
#. Speaker = Player
#. NodeID = 0452e224-6f9e-653a-fe8e-fd35438b0cf0
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PetrifiedDrow_PAD_EnteringArea:0452e224-6f9e-653a-fe8e-fd35438b0cf0
msgctxt "h4f037be9g2d67g4674gb06egb00b91d023d2"
msgid "Those are not simple statues. This means trouble."
msgstr "이건 평범한 조각상이 아니야. 곤란한 상황이 생기겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PetrifiedDrow_PAD_EnteringArea
#. Speaker = Player
#. NodeID = 0452e224-6f9e-653a-fe8e-fd35438b0cf0
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PetrifiedDrow_PAD_EnteringArea:0452e224-6f9e-653a-fe8e-fd35438b0cf0
msgctxt "h3cf41b8ege142g4cd8gbb6fgfa393ea8c436"
msgid "Somehow I doubt these figures were made with hammer and chisel..."
msgstr "뭔가 망치와 끌로 만들어진 조각상이 아닌 것 같은데..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PetrifiedDrow_PAD_EnteringArea
#. Speaker = Player
#. NodeID = 0452e224-6f9e-653a-fe8e-fd35438b0cf0
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PetrifiedDrow_PAD_EnteringArea:0452e224-6f9e-653a-fe8e-fd35438b0cf0
msgctxt "h14975ccfg7887g43b0ga4c7g9ac975dd9ba0"
msgid "Statues - but I don't think those were made by a sculptor..."
msgstr "조각상이야. 하지만 조각가가 만든 건 아닌 것 같은데..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PetrifiedDrow_PAD_EnteringArea
#. Speaker = Player
#. NodeID = 0452e224-6f9e-653a-fe8e-fd35438b0cf0
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PetrifiedDrow_PAD_EnteringArea:0452e224-6f9e-653a-fe8e-fd35438b0cf0
msgctxt "h4fec6cc0g525dg4f19gb269gcc4ba625def0"
msgid "Statues? Strange..."
msgstr "조각상? 이상한데..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_RottenBanquet_PAD
#. Speaker = Player
#. NodeID = 10da965a-5c99-41a2-be33-65aa6c0c38d3
