msgctxt "h28477c55gb128g416bga355gbea2e40f2c75"
msgid ""
"The truth is, if there is a devil running wild, we might <i>have</i> to deal "
"with it one way or another."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Tollhouse_PAD_RefugeesAreCultists
