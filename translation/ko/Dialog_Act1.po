msgctxt "he309d653g8792g4a3aga81fg4bac0b159af7"
msgid "*Sigh.* Must you?"
msgstr "*하아.* 꼭 그래야만 하겠습니까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_SpiderFight_AD
#. Speaker = Lur Xanta
#. NodeID = 273a3b65-440b-1caf-c601-c6fdf839ab53
