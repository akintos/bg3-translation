msgid "It's a tough journey. The gnomes will be a burden."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp
#. Speaker = Novice Grumm
#. NodeID = 0e08b1b6-72bc-0bb6-15e9-a1fc34d824ac
