msgctxt "h549aaf71ga493g473cg8e70g942adee8d88f"
msgid "Heavy. And nothing to hold it in place."
msgstr "무거워. 게다가 고정할 방법도 없군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_MerregonMask_PAD
