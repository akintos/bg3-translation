msgctxt "h5fe4f2d4g1375g41c9g97a6g77c6a02ee9d5"
msgid "Damn thing's too heavy."
msgstr "이 망할 것이 너무 무거워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_TooHeavy
#. Speaker = Player
