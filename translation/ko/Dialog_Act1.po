msgctxt "h8461669cgd8c1g4a41ga750g56f7a3efa511"
msgid "*Ragzlin pierces your mind, prodding for truth.*"
msgstr "*라그즐린이 당신의 정신을 꿰뚫으며, 진실을 촉구합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying
#. Speaker = Player
#. NodeID = 25fb5a60-12a1-9428-a2d6-c788f9806e8c
