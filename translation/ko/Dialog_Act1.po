msgctxt "h0fca0ed7g1057g43bag98d9g314dd9a275b0"
msgid "*The spell's power wanes. You can ask no more questions.*"
msgstr "*주문의 힘이 약해집니다. 더 이상 질문을 할 수 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithCaptain_Dead
#. Speaker = Sarth Baretha
#. NodeID = f389d097-9aa2-4f2d-9f0f-8167f7088655
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithCaptain_Dead:f389d097-9aa2-4f2d-9f0f-8167f7088655
msgctxt "hcb92a2d3gc177g4a57gb854gb2291a68062e"
msgid "Sarth... warrior of Vlaakith..."
msgstr "사스... 블라키스의 전사..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithCaptain_Dead
#. Speaker = Narrator
#. NodeID = f4efeb64-f077-4d76-b091-e6abb044ff37
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_Killer(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithCaptain_Dead:f4efeb64-f077-4d76-b091-e6abb044ff37
msgctxt "ha738e653gf39dg4bbega8bdg78311ca45b8e"
msgid "*The corpse seems willing to speak - but not to its killer.*"
msgstr "*시체는 말할 의지가 있지만, 자신을 죽인 자와 대화하고 싶지는 않은 듯 합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_GithCaptainFirstTurn
#. Speaker = Sarth Baretha
#. NodeID = d0d9eb06-93b2-4abc-bb33-8e416a434780
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_GithCaptainFirstTurn:d0d9eb06-93b2-4abc-bb33-8e416a434780
msgctxt "h57967639g464dg44cag92c1g5ed17d3ec5cf"
msgid "You are outmatched. An inglorious bloodletting awaits."
msgstr "넌 상대가 안된다. 무의미한 살육이 있을 뿐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_LaezelBetrayed
#. Speaker = Lae'zel
#. NodeID = ae50b12d-e43d-411c-9b0c-3a68bc5c479b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_LaezelBetrayed:ae50b12d-e43d-411c-9b0c-3a68bc5c479b
msgctxt "h585a6bc9g8c26g435fg9227g6875e6da4642"
msgid "Traitors to our queen: <i>I will make you suffer!</i>"
msgstr "여왕님을 배반하다니, <i>고통스럽게 죽여주마!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_AD_LaezelPostConfrontation
#. Speaker = Lae'zel
#. NodeID = 0968b520-ed9b-956b-5fea-5d1d6245fb95
