#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Dialog:
#.      - UND_MushroomHunter_HasMet(1) = False
#.   Local:
#.      - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_AcknowledgeBaelenQuery = False
#. SetFlags:
#.   Local:
#.     - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_AcknowledgeBaelenQuery = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:159d1f7d-d2d0-dba7-33f9-6a9f6c4f9a56
msgctxt "h33083a19ga407g479fgbf39gf43945007a16"
msgid "Yes, I've met him."
msgstr "네, 그를 만나봤습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = 16811065-56bb-21a9-511e-d1ff9884b223
