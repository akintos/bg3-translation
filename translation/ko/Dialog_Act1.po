#. NodeID = 1640a7f2-7b0d-b5fc-523e-694a1f1d3a49
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithChief:1640a7f2-7b0d-b5fc-523e-694a1f1d3a49
msgctxt "h46972ba6g76fbg40a2g97c3g8816136cc177"
msgid "You have already failed me once, and now you dare question me?"
msgstr "이미 날 한 번 실망시켜놓고, 감히 내게 이의를 제기해?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithChief
#. Speaker = Rozzak
#. NodeID = 19492776-c28f-5695-78cc-a7b96836c860
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithChief:19492776-c28f-5695-78cc-a7b96836c860
msgctxt "h6a83eeafg7c7eg4fa5g920cg1a88e1436f9b"
msgid ""
"What they do ain't exactly fightin'. All they gotta do is light up their "
"powder and <i>burn</i>."
msgstr "그놈들은 싸울 필요는 없슴다. 화약에 불을 붙여서 <i>터지기만</i> 하면 되니까요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithChief
#. Speaker = Nightwarden Minthara
#. NodeID = 424cb567-5cb2-7e7a-73f3-011748aa42b3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 082d06e7-80c7-d56f-2f0a-c90f93ad7c83_A = True
#. SetFlags:
#.   Local:
#.     - 082d06e7-80c7-d56f-2f0a-c90f93ad7c83_B = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithChief:424cb567-5cb2-7e7a-73f3-011748aa42b3
msgctxt "hfacc3c83gff33g4a7ega249g86a80d8e8a63"
msgid "The village to the east - it's abandoned?"
msgstr "동쪽에 있는 마을은 버려진 마을인가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithChief
#. Speaker = Nightwarden Minthara
#. NodeID = 4a6a9aa8-7899-3f38-5b6f-0258cb31cd96
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithChief:4a6a9aa8-7899-3f38-5b6f-0258cb31cd96
msgctxt "h45322a70gd7fcg4d0cgbb9dg916e1860e3c5"
msgid "If he doesn't, I'll cut out his tongue."
msgstr "말하지 않는다면 내가 혀를 잘라 버리면 되겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithChief
#. Speaker = Nightwarden Minthara
#. NodeID = 4ed42989-6ce4-629f-dadf-bd5c7ba180fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithChief:4ed42989-6ce4-629f-dadf-bd5c7ba180fe
msgctxt "h5972f75fgbf88g461bg9a83g9e350f32d1da"
msgid "It's not our concern. Our prey are elsewhere."
msgstr "우리 알 바 아니다. 우리의 사냥감은 다른 곳에 있으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithChief
#. Speaker = Nightwarden Minthara
#. NodeID = 56feb1ff-f355-8f0c-4ece-5c22b0412527
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithChief:56feb1ff-f355-8f0c-4ece-5c22b0412527
msgctxt "h5f88db91gebc7g4546ga966g6b3cced02252"
msgid "Then they're prepared to <i>die</i> for the Absolute. Good."
msgstr "그럼 절대자님을 위해 <i>죽을</i> 준비가 되었다는 거군. 좋았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithChief
#. Speaker = Rozzak
#. NodeID = 59b9fb2a-c3b7-f260-5c07-d34ca2a99857
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithChief:59b9fb2a-c3b7-f260-5c07-d34ca2a99857
msgctxt "h6cea18abg931ag4820g8c88gefa8e6ab1f19"
msgid "I, er... didn't mean nothin' by it, yer ladyship. Honest I didn't."
msgstr "전, 어... 그런 뜻이 아니라, 마님. 진짜로 불만이라든가 그런 게 아니라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithChief
#. Speaker = Nightwarden Minthara
#. NodeID = 60cfa66b-21ed-5248-9ccc-9ca2759d7d05
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithChief:60cfa66b-21ed-5248-9ccc-9ca2759d7d05
msgctxt "h6ccaf270g640dg47f4g952cg2aeedf1771ab"
msgid "The prisoner can keep his tongue - it's Spike's I'll be removing."
msgstr "포로의 혀는 내 알 바 아니야 - 내가 자를 건 스파이크의 혀니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithChief
#. Speaker = Nightwarden Minthara
#. NodeID = 633c5c35-aefa-08c4-e99c-0600623e827f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithChief:633c5c35-aefa-08c4-e99c-0600623e827f
msgctxt "hbc7ccfd4g906dg4333g97b6g4dbd0b294029"
msgid ""
"Your life, much like your words, is meaningless, whelp. End the latter to "
"save the former."
msgstr "네 생명은 네 말만큼이나 경박하군. 보전하고 싶으면 입을 닫아라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithChief
#. Speaker = Rozzak
#. NodeID = 9cde7fe5-8a03-ef81-66c7-322a11f4b5a1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_DrowCommander_Event_GotTortureReport = True
#. SetFlags:
#.   Global:
#.     - GOB_DrowCommander_Event_GotTortureReport = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithChief:9cde7fe5-8a03-ef81-66c7-322a11f4b5a1
msgctxt "h7d8e2b6fgb993g4a21g91bdg88137188b568"
msgid "Prisoner'll talk, yer ladyship. Spike always makes 'em talk."
msgstr "포로들은 곧 입을 열검다, 마님. 스파이크가 입을 열게 할검다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithChief
#. Speaker = Rozzak
#. NodeID = ab751375-81bb-d721-5211-2aebb75e9b9a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 082d06e7-80c7-d56f-2f0a-c90f93ad7c83_A = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithChief:ab751375-81bb-d721-5211-2aebb75e9b9a
msgctxt "ha622b6d8gfe39g4728gbe4eg6b69f7f50fe6"
msgid ""
"Wot are we waitin' for? Spears are sharp, the lads are all riled up an' "
"ready!"
msgstr "뭘 기다리시는 검니까? 창은 날카롭고, 우리 애들도 완전히 준비됐다구요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithChief
#. Speaker = Rozzak
#. NodeID = af8591f7-0626-ae41-61e3-9788f0dfe12d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithChief:af8591f7-0626-ae41-61e3-9788f0dfe12d
msgctxt "h58a49618gf17eg4c10gb38fg87ae67c68356"
msgid "Dyin's the only thing they're good at."
msgstr "저놈들이 잘하는 건 뒈지는 거 밖에 없습죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithChief
#. Speaker = Rozzak
#. NodeID = bde38331-86d0-d983-0df1-809dc9ccc8a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithChief:bde38331-86d0-d983-0df1-809dc9ccc8a3
msgctxt "h66333df4g2365g4ac1g8e37g90ce708e9b14"
msgid ""
"Plenty of lashers, loads of hunters... and a few pariahs to carry the powder "
"kegs."
msgstr "수많은 래셔들과 사냥꾼 무리... 그리고 화약을 운반하는 쳔민이 좀 있슴다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithChief
#. Speaker = Nightwarden Minthara
#. NodeID = c4c92307-33d4-2f7d-8a93-d169c3db0c0a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 082d06e7-80c7-d56f-2f0a-c90f93ad7c83_B = True
#. SetFlags:
#.   Local:
#.     - 082d06e7-80c7-d56f-2f0a-c90f93ad7c83_A = False
#.     - 082d06e7-80c7-d56f-2f0a-c90f93ad7c83_B = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithChief:c4c92307-33d4-2f7d-8a93-d169c3db0c0a
msgctxt "h385ba1afg4150g409cgbbd0g586db2495049"
msgid "How many raiders do we have?"
msgstr "습격대는 몇 명이나 있지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithChief
#. Speaker = Rozzak
#. NodeID = dd8d1ce0-c143-4306-78c8-3dfa5d1eb70d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithChief:dd8d1ce0-c143-4306-78c8-3dfa5d1eb70d
msgctxt "h9f57f6a7g163fg4140g948bgf70917b29a0b"
msgid ""
"Looks that way. But scouts said they heard somethin' movin' around out "
"there. Somethin' big."
msgstr "그렇게 보이기는 하는데, 정찰대가 뭔가 커다란 것이 움직이는 걸 들었다고 했슴다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithChief
#. Speaker = Nightwarden Minthara
#. NodeID = e7ae4cd1-7c26-d003-3f0e-aa93b80a07ef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithChief:e7ae4cd1-7c26-d003-3f0e-aa93b80a07ef
msgctxt "hf0247456g801eg48bfga96fg0aac438ae3cc"
msgid "These pariahs - they're prepared to fight for the Absolute?"
msgstr "이 천민들. 그것들은 절대자님을 위해 싸울 준비가 되었나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithPatrol
#. Speaker = Zurga
#. NodeID = 1e0f6edb-3848-4628-7e4c-ce94aba54406
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Checkpoint_State_PretendedToBeTrueSouls = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithPatrol:1e0f6edb-3848-4628-7e4c-ce94aba54406
msgctxt "hcd4464cdg3239g455dg8edfg23a795cc8db8"
msgid "We got visitors. Dunno who they are - mercenaries maybe?"
msgstr "방문객이 왔습니다. 누군지 모르겠는데, 용병인 것 같기도 하고 말입죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithPatrol
#. Speaker = Zurga
#. NodeID = 3bb07371-1171-ca39-7f10-97ef2967cd43
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_DrowCommander_Event_GotTortureReport = True
#.   Local:
#.     - 71859852-11f6-5c96-6c59-e4c5add51926_A = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithPatrol:3bb07371-1171-ca39-7f10-97ef2967cd43
msgctxt "hc5181b9cgdbd8g405fgafdeg2aee63049c9b"
msgid "Sorry to bother you, mistress... got a message from the guards."
msgstr "방해해서 죄송합니다만... 경비대에게서 전갈입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithPatrol
#. Speaker = Nightwarden Minthara
#. NodeID = 5109550a-774c-99cc-0e70-2cd05900468c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithPatrol:5109550a-774c-99cc-0e70-2cd05900468c
msgctxt "h52a80990ga43dg429bg8d3ag4744f85189de"
msgid "Yes?"
msgstr "응?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithPatrol
#. Speaker = Nightwarden Minthara
#. NodeID = 61f1e730-120e-c30b-94f5-7c3da0a08878
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithPatrol:61f1e730-120e-c30b-94f5-7c3da0a08878
msgctxt "h88e2734eg9121g4da3g8153g2a6c20be2fb7"
msgid "Interesting. I wasn't expecting guests."
msgstr "재밌네. 손님이 올 거라고는 생각도 못 했는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithPatrol
#. Speaker = Nightwarden Minthara
#. NodeID = 8760faaf-c171-2f86-e3a4-1dfbcbc35096
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithPatrol:8760faaf-c171-2f86-e3a4-1dfbcbc35096
msgctxt "h808124bdg87d1g40a8ga00bgbcd5d229baa6"
msgid "And the prisoner?"
msgstr "죄수는?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithPatrol
#. Speaker = Nightwarden Minthara
#. NodeID = 879392b0-caef-5813-b8a9-e21f47355bc7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithPatrol:879392b0-caef-5813-b8a9-e21f47355bc7
msgctxt "h3b4bb79cgc7c0g43a9ga5a8gac76166eb473"
msgid "Tell them to stop cutting him - we need him alive."
msgstr "피를 내는 건 그만하라 일러라. 살려두어야 하니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithPatrol
#. Speaker = Zurga
#. NodeID = 989c0c3b-e421-6e94-e712-15a1eb5b1b2a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithPatrol:989c0c3b-e421-6e94-e712-15a1eb5b1b2a
msgctxt "h7aa4e744gb59dg4d79ga818ge0af13d7c9e9"
msgid "We're still workin' on him."
msgstr "아직 심문 중입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithPatrol
#. Speaker = Zurga
#. NodeID = a38f9629-bae4-c6a0-493f-93c89d5871d3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Checkpoint_State_PretendedToBeTrueSouls = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithPatrol:a38f9629-bae4-c6a0-493f-93c89d5871d3
msgctxt "hfafdd0e6g0e6bg4d8agbbb5g0a3710ca7ba8"
msgid "We got visitors - more True Souls like yerself."
msgstr "방문객이 왔습니다. 대장님처럼 참된 영혼입니다요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithPatrol
#. Speaker = Zurga
#. NodeID = bd38976b-2aa7-881a-892e-9498ab7f4b48
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 71859852-11f6-5c96-6c59-e4c5add51926_A = True
#. SetFlags:
#.   Global:
#.     - GOB_DrowCommander_Event_GotTortureReport = True
#.   Local:
#.     - 71859852-11f6-5c96-6c59-e4c5add51926_B = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithPatrol:bd38976b-2aa7-881a-892e-9498ab7f4b48
msgctxt "he6a58f9dg8f93g4508gb6efg94aed730c567"
msgid ""
"Raiders are just waiting for the word, mistress. We're ready for anything."
msgstr "습격대는 명령만 떨어지길 기다리고 있습니다, 대장님. 모든 준비가 됐습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithPatrol
#. Speaker = Nightwarden Minthara
#. NodeID = e25550ec-9492-11b7-cfc6-b22cf4d09890
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithPatrol:e25550ec-9492-11b7-cfc6-b22cf4d09890
msgctxt "hf5fe9e86g6221g432dgaa09gf80a0e747ae4"
msgid "Break his bones instead. Start with the fingers."
msgstr "대신 뼈를 부러뜨리도록. 손가락부터."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithPatrol
#. Speaker = Zurga
#. NodeID = fcbd40a5-2a76-d696-6492-3fb13492620c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 71859852-11f6-5c96-6c59-e4c5add51926_B = True
#. SetFlags:
#.   Global:
#.     - GOB_DrowCommander_Event_GotTortureReport = True
#.   Local:
#.     - 71859852-11f6-5c96-6c59-e4c5add51926_B = False
#.     - 71859852-11f6-5c96-6c59-e4c5add51926_A = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WithPatrol:fcbd40a5-2a76-d696-6492-3fb13492620c
msgctxt "hf7f8b3c5g7643g44f0g8a14gb17a934b8649"
msgid "Prisoner's lost a lot of blood, yer ladyship. Still ain't talkin."
msgstr "죄수가 피를 많이 흘렸습니다, 대장님. 여전히 입을 열지 않는군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_CryingOverBody
#. Speaker = Tracker Kirz
#. NodeID = 25ecb3f4-fb99-2473-4829-ae53b5b128b8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - aef97870-92cd-1837-5f44-1b8750e0efad_C = True
#.      - aef97870-92cd-1837-5f44-1b8750e0efad_A = True
#.      - aef97870-92cd-1837-5f44-1b8750e0efad_B = True
#. SetFlags:
#.   Local:
#.     - aef97870-92cd-1837-5f44-1b8750e0efad_C = False
#.     - aef97870-92cd-1837-5f44-1b8750e0efad_A = False
#.     - aef97870-92cd-1837-5f44-1b8750e0efad_B = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrunkGoblin_AD_CryingOverBody:25ecb3f4-fb99-2473-4829-ae53b5b128b8
msgctxt "h8f900891g1401g49cag8c47g09c64c436df5"
msgid "How...?"
msgstr "어떻게...?"

