#.   Script:
#.      - GEN_CanDetectThoughts_2 = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim:84e0430a-b389-e393-5585-fbf342f4d85a
msgctxt "hb2c91734g0d30g42cbg8bc5gb64dd990ba72"
msgid "<i>Read his mind.</i>"
msgstr "<i>그의 생각을 읽는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim
#. Speaker = Player
#. NodeID = 9221989e-e5ac-cdb7-a0ee-e0268d69c0fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim:9221989e-e5ac-cdb7-a0ee-e0268d69c0fe
msgctxt "h7e34120dge21eg42acg854eg0f820b9a3228"
msgid "I know the pass-phrase: 'Little serpent, long shadow'."
msgstr "암구호를 알고 있어: '작은 뱀, 긴 그림자'."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim
#. Speaker = Salazon
#. NodeID = 9613d1aa-8c88-0f33-0b23-4e2dd29af352
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - PLA_EscapingZhentarim_HasItem_HiddenEntranceKey2(0) = True
#. SetFlags:
#.   Dialog:
#.     - PLA_ZhentDungeon_Zhent01_HasMet(1) = True
#.   Global:
#.     - PLA_EscapingZhentarim_State_Permitted = True
#.   Object:
#.     - PLA_EscapingZhentarim_GiveItem_HiddenEntranceKey2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim:9613d1aa-8c88-0f33-0b23-4e2dd29af352
msgctxt "h54a3f5e9gc03eg474dgbdc7ge1ba896f90da"
msgid "Entrance is hidden behind the wardrobe - here's the key."
msgstr "입구는 옷장 뒤에 숨겨져 있어, 이 열쇠 받아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim
#. Speaker = Salazon
#. NodeID = ab86865f-c41c-2a64-44b4-972b7f792965
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim:ab86865f-c41c-2a64-44b4-972b7f792965
msgctxt "h1a2a810egcda5g420bg8a18gcb50147ed7d6"
msgid ""
"... let's say I'd rather not fight, then. What's your business down here?"
msgstr "... 그럼 내가 싸움을 원하지 않는다고 해보자고. 이 아래에 무슨 볼 일이 있는 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim
#. Speaker = Player
#. NodeID = ae9d669d-c611-2808-94df-c4f08ae39409
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - SORCERER_WILDMAGIC(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim:ae9d669d-c611-2808-94df-c4f08ae39409
msgctxt "h44f35258gc810g4baag9e36gdbcd38bc251d"
msgid "Every spell I cast could be my last. You think I fear death?"
msgstr "내가 시전하는 모든 주문이 마지막 주문이 될 수도 있어. 넌 내가 죽음을 두려워 한다고 생각하는 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim
#. Speaker = Player
#. NodeID = b6a1b9e2-fff8-6fa7-8b3c-095f7c44945a
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - SORCERER(1) = False
#.      - ROGUE(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim:b6a1b9e2-fff8-6fa7-8b3c-095f7c44945a
msgctxt "h44c454e4g9c55g4535ga0e6g2be9d3691d0f"
msgid "Just calm down - I'm not here to fight."
msgstr "잠깐 진정해, 난 싸우러 온 게 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim
#. Speaker = Salazon
#. NodeID = c42f1f91-186a-2e34-f0c5-e89fe191d098
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - PLA_EscapingZhentarim_HasItem_HiddenEntranceKey2(0) = False
#. SetFlags:
#.   Dialog:
#.     - PLA_ZhentDungeon_Zhent01_HasMet(1) = True
#.   Global:
#.     - PLA_EscapingZhentarim_State_Permitted = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim:c42f1f91-186a-2e34-f0c5-e89fe191d098
msgctxt "h1b5ab08agd26ag4a4egb37ag77e2bcfdda9c"
msgid ""
"Down you go - entrance is behind the wardrobe. You'll find a key in one of "
"the crates."
msgstr "아래로 내려가, 입구는 옷장 뒤에 있어. 열쇠는 상자들 중 하나 안에 있을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim
#. Speaker = Salazon
#. NodeID = c515eab3-ace0-4831-afeb-a608af90276e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim:c515eab3-ace0-4831-afeb-a608af90276e
msgctxt "h9ca74d23g6688g43c1ga91fgecb19b4b4ee4"
msgid "Bugger."
msgstr "망할."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim
#. Speaker = Narrator
#. NodeID = c909de7d-d7eb-f1aa-fbb1-5564f1236585
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_EscapingZhentarim_State_NearBreach = True
#.      - PLA_EscapingZhentarim_Event_Spotted = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim:c909de7d-d7eb-f1aa-fbb1-5564f1236585
msgctxt "h3a84f3f7g81e1g4854gb73fga72903937f0d"
msgid "*You spot a man crouching between the shelves - just as he spots you.*"
msgstr "*당신이 선반들 사이에 쪼그리고 있는 남자를 발견하는 동시에, 남자도 당신을 발견합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim
#. Speaker = Player
#. NodeID = c9b7c310-5be6-38a6-8961-6bc55852be2c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - ROGUE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim:c9b7c310-5be6-38a6-8961-6bc55852be2c
msgctxt "h6dab45d6g8546g4344g8dcfg295dbce163a5"
msgid "This is all pretty crude, as traps go - you'll probably kill us both."
msgstr "이 함정은 꽤나 조잡한걸. 너도 같이 죽게 될 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim
#. Speaker = Salazon
#. NodeID = d129f96f-698e-0957-8079-9e15bb074cb8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_EscapingZhentarim_State_BarrelGone = False
#.      - PLA_ZhentDungeon_State_PlayerNearBarrel = True
#. SetFlags:
#.   Global:
#.     - PLA_EscapingZhentarim_Escape = True
#.   User:
#.     - PLA_EscapingZhentarim_Knows_WasAttacked(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim:d129f96f-698e-0957-8079-9e15bb074cb8
msgctxt "h47953d76g5d0fg4afdga231g11025e89e45c"
msgid "That ain't the pass-phrase!"
msgstr "그건 암구호가 아니야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim
#. Speaker = Salazon
#. NodeID = d1e2f165-9299-6112-4ecf-87d6fa6878e3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim:d1e2f165-9299-6112-4ecf-87d6fa6878e3
msgctxt "h7be3cc41g961bg472bgbd76ga172516c2c86"
msgid ""
"Your timing ain't the best, but I'm sure Zarys won't turn down a deal. Down "
"you go, then."
msgstr "시기가 썩 좋진 않지만, 자리스가 거래를 거절하진 않을 거야. 자, 아래로 내려가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim
#. Speaker = Player
#. NodeID = e026a6a5-bdf0-276b-064c-378083e758b2
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Dexterity
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim:e026a6a5-bdf0-276b-064c-378083e758b2
msgctxt "hddb4cedfg0882g4f93g9871g24e4295396f2"
msgid "Wait - listen!"
msgstr "잠깐, 들어봐!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim
#. Speaker = Player
#. NodeID = e49ac53f-d50c-cb88-4ef4-caa47abcc7be
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ROGUE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim:e49ac53f-d50c-cb88-4ef4-caa47abcc7be
msgctxt "ha6a2c7e0gf9d4g4148gbe6cg33751ffe5b38"
msgid "<i>Flick out a single hand-sign: 'profit'.</i>"
msgstr "<i>손가락을 튕겨서 신호를 만든다. '이득'.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim
#. Speaker = Salazon
#. NodeID = e624aec8-9fff-58d6-2ab2-ea4ecea174d1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - d667ac86-b022-ec07-624c-a65971ddd4c3_MindHasBeenRead = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim:e624aec8-9fff-58d6-2ab2-ea4ecea174d1
msgctxt "ha8d8cec3g1f5cg4fb6g92dcg4d9c7fe44ae1"
msgid ""
"<i>'Little serpent, long shadow.' Don't want to die. 'Little serpent, long "
"shadow.' Just say it!</i>"
msgstr "<i>'작은 뱀, 긴 그림자.' 죽고 싶지 않아. '작은 뱀, 긴 그림자.' 그냥 말하라고!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim
#. Speaker = Player
#. NodeID = f3d31959-5f58-e59d-ad32-246d4d53f0f0
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - WIZARD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim:f3d31959-5f58-e59d-ad32-246d4d53f0f0
msgctxt "h93f249bfge9fdg47e1g8a66g6d84abf7ed76"
msgid "That spell, in close quarters? You're going to hurt yourself."
msgstr "이렇게 가까운 곳에서, 그 주문을 쓰겠다고? 너도 다칠 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim
#. Speaker = Narrator
#. NodeID = fb953d8e-ba3a-ecd4-2969-fe9dc2a6f908
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_EscapingZhentarim_State_NearBreach = True
#.      - PLA_EscapingZhentarim_Event_Spotted = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim:fb953d8e-ba3a-ecd4-2969-fe9dc2a6f908
msgctxt "hd6db82dbgaf3ag4467gb8b6g772366b1d97f"
msgid "*A human man awaits you, a spell crackling at his fingertips.*"
msgstr "*한 인간 남자가 당신을 바라보며, 손끝에서 주문을 타닥 피어올리고 있다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim_AD_Backup
