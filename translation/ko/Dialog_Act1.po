msgctxt "haee1d56bgf530g48f8gbc34ge082bd20b907"
msgid "Worked alone... better that way..."
msgstr "혼자 일했어... 그 편이 나으니까..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FairyRings_Dead
