msgid "<i>Ngh</i>. It's getting stronger."
msgstr "<i>윽</i>. 더 강해지는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_SwampExploration_PAD_HeroGear
