#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_BronzePlaque_AD_FL1Mural
#. Speaker = Player
#. NodeID = b866197a-6f8d-0964-44af-f00f7864eca6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_BronzePlaque_AD_FL1Mural:b866197a-6f8d-0964-44af-f00f7864eca6
msgctxt "h0cd508f3g6a3cg46b0g9f61g451c550cc354"
msgid "A dead tongue. Whoever worshipped here must be long gone."
msgstr "잊힌 언어군. 이곳이 누굴 섬겼는지는 몰라도 아주 옛날 일이겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_BronzePlaque_AD_FL1Mural
#. Speaker = Narrator
#. NodeID = d36d1513-866c-212b-9691-0efc49301bf3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_BronzePlaque_AD_FL1Mural:d36d1513-866c-212b-9691-0efc49301bf3
msgctxt "h00573395g2ef0g4366g8b21g0ca8de1d3e72"
msgid "*Ancient, indecipherable text covers the plaque.*"
msgstr "*알아볼 수 없는 고대 문자가 명판에 적혀 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_BronzePlaque_AD_OutsideStatue
#. Speaker = Player
#. NodeID = 85b4a404-5649-84c5-15e2-8e15d93a4a9c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_Shadowheart_SeluneComment = True
#. TagRule: CLERIC or PALADIN
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_BronzePlaque_AD_OutsideStatue:85b4a404-5649-84c5-15e2-8e15d93a4a9c
msgctxt "h3e506783gaee0g4460g8c8dgd6b8b527d8a9"
msgid "Text is too faded. Doesn't tell me who was worshipped here."
msgstr "글자가 너무 희미해. 이곳이 누굴 섬기던 곳인지 모르겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_BronzePlaque_AD_OutsideStatue
#. Speaker = Narrator
#. NodeID = c63052c0-1a83-7824-bc51-067baf396fd8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_BronzePlaque_AD_OutsideStatue:c63052c0-1a83-7824-bc51-067baf396fd8
msgctxt "h00eebac2ga1c4g486cg8fe0ge97cf22a9d61"
msgid "*Time and the elements have left the plaque unreadable.*"
msgstr "*세월과 비바람이 명판을 읽을 수 없게 만들었습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_BronzePlaque_AD_SanctumStatue
#. Speaker = Narrator
#. NodeID = ce92744c-dc29-5f72-36ca-38e4d1544066
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_BronzePlaque_AD_SanctumStatue:ce92744c-dc29-5f72-36ca-38e4d1544066
msgctxt "h2199ed62g42dbg4d27gbeceg2aab1e1cf569"
msgid "*You do not recognise the language on the plaque.*"
msgstr "*당신은 명판의 언어를 알아볼 수 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_BronzePlaque_AD_SanctumStatue
#. Speaker = Player
#. NodeID = e795d7ce-eb0d-dcb1-b7d2-605385aecbba
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_Shadowheart_SeluneComment = True
#. TagRule: CLERIC or PALADIN
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_BronzePlaque_AD_SanctumStatue:e795d7ce-eb0d-dcb1-b7d2-605385aecbba
msgctxt "h6a15413fgaf18g46cfg804dgbdca169f27db"
msgid "This text is ancient. A dedication to a forgotten god?"
msgstr "이 글귀는 고대의 것인데. 잊힌 신에 대한 헌정사인가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_BronzePlaque_AD_SqueletonRoom
#. Speaker = Player
#. NodeID = 557fdd14-8595-e348-21cc-80fe82d99195
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_Crypt_Event_JergalReligionCheckSuccess = False
#. TagRule: CLERIC or PALADIN
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_BronzePlaque_AD_SqueletonRoom:557fdd14-8595-e348-21cc-80fe82d99195
msgctxt "he03f3bd0g3454g4b30ga407gdf24595d2738"
msgid "I've never seen this language before. Who was worshipped here?"
msgstr "난생처음 보는 언어야. 여긴 대체 누굴 섬긴 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_BronzePlaque_AD_SqueletonRoom
#. Speaker = Narrator
#. NodeID = 94ebe2bc-efae-2fb6-6ee4-e3065ab81faf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_BronzePlaque_AD_SqueletonRoom:94ebe2bc-efae-2fb6-6ee4-e3065ab81faf
msgctxt "h8176044fg50b8g4b2dg9ae9g273e2934f80b"
msgid "*The inscription is in a language unknown to you.*"
msgstr "*비문은 당신에게 생소한 언어로 적혀있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_BronzePlaque_AD_TrappedTomb
#. Speaker = Narrator
#. NodeID = a4d00cf4-33b3-c719-f4a5-ff243abcc6d7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_BronzePlaque_AD_TrappedTomb:a4d00cf4-33b3-c719-f4a5-ff243abcc6d7
msgctxt "h933f54e0g1667g42b5g8b1bg38012580999c"
msgid "*The text on the plaque is a mystery to you.*"
msgstr "*명판의 글을 해독할 수가 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_BronzePlaque_AD_TrappedTomb
#. Speaker = Player
#. NodeID = f7e32e8e-25c4-c15d-6a45-d985c772bc28
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_Shadowheart_SeluneComment = True
#. TagRule: CLERIC or PALADIN
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_BronzePlaque_AD_TrappedTomb:f7e32e8e-25c4-c15d-6a45-d985c772bc28
msgctxt "h3e5ff80fg04feg47afga92bg198f13d957c5"
msgid "A dead language? Something ancient must have been worshipped here."
msgstr "잊힌 언어인가? 여긴 고대의 존재를 숭배한 곳인 게 분명하군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_BronzePlaque_PAD_RichSarcophagus
#. Speaker = Narrator
#. NodeID = 9ee9ffa8-973d-d176-1ba9-ccfa53e968a0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_BronzePlaque_PAD_RichSarcophagus:9ee9ffa8-973d-d176-1ba9-ccfa53e968a0
msgctxt "h1dde55c8g5f04g418eg8a15gf6ffcebb3d14"
msgid "*Here lies the Guardian of Tombs. Through knowledge comes atonement.*"
msgstr "*여기 무덤의 수호자가 누워 있노라. 지식을 통해 속죄가 이루어질지니.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditCrashBanter
#. Speaker = Andorn
#. NodeID = 049ca4d1-2e79-86ff-9a18-9348588802ae
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 3f665b97-a69e-81c5-68e6-5b931720721e_Part1 = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditCrashBanter:049ca4d1-2e79-86ff-9a18-9348588802ae
msgctxt "h5c4169cbgc14fg4208gb2f3gbe8e9b61e90c"
msgid "Relax! Just stick together."
msgstr "진정해! 일단 다들 뭉쳐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditCrashBanter
#. Speaker = Mari
#. NodeID = 0e56ec26-47e2-6a6b-91ba-d65a682f71ea
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3f665b97-a69e-81c5-68e6-5b931720721e_Part2 = False
#.      - 3f665b97-a69e-81c5-68e6-5b931720721e_Part1 = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditCrashBanter:0e56ec26-47e2-6a6b-91ba-d65a682f71ea
msgctxt "h65925280g02d1g4cd0g8062g2cd53cc55fcb"
msgid "Gods, there's something moving in there!"
msgstr "세상에, 저기 뭔가 움직이는 게 있어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditCrashBanter
#. Speaker = Andorn
#. NodeID = 3290d2f4-86bb-9f90-f29c-e754b0246db4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CHA_FL1_Event_CrashBanterOver = True
#.   Local:
#.     - 3f665b97-a69e-81c5-68e6-5b931720721e_Part2 = False
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditCrashBanter:3290d2f4-86bb-9f90-f29c-e754b0246db4
msgctxt "h08772467geef7g4083gb96ag1609799a0844"
msgid "Nah, let 'em come to us. Then stick 'em in the guts."
msgstr "아니, 놈들이 덤비게 놔둬. 그리고 배를 쑤셔버리자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditCrashBanter
#. Speaker = Barton
#. NodeID = 6124a376-1e2a-49ae-ceb8-66cd3ef732f7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3f665b97-a69e-81c5-68e6-5b931720721e_Part1 = False
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditCrashBanter:6124a376-1e2a-49ae-ceb8-66cd3ef732f7
msgctxt "ha95109a0g222cg4ff8g909fg5be4fb2742c5"
msgid "What the <i>hells</i> was that?"
msgstr "이건 또 뭔 <i>망할</i> 난리야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditCrashBanter
#. Speaker = Andorn
#. NodeID = b2796f3a-dc3e-d814-811e-4dce6eee205e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 3f665b97-a69e-81c5-68e6-5b931720721e_Part2 = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditCrashBanter:b2796f3a-dc3e-d814-811e-4dce6eee205e
msgctxt "h7a780636gc0b5g4391gbc1agb81834d34c8f"
msgid "Be ready for anything. I <i>told</i> you this wouldn't be easy..."
msgstr "준비들 단단히 해. 내가 이번 껀수 쉽게 풀리지 않을 <i>거랬잖아</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditCrashBanter
#. Speaker = Barton
#. NodeID = becec5a5-4e9f-1016-a57d-7f23365a9b6d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3f665b97-a69e-81c5-68e6-5b931720721e_Part2 = True
#.      - 3f665b97-a69e-81c5-68e6-5b931720721e_Part1 = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditCrashBanter:becec5a5-4e9f-1016-a57d-7f23365a9b6d
msgctxt "h2e50f9c3gf691g4983g9b1ag55465783e7b9"
msgid "Shall we rush 'em?"
msgstr "먼저 들이받을까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditCrashBanter
#. Speaker = Mari
#. NodeID = c3e3e533-8248-a345-10f2-676f438f65d2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditCrashBanter:c3e3e533-8248-a345-10f2-676f438f65d2
msgctxt "h4fedbbf5gfd61g4476gbd7fgfafec91be985"
msgid "The roof caved in - this place is a deathtrap!"
msgstr "지붕이 무너졌잖아. 우리 묫자리가 되게 생겼어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditGuardCallHelp
#. Speaker = Andorn
#. NodeID = 9813c992-5d41-31e3-e271-12178cafffc7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditGuardCallHelp:9813c992-5d41-31e3-e271-12178cafffc7
msgctxt "he609ab20g8fa0g4eeagae5fg0608550d2373"
msgid "Over here - we got company!"
msgstr "이리 와! 침입자가 들어왔어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditGuardSpotting
#. Speaker = Andorn
#. NodeID = 4a463eb7-cc9a-e401-e338-a6983d067519
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditGuardSpotting:4a463eb7-cc9a-e401-e338-a6983d067519
msgctxt "h28d67e6dgdec4g4a44g92a2g832fd55cc8a1"
msgid "Who the - we got company!"
msgstr "대체 뭔... 침입자다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditGuardSurprised
#. Speaker = Andorn
#. NodeID = 01fd970f-45e3-0c6e-ec6c-d9e9fcb04334
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_FL1_State_GuardWaitingAlly = False
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditGuardSurprised:01fd970f-45e3-0c6e-ec6c-d9e9fcb04334
msgctxt "h834bd3d7ga792g4b81g8680g44df9854dc78"
msgid "You're dead!"
msgstr "넌 뒈졌어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditGuardSurprised
#. Speaker = Andorn
#. NodeID = f90579bd-2cec-0f92-a45e-6227a53b0b51
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_FL1_State_GuardWaitingAlly = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditGuardSurprised:f90579bd-2cec-0f92-a45e-6227a53b0b51
msgctxt "hf80e9ca3g5cb1g4dadg974fg4d04d39f030e"
msgid "Who the hells? You're dead!"
msgstr "이건 또 누구야? 넌 뒈졌어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditGuardWarning
#. Speaker = Andorn
#. NodeID = c0da1f8e-3683-8c56-b1a8-0c864109857c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditGuardWarning:c0da1f8e-3683-8c56-b1a8-0c864109857c
msgctxt "hfa2288dcgff5dg4c34g9e64g9fb9b613abd7"
msgid "We got company!"
msgstr "침입자다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditLockpickerCallHelp
#. Speaker = Mari
#. NodeID = e3869c7e-2362-2435-3b90-a3ea97dd6048
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditLockpickerCallHelp:e3869c7e-2362-2435-3b90-a3ea97dd6048
msgctxt "hfcfb1549g8089g4e18ga01dg9d893ccb69f4"
msgid "Ey! Someone's in here!"
msgstr "이봐! 누군가 들어왔어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditLockpickerFoundDeadBandit
#. Speaker = Mari
#. NodeID = 64bb55e1-43bb-57e1-ae39-49db30cbca43
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditLockpickerFoundDeadBandit:64bb55e1-43bb-57e1-ae39-49db30cbca43
msgctxt "hd8edcc8ag990bg40edg8be7g80f3b7f8f7e5"
msgid "Barton? Oh gods, somebody killed Barton!"
msgstr "바톤? 맙소사, 어떤 놈이 바톤을 죽였어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditLockpickerLockpicking
#. Speaker = Mari
#. NodeID = 0ebf97e5-e8b0-9798-b2eb-eba2429bd414
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 305d2a0a-166d-c52e-dc57-c1cf434333d0_Step2 = False
#.      - 305d2a0a-166d-c52e-dc57-c1cf434333d0_Step1 = True
#. SetFlags:
#.   Local:
#.     - 305d2a0a-166d-c52e-dc57-c1cf434333d0_Step2 = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditLockpickerLockpicking:0ebf97e5-e8b0-9798-b2eb-eba2429bd414
msgctxt "h7ec5d584ge8f7g46c5g994ag8e3c17a6deb5"
msgid "Not even sure this <i>is</i> a door."
msgstr "이게 <i>문이기는</i> 한 건지 모르겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditLockpickerLockpicking
#. Speaker = Mari
#. NodeID = 29dfd0d1-7e0d-c9d3-21c8-243bf95f268f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 305d2a0a-166d-c52e-dc57-c1cf434333d0_Step2 = True
#.      - 305d2a0a-166d-c52e-dc57-c1cf434333d0_Step1 = True
#. SetFlags:
#.   Local:
#.     - 305d2a0a-166d-c52e-dc57-c1cf434333d0_Step2 = False
#.     - 305d2a0a-166d-c52e-dc57-c1cf434333d0_Step1 = False
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditLockpickerLockpicking:29dfd0d1-7e0d-c9d3-21c8-243bf95f268f
msgctxt "h9f734a07g9f50g4ea9g8235g3e691e3e9f49"
msgid "Gods, I need a drink."
msgstr "망할, 술 땡기네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditLockpickerLockpicking
#. Speaker = Mari
#. NodeID = 52479076-97df-8cc8-2dbe-cd090592af95
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 305d2a0a-166d-c52e-dc57-c1cf434333d0_Step1 = False
#. SetFlags:
#.   Local:
#.     - 305d2a0a-166d-c52e-dc57-c1cf434333d0_Step1 = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditLockpickerLockpicking:52479076-97df-8cc8-2dbe-cd090592af95
msgctxt "h975b7308ga18eg431cga9bagb53fc2b3ab80"
msgid "Where's the bloody lock?"
msgstr "염병할 자물쇠는 어디 있는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditLockpickerOpenDoor
#. Speaker = Mari
#. NodeID = beac63b8-0753-d573-79ef-5d3e2713f7d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditLockpickerOpenDoor:beac63b8-0753-d573-79ef-5d3e2713f7d8
msgctxt "h7a461806gd4e2g47ffga530gbdb76b170e18"
msgid "It's... open? Could've <i>sworn</i> I hadn't cracked it."
msgstr "문이... 열렸잖아? <i>분명</i> 나는 안 땄는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditLockpickerSpotting
#. Speaker = Mari
#. NodeID = 7714de28-7ec5-1afb-a812-f30187c67c86
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditLockpickerSpotting:7714de28-7ec5-1afb-a812-f30187c67c86
msgctxt "hb3cfa6c9gc359g4374gb3cbg348ee03a62bf"
msgid "How'd you get past Andorn? Back off!"
msgstr "안도른은 어떻게 뚫고 온 거야? 오지 마!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditLockpickerSurprised
#. Speaker = Mari
#. NodeID = 57fff0bb-6a22-f387-0454-dc7a99c0d198
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditLockpickerSurprised:57fff0bb-6a22-f387-0454-dc7a99c0d198
msgctxt "h14ebe6f2g667cg406agac2dg4ef0450dab1d"
msgid "Hells! Something's coming out of the crypt!"
msgstr "망할! 묘실에서 뭔가가 나오고 있어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditLockpickerUnlocked
#. Speaker = Mari
#. NodeID = d6428158-31f5-06fe-5fab-6d49b915bfa2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditLockpickerUnlocked:d6428158-31f5-06fe-5fab-6d49b915bfa2
msgctxt "h5ad4824fg29a6g45a5g96eag40b24ec1ce88"
msgid "Someone's here!"
msgstr "여기 웬 놈이 있어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Crypt_AD_BanditLockpickerWander
#. Speaker = Mari
#. NodeID = 49aaaf3e-a051-3a47-3e9e-69d463564fd1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
