#.      - UND_FurnaceSearch_Event_SucceedMadRecords = False
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_FurnaceSearch_PAD_MadRecords:19e2aa7d-9d14-8305-5068-de78dfc6386a
msgctxt "hf656f3f9g514dg4e7eg8e9bg03813f8af2b2"
msgid ""
"The reference to a 'hot hammer' is rather puzzling though. Whoever wrote "
"these papers must have been rather delirious."
msgstr "하지만 '뜨거운 망치'에 대한 언급은 꽤 의아하네. 이걸 쓴 사람이 누구였는진 모르겠지만, 정신이 나간 사람 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_FurnaceSearch_PAD_MadRecords
#. Speaker = Player
#. NodeID = 19e2aa7d-9d14-8305-5068-de78dfc6386a
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_FurnaceSearch_Event_SucceedMadRecords = False
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_FurnaceSearch_PAD_MadRecords:19e2aa7d-9d14-8305-5068-de78dfc6386a
msgctxt "h805dcb80g76c5g4c6fgb13bg90222a78da3d"
msgid "Pity I can't make heads nor tails of the rest of it."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_FurnaceSearch_PAD_MadRecords
#. Speaker = Player
#. NodeID = 19e2aa7d-9d14-8305-5068-de78dfc6386a
