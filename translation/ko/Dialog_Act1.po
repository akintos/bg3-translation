msgctxt "h80d749b2g5a00g45c8gaa62g4534c7a2c804"
msgid "*Hiss!*"
msgstr "*쉬익!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Otan
#. NodeID = 3ed29357-b37b-78fa-e2b8-e8ee48d89185
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:3ed29357-b37b-78fa-e2b8-e8ee48d89185
msgctxt "h46fb55a5gf252g4e8bg9161gbfaca82b3469"
msgid "We are <i>careful.</i>"
msgstr "우린 <i>신중해.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Jox
#. NodeID = 43b8c0eb-8738-3cb4-ef7b-fe037ddc086c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:43b8c0eb-8738-3cb4-ef7b-fe037ddc086c
msgctxt "h0cf9cb2cg75d2g4b95ga5cdgb11dc8c5367c"
msgid "*Hiss!*"
msgstr "*쉬익!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Jox
#. NodeID = 4573ad9e-1bc7-c818-f4da-ad9586ad88cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:4573ad9e-1bc7-c818-f4da-ad9586ad88cf
msgctxt "h4c23c232gc652g4e90g86d3g883864d07c0a"
msgid "We need no 'Order' - Father Murmath is the way!"
msgstr "우리는 '질서'가 필요 없어. 아버지 무르마스가 길이야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Xanta
#. NodeID = 45b83c5b-3b9d-e305-5268-61f1edc742e9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:45b83c5b-3b9d-e305-5268-61f1edc742e9
msgctxt "h2a05404bg145cg4a75g9014gdc4fff6e533c"
msgid ""
"All three! Follow me, brothers - we will find our due among the Spider "
"Queen's dedicants. We deserve as much!"
msgstr ""
"모두 함께! 나를 따르라, 형제들이여! 우리는 거미 여왕의 헌신자들에게 우리의 몫을 찾을 것이다. 우리는 그만큼의 대가를 받을 자격이 "
"있다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Xanta
#. NodeID = 469035df-961c-146f-0c9e-fe79fccee04f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:469035df-961c-146f-0c9e-fe79fccee04f
msgctxt "h1cf0ed10gf646g417fga90agccff60b59d27"
msgid "This and so much more. In Lolth's hairy embrace, all is possible."
msgstr "이뿐만 아니야. 롤쓰님의 수북한 품속에서는 모든 것이 가능해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Player
#. NodeID = 47a79928-24ee-a523-94c5-ebbaa3ab03d6
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:47a79928-24ee-a523-94c5-ebbaa3ab03d6
msgctxt "h0f611d2cg8789g41e4g9842g3907a8633541"
msgid ""
"I think your sister is right - among the Spider Queen's worshippers, you'll "
"reach your true potential."
msgstr "네 누이 말이 맞아. 거미 여왕의 숭배자들 사이에서 네 진정한 잠재력을 이룰 수 있을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Xanta
#. NodeID = 491172ec-dab7-1c6f-729f-66c58dfe86c2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_DuergarCamp_SpiderEvangelical_DialogEnded = True
#.     - GLO_UND_SpiderFight_SpidersLeave = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:491172ec-dab7-1c6f-729f-66c58dfe86c2
msgctxt "hfbea6de8g1515g4250g8717gbe0e80341469"
msgid "HAHA! Yes! Now, brothers - our new dawn awaits!"
msgstr "하하! 그래! 이제, 형제들이여 - 우리의 새로운 여명이 기다리고 있다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Jox
#. NodeID = 49ea6b8e-5175-f495-6b01-512907126d4b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:49ea6b8e-5175-f495-6b01-512907126d4b
msgctxt "he3a7df3fgeaf9g456cg8a3dg5b17b54f834c"
msgid "Traitorous!"
msgstr "반역자!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Jox
#. NodeID = 4b16cdc3-b6b0-748e-2704-58038fe35508
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:4b16cdc3-b6b0-748e-2704-58038fe35508
msgctxt "h59025ca0g6394g457dgb0b5g827476176d7a"
msgid "Our due!"
msgstr "우리의 몫!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Fu
#. NodeID = 4b7293f7-3c65-4c2e-cd70-371cac80b980
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:4b7293f7-3c65-4c2e-cd70-371cac80b980
msgctxt "h69debc19gb66cg40abg878bgd249527206b5"
msgid "Indignity..."
msgstr "모욕감..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Xanta
#. NodeID = 4ff0b2f2-fea5-9bdc-1fe5-84eeb714b16d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:4ff0b2f2-fea5-9bdc-1fe5-84eeb714b16d
msgctxt "h07c345d0g3ed2g4722g80cfgd809654cf418"
msgid ""
"What care we for his business here? He keeps us small. Keeps us contained. "
"We should be with the Spider Queen - revered, adored!"
msgstr ""
"그가 여기서 뭘 하든 무슨 상관이야? 그는 우릴 일부러 작게 유지한다고. 항상 가둬 두지. 우린 거미 여왕님과 함께해야 해, 존경받고, "
"사랑받아야 한다고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Player
#. NodeID = 551b2824-e88e-50b4-22b4-84ee643bea2a
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BERSERKER(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:551b2824-e88e-50b4-22b4-84ee643bea2a
msgctxt "h7f34fb5eg3e29g4e52ga311gde3e164d3685"
msgid "FILTHY BUGS! <b>LEAVE</b>!"
msgstr "더러운 벌레들! <b>떠나라</b>!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Jox
#. NodeID = 5945e341-ab50-6792-fd95-128ff9980211
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:5945e341-ab50-6792-fd95-128ff9980211
msgctxt "ha0980de8g4924g4270ga8eag85c66dff3191"
msgid "We owe Father Murmath all we are - and we will never betray him!"
msgstr "우리는 아버지 무르마스에게 우리가 존재하는 모든 것을 빚지고 있다 - 그리고 우리는 그를 절대로 배신하지 않을 것이다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Jox
#. NodeID = 5a00cb10-4036-f538-d1be-5c922b89d852
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:5a00cb10-4036-f538-d1be-5c922b89d852
msgctxt "hf9e97777gfe76g45begb985g190c160e6fa0"
msgid "Disrespect..."
msgstr "무례..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Jox
#. NodeID = 5a9addbb-f42c-e4e4-41f1-6fa473ecc128
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:5a9addbb-f42c-e4e4-41f1-6fa473ecc128
msgctxt "hbb940a0bgc42bg403cgb540g42490c7d3107"
msgid ""
"Fie! Xanta - even the Spider Queen's faithful wants no part in your game!"
msgstr "꺼져! 잔타! 심지어 거미 여왕의 신봉자도 네 계획에 아무런 관심이 없어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Jox
#. NodeID = 5b386fd6-f339-99d5-d1b9-2b54c4aae802
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:5b386fd6-f339-99d5-d1b9-2b54c4aae802
msgctxt "h91408ab9gd8d3g4fc1gbfc1g4626dd426af8"
msgid ""
"We need no 'Lolth' - no spider queen! Father Murmath is the head of clan "
"Lur. He hatched us, raised us, feeds us!"
msgstr ""
"우리에게 필요한 건 '롤쓰'니 거미 여왕이니, 그런 게 아니야! 파더 무르마스가 루르 일족의 대장이잖아. 그가 우리를 부화시키고, "
"키워주고, 먹여줬다고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Otan
#. NodeID = 5b9e92ca-7808-fb10-edc8-6a6edf53f47e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:5b9e92ca-7808-fb10-edc8-6a6edf53f47e
msgctxt "h583c4f09g28bag4e37gb942gce1810570ba1"
msgid "Exalted?"
msgstr "고귀한?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Player
#. NodeID = 5cb3564f-35aa-432f-4df0-4d2bd923458b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - cae235e1-7419-3a7f-8056-94fffefaa846_succeedreligion = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:5cb3564f-35aa-432f-4df0-4d2bd923458b
msgctxt "h44725900g91a2g429bgbc06g49173fd33ece"
msgid ""
"You should know that spiders are revered among Lolth's faithful. Harming one "
"of your kind is a capital crime."
msgstr "넌 거미들이 롤쓰의 신봉자들 사이에서 존경받는다는 것을 알아야 해. 너희 종족 중 하나를 해치는 것은 중대한 범죄라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Player
#. NodeID = 5ebd87ca-16e5-0dc3-c2cc-772f0d97faf9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:5ebd87ca-16e5-0dc3-c2cc-772f0d97faf9
msgctxt "hadafb9ebg5690g4156gbb82g9925efd74fae"
msgid "I'd rather not get involved in your little coup."
msgstr "난 당신의 작은 쿠데타에 끼어들고 싶지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Otan
#. NodeID = 67236cab-8f60-6d10-8fec-33510b93be82
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:67236cab-8f60-6d10-8fec-33510b93be82
msgctxt "h85641efbg94fbg4801gbb9cg54c272bcb2c2"
msgid "Her dedicants!"
msgstr "그녀의 헌신자들!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Otan
#. NodeID = 6820bb53-acc8-ee07-dded-e7d9f8c89405
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:6820bb53-acc8-ee07-dded-e7d9f8c89405
msgctxt "he9feeb7agb565g4ce2g8cabg9593129d65f2"
msgid "We follow."
msgstr "우리는 따른다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Player
#. NodeID = 6c263498-6385-68cc-e810-65fda3d541bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:6c263498-6385-68cc-e810-65fda3d541bf
msgctxt "hde81eeefg2468g4aa7g8e12g18a5b0385977"
msgid "<i>See how this mutiny plays out.</i>"
msgstr "<i>이 반역이 어떻게 흘러가는지 지켜본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Xanta
#. NodeID = 6c84631e-c0ef-47e5-a279-a170dac6c70b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:6c84631e-c0ef-47e5-a279-a170dac6c70b
msgctxt "hf780f32cg1fb2g42a2gb728gb2468304e20e"
msgid ""
"But it goes beyond logic. Do not you feel it, brothers? The pull for "
"something <i>more? </i>Do you not see it, friend visitor? Their unfulfilled "
"potential?"
msgstr ""
"하지만 그건 논리 너머에 있어. 형제들이여, 너희도 느껴지지 않아? <i>더</i> 많은 것을 향한 끌림 말이야. 방문자 친구, 너도 "
"보이지 않아? 그들의 발현되지 않은 잠재력이?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Fu
#. NodeID = 6ca508b9-f9fc-d302-518b-df1e7d60464c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:6ca508b9-f9fc-d302-518b-df1e7d60464c
msgctxt "h28807cb3g5a13g4acag86adgbd1698a9d510"
msgid "Room among their ranks..."
msgstr "그들과 함께..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Xanta
#. NodeID = 6d87011b-fe43-32c7-c61a-b6318906738a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:6d87011b-fe43-32c7-c61a-b6318906738a
msgctxt "ha9139f59ga16bg48f7gad3dg14d9a629016a"
msgid "But - but the Spider Queen! Lolth! Our due!"
msgstr "하지만 - 하지만 거미 여왕! 롤쓰! 우리의 몫!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Player
#. NodeID = 7567bc9c-c102-4b9c-831d-b8df52b7bb73
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:7567bc9c-c102-4b9c-831d-b8df52b7bb73
msgctxt "h0e2b7d8fg0559g408dg910egefb96db6e2f2"
msgid "<i>Attack the nearest spider.</i>"
msgstr "<i>가장 가까이에 있는 거미를 공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Narrator
#. NodeID = 759e52fc-3557-8b89-98a0-5c5d8a4064e4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:759e52fc-3557-8b89-98a0-5c5d8a4064e4
msgctxt "ha58af380g07a6g4654g925bg678ccb033cf8"
msgid ""
"*You don't sense much unfulfilled potential, but one thing is certain: this "
"crew won't hesitate to sink their fangs into your belly if their duergar "
"master gives the word.*"
msgstr ""
"*당신은 그들에게서 잠재력을 많이 느끼지 못하지만, 한 가지는 확실합니다: 이 일행은 그들의 듀에르가 주인이 명령하면 당신의 배에 "
"송곳니를 박는 것을 주저하지 않을 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Player
#. NodeID = 7716dd82-0895-40a0-8439-8ae4020e39e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:7716dd82-0895-40a0-8439-8ae4020e39e6
msgctxt "h5fa1e8acgd19dg4e2dg9fbdg98589856a522"
msgid "Kssrt!"
msgstr "키르륵!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Player
#. NodeID = 7e135f4e-6f1f-1775-70e9-e0df926665fa
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - BERSERKER(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:7e135f4e-6f1f-1775-70e9-e0df926665fa
msgctxt "h678c6c5fg6923g44f3gbc85gc26b2cccec82"
msgid "THE PRIEST IS <b>WEAK</b>. BECOME <b>STRONG.</b>"
msgstr "그 성직자는 <b>약하다</b>. <b>강해져라.</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Otan
#. NodeID = 8093b7e8-4257-d771-a998-555f417cc84d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:8093b7e8-4257-d771-a998-555f417cc84d
msgctxt "hf913bd24g7908g49e0g871cgd86abbb18ab2"
msgid "Xanta... is it so?"
msgstr "잔타... 이게 사실이야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Player
#. NodeID = 84ace6db-3821-2ff7-fa91-992079bf71c1
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 5
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:84ace6db-3821-2ff7-fa91-992079bf71c1
msgctxt "ha896841dgcc6dg4fdbg8c61gcd1a5d873277"
msgid ""
"I suppose the Order of the Soul Spiders would have room for you among their "
"ranks."
msgstr "나는 영혼의 거미단이 너희를 받아들일 거라고 생각해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Player
#. NodeID = 857ff9d2-e8db-9ab7-7beb-b08cb5167f55
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 7
#. CheckFlags:
#.   Tag:
#.      - PALADIN(4) = True
#. TagRule: PALADIN_ANCIENTS
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:857ff9d2-e8db-9ab7-7beb-b08cb5167f55
msgctxt "h99ee914bg384fg4954gbfaeg094f6dbf1667"
msgid ""
"Being bound to serve Murmath spits in the face of natural order. It limits "
"you."
msgstr "무르마스를 섬기도록 구속되는 것은 자연의 질서에 정면으로 침을 뱉는 일이야. 그게 네 잠재력을 제한하고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Player
#. NodeID = 857ff9d2-e8db-9ab7-7beb-b08cb5167f55
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 7
#. CheckFlags:
#.   Tag:
#.      - PALADIN(4) = True
#. TagRule: PALADIN_VENGEANCE and NOT_FOR_EA
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:857ff9d2-e8db-9ab7-7beb-b08cb5167f55
msgctxt "ha1d90bbfgaa24g4782gbc5ega7a5ba435107"
msgid "Why be bound to Murmath when you could be Lolth's avenging Justiciars?"
msgstr "왜 무르마스에게 구속되어 있어? 롤쓰에게 복수하는 정의의 수호자가 될 수 있는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Player
#. NodeID = 857ff9d2-e8db-9ab7-7beb-b08cb5167f55
#. HandlePath = TaggedText[2].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 7
#. CheckFlags:
#.   Tag:
#.      - PALADIN(4) = True
#. TagRule: PALADIN_DEVOTION
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:857ff9d2-e8db-9ab7-7beb-b08cb5167f55
msgctxt "h854e4ccbg966eg46ddg8d4ag61f6d04c537c"
msgid ""
"Your duty is to each other, not Murmath. Embrace that, and power unlimited "
"will be yours."
msgstr "너희의 의무는 무르마스가 아니라 서로에게 있어. 그걸 받아들이면, 무한한 힘이 너희의 것이 될 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Player
#. NodeID = 857ff9d2-e8db-9ab7-7beb-b08cb5167f55
#. HandlePath = TaggedText[3].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 7
#. CheckFlags:
#.   Tag:
#.      - PALADIN(4) = True
#. TagRule: OATHBREAKER
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:857ff9d2-e8db-9ab7-7beb-b08cb5167f55
msgctxt "h7524cabdgd715g45beg9919ge51af1d3d258"
msgid ""
"You owe nothing to Murmath. Break your bonds, free yourselves. Become "
"<i>unstoppable</i>."
msgstr "너는 무르마스에게 아무런 빚도 없어. 유대를 끊고, 스스로를 해방해. <i>막을 수 없는</i> 존재가 되는 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Player
#. NodeID = 8804ec2b-0952-4ac2-ba39-bf3c7debe03e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:8804ec2b-0952-4ac2-ba39-bf3c7debe03e
msgctxt "hdd276184g50cag4739gaebag783d91536355"
msgid "Turning on your head-of-clan, are you? I'm sure that'll end well."
msgstr "너희 일족의 대장을 배신하겠다는 거야? 당연히 끝이 좋겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Narrator
#. NodeID = 89744daa-1671-a35b-0b16-69f53a8b4996
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:89744daa-1671-a35b-0b16-69f53a8b4996
msgctxt "hbba0572bgc54bg419ag8efega134c5ed1a17"
msgid "*Nothing in particular comes to mind.*"
msgstr "*특별히 떠오르는 것이 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Xanta
#. NodeID = 8b65005b-7473-cb76-d271-a25cc02fae3d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:8b65005b-7473-cb76-d271-a25cc02fae3d
msgctxt "h6d7dfafcg8dd3g4b7fga7e7g5c1c6cce5c4c"
msgid ""
"He... he might've! He doesn't know our true potential - our true splendour! "
"Only Lolth knows that."
msgstr "그는... 그럴 수도 있어! 그는 우리의 진정한 잠재력과 진정한 위엄을 몰라! 오직 롤쓰님께서만 그것을 알고 있다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Player
#. NodeID = 8d3f4009-5368-de86-e65e-16e3202ca6ff
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - BERSERKER(4) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:8d3f4009-5368-de86-e65e-16e3202ca6ff
msgctxt "hc85d57f9g7c36g4ab3g822dg673ae6caadb5"
msgid ""
"The Spider Queen doesn't suffer hesitation. I fear for anyone who resists "
"her call."
msgstr "거미 여왕은 주저하며 고민하지 않아. 그녀의 부름에 저항하는 이가 있을까 봐 두려울 뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Fu
#. NodeID = 8dcd5748-8a41-99e0-c434-771098de22df
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:8dcd5748-8a41-99e0-c434-771098de22df
msgctxt "h93beb09ag390ag4b3cga0a6g2e3e61b658ff"
msgid "Nay!"
msgstr "아니!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Player
#. NodeID = 9325a07c-d89a-48a2-8ad8-1e79f96b34a8
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:9325a07c-d89a-48a2-8ad8-1e79f96b34a8
msgctxt "h4a378c51g3bc5g4aecga022gead043c0f562"
msgid "<i>Try to discern the nature of their chatter.</i>"
msgstr "<i>그들 수다의 본질을 알아채기 위해 시도한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Otan
#. NodeID = 93526814-7fb0-fbeb-5a53-e9948a01c314
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:93526814-7fb0-fbeb-5a53-e9948a01c314
msgctxt "he1e6c5c7g0505g4065gbe96gc7a0d2a37ad1"
msgid "Fie!"
msgstr "쳇!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Jox
#. NodeID = 94ffc776-9e3f-1512-aa14-d07ec3caae56
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:94ffc776-9e3f-1512-aa14-d07ec3caae56
msgctxt "hf4266ae8geabdg4ec8gb623gd86c8ad31014"
msgid "We will not betray Father Murmath. We will never leave him!"
msgstr "우린 파더 무르마스를 배신하지 않을 거야. 그를 절대 떠나지 않을 거라고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Xanta
#. NodeID = 95c43d41-c50f-164d-4b1f-2ec02db7c824
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:95c43d41-c50f-164d-4b1f-2ec02db7c824
msgctxt "hd9afedacg8ae3g4490g875eg07c4406f445a"
msgid "You! Please - explain to my brothers - we must be among our own kind!"
msgstr "당신! 제발 - 내 형제들에게 설명해 줘 - 우리는 동족과 함께 있어야 해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Otan
#. NodeID = 97baec7e-e2ec-e1b4-5909-a2df371ee2cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:97baec7e-e2ec-e1b4-5909-a2df371ee2cb
msgctxt "hbe4e3936g25a8g4526g8e9ag5f5b751f0844"
msgid "Never!"
msgstr "절대!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Jox
#. NodeID = 9a9ee7e6-a650-2b5c-16a9-27459be2e543
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:9a9ee7e6-a650-2b5c-16a9-27459be2e543
msgctxt "ha59352c9g74b3g400egbf60g550e13681662"
msgid "No!"
msgstr "안 돼!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Player
#. NodeID = 9de04cf6-224c-c227-b1b4-b6b11e6cea05
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:9de04cf6-224c-c227-b1b4-b6b11e6cea05
msgctxt "h0fa31bdbge852g45a4g9db2gf161d968ddf6"
msgid ""
"Among the Spider Queen's followers, you'd be revered as her physical "
"manifestation. Honoured. <i>Exalted.</i>"
msgstr "거미 여왕의 추종자들 사이에서 너는 그녀의 화신으로 존경받을 거야. 명예롭게. <i>고귀하게.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Narrator
#. NodeID = a204dc24-f015-42c3-9a86-831210490312
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - cae235e1-7419-3a7f-8056-94fffefaa846_AnimalHandlingSuccess = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:a204dc24-f015-42c3-9a86-831210490312
msgctxt "h7d3eaab3g574fg4a32ga455g63fe4be6bb67"
msgid ""
"*They appear to be in conflict - the larger spider versus the other three.*"
msgstr "*그들은 마치 갈등 중인 것처럼 보입니다 - 큰 거미가 다른 세 마리 거미와 대립하는 것 같습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Xanta
#. NodeID = a3253364-90c2-e5ff-108a-4bad991da3ca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:a3253364-90c2-e5ff-108a-4bad991da3ca
msgctxt "h4db2fb54gb0b5g44b3g967bgf254e42ee9bd"
msgid ""
"Fools! Don't you see - the time of Murmath has passed! The Spider Queen "
"awaits us!"
msgstr "바보들! 눈치 못 챘어? 무르마트의 시대는 지났어! 거미 여왕이 우리를 기다리고 있어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Xanta
#. NodeID = a61b45f8-c906-26a0-58cf-a72e1c31b0b7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:a61b45f8-c906-26a0-58cf-a72e1c31b0b7
msgctxt "h4af940fdgc440g41a0gbe2fg07396de8d37d"
msgid ""
"You see? Father Murmath's time has passed. Come, brothers - follow me into "
"Lolth's hairy embrace!"
msgstr "봤지? 파더 무르마스의 시간은 끝났어. 가자, 형제들이여, 롤쓰님의 수북한 품속으로 향하자!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Otan
#. NodeID = aafd9d5d-0e85-5ff7-16fc-59086b5df279
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:aafd9d5d-0e85-5ff7-16fc-59086b5df279
msgctxt "h64b6408cg8029g4fe9ga101g255cc0631905"
msgid "Xanta... is it so?"
msgstr "잔타... 이게 사실이야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Player
#. NodeID = b2734a01-c71e-4dc0-a96c-2439a7d3189e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:b2734a01-c71e-4dc0-a96c-2439a7d3189e
msgctxt "hd0be418cg0e15g4b86gb92aged490d3ecdde"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Player
#. NodeID = b33a9917-a5b8-2513-46ee-8ecc9018aa41
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 10
#. TagRule: !(CLERIC_LOLTH and LOLTHDROWELF and PALADIN_LOLTH)
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:b33a9917-a5b8-2513-46ee-8ecc9018aa41
msgctxt "hb6cc8201g0e77g459eg91dbg2abb042f0c69"
msgid "<i>Recall your learnings about the Spider Queen, Lolth.</i>"
msgstr "<i>거미 여왕, 롤쓰에 대한 기억을 떠올린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Player
#. NodeID = b98bb20f-8d66-4d35-9b11-c6940ff009de
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:b98bb20f-8d66-4d35-9b11-c6940ff009de
msgctxt "h33434a5dg3bc2g40f3ga406gedf374da8a3d"
msgid "<i>Stand back and see how things play out.</i>"
msgstr "<i>물러서서 상황을 지켜본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Fu
#. NodeID = ba8a625f-bc4e-03b0-a555-be786cf6f3e2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_DuergarCamp_SpiderEvangelical_DialogEnded = True
#.     - GLO_UND_SpiderFight_Aggro = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:ba8a625f-bc4e-03b0-a555-be786cf6f3e2
msgctxt "ha451f6ebg5bc0g4a49g8688g07bd435d7d6c"
msgid "*SKREEEE!*"
msgstr "*<b>키에에엑!</b>*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Xanta
#. NodeID = bb60f075-9c01-45c6-8c20-546df8971901
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:bb60f075-9c01-45c6-8c20-546df8971901
msgctxt "he23f6829gb43cg48d9g8959gb3251358d82a"
msgid ""
"We do not turn on Father Murmath. But we <i>do </i>outgrow him. The fate of "
"clan Lur lies with the Spider Queen!"
msgstr ""
"우리는 아버지 무르마트에게 등을 돌리지 않는다. 하지만 우리는 그를 <i>능가</i>한다. 루르 부족의 운명은 거미 여왕에게 달려 있다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Jox
#. NodeID = be5930b1-3512-d000-1335-4078a8480492
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_SpiderEvangelical_PersuadedReligious = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:be5930b1-3512-d000-1335-4078a8480492
msgctxt "h380d46fcg3a2eg479dga1b5g8c2d8ac6975c"
msgid "We... do not hesitate."
msgstr "우리는... 주저 하지 않는다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Xanta
#. NodeID = c191a6c5-d707-4a81-8932-66347201e477
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(4) = True
#. SetFlags:
#.   Global:
#.     - UND_DuergarCamp_SpiderEvangelical_DialogStarted = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:c191a6c5-d707-4a81-8932-66347201e477
msgctxt "h6c42e81eg9518g4127gaf98gab0630acc92d"
msgid ""
"I speak true, brothers! You know it in your hearts! You know it in your very "
"souls!"
msgstr "형제들이여, 내 말을 믿어! 다들 가슴 속에 있는 거 알잖아! 영혼으로 느끼고 있지 않아?!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Fu
#. NodeID = c3151171-91f2-67d2-da9b-5baed5a42d2a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:c3151171-91f2-67d2-da9b-5baed5a42d2a
msgctxt "hb56d35c2g4836g462dgaf30gd00b13eabc41"
msgid "He couldn't!"
msgstr "그가 그럴리가!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Jox
#. NodeID = c3391273-ca2e-37a8-fa28-34b1ab1ea447
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_SpiderEvangelical_PersuadedReligious = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:c3391273-ca2e-37a8-fa28-34b1ab1ea447
msgctxt "hc2c5c11ag979ag4088gb478g33c47c341371"
msgid "Order of the Soul Spiders..."
msgstr "영혼의 거미단..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Fu
#. NodeID = c3893d34-d647-e25e-435a-36f63c254180
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:c3893d34-d647-e25e-435a-36f63c254180
msgctxt "h5dc8859ag0520g4235g8fdag9c242d186c88"
msgid "Honoured?"
msgstr "명예로운?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Player
#. NodeID = c3eaa383-dcb2-f5e9-4dae-0a76e87a61eb
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(4) = True
#.      - BERSERKER(4) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:c3eaa383-dcb2-f5e9-4dae-0a76e87a61eb
msgctxt "hc6cd8b53gfa7ag4da0g920fgcc9394d12ec2"
msgid "I don't care where you go, but it's time for all of you to leave."
msgstr "너희가 어딜 가는지는 상관없지만, 모두 떠날 때가 됐어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Player
#. NodeID = c56622b4-16bd-4c12-9aa5-9066515913e5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:c56622b4-16bd-4c12-9aa5-9066515913e5
msgctxt "h50902e00g68a5g4efagb445gc95b775d18f5"
msgid "Spiders for the Spider Queen. Seems logical."
msgstr "거미 여왕을 위한 거미라. 논리적인 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Otan
#. NodeID = c97a1c6e-aeed-785e-fcbf-9ab08a2b09ef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:c97a1c6e-aeed-785e-fcbf-9ab08a2b09ef
msgctxt "h7014133bgbd17g4729gba3eg1c5597351a3c"
msgid "He didn't!"
msgstr "그가 그랬을리가!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Xanta
#. NodeID = cdb6ac7a-5071-6fff-f673-830b682c7fe4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:cdb6ac7a-5071-6fff-f673-830b682c7fe4
msgctxt "h09ada175g403dg43f9gacd3g0f63b65402a9"
msgid ""
"I've heard the very same! Come, brothers - follow me into her hairy embrace!"
msgstr "나도 그 말을 들었어! 형제들, 그녀의 수북한 품속으로 나를 따라와!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Fu
#. NodeID = ce16542e-6eb8-1a25-cf9e-7cc82e91dd76
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:ce16542e-6eb8-1a25-cf9e-7cc82e91dd76
msgctxt "h06ed96d5gfc13g42c6g837ag635a6620f03b"
msgid "We deserve!"
msgstr "우리는 자격이 있어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Jox
#. NodeID = d2cac31b-b5b0-7934-e5c0-9e6879de8806
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:d2cac31b-b5b0-7934-e5c0-9e6879de8806
msgctxt "h4acd1b4bg9fbcg4adeg92fcg5d42f860b64c"
msgid "Bah! Father Murmath protects us!"
msgstr "쳇! 아버지 무르마스가 우릴 보호해 주실 거야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Jox
#. NodeID = d48cec83-2c04-3afc-bf3d-2a42ee1c3c33
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:d48cec83-2c04-3afc-bf3d-2a42ee1c3c33
msgctxt "h8bb88e64gb930g4634g81a4ga3beb9000ba5"
msgid "*Rssskt!*"
msgstr "*르스-크트!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Otan
#. NodeID = d5065bd2-2a99-0be8-3f8e-539d2dc6c556
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:d5065bd2-2a99-0be8-3f8e-539d2dc6c556
msgctxt "h44209ac4g81e9g4737g8498gab1e337fd5f7"
msgid "Xanta... is it so?"
msgstr "잔타... 이게 사실이야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Player
#. NodeID = d67d5bf2-a36e-9b8d-a4b6-b1b9c9bf85b2
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_LOLTH or LOLTHDROWELF or PALADIN_LOLTH
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:d67d5bf2-a36e-9b8d-a4b6-b1b9c9bf85b2
msgctxt "h97a4f3f3g0e2dg4010gb2afga4e38b251351"
msgid ""
"Your sister speaks true. The Spider Queen would welcome you with great "
"enthusiasm."
msgstr "네 누이가 옳은 말을 했어. 거미 여왕은 너를 큰 열정으로 환영할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Narrator
#. NodeID = d75de1e4-3920-1bc5-bb15-0594d458a614
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - cae235e1-7419-3a7f-8056-94fffefaa846_succeedreligion = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:d75de1e4-3920-1bc5-bb15-0594d458a614
msgctxt "h880bd2c9g142dg46ccg81c7g33b7519c8083"
msgid ""
"*You've read that harming spiders is illegal among Lolth's faithful - and "
"often punishable by death.*"
msgstr ""
"*당신은 롤쓰 신도에게 거미를 해하는 행동은 불법이라는 사실을 읽은 기억을 떠올립니다. 심지어 사형에 처해질 수도 있는 범죄입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Xanta
#. NodeID = d8476263-dd94-4f90-a586-211892404f5d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(4) = False
#. SetFlags:
#.   Global:
#.     - UND_DuergarCamp_SpiderEvangelical_DialogStarted = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:d8476263-dd94-4f90-a586-211892404f5d
msgctxt "h3fb2a30fg4651g41d8ga7bcg0c6330486b41"
msgid "*Ksssrt!*"
msgstr "*크스-르트!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Fu
#. NodeID = d91f45b7-48a1-e8bc-10ea-0af22c81674c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:d91f45b7-48a1-e8bc-10ea-0af22c81674c
msgctxt "hb9a323e8gb7dcg4f8dgacf4gf420508bde90"
msgid "We're ready."
msgstr "우린 준비됐어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Xanta
#. NodeID = db8f9422-1583-7f1f-f72c-317c21b6a6e3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:db8f9422-1583-7f1f-f72c-317c21b6a6e3
msgctxt "hcb12c2b7ga8e4g451cgbe29g43b53957cfbc"
msgid ""
"You see?! Such disrespect! Such disdain! And does Father Murmath raise a "
"whisper in our defence? With the Spider Queen's protection, we would never "
"suffer such indignity again!"
msgstr ""
"봤지?! 이런 무례함! 이런 경멸! 아버지 무르마트는 우리를 변호하기 위해 한마디라도 했나? 거미 여왕님의 보호 아래서라면, 우리는 "
"다시는 이런 모욕을 겪지 않을 거야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Jox
#. NodeID = dbb120df-a379-858d-7f4f-e98adb1be3c0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_SpiderEvangelical_PersuadedReligious = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:dbb120df-a379-858d-7f4f-e98adb1be3c0
msgctxt "haab7bddag9f4fg454dgbdb2ge355457b9110"
msgid "My bite could be stronger?"
msgstr "내 이빨이 더 강해질 수 있을까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Fu
#. NodeID = dbbba898-cc22-cfe0-8630-685cdd34ef9d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:dbbba898-cc22-cfe0-8630-685cdd34ef9d
msgctxt "h676e37a7g9b35g4c4bg97adgde82ec3851ef"
msgid "We... <i>plan.</i>"
msgstr "우리... <i>계획</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Narrator
#. NodeID = de21f7b3-f911-4c6a-ba98-9115983bc050
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:de21f7b3-f911-4c6a-ba98-9115983bc050
msgctxt "hd5530c3dgbb57g4ccdg92e7g76cd00fa7ec3"
msgid "*The spiders regard you without comprehension.*"
msgstr "*거미들은 당신을 이해하지 못하고 바라봅니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Jox
#. NodeID = df2ccdbc-42fa-0a32-057f-75cf223d6fee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:df2ccdbc-42fa-0a32-057f-75cf223d6fee
msgctxt "hae99d0bbg637bg4cddgb008ge3c707521cc0"
msgid "He wouldn't!"
msgstr "그가 그럴리 없어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Fu
#. NodeID = df72a69b-6698-6efd-a3fc-38c92d01b42e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:df72a69b-6698-6efd-a3fc-38c92d01b42e
msgctxt "h0832afcaga605g48a7g862cg18305d3d4767"
msgid "He shelters us!"
msgstr "그는 우리를 보호해 준다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Fu
#. NodeID = e7b8758b-0e28-fe7b-69b0-50e1f00a925c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_DuergarCamp_SpiderEvangelical_DialogEnded = True
#.     - GLO_UND_SpiderFight_Aggro = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay:e7b8758b-0e28-fe7b-69b0-50e1f00a925c
msgctxt "h55e848cdg270dg4f5cg99b2g15b8da3c2262"
msgid "Undeserving!"
msgstr "자격이 없다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_SpiderFight_FourWay
#. Speaker = Lur Xanta
#. NodeID = f376a217-498f-de94-8f4a-8f3b9524745a
#. HandlePath = TaggedText[0].TagText[0]
