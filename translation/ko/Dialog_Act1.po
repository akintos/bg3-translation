msgctxt "hc991739dgfef9g41aeg93fbg05b651f1c039"
msgid "Ugh. Pathetic."
msgstr "흥. 허접하군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Forest_VB_Trap
#. Speaker = Player
#. NodeID = c527aba4-6726-bb4d-0b6a-db0c0881de58
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Local:
#.      - a7407f82-add0-9f6d-e4e6-78b9c39195a6_C = True
#.      - a7407f82-add0-9f6d-e4e6-78b9c39195a6_B = True
#.      - a7407f82-add0-9f6d-e4e6-78b9c39195a6_A = True
#. SetFlags:
#.   Local:
#.     - a7407f82-add0-9f6d-e4e6-78b9c39195a6_C = False
#.     - a7407f82-add0-9f6d-e4e6-78b9c39195a6_B = False
#.     - a7407f82-add0-9f6d-e4e6-78b9c39195a6_A = False
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Forest_VB_Trap:c527aba4-6726-bb4d-0b6a-db0c0881de58
msgctxt "h0b663397g6aa5g47ccga7ffg7f0df08503aa"
msgid "Are they all like this?"
msgstr "함정 상태가 죄다 이렇나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Forest_VB_Trap
#. Speaker = Player
#. NodeID = da20959b-183b-f20a-98c0-e2eb014fe9e1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - a7407f82-add0-9f6d-e4e6-78b9c39195a6_C = False
#.      - a7407f82-add0-9f6d-e4e6-78b9c39195a6_B = False
#.      - a7407f82-add0-9f6d-e4e6-78b9c39195a6_A = True
