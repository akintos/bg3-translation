msgctxt "h91ce4fb1gcd82g4d94gbba7g619e5e44c4e5"
msgid ""
"That Queen Vlaakith trusted you with such a task... You must <i>not</i> "
"fail.."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_IntelligenceOfficer03
#. Speaker = Ardent Qu'th
#. NodeID = 33963106-cfe9-8510-de6d-8592efd7e745
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
