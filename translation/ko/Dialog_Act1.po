msgctxt "h29e4727cg346ag44e1gb0d4gaf09dfd231f2"
msgid "Play on! Play on and soothe my soul!"
msgstr "계속 해! 노래로 내 영혼을 달래 줘!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerCharmed
