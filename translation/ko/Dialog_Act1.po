#.      - UND_MerregonMask_Knows_Commander = True
#.      - UND_MerregonMask_Knows_CommanderAlive = False
#. SetFlags:
#.   Global:
#.     - UND_MerregonMask_State_FinishedAllComments = True
#.     - UND_MerregonMask_Knows_CommanderAlive = True
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_MerregonMask_PAD:35c67a5f-34d9-4de5-8117-6b6eb0044322
msgctxt "hca56158agc13ag4625g9bc0g5f73e6a7e262"
msgid ""
"Still only merregon remains, though. Whatever commanded them, I'm not sure "
"it's dead."
msgstr "여전히 메레곤의 흔적밖에 보이지 않네. 누가 놈들을 지휘했는지는 모르겠지만, 아직 죽은 건지는 확실하지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_MerregonMask_PAD
#. Speaker = Player
#. NodeID = 35c67a5f-34d9-4de5-8117-6b6eb0044322
