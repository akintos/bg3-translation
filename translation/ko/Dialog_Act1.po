msgctxt "hb1f24d6ag9093g4834g91d3g85289118a6cf"
msgid "I'll be there soon, my lady."
msgstr "곧 그리로 갈게요, 나의 여인이여."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerCharmed
