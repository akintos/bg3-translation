#.      - PLA_FlamingFists_Knows_ZhentDungeon(1) = False
#. SetFlags:
#.   User:
#.     - PLA_FlamingFists_Knows_ZhentDungeon(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8:cc47dda0-5cda-dcec-8086-5c81d63622da
msgctxt "h9b2bb2e3ge200g4aa1g9bf8g8ca76bff8f04"
msgid "There are Zhentarim lurking about. They have a hideaway nearby."
msgstr "근처에 젠타림이 있습니다. 근처에 놈들 은신처가 있어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8
#. Speaker = Player
#. NodeID = da7e0d9e-ffde-18d6-1cdf-3605bd3953de
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_Desire_Knows_RavengardTaken = False
#.   User:
#.      - PLA_FlamingFists_Knows_AskedWhatHappened(1) = False
#. SetFlags:
#.   User:
#.     - PLA_FlamingFists_Knows_AskedWhatHappened(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8:da7e0d9e-ffde-18d6-1cdf-3605bd3953de
msgctxt "hd9395f86ga772g42cega12ag2a6b6f649cfe"
msgid "This is a bloodbath. What happened here?"
msgstr "완전 피바다에요. 무슨 일이 있었죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8
#. Speaker = Player
#. NodeID = f76cf625-4d0c-5335-13aa-02854824a75f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8:f76cf625-4d0c-5335-13aa-02854824a75f
msgctxt "hd5d76123g23c4g48e8g8cfcg742be971afc3"
msgid "Did you know him?"
msgstr "아는 사람이었나요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8_AwayFromCorpse
#. Speaker = Fist Recruit Tristan
#. NodeID = 021dc6ab-ca90-bf9b-0c66-ba72aadc2a81
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_FlamingFist8_InnBurntDown_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - PLA_FlamingFist8_InnBurntDown_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8_AwayFromCorpse:021dc6ab-ca90-bf9b-0c66-ba72aadc2a81
msgctxt "hfd3de269ge2f5g41abga863gef0e7c6cb7fc"
msgid "We shouldn't stay too long. The goblins might come back."
msgstr "여기 너무 오래 있으면 안 돼. 고블린들이 돌아올지도 모르니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8_AwayFromCorpse
#. Speaker = Fist Recruit Tristan
#. NodeID = 058b6ede-5a13-cf24-7728-66eb8e4e8c59
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8_AwayFromCorpse:058b6ede-5a13-cf24-7728-66eb8e4e8c59
msgctxt "h6d05bb84g49c4g41c3g9418g2295cfecc968"
msgid "My advice - shut up."
msgstr "내 조언해 주지. 입 닥쳐요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8_AwayFromCorpse
#. Speaker = Fist Recruit Tristan
#. NodeID = 37f90759-74e0-faa8-0a96-73a0e4f1bea8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8_AwayFromCorpse:37f90759-74e0-faa8-0a96-73a0e4f1bea8
msgctxt "h004234f4g50a6g4970g90e0g360e09b0d40a"
msgid "Those who speak of the Zhent end up unable to speak."
msgstr "젠트에 대해 말하는 자들은 결국 말을 하지 못하게 되지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8_AwayFromCorpse
#. Speaker = Fist Recruit Tristan
#. NodeID = 7ad35bda-8ff3-1d09-0352-620ae7d6d62d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   User:
#.     - PLA_TavernInvestigation_Knows_AskedStelmane(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8_AwayFromCorpse:7ad35bda-8ff3-1d09-0352-620ae7d6d62d
msgctxt "h0b7b5ca4g34acg4707g99deg65d8d894c946"
msgid "A massacre. Drow and goblins slaughtered them all."
msgstr "학살입니다. 드로우와 고블린들이 다 죽여 버렸어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8_AwayFromCorpse
#. Speaker = Player
#. NodeID = 7ccb436d-2ce9-dd73-e503-519c3eaf0114
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_Desire_Knows_RavengardTaken = False
#.   User:
#.      - PLA_FlamingFists_Knows_AskedWhatHappened(1) = False
#. SetFlags:
#.   User:
#.     - PLA_FlamingFists_Knows_AskedWhatHappened(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8_AwayFromCorpse:7ccb436d-2ce9-dd73-e503-519c3eaf0114
msgctxt "hda56f412g06b6g4b85g9746ga605c02ee619"
msgid "What happened here?"
msgstr "여기 무슨 일이 있었던 거죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8_AwayFromCorpse
#. Speaker = Fist Recruit Tristan
#. NodeID = 89041c6b-5b0b-c639-6e77-07c37a68c8d4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_FlamingFist7_State_Permadefeated = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8_AwayFromCorpse:89041c6b-5b0b-c639-6e77-07c37a68c8d4
msgctxt "hf9c5d79fg01bbg4d1cg87b4g1fec21979281"
msgid "You should talk to Gauntlet Dain. She's in charge."
msgstr "건틀릿 디안에게 얘기해 보세요. 그녀가 책임자니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8_AwayFromCorpse
#. Speaker = Player
#. NodeID = 8cab39a3-f8d5-098b-0a64-1fd61ad7f677
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentDungeon_Event_Setup = True
#.   Quest:
#.      - PLA_ZhentShipment.Rewarded_ZhentReturned(1) = False
#.   User:
#.      - PLA_FlamingFists_Knows_ZhentDungeon(1) = False
#. SetFlags:
#.   User:
#.     - PLA_FlamingFists_Knows_ZhentDungeon(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8_AwayFromCorpse:8cab39a3-f8d5-098b-0a64-1fd61ad7f677
msgctxt "h116f2572gc85ag4ca0g8d51gcaa3d0e66f76"
msgid "There are Zhentarim lurking about. They have a hideaway nearby."
msgstr "근처에 젠타림이 있습니다. 근처에 놈들 은신처가 있어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8_AwayFromCorpse
#. Speaker = Fist Recruit Tristan
#. NodeID = add8aca1-99e1-4e35-f0e6-61d34673dc9d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_FlamingFist8_InnBurntDown_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8_AwayFromCorpse:add8aca1-99e1-4e35-f0e6-61d34673dc9d
msgctxt "h25906d32g5704g4bcagb57dg4f119d818245"
msgid "I knew some of the dead. They didn't deserve this."
msgstr "죽은 이들 중에는 내가 아는 사람들도 있어요. 이렇게 죽어도 될 사람들이 아닌데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8_AwayFromCorpse
#. Speaker = Player
#. NodeID = c76310ef-cd41-980d-388c-a0befe871cec
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Quest:
#.      - PLA_ZhentShipment.Rewarded_ZhentReturned(1) = True
#.   User:
#.      - PLA_FlamingFists_Knows_ZhentDungeon(1) = False
#. SetFlags:
#.   User:
#.     - PLA_FlamingFists_Knows_ZhentDungeon(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8_AwayFromCorpse:c76310ef-cd41-980d-388c-a0befe871cec
msgctxt "h84560b94gf333g40f9gab96g7fb025f1e3f0"
msgid ""
"There are Zhentarim nearby. They've got a hideout, and I know how to get in."
msgstr "근처에 젠타림이 있습니다. 은신처를 가지고 있는데, 제가 들어갈 방법을 알아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8_AwayFromCorpse
#. Speaker = Fist Recruit Tristan
#. NodeID = c9dc8554-10e1-4a21-2b54-39de1be33a89
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8_AwayFromCorpse:c9dc8554-10e1-4a21-2b54-39de1be33a89
msgctxt "h7ba6c727gcf0bg473bgac42g5150924a9946"
msgid "They were cut down like animals. It's senseless."
msgstr "동물이 도살당하는 것처럼 살해당했어요. 무의미한 죽음이었어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8_AwayFromCorpse
#. Speaker = Player
#. NodeID = dc5f118d-4dae-7dfa-0f0b-9192acea541e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8_AwayFromCorpse:dc5f118d-4dae-7dfa-0f0b-9192acea541e
msgctxt "h688a0b3cg3688g4ce4gbd7eg4e563b7fcdd4"
msgid "All these people... how many did you lose?"
msgstr "이 사람들이 전부 다... 얼마나 많은 사람을 잃은 건가요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8_AwayFromCorpse
#. Speaker = Player
#. NodeID = eb90ed69-cd7e-d603-24a2-a51f8f09283b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8_AwayFromCorpse:eb90ed69-cd7e-d603-24a2-a51f8f09283b
msgctxt "hc77359d0g0ca0g497dg8fe3g2d9531aff8b8"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8_AwayFromCorpse
#. Speaker = Fist Recruit Tristan
#. NodeID = fd01ca1e-2d0c-aed1-f5a4-feb38f20bc2b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8_AwayFromCorpse:fd01ca1e-2d0c-aed1-f5a4-feb38f20bc2b
msgctxt "h082df0cfg5115g41c4g8968ge58e9576afa1"
msgid "The whole guard. Every last one of them."
msgstr "경비대 전원이 당했어요. 마지막 한 사람까지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8_Dousing
#. Speaker = Fist Recruit Tristan
#. NodeID = 0b6359f2-24a3-7c18-2a1b-e2957b59f1c7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_FlamingFist8_HasMet(1) = False
#.   Global:
#.      - PLA_Desire_State_Freed = False
#.      - PLA_Desire_State_Freed2 = False
#. SetFlags:
#.   Dialog:
#.     - PLA_FlamingFist8_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8_Dousing:0b6359f2-24a3-7c18-2a1b-e2957b59f1c7
msgctxt "hc58fe8f3g07ecg49cfg84e4g5eb2c10f7e96"
msgid ""
"We'll never put this fire out. You're better off helping anyone trapped "
"inside!"
msgstr "우리가 이 불을 끄진 못할 거야. 안에 갇힌 사람들부터 구하는 게 나아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8_Dousing
#. Speaker = Fist Recruit Tristan
#. NodeID = 58f7898f-6ab9-889a-a4ac-621780fe415d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_FlamingFist8_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - PLA_FlamingFist8_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8_Dousing:58f7898f-6ab9-889a-a4ac-621780fe415d
msgctxt "h320d5cb2g152cg44f9gac53g4897f4b7a1a3"
msgid "This is hopeless!"
msgstr "가망이 없어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8_Dousing
#. Speaker = Fist Recruit Tristan
#. NodeID = aca4530c-ca8c-a06f-42de-832f6985a0e6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_FlamingFist8_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8_Dousing:aca4530c-ca8c-a06f-42de-832f6985a0e6
msgctxt "hfa1d461fg5eb4g4cdbgb038g3fcf68a00738"
msgid "I'm getting nowhere."
msgstr "아무 데도 못 가겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8_Dousing
#. Speaker = Fist Recruit Tristan
#. NodeID = bf1f4912-0214-45f9-9b30-4b1c98d0741d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_FlamingFist8_HasMet(1) = True
#.   Global:
#.      - PLA_Desire_State_Freed = False
#.      - PLA_Desire_State_Freed2 = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8_Dousing:bf1f4912-0214-45f9-9b30-4b1c98d0741d
msgctxt "hd85fdafcgd872g475egbe46g9ed6b9fe2b0f"
msgid "This is hopeless. You have to get them out of that building!"
msgstr "가망이 없어. 저 건물에서 사람들을 꺼내야 해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFists
#. Speaker = Gauntlet Yeva
#. NodeID = 074755c2-bda7-b812-6ab1-d912ab5f860c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFists:074755c2-bda7-b812-6ab1-d912ab5f860c
msgctxt "habef28c8g4ad2g4893g8b9ag1ed55eea19e7"
msgid "Damn. Find another way inside!"
msgstr "제길. 다른 길을 찾아줘!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFists
#. Speaker = Player
#. NodeID = 10eb0747-6441-583d-6a33-d8d22f2b5c91
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Strength
#. DifficultyClass: 10
#. CheckFlags:
#.   Object:
#.      - PLA_TavernInvestigation_State_TriedOnce(4) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFists:10eb0747-6441-583d-6a33-d8d22f2b5c91
msgctxt "h0edc942dgedfeg4c51g8da6ga4dbdffd3d70"
msgid "<i>Push against the wreckage.</i>"
msgstr "<i>잔해를 밀어낸다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFists
#. Speaker = Player
#. NodeID = 3584e8f7-6665-33fa-6054-a1a7a3434fa4
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Object:
#.      - PLA_TavernInvestigation_State_TriedOnce(4) = False
#.   Tag:
#.      - BARD(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFists:3584e8f7-6665-33fa-6054-a1a7a3434fa4
msgctxt "haa23409cg81edg4078gaa94gc1b4d017993e"
msgid "WE CAN DO IT! PUT YOUR BACKS INTO IT! <i>PUSH!</i>"
msgstr "<b>할 수 있다! 전력을 다해! 밀어!</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFists
#. Speaker = Gauntlet Yeva
#. NodeID = 38c32c5f-f1e3-3fcc-0111-ef4088db7d37
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFists:38c32c5f-f1e3-3fcc-0111-ef4088db7d37
msgctxt "h304877ebg4e92g4de0g87degc0c9dc63c8c7"
msgid "That's right! THREE, TWO, ONE, <i>PUSH!</i>"
msgstr "바로 그거야! <b>셋, 둘, 하나, <i>밀어!</i></b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFists
#. Speaker = Gauntlet Yeva
#. NodeID = 3c14940c-a3ee-9649-a095-4769d835993a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFists:3c14940c-a3ee-9649-a095-4769d835993a
msgctxt "h0d9eafa1gba87g401fg990dg2023c8226e93"
msgid "Now push, damn it!"
msgstr "이제 밀어, 젠장!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFists
#. Speaker = Gauntlet Yeva
#. NodeID = 52056870-b4b7-dcc5-9d1b-d34038dd7ee7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - PLA_TavernInvestigation_State_TriedOnce(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFists:52056870-b4b7-dcc5-9d1b-d34038dd7ee7
msgctxt "h89bfa2d7gbab5g4220gad76gdbd2c6332cd9"
msgid "Go! There has to be another way in!"
msgstr "가봐! 다른 길이 있을 거야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFists
#. Speaker = Gauntlet Yeva
#. NodeID = 5c70a0cd-652e-2a01-3e42-1004396ef4f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFists:5c70a0cd-652e-2a01-3e42-1004396ef4f8
msgctxt "hb2575048g57edg472bgb42ege4cc9a478e3e"
msgid "Unless you're here to finish the job, get over here and push!"
msgstr "마무리를 지으러 온 게 아니라면, 이리 와서 밀어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFists
#. Speaker = Player
#. NodeID = 647da824-c6cf-f0a7-e562-8070d97b2388
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - PLA_TavernInvestigation_Knows_AskedStelmane(4) = False
#. SetFlags:
#.   User:
#.     - PLA_TavernInvestigation_Knows_AskedStelmane(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFists:647da824-c6cf-f0a7-e562-8070d97b2388
