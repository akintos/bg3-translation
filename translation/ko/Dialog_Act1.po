msgctxt "h26ff9363gd0deg471bg9660g540f793e232b"
msgid "*The corpse does not stir. It will answer no more questions.*"
msgstr "*시체는 움직이지 않습니다. 더 이상 질문을 받지 않을 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7_Dead
#. Speaker = Narrator
