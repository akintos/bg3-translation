msgctxt "h9a1cb39dg6353g4aa0g8d50gdb132f737a59"
msgid "Incredible - completely untouched. It looks frozen in time."
msgstr "놀라워. 완벽하게 보존됐군. 시간이 멈춰 있었던 것 같아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_EnterGauntlet
#. Speaker = Player
#. NodeID = 4e4c2399-c0c7-4ea3-8ea9-f6059261e55a
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
