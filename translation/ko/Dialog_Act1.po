#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_NoticeStashSeal:78906681-bbcc-2880-1d5d-052ca046af30
msgctxt "hd0d6597cg38ccg4ff5gad77g2802a2fad4c5"
msgid "Magically sealed. Can't go ape-smash on this thing.\n"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_NoticeStashSeal
#. Speaker = Player
#. NodeID = 78906681-bbcc-2880-1d5d-052ca046af30
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_SeluneStash_State_StashSealCheckSuccess = True
#. SetFlags:
