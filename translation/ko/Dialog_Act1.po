#.     - CRE_Hatchery_HasTriggeredTeleTrap = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_AD_TeletrapTriggered:f3cdb265-4ee0-43dc-9b6d-b78d9e404ea7
msgctxt "hde06a158g39a5g4e76ga2f5g30605f6f829d"
msgid "To arms! The traps have snagged a rat."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = 007121af-cc0f-5446-181d-dd13a5308fc1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:007121af-cc0f-5446-181d-dd13a5308fc1
msgctxt "h4cfd0ff3ga965g4b3dgbc7ag1f84d986910c"
msgid "This one is just proving <i>slow</i>."
msgstr "이건 단지 <i>느린</i> 것일뿐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = 0b290a16-4cc4-9100-4637-f503c08a3aed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:0b290a16-4cc4-9100-4637-f503c08a3aed
msgctxt "h930d7d64g8b85g458eg8164g3f53923675e8"
msgid "It is a little slower to hatch, nothing more."
msgstr "그저 부화가 좀 늦을 뿐, 그뿐이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = 1090b1ff-a017-2a3e-9287-6258b13a7f8e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_Hatchery_HasMet_Caretaker(1) = True
#.   Global:
#.      - CRE_Hatchery_State_HatcheryFriendly = False
#.      - CRE_Hatchery_State_EggTaken = False
#.      - CRE_Hatchery_State_EggDestroyed = False
#. SetFlags:
#.   Dialog:
#.     - CRE_Hatchery_HasMet2_Caretaker(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:1090b1ff-a017-2a3e-9287-6258b13a7f8e
msgctxt "h3b568876g4f29g4cf0ga74bg5160979072e9"
msgid "I don't have time to parent you as well. What do you want now?"
msgstr "너까지 돌봐줄 시간은 없다. 원하는 게 뭐지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = 1121bb00-df52-1133-d271-2aaf17d876d8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_Hatchery_State_EggDestroyed = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:1121bb00-df52-1133-d271-2aaf17d876d8
msgctxt "ha0502d9fgb5f8g4d28gaa39gf6faa02cf558"
msgid "An egg. You murdered a defenceless egg!"
msgstr "내 알. 무방비 상태의 알을 네가 죽여버렸어!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = 1475f735-f866-6365-5a27-76d343de73ce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:1475f735-f866-6365-5a27-76d343de73ce
msgctxt "h9084d21cg8fb6g4e30gbb86g742629135f42"
msgid ""
"The conditions must not be disturbed if it is to have a fighting chance."
msgstr "알에게 싸울 기회를 주려면 주변 환경을 잘 유지시켜야 한다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Player
#. NodeID = 14a38d0b-a86b-6620-b0c8-0bc47576bdaf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:14a38d0b-a86b-6620-b0c8-0bc47576bdaf
msgctxt "h1b820b8dgaf59g48daga57bg49c4b75daffa"
msgid "Why bother? This egg's clearly a dud."
msgstr "왜 그런 귀찮은 짓을? 이 알은 확실히 실패했는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Player
#. NodeID = 14f52d27-26db-d373-1213-ec4c032f16f8
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:14f52d27-26db-d373-1213-ec4c032f16f8
msgctxt "h12fbf290gdb79g438bg9b2cgd23a64a53428"
msgid ""
"You're out of time and clearly stalling - that's why <i>Kith'rak </"
"i>Therezzyn sent me to bring it to her. Hand it over."
msgstr "시간 다 됐어, 명백한 시간끌기로군, 이러니 <i>키스락 </i>테레진이 내게 그걸 가져오라 했지. 이리 넘겨."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = 1aa6e0ec-d46a-0838-27c7-48c05cb4ad36
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_Hatchery_State_HatcheryHostile = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:1aa6e0ec-d46a-0838-27c7-48c05cb4ad36
msgctxt "h9e72da5dgcc77g43degbdadgde14bf376a91"
msgid "No you will not!"
msgstr "그렇게 둘까 보냐!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = 1b27749e-7263-4b0f-ab0a-54eef6d4bda1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_Hatchery_State_HatcheryHostile = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:1b27749e-7263-4b0f-ab0a-54eef6d4bda1
msgctxt "h84b8f1e7gb845g4642ga43fgd0d59507fb04"
msgid ""
"You think I haven't defended our broods against worthier opponents than you? "
"Idiot."
msgstr "내가 너보다 더한 놈들로부터 우리 무리를 지켜왔다는 사실을 모르는 거냐? 멍청하긴."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = 1df4b47a-0cea-d496-7793-3d03046727f7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_Hatchery_State_HatcheryHostile = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:1df4b47a-0cea-d496-7793-3d03046727f7
msgctxt "hfeb0a2aag685bg4247g934eg237ae5bcfaa2"
msgid "You will pay for this. <i>Htak'a!</i>"
msgstr "이 일의 대가를 치르게 해주마. <i>흐타카!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Player
#. NodeID = 23b2d908-e950-f9de-bea2-2a5ae5e66ae6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:23b2d908-e950-f9de-bea2-2a5ae5e66ae6
msgctxt "h0e7f813dg5a83g4fb9ga828gfd7a1e96fcdc"
msgid "You're being very protective of this egg - why?"
msgstr "알을 지나치게 보호하는 것 같은데, 왜지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = 250cc0de-b40a-10c4-7171-5c9afde5e20f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:250cc0de-b40a-10c4-7171-5c9afde5e20f
msgctxt "h000917b2gd548g4212g8ddfga24a3a9a46c9"
msgid ""
"Still, I'm sure it's nature will pervade, even if raised among lesser "
"species."
msgstr "하지만 약한 종들 사이에서 자란다 해도 자연스레 본성이 발현되겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = 27373022-5ce7-5cd9-da27-33342fcb90c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:27373022-5ce7-5cd9-da27-33342fcb90c4
msgctxt "h06cc581cg40b5g4aa9g8e95gff3d01e2ca6c"
msgid "I see. I cannot deny that I had hoped for more time."
msgstr "그렇군. 시간이 더 있었으면 했다는 걸 부정하진 않겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Player
#. NodeID = 27d836d8-6eb7-ada9-3677-624d4ae09aac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:27d836d8-6eb7-ada9-3677-624d4ae09aac
msgctxt "h3f06cff7g6c34g4a83gbaa5g1c5d9bb9f8fc"
msgid "I'll raise it as if it were my own flesh and blood."
msgstr "내 혈육인 것처럼 기를 생각이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = 283de34e-7895-d30b-2673-61fa2201c4f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:283de34e-7895-d30b-2673-61fa2201c4f5
msgctxt "h6582b017g30c1g4cd9ga989g4227d403ead1"
msgid "This is my duty. I will protect it."
msgstr "이것이 내 의무다. 내가 지키겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = 2b0f79ce-845e-17c9-accc-ce324d75df2d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CRE_Hatchery_State_FailedToPersuadeCaretaker(1) = True
#.     - CRE_Hatchery_HasMet2_Caretaker(1) = True
#. TagRule: !GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:2b0f79ce-845e-17c9-accc-ce324d75df2d
msgctxt "h62f1e3f9g56b2g450bga79bg86ec0a8fd20e"
msgid ""
"Time for you to leave, I think, <i>istik</i>. And <i>do not</i> touch the "
"egg."
msgstr "이제 갈 시간이겠군, <i>이스틱</i>. 그리고 <i>절대</i> 알은 건들지마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = 2b0f79ce-845e-17c9-accc-ce324d75df2d
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CRE_Hatchery_State_FailedToPersuadeCaretaker(1) = True
#.     - CRE_Hatchery_HasMet2_Caretaker(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:2b0f79ce-845e-17c9-accc-ce324d75df2d
msgctxt "h2e46d55fg0a14g4ecaga1aeg8253b5db5542"
msgid "Time for you to leave, I think, kin. And <i>do not</i> touch the egg."
msgstr "이제 갈 시간이겠군, 동포여. 그리고 <i>절대</i> 알은 건들지마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = 2b7c31d6-e2a5-f6d0-d67e-58b35fe08d38
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:2b7c31d6-e2a5-f6d0-d67e-58b35fe08d38
msgctxt "hb6d7dfeagebdcg4eadga18ag3a75ec2f770b"
msgid "Now leave."
msgstr "이제 가라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = 2caf05b3-e7c7-043b-d5c3-a38ecad285fa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:2caf05b3-e7c7-043b-d5c3-a38ecad285fa
msgctxt "h3bdf2047g31b1g4953g8cb7g9815a9c1b8c4"
msgid ""
"They almost drowned me in the hatching pool. If it wasn't for the <i>varsh</"
"i> of my clutch -"
msgstr "부화못에서 거의 익사할 뻔했다. 알 형제 <i>바쉬</i>의 보살핌이 없었다면 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = 2d0c4c0f-c3e5-7b50-89f5-4eb0472ccc07
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CRE_Hatchery_State_FailedToPersuadeCaretaker(1) = True
#.     - CRE_Hatchery_HasMet2_Caretaker(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:2d0c4c0f-c3e5-7b50-89f5-4eb0472ccc07
msgctxt "hd9bcf95dg0853g47a7gbf26g059aa6b8f661"
msgid "Careful, kin. You tread close to blasphemy. Do not overstep."
msgstr "조심하시게, 동포여. 그건 신성모독에 가까우니. 선을 넘지 마라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Player
#. NodeID = 32fe8fc0-e938-b8ee-3ecc-900f7b4e79f1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:32fe8fc0-e938-b8ee-3ecc-900f7b4e79f1
msgctxt "hebd61d9dgc442g4a46g9a47g0216f1ab68a7"
msgid ""
"I'll see that it becomes the greatest <i>ghaik</i>-slayer you've ever seen."
msgstr "이 녀석이 사상 최고의 <i>게이크</i> 사냥꾼이 되는 걸 지켜보겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = 3687d2a9-3f2a-66e5-5a78-91f43f7fcddb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:3687d2a9-3f2a-66e5-5a78-91f43f7fcddb
msgctxt "hacca01ceg2b2fg47f7ga3afg2afd7877f138"
msgid "Unlikely, but the journey may yet be character-forming."
msgstr "예삿일은 아니지만, 어쩌면 네 여정에서 인격이 형성될 수도 있겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = 39226d5c-8300-cb1b-b761-9a0345907926
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_Hatchery_HasMet2_Caretaker(1) = True
#.   Global:
#.      - CRE_Hatchery_State_HatcheryFriendly = False
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:39226d5c-8300-cb1b-b761-9a0345907926
msgctxt "h57bca733gd3d0g46c3ga223g52864d252222"
msgid "Enough! Be on your way."
msgstr "그만! 이만 가라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = 39ac26cf-8393-50ac-a290-b63a8b164a66
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_Hatchery_State_HatcheryHostile = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:39ac26cf-8393-50ac-a290-b63a8b164a66
msgctxt "ha4f490abg1c5eg42a1gb8feg1a75221d89b0"
msgid ""
"How dare you? Your bones will melt in the hatching pool, you insolent whelp!"
msgstr "어찌 감히? 네 뼈를 부화못에 녹여주마, 건방진 하룻강아지 같으니!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = 3b113fad-7faf-8a27-ce84-faad4e10701e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_Hatchery_HasMet_Caretaker(1) = False
#.   Global:
#.      - CRE_Hatchery_State_EggTaken = False
#.      - CRE_Hatchery_State_EggDestroyed = False
#.   Object:
#.      - CRE_Hatchery_State_SpottedNearEgg(1) = True
#. SetFlags:
#.   Dialog:
#.     - CRE_Hatchery_HasMet_Caretaker(1) = True
#.   Global:
#.     - CRE_Hatchery_GlobalHasMet_Caretaker = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:3b113fad-7faf-8a27-ce84-faad4e10701e
msgctxt "h10982892g4346g4953g8c24g93ab0355fefa"
msgid ""
"This hatchery is a place of solemn duty and care. No one approaches an egg "
"without my permission."
msgstr "부화장은 엄숙한 책임과 주의가 필요한 곳이다. 누구도 내 허락없이 알에 접근할 수 없다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = 44023d4c-991e-0f22-14d4-a9d2b0f2b365
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:44023d4c-991e-0f22-14d4-a9d2b0f2b365
msgctxt "h35154e1cg1622g45daga4c5g44b1478e5d95"
msgid ""
"But you've a spirit about you that's quite inspiring. Perhaps even equal to "
"the challenge."
msgstr "하지만 넌 매우 진취적인 정신을 지닌 것 같군. 어쩌면 도전과 맞먹을지도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Player
#. NodeID = 44af10d0-ed45-08be-47bd-46b5e60c067c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:44af10d0-ed45-08be-47bd-46b5e60c067c
msgctxt "h7d0b6f60g617eg475fga485geaf18fc76d32"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = 45aa94de-ff0f-cecd-93de-c721933ddf2b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:45aa94de-ff0f-cecd-93de-c721933ddf2b
msgctxt "h518b822bg88a2g4881g935dg0df5953e6666"
msgid ""
"<i>Kith'rak </i>Therezzyn is of the same opinion. She would see it destroyed "
"and forgotten."
msgstr "<i>키스락 </i>테레진도 같은 생각이다. 알을 부수고 잊어버리길 바라지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Player
#. NodeID = 4ad0b512-dc3f-0c92-f7f7-9032f4f30b0b
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Dialog:
#.      - CRE_Hatchery_State_ImpliedEggParent(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:4ad0b512-dc3f-0c92-f7f7-9032f4f30b0b
msgctxt "h738dd017g11f3g48e9gaf57g20c5d4ef5be6"
msgid ""
"Tell me the truth. Why do you <i>really </i>care about this one so much?"
msgstr "사실대로 말해줘. 왜 <i>이렇게</i> 이 알을 신경 쓰는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Player
#. NodeID = 4caf66a5-80e5-f85f-de7e-685e467a3cca
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_HatcheryGuard_KnowsAboutEggs(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:4caf66a5-80e5-f85f-de7e-685e467a3cca
msgctxt "h60aa85f0g24a2g474aga4b3g2d3abc3d72b3"
msgid "I am here to help you save the egg."
msgstr "알을 지키는 걸 도우러 왔다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = 5830f3f4-7755-c51b-1581-16caafef7dd4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:5830f3f4-7755-c51b-1581-16caafef7dd4
msgctxt "hc7ae5b51gfff6g4f44g9464g177ef146eec7"
msgid "Tell me, what will you do with it if I entrust it to you?"
msgstr "말해봐, 내가 알을 네게 맡기면 어떻게 할 생각이지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Player
#. NodeID = 58689377-9521-d408-0975-6559301be0c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:58689377-9521-d408-0975-6559301be0c0
msgctxt "h5764a021g4d77g4566g91dbge1a5abf269bc"
msgid "I'll find another crèche. One that's more forgiving."
msgstr "다른 양성소를 찾아볼 거야. 좀 더 관대한 곳으로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = 5cc00795-2418-d172-04d9-7b0aea8b023e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_Hatchery_State_HatcheryFriendly = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:5cc00795-2418-d172-04d9-7b0aea8b023e
msgctxt "hf0ad25degdf6ag4d2bg8490gd59064878468"
msgid ""
"Just know that if the child comes to harm, I will find you, drag you back "
"here, and drown you in the burning waters."
msgstr "당부하지. 그 아이에게 해를 입히면, 네놈을 찾아내 여기로 끌고 와 불타는 물에 익사시키고 말겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Player
#. NodeID = 5ebf9c66-5f59-ce05-87d4-750ec6301726
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:5ebf9c66-5f59-ce05-87d4-750ec6301726
msgctxt "h6d6278fegb638g4115ga508gfd0aabfedb9a"
msgid "I am curious about the egg you guard."
msgstr "네가 지키는 알에 대한 호기심이 이는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Narrator
#. NodeID = 5fb96b6e-dc29-122d-b503-2e825dfee32f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:5fb96b6e-dc29-122d-b503-2e825dfee32f
msgctxt "h205a625eg00b0g4785g922cgb6060da14c89"
msgid ""
"*You note that the hope in his voice is tinged with weariness. It's the "
"voice of a man who's fought the inevitable for a long time.*"
msgstr "*그의 희망찬 말에 피로감이 묻어나는 것을 눈치챕니다. 오랫동안 불가피한 운명과 싸워온 남자의 목소리입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Player
#. NodeID = 61227a20-92f6-7522-75ee-be1a67133169
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 02ea8972-0e8a-4291-c991-a113afd54595_AskedAboutEggsFate = False
#. SetFlags:
#.   Local:
#.     - 02ea8972-0e8a-4291-c991-a113afd54595_AskedAboutEggsFate = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:61227a20-92f6-7522-75ee-be1a67133169
msgctxt "hc2156da2gfaa2g476bgbfd7gbc2e00efb9de"
msgid "What will happen to this egg if it doesn't hatch?"
msgstr "만약 부화하지 않으면 어떻게 되는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = 66cde688-2841-ed58-f9c3-83a919580a6d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:66cde688-2841-ed58-f9c3-83a919580a6d
msgctxt "h0fd757c6gb208g4b2bga524gc4ff3310bcd7"
msgid ""
"<i>Kith'rak </i>Therezzyn will give orders to destroy it. She will say it's "
"a weakling."
msgstr "<i>키스락 </i>테레진이 알을 파괴하라 명령하겠지. 약골일 거라면서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Player
#. NodeID = 69004a3a-756f-c6eb-31b6-88f5a5dcdebe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:69004a3a-756f-c6eb-31b6-88f5a5dcdebe
msgctxt "h1a8f6884g9362g40e3g9b0fg22dfed066a7b"
msgid "Depends, how much do you think these things sell for?"
msgstr "어쩔까, 이거 팔면 얼마나 받을 수 있지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = 6cd9a714-e693-2376-7ed4-279a06946c81
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:6cd9a714-e693-2376-7ed4-279a06946c81
msgctxt "ha6a2ebb0gf11dg49b9g8ed0ge11abf97023b"
msgid "A forceful demand."
msgstr "강력한 요구로군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Player
#. NodeID = 6d9ccae7-9d5c-d799-6291-8f4416a775f6
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#. CheckFlags:
#.   Dialog:
#.      - CRE_Hatchery_State_ImpliedEggParent(1) = False
#. TagRule: REALLY_GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:6d9ccae7-9d5c-d799-6291-8f4416a775f6
msgctxt "he5d354dbg8e36g44afgbbb7gf14fbbd6648a"
msgid "Some eggs simply fail - why do you care so much for this one?"
msgstr "어떤 알은 실패하기도 한다, 이걸 왜 그렇게 신경 쓰는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Player
#. NodeID = 6d9ccae7-9d5c-d799-6291-8f4416a775f6
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#. CheckFlags:
#.   Dialog:
#.      - CRE_Hatchery_State_ImpliedEggParent(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:6d9ccae7-9d5c-d799-6291-8f4416a775f6
msgctxt "h2a8d2452g5af5g4694gb4f2gd6402e1ae114"
msgid "Why do you care so much about one dud egg?"
msgstr "실패한 알을 왜 그렇게 신경 쓰는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = 6edc9450-bcd9-21c8-be58-c32441bd23bb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:6edc9450-bcd9-21c8-be58-c32441bd23bb
msgctxt "h69ff9646gf57eg41cag9424g1ab56b04770a"
msgid ""
"Still, I suppose a guest in our crèche can be allowed some understanding. "
"What brings you to my hatchery?"
msgstr "그래도, 우리 양성소의 손님이라면 어느정도 이해할 수는 있을지도. 내 부화장엔 무슨 일이지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Player
#. NodeID = 74ab28ee-60b3-90a8-2ac2-4315480d3c61
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_HatcheryGuard_KnowsAboutEggs(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:74ab28ee-60b3-90a8-2ac2-4315480d3c61
msgctxt "h0911d2ecg2f23g4c57ga154g1de07c126fd9"
msgid "I heard you're waiting for one last egg to hatch."
msgstr "마지막 알이 부화하길 기다리고 있다던데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = 779083d4-3591-1910-55fc-da3f4de311d7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CRE_Hatchery_State_FailedToPersuadeCaretaker(1) = True
#.     - CRE_Hatchery_HasMet2_Caretaker(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:779083d4-3591-1910-55fc-da3f4de311d7
msgctxt "hf024dff5g5d9bg4464g974fg07f943ee9377"
msgid "No! The child will be safer with me. I know what it needs."
msgstr "안돼! 이 아이는 나와 있어야 안전하다. 난 뭐가 필요한지 아니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = 78ff8776-816e-bee6-eb6f-f58e32b9010f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:78ff8776-816e-bee6-eb6f-f58e32b9010f
msgctxt "hb171f1fag1a27g43a7g9e97g29396bb97c91"
msgid "Hm. Just beware that adoptive piety does not turn to sentimentality."
msgstr "흠. 다만 입양의 전통을 감상적으로 받아들이지 않도록 주의해라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = 7b2c0c80-8bda-0d3e-73bb-3cba11b56185
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:7b2c0c80-8bda-0d3e-73bb-3cba11b56185
msgctxt "h779fc693gc9e3g4cbdg8c6egc1a39fbe3168"
msgid ""
"Not all that arrive late are weak. I created this entire hatchery, despite "
"being the last of my clutch to hatch."
msgstr "늦게 나는 애들이 모두 약한 건 아니다. 난 우리 알 중에 가장 늦게 태어났지만, 이 부화장 전체를 만들어냈다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Player
#. NodeID = 7e1d69b9-9fa7-a680-ea37-09943bb36d64
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_HatcheryGuard_KnowsAboutEggs(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:7e1d69b9-9fa7-a680-ea37-09943bb36d64
msgctxt "h39628931g1cb5g4847g9bf0g4d3820e3fa60"
msgid "I wanted to see the hatchery. I didn't expect it to look so empty."
msgstr "부화장이 보고 싶었는데. 이렇게 비어있을 줄은 몰랐네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = 7ea60a50-b000-315f-e021-f9f6e49d9a00
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:7ea60a50-b000-315f-e021-f9f6e49d9a00
msgctxt "hee02d44cge77cg499cg868egdef5093084e2"
msgid "That is for <i>me</i> to decide."
msgstr "그건 <i>내가</i> 결정할 일이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = 81029228-44e8-3146-a780-7cc73ca440dd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:81029228-44e8-3146-a780-7cc73ca440dd
msgctxt "hfc745d62g9a3eg42e6gb62dgac9c84260d84"
msgid ""
"Do you think the Sword Coast is littered with crèches? That you found this "
"one was unlikely enough."
msgstr "소드 코스트에 양성소가 널려 있다고 생각하나? 여길 찾은 것 자체가 이미 예외적인 일이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Player
#. NodeID = 83cc1b8e-4012-6c96-0143-7e45ff1fb0f0
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:83cc1b8e-4012-6c96-0143-7e45ff1fb0f0
msgctxt "h9795d4e1g92e9g40cbgba3ega6d7d3bc0250"
msgid "Why risk its life at all? Give it to me - I'll take care of it."
msgstr "왜 그 알을 위험에 빠뜨리는 거지? 나에게 줘, 내가 잘 돌볼게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = 860ec841-17c3-de38-85e9-4fdc94981674
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:860ec841-17c3-de38-85e9-4fdc94981674
msgctxt "hb5070036gaa40g430cgb6b3g0564ceea20d4"
msgid "Though it could be the only way this one reaches adulthood, I fear."
msgstr "이 아이가 성인으로 자라날 수 있는 유일한 방법일지도 모르겠지만, 우려스럽군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = 86f40349-ba01-cbbd-60a4-966443d1c849
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:86f40349-ba01-cbbd-60a4-966443d1c849
msgctxt "hc0d01086g7af0g4833g8ebbgc2496af0de44"
msgid "You? You've no <i>varsh </i>instincts about you at all."
msgstr "네가? 어딜 봐도 <i>바시</i>의 자질을 갖춘 것 같진 않다만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = 8a96c922-c2dc-0168-5044-cdc8a8dec352
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:8a96c922-c2dc-0168-5044-cdc8a8dec352
msgctxt "h276f05e4g55f3g4ac4gb201ge9094a92bdf6"
msgid ""
"Almost all of the eggs in this clutch have hatched. We await only one more, "
"which is... taking its time."
msgstr "대부분의 알은 이미 부화했다. 이제 하나 남았는데, 얘는... 시간이 좀 필요한가 보군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = 8e441cc2-a810-5286-2de9-1f8dd640f013
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_Hatchery_HasMet_Caretaker(1) = False
#.   Global:
#.      - CRE_Hatchery_State_HatcheryFriendly = False
#.      - CRE_Hatchery_State_EggTaken = False
#.      - CRE_Hatchery_State_EggDestroyed = False
#.   Object:
#.      - CRE_Hatchery_State_SpottedNearEgg(1) = False
#. SetFlags:
#.   Dialog:
#.     - CRE_Hatchery_HasMet_Caretaker(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:8e441cc2-a810-5286-2de9-1f8dd640f013
msgctxt "h8058f803g2b96g41ccg8bcdg5c51fce037ac"
msgid ""
"You can tell <i>Kith'rak</i> Therezzyn that my position has not changed: the "
"egg requires more time. Furthermore - oh."
msgstr "<i>키스락</i> 테레진에게 내 입장은 아직 변함없다고 전해라: 알에게는 시간이 더 필요하다고. 게다가, 오."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Player
#. NodeID = 9558c75a-d916-b030-079a-cbd0984ed6e7
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Dialog:
#.      - CRE_Hatchery_State_FailedToPersuadeCaretaker(1) = False
#.   Global:
#.      - CRE_Hatchery_State_HatcheryFriendly = False
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:9558c75a-d916-b030-079a-cbd0984ed6e7
msgctxt "h7d7258aagfea1g49acga8cbg0b7127b49a4d"
msgid "Let me help - I can take it somewhere safe."
msgstr "내가 도와주지, 안전한 곳으로 가져갈 수 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Player
#. NodeID = 97edb82a-9596-0e47-7ec5-2c7baf94ac98
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:97edb82a-9596-0e47-7ec5-2c7baf94ac98
msgctxt "h12a73738ge92eg4d37ga48cg8894ff880f35"
msgid "This seems like an awful lot of fuss for one egg."
msgstr "알 하나 가지고 꽤나 호들갑떠는 거 같네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = 9e3bf291-f963-f092-60f4-655628c67c7a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:9e3bf291-f963-f092-60f4-655628c67c7a
msgctxt "hdfe7c9cbg869cg47c1g8ac7g8e74b2d3104c"
msgid "You are not from Crèche Y'llek. What are you doing here?"
msgstr "일레크 양성소에서 보낸 게 아니군. 여기서 뭐하는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = a3c5bade-5e3c-d912-90a0-1c56ffe8d574
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 02ea8972-0e8a-4291-c991-a113afd54595_KnowsCaretakerNearlyDrowned = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:a3c5bade-5e3c-d912-90a0-1c56ffe8d574
msgctxt "h17fedf6dgc7c5g47bag9d2egf4d9f3dc91a6"
msgid "This one deserves the same chance."
msgstr "이 녀석도 그런 기회를 받을 가치가 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = a7afa4e0-5165-72a3-3a24-863e7f8a51fd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:a7afa4e0-5165-72a3-3a24-863e7f8a51fd
msgctxt "h5566f742gfe8cg420eg824fg9afc1530ff9d"
msgid "You? What do you know about githyanki child-rearing?"
msgstr "네가? 기스양키 양육에 대해 아는 게 있나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = abdcca04-a59b-c3be-651a-a729e62273f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:abdcca04-a59b-c3be-651a-a729e62273f8
msgctxt "hf9f402a2ga3c6g434fga15cgc0725c4fdfac"
msgid "Is this some sort of grotesque attempt at humour?"
msgstr "지금 나랑 농담 따먹기라도 하자는 것이냐?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = ace21a49-16ee-23b7-71ea-4348fd9baef0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_Hatchery_State_HatcheryFriendly = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:ace21a49-16ee-23b7-71ea-4348fd9baef0
msgctxt "hb816d440gede1g488egbdccgc750d26d92cf"
msgid "Very well. Here - take these - they will aid you approach the egg."
msgstr "좋아. 여기, 이걸 가져가라, 알에 접근하는 걸 도와줄 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = b3152685-c8b3-ece5-3402-78d078983637
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:b3152685-c8b3-ece5-3402-78d078983637
msgctxt "h3448aae7g6f69g4183gb712gec44260d4ea3"
msgid "I do this under protest. But it is what's best."
msgstr "난 반대 의견에 시달리며 일하고 있다. 어쩌면 이게 최선이겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = b7dc1d68-047d-1b5e-34c1-9dc9f70eb77c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:b7dc1d68-047d-1b5e-34c1-9dc9f70eb77c
msgctxt "hbb95b7d0gc494g40d7g9abag630fe8d68ca0"
msgid ""
"There is little to be curious about. It is taking its time hatching, nothing "
"more."
msgstr "호기심 가질 것 없다. 부화하는데 시간이 필요한 거지, 그뿐이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = bcf9e601-b9d4-de0e-2023-62bcbe0239d7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:bcf9e601-b9d4-de0e-2023-62bcbe0239d7
msgctxt "h23144531g9c8bg40ffgad6dg7290ee239836"
msgid ""
"I do not midwife the birth of your young - do not tell me how to care for "
"mine."
msgstr "나를 네 산파쯤으로 생각하는 거냐? 내 양육법에 왈가왈부하지 마라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Player
#. NodeID = be72ffe3-1374-287a-a7bf-08476e686d4a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CRE_Hatchery_State_SpottedNearEgg(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:be72ffe3-1374-287a-a7bf-08476e686d4a
msgctxt "hd839fd2fgf97fg4047g9ba6ge2de6d0a13a9"
msgid "You mistook me for someone. Who were you expecting?"
msgstr "날 다른 사람과 착각했나보군. 누굴 기다리고 있었던 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = bea384c7-2c7f-816d-593c-6e0534b0cc27
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_Hatchery_State_HatcheryFriendly = True
#.      - CRE_Hatchery_State_EggTaken = False
#.      - CRE_Hatchery_State_EggDestroyed = False
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:bea384c7-2c7f-816d-593c-6e0534b0cc27
msgctxt "he6bebd47ge2eeg409fg9ef1g342eb8e2b1cd"
msgid "Well? Will you take the egg or not?"
msgstr "음? 그래서 가져갈 거야, 말 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = c10c2f6b-b5ef-146c-8043-f956781fe208
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:c10c2f6b-b5ef-146c-8043-f956781fe208
msgctxt "h5c9fdbc8gc269g4ef8g8a38gd2a37a5f057a"
msgid ""
"Still, the captain's due for an inspection any day now, and if she sees it "
"here..."
msgstr "그래도, 대장이 언제든 점검할 수도 있고, 점검중에 여길 본다면..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = c45021d6-19fc-ac35-a649-ee293c83647b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:c45021d6-19fc-ac35-a649-ee293c83647b
msgctxt "h7cbd62cdga95ag4b03gac7agcfc5e9261b48"
msgid "It's taking a little longer than expected to hatch."
msgstr "예상보다 부화하는데 시간이 좀 더 걸리고 있다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = c5619fc0-fb59-919f-6304-618b2409709a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:c5619fc0-fb59-919f-6304-618b2409709a
msgctxt "hf2c5aa80gc9d8g4e7agb5edgc516e2e0a172"
msgid "We cannot afford to discard warriors because we are simply impatient."
msgstr "단순한 인내심 부족으로 전사를 버릴 여유같은 건 없다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Player
#. NodeID = c5944615-ad9c-e0bc-839f-0a689b692a2d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:c5944615-ad9c-e0bc-839f-0a689b692a2d
msgctxt "h1e765f3fgf9c4g401cgbdb2g86913801c9c8"
msgid "Our broods are bigger than this, kin. Where are the others?"
msgstr "우리 무리는 이것보다 훨씬 크다, 동포여. 나머지는 어디갔지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = cc5a1a40-8630-392e-8852-3e5663950e3a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_Hatchery_State_HatcheryFriendly = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:cc5a1a40-8630-392e-8852-3e5663950e3a
msgctxt "hd449ede9g7931g4756g98d0g11d13e3c1676"
msgid ""
"But the <i>kith'rak</i> speaks for our Queen. And I live to serve. Fine. You "
"can take it."
msgstr "하지만 <i>키스락</i>의 말은 여왕님의 말씀과 같다. 그리고 난 여왕님을 섬기니. 가져가라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = cd785a45-9e04-36bb-3ed3-148444b7d80e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:cd785a45-9e04-36bb-3ed3-148444b7d80e
msgctxt "h8171c87bge231g4aaeg9beag5843aac77174"
msgid "But if I know her, she's <i>too busy for that</i>."
msgstr "하지만 난 알지, 그러기엔 <i>너무 바쁘단 사실을</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = d0ad1582-46eb-fdd8-ddfd-51188442cc7b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_Hatchery_State_HatcheryFriendly = False
#.      - CRE_Hatchery_State_EggTaken = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:d0ad1582-46eb-fdd8-ddfd-51188442cc7b
msgctxt "h16cb8d31gd22ag4f94g807cgd2473742e263"
msgid ""
"Did you think me a fool? Did you think I wouldn't notice the theft of our "
"final egg?"
msgstr "내가 바보로 보이나? 마지막 남은 알을 훔쳤단 걸 내가 모를 것 같아?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = d27f4680-58ca-cf57-aa7d-ef7afcf27b06
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:d27f4680-58ca-cf57-aa7d-ef7afcf27b06
msgctxt "h4300f4ffg4ee5g4701gb9a2gbc7362e583e3"
msgid ""
"<i>Most </i>caretakers would not give the child its fair chance, but I "
"shall. There could be greatness in that shell."
msgstr ""
"<i>보통 </i>관리자들은 아이들에게 공정한 기회를 주지 않아, 하지만 난 다르다. 저 껍데기 안에는 대단한 녀석이 들어있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Player
#. NodeID = d3a4042b-2c8e-72fc-98da-8ebf2de2f29a
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#. CheckFlags:
#.   Dialog:
#.      - CRE_Hatchery_State_FailedToPersuadeCaretaker(1) = False
#.   Global:
#.      - CRE_Hatchery_State_HatcheryFriendly = False
#.   Local:
#.      - 02ea8972-0e8a-4291-c991-a113afd54595_KnowsCaretakerNearlyDrowned = True
#.   Tag:
#.      - REALLY_GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:d3a4042b-2c8e-72fc-98da-8ebf2de2f29a
msgctxt "h24479b07g4206g4f5ega7b7g280ae9862ba0"
msgid ""
"This egg would do better away from the tyranny of our kind. Give it to me "
"and I'll give it a better life."
msgstr "이 알은 우리 종족의 횡포에서 벗어나는 게 나을지도 몰라. 나에게 주면 더 나은 삶을 살게 할 수 있다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = d3fef12c-2656-97fb-3c82-4dcffb419dfe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:d3fef12c-2656-97fb-3c82-4dcffb419dfe
msgctxt "hc0fa51bbgf7a6g4bd6ga44fg0b86284a9b86"
msgid "That's what I feared."
msgstr "근심거리를 안겨 주는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = d4227aaa-268d-0fb7-75f0-3e1a4ce23524
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CRE_Hatchery_State_FailedToPersuadeCaretaker(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:d4227aaa-268d-0fb7-75f0-3e1a4ce23524
msgctxt "h91aaae45g9dbag48dag86eegad0083f40a01"
msgid "If she really wants it, she can come and get it herself."
msgstr "정말 그녀가 이걸 원한다면, 직접 와서 가져가야 할 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = d9a650ac-d590-65e7-b723-1664f3a8fa3c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:d9a650ac-d590-65e7-b723-1664f3a8fa3c
msgctxt "h8b687e79ga8d3g4fffg9182g4ddbb5bae10c"
msgid ""
"It would certainly be her style to send a messenger in her stead for a task "
"like that."
msgstr "이런 식으로 전령을 보내는 게 그녀의 방식이긴 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = d9b73b1f-2714-1ec6-1a8d-ec775f423ced
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CRE_Hatchery_Event_GivesBoots(0) = True
#. TagRule:
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:d9b73b1f-2714-1ec6-1a8d-ec775f423ced
msgctxt "h3c09dfa9ga3acg47d3g9e29g6e095b123765"
msgid ""
"I can no longer ignore that <i>Kith'rak</i> Therezzyn's patience has its "
"limits."
msgstr "<i>키스락</i> 테레진의 인내심이 한계에 다다랐다는 사실을 더 이상 무시할 수도 없겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = db63bc3c-a2fa-ba61-94e3-c694ef651ef0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_Hatchery_State_HatcheryHostile = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:db63bc3c-a2fa-ba61-94e3-c694ef651ef0
msgctxt "hcbf64bfbg2a34g4d5bg9a3dg20933db55a86"
msgid "Hateful. Utterly hateful.<i></i>"
msgstr "혐오스럽군. 아주 혐오스러워.<i></i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = de410891-2a3d-c0cb-1215-938b704c3db2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:de410891-2a3d-c0cb-1215-938b704c3db2
msgctxt "hdeb1cfa1gffd4g4bf7ga351g572438d52f23"
msgid "Someone with orders from our commander to destroy this egg."
msgstr "사령관에게서 이 알을 파괴하라는 명령을 받은 사람."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = e38ca586-256f-8b8d-8df1-7f7e126c7801
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:e38ca586-256f-8b8d-8df1-7f7e126c7801
msgctxt "he9377e37gd137g4256g8cf8gd47cd300c2fe"
msgid ""
"An accurate assessment. They hatched promptly and are well into their "
"training."
msgstr "정확한 판단이다. 이미 제대로 부화해서 잘 훈련받고 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = e70c2ffc-c9d0-2539-73d0-aace6997f570
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:e70c2ffc-c9d0-2539-73d0-aace6997f570
msgctxt "h19eb597fg404bg4749gab74gc5606df25f7d"
msgid ""
"Of course, a stranger from a strange crèche may have different customs. What "
"brings you here?"
msgstr "물론, 다른 양성소에서 온 이방인은 다른 관습을 갖고 있을 수도 있지. 여긴 무슨 일로 왔지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = e966178d-fb16-0075-47ae-82fa5fa50a8d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_Hatchery_State_HatcheryFriendly = True
#.      - CRE_Hatchery_State_EggTaken = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:e966178d-fb16-0075-47ae-82fa5fa50a8d
msgctxt "hb42294f4gd827g417cg9a68g00e9ec037958"
msgid ""
"You've got the egg haven't you? Be on your way then. Before I change my mind."
msgstr "이미 알을 챙기지 않았나? 그럼 이제 가라. 내 맘이 바뀌기 전에."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Player
#. NodeID = eb526783-6564-a912-9fff-53d6948c2335
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:eb526783-6564-a912-9fff-53d6948c2335
msgctxt "h3ce9d57bg299eg4f9dgbb17g7d3736a39648"
msgid "I want the egg. How much for it?"
msgstr "알을 갖고 싶어. 얼마면 되지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Player
#. NodeID = ecd8071a-8e32-6e6a-6e5c-c7fad95c025a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:ecd8071a-8e32-6e6a-6e5c-c7fad95c025a
msgctxt "h7f180f3eg5a23g4054gabc3gc1d10530d24c"
msgid "I came here to steal an egg."
msgstr "알을 훔치러 왔다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = f1468937-5c62-887a-726b-4e536c734073
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:f1468937-5c62-887a-726b-4e536c734073
msgctxt "hc5800b92g9c48g4a44gba28g231b35056f01"
msgid "This egg is in my care. It does not need saving."
msgstr "알은 내가 잘 돌보고 있다. 보호가 더 필요하진 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = f14d647d-5f29-aa87-414c-643644d4ad67
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:f14d647d-5f29-aa87-414c-643644d4ad67
msgctxt "ha2ac4debg8318g4645ga2c6gb2c9f61bafd8"
msgid "It is a dangerous world out there - I'm sure you know that."
msgstr "밖은 위험한 곳이야, 알고는 있겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = f1ba260e-d26c-25d3-f83f-187f1b58f0a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:f1ba260e-d26c-25d3-f83f-187f1b58f0a6
msgctxt "hb8730f13g6fdeg44bdg8e43g6e8687a38ea1"
msgid "I was not expecting an <i>istik</i>. What brings you to my hatchery?"
msgstr "<i>이스틱</i>이 올 줄은 몰랐는데. 부화장까진 어쩐 일이지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Lae'zel
#. NodeID = f259c365-cdf2-4ef9-8829-6d2b347b5905
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:f259c365-cdf2-4ef9-8829-6d2b347b5905
msgctxt "h526f766dge111g4bc6ga588gc5a88a2f2d66"
msgid ""
"Failure at the first hurdle of existence. Most caretakers would crush it and "
"be done."
msgstr "태어나기 위한 첫 장애물을 넘는데 실패했군. 보통 관리자들은 알을 부숴버리고 끝낼텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Player
#. NodeID = fb767e07-5581-63a7-0585-2a73f0c0bf7d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:fb767e07-5581-63a7-0585-2a73f0c0bf7d
msgctxt "hbcd30b66g8d5fg43fegab9ag07254f3b5836"
msgid "I'll make the best omelette you've ever tasted."
msgstr "한 번도 맛보지 못한 최고의 오믈렛을 만들어 볼 생각인데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Player
#. NodeID = fb8d2285-bced-ec84-71d5-df77e43c4146
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:fb8d2285-bced-ec84-71d5-df77e43c4146
msgctxt "h3b95fbacgcb5ag4539ga4b7ga427e2abbb69"
msgid ""
"You're wasting time. Give it to me now or I'll tell her <i>you're</i> the "
"weakling."
msgstr "시간낭비야. 나한테 넘기지 않으면 오히려 <i>네가</i> 약골이란 사실을 일러바쳐주지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = fcc07ccf-aff3-c000-d01f-399df906a9d3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:fcc07ccf-aff3-c000-d01f-399df906a9d3
msgctxt "he3cf734eg08a1g40f9g8486g6d782612f52d"
msgid ""
"I'll give it a while longer, and if it doesn't hatch - it will have proven "
"her right."
msgstr "난 좀 더 지켜볼 거다, 만약 부화하지 못하면, 그녀가 옳았다는 거겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = fe9a6aaf-1d7c-c81e-b919-4389b4cf7263
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:fe9a6aaf-1d7c-c81e-b919-4389b4cf7263
msgctxt "h137fbc66g6806g47c3g99d4gd69e90b8fb0a"
msgid "An <i>istik</i>? Don't make me laugh."
msgstr "<i>이스틱</i>한테? 웃기지 마라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker
#. Speaker = Varsh Ko'kuu
#. NodeID = fec2e909-751e-d155-6f6e-ee25f5ef8ca8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Caretaker:fec2e909-751e-d155-6f6e-ee25f5ef8ca8
msgctxt "h2eaa3376g856cg40e3g9d94g37509588e143"
msgid "Not an easy task. And far harder without a crèche to train it in."
msgstr "쉽진 않겠군. 더군다나 양성소에서 교육받지 않는다면 더 힘들겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Egg
#. Speaker = Player
#. NodeID = 27ff1c4b-4000-ba98-97a7-09b692abc7dd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CRE_Hatchery_State_AffectedByGas(1) = False
#.   Tag:
#.      - REALLY_GITHYANKI(1) = False
#. SetFlags:
#.   Global:
#.     - CRE_Hatchery_State_EggDestroyed = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Egg:27ff1c4b-4000-ba98-97a7-09b692abc7dd
msgctxt "h2a368ee7g8b2cg4dfegbe22g02e440229dd4"
msgid "<i>Crush the egg beneath your foot.</i>"
msgstr "<i>발로 알을 짓밟아 깨부순다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Egg
#. Speaker = Karlach
#. NodeID = 4794a176-f0d2-4539-9a24-42e4aff47261
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_KARLACH(4) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Egg:4794a176-f0d2-4539-9a24-42e4aff47261
msgctxt "hb4bda719gc570g42adgb3e6ga0e18abe4c0e"
msgid "Whoa! What in the Hells is <i>wrong </i>with you?!"
msgstr "으아! 너는 대체 <i>뭐가</i> 문제기에 이래?!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Egg
#. Speaker = Player
#. NodeID = 4d82cbe4-43ca-e2d4-49f6-096d5f810384
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Egg:4d82cbe4-43ca-e2d4-49f6-096d5f810384
msgctxt "h41631338g7e8fg47a9g8f46g626f411f2e75"
msgid "<i>Leave the egg alone.</i>"
msgstr "<i>알을 그대로 둔다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Egg
#. Speaker = Narrator
#. NodeID = 4fccd621-36c6-842b-7ec5-7be96c39e8f8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Egg:4fccd621-36c6-842b-7ec5-7be96c39e8f8
msgctxt "heefeb08cg8fbdg4c3fg9668gf3b2d4213175"
msgid "*A large green egg with an uneven shell.*"
msgstr "*껍데기가 울퉁불퉁한, 커다란 초록색의 알입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Egg
#. Speaker = Lae'zel
#. NodeID = 52e8ed97-db9d-4300-bbfd-bbcea641aba7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(2) = True
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Egg:52e8ed97-db9d-4300-bbfd-bbcea641aba7
msgctxt "h9b47d49egd32fg48b1ga234g910e958d735b"
msgid ""
"By Vlaakith's blade, what devil's got hold of you, that you'd slay an "
"unborn?!"
msgstr "블라키스의 칼날 맙소사, 그게 무슨 짓이냐, 아직 태어나지도 않은 것을 죽이다니?!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Egg
#. Speaker = Wyll
#. NodeID = 5abd5d39-18c8-4e78-bac5-e9bc8110e252
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_WYLL(6) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Egg:5abd5d39-18c8-4e78-bac5-e9bc8110e252
msgctxt "h4ba356e9g0470g4909gbe4dg2bedd493e4aa"
msgid "Damn - you showed that egg who's boss. A real hero."
msgstr "맙소사. 알한테 누가 대장인지를 똑똑히 보여주기도 했군그래. 정말이지 훌륭해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Egg
#. Speaker = Narrator
#. NodeID = 631c5aed-7658-d182-a205-0c73a2413501
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Egg:631c5aed-7658-d182-a205-0c73a2413501
msgctxt "h865d5883g32bfg43b1gaef3g69bcf5d03743"
msgid "*A fine githyanki egg. At least on the outside.*"
msgstr "*흠잡을 데 없는 기스양키 알입니다. 적어도 겉보기에는 그렇습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Egg
#. Speaker = Shadowheart
#. NodeID = 74a86729-4681-40d7-adad-c3fd259358af
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Egg:74a86729-4681-40d7-adad-c3fd259358af
msgctxt "h15fd35bbg174fg4cd6gb391gf874589f8ee6"
msgid "Hells, was that really necessary? You almost got hatchling on me."
msgstr "제길, 정말 굳이 그래야 했나? 나한테 부화체가 튈 뻔했잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Egg
#. Speaker = Narrator
#. NodeID = 8b069eda-b00a-52c6-1843-e56221990f91
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Egg:8b069eda-b00a-52c6-1843-e56221990f91
msgctxt "h5fe4e9b9g0bf6g4a30g81acg9371b515c971"
msgid "*Whatever is within is stirring ever so slightly.*"
msgstr "*알 속에 뭐가 들었는지는 몰라도 그 움직임은 아주 미약합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Egg
#. Speaker = Narrator
#. NodeID = 952eb59b-5524-81ce-999b-2fb9d72609df
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Egg:952eb59b-5524-81ce-999b-2fb9d72609df
msgctxt "h9f0c2b33g23cag49fegad2dg69d70e7011a7"
msgid ""
"*The egg is warm to the touch, the rough shell like slate beneath your "
"fingers.*"
msgstr "*알을 만지자니 따뜻함이 느껴집니다. 거친 껍데기를 어루만지니 마치 석판을 더듬는 듯합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Egg
#. Speaker = Gale
#. NodeID = 9c873827-ffd2-4563-9284-fe82ce17a7f9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_GALE(7) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Egg:9c873827-ffd2-4563-9284-fe82ce17a7f9
msgctxt "h5568f48fg92b2g4530ga5dfgedd651f4d9b1"
msgid ""
"Right then. I do understand the rule about omelets and breaking eggs, but "
"when there's more embryo than yolk involved... Well, ew."
msgstr ""
"좋아. 나도 오믈렛을 만들려면 달걀을 먼저 깨야 한다는 건 알지만, 알에 노른자가 아니라 태아가 들어있는 경우라면 이야기가 좀 "
"다르지... 으윽."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Egg
#. Speaker = Player
#. NodeID = c0512ba0-1f3b-f2fd-7981-50a228ba9ddf
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_Hatchery_State_EggTaken = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Egg:c0512ba0-1f3b-f2fd-7981-50a228ba9ddf
msgctxt "hd7226324g1fdfg4d26ga6a7g2d6fce78b053"
msgid "<i>Pick it up gingerly and stow it in your pack.</i>"
msgstr "<i>알을 조심스럽게 집어들어 배낭에 집어넣는다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Egg
#. Speaker = Narrator
#. NodeID = d03cdacd-03d9-484f-a6e7-d824b7749b23
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Egg:d03cdacd-03d9-484f-a6e7-d824b7749b23
msgctxt "h09483238g8049g4039gb0deg4d6ca3eacff0"
msgid "*You can see a vague outline of <i>something </i>within it.*"
msgstr "*알 안에는 <i>무언가의</i> 희미한 형체가 보입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Egg
#. Speaker = Astarion
#. NodeID = e5bc9829-8575-4652-879e-dd6ccdae737e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Egg:e5bc9829-8575-4652-879e-dd6ccdae737e
msgctxt "ha39dbce8gc6dag452ega9b6gee68db7fa4e4"
msgid "It's all over your foot! Oh that's disgusting."
msgstr "네 발에 찐득하게 묻어 버렸잖아! 어휴, 역겹기도 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Egg
#. Speaker = Player
#. NodeID = ef874891-6334-7fd7-a902-776bb3199cb4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Egg:ef874891-6334-7fd7-a902-776bb3199cb4
msgctxt "h5193848ag998eg43a3gbce2g574cf97a1d72"
msgid "<i>Reach out and touch the egg.</i>"
msgstr "<i>손을 뻗어 알을 만져 본다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard
#. Speaker = Warrior Vu'un
#. NodeID = 06a986f8-24de-89dc-f1ff-094346c1b531
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard:06a986f8-24de-89dc-f1ff-094346c1b531
msgctxt "h115dd69bg0236g49e9g8d8bg33e3e4342509"
msgid ""
"Hatched, mostly. Only one remains unbroken, watched over by Varsh Ko'kuu, "
"caretaker of our young."
msgstr "부화했다, 거의 다. 깨지지 않은 게 하나가 남아있긴 하다, 관리자 바시 코쿠가 지켜보고 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard
#. Speaker = Warrior Vu'un
#. NodeID = 06cd1c22-8f3c-4b35-8ed6-511152fd6ead
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard:06cd1c22-8f3c-4b35-8ed6-511152fd6ead
msgctxt "hb98f1b8fgb804g4e78g8a8fgb54d0ff95db4"
msgid ""
"Step carefully while here. Our hatchery is protected by lethal safeguards. I "
"do not wish to pick your remains from them."
msgstr "여기선 조심히 걷도록 해. 여긴 치명적인 안전장치로 보호하고 있으니까. 네 파편을 치우고 싶진 않거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard
#. Speaker = Warrior Vu'un
#. NodeID = 0a7e4d62-b62f-1f9e-9f47-8317983d43d1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard:0a7e4d62-b62f-1f9e-9f47-8317983d43d1
msgctxt "h1b190efdgb116g4a48ga231g04f45bcb373d"
msgid ""
"Traps are not built to be avoided. Varsh Ko'kuu designed every one himself, "
"elegantly crafting this room to protect our young."
msgstr "장치를 피할 방법은 없다. 바시 코쿠가 직접 설계했지, 아이들을 지키기 위해 정교하게 만들었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard
#. Speaker = Warrior Vu'un
#. NodeID = 14f31c68-fcdb-45a1-b0d3-85dda3664257
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard:14f31c68-fcdb-45a1-b0d3-85dda3664257
msgctxt "h6b694800gc582g4e5fg9756g6c55521dd611"
msgid "Amusing."
msgstr "재밌군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard
#. Speaker = Warrior Vu'un
#. NodeID = 27a36eae-3312-206a-b477-8408ca41e527
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_HatcheryGuard_KnowsAboutEggs(1) = True
#.   Object:
#.      - CRE_Hatchery_HasMet_HatcheryGuard(1) = True
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard:27a36eae-3312-206a-b477-8408ca41e527
msgctxt "hb5f5f44bg82ffg4736g9fcdg7df76a794182"
msgid "Kin."
msgstr "동포여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard
#. Speaker = Warrior Vu'un
#. NodeID = 29adffa0-3503-e74a-d3ef-40e243558eee
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_HatcheryGuard_KnowsAboutEggs(1) = False
#.   Object:
#.      - CRE_Hatchery_HasMet_HatcheryGuard(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard:29adffa0-3503-e74a-d3ef-40e243558eee
msgctxt "h56625acdg7946g4236g9089g74d8dde89f5f"
msgid "Watch your feet. Our hatchery does not treat strangers kindly."
msgstr "발 조심해. 부화장에선 외부인에게 친절하지 않거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard
#. Speaker = Player
#. NodeID = 2a0eb19a-9da7-ff21-be5a-d6bc0b5855c2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_Hatchery_HasMet_Caretaker(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard:2a0eb19a-9da7-ff21-be5a-d6bc0b5855c2
msgctxt "h337dd798ga72dg454ag87cag1c18267eb05e"
msgid "I'd like to speak to the caretaker."
msgstr "관리자와 이야기 하고 싶어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard
#. Speaker = Player
#. NodeID = 2b079ed0-d450-a543-9262-d0ba346c4f0a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard:2b079ed0-d450-a543-9262-d0ba346c4f0a
msgctxt "he369d062gad5cg4844g9c76ge24eee1de674"
msgid "You could point out the traps? I'd definitely avoid them then."
msgstr "그 장치 위치 좀 알려주겠어? 피해다니고 싶은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard
#. Speaker = Warrior Vu'un
#. NodeID = 2cc73d66-7bf1-156a-6f24-1879aa293a8e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard:2cc73d66-7bf1-156a-6f24-1879aa293a8e
msgctxt "ha165aa7cgaac6g4661g8c64gf5b7a8fb09d8"
msgid ""
"Varsh Ko'kuu designed this hatchery to be the perfect birthing place for our "
"warriors: impenetrable to our enemies."
msgstr "바쉬 코쿠가 이 곳을 우리 전사들을 위한 완벽한 부화 장소가 되도록 설계했다: 적들이 침범하지 못하게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard
#. Speaker = Warrior Vu'un
#. NodeID = 31880b0f-ebc7-a8df-7f33-86dea542f3cb
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CRE_HatcheryGuard_KnowsAboutEggs(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard:31880b0f-ebc7-a8df-7f33-86dea542f3cb
msgctxt "hd3997da4gaac8g4296g830cgbfc59a36d405"
msgid ""
"You may speak to him if you wish, but do not approach the egg. Lest you fall "
"foul of <i>me</i>."
msgstr "원한다면 그 사람이랑 이야기해 봐라, 알은 건드리지 말고. <i>나</i>에게 걸리지마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard
#. Speaker = Player
#. NodeID = 42393c41-a2bb-0225-c4f0-ae3935707250
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard:42393c41-a2bb-0225-c4f0-ae3935707250
msgctxt "h0997fbe1g61cfg45acgbb24g23dea7f00c46"
msgid "Why is the water that colour?"
msgstr "물 색깔이 왜 저렇지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard
#. Speaker = Player
#. NodeID = 4b1da6cd-e67a-14eb-c47a-1c4ee2c4b7ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard:4b1da6cd-e67a-14eb-c47a-1c4ee2c4b7ad
msgctxt "h6c8371b3g138ag46e6ga91bg5f0d8bb0bf6e"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard
#. Speaker = Warrior Vu'un
#. NodeID = 5786da10-bd53-d5e4-8c28-94d2f9b5ce01
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CRE_HatcheryGuard_KnowsAboutEggs(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard:5786da10-bd53-d5e4-8c28-94d2f9b5ce01
msgctxt "hc89c03a7geabfg4bd3gaee1g02afe80e8063"
msgid ""
"You may speak to the Varsh if you wish, but stay away from the egg. There "
"will be no second warning."
msgstr "원한다면 바쉬와 이야기해 봐라, 알에는 접근하지 말고. 경고는 한 번으로 끝이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard
#. Speaker = Player
#. NodeID = 7f333c4a-7bfd-52a6-b320-538a486f31f9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard:7f333c4a-7bfd-52a6-b320-538a486f31f9
msgctxt "hc6560443g4f93g47f2gb0fagf9a930bad7f2"
msgid "Don't worry, I'm leaving."
msgstr "걱정마, 나갈테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard
#. Speaker = Warrior Vu'un
#. NodeID = 802adb30-36c1-44a6-95b6-45f8b0092bbd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_HatcheryGuard_KnowsAboutEggs(1) = True
#.   Object:
#.      - CRE_Hatchery_HasMet_HatcheryGuard(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard:802adb30-36c1-44a6-95b6-45f8b0092bbd
msgctxt "h22cffcc6g8fdfg4c0cga4dagb7d5b8816f69"
msgid "You linger still?"
msgstr "아직도 여깄나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard
#. Speaker = Warrior Vu'un
#. NodeID = 829c65fd-ce8c-60a5-cbe1-87d6221d0479
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CRE_Hatchery_HasMet_HatcheryGuard(1) = False
#.   Tag:
#.      - GITHYANKI(1) = True
#. SetFlags:
#.   Object:
#.     - CRE_Hatchery_HasMet_HatcheryGuard(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard:829c65fd-ce8c-60a5-cbe1-87d6221d0479
msgctxt "ha7834e38gf218g4116gbfc6gcd40e3b81de0"
msgid ""
"Step carefully, kin. Our hatchery is protected by lethal safeguards - I "
"would hate to see you fall foul of them."
msgstr "발 조심해라, 동포여. 부화장엔 치명적인 안전장치들이 있다, 네가 그 장치에 걸리는 걸 보고싶진 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard
#. Speaker = Warrior Vu'un
#. NodeID = 9b184500-da53-b7cd-e2ef-6709d87c9340
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_HatcheryGuard_KnowsAboutEggs(1) = False
#.   Object:
#.      - CRE_Hatchery_HasMet_HatcheryGuard(1) = True
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard:9b184500-da53-b7cd-e2ef-6709d87c9340
msgctxt "hccc29e66g50dcg4a2fg810dgcdf42b0db615"
msgid "The hatchery is a dangerous place to linger, kin."
msgstr "부화장은 돌아다니기엔 위험한 곳이다, 동포여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard
#. Speaker = Warrior Vu'un
#. NodeID = b14301dd-60d7-371b-b53e-f5d236606035
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard:b14301dd-60d7-371b-b53e-f5d236606035
msgctxt "h5fc4f541g9f22g4eafg99adg0bb3bb67f479"
msgid "Follow the rocks through the acid, but do not approach the egg."
msgstr "산성물질 사이 징검다리를 따라가라, 알에는 접근하지 말고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard
#. Speaker = Player
#. NodeID = b27e7b50-1e27-f48e-0858-12d8c78f3edb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard:b27e7b50-1e27-f48e-0858-12d8c78f3edb
msgctxt "h1bfed990g738ag4eadg9b39g8ae90fdbae3f"
msgid "So how can I avoid these traps?"
msgstr "그럼 장치들을 피해 다니려면?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard
#. Speaker = Warrior Vu'un
#. NodeID = d35709dd-acc2-495a-afd6-5eb72de5e005
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CRE_Hatchery_HasMet_HatcheryGuard(1) = False
#. SetFlags:
#.   Object:
#.     - CRE_Hatchery_HasMet_HatcheryGuard(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard:d35709dd-acc2-495a-afd6-5eb72de5e005
msgctxt "hf757acacg787ag4c90gaccbg0dcfb60c31e4"
msgid ""
"<i>Istik </i>are permitted to view the birthing pools now? These are strange "
"times."
msgstr "<i>이스틱</i>이 부화장에 들어오는 걸 허락 받았다고? 희한한 일이군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard
#. Speaker = Player
#. NodeID = d81ef79e-980d-092c-aa2a-e1cada449d9e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard:d81ef79e-980d-092c-aa2a-e1cada449d9e
msgctxt "ha2ec6202g97bbg4ccagabb5g8489ca171e91"
msgid "Hatchery? Where are all the eggs?"
msgstr "부화장이라고? 알은 다 어디있는데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard
#. Speaker = Warrior Vu'un
#. NodeID = e16b84f3-6cd6-2ddf-4b22-5efd74b5cea5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard:e16b84f3-6cd6-2ddf-4b22-5efd74b5cea5
msgctxt "h82eb3917g8366g415bgbb1agf51807e3d60f"
msgid "And do not approach the egg! That would be a transgression too far."
msgstr "알에는 다가가지 마! 중대한 위반이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard
#. Speaker = Player
#. NodeID = e2e42f2b-7cc7-4604-9b69-a9ba77efa716
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard:e2e42f2b-7cc7-4604-9b69-a9ba77efa716
msgctxt "hc514baccge102g4007gbef7g663d68925b01"
msgid "I thought a hatchery would have more eggs?"
msgstr "부화장이라면 알이 좀 더 있어야 하지 않아?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard
#. Speaker = Warrior Vu'un
#. NodeID = ea459ec3-31bb-d13c-e513-9dcc5b11817e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard:ea459ec3-31bb-d13c-e513-9dcc5b11817e
msgctxt "he1c05cb1g4cc0g4ca6gb793ge9f3b39ea37c"
msgid ""
"Most are hatched. Only one remains, monitored by Varsh Ko'kuu, the caretaker "
"of our young."
msgstr "대부분 부화했지. 딱 하나 남았는데, 관리자 바쉬 코쿠가 지켜보고 있지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard
#. Speaker = Warrior Vu'un
#. NodeID = f59fca48-a9d1-194a-9e1e-6decab2195b9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard:f59fca48-a9d1-194a-9e1e-6decab2195b9
msgctxt "h460850f4g0e12g4c93g9188g146b75626f4f"
msgid "Water? Our young are not born to water - it is a burning acid."
msgstr "물? 아이들은 물에서 태어나는 게 아니다, 끓고 있는 산성물질이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard
#. Speaker = Warrior Vu'un
#. NodeID = fbae0fe7-c570-2695-25c1-7d3bf019269a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_Guard:fbae0fe7-c570-2695-25c1-7d3bf019269a
msgctxt "ha38f4c25g0684g4202gb63dg8e78537dc325"
msgid "You will find Varsh Ko'kuu watching over his clutch of one."
msgstr "바쉬 코쿠가 알을 하나 지키고 있을 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_NearEggWarning
#. Speaker = Varsh Ko'kuu
#. NodeID = 1e77a3a0-bb3f-26b5-a4c2-6f866d7ed1f6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_Hatchery_HasMet_Caretaker(1) = True
#.   Tag:
#.      - GITHYANKI(1) = True
#. SetFlags:
#.   Object:
#.     - CRE_Hatchery_State_SpottedNearEgg(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_NearEggWarning:1e77a3a0-bb3f-26b5-a4c2-6f866d7ed1f6
msgctxt "he511e700g5b5dg4686ga979ga6ff866a27f4"
msgid ""
"Do <i>not </i>think you can take liberties because you are kin - stay away "
"from the egg."
msgstr "단지 혈족이라는 이유만으로 마음대로 굴 수 있을 거라고는 생각지 마라 - 알에서 물러나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_NearEggWarning
#. Speaker = Varsh Ko'kuu
#. NodeID = 1f67e4f4-cb99-1b2e-83e8-4af86bfbb2b1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_Hatchery_HasMet_Caretaker(1) = True
#.   Tag:
#.      - GITHYANKI(1) = False
#. SetFlags:
#.   Object:
#.     - CRE_Hatchery_State_SpottedNearEgg(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_NearEggWarning:1f67e4f4-cb99-1b2e-83e8-4af86bfbb2b1
msgctxt "h9f80b124g2831g4ccfgb458g18eb1b78a99c"
msgid "<i>Istik</i>, I will not warn you again - get away from the egg."
msgstr "<i>이스틱</i>, 두 번 경고하지 않겠다 - 알에서 멀어져라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_NearEggWarning
#. Speaker = Varsh Ko'kuu
#. NodeID = 3dd4b3b0-4458-06e6-080c-928f67c860c3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_Hatchery_HasMet_Caretaker(1) = False
#.   Tag:
#.      - GITHYANKI(1) = True
#. SetFlags:
#.   Object:
#.     - CRE_Hatchery_State_SpottedNearEgg(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_NearEggWarning:3dd4b3b0-4458-06e6-080c-928f67c860c3
msgctxt "h4f08fc4egd607g4359g8d05g1ba4e713edb6"
msgid "It is forbidden to approach the egg, kin. You will respect our rules."
msgstr "알 가까이 가는 것은 금지되어 있다, 혈족이여. 그대라면 우리의 법도를 존중하겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_NearEggWarning
#. Speaker = Varsh Ko'kuu
#. NodeID = 72976147-f90e-ac7c-c761-ea808369d306
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_Hatchery_HasMet_Caretaker(1) = False
#.   Tag:
#.      - GITHYANKI(1) = False
#. SetFlags:
#.   Object:
#.     - CRE_Hatchery_State_SpottedNearEgg(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_NearEggWarning:72976147-f90e-ac7c-c761-ea808369d306
msgctxt "h9ffefcfcg19f7g4b5fg80d9g32bfeda649a9"
msgid "Do not approach the egg, <i>istik</i>! It is strictly forbidden."
msgstr "알에 가까이 가지 마라, <i>이스틱</i>! 그런 짓은 엄격하게 금지되어 있다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_PAD_EnteredGas
#. Speaker = Player
#. NodeID = 7dd5643f-bd27-4dd7-b60b-7e2f2cc4c02e
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_PAD_EnteredGas:7dd5643f-bd27-4dd7-b60b-7e2f2cc4c02e
msgctxt "hfc51ec38gb160g4c28g93bfg5625995eb890"
msgid "That smell is <i>rank</i>. Positively enfeebling."
msgstr "냄새 한 번 정말 <i>고약하군</i>. 확실히 쇠약해지는 기분이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_PAD_EnteredGas
#. Speaker = Player
#. NodeID = 7dd5643f-bd27-4dd7-b60b-7e2f2cc4c02e
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_PAD_EnteredGas:7dd5643f-bd27-4dd7-b60b-7e2f2cc4c02e
msgctxt "h99ff76d3g5e55g4f5dg80c0gc06c260d10bd"
msgid "That odour's left me feeling decidedly wobbly."
msgstr "저 냄새 덕분에 온몸에 힘이 쫙 빠졌어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_PAD_EnteredGas
#. Speaker = Player
#. NodeID = 7dd5643f-bd27-4dd7-b60b-7e2f2cc4c02e
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_PAD_EnteredGas:7dd5643f-bd27-4dd7-b60b-7e2f2cc4c02e
msgctxt "h1cf9fb78g7d3eg4d8dgab29g75b57cbfe584"
msgid "I don't feel so good. Weakened by stench."
msgstr "기분이 영 좋지 않아. 냄새가 너무 심해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_PAD_EnteredGas
#. Speaker = Player
#. NodeID = 7dd5643f-bd27-4dd7-b60b-7e2f2cc4c02e
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_PAD_EnteredGas:7dd5643f-bd27-4dd7-b60b-7e2f2cc4c02e
msgctxt "ha5e6e8f9g6f86g472dg9daag5211a2ecfa64"
msgid "Mm. <i>Intoxicating.</i>"
msgstr "으음. <i>유독하군.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_PAD_EnteredGas
#. Speaker = Player
#. NodeID = 7dd5643f-bd27-4dd7-b60b-7e2f2cc4c02e
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_PAD_EnteredGas:7dd5643f-bd27-4dd7-b60b-7e2f2cc4c02e
msgctxt "h1c779a0age739g4423g8b43g34dcfd1a469d"
msgid "What's that ghastly stench? I feel light-headed..."
msgstr "이 끔찍한 악취는 대체 뭐야? 현기증이 일어날 것 같아..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_PAD_EnteredGas
#. Speaker = Player
#. NodeID = 7dd5643f-bd27-4dd7-b60b-7e2f2cc4c02e
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_PAD_EnteredGas:7dd5643f-bd27-4dd7-b60b-7e2f2cc4c02e
msgctxt "h4971f820g4b04g422ag8c8bg338d049b328c"
msgid "Ugh, what's that smell? It's enough to cripple a kraken."
msgstr "으윽, 이게 대체 무슨 냄새야? 크라켄도 맥을 못 추겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_PAD_EnteredGas
#. Speaker = Player
#. NodeID = 7dd5643f-bd27-4dd7-b60b-7e2f2cc4c02e
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_PAD_EnteredGas:7dd5643f-bd27-4dd7-b60b-7e2f2cc4c02e
msgctxt "h2ff8331dg9d69g43f4g9387gf1364d489137"
msgid "I missed this smell. It is <i>invigorating</i>."
msgstr "이 냄새가 그리웠다. 참 <i>상쾌하지</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_PAD_EnteredGas
#. Speaker = Player
#. NodeID = 7dd5643f-bd27-4dd7-b60b-7e2f2cc4c02e
#. HandlePath = TaggedText[7].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_PAD_EnteredGas:7dd5643f-bd27-4dd7-b60b-7e2f2cc4c02e
msgctxt "h2494a8d7gcf5ag412cg923fgc2f69b425d82"
msgid "What is that <i>stink</i>? It's making my head spin."
msgstr "이게 대체 무슨 악취야? 머리가 핑핑 돌 것만 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_PAD_HatcheryComment
#. Speaker = Player
#. NodeID = 6b9cbc68-5c48-4d55-aeb3-16f985681d22
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_PAD_HatcheryComment:6b9cbc68-5c48-4d55-aeb3-16f985681d22
msgctxt "hb4fc1ec6ga939g4096gb51cgdcc72e7953f3"
msgid "A far cry from the Upper City hot baths, I must say."
msgstr "상부 도시에서 즐기는 따뜻한 목욕과는 천지 차이인걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_PAD_HatcheryComment
#. Speaker = Player
#. NodeID = 6b9cbc68-5c48-4d55-aeb3-16f985681d22
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_PAD_HatcheryComment:6b9cbc68-5c48-4d55-aeb3-16f985681d22
msgctxt "h17f2f0a4ga7fcg4d6cgbfecg19d9e918dade"
msgid "Entirely too empty. I'd expect to see fifteen eggs, at very least."
msgstr "거의 완전하달 정도로 텅 비어 있군. 적어도 알이 열다섯 개 정도는 있으리라고 생각했는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_PAD_HatcheryComment
#. Speaker = Player
#. NodeID = 6b9cbc68-5c48-4d55-aeb3-16f985681d22
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_PAD_HatcheryComment:6b9cbc68-5c48-4d55-aeb3-16f985681d22
msgctxt "h5538c43eg6b50g4f57g9abdg0bd851845d90"
msgid "By Mystra's mantle, what a smell. Something strange is in the air..."
msgstr "미스트라 맙소사, 냄새 한 번 지독하군. 공기에 뭔가 이상한 게 퍼져 있어..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_PAD_HatcheryComment
#. Speaker = Player
#. NodeID = 6b9cbc68-5c48-4d55-aeb3-16f985681d22
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_PAD_HatcheryComment:6b9cbc68-5c48-4d55-aeb3-16f985681d22
msgctxt "h369c2e97gdbd6g4a7eg9f93gf8fc7e47f48b"
msgid "What is this place...?"
msgstr "여긴 도대체 뭐 하는 곳이야…?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_PAD_HatcheryComment
#. Speaker = Player
#. NodeID = 6b9cbc68-5c48-4d55-aeb3-16f985681d22
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_PAD_HatcheryComment:6b9cbc68-5c48-4d55-aeb3-16f985681d22
msgctxt "hc5bbd45fg1d7ag44bbga4c3gc263dbaaf2f9"
msgid "I'm not sure what bothers me more - the smell or the humidity."
msgstr "지독한 악취랑 습기 중에 뭐가 더 거슬리는 건지 갈피를 못 잡겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_PAD_HatcheryComment
#. Speaker = Player
#. NodeID = 6b9cbc68-5c48-4d55-aeb3-16f985681d22
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_PAD_HatcheryComment:6b9cbc68-5c48-4d55-aeb3-16f985681d22
msgctxt "h73cc601eg739cg41a4gaa4fg2703c4565688"
msgid "Now that's what I call moist."
msgstr "여기 진짜 눅눅하네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_PAD_HatcheryComment
#. Speaker = Player
#. NodeID = 6b9cbc68-5c48-4d55-aeb3-16f985681d22
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_PAD_HatcheryComment:6b9cbc68-5c48-4d55-aeb3-16f985681d22
msgctxt "h13073f01g0767g4c14gba24gdb6316faf255"
msgid "What is this place...?"
msgstr "여긴 뭐 하는 곳인가...?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_PAD_HatcheryComment
#. Speaker = Player
#. NodeID = 6b9cbc68-5c48-4d55-aeb3-16f985681d22
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: REALLY_GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_PAD_HatcheryComment:6b9cbc68-5c48-4d55-aeb3-16f985681d22
msgctxt "h630af629g3402g4527g915cg2316b83c64a2"
msgid "Conditions look right, but quite empty without all the other eggs."
msgstr "환경은 괜찮아 보이는데, 다른 알이 없으니 휑한 느낌이군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_PAD_HatcheryComment
#. Speaker = Player
#. NodeID = 6b9cbc68-5c48-4d55-aeb3-16f985681d22
#. HandlePath = TaggedText[8].TagText[0]
#. TagRule: !REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_PAD_HatcheryComment:6b9cbc68-5c48-4d55-aeb3-16f985681d22
msgctxt "he3d40f9eg7ff3g404bga064g1cb9c39353e3"
msgid "Gods, it smells awful in here."
msgstr "어휴, 여기 냄새 참 끔찍하네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_TouchWarning
#. Speaker = Varsh Ko'kuu
#. NodeID = 40e59d71-741f-3530-8f57-0439bca124af
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_Hatchery_HasMet_CaretakerLastWarning(1) = False
#. SetFlags:
#.   Dialog:
#.     - CRE_Hatchery_HasMet_CaretakerLastWarning(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_TouchWarning:40e59d71-741f-3530-8f57-0439bca124af
msgctxt "h8f41adfeg90c2g4351ga9acg582dbb6aa60c"
msgid ""
"<i>Do not </i>touch the egg! This is your final warning, <i>k'chakhi</i>."
msgstr "알을 <i>만지지 마라!</i> 마지막 경고다, <i>크차키</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_TouchWarning
#. Speaker = Varsh Ko'kuu
#. NodeID = 893a53ca-9b78-2dc3-a1ce-f8608de58f39
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_Hatchery_HasMet_CaretakerLastWarning(1) = True
#. SetFlags:
#.   Global:
#.     - CRE_Hatchery_State_HatcheryHostile = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_TouchWarning:893a53ca-9b78-2dc3-a1ce-f8608de58f39
msgctxt "h078b1ddbga609g4b51g8e1fg61c62a3ca7c0"
msgid "I told you not to touch the egg - this foolishness ends here."
msgstr "분명 알을 건드리지 말라고 했을 텐데. 멍청한 짓거리는 여기서 끝이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander
#. Speaker = Karlach
#. NodeID = 014c34fe-7490-4663-9909-09d77c28e304
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_KARLACH(4) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander:014c34fe-7490-4663-9909-09d77c28e304
msgctxt "h1a566fbagffc2g4d6fgaa14g6e9e74d00c27"
msgid "Erm, I think we weren't supposed to touch anything... right?"
msgstr "음, 여기서 아무것도 만지면 안 될 거 같은데…안 그래?\n"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander
#. Speaker = Astarion
#. NodeID = 10364f1d-0e37-43b7-b4c8-3eed460fadf5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom2(5) = True
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander:10364f1d-0e37-43b7-b4c8-3eed460fadf5
msgctxt "h4ae9d6d6g931eg4d83gaaf3ga0403845dc65"
msgid ""
"I'm all for looting sacred treasure, but only if I know I'll live long "
"enough to enjoy it."
msgstr "성물을 약탈하는 건 좋지만, 내가 살아서 그걸 즐길 수 있다는 확신이 있을 때만 그렇지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander
#. Speaker = Narrator
#. NodeID = 1303f8f4-259e-fb85-c2cd-c8675d57363d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WARLOCK(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander:1303f8f4-259e-fb85-c2cd-c8675d57363d
msgctxt "he6d59a3dg3f38g4675gbf5fgd3c314974a7f"
msgid ""
"*You feel your patron's presence nearby. It hums with an unfamiliar anxiety.*"
msgstr "*당신은 당신의 후원자가 가까이에 있음을 낯설고 불안한 울림으로 느낍니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander
#. Speaker = Lae'zel
#. NodeID = 14f42ff1-3c93-406b-8610-0bef158f9cc8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom2(2) = True
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander:14f42ff1-3c93-406b-8610-0bef158f9cc8
msgctxt "h9dc8bf6egcea8g4f96g8b79gb69f4a26a902"
msgid "Step away. And banish this mace from your mind."
msgstr "물러나라. 그리고 저 메이스를 가지려는 생각도 머릿속에서 치우고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander
#. Speaker = Astarion
#. NodeID = 23c132f5-3191-4816-ad18-747dc594b6a9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander:23c132f5-3191-4816-ad18-747dc594b6a9
msgctxt "h01e0fe10g7c06g4188gbd2dg3db0a64e8cbb"
msgid "Be careful - the best cheese sits in the deadliest traps."
msgstr "조심해 - 최고의 치즈는 가장 최악의 덫에 걸려 있거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander
#. Speaker = Shadowheart
#. NodeID = 2aeb79e8-88b6-4863-a27e-f7c32489d154
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom2(3) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander:2aeb79e8-88b6-4863-a27e-f7c32489d154
msgctxt "h2ebb1398gf9beg401bga79cg71c19a27cf58"
msgid "We should leave that thing and just get out of here while we can."
msgstr "메이스는 내버려두고, 그냥 나갈 수 있을 때 나가자.\n"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander
#. Speaker = Gale
#. NodeID = 2d2876dd-dd63-4acc-8bff-a2075415b9de
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_GALE(7) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander:2d2876dd-dd63-4acc-8bff-a2075415b9de
msgctxt "hc063fd2cg2ab9g4245g9a1dgaff7126501d9"
msgid ""
"Are you quite sure that's wise? We should leave this untouched and get out "
"of here."
msgstr "그게 현명한 선택인 게 확실해? 거기에 손도 대지 않고 나가는 게 좋을 것 같은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander
#. Speaker = Narrator
#. NodeID = 312a7437-aa9f-3a88-b86c-7dbd3f624254
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: WARLOCK_FIEND
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander:312a7437-aa9f-3a88-b86c-7dbd3f624254
msgctxt "he18a349dg6395g420cg82f3g77101cb41d99"
msgid ""
"*Taking such a holy weapon would be diabolical indeed, but the "
"consequences... <i>disastrous</i>.*"
msgstr "*그런 성스러운 무기를 가져가는 것은 진정 <i>악마</i>같은 일이 틀림없지만, 그 결과는… <i>처참할 것입니다</i>.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander
#. Speaker = Narrator
#. NodeID = 312a7437-aa9f-3a88-b86c-7dbd3f624254
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: WARLOCK_ARCHFEY
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander:312a7437-aa9f-3a88-b86c-7dbd3f624254
msgctxt "h0de60326gb7d6g43cfgb0a7g2a165be63415"
msgid ""
"*Snatching a holy weapon from a godly dungeon would be mischevious indeed, "
"but the consequences... <i>disastrous</i>.*"
msgstr "*신성한 무기를 성소에서 훔치는 것은 짓궂기 그지없는 일인 게 분명하지만, 그 결과는… <i>처참할 것입니다</i>.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander
#. Speaker = Narrator
#. NodeID = 312a7437-aa9f-3a88-b86c-7dbd3f624254
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: WARLOCK_GREAT_OLD_ONE
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander:312a7437-aa9f-3a88-b86c-7dbd3f624254
msgctxt "heaae746ege385g4678gbcbfgab689ebac86d"
msgid ""
"*To take the god-weapon - to humiliate divinity - would be satisfying. But "
"it would risk <i>disastrous ruin</i>.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander
#. Speaker = Narrator
#. NodeID = 344abc98-8428-fac4-a0a3-72bea495aece
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander:344abc98-8428-fac4-a0a3-72bea495aece
msgctxt "hf31fdf41g6ffbg4412ga114gbae5bad0dfcb"
msgid "*This mace certainly has a very unusual design.*"
msgstr "*확실히 보기 드문 양식으로 만들어진 메이스라는 점은 분명합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander
#. Speaker = Player
#. NodeID = 34bc566a-0de7-608a-a563-8dbbe58c873d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = False
#. SetFlags:
#.   Object:
#.     - CRE_BloodOfLathander_Event_TakenBlood(1) = True
#.     - CRE_Lance_Event_PrepareToFire(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander:34bc566a-0de7-608a-a563-8dbbe58c873d
msgctxt "h08af96efgf982g4de1g8697g31b6a48ae1c6"
msgid "<i>Take the mace anyway - what's the worst that could happen?</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander
#. Speaker = Gale
#. NodeID = 3ea7ab37-93e5-48d8-8b4e-8a9e3c9d9b6c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom2(7) = True
#.   Tag:
#.      - REALLY_GALE(7) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander:3ea7ab37-93e5-48d8-8b4e-8a9e3c9d9b6c
msgctxt "h3af960bagde2eg4687g9f51gcd9d4d1ea646"
msgid "We should leave this untouched and get out of here."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander
#. Speaker = Wyll
#. NodeID = 4a548fec-c67d-4cb7-9e32-1ac36c6f1d07
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_WYLL(6) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander:4a548fec-c67d-4cb7-9e32-1ac36c6f1d07
msgctxt "hd5618f64g3168g4d64g848cgae3f53d73765"
msgid ""
"You sure about that? Not every glowing light is an invitation to take what's "
"inside it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander
#. Speaker = Narrator
#. NodeID = 4ceac208-41a2-52b5-2d97-6a6630441cc3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander:4ceac208-41a2-52b5-2d97-6a6630441cc3
msgctxt "h9838127eg9585g4fe2g80d6gff780b65fc0e"
msgid ""
"*An ornate mace hovers before you, suspended in a shaft of brilliant light.*"
msgstr "*찬란한 빛의 기둥에 내걸린 장식된 메이스 한 자루가 당신 앞에 떠오릅니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander
#. Speaker = Wyll
#. NodeID = 4e6496f6-ce8d-08a0-99b8-d59ba60552a9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CRE_Lance_State_CharacterArguedForSavingTheCreche(6) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander:4e6496f6-ce8d-08a0-99b8-d59ba60552a9
msgctxt "ha4ae9c24gba62g4770g8221g40568a881878"
msgid "Hells - I don't like the look of that. Run, damn it, run!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander
#. Speaker = Player
#. NodeID = 50e002e1-fe34-bd14-5544-a586f67ba3e5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander:50e002e1-fe34-bd14-5544-a586f67ba3e5
msgctxt "h8bb73605gdb31g4553g9248gc98415a73359"
msgid "<i>Reach into the light and take the mace.</i>"
msgstr "<i>빛 속으로 손을 뻗어 메이스를 가져간다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander
#. Speaker = Shadowheart
#. NodeID = 51d0e2bd-208e-4fcd-aec1-c4a7177480e3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander:51d0e2bd-208e-4fcd-aec1-c4a7177480e3
msgctxt "h36aa99b4g48b4g4c51ga73dg8cc02b5f29c1"
msgid ""
"Not one to heed warnings then? We should leave that thing - it seems like "
"trouble."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander
#. Speaker = Narrator
#. NodeID = 536cb005-cafc-2c2d-d610-0a6856e2dc1f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CRE_BloodOfLathander_Hasmet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander:536cb005-cafc-2c2d-d610-0a6856e2dc1f
msgctxt "heea0b5ceg7dc1g4ad8g8816gc9887feb5e6f"
msgid ""
"*A fist-sized piece of amber flecked with crimson is set in the handle, "
"emitting a radiance all its own.*"
msgstr "*진홍색 얼룩이 진 주먹만한 크기의 호박석이 자루 부분에 박혀 있습니다. 호박석에서는 그 자신만의 빛이 뿜어져 나옵니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander
#. Speaker = Karlach
#. NodeID = 54514469-2fe1-4c25-a4b2-4d78ea90c906
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom2(4) = True
#.   Tag:
#.      - REALLY_KARLACH(4) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander:54514469-2fe1-4c25-a4b2-4d78ea90c906
msgctxt "he4e97e7fg14b8g4074g8400gfc8dc626c0e3"
msgid "Might be better to leave it alone. No sense tempting trouble."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander
#. Speaker = Wyll
#. NodeID = 6474bc3e-3024-4e34-927f-4e6bb8d3c5c5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom2(6) = True
#.   Tag:
#.      - REALLY_WYLL(6) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander:6474bc3e-3024-4e34-927f-4e6bb8d3c5c5
msgctxt "h26a12288g48c5g4a02gbdc1gc0bab52dd86b"
msgid ""
"Leave it be. Not every glowing light is an invitation take what's inside it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander
#. Speaker = Narrator
#. NodeID = 6dbb0e06-292d-8a2d-7687-6de849d974f2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#. SetFlags:
#.   Object:
#.     - ORI_DarkUrge_Event_HadUrge(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander:6dbb0e06-292d-8a2d-7687-6de849d974f2
msgctxt "he661fae2g7e57g437ega4f8g1e66c0b4072c"
msgid ""
"*The brutal aches in your body yearn to take it, though you sense it will "
"spell misfortune.* "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander
#. Speaker = Narrator
#. NodeID = 706e02e0-4389-ffa1-b514-3ed167e7aa54
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander:706e02e0-4389-ffa1-b514-3ed167e7aa54
msgctxt "h27c1d472g3eebg4ba2gb561ga8400c24e468"
msgid ""
"*Everything is in motion - all within these walls are doomed to destruction "
"unless you act.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander
#. Speaker = Player
#. NodeID = 83774a71-f5f5-3a26-6081-22ac19953eff
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_DARK_URGE
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander:83774a71-f5f5-3a26-6081-22ac19953eff
msgctxt "heac406dbg129dg48b6ga069g2744c69e097b"
msgid "<i>Resist the call to the dark: leave the mace be.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander
#. Speaker = Player
#. NodeID = 83774a71-f5f5-3a26-6081-22ac19953eff
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander:83774a71-f5f5-3a26-6081-22ac19953eff
msgctxt "h5b89bd15ge0f6g4352gab16g48ae86e59977"
msgid "<i>Better leave the mace where it is for now.</i>"
msgstr "<i>당장은 메이스를 그대로 두는 게 낫다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander
#. Speaker = Shadowheart
#. NodeID = 8590e14d-c4c5-4eb0-8688-ae47e00070ed
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander:8590e14d-c4c5-4eb0-8688-ae47e00070ed
msgctxt "h1ee08720g40dag4922gbebdg04ed358a36ae"
msgid "Not one to heed warning then? This could end very badly.\n"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander
#. Speaker = Player
#. NodeID = 8902e1cd-c01b-0f76-32c7-3e05c5ec837d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#. SetFlags:
#.   Object:
#.     - CRE_BloodOfLathander_Event_TakenBlood(1) = True
#.     - ORI_DarkUrge_Event_IndulgedUrge(1) = True
#.     - CRE_Lance_Event_PrepareToFire(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander:8902e1cd-c01b-0f76-32c7-3e05c5ec837d
msgctxt "h3fdad0adg5c45g4d01g8044g4b54e9a1be05"
msgid "<i>Claim the mace and delight in its danger.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander
#. Speaker = Narrator
#. NodeID = 905c7491-cd19-dadb-0f6d-16cbda6be09b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#. SetFlags:
#.   Object:
#.     - ORI_DarkUrge_Event_HadUrge(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander:905c7491-cd19-dadb-0f6d-16cbda6be09b
msgctxt "h0ab3b423g1915g43a3gabd5g862844ecb6ed"
msgid "*The glow around the mace sparkles with beautiful disaster.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander
#. Speaker = Karlach
#. NodeID = a3ea9473-bb00-478f-9f62-a0f6389ed3e5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_KARLACH(4) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander:a3ea9473-bb00-478f-9f62-a0f6389ed3e5
msgctxt "ha8118f06g4966g4707gba22gba4cb85d01c7"
msgid "You sure about that, soldier? Seems risky.\n"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander
#. Speaker = Astarion
#. NodeID = b007b2e9-3420-a777-405d-eb13ebc5c598
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CRE_Lance_State_CharacterArguedForSavingTheCreche(5) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander:b007b2e9-3420-a777-405d-eb13ebc5c598
msgctxt "h3fbe7fafgabcfg4e88gafacg6c29e6ad4609"
msgid "The crèche is done for, but we're not. Run! Run damn you!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander
#. Speaker = Karlach
#. NodeID = b4cc7367-25e5-4d16-a554-7cc6d5412f45
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CRE_Lance_State_CharacterArguedForSavingTheCreche(4) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander:b4cc7367-25e5-4d16-a554-7cc6d5412f45
msgctxt "h77215a4dgc967g4c6bgb6b0gab8c454706c0"
msgid "Hang on - what's going on? Stop this, before it's too late!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander
#. Speaker = Shadowheart
#. NodeID = b55c0872-9f99-259c-70d6-a80da14c8683
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CRE_Lance_State_CharacterArguedForSavingTheCreche(3) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander:b55c0872-9f99-259c-70d6-a80da14c8683
msgctxt "hd89faff5ge245g44a8g80adgd2860cd24904"
msgid "I think this crèche's days are numbered - let's get out of here."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander
#. Speaker = Astarion
#. NodeID = b8fb2b62-063d-4fde-8ff9-7d50c9209bd4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander:b8fb2b62-063d-4fde-8ff9-7d50c9209bd4
msgctxt "h08319efegd4aeg4f9cg8ef7g17542c7b4a0c"
msgid "Are you sure about that? This all feels very... trappy."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander
#. Speaker = Player
#. NodeID = bd6c3646-c19e-1400-3250-a59f10a2c97f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander:bd6c3646-c19e-1400-3250-a59f10a2c97f
msgctxt "h8a5d4009g908dg4554g8870g376fbdac13a6"
msgid "<i>Leave the mace where it is.</i>"
msgstr "<i>메이스를 그대로 둔다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander
#. Speaker = Narrator
#. NodeID = c6678426-5795-b87d-82d8-0a6afb948288
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander:c6678426-5795-b87d-82d8-0a6afb948288
msgctxt "hfa1f00dfg7e4ag407agb4eeg17969a396883"
msgid ""
"*This mace must be the legendary Blood of Lathander - the amber is said to "
"contain the blood of the Morninglord himself.*"
msgstr ""
"*이 메이스는 전설적인 라샌더의 피가 분명합니다. 그 이름대로 메이스 속 호박에는 진짜 아침의 군주의 피가 담겨 있다고 합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander
#. Speaker = Gale
#. NodeID = ca510df4-f966-4f95-add8-e2e79771a746
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_GALE(7) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander:ca510df4-f966-4f95-add8-e2e79771a746
msgctxt "hd77147e4g0df8g4642ga241ged39d1a426a4"
msgid "Are you quite sure that's wise?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander
#. Speaker = Wyll
#. NodeID = d49d72fe-a63d-4049-849b-d6b701b54f8c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_WYLL(6) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander:d49d72fe-a63d-4049-849b-d6b701b54f8c
msgctxt "hfac988e9gf96eg46d0gabe5g7425e6787f3e"
msgid ""
"You heard the warnings. Are you sure you want to stick your hand where it "
"wasn't invited?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander
#. Speaker = Lae'zel
#. NodeID = d7b82c14-d0c6-42b0-b971-b682dee1ffe7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(2) = True
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander:d7b82c14-d0c6-42b0-b971-b682dee1ffe7
msgctxt "h53791431g7193g48bfg9e4dgde9be7c995d5"
msgid "Stay your hand! The consequences may be more than we are ready to bear."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander
#. Speaker = Narrator
#. NodeID = e3bf2659-3e97-39b5-e449-f6d7e404c68c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_BloodOfLathander_Hasmet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander:e3bf2659-3e97-39b5-e449-f6d7e404c68c
msgctxt "hc5341e84ga749g47a5ga5a3gcdf334e4354f"
msgid "*You stand before the mysterious mace once more.*"
msgstr "*당신은 신비한 메이스 앞에 다시 섭니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander
#. Speaker = Narrator
#. NodeID = e5b050e5-77b4-73eb-dc6a-515d90f697a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander:e5b050e5-77b4-73eb-dc6a-515d90f697a6
msgctxt "ha0369788gb5d3g4d6cg9a37g09fc346af0eb"
msgid "*Taking this mace would surely lead to something quite disastrous.*"
msgstr "*메이스를 가져가는 것은 상당한 재앙을 초래할 것이 분명합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander
#. Speaker = Narrator
#. NodeID = eaae7806-09fb-0460-a2c3-63ee4ffe4f5f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander:eaae7806-09fb-0460-a2c3-63ee4ffe4f5f
msgctxt "hbd8f4838g2fcdg4a9ag8724gab911d433b33"
msgid ""
"*You recall all the measures meant to keep you from reaching this place.*"
msgstr "*당신은 이곳에 접근을 막기 위한 모든 수단을 떠올립니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander
#. Speaker = Lae'zel
#. NodeID = ee30f7af-b28a-4db6-9833-fd237efc0848
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(2) = True
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander:ee30f7af-b28a-4db6-9833-fd237efc0848
msgctxt "h63d82825g33e1g431cg88e0g057355249a8f"
msgid "Stay your hand! The consequences may be more than we are ready to bear."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander
#. Speaker = Lae'zel
#. NodeID = fe18a2c8-a12b-4aed-8542-2abe7823dcf9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CRE_Lance_State_CharacterArguedForSavingTheCreche(2) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander:fe18a2c8-a12b-4aed-8542-2abe7823dcf9
msgctxt "h7d3d69d4gcd7fg4068g9754g5eef58caba53"
msgid ""
"<i>Tsk'va</i> - what have you done? Shut it down before the crèche is made "
"rubble!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander_PAD_FakeBloodPickedUp
#. Speaker = Player
#. NodeID = 284ec5dc-5018-4162-8ef6-5dead03c41ac
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander_PAD_FakeBloodPickedUp:284ec5dc-5018-4162-8ef6-5dead03c41ac
msgctxt "h50ce826bge303g462fga5d6ge8db9ca89e3e"
msgid "This is an ancient holy relic? It doesn't feel that ancient. Or holy."
msgstr "이게 고대의 성물이라고? 오래되지도 신성해 보이지도 않는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander_PAD_FakeBloodPickedUp
#. Speaker = Player
#. NodeID = 284ec5dc-5018-4162-8ef6-5dead03c41ac
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander_PAD_FakeBloodPickedUp:284ec5dc-5018-4162-8ef6-5dead03c41ac
msgctxt "h6b1b930bgdf75g4aaegae64g5def6320fc39"
msgid "Hmm. Seems a touch... underwhelming."
msgstr "음. 좀... 실망스러워 보이네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander_PAD_FakeBloodPickedUp
#. Speaker = Player
#. NodeID = 284ec5dc-5018-4162-8ef6-5dead03c41ac
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander_PAD_FakeBloodPickedUp:284ec5dc-5018-4162-8ef6-5dead03c41ac
msgctxt "h6a05191egbb77g4463g9275g431043a96ddf"
msgid "This can't be the blood of Lathander, can it? It's a bit... eh."
msgstr "이게 정말 라샌더의 피라고? 좀... 음."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander_PAD_FakeBloodPickedUp
#. Speaker = Player
#. NodeID = 284ec5dc-5018-4162-8ef6-5dead03c41ac
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander_PAD_FakeBloodPickedUp:284ec5dc-5018-4162-8ef6-5dead03c41ac
msgctxt "h2b4726a8g0766g452fg8146g42b88aa83029"
msgid "The Blood of Lathander. Hardly impressive as relics go."
msgstr "라샌더의 피. 성물치고는 별로 인상적이진 않군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander_PAD_FakeBloodPickedUp
#. Speaker = Player
#. NodeID = 284ec5dc-5018-4162-8ef6-5dead03c41ac
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander_PAD_FakeBloodPickedUp:284ec5dc-5018-4162-8ef6-5dead03c41ac
msgctxt "h91ae237aga45bg4c31gb000g7dc3923d064e"
msgid "Is this the Blood of Lathander? A bit underwhelming, for a relic."
msgstr "이게 라샌더의 피라고? 성물 치고는 좀 실망스럽네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander_PAD_FakeBloodPickedUp
#. Speaker = Player
#. NodeID = 284ec5dc-5018-4162-8ef6-5dead03c41ac
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander_PAD_FakeBloodPickedUp:284ec5dc-5018-4162-8ef6-5dead03c41ac
msgctxt "h401dac4dg23b8g44ddg8860g2bcc7ccded26"
msgid ""
"So <i>this</i> is what passes as a holy relic? I expected a little more "
"drama, honestly."
msgstr "<i>이게</i> 성물이라고? 솔직히, 난 좀 더 극적인 걸 기대했는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander_PAD_FakeBloodPickedUp
#. Speaker = Player
#. NodeID = 284ec5dc-5018-4162-8ef6-5dead03c41ac
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_BloodOfLathander_PAD_FakeBloodPickedUp:284ec5dc-5018-4162-8ef6-5dead03c41ac
msgctxt "h61b046fbg26dfg4876g8b95gdf9f53ae090d"
msgid "Is this it? Seems a little underwhelming for a holy relic."
msgstr "이게 다야? 성스러운 유물이라기엔 실망스러운걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Brewery_AD_Combat_Kobold3FirstTurn
#. Speaker = Kobold Inventor
#. NodeID = 0bb87086-f40b-499d-bcbc-9e4d5fbb2e20
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Brewery_AD_Combat_Kobold3FirstTurn:0bb87086-f40b-499d-bcbc-9e4d5fbb2e20
msgctxt "h63fdd250g7c58g4b92g975dg61320c05f61e"
msgid "Time to - *hic* - scrap!"
msgstr "박살 낼 - *딸꾹* - 시간이다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Brewery_AD_Combat_PlayerFirstTurn
#. Speaker = Player
#. NodeID = 0fe4cc5b-2e99-483a-a512-d507d3dab69b
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Brewery_AD_Combat_PlayerFirstTurn:0fe4cc5b-2e99-483a-a512-d507d3dab69b
msgctxt "hc59735a3g1784g40dcg92fdgf7cd85be85dc"
msgid "This place reeks of alcohol - best watch my fire. Or not..."
msgstr "알코올 냄새가 진동 하는군. 불을 조심해야겠어. 그렇지 않으면..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Brewery_AD_Combat_PlayerFirstTurn
#. Speaker = Player
#. NodeID = 0fe4cc5b-2e99-483a-a512-d507d3dab69b
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Brewery_AD_Combat_PlayerFirstTurn:0fe4cc5b-2e99-483a-a512-d507d3dab69b
msgctxt "he3d9c707ga265g4e0eg99c0g5664ee680b15"
msgid "The kobold reeks of liquor. This is no time go to playing with fire."
msgstr "코볼트에게서 알코올 냄새가 진동하는군. 지금은 불을 쓰지 않는 게 좋겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Brewery_AD_Combat_PlayerFirstTurn
#. Speaker = Player
#. NodeID = 0fe4cc5b-2e99-483a-a512-d507d3dab69b
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Brewery_AD_Combat_PlayerFirstTurn:0fe4cc5b-2e99-483a-a512-d507d3dab69b
msgctxt "hb739e7edgc44eg4b55ga44cgddc223b55965"
msgid ""
"I can smell the alcohol on their breath from here. Drunk and flammable - "
"what a combination."
msgstr "입에서 나는 알코올 냄새가 여기까지 닿다니. 취한 데다 불타기 쉽기까지 하다니- 완벽한 조합이네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Brewery_AD_Combat_PlayerFirstTurn
#. Speaker = Player
#. NodeID = 0fe4cc5b-2e99-483a-a512-d507d3dab69b
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Brewery_AD_Combat_PlayerFirstTurn:0fe4cc5b-2e99-483a-a512-d507d3dab69b
msgctxt "hf65da5ebgdc6fg4ea8g8421gb28e399fe84b"
msgid ""
"That smell - I recognise that vintage. Those Kobolds are three sheets to the "
"wind."
msgstr "저 냄새 - 어떤 포도주인지 알겠어. 코볼트 녀석들 완전히 취해 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Brewery_AD_Combat_PlayerFirstTurn
#. Speaker = Player
#. NodeID = 0fe4cc5b-2e99-483a-a512-d507d3dab69b
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Brewery_AD_Combat_PlayerFirstTurn:0fe4cc5b-2e99-483a-a512-d507d3dab69b
msgctxt "h7840884bg3a3cg4d57g8d57g441917f9e9c9"
msgid ""
"That kobold smells like it's been swimming in wine. One spark, and things "
"could get... heated."
msgstr "코볼트 놈들, 마치 포도주 안에서 수영이라도 한 것 같은 냄새를 풍기고 있어. 작은 불씨만 있어도... 난리가 나겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Brewery_AD_Combat_PlayerFirstTurn
#. Speaker = Player
#. NodeID = 0fe4cc5b-2e99-483a-a512-d507d3dab69b
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Brewery_AD_Combat_PlayerFirstTurn:0fe4cc5b-2e99-483a-a512-d507d3dab69b
msgctxt "hd2ade1f5g5026g4b3eg9aa3g087b674d7f9f"
msgid "That kobold smells like a keg of spirits. Flammable, that."
msgstr "코볼트 한테서 증류주 통 냄새가 진동을 하고 있어. 불에 잘 타겠는걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Brewery_AD_Combat_PlayerFirstTurn
#. Speaker = Player
#. NodeID = 0fe4cc5b-2e99-483a-a512-d507d3dab69b
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Brewery_AD_Combat_PlayerFirstTurn:0fe4cc5b-2e99-483a-a512-d507d3dab69b
msgctxt "hdbdefc73gd71dg4172ga4d3g8784ee443737"
msgid "These kobolds have had a skinful - their scent precedes them."
msgstr "저 코볼트 녀석들 실컷 마신 모양이군 - 냄새만 맡아도 알겠소."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Brewery_AD_Combat_PlayerFirstTurn
#. Speaker = Player
#. NodeID = 0fe4cc5b-2e99-483a-a512-d507d3dab69b
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: !REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Brewery_AD_Combat_PlayerFirstTurn:0fe4cc5b-2e99-483a-a512-d507d3dab69b
msgctxt "h6469715fgf241g43a9ga540g2dfe97a45c00"
msgid "That kobold reeks of spirits. Fire could be explosive."
msgstr "코볼트 에게서 술 냄새가 진동하고 있어. 불이 붙으면 폭발할지도 몰라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Brewery_AD_DrunkCheering
#. Speaker = Kobold Looter
#. NodeID = 00e9f694-3275-4e72-93ee-3852d62e97bb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Brewery_AD_DrunkCheering:00e9f694-3275-4e72-93ee-3852d62e97bb
msgctxt "hf4a340d4g315cg4b0cgbcc1ge877e2441e66"
msgid "Pissed up the wall then forgot his name!"
msgstr "벽에 오줌을 싸고 그 남자의 이름을 잊었다네!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Brewery_AD_DrunkCheering
#. Speaker = Kobold Looter
#. NodeID = 00ecdea1-d7aa-478e-913a-bb85cabde1ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Brewery_AD_DrunkCheering:00ecdea1-d7aa-478e-913a-bb85cabde1ad
msgctxt "h175e6bd0g95e3g40c7ga111g11f39c30bda3"
msgid "A pint of... wine?"
msgstr "와인... 한 잔?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Brewery_AD_DrunkCheering
#. Speaker = Kobold Scout
#. NodeID = 02f558cc-f419-4c61-ab44-2adc29060e38
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Brewery_AD_DrunkCheering:02f558cc-f419-4c61-ab44-2adc29060e38
msgctxt "h0561ec14gce82g4c7eg8567g3a34bf5ed4b8"
msgid "Have some more wine, that'll sort you. Hair of the worg an' all that."
msgstr "와인을 더 마시면 해결 될 거야. 위그 털도 같이 먹고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Brewery_AD_DrunkCheering
#. Speaker = Kobold Looter
#. NodeID = 1bf46ecb-ef70-46c7-b08b-0ffa5ea76245
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Brewery_AD_DrunkCheering:1bf46ecb-ef70-46c7-b08b-0ffa5ea76245
msgctxt "hf378b536g6601g4565g8214g6ba0bf6c55ee"
msgid "Hey-eye-diddle-eye-aye!"
msgstr "헤에-아이-디들리-야아-예에!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Brewery_AD_DrunkCheering
#. Speaker = Kobold Scout
#. NodeID = 21cb2985-2466-4c72-84ee-71d267ae8d52
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Brewery_AD_DrunkCheering:21cb2985-2466-4c72-84ee-71d267ae8d52
msgctxt "he9393540gc941g49eeg8e13g908bdb10be9b"
msgid "Aw, don't be sick, Kev, please don't be sick again..."
msgstr "으으, 그만 좀 아파라, 케브, 제발 그만좀 아프라고..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Brewery_AD_DrunkCheering
#. Speaker = Kobold Looter
#. NodeID = 3aa68adc-bd35-4562-bc81-a81a6a1d9167
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Brewery_AD_DrunkCheering:3aa68adc-bd35-4562-bc81-a81a6a1d9167
msgctxt "h5c0d2ff2g4fbdg4fc4g860eg868bf063adab"
msgid "Baz... I think I burned my tongue... All I taste is <i>bad</i>..."
msgstr "바즈... 내 혀가 타버린 것 같아... <i>이상한</i> 맛밖에 안나..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Brewery_AD_DrunkCheering
#. Speaker = Kobold Scout
#. NodeID = 458c86ce-77ec-4feb-928b-6893d444910d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Brewery_AD_DrunkCheering:458c86ce-77ec-4feb-928b-6893d444910d
msgctxt "h04a68e0dgb82ag4a0dg946cga4f10f9578e7"
msgid "Kobold drank twice, set his belly aflame!"
msgstr "코볼트가 두 잔을 마시더니 뱃속이 불타올랐다네!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Brewery_AD_DrunkCheering
#. Speaker = Kobold Looter
#. NodeID = 49249c6f-c02f-4091-b39d-688556aa7659
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 682b3be8-9a22-72e1-805a-fcdf25a2c7ad_A = True
