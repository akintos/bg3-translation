msgctxt "ha6f69432g5097g4afbg9f28g6acbfc6fa640"
msgid "Hear us, Absolute. <i>Rhaal'tuuch!</i>"
msgstr "저희를 들어주소서, 절대자시여. <i>라아알'투우치!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinKing_AD_KingBeforeScrying
