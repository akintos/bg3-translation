msgctxt "h5da6cafagfd0fg45b0g85d7g43ee7a2c115f"
msgid "Why'd you take it? We were just playing!"
msgstr "왜 그걸 뺏어가는데? 우린 그냥 놀고 있었다고!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_MageHandKids_AD_PlayerExpelledFromGame
