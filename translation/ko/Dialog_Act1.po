msgctxt "h4b816193g1088g45d9g9934g10068dea0b44"
msgid "Thank you. Thank you!"
msgstr "고마워. 고마워!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Player
#. NodeID = ad94e628-4d29-42c5-0e74-1fec1295b4cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter:ad94e628-4d29-42c5-0e74-1fec1295b4cf
msgctxt "h0e46c6c6g0aa4g4dcfgb2cdg515b5c333b30"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Player
#. NodeID = aea71de3-836b-569b-62d2-713b582b83b7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter:aea71de3-836b-569b-62d2-713b582b83b7
msgctxt "h980b98c5gdae5g4b83g9cfagbf513a089c12"
msgid "How did you get trapped to begin with?"
msgstr "어쩌다 갇혔던 겁니까?"

