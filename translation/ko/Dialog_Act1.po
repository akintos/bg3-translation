msgctxt "h89998e93g0ed2g4394gb1fdg83ff3324c114"
msgid "<i>Conjure tranquil memories in hopes of calming the sovereign.</i>"
msgstr "<i>군주를 진정시키기 위해 평온한 기억을 떠올린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Player
#. NodeID = 45c96d9a-5915-e851-5b0d-002d70531f78
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidSovereign_State_PlayerSawResurrection = True
#.      - UND_MyconidSovereign_Event_ResurrectedDead = False
#.   Tag:
#.      - CLERIC(1) = False
#.      - REALLY_UNDERDARK(1) = True
#.      - PALADIN(1) = False
#.      - BARD(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:45c96d9a-5915-e851-5b0d-002d70531f78
msgctxt "h174f4effg8759g48e8g9ed1gc95141785825"
msgid "You planted animating spores in the corpse, yes?"
msgstr "당신이 시체들에 살아있는 포자를 심었지, 맞나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Player
#. NodeID = 46eb5c4f-3842-44ce-15b6-9051c3b66e85
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_InjuredGnome_State_SporeServant = False
#.      - UND_InjuredGnome_State_DeadFromPoison = False
#.      - UND_InjuredGnome_State_WasPermaDefeated = False
#.      - UND_MyconidCircle_Event_AskedAboutDuergar = True
#.      - UND_MyconidCircle_Event_AskedAboutFugitive = False
#. SetFlags:
#.   Global:
#.     - UND_MyconidCircle_Event_AskedAboutFugitive = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:46eb5c4f-3842-44ce-15b6-9051c3b66e85
msgctxt "h594e1d9fg5123g4e5eg9efbga28ca2672f0a"
msgid "You harbour a fugitive gnome? Admirable of you."
msgstr "도망자 노움을 받아들여줬다고? 존경스럽군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Karlach
#. NodeID = 4b3d1f04-a5ab-49df-a390-6e4bfe4a76bd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_KARLACH(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:4b3d1f04-a5ab-49df-a390-6e4bfe4a76bd
msgctxt "h494a8838gc6a7g4a35g9b05g3d208dcbe358"
msgid ""
"Duergar invaders, huh? I'd like to hear their side of the story first, but "
"all right."
msgstr "듀에르가 침입자들? 그쪽 이야기를 먼저 들어보고 싶지만 뭐, 좋아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Lae'zel
#. NodeID = 503b6b00-18ec-4dc1-8a42-4e2680e0c4d5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_LAEZEL(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:503b6b00-18ec-4dc1-8a42-4e2680e0c4d5
msgctxt "hb7beb46agdc09g434eg94bcg2084072fa0d5"
msgid "Let us spill blood. Duergar or myconid - I care not which."
msgstr "피를 쏟아내자. 그게 듀에르가든 마이코니드든 상관없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Player
#. NodeID = 513fafce-9501-13cb-90a4-31ad94e2091c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_AcceptedQuest = False
#.      - UND_MyconidCircle_Quest_LoneDuergar_Defeated = False
#. SetFlags:
#.   Global:
#.     - UND_MyconidCircle_AcceptedQuest = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:513fafce-9501-13cb-90a4-31ad94e2091c
msgctxt "h00d9b69bg4134g4e37g8c8fg1ae7f01e99b5"
msgid "I'll cleanse the rot. Those duergar near the lake will die."
msgstr "내가 부패를 정화하지. 호수 근처의 듀에르가들은 모두 죽을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Player
#. NodeID = 524d1226-cc86-9dce-b8f7-2a2f478b92e5
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 20
#. CheckFlags:
#.   Tag:
#.      - BERSERKER(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:524d1226-cc86-9dce-b8f7-2a2f478b92e5
msgctxt "h1c4d12a2gc3ebg4d3fga341g71f22965cb96"
msgid "<b><i>ROAR.</i></b>"
msgstr "<b><i>크아아.</i></b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Sovereign Spaw
#. NodeID = 52ea4f9f-1626-e784-98d6-495c80222a27
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:52ea4f9f-1626-e784-98d6-495c80222a27
msgctxt "h097f87b8g2cfcg41dagb15egcb2237800911"
msgid "((*the dead make a fine host for my growing children*))"
msgstr "((*죽은 자는 자라나는 아이들에게 좋은 숙주가 된다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Player
#. NodeID = 579d49fa-e30c-a7d4-0545-e42e250ee06c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_Event_AskedAboutDuergar = False
#. SetFlags:
#.   Global:
#.     - UND_MyconidCircle_Event_AskedAboutDuergar = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:579d49fa-e30c-a7d4-0545-e42e250ee06c
msgctxt "h88fdfe15g3d22g44d0ga87fge193aa67c5c3"
msgid "Why did these duergar attack you?"
msgstr "이 듀에르가들이 당신을 왜 공격한 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Player
#. NodeID = 57f3dc07-10d0-80b6-1028-bd2533105197
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_BroodingSovereign_State_AskedCircle = True
#.      - UND_BroodingSovereign_State_RefusedCircle = False
#.      - UND_MyconidCircle_BroodingSovereign_State_PermaDefeated = False
#.   Script:
#.      - GEN_IsSpeakerPresent_11 = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:57f3dc07-10d0-80b6-1028-bd2533105197
msgctxt "h96eec313gdd32g4201g84f8g4ccb58876a16"
msgid ""
"You named me poorly, Spaw. Glut is sovereign now - and I bring you death."
msgstr "이름 잘못 지었어, 스포. 이제 글럿이 새 군주다. 넌 죽을 거고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Narrator
#. NodeID = 58d1decc-2a2a-c424-f107-29e21c2b771d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:58d1decc-2a2a-c424-f107-29e21c2b771d
msgctxt "ha7fa6583g4f98g4141g9becg13b090254b07"
msgid ""
"*In your mind's eye, Spaw shows you a drow, striding among myconid dead.*"
msgstr "*스포가 마음의 눈을 통해 마이코니드 시체 사이를 거니는 드로우 한 명을 보여줍니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Player
#. NodeID = 5a4dfeee-69a2-c4b8-9fd4-336776189aaf
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BERSERKER(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:5a4dfeee-69a2-c4b8-9fd4-336776189aaf
msgctxt "h21b633dfg7d19g4733g8c2fgeec8bb65aab2"
msgid "THREATEN ME AGAIN. I <b>DARE</b> YOU."
msgstr "<b>다시 날 협박해 보시지. 어디 한번 보자고</b>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Sovereign Glut
#. NodeID = 5c881a33-bddd-3d14-dee4-dc2391522122
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_MyconidCircle_Event_BetraySpaw = True
#.     - UND_MyconidCircle_State_Hostile = True
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:5c881a33-bddd-3d14-dee4-dc2391522122
msgctxt "ha4ca9fdcgb807g4ba8gae9dg60745a1f2f49"
msgid ""
"((*I will scatter you throughout the dark places, Spaw. your corpse will "
"never know <b>home</b>*))"
msgstr "((*널 조각 내서 온 세상 사악한 곳에 흩뿌려주마, 스포. 네 시체는 다시는 <b>고향</b>을 못 보겠지.*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Sovereign Spaw
#. NodeID = 60f3a5d6-ddd4-6dc2-ca17-944c03613445
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_MyconidCircle_State_OfferedQuest = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:60f3a5d6-ddd4-6dc2-ca17-944c03613445
msgctxt "he7db55d1g8644g4834ga89bgd64a7ba3e704"
msgid ""
"((*I sense your resolve. you will find <b>duergar invaders </b>near lake's "
"edge. cleanse the Rot. <i>destroy them</i>*))"
msgstr ""
"((*너에게 결의가 느껴진다. 호숫가 근처에서 듀에르가 침입자들을 발견할 수 있을 것이다. 썩은 것을 정화하라. <i>그들을 "
"파괴하라</i>*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Narrator
#. NodeID = 6214e85a-47e2-e20a-72fd-35fcfeb2cde7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_State_GainedAccess = False
#.   Object:
#.      - UND_MyconidCircle_DuergarInParty(1) = False
#. SetFlags:
#.   Global:
#.     - UND_MyconidCircle_SpokeWithSovereign = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:6214e85a-47e2-e20a-72fd-35fcfeb2cde7
msgctxt "h6bc01461g36dag48f6g98f5gcd1cb8a351db"
msgid ""
"*Hums. Clicks. Harmonies. They drift through you like an unknown language.*"
msgstr "*웅얼거림. 딸깍하는 소리. 하모니. 그들은 당신을 통해 알 수 없는 언어처럼 흘러갑니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Sovereign Spaw
#. NodeID = 6482161f-9006-dd43-1d2f-d240f2293981
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_BroodingSovereign_Event_BetrayGlut = True
#.      - UND_MyconidSovereign_State_SaidKilledGlut = False
#.      - UND_MyconidCircle_BroodingSovereign_State_PermaDefeated = True
#. SetFlags:
#.   Global:
#.     - UND_MyconidSovereign_State_SaidKilledGlut = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:6482161f-9006-dd43-1d2f-d240f2293981
msgctxt "habe5892eg7e1bg4e88ga2b7gb7c1366552d2"
msgid "((*Glut's song had grown sour and stifling. it was a mercy to end it*))"
msgstr "((*글럿의 노래는 분노에 차 억눌려 있었다. 끝내 주는 것이 자비였다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Narrator
#. NodeID = 68481166-a17a-04fe-a941-8ef9a9e03120
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:68481166-a17a-04fe-a941-8ef9a9e03120
msgctxt "h798bfa52geff7g4cffgadb2g10c3e5961eaf"
msgid ""
"*Deep purples swirl into familiar shapes: gnomes in mining gear chased by "
"duergar.*"
msgstr "* 짙은 보라색이 소용돌이치며 익숙한 모양으로 변합니다: 채굴 장비를 한 노움이 듀에르가에게 쫓기고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Sovereign Glut
#. NodeID = 6897d218-b72a-8d31-7329-0924c3abbd27
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_MyconidCircle_BroodingSovereign_Event_BetrayGlut = True
#.     - UND_BroodingSovereign_State_RefusedCircle = True
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(8) = True
#.   Quest:
#.     - UND_BroodingSovereign.RefusedCircle(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:6897d218-b72a-8d31-7329-0924c3abbd27
msgctxt "he5df1810g18beg4b9ag99acge45541c797d1"
msgid ""
"((*<b>traitor</b>. your corpse will know no rest. you will rise only to "
"<b>die again</b>*))"
msgstr "((*<b>배신자</b>. 넌 죽어서도 쉬지 못할 것이다. 되살아나서도 <b>다시 죽게</b> 될 것이야*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Narrator
#. NodeID = 6bba5390-5671-3a67-e680-43460cb5ca52
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_MyconidCircle_State_GainedAccess = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:6bba5390-5671-3a67-e680-43460cb5ca52
msgctxt "h0ae878b9gde0ag4727g86fcg504ce70a0f4a"
msgid "*Fungal roots weave through your mind, seeking your true intent.*"
msgstr "*포자 뿌리들이 당신 내면을 휘저으며 속마음을 알아내려 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Shadowheart
#. NodeID = 6c604a7c-39db-4057-8e8b-5dbb84ae342a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(2) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:6c604a7c-39db-4057-8e8b-5dbb84ae342a
msgctxt "h55d5944egfea3g403cg8592g0f9185fb076b"
msgid ""
"Duergar invaders? We can manage that - better than picking <i>this</i> "
"fight, surely."
msgstr "듀에르가 침입자라고? 그 정도라면 해결할 수 있겠네, 분명, <i>이들과</i> 싸우는 것보다는 나을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Narrator
#. NodeID = 6d9f2ede-b14c-6794-de9a-9b32bdb201d2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:6d9f2ede-b14c-6794-de9a-9b32bdb201d2
msgctxt "h24c06237gddd5g46e3ga2eeg1fd9a388b959"
msgid "*...<i>strangling</i> you.*"
msgstr "*...당신의 <i>목을 조이고 있습니다</i> .*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Player
#. NodeID = 6e28907c-56c4-4f5c-438c-a812e0b03f74
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#. SetFlags:
#.   Global:
#.     - UND_MyconidCircle_AcceptedQuest = True
#. TagRule: PALADIN_ANCIENTS
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:6e28907c-56c4-4f5c-438c-a812e0b03f74
msgctxt "ha73c2f62gd460g4f5fga78fg29f829e6b5d9"
msgid "I will cleanse the rot. I will visit nature's wrath upon them."
msgstr "내가 부패를 정화하겠어. 그들에게 자연의 분노를 보여주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Player
#. NodeID = 6e28907c-56c4-4f5c-438c-a812e0b03f74
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#. SetFlags:
#.   Global:
#.     - UND_MyconidCircle_AcceptedQuest = True
#. TagRule: PALADIN_DEVOTION
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:6e28907c-56c4-4f5c-438c-a812e0b03f74
msgctxt "h69072e72geb0fg4b73ga77bg9861c2edb3b1"
msgid "They killed your young. I won't let them get away with an evil so base."
msgstr "놈들이 당신네 젊은이들을 죽였어. 그렇게 비열한 악행을 해놓고 떠나게 두지 않겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Player
#. NodeID = 6e28907c-56c4-4f5c-438c-a812e0b03f74
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#. SetFlags:
#.   Global:
#.     - UND_MyconidCircle_AcceptedQuest = True
#. TagRule: PALADIN_VENGEANCE and NOT_FOR_EA
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:6e28907c-56c4-4f5c-438c-a812e0b03f74
msgctxt "hd380b0e1g3b70g401aga9cbg52a1c6dfce7d"
msgid ""
"They betrayed you by breaking the peace. I will break their bodies for you."
msgstr "그들은 평화를 깨는 것으로 당신을 배신했어. 당신을 위해 그들의 신체를 부러트리겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Narrator
#. NodeID = 6e7cba28-c7ca-5fc5-e881-ae9d0c87d026
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_MyconidSovereignReward = False
#. SetFlags:
#.   Global:
#.     - UND_MyconidCircle_SpokeWithSovereign = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:6e7cba28-c7ca-5fc5-e881-ae9d0c87d026
msgctxt "h7f7ba61fg0e31g4d72ga399g3a2c32b90690"
msgid "*It greets you with a harrowing elegy, cheerless as the new moon.*"
msgstr "*초승달처럼 생기 없는 모습의 군주는 슬픈 애도로 당신을 맞이합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Sovereign Spaw
#. NodeID = 6eef6d2a-4521-df56-6c29-3d3f20282201
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:6eef6d2a-4521-df56-6c29-3d3f20282201
msgctxt "hb3b12566gaaa3g4ecfgbc10g7aacf86b6218"
msgid ""
"((*but before this, I have another boon to ask of you. you have cut out the "
"duergar blight - but not its source*))"
msgstr "((*하지만 가기 전에, 너에게 다른 요청이 있다. 네가 듀에르가 역병을 없애줬지만, 아직 그 근원이 있다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Player
#. NodeID = 727ba127-d34b-1ebe-3870-ccdee4f5c9f9
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. TagRule: REALLY_DUERGARDWARF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:727ba127-d34b-1ebe-3870-ccdee4f5c9f9
msgctxt "h03087c57ge07fg49f9g9757g6615b6d52c18"
msgid "<i>Kneel in submission.</i> I am not of the killers' clan."
msgstr "<i>항복의 의미를 담아 무릎을 꿇는다.</i> 나는 그 살인자들과 한통속이 아니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Player
#. NodeID = 727ba127-d34b-1ebe-3870-ccdee4f5c9f9
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:727ba127-d34b-1ebe-3870-ccdee4f5c9f9
msgctxt "h5d2647edg750bg4d09g9069ge7c6dd325c7c"
msgid "<i>Kneel in submission. </i>I mean no harm to you."
msgstr "<i>복종의 의미로 무릎을 꿇는다. </i>당신에게 해를 가할 의도는 없습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Wyll
#. NodeID = 72dad1c4-49c8-2922-a2d1-61356c9de8a0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_WYLL(6) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:72dad1c4-49c8-2922-a2d1-61356c9de8a0
msgctxt "h60dba53fg614cg4ab0g944cg13ae9116af68"
msgid ""
"Duergar killed their children. They should pay the price for the cruelty."
msgstr "듀에르가는 아이들을 죽였어. 그 잔인함에 대한 대가를 치러야 할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Player
#. NodeID = 736145e6-00cc-ca9a-e267-52202ec566d4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidRevenge_State_HeadInaccessible = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:736145e6-00cc-ca9a-e267-52202ec566d4
msgctxt "he1fc48f1ge683g433ega4f6ga5297470c1f5"
msgid "You're racking up quite the body count."
msgstr "전사자 수를 많이 늘리려는 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Player
#. NodeID = 737139cc-bf6f-f7dc-f4ad-a46a25f48269
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_Quest_LoneDuergar_Defeated = True
#.      - UND_MyconidCircle_MyconidSovereignReward = False
#. SetFlags:
#.   Global:
#.     - UND_MyconidCircle_AcceptedQuest = True
#.   Object:
#.     - UND_MyconidCircle_Inclusion_Glut(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:737139cc-bf6f-f7dc-f4ad-a46a25f48269
msgctxt "h03d89586g7be7g4156gb448gecd3897cc877"
msgid "The duergar are slain; the rot has been purged."
msgstr "그 듀에르가를 죽였다. 부패는 제거되었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Player
#. NodeID = 798abc7f-bed3-381e-fa0e-387dc836148f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:798abc7f-bed3-381e-fa0e-387dc836148f
msgctxt "hda3ebc82gb0d1g4aacgba2eg1120ab48809b"
msgid "Let's talk about something else."
msgstr "다른 주제에 대해서 이야기하자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Narrator
#. NodeID = 7a1d83cd-d255-b265-b2cf-536744e74861
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:7a1d83cd-d255-b265-b2cf-536744e74861
msgctxt "ha0328ab1gc3bcg4cd8g9839g5fc96855fe19"
msgid "*Fungal roots weave through your mind, poking you, warning you...*"
msgstr "*포자 뿌리가 찌르고 경고하면서 당신의 정신을 휘젓고 다닙니다...*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Narrator
#. NodeID = 80ab032e-9748-f25d-ff61-505fa37411c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:80ab032e-9748-f25d-ff61-505fa37411c1
msgctxt "h575245a3gc171g402dg9eacg98f71bd8abe5"
msgid ""
"*You see another vision: your lifeless body, wrapped in tendrils. The "
"sovereign is <i>threatening</i> you.*"
msgstr "*당신은 다른 환영을 봅니다: 생기를 잃은 몸이 덩굴손에 감겨있습니다. 군주가 당신을 <i>위협</i>하고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Player
#. NodeID = 80f0d308-0d0e-10b6-22c7-983384826388
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#.      - REALLY_GITHYANKI(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:80f0d308-0d0e-10b6-22c7-983384826388
msgctxt "h039b33c1g0565g4c3cga934gd50b441bdf53"
msgid "<i>Hum a peaceful tune in harmony with the sovereign.</i>"
msgstr "<i>군주와 화음을 맞춰 평화로운 곡조를 흥얼거린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Narrator
#. NodeID = 82e5e913-3481-b28e-2c8f-9e5ba3fa4b19
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:82e5e913-3481-b28e-2c8f-9e5ba3fa4b19
msgctxt "hb96e3fa2ge2fbg41d7gbeeegf3f84f32d3b4"
msgid ""
"*The sovereign probes your mind. Valiant, but untrue, images of you slaying "
"duergar greet it. The myconid retreats, satisfied.*"
msgstr ""
"*군주가 당신의 정신을 탐색합니다. 당신이 용감하게 듀에르가를 학살하는 거짓된 환영이 이에 답합니다. 마이코니드는 만족한 듯 물러섭니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Sovereign Spaw
#. NodeID = 83b77eac-b49a-2a55-5d0e-770f011084d5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:83b77eac-b49a-2a55-5d0e-770f011084d5
msgctxt "hcd1c9da8g1018g4d98g9fdbg21d092e8d850"
msgid ""
"((*in dealing death, you have brought this Circle life. and thus we name you "
"- <b>Life-Chanter</b>*))"
msgstr "((*너는 죽음을 다루면서, 이 공동체에 생명을 불어넣어 주었으니, 너에게 <b>생명 연주자</b>라는 이름을 주겠다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Player
#. NodeID = 85597b62-6009-bd4e-9857-fee0418cd642
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_AcceptedQuest = False
#.      - UND_MyconidCircle_Quest_LoneDuergar_Defeated = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:85597b62-6009-bd4e-9857-fee0418cd642
msgctxt "h86aa881cgb9ddg4238g9c4dg4ecb85614a28"
msgid "Forget it. If you want them dead, you can kill them yourself."
msgstr "관둬. 그들이 죽길 바란다면, 직접 하라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Sovereign Spaw
#. NodeID = 88959b0b-5332-0c2b-4841-3de73c7a3d75
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - UND_MyconidCircle_SovereignOfferedSpores(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:88959b0b-5332-0c2b-4841-3de73c7a3d75
msgctxt "hec1a0911g650bg4bc1g9279g0283bfe5d959"
msgid "((*accept this gift. it will help you exterminate*))"
msgstr "((*이 선물을 받아라. 박멸에 도움이 될 것이다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Narrator
#. NodeID = 91c51c7a-7db4-81c5-15c4-32f414f0377f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_State_OfferedQuest = False
#.      - UND_MyconidCircle_State_GainedAccess = True
#. SetFlags:
#.   Global:
#.     - UND_MyconidCircle_SpokeWithSovereign = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:91c51c7a-7db4-81c5-15c4-32f414f0377f
msgctxt "he5019579g1fccg493bg98cfg9a5b470a9cb8"
msgid ""
"*The sovereign's thick fingers stroke the corpse at its feet. A droning "
"melody greets you as the creature turns its gaze to you.*"
msgstr ""
"*군주의 두꺼운 손가락이 발밑에 있는 시체를 쓰다듬습니다. 생명체가 당신을 향해 시선을 돌리자 나지막한 멜로디가 당신을 맞이합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Player
#. NodeID = 92252edf-8a94-367f-d17b-d697c00ad972
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. TagRule: REALLY_DUERGARDWARF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:92252edf-8a94-367f-d17b-d697c00ad972
msgctxt "hb1836172g4388g4cfbga843gb28295e5c0af"
msgid "<i>Kneel in submission.</i> I am not of the killers' clan."
msgstr "<i>항복의 의미를 담아 무릎을 꿇는다.</i> 나는 그 살인자들과 한통속이 아니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Player
#. NodeID = 92252edf-8a94-367f-d17b-d697c00ad972
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:92252edf-8a94-367f-d17b-d697c00ad972
msgctxt "h952b03c9g6159g42degbfafgceb2da63f952"
msgid "<i>Kneel in submission.</i> My duergar companion means no harm to you."
msgstr "<i>항복의 의미를 담아 무릎 꿇는다.</i> 내 듀에르가 동료는 해를 끼칠 의도가 없다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Sovereign Spaw
#. NodeID = 946a3545-8d6e-6ad0-0597-7685d0a81c70
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:946a3545-8d6e-6ad0-0597-7685d0a81c70
msgctxt "h749d23cage199g4feag846bgc7bfdd8aec69"
msgid "((*we breathe life into our enemies' flesh*))"
msgstr "((*우리는 적의 육체에 생명을 불어넣는다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Player
#. NodeID = 9a825557-0e9d-8568-204f-0b853f0e39ad
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BERSERKER(1) = False
#. TagRule: REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:9a825557-0e9d-8568-204f-0b853f0e39ad
msgctxt "hc0113a02g5e02g4350ga564g025d95a7690b"
msgid ""
"<i>Utter a githyanki war cry.</i> Did you truly wish to risk battle with me?"
msgstr "<i>기쓰양키식 전투의 외침을 발산한다.</i> 정말로 나와 전투하는 위험을 감수하고 싶은 것인가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Player
#. NodeID = 9a825557-0e9d-8568-204f-0b853f0e39ad
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BERSERKER(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:9a825557-0e9d-8568-204f-0b853f0e39ad
msgctxt "h4d5a9463g8cb5g468eg8264g4127b600dbe9"
msgid "Do you truly wish to do battle with a great warrior?"
msgstr "진정으로 위대한 전사와 전투를 벌이기 원하는가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Player
#. NodeID = a153a9a3-fe05-4f0f-0c22-c6c1a171960a
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 20
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:a153a9a3-fe05-4f0f-0c22-c6c1a171960a
msgctxt "h4ab4c893g2e08g4b9cgb2b3g510456afe820"
msgid ""
"<i>Imitate the sovereign and lie.</i> ((*good tidings. the scourge is "
"defeated. you are safe*))"
msgstr "<i>군주를 흉내내며 거짓말을 한다.</i> ((*좋은 소식이야. 골칫거리를 해치웠어. 넌 안전해*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Sovereign Spaw
#. NodeID = a2fb0b4e-6f11-d8f2-cc73-765e326924ec
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_MyconidSovereignReward = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:a2fb0b4e-6f11-d8f2-cc73-765e326924ec
msgctxt "hd1ffcc54gf292g4b30ga557g672387cd724f"
msgid "((*you aid us twice over. so twice I will thank you*))"
msgstr "((*넌 우리를 두 번 도왔으니, 나도 두 배로 감사하겠다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Player
#. NodeID = a3efadf2-43f2-e1bf-3d03-e5a0ee506509
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidSovereign_State_SaidKilledGlut = False
#.      - UND_BroodingSovereign_State_RefusedCircle = True
#.      - UND_MyconidCircle_BroodingSovereign_State_PermaDefeated = True
#. SetFlags:
#.   Global:
#.     - UND_MyconidSovereign_State_SaidKilledGlut = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:a3efadf2-43f2-e1bf-3d03-e5a0ee506509
msgctxt "hf33c981bg3c01g4738g8c50g07b525f65f20"
msgid ""
"I have slain the creature called Glut. It was scheming to slaughter your "
"circle."
msgstr "글럿이라는 놈을 죽였어. 너희 공동체를 학살할 계획을 꾸미고 있었지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Narrator
#. NodeID = a4dc8f71-0236-4745-1595-dfe168ec742f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:a4dc8f71-0236-4745-1595-dfe168ec742f
msgctxt "hd41f3692ge241g4b7fg9899g9bc6a8c6b050"
msgid ""
"*Deep purples swirl into familiar shapes: gnomes in mining gear chased by "
"duergar.*"
msgstr "* 짙은 보라색이 소용돌이치며 익숙한 모양으로 변합니다: 채굴 장비를 한 노움이 듀에르가에게 쫓기고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Narrator
#. NodeID = a51bb113-c221-2592-0784-87c3b9950a32
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:a51bb113-c221-2592-0784-87c3b9950a32
msgctxt "h26e8aab3gd6fdg4718g90b7g0df54406ce16"
msgid ""
"*It replies with an echoing screech, and returns its gaze to the corpse.*"
msgstr "*메아리치는 비명으로 응답하더니, 시체를 응시합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Narrator
#. NodeID = a5c55a7b-23cc-7c81-1a30-48073aa94caa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:a5c55a7b-23cc-7c81-1a30-48073aa94caa
msgctxt "hf285c3beg75fag4dd7gaed2g67bd452b1b85"
msgid "*The sovereign's song halts as it measures your worth.*"
msgstr "*군주의 노래가 멈추고 그가 당신의 가치를 측정합니다*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Player
#. NodeID = a647a063-894b-1a8b-7544-44d43ef1ac2c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidRevenge_State_QuestCompleted = False
#.      - UND_MyconidRevenge_State_SentKillNere = True
#.   Object:
#.      - UND_MyconidRevenge_State_HasNereHead(1) = True
#. SetFlags:
#.   Object:
#.     - UND_MyconidRevenge_Event_GiveNereHead(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:a647a063-894b-1a8b-7544-44d43ef1ac2c
msgctxt "h3831f6b5g5d07g474eg94f3g3a4dca459f58"
msgid "I've brought you Nere's head."
msgstr "니어의 머리를 가져왔어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Narrator
#. NodeID = a7ac1193-7384-95e8-917b-8b302506812a
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_DUERGARDWARF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:a7ac1193-7384-95e8-917b-8b302506812a
msgctxt "he1dc3b08g6d16g44adga946g23f7fa36966b"
msgid ""
"*A violent vision grips you: duergar like yourself, chopping myconid "
"remains.*"
msgstr "*폭력적인 광경이 당신을 사로잡습니다. 당신과 같은 듀에르가가 마이코니드 유해를 썰고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Narrator
#. NodeID = a7ac1193-7384-95e8-917b-8b302506812a
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:a7ac1193-7384-95e8-917b-8b302506812a
msgctxt "hba1e2ca1g4837g4c29ga1f4gdef0954f2e12"
msgid ""
"*A violent vision grips you: duergar - dark dwarves - chopping myconid "
"remains.*"
msgstr "*폭력적인 광경이 당신을 사로잡습니다. 어두운 드워프들인 듀에르가가 마이코니드 유해를 썰고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Sovereign Spaw
#. NodeID = a95ddfeb-ef95-2a94-e34e-0697f5b09bab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:a95ddfeb-ef95-2a94-e34e-0697f5b09bab
msgctxt "h9ce1c4e6gef31g409fgaa2ag4d8db71b9462"
msgid "((*the Rot festers. duergar remain. lakeward*))"
msgstr "((*부패가 곪았다. 듀에르가가 남아있다. 강가에*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Narrator
#. NodeID = abad8a0b-c720-d7bf-e01b-6b910ae039f7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:abad8a0b-c720-d7bf-e01b-6b910ae039f7
msgctxt "h69380089gf33cg4856gae49g61c58b4a3c4a"
msgid ""
"*You see another vision: your lifeless body, wrapped in tendrils. The "
"sovereign is <i>threatening</i> you.*"
msgstr "*당신은 다른 환영을 봅니다: 생기를 잃은 몸이 덩굴손에 감겨있습니다. 군주가 당신을 <i>위협</i>하고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Narrator
#. NodeID = ae4310c8-cfc6-9506-6b2a-d3c0791a89d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:ae4310c8-cfc6-9506-6b2a-d3c0791a89d0
msgctxt "h45058c40gbc12g4fabga0bfg39bc2df3a348"
msgid "*The sovereign's song halts as it measures your might.*"
msgstr "*당신의 힘을 가늠하면서 군주의 노래가 멈춥니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Gale
#. NodeID = b05802a9-4ff0-4aee-82a8-66e64224a104
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_GALE(7) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:b05802a9-4ff0-4aee-82a8-66e64224a104
msgctxt "h62765e54g77aag429bga27cgcf1d2d9e25d9"
msgid "I suppose such wicked killers deserve wicked ends."
msgstr "이런 사악한 학살자들에게는 사악한 최후가 어울릴 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Sovereign Spaw
#. NodeID = b284176c-3f39-d8b5-d024-ff656de50e62
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_MyconidCircle_State_OfferedQuest = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:b284176c-3f39-d8b5-d024-ff656de50e62
msgctxt "h2542c98fg8da0g4453g8dbfg61ad55681db5"
msgid "((*I will reward. you cleanse the Rot. you <i>destroy them</i>*))"
msgstr "((*보답을 하겠다. 부패한 것들을 정화해라. <i>놈들에게 파멸을 안겨줘라</i>*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Astarion
#. NodeID = b4674a2e-de7b-e75d-48e4-8324e9e1a938
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:b4674a2e-de7b-e75d-48e4-8324e9e1a938
msgctxt "h43310b2bga7c1g4a9eg9187g10e1fe43d053"
msgid ""
"I'm more than happy to kill this - whoever he is, but tell me there's "
"something in it for us?"
msgstr "그가 누구든 간에 기꺼이 죽여줄게. 그런데 그게 우리에게 어떤 이득이 되는지 말해줄래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Player
#. NodeID = b543643e-d782-dce4-07a6-82ccada99a8f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_AcceptedQuest = False
#.      - UND_MyconidCircle_Quest_LoneDuergar_Defeated = False
#. SetFlags:
#.   Global:
#.     - UND_MyconidCircle_AcceptedQuest = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:b543643e-d782-dce4-07a6-82ccada99a8f
msgctxt "h326592edg65b3g4243gb688g606fdcdbb70c"
msgid "Sure, I can handle those duergar nearby."
msgstr "물론이지, 근처의 듀에르가를 처리해주겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Player
#. NodeID = b58984b5-7bad-6ee3-fb42-c4a83c533d1f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_MyconidCircle_BroodingSovereign_State_InParty = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:b58984b5-7bad-6ee3-fb42-c4a83c533d1f
msgctxt "hbfefb5a5g29acg4293gb00cg884bb5075a46"
msgid "I wanted you to hear Glut's treachery first-hand. Now let's end it."
msgstr "글럿의 반역을 먼저 알려주고 싶었어. 이제 끝내자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Sovereign Spaw
#. NodeID = b779e359-c0d5-8624-71ea-5814f858f754
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_DUERGARDWARF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:b779e359-c0d5-8624-71ea-5814f858f754
msgctxt "h9953b551gfd5bg4925gaf4fgbc952a9088ea"
msgid ""
"((*you have <b>broken</b> our peace. you have <b>killed our young</b>*))"
msgstr "((*너희는 우리 평화를 <b>깨뜨렸다</b>. 너희가 <b>우리 젊은이들을 죽였다</b>*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Sovereign Spaw
#. NodeID = b779e359-c0d5-8624-71ea-5814f858f754
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:b779e359-c0d5-8624-71ea-5814f858f754
msgctxt "h3521f1cfg6256g48fcg8f0cg1ca59729151c"
msgid "((*they <b>broke</b> our peace. they <b>killed our young</b>*))"
msgstr "((*이 자들은 우리 평화를 <b>깨뜨렸다</b>. 그들이 <b>우리 젊은이들을 죽였다</b>*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Player
#. NodeID = bc815b9f-3cbf-1b75-d65b-10cd15cc42a1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:bc815b9f-3cbf-1b75-d65b-10cd15cc42a1
msgctxt "h1d8c216cg0493g4aa9gb51cg4e38734bf6de"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Sovereign Spaw
#. NodeID = bd67c396-ec54-b055-2514-384fc4a9239f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:bd67c396-ec54-b055-2514-384fc4a9239f
msgctxt "h04367f93g5728g40afg8e83g453c0162dee2"
msgid ""
"((*the dark intruders <b>broke</b> our peace. they <b>killed our young</b>*))"
msgstr "((*어두운 침략자들이 우리 평화를 <b>깨뜨렸다</b>. 그들이 <b>우리 젊은이들을 죽였어</b>*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Player
#. NodeID = c1524a25-fb69-aab6-1d0f-ae572496381f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_BroodingSovereign_State_AskedCircle = True
#.      - UND_BroodingSovereign_State_RefusedCircle = False
#.      - UND_MyconidCircle_BroodingSovereign_State_PermaDefeated = False
#.   Script:
#.      - GEN_IsSpeakerPresent_11 = False
#. SetFlags:
#.   Global:
#.     - UND_MyconidCircle_Event_BetraySpaw = True
#.     - UND_MyconidCircle_State_Hostile = True
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:c1524a25-fb69-aab6-1d0f-ae572496381f
msgctxt "h7a8842a0gd032g484fgbc9dg3873e773f3c3"
msgid ""
"You named me poorly, Spaw. Glut is sovereign now - and I bring you death."
msgstr "이름을 잘못 지어 줬어, 스포. 이제 글럿이 군주야. 난 널 죽일 거고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Player
#. NodeID = c2ad6ea8-d10d-fbc8-3e31-fa9cca345623
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidRevenge_State_HeadInaccessible = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:c2ad6ea8-d10d-fbc8-3e31-fa9cca345623
msgctxt "h5db608cag0c5ag4dacg9e4fgcbddbfd53286"
msgid "Consider it done. I will bring Nere's head to you."
msgstr "이미 죽은 목숨이라고 생각해도 좋아. 놈의 머리를 가져다 주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Player
#. NodeID = c4f5e47f-681a-454c-a919-f278ca3c06f7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_UNDERDARK(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:c4f5e47f-681a-454c-a919-f278ca3c06f7
msgctxt "hf9c16746g75afg4cb0ga6a7ga2b1c08e684a"
msgid "The Underdark is my home. I do not need your permission to be here."
msgstr "언더다크는 내 고향이야. 내가 여기 있는 데 너의 허락은 필요 없지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Narrator
#. NodeID = c544cf5e-a008-5e26-e8a3-b3bf517de233
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_DUERGARDWARF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:c544cf5e-a008-5e26-e8a3-b3bf517de233
msgctxt "hec59e15bg7f35g4046gb295g229dd888c055"
msgid ""
"*Then, visions. Duergar like yourself, chopping fungal tendrils with their "
"axes.*"
msgstr "*그리고 광경이 나타납니다. 당신과 같은 듀에르가가 덩굴손들을 도끼로 썰고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Narrator
#. NodeID = c544cf5e-a008-5e26-e8a3-b3bf517de233
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:c544cf5e-a008-5e26-e8a3-b3bf517de233
msgctxt "h0bf37feeg8b14g4c06g9e1cgbd1b0160d4b5"
msgid ""
"*Then, visions. Dark dwarves - duergar - chopping fungal tendrils with their "
"axes.*"
msgstr "*그리고 광경이 나타납니다. 어두운 드워프들인 듀에르가가 덩굴손들을 도끼로 썰고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Sovereign Spaw
#. NodeID = c8c424c7-1d14-f55c-5f46-db0365ff26e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:c8c424c7-1d14-f55c-5f46-db0365ff26e2
msgctxt "h36e0ea14g4b14g4b94g96e4g526a07afaa24"
msgid "((*flesh-talker. I show you a memory. watch and listen*))"
msgstr "((*육체로 대화하고 있는 자여. 너에게 기억을 보여주겠다. 보고 들어라*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Sovereign Glut
#. NodeID = c8c4a401-afad-39c3-d7d1-4ac5622c8a0e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_BroodingSovereign_State_AskedCircle = True
#.      - UND_MyconidCircle_BroodingSovereign_State_PermaDefeated = False
#.   Tag:
#.      - MYCONID(8) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:c8c4a401-afad-39c3-d7d1-4ac5622c8a0e
msgctxt "h80633dd9gd940g458eg9928g248dcc77e41a"
msgid ""
"((*so <b>generous</b> is Spaw, mighty Sovereign. but when I sang my need, I "
"received only silence*))"
msgstr "((*그리 <b>너그럽고</b> 강력한 군주라던 스포는 내가 도와 달라고 노래하자 침묵으로 답했지.*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Sovereign Spaw
#. NodeID = ca8769c0-dca7-ed3c-ee3f-539e2644a8f3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_MyconidCircle_State_Hostile = True
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:ca8769c0-dca7-ed3c-ee3f-539e2644a8f3
msgctxt "h2937bba9g9e39g4b6fg8f9cg4ac5fc58d152"
msgid "((*<i>vile beast. <b>cleanse the Rot</b></i>*))"
msgstr "((*<i>추악한 짐승이군. <b>썩은 것을 정화하라</b></i>*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Shadowheart
#. NodeID = cb3f102d-9ae7-b1c9-b2bc-1b81407da3ae
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - c9645362-c2d9-4642-459f-b28f474f8241_ShadowheartInclusion = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:cb3f102d-9ae7-b1c9-b2bc-1b81407da3ae
msgctxt "h64bde90bg5240g4a26g97ccgc72d5835adbe"
msgid "If I die down here, destroy my corpse."
msgstr "만약 내가 여기서 죽으면, 내 시체를 없애줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Sovereign Spaw
#. NodeID = cbf2b476-b192-bb37-377f-0d9d6ba0e174
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:cbf2b476-b192-bb37-377f-0d9d6ba0e174
msgctxt "hca3c62aegc545g41e0gbadbgd7ff99099182"
msgid ""
"((*you may not. the spores hear only the Circle. they dance to no other "
"harmony*))"
msgstr "((*못할 것이다. 이 포자들은 공동체에만 귀를 기울인다. 이들은 다른 화음에 춤을 추지 않는다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Sovereign Spaw
#. NodeID = ccbff535-05fd-7343-60d7-08263fcfc6ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:ccbff535-05fd-7343-60d7-08263fcfc6ad
msgctxt "h93931cf3g2690g40f0g818ageee6a474ab56"
msgid "((*you do the Circle a service. we will await word*))"
msgstr "((*공동체를 도와라. 소식을 기다리겠다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Sovereign Spaw
#. NodeID = d481e87a-3610-495d-0d4b-80558a321d65
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_InjuredGnome_Knows_RunFromDuergar = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:d481e87a-3610-495d-0d4b-80558a321d65
msgctxt "h47a6606eg1340g4d75gb7cbg929aa85007e4"
msgid "((*the duergar seek a gnome. it is a guest*))"
msgstr "((*듀에르가가 한 노움을 추적하고 있다. 그 노움은 손님이다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Player
#. NodeID = d68d89c1-680b-999b-9067-d1d62ff97885
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_DUERGARDWARF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:d68d89c1-680b-999b-9067-d1d62ff97885
msgctxt "h71ae7d96g2329g4342g8fa5ga5d19a0f8711"
msgid "Time for some mushroom soup! <i>Attack.</i>"
msgstr "버섯 스프 좀 먹어볼까! <i>공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Player
#. NodeID = d68d89c1-680b-999b-9067-d1d62ff97885
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:d68d89c1-680b-999b-9067-d1d62ff97885
msgctxt "h3ac69b0cg8aa3g48d1g8a0fg9085c55f8d94"
msgid "I will not be intimidated! <i>Attack.</i>"
msgstr "그 정도로 겁먹지 않아! <i>공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Sovereign Spaw
#. NodeID = d8151c5e-6398-79ec-1efe-7e6a12b79eeb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:d8151c5e-6398-79ec-1efe-7e6a12b79eeb
msgctxt "hdedd20acg7c3bg45acg87eag8f0dacfa0b02"
msgid ""
"((*riches of magic and mind. cleanse the <b>Rot</b>, and they are yours*))"
msgstr "((*마법과 정신의 부다. <b>부패</b>를 정화하면. 네 것이 될 것이다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Sovereign Spaw
#. NodeID = dab3a23e-6223-9fe4-f7c4-6cee58a0a52f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_MyconidSovereignReward = True
#. SetFlags:
#.   Object:
#.     - UND_MyconidCircle_Inclusion_Glut(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:dab3a23e-6223-9fe4-f7c4-6cee58a0a52f
msgctxt "h15188550g73a7g4f0cg8db9gb0bfdd60c3b0"
msgid "((*<b>Peace-Bringer</b>. be at home*))"
msgstr "((*<b>평화 인도자</b>군. 집처럼 지내라*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Sovereign Spaw
#. NodeID = dac45583-12a3-e1c5-71bc-e32c8e41c54b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidSovereign_State_SaidKilledGlut = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:dac45583-12a3-e1c5-71bc-e32c8e41c54b
msgctxt "h89a2b731gd765g43dag8d88gf8afb4222e47"
msgid ""
"((*do you hear, <b>Kin Spirit</b>? a new harmony. serenity. I now deem you <b"
">Peace-Bringer</b>*))"
msgstr "((*들리나, <b>동지 영혼</b> ? 새로운 화음. 평온이다. 이제 너를 <b>평화 인도자</b>로 여기겠다.*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Narrator
#. NodeID = ded7c5bd-f677-7aee-b1e7-be84265514d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:ded7c5bd-f677-7aee-b1e7-be84265514d9
msgctxt "hc5e9843cg922fg44b6gac9fgef3f66bea417"
msgid "*The sovereign says nothing, but you hear appreciation in its song.*"
msgstr "*군주는 아무 말도 하지 않지만, 그의 노래에서 감사함이 들립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Sovereign Spaw
#. NodeID = e234f263-b65c-2092-6e64-9823bfc6079e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_InjuredGnome_Knows_RunFromDuergar = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:e234f263-b65c-2092-6e64-9823bfc6079e
msgctxt "hf5cfdf7dg2cdcg4177ga39ag35d57325dd80"
msgid "((*the duergar seek a gnome. it is a guest*))"
msgstr "((*듀에르가가 한 노움을 추적하고 있다. 그 노움은 손님이다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Sovereign Spaw
#. NodeID = e29e3704-d53e-dd11-6929-d86f9942d75b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:e29e3704-d53e-dd11-6929-d86f9942d75b
msgctxt "h49f2e2e0g93aeg4c6dg9ed9g6bfd79d0ab3c"
msgid ""
"((*then the Circle is safe, if you speak true. <b>Peace-Bringer</b>, our "
"alliance comes to an end*))"
msgstr "((*네가 진실을 말한다면 공동체는 이제 안전하다. <b>평화 인도자</b>, 우리의 동맹도 여기까지군*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Shadowheart
#. NodeID = e34abed8-8175-0708-cf09-28701cdddfac
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(2) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:e34abed8-8175-0708-cf09-28701cdddfac
msgctxt "hf2d77cc8ge920g4156ga555gbbe68dee0546"
msgid "More busywork? That's royalty for you - everyone's their servant."
msgstr "잡일을 더 준다고? 이게 왕족이야. 모두가 자기 하인인 줄 알지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Sovereign Spaw
#. NodeID = e4889899-f3c0-22a0-20e8-2516f4c1dc0f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:e4889899-f3c0-22a0-20e8-2516f4c1dc0f
msgctxt "ha83f40dcg611ag4a5fgabeegfaa60fe17b67"
msgid "((*what more would you ask?*))"
msgstr "((*더 묻고 싶은 것이 있나?*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Sovereign Spaw
#. NodeID = e7c062fe-6733-6f18-46b8-61f3385de85a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:e7c062fe-6733-6f18-46b8-61f3385de85a
msgctxt "hc949e280g3b80g456dga600gdcf94f117d31"
msgid "((*yes. our enemies' flesh makes a fine host for my growing children*))"
msgstr "((*물론이다. 적들의 살점은 자라나는 아이들의 좋은 숙주가 되지*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Sovereign Spaw
#. NodeID = e9d35e21-5bde-274f-9534-3ca94cf34a4f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_MyconidCircle_MyconidSovereignReward = True
#.   Object:
#.     - UND_MyconidCircle_Event_RevealHiddenCave(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:e9d35e21-5bde-274f-9534-3ca94cf34a4f
msgctxt "hef596b45g4e47g4275ga8a9g1d42b8fea4ac"
msgid "((*the guardian gate is open. go and claim your reward*))"
msgstr "((*수호자 관문이 개방되었다. 가서 너의 보상을 얻어라*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Astarion
#. NodeID = e9d93e28-2880-4814-9519-237bb9be578a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:e9d93e28-2880-4814-9519-237bb9be578a
msgctxt "hc4c9e9c1g9675g4542g92d4ga7f8bdc90599"
msgid "I admit, I like this one's approach. A little genocidal, but effective."
msgstr "괜찮은 방법임을 인정해야겠어. 학살의 느낌이 있지만 효과적이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Sovereign Spaw
#. NodeID = ea04d84c-e608-fb31-fcbc-b9fb285bf68e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:ea04d84c-e608-fb31-fcbc-b9fb285bf68e
msgctxt "h7a2d0b51g905bg4e1cg8c4dg4e6a06afe17f"
msgid "((*you aid us in good faith. in good faith, I thank you*))"
msgstr "((*너는 선의로 우리를 돕고 있다. 나는 선의로 너에게 감사한다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Sovereign Spaw
#. NodeID = ee168a1c-c65e-c8ec-a896-2846754b934b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_State_DestroyedDoor = True
#. SetFlags:
#.   Global:
#.     - UND_MyconidCircle_MyconidSovereignReward = True
#.   Object:
#.     - UND_MyconidCircle_Event_RevealHiddenCave(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:ee168a1c-c65e-c8ec-a896-2846754b934b
msgctxt "hf3533a0eg6b54g4001g88d0ge4a504280e88"
msgid ""
"((*the guardian gate is open already. but perhaps there is still some reward "
"to claim*))"
msgstr "((*수호자 관문은 이미 개방되었다. 하지만 얻을 수 있는 보상이 아직 있을 것이다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Narrator
#. NodeID = f23c790a-692a-f997-1aad-7326a982c6e4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:f23c790a-692a-f997-1aad-7326a982c6e4
msgctxt "h01749804g78fdg4f7fg9706g8b0f654a0da2"
msgid "*The sovereign drones a new melody, cautious but insistent.*"
msgstr "*군주가 새로운 멜로디를 웅얼거립니다. 신중하면서도 집요합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Player
#. NodeID = f40de083-dfb8-7ddd-fcc9-e44050a44cbe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidSovereign_State_PlayerSawResurrection = True
#.      - UND_MyconidSovereign_Event_ResurrectedDead = False
#.   Tag:
#.      - REALLY_UNDERDARK(1) = False
#. TagRule: BARD or CLERIC or PALADIN
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:f40de083-dfb8-7ddd-fcc9-e44050a44cbe
msgctxt "h70ace41cg9cf7g4d11g94bagf52ffe72b949"
msgid "Planting spores in a corpse - what magic is this?"
msgstr "시체에 포자를 심는 것은 무슨 마법이지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Sovereign Spaw
#. NodeID = f783eb2e-9c75-9d69-a115-b4d24639ede1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:f783eb2e-9c75-9d69-a115-b4d24639ede1
msgctxt "hcf0b0742g73fbg470ag889dgfd14e1e42313"
msgid "((*<b>Peace-Bringer</b> - what is this?*))"
msgstr "((*<b>평화 인도자여</b> - 이것은 무엇인가?*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Player
#. NodeID = f92d7570-b512-7a29-bb5a-ae6ed2d43889
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DUERGARDWARF(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:f92d7570-b512-7a29-bb5a-ae6ed2d43889
msgctxt "hea9f55d2g16a2g484eg8c2bg443ced12a50a"
msgid "The spore-magic is repulsive. You die by my hand!"
msgstr "포자 마법은 혐오스럽군. 너는 내 손에 죽어라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Sovereign Spaw
#. NodeID = f9bfc77c-74f8-c431-2dc9-2b3caab565a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:f9bfc77c-74f8-c431-2dc9-2b3caab565a4
msgctxt "hb8929b8fg3b41g4807gb3f6g2e8b2baca4c9"
msgid "((*we laid waste to many. but intruders remain. lakeward*))"
msgstr "((*우리는 그들 중 다수를 죽였다. 하지만 침략자들이 호수 쪽에 남아있다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Sovereign Spaw
#. NodeID = fa06d0d9-d0ac-9e93-b2d1-e109889bd5b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:fa06d0d9-d0ac-9e93-b2d1-e109889bd5b6
msgctxt "haa5d5ff0gad95g434fg992agb8d30d7fa577"
msgid ""
"((*do you hear? a new harmony. serenity. I name you <b>Peace-Bringer</b>*))"
msgstr "((*들리나? 새로운 화음. 평온이다. 너에게 <b>평화 인도자</b>라는 이름을 주겠다.*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Lae'zel
#. NodeID = fa460345-d04b-488a-0a15-e9ab032bbd1f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_LAEZEL(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:fa460345-d04b-488a-0a15-e9ab032bbd1f
msgctxt "h2b9318a8g5a05g41dega1cegae079d17627c"
msgid "Do you see? Indulge one demand, and it only breeds another."
msgstr "알겠나? 한 가지 욕구를 충족시키면, 또 다른 욕구를 낳을 뿐이라는 것을."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Narrator
#. NodeID = fc5eccc8-9435-2a15-5969-17058c5ac746
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_State_GainedAccess = False
#.   Object:
#.      - UND_MyconidCircle_DuergarInParty(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:fc5eccc8-9435-2a15-5969-17058c5ac746
msgctxt "h29a3184dg6e02g4132g9ac7g9b738f8c8055"
msgid ""
"*Whispers. Moans. Disharmony. They drift through you like an unknown "
"language.*"
msgstr "*속삭임. 흐느낌. 부조화. 이들이 알 수 없는 언어로 부유합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Player
#. NodeID = fe653d35-14a6-d549-e2e5-188bca893cdf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DUERGARDWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:fe653d35-14a6-d549-e2e5-188bca893cdf
msgctxt "hccfb1d28g9e0fg40cagafecg659ecdf00d33"
msgid "Duergar, reduced to cadaverous puppets? You will die by my hand!"
msgstr "듀에르가를 시체 같은 꼭두각시로 만들어? 널 내 손으로 죽여 주지!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Player
#. NodeID = fe8db9ce-182a-14b7-9892-0684b547871a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_AcceptedQuest = False
#.   Tag:
#.      - REALLY_DUERGARDWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:fe8db9ce-182a-14b7-9892-0684b547871a
msgctxt "h13e2964bg2e14g448cga715gd2615a5bf562"
msgid "No duergar is 'rot'! <i>Attack the sovereign.</i>"
msgstr "듀에르가는 '부패'가 아니다! <i>군주를 공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign
#. Speaker = Sovereign Spaw
#. NodeID = ff146651-46e0-6c9c-16bf-f8c0905a2c01
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign:ff146651-46e0-6c9c-16bf-f8c0905a2c01
msgctxt "hc487b8feg808cg4281gb27eg2854f0f90b33"
msgid ""
"((*as our Circle grows, so shall your song. wherever you go, only listen - "
"and you may hear it*))"
msgstr "((*우리 공동체가 성장할수록, 너의 노래도 커질 것이다. 네가 어디를 가든, 귀 기울이기만 하면 들을 수 있을 것이다*))"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_AD_CheckpointGuard_004_Combat
#. Speaker = Noxious Myconid
#. NodeID = 18fb38e4-4426-434a-a3e8-833609193d13
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_AD_CheckpointGuard_004_Combat:18fb38e4-4426-434a-a3e8-833609193d13
#, fuzzy
msgctxt "h894cd246ge155g49acg900ag03eda72d56c0"
msgid "((*you will fall. and in death, we will raise you*))"
msgstr "((*너는 스러질 것이다. 그리고 죽음으로부터, 우리가 그대를 일으킬 것이다*))"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign_AD_Combat
#. Speaker = Sovereign Spaw
#. NodeID = 3fff0971-7eee-436b-bd02-7656277fce24
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign_AD_Combat:3fff0971-7eee-436b-bd02-7656277fce24
#, fuzzy
msgctxt "ha887b52cgff74g4f0eg852cgb925e8c8b9f3"
msgid "((*Out with you, rotted spirit*))"
msgstr "((*꺼져라, 부패한 영혼아*))"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign_AD_Combat_AnimatingSpores_01
#. Speaker = Sovereign Spaw
#. NodeID = a7516b9c-5a6d-4ef1-8574-39a5c339bfd5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign_AD_Combat_AnimatingSpores_01:a7516b9c-5a6d-4ef1-8574-39a5c339bfd5
msgctxt "hccf67bddgc5c1g4922g85e4g29f10b9d23cb"
msgid "((*Death to undeath*))"
msgstr "((*죽지 않은 것에게 죽음을*))"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign_AD_Combat_AnimatingSpores_02
#. Speaker = Sovereign Spaw
#. NodeID = c6362d77-dfd7-4325-aacf-4bb8ea726c4b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign_AD_Combat_AnimatingSpores_02:c6362d77-dfd7-4325-aacf-4bb8ea726c4b
msgctxt "h45560de4gd191g402egb9aag757c86c0d2d8"
msgid "((*Servant, awaken*))"
msgstr "((*종복이여, 일어나라*))"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign_AD_Combat_AnimatingSpores_03
#. Speaker = Sovereign Spaw
#. NodeID = b3e0d98b-1b20-4d14-b598-96a679fe2830
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Underdark/UND_MyconidSovereign_AD_Combat_AnimatingSpores_03:b3e0d98b-1b20-4d14-b598-96a679fe2830
msgctxt "h2f4819fage36cg4624gaddbgbe913a07756c"
msgid "((*Be arisen*))"
msgstr "((*깨어날지어다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSuspicious
#. Speaker = Noxious Myconid
#. NodeID = 07299d2e-2a20-3151-82f1-d6ec66f16933
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_MyconidSovereignReward = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSuspicious:07299d2e-2a20-3151-82f1-d6ec66f16933
msgctxt "h3f8a7b42g2089g4ecdgaf50g4c6944f8326f"
msgid "((*you are worthy*))"
msgstr "((*넌 자격이 있어*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSuspicious
#. Speaker = Narrator
#. NodeID = 21eb0fa1-04e9-dd7f-9cf2-b4ce43f88697
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSuspicious:21eb0fa1-04e9-dd7f-9cf2-b4ce43f88697
msgctxt "h49509f1bgb51dg4f61gb11cg86296f51f3e5"
msgid ""
"*Duergar faces appear before you, one by one, each twisted by zealous "
"cruelty.*"
msgstr "*잔혹한 질투심에 의해 뒤틀린 듀에르가의 면면이 당신 앞에 나타납니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSuspicious
#. Speaker = Narrator
#. NodeID = 404b1dac-86ae-e50a-51ef-823a7d29d6dc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_MyconidCircle_MyconidSuspicious_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSuspicious:404b1dac-86ae-e50a-51ef-823a7d29d6dc
msgctxt "h6a907f18g8567g4a9fg8110g4fe3337e88c9"
msgid ""
"*The myconid cloaks you in dream: duergar spore servants shambling toward "
"you in unison.*"
msgstr "*마이코니드가 당신을 꿈으로 감싸고 있습니다: 듀에르가의 포자 종복들이 당신을 향해 일제히 비틀거리며 다가오고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSuspicious
#. Speaker = Noxious Myconid
#. NodeID = f022c2b4-6c8e-a106-fba0-00911e69cd80
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_MyconidCircle_MyconidSuspicious_HasMet(1) = False
#. SetFlags:
#.   Object:
#.     - UND_MyconidCircle_MyconidSuspicious_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidSuspicious:f022c2b4-6c8e-a106-fba0-00911e69cd80
msgctxt "h90c8116ag579eg4136gafcbg510b43be9fd6"
msgid "((*smooth-flesh. you are like them*))"
msgstr "((*부드러운 살. 넌 그들과 같군*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidVengeful
#. Speaker = Noxious Myconid
#. NodeID = a3e2e936-9587-3792-d2ff-85707936326d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_MyconidSovereignReward = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidVengeful:a3e2e936-9587-3792-d2ff-85707936326d
msgctxt "h409107fcg28e2g46c2gb4b5g5ee7e9e73e29"
msgid "((*the Circle is cleansed*))"
msgstr "((*공동체는 정화되었다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidVengeful
#. Speaker = Noxious Myconid
#. NodeID = c724b377-d313-b8dc-6c63-bb9678813d3a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_MyconidSovereignReward = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidVengeful:c724b377-d313-b8dc-6c63-bb9678813d3a
msgctxt "h48f25bdfg58feg41a9g8f2egc7554843f7b8"
msgid "((*cleanse the Circle. the Circle cleansed*))"
msgstr "((*공동체를 정화해라. 정화된 공동체*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_Myconid_BroodingSovereign_Raft
#. Speaker = Sovereign Glut
#. NodeID = 0ad7fac7-9cc2-b9bf-721e-c23380a973c4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_MyconidCircle_BroodingSovereign_State_InParty = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_Myconid_BroodingSovereign_Raft:0ad7fac7-9cc2-b9bf-721e-c23380a973c4
msgctxt "h3ea042f5g6e08g49cbgb04eg0ba46fc69976"
msgid "((*we continue our communion*))"
msgstr "((*우리의 교감은 계속될 거다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_Myconid_BroodingSovereign_Raft
#. Speaker = Player
#. NodeID = 3408261f-4a1b-a0cf-484c-431266a8dea7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_MyconidCircle_BroodingSovereign_State_InParty = False
#.   Object:
#.     - UND_DarkLake_Event_MoveToCamp(-1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_Myconid_BroodingSovereign_Raft:3408261f-4a1b-a0cf-484c-431266a8dea7
msgctxt "hd206b0e6g04feg4e91g9608g491cd4844680"
msgid "Stay in the grotto, then. I have to cross the lake."
msgstr "그럼 이 동굴에 남아. 난 강을 건너야 하니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_Myconid_BroodingSovereign_Raft
#. Speaker = Sovereign Glut
#. NodeID = 5409a59d-c0ce-f5f3-7751-aa01c5361099
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_Myconid_BroodingSovereign_Raft:5409a59d-c0ce-f5f3-7751-aa01c5361099
msgctxt "hc127e628gc116g43f7g8a85g2eb4617e39cb"
msgid "((*I will expect your return*))"
msgstr "((*너의 귀환을 기다리고 있겠다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_Myconid_BroodingSovereign_Raft
#. Speaker = Player
#. NodeID = 8cf97ac0-17ff-9a22-0ee6-f3a6d6221f64
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_Myconid_BroodingSovereign_Raft:8cf97ac0-17ff-9a22-0ee6-f3a6d6221f64
msgctxt "he0a8c6bdgf199g4467ga0cdg825d8e867034"
msgid "Don't worry, we'll stay here for now."
msgstr "걱정하지 마, 당장은 여기에 머무를 테니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_Myconid_BroodingSovereign_Raft
#. Speaker = Sovereign Glut
#. NodeID = ea8952b3-9e21-5f15-0500-a0ec31000313
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_Myconid_BroodingSovereign_Raft:ea8952b3-9e21-5f15-0500-a0ec31000313
msgctxt "h00258423gad4dg411dg8747gf7e031a2ea0e"
msgid "((*I will not cross. painful memories beyond*))"
msgstr "((*나는 건너지 않겠다. 고통스러운 기억이 남아있다*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_NGB_InjuredGnome_ThullaMurder
#. Speaker = Narrator
#. NodeID = 4ca87ae0-8627-743c-eecd-1cba88205ec0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_NGB_InjuredGnome_ThullaMurder:4ca87ae0-8627-743c-eecd-1cba88205ec0
msgctxt "hfb33f799gfa67g434dg81ebgf4736e8564d1"
msgid ""
"*It is not for you to judge the circle - but for the circle to judge "
"<i>you</i>.*"
msgstr "*당신이 공동체를 판단하는 것이 아닙니다 - 공동체가 <i>당신을</i> 판단하는 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_NGB_InjuredGnome_ThullaMurder
#. Speaker = Player
#. NodeID = 86683961-3c49-78c8-d904-aaf605def571
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_NGB_InjuredGnome_ThullaMurder:86683961-3c49-78c8-d904-aaf605def571
msgctxt "he44fa733ge0c0g4248gb701g455bac7a0b11"
msgid "If you cared so much, you'd have cured her already."
msgstr "그렇게 신경 썼으면, 진작에 그녀를 치료해줬어야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_NGB_InjuredGnome_ThullaMurder
#. Speaker = Narrator
#. NodeID = 8b12aa77-d807-413f-8801-29470941e5c1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_NGB_InjuredGnome_ThullaMurder:8b12aa77-d807-413f-8801-29470941e5c1
msgctxt "h139b7ac3g0e12g4006gba35g342ab7cfaf1a"
msgid ""
"*The myconid circle does not recognise your 'mercy' - but you will know its "
"justice.*"
msgstr "*마이코니드 공동체는 당신의 '자비'를 알아채지 못합니다 - 하지만 그것이 정의임을 당신은 알게 될 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_NGB_InjuredGnome_ThullaMurder
#. Speaker = Narrator
#. NodeID = bcc4d108-02f0-0a7b-d991-a86310c1da2a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_NGB_InjuredGnome_ThullaMurder:bcc4d108-02f0-0a7b-d991-a86310c1da2a
msgctxt "h64e4e70ag977eg4258gaf5fg17f12583dfce"
msgid ""
"*The circle's music slows. You recognise the melody as one of shame and "
"mourning.*"
msgstr "*공동체의 음악이 느려집니다. 당신은 이것이 수치심과 애도의 멜로디임을 깨닫습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_NGB_InjuredGnome_ThullaMurder
#. Speaker = Narrator
#. NodeID = c6e29995-72e1-c996-c6f8-fc95e96dfbc1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_NGB_InjuredGnome_ThullaMurder:c6e29995-72e1-c996-c6f8-fc95e96dfbc1
msgctxt "h8e8b9a41ga4dcg44f4g8647g6c80c51431e7"
msgid "*The circle's hum grows to a buzz - the deceit in your words is clear.*"
msgstr "*공동체의 콧노래가 윙윙거리는 소리로 커집니다 - 당신 말의 기만은 명백합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_NGB_InjuredGnome_ThullaMurder
#. Speaker = Narrator
#. NodeID = c85ddb20-3bac-0f44-9fb3-f17723dccc02
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_NGB_InjuredGnome_ThullaMurder:c85ddb20-3bac-0f44-9fb3-f17723dccc02
msgctxt "hcedaac7fg872eg46d5g9e06gaf4c155e1243"
msgid ""
"*The circle's harmonies grow still, then surge again. In them, you hear both "
"goodwill and grief.*"
msgstr "*공동체의 하모니가 멈추었다 다시 치솟습니다. 그 안에서 당신은 안녕과 동시에 슬픔을 느낍니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_NGB_InjuredGnome_ThullaMurder
#. Speaker = Player
#. NodeID = dbfa8e9c-2928-4173-92c5-3473e96a1111
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_NGB_InjuredGnome_ThullaMurder:dbfa8e9c-2928-4173-92c5-3473e96a1111
msgctxt "h8bab2b54g0cfcg4902ga0bage9fa4cd6ea7e"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_NGB_InjuredGnome_ThullaMurder
#. Speaker = Player
#. NodeID = de96fef6-056b-ec84-25a8-dfa4537cdff6
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_NGB_InjuredGnome_ThullaMurder:de96fef6-056b-ec84-25a8-dfa4537cdff6
msgctxt "h3d60f737g80e2g4a0fga1fbg522832af97a7"
msgid "A dreadful accident. I meant to cure her, not harm her."
msgstr "끔찍한 사고였어. 해치려던 게 아니라 치료하려던 것이었는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_NGB_InjuredGnome_ThullaMurder
#. Speaker = Narrator
#. NodeID = e408c68d-3e9d-4413-b6bd-74424ed2c59b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_NGB_InjuredGnome_ThullaMurder:e408c68d-3e9d-4413-b6bd-74424ed2c59b
msgctxt "h24766cbegcdadg4e3ag9af0ga8f1a5268683"
msgid ""
"*The gnome was under the protection of the myconid circle. They will see you "
"answer for violating it.*"
msgstr "*이 노움은 마이코니드 공동체의 보호를 받고 있었습니다. 그들은 보호를 위반한 당신의 해명을 기다리고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_NGB_InjuredGnome_ThullaMurder
#. Speaker = Player
#. NodeID = f0db4cd3-c43c-441a-a7e5-fdd8f79a526e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_NGB_InjuredGnome_ThullaMurder:f0db4cd3-c43c-441a-a7e5-fdd8f79a526e
msgctxt "hcae51736g3693g46cbga549g9abccb3e507c"
msgid "She was in pain. I granted her mercy."
msgstr "그녀는 고통받고 있었어. 내가 그녀에게 자비를 베풀었지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_NGB_InjuredGnome_ThullaMurder
#. Speaker = Narrator
#. NodeID = f39a4839-cc89-4f72-90bf-343e27860a76
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GEB_UND_MyconidCircle_PersuadedOnce(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_NGB_InjuredGnome_ThullaMurder:f39a4839-cc89-4f72-90bf-343e27860a76
msgctxt "h8010e3c9g5443g42fbg83d3gdeb874dbd7db"
msgid "*The myconids will raise her husk. Life born from death - as penance.*"
msgstr "*마이코니드가 그녀의 껍데기를 일으킬 것입니다. 속죄의 뜻으로 죽음에서 태어난 생명입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_NGB_InjuredGnome_ThullaMurder
#. Speaker = Narrator
#. NodeID = f8b067c1-f1eb-00b1-2e34-0cad93916223
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_NGB_InjuredGnome_ThullaMurder:f8b067c1-f1eb-00b1-2e34-0cad93916223
msgctxt "h51b1befdg492fg4bbaga789g392f3f0a8482"
msgid ""
"*The myconids' harmonies waver, then resume. The notes carry a new air: "
"forgiveness.*"
msgstr "*마이코니드의 하모니가 약해지다 재개됩니다. 그 음표에는 이제 새로운 의미가 담겨 있습니다: 용서.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_OrbOfDarkvision_PAD_InteractingWithOrb
#. Speaker = Player
#. NodeID = 3338cdd1-b0d4-45cd-b259-17d22c6e2d28
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_OrbOfDarkvision_PAD_InteractingWithOrb:3338cdd1-b0d4-45cd-b259-17d22c6e2d28
msgctxt "h2741ddbcg6fe2g49dcg8479g9e4771088965"
msgid "Oh that's a familiar feeling. Darkness and loss."
msgstr "익숙한 느낌이야. 어둠과 상실이라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_OrbOfDarkvision_PAD_InteractingWithOrb
#. Speaker = Player
#. NodeID = 3338cdd1-b0d4-45cd-b259-17d22c6e2d28
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_OrbOfDarkvision_PAD_InteractingWithOrb:3338cdd1-b0d4-45cd-b259-17d22c6e2d28
msgctxt "h522b6f0cgdf38g4495g96c9g1a58ad458fd3"
msgid "Gods - this is pure shadow magic. To be one with the darkness and see."
msgstr "신이시여, 이건 순수한 그림자 마법이야. 어둠과 하나 되어 보는 것이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_OrbOfDarkvision_PAD_InteractingWithOrb
#. Speaker = Player
#. NodeID = 3338cdd1-b0d4-45cd-b259-17d22c6e2d28
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_OrbOfDarkvision_PAD_InteractingWithOrb:3338cdd1-b0d4-45cd-b259-17d22c6e2d28
msgctxt "h2e2a9639g805fg42c7gaebcg0dfa093db323"
msgid "I feel... empty. Totally empty."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_OrbOfDarkvision_PAD_InteractingWithOrb
#. Speaker = Player
#. NodeID = 3338cdd1-b0d4-45cd-b259-17d22c6e2d28
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_OrbOfDarkvision_PAD_InteractingWithOrb:3338cdd1-b0d4-45cd-b259-17d22c6e2d28
msgctxt "hb7befd47g8cf0g4080g9d44g64db2440cd53"
msgid "A great darkness stirs in me. In Vlaakith's name, what is this?"
msgstr "엄청난 어둠이 내 안을 휘젓는군. 블라키스 님의 이름으로, 이게 도대체 뭐지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_OrbOfDarkvision_PAD_InteractingWithOrb
#. Speaker = Player
#. NodeID = 3338cdd1-b0d4-45cd-b259-17d22c6e2d28
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_OrbOfDarkvision_PAD_InteractingWithOrb:3338cdd1-b0d4-45cd-b259-17d22c6e2d28
msgctxt "heb31d9d8g4bd8g4ff2g8c23ge473e552ba3d"
msgid "That feeling... Shar reaches out to me."
msgstr "이 느낌... 샤께서 내게 손길을 뻗었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_OrbOfDarkvision_PAD_InteractingWithOrb
#. Speaker = Player
#. NodeID = 3338cdd1-b0d4-45cd-b259-17d22c6e2d28
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_OrbOfDarkvision_PAD_InteractingWithOrb:3338cdd1-b0d4-45cd-b259-17d22c6e2d28
msgctxt "h24df392cgcb53g409bg9e03gfd0136d99305"
msgid ""
"Hells. I can feel only... shadows. They're clouding my thoughts, my memories."
msgstr "젠장. 그림자만... 느껴지네. 그것들이 내 생각과 기억들을 흐리고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_OrbOfDarkvision_PAD_InteractingWithOrb
#. Speaker = Player
#. NodeID = 3338cdd1-b0d4-45cd-b259-17d22c6e2d28
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: CLERIC_SHAR or PALADIN_SHAR
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_OrbOfDarkvision_PAD_InteractingWithOrb:3338cdd1-b0d4-45cd-b259-17d22c6e2d28
msgctxt "hda9ccfd6g3129g46efg9f2bg59a8851ef64d"
msgid "The Dark Lady's presence - she is here!"
msgstr "어둠의 여인의 존재감이야, 그분이 이곳에 있어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_OrbOfDarkvision_PAD_InteractingWithOrb
#. Speaker = Player
#. NodeID = 3338cdd1-b0d4-45cd-b259-17d22c6e2d28
#. HandlePath = TaggedText[7].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_OrbOfDarkvision_PAD_InteractingWithOrb:3338cdd1-b0d4-45cd-b259-17d22c6e2d28
msgctxt "hb021c4c2gc804g4767gbc76g0981f11df63a"
msgid "Something's off. Pure shadow - around me, inside me."
msgstr "뭔가 이상해. 순수한 어둠이 내 주변과 속을 뒤덮고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = 008f7379-28c2-4b72-2ddd-16292794491d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:008f7379-28c2-4b72-2ddd-16292794491d
msgctxt "h6f924c6fgffd6g40b3g9fcbgbc94bddffa70"
msgid "It sounds valuable. On second thought, I'll take it all."
msgstr "가치가 있을 것 같은데. 다시 생각해 보니, 그걸 전부 가져야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Narrator
#. NodeID = 00f54b59-f30e-93d2-a050-5961b565cfb1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:00f54b59-f30e-93d2-a050-5961b565cfb1
msgctxt "h89dc54b6g6bafg4b1fg8d07gcc0db34c3fc8"
msgid "*Vague notions of rumour and myth - nothing solid comes to mind.*"
msgstr "*소문과 신화라는 막연한 개념만 있을 뿐 확실한 것은 떠오르지 않습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = 018dc610-f109-4d40-bc63-385b8cd5840b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_EscapedGnome_State_GnomeSaved = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:018dc610-f109-4d40-bc63-385b8cd5840b
msgctxt "h30d296abgf98cg4c53g8cc0g3ae38306efb2"
msgid "Tell Laridda I'm dead. It's the best way."
msgstr "라리다에겐 내가 죽었다고 전해 줘. 그게 최선이니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = 049d5389-5507-8068-3c93-3a642e740bad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:049d5389-5507-8068-3c93-3a642e740bad
msgctxt "hf9fc3271g9546g4de8ga4dbgbefc1ee58598"
msgid "Don't be stupid. We're parting ways here. Up to you in how many pieces."
msgstr "멍청한 짓 하지 마. 우린 여기서 각자 갈 길을 가는 거야. 네가 온전히 떠날지는 네 선택이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = 06b3e8c5-a363-466d-af06-67db6085baa8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:06b3e8c5-a363-466d-af06-67db6085baa8
msgctxt "h324cc47bg0e02g41b4ga0e0g342e631d35f4"
msgid ""
"What's to say? You're Nere's bootlicker - saw you sail in. A godsdamned "
"<i>True Soul</i>."
msgstr "말할 게 뭐가 있어? 넌 니어의 아첨꾼이잖아. 네가 항해해 들어오는 걸 봤어. 망할 <i>참된 영혼</i> 자식."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = 10291469-973a-4a28-bba9-38562100fe59
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 9caf82c3-be62-a101-6e04-7d3916926e85_Mission = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:10291469-973a-4a28-bba9-38562100fe59
msgctxt "ha9b88035g1a5dg401bg92a7g509c68bcdc3d"
msgid ""
"I'll need to know a little more about your so-called 'mission' before I let "
"you go."
msgstr "널 풀어주기 전에 네 '임무'라는 거에 대해서 좀 알아야겠는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = 1601ecab-af22-40a1-9375-357fb5428f2e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:1601ecab-af22-40a1-9375-357fb5428f2e
msgctxt "he964eafdg5061g4096gadfag7d60e3d9a2d0"
msgid "Damn right, pecker. Now shut your face before I melt it clean off."
msgstr "그래 맞아, 이 좆같은 자식. 이제 내가 다 녹여주기 전에 입 닥쳐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = 180608a3-2ff0-5795-fe4b-2bd3d55e02b0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 9caf82c3-be62-a101-6e04-7d3916926e85_Mission = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:180608a3-2ff0-5795-fe4b-2bd3d55e02b0
msgctxt "hd5eff97agcddbg4741ga28fg6d5b70137aa9"
msgid "The mission comes first. A vial's what I can spare you."
msgstr "임무가 최우선이야. 작은 병 하나 정도는 나눠줄 수 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = 1a37e7bf-811b-4e69-898a-c8d733845a3f
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:1a37e7bf-811b-4e69-898a-c8d733845a3f
msgctxt "h5b6feae0gaafdg471aga15eg02e7a3ca3e85"
msgid "Are you sure about this? Once you're dead, that's it. It's over."
msgstr "확실해? 죽으면, 그게 전부야. 다 끝이라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = 1e5f8291-7712-7b89-5b2d-04a98760b265
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:1e5f8291-7712-7b89-5b2d-04a98760b265
msgctxt "h328dc493g6c92g4882gbf30gc8858c05af19"
msgid "<i>Runepowder</i>, you mean. Such a damned waste..."
msgstr "<i>룬파우더</i>겠지. 그런 낭비를..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = 1ff4e26f-7cb4-feee-2590-38800a3588ff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:1ff4e26f-7cb4-feee-2590-38800a3588ff
msgctxt "h6547c04agbf3fg4d1egaf2bg8407cb8712cb"
msgid "The powder's 'the reason you're here'? How so?"
msgstr "그 가루가 '너희가 여기 온 이유'라고? 어째서지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Karlach
#. NodeID = 207f8502-7afa-4508-bed1-ab730921bfa0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_KARLACH(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:207f8502-7afa-4508-bed1-ab730921bfa0
msgctxt "h7bcfd388g599eg4913gbe07g7541ab700537"
msgid "And I thought I'd heard it all. That's some cambion-level deception."
msgstr "말문이 막히는군. 그런 캠비온이나 할 법한 거짓말을 하다니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = 22e729f6-036e-ddb2-e2f3-dc6ce16a4118
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:22e729f6-036e-ddb2-e2f3-dc6ce16a4118
msgctxt "h6bb59ffeg4abcg4b17gaf1cgb7dd01decab4"
msgid "Your head. It will make a nice souvenir."
msgstr "네 머리를 가져가지. 기념품으로 좋겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = 23bfe73c-749a-1927-cf8f-c1a259c81c9b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:23bfe73c-749a-1927-cf8f-c1a259c81c9b
msgctxt "h531b45a0g4869g4aa7gbd8dg217191c94a2d"
msgid "I go where there's shit to stir. And there's no shortage of options."
msgstr "사고 칠 곳이 있다면 어디든 갈 거야. 선택의 폭이 아주 넓지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = 23d99a08-b05a-4fdf-8b2f-f39fdda6648e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_PanicRoom_Event_GnomeSuicide = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:23d99a08-b05a-4fdf-8b2f-f39fdda6648e
msgctxt "h68bb6ddcg5617g42f7gb310gf5b9eb9ade51"
msgid "Wait. What in the hells?"
msgstr "잠깐. 이게 무슨?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = 244862ca-1880-7638-310d-7fd6980f4ec4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 9caf82c3-be62-a101-6e04-7d3916926e85_PowderSmellsDifferent = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:244862ca-1880-7638-310d-7fd6980f4ec4
msgctxt "h0d3c14f2g0a77g4887g8a96g8602aca2a2a2"
msgid "Hold on. There's something different about that powder."
msgstr "기다려. 저 가루는 뭔가 다른 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = 25d0a4a4-d1de-2bdd-26b3-7d81a2b26e59
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:25d0a4a4-d1de-2bdd-26b3-7d81a2b26e59
msgctxt "h912d616bg83c2g4512gb03fg9351be758485"
msgid "Spit out what you want and let's be done with it."
msgstr "어서 원하는 걸 뱉어내고 끝내버리자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = 25de72fc-d4e1-91a6-43f0-1f540320912e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DUERGARDWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:25de72fc-d4e1-91a6-43f0-1f540320912e
msgctxt "ha5b80a0fg8dcbg42f0g8c2bge47cf5f815e0"
msgid "Call me a <i>hoon </i>again."
msgstr "날 한 번만 더 <i>훈</i>이라고 불러봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = 25de8179-4881-b874-9498-2ce77caaf205
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:25de8179-4881-b874-9498-2ce77caaf205
msgctxt "h70619457g94c5g4959gb866gff472ab9cc61"
msgid "<i>Take the vial.</i>"
msgstr "<i>병을 가져간다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = 2683f3d5-ede3-4b9a-b88e-551c63d65ba8
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:2683f3d5-ede3-4b9a-b88e-551c63d65ba8
msgctxt "h46811f8dg23bag4ae1gbfc7g2e09e0d4e177"
msgid "<i>Smile sincerely and hold out your hand.</i>"
msgstr "<i>진심을 다한 미소를 짓고 손을 내보인다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = 28b04394-b47f-1321-4e3e-cdf3f5165cf7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_EscapedGnome_Event_KnowsTookSmokepowder = False
#.   Local:
#.      - 9caf82c3-be62-a101-6e04-7d3916926e85_HeardRunepowder = True
#. SetFlags:
#.   Global:
#.     - UND_EscapedGnome_State_GnomeSaved = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:28b04394-b47f-1321-4e3e-cdf3f5165cf7
msgctxt "h8d575640g9d9ag42e1g8fbbg80ca1e0ca3bd"
msgid "I'm getting the runepowder back to Baldur's Gate. Alone."
msgstr "난 이 룬파우더를 가지고 발더스 게이트로 돌아갈 거야. 혼자서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = 28d0c9a7-3597-4c76-a13e-b3a0804656f2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_PanicRoom_Event_GnomeSuicide = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:28d0c9a7-3597-4c76-a13e-b3a0804656f2
msgctxt "h124b49a9g87c2g43f7gb382gda75acbad6ce"
msgid "I knew I couldn't trust you. Do it, then. Make it <i>hurt.</i>"
msgstr "넌 믿을 수 없는 놈이란 걸 알았어. 그럼, 해봐. 날 <i>아프게 해보라고.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = 29c227fd-c0e7-7068-1ee5-dc35d8656fca
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DRAGONBORN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:29c227fd-c0e7-7068-1ee5-dc35d8656fca
msgctxt "h284188afg4e9bg4a04g9f5bga2efc69a7ea8"
msgid "So you'll just leave your clan behind?"
msgstr "그럼 네 집단을 그냥 버리고 가겠다는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = 29da8310-9ae4-4aae-a1df-d3c58c0e177d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_EscapedGnome_Event_KnowsTookSmokepowder = False
#.      - UND_ArguingGnomes_Event_LearnedAboutPhilomeen = True
#. SetFlags:
#.   Global:
#.     - UND_EscapedGnome_Quest_OfferedPowder = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:29da8310-9ae4-4aae-a1df-d3c58c0e177d
msgctxt "ha9a8b3a1g8d69g47b6g94a3g2bf363799761"
msgid "What I want is your help. Beldron's trapped - I need the smokepowder."
msgstr "난 네 도움이 필요해. 벨드론이 갇혔어. 그 화약이 필요해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = 2c015b4b-1621-dc1e-d683-3814c6de4ef3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:2c015b4b-1621-dc1e-d683-3814c6de4ef3
msgctxt "h4fea23bbg8bffg4f21g8c10g1e28b11e0540"
msgid "You want to barter with <i>runepowder</i> -"
msgstr "<i>룬파우더</i>랑 거래를 하고 -"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = 2f196908-929d-cdcf-8246-82b28628e8f6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:2f196908-929d-cdcf-8246-82b28628e8f6
msgctxt "h32f9992cg8430g4619g8556gd98c86aca003"
msgid ""
"Let me go, and you'll be on the right side of history - that's all I can say."
msgstr "날 보내주면, 네가 역사에서 옳은 편에 서게 될 거야, 그것만 말해 주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = 2fc116c7-cf51-4f9e-92a5-119544df177a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 9caf82c3-be62-a101-6e04-7d3916926e85_MindHasBeenRead = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:2fc116c7-cf51-4f9e-92a5-119544df177a
msgctxt "hcd01e3c4g951eg440dgb1a3gbc0c844ad4a9"
msgid ""
"You will not serve Ironhand in death. But you might still serve him in life."
msgstr "아이언핸드를 죽어서 섬길 순 없어. 하지만 살아서라면 가능할지도 모르지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = 315f41e2-d1f9-4f4e-9be6-1dba8389379f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:315f41e2-d1f9-4f4e-9be6-1dba8389379f
msgctxt "h47373022g6d86g41afg9c01gee87cdcfb4f8"
msgid "You want to waste<i> runepowder </i>on -"
msgstr "<i>룬파우더를 </i>어디 -"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = 32adff78-12c1-4792-5e91-0a25af71960b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_IronhandGnomes_Knows_Runepowder = True
#.   Tag:
#.      - GNOME(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:32adff78-12c1-4792-5e91-0a25af71960b
msgctxt "h726ab36ag6047g4004ga7a8gf7ccd957a8b7"
msgid "'Runepowder'? I thought that was a children's story."
msgstr "'룬파우더'라고? 그건 아이들의 동화에나 나오는 건 줄 알았는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = 3336bc25-e8fb-8ba6-6eb9-b30ab2fc65f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:3336bc25-e8fb-8ba6-6eb9-b30ab2fc65f3
msgctxt "h73b6f7b0g56bdg4cc3g9dbag467e580d0ce9"
msgid "Dead? Of <i>course. </i>They should have run, had every chance."
msgstr "죽었다고? <i>당연한 일이야. </i>기회는 많았어, 도망쳤어야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = 346fff84-852c-5291-7ba7-889db73525c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:346fff84-852c-5291-7ba7-889db73525c8
msgctxt "h255c2aa8gf155g4146gbaa2gf4ae13652ceb"
msgid "Try me."
msgstr "해 보시지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Lae'zel
#. NodeID = 35f0c122-116f-48dd-85f9-b22afe80b7fc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(2) = True
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:35f0c122-116f-48dd-85f9-b22afe80b7fc
msgctxt "h2904cc51g199ag4528g944fg76129bfb7b69"
msgid "She's heartless. <i>Delicious.</i>"
msgstr "아주 비정하군. <i>냄새가 좋아.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = 383dcf77-6e73-4230-9b87-f9b7858ba5e6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - UND_HiddenGnome_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:383dcf77-6e73-4230-9b87-f9b7858ba5e6
msgctxt "he34cf993gb270g4797gbcbfg7f64a4aa8824"
msgid ""
"<i>Hold it. </i>I swear to Ironhand<i>, </i>one more step and I blow us to "
"chunks!"
msgstr "<i>멈춰. </i>아어언핸드에 맹세코<i>, </i>한 발자국이라도 더 다가왔다간 모두를 가루로 만들어 버릴 테니까!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = 38525543-b97f-472d-af6c-7877226a2b75
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:38525543-b97f-472d-af6c-7877226a2b75
msgctxt "hf316aa4eg66d0g4432gb506ge5623f2a8b4c"
msgid ""
"<i>Drugh. </i>Dropping my name like your cultist arse <i>knows</i> me. Like "
"we're <i>friends.</i>"
msgstr ""
"<i>Drugh. </i>너희 같은 광신도 멍청이들이 날 <i>알기라도</i> 한다는 듯이 내 이름을 부르지 마. <i>친구인 척하지 "
"말라고.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = 38714205-734b-c255-8d79-eae687cc89cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:38714205-734b-c255-8d79-eae687cc89cb
msgctxt "h1e77d643g696eg4f83g9d5cg574f0972d1ea"
msgid "Words. I'm about more than that."
msgstr "말뿐이군. 그것보단 많은 게 필요해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = 39441346-5fde-8538-8ce9-9b5cc083d156
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:39441346-5fde-8538-8ce9-9b5cc083d156
msgctxt "h7a1e65f6g789ag4defg801eg98b64a2e4eee"
msgid "<i>Drugh. </i>F-fine."
msgstr "<i>Drugh. </i>조-좋아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Karlach
#. NodeID = 3fa9217c-4d1c-4d37-829e-3d88afc0e06c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_KARLACH(4) = True
#. SetFlags:
#.   Local:
#.     - 9caf82c3-be62-a101-6e04-7d3916926e85_Inclusion = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:3fa9217c-4d1c-4d37-829e-3d88afc0e06c
msgctxt "he2fe0884g89cdg4b01g894fgc9967109b1f5"
msgid "She's gonna blow up. That's <i>my </i>thing."
msgstr "그녀는 폭발할 거야. 그건 <i>내가</i> 전문인데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = 409d56c6-bff3-7a8d-129b-a821b14d7b0c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_ArguingGnomes_Event_LearnedAboutPhilomeen = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:409d56c6-bff3-7a8d-129b-a821b14d7b0c
msgctxt "h69d4dc02ge08cg4c9ag8150g203227d8f41b"
msgid "You'd abandon your beloved? That's mighty cruel of you."
msgstr "널 사랑하는 이들을 떠나겠다고? 그것참 잔인하네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Lae'zel
#. NodeID = 4164ce0d-f036-41bd-a485-91067dafcafa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(2) = True
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
#. SetFlags:
#.   Local:
#.     - 9caf82c3-be62-a101-6e04-7d3916926e85_Inclusion = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:4164ce0d-f036-41bd-a485-91067dafcafa
msgctxt "h703ef1cdg8844g423bg80beg7b420704a102"
msgid "<i>Chk</i> - the gnome's well and truly <i>mad.</i>"
msgstr "<i>츠크</i>. 이 노움은 아주 제대로 <i>정신이 나갔군.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = 42a5d978-1a09-459c-acfd-d4f81f0da637
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_ArguingGnomes_Event_LearnedAboutPhilomeen = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:42a5d978-1a09-459c-acfd-d4f81f0da637
msgctxt "h29a17755g5bbeg46ffgb6feg1742f73a30ba"
msgid "Philomeen, I presume. What's going on here?"
msgstr "네가 필로민이겠군. 여기서 뭘 하고 있는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = 4306ce1b-f8d1-4282-80c1-67a4b2b30263
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:4306ce1b-f8d1-4282-80c1-67a4b2b30263
msgctxt "h0761ad59ge22ag4331gb40agb6135b966811"
msgid ""
"Laridda? <i>Drugning</i> mind games. I know all about your tricks, True Soul."
msgstr "라리다? <i>드루그닌</i> 속임수야. 너희 기만질에 대해선 알고 있다고, 참된 영혼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = 43765603-9aae-c9b5-bf21-b9d331188d7d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:43765603-9aae-c9b5-bf21-b9d331188d7d
msgctxt "h7ab78dcbg48e7g4df8gb8dcg78ee1c0ec52a"
msgid "But let me go... and maybe I'll spare you a vial."
msgstr "하지만 날 보내준다면... 작은 병 하나 정도는 나눠줄 수 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = 44708f06-0108-9cb4-2c92-c7a5b094e6ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:44708f06-0108-9cb4-2c92-c7a5b094e6ed
msgctxt "h85bc8200ge1a5g452agb712g3eb2329e35bb"
msgid "What use is a single vial?"
msgstr "고작 한 병을 어디에 쓰라고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = 4582bb49-6221-1fd7-bf14-aafdbad2b868
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_EscapedGnome_Event_KnowsTookSmokepowder = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:4582bb49-6221-1fd7-bf14-aafdbad2b868
msgctxt "h487825f4gba55g493cg8899g2d29ddc8a11b"
msgid "How about a little of that smokepowder?"
msgstr "그 화약을 좀 나눠주는 건 어때?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = 47e2da2e-c4cf-6c89-9e32-c399024a53e3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_EscapedGnome_Event_KnowsTookSmokepowder = True
#.      - UND_ArguingGnomes_Quest_Accepted = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:47e2da2e-c4cf-6c89-9e32-c399024a53e3
msgctxt "h06098f46g09e3g424ag836eg210a316d0e17"
msgid "I don't want you. I just wanted the smokepowder."
msgstr "넌 필요 없어. 그냥 그 화약만 있으면 돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = 5081cc87-bc21-4bcc-8b21-b70d05e83a7e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 9caf82c3-be62-a101-6e04-7d3916926e85_MindHasBeenRead = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:5081cc87-bc21-4bcc-8b21-b70d05e83a7e
msgctxt "h790adce1g277fg4ffegb0b6g8a4b9fe9407c"
msgid ""
"<i>Gaerdal Ironhand, I have lived for you, and now I'll die for you!</i>"
msgstr "<i>게르달 아이언핸드시여, 그대를 위해 살아왔으니, 이제 그대를 위해 죽겠습니다!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = 5258879e-91d3-40fc-a2e6-bfe1c65db17d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:5258879e-91d3-40fc-a2e6-bfe1c65db17d
msgctxt "h9b27a792gb3dfg4da3gb03eg0f2a6b55138e"
msgid "Not a True Soul? And I'm - I'm supposed to believe that?"
msgstr "참된 영혼이 아니라고? 나 - 나더러 그걸 믿으라는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = 53f746cd-10d9-3603-6256-5db4d73dc3fb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:53f746cd-10d9-3603-6256-5db4d73dc3fb
msgctxt "h4b1c58a5g3dc7g430dgb960g70ef4de66e53"
msgid "Then prove it and leave."
msgstr "그럼 그걸 증명하고 떠나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Philomeen
#. NodeID = 540c14bd-5aea-c39c-3941-cb362d9a6d71
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_ArguingGnomes_Event_LearnedAboutPhilomeen = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:540c14bd-5aea-c39c-3941-cb362d9a6d71
msgctxt "h70d13a7cgf97dg4a08gbe61g393a616c3846"
msgid "Listen..."
msgstr "이봐..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Wyll
#. NodeID = 54901145-e3db-47c5-8561-d93cfdbbdd31
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_WYLL(6) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:54901145-e3db-47c5-8561-d93cfdbbdd31
msgctxt "h1ace7903gda0cg4c78gbda8g1b457a1a4f4e"
msgid "She's leaving? Laridda will be heartbroken."
msgstr "떠나는 거야? 라리다가 상처를 받겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Narrator
#. NodeID = 561d5eb5-3fb1-5a37-ff76-df817e6c1175
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome:561d5eb5-3fb1-5a37-ff76-df817e6c1175
msgctxt "h80def2d8g56a3g496ag8b88g14954ca5232b"
msgid ""
"*A formula so dangerous it was stricken from history - if it ever existed to "
"begin with.*"
msgstr "*너무 위험한 제조법이라 마치 애초에 존재하지 않았던 것처럼 역사에서 지워졌습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PanicRoom_HiddenGnome
#. Speaker = Player
#. NodeID = 569d3b1a-f10f-4694-bfc0-0e7c354dfa4c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 0
#. CheckFlags:
