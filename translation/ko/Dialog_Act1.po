msgid "It feels like... my magic is getting drained!"
msgstr "마치... 내 마법을 빨아들이고 있는 느낌이야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_SussurTree_PAD_Aura
#. Speaker = Player
#. NodeID = 7f5964d1-16b2-f671-90da-defcb31daa65
#. HandlePath = TaggedText[8].TagText[0]
