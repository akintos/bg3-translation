msgctxt "hdcbd5f1fgb37cg4a97gb5fbg6ff7b15d2935"
msgid ""
"Urh...  <i>drow</i>. No hurt me, goblin-mistress. Me good. Me kill for you."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeWorg1
