msgstr "너는 누구지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_YouthTraining_GithBoy_Dead
#. Speaker = Narrator
#. NodeID = daf7f575-9086-4c20-9385-fc8a0b12b8ea
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
