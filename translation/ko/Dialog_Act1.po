msgctxt "h7c8dce88g90fcg47d2g86d5gf142a873e1fb"
msgid "*The spell's power wanes. You can ask no more questions.*"
msgstr "*주문의 힘이 약해집니다. 더 이상 질문할 수 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_UnfortunateGnome_Dead
