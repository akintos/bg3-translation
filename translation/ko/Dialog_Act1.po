msgctxt "h7a972cf5g93c9g432cgabedg36e7b8f185bc"
msgid "Whatever's wrong with you, I hope it's not contagious."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_LoyalFollowUp
#. Speaker = Narrator
#. NodeID = 2e542786-2e43-4740-8092-b37a2282de71
