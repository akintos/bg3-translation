msgctxt "hc2fadbd8ge2dag494fg9969gf421431d4c05"
msgid ""
"You could stand to speak to your wife with a little more respect, Baelen."
msgstr "당신 아내에게 조금 더 존중을 담아서 말할 수도 있을 텐데요, 베일렌."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter_ThreewayDialogAfterBaelenAteMushroom
#. Speaker = Baelen Bonecloak
#. NodeID = 600c7186-6efa-fb07-f194-d9c5eb01809c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter_ThreewayDialogAfterBaelenAteMushroom:600c7186-6efa-fb07-f194-d9c5eb01809c
msgctxt "h50063afdg1c44g4749ga8d4ge18a4ff9f700"
msgid "Remember how you used me like a mule?"
msgstr "날 노새처럼 부렸던 거 기억나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter_ThreewayDialogAfterBaelenAteMushroom
#. Speaker = Baelen Bonecloak
#. NodeID = 6c1b4a68-af33-0843-93d1-d24bfea0d7e7
