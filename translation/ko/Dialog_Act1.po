msgctxt "h8efac2f8gb7b9g4bb2ga71bgd1f96beb5d7c"
msgid "Xargrim... conjurer...  <i>seeker</i>..."
msgstr "자그림... 조형술사... <i>탐구자</i>..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_MyconidDrow_Dead
#. Speaker = Narrator
#. NodeID = 9a247d3b-2ec2-4bda-9f00-39b39874c08e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_MyconidDrow_Dead:9a247d3b-2ec2-4bda-9f00-39b39874c08e
msgctxt "h0c7a6b1dg22c2g4762g9742g461d17b2d667"
msgid "*The corpse does not stir. It will answer no more questions.*"
msgstr "*시체는 움직이지 않습니다. 더 이상 질문을 받지 않을 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_MyconidDrow_Dead
#. Speaker = Narrator
#. NodeID = 9bc81490-87c7-4260-b583-4e7af85c3812
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_MyconidDrow_Dead:9bc81490-87c7-4260-b583-4e7af85c3812
msgctxt "h19434812gc057g459dg8379gc6ee6394d76c"
msgid "*The corpse regards you lifelessly.*"
msgstr "*시체가 생기 없는 모습으로 당신을 맞이합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_MyconidDrow_Dead
#. Speaker = Player
#. NodeID = a5800e1e-c5cf-4320-bebc-6020214b50d3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_MyconidDrow_Dead:a5800e1e-c5cf-4320-bebc-6020214b50d3
msgctxt "h383b4005g75f1g4cc0g9f06ge441ac76fb54"
msgid "Who are you?"
msgstr "너는 누구지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_MyconidDrow_Dead
#. Speaker = Narrator
#. NodeID = b689ca61-fd22-4d6e-8fc4-71842963f681
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_MyconidDrow_Dead:b689ca61-fd22-4d6e-8fc4-71842963f681
msgctxt "ha449a83ag9cabg4934ga122gffc2aafb358e"
msgid "*The spell's power wanes. You can ask no more questions.*"
msgstr "*주문의 힘이 약해집니다. 더 이상 질문을 할 수 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_MyconidDrow_Dead
#. Speaker = Pale Corpse
#. NodeID = bc463099-29ee-466e-a4b1-55a53649a491
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_FurnaceSearch_Knows_XargrimSummonedSpectator = True
#.   Local:
#.     - 6319f596-fb3f-b5af-c1f4-8e98d085c83e_MentionedFight = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_MyconidDrow_Dead:bc463099-29ee-466e-a4b1-55a53649a491
msgctxt "hda8c9c90gf99bg48d7gbbdbgbe77da1ce72c"
msgid "Battle... with rival... summoned <i>spectator</i>..."
msgstr "경쟁자와... 전투 중에... <i>스펙테이터</i>를 소환했지..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_MyconidDrow_Dead
#. Speaker = Player
#. NodeID = bcdead4c-d614-5bfb-c493-34e40aae3e68
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_FurnaceSearch_State_FoundDisguisedJournal = True
#.      - UND_MyconidDrowDead_State_ToldBook = False
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_MyconidDrow_Dead:bcdead4c-d614-5bfb-c493-34e40aae3e68
msgctxt "h6df11efbg1b7dg4f59ga61eg704a6eb86aab"
msgid "What is this book I found next to you?"
msgstr "네 곁에 있던 이 책은 뭐지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_MyconidDrow_Dead
#. Speaker = Pale Corpse
#. NodeID = c9d0e56e-3d63-7420-14c2-29856b86adb9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_MyconidDrowDead_State_ToldFurnaceSearch = True
#.     - UND_MyconidDrowDead_State_ToldBook = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_MyconidDrow_Dead:c9d0e56e-3d63-7420-14c2-29856b86adb9
msgctxt "h7c3cfa1cg33bag43edg9b50g0c24f7416ac2"
msgid "... the secret... to mastering the Adamantine Forge..."
msgstr "... 비밀... 아다만틴 대장간에 통달할 수 있는..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_MyconidDrow_Dead
#. Speaker = Player
#. NodeID = e67d3913-9825-c3fe-b41a-90da722d6f3c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_MyconidDrowDead_State_ToldKeys(1) = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_MyconidDrow_Dead:e67d3913-9825-c3fe-b41a-90da722d6f3c
msgctxt "hdde00934g4c24g4ed1g9cf6gf5abdbfd0b95"
msgid "What was your knowledge of the Forge?"
msgstr "네가 지닌 대장간에 관한 지식은 뭐였지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_MyconidDrow_Dead
#. Speaker = Pale Corpse
#. NodeID = eda73439-b9c7-4222-d2bf-319e165511ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_MyconidDrow_Dead:eda73439-b9c7-4222-d2bf-319e165511ed
msgctxt "h331fee2cga7a8g4c60g8fffg1c5563f8dc79"
msgid "... secret... to its operation..."
msgstr "... 그것을 가동하는... 비밀..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_MyconidDrow_Dead
#. Speaker = Pale Corpse
#. NodeID = eebcf9ca-eccb-c4b5-bdd9-a281fdd168bb
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - UND_MyconidDrowDead_State_ToldKeys(1) = True
#.   Global:
#.     - UND_FurnaceSearch_Knows_Rivalry = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_MyconidDrow_Dead:eebcf9ca-eccb-c4b5-bdd9-a281fdd168bb
msgctxt "haffa35aaga047g45e6gae72g0a18b96177b4"
msgid "... Filro... Dhourn... each held knowledge... none... would share..."
msgstr "... 필로... 도운... 각자 지식을 지니고 있었지... 아무도... 공유하지는 않을..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_MyconidDrow_Dead
#. Speaker = Pale Corpse
#. NodeID = f366dc39-d267-cdb9-fdd2-38d59824e50d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_AdamantineForge_Knows_WhatForgeIs = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_MyconidDrow_Dead:f366dc39-d267-cdb9-fdd2-38d59824e50d
msgctxt "h5454877fg1e61g442fga56cg4d11f84f523c"
msgid ""
"... lost workshop... of Silouv Yali... finest weapons... in all creation..."
msgstr "... 실로우브 얄리의... 잃어버린 작업장... 모든 창조물 중... 최고의 무기들..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = 025bd7bd-bc9d-356d-ab49-3cc1a2de78f2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:025bd7bd-bc9d-356d-ab49-3cc1a2de78f2
msgctxt "hbc9db0a0g996eg45bcgaeb6g523d8c362d32"
msgid ""
"Only Wulbren couldn't leave the stories be - so he went and bloody <i>found "
"</i>it. A small supply, tucked away down here with a manuscript."
msgstr ""
"울브렌만은 그걸 이야기로 남겨둘 수 없었어. 그래서 그는 직접 가서 기어코 그것을 <i>발견했지</i>. 이곳에 원고와 함께 작은 "
"보급품이 숨겨져 있었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = 0278adad-c9de-6f7b-d429-a809198c148a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:0278adad-c9de-6f7b-d429-a809198c148a
msgctxt "hf4b56238g4d25g4cb8ga814g5e097baa2ec2"
msgid "You really would, wouldn't you? But not us."
msgstr "진짜 그렇게 해줄 거야? 하지만 우린 할 수 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Player
#. NodeID = 07cc9574-6c5a-31af-2b82-7166f2c1ab8a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:07cc9574-6c5a-31af-2b82-7166f2c1ab8a
msgctxt "h62684ce8gfe02g4be2gafceg62a23926b6ce"
msgid "Surely you can do me a little more honour than that."
msgstr "분명 그보단 더 많은 보상을 줄 수 있을 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = 0c723f92-05e3-d9ed-0c63-bf2302c23a15
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_Mutineers_Event_FailedtoFreeGnomes = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:0c723f92-05e3-d9ed-0c63-bf2302c23a15
msgctxt "h1cdce507g8247g4f87g9574g2c31b9de728b"
msgid ""
"There's little we can do to stop them from here, I'm afraid. We have our own "
"freedom to look to."
msgstr "안타깝게도 놈들을 막기 위해 우리가 이곳에서 할 수 있는 일은 별로 없어. 우리 자유를 쟁취하기도 바빠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Player
#. NodeID = 0d999953-2d4d-1fce-4fd2-d09b0455a8a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:0d999953-2d4d-1fce-4fd2-d09b0455a8a5
msgctxt "hfd9f1ceaga4a0g4967g9bc3g00c41eca7e7e"
msgid "If it's truly that powerful, then we can't let the cult have it."
msgstr "그 물건이 실제로 그렇게 강력하다면, 광신도 집단의 손에 들어가게 둘 수 없지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = 0f2aaaa0-03e9-5852-0e62-036cf4108dcc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:0f2aaaa0-03e9-5852-0e62-036cf4108dcc
msgctxt "h75b7e801gc4ccg4c60g8882gd2d28cd85d82"
msgid "Maybe Wulbren can hold out. Either way, he's beyond our help now."
msgstr "울브렌이 저항할 수 있을지도 모르지. 어느 쪽이든, 우리가 도울 수 있는 선은 벗어났어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = 0f3b349e-3ec1-2013-261a-d5b1f5625f78
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:0f3b349e-3ec1-2013-261a-d5b1f5625f78
msgctxt "hc6fe6b2dg512dg4605gab4fg5f9b0fb104f2"
msgid "As for Wulbren... we can only hope they'll make his end swift."
msgstr "울브렌에 관해서는... 놈들이 고통 없이 보내주길 바라는 수밖에."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = 1639051c-f146-c2e1-b6dd-288d8126fdcc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:1639051c-f146-c2e1-b6dd-288d8126fdcc
msgctxt "hf98ad8eeg4e45g4f30g8b10g0d5c98d2be01"
msgid ""
"Wulbren knew the risks when he came in search of runepowder. We all did."
msgstr "울브렌은 룬파우더를 찾는 일이 얼마나 위험한지 알고 있었어. 우리 모두 그랬지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Lunkbug
#. NodeID = 16f13bb3-20b3-b77f-8b4c-a16ddf0e65fe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_State_LeaderFreedGnomes = False
#.      - UND_TheDrowNere_State_PermaDefeated = True
#.      - UND_DuergarMutineers_State_PermaDefeated = True
#. SetFlags:
#.   Global:
#.     - UND_State_LeaderFreedGnomes = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:16f13bb3-20b3-b77f-8b4c-a16ddf0e65fe
msgctxt "hbbe0d791g3d9eg422eg9d6fgc6903d002881"
msgid "Beldron - I was so worried! Did Nere hurt you?"
msgstr "벨드론 - 무척 걱정했다고! 니어가 너를 다치게 했어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = 1914fe1f-cea0-5b06-8ded-81dc8acf1103
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_State_LeaderFreedGnomes = False
#.      - UND_TheDrowNere_State_PermaDefeated = True
#.      - UND_DuergarMutineers_State_PermaDefeated = False
#. SetFlags:
#.   Global:
#.     - UND_GnomeForeman_Event_StillSlavesDialogue = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:1914fe1f-cea0-5b06-8ded-81dc8acf1103
msgctxt "hae4ecba0gb0b9g4241g842eg6ca4296e09cc"
msgid "We'll all be free yet. The Ironhands always find a way."
msgstr "우린 모두 곧 자유로워질 거야. 아이언핸드는 언제나 방법을 찾으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = 19214a64-425a-869b-99d0-329ad1b8162b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:19214a64-425a-869b-99d0-329ad1b8162b
msgctxt "h223e4edbgbfc9g49d0g86bdg42a4ecf23240"
msgid ""
"My people will find somewhere to regroup across the lake. Then on to the "
"city."
msgstr "내 동족들은 호수 건너편에서 재집결할 곳을 찾을 거야. 그리고 도시로 향해야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Player
#. NodeID = 1f318b52-474f-5678-3e48-a2cf8a74ddad
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_IronhandGnomes_Knows_BarcusWulbren = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:1f318b52-474f-5678-3e48-a2cf8a74ddad
msgctxt "h0b293d5eg8fbcg4ff6ga40fg1d1f68ecb829"
msgid "Who's Wulbren?"
msgstr "울브렌이 누구야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = 27385e51-91a8-e8c7-2520-22eab2f3ee8d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:27385e51-91a8-e8c7-2520-22eab2f3ee8d
msgctxt "h7ddd5c4cg5633g4fb8gb18fge41146703c2a"
msgid "No, no - I'm all right. Did the sergeant hurt <i>you?</i>"
msgstr "아니, 아니 - 나는 괜찮아. 그 하사관이 <i>너를</i> 다치게 했어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = 2b952f9e-6727-0099-e5f2-0ef1f59b6ecd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:2b952f9e-6727-0099-e5f2-0ef1f59b6ecd
msgctxt "hb6252170gfad3g41ebg8829g9c472c0dc6d3"
msgid "I try not to need saving. Hasn't much worked out, as you can see."
msgstr "난 도움을 받지 않으려고 해. 그런데 보다시피, 잘 안 되네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Player
#. NodeID = 2be31d5b-d9ce-8f6b-4b84-f05e12ffdbfd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:2be31d5b-d9ce-8f6b-4b84-f05e12ffdbfd
msgctxt "h1554a48fg28ddg42b2g8699g1709bd320ab7"
msgid "You <i>say</i> you're grateful - but my coinpurse is still light."
msgstr "<i>말로는</i> 고맙다고 하지만, 여전히 성의는 보이지 않는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Player
#. NodeID = 2c9a986c-3e58-fce7-d8c7-3b0ec8055248
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:2c9a986c-3e58-fce7-d8c7-3b0ec8055248
msgctxt "h47291315g0a73g490cg9f77gff9c25fe2885"
msgid "Then we'll just have to free him first."
msgstr "그렇다면 그를 풀어주는 것이 우선이겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = 2da7d195-9721-77ab-fe8b-d93af152e4f9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - LocalFlag_01 = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:2da7d195-9721-77ab-fe8b-d93af152e4f9
msgctxt "h8ce53631gf5ffg478bg98abg6b941f6432c2"
msgid "I've had fights enough for one day, Barcus."
msgstr "이미 오늘치 싸움은 다 했어, 바커스."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Player
#. NodeID = 2f46d6c7-0266-d20d-0bf4-9a81fa1f8ec2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:2f46d6c7-0266-d20d-0bf4-9a81fa1f8ec2
msgctxt "h04ef06d4g9b3ag42f2g90b8gdd94eeea97aa"
msgid "If my path takes me to Moonrise, I'll see about freeing Wulbren myself."
msgstr "내가 문라이즈로 가게 되면, 울브렌을 구할 방법을 직접 알아볼게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Player
#. NodeID = 3809bafa-4fdf-37f4-6c2e-15af9b4a2c2d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Global:
#.      - GLO_IronhandGnomes_Knows_Runepowder = False
#.   Tag:
#.      - BARBARIAN(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:3809bafa-4fdf-37f4-6c2e-15af9b4a2c2d
msgctxt "h875c1338g39ecg47c4ga8d4g10a79bfc3db0"
msgid "I also like to know things. Start talking."
msgstr "나도 좀 알고 싶은걸. 당장 털어놔."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = 3a1bbc4b-7d96-957b-abc6-27d2c3cdc43d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:3a1bbc4b-7d96-957b-abc6-27d2c3cdc43d
msgctxt "hff368b29g013bg4a6fg94cdg4d913a07d9f2"
msgid ""
"Glittering gods. I should've know that one was too damn stubborn to die."
msgstr "눈부신 신들이시여. 그 애는 죽기에 너무 고집이 세다는 걸 알았어야 했는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = 3c8f1d1b-bee3-6729-84f8-f95e8d170375
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:3c8f1d1b-bee3-6729-84f8-f95e8d170375
msgctxt "hec01fa41g831ag4fc6gb004g62578115b745"
msgid ""
"And he was bloody right. He found it - a small cache sitting down here with "
"a manuscript."
msgstr "그리고 그의 말이 맞았지. 그가 찾아낸 거야, 여기 작은 은닉처가 있었어, 필사본과 함께."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = 3e98b3b2-caf8-0470-6fa2-288809f89564
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_Mutineers_Event_FailedtoFreeGnomes = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:3e98b3b2-caf8-0470-6fa2-288809f89564
msgctxt "h61fe1406g963fg4e0fgb8afg19bcd14c3977"
msgid ""
"We have our own freedom to look to, I'm afraid. We'll take our chance when "
"it arises, then back to the city."
msgstr "안타깝게도, 지금은 우리 자유를 쟁취하기도 바빠. 기회가 온다면 그걸 잡아서 도시로 돌아가야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Lunkbug
#. NodeID = 408b4ad5-9ab3-76b5-653c-8cefd6ac2c98
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_TheDrowNere_State_PermaDefeated = True
#.      - UND_DuergarMutineers_State_PermaDefeated = True
#. SetFlags:
#.   Global:
#.     - UND_State_LeaderFreedGnomes = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:408b4ad5-9ab3-76b5-653c-8cefd6ac2c98
msgctxt "h48acdc45g4f79g4de9g88d5ga89db1679bd2"
msgid "Beldron - thank Ironhand!"
msgstr "벨드론 - 아이언핸드님께 감사를!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = 4310ae5d-604f-b591-b977-422222f70933
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:4310ae5d-604f-b591-b977-422222f70933
msgctxt "h1d287318g4a81g4aabg8ed0gb47aac9bebd3"
msgid "We ought to thank someone a little closer by, I think."
msgstr "조금 더 가까이 있는 사람에게 감사를 빚진 것 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = 44391087-9d45-674f-0f89-178a41e645ad
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 94cd662c-844b-4dcc-ffdc-0b9a8da32bcc_BarcusInsultedBeldron = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:44391087-9d45-674f-0f89-178a41e645ad
msgctxt "hb7043f54ge5dag4ee5gab6dg94ad2190aca8"
msgid ""
"If you knew half as much as you think, my lad, Wulbren might have kept you "
"around."
msgstr "친구, 네가 안다고 믿는 것의 절반만 잘 알았어도, 울브렌이 너를 계속 곁에 두었을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = 486a1bc2-ee73-cfff-d4b5-c3d4b89dff1a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:486a1bc2-ee73-cfff-d4b5-c3d4b89dff1a
msgctxt "h36818340g14d3g4e8agbb2bgb2cb79775c05"
msgid "It doesn't matter. We can't help him from here."
msgstr "상관없어. 이곳에선 그를 도울 수 없으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = 488ad806-bb52-d32d-79e0-d52502dfedc0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:488ad806-bb52-d32d-79e0-d52502dfedc0
msgctxt "h5a028390g20bfg4d29gb5fcga75ed6b3462c"
msgid ""
"He'd just made sense of the formula when the cult jumped us - so he "
"<i>burned </i>the damn thing."
msgstr "그는 광신도 집단이 우리를 덮쳤을 때 막 공식을 알아냈지. 그래서 그 망할 것을 <i>불태워버린</i> 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = 4a841df0-1121-25fc-b442-5a2a8c7116f7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:4a841df0-1121-25fc-b442-5a2a8c7116f7
msgctxt "h008a92b2gc7e2g486cga92ag05209d6ca853"
msgid "I'm taking the rest of us 'cross the lake. Safer shores and all that."
msgstr "나머지 이들을 호수 너머로 데려갈 거야. 더 안전한 해안으로 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = 4a8d894c-6bcd-4d32-afa2-d8328213752e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:4a8d894c-6bcd-4d32-afa2-d8328213752e
msgctxt "hf53a34d9g46ccg4284g991egdc2be7c5a869"
msgid "Gaerdal Ironhand you may not be, but you damn well fight like him."
msgstr "넌 게르달 아이언핸드님은 아니어도, 그처럼 끝내주게 잘 싸웠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Player
#. NodeID = 4e9422c1-e57f-f0e0-8c2b-199826143216
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_InjuredGnome_State_GaveQuest = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:4e9422c1-e57f-f0e0-8c2b-199826143216
msgctxt "hb2a85cabg060eg47begb18bge568e451af8b"
msgid "Thank Thulla - she's the one who set me on your trail."
msgstr "툴라에게 고마워해. 너희 행방을 나에게 알려준 사람이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = 53944cfd-46a1-e98d-e162-4b6959f567ba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:53944cfd-46a1-e98d-e162-4b6959f567ba
msgctxt "h6432bcb9g2a7bg4b47gb921gfdfa77cf8ee8"
msgid ""
"Aye. The explosive of Gaerdal Ironhand's own creation. Fistfuls wiping out "
"armies, all those old stories."
msgstr "그래. 게르달 아이언핸드께서 손수 만든 폭발물이라고 해. 한 줌으로 군대를 쓸어버렸다는 말도 있어. 모두 오래된 이야기지만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = 5a42a39c-544b-47b2-d066-af2eda4a2cfd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 94cd662c-844b-4dcc-ffdc-0b9a8da32bcc_ToldPhilomeenEscaped = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:5a42a39c-544b-47b2-d066-af2eda4a2cfd
msgctxt "h5de7c12bg4d01g427egbc80gce505686af42"
msgid ""
"That business is what sent us after the powder to begin with. Now... we'll "
"have to make other arrangements."
msgstr "애초에 그 일 때문에 파우더를 찾게 된 것이니. 이제... 우리는 다른 일들을 처리해야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = 5b448990-a450-9db8-dd5e-43688b98408f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 94cd662c-844b-4dcc-ffdc-0b9a8da32bcc_ToldPhilomeenEscaped = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:5b448990-a450-9db8-dd5e-43688b98408f
msgctxt "h29f24718g90f3g42ecg8770gb2ddc6e261ad"
msgid ""
"Business that sent us after the powder to begin with. The formula might be "
"gone, but we still have the barrels."
msgstr "애초에 우리가 파우더를 찾게 된 일이지. 공식은 사라졌지만, 아직 통은 남아있으니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = 5de5277d-772d-d78d-14d0-763960d81f83
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:5de5277d-772d-d78d-14d0-763960d81f83
msgctxt "h501fa425gb82cg4f74g85f5g23667714eaca"
msgid ""
"I'm grateful, don't mistake me, but... why help us? You're one of them, "
"aren't you?"
msgstr "고맙긴 한데... 왜 우릴 도와준 거야? 너도 그놈들 편 아니었어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Barcus Wroot
#. NodeID = 6b98c125-a807-eb91-7314-7579b111df05
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:6b98c125-a807-eb91-7314-7579b111df05
msgctxt "h87e1b9ecge5ebg45a9gaf37gf7ae2bf32b3b"
msgid "What has he gotten himself mixed up in now..."
msgstr "그에게 무슨 일이 휘말린 거야..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = 6bdd8ffa-f804-47ea-0357-d8a7f08f54cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:6bdd8ffa-f804-47ea-0357-d8a7f08f54cf
msgctxt "he2b047bfg008dg4c04gbea2gdb17a9dad090"
msgid ""
"Aye. The cult kept us for slave-hands, but Wulbren was our leader. He... "
"knows things."
msgstr "그래. 사교도 놈들이 우릴 노예 신세로 만들었지만, 울브렌이 우리 지도자였어. 그가... 아는 게 많아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Barcus Wroot
#. NodeID = 6d116700-f4d0-bb50-8bd2-65790abc3146
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - LocalFlag_01 = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:6d116700-f4d0-bb50-8bd2-65790abc3146
msgctxt "h9cc6cf46gc55dg4a91g98d5gb5d9ae300e10"
msgid "And neither will this twit, apparently."
msgstr "이 멍청이도 마찬가지인 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = 77f926d3-8c58-7d41-989d-fe1ee8267449
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:77f926d3-8c58-7d41-989d-fe1ee8267449
msgctxt "h5b321186gcfd5g40a9g8bb0g4453495ab83b"
msgid "<i>That</i> didn't much look like begging. But no complaints from me."
msgstr "<i>그건</i> 별로 구걸하는 것 같아 보이진 않았는데. 내가 불평할 처지는 아니지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Player
#. NodeID = 7cda22f5-e69e-c7c3-7f65-a33f03c05d2c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_HiddenGnome_HasMet(1) = True
#.   Global:
#.      - GLO_IronhandGnomes_Knows_Runepowder = True
#.      - UND_PanicRoom_Event_GnomeSuicide = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:7cda22f5-e69e-c7c3-7f65-a33f03c05d2c
msgctxt "hcb6f7de7gedbdg400dga8cfga975e3ef0d7c"
msgid ""
"If you're talking about runepowder, Philomeen already blew it up. And "
"herself with it."
msgstr "룬파우더에 대해 말하는 거라면, 필로민이 이미 날려버렸어. 자기 자신이랑 함께 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = 7fca40d7-da40-d5dd-f37b-b72a55c9191a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Moonrise_Knows_AbsoluteAtGrymforge = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:7fca40d7-da40-d5dd-f37b-b72a55c9191a
msgctxt "h4bb4de62g19ffg4a51g872bg035cbb60d1b1"
msgid ""
"Taken to Moonrise Towers. The rest of us were set digging, but... Wulbren "
"knows things. Seems the cult wants to know them too."
msgstr ""
"문라이즈 타워로 끌려갔어. 나머지는 이렇게 남아서 땅이나 파고 있지만... 울브렌은 아는 것이 많아. 보아하니 이 사교도 놈들도 그걸 "
"알아내려는 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Barcus Wroot
#. NodeID = 82f30cb3-1568-312e-214a-e9b41ec954bc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 94cd662c-844b-4dcc-ffdc-0b9a8da32bcc_BarcusSpokeUp = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:82f30cb3-1568-312e-214a-e9b41ec954bc
msgctxt "h3cc03620ge003g4e96ga476g6971c248533e"
msgid "Make it quick! We need to find Wulbren - <i>now.</i>"
msgstr "서둘러! 우린 울브렌을 찾아야 해 - <i>당장.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Player
#. NodeID = 8415f0e4-3075-0414-d1d7-1174606557f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:8415f0e4-3075-0414-d1d7-1174606557f5
msgctxt "h87349e08gc7fcg4a0eg9942g73242e234389"
msgid "Run away, then. I have my own business to be about."
msgstr "그럼 도망쳐. 난 내 볼일이 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = 854db360-5ab6-85aa-aa46-04330e8ec8cd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:854db360-5ab6-85aa-aa46-04330e8ec8cd
msgctxt "h937a2696ga6e7g46d0ga3cagccfb52dde0fd"
msgid ""
"I wouldn't trust them with a bloody butter knife. But it's a fight for "
"another day."
msgstr "빌어먹을 버터칼을 갖고도 무슨 짓을 저지를지 모를 놈들이네만, 일단은 훗날을 기약하겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = 85ce93e9-db04-7326-6688-948010a0d1f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:85ce93e9-db04-7326-6688-948010a0d1f0
msgctxt "hbb588e40g5ed0g475cga77bg0dd2495e4ca4"
msgid "... they could flatten the whole of the Sword Coast."
msgstr "... 그 자식들이 소드 코스트 전역을 무너뜨릴 수 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = 866269f7-070f-87e8-55d8-31375465082c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_TheDrowNere_State_PermaDefeated = True
#.      - UND_DuergarMutineers_State_PermaDefeated = True
#. SetFlags:
#.   Global:
#.     - UND_State_LeaderFreedGnomes = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:866269f7-070f-87e8-55d8-31375465082c
msgctxt "h10ee49abg5a04g4901gbe7bg28a0d79279cd"
msgid "Fah. Thought I'd have to breathe my last in Nere's stink."
msgstr "푸하. 내가 들이쉬는 마지막 숨이 니어의 악취일 줄 알았는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = 886dc25c-fabc-e996-3a6d-cb76c0588976
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:886dc25c-fabc-e996-3a6d-cb76c0588976
msgctxt "hc6ceb753g620bg4aa8ga17dgf555417c8f14"
msgid ""
"And yet the cult didn't clap you in chains. I'd like to learn that trick."
msgstr "그런데도 그 사교도 놈들이 널 사슬에 묶지 않았다니. 나도 그 방법을 좀 배우고 싶은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = 8c3e0408-aef4-5383-8224-ab75cad7eb60
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:8c3e0408-aef4-5383-8224-ab75cad7eb60
msgctxt "h15b1f2c5g3b08g4bc9ga466gde900214bb46"
msgid "Aye. Nor us, I'm afraid."
msgstr "그래. 유감스럽지만, 우리도 마찬가지야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Player
#. NodeID = 8cafc24b-d4d3-ff29-3d4a-e2c9001eaadb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:8cafc24b-d4d3-ff29-3d4a-e2c9001eaadb
msgctxt "h9d33401fgcd19g4cd5gae4eg6e9e6348f52d"
msgid "Before you ask, no - I'm not going to stage a rescue."
msgstr "물어보기 전에 미리 말하는데, 싫어. 난 구조에 나서지 않겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Player
#. NodeID = 95741d52-5950-60e6-7e15-b223e0bfb78f
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - GLO_IronhandGnomes_Knows_Runepowder = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:95741d52-5950-60e6-7e15-b223e0bfb78f
msgctxt "h3f0901c2gd59bg404cg90a5ged6df10a927f"
msgid "This is no time to be coy. What is that Wulbren knows?"
msgstr "부끄러워할 시간 없어. 울브렌이란 자는 무엇을 알고 있지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = 95fcbfaa-8a33-7b0f-e751-c825f899aa4f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:95fcbfaa-8a33-7b0f-e751-c825f899aa4f
msgctxt "hc8143f35gbdd3g46f5ga557gbc8a00d0732d"
msgid "Not long enough."
msgstr "그리 오래는 못 버틸 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = 9695c62e-ad7d-2106-a0b3-5e1567732384
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_GnomeForeman_Event_StillSlavesDialogue = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:9695c62e-ad7d-2106-a0b3-5e1567732384
msgctxt "h012e6c91g1cdag49f3ga711g11279de993a0"
msgid "I've lost so much. Please, just - just let me be."
msgstr "이미 너무 많은 것을 잃었어. 제발, 그냥 - 그냥 날 내버려 둬."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = 98473410-ba28-882d-3d8a-00db79744a07
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:98473410-ba28-882d-3d8a-00db79744a07
msgctxt "h60320e77gdab7g4f46g8a6fgf8fa26b154e9"
msgid "You know what to do."
msgstr "뭘 해야 할지 알잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Barcus Wroot
#. NodeID = 997a2c70-f4eb-1c79-652e-ff0f6f92a240
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 94cd662c-844b-4dcc-ffdc-0b9a8da32bcc_BarcusInsultedBeldron = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:997a2c70-f4eb-1c79-652e-ff0f6f92a240
msgctxt "he5d24fa6g67d5g4959gbfe5g1417d761d051"
msgid ""
"And just like that, you'd leave Wulbren behind. I knew you lot were foolish, "
"but I didn't know you were cruel."
msgstr "그렇게 그냥, 울브렌을 버리고 떠나겠다는 거구나. 너희가 어리석다는 건 알았지만, 냉혹할 줄은 몰랐어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = 9bbdd9ac-d9e1-5878-7d1a-3bccda992dbf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_GnomeForeman_Event_PissedOff(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:9bbdd9ac-d9e1-5878-7d1a-3bccda992dbf
msgctxt "he6b156d1gf553g4ed2g95f6gdac919f6de70"
msgid "We're done here."
msgstr "여기서 볼일은 다 끝났어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = 9e9ab322-461c-7212-3009-f9c27f4f4827
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_IronhandGnomes_Knows_WulbrenInMoonrise = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:9e9ab322-461c-7212-3009-f9c27f4f4827
msgctxt "hc4172c5fg28c8g43acgbfceg25ed9dbbe1f1"
msgid "The leader of our expedition. He was sent off to Moonrise Towers."
msgstr "우리 원정대의 지도자였어. 문라이즈 타워로 끌려갔지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = a099300c-6446-a68b-aa2f-860983caf357
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:a099300c-6446-a68b-aa2f-860983caf357
msgctxt "h0007580agbc19g4b1cgab5fgd6254e13eb96"
msgid ""
"You did just lift a mountain from our heads, so... good enough for me, I "
"reckon."
msgstr "넌 방금 우리 머리에서 산을 들어 올려줬으니... 그것만으로도 충분하겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = a64879fc-78f7-7099-4244-913ca8df41a0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:a64879fc-78f7-7099-4244-913ca8df41a0
msgctxt "h6a5e4e0bg6f61g4a45gbdc0g033b25b14806"
msgid ""
"It is. And if the pick swung the other way, I'd expect Wulbren to do the "
"same."
msgstr "맞아. 그리고 만약 입장이 반대였다면, 울브렌도 똑같이 행동할걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Player
#. NodeID = a9756e9b-4d63-a000-342e-0caf16ba9929
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#. TagRule: BERSERKER
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:a9756e9b-4d63-a000-342e-0caf16ba9929
msgctxt "h267e17f9g3e2bg44edgbe5dgbd2414d649be"
msgid "EXPLAIN<b>. QUICKLY.</b>"
msgstr "<b>설명해. 빨리.</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Player
#. NodeID = a9756e9b-4d63-a000-342e-0caf16ba9929
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:a9756e9b-4d63-a000-342e-0caf16ba9929
msgctxt "hc99a0f31g0aa6g4b6ag9f68ge2738e39c9d1"
msgid "Start explaining, or I start breaking bones."
msgstr "설명을 시작해, 그렇지 않으면 뼈마디를 하나씩 부숴줄 테니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = ae5b6e69-a474-a2fb-df5e-2adf73724c38
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:ae5b6e69-a474-a2fb-df5e-2adf73724c38
msgctxt "h051c344egfce6g44ffg947agbc949f3caba2"
msgid "Then we're of one mind, I think."
msgstr "그렇다면 우린 한마음인 것 같네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Player
#. NodeID = b2c9d435-7295-4bc9-cb19-540419779045
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_IronhandGnomes_Knows_Runepowder = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:b2c9d435-7295-4bc9-cb19-540419779045
msgctxt "h2f4f3640gc094g4739gb887g3b04494c2e2f"
msgid "Would this have anything to do with runepowder?"
msgstr "이게 룬파우더와 뭔가 연관이 있을까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Player
#. NodeID = b43d9aaf-e4e6-2ea6-58c9-2ff996aa09e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:b43d9aaf-e4e6-2ea6-58c9-2ff996aa09e6
msgctxt "h2acc132fg8e75g49ffgae1eg17e4f1517e89"
msgid "The cult thinks it owns me. I beg to differ."
msgstr "이 사교도 놈들은 내가 자기들 소유인 줄 알아. 내 생각은 달라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = b43e99fb-6339-fa5d-c9e0-eab151e57380
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_DuergarCamp_State_CaveInCleared = True
#. SetFlags:
#.   Dialog:
#.     - UND_GnomeForeman_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:b43e99fb-6339-fa5d-c9e0-eab151e57380
msgctxt "ha685e691ge2b7g43c6g9284g48b6c8f38012"
msgid "Freedom. Or what passes for it."
msgstr "자유. 아니면 그와 비슷한 거라도."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Barcus Wroot
#. NodeID = b67cec33-bbf5-7d17-cd3e-624d3f99cd49
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:b67cec33-bbf5-7d17-cd3e-624d3f99cd49
msgctxt "h673a5a09g8d01g4bcagbc8fg4ecc82562c1e"
msgid "<i>What?!</i>"
msgstr "<i>뭐라고?!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = b6bf0ac6-28be-7ea5-412b-1ddf7e0d0b82
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_InjuredGnome_State_GaveQuest = True
#. SetFlags:
#.   Object:
#.     - UND_GnomeForeman_UnfortunateGnome_InclusionStart(1) = True
#.   Quest:
#.     - UND_GnomeRescue.ThankedFreed_BeldronThulla(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:b6bf0ac6-28be-7ea5-412b-1ddf7e0d0b82
msgctxt "h2f4fe022g5dd8g4b53g98b8gee8f420864ea"
msgid ""
"Here - the Ironhand Gnomes honour their debts. With Wulbren gone, that falls "
"to me."
msgstr "여기, 아이언핸드 노움은 반드시 빚을 갚거든. 울브렌이 없으니, 나라도 갚아야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = b726da80-3eb1-5fc2-7f8f-d4da33daaeb6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:b726da80-3eb1-5fc2-7f8f-d4da33daaeb6
msgctxt "hf88a7edcgdab3g4db2g9eccg8b801a2fb41f"
msgid "He'd admire your resolve. And your optimism."
msgstr "그가 너의 결의에 감탄할 거야. 너의 낙관주의에도."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = b7780320-8789-aec6-7392-2fac9523ac87
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:b7780320-8789-aec6-7392-2fac9523ac87
msgctxt "hfa0bd3e9g3400g4991gaacfg4e41a77e3a7f"
msgid ""
"Wulbren has a way of attracting true believers - his quest for runepowder "
"was the latest dream he stuffed in our heads."
msgstr "울브렌은 믿음을 불어넣는 재능이 있어, 룬파우더를 찾는 여정이 그가 우리 머릿속에 박아 넣은 가장 최근 작품이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = b82ed3a7-22d3-a7a0-9d83-c5a9442eb499
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 94cd662c-844b-4dcc-ffdc-0b9a8da32bcc_BarcusSpokeUp = True
#. SetFlags:
#.   Global:
#.     - GLO_IronhandGnomes_Knows_WulbrenInMoonrise = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:b82ed3a7-22d3-a7a0-9d83-c5a9442eb499
msgctxt "hc5248cfcg8955g4f86gbd69g7dac4925bcb3"
msgid ""
"You're a little late, Barcus my lad. He's already been sent to Moonrise "
"Towers."
msgstr "다소 늦었어, 바커스 이 친구야. 그는 이미 문라이즈 타워에 이송됐다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Player
#. NodeID = b965f3b8-c9f9-0d33-cc97-54df6de83ed0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:b965f3b8-c9f9-0d33-cc97-54df6de83ed0
msgctxt "he5e4e0f5g69a0g42d2g8052gde4685297cb6"
msgid "You're just abandoning your leader? That's cold."
msgstr "너희 지도자를 버리겠다는 건가? 참 냉정하군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = bc3f8be0-805d-44ca-bba7-51f03ff92293
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:bc3f8be0-805d-44ca-bba7-51f03ff92293
msgctxt "h81e503d1gfd48g4f22g9e6bg1b77920cbe6d"
msgid ""
"You. Thank you for trying to free us, at least. I thought you were with the "
"cult."
msgstr "너. 적어도 우릴 구하려고 해줘서 고마워. 네가 저 사교도 놈들과 한패인 줄 알았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = c0e335c8-6e6c-c5b0-f9ba-8e9dfbf0a048
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_UND_Gnomes_TalkedForeman = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:c0e335c8-6e6c-c5b0-f9ba-8e9dfbf0a048
msgctxt "hcbb38216g1cd5g4803g875fgbe4184c5d8a2"
msgid ""
"If you find yourself in Baldur's Gate, seek us out. We'll raise a glass to "
"Wulbren together."
msgstr "만약 네가 발더스 게이트에 이르게 되면, 우리를 찾아줘. 함께 울브렌을 위해 건배하자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Player
#. NodeID = c1d17ece-c206-f68d-f14f-b88d7b616dbe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_HiddenGnome_HasMet(1) = True
#.   Global:
#.      - GLO_IronhandGnomes_Knows_Runepowder = True
#.      - UND_PanicRoom_Event_GnomeSuicide = False
#. SetFlags:
#.   Local:
#.     - 94cd662c-844b-4dcc-ffdc-0b9a8da32bcc_ToldPhilomeenEscaped = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:c1d17ece-c206-f68d-f14f-b88d7b616dbe
msgctxt "h6d20f043gc92fg48e8gbab8g54fd742f9002"
msgid "Spare the secrecy. Philomeen already escaped with the runepowder."
msgstr "비밀을 지켜. 필로민은 이미 룬파우더를 가지고 도망쳤어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = c2960d68-4efd-4924-7012-acd631f2265d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:c2960d68-4efd-4924-7012-acd631f2265d
msgctxt "hb95edb56g71bfg4ff1gb201g51d1a9adef77"
msgid "Things the cult would like to know too, it seems."
msgstr "사교도 놈들도 알고 싶은 정보인 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Player
#. NodeID = c41387a0-ff75-024e-d580-faf07d943c62
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_IronhandGnomes_Knows_WulbrenInMoonrise = True
#.      - GLO_IronhandGnomes_Knows_BarcusWulbren = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:c41387a0-ff75-024e-d580-faf07d943c62
msgctxt "h99c3cdb1g2849g4907ga364g632fbd37c9f1"
msgid "Wulbren's been taken to Moonrise Towers, I hear."
msgstr "듣기로는 울브렌이 문라이즈 타워로 끌려갔다고 하던데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Player
#. NodeID = c42c43ea-d012-0258-da9d-c866118c91f3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GNOME(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:c42c43ea-d012-0258-da9d-c866118c91f3
msgctxt "h73841c35g91fdg4701g9940g98175cb8e315"
msgid "No, I'm one of <i>you.</i>"
msgstr "아니, 난 <i>당신들</i> 편이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = c80f5d10-c6a3-cb9a-665f-15a320d2108c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:c80f5d10-c6a3-cb9a-665f-15a320d2108c
msgctxt "h06c6e6efg0164g4295g98abge66a33547fdc"
msgid ""
"... then it seems you've saved us twice over. Gods above - she bloody did "
"it. Of course she did."
msgstr "... 그렇다면 네가 우릴 두 번이나 구해줬다는 뜻이군. 저 위의 신들이시여, 그녀가 정말 해냈군. 물론 그녀라면 해냈겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = ca2be75f-3525-0bb5-a053-6cc82d256bd5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:ca2be75f-3525-0bb5-a053-6cc82d256bd5
msgctxt "h2d653975g37d0g4d24gb366g604c092f7873"
msgid ""
"No. Debt's a stone 'round your neck, and we Ironhands like to walk tall. "
"We'll be fine."
msgstr "아니. 빚이란 목에 거는 돌과 같은 거야, 그리고 우리 아이언핸드는 우뚝 서는 걸 좋아하지. 우린 괜찮을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = cdbc76f9-b762-bd90-42be-7aa500716550
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:cdbc76f9-b762-bd90-42be-7aa500716550
msgctxt "hdfc6babbgb702g4920g9044gc825ba3705e0"
msgid "Do the right thing. Kill Nere."
msgstr "옳은 일을 해. 니어를 죽여."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Player
#. NodeID = ce14bc43-e4a2-a9b3-f50a-65e4da3fd8c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:ce14bc43-e4a2-a9b3-f50a-65e4da3fd8c6
msgctxt "hbfefe181gcc68g4f7bgb9d7g92193a93d1c6"
msgid "I don't plan on being anywhere nearby when they do."
msgstr "그럼 놈들이 일을 벌일 때는 얼씬도 말아야겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = cf80ba37-3d9f-6df0-b6b6-1ee1b80f04eb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_Mutineers_Event_FailedtoFreeGnomes = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:cf80ba37-3d9f-6df0-b6b6-1ee1b80f04eb
msgctxt "h1318662bg1fc9g4fb2gb942g86dc913ccb7d"
msgid ""
"I'd rather not think about it. Besides, we have our own freedom to look to."
msgstr "그 일은 생각하고 싶지 않아. 게다가, 우린 스스로의 자유를 찾기도 바쁘다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = d009f95c-ed7c-1402-99c7-13ac50e0576a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:d009f95c-ed7c-1402-99c7-13ac50e0576a
msgctxt "h8b16f504g7974g41dbg9562ge15a7535499e"
msgid ""
"... a sad end. But a fitting one for a true believer. When Wulbren claimed "
"that runepowder existed, she was the first to volunteer."
msgstr ""
"... 슬픈 결말이군. 하지만 참된 신자에게 어울리는 결말이기도 하고. 울브렌이 룬파우더가 실존한다고 했을 때 가장 먼저 지원한 게 "
"그녀거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = d731747a-24c9-e3da-d24b-b4831fe2f695
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_GnomeForeman_HasMet2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:d731747a-24c9-e3da-d24b-b4831fe2f695
msgctxt "h51f9d0a6gb3c2g4ffbgb970g8a8f8200b1dc"
msgid "We'll be leaving soon enough."
msgstr "우린 곧 떠날 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Player
#. NodeID = dc4a93af-1bd0-436d-7602-b62fba6b2eeb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:dc4a93af-1bd0-436d-7602-b62fba6b2eeb
msgctxt "h75aa289cge396g4219gb0fagc253b9a244e8"
msgid "Are you always so suspicious of those who save you?"
msgstr "너는 자신을 구해준 사람을 항상 의심하나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Lunkbug
#. NodeID = e3442e64-8782-08c2-31c5-33ab40c75bf8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:e3442e64-8782-08c2-31c5-33ab40c75bf8
msgctxt "h5d2f0972g67f7g472dga39dg105391d785ce"
msgid "I'm all right, I promise. I just wish..."
msgstr "난 괜찮아, 약속해. 그저..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = e350d665-10fa-7f1d-01f1-5affab5f53a5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Moonrise_Knows_AbsoluteAtGrymforge = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:e350d665-10fa-7f1d-01f1-5affab5f53a5
msgctxt "hf0b03267gf88ag44c6gbd5bg575729d3d191"
msgid ""
"We were just slave-hands to the cult, but not Wulbren. He... knows things. "
"Things they want to know too."
msgstr "우린 광신도의 노예일 뿐이었지만, 울브렌은 아니었어. 그는... 많은 사실을 알고 있지. 그놈들이 알고 싶어하는 사실도."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = e36bc569-746a-acbe-53ca-1d54907bff2a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_State_LeaderFreedGnomes = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:e36bc569-746a-acbe-53ca-1d54907bff2a
msgctxt "hf07746a9ga982g4b29g95bfgfc8c3a9de4b8"
msgid "Thought we'd leapt from frying pan to flame for a moment, there."
msgstr "잠깐 우리가 프라이팬에서 불길로 뛰어든 줄 알았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = e5589589-766f-c148-5c21-7499f62a26fe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_Mutineers_Event_FailedtoFreeGnomes = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:e5589589-766f-c148-5c21-7499f62a26fe
msgctxt "h04641225g2996g4730gbcc6g9093dba3d0e1"
msgid ""
"Wise, I think. Losing our leader is a blow, but we have our own freedom to "
"look to."
msgstr "현명한 선택인 것 같군. 지도자를 잃은 것도 큰일이지만, 지금은 우리 자유를 찾기도 바빠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = e619abe8-8857-14c3-04b5-8ce94d1934d1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:e619abe8-8857-14c3-04b5-8ce94d1934d1
msgctxt "hd8179050g010fg4b04g911eg37118d328498"
msgid "My people can barely stand. And we have business back in the city."
msgstr "내 동족은 버티지 못할 거야. 도시로 돌아가야 할 일도 있고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = e63467bb-17f2-44ea-c560-92e46c9bd9d2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:e63467bb-17f2-44ea-c560-92e46c9bd9d2
msgctxt "hd6735f0dg7719g492ag910cgd86bd74486ad"
msgid ""
"If there's a single copy left, it's sitting in his head. Those Absolutists "
"pull it out and make runepowder..."
msgstr "사본이 하나라도 남아 있다면, 그의 머릿속에 있을 거야. 절대자 신도들이 그 지식을 끄집어내서 룬파우더를 만들어내면..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Player
#. NodeID = e953efc2-7bc8-c0be-0eba-de27b0d2c3b5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_IronhandGnomes_Knows_WulbrenInMoonrise = False
#.      - GLO_IronhandGnomes_Knows_BarcusWulbren = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:e953efc2-7bc8-c0be-0eba-de27b0d2c3b5
msgctxt "h283f6e03g618eg49e1gaaabg02da20ba8535"
msgid "I know someone looking for this Wulbren. Where is he?"
msgstr "누군가가 이 울브렌이라는 자를 찾고 있던데. 그는 어디에 있지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Lunkbug
#. NodeID = ebbc4eaf-c42d-85b2-0ae4-a1978d42c576
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:ebbc4eaf-c42d-85b2-0ae4-a1978d42c576
msgctxt "hcae49502ge48bg4639ga6a1g7ca2c750d6c3"
msgid "Who cares? We're together now, thank Ironhand!"
msgstr "무슨 상관이야? 지금 우리가 만났는데. 아이언핸드님께 감사를!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = f2925b40-4168-4e0f-ec4f-3282756671c7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_GnomeForeman_Event_StillSlavesDialogue = True
#.      - UND_TheDrowNere_State_PermaDefeated = True
#.      - UND_DuergarMutineers_State_PermaDefeated = True
#. SetFlags:
#.   Dialog:
#.     - UND_GnomeForeman_HasMet2(1) = True
#.   Global:
#.     - UND_State_LeaderFreedGnomes = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:f2925b40-4168-4e0f-ec4f-3282756671c7
msgctxt "hd072dcb7g8d74g4a0dg8307g8b820d79bd4c"
msgid "You came through. I can't believe it. I owe you more than you know."
msgstr "우리를 돕다니 믿기지가 않는구먼. 어떻게 신세를 갚을지 막막할 따름이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Player
#. NodeID = f2aa2bde-4f94-2338-db89-0a63e73cb308
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:f2aa2bde-4f94-2338-db89-0a63e73cb308
msgctxt "h67ae36cagc0f1g4583g966bg2f33b56dcc71"
msgid "How long do you think he can hold out?"
msgstr "그가 얼마나 버틸 수 있을 것 같아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = f458bfce-2801-8220-e200-2bcf405725da
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_IronhandGnomes_Knows_Runepowder = True
#.     - GLO_IronhandGnomes_Knows_BeldronToldMission = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:f458bfce-2801-8220-e200-2bcf405725da
msgctxt "ha7865a90gcb11g4e14g85f2gd8972879ef32"
msgid ""
"You'll call me mad, but... fine. Wulbren's found the formula for runepowder."
msgstr "네가 나를 미친놈이라 할 수도 있지만... 좋아. 울브렌은 룬파우더의 공식을 발견했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Player
#. NodeID = f6b444d7-7e81-48a2-3a96-4db888f8db50
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:f6b444d7-7e81-48a2-3a96-4db888f8db50
msgctxt "h6a1a4a0cg4ef1g4142g8f35g629dd33b7d2c"
msgid "Keep the coin. It seems like you'll need it."
msgstr "동전은 됐어. 당신도 필요할 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Player
#. NodeID = f77915db-5078-9772-d0c6-a4c4ea809abc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GNOME(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:f77915db-5078-9772-d0c6-a4c4ea809abc
msgctxt "hd546f660g9c7fg47bdg94e7g9935cac1250c"
msgid "It would seem not."
msgstr "그렇게 보이지는 않을 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Player
#. NodeID = f822e867-fa2c-2cc1-4d5a-e8c8f84f6608
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 94cd662c-844b-4dcc-ffdc-0b9a8da32bcc_BarcusInsultedBeldron = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:f822e867-fa2c-2cc1-4d5a-e8c8f84f6608
msgctxt "hb7881ad1gc9acg4515g8bcega83585a530c1"
msgid "Enough. Bickering won't save your friend."
msgstr "그만해. 말다툼한다고 친구를 구하진 못해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = f9f31f9e-26ea-6092-b4bd-cabe47996916
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:f9f31f9e-26ea-6092-b4bd-cabe47996916
msgctxt "hbfecd379g299eg43f2gaff3gfccef17b22a6"
msgid ""
"But not Wulbren. He bloody <i>found </i>it - a small cache, buried down here "
"with a manuscript."
msgstr "하지만 울브렌은 아니었어. 그가 정말로 <i>찾아냈다고</i>. 이 아래에 필사본과 함께 자그마한 은신처가 있었지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = fb41415e-7239-1675-1c24-b5e44feb7af9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_UND_Gnomes_TalkedForeman = True
#. SetFlags:
#.   Dialog:
#.     - UND_GnomeForeman_HasMet2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:fb41415e-7239-1675-1c24-b5e44feb7af9
msgctxt "hd8a0e860ge144g4be4gbbbfgae9cadb14cdf"
msgid ""
"We'll be safer 'cross the Ebonlake. Then back to the city, Gaerdal Ironhand "
"willing."
msgstr "칠흑호수를 건너가면 안전할 거야. 그러고 도시로 돌아가야지, 게르달 아이언핸드께서 인도하시길."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = fbab0edd-8823-b213-44e9-7f99e18faba4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:fbab0edd-8823-b213-44e9-7f99e18faba4
msgctxt "h211bd5d2ga6fbg4471g91fag38836e0f30e8"
msgid "... I know. I do too. But we're together - that's what matters."
msgstr "... 알아. 나도 그래. 하지만 우리가 함께잖아, 중요한 건 그거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = fbb2f5b0-731a-45b4-b8fc-c98880f990e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:fbb2f5b0-731a-45b4-b8fc-c98880f990e6
msgctxt "h9ebfb2bcgf216g460dgab5bgcad08bca1021"
msgid ""
"How did you... well, you're a sharp one. Most still believe it's a fairy "
"tale - I know I did, once."
msgstr "어떻게... 뭐, 예리하군. 다들 아직 그게 동화 속 이야긴 줄 알거든, 나도 한땐 그랬고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = fcd1d83f-8c5c-9d54-91f0-69d5b08c611f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_IronhandGnomes_Knows_WulbrenInMoonrise = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:fcd1d83f-8c5c-9d54-91f0-69d5b08c611f
msgctxt "h3dc0d459gf85eg409cg9edegcd87ccdfeab8"
msgid ""
"I wish I could. But most of our funds rested with our leader, Wulbren. He'll "
"be in Moonrise Towers by now."
msgstr "나도 그랬으면 좋겠어. 하지만 우리 자금 대부분은 지도자인 울브렌이 가지고 있었어. 지금쯤 문라이즈 타워에 있겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Player
#. NodeID = fe2f282a-5f91-b176-2f9c-3aafedefaba1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:fe2f282a-5f91-b176-2f9c-3aafedefaba1
msgctxt "h3cc8cf0bg1035g4b92g9693g961fc0676654"
msgid ""
"Whatever the cult wants, I want the opposite. We need to free your friend."
msgstr "교단이 무엇을 원하든, 난 그 반대를 원해. 우린 너의 친구를 풀어줄 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman
#. Speaker = Beldron
#. NodeID = fe9f6a6c-0031-46d4-375c-82be0bdc459a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_IronhandGnomes_Knows_WulbrenInMoonrise = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman:fe9f6a6c-0031-46d4-375c-82be0bdc459a
msgctxt "h1b93ff22g6407g43e1gace0g2afb092c3f6c"
msgid "It's Wulbren I'm worried for. He was sent on to Moonrise Towers."
msgstr "내가 걱정되는 건 울브렌이야. 문라이즈 타워로 끌려갔거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman_Dead
#. Speaker = Player
#. NodeID = 0e898042-ebe7-bd91-bbe8-670b864a7768
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman_Dead:0e898042-ebe7-bd91-bbe8-670b864a7768
msgctxt "hecc1438cg0839g4960g82cfg71fd6defa309"
msgid "Did you have any valuables?"
msgstr "지니고 있던 귀중품이 있나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman_Dead
#. Speaker = Beldron
#. NodeID = 23728e54-8a62-1b13-771b-6d1438f7f5d9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Moonrise_Knows_AbsoluteAtGrymforge = True
