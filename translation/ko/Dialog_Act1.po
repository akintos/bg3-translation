msgctxt "h72e0166cg4e28g4de8g83c8gd4916671acc9"
msgid "Ah! Damned, stupid bush."
msgstr "아! 젠장, 망할 덤불."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_SwampExploration_PAD_PrickedFinger
#. Speaker = Player
