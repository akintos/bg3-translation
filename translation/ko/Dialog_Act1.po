msgctxt "h3783d101g26adg4337g82b3gde6f7f293e52"
msgid "... pack of... gnolls... claws... teeth..."
msgstr "... 놀... 무리... 발톱... 이빨..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dead
#. Speaker = Gomwick
#. NodeID = c46b66f4-dfbd-d50b-3aa1-f9a4be06dd59
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dead:c46b66f4-dfbd-d50b-3aa1-f9a4be06dd59
msgctxt "hcfdbdeb7g5781g4a3cg9a61g9de0acfb239c"
msgid "... from... Triel..."
msgstr "... 트리엘... 에서..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dead
#. Speaker = Narrator
#. NodeID = d17ea1dc-999e-7107-5f72-8de90d0eacf4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_Killer(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dead:d17ea1dc-999e-7107-5f72-8de90d0eacf4
msgctxt "hb26b5e38g9857g4a0fga38agdabaea3f18f0"
msgid "*The corpse seems willing to speak - but not to its killer.*"
msgstr "*시체는 말할 의지가 있지만, 자신을 죽인 자와 대화하고 싶지는 않은 듯 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dead
#. Speaker = Player
#. NodeID = e098dd86-607d-efca-9b70-c7b9bcb94ac6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
