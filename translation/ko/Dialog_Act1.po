#.      - DRUID(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:91310d4c-ded4-3d28-a029-7df10e065435
msgctxt "hac0e837cge37bg4dd0gb4e7g2e4d038560d5"
msgid "Calm, friend. I mean you no harm."
msgstr "진정해, 친구. 널 해치려는 게 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
