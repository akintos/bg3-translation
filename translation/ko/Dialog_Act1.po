msgctxt "hd1720d78g8652g44a5gbde7gb8e1339fa383"
msgid "Can't never 'ave too much beer."
msgstr "맥주는 아무리 많이 마셔도 질리지가 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_TakeRefill_005
#. Speaker = Tracker Puli
#. NodeID = 1b627b8d-6ecb-0029-772b-f3b645d6b13f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_TakeRefill_005:1b627b8d-6ecb-0029-772b-f3b645d6b13f
msgctxt "h926e12d5g7e0cg45c6g9203g28c2269b9b92"
msgid "Who wants another drink?"
msgstr "한 잔 더 마실 놈?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_TakeRefill_006
#. Speaker = Sharp-Eye Aggy
#. NodeID = c70e762d-2d2a-1477-82e4-c19c0898c3bd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_TakeRefill_006:c70e762d-2d2a-1477-82e4-c19c0898c3bd
msgctxt "h07506961g44bdg46c0gb37ag095fa593c080"
msgid "Nothin' beats the taste of stolen beer."
msgstr "훔친 맥주의 맛은 그 무엇에도 비할 바가 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_TakeRefill_007
#. Speaker = Warlock Gurk
#. NodeID = e1c27e7f-8e8c-364e-08ec-e499be0bfd4d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_TakeRefill_007:e1c27e7f-8e8c-364e-08ec-e499be0bfd4d
msgctxt "h73dbb5dcg9b25g4778g9b09g10da2f102ab0"
msgid "Empty again? These mugs got holes in 'em or somethin'?"
msgstr "또 비었어? 머그 잔에 구멍이 난 거냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_PAD_LooseWall
