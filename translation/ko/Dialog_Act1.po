#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:0c03773b-3a1b-638e-6433-60bc894be9d2
msgctxt "h9eafd0cagd390g419fg9960g775fff539ac3"
msgid ""
"You're bloody right it wasn't. I agreed to remove an illithid spawn. That "
"thing is an <i>abomination</i>."
msgstr "그래, 네 그 빌어먹을 말대로 당연히 아니지. 난 일리시드 새끼를 없애기로 했어. 그런 <i>혐오스러운</i> 게 아니라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Auntie Ethel
#. NodeID = 159c1300-4be7-fd8c-8fc4-5c0e2511c68c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:159c1300-4be7-fd8c-8fc4-5c0e2511c68c
msgctxt "h611c4ce9g654fg444cgb6dfg27c513a62a08"
msgid "Indeed I am. And a <i>fabulous </i>one at that."
msgstr "그렇다마다. 그것도 아주 <i>기가 막힌</i> 해그지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Player
#. NodeID = 1ba8428a-3f8f-99fc-278d-34b0dcd29980
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - HAG_Hag_State_TookRightEye(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:1ba8428a-3f8f-99fc-278d-34b0dcd29980
msgctxt "h5b56dd38g1147g4dabgb951g8a4067b4e9fd"
msgid "Take the right eye."
msgstr "오른쪽 눈을 가져가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Player
#. NodeID = 20183c6a-bd03-ec18-e18f-ef850f7cd147
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_HagAmbush_Quest_Confrontation_EventSkipped = False
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:20183c6a-bd03-ec18-e18f-ef850f7cd147
msgctxt "hdc735905gc242g4c5cga0f5g6957993d1564"
msgid "So the brothers were right. You are a hag."
msgstr "그 형제들이 옳았군. 당신은 해그야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Auntie Ethel
#. NodeID = 260ca140-fae7-5311-ab12-9d584c7fb369
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:260ca140-fae7-5311-ab12-9d584c7fb369
msgctxt "h7025f155gd2d4g42b0gb277gba337e13b2f9"
msgid "You absolute <i>eejit</i>."
msgstr "이런 순 <i>멍청이</i> 같으니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Auntie Ethel
#. NodeID = 278815e8-b923-395b-2533-fe45e425e8ef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:278815e8-b923-395b-2533-fe45e425e8ef
msgctxt "had93a263g57aag4310gb9f5g516b8cb96ede"
msgid "I'd kill you for that - but why deny your wriggler the pleasure?"
msgstr "원래라면 그딴 말을 한 죄로 죽여버렸겠지만, 그건 벌레에게 대신 맡겨야겠지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Narrator
#. NodeID = 2a464e49-a856-4b7d-a78a-e09852c33ea0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:2a464e49-a856-4b7d-a78a-e09852c33ea0
msgctxt "h5ab121abg6702g4e1fg8ad5ge14ebbcf422c"
msgid "*You feel the creature writhe as it's dragged towards your ear...*"
msgstr "*당신은 생물이 당신의 귀를 향해 끌려가면서 몸부림치는 것을 느낍니다...*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Player
#. NodeID = 2e749218-fd28-257a-4f02-cfce4ecb24d1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - HAGEYED(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:2e749218-fd28-257a-4f02-cfce4ecb24d1
msgctxt "h72114f7bg9bf0g40efgaa66gca84086276e7"
msgid "What about my eye?"
msgstr "내 눈은 어쩌고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Auntie Ethel
#. NodeID = 2fccf778-f86c-7a11-dba7-7f8feca741f2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:2fccf778-f86c-7a11-dba7-7f8feca741f2
msgctxt "h73c3c5bfgfb4cg47bcga8d5g614673cdd821"
msgid "What about it? I held up my end of the bargain."
msgstr "뭐 어쩌라고? 내 할 몫은 다 했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Player
#. NodeID = 333cf5fd-4fda-5b40-cba5-f8a673d72980
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:333cf5fd-4fda-5b40-cba5-f8a673d72980
msgctxt "h17c1f6e4gb9dbg475dg8fc1g0813a8e029f8"
msgid "What do you mean, 'tampered'?"
msgstr "‘변조됐다’니 무슨 뜻이야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Player
#. NodeID = 34850cba-34ab-8ec5-14da-3ca0b1f4c50b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:34850cba-34ab-8ec5-14da-3ca0b1f4c50b
msgctxt "h106b9f54g4532g4c3aga09dgc66a0b0bce39"
msgid "Then you're of no use to me."
msgstr "그럼 넌 쓸모가 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Auntie Ethel
#. NodeID = 363231ff-afc6-3558-0506-09aaf353d9e5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:363231ff-afc6-3558-0506-09aaf353d9e5
msgctxt "h8aa718c2ga894g480cg991bgf16e054f13ae"
msgid "Now get out."
msgstr "이제 썩 꺼져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Auntie Ethel
#. NodeID = 3b4e00f5-23d9-1985-4db0-f9bdef0512b7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:3b4e00f5-23d9-1985-4db0-f9bdef0512b7
msgctxt "h84907a2bgcc12g4716gae71gc56cd4ef6f04"
msgid ""
"Someone's tampered with your parasite. That's likely why you've not turned "
"yet."
msgstr "누군가가 네 기생충을 변조시켰어. 그래서 네가 아직 변이하지 않은 것 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Auntie Ethel
#. NodeID = 3b612e33-0356-27da-b1f1-97152950e5aa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:3b612e33-0356-27da-b1f1-97152950e5aa
msgctxt "h984834f1gfe9cg4138gacebgabcb23c69cf3"
msgid ""
"Now - unless you want tentacles for a tongue, stay <i>absolutely</i> still."
msgstr "자, 이제 촉수 혀가 돋기 싫으면 <i>꼼짝도</i> 하지 말고 가만히 서 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Player
#. NodeID = 3ce87d9a-2672-3b0b-015f-74ed16519232
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:3ce87d9a-2672-3b0b-015f-74ed16519232
msgctxt "h8a8bb2b6gde81g44afgb309g7c6834cc64a2"
msgid "I thought you could remove it?"
msgstr "당신이 없애줄 수 있는 줄 알았는데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Auntie Ethel
#. NodeID = 3dad82ee-6bd3-7a35-a4b7-90a4f11da5c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:3dad82ee-6bd3-7a35-a4b7-90a4f11da5c8
msgctxt "he27d5b66g9df9g4ba8ga774g9f915b114e5a"
msgid "Now choose. Which eye will it be? Right or left?"
msgstr "이제 골라. 어느 쪽 눈으로 할 거야? 오른쪽? 왼쪽?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Auntie Ethel
#. NodeID = 3e00b064-c8ef-0f86-2768-fba616484c9b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:3e00b064-c8ef-0f86-2768-fba616484c9b
msgctxt "h4b90f2b0g3a0dg4379g9d32g0b8a7a224a09"
msgid ""
"Bless us, you're as slow as a wet week. That thing has been touched by more "
"than mind flayers."
msgstr "세상에, 너 정말 말을 못 알아듣는구나. 마인드 플레이어보다 더한 존재가 그것을 건드렸다는 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Auntie Ethel
#. NodeID = 412171b1-b1aa-a56a-f576-fec4b089fd4b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:412171b1-b1aa-a56a-f576-fec4b089fd4b
msgctxt "h56d1c7c7g519ag4dbagaa3bgcba73c98ca54"
msgid "That colour suits you."
msgstr "그 색이 너에게 어울리는구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Auntie Ethel
#. NodeID = 42dc0eef-c379-86dc-6f85-4cfe9440a36e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAG_Hag_State_ReadyForLair = True
#.   Object:
#.     - HAG_Hag_Event_GiveInspirationTalisman(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:42dc0eef-c379-86dc-6f85-4cfe9440a36e
msgctxt "h93d2af5fg64dfg4703gae0cgf3c845f8c0c1"
msgid ""
"Here. Don't let it be said that Auntie doesn't honour her deals. It's on "
"<i>you</i> to fix yourself."
msgstr "받아라. 이모가 거래를 지키지 않는다는 말이 떠돌면 안 되지. <i>네가</i> 직접 고치도록 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Narrator
#. NodeID = 45c07d88-c646-a027-c93b-ab624a021619
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:45c07d88-c646-a027-c93b-ab624a021619
msgctxt "h573ded27gbfecg48cfg83b5ga64e89c50ae7"
msgid "*The parasite squirms at the hag's words. Pain builds behind your eye.*"
msgstr "*해그의 말에 기생충이 꿈틀댑니다. 눈 뒤에 통증이 생깁니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Auntie Ethel
#. NodeID = 4ba57dc5-bdf2-e9f0-a005-ed2bc76bcdd1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - HAG_Hag_State_GotEye(0) = False
#.   Tag:
#.      - CANTLOSEEYE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:4ba57dc5-bdf2-e9f0-a005-ed2bc76bcdd1
msgctxt "h53d30b84gbb4bg49b9gb66ag1b249e657032"
msgid "Not you, you eejit. I need someone with <i>two </i>eyes in their skull."
msgstr "너 말고, 이 멍청아. 머리통에 <i>두 개</i>의 눈이 붙어있는 놈이 필요해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Auntie Ethel
#. NodeID = 50b39bae-7290-e9af-4b90-c8b4ba3d8aef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:50b39bae-7290-e9af-4b90-c8b4ba3d8aef
msgctxt "h98e20c78g57f8g42e9ga79bg752344df32a1"
msgid "Close that mouth, precious. Lest you swallow a fly."
msgstr "입 닫아, 이쁜이. 파리 삼킬라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Player
#. NodeID = 527afaa4-1a08-b8c2-5dce-5b7ce3cdde9a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:527afaa4-1a08-b8c2-5dce-5b7ce3cdde9a
msgctxt "h9e7e86b1g1802g409eg862dgd7743826e82d"
msgid "Which is your way of saying - you're not powerful enough."
msgstr "그러니까 당신 말을 해석해 보자면, 당신이 충분히 강력하지 않다는 뜻이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Auntie Ethel
#. NodeID = 53c6e213-1f03-7451-b110-524ad663da40
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:53c6e213-1f03-7451-b110-524ad663da40
msgctxt "h40d35f57ga5a5g49a2g952dgaa6adb4c21d7"
msgid "Filthy shadow magic - brings nothing but chains and misery."
msgstr "더러운 그림자 마법이야. 구속과 불행만을 불러오지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Player
#. NodeID = 54f464fd-7519-f903-47b5-8b7df6cc81bb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:54f464fd-7519-f903-47b5-8b7df6cc81bb
msgctxt "h628d0c5fg54e5g4c9cg9a5fg3ceac9102c7c"
msgid "Give me one reason why I shouldn't cut you down."
msgstr "내가 당신을 베어 쓰러뜨리면 안 되는 이유 하나만 대 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Auntie Ethel
#. NodeID = 5c8d87a9-b190-75f3-391f-0f6504bfadd7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Hag_State_FailedTadpole = True
#.   Quest:
#.     - GLO_Tadpole_SUB_Hag.HagTriedTadpoleHeal(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:5c8d87a9-b190-75f3-391f-0f6504bfadd7
msgctxt "heebc5162gcda6g48c6gafa2g54d7344a373c"
msgid ""
"You little shit - you didn't tell me it was Netherese. I'm not touching that."
msgstr "이 좆만한 새끼. 그게 네더릴 마법이라곤 말 안 했잖아. 그건 안 건드릴 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Player
#. NodeID = 5dda9175-d3d9-5fd4-4453-40689f76161f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:5dda9175-d3d9-5fd4-4453-40689f76161f
msgctxt "h83c621c0gcf4dg43c0gae80g4f5e198e8431"
msgid "<i>Check that your eye is still there.</i>"
msgstr "<i>당신의 눈알이 제자리에 있는지 확인해본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Auntie Ethel
#. NodeID = 62416ec8-090d-44f8-7ca1-1f75e32fed5f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:62416ec8-090d-44f8-7ca1-1f75e32fed5f
msgctxt "h38b18ad7gba15g420fg8c09g2f88583f10dc"
msgid "Aaaaaaagghhhhh!!! Gods-damned wretched - <i>argh</i>."
msgstr "아아아아아악! 망할 저주받은 끔찍한- <i>아악</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Player
#. NodeID = 678fecff-1019-7452-437e-2c1e66e31fc6
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_GITHYANKI or REALLY_PLANAR
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:678fecff-1019-7452-437e-2c1e66e31fc6
msgctxt "h6f16eab9g0319g4d70g8691g2e1d6d03418a"
msgid "What in all the spinning planes are you?"
msgstr "도대체 넌 뭐야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Player
#. NodeID = 678fecff-1019-7452-437e-2c1e66e31fc6
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:678fecff-1019-7452-437e-2c1e66e31fc6
msgctxt "hcb305eccg920eg47c0g8cbege47b4c60506c"
msgid "What in the hells are you?"
msgstr "대체 넌 뭐야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Auntie Ethel
#. NodeID = 6bf028ad-8190-dcae-1cae-32ee8acd0c63
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:6bf028ad-8190-dcae-1cae-32ee8acd0c63
msgctxt "ha7fc8bc8g8db7g4cb0g8a5bg8156caf46764"
msgid "Hold onto your knickers. This might <i>sting </i>a bit."
msgstr "바지 꽉 붙잡아. 조금 <i>따끔할지도</i> 몰라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Auntie Ethel
#. NodeID = 6d0bb167-5f03-95aa-4ad0-0415b54d2fd4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:6d0bb167-5f03-95aa-4ad0-0415b54d2fd4
msgctxt "hfd4992fbgb786g47b2gbbadg8ea127b0c9b0"
msgid "Thank you, petal. It is so <i>lovely </i>to be appreciated."
msgstr "고맙구나, 꽃잎아. 인정받는 건 항상 너무 <i>즐겁지</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Player
#. NodeID = 708e6d6d-4cbe-c082-cbce-940770f3a594
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:708e6d6d-4cbe-c082-cbce-940770f3a594
msgctxt "h37929851gcfe9g4272g9258gff362dbb9d75"
msgid "Netherese?"
msgstr "네더릴 마법이라니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Player
#. NodeID = 71d08c84-9834-37a5-e7da-8c9d7141f3bb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WIZARD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:71d08c84-9834-37a5-e7da-8c9d7141f3bb
msgctxt "he394bf02g996cg44f3g8f04ga8adf5c370d8"
msgid "A green hag. And a powerful specimen, it seems."
msgstr "녹색 해그로군. 그 중에서도 강력한 것 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Auntie Ethel
#. NodeID = 732f3080-cd1f-7a05-79e8-6379a99baf33
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:732f3080-cd1f-7a05-79e8-6379a99baf33
msgctxt "h6da0104bg4265g4b18g83ddgccfecc9c417c"
msgid "Strong and silent - good. You'll need it for this next bit."
msgstr "강인하고 과묵하군, 좋아. 이 다음에 벌어질 일을 위해 필요한 기질이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Player
#. NodeID = 789b8960-97e8-4b34-a503-ce61034ca53e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:789b8960-97e8-4b34-a503-ce61034ca53e
msgctxt "h783ad781ge0dbg4640ga886g1b2a26cc117a"
msgid "<i>Say nothing.</i>"
msgstr "<i>아무 말도 하지 않는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Player
#. NodeID = 795dfcfc-6101-0b44-4677-911fac258457
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:795dfcfc-6101-0b44-4677-911fac258457
msgctxt "h3501a143g1162g43d7g9c2fgf650892065ca"
msgid "Barely felt it, actually."
msgstr "별로 아프지도 않던데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Auntie Ethel
#. NodeID = 7fd54781-89fe-47ed-a562-d5940c22d619
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:7fd54781-89fe-47ed-a562-d5940c22d619
msgctxt "h412a85d7gba79g44aag8479g33c0a2657685"
msgid "I've removed one of these buggers before - but it's a touch tricky."
msgstr "전에도 이 놈을 제거해본 적이 있지. 살짝 까다롭기는 했지만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Auntie Ethel
#. NodeID = 800dfe1f-0a57-80f9-871e-be0e24cbcd1f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAG_Hag_State_ReadyForLair = True
#.   Object:
#.     - HAG_Hag_Event_GiveInspirationTalisman(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:800dfe1f-0a57-80f9-871e-be0e24cbcd1f
msgctxt "h71d83f60g6c0cg4f8egaf98g892658526680"
msgid "Here. It's on <i>you</i> to fix yourself."
msgstr "받아라. <i>직접</i> 고치도록 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Player
#. NodeID = 8843dd3b-ffef-5345-d97c-6b241b7163dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:8843dd3b-ffef-5345-d97c-6b241b7163dc
msgctxt "h41006cb5g0893g477eg8f25g7fe3227f8948"
msgid "Cute. Am I supposed to be impressed?"
msgstr "귀엽구나. 내가 감명받아야 하나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Auntie Ethel
#. NodeID = 8a0afb39-34fc-6b20-6ae6-d5345aa12499
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAG_Hag_State_ReadyForLair = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:8a0afb39-34fc-6b20-6ae6-d5345aa12499
msgctxt "h8ec8481eg0d94g48d2gaa2ag7eb5c25dc752"
msgid "Good riddance."
msgstr "속이 시원하군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Player
#. NodeID = 8eaf5357-d9ca-2094-bbeb-f997e83bf62b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - HAG_Hag_State_TookRightEye(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:8eaf5357-d9ca-2094-bbeb-f997e83bf62b
msgctxt "hbbbc1ca6g9c9dg441bgb0cdg89fb8392f29d"
msgid "Take the left eye."
msgstr "왼쪽 눈을 가져가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Player
#. NodeID = 91031823-bdf9-59ca-f276-9b719d271465
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:91031823-bdf9-59ca-f276-9b719d271465
msgctxt "h3a0a93d1g792fg4a41gafecgaf9b90b3d795"
msgid "Is there someone who can?"
msgstr "그럼 할 수 있는 사람이 있나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Player
#. NodeID = 99cdc8de-58e7-862f-217f-38d75c369234
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:99cdc8de-58e7-862f-217f-38d75c369234
msgctxt "hd5c10a98gf8abg4cc3gb198gf2fc43f50b43"
msgid "All the more reason to remove it - or else."
msgstr "제거할 이유만 더 늘은 셈이지. 아니면..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Auntie Ethel
#. NodeID = 9a5a73c3-f0e8-3ed4-d2a7-853392f4b418
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:9a5a73c3-f0e8-3ed4-d2a7-853392f4b418
msgctxt "hcbf4566bg9a7ag4c02g8a01gca43c739b16e"
msgid "Or else what?"
msgstr "아니면 뭐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Auntie Ethel
#. NodeID = 9ab9d200-41f2-82d9-6e74-8bfb2a6582f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:9ab9d200-41f2-82d9-6e74-8bfb2a6582f8
msgctxt "h656b9f57g978fg4b8dg8256g8c58351b62da"
msgid "Well, yes - I should bloody think so."
msgstr "뭐, 그래. 더럽게 감명받아야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Narrator
#. NodeID = a55a5f93-6f0c-74d9-0a94-2da0c1f86090
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:a55a5f93-6f0c-74d9-0a94-2da0c1f86090
msgctxt "h69c2a12fgda7eg438bg877fg59e722b790d1"
msgid "*...then it bites back, burrowing even deeper into your brain.*"
msgstr "*... 그러다 다시 깨물더니, 당신의 뇌 속으로 더 깊이 파고 듭니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Auntie Ethel
#. NodeID = abf636cd-4cb7-7337-d22e-fc2ff159eb13
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:abf636cd-4cb7-7337-d22e-fc2ff159eb13
msgctxt "h30650ebcg7525g4878gb6cfg9404915d1875"
msgid ""
"How could I have missed the stink? Like blood and piss congealing on my "
"tongue. <i>Bleh.</i>"
msgstr "이 악취를 어떻게 놓쳤던 거지? 피랑 오줌이 혀에 엉겨 붙는 것 같아. <i>우웩.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Auntie Ethel
#. NodeID = bcf75550-fa80-3cbe-755b-74fc67948824
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:bcf75550-fa80-3cbe-755b-74fc67948824
msgctxt "h6d14e094g0f05g440egaba8gbe732fad7186"
msgid "Not many get to see a hag in all her glory. Consider yourself blessed."
msgstr "해그의 영광스러운 본모습을 본 사람은 많이 없단다. 복 받은 거라고 생각하렴."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Auntie Ethel
#. NodeID = be50e3fe-15b1-970e-ebe0-64ac7da3c74f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:be50e3fe-15b1-970e-ebe0-64ac7da3c74f
msgctxt "hf1540d57g24f4g4828g8813g799aab919e4e"
msgid "Hah! Oh, you do make me laugh."
msgstr "하! 너 정말 날 웃게 만드는구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Auntie Ethel
#. NodeID = c22882d5-9e5a-8b59-2a00-a136f8b2e3b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:c22882d5-9e5a-8b59-2a00-a136f8b2e3b3
msgctxt "h1b7c7dd6g4c95g48c1gba2dg133f24707ca2"
msgid ""
"It's not my fault the wriggler's tainted by shadow magic. I want nothing to "
"do with you or that scum in your brain."
msgstr "그 벌레가 어둠의 마법에 오염된 건 내 탓이 아니라고. 너와 네 뇌 속에 있는 그 잡것과 더 관여하고 싶지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Auntie Ethel
#. NodeID = c4236e81-9e47-88ae-a190-be248c6055a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:c4236e81-9e47-88ae-a190-be248c6055a5
msgctxt "hab2c0ac2g935dg4909ga49fg8f9b1889fe45"
msgid "I can! But that thing has been touched by more than mind flayers."
msgstr "할 수 있지! 그치만 그것은 마인드 플레이어보다 더한 존재가 손을 댄 거라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Auntie Ethel
#. NodeID = c848db2a-d194-e318-ee3c-c385aa7ced6e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:c848db2a-d194-e318-ee3c-c385aa7ced6e
msgctxt "h139d36a4g32f0g4c66ga764g071dee370aca"
msgid "Magic is the lifeblood of hags. And I'm one of the <i>best</i>."
msgstr "마법은 해그의 생명소와도 같지. 그리고 나는 그 면에서는 <i>최고</i>라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Auntie Ethel
#. NodeID = cf837352-8d20-c851-e288-45bb68b6cd2d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_Hag_State_NotFirstTransformedDialog = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:cf837352-8d20-c851-e288-45bb68b6cd2d
msgctxt "h374b36adgc1f2g410dgad38g649f7f9af6ce"
msgid "There you are. Now where were we?"
msgstr "거기 있구나. 우리가 어디까지 얘기했더라?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Auntie Ethel
#. NodeID = dd1b2e42-f6ec-6b7a-fede-7e7ddc9741ce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:dd1b2e42-f6ec-6b7a-fede-7e7ddc9741ce
msgctxt "hf7b38708g895fg44ecga48dg3147c36dcc64"
msgid "You're a dead soul walking. I can't help you."
msgstr "네 영혼은 이미 죽은 것이나 다름없어. 내가 도와줄 수는 없다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Auntie Ethel
#. NodeID = dfcfcd3e-c4ca-cdd7-aba1-f14986669da0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:dfcfcd3e-c4ca-cdd7-aba1-f14986669da0
msgctxt "h1a76beddg60bcg48b4ga43bgfc905a5c4dcd"
msgid ""
"This is <i>my house</i>. And you will mind your manners - or I will use that "
"empty skull of yours as a teapot."
msgstr "여긴 <i>내 집</i>이야. 예의바르게 굴어, 안 그러면 네놈 두개골을 찻잔으로 써줄 테니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Player
#. NodeID = e3f8a9c4-d139-725e-c31a-b867a0f5a189
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:e3f8a9c4-d139-725e-c31a-b867a0f5a189
msgctxt "h9530a07ag12a4g4e42ga781g15e801e666cd"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Auntie Ethel
#. NodeID = eec664d0-fce4-7ce5-0c45-4c0184136ad0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:eec664d0-fce4-7ce5-0c45-4c0184136ad0
msgctxt "hf2d4f52cg8908g4dddg8a10g1185c46f4034"
msgid "Now - that wasn't so bad, was it?"
msgstr "됐어. 그렇게 끔찍하지는 않았지, 그치?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Auntie Ethel
#. NodeID = f864d2e2-a4da-6df3-db7d-c2a1fc5374ff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:f864d2e2-a4da-6df3-db7d-c2a1fc5374ff
msgctxt "h5a1e4f6dgffceg427ag8b05g769c306bc590"
msgid "But let it not be said that Auntie Ethel doesn't honour her debts."
msgstr "하지만 이모가 빚을 갚지 않는다는 말이 떠돌면 안 되지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Player
#. NodeID = fcd006dc-7faf-7956-3608-12f3c0f58a55
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:fcd006dc-7faf-7956-3608-12f3c0f58a55
msgctxt "h12aeb6f9g2692g4815ga82dg9f5b010d05ab"
msgid "I'm not leaving. This wasn't the deal."
msgstr "난 안 갈 거야. 거래는 이게 아니었잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Auntie Ethel
#. NodeID = fd5db49c-1f43-e1e8-1bca-4066555bfe6b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:fd5db49c-1f43-e1e8-1bca-4066555bfe6b
msgctxt "h40289969g4253g4a89gbbd7g735f76d3a446"
msgid "Much better. That human skin is fierce <i>restrictive</i>."
msgstr "훨씬 낫구나. 인간의 살갗은 정말 나를 너무 <i>구속</i>한단 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed
#. Speaker = Auntie Ethel
#. NodeID = ff2c2a13-578f-09f0-f9c2-2724263df9a0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Transformed:ff2c2a13-578f-09f0-f9c2-2724263df9a0
msgctxt "h95614f44ga14ag4030g9976ge455684d07c7"
msgid "Watch that tongue, petal. I <i>bite</i>."
msgstr "입 조심해, 꽃잎아. <i>물어버린다</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hagspawn_AD_HagSurrogateMotherStartScene
#. Speaker = Auntie Ethel
#. NodeID = 1260adc1-adf9-69e4-63dc-200e9daace59
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 75ec2ada-0db4-6f53-5b30-cdfe23465dac_B = False
#.     - 75ec2ada-0db4-6f53-5b30-cdfe23465dac_A = False
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hagspawn_AD_HagSurrogateMotherStartScene:1260adc1-adf9-69e4-63dc-200e9daace59
msgctxt "hff700119g56beg4a74g835dg19c9a7fd76bf"
msgid "What's the harm in one more?"
msgstr "하나 더가 어때서?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hagspawn_AD_HagSurrogateMotherStartScene
#. Speaker = Auntie Ethel
#. NodeID = 498af201-6f4b-4dfb-217b-f18ce7d31d1a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 75ec2ada-0db4-6f53-5b30-cdfe23465dac_B = False
#.      - 75ec2ada-0db4-6f53-5b30-cdfe23465dac_A = False
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hagspawn_AD_HagSurrogateMotherStartScene:498af201-6f4b-4dfb-217b-f18ce7d31d1a
msgctxt "h1e6aa027gcce0g427fg8b94gd1b9e7e2f232"
msgid "You've a face on you that could turn milk, petal."
msgstr "얼굴이 무슨 상한 우유처럼 밉상이구나, 얘야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hagspawn_AD_HagSurrogateMotherStartScene
#. Speaker = Auntie Ethel
#. NodeID = 906c7a22-d60c-4df3-5a92-4db9bb199a15
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 75ec2ada-0db4-6f53-5b30-cdfe23465dac_B = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hagspawn_AD_HagSurrogateMotherStartScene:906c7a22-d60c-4df3-5a92-4db9bb199a15
msgctxt "h648ec4c2g7366g4077g859eg4d849f9967f4"
msgid "Can't have anything happening to you or the babe, hm?"
msgstr "너나 그 아기에게 무슨 일이라도 생기면 안 되잖니, 응?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hagspawn_AD_HagSurrogateMotherStartScene
#. Speaker = Mayrina
#. NodeID = 931cb78b-e7b2-8b2e-adff-03aca9b61644
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 75ec2ada-0db4-6f53-5b30-cdfe23465dac_B = False
#.      - 75ec2ada-0db4-6f53-5b30-cdfe23465dac_A = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hagspawn_AD_HagSurrogateMotherStartScene:931cb78b-e7b2-8b2e-adff-03aca9b61644
msgctxt "h7698307egef94g49d5g9b76g98cd27bc4a7e"
msgid "Just for a moment? I need fresh air. <i>Please.</i>"
msgstr "잠깐만 안 되나요? 신선한 공기가 필요해요. <i>제발요.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hagspawn_AD_HagSurrogateMotherStartScene
