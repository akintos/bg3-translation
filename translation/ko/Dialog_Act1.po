msgctxt "hf253964bgc7fcg42dcgb973g18c8813dfde0"
msgid "Hit it again!"
msgstr "또 때려!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear
#. Speaker = Player
#. NodeID = b4831103-960e-dd59-5ce3-f4ad717cce0c
#. HandlePath = TaggedText[0].TagText[0]
