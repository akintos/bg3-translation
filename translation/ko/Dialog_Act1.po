msgctxt "ha25cfa7fg6e78g4366g9317g0a6bc849ef67"
msgid "Eh... drum's still workin' all right, True Soul. "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_AlarmUsedReaction
#. Speaker = Sentinel Olak
#. NodeID = 0d2ff539-e8cd-bf17-583a-0364cf1b0d7a
