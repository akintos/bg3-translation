msgctxt "hf2701130gc617g4652ga7b4g7d88f695eed1"
msgid "Do you need help, Ikaron?"
msgstr "내가 좀 도와줄까, 이카론?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AttackOnDen_AD_CoweringRefugee002
#. Speaker = Danis
#. NodeID = 72f93d2f-7451-6519-af2e-0d4ac14c8ed0
#. HandlePath = TaggedText[0].TagText[0]
