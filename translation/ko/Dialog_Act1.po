msgid "<i>Agh! </i>Still stings... don't know what else I expected."
msgstr "<i>악! </i>여전히 아프군... 뭘 기대한 건지 모르겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_PAD_HusbandGraveForcefield
