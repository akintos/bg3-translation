msgctxt "hdc7860f5g087bg411bga22dgccb0ebb4027f"
msgid "Who cares... done now..."
msgstr "알 게 뭐야... 다 끝났는데..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_General_Dead_SnakeKid
