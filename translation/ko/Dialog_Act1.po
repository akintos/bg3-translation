msgctxt "h5adca4f5g1154g45dfg9fafgc2493427eab7"
msgid "<i>Bow down and inspect the corpses more closely.</i>"
msgstr "<i>자세를 낮춰 시체들을 더 면밀히 조사한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted_Solo
