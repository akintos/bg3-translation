#.     - GOB_SpiderNest_State_SpidersChill = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders:c2e6ecd1-17a3-1b47-df06-46456b83f9c3
msgctxt "h42747c82g9479g4511g9f29g5951d7f66e76"
msgid "*She scuttles toward the door.*"
msgstr "*그녀는 문을 향해 다가갑니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders
#. Speaker = Narrator
#. NodeID = c7991204-987a-0986-680f-ed1a741fbffe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders:c7991204-987a-0986-680f-ed1a741fbffe
msgctxt "hd17726b4g2406g4717g8b9cg4c5a4a5797da"
msgid "*The other spider echoes her.*"
msgstr "*다른 거미가 그녀를 따라합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders
#. Speaker = Narrator
#. NodeID = c8bb2bd0-23a8-420c-675c-52057a856bf9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders:c8bb2bd0-23a8-420c-675c-52057a856bf9
msgctxt "hf1264277g994eg4c91g8b3agb987dea70864"
msgid "*The spider hisses and attacks.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders
#. Speaker = Larger Giant Spider
#. NodeID = d76c33b5-004c-c6fc-f23e-8f72b9231b59
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_SpiderNest_State_DoorOpen = False
#. SetFlags:
#.   Global:
#.     - GOB_SpiderNest_State_SpidersChill = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders:d76c33b5-004c-c6fc-f23e-8f72b9231b59
msgctxt "h53820b9eged90g4f15g93e2g46bb9874c6c5"
msgid "Open the door so I can do your bidding."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders
#. Speaker = Larger Giant Spider
#. NodeID = dd76b4f4-f83b-13f4-fdb2-7d7a32d9c82d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders:dd76b4f4-f83b-13f4-fdb2-7d7a32d9c82d
msgctxt "hf2be75b7g26afg4352g9186g6f86817e859b"
msgid "Of course, my queen."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders
#. Speaker = Larger Giant Spider
#. NodeID = dde0410d-e0c8-a5df-ed9d-f6b0f7cadb2c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders:dde0410d-e0c8-a5df-ed9d-f6b0f7cadb2c
msgctxt "h70dda496g542bg45ccga099g737c327069b4"
msgid "I do not get sick. I wrap. I bind. I bite. I eat."
msgstr "난 아프지 않아. 휘감아. 구속하고. 물어서. 먹는다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders
#. Speaker = Larger Giant Spider
#. NodeID = dedce42e-8d8f-b70d-9e84-fba23167b880
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_SpiderNest_State_DoorOpen = True
#. SetFlags:
#.   Global:
#.     - GOB_SpiderNest_State_SpidersChill = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders:dedce42e-8d8f-b70d-9e84-fba23167b880
msgctxt "h4b75dc7fgaac1g4ef1g99a7g41864fe04b2f"
msgid "Their blood will sicken from my bite."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders
#. Speaker = Larger Giant Spider
#. NodeID = df6f7f1d-45fd-4b7d-e6d7-e495a224d45f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_SpiderNest_Spiders_PersuadedCursed(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders:df6f7f1d-45fd-4b7d-e6d7-e495a224d45f
msgctxt "h5e73cd31g81eag4d2dgbedcg7c0a3cff19b9"
msgid ""
"I see your sickness. A poison in the skull. Do not touch me, do not come "
"close."
msgstr "네 병이 보인다. 머릿속에 독이 들어갔어. 날 만지지 말고, 가까이 오지도 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders
#. Speaker = Larger Giant Spider
#. NodeID = e0d7f7ae-121b-de1c-42cf-a5225b394c38
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_SpiderNest_State_SpidersOut = True
#.      - GOB_SpiderNest_State_SpidersChill = True
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders:e0d7f7ae-121b-de1c-42cf-a5225b394c38
msgctxt "hcd0dec29g89d2g47feg85a6g7b0fb267c8b2"
msgid "*Skreeee!*"
msgstr "*키이익!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders
#. Speaker = Larger Giant Spider
#. NodeID = e170923d-f4fb-8a28-aeca-be88dc4e96c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders:e170923d-f4fb-8a28-aeca-be88dc4e96c4
msgctxt "h206ed677gab8bg472bga492gefb9b70214b7"
msgid ""
"More delicious than you? More bindable? More wrappable? More biteable? No."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders
#. Speaker = Larger Giant Spider
#. NodeID = e97ce2c2-09f5-7739-1ba5-e2eb2af8e9bd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_SpiderNest_Spiders_LolthPersuasion(1) = True
#.   Global:
#.      - GOB_SpiderNest_State_SpidersOut = False
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders:e97ce2c2-09f5-7739-1ba5-e2eb2af8e9bd
msgctxt "hdc580dddg69e8g45fbg8055g4cfeb3675e24"
msgid "What would you have me do?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders_CantSpeak
#. Speaker = Narrator
#. NodeID = 65c94d78-b58f-460f-83a4-0c2e53aa5e9b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders_CantSpeak:65c94d78-b58f-460f-83a4-0c2e53aa5e9b
msgctxt "hf24374bdgdd2eg4828g8f18g91237917032f"
msgid ""
"*The spider seems poised to attack, but she hesitates, tapping her claws as "
"if trying to communicate.*"
msgstr "*거미는 공격할 준비가 된 것 같지만, 의사소통을 하려는 듯이 발톱을 두드리며 기다립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders_CantSpeak
#. Speaker = Narrator
#. NodeID = 75da2fdc-0156-473a-8a4b-429d0ac01cfe
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_SpiderNest_State_SpidersHostile = True
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SpiderNest_Spiders_CantSpeak:75da2fdc-0156-473a-8a4b-429d0ac01cfe
msgctxt "h43eafa31g0899g47f1g97b2g2813336bd96c"
msgid ""
"*You, however, are unable to speak. Her hesitation turns to impatience.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 01e7bf3a-bacc-e85e-e283-89cb71aacc12
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Torturers_Assisted(1) = True
#.   Global:
#.      - GOB_Torturers_State_PrisonerFreed = True
#. SetFlags:
#.   Dialog:
#.     - GOB_TorturedAdventurer_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:01e7bf3a-bacc-e85e-e283-89cb71aacc12
msgctxt "h2e0aefb9ga689g45b2gb448g1ec01e0847b3"
msgid "Get - get away from me! Please! D-don't hurt me!"
msgstr "저리 - 저리 가세요! 제발! 절 해-해치지 마세요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 03b8389f-df7b-9430-bf85-5400582fe5af
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:03b8389f-df7b-9430-bf85-5400582fe5af
msgctxt "hffb6a99cg931bg46eeg8a5fg6eec07440ad5"
msgid ""
"It should be here somewhere. He said there was a hidden passage underneath "
"the temple."
msgstr "분명 이곳 어딘가에 있을 거예요. 신전 지하에 숨겨진 통로가 있다고 들었거든요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 046f50bb-cf42-c815-c29e-ac6f997fb182
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:046f50bb-cf42-c815-c29e-ac6f997fb182
msgctxt "h586c532fge68eg4a1egab23gf50b4bb05098"
msgid "Be patient - I'll be back."
msgstr "인내심을 갖고 기다려, 다시 돌아올 테니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 05c41903-968e-a2e9-f92f-0f31b1cafe5d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Torturers_State_TorturedEnough = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:05c41903-968e-a2e9-f92f-0f31b1cafe5d
msgctxt "hf4b8c07bga363g4469g9c12g05d6a3f66372"
msgid "And now they know about the grove. Gods. I - I need to warn them!"
msgstr "이제 놈들이 숲에 대해서 알아냈어요. 신이시여. 제 - 제가 그들에게 경고해 줘야 해요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Narrator
#. NodeID = 06c71cfa-e913-55ee-b240-4c149886a45d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_TorturedAdventurer_State_Unlocked = True
#.   Object:
#.      - GOB_TorturedAdventurer_State_Faint(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:06c71cfa-e913-55ee-b240-4c149886a45d
msgctxt "h11a7a466g30dfg4d74g9c2bg088f1d122b28"
msgid "*The battered man lies crumpled on the ground, unconscious.*"
msgstr "*구타당한 남자는 의식을 잃은 채 바닥에 누워 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 07e21ae8-4e7c-0858-a873-367b753cf251
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_TorturedAdventurer_LeftInChains(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:07e21ae8-4e7c-0858-a873-367b753cf251
msgctxt "h111066f4g055cg4736gb1bdg7d20b8b610bf"
msgid "Exactly. You're no use to me - so rot down here for all I care."
msgstr "정확해. 넌 이제 내게 쓸모가 없어, 이제 이 아래에서 마음껏 썩어가라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 08d77f8e-7cb9-ac54-ff20-88499dffbb7a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_TorturedAdventurer_Knows_FailedMindRead(1) = True
#.   Global:
#.     - GOB_TorturedAdventurer_State_FailedPersuasion = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:08d77f8e-7cb9-ac54-ff20-88499dffbb7a
msgctxt "he95cc113g9a0dg4f9agbe94gbbeb3fd9da67"
msgid "What - what are you doing? G-get away from me!"
msgstr "뭐 - 뭘 하시는 거예요? 제게서 떠-떨어지세요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 0c345653-4590-acbd-7e4a-a1a0bf379bb7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - Has_TaggedItem_HEALING_POTION(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:0c345653-4590-acbd-7e4a-a1a0bf379bb7
msgctxt "h9dcffc4bg90cfg4511g9088g45bd55f7ecbf"
msgid "<i>Pour a healing potion into his mouth.</i>"
msgstr "<i>그의 입에 치유의 물약을 붓는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 0db1fb8d-3582-9d04-06ab-161feb0c980a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:0db1fb8d-3582-9d04-06ab-161feb0c980a
msgctxt "h94557b2ag1fe4g4896g946bgcb785ed1aaeb"
msgid "Help? You... you could have killed me!"
msgstr "도움이라고요? 저... 절 죽였을지도 몰라요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 0f6ea6a7-8665-85d8-33ab-97b901833b45
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_TorturedAdventurer_LeftInChains(1) = True
#.     - GOB_TorturedAdventurer_Knows_FailedPersuade(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:0f6ea6a7-8665-85d8-33ab-97b901833b45
msgctxt "h09c2a04bg6c72g4a30g9295g43c1f5a36cf7"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 104e9e0f-9534-37a3-a753-a7fab3058536
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Torturers_State_PrisonerFreed = True
#.   Local:
#.      - 6621e6ea-f89e-a19d-e8dc-6e6bc0779404_AskedQuestions = False
#. SetFlags:
#.   Dialog:
#.     - GOB_TorturedAdventurer_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:104e9e0f-9534-37a3-a753-a7fab3058536
msgctxt "h1559bfb8geda9g4aadgbe26gf162df111a1e"
msgid "Thank you, I... I'd better go, before they catch us."
msgstr "고마워요, 저... 전 놈들에게 붙잡히기 전에 가야겠어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 125c2737-aac2-c4c6-bfa2-8e4a6826b68e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 0
#. CheckFlags:
#.   Local:
#.      - 6621e6ea-f89e-a19d-e8dc-6e6bc0779404_MindHasBeenRead = False
#.   Script:
#.      - GEN_CanDetectThoughts_2 = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:125c2737-aac2-c4c6-bfa2-8e4a6826b68e
msgctxt "hb58ac740gcccag4338ga4f7g71987114c0c9"
msgid "<i>Read his mind.</i>"
msgstr "<i>그의 생각을 읽는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 127ab080-639b-da2c-2c9d-ee2840b35720
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:127ab080-639b-da2c-2c9d-ee2840b35720
msgctxt "h6bcf5f39gace7g4063gb091gab44a1b8ba81"
msgid "<i>Nnnearrgh!  </i>You said on three!"
msgstr "<i>끄아아아악!  </i>셋에 하신다고 했잖아요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 13b4e63a-f85c-5d9a-036d-168b17006f3b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_AdventurersQuest_Knows_AboutSH = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:13b4e63a-f85c-5d9a-036d-168b17006f3b
msgctxt "hc429695cg05f2g4eebg9f01g7ecc5f842f06"
msgid "How did you end up on that rack?"
msgstr "어쩌다 그 고문대에 붙잡히게 된 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Narrator
#. NodeID = 14c26198-0259-4c0a-b8c5-66d92e9a6bf0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:14c26198-0259-4c0a-b8c5-66d92e9a6bf0
msgctxt "h834ede22g46e3g4363gb8cdg39d2f6d2cae2"
msgid ""
"*But was it truly <i>nothing?  </i>The pain gripped you tight, robbing you "
"of all composure for a moment...*"
msgstr "*하지만 정말 <i>아무 것도</i> 아니었을까요? 고통은 당신을 꽉 휘어잡았고, 한순간 평정심을 잃을 정도였습니다...*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 166f0643-2111-46b4-5d41-1fa300d12642
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:166f0643-2111-46b4-5d41-1fa300d12642
msgctxt "hdc00f778gc3c0g4b03gadd6ga6e7e9ac9725"
msgid ""
"Remira? She's... she's alive then. Oh, thank the gods. I - I need to get out "
"of here."
msgstr "레미라가요? 그녀가... 그녀가 살아남았다는 거군요. 오, 신이시여, 감사합니다. 전-전 여기서 빠져나가야 해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 16fbf31c-779c-ded1-e5b2-40119cd87f5b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_TorturedAdventurer_Knows_AskedWhatNightsongDoes(1) = False
#.   Global:
#.      - GLO_AdventurersQuest_Knows_AboutSH = True
#.      - GOB_TorturedAdventurer_Knows_WasLookingForSH = True
#. SetFlags:
#.   Dialog:
#.     - GOB_TorturedAdventurer_Knows_AskedWhatNightsongDoes(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:16fbf31c-779c-ded1-e5b2-40119cd87f5b
msgctxt "h72291e83gdfa5g4367gbf7eg8e320d80d200"
msgid "The Nightsong. What does it do, exactly?"
msgstr "밤의 노래. 그건 정확히 뭐 하는 물건이지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 19bbd7e7-3872-abdc-8f19-50e2f50154bb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_TorturedAdventurer_WasMean(1) = False
#.      - GOB_Torturers_Assisted(1) = False
#.      - GOB_Torturers_AssistedForFun(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:19bbd7e7-3872-abdc-8f19-50e2f50154bb
msgctxt "h94146c26gd984g44a3g8d64gee689b90c66b"
msgid "Are you hurt?"
msgstr "다친 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 19f007af-ad4b-6049-4eea-078d339e49e3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_TorturedAdventurer_Knows_ShadowheartChainPersuadeSuccess(1) = True
#.   Object:
#.      - GLO_SafeRomance_Enabled(1) = False
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:19f007af-ad4b-6049-4eea-078d339e49e3
msgctxt "hd0e3d2e1g74f1g4eb1gab14g5a96aa46a023"
msgid "<i>Seize one of his hands and break his thumb.</i>"
msgstr "<i>그의 손 하나를 붙잡고 엄지손가락을 부러뜨린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 1b375304-135d-0eab-a3ea-102377b8b20f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_HappyTorturers_Knows_PlayersKnowDenLocation = True
#.   Quest:
#.     - DEN_Conflict_SUB_AoD.GotGroveLocation(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:1b375304-135d-0eab-a3ea-102377b8b20f
msgctxt "h658a4a14g7700g4671gb60eg901f48a600e1"
msgid ""
"Th-the grove. To the east. They wanted to know where we came from. They'll k-"
"kill everyone. Please... get me out of here."
msgstr ""
"수-숲이요. 동쪽에 있어요. 놈들은 우리가 어디서 왔는지 알아내려고 했어요. 그들이 모두를 주-죽일 거예요. 제발... 절 여기서 "
"꺼내주세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 1c321f54-e728-4137-a19f-c799e254018b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_State_IncurableWound_Unavailable = False
#.      - GLO_Not_For_EA = True
#.   Tag:
#.      - AVATAR(1) = False
#.      - REALLY_SHADOWHEART(1) = True
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_Event_IncurableWoundFlared = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:1c321f54-e728-4137-a19f-c799e254018b
msgctxt "hb81d56c5g9ec2g49fagb382g6c504ea52f75"
msgid "<i>Ngh</i>... it hurts..."
msgstr "<i>으</i>...아파..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 1dbcdf9f-9433-6089-4819-02df58800b14
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - SHA_Nightsong.LearnedLocation(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:1dbcdf9f-9433-6089-4819-02df58800b14
msgctxt "hfc0c8825g205cg46afgb70bg17cb7129023d"
msgid "It's called th-the Nightsong. We tried to s-sneak past the goblins..."
msgstr "그-그건 밤의 노래라는 유물이에요. 저흰 고블린들을 지나 모-몰래 지나가려고 했죠..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 1f62d62b-00c9-fd51-7821-28d4eac9dd2c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:1f62d62b-00c9-fd51-7821-28d4eac9dd2c
msgctxt "ha8533939gb83dg4848g9d18g939bf9969bf2"
msgid "Th-then why?"
msgstr "그-그럼 어째서?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 22143cee-7486-f8af-eed8-03591aad3d0b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_AdventurersQuest_Knows_AboutSH = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:22143cee-7486-f8af-eed8-03591aad3d0b
msgctxt "h7e1777bbg8e59g44e1gaccdg466044a87468"
msgid "How did you end up in here?"
msgstr "어쩌다 이곳에 오게 된 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 23b7691e-8935-f87a-7635-f3a97a291a1c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_TorturedAdventurer_PromisedToFree(1) = False
#.      - GOB_TorturedAdventurer_LeftInChains(1) = False
#.      - GOB_Torturers_Assisted(1) = True
#.   Global:
#.      - GOB_Torturers_State_PrisonerFreed = False
#. SetFlags:
#.   Dialog:
#.     - GOB_TorturedAdventurer_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:23b7691e-8935-f87a-7635-f3a97a291a1c
msgctxt "h71e2c6b3gebd8g4543gaf8fgb0ea1b7fc7e9"
msgid "G-get away! Please, no more!"
msgstr "저-저리 가세요! 제발, 더는 안 돼요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 24942e5f-98c6-9868-b7c3-e43dc3786d31
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:24942e5f-98c6-9868-b7c3-e43dc3786d31
msgctxt "h35aa6bacgbb8eg494fga892g3729b3d5e696"
msgid "What else do you know about the temple? Any other treasure?"
msgstr "이 신전에 대해 더 알고 있는 건 없나? 다른 보물이라도 있어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 25174b1b-48c1-494f-8f52-b3196c4e873b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:25174b1b-48c1-494f-8f52-b3196c4e873b
msgctxt "ha8c4fc09gbca5g4bbcgafecg4b1ed6573881"
msgid "<i>It was nothing. Put it out of your mind.</i>"
msgstr "<i>아무 일도 아니었다. 마음 속에서 치워 버린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 289b1e51-fcd2-78d4-44f0-3af12300a2b5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:289b1e51-fcd2-78d4-44f0-3af12300a2b5
msgctxt "h33ed48bcg96f7g40f5gbaecgf4f1e6e53780"
msgid "I'll try something else first."
msgstr "먼저 다른 걸 해보도록 하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 2951518e-8c41-1185-62a6-4a17f4e40759
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:2951518e-8c41-1185-62a6-4a17f4e40759
msgctxt "h1a85eb9dgbfebg42bdg85ebg6d96d5e8ba9f"
msgid "The place was supposed to be abandoned, b-but when we arrived..."
msgstr "이 장소가 버려진 곳인 줄 알았죠. 하-하지만 저희가 도착했을 떈..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 2992a916-2149-8bf5-17f9-b718b630dfe0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:2992a916-2149-8bf5-17f9-b718b630dfe0
msgctxt "h3a46635bg9bf8g4607g9ca6g35cf6e3219d7"
msgid "No... no, please! Please! They'll kill me!"
msgstr "안 돼... 안 돼, 제발요! 제발! 그들이 절 죽여버릴 거예요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 2c124cb9-5704-fa11-ee69-de0df00299e3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_AdventurersQuest_Knows_AboutSH = True
#.     - GOB_TorturedAdventurer_Knows_WasLookingForSH = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:2c124cb9-5704-fa11-ee69-de0df00299e3
msgctxt "h04f9499cg940bg444fgbe01g34bbc89206f2"
msgid ""
"... b-but they ambushed us. I didn't think a pack of goblins could be so... "
"so efficient."
msgstr "... 하-하지만 놈들이 매복하고 있었어요. 전 고블린 무리가 그렇게... 효율적으로 행동할지 몰랐어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 2ca00c47-dd32-1cc6-496f-649ac0c169ef
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - DEN_Conflict.HeardAboutAoD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:2ca00c47-dd32-1cc6-496f-649ac0c169ef
msgctxt "h2f8ccd4bg2310g4f84gbb1ag324594f19e58"
msgid ""
"I c-can't tell you where the grove is, please. If they find out, they'll... "
"they'll kill everyone!"
msgstr "숲이 어디에 있는지는 아-알려드릴 수 없어요, 제발요. 그들이 알아내면, 놈들이... 놈들이 모두를 죽일 거라고요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 2e66ac22-b26c-432a-dbc4-dd58c93021f3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - SHA_Nightsong.LearnedLocation(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:2e66ac22-b26c-432a-dbc4-dd58c93021f3
msgctxt "he37e5743g0218g4029g83d0g697d2f1a3f59"
msgid "It's called th-the Nightsong. We tried to s-sneak past the goblins..."
msgstr "그-그건 밤의 노래라는 유물이에요. 저희는 고블린들을 지나 모-몰래 지나가려고 했죠..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 306e3135-4761-70bc-c59c-b425ac0b3906
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_TorturedAdventurer_PromisedToFree(1) = True
#.   Global:
#.     - GOB_TorturedAdventurer_State_PromisedToFreeNoParty = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:306e3135-4761-70bc-c59c-b425ac0b3906
msgctxt "h2b7450b0gc181g4503g8494g88c29fe15f19"
msgid "Relax. I'm not going to leave you here."
msgstr "진정해. 널 여기 두고 떠나진 않을 거니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 30a8613f-82ba-2b1e-0a9d-c601483d33cb
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_TorturedAdventurer_ToldAboutMap(1) = True
#.   Global:
#.     - DEN_AdventurersQuest_Knows_LeaderMap = True
#.   Quest:
#.     - SHA_Nightsong.LearnedBryanMap(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:30a8613f-82ba-2b1e-0a9d-c601483d33cb
msgctxt "h744a9fe2ga8c5g4264g80a9g54739dbb21a0"
msgid ""
"B-Brian had instructions, but... the g-goblins got him. They - they said "
"they'd e-eat him..."
msgstr "브-브라이언이 지시사항을 가지고 있었는데... 고-고블린들에게 붙잡혔어요. 그-그놈들이 브라이언을 자-잡아먹겠다고 했죠..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 315f3dae-dfe2-5ee6-496c-fa445c04e3f8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_TorturedAdventurer_AskedForHalsin(1) = False
#.   Global:
#.      - GLO_Halsin_Knows_IsFound = False
#.      - GLO_Halsin_Knows_IsMissing = True
#. SetFlags:
#.   Dialog:
#.     - GOB_TorturedAdventurer_AskedForHalsin(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:315f3dae-dfe2-5ee6-496c-fa445c04e3f8
msgctxt "hfe8f9a37gd76bg45b0ga6a5g6387f9412f23"
msgid "One more question: what happened to the druid?"
msgstr "질문 하나 더 하지: 그 드루이드는 어떻게 됐지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 32a41187-4bf3-fb12-eac1-cba6bbe79313
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_TorturedAdventurer_LeftInChains(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:32a41187-4bf3-fb12-eac1-cba6bbe79313
msgctxt "h74b89f08gaa4bg45f1gbb93gd1dbeb6937cf"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 34836f9d-04c8-ab77-7433-c2bbb27b3c44
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:34836f9d-04c8-ab77-7433-c2bbb27b3c44
msgctxt "h90487bceg74dfg4369g9cfcg18fa16100271"
msgid "<i>Snap the other thumb.</i>"
msgstr "<i>다른 엄지손가락도 부러뜨린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 34e4c094-0147-ef55-b8a9-7446cadd6e44
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_TorturedAdventurer_PromisedToFree(1) = True
#.   Global:
#.      - GOB_Torturers_State_PrisonerFreed = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:34e4c094-0147-ef55-b8a9-7446cadd6e44
msgctxt "h73231539g681eg4abagb4e8g5f0938e9be97"
msgid "Please - get me out."
msgstr "제발 - 절 꺼내주세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 35e96ca3-42bf-4111-a612-142af65d624a
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:35e96ca3-42bf-4111-a612-142af65d624a
msgctxt "hce9cd714gedc2g46dfga2adgcb08bb2cf00f"
msgid "And yet you're still alive. Stop whining."
msgstr "하지만 아직 살아있잖아. 그만 징징대."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 37f7aa4f-b34e-263d-36e7-1f9e36da9532
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#. TagRule: BERSERKER
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:37f7aa4f-b34e-263d-36e7-1f9e36da9532
msgctxt "h0945d204g401fg4749gae41g70c96b216fdb"
msgid "<b>DON'T TEMPT ME. </b>"
msgstr "<b>날 시험하지 마. </b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 37f7aa4f-b34e-263d-36e7-1f9e36da9532
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:37f7aa4f-b34e-263d-36e7-1f9e36da9532
msgctxt "h35708937g326dg42b2g8b35g62e2d06760fc"
msgid "Might be tempted - unless you do as I say."
msgstr "그러고 싶어질지도 모르지, 내가 말하는 대로 하지 않으면 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 3895c3e3-9a57-4a14-8b24-8066a5151bb1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Torturers_State_PrisonerFreed = False
#. SetFlags:
#.   Dialog:
#.     - GOB_TorturedAdventurer_PromisedToFree(1) = True
#.   Global:
#.     - GOB_TorturedAdventurer_State_PromisedToFreeNoParty = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:3895c3e3-9a57-4a14-8b24-8066a5151bb1
msgctxt "h01be155ega4e8g46e5gb495g726feddde32c"
msgid "Hang on, I'll get you free."
msgstr "가만히 있어봐, 풀어줄게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 38bcb35f-d544-7e42-2ea4-1585583785e4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_TorturedAdventurer_Knows_FailedMindRead(1) = True
#.   Global:
#.      - GOB_Torturers_State_PrisonerFreed = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:38bcb35f-d544-7e42-2ea4-1585583785e4
msgctxt "he9829824ge0a5g4c8cga052g0456c79a83d6"
msgid "No! G-get away from me!"
msgstr "안 돼! 저한테서 떠-떨어져요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Narrator
#. NodeID = 3a6cd9ee-98b1-4595-6e8e-aaa7b8309dc4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_TorturedAdventurer_Event_RemoveHealingPot = True
#.   Object:
#.     - GOB_TorturedAdventurer_State_Faint(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:3a6cd9ee-98b1-4595-6e8e-aaa7b8309dc4
msgctxt "h6030b986g5f5cg4a89g92b3g1827d4ffecd7"
msgid ""
"*The man coughs hard, but his eyes shoot open and the colour returns to his "
"cheeks.*"
msgstr "*남자는 기침을 심하게 하지만, 눈이 번쩍 뜨이고 뺨에 색이 돌아옵니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 3b5f1634-dcd5-45ec-6f1a-0914c567154f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:3b5f1634-dcd5-45ec-6f1a-0914c567154f
msgctxt "he062b838g26f5g42e2ga520g41edcd047ea0"
msgid "Help? You... you could have killed me!"
msgstr "도움이라고요? 저... 절 죽였을지도 몰라요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 3bdb23f9-0088-fcbb-7d60-d70e17664e28
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:3bdb23f9-0088-fcbb-7d60-d70e17664e28
msgctxt "h633b72d9g3d86g413agaa14g921cf5990317"
msgid "That's all I know! Please... g-get me out of here!"
msgstr "그게 제가 아는 전부에요! 제발... 저-절 여기서 꺼내주세요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 3c45e74d-2a49-66d7-1efb-110a57e08c78
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_TorturedAdventurer_LeftInChains(1) = True
#.     - GOB_TorturedAdventurer_Knows_FailedPersuade(1) = True
#.   Global:
#.     - GOB_TorturedAdventurer_State_FailedPersuasion = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:3c45e74d-2a49-66d7-1efb-110a57e08c78
msgctxt "he6f4ccf5g8eacg4658g9fc8g2bda3dfe1456"
msgid "Y-you could've killed them! Just... just leave, please!"
msgstr "그-그들을 죽였을 수도 있잖아요! 그냥... 그냥 떠나 주세요, 제발요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 3ea416af-4bb7-5563-bb63-befef49402de
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_TorturedAdventurer_LeftInChains(1) = True
#.     - GOB_TorturedAdventurer_Knows_FailedPersuade(1) = True
#.   Global:
#.     - GOB_TorturedAdventurer_State_FailedPersuasion = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:3ea416af-4bb7-5563-bb63-befef49402de
msgctxt "h2b74b84cg9be3g4d2cgb3e6gc58decab163b"
msgid "Are you mad? Just... just leave, please!"
msgstr "정신이 나간 거예요? 그냥... 그냥 떠나세요, 제발요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 3ed8b91b-556d-4b94-bc03-f0a6a9488461
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_TorturedAdventurer_PromisedToFree(1) = True
#.   Global:
#.     - GOB_TorturedAdventurer_State_PromisedToFreeNoParty = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:3ed8b91b-556d-4b94-bc03-f0a6a9488461
msgctxt "hf823c966ge900g4075gbe2fgf85f4463d0b9"
msgid "I'm sorry. I only did it to help you."
msgstr "미안해. 도와주려고 한 일이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 41710df0-6295-f3c7-1c0b-68b70b2475df
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_AdventurersQuest_Knows_AboutBounty = True
#.   Quest:
#.     - SHA_Nightsong.HeardOf(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:41710df0-6295-f3c7-1c0b-68b70b2475df
msgctxt "h0a3871bfg3dabg41c6g976dg70d74b756794"
msgid ""
"He j-just said some wizard called Lorroakan would reward us if we found it. "
"That's all!"
msgstr "그가 말, 말하길 로로아칸이라는 위저드가 그걸 찾으면 우리에게 보상을 준다고 했댔어요. 그게 다예요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 42959e1e-9721-0f85-3323-8f028e1d6925
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_TorturedAdventurer_State_Unlocked = False
#.      - GOB_Torturers_State_PrisonerFreed = False
#.   Object:
#.      - GOB_Torturers_State_HasKey(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:42959e1e-9721-0f85-3323-8f028e1d6925
msgctxt "h90a26174gd113g45c3g9d2dg0276ea199074"
msgid "<i>Use the key to unlock his chains.</i>"
msgstr "<i>열쇠로 그의 사슬을 풀어준다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 471c9d5c-0cbc-803d-ff59-863665c8330f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 6621e6ea-f89e-a19d-e8dc-6e6bc0779404_MindHasBeenRead = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:471c9d5c-0cbc-803d-ff59-863665c8330f
msgctxt "h9bff86fdgab65g4d3cgb6b1g80843044b317"
msgid "Remira sent me. She said you were in trouble."
msgstr "레미라가 나를 보냈어. 그녀가 말하길 네가 곤경에 처해 있다더군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 47396da1-0ec1-2ecb-436c-e312396f4521
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_TorturedAdventurer_WasMean(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:47396da1-0ec1-2ecb-436c-e312396f4521
msgctxt "h215325a5g1e1fg4d66g98fcgf89cfd82109a"
msgid "The pain stops when you answer my questions."
msgstr "내 질문에 대답하면 고통이 멈출 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 495efbba-fc7a-7fa7-8607-f9f5145903d0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_TorturedAdventurer_Knows_ShadowheartChainPersuadeSuccess(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:495efbba-fc7a-7fa7-8607-f9f5145903d0
msgctxt "hfd91c3a0g1e3fg45bcg8587gf2158332984e"
msgid "I... I can't. I'm sorry, I just... I can't bear any more."
msgstr "전... 전 못하겠어요. 죄송해요, 그냥... 더 이상은 못 버티겠어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 4a025518-021a-0962-6d05-4a68c17a5c60
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:4a025518-021a-0962-6d05-4a68c17a5c60
msgctxt "h7c59f1dbg812eg4555g8ddcg017b97e69392"
msgid "Fine. Just... what do you want?"
msgstr "좋아요. 그냥... 뭘 원하세요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 4d275999-1f1e-f363-a3b0-3157dd08daf0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:4d275999-1f1e-f363-a3b0-3157dd08daf0
msgctxt "h033be588ge899g44d6g9cc7g104b1aabdec0"
msgid "I'm not sure - all I know is there's a p-passageway to the Nightsong."
msgstr "잘 모르겠어요. 전 밤의 노래를 찾을 토-통로가 있다는 것만 알아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 50782399-ba88-7aaa-b011-336c2231cf3e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_PartyProgress_EnteredGrove = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:50782399-ba88-7aaa-b011-336c2231cf3e
msgctxt "h0d4e8513g3259g4911gaa38gf2ea8fe86f74"
msgid "I know about the grove. That's not why I'm here."
msgstr "숲이라면 나도 알아. 그것 때문에 온 게 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 512bee80-3cef-eeeb-9790-a66f999edb92
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_TorturedAdventurer_WasMean(1) = False
#.      - GOB_Torturers_Assisted(1) = False
#.      - GOB_Torturers_AssistedForFun(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:512bee80-3cef-eeeb-9790-a66f999edb92
msgctxt "h7d855761gacc2g4effga412g3201655c9a10"
msgid "Are you hurt?"
msgstr "다친 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 5143e9f3-0f85-3ced-1718-151c416fd499
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_TorturedAdventurer_HasMet(1) = True
#.      - GOB_TorturedAdventurer_PromisedToFree(1) = False
#.   Global:
#.      - GOB_Torturers_State_PrisonerFreed = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:5143e9f3-0f85-3ced-1718-151c416fd499
msgctxt "hc7f7fe2fg9a89g4f3fg8609gdb5bfcd7c7f1"
msgid "P-please... please l-let me out! Th-there's no reason for this!"
msgstr "제-제발... 제발, 저-절 풀어주세요! 이-이럴 이유가 없잖아요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 5538b576-ef9c-5b08-b51d-bae0fe2dcffa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:5538b576-ef9c-5b08-b51d-bae0fe2dcffa
msgctxt "he72d170dg9cd6g47c3ga15bg20234bc4fa8b"
msgid "I... I don't think I can move my arm."
msgstr "저... 팔을 움직일 수 없을 것 같아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 554ec726-a42f-0789-0714-700d237c02a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:554ec726-a42f-0789-0714-700d237c02a7
msgctxt "h0dffe414g3dfcg4472g9765ga312ca840149"
msgid "Please - hurry!"
msgstr "제발 - 서두르세요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 56b67447-49b3-4c60-67ba-96ff9e4266c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:56b67447-49b3-4c60-67ba-96ff9e4266c0
msgctxt "h4f2c3a5bg5496g46bcgbcfega11a26a359de"
msgid "<i>Snap his thumb.</i>"
msgstr "<i>그의 엄지손가락을 부러뜨린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 59c4fb8f-ade2-ae28-cc3f-739eb914e04c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - DEN_Conflict_SUB_AoD.GotGroveLocation(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:59c4fb8f-ade2-ae28-cc3f-739eb914e04c
msgctxt "hb961e8f3g2c35g4684g9d49gcd4dc35a8548"
msgid ""
"T-to the east. P-past the ruins and the bridge. The gate's covered with ivy."
msgstr "도-동쪽에. 폐-폐허랑 다리를 지나서. 덩굴로 뒤덮인 관문이 있어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 602ed7db-3149-c713-c4b8-1093fd293f51
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:602ed7db-3149-c713-c4b8-1093fd293f51
msgctxt "h5ecadbedg6233g4cbdg9b83gc8efd166b6b5"
msgid "<i>Snap his thumb.</i>"
msgstr "<i>그의 엄지손가락을 부러뜨린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 607df5af-bdda-ab71-5236-ed51ac28f955
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:607df5af-bdda-ab71-5236-ed51ac28f955
msgctxt "heaea9365g330dg4e70g8f13g4dc14f418a43"
msgid "The place was supposed to be abandoned, b-but when we arrived..."
msgstr "이 장소가 버려진 곳인 줄 알았죠. 하-하지만 저희가 도착했을 떈..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 6136f5cb-061e-8b32-e5fa-7c928c2ac24c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_AdventurersQuest_Knows_AboutSH = True
#.      - GOB_TorturedAdventurer_Knows_WasLookingForSH = False
#. SetFlags:
#.   Global:
#.     - GOB_TorturedAdventurer_Knows_WasLookingForSH = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:6136f5cb-061e-8b32-e5fa-7c928c2ac24c
msgctxt "hf640b0c6gff87g4c61ga470ga23d4be64b97"
msgid "I came for the Nightsong. Where is it?"
msgstr "나는 밤의 노래를 찾으러 왔어. 어디 있지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 6164c253-cd35-7fa5-6e06-f0b110fd0141
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#. TagRule: BERSERKER
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:6164c253-cd35-7fa5-6e06-f0b110fd0141
msgctxt "ha2b026b5g90c1g4d32gbd04g9ae3cdf0ce37"
msgid "I STILL MIGHT. <b>QUIET</b>."
msgstr "<b>아직 그럴지도 몰라. 조용히 해</b>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 6164c253-cd35-7fa5-6e06-f0b110fd0141
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:6164c253-cd35-7fa5-6e06-f0b110fd0141
msgctxt "hb59102cage1deg4d97gb658g3c2486531b46"
msgid "I may yet, unless you <b>quieten down.</b>"
msgstr "<b>아직 그럴지도 몰라, 당신이 조용히 하지 않는다면 말이야.</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 61b3557e-0580-d6fd-4382-847ac0d2931e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:61b3557e-0580-d6fd-4382-847ac0d2931e
msgctxt "h9a1fe48ag6780g46beg8ba5g1b491af178b9"
msgid "Th-they didn't hide it. I don't think they even kn-know it exists."
msgstr "그-그들이 숨긴 게 아니에요. 애초에 그게 조-존재하는지 알지도 못하는 것 같아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 61ba58c2-4a5c-76f3-c928-5a746634ba31
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:61ba58c2-4a5c-76f3-c928-5a746634ba31
msgctxt "h74fe337egcbdeg4be7gba82g1ee135d6b3f2"
msgid "That's my concern now. How did you end up here?"
msgstr "그건 이제 내가 걱정할 문제야. 여긴 어떻게 하다 오게 된 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 61fc6457-88d0-9125-5a74-2b66f882478d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:61fc6457-88d0-9125-5a74-2b66f882478d
msgctxt "h8879616bgd43fg405bga32dgd048ed75e3b4"
msgid "I'm sorry - but it was the only way to help you."
msgstr "미안해, 하지만 이 방법밖에는 없었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 62af404b-759c-38d9-42c8-525a12a81118
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_TorturedAdventurer_AskedForHalsin(1) = False
#.   Global:
#.      - GLO_Halsin_Knows_IsFound = False
#.      - GLO_Halsin_Knows_IsMissing = True
#. SetFlags:
#.   Dialog:
#.     - GOB_TorturedAdventurer_AskedForHalsin(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:62af404b-759c-38d9-42c8-525a12a81118
msgctxt "h6fb125cfg2a4eg414dg8911g729115aab233"
msgid "One more question: what happened to the druid?"
msgstr "질문 하나 더 하지: 그 드루이드는 어떻게 됐지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 674387c9-a2cc-f234-ffe8-576934689a00
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_TorturedAdventurer_Knows_ShadowheartChainPersuadeSuccess(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:674387c9-a2cc-f234-ffe8-576934689a00
msgctxt "hb8c6f07cgcd39g413dg8a62g56f7c3cd06ab"
msgid "I'm in pain a-anyway. Do whatever you have to. Please."
msgstr "전 이-이미 고통받고 있어요. 해야 하는 일이라면 뭐든지 하세요. 제발요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 68bc781d-9bfb-d258-ecaa-2ec3e52c2732
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:68bc781d-9bfb-d258-ecaa-2ec3e52c2732
msgctxt "h8b9b02bfg173dg4ad0g8d59g92e58536444b"
msgid "<i>Seize one of his hands and break his thumb.</i>"
msgstr "<i>그의 손 하나를 붙잡고 엄지손가락을 부러뜨린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 6aafe349-1f54-12d1-a8a3-0d1b0e701f70
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_TorturedAdventurer_AskedForHalsin(1) = False
#.   Global:
#.      - GLO_Halsin_Knows_IsFound = False
#.      - GLO_Halsin_Knows_IsMissing = True
#. SetFlags:
#.   Dialog:
#.     - GOB_TorturedAdventurer_AskedForHalsin(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:6aafe349-1f54-12d1-a8a3-0d1b0e701f70
msgctxt "h2f3814bfg314dg417fgbf22g393adc485b29"
msgid "The druid Halsin was with you. Where is he now?"
msgstr "당신은 드루이드 할신과 같이 있었던 걸로 아는데. 그는 어디 있나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 6bfac8a5-3833-6a0e-e743-510f6eb9e464
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:6bfac8a5-3833-6a0e-e743-510f6eb9e464
msgctxt "hc9f59e65g405cg402dg824eg234284c2efaf"
msgid "I'm not sure - all I know is there's a p-passageway to the Nightsong."
msgstr "잘 모르겠어요. 전 밤의 노래를 찾을 토-통로가 있다는 것만 알아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 6c819f34-ef8b-5e7a-a4cc-00b5aa8efaf1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_TorturedAdventurer_AskedForHalsin(1) = False
#.   Global:
#.      - GLO_Halsin_Knows_IsFound = False
#.      - GLO_Halsin_Knows_IsMissing = True
#. SetFlags:
#.   Dialog:
#.     - GOB_TorturedAdventurer_AskedForHalsin(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:6c819f34-ef8b-5e7a-a4cc-00b5aa8efaf1
msgctxt "h95470d57g43cfg402egb7b8gb44f6ee00a4d"
msgid "Tell me: have you seen a druid called Halsin?"
msgstr "말해 줘, 할신이라는 드루이드를 본 적이 있나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 6d3e53b9-bfd7-aa1b-18f5-0aa0cf033bf7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Torturers_State_TorturedEnough = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:6d3e53b9-bfd7-aa1b-18f5-0aa0cf033bf7
msgctxt "h64225a6eg74b6g41bbga54cg6bd6d823e5e6"
msgid "And now they know about the grove. Gods. I - I need to warn them!"
msgstr "이제 놈들이 숲에 대해서 알아냈어요. 신이시여. 제 - 제가 그들에게 경고해 줘야 해요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 6da2cfc5-6136-fd4e-d035-b8885260ad76
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - GLO_Tadpole_SUB_Druid.LearnedBear(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:6da2cfc5-6136-fd4e-d035-b8885260ad76
msgctxt "h9b1709dcg9507g4ca1g8c2cgf555e4379ca8"
msgid ""
"Halsin? I... I don't know. He changed into a bear, but... I lost sight of "
"him. I don't know if he's s-still alive."
msgstr ""
"할신? 저... 저도 몰라요. 곰으로 변신하는 건 봤는데... 그 이후는 본 적이 없어요. 그가 지-지금 살아있는지도 모른다고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Narrator
#. NodeID = 6e07b76b-93c3-43db-8b0d-bb304c0a4c6b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:6e07b76b-93c3-43db-8b0d-bb304c0a4c6b
msgctxt "h100998f7gda3eg49c6g9807gde957a5d9a58"
msgid "*She offers you nothing.*"
msgstr "*여신은 아무 것도 내려 주지 않습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Narrator
#. NodeID = 6ec61725-fb51-8a75-3855-d0a08221464e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_TorturedAdventurer_Event_RemoveLockpick = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:6ec61725-fb51-8a75-3855-d0a08221464e
msgctxt "h55b38eb3gd0f9g444fgbdb8g3684b72df161"
msgid ""
"*You struggle with the set of lockpicks until they are bent entirely out of "
"shape, but the lock won't budge.*"
msgstr "*자물쇠가 완전히 구부러질 때까지 락픽을 가지고 애를 써봐도 자물쇠는 움직이지 않습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 6f23c0ee-e008-69cb-dbc5-1edc2c1b50e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:6f23c0ee-e008-69cb-dbc5-1edc2c1b50e7
msgctxt "h297266ffgcffeg46f6gb24egef4d394fe7c2"
msgid "Y-you're... you're right! But now you've to do the other hand..."
msgstr "다-당신이... 당신이 맞았어요! 하지만 이제 다른 손도 해야겠군요..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 70f142cc-54eb-031b-a90a-3de6b2179062
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:70f142cc-54eb-031b-a90a-3de6b2179062
msgctxt "h5dfd09d6g6aafg4e9dg8da8g6d3cd3b9dfdc"
msgid "This wasn't supposed to happen. It should have been easy..."
msgstr "일이 이렇게 됐으면 안 됐어요. 쉬운 일이었어야 했는데..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 716260ab-0851-7a17-7185-69f980bd0da8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_TorturedAdventurer_ToldAboutMap(1) = True
#.   Global:
#.     - DEN_AdventurersQuest_Knows_LeaderMap = True
#.   Quest:
#.     - SHA_Nightsong.LearnedBryanMap(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:716260ab-0851-7a17-7185-69f980bd0da8
msgctxt "h0f59404ag2300g4b86g9a8agc00cc4c7fff6"
msgid ""
"B-Brian had instructions, but... the g-goblins got him. Th-they said they'd "
"e-eat him..."
msgstr "브-브라이언에게 지시사항이 있었는데... 고-고블린들에게 붙잡혀 버렸어요. 노-놈들이 브라이언을 자-잡아먹겠다고 했어요..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 7401579f-fdad-c382-224e-c063b4228bff
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:7401579f-fdad-c382-224e-c063b4228bff
msgctxt "h089b9c2cg62e3g48d3g83eag78df8379d530"
msgid "And yet you're still alive. Stop whining."
msgstr "하지만 아직 살아있잖아. 그만 징징대."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 75c3d8ce-45ea-c23c-a6d2-28cd9bb49723
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - GLO_Tadpole_SUB_Druid.LearnedBear(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:75c3d8ce-45ea-c23c-a6d2-28cd9bb49723
msgctxt "h6fea020dg0f3dg4388gb936gf46db18303ff"
msgid ""
"I... I don't know. He changed into a bear, but... I lost sight of him. I "
"don't know if he's s-still alive."
msgstr ""
"저... 저도 모르겠어요. 곰으로 변신하는 건 봤는데... 그 이후는 본 적이 없어요. 그가 지-지금 살아있는지조차도 모른다고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 760d9d80-4f85-6ad1-f740-c2d7bdf47247
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_TorturedAdventurer_WasMean(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:760d9d80-4f85-6ad1-f740-c2d7bdf47247
msgctxt "h4148e213g42eag4f75gb237ge29b36d978a6"
msgid "P-please, these shackles... I... I don't want to die!"
msgstr "제-제발요, 이 족쇄... 저... 전 죽고 싶지 않아요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 7749da43-1763-5a56-136b-8b358e29e678
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:7749da43-1763-5a56-136b-8b358e29e678
msgctxt "hcb1e23c2g1950g4f62g82f0g5da5fc593a0f"
msgid "It was the only way to get the goblins to leave."
msgstr "고블린들이 떠나게 하려면 이 방법밖엔 없었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 77b39ca3-a730-3e09-bde1-669f3019ce04
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:77b39ca3-a730-3e09-bde1-669f3019ce04
msgctxt "h01cc273ag63c9g4e27gbdefgd21353fad375"
msgid "<i>Wait.</i>"
msgstr "<i>기다린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 78bc7f6f-a889-d38a-5f3f-20ef086ce108
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_TorturedAdventurer_Knows_AskedWhatNightsongDoes(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:78bc7f6f-a889-d38a-5f3f-20ef086ce108
msgctxt "h3eb2e782gc807g4607g841cg8d6ffa1d7f7b"
msgid "An artefact? What does it do?"
msgstr "아티팩트라고? 뭐 하는 물건이지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 79ebe12d-9c8c-712b-d0cb-9298c2687071
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_TorturedAdventurer_HasMet(1) = True
#.      - GOB_TorturedAdventurer_LeftInChains(1) = True
#.      - GOB_Torturers_Assisted(1) = True
#.   Global:
#.      - GOB_Torturers_State_PrisonerFreed = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:79ebe12d-9c8c-712b-d0cb-9298c2687071
msgctxt "h9529196bg6526g48dcg9514gc445b5d318a5"
msgid "Th-thanks, I guess."
msgstr "고-고마워요, 아마도."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 7a1df6ed-7086-6e61-af24-2b537ec64256
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_TorturedAdventurer_AskedForHalsin(1) = False
#.   Global:
#.      - GLO_Halsin_Knows_IsFound = False
#.      - GLO_Halsin_Knows_IsMissing = True
#. SetFlags:
#.   Dialog:
#.     - GOB_TorturedAdventurer_AskedForHalsin(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:7a1df6ed-7086-6e61-af24-2b537ec64256
msgctxt "he83d3c0dg87a8g4645ga386gdeae9ee429ec"
msgid "The druid Halsin was with you. Where is he now?"
msgstr "당신은 드루이드 할신과 같이 있었던 걸로 아는데. 그는 어디 있나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 7dcdca45-d349-de5e-35ab-31dcfc5e7168
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:7dcdca45-d349-de5e-35ab-31dcfc5e7168
msgctxt "hd1e239f1g89cbg4f41ga345g76606876c81e"
msgid ""
"It should be here somewhere. He said there was a hidden passage underneath "
"the temple."
msgstr "분명 이곳 어딘가에 있을 거예요. 신전 지하에 숨겨진 통로가 있다고 들었거든요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 7ea47b51-1683-2d51-7f88-9b6a7e7dc769
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_AdventurersQuest_Knows_AboutSH = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:7ea47b51-1683-2d51-7f88-9b6a7e7dc769
msgctxt "h372eef0dge5ebg4104g8c05g0fe03569c235"
msgid "How did you end up here?"
msgstr "어쩌다 여기까지 오게 된 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 7f1b5035-fc7d-24b0-618d-6a5329e41902
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_TorturedAdventurer_Knows_AskedWhatNightsongDoes(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:7f1b5035-fc7d-24b0-618d-6a5329e41902
msgctxt "h91f72dcdg96a6g469agbb60gbfbef6d58c16"
msgid "An artefact? What does it do?"
msgstr "아티팩트라고? 뭐 하는 물건이지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 80406eae-731c-494d-f41e-3fc56e8fc4a9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:80406eae-731c-494d-f41e-3fc56e8fc4a9
msgctxt "h8c6cdaa2g95fdg4a8bg9efdg8ddd9c0ae9cc"
msgid "Just... get these shackles off."
msgstr "그냥... 이 족쇄를 풀어주세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 8136a84a-22c9-15c9-16f0-b89a42a0c899
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:8136a84a-22c9-15c9-16f0-b89a42a0c899
msgctxt "h319878c2gde1bg418ag9bf7gd0731b2f943c"
msgid "I... I don't think I can move my arm."
msgstr "저... 팔을 움직일 수 없을 것 같아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 84dff3e2-a2a2-c5bf-5c8a-2e1a0575a9fc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - DEN_Conflict.HeardAboutAoD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:84dff3e2-a2a2-c5bf-5c8a-2e1a0575a9fc
msgctxt "ha2f7b70cgc92ag407cgad25gb6d752976f2b"
msgid ""
"No! P-please! If... if the g-goblins find out, they'll... they'll kill "
"everyone!"
msgstr "안 돼! 제-제발! 만... 만약 고-고블린들이 알아내면, 그들이... 그들이 모두를 죽일 거라고요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 8754b67e-dfc8-8656-b5c1-1d993160a1be
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_AdventurersQuest_Knows_AboutSH = True
#.      - GOB_TorturedAdventurer_Knows_WasLookingForSH = False
#. SetFlags:
#.   Global:
#.     - GOB_TorturedAdventurer_Knows_WasLookingForSH = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:8754b67e-dfc8-8656-b5c1-1d993160a1be
msgctxt "h9db27cb7g586cg471bg9aefge0b093dd4ed7"
msgid "I came for the Nightsong. Where is it?"
msgstr "나는 밤의 노래를 찾으러 왔어. 어디 있지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 87f4d12a-5df0-5332-520f-70a2b97f2f12
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_AdventurersQuest_Knows_AboutBounty = True
#.   Quest:
#.     - SHA_Nightsong.HeardOf(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:87f4d12a-5df0-5332-520f-70a2b97f2f12
msgctxt "h86967d67geb36g49c0gb65fg4c2a13a53c2f"
msgid ""
"He j-just said some wizard called Lorroakan would reward us if we found it."
msgstr "그가 말, 말하길 로로아칸이라는 위저드가 그걸 찾으면 우리에게 보상을 줄 거라고 했다고 하더군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 8b28dd29-d9ca-8109-ffe9-ee92552a0cae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:8b28dd29-d9ca-8109-ffe9-ee92552a0cae
msgctxt "h0b7980e8g9083g4cb6gbcdbg3978975d054d"
msgid "... what're you playing at? You said on thre-<i>eearrgh!</i>"
msgstr "... 뭐하시는 거예요? 셋을 세고 한-<i>끄아아악!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 8b4192a7-ed80-d603-9f10-4145e22574d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:8b4192a7-ed80-d603-9f10-4145e22574d4
msgctxt "h7c08864ag2a3fg48fcga7degae1fe11147d0"
msgid "<i>Break his other thumb.</i>"
msgstr "<i>반대쪽 엄지를 부러뜨린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 8c51b3ad-bc62-781f-dab5-23d8552acbeb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_PartyProgress_EnteredGrove = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:8c51b3ad-bc62-781f-dab5-23d8552acbeb
msgctxt "h20afbb0bg9b9bg4632g8b5cg9d884e47513c"
msgid "It's your own life you should be worrying about. Now <i>talk.</i>"
msgstr "지금 걱정해야 할 건 당신 스스로의 목숨이야. 이제 <i>말해.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Narrator
#. NodeID = 8da375f7-7759-41a3-b73c-093f7df8fb66
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:8da375f7-7759-41a3-b73c-093f7df8fb66
msgctxt "h99abb724g95aag4881gaa44g429bfcd1efdc"
msgid ""
"*Is Lady Shar punishing you? Or perhaps testing you? Is it the tadpole, or a "
"curse? You cannot say.*"
msgstr ""
"*샤 여신님이 당신을 벌하고 있는 걸까요? 아니면 시험하고 있는 걸까요? 올챙이 때문일까요, 아니면 저주 때문일까요? 당신은 대답하지 "
"못합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 8de2e3ce-c2a6-5e34-5a26-8e88b49dc096
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:8de2e3ce-c2a6-5e34-5a26-8e88b49dc096
msgctxt "ha60cb417g602ag4a56g99c9g6973b86601be"
msgid "You are? I - I need to get out of here."
msgstr "진짜요? 저 - 전 여기서 빠져나가야 해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 9048c148-202f-33b4-c7df-f3597f800728
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_TorturedAdventurer_Knows_FailedPersuade(1) = True
#.   Global:
#.      - GOB_Torturers_State_PrisonerFreed = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:9048c148-202f-33b4-c7df-f3597f800728
msgctxt "h293249c9g8853g4a93gbda9gaa90c93eb1a4"
msgid "Please, just l-leave me alone."
msgstr "제발, 그냥 저-절 내버려 두세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 90cf4361-3812-119e-d8fc-5a87a83dea31
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Dexterity
#. DifficultyClass: 12
#. CheckFlags:
#.   Dialog:
#.      - GOB_TorturedAdventurer_knows_triedToPickLock(1) = False
#.   Global:
#.      - GOB_TorturedAdventurer_State_Unlocked = False
#.      - GOB_Torturers_State_PrisonerFreed = False
#.   Tag:
#.      - ROGUE(1) = False
#.   User:
#.      - GOB_TorturedAdventurer_HasLockpick(1) = True
#. SetFlags:
#.   Dialog:
#.     - GOB_TorturedAdventurer_knows_triedToPickLock(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:90cf4361-3812-119e-d8fc-5a87a83dea31
msgctxt "hded94908g1c9dg420cg8e6fg24eb0e4418bd"
msgid "<i>Pick the lock.</i>"
msgstr "<i>자물쇠를 해제한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 9261141e-0aa0-efc7-5b1f-fcfdbf06adf4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_HappyTorturers_Knows_PlayersKnowDenLocation = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:9261141e-0aa0-efc7-5b1f-fcfdbf06adf4
msgctxt "hd5def16ag2860g46f9gbff1gfe2e9c640057"
msgid "But please... please don't tell the goblins!"
msgstr "하지만 제발.... 제발 고블린에게는 말하지 마세요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 935ba425-221f-4a87-0def-7422e1899078
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_TorturedAdventurer_Knows_AskedWhatNightsongDoes(1) = False
#.   Global:
#.      - GLO_AdventurersQuest_Knows_AboutSH = True
#.      - GOB_TorturedAdventurer_Knows_WasLookingForSH = True
#. SetFlags:
#.   Dialog:
#.     - GOB_TorturedAdventurer_Knows_AskedWhatNightsongDoes(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:935ba425-221f-4a87-0def-7422e1899078
msgctxt "h7fad3b1egf1bdg46fbg8db1gc95992ab3d7d"
msgid "The Nightsong. What does it do, exactly?"
msgstr "밤의 노래. 그건 정확히 뭐 하는 물건이지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 9561b6b8-84ba-a9e6-6a18-3ce9df16174b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_TorturedAdventurer_AskedForHalsin(1) = False
#.   Global:
#.      - GLO_Halsin_Knows_IsFound = False
#.      - GLO_Halsin_Knows_IsMissing = True
#. SetFlags:
#.   Dialog:
#.     - GOB_TorturedAdventurer_AskedForHalsin(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:9561b6b8-84ba-a9e6-6a18-3ce9df16174b
msgctxt "h6162a2a1ga07ag43b9gafd5g9a5cf8093e3b"
msgid "Tell me: have you seen a druid called Halsin?"
msgstr "말해 줘, 할신이라는 드루이드를 본 적이 있나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 9671aed2-3d3d-07fb-f06a-eb0f7aa444d3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:9671aed2-3d3d-07fb-f06a-eb0f7aa444d3
msgctxt "h2e1dc76bg2a84g4f8fga639gf7baf388d14a"
msgid "I-it was locked away years ago, somewhere underneath the temple."
msgstr "그-그건 수년 전에 이 신전 아래 어딘가에 봉인되었어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = 985e8e6f-a3c9-1bda-4385-d4b4874c0000
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:985e8e6f-a3c9-1bda-4385-d4b4874c0000
msgctxt "h9c27f946g86d7g4f8cg9740g322546140a1c"
msgid "Just breathe, and count to three."
msgstr "그냥 깊게 숨을 들이쉬고, 셋을 세."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 9997e54a-f89b-fe0a-ff4e-3dfe64298b4e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_TorturedAdventurer_Knows_FailedMindRead(1) = True
#.   Global:
#.      - GOB_Torturers_State_PrisonerFreed = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:9997e54a-f89b-fe0a-ff4e-3dfe64298b4e
msgctxt "hbeea1ebfg1508g44dcga208gca203a54fa89"
msgid "No! G-get away from me!"
msgstr "안 돼! 저한테서 떠-떨어져요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 9a740f7c-650b-56f2-deab-cca78c7477d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:9a740f7c-650b-56f2-deab-cca78c7477d0
msgctxt "hb26ccbe5gd6cbg40e7gb2fagd6b3feefeed4"
msgid "<i>Ahh</i>... dirty bloody trick..."
msgstr "<i>아아</i>... 더러운 망할 속임수 같으니..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 9dce5c48-93b0-039d-2662-7afa0ebe00df
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:9dce5c48-93b0-039d-2662-7afa0ebe00df
msgctxt "h8a9f60f9gd9a3g436aga8ebg85634a94c092"
msgid ""
"We... I was w-with a group of adventurers. We came here for an artefact."
msgstr "우리... 전 모험가 무리와 하-함께였어요. 이곳에 아티팩트를 찾으러 왔죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 9fa558ba-f321-0039-bb58-a3a607f57ea8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:9fa558ba-f321-0039-bb58-a3a607f57ea8
msgctxt "h426b4147g0f27g4bddgb875g631c345de5c3"
msgid "Th-thank you!"
msgstr "고-고마워요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = 9fdadd43-dcfe-dbd0-6007-5503ffac0fb3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_Torturers_State_PrisonerFreed = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:9fdadd43-dcfe-dbd0-6007-5503ffac0fb3
msgctxt "h0b88b79dgf85eg4d4bgb4b0gf5595a7cc073"
msgid "... b-but it worked, I suppose. I'm free."
msgstr "... 하-하지만 통한 것 같군요. 풀려났어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = a00e38b2-9700-8c12-682c-3d43b970140e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:a00e38b2-9700-8c12-682c-3d43b970140e
msgctxt "h62c8bfafg5b7cg4debga87egd32217417954"
msgid "<i>Nnnearrgh! </i>You could've warned me!"
msgstr "<i>끄아아아악! </i>미리 경고해 줄 수도 있었잖아요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Narrator
#. NodeID = a152ecf4-49c8-efaa-359f-6fa0aef9ae79
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_TorturedAdventurer_State_Unlocked = False
#.   Object:
#.      - GOB_TorturedAdventurer_State_Faint(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:a152ecf4-49c8-efaa-359f-6fa0aef9ae79
msgctxt "hbf4142e9gabf2g4320gb5e2gc608d2bcf7b8"
msgid "*The battered man hangs slack from his chains, barely breathing.*"
msgstr "*구타당한 남자는 사슬에 매달린 채 간신히 숨을 쉬고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = a37856b9-03c2-30a2-762d-65edd67e201a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:a37856b9-03c2-30a2-762d-65edd67e201a
msgctxt "ha7414bc9g3d33g43b1g8babgda53d6cd51df"
msgid ""
"P-please! You kn-know where the grove is! Th-there's nothing I can tell "
"you... please, let me go!"
msgstr "제-제발요! 숲이 어-어디에 있는지 아시잖아요! 더-더 이상 알려드릴 수 있는 건 없어요... 제발, 절 보내주세요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = a666033e-df88-0222-c0de-70a070c1d447
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:a666033e-df88-0222-c0de-70a070c1d447
msgctxt "hf675d81cgd9b3g43f7gb45egd77c263bf52d"
msgid "I-it was locked away years ago, somewhere underneath the temple."
msgstr "그-그건 수년 전에 이 신전 아래 어딘가에 봉인되었어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = a768f0d4-56c5-d651-5bfc-870867c93844
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_TorturedAdventurer_Knows_WasLookingForSH = True
#.   Quest:
#.     - SHA_Nightsong.LearnedLocation(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:a768f0d4-56c5-d651-5bfc-870867c93844
msgctxt "hcd023034g6217g4f91ga32fg3107822feded"
msgid ""
"Y-yes, it should be here somewhere. They said there was a hidden passage "
"underneath this temple."
msgstr "그-그래요, 여기 어딘가에 있을 거예요. 이 신전 아래에 숨겨진 통로가 있다고 들었어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = a8799f9f-d63d-bca4-fffe-092183ac3f4f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_TorturedAdventurer_AskedForHalsin(1) = False
#.   Global:
#.      - GLO_Halsin_Knows_IsFound = False
#.      - GLO_Halsin_Knows_IsMissing = True
#. SetFlags:
#.   Dialog:
#.     - GOB_TorturedAdventurer_AskedForHalsin(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:a8799f9f-d63d-bca4-fffe-092183ac3f4f
msgctxt "h0b4b885fg337cg4859ga5dbg3699a9d36680"
msgid "I'm looking for a druid, name of Halsin."
msgstr "어떤 드루이드를 찾고 있어, 이름은 할신이고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = a9862b35-eea6-9e92-a9d1-b53de42cec5a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:a9862b35-eea6-9e92-a9d1-b53de42cec5a
msgctxt "h5ba52505gac15g4931g80ecg6ed29a4bbec2"
msgid "A-all right. One..."
msgstr "아-알겠어요. 하나..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = a995466d-2355-e8bb-fbb3-c9e04e3c240f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:a995466d-2355-e8bb-fbb3-c9e04e3c240f
msgctxt "h6d434b4aga8e5g43c0g8203g53103e831b3e"
msgid "I... I have to go. I have to get out of here."
msgstr "나... 나는 가야 해요. 여기서 나가야 한다고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = a9da07b3-ad32-a94f-e6c3-a90ff3bec45f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 6621e6ea-f89e-a19d-e8dc-6e6bc0779404_MindHasBeenRead = True
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:a9da07b3-ad32-a94f-e6c3-a90ff3bec45f
msgctxt "hc84aa86eg08dag487eg8a4bgc1d2fedcd0c1"
msgid ""
"<i>Why won't she leave? I need to warn the others... and find Remira, if "
"she's still alive.</i>"
msgstr "<i>왜 떠나질 않는 거야? 다른 이들에게 경고해 줘야 해... 그녀가 살아있다면, 레미라도 찾고.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = a9da07b3-ad32-a94f-e6c3-a90ff3bec45f
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Local:
