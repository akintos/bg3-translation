msgctxt "h246e5271gd5d2g43fdgb5cdg6beb638331ca"
msgid "Don't like it here. Grey ones hurt hide!"
msgstr "여기 싫어. 회색 놈들이 아프게 해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_002
#. Speaker = Deep Rothé
#. NodeID = cb2ee75e-541c-4d06-82dc-568ac0bd9990
