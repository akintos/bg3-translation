msgctxt "h547cda87g37ddg4a6dg9eb4gd4260aa157bb"
msgid "Why did the dragon-riders attack the ship?"
msgstr "왜 드래곤 라이더들이 함선을 공격했지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Mindflayer_Dead
#. Speaker = Narrator
#. NodeID = e77b17b3-2353-6ef8-ccb7-5b191a8887bb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Mindflayer_Dead:e77b17b3-2353-6ef8-ccb7-5b191a8887bb
msgctxt "h07c9bcafg45d9g4ac9ga1d5gd6fcc39f3229"
msgid "*Dark, empty pods flicker across your vision. They demand new flesh.*"
msgstr "*어둡고, 빈 포드가 눈앞에 깜빡거립니다. 새 희생양을 원하고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Mindflayer_Dead
#. Speaker = Karlach
#. NodeID = ed55fa13-c1ff-a021-e4ef-f61c7c25203b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_KARLACH(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Mindflayer_Dead:ed55fa13-c1ff-a021-e4ef-f61c7c25203b
msgctxt "h8dae21e3ga58dg48e9gaf6dgb3a403ff9931"
msgid "Ugh... that <i>thing</i> is burrowing through my brain."
msgstr "으윽... 그 <i>괴물</i>이 내 뇌 속을 파고 들어가고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Mindflayer_Dead
#. Speaker = Player
#. NodeID = f95c4870-ad55-ac8d-d0e0-f3e49ffb6f38
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_DeadFlayer_AskedAboutAbsolute = True
