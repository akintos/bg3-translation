msgctxt "h59eb0185g3f76g4890ga909gecd19bfe3b40"
msgid "Damnable things. One spell, and there's no telling how they'll react."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Library_PAD_GremishkaAllergyComment
#. Speaker = Player
#. NodeID = 4cbbfb54-b4aa-444d-a258-9ac0b14ecce9
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Library_PAD_GremishkaAllergyComment:4cbbfb54-b4aa-444d-a258-9ac0b14ecce9
msgctxt "h74a7c697g4fd9g46fbgb05fgab43bd1fc21c"
msgid "Better eschew magic with these creatures."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Library_PAD_GremishkaAllergyComment
#. Speaker = Player
#. NodeID = 4cbbfb54-b4aa-444d-a258-9ac0b14ecce9
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
