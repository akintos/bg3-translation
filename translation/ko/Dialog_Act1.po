msgctxt "hd0210faeg1ed9g4bbcg971eg1bfa0c194247"
msgid "How did you die?"
msgstr "어떻게 죽었지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_DeadPrisoner_Dead
#. Speaker = Narrator
#. NodeID = c9fd7385-b26f-3caa-d9f8-3427ce5c67ed
