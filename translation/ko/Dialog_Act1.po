msgctxt "h06189833gcb69g4fcega7cbg7534e9fe0341"
msgid "<i>Tsk'va!</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_PlayerSurprisedAtGremishka
#. Speaker = Player
#. NodeID = a732760c-1bbd-43b7-b65f-c4131b866639
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_PlayerSurprisedAtGremishka:a732760c-1bbd-43b7-b65f-c4131b866639
msgctxt "h25446d85g770fg4361g8d89gd14d9f4b24ad"
msgid "Hells below, what's that?!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_PlayerSurprisedAtGremishka
#. Speaker = Player
#. NodeID = a732760c-1bbd-43b7-b65f-c4131b866639
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_PlayerSurprisedAtGremishka:a732760c-1bbd-43b7-b65f-c4131b866639
msgctxt "h0cc52689g2d8fg4e8cg9accg8d39dbb4a055"
msgid "What in the Nine Hells..."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_PlayerSurprisedAtGremishka
#. Speaker = Player
#. NodeID = a732760c-1bbd-43b7-b65f-c4131b866639
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_PlayerSurprisedAtGremishka:a732760c-1bbd-43b7-b65f-c4131b866639
msgctxt "h9f0c07ddgeea9g4dc7g8687g26396cbb12b9"
msgid "Nine Hells!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_PlayerSurprisedAtGremishka
#. Speaker = Player
#. NodeID = e91184c5-4a84-453e-b747-1c418675b246
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_PlayerSurprisedAtGremishka:e91184c5-4a84-453e-b747-1c418675b246
msgctxt "h7c4af962g2ca1g4236ga896g2a4a7b0f8008"
msgid "<i>That's</i> what those little brats were tormenting?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_PlayerSurprisedAtGremishka
#. Speaker = Player
#. NodeID = e91184c5-4a84-453e-b747-1c418675b246
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_PlayerSurprisedAtGremishka:e91184c5-4a84-453e-b747-1c418675b246
msgctxt "hadfda673g0051g40c0g932bgd9920ceb484c"
msgid "That's what was in there? Those little privy rags were tormenting it."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_PlayerSurprisedAtGremishka
#. Speaker = Player
#. NodeID = e91184c5-4a84-453e-b747-1c418675b246
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_PlayerSurprisedAtGremishka:e91184c5-4a84-453e-b747-1c418675b246
msgctxt "hbb6fff66gd3c6g40cfg9716gc205495e83d8"
msgid "Fuck those kids, poor thing."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_PlayerSurprisedAtGremishka
#. Speaker = Player
#. NodeID = e91184c5-4a84-453e-b747-1c418675b246
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_PlayerSurprisedAtGremishka:e91184c5-4a84-453e-b747-1c418675b246
msgctxt "he7196061gc4a8g4da8g8dafgae4537547cb4"
msgid ""
"So this was their victim? <i>Chk. </i>I'd sooner the <i>yanki</i> release "
"their aggressions on each other."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_PlayerSurprisedAtGremishka
#. Speaker = Player
#. NodeID = e91184c5-4a84-453e-b747-1c418675b246
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_PlayerSurprisedAtGremishka:e91184c5-4a84-453e-b747-1c418675b246
msgctxt "hccbf3b33g225bg48b7gb7e0g7a270b1482a5"
msgid ""
"<i>That's</i> what was in there? Those brats deserve a taste of their own "
"medicine."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_PlayerSurprisedAtGremishka
#. Speaker = Player
#. NodeID = e91184c5-4a84-453e-b747-1c418675b246
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_PlayerSurprisedAtGremishka:e91184c5-4a84-453e-b747-1c418675b246
msgctxt "he2e57373g63d7g45e2g812cg0ddda6be63e5"
msgid ""
"So that's what they were harassing. Cheeky little imps. The children, I mean."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_PlayerSurprisedAtGremishka
#. Speaker = Player
#. NodeID = e91184c5-4a84-453e-b747-1c418675b246
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_PlayerSurprisedAtGremishka:e91184c5-4a84-453e-b747-1c418675b246
msgctxt "h6e56c48eg2ec5g41adg9616g57b00787c90c"
msgid "<i>That's</i> what was in there? Those little shits. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_RulesPoster
#. Speaker = Player
#. NodeID = 0cd4934f-1f9a-40c8-b9ca-0e7705b3d4a5
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_RulesPoster:0cd4934f-1f9a-40c8-b9ca-0e7705b3d4a5
msgctxt "h827bf4bbg32b6g4c46ga5d9g3df32aba84eb"
msgid "Rules, rules, rules - life must be a real bore."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_RulesPoster
#. Speaker = Player
#. NodeID = 0cd4934f-1f9a-40c8-b9ca-0e7705b3d4a5
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_RulesPoster:0cd4934f-1f9a-40c8-b9ca-0e7705b3d4a5
msgctxt "h119f68f9gac82g41cfgbc41gf37b66923e4e"
msgid ""
"The first ten protocols. The young must abide them, or bear the <i>sa'varsh</"
"i>'s barbed whip."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_RulesPoster
#. Speaker = Player
#. NodeID = 0cd4934f-1f9a-40c8-b9ca-0e7705b3d4a5
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_RulesPoster:0cd4934f-1f9a-40c8-b9ca-0e7705b3d4a5
msgctxt "ha8f2dc17g0941g4b3bg9813gca6c21bea5fd"
msgid "Less rules, more doctrine. Hard to disobey such a stern mandate."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_RulesPoster
#. Speaker = Player
#. NodeID = 0cd4934f-1f9a-40c8-b9ca-0e7705b3d4a5
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_RulesPoster:0cd4934f-1f9a-40c8-b9ca-0e7705b3d4a5
msgctxt "hbdcf1653gb09dg46abga585g71be5bd7e6da"
msgid "All these rules. Reminds me of home."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_RulesPoster
#. Speaker = Player
#. NodeID = 0cd4934f-1f9a-40c8-b9ca-0e7705b3d4a5
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_RulesPoster:0cd4934f-1f9a-40c8-b9ca-0e7705b3d4a5
msgctxt "ha15482beg9e49g438bg8e67gda55fbb5118c"
msgid "Even more rules than a Flaming Fist outpost. Who could keep track?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_RulesPoster
#. Speaker = Player
#. NodeID = 0cd4934f-1f9a-40c8-b9ca-0e7705b3d4a5
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_RulesPoster:0cd4934f-1f9a-40c8-b9ca-0e7705b3d4a5
msgctxt "h38e9be33g44ebg48cbgb744g61ba1e9a36fd"
msgid "I wouldn't last a tenday in a place with this many rules."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_RulesPoster
#. Speaker = Player
#. NodeID = 0cd4934f-1f9a-40c8-b9ca-0e7705b3d4a5
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_HALSIN
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_RulesPoster:0cd4934f-1f9a-40c8-b9ca-0e7705b3d4a5
msgctxt "h52f45e6eg9211g4b5fgb463g6f5915659bec"
msgid "Such a rigid code. This must not be an easy place to come of age."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_RulesPoster
#. Speaker = Player
#. NodeID = 0cd4934f-1f9a-40c8-b9ca-0e7705b3d4a5
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: REALLY_GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_RulesPoster:0cd4934f-1f9a-40c8-b9ca-0e7705b3d4a5
msgctxt "hf9104937g0572g4f88gbe71g8dd7dd482f20"
msgid ""
"My crèche had one of these too. The stricter the discipline, the stronger "
"the soldiers."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_RulesPoster
#. Speaker = Player
#. NodeID = 0cd4934f-1f9a-40c8-b9ca-0e7705b3d4a5
#. HandlePath = TaggedText[8].TagText[0]
#. TagRule: !REALLY_JAHEIRA
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_PAD_RulesPoster:0cd4934f-1f9a-40c8-b9ca-0e7705b3d4a5
msgctxt "h55fd571fgc2c0g417eg9746g181b4eda38fc"
msgid "They run a tight ship. Must be a horrible place to grow up."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait
#. Speaker = Player
#. NodeID = 06284413-6a25-65ee-d113-2eb31d9c82ec
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Dexterity
#. DifficultyClass: 16
#. CheckFlags:
#.   Local:
#.      - e146b889-323f-540c-30b9-756d4fd55813_AttemptedDrawing = False
#. SetFlags:
#.   Local:
#.     - e146b889-323f-540c-30b9-756d4fd55813_AttemptedDrawing = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait:06284413-6a25-65ee-d113-2eb31d9c82ec
msgctxt "hd350dc08g7043g46dbgae03gec9599984b89"
msgid "<i>Draw a new face onto the portrait.</i>"
msgstr "<i>초상화 위에 새 얼굴을 덧그린다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait
#. Speaker = Narrator
#. NodeID = 07dc078d-7193-7c18-b86b-321a25d90f68
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait:07dc078d-7193-7c18-b86b-321a25d90f68
msgctxt "h592345adgc179g4925g97dbg132723cd0060"
msgid "*That face, that expression, brimming with might and glory.*"
msgstr "*얼굴, 표정, 모두 권위와 영광이 넘쳐흐릅니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait
#. Speaker = Narrator
#. NodeID = 0aea1f4c-fcec-07b9-06d4-6f6e5d21dd10
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait:0aea1f4c-fcec-07b9-06d4-6f6e5d21dd10
msgctxt "h024ef706gf5e6g4315g909bg310b817f4091"
msgid "*You take a moment to fully appreciate your masterpiece.*"
msgstr "*당신은 잠시 자신의 걸작을 충분히 감상합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait
#. Speaker = Narrator
#. NodeID = 0c4897de-77b9-37b4-4d07-5c8250f84a14
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_General_State_SawOrpheusSymbolOnPortrait = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait:0c4897de-77b9-37b4-4d07-5c8250f84a14
msgctxt "h4353c921ged86g489fg8fb8g503e1c1ce50e"
msgid "*You recall stories of a prince riding a comet just like this one.*"
msgstr "*이 문양과 똑같이 생긴 혜성을 타고 다니는 왕자에 관한 이야기가 기억납니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait
#. Speaker = Narrator
#. NodeID = 112f9633-22f5-544c-e7af-c51e7650b127
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet_VlaakithPortrait(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait:112f9633-22f5-544c-e7af-c51e7650b127
msgctxt "h61e4eb9egec40g42e2g96e5g1ee0d8a87443"
msgid ""
"*The portrait looks down on you - as if you were little more than an insect.*"
msgstr "*초상화는 당신을 마치 벌레에 불과한 것처럼 내려다보고 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait
#. Speaker = Youth Vis'kiir
#. NodeID = 115219d6-88b7-0e8c-df42-8ac418df01b4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait:115219d6-88b7-0e8c-df42-8ac418df01b4
msgctxt "h7fa5312dg5e3dg4037ga89eg7a00e6e6cb71"
msgid "What did you do? The queen! Her face! <i>Vlaakith m' zath'ak!</i>"
msgstr "무슨 짓을 한 거야? 여왕님..! 얼굴이..! <i>블라키스 믐'자쓰'아크!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait
#. Speaker = Youth Vis'kiir
#. NodeID = 1395cd31-0e53-a3f4-3572-0a79b45c8d68
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_General_state_VlaakithPortrait_VandalismNoticed = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait:1395cd31-0e53-a3f4-3572-0a79b45c8d68
msgctxt "ha9f9a340gff88g4c46gbeb5g4b1b99c6f46a"
msgid ""
"Get out of here, <i>hshar'lak</i>! I need to clean this off before they see "
"or we're <i>all</i> going to suffer for it."
msgstr "여기서 나가라, <i>흐샬'락</i>! 그분들이 보기 전에 빨리 닦아내야 한다, 아니면 우리 <i>전부</i> 처벌 받을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait
#. Speaker = Narrator
#. NodeID = 1775e68a-604e-fc8a-f6cb-2ee55d0f37f0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet_VlaakithPortrait(1) = False
#.   Tag:
#.      - REALLY_GITHYANKI(1) = True
#. SetFlags:
#.   Dialog:
#.     - CRE_General_HasMet_VlaakithPortrait(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait:1775e68a-604e-fc8a-f6cb-2ee55d0f37f0
msgctxt "h65159976gbac7g43d6g8c89g7052e9c794be"
msgid ""
"*You stand before a truly resplendent portrait of Queen Vlaakith in all her "
"glory.*"
msgstr "*당신은 여왕 블라키스의 온갖 영광이 묻어나는 찬란한 초상화 앞에 서 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait
#. Speaker = Narrator
#. NodeID = 2dbebf71-40b0-d2aa-050c-4e55d0cb33ce
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRE_General_HasMet_VlaakithPortrait(1) = False
#.   Tag:
#.      - REALLY_GITHYANKI(1) = False
#. SetFlags:
#.   Dialog:
#.     - CRE_General_HasMet_VlaakithPortrait(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait:2dbebf71-40b0-d2aa-050c-4e55d0cb33ce
msgctxt "hd67fb91ag9f35g4214ga193ge6f8ef3920aa"
msgid ""
"*This imposing portrait depicts a powerful githyanki warrior, undeniably "
"regal in her mien.*"
msgstr "*이 인상적인 초상화는 위풍당당한 기스양키 전사를 묘사하고 있으며, 제왕의 풍채가 느껴집니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait
#. Speaker = Narrator
#. NodeID = 35f0cb5b-63c3-513f-98fb-876375168cc6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait:35f0cb5b-63c3-513f-98fb-876375168cc6
msgctxt "hda131aeegf745g4090ga5a0ge9f4e4291440"
msgid ""
"*With sudden clarity, you realise it's the symbol of Orpheus - a forgotten "
"hero from the tales of your youth.*"
msgstr "*문득 그것이 어릴 적 이야기 속 잊힌 영웅, 오르페우스의 문양이라는 것을 깨닫습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait
#. Speaker = Player
#. NodeID = 37cf3c94-9699-7511-f9d4-e29ba9dc9a2c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait:37cf3c94-9699-7511-f9d4-e29ba9dc9a2c
msgctxt "hb29edd74gc697g4734g97dbgfa5a5e8fc111"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait
#. Speaker = Narrator
#. NodeID = 430fdc7f-b18c-758c-a2d9-0c47669765a1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait:430fdc7f-b18c-758c-a2d9-0c47669765a1
msgctxt "he8d29f01ge687g4a53gba7bg7e6b0ae04d00"
msgid ""
"*As hard as you rack your brain, the symbol doesn't look like anything "
"you've seen before.*"
msgstr "*머리를 싸매 보아도, 그 문양은 전에 보지 못한 것 같습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait
#. Speaker = Narrator
#. NodeID = 47cdb93b-18f1-4f0d-ad39-614c0de5cd04
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait:47cdb93b-18f1-4f0d-ad39-614c0de5cd04
msgctxt "h9fd8e26cg6d64g4101g9a3bgc15b15148414"
msgid ""
"*In the corner of the painting is a small symbol you can't quite place.*"
msgstr "*구석에는 알아보기 힘든 작은 문양이 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait
#. Speaker = Lae'zel
#. NodeID = 54f753de-2b2a-4fa9-bf86-81819e21092d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait:54f753de-2b2a-4fa9-bf86-81819e21092d
msgctxt "h7eb94255g219eg4b8bgb1c8g7c27ee0f8550"
msgid "Blasphemy, to scrawl it here. And a colossal risk."
msgstr "이딴 걸 그려 놓다니, 신성모독이군. 엄청난 위험도 따르지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait
#. Speaker = Player
#. NodeID = 5b607e02-3dab-0e19-97f8-1a6493397adf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IMPOSSIBLE = True
