#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA:0b40edbd-2b25-cb46-717e-747a1f5c07f9
msgctxt "ha1456bd0gba8cg4128gba46gdfd1b3cb1f6e"
msgid "Stealing is the <i>art </i>of taking. It's a beautiful thing."
msgstr "훔치는 거야 말로 빼앗기의 <i>정수</i>지. 아름다운 일이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_MonasteryApproach_Bird_SWA
#. Speaker = Player
#. NodeID = 0e6c297b-7190-1dac-e3c6-cd492e39d81d
