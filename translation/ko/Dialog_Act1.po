msgctxt "h2dca8d52g2f6cg4144gb362g736ae6841989"
msgid "Dead. Not surprising."
msgstr "죽었어. 놀랍진 않군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_FoundWife
#. Speaker = Player
#. NodeID = f5f3a235-94a0-e60e-fb7e-68316c1bba8c
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_WYLL
