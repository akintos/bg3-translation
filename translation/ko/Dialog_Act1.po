#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_VB_PostFight_3P:fed53506-ac7e-5661-f08e-cfaf9032cda5
msgctxt "h5678d42bga9f4g499fgb532gbee06e45d756"
msgid "The gnolls' stink is everywhere."
msgstr "놀의 악취가 어딜 가도 나는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_VB_PostFight_3P
#. Speaker = Player
#. NodeID = fed53506-ac7e-5661-f08e-cfaf9032cda5
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ConflictedFlind_Knows_Gnolls = True
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_VB_PostFight_3P:fed53506-ac7e-5661-f08e-cfaf9032cda5
msgctxt "hd35b876cg28adg44baga4bfgbd3c0fed049b"
msgid "These vermin infest every crevice of this pathetic world."
msgstr "이 한심한 세계의 온 틈새에 저 해수가 창궐하는구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_VB_PostFight_3P
#. Speaker = Player
#. NodeID = fed53506-ac7e-5661-f08e-cfaf9032cda5
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ConflictedFlind_Knows_Gnolls = True
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_VB_PostFight_3P:fed53506-ac7e-5661-f08e-cfaf9032cda5
msgctxt "h11aedf91g5905g49e7g83b5g5615077154e4"
msgid "Demonspawn. We need to burn them out - they spread <i>quickly</i>."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_VB_PostFight_3P
#. Speaker = Player
#. NodeID = fed53506-ac7e-5661-f08e-cfaf9032cda5
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ConflictedFlind_Knows_Gnolls = True
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_VB_PostFight_3P:fed53506-ac7e-5661-f08e-cfaf9032cda5
msgctxt "haa37b0dbga8f3g4b7agab79g2ea13da5a59d"
msgid "This place runs rife with gnolls."
msgstr "이곳은 놀들로 가득해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_VB_PostFight_3P
#. Speaker = Player
#. NodeID = fed53506-ac7e-5661-f08e-cfaf9032cda5
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ConflictedFlind_Knows_Gnolls = True
#. TagRule: REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_VB_PostFight_3P:fed53506-ac7e-5661-f08e-cfaf9032cda5
msgctxt "h4ec9fe3bg04ccg466bg9f44g92c3427adff5"
msgid "Those beasts are here for a reason."
msgstr "저 짐승들은 분명 이유가 있어서 여기 온 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_VB_PostFight_3P
#. Speaker = Player
#. NodeID = fed53506-ac7e-5661-f08e-cfaf9032cda5
#. HandlePath = TaggedText[7].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ConflictedFlind_Knows_Gnolls = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_VB_PostFight_3P:fed53506-ac7e-5661-f08e-cfaf9032cda5
msgctxt "hebe41065g0343g4227g9596g9aef0de76f02"
msgid "Place is overrun with gnolls."
msgstr "이곳에 놀들이 넘쳐흐르는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim
#. Speaker = Salazon
#. NodeID = 0050e0cf-6b14-d983-a987-402ce78c5029
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - PLA_EscapingZhentarim_HasItem_HiddenEntranceKey2(0) = False
#. SetFlags:
#.   Dialog:
#.     - PLA_ZhentDungeon_Zhent01_HasMet(1) = True
#.   Global:
#.     - PLA_EscapingZhentarim_State_Permitted = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim:0050e0cf-6b14-d983-a987-402ce78c5029
msgctxt "h5821c767g4db8g4435g95b1g4ba2c88633eb"
msgid ""
"Entrance is hidden behind the wardrobe. You'll find a key in one of the "
"crates."
msgstr "옷장 뒤에 입구가 있어. 열쇠는 상자 중에 하나 뒤져보면 있을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim
#. Speaker = Player
#. NodeID = 00642ed1-307b-2c44-0dc2-2f98176b5aa8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentDungeon_State_SaidPassword = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim:00642ed1-307b-2c44-0dc2-2f98176b5aa8
msgctxt "hff98c1d1g081fg4ec8g8b90g1014d7492306"
msgid "I'm with Zarys - <i>do not cast that spell</i>."
msgstr "나는 자리스와 한편이야. <i>그 주문을 쓰지 말라고</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim
#. Speaker = Salazon
#. NodeID = 007fde22-826c-05ca-ad20-5e9729ffac1f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim:007fde22-826c-05ca-ad20-5e9729ffac1f
msgctxt "hf24a38b4gcbeeg4759ga49ag9d7d6981a528"
msgid ""
"Down you go, then. They'll be on us soon, so if you're looking to trade "
"you'd best be quick."
msgstr "그럼 내려가 봐. 놈들이 곧 들이닥칠 테니까 거래를 하고 싶거든 빨리 하는 게 좋을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim
#. Speaker = Salazon
#. NodeID = 14559e89-4fbe-2e1a-4ae9-95c8c5c8e3bf
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_EscapingZhentarim_Escape = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim:14559e89-4fbe-2e1a-4ae9-95c8c5c8e3bf
msgctxt "hbcb53b10g8283g4395ga127g148064dfd9dc"
msgid "Zarys! ZARYS, HELP!"
msgstr "자리스! <b>자리스, 도움이 필요해요</b>!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim
#. Speaker = Salazon
#. NodeID = 14e89ebc-aa6b-2872-9b27-77f94e6f9d20
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_EscapingZhentarim_Escape = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim:14e89ebc-aa6b-2872-9b27-77f94e6f9d20
msgctxt "hd50c13cdgc2f5g4e81gbeabg098214e83001"
msgid "That ain't the pass-phrase!"
msgstr "암구호는 그게 아니야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim
#. Speaker = Player
#. NodeID = 159f2471-969a-cc16-c1b1-cddc14c257c0
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim:159f2471-969a-cc16-c1b1-cddc14c257c0
msgctxt "hf494dfb6g6b6bg48c0gb1a7g243dc9a97e39"
msgid "Wait!"
msgstr "잠깐!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim
#. Speaker = Player
#. NodeID = 17b19434-b961-cdfe-6151-4201b3e653a2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_RuganToldPassword = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim:17b19434-b961-cdfe-6151-4201b3e653a2
msgctxt "h2453105aga0d2g47cdgac2dg54003c6e04cb"
msgid "<i>Recite Rugan's pass-phrase: 'Little serpent, long shadow'.</i>"
msgstr "<i>루간의 암구호를 읊는다. '작은 뱀, 긴 그림자.'</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim
#. Speaker = Player
#. NodeID = 1c31357f-e241-b49b-d652-c6ff07c88790
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Dexterity
#. DifficultyClass: 10
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_RuganToldPassword = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim:1c31357f-e241-b49b-d652-c6ff07c88790
msgctxt "h1ba0af6eg543cg4ab5gaa56g10607ffcbdbb"
msgid "<i>Recite Rugan's pass-phrase: 'Little serpent, long shadow'.</i>"
msgstr "<i>루간의 암구호를 읊는다. '작은 뱀, 긴 그림자.'</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim
#. Speaker = Salazon
#. NodeID = 2a7b0738-350f-92bb-c482-e8fbefcb4bc5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim:2a7b0738-350f-92bb-c482-e8fbefcb4bc5
msgctxt "hbde622e2gb168g42cbg86bfg31ea31044672"
msgid ""
"Right, look - if it's business you're about, then be about it. Flaming Fist "
"could be on us any minute."
msgstr "좋아. 사업 차 찾아온 거라면 빠르게 일 보도록 해. 플레이밍 피스트가 언제든 들이닥칠 수 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim
#. Speaker = Player
#. NodeID = 2b15d6b6-e7b6-9d01-a796-994ce7e5d28b
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - SORCERER(1) = True
#.      - SORCERER_WILDMAGIC(1) = False
#.      - SORCERER_DRACONIC(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim:2b15d6b6-e7b6-9d01-a796-994ce7e5d28b
msgctxt "h9665fa8agc381g4d5aga2a5g7baa0dfebf4f"
msgid "I <i>am</i> magic. Cast that spell - you'll only hurt yourself."
msgstr "나는 마법 <i>그 자체</i>야. 한번 시전해 보라고, 너만 다칠 테니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim
#. Speaker = Player
#. NodeID = 32864e54-8c82-3c39-de8b-3a3dbb6fc0d8
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BERSERKER(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim:32864e54-8c82-3c39-de8b-3a3dbb6fc0d8
msgctxt "h9ecd36d4g7907g44edga3c7g0261af79eab0"
msgid "<b><i>Do NOT make me angry!</i></b>"
msgstr "<b><i>나를 화나게 하지 마라!</i></b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim
#. Speaker = Salazon
#. NodeID = 3e5320a0-f741-91dc-c720-f18c4203c36c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_EscapingZhentarim_State_BarrelGone = False
#.      - PLA_ZhentDungeon_State_PlayerNearBarrel = True
#. SetFlags:
#.   Global:
#.     - PLA_EscapingZhentarim_Escape = True
#.   User:
#.     - PLA_EscapingZhentarim_Knows_WasAttacked(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim:3e5320a0-f741-91dc-c720-f18c4203c36c
msgctxt "he6c2555bgd226g4659g944dg197a9ce1fa63"
msgid "B-burn, bastard!"
msgstr "타... 타죽어라, 개자식들아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim
#. Speaker = Player
#. NodeID = 3f1f28e5-b2b2-a725-0e26-6e47884c403e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim:3f1f28e5-b2b2-a725-0e26-6e47884c403e
msgctxt "h9adb9388g8e92g458dg88d0g4709f57600c7"
msgid "I just want to trade."
msgstr "그냥 거래를 하고 싶은 것뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim
#. Speaker = Salazon
#. NodeID = 49635ee0-f215-f31c-f19f-83510794a4b5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - PLA_ZhentDungeon_Zhent01_HasMet(1) = True
#.   Global:
#.     - PLA_EscapingZhentarim_State_Permitted = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim:49635ee0-f215-f31c-f19f-83510794a4b5
msgctxt "hab9a021dg8c65g44ddg9f54gf2930d676a4b"
msgid "Gah, Helm's <i>orbs</i>. Thought you were Flaming Fist."
msgstr "하, 헬름의 <i>보주</i>같으니. 플레이밍 피스트인 줄 알았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim
#. Speaker = Salazon
#. NodeID = 4eae8d75-5df7-7ecc-b678-289ce21cfba9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim:4eae8d75-5df7-7ecc-b678-289ce21cfba9
msgctxt "h8492e5c3g42e6g4bbegbea8g0107b143dd3a"
msgid "Stay out of my head!"
msgstr "내 머릿속에서 나가!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim
#. Speaker = Player
#. NodeID = 57e88f37-f5a2-17b5-f2da-859320b94aae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim:57e88f37-f5a2-17b5-f2da-859320b94aae
msgctxt "he93d4c4agfc48g40e1g8557gbda64558caf5"
msgid "<i>Attack him.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim
#. Speaker = Player
#. NodeID = 5f1a724e-bf0d-fc97-8d64-e69c1058aa8b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim:5f1a724e-bf0d-fc97-8d64-e69c1058aa8b
msgctxt "hdee3f38agc5c8g404dg9f72g2e09b4386e33"
msgid "<i>Prepare to attack.</i>"
msgstr "<i>공격할 준비를 한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim
#. Speaker = Narrator
#. NodeID = 633fe4ec-5ca8-a443-c567-96dcb76a1764
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_EscapingZhentarim_State_NearBreach = False
#.      - PLA_EscapingZhentarim_Event_Spotted = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim:633fe4ec-5ca8-a443-c567-96dcb76a1764
msgctxt "hd5827babgcda9g4d04gb3fagc9e92ac8e62d"
msgid "*You spot a man crouching between the shelves - just as he spots you.*"
msgstr "*당신이 선반들 사이에 쪼그리고 있는 남자를 발견하는 동시에, 남자도 당신을 발견합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim
#. Speaker = Player
#. NodeID = 6d6b8083-6eab-c540-3316-79c41460e85f
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - SORCERER_DRACONIC(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim:6d6b8083-6eab-c540-3316-79c41460e85f
msgctxt "hd9f001c9gdfe8g4a3bg88ebg1218b25a4278"
msgid "Fire is in my blood. Do it. Let's see who survives."
msgstr "내 피 속에 불이 흐른다. 한번 해봐. 누가 살아남는지 보자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim
#. Speaker = Salazon
#. NodeID = 7209c31a-8a8d-5226-5e71-f04f54728791
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim:7209c31a-8a8d-5226-5e71-f04f54728791
msgctxt "hd72f173bg4e96g4911gb935g43c3317aad48"
msgid "One of our own, eh? All right, down you go."
msgstr "우리 일원이라고? 그렇다면 좋아. 내려가도록 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim
#. Speaker = Player
#. NodeID = 74c80e0c-8304-6737-8508-921d88fc9916
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BERSERKER(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim:74c80e0c-8304-6737-8508-921d88fc9916
msgctxt "h66d7393ag6c97g4640g9f10gd644b74d3d7d"
msgid "Careful. You won't kill me, but you <i>will </i>make me mad."
msgstr "조심하라고. 날 죽이진 못할 거고, 화를 <i>돋우긴</i> 하겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim
#. Speaker = Narrator
#. NodeID = 799ba900-118a-9e07-5602-62deeed078f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim:799ba900-118a-9e07-5602-62deeed078f0
msgctxt "h66699f2cg3be5g4dccg9161g0e47da79700e"
msgid "*He freezes, waiting on your next word.*"
msgstr "*그가 멈칫한 채, 당신의 다음 말을 기다립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim
#. Speaker = Salazon
#. NodeID = 7be80a47-25fe-0998-1d1f-c148eb6a810c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - PLA_EscapingZhentarim_HasItem_HiddenEntranceKey2(0) = True
#. SetFlags:
#.   Dialog:
#.     - PLA_ZhentDungeon_Zhent01_HasMet(1) = True
#.   Global:
#.     - PLA_EscapingZhentarim_State_Permitted = True
#.   Object:
#.     - PLA_EscapingZhentarim_GiveItem_HiddenEntranceKey2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim:7be80a47-25fe-0998-1d1f-c148eb6a810c
msgctxt "h0bab8e5dgeb74g478fga09cga3443024ca1b"
msgid "Down you go - entrance is behind the wardrobe. Here's the key."
msgstr "아래로 내려가, 입구는 옷장 뒤에 있어. 여기 열쇠 받아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim
#. Speaker = Narrator
#. NodeID = 7d1a70e8-ac55-4b7d-a2f1-dba9686a1b40
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_EscapingZhentarim_State_NearBreach = False
#.      - PLA_EscapingZhentarim_Event_Spotted = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim:7d1a70e8-ac55-4b7d-a2f1-dba9686a1b40
msgctxt "h9e6691e9g8faeg4e38ga5a6gc0443ade0a84"
msgid "*A human man awaits you, a spell crackling at his fingertips.*"
msgstr "*한 인간 남자가 당신을 바라보며, 손끝에서 주문을 타닥 피어올리고 있다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_EscapingZhentarim
#. Speaker = Player
#. NodeID = 84e0430a-b389-e393-5585-fbf342f4d85a
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 0
#. CheckFlags:
