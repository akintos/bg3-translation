msgctxt "h0cf22fdegee75g46c7gac79g9adfc6bc9272"
msgid ""
"Barrelstalks - under Myconid control, I believe. They release poison if "
"ruptured."
msgstr "통줄기야, 마이코니드들이 통제하고 있는 것 같은데. 파열되면 맹독을 내뿜지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PAD_BarrelstalkInteraction
#. Speaker = Player
#. NodeID = a319cca9-ccf6-c736-a43c-040d1c333c8c
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_Knows_Barrelstalks = True
