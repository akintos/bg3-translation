msgctxt "h0f73af0cg73c0g46f4g8e31gd6f34b72e792"
msgid ""
"*At the back of the crevice lies a bag, enfolded in the chitinous squabbling "
"of spiders. A shiny gold coin pokes from its mouth.*"
msgstr "*틈새 안에 거미들의 치열한 영역다툼으로 뒤덮인 주머니가 있습니다. 주머니에서 삐져나온 금화 한 닢이 반짝입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice
#. Speaker = Player
#. NodeID = d01b2ca5-033d-35e9-c25f-f86705d4f665
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice:d01b2ca5-033d-35e9-c25f-f86705d4f665
msgctxt "hb6c67910g5d84g4a86g9e9eg9f6dd970dbce"
msgid "<i>Take the bag.</i>"
msgstr "<i>가방을 가져간다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice
#. Speaker = Player
#. NodeID = d5b8c62b-fd7c-8ff8-4729-58bcc23d4428
