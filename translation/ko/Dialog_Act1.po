msgctxt "h291d5a82gb91fg4470gb1afg287f33a7662a"
msgid "Apologies for, er, trying to kill you before."
msgstr "음, 널 죽여버리려고 했던 건 사과하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent01
