msgctxt "hab139e62g8c52g4344g94dfgf7fb348543e1"
msgid "... god... everything... the future..."
msgstr "... 신... 모든 것... 미래..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander_Dead
#. Speaker = Player
