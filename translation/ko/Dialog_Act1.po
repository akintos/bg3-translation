#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ThullaHint_SurvivalCheck_PAD:6425661c-45c8-ae57-71f6-6b57423098a0
msgctxt "h80976d4ag24f6g4b04gb28cg351fa0f1d9af"
msgid ""
"Blood, tracks, broken shackles... The story of an escape told in tell-tale "
"paraphernalia."
msgstr "피, 흔적, 부러진 족쇄... 탈출 이야기에서 볼 법한 소재군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ThullaHint_SurvivalCheck_PAD
#. Speaker = Player
#. NodeID = 6425661c-45c8-ae57-71f6-6b57423098a0
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_ThullaHint_State_SurvivalCheckSuccess = True
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ThullaHint_SurvivalCheck_PAD:6425661c-45c8-ae57-71f6-6b57423098a0
msgctxt "hc061c7c1g3298g4090gaf34g7256c9b04f02"
msgid ""
"Bloody tracks. And shackles. <i>And </i>arrows. Someone barely got out of "
"here with their life."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ThullaHint_SurvivalCheck_PAD
#. Speaker = Player
#. NodeID = 6425661c-45c8-ae57-71f6-6b57423098a0
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_ThullaHint_State_SurvivalCheckSuccess = True
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ThullaHint_SurvivalCheck_PAD:6425661c-45c8-ae57-71f6-6b57423098a0
msgctxt "h4ab0d1f0g2d95g4466g98e2gd17b40985b79"
msgid ""
"Small footprints and discarded shackles. A gnome prisoner fled from here."
msgstr "작은 발자국과 버려진 쇠사슬. 여기서 한 노움 죄수가 도망쳤다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ThullaHint_SurvivalCheck_PAD
#. Speaker = Player
#. NodeID = 6425661c-45c8-ae57-71f6-6b57423098a0
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_ThullaHint_State_SurvivalCheckSuccess = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ThullaHint_SurvivalCheck_PAD:6425661c-45c8-ae57-71f6-6b57423098a0
msgctxt "hb691efcfg6fd5g41b9g94c2g7eec53988230"
msgid ""
"Broken shackles, near-miss arrows, a trail of blood... looks like a gnome "
"escaped."
msgstr "부서진 쇠사슬들, 아슬아슬한 화살들, 피 묻은 흔적... 노움 한 명이 탈출한 것 같다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ThullaHint_SurvivalCheck_PAD
#. Speaker = Player
#. NodeID = 6425661c-45c8-ae57-71f6-6b57423098a0
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_ThullaHint_State_SurvivalCheckSuccess = True
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ThullaHint_SurvivalCheck_PAD:6425661c-45c8-ae57-71f6-6b57423098a0
msgctxt "h6ff950cfgb453g4b39gbca3g82728148f445"
msgid ""
"Arrows, shackles, and gnome-sized tracks. Someone left this place in a hurry."
msgstr "화살들, 쇠사슬들, 노움 크기의 발자국들. 누군가 이곳을 서둘러 떠났다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ThullaHint_SurvivalCheck_PAD
#. Speaker = Player
#. NodeID = 6425661c-45c8-ae57-71f6-6b57423098a0
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_ThullaHint_State_SurvivalCheckSuccess = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ThullaHint_SurvivalCheck_PAD:6425661c-45c8-ae57-71f6-6b57423098a0
msgctxt "hedaff225gdbfag4968g93a4g24aa13e12342"
msgid "Bloodied tracks - quite small, too. A gnome found some trouble here."
msgstr "피 묻은 발자국들 - 아주 작기도 하네. 노움이 여기서 곤경에 처했나 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ThullaHint_SurvivalCheck_PAD
#. Speaker = Player
#. NodeID = e31b2b34-1bae-46c3-918f-fd74f54a900b
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ThullaHint_SurvivalCheck_PAD:e31b2b34-1bae-46c3-918f-fd74f54a900b
msgctxt "h590921f0gb7ecg4c41gbf5egff1effe9aef5"
msgid "Urgh. What a mess."
msgstr "으윽. 이게 뭐야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ThullaHint_SurvivalCheck_PAD
#. Speaker = Player
#. NodeID = e31b2b34-1bae-46c3-918f-fd74f54a900b
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ThullaHint_SurvivalCheck_PAD:e31b2b34-1bae-46c3-918f-fd74f54a900b
msgctxt "h31acc266g4c4cg4529gbd09g001943925a1b"
msgid "A bloody mess this. Something rather unpleasant went down here."
msgstr "피 묻은 난장판이군. 여기서 꽤 불쾌한 일이 벌어졌나 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ThullaHint_SurvivalCheck_PAD
#. Speaker = Player
#. NodeID = e31b2b34-1bae-46c3-918f-fd74f54a900b
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ThullaHint_SurvivalCheck_PAD:e31b2b34-1bae-46c3-918f-fd74f54a900b
msgctxt "he37bcf49g8036g493dga5f0gc7bebdeed1c0"
msgid "What's this mess? Can't make heads or tails of it."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ThullaHint_SurvivalCheck_PAD
#. Speaker = Player
#. NodeID = e31b2b34-1bae-46c3-918f-fd74f54a900b
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ThullaHint_SurvivalCheck_PAD:e31b2b34-1bae-46c3-918f-fd74f54a900b
msgctxt "h00d44e57g7c0bg4fe2g9381g8f63744ac3dd"
msgid "Such a mess. What happened here, I can't fathom."
msgstr "이런 난장판. 여기서 무슨 일이 일어났는지 도무지 알 수 없군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ThullaHint_SurvivalCheck_PAD
#. Speaker = Player
#. NodeID = e31b2b34-1bae-46c3-918f-fd74f54a900b
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ThullaHint_SurvivalCheck_PAD:e31b2b34-1bae-46c3-918f-fd74f54a900b
msgctxt "hf1f48b47gf77fg403dga5fcg196d734b16c5"
msgid "Something happened here... but what?"
msgstr "무슨 일이 있었던 것 같은데... 뭐지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ThullaHint_SurvivalCheck_PAD
#. Speaker = Player
#. NodeID = e31b2b34-1bae-46c3-918f-fd74f54a900b
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ThullaHint_SurvivalCheck_PAD:e31b2b34-1bae-46c3-918f-fd74f54a900b
msgctxt "h90da519fg8f77g4badg9aa0gb38a678d20c8"
msgid "What's all this? Something shady was going on here."
msgstr "이게 다 뭐야? 여기서 뭔가 수상한 일이 벌어지고 있었던 것 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ThullaHint_SurvivalCheck_PAD
#. Speaker = Player
#. NodeID = e31b2b34-1bae-46c3-918f-fd74f54a900b
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ThullaHint_SurvivalCheck_PAD:e31b2b34-1bae-46c3-918f-fd74f54a900b
msgctxt "h13090b5dgfbdeg428bgb8afgb285692bc087"
msgid "What happened here? It's hard to make any sense of this mess."
msgstr "여기서 무슨 일이 일어났지? 이 난장판을 이해하기가 힘들군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 000c0df9-d1dd-b937-4ca6-a0c6279942b0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:000c0df9-d1dd-b937-4ca6-a0c6279942b0
msgctxt "h77e86ddag6de1g407bg8077gc32664d0c45e"
msgid "Much as I'd love to chat, I'm not allowed social breaks."
msgstr "수다를 떨고 싶지만, 나에겐 사교적인 휴식이 허락되지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 00b14b02-3e3e-8707-2324-686199c4f44d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:00b14b02-3e3e-8707-2324-686199c4f44d
msgctxt "h8cab6ffaga666g412bgb653ga4449de84740"
msgid ""
"As I supposed. If you'll excuse me, I have something terribly important to "
"attend to."
msgstr "내 짐작대로군. 이만 실례할게. 끔찍하게 중요한 일이 있어서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 02f9760d-634c-d985-2869-46e75e0754e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:02f9760d-634c-d985-2869-46e75e0754e7
msgctxt "h030b64ddg4950g4b0dg893fg7224278d4cea"
msgid "Because there are gnomes trapped behind these rocks, stuck with a drow."
msgstr "왜냐면 이 뒤에 노움들이 갇혀있거든, 드로우와 함께 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 083b09bb-6e91-f59e-0028-5e58a6221eb9
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: !(DROWELF and DROWHALFELF and DUERGARDWARF)
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:083b09bb-6e91-f59e-0028-5e58a6221eb9
msgctxt "h44ea270bg4de4g40e5g8d0eg3762f97a8fdd"
msgid "These brutes are no mere goblins. I doubt you could take them on."
msgstr "이 짐승 놈들은 단순한 고블린이 아니야. 네가 상대할 수 있을지 모르겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 099aa617-0533-1f0e-3564-38391bd1366c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_IronhandGnomes_Knows_IronhandGnomes = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:099aa617-0533-1f0e-3564-38391bd1366c
msgctxt "h3aee9d56gdd06g4085ga38fg4b88e6f40cf2"
msgid ""
"You won't find a worse gaggle of rare-do-wells than these 'Ironhand Gnomes' -"
" except for Wulbren, desperate though his taste in companions might be."
msgstr "이 '아이언핸드 노움'보다 잘하는 짓 없는 무리를 찾기도 힘들 거야. 동료 고르는 안목만 처참한 울브렌은 제외하고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Player
#. NodeID = 110614b7-6055-9247-736e-1e0f1f4534a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:110614b7-6055-9247-736e-1e0f1f4534a8
msgctxt "h9af9332fga023g4aa8g8355g97f9f247600f"
msgid "I'm sensing a bit of history here."
msgstr "뭔가 사연이 있는 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Player
#. NodeID = 1138a22c-f67d-485a-ac74-427a777fee58
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - ca372b1e-a2af-e404-0c7d-12d306d00f24_MindreadSuccess = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:1138a22c-f67d-485a-ac74-427a777fee58
msgctxt "h423676e9g9fc2g4ef7g812bgdf19f7434f3c"
msgid ""
"What do you think will happen if the Ironhand Gnomes get their hands on "
"runepowder?"
msgstr "아이언핸드 노움이 룬파우더를 손에 넣으면 어떤 일이 생길 것 같아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Player
#. NodeID = 1178969f-a531-2d55-c661-a4bfa3a41954
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:1178969f-a531-2d55-c661-a4bfa3a41954
msgctxt "h1b8bea11gc354g4dc1gac39g5c04d32d3230"
msgid "Wander off alone and you might just meet them."
msgstr "혼자 떠나면 그들을 만날지도 모르지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Player
#. NodeID = 1244e99a-906f-b747-f8d5-4f81063e9b1c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:1244e99a-906f-b747-f8d5-4f81063e9b1c
msgctxt "h6ab9bb78g0561g4194ga1c5gdc578e22eeab"
msgid "You were on a quest, weren't you? Making progress?"
msgstr "뭔가 탐색하고 있지 않았나? 그건 어떻게 되어가고 있어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 125a9d81-6c84-9163-df87-ad4f6fea7d1c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:125a9d81-6c84-9163-df87-ad4f6fea7d1c
msgctxt "h48b370b5ga5aag439eg9c6dg2136b65bcec6"
msgid "Actually - don't answer that. The littler said about it, the better."
msgstr "사실은, 대답하지 마. 덜 들을수록 좋으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 1544ab3a-8b60-ac20-eaf5-a63046104cb0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:1544ab3a-8b60-ac20-eaf5-a63046104cb0
msgctxt "hc8744dfag67dag440bgb9bdg48dc7ff8e045"
msgid ""
"Before you go - I do realise an amount of thanks are in order. You've helped "
"me. Twice."
msgstr "가기 전에, 감사를 표하는 게 맞는 일인 것 같아. 넌 날 도와줬어. 두 번이나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 1b3b8c2d-3a5c-7002-a46b-34719e3e839e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:1b3b8c2d-3a5c-7002-a46b-34719e3e839e
msgctxt "hade6ada8g0275g4a2fga559g92760615e23c"
msgid "That is... not good news."
msgstr "그것 참... 좋은 소식은 아니네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Player
#. NodeID = 1b64f6f0-8ceb-b146-aabb-20961238e437
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:1b64f6f0-8ceb-b146-aabb-20961238e437
msgctxt "he0fb48c0gd1adg4adegb675g103f36c15e22"
msgid "I'll keep you in my prayers."
msgstr "널 위해 기도하겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 1c2eee54-8a58-3012-0eeb-4d34753f17d1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:1c2eee54-8a58-3012-0eeb-4d34753f17d1
msgctxt "he51ed5a2ge1f7g4238g80beg762cfcced391"
msgid ""
"Now - I do realise an amount of thanks are in order. You've helped me. Twice."
msgstr "자, 감사를 표하는 게 맞는 일인 것 같아. 넌 날 도와줬어. 두 번이나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 1c416ca1-e7b6-e5b7-66d5-db5517cd541f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_GnomeForeman_State_PermaDefeated = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:1c416ca1-e7b6-e5b7-66d5-db5517cd541f
msgctxt "hf479813bg6867g4973gb047g56f43b1b756a"
msgid "I have no coin, but the foreman will be happy to provide."
msgstr "내겐 돈이 없지만, 우리 감독관이 기꺼이 내 줄 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Player
#. NodeID = 1df21290-3021-086b-3683-cfd77605d03f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:1df21290-3021-086b-3683-cfd77605d03f
msgctxt "h6940df00g760bg4f80g8913g17c137136d69"
msgid "This is no place to travel alone."
msgstr "여긴 혼자 돌아다닐 만한 곳이 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Player
#. NodeID = 1f0125d4-1bb9-39e5-14f5-80562cc600ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:1f0125d4-1bb9-39e5-14f5-80562cc600ed
msgctxt "he487eff5g0e2dg4f3ega3bfgcdd70a79796c"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 24d6e6c9-310c-8ce8-878d-8ef5d7662b6a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:24d6e6c9-310c-8ce8-878d-8ef5d7662b6a
msgctxt "h7252103fg6f0fg4874gaf75g276e40629fc6"
msgid "We need to get them out - <i>now.</i>"
msgstr "그들을 꺼내야 해, <i>당장.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Player
#. NodeID = 2683f66d-6ed4-f362-e63f-441b0490e5a2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_IronhandGnomes_Knows_Runepowder = False
#.      - GLO_IronhandGnomes_Knows_IronhandGnomes = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:2683f66d-6ed4-f362-e63f-441b0490e5a2
msgctxt "h8855b2bfgf1d6g46a9ga611gfbdcdfff635f"
msgid "Do you know what the Ironhand Gnomes were doing down here?"
msgstr "이 아래에서 아이언핸드 노움들이 무슨 일을 하고 있었는지 알아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 28dde22e-43ed-6460-87bb-f56bb55da1f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:28dde22e-43ed-6460-87bb-f56bb55da1f5
msgctxt "h93c3cf1bgee4cg4883g8254g94e7bca009c9"
msgid "Dig. And hope for an opportunity to escape."
msgstr "땅 파는 거지. 탈출할 기회를 바라면서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 2a0f1b85-5d3f-6841-0243-d9b99fed9044
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_UnfortunateGnome_HasMet(1) = True
#.   Global:
#.      - UND_DuergarGuards_Excavation_State_PermaDefeated = True
#.      - UND_DuergarCamp_State_CaveInCleared = False
#. SetFlags:
#.   Dialog:
#.     - UND_UnfortunateGnome_HasMet2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:2a0f1b85-5d3f-6841-0243-d9b99fed9044
msgctxt "h79182d8bgbbfdg48e7ga118g381242cdb234"
msgid ""
"I'm tempted to cheer at the sight of these dead duergar, but there are still "
"gnomes trapped behind those rocks."
msgstr "이 죽은 듀에르가를 보면서 힘을 내고 싶은 마음은 굴뚝 같지만, 아직 이 바위 뒤에 노움들이 갇혀 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Player
#. NodeID = 2adf1d6c-3aa1-ada1-b085-ca70adddef1b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_IronhandGnomes_Knows_Runepowder = False
#.      - GLO_IronhandGnomes_Knows_IronhandGnomes = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:2adf1d6c-3aa1-ada1-b085-ca70adddef1b
msgctxt "hd04aefc8g697fg4d69g9feeg0779054ba88e"
msgid "Do you know what Wulbren and the others were doing down here?"
msgstr "울브렌과 다른 이들이 여기서 무슨 일을 하고 있었는지 알아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Player
#. NodeID = 2cf99d44-fdf0-eaab-dc5a-82738f0ef8d3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_IronhandGnomes_Knows_IronhandGnomes = False
#. SetFlags:
#.   Global:
#.     - GLO_IronhandGnomes_Knows_IronhandGnomes = True
#. TagRule: !(BALDURIAN and DEEPGNOME and GNOME)
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:2cf99d44-fdf0-eaab-dc5a-82738f0ef8d3
msgctxt "h0050569egc9b4g4ac8gaec1g088ba1a80eed"
msgid "'Ironhand Gnomes'? Haven't heard of them."
msgstr "'아이언핸드 노움'? 처음 듣는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 2eb6972e-00f1-0ad0-e555-024119612a52
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:2eb6972e-00f1-0ad0-e555-024119612a52
msgctxt "h9579abf4g3f84g4274g9286g83e0f02c830e"
msgid ""
"There are still gnomes trapped behind those rocks - with a vicious cultist, "
"no less."
msgstr "아직 이 바위 뒤에 노움들이 갇혀 있어. 끔찍한 사교도와 함께 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Player
#. NodeID = 3236c5a2-5b4c-d565-8dd1-60ec561cf7ba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:3236c5a2-5b4c-d565-8dd1-60ec561cf7ba
msgctxt "hd77f345cgccf3g4f03g9d1bg8cacbb769977"
msgid "First things first - you look exhausted. You should rest at my camp."
msgstr "일단 중요한 일부터, 당신 완전 지쳐 보이는데. 내 야영지로 와서 좀 쉬어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Player
#. NodeID = 3989b3bc-6ac2-bfa5-99bd-ef5f0e5978c2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:3989b3bc-6ac2-bfa5-99bd-ef5f0e5978c2
msgctxt "h47f3faa7g952bg4eb1g91c6ged34edd81d4f"
msgid "Sounds like you need my help again."
msgstr "보아하니 내 도움이 또 필요한 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 3f2a9f0d-6a03-39bf-95a8-aec4dff32993
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:3f2a9f0d-6a03-39bf-95a8-aec4dff32993
msgctxt "h97d52e8cg9375g42fegb146g771fe5e2f002"
msgid ""
"And so, you know - thank you. With that, I believe our business is concluded."
msgstr "그래서, 그러니까 - 고마워. 이걸로, 이제 우리 볼일은 끝난 것 같네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Narrator
#. NodeID = 427e3d9b-193a-e9f1-356d-6b86de1e7ef9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:427e3d9b-193a-e9f1-356d-6b86de1e7ef9
msgctxt "h2836f585g8f5bg4d64gad86gf11ac935c7d3"
msgid "*He's lying...*"
msgstr "*그는 거짓말을 하고 있습니다...*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Player
#. NodeID = 4918cf1b-be10-102e-01d4-eee5793f60ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:4918cf1b-be10-102e-01d4-eee5793f60ad
msgctxt "hf43839e7g250ag4179gbd25g3aef52363aed"
msgid "'Hope', is it? Enjoy the rest of your life as a captive, then."
msgstr "'희망'이라고? 그럼 남은 삶을 포로로 즐기라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 49b7d4e9-ba2f-2c4d-72f7-8c463525fea5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:49b7d4e9-ba2f-2c4d-72f7-8c463525fea5
msgctxt "hc7910916ge739g4604g8120g73fda566765d"
msgid "Ahem... that is... what do <i>you </i>know about runepowder?"
msgstr "에헴... 그러니까... <i>네가</i> 룬파우더에 대해 알고 있는 것을 얘기해줄래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Astarion
#. NodeID = 4bbe3287-41ec-09c5-8fe4-6e5e6bb710c9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:4bbe3287-41ec-09c5-8fe4-6e5e6bb710c9
msgctxt "hd9149f67g67afg4f94g9df4g26c85a0284ff"
msgid "The Towers must be close. And finding Moonrise means finding answers."
msgstr "탑이 가까이 있는 게 분명해. 그리고 문라이즈를 찾으면 답을 찾을 수 있겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 4d255b5c-fe93-394a-9fd6-9ff47c5aa97c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:4d255b5c-fe93-394a-9fd6-9ff47c5aa97c
msgctxt "h74a3b6dcg408eg4ad5g8230g99f3780d0fd1"
msgid ""
"Certainly not! In case you haven't been paying attention, my <i>friend </"
"i>has been taken <i>captive</i>. He needs me."
msgstr "그럴리가! 아직 네가 잘 모르나본데, 내 <i>친구</i>는 <i>포로</i>로 잡혀있었다고. 그는 내가 필요해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 4e188dc1-f8fe-bbbb-d07c-5f2da8934c83
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_UnfortunateGnome_HasMet(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:4e188dc1-f8fe-bbbb-d07c-5f2da8934c83
msgctxt "h20366c40g5c22g470bg84dfg852b24560078"
msgid "I shouldn't be surprised, considering our history. And yet..."
msgstr "놀랍진 않네, 우리 사연을 생각하면 말이야. 하지만..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 4fa42073-7a4f-ab6e-10a1-222b1c2ee36b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_UnfortunateGnome_HasMet2(1) = True
#.   Global:
#.      - UND_DuergarGuards_Excavation_State_PermaDefeated = True
#.      - UND_DuergarCamp_State_CaveInCleared = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:4fa42073-7a4f-ab6e-10a1-222b1c2ee36b
msgctxt "h414c63dcg0edag47bdg9b59gdf05c9f0013b"
msgid "Not now - we need to clear the cave-in!"
msgstr "지금은 안 돼 - 이 바위들을 치워야 한다고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 4fb6fc4c-524c-bb31-4a05-1acf18cbdd3f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:4fb6fc4c-524c-bb31-4a05-1acf18cbdd3f
msgctxt "h53cf4b80gc5d2g44e6gbe57g8ccf6d4c6885"
msgid "Ta!"
msgstr "고마워!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Player
#. NodeID = 501bad36-e637-5294-5e70-997e6fb28f96
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:501bad36-e637-5294-5e70-997e6fb28f96
msgctxt "hfdea946fgdd8eg497cg9828g6225ee7b1831"
msgid "Your friends are lost - there's no point dying for them."
msgstr "당신 친구들은 끝났어, 그들을 위해 죽을 필요는 없잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 520f3c6e-1f1b-fad2-3f64-99759deacaca
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_GnomeForeman_State_PermaDefeated = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:520f3c6e-1f1b-fad2-3f64-99759deacaca
msgctxt "h49034c75ga3fcg4df4g9079g55e002b44467"
msgid "Right. Ever the pragmatist, hm?"
msgstr "그래. 실용주의자 납셨군 그래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 53c1fcdc-c54d-11a4-a40a-a6a114fb58be
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:53c1fcdc-c54d-11a4-a40a-a6a114fb58be
msgctxt "h4c556578g00b9g4c63gb669g4bcb02565e52"
msgid ""
"Their fight has little to do with <i>freedom </i>and everything to do with "
"<i>power</i>. I told Wulbren not to go near them, but did he listen? He did "
"not."
msgstr ""
"그들의 싸움은 <i>자유</i>와는 전혀 상관없어, 그냥 <i>권력을</i> 위한 거지. 울브렌에게 그들과 가까이 지내지 말라고 했지만, "
"결국에는? 듣질 않았지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 53d8d022-e5e0-d732-8100-a9a1667429f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:53d8d022-e5e0-d732-8100-a9a1667429f4
msgctxt "h4734f3b9gb593g4733g9f46g1298a750c300"
msgid "No."
msgstr "아니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 563e7655-9a77-453c-b42f-1b5ca223840d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - ca372b1e-a2af-e404-0c7d-12d306d00f24_MindreadSuccess = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:563e7655-9a77-453c-b42f-1b5ca223840d
msgctxt "h91d025f8gc382g42a3gb7dagdce4dbbfc320"
msgid ""
"<i>I don't have time for this - the Ironhand Gnomes might already have their "
"hands on runepowder!</i>"
msgstr "<i>이럴 시간이 없어, 아이언핸드 노움들이 이미 룬파우더를 손에 넣었을지도 몰라!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 568c7ddb-3995-fcbd-1b19-6f619c18e085
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:568c7ddb-3995-fcbd-1b19-6f619c18e085
msgctxt "h52f5d129g763dg43feg90bfg48d6ecf1c6df"
msgid "Hm."
msgstr "흠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Player
#. NodeID = 64d31e90-6e2e-4981-0964-64fba6d42cda
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - UND_GnomeRescue.SaidHelpBarcus(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:64d31e90-6e2e-4981-0964-64fba6d42cda
msgctxt "hc6261204g574bg4622gadc1g9c1e395b874e"
msgid "I <i>could. </i>But I probably won't."
msgstr "나라면 <i>할 수 있지. </i>하지만 아마도 안할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Player
#. NodeID = 68265a55-964b-35c2-0ddb-e9dcc13c875b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:68265a55-964b-35c2-0ddb-e9dcc13c875b
msgctxt "h6dec27f3g02f8g438dg8488ga92671969eab"
msgid "I did. But not out of the kindness of my heart."
msgstr "그랬지. 하지만 내 마음속에서 우러나온 친절함 때문은 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 70fb42c8-d988-9b41-4433-a3d0def8cd2a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:70fb42c8-d988-9b41-4433-a3d0def8cd2a
msgctxt "h2d1dd970g1843g4520gaf11g82212371e217"
msgid "If Wulbren's dead, it's my job to find out who, when, where, and why."
msgstr "만약 울브렌이 죽었다면, 내가 할 일은 누가, 언제, 어디서, 그리고 어떻게 그를 죽였는지 알아내는 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Player
#. NodeID = 71cbaa9a-d4ef-80e1-6a1d-80165e483489
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_IronhandGnomes_Knows_BarcusWulbren = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:71cbaa9a-d4ef-80e1-6a1d-80165e483489
msgctxt "hb437ae68g3086g49c1g8119g4bbc4b033154"
msgid "How did you get captured?"
msgstr "넌 어떻게 붙잡힌 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 72224876-40fa-9916-7d49-7d1214ef5d27
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:72224876-40fa-9916-7d49-7d1214ef5d27
msgctxt "h2826ea21gbd53g46efgb495g7cf9673d4d45"
msgid "Unfortunately, it didn't account for an army of mad Underdark cultists."
msgstr "안타깝게도, 정신 나간 언더다크 광신도들의 군대에겐 설명이 통하지 않더군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Wyll
#. NodeID = 7365dd32-7e09-10ad-82d2-d38b06a3969d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_WYLL(6) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:7365dd32-7e09-10ad-82d2-d38b06a3969d
msgctxt "h756052a9g2f41g497bg93fbg43d608f69331"
msgid "Moonrise? We're closing in on the Towers. And the curse..."
msgstr "문라이즈라고? 탑에 가까워지고 있군. 그리고 저주에도..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Lae'zel
#. NodeID = 7417d203-c606-c2ab-263c-28213bf49992
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(2) = True
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:7417d203-c606-c2ab-263c-28213bf49992
msgctxt "h07467de1g65a8g452dgbd62g31d63acfbe43"
msgid "Moonrise? We're nearing the Towers. We're nearing <i>answers</i>."
msgstr "문라이즈라고? 탑에 가까워지고 있군. <i>해답</i>에 가까워지고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 74c2ced2-d0aa-2663-3adf-6a46b8878d87
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:74c2ced2-d0aa-2663-3adf-6a46b8878d87
msgctxt "h3530225dgc17bg4658ga1a5g0b790634d777"
msgid "<i>Hmm.</i>"
msgstr "<i>흐음.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Player
#. NodeID = 7581ae03-b6c2-178e-32af-76582c1c53d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:7581ae03-b6c2-178e-32af-76582c1c53d0
msgctxt "h6920322bg168ag4ef0ga4e7g1cbf9b0b97dd"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 75dd6295-7dc3-e313-4aa5-56a34963b0e0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_InjuredGnome_State_GaveQuest = True
#.      - GLO_UND_Gnomes_TalkedForeman = True
#. SetFlags:
#.   Global:
#.     - GLO_IronhandGnomes_Knows_WulbrenInMoonrise = True
#.     - GLO_IronhandGnomes_Knows_BarcusWulbren = True
#.   Quest:
#.     - UND_GnomeRescue.ThankedFreed_BarcusThulla(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:75dd6295-7dc3-e313-4aa5-56a34963b0e0
msgctxt "hd7d5e0cag417ag4121g95b3gf6139120ef19"
msgid ""
"As you know some of the Ironhand Gnomes - my friend Wulbren among them - "
"have been taken prisoner in Moonrise Towers."
msgstr "너도 알다시피, 아이언핸드 노움의 일부가 - 내 친구 울브렌도 포함해서 - 문라이즈 타워에 포로로 끌려갔어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 79a188a4-d76d-cb1d-1811-fcc865c0feaa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:79a188a4-d76d-cb1d-1811-fcc865c0feaa
msgctxt "h8a81a6eag925ag4b99g825egdea2a9608a21"
msgid ""
"But! I was too late. Wulbren had already been taken to Moonrise Towers. The "
"rest, put to work."
msgstr "하지만! 내가 너무 늦었어. 울브렌은 이미 문라이즈 타워로 끌려간 뒤였으니까. 나머지 사람들은 작업에 동원됐고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Player
#. NodeID = 7bb1790e-1ee4-776c-c369-3cb1a16c76d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:7bb1790e-1ee4-776c-c369-3cb1a16c76d6
msgctxt "h3a9c1063gb152g4386g894egc982a8c6b1d2"
msgid "Realistically, your friend is probably already dead."
msgstr "현실적으론, 네 친구는 이미 죽었을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Karlach
#. NodeID = 7d71d352-3a78-323a-5996-a23298848400
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_KARLACH(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:7d71d352-3a78-323a-5996-a23298848400
msgctxt "h06748b98g7871g4159g95c8g7e8c13ab2299"
msgid "Barcus has the right idea. We've got to get to Moonrise too - and soon."
msgstr "바커스의 말이 맞아. 우리도 어서 문라이즈 타워로 가야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Player
#. NodeID = 82c987a4-5a9c-6698-0a8c-e450d48e5a17
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:82c987a4-5a9c-6698-0a8c-e450d48e5a17
msgctxt "h80492866g22abg4610g9d68gc09ed4578314"
msgid "You're free - go on."
msgstr "넌 자유야, 가 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Player
#. NodeID = 83af5cf3-8f72-4d61-939d-bd1a6905932d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 0
#. CheckFlags:
#.   Local:
#.      - ca372b1e-a2af-e404-0c7d-12d306d00f24_MindreadSuccess = False
#.   Script:
#.      - GEN_CanDetectThoughts_2 = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:83af5cf3-8f72-4d61-939d-bd1a6905932d
msgctxt "h140331f9gf12eg4d4egb46eg4668d46c02f9"
msgid "<i>Probe his mind.</i>"
msgstr "<i>그의 정신을 탐색한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Player
#. NodeID = 83db8643-e51e-03a2-e72d-30e4afbbdcdf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:83db8643-e51e-03a2-e72d-30e4afbbdcdf
msgctxt "h2c3f5bf9g7157g4b3fgafcbge23605650cae"
msgid "Why don't you rest in my camp before your next big move?"
msgstr "다음 계획을 실행하기 전에 내 야영지에서 쉬어가는 건 어때?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 83dbafdf-ac4f-ab3c-7e9c-ed827cb778bf
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Moonrise_Knows_AbsoluteAtGrymforge = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:83dbafdf-ac4f-ab3c-7e9c-ed827cb778bf
msgctxt "h613dc6ebg781ag4a02g997ag83075107585c"
msgid "And so... to Moonrise Towers I go."
msgstr "그럼... 문라이즈 타워로 가야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 84878bd9-35ef-0466-549b-b8b59369962e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:84878bd9-35ef-0466-549b-b8b59369962e
msgctxt "h8d5df0b5gc8e6g4b31g9febgc60a0d39ddaa"
msgid "Won't be needing it, thank you!"
msgstr "그럴 필요는 없어, 고마워!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 87add6f2-3312-2485-d875-0a405fcd3afa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:87add6f2-3312-2485-d875-0a405fcd3afa
msgctxt "hb564d38cg2c3bg4102g9bb5g4dbec4c5dc76"
msgid "How gallant. Don't suffocate on your way out, hmm?"
msgstr "아주 씩씩하군. 나가다가 숨 막혀 죽지만 말라고, 흠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 87c3bfa0-992e-1859-d6f9-a2ab47cd9f3b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:87c3bfa0-992e-1859-d6f9-a2ab47cd9f3b
msgctxt "hc736d1afg813bg4688ga092g14fb4fb3a1cc"
msgid "And, erm, well... thank you."
msgstr "그리고, 음... 고마워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Player
#. NodeID = 88139324-dc39-8729-5144-eb3adc78e0e8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DUERGARDWARF(1) = True
#. SetFlags:
#.   Quest:
#.     - UND_GnomeRescue.SaidHelpBarcus(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:88139324-dc39-8729-5144-eb3adc78e0e8
msgctxt "h617613c8gd30bg4e8dga45dg087a987ddcbb"
msgid "Presumptuous. I'll get you out of here."
msgstr "건방지군. 내가 널 빼내 주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 8a7845b4-91a1-615c-53a0-30df8c064281
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DROWELF or DROWHALFELF or DUERGARDWARF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:8a7845b4-91a1-615c-53a0-30df8c064281
msgctxt "h0726135ega3dbg4a63g98d4gd1e4415ca8c4"
msgid ""
"I suppose I do. Though I'm not counting on one of <i>you </i>to help one of "
"<i>me</i>."
msgstr "그런 것 같네. 하지만 <i>네 </i>종족이 <i>내 </i>종족을 구할 거라 기대하진 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Shadowheart
#. NodeID = 8acffcdd-0135-d962-5f77-ad05931744db
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:8acffcdd-0135-d962-5f77-ad05931744db
msgctxt "ha9ee9cc9g96a7g407fg8f75g34c016c5f1f9"
msgid ""
"Moonrise? There's a lot resting on what we find in that place. It had better "
"deliver."
msgstr "문라이즈라고? 그곳에서 알아낼 것들이 아주 많군. 찾아가 보는 게 좋겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Player
#. NodeID = 8c087bc6-c94c-cd82-bbc0-60a62a0679be
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:8c087bc6-c94c-cd82-bbc0-60a62a0679be
msgctxt "hc0fffa1fg0486g4264gb09dgb5fb1c519f61"
msgid "Looks like you need rescuing. Again."
msgstr "보아하니 구조가 필요한 것 같은데. 또 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Player
#. NodeID = 8c35f024-0b61-ad88-9adc-60df8eb866ab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:8c35f024-0b61-ad88-9adc-60df8eb866ab
msgctxt "hdbd8b120g8c7eg4ad5gaf8eg643e82e03485"
msgid "Sounds like you made a profound tactical error."
msgstr "아주 큰 전술적 오류를 범한 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 8efa27a7-ed1b-0958-e8d0-87cab9bd2233
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: UNDERDARK
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:8efa27a7-ed1b-0958-e8d0-87cab9bd2233
msgctxt "h854e8557g050cg4855g8ab6gd7b91d7ccf4e"
msgid "Nothing good happens in the Underdark - you should know as well as I."
msgstr "언더다크에서 좋은 일은 없어 - 나보다 잘 알 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 8efa27a7-ed1b-0958-e8d0-87cab9bd2233
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:8efa27a7-ed1b-0958-e8d0-87cab9bd2233
msgctxt "h794dded6g43e9g416cg9b29g5f659cf20620"
msgid "Nothing good happens in the Underdark."
msgstr "언더다크에서 좋은 일은 일어나지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 8f390f52-f7ca-01c3-0928-3f06f44b5eb3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:8f390f52-f7ca-01c3-0928-3f06f44b5eb3
msgctxt "h1996f4fdg92d0g4f83ga59bg4e3e49a2b2db"
msgid "I thought they'd be easy to outwit. I had an entire plan..."
msgstr "쉽게 한 수 앞설 수 있을 줄 알았는데. 계획을 짜 놨었다고..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 8f70acf4-352d-dde8-c411-0deecdde4969
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:8f70acf4-352d-dde8-c411-0deecdde4969
msgctxt "h0ecc9328ge272g40d4ga708g64262210a5c2"
msgid "As I was contemplating his folly, I was spotted by a very ugly duergar."
msgstr "나는 그의 어리석음을 생각하던 중 아주 못생긴 듀에르가에게 발각됐지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 9365b4ee-6ea9-809d-b129-ec1be92a4201
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_UnfortunateGnome_HasMet2(1) = False
#.   Global:
#.      - UND_TheDrowNere_State_PermaDefeated = True
#.      - UND_DuergarMutineers_State_PermaDefeated = True
#. SetFlags:
#.   Dialog:
#.     - UND_UnfortunateGnome_HasMet2(1) = True
#.   Global:
#.     - UND_State_LeaderFreedGnomes = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:9365b4ee-6ea9-809d-b129-ec1be92a4201
msgctxt "h496daeeeg1734g45eag9bbbgd4e25b8945ef"
msgid "Well. You... did it!"
msgstr "좋아. 당신이... 해냈군!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 936f066a-949a-c8a0-3e06-2cd93333855f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:936f066a-949a-c8a0-3e06-2cd93333855f
msgctxt "h15058e5eg77afg4c9ag896agc131ff9cc206"
msgid ""
"Nor did I account for some captives to be trapped in with the drow after the "
"cave-in."
msgstr "게다가 낙석에 드로우와 함께 포로들이 갇혀 있을 거라는 건 계획에 넣지 못했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Player
#. NodeID = 9aa2c522-bf49-5b2a-b913-b03f4d4abbb6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:9aa2c522-bf49-5b2a-b913-b03f4d4abbb6
msgctxt "h013393fcg2005g41a1g90f7gad3e1b69e5d7"
msgid "I'll keep them in my prayers."
msgstr "그들을 위해 계속 기도하겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 9c93386e-0837-41b3-f17d-3b11b1935c30
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:9c93386e-0837-41b3-f17d-3b11b1935c30
msgctxt "h1103b691g563bg47aag98fege1a4db6ccae3"
msgid "Good bye, my misery's favourite companion."
msgstr "잘 가, 내 불행이 가장 아끼던 동료."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = 9facfb0b-5972-48d2-9d2b-dce050506c60
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DUERGARDWARF or LOLTHDROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:9facfb0b-5972-48d2-9d2b-dce050506c60
msgctxt "hb2610d75geba1g4e24gbcc1g7e10cbdcd0bb"
msgid ""
"I know someone of your background would fit right in in that heart of "
"horrors, but for others of us it's quite a frightening prospect."
msgstr "당신과 같은 배경을 가진 사람이라면 그 공포의 중심부에 잘 어울릴 수 있겠지만, 다른 이들에게는 꽤나 두려운 일이라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = a2ca4c66-6c76-2ab1-7afe-0b64e703539d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:a2ca4c66-6c76-2ab1-7afe-0b64e703539d
msgctxt "hb31afbb8g1524g46a5gb23fg7fd9ff4eb0d6"
msgid "They call themselves 'freedom fighters'. I call them extremists."
msgstr "스스로 '자유의 전사들'이라 칭하는데, 내가 보기엔 극단주의자들이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Player
#. NodeID = a4a9cde8-5ad5-add2-77a0-02f0a6814ff6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:a4a9cde8-5ad5-add2-77a0-02f0a6814ff6
msgctxt "hf06fa24eg48d4g4226g9508g26256c98eb48"
msgid "Suit yourself."
msgstr "마음대로 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Player
#. NodeID = a62ada46-c62b-a6db-df3f-697efa33caa8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - UND_GnomeRescue.SaidHelpBarcus(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:a62ada46-c62b-a6db-df3f-697efa33caa8
msgctxt "h5b8ee16cg8f19g4294ga842g86d795aad4f3"
msgid ""
"That sounds like a challenge. I'll take care of your captors, <i>and </"
"i>I'll get you out of here."
msgstr "그거 도전적인 일로 들리는군. 내가 너를 납치한 자들을 <i>처리하고</i>, 여기서 나가게 해줄게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Player
#. NodeID = a926b87e-b4e6-87d2-f4b9-12524c9f4860
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:a926b87e-b4e6-87d2-f4b9-12524c9f4860
msgctxt "h76283322gcdc2g4be9ga0f0g2b015090541c"
msgid "How did you end up here?"
msgstr "어쩌다 여기까지 오게 된 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = a948f07a-c99b-958b-4332-0b9ded0791ca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:a948f07a-c99b-958b-4332-0b9ded0791ca
msgctxt "hc4a8a732gafedg4930ga3f3g6271222ef6aa"
msgid ""
"It isn't personal. No one likes the Ironhand Gnomes except the Ironhand "
"Gnomes."
msgstr "개인적인 건 아니야. 본인들 말고 아이언핸드를 좋아하는 사람 따위는 없다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Player
#. NodeID = aadbe191-f3cc-2941-8cfa-851cab18482f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:aadbe191-f3cc-2941-8cfa-851cab18482f
msgctxt "h8633cb42gf5d5g4fd9g85b5gb21ae085855b"
msgid "Don't sound so surprised."
msgstr "너무 놀라지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = acf84408-5a55-6f15-5ace-de3c0c0aa558
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:acf84408-5a55-6f15-5ace-de3c0c0aa558
msgctxt "hf221ef06gb1c0g4f49g8f02gfdf841ebdade"
msgid "<i>What?!</i>"
msgstr "<i>뭐라고?!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = aef5ba65-1151-1495-de63-087ff23e1a3d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_UnfortunateGnome_Event_GoCamp = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:aef5ba65-1151-1495-de63-087ff23e1a3d
msgctxt "h673c04dfg50ffg4655g8ff5g300cf3728ea8"
msgid "And. Erm. Thank you."
msgstr "그리고. 어. 고마워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Player
#. NodeID = b29f9d55-d083-54f6-0473-459d886b3d94
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_IronhandGnomes_Knows_IronhandGnomes = True
#. TagRule: DEEPGNOME or GNOME
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:b29f9d55-d083-54f6-0473-459d886b3d94
msgctxt "h63922de7g9ebbg42d9gb3c0g338fb9dd3599"
msgid ""
"What are the Ironhands doing down here? I thought their fight for gnomish "
"freedom was local to Baldur's Gate."
msgstr "아이언핸드가 여기서 뭘 하는 거야? 그들의 투쟁은 발더스 게이트에 한정되어있는 줄 알았는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Player
#. NodeID = b29f9d55-d083-54f6-0473-459d886b3d94
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_IronhandGnomes_Knows_IronhandGnomes = True
#. TagRule: BALDURIAN
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:b29f9d55-d083-54f6-0473-459d886b3d94
msgctxt "h060dc886gbacfg459fg8dfeg07004f3ffa79"
msgid ""
"Ironhand Gnomes... I recognise the name. They fight for gnomish recognition "
"in the city, right?"
msgstr "아이언핸드 노움이라... 들어본 적 있어. 노움의 인식 개선을 위해 도시에서 노력하는 이들 맞지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Player
#. NodeID = b3e97252-664d-84d3-d47b-fe2e89578ae1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:b3e97252-664d-84d3-d47b-fe2e89578ae1
msgctxt "h3ea1d810g90bfg42a0g9819gf6ed05ad05eb"
msgid "I suspect I'll be rescuing you a third time, then."
msgstr "그럼 조만간 세 번째 구출로 재회하게 될 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = b7c0da7a-1691-40ce-b63f-a7b3d882c5c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:b7c0da7a-1691-40ce-b63f-a7b3d882c5c0
msgctxt "h9b149524g12b6g40fegb6cdg0908e45746a3"
msgid ""
"I came down here looking for Wulbren - I suspected he and his little friends "
"might've come to this region, and I was right."
msgstr "울브렌을 찾으러 여기 내려왔지. 울브렌과 그의 친구들이 이 지역에 왔을지도 모른다는 생각이 들었고, 내 생각이 맞았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = bb694a4d-adce-a71d-b019-215483ff2670
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_UnfortunateGnome_HasMet(1) = True
#.   Global:
#.      - UND_DuergarGuards_Excavation_State_PermaDefeated = False
#.      - UND_TheDrowNere_State_PermaDefeated = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:bb694a4d-adce-a71d-b019-215483ff2670
msgctxt "h2ebac459g14a2g4136g937egd2ddf790c515"
msgid "Please. They get very <i>aggressive </i>if we stop digging."
msgstr "제발. 우리가 파는 걸 멈추면 놈들이 아주 <i>공격적</i>으로 변한다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = bb8e3899-ef54-40a9-b5f9-908a961ec928
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:bb8e3899-ef54-40a9-b5f9-908a961ec928
msgctxt "h22802bd2g8d2dg435egb8a9gb85c58ddd61b"
msgid "They're not even going after him. I wish I were surprised."
msgstr "그를 쫓아 가지도 않는군. 놀랍지도 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Gale
#. NodeID = bc10a618-a58b-7360-9bc1-0f091d77c397
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_GALE(7) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:bc10a618-a58b-7360-9bc1-0f091d77c397
msgctxt "h4a2cc4f5gbffbg4ba9g9094g0351d677f735"
msgid ""
"Moonrise. We're getting close to the lion's den - and plenty of questions I "
"have for the lion, too."
msgstr "문라이즈라. 사자 굴에 점점 가까워지고 있군. 그리고 사자에게 묻고 싶은 것들도 아주 많고 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = bc1fa6d3-6f24-7ead-9590-163882f788d5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:bc1fa6d3-6f24-7ead-9590-163882f788d5
msgctxt "he9e4d5f1g4b6cg4bfcga556g69777f9ab6d0"
msgid "Now, I dig. It isn't good."
msgstr "그래서 내가 땅을 파고 있는 거야. 이건 좋지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Player
#. NodeID = bf3e0bd9-daf2-6745-4063-1cfd1245b66e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:bf3e0bd9-daf2-6745-4063-1cfd1245b66e
msgctxt "h43d78cb0gffe3g4946g8864gbe99b7f012b8"
msgid "Why are you digging?"
msgstr "왜 삽질을 하고 있는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = bfdda1ef-5134-a2f9-820a-cf8b53c453a8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_DuergarGuards_Excavation_State_PermaDefeated = True
#.      - UND_DuergarCamp_State_CaveInCleared = False
#. SetFlags:
#.   Dialog:
#.     - UND_UnfortunateGnome_HasMet2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:bfdda1ef-5134-a2f9-820a-cf8b53c453a8
msgctxt "h9ec000bdg184cg47dfgbcb3g894ab2e7c629"
msgid "Ah. It's you. The mascot of my ill fortunes."
msgstr "아. 너로군. 내 불운의 마스코트."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = c0763533-2ac4-165b-f48c-03478f774f38
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:c0763533-2ac4-165b-f48c-03478f774f38
msgctxt "h7cf15277g3c24g4c04ga157gacf8f58fb9c2"
msgid "You will? If you are successful, that would be most convenient."
msgstr "그래 줄래? 만약 네가 성공한다면, 내게 아주 큰 도움이 될 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = c40be5cc-e705-e734-2f28-d3aa819855e4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DUERGARDWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:c40be5cc-e705-e734-2f28-d3aa819855e4
msgctxt "h2cef19e1ge699g4d3ag965ag3d186e5353b1"
msgid "Erm - no offence."
msgstr "으음 - 기분 나쁘게 듣진 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = c9abdaeb-77e4-833e-4190-01ed3e919bea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:c9abdaeb-77e4-833e-4190-01ed3e919bea
msgctxt "hc7abf2aeg2c2eg4d6ag8275gb9e10e39942c"
msgid ""
"Fine. Show me where to go, and I'll try my luck. I'll have a better chance "
"of rescuing Wulbren if I'm at my best.<i></i>"
msgstr ""
"좋아. 어디로 가야 할지 보여줘, 그럼 내 운을 시험해 보도록 하지. 내 상황이 좋아야 울브렌을 구할 가능성이 높아질 테니 "
"말이야.<i></i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = cbbfac25-a236-e9a4-a578-017ea2e49023
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:cbbfac25-a236-e9a4-a578-017ea2e49023
msgctxt "hbc6595ecg8026g4afdga35bgc931a5e3ac56"
msgid "Free. Yes."
msgstr "자유. 그래."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Player
#. NodeID = cbf7c961-b187-fbbc-9d86-c0d273e313c5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:cbf7c961-b187-fbbc-9d86-c0d273e313c5
msgctxt "had6a03a1g0532g42e8g943fg6845a192d02d"
msgid "You could just ask for my help."
msgstr "그냥 내 도움을 요청해도 되는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = cf5c6f9b-f8f5-3cfc-5ac1-695d525fc174
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:cf5c6f9b-f8f5-3cfc-5ac1-695d525fc174
msgctxt "hda1e65edg9129g49bfg99f2g81eeeac87af7"
msgid "I won't leave them to his whims."
msgstr "그의 변덕에 그들을 남겨두진 않겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = d20db25b-5de5-5590-a0fc-b4b4b5b18525
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:d20db25b-5de5-5590-a0fc-b4b4b5b18525
msgctxt "hd4f22655g109eg48c6g8406gfcfc5848c303"
msgid "Thank you, but I doubt the gods will hear you down here."
msgstr "고마워, 하지만 신들이 이 아래에서 네 목소리를 들을 수 있을 것 같지는 않군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = d28d3816-74c3-ff6b-f4a2-d9b8c4e2593e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:d28d3816-74c3-ff6b-f4a2-d9b8c4e2593e
msgctxt "haf51fdf3g0f7ag464agb71eg08a96908bc04"
msgid "I always do."
msgstr "난 항상 그래."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = d31939c4-20a2-f992-986e-acaf6281805b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:d31939c4-20a2-f992-986e-acaf6281805b
msgctxt "h397bb2d3g1404g40afg9d77g8e37b29d89af"
msgid "I <i>must </i>speak with Wulbren. Now more urgently than ever."
msgstr "<i>반드시 </i>울브렌과 이야기를 나눠야겠어. 그 어느 때보다 급해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = d5112ae9-a4e6-cc56-68af-93534de20a5e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:d5112ae9-a4e6-cc56-68af-93534de20a5e
msgctxt "h95309387g0b0cg4586g9f91gcd07593f3d7f"
msgid "Help would be welcome. Whether you're up to the job remains to be seen."
msgstr "도움이라면 환영이야. 네가 해낼 수 있을지 없을지는 다른 문제지만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = d53e9fdf-46c8-af03-1d5a-f11bf019d529
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_UnfortunateGnome_HasMet(1) = False
#.   Global:
#.      - UND_DuergarGuards_Excavation_State_PermaDefeated = False
#.      - UND_TheDrowNere_State_PermaDefeated = False
#. SetFlags:
#.   Dialog:
#.     - UND_UnfortunateGnome_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:d53e9fdf-46c8-af03-1d5a-f11bf019d529
msgctxt "h86d1557bgeaccg4e2cg92b0g1efc41481bac"
msgid "Ah. It's you. The mascot of my ill fortunes..."
msgstr "아. 너로군. 내 불운의 마스코트..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = d84d7f21-b4dd-f430-814e-df2eef9ab7aa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:d84d7f21-b4dd-f430-814e-df2eef9ab7aa
msgctxt "h270c2ed4gc5edg4d5dgb4c3gd9e830009ef8"
msgid ""
"Once again, however, you've done me a decent turn. Most amusing, watching "
"you wallop greylings."
msgstr "하지만, 다시 한번, 넌 날 도와줬어. 아주 재밌더군, 네가 저 회색 놈들을 후려치는 모습이 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Player
#. NodeID = d8d9a090-78cf-8f05-902c-e646d6a8fe95
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:d8d9a090-78cf-8f05-902c-e646d6a8fe95
msgctxt "hb6a75542g5f13g498ag9be8g3859861d8458"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Player
#. NodeID = dd8a9b4b-fef9-131f-d8e9-f3547f9b23ee
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_DRAGONBORN
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:dd8a9b4b-fef9-131f-d8e9-f3547f9b23ee
msgctxt "h28b3d77egc235g49a8g822fg911ef7a6a482"
msgid "A brave act. Your stature belies your courage."
msgstr "용감한 행동이야. 당신 키가 용기를 다 표현하지 못하는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Player
#. NodeID = dd8a9b4b-fef9-131f-d8e9-f3547f9b23ee
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: ROGUE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:dd8a9b4b-fef9-131f-d8e9-f3547f9b23ee
msgctxt "h493dfbf2g30b9g473fgb9edg60e1209ea521"
msgid "Hiding in plain sight. A cunning strategy."
msgstr "완전히 드러난 곳에 숨는다라. 아주 치밀한 계획이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Player
#. NodeID = dd8a9b4b-fef9-131f-d8e9-f3547f9b23ee
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:dd8a9b4b-fef9-131f-d8e9-f3547f9b23ee
msgctxt "hba5d3ec9g0e2eg456eg9b66g7222428f3b9d"
msgid "That was brave of you."
msgstr "아주 용감했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Player
#. NodeID = df2c56c3-6633-7415-21e0-d4cb089aec35
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_DuergarGuards_Excavation_State_PermaDefeated = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:df2c56c3-6633-7415-21e0-d4cb089aec35
msgctxt "hd5709ddcge166g4733ga3e6gc518d50444b1"
msgid "What's the next part of your plan?"
msgstr "다음 계획은 어떻게 되지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Player
#. NodeID = df324962-11ba-7882-f059-8d7793fe8dc3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_IronhandGnomes_Knows_Runepowder = True
#.      - IMPOSSIBLE = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:df324962-11ba-7882-f059-8d7793fe8dc3
msgctxt "h011c5376gf54ag4aa8g8e3eg47cb1a7b09f6"
msgid "I've learned that Wulbren and the others are in search of runepowder."
msgstr "울브렌과 다른 이들이 룬파우더를 찾고 있다는 걸 알게 됐어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Player
#. NodeID = e1a3f6d7-2fc2-2109-5c63-d2b6ea5be80a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_DuergarGuards_Excavation_State_PermaDefeated = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:e1a3f6d7-2fc2-2109-5c63-d2b6ea5be80a
msgctxt "h9e94f974g8ec0g412eg98d7g8c1470050715"
msgid "The duergar are dead. You need to run."
msgstr "듀에르가는 죽었어. 도망쳐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = e974e4d6-c9b7-1b4e-5db8-03ec27b08407
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:e974e4d6-c9b7-1b4e-5db8-03ec27b08407
msgctxt "h2a1e9d1dga996g4173gaae5g10735d984f46"
msgid "Pah. I was unlucky twice. The odds of it happening again are very slim."
msgstr "쳇. 운 없던 건 두 번으로 충분해. 또 이런 일이 생길 확률은 지극히 낮다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = ea54f062-4bff-4c20-8ce1-4fe52a0d6fd6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:ea54f062-4bff-4c20-8ce1-4fe52a0d6fd6
msgctxt "h0bd3d946geb49g4fb6g9951g25d0a931f626"
msgid ""
"<i>No one </i>should touch the stuff. Not Wulbren, and <i>especially </i>not "
"those Ironhand jackals."
msgstr ""
"<i>누구도 </i>그런 걸 손에 넣어선 안 돼. 울브렌도 그렇고, <i>특히나 </i>그 승냥이 같은 아이언핸드 놈들은 절대 안 되지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = eac27534-e109-c7de-09ec-43f1f3979c74
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:eac27534-e109-c7de-09ec-43f1f3979c74
msgctxt "h52de50b0ge4d3g484dg8931g15079ce0f9ea"
msgid "I thought I was."
msgstr "난 내가 그런 줄 알았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = f0b3bec3-b860-4516-b253-f46f7da92081
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:f0b3bec3-b860-4516-b253-f46f7da92081
msgctxt "h5215b1eegfbb9g41b5ga887g6ec87f95f454"
msgid "You - get out of my nut! THIS MINUTE!"
msgstr "너 - 내 머릿속에서 나가! <b>당장</b>!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = f22925f3-b96a-c576-ff39-03abcdd54ebd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:f22925f3-b96a-c576-ff39-03abcdd54ebd
msgctxt "h7d8815e6g4a50g40e9g8e31gbe3d529a8a9f"
msgid ""
"They're a clan of artificers in Baldur's Gate. I won't speak ill of their "
"skills, but their politics are another matter entirely."
msgstr "발더스 게이트의 아티피서 일족이지. 그 자들 실력은 확실하지만, 정치적인 부분에서는 문제가 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Player
#. NodeID = f2580125-483b-556b-7bf3-cf4a0ea32c92
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:f2580125-483b-556b-7bf3-cf4a0ea32c92
msgctxt "h6dbae8e7g9422g4f62gba38ge24ab40a83c8"
msgid "Farewell, Barcus - I wish you luck with your search."
msgstr "잘 가, 바커스 - 당신의 수색에 행운이 따르길 빌게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = f3a6a058-1ee6-3a24-745f-6e54bafdd12d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:f3a6a058-1ee6-3a24-745f-6e54bafdd12d
msgctxt "h928f165ageaa9g4f96gbb0eg16e4f97f76ab"
msgid "How kind. Don't suffocate on your way out, hmm?"
msgstr "아주 친절하군. 나가다가 질식하지 말라고, 흠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = f506d4d9-b74d-f38d-619d-edf989f270d5
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:f506d4d9-b74d-f38d-619d-edf989f270d5
msgctxt "h9fbd853bg2d50g4d33g846cg9116b48ee22a"
msgid "Rest at a drow camp? I'd be safer among mind flayers."
msgstr "드로우의 야영지에서 쉬라고? 마인드 플레이어랑 있는 편이 더 안전하겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = f506d4d9-b74d-f38d-619d-edf989f270d5
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DUERGARDWARF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:f506d4d9-b74d-f38d-619d-edf989f270d5
msgctxt "hd3537c97g1b76g4dfag9002gf06677bdc88f"
msgid "Rest at a duergar camp? I'd be safer among mind flayers."
msgstr "듀에르가의 야영지에서 쉬라고? 마인드 플레이어랑 있는 편이 더 안전하겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = f57af3cb-4123-187c-4d67-d88661550956
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_UND_Gnomes_TalkedForeman = False
#. SetFlags:
#.   Global:
#.     - GLO_IronhandGnomes_Knows_WulbrenInMoonrise = True
#.     - GLO_IronhandGnomes_Knows_BarcusWulbren = True
#.   Quest:
#.     - UND_GnomeRescue.ThankedFreed_Barcus(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:f57af3cb-4123-187c-4d67-d88661550956
msgctxt "h73e5a96egd8e5g4c82ga0d8ge3643ba16318"
msgid ""
"I don't know if you heard, but some of the Ironhand Gnomes - my friend "
"Wulbren among them - have been taken prisoner in Moonrise Towers."
msgstr "네가 들었는지는 모르겠지만, 아이언핸드 노움의 일부가 - 내 친구 울브렌도 포함해서 - 문라이즈 타워에 포로로 잡혀갔어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = f7d2e7c7-c3de-bc7b-d2ef-1ba2b3970a2b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:f7d2e7c7-c3de-bc7b-d2ef-1ba2b3970a2b
msgctxt "h057020acgf92ag40ffgab85g1b6e5eb7c513"
msgid ""
"... then again, a small rest <i>might </i>be prudent. Give me time to think."
msgstr "... 하지만, 조금 쉬는 것도 <i>좋을지도 </i>모르겠네. 생각할 시간을 줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Player
#. NodeID = f91bb1f9-866c-e457-01b2-15aaab8d50f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:f91bb1f9-866c-e457-01b2-15aaab8d50f5
msgctxt "ha9502007g9175g40d1g91eeg4ed8b1c97b4e"
msgid ""
"I believe I'm destined for the Towers as well. I'll look for your friends."
msgstr "나도 그 타워로 향할 운명인 것 같아. 네 친구들을 찾아볼게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = fdf71700-1640-2980-774e-ed542cf08058
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:fdf71700-1640-2980-774e-ed542cf08058
msgctxt "h66aa97aag2973g4cfcga482g5b69fb3dcfd9"
msgid ""
"Friend. Singular. I'm looking for Wulbren - if anyone else should be "
"incidentally helped, then bully for them."
msgstr "'친구'야. 한 명이라고. 내가 찾는 건 울브렌이야 - 그 과정에서 다른 이들도 돕게 된다면, 그냥 부수적인 일이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome
#. Speaker = Barcus Wroot
#. NodeID = fe90fa79-f053-7950-9fda-ee180f399d5f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_UnfortunateGnome:fe90fa79-f053-7950-9fda-ee180f399d5f
msgctxt "hb01e041fg8f28g4712gb6d4g59a1e7d2c9a2"
msgid "Too many permutations. Quite the headache."
msgstr "경우의 수가 너무 많아. 머리가 아플 지경이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_WormWall
#. Speaker = Narrator
#. NodeID = 0e818d51-6e6b-55ba-c2eb-218d4464834a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - UND_WormWall_State_Scared(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_WormWall:0e818d51-6e6b-55ba-c2eb-218d4464834a
msgctxt "hb12e6944gae8bg48fegabcag384651bf8f2f"
msgid ""
"*Horrified, you withdraw your hand instinctively, before whatever's lurking "
"inside can react.*"
msgstr "*깜짝 놀라, 당신은 안쪽의 무엇인가가 반응하기 전에 본능적으로 손을 빼냅니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_WormWall
#. Speaker = Narrator
#. NodeID = 11b7806e-f2d0-f302-958f-91889f5d0b8f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_WormWall_State_RecognisedCrawlers = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_WormWall:11b7806e-f2d0-f302-958f-91889f5d0b8f
msgctxt "h795dfb42g1416g4d7fg8c32gcc5b5f83f721"
msgid ""
"*You recognise the odour - the foul scent of carrion crawlers, centipede-"
"like aberrations that feast on the dead.*"
msgstr "*당신은 이 고약한 냄새의 정체를 알고 있습니다. 시체를 먹는 지네 같은 괴물, 캐리온 크롤러의 악취입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_WormWall
#. Speaker = Narrator
#. NodeID = 2f85a6b6-0086-9168-446f-69a0e67c0bf8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_WormWall_State_RetrievedLoot = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_WormWall:2f85a6b6-0086-9168-446f-69a0e67c0bf8
msgctxt "h785e32a6gf525g4d22gae49g168ed4183659"
msgid "*There's nothing of value left inside the holes.*"
msgstr "*구멍 안쪽에는 가치 있는 것이 남아있지 않습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_WormWall
#. Speaker = Player
#. NodeID = 44e14279-ea60-d753-f8b3-b8bd86e5abd1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SHORT(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_WormWall:44e14279-ea60-d753-f8b3-b8bd86e5abd1
msgctxt "h4b3f5422g0000g4225g803agdf722587a7dc"
msgid "<i>Reach into one of the holes.</i>"
msgstr "<i>구멍 중 하나에 손을 뻗는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_WormWall
#. Speaker = Narrator
#. NodeID = 47907274-28aa-2dab-57c3-c62defc1d76e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_WormWall:47907274-28aa-2dab-57c3-c62defc1d76e
msgctxt "h1e4bdf8fg8fbdg452egab08g33903190eb59"
msgid ""
"*At one time, these caverns must have been their banquet hall. The creatures "
"are either long gone, or waiting patiently in the darkness.*"
msgstr ""
"*한때는 이 동굴이 그들의 연회장이었을 것으로 보입니다. 이 생명체들은 이미 오래전에 사라졌거나 어둠 속에서 인내심을 갖고 기다리고 있을 "
"겁니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_WormWall
#. Speaker = Narrator
#. NodeID = 6606c8d8-1f1d-14d8-453a-b39e0346db4f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_WormWall:6606c8d8-1f1d-14d8-453a-b39e0346db4f
msgctxt "h18a2b076gf2ecg431cgb77dge055dd695da7"
msgid ""
"*The wall is riddled with holes. A suffocating stench of long-rotten meat "
"wafts out.*"
msgstr "*벽에는 구멍이 가득합니다. 부패한 고기의 숨 막히는 악취가 진동합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_WormWall
#. Speaker = Player
#. NodeID = 786e5d76-e8b3-7647-3211-2c130355661c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 15
#. CheckFlags:
#.   Global:
#.      - UND_WormWall_State_RecognisedCrawlers = False
#.   Object:
#.      - UND_WormWall_State_FailedToRecognizeCrawlers(1) = False
#.   Tag:
#.      - REALLY_UNDERDARK(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_WormWall:786e5d76-e8b3-7647-3211-2c130355661c
msgctxt "h63df0e05gd158g4ebcg892cg9d04736700bb"
msgid "<i>Inspect the holes.</i>"
msgstr "<i>구멍을 조사한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_WormWall
#. Speaker = Player
#. NodeID = 7a19dd7d-69ee-b4b2-7b06-e18032ab2c25
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_WormWall:7a19dd7d-69ee-b4b2-7b06-e18032ab2c25
msgctxt "he9f39bc8g6293g4af5ga015g2605e95435c6"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_WormWall
#. Speaker = Narrator
#. NodeID = 972dc1f7-9cf7-4f59-b80e-e264d1090390
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_WormWall_State_RetrievedLoot = True
#.   Object:
#.     - UND_WormWall_Event_LowerGiveReward(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_WormWall:972dc1f7-9cf7-4f59-b80e-e264d1090390
msgctxt "h2510d6edg999fg48bbg92a7gdaa5176b1177"
msgid ""
"*You flinch, but the tentacle is limp and cold. You push it aside and "
"retrieve something loose, lying beneath.*"
msgstr ""
"*당신은 움찔하지만, 촉수는 생기가 없이 차갑습니다. 당신은 촉수를 한쪽으로 치우고, 그 아래 놓여있는 무언가를 손에 넣습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_WormWall
#. Speaker = Player
#. NodeID = 9e55ce79-d4c0-b26d-e505-0e468e0b827d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SHORT(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_WormWall:9e55ce79-d4c0-b26d-e505-0e468e0b827d
msgctxt "h4c319707gad4bg402eg92b0g75881f132e2b"
msgid "<i>Reach into one of the holes.</i>"
msgstr "<i>구멍 중 하나에 손을 뻗는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_WormWall
#. Speaker = Narrator
#. NodeID = ae6ee987-18ea-f655-3827-ebfbe1174702
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_WormWall_State_Scared(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_WormWall:ae6ee987-18ea-f655-3827-ebfbe1174702
msgctxt "hefc5796ag757cg40b3g8b79g120f8f62a09e"
msgid "*There's nothing but trouble inside those holes.*"
msgstr "*구멍 속에는 골칫거리 밖에는 보이지 않습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_WormWall
#. Speaker = Player
#. NodeID = b4ddcda2-d2d4-9d2c-1212-b4e84f5492c3
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 15
#. CheckFlags:
#.   Global:
#.      - UND_WormWall_State_RecognisedCrawlers = False
#.   Object:
#.      - UND_WormWall_State_FailedToRecognizeCrawlers(1) = False
#.   Tag:
#.      - REALLY_UNDERDARK(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_WormWall:b4ddcda2-d2d4-9d2c-1212-b4e84f5492c3
msgctxt "h778e602bgd027g41acga539gfbcd454c3d71"
msgid "<i>Inspect the holes.</i>"
msgstr "<i>구멍을 조사한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_WormWall
#. Speaker = Narrator
#. NodeID = cc3816dd-c3f9-9d5f-840e-36dc7d680d25
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_WormWall:cc3816dd-c3f9-9d5f-840e-36dc7d680d25
msgctxt "hfc82da17g926dg4b1fg9bdcg25f8bc48ba47"
msgid ""
"*The passage narrows and bends, becoming impassable before you're even elbow-"
"deep.*"
msgstr "*통로가 좁아지고 구부러져 팔꿈치 깊이까지 들어가기도 전에 통과할 수 없게 됩니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_WormWall
#. Speaker = Narrator
#. NodeID = d1a10185-f7c4-a442-ebc8-02285fbaee2b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - UND_WormWall_State_FailedToRecognizeCrawlers(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_WormWall:d1a10185-f7c4-a442-ebc8-02285fbaee2b
msgctxt "h78fb1bf7g5d2dg4ca8gb8e9ge9fe15259a55"
msgid ""
"*The tunnels were created deliberately, but whether by tools or claws you "
"cannot say.*"
msgstr "*땅굴은 인공적인 것이지만 도구로 만들었는지, 발톱으로 만들었는지는 알 수 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_WormWall
#. Speaker = Narrator
#. NodeID = e40f69fc-7651-1d65-46f3-1bc5e14d7f7c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_WormWall:e40f69fc-7651-1d65-46f3-1bc5e14d7f7c
msgctxt "h1fbb1abdg1c13g482bg8239g9ae33c7223fe"
msgid ""
"*The passage narrows and bends - you're shoulder-deep when your fingers "
"brush against a fleshy tentacle.*"
msgstr "*통로가 좁아지고 구부러져 어깨 깊이까지 들어가니 손가락이 살이 많은 촉수에 닿습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_AdamantineForge_AD_Adamantine
#. Speaker = Player
#. NodeID = 3aaee339-a4d2-e887-1a55-c26a85cfbed6
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_AdamantineForge_AD_Adamantine:3aaee339-a4d2-e887-1a55-c26a85cfbed6
msgctxt "h99aa2f41g5935g40a5gad70ga36375cf492d"
msgid "It is getting toasty. Surely the forge must be close."
msgstr "공기가 훈훈해지고 있어. 분명 대장간이 근처에 있을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_AdamantineForge_AD_Adamantine
#. Speaker = Player
#. NodeID = 3aaee339-a4d2-e887-1a55-c26a85cfbed6
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_AdamantineForge_AD_Adamantine:3aaee339-a4d2-e887-1a55-c26a85cfbed6
msgctxt "h8e528861g22f6g4a3fga619ge14d9060159d"
msgid "The heat's going from balmy to sweltering. The forge must be nearby."
msgstr "열기가 점점 후끈해지고 있어. 대장간이 근처에 있을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_AdamantineForge_AD_Adamantine
#. Speaker = Player
#. NodeID = 3aaee339-a4d2-e887-1a55-c26a85cfbed6
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_AdamantineForge_AD_Adamantine:3aaee339-a4d2-e887-1a55-c26a85cfbed6
msgctxt "hde4751d5g095ag4346gb58cge4657e20e0c6"
msgid "Mm, that heat feels nice. Forge must be near."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_AdamantineForge_AD_Adamantine
#. Speaker = Player
#. NodeID = 3aaee339-a4d2-e887-1a55-c26a85cfbed6
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_AdamantineForge_AD_Adamantine:3aaee339-a4d2-e887-1a55-c26a85cfbed6
msgctxt "h6a82db29g7bd7g4bb3gac5ag1186f0dd025b"
msgid "Scorching heat, flows of lava. The forge must be near."
msgstr "맹렬한 더위에, 흐르는 용암이라. 분명 대장간이 근처에 있겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_AdamantineForge_AD_Adamantine
#. Speaker = Player
#. NodeID = 3aaee339-a4d2-e887-1a55-c26a85cfbed6
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_AdamantineForge_AD_Adamantine:3aaee339-a4d2-e887-1a55-c26a85cfbed6
msgctxt "h47aa51d1gbe93g48fag8038g69d9a9a27adf"
msgid "This heat -  I can see the air shimmering. The forge must be nearby."
msgstr "이 열기 -  공기가 일렁이는 게 보여. 대장간이 근처에 있는 게 분명해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_AdamantineForge_AD_Adamantine
#. Speaker = Player
#. NodeID = 3aaee339-a4d2-e887-1a55-c26a85cfbed6
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_AdamantineForge_AD_Adamantine:3aaee339-a4d2-e887-1a55-c26a85cfbed6
msgctxt "h365b4c01gf5e6g4109gb300g4a4c2d079992"
msgid "Whew - the heat's getting to me. This forge better be close."
msgstr "휴, 뜨거워 죽겠어. 분명 대장간이 근처에 있겠는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_AdamantineForge_AD_Adamantine
#. Speaker = Player
#. NodeID = 3aaee339-a4d2-e887-1a55-c26a85cfbed6
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_AdamantineForge_AD_Adamantine:3aaee339-a4d2-e887-1a55-c26a85cfbed6
msgctxt "h2159b247g60bcg48d8g9575gb9495b6cdbf2"
msgid "Hope the forge is close by - I'm sweating from the heat."
msgstr "대장간에 가까이 온 거였으면 좋겠네, 열기 때문에 땀에 흠뻑 젖었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_ArcaneTower_PAD_Lights
#. Speaker = Player
#. NodeID = 3706dd69-6e38-a9d0-edb1-caeed62863ce
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_ArcaneTower_MainPowerOn = False
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_ArcaneTower_PAD_Lights:3706dd69-6e38-a9d0-edb1-caeed62863ce
msgctxt "h786295b7g40f7g4d06g88d2g47fe17496bc0"
msgid "A light without a wick? How are you meant to use the damn thing?"
msgstr "심지가 없는 등불이라? 이 망할 물건을 어떻게 쓰라는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_ArcaneTower_PAD_Lights
#. Speaker = Player
#. NodeID = 3706dd69-6e38-a9d0-edb1-caeed62863ce
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_ArcaneTower_MainPowerOn = False
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_ArcaneTower_PAD_Lights:3706dd69-6e38-a9d0-edb1-caeed62863ce
msgctxt "he252d2adgc0bcg49c4g8876g8db766c82a01"
msgid "These are no ordinary lights. Yet there must be a way to turn them on."
msgstr "저건 평범한 등불이 아니야. 분명 저걸 켜는 방법이 있을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_ArcaneTower_PAD_Lights
#. Speaker = Player
#. NodeID = 3706dd69-6e38-a9d0-edb1-caeed62863ce
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_ArcaneTower_MainPowerOn = False
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_ArcaneTower_PAD_Lights:3706dd69-6e38-a9d0-edb1-caeed62863ce
msgctxt "h22d4a5d5gba4eg4390gb3afg6c7fa78c07cc"
msgid "A light but no wick. Gotta be a trick here."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_ArcaneTower_PAD_Lights
#. Speaker = Player
#. NodeID = 3706dd69-6e38-a9d0-edb1-caeed62863ce
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_ArcaneTower_MainPowerOn = False
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_ArcaneTower_PAD_Lights:3706dd69-6e38-a9d0-edb1-caeed62863ce
msgctxt "h5736b762gaf03g454dg936dge1b6cca8457d"
msgid "Odd - it won't ignite."
msgstr "이상하네, 불이 붙질 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_ArcaneTower_PAD_Lights
#. Speaker = Player
#. NodeID = 3706dd69-6e38-a9d0-edb1-caeed62863ce
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_ArcaneTower_MainPowerOn = False
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_ArcaneTower_PAD_Lights:3706dd69-6e38-a9d0-edb1-caeed62863ce
msgctxt "hece9d124g4dc5g4f09ga445ga544519d14e1"
msgid "Doesn't look like I can light these... at least not by normal means."
msgstr "이걸 켤 수 있을 것 같진 않은데... 적어도 정상적인 방법으로는 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_ArcaneTower_PAD_Lights
#. Speaker = Player
#. NodeID = 3706dd69-6e38-a9d0-edb1-caeed62863ce
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_ArcaneTower_MainPowerOn = False
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_ArcaneTower_PAD_Lights:3706dd69-6e38-a9d0-edb1-caeed62863ce
msgctxt "hcd4fd9f4g742cg4671gaef5ga46f3ffc08ca"
msgid "Nothing. There must be some way to light them."
msgstr "아무 일도 없잖아. 밝힐 방법이 따로 있나 보군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_ArcaneTower_PAD_Lights
#. Speaker = Player
#. NodeID = 3706dd69-6e38-a9d0-edb1-caeed62863ce
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_ArcaneTower_MainPowerOn = False
#. TagRule: CLERIC_MYSTRA or PALADIN_MYSTRA or REALLY_HIGHELF or REALLY_HIGHHALFELF or WIZARD
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_ArcaneTower_PAD_Lights:3706dd69-6e38-a9d0-edb1-caeed62863ce
msgctxt "h5046640ag04dbg4dd3g9d41g2c58c430a924"
msgid "Magical lights. But how to turn them on?"
msgstr "마법 등불이군. 어떻게 켜는 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_ArcaneTower_PAD_Lights
#. Speaker = Player
#. NodeID = 3706dd69-6e38-a9d0-edb1-caeed62863ce
#. HandlePath = TaggedText[7].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_ArcaneTower_MainPowerOn = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_ArcaneTower_PAD_Lights:3706dd69-6e38-a9d0-edb1-caeed62863ce
msgctxt "h10cdb84fgf74ag476dg97cbg7d911e4498f2"
msgid "No way to ignite these. Strange."
msgstr "불붙일 방법이 없군. 이상한데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_ArcaneTower_PAD_Lights
#. Speaker = Player
#. NodeID = c880aa44-453f-db36-8832-301d91370680
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_ArcaneTower_MainPowerOn = True
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_ArcaneTower_PAD_Lights:c880aa44-453f-db36-8832-301d91370680
msgctxt "h6c1932a0gcb86g4345gb085g6344f55b423a"
msgid "Ah, magical light. A cute little trick."
msgstr "아, 마법 등불이군. 귀엽네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_ArcaneTower_PAD_Lights
#. Speaker = Player
#. NodeID = c880aa44-453f-db36-8832-301d91370680
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_ArcaneTower_MainPowerOn = True
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_ArcaneTower_PAD_Lights:c880aa44-453f-db36-8832-301d91370680
msgctxt "hf0e9e86ag23deg403cgb157g5d346fd3e93e"
msgid "Arcane lights. How delightful."
msgstr "비전 등불이군. 아주 멋져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_ArcaneTower_PAD_Lights
#. Speaker = Player
#. NodeID = c880aa44-453f-db36-8832-301d91370680
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_ArcaneTower_MainPowerOn = True
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_ArcaneTower_PAD_Lights:c880aa44-453f-db36-8832-301d91370680
msgctxt "hcb490e44g160ag4f9eg95ceg782343862fde"
msgid "Ooh! Magic light."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_ArcaneTower_PAD_Lights
#. Speaker = Player
#. NodeID = c880aa44-453f-db36-8832-301d91370680
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_ArcaneTower_MainPowerOn = True
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_ArcaneTower_PAD_Lights:c880aa44-453f-db36-8832-301d91370680
msgctxt "hcb72657ag002fg489agadf7gb94f1ed6659f"
msgid "Arcane illumination. Clever."
msgstr "비전 불빛이라. 기발한데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_ArcaneTower_PAD_Lights
#. Speaker = Player
#. NodeID = c880aa44-453f-db36-8832-301d91370680
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_ArcaneTower_MainPowerOn = True
#. TagRule: REALLY_SHADOWHEART
