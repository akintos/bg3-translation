msgctxt "h24097e59gaae8g4e09g873cg7b493bf4e743"
msgid "... Underdark... Menzoberranzan..."
msgstr "... 언더다크... 멘조베란잔..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander_Dead
#. Speaker = Player
#. NodeID = bc53fb33-e783-5e2c-0367-3047c749d358
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_DrowCommander_Dead_MentionedUnderdark(1) = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander_Dead:bc53fb33-e783-5e2c-0367-3047c749d358
msgctxt "h0a9a7c12g21e8g4433g841ege59c3902fae1"
msgid "Is there an entrance to the Underdark nearby?"
msgstr "언더다크로 가는 입구가 근처에 있나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander_Dead
#. Speaker = Player
#. NodeID = bded52f8-dada-ac30-e1c4-dcd35e87ccfc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander_Dead:bded52f8-dada-ac30-e1c4-dcd35e87ccfc
msgctxt "he1a2f577g8db7g47cegb9b9gba1997dfb3be"
msgid "Do you have anything valuable?"
msgstr "귀중한 것을 가지고 있나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander_Dead
#. Speaker = Player
#. NodeID = c2884232-9bde-4928-a77b-10da07d195d0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander_Dead:c2884232-9bde-4928-a77b-10da07d195d0
msgctxt "h47b9a9b1g51f1g4167g9dbcg1c5ea1878dff"
msgid "What happened to you?"
msgstr "무슨 일이 있었지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander_Dead
#. Speaker = Nightwarden Minthara
#. NodeID = c95ae563-c498-8d36-5766-ab7a7f286b24
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander_Dead:c95ae563-c498-8d36-5766-ab7a7f286b24
msgctxt "he69dbe24g5e91g4f0fg8a0eg43c461136d09"
msgid "... murdered... infidel... traitor..."
msgstr "... 살해당했어... 불신자... 배신자..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander_Dead
#. Speaker = Player
#. NodeID = e8254c58-c70d-2f27-555f-5b7dea670936
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrowCommander_Dead:e8254c58-c70d-2f27-555f-5b7dea670936
msgctxt "h3c770437gec81g458bgb5f9g3c8b1b4ff681"
msgid "Where were the prisoners taken?"
msgstr "포로들은 어디로 데려갔지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = 0159cf14-32b8-0c2b-9438-5e88a9fc4039
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_DrunkGoblin_Event_StartFistFight(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:0159cf14-32b8-0c2b-9438-5e88a9fc4039
msgctxt "h81f2138cg2fa9g411dgb48cg14a1ffec32b4"
msgid "You fiend! Bah! Gaah! I'll teach you some respect."
msgstr "이 마족 같은 놈! 악! 아악! 너에게 존중이 뭔지 가르쳐 주겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Narrator
#. NodeID = 016a140a-a7dd-29e7-1b15-06d4dd96842f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:016a140a-a7dd-29e7-1b15-06d4dd96842f
msgctxt "ha0ce9077g94bag4358gadb6gaf817ed93688"
msgid ""
"*As your lips touch filthy flesh, you catch a whiff of... lavender? It gives "
"way to the muddy taste of something better left without description.*"
msgstr ""
"*당신의 입술이 더러운 살갗에 닿자, 어떤 냄새가 풍깁니다... 라벤더 향기? 그 향기와 함께 진흙 같은 맛이 사라지며, 설명하지 않는 "
"편이 좋을 맛이 뒤따릅니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Shadowheart
#. NodeID = 01ccabd2-9599-62de-4602-43ef2902e8b1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(8) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(8) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:01ccabd2-9599-62de-4602-43ef2902e8b1
msgctxt "h418bb1bag346fg4ed3g999fg9c543e7f67e8"
msgid "That disfigurement has its benefits, it seems."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Narrator
#. NodeID = 048f9caa-08c0-f027-e457-12ee8928b93e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:048f9caa-08c0-f027-e457-12ee8928b93e
msgctxt "h04e27f25g0d63g4a7bg82cfg792839412efc"
msgid ""
"*As your lips touch the filthy flesh, you catch a whiff of... lavender?*"
msgstr "*당신의 입술이 더러운 살갗에 닿자, 어떤 냄새가 풍깁니다... 라벤더 향?*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Narrator
#. NodeID = 05435d06-5a29-87d7-6feb-8cb2a7909cfb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - GLO_TadpoleIntro_NPC(4) = False
#. SetFlags:
#.   User:
#.     - GLO_TadpoleIntro_NPC(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:05435d06-5a29-87d7-6feb-8cb2a7909cfb
msgctxt "h5c8b8df0gaa54g46f8g8163g44a728c55733"
msgid ""
"*A strange symbol glows, marked on their flesh, and something within you "
"stirs in response.*"
msgstr "*그들의 살갗에 새겨진 기묘한 상징이 빛나고, 이에 반응하여 당신 내면의 무언가가 꿈틀거립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Lae'zel
#. NodeID = 067eb1b1-6c9d-83e6-b181-5368588c43d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:067eb1b1-6c9d-83e6-b181-5368588c43d6
msgctxt "hdf66ae45g626fg44e1ga460g28480c2e2277"
msgid "Let us hope we don't see it again."
msgstr "다시는 만나지 않기를 바라자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Lae'zel
#. NodeID = 07240853-3b56-25c8-cee1-9e4202e16be1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:07240853-3b56-25c8-cee1-9e4202e16be1
msgctxt "h3dae5690g0b5bg4681gbab2gfee542e6ce6b"
msgid "Let us leave it to your imagination, shall we?"
msgstr "그건 네 상상에 맡기자고, 어때?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Lae'zel
#. NodeID = 0769e766-4902-2825-c1ee-2f91c76bff42
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:0769e766-4902-2825-c1ee-2f91c76bff42
msgctxt "ha3e9f092g2b66g4bd4g8352gafad02079d4d"
msgid "Clever. I'd congratulate you if I could bear the sight of you."
msgstr "똑똑하군. 네 면상이 조금만 더 참아줄 만했다면, 축하를 해줬을지도 모르겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = 07afcb86-52f9-f8c8-e015-819655109389
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_GoblinToast_State_RealizedPoison = True
#. TagRule: DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:07afcb86-52f9-f8c8-e015-819655109389
msgctxt "h69a86964g2fffg45a1g8290gc15350a7a03e"
msgid ""
"There's a killer on the loose. But don't worry. I'll find him and crush his "
"skull."
msgstr "살인자가 돌아다니고 있어. 하지만 걱정 마. 내가 놈을 찾아서 두개골을 박살 내줄 테니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = 07afcb86-52f9-f8c8-e015-819655109389
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_GoblinToast_State_RealizedPoison = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:07afcb86-52f9-f8c8-e015-819655109389
msgctxt "h612e4b83g77d9g4fd3ga025g01a2e2666764"
msgid ""
"There's a killer on the loose. You better run and hide - heard it's a coward "
"lookin' for weaklings."
msgstr "살인자가 돌아다니고 있어. 도망쳐서 숨는 편이 좋을 거야, 듣자 하니 약한 이들만 노리는 겁쟁이라던데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = 0922b82b-6b6a-a2ce-26e4-728dd8f3a95d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_DrunkGoblin_Knows_TrueSoul(4) = True
#.   Global:
#.     - GOB_DrunkGoblin_State_UsedPsionics = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:0922b82b-6b6a-a2ce-26e4-728dd8f3a95d
msgctxt "h6a1f310bg7748g4089g8211g26ee71c0f9b6"
msgid ""
"F-forgive me! I 'ad no idea. The other True Souls are inside, planning an' "
"such."
msgstr "요-용서해 주십쇼! 전혀 몰랐습니다. 다른 참된 영혼들께서는 안쪽에 계십니다, 계획을 세우는 중이시라더군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Player
#. NodeID = 0923f2c3-a65d-cb73-af0b-35c085410a82
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:0923f2c3-a65d-cb73-af0b-35c085410a82
msgctxt "h55fb5b7cg27fbg4da3g9e4cgc17a9fd8869a"
msgid "It wasn't too bad. Do you use perfume?"
msgstr "그렇게 나쁘진 않았어. 향수라도 쓰나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Narrator
#. NodeID = 0ac2990c-c3f9-8623-5f63-e167ca7ea8f5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount2(4) = False
#.   Tag:
#.      - TRUESOUL(4) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount2(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:0ac2990c-c3f9-8623-5f63-e167ca7ea8f5
msgctxt "h52553325g2271g4031gb16fg667983a9ca48"
msgid ""
"*Something stirs deep within you, hungry and alert... it's taking something "
"you'll never get back.*"
msgstr "*몸 깊숙한 데서 굶주리고 기민한 존재가 꿈틀댑니다... 잃으면 되찾지 못할 뭔가를 좀먹고 있군요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Wyll
#. NodeID = 0b5f2427-e705-13eb-a315-2052559647c9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(9) = True
#.   Tag:
#.      - REALLY_WYLL(9) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:0b5f2427-e705-13eb-a315-2052559647c9
msgctxt "h2c64ee5eg06f4g4688gbc63gfdce24e4b2d8"
msgid "Gone gods, that was so foul I think even <i>I</i> can taste it."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = 0c3388c3-7171-075a-8525-750339f382cb
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_DrunkGoblin_HasMet(4) = True
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:0c3388c3-7171-075a-8525-750339f382cb
msgctxt "h59331fb1g40c5g4feeg8b2egc0adf06caef9"
msgid "What're you tryin' to pull? You tryin' to get in my head? I'll kill ya!"
msgstr "뭔 수작을 부리려는 거야? 내 머릿속에 들어가기라고 하려는 거냐? 죽여버리겠어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Player
#. NodeID = 0cd91664-edc4-052c-98ae-1df3c23b54be
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:0cd91664-edc4-052c-98ae-1df3c23b54be
msgctxt "hb9df69e0g7762g4c1cg8dd4ga5ac8c9ddb28"
msgid "<i>Grab his foot and lick it.</i>"
msgstr "<i>그의 발을 붙잡고 핥는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = 0cf98ae9-3d36-713d-afe1-6a8b6bde101a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:0cf98ae9-3d36-713d-afe1-6a8b6bde101a
msgctxt "hc76608e6gec68g422fg8e52ge7a9f1a51a97"
msgid "Right. An' I'm a knobbly green dragon. We ain't stupid, ya know."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = 0f014a17-5e59-e373-ccd4-8c6aec5a27c1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Absolute_Knows_GoblinsWorship = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:0f014a17-5e59-e373-ccd4-8c6aec5a27c1
msgctxt "h4f0a582cg60e9g44c7g8337g883c4fa9625a"
msgid "Well, not us. Things're changin'. We got the Absolute on our side now."
msgstr "글쎄, 우린 아니야. 상황이 바뀌고 있어. 이제 우리 편에 절대자님이 생겼으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Narrator
#. NodeID = 0fa8e424-40d3-6e13-c542-71b809204aef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:0fa8e424-40d3-6e13-c542-71b809204aef
msgctxt "ha3d34243gb1d1g48e8g9b8dg479fadeba1b0"
msgid ""
"*The toe itself tastes of curd cave-aged, with thick helpings of rancid "
"gristle.*"
msgstr "*당신의 입에 들어온 발가락은 썩은 연골의 두툼한 식감과 함께, 동굴에서 숙성된 커드 맛이 납니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = 0fd6924c-23ab-5338-7047-202b41ee7358
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_DrunkGoblin_Knows_TrueSoul(4) = True
#.   Global:
#.      - GOB_GoblinToast_State_RealizedPoison = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:0fd6924c-23ab-5338-7047-202b41ee7358
msgctxt "hf35679abg8083g41e0gb42egf6e74f58b5a8"
msgid ""
"There's a killer on the loose. But don't worry. I'll find him and crush his "
"skull."
msgstr "살인자가 돌아다니고 있어. 하지만 걱정 마. 내가 놈을 찾아서 두개골을 박살 내줄 테니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Narrator
#. NodeID = 10b7d79c-6d61-210d-b48b-a9680f50ee30
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:10b7d79c-6d61-210d-b48b-a9680f50ee30
msgctxt "h11c8014bg8524g43e6g9793g48c7532e0bfe"
msgid ""
"*Acrid sand grinds beneath your teeth as you try to snag the ring. The "
"goblin jerks back his foot.*"
msgstr "*반지를 빼는 중 매캐한 모래 먼지가 날리며 이빨에 달라붙습니다. 고블린이 발을 뒤로 빼버렸습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Player
#. NodeID = 11a44081-9ac8-26f1-ba71-0ccd6b8eadad
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BRANDED(4) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:11a44081-9ac8-26f1-ba71-0ccd6b8eadad
msgctxt "h8017be36gb964g4e35g8c6eg0e740db3a679"
msgid "You can't be serious."
msgstr "설마 진심은 아니겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = 11cf752f-c86b-6896-abfd-385da96df494
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_Checkpoint_State_Paint(4) = True
#. SetFlags:
#.   Dialog:
#.     - GOB_DrunkGoblin_AskedToKiss(4) = True
#. TagRule: GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:11cf752f-c86b-6896-abfd-385da96df494
msgctxt "h6900190egddcbg435dgbbc4g617fb2731296"
msgid "Or I'll kick yer dirty head in, slug-face."
msgstr "아니면 네 더러운 대가리를 걷어차 주마, 달팽이 면상아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = 11cf752f-c86b-6896-abfd-385da96df494
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_Checkpoint_State_Paint(4) = True
#. SetFlags:
#.   Dialog:
#.     - GOB_DrunkGoblin_AskedToKiss(4) = True
#. TagRule: TIEFLING
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:11cf752f-c86b-6896-abfd-385da96df494
msgctxt "hd10ee14agf179g426dgbf48g34dbdeb79a44"
msgid "Or I'll kick yer dirty head in, horn-face."
msgstr "아니면 네 더러운 대가리를 걷어차 주마, 뿔 면상아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = 11cf752f-c86b-6896-abfd-385da96df494
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_Checkpoint_State_Paint(4) = True
#. SetFlags:
#.   Dialog:
#.     - GOB_DrunkGoblin_AskedToKiss(4) = True
#. TagRule: DWARF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:11cf752f-c86b-6896-abfd-385da96df494
msgctxt "h0c307d86g8265g40abgad50gd54b779f2fbf"
msgid "Or I'll wipe that nasty look off yer dirty face, thick-skull."
msgstr "안 그럼 너의 두꺼운 머리통, 더러운 면상에서 그 재수 없는 표정을 씻어내주겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = 11cf752f-c86b-6896-abfd-385da96df494
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_Checkpoint_State_Paint(4) = True
#. SetFlags:
#.   Dialog:
#.     - GOB_DrunkGoblin_AskedToKiss(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:11cf752f-c86b-6896-abfd-385da96df494
msgctxt "hed5883d0ga230g494bg9330g533df08c82ef"
msgid "Or I'll wipe that nasty look right off yer dirty face."
msgstr "안 그럼 너의 더러운 면상에서 그 재수 없는 표정을 씻어내주겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Player
#. NodeID = 1a4ce866-9554-19f2-b18c-f67c2098e276
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_DrunkGoblin_Event_KissedGoblinFeet(4) = True
#.     - GOB_DrunkGoblin_Event_KissedFeet(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:1a4ce866-9554-19f2-b18c-f67c2098e276
msgctxt "ha874f9fdg3e81g4d52g9f18g0d8f412ee719"
msgid "<i>Kiss his foot and get it over with.</i>"
msgstr "<i>금방 그의 발에 입을 맞추고 넘어간다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Narrator
#. NodeID = 1e5a1175-f97a-c9ad-b1c7-8627cd477d20
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount6(4) = False
#.   Tag:
#.      - TRUESOUL(4) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount6(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:1e5a1175-f97a-c9ad-b1c7-8627cd477d20
msgctxt "hb2068e1dgd321g4381gadaag6d63f0194ea5"
msgid ""
"*The presence deep in your mind is awake, unblinking. This is it. A single "
"word pervades your consciousness: 'Soon'.*"
msgstr ""
"*당신의 정신 속 깊이 자리잡은 존재가 태연스레 깨어납니다. 올 것이 왔군요. 한 단어가 당신의 의식 속으로 스며듭니다. ‘곧’*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = 2021bc49-1647-3e31-df9f-c55b7876fe4b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_GroveConflict_Quest_Learnt3LeadersNoName = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:2021bc49-1647-3e31-df9f-c55b7876fe4b
msgctxt "hf584c087g9a14g41dfg8d56g12420d99d3c8"
msgid ""
"<i>I'll kick out that annoyin' hobgoblin. The priestess an' drow, too. An' "
"everyone'll have t'obey me.</i>"
msgstr ""
"<i>그 짜증 나는 홉고블린 자식을 내쫓아 주겠어. 여사제랑 드로우도 말이야. 누구든 내게 복종하지 않는 이는 쫓아버려야지.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = 20ef9367-2400-69d8-1582-60fedc939cce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:20ef9367-2400-69d8-1582-60fedc939cce
msgctxt "he1c56f27g7fd9g4ecdg9173gffbd63de9713"
msgid "I'll bash that smile in."
msgstr "내가 그 미소를 때려 부숴주마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Player
#. NodeID = 21f26b1f-e62f-ba9e-b6ac-1c495c8a90cb
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_DrunkGoblin_Event_MoveToSecludedPlace(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:21f26b1f-e62f-ba9e-b6ac-1c495c8a90cb
msgctxt "h19d8be54gd2d3g4f7cga634g83d20d0b04a0"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = 223aabcc-3215-abb9-2b83-e3dbbcb3ebb0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:223aabcc-3215-abb9-2b83-e3dbbcb3ebb0
msgctxt "h24bbdcdag1319g4e61gb88eg8e3e18f5c6f5"
msgid "Think ya can mess with me, huh? Think yer bein' funny?"
msgstr "날 갖고 놀 수 있을 거라고 생각하나? 스스로가 재밌다고 생각해?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = 232649f9-883c-937c-105a-e663f213fb29
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_DrunkGoblin_Event_AtSecludedPlace(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:232649f9-883c-937c-105a-e663f213fb29
msgctxt "h282f1c6cg752fg481cga0ccgfca9fdc74a79"
msgid "You following me? Get lost."
msgstr "날 따라다니는 거냐? 저리 꺼져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Player
#. NodeID = 2496e2c1-f5e1-42c5-afbc-b09fbc001490
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:2496e2c1-f5e1-42c5-afbc-b09fbc001490
msgctxt "hbd4d7063g0475g4e3cgbd82g4f2b45f98184"
msgid "<b>FOOT. KISS. NOW!</b>"
msgstr "<b>발에. 키스해. 당장!</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
#. NodeID = 28342840-f121-88fa-df66-7c2d434cf42a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:28342840-f121-88fa-df66-7c2d434cf42a
msgctxt "h899004a4g6e75g4be7g94bag0edac9facbcb"
msgid "What're you on about? Think yer bein' funny?"
msgstr "뭐라는 거야? 스스로가 재밌다고 생각하냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Player
#. NodeID = 2aaa315a-db0e-543a-d40f-f620af3efada
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin:2aaa315a-db0e-543a-d40f-f620af3efada
msgctxt "h9060dcaegcd41g4fdcg9e6egebb5c25cd83e"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Player
#. NodeID = 2dbffd23-fb04-fa33-ac57-c8c443cf7d68
