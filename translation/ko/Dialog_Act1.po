msgid ""
"Urh...  <i>drow</i>. No hurt me, goblin-master. Me good. Me kill for you."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeWorg1
#. Speaker = Worg
