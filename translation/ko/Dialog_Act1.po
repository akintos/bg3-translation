msgctxt "hac624d3dg8167g48e6g9d70g44802fc5150c"
msgid "Why were you in the basement?"
msgstr "지하실에는 왜 있었나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_TollCollector001_Dead
#. Speaker = Dead Toll Collector
#. NodeID = c50edcea-db3a-fa67-5200-0fae64fcfe40
