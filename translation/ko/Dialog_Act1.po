msgctxt "h6f0d3e46ge75bg4c19gbc8fg2e1a4c646db1"
msgid "Odd symbol. What does it mean?"
msgstr "이상한 상징이군. 무슨 뜻이지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HarperSpy_PAD_FoundRune
#. Speaker = Player
#. NodeID = 9755bd82-91ad-45e1-a00e-2bc54937bf9a
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HarperSpy_PAD_FoundRune:9755bd82-91ad-45e1-a00e-2bc54937bf9a
msgctxt "h4b6718c6gb072g495dga65fg4da6d5affae5"
msgid "I've seen markings like this before. But I can't quite place where."
msgstr "이것과 비슷하게 생긴 표시를 전에 본 적이 있어. 어디서 봤던 건지는 잘 기억나지 않는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HarperSpy_PAD_FoundRune
#. Speaker = Player
#. NodeID = 9755bd82-91ad-45e1-a00e-2bc54937bf9a
#. HandlePath = TaggedText[6].TagText[0]
