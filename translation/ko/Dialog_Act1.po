#.     - PLA_DoubtingArtist_Knows_CanGetPortrait(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03:3829b176-dc56-9e1a-1722-d39210bad5a1
msgctxt "ha5daf0a1ge08ag41dega3a8gfc1de04198b8"
msgid ""
"If you have the gold, my pet artist will make you a most heroical likeness."
msgstr "금화만 있으시다면, 제 애완 예술가가 당신의 영웅적인 모습을 그려드릴 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03
#. Speaker = Brem
#. NodeID = 3bf13ec4-4692-17b3-b0c7-30525394d401
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_ZhentDungeon_Zhent03_HasMet(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03:3bf13ec4-4692-17b3-b0c7-30525394d401
msgctxt "h73e20eb3g218cg4b2cga78dg472c75d0bc04"
msgid "Something I can help you with?"
msgstr "제가 도와드릴 것이라도 있습니까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03
#. Speaker = Brem
#. NodeID = 3c3df514-5916-81eb-5e3d-06c70e02c719
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03:3c3df514-5916-81eb-5e3d-06c70e02c719
msgctxt "h198702e4g87a8g4976gbaeeg4da3d5e16747"
msgid ""
"Go on, then - but don't kill him here. He's going to be a bleater, I know it."
msgstr "그럼, 가세요. 하지만 여기서 죽이진 말아 주시죠. 보나 마나 시끄럽게 울어댈 게 뻔하니 말입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03
#. Speaker = Player
#. NodeID = 3e85d31a-83b6-cce0-3111-4ccebff887a1
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - ROGUE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03:3e85d31a-83b6-cce0-3111-4ccebff887a1
msgctxt "he576f2d4g6923g459dgae30gcaa36073641b"
msgid "Art's more valuable once the creator is dead. I can arrange that."
msgstr "예술이란 창작자가 죽고 나서 더 가치가 오르는 법이지. 내가 처리할 수 있을 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03
#. Speaker = Brem
#. NodeID = 3f6c69d5-9ef2-b7ef-03a4-b64431b4ba92
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03:3f6c69d5-9ef2-b7ef-03a4-b64431b4ba92
msgctxt "hefdfa212gcb33g42b1ga00fg5bc20f45d168"
msgid "You looking to buy him? I'm open to offers, mate. Threats, not so much."
msgstr "그를 사고 싶으신가요? 제안은 환영입니다, 친구. 그렇지만 협박은 안 돼요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03
#. Speaker = Player
#. NodeID = 433f9003-4e3b-b229-a067-68b00ec02b4b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Quest:
#.      - GLO_DoubtingArtist.ZhentDungeon_MeetArtist(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03:433f9003-4e3b-b229-a067-68b00ec02b4b
msgctxt "hd0f573d4g6253g43efga413gc4b38e684645"
msgid "He's not a pet, he's a prisoner - let him go."
msgstr "그는 애완동물이 아니라 인질이야. 그를 풀어줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03
#. Speaker = Brem
#. NodeID = 443a989f-ea46-70e2-ed0a-01f6f35033d5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03:443a989f-ea46-70e2-ed0a-01f6f35033d5
#, fuzzy
msgctxt "h53736c2fgaa91g416fg8905ga61f423e76e0"
msgid ""
"Can't show you the <i>good</i> stuff 'til Zarys gives the say-so, mind. "
"Friends of the Zhent only."
msgstr "자리스가 허락하기 전까지는 <i>좋은</i> 것들을 보여드릴 수 없습니다. 젠트의 친구들만 볼 수 있거든요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03
#. Speaker = Brem
#. NodeID = 47c2ede6-fd0e-e47b-212f-0c7b4e7faeb4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_DoubtingArtist_Event_FreedByPersuade = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03:47c2ede6-fd0e-e47b-212f-0c7b4e7faeb4
msgctxt "hcce4c750g41d8g41b7g9de0ge3ca9d870c03"
msgid "Hey - I was just looking to make a little coin. Ain't after a mess."
msgstr "이봐요, 난 그냥 돈을 좀 벌려고 했던 것뿐이에요. 난장판을 만들려는 게 아니라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03
#. Speaker = Player
#. NodeID = 4a106912-0652-748e-4388-0113c518b298
#. HandlePath = TaggedText[0].TagText[0]
