#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_MagicMouthKnowledgeCheck:2420c80f-d697-492d-bac6-7c31ebddded4
msgctxt "hd1d4cb51g9925g494bg854bgffd553fd1171"
msgid "Talking statues are never a good sign."
msgstr "말하는 동상은 절대 좋은 징조가 아니지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Lance_PAD_MagicMouthKnowledgeCheck
