msgctxt "hb5d5e78ag56fbg4660gb7cfg0c36c179afea"
msgid "Please, it can't be true."
msgstr "제발, 그럴 수는 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_Freed
#. Speaker = Player
#. NodeID = 0287ddf4-53b1-52c3-eb93-4f9e8bc95913
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - PLA_StuckHalfElf_State_HasDowry(1) = True
