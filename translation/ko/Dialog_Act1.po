msgctxt "h547261dag807bg4858gbb6fg85697b1a1b89"
msgid "*Chitter.*"
msgstr "*찍찍*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RatRacket_LocalRat_001
#. Speaker = Narrator
#. NodeID = 4f8bf314-7b34-97f6-b468-0fe5ab6e62fa
