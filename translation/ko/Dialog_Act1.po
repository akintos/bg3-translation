msgctxt "hb7b5344fg259bg4ff2g91a1g72ed15433cf2"
msgid "<i>Explore her memories, seeking a nearby target for the hunger.</i>"
msgstr "<i>그녀의 기억을 살펴, 굶주림의 대상을 찾는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ConflictedFlind_Flind
