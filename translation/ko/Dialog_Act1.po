msgctxt "h6847ca5bg0593g4974gb319g2129643db4bd"
msgid "I said you have... a fearsome face."
msgstr "네 얼굴이... 무시무시하다는 말이었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Crusher
