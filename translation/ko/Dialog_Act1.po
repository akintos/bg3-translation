#.   Tag:
#.      - BARBARIAN(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap:a68cd0bc-5e6b-2d9e-858e-e94ff2e42d0a
msgctxt "h9b1f9c15g7935g41b4g93b4gfbd6f3a0e506"
msgid "Dead of boredom listening to <b>you</b>, pipsqueak."
msgstr "<b>네</b> 이야기를 듣느라 지겨워 뒤지겠다, 이 볼품없는 새끼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap
#. Speaker = Zarys
#. NodeID = a85e7293-824c-3e35-b106-15f061d86ac3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_ImpersonatedPereghost = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap:a85e7293-824c-3e35-b106-15f061d86ac3
msgctxt "h0152876dgb55ag41aaga133g1992b9c0c39f"
msgid "No matter <i>who </i>you are."
msgstr "네가 <i>누구든 </i>상관없이."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap
#. Speaker = Zarys
#. NodeID = b1244094-0232-d43b-0eb3-b83ff3f725c7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_ImpersonatedPereghost = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap:b1244094-0232-d43b-0eb3-b83ff3f725c7
msgctxt "he0f0c3bfge322g44bega466g680e0cecc0cd"
msgid ""
"Which <i>you </i>should've known. That is, if you'd done your research "
"before impersonating one of us."
msgstr "그 정도는<i>네가</i> 알고 있었어야지. 우리 중의 누군가를 가장하려면 연구 정도는 하란 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap
#. Speaker = Player
#. NodeID = b774f2b1-7c54-e7dd-e356-5d88dc1ddcc1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap:b774f2b1-7c54-e7dd-e356-5d88dc1ddcc1
msgctxt "hdc0e3964g0172g44b2g8c91g879f6b700ec1"
msgid "Can we just skip to the killing?"
msgstr "그냥 죽이는 단계로 바로 갈까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap
#. Speaker = Narrator
#. NodeID = babcc636-0563-4e4f-5835-cfeab1ec9db6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap:babcc636-0563-4e4f-5835-cfeab1ec9db6
msgctxt "ha1370ba7gb75dg4180gbd57gd00c96615881"
msgid "*You recall an old Zhentarim proverb coined by their founder.*"
msgstr "*당신은 젠타림의 창립자가 지은 오래된 젠타림 격언을 떠올립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap
#. Speaker = Player
#. NodeID = bb54fabb-01e1-d92b-5e20-5c6a0714587c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 53417497-b23e-58b7-dba9-bc64b80dd196_MadeSpotCheck = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap:bb54fabb-01e1-d92b-5e20-5c6a0714587c
msgctxt "h493548b7ga897g4291gaa17g6a93b8b08da5"
msgid "Those explosives are sensitive - be a shame if something set them off."
msgstr "그 폭발물들은 민감해 - 만약 뭔가가 그걸 폭파시킨다면 부끄러운 줄 알아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap
#. Speaker = Player
#. NodeID = be04b1a0-1b0a-bf0e-1b26-654ccb0648e3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_ChestUnlocked = False
#.   Object:
#.      - PLA_ZhentShipment_State_HasShipment(2) = False
#. SetFlags:
#.   Global:
#.     - PLA_ZhentShipment_State_SaidChestLost = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap:be04b1a0-1b0a-bf0e-1b26-654ccb0648e3
msgctxt "hb0da03c4gcf6ag478ag8574g1e84e28a958c"
msgid "Small problem - I don't actually have the cargo."
msgstr "작은 문제인데 - 사실 나한테는 물건이 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap
#. Speaker = Player
#. NodeID = caa9af24-8b54-8031-c4f0-9ddf3c8eeaf6
#. HandlePath = RollAdvantageReason
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 20
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_ImpersonatedPereghost = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap:caa9af24-8b54-8031-c4f0-9ddf3c8eeaf6
msgctxt "hfcccff96g9693g4643g9fb7gc4fc0f8e8782"
msgid "You're an unreliable source"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap
#. Speaker = Player
#. NodeID = caa9af24-8b54-8031-c4f0-9ddf3c8eeaf6
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 20
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_ImpersonatedPereghost = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap:caa9af24-8b54-8031-c4f0-9ddf3c8eeaf6
msgctxt "h59d89112g83bfg4fefg9525g5dc88e64ec8f"
msgid "I'm going to walk out of here alive. Play it right, and so will you."
msgstr "나는 살아서 여기를 빠져나갈 것이다. 잘 처신하면, 너도 살 수 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap
#. Speaker = Zarys
#. NodeID = ce2f5d3d-cd9d-c0e8-7a8f-3b12654c8474
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap:ce2f5d3d-cd9d-c0e8-7a8f-3b12654c8474
msgctxt "h15142f4bgd06eg41e8gb251g3ad6451ce8ee"
msgid "No final plea? Good - reckon I've heard enough of those today."
msgstr "최후변론 없어? 좋아 - 오늘 그것들을 충분히 들은 것 같거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap
#. Speaker = Player
#. NodeID = cf0e8539-c78e-408b-b60e-354967e2dfa6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap:cf0e8539-c78e-408b-b60e-354967e2dfa6
msgctxt "h15f3b44dgb046g4a90g975bgbd343f320047"
msgid "I won't do that."
msgstr "그런 짓은 하지 않겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap
#. Speaker = Zarys
#. NodeID = d95a395a-dcc8-2fc0-96dc-69a4cdf50c44
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_ZhentDungeon_State_Agent_001_ReadyForExecution = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap:d95a395a-dcc8-2fc0-96dc-69a4cdf50c44
msgctxt "h8b7c2c24g73f4g4f12ga9e1g24d42eb32a7f"
msgid "And just like that, everyone profits."
msgstr "게다가 갑자기, 모두가 이익이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap
#. Speaker = Zarys
#. NodeID = ddd51b9b-4051-c234-c75d-aca31ee350c9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - HUMAN(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap:ddd51b9b-4051-c234-c75d-aca31ee350c9
msgctxt "h1badb7ecg2961g4cd3g8665g622889380b01"
msgid "No. Olly didn't remember either, did you Olly?"
msgstr "아니. 올리도 기억 못해, 그렇지 올리?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap
#. Speaker = Player
#. NodeID = de32d47d-42f9-172d-90be-fb459413ea3c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_ImpersonatedPereghost = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap:de32d47d-42f9-172d-90be-fb459413ea3c
msgctxt "h17d4d0abg6198g48a7g89a9g3b961e497441"
msgid "I've already shown I've got more wits than Rugan. Let's work together."
msgstr "나는 이미 루간보다 약삭빠른 모습을 보여줬어. 함께 일하자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap
#. Speaker = Zarys
#. NodeID = df779b9b-ef2b-a575-e3e8-e76aaf5304ab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap:df779b9b-ef2b-a575-e3e8-e76aaf5304ab
msgctxt "hd688c749gb68bg4523ga78dg3eadab0262a9"
msgid ""
"Hah! The silver tongue on you. Usually I'd rip it out, but... well, these "
"aren't normal times."
msgstr "하! 혀놀림이 상당하네. 평소 같으면 뜯어버렸을 텐데... 지금은 평상시가 아니지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap
#. Speaker = Zarys
#. NodeID = f84c2090-cf6c-9811-7e4f-a91c41513f59
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap:f84c2090-cf6c-9811-7e4f-a91c41513f59
msgctxt "hdbd2a671gc22bg4235gb1ccga83254947342"
msgid "You're dead the moment you steal from the Zhentarim."
msgstr "젠타림으로부터 물건을 훔치는 순간 너는 죽은 목숨이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap
#. Speaker = Player
#. NodeID = fc81f284-980b-6c1d-fc1e-ab38b43c13d4
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_EVIL or PALADIN_EVIL
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap:fc81f284-980b-6c1d-fc1e-ab38b43c13d4
msgctxt "h6ca6155bg89e9g46b4ga406g8b89ec26df32"
msgid "Gladly."
msgstr "기꺼이."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap
#. Speaker = Player
#. NodeID = fc81f284-980b-6c1d-fc1e-ab38b43c13d4
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap:fc81f284-980b-6c1d-fc1e-ab38b43c13d4
msgctxt "h0e2acda7gada7g4517ga3e8gf48302b87af8"
msgid "<i>Obey - kill Rugan.</i>"
msgstr "<i>복종한다. 루간을 죽인다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap
#. Speaker = Zarys
#. NodeID = fd2633f3-a592-cd4f-b22c-917eeb0f329a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Trap:fd2633f3-a592-cd4f-b22c-917eeb0f329a
msgctxt "h05bcd8a8g760dg4cf7gaa65g15680b25f398"
msgid ""
"Hah - the fire in you! Maybe we wouldn't be here if Rugan had a little of "
"that, eh?"
msgstr "하 - 너의 내면에는 불이 있군! 루간에게도 그런 게 조금이라도 있었다면, 우리가 이 지경에 이르지도 않았을 거야, 그치?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03
#. Speaker = Brem
#. NodeID = 0c44163d-dcc3-f596-5342-329ba3d9ced7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03:0c44163d-dcc3-f596-5342-329ba3d9ced7
msgctxt "h3c5f0abfg32c2g43eega06ag32a40365daa0"
msgid "But... aye. Might be we've drawn enough attention to this place."
msgstr "하지만... 그렇군요. 우리가 이 장소에 너무 이목을 모으고 있는 걸지도요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03
#. Speaker = Brem
#. NodeID = 0c58d6e7-aca0-b3b8-77b9-90d311b06a76
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03:0c58d6e7-aca0-b3b8-77b9-90d311b06a76
msgctxt "haa9a94bdga6beg47aegba23g9111cfd750b4"
msgid "But we've gabbed enough. You got something to trade or what?"
msgstr "이만하면 충분히 떠든 것 같은데. 교환할 게 있는 거야, 뭐야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03
#. Speaker = Brem
#. NodeID = 0d809cd6-d036-f212-05ab-e10fea3d87d3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03:0d809cd6-d036-f212-05ab-e10fea3d87d3
msgctxt "h081f556fg1a3bg4e93gb690g9ada21c325e8"
msgid ""
"Oh? More steel than the entire Zhentarim? Cos that's who you're crossing if "
"you try to scab me on a deal."
msgstr "오? 젠타림 전체보다 무기가 많으신가요? 왜냐면 제게 거래를 강요하면 상대하게 되실 테니까요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03
#. Speaker = Player
#. NodeID = 0df5bf4e-e681-539b-b90c-92b576396fe4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03:0df5bf4e-e681-539b-b90c-92b576396fe4
msgctxt "h34995c48g96ebg4eddga137g912c29c4f054"
msgid "Sounds fair. I'll take a portrait, then."
msgstr "공정한 것 같군. 그럼 초상화를 하나 주문하겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03
#. Speaker = Brem
#. NodeID = 0eec1504-6c1a-2150-7bac-95d8ef357aad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03:0eec1504-6c1a-2150-7bac-95d8ef357aad
msgctxt "h73034636g7ee5g4fd5gb3e8gb9f86b9a7201"
msgid ""
"All right mate, <i>all right.</i> Waukeen's clipped coins, there's no need "
"to get arsey.<i> </i>"
msgstr "알겠습니다, 친구. <i>알았어요.</i> 맙소사, 그렇게 거칠게 나올 필요는 없잖아요.<i> </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03
#. Speaker = Brem
#. NodeID = 0f276dd3-3258-97ce-9bf2-44881719421d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_DoubtingArtist_Event_FreedByPersuade = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03:0f276dd3-3258-97ce-9bf2-44881719421d
msgctxt "h35139698g1306g48b8gb3d7g23e73180b827"
msgid ""
"These artsy tossers always have friends in high places. That's why they're "
"valuable."
msgstr "이런 예술적인 멍청이들은 언제나 고위층 친구를 두고 있기 마련입니다. 그렇기 때문에 가치가 있는 거죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03
#. Speaker = Brem
#. NodeID = 1126c386-c311-6348-ad57-35ca393238e3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - PLA_ZhentDungeon_Zhent03_FailedPersuade(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03:1126c386-c311-6348-ad57-35ca393238e3
msgctxt "h1ac588c5g1cb5g4171g97e1g39d7b030eeaa"
msgid ""
"Counter-offer. Come back with coin, and I'll pretend you're as scary as you "
"think you are."
msgstr "역제안을 드리죠. 돈을 가지고 돌아오시면, 제가 겁먹은 척을 해드리겠습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03
#. Speaker = Brem
#. NodeID = 113aca9a-331a-bc10-9bad-267c4868f5e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03:113aca9a-331a-bc10-9bad-267c4868f5e6
msgctxt "h7c29f8dcgf0b7g4f41g90aeg7177ed144406"
msgid ""
"Then what? You going to kill the entire Zhentarim next? Good luck, prick."
msgstr "그다음엔? 젠타림 전체를 다 죽여버리실 겁니까? 행운을 빌죠, 등신아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03
#. Speaker = Brem
#. NodeID = 116a71b8-b290-1f47-eed1-130280755dc3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_DoubtingArtist_Event_FreedByPersuade = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03:116a71b8-b290-1f47-eed1-130280755dc3
msgctxt "h021bd3bcg3871g4d57ga2d0ga7ce25e50f98"
msgid "All right mate, all right - no need to get arsey about it."
msgstr "좋아요 친구, 알았어요. 그렇게 공격적으로 나올 필요는 없잖습니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03
#. Speaker = Brem
#. NodeID = 13f1ad0f-61a1-0a0a-159f-ae6d166e9a8a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03:13f1ad0f-61a1-0a0a-159f-ae6d166e9a8a
msgctxt "h5569a9f6g70f6g43cfg9da0g59ae9d83c1cd"
msgid ""
"Take the moany bastard, if he means that much to ya. Doubt his crap would "
"sell anyway."
msgstr "그 징징거리는 자식이 당신에게 그렇게 중요하다면 데려가세요. 어차피 어떻게든 팔아버릴 형편없는 놈이었으니까요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03
#. Speaker = Player
