#. SetFlags:
#.   Dialog:
#.     - FOR_PriestOfTheConqueringGod_Cultists_TrueSoulPowersUsed(3) = True
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:f75e9433-0d85-de1c-d7f6-fa2f7cbfe733
msgctxt "hee709676gb5d5g457dgaeddgdaedc32f95c9"
msgid "I will go where I wish."
msgstr "난 내가 가고 싶은 데로 간다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Andrick
#. NodeID = f8746322-73cb-f44e-fee6-9a0a9ded8d61
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:f8746322-73cb-f44e-fee6-9a0a9ded8d61
msgctxt "hbb810be3gefc4g4531gaf14g766020c292a5"
msgid ""
"We managed to drag him away, but the beast's claws had already done their "
"work."
msgstr "그를 데리고 빠져나오는 데에는 성공했지만, 이미 그 짐승의 발톱이 할 일을 다한 상태였어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Brynna
#. NodeID = f8e906ed-862e-12ed-c6cf-be137b9036af
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:f8e906ed-862e-12ed-c6cf-be137b9036af
msgctxt "hd21d625ag215eg41e5ga70fga3891b00d955"
msgid "Brother - your sword!"
msgstr "동생아, 칼을 들어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Brynna
#. NodeID = f9ab381b-e299-9218-0dcf-dc0ee553e1bd
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:f9ab381b-e299-9218-0dcf-dc0ee553e1bd
msgctxt "h9c80ece7g5374g48bdgaba2ge330c616d4d7"
msgid "He might be a bandit."
msgstr "강도일지도 몰라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Brynna
#. NodeID = f9ab381b-e299-9218-0dcf-dc0ee553e1bd
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:f9ab381b-e299-9218-0dcf-dc0ee553e1bd
msgctxt "h83024f35g2d77g4dd9g93ebg6c4587dfaeaa"
msgid "She might be a bandit."
msgstr "강도일지도 몰라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists
#. Speaker = Brynna
#. NodeID = f9ab381b-e299-9218-0dcf-dc0ee553e1bd
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultists:f9ab381b-e299-9218-0dcf-dc0ee553e1bd
msgctxt "h93b07f9bgfea5g4680g8541g598bfdbd9350"
msgid "They might be a bandit."
msgstr "강도일지도 몰라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_AD_Cultists
#. Speaker = Brynna
#. NodeID = 09badf51-6fd9-4f62-0806-04c2d71a3440
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 58fe77ad-6dc9-1490-efe3-f761708d1951_Varaint2 = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_AD_Cultists:09badf51-6fd9-4f62-0806-04c2d71a3440
msgctxt "h79a44ab2g86d1g4ba6gbcccg26ec1d6c32fb"
msgid "Hang on, Ed. You're going to be all right."
msgstr "기다려, 에드. 모두 괜찮아질 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_AD_Cultists
#. Speaker = Brynna
#. NodeID = 10bf9577-7139-b5bf-86b8-6e6f87cbac87
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_AD_Cultists:10bf9577-7139-b5bf-86b8-6e6f87cbac87
msgctxt "hfae9216bg9216g40acgb47fgfedae489064c"
msgid "Stop it. You're scaring him."
msgstr "그만해. 겁주고 있잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_AD_Cultists
#. Speaker = Brynna
#. NodeID = 225f6138-2792-39dc-6681-9d50eaee7ff7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_AD_Cultists:225f6138-2792-39dc-6681-9d50eaee7ff7
msgctxt "h8e5a07f6g656dg4a47gae5fg02017ad0fe77"
msgid "Press the wound. Not like that!"
msgstr "상처를 눌러. 그렇게 말고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_AD_Cultists
#. Speaker = Andrick
#. NodeID = 4856ea2e-af1e-7350-0d39-fb7adfbd7499
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 58fe77ad-6dc9-1490-efe3-f761708d1951_Variant3 = False
#.     - 58fe77ad-6dc9-1490-efe3-f761708d1951_Varaint2 = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_AD_Cultists:4856ea2e-af1e-7350-0d39-fb7adfbd7499
msgctxt "hda263f3egad8cg4bb5g9463gca98430aa89a"
msgid "Shite."
msgstr "젠장."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_AD_Cultists
#. Speaker = Andrick
#. NodeID = 4da4e185-9c78-6fdd-296f-1b0a762beb59
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 58fe77ad-6dc9-1490-efe3-f761708d1951_Variant3 = False
#.      - 58fe77ad-6dc9-1490-efe3-f761708d1951_Varaint2 = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_AD_Cultists:4da4e185-9c78-6fdd-296f-1b0a762beb59
msgctxt "h9f759c64g6bfbg4464gbe5dgd650e2069f82"
msgid "I can't stop the bleeding, Bry."
msgstr "출혈이 멈추질 않아, 브리."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_AD_Cultists
#. Speaker = Andrick
#. NodeID = 58be13ed-c5a9-63ca-2d26-fa1d093e7241
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 58fe77ad-6dc9-1490-efe3-f761708d1951_Variant3 = True
#.     - 58fe77ad-6dc9-1490-efe3-f761708d1951_Varaint2 = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_AD_Cultists:58be13ed-c5a9-63ca-2d26-fa1d093e7241
msgctxt "h317fcceeg86b9g48a2gbfe9ge0ac029b370c"
msgid "You're all right, Ed. You're all right."
msgstr "괜찮을 거야, 에드. 괜찮을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_AD_Cultists
#. Speaker = Andrick
#. NodeID = 6fa0b1e4-28c5-f872-c8a9-7664fc5441d1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 58fe77ad-6dc9-1490-efe3-f761708d1951_Variant3 = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_AD_Cultists:6fa0b1e4-28c5-f872-c8a9-7664fc5441d1
msgctxt "h22a42520g65fdg4c4dgb692g9c5be94ded85"
msgid "What're we gonna do, Bry?"
msgstr "어떡하지, 브리?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_AD_Cultists
#. Speaker = Andrick
#. NodeID = 888acc72-acd9-c54b-a326-07be844a53e5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_AD_Cultists:888acc72-acd9-c54b-a326-07be844a53e5
msgctxt "h19f82d0fgcf1ag4b15g8209g33f69aeff501"
msgid "He's so pale."
msgstr "얼굴이 너무 창백해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_AD_Cultists
#. Speaker = Andrick
#. NodeID = cbb0ebb0-6aa2-0933-b50e-ca80e4fbc623
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_AD_Cultists:cbb0ebb0-6aa2-0933-b50e-ca80e4fbc623
msgctxt "h78f5ab61ga1f8g4cb2gae48g64c262a6f2e4"
msgid "Like what, then?"
msgstr "그럼 어떡하자고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_AD_Cultists
#. Speaker = Brynna
#. NodeID = edd303fb-a576-cfa1-56d6-30342a3a13b9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_AD_Cultists:edd303fb-a576-cfa1-56d6-30342a3a13b9
msgctxt "h90ae9e51g9c15g4f9ega11fg8145665a7a3c"
msgid "I don't know."
msgstr "나도 모르겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_AD_Cultists
#. Speaker = Brynna
#. NodeID = fd1340b1-8364-2783-2fc0-4ebe89f3c5e7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 58fe77ad-6dc9-1490-efe3-f761708d1951_Variant3 = False
#.     - 58fe77ad-6dc9-1490-efe3-f761708d1951_Varaint2 = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_AD_Cultists:fd1340b1-8364-2783-2fc0-4ebe89f3c5e7
msgctxt "h9f34630fg155dg4392g9533gaf25cabebd93"
msgid "I - I don't know!"
msgstr "나... 나도 모르겠어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene
#. Speaker = Player
#. NodeID = 03602143-5ef4-4637-9797-c02875482040
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_CapturedGoblin_State_GoblinMentionedAbsolute = True
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene:03602143-5ef4-4637-9797-c02875482040
msgctxt "hc0154fdcgf98bg42aeg904ag79cc6eef04df"
msgid "The Absolute? They follow the same god as that wretched goblin, Sazza."
msgstr "절대자라고? 그 끔찍한 고블린 삿자와 같은 신을 섬기는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene
#. Speaker = Player
#. NodeID = 03602143-5ef4-4637-9797-c02875482040
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_CapturedGoblin_State_GoblinMentionedAbsolute = True
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene:03602143-5ef4-4637-9797-c02875482040
msgctxt "h7ac59d45gcecag46e8gafc6g2abc5394cd0d"
msgid ""
"The Absolute - that's the mystery god Sazza mentioned. Eerie common ground, "
"if you ask me."
msgstr "절대자라, 삿자가 언급했던 묘한 신과 같은 이름이군. 섬뜩한 공통점이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene
#. Speaker = Player
#. NodeID = 03602143-5ef4-4637-9797-c02875482040
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_CapturedGoblin_State_GoblinMentionedAbsolute = True
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene:03602143-5ef4-4637-9797-c02875482040
msgctxt "h273d9ed0gf54eg41ebgb30bgca6eec52e84d"
msgid "Sazza also spoke of the Absolute. New god in town?\n"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene
#. Speaker = Player
#. NodeID = 03602143-5ef4-4637-9797-c02875482040
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_CapturedGoblin_State_GoblinMentionedAbsolute = True
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene:03602143-5ef4-4637-9797-c02875482040
msgctxt "ha7b2f2a5g41aeg4617gad07g4e7f1b4590cf"
msgid "The goblin Sazza spoke of the Absolute too."
msgstr "고블린 삿자도 절대자 이야기를 했었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene
#. Speaker = Player
#. NodeID = 03602143-5ef4-4637-9797-c02875482040
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_CapturedGoblin_State_GoblinMentionedAbsolute = True
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene:03602143-5ef4-4637-9797-c02875482040
msgctxt "h6ceecf87g08f5g4c39gad98gaa6859fc1cba"
msgid ""
"They spoke of the Absolute, same as that captive goblin. They must be part "
"of the same sect."
msgstr "갇혀있던 고블린도 절대자 이야기를 했었어. 같은 단체에 속해있는 게 분명해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene
#. Speaker = Player
#. NodeID = 03602143-5ef4-4637-9797-c02875482040
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_CapturedGoblin_State_GoblinMentionedAbsolute = True
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene:03602143-5ef4-4637-9797-c02875482040
msgctxt "h2d1573acgafb7g40f7g91cag9e19a4f57944"
msgid "The Absolute, eh? Same name that goblin Sazza mentioned."
msgstr "절대자라? 고블린 삿자가 언급했던 이름과 똑같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene
#. Speaker = Player
#. NodeID = 03602143-5ef4-4637-9797-c02875482040
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_CapturedGoblin_State_GoblinMentionedAbsolute = True
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene:03602143-5ef4-4637-9797-c02875482040
msgctxt "h1b88d27dgea5ag4571g90f4g3de4b8da321d"
msgid "They spoke of the Absolute - same as that goblin, Sazza. Curious."
msgstr "절대자에 대해 언급했어, 고블린 삿자가 말했던 신과 같은 이름이군. 흥미로워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene
#. Speaker = Player
#. NodeID = 0d0fa8a8-1ba7-ea7f-26f0-b42ce841147e
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene:0d0fa8a8-1ba7-ea7f-26f0-b42ce841147e
msgctxt "hfd5e90ceg4249g4e0fg9a3cg2fb9411e54fd"
msgid "Seems like a popular little deity, whoever they are."
msgstr "누군진 모르겠지만, 꽤 인기 있는 신인 것 같네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene
#. Speaker = Player
#. NodeID = 0d0fa8a8-1ba7-ea7f-26f0-b42ce841147e
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene:0d0fa8a8-1ba7-ea7f-26f0-b42ce841147e
msgctxt "h786c67e0g2b5cg4eb1gab83g753291bf0ee6"
msgid ""
"Goblins and humans worshipping the same god? Eerie common ground, if you ask "
"me."
msgstr "고블린과 인간이 같은 신을 섬긴다고? 기괴한 조합이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene
#. Speaker = Player
#. NodeID = 0d0fa8a8-1ba7-ea7f-26f0-b42ce841147e
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene:0d0fa8a8-1ba7-ea7f-26f0-b42ce841147e
msgctxt "h6a226d66g8acfg4e78g83fcg3ebadbfc824e"
msgid "A new cult. Won't end well, believe me."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene
#. Speaker = Player
#. NodeID = 0d0fa8a8-1ba7-ea7f-26f0-b42ce841147e
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene:0d0fa8a8-1ba7-ea7f-26f0-b42ce841147e
msgctxt "h423bfa91gf2efg44deg928dga1cac1e4ff28"
msgid "A religion. Or a cult. All influenced by their Absolute."
msgstr "종교거나 이교도들이겠지. 절대자라는 자에 영향을 받은 게 분명해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene
#. Speaker = Player
#. NodeID = 0d0fa8a8-1ba7-ea7f-26f0-b42ce841147e
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene:0d0fa8a8-1ba7-ea7f-26f0-b42ce841147e
msgctxt "hd71b61edg35fdg4d43g9919g4a114558fca8"
msgid ""
"Looks like the Absolute's drawing all sorts to become followers. Impressive, "
"in a way."
msgstr "절대자가 온갖 종류의 사람들을 끌어들이는 것 같네. 어떤 면에서는 인상적이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene
#. Speaker = Player
#. NodeID = 0d0fa8a8-1ba7-ea7f-26f0-b42ce841147e
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene:0d0fa8a8-1ba7-ea7f-26f0-b42ce841147e
msgctxt "h9f75d568g0a1eg46b4gad1eg036f27f7b291"
msgid "A cult, from the looks of it. And word's spreading fast."
msgstr "보아하니 종교 집단인 것 같은데. 빠르게 퍼져나가고 있는 것 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene
#. Speaker = Player
#. NodeID = 0d0fa8a8-1ba7-ea7f-26f0-b42ce841147e
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene:0d0fa8a8-1ba7-ea7f-26f0-b42ce841147e
msgctxt "hc59dc883gc3bbg4068gb11eg33d9a482d018"
msgid ""
"Seems as though the Absolute's attracting followers from all kinds of places."
msgstr "이 절대자라는 이가 온갖 종류의 추종자들을 유혹하고 있는 것 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene
#. Speaker = Player
#. NodeID = 0e711def-b691-5410-d693-c402e6f26a4c
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene:0e711def-b691-5410-d693-c402e6f26a4c
msgctxt "h97c5453dg9384g4448ga309g6b97fd8c1238"
msgid "They're devoted to this Absolute. Whatever it is."
msgstr "이 절대자라는 자에게 헌신하고 있는 것 같네. 뭔진 모르겠지만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene
#. Speaker = Player
#. NodeID = 0e711def-b691-5410-d693-c402e6f26a4c
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene:0e711def-b691-5410-d693-c402e6f26a4c
msgctxt "h022755e2g47b6g410ag8d86g532a2b5fab95"
msgid ""
"Whatever the Absolute it, it certainly seems to command a lot of devotion."
msgstr "절대자가 뭔진 모르겠지만, 확실히 엄청난 헌신을 요구하는 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene
#. Speaker = Player
#. NodeID = 0e711def-b691-5410-d693-c402e6f26a4c
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene:0e711def-b691-5410-d693-c402e6f26a4c
msgctxt "h4f5fe12fg386bg424cga87dge117157fdcb9"
msgid "Mark my words: Whatever this is, it's bad news."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene
#. Speaker = Player
#. NodeID = 0e711def-b691-5410-d693-c402e6f26a4c
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene:0e711def-b691-5410-d693-c402e6f26a4c
msgctxt "h2af13676gf387g45fagb8dag13ebdc6d7daf"
msgid "A religion. Or a cult. All influenced by their Absolute."
msgstr "종교거나 이교도들이겠지. 절대자라는 자에 영향을 받은 게 분명해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene
#. Speaker = Player
#. NodeID = 0e711def-b691-5410-d693-c402e6f26a4c
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene:0e711def-b691-5410-d693-c402e6f26a4c
msgctxt "hf8c81f1cg635eg45feg8f1cg81bf4a4bb998"
msgid "They're clearly devoted to the Absolute. Whatever that is."
msgstr "그게 뭔진 모르겠지만, 저들은 확실히 절대자라는 이에게 헌신하고 있는 것 같네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene
#. Speaker = Player
#. NodeID = 0e711def-b691-5410-d693-c402e6f26a4c
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene:0e711def-b691-5410-d693-c402e6f26a4c
msgctxt "h9da29778g4bb4g46d2gbeddg145c0bfbf04b"
msgid "Sounds like a cult. And the Absolute is bending their ears."
msgstr "이교도 같은데. 절대자라는 이가 그들의 귀를 막고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene
#. Speaker = Player
#. NodeID = 0e711def-b691-5410-d693-c402e6f26a4c
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene:0e711def-b691-5410-d693-c402e6f26a4c
msgctxt "hd14f41fcg3629g436bg9c73g631a0f0ff438"
msgid "Whatever it is, the Absolute has a powerful hold over them."
msgstr "뭔진 모르겠지만, 이 절대자라는 게 저들에게 강한 영향력을 가지고 있는 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene
#. Speaker = Player
#. NodeID = 1daef579-6e7d-a8cb-3187-e8f282940dca
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = False
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene:1daef579-6e7d-a8cb-3187-e8f282940dca
msgctxt "h0444481dgfc0fg4bdag8deagb931df9f5673"
msgid "True Souls? Absolute? They sounded deranged."
msgstr "참된 영혼? 절대자? 미친 소리 같던데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene
#. Speaker = Player
#. NodeID = 1daef579-6e7d-a8cb-3187-e8f282940dca
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = False
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene:1daef579-6e7d-a8cb-3187-e8f282940dca
msgctxt "hc5c4a175gdf9cg44ecg94f5ge5b156e901f9"
msgid "Well. That quite the load of gobbledygook, wasn't it?"
msgstr "글쎄. 다 헛소리 같던데, 아닌가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene
