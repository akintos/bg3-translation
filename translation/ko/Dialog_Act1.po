msgctxt "hb46c48f3gd480g49a8g89dfg4a8a8b0c4268"
msgid "*The corpse does not stir. It will answer no more questions.*"
msgstr "*시체는 움직이지 않습니다. 더 이상 질문을 받지 않을 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02_Dead
