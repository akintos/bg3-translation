msgctxt "ha16bab81g2118g4de2g9b18g835a14d7d6c7"
msgid "Nuh-uh! We're having fun!"
msgstr "싫어! 우린 재밌게 놀고 있단 말이야!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain
#. Speaker = Zel'i
#. NodeID = 38d197a3-f59f-5c5d-ec68-8b5494ad42c1
#. HandlePath = TaggedText[0].TagText[0]
