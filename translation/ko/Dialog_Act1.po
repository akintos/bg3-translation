msgctxt "hc5c843efgd10cg458cgaec0g28d8cade6591"
msgid "Kobold drank once and lost his aim!"
msgstr "코볼트가 한 잔 때리고 넋이 나갔다네!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Brewery_AD_KoboldDrunkInBarrel
#. Speaker = Kobold Looter
#. NodeID = 7569b118-56c0-48f7-8474-0f7ed84230ae
