msgctxt "hc833e6c1g7f6eg429ag9559g25b7ffcaf2b1"
msgid "Oh, Miri... No..."
msgstr "오, 미리... 안 돼..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_AD_Freed
#. Speaker = Benryn
#. NodeID = 779f763f-e8f1-d041-dc91-c07c5e6a8e25
#. HandlePath = TaggedText[0].TagText[0]
