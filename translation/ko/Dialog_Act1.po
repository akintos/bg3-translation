#.     - bffd772b-7809-8b21-7385-5815d11ed048_SawLaezel1 = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard11:ca87a1ce-9cd5-748f-da1f-505b8fb74dde
msgctxt "ha9f2300cg3442g46ccgb249g07fac2b3309a"
msgid "Leave me... please!"
msgstr "내버려 둬... 제발!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard11
#. Speaker = Zorru
#. NodeID = cee2a3e3-65b3-5391-f203-f6e1674c2e57
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_ThingLikeMe_Event_RunAway(0) = False
#.   Global:
#.      - DEN_ThingLikeMe_State_OMPlayed = True
#. SetFlags:
#.   Dialog:
#.     - DEN_ThingLikeMe_Event_RunAway(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard11:cee2a3e3-65b3-5391-f203-f6e1674c2e57
msgctxt "h683dd01fg8facg4a70g8ba3g205c2007d223"
msgid "Gods deliver me!"
msgstr "신이시여!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard11
#. Speaker = Zorru
#. NodeID = db8df77f-2d7b-4565-897e-edd8a564d27c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Refugees_State_LeadersAreDead = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard11:db8df77f-2d7b-4565-897e-edd8a564d27c
msgctxt "h4d5e7e87g4120g4c23g9a3eg11a2a0c1544e"
msgid "We have space to breathe now. That's something."
msgstr "숨 돌릴 곳이라도 생겼잖아. 그게 어디야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard3
#. Speaker = Okta
#. NodeID = 3a310d8d-6be3-292a-5f11-12646d5a489c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 762626d4-3ff0-0c33-8d3e-4abf44e8c2b4_Node1 = False
#.      - 762626d4-3ff0-0c33-8d3e-4abf44e8c2b4_Node2 = False
#. SetFlags:
#.   Local:
#.     - 762626d4-3ff0-0c33-8d3e-4abf44e8c2b4_Node1 = True
#.     - 762626d4-3ff0-0c33-8d3e-4abf44e8c2b4_Node2 = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard3:3a310d8d-6be3-292a-5f11-12646d5a489c
msgctxt "h6f3493f6g78a6g4fbegaf42gef6ac78b3fd9"
msgid "What I'd do for some salt..."
msgstr "소금이 좀 있었으면 좋을 텐데..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard3
#. Speaker = Okta
#. NodeID = 88987e42-7d01-8851-9b83-79aabef766b6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Refugees_State_LeadersAreDead = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard3:88987e42-7d01-8851-9b83-79aabef766b6
msgctxt "h127317c1gd87cg46d5gb631g9017d3bd807d"
msgid "Slimy bastards are dead. Hope it wasn't pretty."
msgstr "끈적거리는 놈들이 죽었군. 곱게 가진 않았으면 좋겠는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard3
#. Speaker = Okta
#. NodeID = 8fe36166-7ea5-d757-8d9f-8937d6909ecf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 762626d4-3ff0-0c33-8d3e-4abf44e8c2b4_Node1 = True
#.      - 762626d4-3ff0-0c33-8d3e-4abf44e8c2b4_Node2 = False
#. SetFlags:
#.   Local:
#.     - 762626d4-3ff0-0c33-8d3e-4abf44e8c2b4_Node1 = False
#.     - 762626d4-3ff0-0c33-8d3e-4abf44e8c2b4_Node2 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard3:8fe36166-7ea5-d757-8d9f-8937d6909ecf
msgctxt "hf35f7a7fg23eeg4189g84bbg8bd924d3b7aa"
msgid "Where'd I put that oat bucket?"
msgstr "그 귀리 양동이를 어디 뒀었더라?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard3
#. Speaker = Okta
#. NodeID = d49e3572-25fa-1b36-c744-aabfaae99866
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 762626d4-3ff0-0c33-8d3e-4abf44e8c2b4_Node1 = False
#.      - 762626d4-3ff0-0c33-8d3e-4abf44e8c2b4_Node2 = True
#. SetFlags:
#.   Local:
#.     - 762626d4-3ff0-0c33-8d3e-4abf44e8c2b4_Node1 = False
#.     - 762626d4-3ff0-0c33-8d3e-4abf44e8c2b4_Node2 = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard3:d49e3572-25fa-1b36-c744-aabfaae99866
msgctxt "hd274733egcca4g47a2g8731g5f27dd12cfe4"
msgid "Hm - doesn't taste half bad."
msgstr "흠. 그렇게 나쁘지는 않네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard3_8
#. Speaker = Ikaron
#. NodeID = 220bacdc-3367-6e48-7b55-fc0b9dd97847
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard3_8:220bacdc-3367-6e48-7b55-fc0b9dd97847
msgctxt "h20e82af9g77fag46d6g803agdd327bbc5383"
msgid "I did, Mother."
msgstr "네, 엄마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard3_8
#. Speaker = Okta
#. NodeID = 2268cd66-6b47-5eb8-76f2-1d33e922fa36
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard3_8:2268cd66-6b47-5eb8-76f2-1d33e922fa36
msgctxt "h5323bee9gc3c3g4628g9b57gbc3bc08bba55"
msgid "Eaten enough?"
msgstr "배는 잘 채웠고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard3_8
#. Speaker = Okta
#. NodeID = 395ec42c-3c0d-2b12-51ff-511dab3d914a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard3_8:395ec42c-3c0d-2b12-51ff-511dab3d914a
msgctxt "h81dd9b12geb3eg4fb5gbb06g4671f1daa130"
msgid "You didn't offer anything to that old woman, did you?"
msgstr "그 늙은 여편네한테는 아무것도 안 내줬고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard3_8
#. Speaker = Ikaron
#. NodeID = 4175f02e-7a90-5236-b4c8-c7bc8835a41f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard3_8:4175f02e-7a90-5236-b4c8-c7bc8835a41f
msgctxt "hb2080dd2g8598g49efg8378g055957913c90"
msgid "Mother."
msgstr "엄마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard3_8
#. Speaker = Ikaron
#. NodeID = 487514ac-e353-390c-7a7e-a839a3feb5a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard3_8:487514ac-e353-390c-7a7e-a839a3feb5a8
msgctxt "h2b94440cg32e0g4364g9d27ge8e7506e1a29"
msgid "Mother, I'm fine."
msgstr "엄마, 전 괜찮아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard3_8
#. Speaker = Okta
#. NodeID = 4af4d02b-2c54-04e4-7c52-b62aff99092e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard3_8:4af4d02b-2c54-04e4-7c52-b62aff99092e
msgctxt "h5a947bceg1f6cg4430g8442ga9727dc5a9a9"
msgid "I know... I know."
msgstr "알지... 알아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard3_8
#. Speaker = Ikaron
#. NodeID = 527c1795-59ec-deba-7086-3122b3ab8968
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 18671a88-ee44-3b8d-fe08-abe084264fab_Node1 = False
#.      - 18671a88-ee44-3b8d-fe08-abe084264fab_Node2 = True
#. SetFlags:
#.   Local:
#.     - 18671a88-ee44-3b8d-fe08-abe084264fab_Node1 = False
#.     - 18671a88-ee44-3b8d-fe08-abe084264fab_Node2 = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard3_8:527c1795-59ec-deba-7086-3122b3ab8968
msgctxt "h9635d518g6683g4abegb5cdgf9946a7a4307"
msgid "Mother, they didn't want anything."
msgstr "엄마, 물어봤는데 안 먹고 싶대요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard3_8
#. Speaker = Ikaron
#. NodeID = 56d0122b-3511-269f-5915-f71e798d7623
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard3_8:56d0122b-3511-269f-5915-f71e798d7623
msgctxt "h60869963g9a86g421fgb119g2fea3fac4c4e"
msgid "Relax. They'll be all right."
msgstr "진정하세요. 걔들은 괜찮을 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard3_8
#. Speaker = Ikaron
#. NodeID = 714a0ed1-150f-529c-9ef4-528f94043e92
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard3_8:714a0ed1-150f-529c-9ef4-528f94043e92
msgctxt "h08cdc378g15e9g458cg90c5g9e65f44104d0"
msgid "No. You told me not to."
msgstr "네. 그러지 말라셨잖아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard3_8
#. Speaker = Okta
#. NodeID = a2aca291-1641-bef8-bfa0-6f4159e9c83a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 18671a88-ee44-3b8d-fe08-abe084264fab_Node1 = False
#.      - 18671a88-ee44-3b8d-fe08-abe084264fab_Node2 = False
#. SetFlags:
#.   Local:
#.     - 18671a88-ee44-3b8d-fe08-abe084264fab_Node1 = True
#.     - 18671a88-ee44-3b8d-fe08-abe084264fab_Node2 = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard3_8:a2aca291-1641-bef8-bfa0-6f4159e9c83a
msgctxt "h50bc393fg58ebg4aa4gb5bcgcc99188d77e5"
msgid "You packed?"
msgstr "짐 챙겼니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard3_8
#. Speaker = Okta
#. NodeID = a8a6e5a6-9cd1-c7fd-510e-071be7a16511
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard3_8:a8a6e5a6-9cd1-c7fd-510e-071be7a16511
msgctxt "h9df3a545gc42dg4744gb9a2g422a9a2a3c47"
msgid "I don't care. Those kids need to eat before we leave."
msgstr "내 알 바 아니다. 여기 뜨기 전에 그 애들 배 채워둬."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard3_8
#. Speaker = Ikaron
#. NodeID = bae1fc71-bf9d-64a6-e934-00561d765c90
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard3_8:bae1fc71-bf9d-64a6-e934-00561d765c90
msgctxt "h992c3943gd0eeg4121gbec9g9cac766e0659"
msgid "Yes."
msgstr "네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard3_8
#. Speaker = Okta
#. NodeID = c55f2ada-f089-9ad5-e3eb-ccff318c0feb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard3_8:c55f2ada-f089-9ad5-e3eb-ccff318c0feb
msgctxt "h804bd769g7cf7g4ed7g8026g4881896f8fdc"
msgid "Just checking."
msgstr "그냥 물어봤다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard3_8
#. Speaker = Okta
#. NodeID = ce64ecf0-9ca6-a9a1-9af2-4de39a1bcc2f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard3_8:ce64ecf0-9ca6-a9a1-9af2-4de39a1bcc2f
msgctxt "hf3cc169bg826eg4f5eg9516g5298e9c7be57"
msgid "They're kids - they don't know what they want."
msgstr "애들이잖냐. 지들 진짜 속마음도 잘 모른다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard3_8
#. Speaker = Okta
#. NodeID = e6f5f273-9d5f-8e63-ef74-ebd9f1fa7ba8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 18671a88-ee44-3b8d-fe08-abe084264fab_Node1 = True
#.      - 18671a88-ee44-3b8d-fe08-abe084264fab_Node2 = False
#. SetFlags:
#.   Local:
#.     - 18671a88-ee44-3b8d-fe08-abe084264fab_Node1 = False
#.     - 18671a88-ee44-3b8d-fe08-abe084264fab_Node2 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard3_8:e6f5f273-9d5f-8e63-ef74-ebd9f1fa7ba8
msgctxt "h059618f2g2c59g43aag8b83g63fcc91816b7"
msgid "Did you pass out a bowl to everyone?"
msgstr "모두한테 식사 잘 나눠줬니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard4
#. Speaker = Kaldani
#. NodeID = 81a26448-ada4-439e-503e-2f87bdd1283e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard4:81a26448-ada4-439e-503e-2f87bdd1283e
msgctxt "h07bdfebbgbf30g414fgb3f0g2bfbeac73305"
msgid "One crisis after another..."
msgstr "위기가 끊이질 않는군..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard4
#. Speaker = Kaldani
#. NodeID = 81a26448-ada4-439e-503e-2f87bdd1283e
#. HandlePath = TaggedText[0].TagText[1]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard4:81a26448-ada4-439e-503e-2f87bdd1283e
msgctxt "h2f60665cga54ag49a5g9f5egd83f50c0d1e5"
msgid "It never ends."
msgstr "끝이 안 보이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = 05783f67-4137-79af-0711-b8cdfe364377
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Refugees_State_LeadersAreDead = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard5:05783f67-4137-79af-0711-b8cdfe364377
msgctxt "h9ab0fb2fg48a3g4a40gbdf5g554b6a8dc381"
msgid "I can't believe it. We might actually make it to Baldur's Gate."
msgstr "믿을 수 없어. 정말 발더스 게이트에 갈 수 있을지도 몰라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = 0940b8fb-3918-a266-eb72-a2242ef72318
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - a0b99562-8db2-c318-7158-ddf839a95aa3_switch = True
#.   Object:
#.      - DEN_General_State_PotionTieflingHealed(0) = True
#. SetFlags:
#.   Local:
#.     - a0b99562-8db2-c318-7158-ddf839a95aa3_switch = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard5:0940b8fb-3918-a266-eb72-a2242ef72318
msgctxt "h0e672068g9367g4ffbg8cb2g4d7425883344"
msgid "Let them come. Goblins, gnolls - I'm ready!"
msgstr "올테면 와라. 고블린이든 놀이든 다 상대해주겠어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = b65e87ea-6974-0603-8ce5-43356a433bfe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - a0b99562-8db2-c318-7158-ddf839a95aa3_switch = False
#.   Object:
#.      - DEN_General_State_PotionTieflingHealed(0) = True
#. SetFlags:
#.   Local:
#.     - a0b99562-8db2-c318-7158-ddf839a95aa3_switch = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard5:b65e87ea-6974-0603-8ce5-43356a433bfe
msgctxt "hef110b07g4f48g4a1fg9593g47e3b57411fd"
msgid "Never buying a potion off that old bat again."
msgstr "그 늙은 할망구한테서 다신 물약 안 살 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = d8fa497d-d054-ebc6-d4ce-bfe1e1b5c789
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - a0b99562-8db2-c318-7158-ddf839a95aa3_switch = True
#. SetFlags:
#.   Local:
#.     - a0b99562-8db2-c318-7158-ddf839a95aa3_switch = False
#.   Object:
#.     - DEN_General_State_PotionTieflingHealed(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard5:d8fa497d-d054-ebc6-d4ce-bfe1e1b5c789
msgctxt "hba330d87gb777g4b11g8a1dg0f191093cb50"
msgid "Of all the bloody things to happen."
msgstr "세상에 이런 일이 다 있나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard5
#. Speaker = Pandirna
#. NodeID = e5286dea-4735-a509-fea7-0014b7dec0be
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - a0b99562-8db2-c318-7158-ddf839a95aa3_switch = False
#.   Object:
#.      - DEN_General_State_PotionTieflingHealed(0) = False
#. SetFlags:
#.   Local:
#.     - a0b99562-8db2-c318-7158-ddf839a95aa3_switch = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard5:e5286dea-4735-a509-fea7-0014b7dec0be
msgctxt "h703a723bgff11g43cdgb001g25fbf175c1df"
msgid "Come on - just move!"
msgstr "제발 좀 움직여라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard8
#. Speaker = Ikaron
#. NodeID = 1568ceda-c315-5d9b-d0e8-5d503345915f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Refugees_State_LeadersAreDead = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard8:1568ceda-c315-5d9b-d0e8-5d503345915f
msgctxt "h299cdc4dg5ed6g4a4fg8b59gd108aaa3f560"
msgid "Should be safe to travel now."
msgstr "이제는 길을 나서도 안전하겠군."

