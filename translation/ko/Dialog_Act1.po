msgctxt "heb23b70fg9438g4610gbbd5g506e46021a90"
msgid "Who is Lihala?"
msgstr "리할라가 누구지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_TieflingBard_Dead
#. Speaker = Player
#. NodeID = 15d255c1-1794-4355-814b-313b88d51dff
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_TieflingBard_Dead:15d255c1-1794-4355-814b-313b88d51dff
msgctxt "h8b11e394g83f7g45e6gbddfgcd836445a73d"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_TieflingBard_Dead
#. Speaker = Alfira
#. NodeID = 34419180-c562-c2a3-cbda-50c773bb6148
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_TieflingBard_Dead:34419180-c562-c2a3-cbda-50c773bb6148
msgctxt "h32b9258agb77cg4475g86b5gd8637a1a7324"
msgid "With... Lihala... but... but..."
msgstr "리할라랑... 그런데... 그런데..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_TieflingBard_Dead
#. Speaker = Alfira
#. NodeID = 39e96830-06fd-80e3-afd6-c959fd4b7e15
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_TieflingBard_Dead:39e96830-06fd-80e3-afd6-c959fd4b7e15
msgctxt "had4ab4e0g4df3g470bg859eg3274f721fb17"
msgid "Run when they... shriek. They call... for others..."
msgstr "놈들이 소리를 질렀고... 도망쳐... 다른 놈들을... 불러서..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_TieflingBard_Dead
#. Speaker = Player
#. NodeID = 707f663c-0637-560b-b2a3-65ab350395bb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Local:
#.     - a0b3aa7f-ba39-2d1c-18da-267f2b0ab0a8_Elfsong = True
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_TieflingBard_Dead:707f663c-0637-560b-b2a3-65ab350395bb
msgctxt "h4339e45dg8ce5g4f7cg84d8gec245605231d"
msgid "Where were you going?"
msgstr "어디로 가고 있었지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_TieflingBard_Dead
#. Speaker = Player
#. NodeID = 8ad0aef3-3012-3664-bf3b-6550d109d555
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - a0b3aa7f-ba39-2d1c-18da-267f2b0ab0a8_Gnolls = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_TieflingBard_Dead:8ad0aef3-3012-3664-bf3b-6550d109d555
msgctxt "h7e8397c7gd7ccg4370gbb4bg31a953ee41e5"
msgid "You met gnolls? How did you survive?"
msgstr "놀을 마주쳤나? 어떻게 살아남았지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_TieflingBard_Dead
#. Speaker = Player
#. NodeID = 8bbaa962-a439-aa50-f96a-aa23a9fc463e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Local:
#.     - a0b3aa7f-ba39-2d1c-18da-267f2b0ab0a8_Lihala = True
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_TieflingBard_Dead:8bbaa962-a439-aa50-f96a-aa23a9fc463e
msgctxt "h5a08afc2g559fg4196g9069g00378fddd094"
msgid "Did you come here alone?"
msgstr "여기엔 혼자 왔나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_TieflingBard_Dead
#. Speaker = Player
#. NodeID = 8c1ac0f2-f884-9b06-514e-c6dff6ae4de8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - a0b3aa7f-ba39-2d1c-18da-267f2b0ab0a8_Elfsong = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Local:
#.     - a0b3aa7f-ba39-2d1c-18da-267f2b0ab0a8_Lihala = True
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_TieflingBard_Dead:8c1ac0f2-f884-9b06-514e-c6dff6ae4de8
msgctxt "hc119d73egd403g4b7eg98cfgc416fe1847c0"
msgid "Why the Elfsong Tavern?"
msgstr "어째서 엘프송 여관이야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_TieflingBard_Dead
#. Speaker = Alfira
#. NodeID = 91d872ff-ff0a-2482-5ce5-1718aa98b5f9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_TieflingBard_Dead:91d872ff-ff0a-2482-5ce5-1718aa98b5f9
msgctxt "hc0052dc6gdcc0g4616gb34bg93fa5fa6a62d"
msgid "Lihala's lute... where is... where..."
msgstr "리할라의 류트... 어디에... 어디..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_TieflingBard_Dead
#. Speaker = Player
#. NodeID = 970387f1-58ea-441f-838b-87f403be5ef3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_TieflingBard_Dead:970387f1-58ea-441f-838b-87f403be5ef3
msgctxt "h95549433g37adg4599ga259gaf1ac08e7434"
msgid "Who are you?"
msgstr "너는 누구지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_TieflingBard_Dead
#. Speaker = Narrator
#. NodeID = cccc3e68-a0bc-4594-a335-24413d511448
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_TieflingBard_Dead:cccc3e68-a0bc-4594-a335-24413d511448
msgctxt "hc63b8826ge443g40b1ga057ga7e353e6ce88"
msgid "*The corpse does not stir. It will answer no more questions.*"
msgstr "*시체는 움직이지 않습니다. 더 이상 질문을 받지 않을 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_TieflingBard_Dead
#. Speaker = Narrator
#. NodeID = d92487f5-803b-4037-b0ec-fa36d7ac38e7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_TieflingBard_Dead:d92487f5-803b-4037-b0ec-fa36d7ac38e7
msgctxt "ha75fb2cfg34e2g418aga1c5g24cc0558ed80"
msgid "*The corpse regards you lifelessly.*"
msgstr "*시체가 생기 없는 모습으로 당신을 맞이합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_TieflingBard_Dead
#. Speaker = Alfira
#. NodeID = de0505f7-5107-4fd8-9254-c6663ddd06e9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_TieflingBard_Dead:de0505f7-5107-4fd8-9254-c6663ddd06e9
msgctxt "h24ac5946ge7f3g4fa5gaeedg5a9a5eb96717"
msgid "Alfira... apprentice... bard..."
msgstr "알피라... 수습... 음유시인..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_TieflingBard_Dead
#. Speaker = Alfira
#. NodeID = de452f3a-24fc-3ad6-51cf-8752e6db74fa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_TieflingBard_Dead:de452f3a-24fc-3ad6-51cf-8752e6db74fa
msgctxt "h29aec427gd7bfg4d4ag945fg68408310da29"
msgid ""
"Teacher... friend... everything to me. But gnolls... ripped her... apart..."
msgstr "선생님... 친구... 내 전부. 놀이... 갈기갈기... 찢었어..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_TieflingBard_Dead
#. Speaker = Narrator
#. NodeID = e4c5f395-5a16-4965-b384-8da04f5ad243
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_TieflingBard_Dead:e4c5f395-5a16-4965-b384-8da04f5ad243
msgctxt "h41536835gcbf6g4f3fg9e3fge373af4476a8"
msgid "*The spell's power wanes. You can ask no more questions.*"
msgstr "*주문의 힘이 약해집니다. 더 이상 질문을 할 수 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_TieflingBard_Dead
#. Speaker = Alfira
#. NodeID = e4d5dbd8-8d63-8d64-656f-8dff65f07392
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_TieflingBard_Dead:e4d5dbd8-8d63-8d64-656f-8dff65f07392
msgctxt "h23bf0d12g985cg45d8g837eg8f47ef20ae1c"
msgid "Elfsong Tavern... Baldur's Gate..."
msgstr "엘프송 여관... 발더스 게이트..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_TieflingBard_Dead
#. Speaker = Alfira
#. NodeID = e63e54fb-454a-993c-6706-c945ea95d3d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_TieflingBard_Dead:e63e54fb-454a-993c-6706-c945ea95d3d4
msgctxt "h66913a6cgf12dg4d33gb54fg97b6e3bb6ccf"
msgid "To perform there... to sing... for Lihala..."
msgstr "거기서 공연을... 노래를... 리할라를 위해서..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_TieflingBard_Dead
#. Speaker = Narrator
#. NodeID = f9d5f108-14ed-409f-88c3-2bb78f3c17fc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_Killer(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_TieflingBard_Dead:f9d5f108-14ed-409f-88c3-2bb78f3c17fc
msgctxt "h955cfd16g2de7g4075gbc3dg0a8a55e7ad1d"
msgid "*The corpse seems willing to speak - but not to its killer.*"
msgstr "*시체는 말할 의지가 있지만, 자신을 죽인 자와 대화하고 싶지는 않은 듯 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_TieflingBard_Dead
#. Speaker = Player
#. NodeID = fd4dcc24-57f4-cf5c-02d2-43883bd812f6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Local:
#.     - a0b3aa7f-ba39-2d1c-18da-267f2b0ab0a8_Lihala = True
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_TieflingBard_Dead:fd4dcc24-57f4-cf5c-02d2-43883bd812f6
msgctxt "h18d70724g6514g4236g8cfagf39a1dae3a6d"
msgid "Did you have any valuables?"
msgstr "지니고 있던 귀중품이 있나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Nadira
#. NodeID = 01eea5ea-8878-4b3a-9204-c892476c623e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - KARLACH(1) = False
#.      - TIEFLING(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:01eea5ea-8878-4b3a-9204-c892476c623e
msgctxt "h687ac964gc191g47c7ga316gd5b028799e66"
msgid "But you're not from Elturel, either. I can tell."
msgstr "하지만 엘투렐에서 온 것도 아니네요. 알 수 있어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Nadira
#. NodeID = 0ce44035-8c09-b34b-f6ed-288dff7411fc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Stargazing_State_HasCoin(0) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Stargazing_TookCoin(1) = True
#.   Global:
#.     - DEN_Stargazing_Event_NoLongerHasCoin = True
#.   Object:
#.     - DEN_Stargazing_State_HasCoin(0) = False
#.     - DEN_Stargazing_Event_GiveCoin(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:0ce44035-8c09-b34b-f6ed-288dff7411fc
msgctxt "hf9f1dbf3g804ag47a7ga39agc28815a11261"
msgid ""
"Fine. Take it as a grudging payment for the rescue. Now leave me in peace."
msgstr "좋아요. 구출해 준 대가로 마지못해서 주는 거로 생각하세요. 이제 절 내버려 둬요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Nadira
#. NodeID = 0d75088c-7265-f333-df52-e028fb9fb9b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:0d75088c-7265-f333-df52-e028fb9fb9b1
msgctxt "h67e9d1d3g1446g4c40g8cb8gc9f148dfb3df"
msgid "You almost seem honest."
msgstr "모르는 척하는 연기가 수준급이네요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Player
#. NodeID = 1310565c-62d3-e69b-1d60-d7a98d83e2b8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:1310565c-62d3-e69b-1d60-d7a98d83e2b8
msgctxt "h27b23a7eg260eg48c1g97b5g7b6326257631"
msgid "It was worth a shot."
msgstr "해볼 만한 시도였지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Nadira
#. NodeID = 13316f60-d10b-4757-1614-2bbe04b9200a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Stargazing_State_HasCoin(0) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Stargazing_TookCoin(1) = True
#.   Global:
#.     - DEN_Stargazing_Event_NoLongerHasCoin = True
#.   Object:
#.     - DEN_Stargazing_State_HasCoin(0) = False
#.     - DEN_Stargazing_Event_GiveCoin(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:13316f60-d10b-4757-1614-2bbe04b9200a
msgctxt "ha3ab22bagb284g443eg8144g0abc0cdcf517"
msgid "Here. Now go back to the pit that made you."
msgstr "여기요. 이제 당신이 왔던 구덩이로 돌아가세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Nadira
#. NodeID = 14e60275-73b0-6487-9601-75d95b7ed75a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:14e60275-73b0-6487-9601-75d95b7ed75a
msgctxt "h95c1771egc1beg4b22g9531g3ca8d57efc04"
msgid ""
"I think not. Go and strip the bugbear for parts if you're that desperate."
msgstr "제 생각은 달라요. 그렇게 절박하다면, 저기 죽은 버그베어나 해체하시죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Nadira
#. NodeID = 156c6b44-bc0a-c8a5-7e5f-13a9271b8c04
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:156c6b44-bc0a-c8a5-7e5f-13a9271b8c04
msgctxt "h0e461ebcge1acg43f8g9d17g43e52dce5821"
msgid "That bloody erinyes. Devils just can't stand to lose."
msgstr "그 망할 에리니에스 같으니. 데빌은 지려고 하질 않는다니까요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Player
#. NodeID = 16baa0d1-7261-0aaa-2b2c-ceb538701831
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:16baa0d1-7261-0aaa-2b2c-ceb538701831
msgctxt "h6d75f966g593fg4b8fg9c8agf8a470e98e9f"
msgid "I can put this to really good use. Thank you."
msgstr "나라면 이걸 정말 좋은 곳에 쓸 수 있어. 고마워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Player
#. NodeID = 179c26ff-0453-9ce5-71d9-b3b22cc7cf50
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Object:
#.      - DEN_Stargazing_State_HasCoin(0) = True
#.   Tag:
#.      - BARBARIAN(1) = True
#. TagRule: BERSERKER
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:179c26ff-0453-9ce5-71d9-b3b22cc7cf50
msgctxt "ha52415d3ga314g4148g8b5agd125088e7a28"
msgid "<b>COIN. OR. DEATH.</b>"
msgstr "<b>동전. 죽음. 골라.</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Player
#. NodeID = 179c26ff-0453-9ce5-71d9-b3b22cc7cf50
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Object:
#.      - DEN_Stargazing_State_HasCoin(0) = True
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:179c26ff-0453-9ce5-71d9-b3b22cc7cf50
msgctxt "hb441a4e0g11dag4b02g8119gd726d8c61852"
msgid "Bad liar, but good killer. The coin - <b>now.</b>"
msgstr "거짓말은 못해도 죽이는 건 잘해. 동전 내놔, <b>당장.</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Nadira
#. NodeID = 17c7dbcf-8d2b-e256-686b-77725b183cee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:17c7dbcf-8d2b-e256-686b-77725b183cee
msgctxt "hb433cbb0gd950g4957g9d6dg845bfc96b4d2"
msgid "Now take my regards back to that pouting erinyes and leave me alone."
msgstr "이제 제 안부를 그 심술쟁이 에리니에스에게 전해 주고 절 가만히 내버려 두세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Nadira
#. NodeID = 1a79b297-b97a-dafb-c2eb-a9784df2c149
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Stargazing_State_HasCoin(0) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Stargazing_TookCoin(1) = True
#.   Global:
#.     - DEN_Stargazing_Event_NoLongerHasCoin = True
#.   Object:
#.     - DEN_Stargazing_State_HasCoin(0) = False
#.     - DEN_Stargazing_Event_GiveCoin(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:1a79b297-b97a-dafb-c2eb-a9784df2c149
msgctxt "hb7c2f2adga9c7g424bg9392g67a6ec4c127a"
msgid ""
"... that's a fair trade. Here. Take this soul back to the damned place it "
"came from."
msgstr "... 그 정도면 합리적인 거래인 것 같네요. 이 영혼을 가지고 당신이 있던 그 망할 곳으로 돌아가세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Player
#. NodeID = 22241572-3d06-ad84-c3b1-458f54268511
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:22241572-3d06-ad84-c3b1-458f54268511
msgctxt "ha3e64da0g4751g4266gaa9dgc7fd256d571d"
msgid ""
"A soul coin, eh? Whoever it belongs to won't let it go easily. You ready for "
"that?"
msgstr "영혼 동전이라고? 그거 주인이 누구든 쉽게 내주려 하진 않을 텐데. 거기에 대한 준비는 되어 있어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Nadira
#. NodeID = 234031a6-6635-4dbd-98bc-83571366fcd4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:234031a6-6635-4dbd-98bc-83571366fcd4
msgctxt "h7c3ee8b5g3dc1g44cdgb149g7a4594ed7fca"
msgid ""
"Let me guess: your devil mistress sent you to get her soul coin back. Too "
"bad. I earned it fair and square."
msgstr ""
"한번 맞춰 볼게요. 당신의 데빌 여주인이 영혼 동전을 되찾아 오라고 보낸 거죠? 하지만 안됐네요. 정정당당하게 얻은 물건이거든요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Nadira
#. NodeID = 237ef3dc-9b2c-cc4f-0263-584df645f04b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:237ef3dc-9b2c-cc4f-0263-584df645f04b
msgctxt "hea197385ge79ag4351g88c4g63ce57c6cebd"
msgid ""
"But if you're not here for the coin, I'd rather enjoy the quiet. There's not "
"much of it anywhere else."
msgstr ""
"하지만 당신이 동전을 위해 여기 온 게 아니라면, 전 조용함을 좀 즐기고 싶네요. 여기 말곤 고요한 곳을 찾기 힘들어서 말이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Nadira
#. NodeID = 253cb0a6-8fc7-3329-d1bc-7ea2018d17b0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:253cb0a6-8fc7-3329-d1bc-7ea2018d17b0
msgctxt "h8778a7d5g49bdg4226gb5ffg20d56274babb"
msgid ""
"It's a soul, wrapped up in a terrible iron package. Don't ask whose, because "
"I don't know."
msgstr "끔찍한 철제 포장으로 싸여있는 영혼이에요. 누구의 것인진 묻지 마세요, 저도 모르니까요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Nadira
#. NodeID = 281329d9-598c-3c94-b3db-a3382dacc143
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Stargazing_HasMet(1) = True
#.      - DEN_Stargazing_TookCoin(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:281329d9-598c-3c94-b3db-a3382dacc143
msgctxt "h65fddcd4g7065g467dg8900g19f2264b5474"
msgid "You got what you came for. Just go somewhere else."
msgstr "원하는 걸 얻으셨잖아요. 이제 다른 사람이나 괴롭히세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Nadira
#. NodeID = 2a998875-bd04-88a9-daa7-197d596e9443
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:2a998875-bd04-88a9-daa7-197d596e9443
msgctxt "hb4aeb5bbgfd12g413cga6efg21b7cdea502b"
msgid "Gods, I hope not. I left home at sixteen for a reason."
msgstr "신이시여, 아니길 바라죠. 전 열여섯 살에 가출했거든요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Nadira
#. NodeID = 2d11a3cd-5906-b3d8-082f-2432f44855e3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:2d11a3cd-5906-b3d8-082f-2432f44855e3
msgctxt "ha69aa817gd328g4c9cg821cg46a38272a89c"
msgid "And I thought I was doomed. Now I feel sorry for you."
msgstr "완전 망했다고 생각 중이었는데 그쪽보단 나은걸요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Nadira
#. NodeID = 2ea4ee72-e71f-792b-2f56-340a381b82e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:2ea4ee72-e71f-792b-2f56-340a381b82e2
msgctxt "h4c0e1805g1933g42bagb6cbg89a7f7050505"
msgid "So, thank you. Not a lot of people watching my back these days."
msgstr "그러니, 고마워요. 요즘엔 서로 뒤를 봐주는 사람이 흔치 않거든요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Nadira
#. NodeID = 2eeae11b-54ce-dfd7-99d4-5aaf1fb1910e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:2eeae11b-54ce-dfd7-99d4-5aaf1fb1910e
msgctxt "hba701b15ge948g424ega519g49291d66de95"
msgid "Considering you turned that bugbear into paste..."
msgstr "당신이 저 버그베어를 반죽으로 만들어 버리셨으니..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Nadira
#. NodeID = 33d77060-c98b-42ec-0bec-1df39fef6b71
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:33d77060-c98b-42ec-0bec-1df39fef6b71
msgctxt "he292aa00g08f0g49e9g9f9fg2e838a76e4d2"
msgid ""
"Look, I appreciate you killing the bugbear, but this coin is all I have. So "
"thank you, but leave me alone."
msgstr ""
"이봐요, 버그베어를 죽여준 건 감사히 생각해요, 하지만 이 동전이 제가 가진 전부예요. 그러니 고맙지만, 이제 절 혼자 내버려 두셨으면 "
"좋겠네요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Nadira
#. NodeID = 35194b7a-52f8-ef96-d0ca-1e043e4127ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:35194b7a-52f8-ef96-d0ca-1e043e4127ac
msgctxt "h11c8e107g4c4ag4be9g8fb1gae32eba549af"
msgid "Considering what I've seen? You'd be surprised."
msgstr "제가 뭘 봤는지 아세요? 알면 당신이 놀랄 걸요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Nadira
#. NodeID = 3ae1f292-b032-b773-1400-f20acb71980f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:3ae1f292-b032-b773-1400-f20acb71980f
msgctxt "h165f3dd4gef10g43a7g9e19g2afc75860274"
msgid "Then our interests barely intersect."
msgstr "그럼 우리는 서로 볼일 없는 거네요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Nadira
#. NodeID = 3b4fd6c2-b8fc-109d-50d4-e0d50b58857c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Stargazing_HasMet(1) = True
#.      - DEN_Stargazing_GaveCoinFreely(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:3b4fd6c2-b8fc-109d-50d4-e0d50b58857c
msgctxt "h489f74e6g704ag4571gb163gf7818cfcc221"
msgid "That coin's worth plenty. Don't let a squid get their tentacles on it."
msgstr "그 동전은 정말 귀한 물건이에요. 오징어 놈들 촉수가 만질 일 없게 하세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Player
#. NodeID = 3f64caa1-2070-db58-6a8a-23ef967b3dbc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:3f64caa1-2070-db58-6a8a-23ef967b3dbc
msgctxt "h80481888gf64eg490fgbe83gef1671cc80b4"
msgid "Coin? Mistress? You lost me."
msgstr "동전? 여주인? 무슨 소리를 하는 건지 모르겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Player
#. NodeID = 43871047-1769-7fe7-9369-02a0d5afe171
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Object:
#.      - DEN_Stargazing_State_HasCoin(0) = True
#.   Tag:
#.      - BARBARIAN(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:43871047-1769-7fe7-9369-02a0d5afe171
msgctxt "h96298033g0a9fg481bgb4c0g7bef03da9d48"
msgid "No, I don't. But that coin of yours is mine."
msgstr "싫어. 그리고 너의 그 동전은 내 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Player
#. NodeID = 46344649-af05-5bd2-4819-6c9638634969
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:46344649-af05-5bd2-4819-6c9638634969
msgctxt "hef6e5837g7501g422fgab01gb86308df73f8"
msgid ""
"My 'devil mistress' can go fuck herself. I don't serve Zariel - or anyone."
msgstr "'데빌 여주인'은 엿이나 먹으라 해. 난 자리엘도, 누구도 섬기지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Player
#. NodeID = 46d432bd-4c54-14b1-a808-49854558a0a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:46d432bd-4c54-14b1-a808-49854558a0a4
msgctxt "h2cf2046dg80aeg4762ga050gef4bfc1b9ca1"
msgid "That bugbear would have crushed your skull. This is the thanks I get?"
msgstr "방금 그 버그베어가 네 두개골을 작살냈을지도 몰라. 구해줬더니 감사 인사가 이거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Player
#. NodeID = 4cc82ded-ba23-104f-abb1-6aae3366745b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:4cc82ded-ba23-104f-abb1-6aae3366745b
msgctxt "hc797f919g5e26g4ffbgb3ddg1cffab463d26"
msgid ""
"I'm Karlach. If you've spent any time in Avernus, you might've heard of me."
msgstr "난 칼라크야. 아베르누스에 있었다면, 나에 대해 들어 봤을지도 모르겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Nadira
#. NodeID = 4de9a9c3-53ea-f2c2-4889-db99958b1973
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:4de9a9c3-53ea-f2c2-4889-db99958b1973
msgctxt "h7001d1bagbc31g4a75gaf1cg4021cffbd536"
msgid ""
"Why thank you, dread slayer of bugbears. You shall live forever in my memory."
msgstr "고마워요, 버그베어 학살자님. 이 일은 영원히 잊지 못할 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Player
#. NodeID = 4f028adc-ff07-2c16-4546-ed54b90676ce
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Object:
#.      - DEN_Stargazing_State_HasCoin(0) = True
#.   Tag:
#.      - BARBARIAN(1) = True
#. TagRule: BERSERKER
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:4f028adc-ff07-2c16-4546-ed54b90676ce
msgctxt "hdee6ee8fga7cbg401cg85f3ga07edd51bc41"
msgid "<b>COIN OR DEATH. NOW.</b>"
msgstr "<b>동전이랑 죽음. 골라.</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Player
#. NodeID = 4f028adc-ff07-2c16-4546-ed54b90676ce
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Object:
#.      - DEN_Stargazing_State_HasCoin(0) = True
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:4f028adc-ff07-2c16-4546-ed54b90676ce
msgctxt "h6ea74667ga0efg4c45g8f4cg1e9865dde5b7"
msgid "The coin, now. Or you can be alone in your grave."
msgstr "동전을 내놔, 당장. 아니면 네 무덤에 혼자 묻히게 될 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Nadira
#. NodeID = 542b4de8-ab42-f6cc-617b-4babc8380d15
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Stargazing_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:542b4de8-ab42-f6cc-617b-4babc8380d15
msgctxt "h01934e69g9c33g437fg9e66g8eecef1cd552"
msgid ""
"From hellspawn to angry druids... I'm definitely buying my way to Baldur's "
"Gate."
msgstr "지옥의 자손에, 화난 드루이드에... 돈이라도 써서 발더스 게이트로 가야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Nadira
#. NodeID = 54a2d644-88a7-1f9e-44e1-db94b6e3f516
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:54a2d644-88a7-1f9e-44e1-db94b6e3f516
msgctxt "h911f2708g5694g4220gb5d8gb0ff75963fbc"
msgid "What's that saying? Honesty late is honesty halved?"
msgstr "그 말이 뭐더라? 늦은 솔직함은 반만 솔직하다?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Player
#. NodeID = 56220748-e9e3-688d-e7ad-c941a1c26de3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WARLOCK(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:56220748-e9e3-688d-e7ad-c941a1c26de3
msgctxt "hf54fe3a7g4090g4164gbeb2g436ea813e10e"
msgid "Your mother and I have a lot in common."
msgstr "네 어머니와 난 공통점이 많은 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Player
#. NodeID = 5b2ed7ea-fd19-c4db-7335-5cb864580d99
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Object:
#.      - DEN_Stargazing_State_HasCoin(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:5b2ed7ea-fd19-c4db-7335-5cb864580d99
msgctxt "hcbd52975ge647g41e6g9ac2g5465cb7a200e"
msgid "A mind flayer abducted me, and its ship went straight to Avernus."
msgstr "마인드 플레이어가 나를 납치했고, 그것의 함선이 아베르누스로 직행했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Nadira
#. NodeID = 6119b4e9-7a41-c83b-3023-96a266709a7a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:6119b4e9-7a41-c83b-3023-96a266709a7a
msgctxt "h7de4cedeg4739g462fgab71g2b2f5d45f88b"
msgid "And now I've misplaced the cursed thing! You know what? Good riddance."
msgstr "그리고 이제 그 저주받은 물건을 잘못 놔뒀어요! 그거 알아요? 차라리 잘됐네요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Nadira
#. NodeID = 613721c2-ae9e-9f28-4d28-8f0563fb59a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:613721c2-ae9e-9f28-4d28-8f0563fb59a8
msgctxt "h2b5815cbg8136g4b89g8bddga2b5ef2e13a6"
msgid ""
"My gods. Of course. Zariel's prize soldier. You must know what it's like "
"trying to evade a devil better than anyone."
msgstr "신이시여. 물론이죠. 자리엘이 자랑스러워하는 군인이잖아요. 데빌을 피하는 게 어떤 일인지 누구보다 잘 알겠네요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Nadira
#. NodeID = 65babb23-3843-9bfb-91b3-15a9ebb6a88d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:65babb23-3843-9bfb-91b3-15a9ebb6a88d
msgctxt "h764c1bf3g0709g4e6cg8b85gebc0e89c16c1"
msgid "A new life. Imagine."
msgstr "새 삶이라. 생각만 해도."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Nadira
#. NodeID = 6fdab513-88cb-a0b2-20c1-3c9b79256e32
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:6fdab513-88cb-a0b2-20c1-3c9b79256e32
msgctxt "h86e94328g3f8bg46b7g98f2gb4f8eba8dd0b"
msgid "Well, that's quite the story."
msgstr "그것 참 대단한 이야깃거리네요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Nadira
#. NodeID = 7769d37f-e199-a0f7-d9bb-2d244df3ea23
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:7769d37f-e199-a0f7-d9bb-2d244df3ea23
msgctxt "h02aa570ag3a87g49b6g8e08g06a367ce1120"
msgid ""
"The fact that you haven't made a play for it yourself is... interesting. Who "
"<i>are </i>you?"
msgstr "이걸 가져가려고 하지 않다니... 특이하네요. 당신 <i>누구</i>에요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Nadira
#. NodeID = 7fc29258-5e06-2c0e-6dc6-42d9f8cfb880
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:7fc29258-5e06-2c0e-6dc6-42d9f8cfb880
msgctxt "h39c8fbbbgccadg4ec6g8cf7gcfc95470f281"
msgid ""
"So I'll call us even. Let me go back to relaxing away from all the noise "
"down below."
msgstr "그럼 이제 비긴 걸로 하죠. 이제 다시 저 아래에서 싸우는 소리를 피해 쉬고 싶거든요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Player
#. NodeID = 8136c69a-acd0-f7c9-b324-5461c16f7689
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Object:
#.      - DEN_Stargazing_State_HasCoin(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:8136c69a-acd0-f7c9-b324-5461c16f7689
msgctxt "h2ac55327g3836g4c60gac20g049543ed22f6"
msgid "You got me. Hand the coin over and I'll be on my way."
msgstr "딱 걸렸네. 동전을 내놓으면 순순히 떠나줄게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Nadira
#. NodeID = 828b2ddf-d450-f5e3-184a-6c8bada1c882
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:828b2ddf-d450-f5e3-184a-6c8bada1c882
msgctxt "h68b1206egbf74g4364g9ebdg940d695f5ed4"
msgid "Are we done?"
msgstr "이제 끝인가요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Player
#. NodeID = 8932e463-92f2-2470-f98b-df8e6deb926b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = False
#.      - REALLY_WYLL(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:8932e463-92f2-2470-f98b-df8e6deb926b
msgctxt "h8999ba28gb1e2g42fdga2e5gf3c4dacaab3a"
msgid "I've been to Avernus, but I'm no devil's servant."
msgstr "아베르누스에 다녀오긴 했지만, 난 데빌의 하수인 같은 게 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Player
#. NodeID = 903fa5f8-6467-7837-a158-9f81d4e79b2f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:903fa5f8-6467-7837-a158-9f81d4e79b2f
msgctxt "h982f07f5g7c72g4353g85b2gd469cc1a0d6a"
msgid "I promise I'm not working for that devil."
msgstr "그 데빌을 위해 일하지 않는다는 건 약속하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Nadira
#. NodeID = 93692d7f-4f19-41e6-dd66-886b7b2a1ddf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:93692d7f-4f19-41e6-dd66-886b7b2a1ddf
msgctxt "h1b3721d1gec48g4da7g9db9g7bc0977a7c78"
msgid ""
"And I... I don't even have the coin anymore. Beshaba take me, just bugger "
"off."
msgstr "그리고... 어차피 동전도 없어요. 베샤바 맙소사, 그냥 가요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Nadira
#. NodeID = 93b76c19-f288-8a69-a044-5448f4ee26ef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:93b76c19-f288-8a69-a044-5448f4ee26ef
msgctxt "h1512385eg5e69g4b48g9387gb6421f8974e8"
msgid ""
"Yes. No. Argh. Bloody thing's been almost more trouble than it's worth - and "
"it's worth a lot."
msgstr "네. 아뇨. 어휴. 이 망할 게 가져온 골칫거리가 자기 값어치보다 더 크겠네요. 값도 엄청 쳐주는 물건인데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Nadira
#. NodeID = 93e80978-8195-e7d5-8bc7-f95c5bbada3f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:93e80978-8195-e7d5-8bc7-f95c5bbada3f
msgctxt "hf1e64251g7ff2g4c08ga561g59c50b0b3898"
msgid ""
"Worthy of a coin, I think, except... someone seems to have picked my pocket. "
"Gods damn it all."
msgstr "동전 하나의 값어치는 있겠죠, 아마도, 하지만... 누군가 제 주머니를 턴 것 같네요. 망할."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Player
#. NodeID = 98fb39c6-6d04-0905-501d-cea7cb3b1912
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Object:
#.      - DEN_Stargazing_State_HasCoin(0) = True
#.   Tag:
#.      - BARBARIAN(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:98fb39c6-6d04-0905-501d-cea7cb3b1912
msgctxt "h2d79d57bgc542g440ag9944ge0355b97481b"
msgid "How about this? You give me the coin. <i>Now.</i>"
msgstr "이건 어때? 내게 동전을 내놓는 거야. <i>당장.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Nadira
#. NodeID = a00a304a-2fcb-a696-d2e0-0648ac7b8e3e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - DEN_Stargazing_UserMet(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Stargazing_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:a00a304a-2fcb-a696-d2e0-0648ac7b8e3e
msgctxt "hacf9334dg1861g4c9dg9026gc9e307e91cd0"
msgid ""
"Would have been breathing my last if your friend hadn't killed that bugbear."
msgstr "당신 친구가 저 버그베어를 죽이지 않았으면 전 이미 죽었을 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Nadira
#. NodeID = a0acf044-4f80-a4cc-bbea-ff3543788ea6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:a0acf044-4f80-a4cc-bbea-ff3543788ea6
msgctxt "h588d1a20gaa8fg45aaga8a0g12fb92256d0b"
msgid "I'm sure there are other bugbears to kill. Best of luck finding them."
msgstr "분명 죽여버릴 버그베어가 더 있을 거예요. 행운을 빌어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Karlach
#. NodeID = a187434c-b5f2-4aec-b70b-8c3bdd038d08
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:a187434c-b5f2-4aec-b70b-8c3bdd038d08
msgctxt "h9bb8b5a7g68e8g404egb66fg2883fa99824e"
msgid "Oh man, a soul coin? Wouldn't mind getting my hands on that..."
msgstr "오, 영혼 동전이라고? 그거 하나 있었으면 좋겠는데..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Nadira
#. NodeID = a230e836-c4ac-de52-a529-3844de99fd18
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Stargazing_State_HasCoin(0) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Stargazing_GaveCoinFreely(1) = True
#.   Global:
#.     - DEN_Stargazing_Event_NoLongerHasCoin = True
#.   Object:
#.     - DEN_Stargazing_Event_GiveCoin(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:a230e836-c4ac-de52-a529-3844de99fd18
msgctxt "h665edbc3g95d0g47dbga495g61269ea016c1"
msgid ""
"Here. Take this. It's worth a fortune. But a fortune's not worth much if "
"you're dead. Consider it payment for saving my life."
msgstr "여기. 이거 받으세요. 돈이 꽤 될 거예요. 하지만 돈도 죽으면 의미가 없죠. 제 목숨을 구해준 대가예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Nadira
#. NodeID = a6e47825-da63-d5f4-0e68-12c945e91e67
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Stargazing_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_Stargazing_HasMet(1) = True
#.   Quest:
#.     - HIDDEN_WLD_Boosters.DEN_Stargazing_Rescued(1) = True
#.   User:
#.     - DEN_Stargazing_UserMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:a6e47825-da63-d5f4-0e68-12c945e91e67
msgctxt "ha9a65df4g68b9g4107ga1e0g628fa50dab51"
msgid ""
"You have good timing. Never been much of a fighter, so wrestling a bugbear "
"would have gone poorly."
msgstr "딱 맞춰 왔네요. 싸움에는 그다지 소질이 없어서, 버그베어랑 싸웠다면 결과가 좋지 않았을 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Nadira
#. NodeID = a978dc3d-cc73-3718-5355-73307e01635d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:a978dc3d-cc73-3718-5355-73307e01635d
msgctxt "h64a1c4f2g9450g45bfgaaa1g64db62dcc9db"
msgid ""
"So thanks for the rescue, but you're welcome to the bugbear's spoils, not "
"mine."
msgstr "그러니까, 구출은 고마워요. 하지만 전리품은 죽은 버그베어한테서 챙기는 게 좋을 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Player
#. NodeID = b43f6436-00fb-6373-5d27-27762f1a9992
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:b43f6436-00fb-6373-5d27-27762f1a9992
msgctxt "ha5dd550ag20d4g4feeg99aegf7fe2ff5bde0"
msgid "How in the hells could you know about that?"
msgstr "그걸 도대체 어떻게 아는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Player
#. NodeID = b678f7b6-85ef-5821-9245-aa192a52ad9c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:b678f7b6-85ef-5821-9245-aa192a52ad9c
msgctxt "hbc76c6f8g35d0g4583g9994g703bdc3c219a"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Player
#. NodeID = b98858aa-169e-631e-5c69-586215f66ff7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:b98858aa-169e-631e-5c69-586215f66ff7
msgctxt "hc1fa7df7g299dg48a6g9333g631be5083ff8"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Player
#. NodeID = ba1a037e-b167-c59c-3eea-3fbafbe85f28
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:ba1a037e-b167-c59c-3eea-3fbafbe85f28
msgctxt "hc74438aag2642g41f4ga4f3gfe84f325d59d"
msgid "What exactly is this coin?"
msgstr "이 동전이 정확히 뭐지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Nadira
#. NodeID = bbade338-9dea-bdf1-6f9e-a4738b1f0e0e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:bbade338-9dea-bdf1-6f9e-a4738b1f0e0e
msgctxt "h4cc8e95fg53dbg4347ga0e0g83d1870f0a45"
msgid ""
"But you're not here for heroics, are you? Avernus' stench is all over your "
"skin."
msgstr "하지만 여기 영웅 놀이를 하려고 온 건 아니죠? 당신한테서 아베르누스의 악취가 진하게 느껴지는군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Narrator
#. NodeID = c59cf421-c26f-576b-e957-2fb9c6a914c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:c59cf421-c26f-576b-e957-2fb9c6a914c1
msgctxt "h768b47dagdafbg440dga4f4gaab59e7259e9"
msgid ""
"*A soul coin, true to its name, holds a mortal soul inside. It serves in the "
"Nine Hells as very valuable currency.*"
msgstr "*영혼 동전에는, 그 이름 그대로, 필멸자의 영혼이 담겨 있습니다. 아홉 지옥에서는 매우 가치 있는 화폐로 사용됩니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Player
#. NodeID = cd85118f-2322-40af-f485-df5eec81e2bc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:cd85118f-2322-40af-f485-df5eec81e2bc
msgctxt "h2ac7b14bgbe69g4f54gbe46g05705822dd47"
msgid "You wouldn't believe me if I told you."
msgstr "말해 줘도 못 믿을 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Nadira
#. NodeID = d0d777b5-7be7-5afc-6a1f-2b4bde31125d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:d0d777b5-7be7-5afc-6a1f-2b4bde31125d
msgctxt "h5ca5550eg885ag428ega637ga9e78e836599"
msgid "You might be hell-sent, but you're a bad liar."
msgstr "지옥의 냄새를 풍기고 계시지만, 거짓말에 능하진 않으시네요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Nadira
#. NodeID = d4b0d5d4-6e31-01b0-5e93-acc7864a7809
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:d4b0d5d4-6e31-01b0-5e93-acc7864a7809
msgctxt "h79c0f290gff3fg4c51gbd09gc588f19309b8"
msgid "Sure. And my father's the Dark Prince!"
msgstr "그렇겠죠. 그럼 제 아버지는 시어릭이에요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Nadira
#. NodeID = d5bedf7c-1de1-926f-20b7-0ad6b4c35ada
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:d5bedf7c-1de1-926f-20b7-0ad6b4c35ada
msgctxt "h11b55a5dg1051g46bcg84b3g07d8e18d9d40"
msgid ""
"I talked an erinyes out of her favourite soul coin without blinking. And "
"you're not half as scary as she was."
msgstr ""
"전 에리니에스에게서 그녀가 가장 아끼는 동전을 눈 하나 깜짝 안 하고 말로 얻어낸 적도 있어요. 그리고 당신은 그녀보다 조금도 무섭지 "
"않네요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Nadira
#. NodeID = d9dafd52-1c71-232b-9357-f2b9768d6037
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:d9dafd52-1c71-232b-9357-f2b9768d6037
msgctxt "hfe1801c1g84b3g4683g9201g48d3e372adc4"
msgid ""
"Yet I'd clock you as one of her bruisers a mile off. You want me to believe "
"you reek of Avernus by, what, coincidence?"
msgstr "하지만 딱 봐도 자리엘이 거느리는 떡대처럼 생겼는데요. 아베르누스 냄새는, 뭐, 우연이란 거예요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Nadira
#. NodeID = e0599fe0-a54c-a414-3501-1140f9b70ea6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:e0599fe0-a54c-a414-3501-1140f9b70ea6
msgctxt "h989db9ebg52b2g4a82g95f6ge6950eb6492c"
msgid ""
"...that's a good trade. Except the coin seems to have slipped through a hole "
"in my pocket somewhere. Damn it."
msgstr "...좋은 거래인 것 같네요. 동전이 방금 제 호주머니에 뚫린 구멍을 통해 어딘가로 떨어졌다는 사실만 빼면 말이죠. 망할."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Nadira
#. NodeID = e3c7a479-34d1-3e13-134b-4636717aa7c5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:e3c7a479-34d1-3e13-134b-4636717aa7c5
msgctxt "h98529425g2111g446cg906eg17cefb83f895"
msgid "Since you did... kill him. And I appreciate that part. So thanks."
msgstr "당신이... 그를 죽이긴 했으니까요. 그 부분은 감사히 생각해요. 그러니 고마워요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Nadira
#. NodeID = e3d8456d-5493-b044-a029-d2b289818546
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:e3d8456d-5493-b044-a029-d2b289818546
msgctxt "h57608526g86dfg4a51gb797g9dc75762f592"
msgid "Care to explain why you reek of the Hells?"
msgstr "왜 당신에게 지옥의 악취가 나는지 설명해 주시겠어요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Player
#. NodeID = e6db9fa1-97a4-57ab-2f50-448c91873a56
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Object:
#.      - DEN_Stargazing_State_HasCoin(0) = True
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:e6db9fa1-97a4-57ab-2f50-448c91873a56
msgctxt "h990ac97ag58aag4fc0gab09g822dedce300d"
msgid "No. Coin. <i>Now.</i>"
msgstr "아니. 동전. <i>당장.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Player
#. NodeID = e7190486-fa7b-2ecb-8284-eda8b821a784
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:e7190486-fa7b-2ecb-8284-eda8b821a784
msgctxt "h8e667bfdgf431g4c5bgad64g3be670ca7ac7"
msgid "The Blade of Frontiers cavorting with devils? Don't be absurd."
msgstr "변경의 칼날이 데빌과 손을 잡았다고? 말도 안되는 소리."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Player
#. NodeID = e7ae7eec-3ae7-77c8-c9cf-aa831897bd7e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:e7ae7eec-3ae7-77c8-c9cf-aa831897bd7e
msgctxt "h76ab4c7agb67dg4e0dg8c5ag929dd41f197a"
msgid ""
"The path I follow is far more noble - if you possess a devil's artefact, you "
"should leave it in my charge."
msgstr "내가 걷는 길은 훨씬 더 고귀하다. 데빌의 아티팩트를 소유하고 있다면, 내게 맡기는 게 좋을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Nadira
#. NodeID = e7e04bdf-7022-9570-5b39-5bf7ee6bff6e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:e7e04bdf-7022-9570-5b39-5bf7ee6bff6e
msgctxt "h70bf0047g4a62g4fd9g8f45g9b75202b922a"
msgid "Quite the title. Means absolutely nothing to me."
msgstr "멋진 칭호네요. 제겐 아무런 의미도 없지만요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Nadira
#. NodeID = e7f58c3c-96e4-a151-a2ab-9c5b8642999a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:e7f58c3c-96e4-a151-a2ab-9c5b8642999a
msgctxt "hf09feb25g7661g49c5gb467g450d9669ae25"
msgid "I'm glad someone can. Better in your hands than a devil's."
msgstr "정말 잘 됐네요. 데빌보다는 당신이 가지는 게 낫겠죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Player
#. NodeID = ec22a4b0-e9a8-7537-520c-e1f884eeb448
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Object:
#.      - DEN_Stargazing_State_HasCoin(0) = True
#.   Tag:
#.      - BARBARIAN(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:ec22a4b0-e9a8-7537-520c-e1f884eeb448
msgctxt "h27908e4agf280g447egbb07g38e2d83a1681"
msgid "You hand the coin over, or I kill you. How about that?"
msgstr "동전을 넘기지 않으면, 당신을 죽여버리겠어. 그건 어때?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Player
#. NodeID = ec406040-4b61-f95d-ed8c-bd387df33e8f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:ec406040-4b61-f95d-ed8c-bd387df33e8f
msgctxt "h31f6d49bg03bbg46b8ga99dg59e9a9c959b0"
msgid ""
"I ran away from Zariel's service the first chance I got. I'm making a new "
"life now."
msgstr "난 자리엘의 군대에서 기회가 생기자마자 도망쳤어. 이젠 새 삶을 살려는 중이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Nadira
#. NodeID = eccc4b04-970a-44b1-1493-2b53b9af4a90
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:eccc4b04-970a-44b1-1493-2b53b9af4a90
msgctxt "h68027d24gb859g4a61gb09ag0f58cbf8808a"
msgid "I hope it brings you better luck than it has me."
msgstr "당신에겐 저보다 행운을 가져다주길 바라죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Nadira
#. NodeID = f67134ee-5f71-f90f-b79a-2e11e90a4466
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:f67134ee-5f71-f90f-b79a-2e11e90a4466
msgctxt "h0104b5ddg9314g4aa9gb7d9g2561cad0673b"
msgid "My mother's a warlock. Taught me when a fiend's tongue is twisting."
msgstr "제 어머니가 워락이에요. 마족이 거짓말을 하는 걸 간파하는 방법을 가르치셨죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Karlach
#. NodeID = f6a598f3-c400-d896-507d-e72cf3ed3d5b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:f6a598f3-c400-d896-507d-e72cf3ed3d5b
msgctxt "h19686c69g8c7eg44ebg9e9eg39d9449f2aae"
msgid "<i>Deadly.</i> Wait 'til you see what I can do with that thing."
msgstr "<i>죽여주네.</i> 내가 그걸로 어떤 것까지 할 수 있는지 지켜만 보라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing
#. Speaker = Nadira
#. NodeID = ffca0f71-adf2-9684-77e6-f81594c70406
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing:ffca0f71-adf2-9684-77e6-f81594c70406
msgctxt "h120ad9b9gff81g415cga1d2gac7dada564ad"
msgid "I'm going to be chased all over Faerûn for this damn coin, aren't I?"
msgstr "이 망할 동전 때문에 페이룬 어디를 가도 추격당하겠죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing_Telescope
#. Speaker = Narrator
#. NodeID = 1bc70a20-350c-5923-bc64-441e1156dd9d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = True
#. SetFlags:
#.   Global:
#.     - DEN_Stargazing_Event_SawDragon = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing_Telescope:1bc70a20-350c-5923-bc64-441e1156dd9d
msgctxt "hc92e756dg229eg43b7g822ag1185f1bb7aae"
msgid ""
"*You recognise the dragon as the mount of a githyanki knight. Perhaps it had "
"been tracking the ship.*"
msgstr "*당신은 드래곤이 기스양키 기사가 타는 것임을 알아봅니다. 함선을 쫓고 있었던 것인지도 모릅니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing_Telescope
#. Speaker = Narrator
#. NodeID = 2e81c3f4-e56d-c262-373d-9e426966781d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Stargazing_State_Left = True
#.      - DEN_Stargazing_State_Right = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing_Telescope:2e81c3f4-e56d-c262-373d-9e426966781d
msgctxt "h9eae7cb4g6d88g4dc9gafbbg325d9226db10"
msgid "*The telescope points straight ahead.*"
msgstr "*망원경이 정면을 향합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing_Telescope
#. Speaker = Narrator
#. NodeID = 3b9a3efb-2e45-c9ac-a113-800b7d4e8c2e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Stargazing_State_Left = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing_Telescope:3b9a3efb-2e45-c9ac-a113-800b7d4e8c2e
msgctxt "h7bb85a9cgd33ag46e9g9b8ag06ae62081486"
msgid "*The telescope points to the left.*"
msgstr "*망원경이 왼쪽을 향합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing_Telescope
#. Speaker = Player
#. NodeID = 3ba41e7d-aaa0-4b40-83eb-95a57a66e65a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Stargazing_State_Left = True
#.      - DEN_Stargazing_State_Right = True
#. SetFlags:
#.   Global:
#.     - DEN_Stargazing_State_Left = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing_Telescope:3ba41e7d-aaa0-4b40-83eb-95a57a66e65a
msgctxt "h214b5270g7648g4089gaf2eg548e7d0bdc67"
msgid "<i>Move the telescope to the right.</i>"
msgstr "<i>망원경을 오른쪽으로 돌린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing_Telescope
#. Speaker = Player
#. NodeID = 47f54e0c-139c-7313-a4eb-e41c7a715c5c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing_Telescope:47f54e0c-139c-7313-a4eb-e41c7a715c5c
msgctxt "h7d613fc9ge80fg49c8g9d1egf58085eb4f59"
msgid ""
"<i>Focus the telescope on the distant object, trying to get a clear view.</i>"
msgstr "<i>멀리 있는 형체에 망원경 초점을 맞춰 선명한 시야를 확보한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing_Telescope
#. Speaker = Player
#. NodeID = 7006d384-b095-d403-0513-af430aece279
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Stargazing_State_Left = False
#.      - DEN_Stargazing_State_Right = True
#. SetFlags:
#.   Global:
#.     - DEN_Stargazing_State_Left = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing_Telescope:7006d384-b095-d403-0513-af430aece279
msgctxt "h54be2933g87e7g46b4g9e1ag254fa499835d"
msgid "<i>Move the telescope to the left.</i>"
msgstr "<i>망원경을 왼쪽으로 돌린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing_Telescope
#. Speaker = Player
#. NodeID = 7e4ba805-aa1c-e783-0150-dc8cd7e3a7e8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing_Telescope:7e4ba805-aa1c-e783-0150-dc8cd7e3a7e8
msgctxt "h230140c4g2152g448cgbce6gd4ce0484944d"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing_Telescope
#. Speaker = Player
#. NodeID = 8c934c64-127b-ac55-83db-3655f8577c50
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing_Telescope:8c934c64-127b-ac55-83db-3655f8577c50
msgctxt "hcc5df3d1ge29dg4542g9c5agcf835684d7fa"
msgid ""
"<i>Squint at the distant object, trying to make out further details.</i>"
msgstr "<i>눈을 가늘게 떠 멀리 있는 형체를 자세히 들여다본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing_Telescope
#. Speaker = Narrator
#. NodeID = 9974510c-560a-50d2-5d16-5ff305695d27
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Stargazing_Event_SawDragon = True
#. TagRule: RANGER or WIZARD
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing_Telescope:9974510c-560a-50d2-5d16-5ff305695d27
msgctxt "h2cd20daeg0008g46d1gb774ga61098f36307"
msgid ""
"*You see a red dragon. Tyrannical, greedy and vain; they hunt without pity.*"
msgstr "*레드 드래곤이 보입니다. 폭압적이고, 탐욕스러우며 자만심에 차, 동정심 없이 사냥감을 노립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing_Telescope
#. Speaker = Narrator
#. NodeID = ab2d4daf-17fd-9bcd-aa90-4a2ac10b2a8b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Stargazing_State_Right = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing_Telescope:ab2d4daf-17fd-9bcd-aa90-4a2ac10b2a8b
msgctxt "h25f3c552geab3g4931g9835g0075d1fca25c"
msgid "*The telescope points to the right.*"
msgstr "*망원경이 오른쪽을 향합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing_Telescope
#. Speaker = Player
#. NodeID = b9a8acc3-a678-3f15-e886-6d8f6fe8cc6a
#. HandlePath = TaggedText[0].TagText[0]
