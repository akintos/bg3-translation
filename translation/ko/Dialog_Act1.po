#.     - DEN_HarpyMeal_Event_OriginCharm2(0) = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerCharmed:dca2f7f5-2185-318c-406d-1c4cc0729e0c
msgctxt "h13c66f76gd434g4970g9812g566e1ec72e4e"
msgid "Such sweet music... I must listen..."
msgstr "너무 달콤한 음악이야... 경청해야만 해..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerCharmed
#. Speaker = Player
#. NodeID = dca2f7f5-2185-318c-406d-1c4cc0729e0c
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_HarpyMeal_Event_OriginCharm1(0) = True
#.      - DEN_HarpyMeal_Event_OriginCharm2(0) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_HarpyMeal_Event_OriginCharm2(0) = True
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerCharmed:dca2f7f5-2185-318c-406d-1c4cc0729e0c
msgctxt "h5123efa4g6213g4b88gb1a0g9d3caa187485"
msgid "Music from the heavens..."
msgstr "천상의 음악이야..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerCharmed
#. Speaker = Player
#. NodeID = ee26319d-fe47-0cce-085b-abd34238ee32
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_HarpyMeal_Event_CharmedLine4 = True
#.      - DEN_HarpyMeal_Event_CharmedLine5 = False
#. SetFlags:
#.   Global:
#.     - DEN_HarpyMeal_Event_CharmedLine5 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerCharmed:ee26319d-fe47-0cce-085b-abd34238ee32
msgctxt "h8c931db6gff90g4d74ga7d7g0483a7f157f4"
msgid "Don't stop singing..."
msgstr "노래를 멈추지 말아 줘..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerCharmed
#. Speaker = Player
#. NodeID = f76a0c69-7d6b-a8e7-169c-ec91bd1030bf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_HarpyMeal_Event_CharmedLine8 = False
#.      - DEN_HarpyMeal_Event_CharmedLine7 = True
#. SetFlags:
#.   Global:
#.     - DEN_HarpyMeal_Event_CharmedLine8 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerCharmed:f76a0c69-7d6b-a8e7-169c-ec91bd1030bf
msgctxt "hd034a46dg54e8g44bdgb14eg30403a54731e"
msgid "I've never heard something so beautiful..."
msgstr "이렇게 아름다운 노래는 처음이야..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerUncharmed
#. Speaker = Player
#. NodeID = 1ed0c01e-aeaf-08c0-ee13-1ba5bbefb00c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_HarpyMeal_Event_UncharmedLine2 = True
#.      - DEN_HarpyMeal_Event_UncharmedLine3 = False
#. SetFlags:
#.   Global:
#.     - DEN_HarpyMeal_Event_UncharmedLine3 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerUncharmed:1ed0c01e-aeaf-08c0-ee13-1ba5bbefb00c
msgctxt "h91afc6d8g4129g4e9ega90eg54436311fbe7"
msgid "No... this isn't right..."
msgstr "안돼... 뭔가 잘못되었어..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerUncharmed
#. Speaker = Player
#. NodeID = b681ad47-c0cf-e336-a814-bd3f47db7112
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_HarpyMeal_Event_UncharmedLine1 = False
#. SetFlags:
#.   Global:
#.     - DEN_HarpyMeal_Event_UncharmedLine1 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerUncharmed:b681ad47-c0cf-e336-a814-bd3f47db7112
msgctxt "h1069ac38g4cd0g460fgafa8g2cd7e8e3051f"
msgid "What... what happened?"
msgstr "무슨... 어떻게 된 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerUncharmed
#. Speaker = Player
#. NodeID = e22a7b7b-b99c-89ec-443e-a6400c565f33
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_HarpyMeal_Event_UncharmedLine2 = False
#.     - DEN_HarpyMeal_Event_UncharmedLine3 = False
#.     - DEN_HarpyMeal_Event_UncharmedLine1 = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerUncharmed:e22a7b7b-b99c-89ec-443e-a6400c565f33
msgctxt "h870c4629g8012g42eag8241g3a9fe820101c"
msgid "What... what was that?"
msgstr "뭐... 뭐였지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerUncharmed
#. Speaker = Player
#. NodeID = f7e5337a-6758-e3dc-e16e-365f1b45f514
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_HarpyMeal_Event_UncharmedLine2 = False
#.      - DEN_HarpyMeal_Event_UncharmedLine1 = True
#. SetFlags:
#.   Global:
#.     - DEN_HarpyMeal_Event_UncharmedLine2 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerUncharmed:f7e5337a-6758-e3dc-e16e-365f1b45f514
msgctxt "hb6f78eecg6903g4111g8e71g4cf821dcfa6c"
msgid "Stay out of my head!"
msgstr "내 머릿속에서 나가!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerUncharmed
#. Speaker = Player
#. NodeID = fbd31cb2-cf28-4a2e-fb5e-1f237e797989
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerUncharmed:fbd31cb2-cf28-4a2e-fb5e-1f237e797989
msgctxt "h6d5c3c99g3406g47ebga188g03c2bbfc8912"
msgid "I'll skin you alive, you fowl wretch!"
msgstr "산 채로 가죽을 벗겨주마, 이 새 새끼야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerUncharmed
#. Speaker = Player
#. NodeID = fbd31cb2-cf28-4a2e-fb5e-1f237e797989
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerUncharmed:fbd31cb2-cf28-4a2e-fb5e-1f237e797989
msgctxt "h70c06b7bg05e6g43aega619g7ac9cd54ffa2"
msgid "Gah - villain! But I see you now for what you are!"
msgstr "세상에 - 악당 녀석! 이제야 네 본모습을 알겠군!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerUncharmed
#. Speaker = Player
#. NodeID = fbd31cb2-cf28-4a2e-fb5e-1f237e797989
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerUncharmed:fbd31cb2-cf28-4a2e-fb5e-1f237e797989
msgctxt "h8a8eff9fgbe72g49b1g9c2bg9b0cbe651e0d"
msgid "You'll die for this, creature."
msgstr "넌 이것 때문에 죽는다. 괴물아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerUncharmed
#. Speaker = Player
#. NodeID = fbd31cb2-cf28-4a2e-fb5e-1f237e797989
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerUncharmed:fbd31cb2-cf28-4a2e-fb5e-1f237e797989
msgctxt "hc6d484a2ga714g4f79ga172g46a13fcf0533"
msgid "What is this? I will have your head, harpy!"
msgstr "이 상황은 뭐지? 네 머리를 가져가 주마, 하피 년아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerUncharmed
#. Speaker = Player
#. NodeID = fbd31cb2-cf28-4a2e-fb5e-1f237e797989
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerUncharmed:fbd31cb2-cf28-4a2e-fb5e-1f237e797989
msgctxt "h8def36c6g078ag437ag8d4cgef7559e9e673"
msgid "Foul winged charlatan! Your tricks will cost you!"
msgstr "망할 날개달린 사기꾼! 네 속임수는 대가를 치를 것이다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerUncharmed
#. Speaker = Player
#. NodeID = fbd31cb2-cf28-4a2e-fb5e-1f237e797989
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerUncharmed:fbd31cb2-cf28-4a2e-fb5e-1f237e797989
msgctxt "hf7b9096bg0876g4022gbf92ge7dccc3ed50d"
msgid "Wh- what now? Damned monster. I'll make you pay!"
msgstr "뭐...뭐였지 지금? 빌어먹을 괴물 자식. 대가를 치르게 해 주겠다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerWarnings
#. Speaker = Player
#. NodeID = 32876edc-2479-8ee1-873a-666829f25bd3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerWarnings:32876edc-2479-8ee1-873a-666829f25bd3
msgctxt "h587f4c79g4d62g4b4eg85beg252416bb5021"
msgid "Is someone... singing?"
msgstr "누가... 노래하고 있는 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerWarnings
#. Speaker = Player
#. NodeID = d370de8c-8c4b-e639-a640-57321896dcc8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerWarnings:d370de8c-8c4b-e639-a640-57321896dcc8
msgctxt "h192ddebeg9514g4c4dg99fcg51ef233b7de2"
msgid "It's beautiful..."
msgstr "아름다워..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AfterHarpyEncounter
#. Speaker = Mirkon
#. NodeID = 0105860e-2456-4932-fe92-e56a3acdcaa8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AfterHarpyEncounter:0105860e-2456-4932-fe92-e56a3acdcaa8
msgctxt "h26710410geea1g48f5ga282gd64fda5585e8"
msgid "W-who are you?"
msgstr "대... 대체 누구시죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AfterHarpyEncounter
#. Speaker = Mirkon
#. NodeID = 05f6a8e9-12ec-ce00-7301-29b3da40f8bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AfterHarpyEncounter:05f6a8e9-12ec-ce00-7301-29b3da40f8bf
msgctxt "h159f26adg2ac4g4244g8a5eg4c5f68928baf"
msgid "She'll be so mad. I didn't get the gold from the nest. I got to go."
msgstr "화가 단단히 났을 거예요. 제가 둥지에서 금을 못 가져왔거든요. 얼른 가 봐야겠어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AfterHarpyEncounter
#. Speaker = Mirkon
#. NodeID = 112a2075-27d9-bbae-4126-e64533acb6a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AfterHarpyEncounter:112a2075-27d9-bbae-4126-e64533acb6a4
msgctxt "hd5ba5079g8b27g4a7fg92f5g28c71ca59e31"
msgid "Really? You think so? I'll tell Mol! Oh no..."
msgstr "정말요? 그렇게 생각해요? 몰한테도 말해야겠어요! 오 이런..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AfterHarpyEncounter
#. Speaker = Player
#. NodeID = 15eb2d22-953a-4a33-7cd4-31207cb3971c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AfterHarpyEncounter:15eb2d22-953a-4a33-7cd4-31207cb3971c
msgctxt "hcdbb7cdag49dfg4076g909fge6ef4f357a36"
msgid "Go back to your parents. There's worse in the wilds than harpies."
msgstr "부모님에게 돌아가. 이 황야에서 하피보다 더 악랄한 건 없으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AfterHarpyEncounter
#. Speaker = Mirkon
#. NodeID = 444b5c43-8e3b-6c55-e2dd-244bccfad592
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AfterHarpyEncounter:444b5c43-8e3b-6c55-e2dd-244bccfad592
msgctxt "hfd914f3fg42f3g4929gbce4g399c4fbd8d73"
msgid "No - yes - I mean... I don't know!"
msgstr "아뇨 - 네 - 제 말은... 저도 모르겠어요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AfterHarpyEncounter
#. Speaker = Mirkon
#. NodeID = 4e5dfa8a-cd88-57a6-c216-098c7a059fd4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AfterHarpyEncounter:4e5dfa8a-cd88-57a6-c216-098c7a059fd4
msgctxt "hd0b05787g6617g4ef4g9ab2gb62d9a98e6cf"
msgid "I-I had to get the gold from the nest. Mol will be so mad. I got to go."
msgstr "저- 저는 저 둥지에서 금을 가져가야 해요. 몰이 분명 많이 화낼거예요. 난 가야만해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AfterHarpyEncounter
#. Speaker = Player
#. NodeID = 5420ba4d-28be-ea53-260b-55f21cbbb86f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AfterHarpyEncounter:5420ba4d-28be-ea53-260b-55f21cbbb86f
msgctxt "he32fb055g7acfg49d1g9285g498be52febe4"
msgid ""
"Stop snivelling or they'll be back. They like tasty little tiefling kids."
msgstr "계속 훌쩍거리면 그놈들이 돌아올 거야. 작고 맛있는 티플링 꼬마애를 좋아하거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AfterHarpyEncounter
#. Speaker = Mirkon
#. NodeID = 6d8cf6be-32c6-5eba-4484-5cc5d057d0f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AfterHarpyEncounter:6d8cf6be-32c6-5eba-4484-5cc5d057d0f4
msgctxt "ha4107570g344cg4118gb98cg40cd7f5fd884"
msgid "Wauw... I'm Mirkon, I - oh no."
msgstr "와... 전 미크론이에요, 저는 - 아 이런.."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AfterHarpyEncounter
#. Speaker = Mirkon
#. NodeID = 94ba2620-4b5c-3e8d-f112-e55c5119df18
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AfterHarpyEncounter:94ba2620-4b5c-3e8d-f112-e55c5119df18
msgctxt "h19c22ae3g949ag43f1g94fcg8d3ab71e2b77"
msgid "A-are they gone?"
msgstr "그-그것들은 죽었나요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AfterHarpyEncounter
#. Speaker = Player
#. NodeID = 98ce2cf9-b4a7-bf34-7285-6ef86fe1cfdc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#. TagRule:
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AfterHarpyEncounter:98ce2cf9-b4a7-bf34-7285-6ef86fe1cfdc
msgctxt "h8446519dg4137g49e1g8ddfg186866f52517"
msgid "<i>Soothe the child with a calming tune.</i>"
msgstr "<i>차분한 연주로 아이를 달랜다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AfterHarpyEncounter
#. Speaker = Player
#. NodeID = 9a2caaa8-edc2-d7ea-7c59-c7fba658a041
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AfterHarpyEncounter:9a2caaa8-edc2-d7ea-7c59-c7fba658a041
msgctxt "h82b8f21bgeedfg40fdg84d9g38872da4d6d3"
msgid "Never mind that - are you all right?"
msgstr "그건 신경 쓰지 마. 좀 괜찮니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AfterHarpyEncounter
#. Speaker = Mirkon
#. NodeID = a00a9935-cfbf-6be1-21fd-5393f833fd58
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AfterHarpyEncounter:a00a9935-cfbf-6be1-21fd-5393f833fd58
msgctxt "h0c488c9fga71bg41b3g99bcg3d09372c94b5"
msgid "Th-they're gone. Now there's just Mol."
msgstr "부... 부모님은 돌아가셨어요. 지금은 몰밖에 없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AfterHarpyEncounter
#. Speaker = Player
#. NodeID = a0b850f0-50f2-b80b-bb1e-c3f78594000f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AfterHarpyEncounter:a0b850f0-50f2-b80b-bb1e-c3f78594000f
msgctxt "h97860575g1cf1g461bgbb91g2d67a33d9a48"
msgid "You were brave, child. Heroic, even. You're <i>safe </i>now."
msgstr "너는 용감하구나, 꼬마야. 영웅적일 정도야. 너는 지금 <i>안전해</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AfterHarpyEncounter
#. Speaker = Mirkon
#. NodeID = b2de5477-4b4a-de13-41f4-a2142119cf7e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AfterHarpyEncounter:b2de5477-4b4a-de13-41f4-a2142119cf7e
msgctxt "heb5fbb4dgb44bg46dbg817fga093d92a86f0"
msgid ""
"Th-that's what the voice said. I almost got to the nest, but the singing..."
msgstr "그-그게 목소리가 말한 것이었어요. 둥지에 거의 다다랐는데, 노래가..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AfterHarpyEncounter
#. Speaker = Player
#. NodeID = b69f02c2-469c-ea96-89ee-50dfc3facb0a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AfterHarpyEncounter:b69f02c2-469c-ea96-89ee-50dfc3facb0a
msgctxt "h4800b9deg5859g4231g9ec4gbe023a77b944"
msgid ""
"Calm there. You're a hero. You survived a harpy's wily lullaby, my friend. "
"Be proud."
msgstr "진정해. 넌 영웅이야. 하피의 교활한 자장가에서 살아남았잖아, 친구야. 자랑스러워 해도 돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AfterHarpyEncounter
#. Speaker = Player
#. NodeID = bf0c05d0-c949-8505-22dd-b1d617160e34
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AfterHarpyEncounter:bf0c05d0-c949-8505-22dd-b1d617160e34
msgctxt "h8dc63919g741bg4fbfg9fe0gaaa8f3d6fd37"
msgid "Take a breath, deep and slow. You're safe now."
msgstr "심호흡해 봐, 천천히 그리고 깊게. 너는 이제 안전해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AfterHarpyEncounter
#. Speaker = Mirkon
#. NodeID = c15aa8f2-c2c8-24d5-6da1-821fd54d236f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_HarpyMeal_State_HarpyEncounterOver = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AfterHarpyEncounter:c15aa8f2-c2c8-24d5-6da1-821fd54d236f
msgctxt "h059543a8g397bg4102gb7e7g75985c8e720a"
msgid "*Sniff.*"
msgstr "*훌쩍.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AfterHarpyEncounter
#. Speaker = Player
#. NodeID = c8ba548d-9769-6e02-d675-e63d0ee829dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AfterHarpyEncounter:c8ba548d-9769-6e02-d675-e63d0ee829dc
msgctxt "h8ed4a52cg832cg45beg8f2egdd1bfc3032a4"
msgid ""
"I'm [GEN_PlayerName_c11eee1e-7815-6143-7233-f2427799fa53], slayer of "
"monsters, teller of tales, saviour of you. The pleasure's mine."
msgstr ""
"나는 [GEN_PlayerName_c11eee1e-7815-6143-7233-f2427799fa53]. 괴물을 무찌르고, 전설을 노래하는 "
"네 구원자지. 감사 인사는 넣어 둬."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AfterHarpyEncounter
#. Speaker = Mirkon
#. NodeID = cb5fc1df-7905-4cae-c773-e019555e1364
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AfterHarpyEncounter:cb5fc1df-7905-4cae-c773-e019555e1364
msgctxt "h32cb3045g0fe3g49b8g9804g8a109fa2521e"
msgid "I need to get back. Mol will be so mad."
msgstr "저는 돌아가야겠네요. 몰이 엄청 화내겠지만요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AfterHarpyEncounter
#. Speaker = Player
#. NodeID = d06d0afe-429b-ce85-0773-bc4f227905b8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AfterHarpyEncounter:d06d0afe-429b-ce85-0773-bc4f227905b8
msgctxt "h11ec1650ge72dg468cgbe8bg0727c887db9a"
msgid "They're gone. Are you all right?"
msgstr "죽었어. 너는 괜찮니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AfterHarpyEncounter
#. Speaker = Mirkon
#. NodeID = d2d92c71-c0e2-9d80-5361-355a80fbcdc7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_HarpyMeal_Event_KidReturnHideout = True
#.   Quest:
#.     - DEN_HarpyMeal.DoneKidFled_NoThank(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AfterHarpyEncounter:d2d92c71-c0e2-9d80-5361-355a80fbcdc7
msgctxt "h4035d575ge596g48b6gab39g940dee358bc2"
msgid "A-aahhhh!"
msgstr "아- 아아악!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AfterHarpyEncounter
#. Speaker = Mirkon
#. NodeID = d3a1e647-c2a6-4eb2-dc25-5bea1407b50f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_HarpyMeal_Event_AfterCombatHasMet = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AfterHarpyEncounter:d3a1e647-c2a6-4eb2-dc25-5bea1407b50f
msgctxt "h468ddb4ag13d6g4069ga687gddd375e54221"
msgid "Wait, umm... you should meet Mol. She'll be grateful you helped me."
msgstr "맞다, 음... 몰을 만나 보세요. 오늘 일에 고마워할 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AfterHarpyEncounter
#. Speaker = Mirkon
#. NodeID = e952320e-7a26-6e98-5aa9-076404c22678
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_HarpyMeal_Knows_HideoutPassword = True
#.     - DEN_HarpyMeal_Event_KidReturnHideout = True
#.   Object:
#.     - DEN_HarpyMeal_Event_Gale_GotChildRescueApproval(1) = True
#.     - DEN_HarpyMeal_State_RescuedChild(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AfterHarpyEncounter:e952320e-7a26-6e98-5aa9-076404c22678
msgctxt "h3b9eb976ga9b3g4a1fgb6a2gdfbe3bfc6215"
msgid "Find a boy called Doni. Tell him you want to see the 'Dragon's Lair'."
msgstr "도니라는 애를 찾으세요. '드래곤의 동굴'을 찾길 원한다고 말하면 돼요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim
#. Speaker = Narrator
#. NodeID = 03428ac1-4c05-e77c-eadd-9e3c374ae5e8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_HarpyMeal_Event_LeaderDialogEnter(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim:03428ac1-4c05-e77c-eadd-9e3c374ae5e8
msgctxt "he5fa859fg3471g4c0ega4a6ga02d0f982dea"
msgid ""
"*Your chest fills with yearning. You want to get closer - you <i>need </i>to "
"get closer.*"
msgstr "*당신의 가슴이 그리움으로 가득 찹니다. 당신은 가까이 가고 싶습니다. 가까이 <i>가야 합니다</i>.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim
#. Speaker = Mirkon
#. NodeID = 0518cd2b-030b-1e65-59ae-add3a3308beb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim:0518cd2b-030b-1e65-59ae-add3a3308beb
msgctxt "h699b34dega312g4c7aga726g9e00eb3da99b"
msgid ""
"No, no. It's just a bit of water. I only want to listen. Just a little "
"closer..."
msgstr "아뇨, 아뇨. 잔잔한 물가일 뿐이에요. 그냥 좀 귀를 기울이려고요. 조금만 더 가까이 가면..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim
#. Speaker = Narrator
#. NodeID = 0f30cf87-461d-45e3-83cb-288c939fa091
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim:0f30cf87-461d-45e3-83cb-288c939fa091
msgctxt "hbbda82e8g84bfg499fga489gf0d96c1cef99"
msgid "*You slip your hand into his pocket but find nothing.*"
msgstr "*주머니에 손을 집어넣지만 아무것도 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim
#. Speaker = Player
#. NodeID = 113090f7-1508-6ea6-e4e8-4157ab768d87
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#. SetFlags:
#.   Local:
#.     - 9b644c9c-a50c-b817-81fa-fff6509e9644_StartedBardSong = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim:113090f7-1508-6ea6-e4e8-4157ab768d87
msgctxt "h17b5d72dg509eg4eb1g875eg17dd2885e397"
msgid ""
"<i>Focus by singing:</i> <i>'There once was a lady who met with a merrow, "
"and tried to disclose it to her foolish fellow...'</i>"
msgstr ""
"<i>노래를 불러 집중한다:</i> <i>'인어를 만난 여인이 있었다네, 그런데 한심한 친구에게 비밀을 말하고 말았다네...'</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim
#. Speaker = Narrator
#. NodeID = 11d69513-d82b-5e1f-aca1-d6174697dd98
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim:11d69513-d82b-5e1f-aca1-d6174697dd98
msgctxt "h2103a5f2gc971g4530g913ag8013ce2e8373"
msgid ""
"*A sweet melody plays above the waves, beckoning you - drowning out all "
"logical thought.*"
msgstr "*파도 위로 감미로운 멜로디가 흘러나오며 당신을 유혹합니다. 모든 논리적인 생각을 가라앉게 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim
#. Speaker = Player
#. NodeID = 1545cd4f-be62-8ae2-e75a-087668b3339e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 5
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim:1545cd4f-be62-8ae2-e75a-087668b3339e
msgctxt "hc43b9568g5191g44c0g91a1g666859244de5"
msgid "<i>Struggle against the music's pull.</i>"
msgstr "<i>음악의 유혹에 저항한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim
#. Speaker = Player
#. NodeID = 313b049e-131b-f776-45a5-2d4ada1c13ff
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 5
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim:313b049e-131b-f776-45a5-2d4ada1c13ff
msgctxt "h276107f5g42e0g40f7g9918gb6b82ac5ea69"
msgid "<i>Struggle against the music's pull.</i>"
msgstr "<i>음악의 유혹에 저항한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim
#. Speaker = Mirkon
#. NodeID = 34ac7898-89ee-55eb-6268-2ad39f035b97
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_HarpyMeal_Event_VictimWalkToWater = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim:34ac7898-89ee-55eb-6268-2ad39f035b97
msgctxt "h27f997cbg8129g483cga0f2gddac68478b77"
msgid "Yes, everything's gonna be fine... once I get there..."
msgstr "그래, 모든 게 괜찮아질 거야... 저기 다다르기만 하면..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim
#. Speaker = Narrator
#. NodeID = 371da1a6-bef8-8036-d753-a7d2eff4f89e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_HarpyMeal_Event_VictimWalkToWater = True
#.   Object:
#.     - DEN_HarpyMeal_Event_PlayerSuccumbedCharm(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim:371da1a6-bef8-8036-d753-a7d2eff4f89e
msgctxt "h3d58c22egf9c9g44feg9cbfge25c1a733a86"
msgid ""
"*Just a few more steps... and you can lose yourself in that sweet song...*"
msgstr "*몇 걸음만 더 가면... 당신은 그 감미로운 노래에 빠져들 수 있습니다...*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim
#. Speaker = Player
#. NodeID = 3c82d029-82da-2c40-3c4b-f8eebfb00e6a
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 5
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim:3c82d029-82da-2c40-3c4b-f8eebfb00e6a
msgctxt "hcdbec37bg34d8g478bg9e65g7652c981069a"
msgid "<i>Struggle against the music's pull.</i>"
msgstr "<i>음악의 유혹에 저항한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim
#. Speaker = Mirkon
#. NodeID = 487a8737-3ead-c268-4cd8-ccdce0dd3256
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim:487a8737-3ead-c268-4cd8-ccdce0dd3256
msgctxt "h1cf12094g187cg4741g895cgb7b44cc12a8c"
msgid "Shh! Listen."
msgstr "쉬이잇! 들어봐요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim
#. Speaker = Player
#. NodeID = 4faa2183-ce0a-43db-e2d2-80a59eae4375
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Local:
#.      - 9b644c9c-a50c-b817-81fa-fff6509e9644_StartedBardSong = True
#.   Tag:
#.      - BARD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim:4faa2183-ce0a-43db-e2d2-80a59eae4375
msgctxt "haf18bbb6g327bg4cb0g81c4ga1c860eaeda8"
msgid ""
"<i>'... Her man would not listen, he thought it tall tales, until he rubbed "
"up against all of her scales!' </i>"
msgstr "<i>'... 남자는 그 말 도통 듣지를 않았지, 코웃음치다가 온통 비늘에 긁혔지!'</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim
#. Speaker = Narrator
#. NodeID = 540bdce9-6230-2892-3d44-486d1c4f4881
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_HarpyMeal_State_ImmuneHarpy_01(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim:540bdce9-6230-2892-3d44-486d1c4f4881
msgctxt "h86a4e006gd463g4753g9393g678871a7d6d3"
msgid ""
"*The suffocating yearning suddenly fades as the spell breaks. You are free.*"
msgstr "*주문이 풀리면서 숨 막히는 갈망이 갑자기 사라집니다. 당신은 자유입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim
#. Speaker = Player
#. NodeID = 56104da2-dc47-9d65-9aa5-31d16b3c084c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim:56104da2-dc47-9d65-9aa5-31d16b3c084c
msgctxt "hbe005e36g1681g45b6gb8c2g01fb27624357"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim
#. Speaker = Player
#. NodeID = 5a6ab054-6389-191d-a9c8-c7029deb0cf6
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Dexterity
#. DifficultyClass: 5
#. TagRule: ROGUE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim:5a6ab054-6389-191d-a9c8-c7029deb0cf6
msgctxt "h8bd6ba9fg3cc1g44c2g91a9ge3968e8f33bb"
msgid "<i>Pick his pockets while he's distracted.</i>"
msgstr "<i>아이가 정신이 팔린 사이 주머니를 턴다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim
#. Speaker = Harpy
#. NodeID = 6a230fef-eae2-9fcb-2e1c-bfdbc432d927
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_HarpyMeal_Event_HarpyDialogEnter = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim:6a230fef-eae2-9fcb-2e1c-bfdbc432d927
msgctxt "hee69e350g7854g47a6gb3c4g18fdfe1ebab9"
msgid "Kill! We'll KILL you!"
msgstr "죽여! 널 <b>죽여</b>버리겠다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim
#. Speaker = Astarion
#. NodeID = 6db84313-a525-eb60-02fd-593dcfeb8880
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim:6db84313-a525-eb60-02fd-593dcfeb8880
msgctxt "haa6f3f68gfcd9g499eg97b8g50051a5c8040"
msgid "You villain! I didn't know you had it in you."
msgstr "이런 악당! 너에게 그런 면모가 있는 줄 몰랐는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim
#. Speaker = Player
#. NodeID = 72cb5382-2608-348b-f29d-e784208c9c55
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim:72cb5382-2608-348b-f29d-e784208c9c55
msgctxt "h799d1abfgafabg4263g8364gd339dfbb4da3"
msgid "Get back - it's a trick!"
msgstr "물러서 - 이건 속임수야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim
#. Speaker = Player
#. NodeID = 73591cf3-b1b4-8a95-add4-73f62e533d9c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - SORCERER(1) = True
#. TagRule: SORCERER_DRACONIC
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim:73591cf3-b1b4-8a95-add4-73f62e533d9c
msgctxt "ha6b176a5g4392g4b2cga62bg116f8575b68d"
msgid ""
"<i>Foul creatures - mere carrion birds compared to your bloodline. Focus the "
"will of the dragon against their song.</i>"
msgstr "<i>저급한 생물들. 용의 혈통에 비하면 그저 청소부 새일 뿐이다. 드래곤의 의지로 노래에 저항한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim
#. Speaker = Player
#. NodeID = 73591cf3-b1b4-8a95-add4-73f62e533d9c
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: RawAbility
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - SORCERER(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim:73591cf3-b1b4-8a95-add4-73f62e533d9c
msgctxt "hb76a97aagb11ag4eb2ga9c3g6151f9bd35d3"
msgid "<i>Focus your will. Improvise a magical shell to dampen the music.</i>"
msgstr "<i>의지를 집중한다. 노랫소리를 막는 마법 결계를 즉흥적으로 만든다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim
#. Speaker = Harpy
#. NodeID = 736ec2d2-1ea8-2963-268a-f1e44ef6886c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim:736ec2d2-1ea8-2963-268a-f1e44ef6886c
msgctxt "hb2073f6eg65a0g4c4agadcdg68d51cb6d635"
msgid "No! He's <i>ours</i>."
msgstr "안 돼! 녀석은 <i>우리 꺼야</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim
#. Speaker = Mirkon
#. NodeID = 7673d098-88f3-0583-eae2-4df979a41a79
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - MUTED(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim:7673d098-88f3-0583-eae2-4df979a41a79
msgctxt "h298e6daeg9996g4581gbbeag2808f4d6d297"
msgid "Shh! Listen."
msgstr "쉬이잇! 들어봐요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_CharmedVictim
#. Speaker = Player
