msgctxt "h70c78cedg5c67g4894g9e20g350eab453e3f"
msgid "Lovely rhythm, that. Pity the drum's for callin' in backup."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_AlarmUsedReaction
#. Speaker = Sentinel Olak
