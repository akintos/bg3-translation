msgctxt "hbf7054f1g6163g450dg86d4g356afaa2b152"
msgid "The faithful may be purified. This is Vlaakith's protocol!"
msgstr "충신은 정화될 수 있다. 이것이 블라키스의 규율이다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Narrator
#. NodeID = ef95997a-e4f1-bd6c-4c4f-8481360c4d0e
