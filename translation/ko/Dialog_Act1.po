#.     - UND_FearfulRothe_Event_MakeDuergarHostileInDialog = True
#. TagRule: REALLY_DUERGARDWARF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_RotheDeadAttack:b0dd648e-7260-f5cc-f1c3-a569e1989dee
msgctxt "h5be928f3g269bg427ega654gb8532e242036"
msgid "<i>Clan-sen! </i>What the <i>drugh's</i> got into you?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_RotheDeadAttack
#. Speaker = Herdmaster Skarjall
#. NodeID = b0dd648e-7260-f5cc-f1c3-a569e1989dee
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_FearfulRothe_Event_MakeDuergarHostileInDialog = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_RotheDeadAttack:b0dd648e-7260-f5cc-f1c3-a569e1989dee
msgctxt "h8ff692f9g679fg4ed8gbb6fgcf86c09e26a0"
msgid "The hell's wrong with you? Drugnin' <i>hoon!</i>"
msgstr "대체 뭐가 문제야? Drugnin' <i>훈!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_RotheDeadAttack
#. Speaker = Herdmaster Skarjall
#. NodeID = ca04bbc8-7d04-f901-5b04-db46b47b7944
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_AdamantineForge_Knows_Adamantine = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_RotheDeadAttack:ca04bbc8-7d04-f901-5b04-db46b47b7944
msgctxt "h53e3294ag7304g48d4g8e28gf4018adfab27"
msgid ""
"<i>Shit-for-brains</i>. All that adamantine within reach - and you done "
"screwed me over!"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001
#. Speaker = Narrator
#. NodeID = 1414a098-2b7d-4013-ab9c-8355bf7fe16e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_FearfulRothe_Event_FailedToPersuadeRothe = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001:1414a098-2b7d-4013-ab9c-8355bf7fe16e
msgctxt "h9bef7d69g5d2fg40f1g9529g4c119751f93b"
msgid "*It utters an angry bellow and <i>charges</i>.*"
msgstr "*그것은 화가난 듯, 포효를 내지르더니 <i>돌진합니다</i>.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001
#. Speaker = Deep Rothé
#. NodeID = 1b7ba5e8-e9bd-9e7e-476d-428de14dc487
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_FearfulRothe_State_BefriendedRothe = True
#.     - UND_FearfulRothe_Event_ConvincedRotheToAttackRubble = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001:1b7ba5e8-e9bd-9e7e-476d-428de14dc487
msgctxt "h2ee8ee49g5262g4d9ega236g86179ad5dcfb"
msgid "Yes. You are right. There is work, only work. I will clear the rock."
msgstr "그래. 맞아. 이건 일이야. 그냥 일. 돌을 치워야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001
#. Speaker = Narrator
#. NodeID = 1f457d4e-af90-47e6-c394-34a16160a8e3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001:1f457d4e-af90-47e6-c394-34a16160a8e3
msgctxt "hf3fdf8fdg95e6g4c2dg83efg5895767a2404"
msgid "*Its eyes flicker towards the duergar, burning with raw, bestial rage.*"
msgstr "*그것의 눈이 흉포하고 야성적인 분노로 불타오르며 듀에르가를 향해 번뜩입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001
#. Speaker = Player
#. NodeID = 23da8be4-8588-37a4-eef6-d77561ed72cb
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001:23da8be4-8588-37a4-eef6-d77561ed72cb
msgctxt "h7f58cf80g9e3ag4c30g8aeagea1c24f40d66"
msgid "<i>Meet its eyes. Show it how calm you are - all is well.</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001
#. Speaker = Deep Rothé
#. NodeID = 247dacb1-ea80-4e0e-8019-9de75c8a8bc3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_FearfulRothe_HasMet_Rothe_001(1) = True
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001:247dacb1-ea80-4e0e-8019-9de75c8a8bc3
msgctxt "h99ae7aa0ga5a9g4362g80b4g6ad659030eb0"
msgid "*Grunt.*"
msgstr "*끙.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001
#. Speaker = Narrator
#. NodeID = 2570a453-4f16-46a5-dcc9-a0cae00c72f7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001:2570a453-4f16-46a5-dcc9-a0cae00c72f7
msgctxt "h9b5621b3g98e0g409eg9b89g78f2b22af174"
msgid "*The creature is disturbed, its breath quickened by anger and fear.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001
#. Speaker = Deep Rothé
#. NodeID = 25b79787-ba99-b931-b6cf-55037ada9909
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_FearfulRothe_State_PlayerAttackedRubbleBeforeCalmingDownRothe = True
#.   Tag:
#.      - PETPAL(1) = True
#. SetFlags:
#.   Dialog:
#.     - UND_FearfulRothe_HasMet_Rothe_001_SpeakWithAnimals(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001:25b79787-ba99-b931-b6cf-55037ada9909
msgctxt "h9642cce5g47d7g431cg9393ge64028d86ddb"
msgid "No! Too much yelling, too much pain. All must die!"
msgstr "안돼! 고함이 많아, 고통도 너무 많아. 다 죽어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001
#. Speaker = Deep Rothé
#. NodeID = 2b0e4c28-fa4f-4c1b-9616-201f5317e12d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_FearfulRothe_Event_ConvincedRotheToAttackRubble = True
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001:2b0e4c28-fa4f-4c1b-9616-201f5317e12d
msgctxt "h954613f0gc6edg4cd5g8797gd8d0bad2888e"
msgid "*Huff.*"
msgstr "*씩씩댐.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001
#. Speaker = Deep Rothé
#. NodeID = 2caf868a-1ddc-8963-2e46-ee743b713882
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_FearfulRothe_Event_FailedToPersuadeRothe = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001:2caf868a-1ddc-8963-2e46-ee743b713882
msgctxt "hcd9a9db3gab88g45b2gb5b3g6ba33932e8ab"
msgid "No. Everyone hurts us. Now we hurt everyone back!"
msgstr "아니. 모두가 우릴 공격해. 이제 우리도 모두를 공격해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001
#. Speaker = Narrator
#. NodeID = 2ecec016-3410-f888-1b55-bd0f0489758a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001:2ecec016-3410-f888-1b55-bd0f0489758a
msgctxt "hfcc71fa8g96b0g411cgbe94g73fe9317b87b"
msgid "*No good. The rothé is more agitated than ever.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001
#. Speaker = Player
#. NodeID = 378a3e33-1e8d-10c4-a618-2e0274b8ef69
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001:378a3e33-1e8d-10c4-a618-2e0274b8ef69
msgctxt "h9daa9e73g7b00g4415g97a2g07c96b590f86"
msgid "<i>Incline your head towards the duergar. They're the real problem.</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001
#. Speaker = Player
#. NodeID = 3c9def64-23e8-e320-338c-741fb18cd3d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001:3c9def64-23e8-e320-338c-741fb18cd3d8
msgctxt "hf457e582gd654g4c25gaaecgede78aff5f2e"
msgid "<i>Hit the rothé.</i>"
msgstr "<i>로테를 때린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001
#. Speaker = Deep Rothé
#. NodeID = 3dfacafa-3a91-2e4a-8e28-795e96c2036f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_FearfulRothe_State_ConvincedRotheToAttackRubble = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001:3dfacafa-3a91-2e4a-8e28-795e96c2036f
msgctxt "hc7393398gd2dbg4e21gbe10gf35f49a0c03e"
msgid "You helped me. I help you."
msgstr "너는 나를 도와줬어. 나도 너를 도와줄게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001
#. Speaker = Player
#. NodeID = 4db5dfb4-9b60-f81a-b5d8-94e7a5313234
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001:4db5dfb4-9b60-f81a-b5d8-94e7a5313234
msgctxt "h7bc91564gadceg4495g9cfdg5d5a9c5d09e9"
msgid "What has you in such a state?"
msgstr "어째서 이런 상태에 내몰린 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001
#. Speaker = Deep Rothé
#. NodeID = 4edbc251-4ea1-f016-1826-a26966b89e49
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_FearfulRothe_State_PlayerAttackedRubbleBeforeCalmingDownRothe = True
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001:4edbc251-4ea1-f016-1826-a26966b89e49
msgctxt "h01189e80g42a5g41d9g9ee3gb2af9ff0e1a5"
msgid "*Roar!*"
msgstr "*으르렁!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001
#. Speaker = Player
#. NodeID = 4fbdf7f0-24da-f583-5bb3-820a852b667e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001:4fbdf7f0-24da-f583-5bb3-820a852b667e
msgctxt "hc22cb5a6g3b28g4ca7gad5dgfa201061f92a"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001
#. Speaker = Player
#. NodeID = 5cb50517-1029-4743-9ddd-6f377622314f
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001:5cb50517-1029-4743-9ddd-6f377622314f
msgctxt "h7d0edd33g2d2eg4cf1gb34ag73684b49580d"
msgid "<i>Display your palms and murmur soft, low reassurances.</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001
#. Speaker = Player
#. NodeID = 5e34edf4-c818-85af-8180-647c35607d01
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001:5e34edf4-c818-85af-8180-647c35607d01
msgctxt "h0d4d4282gbcbcg46a9g81b2g66714cd00389"
msgid "Breathe. Focus. If you strike, your masters will destroy the herd."
msgstr "심호흡하고 집중해. 만약 네가 공격하면, 너의 주인들이 무리 전체를 몰살할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001
#. Speaker = Narrator
#. NodeID = 5ea91601-1fca-408c-acaf-f35a14e4030a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_FearfulRothe_Event_ConvincedRotheToAttackRubble = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001:5ea91601-1fca-408c-acaf-f35a14e4030a
msgctxt "h2a183cb5g523fg41b9g9c6cgeec127ea79fb"
msgid ""
"*The rothé looks at you with big, soft eyes. Then it lowers its head "
"obediently.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001
#. Speaker = Narrator
#. NodeID = 66c12af1-811c-0115-2834-49e72341d734
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_FearfulRothe_State_ConvincedRotheToAttackRubble = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001:66c12af1-811c-0115-2834-49e72341d734
msgctxt "h5bdc84aagafddg4f11g867bge477518be2b5"
msgid "*The rothé pauses, then growls in assent.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001
#. Speaker = Player
#. NodeID = 67ab092a-9f4a-3f29-5fc1-084261b13cee
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001:67ab092a-9f4a-3f29-5fc1-084261b13cee
msgctxt "hf3b45aafg7cffg43f8ga724gf19e997a109d"
msgid ""
"You were made to serve. This is your meaning. Remove the rubble, as you were "
"told."
msgstr "넌 복종하기 위해 태어났어. 이게 네 사명이야. 지시받은 대로 잔해를 치워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001
#. Speaker = Player
#. NodeID = 6ce8a362-015a-4513-bc72-fc6d7dc2336a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_FearfulRothe_State_PlayerAttackedRubbleBeforeCalmingDownRothe = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001:6ce8a362-015a-4513-bc72-fc6d7dc2336a
msgctxt "hce47852cg51c4g4cb3ga45eg4fe046a596b7"
msgid "<i>Leave</i>."
msgstr "<i>떠난다</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001
#. Speaker = Player
#. NodeID = 80b8d7b2-77e0-0ec9-cb79-f35417364d47
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_FearfulRothe_State_ConvincedRotheToAttackRubble = False
#.      - UND_FearfulRothe_Event_ConvincedRotheToAttackRubble = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001:80b8d7b2-77e0-0ec9-cb79-f35417364d47
msgctxt "h7a8bfa13g98d7g43d8g9e5bgf8e02950ab51"
msgid "Do me a favour, smash through the rubble before you go."
msgstr "부탁 하나만 할게. 가기 전에 이 잔해를 부숴줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001
#. Speaker = Deep Rothé
#. NodeID = 834b37fe-07eb-e846-8780-79b221d3cf3b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_FearfulRothe_State_GuardsAreDead = True
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001:834b37fe-07eb-e846-8780-79b221d3cf3b
msgctxt "hc14835ccgd713g4ec2gbfc7g4cdf34c2a11a"
msgid "*Grunt.*"
msgstr "*끙.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001
#. Speaker = Deep Rothé
#. NodeID = 9471573f-9d58-c4ee-a51a-276625751c52
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_FearfulRothe_Event_FailedToPersuadeRothe = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001:9471573f-9d58-c4ee-a51a-276625751c52
msgctxt "h528fcaa3g3e8eg4445g88a6g3d52483667aa"
msgid ""
"<i>Lies</i>. You're just like them, with their canes and shouting. No more!"
msgstr "<i>거짓말</i>. 너도 똑같아. 소리를 지르고 몽둥이로 괴롭히지. 이젠 끝이야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001
#. Speaker = Deep Rothé
#. NodeID = 97164f4f-8bfd-4d35-9213-0580f440915f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_FearfulRothe_State_BefriendedRothe = True
#.     - UND_FearfulRothe_Event_ConvincedRotheToAttackDuergar = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001:97164f4f-8bfd-4d35-9213-0580f440915f
msgctxt "h6f425892g206eg4390g90b9g53af32912353"
msgid "Yes. They made the pain. Now they feel it!"
msgstr "그래. 놈들이 내게 고통을 줬어. 이제 놈들 차례야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001
#. Speaker = Player
#. NodeID = 9df990c3-6139-2df1-0f3d-a3fa6220361e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001:9df990c3-6139-2df1-0f3d-a3fa6220361e
msgctxt "h4d8fe0c4g7f8dg4ff5gb902gda07ccf0dce0"
msgid "<i>Hit the rothé.</i>"
msgstr "<i>로테를 때린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001
#. Speaker = Deep Rothé
#. NodeID = a48b6654-f04d-eea2-7ff5-436748feb5a4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_FearfulRothe_State_GuardsAreDead = True
#.   Tag:
#.      - PETPAL(1) = True
#. SetFlags:
#.   Global:
#.     - UND_FearfulRothe_Event_HasMet2 = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001:a48b6654-f04d-eea2-7ff5-436748feb5a4
msgctxt "hc55e1e4aga66cg4ae1g965bg7b4e4d245461"
msgid "Duergar can't hurt anymore. Will wait until it's safe to leave."
msgstr "듀에르가가 더는 해치지 못할 거야. 이곳을 떠나도 안전할 때까지 기다려야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Rothe_001
#. Speaker = Narrator
#. NodeID = a580cffb-08fd-420e-20f0-b2d6ca0d787f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_FearfulRothe_Event_FailedToPersuadeRothe = True
