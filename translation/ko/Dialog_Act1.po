#.      - GITHYANKI(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:296d8c57-afda-75d2-6dd5-88e8e346c0f9
msgctxt "h391064dfg2265g435fgaec5g6b33c84f514e"
msgid ""
"I have the weapon Voss was looking for, that <i>your </i>crèche wanted found."
msgstr "보스가 찾던 무기를 갖고 있다. <i>네</i> 양성소가 찾고 있는 바로 그 물건 말이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Player
#. NodeID = 35bc4762-7e98-afca-e1ea-fcfbfbb215cb
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_UpperGuards_Event_MainCheckpointHostile = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:35bc4762-7e98-afca-e1ea-fcfbfbb215cb
msgctxt "hdf0af6f4gd9f9g4e84g957eg34001fec6adc"
msgid "<i>Attack</i>."
msgstr "<i>공격한다</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Gish Far'aag
#. NodeID = 3c14c844-22aa-1a43-001c-b07a6de8a596
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_UpperGuards_State_GainedAccess = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:3c14c844-22aa-1a43-001c-b07a6de8a596
msgctxt "h2c94675egcc33g404agb4a7g4c960278f396"
msgid "Perhaps the news you bring will change Inquisitor W'wargaz's mind."
msgstr "어쩌면 네가 가져온 소식이 심문관 와르가즈의 마음을 바꿔 놓을지도 모르겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Gish Far'aag
#. NodeID = 3e5211a2-2ad9-8658-a1e5-6927cc550c92
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:3e5211a2-2ad9-8658-a1e5-6927cc550c92
msgctxt "h768a0d2fgf150g4cf4gbb70ge9db4860a74d"
msgid ""
"The <i>ghustil</i> has been taking an... Unprecedented interest in the "
"<i>ghaik</i> tadpoles of late."
msgstr "최근 <i>거스틸</i>이 <i>게이크</i>의 올챙이들에 관해... 유례없는 관심을 보이고 있기는 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Player
#. NodeID = 489e90d1-5659-6d0f-611f-b7e7394f25cf
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:489e90d1-5659-6d0f-611f-b7e7394f25cf
msgctxt "h51f1f869g70adg4fadgadc6gb4ae599e8cc6"
msgid ""
"I was told to bring the weapon to the highest authority possible. That "
"doesn't look like you. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Player
#. NodeID = 48e3bd20-8457-ada6-6238-084e9e270a22
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_GithChokepoint_State_SpokeToVoss = True
#.      - GLO_GithChokepoint_Quest_GithLeave = True
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:48e3bd20-8457-ada6-6238-084e9e270a22
msgctxt "h991e2b89ga744g45cegb543g5cb2cabde1be"
msgid ""
"<i>Kith'rak </i>Voss instructed me to bring a weapon to our kin. I have "
"found it."
msgstr "<i>키스락</i> 보스께서 동포에게 무기를 전달하라 지시하셨다. 내가 되찾아왔다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Gish Far'aag
#. NodeID = 516d800a-c816-5dc2-63e7-16bcf3d9e0fe
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_Quest_GoToCaptain = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:516d800a-c816-5dc2-63e7-16bcf3d9e0fe
msgctxt "h4489e582g8ba3g4e75gab66g1536ce6d3d8c"
msgid "Report to the captain. She will take you to the Inquisitor."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Player
#. NodeID = 526b0600-2bfc-9236-1372-7e60dc05fc6f
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#. CheckFlags:
#.   Tag:
#.      - RANGER(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:526b0600-2bfc-9236-1372-7e60dc05fc6f
msgctxt "he379cc67g406cg4bd5g9b34gbe84fc999175"
msgid ""
"I hunt monsters. Either that's you, or it's the mind flayers - your choice."
msgstr "나는 괴물들을 사냥하지. 너희 족속이든, 마인드 플레이어든 상관 없이 - 네 선택에 달렸다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Player
#. NodeID = 57c515fe-00ac-c1f1-ac28-84c9b0e328bb
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:57c515fe-00ac-c1f1-ac28-84c9b0e328bb
msgctxt "h012b0cf4g838cg4b06g8696g5ab378c423d9"
msgid "Let me pass. Fighting me will end badly for you."
msgstr "길을 비켜라. 한 판 붙으면 좋게 끝나지 않을 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Gish Far'aag
#. NodeID = 5a136052-7ab2-8449-8c46-ca7a976a54ed
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_UpperGuards_Event_MainCheckpointHostile = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:5a136052-7ab2-8449-8c46-ca7a976a54ed
msgctxt "h3f56b63eg4e91g4388ga916gc492c6e63d27"
msgid ""
"You could turn at any moment. I will not let a <i>ghaik</i> abomination "
"endanger my kin."
msgstr "네놈은 언제든지 변이할 수 있다. 나는 <i>게이크</i> 괴물이 내 동포들을 위험에 빠뜨리도록 두지 않겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Player
#. NodeID = 5a22b873-71ff-b96f-e5d3-426840a1305e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 14
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:5a22b873-71ff-b96f-e5d3-426840a1305e
msgctxt "h876aae12g07c2g4292ga526gda1b19651ba3"
msgid "I've been infected for a while. Your doctors could study me."
msgstr "감염된 지 꽤 되었다. 그쪽 의사들에게 제법 연구 가치가 있을 것 같은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Player
#. NodeID = 5be8eace-2d1a-46d1-a0e8-5d0af113c310
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_UpperGuards_Event_MainCheckpointHostile = True
#. TagRule: REALLY_DARK_URGE
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:5be8eace-2d1a-46d1-a0e8-5d0af113c310
msgctxt "h1569ae60gc209g4490ga013gf821a756464a"
msgid "My 'purpose' is to reap death upon you."
msgstr "내 '목적'은 너희에게 죽음을 내리는 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Player
#. NodeID = 5be8eace-2d1a-46d1-a0e8-5d0af113c310
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_UpperGuards_Event_MainCheckpointHostile = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:5be8eace-2d1a-46d1-a0e8-5d0af113c310
msgctxt "h4a8ad640g31c9g4721gae6fg0e22e0b6b370"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Gish Far'aag
#. NodeID = 5c5fce74-4fe7-fa8d-e5b5-9abdbde8dcfe
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_UpperGuards_Event_MainCheckpointHostile = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:5c5fce74-4fe7-fa8d-e5b5-9abdbde8dcfe
msgctxt "hf9340d08g133bg4bfeg9f68gd78932c0da32"
msgid ""
"You could turn at any moment. I <i>will</i> protect my kin. <i>Hta'zith!</i>"
msgstr "네놈은 금방이라도 변이할 수 있다. 나는 내 동족들을 <i>지키리라</i>. <i>흐타'지쓰!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Player
#. NodeID = 673d8c44-fa3d-4002-3bbd-bd96715824a7
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:673d8c44-fa3d-4002-3bbd-bd96715824a7
msgctxt "he0a0a97eg144dg450eg89cagfeae676e626c"
msgid "I'm an unmatched killer. You want me as your ally."
msgstr "나는 따라올 자 없는 살인자다. 동맹으로 삼는 편이 네 신상에 이로울 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Gish Far'aag
#. NodeID = 70f8405c-b7f4-47a2-7547-49c00fd8d019
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_UpperGuards_MainCheckpointTrespassing_Event_LaezelInclusion1 = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:70f8405c-b7f4-47a2-7547-49c00fd8d019
msgctxt "h06ea5ca7gbc29g4506ga1adg23af741e27ec"
msgid ""
"<i>Shkath zai</i>. We were not expecting visitors, kin. What brings you here?"
msgstr "<i>쉬카쓰 자이</i>. 방문객을 기대하진 않았다만, 동포여. 어떤 용무로 왔나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Player
#. NodeID = 727c5765-3128-aa01-0913-4d56b92544c2
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 30
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:727c5765-3128-aa01-0913-4d56b92544c2
msgctxt "hd5022723g0a0bg4587g961agd3007243fe15"
msgid ""
"I SPEAK AS AN AVATAR OF QUEEN VLAAKITH. YOU WILL LET ME PASS, "
"<i>VIN'IISK.</i>"
msgstr "블라키스 여왕의 화신으로서 고하노라. 길을 비켜라, <i><b>비니스크.</b></i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Player
#. NodeID = 7d083083-b6a7-b09b-63b7-ca986d49c4bc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Origin_PartOfTheTeam_Laezel = True
#.   Tag:
#.      - GITHYANKI(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:7d083083-b6a7-b09b-63b7-ca986d49c4bc
msgctxt "hf8177bebgf3d5g40b7g8317ga99c079516b2"
msgid "I was infected by an illithid, and was told to seek a githyanki crèche."
msgstr "일리시드에 감염되었다고 하니, 기스양키 양성소를 찾아 가라고 하더군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Player
#. NodeID = 7ec201ae-9285-85f2-2ce2-6186e8d1f134
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:7ec201ae-9285-85f2-2ce2-6186e8d1f134
msgctxt "h576a73d0g98ccg45cfg9d2ag4e7b0aa7b18a"
msgid ""
"I will report to your <i>kith'rak</i> as protocol dictates. Do not forget "
"yourself."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Gish Far'aag
#. NodeID = 81861e60-3087-bf68-0915-8bd3e39fe647
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_UpperGuards_MainCheckpointTrespassing_Event_LaezelInclusion1 = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:81861e60-3087-bf68-0915-8bd3e39fe647
msgctxt "h1863b6f2gb6a9g4cfbg8c08g454b67d22899"
msgid "A <i>ghaik</i> thrall is something to eradicate, not reason with."
msgstr "<i>게이크</i>의 노예는 척결해야 할 대상이지, 의논해야 할 대상이 아니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Gish Far'aag
#. NodeID = 81d94042-378d-c089-2e73-7171d6a9b576
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 60038785-63c7-d013-bf73-1a26d5360bc8_ProducedBox = False
#. SetFlags:
#.   Global:
#.     - CRE_UpperGuards_State_GainedAccess = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:81d94042-378d-c089-2e73-7171d6a9b576
msgctxt "h853fc23bgd4eeg4bc3ga1abg31f44a388043"
msgid ""
"If you are lying, it'll be a painful death. The Inquisitor is deeper in the "
"crèche."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Player
#. NodeID = 825c869d-716b-878f-dac4-a559c0e13b93
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_GithChokepoint_State_SpokeToVoss = True
#.      - GLO_GithChokepoint_Quest_GithLeave = False
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:825c869d-716b-878f-dac4-a559c0e13b93
msgctxt "h79758507gd5c1g453fg80fcg108d44ec5f58"
msgid "<i>Kith'rak </i>Voss was searching for a weapon. I have it with me."
msgstr "<i>키스락</i> 보스께서 무기를 찾고 계신다. 내가 그것을 수복했다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Gish Far'aag
#. NodeID = 85d79d99-f486-f314-f145-09cc4e2a4df2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:85d79d99-f486-f314-f145-09cc4e2a4df2
msgctxt "h67079c63gefe2g499eg9014ga9db4e159d80"
msgid ""
"You've talked to one of our queen's silver knights,<i> and </i>hold the lost "
"weapon? Prove it, <i>istik</i>."
msgstr ""
"여왕 폐하의 은기사들 가운데 하나와 대화를 나눈 데 <i>더해</i> 잃어버린 무기까지 갖고 있으시겠다? 증명해 보여라, "
"<i>istik</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Lae'zel
#. NodeID = 8c8c7249-6cda-4c7f-9f2e-27820f9b50a7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_UpperGuards_MainCheckpointTrespassing_Event_LaezelInclusion1 = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:8c8c7249-6cda-4c7f-9f2e-27820f9b50a7
msgctxt "h97203b45g4a33g4db9g961fg6f9164e124e2"
msgid "Faithful <i>gish</i>, <i>Vlaakith gha'g shkath zai</i>."
msgstr "<i>기쉬</i> 충신이여, <i>블라키스 가'그 쉬카쓰 자이</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Player
#. NodeID = 8f5fd161-cf60-25a1-7695-2062282cc035
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:8f5fd161-cf60-25a1-7695-2062282cc035
msgctxt "h64a509c3g23ecg4adcg9e16g56142e7b8d36"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Player
#. NodeID = 92f51197-0679-3d46-7008-cd9d5f23fb67
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:92f51197-0679-3d46-7008-cd9d5f23fb67
msgctxt "h4e6df647g8fc3g4e9fgbc95g228e80d1ec06"
msgid "Stand aside, or crumble in combat."
msgstr "물러서라. 아니면 땅바닥에 나뒹굴게 해 주마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Gish Far'aag
#. NodeID = 940df19e-ae81-4d36-2b41-8b0948950abb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:940df19e-ae81-4d36-2b41-8b0948950abb
msgctxt "hfa1c7c0bg75bdg4685g8ba1gd513ab62d6e5"
msgid ""
"...An avatar? Of the undying regent herself? I beg your mercy, "
"<i>jhe'stil</i>."
msgstr "...화신이라고? 불멸의 섭정 그 자체라는 말씀이십니까? 부디 자비를 베푸소서, <i>제'스틸</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Gish Far'aag
#. NodeID = 99780ed1-2089-9231-24db-2d0f7d05f2fd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_UpperGuards_State_GainedAccess = True
#.     - CRE_ChainOfCommand_Quest_GoToInquisitor = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:99780ed1-2089-9231-24db-2d0f7d05f2fd
msgctxt "h6346b332gb275g456aga44dg13eb79cc02d5"
msgid ""
"Inquisitor W'wargaz will be honoured to meet you. <i>Ch'mar, zal'a "
"Vlaakith.</i>"
msgstr "심문관 와르가즈가 전하를 뵙는 영광을 고대하고 있습니다. <i>츠마르, 잘라 블라키스.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Player
#. NodeID = 9adb08fe-5021-dfde-871b-3c1352a27972
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:9adb08fe-5021-dfde-871b-3c1352a27972
msgctxt "h9c84e739g14ffg45b7g8d66g6ca809685615"
msgid "<i>Allow Lae'zel to answer.</i>"
msgstr "<i>레이젤이 대답하게 한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Gish Far'aag
#. NodeID = a02fd52a-c708-d268-5876-0d0329a30f37
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:a02fd52a-c708-d268-5876-0d0329a30f37
msgctxt "h98280ef8geda9g48c7ga7bbg9495826af210"
msgid "You are <i>infected?</i>"
msgstr "네가 <i>감염</i>되었다는 말이냐?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Player
#. NodeID = a07ae247-39b8-e289-9c23-5d0a5790754e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:a07ae247-39b8-e289-9c23-5d0a5790754e
msgctxt "h3abdcb41gdbb8g4615g83d2gdff5305d4e43"
msgid ""
"The ceremorphosis is delayed. Your crèche's doctors would find me useful to "
"study."
msgstr "뇌변이가 지연되고 있다. 너희 양성소의 의사가 연구에 쓸 좋은 재료를 찾은 것 같군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Gish Far'aag
#. NodeID = a3e1a137-e7c6-b93f-eea7-2d024e3e64f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:a3e1a137-e7c6-b93f-eea7-2d024e3e64f0
msgctxt "hb2b29bdcg2425g42cfgbe46g696f261e8528"
msgid "If that is so, you succeed where others have failed."
msgstr "그렇다면 그대는 다른 이들이 실패한 임무를 해냈군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Gish Far'aag
#. NodeID = a6816029-1cf1-c668-ba53-612c34f44e99
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:a6816029-1cf1-c668-ba53-612c34f44e99
msgctxt "he650aafegaae3g4b33g9511gb205d81595bf"
msgid "<i>Chk</i>... It wouldn't be the strangest study she's done."
msgstr "<i>츠크</i>... 지난 연구 사례들을 보자면 그리 놀랍지도 않군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Player
#. NodeID = a8698f8f-5704-9697-0117-7cdc95005d47
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:a8698f8f-5704-9697-0117-7cdc95005d47
msgctxt "he78e34f6g11a1g4ca2gbc87gd40208f15dd8"
msgid ""
"<i>Ra'stil</i>, listen. I am infected by <i>ghaik</i>, your mandate is to "
"aid me."
msgstr "<i>라스틸</i>, 들어다오. 나는 지금 <i>게이크</i>에게 감염된 상태다. 규율에 따라 나를 도와라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Gish Far'aag
#. NodeID = a935cf95-6fc7-fb8e-00e3-bf41ec8ce5ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:a935cf95-6fc7-fb8e-00e3-bf41ec8ce5ec
msgctxt "he10c6c7ag021ag41ffgb67fgc5ceb55fe3f3"
msgid "Produce this weapon and you may pass."
msgstr "무기를 보여주면 지나가게 해주겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Gish Far'aag
#. NodeID = ab93c17f-b7fa-537c-bc40-cedbefaeba6d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_UpperGuards_State_GainedAccess = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:ab93c17f-b7fa-537c-bc40-cedbefaeba6d
msgctxt "hc51f24b3g183bg4506g9259g18d56b9ff32b"
msgid "You may proceed."
msgstr "가도 좋다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Lae'zel
#. NodeID = adaa975a-6893-41b9-9096-13436e403ef0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_UpperGuards_MainCheckpointTrespassing_Event_LaezelInclusion1 = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:adaa975a-6893-41b9-9096-13436e403ef0
msgctxt "hf6bc6343g4f0ag4350g897bgf7c79268c8af"
msgid ""
"Stand down, <i>gish</i>. Is it not Vlaakith's command to welcome her "
"faithful?"
msgstr "물러서라, <i>기쉬</i>. 블라키스께서 충신을 환대하라고 명하시지 않았나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Player
#. NodeID = ae188f41-0a84-3c05-8560-f102de3cf956
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 18
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:ae188f41-0a84-3c05-8560-f102de3cf956
msgctxt "hb3243ffdgded3g4e23g9359gf4b4a0f38669"
msgid ""
"You githyanki hate illithid. I have proof that they're invading. We need "
"your help."
msgstr "너희 기스양키들은 일리시드를 혐오하지. 놈들이 침입 중이라는 증거를 갖고 있다. 네 도움이 필요하다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Player
#. NodeID = ae7dc4d3-4f1d-08ec-34cf-262c27e22533
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_GithChokepoint_State_SpokeToVoss = True
#.      - GLO_GithChokepoint_Quest_GithLeave = True
#.   Tag:
#.      - GITHYANKI(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:ae7dc4d3-4f1d-08ec-34cf-262c27e22533
msgctxt "hbd5b19dfg4262g44e0gaa4dg434928ebbf4d"
msgid "I'm on your side! Captain Voss sent me to find an item for you."
msgstr "같은 편도 못 알아보나! 사령관 보스께서 네게 전해 줄 물건을 찾으라고 파견하셨다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Player
#. NodeID = af2cf217-5a3b-f07b-c1c4-37083ced71bc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_GithChokepoint_State_SpokeToVoss = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:af2cf217-5a3b-f07b-c1c4-37083ced71bc
msgctxt "h6bbb0675gb8e0g4ee6gbf7fg14f77ebf5c5b"
msgid "I found the weapon you seek. Want to explain to Voss why you killed me?"
msgstr "네가 찾는 무기를 갖고 있다. 사령관 보스께 나를 죽인 이유에 대해 해명하고 싶지는 않을 텐데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Gish Far'aag
#. NodeID = af9719a9-9c0d-21a4-e627-d9a5c3be4f29
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#. SetFlags:
#.   Global:
#.     - CRE_UpperGuards_State_GainedAccess = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:af9719a9-9c0d-21a4-e627-d9a5c3be4f29
msgctxt "h4aa53d7ag9868g434fg8f6eg9f8d28834aa9"
msgid ""
"<i>Ra'stil...</i> You bring great honour on Crèche Y'llek this day. The "
"Inquisitor will be pleased."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Gish Far'aag
#. NodeID = b46ed08c-982b-81c9-2b7b-307a2423d0a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:b46ed08c-982b-81c9-2b7b-307a2423d0a5
msgctxt "h5b87b3beg5b5dg47a7ga26eg92cea8454410"
msgid "You are <i>infected</i>. A source of plague. Nothing more."
msgstr "네놈은 <i>감염됐다</i>. 해악의 원천이지. 그게 전부다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Player
#. NodeID = b4f66292-44e4-948a-0d24-aefd042c6b55
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:b4f66292-44e4-948a-0d24-aefd042c6b55
msgctxt "h476f2b3dg11a7g4b1dg8d68gd758b3d5c997"
msgid "<i>Allow Lae'zel to answer.</i>"
msgstr "<i>레이젤이 대답하게 한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = GROUP_Daisy
#. NodeID = b5a57d1c-d807-4e24-b5da-d3a3e47531ef
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DAISY_MALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:b5a57d1c-d807-4e24-b5da-d3a3e47531ef
msgctxt "hd9ae4aaeg4879g4cf6g8074gf1a848a71b05"
msgid "What are you doing?!"
msgstr "뭐하자는 겁니까?!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = GROUP_Daisy
#. NodeID = b5a57d1c-d807-4e24-b5da-d3a3e47531ef
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DAISY_FEMALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:b5a57d1c-d807-4e24-b5da-d3a3e47531ef
msgctxt "h4ca29951gd31ag415fga4b2g66494ddbf997"
msgid "What are you doing?!"
msgstr "뭐하자는 겁니까?!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Player
#. NodeID = bad11908-1ad8-0d3f-7972-a1a5b716186c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_GithChokepoint_State_SpokeToVoss = True
#.      - GLO_GithChokepoint_Quest_GithLeave = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:bad11908-1ad8-0d3f-7972-a1a5b716186c
msgctxt "h209df0b2g2e43g43aeg9a83ga1291e91c0cf"
msgid ""
"Kith'rak Voss entrusted me with finding a weapon. I have done so, you "
"<i>will</i> let me pass."
msgstr "키스락 보스께서 내게 무기 수색 임무를 맡기셨다. 분부에 따랐으니, 너는 나를 통과시켜 <i>줄</i> 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Gish Far'aag
#. NodeID = bee315f2-6058-9ef2-32f3-955e8f643f67
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:bee315f2-6058-9ef2-32f3-955e8f643f67
msgctxt "h872941efg9d28g40f1gb66cgf2297fef01b2"
msgid "We are aware, and it is dire. But of late we've been distracted."
msgstr "이미 알고 있다. 놈들의 침략이 심각한 수준에 이르렀지. 그러나 최근 경계가 느슨해진 것도 사실이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Gish Far'aag
#. NodeID = bfe6739c-ebe4-8ffe-bdd7-1dff0f18da99
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_UpperGuards_Event_MainCheckpointHostile = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:bfe6739c-ebe4-8ffe-bdd7-1dff0f18da99
msgctxt "hf723d247gc4c4g4002gbc38gcad13a275bb4"
msgid "Arrogant, for such a limited species."
msgstr "모자란 종족 주제에 오만하기 짝이 없구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Lae'zel
#. NodeID = c0351657-fcaf-90a2-a43d-bafeaf090ec4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:c0351657-fcaf-90a2-a43d-bafeaf090ec4
msgctxt "h14e81b59g0124g428cg8710gc00f4bfb5f9a"
msgid "We seek the <i>zaith'isk</i>. Show me the way."
msgstr "우리는 <i>제이트이스크</i>를 찾고 있다. 안내해라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Gish Far'aag
#. NodeID = c03bfc94-7353-a977-9dba-e4b13c7a39d8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_UpperGuards_State_GainedAccess = True
#.   Object:
#.     - CRE_ChainofCommand_ToldReportToInfirmary(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:c03bfc94-7353-a977-9dba-e4b13c7a39d8
msgctxt "hb24a34c5gdaadg405bg87e7g3c401fcdaab0"
msgid ""
"Report to the infirmary at once. And step carefully.<i> </i>Crèche Y'llek "
"watches you."
msgstr "즉시 의무실에 보고하도록. 행동을 삼가는 게 좋을 거다. 일레크 양성소가 지켜보고 있으니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Gish Far'aag
#. NodeID = c6105752-f49c-90ec-b9d3-457981f026f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:c6105752-f49c-90ec-b9d3-457981f026f8
msgctxt "h817bc15bge26dg4d71ga14eg87a6e9a2279e"
msgid "Halt. We were not expecting visitors, kin. What brings you here?"
msgstr "정지. 방문객을 기대하진 않았다만, 동포여. 어떤 용건으로 왔나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Player
#. NodeID = cad8445f-eca2-6145-4d0d-148b3d90dc38
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:cad8445f-eca2-6145-4d0d-148b3d90dc38
msgctxt "he75fd931g0e90g49eagacf3g20f2e7e9f07e"
msgid "I dare you to try. Otherwise, step aside, <i>shka'keth</i>."
msgstr "시도할 테면 해 봐라. 그러지 않겠다면 물러서라, <i>쉬카'케쓰</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Player
#. NodeID = d2bd1564-5e20-c5d4-a832-9dded02a8c6f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:d2bd1564-5e20-c5d4-a832-9dded02a8c6f
msgctxt "h93b833c1gbb30g45f3ga8f6g36c4805b1bd7"
msgid "I'm no thrall. I came here freely, didn't I?"
msgstr "나는 노예 따위가 아니다. 내 발로 여기까지 찾아 왔지, 안 보이나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Gish Far'aag
#. NodeID = d50682e6-79a8-0310-6901-e45dbb724b3c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_UpperGuards_State_GainedAccess = True
#.   Object:
#.     - CRE_ChainofCommand_ToldReportToInfirmary(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:d50682e6-79a8-0310-6901-e45dbb724b3c
msgctxt "h550a994bgf748g4982gbf0agefbd5e5c07ca"
msgid "Fine. Report to the infirmary. Quickly."
msgstr "좋다. 의무실에 보고하도록. 신속히."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Player
#. NodeID = d69ac3e2-142d-dedc-d281-411d3328d851
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_UpperGuards_Event_MainCheckpointHostile = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:d69ac3e2-142d-dedc-d281-411d3328d851
msgctxt "h51a8df36gbd87g4ad5g8661gbec9c862aff3"
msgid "<i>Attack</i>."
msgstr "<i>공격한다</i>."

