msgctxt "h55a96010g4147g48abg8d1ag6793656ad14b"
msgid "Bloody druids! You let us in! You gave us shelter!"
msgstr "망할 드루이드 놈들! 받아줄 땐 언제고! 피난처로 지내라며!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_Refugee004
