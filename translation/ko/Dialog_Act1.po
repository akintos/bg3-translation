msgctxt "hf0e41167g55f7g44e7g8970g0503f5388010"
msgid "Shouldn't take much to crack this contraption."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/VBs/GOB_TempleAccess_PuzzleApproach_ReadInstructions_VB
#. Speaker = Player
