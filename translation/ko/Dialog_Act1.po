#.   Global:
#.      - FOR_Courier_Knows_DogName = True
#. SetFlags:
#.   Dialog:
#.     - FOR_Courier_Dog_Knows_FinishingMourning(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:91617a6c-b260-68ff-bc46-e163c64bfbc0
msgctxt "he3f987afg47eeg405bgb7a2gf604db66bbc9"
msgid "Come on, Scratch. Follow me."
msgstr "이리와, 스크래치. 같이 가자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Scratch
