msgctxt "hae656c42g639dg4ebdg899cgee313d778bcc"
msgid "How did you die?"
msgstr "어떻게 죽었지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SpeakWithDead/DEN_General_Dead_SnakeKid
#. Speaker = Arabella
#. NodeID = 99462101-15c8-c681-bc73-6080b727d1a7
