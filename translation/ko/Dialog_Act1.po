msgctxt "hdd7739fag7cd7g406agba52gf85c9c2e5bef"
msgid "<i>Gh'rack</i>. Hook horrors."
msgstr "<i>그'락</i>. 후크 호러군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_HookHorrors_VB
#. Speaker = Player
#. NodeID = 36eede30-1bb6-7207-c114-306c3fca01fe
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_DEEPGNOME
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_HookHorrors_VB:36eede30-1bb6-7207-c114-306c3fca01fe
msgctxt "hf5bf4be6g6ff9g43d4g83efg17872514b0f7"
msgid "<i>Magga cammara</i>. That's a hook horror."
msgstr "<i>마가 카마라</i>. 저건 후크 호러야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_HookHorrors_VB
#. Speaker = Player
#. NodeID = b214bc6c-0690-c056-f4a0-5ab89994e249
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_HookHorrors_VB:b214bc6c-0690-c056-f4a0-5ab89994e249
msgctxt "h4c33722eg1142g4e8dg823ag79cac8994b4a"
msgid "Over there. Another friendly little critter."
msgstr "저길 봐. 또 친절한 생명체가 하나 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_HookHorrors_VB
#. Speaker = Player
#. NodeID = b214bc6c-0690-c056-f4a0-5ab89994e249
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_HookHorrors_VB:b214bc6c-0690-c056-f4a0-5ab89994e249
msgctxt "h903d400ag18bdg4a8ag8a40g93950ea75cf0"
msgid ""
"Hook horrors! Classification: monstrosity. Social behaviour: kills on sight."
msgstr "후크 호러야! 분류: 괴물. 사회 행동: 마주치면 살해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_HookHorrors_VB
#. Speaker = Player
#. NodeID = b214bc6c-0690-c056-f4a0-5ab89994e249
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_HookHorrors_VB:b214bc6c-0690-c056-f4a0-5ab89994e249
msgctxt "he419e37bg68f2g4f96g9de7g54515595b41c"
msgid "What <i>is</i> that? It's like another layer of the Hells down here."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_HookHorrors_VB
#. Speaker = Player
#. NodeID = b214bc6c-0690-c056-f4a0-5ab89994e249
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_HookHorrors_VB:b214bc6c-0690-c056-f4a0-5ab89994e249
msgctxt "h5047dbb9g0197g4ec1g85dcgdacbf270e744"
msgid "More monstrosities - there, on the cliff."
msgstr "또 괴물이 있어, 저기, 벼랑 위에."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_HookHorrors_VB
#. Speaker = Player
#. NodeID = b214bc6c-0690-c056-f4a0-5ab89994e249
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_HookHorrors_VB:b214bc6c-0690-c056-f4a0-5ab89994e249
msgctxt "h1605f714ga930g4361g9a70gacbe71a89540"
msgid "Look at the barbs on that thing... Shar preserve me."
msgstr "저 가시 좀 봐... 샤께서 날 보호하시길."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_HookHorrors_VB
#. Speaker = Player
#. NodeID = b214bc6c-0690-c056-f4a0-5ab89994e249
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_HookHorrors_VB:b214bc6c-0690-c056-f4a0-5ab89994e249
msgctxt "h55da6b7dg2908g4372g9edeg37dbb22be8ed"
msgid "Hook horrors - there, on the cliff!"
msgstr "후크 호러야. 저기, 벼랑 위에!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_HookHorrors_VB
#. Speaker = Player
#. NodeID = b214bc6c-0690-c056-f4a0-5ab89994e249
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_HookHorrors_VB:b214bc6c-0690-c056-f4a0-5ab89994e249
msgctxt "he9e833a2ge033g48d4g8aefg522f242d928a"
msgid "By the hells, what <i>is </i>that?"
msgstr "지옥이여 맙소사, 저건 <i>뭐야</i>?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_HookHorrors_VB_Backup
#. Speaker = Player
#. NodeID = 65781680-f2d0-f581-7eba-e2d90774d34e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_UNDERDARK(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_HookHorrors_VB_Backup:65781680-f2d0-f581-7eba-e2d90774d34e
msgctxt "h5e990e7fga004g458fga4c8g740186519d4d"
msgid "It's calling its pack!"
msgstr "무리를 부르고 있어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_HookHorrors_VB_Backup
#. Speaker = Player
#. NodeID = a39fa445-0985-0e2f-6f88-d58e883fbc13
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_HookHorrors_VB_Backup:a39fa445-0985-0e2f-6f88-d58e883fbc13
msgctxt "h925641fdgfde0g4cf8g8d85gf0cc03b639d3"
msgid "Shut that oversized chicken up!"
msgstr "저 거대한 닭대가리 좀 닥치게 해봐!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_HookHorrors_VB_Backup
#. Speaker = Player
#. NodeID = a39fa445-0985-0e2f-6f88-d58e883fbc13
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_HookHorrors_VB_Backup:a39fa445-0985-0e2f-6f88-d58e883fbc13
msgctxt "h8648c2c8g3e63g490dg852agdded098532b8"
msgid "In case you were wondering: it's calling the rest of its pack!"
msgstr "네가 무슨 일이 일어나고 있는 건지 모를까 봐 말해주는 건데: 놈이 나머지 무리를 부르고 있어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_HookHorrors_VB_Backup
#. Speaker = Player
#. NodeID = a39fa445-0985-0e2f-6f88-d58e883fbc13
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_HookHorrors_VB_Backup:a39fa445-0985-0e2f-6f88-d58e883fbc13
msgctxt "hb276ca3bg7743g4a25gb54fgd17da2a15add"
msgid "It's calling for backup! Might even the odds."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_HookHorrors_VB_Backup
#. Speaker = Player
#. NodeID = a39fa445-0985-0e2f-6f88-d58e883fbc13
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_HookHorrors_VB_Backup:a39fa445-0985-0e2f-6f88-d58e883fbc13
msgctxt "h3f49ed6cg1fffg4cd1g85dbg4e27dc81e144"
msgid "By Vlaakith's blades, silence that thing!"
msgstr "블라키스의 검이여, 저것 좀 조용하게 만들어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_HookHorrors_VB_Backup
#. Speaker = Player
#. NodeID = a39fa445-0985-0e2f-6f88-d58e883fbc13
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_HookHorrors_VB_Backup:a39fa445-0985-0e2f-6f88-d58e883fbc13
msgctxt "h9ccceb3fg759dg4b4ag8fe3g19dfe46a5555"
msgid "What's it calling to? Are there more of them?"
msgstr "뭘 부르고 있는 거야? 놈들이 더 있나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_HookHorrors_VB_Backup
#. Speaker = Player
#. NodeID = a39fa445-0985-0e2f-6f88-d58e883fbc13
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_HookHorrors_VB_Backup:a39fa445-0985-0e2f-6f88-d58e883fbc13
msgctxt "hce133482g15bag4d0dgb5dbge1a386cc08e0"
msgid "What in the... oh, that can't be good."
msgstr "이게 무슨... 오, 좋진 않아 보이는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_HookHorrors_VB_Backup
#. Speaker = Player
#. NodeID = a39fa445-0985-0e2f-6f88-d58e883fbc13
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_HookHorrors_VB_Backup:a39fa445-0985-0e2f-6f88-d58e883fbc13
msgctxt "h7e6bc5a5gfccbg48bbg935fg28d704551837"
msgid "Hells. We're attracting too much attention!"
msgstr "젠장. 시선을 너무 많이 끌고 있어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_JusticiarEquipment_PAD
#. Speaker = Player
#. NodeID = 87ea7ea7-b9d0-4ddf-a43e-1e0210b724f3
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_JusticiarEquipment_PAD:87ea7ea7-b9d0-4ddf-a43e-1e0210b724f3
msgctxt "h5fc71e60gb070g4681g8d6aga53c28a35ee2"
msgid "Rusted and useless. Pity."
msgstr "녹슬어서 쓸모가 없군. 아쉬워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_JusticiarEquipment_PAD
#. Speaker = Player
#. NodeID = 87ea7ea7-b9d0-4ddf-a43e-1e0210b724f3
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_JusticiarEquipment_PAD:87ea7ea7-b9d0-4ddf-a43e-1e0210b724f3
msgctxt "h892630d5g1b39g4ddbgae7bg2fb6b0a17803"
msgid "Hmmm. Wear this and you'll only ever be a knight in rusted armour."
msgstr "흐음. 이 갑옷을 입으면 녹슨 갑주를 걸친 기사가 될 수 있겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_JusticiarEquipment_PAD
#. Speaker = Player
#. NodeID = 87ea7ea7-b9d0-4ddf-a43e-1e0210b724f3
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_JusticiarEquipment_PAD:87ea7ea7-b9d0-4ddf-a43e-1e0210b724f3
msgctxt "h68080e37ge617g45fag88a2ga948d43d11c8"
msgid "This gear's rusted to bits. Couldn't use it to fight off a flumph."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_JusticiarEquipment_PAD
#. Speaker = Player
#. NodeID = 87ea7ea7-b9d0-4ddf-a43e-1e0210b724f3
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_JusticiarEquipment_PAD:87ea7ea7-b9d0-4ddf-a43e-1e0210b724f3
msgctxt "hfe979554gb891g42afg8840gcbc970ada583"
msgid "Rusted - not a useful weapon among the lot."
msgstr "녹슬었군, 유용한 무기는 보이지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_JusticiarEquipment_PAD
#. Speaker = Player
#. NodeID = 87ea7ea7-b9d0-4ddf-a43e-1e0210b724f3
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_JusticiarEquipment_PAD:87ea7ea7-b9d0-4ddf-a43e-1e0210b724f3
msgctxt "hbf831c73g374eg4e1fg9389gdbded299f88e"
msgid "Dark Justiciar weapons. How long have they rusted here...?"
msgstr "다크 저스티시어의 무기야. 이 아래에서 얼마나 오랫동안 녹슬어 왔던 거지...?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_JusticiarEquipment_PAD
#. Speaker = Player
#. NodeID = 87ea7ea7-b9d0-4ddf-a43e-1e0210b724f3
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_JusticiarEquipment_PAD:87ea7ea7-b9d0-4ddf-a43e-1e0210b724f3
msgctxt "h3c92d6ffgf8e6g453cg8709gd807b1c44d73"
msgid "Abandoned to the elements. What a shame - this was quality gear."
msgstr "자연에 버림받았군. 참 아쉬워, 아주 훌륭한 장비였던 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_JusticiarEquipment_PAD
#. Speaker = Player
#. NodeID = 87ea7ea7-b9d0-4ddf-a43e-1e0210b724f3
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: CLERIC_SHAR or PALADIN_SHAR
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_JusticiarEquipment_PAD:87ea7ea7-b9d0-4ddf-a43e-1e0210b724f3
msgctxt "h1edd2a3cg6fc5g4077g9c59gc9a04077bb9f"
msgid ""
"These are Sharran weapons. I would recognise the Nightsinger's blades "
"anywhere."
msgstr "이건 샤 숭배자들의 무기였어. 나이트싱어의 칼날은 어디서든 알아볼 수 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_JusticiarEquipment_PAD
#. Speaker = Player
#. NodeID = 87ea7ea7-b9d0-4ddf-a43e-1e0210b724f3
#. HandlePath = TaggedText[7].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_JusticiarEquipment_PAD:87ea7ea7-b9d0-4ddf-a43e-1e0210b724f3
msgctxt "h2bb53c21g42efg4a53ga71bg10932376d072"
msgid ""
"Someone forgot to oil their equipment. Everything here is rusted to the "
"Hells and back."
msgstr "누군가 무기에 기름칠 하는 걸 깜빡했네. 이곳에 있는 무기들은 지옥까지 녹슬어 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_JusticiarEquipment_PAD
#. Speaker = Player
#. NodeID = e938fcf9-b19a-a3b8-1069-92531e4d0496
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_JusticiarWeaponRack_ReligionCheckSuccess = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_JusticiarEquipment_PAD:e938fcf9-b19a-a3b8-1069-92531e4d0496
msgctxt "hfa0a3063g7a96g4822g9d3eg1fb2557e17bb"
msgid ""
"These are Sharran weapons. I would recognise the Nightsinger's blades "
"anywhere."
msgstr "이건 샤 숭배자들의 무기였어. 나이트싱어의 칼날은 어디서든 알아볼 수 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_LoneDuergar_PAD_FoundCamp
#. Speaker = Player
#. NodeID = 1db5e819-855a-19ea-9d21-ffc9bd941580
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_LoneDuergar_PAD_FoundCamp:1db5e819-855a-19ea-9d21-ffc9bd941580
msgctxt "h02881cf5g9c1bg41d7g8a2bgc3ff8de19a18"
msgid "The camp looks abandoned. And rightly so."
msgstr "이 야영지는 버려진 듯하군. 그럴 만도 하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_LoneDuergar_PAD_FoundCamp
#. Speaker = Player
#. NodeID = 1db5e819-855a-19ea-9d21-ffc9bd941580
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_LoneDuergar_PAD_FoundCamp:1db5e819-855a-19ea-9d21-ffc9bd941580
msgctxt "h6a729441gc1f8g47cegb9bdg08b6568d40b3"
msgid "A campsite. Nobody's home, though."
msgstr "야영지야. 그런데, 아무도 없군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_LoneDuergar_PAD_FoundCamp
#. Speaker = Player
#. NodeID = 1db5e819-855a-19ea-9d21-ffc9bd941580
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_LoneDuergar_PAD_FoundCamp:1db5e819-855a-19ea-9d21-ffc9bd941580
msgctxt "hd6c8784dg43c1g4a4aga0c0ge5f83f6e6bc7"
msgid "Huh. Looks abandoned."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_LoneDuergar_PAD_FoundCamp
#. Speaker = Player
#. NodeID = 1db5e819-855a-19ea-9d21-ffc9bd941580
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_LoneDuergar_PAD_FoundCamp:1db5e819-855a-19ea-9d21-ffc9bd941580
msgctxt "h584c7807g1a8dg463cga4a9gb84022d56eb1"
msgid "Old camp. Abandoned, from the looks of it."
msgstr "오래된 야영지야. 광경으로 봐서는 버려졌군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_LoneDuergar_PAD_FoundCamp
#. Speaker = Player
#. NodeID = 1db5e819-855a-19ea-9d21-ffc9bd941580
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_LoneDuergar_PAD_FoundCamp:1db5e819-855a-19ea-9d21-ffc9bd941580
msgctxt "h53c7088fg4accg4650g8462g9c1c41a161e7"
msgid "A camp. Looks like it's been sitting empty a while."
msgstr "야영지야. 꽤 오랫동안 비어 있었던 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_LoneDuergar_PAD_FoundCamp
#. Speaker = Player
#. NodeID = 1db5e819-855a-19ea-9d21-ffc9bd941580
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_LoneDuergar_PAD_FoundCamp:1db5e819-855a-19ea-9d21-ffc9bd941580
msgctxt "had7ca1fcg5b57g44e3g95feg3790a2e70aef"
msgid "No signs of life. This camp's long been abandoned."
msgstr "삶의 흔적이 없군. 이 야영지는 버려진 지 오래야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_LoneDuergar_PAD_FoundCamp
#. Speaker = Player
#. NodeID = 1db5e819-855a-19ea-9d21-ffc9bd941580
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_LoneDuergar_PAD_FoundCamp:1db5e819-855a-19ea-9d21-ffc9bd941580
msgctxt "h7183e14dg4ad3g4acbga02egfe2efd94d506"
msgid "A camp. Looks abandoned."
msgstr "야영지야. 버려진 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_MerregonMask_PAD
