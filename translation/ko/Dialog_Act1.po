msgctxt "ha3bdae44gced0g40aagb7adgd9b01f176304"
msgid "We have a chance at a new start. <i>Finally.</i>"
msgstr "새로이 시작할 기회가 열렸구나. <i>마침내.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover_AD_1
