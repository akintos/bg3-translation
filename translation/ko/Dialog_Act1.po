msgstr "우리는 절대자님의 이름 아래 싸운다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_DrowLeavingReady
#. Speaker = Nightwarden Minthara
#. NodeID = 72b71af5-00d7-0afb-5f61-006909eb0469
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
