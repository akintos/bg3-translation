msgctxt "h3e8d144fg4378g4771g8f10gdc56990dd833"
msgid "<i>Tsk'va!</i> Guards! To me!"
msgstr "<i>츠크바!</i> 경비병, 내게로 와라!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_AD_CaptainOrdersToCloseDoor
#. Speaker = Kith'rak Therezzyn
#. NodeID = 66eff312-d201-b2e9-160d-5508f274ac91
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_AD_CaptainOrdersToCloseDoor:66eff312-d201-b2e9-160d-5508f274ac91
msgctxt "hd6294bf8g1050g4792gbed8g594c48432b9a"
msgid "Shut those doors - this is <i>not</i> a public forum."
msgstr "저 문을 닫고 와라. 여기는 공개 토론장 같은 곳이 <i>아니니까</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_AD_CaptainRealizesTheft
#. Speaker = Kith'rak Therezzyn
#. NodeID = 01ac2597-5a14-4324-bf19-2a096a294d60
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_AD_CaptainRealizesTheft:01ac2597-5a14-4324-bf19-2a096a294d60
msgctxt "h00676ef1g85a1g4e51gb51bgb212c13152a4"
msgid "Where is my key...? YOU. THIEF."
msgstr "내 열쇠가 어디로 갔지...? <b>너구나. 도둑놈</b>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_AD_CaptainSendsPlayerToInquisitior
#. Speaker = Kith'rak Therezzyn
#. NodeID = 88a579d8-5b8c-bf3a-5ee0-8c7012534f2d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
