msgctxt "hcc441a21g4f65g45a4g9da3g03802eb7bdef"
msgid "*As the symbol glows, power courses through you. <i>Authority</i>.*"
msgstr "*문양이 빛나며, 몸에 흐르는 힘이 느껴집니다. <i>권위</i>.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SecludedSpot_Trespassing
#. Speaker = Player
#. NodeID = 093883ca-0848-b3fc-69c0-05d1006fcb00
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SecludedSpot_Trespassing:093883ca-0848-b3fc-69c0-05d1006fcb00
msgctxt "h2d43c069g53a8g4c89g83b4g212a8415be14"
msgid "Then you should know not to cross a True Soul."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SecludedSpot_Trespassing
#. Speaker = Player
#. NodeID = 1b3760be-bb52-9e0c-ef60-f866c9449397
