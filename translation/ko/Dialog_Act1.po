msgctxt "ha1bcfa65gf49cg46e3g8e86g13b6eb7d3d2a"
msgid "Drow... master's master. No bite."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeWorg2
#. Speaker = Worg
#. NodeID = e4821246-eb33-65b2-c81d-5fe68f6789d0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_GnomeGoblinsPacified = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeWorg2:e4821246-eb33-65b2-c81d-5fe68f6789d0
msgctxt "h3b605a53ge05bg42fdg8277g06dac132cf77"
msgid "Time to go. Time to hunt."
msgstr "갈 시간이다. 사냥할 시간이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeWorg2
#. Speaker = Worg
#. NodeID = f98e2be9-5ba4-9de3-8b02-3c819b5898ec
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - WLD_FOR_GnomeGoblinsAngry = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeWorg2:f98e2be9-5ba4-9de3-8b02-3c819b5898ec
msgctxt "h45cb068dg260eg44fcg9c9bgefcf3accc37c"
msgid "Rip the meat! Rip the throat! Roll in the blood!"
msgstr "고기 찢는다! 모가지 찢는다! 피에 구른다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeWorg2_AD_Mocking
#. Speaker = Worg
#. NodeID = d448eb14-e2e0-05d7-af4a-b0c9a3cb7f64
