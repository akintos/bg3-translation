msgctxt "hb6a0cc80g3673g40c6g88d7gd4b007f82ed3"
msgid "I'd rather watch."
msgstr "난 지켜보는 편이 좋아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
