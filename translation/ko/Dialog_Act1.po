msgctxt "h0e2d3a4agd89fg4a78g8972gdbc6cd5cc230"
msgid "Curious mask. What's it doing here?"
msgstr "신기한 마스크군. 이게 여기서 뭐하고 있는 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_MerregonMask_PAD
