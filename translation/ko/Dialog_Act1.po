msgctxt "h361f2633gbaa9g4a5eg90d7g5cafdab41197"
msgid "<i>Sneak away.</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SecludedSpot_Trespassing
#. Speaker = Player
#. NodeID = fa62b809-4d5e-7532-e9d9-60a7d8bc6e43
#. HandlePath = TaggedText[0].TagText[0]
