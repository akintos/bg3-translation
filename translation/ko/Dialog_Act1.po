msgctxt "h54bc1896g225cg4918g9932g4c66b36149a6"
msgid "And you better hope that's the worst of it."
msgstr "그리고 그게 최악이길 빌어야 할 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarGuardSergeant_AD
#. Speaker = Sergeant Thrinn
