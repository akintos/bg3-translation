msgctxt "h48bcd57dg0ae5g4227ga65dg709f8c869250"
msgid "Stealing toys from children? You're <i>so</i> brave."
msgstr "아이들한테서 장난감을 훔치기? 너 <i>정말</i> 용감하다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_MageHandKid01
