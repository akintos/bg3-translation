msgctxt "h7956d9f7g4a96g4c94ga395gb509d63e6ab1"
msgid "What beautiful music..."
msgstr "이다지도 아름다운 노래라니..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerCharmed
