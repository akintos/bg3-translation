msgctxt "h2fd85367gb4a6g4908g9e85g5d8f0a22f1a4"
msgid "Move. I'm from <i>Moonrise Towers</i>."
msgstr "비켜라. 나는 <i>문라이즈 타워</i>에서 왔다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Trespassing
