#.      - UND_FurnaceSearch_State_DisguisedJournalIllusionDropped = False
#.   Tag:
#.      - REALLY_UNDERDARK(1) = True
#.      - RANGER(1) = False
#.      - DRUID(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_DisguisedJournal:fc6a8a29-8e50-2d3a-b527-2e64dcd740a2
msgctxt "h25d6e178ga1bbg45d4g83e0gf41e16c3aafb"
msgid ""
"<i>Flumphs - largely benign parasites. But what do you know of their love "
"lives?</i>"
msgstr "<i>플럼프 - 대체로 온순한 기생충이다. 하지만 그들의 성 생활에 관해 아는 바가 있나?</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_MyconidDrow_Dead
#. Speaker = Player
#. NodeID = 01df7530-8595-4eb4-9129-47e5854b95aa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
