msgctxt "h5c0b706bge41eg48f9gbe23gc160aaa4e91b"
msgid "<i>Hshar'lak! </i>Guards, a betrayer!"
msgstr "<i>흐샬락! </i>경비병, 여기 배신자가 있다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_AD_CaptainCallsGuards
#. Speaker = Kith'rak Therezzyn
#. NodeID = 85a0b0aa-973f-ab17-8d56-d649d46c1014
#. HandlePath = TaggedText[0].TagText[0]
