msgctxt "hf00e762agf4c4g481bg9aa4gf4a881dae4ae"
msgid "Oh no. She... she's dead."
msgstr "이런, 이미... 죽었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_FoundWife
#. Speaker = Player
#. NodeID = f5f3a235-94a0-e60e-fb7e-68316c1bba8c
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_FoundWife:f5f3a235-94a0-e60e-fb7e-68316c1bba8c
msgctxt "h7ed8a13egfc41g4609g968ag7cc8c8075ca6"
msgid "She's not breathing."
msgstr "숨을 쉬지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_TooHeavy
