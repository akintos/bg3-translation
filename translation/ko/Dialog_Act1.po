#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agents_AD_Attacked
#. Speaker = Rugan
#. NodeID = d5faa0d0-9bcb-6260-4c15-0c6d55d97945
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agents_AD_Attacked:d5faa0d0-9bcb-6260-4c15-0c6d55d97945
msgctxt "h6b75405ag0a0fg43b1g81b9g37e7a5901264"
msgid "You bloody fool! C'mere, beasties - fresh meat!"
msgstr "이 빌어먹을 멍청이가! 이리 와라, 야수들아 - 신선한 고기다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agents_AD_ChestAfterCombat
#. Speaker = Rugan
#. NodeID = 181ff4ad-02a4-a9e5-ce12-e50fb064392e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_ChestNotInPlace = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agents_AD_ChestAfterCombat:181ff4ad-02a4-a9e5-ce12-e50fb064392e
msgctxt "hbca2d448gf433g4fd5g92d4gecdfe31f135f"
msgid "Where the hells is the chest? It was right here!"
msgstr "젠장, 상자는 어디로 갔지? 방금 여기 있었는데!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agents_AD_ChestAfterCombat
#. Speaker = Olly
#. NodeID = 21471c28-7fde-db3f-159f-d96816dc79db
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_BothAgentsAreAlive = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agents_AD_ChestAfterCombat:21471c28-7fde-db3f-159f-d96816dc79db
msgctxt "hde23305bg39b9g48efgb468gff9d38c41eb2"
msgid "How are you holding up, Rugan?"
msgstr "상태는 좀 어때, 루간?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agents_AD_ChestAfterCombat
#. Speaker = Rugan
#. NodeID = a122b001-e292-331c-0ebb-4adf8eeef23b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agents_AD_ChestAfterCombat:a122b001-e292-331c-0ebb-4adf8eeef23b
msgctxt "h3ec98f9dg8807g45fega235g06d0002f2690"
msgid ""
"I'll be glad to see the back of this. Brought nothing but rotten luck since "
"we left Elturgard."
msgstr "이게 끝났으면 좋겠군. 엘투르가드를 떠나고 나서는 온갖 불운만 가져다 줬어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agents_AD_ChestAfterCombat
#. Speaker = Rugan
#. NodeID = bb65d567-4c64-3810-70c4-ca6821de244a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_ChestUnlocked = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agents_AD_ChestAfterCombat:bb65d567-4c64-3810-70c4-ca6821de244a
msgctxt "h7609ff79g35a7g4dc6ga13fgf0c67c7b9cf0"
msgid "Chest's intact... more or less."
msgstr "상자는 온전해... 대체로."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agents_AD_ChestAfterCombat
#. Speaker = Rugan
#. NodeID = f2df646f-e3ba-1334-3dd5-b662a10092f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agents_AD_ChestAfterCombat:f2df646f-e3ba-1334-3dd5-b662a10092f4
msgctxt "h4c5f58a5g03a4g4c20g82e6gb2331c0e7223"
msgid "I'm fine. And so's the chest, more importantly."
msgstr "난 괜찮아. 그리고 더 중요한 건, 상자는 멀쩡해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agents_AD_FlasksLow
#. Speaker = Olly
#. NodeID = 07c088c8-29a5-ba11-14ca-99e194de756e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agents_AD_FlasksLow:07c088c8-29a5-ba11-14ca-99e194de756e
msgctxt "h8f1a4d3fg74ffg482cgacd4g805cf4dfb71e"
msgid "The fire's the only thing holding them back!"
msgstr "놈들을 막고 있는 건 불꽃 뿐이오!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agents_AD_FlasksLow
#. Speaker = Olly
#. NodeID = 6f168496-39c1-1296-c4d7-053965bbb897
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agents_AD_FlasksLow:6f168496-39c1-1296-c4d7-053965bbb897
msgctxt "h8b2cf2fdg04e0g4864gb8bdgdb6480c49466"
msgid "I'm almost out of flasks!"
msgstr "플라스크가 거의 떨어졌어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agents_AD_FlasksLow
#. Speaker = Rugan
#. NodeID = d2b6adc6-c856-6c20-7c7e-6b9a40b67cdc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agents_AD_FlasksLow:d2b6adc6-c856-6c20-7c7e-6b9a40b67cdc
msgctxt "h1b8547e1g44ccg44e5ga7f0g29f26c526abe"
msgid "I've been in worse spots, lad. Just follow my lead."
msgstr "이보다 더한 상황도 겪어봤소, 친구. 그냥 내 지휘를 따르시오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agents_AD_FlasksLow
#. Speaker = Rugan
#. NodeID = e83b3de5-9f17-633a-1eb0-1b72a381ddf3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agents_AD_FlasksLow:e83b3de5-9f17-633a-1eb0-1b72a381ddf3
msgctxt "h803d6c33g3824g4661g8bf5g4e0a7c88a45c"
msgid "Keep steady. We're not finished yet."
msgstr "긴장 풀지 마. 아직 끝나지 않았으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agents_AD_Joining
#. Speaker = Rugan
#. NodeID = 1a85a6c6-849f-898f-bca1-4462ac15d4db
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_BothAgentsAreAlive = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agents_AD_Joining:1a85a6c6-849f-898f-bca1-4462ac15d4db
msgctxt "hffd0db10gfd16g4a54gbe3dg72c00fe7946d"
msgid "Take the leader down - I'll try to hold the rest back!"
msgstr "우두머리를 쓰러뜨리시오, 내가 나머지를 막아보겠소!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agents_AD_Joining
#. Speaker = Rugan
#. NodeID = cbe7dc36-06f8-a3b4-dc61-c4bb1509a078
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_BothAgentsAreAlive = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agents_AD_Joining:cbe7dc36-06f8-a3b4-dc61-c4bb1509a078
msgctxt "h47c31928gbf1eg440cgaa6fg728ffb6aa3c8"
msgid "Take the leader down - we'll try to hold the rest back!"
msgstr "우두머리를 쓰러뜨리시오, 우리가 나머지를 막아두겠소!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agents_AD_OutOfFlasks
#. Speaker = Olly
#. NodeID = a42fc0b1-b60c-eb96-01ae-81f8698f1dbb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_BothAgentsAreAlive = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agents_AD_OutOfFlasks:a42fc0b1-b60c-eb96-01ae-81f8698f1dbb
msgctxt "hfd37a9e3g9811g4b89g8568gf38b08b1f31f"
msgid "I'm out of flasks! They're coming!"
msgstr "플라스크가 떨어졌어! 놈들이 온다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agents_AD_OutOfFlasks
#. Speaker = Rugan
#. NodeID = c9e6c36c-61a9-b610-39dd-b31af4d0ab83
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agents_AD_OutOfFlasks:c9e6c36c-61a9-b610-39dd-b31af4d0ab83
msgctxt "h2c12dbe2g81a3g4379g92b7gfe7006efd6fe"
msgid "That's the last of the flasks! Fall back!"
msgstr "그게 마지막 플라스크였어! 후퇴!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agents_AD_Retreating
#. Speaker = Rugan
#. NodeID = 10819733-6750-e6c4-238d-6f19c8609417
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agents_AD_Retreating:10819733-6750-e6c4-238d-6f19c8609417
msgctxt "h108ab332gecc8g48b2ga0d3g14b2b5d97cf4"
msgid "Don't be a fool, lad. Shut your mouth, and keep your head down."
msgstr "멍청한 짓 하지 마, 녀석아. 입 다물고, 고개를 숙이고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agents_AD_Retreating
#. Speaker = Rugan
#. NodeID = 8324b4c4-bed7-fc35-fb3e-92d67300ee75
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_BothAgentsAreAlive = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agents_AD_Retreating:8324b4c4-bed7-fc35-fb3e-92d67300ee75
msgctxt "h534e3c14g230fg441fgb978g8586b4eb4422"
msgid "Oh, gods. They've found fresh prey."
msgstr "오, 신이시여. 놈들이 신선한 먹잇감을 찾았군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agents_AD_Retreating
#. Speaker = Rugan
#. NodeID = a9acc859-a47e-1d83-6d93-4a57908fc4e6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agents_AD_Retreating:a9acc859-a47e-1d83-6d93-4a57908fc4e6
msgctxt "h047a12d4gaa62g43f0g8728g50594f7fc7ba"
msgid "Leave the heroics to them that don't value their own skin."
msgstr "영웅심은 자기 목숨을 아끼지 않는 이들에게 남겨두라지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agents_AD_Retreating
#. Speaker = Olly
#. NodeID = aa47db93-a01c-f52d-d671-f139bee790ea
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentShipment_State_BothAgentsAreAlive = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agents_AD_Retreating:aa47db93-a01c-f52d-d671-f139bee790ea
msgctxt "h12c62c2dg6a8ag44ceg9150g8f7679e6a216"
msgid "Hear that? Someone's fighting the gnolls! We should help!"
msgstr "들려요? 누군가 놀과 싸우고 있어요! 우리가 도와줘야 해요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Olly_AD_AfterCombatReaction
#. Speaker = Olly
#. NodeID = 4e9e1a03-de9a-7328-5175-5597a39fba8a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Olly_AD_AfterCombatReaction:4e9e1a03-de9a-7328-5175-5597a39fba8a
msgctxt "h49be5adcg9373g4685ga317gf9add3f5b982"
msgid "Ah, Rugan... old bastard thought he'd live forever."
msgstr "아, 루간... 저 늙은이는 자기가 영원히 살 줄 알았겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Olly_AD_NoRuganTouchedChest
#. Speaker = Olly
#. NodeID = 34b83e9c-755c-f209-67fe-15f009b0d86c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Olly_AD_NoRuganTouchedChest:34b83e9c-755c-f209-67fe-15f009b0d86c
msgctxt "h41d39954gc27dg4b7bg904cgc84c3932a1a5"
msgid "Whatever's inside is probably cursed.  Brought us nothing but bad luck."
msgstr "이 안에 뭐가 있는진 모르겠지만, 저주 받은 게 분명해.  우리에게 불운밖에는 가져다주지 않았거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Olly_AD_NoRuganTouchedChest
#. Speaker = Olly
#. NodeID = 46575354-300c-28f3-9de9-993c65cf7de0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Olly_AD_NoRuganTouchedChest:46575354-300c-28f3-9de9-993c65cf7de0
msgctxt "h8ddfbc87g9b00g4380gb7d1gf815aebac2d8"
msgid "You can take the bloody chest."
msgstr "그 망할 궤짝은 당신이 가져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Rugan_AD_AfterCombatReaction
#. Speaker = Rugan
#. NodeID = 70ce4b69-fb46-3e21-b0a7-1a7459b82b7a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ConflictedFlind_State_Gone = True
#.      - PLA_ZhentShipment_State_BothAgentsAreAlive = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Rugan_AD_AfterCombatReaction:70ce4b69-fb46-3e21-b0a7-1a7459b82b7a
msgctxt "hdd4d15b5g7529g44aag82a7g2fa41ce47593"
msgid "Well, lad. It's our lucky day after all."
msgstr "글쎄, 친구. 결국 오늘은 우리에게 행운의 날인 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Rugan_AD_AfterCombatReaction
#. Speaker = Rugan
#. NodeID = 7c654f00-6ce0-9592-cee4-5bd34b9787bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Rugan_AD_AfterCombatReaction:7c654f00-6ce0-9592-cee4-5bd34b9787bf
msgctxt "h668dfa38g01c3g4642g9591g6f5a42633c27"
msgid "And so does his coin."
msgstr "그의 동전도 마찬가지야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Rugan_AD_AfterCombatReaction
#. Speaker = Rugan
#. NodeID = dd6c9cf3-d198-1c69-38e6-a797ebbd28c6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ConflictedFlind_State_Gone = True
#.      - PLA_ZhentShipment_State_BothAgentsAreAlive = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Rugan_AD_AfterCombatReaction:dd6c9cf3-d198-1c69-38e6-a797ebbd28c6
msgctxt "h560a26b1g5f4dg45c2gb5bfg063ad67f7d30"
msgid "Poor lad. He deserved better."
msgstr "불쌍한 녀석. 이런 최후는 바라지 않았는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_VB_BloodSymbol
#. Speaker = Player
#. NodeID = b739030b-40b7-5bb4-caa8-416a8f3d5f95
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Absolute_Knows_Symbol = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_VB_BloodSymbol:b739030b-40b7-5bb4-caa8-416a8f3d5f95
msgctxt "h9887e37dg4bafg45eaga433gd9748c3c2948"
msgid "That symbol, in the blood... what does it mean?"
msgstr "저 표식, 피로 새겨져 있군... 무슨 의미지?"

