msgctxt "h8df36e6bgbb70g46baga9d3g23069e96992c"
msgid "<i>Attack Lae'zel.</i>"
msgstr "<i>레이젤을 공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaezelRecruitment_TieflingsSceneFallback
#. Speaker = Narrator
#. NodeID = 082a459d-bfa3-4c60-b0b9-9b02f85cf7ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaezelRecruitment_TieflingsSceneFallback:082a459d-bfa3-4c60-b0b9-9b02f85cf7ad
msgctxt "h3b522787g0fdag4581g9d7eg9d8bf0335a87"
msgid "*And you feel answers. She knows more about your condition.*"
msgstr "*그리고 해답이 느껴집니다. 저쪽은 당신의 상태에 관해 잘 알고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaezelRecruitment_TieflingsSceneFallback
#. Speaker = Lae'zel
#. NodeID = 3eea1c9a-4cd4-4820-99e3-c62bf6cc3982
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_LaezelRecruitment_State_Tiefling1Missing = False
#.      - CHA_LaezelRecruitment_State_Tiefling2Missing = False
