msgctxt "h98edc233g76ecg407dgac76g99d70ff449f5"
msgid "One more round!"
msgstr "한 잔 더 가져 와!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_TakeRefill_004
#. Speaker = Sharp-Eye Mirg
#. NodeID = 5828c823-063b-6004-9491-8333e27b256e
#. HandlePath = TaggedText[0].TagText[0]
