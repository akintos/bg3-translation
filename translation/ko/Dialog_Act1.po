msgctxt "hbbbc7fe3g85acg4d73g9a64g355648faa5c0"
msgid "<i>Move the telescope to the left.</i>"
msgstr "<i>망원경을 왼쪽으로 돌린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_AbandonedHideoutThreat
#. Speaker = Mattis
#. NodeID = 4dcf385d-546f-c78c-2f14-6f17810b636c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_AbandonedHideoutThreat:4dcf385d-546f-c78c-2f14-6f17810b636c
#, fuzzy
msgctxt "h45205affg079cg405fgbb32g1d89eaf81d48"
msgid "You're going to get it now."
msgstr "이제 돌려받게 될 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_AdventurervsKid
#. Speaker = Barth
#. NodeID = 461a22f0-daef-ab7a-f2a4-720a4c9495cf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_State_DoneChase(0) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_Thieflings_State_DoneChase(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_AdventurervsKid:461a22f0-daef-ab7a-f2a4-720a4c9495cf
msgctxt "hb509fd24g6109g4cefg87d3gaecf7c1b71dd"
msgid "Don't make me hurt you, boy."
msgstr "다치기 싫으면 서라, 꼬맹아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_AdventurervsKid
#. Speaker = Meli
#. NodeID = 5efcbbb4-4ddc-0564-4280-26247e7dc3b0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_AdventurervsKid:5efcbbb4-4ddc-0564-4280-26247e7dc3b0
msgctxt "h2ac11fffg0d07g4bc5ga6f5gcbbdd99864bb"
msgid "Too late. Looking at you is painful enough."
msgstr "이미 다쳤는데. 댁 면상 본 탓에 눈 아파 죽겠다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_AdventurervsKid
#. Speaker = Meli
#. NodeID = 7dc48ae1-8d81-bff4-3b64-5cf8a1a7ee8a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_AdventurervsKid:7dc48ae1-8d81-bff4-3b64-5cf8a1a7ee8a
msgctxt "hbe13b175gd7dcg40b5g8c3bg677cf99fc9ba"
msgid "Touch me and I'll bite your fingers off. I will!"
msgstr "나 건드리면 손가락을 물어 뜯어 버릴 거야. 진짜라고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_AdventurervsKid
#. Speaker = Meli
#. NodeID = 7dd67046-87de-aba8-6438-64968300a688
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_AdventurervsKid:7dd67046-87de-aba8-6438-64968300a688
msgctxt "he87ce1adg95acg4da8g8f28g4bc55da31fec"
msgid "I already told you I don't have it. How stupid are you?"
msgstr "나한테 없다고 아까 전에 말했잖아. 얼마나 멍청한 거래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_AdventurervsKid
#. Speaker = Barth
#. NodeID = 91cecbdc-3f87-dd94-cb87-e400d9a2ebd8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_State_DoneChase(0) = True
#.   Local:
#.      - c0fdd338-b65b-aeb4-0010-d75669879dee_Switch = True
#. SetFlags:
#.   Local:
#.     - c0fdd338-b65b-aeb4-0010-d75669879dee_Switch = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_AdventurervsKid:91cecbdc-3f87-dd94-cb87-e400d9a2ebd8
msgctxt "h5c3ae7f9g2f59g4514g8ccdgeb88fba5c23f"
msgid "Don't you lie to me, boy. I know you have it."
msgstr "거짓말 집어 치워, 새끼야. 너한테 있단 거 알아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_AdventurervsKid
#. Speaker = Barth
#. NodeID = f827cb4a-3f10-e451-7ad2-537f033b3d9f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Thieflings_State_DoneChase(0) = True
#.   Local:
#.      - c0fdd338-b65b-aeb4-0010-d75669879dee_Switch = False
#. SetFlags:
#.   Local:
#.     - c0fdd338-b65b-aeb4-0010-d75669879dee_Switch = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_AdventurervsKid:f827cb4a-3f10-e451-7ad2-537f033b3d9f
msgctxt "h38003824g62f0g4c31gb5a2g955bbe43e922"
msgid "Give it back, kid."
msgstr "내놓으라고, 짜샤."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_CannotFitCrack
#. Speaker = Player
#. NodeID = 63ebb2cc-cfee-80bb-faf7-e5f92864aacf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Thieflings_Event_LeftHideoutNormally(0) = False
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Event_PCCouldntFitIntoCrack = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_CannotFitCrack:63ebb2cc-cfee-80bb-faf7-e5f92864aacf
msgctxt "h452a3ac7g855ag4b42g801bgfe3e37b0b736"
msgid "I can't fit through here. Wonder if there's another way in."
msgstr "지나갈 수 없어. 다른길이 있는지 궁금한걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_CannotFitCrack
#. Speaker = Player
#. NodeID = a7ac2259-b437-3ec4-8b5d-b2f092dde2f3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Thieflings_Event_LeftHideoutNormally(0) = True
#. SetFlags:
#.   Object:
#.     - DEN_Thieflings_Event_LeftHideoutNormally(0) = False
#. TagRule: DWARF or GNOME or HALFLING or KID or SHORT
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_CannotFitCrack:a7ac2259-b437-3ec4-8b5d-b2f092dde2f3
msgctxt "hc6b3465eg3480g46a3ga2e1g553ba82b4f26"
msgid "Tight fit. I barely got through."
msgstr "꽉 끼는군. 간신히 통과했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_CannotFitCrack
#. Speaker = Player
#. NodeID = a7ac2259-b437-3ec4-8b5d-b2f092dde2f3
