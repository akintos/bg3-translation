msgctxt "h2de1d970g4fb3g48fdg8714gfedba5050c8e"
msgid "*Grunt.*"
msgstr "*끙.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_GruntingKid
#. Speaker = Doni
#. NodeID = ef62a7af-a1df-9403-94b7-b9d3bc0c101a
