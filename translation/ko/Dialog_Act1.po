msgctxt "hcab2e0f6g8b10g4998g9f38gd8d593ef0c24"
msgid ""
"Those beasts tore through our best agents - can't believe you took them down."
msgstr "저 야수들이 우리 최정예 요원들을 갈가리 찢어버렸어요, 당신이 놈들을 해치우다니 믿을 수가 없군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_002
#. Speaker = Olly
#. NodeID = 9214b852-8be4-5a27-f6c6-d74b6b250e1d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentDungeon_State_GnollZhentsPresent = True
#.      - PLA_ZhentShipment_State_Talked = True
#.      - PLA_ZhentShipment_Rugan_Knows_SentByZarys = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_002:9214b852-8be4-5a27-f6c6-d74b6b250e1d
msgctxt "h5df0454fgc647g4f6cg9c3bg147925e246e0"
msgid "Good to see you. Killed any more beasts out there?"
msgstr "다시 보니 반갑군요. 또 밖에서 야수들을 해치우고 왔나요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentShipment_Agent_002
#. Speaker = Olly
