msgctxt "hfb9eef1bg52d1g4488g9936gc93e4f684522"
msgid "<i>Square your stance and face him directly.</i>"
msgstr "<i>자세를 정돈하고 놈을 정면으로 마주 본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive
#. Speaker = Frightened Ox
#. NodeID = ddfec2a2-7c89-3d12-d7db-3a088fd83d2e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive:ddfec2a2-7c89-3d12-d7db-3a088fd83d2e
msgctxt "hd5e06850g8cafg45e0gac71gab4e698f2cdb"
msgid "I made him stop screaming."
msgstr "내가 그의 비명을 멈췄어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive
#. Speaker = Narrator
#. NodeID = e5060e2b-1024-80cf-42ba-7f988d1a9256
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive:e5060e2b-1024-80cf-42ba-7f988d1a9256
msgctxt "h442fbe44gab45g447bgae94g6c7c11d8796d"
msgid "*The ox tenses, horns lowered in your direction.*"
msgstr "*황소가 긴장하며, 뿔을 당신 쪽으로 내립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive
#. Speaker = Frightened Ox
#. NodeID = ea22a6fb-f2b9-3d1a-8ddb-bc8e3df54a38
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive:ea22a6fb-f2b9-3d1a-8ddb-bc8e3df54a38
msgctxt "h2d5411dag52dfg4981ga60dg6f4705abbfb1"
msgid "LIAR! DIE!"
msgstr "거짓말쟁이! 죽어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive
#. Speaker = Frightened Ox
#. NodeID = eb289246-d7c2-8f30-710b-0b15445aa5ea
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - SHORT(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive:eb289246-d7c2-8f30-710b-0b15445aa5ea
msgctxt "ha4f476aeg8f28g4a9ag8faegf5df59fded9f"
msgid "No... you're not. They were small like you, but uglier."
msgstr "아니.. 당신은 아니야. 당신처럼 작았지만, 더 못생겼어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive
#. Speaker = Player
#. NodeID = f69ca4b0-4247-e433-17db-493ff550743c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive:f69ca4b0-4247-e433-17db-493ff550743c
msgctxt "h37700d2bg48a0g47e6g8a30g847e795c6beb"
msgid "<i>Defend yourself.</i>"
msgstr "<i>자신을 방어한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive
#. Speaker = Player
#. NodeID = f9738712-bee0-6307-73e8-9ad752fa6b42
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive:f9738712-bee0-6307-73e8-9ad752fa6b42
msgctxt "h79ec497bg458fg429ag86a6gbe7773a5cc18"
msgid "It's all right. What happened here?"
msgstr "괜찮아. 여기서 무슨 일이 있었던거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive
#. Speaker = Frightened Ox
#. NodeID = ff3bc3f3-7fc3-383e-22ca-1cda8d209014
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - PLA_Tavern_Ox_HasMet(1) = True
#.   Global:
#.     - PLA_Tavern_Event_CancelOxHostility = True
#.     - PLA_Tavern_State_OxPacified = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive:ff3bc3f3-7fc3-383e-22ca-1cda8d209014
msgctxt "h056b6f5bg51f2g45cdg8bf2g85c330c5b2ad"
msgid "I was ready to run you through. My mistake, friend."
msgstr "널 밟아주려던 참이었어. 미안해 내 실수야, 친구."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive_AD
#. Speaker = Frightened Ox
#. NodeID = 6d198456-7ba3-0581-8967-abd83abba2c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_OxAlive_AD:6d198456-7ba3-0581-8967-abd83abba2c9
msgctxt "hf7de857fg1089g4feegb9e3g5e25ca6f4067"
msgid "*Huff!*"
msgstr "*발끈함!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_Sign_PAD
#. Speaker = Player
#. NodeID = eb0935ce-caf0-aca5-5e0b-b8e89a24593e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_Sign_PAD:eb0935ce-caf0-aca5-5e0b-b8e89a24593e
msgctxt "h82a05c0fg7c09g4328g8605g6b00ed2d035e"
msgid ""
"'Welcome to Waukeen's Rest.\n"
"West - Baldur's Gate. East - Elturel.'"
msgstr ""
"'와우킨의 쉼터에 잘 오셨습니다.\n"
"서쪽 - 발더스 게이트. 동쪽 - 엘투렐.'"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_VB_Arrival
#. Speaker = Player
#. NodeID = e8f7a14b-7024-c3ab-32fd-dc6a61e5edb2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_VB_Arrival:e8f7a14b-7024-c3ab-32fd-dc6a61e5edb2
msgctxt "h85d04241gafb4g4d08gabdag79b7a0d79fab"
msgid "Smoke. Something's burning."
msgstr "연기야. 뭔가 불타고 있군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_VB_DeadDrow1Armor
