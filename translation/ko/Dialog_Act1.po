#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice:ec84e82d-1a32-d659-5698-24fd7d091d0b
msgctxt "h4f1e56a5ga6d7g422bga637gbf37f9971f9f"
msgid "<i>Dart your hand in, hoping to snatch the bag.</i>"
msgstr "<i>주머니가 잡히길 기대하며 손을 안쪽에 집어넣는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice
#. Speaker = Narrator
#. NodeID = f6ad6a8e-631d-c06c-ab64-b86fd93bf462
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice:f6ad6a8e-631d-c06c-ab64-b86fd93bf462
msgctxt "h82d13cadg2bacg43f8g8d23gb053ae798516"
msgid "*The spiders skitter about, more nervous than before.*"
msgstr "*거미들은 아까보다 더욱 경계를 하며 이리저리 움직입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice
#. Speaker = Player
#. NodeID = fff07367-2812-0f0d-02ed-9dfadc7eaa72
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_Outpost_Event_Calmed = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_Crevice:fff07367-2812-0f0d-02ed-9dfadc7eaa72
msgctxt "h17d98629g11e6g440fg8fe0g7496ba8155a4"
msgid "<i>Boldly reach for the bag.</i>"
msgstr "<i>대담하게 주머니를 향해 손을 뻗는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_PAD_Jewelry
#. Speaker = Player
#. NodeID = 65b0a0f3-fa9e-5ac8-1de4-fc48b8a7a53a
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_PAD_Jewelry:65b0a0f3-fa9e-5ac8-1de4-fc48b8a7a53a
msgctxt "hb55d64a9g3a81g4b06gaa63g2eeb4cb8626a"
msgid "A sigil of the Harpers. Odd for their kind to misplace this."
msgstr "하퍼즈의 인장이다. 이런 걸 잃어버릴 사람들이 아닌데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_PAD_Jewelry
#. Speaker = Player
#. NodeID = 65b0a0f3-fa9e-5ac8-1de4-fc48b8a7a53a
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_PAD_Jewelry:65b0a0f3-fa9e-5ac8-1de4-fc48b8a7a53a
msgctxt "hfcc787c3gd792g4658gb9bagdb8a583ce7e4"
msgid "Necklace has a Harper sigil. Why were they here?"
msgstr "목걸이에는 하퍼즈의 인장이 있어. 그들이 여기에 왜 왔던 걸까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_PAD_Jewelry
#. Speaker = Player
#. NodeID = 7c3ca839-dddf-6b1c-9caa-a74b9ad69096
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRA_HarperBooster_State_ReadDocs = True
#. TagRule: REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_PAD_Jewelry:7c3ca839-dddf-6b1c-9caa-a74b9ad69096
msgctxt "hb1b11b8agdf66g484fgb80fgf72a95476e6a"
msgid ""
"This necklace's sigil was also in the cave. The Harpers have been unusually "
"active here."
msgstr "동굴에서도 이 목걸이에 있던 인장을 봤어. 하퍼즈가 이상하게도 여기서 활동을 했군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_PAD_Jewelry
#. Speaker = Player
#. NodeID = 7c3ca839-dddf-6b1c-9caa-a74b9ad69096
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRA_HarperBooster_State_ReadDocs = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_PAD_Jewelry:7c3ca839-dddf-6b1c-9caa-a74b9ad69096
msgctxt "h15615fa0gc619g49bfg9279g12a4ddabf908"
msgid "Necklace matches the sigil in that cave. The Harpers were busy."
msgstr "목걸이에 동굴에 있는 인장과 같은 것이 있어. 하퍼즈가 꽤나 바빴었군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_PAD_Jewelry
#. Speaker = Player
#. NodeID = fe07e017-aa86-8939-6705-8ff6a1118f63
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_PAD_Jewelry:fe07e017-aa86-8939-6705-8ff6a1118f63
msgctxt "h8e7fe135g4cd8g45eega7d8gb91012acc322"
msgid "Hideous trinket. Lacking in function or taste."
msgstr "흉측한 장신구로군. 기능도 없고 취향도 나빠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_PAD_Jewelry
#. Speaker = Player
#. NodeID = fe07e017-aa86-8939-6705-8ff6a1118f63
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outpost_PAD_Jewelry:fe07e017-aa86-8939-6705-8ff6a1118f63
msgctxt "ha5701bcfg532fg40e5g81bfgf6c5ebffd24a"
msgid "Odd necklace. Might sell for a few coppers."
msgstr "특이한 목걸이로군. 몇 푼은 하겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_AD_BanditReaction
#. Speaker = Gimblebock
#. NodeID = f0cdd401-378f-a30b-c893-ce645f465cd2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_AD_BanditReaction:f0cdd401-378f-a30b-c893-ce645f465cd2
msgctxt "h1445c68bgf049g43e2g9c56g7b001c1e3c0b"
msgid "Hold it! Not another step!"
msgstr "멈춰! 한 발짝도 떼지 마!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_AD_Bandit_Caster_01_CrushedReaction
#. Speaker = Quelenna
#. NodeID = 687d36ed-d8d7-6418-3a5e-e7cdec6959e0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_AD_Bandit_Caster_01_CrushedReaction:687d36ed-d8d7-6418-3a5e-e7cdec6959e0
msgctxt "haecb2acag8916g46f0gb80dgb3fa21d765ba"
msgid "Well, that's one less greedy bastard to share the loot with."
msgstr "뭐, 보물 나눠 가질 욕심쟁이 한 놈 덜어낸 셈 쳐야겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_AD_Bandit_Melee_01_CrushedReaction
#. Speaker = Gimblebock
#. NodeID = a3c1a07d-a099-6b9a-e761-ece82bc8f37e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_AD_Bandit_Melee_01_CrushedReaction:a3c1a07d-a099-6b9a-e761-ece82bc8f37e
msgctxt "h70c9fa03g8761g41a8g82c8g2797fe28fdd4"
msgid "How the <i>hells</i> did that happen?!"
msgstr "<i>대체</i> 어쩌다 이 꼴이 난 거야?!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_AD_Bandit_Melee_02_CrushedReaction
#. Speaker = Taman
#. NodeID = 9fc5b3b4-fc7f-d419-6bd8-af1337c68ba7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_AD_Bandit_Melee_02_CrushedReaction:9fc5b3b4-fc7f-d419-6bd8-af1337c68ba7
msgctxt "h2fda3fa6g8902g43c2gb864g6ea987d504df"
msgid "We'd have been safer in the crypt!"
msgstr "지하 묘실 쪽에 있었어야 했어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_AD_Bandit_Ranger_01_CrushedReaction
#. Speaker = Warryn
#. NodeID = 1a45c7e5-64ea-dbbf-e2c0-79d2a7a1c210
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_AD_Bandit_Ranger_01_CrushedReaction:1a45c7e5-64ea-dbbf-e2c0-79d2a7a1c210
msgctxt "h49c8ac4ag6c30g4a21g824eg7472bf1fb290"
msgid "Gods. Look at that."
msgstr "맙소사. 저 난리 좀 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_AD_BanditsDiscussion
#. Speaker = Taman
#. NodeID = 249b351a-9c7c-d1c4-930b-58db3bbafc05
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_AD_BanditsDiscussion:249b351a-9c7c-d1c4-930b-58db3bbafc05
msgctxt "h334ba4e0g248bg40cag8689g261a14f8acab"
msgid "Of course I want to be rich - but not if it'll get me killed."
msgstr "당연히 부자 되고 싶지. 하지만 목숨 걸 정도까진 아니라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_AD_BanditsDiscussion
#. Speaker = Taman
#. NodeID = 37b19def-03f6-4da0-5dd6-43d1bdbe0b0f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_AD_BanditsDiscussion:37b19def-03f6-4da0-5dd6-43d1bdbe0b0f
msgctxt "h1f420069gffbag4521g993dgecb85c75ff66"
msgid "Haven't seen anyone but us. It's just wilderness out here."
msgstr "우리 말곤 사람 코빼기도 못 봤는데. 여긴 그냥 허허벌판이라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_AD_BanditsDiscussion
#. Speaker = Gimblebock
#. NodeID = 64fa7bce-1442-4cfd-a1c6-70bfb5f7e393
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - ed70fdfc-3d7b-7753-1171-957f7316fe55_A = True
#. SetFlags:
#.   Local:
#.     - ed70fdfc-3d7b-7753-1171-957f7316fe55_B = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_AD_BanditsDiscussion:64fa7bce-1442-4cfd-a1c6-70bfb5f7e393
msgctxt "h9a7591dcgb75ag40afg884ag84c759504040"
msgid "You'll die a bloody pauper unless you take a few risks."
msgstr "그렇게 몸 사리면 망할 비렁뱅이로 인생 쫑날걸?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_AD_BanditsDiscussion
#. Speaker = Gimblebock
#. NodeID = 77949158-1998-42a6-947b-8fadb738f8d0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - ed70fdfc-3d7b-7753-1171-957f7316fe55_B = True
#. SetFlags:
#.   Local:
#.     - ed70fdfc-3d7b-7753-1171-957f7316fe55_C = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_AD_BanditsDiscussion:77949158-1998-42a6-947b-8fadb738f8d0
msgctxt "h6931668cged97g4199g90efg61e083b8dae2"
msgid ""
"Either we act now, or someone else will pick that wreck clean and leave us "
"nothing."
msgstr "지금 당장 나서지 않으면, 누가 저 잔해 싹 털어먹을 거고, 우린 쥐뿔도 못 건질 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_AD_BanditsDiscussion
#. Speaker = Taman
#. NodeID = 7aa81437-a283-9597-a907-18c3d3754ea2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_AD_BanditsDiscussion:7aa81437-a283-9597-a907-18c3d3754ea2
msgctxt "h880147abg5597g4532g8ed9g6c1a44ef750c"
msgid "Why don't we just wait a while? Make sure it's safe."
msgstr "그냥 좀 기다려보는 게 어때? 안전한 건지부터 잘 따져야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_AD_BanditsDiscussion
#. Speaker = Taman
#. NodeID = 7fcff156-732c-a69f-c4e7-2898c26a1384
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_AD_BanditsDiscussion:7fcff156-732c-a69f-c4e7-2898c26a1384
msgctxt "h9af88afag473dg44ffg9170gc99d01a2644d"
msgid "Just being careful. Like my mum always said, fools rush in."
msgstr "난 그냥 조심하는 거야. 울 엄마는 무턱대고 덤비는 건 바보나 할 짓이랬어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_AD_BanditsDiscussion
#. Speaker = Gimblebock
#. NodeID = 80e1cc6e-ac1f-4745-942a-a5660fecf501
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - ed70fdfc-3d7b-7753-1171-957f7316fe55_A = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_AD_BanditsDiscussion:80e1cc6e-ac1f-4745-942a-a5660fecf501
msgctxt "h16db3af2g791cg42b9gb59fg8c2c907f1050"
msgid ""
"There could be all sorts of loot in that thing - don't you want to be rich?"
msgstr "저 함선 안에 온갖 귀중품이 들어있을지도 모른다고. 부자가 되고 싶지 않아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_AD_BanditsDiscussion
#. Speaker = Gimblebock
#. NodeID = ae094e18-a3cd-46aa-894d-b38f7373504e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - ed70fdfc-3d7b-7753-1171-957f7316fe55_C = True
#. SetFlags:
#.   Local:
#.     - ed70fdfc-3d7b-7753-1171-957f7316fe55_C = False
#.     - ed70fdfc-3d7b-7753-1171-957f7316fe55_B = False
#.     - ed70fdfc-3d7b-7753-1171-957f7316fe55_A = False
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_AD_BanditsDiscussion:ae094e18-a3cd-46aa-894d-b38f7373504e
msgctxt "hc41660e1g4a9cg4756g94fcg7283e3ce05ed"
msgid "Hells. Pity you aren't as good at graverobbing as you are at excuses."
msgstr "망할. 네 도굴 실력이 변명 실력 따라가지 못하는 게 다 아까울 지경이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_AD_Boulder
#. Speaker = Player
#. NodeID = 58c30498-8978-0fb6-1ce6-4a573eb432f2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_AD_Boulder:58c30498-8978-0fb6-1ce6-4a573eb432f2
msgctxt "hbdb72310g2009g4ee9g8adegc49dd3fdf25b"
msgid "Wouldn't take much to send that stone crashing downwards..."
msgstr "살짝만 밀면 저 돌을 아래로 떨어뜨릴 수 있을 것 같은데..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_BanditBackInteraction_Spotted
#. Speaker = Gimblebock
#. NodeID = 2172e59c-53b6-5042-695c-a639bd0210f2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_BanditBackInteraction_Spotted:2172e59c-53b6-5042-695c-a639bd0210f2
msgctxt "hb7f4d02agd121g4654g8131gfdfeaa209fba"
msgid "W-wha...? You killed them...?"
msgstr "뭐, 뭣...? 걔들을 죽였다고...?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_BanditBackInteraction_Spotted
#. Speaker = Quelenna
#. NodeID = 276ece0a-a093-631d-ae15-cc2df975e113
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_BanditBackInteraction_Spotted:276ece0a-a093-631d-ae15-cc2df975e113
msgctxt "h9b701faagdd7cg40c0g8cbbga6d971c1526d"
msgid "<i>Look out! </i>Someone's comin' from the crypt!"
msgstr "<i>조심해! </i>지하 묘실에서 누가 나오고 있어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_BanditBackInteraction_Spotted
#. Speaker = Player
#. NodeID = 27fd1f8b-4a0a-9550-7135-0c1e453706b0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_BanditBackInteraction_Spotted:27fd1f8b-4a0a-9550-7135-0c1e453706b0
msgctxt "hf8b98b2ag7835g400dgbda6ge67d0f0d8574"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_BanditBackInteraction_Spotted
#. Speaker = Player
#. NodeID = 2fbe4dd4-2175-dc6e-9fd7-ac04536980e9
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(4) = False
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_BanditBackInteraction_Spotted:2fbe4dd4-2175-dc6e-9fd7-ac04536980e9
msgctxt "hf017d20cgbe97g4b01gab9agbdeec36152d2"
msgid "It's mine now. Leave, before things get ugly."
msgstr "이젠 내 거야. 험한 꼴 보기 전에 꺼지시지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_BanditBackInteraction_Spotted
#. Speaker = Player
#. NodeID = 35ea4472-3ff3-17a4-ba02-cdcd39b45ad2
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - ASTARION(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_BanditBackInteraction_Spotted:35ea4472-3ff3-17a4-ba02-cdcd39b45ad2
msgctxt "h163a851cg0040g4bc0gb611gc81e38abcb80"
msgid "You have awoken me from my slumber - now I crave your blood!"
msgstr "네놈들이 나를 깊은 잠에서 깨웠구나... 내 너희의 피를 마시겠다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_BanditBackInteraction_Spotted
#. Speaker = Gimblebock
#. NodeID = 37c21d35-5635-d411-118a-cd1922064fc6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - CHA_Outside_BanditInteraction_SpeakerPersuadedBandits(4) = True
#.   Global:
#.     - CHA_OUTSIDE_Event_BanditScared = True
#.   Quest:
#.     - HIDDEN_WLD_Boosters.CHA_Chapel_BanditTalking(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_BanditBackInteraction_Spotted:37c21d35-5635-d411-118a-cd1922064fc6
msgctxt "h11e502a9gb17cg4824g926ag7f0271b749e7"
msgid "C-c'mon, you lot, let's get out of here!"
msgstr "가, 가자, 얘들아. 여기서 얼른 튀어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_BanditBackInteraction_Spotted
#. Speaker = Taman
#. NodeID = 47431c91-3a78-9f0f-e6ca-b12045abb376
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CHA_OUTSIDE_Event_TamanSpotsPlayer = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_BanditBackInteraction_Spotted:47431c91-3a78-9f0f-e6ca-b12045abb376
msgctxt "hc7334833gb229g49afga020gfc87faf4d899"
msgid "<i>Look out! </i>Someone's comin' from the crypt!"
msgstr "<i>조심해! </i>지하 묘실에서 누가 나오고 있어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_BanditBackInteraction_Spotted
#. Speaker = Gimblebock
#. NodeID = 4d4f7903-14e2-71c7-bae7-186f33a3b5b9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_BanditBackInteraction_Spotted:4d4f7903-14e2-71c7-bae7-186f33a3b5b9
msgctxt "h9ba594a7g8633g416dgbcbcg1cd002680c89"
msgid "What...? Get out of my head!"
msgstr "뭐야...? 내 머릿속에서 나가!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_BanditBackInteraction_Spotted
#. Speaker = Player
#. NodeID = 66341b58-fb9b-e625-fb61-15f547cba40e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 12
#. CheckFlags:
#.   Tag:
#.      - ASTARION(4) = False
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_BanditBackInteraction_Spotted:66341b58-fb9b-e625-fb61-15f547cba40e
msgctxt "h61a02160g8a2cg4b9cga643ge379169f0918"
msgid "You have awoken me from my slumber - now I crave your blood!"
msgstr "네놈들이 나를 깊은 잠에서 깨웠구나... 내 너희의 피를 마시겠다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_Outside_BanditBackInteraction_Spotted
#. Speaker = Gimblebock
#. NodeID = 6cd70d92-cb8b-9e09-e0cc-5bee381040af
#. HandlePath = TaggedText[0].TagText[0]
