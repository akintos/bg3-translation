msgctxt "h971d78e3g24b9g4a2aga5d3g5d58bb734dac"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03
