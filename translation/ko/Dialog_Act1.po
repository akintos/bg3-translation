#.      - REALLY_GITHYANKI(1) = True
#. SetFlags:
#.   Object:
#.     - CRE_General_State_VlaakithPortrait_HistoryCheckAttempted(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait:934ad652-a27d-5f54-3291-aedc7ab5166d
msgctxt "h7ed37ba5g7f16g4b4egaebag63888587408a"
msgid "<i>Inspect the symbol more closely.</i>"
msgstr "<i>문양을 좀 더 자세히 관찰한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait
#. Speaker = Narrator
#. NodeID = aa101c08-ce12-c3de-e006-1d9e478dd1a7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_General_State_SawOrpheusSymbolOnPortrait = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait:aa101c08-ce12-c3de-e006-1d9e478dd1a7
msgctxt "h2080fc97gf0c7g4ffag9568g15f57591ccc2"
msgid ""
"*You remember seeing this symbol in a book about the denizens of the Astral "
"Plane.*"
msgstr "*당신은 아스트랄 차원의 거주자들에 관한 책에서 본 문양임을 떠올립니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait
#. Speaker = Narrator
#. NodeID = b0199b43-8288-50c0-0cdb-ca63891c4fb8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait:b0199b43-8288-50c0-0cdb-ca63891c4fb8
msgctxt "h03c12c91g48fag4d77gb2f6g7b875927dd85"
msgid "*Perhaps you should leave, before someone notices.*"
msgstr "*누군가 눈치채기 전에 떠나야 할 것 같습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait
#. Speaker = Narrator
#. NodeID = b1375b7e-5a91-2637-705e-72a624671fd8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = True
#. SetFlags:
#.   Global:
#.     - CRE_General_State_VlaakithPortraitRuined = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait:b1375b7e-5a91-2637-705e-72a624671fd8
msgctxt "ha340b761g2662g4aceg8452ga5a65a59dd6a"
msgid ""
"*The prickle of transgression wrestles with your amusement at your own "
"handiwork.*"
msgstr "*당신의 손놀림에 대한 즐거움과 죄책감이 씨름하고 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait
#. Speaker = Lae'zel
#. NodeID = b19fd7a5-4376-400d-85f4-24cb7f6b673f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait:b19fd7a5-4376-400d-85f4-24cb7f6b673f
msgctxt "hbdd55d8ag9b3bg4d14gb792g80fe963a48ae"
msgid ""
"The sign of Orpheus? Blasphemy. Would I could quarter the vandal myself."
msgstr "오르페우스의 표식이라니? 신성모독이다. 내가 직접 이 훼손자를 쪼개버리고 싶군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait
#. Speaker = Lae'zel
#. NodeID = b5aeb3d2-b362-453d-b20f-f53dc1212ebe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait:b5aeb3d2-b362-453d-b20f-f53dc1212ebe
msgctxt "h82934a9age601g4f91g9ea8g2b8474456f70"
msgid ""
"<i>Kainyank! </i>I should take your head for such blasphemy. But I'll save "
"the pleasure for Vlaakith herself."
msgstr "<i>케인얀크! </i> 신성모독으로 네 목을 쳐야겠어. 하지만 그 기쁨은 블라키스께 돌리겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait
#. Speaker = Narrator
#. NodeID = be167de2-c177-bcce-4673-be2df1186f24
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait:be167de2-c177-bcce-4673-be2df1186f24
msgctxt "h520837e1gde64g4d3bgb408ge1995dff01e8"
msgid "*Her power and beauty are beyond words.*"
msgstr "*그 힘과 미모는 말로 표현할 수 없을 정도입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait
#. Speaker = Lae'zel
#. NodeID = c0c30cc3-6298-4c73-8539-9929ceec6c9d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait:c0c30cc3-6298-4c73-8539-9929ceec6c9d
msgctxt "hcd9b24dcg61fag4358g9f4bg043767f9e640"
msgid ""
"Vlaakith herself. She is both the sun that blinds us and the void that "
"contains us. Praise be."
msgstr "블라키스, 그 분이시다. 우릴 눈 멀게하는 태양이시자, 우릴 감싸는 공허이신 분. 영원하시길."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait
#. Speaker = Narrator
#. NodeID = c8afc4cc-7890-6c7e-2791-ec7586a31f61
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait:c8afc4cc-7890-6c7e-2791-ec7586a31f61
msgctxt "h6ebd76dbgbc6ag44e8ga74ege78c4a94061e"
msgid "*This githyanki looks different from the others you've seen here.*"
msgstr "*이 기스양키는 여기서 보았던 다른 이들과 확실히 달라 보입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_VlaakithPortrait
#. Speaker = Player
#. NodeID = d876ad43-f2de-119e-a42a-b12b70c9147f
#. HandlePath = TaggedText[0].TagText[0]
