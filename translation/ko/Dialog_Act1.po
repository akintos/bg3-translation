msgctxt "hfa76d102g9818g4740g8f17g7b8b5cd56e53"
msgid "Find... him..."
msgstr "그를... 찾고있었어..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_UnfortunateGnome_SlowDown
#. Speaker = Goblin Tracker
#. NodeID = 193f637f-9142-c22d-d48f-e8a5800bb3db
