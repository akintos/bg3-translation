#.     - UND_PetrifiedDrow_State_AskedWhatHappened(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_005:d6df3ca8-5328-ba31-e193-9f5b34edd71b
msgctxt "h8413e355gdc22g4663g83bag185db7d286a3"
msgid "What happened here?"
msgstr "여기서 무슨 일이 있었던 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_PetrifiedDrow_005
#. Speaker = Petrified Drow
#. NodeID = e133d338-9114-427d-ed28-dbcaef5c87f6
