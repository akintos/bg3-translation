msgctxt "h4c294f99gf780g4ac7g8fd4g8b3eb32cc3ef"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001_Dead
#. Speaker = Herdmaster Skarjall
#. NodeID = 28fe2f0e-79e1-42f8-8de0-49936ab785a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001_Dead:28fe2f0e-79e1-42f8-8de0-49936ab785a7
msgctxt "h39ee317eg0527g4bbbgb59ag0f0cbcf24bed"
msgid "Dunspeirrin... Orsraun Mountains..."
msgstr "둔스페이린... 올스라운 산맥..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001_Dead
#. Speaker = Player
#. NodeID = 43510cec-a7a7-4c08-ae5d-ae741c93d71c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001_Dead:43510cec-a7a7-4c08-ae5d-ae741c93d71c
msgctxt "hf7877e88gf879g4dd8g8de0g6d4704dd543a"
msgid "Where are you from?"
msgstr "어디서 왔지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001_Dead
#. Speaker = Player
#. NodeID = 8ccde819-41ce-4dbd-b96d-350bcfddbdaf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_FearfulRotheGuard001_Event_MentionedForge(1) = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001_Dead:8ccde819-41ce-4dbd-b96d-350bcfddbdaf
msgctxt "h2d9148bag0023g4682g8fb1gc5a2d5517aa4"
msgid "What is so special about the forge back there?"
msgstr "저 뒤에 있는 대장간은 뭐가 그렇게 특별한 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001_Dead
#. Speaker = Player
#. NodeID = 94b31ce0-79f9-4c46-8368-98c0b458a55b
