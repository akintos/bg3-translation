msgctxt "h47787baagc567g4a75gb365ged8f9dc55418"
msgid "Ngh!"
msgstr "윽!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_LeadersPrepareAfterAttack
#. Speaker = Asharak
#. NodeID = 0f2e237e-9a07-d2b5-0e6f-57ce06647aa8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_DruidAttack_State_PostAttackAtBooks(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_LeadersPrepareAfterAttack:0f2e237e-9a07-d2b5-0e6f-57ce06647aa8
msgctxt "h2be20871gb1a0g4afagad91gf39ce44adec3"
msgid "Are we really doing this?"
msgstr "진짜로 합니까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_LeadersPrepareAfterAttack
#. Speaker = Zevlor
#. NodeID = 4bba43d9-25d3-1170-22a0-e6107968896f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_LeadersPrepareAfterAttack:4bba43d9-25d3-1170-22a0-e6107968896f
msgctxt "h00e6ce9bg1074g45e1g9280g3efe721038c7"
msgid ""
"We had the druids to worry us before. Not anymore. We can <i>defend </i>this "
"place."
msgstr "전에는 드루이드들이 걱정이었지만, 이젠 아니네. 우리가 여길 <i>지킬 수 </i>있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_LeadersPrepareAfterAttack
#. Speaker = Asharak
#. NodeID = 6bdf969f-dd42-0a2e-a332-8f1e7f55caa3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_LeadersPrepareAfterAttack:6bdf969f-dd42-0a2e-a332-8f1e7f55caa3
msgctxt "h01b958c9g503eg4102ga316g4d53bacc422c"
msgid "Aye."
msgstr "네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_LeadersPrepareAfterAttack
#. Speaker = Zevlor
#. NodeID = 94f16e63-5dd8-0db7-d1c2-67e9972f57ca
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 5246d527-6613-1c27-b5d2-2fd24ce57f0f_B = True
#. SetFlags:
#.   Local:
#.     - 5246d527-6613-1c27-b5d2-2fd24ce57f0f_B = False
#.     - 5246d527-6613-1c27-b5d2-2fd24ce57f0f_A = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_LeadersPrepareAfterAttack:94f16e63-5dd8-0db7-d1c2-67e9972f57ca
msgctxt "hf0354e74g93bfg4006gb904gadab9576d87f"
msgid "Look down there. Plenty of space for traps."
msgstr "아래를 보게. 함정을 설치할 공간이 충분히 있네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_LeadersPrepareAfterAttack
#. Speaker = Asharak
#. NodeID = d9d3266b-c458-1cc1-059a-35ed07f66390
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_LeadersPrepareAfterAttack:d9d3266b-c458-1cc1-059a-35ed07f66390
msgctxt "h7b274db1g8963g4d1eg8edagca40253de8c2"
msgid "That'd sort them right out. I'll put someone on it."
msgstr "저 공간이라면 되겠군요. 누군가를 투입 시키겠습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_LeadersPrepareAfterAttack
#. Speaker = Asharak
#. NodeID = df183d73-4168-2f77-383b-46b90193e1c5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_LeadersPrepareAfterAttack:df183d73-4168-2f77-383b-46b90193e1c5
msgctxt "h4ff76771gd9aag4e6agbc1fg080826c44394"
msgid "Not sure if we've got any. I'll find out."
msgstr "갖고 있는 게 있을지 모르겠군요. 찾아보겠습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_LeadersPrepareAfterAttack
#. Speaker = Zevlor
#. NodeID = e098086d-96e8-96c9-34d3-5d501481dd92
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 5246d527-6613-1c27-b5d2-2fd24ce57f0f_A = True
#. SetFlags:
#.   Local:
#.     - 5246d527-6613-1c27-b5d2-2fd24ce57f0f_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_LeadersPrepareAfterAttack:e098086d-96e8-96c9-34d3-5d501481dd92
msgctxt "hc7d2cf97g8822g4f47g95d6gcd8a6e9e4d70"
msgid "We should load up on oil. Bring it down on the goblins when they come."
msgstr "기름을 채워야 하네. 고블린 놈들이 왔을 때 부어버려야 하니까 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_LeadersPrepareAfterAttack
#. Speaker = Zevlor
#. NodeID = f3b82007-6b9e-596e-7036-4a0d7efd2178
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 5246d527-6613-1c27-b5d2-2fd24ce57f0f_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_LeadersPrepareAfterAttack:f3b82007-6b9e-596e-7036-4a0d7efd2178
msgctxt "hf24909e8gee2bg40ffgb97dg4cf987621496"
msgid ""
"Lady down some barricades. We already have the high ground - best to make "
"use of it."
msgstr "방책을 설치하게. 우리가 고지를 장악하고 있으니, 이 점을 이용해야겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_LoversPackingAfterAttack
#. Speaker = Danis
#. NodeID = 47d322ee-5c4e-5397-2a87-71e792114736
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 7788fd55-b395-9ba9-b8b5-a598bf0640fe_C = True
#. SetFlags:
#.   Local:
#.     - 7788fd55-b395-9ba9-b8b5-a598bf0640fe_C = False
#.     - 7788fd55-b395-9ba9-b8b5-a598bf0640fe_B = False
#.     - 7788fd55-b395-9ba9-b8b5-a598bf0640fe_A = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_LoversPackingAfterAttack:47d322ee-5c4e-5397-2a87-71e792114736
msgctxt "h44471e8ag4386g427dg9d84g92796f0a1c8a"
msgid "Goblins might not even come. Right?"
msgstr "어쩌면 고블린이 아예 안 올 수도 있지. 안 그래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_LoversPackingAfterAttack
#. Speaker = Danis
#. NodeID = 8b473127-f097-e211-10e8-59263a414c5e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 7788fd55-b395-9ba9-b8b5-a598bf0640fe_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_LoversPackingAfterAttack:8b473127-f097-e211-10e8-59263a414c5e
msgctxt "h6e2b41a6gb5c4g4423gadc2gdc575d71d9ff"
msgid "Keep up the pace, Bex. Baldur's Gate won't wait forever."
msgstr "얼른 채비해, 벡스. 이러다 발더스 게이트에 영영 닿지 못하겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_LoversPackingAfterAttack
#. Speaker = Bex
#. NodeID = 92e09fac-fb19-15fd-52e9-7fa775a2fae0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_LoversPackingAfterAttack:92e09fac-fb19-15fd-52e9-7fa775a2fae0
msgctxt "hb9230bb1g5cd7g4c50g8189g3920c6eecc79"
msgid "You're no fighter. And I need you <i>here.</i>"
msgstr "넌 전사가 아니잖아. 나랑 <i>여기</i> 있어줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_LoversPackingAfterAttack
#. Speaker = Bex
#. NodeID = 9c6053de-6489-4983-1410-819cf2fb683b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_LoversPackingAfterAttack:9c6053de-6489-4983-1410-819cf2fb683b
msgctxt "hb1a42c43gb4ecg4741gb145gb578fdf164da"
msgid "Won't it?"
msgstr "그런가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_LoversPackingAfterAttack
#. Speaker = Bex
#. NodeID = a4e865c8-4201-ceda-0dc2-0ed35435d6fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_LoversPackingAfterAttack:a4e865c8-4201-ceda-0dc2-0ed35435d6fe
msgctxt "hf92862d8g716cg4d59g94c0gbf7a334ce3f8"
msgid "Right."
msgstr "맞아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_LoversPackingAfterAttack
#. Speaker = Danis
#. NodeID = b9100711-2ed2-d1bf-9bd2-e791bfec1917
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 7788fd55-b395-9ba9-b8b5-a598bf0640fe_B = True
#. SetFlags:
#.   Local:
#.     - 7788fd55-b395-9ba9-b8b5-a598bf0640fe_C = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_LoversPackingAfterAttack:b9100711-2ed2-d1bf-9bd2-e791bfec1917
msgctxt "h54fc056eg1e4fg4feag9f34g596deeecd3b5"
msgid "Maybe should I go help defend the wall."
msgstr "나도 성벽 수비를 도우러 가야 할까 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_LoversPackingAfterAttack
#. Speaker = Bex
#. NodeID = e519a6ae-5f40-897d-2a87-85d0e1d83267
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 7788fd55-b395-9ba9-b8b5-a598bf0640fe_A = True
#. SetFlags:
#.   Local:
#.     - 7788fd55-b395-9ba9-b8b5-a598bf0640fe_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_LoversPackingAfterAttack:e519a6ae-5f40-897d-2a87-85d0e1d83267
msgctxt "h9b906c2bg06a8g4f2egbcbcgc1a963637335"
msgid "When did Zevlor say we're leaving?"
msgstr "제블로어가 여기 언제 뜬다고 그랬더라?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_LoversPackingAfterAttack
#. Speaker = Danis
#. NodeID = fb2a751b-b4ad-15be-00fa-480fffab604e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_LoversPackingAfterAttack:fb2a751b-b4ad-15be-00fa-480fffab604e
msgctxt "h25b1951cg38efg4907gaa46geb43d1855365"
msgid "He didn't, love. It still isn't safe. Goblins, you know."
msgstr "그런 말 안 했어, 자기야. 아직 안전하지 않잖아. 고블린들 때문에."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ParentA
#. Speaker = Locke
#. NodeID = 2667a974-2ff6-9470-db4a-35adfebbbd24
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 7ffcf0de-e30b-ef58-fcc5-8d3a1482fa59_b = False
#.      - 7ffcf0de-e30b-ef58-fcc5-8d3a1482fa59_a = True
#. SetFlags:
#.   Local:
#.     - 7ffcf0de-e30b-ef58-fcc5-8d3a1482fa59_b = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ParentA:2667a974-2ff6-9470-db4a-35adfebbbd24
msgctxt "h9f55b192g75bdg44c4g97d4ga49df9c3331e"
msgid "Keep quiet."
msgstr "조용히 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_ParentA
#. Speaker = Locke
#. NodeID = 4ed2c4af-bd86-3f91-1db4-b6fb6b2b7318
#. HandlePath = TaggedText[0].TagText[0]
