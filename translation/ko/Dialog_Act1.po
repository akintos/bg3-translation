msgctxt "h13bf5682g33f1g4052g9de7g01715b627cea"
msgid "<i>Meat! </i>Want it! Tear it off your bones!"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeWorg2
#. Speaker = Worg
#. NodeID = dd04ca70-29d1-2a9c-a005-4be26462144f
