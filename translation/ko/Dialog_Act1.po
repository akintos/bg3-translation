#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinGlib:8a31daec-deb2-2df1-555e-8f8550be59c8
msgctxt "hb9a1a9adgbc68g4cb9g96cag85d597bdac9e"
msgid "Good to see you again."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinGlib
#. Speaker = Devout Mrak
#. NodeID = 93a1b9c1-c3a7-f8f6-ddfa-c414548fad4b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_GoblinGlib_HasMet(1) = True
#.   Tag:
#.      - BRANDED(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinGlib:93a1b9c1-c3a7-f8f6-ddfa-c414548fad4b
msgctxt "he55d6af6g076cg4b13gba41g3b6a6df13d31"
msgid "You still 'ere?"
msgstr "아쥑도 여기 있냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinGlib
#. Speaker = Devout Mrak
#. NodeID = a522f041-c037-771b-524e-6daac9b8e0dc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_GoblinGlib_HasMet(1) = False
#.   Tag:
#.      - BRANDED(1) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_GoblinGlib_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinGlib:a522f041-c037-771b-524e-6daac9b8e0dc
msgctxt "h57966be6g3544g44feg89dcg16622aa56884"
msgid ""
"You 'ere to get branded too? Priestess reckons we should be marked up before "
"the next raid."
msgstr "너도 낙인 받으러 왔어? 여사제님은 다음 습격 전에 우리에게 표식을 새겨야 한다고 했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Brakkal
#. NodeID = 00c7d678-8d69-5f3f-5f93-9bbaabca16ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:00c7d678-8d69-5f3f-5f93-9bbaabca16ac
msgctxt "h872b3615gd105g493aga29cgc880e5d01af9"
msgid ""
"They like feastin', fightin', and fornicatin'. Who doesn't? Absolute gives "
"'em that."
msgstr "녀석들은 먹고, 싸우고, 오입질 하는 걸 좋아해. 누군들 안 그럴까? 절대자는 그들에게 그걸 선사해 주거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Brakkal
#. NodeID = 01c12c3d-fddc-548c-86ac-1a395f19bc91
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:01c12c3d-fddc-548c-86ac-1a395f19bc91
msgctxt "hd7849b76g245fg4b44g949fg272d251fdb9d"
msgid ""
"Cuz I'm loyal to Maglubiyet! Cuz I ain't havin' my 'ed turned by some "
"upstart god!"
msgstr "그야, 나는 마글루비예트님에게 충성하기 때문이지! 나만큼은 갓난이 신흥 신에게 흔들리지 않기 때문이야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Brakkal
#. NodeID = 13e9de56-5afb-910b-3de9-512ed6f9a780
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:13e9de56-5afb-910b-3de9-512ed6f9a780
msgctxt "h4635355dga828g49f7g8302g17834347c3c7"
msgid "Yeah. My whole tribe's fallen for this shite. Traitorous bastards."
msgstr "그래. 내 부족 전체가 그 계집에게 넘어갔어. 배신자 새끼들."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Brakkal
#. NodeID = 1826336a-c7e5-265c-9862-ad44ed2b57ac
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Absolute_Knows_GoblinsWorship = True
#.     - GOB_GoblinHeretic_Event_LearnedMaglubiyet = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:1826336a-c7e5-265c-9862-ad44ed2b57ac
msgctxt "h16947ab4g2220g4ed8g91ddg821f80c3281f"
msgid "So bollocks to you and bollocks to Her an' all."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Player
#. NodeID = 1c00cb54-aa02-979d-a7cb-b6a63a77ebc3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - LOLTHDROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:1c00cb54-aa02-979d-a7cb-b6a63a77ebc3
msgctxt "hdaed4f53g1740g4b34ga386ga0418cd5606e"
msgid "My goddess <i>is </i>real. I follow Lolth, the Spider Queen."
msgstr "내 여신님은 <i>진짜야</i>. 난 거미 여왕, 롤쓰님을 따른다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Brakkal
#. NodeID = 2e84acfa-2767-8525-1767-1be22c77f47a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:2e84acfa-2767-8525-1767-1be22c77f47a
msgctxt "h7dbd1ab2g6898g4e7cga6dbgfb9c29a411e1"
msgid ""
"Good on ya - don't matter to me if it's Shar, Gond, or my boy Maglubiyet; "
"it's about <i>tradition</i>."
msgstr ""
"그래, 좋겠네. 난 샤든, 곤드든, 그리고 내가 따르는 마글루비예트님이든 그게 중요한 게 아니야; 중요한 건 <i>전통</i>이라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Brakkal
#. NodeID = 35136839-354a-e470-3507-62df0c3b663f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:35136839-354a-e470-3507-62df0c3b663f
msgctxt "h87e0ac10g2cc6g4d73g8f88ga2c94964ca63"
msgid ""
"They've all gone barmy - 'ad their 'eds turned from the old ways by some "
"upstart god!"
msgstr "다들 정신이 나가버렸어. 새로운 신이니 뭐니 하는 것을 따른다고 옛 방식에 등을 돌리다니!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Brakkal
#. NodeID = 387a5ba4-ec0e-cc40-4252-613eac1a87b5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:387a5ba4-ec0e-cc40-4252-613eac1a87b5
msgctxt "h8e77b127g55feg4446g971egdb269023e2bc"
msgid "If you 'ad 'alf a brain, you wouldn't be muckin' around in 'ere at all."
msgstr "네놈에게 뇌가 절반이라도 있었다면, 애초에 여길 들쑤시고 다니지도 않았겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Brakkal
#. NodeID = 3c1e5d27-e5ef-22ed-3cf9-be2c714e944e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:3c1e5d27-e5ef-22ed-3cf9-be2c714e944e
msgctxt "h9cfb70b2g94d7g4ff7gab3fg6b585209ecd7"
msgid ""
"They'll turn on you soon enuff... then you'll be <i>wishin'</i> you woz in a "
"cage."
msgstr "머지않아 놈들은 널 공격할 거야... 그때가 오면 이 우리에 갇혀 있는 편이 <i>나았다고</i> 생각하게 될걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Player
#. NodeID = 3cabaa3c-d19d-44a0-afee-84901a626dcb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:3cabaa3c-d19d-44a0-afee-84901a626dcb
msgctxt "h3c6f7481gcd16g4fc8gb89bg0f0c5961f61e"
msgid "The Absolute? The other goblins seem to love Her."
msgstr "절대자 말인가? 다른 고블린들은 그녀를 사랑하는 것 같던데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Brakkal
#. NodeID = 3feaf2af-8155-fb9f-3a27-7b38b2b372f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:3feaf2af-8155-fb9f-3a27-7b38b2b372f4
msgctxt "h36a5b30fg820fg499dg891bg6d21f7f0c202"
msgid ""
"Maybe your people can build a nice little necropolis on the carcass of this "
"Absolute joker."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Narrator
#. NodeID = 4124ecba-7d4e-ecf1-f7fa-05bb71c49b47
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_GoblinHeretic_Event_LearnedMaglubiyet = True
#.   Local:
#.     - f17fa77a-8672-bccd-1d88-bda4a00b1e5f_GOB_GoblinHeretic_Recognised_Maglubiyet = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:4124ecba-7d4e-ecf1-f7fa-05bb71c49b47
msgctxt "h7bb9274fg49e0g4787g9070g065d4928a59b"
msgid ""
"*You know Maglubiyet - a tyrannical deity who treats his goblinoid followers "
"as slaves.*"
msgstr "*당신은 마글루비예트를 알고 있습니다. 그의 고블린 신도들을 노예처럼 대하는 폭군 신입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Brakkal
#. NodeID = 465d7461-df32-25b2-7318-339311b8d679
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Absolute_Knows_GoblinsWorship = True
#.     - GOB_GoblinHeretic_Event_LearnedMaglubiyet = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:465d7461-df32-25b2-7318-339311b8d679
msgctxt "hf7aa6f13g3cbeg4072g8fc1g7491c6390e98"
msgid ""
"Gotta know yer place in the world though. Maglubiyet kept us in line. Tha's "
"wot a god's s'posed to do."
msgstr "하지만 자기 위치 정도는 알아야지. 마글루비에트 님께서 우릴 인도하셨어. 진정한 신이라면 해야 하는 일이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Brakkal
#. NodeID = 4acfeff9-8ab5-8806-0efb-16bbece5ab41
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_GoblinHeretic_SawBrand(1) = True
#.   Global:
#.     - GLO_Absolute_Knows_GoblinsWorship = True
#.     - GOB_GoblinHeretic_Event_LearnedMaglubiyet = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:4acfeff9-8ab5-8806-0efb-16bbece5ab41
msgctxt "h0961bcecga317g445cg8484ga26a2af72d61"
msgid "Bollocks to yer Absolute and bollocks to you an' all."
msgstr "너의 절대자는 꺼지라 그래. 너희도 모두 꺼져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Brakkal
#. NodeID = 4b7c97c6-c286-5bb6-237e-12205a229ab3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:4b7c97c6-c286-5bb6-237e-12205a229ab3
msgctxt "hc74475b2ge4b9g4831gb60bg758d94d08f0b"
msgid "I hope they <i>throttle</i> you with yer beard. Now piss off!"
msgstr "녀석들이 널 네 수염으로 <i>목 졸라 죽여 버렸으면</i> 좋겠군. 이제 꺼져!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Player
#. NodeID = 4e9c1f74-b715-d903-b120-677df739716f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:4e9c1f74-b715-d903-b120-677df739716f
msgctxt "h8b330855ge365g47b8g8592ga426fda68a9c"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Player
#. NodeID = 52c9c263-eaf6-4220-fc3b-75c0899e50c6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BRANDED(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:52c9c263-eaf6-4220-fc3b-75c0899e50c6
msgctxt "h15158814g06f6g4d76gb259gf92900897880"
msgid "<i>Reveal your brand with a smile.</i>"
msgstr "<i>미소를 보이며 낙인을 보여준다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Player
#. NodeID = 5e2d87bb-58db-8a89-c563-59688452ad56
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:5e2d87bb-58db-8a89-c563-59688452ad56
msgctxt "hf089a119g1c79g415fg842dg061c90561d13"
msgid "Gormless? I'm not the one behind bars."
msgstr "머저리라고? 우리 뒤에 갇힌 건 내가 아닌데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Brakkal
#. NodeID = 65d54682-8aab-0939-5abe-60f460a8e104
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BRANDED(1) = True
#. SetFlags:
#.   Dialog:
#.     - GOB_GoblinHeretic_SawBrand(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:65d54682-8aab-0939-5abe-60f460a8e104
msgctxt "h6106e3bag6464g4978g86ebg509571f3b37f"
msgid ""
"Yeah. And I can see by that mark on yer 'and that you're part of Her mob."
msgstr "그래. 그리고 네놈에게 있는 표식을 보아하니 너도 그녀를 따르는 놈인 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Brakkal
#. NodeID = 692902ab-aef3-aac3-c3e9-28b338f55d39
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Absolute_Knows_GoblinsWorship = True
#.     - GOB_GoblinHeretic_Event_LearnedMaglubiyet = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:692902ab-aef3-aac3-c3e9-28b338f55d39
msgctxt "h2667fcaaga0d5g4656g8332gdb1e9805c72e"
msgid ""
"<i>The great Absolute brings us together. Drow and gnolls and goblins, all "
"braidin' one another's hair.</i>"
msgstr "<i>그 대단하신 절대자가 우릴 하나로 모았어. 드로우, 놀, 고블린이 모두 서로의 머리카락을 땋아주고 있지.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Brakkal
#. NodeID = 77dc24e6-09ce-52ba-b22d-965e1ae93eb4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:77dc24e6-09ce-52ba-b22d-965e1ae93eb4
msgctxt "hc4ddde84g1cebg4f2fga3b7g970703a73a6f"
msgid ""
"But sod 'em all. I'll wait it out in 'ere, prayin' to a <i>real</i> god."
msgstr "하지만 모두 꺼지라 그래. 난 여기서 <i>진짜</i> 신에게 기도하면서 이를 기다릴 거니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Player
#. NodeID = 8871dc05-742e-9d13-4633-5fe91b03d898
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:8871dc05-742e-9d13-4633-5fe91b03d898
msgctxt "h60ce447cg1196g4414g87c1g8244ed370fe4"
msgid "Gods are fickle. Maglubiyet doesn't give a damn about you."
msgstr "신은 변덕스럽지. 마글루비예트는 너를 전혀 신경 쓰지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Brakkal
#. NodeID = 8f3636c4-f55c-9f49-99d4-07d8e3049e5a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_GoblinHeretic_ToldCause(1) = True
#.   Global:
#.     - GOB_GoblinHeretic_Event_LearnedMaglubiyet = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:8f3636c4-f55c-9f49-99d4-07d8e3049e5a
msgctxt "h7367eecdg7189g4fb9gb6b5g4e64436d4190"
msgid "Maglubiyet's looked out for me since I was knee-high to a worg-pup."
msgstr "마글루비예트님은 내가 새끼 워그만했을 때부터 나를 보살펴주셨어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Brakkal
#. NodeID = a25e9e6f-c2d1-a539-3534-d6bf81f395a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:a25e9e6f-c2d1-a539-3534-d6bf81f395a8
msgctxt "h62fde38eg05d8g4859g8730g710546d0f5f6"
msgid ""
"Oh, that's rich! A free world? Then how come I'm locked up like a bloody "
"elf? I'll tell ya why..."
msgstr "오, 그거 참 재미있군! 자유로운 세상? 근데 난 왜 망할 엘프처럼 갇혀 있는 거지? 내가 이유를 말해 주지..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Player
#. NodeID = a7c8718b-4209-da51-4153-6b3eeedd0908
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PLANAR(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:a7c8718b-4209-da51-4153-6b3eeedd0908
msgctxt "h88c40d00g2f62g4760ga9c8g76f40b159778"
msgid "I find <i>all</i> of Faerûn's gods rather tiresome."
msgstr "난 개인적으로 페이룬의 <i>모든</i> 신이 꽤 성가시다고 생각해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Player
#. NodeID = ac444aad-802f-c54d-13d7-24db0af2ee35
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:ac444aad-802f-c54d-13d7-24db0af2ee35
msgctxt "h7bf0542eg877bg4a92gac98g2118186762dd"
msgid ""
"My people build cities on the corpses of gods. Yours does not impress me."
msgstr "내 사람들은 신들의 시체 위에 도시들을 세웠다. 네놈의 것은 딱히 인상적이지 않은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Brakkal
#. NodeID = ad34c24b-77ed-eed2-1567-2c01b3c2878f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:ad34c24b-77ed-eed2-1567-2c01b3c2878f
msgctxt "h7176c248gfa61g4104ga594gd2fcdf7758ac"
msgid ""
"Are you soft in the 'ed? Every bleeder in 'ere is gabbin' on about it. "
"Traitorous bastards."
msgstr "머릿속이 텅 비기라도 한 거냐? 여기 있는 모두가 그 이야기만 하고 있잖아. 배신자 새끼들."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Brakkal
#. NodeID = af770e43-8319-30e9-0ec6-5465e1de8c14
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:af770e43-8319-30e9-0ec6-5465e1de8c14
msgctxt "headf0446g3cfbg41d2g8dbdgd30db6a4205c"
msgid ""
"Could tell you were as barmy as the rest of 'em as soon as I clapped eyes on "
"ya."
msgstr "네 눈빛만 봐도 너도 다른 이들만큼이나 제정신이 아니라는 건 알 수 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Brakkal
#. NodeID = afd49998-e859-1665-9137-a2a5bca0887b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:afd49998-e859-1665-9137-a2a5bca0887b
msgctxt "h39845765g7b19g47dfga081g8bca2f488344"
msgid ""
"You think this is funny? I'll be the one laughin' when things turn ugly. "
"Safer in 'ere than out there."
msgstr "이게 재밌다고 생각하나? 상황이 나빠지면 웃는 건 내가 될 거야. 밖에 있는 것보단 이 안이 안전하다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Brakkal
#. NodeID = b1069177-4b6e-f45d-e39a-9b7069990a67
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BRANDED(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:b1069177-4b6e-f45d-e39a-9b7069990a67
msgctxt "h78baa546g1e6ag48d0gac43g53300c7db467"
msgid ""
"Yeah. And I can see by that mark on yer hand that you're part of Her mob."
msgstr "그래. 그리고 네놈 손에 있는 표식을 보니 너도 그녀를 따르는 놈인 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Player
#. NodeID = b90c7d97-02bb-ef26-2ac5-9124b0a5ef31
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:b90c7d97-02bb-ef26-2ac5-9124b0a5ef31
msgctxt "h1395ab61g406ag4500ga659g3d8c9090338a"
msgid "You don't like your people mixing with outsiders?"
msgstr "너의 동족이 외부인들과 어울리는 것에 마음에 안 드나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Brakkal
#. NodeID = bb6fac2c-cce2-2dd7-bbe1-2bb9c99f537f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:bb6fac2c-cce2-2dd7-bbe1-2bb9c99f537f
msgctxt "h46776022gcf16g414dg973cg496c15affb04"
msgid "My whole tribe's fallen for this shite. Traitorous bastards."
msgstr "내 부족 전체가 그 계집에게 넘어갔어. 배신자 새끼들."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Player
#. NodeID = bbd1e0d3-eb2d-bbd2-e224-629f7f93225a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:bbd1e0d3-eb2d-bbd2-e224-629f7f93225a
msgctxt "h4d3045d1g9256g4af0g8025g0becb9c67dd5"
msgid "And why did they turn on you?"
msgstr "그럼, 그들은 왜 네게 등을 돌린 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Brakkal
#. NodeID = bf547c49-1734-aa8c-2707-0996869685ab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:bf547c49-1734-aa8c-2707-0996869685ab
msgctxt "h9d39ea70g15b7g4546gaa4egcbecb8070e74"
msgid "It's a load of shite!"
msgstr "이런 똥덩어리가 어딨어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Brakkal
#. NodeID = c197d250-e42a-9464-921f-7e2258291e8b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Absolute_Knows_GoblinsWorship = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:c197d250-e42a-9464-921f-7e2258291e8b
msgctxt "h73c77113g5c4eg4b2fga854g6e1ea6753d06"
msgid "Bollocks to this Absolute, I say. And bollocks to you an' all."
msgstr "그 절대자는 꺼지라 그래. 너희도 모두 꺼져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Player
#. NodeID = c1f64315-643e-8806-5c1c-36bbdfca98fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:c1f64315-643e-8806-5c1c-36bbdfca98fc
msgctxt "h6e319b43g7573g4003ga045g4503855256c8"
msgid "Spiders and worgs are nothing. I can handle myself."
msgstr "거미와 워그는 아무것도 아니야. 그 정도는 감당할 수 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Player
#. NodeID = c3a1d6ac-e9c9-bf17-fac4-e4ee7d01da56
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:c3a1d6ac-e9c9-bf17-fac4-e4ee7d01da56
msgctxt "h25e8501ag4fb6g44d1gb1b3g9e6758069bf6"
msgid "<i>My</i> god is very real."
msgstr "<i>내</i> 신은 진짜야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Brakkal
#. NodeID = c4b87414-a518-3e53-b245-e5c3a85e3368
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:c4b87414-a518-3e53-b245-e5c3a85e3368
msgctxt "h6b1fa637g85bdg46abg8d05g7536c02ac584"
msgid ""
"Talkin' to you ain't I? I just don't believe in all this togetherness an' "
"chumminess. Ain't natural."
msgstr "나도 너와 얘기하고 있지 않나? 그냥 이 함께함과 친근함 같은 게 싫어. 자연스럽지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Player
#. NodeID = c6737adc-01e9-3ebc-f9c2-730a85c55d62
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Absolute_Knows_GoblinsWorship = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:c6737adc-01e9-3ebc-f9c2-730a85c55d62
msgctxt "h8f9924b2g3c67g4221gba9dgdd04c82ae803"
msgid "I assume you mean the Absolute?"
msgstr "절대자를 말하는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Player
#. NodeID = c832647c-8d0d-04b6-c19e-c6a394783f19
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Absolute_Knows_GoblinsWorship = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:c832647c-8d0d-04b6-c19e-c6a394783f19
msgctxt "hd0b13fadg08ceg442ag8800g832ad3c93095"
msgid "And who is this 'upstart god'?"
msgstr "이 '신흥 신'이라는 게 누군데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Brakkal
#. NodeID = c997fb8b-a174-b7f4-346e-27200102b25d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:c997fb8b-a174-b7f4-346e-27200102b25d
msgctxt "h382a5fe4g2c25g49edga51cg2f29bcf01cc6"
msgid "You'll end up bein' supper for the spiders or the worgs."
msgstr "네놈은 결국 거미나 워그의 저녁 거리로 전락할 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Brakkal
#. NodeID = cd9049cd-40e1-4717-7843-8c875735e139
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:cd9049cd-40e1-4717-7843-8c875735e139
msgctxt "h1c6d4fc1g871ag4361g9679gf59351d26bde"
msgid ""
"Tryin' to interrupt my prayers? Scared of a <i>real</i> god? You're as "
"gormless as the rest of 'em."
msgstr "내 기도를 방해하려는 거냐? <i>진짜</i> 신이 두려워서? 너도 나머지 놈들과 마찬가지로 머저리군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Narrator
#. NodeID = d0424999-347c-0b6d-7d16-3b05dde218b8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - f17fa77a-8672-bccd-1d88-bda4a00b1e5f_GOB_GoblinHeretic_Recognised_Maglubiyet = True
#. TagRule: CLERIC_EVIL or PALADIN_EVIL
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:d0424999-347c-0b6d-7d16-3b05dde218b8
msgctxt "h741cd08egcb53g4b58gb346g2dcdd4db2e3c"
msgid ""
"*You know Maglubiyet - deity of the goblinoids, hungry for blood and "
"conquest.*"
msgstr "*당신은 마글루비예트를 알고 있습니다. 피와 정복에 굶주린, 고블린 종족의 신입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Player
#. NodeID = d683acd3-d005-37df-8547-da76db4e16e7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:d683acd3-d005-37df-8547-da76db4e16e7
msgctxt "h7f646666gee7eg4824gaf97gdb606e123578"
msgid "I'd gladly let a goblin braid my beard."
msgstr "난 기꺼이 고블린이 내 수염을 땋도록 허락하겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Brakkal
#. NodeID = d944507a-b383-6737-9f20-f93e53c4e363
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:d944507a-b383-6737-9f20-f93e53c4e363
msgctxt "h75aadf63g37e4g4941gac5agc0ce0424e381"
msgid "It won't last. They'll be tearin' into each other soon enough."
msgstr "이런 게 오래 가진 않을 것이다. 저들은 곧 서로를 찢어 죽일 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Brakkal
#. NodeID = dc04f4a1-13cb-3af0-b4e3-47f7bc15ce99
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:dc04f4a1-13cb-3af0-b4e3-47f7bc15ce99
msgctxt "hb194bbb3gddecg49fdgb945g25c9223d2ec9"
msgid ""
"This upstart everyone's praisin' is gonna trample all over our gods and our "
"faith... makes me sick."
msgstr "모두가 섬기기 시작한 이 신흥 신이 우리 신과 믿음을 짓밟아 버릴 거다... 생각만 해도 역겹군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Brakkal
#. NodeID = e88268e6-312b-3287-279a-37fea1b3100b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:e88268e6-312b-3287-279a-37fea1b3100b
msgctxt "hadfd8b10gc726g4e7fg89e0g874a0504637f"
msgid ""
"Good on ya - don't matter to me if it's Lolth or my boy Maglubiyet; it's "
"about <i>tradition</i>."
msgstr "그래, 좋겠군. 내겐 그게 롤쓰든, 마글루비예트든, 그런 것이 중요한 게 아니다; 내게 중요한 건 <i>전통</i>이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Player
#. NodeID = ebf70527-3ffc-70a7-e67e-38b56554f360
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:ebf70527-3ffc-70a7-e67e-38b56554f360
msgctxt "h275e3252gbb52g4209g9f3fg2cfc558c4c35"
msgid "Pray to whoever you want. It's a free world."
msgstr "네가 원하는 대상에게 기도해. 자유로운 세상이니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Player
#. NodeID = ef49d6f9-f767-7add-f722-348e64a29183
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - f17fa77a-8672-bccd-1d88-bda4a00b1e5f_GOB_GoblinHeretic_Recognised_Maglubiyet = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:ef49d6f9-f767-7add-f722-348e64a29183
msgctxt "h8c7e4292g3e09g46a0gb611g317cf648d6b3"
msgid "Maglubiyet's a tyrant. Your people are better off without him."
msgstr "마글루비예트는 폭군이야. 너희 종족은 그 없이 더 잘 살 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Brakkal
#. NodeID = fbe23aba-7ba3-be6c-186f-1164a3855a2d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_GoblinHeretic_HasMet(1) = False
#.   Object:
#.      - GOB_GoblinHeretic_InPrison(0) = True
#. SetFlags:
#.   Dialog:
#.     - GOB_GoblinHeretic_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:fbe23aba-7ba3-be6c-186f-1164a3855a2d
msgctxt "h24fd34adgaf8cg4e6bgb37cgdbfb78dee5de"
msgid ""
"Praise his ever-bleedin' axe, praise his throne of flamin' iron. Praise "
"Maglubiyet!"
msgstr "그분의 영원히 피 흘리는 도끼를 찬양하라, 그분의 불타는 왕좌를 찬양하라. 마글루비에트 님을 찬양하라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Player
#. NodeID = fc8b18f3-b65e-1650-81a9-14d33c5417ce
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_GoblinHeretic_ToldCause(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:fc8b18f3-b65e-1650-81a9-14d33c5417ce
msgctxt "hcd405609g5e37g4357g9e1dg04eabb553bd0"
msgid "How'd you land yourself in that cage?"
msgstr "어쩌다 그 우리에 들어가게 된 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic
#. Speaker = Player
#. NodeID = ffcf15c0-b863-15d7-ddb2-d1dc8a40118a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic:ffcf15c0-b863-15d7-ddb2-d1dc8a40118a
msgctxt "hc3e7e560gaf89g4feagaaa1g4942a1405c1d"
msgid "Seems to be working out pretty well for them, actually."
msgstr "사실은, 그들에게 꽤 잘 맞는 것 같던데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic_Saved
#. Speaker = Brakkal
#. NodeID = 6f9dfa20-1bb4-44c9-a863-b60c9d2c6f1a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_GoblinHeretic_FreeToGo(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic_Saved:6f9dfa20-1bb4-44c9-a863-b60c9d2c6f1a
msgctxt "hf310a807g0110g490eg82ceg659faed3ede3"
msgid "Ha! Look at where the Absolute's love got 'em. <i>Dead!</i>"
msgstr "하! 절대자의 사랑이 놈들을 어디로 이끌었는지 보라고. <i>죽음이지!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic_Saved
#. Speaker = Brakkal
#. NodeID = ba669391-7a6d-40bd-ac2a-d2a97da1c6bd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinHeretic_Saved:ba669391-7a6d-40bd-ac2a-d2a97da1c6bd
msgctxt "h80f2ea68g8205g4f08g8a23ga2f22e38ad36"
msgid ""
"Thanks for breakin' me out. Gonna find me a new tribe. One that appreciates "
"the old ways."
msgstr "날 꺼내줘서 고마워. 새로운 부족을 찾아야겠군. 옛 방식을 알아보는 곳을 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinJolly
#. Speaker = Booyahg Shekt
#. NodeID = 39304e3e-1ea3-5a8d-0be5-c7f977ee2333
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_GoblinJolly_HasMet(1) = True
#.   Tag:
#.      - BRANDED(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinJolly:39304e3e-1ea3-5a8d-0be5-c7f977ee2333
msgctxt "h5b67d5dfgb165g4082g987fg1f4198b1d02c"
msgid "How you doin'?"
msgstr "잘 돼가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinJolly
#. Speaker = Booyahg Shekt
#. NodeID = 949e84b1-2ebc-a32f-e676-79ab50026d14
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinJolly:949e84b1-2ebc-a32f-e676-79ab50026d14
msgctxt "hcddacf05g1f3fg4e72gb296ge191037db41d"
msgid "She'd rather be cuttin' folks than curin 'em, but she knows her stuff."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinJolly
#. Speaker = Booyahg Shekt
#. NodeID = aa11bea4-0a00-a55a-c0f8-0dacbe0a3938
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_GoblinJolly_HasMet(1) = False
#.   Tag:
#.      - BRANDED(0) = True
#. SetFlags:
#.   Dialog:
#.     - GOB_GoblinJolly_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinJolly:aa11bea4-0a00-a55a-c0f8-0dacbe0a3938
msgctxt "hf750d2dag0abdg43e2g864fg3207cff8e73e"
msgid "Got myself branded. Now I'm ready to kick some arse."
msgstr "표식을 받았어. 이제 활약할 준비가 되었다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinJolly
#. Speaker = Booyahg Shekt
#. NodeID = d94a776e-f5ee-842d-da17-21271f8493ac
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_GoblinJolly_HasMet(1) = True
#.   Tag:
#.      - BRANDED(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinJolly:d94a776e-f5ee-842d-da17-21271f8493ac
msgctxt "h95fb3fdag7b31g438bg9c97g208e55be29c1"
msgid "How you doin'?"
msgstr "잘 돼가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinJolly
#. Speaker = Booyahg Shekt
#. NodeID = efe49b1f-d4af-66f1-3e0c-27e3cf6b9079
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_GoblinJolly_HasMet(1) = False
#.   Tag:
#.      - BRANDED(0) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_GoblinJolly_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinJolly:efe49b1f-d4af-66f1-3e0c-27e3cf6b9079
msgctxt "h92aad953g7573g42f5g8bdcg70033909a15d"
msgid "Been boozin'? If ya need to clear yer head, priestess can help."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Attack_AssaultCustom
#. Speaker = Dror Ragzlin
#. NodeID = 7870360a-29f0-7991-56b8-5ced404c1a15
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Attack_AssaultCustom:7870360a-29f0-7991-56b8-5ced404c1a15
msgctxt "h3be7f624g9804g489bg8438gf3ad8c89f3e7"
msgid "You defile the Absolute's name. Boys!"
msgstr "절대자님의 이름을 모욕하다니. 얘들아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Dead
#. Speaker = Player
#. NodeID = 27e00048-af56-ca77-2497-29aa71b5f09a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_GoblinKing_Event_ToldAboutWeapon = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Dead:27e00048-af56-ca77-2497-29aa71b5f09a
msgctxt "hcc7f31f7ga7e6g49e1g8c9fgb999c5f37a6d"
msgid "Why does the Absolute want the fugitives?"
msgstr "절대자가 도망친 자들을 원하는 이유가 뭐지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Dead
#. Speaker = Player
#. NodeID = 2ceeb720-6ecb-8213-f5c2-c0e0d19ea18f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_IsMissing = False
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Dead:2ceeb720-6ecb-8213-f5c2-c0e0d19ea18f
msgctxt "ha1709b75g1714g4674ga28dg8cfd4ac4e1da"
msgid "Tell me where I can find a healer."
msgstr "치유사를 어디서 찾을 수 있는 지 말해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Dead
#. Speaker = Narrator
#. NodeID = 37b2925a-4b5c-cae7-353d-2f1739c015f5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Dead:37b2925a-4b5c-cae7-353d-2f1739c015f5
msgctxt "hb5ccbc09g5f91g4467gb11agdb6d6d9433b2"
msgid "*The corpse does not stir. It will answer no more questions.*"
msgstr "*시체는 움직이지 않습니다. 더 이상 질문을 받지 않을 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Dead
#. Speaker = Dror Ragzlin
#. NodeID = 5d5d0025-fe59-fe5f-cce8-04a4b5a9b416
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Knows_IsMissing = True
#.   Quest:
#.     - GLO_Tadpole_SUB_Druid.LearnedLostHalsin(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Dead:5d5d0025-fe59-fe5f-cce8-04a4b5a9b416
msgctxt "hccb63a49g6de1g4af8gafe3gf55bbaef302f"
msgid "Halsin... caged..."
msgstr "할신... 갇혀있다..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Dead
#. Speaker = Dror Ragzlin
#. NodeID = 87133a07-3e83-c18c-583f-38008e388a58
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_GoblinKingDead_Event_SaidFugitives(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Dead:87133a07-3e83-c18c-583f-38008e388a58
msgctxt "h42be9d41g2fd8g4ffagad32gd7461e6f88ef"
msgid "Squid... ship... fugitives... needs..."
msgstr "오징어... 놈들 배... 도망자들이... 필요..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Dead
#. Speaker = Player
#. NodeID = 9262eb8c-e3d2-5218-fb37-3b535b59c571
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Dead:9262eb8c-e3d2-5218-fb37-3b535b59c571
msgctxt "h1d70c5bdgece6g4ce1gba98gde9db1f04bc6"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Dead
#. Speaker = Player
#. NodeID = 9a2eca0c-9162-8eff-4359-ec2882e5d658
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_GoblingKing_Event_HealerPersuasion = False
#.      - GLO_Halsin_Knows_IsFound = False
#.      - GLO_Halsin_Knows_IsMissing = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Dead:9a2eca0c-9162-8eff-4359-ec2882e5d658
msgctxt "haf9a0a4fg0509g4323g94aag7c11fb57a987"
msgid "Where's Halsin?"
msgstr "할신은 어디 있지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Dead
#. Speaker = Dror Ragzlin
#. NodeID = b383278c-3e3d-d4df-77fd-f37d3fa31b82
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Dead:b383278c-3e3d-d4df-77fd-f37d3fa31b82
msgctxt "hc4b8984bgd672g48cbg89b4gce914dceb61e"
msgid "Eternal... glory... ours..."
msgstr "영원한... 영광이... 우리 것..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Dead
#. Speaker = Narrator
#. NodeID = b4c27066-a017-f9d6-562e-c032a11a4783
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Dead:b4c27066-a017-f9d6-562e-c032a11a4783
msgctxt "hcabf02c5g8407g4a36gbe78g0a6337576dd7"
msgid "*The spell's power wanes. You can ask no more questions.*"
msgstr "*주문의 힘이 약해집니다. 더 이상 질문을 할 수 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Dead
#. Speaker = Dror Ragzlin
#. NodeID = cfb866ba-53e2-c039-980c-07f03e880c2b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Absolute_Knows_GoblinsWorship = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Dead:cfb866ba-53e2-c039-980c-07f03e880c2b
msgctxt "h057e1066gcdb9g400dga2d3g222e689633ad"
msgid "Absolute... binds... obedience..."
msgstr "절대자... 결속... 복종..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Dead
#. Speaker = Narrator
#. NodeID = d4c6c71b-5935-1f3f-be01-c4395b614cbb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Dead:d4c6c71b-5935-1f3f-be01-c4395b614cbb
msgctxt "h6a83f84eg004eg4927ga557g28497eabd8b8"
msgid "*The corpse regards you lifelessly.*"
msgstr "*시체가 생기 없는 모습으로 당신을 맞이합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Dead
#. Speaker = Dror Ragzlin
#. NodeID = dcfbfe45-5d97-e88c-e5ab-8a2826c6dc54
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Dead:dcfbfe45-5d97-e88c-e5ab-8a2826c6dc54
msgctxt "h597eb0bag6c24g4bd0g9abbg27e528919cdd"
msgid "Beast ruttin'... looter... worg pens..."
msgstr "야수... 도둑... 워그 우리..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Dead
#. Speaker = Player
#. NodeID = e41f50a8-6750-c1bf-9934-8b705847dacc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_GoblinKing_Event_ScryingEnded = False
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Dead:e41f50a8-6750-c1bf-9934-8b705847dacc
msgctxt "h155ca7a7gded3g4044ga3e8ge8ebcd80c7fb"
msgid "What did you want with that mind flayer?"
msgstr "그 마인드 플레이어로 뭘 하려고 했지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Dead
#. Speaker = Player
#. NodeID = ff7dd133-59fb-4058-df9b-05f4bb65066c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Scrying_NoddedOrShrugged(1) = False
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Dead:ff7dd133-59fb-4058-df9b-05f4bb65066c
msgctxt "h57825957g17dfg4fddga5f7ge019efe3013c"
msgid "Why are you and the drow working together?"
msgstr "왜 드로우와 함께 일하고 있는 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Mindflayer_Dead
#. Speaker = Narrator
#. NodeID = 09968890-6d9e-8af3-8586-f175ab8f933c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Mindflayer_Dead:09968890-6d9e-8af3-8586-f175ab8f933c
msgctxt "hf880c7e6gac13g46f2g8a14g04b856deb898"
msgid ""
"*The sky splits open, and nautiloids pour out of a void that consumes the "
"stars.*"
msgstr "*하늘에 틈이 열리며, 별이라도 삼켜버릴 듯한 공허 속에서 노틸로이드들이 쏟아져 나옵니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Mindflayer_Dead
#. Speaker = Astarion
#. NodeID = 257562f0-35c0-e9da-3aa3-41deed2f3ee8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Mindflayer_Dead:257562f0-35c0-e9da-3aa3-41deed2f3ee8
msgctxt "h40aa4125g578dg47d5g9e54g4b2e61c0116a"
msgid "No! Stop it! Stop it, you wretched worm!"
msgstr "아니야! 멈춰! 멈추라고, 이 벌레 새끼야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Mindflayer_Dead
#. Speaker = Narrator
#. NodeID = 2b91d961-1d5b-8448-ab83-5193c1e24ade
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Mindflayer_Dead:2b91d961-1d5b-8448-ab83-5193c1e24ade
msgctxt "hd13e1c91g39c6g4494gbe91gd6af6c528fa4"
msgid ""
"*You watch through the creature's eyes as it curses the star-born slaves.*"
msgstr "*당신은 이 생물의 눈을 통해 그가 별에서 태어난 노예들에게 욕지거리를 내뱉는 것을 지켜봅니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Mindflayer_Dead
#. Speaker = Player
#. NodeID = 34e7792a-a246-1b8e-cc85-694a5b722924
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Mindflayer_Dead:34e7792a-a246-1b8e-cc85-694a5b722924
msgctxt "h3ecdbea4g361eg4399g9cbfg1fddfa47c271"
msgid "How do I get rid of this parasite?"
msgstr "이 기생충을 어떻게 없애지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Mindflayer_Dead
#. Speaker = Narrator
#. NodeID = 3d6cc7cb-6124-9c83-8b77-e66ce00c7484
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Mindflayer_Dead:3d6cc7cb-6124-9c83-8b77-e66ce00c7484
msgctxt "hefebb0d1g3b87g40afg9cc7gd0fcd1a97faf"
msgid ""
"*You see the tadpole in the mind flayer's hand. Not a parasite: "
"<i>perfection</i>.*"
msgstr "*마인드 플레이어의 손에 들린 올챙이가 보입니다. 기생충이 아닙니다. <i>완벽함</i>입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Mindflayer_Dead
#. Speaker = Narrator
#. NodeID = 43037ae4-8f29-a6b4-99db-0cd8869d9e25
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Mindflayer_Dead:43037ae4-8f29-a6b4-99db-0cd8869d9e25
msgctxt "hd5624287g5c9fg4fd7gbe4fg0cf82b4853df"
msgid ""
"*Rebirth is sloughing flesh. A new skull housing cold, sharp intellect.*"
msgstr "*육체의 파괴를 통해 새로운 생명이 태어납니다. 차갑고, 날카로운 지능을 위한 새로운 두개골입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Mindflayer_Dead
#. Speaker = Narrator
#. NodeID = 45417e1f-641d-aa46-4a5f-474e5dd01477
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_DeadFlayer_AskedAboutAbsolute = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Mindflayer_Dead:45417e1f-641d-aa46-4a5f-474e5dd01477
msgctxt "h6ebf97cegdc38g4f00g9c81gba1cac5f0345"
msgid ""
"*Fractured images fill your mind: curved drow blades, crude goblin torches, "
"gnoll teeth dripping blood.*"
msgstr "*구부러진 드로우 칼날, 투박한 고블린 횃불, 피가 떨어지는 놀의 이빨... 조각난 그림들이 머릿속을 가득 채웁니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Mindflayer_Dead
#. Speaker = Player
#. NodeID = 48193030-da3b-1a1f-d613-7c484b7c8441
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Mindflayer_Dead:48193030-da3b-1a1f-d613-7c484b7c8441
msgctxt "h3aa73d09g87a0g4109g9d05gd7449674d437"
msgid "Tell me who the Absolute is."
msgstr "절대자가 누구인지 알려줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Mindflayer_Dead
#. Speaker = Narrator
#. NodeID = 49a97176-9e37-84d1-edd9-0c78941a9717
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Mindflayer_Dead:49a97176-9e37-84d1-edd9-0c78941a9717
msgctxt "h06dbc9deg7212g461dg8a93gc99c5fffaa40"
msgid ""
"*You see Dror Ragzlin writhe. A tadpole clings to the mind flayer's fingers.*"
msgstr "*드롤 라그즐린이 몸부림치는 것이 보입니다. 마인드 플레이어의 손가락 끝에 올챙이가 들려 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Mindflayer_Dead
#. Speaker = Narrator
#. NodeID = 4de3bb54-7e31-d3b3-5ec5-376d3a9ebc5a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Mindflayer_Dead:4de3bb54-7e31-d3b3-5ec5-376d3a9ebc5a
msgctxt "hc0ddba0bg2c50g4efcg9b4cg4a26786cca07"
msgid ""
"*You see dark tunnels lit by noxious pools of brine. The darkness spreads "
"through the earth.*"
msgstr "*유독성 염수 웅덩이로 밝혀진 어두운 통로가 보입니다. 어둠이 온 대지에 퍼져나갑니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Mindflayer_Dead
#. Speaker = Player
#. NodeID = 51c9cb3c-9bd0-67dd-11e5-b68a6599f6ab
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Mindflayer_Dead:51c9cb3c-9bd0-67dd-11e5-b68a6599f6ab
msgctxt "h3eb5be39g6c7eg4cf4g8418g8e7e41e3b0d1"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Mindflayer_Dead
#. Speaker = Shadowheart
#. NodeID = 52927dd9-9501-2567-3922-aff269377d90
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Mindflayer_Dead:52927dd9-9501-2567-3922-aff269377d90
msgctxt "hfcb3a949g579ag494ag9e3fg598f049e8f5f"
msgid "<i>Agh</i>... my tadpole... it's just like on the ship..."
msgstr "<i>아악</i>... 내 올챙이... 함선에서랑 똑같잖아..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Mindflayer_Dead
#. Speaker = Narrator
#. NodeID = 562bc71b-26a7-3f1d-c6d1-db178c731286
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. TagRule: REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Mindflayer_Dead:562bc71b-26a7-3f1d-c6d1-db178c731286
msgctxt "h592e21acg73dag4937ga26eg29a27f7e90f4"
msgid ""
"*There's no doubt - this <i>ghaik</i> is responsible for your parasite. And "
"it's waiting for your questions.*"
msgstr "*의심의 여지가 없습니다. 이 <i>게이크</i>가 당신에게 기생충을 집어넣었습니다. 그리고 당신의 질문을 기다리고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Mindflayer_Dead
#. Speaker = Narrator
#. NodeID = 562bc71b-26a7-3f1d-c6d1-db178c731286
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Mindflayer_Dead:562bc71b-26a7-3f1d-c6d1-db178c731286
