#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarlockProposal_Warlock:1d60cc45-1431-6f68-17cc-ee0d4b112c49
msgctxt "hceacbec9g7fecg412egb8b7g4f8d1216acbc"
msgid ""
"Besides - you can convey your message in person. You'll meet him again soon "
"enough."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarlockProposal_Warlock
#. Speaker = Korrilla
#. NodeID = 2067c1e4-c079-3e1d-6d54-f971168351f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarlockProposal_Warlock:2067c1e4-c079-3e1d-6d54-f971168351f0
msgctxt "h32a7d711g4ad1g4e15g9b2eg5d36d6f15447"
msgid "You haven't met him yet. But you will. Soon."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarlockProposal_Warlock
#. Speaker = Player
#. NodeID = 24907d9f-570e-15d0-9b73-76f27141d799
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarlockProposal_Warlock:24907d9f-570e-15d0-9b73-76f27141d799
msgctxt "he083ebe8g9b66g4cc7g9feagcc9b3991f9ef"
msgid "Could you get me out of these chains?"
msgstr "이 사슬 좀 풀어줄래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarlockProposal_Warlock
#. Speaker = Korrilla
#. NodeID = 2dff095f-21fe-43b9-660e-d8887767705a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarlockProposal_Warlock:2dff095f-21fe-43b9-660e-d8887767705a
msgctxt "h12fc11eag0f55g4aabg99a2g7863202b1a38"
msgid ""
"Oh, <i>please</i>. There's not a devil in the Hells that doesn't know "
"Zariel's favourite has become a fugitive."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarlockProposal_Warlock
#. Speaker = True Soul Gut
#. NodeID = 306a7b10-a852-614c-837f-8c4785b0f7d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarlockProposal_Warlock:306a7b10-a852-614c-837f-8c4785b0f7d9
msgctxt "hd6e17b15g13a7g4e61g8050gac28db41fcbb"
msgid ""
"Disappointing not to have my own squiddie... but your giblets'll make for a "
"tasty supper."
msgstr "오징어를 못 먹어서 아쉽지만, 네 내장은 맛있는 저녁 식사가 될 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarlockProposal_Warlock
#. Speaker = Player
#. NodeID = 30bff5f4-8fb2-66e6-1275-eface4ef61d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarlockProposal_Warlock:30bff5f4-8fb2-66e6-1275-eface4ef61d0
msgctxt "hbd60b181g46d5g410cgadc9gc69c239b2d27"
msgid "Not anymore. If you're here to take me back, I'll kill you."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarlockProposal_Warlock
#. Speaker = True Soul Gut
#. NodeID = 4a799a46-3546-9778-5d1f-14db9a535a49
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarlockProposal_Warlock:4a799a46-3546-9778-5d1f-14db9a535a49
msgctxt "h03ce1f30g7476g4083gbabdg6dec94ecb929"
msgid "Open your peepers, freak. It's time."
msgstr "눈 떠봐, 괴물아. 때가 됐다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarlockProposal_Warlock
#. Speaker = Korrilla
#. NodeID = 52b12a6b-eaa2-f4da-58df-562621723cc6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_TheMonitor_HasMet_TheMonitor = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarlockProposal_Warlock:52b12a6b-eaa2-f4da-58df-562621723cc6
#, fuzzy
msgctxt "h7f5d3750gad1cg430bgbe2eg56d88d4cd433"
msgid ""
"You already met him - the honourable Raphael. He's terribly excited about "
"you... and your <i>condition</i>."
msgstr "당신은 이미 그분을 만났어요. 존경하는 라파엘 님이죠. 그분은 당신과… 당신 <i>상태</i>에 끔찍이 흥미를 갖고 계십니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarlockProposal_Warlock
#. Speaker = Korrilla
#. NodeID = 54d82923-6b60-6310-8fab-aa12ab550971
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarlockProposal_Warlock:54d82923-6b60-6310-8fab-aa12ab550971
msgctxt "h2d5a7619g120ag4954ga23dg29a44552ac04"
msgid "Korrilla Hearthflame, at your service."
msgstr "코릴라 하스플레임이 당신에게 인사드립니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarlockProposal_Warlock
#. Speaker = Korrilla
#. NodeID = 642fc0fe-b4b6-b5ca-e111-1c343d13e439
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarlockProposal_Warlock:642fc0fe-b4b6-b5ca-e111-1c343d13e439
#, fuzzy
msgctxt "h811aae10gb90dg4faagae76g535148fa5d37"
msgid ""
"Be a little more careful. Your soul's very valuable, and we won't always be "
"able to intervene."
msgstr "조금만 더 조심해 주세요. 당신의 영혼은 정말 귀중하지만, 매번 개입할 수는 없으니까요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarlockProposal_Warlock
#. Speaker = Korrilla
#. NodeID = 642fc0fe-b4b6-b5ca-e111-1c343d13e439
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarlockProposal_Warlock:642fc0fe-b4b6-b5ca-e111-1c343d13e439
msgctxt "hb3a51a15g1027g4439gac28g495f11111b88"
msgid ""
"Be a little more careful. That skin's valuable, and we won't always be "
"watching."
msgstr "조금만 더 조심해 주세요. 당신의 살갗은 정말 귀중하지만, 저희가 매번 지켜볼 수는 없으니까요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarlockProposal_Warlock
#. Speaker = Korrilla
#. NodeID = 744f54a9-314c-8814-e20c-e6a36a0e2bff
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
