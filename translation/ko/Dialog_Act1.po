msgid "DIE."
msgstr "죽어라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_HarpyInterrupted
#. Speaker = Harpy
#. NodeID = 80125602-f813-236c-ae12-9a19c240e13c
