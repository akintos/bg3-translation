msgctxt "hd81b2ee2gc56cg4dedg922eg11791617bd95"
msgid "I'll tear your throat out!"
msgstr "네 목을 찢어주지!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim3
#. Speaker = Player
#. NodeID = cede5d70-f108-e451-9ab6-c81444d75f34
#. HandlePath = TaggedText[0].TagText[0]
