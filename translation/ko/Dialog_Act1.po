msgid ""
"That's <i>lovely</i> stuff, True Soul. Only... we smack that drum so the "
"lads know there's <i>killin' </i>on."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_AlarmUsedReaction
