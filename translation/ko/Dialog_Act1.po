msgid "<i>And </i>it makes funny noises."
msgstr "<i>그리고 </i>웃긴 소리도 낸다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear
#. Speaker = Three
#. NodeID = e631ae73-5b3d-2f75-3c6f-77e3842d31a2
