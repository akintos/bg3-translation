msgctxt "h57b62bdcgeed1g4506gbb20g92dd7441b66c"
msgid "Hellooo?"
msgstr "계세요오오?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DeepHole
#. Speaker = Narrator
#. NodeID = f84c537b-df27-50ea-28dc-ea9fc3437b07
