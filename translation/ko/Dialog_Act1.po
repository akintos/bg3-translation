msgctxt "h4c1e932bg5d01g49e2gb475gd545a312cc85"
msgid "Chicken! Chicke-e-en. Come!"
msgstr "닭이다! 다아앍! 이리 와!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_Ogre_00
#. Speaker = Guard Gurgon
#. NodeID = 5aaa10cf-8b5c-dcf2-7554-e701d4a3d4ac
