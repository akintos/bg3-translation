msgctxt "h5930c9f6g8a19g4db7gba02ge2ceb70821a5"
msgid "If only there were more blessings to count."
msgstr "그렇게 생각할 축복이 남아 있었다면 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerDaffy
