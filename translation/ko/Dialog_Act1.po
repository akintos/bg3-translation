msgctxt "hd8b7cee8ga2ebg4b16g99c5gcf2a63f762d1"
msgid "Farewell."
msgstr "안녕히."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Baelen Bonecloak
#. NodeID = 98936b3a-aeaa-50cb-1b3a-4253a796beb7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter:98936b3a-aeaa-50cb-1b3a-4253a796beb7
msgctxt "h133259d1g7bd0g4249ga634g12deb620c82f"
msgid "Someone's got to look after Derryth."
msgstr "누군가는 데리스를 돌봐줘야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Baelen Bonecloak
#. NodeID = 9a473695-80fc-6854-d57e-b6d2130c9da5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter:9a473695-80fc-6854-d57e-b6d2130c9da5
msgctxt "ha7c4cccag9f3ag449bgb699g6f49b7b6a994"
msgid "Wait! I - need... Derryth! My bag! I beg you!"
msgstr "잠깐! 난... 데리스가 필요해! 내 배낭! 이렇게 빌게!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Player
#. NodeID = 9aea4254-c77d-f509-a8fb-46248061fd17
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter:9aea4254-c77d-f509-a8fb-46248061fd17
msgctxt "h465a2750g9813g4ad4g9423g01dc1ecb0811"
msgid "She and I had... <i>an altercation.</i>"
msgstr "그녀와 저 사이에... <i>언쟁이 있었어요.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Baelen Bonecloak
#. NodeID = a39a4c1e-6971-8cce-79c2-0675daf18a5d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter:a39a4c1e-6971-8cce-79c2-0675daf18a5d
msgctxt "hac8e0274ga2c8g4ba8gbfa0gd88dd809aa8e"
msgid "Please! Your help!"
msgstr "제발! 너의 도움!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Baelen Bonecloak
#. NodeID = a4a18a13-b6d6-3740-816b-2c2ee4baac44
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_MushroomHunter_Knows_Missing = True
#.   Object:
#.     - UND_MushroomHunter_State_GotBackpack(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter:a4a18a13-b6d6-3740-816b-2c2ee4baac44
msgctxt "hda267bacg7a24g4c74ga27dg0b09e520223b"
msgid "Thank you!"
msgstr "고마워!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Baelen Bonecloak
#. NodeID = a5395012-d9d5-f6ec-c2fd-9514838f6ec5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter:a5395012-d9d5-f6ec-c2fd-9514838f6ec5
msgctxt "hacadd7ccg4d17g4abega54bgc396b01880fd"
msgid "Anything from - anything sourced here - very high rate of profit."
msgstr "여기서 자라는 뭐든 - 모든 게 수익률 매우 높아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Baelen Bonecloak
#. NodeID = a56666e3-3ec4-7329-75f2-c13b35aa4cc7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DUERGARDWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter:a56666e3-3ec4-7329-75f2-c13b35aa4cc7
msgctxt "hf498c135gb226g4b50gbad7g80dcdeecdff5"
msgid "Bloody greyskin!"
msgstr "빌어먹을 회색놈!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Baelen Bonecloak
#. NodeID = a68d091e-99dd-feb1-e1f4-9b282e857cdf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter:a68d091e-99dd-feb1-e1f4-9b282e857cdf
msgctxt "hedd43471g91b4g4694g9b73g389547313a55"
msgid "YES! That's it!"
msgstr "<b>그래!</b> 그거야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Player
#. NodeID = a768ce38-d779-54fb-71ae-3fdc2f022df5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter:a768ce38-d779-54fb-71ae-3fdc2f022df5
msgctxt "he7396968g747bg4219gb103ged7cbf493031"
msgid "I'm glad I found you when I did."
msgstr "제가 당신을 찾아서 다행이군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Baelen Bonecloak
#. NodeID = a82acd32-b4a3-62ea-c11c-c532582fcc51
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MushroomHunter_Event_AteMushroom = True
#.      - UND_MushroomHunter_State_InVillage = True
#.      - UND_MushroomHunter_State_Saved = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter:a82acd32-b4a3-62ea-c11c-c532582fcc51
msgctxt "h732b3ceag7089g463egb430g012148444f72"
msgid ""
"Gettin' outta here soon enough. Wouldn't have came here if I'd had my wits "
"to work."
msgstr "빨리 여기서 나가야겠어. 내가 제정신이었다면 여기 오지도 않았을 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Player
#. NodeID = ab096603-352c-e352-63f5-f3833b16e570
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_DwarvenAlchemist_Knows_LossOfMemory = False
#. SetFlags:
#.   Global:
#.     - UND_DwarvenAlchemist_Knows_LossOfMemory = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter:ab096603-352c-e352-63f5-f3833b16e570
msgctxt "h4729ad82g6b66g447cg88d7ge282473d1cff"
msgid "Are you feeling all right? Seems like you get confused easily."
msgstr "괜찮으신가요? 쉽게 혼란스러워하시는 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Baelen Bonecloak
#. NodeID = ab0dcd9a-4909-450e-c0f2-0214d0cf03d7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_MushroomHunter_Saved_HasMet(1) = True
#.   Global:
#.      - UND_MushroomHunter_State_DerrythDead = True
#.      - UND_MushroomHunter_State_InVillage = True
#.      - UND_MushroomHunter_State_Saved = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter:ab0dcd9a-4909-450e-c0f2-0214d0cf03d7
msgctxt "h8457d915gc199g472bg8f96ged839d7328ea"
msgid "She should've come with me. I shouldn't have left her."
msgstr "그녀와 함께했어야 했어. 그녀를 떠났으면 안 됐어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Baelen Bonecloak
#. NodeID = ad414786-7ddb-afb1-91a2-d30e8112f3ac
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
