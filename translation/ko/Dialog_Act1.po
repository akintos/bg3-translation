msgctxt "h7e1789c0ga1ecg437cga0e9g1a8cf293ce85"
msgid "Nothing. Lie back down and be silent."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinSleeper_02
#. Speaker = Narrator
#. NodeID = 5232fad4-34a4-7bd1-7380-9f0b923137b2
