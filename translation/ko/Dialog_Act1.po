msgctxt "h3f06b6b8g7ea3g4ec1gba42gabe977fae2d4"
msgid "Moonrise Towers..."
msgstr "문라이즈 타워..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman_Dead
#. Speaker = Beldron
#. NodeID = 299d3a4b-02a8-bf9e-6f35-62f17dca6daa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman_Dead:299d3a4b-02a8-bf9e-6f35-62f17dca6daa
msgctxt "he8f978cag96f8g492egb0e8g2966faaf2c71"
msgid "Captured... drow... duergar..."
msgstr "잡혔어... 드로우... 듀에르가..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman_Dead
#. Speaker = Player
#. NodeID = 2eaab873-46d5-9df5-7e99-ad4ab85f7db8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman_Dead:2eaab873-46d5-9df5-7e99-ad4ab85f7db8
msgctxt "h5031db1bg0d3fg4740gbefegfeb30eb5712d"
msgid "Where are you from?"
msgstr "어디서 왔지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman_Dead
#. Speaker = Beldron
#. NodeID = 3420bc4a-8691-b3cf-3db3-ce0c664c55cc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - UND_GnomeForemanDead_MentionedIronhand(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman_Dead:3420bc4a-8691-b3cf-3db3-ce0c664c55cc
msgctxt "h40a84a3dg0d79g4a5dga1e5gf18fc7e9f5be"
msgid "Beldron... Ironhand Gnomes..."
msgstr "벨드론... 아이언핸드 노움..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman_Dead
#. Speaker = Beldron
#. NodeID = 393d05e5-3fed-0b7d-14d2-5afa4ccd83a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman_Dead:393d05e5-3fed-0b7d-14d2-5afa4ccd83a6
msgctxt "h42c40341g73d5g4b0dg9a7agdf7124dcfe47"
msgid "Mithral Hall... dwarves took in... family..."
msgstr "미스랄 전당... 드워프가 잡아갔어... 가족을..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman_Dead
#. Speaker = Beldron
#. NodeID = 4fcb3292-9b2c-8973-95d9-f30c3efb5b5e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_DuergarCamp_Quest_SmokepowderStash = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman_Dead:4fcb3292-9b2c-8973-95d9-f30c3efb5b5e
msgctxt "hf1474ac2g4ac5g4badg89d2g1cca4b3dad47"
msgid "Explosives...  Philomeen..."
msgstr "폭발물... 필로민..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman_Dead
#. Speaker = Beldron
#. NodeID = 4fff48b6-3e76-b0d6-76c5-c14c130c320a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman_Dead:4fff48b6-3e76-b0d6-76c5-c14c130c320a
msgctxt "ha1e31827gcb78g4efdg8407geb3e95a6cc98"
msgid "Rebels... troublemakers... freedom fighters..."
msgstr "반항자들... 말썽꾼들... 자유의 투사들..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman_Dead
#. Speaker = Narrator
#. NodeID = 625fac81-d423-52e1-6afb-de6cd72cb708
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman_Dead:625fac81-d423-52e1-6afb-de6cd72cb708
msgctxt "hd5f40a7cgfc9dg4223g8874g350485cb0376"
msgid "*The spell's power wanes. You can ask no more questions.*"
msgstr "*주문의 힘이 약해집니다. 더 이상 질문할 수 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman_Dead
#. Speaker = Player
#. NodeID = 6812a02f-09a6-07ef-1e56-74ccd3965b7a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_GnomeForemanDead_MentionedIronhand(1) = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman_Dead:6812a02f-09a6-07ef-1e56-74ccd3965b7a
msgctxt "h081de248g17f4g4ce8gaa06g2a8ab1407da9"
msgid "Who are the Ironhand Gnomes?"
msgstr "아이언핸드 노움은 뭐 하는 자들이지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman_Dead
#. Speaker = Player
#. NodeID = 9d66303e-3727-2dbc-dbc1-f559756b64a3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman_Dead:9d66303e-3727-2dbc-dbc1-f559756b64a3
msgctxt "hfbd2b733g278bg4843ga90dg63fec1ae1380"
msgid "Who are you?"
msgstr "너는 누구지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman_Dead
#. Speaker = Narrator
#. NodeID = a7fbca84-c1a5-b487-ae00-aea34d75df20
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman_Dead:a7fbca84-c1a5-b487-ae00-aea34d75df20
msgctxt "h5740aa3fgfd4ag423fg96f0g3b6f8a000409"
msgid "*The corpse does not stir. It will answer no more questions.*"
msgstr "*시체는 움직이지 않습니다. 더 이상 질문을 받지 않을 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman_Dead
#. Speaker = Narrator
#. NodeID = abb388e7-30ee-fe48-2519-d08a565fef03
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman_Dead:abb388e7-30ee-fe48-2519-d08a565fef03
msgctxt "h70c00148g47a4g4653gb317g852c1c1db93c"
msgid "*The corpse regards you lifelessly.*"
msgstr "*시체가 생기 없는 모습으로 당신을 맞이합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman_Dead
#. Speaker = Player
#. NodeID = b5f94fc5-063b-fdde-2e14-0a0a3a4f68ac
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman_Dead:b5f94fc5-063b-fdde-2e14-0a0a3a4f68ac
msgctxt "h716e1ce2g0f13g4976gb27cgd2524cfee72b"
msgid "What happened to the rest of your people?"
msgstr "너희 사람들 중 나머지는 어떻게 됐나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman_Dead
#. Speaker = Player
#. NodeID = b6d1ad4d-ef1b-7a2f-1530-c743494c650a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman_Dead:b6d1ad4d-ef1b-7a2f-1530-c743494c650a
msgctxt "hf8e9f90dg2330g4d8bga649gf3cbc25f0249"
msgid "What were you doing in the ruins?"
msgstr "폐허에서 뭘 하고 있던 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman_Dead
#. Speaker = Narrator
#. NodeID = df09193e-b6b0-49c6-5ea8-223641db4f7e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_Killer(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman_Dead:df09193e-b6b0-49c6-5ea8-223641db4f7e
msgctxt "hb2223e5dg814ag4ea5g9f35g77b20aebc88b"
msgid "*The corpse seems willing to speak - but not to its killer.*"
msgstr "*시체는 말할 의지가 있지만, 자신을 죽인 자와 대화하고 싶지는 않은 듯 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman_Dead
#. Speaker = Player
#. NodeID = fe645f69-759c-4e5f-681c-26670df23838
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman_Dead:fe645f69-759c-4e5f-681c-26670df23838
msgctxt "h2d7fa910g3990g4742g8938gb36c63ca75ba"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman_Saved
#. Speaker = Beldron
#. NodeID = 18840416-0212-133d-14eb-d32f57bdd8c0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_GnomeForeman_Saved_HasMet(1) = True
#.   Global:
#.      - UND_InjuredGnome_State_SporeServant = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman_Saved:18840416-0212-133d-14eb-d32f57bdd8c0
msgctxt "ha6514dd6g147dg454cg98b9gd6de38d04e80"
msgid "We're moving on. There's... there's nothing left for us here."
msgstr "우리는 이동할 거요. 여기에는... 여기에는 우리가 더 할 수 있는 게 없군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman_Saved
#. Speaker = Beldron
#. NodeID = 53c7a497-e0a3-a55c-6003-ffe18441378c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_GnomeForeman_Saved_HasMet(1) = False
#.   Global:
#.      - UND_InjuredGnome_State_SporeServant = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman_Saved:53c7a497-e0a3-a55c-6003-ffe18441378c
msgctxt "habb1e321g45bdg484bg8b6cg1a85749ebff2"
msgid ""
"I knew little Thulla would survive all this. But... not like <i>that.</i>"
msgstr "꼬마 툴라가 이 모든 것에서 살아남을 줄 알고 있었지. 하지만... <i>그런</i> 식이었을 줄이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman_Saved
#. Speaker = Beldron
#. NodeID = 550a298f-bfea-01a5-0a6c-5b5a3315dd01
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_GnomeForeman_Saved_HasMet(1) = True
#.   Global:
#.      - UND_MyconidCircle_State_BothSovereignsDead = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman_Saved:550a298f-bfea-01a5-0a6c-5b5a3315dd01
msgctxt "ha5e02640g3ae3g4f9cg82bfg41e6c48357a9"
msgid ""
"Never thought I'd owe a bunch o' mushrooms my life. Only wish the rest of my "
"people were here."
msgstr "버섯들한테 내 목숨을 빚질 줄은 생각도 못 했소. 내 사람들이 전부 여기 있었으면 좋았을 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman_Saved
#. Speaker = Beldron
#. NodeID = 676eb42f-8b5b-a0e3-389d-b0e1ee61b520
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_GnomeForeman_Saved_HasMet(1) = True
#.   Global:
#.      - UND_MyconidCircle_State_BothSovereignsDead = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman_Saved:676eb42f-8b5b-a0e3-389d-b0e1ee61b520
msgctxt "ha9eee5ceg539bg42b0g8238gdf202f5dea9e"
msgid ""
"What a bloodbath. Safer here than in Grymforge though, no doubt about it."
msgstr "피바다가 따로 없군. 그래도 그림포지에 있는 것보다는 여기 있는 게 낫겠지. 그건 확실하오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman_Saved
#. Speaker = Beldron
#. NodeID = aad9ec35-7c3f-029b-cc96-d430488a512c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_GnomeForeman_Saved_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - UND_GnomeForeman_Saved_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman_Saved:aad9ec35-7c3f-029b-cc96-d430488a512c
msgctxt "hebcb6891gddadg4654ga7d8g2bfba6abd909"
msgid ""
"Thanks again for offing that drow. Only made it here 'cause of you. But I "
"can't stop thinking about the rest of us..."
msgstr "그 드로우를 죽여줘서 고마워. 네 덕분에 여기까지 온 거야. 그렇지만 나머지 사람들이 계속 생각이 나는군..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman_Saved
#. Speaker = Beldron
#. NodeID = d8f125c5-e5f7-ea46-51fd-eae54429e40d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeForeman_Saved:d8f125c5-e5f7-ea46-51fd-eae54429e40d
msgctxt "hf276febag1d45g483bgae84gf4f6f24e0232"
msgid "... stuck in Moonrise with a bunch of sadists. Poor bastards."
msgstr "... 수많은 사디스트 놈들과 함께 문라이즈에 갇혀 있는 사람들 말이야. 불쌍한 자식들."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerDaffy
#. Speaker = Apprentice Laridda
#. NodeID = 170e61e1-039b-7a1b-382b-5e0d3898b5e0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_GnomeWorkerDaffy_Event_SharedBadNews = True
#.      - UND_ArguingGnomes_State_SaidEscapeeSafe = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerDaffy:170e61e1-039b-7a1b-382b-5e0d3898b5e0
msgctxt "had9a034fg2031g4501g8f5ag9e427a1574c8"
msgid "Damn it, Philomeen. After all that's happened."
msgstr "젠장, 필로민. 그렇게 많은 일이 있었는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerDaffy
#. Speaker = Apprentice Laridda
#. NodeID = 1d0d95f3-8d3f-70d6-861d-c5634579d107
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerDaffy:1d0d95f3-8d3f-70d6-861d-c5634579d107
msgctxt "hc1a833f2g9211g4395g8722g66f5e436b46e"
msgid "Please - I'm working as fast as I can."
msgstr "제발, 지금 최대한 빠르게 일하고 있는 거라구요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerDaffy
#. Speaker = Apprentice Laridda
#. NodeID = 21ec090c-8594-b54c-8181-c0da7f48045b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_ArguingGnomes_State_Inconsolable = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerDaffy:21ec090c-8594-b54c-8181-c0da7f48045b
msgctxt "h37fc47dcg0473g49e0gbc6cg1b3c64b1bc9a"
msgid "I was right about you. <i>Drugnin' </i>monster. You... you..."
msgstr "너에 대해서는 내가 옳았군. <i>드루그닌</i>괴물 녀석. 너...너는..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerDaffy
#. Speaker = Apprentice Laridda
#. NodeID = 2900a0a2-45e4-41de-afee-bf146ea022d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerDaffy:2900a0a2-45e4-41de-afee-bf146ea022d0
msgctxt "hf30c4731g3684g4b20g9151g3916f9b4b5c7"
msgid ""
"Move on? I gave her <i>everything.</i> And she has the gall to send <i>you</"
"i> to break me?"
msgstr ""
"미련을 버리라고요? 그녀에게 내 <i>전부</i>를 줬어요. 그런데 뻔뻔하게도 <i>당신</i>을 시켜서 내 마음을 이렇게 부숴버리다니?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerDaffy
#. Speaker = Apprentice Laridda
#. NodeID = 33fb08d4-e50c-0a73-fb36-dd68a26444dd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_GnomeWorkers_Event_Leave = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerDaffy:33fb08d4-e50c-0a73-fb36-dd68a26444dd
msgctxt "h700221c3ga8b0g44d3ga0f5gc7119049a7ce"
msgid "We've got to leave Grymforge. Beldron must have a plan."
msgstr "우리는 그림포지를 떠날 거예요. 벨드론에게 계획이 있겠죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerDaffy
#. Speaker = Apprentice Laridda
#. NodeID = 34859dcf-20d7-c9fd-283e-e3ed5f7cd1bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerDaffy:34859dcf-20d7-c9fd-283e-e3ed5f7cd1bf
msgctxt "ha246f55fga1a3g4ac3gb32bg2022685d9f51"
msgid "May Ironhand be with her."
msgstr "아이언핸드께서 그녀와 함께 하시길."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerDaffy
#. Speaker = Player
#. NodeID = 3fb8f5f7-f676-0489-2383-64cf40f4fa27
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_ArguingGnomes_State_SaidEscapeeDead = False
#.      - UND_ArguingGnomes_State_SaidEscapeeSafe = False
#.      - UND_PanicRoom_State_GnomePermaDefeated = True
#. SetFlags:
#.   Global:
#.     - UND_ArguingGnomes_State_SaidEscapeeDead = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_GnomeWorkerDaffy:3fb8f5f7-f676-0489-2383-64cf40f4fa27
msgctxt "ha4972d71g6138g4c8egb006g322b028cab80"
msgid "Philomeen is - gone."
msgstr "필로민은... 이제 없어."

