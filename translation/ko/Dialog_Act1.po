#. SetFlags:
#.   Global:
#.     - GLO_WarlockProposal_ReleasePlayer = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarlockProposal_Warlock:7b23f5fc-985b-7fc7-ac1b-b206dc205754
msgctxt "h0a6aac0fgf6ffg452dg9335g7095b07e3474"
msgid ""
"At this point, you're more interesting alive than dead. So here I am, your "
"saviour in times of need."
msgstr "지금은 당신이 죽는 것보다 살아있는 게 더 흥미롭거든요. 그래서 필요한 순간에 제가 당신의 구세주로서 온 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarlockProposal_Warlock
#. Speaker = Korrilla
#. NodeID = 7ce716d2-1ff1-6b22-b374-fdf660277c14
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
