msgctxt "h30d1abfdg5b2dg4a78gbf67g75e47fd73037"
msgid "HA HA! Your <i>face</i>."
msgstr "하하! 네 <i>얼굴</i> 좀 봐라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_MageHandKid02
#. Speaker = Ra'jak
#. NodeID = 6e3978b8-6979-136c-36a7-cbed7dd8d463
