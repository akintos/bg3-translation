msgctxt "h1bca5298ga602g45dcga260g25213e4e9a05"
msgid "Sure, I'll take your supplies - and everything else you own."
msgstr "물론. 네 보급품을 가져가고 갖고 있는 것도 전부 가져가도록 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_003_PostEA
#. Speaker = Cyrel
#. NodeID = f9d38ee4-6d89-c7d1-1458-738dc4be936c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_003_PostEA:f9d38ee4-6d89-c7d1-1458-738dc4be936c
msgctxt "h2f108e4age166g45e0gbe21g6ec21cc565fa"
msgid "Kill the devil, if you can. Otherwise, leave well enough alone."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_003_PostEA
#. Speaker = Cyrel
#. NodeID = fd875e6c-bb0b-0d0f-6a63-38176e6a0886
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_003_PostEA:fd875e6c-bb0b-0d0f-6a63-38176e6a0886
msgctxt "h328c3cd3g9f89g4b3ega523ga2af3850d899"
msgid "In Tyr's name."
msgstr "티르의 이름으로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_Dead_PostEA
