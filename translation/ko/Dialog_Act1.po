msgctxt "hfb883c89g38e4g4ad0g9487gbfdac0f9c53a"
msgid "*Your mind lurches, reeling suddenly as if... bitten.*"
msgstr "*뭔가에 깨물린 것처럼 느닷없이 정신이 휘청거립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = bbf74443-1785-f7ac-c8c7-c3259c4cc4c1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:bbf74443-1785-f7ac-c8c7-c3259c4cc4c1
msgctxt "he16b4004ga812g4528gbfc0g166a4d3804ce"
msgid "Lads! This'n's trying to scramble my brains!"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = bc53f791-f1fd-e9f2-e9dc-7cd13be22a2e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:bc53f791-f1fd-e9f2-e9dc-7cd13be22a2e
msgctxt "h9497bcc7g7c5bg4df6ga457ga12d07689374"
msgid "Your mug'll look right lovely stuck on a pike. But we'll do it up nice."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Narrator
#. NodeID = bcb666ca-c04a-820d-86e0-fc93cc706201
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Tag:
#.     - TRUESOUL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:bcb666ca-c04a-820d-86e0-fc93cc706201
msgctxt "h72641f63ga93dg48fcgb792g42414c854bcc"
msgid ""
"*Your mind is full, bursting with ecstasy and terror. Finally, it is coming. "
"You are becoming.*"
msgstr "*당신의 정신이 황홀경과 공포로 가득 차오릅니다. 마침내, 때가 됐군요. 당신은 변화 중입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = becdae46-0582-9629-6087-c42afed96873
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:becdae46-0582-9629-6087-c42afed96873
msgctxt "h39d03c3bgb2b3g49e6ga83cg26513336c596"
msgid "Nice dab o' this across the mug oughta do it."
msgstr "그 상판때기에 이걸 살짝 바르는 거면 충분해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = bf9311c3-e76b-2df5-ef83-54cb3a141d77
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:bf9311c3-e76b-2df5-ef83-54cb3a141d77
msgctxt "hc9709e42ge76dg422bga7f9gaa3e545bccf8"
msgid "Lads! This'n's trying to scramble my brains!"
msgstr "아그들아! 이 놈이 내 뇌를 조지려 든다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = c2ebbe8c-65b6-c389-4cf2-50302f309859
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001:c2ebbe8c-65b6-c389-4cf2-50302f309859
msgctxt "h5fb762c1g600bg449cg9c89gf08377a06675"
msgid "Lads even captured some duke. Worth celebratin', that is."
msgstr "심지어 우리 애들이 공작도 사로잡았더라. 그건 축하할 만한 일이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
