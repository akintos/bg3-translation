#.     - GOB_GoblinKingSpeech2 = True
#.     - GOB_GoblinKingSpeech1 = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_GoblinKing_AD_KingBeforeScrying:a44e4f1e-f020-ad28-7408-fc0ff4a978d6
msgctxt "hc3e0037dgdd6dg43beg9d61ge83be83a1af9"
msgid "Deliver the truth. <i>Rhaal'tuuch!</i>"
msgstr ""

