msgid "<i>Attack the hobgoblin.</i>"
msgstr "<i>홉고블린을 공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying
#. Speaker = Dror Ragzlin
#. NodeID = 132de113-7c78-4a12-6b8f-edc6a9140da4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Absolute_Knows_GoblinsWorship = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying:132de113-7c78-4a12-6b8f-edc6a9140da4
msgctxt "hf4f074fag48bdg4687ga371g73f98da8da95"
msgid "Who is the Absolute?"
msgstr "절대자가 누구지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying
#. Speaker = Player
#. NodeID = 1345c94a-fdb7-87fe-5bdd-755124c5455c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Scrying_AskedMission(2) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_Scrying_AskedMission(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying:1345c94a-fdb7-87fe-5bdd-755124c5455c
msgctxt "h43093a0dgc38cg4719gba89gf7c87951f97a"
msgid "What were you doing in Faerûn?"
msgstr "페이룬에서 뭘 하고 있었지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying
#. Speaker = Player
#. NodeID = 173b48c5-4a5a-5795-9eb7-e38b468140c5
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: BARD or CLERIC
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying:173b48c5-4a5a-5795-9eb7-e38b468140c5
msgctxt "hd77bc7e0g7a54g4861gba5dg33511573b057"
msgid "I know this magic. Hand me the scroll and I can do the talking."
msgstr "내가 아는 마법이군. 두루마리를 넘겨, 내가 질문할 테니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying
