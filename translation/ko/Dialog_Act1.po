msgctxt "h403e366ageab6g491agbf17g2b62fc633d40"
msgid "Don't be lookin' at my stuff."
msgstr "내 물건에 눈독 들이지 마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_ApothecaryGoblins_Goblin_02
