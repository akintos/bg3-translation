#. NodeID = 7545aa50-6ceb-2ace-67c6-cd22367a4321
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:7545aa50-6ceb-2ace-67c6-cd22367a4321
msgctxt "h110e631cgf7c6g494ag8cf3g558d0482206c"
msgid "So now we're makin' sure this lad regrets not tellin' us."
msgstr "그래서 지금 이 녀석이 우리에게 털어놓지 않은 걸 후회하게 하는 중이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = 76517511-13ac-628b-980f-5a85d0d7edd8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:76517511-13ac-628b-980f-5a85d0d7edd8
msgctxt "hee9dde63ged5bg42a0g8b1bg0393a1d6bf10"
msgid "An' you yerself, you're a nasty piece of work!"
msgstr "그리고 넌 완전 피도 눈물도 없었어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = 79ef54d9-d065-c185-1457-f93710c532da
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_HappyTorturers_Assaulted = True
#.   Local:
#.      - 0e5d25bd-078d-8850-b7bd-6d6210fa8956_Assault_Warned = True
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:79ef54d9-d065-c185-1457-f93710c532da
msgctxt "hae81945dg2635g4c72g93c5gf81183507370"
msgid "I warned you, I WARNED you not to touch him. And now you'll PAY."
msgstr "내가 경고했지. 녀석을 건드리지 말라고 했는데. 네가 자초한 일이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = 7a7c5feb-fa0c-5d81-5e9c-37665926c2af
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Torturers_BrokeNose(2) = True
#. SetFlags:
#.   Dialog:
#.     - GOB_Torturers_Assisted(2) = True
#.   Object:
#.     - GLO_PaladinOathbreaker_Event_BrokeOath(2) = True
#. TagRule: REALLY_DARK_URGE
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:7a7c5feb-fa0c-5d81-5e9c-37665926c2af
msgctxt "h7235dd56gb12cg4bbcg9662gc0b0e865aed6"
msgid "<i>Crack his kneecaps like eggs.</i>"
msgstr "<i>계란 부수듯 무릎을 깨버린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = 7a7c5feb-fa0c-5d81-5e9c-37665926c2af
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Torturers_BrokeNose(2) = True
#. SetFlags:
#.   Dialog:
#.     - GOB_Torturers_Assisted(2) = True
#.   Object:
#.     - GLO_PaladinOathbreaker_Event_BrokeOath(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:7a7c5feb-fa0c-5d81-5e9c-37665926c2af
msgctxt "h32075578g4a15g4f6eg909dg23541358c95b"
msgid "<i>Smash a club into his knee.</i>"
msgstr "<i>몽둥이로 그의 무릎을 내려친다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = 7acee106-0e0a-4cdc-e263-ce47a382c3ff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:7acee106-0e0a-4cdc-e263-ce47a382c3ff
msgctxt "h4b85bb2cg681eg4de0gbd34gdd77535ee46b"
msgid "Oh, I couldn't! N-not with an expert 'ere!"
msgstr "아아, 난 못하겠어! 전... 전문가가 지켜보는 앞에서는 무리야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = 7b0a6105-9c1e-ecf4-0f6f-b0b453757cef
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 3e0cc9b8-f2f1-bd11-5ff7-f347a649c9fc_MindHasBeenRead = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:7b0a6105-9c1e-ecf4-0f6f-b0b453757cef
msgctxt "ha569f1deg0da9g4bb7g9e98gb118540e7728"
msgid ""
"<i>No. NO! Why won't 'e speak?! The drow's gonna kill me if I can't make 'im "
"talk!</i>"
msgstr ""
"<i>안 돼. <b>안 돼</b>! 왜 말을 안 하는 거야?! 빨리 털어놓게 하지 못하면 그 드로우년이 날 죽여버릴 거야!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Liam
#. NodeID = 7ce46d19-15b4-1321-f95c-d7fe2997b1f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:7ce46d19-15b4-1321-f95c-d7fe2997b1f3
msgctxt "h71c8a92eg64efg46b2ga426g858ce1911d36"
msgid "<i>Burn in every Hell.</i>"
msgstr "<i>모든 지옥에 떨어져서 불타 죽어.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = 7d725bbd-6436-d5d6-b4db-5b264e134749
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Torturers_BurnedThigh(2) = True
#. SetFlags:
#.   Dialog:
#.     - GOB_Torturers_Assisted(2) = True
