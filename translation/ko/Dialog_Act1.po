#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent02
#. Speaker = Player
#. NodeID = 0190acfa-f1f2-4008-b75e-9e37375d299a
#. HandlePath = TaggedText[0].TagText[0]
