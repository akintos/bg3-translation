msgctxt "h552cc21bga724g4ce8gb7e7g99e5e3e37c9e"
msgid "Eh? I'm busy. Watching, like."
msgstr "에? 난 바빠. 감시 같은 거 하는 중."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuardsWarning
#. Speaker = Goblin Sharp-Eye
#. NodeID = e698fb50-3977-773e-05d7-82d0b0af87cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuardsWarning:e698fb50-3977-773e-05d7-82d0b0af87cf
msgctxt "h2451d80cg3f3eg418ag9f46gcf796d28966d"
msgid "Oi! This town's ours."
msgstr "이봐! 이 마을은 우리 거라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_PAD_SpottedAmbush
#. Speaker = Player
#. NodeID = c29822c6-aeb2-fee4-59ee-6eb89b6f0468
