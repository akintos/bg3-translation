msgctxt "h344719eeg2e07g457bg8c77g56e34d024a35"
msgid "What is a 'True Soul'?"
msgstr "'참된 영혼'이 뭐지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestOfTheConqueringGod_Cultist002_Dead
