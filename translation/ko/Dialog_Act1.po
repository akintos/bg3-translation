msgctxt "h5409b58bg7dc5g41acga99dgebbe01f9613b"
msgid ""
"*The mark glows, but you feel nothing in response. Your illithid power is "
"beyond reach until you rest.*"
msgstr "*문양이 빛나지만, 어떤 반응도 느껴지지 않습니다. 일리시드 능력을 더 사용하려면 휴식을 취해야 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinSleeper_01
#. Speaker = Tracker Dullwill
#. NodeID = 36dda136-7fbf-fee4-12cf-72d06952befd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinSleeper_01:36dda136-7fbf-fee4-12cf-72d06952befd
msgctxt "hfdb3ef6eg6698g4c2fg8937g8265bfd1b8b5"
msgid "Yeah, yeah. But make another peep, and I'll clobber you."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinSleeper_01
#. Speaker = Narrator
#. NodeID = 3e4f2ea5-b993-fc87-57c3-26c9a9c954f9
