#.      - 47511dbb-8940-d871-bc7f-3238ecbf05da_b = False
#.      - 47511dbb-8940-d871-bc7f-3238ecbf05da_a = True
#.   Object:
#.      - DEN_DruidAttack_State_InPosition(0) = True
#. SetFlags:
#.   Local:
#.     - 47511dbb-8940-d871-bc7f-3238ecbf05da_b = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_DruidGuard1:e307148f-3627-a59f-b59d-58ba539989b2
msgctxt "h6c4e3795gb51bg4677g94e1ge1259b24af6f"
msgid "You should have left when you had the chance!"
msgstr "기회가 있을 때 떠났어야지!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_DruidLeader
#. Speaker = Kagha
#. NodeID = 2a211d6f-7694-80c6-8350-f519f1fdb304
