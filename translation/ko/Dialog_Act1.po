#.      - DEN_GroveConflict_State_DruidsPacified = True
#. SetFlags:
#.   Dialog:
#.     - DEN_RitualDruid_HasMet_Pacified5(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_RitualDruid5:bfb2bf2e-1d2b-5d23-4bdf-f641778f5551
msgctxt "h363f5051g5f6bg48cag85a0ga99831033f00"
msgid "Kagha was right. We must put ourselves first."
msgstr "카그하가 옳았어. 우리는 우리 자신을 우선시해야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_SacredPond_RitualDruid5
#. Speaker = Tahan
#. NodeID = ccf6b04e-d964-1a6c-e208-6aed5cad9466
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
