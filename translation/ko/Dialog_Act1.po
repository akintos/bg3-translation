msgctxt "had17138bgdf71g4097gac5bgeb335197edbc"
msgid "Who are you?"
msgstr "너는 누구지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7_Dead
#. Speaker = Gauntlet Dain
#. NodeID = c214de4b-80f8-45cc-9a4f-6c266900f22a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_Desire_Knows_RavengardTaken = True
#.   Quest:
#.     - PLA_GrandDukeRescue.LearnedDukeMissingSwD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7_Dead:c214de4b-80f8-45cc-9a4f-6c266900f22a
msgctxt "hcf8116bdg1a5cg4883g98d2gfffbf6ba1cee"
msgid "Searching... Grand Duke... Baldur's Gate... kidnapped..."
msgstr "수색... 발더스 게이트의... 대공작... 납치됐어..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7_Dead
#. Speaker = Narrator
#. NodeID = c38b5078-513c-49ed-a4c3-d0cfc616f037
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7_Dead:c38b5078-513c-49ed-a4c3-d0cfc616f037
msgctxt "h22aa7701gc07dg4fb1ga63egffdad0d88bbe"
msgid "*The spell's power wanes. You can ask no more questions.*"
msgstr "*주문의 힘이 약해집니다. 더 이상 질문을 할 수 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7_Dead
#. Speaker = Gauntlet Dain
#. NodeID = d7553053-2d0b-470f-8871-91f0a8f57d7d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 1a4691df-3492-5147-816e-14054d14774b_PLA_FlamingFist7Dead_FlorrickMentioned = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7_Dead:d7553053-2d0b-470f-8871-91f0a8f57d7d
msgctxt "he51c2f5fg2d9ag4e23g8c28g50e693446601"
msgid "Florrick... Ravengard's... confidante..."
msgstr "플로릭... 레이븐가드의... 최측근..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7_Dead
#. Speaker = Narrator
#. NodeID = dc531f93-868b-44bf-bc4e-419b068f93c1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_Killer(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7_Dead:dc531f93-868b-44bf-bc4e-419b068f93c1
msgctxt "h2ccdae2bg6fa8g4e52ga0d7g9b4d3e80537e"
msgid "*The corpse seems willing to speak - but not to its killer.*"
msgstr "*시체는 말할 의지가 있지만, 자신을 죽인 자와 대화하고 싶지는 않은 듯 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7_Dead
#. Speaker = Gauntlet Dain
#. NodeID = f224141c-9872-4762-b317-2b920076a40c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7_Dead:f224141c-9872-4762-b317-2b920076a40c
msgctxt "haed5c583gaa55g476bg8c14gf57b0cef2baa"
msgid "Drow... Underdark..."
msgstr "드로우... 언더다크..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8
#. Speaker = Player
#. NodeID = 2cad59ad-d548-6bac-0ef3-082f4e845f24
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8:2cad59ad-d548-6bac-0ef3-082f4e845f24
msgctxt "h237227fegc466g46cdg9ee6gd04239af43a1"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8
#. Speaker = Fist Recruit Tristan
#. NodeID = 485a84c0-2787-145d-ea17-b7d42412cadb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8:485a84c0-2787-145d-ea17-b7d42412cadb
msgctxt "h07899425g08c8g47cag902cg2bb7adc09688"
msgid "Barely. He was a new recruit."
msgstr "친분은 없지만, 이 녀석은 신참이었어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8
#. Speaker = Player
#. NodeID = 58c2e58a-97c7-9601-53ec-069c2bc1db29
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Quest:
#.      - PLA_ZhentShipment.Rewarded_ZhentReturned(1) = True
#.   User:
#.      - PLA_FlamingFists_Knows_ZhentDungeon(1) = False
#. SetFlags:
#.   User:
#.     - PLA_FlamingFists_Knows_ZhentDungeon(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8:58c2e58a-97c7-9601-53ec-069c2bc1db29
msgctxt "hb3ffd8a1gd858g41a0ga9d5g7f7692a0a0f3"
msgid ""
"There are Zhentarim nearby. They've got a hideout, and I know how to get in."
msgstr "근처에 젠타림이 있습니다. 은신처를 가지고 있는데, 제가 들어갈 방법을 알아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8
#. Speaker = Fist Recruit Tristan
#. NodeID = 74cc2372-bfe8-cbbe-5596-46734ed91159
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8:74cc2372-bfe8-cbbe-5596-46734ed91159
msgctxt "h099cd37fg2524g4a6cga13dg8f889cc76908"
msgid "Those who speak of the Zhent end up unable to speak."
msgstr "젠트에 대해 말하는 자들은 결국 말을 하지 못하게 되지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8
#. Speaker = Fist Recruit Tristan
#. NodeID = 77a87ca9-b152-d0f7-443f-cc27dcfb5daf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_FlamingFist8_InnBurntDown_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - PLA_FlamingFist8_InnBurntDown_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8:77a87ca9-b152-d0f7-443f-cc27dcfb5daf
msgctxt "h4ef89786g6b73g4f6ega5f8gc75bf9c431f1"
msgid "Gods, look what they did to him. That could've been me..."
msgstr "신들이시여, 놈들이 한 짓 좀 봐. 내가 이렇게 될 수도 있었다고..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8
#. Speaker = Fist Recruit Tristan
#. NodeID = 83ae55be-14c8-8f94-1560-287f2e0ab95f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_FlamingFist8_InnBurntDown_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8:83ae55be-14c8-8f94-1560-287f2e0ab95f
msgctxt "h99bce31fg10e8g4d42g96afg811ea05e6408"
msgid "Please, just go. There's nothing left to do but bury our dead."
msgstr "제발 그냥 가세요. 우리가 할 일은 죽은 이들을 묻는 것밖에 없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8
#. Speaker = Fist Recruit Tristan
#. NodeID = 8708006a-8e60-762a-39d0-0cdfbf02dc85
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_FlamingFist7_State_Permadefeated = False
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8:8708006a-8e60-762a-39d0-0cdfbf02dc85
msgctxt "h8306bdacg67f1g422egaf69g93ab66cd5617"
msgid "You should talk to Gauntlet Dain. She's in charge."
msgstr "건틀릿 디안에게 얘기해 보세요. 그녀가 책임자니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8
#. Speaker = Fist Recruit Tristan
#. NodeID = 8fd35c30-a237-d52e-f0fd-53511c1b68ee
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   User:
#.     - PLA_TavernInvestigation_Knows_AskedStelmane(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8:8fd35c30-a237-d52e-f0fd-53511c1b68ee
msgctxt "hbeee34c4g2847g401ag889dg377ddb7827b7"
msgid "A massacre. Drow and goblins slaughtered them all."
msgstr "학살입니다. 드로우와 고블린들이 다 죽여 버렸어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8
#. Speaker = Fist Recruit Tristan
#. NodeID = a4d80097-800d-56a0-9c7f-7372e20f8a36
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8:a4d80097-800d-56a0-9c7f-7372e20f8a36
msgctxt "ha9333411gc7e6g48b1gb456g070efa6c2e8f"
msgid "My advice - shut up."
msgstr "내 조언해 주지. 입 닥쳐요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8
#. Speaker = Fist Recruit Tristan
#. NodeID = b8871aa5-a006-d963-8e04-5d4d193ff800
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8:b8871aa5-a006-d963-8e04-5d4d193ff800
msgctxt "h15563c6eg394bg40b4gbaefgf3a73757543f"
msgid "But he was a Flaming Fist. That made us better than brothers."
msgstr "그는 플레이밍 피스트였어요. 형제나 다름없었다는 뜻이지요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8
#. Speaker = Fist Recruit Tristan
#. NodeID = c1ad5495-79ac-ef0a-7aab-91954aa884ef
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_FlamingFist7_State_Permadefeated = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8:c1ad5495-79ac-ef0a-7aab-91954aa884ef
msgctxt "hfe51e2fag4816g42a3g9a94g323f3668a1ba"
msgid "... even our Gauntlet. Thought she'd outlive us all."
msgstr "... 우리 건틀릿마저 죽었지. 우리 모두보다 오래 살아남을 줄 알았는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist8
#. Speaker = Player
#. NodeID = cc47dda0-5cda-dcec-8086-5c81d63622da
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentDungeon_Event_Setup = True
#.   Quest:
#.      - PLA_ZhentShipment.Rewarded_ZhentReturned(1) = False
