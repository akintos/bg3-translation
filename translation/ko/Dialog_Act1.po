msgctxt "hc7c19d37ge3cfg426fga3fbg8c19956a578e"
msgid ""
"Just a bit of slag - but that <i>glimmer</i>. A touch of adamantine, I "
"daresay."
msgstr "그저 약간의 찌꺼기일 뿐이지만, 그 <i>빛</i>은. 아마도 약간의 아다만틴일지도 모르겠는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_DuergarCamp_PAD_FoundAdamantine
#. Speaker = Player
#. NodeID = 593cfe72-d600-fa58-4d7d-bcde379328fd
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_DuergarCamp_State_AdamantineKnowledge = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_DuergarCamp_PAD_FoundAdamantine:593cfe72-d600-fa58-4d7d-bcde379328fd
msgctxt "h5bd1c669gdb0fg4e87g8056g363cf630d150"
msgid "Those glimmering specks... that's adamantine, I'll wager."
msgstr "그 반짝이는 반점들... 아다만틴이겠지, 내기해도 좋아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_DuergarCamp_PAD_FoundAdamantine
#. Speaker = Player
#. NodeID = 593cfe72-d600-fa58-4d7d-bcde379328fd
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_DuergarCamp_State_AdamantineKnowledge = True
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_DuergarCamp_PAD_FoundAdamantine:593cfe72-d600-fa58-4d7d-bcde379328fd
msgctxt "hd3ed2cf3gba9dg4d84g9637gba263b10b7da"
msgid ""
"Hmm... something shiny in this stuff. Bits of adamantine, most like - "
"hardest stuff in the world."
msgstr "흐음... 여기 뭔가 반짝이는 게 있어. 아다만틴 부스러기인 것 같은데, 세상에서 가장 단단한 물질이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_DuergarCamp_PAD_FoundAdamantine
#. Speaker = Player
#. NodeID = 593cfe72-d600-fa58-4d7d-bcde379328fd
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_DuergarCamp_State_AdamantineKnowledge = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_DuergarCamp_PAD_FoundAdamantine:593cfe72-d600-fa58-4d7d-bcde379328fd
msgctxt "h0dfc21f5gd96dg4611ga552g2c5bba5b2e0d"
msgid "Are those... specks of adamantine in this slag?"
msgstr "저거... 이 광재에 아다만틴 얼룩이 있는 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_DuergarCamp_PAD_FoundAdamantine
#. Speaker = Player
#. NodeID = 7de55770-7a50-4500-8840-ccbca0cbd44b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_DuergarCamp_State_AdamantineKnowledge = False
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_DuergarCamp_PAD_FoundAdamantine:7de55770-7a50-4500-8840-ccbca0cbd44b
msgctxt "h1c43076bg6f15g4666g83a8g58dbad9af2b7"
msgid "Something's sparkling in there, but it's mostly slag."
msgstr "뭔가 반짝이는 게 있긴 한데, 대부분은 찌꺼기야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_DuergarCamp_PAD_FoundAdamantine
#. Speaker = Player
#. NodeID = 7de55770-7a50-4500-8840-ccbca0cbd44b
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_DuergarCamp_State_AdamantineKnowledge = False
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_DuergarCamp_PAD_FoundAdamantine:7de55770-7a50-4500-8840-ccbca0cbd44b
msgctxt "hf253d9f3g785dg4666g9e3eg57e6a8f060f9"
msgid ""
"There are speckles of... something or other in this slag. Could be anything."
msgstr "뭔가 반짝거리는데... 뭔가 이 광재에 다른 것이 있어. 뭔지는 모르겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_DuergarCamp_PAD_FoundAdamantine
#. Speaker = Player
#. NodeID = 7de55770-7a50-4500-8840-ccbca0cbd44b
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_DuergarCamp_State_AdamantineKnowledge = False
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_DuergarCamp_PAD_FoundAdamantine:7de55770-7a50-4500-8840-ccbca0cbd44b
msgctxt "h968bee67g9ee0g4ba4gb40cgdeb01cc75352"
msgid "Pretty speckles. But not worth much, I think."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_DuergarCamp_PAD_FoundAdamantine
#. Speaker = Player
#. NodeID = 7de55770-7a50-4500-8840-ccbca0cbd44b
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_DuergarCamp_State_AdamantineKnowledge = False
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_DuergarCamp_PAD_FoundAdamantine:7de55770-7a50-4500-8840-ccbca0cbd44b
msgctxt "h7fe1b661g65b8g4a4cg958fg120c6da4dee1"
msgid "Speckled bit of slag. Useless."
msgstr "얼룩투성이 광재라. 쓸모 없네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_DuergarCamp_PAD_FoundAdamantine
#. Speaker = Player
#. NodeID = 7de55770-7a50-4500-8840-ccbca0cbd44b
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_DuergarCamp_State_AdamantineKnowledge = False
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_DuergarCamp_PAD_FoundAdamantine:7de55770-7a50-4500-8840-ccbca0cbd44b
msgctxt "h3233e0edg7f3dg4a5fgba75gdf409ee46636"
msgid "Glimmering specks in that slag. Hardly worth the trouble of mining."
msgstr "저 광재에 반짝이는 얼룩이 있어. 파볼 가치는 없겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_DuergarCamp_PAD_FoundAdamantine
#. Speaker = Player
#. NodeID = 7de55770-7a50-4500-8840-ccbca0cbd44b
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_DuergarCamp_State_AdamantineKnowledge = False
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_DuergarCamp_PAD_FoundAdamantine:7de55770-7a50-4500-8840-ccbca0cbd44b
msgctxt "hd26f559cg6c86g43e2g95b8gab5ddd6ddbc0"
msgid "Hunk of metal with shiny flecks. Hardly a collector's item."
msgstr "반짝이는 얼룩이 있는 철 조각이라. 수집품과는 거리가 머네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_DuergarCamp_PAD_FoundAdamantine
#. Speaker = Player
#. NodeID = 7de55770-7a50-4500-8840-ccbca0cbd44b
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_DuergarCamp_State_AdamantineKnowledge = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_DuergarCamp_PAD_FoundAdamantine:7de55770-7a50-4500-8840-ccbca0cbd44b
msgctxt "h55290f5egd941g457cgb5a9g8fa7480e0d4a"
msgid "Not much use for this slag. Nice speckles, though."
msgstr "이 슬래그는 별로 쓸모 없겠어. 광석이 박힌 게 근사하긴 하네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_DuergarCamp_PAD_HarperPin
#. Speaker = Player
#. NodeID = 6a26e383-a2af-480a-8bf4-32f0f9939cc6
