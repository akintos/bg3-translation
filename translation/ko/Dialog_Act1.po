#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_ElevatorBear:aff3e8a8-051b-2988-b317-4bc37aec8334
msgctxt "hc3335111gffc5g48b8g90ecg7e90717ca5db"
msgid "Hmmm...? I'm... sleeping..."
msgstr "흐으음...? 나는 자고 있어..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_ElevatorBear
#. Speaker = Tuffet
#. NodeID = b38f569f-cef4-2342-9692-4aac8f872862
