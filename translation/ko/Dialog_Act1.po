msgctxt "h85785fe1gc286g40acgbd5bga3c57cfbe5ba"
msgid "What the...? Our birdy just <i>flew away!</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_UnfortunateGnome_SlowDown
#. Speaker = Goblin Tracker
#. NodeID = a1815abf-462f-4529-027b-b4de1309f16a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_UnfortunateGnome_SlowDown:a1815abf-462f-4529-027b-b4de1309f16a
msgctxt "h9e8a0c79gf213g4f2fg8d77gaa7cefb1b70f"
msgid "Right. Will get it sorted."
msgstr "알겠습니다. 처리하겠습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_UnfortunateGnome_TiedUp
