msgctxt "hb9383df1g738bg468agb780gcc1cdd706198"
msgid "Off to find someone else to ensnare in her dealings, no doubt."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_PAD_Fled
#. Speaker = Player
#. NodeID = 4a216a17-743c-7b91-3009-705fb384d184
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_PAD_Fled:4a216a17-743c-7b91-3009-705fb384d184
msgctxt "ha339ab35g0402g4606gb1f0gb98f6ba2235d"
msgid "I wonder where she's gone off to."
msgstr "그녀가 어디로 사라진 건지 궁금하군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_PAD_Fled
#. Speaker = Player
#. NodeID = 4a216a17-743c-7b91-3009-705fb384d184
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_PAD_Fled:4a216a17-743c-7b91-3009-705fb384d184
msgctxt "hab51bb0fg993eg4199gb647gaaab78118cd6"
msgid "Where has she gone, I wonder?"
msgstr "그녀가 어디로 갔을까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_PAD_Fled
#. Speaker = Player
#. NodeID = 6924b376-74a5-73e5-cb76-678748ba5d65
