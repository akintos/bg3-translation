msgctxt "hcf432d4cga861g4f2bga988g67fb9505f3c8"
msgid "<i>Follow the doctor's instruction. Seek the tadpole.</i>"
msgstr "<i>의사의 지침을 따른다. 올챙이를 수색한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
