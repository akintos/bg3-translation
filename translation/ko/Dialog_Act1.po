#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_ASTARION(4) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/AstralPlane/CRE_AstralPrison_DaisyCaveEntrance:f86d9f87-6a57-470e-9d2a-266668be9b68
msgctxt "hf15d68dfg31efg4b99g8ad9g2f0200abf0c9"
msgid "Oh, don't look at me. That is all yours."
msgstr "오, 난 신경 쓰지 말고. 잘 해봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/AstralPlane/CRE_AstralPrison_Entering
#. Speaker = Narrator
#. NodeID = 02b121da-62ed-8375-a428-759dc780469c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/AstralPlane/CRE_AstralPrison_Entering:02b121da-62ed-8375-a428-759dc780469c
msgctxt "h79d4cc50gd312g423eg9746gae042525015c"
msgid ""
"*A timeless space, bounded, compressed in a fold - a pocket of Astral Plane.*"
msgstr "*접힌 형태로 압축된, 무한한 시간 속 한정된 영역. 아스트랄 차원의 주머니 공간.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/AstralPlane/CRE_AstralPrison_Entering
#. Speaker = Narrator
#. NodeID = 31392847-62f8-964d-f389-73c2b43289b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/AstralPlane/CRE_AstralPrison_Entering:31392847-62f8-964d-f389-73c2b43289b6
msgctxt "h8f3143fege13cg4deeg95b1g3993d569f27f"
msgid ""
"*The concentration of psionic force is small but unmistakable - this must be "
"a pocket of the Astral Plane.*"
msgstr "*사이오닉 힘의 농도는 옅지만 확실합니다. 이곳은 아스트랄 차원의 주머니 공간임에 틀림없습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/AstralPlane/CRE_AstralPrison_Entering
#. Speaker = Karlach
#. NodeID = 3a94ae36-0f61-4dbe-9e0f-598dffa9805a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(3) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/AstralPlane/CRE_AstralPrison_Entering:3a94ae36-0f61-4dbe-9e0f-598dffa9805a
msgctxt "hded02da9g0a0cg4e2fga4beg951fce524934"
msgid "It's... beautiful. Gods, what a sight."
msgstr "정말... 아름다워. 맙소사, 이 광경 좀 봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/AstralPlane/CRE_AstralPrison_Entering
#. Speaker = Gale
#. NodeID = 3dcab01a-56f8-c5c7-d5e1-8d99f2174444
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GALE(6) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/AstralPlane/CRE_AstralPrison_Entering:3dcab01a-56f8-c5c7-d5e1-8d99f2174444
msgctxt "h0265f64bg9551g4db7g932cgd76b6cf37f05"
msgid "Quite an oddity to behold... but not without beauty, either."
msgstr "겉보기엔 제법 기이한 모습이지만... 그런대로 아름답군 그래."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/AstralPlane/CRE_AstralPrison_Entering
#. Speaker = Shadowheart
#. NodeID = 420c3ebd-12cc-8d16-1a97-5b64b3b2f8d1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(2) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/AstralPlane/CRE_AstralPrison_Entering:420c3ebd-12cc-8d16-1a97-5b64b3b2f8d1
msgctxt "h7ee3f7b5gf622g4a4fg813bgece27f2708c0"
msgid "It's quite beautiful - though dangerous things often are."
msgstr "제법 아름다운 광경이네. 위험한 것들이 대부분 그렇지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/AstralPlane/CRE_AstralPrison_Entering
#. Speaker = Narrator
#. NodeID = 50809da1-ca20-4d85-a8c8-d82da37f0f35
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_AstralPrison_State_BoxUnlocked = True
#: Mods/GustavDev/Story/Dialogs/Act1b/AstralPlane/CRE_AstralPrison_Entering:50809da1-ca20-4d85-a8c8-d82da37f0f35
msgctxt "h2c987b9bga219g4a63g895cgcecbc1fd87a2"
msgid "*Your mind burns hot with excitement.*"
msgstr "*당신의 정신이 흥분으로 달아오릅니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/AstralPlane/CRE_AstralPrison_Entering
#. Speaker = Lae'zel
#. NodeID = 5081ae2c-d56f-4aad-96f5-9b6a21be849e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/AstralPlane/CRE_AstralPrison_Entering:5081ae2c-d56f-4aad-96f5-9b6a21be849e
msgctxt "hf2f0af3cg19deg4f98g9c2ag59274a7202f7"
msgid ""
"Incredible - space, unfettered from time. The Astral Plane, just as I've "
"dreamt it."
msgstr "놀랍군. 시간을 초월한 공간이야. 아스트랄 차원, 내 꿈이 틀리지 않았다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/AstralPlane/CRE_AstralPrison_Entering
#. Speaker = Narrator
#. NodeID = 511dd75c-9151-4a1c-b304-0d9054530717
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/AstralPlane/CRE_AstralPrison_Entering:511dd75c-9151-4a1c-b304-0d9054530717
msgctxt "hfa2f9daag7699g44a9ga5f5gde3e4337061a"
msgid "*Heat pulses out of the Astral Prism as it begins to <i>flower</i>.*"
msgstr "*아스트랄 프리즘이 <i>꽃피기</i> 시작하자 열기가 뿜어져 나옵니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/AstralPlane/CRE_AstralPrison_Entering
#. Speaker = Lae'zel
#. NodeID = 56fbdb28-d1f2-c795-7005-34faeb06ef43
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/AstralPlane/CRE_AstralPrison_Entering:56fbdb28-d1f2-c795-7005-34faeb06ef43
msgctxt "h40a30c7egfa22g481dg8475g1b299dd639ad"
msgid ""
"Boundless, timeless - like every dream that ever was, stitched together. It "
"is home."
msgstr "경계도, 시간도 무색하다. 과거의 모든 꿈이 한데 꿰어진 것 같아. 고향에 왔군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/AstralPlane/CRE_AstralPrison_Entering
#. Speaker = Wyll
#. NodeID = 5e2c1de2-01ec-4734-9ffa-ff5780974a33
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(5) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/AstralPlane/CRE_AstralPrison_Entering:5e2c1de2-01ec-4734-9ffa-ff5780974a33
msgctxt "ha0e6c814gf22cg47d5gbfadg46c7397f8a3e"
msgid "Extraordinary - like a waking dream. Where have we gotten to?"
msgstr "비상한 광경이군. 백일몽을 꾸고 있는 기분이야. 어디까지 와버린 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/AstralPlane/CRE_AstralPrison_Entering
#. Speaker = Wyll
#. NodeID = 764c028b-ec86-f3bc-1b33-084db907d3c0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_WYLL(5) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/AstralPlane/CRE_AstralPrison_Entering:764c028b-ec86-f3bc-1b33-084db907d3c0
msgctxt "hd0f0bd71g6253g4789gb92fg78e539f63239"
msgid "Incredible. It feels like nowhere and everywhere, all at once."
msgstr "놀랍네, 마치 어디에도 없고 어디에나 있는 기분이야. 동시에 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/AstralPlane/CRE_AstralPrison_Entering
#. Speaker = Narrator
#. NodeID = 7c74b18c-327f-60b3-1a45-85d908a53208
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/AstralPlane/CRE_AstralPrison_Entering:7c74b18c-327f-60b3-1a45-85d908a53208
msgctxt "h12cde349gd314g48ddgb61agaaa406ff4206"
msgid ""
"*The place is expansive, beautiful, but unfamiliar. Could all this have fit "
"inside the artefact?*"
msgstr "*이 공간은 광활하고 아름답지만 낯섭니다. 이 모든 것이 어떻게 아티팩트 안에 들어 있었던 걸까요?*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/AstralPlane/CRE_AstralPrison_Entering
#. Speaker = Shadowheart
#. NodeID = aa029153-b34d-4c3e-91d5-7c7eacd2b6ac
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(2) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/AstralPlane/CRE_AstralPrison_Entering:aa029153-b34d-4c3e-91d5-7c7eacd2b6ac
msgctxt "h3129ebccg5498g47c2g8cdcg219a4f827a55"
msgid "Quite a sight. Though I'm not quite sure <i>what </i>sight exactly."
msgstr "장관이네. 정확히 <i>어떤</i> 광경인지는 모르겠지만 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/AstralPlane/CRE_AstralPrison_Entering
#. Speaker = Karlach
#. NodeID = b5d1c0ae-3ca0-f320-73d2-12a1ab6c24c7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_KARLACH(3) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/AstralPlane/CRE_AstralPrison_Entering:b5d1c0ae-3ca0-f320-73d2-12a1ab6c24c7
msgctxt "heeb61a37gbfd5g49f0g9b6bgd0e7018b0527"
msgid "Can't believe what I'm seeing. This place is beautiful."
msgstr "내 눈을 믿을 수가 없군. 이곳은 정말이지 아름다워."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/AstralPlane/CRE_AstralPrison_Entering
#. Speaker = Narrator
#. NodeID = c3bb6acf-a18c-b448-c487-7cb5c37c5e56
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(0) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/AstralPlane/CRE_AstralPrison_Entering:c3bb6acf-a18c-b448-c487-7cb5c37c5e56
msgctxt "hf0bcc155g5214g4595g9202g4ecf16786ca9"
msgid ""
"*A feeling of belonging stirs within you - a fold in reality, a pocket of "
"the Astral Plane.*"
msgstr "*소속감이 내면에서 꿈틀거립니다. 현실의 접힌 부분, 아스트랄 차원의 주머니 공간.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/AstralPlane/CRE_AstralPrison_Entering
#. Speaker = Gale
#. NodeID = ca54cfe3-8699-461a-be7b-8d79b9e8b334
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GALE(6) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/AstralPlane/CRE_AstralPrison_Entering:ca54cfe3-8699-461a-be7b-8d79b9e8b334
msgctxt "h7f69dbb1g9fc6g4973g9eacgde0e694471b0"
msgid "Well this is new."
msgstr "음, 신선한 경험인데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/AstralPlane/CRE_AstralPrison_Entering
#. Speaker = Astarion
#. NodeID = d0662dfd-d625-45c3-b115-ece62af78660
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_ASTARION(4) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/AstralPlane/CRE_AstralPrison_Entering:d0662dfd-d625-45c3-b115-ece62af78660
msgctxt "h952aed67g7459g4613g8d38g8a1bebf44ece"
msgid "Well this is... different."
msgstr "오호라, 이건 좀... 색다른걸."

