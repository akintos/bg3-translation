msgctxt "h6a3949d0gfe85g4138gbcaeg9ba1ff51fd7d"
msgid "<i>Turn around to see what he's looking at.</i>"
msgstr "<i>그가 보고 있는 것을 향해 고개를 돌린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_GruntingKid
#. Speaker = Player
#. NodeID = da0ec023-0464-1916-d0fd-d62ea80277cb
#. HandlePath = TaggedText[0].TagText[0]
