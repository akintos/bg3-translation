msgctxt "h6674b9d5gdaf9g4457gad44g4219986e262f"
msgid "Looks like fun - can I play?"
msgstr "재밌어 보여 - 나도 할 수 있어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain
#. Speaker = Zel'i
#. NodeID = 74e0f9ea-7a2b-e235-4608-1febce501507
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain:74e0f9ea-7a2b-e235-4608-1febce501507
msgctxt "ha5ef9331ge48dg48d5g887bgb897aab5f709"
msgid "Hmm... no."
msgstr "흐음... 싫어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain
#. Speaker = Zel'i
#. NodeID = 7d5f7789-b005-344b-2f57-76f9b62df460
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain:7d5f7789-b005-344b-2f57-76f9b62df460
msgctxt "h97aaa734geb5ag4684g9a75gb5b08471b84f"
msgid "No need to be <i>mean</i>. We can be nice, can't we Ra'jak?"
msgstr "<i>신경질</i> 낼 필요 없잖아. 친절해질 수 있잖아, 안 그래 라자크?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain
#. Speaker = Player
#. NodeID = 81c83b37-cc97-e92d-ac8e-92bd3b24974f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain:81c83b37-cc97-e92d-ac8e-92bd3b24974f
msgctxt "hc07a1f9eg93cag45a5g90dfg74fa83e9c1e3"
msgid "Hmm - yes. Stop it. Let that thing out."
msgstr "흠. 멈춰. 꺼내줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain
#. Speaker = Ra'jak
#. NodeID = 836aa32d-2258-708d-569a-685aa06beac9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CRE_MageHandGame_Event_PlayerInterferesWithGame(3) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain:836aa32d-2258-708d-569a-685aa06beac9
msgctxt "h5001e035g28bag4b47g8925gbcc4a79a8bd1"
msgid "Yeah! Fun!"
msgstr "그래! 재미!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain
#. Speaker = Player
#. NodeID = 871fc546-27e1-00ab-1be6-3eb8ca56d68a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain:871fc546-27e1-00ab-1be6-3eb8ca56d68a
msgctxt "hccd9f9a0g6587g4323g9758gae7bcb935161"
msgid "By the gods, you're annoying. Just pack it in, will you?"
msgstr "맙소사, 넌 짜증나. 그냥 넣어둬, 알았어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain
#. Speaker = Player
#. NodeID = 9126eedb-56fc-bd1c-f1dd-4ef70992c74a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
