msgctxt "h38606731g2128g4172g9480geef16629f458"
msgid "I'm not an enemy, I promise."
msgstr "난 적이 아니야. 약속할게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Scratch
#. NodeID = 7be6fa5b-6761-d402-a626-02933b86287e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:7be6fa5b-6761-d402-a626-02933b86287e
msgctxt "h1857d8eegd27dg40cag8cb1gdcd922c30722"
msgid "He's not my clan. He's my <i>friend</i>."
msgstr "그는 내 가족이 아니야. 내 <i>친구</i>지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Scratch
#. NodeID = 861f5a48-ba61-9194-c1ff-298c4408d761
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_Courier_State_DogCalm = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:861f5a48-ba61-9194-c1ff-298c4408d761
msgctxt "ha14afedbge61fg4d83ga625g34a429ecd85a"
msgid "You know my name? Interesting - a predator wouldn't care to learn it."
msgstr "내 이름을 알아? 신기하네, 포식자라면 그런 걸 알아볼 생각도 하지 않을 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Narrator
#. NodeID = 863f6d20-a79e-fcdb-055b-2338ab382bfe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:863f6d20-a79e-fcdb-055b-2338ab382bfe
msgctxt "hd28f1ebegfc61g4782g8b66gad7f61ebb16c"
msgid "*He whines, but remains rooted by the corpse's side.*"
msgstr "*녀석은 훌쩍이지만, 여전히 사체의 곁을 떠나지 않습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Scratch
#. NodeID = 8979e19f-b847-0e49-b6ef-0abb8caf8e10
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_Courier_State_DogCalm = True
#.      - FOR_Courier_State_DogPlayful = False
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:8979e19f-b847-0e49-b6ef-0abb8caf8e10
msgctxt "h635ae53dge732g4c35g913dg39b6be3317d3"
msgid "Please, let him rest."
msgstr "제발, 그가 편히 쉬게 해줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Narrator
#. NodeID = 8d00d86b-32fd-05ca-a394-483a64b9d575
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - FOR_CourierDog_State_AnimalHandlingFailed(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog:8d00d86b-32fd-05ca-a394-483a64b9d575
msgctxt "hce373997g8faag4059g9d33g2dbeeb6da143"
msgid "*The dog's hackles raise.*"
msgstr "*개의 털이 곤두섭니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Player
