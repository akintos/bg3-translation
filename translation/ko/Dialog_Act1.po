msgctxt "hea0152a7g21b1g4c85gab63g2550074c9dce"
msgid "Timmask! The spores confuse the senses."
msgstr "티마스크야! 포자가 감각을 혼란스럽게 하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_PAD_MushroomClearingNatureCheck
#. Speaker = Player
#. NodeID = ef6ed145-adad-baf5-0d7c-d1abee5f9722
