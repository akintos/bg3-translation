msgctxt "hbd3d533bgb4e9g4bb7g8445g40e0cbbc425f"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim3
#. Speaker = Mask of Vengeance
