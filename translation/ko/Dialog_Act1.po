msgctxt "h07392871gcc8dg462cgbfe4gcc1c87079547"
msgid "*The corpse seems willing to speak - but not to its killer.*"
msgstr "*시체는 말할 의지가 있지만, 자신을 죽인 자와 대화하고 싶지는 않은 듯 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DeadMyconid_Dead
#. Speaker = Player
#. NodeID = 4e427b5f-44cf-6227-924a-10844a3acd5e
