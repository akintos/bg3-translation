#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. 
#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Player
#. NodeID = beb75975-b0d5-22d0-09fc-dd276ccbe8a5
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. 
#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp
#. Speaker = Player
#. NodeID = d15c5e78-1ac3-bb30-f58d-6456d1b1460d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:5b1cb59e-9b06-b25c-a62b-03fd33d4e7fc
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_FollowUp:f59a7807-eb77-1fbf-252c-9d372c489c79
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:beb75975-b0d5-22d0-09fc-dd276ccbe8a5
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp:d15c5e78-1ac3-bb30-f58d-6456d1b1460d
msgctxt "h7e20e935gd7a8g4a72g9a9agd73abd27cf2e"
msgid "Let the gnomes go. They'll just slow you down."
msgstr "노움들을 보내 줘. 너희 발목만 잡을 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_FollowUp
#. Speaker = Elder Brithvar
#. NodeID = f711e110-220f-663b-638b-ee38c9fcf9b5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_FollowUp:f711e110-220f-663b-638b-ee38c9fcf9b5
msgctxt "h22428f6cgec1bg4018gbdb3g09faae1ba9f6"
msgid "Born to serve, my father said. I'll keep 'em busy."
msgstr "놈들은 봉사하기 위해 태어난 거라고 아버지께서 그러셨지. 계속 굴려먹도록 하겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_FollowUp
#. Speaker = Player
#. NodeID = fba9d57d-2e24-18ca-7480-21546ac69fb8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_FollowUp:fba9d57d-2e24-18ca-7480-21546ac69fb8
msgctxt "h28629a19g9149g403cga49egce09f128a626"
msgid "Good idea. They're a valuable asset."
msgstr "좋은 생각이군. 저들은 소중한 자산이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp
#. Speaker = Kirgrath
#. NodeID = 06f68204-b9a5-f905-31af-a64824964d06
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp:06f68204-b9a5-f905-31af-a64824964d06
msgctxt "he957b47eg94d6g4dc8ga64bgdc3b4c09ed2b"
msgid "They belong to the clan. They're coming with us."
msgstr "노예들은 일족의 소유물이다. 우리와 함께 간다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp
#. Speaker = Kirgrath
#. NodeID = 0b8bad49-6ca1-349f-d366-7ffe5fe3f0e9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp:0b8bad49-6ca1-349f-d366-7ffe5fe3f0e9
msgctxt "he7bde62aga5b5g465bg8d90g925395271ed1"
msgid "It's time I scram, before the buggers at Moonrise charge in."
msgstr "이제 갈 시간이군. 문라이즈 새끼들이 쳐들어오기 전에 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp
#. Speaker = Karlach
#. NodeID = 167dc1e6-a4fc-83b6-b45a-b7daeaf0169a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp:167dc1e6-a4fc-83b6-b45a-b7daeaf0169a
msgctxt "h69b67ab5g2f4dg4b2ag95bdgdac93727fc34"
msgid ""
"Yeah, right. No chance we're letting those bastards take the gnomes with "
"them. Right?"
msgstr "맞아. 저 새끼들이 노움들을 데려가게 두진 않을 거야. 그치?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp
#. Speaker = Player
#. NodeID = 1b666d82-9f27-0b88-322c-f4c76f1a5e8a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Moonrise_Knows_AbsoluteAtGrymforge = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp:1b666d82-9f27-0b88-322c-f4c76f1a5e8a
msgctxt "h882f115bg5e8fg4143ga842g0f2b9f9a2176"
msgid "What makes Moonrise Towers such a threat?"
msgstr "문라이즈 타워가 그토록 큰 위협인 이유가 뭐야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp
#. Speaker = Player
#. NodeID = 1eb8f624-f8ad-6915-2670-e66eda8e1e6f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_GnomeWorkers_State_PermaDefeated = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp:1eb8f624-f8ad-6915-2670-e66eda8e1e6f
msgctxt "h5ce86d15g1d7bg480aga747g6aebc6230c78"
msgid "And the slaves? What about them?"
msgstr "노예들은 어쩌고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp
#. Speaker = Kirgrath
#. NodeID = 1ee3b234-9858-6321-233f-e3c88e30670b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_State_LeaderFreedGnomes = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp:1ee3b234-9858-6321-233f-e3c88e30670b
msgctxt "hc8341219g4a5dg4bc5gb3f3gd698b361c4a5"
msgid ""
"You're free, squatties. Get your legs moving, before I change my damn mind."
msgstr "너흰 자유야, 난쟁이들아. 내가 마음을 바꾸기 전에 빨리 움직이라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp
#. Speaker = Kirgrath
#. NodeID = 2a42e1f7-fe16-6d5b-c8be-b096b9b9ca21
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp:2a42e1f7-fe16-6d5b-c8be-b096b9b9ca21
msgctxt "h6676d701g0a4cg43a1ga18dgf4077f36882e"
msgid "Damn right. We'll keep them busy - this isn't their last dig."
msgstr "그럼. 바쁘게 굴려야지. 이번이 마지막 채굴은 아니니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp
#. Speaker = Kirgrath
#. NodeID = 39536318-a2cf-eaac-5f40-6e706ae6bc53
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp:39536318-a2cf-eaac-5f40-6e706ae6bc53
msgctxt "hc85198d0gdf54g45e3g96edg1c846115e0e2"
msgid "Some General up there giving the orders, the way Nere told it."
msgstr "니어 말에 따르면 그곳의 어떤 장군이 명령을 내리고 있대."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp
#. Speaker = Player
#. NodeID = 3d6be223-775c-2139-68db-281cd067142f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp:3d6be223-775c-2139-68db-281cd067142f
msgctxt "h818bec0fga43dg4691g937bg34a1d877e597"
msgid "Good idea. I'll start by adding your corpse to the pile."
msgstr "좋은 생각이야. 네 시체를 제일 먼저 털어주도록 하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp
#. Speaker = Kirgrath
#. NodeID = 415822db-a57b-1808-d23a-7ba91be4d65e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp:415822db-a57b-1808-d23a-7ba91be4d65e
msgctxt "h2f2b8672g3fddg4f28g8fe9gb756feafc4fe"
msgid "Figured you wouldn't."
msgstr "그럴 줄 알았지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp
#. Speaker = Player
#. NodeID = 46066f53-1c22-a9ba-fb53-e60c245c750c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_DuergarMutineers_Event_Leave = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp:46066f53-1c22-a9ba-fb53-e60c245c750c
msgctxt "hae298498g4ae2g41acg9070g0443bfc9654b"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp
#. Speaker = Kirgrath
#. NodeID = 4609d9e2-9d67-9a81-e141-389dba711913
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#.   Quest:
#.     - UND_GnomeRescue.HostileAgainstMutineers(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp:4609d9e2-9d67-9a81-e141-389dba711913
msgctxt "h240509e1g5cb6g4a59g8d40gde8b4071c902"
msgid "Go on, then. Been itching to cut you down a peg."
msgstr "그럼 해 보시든가. 널 썰고 싶어서 좀이 쑤시던 참인데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp
#. Speaker = Kirgrath
#. NodeID = 49504880-ebcc-eded-8658-31f96e08cef7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp:49504880-ebcc-eded-8658-31f96e08cef7
msgctxt "h2325a4cbgf56fg4d15gacd5g7a48683cade4"
msgid ""
"You might be right about that. The more bodies we got, the slower we move."
msgstr "네가 옳을지도. 머릿수가 많을수록 더 느려질테니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp
#. Speaker = Kirgrath
#. NodeID = 5cb86327-9b68-5808-c7a9-e598dc4cd9be
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp:5cb86327-9b68-5808-c7a9-e598dc4cd9be
msgctxt "h594ca0d3g4722g49dcg94d8g2fc3f8eb36ca"
msgid "My pocket's been picked. Try the cadavers - probably loaded with loot."
msgstr "주머니를 털렸어. 시체를 살펴봐. 뒤져 보면 갖고 있을걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp
#. Speaker = Wyll
#. NodeID = 623dd16d-16f5-bad7-1454-1927dca3d8e9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp:623dd16d-16f5-bad7-1454-1927dca3d8e9
msgctxt "heefe5737ga783g4916g8d31g71832b5f4d9f"
msgid "Your heart made of stone? They deserved freedom - and you denied it."
msgstr "네 심장은 돌이야? 노움들은 자유로워질 수 있는데, 네가 거부했다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp
#. Speaker = Player
#. NodeID = 6a9b6051-5311-82c2-a36b-738afef5a101
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_GnomeWorkers_State_PermaDefeated = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp:6a9b6051-5311-82c2-a36b-738afef5a101
msgctxt "h80682dccg60a8g4ec5ga1b0gf69a15a438e9"
msgid "Leave - and take the slaves with you. Before I change my mind."
msgstr "이제 가봐. 노예도 같이 데리고 가. 내 생각이 바뀌기 전에."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp
#. Speaker = Kirgrath
#. NodeID = 70e07c0b-6290-79eb-d4e5-983ad09928a6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_CheckPocketGold = True
#. SetFlags:
#.   Global:
#.     - UND_Mutineers_State_PaidPlayerReward = True
#.   Object:
#.     - GEN_TransferNPCPayment(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp:70e07c0b-6290-79eb-d4e5-983ad09928a6
msgctxt "hdcdb9935gd04dg4c44g8139g464d3bd7621d"
msgid ""
"Here's your cut. Just like Brithvar said. ([6057ad05-9492-4630-9f0a-"
"be548b134c54])"
msgstr "여기 너의 몫이다. 브리스바가 말한 대로. ([6057ad05-9492-4630-9f0a-be548b134c54])"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp
#. Speaker = Player
#. NodeID = 78f889c5-e90c-39aa-c424-ce62e13c9ea6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp:78f889c5-e90c-39aa-c424-ce62e13c9ea6
msgctxt "h8712d56fg7f26g439fg9e9eg7471e968a757"
msgid "Understood. I won't interfere."
msgstr "알았어. 간섭하지 않을게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp
#. Speaker = Gale
#. NodeID = 830ff512-c1d9-5abc-5a94-6c548aaf082c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp:830ff512-c1d9-5abc-5a94-6c548aaf082c
msgctxt "h9434874dg0537g42bdga268g1f6cd7056f12"
msgid ""
"The gnomes should be able to go where they please. They are not the "
"duergar's to keep."
msgstr "노움들은 가고 싶은 곳으로 갈 자유가 있어. 듀에르가가 붙잡아놓을 수는 없지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp
#. Speaker = Kirgrath
#. NodeID = 86a615f3-107a-1b34-f4f9-0780ce44a43a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp:86a615f3-107a-1b34-f4f9-0780ce44a43a
msgctxt "h2cf3976fg5541g433cg9515g421da9221f82"
msgid ""
"They got goblins, drow, gnolls, even humans - ain't no one they won't try to "
"turn. The clans included."
msgstr "거기엔 고블린, 드로우, 놀, 심지어 인간들도 있어 - 눈에 밟히는 대로 변이시키고 있다고. 일족도 포함해서 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp
#. Speaker = Player
#. NodeID = 95023bbb-6b67-d415-8593-8fa78e9da312
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_GnomeWorkers_State_PermaDefeated = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp:95023bbb-6b67-d415-8593-8fa78e9da312
msgctxt "h9787e8afga274g4b8bg9b3dg3ecaaafadfba"
msgid "Get moving. If I see you slavers again, I'll tear you apart."
msgstr "빨리 가봐. 너희 노예상들이 다시 내 눈에 띄면 갈갈이 찢어줄 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp
#. Speaker = Kirgrath
#. NodeID = 9cfe2ef9-2529-8595-068a-a961c11053d0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_DuergarMutineerFollowUp_Event_Happened = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp:9cfe2ef9-2529-8595-068a-a961c11053d0
msgctxt "hfe459b5eg8704g4ac6gb6f1g06b1a0a08050"
msgid "Shit. Brithvar's kicked the tankard. Prick was older than dirt."
msgstr "젠장. 브리스바가 다 망쳤군. 그 새끼는 늙어 빠진 녀석이었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp
#. Speaker = Wyll
#. NodeID = a31cce9c-c7e6-7ef8-b48b-8ef5cd2e4747
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp:a31cce9c-c7e6-7ef8-b48b-8ef5cd2e4747
msgctxt "h66211584g9594g4b2egbd9fg476519197e1b"
msgid "Speak up, chief. You can't just let the clan keep them."
msgstr "말 해, 대장. 그냥 저렇게 잡아가게 둘 수는 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp
#. Speaker = Karlach
#. NodeID = a60b8832-ec68-60e4-ef3c-b0af0d147ae3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp:a60b8832-ec68-60e4-ef3c-b0af0d147ae3
msgctxt "hf4107e5fg499bg4e0bga455g4567579dea1d"
msgid "Whoa. Who the fuck <i>are </i>you?"
msgstr "와. 너 대체 <i>누구야</i>?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp
#. Speaker = Player
#. NodeID = a8047a4c-8534-428b-7099-a914adaf0e31
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp:a8047a4c-8534-428b-7099-a914adaf0e31
msgctxt "h12e91b87g14c9g44fdgbe11g89b46acbcea9"
msgid "Very well. I'll rummage what I can."
msgstr "알겠어. 챙길 수 있는 건 다 가져갈게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp
#. Speaker = Kirgrath
#. NodeID = a9c9cf96-7138-adca-905d-c8992ddc7ae1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp:a9c9cf96-7138-adca-905d-c8992ddc7ae1
msgctxt "hb90d9124g461fg4752gb040g6e0140c4188e"
msgid "These shitheads aren't worth the hassle. You got yourself a deal."
msgstr "이 멍청이들은 입씨름할 가치도 없어. 좋아, 거래를 하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp
#. Speaker = Kirgrath
#. NodeID = a9d4152f-9c7c-8da8-fd35-fd7be396dbb2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp:a9d4152f-9c7c-8da8-fd35-fd7be396dbb2
msgctxt "hf6de6623g95f8g4f31ga7efga6d17a7c0cf5"
msgid ""
"Place is swarming with Absolute-buggers. And I ain't gonna mess about with "
"'em."
msgstr "거긴 절대자 신봉자들로 넘쳐나. 걔네랑은 절대 엮이지 않을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp
#. Speaker = Player
#. NodeID = aae752cd-23d3-90f8-f42e-7a27ae87f19a
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#. TagRule: BERSERKER
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp:aae752cd-23d3-90f8-f42e-7a27ae87f19a
msgctxt "h54c8b033gac8cg4db1g93d8ga4133b79eead"
msgid "Free the gnomes or <b>DIE. </b>You choose."
msgstr "노움을 풀어주든가 <b>죽든가.</b> 골라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp
#. Speaker = Player
#. NodeID = aae752cd-23d3-90f8-f42e-7a27ae87f19a
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp:aae752cd-23d3-90f8-f42e-7a27ae87f19a
msgctxt "hb95ecbd8g2202g47d2ga471gb551629a7b2c"
msgid "The gnomes go free. You live. Everyone wins. Clear?"
msgstr "노움은 풀려난다. 넌 산다. 다 잘 된다. 알았어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp
#. Speaker = Player
#. NodeID = b55a1ab6-a9ba-c941-ac70-f8e0e7328284
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_Mutineers_State_PaidPlayerReward = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp:b55a1ab6-a9ba-c941-ac70-f8e0e7328284
msgctxt "h31c7c9c9gbe45g48d0g997fg3f5b93b9c140"
msgid "And the gold you owe me?"
msgstr "골드는 주고 가야지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp
#. Speaker = Kirgrath
#. NodeID = b826e89c-1356-ebcc-5c81-3b229e3755b1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp:b826e89c-1356-ebcc-5c81-3b229e3755b1
msgctxt "hf4efb7fbgcc11g4a40g8acfgabdcba308088"
msgid "You <i>drugnin' </i>twat."
msgstr "이 <i>드루그닌</i> 새끼가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp
#. Speaker = Player
#. NodeID = c1911712-0f8b-56ba-b05b-a8c22bbae50f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp:c1911712-0f8b-56ba-b05b-a8c22bbae50f
msgctxt "h806de157ge554g44fbgba97g07f7909affac"
msgid "Good idea. They're a valuable asset."
msgstr "좋은 생각이군. 저들은 소중한 자산이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp
#. Speaker = Kirgrath
#. NodeID = c2e842eb-90e1-6b70-61bb-b2230892db1d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp:c2e842eb-90e1-6b70-61bb-b2230892db1d
msgctxt "h74f25ed7gb78dg4d06gb987g55ba9016d8dc"
msgid ""
"You think? I catch so much as a whiff of you, and I'll have you flayed and "
"fried up for dinner."
msgstr "그러셔? 네 녀석 그림자만 보여도 내가 가죽을 벗겨서 저녁으로 구워 먹을 줄 알아라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp
#. Speaker = Gale
#. NodeID = d1f15c95-eb93-89fb-f5ab-eca4dcce7e61
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp:d1f15c95-eb93-89fb-f5ab-eca4dcce7e61
msgctxt "h7d450b95g5cc6g401dgafeagd3c766318573"
msgid ""
"Brittle are the foundations upon which the houses of tyrants are built. It "
"seems I judged you to be less brittle than you really are."
msgstr "폭군들의 집이 세워지는 토대는 연약하지. 보아하니 내가 너를 덜 연약하다고 과대평가한 거 같네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp
#. Speaker = Kirgrath
#. NodeID = e11ebafd-d222-b727-0f74-1ed04c4d6176
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp:e11ebafd-d222-b727-0f74-1ed04c4d6176
msgctxt "h1ca11c50g14f9g447fg8db3gb6214580578c"
msgid "Get to it then."
msgstr "그럼 그렇게 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp
#. Speaker = Kirgrath
#. NodeID = e1486593-9816-2b0a-e29f-83a15ef2740f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_DuergarMutineers_Event_Leave = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp:e1486593-9816-2b0a-e29f-83a15ef2740f
msgctxt "h9d2efddeg2a75g4f9eg9e9dgb3293b9f2bfc"
msgid "Now move out of here - I got shit to be doing."
msgstr "이제 썩 사라져 버려. 난 할 일이 많아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp
#. Speaker = Player
#. NodeID = e3b2402e-4a84-26cf-7806-0f3fc836523c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_Mutineers_Event_FailedtoFreeGnomes = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp:e3b2402e-4a84-26cf-7806-0f3fc836523c
msgctxt "h1e68517eg050fg4402g9410g5f56b077267d"
msgid "I am freeing these gnomes. Just try and stop me."
msgstr "이 노움들을 풀어줄 거야. 어디 한 번 막아 보시든가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp
#. Speaker = Kirgrath
#. NodeID = f24bc892-a10e-fb39-e312-251936eec4ca
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_Mutineers_Event_FailedtoFreeGnomes = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp:f24bc892-a10e-fb39-e312-251936eec4ca
msgctxt "h77ce927bg0c2cg405ag8287g94866871f5ac"
msgid ""
"Nah. They slow us down, I hold fire to their arses. You should see 'em dance!"
msgstr "아니. 걔네가 발목을 잡으면, 똥구멍에 불을 놔야지. 너도 그 춤추는 꼬락서니를 봐야 하는데!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp
#. Speaker = Kirgrath
#. NodeID = f89b0193-0ee1-d3be-9d9c-1ffabf2eb30e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_Mutineers_Event_PromisedHalf = True
#.   Script:
#.      - GEN_CheckPocketGold_2 = True
#. SetFlags:
#.   Global:
#.     - UND_Mutineers_State_PaidPlayerReward = True
#.   Object:
#.     - GEN_TransferNPCPayment_2(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp:f89b0193-0ee1-d3be-9d9c-1ffabf2eb30e
msgctxt "h92ce7fc7g5656g460cg8145gf60bec694983"
msgid ""
"Here's your cut. Half the spoils, like Brithvar said. ([463b0f43-5410-412d-"
"aba3-875cf81c38ca])"
msgstr "여기 너의 몫이다. 브리스바가 말한 대로, 절반이다. ([463b0f43-5410-412d-aba3-875cf81c38ca])"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp
#. Speaker = Kirgrath
#. NodeID = fbc7ee10-c7db-b2b7-0600-36e4c56a3be8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_DuergarMutineers_State_Alive = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp:fbc7ee10-c7db-b2b7-0600-36e4c56a3be8
msgctxt "h2d7e3f13ge7c5g44e4gbd83g34b35d04a1f3"
msgid "Listen up, Clan Flameshade - we need to cut and run."
msgstr "플레임셰이드 일족은 들어라. 우리는 그만 두고 떠나야 한다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp
#. Speaker = Kirgrath
#. NodeID = fe5fc4ec-688a-3176-123d-ba2765578fa5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#.   Quest:
#.     - UND_GnomeRescue.HostileAgainstMutineers(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Mutineers_GroupFollowUp:fe5fc4ec-688a-3176-123d-ba2765578fa5
msgctxt "ha92bc2fdgd77cg4656gaaa4ga08281b770fe"
msgid "You don't need to ask twice, <i>jargh.</i>"
msgstr "두말할 필요도 없지, <i>자그.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Nere_AD_Coercion_1
#. Speaker = Nere
#. NodeID = 5350eade-28d5-47ad-adef-688e62dce76c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Nere_AD_Coercion_1:5350eade-28d5-47ad-adef-688e62dce76c
msgctxt "hb5899cc6g8c91g4901g8441g1e30a5cc25a9"
msgid "My servant, my bidding."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Nere_AD_Coercion_2
#. Speaker = Nere
#. NodeID = ef6d2c37-a623-4043-a4ba-ec8573c1f8e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Nere_AD_Coercion_2:ef6d2c37-a623-4043-a4ba-ec8573c1f8e2
msgctxt "h04ae97d0g8f1ag4852g85c8g3b84694ca1bd"
msgid "Your master speaks."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Nere_AD_Coercion_3
#. Speaker = Nere
#. NodeID = daa65de2-73d9-439e-b068-b0bb61c822b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Nere_AD_Coercion_3:daa65de2-73d9-439e-b068-b0bb61c822b3
msgctxt "h8d405d0dg5e06g4af3g9da4gd6865730fd6e"
msgid "You're in my thrall."
msgstr "넌 내 노예다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Nere_AD_ShieldOfScreams_2
#. Speaker = Nere
#. NodeID = 6d7e3c60-9898-45e4-9550-01c51c757a83
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Nere_AD_ShieldOfScreams_2:6d7e3c60-9898-45e4-9550-01c51c757a83
msgctxt "h44e3893fg6754g4fd5gbed2g453d145756cc"
msgid "Strike me, and suffer."
msgstr "날 쳐보시지, 그리고 고통을 받아보라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Player
#. NodeID = 01c4813b-b93e-71be-0209-1f7e12bd653f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:01c4813b-b93e-71be-0209-1f7e12bd653f
msgctxt "h4814d288gc1d0g4353g9f55gf10e31990d1a"
msgid "Get moving. If I see you slavers again, I'll tear you apart."
msgstr "그럼 가봐. 너희 노예상 놈들 또 보이면, 찢어 죽이겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Elder Brithvar
#. NodeID = 0df357f6-4972-4832-2986-f23959eee4e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:0df357f6-4972-4832-2986-f23959eee4e2
msgctxt "h189bc6fcgadc2g469dgb051g777272427143"
msgid ""
"Your brain going mushy, <i>jargh? </i>That's where those Absolute-freaks "
"hole up."
msgstr "뇌가 맛이 가버렸냐, <i>자그? </i>거기가 그 절대자 믿는 등신들이 죽치고 있는 곳이라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Player
#. NodeID = 0f38a4b6-5459-5510-ea7b-fa23799fdfbd
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#. TagRule: BERSERKER
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:0f38a4b6-5459-5510-ea7b-fa23799fdfbd
msgctxt "hff80ded2g5ecdg43b5gb54eg7eacf744fe52"
msgid "Gnomes walk. Or you <b>DIE</b>."
msgstr "노움들을 풀어줘. 아님 <b>죽든가</b>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Player
#. NodeID = 0f38a4b6-5459-5510-ea7b-fa23799fdfbd
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:0f38a4b6-5459-5510-ea7b-fa23799fdfbd
msgctxt "h3c15b4fcg16bag42baga4b6gbc89f15a832a"
msgid "The gnomes go free, and you get to live. Everybody wins."
msgstr "노움들은 자유의 몸이 되고, 너희는 살지. 모두가 이기는 길이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Elder Brithvar
#. NodeID = 15b5e820-aa67-1fe8-affe-0497c1dc94fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:15b5e820-aa67-1fe8-affe-0497c1dc94fc
msgctxt "hc3b92f8bg6d35g4270ga288g3a6343bdeb1a"
msgid "Psh. I'll let you keep breathin', and we'll call things square."
msgstr "칫. 죽이진 않겠다. 빚은 갚은 걸로 치지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Elder Brithvar
#. NodeID = 16970587-f521-43af-dcac-861e85bf82dd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_DuergarMutineers_State_Alive = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:16970587-f521-43af-dcac-861e85bf82dd
msgctxt "hc7c2f8dfg0964g4dc9gbad2g8e6ba712e1b2"
msgid "Clan: grab your gear, wipe your arses."
msgstr "일족 전원: 장비 챙기고, 엉덩이 털어라. 가자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Player
#. NodeID = 169f241c-5b92-4666-b205-bbb301eedbe2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_CheckPocketGold = True
#. SetFlags:
#.   Object:
#.     - GEN_TransferNPCPayment(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:169f241c-5b92-4666-b205-bbb301eedbe2
msgctxt "h5c06d0b3g8eafg4ae5g87feg10f43d1b030b"
msgid "Here - take it. ([6057ad05-9492-4630-9f0a-be548b134c54])"
msgstr "여기, 가져가. ([6057ad05-9492-4630-9f0a-be548b134c54])"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Player
#. NodeID = 1eb400d8-8f42-c60f-ab5f-55c510854bac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:1eb400d8-8f42-c60f-ab5f-55c510854bac
msgctxt "h941dd9f7ge9deg4f3fgb4e6gf68cd67cd92b"
msgid "Understood. I won't interfere."
msgstr "알겠어. 방해하지 않을게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Player
#. NodeID = 287fa191-b055-4baf-85b1-3e6d101d9925
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - b84942fc-b971-eae0-bc9d-e95a7b825d17_MindHasBeenRead = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:287fa191-b055-4baf-85b1-3e6d101d9925
msgctxt "h30e41c5dg8d7cg41b4g863cga3d85888b2c3"
msgid "Take me on, and you'll look like a fool. Walk away, and you save face."
msgstr "나한테 덤비면 넌 바보처럼 보일 거야. 그냥 떠나면 체면을 구기진 않을 거고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Elder Brithvar
#. NodeID = 2ecada4a-efc6-49bb-a22f-23bfb6a22d83
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:2ecada4a-efc6-49bb-a22f-23bfb6a22d83
msgctxt "h18534ea4gce7eg4eb4g890cgd5266ce863ce"
msgid "Good doing business with you."
msgstr "함께 일해서 좋았다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Elder Brithvar
#. NodeID = 33960d37-2cee-9dda-9db7-9734a2a0c9e5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:33960d37-2cee-9dda-9db7-9734a2a0c9e5
msgctxt "h08644e1ag9451g4370gbb25g55b3abc3d277"
msgid "Won't hear me argue. Your mouth's got the might to back it."
msgstr "그럼 더 이상 따지지 않겠어. 네 말엔 그걸 뒷받침할 만한 힘이 있군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Elder Brithvar
#. NodeID = 39441340-01ea-35aa-0dc0-96387f79afd7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#.   Quest:
#.     - UND_GnomeRescue.HostileAgainstMutineers(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:39441340-01ea-35aa-0dc0-96387f79afd7
msgctxt "h6bbfa773g6215g486ega446g63233354adee"
msgid "Try it, ya uppity shit, see what happens."
msgstr "한 번 해봐, 건방진 새끼야. 어떻게 되나 보자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Karlach
#. NodeID = 3b0be5e2-16d1-754c-aa66-08866ebeb9f2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:3b0be5e2-16d1-754c-aa66-08866ebeb9f2
msgctxt "h3707cf1fgbe42g4deag90edgdf9e1c7e2524"
msgid "My gods. What in all Nine Hells is wrong with you?!"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Player
#. NodeID = 41d6ca76-7117-ab42-5b69-1a00d083373d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:41d6ca76-7117-ab42-5b69-1a00d083373d
msgctxt "hf19c36a8gec7bg48cegbc42g9ae63549da41"
msgid ""
"I've reconsidered our deal, Brithvar. Free the slaves, or this place becomes "
"your tomb."
msgstr "브리스바. 우리 거래를 다시 생각해봤는데, 노예들을 풀어줘. 아니면 여기가 네 무덤이 될 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Elder Brithvar
#. NodeID = 424cc426-5ce7-4f15-8701-50a2d4a263e4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - b84942fc-b971-eae0-bc9d-e95a7b825d17_MindHasBeenRead = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:424cc426-5ce7-4f15-8701-50a2d4a263e4
msgctxt "heac7a1dcg04b3g4985g809eg614c147298cc"
msgid ""
"<i>Shit - I've seen this </i>jargh <i>fight. </i>Drugnin' <i>animal. But "
"sooner die than lose face.</i>"
msgstr ""
"<i>썅, 난 이 </i>자그<i>자식이 어떻게 싸우는지 봤다고. </i>염병할<i> 짐승같이 싸우지. 그렇지만 체면 구기느니 싸우다 "
"죽는 게 나아.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Elder Brithvar
#. NodeID = 4d9805a8-68e8-8d98-440f-e234b00d46de
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_State_LeaderFreedGnomes = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:4d9805a8-68e8-8d98-440f-e234b00d46de
msgctxt "h584ef180g6626g4600gbdf7g111693a32605"
msgid "Gnome-pricks: you're off the hook. Scram, before I get my senses."
msgstr "노움 등신들아, 너희는 풀려났다. 썩 꺼져. 내가 다시 정신차리기 전에."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Elder Brithvar
#. NodeID = 568c5de4-d69e-939d-c246-e6cf7e737a99
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:568c5de4-d69e-939d-c246-e6cf7e737a99
msgctxt "ha7d447f6g0828g43f3g9374g67b3fd47f87f"
msgid "Clan property. They come with us."
msgstr "일족의 소유물이야. 우리가 데려간다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Elder Brithvar
#. NodeID = 5cb5af8d-0b8e-761e-d9dd-b3a31f0b8dd8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_Mutineers_Event_FailedtoFreeGnomes = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:5cb5af8d-0b8e-761e-d9dd-b3a31f0b8dd8
msgctxt "h0ba2453fg6245g4dd4gbc9eg3b4505efbad5"
msgid ""
"Hardly. They drag their feet, and I'll scorch their arses. Works every time."
msgstr "그럴 리가. 늑장을 부리면 놈들 엉덩이를 불로 태워주지. 그렇게 하면 항상 먹힌다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Elder Brithvar
#. NodeID = 5d844f92-2a84-fdce-a454-c0de3c77bcfb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:5d844f92-2a84-fdce-a454-c0de3c77bcfb
msgctxt "h233020aag57f6g403ag8464gbf708b393d33"
msgid ""
"Deal's off, <i>jargh. </i>I told you to squish that floatin' eyeball. Now "
"the damn thing's seen us put Nere down."
msgstr ""
"거래는 취소다, <i>자그. </i>저 둥둥 떠다니는 눈깔을 으깨버리라고 했었잖아. 이제 저 망할 것이 우리가 니어를 죽이는 걸 봤다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Player
#. NodeID = 6266ed5d-7edb-a0ed-a83a-84ec54c9f769
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_DuergarMutineers_Event_Leave = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:6266ed5d-7edb-a0ed-a83a-84ec54c9f769
msgctxt "h8b96ca96gca67g46degac36g9adafc520e74"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Player
#. NodeID = 6362ee05-8226-738f-b383-b27370dceec2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_GnomeWorkers_State_PermaDefeated = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:6362ee05-8226-738f-b383-b27370dceec2
msgctxt "h16b25cc5gaa64g433ag828egf5cd79e13a77"
msgid "And the slaves? What about them?"
msgstr "노예들은 어쩌고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Wyll
#. NodeID = 64b0291d-77dc-90a2-73d7-3ab07996062b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:64b0291d-77dc-90a2-73d7-3ab07996062b
msgctxt "he37a04d4g1234g4577g85b9gd5445f864f75"
msgid "Have you no heart? They deserved freedom - and you denied it."
msgstr "인정도 없나? 저들은 자유를 누릴 자격이 있는데, 네가 그걸 막다니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Elder Brithvar
#. NodeID = 7bc25603-a529-431d-f14e-f2cf554d15af
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:7bc25603-a529-431d-f14e-f2cf554d15af
msgctxt "he608c7b5g3c01g4b48ga505g17520ace8e86"
msgid ""
"You <i>rakkah</i>. Good thing you ain't one of mine - I'd be sliding a cane "
"up your hole and twisting."
msgstr ""
"이런 <i>라카</i> 자식. 네 녀석이 내 부하가 아닌 걸 다행으로 알아. 그랬으면 네 궁둥이에 지팡이 쑤셔 넣고 돌려버렸을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Player
#. NodeID = 80e3828b-12ca-171e-a414-023838ef5afb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_Mutineers_Event_FailedtoFreeGnomes = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:80e3828b-12ca-171e-a414-023838ef5afb
msgctxt "h8554001egd831g4ec5g9e65g45b8bc999066"
msgid "I am freeing these gnomes. Just try and stop me."
msgstr "이 노움들을 풀어줄 거야. 어디 한 번 막아 보시든가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Elder Brithvar
#. NodeID = 848dd912-acf0-735a-bbb9-3295f0f6e0ec
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#.   Quest:
#.     - UND_GnomeRescue.HostileAgainstMutineers(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:848dd912-acf0-735a-bbb9-3295f0f6e0ec
msgctxt "h89bd7abeg344fg4770g93d1geda485a19171"
msgid "Your wish is my command, <i>jargh.</i>"
msgstr "내 분부대로 해라, <i>자그.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Elder Brithvar
#. NodeID = 85a02b95-2c88-4888-b0dc-3b680c044ecd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:85a02b95-2c88-4888-b0dc-3b680c044ecd
msgctxt "h8fa1f937g3410g4a10g9d5fgc3ecba2ca1a6"
msgid "<i>Drugnin' jargh. </i>Have it your way."
msgstr "<i>드루그닌 자그. </i>마음대로 해라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Elder Brithvar
#. NodeID = 8a3e7e45-deaa-3cd0-f2b8-83f3f3fea6bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:8a3e7e45-deaa-3cd0-f2b8-83f3f3fea6bf
msgctxt "h947d7bc2g2a84g4363gbcbbgd5b162cef172"
msgid "Born to serve, my father said. I'll keep 'em busy."
msgstr "놈들은 봉사하기 위해 태어난 거라고 아버지께서 그러셨지. 계속 굴려먹도록 하겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Elder Brithvar
#. NodeID = 8bd60219-47af-45ea-9348-8771950cb04d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:8bd60219-47af-45ea-9348-8771950cb04d
msgctxt "hd31bddb3g279dg4ebdgae3eg849426ed7dae"
msgid ""
"<i>Drugh. </i>Fine. Besides, we got shit to do. Gold ain't gonna hoard "
"itself."
msgstr "<i>썅. </i>알겠다. 안 그래도 우린 해야 할 일이 있어서 말이야. 금화가 저절로 굴러들어오지는 않거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Player
#. NodeID = 8cd66818-f43f-278d-e558-e69e20081ca9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_Mutineers_Quest_KillEye = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:8cd66818-f43f-278d-e558-e69e20081ca9
msgctxt "h3506e852gc3bdg4173gb92eg3cfd16d3b34a"
msgid "We had a deal. You owe <i>me</i>, not the other way around."
msgstr "우리는 거래를 했어. 네가 <i>내게</i> 빚을 진 거지. 그 반대가 아니라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Elder Brithvar
#. NodeID = 9206b972-d258-4ac9-afe4-79ec7031966b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:9206b972-d258-4ac9-afe4-79ec7031966b
msgctxt "hb31737cagddc9g40d8gaf75g99950468be03"
msgid "That was the wrong answer. <i>Zavagh!</i>"
msgstr "그건 틀린 대답이다. <i>Zavagh!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Player
#. NodeID = 99b7f2ce-1c7a-cf54-d394-7792f7157043
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#. TagRule: BERSERKER
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:99b7f2ce-1c7a-cf54-d394-7792f7157043
#, fuzzy
msgctxt "h79db14f6g129dg4dc4g9155g62c6f10ed12d"
msgid "<b>You</b> are going to gut <b>ME</b>? <b>HAH.</b>"
msgstr "<b>네 녀석 </b>이 <b>내</b> 내장을 뽑겠다고? <b>하.</b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Player
#. NodeID = 99b7f2ce-1c7a-cf54-d394-7792f7157043
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:99b7f2ce-1c7a-cf54-d394-7792f7157043
msgctxt "ha8c2597dg4297g41bbgb36cgc9fd96ffd487"
msgid "Gut me? <b>Try it </b>- doubt you'll even pierce skin."
msgstr "내장을 뽑겠다고? <b>한번 해보셔 </b>. 내 피부도 못 뚫을 새끼가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Elder Brithvar
#. NodeID = a3134195-626a-f390-3080-71732fe9204a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:a3134195-626a-f390-3080-71732fe9204a
msgctxt "he0f68014g5850g4f23g9db4g904a206116c0"
msgid ""
"Thanks to you, we got a cult-army on our tail. Now pay up - or I bleed you "
"dry."
msgstr "네 자식 덕분에, 광신도 군대가 우리 뒤를 쫓게 생겼군. 그 빚을 갚아라. 아니면 피 흘리게 해주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Elder Brithvar
#. NodeID = a372da0d-58ef-d7c5-ac21-776d469daa35
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:a372da0d-58ef-d7c5-ac21-776d469daa35
msgctxt "hefa8bebeg4771g46f9g963dg04b471762f89"
msgid "Mm. For a <i>jargh</i>, you got smarts."
msgstr "으음. <i>자그</i>치고는 똘똘하구만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Elder Brithvar
#. NodeID = a59d3574-7f2e-42a9-9d77-78c5aaf011f7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:a59d3574-7f2e-42a9-9d77-78c5aaf011f7
msgctxt "haf82c627gdfaeg4720g9f40gdf06f740ca3f"
msgid "I wasn't asking. <i>Zavagh!</i>"
msgstr "부탁한 게 아니라고. <i>Zavagh!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Elder Brithvar
#. NodeID = a6c96e20-6c98-4586-8771-7f2a9d185804
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:a6c96e20-6c98-4586-8771-7f2a9d185804
msgctxt "h7c590da4g2e82g4e1fg9af6gf857be69d218"
msgid "You messing in heads? I won't stand for that shit. <i>Zavagh!</i>"
msgstr "머릿속에서 장난치는 거냐? 그런 짓거리는 참지 않겠어. <i>Zavagh!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Player
#. NodeID = b0eb58dd-f302-1bc7-c808-63623b3b7b2c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:b0eb58dd-f302-1bc7-c808-63623b3b7b2c
msgctxt "hf424ca6ag0902g4510g9ea2g9de0acc489b0"
msgid "Good idea. They're a valuable asset."
msgstr "좋은 생각이군. 저들은 소중한 자산이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Elder Brithvar
#. NodeID = b2c649db-f53a-47da-f674-b50bd24424fa
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_DuergarMutineers_Event_Leave = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:b2c649db-f53a-47da-f674-b50bd24424fa
msgctxt "heb1c8579g07c1g4f81g8ecegcadf3ccdfe26"
msgid "Now lug your arse someplace else - I got to get cracking."
msgstr "이제 그 궁둥이 들고 좀 꺼져. 나는 길을 뚫어야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Elder Brithvar
#. NodeID = b381284c-b7b3-2929-4f11-875515b40985
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:b381284c-b7b3-2929-4f11-875515b40985
msgctxt "hc525a980gde9ag427ag8615ge3f7844fe90d"
msgid ""
"Mm - you got a point. Likely to be all hobbled up, what with the lashings."
msgstr "으음. 맞는 말이야. 채찍질당한 것 때문에 넋이 다들 나가 있겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Elder Brithvar
#. NodeID = b862aa47-0784-1a07-9ad0-02d16f0f6c13
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:b862aa47-0784-1a07-9ad0-02d16f0f6c13
msgctxt "ha8657957g7970g437cg91b4gd98b8eb9f342"
msgid ""
"Please. We catch your scent, and you'll get sliced 'fore you can bat your "
"left eye."
msgstr "좀. 우리가 네 녀석 냄새를 맡거든, 눈치채기도 전에 네 목이 따일 거라니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Player
#. NodeID = bfaeaf14-e52e-c57d-563c-ac4de11414e7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Moonrise_Knows_AbsoluteAtGrymforge = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:bfaeaf14-e52e-c57d-563c-ac4de11414e7
msgctxt "h2ae4a6d8gde18g45ddgb97cgd12ea36a1b31"
msgid "What makes Moonrise Towers such a threat?"
msgstr "문라이즈 타워가 그토록 큰 위협인 이유가 뭐야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Player
#. NodeID = c1fd01f8-7356-4356-92ab-b15105ede56a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_CheckPocketGold = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:c1fd01f8-7356-4356-92ab-b15105ede56a
msgctxt "h1335af98g219cg472bga6c1gdc3fa597ddf9"
msgid "I don't have that kind of gold on me."
msgstr "그만큼의 금화는 없는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Elder Brithvar
#. NodeID = c561abbd-f5a3-435b-ba41-4315f024a650
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:c561abbd-f5a3-435b-ba41-4315f024a650
msgctxt "hbe812895gbef3g4304gb115g394b80c54e68"
msgid ""
"Pay up, and you get to slink away. Resist, and I gut you. "
"([6057ad05-9492-4630-9f0a-be548b134c54])"
msgstr "돈 내면 보내주지. 반항하면 내장을 뽑아주고. ([6057ad05-9492-4630-9f0a-be548b134c54])"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Elder Brithvar
#. NodeID = c6117dcc-8612-899e-b874-b5c31209f186
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:c6117dcc-8612-899e-b874-b5c31209f186
msgctxt "h15007960gdfe9g4673ga349gcadf6911fe76"
msgid ""
"The way I hear tell, some prick there calls the shots. The General, Nere "
"called him."
msgstr "내가 듣기로는, 거기 있는 웬 등신이 대장이라더군. 니어는 놈을 장군이라고 불렀지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Player
#. NodeID = c7f43851-9586-4f3a-8b46-fcba99bfb8f3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DUERGARDWARF(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:c7f43851-9586-4f3a-8b46-fcba99bfb8f3
msgctxt "h2646cc20gee0fg41bfg8ebag35ed71c99325"
msgid "Drop it. I don't owe you anything."
msgstr "집어치워. 네게 진 빚은 없다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Elder Brithvar
#. NodeID = c8901d5c-8f16-8a13-9965-b3d3f3767316
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#.   Quest:
#.     - UND_GnomeRescue.HostileAgainstMutineers(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:c8901d5c-8f16-8a13-9965-b3d3f3767316
msgctxt "h77e10622gf543g43bbg9cc1g8f9b817d7f14"
msgid "Then do it, ya shit. We'll see who thrashes who."
msgstr "어디 해봐, 새끼야. 누가 누굴 족치게 되는지 한번 보자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Elder Brithvar
#. NodeID = d0d2e9eb-258c-6d22-e03b-bb2eed80344d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:d0d2e9eb-258c-6d22-e03b-bb2eed80344d
msgctxt "h19edf707gd47dg4551gab60g24c0818fe370"
msgid ""
"Goblins, drow, gnolls, even humans - ain't no one they won't try to turn. "
"They've gathered a damned <i>army.</i>"
msgstr ""
"고블린, 드로우, 놀, 거기다 인간들까지...놈들이 뒤엎지 못할 것은 아무것도 없어. 망할 놈의 <i>군대</i>를 긁어모았다니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Elder Brithvar
#. NodeID = d6b29fd7-bbfd-4349-9371-6e6337abc341
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:d6b29fd7-bbfd-4349-9371-6e6337abc341
msgctxt "h86dc12e0g04ddg4c08gb120g4c9d0e84c8a2"
msgid "That so? Then your head should do nicely. <i>Zavagh!</i>"
msgstr "그렇단 말이지? 그럼 네 녀석의 머리로 충분하겠군. <i>Zavagh!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Player
#. NodeID = d7aec934-6375-6091-a77b-790b3835cd90
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#.      - OATHBREAKER(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:d7aec934-6375-6091-a77b-790b3835cd90
msgctxt "h79417c00g2ca4g492bg9d9bg231333a62ac6"
msgid ""
"Listen, coward. We had an agreement, and I don't take kindly to oathbreakers."
msgstr "잘 들어, 겁쟁이 자식아. 우리는 합의를 했고, 맹세를 저버리는 놈들은 내가 용서치 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Karlach
#. NodeID = dc22280d-ee48-f4d1-0a0d-555a57cc71bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:dc22280d-ee48-f4d1-0a0d-555a57cc71bf
msgctxt "h8114d97bg87a6g4a5dga110g16d9777ad5a3"
msgid "Pft. Sure, they can take the gnomes. Over our dead bodies. Right?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Elder Brithvar
#. NodeID = dd26d4b5-36ab-66cb-c218-99ceca061f12
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:dd26d4b5-36ab-66cb-c218-99ceca061f12
msgctxt "h111a2220gcd94g4ab5gb905g0534213dead6"
msgid "Time I scrammed before more pricks from Moonrise Towers move in."
msgstr "문라이즈에서 등신들이 더 쳐들어오기 전에 튀도록 하겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Elder Brithvar
#. NodeID = e317ea8a-abc5-4991-bb42-734456eacefa
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_DuergarMutineers_Event_Threatened = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:e317ea8a-abc5-4991-bb42-734456eacefa
msgctxt "h1612215dgeca0g43edgb9d5g01847cbd79d8"
msgid "Freeze it, cock-stench. We aren't done just yet."
msgstr "멈춰, 좆만한 새끼야. 우리 아직 볼 일 안 끝났어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Gale
#. NodeID = e8e85291-5b8b-8300-ddc7-7457594a0b94
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:e8e85291-5b8b-8300-ddc7-7457594a0b94
msgctxt "h4bcf6c1fge8c0g45c6g9a22gf35eeed430df"
msgid ""
"The gnomes should be able to go where they please. They are not the "
"duergar's to keep."
msgstr "노움들은 가고 싶은 곳으로 갈 자유가 있어. 듀에르가가 붙잡아놓을 수는 없지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Wyll
#. NodeID = ee48c585-c052-1ba2-35e2-7a684aaeb7d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:ee48c585-c052-1ba2-35e2-7a684aaeb7d0
msgctxt "h73236bccg4e9bg43bcga1f9g123897c2649a"
msgid "Speak up, chief. You can't just let the clan keep them."
msgstr "말 해, 대장. 그냥 저렇게 잡아가게 둘 수는 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Elder Brithvar
#. NodeID = f3732a57-22ae-f2bd-0374-6f4004979b5f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:f3732a57-22ae-f2bd-0374-6f4004979b5f
msgctxt "h4bc11904ge8c0g49a0g8efdg064900d3f68e"
msgid "And there ain't no way I'm sticking around long enough to meet him."
msgstr "그리고 내가 그 새끼를 만나도록 여기 오래 머물러 있을 이유도 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Elder Brithvar
#. NodeID = f4cc6471-be85-4d7e-8e0c-4b60851f8e9a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:f4cc6471-be85-4d7e-8e0c-4b60851f8e9a
msgctxt "h66ac1333geaa8g4a93ga416g8b5f2c1c68c7"
msgid ""
"Nere and his Absolute wanks owed us a wad of coin. And the dregs on his "
"corpse aren't gonna cut it."
msgstr "니어와 놈의 절대자 병신들이 우리에게 빚진 동전이 꽤 되지. 녀석의 시체에 있는 찌꺼기로는 부족해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Player
#. NodeID = fe775c64-6be1-f6c3-383d-e3966316cbe5
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = False
#.      - OATHBREAKER(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:fe775c64-6be1-f6c3-383d-e3966316cbe5
msgctxt "h842eb782ge328g4717gb614gf7c51521e2de"
msgid "You've got this all wrong. I pay you nothing, and you keep your head."
msgstr "잘못 알아들었군. 난 네게 아무것도 지불하지 않고, 너는 목이 달아나지 않는 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Gale
#. NodeID = ff4ae116-5737-8390-48bb-83ae8e4b3d11
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:ff4ae116-5737-8390-48bb-83ae8e4b3d11
msgctxt "hf1330815g490eg4f17g8138g8ed9606d9296"
msgid ""
"Brittle are the foundations upon which the houses of tyrants are built. It "
"seems I judged you to be less brittle than you really are."
msgstr "폭군들의 집이 세워지는 토대는 연약하지. 보아하니 내가 너를 덜 연약하다고 과대평가한 거 같네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Player
#. NodeID = 045c88f1-35ef-efc0-1db8-e6b2c7d50f49
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = False
#. 
#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Player
#. NodeID = 1b5e89f1-3c7a-4678-9673-576357105fcf
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = False
#.      - PALADIN(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:045c88f1-35ef-efc0-1db8-e6b2c7d50f49
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:1b5e89f1-3c7a-4678-9673-576357105fcf
msgctxt "hbfdaa956geae9g48c5gb897g729fc39485e0"
msgid ""
"You've got this backwards. <i>You</i> keep your head, and <i>I</i> pay you "
"nothing."
msgstr "거꾸로 알아들었군. <i>네</i> 목이 달아나지 않고, <i>나는 </i>네게 아무것도 주지 않는 거지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Player
#. NodeID = 089281ae-f6aa-ec71-6b34-11aa400e7bf8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:089281ae-f6aa-ec71-6b34-11aa400e7bf8
msgctxt "h6e907804g4fcbg4ceegb73egebac961a69b9"
msgid "Get moving. If I see you slavers again, I'll tear you apart."
msgstr "빨리 가봐. 너희 노예상들이 다시 내 눈에 띄면 갈갈이 찢어줄 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Kirgrath
#. NodeID = 08e3f123-688a-6b6c-74a8-3b34684d76e8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:08e3f123-688a-6b6c-74a8-3b34684d76e8
msgctxt "hbb9d3f66g39ccg43c2ga997g21988250e889"
msgid "They belong to the clan. They're coming with us."
msgstr "노예들은 일족의 소유물이다. 우리와 함께 간다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Kirgrath
#. NodeID = 0a36bee9-14c4-4d1e-de67-76dceebdb9d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:0a36bee9-14c4-4d1e-de67-76dceebdb9d4
msgctxt "h93ed053bgb428g422dg90edg40a831d50e86"
msgid "Damned right it should."
msgstr "그렇게 나와주셔야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Kirgrath
#. NodeID = 0cca3084-5456-ba15-5e7e-8e1210191cc2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:0cca3084-5456-ba15-5e7e-8e1210191cc2
msgctxt "hd534feeage121g4537g855fg5a1393d6d65d"
msgid "These shitheads aren't worth the hassle. You got yourself a deal."
msgstr "이 멍청이들은 입씨름할 가치도 없어. 좋아, 거래를 하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Kirgrath
#. NodeID = 0cf46798-d0cb-119b-4643-fdceaf7ee8ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:0cf46798-d0cb-119b-4643-fdceaf7ee8ed
msgctxt "hc361ba13g20f2g4d14g988egfd7888e6cc5c"
msgid "Figured you wouldn't."
msgstr "그럴 줄 알았지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Player
#. NodeID = 0f1470ab-def6-7de5-cca3-71a786d56a9c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 0
#. CheckFlags:
#.   Local:
#.      - bfd1fd7a-7142-8fe2-3d41-0929708a9610_MindHasBeenRead = False
#.   Script:
#.      - GEN_CanDetectThoughts_2 = True
#. 
#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Player
#. NodeID = 6c66d1ec-d7aa-4a8e-ba38-544bdc07e779
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 0
#. CheckFlags:
#.   Local:
#.      - b84942fc-b971-eae0-bc9d-e95a7b825d17_MindHasBeenRead = False
#.   Script:
#.      - GEN_CanDetectThoughts_2 = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:0f1470ab-def6-7de5-cca3-71a786d56a9c
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:6c66d1ec-d7aa-4a8e-ba38-544bdc07e779
msgctxt "h1aa7b65bged25g47efgbb72gf3dcf5c39a86"
msgid "<i>Read the duergar's mind.</i>"
msgstr "<i>듀에르가의 생각을 읽는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Player
#. NodeID = 23bca4f0-68ff-a2dc-ca2a-3794074c710c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - bfd1fd7a-7142-8fe2-3d41-0929708a9610_MindHasBeenRead = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:23bca4f0-68ff-a2dc-ca2a-3794074c710c
msgctxt "h387baf72g683cg4f5dgb37bga31614d9103a"
msgid ""
"You're no Brithvar. Let me go, and I won't humiliate you in battle. Deal?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Gale
#. NodeID = 2ef59faf-e6c6-ad5c-af9c-2b2425871ff1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:2ef59faf-e6c6-ad5c-af9c-2b2425871ff1
msgctxt "hdba98a0agfa80g4cd0g8ba2g24dfbc4eac71"
msgid ""
"Brittle are the foundations upon which the houses of tyrants are built. It "
"seems I judged you to be less brittle than you really are."
msgstr "폭군들의 집이 세워지는 토대는 연약하지. 보아하니 내가 너를 덜 연약하다고 과대평가한 거 같네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Kirgrath
#. NodeID = 30041e4f-5cb7-f024-b2e8-82e5926d273e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:30041e4f-5cb7-f024-b2e8-82e5926d273e
msgctxt "h5718a54egb9e6g4c9ag854ege673dea37c3a"
msgid ""
"You owe - what's the word? <i>Restitution</i>.  ([6057ad05-9492-4630-9f0a-"
"be548b134c54])"
msgstr "넌 그 - 뭐더라? <i>보상금</i>을 빚진 거야. ([6057ad05-9492-4630-9f0a-be548b134c54])"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Kirgrath
#. NodeID = 325ca666-037a-2569-1e82-903424020f46
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:325ca666-037a-2569-1e82-903424020f46
msgctxt "h8d596bb8gd898g4ee0g9601g5a4b30765403"
msgid "That wasn't the deal. <i>Zavagh!</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Player
#. NodeID = 329fe3a0-c630-8d05-eff2-bbbe49e4bb03
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_CheckPocketGold = True
#. SetFlags:
#.   Object:
#.     - GEN_TransferNPCPayment(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:329fe3a0-c630-8d05-eff2-bbbe49e4bb03
msgctxt "hce72ee19g2f6dg4eadgb259g35af5b1da114"
msgid "Here - this should do it. ([6057ad05-9492-4630-9f0a-be548b134c54])"
msgstr "여기 - 이거면 되겠지. ([6057ad05-9492-4630-9f0a-be548b134c54])"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Kirgrath
#. NodeID = 3364ae4d-3448-507a-57dc-acd210247e22
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:3364ae4d-3448-507a-57dc-acd210247e22
msgctxt "h6ab9107eg57f1g4562g95b8g0b5304df9068"
msgid ""
"Yeh might be right about that. The more bodies we got, the slower we move."
msgstr "그 말이 맞을지도. 머릿수가 많을수록 더 느려질테니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Kirgrath
#. NodeID = 3554f7e7-80ae-b0b2-7319-311934bfaf6e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#.   Quest:
#.     - UND_GnomeRescue.HostileAgainstMutineers(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:3554f7e7-80ae-b0b2-7319-311934bfaf6e
msgctxt "h88554f3ag06bag4506g91c5gaf057320c61c"
msgid "Go on, then. Been itching to cut you down a peg."
msgstr "그럼 해 보시든가. 널 썰고 싶어서 좀이 쑤시던 참인데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Kirgrath
#. NodeID = 4036e6bf-5d2f-3d1a-8934-f0c787300260
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:4036e6bf-5d2f-3d1a-8934-f0c787300260
msgctxt "h22138480gbe43g49a4g9a07ga2824b71fb6c"
msgid "Some General up there giving the orders, the way Nere told it."
msgstr "니어 말에 따르면 그곳의 어떤 장군이 명령을 내리고 있대."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Karlach
#. NodeID = 423c6a49-e784-94d2-738e-bbf1eb568615
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:423c6a49-e784-94d2-738e-bbf1eb568615
msgctxt "h0cfb5c63g5ed8g4c20ga45fg8d86996eaec3"
msgid "Absolutely not. The gnomes walk free. Right?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Player
#. NodeID = 439bff0c-04bf-0840-6c28-6dc0627313da
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_DuergarMutineers_Event_Leave = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:439bff0c-04bf-0840-6c28-6dc0627313da
msgctxt "h26de73c5g4750g4c8fga49ag43644ad20242"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Karlach
#. NodeID = 43fcad84-ed25-4b95-d5d1-9d7f39081390
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:43fcad84-ed25-4b95-d5d1-9d7f39081390
msgctxt "h5bab5ba0g3393g409dg8311g888021720c76"
msgid "Whoa. What?! You can't be serious."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Kirgrath
#. NodeID = 473e0a13-f270-0745-46b1-6690bb1282b8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:473e0a13-f270-0745-46b1-6690bb1282b8
msgctxt "hf661b253g5e13g442ag8751g5c9ef6b130eb"
msgid "Then I'll have to see what price your head fetches. <i>Zavagh!</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Player
#. NodeID = 49939dda-0252-43bd-139c-c3059317d54c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_Mutineers_Event_FailedtoFreeGnomes = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:49939dda-0252-43bd-139c-c3059317d54c
msgctxt "h3c8e851egc3d5g4328g9e49g314c2102f472"
msgid "I am freeing these gnomes. Just try and stop me."
msgstr "이 노움들을 풀어줄 거야. 어디 한 번 막아 보시든가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Player
#. NodeID = 52683840-6ff2-8c8f-4f75-9a7c0b1137a1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_Mutineers_Quest_KillEye = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:52683840-6ff2-8c8f-4f75-9a7c0b1137a1
msgctxt "h4b477ad4g4983g445egb6e0gb4a611cbb0f1"
msgid ""
"I had a deal with Brithvar. You owe <i>me</i>, not the other way around."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Kirgrath
#. NodeID = 57e0df1b-e783-becf-6ef5-53fa8833a137
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:57e0df1b-e783-becf-6ef5-53fa8833a137
msgctxt "h3af05735ga30bg48caga012gde2c7c6ab8d0"
msgid ""
"You - you're in my head, aren't you? That ain't right, damn it. "
"<i>Zavagh!</i>"
msgstr "너, 지금 내 생각 염탐했지? 그러면 안 되지, 이 자식아. <i>즈아바흐!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Kirgrath
#. NodeID = 5844aafa-37d7-c74b-d17e-170beb5f0fcf
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:5844aafa-37d7-c74b-d17e-170beb5f0fcf
msgctxt "hf3218c12g58dbg4509g8cc5g5822454c4640"
msgid "Hah! Did you just <i>roar </i>at me, you freak? <i>Zavagh! </i>"
msgstr "하! 방금 꼴에 나한테 소리지른 거냐? 등신아? <i>즈아바흐!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Kirgrath
#. NodeID = 5d385d84-b431-7702-689e-035de8141835
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:5d385d84-b431-7702-689e-035de8141835
msgctxt "hed37cb0bgaaf4g4189g9240g71334439124d"
msgid ""
"You got Brithvar chopped - and I still haven't seen a damned coin for my "
"trouble."
msgstr "네가 브리스바를 써는 걸 도와줬는데 아직 동전 한 닢 구경 못했다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Kirgrath
#. NodeID = 60548316-b36e-346a-cc50-045808f8b284
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - bfd1fd7a-7142-8fe2-3d41-0929708a9610_MindHasBeenRead = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:60548316-b36e-346a-cc50-045808f8b284
msgctxt "hd5112bf7g5c29g47a9gbb6dgc4519fb9c86d"
msgid ""
"Drugnin' <i>Brithvar. I'm lost without him. He'd have this </i>jargh<i> "
"pissin' with fear.</i>"
msgstr "망할 <i>브리스바. 그 없인 난 아무것도 아냐. 그라면 이 </i>녀석<i>이 공포로 지리게 해줬을 텐데.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Kirgrath
#. NodeID = 61b6aa7c-2488-a239-12f3-99e9ee2aaaf0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:61b6aa7c-2488-a239-12f3-99e9ee2aaaf0
#, fuzzy
msgctxt "ha5017ec9gfc16g4c94gba5dgbfb19cae8f22"
msgid "AHH! SHIT! F-fine, I'm not dealing with whatever <i>that</i> was."
msgstr "<b>악! 젠장! 씨</b>... 그래, <i>방금</i> 뭐랬는진 몰라도 더 이상 얘기 안 할게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Kirgrath
#. NodeID = 66331c51-6880-5328-0a84-04f62439e70f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#.   Quest:
#.     - UND_GnomeRescue.HostileAgainstMutineers(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:66331c51-6880-5328-0a84-04f62439e70f
msgctxt "h469ba16agc440g43b9gb773gfc3877fcc760"
msgid "You don't need to ask twice, <i>jargh.</i>"
msgstr "두말할 필요도 없지, <i>자그.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Player
#. NodeID = 6d150180-2fc5-e596-d6db-db1e1cabea40
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - DUERGARDWARF(1) = True
#. 
#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Player
#. NodeID = a311b48f-a9e0-3a3d-f6a9-1ec64eb77c6b
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - DUERGARDWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:6d150180-2fc5-e596-d6db-db1e1cabea40
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:a311b48f-a9e0-3a3d-f6a9-1ec64eb77c6b
msgctxt "hea6389cdgce80g48a8g8d3ag62e5e470948d"
msgid "Restitution, my arse. You'll find what you need on Nere's corpse."
msgstr "뭔 놈의 보상금? 필요한 건 니어의 시체에서 찾아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Kirgrath
#. NodeID = 70ad1d72-cc84-a674-a443-c06e6e1dd03a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:70ad1d72-cc84-a674-a443-c06e6e1dd03a
msgctxt "h6409bafegba0dg47c7g9ef2g2938851ab6e6"
msgid ""
"Place is swarming with Absolute-buggers - a whole army. And I ain't gonna "
"mess about with them."
msgstr "거긴 절대자 신봉자들로 넘쳐나 - 아주 군대라니까. 나는 걔네랑 절대 엮이지 않을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Player
#. NodeID = 76f11994-a5b3-4ee2-dce0-18eeae010c2f
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#.      - BERSERKER(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:76f11994-a5b3-4ee2-dce0-18eeae010c2f
msgctxt "h2f27c40fg8467g4aecg8f4cg1163c727267b"
msgid "I can smell your fear so bad I can taste it. Go beg someone else."
msgstr "네 두려움이 진동하는 게 느껴질 정도야. 다른 놈한테 구걸해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Kirgrath
#. NodeID = 7868cf0e-8132-7374-ce52-ccc07fe44aad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:7868cf0e-8132-7374-ce52-ccc07fe44aad
msgctxt "hd9918c2ag8d96g4be9gb10bgf7a4c246def5"
msgid "That, or - or I add your corpse to the heap. Which is it?"
msgstr "그러든가 - 아니면 시체가 되거나. 어느 쪽이야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Player
#. NodeID = 7b4dd0c9-4231-573a-9d57-d06f2b1a54f6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - bfd1fd7a-7142-8fe2-3d41-0929708a9610_PassedPassive = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:7b4dd0c9-4231-573a-9d57-d06f2b1a54f6
msgctxt "hc6653f4bg62c6g4f78g89b1ge67d7fe61386"
msgid ""
"You're afraid, and you should be. Ask for money again, and I'll gut you."
msgstr "넌 두려워하고 있어. 응당 그래야지. 다시 돈을 요구하면 널 썰어버리겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Kirgrath
#. NodeID = 7d0bacc9-4a24-1ad6-7745-61d23712d28b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_State_LeaderFreedGnomes = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:7d0bacc9-4a24-1ad6-7745-61d23712d28b
msgctxt "heaab336fgaecag4db2g87c2g5fb39287f43a"
msgid ""
"You're free, squatties. Get your legs moving, before I change my damn mind."
msgstr "너흰 자유야, 난쟁이들아. 내가 마음을 바꾸기 전에 빨리 움직이라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Kirgrath
#. NodeID = 81d56ef5-5ec3-ad4a-88db-829785aaac66
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:81d56ef5-5ec3-ad4a-88db-829785aaac66
msgctxt "hc96bb708g60aag4627g9e63g7fd68ad06492"
msgid "Stinking <i>rakkah. </i>If Brithvar was here..."
msgstr "냄새나는 <i>라카</i> 주제에. 브리스바가 여기에 있었으면 넌..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Player
#. NodeID = 86f014ac-076f-58e3-51a4-791d29a77b19
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. 
#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort
#. Speaker = Player
#. NodeID = 373704f0-54df-4743-b85c-e2b4d2546548
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:86f014ac-076f-58e3-51a4-791d29a77b19
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelGreedyExtort:373704f0-54df-4743-b85c-e2b4d2546548
msgctxt "hd0ddd34dg16b1g48a3g8b0cg2c1e05612990"
msgid "I killed Nere for you. That's payment enough."
msgstr "너를 위해 니어를 죽여줬다. 그만하면 충분한 대가 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Kirgrath
#. NodeID = 8e7688e2-1cdc-4b11-a7bd-6aacab2dea0e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:8e7688e2-1cdc-4b11-a7bd-6aacab2dea0e
msgctxt "hab974715gfe84g4edfg9478ga524699718a0"
msgid ""
"Clan's got a cult-army on its hands thanks to you. So pay up. I'll take gold "
"- or your head."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Player
#. NodeID = 8ef190b5-b7b0-26de-6ded-c342fa909b1b
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - BERSERKER(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:8ef190b5-b7b0-26de-6ded-c342fa909b1b
msgctxt "hb3d98958gcf19g49cegbe92g50b86f0ec8be"
msgid "<b><i>ROAR.</i></b>"
msgstr "<b><i>크아아.</i></b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Player
#. NodeID = 9bd0c0fe-3c51-86a4-9024-99f51fad0599
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#. TagRule: BERSERKER
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:9bd0c0fe-3c51-86a4-9024-99f51fad0599
msgctxt "h1a6ef147g2a0eg4f10g91ccgda8b365edc1f"
msgid "RELEASE THEM, <b>NOW</b>! "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Player
#. NodeID = 9bd0c0fe-3c51-86a4-9024-99f51fad0599
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:9bd0c0fe-3c51-86a4-9024-99f51fad0599
msgctxt "hd849104ag52beg4f07gbe07g4d4fdbae197d"
msgid "You sure they're worth <b>dying over?</b>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Kirgrath
#. NodeID = a067133d-b8b6-eea1-5957-abf3019df87e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:a067133d-b8b6-eea1-5957-abf3019df87e
msgctxt "h6597b547g1285g4958g849ageaa671fdc483"
msgid "Damn right. We'll keep them busy - this isn't their last dig."
msgstr "그럼. 바쁘게 굴려야지. 이번이 마지막 채굴은 아니니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Kirgrath
#. NodeID = a0b832f6-afe9-9657-8dad-55c2a3f89340
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_Mutineers_Event_FailedtoFreeGnomes = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:a0b832f6-afe9-9657-8dad-55c2a3f89340
msgctxt "he1fa876cg4a7eg4aa9g9fabg3ee2e3768192"
msgid ""
"Nah. They slow us down, I hold fire to their arses. You should see 'em dance!"
msgstr "아니. 걔네가 발목을 잡으면, 똥구멍에 불을 놔야지. 너도 그 춤추는 꼬락서니를 봐야 하는데!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Gale
#. NodeID = a0ed3fa0-a42f-b712-f9c7-0dd605e2ffd4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:a0ed3fa0-a42f-b712-f9c7-0dd605e2ffd4
msgctxt "h9c4b1fb3g2430g4962ga397g98ca14421b17"
msgid ""
"The gnomes should be able to go where they please. They are not the "
"duergar's to keep."
msgstr "노움들은 가고 싶은 곳으로 갈 자유가 있어. 듀에르가가 붙잡아놓을 수는 없지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Kirgrath
#. NodeID = a67c93be-1df1-8c94-2458-ec226b2d730d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:a67c93be-1df1-8c94-2458-ec226b2d730d
msgctxt "hc69c417egdb31g433dgb600g85b6455ba3ab"
msgid ""
"You think? I catch so much as a whiff of you, and I'll have you flayed and "
"fried up for dinner."
msgstr "그러셔? 네 녀석 그림자만 보여도 내가 가죽을 벗겨서 저녁으로 구워 먹을 줄 알아라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Kirgrath
#. NodeID = a6ea5e5b-a4f6-b68d-0705-4cb05dcfa80e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:a6ea5e5b-a4f6-b68d-0705-4cb05dcfa80e
msgctxt "h85c0fa3eg2456g436cgbb44g45545b2a5fff"
msgid "Shit. That's how it is, eh?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Kirgrath
#. NodeID = a97987ce-a51f-0999-8bf5-df32d9084e7d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_DuergarMutineers_Event_Threatened = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:a97987ce-a51f-0999-8bf5-df32d9084e7d
msgctxt "hb13e8330g8a3eg4a00ga180g6061b9b978a2"
msgid "Hold up, <i>jargh. </i>Y-you ain't just walking away."
msgstr "기다려, <i>자그.</i> 그, 그냥 가면 안 되지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Wyll
#. NodeID = ab4617a1-cf64-fe19-2475-fc5521e5e539
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:ab4617a1-cf64-fe19-2475-fc5521e5e539
msgctxt "hf678a05fg7a2ag4eb0gafdegd513611beefd"
msgid "Your heart made of stone? They deserved freedom - and you denied it."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Wyll
#. NodeID = ae6c5887-863e-38f8-f295-275be40674a0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:ae6c5887-863e-38f8-f295-275be40674a0
msgctxt "h45a4ac59g70b4g418agbb73g1e07419f4e0b"
msgid "Speak up, chief. You can't just let the clan keep them."
msgstr "말 해, 대장. 그냥 저렇게 잡아가게 둘 수는 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Kirgrath
#. NodeID = aff4eaa6-1950-78af-5ecf-4f47f0be5789
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:aff4eaa6-1950-78af-5ecf-4f47f0be5789
msgctxt "hd584ad00gb8beg4da0g9334gbb8e3d617176"
msgid "It's time I scram, before the buggers at Moonrise charge in."
msgstr "이제 갈 시간이군. 문라이즈 새끼들이 쳐들어오기 전에 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Player
#. NodeID = b48617e5-952f-7735-7df6-1b0183f29149
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Moonrise_Knows_AbsoluteAtGrymforge = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:b48617e5-952f-7735-7df6-1b0183f29149
msgctxt "h47e582c5ge7b8g43d7g94c7g57f39db93971"
msgid "What makes Moonrise Towers such a threat?"
msgstr "문라이즈 타워가 그토록 큰 위협인 이유가 뭐야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Player
#. NodeID = bd01f9b6-a4fd-6ebb-d623-e6dfc649cd91
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:bd01f9b6-a4fd-6ebb-d623-e6dfc649cd91
msgctxt "hd36ead85g0a2eg4b8aga808g22783f1f4496"
msgid "Understood. I won't interfere."
msgstr "알았어. 간섭하지 않을게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Player
#. NodeID = c268d8a9-4534-ed0f-ab96-426ebdc6f84b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DUERGARDWARF(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:c268d8a9-4534-ed0f-ab96-426ebdc6f84b
msgctxt "hc91cd8d9g9429g4b88g909fge73392a045cf"
msgid "You're mad if you think I owe you a single coin."
msgstr "내가 네게 동전 한 닢이라도 빚졌다고 생각하면 넌 미친 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Kirgrath
#. NodeID = c855f282-143b-815c-493d-6cb80e98a669
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_DuergarMutineers_State_Alive = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:c855f282-143b-815c-493d-6cb80e98a669
msgctxt "h5186c9b1gcfbdg448egbd3ag9207c8bcbc12"
msgid "Clan, wrap it up. We've scraped this place for all its worth."
msgstr "애들아, 짐 싸라. 여기서 쓸모 있는 건 최대한 챙겼어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Kirgrath
#. NodeID = d654234a-b395-d087-c786-1807c346a8fb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:d654234a-b395-d087-c786-1807c346a8fb
msgctxt "h9f120261g871fg49e7ga1b7gfa7635667807"
msgid "Shit - fine. Never could see eye to eye with a <i>clan-sen.</i>"
msgstr "젠장 - 알았어. <i>클란센</i>과는 도무지 뜻이 맞지 않는다니깐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Player
#. NodeID = da5986d3-4a5a-6334-4b3b-ecbaad3c313b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_GnomeWorkers_State_PermaDefeated = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:da5986d3-4a5a-6334-4b3b-ecbaad3c313b
msgctxt "he412da4fgcf49g427aga741g36bfdb5dd265"
msgid "And the slaves? What about them?"
msgstr "노예들은 어쩌고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Narrator
#. NodeID = daee1619-3ba0-6f49-64e9-94b5dd2821d9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - bfd1fd7a-7142-8fe2-3d41-0929708a9610_PassedPassive = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:daee1619-3ba0-6f49-64e9-94b5dd2821d9
msgctxt "h39f54ac3g58b6g42cbgb7a9g89c036ef0a6e"
msgid "*You sense hesitation. The duergar talks tough, but fears you.*"
msgstr "*당신은 망설임을 감지합니다. 듀에르가는 말은 쎄게 하지만 당신을 두려워하고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Kirgrath
#. NodeID = db4e99c4-0863-6124-1108-1d6e93d97916
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:db4e99c4-0863-6124-1108-1d6e93d97916
msgctxt "h9b637d95gc4aag4869g941bg5f496a5b285a"
msgid ""
"They got goblins, drow, gnolls, even humans - ain't no one they won't try to "
"turn. The clans included."
msgstr "거기엔 고블린, 드로우, 놀, 심지어 인간들도 있어 - 눈에 밟히는 대로 변이시키고 있다고. 일족도 포함해서 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Kirgrath
#. NodeID = df080a2c-c79a-11d5-1925-b2107d019cd1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:df080a2c-c79a-11d5-1925-b2107d019cd1
msgctxt "h67ccc62eg87a3g49d1gae23g19290ce64eb7"
msgid ""
"Deal's off, <i>jargh. </i>He told you to squish that floatin' eyeball. Now "
"the damn thing's seen us kill Nere."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Kirgrath
#. NodeID = e10602c8-834d-ced7-7135-6270a26d8955
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:e10602c8-834d-ced7-7135-6270a26d8955
msgctxt "h916657e3g917ag405eg926eg43d3aed353a0"
msgid "I... fine. You ain't worth the trouble anyway."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Kirgrath
#. NodeID = e2fe3796-4f2c-dde7-b0fa-f3df22822c8d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:e2fe3796-4f2c-dde7-b0fa-f3df22822c8d
msgctxt "hee16a9d5g4a99g4ad2gbf82g043340a6df36"
msgid "That so? Then your corpse should be more than willing. <i>Zavagh!</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Kirgrath
#. NodeID = eea37a14-3728-536f-a86b-57b0d30a3aa3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_DuergarMutineers_Event_Leave = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:eea37a14-3728-536f-a86b-57b0d30a3aa3
msgctxt "h4824a8e4g964ag4dd7g9bb3g89fa601f1d96"
msgid "Now move out of here - I got shit to be doing."
msgstr "이제 썩 사라져 버려. 난 할 일이 많아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Kirgrath
#. NodeID = f0a6fff2-077a-f229-d143-d5bb7f3354f9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:f0a6fff2-077a-f229-d143-d5bb7f3354f9
#, fuzzy
msgctxt "h90719b08g1a0bg4925g8275gfaa756345492"
msgid "I - fine. Can't dig for gold when I'm dead, eh?"
msgstr "그, 그래. 금화 받아봤자 뒈지면 무슨 소용이겠어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Player
#. NodeID = fa7fe57b-4709-2dd9-02eb-b5e6735a7553
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:fa7fe57b-4709-2dd9-02eb-b5e6735a7553
msgctxt "h94c072f7g57f4g4855gb363g0f28f605fd86"
msgid "Good idea. They're a valuable asset."
msgstr "좋은 생각이군. 저들은 소중한 자산이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort
#. Speaker = Player
#. NodeID = fddfd27c-2a04-e3a2-d5bf-edf4de055c88
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_CheckPocketGold = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RebelsExtort:fddfd27c-2a04-e3a2-d5bf-edf4de055c88
msgctxt "h85d541ecg058bg4660gb1c1g75e119d683e7"
msgid "Don't be ridiculous. I don't have that kind of gold."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion
#. Speaker = Player
#. NodeID = 005ef28e-1871-86cb-19fc-dee1e1097497
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion:005ef28e-1871-86cb-19fc-dee1e1097497
msgctxt "h337dc6d5gef34g497bgab1ag7f1c0d54cff6"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion
#. Speaker = Elder Rothé
#. NodeID = 08cd6f6d-0fed-4366-1af2-e664820a3c31
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion:08cd6f6d-0fed-4366-1af2-e664820a3c31
msgctxt "hd71915cfgb8ceg4d42g8c94g65213c2683b3"
msgid "No. Bigger. <i>Angrier.</i>"
msgstr "아니. 더 크고. <i>더 화나 있는 것.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion
#. Speaker = Elder Rothé
#. NodeID = 09d6a581-f91c-d6b2-95f7-5fd6777e0b99
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion:09d6a581-f91c-d6b2-95f7-5fd6777e0b99
msgctxt "he68c28d4gabe3g4c32g849bgc5fd603e669e"
msgid "Do not think on it further. Rest. I will see you safe."
msgstr "그 일은 더 생각하지 말고 이제 쉬어. 안전하게 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion
#. Speaker = Player
#. NodeID = 0aee40a1-5d74-45ae-f9ce-1ebd722d5655
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion:0aee40a1-5d74-45ae-f9ce-1ebd722d5655
msgctxt "hbffe86d3g25f1g47a7gbcd7ge9eaaa4ea265"
msgid "Tell me what you can about Ketheric Thorm."
msgstr "케서릭 쏨에 대해 아는 건 다 말해 줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion
#. Speaker = Narrator
#. NodeID = 107d2abe-3707-e82b-db8e-90751b5e10d6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion:107d2abe-3707-e82b-db8e-90751b5e10d6
msgctxt "hd5a85ac2g9581g4dbdg834cg3bd365af8a2d"
msgid ""
"*The lights must mean <i>something</i>, but you can't interpret the flashes.*"
msgstr "*불빛들이 <i>무언가</i>를 의미하는 건 틀림없지만, 당신은 그 섬광들을 해석할 수 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion
#. Speaker = Narrator
#. NodeID = 161eb985-c775-a19a-c59c-29d92c4c8ad1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion:161eb985-c775-a19a-c59c-29d92c4c8ad1
msgctxt "h635c102fgf6f4g412dg920cgf2baf16b0f1f"
msgid "*That fear runs deep, stretching back across generations.*"
msgstr "*그 공포는 깊숙이, 세대를 초월해 퍼져있는 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion
#. Speaker = Narrator
#. NodeID = 189d91a6-73a1-b35e-d8c5-05681c95fef9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - UND_DuergarCamp_DeepRothe01_State_AnimalHandlingFail(2) = True
#.     - UND_DuergarCamp_DeepRothe02_State_AnimalHandlingFail(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion:189d91a6-73a1-b35e-d8c5-05681c95fef9
msgctxt "hd54fb1f4gf615g46cfga3b2gc88e9d0b061c"
msgid "*One beast notices you and dulls his lights, ending the conversation.*"
msgstr "*짐승 하나가 당신을 의식하고 그의 불빛을 어둡게 하여, 대화를 종료합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion
#. Speaker = Player
#. NodeID = 229d5053-a09e-57ef-315e-a1599bae6c3e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion:229d5053-a09e-57ef-315e-a1599bae6c3e
msgctxt "h4598e5c7g7ef0g42d8g8ae5gde0d80dfe591"
msgid "Do you mean Ketheric Thorm, the Dark Justiciar commander?"
msgstr "다크 저스티시어 사령관인 케서릭 쏨을 말하는 것인가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion
#. Speaker = Narrator
#. NodeID = 269156e4-83ca-c4c8-45d6-bb3fe53e1b47
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAV_DefeatingKetheric_Event_WarnedMoonrise = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion:269156e4-83ca-c4c8-45d6-bb3fe53e1b47
msgctxt "h4ec0ec99g3bb3g48a0ga62cg148aa8749849"
msgid ""
"*Ketheric Thorm - an inescapable name. His legacy has shadowed the region, "
"above ground and under.*"
msgstr "*케서릭 쏨, 피할 수 없는 이름입니다. 그의 유산은 이 지역에 그림자를 드리웠습니다. 지상과 지하 모두에 말이죠.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion
#. Speaker = Player
#. NodeID = 29345747-602f-1a4d-a34b-bd5a1d4175b8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion:29345747-602f-1a4d-a34b-bd5a1d4175b8
msgctxt "h28169a3eg628eg417fg910ag45713be654a5"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion
#. Speaker = Elder Rothé
#. NodeID = 426c9e3a-0632-03b8-7e0c-e335407b64f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion:426c9e3a-0632-03b8-7e0c-e335407b64f5
msgctxt "hba480300g900fg4e40gb3c0gdad37d545db8"
msgid ""
"Mm. Mighty elf, cloaked in darkness. Ten masters ago, and ten more. But I "
"remember."
msgstr "으음. 어둠에 가려진 강대한 엘프지. 열 명하고도 열 명의 주인 이전의 일이지만 난 아직도 기억해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion
#. Speaker = Narrator
#. NodeID = 47b4884e-dfd1-8f7d-6110-307712a80975
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_DuergarCamp_DeepRothe01_State_AnimalHandlingSuccess(2) = True
#.   Tag:
#.      - PETPAL(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion:47b4884e-dfd1-8f7d-6110-307712a80975
msgctxt "hc446f05fgd000g45c1gbb7bg5440345c349e"
msgid ""
"*The beast flashes a message of comfort. But his eyes betray his concern.*"
msgstr "*짐승은 위로의 메시지를 깜빡이지만, 그 눈에는 걱정이 서려 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion
#. Speaker = Player
#. NodeID = 52a592d3-7552-85e7-171d-073e9fabeef2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_RotheDiscussion_Event_MentionedConnection(2) = False
#. SetFlags:
#.   Dialog:
#.     - UND_RotheDiscussion_Event_MentionedConnection(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion:52a592d3-7552-85e7-171d-073e9fabeef2
msgctxt "h82b7ec12g023dg477ag94d4gbb9bb2ddd4ec"
msgid "That was a long time ago. What does Nere have to do with Ketheric?"
msgstr "오래 전의 일이야. 니어가 케서릭과 무슨 상관이길래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion
#. Speaker = Narrator
#. NodeID = 5944b552-fd41-89dd-33aa-42cf4d1c7e3e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion:5944b552-fd41-89dd-33aa-42cf4d1c7e3e
msgctxt "hde476087gd133g47f1g8a11g5d579121b4d2"
msgid ""
"*The name means little to you, yet your heart pulses to its rhythm. "
"<i>Thorm. Thorm.</i>*"
msgstr "*당신과는 큰 연관점이 없는 이름이지만, 그 이름이 점차 심장박동에 새겨지기 시작합니다. <i>쏨. 쏨.</i>*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion
#. Speaker = Narrator
#. NodeID = 64694763-785c-f34c-ffd8-89f9b71f3766
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_TheDrowNere_Event_MentionedKethericChosen_Global = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion:64694763-785c-f34c-ffd8-89f9b71f3766
msgctxt "hfc45fc29ge8e4g4923g9de7ga093d4b2f368"
msgid ""
"*The Absolute's Chosen, Ketheric Thorm. So vast is his repute that even the "
"beasts bellow his name.*"
msgstr "*절대자에게 선택받은 자, 케서릭 쏨. 그 명성이 너무 커서, 짐승들조차 그 이름을 울부짖습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion
#. Speaker = Narrator
#. NodeID = 70c811da-a944-c6c4-9d01-d6a3aef297c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion:70c811da-a944-c6c4-9d01-d6a3aef297c1
msgctxt "hf9bf2b13g6a2eg4459gaec6gfa84b8eefeab"
msgid "*The beasts continue their discussion, lights flickering above them.*"
msgstr "*짐승들은 머리 위에서 불빛을 깜빡거리며 논의를 이어나갑니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion
#. Speaker = Elder Rothé
#. NodeID = 711a4a49-602b-94a2-caba-0e7de2146aa0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion:711a4a49-602b-94a2-caba-0e7de2146aa0
msgctxt "hbff07ab4g1869g45ccgb8d2ga207321cec56"
msgid ""
"There was the work, and the blood. There was the Thorm's army. There was the "
"hellbeast that broke them."
msgstr "일이 있더니 피가 있었지. 쏨의 군대가 있었고. 그들을 꺾은 지옥짐승도 있었지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion
#. Speaker = Player
#. NodeID = 711ed40f-776f-d76b-ea32-f22276e6fe0b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_TIEFLING(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion:711ed40f-776f-d76b-ea32-f22276e6fe0b
msgctxt "hc64feb53geffeg4b73gb0f0g41f4ce336f95"
msgid "What kind of hellbeast could have destroyed Ketheric's army?"
msgstr "대체 어떤 종류의 지옥짐승이 케서릭의 군대를 파괴할 수 있었던 걸까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion
#. Speaker = Deep Rothé Calf
#. NodeID = 72b13be0-56ad-911e-253f-de65fa5adf25
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_DuergarCamp_DeepRothe01_HasMet_SpeakWithAnimals(2) = True
#.   Tag:
#.      - PETPAL(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion:72b13be0-56ad-911e-253f-de65fa5adf25
msgctxt "he4bbaae1gb9a4g4e19g8b51g30ec4440e81a"
msgid "Afraid. Afraid of Thorm."
msgstr "두려워. 쏨이 무서워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion
#. Speaker = Player
#. NodeID = 793b95d6-e90c-6177-c6d5-c223de0403f6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion:793b95d6-e90c-6177-c6d5-c223de0403f6
msgctxt "h5cfe067dg860cg491fgae94g96f004470919"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion
#. Speaker = Narrator
#. NodeID = 85ee212e-1342-39cb-6671-610c5f4214c3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - UND_DuergarCamp_DeepRothe02_State_AnimalHandlingSuccess(2) = True
#.     - UND_DuergarCamp_DeepRothe01_State_AnimalHandlingSuccess(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion:85ee212e-1342-39cb-6671-610c5f4214c3
msgctxt "ha662ebf1gfec1g4905ga0e4g0a8d8d5d1b36"
msgid ""
"*One of the beasts seems exhausted. His lights flash in slow, methodical "
"beats.*"
msgstr "*짐승 중 한 마리는 지친 듯 합니다. 그의 불빛은 느리고 규칙적인 박자에 맞춰 깜빡입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion
#. Speaker = Player
#. NodeID = 8c999822-75bd-c677-e5a5-cb735b7c3956
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - REALLY_UNDERDARK(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion:8c999822-75bd-c677-e5a5-cb735b7c3956
msgctxt "hf2644adeg42ccg4594g9dd2gb647c4710818"
msgid "<i>Pay attention to the lights. </i>"
msgstr "<i>불빛에 주의를 기울인다. </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion
#. Speaker = Elder Rothé
#. NodeID = 91b2ae23-640c-faea-0de6-a8c8644a75fb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion:91b2ae23-640c-faea-0de6-a8c8644a75fb
msgctxt "h600b0264g6633g4f6eg855dgd3cae1f88328"
msgid "Blessed to see many live. Cursed to see many die."
msgstr "많은 이들이 사는 것을 보도록 축복받았고. 많은 이들의 죽음을 보도록 저주받았지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion
#. Speaker = Narrator
#. NodeID = 926575bc-6d98-c505-1b1b-e00aa86938ba
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_DuergarCamp_DeepRothe01_HasMet(2) = False
#.   Tag:
#.      - PETPAL(2) = False
#. SetFlags:
#.   Dialog:
#.     - UND_DuergarCamp_DeepRothe01_HasMet(2) = True
#.     - UND_DuergarCamp_DeepRothe02_HasMet(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion:926575bc-6d98-c505-1b1b-e00aa86938ba
msgctxt "h800aadc9gdbefg42e7g9ff7g3afa751a08f0"
msgid ""
"*The rothé grunt softly at each other. Small lights flash about their heads "
"in quick, erratic patterns.*"
msgstr "*로테들은 서로에게 부드럽게 끙 소리를 냅니다. 그들의 머리 위에서 작은 불빛들이 빠르고 불규칙한 형태로 깜빡입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion
#. Speaker = Player
#. NodeID = 978b924c-06f7-66f2-7370-5777fb8a96de
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 10
#. CheckFlags:
#.   Dialog:
#.      - UND_DuergarCamp_DeepRothe01_State_AnimalHandlingFail(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion:978b924c-06f7-66f2-7370-5777fb8a96de
msgctxt "h8b7b08e1gfc35g459fg9e39gc449918a6a6d"
msgid "<i>Still your body and quietly observe.</i>"
msgstr "<i>몸을 움직이지 않고 조용히 관찰한다. </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion
#. Speaker = Player
#. NodeID = 9b4dde2b-80c6-7ba2-4a11-60aa7b353559
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion:9b4dde2b-80c6-7ba2-4a11-60aa7b353559
msgctxt "h29ee2465g082cg4f9cgb061g5d1838fc2ccc"
msgid "What are you doing?"
msgstr "뭐 하는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion
#. Speaker = Player
#. NodeID = 9ec7cc7d-7547-4c0e-162d-83d47d5568d5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion:9ec7cc7d-7547-4c0e-162d-83d47d5568d5
msgctxt "hae23bc66g1306g4b58gb143ga8b3dd03a711"
msgid ""
"You're not the only one who fears Ketheric Thorm. What do you know of him?"
msgstr "케서릭 쏨을 두려워하는 것은 너 혼자가 아니야. 그에 대해 뭘 알고 있지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion
#. Speaker = Elder Rothé
#. NodeID = aa918770-1e1f-e11d-e0c2-b686e442197a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion:aa918770-1e1f-e11d-e0c2-b686e442197a
msgctxt "he5ef3c8bg2ba5g4072gba27g85f56ea6750a"
msgid ""
"I know not so I say not. Yet I hear his name again, said by the shadows."
msgstr "아는 게 없기에 말하지 않는 게야. 그럼에도 그림자들이 속삭이는 그 이름이 다시 들려오는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion
#. Speaker = Player
#. NodeID = ab05ebab-9c68-4acb-bb59-d9f80d1ca694
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion:ab05ebab-9c68-4acb-bb59-d9f80d1ca694
msgctxt "ha7e64134g4a4eg46f6gbf13g113789b6ef7b"
msgid "Ketheric Thorm's influence stretches far. What was he doing down here?"
msgstr "케서릭 쏨의 영향력이 멀리까지 퍼졌구나. 이 아래에서 그가 뭘 했지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion
#. Speaker = Player
#. NodeID = ad572532-527f-f4cb-1462-0fe5f66e5129
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Intelligence
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - REALLY_UNDERDARK(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion:ad572532-527f-f4cb-1462-0fe5f66e5129
msgctxt "h165d78f2ge8e8g4037ga28ag39131fa1b798"
msgid "<i>Pay attention to the lights. </i>"
msgstr "<i>불빛에 주의를 기울인다. </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion
#. Speaker = Narrator
#. NodeID = ae7e61e6-0a31-7180-167d-50bb7b296840
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion:ae7e61e6-0a31-7180-167d-50bb7b296840
msgctxt "h8ae6fbceg6811g472bgbe68gde35d1c4e079"
msgid ""
"*You discern subtle emotions in the lights' patterns. There is pain, sadness "
"- and fear.*"
msgstr "*당신은 불빛의 패턴에서 미묘한 감정을 감지합니다. 고통, 슬픔, 그리고 공포입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion
#. Speaker = Player
#. NodeID = b330b4f5-ba30-4c3a-8ca8-b7f455c3ec41
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN_ANCIENTS(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion:b330b4f5-ba30-4c3a-8ca8-b7f455c3ec41
msgctxt "h5ef69d93g3926g4956g809cg3bb75e258374"
msgid "Impressive memory. How old are you exactly?"
msgstr "놀라운 기억력인걸. 정확히 나이가 어떻게 되는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion
#. Speaker = Player
#. NodeID = b484086f-af9b-9008-5d68-23e39c21255b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion:b484086f-af9b-9008-5d68-23e39c21255b
msgctxt "h2ae6acc6gf140g4baagad61g3a429df5ea35"
msgid "<i>Simply watch the rothé.</i>"
msgstr "<i>로테를 그저 바라본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion
#. Speaker = Elder Rothé
#. NodeID = b4eee7f5-63cc-0d24-dc7f-415ae5aa5447
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion:b4eee7f5-63cc-0d24-dc7f-415ae5aa5447
msgctxt "hb67344e4ge09bg4a63g9ddag1dcd5e8fbfe8"
msgid "I outlived my mother, and her mother's mother, and many mothers beyond."
msgstr "난 내 어머니보다 오래 살았고, 어머니의 어머니의 어머니보다도 오래 살았고, 그 위의 다른 어머니들보다도 오래 살았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion
#. Speaker = Deep Rothé Calf
#. NodeID = b60e4ca0-7591-698a-0eda-f37caf54cf0e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_DuergarCamp_DeepRothe01_HasMet_SpeakWithAnimals(2) = False
#.   Tag:
#.      - PETPAL(2) = True
#. SetFlags:
#.   Dialog:
#.     - UND_DuergarCamp_DeepRothe01_HasMet_SpeakWithAnimals(2) = True
#.     - UND_DuergarCamp_DeepRothe02_HasMet_SpeakWithAnimals(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion:b60e4ca0-7591-698a-0eda-f37caf54cf0e
msgctxt "h93b64d16g41f4g49e3ga6dcg90e3d3e0b5f8"
msgid "Tired. Sleep."
msgstr "피곤해. 잔다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion
#. Speaker = Narrator
#. NodeID = b8133ea9-6728-8df7-1bd5-41ec5e0ddb5b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - MOO_Execution_Event_KethericLeaves = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion:b8133ea9-6728-8df7-1bd5-41ec5e0ddb5b
msgctxt "h67ac4a7cg992eg451fg9bf9gfb920d0691af"
msgid ""
"*Ketheric Thorm, the Absolute's Chosen. Even in these depths, he has left "
"his vicious mark.*"
msgstr "*케서릭 쏨, 절대자에게 선택받은 자. 그는 이 깊은 지하에도 그의 포악한 흔적을 남겨 놓았습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion
#. Speaker = Player
#. NodeID = bc02b894-11cb-0172-d834-e296de8ee5f1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_TIEFLING(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion:bc02b894-11cb-0172-d834-e296de8ee5f1
msgctxt "h7c6d15d1gaf7ag477fga22fgf369628ab5fe"
msgid "Hellbeast? You mean like me? Horns?"
msgstr "지옥짐승이라고? 나랑 닮은 녀석 말이야? 뿔 달려있고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion
#. Speaker = Elder Rothé
#. NodeID = c04db019-f606-93cc-d4eb-65e5d62f2abf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion:c04db019-f606-93cc-d4eb-65e5d62f2abf
msgctxt "h9715db80g6e5ag423bg8ac1g0cb135d40fad"
msgid "The Ketheric Thorm's name faded into stone. Until the Nere came."
msgstr "케서릭 쏨의 이름은 돌 속에 희미해졌지. 니어가 오기 전까지는 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion
#. Speaker = Player
#. NodeID = c0b97e80-8462-10db-b0c5-481ae8f45cb1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN_ANCIENTS(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion:c0b97e80-8462-10db-b0c5-481ae8f45cb1
msgctxt "heb384829g34fdg4e6fgae1cg4beb517843de"
msgid "You honour me with your ancient wisdom."
msgstr "오래된 지혜를 나눠주다니 영광이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion
#. Speaker = Elder Rothé
#. NodeID = d998e762-f7f9-8712-064f-9460aad06a02
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion:d998e762-f7f9-8712-064f-9460aad06a02
msgctxt "h36848630gf31bg4229g9041ga7691e6dd607"
msgid ""
"I saw tusks and flesh, smelled fire and eggs. It came with the mask-men - "
"crashing and smashing."
msgstr "내가 본 것은 엄니와 살점이고, 맡은 것은 불꽃과 달걀의 냄새였어. 그것은 복면 쓴 자들과 함께 와서, 부수고 박살냈지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion
#. Speaker = Narrator
#. NodeID = daacb9ed-4a60-443a-9c05-30c11a2e19d0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_DarkJusticiars = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion:daacb9ed-4a60-443a-9c05-30c11a2e19d0
msgctxt "hb5e0ef73gab07g414ag8b6bg26a3b98257bc"
msgid ""
"*Ketheric Thorm - a familiar name. Halsin mentioned his stronghold deep "
"underground.*"
msgstr "*케서릭 쏨, 익숙한 이름입니다. 지하 깊숙이 있는 그의 요새에 대해서 할신이 언급한 적 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion
#. Speaker = Narrator
#. NodeID = ddeaaf86-be0e-990d-ba74-028e230dfddd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_DuergarCamp_DeepRothe01_HasMet(2) = True
#.   Tag:
#.      - PETPAL(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion:ddeaaf86-be0e-990d-ba74-028e230dfddd
msgctxt "h6af33b04ga699g4333gb626gcf8468a5faaa"
msgid "*The two rothé moan quietly as lights flash about their heads.*"
msgstr "*두 로테의 머리 위로 불빛이 깜빡거리고, 조용히 신음합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion
#. Speaker = Player
#. NodeID = de00667b-2295-3de5-41ba-9cd8f95adde0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion:de00667b-2295-3de5-41ba-9cd8f95adde0
msgctxt "h048d1e43g0a34g438fg86f6g1d8e4cecc1a4"
msgid "You fear this Ketheric Thorm. Who is he?"
msgstr "이 케서릭 쏨이라는 자를 무서워하는군. 그가 누구지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion
#. Speaker = Elder Rothé
#. NodeID = df0ea21c-4bf2-bc5d-9c47-48378ecdf6b2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion:df0ea21c-4bf2-bc5d-9c47-48378ecdf6b2
msgctxt "hc9dd72d5gadd0g4908ga253gef8efa65b200"
msgid ""
"I heard <i>his </i>name whispered. The rock shivers from the sound. The "
"Ketheric Thorm."
msgstr "<i>그 자</i>의 이름이 속삭여지는 것을 들었지. 그 소리에 바위들은 벌벌 떨지. 케서릭 쏨."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion
#. Speaker = Narrator
#. NodeID = e8f48615-3866-4c61-db80-bda1ae9a5cf4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_DuergarCamp_DeepRothe02_State_AnimalHandlingSuccess(2) = True
#.      - UND_DuergarCamp_DeepRothe01_State_AnimalHandlingSuccess(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion:e8f48615-3866-4c61-db80-bda1ae9a5cf4
msgctxt "hb0d2e592g6a2eg485agb611g8f01cd99a66c"
msgid "*The beast sternly ignores you.*"
msgstr "*짐승은 근엄하게 당신을 무시합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion
#. Speaker = Elder Rothé
#. NodeID = f29b2c2a-cc18-c92e-eff1-a53eafdf67bb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion:f29b2c2a-cc18-c92e-eff1-a53eafdf67bb
msgctxt "h43f00580g22a8g47cfg8f3fg02267eba7b9d"
msgid "Rest, little one. But do not take long - I feel his shadow."
msgstr "쉬게, 작은 이여. 그렇지만 너무 오래는 쉬지 말아. 그의 그림자가 느껴지거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion
#. Speaker = Narrator
#. NodeID = fcd7d1a2-0b3e-6095-32ac-c94079a8e7fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_RotheDiscussion:fcd7d1a2-0b3e-6095-32ac-c94079a8e7fe
msgctxt "h5f560aabgaa94g44c5gaa99g6c08ffccb138"
msgid ""
"*You recognise the spell - <i>Dancing Lights.</i> It is how rothé "
"communicate with each other.*"
msgstr "*당신은 이 주문을 알아봅니다. <i>춤추는 빛</i>입니다. 로테가 서로 소통할 때 사용하는 주문입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Rothe_01
#. Speaker = Narrator
#. NodeID = 47ff3000-8076-4cb0-fc84-56b08c5c9c79
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Rothe_01:47ff3000-8076-4cb0-fc84-56b08c5c9c79
msgctxt "h32f6a2ffg250fg4f04gbc08g1ffb027779af"
msgid "*The rothé chews slowly, its eyes drooping from exhaustion.*"
msgstr "*로테의 눈은 지쳐 축 늘어집니다. 녀석은 천천히 풀을 씹습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Rothe_01
#. Speaker = Deep Rothé Calf
#. NodeID = 87f402c5-1e66-3a0a-f80b-61dc9591df8a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Rothe_01:87f402c5-1e66-3a0a-f80b-61dc9591df8a
msgctxt "h220e73c1ge15fg4f5bgb716ge89b26d4a9f4"
msgid "Afraid. Afraid of the Thorm."
msgstr "두려워. 쏨이 무서워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Rothe_02
#. Speaker = Elder Rothé
#. NodeID = 7c0ee01b-13b6-670a-4d26-43bc03b2f7e4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Rothe_02:7c0ee01b-13b6-670a-4d26-43bc03b2f7e4
msgctxt "h2fb8b4e9g9d65g42bbga8e7g3c782421490e"
msgid "The Ketheric Thorm. The rocks hear, and tremble."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Rothe_02
#. Speaker = Narrator
#. NodeID = cfdb3425-7009-1912-6463-ba03d8522a8b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Rothe_02:cfdb3425-7009-1912-6463-ba03d8522a8b
msgctxt "h8a291835g5a59g40f6g94b2g4c3d3c1e098f"
msgid "*The beast focuses on his food - sternly ignoring you.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Rothe_03
#. Speaker = Deep Rothé
#. NodeID = 780f4319-cdd7-77c0-eb85-bc46e1ba201a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_DuergarCamp_DeepRothe03_HasMet(1) = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Rothe_03:780f4319-cdd7-77c0-eb85-bc46e1ba201a
msgctxt "ha490a37dg37e3g44d8ga0bfg731a03126621"
msgid "Grey ones make me work soon. Must sleep."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Rothe_03
#. Speaker = Narrator
#. NodeID = 9410d97c-8ed2-85e7-0b95-468d2e0822bc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_DuergarCamp_DeepRothe03_HasMet(1) = True
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Rothe_03:9410d97c-8ed2-85e7-0b95-468d2e0822bc
msgctxt "h525fc5abg561ag4fe4g8c7cg63d1863a2999"
msgid "*She snores loudly, eyes squeezed shut.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Rothe_03
#. Speaker = Deep Rothé
#. NodeID = acdc9614-5c55-24f4-bc73-523291f3c884
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_DuergarCamp_DeepRothe03_HasMet(1) = False
#.   Tag:
#.      - PETPAL(1) = True
#. SetFlags:
#.   Dialog:
#.     - UND_DuergarCamp_DeepRothe03_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Rothe_03:acdc9614-5c55-24f4-bc73-523291f3c884
msgctxt "hd9f30cc9g4a51g4abeg8f3ege8ae9e098a1f"
msgid "Hmm? Urgh. Are those two still talking?"
msgstr "흠? 아이고. 쟤네 둘은 아직도 떠들고 있는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Rothe_03
#. Speaker = Narrator
#. NodeID = db173aaf-0c59-5b17-8d97-df9c97c66a68
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_DuergarCamp_DeepRothe03_HasMet(1) = False
#.   Tag:
#.      - PETPAL(1) = False
#. SetFlags:
#.   Dialog:
#.     - UND_DuergarCamp_DeepRothe03_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_Rothe_03:db173aaf-0c59-5b17-8d97-df9c97c66a68
msgctxt "h054cc299g51d7g4e0fg957fg8e79d36d66bf"
msgid "*The creature huffs in irritation as she closes her eyes.*"
msgstr "*그 생명체는 눈을 감으며 짜증나서 크게 숨을 내쉽니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarGuardSergeant_Dead
#. Speaker = Player
#. NodeID = 25b5e859-65fc-8dd1-8203-8b4da3cb9870
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarGuardSergeant_Dead:25b5e859-65fc-8dd1-8203-8b4da3cb9870
msgctxt "hcda4c10eg4eacg4aedgbe5dg6a02d0150e24"
msgid "Who did you work for?"
msgstr "누구를 위해 일했었지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarGuardSergeant_Dead
#. Speaker = Sergeant Thrinn
#. NodeID = 3184c33b-9a64-38fa-3a5f-6cbacbfa2524
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarGuardSergeant_Dead:3184c33b-9a64-38fa-3a5f-6cbacbfa2524
msgctxt "he5f8e362g072eg4aa2gab1eg27f230fcf725"
msgid "Finding... new path... Towers..."
msgstr "탑... 새 경로를... 찾으러..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarGuardSergeant_Dead
#. Speaker = Player
#. NodeID = 396969a2-dcee-adeb-7020-c73e0236a389
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_DuergarSergeant_Dead_Knows_Nere(1) = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarGuardSergeant_Dead:396969a2-dcee-adeb-7020-c73e0236a389
msgctxt "hb143e2a4g038ag4128gb3e5gf4a23ee0170f"
msgid "Who is Nere?"
msgstr "니어가 누구지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarGuardSergeant_Dead
#. Speaker = Player
#. NodeID = 511a4c37-02a5-3ede-f795-1331327d8f8d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_DuergarSergeant_Dead_Knows_Disciple(1) = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DuergarGuardSergeant_Dead:511a4c37-02a5-3ede-f795-1331327d8f8d
msgctxt "hd1ea6595g9367g4074g8d4bg01038a36f159"
msgid "Who is this Disciple?"
msgstr "이 '신봉자'는 누구지?"

