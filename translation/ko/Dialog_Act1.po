msgid "Nymessa. Come."
msgstr "나이메사. 가자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene
#. Speaker = Nymessa
#. NodeID = e3be04e8-0691-8e50-e116-8f5b37160bb0
