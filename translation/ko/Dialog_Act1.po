msgctxt "hf5d191f7g8eb4g4722gb187g118c12f62d36"
msgid "Go on. Where can I find the Nightsong?"
msgstr "계속해. 어디서 밤의 노래를 찾을 수 있지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = ef01933e-d823-1997-9eae-59f2a54f99e0
#. HandlePath = TaggedText[0].TagText[0]
