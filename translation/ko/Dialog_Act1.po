msgctxt "hf2cfe46fgcddeg4869gb3aeg25ca72dc544c"
msgid "Halt. <i>Zech</i>... You are gith? State your business."
msgstr "잠깐. <i>제크</i>...기스인가? 용건을 말하라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointWarning
