msgctxt "h5508cd3egedbeg4dd1g9327ge2dd02f69119"
msgid "<b><i>ROAR. </i></b>"
msgstr "<b><i>울부짖는다. </i></b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Player
#. NodeID = 7fa8eb66-4772-4d0e-46ca-72a3e29cbef3
