msgctxt "h4647091age518g448dga7c9gb951af591785"
msgid "Saw the crash... came quick... try 'n help folk..."
msgstr "추락을 보고... 급히 왔어... 사람들을 도우려고..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_DeadFisherman2_Dead
