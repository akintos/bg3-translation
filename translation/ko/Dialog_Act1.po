msgctxt "h58d86c85gf8cdg4567g85aag8e20ba43966a"
msgid ""
"Let's not stand around. Predators like these can smell spilled blood a mile "
"away."
msgstr "어물쩡거리지 말자. 이런 포식자들은 일 마일 밖에서도 피 냄새를 맡을 수 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_DyingHyena_VB_PostFight_3P
#. Speaker = Player
#. NodeID = 961c8d22-52dc-32a0-041c-5465f3c86481
#. HandlePath = TaggedText[5].TagText[0]
