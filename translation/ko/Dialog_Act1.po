msgctxt "h86522043gc593g44f3g90b7g18e1acc17165"
msgid "I... I don't think she made it."
msgstr "그... 그녀가 죽은 것 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_FoundWife
#. Speaker = Player
#. NodeID = f5f3a235-94a0-e60e-fb7e-68316c1bba8c
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_KARLACH
