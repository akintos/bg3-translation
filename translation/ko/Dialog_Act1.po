msgctxt "h535e2b17g8b64g45f3g8216ga71cb03dc549"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DeadMyconid_Dead
#. Speaker = Dead Myconid Sprout
#. NodeID = 666d52ba-b9fb-c256-f2da-e1de22479057
