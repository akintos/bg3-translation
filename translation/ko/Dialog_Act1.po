msgctxt "hd384cb0bg2305g4186ga2fcg3315bf77903e"
msgid "Not much magic left, though - sun's too bright."
msgstr "마법이 많이 남아 있진 않아 - 태양이 너무 밝은걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Tavern_VB_House
#. Speaker = Player
#. NodeID = e2d6f561-76b6-bd1c-fc4f-b711b90b59c8
#. HandlePath = TaggedText[0].TagText[0]
