msgctxt "h957cbe5bg5443g4b38g8f42g440f1548ccd1"
msgid "Too bad the rest of the note is pure gibberish."
msgstr "메모의 다른 부분은 아무짝에도 쓸모가 없다니 아쉽네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_FurnaceSearch_PAD_MadRecords
#. Speaker = Player
#. NodeID = 42fa9e78-96c2-41c0-9e32-b8604dd0c88d
