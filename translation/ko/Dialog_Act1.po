msgctxt "h94bd28e3ga75eg45e5gb422g8e7458b925ca"
msgid "At Crèche Y'llek? Report to <i>Kith'rak </i>Therezzyn. Quickly."
msgstr "일레크 양성소에? <i>키스락</i> 테레진께 보고하라. 어서."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointWarning
#. Speaker = Player
#. NodeID = 5708995f-e2dd-3c3d-a811-65bdaf1966e0
