#.     - bffd772b-7809-8b21-7385-5815d11ed048_SawLaezel1 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard11:566e3461-2482-1e8f-0904-62a04b9b857c
msgctxt "h9cd3752fgce9eg4d52g9a3eg49a23bb6d928"
msgid "Please... have mercy..."
msgstr "제발... 자비를..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard11
#. Speaker = Zorru
#. NodeID = baa10e6c-b101-4d21-aee9-90c1df88a756
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard11:baa10e6c-b101-4d21-aee9-90c1df88a756
msgctxt "hb7af428fg4420g4485gaa7fg9aca95b40ab5"
msgid "This is a nightmare."
msgstr "이건 악몽이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_TieflingGuard11
#. Speaker = Zorru
#. NodeID = ca87a1ce-9cd5-748f-da1f-505b8fb74dde
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ThingLikeMe_State_AnimateForLaezel = True
