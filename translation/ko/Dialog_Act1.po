msgctxt "h98dcebd0g86f2g49b2g8f15gb59e024104c6"
msgid "*Face the prisoner. Consider the implements provided. Then...*"
msgstr "*포로를 마주합니다. 그리고 사용할 수 있는 도구들을 검토한 후에...*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
