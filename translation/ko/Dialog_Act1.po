msgctxt "h7ee1b7f6g880ag4e54g9ca2g6925500d7c46"
msgid "I must get closer."
msgstr "더 가까이 가야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerCharmed
#. Speaker = Player
#. NodeID = 0383f50b-4238-08bd-c76b-1a063fb7040a
