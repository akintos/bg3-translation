msgid ""
"Urgh. You're boooring. Come on Ra'jak, let's show them how to have some FUN."
msgstr "어휴. 넌 재미없어. 라자크, 재밌게 노는 법을 좀 보여주자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain
#. Speaker = Zel'i
#. NodeID = b9a84d7f-eda1-2b0d-ff3e-122c11be5576
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_General_State_MageHandMoveAside = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain:b9a84d7f-eda1-2b0d-ff3e-122c11be5576
msgctxt "hdcae1877gcf35g4ebcga3a3g3f8b36de7012"
msgid "Take a look. We don't mind."
msgstr "살펴봐. 괜찮아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain
#. Speaker = Player
#. NodeID = c541a8f1-e27b-213d-605b-902db470f1fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain:c541a8f1-e27b-213d-605b-902db470f1fc
msgctxt "h77949cf5g1200g4009g9e36gf7154a4fe338"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain
#. Speaker = Zel'i
#. NodeID = c6ae832d-480e-21ca-d565-295e16953871
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain:c6ae832d-480e-21ca-d565-295e16953871
msgctxt "hceaaef82gf904g4a2fgb7d6g9ebd34d5a3f7"
msgid "At least we're not boring like YOU."
msgstr "우린 최소 너처럼 지루하진 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain
#. Speaker = Zel'i
