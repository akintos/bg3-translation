#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1:e2e769d8-2ff9-14c5-34d2-b0f49e400ab7
msgctxt "h595ed432g16d2g4052gad30g5f52397ba242"
msgid "W-wha? Quick, get him!"
msgstr "무, 무슨? 얘들아, 공격해라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1
#. Speaker = Fezzerk
#. NodeID = e2e769d8-2ff9-14c5-34d2-b0f49e400ab7
