msgctxt "hc6f357cfg984ag4d5bgb6c6ge606d1d7d414"
msgid "Tell me about your life."
msgstr "네 인생이 어땠는지 말해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Spike_Dead
#. Speaker = Torturer Spike
#. NodeID = b5dab31b-05a9-a8de-4c2f-5f4b3bb7dae7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Spike_Dead:b5dab31b-05a9-a8de-4c2f-5f4b3bb7dae7
msgctxt "hc14ed09eg12c3g4cb0g9dbdg0867d301b55f"
msgid "... gold... blood... Absolute's blessing..."
msgstr "... 금... 피... 절대자님의 축복..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Spike_Dead
#. Speaker = Narrator
#. NodeID = b8367942-86c6-876a-159a-85090dfebbac
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Spike_Dead:b8367942-86c6-876a-159a-85090dfebbac
msgctxt "hceccef59g2ef1g4145ga774gcde08f7de95f"
msgid "*The corpse regards you lifelessly.*"
msgstr "*시체가 생기 없는 모습으로 당신을 맞이합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Spike_Dead
#. Speaker = Torturer Spike
#. NodeID = c1e44013-f24a-b767-22ee-21ecdf09bb9d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_Killer(1) = True
#.   Tag:
#.      - WYLL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Spike_Dead:c1e44013-f24a-b767-22ee-21ecdf09bb9d
msgctxt "h859c69c9g3adcg4419gac51g8767ebc21764"
msgid "... you... Blade of Frontiers... seeking your lady..."
msgstr "... 너... 변경의 칼날... 네 여주인을 찾겠다고..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Spike_Dead
#. Speaker = Torturer Spike
#. NodeID = d035375f-52b2-ff2e-206b-30b1c3410800
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Spike_Dead:d035375f-52b2-ff2e-206b-30b1c3410800
msgctxt "h68f979eegd98ag409ag8dd2g9c1fa671c05e"
msgid "... speaks through True Souls... scour the land... find weapon..."
msgstr "... 참된 영혼을 통해 말하지... 땅을 뒤지고... 무기를 찾으라고..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Spike_Dead
#. Speaker = Torturer Spike
#. NodeID = d2f9982f-a6ce-8673-f99e-126ff22cc814
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Spike_Dead:d2f9982f-a6ce-8673-f99e-126ff22cc814
msgctxt "h6b82511agf6afg4b0bgb1aege50647d7303c"
msgid "... born here stay here..."
msgstr "... 여기서 나고 자랐어..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = 00928aed-1627-92bb-44c0-de095f906c3e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_DrowCommander_Event_GoTorturePrisoner = False
#.      - GOB_HappyTorturers_Assaulted = False
#.   Object:
#.      - GLO_SafeRomance_Enabled(2) = False
#. TagRule: REALLY_DARK_URGE
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:00928aed-1627-92bb-44c0-de095f906c3e
msgctxt "h74c4a552ga5a0g4ff2gadfcgb613e62ae6ae"
msgid "I'm a professional. Let a master show you how it's done."
msgstr "난 전문가야. 장인의 기술이란 게 어떤 건지 내가 보여주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = 00928aed-1627-92bb-44c0-de095f906c3e
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_DrowCommander_Event_GoTorturePrisoner = False
#.      - GOB_HappyTorturers_Assaulted = False
#.   Object:
#.      - GLO_SafeRomance_Enabled(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:00928aed-1627-92bb-44c0-de095f906c3e
msgctxt "hdd6fc8c6g854ag46abg84fcgc87e5ca55a1b"
msgid "This looks interesting - let me put him through his paces."
msgstr "흥미로워 보이는데, 내가 한번 해보지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = 00e6fdce-ad9b-9584-f96f-e218e3310081
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_Torturers_Assisted(2) = True
#.   Object:
#.     - GLO_PaladinOathbreaker_Event_BrokeOath(2) = True
#. TagRule: REALLY_DARK_URGE
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:00e6fdce-ad9b-9584-f96f-e218e3310081
msgctxt "h0ee25fd0g95d3g4cf1g94b5g2ad02accbb5e"
msgid "<i>Trim those gnarly toenails.</i>"
msgstr "<i>울퉁불퉁한 발톱을 정리한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = 00e6fdce-ad9b-9584-f96f-e218e3310081
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_Torturers_Assisted(2) = True
#.   Object:
#.     - GLO_PaladinOathbreaker_Event_BrokeOath(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:00e6fdce-ad9b-9584-f96f-e218e3310081
msgctxt "hcccc9546g210cg45d1g9fd4gea0d5b3564ce"
msgid "<i>Rip off a toenail with a pair of tongs.</i>"
msgstr "<i>집게로 발톱을 뽑아버린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = 0184dff8-ab7b-0bf8-eb41-b1158985b88f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:0184dff8-ab7b-0bf8-eb41-b1158985b88f
msgctxt "hc9951b28g506ag4f2dg8571g3948b4ffa320"
msgid "No. Stand someplace else and let a professional get to work."
msgstr "아니. 전문가에게 맡겨 두고 다른 곳으로 가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Liam
#. NodeID = 0405010f-f43a-b055-78d7-63c7ee8fcef9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:0405010f-f43a-b055-78d7-63c7ee8fcef9
msgctxt "h2f8f69c6ge739g4bd0g9d8cg25994934126f"
msgid "No... please!"
msgstr "안 돼... 제발!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = 040b180c-e3c8-6a34-93ba-3eeb9ba5c9da
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_HappyTorturers_Assaulted = False
#.   Object:
#.      - GLO_SafeRomance_Enabled(2) = False
#.   Tag:
#.      - PALADIN_DEVOTION(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:040b180c-e3c8-6a34-93ba-3eeb9ba5c9da
msgctxt "hff4cdf96gf1f6g499bgb2fbgd72514e38447"
msgid "This looks interesting - let me put him through his paces."
msgstr "흥미로워 보이는데, 내가 한번 해보지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = 064a366f-b31c-424b-3926-632fbdfa686c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Torturers_State_KnowDen = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:064a366f-b31c-424b-3926-632fbdfa686c
msgctxt "h6d6b53ccg35a3g4272ga621g0df360dfd3d9"
msgid ""
"The git tried t' keep the location of 'is little adventure friends a secret. "
"Made us look real stupid."
msgstr "이 자식이 자기 친구 녀석들이 어디에 있는지를 비밀로 지키려고 했어. 우릴 멍청하게 보이게 만들었지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = 06c14452-4259-5793-e03a-3cbc80886a09
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_Torturers_Goblet_Inclusion_Start(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:06c14452-4259-5793-e03a-3cbc80886a09
msgctxt "h271f4a58g2884g4538g9f76g236b614178b5"
msgid ""
"Please. We've got some tongue-looseners in the fire if you want 'em. Uhm. "
"We'll leave ya to it!"
msgstr "제발 부탁이야. 필요하다면 화로 쪽에 입을 열게 할 도구들이 몇 개 있어. 음. 그럼, 나머지 일을 맡길게!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = 098bbcc8-00d0-a4a2-89a1-79148370ab43
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Torturers_State_KnowDen = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:098bbcc8-00d0-a4a2-89a1-79148370ab43
msgctxt "hdc21de00g8421g43dbg93dfg4da0b4347ec5"
msgid ""
"The git snuck in 'ere with 'is mates, lookin' for some forgotten thing. Said "
"they ran to some kinda grove."
msgstr "이 자식이 자기 친구들이랑 이곳에 숨어 들어왔어, 잊힌 뭐시기를 찾는다고 하더군. 그리고 뭔 숲 같은 곳으로 도망친다고 했지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = 099391d9-c79c-7578-7247-b35b7ea0c2cb
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - DEN_Conflict.HeardAboutAoD(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:099391d9-c79c-7578-7247-b35b7ea0c2cb
msgctxt "h20efbbfbg4ac1g43b1g83fcgce899b2291ae"
msgid "'E doesn't wanna tell us where it is, but he can't resist forever."
msgstr "그곳이 어딘진 말하기 싫어하는 것 같지만, 영원히 버틸 순 없을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Liam
#. NodeID = 0ba8f293-3164-65e2-b150-8e86c9b4ba5a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:0ba8f293-3164-65e2-b150-8e86c9b4ba5a
msgctxt "he580c812g09ccg4d21gabdcg5a29cb144427"
msgid "P-please, stop..."
msgstr "제-제발, 그만..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = 0c7e08d0-1914-a3ab-04db-54a9e1670f6a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:0c7e08d0-1914-a3ab-04db-54a9e1670f6a
msgctxt "h9f3ade9cg72bdg43c9g8a87g92a3d62caf31"
msgid "Bah. Take 'im. Won't do ya any good. 'E just... screams."
msgstr "쳇. 마음대로 해. 어차피 네 뜻대로 되진 않을 거니까. 놈은 그냥... 비명만 지른다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = 0f8d8541-627d-cdb8-deb5-575bf0a2d769
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Moonrise_Knows_Prisoners = True
#.   Object:
#.     - GOB_Torturers_Persuaded(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:0f8d8541-627d-cdb8-deb5-575bf0a2d769
msgctxt "h4c3801a9gbbe6g4483g919cg7bf40fdc7297"
msgid ""
"Just... don't be too rough, maybe? Moonrise Towers might still want to take "
"'im."
msgstr "부디... 너무 험하게 다루지만 말아 주시겠어요? 문라이즈 타워 쪽에서 그를 데려가고 싶어 할지도 모릅니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = 11a483ae-886b-db14-6e30-5b5741b29876
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:11a483ae-886b-db14-6e30-5b5741b29876
msgctxt "h2096d87eg8971g4798g87ceg7ca59accc009"
msgid "Why are you still torturing him?"
msgstr "왜 아직도 그를 고문하고 있는 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = 15f25efb-5748-d2e6-5c05-88cfa5d7887c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_Torturers_Goblet_Inclusion_Start(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:15f25efb-5748-d2e6-5c05-88cfa5d7887c
msgctxt "h1aa352deg6996g4b66g922eg2ff6d031fe62"
msgid ""
"What, you shy or something? Fine! Muck it up and the drow'll have your head."
msgstr "뭐야, 부끄럽거나 그런 거야? 좋아! 망치면 그 드로우에게 머리를 따일 줄 알으라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Liam
#. NodeID = 16bad061-ce5d-fb3b-a180-dd00c7e08b7d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Torturers_State_KnowDen = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:16bad061-ce5d-fb3b-a180-dd00c7e08b7d
msgctxt "ha87e04dfg4f6dg4935g8d47ge3516c4533d1"
msgid "AARGH! P-please, we... t-to the east."
msgstr "아아아악! 제-제발, 우린... 도-동쪽으로."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = 1b4d752c-c43c-f7c8-7252-73b6f6f2b96d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Torturers_State_KnowDen = True
#. SetFlags:
#.   Dialog:
#.     - GOB_TorturedAdventurer_Event_SoftOption(2) = True
#. TagRule: REALLY_DARK_URGE
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:1b4d752c-c43c-f7c8-7252-73b6f6f2b96d
msgctxt "h5189682bgdc48g43aegb167gd0bf2aada38e"
msgid "BEG for mercy. BEG! BEG!"
msgstr "<b>살려달라고</b> 말해. 목숨을 구걸하라고! <b>어서</b>!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = 1b4d752c-c43c-f7c8-7252-73b6f6f2b96d
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Torturers_State_KnowDen = True
#. SetFlags:
#.   Dialog:
#.     - GOB_TorturedAdventurer_Event_SoftOption(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:1b4d752c-c43c-f7c8-7252-73b6f6f2b96d
msgctxt "h962a8614gb3e9g4bc3gb8e9g2639444aa4ff"
msgid "Would you like to start begging for mercy now, or...?"
msgstr "지금부터 자비를 구할래, 아니면...?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Narrator
#. NodeID = 1e72173d-93c2-1a07-3f07-bac741ceffe0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount1(2) = False
#.   Tag:
#.      - TRUESOUL(2) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount1(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:1e72173d-93c2-1a07-3f07-bac741ceffe0
msgctxt "h70b45436ge5aag499dg8f9cg4f33a37e3c6f"
msgid "*A shiver runs across your mind... You feel sated.*"
msgstr "*전율이 불현듯 머릿속을 스쳐 지나가고... 만족감이 듭니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = 20d301e6-dff9-70fd-b7fb-f68d0513590c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_5 = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:20d301e6-dff9-70fd-b7fb-f68d0513590c
msgctxt "hfe2268c7g00b4g4428gba5eg448f979988ce"
msgid "Come Grush, let's go. I don't think I got the stomach for this."
msgstr "이리 와, 그루쉬. 가자. 나도 이건 감당할 수 없을 것 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Liam
#. NodeID = 223cef9f-55a6-d016-0f51-e862210a5a4e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:223cef9f-55a6-d016-0f51-e862210a5a4e
msgctxt "h512a7bccg5a66g457bg847fg09a62f3ee84e"
msgid "Aargh! S-stop! Please... s-stop this!"
msgstr "아아악! 머-멈춰! 제발... 그-그만해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = 23173a34-1ff2-65ad-7dd7-0bf6afa25de9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 50db693e-1d65-b503-8056-99bf936af658_MindHasBeenRead = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:23173a34-1ff2-65ad-7dd7-0bf6afa25de9
msgctxt "h38fec557ge501g41d8gba41g9cce0c3e642a"
msgid ""
"<i>Damn it!  Dunno why Minthara hasn't killed us yet, but it ain't gonna "
"last.</i>"
msgstr "<i>제기랄! 왜 민타라가 아직 우릴 죽이지 않았는지 모르겠지만 곧 우린 죽게 될 거야.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = 238342c0-2f75-e854-9d75-ac84642b7f3e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Torturers_AskedWhatTheyAreDoing(2) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_Torturers_AskedWhatTheyAreDoing(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:238342c0-2f75-e854-9d75-ac84642b7f3e
msgctxt "hbc9b1a96gfe85g4a71ga45bg4253db6deb5e"
msgid "Why are you torturing him?"
msgstr "왜 그를 고문하고 있는 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = 23b7781a-ae67-57bf-db2f-d39aeabf7d86
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Torturers_State_KnowDen = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:23b7781a-ae67-57bf-db2f-d39aeabf7d86
msgctxt "h3e75680dg2029g4fc2gacb9g99ab5bfdad37"
msgid ""
"He needs to die slowly, PAINFULLY. So keep yer amateur hands off him, or "
"you're next!"
msgstr "녀석은 천천히 고통스럽게 죽어야 해. 그러니 솜씨 없는 손으로 건드리지 마. 그렇지 않으면 다음은 네 차례가 될 거야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = 26640271-d6e8-f89b-ec8b-fdccaefbb1fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:26640271-d6e8-f89b-ec8b-fdccaefbb1fe
msgctxt "h17431925gc828g44f7g98e4g4953cea30c14"
msgid "You again? Wanna join 'im this time?"
msgstr "다시 왔네? 이번엔 한번 해볼래?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = 278948d0-a349-7526-d348-27e63f12ea86
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Torturers_State_KnowDen = True
#. TagRule: HUMAN
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:278948d0-a349-7526-d348-27e63f12ea86
msgctxt "hca338226g705bg4686gae33g64402acde135"
msgid "A human torturin' a human? HA! I'd like to see that."
msgstr "인간이 인간을 고문한다고? 하! 그거 정말 보고 싶은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = 278948d0-a349-7526-d348-27e63f12ea86
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Torturers_State_KnowDen = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:278948d0-a349-7526-d348-27e63f12ea86
msgctxt "h21713a90g0718g489agbfacga5b9ee5bbd8d"
msgid "Bloodthirsty, ain't ya? HA. Go on then: make 'im scream."
msgstr "아주 피에 목말랐구나? 하. 어디 해봐. 비명을 지르게끔 만들라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = 2bd8aabc-0b3b-117f-7d99-086fb20dfa7e
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_DARK_URGE
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:2bd8aabc-0b3b-117f-7d99-086fb20dfa7e
msgctxt "hd9819943g8601g4c89g9c64gc89f97105a9c"
msgid ""
"<i>Don't let yourself fall further into this pit. Attack the goblins and "
"save him.</i>"
msgstr "<i>더 깊은 수렁에 빠지지 않는다. 고블린을 공격하고 남자를 구한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = 2bd8aabc-0b3b-117f-7d99-086fb20dfa7e
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:2bd8aabc-0b3b-117f-7d99-086fb20dfa7e
msgctxt "h27029b1cgd719g4f2eg8b84gd87abef98a5c"
msgid "<i>Attack the goblins.</i>"
msgstr "<i>고블린을 공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = 2c3987d0-e1a7-8fcb-b864-5079aa273384
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Torturers_State_KnowDen = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:2c3987d0-e1a7-8fcb-b864-5079aa273384
msgctxt "hfa57bff6ge3a7g4e7bg8430g0eb622b89b0a"
msgid ""
"The git didn't wanna work with us. Tried t' keep the whereabouts of 'is gang "
"a secret."
msgstr "이 자식은 우리한테 협조하지 않았어. 놈들 무리의 은신처를 숨기려고 노력했지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Narrator
#. NodeID = 2d3ad22c-122f-ce7a-8517-e9031f4522cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:2d3ad22c-122f-ce7a-8517-e9031f4522cf
msgctxt "hc62e670cg3d58g457agaab2gf6861bc616fd"
msgid "*The stench of charred flesh wafts over you.*"
msgstr "*그을린 살의 악취가 당신의 코를 찌릅니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = 2e2e28b9-6e08-8822-8a75-c570d2c00a49
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Torturers_HasMet_Spike(2) = True
#.   Tag:
#.      - DROWELF(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:2e2e28b9-6e08-8822-8a75-c570d2c00a49
msgctxt "h2fa5a229g04d3g4a71gb17fgb89282145e83"
msgid "Oh. You're back. Uh - he's all yours."
msgstr "오. 다시 왔군. 그럼... 저놈은 마음대로 해도 돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = 2ed05a04-92a0-669f-1a8a-e5f315ae4b85
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:2ed05a04-92a0-669f-1a8a-e5f315ae4b85
msgctxt "h3251987ag020cg4585g9221gf821cbeb6fdd"
msgid ""
"<i>One mistake and she'll have our heads. All because this stupid dimwit "
"didn't wanna talk.</i>"
msgstr "<i>실수 한 번이면 우리 목이 날아가게 될 거야. 이게 다 저 멍청한 녀석이 입을 열지 않아서 그래.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Narrator
#. NodeID = 306481ae-256c-a746-d4a3-27805267f561
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount5(2) = False
#.   Tag:
#.      - TRUESOUL(2) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount5(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:306481ae-256c-a746-d4a3-27805267f561
msgctxt "h8f1279ccg131fg4ff0g8b76g4e68d7ea599d"
msgid ""
"*Your blood runs quicker, feeding the gnawing absence at the centre of your "
"mind.*"
msgstr "*피가 더 빨리 흐르면서, 당신의 정신 한가운데를 좀먹는 허전함을 양분으로 채웁니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = 30918600-357e-603d-eb3c-2af9f5d12bc0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_Torturers_Failed = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:30918600-357e-603d-eb3c-2af9f5d12bc0
msgctxt "hf4500071g7976g4dfaga869g1082abfe8740"
msgid ""
"What? You think you can order me around? Get lost 'fore I beat ya to a pulp."
msgstr "뭐야? 네가 뭔데 남한테 명령질이야? 맞아서 피떡이 되고 싶지 않다면 꺼져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = 321c9c5a-0f17-37cd-1932-0bfe77f0f905
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DROWELF(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:321c9c5a-0f17-37cd-1932-0bfe77f0f905
msgctxt "h6d937e3dg9812g47e0g9225gbfebf50d3691"
msgid "'Course, now that you're 'ere... we'd gladly let ya take over!"
msgstr "물론, 이제 네가 왔으니... 기꺼이 네게 맡기도록 할게!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = 32a5b0b5-1ba5-2980-77ba-ae43d26e40c3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 50db693e-1d65-b503-8056-99bf936af658_MindHasBeenRead = True
#. SetFlags:
#.   Object:
#.     - GOB_Torturers_Goblet_Inclusion_Start(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:32a5b0b5-1ba5-2980-77ba-ae43d26e40c3
msgctxt "h63f3cd72g589dg4238g99d6gb5cde5d784b6"
msgid "Orders from Minthara. You wouldn't question <i>her</i>, would you?"
msgstr "민타라의 명령이야. <i>그녀의</i> 말에 의문을 제기하는 건 아니겠지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = 353049b1-a011-e248-21d8-294429b2617f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(2) = False
#.   Tag:
#.      - TRUESOUL(2) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:353049b1-a011-e248-21d8-294429b2617f
msgctxt "h50aa9c47g74dbg409cgbe9cg1bad24102ef6"
msgid "Leave, both of you."
msgstr "떠나라, 너희 둘 다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = 35c998cf-f555-4173-70cc-ccae9f466173
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:35c998cf-f555-4173-70cc-ccae9f466173
msgctxt "hc214f377g1c45g431cgbf7cgcad1e3477998"
msgid ""
"O-of course. Uhm - but maybe not <i>this </i>club. It ain't worthy of you "
"drow types."
msgstr ""
"아... 알겠어. 어... 그렇지만 이 <i>몽둥이</i>는 안 쓰는 게 좋을 거야. 너 같은 드로우들이 쓰기엔 변변찮은 무기야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = 35debad1-d8a5-2ff3-d833-0283ebe47771
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:35debad1-d8a5-2ff3-d833-0283ebe47771
msgctxt "hf2233582g522ag42a3g99f1g6281c7711230"
msgid ""
"You <i>what? </i>Think I'll stand 'ere while some pointy-eared bint explains "
"my job to me?!"
msgstr "<i>뭐라고? </i> 나더러 여기 서서 어떤 뾰족귀 계집년이 내 일을 어떻게 하는지 설명하는 걸 듣고 있으라고?!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = 3c92c1b5-fdd8-b050-b60c-036feacfd292
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:3c92c1b5-fdd8-b050-b60c-036feacfd292
msgctxt "hd1d387e3g0994g4fb6g92d6g3b261677d89b"
msgid "Look - you haven't even gone for the fingernails. Amateur!"
msgstr "봐 - 넌 손톱 작업을 하지도 않았잖아. 풋내기야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = 413d4dc8-65dc-4271-5e15-124b684977fe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Torturers_BrokeNose(2) = True
#.   Global:
#.      - GOB_Torturers_State_KnowDen = True
#. SetFlags:
#.   Global:
#.     - GOB_Torturers_Failed = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:413d4dc8-65dc-4271-5e15-124b684977fe
msgctxt "h663df26cg0074g4d58gaa82g9b3e1e7fb26e"
msgid "And 'e was just about to scream. Get out. Out!"
msgstr "막 비명을 지르려던 참이었는데. 나가. 나가라고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Narrator
#. NodeID = 44edf2c1-0ea8-34e4-5704-0284831926d1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - GLO_TadpoleIntro_NPC(2) = False
#. SetFlags:
#.   User:
#.     - GLO_TadpoleIntro_NPC(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:44edf2c1-0ea8-34e4-5704-0284831926d1
msgctxt "h4cad38a2gb6ccg4475g90fcg021d84d3de27"
msgid ""
"*A strange symbol glows, marked on their flesh, and something within you "
"stirs in response.*"
msgstr "*그들의 살갗에 새겨진 기묘한 상징이 빛나고, 이에 반응하여 당신 내면의 무언가가 꿈틀거립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Shadowheart
#. NodeID = 48128627-64d9-bfeb-3cf0-6cd90bd9c4d2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#. SetFlags:
#.   Dialog:
#.     - GOB_Torturers_Knows_ShadowheartAdvice(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:48128627-64d9-bfeb-3cf0-6cd90bd9c4d2
msgctxt "ha65526f8ge34fg412cgb98eg1ea222f9dc57"
msgid ""
"Say we'll take over. His work is sloppy; he'll kill the prisoner too quickly."
msgstr "우리가 상황을 접수한다고 해. 이 녀석은 일을 제대로 처리하질 못하니, 포로를 금방 죽여버리고 말 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = 482ee8c2-2c99-dcf7-dcf4-8a0f997f894d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:482ee8c2-2c99-dcf7-dcf4-8a0f997f894d
msgctxt "h1ae98dd0ge7b7g4a62g9fcbg29c1952ae4e1"
msgid ""
"What d'ya think you're doin'? Ya tryin' to get into my head? I'll teach ya!"
msgstr "뭐 하는 짓거리야? 내 생각을 읽으려고? 내가 알려주지!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Liam
#. NodeID = 4e94ee00-bf1a-f207-fc06-d54519398ff2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_TorturedAdventurer_Event_SoftOption(2) = False
#.   Global:
#.      - GOB_Torturers_State_KnowDen = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:4e94ee00-bf1a-f207-fc06-d54519398ff2
msgctxt "hf4c7d40fg676eg4fa1gbcb8g1b267ea0e53b"
msgid "No! P-please, we... t-to the east."
msgstr "안돼! 제...제발, 우린... 동... 동쪽에 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
#. NodeID = 50f0542b-51a6-8291-cd3b-5220e7922438
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:50f0542b-51a6-8291-cd3b-5220e7922438
msgctxt "he34c4f1eg81a0g4a1eg87fbg0c961e589fd7"
msgid "We do all the work an' you get to finish 'im?"
msgstr "다 차려 놓은 밥상에 숟가락이나 얹겠다고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = 52308420-a1bd-3946-406e-94ccc382edd6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:52308420-a1bd-3946-406e-94ccc382edd6
msgctxt "h06a923c0gdeb1g4321g8e01g99595145c917"
msgid "I don't put on shows for <i>amateurs</i>. Leave."
msgstr "<i>풋내기</i> 상대로 보여줄 건 없어. 그만 가봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Player
#. NodeID = 54132f75-74b4-29d2-311f-44f8d5f17a67
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 0
#. CheckFlags:
#.   Local:
#.      - 3e0cc9b8-f2f1-bd11-5ff7-f347a649c9fc_MindHasBeenRead = False
#.   Script:
#.      - GEN_CanDetectThoughts_3 = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture:54132f75-74b4-29d2-311f-44f8d5f17a67
msgctxt "h4725ff84ga98ag465fg90e4g735d44496a4a"
msgid "<i>Read the goblin's thoughts.</i>"
msgstr "<i>고블린의 생각을 읽는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
#. Speaker = Torturer Spike
