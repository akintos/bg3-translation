msgctxt "h8a9dcaf4gf2a1g42f3g8d35g0798ff907a1b"
msgid "I-I-I didn't realise. Very sorry, ma'am. <i>Very </i>sorry."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Trespassing
#. Speaker = GROUP_GOB_Checkpoint_Guards
