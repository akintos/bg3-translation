msgctxt "h8ab2241eg8b2fg44c2g80e9g71020a8689c9"
msgid "*Hnr!*"
msgstr "*크흠!*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_DevilishOx_MeetAtDruidsGrove
#. Speaker = Phasm
#. NodeID = 1fd56e8d-d3be-819d-ecf9-7a320fec607c
