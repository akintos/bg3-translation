msgctxt "h41586f90gbd62g4f46gb9dbg762b6df2d820"
msgid "This one's got jokes! Almost makes me like her."
msgstr "이 녀석 재밌는데! 그녀가 거의 좋아질 정도야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush
#. Speaker = Goblin Booyahg
#. NodeID = ef4e1ab9-9f9b-42f2-5309-cc9dc763317f
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush:ef4e1ab9-9f9b-42f2-5309-cc9dc763317f
msgctxt "h206f2022g205bg441agb4e1g4ff5202e19cf"
msgid "This one's got jokes! Almost makes me like 'im."
msgstr "이 녀석 재밌는데! 그가 거의 좋아질 정도야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush
#. Speaker = Goblin Booyahg
#. NodeID = ef4e1ab9-9f9b-42f2-5309-cc9dc763317f
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush:ef4e1ab9-9f9b-42f2-5309-cc9dc763317f
msgctxt "h75cbfbcbga1b5g413dgb2e1gcfe9fad3dfef"
msgid "This one's got jokes! Almost makes me like 'em."
msgstr "이 녀석들 재밌는데! 그들이 거의 좋아질 정도야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush
#. Speaker = Narrator
#. NodeID = ef702f66-7c24-4492-9de9-ebe29853d1b8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount5(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount5(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush:ef702f66-7c24-4492-9de9-ebe29853d1b8
msgctxt "h70139961g47f3g41f5gb444gfc49be10677a"
msgid ""
"*Your blood runs quicker, feeding the gnawing absence at the centre of your "
"mind.*"
msgstr "*피가 더 빨리 흐르면서, 당신의 정신 한가운데를 좀먹는 허전함을 양분으로 채웁니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush
#. Speaker = Goblin Booyahg
#. NodeID = ef96d2a4-6aa7-cc6e-51cb-ecf91c194cc3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush:ef96d2a4-6aa7-cc6e-51cb-ecf91c194cc3
msgctxt "h063d76f8ge7beg44e8ga23dg0ff1db67b0dd"
msgid "Please, your greatness. Was an honest mistake, is all."
msgstr "부탁드립니다, 위대한 분이시여. 정말로 실수였을 뿐입니다요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush
#. Speaker = Narrator
#. NodeID = f15fabe8-0101-bcad-7ee4-851397971c53
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush:f15fabe8-0101-bcad-7ee4-851397971c53
msgctxt "h01e80ed7g7641g4645g8f93g6caad25cfe6a"
msgid "*A shiver runs across your mind... You feel sated.*"
msgstr "*전율이 불현듯 머릿속을 스쳐 지나가고... 만족감이 듭니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush
#. Speaker = Goblin Booyahg
#. NodeID = f35e4491-ed19-9b44-9377-ef82bf8f4d79
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush:f35e4491-ed19-9b44-9377-ef82bf8f4d79
msgctxt "h3c517967gf6d5g45b0g8f56ga0132eba5ff8"
msgid ""
"Here's how this goes: you take one step further an' we'll fill your front "
"with arrows."
msgstr "이렇게 될 거야: 네가 한 발짝 더 다가오면 우리는 너의 앞을 화살로 가득 채울 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush
#. Speaker = Narrator
#. NodeID = f59e05b3-0033-0aac-2f16-8f82d56fca60
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush:f59e05b3-0033-0aac-2f16-8f82d56fca60
msgctxt "h35a7c8b5g5f4fg4db5gb3ccgd4899a57dab4"
msgid ""
"*The mark glows, but you feel nothing in response. Your illithid power is "
"beyond reach until you rest.*"
msgstr "*문양이 빛나지만, 어떤 반응도 느껴지지 않습니다. 일리시드 능력을 더 사용하려면 휴식을 취해야 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush
#. Speaker = Goblin Booyahg
#. NodeID = f809b928-54b5-d9b3-3f8a-da9198e86cc5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_GoblinAmbush_State_NonCharlatanAccess = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush:f809b928-54b5-d9b3-3f8a-da9198e86cc5
msgctxt "h1538ee41gaf46g4d4dg9b4dgea39fe9151c9"
msgid "Hold up, lads! This one might be more'n we bargained for."
msgstr "가만히 있어, 얘들아! 이 녀석은 우리가 생각한 것 이상일 수도 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush
#. Speaker = Player
#. NodeID = fa4fd8db-9686-a541-c144-dbe90aa90416
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush:fa4fd8db-9686-a541-c144-dbe90aa90416
msgctxt "he4282bdbgaac5g472dg9c78g3fd2926993fe"
msgid "There'll be no skewering happening here. Now let me pass."
msgstr "여기서 돼지를 잡을 일은 없어. 이제 날 보내줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush
#. Speaker = Goblin Booyahg
#. NodeID = fab3c11e-5e91-2554-8fe4-19dcb4f1c119
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_GoblinAmbush_Event_StopSpotting = True
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush:fab3c11e-5e91-2554-8fe4-19dcb4f1c119
msgctxt "h3b4a197cg84fbg4667g9882g69737ee07fa9"
msgid ""
"Here's what I'm thinkin' - we kill you, an' I keep your ears to remember the "
"occasion."
msgstr "내 생각은 이래. 우리가 너를 죽이고, 나는 이 순간을 기억하기 위해 너의 귀를 간직하는 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush
#. Speaker = Player
#. NodeID = faf9b12f-f883-d01d-0b23-fa247212bd1e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush:faf9b12f-f883-d01d-0b23-fa247212bd1e
msgctxt "h736b9223g43dbg4d32gaacdg623c79954923"
msgid "I should pluck out your eyes. You're clearly not using them."
msgstr "네 눈알을 뽑아야겠군. 어차피 쓰는 것 같지도 않은데 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush
#. Speaker = Goblin Booyahg
#. NodeID = fbaa51a1-3b92-eaa5-427f-fa2c8155086a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_GoblinAmbush_Event_StopSpotting = True
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush:fbaa51a1-3b92-eaa5-427f-fa2c8155086a
msgctxt "hc8ee35cega245g455fg855eg73fb633ece7d"
msgid "This ought to be fun. Lads!"
msgstr "이거 재밌겠네. 얘들아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_AD_StartedCombat
#. Speaker = Goblin Booyahg
#. NodeID = 872360b1-aeae-6ac9-5717-ae1253e7a38e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_AD_StartedCombat:872360b1-aeae-6ac9-5717-ae1253e7a38e
msgctxt "hce2744aag42e1g4b03ga80dgc4410b5bf980"
msgid "You must got a death wish, sneakin' around in <i>my </i>town."
msgstr "죽고 싶은 모양이군. 감히 내 동네에서 어슬렁거리다니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards
#. Speaker = Narrator
#. NodeID = 017ab2bd-838b-4073-86d2-c36b6354407c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount6(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount6(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards:017ab2bd-838b-4073-86d2-c36b6354407c
msgctxt "hb827f492g5ac2g40c3gbc79g2e3063fd419f"
msgid ""
"*The presence deep in your mind is awake, unblinking. This is it. A single "
"word pervades your consciousness: 'Soon'.*"
msgstr ""
"*당신의 정신 속 깊이 자리잡은 존재가 태연스레 깨어납니다. 올 것이 왔군요. 한 단어가 당신의 의식 속으로 스며듭니다. ‘곧’*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards
#. Speaker = Player
#. NodeID = 04dd840f-d1c4-e42e-be75-f4bc87a6ec53
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards:04dd840f-d1c4-e42e-be75-f4bc87a6ec53
msgctxt "h365a55c5ged59g4626g82ceg9736c3ac078b"
msgid "<i>Take a deep breath - and attack.</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards
#. Speaker = Goblin Warrior
#. NodeID = 0f2e4e33-33db-4ffc-8cae-e860f7af9354
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards:0f2e4e33-33db-4ffc-8cae-e860f7af9354
msgctxt "h0701cba0g1a89g4fe6ga745g4cefc7031c36"
msgid "This ain't your town, friend. But it can be your grave."
msgstr "이 곳은 네 고향이 아냐, 친구. 하지만 네 무덤이 될 수는 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards
#. Speaker = Goblin Warrior
#. NodeID = 117c345f-9fd3-f714-fc17-8b2cd9e3c7bc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_GoblinAmbush_GoblinsPacified = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards:117c345f-9fd3-f714-fc17-8b2cd9e3c7bc
msgctxt "h07b5f2d6g6a40g4338gb4c3g2120a4c8fe62"
msgid ""
"Aye, now that's a beat! Needs drumming, though - got some skulls inside you "
"could use. Go on."
msgstr "그래, 지금 그 박자야! 그래도 북 같은걸로 칠 필요가 있지 - 안에 사용할 수 있는 두개골이 있어. 가 보라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards
#. Speaker = Narrator
#. NodeID = 11c536ae-dde1-4f79-ab05-21c13733b3d5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount5(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount5(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards:11c536ae-dde1-4f79-ab05-21c13733b3d5
msgctxt "hcdf8cd64g2d51g49a5ga76ag6c64144e7e6b"
msgid ""
"*Your blood runs quicker, feeding the gnawing absence at the centre of your "
"mind.*"
msgstr "*피가 더 빨리 흐르면서, 당신의 정신 한가운데를 좀먹는 허전함을 양분으로 채웁니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards
#. Speaker = Goblin Warrior
#. NodeID = 18d11759-3792-4878-8b06-91686583d849
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_GoblinAmbush_State_NonCharlatanAccess = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards:18d11759-3792-4878-8b06-91686583d849
msgctxt "h36805ecfgd936g4106g863dgb06336effad9"
msgid "...A True Soul. Right. Ah - welcome to Bogrot!"
msgstr "...참된 영혼이시여. 맞습니다. 아 - 보그로트에 오신 걸 환영합니다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards
#. Speaker = Player
#. NodeID = 1ca24179-2b14-817d-aefb-892511528ac1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_GoblinAmbush_CheckpointGuards_IncreasedBribe(1) = False
#.      - FOR_GoblinAmbush_CheckpointGuards_AskedAboutBogrot(1) = True
#.   Script:
#.      - GEN_CheckPocketGold_2 = True
#. SetFlags:
#.   Object:
#.     - GEN_TransferNPCPayment_2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards:1ca24179-2b14-817d-aefb-892511528ac1
msgctxt "h057919f6g3e4bg4b58gb95ag473b4fadbcb6"
msgid ""
"How about a donation instead? Some coin for the town. ([463b0f43-5410-412d-"
"aba3-875cf81c38ca])"
msgstr ""
"대신 기부 받는 건 어때? 마을을 위한 동전 몇 푼이야. ([463b0f43-5410-412d-aba3-875cf81c38ca])"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards
#. Speaker = Player
#. NodeID = 2629b77e-22e9-1a25-dcd8-29396b169bcb
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#. TagRule: BERSERKER
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards:2629b77e-22e9-1a25-dcd8-29396b169bcb
msgctxt "hbb1d9b02g8842g4008gbfe5g15c830c0ce45"
msgid "<b><i>ROAR.</i></b>"
msgstr "<b><i>크아아.</i></b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards
#. Speaker = Player
#. NodeID = 2629b77e-22e9-1a25-dcd8-29396b169bcb
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards:2629b77e-22e9-1a25-dcd8-29396b169bcb
msgctxt "h6de2fcf2g2eb6g4a46g8fcdg1f2078aa74e9"
msgid "You get <b>nothing</b>."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards
#. Speaker = Player
#. NodeID = 263828ec-6de5-475d-91f1-f01091da8a17
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards:263828ec-6de5-475d-91f1-f01091da8a17
msgctxt "h7e803c95g5ba9g4ae5g9094gb80d8947c0d9"
msgid "<i>You</i> do not give orders to <i>me</i>."
msgstr "<i>너</i>는 <i>나</i>에게 명령 할 수 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards
#. Speaker = Narrator
#. NodeID = 3887795a-2539-47b2-8086-214e55236eeb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Tag:
#.     - TRUESOUL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards:3887795a-2539-47b2-8086-214e55236eeb
msgctxt "h5804b90bg5592g4a31gac9fgf825ff411a15"
msgid ""
"*Your mind is full, bursting with ecstasy and terror. Finally, it is coming. "
"You are becoming.*"
msgstr "*당신의 정신이 황홀경과 공포로 가득 차오릅니다. 마침내, 때가 됐군요. 당신은 변화 중입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards
#. Speaker = Goblin Warrior
#. NodeID = 3a6cf434-e453-b909-78c4-b70db8820a81
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards:3a6cf434-e453-b909-78c4-b70db8820a81
msgctxt "h94e15bfagc215g43cagbe04ga77076a02aa0"
msgid "Well that's just bloody rude."
msgstr "그래 그게 바로 빌어먹을 무례함이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards
#. Speaker = Narrator
#. NodeID = 3adb29a1-5a71-3c4b-0561-18dd53fc2ac8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - GLO_TadpoleIntro_NPC(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards:3adb29a1-5a71-3c4b-0561-18dd53fc2ac8
msgctxt "h73d60938gc581g49d2gbf7eg114e4a3f4857"
msgid "*As the symbol glows, power courses through you. <i>Authority</i>.*"
msgstr "*문양이 빛나며, 몸에 흐르는 힘이 느껴집니다. <i>권위</i>.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards
#. Speaker = Goblin Warrior
#. NodeID = 5920aeef-918f-0164-6ee0-5f70136f80d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards:5920aeef-918f-0164-6ee0-5f70136f80d0
msgctxt "h0ad9b32bg225cg4703g9800g4ef7010a1a81"
msgid "Go wake him up - and tell 'im I sent ya."
msgstr "가서 그를 깨워 - 그리고 내가 너를 보냈다고 말해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards
#. Speaker = Player
#. NodeID = 59e4a53a-4d82-67b1-f57d-bb9ae89c0656
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - FOR_GoblinAmbush_CheckpointGuards_AskedAboutBogrot(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards:59e4a53a-4d82-67b1-f57d-bb9ae89c0656
msgctxt "h13be1a3eg8c6fg4b87gb4aag86ca65c2aa01"
msgid "'Bogrot'?"
msgstr "'보그로트'?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards
#. Speaker = Player
#. NodeID = 5a58ed4d-466f-6a8c-8141-4b369fde3f41
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - FOR_GoblinAmbush_CheckpointGuards_AskedAboutBogrot(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards:5a58ed4d-466f-6a8c-8141-4b369fde3f41
msgctxt "h7bab0007g24f2g4dfcg92a6g8ae6e5da951f"
msgid "And you'll let me pass?"
msgstr "그러면 나를 보내줄 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards
#. Speaker = Goblin Warrior
#. NodeID = 5ae76f97-913d-4287-e5a1-eed29ab46074
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - FOR_GoblinAmbush_GoblinsPacified = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards:5ae76f97-913d-4287-e5a1-eed29ab46074
msgctxt "h9d7db5e4g4d54g4f1fg8110g8f6d55d66b3b"
msgid "Go on - more of us inside."
msgstr "계속 가봐 - 안쪽엔 우리편이 더 많으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards
#. Speaker = Goblin Warrior
#. NodeID = 5ba7e76b-6f9a-44e9-5e3b-7b5c0bb2fc83
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_GoblinAmbush_GoblinsPacified = True
#.     - FOR_GoblinAmbush_State_NonCharlatanAccess = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards:5ba7e76b-6f9a-44e9-5e3b-7b5c0bb2fc83
msgctxt "h878f0f74gcbb3g407egb65ag810794cce0e4"
msgid ""
"Temper on you, eh? Fine - keep yer goods. Our crowd own this town - we can "
"take you any time we want."
msgstr "흥분했나, 어? 괜찮아 - 네 물건은 가져. 우리 패거리가 이 마을을 소유한다 - 우리가 원할 때 언제든지 널 잡을 수 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards
#. Speaker = Player
#. NodeID = 6910f994-228b-ab45-9e49-bec27121b312
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards:6910f994-228b-ab45-9e49-bec27121b312
msgctxt "he3a7ea3cg096fg4973g9452g635714b95bb1"
msgid ""
"Then my search is over - I'm actually here to write the Ballad of Bogrot."
msgstr "그러면 내 조사는 끝났어 - 나는 사실 보그로트의 발라드를 쓰기 위해 여기 왔어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards
#. Speaker = Goblin Warrior
#. NodeID = 6a36abf9-8fa3-4073-9447-4f679988b479
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_GoblinAmbush_GoblinsPacified = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards:6a36abf9-8fa3-4073-9447-4f679988b479
msgctxt "hc29699feg9f5dg47cag8022g5d79ba2d1c7e"
msgid "Or whatever you want to call it - 's your town now. Heh."
msgstr "어떻게 부르든 상관없습니다 - 이 마을은 이제 당신 것입니다. 헤헤헤."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards
#. Speaker = Goblin Warrior
#. NodeID = 6fd6fb81-14b3-26d2-21aa-ba2f5950ed6c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards:6fd6fb81-14b3-26d2-21aa-ba2f5950ed6c
msgctxt "h8d57572cgeee4g43e1g89c9g20d5caafd736"
msgid "'Allo and welcome to Bogrot! Now, kindly - giz all your stuff."
msgstr "안녕하세요, 보그로트에 오신 것을 환영합니다! 이제, 부디 - 네놈들 물건 모두 내놔."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards
#. Speaker = Goblin Warrior
#. NodeID = 7146db01-814b-5e62-a9de-4a3b295f48ac
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DROWELF(1) = False
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards:7146db01-814b-5e62-a9de-4a3b295f48ac
msgctxt "heb10b11fg42b6g4c69g8e9eg8543f35240d0"
msgid ""
"I'm lookin' - just ain't seeing much. Might be we need to carve you open?"
msgstr "보고 있다 - 근데 자세히 보이지가 않네. 네 놈을 찢어 열어야 할지도 모르겠네?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards
#. Speaker = Player
#. NodeID = 76150824-f131-4a57-6fff-2e30d3f353f9
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 20
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards:76150824-f131-4a57-6fff-2e30d3f353f9
msgctxt "h82493d17ga935g4681ga678g8a1137e4ba02"
msgid "It's a fine day, my friend. Why spoil it with killing?"
msgstr "좋은 날이야, 친구. 왜 살인으로 이 좋은 날을 망치려고 하지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards
#. Speaker = Goblin Warrior
#. NodeID = 77597684-2f6b-0f83-52f3-4e61b943dec8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards:77597684-2f6b-0f83-52f3-4e61b943dec8
msgctxt "h55e9fe04g3909g43f3g968cg41217511e390"
msgid "Blegh. Reckon you'll make sweeter sounds once we slice you a bit."
msgstr "불쾌하군. 네놈을 얇게 썰어보면 더 달콤한 소리를 낼 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards
#. Speaker = Goblin Warrior
#. NodeID = 78235703-6c97-08f8-1c33-229470116313
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - FOR_GoblinAmbush_CheckpointGuards_IncreasedBribe(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards:78235703-6c97-08f8-1c33-229470116313
msgctxt "hfe02d5efg6e6bg4777g905cgf8175ec7c76c"
msgid ""
"Killing you would <i>make</i> my day, but I don't fancy cleaning up your "
"guts afterwards. Hand over your stuff - now."
msgstr ""
"네놈을 죽이는 것은 내 오늘을 즐겁게 <i>만들겠지만</i>, 그런 후 네 내장을 치우는 것은 별로 내키지 않아. 네 물건을 내놔 - "
"당장."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards
#. Speaker = Goblin Warrior
#. NodeID = 7b54e58f-1cac-949a-1d26-be3dbed3c984
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards:7b54e58f-1cac-949a-1d26-be3dbed3c984
msgctxt "h5545ecdag30cdg48b5g836eg3409b595affb"
msgid "So now it's Bogrot. And you got to give over your goods."
msgstr "어쨌든 이제부터 여긴 보그로트야. 그리고 네 물건들을 넘겨 줘야 하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards
#. Speaker = Player
#. NodeID = 7e9b9307-c0d1-e9ad-db05-5ca720a0d16c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DROWELF(1) = True
#. SetFlags:
#.   Global:
#.     - FOR_GoblinAmbush_State_DrowAutoPass = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards:7e9b9307-c0d1-e9ad-db05-5ca720a0d16c
msgctxt "hcaf19186g498cg47fbg9980g2db1d9ab7174"
msgid ""
"I'll give you another chance. Look at me again and choose your words "
"carefully."
msgstr "한번 더 기회를 줄게. 다시 나를 봐봐. 그리고 조심스럽게 어떤 말을 할지 선택해 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards
#. Speaker = Player
#. NodeID = 81968083-fdfe-9879-2b1a-4e69c74a4deb
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards:81968083-fdfe-9879-2b1a-4e69c74a4deb
msgctxt "h77590b3fg9993g43c0g8334g27650bcd39db"
msgid "Nice town. I'll wipe my feet on your corpse before entering."
msgstr "멋진 마을이군. 들어가기 전에 네 시체로 발이나 닦아야겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards
#. Speaker = Player
#. NodeID = 86254aac-29f0-d1bb-3ad7-f87132c68922
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards:86254aac-29f0-d1bb-3ad7-f87132c68922
msgctxt "hd54d457bg2f48g446ag86c4g526fe44e40df"
msgid "'Bogrot, fair Bogrot - with hills as green as goblin snot.'"
msgstr "'보그로트, 아름다운 보그로트- 고블린의 콧물처럼 푸른 언덕이 있는 곳.'"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards
#. Speaker = Player
#. NodeID = 8fd3e104-879e-ed80-73e9-76648c7ff4c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards:8fd3e104-879e-ed80-73e9-76648c7ff4c8
msgctxt "h0d6de010gb4b9g4bc9ga734g1573b0e03337"
msgid "It's not ready - I need to see the town first."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards
#. Speaker = Goblin Warrior
#. NodeID = a1b79e94-48b2-3214-d4c8-5486ba4442a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards:a1b79e94-48b2-3214-d4c8-5486ba4442a8
msgctxt "h696943adgb112g4de0gadefg0450d9492031"
msgid ""
"Hah! Nah. But it'll save us scrubbing the goo off your goods when we kill "
"ya, see?"
msgstr "하하! 아니. 그래도 우리가 너를 죽일 때 네 물건에서 끈적끈적한 것을 닦아낼 필요가 없으니까 편하지. 알겠어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards
#. Speaker = Goblin Warrior
#. NodeID = a1f41bbc-e53b-e062-3ba4-91007d787a8b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DROWELF(1) = True
#. SetFlags:
#.   Global:
#.     - FOR_GoblinAmbush_GoblinsPacified = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards:a1f41bbc-e53b-e062-3ba4-91007d787a8b
msgctxt "hf6b60a8eg84c3g44b9gae4dg7ffa348e61c6"
msgid "Ah. Right. Might be I was a little rude. All drow're welcome in Bogrot."
msgstr "아. 그래. 조금 무례했을지도. 모든 드로우들은 보그로트에서 환영이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards
#. Speaker = Goblin Warrior
#. NodeID = a8fbe357-3570-aa62-4d62-4fd52a0f5431
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - FOR_GoblinAmbush_GoblinsPacified = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards:a8fbe357-3570-aa62-4d62-4fd52a0f5431
msgctxt "h21b66245g1ea6g4ae5gb255gafeb519a7310"
msgid "Well ain't you got a sunny disposition? The bugbear'll <i>hate</i> ya."
msgstr "아니, 너 왜 이렇게 쾌활해? 버그베어는 너를 <i>싫어</i>할걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards
#. Speaker = Narrator
#. NodeID = aea1965a-4d7b-b1b3-859e-9059e6cc1d28
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards:aea1965a-4d7b-b1b3-859e-9059e6cc1d28
msgctxt "hc2ead998g8c58g474dgbafeg6ac60e204a3c"
msgid ""
"*The mark glows, but you feel nothing in response. Your illithid power is "
"beyond reach until you rest.*"
msgstr "*문양이 빛나지만, 어떤 반응도 느껴지지 않습니다. 일리시드 능력을 더 사용하려면 휴식을 취해야 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards
#. Speaker = Goblin Warrior
#. NodeID = aefeba24-09bc-e720-c574-584b739fa98d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards:aefeba24-09bc-e720-c574-584b739fa98d
msgctxt "he4fb320fg25c3g48fag9e85g9f7312a587db"
msgid "Hah! You got guts. Now show me what colour they are."
msgstr "하하! 너는 간이 커 보이는구나. 이제 그게 어떤 색인지 궁금한걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards
#. Speaker = Narrator
#. NodeID = b6f1dfe2-22c9-4960-8897-f6d671f3bc26
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount2(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards:b6f1dfe2-22c9-4960-8897-f6d671f3bc26
msgctxt "h3946fd43gd774g490fga0dag29e6e47fe7c6"
msgid ""
"*Something stirs deep within you, hungry and alert... it's taking something "
"you'll never get back.*"
msgstr "*몸 깊숙한 데서 굶주리고 기민한 존재가 꿈틀댑니다... 잃으면 되찾지 못할 뭔가를 좀먹고 있군요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards
#. Speaker = Player
#. NodeID = ba9b9b74-b072-9630-b3ed-12fb0c4f1854
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DROWELF(1) = False
#.      - DROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards:ba9b9b74-b072-9630-b3ed-12fb0c4f1854
msgctxt "h758a4ee4g5fa4g4c97g9eacgb070eaf612fa"
msgid ""
"I'll give you another chance. Look at me again and choose your words "
"carefully."
msgstr "한번 더 기회를 줄게. 다시 나를 봐봐. 그리고 조심스럽게 어떤 말을 할지 선택해 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards
#. Speaker = Narrator
#. NodeID = bbde9b95-53c0-88aa-0f93-a50933598063
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - GLO_TadpoleIntro_NPC(1) = False
#. SetFlags:
#.   User:
#.     - GLO_TadpoleIntro_NPC(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards:bbde9b95-53c0-88aa-0f93-a50933598063
msgctxt "h4ba920acg4c7bg4911g9a37g47012d15aa4f"
msgid ""
"*A strange symbol glows, marked on their flesh, and something within you "
"stirs in response.*"
msgstr "*그들의 살갗에 새겨진 기묘한 상징이 빛나고, 이에 반응하여 당신 내면의 무언가가 꿈틀거립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards
#. Speaker = Player
#. NodeID = d4448a3a-e288-84d3-a843-82cbfaa6903d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards:d4448a3a-e288-84d3-a843-82cbfaa6903d
msgctxt "ha8e1f0fbgcfafg4c89gb8c7gd7fd96a62559"
msgid "'Built on BONES of goblin FOE, Bogrot bears a FEAST for CROWS!'"
msgstr "'고블린 원수의 뼈 위에 세워진 보그로트, 까마귀들에게 진수성찬을 차려주는 곳이로군!'"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards
#. Speaker = Narrator
#. NodeID = d4a82a31-4a42-4db3-8307-2006cf33853b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards:d4a82a31-4a42-4db3-8307-2006cf33853b
msgctxt "h37f40c90geb47g468cgbcabga61101fbe5ef"
msgid "*A shiver runs across your mind... You feel sated.*"
msgstr "*전율이 불현듯 머릿속을 스쳐 지나가고... 만족감이 듭니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards
#. Speaker = Narrator
#. NodeID = d6f2152c-3ae2-49bd-a654-1130d15b6fb2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount4(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
