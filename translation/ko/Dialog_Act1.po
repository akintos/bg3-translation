msgctxt "he2d2ae39g2258g4000gb356gc2b7179f0907"
msgid "At the crèche... <i>cleansing</i>..."
msgstr "양성소에서... <i>정화를</i>..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithCaptain_Dead
#. Speaker = Player
#. NodeID = c972d02f-f38a-ce0b-959a-e47971de83a8
