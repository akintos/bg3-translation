msgctxt "hf5ded73cg9f9dg4fb6g9672gbc42a585d639"
msgid "Hunter... warrior... sworn to... the Absolute..."
msgstr "사냥꾼... 전사... 절대자의... 충실한..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar_DeadDuergar_Dead
