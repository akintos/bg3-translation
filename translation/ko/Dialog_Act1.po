msgctxt "ha0128fbfgf243g4afcgb8bfg859d1f5ad4bf"
msgid "*The corpse regards you lifelessly.*"
msgstr "*시체가 생기 없는 모습으로 당신을 맞이합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_SWD_Templar
#. Speaker = Player
#. NodeID = e8b70c0d-cce1-4f62-99a6-0aa5d370e2d1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_SWD_Templar:e8b70c0d-cce1-4f62-99a6-0aa5d370e2d1
msgctxt "h17b9fa91gbe15g40e5g8356g4923d8129fa6"
msgid "Who are you?"
msgstr "너는 누구지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_SWD_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = ea18cb10-2e62-458f-948f-9f47bb1c7a70
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_SWD_Templar:ea18cb10-2e62-458f-948f-9f47bb1c7a70
msgctxt "h7a1b5309ga292g4681g8080g3eff3859e025"
msgid "Glorious combat... A powerful foe..."
msgstr "영광스러운 전투... 강대한 적..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_SWD_Templar
#. Speaker = Narrator
#. NodeID = eb54c713-078f-4a2b-a03e-49390f2f487d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_SWD_Templar:eb54c713-078f-4a2b-a03e-49390f2f487d
msgctxt "h2d9ee1fdg1ebag4c10g84eeg728bdd619bbc"
msgid "*The spell's power wanes. You can ask no more questions.*"
msgstr "*주문의 힘이 약해집니다. 더 이상 질문을 할 수 없습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_SWD_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = edcfcb3b-d93e-4146-a281-092dfcb3e78c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_SWD_Templar:edcfcb3b-d93e-4146-a281-092dfcb3e78c
msgctxt "hddef2dbbg5d68g4ee2gb13fga9341c41df7f"
msgid "The god-corpse <i>Tu'narath</i>... Palace of Whispers..."
msgstr "신의 시체 <i>튜나라쓰</i>... 속삭임의 궁전..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_SWD_Templar
#. Speaker = Narrator
#. NodeID = f2c648b9-cc4b-4956-bd75-20cc13799744
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_Killer(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_SWD_Templar:f2c648b9-cc4b-4956-bd75-20cc13799744
msgctxt "h6a85f6e8g8a5dg470eg8357g0d5105814803"
msgid "*The corpse seems willing to speak - but not to its killer.*"
msgstr "*시체는 말할 의지가 있지만, 자신을 죽인 자와 대화하고 싶지는 않은 듯 합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_SWD_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = f36895a0-d050-09c6-7417-842fe8fc1f43
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_SWD_Templar:f36895a0-d050-09c6-7417-842fe8fc1f43
msgctxt "h0f0bc3eeg97b7g4f7cgad95gc56975fbf573"
msgid "All... Creation... Made <i>ghaik</i>..."
msgstr "모든... 피조물이... <i>게이크</i>로..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_SWD_Templar
#. Speaker = Player
#. NodeID = fb2c1296-ac17-de83-29d0-4f695ab0508e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 812a411b-dc09-8e55-f674-fb10c5ec1992_AskedGrandDesign = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#.   Tag:
#.      - REALLY_GITHYANKI(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_SWD_Templar:fb2c1296-ac17-de83-29d0-4f695ab0508e
msgctxt "haf51ce05g2f2dg47a4gaae2gd75aa68af110"
msgid "What is the Grand Design?"
msgstr "원대한 설계라는 게 뭐지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Player
#. NodeID = 007b942b-8e29-5746-3547-6e41866debd0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CRE_GithInfirmary_State_CharacterUsedDevice(6) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:007b942b-8e29-5746-3547-6e41866debd0
msgctxt "hb7d694fdg3ebeg45f5ga407g30c922993492"
msgid ""
"Remember the <i>zaith'isk</i>? These gith can't be trusted. Follow my lead - "
"I'll choose the right path."
msgstr "<i>제이트이스크</i>를 잊은 건 아니지? 이 기스들은 믿을 수 없어. 내가 하자는 대로 해. 제대로 된 길을 고를 테니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Player
#. NodeID = 06b5be59-af36-6314-797d-86b97b85cff4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:06b5be59-af36-6314-797d-86b97b85cff4
msgctxt "h09b60ddeg4de0g4908g8c8cgb6ad4ac50dc3"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 078e3d74-932b-8074-55ab-a7e88fe64375
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:078e3d74-932b-8074-55ab-a7e88fe64375
msgctxt "hb8894a8cg76dbg4f53g8892ge14b83bba09f"
msgid "This is what we have all been training for."
msgstr "우리 모두 이런 상황을 위해 훈련을 해 왔지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 0add8002-3286-8254-12b2-17f355f787df
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:0add8002-3286-8254-12b2-17f355f787df
msgctxt "ha9163d3fg3b84g4de5ga740g5b42843c1362"
msgid "You really have no idea what it is, do you?"
msgstr "네 녀석은 그 물건이 무엇인지 정말 하나도 모르는군. 그렇지 않느냐?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 0b4bf81d-8fb9-7cf0-4bf9-36f5647f53e5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:0b4bf81d-8fb9-7cf0-4bf9-36f5647f53e5
msgctxt "ha4c515b6g55c1g47edg9423gaca3595c3d0a"
msgid ""
"It was a vision of the future. Luckily, our queen is here to guide us. She "
"will lead us to victory."
msgstr "있음 직한 미래의 모습이지. 다행히도, 여왕께서는 여기에서 우리를 인도하신다. 그분께선 우리를 승리로 이끄실 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Player
#. NodeID = 0b87f22c-39e7-f4ff-54db-87726e0e96f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:0b87f22c-39e7-f4ff-54db-87726e0e96f4
msgctxt "hef5f06ecg8caeg4a3bgae2bge964555f3d89"
msgid "On second thoughts, I don't need anything of yours."
msgstr "다시 생각해 보니, 네 보상 따윈 받고 싶지 않아. "

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 1336e074-b069-478a-3427-7217f51b86dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:1336e074-b069-478a-3427-7217f51b86dc
msgctxt "hfdf660e7g8486g4dc8gbe10g7d8ffb97ab63"
msgid ""
"We took an interest in you when you became involved with this 'Absolute' "
"cult. A pestilence of infected slaves - the first symptom of the Grand "
"Design in action."
msgstr ""
"우리는 네가 이 '절대자' 교단과 연관되었을 때부터 너를 눈 여겨 봤지. 지금 감염된 노예들이 역병처럼 퍼지고 있다. 원대한 설계가 "
"시작되었다는 첫 번째 조짐이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 139342b2-854a-b4cd-1cfc-3d6cbcfcb4c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:139342b2-854a-b4cd-1cfc-3d6cbcfcb4c9
msgctxt "hc970239cg840ag4471gb0efg1f0186ad273b"
msgid "Indeed? And what does it protect you from?"
msgstr "그렇단 말이지? 이것이 무엇으로부터 너희를 보호하느냐?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 13cc9043-3228-88ff-8fe9-1d9d742e7bea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:13cc9043-3228-88ff-8fe9-1d9d742e7bea
msgctxt "h918610c4g0f97g454dg8ed3g968743939d84"
msgid ""
"The <i>ghaik </i>are about to execute their Grand Design and you seek to "
"bargain. <i>P'hak'va.</i>"
msgstr "<i>게이크</i>놈들은 원대한 설계를 실행하기 시작했는데 네 녀석은 거래 따위나 하려고 하고 있군. <i>프하크바.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 177c9ffa-16cc-e736-fb7a-c22e47ad60f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:177c9ffa-16cc-e736-fb7a-c22e47ad60f4
msgctxt "h03187f89g9faag4b4ega1c6g0657cbca438b"
msgid "You have accomplished much since. I am pleased to finally meet you."
msgstr "그 뒤로 많은 걸 이뤘더군. 마침내 그대를 만나게 되어 기쁘다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 181694dc-c70d-1f34-99b3-b8d403ebe515
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_State_SecurityOfficeHostile = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:181694dc-c70d-1f34-99b3-b8d403ebe515
msgctxt "h45cca7e0g083bg4368g8750g3650d10929b5"
msgid "Your illustrious adventure ends here. <i>Hta'zith!</i>"
msgstr "네 녀석의 그 대단한 여정도 여기서 끝이다. <i>흐타지쓰!!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 1963036e-1952-5cc5-188b-1a6051d8a017
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:1963036e-1952-5cc5-188b-1a6051d8a017
msgctxt "h00f66ca9g6458g4cc6gb988g72fcaad8f011"
msgid ""
"Did your crèche teach you nothing? That knowledge belongs to Queen Vlaakith "
"alone. It is not for us to know nor question."
msgstr "양성소에서 배운 게 없는 것이냐? 그 지식은 오직 블라키스 여왕님의 것이다. 우리는 알아서도, 궁금해해서도 안 된다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Player
#. NodeID = 1b8ae17d-45d2-051c-e571-8d1d34acb4fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:1b8ae17d-45d2-051c-e571-8d1d34acb4fc
msgctxt "hed6e6ae0g3aabg420eg8b5dg638207446ee2"
msgid "The tadpole in my head."
msgstr "내 머릿속 올챙이 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Player
#. NodeID = 23657f10-3f34-6cb1-b30d-7d873de42f23
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:23657f10-3f34-6cb1-b30d-7d873de42f23
msgctxt "h09cec520g08b3g4a99g98dcgfdab2764da25"
msgid "Never."
msgstr "절대 안 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = GROUP_Daisy
#. NodeID = 24b3d1ff-0a64-cfd3-f498-3906c1f9098c
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DAISY_MALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:24b3d1ff-0a64-cfd3-f498-3906c1f9098c
msgctxt "h5efc5b45ge371g4ebfg8956g9bae7ecc4c34"
msgid "No..."
msgstr "안 돼..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = GROUP_Daisy
#. NodeID = 24b3d1ff-0a64-cfd3-f498-3906c1f9098c
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DAISY_FEMALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:24b3d1ff-0a64-cfd3-f498-3906c1f9098c
msgctxt "hdaab507bg8972g4c81g92c9gaacc4ab175d3"
msgid "No..."
msgstr "안 돼..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 27ad7833-9607-8da3-55d9-1e3702ea3d9d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:27ad7833-9607-8da3-55d9-1e3702ea3d9d
msgctxt "h3cc5c094g0100g47cegbc03gfd13dec909a1"
msgid ""
"Imagine that <i>everywhere</i>. Wants, needs, choice - all would cease to be."
msgstr "그것이 <i>사방에</i> 퍼진다고 상상해 봐라. 욕구, 필요, 의지... 모든 게 사라질 테지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 2b42a687-09c5-870f-52c0-d864b8e166ff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:2b42a687-09c5-870f-52c0-d864b8e166ff
msgctxt "h42582f27g22f2g4784gaecdgaf35bd74ff86"
msgid ""
"The Grand Design is what all <i>ghaik</i> seek. The restoration of the "
"Illithid Empire, which spanned the entirety of the multiverse."
msgstr "원대한 설계란 다중 우주 전체에 걸쳐 존속했던 일리시드 제국을 부활시키는 것이다. 모든 <i>게이크</i>들의 염원이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Player
#. NodeID = 2b9fa8f3-dd23-5219-231a-ad4f3f6af338
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WARLOCK(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:2b9fa8f3-dd23-5219-231a-ad4f3f6af338
msgctxt "h98fec1ccg70c8g4e82gb9e7g4b25db3ec2f3"
msgid ""
"Give me a treasure from the Githyanki Empire's coffers. One of immense power."
msgstr "기스양키 제국의 보물을 줘. 강대한 힘을 지닌 보물 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Player
#. NodeID = 2cc53ca4-44fe-5dbc-8fdf-86c31cc5cb54
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: WARLOCK
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:2cc53ca4-44fe-5dbc-8fdf-86c31cc5cb54
msgctxt "h9c10676bg0d66g42b3g9a32g035345e73cf3"
msgid ""
"Hand over an artefact of immense power for <i>nothing</i> in return? You do "
"insult me."
msgstr "강대한 힘을 지닌 아티팩트를 넘겨받는데 대가로 줄 수 있는 건 <i>아무것도</i> 없단 말이지? 모욕적인데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Player
#. NodeID = 2cc53ca4-44fe-5dbc-8fdf-86c31cc5cb54
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:2cc53ca4-44fe-5dbc-8fdf-86c31cc5cb54
msgctxt "h7776a186g0036g4f33ga364g508ef496d4d7"
msgid "What do I get in return if I give it to you?"
msgstr "내가 이걸 넘기면 대가로 무엇을 받지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Lae'zel
#. NodeID = 2d6fbd29-75c4-c6a0-c52b-15d359d1cee3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_State_ConvincedToSideWithPlayerAgainstInquisitor = False
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_Event_LaezelTurnsHostile = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:2d6fbd29-75c4-c6a0-c52b-15d359d1cee3
#, fuzzy
msgctxt "hcc27d62fg5cdag467cg8cccgd433522523aa"
msgid "Fool. You were a <i>mistake.</i>"
msgstr "바보 녀석. <i>실수</i>로 가득한 녀석이군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 2f4689a6-1cec-a97d-fb18-bc4b627a4db9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:2f4689a6-1cec-a97d-fb18-bc4b627a4db9
msgctxt "h4128bef1g4737g4e68g879bg7170dc2874c8"
msgid ""
"But I will humour your greed for a moment. What would you ask of an "
"Inquisitor?"
msgstr "하지만 일단 네 녀석의 욕구는 맞춰주도록 하지. 이 심문관에게 무엇을 요구하겠는가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Player
#. NodeID = 38a3f2a5-587f-ba4b-ebd6-01893c9065a1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:38a3f2a5-587f-ba4b-ebd6-01893c9065a1
msgctxt "hd162d9ffgb1a3g4dabg9258gf377c697f6d9"
msgid "What <i>is </i>the Grand Design?"
msgstr "원대한 설계라는 게 <i>대체</i> 뭐지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = GROUP_Daisy
#. NodeID = 39c6257b-b0a5-4f25-b683-4b69ecc569d4
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DAISY_MALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:39c6257b-b0a5-4f25-b683-4b69ecc569d4
msgctxt "h462f2f43g7aedg4e25g94b5gb5ccd668b8bc"
msgid "Don't give it to him."
msgstr "놈에게 넘기면 안 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = GROUP_Daisy
#. NodeID = 39c6257b-b0a5-4f25-b683-4b69ecc569d4
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DAISY_FEMALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:39c6257b-b0a5-4f25-b683-4b69ecc569d4
msgctxt "h53c52acbg38c7g4f13gaa42gbbed65180f18"
msgid "Don't give it to him."
msgstr "놈에게 넘기면 안 돼."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 3ca03334-cb94-2865-138c-c6a905625def
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:3ca03334-cb94-2865-138c-c6a905625def
msgctxt "h629ae9begc27fg4e8fgac62g74dc63281276"
msgid ""
"What makes you think we are not? We are talking about the Grand Design - "
"<i>the restoration of the Illithid Empire</i>. There is nothing of greater "
"importance."
msgstr ""
"우리가 걱정하지 않는다고 생각하나? 이건 원대한 설계에 대한 이야기다. <i>일리시드 제국의 부활</i> 말이다. 그보다 중요한 문제는 "
"없지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Lae'zel
#. NodeID = 40813cbb-b9cf-0af2-165e-7cca12a8bb6c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - d887ce9b-0c5d-e0fe-e7b8-399cd2f458e1_LaezelInclusionTemplar1 = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:40813cbb-b9cf-0af2-165e-7cca12a8bb6c
msgctxt "h55771047gad9fg4416g9badgfc33c08bab6e"
msgid "<i>Ch'r'ai.</i> Vlaakith's justice in flesh."
msgstr "<i>츠라이.</i> 블라키스 님의 정의를 집행하는 분이시여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 40a30e26-7685-8e36-b100-6fda17bdcbe0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_GithChokepoint_Quest_GithLeave = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:40a30e26-7685-8e36-b100-6fda17bdcbe0
msgctxt "h5c18d3c6g78a1g4ca7g8dc4g1ba3fc4c5564"
msgid "<i>Kith'rak </i>Voss' made a mistake when he let you go."
msgstr "<i>키스락</i> 보스는 너를 보내주는 실수를 범했군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 41b31168-6196-35f6-65d4-403c10abc874
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:41b31168-6196-35f6-65d4-403c10abc874
msgctxt "h26b9ce67gbc23g4504ga274g8b19c0bbf304"
msgid "If you hear that voice at all, then you are infected."
msgstr "그 목소리가 조금이라도 들린다면 넌 감염된 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 45aeeb3a-8d6e-e1aa-8543-dd01392aab10
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:45aeeb3a-8d6e-e1aa-8543-dd01392aab10
msgctxt "h72ee63d7g089dg4d5bg9333gb376947d6f39"
msgid "Hand it over."
msgstr "무기를 넘겨라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 465200aa-ccaf-7bf6-18f0-51630b257d42
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:465200aa-ccaf-7bf6-18f0-51630b257d42
msgctxt "h12801ea0g5860g429ega3b9g2c44a1d51e3c"
msgid "It must not have been easy to escape."
msgstr "탈출하기 쉽지는 않았겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 4b2e2f11-44b4-0ad8-abd3-f84e4998fb50
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:4b2e2f11-44b4-0ad8-abd3-f84e4998fb50
msgctxt "h7c81c41ag6665g406bg9e2egd675bb3273f2"
msgid "Give me the weapon. <i>Now.</i>"
msgstr "무기를 넘겨라. <i>당장.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Player
#. NodeID = 51089afe-1437-d077-8f26-ca1a69eed7f5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - d887ce9b-0c5d-e0fe-e7b8-399cd2f458e1_AskedWhatBoxIs = False
#.   Tag:
#.      - GITHYANKI(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:51089afe-1437-d077-8f26-ca1a69eed7f5
msgctxt "he55bb99dg0956g43e9g9cb2g6f245db54869"
msgid "How will this weapon stop the mind flayers?"
msgstr "이 무기가 어떻게 마인드 플레이어를 막는다는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 52dd2dce-95e3-a80f-5960-edb208c5d587
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:52dd2dce-95e3-a80f-5960-edb208c5d587
msgctxt "h77699359ga7f7g4febg99d1g79a921545bdb"
msgid ""
"But know that you will have been instrumental in stopping the Grand Design."
msgstr "그저 네가 원대한 설계를 막는 데 큰 역할을 한다는 것만 알아두도록."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Player
#. NodeID = 5475b877-e15d-103b-7e0c-f44ad18c6696
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = False
#. TagRule: BARBARIAN
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:5475b877-e15d-103b-7e0c-f44ad18c6696
msgctxt "h73137ae5g70a5g416cg8786gd95aecee7298"
msgid "I know a lot of ways to kill - but not the gith way. Teach me."
msgstr "죽이는 방법을 많이 알고 있지만, 기스 방식은 잘 모른다. 가르쳐 줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Player
#. NodeID = 5475b877-e15d-103b-7e0c-f44ad18c6696
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = False
#. TagRule: FIGHTER
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:5475b877-e15d-103b-7e0c-f44ad18c6696
msgctxt "h93a2400cg2dd7g4fa0gacbfgc95c46006d71"
msgid "I know the gith as formidable warriors - teach me your ways of war."
msgstr "기스는 강대한 전사 종족이라고 알고 있지. 당신들의 전투 기술을 알려줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Player
#. NodeID = 5475b877-e15d-103b-7e0c-f44ad18c6696
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = False
#. TagRule: RANGER
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:5475b877-e15d-103b-7e0c-f44ad18c6696
msgctxt "h7bc48827gce6dg46c1g943eg6ac751af25ea"
msgid ""
"Githyanki hunting parties are feared across the planes - teach me your ways."
msgstr "기스양키 사냥 집단은 온 차원계에 걸쳐 두려움의 대상이지. 당신들 방식을 가르쳐 줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Player
#. NodeID = 5475b877-e15d-103b-7e0c-f44ad18c6696
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = False
#. TagRule: MONK
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:5475b877-e15d-103b-7e0c-f44ad18c6696
msgctxt "h9b682de4gececg4762gb610gce5539794d2b"
msgid "You githyanki are disciplined warriors - I wish to learn your ways."
msgstr "기스양키들은 잘 훈련된 전사지. 당신들 방식을 배우고 싶어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 55a7bb59-0f19-17cb-a34d-df7c819c54e8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_State_SecurityOfficeHostile = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:55a7bb59-0f19-17cb-a34d-df7c819c54e8
msgctxt "hf292dc2dg9be3g452fgb7dbgbf41ef228ae8"
msgid "Here. Let me put your lights out. <i>Hta'zith!</i>"
msgstr "여기서 내가 그 불빛을 꺼주겠다. <i>흐타지스!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 56cde1d6-90ed-4c5b-1d3e-bef950b89169
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:56cde1d6-90ed-4c5b-1d3e-bef950b89169
msgctxt "h1a0da512g9518g4c2agbaf4gbf4c5779672c"
msgid "You saw the thralls gathered on the <i>ghaik </i>ship."
msgstr "<i>게이크</i> 함선에 하수인들이 모여있는 것을 봤겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 582f7803-c5d6-1f38-6370-382c8a087562
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:582f7803-c5d6-1f38-6370-382c8a087562
msgctxt "h1ed8142fg5e98g440ag844fg1ae833d4a58e"
msgid ""
"Perhaps you should leave the thinking to me, <i>vin'iisk</i>. Hand over the "
"weapon."
msgstr "좋아할지 말지는 내가 결정한다, <i>비니스크.</i> 무기를 넘겨라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 582f7803-c5d6-1f38-6370-382c8a087562
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:582f7803-c5d6-1f38-6370-382c8a087562
msgctxt "h89d08f02g15e6g4f8ag840agd741a84d648c"
msgid ""
"Perhaps you should leave the thinking to me, <i>istik</i>. Hand over the "
"weapon."
msgstr "좋아할지 말지는 내가 결정한다, <i>이스틱.</i> 무기를 넘겨라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Player
#. NodeID = 5c296338-01a6-c100-2910-250f9db7feef
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_ChainOfCommand_State_CaptainGotZapped = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:5c296338-01a6-c100-2910-250f9db7feef
msgctxt "h8dd9cb73gba9dg4d7fg8cccgbb5d28f2108b"
msgid "I can give it to you, but I don't think you'll like it."
msgstr "당신에게 줄 순 있지만, 좋아할 것 같진 않은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Lae'zel
#. NodeID = 5dd113e3-c34a-d94e-14c4-19815dd06e01
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Laezel_State_ConvincedToSideWithPlayerAgainstInquisitor = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:5dd113e3-c34a-d94e-14c4-19815dd06e01
msgctxt "h9e1e0cb9g54d5g4eaagbdf9gab0a3ea45fa4"
msgid "Our fate is forged. Mother Gith, guide us!"
msgstr "우리 운명은 정해졌다. 어머니 기스이시여, 우리를 인도해 주소서!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Lae'zel
#. NodeID = 5fbb11a9-8d53-1fc4-0088-0c6d1fa7d3e0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:5fbb11a9-8d53-1fc4-0088-0c6d1fa7d3e0
msgctxt "h9d3dbac2gc8acg4fe9gb538g3947bc12f8a2"
msgid ""
"The <i>zaith'isk</i>...<i> Tsk</i> - <i>tsk</i> - <i>tsk'va!</i> I <i>hate</"
"i> that you speak the truth."
msgstr ""
"<i>제이트이스크</i>... <i>츠크</i>, <i>츠크</i>, <i>츠크바!</i> 네 녀석이 진실을 말한다는 게 "
"<i>짜증난다</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 605910b1-3226-01b8-25a8-ca8e7ef1b625
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:605910b1-3226-01b8-25a8-ca8e7ef1b625
msgctxt "h71e8e312g3389g41a8gbf6egd2c10150fc30"
msgid ""
"Never before could they pause ceremorphosis. Never before could they let the "
"infection spread undetected."
msgstr ""
"이전에는 놈들이 이렇게 뇌변이를 천천히 진행되게 할 수 없었다. 지금처럼 아무도 모르게 감염을 퍼뜨리는 것은 전례가 없는 일이란 말이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 6120b798-9d7b-4431-790b-3273798f0b3e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_State_SecurityOfficeHostile = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:6120b798-9d7b-4431-790b-3273798f0b3e
msgctxt "h3dfa680fg4b93g4b0eg94cdg4401a62df263"
msgid "And it is my people who need protecting from you. <i>Hta'zith!</i>"
msgstr "내 동족을 네 녀석으로부터 지켜야겠군. <i>흐타지스!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 62c88243-ad7d-2ffc-abf8-5ee7ddd7976c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:62c88243-ad7d-2ffc-abf8-5ee7ddd7976c
msgctxt "h9862230dgcf44g4938gaf07gfa84ea9c4e9d"
msgid "Everything rendered unto the <i>ghaik</i>."
msgstr "모든 것이 <i>게이크</i>에게 바쳐지는 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Player
#. NodeID = 65f03167-bffc-41ed-eff0-ce3366aae579
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CRE_ChainOfCommand_Event_ShowedArtifactToTemplar(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:65f03167-bffc-41ed-eff0-ce3366aae579
msgctxt "h139921cdg6080g4326g875egf7ebf8e87af0"
msgid "<i>Produce the artefact.</i>"
msgstr "<i>아티팩트를 보여준다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Player
#. NodeID = 67b9fdae-9c5b-62bc-63f3-e581d1e4166f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:67b9fdae-9c5b-62bc-63f3-e581d1e4166f
msgctxt "h55531565g6997g4529gabacg11dd9bb8749a"
msgid "Is the <i>ghaik</i> incursion not more important?"
msgstr "<i>게이크</i>의 급습이 더 중요한 문제 아닌가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Player
#. NodeID = 68082778-767f-3c98-d051-262d5d02038e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:68082778-767f-3c98-d051-262d5d02038e
msgctxt "hf80fad74ge9bfg4d0aga537ga74c38367bfb"
msgid ""
"I thought the Grand Design was a <i>ghaik</i> philosophy, not an actual plan."
msgstr "원대한 설계라는 게 진짜 계획이 아니라, <i>게이크</i>의 철학쯤 되는 줄 알았는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 6bbb7bf0-e91a-9412-0132-f1bd8eb3d24a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:6bbb7bf0-e91a-9412-0132-f1bd8eb3d24a
msgctxt "hc818c23bg8ac1g40c1g8730g22978d71b17f"
msgid ""
"Well you know what they say about fears. The best thing you can do is face "
"them."
msgstr "공포에 대해 으레 나오는 말이 있지. 최선의 방법은 그 공포를 직접 마주하는 것이라고 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 6d67bfed-633b-7abb-3cd1-1964c951be32
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:6d67bfed-633b-7abb-3cd1-1964c951be32
msgctxt "h9142f68ag2b69g48c1g9d21g979221d23c93"
msgid ""
"Is that so? Well, then - humour me. What would you ask of an Inquisitor?"
msgstr "그렇게 생각하는가? 아주 우습군. 그래, 이 심문관에게 무엇을 요구하겠느냐?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 6e654ab5-7b97-bbd5-deaa-b3ac154b13ce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:6e654ab5-7b97-bbd5-deaa-b3ac154b13ce
msgctxt "h7ad889c7g59d7g4306ga0fagb6ccb516660b"
msgid ""
"However, you will readily witness our silver swords cleave putrid <i>ghaik</"
"i> flesh if you do but one thing -"
msgstr ""
"그렇지만, 한 가지만 해준다면 기꺼이 우리의 은빛 검이 썩어빠진 <i>게이크</i>들의 살을 베어버리는 걸 볼 수 있도록 해주지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 74dc9dbc-d817-013b-2c69-d11c38300af4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:74dc9dbc-d817-013b-2c69-d11c38300af4
msgctxt "h2676bfd5g0f40g4564gb432ga399cab7005f"
msgid ""
"But you are lucky - that weapon you carry is the solution. I have heard it "
"from Queen Vlaakith herself."
msgstr "그렇지만 너희는 운이 좋구나. 네가 가지고 있는 무기가 바로 해결책이다. 블라키스께서 그렇게 말씀하셨다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 77aa0655-e6a0-2e30-3d6a-0235b4e9e96a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - d887ce9b-0c5d-e0fe-e7b8-399cd2f458e1_LaezelInclusionTemplar1 = False
#. TagRule: GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:77aa0655-e6a0-2e30-3d6a-0235b4e9e96a
msgctxt "h253a733cg5fe8g42f4gbd0cg9bd9e0aed17b"
msgid ""
"My ardents spoke of one of our kin that escaped a crashing <i>ghaik</i> "
"slave-vessel."
msgstr "추락한 <i>게이크</i> 노예선에서 우리의 동족 하나가 탈출했다고 나의 아덴트들이 보고했었다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 77aa0655-e6a0-2e30-3d6a-0235b4e9e96a
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Local:
#.      - d887ce9b-0c5d-e0fe-e7b8-399cd2f458e1_LaezelInclusionTemplar1 = False
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:77aa0655-e6a0-2e30-3d6a-0235b4e9e96a
msgctxt "h6ad6d181g5679g4ff0g8af9g44e26799475a"
msgid ""
"Interesting. My ardents reported that an <i>istik</i> survived the crashed "
"<i>ghaik</i> slave-vessel."
msgstr "흥미롭군. 추락한 <i>게이크</i> 노예선에서 <i>이스틱</i> 하나가 탈출했다고 나의 아덴트들이 보고했었다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Player
#. NodeID = 78541df0-2836-f793-d887-82772bc10250
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:78541df0-2836-f793-d887-82772bc10250
msgctxt "he0d94bf4ge60eg4a45g87ebg91e532813629"
msgid "We are keeping the artefact."
msgstr "아티팩트는 우리가 지키겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Lae'zel
#. NodeID = 796da575-a6ae-4d22-2ec2-4b8b9cf2be03
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:796da575-a6ae-4d22-2ec2-4b8b9cf2be03
msgctxt "h6245e9b8gf966g46fdga269g299198ac608f"
msgid ""
"I <i>know</i> my path. Refuse him the artefact, and it will run with your "
"blood."
msgstr "난 내 길이 어딘지 <i>알고 있다.</i> 저 분께 아티팩트를 드리지 않으면 너의 피가 그 길을 흐를 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 7a243b84-309a-2f89-40d3-e082e15d8910
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:7a243b84-309a-2f89-40d3-e082e15d8910
msgctxt "h9323b50ag4f53g471dg8deag6109488edbd0"
msgid "The weapon. <i>Now.</i>"
msgstr "무기를 넘겨라. <i>당장.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Player
#. NodeID = 7ad4ecdb-810f-9af3-866b-fb2a6cc1ba3e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:7ad4ecdb-810f-9af3-866b-fb2a6cc1ba3e
msgctxt "he603b058g237bg45a0ga604g99725006af94"
msgid "I could use an ally against the illithids. As could you."
msgstr "일리시드에 대항할 동맹이 필요해. 해줄 수 있나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Player
#. NodeID = 7ba025bd-ef9a-9b03-e53d-0b9f1de03b71
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:7ba025bd-ef9a-9b03-e53d-0b9f1de03b71
msgctxt "h0db8cd0cg3590g4c05gbd4bg8ee1fdb12a1b"
msgid "The voice of the Absolute."
msgstr "절대자의 목소리 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 802229ea-54f1-7af9-f0ce-af176d80b3ec
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_State_SecurityOfficeHostile = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:802229ea-54f1-7af9-f0ce-af176d80b3ec
msgctxt "hf6eec588g09deg4e70gb27ag39c442b488f5"
msgid "No matter. Death will cure you of that problem."
msgstr "상관없다. 그 문제는 죽음으로 치료하면 되니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Lae'zel
#. NodeID = 8270b133-8d4c-4a9c-9bcb-3c8ee5d695e2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - AVATAR(6) = False
#. TagRule: REALLY_GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:8270b133-8d4c-4a9c-9bcb-3c8ee5d695e2
msgctxt "hbf84a097gc8c6g42e1g9801gb9727e26ff61"
msgid "The <i>ch'r'ai </i>speaks. You must obey."
msgstr "<i>츠라이</i>께서 명하셨다. 그분의 말씀을 따라라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Lae'zel
#. NodeID = 8270b133-8d4c-4a9c-9bcb-3c8ee5d695e2
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - AVATAR(6) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:8270b133-8d4c-4a9c-9bcb-3c8ee5d695e2
msgctxt "hca9f2505g585cg4ad7ga4b8g82bd706a2106"
msgid "Do it. Do not disobey the Inquisitor."
msgstr "넘겨라. 심문관님의 말씀을 따라라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 83092f80-89a1-44eb-58f7-a05b0c54d81a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:83092f80-89a1-44eb-58f7-a05b0c54d81a
msgctxt "h8cca17f7g5593g4cbaga8f8gd3ff01ba6eeb"
msgid ""
"I heard there is so much goblin blood on your hands that it soaks their "
"children's nightmares."
msgstr "그대 손을 수많은 고블린들의 피로 적셨다더군. 어린 고블린들의 꿈에 나올 정도로 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 84467455-1918-ca55-9aa2-adbcfcb26837
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - d887ce9b-0c5d-e0fe-e7b8-399cd2f458e1_LaezelInclusionTemplar1 = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:84467455-1918-ca55-9aa2-adbcfcb26837
msgctxt "h37131304g2e36g464ag8362g7fe202ae21f0"
msgid "You have accomplished much, child. I am pleased to finally meet you."
msgstr "넌 많은 것을 이루어 냈다, 아이여. 마침내 너를 만나게 되어서 기쁘구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Player
#. NodeID = 865c8a9e-4822-1b6a-ceb4-1447272447db
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WARLOCK(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:865c8a9e-4822-1b6a-ceb4-1447272447db
msgctxt "h8cda86d5g57e1g4952g8b78g02f9c941a94a"
msgid ""
"Here's how deals like this work: I have something you <i>need</i>. I can "
"bargain all I like."
msgstr ""
"이런 거래가 어떤 식으로 이뤄지는지 얘기해주지, 네가 <i>원하는 걸</i> 내가 가지고 있으면, 협상의 주도권은 나한테 있는 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Player
#. NodeID = 889700e7-e8b3-d4fe-d10e-b7db57e65bc2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:889700e7-e8b3-d4fe-d10e-b7db57e65bc2
msgctxt "hab488dc0g0bddg41d6g83acgdabd59cc2f42"
msgid "A promotion in the eyes of our Queen. I want my silver sword."
msgstr "여왕의 감찰대에 들어갈 수 있게 해줘. 나도 은검을 받고 싶어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 88d588a2-03e3-050b-644e-294535b311d7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:88d588a2-03e3-050b-644e-294535b311d7
msgctxt "h5dd55a02ga6bag42f6g976fg226c18fbaf40"
msgid ""
"Once the Grand Design comes into effect and the Illithid Empire is restored, "
"<i>all</i> life will be over as you know it."
msgstr "원대한 계획이 실현되고 일리시드 제국이 재건된다면, 네놈이 알고 있는 <i>모든</i> 생명은 종말을 맞을 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 8c493cc5-e0e5-83c1-a417-a7ff58033130
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:8c493cc5-e0e5-83c1-a417-a7ff58033130
msgctxt "h0097e3f2gdc71g4fdbg9a34g212a1e46ef54"
msgid ""
"I do not know what base, naive entities you have made deals with before - "
"nor do I care."
msgstr "네 녀석이 어떤 순진한 머저리들하고 거래를 해왔는지는 알지도 못하고 관심도 없다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Narrator
#. NodeID = 920f6724-e116-90dc-4a15-d87e392fc1bf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_InfernalBox_State_CharacterHasBox(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_InfernalBox_Event_ForceGiveBox(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:920f6724-e116-90dc-4a15-d87e392fc1bf
msgctxt "h5da6c064gaa05g4bb8ga141g76bbd7b0aeb1"
msgid ""
"*The artefact stirs in your pocket. Right within your grasp, and desperate "
"not to be relinquished.*"
msgstr "*주머니 속의 아티팩트는 당신의 손끝에서 흔들리고 있습니다. 당신이 자신을 내어주지 않기를 간절히 원하고 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Player
#. NodeID = 9574b5e1-1e60-b7bc-b97b-7ef4af4ca6b6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WARLOCK(1) = False
#. TagRule: ROGUE
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:9574b5e1-1e60-b7bc-b97b-7ef4af4ca6b6
msgctxt "h9b92f71eg7d6cg4c42g9b91g8f71f8638383"
msgid ""
"I'm not inclined to give away valuable things for free. You want it, make an "
"offer."
msgstr "그렇게 중요한 물건을 그냥 공짜로 주는 건 썩 내키지 않거든. 정말 이걸 원하면 구미가 당기는 제안을 해봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Player
#. NodeID = 9574b5e1-1e60-b7bc-b97b-7ef4af4ca6b6
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WARLOCK(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:9574b5e1-1e60-b7bc-b97b-7ef4af4ca6b6
msgctxt "h2e4f340dgb708g4faag99ffg12e60231faf1"
msgid ""
"I have the weapon - I would say that puts me in a strong position to bargain "
"with you."
msgstr "내가 무기를 가지고 있잖아. 협상의 유리한 위치는 이쪽에 있는 것 같은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 975dd7ca-7346-3af2-e4d2-6457ede7c6c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:975dd7ca-7346-3af2-e4d2-6457ede7c6c6
msgctxt "h154cd3dfg53cag4390gaa0cg589e393f50b5"
msgid ""
"That is a secret known only to Queen Vlaakith. Its significance is beyond "
"both of our stations."
msgstr "그것은 블라키스 여왕께서만이 알고 계시는 비밀이다. 이것의 의미는 우리의 이해를 뛰어넘는다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Lae'zel
#. NodeID = 9a6bcbf5-e76d-4076-af83-ed14662b5f63
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_7 = True
#.   Tag:
#.      - AVATAR(6) = False
#. TagRule: REALLY_GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:9a6bcbf5-e76d-4076-af83-ed14662b5f63
msgctxt "hb34c1d40gb2e1g480fga593g499c49fa251d"
msgid ""
"You test our Queen's patience. Surrender the artefact, or die by my hand."
msgstr "네 녀석은 우리 여왕폐하의 인내심을 시험하는군. 항복하고 아티팩트를 내놓아라. 그렇지 않으면 내 손으로 죽이겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Lae'zel
#. NodeID = 9a6bcbf5-e76d-4076-af83-ed14662b5f63
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_7 = True
#.   Tag:
#.      - AVATAR(6) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:9a6bcbf5-e76d-4076-af83-ed14662b5f63
msgctxt "h267a5c02g8b30g42efg8442g982bbae3593e"
msgid "Do <i>not</i> try me. Hand over the artefact, or die by my hand."
msgstr "날 <i>시험하지</i> 마라. 그 아티팩트를 건네라. 그렇지 않으면 내 손으로 죽이겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = a0833c95-a086-bbfd-63d5-ca1a3b8caf55
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:a0833c95-a086-bbfd-63d5-ca1a3b8caf55
msgctxt "h95aa6f97g5028g41a3g8636g71be1f110afe"
msgid ""
"But the weapon is the <i>solution</i>. I have heard it directly from Queen "
"Vlaakith herself."
msgstr "이 무기가 바로 희망이다. 블라키스 여왕께서 그렇게 직접 말씀하셨다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = a0af157c-8bd7-f01b-bd8e-7a5ff271dfbc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:a0af157c-8bd7-f01b-bd8e-7a5ff271dfbc
msgctxt "h9820f022gc918g404bg8b5bg70f72a9e3751"
msgid "The weapon. Give it to me."
msgstr "그 무기. 우리에게 넘기도록."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Player
#. NodeID = a5167a18-7df0-22a3-243c-f0c9f144cfb7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - d887ce9b-0c5d-e0fe-e7b8-399cd2f458e1_AskedWhatBoxIs = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:a5167a18-7df0-22a3-243c-f0c9f144cfb7
msgctxt "h86b2b1dbg463bg441cg9b62gb2e3bb086af7"
msgid "This weapon - what does it do?"
msgstr "그런데 이 무기라는 건, 뭐에 쓰는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = a703c382-d929-3222-8227-b2fe9a880d02
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DruidsAreDefeated = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:a703c382-d929-3222-8227-b2fe9a880d02
msgctxt "h118d034agf0c3g4e5agbdd2g56c51431c3f2"
msgid ""
"I heard enough druids died by your hand to make the deity Silvanus himself "
"weep."
msgstr "그대가 신 실바누스를 오열하게 할 정도로 수많은 드루이드를 손수 죽였다더군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = aa7ae80c-e3b3-73f7-7dcb-20d4d4573cc9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:aa7ae80c-e3b3-73f7-7dcb-20d4d4573cc9
msgctxt "hb3de5868g4156g4369gb0efg7ed5f4957267"
msgid "It is how we will stop the mind flayers before they destroy us all."
msgstr "이 무기가 마인드 플레이어를 막을 수 있는 방법이란 말이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Player
#. NodeID = af6c72c5-1662-7685-acc4-e613a09c0826
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WIZARD(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:af6c72c5-1662-7685-acc4-e613a09c0826
msgctxt "h21e885f5g7e5eg4900gb06bg250b7f332a75"
msgid ""
"I bet your empire has gathered countless valuable spellbooks in its time - "
"let me read them."
msgstr "너희 제국은 그동안 셀 수 없는 귀중한 마법서들을 모아놨겠지. 그것들을 읽을 수 있게 해줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Player
#. NodeID = b2169163-7ee8-4349-e2e1-ebebf725dba0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - d887ce9b-0c5d-e0fe-e7b8-399cd2f458e1_AskedWhatBoxIs = False
#.   Tag:
#.      - GITHYANKI(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:b2169163-7ee8-4349-e2e1-ebebf725dba0
msgctxt "hfdb02a3cgf697g4ad6ga1f2g64a799c83b5f"
msgid "How do you know so much about me?"
msgstr "어떻게 나에 대해서 이렇게 많이 알고 있지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Player
#. NodeID = b6af484e-2c15-abfa-ce51-ebfaed56e700
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:b6af484e-2c15-abfa-ce51-ebfaed56e700
msgctxt "hfad326edgb945g4c65gbdb7gf4bb8a2fd163"
msgid "My mind is silver, and my body steel. Vlaakith expects no less of me."
msgstr "제 마음은 은과 같고, 제 몸은 강철과 같습니다. 블라키스께서는 저에게 그 이상을 기대하고 계십니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = b897ef35-6f53-7e3f-c024-dcbb8d18706a
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:b897ef35-6f53-7e3f-c024-dcbb8d18706a
msgctxt "h24aaabc4gb73fg4720g9154gd054c100fead"
msgid ""
"I suspect you plucked something precious from the <i>ghaik</i> ship. "
"Something our queen has been looking for."
msgstr "그대가 <i>게이크</i> 노예선에서 귀중한 물건을 훔친 것 같더군. 그건 우리 여왕께서 찾고 계신 물건이네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = b897ef35-6f53-7e3f-c024-dcbb8d18706a
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:b897ef35-6f53-7e3f-c024-dcbb8d18706a
msgctxt "h90cdf678g2c92g4a7agb270g5d4c45522a10"
msgid ""
"To business. I suspect you plucked something precious from the <i>ghaik</i> "
"ship. Something that belongs to <i>us</i>."
msgstr "본론으로. 그대가 <i>게이크</i> 노예선에서 귀중한 물건을 훔친 것 같더군. 그건 우리의 물건이라네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = b9c4268e-9c0e-d58d-c11c-c47da057e71b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:b9c4268e-9c0e-d58d-c11c-c47da057e71b
msgctxt "hdc51dda9gb903g4232g810fg0f37a262346a"
msgid ""
"You stand before an Inquisitor of Vlaakith and ask for... <i>reading "
"material?</i>"
msgstr "네 녀석은 지금 블라키스 여왕의 심문관 앞에서 <i>금서</i>들을 읽을 수 있게 해달라는 것이냐?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = bc674d1b-2438-7454-a25e-f9e1b3507576
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:bc674d1b-2438-7454-a25e-f9e1b3507576
msgctxt "hedeaad21gf95eg4780g89e2g8c59e7410552"
msgid ""
"Some of your species say knowledge is power. They are wrong. Knowledge is "
"<i>everything</i>."
msgstr "너의 동족들은 지식이 힘이라고 말한다더군. 그러나 틀렸다. 지식은 <i>모든 것이다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = bfe0ee30-9a76-0169-c8b8-00aab704c755
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_ChainOfCommand_Hasmet_Templar = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:bfe0ee30-9a76-0169-c8b8-00aab704c755
msgctxt "h793ceff9g9b5bg4649g8570g0c41e65fa32a"
msgid "Place the weapon in the planecaster. Fulfil my Queen's most holy edict."
msgstr "무기를 차원전송기에 올려놓아라. 우리 동족의 여왕께서 내리신 신성한 칙령을 따라라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = bfe0ee30-9a76-0169-c8b8-00aab704c755
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_ChainOfCommand_Hasmet_Templar = True
#. TagRule: GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:bfe0ee30-9a76-0169-c8b8-00aab704c755
msgctxt "hb42a4cedg48bdg404bgaee6gff9cb93f4286"
msgid ""
"Place the weapon in the planecaster. Fulfil our Queen's most holy edict."
msgstr "무기를 차원전송기에 올려놓아라. 우리의 여왕께서 내리신 신성한 칙령을 따라라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Player
#. NodeID = c4dacd47-f156-f3df-30ac-c517ea2be58c
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 21
#. CheckFlags:
#.   Object:
#.      - CRE_GithInfirmary_State_CharacterUsedDevice(6) = False
#.      - Approval_AtLeast_0_For_Sp7(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:c4dacd47-f156-f3df-30ac-c517ea2be58c
msgctxt "hc87918abgdefag4735g8727g05ab2fae24e6"
msgid ""
"You can't trust him, Lae'zel. Follow my lead. I will choose the right path."
msgstr "저 녀석은 믿을 수 없어 레이젤. 나를 따라와 줘. 내가 올바른 길을 택할게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = c6889d53-954b-52fb-4f6e-e9a3f6d26343
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:c6889d53-954b-52fb-4f6e-e9a3f6d26343
msgctxt "hc084e5f0g6ffdg4db2g9fe4gcc8d491d6559"
msgid "Only this? Gladly. Once you hand me the artefact."
msgstr "그것뿐이냐? 어렵지 않다. 아티팩트를 우리에게 건네면 말이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = c69fbfd4-dfcf-881d-1028-818f0f24da13
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:c69fbfd4-dfcf-881d-1028-818f0f24da13
msgctxt "h55f5e737gbc3dg43aeg9ea5g7f77fe2182cb"
msgid ""
"You will have it, <i>ra'stil</i>. Our silver will light this world's sky in "
"righteous crusade."
msgstr "그렇게 해주지. <i>ra'stil</i>. 우리의 은빛은 이 세계의 하늘을 의로운 성전으로 밝힐 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = c69fbfd4-dfcf-881d-1028-818f0f24da13
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:c69fbfd4-dfcf-881d-1028-818f0f24da13
msgctxt "hb15cfce6g918dg4f23g8370g18dbea7aa81c"
msgid ""
"If you desire to see the might of my people, you will not be disappointed."
msgstr "우리 동족의 강력함을 보고 싶은 것이라면, 후회하지 않을 것이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = c853d122-0a93-569c-aea2-4b49c2141c43
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:c853d122-0a93-569c-aea2-4b49c2141c43
msgctxt "ha4bd2a90g3e12g405bgbeddgf457fc515e20"
msgid ""
"You would lay claim to our hard-won treasures? You seek power but do not "
"seek to <i>strive</i> for it?"
msgstr "우리가 힘들게 얻은 보물들을 내놓으라고 하는 것이냐? 네 녀석에겐 힘만이 중요하고 그것을 위한 노력은 중요하지 않군?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = ca0a9df5-e632-29ad-e2f1-a0588435c3be
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:ca0a9df5-e632-29ad-e2f1-a0588435c3be
msgctxt "h626d60c0g1835g4bdag92e0g5a354e99db01"
msgid ""
"Our swords are ready to cleave <i>ghaik</i> flesh in their legions. With or "
"without your interference."
msgstr "우리의 검은 <i>게이크</i>군단을 살육할 준비가 되어있다. 너의 참전 여부에 상관없이 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Lae'zel
#. NodeID = cae71c86-b7b7-3e4c-49ba-63a6446097c1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:cae71c86-b7b7-3e4c-49ba-63a6446097c1
msgctxt "h8b700bbfg9261g4a05gaf5dg7b78d2cd50b6"
msgid ""
"<i>Tsk</i> - <i>tsk</i> - <i>tsk'va!</i> I <i>hate</i> that you speak the "
"truth."
msgstr "<i>츠</i> - <i>츠</i> - <i>츠크바!</i> 네 녀석이 진실을 말한다는 게 <i>짜증난다</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Player
#. NodeID = cbd6dccd-9b50-06ca-f965-1a0934228508
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 12
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:cbd6dccd-9b50-06ca-f965-1a0934228508
msgctxt "hc5e48a92g20bbg4178gbc06g2bf5ef072196"
msgid "All kinds of bad things. It's my lucky charm."
msgstr "모든 나쁜 것들로부터 말이지. 이건 내 행운의 부적이거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = cc53f2df-9591-50f5-00aa-4c5ccde63833
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - d887ce9b-0c5d-e0fe-e7b8-399cd2f458e1_LaezelInclusionTemplar1 = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:cc53f2df-9591-50f5-00aa-4c5ccde63833
msgctxt "he24330c5g865eg4345g8074g82705b57d68e"
msgid ""
"My ardents spoke of one of our kin that escaped a crashing <i>ghaik</i> "
"slave-vessel."
msgstr "추락한 <i>게이크</i> 노예선에서 우리의 동족 하나가 탈출했다고 나의 아덴트들이 보고했었다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Player
#. NodeID = cd428793-f282-7b3c-2931-63823ae22b54
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:cd428793-f282-7b3c-2931-63823ae22b54
msgctxt "h9e422eb7g4ebcg4126g9544g664729051c0a"
msgid "I won't let you take it."
msgstr "그걸 가져가게 할 수 없다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = cf585204-db94-ecc7-d52f-e95ec17dd49e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:cf585204-db94-ecc7-d52f-e95ec17dd49e
msgctxt "hfe61319dg1102g431bg81fagd9af2286fcba"
msgid ""
"I have seen your behaviour before. The squirming, the avoidance. You are "
"infected."
msgstr "그런 모습을 많이 봐왔지. 불안해하고 회피하려는 모습을. 네 녀석은 감염되었구나."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Player
#. NodeID = d4636140-6f9e-9bc5-2ec6-90b4e335b903
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ROGUE(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:d4636140-6f9e-9bc5-2ec6-90b4e335b903
msgctxt "h1611efb0g3610g4e63gbbb4gb77cffa269b4"
msgid "Coin, typically - but anything of immense value will do."
msgstr "돈. 웬만하면. 다른 값비싼 것도 괜찮아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = d4ee4946-5a47-9874-eab3-36b7a66bc044
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:d4ee4946-5a47-9874-eab3-36b7a66bc044
msgctxt "h38e34bc2gaec0g43d9gb5c2gea12fbe949af"
msgid "Gish war-arts far eclipse the reckoning of <i>istik</i> minds."
msgstr "우리 기스의 전투 기술은 <i>이스틱</i>의 상상을 아득히 뛰어넘는다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = d5f41984-f912-91f7-51cc-3d4cb25d5ec6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:d5f41984-f912-91f7-51cc-3d4cb25d5ec6
msgctxt "he8a87b4fgfc7bg443bg8899g7f57d52a8b82"
msgid "But you were not wrong to observe that you need protection."
msgstr "하지만 네 녀석에게 보호가 필요하다는 것은 틀린 말이 아니지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Player
#. NodeID = d7712920-ccf8-d199-2d88-e3011f79452f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(1) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:d7712920-ccf8-d199-2d88-e3011f79452f
msgctxt "hd8177b62ga802g43f4g837dgdfe504c31853"
msgid "Shouldn't you be more concerned with the mind flayer invasion?"
msgstr "마인드 플레이어의 침입을 더 걱정해야 하는 거 아닌가?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Player
#. NodeID = d7897613-e70b-64c8-fac9-dbd00c18f1a0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - d887ce9b-0c5d-e0fe-e7b8-399cd2f458e1_AskedWhatBoxIs = False
#.   Tag:
#.      - GITHYANKI(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:d7897613-e70b-64c8-fac9-dbd00c18f1a0
msgctxt "h3943acccga93cg4c67g876eg36cbed2bbb2b"
msgid "How will this weapon actually stop the <i>ghaik</i>?"
msgstr "이 무기가 어떻게 <i>게이크</i>를 막는다는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Player
#. NodeID = d926fe9a-2ced-59f5-5c09-a8fbaabf7755
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 16
#. CheckFlags:
#.   Object:
#.      - CRE_GithInfirmary_State_CharacterUsedDevice(6) = False
#.      - Approval_AtLeast_0_For_Sp7(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:d926fe9a-2ced-59f5-5c09-a8fbaabf7755
msgctxt "h0950eccdgf262g49a7g9c70g8520b79c9c66"
msgid ""
"You can't trust him, Lae'zel. Follow my lead. I will choose the right path."
msgstr "저 녀석은 믿을 수 없어 레이젤. 나를 따라와 줘. 내가 올바른 길을 택할게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Player
#. NodeID = da589076-1992-5a15-2fe1-bccf764ea7ee
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:da589076-1992-5a15-2fe1-bccf764ea7ee
msgctxt "h7f15c07cg9a61g4e38g9b7agab1471095d9b"
msgid "I can't. It protects me."
msgstr "그럴 수는 없어. 이게 날 보호해주거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = ddcd4770-e2ef-1bcb-ac07-462a42fdd6a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:ddcd4770-e2ef-1bcb-ac07-462a42fdd6a3
msgctxt "h05f0d24bgf908g44edga0f4g06dbacc3276d"
msgid "You are infected? Grotesque."
msgstr "감염되었단 말이지? 기괴하군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = e21a7db1-21a7-f42f-b064-5895dc8b0a53
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:e21a7db1-21a7-f42f-b064-5895dc8b0a53
msgctxt "hb76f57e1gc8afg4da9g9ae4g99cb126d3a56"
msgid "What business is that of yours? Suffice to say, our queen wants it."
msgstr "그게 네 녀석과 무슨 상관이지? 우리 여왕께서 그걸 원하신다. 그걸로 충분하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = e21a7db1-21a7-f42f-b064-5895dc8b0a53
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:e21a7db1-21a7-f42f-b064-5895dc8b0a53
msgctxt "h7aa747e5gc7a5g45b4gb2ebga3863fa2b33d"
msgid "What business is that of yours? Suffice to say, my queen wants it."
msgstr "그게 네 녀석과 무슨 상관이지? 우리 여왕께서 그걸 원하신다. 그걸로 충분하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = e6051d3a-0a00-024f-68a5-c99b10679a13
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_State_SecurityOfficeHostile = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:e6051d3a-0a00-024f-68a5-c99b10679a13
msgctxt "hf3561549g59feg49adg880fg9b89a0c52a11"
msgid "Then your illustrious adventure ends here. <i>Hta'zith!</i>"
msgstr "그럼 네 녀석의 그 대단한 여정도 여기서 끝이다. <i>흐타지쓰!!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = e806e0ac-0bcf-0647-67c1-2891528428dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:e806e0ac-0bcf-0647-67c1-2891528428dc
msgctxt "h759bc7eag0707g44d1g8986gda518bb7cbcb"
msgid "So. The weapon. <i>Please.</i>"
msgstr "이제, 그 무기를 건네주겠나. <i>응?</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Player
#. NodeID = ea45da40-62e4-4d59-f523-7c8fede0e544
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:ea45da40-62e4-4d59-f523-7c8fede0e544
msgctxt "h6a55121ag31aeg4ebdgaf78g2e10cc9782c1"
msgid "Make me your best offer. I accept gold."
msgstr "좋은 제안을 해봐. 황금도 받아주지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = ec4dfcce-7906-7d20-beba-67cc2ec68037
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:ec4dfcce-7906-7d20-beba-67cc2ec68037
msgctxt "hdd808786g77cfg43b8gb650g4fc6e9101a19"
msgid "A fool's request. <i>Denied. </i>"
msgstr "멍청한 요구로군 <i>거부한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = ed122358-1f1f-57f9-072b-9ced2aa36a31
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:ed122358-1f1f-57f9-072b-9ced2aa36a31
msgctxt "h5c969dd1g95dbg4195ga8cdgf196aadfe3dc"
msgid "You know more than you're letting on."
msgstr "숨기는 것이 있군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Lae'zel
#. NodeID = f0d0ee9a-8359-f10a-62a7-c0a0db5e05d4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Laezel_State_ConvincedToSideWithPlayerAgainstInquisitor = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:f0d0ee9a-8359-f10a-62a7-c0a0db5e05d4
msgctxt "h10d5a2cdg8e14g461ag9109g0711eaae2bb6"
msgid "Choose. Your path is mine to follow."
msgstr "결정해라. 네 길을 나도 따라 가겠다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = f1515ab5-4e2d-12a6-adc2-db083f2e295f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:f1515ab5-4e2d-12a6-adc2-db083f2e295f
msgctxt "h9738fe9fgbd06g48ceg90f7g0b3009342ca8"
msgid ""
"You hold the key to thwarting the <i>ghaik</i> Grand Design - and you ask me "
"for coin? Petty trinkets?"
msgstr "네 녀석은 <i>게이크의</i> 원대한 계획을 막을 수 있는 열쇠를 쥐고 있다. 그런데 고작 요구한다는 게 금붙이나 돈이라고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = f1597533-822a-9958-40cf-10e2ef417b3e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:f1597533-822a-9958-40cf-10e2ef417b3e
msgctxt "hdce5dc96g583ag43a7ga59bgf68fcb7ab58e"
msgid ""
"You mean the Grand Design? The restoration of the Illithid Empire? Why, it "
"is of the <i>utmost </i>importance."
msgstr "원대한 계획을 말하는 것이냐? 일리시드 제국의 부활? 이건 무엇보다 중요한 일이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Player
#. NodeID = f19b3402-8079-bde6-752c-40d20f33165e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CRE_ChainOfCommand_Event_ShowedArtifactToTemplar(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:f19b3402-8079-bde6-752c-40d20f33165e
msgctxt "h9e43f161ge8aeg44a5g9bebga6c445b095c3"
msgid "<i>Produce the artefact.</i>"
msgstr "<i>아티팩트를 보여준다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = f25e56f4-7b76-bd24-3fc4-44f5992268d7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_GithChokepoint_Event_AllGithsDefeated = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:f25e56f4-7b76-bd24-3fc4-44f5992268d7
msgctxt "h82490ab7gd76dg4551g95ffg579a014b5437"
msgid "You also <i>killed Sarth</i> Baretha. She was formidable."
msgstr "그대는 또 <i>사스 바레사</i>를 죽였지. 그녀도 만만찮은 자였는데 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Player
#. NodeID = f2677ca0-cd14-c4f8-8567-895b3040f12c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(1) = True
#. SetFlags:
#.   Object:
#.     - CRE_ChainOfCommand_Event_ShowedArtifactToTemplar(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:f2677ca0-cd14-c4f8-8567-895b3040f12c
msgctxt "h23c8496agd818g4364g8858g8552f64852b4"
msgid "As is your will, <i>ch'r'ai</i>."
msgstr "분부하시는 대로, <i>츠라이</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = GROUP_Daisy
#. NodeID = f34b35e0-08a2-2812-c253-70dabd11e93b
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DAISY_MALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:f34b35e0-08a2-2812-c253-70dabd11e93b
msgctxt "hf7450e9bgda97g4027g8b76g3091a27cfebc"
msgid "Don't do it. The weapon is how I protect you."
msgstr "그러지 마세요. 전 이 무기로 당신을 보호하고 있어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = GROUP_Daisy
#. NodeID = f34b35e0-08a2-2812-c253-70dabd11e93b
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DAISY_FEMALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:f34b35e0-08a2-2812-c253-70dabd11e93b
msgctxt "h23202732g99abg4f71ga624gcfa2302bde63"
msgid "Don't do it. The weapon is how I protect you."
msgstr "그러지 마세요. 전 이 무기로 당신을 보호하고 있어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Player
#. NodeID = f955efa8-7eb8-9249-167e-a47aef942b10
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:f955efa8-7eb8-9249-167e-a47aef942b10
msgctxt "h530d138dg2e5cg48abg9bb3g8717bbd9bc42"
msgid "The dark?"
msgstr "어둠으로부터?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = fa66de9c-d9c5-c365-08c0-7c99b263dbc2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_Templar:fa66de9c-d9c5-c365-08c0-7c99b263dbc2
msgctxt "h1bf41d97gd833g4ad8gbb05g9ac34fc544ab"
msgid ""
"For centuries, their elder brains sought to bring back their dominion. Every "
"plot they hatched, we stopped. But now, they are close to succeeding."
msgstr ""
"수 세기동안, 게이크의 엘더 브레인들은 자신들의 지배를 되찾으려 노력했지. 녀석들이 계획했던 음모들을 우리가 막아냈다. 그렇지만, 이제 "
"놈들의 계획이 성공에 가까워졌다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_TemplarStartsFight
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 22d7775e-c48e-3652-8256-878194791396
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_ChainOfCommand_State_SecurityOfficeHostile = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_TemplarStartsFight:22d7775e-c48e-3652-8256-878194791396
msgctxt "he58a02b1gc942g4f4bg8929g5832441f8690"
msgid "To your death, then."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_TemplarStartsFight
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 4bd8dcf4-664e-a2fd-9443-0c371a1fc576
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_TemplarStartsFight:4bd8dcf4-664e-a2fd-9443-0c371a1fc576
msgctxt "h049db2adgc8e4g4f57g97b0g53d1bf45922c"
msgid "Words words, empty words. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_TemplarStartsFight
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 579aee14-65be-6fd6-2b9b-e45909ab517d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_TemplarStartsFight:579aee14-65be-6fd6-2b9b-e45909ab517d
msgctxt "h26916b0agd040g4a70g852eg259ff7050666"
msgid "A great shame. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_TemplarStartsFight
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 5d20ff9d-b393-3160-0124-32700d1b96d5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_TemplarStartsFight:5d20ff9d-b393-3160-0124-32700d1b96d5
msgctxt "h0f0dd3aegac53g4844ga151g2cc0851c0e47"
msgid "Impossible, I assure you. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_TemplarStartsFight
#. Speaker = Player
#. NodeID = 70535398-fc38-8ab2-56ef-a70581757386
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_TemplarStartsFight:70535398-fc38-8ab2-56ef-a70581757386
msgctxt "ha0dd0108g35bdg42afga725ge369200fdf60"
msgid "It was kind of you to unlock the artefact for me. I'll be leaving now. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_TemplarStartsFight
#. Speaker = Player
#. NodeID = 75710d90-8350-56f3-7d00-f1ea3824e089
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_TemplarStartsFight:75710d90-8350-56f3-7d00-f1ea3824e089
msgctxt "h67dc49c6gb6aag4c84g9791g5041f72655f8"
msgid ""
"I couldn't do it. I couldn't destroy the one protecting me from the "
"Absolute. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_TemplarStartsFight
#. Speaker = Ch'r'ai W'wargaz
#. NodeID = 7f72b27c-295d-0229-24b3-e9d7c34c8bcf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_TemplarStartsFight:7f72b27c-295d-0229-24b3-e9d7c34c8bcf
msgctxt "h2af688a9gb5cfg4d0bga11egb3be6d547594"
msgid "Since my queen does not lie, I must assume you do."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_ChainOfCommand_TemplarStartsFight
#. Speaker = Player
#. NodeID = b02858f6-72e8-44b3-2aca-18922677d44a
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: GITHYANKI
