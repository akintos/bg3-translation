#. CheckFlags:
#.   Global:
#.      - GOB_WolfPens_State_PrisonerPermaDefeated = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_Kid_001:ecc58a94-1e62-1596-12f8-01a6dddaf671
msgctxt "hea40ce3cg4f70g4bcdga06dg595647fb9ef4"
msgid "Throw a stone - see if it growls!"
msgstr "돌을 던져봐, 으르렁거리는지 보자!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_Kid_002
#. Speaker = Three
#. NodeID = 5263de6a-072e-e7dc-3dd1-b34df3b707f5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
