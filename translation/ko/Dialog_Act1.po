msgctxt "haa37003dg5edag42a4gbf06g5620bdbf7a3d"
msgid ""
"Urgh. You're boooring. Come on Ra'jak, let's show him how to have some FUN."
msgstr "어휴. 넌 재미없어. 라자크, 재밌게 노는 법을 좀 보여주자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain
#. Speaker = Zel'i
#. NodeID = b85cace9-3066-ccfe-3a21-785e0dbfd863
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: FEMALE
