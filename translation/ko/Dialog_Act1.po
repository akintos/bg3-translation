msgid "I will not let this happen to you!"
msgstr "일이 이렇게 되도록 두지 않겠어요!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = GROUP_Daisy
#. NodeID = aa6e30d0-7436-41d1-1d90-4aa41447f1b3
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IMPOSSIBLE = True
#. TagRule: DAISY_MALE_VOICE and DAISY_REASONTRACK
