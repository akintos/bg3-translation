#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_WarlockProposal_ReleasePlayer = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarlockProposal_Warlock:9a0490f1-19c5-08da-a208-7e8b8a8fbced
msgctxt "h2cb5b4cag7986g4e87g86b3gc28fd8474ff3"
msgid "And before you thank me - save your breath."
msgstr "그리고 저에게 감사 인사를 하실 거라면 말을 아껴두세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarlockProposal_Warlock
