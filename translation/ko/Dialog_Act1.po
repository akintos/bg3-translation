#.      - ShadowHeart_InParty_Knows_SharWorshipper = False
#. SetFlags:
#.   Global:
#.     - GOB_Shadowheart_State_RecogniseSeluneTemple = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/VBs/GOB_ShadowHeart_VB_Temple:1121558e-db2c-ed9a-6e7a-87bf330faa37
msgctxt "ha3d64c3cg9842g4d07g9f93gb3ae2cfbfe74"
msgid "This ruin's dedicated to Selûne. What happened here...?"
msgstr "이 폐허는 셀루네에게 바쳐진 곳이었어. 여기서 무슨 일이 있었던 거지...?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/VBs/GOB_ShadowHeart_VB_Temple
#. Speaker = Shadowheart
#. NodeID = 3c5d7048-1600-3c65-0cd7-aeb63babc128
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ShadowHeart_InParty_Knows_SharWorshipper = False
#.      - GOB_TorturedAdventurer_Knows_ToldHiddenSharTemple = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/VBs/GOB_ShadowHeart_VB_Temple:3c5d7048-1600-3c65-0cd7-aeb63babc128
msgctxt "h0d90d393gd3e3g49e4ga2c8gf5ca16756956"
msgid ""
"Selûne symbols everywhere... surely there can't be a temple of Shar here."
msgstr "셀루네의 상징이 모든 장소에 있어... 이곳에 샤님의 사원이 있을 리가 없겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/VBs/GOB_ShadowHeart_VB_Temple
#. Speaker = Shadowheart
#. NodeID = 3def8e39-ac45-eafe-921e-44347952dba7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/VBs/GOB_ShadowHeart_VB_Temple:3def8e39-ac45-eafe-921e-44347952dba7
msgctxt "h5be1feffgaff7g494agae11g45c9da0c5599"
msgid "For once, the goblins' decorations are an improvement."
msgstr "처음으로, 고블린들의 장식이 도움이 됐네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/VBs/GOB_ShadowHeart_VB_Temple
#. Speaker = Shadowheart
#. NodeID = bae9b004-1e39-a58a-4b4f-a960ffc4a6a6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ShadowHeart_InParty_Knows_SharWorshipper = True
#.      - GOB_TorturedAdventurer_Knows_ToldHiddenSharTemple = True
