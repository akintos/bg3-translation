#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter:50eb8e19-bae8-5875-404a-b4811b921810
msgctxt "he93431bagad0bg44fcg9a29gb93e7170ee62"
msgid "No. Don't - can't... Derryth."
msgstr "안 돼. 하지 마 - 못 해... 데리스."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Baelen Bonecloak
#. NodeID = 531f71cd-287c-3797-c0bc-1c54188b9f55
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_MushroomHunter_HasMet(1) = True
#.      - UND_MushroomHunter_AgreedToHelp(1) = False
#.   Global:
#.      - UND_MushroomHunter_State_CantUseMagic = False
#.      - UND_MushroomHunter_State_Saved = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter:531f71cd-287c-3797-c0bc-1c54188b9f55
msgctxt "ha95089c7g0069g44efgab11g5a820502c961"
msgid "Please! Don't - leave!"
msgstr "제발! 그러지 마, 떠나지 마!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Baelen Bonecloak
#. NodeID = 58896f8d-79d4-c802-706b-29a61d950894
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter:58896f8d-79d4-c802-706b-29a61d950894
msgctxt "h8a633204gaa77g416cgaf16g59ca5dcddaed"
msgid "Derryth! Must be worried rotten."
msgstr "데리스! 분명 걱정이 태산일 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Player
#. NodeID = 58e3f44d-ecaf-944e-c6de-4cf514db4258
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter:58e3f44d-ecaf-944e-c6de-4cf514db4258
msgctxt "he658bc40g09aeg4371g81dcg6366a98e5629"
msgid "I met your wife."
msgstr "당신 아내를 만났어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Baelen Bonecloak
#. NodeID = 59e6f331-fdfe-85d9-6cce-3c39351b438b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter:59e6f331-fdfe-85d9-6cce-3c39351b438b
msgctxt "h96058d72gb315g43a2g9758g249b941e6186"
msgid "Heh. You may be right. And worse - yes, worse by the day."
msgstr "헤. 네 말이 맞을지도 모르지. 게다가 더 나빠지고 있어, 매일 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Baelen Bonecloak
#. NodeID = 5bf4547e-52f8-a0a3-56ae-0299adce335d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter:5bf4547e-52f8-a0a3-56ae-0299adce335d
msgctxt "hbe941a31g8eb9g4ee9g9b2bga9cc5df5099f"
msgid "Wasteful. Very wasteful. What's done is - that is - it's done."
msgstr "낭비지. 아주 낭비야. 이미 일어난 일은 - 그러니까 - 이미 일어났어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Baelen Bonecloak
#. NodeID = 5ed8a026-7a72-d205-a2e8-32f08cd011fd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MushroomHunter_Knows_TookMushroom = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter:5ed8a026-7a72-d205-a2e8-32f08cd011fd
msgctxt "h484467dfgd535g495ag9af3g02aa25a2b8e8"
msgid "Me too. Yes - very glad."
msgstr "나도야. 그래 - 몹시 기뻐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Player
#. NodeID = 5f64c612-a07a-f0bd-03d8-56ca27060024
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter:5f64c612-a07a-f0bd-03d8-56ca27060024
msgctxt "hf9c5b2edg3a2ag4d6dg9246g4ee94a35973d"
msgid "<i>Turn away.</i>"
msgstr "<i>외면한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Baelen Bonecloak
#. NodeID = 61a3ae86-d62d-2ae8-1ded-dc796ed1f42d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_MushroomHunter_HasMet(1) = False
#.   Global:
#.      - UND_MushroomHunter_State_Saved = False
#. SetFlags:
#.   Dialog:
#.     - UND_MushroomHunter_HasMet(1) = True
#.   Global:
#.     - UND_MushroomHunter_Met_InMushrooms = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter:61a3ae86-d62d-2ae8-1ded-dc796ed1f42d
msgctxt "hc94cf77egc570g4e2agbda3g5539c0b9e394"
msgid "Stop, STOP!"
msgstr "멈춰, 멈춰!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Baelen Bonecloak
#. NodeID = 622839be-22b3-8cc6-40a8-41336d2449e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter:622839be-22b3-8cc6-40a8-41336d2449e7
msgctxt "h7fe0d61cg3d00g430agbb62g05365a81d938"
msgid "The shop! The shop needs all we find. Bonecloak's. Baldur's Gate."
msgstr "상점! 우리가 찾은 건 전부 그 상점에 가져가야 해. 본클록스. 발더스 게이트."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Player
#. NodeID = 63c38047-e37f-b4b8-4135-b760a3bdeac1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter:63c38047-e37f-b4b8-4135-b760a3bdeac1
msgctxt "haed8dcdegbf2dg4f23g869bg529339b7d9b6"
msgid "This is quite a predicament you've landed yourself in."
msgstr "상당히 곤란한 상황에 걸어 들어가셨군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Player
#. NodeID = 684553d8-361e-0c90-4934-c73e0023172f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_DwarvenAlchemist_Knows_LossOfMemory = True
#.   Object:
#.      - UND_MushroomHunter_State_HasMushroom(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter:684553d8-361e-0c90-4934-c73e0023172f
#, fuzzy
msgctxt "hef14c983gd40fg4d52ga831g40193c45c214"
msgid "<i>Give him the noblestalk to eat. It'll help clear his mind.</i>"
msgstr "<i>그에게 귀족 줄기를 먹인다. 그의 정신을 맑게 해줄 것이다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Baelen Bonecloak
#. NodeID = 6cc3da63-e05e-ebe1-d64b-4e03b2dbb7cf
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_MushroomHunter_Knows_Missing = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter:6cc3da63-e05e-ebe1-d64b-4e03b2dbb7cf
msgctxt "he155712fg2c84g4017g945ag2a8e93a68ff5"
msgid "Please - can't... can't get out..."
msgstr "제발 - 나갈... 나갈 수 없어..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Baelen Bonecloak
#. NodeID = 6d4c51fd-9d71-e97b-98e2-90bdfaa17a4b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter:6d4c51fd-9d71-e97b-98e2-90bdfaa17a4b
msgctxt "hf6b26e35gd0e4g4010g9013gf2cf38a51413"
msgid ""
"Thanks for your help. Stop by Bonecloak's if you're ever in Baldur's Gate."
msgstr "당신 덕분이지. 발더스 게이트에 올 일이 있다먼 본클록스에 들리라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Baelen Bonecloak
#. NodeID = 6f677bb2-d01c-ef9b-4e91-20891a5829cd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter:6f677bb2-d01c-ef9b-4e91-20891a5829cd
msgctxt "h98bea78ag0c0eg445egb648g1c40cfddc4f0"
msgid ""
"And the ledge... yes, I was on a ledge - crumbled to bits. And I tumbled "
"down."
msgstr "그리고 벼랑이... 맞아, 난 벼랑 위에 있었는데, 그게 무너졌어. 그렇게 난 굴러 떨어졌고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Baelen Bonecloak
#. NodeID = 7063539c-66e2-b669-473c-5e4a46f0bdb7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_MushroomHunter_Event_HasReward(0) = True
#. SetFlags:
#.   Object:
#.     - UND_MushroomHunter_Event_GiveReward(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter:7063539c-66e2-b669-473c-5e4a46f0bdb7
msgctxt "h394887dagff00g4a77g9015gd1ddcee6ee1d"
msgid "For you - your trouble!"
msgstr "도움 - 도움에 대한 보상이야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Player
#. NodeID = 7425002a-72b0-79fe-ce73-d97958e146c8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_MushroomHunter_Knows_WhatIsBibberbang(1) = False
#. SetFlags:
#.   Dialog:
#.     - UND_MushroomHunter_Knows_WhatIsBibberbang(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter:7425002a-72b0-79fe-ce73-d97958e146c8
msgctxt "hbbc14116ge57cg46b9g97bfg7b2ac15b1b88"
msgid "Bibber-<i>what? </i>Speak plainly, won't you?"
msgstr "비버 <i>뭐라고요? </i>조금 더 분명히 말해주실래요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Baelen Bonecloak
#. NodeID = 74c64fa2-6b0d-1f0d-243b-119674228c17
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_MushroomHunter_Knows_Missing = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter:74c64fa2-6b0d-1f0d-243b-119674228c17
msgctxt "hb4850405g1838g4789g92deg42b880a81825"
msgid "Just have to... and then... here!"
msgstr "그냥... 그리고... 여기야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Player
#. NodeID = 75457f6b-8e78-1427-639f-0b383a85a139
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_MushroomHunter_State_NoThrowing(1) = True
#.   Script:
#.      - GEN_CheckHasItemTemplate = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter:75457f6b-8e78-1427-639f-0b383a85a139
msgctxt "hfcdb789dgd6edg416dg848dga27818211355"
msgid "<i>Give the scroll to him.</i>"
msgstr "<i>그에게 두루마리를 넘긴다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Baelen Bonecloak
#. NodeID = 75d6973c-ab42-af1d-5266-632bb1cd52b8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter:75d6973c-ab42-af1d-5266-632bb1cd52b8
msgctxt "h8d8d9969g8c31g47f0g8db5g6e633062fcbe"
msgid "Mushroom. Powerful. Derryth wants it for a brew."
msgstr "버섯이야. 강렬한. 데리스가 양조용 버섯을 원해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Baelen Bonecloak
#. NodeID = 784e3b39-d06a-4239-1923-d78b6343b6a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter:784e3b39-d06a-4239-1923-d78b6343b6a3
msgctxt "h7e98bf0bg70d2g44eeg8306g82c59cb8367f"
msgid "Oh - very glad. She'll be <i>very </i>glad."
msgstr "오, 다행이군. 그녀가 <i>아주 </i>기뻐하겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Baelen Bonecloak
#. NodeID = 7b88641e-8d88-7439-fbeb-86f463dee90c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter:7b88641e-8d88-7439-fbeb-86f463dee90c
msgctxt "hd4bb7019g2be4g460dg9333gd7a8430cb9e7"
msgid "I forget. Derryth might know."
msgstr "난 까먹어. 데리스는 알지도 몰라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Player
#. NodeID = 7d3ae866-2af7-044b-ed06-1f2b7887e456
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter:7d3ae866-2af7-044b-ed06-1f2b7887e456
msgctxt "h1381da1cg45bdg4c1fg8a7egc036a95770cb"
msgid "Surely you can navigate around some fungi, can't you?"
msgstr "곰팡이 정도는 알아서 잘 빠져나올 수 있지 않나요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Baelen Bonecloak
#. NodeID = 7f832002-0469-7467-4293-4ac360c8aa8b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter:7f832002-0469-7467-4293-4ac360c8aa8b
msgctxt "hcb0837e4ga9b7g48b0ga8bdgff09338a09fa"
msgid ""
"Next time - more careful next time. For certain. Thank you - for your help."
msgstr "다음 때 - 다음 번에는 더 조심할 거야. 확실히. 고마워 - 도와줘서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Baelen Bonecloak
#. NodeID = 80a45bea-7863-f522-a9f4-8b9bce4da94b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_MushroomHunter_HasMet(1) = True
#.      - UND_MushroomHunter_AgreedToHelp(1) = True
#.   Global:
#.      - UND_MushroomHunter_State_ScrollIsMissing = True
#.      - UND_MushroomHunter_State_Saved = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter:80a45bea-7863-f522-a9f4-8b9bce4da94b
msgctxt "hbb63305cg357eg49e5g9f4cg07c854f00005"
msgid "A scroll! There was a scroll in my pack. Please - I need it!"
msgstr "두루마리! 내 배낭 안에 두루마리가 있어. 제발 - 그게 필요해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Player
#. NodeID = 81a5460d-5a19-bb49-0f55-72bf36215cbe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter:81a5460d-5a19-bb49-0f55-72bf36215cbe
msgctxt "h52cf9342ga63cg492bg8e68g6309b2e22e6b"
msgid "This is your mess - figure it out yourself."
msgstr "당신 문제니까 알아서 해결하세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Baelen Bonecloak
#. NodeID = 81bdc77d-72c5-412c-711e-7f002c4f2452
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MushroomHunter_State_MushroomDelivered = True
#.      - UND_DwarvenAlchemist_State_AlchemistGotNoblestalk = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter:81bdc77d-72c5-412c-711e-7f002c4f2452
msgctxt "h8569c105gf2d4g4292gbad0ge158860bb243"
msgid "Sold it to... to Derryth?"
msgstr "데리스에게... 팔았다고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Player
#. NodeID = 849f06a7-76a5-f635-130b-ce36142c926c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - UND_MushroomHunter_ExplainedSituation(1) = False
#. SetFlags:
#.   User:
#.     - UND_MushroomHunter_ExplainedSituation(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter:849f06a7-76a5-f635-130b-ce36142c926c
msgctxt "h8b0946dbg4b9eg41ebga194gfef17d842310"
msgid "How did you wind up trapped like that?"
msgstr "어떻게 그런 식으로 갇히게 됐습니까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Player
#. NodeID = 85219e5a-071c-a4fe-446f-054b40080314
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - UND_MyconidCircle_State_AskedDwarfAboutOrigins(1) = False
#. SetFlags:
#.   User:
#.     - UND_MyconidCircle_State_AskedDwarfAboutOrigins(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter:85219e5a-071c-a4fe-446f-054b40080314
msgctxt "hed264d3eg7b34g4323g8ee5gdcbf51ffa7ce"
msgid ""
"You must be keen on mushrooms if you'll willing to brave the Underdark for "
"them."
msgstr "버섯을 구하기 위해 언더다크의 위험을 감수할 정도면, 당신은 버섯에 대한 열정이 상당하겠군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Baelen Bonecloak
#. NodeID = 85f060e8-5abf-7fdf-b218-f5a80e2cd704
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MushroomHunter_State_MushroomDelivered = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter:85f060e8-5abf-7fdf-b218-f5a80e2cd704
msgctxt "hcd772137gf4aag4632gb3fdg5063537f80a1"
msgid "Derryth wants it very badly. Very, very badly indeed."
msgstr "데리스가 그걸 정말 가지고 싶어 해. 아주, 아주 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Baelen Bonecloak
#. NodeID = 88816655-6b11-045a-851c-ebdd647ac629
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter:88816655-6b11-045a-851c-ebdd647ac629
msgctxt "h069fbabag8737g4316g962bg6c6c1d20d938"
msgid "Derryth... <i>no.</i>"
msgstr "데리스... <i>안 돼.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Player
#. NodeID = 88c719bf-193a-085b-a804-817bccf60d6a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter:88c719bf-193a-085b-a804-817bccf60d6a
msgctxt "h0a347ffcgce00g41cega846g8e060c09b928"
msgid "Scrolls don't come cheap, you know."
msgstr "아시다시피, 두루마리가 좀 비싸거든요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Baelen Bonecloak
#. NodeID = 8a403cab-b0d5-4205-1f42-bf48e6e118f3
#. HandlePath = TaggedText[0].TagText[0]
