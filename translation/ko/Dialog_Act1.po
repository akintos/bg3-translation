msgctxt "h15a26878g6172g40d5gb43cgf700b68594fc"
msgid "This is going to end in blood."
msgstr "결국 피를 보게 되겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_Trainer
#. Speaker = Asharak
#. NodeID = 2ef4a715-d7d2-54ae-1076-055c40e851f6
