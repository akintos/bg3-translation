msgctxt "h2e47612ag4279g44f5g9129gabcdfd33da44"
msgid "In my... workroom..."
msgstr "내... 작업실에..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead
