msgctxt "hde1f7630g2462g4696gbaf6g3295be4974a1"
msgid "Arcane flames. Handy."
msgstr "비전 불꽃이라. 유용하네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_ArcaneTower_PAD_Lights
