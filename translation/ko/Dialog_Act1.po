msgid "I bet we can work out how to open it."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/VBs/GOB_TempleAccess_PuzzleApproach_ReadInstructions_VB
#. Speaker = Player
#. NodeID = f344c9c1-48fc-3084-27dc-e978f3f4d916
