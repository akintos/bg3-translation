msgctxt "h3054659ag4a82g4794g9009g9f80046511cb"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_HarperBooster_ScaredBoar
#. Speaker = Scared Boar
#. NodeID = df16768a-8c3e-0184-1bbc-e20af816692a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_HarperBooster_ScaredBoar:df16768a-8c3e-0184-1bbc-e20af816692a
msgctxt "hf881d9d7g0c65g419bga4c8g77fc3d406875"
msgid "You're all the same. Too many of my kind died because of your spears."
msgstr "너흰 다 똑같은 것들이야. 너희 창에 내 동족들이 너무나 많이 죽어나갔다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_HarperBooster_ScaredBoar
#. Speaker = Narrator
#. NodeID = ed40a7d6-a228-d054-daf5-ba6df08633ea
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CRA_Escape_Event_BoarFlee(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_HarperBooster_ScaredBoar:ed40a7d6-a228-d054-daf5-ba6df08633ea
msgctxt "hca70ff28g8580g4255gaf0egb0673b5edad7"
msgid ""
"*The boar shuffles its trotters, unsure. Then it dashes away into the "
"wilderness.*"
msgstr "*멧돼지는 의심스러운 듯이 발을 동동거립니다. 그러곤 황야로 쏜살같이 달아납니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_LaezelWakingUp
#. Speaker = Narrator
#. NodeID = 0e74fe4b-cbb7-a0cb-4a8c-207c7e767c80
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_LaezelWakingUp:0e74fe4b-cbb7-a0cb-4a8c-207c7e767c80
msgctxt "h1a43c39fg5223g40aag8f0dg2209c2ba4b5c"
msgid "*The pain deepens as you take in the world around you.*"
msgstr "*주변 상황을 받아들일수록, 고통은 더욱 깊어집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_LaezelWakingUp
#. Speaker = Player
#. NodeID = 13948a2f-c79d-9eb5-8ff9-44802454013e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_LaezelWakingUp:13948a2f-c79d-9eb5-8ff9-44802454013e
msgctxt "heaffd7ffg1508g4bccgbd20g22d3e59e0130"
msgid "<i>Brush off the pain - there is no time to waste.</i>"
msgstr "<i>고통을 떨쳐낸다. 낭비할 시간 따위 없다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_LaezelWakingUp
#. Speaker = Lae'zel
#. NodeID = 228c14ee-cb35-b240-357b-9e45d47a1cf8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_LaezelWakingUp:228c14ee-cb35-b240-357b-9e45d47a1cf8
msgctxt "heb17d373gf0cfg4f82g85b3gb09fd3d2d8f6"
msgid ""
"'<i>Vlaakith'ka sivim hrath krash'ht</i>.' Only in Vlaakith may we find "
"light."
msgstr "'<i>블라키스'카 시빔 흐라쓰 카라싯</i>.' 오직 블라키스 님을 통해서만 광명을 찾을지니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_LaezelWakingUp
#. Speaker = Player
#. NodeID = 411002c7-5038-55ac-014f-cddca2d7a302
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_LaezelWakingUp:411002c7-5038-55ac-014f-cddca2d7a302
msgctxt "h1c032426g9fceg4586g8708ged2a97947efc"
msgid "<i>Rub your forehead. Can you feel the tadpole, wriggling inside?</i>"
msgstr "<i>이마를 문지른다. 올챙이가 안에서 꿈틀거리는 것이 느껴지는가?</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_LaezelWakingUp
#. Speaker = Narrator
#. NodeID = 50606935-2424-5636-f2be-8545806db82b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_LaezelWakingUp:50606935-2424-5636-f2be-8545806db82b
msgctxt "hae42d5a7gf70ag419fga75ag007f73eb2bdb"
msgid ""
"*It's only a matter of days before tentacles split your lips, and your skin "
"turns to gore.*"
msgstr "*당신의 입술이 촉수로 쪼개지고, 피부가 흉물로 변하는 건 시간문제입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_LaezelWakingUp
#. Speaker = Player
#. NodeID = 573df5dc-50f3-0a26-b432-6944d3325934
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_LaezelWakingUp:573df5dc-50f3-0a26-b432-6944d3325934
msgctxt "h5b64cf2cgdc54g4c83g9496g111088466aaf"
msgid ""
"<i>Summon your resolve. The </i>ghaik<i> tadpole will not be the end of "
"you.</i>"
msgstr "<i>결의를 다진다. </i>게이크<i> 올챙이 따위로 끝장날 생각 따윈 없다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_LaezelWakingUp
#. Speaker = Player
#. NodeID = 6e925e4b-2353-6f12-3534-b0c0dd849b22
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_LaezelWakingUp:6e925e4b-2353-6f12-3534-b0c0dd849b22
msgctxt "hca866d01g5ac0g44f9g848fg03f02c3e038a"
msgid ""
"<i>Meditate on the words of your queen. Through them, you will find calm.</i>"
msgstr "<i>여왕님의 말씀을 떠올려라. 그리하면 평온을 얻을 것이다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_LaezelWakingUp
#. Speaker = Narrator
#. NodeID = 77a6bc30-5375-6beb-ce19-1f61c98d9b05
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_LaezelWakingUp:77a6bc30-5375-6beb-ce19-1f61c98d9b05
msgctxt "h0bc00a24ga735g4227gb5ccgb7d4a7d2565f"
msgid ""
"*Your skull throbs, your muscles ache. Memories of the last day swim through "
"your head before taking form.*"
msgstr "*머리가 지끈거리고, 근육이 쑤십니다. 어제의 기억들이 채 떠오르기도 전에 물 흐르듯이 머릿속을 빠져나갑니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_LaezelWakingUp
#. Speaker = Narrator
#. NodeID = 8e570c29-52bc-261c-932f-1bea112a0534
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_LaezelWakingUp:8e570c29-52bc-261c-932f-1bea112a0534
msgctxt "h3a34b412gcfbeg498fgb953g3e954774b6c4"
msgid ""
"*It is only a matter of days before tentacles split your lips, and your skin "
"turns to gore.*"
msgstr "*당신의 입술이 촉수로 쪼개지고, 피부가 흉물로 변하는 건 시간문제입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_LaezelWakingUp
#. Speaker = Narrator
#. NodeID = 9f832004-e6ab-1be4-982a-9a66d6da4155
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_LaezelWakingUp:9f832004-e6ab-1be4-982a-9a66d6da4155
msgctxt "he4c250dbgc507g4d22gac91ga65d86e2d44e"
msgid ""
"*The world around you comes into focus. Whatever this place, you know "
"Vlaakith's protocol: you must locate a githyanki crèche.*"
msgstr ""
"*이제야 주변 환경이 눈에 제대로 들어옵니다. 이곳이 어딘지는 몰라도, 블라키스 님의 수칙만은 알고 있죠. 당신은 기스양키 양성소를 "
"찾아내야 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_LaezelWakingUp
#. Speaker = Narrator
#. NodeID = b40d026e-c89c-1cb1-07e0-cd01443a20b6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_LaezelWakingUp:b40d026e-c89c-1cb1-07e0-cd01443a20b6
msgctxt "hf8e1c4bcgcafag4c87g94bbg7a48bc3cfbb1"
msgid ""
"*Inside you, an atrocity is growing - feeding on you, <i>becoming</i> you.*"
msgstr "*당신의 몸속에서, 흉악한 것이 자라고 있습니다. 당신을 먹어치우고, <i>당신이</i> 되고 있죠.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_LaezelWakingUp
#. Speaker = Narrator
#. NodeID = b83d0c53-ab8b-a2b1-cc48-92845a7a5ea6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_LaezelWakingUp:b83d0c53-ab8b-a2b1-cc48-92845a7a5ea6
msgctxt "he210194egfe2bg45acg8df1ga7577b41f8d8"
msgid ""
"*If you want a cure, you must follow protocol: locate a githyanki crèche.*"
msgstr "*치료를 받으려면 행동수칙을 따라야 합니다. 기스양키 양성소를 찾아내는 것 말입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_LaezelWakingUp
#. Speaker = Narrator
#. NodeID = bd6fbb75-b45f-4111-d298-81c1e92a4802
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_LaezelWakingUp:bd6fbb75-b45f-4111-d298-81c1e92a4802
msgctxt "hbb9022c3g1a57g4e85gb3acgf7d2df2dd253"
msgid ""
"*At a crèche, you will find your kin. The tadpole will be removed, and you "
"will be purified.*"
msgstr "*양성소에 도착하면, 동족을 찾을 수 있겠죠. 올챙이는 제거되고, 당신은 정화되는 겁니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_LaezelWakingUp
#. Speaker = Narrator
#. NodeID = d32f92a8-1b31-816b-3de7-c03979e88b4b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_LaezelWakingUp:d32f92a8-1b31-816b-3de7-c03979e88b4b
msgctxt "h28a2737dgd963g45ffgb50ag6d90f90c00cb"
msgid ""
"*The pain brings the world into focus. Whatever this place, you know "
"Vlaakith's protocol: you must locate a githyanki crèche.*"
msgstr ""
"*고통과 함께 주변 환경이 뚜렷이 보입니다. 이곳이 어딘지는 몰라도, 블라키스 님의 수칙만은 알고 있죠. 당신은 기스양키 양성소를 "
"찾아내야 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_LaezelWakingUp
#. Speaker = Narrator
#. NodeID = d52c1e0b-95cc-d361-a4a5-93270838e3f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_LaezelWakingUp:d52c1e0b-95cc-d361-a4a5-93270838e3f5
msgctxt "h3a7feeefg3658g41e3g8b91g6a275a4690d9"
msgid ""
"*Whatever this place, you know Vlaakith's protocol: you must locate a "
"githyanki crèche.*"
msgstr "*이곳이 어딘지는 몰라도, 블라키스 님의 수칙만은 알고 있죠. 당신은 기스양키 양성소를 찾아내야 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_LaezelWakingUp
#. Speaker = Narrator
#. NodeID = f22f3017-43b6-da8a-f4cf-8bb04639a0b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_LaezelWakingUp:f22f3017-43b6-da8a-f4cf-8bb04639a0b4
msgctxt "h2ce38e40gec1dg405eg8a89geab39e0543a7"
msgid ""
"*There, you will find your kin. The tadpole will be removed, and you will be "
"purified.*"
msgstr "*거기에 당신의 동족이 있을 테죠. 올챙이는 제거되고, 당신은 정화되는 겁니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_ShadowheartRecruitment_AD
#. Speaker = Shadowheart
#. NodeID = 3cf8b0b2-8e79-41e4-9502-57734070b20a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3d846e74-5362-ea70-bd9a-379e5d57ebc4_A = True
#. SetFlags:
#.   Local:
#.     - 3d846e74-5362-ea70-bd9a-379e5d57ebc4_B = True
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_ShadowheartRecruitment_AD:3cf8b0b2-8e79-41e4-9502-57734070b20a
msgctxt "h565f87d0g38adg4911g849eg775d316b6f8e"
msgid "Ngh... no..."
msgstr "끙... 안 돼..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_ShadowheartRecruitment_AD
#. Speaker = Shadowheart
#. NodeID = 50c9b1ca-a2f3-47b3-bbcb-53cc1ebfed8f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 3d846e74-5362-ea70-bd9a-379e5d57ebc4_B = True
#. SetFlags:
#.   Local:
#.     - 3d846e74-5362-ea70-bd9a-379e5d57ebc4_B = False
#.     - 3d846e74-5362-ea70-bd9a-379e5d57ebc4_A = False
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_ShadowheartRecruitment_AD:50c9b1ca-a2f3-47b3-bbcb-53cc1ebfed8f
msgctxt "he7d14737g8ebeg4c95gb89cg26013848355e"
msgid "Agh..."
msgstr "아아..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_ShadowheartRecruitment_AD
#. Speaker = Shadowheart
#. NodeID = b15875e4-2240-4f7b-8f64-69ccdea06f9e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 3d846e74-5362-ea70-bd9a-379e5d57ebc4_A = True
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_ShadowheartRecruitment_AD:b15875e4-2240-4f7b-8f64-69ccdea06f9e
msgctxt "h150cbab8gf936g4e82g888fg6d58326641fb"
msgid "Uhh..."
msgstr "으..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = 001a9b83-a003-69d7-ac16-e3854b6fbe4e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_WentWithAdventurers = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:001a9b83-a003-69d7-ac16-e3854b6fbe4e
msgctxt "h2c760698g6212g4aedgbc4ega7f34b26b150"
msgid ""
"I already met her - she says Halsin left the grove with you. Is that true?"
msgstr "그 사람은 이미 만났어. 할신이 너랑 같이 숲을 나섰다고 얘기해주던데. 사실이야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = 01516f80-e92e-1c59-0df4-acb53aae5e4d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AdventurersQuest_HasMet_ALeader(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:01516f80-e92e-1c59-0df4-acb53aae5e4d
msgctxt "hb8ae16ccg8f0bg45aaga7e2g6d9f73789ccb"
msgid "I'm drinkin'. You're leavin'."
msgstr "술맛 떨어진다. 저리 꺼져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = 01975953-6388-1627-8b37-eefd4dc4c568
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:01975953-6388-1627-8b37-eefd4dc4c568
msgctxt "hc402f05dgb534g44d0g949bg19cd32e6f1ea"
msgid "Half my crew are full of holes."
msgstr "내 동료 절반은 구멍투성이가 됐어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = 022363ea-6d88-12bf-8251-845e7d166653
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:022363ea-6d88-12bf-8251-845e7d166653
msgctxt "hca80b101gc678g4038ga022g6936e28d2790"
msgid ""
"Fair enough. I ain't tryin' to start the shite with you, anyway. Been a day."
msgstr "알아들었어. 애초에 너한테 시비 걸 생각 따윈 없었다고. 일진 사나운 판인데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = 024d7ee0-f010-3052-acd2-2af537401c5a
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_HALFLING
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:024d7ee0-f010-3052-acd2-2af537401c5a
msgctxt "h93de4a77gcc38g49f7gacecg7716104451bc"
msgid "What's a home for if not for sharing? Who lives here?"
msgstr "집이란 건 원래 다같이 더불어 사는 거잖아? 여기 집주인이 누군데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = 024d7ee0-f010-3052-acd2-2af537401c5a
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:024d7ee0-f010-3052-acd2-2af537401c5a
msgctxt "hfa0482dcgf105g4d1egaff3gb42bc3896b53"
msgid "And whose home is this exactly?"
msgstr "그럼 여기 집주인은 누군데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = 0841da2d-bfaf-0bd6-7e69-521313dee2a6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:0841da2d-bfaf-0bd6-7e69-521313dee2a6
msgctxt "h3d8f75d9ga58eg4c05g88b2gec1278190f2f"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = 08c57b22-8cdc-0989-5b24-27a2b278e305
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:08c57b22-8cdc-0989-5b24-27a2b278e305
msgctxt "he55eb9ffg0b4bg4d1cg9279g0a7ad0867801"
msgid ""
"Them devils ain't local - they're refugees. Fella who runs this place "
"offered 'em shelter."
msgstr "저 데빌 놈들은 집주인이 아니야. 피난민이지. 여기 책임자가 놈들한테 거처를 제공했을 뿐이라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = 0b03d807-bb8f-31c0-e972-f48a9f6c98bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:0b03d807-bb8f-31c0-e972-f48a9f6c98bf
msgctxt "h6978edf9g9c14g45b9g9134g9467cf312164"
msgid ""
"We've got a contract to track down some relic, and he wanted in on the job. "
"Eyes lit up when he heard about it."
msgstr "우린 어떤 유물 찾는 의뢰를 수행하러 왔는데, 그자가 자기도 끼워달랬지. 유물 이야기를 듣자 눈이 희번덕대더군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = 0b78ec30-16b9-3b1d-dd18-4a8a97dce9e4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:0b78ec30-16b9-3b1d-dd18-4a8a97dce9e4
msgctxt "h58874d2cgf9f7g4bb7g9641gdba065bd22ea"
msgid "You might be, if you demonstrated more honour in your dealings."
msgstr "네가 좀 더 명예롭게 처신해 보였으면, 찍힐 일도 없었겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = 0c8e30fb-ec7c-a44c-ce58-0895f0ac3a4c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:0c8e30fb-ec7c-a44c-ce58-0895f0ac3a4c
msgctxt "hf446e1b4gdd0bg4425gb70ag40ec13577867"
msgid ""
"Wasn't no <i>few </i>goblins, mate. There's an entire hive of 'em. Contract "
"failed to mention that part."
msgstr "고작 고블린 <i>몇 놈</i>이 아니었다고, 친구. 벌집 소굴이 따로 없었단 말이야. 의뢰서엔 그런 내용은 없었는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = 0edb31b9-5952-6722-6a66-997eec176579
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:0edb31b9-5952-6722-6a66-997eec176579
msgctxt "hd5d90077g22f9g4f6dg94ecgfa5dd028cb95"
msgid "Yeah, and I'd do the same again. He weren't my responsibility."
msgstr "그래. 그때로 돌아가도 똑같이 할 거다. 난 그치 책임질 이유 없다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = 177e3a35-e6a4-988a-2e09-6de685aff71f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:177e3a35-e6a4-988a-2e09-6de685aff71f
msgctxt "hbd92d404gaa55g4dfdgb4e5g78173ea0874b"
msgid "Glad you weren't - you fight well. Not like them bloody tieflings."
msgstr "아니어서 다행이지. 제법 잘 싸우던걸. 저 망할 티플링네랑은 달리 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = 18ca0144-cc79-fcae-fb64-2c4bf85326cc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:18ca0144-cc79-fcae-fb64-2c4bf85326cc
msgctxt "h8485f0a0gb2beg4988gbe7fg7e9d62878100"
msgid ""
"Yeah? And how's that workin' out for you? Stuck in this hellhole with the "
"rest of us."
msgstr "그래? 그래서 그거 알면 뭐가 잘 풀리냐? 우리랑 똑같이 이 썩을 곳에 처박힌 주제에."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = 19cb1a6b-e5d6-3270-7329-85feb408292c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:19cb1a6b-e5d6-3270-7329-85feb408292c
msgctxt "h34989a5fg43fcg41a2g9637g0b461b5e6bd1"
msgid "Yeah, you really saved the day, swooping in and playing the hero."
msgstr "그래, 아주 대단한 구원자 납시셨더군. 불쑥 나타나 영웅 놀이하던 꼴이 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = 1bd4fa12-b75a-e2c9-2a29-b3932f67e009
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Halsin_Knows_IsMissing = True
#.   Quest:
#.     - GLO_Tadpole_SUB_Druid.LearnedLostHalsin(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:1bd4fa12-b75a-e2c9-2a29-b3932f67e009
msgctxt "h29287b10g60e1g4f37gba11gae0a03ff902b"
msgid ""
"You're outta luck. Halsin - druid who runs this place - knew his stuff. But "
"he ain't here anymore."
msgstr "재수도 없으시군. 할신이라고, 여기 굴리는 드루이드가 치유사인데 말이야. 근데 이젠 여기 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = 1c85393a-ec4b-11b6-c017-ebf7806de817
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:1c85393a-ec4b-11b6-c017-ebf7806de817
msgctxt "hdcce818bg73bfg42c3g8eecg6366164271a2"
msgid "They chased us all the way from the ruins we were poking around in."
msgstr "어떤 유적 뒤지던 중에 맞닥뜨렸는데, 여기까지 쫓아오더군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = 1ecbf76c-dc4a-7ed7-63ce-38a1e3dd523e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_WentWithAdventurers = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:1ecbf76c-dc4a-7ed7-63ce-38a1e3dd523e
msgctxt "h7971b746g22f6g44d5ga2f2g7f99f4777426"
msgid "I should speak with that fellow. Do you know where he is?"
msgstr "난 그 책임자란 사람하고 대화를 해야겠거든. 어디에 있는지 알아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = 218b3cec-20bf-c95f-e3c0-80478e1e8c8c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:218b3cec-20bf-c95f-e3c0-80478e1e8c8c
msgctxt "he728b9eeg151fg4b6dga176g57e061737923"
msgid "Sounds like you were looking for trouble."
msgstr "위험한 데를 괜히 제발로 들어갔단 얘기로 들리는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = 227c44ab-24cc-3e97-8522-f2fe909ac8ca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:227c44ab-24cc-3e97-8522-f2fe909ac8ca
msgctxt "hf1501fc8gb1fbg453cgb60egad52a953115b"
msgid "Who's the druid you lost track of?"
msgstr "네가 잃었다는 그 드루이드가 누군데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = 228a50dd-75de-7f46-33d6-4a01386a8db4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:228a50dd-75de-7f46-33d6-4a01386a8db4
msgctxt "hd5f04b44g6543g4b84gaaecg6940306d6b65"
msgid ""
"If you head that way, you'll likely smell 'em or hear their drums before you "
"see 'em."
msgstr "그쪽으로 가면, 직접 보기도 전에 악취랑 북소리로 놈들을 알아차릴 수 있을 거다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = 23564c34-5608-cfad-8caa-b5779541ef11
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_WentWithAdventurers = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:23564c34-5608-cfad-8caa-b5779541ef11
msgctxt "ha18213dbg9bf1g4fcdg8b23gbf197685a55d"
msgid "I heard the First Druid left the grove with you. Any truth in that?"
msgstr "최고 드루이드가 너랑 같이 숲을 나섰다고 들었어. 그게 사실이야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = 2472967e-508d-1c5f-8bee-e8f854a28ef1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:2472967e-508d-1c5f-8bee-e8f854a28ef1
msgctxt "habcc0201g7b5fg4557g9217g2db27ca5567b"
msgid ""
"As soon as he heard we had a contract to find that Nightsong relic, he was "
"more eager than a hound in heat."
msgstr "우리가 그 밤의 노래란 유물 찾는 의뢰를 받았단 얘길 듣자마자, 그치 쪽에서 발정난 개처럼 관심을 보여댔어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = 2624fb13-6001-8f6e-932f-6472c98b8455
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:2624fb13-6001-8f6e-932f-6472c98b8455
msgctxt "h3a0c7e43g54bbg4deegac57g05a77a144272"
msgid "I need a stronger drink. And you need to get out of my face."
msgstr "더 독한 걸 들이켜야겠어. 그리고 넌 내 앞에서 면상 치워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = 29ba4721-72e6-091b-b952-bc0069eb0ecb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:29ba4721-72e6-091b-b952-bc0069eb0ecb
msgctxt "hb6fe495dgff7bg4917gb797g19e5567725cc"
msgid "Doubt it."
msgstr "글쎄다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = 2a4d134e-3424-5866-9af5-af988b1b3c3d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToIndivPlayerAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:2a4d134e-3424-5866-9af5-af988b1b3c3d
msgctxt "h73eda525g6922g422eg8358g86d1f057a590"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = 2d85af4b-64ea-ef26-7f69-14f377d8e5f7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:2d85af4b-64ea-ef26-7f69-14f377d8e5f7
msgctxt "h4252f6deg64adg4edag907egc1f32ebb4c1d"
msgid "But look, if you're itching to meet Kelemvor, I won't stop you."
msgstr "그래도 뭐, 네 소원이 일찍 켈렘보르 만나는 거라면, 굳이 말리진 않겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = 2e6e55eb-787d-cf93-1854-993fd6a6456f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:2e6e55eb-787d-cf93-1854-993fd6a6456f
msgctxt "ha852a02dgf939g49e6g8ecdgd12db64b94db"
msgid "And is that where you lost track of the druid you mentioned?"
msgstr "그럼 그 드루이드를 잃어버린 곳도 거기인 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = 2eadb4ed-1378-acb7-c7e0-f6e8ad241704
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:2eadb4ed-1378-acb7-c7e0-f6e8ad241704
msgctxt "h5a4da368g65a8g432agbf8ag132040173190"
msgid "I could use some help - is there a healer here?"
msgstr "도움이 좀 필요한데 말이지. 이곳에 치유사가 있어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = 312bc937-d7a2-5e40-80bf-ca4624e051e7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_AdventurerLeader_State_AngryAtPlayer(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:312bc937-d7a2-5e40-80bf-ca4624e051e7
msgctxt "h8807f526g54dbg49a4gaec3g42488b58bc5c"
msgid "Thanks."
msgstr "거 고맙군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = 312fec6f-3028-eca1-fa7f-b9bd951643f9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:312fec6f-3028-eca1-fa7f-b9bd951643f9
msgctxt "hd9b59930ge884g4a95g83b0g45f89a1b70e0"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = 31fe0e43-0694-9a76-cedb-7eb8722f1cee
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_WentWithAdventurers = True
#.      - GLO_AdventurersQuest_Knows_AboutBounty = True
#.   Quest:
#.      - GLO_Tadpole_SUB_Druid.LearnedLostHalsin(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:31fe0e43-0694-9a76-cedb-7eb8722f1cee
msgctxt "h4dd3bd5cgbf40g4850g87c5g4a37d8f75b8b"
msgid ""
"I'm not leaving until you tell me exactly what happened to the First Druid."
msgstr "최고 드루이드가 어떻게 됐는지 제대로 알려주기 전까진 떠나지 않을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = 381faef2-573a-15a2-ab1c-7ea53f3d59bd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AdventurersQuest_Knows_AradinStory = False
#. TagRule: REALLY_DRAGONBORN
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:381faef2-573a-15a2-ab1c-7ea53f3d59bd
msgctxt "h573a2112g2bbdg4471gaba8geba3f717b826"
msgid "Drinking won't solve your problems. You need a plan."
msgstr "술 마신다고 네 문제가 해결되진 않아. 계획을 세워야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = 381faef2-573a-15a2-ab1c-7ea53f3d59bd
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AdventurersQuest_Knows_AradinStory = False
#. TagRule: REALLY_HALFORC
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:381faef2-573a-15a2-ab1c-7ea53f3d59bd
msgctxt "h3b2e5d91g302ag466bgbd62g8f253b890789"
msgid "No - I'm staying. You need to learn some manners."
msgstr "아니, 난 여기 있을 거야. 넌 예의나 좀 배우지 그래."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = 381faef2-573a-15a2-ab1c-7ea53f3d59bd
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AdventurersQuest_Knows_AradinStory = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:381faef2-573a-15a2-ab1c-7ea53f3d59bd
msgctxt "h3c948f5bgc2f7g4031ga252gdb60e7881968"
msgid "You don't need company?"
msgstr "같이 마실 사람 필요하진 않아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = 3857b2e4-5810-7459-8eb2-c9ae094b6981
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Apprentice_Knows_HeardAboutNettie = False
#.      - DEN_Apprentice_UserShortcut = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:3857b2e4-5810-7459-8eb2-c9ae094b6981
msgctxt "h494be2d1g4604g46b8gbdafg7a450106c22d"
msgid "Not my concern. Is there a healer round these parts?"
msgstr "그런 건 별 관심 없는데. 이 동네에 치유사는 없어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = 38c34c97-20ee-b269-7c1c-52e1cd27033f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:38c34c97-20ee-b269-7c1c-52e1cd27033f
msgctxt "haeaaa2eagec93g4b00g9590g177468a32ebd"
msgid ""
"You might have an easier time here if you demonstrated more honour in your "
"dealings."
msgstr "좀 더 명예롭게 처신해 보이면 여기 사람들이 너 대하는 태도도 누그러질 듯한데 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = 3e4870b3-afcd-912f-b6b1-e753d53ad57c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:3e4870b3-afcd-912f-b6b1-e753d53ad57c
msgctxt "h9b417aaeg88a2g49e0g9772g61b063b1f8c9"
msgid "Fine. Plenty more attractive faces around."
msgstr "좋아. 매력적인 얼굴이 늘었군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = 3f5afe9e-0313-6684-f260-e9fdc3055962
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:3f5afe9e-0313-6684-f260-e9fdc3055962
msgctxt "h69fbfb83ge849g44e4g887ag11ee965ca65d"
msgid "Where did the goblins come from?"
msgstr "그 고블린 놈들은 어디서 나타난 건데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = 426de28c-3c86-98c8-ffdc-a6f9c103f2dc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC(1) = True
#. TagRule: CLERIC_GOOD or CLERIC_NEUTRAL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:426de28c-3c86-98c8-ffdc-a6f9c103f2dc
msgctxt "h7db1362dge868g4303g821bg4a2b9f56019b"
msgid "Prayer will help more than any drink."
msgstr "술보단 기도를 올리는 게 더 의지가 될 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = 4465b1fd-f8ce-a760-c449-81dea658f8c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:4465b1fd-f8ce-a760-c449-81dea658f8c8
msgctxt "hcd347cd0g5c92g46c8gb448g1358313a625a"
msgid "Job's all yours, if you got a death wish."
msgstr "원한다면 너 가져. 죽는 게 소원이라면야, 뭐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = 4531ef5d-9ba5-ee41-b99f-2700a770818e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:4531ef5d-9ba5-ee41-b99f-2700a770818e
msgctxt "hf490bbbcgdbd6g4a02gb4f9g84b5e68053ca"
msgid "Please. A good sword will get you farther than honour any day."
msgstr "웃기시네. 명예 따위에 목매느니 칼로 해결 보는 게 나아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = 4571db35-c4eb-f32d-ebdf-f3bc54919775
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:4571db35-c4eb-f32d-ebdf-f3bc54919775
msgctxt "h5cb87123gaedcg47e6g80ccg95c85e2667d1"
msgid ""
"Heh, don't thank me. I'll be well on my way to Baldur's Gate when you die."
msgstr "고마워 하지 마. 너 죽을 쯤에 난 멀쩡히 발더스 게이트에 도착해 있을 테니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = 4f20cd4a-22f0-a95f-7530-1ac461cd9949
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AdventurersQuest_Knows_AradinStory = False
#.   Tag:
#.      - HALFLING(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:4f20cd4a-22f0-a95f-7530-1ac461cd9949
msgctxt "h3d6c2b08gb47bg421agb90dg57a05bfa8597"
msgid "Maybe I could drink with you? A toast to our survival."
msgstr "같이 한 잔 끼워주지 그래? 살아남은 걸 축하하자고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = 4f474ed6-dde1-b973-c7a9-c40fdfb6ef2a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:4f474ed6-dde1-b973-c7a9-c40fdfb6ef2a
msgctxt "h74736444g00bbg4313g9998g10c38e617b34"
msgid ""
"I already told you - he was at the temple ruins with us. But it ain't like "
"we forced him to go along."
msgstr "이미 말했잖아. 그치는 우리랑 같이 사원 폐허에 갔어. 하지만 무슨 강제로 끌고 간 건 아니라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = 50cb67bc-cf16-5f83-ea35-6ab57783b124
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:50cb67bc-cf16-5f83-ea35-6ab57783b124
msgctxt "hc1b75cceg5e94g44bcga858ge3bda26645c4"
msgid "And you just left him to die?"
msgstr "그래서 그냥 죽게 냅두고 왔단 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = 55b7a04e-1b7c-2d59-5938-e704883f0cdf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AdventurersQuest_Knows_AradinStory = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:55b7a04e-1b7c-2d59-5938-e704883f0cdf
msgctxt "hec6e386bgf921g44d0g96ddg0b442ee6dea8"
msgid "Fine. You're miserable company anyhow."
msgstr "그러지. 어차피 너랑은 같은 데 있기조차도 싫은걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = 59fb9990-4782-f54b-e7f7-f14c3f66a640
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:59fb9990-4782-f54b-e7f7-f14c3f66a640
msgctxt "h22a8b944gdacfg4ce0ga560g19416de554a1"
msgid "You got along with their leader?"
msgstr "그들 지도자하곤 사이가 괜찮았던 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = 5b533ce9-6190-5233-5a2e-0736f438d006
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:5b533ce9-6190-5233-5a2e-0736f438d006
msgctxt "hde05980fgf0edg4adegb6d8ge0199acebf3b"
msgid ""
"After the help I gave you, it would be honourable for you to address me "
"differently."
msgstr "넌 내 도움을 받았잖아. 명예란 게 있다면 날 대하는 태도 좀 고치지 그래."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = 5be352c7-a9c5-8425-3bf3-3d05b43c972a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:5be352c7-a9c5-8425-3bf3-3d05b43c972a
msgctxt "hbe018194g8bedg4e4eg9e23g8130baa6dab7"
msgid ""
"Aye. His name's Halsin, and if he's still alive, he'll be cursing the day he "
"laid eyes on me."
msgstr "그래. 할신이란 이름인데, 만약 아직 살아 있다면 나랑 눈 마주친 날을 저주하고 있을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = 5d0e3e40-ec2f-6a79-7910-6475df713875
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DROWELF(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AdventurersQuest_HasMet_ALeader(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:5d0e3e40-ec2f-6a79-7910-6475df713875
msgctxt "hfd4b8c5fg434ag4ca5g9664g6885436d32c5"
msgid ""
"If it ain't the friendly drow. Thought you were with the goblins when you "
"showed up at the gate."
msgstr "이거, 그 친절한 드로우 아니신가. 관문에서 막 나타났을 땐 고블린이랑 한패인 줄 알았는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = 5f4bf998-4e8e-aa9c-c486-cb32ef735157
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:5f4bf998-4e8e-aa9c-c486-cb32ef735157
msgctxt "h351039a4gc536g46bfg944bg0695fa4224ab"
msgid ""
"I saved your skin at the gate - least you can do is answer a simple question."
msgstr "관문에서 내 덕에 목숨 건졌잖아. 간단한 질문 몇 가지 정도는 대답해주지 그래."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = 601433e4-ff7f-76fd-f30f-34e0d46ad5d2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - SHA_Nightsong.LearnedLocation(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:601433e4-ff7f-76fd-f30f-34e0d46ad5d2
msgctxt "hdf6d7679gfca5g46e2g8b98ga9852b7c0f80"
msgid ""
"It's called the Nightsong. Supposed to be hidden under the temple where the "
"goblins jumped us."
msgstr "유물 이름은 밤의 노래야. 고블린이 우릴 덮친 그 신전 지하 어딘가에 숨겨져 있다고 하더군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = 63358f83-55e1-1887-61c1-d4978d652ae1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:63358f83-55e1-1887-61c1-d4978d652ae1
msgctxt "h726d9541gf25eg4781gb3ebge650d3476571"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = 65fae302-409c-f0d2-f155-296cea4a6f1c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_AdventurerLeader_State_AngryAtPlayer(1) = True
#. TagRule: TIEFLING
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:65fae302-409c-f0d2-f155-296cea4a6f1c
msgctxt "h80058d0ege0a2g4204gb7afg059e49f41373"
msgid "Outta my face, foulblood."
msgstr "면상 저리 치워, 더러운 혈통아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = 65fae302-409c-f0d2-f155-296cea4a6f1c
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_AdventurerLeader_State_AngryAtPlayer(1) = True
#. TagRule: SHORT
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:65fae302-409c-f0d2-f155-296cea4a6f1c
msgctxt "h35a8ee53g463ag4ef9g9b45gfb96301538df"
msgid "Outta my face, runt."
msgstr "면상 저리 치워, 땅딸보."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = 65fae302-409c-f0d2-f155-296cea4a6f1c
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_AdventurerLeader_State_AngryAtPlayer(1) = True
#. TagRule: DRAGONBORN
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:65fae302-409c-f0d2-f155-296cea4a6f1c
msgctxt "h1c1ca57dgea05g4778g842eg53aad6046acf"
msgid "Outta my face, lizard."
msgstr "면상 저리 치워, 도마뱀."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = 65fae302-409c-f0d2-f155-296cea4a6f1c
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_AdventurerLeader_State_AngryAtPlayer(1) = True
#. TagRule: BESTIAL and GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:65fae302-409c-f0d2-f155-296cea4a6f1c
msgctxt "h5aac8c1ag4532g40c5g99c4g99643fb5b281"
msgid "Outta my face, ugly."
msgstr "면상 저리 치워, 못난아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = 65fae302-409c-f0d2-f155-296cea4a6f1c
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_AdventurerLeader_State_AngryAtPlayer(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:65fae302-409c-f0d2-f155-296cea4a6f1c
msgctxt "he893ec21g86ccg407ega7f6g9b0b54a5195a"
msgid "Outta my face."
msgstr "면상 저리 치워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = 66e4574d-5c8c-4000-7fcd-79161571715d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - GLO_Tadpole_SUB_Druid.LearnedKilledOrCaptured(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:66e4574d-5c8c-4000-7fcd-79161571715d
msgctxt "h0e89080dg3a94g4346g9782g508fbc9f88ea"
msgid ""
"When the goblins jumped us, most of my crew scarpered, just like I taught "
"'em to. The old codger didn't."
msgstr "고블린들이 습격했을 때, 내 동료 대부분은 달아났지. 내가 가르친 대로 말이야. 그 늙은이는 그러지 않더군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = 6981f825-22f0-c454-9af9-a1fb90d36cde
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_AdventurersQuest_Knows_AradinStory = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:6981f825-22f0-c454-9af9-a1fb90d36cde
msgctxt "hf510921eg8b03g44f4gad3fg3a28674fa026"
msgid ""
"Now I'm gonna take the blame for leading the goblins here, <i>and</i> losing "
"track of the bloody druid."
msgstr "이제 난 고블린을 여기로 몰고 왔단 걸로 욕먹어야 하는 신세야. 그놈의 드루이드 잃어버린 것도 포함해서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = 6c168ffa-d00e-717c-888f-d30f48186a68
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:6c168ffa-d00e-717c-888f-d30f48186a68
msgctxt "h0b98ae90g8ceag45e3ga7e9gefef0baa9768"
msgid ""
"Druids. And they ain't the friendly type. The only one of 'em worth a damn "
"was the leader, and he ain't here anymore."
msgstr "드루이드다. 외부인에 친절한 것들은 아니야. 그네들 중 그나마 괜찮은 건 지도자 뿐인데, 그 양반도 이젠 여기 없지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = 718ac9b9-77a5-a4bd-335d-6b1bd81e7520
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:718ac9b9-77a5-a4bd-335d-6b1bd81e7520
msgctxt "h0cda7e2cg81f0g4ff6gbba0ge2ff1cfc3002"
msgid "They like trees more than they like people."
msgstr "사람보다 나무를 더 좋아하는 것들이거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = 754c23b6-bdee-662b-fdb1-0c2988dab910
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_AdventurersQuest_Knows_LeaderMap = True
#.   Quest:
#.     - SHA_Nightsong.LearnedBryanMap(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:754c23b6-bdee-662b-fdb1-0c2988dab910
msgctxt "h53705b9cgedd0g47d5g9fbbg247a8cca523d"
msgid ""
"I'd give you the map and wish you a happy funeral, but my mate Brian kept "
"hold of it like his own todger. Goblins made short of the fat old chunk."
msgstr ""
"그쪽한테 지도 내주고 대충 명복이나 빌어주고 싶지만, 하필 내 친구 브라이언이 지도를 지 거시기처럼 품고 다녔거든. 그 뚱보는 고블린 "
"손에 작살났고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = 75cb658d-0f40-2ee2-0453-57bd9be0aa34
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:75cb658d-0f40-2ee2-0453-57bd9be0aa34
msgctxt "hc2418917gd6f2g40bdg8824ga3860ffe2705"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = 75f0d7bb-b015-8b7d-335e-e750300ea6ea
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: PLANAR and RARE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:75f0d7bb-b015-8b7d-335e-e750300ea6ea
msgctxt "h6d4ca921g45d7g424bg9b2bg005ef84df5c0"
msgid "I'm not local either - got a problem with that?"
msgstr "나도 여기 사람은 아닌데. 나한테도 불만 있냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = 77ab30e0-6f4e-d92d-c71b-0cce65409e7c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_WentWithAdventurers = True
#.      - GLO_AdventurersQuest_Knows_AboutBounty = True
#.   Quest:
#.      - GLO_Tadpole_SUB_Druid.LearnedLostHalsin(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:77ab30e0-6f4e-d92d-c71b-0cce65409e7c
msgctxt "ha5f11dedg37edg49f5g9cfaga8dcdc5bdfde"
msgid "I'll leave when you tell me what happened to the First Druid."
msgstr "최고 드루이드가 어떻게 된 건지 알려주면 떠나주겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = 7a3f1cb2-93e2-3cf5-ca0a-ea0477610b0f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_AdventurersQuest_Knows_AradinStory = True
#.     - GLO_Halsin_Knows_WentWithAdventurers = True
#.     - GLO_Halsin_Knows_IsMissing = True
#.   Quest:
#.     - GLO_Tadpole_SUB_Druid.LearnedLostHalsin(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:7a3f1cb2-93e2-3cf5-ca0a-ea0477610b0f
msgctxt "h44f687cag08efg4067g86f1g071bf72f8d37"
msgid ""
"Didn't work out, though. Goblins got him when we were turning tail. He's "
"either diggin' latrines or boilin' in a cookpot by now."
msgstr "근데 일이 잘 풀리지 않았지. 우리가 도망칠 때 그치는 고블린한테 잡혔어. 지금쯤 똥이나 푸고 있거나, 솥에서 요리되고 있을걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = 7ce44fc8-e758-03b4-a13d-f5791761e393
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:7ce44fc8-e758-03b4-a13d-f5791761e393
msgctxt "hffb9335ag7d9bg43a0gb5c1g3664fde4dea5"
msgid "Better than the others, but not well enough to risk my neck for him."
msgstr "딴 놈들보다야 나았지만, 목숨 걸고 도와줄 사이까지는 아니었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = 7f4a24b0-286b-291a-266b-d94bc025051e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:7f4a24b0-286b-291a-266b-d94bc025051e
msgctxt "h455f6cb2g5c56g49e3gb93ege5a285498f02"
msgid "And where exactly did you leave him?"
msgstr "그래서 정확히 어디에 그 사람을 두고 온 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = 8134af82-bba3-8138-152a-33bb06798eeb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_WentWithAdventurers = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:8134af82-bba3-8138-152a-33bb06798eeb
msgctxt "hd622341ag0883g4e42g965eg2e44091a7645"
msgid ""
"I'm more concerned about the First Druid - heard he left the grove with you?"
msgstr "난 최고 드루이드에 관한 게 더 염려되는데. 그쪽이랑 같이 숲을 나섰다면서?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = 81bd6b2b-52ea-1f66-0285-b920824bf172
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:81bd6b2b-52ea-1f66-0285-b920824bf172
msgctxt "h4847ef59g1d56g4ee7gbae5g33061366061d"
msgid "Charming. I can see why the locals like you so much."
msgstr "성격 참 끝내주네. 여기 사람들이 왜 널 그리 좋아라 하는지 알만한걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = 831a8cf8-6949-8ed3-46e4-13bb33d72fa3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:831a8cf8-6949-8ed3-46e4-13bb33d72fa3
msgctxt "h02ed4dd3gd28dg45daga209gd2082a7551bb"
msgid "Just trying to get the lay of the land."
msgstr "그냥 어떤 상황인지 파악하려는 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = 83b2f4fc-a293-4c44-4196-6a16128b866b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:83b2f4fc-a293-4c44-4196-6a16128b866b
msgctxt "hd09ab63egaa9ag4032g9daeg92cf73bdf11b"
msgid "All right. I'll leave you to your drinking."
msgstr "좋아. 계속 술 마실 수 있게 이만 떠나주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = 84bca94b-f5bf-045f-e89c-c6e5ceb1afdf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:84bca94b-f5bf-045f-e89c-c6e5ceb1afdf
msgctxt "h1342ae72g9ef3g428fg8551g398f9589d9ef"
msgid "Just tell me where to find the relic."
msgstr "그냥 어디서 그 유물을 찾을 수 있는지나 알려줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = 866ea7fe-9ce1-31b0-61eb-b32e4a2b706e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TIEFLING(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:866ea7fe-9ce1-31b0-61eb-b32e4a2b706e
msgctxt "hf9dfcdd1g357ag4ca5g9cf8g45edb68d4b63"
msgid "Devils? Seriously? They're tieflings. Same as me."
msgstr "데빌이라니? 진담이냐? 저들은 티플링이야. 나도 그렇고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = 8a214958-759d-17b0-abd8-be27fb5854f6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:8a214958-759d-17b0-abd8-be27fb5854f6
msgctxt "h26ef5191g2427g4cecgb00cg90696cf61c8f"
msgid ""
"What do you want, anyway? I ain't local. I know - knew - the fella in "
"charge, but barely said two words to the devils swarming his place."
msgstr ""
"그래서 볼일이 뭐야? 난 이 지역 놈도 아닌데. 난 책임자랑 아는 사이일... 였을 뿐이지, 여기 들끓는 데빌들하곤 몇 마디 이상 섞어본 "
"적도 없다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = 8ec18171-4451-673c-a614-c22bfa2ad63e
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:8ec18171-4451-673c-a614-c22bfa2ad63e
msgctxt "h69d53876gbbe8g490cga2e2g6f6e24a8d8dc"
msgid "You should drink to celebrate victory, not to forget your defeats."
msgstr "술은 승리를 축하할 때 마시는 거야. 패배를 잊기 위해서가 아니라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = 8f3db78e-d221-fd44-2780-f2589a59181e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:8f3db78e-d221-fd44-2780-f2589a59181e
msgctxt "h4886855dg4d70g4f68ga837g722becf3d889"
msgid "You got along with their leader, though?"
msgstr "그래도 그들 지도자랑은 사이가 괜찮았나 보지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = 8f92c2be-c86a-57c0-736d-6a235e45b9a9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AdventurersQuest_Knows_AradinStory = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:8f92c2be-c86a-57c0-736d-6a235e45b9a9
msgctxt "hcc34a0c1g3aa8g4db6gb928g1dc1a74406af"
msgid "Suit yourself."
msgstr "마음대로 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = 9acd80a0-08d5-1576-352d-1b4830d0ce20
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_AdventurerLeader_State_Neutral(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:9acd80a0-08d5-1576-352d-1b4830d0ce20
msgctxt "h3a191b61g496bg4964g9c7bg7b4f38063780"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = 9bd93b1b-da07-a669-117e-d4bebc5fcb1e
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_DRAGONBORN
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:9bd93b1b-da07-a669-117e-d4bebc5fcb1e
msgctxt "h6041d8e8g47c4g493agbef9g2d2f399fac59"
msgid "Show some respect - I helped at the gates."
msgstr "존중 좀 보이시지. 관문에서 나한테 도움받았잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = 9bd93b1b-da07-a669-117e-d4bebc5fcb1e
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:9bd93b1b-da07-a669-117e-d4bebc5fcb1e
msgctxt "h57296794g94f2g4736gb8a5gec77b60eee42"
msgid "Feck off yourself - I saved your skin back at the gates."
msgstr "너나 꺼지시지. 관문에서 내 덕에 목숨 건진 주제에."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = 9ded84ac-63b3-53d3-0bf7-ebbd0ae29e87
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:9ded84ac-63b3-53d3-0bf7-ebbd0ae29e87
msgctxt "h30c32516g5de4g4832gb1c0ge827360d4814"
msgid ""
"Yes - it's where I got my good looks. Did you come from a gelatinous ooze?"
msgstr "그래. 내 잘생긴 외모의 근원이지. 그러는 네 조상은 젤리덩어리 우즈냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = a1234c2a-f7ab-f903-11e4-1da254842706
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:a1234c2a-f7ab-f903-11e4-1da254842706
msgctxt "h272bba18g8dcdg44a4g93f1g4f42a64cd2df"
msgid "Thanks."
msgstr "고마워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = a3ff23f0-cb1f-1e47-a072-3e4dfacec0d4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_AdventurersQuest_Knows_AboutSH = True
#.     - GLO_AdventurersQuest_Knows_AboutBounty = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:a3ff23f0-cb1f-1e47-a072-3e4dfacec0d4
msgctxt "hd310b307g01f9g46eegbb4egf3f62e247285"
msgid ""
"And from a wizard, too. I shoulda known. The gold probably turns to lead the "
"moment you leave Baldur's Gate."
msgstr "거기다 위저드의 돈이라니. 그걸 왜 믿었을까. 받아봤자 발더스 게이트 뜨는 순간 납덩이로 바뀌는 장난질을 해놨을 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = a686a083-7a12-cb3a-f5fc-6cbcbe0a20e0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_AdventurerLeader_State_AngryAtPlayer(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:a686a083-7a12-cb3a-f5fc-6cbcbe0a20e0
msgctxt "hac218bc5ge42dg4214g9cfag07a0533d6a47"
msgid ""
"If you want to play the hero, go ask the goblins nicely, and maybe they'll "
"give you whatever's left of him."
msgstr "영웅 놀이 하고 싶다면, 고블린들 찾아가 정중히 부탁해 보셔. 그럼 먹다 남은 일부라도 넘겨줄지도 모를걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = a85dca20-7523-32f6-1e63-45b29d73b089
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:a85dca20-7523-32f6-1e63-45b29d73b089
msgctxt "hbf24a73cg60dbg410cg93b4ga43469a21a70"
msgid "Do you have any idea where Halsin went?"
msgstr "할신이 어디 있을지 뭐라도 짚이는 건 없어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = ab9d70bb-a455-0080-9f72-76ac733a10e8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AdventurersQuest_Knows_AradinStory = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:ab9d70bb-a455-0080-9f72-76ac733a10e8
msgctxt "h789f65a3g939dg4b61g8be1gcbe71d3e2057"
msgid "Not the best place for drinking. How'd you end up here?"
msgstr "술 마시기엔 딱히 좋은 데는 아닌데. 여긴 어쩌다가 오게 된 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = ac8a364d-3815-e308-d7f6-4b0a3eab1d0e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:ac8a364d-3815-e308-d7f6-4b0a3eab1d0e
msgctxt "hdb036ef2g6d12g403ag9022g0bc93fcb2faf"
msgid "What's it to you?"
msgstr "알아서 뭐 하게?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = ace226b6-31ea-01a3-1990-c1b8dda34828
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:ace226b6-31ea-01a3-1990-c1b8dda34828
msgctxt "h0d5eca2fga43fg424ag8d5egdb475fcda179"
msgid "If I knew that, I wouldn't be back <i>here </i>with half my crew gone."
msgstr "그걸 알았다면, 내 동료 절반 날려먹은 채 <i>이딴 데</i> 돌아왔겠냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = b0199905-6dbc-0982-c67e-efe9b3892eff
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_WentWithAdventurers = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:b0199905-6dbc-0982-c67e-efe9b3892eff
msgctxt "h34034368g6db5g4830g8c05g15d5b36afca2"
msgid "I heard you might know where he is."
msgstr "그 책임자가 어디 있는지 댁이 알 거라고 들었는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = b1378f8d-9d2d-2119-c303-2b29d122a3b9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:b1378f8d-9d2d-2119-c303-2b29d122a3b9
msgctxt "h380928d1g5a1eg401ag9f2eg770890ecd9cd"
msgid "You fought well, too."
msgstr "너도 잘 싸우던데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = b146fef5-1603-6742-cf16-af64f2692a88
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Knows_HeardAboutNettie_PartialInfo = True
#.   Quest:
#.     - GLO_Tadpole_SUB_Apprentice.LearnedNettieNearby_NoName(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:b146fef5-1603-6742-cf16-af64f2692a88
msgctxt "h5958c44eg41bbg4a9dgaf77g4115aa55df70"
msgid ""
"Think he's got an apprentice running around somewheres though. Nadine? "
"Natalie? Something like that."
msgstr "그 양반 제자가 여기 어딘가에 있다고 들은 거 같긴 한데. 나딘? 나탈리? 뭐, 그런 이름이었지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = b38b5016-4b20-064d-d740-2f42a96a1197
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:b38b5016-4b20-064d-d740-2f42a96a1197
msgctxt "h1d95e537g9229g47ffg8c5eg4a2ab443bd4a"
msgid ""
"Didn't ask for your help. You can keep your honour and stick it somewhere "
"else."
msgstr "누가 도와달라고 했냐? 그 잘난 명예는 너나 잘 지키고 딴 데 가서 찾아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = bc45b48a-a553-3209-2b34-25dd6e9ac0c3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:bc45b48a-a553-3209-2b34-25dd6e9ac0c3
msgctxt "hee5f2107g7ae2g4777ga452g813ef2f2b1ee"
msgid "Can I have a look at that contract?"
msgstr "네가 가진 의뢰서를 내가 좀 봐도 될까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = bc793f28-8d66-3af6-71b4-09f2c80ca5a2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:bc793f28-8d66-3af6-71b4-09f2c80ca5a2
msgctxt "h351d68b0g024cg4c33g8e03gaa2361ace91f"
msgid "What makes you say they're not friendly?"
msgstr "뭐 때문에 친절하지 않다고 얘기하는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = bd378411-ba5c-ff1a-4348-6ad31d05e967
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_AdventurersQuest_State_HasContract(0) = True
#. SetFlags:
#.   Object:
#.     - DEN_AdventurersQuest_Event_GiveContract(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:bd378411-ba5c-ff1a-4348-6ad31d05e967
msgctxt "h2fd0cadcg3731g41adga06fgfbbbe91cf95b"
msgid ""
"All I've got's the contract. It'll show you where we turned back, if you "
"feel like dying."
msgstr "내가 가진 건 의뢰서뿐이야. 우리가 물러난 곳 위치가 적혀있지. 명줄 안 아깝다면 한번 가 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = bd6b39b4-b817-80d3-2dcc-f0e096267cad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:bd6b39b4-b817-80d3-2dcc-f0e096267cad
msgctxt "h565965d1g12d0g461fgae54gf479837f15d4"
msgid "Halsin. He's the leader around these parts. Or was."
msgstr "할신이다. 이 동네의 지도자야. 아니, 지도자였지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = bd870d85-4e72-2c4f-ec2c-7ae56d7bbad6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - SHA_Nightsong.LearnedLocation(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:bd870d85-4e72-2c4f-ec2c-7ae56d7bbad6
msgctxt "ha491ec49g4e47g4e6bg8a50g1f0de12cd856"
msgid ""
"Gobbos are holed up in the temple ruins out west of here - last I saw "
"Halsin, he was right in the thick of 'em."
msgstr "여기서 서쪽으로 가면 고보들이 짱박힌 신전 폐허가 있어. 마지막으로 할신을 봤을 땐, 놈들에게 둘러싸여 있었지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = c8faa65a-e95b-9e53-73f6-a7d1ecb04bd8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AdventurersQuest_HasMet_ALeader(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:c8faa65a-e95b-9e53-73f6-a7d1ecb04bd8
msgctxt "h7dc5347ag5e66g4307g87d2g64218d7a82bf"
msgid "If it ain't the fearless goblin-slayer."
msgstr "이거, 그 용감무쌍한 고블린 슬레이어 아니신가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = cabc79c9-c200-b603-a793-b5e496b69717
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:cabc79c9-c200-b603-a793-b5e496b69717
msgctxt "h046717e5gb7a5g43adgbf10g075b37a3b560"
msgid "How'd you end up here in the first place?"
msgstr "애초에 이 동네엔 어쩌다 오게 된 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = cf7e9e2e-6be7-b0ee-ac4a-6903a0911ce3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:cf7e9e2e-6be7-b0ee-ac4a-6903a0911ce3
msgctxt "h32f56e3eg175fg45d0gabd1gca3cbbe39762"
msgid "What? You lot <i>come </i>from devils, don't you?"
msgstr "근데? 아무튼 데빌들 <i>씨앗</i>이긴 하잖아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = d0b615d9-c058-a805-dbce-2867f1a527ca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:d0b615d9-c058-a805-dbce-2867f1a527ca
msgctxt "h0efab816g76b6g4f3cga99ag3f7dee00a981"
msgid "Talking about your troubles might help."
msgstr "고민을 털어놓으면 네 속이 편해질지도 모르지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = d2c5489e-aaa4-4e45-36d4-3a0724931721
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:d2c5489e-aaa4-4e45-36d4-3a0724931721
msgctxt "h35963d7fg9736g462cga434g175b82a19f78"
msgid ""
"I think they like you less than they like me. It's almost impressive, how "
"detestable you are."
msgstr "어째 사람들이 나보다도 너를 질색해 할 것 같군. 감탄스러울 지경이야. 이렇게까지 혐오스럽게 굴 수 있다니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = d4a6f58c-2e05-7d2e-2e45-773a572fc26e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_AdventurersQuest_Knows_AboutSH = True
#.     - GLO_AdventurersQuest_Knows_AboutBounty = True
#.   Quest:
#.     - SHA_Nightsong.HeardOf(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:d4a6f58c-2e05-7d2e-2e45-773a572fc26e
msgctxt "h5a9a91efgbae1g402dga974ga9ef6693bab9"
msgid ""
"There's a wizard in Baldur's Gate that'll pay gobloads for a relic, "
"supposedly buried round these parts."
msgstr "발더스 게이트에 어떤 위저드가 있는데, 이 근방에 묻힌 걸로 추정되는 웬 유물을 찾아오면 거금을 지불하겠다 했지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = d7173c85-c92c-0ca1-df86-b1706f6f30a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:d7173c85-c92c-0ca1-df86-b1706f6f30a4
msgctxt "ha8c1e557g7b10g497egabbbg60b7747b6075"
msgid "I ain't toasting to nothing. Half my people are captured or dead."
msgstr "축하 따위 할 기분 아니야. 내 일행 중 절반은 붙잡히거나 뒈졌다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = da97c214-063f-24c5-a0f7-18f8ca478de1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:da97c214-063f-24c5-a0f7-18f8ca478de1
msgctxt "h4c38ab02g6e49g4130g95f9g46817a55e50f"
msgid ""
"You sure you want to be seen with me? I ain't exactly popular with this lot."
msgstr "나랑 같이 있는 거 보여도 괜찮겠어? 난 여기 녀석들한테 단단히 찍힌 몸이라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = de8562fb-d9f2-a0dd-8d45-6ca3fda0cb33
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:de8562fb-d9f2-a0dd-8d45-6ca3fda0cb33
msgctxt "hdf80974cg61c2g422ag856fg57fbc3a93d2e"
msgid "You ran away from a few goblins?"
msgstr "고작 고블린 몇 놈 상대로 꽁무니를 뺀 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = e07efc39-b4fc-dc53-2da1-4b4801dfd68d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:e07efc39-b4fc-dc53-2da1-4b4801dfd68d
msgctxt "h7d8e5771g2df7g44c0ga149g5e75a79a9c40"
msgid "Stupid thing to die for..."
msgstr "그런 데 목숨 걸다니 미련했지..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = e0c0c224-4776-cd47-3a86-5584d0c029af
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:e0c0c224-4776-cd47-3a86-5584d0c029af
msgctxt "h31be2e35gf450g472eg99eag711038e8627f"
msgid "What are you doing round these parts?"
msgstr "너희는 무슨 일로 이 지역에 온 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = e31e018c-a17d-61b4-9ecd-e808a6605c64
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:e31e018c-a17d-61b4-9ecd-e808a6605c64
msgctxt "h4d85e25dg762ag47fdgad33g61ac28f72ab6"
msgid "Do you have any idea where he is?"
msgstr "그 양반이 어디 있을지 짚이는 거 있어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = e38bf826-5bb5-964b-f0e9-820ac249d2ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:e38bf826-5bb5-964b-f0e9-820ac249d2ae
msgctxt "h38e0f308gb160g4da1g9803g276f49b6ed1e"
msgid "All I need's a way out of this hellhole."
msgstr "내게 필요한 건 이 썩을 곳을 벗어날 방법 뿐이라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = e683c4f3-0309-5bf5-1b5d-a6c7c9427370
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:e683c4f3-0309-5bf5-1b5d-a6c7c9427370
msgctxt "h665b4150gf846g4ac8gbb0dgf9b87ff827cb"
msgid "You were more fun when you were running from goblins."
msgstr "고블린한테서 튀던 모습이 지금 네 꼬락서니보단 더 볼 만했던 거 같네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = e6a76dee-6ebf-a1cb-21c6-1088ef29ca05
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:e6a76dee-6ebf-a1cb-21c6-1088ef29ca05
msgctxt "h28a94b5eg66c8g49c2ga251g9934884bdec6"
msgid "First, I lost half my crew in some godforsaken temple."
msgstr "일단 첫째로, 그 빌어처먹을 신전에서 내 동료 절반을 잃었지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = e90a5e6b-5244-f383-3bd9-a229f7eb4e4e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:e90a5e6b-5244-f383-3bd9-a229f7eb4e4e
msgctxt "h1da32913gf603g4846gb706ge4e35a5f634a"
msgid "Any idea what the relic actually is?"
msgstr "그 유물의 정체가 뭔지 아는 건 없어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = eb3c28fe-de35-e356-bb17-3bc98890f72b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:eb3c28fe-de35-e356-bb17-3bc98890f72b
msgctxt "h2ada48cdgf6e5g4e42gab3cg0273a9410fcb"
msgid "Did you think getting rich would be easy?"
msgstr "부자가 되는 게 쉬울 줄 알았어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = ec714be2-1fd1-6d42-490d-20f52dba2f5b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:ec714be2-1fd1-6d42-490d-20f52dba2f5b
msgctxt "h4290849egf0e3g49dbgab54ga6490570aade"
msgid "You could try to be a little friendlier."
msgstr "태도를 좀 더 친절하게 고쳐보지 그래."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = edacd86b-363f-2a03-0668-850a8574d190
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:edacd86b-363f-2a03-0668-850a8574d190
msgctxt "h151de754g0dcbg4948g8ed5gd5ecc26d699f"
msgid ""
"Dunno what I expected. That much gold for some long-lost relic. "
"([GEN_CheckMagicPocketGold_6057ad05-9492-4630-9f0a-be548b134c54])"
msgstr ""
"나도 뭔 생각이었는지 모르겠다. 고릿적 유물에 그런 거금 건 것부터 말이 안 됐어. "
"([GEN_CheckMagicPocketGold_6057ad05-9492-4630-9f0a-be548b134c54])"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = eed73cb3-2954-abcb-8888-b5b7bd2b6e3b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_AdventurerLeader_State_Neutral(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:eed73cb3-2954-abcb-8888-b5b7bd2b6e3b
msgctxt "h13644fbeg8f82g4fcbg8a05g19708189df12"
msgid "Nothing to see here, mate."
msgstr "여긴 너 볼 거리 없어, 친구."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = f4db4d69-e2fb-71ea-e448-1f22c6d93f7e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:f4db4d69-e2fb-71ea-e448-1f22c6d93f7e
msgctxt "h4227d666g55f3g4f9dg9aabgd14a6925dfaf"
msgid ""
"We was looking for a relic. Had a contract to find it, and the fella who "
"runs this place came along on the job with us."
msgstr "우리 목적은 웬 유물을 찾는 거였어. 그게 의뢰 내용이었지. 거기에 이곳 책임자 양반이 자기도 끼겠다고 따라 나서더라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = f9a8ea4e-7f94-7b4c-4f5f-367fd7fc1495
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:f9a8ea4e-7f94-7b4c-4f5f-367fd7fc1495
msgctxt "hc9050479gc152g4d60g998aga5c7ac5f3db5"
msgid "All you did was stand up for your crew. I respect that."
msgstr "넌 동료들을 위해 나선 것뿐이지. 그 점은 존중해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = f9da5c35-cc29-f0aa-11a2-f70dae21408e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:f9da5c35-cc29-f0aa-11a2-f70dae21408e
msgctxt "h9d580ee7g331eg49e3g9324g9533a4b485bc"
msgid "What happened to their leader?"
msgstr "그 지도자란 사람한테 뭔 일이 생긴 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Player
#. NodeID = fc08359b-0898-2a1a-e047-ada84d867675
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:fc08359b-0898-2a1a-e047-ada84d867675
msgctxt "h9b1823b5g5795g47e4ga002gdb41b3221cf4"
msgid "Bet I could find something nasty in your family tree, too."
msgstr "그러는 너도 네 가족 족보 털어보면 아주 깨끗하진 않을걸?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = fd6c0077-3afc-0491-c833-ab762404a990
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:fd6c0077-3afc-0491-c833-ab762404a990
msgctxt "hed8b98f0ge285g4b02g9714gf0eafa865e45"
msgid "Thanks, <i>mum</i>. Now please do feck off."
msgstr "늬예, <i>엄마</i>. 이제 부탁인데 좀 꺼져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = feb7ce6c-908c-58f3-6feb-9132b2fc6847
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_AdventurerLeader_State_AngryAtPlayer(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:feb7ce6c-908c-58f3-6feb-9132b2fc6847
msgctxt "hfacc2698gc574g4162gbaaagc760519fa49e"
msgid "Oh, feck off."
msgstr "오, 꺼져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader
#. Speaker = Aradin
#. NodeID = ff2e6bde-f1a5-6284-0fbd-2a148296cd55
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurerLeader:ff2e6bde-f1a5-6284-0fbd-2a148296cd55
msgctxt "he6e0206bg9050g4fadg8aaagc0c80ef4aeaf"
msgid "But gold ain't any use if you're too cold to spend it."
msgstr "하지만 뒈지고 나면 황금이 무슨 소용이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_AdventurerCleaningWound
#. Speaker = Remira
#. NodeID = 0f5c201b-eab2-d09c-f4f4-e42241ff2c1e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_AdventurersQuest_State_CleanedWound(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_AdventurerCleaningWound:0f5c201b-eab2-d09c-f4f4-e42241ff2c1e
msgctxt "hd8396ec4g037bg4042gafd9g6a49cd808c27"
msgid "Wound looks clean. Small mercies."
msgstr "상처는 깨끗해 보여. 그나마 다행이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_AdventurerCleaningWound
#. Speaker = Remira
#. NodeID = 865ab55b-e1c5-54be-d80d-a60657fb0fa7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 32baa075-7c99-da85-daeb-8158ba286852_Flow1 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_AdventurerCleaningWound:865ab55b-e1c5-54be-d80d-a60657fb0fa7
msgctxt "hfa19a7c0g2e94g4a8cg9465g6f0cc89524cf"
msgid "Nnggh! Hells."
msgstr "으으! 제기랄."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_AdventurerCleaningWound
#. Speaker = Remira
#. NodeID = ee1b8050-9f6d-4848-1325-df251bd1c46a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 32baa075-7c99-da85-daeb-8158ba286852_Flow2 = True
#. SetFlags:
#.   Local:
#.     - 32baa075-7c99-da85-daeb-8158ba286852_Flow1 = True
#.     - 32baa075-7c99-da85-daeb-8158ba286852_Flow2 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_AdventurerCleaningWound:ee1b8050-9f6d-4848-1325-df251bd1c46a
msgctxt "h06b482c6g7d21g4c47g86a5gcea36db4ff44"
msgid "Hope the goblins aren't smart enough to poison their blades..."
msgstr "고블린 놈들이 칼날에 독 바르는 잔머리 안 부려놨으면 좋겠네..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_AdventurerCleaningWound
#. Speaker = Remira
#. NodeID = ff0c477f-328c-7a75-4b5a-5ff4bd51b397
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 32baa075-7c99-da85-daeb-8158ba286852_Flow1 = True
#. SetFlags:
#.   Local:
#.     - 32baa075-7c99-da85-daeb-8158ba286852_Flow2 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_AdventurerCleaningWound:ff0c477f-328c-7a75-4b5a-5ff4bd51b397
msgctxt "hdc408f1fg9bd1g436fgaaa2g401efb91f580"
msgid "Agh... this'll leave a mark. Bloody goblins."
msgstr "아으…이거 흉터 남겠는걸. 망할 고블린 새끼들."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_AradinAndRemira
#. Speaker = Aradin
#. NodeID = 1ea0f1d1-c714-e3c2-e804-93787a16f44e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_AradinAndRemira:1ea0f1d1-c714-e3c2-e804-93787a16f44e
msgctxt "h105db0f9g8a88g4d91gbd4bgcf71d5a62291"
msgid "Everyone needs to cut their teeth sometime."
msgstr "경험을 쌓으려면 어쩔 수 없는 거라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_AradinAndRemira
#. Speaker = Remira
#. NodeID = 214a7204-a1c0-56eb-5ac7-b0ec40848ba8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 7619c224-45e6-1164-76c3-4530cc109664_Flow1 = True
#. SetFlags:
#.   Local:
#.     - 7619c224-45e6-1164-76c3-4530cc109664_Flow2 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_AradinAndRemira:214a7204-a1c0-56eb-5ac7-b0ec40848ba8
msgctxt "h02801b1ag8ba8g45abgbb5dg9bce1455e89f"
msgid "You shouldn't have brought Liam along. Lad was too young."
msgstr "넌 리암을 끼우지 말았어야 했어. 걔는 너무 어렸다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_AradinAndRemira
#. Speaker = Remira
#. NodeID = 3db42d2e-d5c5-c3f8-9544-8a86e68227a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_AradinAndRemira:3db42d2e-d5c5-c3f8-9544-8a86e68227a5
msgctxt "h592536b8g2a4cg4ea4g8782g4d696a35daf9"
msgid "... how?"
msgstr "…뭔 다행?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_AradinAndRemira
#. Speaker = Remira
#. NodeID = 441188b3-5d04-05a5-31fa-47e93cb0e347
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_AradinAndRemira:441188b3-5d04-05a5-31fa-47e93cb0e347
msgctxt "hb24a04f4gbf99g4191g9348g8bd3a40babfd"
msgid "Not the worst plan you've had lately."
msgstr "최근 네 계획 중엔 그나마 낫네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_AradinAndRemira
#. Speaker = Remira
#. NodeID = 7921ea28-c255-755e-148a-ecf095cd7b4d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 7619c224-45e6-1164-76c3-4530cc109664_Flow2 = True
#. SetFlags:
#.   Local:
#.     - 7619c224-45e6-1164-76c3-4530cc109664_Flow2 = False
#.     - 7619c224-45e6-1164-76c3-4530cc109664_Flow1 = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_AradinAndRemira:7921ea28-c255-755e-148a-ecf095cd7b4d
msgctxt "he78deab4g682fg4704gafa2g7a80bff048ad"
msgid "What comes next?"
msgstr "이제 어쩔 생각이야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_AradinAndRemira
#. Speaker = Aradin
#. NodeID = b7ae87b4-4f3c-753c-d8df-827f1de366a5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 7619c224-45e6-1164-76c3-4530cc109664_Flow1 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_AradinAndRemira:b7ae87b4-4f3c-753c-d8df-827f1de366a5
msgctxt "ha2b046ddg239fg4d3dg985ag79ed267df508"
msgid "It could be worse."
msgstr "이만하면 다행이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_AradinAndRemira
#. Speaker = Remira
#. NodeID = cde18748-fe27-39d3-79b3-bb2b97b934e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_AradinAndRemira:cde18748-fe27-39d3-79b3-bb2b97b934e7
msgctxt "h8200fa97g0290g4f8fga4fdgd3743855f002"
msgid "Cut his teeth?! For his sake, I hope he's dead already."
msgstr "경험이라고?! 차라리 걔가 별 경험 없이 얼른 죽었길 빈다야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_AradinAndRemira
#. Speaker = Aradin
#. NodeID = df25332e-c0e9-c38e-e1e0-4d626c5f8aaf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_AradinAndRemira:df25332e-c0e9-c38e-e1e0-4d626c5f8aaf
msgctxt "h79c786a0g6c75g4c6bg8d86ga43fda54a04c"
msgid "Coulda been <i>us </i>they caught."
msgstr "붙잡힌 게 <i>우리</i>였을 수도 있잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_AradinAndRemira
#. Speaker = Aradin
#. NodeID = e9fba4a4-a3a2-b691-341b-09d2f44d04c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_AradinAndRemira:e9fba4a4-a3a2-b691-341b-09d2f44d04c4
msgctxt "h031dcbdeg64a8g4c28gbab5ga0c54fa59a2c"
msgid "We finish this bottle. Got enough dead to toast, anyway."
msgstr "이 병이나 싹 비워야지. 추모주 바칠 죽은 애들도 넘쳐나는걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_AtCorpses
#. Speaker = Aradin
#. NodeID = 97ae6a08-f288-c6ec-69aa-9dec88e69b0a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_AtCorpses:97ae6a08-f288-c6ec-69aa-9dec88e69b0a
msgctxt "h4a6ebbc0gaa37g47a5gb5dfgd81145d5d8e5"
msgid "Lucky you. Done with this shite."
msgstr "잘 해 보라고. 난 이 좆같은 거 관두련다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_DrunkenTalk
#. Speaker = Aradin
#. NodeID = db0a75ed-a3eb-c009-f958-e0ed78acecea
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 562f688e-5182-6fd2-ec72-28b3adf5f76e_Flow2 = True
#. SetFlags:
#.   Local:
#.     - 562f688e-5182-6fd2-ec72-28b3adf5f76e_Flow1 = False
#.     - 562f688e-5182-6fd2-ec72-28b3adf5f76e_Flow2 = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_DrunkenTalk:db0a75ed-a3eb-c009-f958-e0ed78acecea
msgctxt "h9135017egd37ag45b2g8f8ag9be5266c041e"
msgid "'Easy money.' Yeah right."
msgstr "'쉬운 돈벌이'라니. 퍽이나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_DrunkenTalk
#. Speaker = Aradin
#. NodeID = f18831c9-4b94-ade3-4fae-d446375b80a8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 562f688e-5182-6fd2-ec72-28b3adf5f76e_Flow1 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_DrunkenTalk:f18831c9-4b94-ade3-4fae-d446375b80a8
msgctxt "h0a1475e0g83e7g4085g8eadgb044e342be27"
msgid "Ain't leavin' town for a good while after this."
msgstr "이 일 지나면 당분간 동네에서 안 나갈 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_DrunkenTalk
#. Speaker = Aradin
#. NodeID = f71d529b-f9f6-1aba-3431-32a504f135fc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 562f688e-5182-6fd2-ec72-28b3adf5f76e_Flow1 = True
#. SetFlags:
#.   Local:
#.     - 562f688e-5182-6fd2-ec72-28b3adf5f76e_Flow2 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_DrunkenTalk:f71d529b-f9f6-1aba-3431-32a504f135fc
msgctxt "hf5923be0gff25g4b4fg8873g3e1edbbb5090"
msgid "Can't wait to get back to the Gate."
msgstr "얼른 게이트로 돌아가면 좋겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_LeavingCorpses
#. Speaker = Aradin
#. NodeID = 79003993-2a1d-4386-ba3e-13b0a9632063
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_LeavingCorpses:79003993-2a1d-4386-ba3e-13b0a9632063
msgctxt "h9e934363g5e98g456bga3a5g1bb7a42de9e0"
msgid "Come on. We're wasting time."
msgstr "가자. 이건 시간 낭비야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_RemiraBarthAtCorpses
#. Speaker = Barth
#. NodeID = 14d6a7c4-6ab0-3fb6-a764-a969229e061e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_RemiraBarthAtCorpses:14d6a7c4-6ab0-3fb6-a764-a969229e061e
msgctxt "h9b00d03egc224g490fg950ege8c189324ec9"
msgid "Give it a rest. We have time."
msgstr "그냥 좀 쉬어. 아직 시간 있다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_RemiraBarthAtCorpses
#. Speaker = Remira
#. NodeID = 30610424-e82f-fa58-0a11-fdb26d776cd8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 10b01636-f73f-e7be-5f2e-5be653ae67a8_A = True
#. SetFlags:
#.   Local:
#.     - 10b01636-f73f-e7be-5f2e-5be653ae67a8_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_RemiraBarthAtCorpses:30610424-e82f-fa58-0a11-fdb26d776cd8
msgctxt "h268c01a1g6bd1g4bc8gaaa1gcc1bb25a811d"
msgid "Liam isn't here..."
msgstr "리암은 못 왔군…"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_RemiraBarthAtCorpses
#. Speaker = Remira
#. NodeID = 33ef6b86-7a1c-c2a0-a35b-b311c50c867f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_RemiraBarthAtCorpses:33ef6b86-7a1c-c2a0-a35b-b311c50c867f
msgctxt "ha25e162bgb245g4457gb82bg8e3a1297661d"
msgid "Maybe <i>you </i>do."
msgstr "<i>너나</i> 그렇겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_RemiraBarthAtCorpses
#. Speaker = Remira
#. NodeID = 5d441d7f-e012-1508-13c4-d8f432592838
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_RemiraBarthAtCorpses:5d441d7f-e012-1508-13c4-d8f432592838
msgctxt "hcb6e8054geb49g45c1ga12bge4bd51774049"
msgid "You don't gotta remind me."
msgstr "상기시키지 않아도 된다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_RemiraBarthAtCorpses
#. Speaker = Barth
#. NodeID = 8d8f57c9-967e-736c-b492-e74950cf8f94
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_RemiraBarthAtCorpses:8d8f57c9-967e-736c-b492-e74950cf8f94
msgctxt "hc27c3bcfgd295g452ag8910g36f0b25c5d47"
msgid "He didn't make it this far. You <i>saw </i>them grab him."
msgstr "이쯤 됐음 글러먹은 거지. 놈들이 붙잡는 거 <i>봤잖아</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_RemiraBarthAtCorpses
#. Speaker = Remira
#. NodeID = a9592b12-c469-300d-4814-70b96eea9aa6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 10b01636-f73f-e7be-5f2e-5be653ae67a8_B = True
#. SetFlags:
#.   Local:
#.     - 10b01636-f73f-e7be-5f2e-5be653ae67a8_A = False
#.     - 10b01636-f73f-e7be-5f2e-5be653ae67a8_B = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_RemiraBarthAtCorpses:a9592b12-c469-300d-4814-70b96eea9aa6
msgctxt "h8fe2d0afgfd47g4eccgb54cg25c906eb158e"
msgid "We shouldn't be hanging around."
msgstr "이런 데서 꾸물거릴 때가 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_RemiraBarthAtCorpses
#. Speaker = Barth
#. NodeID = bc26ee2b-079a-47b3-7103-748ca10f0c9a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_RemiraBarthAtCorpses:bc26ee2b-079a-47b3-7103-748ca10f0c9a
msgctxt "hebd2d8d9g81a3g4423gaa5bg60db2c306000"
msgid "They got their fill."
msgstr "이만하면 질렸겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_RemiraBarthAtCorpses
#. Speaker = Remira
#. NodeID = d9f4def2-10e2-27cd-c66b-416c65cad0d6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 10b01636-f73f-e7be-5f2e-5be653ae67a8_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_AD_RemiraBarthAtCorpses:d9f4def2-10e2-27cd-c66b-416c65cad0d6
msgctxt "hd214cb50gfb9eg481fgabd4gec42d055a463"
msgid "Think more are coming?"
msgstr "놈들이 더 올까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = 00c745df-eb93-9de9-f74e-c5f6fc5bb59c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_AdventurersQuest_Knows_AboutSH = True
#.     - GLO_AdventurersQuest_Knows_AboutBounty = True
#.   Quest:
#.     - SHA_Nightsong.HeardOf(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:00c745df-eb93-9de9-f74e-c5f6fc5bb59c
msgctxt "h90b6c2eega7c1g4ef4gbbc3g91fbb4abd5f2"
msgid ""
"There's a wizard in Baldur's Gate that'll pay gobloads for a relic "
"supposedly buried round these parts."
msgstr "발더스 게이트에 있는 위저드가 이 근처에 묻혀있는 유물을 가져오면 엄청난 양의 금화를 지불하겠다더군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Player
#. NodeID = 02b5cc61-a892-5b74-c83c-20254403e9e8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_WentWithAdventurers = True
#.      - GLO_AdventurersQuest_Knows_AboutBounty = True
#.      - GLO_Halsin_Knows_IsMissing = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:02b5cc61-a892-5b74-c83c-20254403e9e8
msgctxt "h01ccf30fg3de5g4708g9b18g34ecf9847103"
msgid "I hear the druids' leader went with you."
msgstr "드루이드의 지도자가 당신과 함께 떠났다던데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = 060447c7-cac7-1420-e7df-85b7f42c7c7e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_AdventurersQuest_Knows_AboutSH = True
#.     - GLO_AdventurersQuest_Knows_AboutBounty = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:060447c7-cac7-1420-e7df-85b7f42c7c7e
msgctxt "h81ae396egf6e0g488bga0e9g7418033eb29a"
msgid ""
"And from a wizard too. I shoulda known. The gold probably turns to lead the "
"moment you leave Baldur's Gate."
msgstr "게다가 위저드이기도 하고 말이지. 눈치챘어야 했는데. 분명 그 금화도 발더스 게이트를 떠나자마자 납덩이로 변해버렸을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = 0d10ab5e-7855-3dfb-bf4d-3940e0ca8876
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:0d10ab5e-7855-3dfb-bf4d-3940e0ca8876
msgctxt "h294b65fbge7a3g487fg8244g415117941eb5"
msgid "Right. Yeah. I bet."
msgstr "그렇군. 그래. 그럴 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Player
#. NodeID = 0e43333c-a737-82b4-b01c-943556162412
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_AdventurersQuest_Knows_AboutSH = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:0e43333c-a737-82b4-b01c-943556162412
msgctxt "h1f663ad0g64e2g47eag891dg85b06a63415d"
msgid "This whole thing sounds like a setup."
msgstr "이 모든 것들이 사기극처럼 들리는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Player
#. NodeID = 0f429b77-d9b3-6bae-82fe-1630d5fb0e9f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC_OGHMA(1) = True
#. TagRule: CLERIC_OGHMA
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:0f429b77-d9b3-6bae-82fe-1630d5fb0e9f
msgctxt "h8ccb24f2ge14bg470bgb54fge5d9354cf14f"
msgid ""
"Whatever doubts and mysteries plagued them in life, may they be answered in "
"death."
msgstr "그들을 괴롭히던 의문과 수수께끼가 무엇이었든, 그들의 죽음 끝에서는 해답을 찾을 수 있기를."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = 121252fb-2e5e-3dfc-c6bb-be4b0814fa78
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:121252fb-2e5e-3dfc-c6bb-be4b0814fa78
msgctxt "h076cf21egbb7eg426fg92a0ge00b5b141dfe"
msgid "That's a fancy way of saying 'I had something better to do.'"
msgstr "'그것보다 더 나은 일이 있지'를 고상하게도 돌려 말하는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Player
#. NodeID = 12b3106e-5ef9-6ca8-9ce9-baad0ffcff33
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:12b3106e-5ef9-6ca8-9ce9-baad0ffcff33
msgctxt "hd3b8fbdfgdac8g495egb4bbg2fcfff11263a"
msgid ""
"An adventurer's life is often short, but full of glory. May their journey "
"onward be their next great adventure."
msgstr "모험가의 삶은 종종 짧지만, 영광으로 가득하니. 그들의 다음 여정은 위대한 모험이 되기를."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = 141b532b-dd8e-a9f0-ae06-2fcc05df9708
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:141b532b-dd8e-a9f0-ae06-2fcc05df9708
msgctxt "h1296b9ddga387g4be0g9db5g125f80cb3e0e"
msgid ""
"As soon as he heard we had a contract to find that Nightsong relic, he was "
"more eager than a hound in heat."
msgstr "우리가 그 밤의 노래란 유물을 찾는 계약을 수행하고 있다는 걸 듣자마자, 그가 발정난 사냥개 마냥 열의를 보이더군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = 143ad58a-4838-9a0d-76ed-756fb9dc63fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:143ad58a-4838-9a0d-76ed-756fb9dc63fc
msgctxt "h5d47733fg5bffg4ab4g8ca3g741f17a77504"
msgid "Yeah, and I'd do the same again. He weren't my responsibility."
msgstr "그래, 다시 그 상황이 돼도 똑같이 할 거야. 그는 내 책임이 아니었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Player
#. NodeID = 166aba96-f710-e937-2fe8-4cb0682ad176
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_RaidingParty_Event_KnockOutAdventurer = True
#.      - DEN_RaidingParty_Event_PlayerDidTheKO = True
#. TagRule: REALLY_HALFORC
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:166aba96-f710-e937-2fe8-4cb0682ad176
msgctxt "h83690481g2d34g4b23g9a54g9c18916e5f36"
msgid "That was just a friendly tap - and you had it coming."
msgstr "그건 친절히 봐준 거였어, 게다가 당신이 자초한 일이었고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Player
#. NodeID = 166aba96-f710-e937-2fe8-4cb0682ad176
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_RaidingParty_Event_KnockOutAdventurer = True
#.      - DEN_RaidingParty_Event_PlayerDidTheKO = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:166aba96-f710-e937-2fe8-4cb0682ad176
msgctxt "haa90184egdffeg4f66g9493ga9e54b5f2aa0"
msgid "Still sore about that? You had it coming."
msgstr "아직도 그것 때문에 화가 난 거야? 당신이 자초한 거라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = 1691d02f-94b8-6682-debb-5a7c78cdd672
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_AdventurersQuest_Knows_LeaderMap = True
#.   Quest:
#.     - SHA_Nightsong.LearnedBryanMap(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:1691d02f-94b8-6682-debb-5a7c78cdd672
msgctxt "h9b754153g1493g4953gade4gc5047c47ece8"
msgid ""
"I'd give you a map of the temple and wish you a happy funeral, but my mate "
"Brian kept hold of it like his own todger. Goblins made short of the fat old "
"chunk."
msgstr ""
"당신한테 신전의 지도를 넘기고 명복을 빌고 싶지만, 내 친구 브라이언이 그걸 자기 부랄 마냥 꼭 붙들고 다녔단 말이지. 고블린이 그 "
"뚱뚱한 늙은이를 죽여버렸어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = 170cbc64-0199-a2b1-78cd-2b7e20fc2b53
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:170cbc64-0199-a2b1-78cd-2b7e20fc2b53
msgctxt "h91af4478gac10g491eg9fc7g3f47cf8a486c"
msgid "Finally some sense."
msgstr "마침내 말이 통하는 사람이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = 19965739-173b-0d33-7e98-352aea101888
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:19965739-173b-0d33-7e98-352aea101888
msgctxt "h03c76a7dg9c39g4f96g9452g144c964a33b3"
msgid "Stupid thing to die for..."
msgstr "목숨을 바치기엔 멍청한 물건이지..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = 1b470933-735a-a714-50d6-8c20341cf821
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_AdventurersQuest_Event_GiveContract(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:1b470933-735a-a714-50d6-8c20341cf821
msgctxt "h769d4185g6314g470fg985agea03c6bbeb5b"
msgid "I'm just glad to be rid of the bloody thing. Happy hunting."
msgstr "그 망할 것에서 벗어나서 기쁠 뿐이야. 즐거운 사냥 시간 보내라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Player
#. NodeID = 1c5ed6ae-93fb-50dc-e530-f023ce881bbf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:1c5ed6ae-93fb-50dc-e530-f023ce881bbf
msgctxt "h12cf41c7g0144g49e6ga581g05318c45c408"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Player
#. NodeID = 274f555d-fbca-e1e1-939c-ed78081ff9e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:274f555d-fbca-e1e1-939c-ed78081ff9e7
msgctxt "hcafd1bd8gbebeg4db6gad12g8e304d6c77b4"
msgid "Stay true to your blade and you will know his name soon enough."
msgstr "그대의 검에 진실하라. 그리하면 곧 그 분의 이름을 알지니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Player
#. NodeID = 28e76584-5f16-33e9-7b4b-ff3d0c3fdad9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingLeader_Quest_GobHuntAccepted = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:28e76584-5f16-33e9-7b4b-ff3d0c3fdad9
msgctxt "h48a9f9ffg9fe6g47caga36bg3043e5bb1df9"
msgid "The goblins need to be dealt with - so I'm dealing with them."
msgstr "고블린들은 처리할 필요가 있어. 그래서 내가 그걸 하는 거고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Player
#. NodeID = 32b1c23d-8244-d35f-a674-36eb59027433
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC_SHAR(1) = True
#. TagRule: CLERIC_SHAR
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:32b1c23d-8244-d35f-a674-36eb59027433
msgctxt "h81d90b9eg4752g4abdg9a29g0b96d368886f"
msgid ""
"I commend them to the darkness. When night falls, let them be forgotten."
msgstr "어둠에 이들을 맡기노니. 밤이 찾아오면, 그들이 잊히기를."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = 340b63ee-8fb9-9413-bf9a-b4b12b6443ce
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_AdventurersQuest_Knows_AradinStory = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:340b63ee-8fb9-9413-bf9a-b4b12b6443ce
msgctxt "h727f2535gde70g4f78gac33g5bc357ce10f5"
msgid ""
"Wasn't no <i>few </i>goblins, mate. There's an entire hive of 'em. Contract "
"failed to mention that part."
msgstr "그저 고블린 <i>몇 마리가 </i>아니었다고, 친구. 놈들이 떼거리로 있었어. 계약서엔 그런 내용이 없었는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = 37dd92bd-7014-01ca-8546-eacb1cea089a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:37dd92bd-7014-01ca-8546-eacb1cea089a
msgctxt "h309f65b5gb5a7g426bg857bg8104c82f3174"
msgid "Say another word, and I'll 'cull' you before you can blink."
msgstr "한마디라도 더 하면, 네가 눈을 깜빡이기도 전에 '도태'시켜 주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = 3888a709-5051-2504-ddec-fd98e964f196
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_AdventurersQuest_KnowTheRisk(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:3888a709-5051-2504-ddec-fd98e964f196
msgctxt "hb252b159g9b1fg4786ga441gb499da7c6495"
msgid "That, or a crock of shite."
msgstr "그거거나, 똥이 가득한 항아리겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = 3b647aad-8c76-223a-180d-890826439725
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:3b647aad-8c76-223a-180d-890826439725
msgctxt "h2ce54ad4g7bd6g496cg8f4cg46e713136c7d"
msgid "Whatever you say, mate."
msgstr "알았다고, 친구."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Player
#. NodeID = 3bf1187b-6d59-8b78-d41c-e95c8775f532
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC_TYR(1) = True
#. SetFlags:
#.   Object:
#.     - DEN_AdventurersQuest_LeaderAtCorpses_TyrPrayer(1) = True
#. TagRule: CLERIC_TYR
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:3bf1187b-6d59-8b78-d41c-e95c8775f532
msgctxt "heb5a3bacg7ee6g4a3cg9ebag9beaa60afa39"
msgid ""
"Though I do not know how they lived, I know they died justly in combat. I "
"honour that death."
msgstr "그들의 삶이 어땠는지는 모르지만, 전투에서 명예롭게 죽었다는 사실은 알지. 그 죽음에 경의를 표하겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Player
#. NodeID = 3f1095fd-7c6c-e851-6d3c-2b410f23aea3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AdventurersQuest_Knows_LeaderMap = False
#.   Quest:
#.      - SHA_Nightsong.LearnedBryanMap(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:3f1095fd-7c6c-e851-6d3c-2b410f23aea3
msgctxt "hf6bdd535ge9f9g410fg9820g95b0ae3541a3"
msgid "Where exactly did you get jumped?"
msgstr "당신네가 습격당한 곳이 정확히 어디지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Player
#. NodeID = 3f2d75e0-2c92-d498-6529-9d218881e919
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC_MYRKUL(1) = True
#. TagRule: CLERIC_MYRKUL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:3f2d75e0-2c92-d498-6529-9d218881e919
msgctxt "hc1ed32c5g7f52g49a4g9793gb467a9550cbd"
msgid ""
"These vessels are a reminder that death walks behind each of us, every day. "
"None can outrun him. Praise Myrkul."
msgstr ""
"이 그릇들은 죽음이 우리 각자의 뒤에서 매일 걸어가고 있음을 상기시켜 주나니. 아무도 그분을 피해 갈 수는 없다. 머큘님을 찬양하라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = 4128a8e8-a657-48ca-c88d-14e803e43b58
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:4128a8e8-a657-48ca-c88d-14e803e43b58
msgctxt "h7b631f36g6a6eg4631g9648g7423ba663197"
msgid "<i>Honour </i>their suffering? Please."
msgstr "그들의 고통에 <i>경의 </i>를 표한다고? 제발."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = 439a66f9-41c8-c33e-dafe-a8ae4c9a07a2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:439a66f9-41c8-c33e-dafe-a8ae4c9a07a2
msgctxt "hf05a27bag54a0g4cc6g9701ge2a4374a0f3f"
msgid "This was a good crew. They deserved better."
msgstr "이들은 좋은 동료였어. 이런 꼴을 당할 이유가 없었는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = 43d6e888-6f10-5d7d-a7c8-17448a733f2a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:43d6e888-6f10-5d7d-a7c8-17448a733f2a
msgctxt "he66c5b14gbec0g4e49ga0c2g1f81bf5820df"
msgid "Smart. Those bastards'll spit on your grave after running you through."
msgstr "현명하군. 그 개자식들은 당신네를 찔러 죽이곤 무덤에다 침을 뱉었을 작자들이라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = 443561f7-bc0f-0c04-6de0-d2968212385f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:443561f7-bc0f-0c04-6de0-d2968212385f
msgctxt "hdb330154g3b64g465fg9c31g6e24b3a633ca"
msgid "Whatever you say, mate."
msgstr "알았다고, 친구."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = 46583036-abd6-706c-7fd3-9fda501451a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:46583036-abd6-706c-7fd3-9fda501451a8
msgctxt "h1bb2b2abg9dedg48efgae40g61431ee9bb0c"
msgid "Your man Helm seems to know what he's talking about."
msgstr "그 헬름이라는 자는 자기가 무슨 말을 하는지 잘 아는 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Player
#. NodeID = 46d98037-01ae-eaaa-bafe-bac31af06ff7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:46d98037-01ae-eaaa-bafe-bac31af06ff7
msgctxt "h0942b1d6g9092g486ag936eg256ddcf23a31"
msgid "What was the contract?"
msgstr "어떤 계약이었지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Player
#. NodeID = 4b28fdb1-5f22-0986-ed96-96f6fd4b609d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:4b28fdb1-5f22-0986-ed96-96f6fd4b609d
msgctxt "h400d63eeg8f77g4718ga15egd10ad8320e55"
msgid "Honour demanded I extend my travels farther afield."
msgstr "명예가 내 여정을 더 멀리 이어가라 하더군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Player
#. NodeID = 4b83944d-11ec-dc87-aa0d-aff055f75670
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:4b83944d-11ec-dc87-aa0d-aff055f75670
msgctxt "h04c894eagaba1g4ca8gac44g7876d3c8170f"
msgid "And you just left him to die?"
msgstr "그리고 그냥 죽게 내버려두고 왔다고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = 4ea89590-e71b-c645-22d9-dbf6b0da12b5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:4ea89590-e71b-c645-22d9-dbf6b0da12b5
msgctxt "h14f6eae6g4af0g44e3gaf80gb0fec8cb143c"
msgid "Grim."
msgstr "잔혹하군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = 500dee11-9b4f-317e-5fce-835a78ffcc35
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:500dee11-9b4f-317e-5fce-835a78ffcc35
msgctxt "h4103d35fg6946g4d7cgbe92g2e19c2d3626a"
msgid ""
"That's true, isn't it? My crew gave those nasty little shites as good as "
"they got."
msgstr "맞는 말이야. 안 그래? 내 친구들이 딴엔 최선을 다해서 그 개 같은 잡것들한테 한 방 먹였다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = 558d1b67-6bb3-a06f-2715-74c3fa2544dd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:558d1b67-6bb3-a06f-2715-74c3fa2544dd
msgctxt "h5edf6a0bg7a77g4e76gb274g9c8a2e8327b3"
msgid "Whatever that means."
msgstr "무슨 뜻인진 모르겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = 5938b0f1-1fe3-d6a6-a621-7bb5ccafee32
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:5938b0f1-1fe3-d6a6-a621-7bb5ccafee32
msgctxt "h67b70e09g2c28g4b72g87ceg26e08e181b84"
msgid "Pretty good point, for a religious type. Which one's your god again?"
msgstr "종교인 치고는 좋은 지적이군. 당신이 섬기는 신이 누구라고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Player
#. NodeID = 5b6d2da6-317c-37c5-4329-7fb60792a9a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:5b6d2da6-317c-37c5-4329-7fb60792a9a4
msgctxt "h5b3b5d88g76c8g421aga464g835fe1ffc94f"
msgid "He'll make himself known to you when you are ready."
msgstr "그 분께선 그대가 준비되었을 때 자신을 알리심이라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = 5dd5ffd8-9ddd-e142-155e-d9fda546cb54
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:5dd5ffd8-9ddd-e142-155e-d9fda546cb54
msgctxt "h2348bed1g554ag475bgbadcg3d2f4c113ac6"
msgid "What sort of prayer?"
msgstr "어떤 종류의 기도를 말하는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = 5ed382b3-0ad3-e60e-87c0-ccb6e5b9622b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:5ed382b3-0ad3-e60e-87c0-ccb6e5b9622b
msgctxt "hc4ce414bg8250g4dacgbf6eg3e374b66b822"
msgid "Great. I've been wasting my breath on a Bhaal lunatic."
msgstr "환상적이네. 바알을 섬기는 광신도와 시간을 낭비하고 있었다니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = 6075451f-9c2b-0750-d79e-528fac6b9e91
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:6075451f-9c2b-0750-d79e-528fac6b9e91
msgctxt "h68f7d915g95fdg4f5egbf7age101f43d1ece"
msgid ""
"The goblins are holed up in some temple ruins out west. You'll smell 'em or "
"hear their drums before you see 'em."
msgstr "고블린들은 서쪽에 있는 신전 폐허에 자리 잡고 있어. 근처에 가면 놈들의 냄새를 맡거나 북소리를 들을 수 있을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Player
#. NodeID = 615e9dd2-2bfb-3b72-f3ef-b6211c287cd3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:615e9dd2-2bfb-3b72-f3ef-b6211c287cd3
msgctxt "h2b03e31ag91bbg40d1gab73gfe50d9f2b81a"
msgid "Looks like you were ill-prepared."
msgstr "대비가 부족했나 보군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = 65a8d0c3-36d6-4fcd-b724-27413129b0ec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:65a8d0c3-36d6-4fcd-b724-27413129b0ec
msgctxt "h234c3f26g322dg4cf2gaa9fg3feb422b0a10"
msgid "Tieflings... goblins... Gods, this contract was cursed from the first."
msgstr "티플링... 고블린... 신까지, 이 계약은 처음부터 저주받은 거였어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Player
#. NodeID = 6ca7de44-b2a6-88b4-0d34-08c119218b8b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:6ca7de44-b2a6-88b4-0d34-08c119218b8b
msgctxt "h8f89d0b4g47b0g4e2cga52fgecee3a6b8d7c"
msgid "I have somewhere else to be."
msgstr "따로 갈 곳이 있어서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = 70565351-6f1e-d3ca-2c28-bc2f184cfa85
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_AdventurersQuest_Knows_AradinStory = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:70565351-6f1e-d3ca-2c28-bc2f184cfa85
msgctxt "h332f4bb2ga3aeg4da1gbb3egf7a441ac5c47"
msgid ""
"Gonna find the wizard who gave us the contract that got my people killed. "
"Left out all the important bits, like 'Beware, treasure's beneath a pile of "
"goblins.'"
msgstr ""
"처음에 이 계약을 제시해서 내 사람들을 죽게 만든 그 위저드를 찾아야겠어. 중요한 정보는 다 빼놓았잖아, '조심해, 보물은 고블린 무더기 "
"아래에 깔려있어' 같은 거 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Player
#. NodeID = 711b9d0c-f616-345d-9cde-7fef919f400d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:711b9d0c-f616-345d-9cde-7fef919f400d
msgctxt "h7c7a409cg0c77g4ce5g88f7g6460ba9ac06b"
msgid "A few goblins killed your whole crew? Pathetic."
msgstr "고블린 몇 마리한테 부하들을 다 잃었다고? 한심하군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = 73fc206e-5adb-78e5-b576-30ac33032069
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - SHA_Nightsong.LearnedLocation(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:73fc206e-5adb-78e5-b576-30ac33032069
msgctxt "h3869a0b4g47c0g45e8g8a3cg60bc23331b88"
msgid ""
"It's called the Nightsong. Supposed to be hidden under the temple where the "
"goblins jumped us."
msgstr "밤의 노래라는 유물이야. 우리가 고블린에게 습격당했던 그 신전 지하 어딘가에 숨겨져 있다고 하더군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Player
#. NodeID = 7471aa8c-551e-a21c-835d-f7603e141905
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:7471aa8c-551e-a21c-835d-f7603e141905
msgctxt "h17ff24d4g5206g4bf3g864aga64652218af6"
msgid "I thought you were busy leading your crew."
msgstr "그러는 당신은 부하들을 지휘하느라 바쁜 줄 알았는데 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Player
#. NodeID = 7611a0bd-71a5-68f7-978c-df904dd04847
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC_MYSTRA(1) = True
#. TagRule: CLERIC_MYSTRA
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:7611a0bd-71a5-68f7-978c-df904dd04847
msgctxt "h57a0f80bg39e1g40ccgbdd6ge43124ea7388"
msgid ""
"May their journey onwards be filled with as many wonders as they enjoyed in "
"life."
msgstr "그들이 즐겼던 삶만큼이나 많은 경이가 앞으로 그들의 여정에 가득하길."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Player
#. NodeID = 77384cd7-6339-9f58-d549-5e7275b231af
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:77384cd7-6339-9f58-d549-5e7275b231af
msgctxt "h886d97d1g4880g40feg8dabgfd50a31fab1a"
msgid "True. I wouldn't risk it for twice the gold."
msgstr "사실이야. 두 배는 많은 금화를 준다고 해도 그런 위험을 감수하진 않았을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = 79213ec1-353f-5b01-8aaf-1e26ef06b2f6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:79213ec1-353f-5b01-8aaf-1e26ef06b2f6
msgctxt "hbe5147c7ga1a3g47bdgab46g8362ce8f9690"
msgid "That's true. Without these lads, we'd've been cooked."
msgstr "그건 맞는 말이야. 이 친구들이 없었다면, 우린 다 끝장났겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = 7a328d8b-c077-43bf-5901-e1ad5073ac6f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:7a328d8b-c077-43bf-5901-e1ad5073ac6f
msgctxt "ha2cddc26g93d1g4e83gb37cge3bf59cf1e55"
msgid ""
"Heh, don't thank me. I'll be well on my way to Baldur's Gate when you die."
msgstr "고마워 하지 마. 너 죽을 쯤에 난 멀쩡히 발더스 게이트에 도착해 있을 테니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = 7a54a2cf-33be-c300-26ff-482d55a3f025
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_TYR
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:7a54a2cf-33be-c300-26ff-482d55a3f025
msgctxt "h18e7772bg6a2eg4147g95e7gc44a08703506"
msgid "Your man Tyr knows what he's talking about."
msgstr "티르라는 자는 자기가 무슨 말을 하는지 잘 알고 있는 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = 7a54a2cf-33be-c300-26ff-482d55a3f025
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: CLERIC_TEMPUS
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:7a54a2cf-33be-c300-26ff-482d55a3f025
msgctxt "h25440a60g4bf4g49e7ga1feg462dfc71f5eb"
msgid "Your man Tempus knows what he's talking about."
msgstr "당신이 섬기는 템푸스라는 자는 자기가 무슨 말을 하는지 잘 알고 있는 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = 7c8a7031-39b9-6019-4ab0-4c67e9da237a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:7c8a7031-39b9-6019-4ab0-4c67e9da237a
msgctxt "h6d0f7913g37b6g4b85g9b37g72eca2c3986a"
msgid "We're leaving. Don't follow, if you know what's good for you."
msgstr "우린 떠날 거야. 자신의 안위를 생각한다면, 따라올 생각은 하지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = 810e080e-0a24-6824-aee0-5c5c6c0e3126
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_AdventurersQuest_Knows_AradinStory = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:810e080e-0a24-6824-aee0-5c5c6c0e3126
msgctxt "ha8fb9539gfa28g4047ga7c0g0e498a61540e"
msgid "Not no more."
msgstr "더 이상은 아니지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = 848b4070-6fae-03de-99b9-0224343e44d5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:848b4070-6fae-03de-99b9-0224343e44d5
msgctxt "h2dde9ea3ga07fg4957g8253g1b64641a2f9b"
msgid "Wasn't any of your business, though, was it?"
msgstr "하지만 네가 상관할 일은 아니었지, 그렇지 않나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Player
#. NodeID = 8666131e-f3d9-15f1-0b4f-065597c499e4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC_TEMPUS(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AdventurersQuest_LeaderAtCorpses_PlayerPrayedTempus(1) = True
#. TagRule: CLERIC_TEMPUS
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:8666131e-f3d9-15f1-0b4f-065597c499e4
msgctxt "h25f1cf5ag3e13g4085gb532gdc8c31665587"
msgid ""
"May their blades be ever sharp, and their arrows ever true. We honour them, "
"for they fought to the last."
msgstr "그들의 칼날은 영원토록 날카롭고, 화살은 영원토록 정확하기를. 최후의 순간까지 맞서 싸운 이들에게 경의를 표한다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Player
#. NodeID = 86d4af24-6ab0-d18b-7724-7cd8adbfb8e2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AdventurersQuest_KnowTheRisk(1) = True
#.   Object:
#.      - DEN_AdventurersQuest_State_HasContract(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:86d4af24-6ab0-d18b-7724-7cd8adbfb8e2
msgctxt "h4240d2f3g0726g4c25g85b1gbc83e28df82c"
msgid "I'll take the risk. Give me the contract."
msgstr "위험은 감수하지. 그 계약을 내게 넘겨."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Player
#. NodeID = 8b024342-a155-8d99-3dd2-eded5c8eb418
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC_HELM(1) = True
#. SetFlags:
#.   Object:
#.     - DEN_AdventurersQuest_LeaderAtCorpses_PlayerPrayedHelm(1) = True
#. TagRule: CLERIC_HELM
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:8b024342-a155-8d99-3dd2-eded5c8eb418
msgctxt "h1bbfc7a9gadb4g49c7g8fabg7851cf9fc16c"
msgid ""
"May they find peace now, they who died fighting so others may live. We "
"honour them as protectors."
msgstr "다른 이들이 살 수 있도록 맞서 싸운 이들이 이제 안식에 들기를. 우리는 이들을 수호자로 기리니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = 8ff0461d-f9d1-e6b1-cec0-592ccb7bfdab
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_RaidingParty_Event_KnockOutAdventurer = True
#.      - DEN_RaidingParty_Event_PlayerDidTheKO = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:8ff0461d-f9d1-e6b1-cec0-592ccb7bfdab
msgctxt "h7c0a5134gc655g4c31ga4cdg6e04afe6b6e4"
msgid "Sucker-punching strangers - that's your bit, right?"
msgstr "느닷없이 생판 남을 갈기는 게 네 방식인가 보지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Player
#. NodeID = 914e30b5-0585-b53d-2733-40d389b69610
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:914e30b5-0585-b53d-2733-40d389b69610
msgctxt "h6ed06ff4gbbe8g4028ga77bgb2f87e36ca2c"
msgid "Before you go, I'd like to say a prayer for your crew."
msgstr "떠나기 전에, 당신 부하들을 위해 기도를 하고 싶어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = 91d5139b-6d64-b991-b1b4-a835a67c4bfd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:91d5139b-6d64-b991-b1b4-a835a67c4bfd
msgctxt "ha2e8d7c9gb3beg4ed3g84d4gc07efbe028b4"
msgid "See you on the road, mate."
msgstr "길에서 만나자고, 친구."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Player
#. NodeID = 97bee1f9-c2a0-ddeb-c594-c53ab8df60a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:97bee1f9-c2a0-ddeb-c594-c53ab8df60a8
msgctxt "h462dd624ged4bg44bbg9404gc89627e65dec"
msgid "Forget it. Let's just get out of here."
msgstr "잊어버려. 그냥 여기서 빠져나가기나 하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = 9b4f6b4e-71b1-ddf7-27ca-4413a51eea9a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:9b4f6b4e-71b1-ddf7-27ca-4413a51eea9a
msgctxt "ha26b944fgc18ag4a2cg890ag784232c240a0"
msgid "Save your breath. They're too dead to hear you."
msgstr "말을 아껴. 어차피 저들은 네 말을 듣기엔 이미 죽은지 오래니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Player
#. NodeID = 9becca20-7f03-170b-8366-907f8e922230
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC_SELUNE(1) = True
#. TagRule: CLERIC_SELUNE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:9becca20-7f03-170b-8366-907f8e922230
msgctxt "hb419893bg8ef4g402dg85f7g85a06970de13"
msgid ""
"May their path into the next plane be illuminated by a thousand gentle "
"lights."
msgstr "다음 차원을 향한 그들의 여정을 천 개의 온화한 빛이 밝혀주기를."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Player
#. NodeID = 9f1ca9e8-6924-0a46-8d26-1070636e2655
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:9f1ca9e8-6924-0a46-8d26-1070636e2655
msgctxt "h36a1de3fgb41cg4b02g8db1g2fd48ab42aeb"
msgid "Helm, god of guardians."
msgstr "수호자들의 신, 헬름님이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = 9f8040c4-1d56-3c83-3252-c70e9e4a7960
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:9f8040c4-1d56-3c83-3252-c70e9e4a7960
msgctxt "h127cb050gab3fg474ag88d9g05ab5f96259d"
msgid "But gold ain't any use if you're too cold to spend it."
msgstr "하지만 죽어버리면 황금이 무슨 소용이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = a0159588-6c26-23a2-80ac-782e927084b9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:a0159588-6c26-23a2-80ac-782e927084b9
msgctxt "h281a8000g3561g4f51g831dge354ba9f4ffc"
msgid "Have at it, if you think you can do better."
msgstr "당신이 더 잘해낼 수 있을 거라고 생각한다면, 마음대로 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = a0a26de5-e366-ed01-ef50-3f1fa4300f78
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:a0a26de5-e366-ed01-ef50-3f1fa4300f78
msgctxt "haf099354g7d16g41d9g8144gd8edaae307ab"
msgid "Hard to forget idiots like these. I don't think I'll bother trying."
msgstr "이런 바보들은 잊기 힘들지. 그러고 싶지도 않고 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = a120f312-e73e-f3f2-ea68-08a2343ee3bb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:a120f312-e73e-f3f2-ea68-08a2343ee3bb
msgctxt "h57b4e8f5gf1bcg42d5g9f71gf69023ced481"
msgid "Good point. For a religious type. Which one's your god again?"
msgstr "종교인 치고는 좋은 지적이군. 네가 섬기는 신이 누구라고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Player
#. NodeID = a1b63c44-4338-d162-c960-e9bb9d94e71b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC_BHAAL(1) = True
#. TagRule: CLERIC_BHAAL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:a1b63c44-4338-d162-c960-e9bb9d94e71b
msgctxt "hab18e916ge94cg4f15gb61eg643470d59c51"
msgid ""
"Lord of Murder, I dedicate their blood to you. Praise those who spilled it!"
msgstr "살인의 군주시여, 이들의 피를 당신께 바칩니다. 이 피를 쏟게 한 이들에게 경배를!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = a3f5c849-56b5-29f9-621b-655367bbb8ae
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_AdventurersQuest_State_HasContract(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:a3f5c849-56b5-29f9-621b-655367bbb8ae
msgctxt "h242d436fg7ab0g4d21g94b3g64feede303e7"
msgid ""
"All I've got's the contract. Can show you where we turned back, if you feel "
"like dying."
msgstr "내가 가진 건 계약서뿐이야. 죽고 싶은 기분이라면, 우리가 떠난 곳이 어디였는지는 보여줄 수 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = a581b48f-e996-bf3f-f8ae-c8bf7a00a91a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:a581b48f-e996-bf3f-f8ae-c8bf7a00a91a
msgctxt "hac1e831bg607fg474eg81f0g0c2d976498c2"
msgid ""
"Folks like us ain't got unanswered questions. We got contracts to finish and "
"mouths to feed."
msgstr "우리 같은 사람들에게 답이 없는 질문은 없어. 끝마칠 계약과 먹여야 할 입이 있을 뿐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Player
#. NodeID = aab4f997-e18e-0e07-2e92-0ab4e6a287a0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_TIEFLING(1) = False
#.      - TIEFLING(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:aab4f997-e18e-0e07-2e92-0ab4e6a287a0
msgctxt "h86e6c8e7g5fccg4dd3g8068gb804ff28351e"
msgid "I left as quickly as I could. I don't waste my time with devilspawn."
msgstr "최대한 빨리 떠났지. 데빌스폰이랑 낭비할 시간은 없거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Player
#. NodeID = af2abd1a-1d73-8ed6-c8f5-7d6d5f17e2f2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC_KELEMVOR(1) = True
#. TagRule: CLERIC_KELEMVOR
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:af2abd1a-1d73-8ed6-c8f5-7d6d5f17e2f2
msgctxt "hfecd207bgb392g4c69gadcdg8d1eed33ae6e"
msgid ""
"Their death is but another step on the path. Kelemvor will judge them fairly."
msgstr "이들의 죽음은 또 다른 길을 향한 걸음일 뿐이니. 켈렘보르께서 이들을 정당히 심판하시기를."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = b2069206-48a3-4906-c638-899af287204d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:b2069206-48a3-4906-c638-899af287204d
msgctxt "h16ad896fg4300g4c61ga828g3cf8d62ff3a3"
msgid "Look, we're getting out of here. You should do the same."
msgstr "이봐, 우린 여기서 빠져나갈 거야. 당신들도 그러는 편이 좋을 거라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Player
#. NodeID = b4a44c27-cc6e-2066-4e16-7ee65598a34f
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_TYR
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:b4a44c27-cc6e-2066-4e16-7ee65598a34f
msgctxt "h275c2aa9gbaa5g418agaf24ga174387668b2"
msgid "I serve Tyr, god of justice."
msgstr "난 정의의 신, 티르를 섬긴다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Player
#. NodeID = b4a44c27-cc6e-2066-4e16-7ee65598a34f
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: CLERIC_TEMPUS
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:b4a44c27-cc6e-2066-4e16-7ee65598a34f
msgctxt "h7f865859gcdcbg4951g8e7cg55fb4d802567"
msgid "I serve Tempus, god of war."
msgstr "난 전쟁의 신, 템푸스를 섬긴다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = b58aa6d4-41cb-8b35-eb9b-9766b441cc27
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: TIEFLING
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:b58aa6d4-41cb-8b35-eb9b-9766b441cc27
msgctxt "hff1a92c1gf77eg4c69gaeedg1f89cea0016b"
msgid "Thought you was busy with the lads in Halsin's grove."
msgstr "댁은 할신의 숲 쪽 녀석들이랑 노닥대고 있을 줄 알았는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = b58aa6d4-41cb-8b35-eb9b-9766b441cc27
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:b58aa6d4-41cb-8b35-eb9b-9766b441cc27
msgctxt "h142a617bga10fg43d6g9505g5f57ca67ddfe"
msgid "Thought you was busy with the foulbloods in Halsin's grove."
msgstr "댁은 할신의 숲 쪽 더러운 혈통들이랑 노닥대고 있을 줄 알았는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Player
#. NodeID = be9502b6-1d49-1a30-e197-b1babfb64edb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:be9502b6-1d49-1a30-e197-b1babfb64edb
msgctxt "hb926ea22ge478g4086g82d0g15c870e53443"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Player
#. NodeID = c4231c01-87d1-8490-2b2c-420b446137eb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_WentWithAdventurers = True
#.      - GLO_AdventurersQuest_Knows_AboutBounty = True
#.      - GLO_Halsin_Knows_IsMissing = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:c4231c01-87d1-8490-2b2c-420b446137eb
msgctxt "hcdd9de85gabfbg4d4dg88ccg9ed1aaf6c63e"
msgid "I'm looking for Halsin. Heard you might know where he is?"
msgstr "할신을 찾고 있어. 당신이라면 그가 어디 있는지 알지도 모른다고 하던데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Player
#. NodeID = c4c8d37a-1082-0d8a-68cd-470268de43da
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC_BANE(1) = True
#. TagRule: CLERIC_BANE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:c4c8d37a-1082-0d8a-68cd-470268de43da
msgctxt "h92132e56g406fg4059g873dgfd781b8062dc"
msgid ""
"The Black Hand strikes and culls the unworthy. Yield in life, lest he reach "
"for you even in death."
msgstr "블랙 핸드는 무가치한 이들을 거두어 쳐내시느니, 죽음 속에서 그 분이 손을 뻗을 때 그 목을 내놓으라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Player
#. NodeID = c741ff3f-2f4b-8d1c-8fca-af0c388a9626
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:c741ff3f-2f4b-8d1c-8fca-af0c388a9626
msgctxt "h7b545ed2g9998g4717gb0f5ga38109ed4d43"
msgid "Let's say I want that gold. Where would I find the relic?"
msgstr "내가 그 금화를 가지고 싶다면, 그 유물은 어디서 찾을 수 있지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Player
#. NodeID = c8db8a82-5443-d3d7-6df4-801556706f27
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:c8db8a82-5443-d3d7-6df4-801556706f27
msgctxt "h0d5be5b9g3923g4637gb205g5db2c177fb5f"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = d1081db5-6b2e-0cff-ac55-a8506bf5312a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:d1081db5-6b2e-0cff-ac55-a8506bf5312a
msgctxt "h43a487c8gf66bg43b2g8bd4g3abfaeaa9338"
msgid "You and me both."
msgstr "그건 나와 마찬가지군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = db9e45ed-7a54-9567-8664-6a2075444b7c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_AdventurerLeader_State_AngryAtPlayer(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:db9e45ed-7a54-9567-8664-6a2075444b7c
msgctxt "hdb777d3cg14d0g456dgb9d4g7510cb939c8c"
msgid ""
"If you want to play the hero, go ask the goblins nicely, and maybe they'll "
"give you whatever's left of him."
msgstr "영웅 행세를 하고 싶다면, 고블린들에게 가서 정중히 부탁해 보시지, 그럼 그의 유해 일부라도 줄지도 모르니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Player
#. NodeID = de63f144-6982-a207-0924-8281a8210fc8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:de63f144-6982-a207-0924-8281a8210fc8
msgctxt "h8914b665g5b9dg4e20ga279gee5b29a71609"
msgid "You're giving up? I might take a shot at it myself."
msgstr "포기하는 건가? 그럼 내가 도전해 보고 싶은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = decd2a34-4305-a005-fcd5-e3875c390c6c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:decd2a34-4305-a005-fcd5-e3875c390c6c
msgctxt "h39043b7dga26cg4aedg87b6gef1a6aeb2d09"
msgid "The kind that leaves half your crew dead."
msgstr "수행하다 보면 동료 절반이 죽어 나가는 류지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = e1ec053b-147d-2b98-b535-9f222d0cc18a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:e1ec053b-147d-2b98-b535-9f222d0cc18a
msgctxt "hfd532c21g45b4g482cg943age8215959bd4b"
msgid ""
"Dunno what I expected. That much gold for some long-lost relic buried in the "
"arse-end of nowhere. ([GEN_CheckMagicPocketGold_6057ad05-9492-4630-9f0a-"
"be548b134c54])"
msgstr ""
"나도 내가 뭘 기대했는진 모르겠군. 이런 외딴곳에서 오래전에 잊힌 유물을 찾아오면 그만한 돈을 주겠다는 말을 믿다니. "
"([GEN_CheckMagicPocketGold_6057ad05-9492-4630-9f0a-be548b134c54])"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = ed8a6ed3-2ee4-3541-fdaa-464ea6ac278b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - GLO_Tadpole_SUB_Druid.LearnedKilledOrCaptured(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:ed8a6ed3-2ee4-3541-fdaa-464ea6ac278b
msgctxt "hc4e0dc8dg11cag4095g836eg934badc6abfb"
msgid ""
"When the goblins jumped us, most of my crew scarpered, just like I taught "
"'em to. The old codger didn't."
msgstr "고블린들이 습격했을 때, 내 부하 대부분은 달아났어, 내가 가르친 대로 말이지. 하지만 그 늙은이는 그러질 않더군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = f0e06bf5-5250-8ca2-59c3-4bdf4ef4deca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:f0e06bf5-5250-8ca2-59c3-4bdf4ef4deca
msgctxt "h8bf02065g6ac6g4d93g8885gf8501bb39e9d"
msgid "Nothing the lads would hate more than a judge waiting for 'em up there."
msgstr "죽고 나서 심판이 기다리고 있다니, 이 친구들이 아주 싫어하겠는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = f21c19a7-5f6c-a950-3ba9-0540728e7f6c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_AdventurersQuest_Knows_AradinStory = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:f21c19a7-5f6c-a950-3ba9-0540728e7f6c
msgctxt "h9ba5e2e3g561cg4119gb6a4g67bd50e65dda"
msgid ""
"Wish I'd had something better to do when I came across this contract. Bloody "
"goblins ran through my crew - and all for <i>nothing</i>."
msgstr ""
"이 계약을 받기 전에 다른 일이 있었다면 좋았을 텐데. 망할 고블린 놈들이 내 부하들을 죽여버렸어, 얻은 건 <i>아무것도 없는데</i> "
"말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = f3edbce7-17c6-e244-0c26-3d7016dc8b5b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:f3edbce7-17c6-e244-0c26-3d7016dc8b5b
msgctxt "hf82c1317gf458g464cgbd40g4dbf1bd787b3"
msgid "Bet you will, too. Just like my mates here did."
msgstr "너도 그렇게 될 거야. 여기 내 친구들이 그랬듯이."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = f42bf8cf-da03-6721-d9b8-35ee97de41ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:f42bf8cf-da03-6721-d9b8-35ee97de41ea
msgctxt "h3b89e84dg72cdg4d73gb52cge0d2ff81bd84"
msgid ""
"Didn't think this contract could go any worse. Then <i>you </i>showed up."
msgstr "이 계약이 더 나빠질 일도 없다고 생각했는데. 당신이 나타났군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = f4f1ec99-7cf3-387f-8743-c97a904eab89
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_AdventurersQuest_Knows_AradinStory = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:f4f1ec99-7cf3-387f-8743-c97a904eab89
msgctxt "h944813d8g057cg4f90g9d26gd4bb55be1a45"
msgid ""
"Contract didn't mention no goblins. I would've prepped the lads, brought "
"better weapons..."
msgstr "계약서엔 고블린 따위 명시되어 있지 않았어. 그걸 알았다면 대비시키고, 더 좋은 무기를 가져왔을 텐데..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Player
#. NodeID = f8e85f13-8139-fda0-8f92-6f85683e8a69
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AdventurersQuest_Knows_LeaderMap = True
#.   Quest:
#.      - SHA_Nightsong.LearnedBryanMap(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:f8e85f13-8139-fda0-8f92-6f85683e8a69
msgctxt "hb7e8b1edge16dg453fga2d0g125ac8742a1d"
msgid ""
"Hand over that contract - maybe I'll get the relic <i>and</i> save the druid."
msgstr "계약서를 넘겨, 내가 그 유물을 찾고 드루이드도 구할 수 있을지도 모르지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Player
#. NodeID = fbd5e22f-de36-a95d-2e9f-9c336102d233
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AdventurersQuest_KnowTheRisk(1) = False
#.   Object:
#.      - DEN_AdventurersQuest_State_HasContract(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:fbd5e22f-de36-a95d-2e9f-9c336102d233
msgctxt "h4ef821f9g9b4cg4c6agafdfg41b0103edeb8"
msgid "Thanks - I'll take it."
msgstr "고마워 - 내가 맡을게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Player
#. NodeID = fc43cc57-8002-43e0-fc52-03a19ba7f510
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC_ILMATER(1) = True
#. TagRule: CLERIC_ILMATER
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:fc43cc57-8002-43e0-fc52-03a19ba7f510
msgctxt "h5877b6afg6fdag4187gae0bg73d61cd9c167"
msgid ""
"Would that we had taken these blows in their place - but let us honour their "
"suffering."
msgstr "우리가 대신 시달리었어야 하였다. 그럼에도 그들의 고통에 영광 있기를."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses
#. Speaker = Aradin
#. NodeID = fdc03783-570c-9c68-bbb1-2ec4fc1c8374
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_AdventurersQuest_Knows_AradinStory = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_LeaderAtCorpses:fdc03783-570c-9c68-bbb1-2ec4fc1c8374
msgctxt "ha1987dbbg12e4g45c0gb854gd2a50dc82f81"
msgid "Contract cleverly left out we'd be tits deep in these buggers."
msgstr "계약서에는 우리가 이 개자식들과 엮이게 될 거라는 내용은 쏙 빠져있었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer
#. Speaker = Player
#. NodeID = 0fccec3d-4597-c571-6d11-e916f3502db9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer:0fccec3d-4597-c571-6d11-e916f3502db9
msgctxt "hf5e25666gf9a4g4f6cga2f8g86ad8a885f8e"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer
#. Speaker = Remira
#. NodeID = 12b0e63b-1758-ca62-bd90-91b690ec5c22
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_AdventurersQuest_State_CleanedWound(0) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_RaidingParty_Adventurer2_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer:12b0e63b-1758-ca62-bd90-91b690ec5c22
msgctxt "h16fb1bf3g364dg48d5g9b15gbe9d83e8d572"
msgid ""
"Think you disappointed this lot, swooping in to save us like that. Careful - "
"might turn on you just as quick."
msgstr "네가 뜬금없이 나타나 우릴 구해서 여기 놈들 실망이 클걸? 조심해. 너도 언제라도 뒤통수 맞을지 몰라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer
#. Speaker = Remira
#. NodeID = 12c63c31-6a0a-ac7c-44ba-6fb3be313939
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AdventurersQuest_HasMet_RemiraWithTortured(1) = True
#.   Global:
#.      - GOB_TorturedAdventurer_State_Resting = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer:12c63c31-6a0a-ac7c-44ba-6fb3be313939
msgctxt "h734b96dege9b3g4365g84cbg89fb52b41295"
msgid "Once we're patched up, we're gone."
msgstr "수습 다 끝나는대로 뜰 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer
#. Speaker = Remira
#. NodeID = 13483c03-02d7-3f99-e1a4-828213f2d59d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer:13483c03-02d7-3f99-e1a4-828213f2d59d
msgctxt "h687154c9g6582g47abgb098gfedc37c60f40"
msgid ""
"Damn sight better than what Zevlor's got coming, after leaving us to die "
"like that."
msgstr "제블로어 새끼가 들을 말보다는 훨씬 낫지. 우릴 그렇게 죽게 냅두다니 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer
#. Speaker = Player
#. NodeID = 15d633eb-790f-5d20-3fe3-eba87ed8da73
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC_TEMPUS(1) = True
#. TagRule: CLERIC_TEMPUS
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer:15d633eb-790f-5d20-3fe3-eba87ed8da73
msgctxt "h045dc84fg6fe7g45ffga2e1g7db36329480f"
msgid "A good death. He earned his place in Warrior's Rest."
msgstr "훌륭한 최후군. 전사의 안식처에 들기 충분하겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer
#. Speaker = Remira
#. NodeID = 1623386a-912e-5595-e0b5-3e296d8d2cb8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer:1623386a-912e-5595-e0b5-3e296d8d2cb8
msgctxt "h4b53ac3dg2645g4316g9cf0g09669b429b27"
msgid ""
"Might be more blood spilled yet, if Zevlor starts in on the lectures again."
msgstr "어쩌면 피 볼 일이 더 늘 수 있겠네. 제블로어가 또 잔소리질 해대면 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer
#. Speaker = Remira
#. NodeID = 1757434e-1f6f-faa3-3ab7-2d6c5a49976f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_TorturedAdventurer_State_Resting = True
#. SetFlags:
#.   Dialog:
#.     - DEN_AdventurersQuest_HasMet_RemiraWithTortured(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer:1757434e-1f6f-faa3-3ab7-2d6c5a49976f
msgctxt "h00d7bad5g676bg4cc6g887fg8ffabdfff0a9"
msgid ""
"Weren't no profit in saving Liam - you'd make a crap sellsword. But... "
"thanks."
msgstr "돈도 안 되는데 리암을 구하다니. 용병 소질은 별로 없나 봐? 그래도... 고마워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer
#. Speaker = Player
#. NodeID = 1a82c988-05b1-8721-c5b2-0365fd5ee579
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer:1a82c988-05b1-8721-c5b2-0365fd5ee579
msgctxt "h3d6059f3g4019g40f6gaf02g76612ab33080"
msgid "You should get that arm seen to."
msgstr "그 팔 진찰 받아보는 게 좋겠는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer
#. Speaker = Remira
#. NodeID = 1caa0bef-80bf-4f3d-e56e-ddf3992af6b9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer:1caa0bef-80bf-4f3d-e56e-ddf3992af6b9
msgctxt "h85bb10bfgb087g4e4fga3efg9b10e0a830db"
msgid "As close as you're gonna get from me today, friend."
msgstr "그게 오늘 나한테서 들을 수 있는 최대의 감사라고, 친구."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer
#. Speaker = Remira
#. NodeID = 1fcb939a-a1af-4a9b-e76b-899def5a8790
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_RaidingParty_Adventurer2_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer:1fcb939a-a1af-4a9b-e76b-899def5a8790
msgctxt "hdddef59bg1395g4bbagb889g5bcf5eb0a62f"
msgid "Damned... goblins..."
msgstr "망할... 고블린 놈들..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer
#. Speaker = Remira
#. NodeID = 25883a91-e00e-d20a-ebd9-41cd9dc635c2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_AdventurersQuest_Knows_AradinStory = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer:25883a91-e00e-d20a-ebd9-41cd9dc635c2
msgctxt "hc17b6ceag91d1g4aeega41cg69baa7f83fb4"
msgid ""
"We expected a soft job. Something to test the new lad, maybe, but not a "
"bloody <i>goblin nest.</i>"
msgstr "우린 쉬운 일감인 줄 알았어. 신참 실력이나 확인해볼까 싶었는데, 망할 <i>고블린 소굴</i> 천지였다니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer
#. Speaker = Remira
#. NodeID = 2ae72262-bc90-f4a7-3bae-922e28d6fe1c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_AdventurersQuest_Knows_AradinStory = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer:2ae72262-bc90-f4a7-3bae-922e28d6fe1c
msgctxt "h8f0c8637gdf7cg499cg89f7g61a781c0455d"
msgid ""
"Even the new lad - his first contract, and we land him in a godsdamned "
"goblin nest."
msgstr "그리고 신참마저도. 이번이 걔 첫 일감이었는데, 우리가 망할 고블린 소굴에 처박은 꼴이 됐다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer
#. Speaker = Player
#. NodeID = 2ba6da65-2335-2d30-3e0f-bab1154e8023
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer:2ba6da65-2335-2d30-3e0f-bab1154e8023
msgctxt "h8d92a430g3312g4e4ega62eg72e5ddefef72"
msgid "Was that a 'thank you'?"
msgstr "그게 '감사인사'냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer
#. Speaker = Player
#. NodeID = 2dc080f9-28dc-b2d9-7708-3611ee67a9e5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#. SetFlags:
#.   Object:
#.     - ORI_DarkUrge_Event_IndulgedUrge(1) = True
#.     - ORI_DarkUrge_Event_HadUrge(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer:2dc080f9-28dc-b2d9-7708-3611ee67a9e5
msgctxt "h16b95141g8343g4362g8df3gf95a56714b46"
msgid "<i>Ogle the gash in her flesh.</i>"
msgstr "<i>여자의 살점에 난 상처를 흘끔 살핀다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer
#. Speaker = Remira
#. NodeID = 32c8f0f0-8bd7-9bb1-75ad-fd5623e572b7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer:32c8f0f0-8bd7-9bb1-75ad-fd5623e572b7
msgctxt "ha07cbb2dgc540g4111g8cc6g581325a355e9"
msgid "That was lesson one, if Liam had only bloody listened."
msgstr "난 그리 가르쳤다고. 리암은 들어처먹었어야 했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer
#. Speaker = Remira
#. NodeID = 37f84b95-c2e8-29ef-6198-941978acd974
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer:37f84b95-c2e8-29ef-6198-941978acd974
msgctxt "hd661c4f4g52b8g4a5cgba55g3ef87183e248"
msgid "Oh, very gracious of you."
msgstr "오, 거 맘씨도 넓으셔라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer
#. Speaker = Remira
#. NodeID = 3b858782-e3cd-2b5e-3786-f8874d1b5fc6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_RaidingParty_Adventurer2_HasMet(1) = True
#.      - DEN_AdventurersQuest_Event_Accused(1) = True
#. TagRule: TIEFLING
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer:3b858782-e3cd-2b5e-3786-f8874d1b5fc6
msgctxt "h3dfdc983gacd1g487egb04cg9a4b01b97e1c"
msgid "You're all right, for a tiefling. At least you <i>fight.</i>"
msgstr "너 제법 괜찮네. 티플링 치곤 말이지. <i>싸울</i> 배짱은 있으니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer
#. Speaker = Remira
#. NodeID = 3b858782-e3cd-2b5e-3786-f8874d1b5fc6
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_RaidingParty_Adventurer2_HasMet(1) = True
#.      - DEN_AdventurersQuest_Event_Accused(1) = True
#. TagRule: !TIEFLING
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer:3b858782-e3cd-2b5e-3786-f8874d1b5fc6
msgctxt "h66603e40g2fe4g41c4g8717gd97755bfb6f5"
msgid ""
"We're packing up and I'd advise you do the same. Seems our kind ain't "
"welcome here."
msgstr "우린 짐 싸고 있어. 충고하는데 너도 그러는 게 좋을걸. 여기 것들은 우리네 종자가 고깝나 보거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer
#. Speaker = Player
#. NodeID = 3b91ce62-121c-1350-b035-ced59c020801
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer:3b91ce62-121c-1350-b035-ced59c020801
msgctxt "h823b9e64g5bddg498ag9297g32694ca17f7d"
msgid "I already regret saving your life."
msgstr "댁 목숨 구해준 게 벌써 후회되는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer
#. Speaker = Player
#. NodeID = 3d737d7e-bf12-766b-4882-841e714bf2e8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer:3d737d7e-bf12-766b-4882-841e714bf2e8
msgctxt "h5fa9141ag8a5bg4e97g8265g29a999fa6c4b"
msgid "He let you in, didn't he? It could have been worse."
msgstr "결국엔 그 사람이 들여줬잖아? 그만하면 다행이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer
#. Speaker = Player
#. NodeID = 403a6aa6-8d53-28d9-f13b-768285338861
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer:403a6aa6-8d53-28d9-f13b-768285338861
msgctxt "hea32a4d5g1d86g4f94g8bd0gb9e4dcd11d2d"
msgid "<i>Wait for her to finish cleaning the wound.</i>"
msgstr "<i>여자가 상처를 다 닦을 때까지 기다린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer
#. Speaker = Remira
#. NodeID = 4cd72fb8-e68b-0385-4b29-2bd94b912ce9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer:4cd72fb8-e68b-0385-4b29-2bd94b912ce9
msgctxt "h9c04764ag22f9g4596g8bf2g4100a96e1628"
msgid ""
"And what about <i>our </i>people? Half the crew's lying dead back in that "
"ruin."
msgstr "그럼 <i>우리네</i>는 그냥 당하라고? 동료 절반이 그 폐허에서 죽어 나자빠졌어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer
#. Speaker = Narrator
#. NodeID = 4e6dfcbe-4728-c1de-5ebb-9c41372ca1c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer:4e6dfcbe-4728-c1de-5ebb-9c41372ca1c8
msgctxt "hbd48df1dg6174g4608gaa88gfaf81e4b84dc"
msgid ""
"*You lose yourself in the scab's weeping sea. It is no masterwork, but it "
"provides a base bliss to gaze upon.*"
msgstr "*딱지에서 넘실대는 피에 정신이 홀립니다. 절경까지는 아니지만, 바라보고 있으니 소소한 즐거움이 드는군요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer
#. Speaker = Remira
#. NodeID = 6e784cc7-cf93-ccf1-27a0-c5428aed09ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer:6e784cc7-cf93-ccf1-27a0-c5428aed09ed
msgctxt "h534c5a6fg50bcg4af3g9f27g6765fefc6032"
msgid ""
"Nah. He... must've thought we were following. Always the optimist, was Liam."
msgstr "그래. 걔는... 우리도 따라나설 줄 알았을 거야. 매사가 낙관적이었지, 리암 녀석은."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer
#. Speaker = Remira
#. NodeID = 6f20fd5f-6625-d37e-00eb-ad193546b67f
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: TIEFLING
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer:6f20fd5f-6625-d37e-00eb-ad193546b67f
msgctxt "h8fb03ad8gf549g4ae2g918fg492dc7d977bb"
msgid "Well. Finally - someone with some sense between their horns."
msgstr "아, 드디어. 이 뿔쟁이들 중 정신 똑바른 사람을 만나네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer
#. Speaker = Remira
#. NodeID = 6f20fd5f-6625-d37e-00eb-ad193546b67f
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer:6f20fd5f-6625-d37e-00eb-ad193546b67f
msgctxt "hb4172b00g8b2cg48cfg875cg0341ce597fa4"
msgid ""
"Well. Finally - someone who ain't got horns where their good sense should be."
msgstr "아, 드디어. 제정신에다 뿔도 안 달린 사람을 만나게 되네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer
#. Speaker = Remira
#. NodeID = 721379fc-cac4-5af2-a390-e7483cad7993
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_RaidingParty_Adventurer2_HasMet(1) = True
#. TagRule: TIEFLING
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer:721379fc-cac4-5af2-a390-e7483cad7993
msgctxt "h41c52f35g12feg4a46g8451g095676a4ed92"
msgid "We're heading out. Good luck with your 'kin'."
msgstr "우린 떠날 거야. 네 '동족'끼리 잘해 보셔."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer
#. Speaker = Remira
#. NodeID = 721379fc-cac4-5af2-a390-e7483cad7993
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_RaidingParty_Adventurer2_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer:721379fc-cac4-5af2-a390-e7483cad7993
msgctxt "hbd51913fg8b03g403dgb000ga9f01c58cff1"
msgid ""
"We're packing up and I'd advise you do the same. Seems our kind ain't "
"welcome here."
msgstr "우린 짐 싸고 있어. 충고하는데 너도 그러는 게 좋을걸. 여기 것들은 우리네 종자가 고깝나 보거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer
#. Speaker = Remira
#. NodeID = 7721234d-9894-bfad-4c37-fe790a8403b3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer:7721234d-9894-bfad-4c37-fe790a8403b3
msgctxt "h9a0c68b3ge335g4c32g8316g67a56e046748"
msgid "Oh aye? I was just going to let it fall off, stick it in my satchel."
msgstr "아 그러셔? 난 그냥 곪아 떨어지게 놔두고, 가방에 처박을 작정이었는걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer
#. Speaker = Remira
#. NodeID = 7c33a620-0135-8e7f-7399-7f6da527630e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TIEFLING(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_RaidingParty_Adventurer2_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer:7c33a620-0135-8e7f-7399-7f6da527630e
msgctxt "hc5ba174agf459g4325gad3ag82d5d7b5ca0c"
msgid "Ah, the fighting foulblood. Glad to know one of you has a spine."
msgstr "아, 그 더러운 혈통 싸움꾼이군. 너희 것들 중 너라도 기개를 보여 다행이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer
#. Speaker = Remira
#. NodeID = 847bd014-0832-7952-a225-d0e5c2dfda2a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer:847bd014-0832-7952-a225-d0e5c2dfda2a
msgctxt "h7fde2451ga405g433ag8471gac579012f1cc"
msgid "Just another raw recruit thought he was in some storybook."
msgstr "그저 지가 소설 주인공인 줄 착각한 여느 초짜였을 뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer
#. Speaker = Remira
#. NodeID = 93bfd1dd-7c7e-41a0-1796-748c5f04a470
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer:93bfd1dd-7c7e-41a0-1796-748c5f04a470
msgctxt "h059b5180ge7c5g4aafg9807gdf48cfaab1dc"
msgid ""
"But aye, maybe you could... say a prayer, or something? Just... put in a "
"good word, like."
msgstr "다만... 야, 너라면 아마... 기도 같은 거 할 줄 알지? 그냥... 좋은 말 좀 붙여서 올려줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer
#. Speaker = Player
#. NodeID = 97edd4a7-278c-7318-34ae-74d2d4d08554
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer:97edd4a7-278c-7318-34ae-74d2d4d08554
msgctxt "hbc1f2a4bg55bcg4fbag838egdb4e54d04d59"
msgid "He died with bravery. You should be proud."
msgstr "용맹하게 죽었군. 자랑스럽겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer
#. Speaker = Remira
#. NodeID = 9c557f21-23b1-8298-5efe-e1e37d68136d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer:9c557f21-23b1-8298-5efe-e1e37d68136d
msgctxt "h4b6a24efgee45g412bg9b50g7bbfcc44568b"
msgid ""
"Ah - bruised your feelings, did I? Excuse me if I don't weep - got problems "
"of my own."
msgstr "아, 맘 상하기라도 하셨어? 사죄의 눈물 못 보여서 미안하네. 남 배려해주긴 벅찬 상태거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer
#. Speaker = Player
#. NodeID = 9d089325-0ad0-9614-7f3f-121d7151f6c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer:9d089325-0ad0-9614-7f3f-121d7151f6c0
msgctxt "he48cff63g3ac7g4dc6g910dg0aab73e26b28"
msgid "I'd have done the same in your place."
msgstr "같은 처지였다면 나도 댁같이 굴 것 같긴 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer
#. Speaker = Player
#. NodeID = a70730b1-c42f-4693-8203-e9259441cafe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer:a70730b1-c42f-4693-8203-e9259441cafe
msgctxt "hd5121f5bg18fdg476fg8a8egc1bda6f7c485"
msgid "I'm guessing that didn't end well."
msgstr "아무래도 좋은 꼴을 못 봤을 것 같네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer
#. Speaker = Remira
#. NodeID = b16cf03b-3ab2-8b9b-b787-1bf643abe3ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer:b16cf03b-3ab2-8b9b-b787-1bf643abe3ad
msgctxt "hc1eb33d1g78ddg497fg9e61g23feceb117c9"
msgid ""
"Most would've turned tail at the sight. But not Liam, no - he <i>charged</i> "
"them, the stupid bastard."
msgstr "그 상황엔 대개 냅다 도망칠 텐데, 리암은 아니더라. 되려 <i>달려들었지</i>. 그 미련한 새끼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer
#. Speaker = Remira
#. NodeID = b4ee77d1-a5f6-0272-8e33-150a04306601
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer:b4ee77d1-a5f6-0272-8e33-150a04306601
msgctxt "hdedd3a0egd649g45b9g85b7g4e4b68ae2a33"
msgid "Hope they cut him down quick before he saw we were gone."
msgstr "우리가 버린 걸 모르고 녀석이 죽었길 바랄 수밖에."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer
#. Speaker = Remira
#. NodeID = b70ac093-3d5a-469e-8c98-9081650a387d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer:b70ac093-3d5a-469e-8c98-9081650a387d
msgctxt "h32459fe3g6091g470ag878dgcca05dd54274"
msgid ""
"Ain't letting anyone here <i>near</i> me. They all sat and watched while "
"Zevlor near got us killed."
msgstr "내 <i>근처에</i> 여기 놈들 둘 생각 없어. 제블로어가 우리 죽일 뻔한 동한 이놈들은 구경만 했다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer
#. Speaker = Remira
#. NodeID = b81280ac-a5a0-2e70-9c8c-7b92c6e52028
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer:b81280ac-a5a0-2e70-9c8c-7b92c6e52028
msgctxt "hbd40e0beg887fg485fgab7cgce711639b065"
msgid ""
"These weren't no normal goblins. And Liam weren't no <i>friend</i>, all "
"right?"
msgstr "평범한 고블린들이 아니었거든? 또 리암도 딱히 친구는 아니었다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer
#. Speaker = Remira
#. NodeID = c31e567a-beed-f581-3267-844122fccbf6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer:c31e567a-beed-f581-3267-844122fccbf6
msgctxt "h345d44f7gd8eag4177gabf1gfd30c12c4360"
msgid ""
"<i>Bravery? </i>No. When it gets you killed, it's just called stupidity."
msgstr "<i>용맹이라고? </i>아니. 그런 식으로 목숨 날리는 건, 그냥 미련함이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer
#. Speaker = Remira
#. NodeID = c51ef920-d3de-b4fb-922c-34166a87c8bd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer:c51ef920-d3de-b4fb-922c-34166a87c8bd
msgctxt "h6e3cf2f0gf383g4dd3ga291g0e1053a2c589"
msgid "And then he has the bloody <i>gall </i>to try and blame it all on us."
msgstr "그러곤 씨발 <i>뻔뻔스럽게</i> 전부 우리 탓으로 돌리려 하고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer
#. Speaker = Player
#. NodeID = c8f50f34-c176-5b9e-f24c-f5f044d23a84
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer:c8f50f34-c176-5b9e-f24c-f5f044d23a84
msgctxt "h4a2836bcg571bg45efg994fg3a3f0933e805"
msgid "You should probably get that looked at."
msgstr "그거 치유사 찾아가 살피는 게 좋을 거 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer
#. Speaker = Player
#. NodeID = ddc47466-f7e8-78f9-509e-26f55f00a65b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer:ddc47466-f7e8-78f9-509e-26f55f00a65b
msgctxt "h90fab89cg2a7eg419eg8f6cg598c9a0ceb4e"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer
#. Speaker = Remira
#. NodeID = e66ff391-da0a-6801-2da8-706286f072e9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer:e66ff391-da0a-6801-2da8-706286f072e9
msgctxt "hbb181950gbb1cg4b0bgab7bgf2e27cc0bbbc"
msgid ""
"Like the sight of blood, do you? Thought you'd've had your fill at the gate."
msgstr "피 구경하는 게 좋은가 봐? 관문에서 질릴 만큼 구경했을 거 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer
#. Speaker = Remira
#. NodeID = ef46f7bf-ae50-a42b-6287-36f98ce1c396
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer:ef46f7bf-ae50-a42b-6287-36f98ce1c396
msgctxt "h5693d4cfg660cg4475gb1ffge96dd74b942d"
msgid ""
"Warrior, my arse - not even Tempus himself could teach Liam to swing "
"straight."
msgstr "전사 같은 소리 하네. 리암은 그 템푸스한테 직접 배워도 검 하나 똑바로 못 벨 애라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer
#. Speaker = Player
#. NodeID = f49ce136-e01f-4ad2-e876-f0d4fe12c3dc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer:f49ce136-e01f-4ad2-e876-f0d4fe12c3dc
msgctxt "hc5bff558g34fbg47b7gaa1eg55970cb0a305"
msgid "So you just left your friend to the goblins?"
msgstr "그래서 친구를 고블린한테 냅두고 도망쳤단 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer
#. Speaker = Remira
#. NodeID = f7f0fef1-6d1e-724c-5585-d5399e143e0f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer:f7f0fef1-6d1e-724c-5585-d5399e143e0f
msgctxt "hbbfd9366g6bc7g48ddgb885gcdc4dacbe9f1"
msgid "My arm's near hanging off after wise Zevlor left us to die at the gate."
msgstr "그 잘난 제블로어가 입구에서 우릴 죽게 냅둔 덕에 팔 병신이 될 판이란 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer
#. Speaker = Player
#. NodeID = fef7cdec-475a-7b5c-4434-8a586fb0648c
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_DRAGONBORN or REALLY_DWARF
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer:fef7cdec-475a-7b5c-4434-8a586fb0648c
msgctxt "h736af85bgb07bg4526g8025g33964d941e99"
msgid "You put your own people first. That's just the way it is."
msgstr "원래 자기 동족이 우선인 법이지. 그게 당연한 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer
#. Speaker = Player
#. NodeID = fef7cdec-475a-7b5c-4434-8a586fb0648c
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer:fef7cdec-475a-7b5c-4434-8a586fb0648c
msgctxt "h2631143bg0be4g46ceg9e68ga1f6d45117f7"
msgid "You <i>are </i>to blame - you put his people in danger."
msgstr "잘못한 건 <i>그쪽</i>이지. 그의 사람들을 위험에 빠뜨렸잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer
#. Speaker = Remira
#. NodeID = ff1afcaf-57a8-1cc7-849b-946775d65b5e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurer:ff1afcaf-57a8-1cc7-849b-946775d65b5e
msgctxt "h16fdca4eg78b7g404egae3dgc3d8e060d3e2"
msgid ""
"He actually stood and <i>fought</i>, the stupid bastard. Like I never "
"trained him better."
msgstr "그 녀석 진짜로 나서서 <i>싸우더라</i>. 미련한 새끼 같으니. 난 절대 그렇게 안 가르쳤는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurerAtCorpses
#. Speaker = Remira
#. NodeID = 3bb23ad7-8494-75c4-8536-1740ad344707
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AdventurersQuest_RaidAdventurerAtCorps_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_AdventurersQuest_RaidAdventurerAtCorps_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurerAtCorpses:3bb23ad7-8494-75c4-8536-1740ad344707
msgctxt "h09a6eed5g7706g4660ga626g00dddc26ee2b"
msgid "I told them to <i>run</i>, the idiots."
msgstr "내가 <i>튀라고</i> 얘기했는데, 이 바보들."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurerAtCorpses
#. Speaker = Remira
#. NodeID = 4f3f7869-c91d-a2ec-d6df-5268af508ccc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurerAtCorpses:4f3f7869-c91d-a2ec-d6df-5268af508ccc
msgctxt "h5ac3188eg8ee5g4699gb16ag96a15f6f01e3"
msgid "You better turn north here, or you'll end up like them."
msgstr "북으로 쭉 가는 게 좋을 거야. 아니면 너도 이 꼴 날 테니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurerAtCorpses
#. Speaker = Remira
#. NodeID = 515b4cbd-378d-5dfd-ade5-20256835b6e9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AdventurersQuest_RaidAdventurerAtCorps_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RaidAdventurerAtCorpses:515b4cbd-378d-5dfd-ade5-20256835b6e9
msgctxt "heda3d8c5g5437g49c7g8e2dgf3988c58d0ba"
msgid "Go on. I'm sure you've got better places to be."
msgstr "가 봐. 어딜 가든 이딴 데보단 훨씬 더 낫겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RobbedAdventurerAtCorpses
#. Speaker = Barth
#. NodeID = 6af9f116-fd5d-0dcb-dc40-cc946a960f3c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AdventurersQuest_RobbedAdventurerAtCorpses_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RobbedAdventurerAtCorpses:6af9f116-fd5d-0dcb-dc40-cc946a960f3c
msgctxt "h3b40f494g9a76g4ff7g9429g1ff8c3110dba"
msgid "You better not linger for too long. Those goblins just aren't normal."
msgstr "여기 오래 있지 않는 편이 좋을걸. 이 고블린들 보통 것들이 아니라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RobbedAdventurerAtCorpses
#. Speaker = Barth
#. NodeID = a5207fe0-3255-6f3c-97b4-64b73d6ce84e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_AdventurersQuest_RobbedAdventurerAtCorpses_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_AdventurersQuest_RobbedAdventurerAtCorpses_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_RobbedAdventurerAtCorpses:a5207fe0-3255-6f3c-97b4-64b73d6ce84e
msgctxt "h71b2c0e4g9e88g41f4gb424g82888e5654b5"
msgid "Damn it. I wish we could at least give them a proper burial."
msgstr "젠장. 장례만이라도 제대로 치뤄줄 수 있다면 좋으련만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_VB_AtCorpses
#. Speaker = Player
#. NodeID = 39fdb397-a8df-d98d-8ffe-83a31092b9de
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_RaidingParty_Quest_ConfrontationResolved = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_VB_AtCorpses:39fdb397-a8df-d98d-8ffe-83a31092b9de
msgctxt "h0d2cd684g880bg4daaga5e7ge4ed72b1e6b2"
msgid "Were they heading to the druids' grove?"
msgstr "드루이드들의 숲으로 향하고 있었던 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_VB_AtCorpses
#. Speaker = Player
#. NodeID = 631e57c4-d396-fc3b-6e86-e0713fd67de0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_VB_AtCorpses:631e57c4-d396-fc3b-6e86-e0713fd67de0
msgctxt "h14bc3e69g8c57g4b50g9a91g9d0a6a381684"
msgid "I wonder where they were going."
msgstr "어디로 향하고 있었던 건지 궁금하군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_VB_AtCorpses
#. Speaker = Player
#. NodeID = be9e8423-d63b-eaa5-e74b-485d2dc061bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_AdventurersQuest_VB_AtCorpses:be9e8423-d63b-eaa5-e74b-485d2dc061bf
msgctxt "h8090391bg20c8g46aaga83cg4e370ee414d8"
msgid "Dead goblins, dead travellers."
msgstr "죽은 고블린에, 죽은 여행자들이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Player
#. NodeID = 0321e041-c575-698b-b039-75cb1618c998
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:0321e041-c575-698b-b039-75cb1618c998
msgctxt "hda709d5eg1c19g4053g8394g08c100b13f3a"
msgid "No, of course not. I ask everyone that question."
msgstr "아니지, 물론 아니야. 나는 모든 사람에게 그 질문을 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Player
#. NodeID = 0422d0a1-9a67-d28d-8e91-8c2232980bf3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Knows_HeardAboutNettie = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:0422d0a1-9a67-d28d-8e91-8c2232980bf3
msgctxt "hd85dc1ecg3f1bg4c6fg94d1gea61a285efd6"
msgid "I need help. Now."
msgstr "나는 도움이 필요해. 당장."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = 07c77a2e-d647-964e-41dd-5b8509604e59
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:07c77a2e-d647-964e-41dd-5b8509604e59
msgctxt "hbb273988g78d7g4b0cgac1fgb1dfd378172d"
msgid "That's... a serious condition."
msgstr "그건... 심각한 상태예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = 07cf6b06-437d-e4cb-18a5-3141cec58cbc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Apprentice_State_Joked(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:07cf6b06-437d-e4cb-18a5-3141cec58cbc
msgctxt "h47424e70g180eg4229gae66g20c2d6a6f6ce"
msgid "How are you doing? Feeling any better?"
msgstr "그래서, 좀 어떠신가요? 기분이 나아지셨나요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Player
#. NodeID = 0ded983a-a943-d694-513e-b20f47270b37
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:0ded983a-a943-d694-513e-b20f47270b37
msgctxt "h55b6d31egd42fg487cg87fagee82fe461c1e"
msgid "Excuse me? I'm more important than some bird."
msgstr "실례하지만 내가 새보다 더 중요한데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = 10b6c239-3076-70fd-7bc6-f05ada99bf2f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:10b6c239-3076-70fd-7bc6-f05ada99bf2f
msgctxt "h2b383a00g807fg406bg8b72gfcd757c58aea"
msgid "A tadpole? A <i>mind flayer </i>tadpole?"
msgstr "올챙이라고요? <i>마인드 플레이어 </i>올챙이?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = 12ec44e8-82c2-6750-24ca-53b8fcffbe7e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:12ec44e8-82c2-6750-24ca-53b8fcffbe7e
msgctxt "h2c51a6f3gac56g4632gbf94g05c40cd58ab1"
msgid "Come here. Let's have a look at you."
msgstr "이리 오세요. 당신을 살펴보도록 하죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = 15f9fd19-2672-35f8-3025-b459c8a25d80
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:15f9fd19-2672-35f8-3025-b459c8a25d80
msgctxt "h4bbf5129g63e2g41e8g8c4dgca4c00bdabea"
msgid "Good enough to tell there's nothing obviously wrong with you."
msgstr "명백한 문제는 없다고 말할 수 있을 정도로 양호하네요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Player
#. NodeID = 166b95aa-70a3-3f54-bec1-fe442b04a3ba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:166b95aa-70a3-3f54-bec1-fe442b04a3ba
msgctxt "h41af7c82g57cdg475agba6ag05d86ad53a94"
msgid "Where did you see another drow?"
msgstr "그 다른 드로우는 어디서 만났지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Player
#. NodeID = 173a8f38-5b9f-207c-1284-88860985f797
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:173a8f38-5b9f-207c-1284-88860985f797
msgctxt "hbd63d3bbg0159g4aeegbc9egcbb713b128f7"
msgid "Enough. I need your abilities."
msgstr "이제 그만. 당신의 능력이 필요해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = 1927fc82-6199-11bf-cdd3-16fa92840bd1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:1927fc82-6199-11bf-cdd3-16fa92840bd1
msgctxt "h882c3c53g11afg4c46ga453g9d41ebd44c8c"
msgid "Crawled in? Some sort of bug or - wait..."
msgstr "기어 들어갔다고요? 벌레 종류거나 - 기다려보세요..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Player
#. NodeID = 1e6bd5b8-2d3c-e84a-ef67-47f7a6764432
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DARK_URGE(1) = True
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_Event_RevealedTadpole(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:1e6bd5b8-2d3c-e84a-ef67-47f7a6764432
msgctxt "heaa6e40egd97eg4886g8d67g0ce9e9536f26"
msgid ""
"Everything about me is sick. The dizzy spells, the memory loss, the illithid "
"parasite..."
msgstr "날 둘러싼 모든 게 거지같아. 어지러운 주문에, 기억 상실, 일리시드 기생충까지…"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Player
#. NodeID = 2189be45-bad7-2600-3d54-7687098523ef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:2189be45-bad7-2600-3d54-7687098523ef
msgctxt "he975f2d7gcf7eg48ebgb327g885a01c7d642"
msgid "What you might 'manage' probably isn't enough. I'll look elsewhere."
msgstr "당신이 '어떻게든' 해줄 수 있는 걸로는 부족해. 다른 사람을 찾아보겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = 261865df-3cae-46ee-119a-3a0bae04484c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:261865df-3cae-46ee-119a-3a0bae04484c
msgctxt "hf6ef6dd8g23ceg492dg8c37gc9786e1f8485"
msgid ""
"I can help if something's wrong. I'm no Master Halsin, but I can manage."
msgstr "무언가가 잘못 되면 제가 도울 수 있어요. 제가 마스터 할신은 아니지만, 제가 시도해볼 수 있습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = 27df5433-5b4f-68d2-111a-01a9ff77a1a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:27df5433-5b4f-68d2-111a-01a9ff77a1a8
msgctxt "had1eaee9gb5a0g4647ga1e7gc5338a279650"
msgid "You and every other soul here."
msgstr "당신 뿐이 아니라 여기 있는 다른 모든 이들이 그렇죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = 28b76b44-b453-a760-3571-5c639b0be947
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:28b76b44-b453-a760-3571-5c639b0be947
msgctxt "hf5809a63g0006g46abgba0dgffaed7008c01"
msgid "No! If you're right..."
msgstr "아니! 당신 말이 맞다면..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = 29e3a646-7015-2b1e-622d-adc53cf434bd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - LOLTHDROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:29e3a646-7015-2b1e-622d-adc53cf434bd
msgctxt "h977489bdg1988g4587g81d3g670539178fd4"
msgid ""
"The last time I saw a drow with red eyes, he tried to slit me open. I'm glad "
"to see you're cut from a different cloth."
msgstr "제가 전에 드로우를 만났을 땐, 붉은 눈빛을 띠고선 절 반으로 갈라버리려고 했죠. 당신은 그런 부류가 아니라 다행이군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = 2f1e51b6-cbff-de36-f067-982a697b08f9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:2f1e51b6-cbff-de36-f067-982a697b08f9
msgctxt "hbd2fd5aaga105g4c5cgaaebgb020797084c1"
msgid "And that's not all they'll do inside your head."
msgstr "그들이 당신 머릿속에서 할 수 있는 일은 그뿐만이 아닙니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = 2f91bd43-a645-0ad2-7152-33d5d302c9d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:2f91bd43-a645-0ad2-7152-33d5d302c9d8
msgctxt "h70b03e47g7cb6g489bg81adgbc1d0490160e"
msgid "All right. Well, come back if you need anything."
msgstr "알겠어요. 무엇이든 필요하면 돌아와요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Player
#. NodeID = 31ac5de7-4d9b-0b74-dc10-a6d8f184d9bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:31ac5de7-4d9b-0b74-dc10-a6d8f184d9bf
msgctxt "h7f927dc3g78d7g4488gaf1bgeb05906c1b21"
msgid "Is there anything I can do to help?"
msgstr "내가 도와줄 수 있는 일이 있을까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = 31ed8bc1-ec57-1747-00f2-7efaea08141c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:31ed8bc1-ec57-1747-00f2-7efaea08141c
msgctxt "h3430cfbbgdccbg4ff6g9a20g5987ffc0fa81"
msgid "<i>Vis medicatrix...</i>"
msgstr "<i>비스 메디카트릭스...</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = 34d31d20-8082-0e49-2071-11690c15f020
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_State_DruidsPacified = True
#.      - DEN_Apprentice_UserShortcut = False
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:34d31d20-8082-0e49-2071-11690c15f020
msgctxt "h55023f76gf91bg4a63g8e36gd2ab346af61c"
msgid ""
"First you save us from goblins, then Kagha's treachery. You're making your "
"mark."
msgstr "처음엔 고블린으로부터 저희를 지켜주시더니, 이젠 카그하의 배신으로부터 구해 주셨군요. 정말 인상적이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = 35bd75d7-35a9-1fe3-77c3-07655fccc7b0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:35bd75d7-35a9-1fe3-77c3-07655fccc7b0
msgctxt "hdb51c449gd13fg411eg9152gf3b8e9928bb4"
msgid "A moment!"
msgstr "잠시만요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = 3650ad7b-91b6-5f21-429a-ce8835f2458f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:3650ad7b-91b6-5f21-429a-ce8835f2458f
msgctxt "hf50435b5geceag4528g9b83g56362c2ca5b8"
msgid "Look, you obviously want something. What is it?"
msgstr "이봐요, 분명 뭔가 명확히 원하시는 게 있는 것 같은데. 그게 뭐죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = 3fefe2ef-87db-8c3d-c802-8b4b44ab3aeb
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_Apprentice_State_ShadowDruidPath(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:3fefe2ef-87db-8c3d-c802-8b4b44ab3aeb
msgctxt "h0963a9bcgae56g4f91ga05dg1ffc8ddacaf9"
msgid "Give me a moment. I'll be right with you."
msgstr "잠시만 기다려주세요. 곧 봐드릴게요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = 418e9d6c-f285-8bdd-250d-945f327f8c33
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:418e9d6c-f285-8bdd-250d-945f327f8c33
msgctxt "h5f500984gc80dg4bbbg8d4cge805fc1b9470"
msgid "I - I'll do what I can."
msgstr "제 - 제가 할 수 있는 걸 해드리죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Player
#. NodeID = 49edc220-7b8e-9229-d268-b1df0f8b6980
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_Event_RevealedTadpole(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:49edc220-7b8e-9229-d268-b1df0f8b6980
msgctxt "h887b7347g5260g479fga6e1g45cc427fceff"
msgid "You know of them? Can you help me?"
msgstr "올챙이에 대해서 알아? 날 도울 수 있나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = 4a1e796a-5867-5936-4049-10d1e29967c7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Apprentice_State_ShadowDruidPath(1) = True
#.   Tag:
#.      - DUERGARDWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:4a1e796a-5867-5936-4049-10d1e29967c7
msgctxt "h042be52ag6fcfg4974gac07gc28cacb6a802"
msgid ""
"So. A grey dwarf. Never thought I'd meet a decent one, but I heard what you "
"did out there."
msgstr "음. 회색 드워프시군요. 그 중 친절한 분을 만나게 될 줄은 몰랐는데, 당신이 밖에서 하신 일은 들었어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = 4bce1224-92bc-d6ac-423e-3c913a023d63
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:4bce1224-92bc-d6ac-423e-3c913a023d63
msgctxt "h4afd623bg6ea6g40e7gb12dgba111a4413f6"
msgid "Then get some rest. There's no better magic."
msgstr "그럼 휴식을 좀 취하세요. 그보다 더 나은 마법은 없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = 4e55894a-0b26-456f-27ec-237458082846
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:4e55894a-0b26-456f-27ec-237458082846
msgctxt "h4852d446g54f4g40cag9abcg18bc4672d070"
msgid "You seem healthy enough. A bit tired 'round the eyes, maybe."
msgstr "당신은 충분히 건강해 보이는데요. 눈이 약간 피곤한 것 같기도 하네요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = 51c286dc-36e8-1ed6-4eef-5757886b7c35
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:51c286dc-36e8-1ed6-4eef-5757886b7c35
msgctxt "hda21aba4g452cg49d9g91b6g5a8e30cc7e8b"
msgid "You found her. But I still don't know what she can do for you."
msgstr "그게 저에요. 하지만 제가 뭘 해드릴 수 있을진 모르겠군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = 5352d7a9-f0eb-7c03-6e44-6ee0d7367367
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:5352d7a9-f0eb-7c03-6e44-6ee0d7367367
msgctxt "h55558bc6ge600g4f68g9cf9g1bd68e9d2de6"
msgid "Suit yourself. I'll be here if you change your mind."
msgstr "마음대로 하세요. 생각이 바뀌신다면, 전 언제나 여기 있답니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Player
#. NodeID = 549bac21-0fad-41ad-8980-316c8dc09342
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:549bac21-0fad-41ad-8980-316c8dc09342
msgctxt "h672d8f52ga2c2g48a3gbc34g49dded97297e"
msgid "I'll take whatever I can get. Heal me."
msgstr "내가 받을 수 있는 건 뭐든지 받겠어. 나를 치료해 줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = 5adbbe13-675d-3796-54e2-c7b6c44aa85c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:5adbbe13-675d-3796-54e2-c7b6c44aa85c
msgctxt "hce5fb060gf430g4d64g85bbg38650f90e82f"
msgid "Tell me honestly: are you infected? Is that why you're asking?"
msgstr "솔직히 말해 보세요. 감염되셨나요? 그래서 저에게 질문하셨나요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = 5b29f5a8-76be-88c9-4658-425b99a2bb20
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - GLO_Tadpole_SUB_Apprentice.ToldAboutTadpole(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:5b29f5a8-76be-88c9-4658-425b99a2bb20
msgctxt "hd7fdad08g8a8dg4cacg8916ga799aa424362"
msgid "Come, follow me. I might be able to help."
msgstr "날 따라와요. 내가 도와줄 수 있을지도 몰라요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = 5c8d569d-bdcd-053e-9868-a05b44f9952f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_Apprentice_HasMet(1) = True
#.   Global:
#.     - DEN_Apprentice_Event_RemoveBirdExhaustion = True
#.     - DEN_Apprentice_UserShortcut = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:5c8d569d-bdcd-053e-9868-a05b44f9952f
msgctxt "he39f2caag92acg4c26g9f46g3577fe89792d"
msgid "There. It's up to her now. Life or death."
msgstr "자. 이제 죽을지 살지는 저 새의 손에 달렸어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = 5e4550a8-ac84-e9e7-fcdd-ea6cf5ced1bc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:5e4550a8-ac84-e9e7-fcdd-ea6cf5ced1bc
msgctxt "h10b638beg8874g4229g89c9g2820ff2adb8d"
msgid ""
"God or fieldmouse, no one's more important than the patient in front of you."
msgstr "신이든 들쥐든, 아무도 제 눈앞에 있는 환자보다 중요하진 않아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = 5f51cae7-b766-35cf-f5b5-083411d44bd5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DUERGARDWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:5f51cae7-b766-35cf-f5b5-083411d44bd5
msgctxt "h182a1103gb222g4fb0ga58agfc04ca7577c2"
msgid "You need something?"
msgstr "필요하신 게 있나요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = 61240644-d9bd-755c-8fd7-7b8799c1bb8a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DUERGARDWARF(1) = False
#.      - DROWELF(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:61240644-d9bd-755c-8fd7-7b8799c1bb8a
msgctxt "h25892948g8f48g4988g9210g9b430966b9ac"
msgid "Now, what was it you needed?"
msgstr "자, 당신이 필요한 것은 무엇인가요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Player
#. NodeID = 64c5948c-61c2-5b67-9549-0952cc2b3756
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:64c5948c-61c2-5b67-9549-0952cc2b3756
msgctxt "h3206e35ag1170g4c04gbc11gaaadc3eddf08"
msgid "Actually, never mind. I'll get help elsewhere."
msgstr "있잖아, 그냥 신경 꺼. 다른 곳에서 도움을 찾지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = 659468f5-5e69-73a5-9c25-5984837c15e7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Apprentice_State_DeadBird = False
#.      - DEN_Apprentice_UserShortcut = False
#.      - DEN_Apprentice_State_PlayerHealedBird = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Apprentice_HasMet(1) = True
#.   Global:
#.     - DEN_Apprentice_Event_RemoveBirdExhaustion = True
#.     - DEN_Apprentice_UserShortcut = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:659468f5-5e69-73a5-9c25-5984837c15e7
msgctxt "hbbc6d97ag3b5eg4238ga66eg53d0e0c0564b"
msgid "She's never looked better! I'm impressed."
msgstr "그녀가 건강해졌군요! 인상적이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Player
#. NodeID = 6c47e506-e6d1-1bec-da4b-c9f3a3201e0a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:6c47e506-e6d1-1bec-da4b-c9f3a3201e0a
msgctxt "he3cc2102g2745g4cc5gba47g3d40f7c9179f"
msgid "Humour my curiosity."
msgstr "내 호기심을 자극해서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Player
#. NodeID = 6ff906b7-3d9e-4c79-0b3d-0b279b27da2a
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:6ff906b7-3d9e-4c79-0b3d-0b279b27da2a
msgctxt "ha4defcf3gf36eg4ef5gb8c2gafc188a9033c"
msgid "Yes. The very same."
msgstr "그렇지. 바로 그거."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Player
#. NodeID = 6ff906b7-3d9e-4c79-0b3d-0b279b27da2a
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:6ff906b7-3d9e-4c79-0b3d-0b279b27da2a
msgctxt "hb43225f4g7b31g4820g8d0egcd4b0e0408cd"
msgid "What other kinds are there? It's not like a frog hopped in my eye."
msgstr "또 어떤 종류가 있지? 개구리가 내 눈에 뛰어든 것 같지는 않은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = 7c046d37-4680-35bb-4c3f-da59c5572457
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:7c046d37-4680-35bb-4c3f-da59c5572457
msgctxt "h4146c52dg166cg4504g8b20gb018e28f5b13"
msgid "I do what I can. For most folks, that's enough."
msgstr "전 제가 할 수 있는 조치를 해요. 대부분의 사람들에게, 그 정도면 충분하거든요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = 7ed4f5f0-3b21-ddc1-e8df-7a61c1c2e33a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:7ed4f5f0-3b21-ddc1-e8df-7a61c1c2e33a
msgctxt "ha6c4d291gd100g4a3bg99c9g215d2a031360"
msgid "...Why are you asking?"
msgstr "...그건 왜 묻는 거죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = 8028d5f2-8068-4905-03c9-e8359bf0d1ea
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Apprentice_State_Joked(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:8028d5f2-8068-4905-03c9-e8359bf0d1ea
msgctxt "hb0844480g4484g4118g8521gd2c82ef10ad5"
msgid "And? Feeling any better?"
msgstr "그래서? 좀 나아지셨나요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = 87dc3f88-7c10-2737-0723-04ed05574396
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Apprentice_State_DeadBird = True
#.      - DEN_Apprentice_UserShortcut = False
#. SetFlags:
#.   Dialog:
#.     - DEN_Apprentice_HasMet(1) = True
#.   Global:
#.     - DEN_Apprentice_UserShortcut = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:87dc3f88-7c10-2737-0723-04ed05574396
msgctxt "h17ac6863ge21fg44fag9312g71b19855cc65"
msgid "Poor thing. She fought as hard as she could."
msgstr "불쌍한 것. 그녀도 최선을 다했어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Player
#. NodeID = 883e95a0-84de-cc68-2eff-94f9342347f4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_Knows_IsFound = False
#.      - GLO_Halsin_Knows_IsMissing = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:883e95a0-84de-cc68-2eff-94f9342347f4
msgctxt "ha1bf55beg6f36g447ag9af9gb2d248e39df0"
msgid "I hear Halsin's the best healer around. I need to find him."
msgstr "할신이 이 근방에서 최고의 치유사라고 들었어. 나는 그를 찾아야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = 89eec670-f108-2d8a-c529-e52555cbb4ae
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_Apprentice_State_Joked(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:89eec670-f108-2d8a-c529-e52555cbb4ae
msgctxt "h4698a51cg17b0g4981g8dc5gd513d5779dfa"
msgid ""
"Take a nip of whiskey before bed if you need to. Come back to me if that "
"doesn't do it."
msgstr "필요하다면 자기 전에 위스키를 한 모금 마셔보세요. 그래도 안 되면 저에게 다시 오세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Player
#. NodeID = 8e562a10-b20d-303e-2432-fc129a140eaf
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Knows_HeardAboutNettie = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:8e562a10-b20d-303e-2432-fc129a140eaf
msgctxt "h7a1d5d90g3414g41a8g94fdga794b276fb55"
msgid "Healing. Looks like I came to the right person."
msgstr "치료. 보아하니 내가 사람을 제대로 찾은 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = 8e96e019-56cf-2a86-69e4-711d6ebfaa1e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:8e96e019-56cf-2a86-69e4-711d6ebfaa1e
msgctxt "habd17452g579eg410fgbbc4g097a1db2f1f9"
msgid "Now, what -"
msgstr "이제, 뭘 -"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Player
#. NodeID = 8fab1b6a-db57-dd67-2dc3-2bdec8c01c59
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Apprentice_Knows_HeardAboutNettie = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:8fab1b6a-db57-dd67-2dc3-2bdec8c01c59
msgctxt "hb5ececfeg6be5g4cb0gb52cg833d6d5eb3d3"
msgid "I'm looking for Nettie."
msgstr "네티를 찾고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Player
#. NodeID = 90d1e0bd-78b4-99e9-2829-f6283d0076b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:90d1e0bd-78b4-99e9-2829-f6283d0076b4
msgctxt "h38817169gded2g4859gac25g23bc18bfe412"
msgid "Right. Yes, I'm... very tired indeed."
msgstr "그래. 나는... 실제로 몹시 피곤해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = 9c589544-146b-f2be-1352-468df3b21824
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DUERGARDWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:9c589544-146b-f2be-1352-468df3b21824
msgctxt "h4bf0de60g8f2ag47abg809eg2fdf0061b73d"
msgid ""
"And you're a grey dwarf. Never thought I'd meet a decent one, but here you "
"stand."
msgstr "그리고 당신은 회색 드워프시군요. 그 중 친절한 분이 있을 줄은 몰랐는데, 당신은 다르시네요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = 9d51598d-bf11-f1e2-7d88-8d243d501429
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:9d51598d-bf11-f1e2-7d88-8d243d501429
msgctxt "ha73be772gc9d5g4792ga970g99be7c92e335"
msgid ""
"Drow. Last time I saw one of you folk, he tried to slit me open. I hope "
"you're more agreeable."
msgstr "드로우시군요. 제가 지난번에 당신 동족을 봤을 땐, 그가 절 반으로 갈라버리려고 했죠. 당신은 다르길 바랄게요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = a9f28ddb-8d4b-f646-7bf6-21ead1442517
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:a9f28ddb-8d4b-f646-7bf6-21ead1442517
msgctxt "h3ba039ddgdc84g4366g892ag395a1e634928"
msgid ""
"I know they're nasty creatures. Can get in your head and convince you up is "
"down."
msgstr "그들이 불쾌한 생물이라는 것은 알아요. 당신의 머리 속에 들어가서 당신에게 위가 아래라고 확신시킬 수 있습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = aac82418-c798-7b8c-0a4c-588ac66c32de
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:aac82418-c798-7b8c-0a4c-588ac66c32de
msgctxt "h862c36a3gffb6g460fg9b3egc5692819874e"
msgid "It's the best any of us can do, I suppose."
msgstr "아마도 이게 우리가 할 수 있는 최선이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = abf6f48b-fe16-0d41-4536-6eedb5975cd6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:abf6f48b-fe16-0d41-4536-6eedb5975cd6
msgctxt "h1863ef0cg6f2cg48e0g9f66gc3e43b8acd69"
msgid ""
"Never knew drow to be the caring kind. In fact, the last drow I saw tried to "
"slit me open. Glad to see you're different."
msgstr ""
"그렇게 친절한 마음씨를 지닌 드로우가 있을 줄은 몰랐네요. 사실은, 전에 봤던 드로우는 절 반으로 갈라버리려고 했거든요. 당신은 달라서 "
"대항이군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Player
#. NodeID = b2256064-f15d-a199-4d69-fc7d6a4d7032
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_Event_RevealedTadpole(1) = True
#. TagRule: REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:b2256064-f15d-a199-4d69-fc7d6a4d7032
msgctxt "h3c1c900agfba6g4318ga2f6g575cb57a501f"
msgid "There is a parasite inside my head. A wriggling <i>ghaik </i>tadpole."
msgstr "내 머릿속에 기생충이 있어. 꿈틀거리는 <i>게이크 </i>올챙이가 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Player
#. NodeID = b2256064-f15d-a199-4d69-fc7d6a4d7032
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_Event_RevealedTadpole(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:b2256064-f15d-a199-4d69-fc7d6a4d7032
msgctxt "h67c86499g788cg412cg9383g40cfc5053bde"
msgid "No good way of putting this. I... uh... have a tadpole in my head."
msgstr "어떻게 말해야 할지 모르겠네. 음... 그러니까... 내 머리에 올챙이가 들어있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Player
#. NodeID = b6e995b9-548e-f8cb-64e5-098a03872bc1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:b6e995b9-548e-f8cb-64e5-098a03872bc1
msgctxt "h1b9de4e3gdf16g4601g8458g80158f4c8f3e"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = b8a5872d-7c9f-b941-de1e-d0d24cddeeb1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Apprentice_UserShortcut = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:b8a5872d-7c9f-b941-de1e-d0d24cddeeb1
msgctxt "h5e09ab7bg21ebg41f1gbaacg28bcda7d3b58"
msgid "I see you. Just give me a moment."
msgstr "당신이 온 건 알고 있습니다. 잠시 기다려주세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Player
#. NodeID = b93c7bda-725e-6460-6b4d-594d4d1e1eb5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:b93c7bda-725e-6460-6b4d-594d4d1e1eb5
msgctxt "h967003e6g779eg4373g8c75g49e1376b1052"
msgid "That depends. How good of a healer are you?"
msgstr "네가 얼마나 유능한 치유사인지에 달렸지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = bba740f3-1691-5070-25c1-669006a038c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:bba740f3-1691-5070-25c1-669006a038c9
msgctxt "hed6a3dc7g3c82g4b98g8c13gfa0407fd6cf0"
msgid "Yes? Discovered some new ache, have you?"
msgstr "네? 새로운 통증이라도 생겼나요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = c1a45d55-c082-8872-78c0-57bf501fb4fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:c1a45d55-c082-8872-78c0-57bf501fb4fe
msgctxt "hb3e06508g057fg4bcag81fag359dce5b4c41"
msgid "There something I can do for you?"
msgstr "뭘 도와드릴까요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = cac0f429-f7ea-3963-381b-a2e06a96a503
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:cac0f429-f7ea-3963-381b-a2e06a96a503
msgctxt "hb3c4efb9gb1ceg4685g9abegf4ca9d97f438"
msgid "A bit tired, maybe. But we're all a bit tired."
msgstr "좀 피곤하신 것일 수도 있어요. 우리 모두 조금씩은 피곤해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = cf872f02-c653-4905-d875-259f5bde3fc2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:cf872f02-c653-4905-d875-259f5bde3fc2
msgctxt "h45bb344bg1720g4d68gae8cg4d4d7306d0a7"
msgid "What can I do for you?"
msgstr "제가 뭘 도와드리면 될까요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = d9467147-4658-f223-a894-224624fedac7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:d9467147-4658-f223-a894-224624fedac7
msgctxt "hef4526c3g6051g4a3dg9d6fg444a1a6953e6"
msgid ""
"Did it look like a tadpole? But from your worst nightmare? All slime, teeth, "
"and tentacles?"
msgstr "올챙이처럼 생겼나요? 그냥 올챙이가 아니라, 가장 끔찍한 악몽에서 나올만한 생김새? 끈적거리고, 이빨에다 촉수까지 난?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = dcb4712d-21ca-0e65-72f8-ee4e6e8e78a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:dcb4712d-21ca-0e65-72f8-ee4e6e8e78a8
msgctxt "he953163fg2579g47adgb21eg4bf837677000"
msgid "Just be glad my bedside manner's better than yours."
msgstr "제 치유사로서의 매너가 당신보다 나은 걸 다행으로 생각하세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = de6a091b-d3d6-8f88-a21b-569b4f71442b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DUERGARDWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:de6a091b-d3d6-8f88-a21b-569b4f71442b
msgctxt "hc5690a3eg7215g4bc2g9f5bg82820aaf99a9"
msgid ""
"A grey dwarf. Never thought I'd meet a decent one, but I heard what you did "
"at the gates."
msgstr "회색 드워프시군요. 그 중 친절한 분을 만나게 될 줄은 몰랐지만, 관문에서 하신 일은 들었어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Player
#. NodeID = e3b91bdc-2853-d1fc-9359-d002b1b42b84
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_Event_RevealedTadpole(1) = True
#. TagRule: REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:e3b91bdc-2853-d1fc-9359-d002b1b42b84
msgctxt "h715ebf1cgd013g49a4gac7fg7c4c9795ca77"
msgid "A <i>ghaik</i> parasite crawled into my eye."
msgstr "<i>게이크</i> 기생충이 내 눈에 기어 들어갔어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Player
#. NodeID = e3b91bdc-2853-d1fc-9359-d002b1b42b84
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_Event_RevealedTadpole(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:e3b91bdc-2853-d1fc-9359-d002b1b42b84
msgctxt "h819eb927gb048g423dg9672gc2802888777a"
msgid "Something crawled into my eye."
msgstr "무언가가 내 눈에 기어 들어갔어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Player
#. NodeID = e6037b20-c1f6-a62b-b76f-b1c73d7e5e8d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:e6037b20-c1f6-a62b-b76f-b1c73d7e5e8d
msgctxt "h46d82187g2b52g48c3g81c3g6d202473c2f6"
msgid "Healing. As soon as possible."
msgstr "치유가 필요해. 최대한 빨리."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Player
#. NodeID = e9b02ea5-2031-3730-0fdd-c245a776aef4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:e9b02ea5-2031-3730-0fdd-c245a776aef4
msgctxt "hcf658946g0f57g455fg9902g6d3608ef35e5"
msgid "<i>Wait patiently.</i>"
msgstr "<i>인내심을 갖고 기다린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = eb44eb3e-8242-d426-c043-bddd783188e3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Apprentice_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_Apprentice_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:eb44eb3e-8242-d426-c043-bddd783188e3
msgctxt "h770f1235g9291g45c3g9591g5f507e15b0bb"
msgid ""
"Heard about your antics at the gate. You look well for someone that took on "
"a troupe of goblins."
msgstr "관문에서 하신 일은 들었어요. 그 많은 고블린을 상대하신 것 치고는 굉장히 멀쩡해 보이시네요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Player
#. NodeID = ebc160a8-79c0-15de-b201-f67b2793bcbf
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_Apprentice_Event_RevealedTadpole(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:ebc160a8-79c0-15de-b201-f67b2793bcbf
msgctxt "h44eb4622g423cg4609gbf37g7afc2e032ef1"
msgid "More than tired. Something crawled into my eye."
msgstr "피곤한 정도가 아니야. 무언가가 내 눈에 기어 들어갔어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Player
#. NodeID = f45ef974-a9d4-f034-31fc-16d59e7411e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:f45ef974-a9d4-f034-31fc-16d59e7411e2
msgctxt "h342f9b4dg813fg420fg9c96g788f5792d6ad"
msgid "Do you know anything about mind flayers?"
msgstr "마인드 플레이어에 대해 아는 것 있어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = f851068f-c3ac-9359-1358-a41d5a3d5884
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_Apprentice_State_ShadowDruidPath(1) = True
#. TagRule: DROWELF or DROWHALFELF
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:f851068f-c3ac-9359-1358-a41d5a3d5884
msgctxt "h45225394g7ea9g4d62gb41cg7329a75cf892"
msgid ""
"So. The last time I saw a drow, he tried to slit me open. I hope you're more "
"agreeable."
msgstr "음. 저번에 드로우를 만났을 땐, 절 반으로 갈라버리려고 했죠. 당신은 다르길 바랄게요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Player
#. NodeID = fa0644f8-8544-efc8-35bd-876de21e3275
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:fa0644f8-8544-efc8-35bd-876de21e3275
msgctxt "h7212ec73gacb5g4a8ega263g9abbcfe784f7"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = fab2edfb-df34-2e5b-b3ad-0c1b4341b8ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:fab2edfb-df34-2e5b-b3ad-0c1b4341b8ea
msgctxt "h6f3eea22g5986g4df2g8566ge7bceb5c99e3"
msgid "Now, what can I do for you?"
msgstr "자, 제가 뭘 해드리면 될까요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = fd1c0534-68f3-1077-2685-b9248d6475e4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Apprentice_UserShortcut = False
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:fd1c0534-68f3-1077-2685-b9248d6475e4
msgctxt "h4b25f914g6b58g4aa5g9e53g55a20ba3135a"
msgid ""
"First you save us from goblins, then you bring Kagha back from the brink. "
"You're making your mark."
msgstr "처음엔 고블린으로부터 저희를 구해 주시고, 이젠 카그하를 그녀의 실수로부터 구해 주셨군요. 정말 인상적이네요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Nettie
#. NodeID = fd6a851c-5b54-64e5-4791-c9cf0f637080
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:fd6a851c-5b54-64e5-4791-c9cf0f637080
msgctxt "h644f63edg6fdcg4e96gbd02g1a215a5459e7"
msgid "That's neither here nor there."
msgstr "상관없는 얘기잖아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice
#. Speaker = Player
#. NodeID = ff3fc5d3-6e72-0493-d721-7508e9b291a7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Apprentice_Knows_HeardAboutNettie = False
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Knows_HeardAboutNettie = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice:ff3fc5d3-6e72-0493-d721-7508e9b291a7
msgctxt "hedd2a99agaf22g4703gba83g41fbbfca54ba"
msgid "Are you good enough to treat people, or just pets?"
msgstr "사람도 치료할 수 있나? 아니면 그냥 동물만 다루는 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD
#. Speaker = Nettie
#. NodeID = 0f412a0c-fb96-1651-485f-4dca47d3d2cb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Apprentice_State_TadpoleSceneDone = True
#.      - DEN_Apprentice_State_NettieMournsHalsin = True
#. SetFlags:
#.   Local:
#.     - 2fb4a271-d5f8-fce1-b64e-a7ba0a3e0830_Node1 = False
#.     - 2fb4a271-d5f8-fce1-b64e-a7ba0a3e0830_Node2 = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD:0f412a0c-fb96-1651-485f-4dca47d3d2cb
msgctxt "h59ea526dg6714g4576g8aacgc0a37450cdbb"
msgid "Halsin would have known what to do. Damn it all."
msgstr "할신이라면 어떻게 해야 할지 알았을 거예요. 젠장."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD
#. Speaker = Nettie
#. NodeID = 319bf5aa-8892-e183-0bf5-8e4118111ed0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 2fb4a271-d5f8-fce1-b64e-a7ba0a3e0830_Node1 = False
#.      - 2fb4a271-d5f8-fce1-b64e-a7ba0a3e0830_Node3 = False
#.      - 2fb4a271-d5f8-fce1-b64e-a7ba0a3e0830_Node2 = False
#. SetFlags:
#.   Local:
#.     - 2fb4a271-d5f8-fce1-b64e-a7ba0a3e0830_Node1 = True
#.     - 2fb4a271-d5f8-fce1-b64e-a7ba0a3e0830_Node3 = False
#.     - 2fb4a271-d5f8-fce1-b64e-a7ba0a3e0830_Node2 = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD:319bf5aa-8892-e183-0bf5-8e4118111ed0
msgctxt "hd6e53317gd304g4df9gbd34gb39c6a517761"
msgid "Still have some mugrot in the stores, but no blueleaf sap."
msgstr "상점에 쑥이 좀 남아있지만, 푸른초 수액은 없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD
#. Speaker = Nettie
#. NodeID = 39e5bb13-3cba-8924-073a-2bddef47f86f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Apprentice_State_TadpoleSceneDone = True
#.      - DEN_Apprentice_State_NettieMournsHalsin = False
#. SetFlags:
#.   Local:
#.     - 2fb4a271-d5f8-fce1-b64e-a7ba0a3e0830_Node1 = False
#.     - 2fb4a271-d5f8-fce1-b64e-a7ba0a3e0830_Node2 = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD:39e5bb13-3cba-8924-073a-2bddef47f86f
msgctxt "h43d0d579ga8e6g4d39ga348g4ec89febffd9"
msgid "What if Halsin is - no. Don't go there."
msgstr "만약 할신이 - 아니야. 거기 가면 안 돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD
#. Speaker = Nettie
#. NodeID = 3bd0c1f9-f501-1029-376f-9e544c88458d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Apprentice_State_TadpoleSceneDone = True
#.   Local:
#.      - 2fb4a271-d5f8-fce1-b64e-a7ba0a3e0830_Node1 = True
#.      - 2fb4a271-d5f8-fce1-b64e-a7ba0a3e0830_Node2 = False
#. SetFlags:
#.   Local:
#.     - 2fb4a271-d5f8-fce1-b64e-a7ba0a3e0830_Node1 = False
#.     - 2fb4a271-d5f8-fce1-b64e-a7ba0a3e0830_Node2 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD:3bd0c1f9-f501-1029-376f-9e544c88458d
msgctxt "h48dae430gdc0dg4eeaga2eagc747b1911b29"
msgid "By Silvanus, I just want my bed."
msgstr "실바누스시여, 전 침소로 가야겠어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD
#. Speaker = Nettie
#. NodeID = 48209c57-5f97-5a2b-5bbf-40af9be3240a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Apprentice_State_TadpoleSceneDone = True
#.   Local:
#.      - 2fb4a271-d5f8-fce1-b64e-a7ba0a3e0830_Node1 = False
#.      - 2fb4a271-d5f8-fce1-b64e-a7ba0a3e0830_Node2 = False
#. SetFlags:
#.   Local:
#.     - 2fb4a271-d5f8-fce1-b64e-a7ba0a3e0830_Node1 = True
#.     - 2fb4a271-d5f8-fce1-b64e-a7ba0a3e0830_Node2 = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD:48209c57-5f97-5a2b-5bbf-40af9be3240a
msgctxt "hfe81c794g5951g48b0gb304g32fbf45cf694"
msgid "Take it one step at a time, Nettie. Come on."
msgstr "한 번에 한 걸음씩 가는 거야, 네티. 힘내자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD
#. Speaker = Nettie
#. NodeID = 59d4e605-5cfd-465b-404f-3fc0964d6d74
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 2fb4a271-d5f8-fce1-b64e-a7ba0a3e0830_Node1 = True
#.      - 2fb4a271-d5f8-fce1-b64e-a7ba0a3e0830_Node3 = False
#.      - 2fb4a271-d5f8-fce1-b64e-a7ba0a3e0830_Node2 = False
#. SetFlags:
#.   Local:
#.     - 2fb4a271-d5f8-fce1-b64e-a7ba0a3e0830_Node1 = False
#.     - 2fb4a271-d5f8-fce1-b64e-a7ba0a3e0830_Node3 = False
#.     - 2fb4a271-d5f8-fce1-b64e-a7ba0a3e0830_Node2 = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD:59d4e605-5cfd-465b-404f-3fc0964d6d74
msgctxt "hfb90390bg95e0g4c8bg91bcg1703d27b7997"
msgid "I'll need more yew leaves before this is over."
msgstr "이걸 끝내려면 주목나무 잎이 더 필요해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Apprentice_AD
