#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_DeadPrisoner_Dead:1c8af136-e122-64f6-4229-0bc71749ec9a
msgctxt "h61245ab2g31d2g4a3dg9479gec22b1df3354"
msgid ""
"Would you like me to craft you a stunning tale? Lock your memory in legend "
"forever?"
msgstr "널 소재로 기막힌 이야기를 만들어줄까? 대대로 기억될 수 있게끔 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_DeadPrisoner_Dead
#. Speaker = Player
#. NodeID = 35839438-eee3-3ac0-f4b4-d9e501133b16
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - CRA_DeadPrisoner_Dead_AskedQuestion(1) = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#. TagRule: CLERIC or PALADIN
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_DeadPrisoner_Dead:35839438-eee3-3ac0-f4b4-d9e501133b16
msgctxt "hacd58c61gae6ag47b4gb43fg62d56bc58527"
msgid "Are there any rites you'd like performed over your body?"
msgstr "네 시신에 의식 같은 거라도 치뤄 줄까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_DeadPrisoner_Dead
#. Speaker = Abducted Nobleman
#. NodeID = 35f73b11-4597-6a71-5bfd-076a7a0c5a82
#. HandlePath = TaggedText[0].TagText[0]
