msgctxt "h9d6c04a9g95d7g4d06ga4a0ge2edbb5e5986"
msgid "Just scraping up some pieces, majesty. Don't mind me."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_ApothecaryGoblins_Goblin_01
#. Speaker = Tracker Slice
#. NodeID = a13a615d-2e45-3463-5f67-11e11af438c3
