#. SetFlags:
#.   Global:
#.     - HAG_Hag_State_SaidGoodbye = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_AD_TeleportSurrogateMother:a135c28f-0812-06f6-af03-5c8977e68058
msgctxt "hed01392bg7adfg4d71ga363g12f9fef110e7"
msgid "Bye-bye, lovelies."
msgstr "잘 가려무나, 사랑스러운 아이들아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead
#. Speaker = Auntie Ethel
#. NodeID = 10c28abe-a7cf-e22a-0480-b6742521f9cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead:10c28abe-a7cf-e22a-0480-b6742521f9cb
msgctxt "ha9ff239dg0738g4869g9cfagc34f21b6c12d"
msgid "I would have gobbled it up and given birth to my very own hag daughter."
msgstr "내가 삼켜버리고 나만의 해그 딸을 낳았을 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead
#. Speaker = Narrator
#. NodeID = 14740286-6a3b-8724-4652-ddab51a59686
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead:14740286-6a3b-8724-4652-ddab51a59686
msgctxt "h5eeb9f23g7bfcg4c99g84efg1da9748b2d5c"
msgid "*The spell's power wanes. You can ask no more questions.*"
msgstr "*주문의 힘이 약해집니다. 더 이상 질문을 할 수 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead
#. Speaker = Player
#. NodeID = 1e67f6ad-1431-8618-f233-967b0d03f4a7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead:1e67f6ad-1431-8618-f233-967b0d03f4a7
msgctxt "h0ece3ee2g895fg40abg90eeg39116b29a582"
msgid "Where do you keep your valuables?"
msgstr "귀중품은 어디다 뒀지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead
#. Speaker = Auntie Ethel
#. NodeID = 2081cefe-6e6c-0371-0936-90b5b8a8d496
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead:2081cefe-6e6c-0371-0936-90b5b8a8d496
msgctxt "h7c6b7833gc4c0g487dg9386ge9a61f444dfd"
msgid ""
"She wanted me to bring him back to life. Little fool thought it would fix "
"everything."
msgstr "내가 남편을 살려내 주길 바랐지. 그 바보 같은 계집은 내가 뭐든 고칠 수 있다고 생각했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead
#. Speaker = Player
#. NodeID = 2547c975-2ab4-98c4-6f91-9aeb8f59be25
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead:2547c975-2ab4-98c4-6f91-9aeb8f59be25
msgctxt "ha6e46d1ag916dg4cb3g8471gf08c3f294931"
msgid "What deal did you make with Mayrina?"
msgstr "메이리나와 어떤 계약을 맺었지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead
#. Speaker = Auntie Ethel
#. NodeID = 2aaa1163-7286-2c77-f37f-052eea857e7e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead:2aaa1163-7286-2c77-f37f-052eea857e7e
#, fuzzy
msgctxt "he19b41e0g1f7ag4bd3ga642g45f9352022e5"
msgid ""
"You think this is the first time? I've found my way back before, and I will "
"again."
msgstr "이게 처음인 것 같아? 난 반드시 돌아올 거다. 맹세하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead
#. Speaker = Player
#. NodeID = 2aaad13d-584c-ac81-cc11-f98b9cda3470
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead:2aaad13d-584c-ac81-cc11-f98b9cda3470
msgctxt "h774d263bg5651g4f08ga5ebg81ee76db2f42"
msgid "Do you have any regrets?"
msgstr "아무런 후회도 없나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead
#. Speaker = Auntie Ethel
#. NodeID = 35228889-9663-5646-2823-1b16020607e9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead:35228889-9663-5646-2823-1b16020607e9
msgctxt "hc46c9e80g08b6g40cbgbb75gbaa70808161d"
msgid ""
"Only that I don't get to see the flesh melt from your bones, your guts "
"dissolve, and your brain <i>liquefy </i>as you turn into a mind flayer."
msgstr ""
"네 살점이 뼈에서 분리되며, 내장이 녹아내리고, 네 뇌가 <i>액체로 변하고는 </i>마침내 마인드 플레이어로 변이하는 모습을 보지 "
"못하는 게 후회될 뿐이란다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead
#. Speaker = Auntie Ethel
#. NodeID = 39c1298b-fde7-9464-f5f2-ff7149bcb485
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead:39c1298b-fde7-9464-f5f2-ff7149bcb485
msgctxt "h7824a077gf3d5g4dd5gb907g5ba85f4b61b4"
msgid "But I won't be a corpse forever - that I can bloody promise you."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead
#. Speaker = Auntie Ethel
#. NodeID = 3b84411a-868f-85ff-383f-70d04a5bad24
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead:3b84411a-868f-85ff-383f-70d04a5bad24
msgctxt "h00b926f4g002fg4c9fgbc47g19ce43872253"
msgid ""
"And then I will make the cretin beg, plead, <i>weep</i> for what will always "
"be denied... "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead
#. Speaker = Auntie Ethel
#. NodeID = 47a12a31-8e69-bc57-bb29-ac8fa94416b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead:47a12a31-8e69-bc57-bb29-ac8fa94416b1
msgctxt "h16d4e03bg6703g4d53g930agc97c1c789aac"
msgid "...The sweet release of death."
msgstr "...달콤한 죽음의 해방."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead
#. Speaker = Auntie Ethel
#. NodeID = 536b111a-6498-3034-9c22-e3c1230bb856
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_Killer(1) = True
#.      - HAG_Hag_State_HasPhylactery(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead:536b111a-6498-3034-9c22-e3c1230bb856
msgctxt "h6fe54613g03b7g4086g9931gb4a276953035"
msgid "Bleed... choke on... your guts..."
msgstr "피를 흘리고... 네 내장에... 질식해..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead
#. Speaker = Auntie Ethel
#. NodeID = 57c304cc-0137-eefc-ff64-15001770624b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead:57c304cc-0137-eefc-ff64-15001770624b
#, fuzzy
msgctxt "h6460f8d3g763bg427bgabf1gf82e3d508c8d"
msgid ""
"You'll butcher your friends and your loved ones LIKE THE ILLITHID SCUM YOU "
"ARE."
msgstr "넌 네가 사랑하는 이들과 친구들을 도살해 버릴 거다. <b>넌 더러운 일리시드 쓰레기니 말이야</b>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead
#. Speaker = Player
#. NodeID = 5c267903-2434-db9d-6856-1ecd8b8b843a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead:5c267903-2434-db9d-6856-1ecd8b8b843a
msgctxt "h491fd46dg4d81g4d50ga810gb80cd1196757"
msgid "Does being dead bother you?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead
#. Speaker = Auntie Ethel
#. NodeID = 5e8a8979-4fde-c0ae-835c-ca3b5c3c1fc7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead:5e8a8979-4fde-c0ae-835c-ca3b5c3c1fc7
msgctxt "hc558c863g5270g4a2bg84c3ge3073471d347"
msgid ""
"Please. It's you lot who come to me. All you do is <i>want</i> - to be "
"prettier, to be richer, to be loved."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead
#. Speaker = Auntie Ethel
#. NodeID = 5fc3ff03-16da-9572-a147-f6787ec9e281
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_Killer(1) = False
#.      - HAG_Hag_State_HasPhylactery(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead:5fc3ff03-16da-9572-a147-f6787ec9e281
msgctxt "ha30e054agca0bg4d03g9d9fg3b13ff125715"
msgid "Kill them... kill them... all..."
msgstr "죽여... 모두... 죽여..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead
#. Speaker = Auntie Ethel
#. NodeID = 640e2fef-ad36-6063-42dc-5eaf16a0c1ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead:640e2fef-ad36-6063-42dc-5eaf16a0c1ad
msgctxt "hf5f799fdg4833g4187g9e68g8688a5948700"
msgid ""
"You'll weep, you'll beg, you'll plead - anything to make it stop.  And once "
"you stand tall, proud and tentacled? "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead
#. Speaker = Player
#. NodeID = 6baa4222-4215-72a8-288d-d8cc1efb0617
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead:6baa4222-4215-72a8-288d-d8cc1efb0617
msgctxt "h47744bb8gd554g4332g95aag93514708b19f"
msgid "You're dead and I'm not. Deal with it."
msgstr "당신은 죽었고 난 아냐. 받아들여."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead
#. Speaker = Auntie Ethel
#. NodeID = 7d412946-d213-7cea-0a77-cf8d121dd040
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead:7d412946-d213-7cea-0a77-cf8d121dd040
msgctxt "h74b6385eg7bc5g4f5ag8b67g49a30dc75584"
msgid "ARGH. Where is the knuckle-dragging gobshite that killed me? "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead
#. Speaker = Auntie Ethel
#. NodeID = 87a90da2-5c7c-3aa9-d595-0f563a9a86c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead:87a90da2-5c7c-3aa9-d595-0f563a9a86c4
msgctxt "h66048d35g8a5ag401dg9b79ga995b2d9acc4"
msgid "And you'll never know."
msgstr "그리고 넌 절대로 모를 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead
#. Speaker = Auntie Ethel
#. NodeID = 90bbc250-d96f-a8c0-72f3-e3df7d0f4052
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead:90bbc250-d96f-a8c0-72f3-e3df7d0f4052
msgctxt "h3bc06196gaae4g45aag8dafg23b6ac58fa64"
msgid "Not me... that's cruel. It's... people."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead
#. Speaker = Player
#. NodeID = 9254fa97-85e5-8dcd-24d1-e01806f1f622
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead:9254fa97-85e5-8dcd-24d1-e01806f1f622
msgctxt "hd2ab67c1gc826g4597gb9dcg3ccaf740094e"
msgid "Why did you want Mayrina?"
msgstr "왜 메이리나를 원한 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead
#. Speaker = Auntie Ethel
#. NodeID = 9ca3c28b-6ea8-0fc8-f086-fb07f0d0bfa2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead:9ca3c28b-6ea8-0fc8-f086-fb07f0d0bfa2
msgctxt "h4cd654abg045bg4129ga4bag0d5a22aa4c90"
msgid "Only one."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead
#. Speaker = Auntie Ethel
#. NodeID = 9dd3c5e8-1874-df2c-50f8-66195d4b2aeb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead:9dd3c5e8-1874-df2c-50f8-66195d4b2aeb
msgctxt "hb74d7b62g7077g400bg9d3eg3bf99a0f0a91"
msgid "Where there's people... there's... hags."
msgstr "사람들이 있는 곳엔... 해그가... 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead
#. Speaker = Player
#. NodeID = a13f5ca8-54ec-6d2c-9363-60b14c1204aa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead:a13f5ca8-54ec-6d2c-9363-60b14c1204aa
msgctxt "h255ea67ag90eeg476bg9f72g738a4a24b0c2"
msgid "Why are you so cruel?"
msgstr "왜 그렇게 잔혹한 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead
#. Speaker = Auntie Ethel
#. NodeID = a14e132a-eaa1-ba40-79b8-a64473e709b2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead:a14e132a-eaa1-ba40-79b8-a64473e709b2
msgctxt "hb41f9305g8713g4b91g903dg3c4612801ea0"
msgid ""
"I'm a <i>hag</i>, you little snot - you think I didn't plan for this? Death "
"and I are old friends."
msgstr "난 <i>해그야</i>, 이 콧물아. 난 죽음을 준비해 뒀단다, <i>계획을 </i>세워뒀지, 네가 태어나기도 전부터 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead
#. Speaker = Narrator
#. NodeID = a23a205e-4efd-a841-20b6-493308ccc616
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead:a23a205e-4efd-a841-20b6-493308ccc616
msgctxt "he72fd2c9g6e63g4ef1g814dga1f7092b3b46"
msgid "*The spell's power wanes. You can ask no more questions.*"
msgstr "*주문의 힘이 약해집니다. 더 이상 질문을 할 수 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Hag_Dead
#. Speaker = Auntie Ethel
