msgctxt "h8cc411edg2ebeg42f8gadd1g88eb2e9dfe0c"
msgid ""
"Sorry - I may have left that a <i>little</i> late. No lasting damage, I hope?"
msgstr "미안해요. 제가 <i>조금</i> 늦은 것 같네요. 지속적인 손상은 없으시죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WarlockProposal_Warlock
#. Speaker = Korrilla
#. NodeID = 7775d8b8-67e9-c0fe-713d-fe30e0387404
#. HandlePath = TaggedText[0].TagText[0]
