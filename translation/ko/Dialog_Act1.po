msgctxt "hc7690b25g60d8g4ec7g8de3g9e98628edc34"
msgid ""
"Smell that meat sizzlin'? Can't tell if it's the brandin' or the party - "
"makin' me bloody 'ungry either way."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_InnerCheckpoint_Backup_03
#. Speaker = Sharp-Eye Gruz
#. NodeID = a2716043-6f37-ad88-1df1-9f978fd21137
