msgctxt "h3b639ba2g1ac8g4301g9657ga3c7803d9ac6"
msgid "I'll peel your balls like potatoes if you don't move!"
msgstr "빨리 안 움직이면 네 불알 껍질을 감자마냥 벗겨줄 거야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarGuardSergeant_AD
#. Speaker = Sergeant Thrinn
#. NodeID = 9f2936ac-2bc8-a4ce-2aa3-ba9236209e43
