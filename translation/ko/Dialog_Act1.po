#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_NoticedPoisoning:b6101f47-0665-f037-031c-3605e3f13f58
msgctxt "h86b6dfbbg38d2g48dfg8489g1c2e95d2a80d"
msgid "This gal's tryin' to poison us! Kill her!"
msgstr "이 년이 우릴 죽이려고 독을 탔다! 죽여!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast_NoticedPoisoning
#. Speaker = GROUP_Act1_GOB_Festivities
#. NodeID = b6101f47-0665-f037-031c-3605e3f13f58
