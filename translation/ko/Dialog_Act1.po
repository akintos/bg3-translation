msgctxt "h99bd30e7gc9a1g4233g99e3g787d6a137b23"
msgid "Movement on the roofs. I sense a classic ambush in the making."
msgstr "지붕 위에 움직임이 있어. 전형적인 매복 작전이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_PAD_SpottedAmbush
#. Speaker = Player
