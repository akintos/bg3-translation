msgctxt "hdd898fceg87e1g4d52gb892g6d6af4c606c1"
msgid "We strike for the Absolute!"
msgstr "우리는 절대자님의 이름 아래 싸운다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_DrowLeaves
#. Speaker = Nightwarden Minthara
#. NodeID = 8f29bbf7-b3e9-88ff-ddd9-be140f43631e
#. HandlePath = TaggedText[0].TagText[0]
