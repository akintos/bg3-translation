msgctxt "h5ff9ca0fg0e1eg4301g8530ge43a7a3a306b"
msgid "Don't you want to know what's inside?"
msgstr "안에 뭐가 들었는지 궁금하지 않아?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_MageHandKid02
#. Speaker = Ra'jak
#. NodeID = 13bdcc91-64fd-81e2-77d4-dd87fb131c08
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
