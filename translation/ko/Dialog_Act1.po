msgctxt "h4298fb94g233dg496ag82d9gacc3643b7bf5"
msgid "*Roar!*"
msgstr "*으르렁!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear
#. Speaker = Player
#. NodeID = 0eb1b6a4-06ff-97ed-20dc-bcce3e567c94
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear:0eb1b6a4-06ff-97ed-20dc-bcce3e567c94
msgctxt "hc931475aga0b5g49d0gb594g62322db35458"
msgid "He's helpless. Let him go."
msgstr "무력한 상태잖아. 풀어줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear
#. Speaker = Player
#. NodeID = 10a1ceee-9a56-1005-8207-28c9f1499033
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_WolfPens_Event_SidedWithGoblins = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear:10a1ceee-9a56-1005-8207-28c9f1499033
msgctxt "h97a9371cg3d2dg460fg8496ge2a7d4025056"
msgid "<i>Attack the bear.</i>"
msgstr "<i>곰을 공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear
#. Speaker = Narrator
#. NodeID = 1ab53902-49ac-6c47-f979-fb74bc06a490
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear:1ab53902-49ac-6c47-f979-fb74bc06a490
msgctxt "h811c1530g753eg427ega2f1g6281b52f90e9"
msgid ""
"*The mark glows, but you feel nothing in response. Your illithid power is "
"beyond reach until you rest.*"
msgstr "*문양이 빛나지만, 어떤 반응도 느껴지지 않습니다. 일리시드 능력을 더 사용하려면 휴식을 취해야 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear
#. Speaker = Player
#. NodeID = 1f167c4b-8164-8d34-a812-062c9ef91ae4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear:1f167c4b-8164-8d34-a812-062c9ef91ae4
msgctxt "haf9ca87dg38deg4578g9b30gec5320cbbf3d"
msgid "Leave him alone!"
msgstr "녀석을 좀 내버려 둬!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear
#. Speaker = Three
#. NodeID = 205786ee-439c-3ae4-b8f8-5ae4b8e1ba98
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear:205786ee-439c-3ae4-b8f8-5ae4b8e1ba98
msgctxt "h20a13652g23a5g4805g824cg1b33d7f9ad79"
msgid "Look, look, you'll see. Gimme that rock. I'll show ya!"
msgstr "봐, 보기만 해, 알게 될 거야. 그 돌 줘봐. 보여줄 테니까!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear
#. Speaker = Player
#. NodeID = 2e53942b-3a66-1fd4-43ef-b107e5736416
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - PALADIN(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear:2e53942b-3a66-1fd4-43ef-b107e5736416
msgctxt "h9d2114beg976eg479ag96e2g20b983ff944e"
msgid "Release the bear immediately or face my wrath!"
msgstr "곰을 당장 풀어주지 않으면 내 분노와 맞서야 할 거다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear
#. Speaker = One
#. NodeID = 35dae024-f22b-caa9-2c08-74005f95c6ef
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear:35dae024-f22b-caa9-2c08-74005f95c6ef
msgctxt "hd82f5e3fg7618g4ae9gaaffg3a1804128070"
msgid "But - but I wanna hear it <i>squeal</i>!"
msgstr "하지만, 하지만... 이 곰이 <i>꽥꽥</i>대는 걸 보고 싶단 말이야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear
#. Speaker = Player
#. NodeID = 37394e07-5d16-9d47-9070-d3ed473726ca
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IMPOSSIBLE = True
#. TagRule: LOLTHDROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear:37394e07-5d16-9d47-9070-d3ed473726ca
msgctxt "h557e0ea9gdb26g48d5g87ccg7af12be9cbeb"
msgid "You <i>dare </i>disobey a drow?"
msgstr "<i>감히</i> 드로우를 거역하겠다는 거냐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear
#. Speaker = Player
#. NodeID = 3ddb52f5-ee0a-11fa-5a91-79fae812f2c8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_WolfPens_Event_SidedWithGoblins = True
#.     - GOB_WolfPens_Event_ThrewRock = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear:3ddb52f5-ee0a-11fa-5a91-79fae812f2c8
msgctxt "hd797fbf4g8cacg4e89gb481gb179cecf172e"
msgid "<i>Throw a rock at the bear.</i>"
msgstr "<i>곰에게 돌을 던진다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear
#. Speaker = Player
#. NodeID = 3e5cb0fa-17b5-b623-7f83-7b1099e3edc5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear:3e5cb0fa-17b5-b623-7f83-7b1099e3edc5
msgctxt "hebcaaaabg8a3dg4b9egb4bdgc601c6e27261"
msgid "Sharper stones might cut through all that fur."
msgstr "저 두꺼운 털을 뚫으려면 더 날카로운 돌을 써야 할걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear
#. Speaker = Player
#. NodeID = 46a286b9-04da-58b1-9c71-69c611fd9e2f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear:46a286b9-04da-58b1-9c71-69c611fd9e2f
msgctxt "h451e7715g4d18g4bd6g87acg5773ab9d53ce"
msgid "Go on, then. Aim for his eye."
msgstr "그럼, 계속해. 놈의 눈을 노려."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear
#. Speaker = Three
#. NodeID = 51cfd355-1724-e0de-d976-cc3c04f911b5
#. HandlePath = TaggedText[0].TagText[0]
