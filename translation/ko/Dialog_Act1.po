msgctxt "hcbdef517g411fg4c72ga443g3d8b7161d4df"
msgid "<i>You?</i> Like crank you did. Lads - attack!"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Trespassing
#. Speaker = Player
#. NodeID = 6cf322c9-21a4-eac1-57b1-45effdd574ed
