#.   Global:
#.     - UND_MyconidDrowDead_Knows_DhournSearchingForge = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_MyconidDrow_Dead:824a278f-6da2-9abc-fbc4-5440a87bc74a
msgctxt "hb5fbf8dag059fg475bg8d64g27760c4b6615"
msgid "Dhourn knows... but cannot tell..."
msgstr "도운이 알고 있지만... 말해 주지는 않을 거야..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_MyconidDrow_Dead
#. Speaker = Player
#. NodeID = 89822a96-3610-d330-6660-c50c8cfb2891
