#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_MyconidDrow_Dead:89822a96-3610-d330-6660-c50c8cfb2891
msgctxt "h2f0417d4g60a4g4af5gb8bagbd4382a9b6a1"
msgid "Where can I find this Dhourn?"
msgstr "이 도운이라는 자를 어디서 찾지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_MyconidDrow_Dead
#. Speaker = Player
#. NodeID = 89e1c01f-7fc3-6dd2-801c-506b38abbcad
