msgctxt "h3464d1aeg4629g4709g9308g451cfa2e5b86"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Dead
#. Speaker = Narrator
#. NodeID = c75aa411-0cde-7305-d135-aeb1671e9a2d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = True
