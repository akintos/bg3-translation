#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Mindflayer_Dead:f95c4870-ad55-ac8d-d0e0-f3e49ffb6f38
msgctxt "heffd03f5gb210g4661g85e6gdaf24e802e89"
msgid "What does the Absolute want from the goblins?"
msgstr "절대자가 고블린을 데리고 뭘 하려는 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying
#. Speaker = Player
#. NodeID = 00078fb1-50df-3efd-6b10-a5519ff998b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying:00078fb1-50df-3efd-6b10-a5519ff998b1
msgctxt "h5608e66cgc0feg439egb7abg4bd76aad5260"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinKing_Scrying
#. Speaker = Narrator
#. NodeID = 0069909d-a0d1-fef8-c48b-2130d7524cbb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 6584fb1a-7ca9-950f-40a6-be0cfdd296f7_ToldCube = True
#. SetFlags:
