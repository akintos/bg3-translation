msgctxt "h3e0ec7b7g19d9g423dg9d79gf89c9c620b46"
msgid "They're right. No one's safe if that thing goes loose."
msgstr "맞는 말이군. 저게 도망이라도 치면 모두가 위험해지겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaeZelRecruitment_TieflingsScene
#. Speaker = Player
#. NodeID = a37c4313-9e1c-0876-a9ab-74f6ad393afc
#. HandlePath = TaggedText[0].TagText[0]
