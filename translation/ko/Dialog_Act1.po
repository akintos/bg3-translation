#.      - GLO_TadpoleIntro_NPC(1) = False
#. SetFlags:
#.   User:
#.     - GLO_TadpoleIntro_NPC(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinSleeper_02:a7490dc6-2bb4-3a07-82eb-6920bdc18299
msgctxt "h594a0787g3317g4ad5g9a39g5c7fb3113a3b"
msgid ""
"*A strange symbol glows, marked on their flesh, and something within you "
"stirs in response.*"
msgstr "*그들의 살갗에 새겨진 기묘한 상징이 빛나고, 이에 반응하여 당신 내면의 무언가가 꿈틀거립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinSleeper_02
#. Speaker = Booyahg Culk
#. NodeID = ae6269f9-f985-0403-9e61-cadb58f7fa98
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Festivities_GoblinSleeper02_HasMet(1) = True
#.      - GOB_Festivities_GoblinSleeper_02_TrueSoulCommand(1) = True
#.   Object:
#.      - GOB_Festivities_Sleeper_WokenByNoise(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinSleeper_02:ae6269f9-f985-0403-9e61-cadb58f7fa98
msgctxt "h1d98c82bg7e19g488dg8036g0d137d54a16f"
msgid "Can't you go be a True Soul somewhere else?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinSleeper_02
