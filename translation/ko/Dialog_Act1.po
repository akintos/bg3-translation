msgid "Ugh. It's too heavy!"
msgstr "윽. 너무 무거워!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_PAD_TooHeavy
#. Speaker = Player
