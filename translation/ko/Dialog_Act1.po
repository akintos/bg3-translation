msgctxt "h941e8f7dgc9b1g4f2dg8ae4g3f411f4aa11f"
msgid "<i>Run</i>..."
msgstr "<i>도망쳐</i>..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_005_Dead
#. Speaker = Player
#. NodeID = f071b915-35f4-816b-6896-9e987e1a6261
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 7256657b-1386-989f-0262-c6530e03a9fb_AskedWhy = True
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_005_Dead:f071b915-35f4-816b-6896-9e987e1a6261
msgctxt "hfea5a352g0d84g4482gb358g80ba01a0efd3"
msgid "What can you tell me about Ethel?"
msgstr "에텔에 대해 뭘 알려줄 수 있지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_Victim_005_Dead
#. Speaker = Narrator
#. NodeID = f7773c93-cfb5-c442-2ff4-160da9b04a74
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
