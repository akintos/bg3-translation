#, fuzzy
msgctxt "ha10f3ff5g7f40g43bbgb17bg8376a6a046bf"
msgid "Sir."
msgstr "선생님."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_InnerCheckpoint_Backup_03
#. Speaker = Sharp-Eye Gruz
#. NodeID = a2716043-6f37-ad88-1df1-9f978fd21137
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_InnerCheckpoint_Backup_03:a2716043-6f37-ad88-1df1-9f978fd21137
msgctxt "hbeec8d6egd36bg4288gaebcg59ae8835d668"
msgid "True Soul."
msgstr "참된 영혼이시여."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_InnerCheckpoint_Backup_03
#. Speaker = Sharp-Eye Gruz
#. NodeID = b092337f-52a5-9f3a-a56a-89c07daa5a21
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_InnerCheckpoint_Backup_03_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_InnerCheckpoint_Backup_03:b092337f-52a5-9f3a-a56a-89c07daa5a21
msgctxt "ha003f22fga6cdg49b3g8427g511f81cc84d8"
msgid "What're you doin' up here anyway? Countin' spider webs? C'mon, get off."
msgstr "애초에 여기서 뭘 하고 있는 거야? 거미줄 세나? 당장 꺼져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_InnerCheckpoint_Backup_03
#. Speaker = Sharp-Eye Gruz
#. NodeID = fd6cd56c-31fd-a71d-e845-131b0bfceb2d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_InnerCheckpoint_Backup_03_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_InnerCheckpoint_Backup_03:fd6cd56c-31fd-a71d-e845-131b0bfceb2d
msgctxt "h40c173bdg411cg4a9aga83bgfa55215fdcd9"
msgid "This ain't the party, mate - no foolin' around. Get back down."
msgstr "파티하고 있는 거 아니야 멍청아, 장난 그만 치고 내려가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_InnerCheckpoint_Backup_04
#. Speaker = Sharp-Eye Nozk
#. NodeID = 36e5d83c-d17a-4af2-e625-f3a93a361f6b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_InnerCheckpoint_Backup_04_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_InnerCheckpoint_Backup_04:36e5d83c-d17a-4af2-e625-f3a93a361f6b
msgctxt "ha0fc93b2g0c6ag463fg8b4fgd328e7ba8b61"
msgid "You outsiders never have ta guard the borin' posts."
msgstr "너 같은 이방인 녀석들은 지루해 죽겠는 진지들을 지키지 않아도 되잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_InnerCheckpoint_Backup_04
#. Speaker = Sharp-Eye Nozk
#. NodeID = 5b7cbd78-52e9-fe6d-3940-a8f5c7be616c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_InnerCheckpoint_Backup_04_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_InnerCheckpoint_Backup_04:5b7cbd78-52e9-fe6d-3940-a8f5c7be616c
msgctxt "he4db0ae2gf4fdg4da2gb9c4g21eaa152153c"
msgid ""
"Thought you was my replacement, but noooo. Bet Mirg has drunk herself stupid."
msgstr "내 교체 인원인 줄 알았더니, 아뉘잖아아아. 미그 자식 잔뜩 취했나 보네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NGB_SpiderNest_CustomCrime
#. Speaker = Narrator
#. NodeID = 1ccdbbf0-1c11-4245-a9b8-1ffb05ae7a66
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NGB_SpiderNest_CustomCrime:1ccdbbf0-1c11-4245-a9b8-1ffb05ae7a66
msgctxt "h664226cfg63beg43e9g8156g9fe1bc4c9ce6"
msgid ""
"*The goblins appear rather attached to their prisoners. Best not brutalise "
"any more of them.*"
msgstr "*고블린들이 그들의 포로를 아끼는 것 같습니다. 더 이상 그들을 괴롭히지 않는 것이 좋을 것 같습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NGB_TortureredAdventurer_AssaultCustom
#. Speaker = Narrator
#. NodeID = 00ab14bd-7658-459a-9598-ba7643eb02d9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Torturers_State_KnowDen = False
#.      - GOB_Torturers_State_PrisonerDied = False
#. SetFlags:
#.   Dialog:
#.     - GOB_GEB_TorturedAdventurer_Assault_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NGB_TortureredAdventurer_AssaultCustom:00ab14bd-7658-459a-9598-ba7643eb02d9
msgctxt "hf96a8e0age7c1g4840g9d86g57124dfa1852"
msgid ""
"*The goblin appears annoyed. It might be best to leave the prisoner alone.*"
msgstr "*고블린이 귀찮아하는 것 같습니다. 포로를 그냥 내버려 두는 편이 좋을지도 모릅니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NGB_TortureredAdventurer_AssaultCustom
#. Speaker = Narrator
#. NodeID = 0a9ad7ae-3bcf-46e9-92af-806fa7a487d2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Torturers_State_KnowDen = False
#.      - GOB_Torturers_State_PrisonerDied = True
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NGB_TortureredAdventurer_AssaultCustom:0a9ad7ae-3bcf-46e9-92af-806fa7a487d2
msgctxt "h784e8bedgc6a2g45c3g9dc0g93f3a060a365"
msgid ""
"*It seems the prisoner you killed was rather valuable. Now the price is on "
"your head.*"
msgstr "*당신이 죽여버린 포로가 꽤 중요한 인물이었던 것 같습니다. 이제 당신 목에 그 비용이 걸렸습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NGB_TortureredAdventurer_AssaultCustom
#. Speaker = Narrator
#. NodeID = 8a6f7e9c-8913-bfe8-cc56-7be3d48fc13f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Torturers_State_KnowDen = False
#.      - GOB_Torturers_State_PrisonerDied = False
#.   Tag:
#.      - DROWELF(1) = True
#. SetFlags:
#.   Dialog:
#.     - GOB_GEB_TorturedAdventurer_Assault_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NGB_TortureredAdventurer_AssaultCustom:8a6f7e9c-8913-bfe8-cc56-7be3d48fc13f
msgctxt "h677ac9fbg5cbag4034g8324g507ba0e1ccec"
msgid ""
"*The goblin is uneasy. Drow or not, you aren't supposed to be interfering "
"with the prisoner.*"
msgstr "*고블린이 불편해합니다. 드로우든 아니든, 포로에 관여할 권한은 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NGB_TortureredAdventurer_AssaultCustom
#. Speaker = Narrator
#. NodeID = c3376e59-4783-d792-0d5b-20147d09d7a1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_GEB_TorturedAdventurer_Assault_HasMet(1) = True
#.   Global:
#.      - GOB_Torturers_State_KnowDen = False
#.      - GOB_Torturers_State_PrisonerDied = False
#.   Tag:
#.      - DROWELF(1) = True
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NGB_TortureredAdventurer_AssaultCustom:c3376e59-4783-d792-0d5b-20147d09d7a1
msgctxt "h59cfd284g8896g436bga4b7gcbef7d9d2abf"
msgid ""
"*You sense you've gone too far. Deference to your kind won't dissuade this "
"goblin from killing you.*"
msgstr "*너무 멀리 갔다는 사실이 떠오릅니다. 당신의 종족을 존중한다고 해서 고블린이 당신을 죽이지 않을 이유는 없습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NGB_TortureredAdventurer_AssaultCustom
#. Speaker = Narrator
#. NodeID = fb1b7f51-4cac-5f81-31c9-02d9e4f95d58
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_GEB_TorturedAdventurer_Assault_HasMet(1) = True
#.   Global:
#.      - GOB_Torturers_State_KnowDen = False
#.      - GOB_Torturers_State_PrisonerDied = False
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NGB_TortureredAdventurer_AssaultCustom:fb1b7f51-4cac-5f81-31c9-02d9e4f95d58
msgctxt "h0de5bf43g4752g4a8bga297g17ab424a252d"
msgid ""
"*It seems the goblin is no longer content to let you have your fun. This "
"might get messy.*"
msgstr "*보아하니 고블린들이 더 이상 당신이 재미를 보게 두지 않을 것 같습니다. 상황이 지저분해질지도 모르겠군요.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Narrator
#. NodeID = 02c308d1-05cd-d058-7fa1-b31a9626a7fe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount4(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount4(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:02c308d1-05cd-d058-7fa1-b31a9626a7fe
msgctxt "hbba8b4a2ge3dbg4119ga3a3g24261c89fafc"
msgid ""
"*A shadow swims across your vision, and a familiar voice tells you to be "
"calm. You are loved.*"
msgstr "*그림자가 낀 듯이 눈앞이 흐려지더니, 익숙한 목소리가 당신을 달래줍니다. 사랑이 느껴집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Booyahg Piddle
#. NodeID = 03738446-ebc0-818e-4945-7d156741ca58
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:03738446-ebc0-818e-4945-7d156741ca58
msgctxt "hd0fbe08eg1fbeg4065ga758g69822d563640"
msgid ""
"He wanted to know if we felt any extra <i>booyahg</i> in the air since "
"convertin'."
msgstr "녀석은 우리가 개종한 이후로 <i>부야그</i>를 더 많이 느꼈는지 알고 싶어했지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Booyahg Piddle
#. NodeID = 075e02c5-9383-64d8-de7f-f4f37bc4a086
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_VoloBallad_State_OnStage = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:075e02c5-9383-64d8-de7f-f4f37bc4a086
msgctxt "h2ffc5b95gbd52g49e2g854egd45b72c9fb74"
msgid "... that's 'im, at the party, warblin' away."
msgstr "... 저기 있네. 잔치에. 지저귀는 거 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Narrator
#. NodeID = 0a466f4b-fdb0-1789-3b71-7d9df96f8ad7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_TadpoledCount1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:0a466f4b-fdb0-1789-3b71-7d9df96f8ad7
msgctxt "h86ae646fgc9fdg4a96gba3fg744798857f00"
msgid "*A shiver runs across your mind... You feel sated.*"
msgstr "*전율이 불현듯 머릿속을 스쳐 지나가고... 만족감이 듭니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Player
#. NodeID = 0f2cfb6b-c207-e707-ee38-de859fe0ee31
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:0f2cfb6b-c207-e707-ee38-de859fe0ee31
msgctxt "he9e012c4gbac9g46cdg93d8g5ee43ee36d08"
msgid "Where did you find that?"
msgstr "그건 어디서 찾았어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Player
#. NodeID = 12db7f95-077d-ede4-0242-31d73c36f588
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - HALFORC(1) = True
#.   UserShape:
#.      - GOB_NerdyGoblinSage_State_TriedPersuasion(1) = False
#. SetFlags:
#.   UserShape:
#.     - GOB_NerdyGoblinSage_State_TriedPersuasion(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage:12db7f95-077d-ede4-0242-31d73c36f588
msgctxt "h2a513f07g2e2bg4473ga1cegfc1ddf963755"
msgid "Your lifetime gets shorter every second you keep that book."
msgstr "네 그 평생이란 건 그 책을 가지고 있을수록 점점 줄어들고 있다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_NerdyGoblinSage
#. Speaker = Player
#. NodeID = 133e8412-7842-e589-562f-3cbb05bb4157
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
