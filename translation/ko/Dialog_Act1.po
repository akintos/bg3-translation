#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03_AD_ArtCritics:afc1379f-35ba-19cd-392c-f6ec83b0b422
msgctxt "hce602375g0901g44ecg85a1g4ed08dc8d379"
msgid "Don't just paint faces. People got other parts, too."
msgstr "그냥 얼굴만 그리지는 마. 사람한테는 다른 부위도 있다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03_AD_ArtCritics
#. Speaker = Brem
#. NodeID = db0731c1-e474-ba07-a278-31bf439d9b4a
