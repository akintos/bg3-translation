msgctxt "h36907145gf4fbg436agbb9dg0977d1b7a5aa"
msgid "Boss's thinkin' of servin' it to the worgs."
msgstr "대장은 놈을 워그 먹이로 줄 생각이던데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear
