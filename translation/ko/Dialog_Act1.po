msgctxt "h24a3caadg9565g4810g9bfbg949994a581c2"
msgid "<i>Get rid of them.</i>"
msgstr "<i>놈들을 없애.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaezelRecruitment_TieflingsSceneFallback
#. Speaker = Lae'zel
#. NodeID = 540da906-3976-4c7a-916b-fc82d291db02
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaezelRecruitment_TieflingsSceneFallback:540da906-3976-4c7a-916b-fc82d291db02
msgctxt "hfeb3c540g0be9g4ec1ga26egb4498f02eab5"
msgid "<i>Enough gawking - get me down.</i>"
msgstr "<i>그만 쳐다보고 내려 주기나 해.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Chapel/CHA_LaezelRecruitment_TieflingsSceneFallback
#. Speaker = Lae'zel
#. NodeID = 8573316b-9cf8-4dee-901c-7749a0c38351
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
