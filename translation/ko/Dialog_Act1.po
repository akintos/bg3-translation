msgctxt "h7909ef3cg1e55g4eadga815g34d04ab14c06"
msgid "*Like its living counterparts, the corpse speaks in your mind.*"
msgstr "*시체는 그것의 살아있는 동족과 마찬가지로, 당신의 머릿속에서 말을 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DeadMyconid_Dead
