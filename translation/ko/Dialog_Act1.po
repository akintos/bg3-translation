msgctxt "hb79bed97gfcd3g4c96g8e8eg00e0273f9416"
msgid "Defend the hatchery - kill the intruders!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_AD_TeletrapTriggered
#. Speaker = Warrior Vu'un
#. NodeID = ce5ba7ee-d0c0-4ce8-b52a-dd59a7c46b5e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = False
#. SetFlags:
#.   Global:
#.     - CRE_Hatchery_State_HatcheryHostile = True
#.     - CRE_Hatchery_HasTriggeredTeleTrap = True
#: Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_AD_TeletrapTriggered:ce5ba7ee-d0c0-4ce8-b52a-dd59a7c46b5e
msgctxt "h24620ff2ga505g4530gaf73g4ae9e614c69e"
msgid "Intruders! You will regret defiling this place."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/LowerCreche/CRE_Hatchery_AD_TeletrapTriggered
#. Speaker = Warrior Vu'un
#. NodeID = f3cdb265-4ee0-43dc-9b6d-b78d9e404ea7
