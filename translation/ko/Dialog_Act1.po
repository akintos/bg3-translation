msgctxt "h893ea39ag74b9g4a35gb760gc3d3198ffaa5"
msgid "Lovely beat, that, True Soul. Just lovely."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_AlarmUsedReaction
#. Speaker = Sentinel Olak
#. NodeID = 773deb47-364c-7f4e-5cb5-9ad5b81b6512
