msgctxt "hd9000a65gcb93g43d2gaaa6g386b0eade04e"
msgid "Uuurghh... okay."
msgstr "우우우... 알았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_ElevatorBear
#. Speaker = Player
#. NodeID = b496cc2c-299b-d614-56a4-30c73b2952aa
#. HandlePath = TaggedText[0].TagText[0]
