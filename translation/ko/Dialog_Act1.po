#. Speaker = Player
#. NodeID = de7d8f43-6014-91f6-b6bd-03336709ce92
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentDungeon_Quest_AgentsMissing = False
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = False
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PreciousCargo_PAD:de7d8f43-6014-91f6-b6bd-03336709ce92
msgctxt "h58a54ca9g6a35g4340ga13cgfd1a96d1da7a"
msgid "That's no common travelling chest. Might be worth a peek inside..."
msgstr "흔한 여행용 상자가 아니야. 열어서 한 번 봐볼 만한 가치가 있을지도..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PreciousCargo_PAD
#. Speaker = Player
#. NodeID = de7d8f43-6014-91f6-b6bd-03336709ce92
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentDungeon_Quest_AgentsMissing = False
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = False
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PreciousCargo_PAD:de7d8f43-6014-91f6-b6bd-03336709ce92
msgctxt "h38ede47agd65dg4dcfga7bbg8f0f55418705"
msgid ""
"Now that's what I call a chest. More than just a few trinkets in there, I "
"wager."
msgstr "저 정도는 돼야 귀중품 담는 상자라 할 수 있지. 싸구려 물건 몇 개보다 귀한 것이 담겨있을 거야, 보증할게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PreciousCargo_PAD
#. Speaker = Player
#. NodeID = de7d8f43-6014-91f6-b6bd-03336709ce92
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentDungeon_Quest_AgentsMissing = False
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = False
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PreciousCargo_PAD:de7d8f43-6014-91f6-b6bd-03336709ce92
msgctxt "h1c581b79g3a94g4456gbd1cgff906eadbd9a"
msgid "Bet there's something impressive in there."
msgstr "그 안에 뭔가 멋진 게 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PreciousCargo_PAD
#. Speaker = Player
#. NodeID = de7d8f43-6014-91f6-b6bd-03336709ce92
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentDungeon_Quest_AgentsMissing = False
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = False
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PreciousCargo_PAD:de7d8f43-6014-91f6-b6bd-03336709ce92
msgctxt "h817a7616g1c4cg486ega28ag3989e7959aa2"
msgid ""
"Chests like that don't hold trinkets. There must be something valuable "
"inside."
msgstr "싸구려 물건이나 담는 상자가 아니야. 가치 있는 뭔가가 담긴 게 분명해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PreciousCargo_PAD
#. Speaker = Player
#. NodeID = e7cb2aee-0a71-e5b3-4f74-de6f7b8a5059
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentDungeon_Quest_AgentsMissing = True
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = False
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PreciousCargo_PAD:e7cb2aee-0a71-e5b3-4f74-de6f7b8a5059
msgctxt "h619a13c9g4370g474dgaac3g6b7a291abc63"
msgid "Zarys' chest? I bet it holds all sorts of treasures."
msgstr "자리스의 상자? 분명 온갖 종류의 보물이 들어있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PreciousCargo_PAD
#. Speaker = Player
#. NodeID = e7cb2aee-0a71-e5b3-4f74-de6f7b8a5059
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentDungeon_Quest_AgentsMissing = True
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = False
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PreciousCargo_PAD:e7cb2aee-0a71-e5b3-4f74-de6f7b8a5059
msgctxt "h85445dc5gb842g405dga366g79f39d31f288"
msgid "Zarys was looking for this chest. Whatever it holds must be valuable."
msgstr "자리스가 찾고 있는 상자다. 뭐가 들어있든 분명 값진 것일 거다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PreciousCargo_PAD
#. Speaker = Player
#. NodeID = e7cb2aee-0a71-e5b3-4f74-de6f7b8a5059
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentDungeon_Quest_AgentsMissing = True
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = False
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PreciousCargo_PAD:e7cb2aee-0a71-e5b3-4f74-de6f7b8a5059
msgctxt "h4a4f6290g04ecg4ac3g98daga333052eb7ca"
msgid ""
"They did not want to part with that chest. And their boss promised good coin "
"if it stays locked."
msgstr "이 상자랑 헤어지기 싫었을 거야. 그래서 잠긴 상태로 가져다주면, 젠타림 대장이 거액을 준다고 약속한 거겠지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PreciousCargo_PAD
#. Speaker = Player
#. NodeID = e7cb2aee-0a71-e5b3-4f74-de6f7b8a5059
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentDungeon_Quest_AgentsMissing = True
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = False
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PreciousCargo_PAD:e7cb2aee-0a71-e5b3-4f74-de6f7b8a5059
msgctxt "h25c8da51gd382g4d16gbd5bgb7f1e90a8e71"
msgid ""
"The chest Zarys sought. I wonder what its safe return is worth to her..."
msgstr "자리스가 찾던 상자야. 뭐가 들어있길래 온전히 가져다 달라고 했을까..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PreciousCargo_PAD
#. Speaker = Player
#. NodeID = e7cb2aee-0a71-e5b3-4f74-de6f7b8a5059
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentDungeon_Quest_AgentsMissing = True
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = False
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PreciousCargo_PAD:e7cb2aee-0a71-e5b3-4f74-de6f7b8a5059
msgctxt "h95924593g0d22g4072gb781g6e3fdb59e8a8"
msgid "Zarys' chest. Must be worth a good bit."
msgstr "자리스의 상자야. 분명 꽤 가치 있는 것일 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PreciousCargo_PAD
#. Speaker = Player
#. NodeID = e7cb2aee-0a71-e5b3-4f74-de6f7b8a5059
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentDungeon_Quest_AgentsMissing = True
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = False
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PreciousCargo_PAD:e7cb2aee-0a71-e5b3-4f74-de6f7b8a5059
msgctxt "h237ba0a2g76beg4969gbb87gbfd772c547a3"
msgid ""
"The chest Zarys sought, if I'm not mistaken. What treasures is it hiding?"
msgstr "내가 착각한 게 아니라면, 이건 자리스가 찾던 상자야. 여기에 어떤 보물이 숨겨져 있을까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PreciousCargo_PAD
#. Speaker = Player
#. NodeID = e7cb2aee-0a71-e5b3-4f74-de6f7b8a5059
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_ZhentDungeon_Quest_AgentsMissing = True
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = False
#. TagRule: REALLY_GENERIC
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PreciousCargo_PAD:e7cb2aee-0a71-e5b3-4f74-de6f7b8a5059
msgctxt "hbb8d11deg02d8g4d18ga4bfgb64aabc9c513"
msgid ""
"The chest's clearly worth a lot to the Zhentarim, <i>if </i>it's returned "
"unopened."
msgstr "이 상자는 분명 젠타림에게 큰 가치가 있을 거야, 열지 않고 돌려줬을 <i>때</i> 얘기지만."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PreciousCargo_PAD
#. Speaker = Player
#. NodeID = eda2350a-74e9-aa3b-e6e0-97001ae7fdd6
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PreciousCargo_PAD:eda2350a-74e9-aa3b-e6e0-97001ae7fdd6
msgctxt "h11040972g4274g4482g962cg4e34f32bede1"
msgid "We could always return it. Or maybe..."
msgstr "언제든 돌려줄 수 있지. 아니면..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PreciousCargo_PAD
#. Speaker = Player
#. NodeID = eda2350a-74e9-aa3b-e6e0-97001ae7fdd6
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PreciousCargo_PAD:eda2350a-74e9-aa3b-e6e0-97001ae7fdd6
msgctxt "hbc9e7cc8gef75g49b5g9439g02061ba99886"
msgid "Well, I see no reason to return it. Let's see what's inside."
msgstr "글쎄, 돌려줘야 할 이유를 모르겠군. 뭐가 들어 있는지 보자."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PreciousCargo_PAD
#. Speaker = Player
#. NodeID = eda2350a-74e9-aa3b-e6e0-97001ae7fdd6
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PreciousCargo_PAD:eda2350a-74e9-aa3b-e6e0-97001ae7fdd6
msgctxt "hf69f67a9g0c02g4cddgba2agccb07e6a0faa"
msgid ""
"Yes, but why tell us not to open it unless there's something very good "
"inside?"
msgstr "맞아. 하지만 뭔가 엄청 좋은 게 들어있으니 열어보지 말라고 한 거 아니겠어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PreciousCargo_PAD
#. Speaker = Player
#. NodeID = eda2350a-74e9-aa3b-e6e0-97001ae7fdd6
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PreciousCargo_PAD:eda2350a-74e9-aa3b-e6e0-97001ae7fdd6
msgctxt "h66a214ddg9703g44d9gb395g05b87c247577"
msgid "Whatever's inside belongs to us now."
msgstr "뭐가 들어있든지 이젠 우리 소유야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PreciousCargo_PAD
#. Speaker = Player
#. NodeID = eda2350a-74e9-aa3b-e6e0-97001ae7fdd6
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PreciousCargo_PAD:eda2350a-74e9-aa3b-e6e0-97001ae7fdd6
msgctxt "h74122d3dgf65dg49ceg8770gf8b8a5a652e4"
msgid "May as well crack it open, right?"
msgstr "그냥 따서 열어보는 게 좋을 거 같은데, 안 그래?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PreciousCargo_PAD
#. Speaker = Player
#. NodeID = eda2350a-74e9-aa3b-e6e0-97001ae7fdd6
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PreciousCargo_PAD:eda2350a-74e9-aa3b-e6e0-97001ae7fdd6
msgctxt "h912e60c3g1d6fg4529gb936g01b05ef53bb6"
msgid ""
"Only one way to find out. Unless we plan to ask the Zhentarim for a shipping "
"manifest."
msgstr "알아낼 방법은 하나뿐이야. 젠타림에게 화물 목록이 뭔지 물어볼 계획이 아니라면 말이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PreciousCargo_PAD
#. Speaker = Player
#. NodeID = eda2350a-74e9-aa3b-e6e0-97001ae7fdd6
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_GENERIC
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PreciousCargo_PAD:eda2350a-74e9-aa3b-e6e0-97001ae7fdd6
msgctxt "hfc35f59eg478ag4670ga84fge526dc5feb89"
msgid "It's our chest now. We can do whatever we want with it."
msgstr "이 상자는 이제 우리 거야. 하고 싶은 대로 할 수 있다고."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = 013f3272-4be9-4d04-af91-04401fb6663e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_KarlachRecruitmentTollhouse_Quest_LookingForKarlach = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:013f3272-4be9-4d04-af91-04401fb6663e
msgctxt "h26d9a082gc606g402fga0d3g45afda547fe8"
msgid "But she's still alive? We need her head."
msgstr "그 여자가 아직 살아 있다니? 우린 그 여자의 머리가 필요하오."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = 02c81920-abcb-ab47-700a-9be4ee9d07c9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:02c81920-abcb-ab47-700a-9be4ee9d07c9
msgctxt "hc1024af4gcf8cg4da3gb2dcgeae228bdc1fe"
msgid ""
"It's all I have, but it's yours if you stop her. Bring me her head, and Tyr "
"will consider her crimes repaid."
msgstr ""
"이건 내가 가진 전부지만, 당신이 그녀를 막는다면 당신 것이 될 거요. 그 여자의 머리를 가져오면 티르께서는 그녀가 죄값을 치른 걸로 "
"여기실 것이오."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = 05a9c1c2-273c-77c1-e75c-9c0902c226d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:05a9c1c2-273c-77c1-e75c-9c0902c226d0
msgctxt "h8d21d273gcf23g45b7g8396g2e0f83a1671d"
msgid ""
"She's slaughtered countless refugees fleeing the Absolute. Yesterday, she "
"butchered an entire family. We were lucky to survive our encounter with her."
msgstr ""
"그 여자는 절대자를 피해 도망치는 수많은 피난민을 살육했소. 어제는 일가족을 도륙냈지. 우리가 그 여자를 만나고도 살아남은 건 운이 "
"좋아서요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Player
#. NodeID = 062cda82-60af-4134-8947-4292c397af57
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Karlach_HasMet = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:062cda82-60af-4134-8947-4292c397af57
msgctxt "h4ba4ee12g6f6ag4f2ag8992g653f00ef2c9b"
msgid "I met her. She says <i>you're</i> the fiends, and I believe her."
msgstr "그녀를 만났지. <i>당신들이</i> 마귀라더군. 그녀 말을 믿기로 했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = 08075963-01d3-a9e5-7d59-149c29b94f9b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:08075963-01d3-a9e5-7d59-149c29b94f9b
msgctxt "hffea3751g504fg4b6aga366ga83fa0bdf3fa"
msgid "I suppose she sought cover for her own crimes by accusing us."
msgstr "그녀는 우리에게 누명을 씌움으로써 자신의 범죄를 은폐하려 했던 것 같소."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Player
#. NodeID = 09ce8124-bd4c-5d3d-4546-c879fc592ce4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Karlach_HasMet = True
#.      - PLA_KarlachRecruitmentTollhouse_Knows_RefugeesAreCultists = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:09ce8124-bd4c-5d3d-4546-c879fc592ce4
msgctxt "h6da296adgc22bg4c4egaaa7g12b77389516a"
msgid "Why did she think you agents of Zariel?"
msgstr "그녀가 당신들을 자리엘의 요원이라 생각한 이유가 뭐지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Player
#. NodeID = 0a3f13d0-e8c8-459b-9dae-c3b0b5f109d0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_Karlach_State_HasHead(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:0a3f13d0-e8c8-459b-9dae-c3b0b5f109d0
msgctxt "hc637573fg9b60g41b9g832eg185019c5f570"
msgid "Here's her head. Just like you asked."
msgstr "여기 당신이 부탁한 대로 그녀의 머리를 가져왔소."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = 0b24383e-61c4-4542-9ce9-015223a7cec4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:0b24383e-61c4-4542-9ce9-015223a7cec4
msgctxt "hef52afa4g0fbdg4446g9893g6c1d5237b1ed"
msgid ""
"She ran toward the river when she saw we were merely wounded - not dead. "
"Down the hill from here."
msgstr "그 여자는 우리가 죽지 않고 다치기만 한 것을 보고 강을 향해 도망갔소. 이 언덕 아래로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Player
#. NodeID = 0d2c08e0-ec51-4206-80e4-fa313448f019
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Karlach_State_Dead = False
#.      - ORI_Karlach_HasMet = True
#.      - GLO_Origin_PartOfTheTeam_Karlach = False
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:0d2c08e0-ec51-4206-80e4-fa313448f019
msgctxt "hd5b0ee73g1a0eg42e0g97a3gc48e84a7459d"
msgid "Truly? I believe I've met her."
msgstr "정말? 그녀를 만난 적이 있는 것 같은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = 0d345365-d64c-aa85-f4ee-f22c78bb26bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:0d345365-d64c-aa85-f4ee-f22c78bb26bf
msgctxt "haf403810ga033g4c9eg87f1g7f066ad9db9c"
msgid ""
"A devilish lie. She nearly killed me with her hellacious flames, and now "
"she's sent you to finish the job."
msgstr "데빌다운 거짓말이로군. 그녀는 지옥의 불길로 거의 날 죽여버릴 뻔했는데, 이제는 그대를 보내 일을 끝내도록 했군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Trynn
#. NodeID = 0d700620-e280-48f1-97a0-d67402118070
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:0d700620-e280-48f1-97a0-d67402118070
msgctxt "h30a8e34fg1b28g4cbfg97aag05f6f16db711"
msgid "Block the doors."
msgstr "문을 잠가."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Player
#. NodeID = 0de4d183-38ca-4836-b07d-aa1c8a2350e3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Karlach_State_Dead = True
#.      - ORI_Karlach_HasMet = True
#.      - PLA_KarlachRecruitmentTollhouse_State_HeadNotAvailable = False
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:0de4d183-38ca-4836-b07d-aa1c8a2350e3
msgctxt "hebccaa11gce50g45a3gb087g38b1a7b9036d"
msgid "I've already dealt with her. She's dead."
msgstr "이미 그 여자를 처리했지. 그녀는 죽었소."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = 10e7fb25-42b8-2a09-bc25-27cb2c8f1a53
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:10e7fb25-42b8-2a09-bc25-27cb2c8f1a53
msgctxt "hffc55640ge545g470aga43dg8c9e37a9b081"
msgid ""
"Our lord Tyr sent us in pursuit of that devil. She had already butchered a "
"family fleeing the armies of the Absolute by the time we caught up with her."
msgstr ""
"우리의 주신 티르가 그 데빌을 추격하라고 보냈소. 우리가 그녀를 쫓을 때 그녀는 이미 절대자의 군대를 피해 도망치던 한 가족을 "
"도륙해버렸네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = 140f58b5-326a-693c-0329-f94a8765266d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:140f58b5-326a-693c-0329-f94a8765266d
msgctxt "hd338db5eg132ag422dgb2bfg746e2991a0b1"
msgid ""
"We are paladins of Tyr, sworn to protect those in need. He sent us to hunt "
"Karlach down, but she was too vicious for us."
msgstr ""
"우리는 도움이 필요한 이들을 보호하기로 맹세한, 티르의 팔라딘이오. 티르께서 칼라크를 사냥하라고 우리를 보냈지만, 그녀는 너무 악독했소."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Player
#. NodeID = 146b5476-3874-4f0c-ae1a-c6fe3b7165f3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN_TYR(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:146b5476-3874-4f0c-ae1a-c6fe3b7165f3
msgctxt "hc89bf139g4a5cg4165ga9e8geb8658df44b6"
msgid ""
"Truth and justice, brother. My oath is in Tyr's name. I am sorry to hear "
"about the fate of your mission."
msgstr "진실과 정의, 형제여. 나의 맹세는 티르의 이름으로. 그대 임무의 운명을 듣게 되어 유감이군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = 15b75add-cb13-4dbd-3ef2-20ca5472f720
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - PLA_KarlachRecruitmentTollhouse_State_HasWeapon(0) = False
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:15b75add-cb13-4dbd-3ef2-20ca5472f720
msgctxt "hb44ec62fg8facg41bdg8d3fgb427c196ba13"
msgid ""
"She wasn't. I may not be able to convince you, but Tyr's blessing is now "
"upon you. Let him strike me down if I take his word in vain."
msgstr ""
"그럴 리가. 당신을 설득할 수 없을지 몰라도, 티르의 가호가 당신을 비추고 있소. 내가 티르님의 말을 헛되게 여기었다면 티르께서는 나를 "
"베어버리시길."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Player
#. NodeID = 185688c8-ace7-2cf9-7ea3-a8ee8d986876
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_Refugee_001_PostEA_PassedCheckDevils(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:185688c8-ace7-2cf9-7ea3-a8ee8d986876
msgctxt "h371d80f4gc67dg4cc9gbec0gc6d6a2d19063"
msgid "It isn't like a devil to use their brawn instead of their brains."
msgstr "머리 대신 힘을 쓰는 건 데빌답지 않은데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = 1b32d771-6171-f106-49cf-25aead11821c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_Refugee_001_HasMet(1) = False
#.   Global:
#.      - PLA_PaladinsOfTyr_Event_KarlachLeavesHostile = True
#. SetFlags:
#.   Dialog:
#.     - PLA_Refugee_001_SidedWithPaladins_HasMet(1) = True
#.     - PLA_Refugee_001_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:1b32d771-6171-f106-49cf-25aead11821c
msgctxt "hc3dec10dgc7d6g4813g91aag914b259ca70b"
msgid ""
"I thank you for taking our side. You had no reason to trust us, yet your "
"faith spared us a grisly end."
msgstr "우리 편에 서 줘서 감사하오. 당신은 우릴 믿을 이유가 없었겠지만, 당신의 믿음은 우리의 끔찍한 결말을 막았소."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Player
#. NodeID = 1eba5e4b-c963-cdab-c7e5-13be0c5985b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:1eba5e4b-c963-cdab-c7e5-13be0c5985b4
msgctxt "hd0433cdegd0a9g44acg9033g815415cd1cb5"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = 24975dad-c44e-25e7-9966-c0fea80671a2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Origin_PartOfTheTeam_Karlach = True
#. SetFlags:
#.   Dialog:
#.     - PLA_Refugee_001_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:24975dad-c44e-25e7-9966-c0fea80671a2
msgctxt "hade5a10egc3cbg4f0eg9de1gf56eda1b9af7"
msgid ""
"Our scouts told us you'd come. The devil's ally. Come to finish us, have you?"
msgstr "정찰병이 당신들이 오는 걸 발견했소. 데빌의 우군이 되어, 우리를 끝쟁내러 온 것이오?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = 25e9abdc-18b2-3745-f14f-3c310a1f45c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:25e9abdc-18b2-3745-f14f-3c310a1f45c4
msgctxt "h2d38680eg0c59g499fg9ac6gefa5b39de18c"
msgid "I believe... that is..."
msgstr "내가 알기론... 그건..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Player
#. NodeID = 29c65673-140f-c5d3-b3ec-ba98999e47f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:29c65673-140f-c5d3-b3ec-ba98999e47f4
msgctxt "h7414673bgd870g410cgb109g1b612ae4f40b"
msgid "You must mean Karlach. I know the truth about who you are."
msgstr "칼라크를 말하는 거겠지. 나는 당신들 정체에 대해 잘 알고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Player
#. NodeID = 32fb1a1b-5773-09e8-d8ac-09bd6d58ebad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:32fb1a1b-5773-09e8-d8ac-09bd6d58ebad
msgctxt "h6aafb33dgb7d7g47c4g8c0cgf0025f23d887"
msgid "Why should I believe you?"
msgstr "내가 널 왜 믿어야 하지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = 3b4ba645-a1a9-4279-a775-cfc3369c1e32
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_KarlachRecruitmentTollhouse_Knows_RefugeesAreCultists = True
#.   Object:
#.      - PLA_KarlachRecruitmentTollhouse_State_HasWeapon(0) = True
#. SetFlags:
#.   Object:
#.     - PLA_KarlachRecruitmentTollhouse_Event_GiveWeapon(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:3b4ba645-a1a9-4279-a775-cfc3369c1e32
msgctxt "hfb94f246g72eag4c75ga5bfge8fa9f2678ad"
msgid "You've saved our souls. It's a debt that can never truly be repaid."
msgstr "당신이 우리의 영혼을 구했소. 결코 갚을 수 없는 빚을 졌군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Narrator
#. NodeID = 427b67cc-e798-c0d7-aaee-d7c0fe55507b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_KarlachRecruitmentTollhouse_State_ToldByKarlachPaladinCultists = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:427b67cc-e798-c0d7-aaee-d7c0fe55507b
msgctxt "h1539635fg9955g423fg91c4gb983520aa7d3"
msgid ""
"*That's Karlach all right. If you believe her story, these so-called "
"paladins are lying.*"
msgstr "*그건 틀림없이 칼라크입니다. 그녀의 이야기를 믿는다면, 이들 소위 팔라딘이라는 자들은 거짓말을 하고 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = 45a35553-1ec8-bf52-9870-6d5e87cdffc7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:45a35553-1ec8-bf52-9870-6d5e87cdffc7
msgctxt "ha20a978agc3d1g4377gb010g8439cc1343d8"
msgid "Zariel will find this all terribly funny."
msgstr "자리엘께서 이걸 끔찍이도 재밌어하시겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = 487fa42b-ef18-6ba1-836b-271fa07478a3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:487fa42b-ef18-6ba1-836b-271fa07478a3
msgctxt "h93b3df81g6088g41degbdd3ge37729f7b903"
msgid "Do not be swayed."
msgstr "현혹되지 마시오."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Player
#. NodeID = 4d3fd7ff-0c9a-4015-9956-6eba3146bac7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_KarlachRecruitmentTollhouse_State_HeadNotAvailable = False
#.      - GLO_Origin_PartOfTheTeam_Karlach = False
#. SetFlags:
#.   Global:
#.     - PLA_KarlachRecruitmentTollhouse_Quest_AcceptedSearch = True
#. TagRule: REALLY_WYLL
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:4d3fd7ff-0c9a-4015-9956-6eba3146bac7
msgctxt "hd02f863dgbb5fg4687gbd6dg37eba6c09cb3"
msgid "The monster's name is Karlach - my sworn prey. I will hunt her down."
msgstr "그 괴물의 이름은 칼라크, 내가 잡기로 맹세한 사냥감이지. 내가 그녀를 사냥하겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Player
#. NodeID = 4d3fd7ff-0c9a-4015-9956-6eba3146bac7
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_KarlachRecruitmentTollhouse_State_HeadNotAvailable = False
#.      - GLO_Origin_PartOfTheTeam_Karlach = False
#. SetFlags:
#.   Global:
#.     - PLA_KarlachRecruitmentTollhouse_Quest_AcceptedSearch = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:4d3fd7ff-0c9a-4015-9956-6eba3146bac7
msgctxt "h0880158eg3a33g4226g9fd0g781657fe272b"
msgid "Let me help. I can hunt down this monster."
msgstr "내가 도울 수 있게 해줘. 내가 이 괴물을 사냥할 수 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = 4f247f6b-0344-878e-50b4-e587d6a618ab
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:4f247f6b-0344-878e-50b4-e587d6a618ab
msgctxt "h759d7556g3085g4f86ga594g04d6a0248c22"
msgid ""
"Believe what you will, but do it in silence. We have wounded to tend to - "
"and a return home to plan."
msgstr "뭘 믿는지는 당신 마음이지만, 마음으로만 간직하시오. 우리는 부상자를 돌봐야 하고, 집으로 돌아가서 앞날을 도모해야 하오."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = 512cf26f-0c9a-4304-a228-2181cf1d4454
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_KarlachRecruitmentTollhouse_Quest_AcceptedSearch = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:512cf26f-0c9a-4304-a228-2181cf1d4454
msgctxt "he9a5865fge574g466cg859fg3c9eee73717f"
msgid ""
"Bring me her head, and I'll give you my blade. It carries Tyr's blessing - "
"and you will have earned it by carrying out his justice."
msgstr ""
"그녀의 머리를 가져와 주시오, 그러면 내 검을 주겠소. 여기엔 티르의 축복이 담겨 있다오. 그리고 당신이 그의 정의를 수행함으로써 그 "
"축복을 얻게 될 것이오."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = 5589bfaa-d393-40d8-9684-cb9acd422b47
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_KarlachRecruitmentTollhouse_Knows_RefugeesAreCultists = False
#.   Object:
#.      - PLA_KarlachRecruitmentTollhouse_State_HasWeapon(0) = True
#. SetFlags:
#.   Object:
#.     - PLA_KarlachRecruitmentTollhouse_Event_GiveWeapon(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:5589bfaa-d393-40d8-9684-cb9acd422b47
msgctxt "h9ab2e94eg75bfg4080gb860gc070056d239a"
msgid "Thank you. As promised, here is my blade, blessed by Tyr."
msgstr "고맙소. 약속한 대로, 여기, 티르의 축복을 받은 나의 검이요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = 558a96cb-ae2d-932d-beb3-6c280ee29509
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:558a96cb-ae2d-932d-beb3-6c280ee29509
msgctxt "he6bd10cag4ab1g4841gadb6gc239a2fc1dd1"
msgid ""
"Tyr protect you. Be on your watch. There's a devil in the guise of a one-"
"horned tiefling haunting the Risen Road."
msgstr "티르가 그대를 보호할 것이니. 경계를 늦추지 말게. 치솟은 길 주변에 외뿔의 티플링 모습의 데빌이 있다네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = 572d0bd2-4cbf-6c33-27de-a1cc774c5c7b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - PLA_KarlachRecruitmentTollhouse_State_HasWeapon(0) = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:572d0bd2-4cbf-6c33-27de-a1cc774c5c7b
msgctxt "ha05480e9g268eg43c6gace7g3dd1eb08f865"
msgid "She wasn't. Let me prove it to you with a gift."
msgstr "그럴 리가. 선물로 증명해 보이겠소."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = 575d807a-fccb-cf32-b58e-fde4d44e4c46
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:575d807a-fccb-cf32-b58e-fde4d44e4c46
msgctxt "h9dd2b522gab9ag45d9g9ac0g95014dded72f"
msgid ""
"Just yesterday, the devil Karlach slaughtered countless refugees. An entire "
"family met their end at her hands - including a pregnant mother."
msgstr "바로 어제, 데빌 칼라크가 수많은 난민을 학살했소. 임산부를 비롯한 온 가족이 그 여자 손에 죽음을 맞이했소."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = 590a0461-0972-4e4c-8e15-9efe5de8442a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:590a0461-0972-4e4c-8e15-9efe5de8442a
msgctxt "h67d86557gb754g4bb2ga244g715d0949a778"
msgid "Believe me, she's no tiefling, but a devil. We were lucky to escape."
msgstr "내 말 믿어 주시오. 그 여자는 티플링이 아니라, 데빌이오. 우리는 벗어나서 망정이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = 59f98b85-fb70-49af-93dd-eab2f9582ecd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:59f98b85-fb70-49af-93dd-eab2f9582ecd
msgctxt "h55144ecag3555g4be1g9abbg9628b2f9d01d"
msgid ""
"The fiend may have been a tiefling once, but she belongs to Avernus now. I "
"wish it were not so, and I bear no grudge against your people."
msgstr ""
"그 악마가 한때 티플링이었을진 몰라도, 그녀는 이제 아베르누스의 일원이오. 그러지 않았으면 좋겠지만, 당신네 사람들에게 원한은 없소."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Player
#. NodeID = 5a1b3893-54e2-9b34-e9b4-17dbf78435cf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:5a1b3893-54e2-9b34-e9b4-17dbf78435cf
msgctxt "h42fa1d7bg929ag4734gb68cgdf19dc327a1a"
msgid "It was my duty to protect you."
msgstr "당신을 보호하는 게 내 의무였으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = 5beb7f11-f327-456d-a241-c67cfa57ab61
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_Refugee_001_HasMet(1) = True
#.   Global:
#.      - PLA_KarlachRecruitmentTollhouse_Quest_AcceptedSearch = True
#. TagRule:
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:5beb7f11-f327-456d-a241-c67cfa57ab61
msgctxt "hbce03a3dg21cfg4469g8dd4gb30b9be40d5e"
msgid "Well?"
msgstr "음?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Player
#. NodeID = 5dc339a7-3eee-60a7-c66a-df2c10844b8c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:5dc339a7-3eee-60a7-c66a-df2c10844b8c
msgctxt "h9fcfd836g5d40g4a2eg83e9gadbcd0c98034"
msgid "The only head that will roll is yours."
msgstr "굴러갈 머리는 네 머리뿐이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Player
#. NodeID = 5de92b2a-5773-9a42-bc84-7470694ba67a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Karlach_HasMet = True
#.      - PLA_KarlachRecruitmentTollhouse_Knows_RefugeesAreCultists = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:5de92b2a-5773-9a42-bc84-7470694ba67a
msgctxt "h36044f5egd62fg461cg8946gd13b44bea429"
msgid ""
"I've met her. She said you were servants of Zariel sent to take her back to "
"Avernus."
msgstr "그녀를 만났어. 그녀가 말하길 당신은 자리엘의 종복이고, 그녀를 아베르누스로 돌려 보내기 위해 당신을 보냈다더군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = 5f2ee01c-a75a-a534-4f4b-ee7612fb9d71
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:5f2ee01c-a75a-a534-4f4b-ee7612fb9d71
msgctxt "h2e7de502g8a73g4d48gb2e0ga6e8916f7c3f"
msgid ""
"I'm sure she's invented a fascinating history of our crimes. The truth is "
"far simpler."
msgstr "그녀가 우리의 과거를 흥미로운 죄악의 역사로 날조했던 게 틀림없군. 진실은 훨씬 더 간단하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Player
#. NodeID = 600d320a-b483-b529-9357-6edb5cb64ed9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN_TYR(1) = True
#. SetFlags:
#.   Global:
#.     - PLA_KarlachRecruitmentTollhouse_State_HostilitiesBegan = True
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:600d320a-b483-b529-9357-6edb5cb64ed9
msgctxt "h9b41afbagb1a5g4666g8c2bgde32c090ad8e"
msgid ""
"If you serve the Lord of Justice, prove it. Recite the Creed of the Left "
"Hand."
msgstr "정의의 신 티르님을 섬긴다면, 증명해봐. 왼손의 신조를 당장 외워봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = 62a29741-84fb-4f36-88fb-c3823f4a46f7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_KarlachRecruitmentTollhouse_State_AndersReceivedHead = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:62a29741-84fb-4f36-88fb-c3823f4a46f7
msgctxt "h3717ed29g39efg4ba6g8060g7f255ceb8638"
msgid "Your actions saved many souls - Tyr be with you."
msgstr "당신의 행동이 많은 이를 구했소. 티르가 함께하기를."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Player
#. NodeID = 64e1787e-61cd-483a-95cf-73e2b169252d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TIEFLING(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:64e1787e-61cd-483a-95cf-73e2b169252d
msgctxt "h62779a99ga0e0g4e12g9f67g767da7e48e90"
msgid ""
"I've been called a devil before. Are you sure this tiefling is what you say?"
msgstr "나도 전에는 데빌이라고 불린 적이 있어. 저 티플링이 정말 당신이 말하는 데빌이 맞는 거야?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = 66134529-9917-57a6-9efd-7b5f01033edf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_Refugee_001_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - PLA_Refugee_001_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:66134529-9917-57a6-9efd-7b5f01033edf
msgctxt "h0d7de162ga67cg4bc5g9466g386440042438"
msgid ""
"Wh-who's there? Please - keep your distance. You're welcome to shelter here, "
"but we've grave injuries to tend to."
msgstr "누-누구요? 부탁이니 - 다가오지 말아 주시오. 여기서 머물러도 좋지만, 우리는 심각한 부상을 치료해야 하오."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = 66b777c3-c74b-4af5-ac90-5de77988b560
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_KarlachRecruitmentTollhouse_State_HeadNotAvailable = False
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:66b777c3-c74b-4af5-ac90-5de77988b560
msgctxt "h1fcf2f2eg02cbg4d63g9b86gcfe09e507e14"
msgid ""
"If that's true, this is the first glimmer of hope we've had for a long "
"while. But I'll need proof."
msgstr "그게 사실이라면, 정말 오랜만에 보는 희망의 불씨로군. 하지만 증거가 필요하오."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = 67089f70-8d6b-4bdb-ab04-01943955b12f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:67089f70-8d6b-4bdb-ab04-01943955b12f
msgctxt "h026895ccge0d7g4ac5gb040g842c3a62d92b"
msgid ""
"But here is my blade, blessed by Tyr. I hope it keeps you safe, and brings "
"your enemies to justice."
msgstr "하지만 여기, 내 검이오, 티르 님의 축복을 받았지. 당신을 안전히 지키고 적들에게는 정의의 심판을 내려주기를."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Player
#. NodeID = 673189e6-744f-9e93-d21c-d4e2cecaac14
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:673189e6-744f-9e93-d21c-d4e2cecaac14
msgctxt "h4fd1df2eg2becg46a2gbc57g43c72a045eb8"
msgid "I have other things to deal with."
msgstr "지금은 다른 일이 더 중요해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = 68c564e3-0272-16b3-9e0b-f7f0eab41200
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - PLA_KarlachRecruitmentTollhouse_State_HasWeapon(0) = False
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:68c564e3-0272-16b3-9e0b-f7f0eab41200
msgctxt "h4090a4eegdce7g44ebg956dgd707962e714d"
msgid ""
"We owe you every gratitude. If we had something - anything - to give, we "
"would. But our thanks - and Tyr's gratitude - will have to suffice for now."
msgstr ""
"우리는 당신에게 무한한 빚을 졌소. 우리가 당신께 줄 것이 있다면, 언제든지 드리겠소. 다만 지금은 우리의 감사와 티르의 은혜로움으로 "
"만족해 주길 바라오."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = 6cbd5dd2-5f06-44b5-e70c-f132e8b4d304
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:6cbd5dd2-5f06-44b5-e70c-f132e8b4d304
msgctxt "h5c358ae0g171bg4169gbd0bged0ee70fbcc1"
msgid ""
"But here is my blade, blessed by Tyr. I hope it keeps you safe, and brings "
"your enemies to justice."
msgstr "하지만 여기, 내 검이오, 티르 님의 축복을 받았지. 당신을 안전히 지키고 적들에게는 정의의 심판을 내려주기를."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Player
#. NodeID = 6d554781-b261-2ced-7071-3eec838ac38e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:6d554781-b261-2ced-7071-3eec838ac38e
msgctxt "h2e77bc2eg5891g425bgac37gbf792bbb7ff6"
msgid "Rest easy. I'll only stay a short time."
msgstr "걱정 하지 마. 잠시 있다 갈거니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Player
#. NodeID = 6e7efd11-4a3a-4944-86f5-d4b5c306e240
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Karlach_HasMet = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:6e7efd11-4a3a-4944-86f5-d4b5c306e240
msgctxt "h4e7aefeag1feag4ca9g8208g2fe6485da579"
msgid "I met her by the river, not far from here."
msgstr "여기서 멀지 않은 강가에서 그녀를 만났어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = 6ef76495-afb8-4353-b470-48549454c4d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:6ef76495-afb8-4353-b470-48549454c4d8
msgctxt "hb7601daeg76acg4744g8057g1f3d932ce370"
msgid ""
"I understand. But if you see the fiend, be on your guard. She's dangerous."
msgstr "이해하오. 하지만 그 악마를 만난다면, 조심하시오. 그녀는 위험하니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = 6f1c4c07-378e-45c7-8677-efe33817ebcd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:6f1c4c07-378e-45c7-8677-efe33817ebcd
msgctxt "hd3b1494fg3286g4a3fgb4dcgd1b6820a5ae7"
msgid ""
"First I was burned within in inch of my life, and now I'm stuck playing "
"pantomime. I can't take it anymore."
msgstr "처음엔 불에 타서 죽을 뻔 했고, 이젠 누명까지 씌어 옴짝달싹도 못 하다니. 더 이상은 못 견디겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = 6fa0ecc5-f80a-d4f2-2c21-f9633356c402
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:6fa0ecc5-f80a-d4f2-2c21-f9633356c402
msgctxt "hcf4f8364g6fdag42fegad1eg4c3176239062"
msgid "It isn't too late to do the right thing, though."
msgstr "그래도 옳은 일을 하기에는 너무 늦지 않았소."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = 7a4b877c-fbdf-16de-879a-8b7d7734d3ce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:7a4b877c-fbdf-16de-879a-8b7d7734d3ce
msgctxt "he2d5b107g435cg459dga4c9gfdd9908e166b"
msgid ""
"We are paladins of Tyr, Lord of Justice. He sent us after an infernal being, "
"straight out of the Nine Hells, hiding in the form of a one-horned tiefling -"
" Karlach."
msgstr ""
"우리는 정의의 군주 티르의 팔라딘이오. 티르께서는 우리를 보내, 아홉 지옥에서 튀어나와 뿔이 하나 달린 티플링의 모습으로 숨어 있는 "
"지옥의 존재 칼라크를 쫓게 하셨소."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = 7a8ec594-a213-9fe2-5f37-e68efc2e58d1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_Refugee_001_HasMet(1) = True
#.   Global:
#.      - PLA_PaladinsOfTyr_Event_KarlachLeavesHostile = True
#. SetFlags:
#.   Dialog:
#.     - PLA_Refugee_001_SidedWithPaladins_HasMet(1) = True
#.     - PLA_Refugee_001_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:7a8ec594-a213-9fe2-5f37-e68efc2e58d1
msgctxt "hcdf92830g809cg469dgb589g552a465236a9"
msgid "She's dead. Finally we can rest."
msgstr "그녀가 죽었어. 마침내 쉴 수 있겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = 7e2e266f-45b0-4c0c-9122-dbb4b1c4d0fc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_KarlachRecruitmentTollhouse_State_HostilitiesBegan = True
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:7e2e266f-45b0-4c0c-9122-dbb4b1c4d0fc
msgctxt "h82a478e6g0368g4237g9633g862b3c49c166"
msgid "Fool. All you'll get is a broken skull."
msgstr "멍청하긴. 네가 갖게 될 건 부서진 두개골뿐이다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = 7f1cec2b-1b44-8a14-258d-e641537a7b71
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_Refugee_001_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:7f1cec2b-1b44-8a14-258d-e641537a7b71
msgctxt "h7ee2b5f7gff47g4302g817fg02dbb5904246"
msgid "Perhaps you've decided to chase down the fiend after all?"
msgstr "결국 그 악마를 쫓아 그 놈을 죽여버리기로 결정한 거요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Player
#. NodeID = 8270ae0f-a6fc-5988-263c-c54e816cef69
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:8270ae0f-a6fc-5988-263c-c54e816cef69
msgctxt "hab21c288gd026g42edgbbc5g83489239d05d"
msgid "I disagree. I think <i>you're </i>something far worse."
msgstr "동의할 수 없군. <i>네가</i> 훨씬 더 사악해 보여."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = 85c9a8a7-404a-befa-36e2-e2b398c41ddb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:85c9a8a7-404a-befa-36e2-e2b398c41ddb
msgctxt "h228a2e02gb052g4386g92f3g4fd7a2e9cf91"
msgid "Then you'd be very stupid indeed."
msgstr "그렇다면 그대는 매우 어리석은 자임에 틀림없겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Player
#. NodeID = 891a762f-2f30-5034-d299-498b79f9dde8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:891a762f-2f30-5034-d299-498b79f9dde8
msgctxt "hb906d4eeg72a2g467ag821bgd631e67b55c0"
msgid "Who - or what - attacked you?"
msgstr "누가, 아니 뭐가 당신들을 공격했지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Player
#. NodeID = 8f4a7c75-98db-b197-41e1-ab5b11d9a859
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN_TYR(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:8f4a7c75-98db-b197-41e1-ab5b11d9a859
msgctxt "h10dd3094g84d2g4d8cg8879gafdc543f13fd"
msgid ""
"If you serve the Lord of Justice, prove it. Recite the Creed of the Left "
"Hand."
msgstr "정의의 신 티르님을 섬긴다면, 증명해봐. 왼손의 신조를 당장 외워봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Player
#. NodeID = 9029747d-6ddc-121a-6bc6-f15a242a6361
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:9029747d-6ddc-121a-6bc6-f15a242a6361
msgctxt "h35d392cdg0fd1g4418g9f24g98c30a811187"
msgid "That depends on you. Are you what she says you are?"
msgstr "그건 당신 하기에 달렸지. 그녀가 말한 당신들의 정체가 맞아?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = 92f41a8e-21e4-44b7-b22a-9f8a78375347
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:92f41a8e-21e4-44b7-b22a-9f8a78375347
msgctxt "h99f6bc95gb0f6g4a06gb817gc6967c4a13d4"
msgid ""
"A fellow paladin? What fortune. You might be able to succeed where we failed."
msgstr "동료 팔라딘이라? 운이 좋군. 우리가 실패한 곳에서 그대는 성공할 수 있을지도 모르겠소."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = 934dd523-ac97-45b9-823f-2d87282dd796
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:934dd523-ac97-45b9-823f-2d87282dd796
msgctxt "h75414930g70f2g476agbb2fg7af56a350dae"
msgid ""
"She only has one horn, and she looks like she could rip your arms off with "
"her bare hands. Hard to miss."
msgstr "그녀는 뿔이 하나밖에 없소, 그리고 팔 하나쯤은 맨손으로도 찢어버릴 수 있을 것 같이 생겼지. 못 알아볼 일은 없을 것이오."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Narrator
#. NodeID = 94bb5986-2c96-6a34-12ad-efb038346edb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - WYLL(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:94bb5986-2c96-6a34-12ad-efb038346edb
msgctxt "h915892b4g6555g45abgbee7g414148adccbe"
msgid "*One horn. He means Karlach - there is no doubting it.*"
msgstr "*뿔이 하나인 자. 칼라크를 말하는 게 틀림없습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = 953096c3-692f-4782-df2b-6fff1e9f71c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:953096c3-692f-4782-df2b-6fff1e9f71c6
msgctxt "h0c9d8d6bgfa63g4176gb500g5cbd5b61f75d"
msgid ""
"A tollhouse, once upon a time. Now a house of respite for those of us burned "
"by a devil."
msgstr "한때는 통행료 징수소였지. 지금은 데빌에게 불태워진 우리들의 휴식처라네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Player
#. NodeID = 9bc90f20-d3a6-ab80-3876-0eef3b47a6a8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Karlach_HasMet = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:9bc90f20-d3a6-ab80-3876-0eef3b47a6a8
msgctxt "hfd562393g8afbg4d45g8da4gdaed0be157b2"
msgid "I heard a tiefling called Karlach nearly roasted you to death."
msgstr "칼라크라는 티플링이 당신을 통구이로 만들 뻔했다고 들었는데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Player
#. NodeID = 9e254e7d-c677-3d4d-23af-735ac6266a93
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_KarlachRecruitmentTollhouse_State_HostilitiesBegan = True
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:9e254e7d-c677-3d4d-23af-735ac6266a93
msgctxt "h4256bdebg1fb4g48ccga95dg5f39ed7c7e3a"
msgid "Say I buy your story. What then?"
msgstr "당신 이야기를 믿는다고 치고. 그다음엔?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Player
#. NodeID = 9f26e91a-1822-bf32-f389-9e4f2a3e015b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_KarlachRecruitmentTollhouse_State_HeadNotAvailable = False
#.      - GLO_Origin_PartOfTheTeam_Karlach = False
#. SetFlags:
#.   Global:
#.     - PLA_KarlachRecruitmentTollhouse_Quest_AcceptedSearch = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:9f26e91a-1822-bf32-f389-9e4f2a3e015b
msgctxt "h5321aac9g1ea6g42d4g9dd9g1aa65791a572"
msgid "Very well. I'll bring you her head."
msgstr "아주 좋아. 그 여자의 머리를 가져다 주지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Player
#. NodeID = a17b1b5d-9ef6-9428-6a1f-7d550d08fc57
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:a17b1b5d-9ef6-9428-6a1f-7d550d08fc57
msgctxt "hc17ebaeag98f2g4648g8278gf71d60fd1647"
msgid "What is this place?"
msgstr "여긴 뭐하는 곳이지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = a46ed3cc-435f-7dfd-74c2-54514c4cd5f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:a46ed3cc-435f-7dfd-74c2-54514c4cd5f4
msgctxt "h19fe0188g3688g4f4ag9d15g14b626d2974f"
msgid ""
"Agents of... let me guess. The devil Karlach herself told you that profane "
"lie."
msgstr "요원들이라... 내가 맞춰보지. 데빌 칼라크 본인이 당신에게 그 불경스러운 거짓말을 한 거로군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Player
#. NodeID = a4a69540-d7cf-812c-506f-c3a51057bc3e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_KarlachRecruitmentTollhouse_State_HeadNotAvailable = False
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:a4a69540-d7cf-812c-506f-c3a51057bc3e
msgctxt "h94315486g928ag4b65gba57g8545033d3daf"
msgid "I'll think about it."
msgstr "생각해 볼게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = a5f43789-1fb6-7a24-262f-4779a0ca2561
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - PLA_KarlachRecruitmentTollhouse_State_HasWeapon(0) = True
#. SetFlags:
#.   Object:
#.     - PLA_KarlachRecruitmentTollhouse_Event_GiveWeapon(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:a5f43789-1fb6-7a24-262f-4779a0ca2561
msgctxt "h3792b881g3630g43eagb1e6g556c062974a9"
msgid "You've saved our souls. It's a debt that can never truly be repaid."
msgstr "당신이 우리의 영혼을 구했소. 결코 갚을 수 없는 빚을 졌군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = a6e202f3-7cbc-4c26-b98a-59a8a94c0378
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_KarlachRecruitmentTollhouse_Quest_AcceptedSearch = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:a6e202f3-7cbc-4c26-b98a-59a8a94c0378
msgctxt "hfc1544bbg541ag4c9agb203gcba46e8555ca"
msgid "Then you're lucky to be alive."
msgstr "그렇다면 당신은 아직 살아있는 게 행운인 줄 아시오."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Wyll
#. NodeID = a760cdf9-480c-4e8e-bbc5-5c72e04edbc5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 31c5cf55-6ca8-5ef7-de32-7370ebd6f40e_WyllInclusion = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:a760cdf9-480c-4e8e-bbc5-5c72e04edbc5
msgctxt "hed03689ag1e77g41b2g89e2gccad3bf6c8ca"
msgid "One horn? Then you mean Karlach. Archdevil's bootlicker."
msgstr "뿔이 하나라고? 칼라크 말이군. 아크데빌의 졸개 녀석."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = a8dc51c5-9cf9-4fd1-ae1b-6f1580a6ef0b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:a8dc51c5-9cf9-4fd1-ae1b-6f1580a6ef0b
msgctxt "h2178d569g3566g4506g89a6g38325757ccac"
msgid ""
"This is the Sword of Justice, blessed by Tyr. I've wielded it since I swore "
"my oath."
msgstr "이건 티르님의 축복을 받은 정의의 검이오. 내가 맹세를 한 그 순간부터 가지고 다녔지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Player
#. NodeID = a8ec2db8-6417-4d65-a36e-d33ef1bc3954
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_KarlachRecruitmentTollhouse_State_HostilitiesBegan = True
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:a8ec2db8-6417-4d65-a36e-d33ef1bc3954
msgctxt "h05fecdbcgaf01g482bg878fg21e846347cd7"
msgid "That's right. I'm sending you back to Avernus where you belong."
msgstr "맞아. 너를 아베르누스로 돌려보내 주겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Player
#. NodeID = ac894a77-4223-40f3-a063-38a38b65c6d5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:ac894a77-4223-40f3-a063-38a38b65c6d5
msgctxt "hed2d2fc3ge78cg4242g8951g015d9818b23a"
msgid "Remind me - how will I recognise her?"
msgstr "다시 한번 알려줘 - 그녀가 어떻게 생겼다고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Player
#. NodeID = af27b6ed-483f-f5aa-231b-958bb4306e35
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_KarlachRecruitmentTollhouse_Knows_RefugeesAreCultists = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:af27b6ed-483f-f5aa-231b-958bb4306e35
msgctxt "hf270cffcgd269g45bbga13egf912e2ea0e43"
msgid ""
"Cut the act. I know what you are. Agents of Zariel here to collect an asset."
msgstr "연기는 집어치워. 너희 정체는 알고 있으니까. 소유물을 회수하러 온 자리엘 요원들이잖아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Player
#. NodeID = b052529e-0598-4929-9727-4a1ac77a4c57
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:b052529e-0598-4929-9727-4a1ac77a4c57
msgctxt "h37b27d24g5a1dg499bga85fgd5f43e3e9d2d"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = b0905794-a00b-9ec7-206e-8c3097acb5a1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:b0905794-a00b-9ec7-206e-8c3097acb5a1
msgctxt "h8d02af7dg389fg44c0g8bfbg1a32c646e2d0"
msgid "We were lucky to survive our encounter with her."
msgstr "우리가 그 여자를 맞닥뜨리고도 살아남은 것은 운이라고밖에 할 수 없지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Player
#. NodeID = b2b00dec-4da8-6b64-123c-0ee04891c79e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:b2b00dec-4da8-6b64-123c-0ee04891c79e
msgctxt "h9539f5bfg88c2g4080gbdb8g1a5c33c5b20c"
msgid "Maybe I was too hasty. Maybe she was right about you."
msgstr "내가 너무 성급했을지도 모르겠군. 당신에 대해서 어쩌면 그녀가 옳았을지도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = b70d7454-26e5-5ad1-b613-2c10d1a92787
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:b70d7454-26e5-5ad1-b613-2c10d1a92787
msgctxt "h2b2e5518g61b8g45f4g8755gfd3d200eae14"
msgid "A devil - the most deadly foe we've yet encountered."
msgstr "데빌이오. 우리가 만난 적들 중 가장 치명적인 적이지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = ba903458-f1b5-40e3-9507-9e6a5af4c9c9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - PLA_Refugee_001_ToldOfCrime(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:ba903458-f1b5-40e3-9507-9e6a5af4c9c9
msgctxt "h4afc1e9cgea42g43f9g85d4g257ed1fdb524"
msgid ""
"She's slaughtered countless refugees fleeing the Absolute. Yesterday, she "
"butchered an entire family without mercy."
msgstr "그 여자는 절대자를 피해 도망치는 수많은 피난민을 살육했소. 어제는 일가족을 도륙냈지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Player
#. NodeID = baed1be7-7519-4ad4-8e10-319b8388e9a5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_KarlachRecruitment_State_AccusedCultists = False
#.      - PLA_KarlachRecruitmentTollhouse_Knows_RefugeesAreCultists = True
#. SetFlags:
#.   Global:
#.     - PLA_KarlachRecruitment_State_AccusedCultists = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:baed1be7-7519-4ad4-8e10-319b8388e9a5
msgctxt "h06865114g30a2g4127ga235g5016df248935"
msgid "Drop the act - you're no paladin. You serve the archdevil Zariel."
msgstr "연기는 그만하시지. 넌 팔라딘이 아니야. 아크데빌 자리엘을 섬기는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = bb5f57cf-9d5d-a4e5-9ec9-42663e293c6d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_KarlachRecruitmentTollhouse_State_HostilitiesBegan = True
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:bb5f57cf-9d5d-a4e5-9ec9-42663e293c6d
msgctxt "hd7e9066ag134dg4986g827cg0f876144b40a"
msgid ""
"Karlach is going back to Avernus, and if she won't go quietly, she <i>dies</"
"i>. It looks like I'll have to kill you first, which I quite look forward "
"to. Bye-bye."
msgstr ""
"칼라크는 아베르누스로 돌아갈 것이고, 순순히 돌아가지 않는다면 <i>죽게</i> 될 걸세. 보아하니 당신을 먼저 죽여야 할 것 같고, "
"그렇게 되길 상당히 기대하고 있네. 잘가게."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Player
#. NodeID = be0b1f00-9bfe-4cf0-aa5f-4899ca4f12b8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:be0b1f00-9bfe-4cf0-aa5f-4899ca4f12b8
msgctxt "h3781e325gdb81g4173g9068gb2450992171b"
msgid "Now that she softened you up, I'll finish you off."
msgstr "그녀가 너의 힘을 빼놨으니, 이제 내가 너를 마무리 할 수 있겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = c11af300-e5aa-43f6-a50b-e86afc016f15
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:c11af300-e5aa-43f6-a50b-e86afc016f15
msgctxt "h4a542476g6d9ag41e4g89a1gc2a57f5fefab"
msgid "May the Just God guide you."
msgstr "정의의 신께서 그대를 인도하시길."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = c6ab4522-2427-439e-bfb6-15ada01162f7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_Refugee_001_HasMet(1) = False
#.   Global:
#.      - PLA_KarlachRecruitmentTollhouse_Quest_AcceptedSearch = True
#. SetFlags:
#.   Dialog:
#.     - PLA_Refugee_001_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:c6ab4522-2427-439e-bfb6-15ada01162f7
msgctxt "hf04a0138g40b2g4d2dgb4cag2a0096106e42"
msgid "Any sign of the tiefling fiend?"
msgstr "티플링 악마의 흔적은 찾았소?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = cd3fe5f2-e4a9-4c64-9b17-d7a004f8a1d8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_KarlachRecruitmentTollhouse_Knows_RefugeesAreCultists = False
#.   Object:
#.      - PLA_KarlachRecruitmentTollhouse_State_HasWeapon(0) = False
#. SetFlags:
#.   Object:
#.     - PLA_KarlachRecruitmentTollhouse_Quest_CompletedNoReward(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:cd3fe5f2-e4a9-4c64-9b17-d7a004f8a1d8
msgctxt "h216187ffg4363g4edfg9b62g7cc3a4b1a5d4"
msgid "A grim business - but justice has been served. May Tyr watch over you."
msgstr "잔혹한 일이지. 하지만 정의는 실현되어야만 하네. 티르가 당신을 굽어살피시길."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Narrator
#. NodeID = d01d71e2-18df-4fd8-9045-d0f189dfa08b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - PLA_Refugee_001_PostEA_PassedCheckDevils(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:d01d71e2-18df-4fd8-9045-d0f189dfa08b
msgctxt "hcb08cf7egf172g40d6gb963gcd029aa55533"
msgid ""
"*This <i>could </i>be the work of a devil, but they collect souls through "
"cunning, not carnage.*"
msgstr "*데빌의 소행일 <i>수도 있지만</i>, 데빌은 학살이 아닌 교활함을 통해 영혼을 수집합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = d2d9be77-edd0-a3f9-a593-2555db5313cf
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: TIEFLING
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:d2d9be77-edd0-a3f9-a593-2555db5313cf
msgctxt "h7a4875f5gedf2g4a02gaf93ge64faf14c3c6"
msgid ""
"Look at me. The devil nearly burned me to the bone. A normal tiefling like "
"yourself couldn't do that without powerful magics. She's something far worse."
msgstr ""
"날 보시오. 데빌이 날 뼈까지 태워버릴 뻔했소. 당신 같이 평범한 티플링은 강력한 마법 없이는 그렇게 할 수 없잖소. 그녀는 훨씬 더 "
"사악한 존재요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = d2d9be77-edd0-a3f9-a593-2555db5313cf
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:d2d9be77-edd0-a3f9-a593-2555db5313cf
msgctxt "h348adf9dg2143g428cg938dg2622f64b46a9"
msgid ""
"Look at me. The devil nearly burned me to the bone. A tiefling couldn't do "
"that without powerful magics. She's something far worse."
msgstr ""
"날 보시오. 데빌이 날 뼈까지 태워버릴 뻔했소. 티플링은 강력한 마법 없이는 그렇게 할 수 없잖소. 그녀는 훨씬 더 사악한 존재요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = d37989e6-d406-9952-45bd-d636f1fc7097
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 31c5cf55-6ca8-5ef7-de32-7370ebd6f40e_WyllInclusion = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:d37989e6-d406-9952-45bd-d636f1fc7097
msgctxt "hc7751c36g93eeg47c9ga082g4fb97f7d5dfe"
msgid "You know her. Which means you know what the fiend's capable of."
msgstr "그 여자를 알고 있다니. 그럼 그 악마가 어떤 능력을 갖고 있는지도 알겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = d3811ee6-c327-0482-396d-a4bda50e442f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_KarlachRecruitmentTollhouse_State_HostilitiesBegan = True
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:d3811ee6-c327-0482-396d-a4bda50e442f
msgctxt "h90137156gcd80g4ea7g85e7g3e0cc7c40ab3"
msgid "To arms, comrades. We are discovered."
msgstr "다들 전투 위치로! 우리 정체가 탄로났다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = d8f12812-e1be-75a6-9bbb-0499239c89d3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:d8f12812-e1be-75a6-9bbb-0499239c89d3
msgctxt "h8cb18993g2348g474eg89e9g1241619f254a"
msgid ""
"Tsk. Poor Karlach. Allied with the first sap she met, who will be so quickly "
"destroyed."
msgstr "쯧. 불쌍한 칼라크. 그녀가 만난 첫 동맹이 바보였고, 그 멍청이는 이렇게 빨리 사라지게 될테니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = d9323013-e67f-6b77-0158-04c88ed44a6c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:d9323013-e67f-6b77-0158-04c88ed44a6c
msgctxt "h0e977017g7554g40dbgb18eg72f7cf1cd4ce"
msgid ""
"She must pay for her crimes. If you capture her, you will have served Tyr "
"where we could not."
msgstr "그녀는 죗값을 치러야 하오. 만약 당신이 잡아준다면, 티르님을 위해 우리가 못한 일을 대신 하는 셈이오."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = dc65bc7f-6ac8-62cb-5c11-08d5de01e051
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:dc65bc7f-6ac8-62cb-5c11-08d5de01e051
msgctxt "h4959ef95g58edg43d2gb6cfg11509ee3ab2f"
msgid "Bless you in all your doings - in Justice's name."
msgstr "당신이 행하는 모든 일에 정의의 이름으로 축복을 내립니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = de17d498-454c-b773-49c1-114283dfd231
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:de17d498-454c-b773-49c1-114283dfd231
msgctxt "hfbf22078g904bg4567gb702g55f0f99d3f82"
msgid ""
"We are paladins of Tyr, Lord of Justice. He sent us after an infernal being, "
"straight out of the Nine Hells, hiding in the form of a one-horned tiefling."
msgstr ""
"우리는 정의의 군주 티르의 팔라딘이오. 티르께서는 우리를 보내, 아홉 지옥에서 튀어나와 뿔이 하나 달린 티플링의 모습으로 숨어 있는 "
"지옥의 존재를 쫓게 하셨소."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Narrator
#. NodeID = e07e5011-e434-4c91-93fd-d24588367c81
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Karlach_HasMet = True
#.      - GLO_Origin_PartOfTheTeam_Karlach = False
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:e07e5011-e434-4c91-93fd-d24588367c81
msgctxt "h401dd5abgf1e9g4298g846cgbc0df5600504"
msgid ""
"*You recognise the description - the burning tiefling you met by the river.*"
msgstr "*설명을 들으니 기억이 납니다. 강가에서 만났던 불타던 티플링을 말하는 것 같습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = e13192c0-64f4-2c92-93f9-d30c463c877a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:e13192c0-64f4-2c92-93f9-d30c463c877a
msgctxt "hd579a62eg453dg42d4g989fg0d8caa5de563"
msgid ""
"But she's dead now. She can't hurt anyone anymore. You are our protector - "
"Tyr's blessings are upon you."
msgstr ""
"하지만 그녀는 이미 죽었소. 더 이상 그 누구에게도 해를 끼칠 수 없을 거요. 당신은 우리의 수호자며, 티르의 가호가 당신과 함께 할 "
"거요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Player
#. NodeID = e1f17d22-17e3-4278-bff0-7993598007a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:e1f17d22-17e3-4278-bff0-7993598007a7
msgctxt "h96dc6d19g835cg4a10ga1c8gda14aaab9990"
msgid "I wish you and yours well, but I must be on my way soon."
msgstr "너와 동료들이 무사하길 바라지만, 난 곧 떠나야 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = e4a9db44-220f-355e-fe08-7a86a47eb8e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:e4a9db44-220f-355e-fe08-7a86a47eb8e7
msgctxt "h263c39a8g2a2dg4d60gb6eagf501aa152638"
msgid ""
"Before you go - I wouldn't be a proper paladin if I didn't try to enlist "
"your help in a righteous battle."
msgstr "가기전에 잠깐, 정의로운 전투로의 당신의 참전을 권유 조차 않는다면 나는 제대로 된 팔라딘이라 할 수 없소."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = e71720e7-f5cb-4532-af92-70dac721c4cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:e71720e7-f5cb-4532-af92-70dac721c4cb
msgctxt "h039627a6g8e96g4d55g8f99g28bc18a84c54"
msgid ""
"It's sacred... the most valuable thing I've ever held. I hope it serves you "
"as well as it served me."
msgstr "이건 신성한 것이오... 내 수중에 있던 것 중 가장 값진 것이지. 나를 도왔던 만큼 당신에게도 도움이 되길 바라오."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = ea0ae7cd-e607-2591-bc88-aff1ae06d0e1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:ea0ae7cd-e607-2591-bc88-aff1ae06d0e1
msgctxt "h138e63ddgcb32g4f9fg8a6bg398573e040dc"
msgid "She bested us once, and would have finished the job if not for you."
msgstr "그 여자는 우리를 한 번 패배시켰고, 당신이 아니었다면 우린 완전히 끝장 났을 거요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Player
#. NodeID = ebfb9f9a-b9b6-7e0f-bb3e-2423ffbb7d46
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_KarlachRecruitmentTollhouse_State_HostilitiesBegan = True
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:ebfb9f9a-b9b6-7e0f-bb3e-2423ffbb7d46
msgctxt "h9b7a006bg4b04g4b14g94dbgd1eee1cdeba2"
msgid "You're a terrible liar."
msgstr "거짓말이 서투르군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Player
#. NodeID = f22ebb12-28e6-f84b-7c47-0eb188e841f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:f22ebb12-28e6-f84b-7c47-0eb188e841f5
msgctxt "hf6dcad62gf64eg4b26g8628g96f740790348"
msgid "Say I buy your story. What then?"
msgstr "당신 이야기를 믿는다고 치고. 그다음엔?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Player
#. NodeID = f67a60d6-57b6-3610-4e29-5264f56f9cf8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_KarlachRecruitmentTollhouse_State_HeadNotAvailable = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:f67a60d6-57b6-3610-4e29-5264f56f9cf8
msgctxt "hc19ef918gbf51g4d13gb8bbgc908cfac3a3f"
msgid "She's dead, but I couldn't retrieve her head."
msgstr "그녀는 죽었어. 하지만 머리를 가져오진 못했어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Player
#. NodeID = f981daa6-5b3d-35e6-2a81-08527f3ba3cd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Karlach_HasMet = False
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:f981daa6-5b3d-35e6-2a81-08527f3ba3cd
msgctxt "hf8b1a38cg1eecg4416g8a0eg1458b5626aa3"
msgid "Where is this devil?"
msgstr "그 데빌은 어디 있지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA
#. Speaker = Anders
#. NodeID = ffad384e-3c49-c784-cf51-d5c1fb9e092c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_001_PostEA:ffad384e-3c49-c784-cf51-d5c1fb9e092c
msgctxt "h683c083ag40f1g4beeg834bg5a0783092539"
msgid ""
"Indeed. She's a uniquely vicious case. All the more reason she <i>must</i> "
"be stopped."
msgstr "물론이오. 저 여자는 정말 비할 데 없이 사악한 여자요. 그러니 더더욱 <i>반드시</i> 막아야 하는 이유가 되오."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_002_PostEA
#. Speaker = Trynn
#. NodeID = 1d38af24-43e3-3baa-ad4f-5aa86d5ffe7d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_Refugee_002_PostFightHasMet(1) = False
#.   Global:
#.      - PLA_PaladinsOfTyr_Event_KarlachLeavesHostile = True
#. SetFlags:
#.   Dialog:
#.     - PLA_Refugee_002_PostFightHasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_002_PostEA:1d38af24-43e3-3baa-ad4f-5aa86d5ffe7d
msgctxt "h3ca56afbg088bg4a80g95c5gfc5f32264bcc"
msgid ""
"I can only  thank you for choosing us over the devil. Tyr's blessings upon "
"you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_002_PostEA
#. Speaker = Trynn
#. NodeID = 2f992da5-44e4-4ec4-8a1e-f88af55ecf21
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_Refugee_002_HasMet(1) = True
#. SetFlags:
#.   Object:
#.     - ORI_Inclusion_End_Karlach(0) = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_002_PostEA:2f992da5-44e4-4ec4-8a1e-f88af55ecf21
msgctxt "hbdb97a56gb6bbg4c06g955dgb70c8903370d"
msgid "You can relax - this place is under Tyr's protection."
msgstr "안심해도 돼요. 이곳은 티르의 보호 아래 있어요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_002_PostEA
#. Speaker = Player
#. NodeID = 3d515ecd-808f-1591-8701-d9b61d2cd053
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_KarlachRecruitment_State_ProposedToJoin(1) = True
#.   Global:
#.      - PLA_KarlachRecruitmentTollhouse_Quest_AcceptedSearch = False
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_002_PostEA:3d515ecd-808f-1591-8701-d9b61d2cd053
msgctxt "h0483c03fg2ba9g4766ga1ecg4ad1287c5216"
msgid ""
"Are you one of the paladins of Tyr I heard about? I met a woman - Karlach - "
"who said you were after her."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_002_PostEA
#. Speaker = Trynn
#. NodeID = 590c9051-f3a5-6420-3357-4e09d3cd4685
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_002_PostEA:590c9051-f3a5-6420-3357-4e09d3cd4685
msgctxt "h92ec6ccdg0b99g4f6fgbb34gdf9b1b170a70"
msgid ""
"She nearly killed us all, and she says <i>we're </i>after <i>her?</i> Can't "
"stop a devil from lying, can you. <i></i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_002_PostEA
#. Speaker = Trynn
#. NodeID = 5ec17d81-b0ec-4e10-8634-2f10b6b1391b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_002_PostEA:5ec17d81-b0ec-4e10-8634-2f10b6b1391b
msgctxt "haf79bf5bgc876g44fag8702g4f9c675f557a"
msgid "There's more monsters than coin moving down this road."
msgstr "이 길을 따라 움직이는 건 금화가 아니라 괴물들이죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_002_PostEA
#. Speaker = Trynn
#. NodeID = 7ebc577b-ccde-4500-a716-8d7bd32b5753
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - PLA_Refugee_002_TollhouseMentioned(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_002_PostEA:7ebc577b-ccde-4500-a716-8d7bd32b5753
msgctxt "he84cb15cg7c1fg4979g9b6fgf3da2f7260fc"
msgid ""
"It <i>was</i> a tollhouse. By the time we arrived, it was more like a "
"slaughterhouse."
msgstr "통행료 징수소 <i>였어요</i>. 우리가 도착했을 때 쯤에는 도살장에 더 가까웠죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_002_PostEA
#. Speaker = Trynn
#. NodeID = 8bfd6415-aaa3-4e8d-a8d2-85d224f83f99
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_002_PostEA:8bfd6415-aaa3-4e8d-a8d2-85d224f83f99
msgctxt "h146da17fgcf1eg40fagb9b3g0de23daf9d07"
msgid "If there's any gold left, that's where it'll be."
msgstr "남아있는 금화가 조금이라도 있다면, 거기에 있을 테죠."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_002_PostEA
#. Speaker = Player
#. NodeID = 8d64a2e9-2d81-4211-8bfe-331cccd9ae25
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_Refugee_002_TollhouseMentioned(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_002_PostEA:8d64a2e9-2d81-4211-8bfe-331cccd9ae25
msgctxt "hc355d7bbg239cg4277gb963ged22a4457f55"
msgid "Tollhouses mean gold. Seen any around?"
msgstr "통행료 징수소라면 금화도 있겠군. 뭐 본 거 있소?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_002_PostEA
#. Speaker = Trynn
#. NodeID = 9d69d73e-92e9-d864-ae60-00af4e9aaee1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_Refugee_002_PostFightHasMet(1) = False
#.   Global:
#.      - PLA_PaladinsOfTyr_Event_KarlachLeavesHostile = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_002_PostEA:9d69d73e-92e9-d864-ae60-00af4e9aaee1
msgctxt "hd19ee26dg86e6g4f73g8877g8ef7a081160e"
msgid "Go well, my friend."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_002_PostEA
#. Speaker = Player
#. NodeID = 9dcb6754-7ad0-4e11-b5df-6ed6b07810fc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - PLA_Refugee_002_AskedAboutHatch(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_002_PostEA:9dcb6754-7ad0-4e11-b5df-6ed6b07810fc
msgctxt "hd80881cag730bg4021g8c18g26114db0ba84"
msgid "Why? What's down there?"
msgstr "왜? 아래 뭐가 있길래?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_002_PostEA
#. Speaker = Trynn
#. NodeID = a45dafee-e0f0-91a2-7b2b-55915c257255
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - KARLACH(1) = True
#. SetFlags:
#.   Dialog:
#.     - PLA_Refugee_002_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_002_PostEA:a45dafee-e0f0-91a2-7b2b-55915c257255
msgctxt "hfd1124adgc5a7g43c6ga87eg5df775f73998"
msgid "You - devil! Stay back!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_002_PostEA
#. Speaker = Trynn
#. NodeID = e3ecf802-62c9-4138-aa3c-4ecd64f6b3a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_002_PostEA:e3ecf802-62c9-4138-aa3c-4ecd64f6b3a4
msgctxt "h3ea5c337gab39g4293gbb4dg6680997ccb5e"
msgid ""
"Corpse, half-rotted to mush. Must have been down there a tenday or more."
msgstr "시체요. 반쯤 썩어 문드러졌어요. 그 아래에 못해도 열흘은 방치된 모양이에요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_002_PostEA
#. Speaker = Trynn
#. NodeID = e72ab6b5-2ec4-488a-85b4-0f080cfb81a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_002_PostEA:e72ab6b5-2ec4-488a-85b4-0f080cfb81a7
msgctxt "h96b4364bgec04g4e07g896ag4a203c6b965f"
msgid ""
"There's a locked door down the hatch. Doesn't look like anyone managed to "
"get in."
msgstr "해치 아래에 잠긴 문이 있죠. 아직 아무도 들어가지 못한 것 같더군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_002_PostEA
#. Speaker = Trynn
#. NodeID = e7c38089-775c-03cd-586c-c232b7724273
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#. SetFlags:
#.   Dialog:
#.     - PLA_Refugee_002_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_002_PostEA:e7c38089-775c-03cd-586c-c232b7724273
msgctxt "h188ff7fdg4180g409eg9345g83c243b844fd"
msgid "You - devil! Stay back!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_002_PostEA
#. Speaker = Player
#. NodeID = eb21ccac-4134-4664-8b3c-db06a530258f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_002_PostEA:eb21ccac-4134-4664-8b3c-db06a530258f
msgctxt "h4828950fg49bfg432eg9cfeg6745583a83cb"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_002_PostEA
#. Speaker = Trynn
#. NodeID = ec8f940f-9fa7-4b00-8721-db5b476ca17b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_Refugee_002_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - PLA_Refugee_002_HasMet(1) = True
#.   Object:
#.     - ORI_Inclusion_End_Karlach(0) = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_002_PostEA:ec8f940f-9fa7-4b00-8721-db5b476ca17b
msgctxt "hdfeddabeg3fadg41fag8141gab7e6a9e2dd5"
msgid ""
"If you want to go poking around in the cellar, be my guest. Plug your nose "
"first though."
msgstr "지하실을 뒤지고 싶거든 마음대로 하세요. 근데 코부터 틀어막고 들어가는 게 나을 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_002_PostEA
#. Speaker = Player
#. NodeID = f52ed2f0-5840-454e-b589-795ef5143127
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_002_PostEA:f52ed2f0-5840-454e-b589-795ef5143127
msgctxt "hb8d3f295g82e9g4675gbf62ga4c4c8f7d6ba"
msgid "This is a nice place to hole up in. What is it?"
msgstr "숨기에 좋은 장소 같군요. 여기는 어디죠?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_002_PostEA
#. Speaker = Trynn
#. NodeID = faabde77-e9c9-80ff-6eff-c1992f6dd2f7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_002_PostEA:faabde77-e9c9-80ff-6eff-c1992f6dd2f7
msgctxt "h55a67bebga294g433cgb6f8g7c74c0ff172c"
msgid "Unless you took her head already, I suggest you stay far away from her."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_003_PostEA
#. Speaker = Cyrel
#. NodeID = 24498501-15e1-47a6-a3bf-e9370e5dafe5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - ORI_Inclusion_End_Karlach(0) = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_003_PostEA:24498501-15e1-47a6-a3bf-e9370e5dafe5
msgctxt "hc8f15122gcce7g4592g86bagb28d25429809"
msgid ""
"I'm still looking to shift some supplies. Don't have much to spare, but it's "
"more than we can carry."
msgstr "아직 팔아치울 물건이 좀 있어. 보급 상황이 여유롭지는 않지만, 우리가 다 나를 수 없는 양이라서 말이야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_003_PostEA
#. Speaker = Cyrel
#. NodeID = 4b4facbb-1de6-43d1-fce1-48ffc8006bb4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_003_PostEA:4b4facbb-1de6-43d1-fce1-48ffc8006bb4
msgctxt "h36b9c228gbea7g4199g98fegec8f405e564e"
msgid "Back, beast! Back!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_003_PostEA
#. Speaker = Player
#. NodeID = 51da6c7b-ee74-4fc6-aa44-b47a098e7c97
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_003_PostEA:51da6c7b-ee74-4fc6-aa44-b47a098e7c97
msgctxt "hf37eae17gd709g4d75ga3c0gbeb7254b1bb4"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_003_PostEA
#. Speaker = Player
#. NodeID = 52337de5-9411-458e-a1ed-f852a4c93ac4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_003_PostEA:52337de5-9411-458e-a1ed-f852a4c93ac4
msgctxt "h71586e73g4234g4b10gab4agc9da564d3e1c"
msgid "I'll take those supplies now - and everything else you own."
msgstr "그 보급품은 내가 가져가도록 하겠어. 네가 가진 것도 전부 다 가져가지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_003_PostEA
#. Speaker = Cyrel
#. NodeID = 59b7cb5a-a9ce-49a2-b9d8-ecb2d4fcc3e4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_KarlachRecruitmentTollhouse_HasMet_Refugee003(1) = False
#. SetFlags:
#.   Dialog:
#.     - PLA_KarlachRecruitmentTollhouse_HasMet_Refugee003(1) = True
#.   Object:
#.     - ORI_Inclusion_End_Karlach(0) = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_003_PostEA:59b7cb5a-a9ce-49a2-b9d8-ecb2d4fcc3e4
msgctxt "h1ad32bedg32c1g440cg946cg631850d32e2d"
msgid "Need any supplies? We've fewer mouths to feed now."
msgstr "보급품이 필요해? 이제 먹일 입이 줄긴 했거든."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_003_PostEA
#. Speaker = Player
#. NodeID = 6e8fbd64-8512-4d83-b7dc-83db567cbd1e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_003_PostEA:6e8fbd64-8512-4d83-b7dc-83db567cbd1e
msgctxt "hbf33e79dgbd72g4ba7g855cga75dd0fc4f05"
msgid "How many did you lose?"
msgstr "얼마나 줄었길래?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_003_PostEA
#. Speaker = Cyrel
#. NodeID = 74a637c8-430b-5e08-7547-0d0d770d5688
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_003_PostEA:74a637c8-430b-5e08-7547-0d0d770d5688
msgctxt "hbb2d0845g4998g4402g91cbg76d53077bf2d"
msgid ""
"Talk to Anders if you want the details. I don't have it in me to recount the "
"horror."
msgstr "자세한 걸 알고 싶으면 앤더스에게 물어봐. 난 그 끔찍한 일을 더 이상 떠올리긴 싫으니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_003_PostEA
#. Speaker = Cyrel
#. NodeID = 85310ef0-1895-0f04-6260-379b48f074f3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - PLA_PaladinsOfTyr_Event_KarlachLeavesHostile = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_003_PostEA:85310ef0-1895-0f04-6260-379b48f074f3
msgctxt "hc0dfcf2bg5a83g4f63g9b03g090ef177e6f2"
msgid "After you did us such a good turn, perhaps I can be of use to you, too."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_003_PostEA
#. Speaker = Cyrel
#. NodeID = 85310ef0-1895-0f04-6260-379b48f074f3
#. HandlePath = TaggedText[0].TagText[1]
#. CheckFlags:
#.   Global:
#.      - PLA_PaladinsOfTyr_Event_KarlachLeavesHostile = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_003_PostEA:85310ef0-1895-0f04-6260-379b48f074f3
msgctxt "h7981937egccd9g4bbcgbdcbgacf32dc285d3"
msgid "Tyr be with you."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_003_PostEA
#. Speaker = Cyrel
#. NodeID = 85310ef0-1895-0f04-6260-379b48f074f3
#. HandlePath = TaggedText[0].TagText[2]
#. CheckFlags:
#.   Global:
#.      - PLA_PaladinsOfTyr_Event_KarlachLeavesHostile = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_003_PostEA:85310ef0-1895-0f04-6260-379b48f074f3
msgctxt "h2aecbfc3g1236g4889g9bbag8adc82c0b0a3"
msgid "Blessings for the road ahead."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_003_PostEA
#. Speaker = Cyrel
#. NodeID = 89de8a1d-b5a7-d81d-4211-fbf42d51d012
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - KARLACH(1) = True
#. SetFlags:
#.   Dialog:
#.     - PLA_KarlachRecruitmentTollhouse_HasMet_Refugee003(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_003_PostEA:89de8a1d-b5a7-d81d-4211-fbf42d51d012
msgctxt "hdf6a1458g703cg4a1cg9319g5be3af4f6da1"
msgid ""
"Ye gods - come back for us, have you, devil? Anders! The beast has returned!"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_003_PostEA
#. Speaker = Player
#. NodeID = 8c0dbff8-8b21-4091-ad98-f85232b46a0e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC_TYR(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_003_PostEA:8c0dbff8-8b21-4091-ad98-f85232b46a0e
msgctxt "ha22ed337gadd9g4749ga077gb2e67bfb655a"
msgid "I pray their souls have returned to Tyr's grace."
msgstr "그 영혼들이 티르의 은혜 아래 있기를 기도하겠소."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_003_PostEA
#. Speaker = Cyrel
#. NodeID = 8cb2e48e-6342-ec92-fe2b-09bb9bcf34c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_003_PostEA:8cb2e48e-6342-ec92-fe2b-09bb9bcf34c6
msgctxt "h1b1d123egc202g457fgb03egb4281e04d777"
msgid ""
"Hunting her down? Trying to survive her, more like. You can't listen to a "
"devil like that. They'll pour poison in your ear and say it's honey."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_003_PostEA
#. Speaker = Cyrel
#. NodeID = a3ca8cba-f4a8-4fe8-9515-4e33a51877a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_003_PostEA:a3ca8cba-f4a8-4fe8-9515-4e33a51877a5
msgctxt "hfcf1415ag57a0g4c44g8568g6cdbbc8316e2"
msgid ""
"The Lord of Justice sent us after a devil haunting this area. We squared off "
"against her. We lost."
msgstr "정의의 군주께서 이곳을 떠도는 데빌을 처리하라고 우릴 보내셨어. 우린 그녀와 대치했지만, 패배했지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_003_PostEA
#. Speaker = Player
#. NodeID = a8255b97-cb03-4ac6-ad29-3f173883a134
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_003_PostEA:a8255b97-cb03-4ac6-ad29-3f173883a134
msgctxt "h7463c261g6e5ag4545gbfabgddba539e2406"
msgid "Let's see what you have to trade."
msgstr "어떤 걸 파는지 한 번 볼까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_003_PostEA
#. Speaker = Player
#. NodeID = aa5b5d28-190a-4bd0-b5a1-40f7ffa2f87b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_003_PostEA:aa5b5d28-190a-4bd0-b5a1-40f7ffa2f87b
msgctxt "h76b034f5g26eag48d5g9cc8g4a485fe242c3"
msgid "What happened to you?"
msgstr "뭔 일이 있었는데?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_003_PostEA
#. Speaker = Player
#. NodeID = aab26de7-28ff-0eef-3774-061571b085c1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_KarlachRecruitment_State_ProposedToJoin(1) = True
#.   Global:
#.      - PLA_KarlachRecruitmentTollhouse_Quest_AcceptedSearch = False
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_003_PostEA:aab26de7-28ff-0eef-3774-061571b085c1
msgctxt "h3f97b611g7417g43f9g8e5fg3800d7761e45"
msgid "Paladins of Tyr, are you? The ones hunting down a woman named Karlach?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_003_PostEA
#. Speaker = Cyrel
#. NodeID = ac0ea08a-9486-4627-840f-4d46e22d5684
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - PLA_Refugee_003_Uncertainty(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_003_PostEA:ac0ea08a-9486-4627-840f-4d46e22d5684
msgctxt "h0b8f798fg048fg4e50g8d6bg47f7f1a21177"
msgid "I... yes. I hope so too. Thank you."
msgstr "네... 네. 그러길 바랍니다. 고맙군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_003_PostEA
#. Speaker = Cyrel
#. NodeID = ba294770-9d9e-4de4-908b-270e1ad0dea9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - PLA_KarlachRecruitmentTollhouse_HasMet_Refugee003(1) = False
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = True
#. SetFlags:
#.   Dialog:
#.     - PLA_KarlachRecruitmentTollhouse_HasMet_Refugee003(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_003_PostEA:ba294770-9d9e-4de4-908b-270e1ad0dea9
msgctxt "hd8d895a8gbba7g4b4fg9ff5g4b1ccaa72f17"
msgid "Keep that beast away from us - you hear?"
msgstr "저 야수를 우리한테서 떨어뜨려 놓으라고, 알아 들었어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_003_PostEA
#. Speaker = Cyrel
#. NodeID = c37d0c3a-5ce1-4791-8628-2a93458a6403
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_003_PostEA:c37d0c3a-5ce1-4791-8628-2a93458a6403
msgctxt "hda26348fg4ae2g43b4g844bg04715f67fde2"
msgid "Two. Both stalwarts of Tyr, sworn to uphold justice."
msgstr "두 명. 정의를 떠받들기로 맹세한 티르의 충실한 종들이었어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_003_PostEA
#. Speaker = Karlach
#. NodeID = cf3490e7-9c8e-06be-2d0a-8e04e675a30d
#. HandlePath = TaggedText[0].TagText[0]
