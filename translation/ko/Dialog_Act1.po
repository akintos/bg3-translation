msgctxt "h20a60269gbde0g40e5g88b0g4432198ea4d6"
msgid "But not me!"
msgstr "나는 안 당해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_HarperBooster_ScaredBoar
#. Speaker = Player
#. NodeID = 142ca7f8-7e4e-681d-9f0a-ad14693616bb
