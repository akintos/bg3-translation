msgctxt "h2e2c9516gcb6ag42d5ga119gdfcad5534b93"
msgid "Fresh water. There must be a settlement somewhere nearby."
msgstr "민물이군. 분명 근처에 주거지가 있을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_HarperBooster_AD_Rock
