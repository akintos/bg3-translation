msgctxt "he2ed0b2cgd4ffg41e4g98b9g8520f5e5388c"
msgid "To arms!"
msgstr "무기를 들어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf
