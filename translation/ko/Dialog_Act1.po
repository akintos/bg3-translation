msgctxt "hd5dc8679gfa6bg498bg9937ged323a86bec5"
msgid "Baretha..."
msgstr "바레사..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithCaptain_Dead
#. Speaker = Narrator
#. NodeID = d42479c5-8228-474f-9123-32d91076247f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
