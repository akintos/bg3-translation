#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001_Dead:94b31ce0-79f9-4c46-8368-98c0b458a55b
msgctxt "h6c06add1g9a0cg46c7g95b7g4012447dea79"
msgid "What were you doing here?"
msgstr "여기서 뭘 하고 있었지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001_Dead
#. Speaker = Herdmaster Skarjall
#. NodeID = 952230cf-b4cc-4c0d-b68a-8f200fb4bf3e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001_Dead:952230cf-b4cc-4c0d-b68a-8f200fb4bf3e
msgctxt "h4f660c27g0f71g457dga979g2b1a0062bad7"
msgid "Many... months... dig..."
msgstr "여러... 달 동안... 팠지..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001_Dead
#. Speaker = Herdmaster Skarjall
#. NodeID = a8b939e1-2049-422e-841d-6e38e7d56e06
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001_Dead:a8b939e1-2049-422e-841d-6e38e7d56e06
msgctxt "hfb4d0da6g9f8fg40a9gba06g2310d18c460a"
msgid "Skarjall... herdmaster... rothé..."
msgstr "스카얄... 조련사... 로테..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001_Dead
#. Speaker = Herdmaster Skarjall
#. NodeID = af29aca8-7cd8-f9aa-6ae0-d77988cb971e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001_Dead:af29aca8-7cd8-f9aa-6ae0-d77988cb971e
msgctxt "hd2b2ab81gf4e4g489dg9b0dge006d69f8110"
msgid "No... clan expedition... treasure..."
msgstr "아니... 일족의 원정... 보물..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001_Dead
#. Speaker = Narrator
