msgctxt "h4a86fc7bg026ag4debg94d8g1cb63d65cda6"
msgid "Yes! That's - yes!"
msgstr "그래! 그거 - 맞아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MushroomHunter
#. Speaker = Baelen Bonecloak
#. NodeID = 8b348886-9693-bc18-24e1-fafb27f4fb1c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_MushroomHunter_Event_AteMushroom = True
