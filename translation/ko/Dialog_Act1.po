msgctxt "hde5ffeddg8b06g45f7gbd69g0f6e2bbeced3"
msgid "*Moo!*"
msgstr "*음머!*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_DevilishOx_MeetAtDruidsGrove
#. Speaker = Player
#. NodeID = 993c5385-ccfc-c2a1-fdf4-6b5e2874af1e
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_DevilishOx_MeetAtDruidsGrove:993c5385-ccfc-c2a1-fdf4-6b5e2874af1e
msgctxt "h4e7f68d0gc3fbg4c63ga75dg172d1f3e4e72"
msgid ""
"Fine. I heard the tieflings are going to butcher one of you for food, so "
"your secret will die with you."
msgstr "좋아. 티플링들이 너희 중 한 마리 잡아먹어야겠다고 떠들던데, 그 잘난 비밀 무덤까지 갖고 가게 생겼네."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_DevilishOx_MeetAtDruidsGrove
#. Speaker = Phasm
#. NodeID = 9dfd7c88-2f95-5631-4d11-d0d3f1b4e624
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_DevilishOx_MeetAtDruidsGrove_Incapable = True
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_DevilishOx_MeetAtDruidsGrove:9dfd7c88-2f95-5631-4d11-d0d3f1b4e624
msgctxt "h17890669gb6c2g440dga158geb17aa18e0c5"
msgid "No. You are... incapable."
msgstr "아니. 너는... 감당 못 해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_DevilishOx_MeetAtDruidsGrove
#. Speaker = Phasm
#. NodeID = 9f4f5363-a7eb-14ce-7009-65b1c4bf47d1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_DevilishOx_MeetAtDruidsGrove_State_Peaceful(1) = True
