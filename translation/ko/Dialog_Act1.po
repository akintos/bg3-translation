msgctxt "h6e043151g4c8cg4749g97b3g239d731e7b6b"
msgid "Goblins on the high ground."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_PAD_SpottedAmbush
#. Speaker = Player
#. NodeID = c29822c6-aeb2-fee4-59ee-6eb89b6f0468
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_PAD_SpottedAmbush:c29822c6-aeb2-fee4-59ee-6eb89b6f0468
msgctxt "h38080c57g5c53g4b70g806agf8ff015e5370"
msgid "There, on the rooftops. Fresh blood awaits."
msgstr "저기, 지붕 위에. 피를 볼 시간이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_PAD_SpottedAmbush
#. Speaker = Player
#. NodeID = c29822c6-aeb2-fee4-59ee-6eb89b6f0468
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_PAD_SpottedAmbush:c29822c6-aeb2-fee4-59ee-6eb89b6f0468
msgctxt "he7ea7c9dg18b6g413ag963ag45f3fda5790d"
msgid "Goblins ahead. Looks like they're laying an ambush."
msgstr "앞에 고블린이 있어. 매복을 하고 기다리는 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_PAD_SpottedAmbush
#. Speaker = Player
#. NodeID = c29822c6-aeb2-fee4-59ee-6eb89b6f0468
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_PAD_SpottedAmbush:c29822c6-aeb2-fee4-59ee-6eb89b6f0468
msgctxt "h746d8334gbb0bg43d6g8ad3g2394ee52d152"
msgid "Goblins are close. I'd know that stench anywhere."
msgstr "고블린이 가까이 있어. 놈들의 악취는 어디서든 알아볼 수 있지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_PAD_SpottedAmbush
#. Speaker = Player
#. NodeID = c29822c6-aeb2-fee4-59ee-6eb89b6f0468
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_DWARF
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_PAD_SpottedAmbush:c29822c6-aeb2-fee4-59ee-6eb89b6f0468
msgctxt "h9ea53899ga634g4863g9325g9d4c4b32945a"
msgid "Ugh. Fresh goblin stench. They're close."
msgstr "우웩. 고블린의 악취가 느껴지는데. 가까이 있는 것 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_PAD_SpottedAmbush
#. Speaker = Player
#. NodeID = c29822c6-aeb2-fee4-59ee-6eb89b6f0468
#. HandlePath = TaggedText[7].TagText[0]
#. TagRule: REALLY_DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_PAD_SpottedAmbush:c29822c6-aeb2-fee4-59ee-6eb89b6f0468
msgctxt "h99de093egd554g4ab3g9e5agf264aa94b554"
msgid "Vermin, on the rooftops."
msgstr "해충들이군, 지붕 위다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_PAD_SpottedAmbush
#. Speaker = Player
#. NodeID = c29822c6-aeb2-fee4-59ee-6eb89b6f0468
#. HandlePath = TaggedText[8].TagText[0]
#. TagRule: RANGER
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_PAD_SpottedAmbush:c29822c6-aeb2-fee4-59ee-6eb89b6f0468
msgctxt "h08ca9460g6064g4d54g9b37g5e7f2eb6ffbe"
msgid "Looks like an ambush. A clumsy one."
msgstr "매복이 있는 것 같은데. 어설프군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_PAD_SpottedAmbush
#. Speaker = Player
#. NodeID = c29822c6-aeb2-fee4-59ee-6eb89b6f0468
#. HandlePath = TaggedText[9].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_PAD_SpottedAmbush:c29822c6-aeb2-fee4-59ee-6eb89b6f0468
msgctxt "h784414f6gf9cag42f3g88dbg04dd4494383b"
msgid "Something's waiting up ahead."
msgstr "앞쪽에 뭔가 기다리고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_PatrollingGoblin
#. Speaker = Goblin Brawler
