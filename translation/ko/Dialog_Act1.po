msgctxt "hea944fa1g0d97g4ee9g8d1fge0f153fe43f1"
msgid "Doesn't matter... nothing matters..."
msgstr "관심 없어... 아무것도..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_DeadPrisoner_Dead
