msgctxt "h30f265ecgc504g41f3g9a8bgc86642762964"
msgid "More heretical symbols. Of course."
msgstr "더 많은 불경한 문양들이네. 뻔하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/VBs/GOB_ShadowHeart_VB_Mural
