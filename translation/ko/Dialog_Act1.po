msgstr "<i>으르르.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Player
#. NodeID = 76f9a799-62cc-7ba0-dbef-2e5101c6714b
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
