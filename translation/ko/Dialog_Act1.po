msgctxt "h8d51165dg6551g4a20g89b5g7e84293c64a8"
msgid "A pact? Which devil did you deal with?"
msgstr "서약이라고? 무슨 데빌과 거래를 했나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_Dead_PostEA
