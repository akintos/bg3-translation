msgctxt "hc17b13a5g73b2g4001g89f8g861b25fae9e0"
msgid "<i>Melt into the shadows.</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_SecludedSpot_Trespassing
#. Speaker = Brawler Rancer
#. NodeID = 38425ad4-9856-687c-f34f-27a139a9be7f
