#. SetFlags:
#.   Dialog:
#.     - CRE_General_HasMet_MageHandKid02(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_MageHandKid02:2424d389-cd08-82b4-2a64-f1b365293330
msgctxt "hb9ab2686gfd13g4bfag8096g1196324ac5d3"
msgid "Open the chest! <i>Open the chest!</i> ...Please?"
msgstr "상자를 열어! <i>상자를 열어!</i> ...주실래요?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_MageHandKid02
