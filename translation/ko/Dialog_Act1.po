msgctxt "h0907e9efgb1fdg4991gae43g833cf316a886"
msgid "Quiet. <i>Please.</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinSleeper_02
#. Speaker = Narrator
#. NodeID = bad2d076-2f0b-b3a9-e693-14eb3a91d827
