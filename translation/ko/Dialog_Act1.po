msgctxt "hacb67a88g6531g41c7gbf04g8a4222076c39"
msgid ""
"*A shadow swims across your vision, and a familiar voice tells you to be "
"calm. You are loved.*"
msgstr "*그림자가 낀 듯이 눈앞이 흐려지더니, 익숙한 목소리가 당신을 달래줍니다. 사랑이 느껴집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards
#. Speaker = Goblin Warrior
#. NodeID = dac20c47-d6fd-db5f-28e3-003816f30eb5
