msgctxt "h46ea6ee2g96abg446dg97b3g55e305aab37f"
msgid "((*<b>I am Sovereign. and you bring the Rot. <i>duergar</i></b>*))"
msgstr "((*<b>짐은 군주다. 너는 부패를 불러온다. <i>듀에르가여.</i></b>*))"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_CheckpointGuard_000
#. Speaker = Player
#. NodeID = ac18f6c6-38dd-d969-d85e-fc4e914eb733
#. HandlePath = TaggedText[0].TagText[0]
