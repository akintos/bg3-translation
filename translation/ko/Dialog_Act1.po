#: Mods/Gustav/Story/Dialogs/Act1/DEN/SFX_DEN_RaidingParty_PleaAtTheGate:aa945866-4b46-707c-8ead-63b79df2171a
msgctxt "h41b5f5b2g3b5bg4d54g82dfgcfefa58f3ac9"
msgid ""
"VO_SFX: Death cry - While turning the wheel to open the gate, Kanon gets hit "
"by an arrow in the neck and dies"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_AD_BridgeSign
#. Speaker = Player
#. NodeID = 44fb72c3-faf6-18a5-db06-349a7bbf9746
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_AD_BridgeSign:44fb72c3-faf6-18a5-db06-349a7bbf9746
msgctxt "hf73ad394g45feg4602g8ffcg575a073b4064"
msgid "'West - Baldur's Gate. East - Elturel.'"
msgstr "'서쪽 - 발더스 게이트. 동쪽 - 엘투렐.'"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_AD_Combat_GnomeGoblin1_000
#. Speaker = Fezzerk
#. NodeID = c21c1a38-a46d-492a-860f-22f15e42f8a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_AD_Combat_GnomeGoblin1_000:c21c1a38-a46d-492a-860f-22f15e42f8a4
msgctxt "h6a7799c7gee96g48fcg99a6g5ec9440d053c"
msgid "Attack! Get your blades wet!"
msgstr "공격하라! 칼날을 적셔버려!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_AD_Combat_GnomeGoblin1_001
#. Speaker = Fezzerk
#. NodeID = 1d520ce6-df1b-4ef1-9b09-07d270215d72
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_AD_Combat_GnomeGoblin1_001:1d520ce6-df1b-4ef1-9b09-07d270215d72
msgctxt "hb78c207egcf16g4354g8228gdd4b64dea884"
msgid "Gonna poke some extra holes in you!"
msgstr "네 몸에 구멍을 더 내주마!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_AD_Combat_GnomeGoblin1_002
#. Speaker = Fezzerk
#. NodeID = 93d65e3f-cd36-4828-8384-7b9d3df6a1c5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_AD_Combat_GnomeGoblin1_002:93d65e3f-cd36-4828-8384-7b9d3df6a1c5
msgctxt "h8eb56b4bg4967g415egbee0g753aedf4f949"
msgid "The Absolute's got my back - I ain't afraid of nothin'!"
msgstr "절대자께서 날 지켜주시니, 난 전혀 두려울 게 없다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_AD_Combat_GnomeGoblin1_003
#. Speaker = Fezzerk
#. NodeID = 0d6ec8b3-db7e-4eaa-b6ac-08beee172abe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_AD_Combat_GnomeGoblin1_003:0d6ec8b3-db7e-4eaa-b6ac-08beee172abe
msgctxt "h7625334dg0a72g4d85gbe49g316b4bc219d8"
msgid "The worms'll feast on your sorry carcass when I'm done with you!"
msgstr "구더기가 불쌍한 니 시체를 뜯으며 잔치를 벌일 거다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_AD_Combat_GnomeGoblin2
#. Speaker = Goblin Devout
#. NodeID = 04a2f4bb-0840-47c3-8c8d-3a1bbb42d0f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_AD_Combat_GnomeGoblin2:04a2f4bb-0840-47c3-8c8d-3a1bbb42d0f4
msgctxt "he06029a2ge600g40f1ga334g3ed3a10e2b84"
msgid "For the Absolute!"
msgstr "절대자님을 위해!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_AD_EmptyMindflayerPod
#. Speaker = Narrator
#. NodeID = 938d63d9-1270-4b7a-af8f-e19777cefddd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_AD_EmptyMindflayerPod:938d63d9-1270-4b7a-af8f-e19777cefddd
msgctxt "h35db6343gdf7ag4696ga2b5g6028865f4822"
msgid ""
"*An empty mind flayer vessel. If its occupant survived, they're nowhere to "
"be seen.*"
msgstr "*텅 빈 마인드 플레이어 포드입니다. 탑승자가 살아남았는지는 모르지만, 이곳에는 없습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_Ambush_AD_Combat_Goblins_Caster_01
#. Speaker = Goblin Booyahg
#. NodeID = 11cd40f1-84e6-4818-ae6b-57b648cfca66
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_Ambush_AD_Combat_Goblins_Caster_01:11cd40f1-84e6-4818-ae6b-57b648cfca66
msgctxt "h6c2dfe35ga72bg4059g8611g55c8fbe0043a"
msgid "Gonna add your ears to my collection once you're dead!"
msgstr "귀를 잘라서 수집품에 더해 주마!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_Ambush_AD_Combat_Goblins_Ranger_01
#. Speaker = Goblin Tracker
#. NodeID = 17b19970-5e87-4292-9935-0591e54285ae
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_Ambush_AD_Combat_Goblins_Ranger_01:17b19970-5e87-4292-9935-0591e54285ae
msgctxt "hd6dfdfdcgea16g4f5eg9407g940170b08f6e"
msgid "You'll look good with a few arrows sticking out of your gut!"
msgstr "배때지에 화살 몇 개만 꽂으면 훨씬 더 보기 좋을 거다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Ambush_PatrollingGoblin_AD_JoinOgreFight
#. Speaker = Goblin Brawler
#. NodeID = c2372b35-bd48-6ed9-d932-91dee492d5d3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Ambush_PatrollingGoblin_AD_JoinOgreFight:c2372b35-bd48-6ed9-d932-91dee492d5d3
msgctxt "h37965442gd5ccg46cegaeaagc0e9d5f72249"
msgid "Oi! You fightin' them ogres, then you fightin' with me!"
msgstr "야! 너 그 오우거들과 싸우고 있다면, 너 나와 함께 싸워야 해!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_ApothecaryGoblins_AD_Boss
#. Speaker = Tracker Slice
#. NodeID = a6d6f8f9-6ad9-e71e-27ab-3c901eff0914
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_ApothecaryGoblins_AD_Boss:a6d6f8f9-6ad9-e71e-27ab-3c901eff0914
msgctxt "h53781025gfb51g47e9g8e51gcc5931853dec"
msgid "Gotta be somethin' in this heap."
msgstr "이 더미에 뭔가 있을 거야."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_ApothecaryGoblins_AD_BossAndSubordinate
#. Speaker = Tracker Slice
#. NodeID = 13f8bf86-e020-b2e3-1102-cc047a580141
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_ApothecaryGoblins_AD_BossAndSubordinate:13f8bf86-e020-b2e3-1102-cc047a580141
msgctxt "hb2ecc618g87a3g4d1ag837cg793aaf4e5931"
msgid "Look. Don't talk."
msgstr "이봐. 말하지 마."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_ApothecaryGoblins_AD_BossAndSubordinate
#. Speaker = Goblin Warrior
#. NodeID = 3f582bc4-e877-4f5b-a4da-f4191a4a83ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_ApothecaryGoblins_AD_BossAndSubordinate:3f582bc4-e877-4f5b-a4da-f4191a4a83ac
msgctxt "h8f2586fbg6a36g4e06gb5abg942d16bbe109"
msgid "I <i>been </i>looking."
msgstr "찾고 <i>있는 중</i>이에요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_ApothecaryGoblins_AD_BossAndSubordinate
#. Speaker = Tracker Slice
#. NodeID = e829393c-f656-95c8-129f-44753360204f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_ApothecaryGoblins_AD_BossAndSubordinate:e829393c-f656-95c8-129f-44753360204f
msgctxt "h89415f33g22fcg490bg9416gc25bda566ece"
msgid "And you got nothing to show for it but your own arse."
msgstr "그러면서 찾은것 중에 네 엉덩이 말곤 보여 줄게 없지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_ApothecaryGoblins_AD_BossAndSubordinate
#. Speaker = Goblin Warrior
#. NodeID = f01de181-c4e8-736a-59d0-ef1b8c7375b0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_ApothecaryGoblins_AD_BossAndSubordinate:f01de181-c4e8-736a-59d0-ef1b8c7375b0
msgctxt "hb7561329g1736g49cagada1gd3cdb0d4d364"
msgid "Nothing here, boss."
msgstr "여기는 없어요, 대장."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_ApothecaryGoblins_AD_GoblinLootsTrash
#. Speaker = Brawler Brek
#. NodeID = 5c7a7ecf-17f2-1daa-8da0-a80d42d7d785
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_ApothecaryGoblins_AD_GoblinLootsTrash:5c7a7ecf-17f2-1daa-8da0-a80d42d7d785
msgctxt "h76a1f180g695eg4797gbfb3g200bdd25dcb0"
msgid "Garbage."
msgstr "쓰레기군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_ApothecaryGoblins_AD_Goblin_00
#. Speaker = Goblin Warrior
#. NodeID = bca97469-2765-5dbf-180c-a4be59749de4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_ApothecaryGoblins_AD_Goblin_00:bca97469-2765-5dbf-180c-a4be59749de4
msgctxt "h04ae526ag5585g455bg8782g4c716a788abc"
msgid ""
"Watch what you touch. If'n it smells like wee it's <i>claimed</i>, right?"
msgstr "조심히 다루라고. 오줌 냄새를 풍기면 이미 누가 <i>차지한</i> 거니까, 알겠어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_ApothecaryGoblins_AD_GoblinsLooting
#. Speaker = Brawler Brek
#. NodeID = 38c9c5ca-8718-edd4-4ce2-e1c379428401
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_ApothecaryGoblins_AD_GoblinsLooting:38c9c5ca-8718-edd4-4ce2-e1c379428401
msgctxt "ha40a17f9g0b12g4891g89ecg69131d2ad0ba"
msgid "'Less you like trash."
msgstr "쓰레기라도 괜찮다면."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_ApothecaryGoblins_AD_GoblinsLooting
#. Speaker = Tracker Slice
#. NodeID = af3537e4-b56a-cead-3e8a-0416acb6c93f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_ApothecaryGoblins_AD_GoblinsLooting:af3537e4-b56a-cead-3e8a-0416acb6c93f
msgctxt "h99c34a9ege03dg4f2aga8fdg642b8f730bb9"
msgid "Then keep looking."
msgstr "그럼 계속 찾아봐."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_ApothecaryGoblins_AD_GoblinsLooting
#. Speaker = Goblin Warrior
#. NodeID = d1613c65-5849-3fba-d35c-265b95bc2ef3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_ApothecaryGoblins_AD_GoblinsLooting:d1613c65-5849-3fba-d35c-265b95bc2ef3
msgctxt "h45cb0891gc022g483ag821dg915e9f52cb82"
msgid "Nothing."
msgstr "쥐뿔도."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_ApothecaryGoblins_AD_GoblinsLooting
#. Speaker = Tracker Slice
#. NodeID = f0d50562-388b-1f2d-5fcd-39a988809657
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_ApothecaryGoblins_AD_GoblinsLooting:f0d50562-388b-1f2d-5fcd-39a988809657
msgctxt "h707ff3b2g1091g47d8ga352g0ef7e28d7bf0"
msgid "What's the round-up?"
msgstr "뭐 좀 건졌나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_ApothecaryGoblins_AD_Subordinates
#. Speaker = Goblin Warrior
#. NodeID = 3da51de9-3f44-7709-e7b2-bdf84ee5cb32
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_ApothecaryGoblins_AD_Subordinates:3da51de9-3f44-7709-e7b2-bdf84ee5cb32
msgctxt "hf5d48f70gd4e5g437bga196g9df19c267959"
msgid "Absolute don't want this junk."
msgstr "절대자는 이런 쓰레기를 원치 않아."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_ApothecaryGoblins_AD_Subordinates
#. Speaker = Brawler Brek
#. NodeID = 5ef86ee5-10f6-c7b8-6305-5beff4739857
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_ApothecaryGoblins_AD_Subordinates:5ef86ee5-10f6-c7b8-6305-5beff4739857
msgctxt "h3042caadg0dbcg4db9gacecg4c3ddac68ba5"
msgid "C'mon, gotta be something here."
msgstr "이리와봐, 뭔가 여기 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_ApothecaryGoblins_AD_Subordinates
#. Speaker = Brawler Brek
#. NodeID = 61445432-7db5-f615-1315-59c68ce13f57
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_ApothecaryGoblins_AD_Subordinates:61445432-7db5-f615-1315-59c68ce13f57
msgctxt "hc79efffega17ag4177g9976gdd92ab154b0f"
msgid "Pah."
msgstr "퍄."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_ApothecaryGoblins_AD_Subordinates
#. Speaker = Brawler Brek
#. NodeID = 7090bb04-91f6-a659-90e0-62cafdfb1d38
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_ApothecaryGoblins_AD_Subordinates:7090bb04-91f6-a659-90e0-62cafdfb1d38
msgctxt "h6426264dg6c80g48fdgaa0age86186503444"
msgid "How do you know?"
msgstr "어떻게 알아?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_ApothecaryGoblins_AD_Subordinates
#. Speaker = Goblin Warrior
#. NodeID = e9b88bdf-a3f6-051e-406f-42b8a19a2db7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_ApothecaryGoblins_AD_Subordinates:e9b88bdf-a3f6-051e-406f-42b8a19a2db7
msgctxt "h300b2d37g8d30g4f7eg9e46g97e4ae5839be"
msgid "And the others getting drunk off their choppers in camp."
msgstr "그런데 다른 놈들은 야영지에서 이빨이 빠져라 술을 마시고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_ApothecaryGoblins_AD_Subordinates
#. Speaker = Brawler Brek
#. NodeID = ed202bec-73dd-b2a6-ca3c-692e4990dd85
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_ApothecaryGoblins_AD_Subordinates:ed202bec-73dd-b2a6-ca3c-692e4990dd85
msgctxt "h6e774d57ge6d2g497dg85afg6e6357af40f0"
msgid "Ain't fair."
msgstr "불공평해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_ApothecaryGoblins_AD_Subordinates
#. Speaker = Goblin Warrior
#. NodeID = f93325a6-ffa1-a7d6-5205-92747071705a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Forest/FOR_ApothecaryGoblins_AD_Subordinates:f93325a6-ffa1-a7d6-5205-92747071705a
msgctxt "h64f681a7g4600g44bagb309g25d145796e7b"
msgid "I just do."
msgstr "그냥 알아."

