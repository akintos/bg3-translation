msgctxt "h71d74028gba81g4b89gb785gb41db21b1508"
msgid ""
"There is a <i>ghaik</i> scourge in these lands. I need this crèche's help."
msgstr "이 땅에 <i>게이크</i> 골칫거리가 나타났다. 이곳 양성소의 협조가 필요하다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointWarning
#. Speaker = Player
