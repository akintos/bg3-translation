msgctxt "hd8fb0af9g8f50g4967g867age5badfefeaae"
msgid "<i>Ponder how it would taste to bite his toe clean off.</i>"
msgstr "<i>발가락을 깔끔하게 물어 뜯으면 어떤 맛이 날지 고민해 본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Player
#. NodeID = b2abd0cc-1b8f-0483-78d8-86c327dfd7ea
#. HandlePath = TaggedText[0].TagText[0]
