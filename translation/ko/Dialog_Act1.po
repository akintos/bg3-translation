msgctxt "h16908347g1fa4g4c34gbb45gde7e513dc262"
msgid "Where would I find this forge?"
msgstr "이 대장간을 어디서 찾을 수 있지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HookHorror_Hermit_Dead
#. Speaker = Filro the Forgotten
#. NodeID = 1025d2c8-a460-9fed-b2c4-d2fe97b2a203
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HookHorror_Hermit_Dead:1025d2c8-a460-9fed-b2c4-d2fe97b2a203
msgctxt "h92bdadf1g0cd3g48ddga904g8a3c01930837"
msgid "Xargrim... Dhourn..."
msgstr "자그림.... 도운..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HookHorror_Hermit_Dead
#. Speaker = Filro the Forgotten
#. NodeID = 1a86a2fb-2888-4902-daa5-cd85fb49e017
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_FurnaceSearch_Knows_Weakness = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HookHorror_Hermit_Dead:1a86a2fb-2888-4902-daa5-cd85fb49e017
msgctxt "hd0b5187dge8a4g4b42g9d88g41da0c92e0f6"
msgid "Born... from hellish heat... in hellish heat... destroyed..."
msgstr "지옥 같은 열기에서... 태어났어... 지옥 같은 열기에서... 파괴되었어..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HookHorror_Hermit_Dead
#. Speaker = Player
#. NodeID = 1de556a3-2079-4507-8aea-3233e2bc5831
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_FurnaceSearch_Event_SucceedMadRecords = True
