msgctxt "h20432a12g3991g4c3fg8050g89702fcc2eb5"
msgid "All right. I'm ready."
msgstr "좋아. 나는 준비됐어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = baac26f7-086e-cc87-cb69-341d14f8500e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:baac26f7-086e-cc87-cb69-341d14f8500e
msgctxt "heb6ab761gf697g499ag9b6agc48228ddd48b"
msgid "Eh? Ain't nothin' wrong with me. You're the one who's sick in the head."
msgstr "뭐라? 난 아무 문제 없어. 머리가 아픈 건 너야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Narrator
#. NodeID = bc3d9fc8-eaf1-909a-4a84-df1f85e424cc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - ORI_Karlach_Event_SetUpGoblinPriestBranch = True
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:bc3d9fc8-eaf1-909a-4a84-df1f85e424cc
msgctxt "h422a4977g6d28g4a5bg983bg4bcbd71ced5a"
msgid ""
"*The potion is poisoned, but your virtuous resolve is stronger than the "
"toxins.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = bcfa1eb7-577e-e862-8d8c-02edae0f228a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:bcfa1eb7-577e-e862-8d8c-02edae0f228a
msgctxt "hcd512261g65ffg4be4g85c4g931e2aaa514a"
msgid "<i>Shut her out completely.</i>"
msgstr "<i>그녀를 완전히 차단한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = bdd560e0-2f9e-f084-4ee5-d2bdc5f481c8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_GoblinPriest_RefusedHelp(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:bdd560e0-2f9e-f084-4ee5-d2bdc5f481c8
msgctxt "h01d180deg4d52g4a5eg892eg521e890c5191"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = c0b5c7f5-68c8-15e7-ab08-98d0efc26139
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:c0b5c7f5-68c8-15e7-ab08-98d0efc26139
msgctxt "hba24de7fg763bg4b7eg8227g60d6410932d5"
msgid "It involves you puttin' yer trust in the Absolute. Simple."
msgstr "네가 절대자님께 믿음을 바치는 것이다. 간단하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = c2f151d2-2ae6-774a-4b35-34698f3b67bc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
