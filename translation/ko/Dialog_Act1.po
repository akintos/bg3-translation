msgctxt "h4cb22684ga07cg4fc1g92b0gb912a443d9de"
msgid ""
"*Your mind and body are muted on approach. A privacy denser than any stone "
"prevents you from entering.*"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/AstralPlane/CRE_AstralPrison_DaisyCaveEntrance
#. Speaker = Gale
#. NodeID = bf5e360d-5c12-4933-8cf4-3ded6d762db6
