msgctxt "h477634f9g6700g4e3bg892fg22ec4ba3f245"
msgid "<i>Pay him.</i>"
msgstr "<i>지불한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent03
#. Speaker = Brem
#. NodeID = 3829b176-dc56-9e1a-1722-d39210bad5a1
