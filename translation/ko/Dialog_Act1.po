msgid "We're invincible!"
msgstr "우린 무적이야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WaitingLush
#. Speaker = Tracker Azak
#. NodeID = 09c590f2-562f-1704-1af4-b7c4c4fb9bf0
#. HandlePath = TaggedText[0].TagText[0]
