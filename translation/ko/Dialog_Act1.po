msgctxt "h024f1147g5373g44a8gbff7g5e32779d87e8"
msgid "No. I won't leave him."
msgstr "아니. 그를 내버려둘 순 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Player
#. NodeID = 4c6fff3d-862f-a0e0-e9bc-b36cc68a1e7f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
