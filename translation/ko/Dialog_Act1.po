msgctxt "h59ed57f1gb3d3g4e3ega1bdg65b60eca8189"
msgid "The forging is not complete. What else is required?"
msgstr "단조가 제대로 되지 않는군. 또 뭐가 필요한 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_AdamantineForge_PAD_ForgingIncomplete
#. Speaker = Player
#. NodeID = 9f1df3e0-76fe-b5d4-ee81-3b13d33a9b2d
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
