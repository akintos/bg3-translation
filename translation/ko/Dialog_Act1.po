#. NodeID = 0539469e-24ed-6415-9150-fbfe85591888
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - PLA_KarlachRecruitmentTollhouse_State_WarnedAboutCrime(1) = False
#. SetFlags:
#.   Object:
#.     - PLA_KarlachRecruitmentTollhouse_State_WarnedAboutCrime(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_Refugee_SpokeWithDeadCrime:0539469e-24ed-6415-9150-fbfe85591888
