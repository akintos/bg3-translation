#. SetFlags:
#.   Dialog:
#.     - GOB_TorturedAdventurer_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:fe5f62e4-aa23-b94f-f358-e69247471140
msgctxt "h5060980bg10c3g4140gb3c7gce681a602254"
msgid "N-no! Please! D-don't hurt me!"
msgstr "아-안 돼! 제발! 절 해지치 마-마세요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
