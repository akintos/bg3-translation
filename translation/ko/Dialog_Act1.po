#. CheckFlags:
#.   Local:
#.      - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_WhatDoingHere = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:5d189f62-3099-9b6e-3c4a-fa2f62d69a75
msgctxt "h0554d65dg20ebg49f6g8b7cge09de799ab75"
msgid "There must be something else you're up to."
msgstr "분명 여기 온 다른 이유도 있을 텐데요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = 5dc72604-b817-22a7-f722-d6f2e80210c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:5dc72604-b817-22a7-f722-d6f2e80210c4
msgctxt "h3e07f387g2791g4b40g8d4fg57291d2833f3"
msgid "It was red, of course."
msgstr "물론, 붉은 색이었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = 5dea086b-585d-c93c-7619-70157aa2501f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:5dea086b-585d-c93c-7619-70157aa2501f
msgctxt "had21ba2dge75eg4b21g9106g6a774b7e93c4"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 5df2a236-fd3d-ce01-e33b-fdf7710774a7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   User:
#.     - UND_MushroomHunter_Event_LearnedAboutNoblestalk(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:5df2a236-fd3d-ce01-e33b-fdf7710774a7
#, fuzzy
msgctxt "h83404268g1b8dg4dfag97e8gb52755147a03"
msgid ""
"Collecting noblestalk. Valuable mushroom. We've a shop in Baldur's Gate. The "
"locals go mad for it."
msgstr "귀족줄기를 채집하고 있었어. 아주 값비싼 버섯이지. 발더스 게이트에 우리 상점이 있어. 거기 사람들이 그거에 환장을 하거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 643ffcd5-6b03-c1c9-6e05-9cfa2b0ee885
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:643ffcd5-6b03-c1c9-6e05-9cfa2b0ee885
msgctxt "h36594342g0610g4e2fg8939g57a7e460c332"
msgid ""
"Well that's something at least. Of course that old bugger needed help with a "
"simple job..."
msgstr "뭐라도 건졌군. 그 늙은이는 도움 없이는 간단한 일도 못 한다니까..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = 6892df64-0c13-827f-e517-c2d01b49a81f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_MyconidCircle_DwarvenAlchemist_Knows_NoblestalkFunction(1) = True
#.      - UND_InjuredGnome_HasMet(1) = True
#.   Global:
#.      - UND_InjuredGnome_Knows_GnomeDied = False
#.      - UND_InjuredGnome_State_Healed = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:6892df64-0c13-827f-e517-c2d01b49a81f
msgctxt "h1af2aba2g90abg419cgb37egc977d6af472d"
msgid "What about that gnome, Thulla? Could it cure her?"
msgstr "그 노움, 툴라는 어떨까요? 이걸로 그녀를 치료할 수 있을까요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = 6e2e4af0-9257-3f1f-a86b-1f2de3efc091
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - UND_MyconidCircle_DwarvenAlchemist_Event_RefusedHerNoblestalk(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:6e2e4af0-9257-3f1f-a86b-1f2de3efc091
msgctxt "hc8932f9ag5163g44eega041g52a6b7e80e30"
msgid "I've changed my mind. I'm keeping it."
msgstr "마음이 바뀌었습니다. 제가 간직하겠어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 6ecd99c4-b1d4-22c2-d9e2-d7b572ee745a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:6ecd99c4-b1d4-22c2-d9e2-d7b572ee745a
msgctxt "h39f3eaa4g7e8ag431eg970fg71037854ffd5"
msgid "I know him better than anyone. Got the scars to prove it."
msgstr "난 누구보다 그를 잘 알고 있어. 상처가 그걸 증명하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = 6edf73ca-9d5b-1378-303f-5e4987e2b615
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:6edf73ca-9d5b-1378-303f-5e4987e2b615
msgctxt "h99da0ba2gb048g4a9cg92f2g9c4003ef064d"
msgid "Why do you need it so badly?"
msgstr "왜 그걸 그렇게 간절히 원하시는 거죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 703bfbc4-179f-142d-30ac-30c808d5b769
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:703bfbc4-179f-142d-30ac-30c808d5b769
msgctxt "he099f230gfc35g4912g8a6fgd4c9322111e4"
msgid ""
"Loads. But I haven't got anything to offer for it. I'm counting on this "
"shroom for that."
msgstr "엄청나게. 하지만 당장 그 대가로 당신에게 줄 수 있는 건 없어. 이 버섯으로 벌어야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = 719bd069-394c-a359-21af-93b981ff6abf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_MyconidCircle_DwarvenAlchemist_Knows_NoblestalkFunction(1) = False
#. SetFlags:
#.   Dialog:
#.     - UND_MyconidCircle_DwarvenAlchemist_Knows_NoblestalkFunction(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:719bd069-394c-a359-21af-93b981ff6abf
msgctxt "hca6fec7ag6581g47ccgad45geb0fcb975a96"
msgid "What makes it so valuable?"
msgstr "그게 왜 그렇게 가치가 있는 거죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = 7705872a-4ea2-8f14-5541-5b2e1b55717a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_AskedForPayment = False
#. SetFlags:
#.   Local:
#.     - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_AskedForPayment = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:7705872a-4ea2-8f14-5541-5b2e1b55717a
msgctxt "h5719ad78g2527g4a2dgaacbg72c9b5c98480"
msgid "How much is it worth to you?"
msgstr "그게 당신에게 어떤 가치가 있죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 78b9493e-8333-4de4-7802-e8d4c1377e83
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:78b9493e-8333-4de4-7802-e8d4c1377e83
msgctxt "h1241a56bg7192g4b82g8720g6736ff27fbc4"
msgid "I'll find my way out. No point hanging around this den of misery."
msgstr "이제 이곳에서 벗어나야겠어. 이 비참한 곳에 더 이상 머무를 이유도 없군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 790c2031-42f8-ecad-870f-34c644de001a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:790c2031-42f8-ecad-870f-34c644de001a
msgctxt "h587615cegdd79g4162gbb84g67e16b4423ee"
msgid "Go on, then. Hand it over."
msgstr "그럼, 이리 넘겨."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 7937d555-161b-fa0f-2187-a63cf8af524f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:7937d555-161b-fa0f-2187-a63cf8af524f
msgctxt "h74a2815egaf5eg4deaga892gedeedcf54b3e"
msgid "I knew him better than anyone. Got the scars to prove it."
msgstr "내가 누구보다 잘 알아. 이 흉터가 그걸 증명해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 7d3b5bb5-a86d-e517-df69-b68b329b4c7a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:7d3b5bb5-a86d-e517-df69-b68b329b4c7a
msgctxt "h05df2998g5e72g4829g8550gcf202b17fa1d"
msgid "Wait - <i>please. </i>I need this."
msgstr "잠깐 - <i>제발</i>. 내게 꼭 필요한 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 7d7abcc7-cb3a-f660-8850-6f990a784acd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:7d7abcc7-cb3a-f660-8850-6f990a784acd
msgctxt "h6a2cfe2dg6216g4e9fg8154g45c5193321f4"
msgid ""
"I'll wait a little longer. What a bleedin' waste it'd be to come all the way "
"down here for nothing."
msgstr "조금 더 기다려야겠군. 이 아래까지 와서 아무 소득도 없이 돌아가면 빌어먹을 낭비잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 7df9cca6-1346-cb1e-db2d-965dabb2f24f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:7df9cca6-1346-cb1e-db2d-965dabb2f24f
msgctxt "h090898ecgbfd4g4973gbba2ga76d071c788c"
msgid "Get out of my face. Find some else's suffering to lap up."
msgstr "내 앞에서 꺼져. 다른 사람의 고통이나 빨아먹으라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 7ece675b-262b-ed79-2999-612ff5246a39
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:7ece675b-262b-ed79-2999-612ff5246a39
msgctxt "h1b15dc40gaed2g4a1fg92e3gb4953fd5489d"
msgid ""
"Loads. But I haven't got anything to offer for it. I'm counting on this "
"shroom for that."
msgstr "엄청나게. 하지만 당장 그 대가로 당신에게 줄 수 있는 건 없어. 이 버섯으로 벌어야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = 7fbdfa02-ab3b-7f7c-1d2a-d3c35e109c8a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_MushroomHunter_HasMet(1) = False
#.   Local:
#.      - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_AcknowledgeBaelenQuery = False
#. SetFlags:
#.   Local:
#.     - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_AcknowledgeBaelenQuery = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:7fbdfa02-ab3b-7f7c-1d2a-d3c35e109c8a
msgctxt "h06baa9fcg16b4g40b0ga9acg767a57039fa0"
msgid "Haven't seen him."
msgstr "그런 사람은 본 적 없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 803bc8af-72ac-1dd5-5b69-95a2491dd6ad
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_BaelenDescriptiongGiven = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:803bc8af-72ac-1dd5-5b69-95a2491dd6ad
msgctxt "hfc87b02bg1073g4689ga09egac90de0227d1"
msgid "Oh is that right? What colour's his tunic then?"
msgstr "그래? 그가 어떤 색 튜닉을 입고 있던가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 80799cce-5706-83cc-4ba9-ce902150e0d3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:80799cce-5706-83cc-4ba9-ce902150e0d3
msgctxt "h9dd4867cg7aa1g40f9g9972gb2f5fd706191"
msgid ""
"Baelen was a rotten old bastard. Treated me like an old shoe for seventy "
"years before his mind started to go - softened him up, made him realise how "
"much he needed me."
msgstr ""
"베일렌은 썩어빠진 영감탱이였어. 70년 동안 나를 헌신짝처럼 대하다가 정신이 나가기 시작했지. 그는 그렇게 부드러워졌고, 내가 얼마나 "
"필요한 존재인지 깨달았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 81a9c926-7676-dc99-e560-6147fa6fc690
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:81a9c926-7676-dc99-e560-6147fa6fc690
msgctxt "hf7024a8fg4c5dg4394gb47fged51a59ba595"
msgid ""
"<i>Me </i>mistreating <i>him</i>. You're just like him. Everyone is, in the "
"end."
msgstr "<i>내</i>가 <i>그</i>를 학대했다고. 너도 그와 똑같아. 결국엔 모두가 그래."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = 821f4afb-a724-0095-a13a-e6c6483a13b0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_WhatDoingHere = False
#. SetFlags:
#.   Local:
#.     - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_WhatDoingHere = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:821f4afb-a724-0095-a13a-e6c6483a13b0
msgctxt "h4c0b6a59gffe5g404cg95d1g0a0e0518785f"
msgid "What are you doing down here?"
msgstr "이 아래에서 뭘 하고 있습니까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = 84b7400e-4cd9-c637-428d-aa4232e516e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:84b7400e-4cd9-c637-428d-aa4232e516e7
msgctxt "h5fab442eg991dg4420ga390ga26bc1852957"
msgid "That's more like it. I want you to beg."
msgstr "그게 더 낫군요. 이제 구걸해 보시죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 85bd3989-5e06-25da-392a-50570cd48d55
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:85bd3989-5e06-25da-392a-50570cd48d55
msgctxt "h0f85dc93g1cbfg474ag8abbg89e29f274e0b"
msgid "Losing his mind was the only good he ever did by me."
msgstr "그가 제정신을 잃은 건, 그가 내게 베푼 유일한 선행이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = 867fc519-9ab7-a0a1-1bc3-45c67c32f820
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_MushroomHunter_HasMet(1) = True
#.   Global:
#.      - UND_MushroomHunter_State_BaelenDead = False
#. SetFlags:
#.   Dialog:
#.     - UND_MushroomHunter_Knows_StuckInField(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:867fc519-9ab7-a0a1-1bc3-45c67c32f820
msgctxt "h6c9fd425g43d8g464bga16cg1c11222525a5"
msgid "I met him in a field of deadly mushrooms."
msgstr "그가 치명적인 버섯에 둘러싸여 있는 걸 봤습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 869ad074-1173-92b6-1529-cec7671f9731
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:869ad074-1173-92b6-1529-cec7671f9731
msgctxt "h13ad2c19g805fg486bgbe28gf4406df10674"
msgid "It's a mushroom. It won't leave any starving orphans behind."
msgstr "버섯이야. 가난한 고아 아이들이 지나치지를 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 893e840b-8cc3-7bbe-8434-e3d93e4bff6f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_MushroomHunter_State_PromisedToFindBaelen(1) = False
#.      - UND_MushroomHunter_Knows_StuckInField(0) = True
#.   Global:
#.      - UND_MyconidCircle_DwarvenAlchemist_KnowsBaelenDead = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:893e840b-8cc3-7bbe-8434-e3d93e4bff6f
msgctxt "hdc1e0fe1geae9g417cgb127gcd9ef52114ba"
msgid ""
"Baelen's got a few minutes to get himself out of that shroom field 'fore I "
"pack up."
msgstr "내가 마무리하기 전까지 베일렌이 오려면 시간이 별로 남지 않았군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = 8981410e-eb1d-b3a7-3762-0d7225b5646c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - UND_MyconidCircle_DwarvenAlchemist_Event_RefusedHerNoblestalk(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:8981410e-eb1d-b3a7-3762-0d7225b5646c
#, fuzzy
msgctxt "hf5bf28a4g42a9g472bg8a2fg47d24702aa0c"
msgid "<i>Keep the noblestalk for yourself.</i>"
msgstr "<i>귀족줄기를 가진다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 8bf55a3b-0576-bac8-8e80-6159745834b0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_MushroomHunter_Event_HasWeddingRing(0) = True
#. SetFlags:
#.   Object:
#.     - UND_MushroomHunter_Event_GiveWeddingRing(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:8bf55a3b-0576-bac8-8e80-6159745834b0
msgctxt "h965278ccg9860g4f45g9212gc7e344089983"
msgid ""
"Stop! Fine - take this. Wedding ring from a pillock. It has to be worth "
"something."
msgstr "그만! 좋아, 이걸 가져가. 그 멍청이가 준 결혼 반지야. 뭔가 가치는 있겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 8c38fd49-75b6-99e2-4d06-a4d2d36994ba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:8c38fd49-75b6-99e2-4d06-a4d2d36994ba
msgctxt "h00d1274cg789eg4228g8456gf6f7f2af6e8a"
msgid "Love? Hah. Never heard of it."
msgstr "사랑이라고? 하. 그런 건 몰라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 8cb63705-1d00-bebd-48d8-09753fa1afdb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:8cb63705-1d00-bebd-48d8-09753fa1afdb
msgctxt "ha0cde063g6469g420ega440g33664202be4a"
msgid "We've a shop in Baldur's Gate. The locals go mad for it."
msgstr "발더스 게이트에 우리 상점이 있어. 그곳 사람들이 그거에 환장을 하거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 8f547f8d-22c2-d0c0-a16a-3980d499bb8d
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:8f547f8d-22c2-d0c0-a16a-3980d499bb8d
msgctxt "h33a65138ga1d2g4ae2ga2d0g3e76f1dd008b"
msgid ""
"He has his uses, for now. Hauls my baggage as good as any ox, but costs me "
"less to feed - just about."
msgstr "그는 지금은 쓸모가 있어. 그는 어떤 황소보다 내 짐을 잘 끌어주고, 먹이 비용도 덜 들지 - 거의."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 8f547f8d-22c2-d0c0-a16a-3980d499bb8d
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_DUERGARDWARF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:8f547f8d-22c2-d0c0-a16a-3980d499bb8d
msgctxt "h41f7593bg29adg4b99gacc5gb46dded6c031"
msgid ""
"I've been tempted, but wouldn't want to damage my reputation by selling on "
"such rubbish wares."
msgstr "혹하긴 했지만, 그런 쓰레기 같은 물건을 팔아서 내 평판을 망치고 싶지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = 9135f028-c876-97ab-875e-dd2d01300e3a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_MyconidCircle_DwarvenAlchemist_Knows_NoblestalkFunction(1) = True
#.      - UND_InjuredGnome_HasMet(1) = True
#.   Global:
#.      - UND_InjuredGnome_Knows_GnomeDied = False
#.      - UND_InjuredGnome_State_Healed = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:9135f028-c876-97ab-875e-dd2d01300e3a
msgctxt "hc28d1e9ege975g4b50g8653g6d038a1fd21e"
msgid "There's a sick gnome just over there. Could it cure her?"
msgstr "저기 아픈 노움이 있어요. 이게 그녀를 치유할 수 있을까요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 91ca1c2f-4ad1-cd15-3740-c5467c49b57f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:91ca1c2f-4ad1-cd15-3740-c5467c49b57f
msgctxt "h84daf43bgfa74g4e81ga00cgdbb81f9b0d55"
msgid ""
"Sell it, what else? Worth more than its weight in gold to folk back in "
"Baldur's Gate. There ain't much it can't cure."
msgstr ""
"팔아야지, 달리 뭘 하겠어? 발더스 게이트로 가져가면 같은 무게의 금보다 많은 값을 받을 수 있다고. 그게 치유할 수 없는 건 없거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 926c3f88-28a5-3911-cebe-f0a4adb32b3f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:926c3f88-28a5-3911-cebe-f0a4adb32b3f
msgctxt "h199fc831g2489g44e8ga953g1d14464a5163"
msgid "Love? Hah. Never heard of it."
msgstr "사랑이라고? 하. 그런 건 몰라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = 9405a0de-6ffb-432f-4482-2371f4a36c58
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MushroomHunter_State_Saved = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:9405a0de-6ffb-432f-4482-2371f4a36c58
msgctxt "hacb50ccdgdefbg4ca2g9609g8dba1c8b48e6"
msgid "He'll probably manage."
msgstr "그는 아마도 해낼 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 942298e0-0787-2a1b-252b-f4025791204f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:942298e0-0787-2a1b-252b-f4025791204f
msgctxt "hd2780399gd56bg4c61g8342g1fceb35de5fb"
msgid "Losing his mind was the only good he ever did by me."
msgstr "그가 제정신을 잃은 건, 그가 내게 베푼 유일한 선행이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 94f5b07e-1a70-61fd-03c9-b63ca15fc172
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:94f5b07e-1a70-61fd-03c9-b63ca15fc172
msgctxt "hd91fb037g6b72g4e8ag96eeg5d4a4ffab081"
msgid "Nearly nothing it can't cure. Blindness, poison, hair loss..."
msgstr "그건 거의 모든 것을 치유할 수 있어. 실명, 중독, 탈모까지..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = 95a2a3ad-0483-6de1-3c1e-29b3947e7225
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:95a2a3ad-0483-6de1-3c1e-29b3947e7225
msgctxt "hfc95d78eg107dg4871g9fafg57d95e0833a7"
msgid "<i>Show me your wares.</i>"
msgstr "<i>뭘 파는지 보여줘요.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 96645b5d-2382-cb53-7f8c-143cdd8c0b0d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_AcknowledgeBaelenQuery = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:96645b5d-2382-cb53-7f8c-143cdd8c0b0d
msgctxt "h6bf83136g084eg459fga278g7e36cecd5bc2"
msgid "Now answer the question or find another cranny to skulk in."
msgstr "이제 질문에 대답하든가, 다른 굴을 찾아 기어 들어가든가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 96a7d22a-ee27-9b86-5a9d-a694d3db4861
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_DwarvenAlchemist_KnowsBaelenDead = True
#.   User:
#.      - UND_MushroomHunter_Event_LearnedAboutNoblestalk(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:96a7d22a-ee27-9b86-5a9d-a694d3db4861
msgctxt "h7c7b409cgebc1g4119gadb5g5759685a6996"
msgid ""
"What? Now Baelen's dead, I've got to get myself moving. Empty-handed an' "
"all..."
msgstr "뭐라고? 베일렌이 죽었으니, 나도 이만 이동해야겠군. 빈손으로 말이야..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = 980c561f-2513-ed96-95c3-754c8a29f4d3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_DwarvenAlchemist_Knows_LossOfMemory = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:980c561f-2513-ed96-95c3-754c8a29f4d3
msgctxt "h0fb73c0ag1f65g4a2bgbecfg39e644b5d77d"
msgid "Seems like there's no love lost between the two of you."
msgstr "둘 사이에 사랑이라곤 전혀 없는 것 같군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 990292b3-8d3f-969f-ee90-c0bfb88bdf09
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:990292b3-8d3f-969f-ee90-c0bfb88bdf09
msgctxt "h33164882g0e70g4d9eg9e7dgad02808031c3"
msgid "Look..."
msgstr "이봐..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 99bab432-501e-791f-a5f7-b61a4b32cbcd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_SuccessfulLie = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:99bab432-501e-791f-a5f7-b61a4b32cbcd
msgctxt "h49c23faeg0126g4934ga67bgec342987c185"
msgid "Where? Ach, never mind. Idiot's probably wandered someplace else since."
msgstr "어디? 아, 됐어. 그 멍청이는 그 이후로 아마 다른 곳으로 헤매고 있을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = 9a3903cf-eeb9-f1de-0a80-562690a04518
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_WhatDoingHere = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:9a3903cf-eeb9-f1de-0a80-562690a04518
msgctxt "h7e0d9ef8gd22fg4118g9b7fged1a7254aa31"
msgid "Now that's settled, tell me what you're really doing down here."
msgstr "이제 일이 해결되었으니, 이 아래에서 뭘 하고 있었는지 사실대로 말해 주세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 9b0bb4de-3000-6fb1-6ab4-fc93b00ef2a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:9b0bb4de-3000-6fb1-6ab4-fc93b00ef2a4
msgctxt "hc1a82387gf8fdg4851gb40cgcdc732d0ec54"
msgid "... and best of all, it cures my dangerously underweight purse."
msgstr "... 그리고 제일 좋은 점은, 그게 내 위험할 정도로 텅 빈 지갑도 치유해 줄 거라는 거지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 9c447c4f-ef19-a07a-407c-cf1e67538e37
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_DwarvenAlchemist_KnowsBaelenDead = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:9c447c4f-ef19-a07a-407c-cf1e67538e37
msgctxt "hf8aaecd3gb1a2g4234gb402g7b11f4ee27c8"
msgid "Well?"
msgstr "그래서?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = 9c4b3b38-dda0-6f37-ed11-94d02c01439f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_MushroomHunter_State_PromisedToFindBaelen(1) = False
#.   Global:
#.      - UND_MushroomHunter_State_Saved = False
#. SetFlags:
#.   Dialog:
#.     - UND_MushroomHunter_State_PromisedToFindBaelen(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:9c4b3b38-dda0-6f37-ed11-94d02c01439f
msgctxt "hdaf58e1ega18bg4e05g8a84g109b97b2efc2"
msgid "Thought you should know. I'll try and get him out of there."
msgstr "당신이라면 알 거라고 생각했습니다. 그럼 거기서 빼내 보도록 하죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = 9e6fa099-c27c-d478-f269-2421332cb78f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_MyconidCircle_DwarvenAlchemist_knows_BaelenHusband(1) = False
#. SetFlags:
#.   Dialog:
#.     - UND_MyconidCircle_DwarvenAlchemist_knows_BaelenHusband(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:9e6fa099-c27c-d478-f269-2421332cb78f
msgctxt "h837c73fbg7bfag4b08g9aa9gc336070ca6f2"
msgid "Who is he to you?"
msgstr "그와는 어떤 사이입니까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 9e7549d7-628c-fd8c-ec05-6d2d7d47b46c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:9e7549d7-628c-fd8c-ec05-6d2d7d47b46c
#, fuzzy
msgctxt "h68e0f15bg2d59g404cg81f5gde9a636f2ded"
msgid ""
"Probably. But Baelen in his right mind wasn't worth half a half of "
"noblestalk."
msgstr "그럴지도. 하지만 제정신이 박힌 베일렌은 귀족줄기의 절반의 반의 가치도 없었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 9f017238-3bbb-1871-8aae-df171281375b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:9f017238-3bbb-1871-8aae-df171281375b
msgctxt "h88017ce4g4747g4d8cgbbefg1732826207cb"
msgid ""
"Like I told you already - I'm waiting for that lummox, Baelen. The rest is "
"my own business."
msgstr "당신에게 말한 그대로야, 그 멍청이 베일렌을 기다리고 있지. 나머지는 당신이 알 바 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = 9fb5f640-b228-bcfb-516c-7d7d0f0dec82
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:9fb5f640-b228-bcfb-516c-7d7d0f0dec82
msgctxt "h4c2140c2ga562g4b35g865dg38272d7be730"
msgid "Wretch! I did as you asked - I hope you fall down a hole and rot!"
msgstr "비열한 자식! 당신이 시키는 대로 했잖아, 구멍에 빠져서 썩어가며 죽길 바라지!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = a2aa9c14-bb14-3693-2198-3fc0ea82ce74
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:a2aa9c14-bb14-3693-2198-3fc0ea82ce74
msgctxt "h2cce2ceega93dg41b8g854age787216858a1"
msgid "Please. I know better than to promise coin to a stranger."
msgstr "제발. 난 모르는 사람에게 돈을 주는 게 위험하다는 걸 알아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = a2b84add-f39e-73a2-27bb-27847980e685
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_WhatDoingHere = False
#. SetFlags:
#.   Local:
#.     - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_WhatDoingHere = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:a2b84add-f39e-73a2-27bb-27847980e685
msgctxt "ha8122588gb0a2g4eabg992agf3cc74a69e2b"
msgid "What are you doing down here?"
msgstr "이 아래에서 뭘 하고 있습니까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = a2bd75d3-f4b8-9c59-9616-511f9aa454d2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_MushroomHunter_State_HasMushroom(1) = True
#. SetFlags:
#.   Global:
#.     - UND_DwarvenAlchemist_State_AlchemistGotNoblestalk = True
#.   Object:
#.     - UND_MushroomHunter_Event_GiveMushroom(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:a2bd75d3-f4b8-9c59-9616-511f9aa454d2
msgctxt "h7b6f26acg2a22g4087gb294gdf663debac2f"
msgid "<i>Give it to her.</i>"
msgstr "<i>그녀에게 준다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = a51e3d7a-05e5-fa13-6dac-743d97a10271
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_AskedForPayment = False
#. SetFlags:
#.   Local:
#.     - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_AskedForPayment = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:a51e3d7a-05e5-fa13-6dac-743d97a10271
msgctxt "h4c544822ga039g4370g80d5gc9550b00800a"
msgid "How much is it worth to you?"
msgstr "그게 당신에게 어떤 가치가 있죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = a6a69f93-a358-b361-cbd5-a02ffa40328c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:a6a69f93-a358-b361-cbd5-a02ffa40328c
msgctxt "hc4a3b5degce90g4659g9797gab4bd3e9f6ec"
msgid ""
"Now my purse - that <i>is </i>starving. Needs all the fattening it can get."
msgstr "지금 내 지갑이 <i>텅텅</i> 비었어. 돈이 최대한 많이 필요해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = a6fe458f-7ff8-5132-1d2f-ba2fa2b53d3c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MushroomHunter_State_InVillage = False
#.      - UND_MushroomHunter_State_Saved = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:a6fe458f-7ff8-5132-1d2f-ba2fa2b53d3c
msgctxt "h801ca5e6g13dag424cg84ffgc07572deeb1a"
msgid "I freed Baelen already. He should be back soon."
msgstr "베일렌은 이미 구해줬습니다. 곧 돌아올 겁니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = a81b1da7-c1a8-9996-0c86-91e3b54bba66
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_MyconidCircle_DwarfAlchemist_HasMet(1) = False
#. TagRule: DUERGARDWARF or LOLTHDROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:a81b1da7-c1a8-9996-0c86-91e3b54bba66
msgctxt "h439b6270g375fg4cf4g86b6gf18fd9e52ef6"
msgid "Didn't think the likes of you took to helpin' folk."
msgstr "당신네 종족이 사람을 도울 수도 있다는 건 몰랐군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = a81b1da7-c1a8-9996-0c86-91e3b54bba66
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_MyconidCircle_DwarfAlchemist_HasMet(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:a81b1da7-c1a8-9996-0c86-91e3b54bba66
msgctxt "h3438458dg28fcg497cga4acg50472c69f433"
msgid "I suppose that's <i>your </i>doing."
msgstr "<i>당신 </i>덕분인 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = aa1a0efe-b457-17b2-7a30-53bf4ac81ab5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:aa1a0efe-b457-17b2-7a30-53bf4ac81ab5
msgctxt "hdeb64774g57d5g4738gba01g00f99a2c916e"
msgid "Once I get my hands on it, it'll remedy my flagging coffers."
msgstr "일단 그걸 손에 넣으면, 내 빈곤한 금고를 채울 수 있을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = ab00deef-c662-ebc7-acdd-c59d53429e9a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_MyconidCircle_DwarvenAlchemist_BaelenRestoredHasmet(1) = True
#.   Global:
#.      - UND_MushroomHunter_Event_AteMushroom = True
#.   Local:
#.      - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_TauntHer = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:ab00deef-c662-ebc7-acdd-c59d53429e9a
msgctxt "h9aaa6920g5847g4c86g9c73gd77d426d29db"
msgid "Away. <i>Now</i>. You've leeched on my misery plenty already."
msgstr "꺼져. <i>당장</i>. 내 불행에 더 이상 기생하지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = abdc606e-e849-ab7f-e507-619ebeefb7ac
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MushroomHunter_State_BaelenDead = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:abdc606e-e849-ab7f-e507-619ebeefb7ac
msgctxt "hb058056cg1426g452fg8d5cg15afeb7edf3e"
msgid "I met him in a field of deadly mushrooms. He died there."
msgstr "치명적인 버섯 밭에서 만났어요. 그리고 거기서 죽었죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = ac176269-45d6-b609-57dd-3dde7bc3a00c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_DwarvenAlchemist_KnowsBaelenDead = True
#.   User:
#.      - UND_MushroomHunter_Event_LearnedAboutNoblestalk(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:ac176269-45d6-b609-57dd-3dde7bc3a00c
msgctxt "h61d3a241g61c6g4627g82d8g1c39d37ac4f5"
msgid "What? Now Baelen's dead, I've got to get myself moving."
msgstr "뭐? 베일렌이 죽었으니, 이곳을 떠나야겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = ae4537a8-9c69-0830-6b0b-2017c605911b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:ae4537a8-9c69-0830-6b0b-2017c605911b
msgctxt "h26174a6egd6e9g4202g8483g08f724953986"
msgid ""
"My husband. Eighty soggin' years together, and he leaves me in the lurch "
"like this."
msgstr "내 남편. 80년이나 함께했는데, 그는 이렇게 나를 내팽개쳤어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = af3cfa03-0a28-9ad7-bf07-3e8861ac834a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_MyconidCircle_DwarvenAlchemist_Knows_NoblestalkFunction(1) = True
#.   Global:
#.      - UND_MushroomHunter_State_BaelenDead = False
#.      - UND_DwarvenAlchemist_Knows_LossOfMemory = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:af3cfa03-0a28-9ad7-bf07-3e8861ac834a
msgctxt "h412b5f7eg02a1g408dg9a36ge811d661b7ff"
msgid "Could it cure Baelen's memory loss?"
msgstr "그게 베일렌의 기억 상실을 치유할 순 없습니까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = afef81c8-cf26-dcc7-d998-4373f92608bf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:afef81c8-cf26-dcc7-d998-4373f92608bf
msgctxt "h177fa6b9gc638g49ebgb3fag13e663b6250e"
msgid ""
"His hands are empty as a hole - will have to send him back out soon enough."
msgstr "그의 손이 텅 비어 있군, 곧 다시 보내야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = b32cfde9-c98b-ed81-495f-ce9a59081eb0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:b32cfde9-c98b-ed81-495f-ce9a59081eb0
msgctxt "h5c2a25b0g09dag4304g9a38gcd0d501ea07a"
msgid ""
"If you try to ransom him to me, you'll find yourself skint <i>and </i>stuck "
"with a fat old lout."
msgstr "그를 가지고 몸값을 요구하면 네 살갗만 <i>벗겨지고</i> 그 뚱뚱한 늙은이에게 갇혀 살게 될 테니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = b50e5d52-4535-4995-a19b-a7794122addf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DROWELF(1) = False
#.      - DROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:b50e5d52-4535-4995-a19b-a7794122addf
msgctxt "h8ac71750g5105g4fe8ga828g68571799ceb7"
msgid "I'm not truly a drow - merely disguised."
msgstr "난 진짜 드로우가 아닙니다. 변장한 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = b68d2aab-d653-fb3c-50b5-55d11add20b9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:b68d2aab-d653-fb3c-50b5-55d11add20b9
msgctxt "h5aa8347dg8d30g4b38g8cc2gf40c06ce242f"
msgid "It's a miracle he survived. You should take him home."
msgstr "그가 살아남은 건 기적이었어요. 그를 집으로 데려가세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = b6e41530-2693-2636-d01c-d1381732af0c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   User:
#.     - UND_MushroomHunter_Event_LearnedAboutNoblestalk(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:b6e41530-2693-2636-d01c-d1381732af0c
#, fuzzy
msgctxt "hff4efb00gd155g45fcg8397g4d968efad47a"
msgid ""
"Collecting noblestalk. Valuable mushroom. We've a shop in Baldur's Gate. The "
"locals go mad for it."
msgstr "귀족줄기를 채집하고 있었어. 아주 값비싼 버섯이지. 발더스 게이트에 우리 상점이 있어. 거기 사람들이 그거에 환장을 하거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = b70f661e-216f-2793-8615-55cba466d772
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:b70f661e-216f-2793-8615-55cba466d772
msgctxt "h94252513g0525g4f58gb8b6g79d7c2db052a"
msgid ""
"Baelen nearly sunk the shop to pay for drink, when he was of his own mind."
msgstr "베일렌이 제정신이었을 땐, 술값을 낸다고 상점을 거의 팔아버릴 뻔했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = b74c8d14-4f42-d203-297c-9feffbcb467c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_TauntHer = False
#. SetFlags:
#.   Local:
#.     - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_TauntHer = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:b74c8d14-4f42-d203-297c-9feffbcb467c
msgctxt "h2926e567g9071g4ef2g9544gb1b6e64a24db"
msgid "I know <i>exactly </i>what I've done. Very entertaining."
msgstr "전 제가 무슨 짓을 한 건지 <i>정확히</i> 알아요. 정말 재밌군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = b80d5138-3b2a-83b8-5a4a-9ed198194fc3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:b80d5138-3b2a-83b8-5a4a-9ed198194fc3
msgctxt "hf8ef3f23g00fdg42a3g8308g44ad882cb479"
msgid ""
"Can't. Got nothing to give. Maybe if you came to see me after, in Baldur's "
"Gate..."
msgstr "지금은 도와줄 수 없어. 나중에 발더스 게이트에서 다시 만나면 도와줄 수도..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = ba1d73a8-1014-ef90-5e45-b57d1ff3b07a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:ba1d73a8-1014-ef90-5e45-b57d1ff3b07a
msgctxt "hbb5d9bfege673g4dd2ga18ega5c84eebe6a8"
msgid ""
"Right. Well. I'll wait a bit longer. He'll find his way out, or he won't."
msgstr "알았어. 조금만 더 기다려보지. 혹시라도 그가 밖으로 나갈 방법을 찾을지도 몰라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = bb8d1477-dcd2-071e-e85c-027de0aa3f1c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:bb8d1477-dcd2-071e-e85c-027de0aa3f1c
msgctxt "h3ea8ec1eg2129g4c82g9775gc51a6a4274dc"
msgid ""
"Aye, but them myconids do, and they won't take too kindly to you kicking up "
"a fuss. So like I said - play nice."
msgstr "맞아. 마이코니드들은 성질이 급해서 당신이 시비를 걸면 좋게 보지 않을 거야. 그러니까 그냥 얌전히 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = bcfdad93-c0f9-2100-3e11-7493286005c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:bcfdad93-c0f9-2100-3e11-7493286005c4
msgctxt "h95600598g02c6g4b3cg84d5gf443fd208027"
msgid "Good. Gods help us both if I came all the way down here for nothin'."
msgstr "다행이야. 여기까지 와서 아무것도 얻지 못하면 큰일 날 뻔했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = bdb38cd1-8554-8386-af91-1ab475202454
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_MyconidCircle_DwarvenAlchemist_Knows_NoblestalkFunction(1) = False
#. SetFlags:
#.   Dialog:
#.     - UND_MyconidCircle_DwarvenAlchemist_Knows_NoblestalkFunction(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:bdb38cd1-8554-8386-af91-1ab475202454
msgctxt "h0691cee2g51a9g4098g9f86gcbc3f62f2582"
msgid "What makes this mushroom so valuable?"
msgstr "왜 이 버섯이 그렇게 가치가 있는 거죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = bfc045da-b276-7b15-9765-bb210eead1ff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:bfc045da-b276-7b15-9765-bb210eead1ff
msgctxt "h2b252cfag4319g4903gaec9gbf6c25fcc763"
msgid "<i>Bibberbang. </i>That stupid old fool. He should know better."
msgstr "<i>비버뱅이라니. </i>그 멍청한 늙은이. 그보단 잘 알았어야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = c0ace0a7-93c6-3682-ed61-3092a6357bbf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_MyconidCircle_DwarvenAlchemist_BaelenReturned_Hasmet(1) = True
#.   User:
#.      - UND_MushroomHunter_Event_LearnedAboutNoblestalk(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:c0ace0a7-93c6-3682-ed61-3092a6357bbf
msgctxt "h0d32e333gec1ag43e8gbdf4g2741bded536d"
msgid "We'll be clearing out, soon enough. Empty-handed, of course."
msgstr "우린 조만간 여길 떠날 거야. 물론 빈손으로 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = c1aecc78-ffc8-1ad6-0033-eeb122412278
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:c1aecc78-ffc8-1ad6-0033-eeb122412278
msgctxt "hc76f2de0g22cfg4010g8c23g80b054c4ff80"
msgid "Worthless old fool. He had one bleedin' job."
msgstr "늙고 쓸모없는 멍청이 같으니. 그가 가진 건 개같은 직업뿐이었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = c2373e58-a943-4124-d951-82a8628ba375
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:c2373e58-a943-4124-d951-82a8628ba375
msgctxt "h909a8f7fge1c9g4bb9g91cbgb9ba6b198ca3"
msgid ""
"My useless husband. Sent him for an errand; it's no surprise he's made a "
"mess of it."
msgstr "내 무능한 남편이야. 심부름을 좀 맡겼지. 곤경에 처했다니 딱히 놀랍지도 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = c366d0d6-8c65-c2ad-01e3-09c748bd6e87
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:c366d0d6-8c65-c2ad-01e3-09c748bd6e87
msgctxt "h2142157dgb9c9g42b2g87a5gbffc0676910b"
msgid "<i>Keep it for yourself.</i>"
msgstr "<i>넘기지 않는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = c430beb9-c39b-633d-7089-cf721907f8e3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MushroomHunter_State_Saved = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:c430beb9-c39b-633d-7089-cf721907f8e3
msgctxt "hb725ac4egc14eg474aga9a7g9866d231c2f0"
msgid "It didn't look good."
msgstr "상황이 좋아 보이진 않았어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = c4cb368a-bf7c-a641-4402-47bf0738e64a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:c4cb368a-bf7c-a641-4402-47bf0738e64a
msgctxt "hdbeb1a0bge7c4g4d4eg9a0dg5832c631e691"
msgid "Indeed. I saw both dwarf and squirrel, in the flesh."
msgstr "진짜야. 드워프와 다람쥐 둘 다, 내 눈으로 직접 봤어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = c57714f1-c61e-adca-907d-4c16af39e3b0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:c57714f1-c61e-adca-907d-4c16af39e3b0
msgctxt "hbaa0b30bg5f8cg4431gbcd1g424653841d06"
msgid "Why do you need it so badly?"
msgstr "왜 그걸 그렇게 간절히 원하시는 거죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = c5bd03d1-e25b-ee31-90a9-2294213f99db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:c5bd03d1-e25b-ee31-90a9-2294213f99db
msgctxt "hb7f0d1b5g2a66g4169g8668g6c3520ba1036"
msgid "No idea. I left it up to fate."
msgstr "전혀 모르겠군요. 그냥 운명에 맡기고 왔거든요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = c5c8d346-5594-494e-dfe6-a17440c38d68
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:c5c8d346-5594-494e-dfe6-a17440c38d68
msgctxt "h8cda2690g1ac1g415bg8438gb40435cb03d5"
msgid "What will you do with it?"
msgstr "그걸로 뭘 하실 건가요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = c6970050-886a-68c4-2abb-d0c0cce903ef
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_MyconidCircle_DwarvenAlchemist_Event_RefusedHerNoblestalk(1) = False
#.      - UND_MyconidCircle_DwarvenAlchemist_Event_CheatedDerryth(1) = False
#.   Global:
#.      - UND_DwarvenAlchemist_State_AlchemistGotNoblestalk = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:c6970050-886a-68c4-2abb-d0c0cce903ef
msgctxt "h72c18b14g8828g4813gbc50ga80aef08ff23"
msgid "No point in lingering now I've got the noblestalk."
msgstr "이제 귀족줄기도 손에 넣었으니 여기서 뭉그적거릴 이유가 없지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = c7142664-bce5-d8be-f4d6-6350456668e0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_BaelenDescriptiongGiven = False
#.      - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_SuccessfulLie = False
#. SetFlags:
#.   Local:
#.     - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_BaelenDescriptiongGiven = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:c7142664-bce5-d8be-f4d6-6350456668e0
msgctxt "hec480eb5g4be5g48edg9af9g1015476100f1"
msgid "What does Baelen look like?"
msgstr "베일렌은 어떻게 생겼죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = c99a5f56-64a6-b047-9481-41a1266465a7
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Local:
#.      - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_AskedForPayment = True
#. TagRule: ROGUE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:c99a5f56-64a6-b047-9481-41a1266465a7
msgctxt "hacd8568bgcb54g4cb2g867ege35a9c6e14e3"
msgid ""
"Not good enough. Give me something, or this noblestalk disappears right "
"before your eyes."
msgstr "그걸론 안 되겠는데요. 제게 뭘 내놓던가, 당신 눈앞에서 귀족줄기를 없애드리죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = c9caf53a-90b6-949b-e935-c7877a63d1a4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_MyconidCircle_DwarvenAlchemist_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - UND_MyconidCircle_DwarvenAlchemist_HasMet(1) = True
#.   Global:
#.     - UND_MyconidCircle_DwarvenAlchemist_LookingForBaelen = True
#. TagRule: DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:c9caf53a-90b6-949b-e935-c7877a63d1a4
msgctxt "hbf216e86ge195g4ec4g8d55gece22a242314"
msgid "A drow? Play nice, or these 'shrooms will be on you in a flash."
msgstr "드로우? 착하게 굴지 않으면 이 버섯들이 순식간에 당신을 덮칠 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = c9caf53a-90b6-949b-e935-c7877a63d1a4
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_MyconidCircle_DwarvenAlchemist_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - UND_MyconidCircle_DwarvenAlchemist_HasMet(1) = True
#.   Global:
#.     - UND_MyconidCircle_DwarvenAlchemist_LookingForBaelen = True
#. TagRule: DUERGARDWARF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:c9caf53a-90b6-949b-e935-c7877a63d1a4
msgctxt "hb7daefa2g4d00g4d96g98e5g2c5193465d56"
msgid "A duergar? Play nice, or these 'shrooms will be on you in a flash."
msgstr "듀에르가? 착하게 굴지 않으면 이 버섯들이 순식간에 당신을 덮칠 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = c9caf53a-90b6-949b-e935-c7877a63d1a4
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_MyconidCircle_DwarvenAlchemist_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - UND_MyconidCircle_DwarvenAlchemist_HasMet(1) = True
#.   Global:
#.     - UND_MyconidCircle_DwarvenAlchemist_LookingForBaelen = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:c9caf53a-90b6-949b-e935-c7877a63d1a4
msgctxt "h0d1a50b7g0408g4e41g933fgacd563543391"
msgid "Seems the 'shrooms are letting in more people every day."
msgstr "보아하니 버섯들이 매일 더 많은 사람들을 들이고 있는 것 같군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = c9d936f0-eced-4240-45a2-1245f60dd726
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:c9d936f0-eced-4240-45a2-1245f60dd726
msgctxt "h898ace94gca14g4d7cg932dg786da19673a0"
msgid "Ah. To no surprise of mine, you're more competent than Baelen."
msgstr "아. 놀랄 것도 없이, 당신이 베일렌보다 일을 잘하는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = ca3779e1-ff14-25c9-609f-4f3796dd4987
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:ca3779e1-ff14-25c9-609f-4f3796dd4987
msgctxt "hb3bd9509g62e4g40f8g8936gb99e9c4a8228"
msgid "Go on, then. Hand it over."
msgstr "그럼, 이리 넘겨."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = cd446f66-ba43-0961-905f-8cce9a14e02b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:cd446f66-ba43-0961-905f-8cce9a14e02b
msgctxt "hb5f43b82g3cb2g4737gb767gbcf91d0f8fdd"
msgid ""
"Baelen nearly sunk the shop to pay for drink, when he was of his own mind. "
"This might allow me to hang on a little longer."
msgstr "베일렌은 술값을 치르려고 가게를 거의 망가뜨렸는데, 그가 제정신일때였지. 이게 내가 조금 더 버티게 해줄지도 모르겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = ce4f74f9-d997-d4ad-a55d-a96a5ac1d492
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:ce4f74f9-d997-d4ad-a55d-a96a5ac1d492
msgctxt "hb5fc27dfg6734g4044gb7d1g13b938ae9948"
msgid ""
"Right now? Waiting for my idiot husband's return. 'Less you've seen him, we "
"don't have much to discuss."
msgstr "지금 말인가? 내 머저리 남편의 귀환을 기다리고 있지. 자네가 그를 본 게 아니라면, 우리가 논할 것은 별로 없을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = cefc6b9f-108e-951d-b18f-10a2635a3d01
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:cefc6b9f-108e-951d-b18f-10a2635a3d01
msgctxt "h8dc74c87g27b8g4be6g8221gc1cbb0034733"
msgid "You're a beast - you and Baelen  would make fine bedfellows."
msgstr "너흰 짐승이야 -  당신이랑 베일렌 둘 다 말이야, 서로 죽이 잘 맞겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = cf15f6cd-418b-1262-2a09-074edf604e72
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_OfferedToFindBaelen = False
#. SetFlags:
#.   Local:
#.     - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_OfferedToFindBaelen = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:cf15f6cd-418b-1262-2a09-074edf604e72
msgctxt "hff50414bg4968g4edfgae62g7472f8f71329"
msgid "Need some help finding him?"
msgstr "그를 찾는 데 도움이 필요합니까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = d0360010-8cfa-0273-d7c5-09a9e0b61cf5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_MyconidCircle_DwarvenAlchemist_knows_BaelenHusband(1) = False
#. SetFlags:
#.   Dialog:
#.     - UND_MyconidCircle_DwarvenAlchemist_knows_BaelenHusband(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:d0360010-8cfa-0273-d7c5-09a9e0b61cf5
msgctxt "h0b4c398dga140g485fg811ag9b4a881c1974"
msgid "Who is he to you?"
msgstr "그와는 어떤 사이입니까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = d037b3e5-ea3d-3caa-eeeb-988e270ef0f0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MushroomHunter_State_Saved = False
#.   Local:
#.      - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_OfferedToFindBaelen = False
#. SetFlags:
#.   Local:
#.     - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_OfferedToFindBaelen = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:d037b3e5-ea3d-3caa-eeeb-988e270ef0f0
msgctxt "h04be3911gcc02g4e27gbf27g8b8f268867f3"
msgid "I could help him - for a price."
msgstr "보상만 해준다면, 그를 도와줄 수도 있습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = d1d9c797-7a5d-6126-174f-fe322c21efe2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:d1d9c797-7a5d-6126-174f-fe322c21efe2
msgctxt "h16c9159bg289eg4f79gab14g3a7e673a936e"
msgid "Oh, an <i>honest mistake</i>, was it? Never mind."
msgstr "오, <i>단순 실수</i>였지, 그렇지? 신경 쓰지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = d2d33fdf-1f2d-ccdf-4e7b-3f0c765fc7e7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_MyconidCircle_DwarvenAlchemist_KnowsBaelenDead = True
#.   Quest:
#.     - UND_MushroomHunter.ReportedToDerryth_BaelenIsDead(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:d2d33fdf-1f2d-ccdf-4e7b-3f0c765fc7e7
msgctxt "h4faa281ag991bg4503g8bc8g327ec54dad35"
msgid "<i>Dead?</i>"
msgstr "<i>죽었다고?</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = d3149eec-628e-d1b3-1188-92377de0eddd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_BaelenDescriptiongGiven = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:d3149eec-628e-d1b3-1188-92377de0eddd
msgctxt "h4b9ee2cbg73c5g4dceg82f6g5b2a1a09fef6"
msgid ""
"And his pet squirrel? He goes nowhere without that little fluffball on his "
"shoulder."
msgstr "그리고 그의 애완 다람쥐? 그는 그 작은 솜뭉치 없이는 어디도 가지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = d3b4e8a3-57d9-ef1a-93da-b6ceeb3dfe12
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:d3b4e8a3-57d9-ef1a-93da-b6ceeb3dfe12
msgctxt "h9db54a2eg90e7g48e3ga0b2g15c4b5a98f8f"
msgid "You don't understand. You don't know what he's capable of."
msgstr "이해를 못하는군. 당신은 그가 무슨 짓을 할 수 있는지 몰라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = d845a286-a601-4d36-b842-63b2dc9e29e2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_MyconidCircle_DwarvenAlchemist_BaelenRestoredHasmet(1) = False
#.   Global:
#.      - UND_MushroomHunter_Event_AteMushroom = True
#. SetFlags:
#.   Dialog:
#.     - UND_MyconidCircle_DwarvenAlchemist_BaelenRestoredHasmet(1) = True
#.   Quest:
#.     - UND_MushroomHunter.ReportedToDerryth_BaelenIsAlive(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:d845a286-a601-4d36-b842-63b2dc9e29e2
msgctxt "h843ca172g7d7cg42e6ga5cfgbaf105d991b3"
msgid "You don't know what you've done. Leave me be."
msgstr "당신이 지금 무슨 짓을 한 건지 모를 거야. 날 내버려 둬."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = dbc14cea-a777-f198-c751-1fb6c31f92de
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DROWELF and DUERGARDWARF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:dbc14cea-a777-f198-c751-1fb6c31f92de
msgctxt "hd14faa3ag3d37g4754gadadgd2ac9542465a"
msgid ""
"Might do. Don't know why the likes of you'd care though. Besides, helping "
"her will do nothing for my purse."
msgstr ""
"그럴 수도 있겠지. 하지만 너 같은 놈이 왜 그런 걸 신경 쓰는지는 모르겠어. 게다가 그녀를 도와줘 봤자 내게는 아무 이득도 없을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = dbc14cea-a777-f198-c751-1fb6c31f92de
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:dbc14cea-a777-f198-c751-1fb6c31f92de
msgctxt "h1f836f8agfc2fg4862g9664gf3ad6d14b0dc"
msgid ""
"Might do. But why bother? Thing sells in town for enough to make your eyes "
"bulge."
msgstr "그럴 수도 있어. 근데 왜 귀찮게 해? 그거 마을에서 팔면 눈이 튀어나올 만큼 돈을 벌 수 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = dc92fb51-79ab-db85-2279-1e689fafd3aa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:dc92fb51-79ab-db85-2279-1e689fafd3aa
msgctxt "h6f7f63c4g8e3bg4bffgb04fg2813e8efd90e"
msgid ""
"I've yet met an ailment it couldn't help - baldness, blindness, poison, "
"piles..."
msgstr "아직까지 이 약이 도와주지 못하는 병을 만나지 못했어. 탈모, 실명, 독, 치질..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = dcad543d-7c97-41bb-a341-bcabc35fa833
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_MyconidCircle_DwarvenAlchemist_knows_BaelenHusband(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:dcad543d-7c97-41bb-a341-bcabc35fa833
msgctxt "h93710c96g549bg404ag9310g4bc78420a1a1"
msgid ""
"Right now? Waiting for my idiot husband's return. 'less you've seen him, we "
"don't have much to discuss."
msgstr "지금 말인가? 내 머저리 남편의 귀환을 기다리고 있지. 자네가 그를 본 게 아니라면, 우리가 논할 것은 별로 없을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = dcbd8af7-4fe0-45a5-b10f-2eb269692400
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:dcbd8af7-4fe0-45a5-b10f-2eb269692400
msgctxt "h3d5468e3g858cg4906gad4fgee36f4d5896e"
msgid "Good enough?"
msgstr "충분해?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = df8acc6e-c0ed-516a-880a-711f24a3f181
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_WhatDoingHere = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:df8acc6e-c0ed-516a-880a-711f24a3f181
msgctxt "he0b1661bga34dg4112g96cdg95c967979c78"
msgid "Now that's settled, what are you really doing down here?"
msgstr "일이 해결되었으니 묻습니다만, 실제로는 이 아래에서 뭘 하고 있었습니까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = e02007e2-1a9a-4b07-1186-53ac290fd8f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:e02007e2-1a9a-4b07-1186-53ac290fd8f0
msgctxt "hca288a98ge7a1g432cgb6f3g0415e17b94bd"
msgid "Give it or don't."
msgstr "주든지, 말든지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = e0696c10-32c2-14a4-9ed2-6ac82dad348f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:e0696c10-32c2-14a4-9ed2-6ac82dad348f
msgctxt "h8c6f0ddege0f7g401fg8ec0g22b31d8fff67"
msgid ""
"I do thank you. Come visit me in Baldur's Gate if you find yourself that "
"way. We - <i>I </i>- run a shop called Bonecloak's."
msgstr "정말 고마워. 발더스 게이트에 가면 꼭 나를 찾아와. 우린 - <i>난</i> - 본클록스라는 상점을 운영해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = e0a67db6-1a67-df0a-fa34-efa451aa7e08
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:e0a67db6-1a67-df0a-fa34-efa451aa7e08
msgctxt "h13b4d5bbgff6cg47ddg93d1gb8455e281c73"
msgid "You're just like him. Everyone is, in the end."
msgstr "너도 그와 같아. 결국 모두가 그렇지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = e3968971-7246-8911-454a-5ccbe87995ca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:e3968971-7246-8911-454a-5ccbe87995ca
msgctxt "hc06945ecg1710g411cg93ebg546bbe348b93"
msgid ""
"My useless husband. Sent him for an errand; it's no surprise he's made a "
"mess of it."
msgstr "내 무능한 남편이야. 심부름을 좀 맡겼지. 곤경에 처했다니 딱히 놀랍지도 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = e5e7e1ea-1744-08e9-92df-727a59dde770
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_MushroomHunter_State_HasMushroom(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:e5e7e1ea-1744-08e9-92df-727a59dde770
#, fuzzy
msgctxt "h1633ee84g6439g4e15gbe1fgad4bcdf57f02"
msgid "<i>Show her the noblestalk.</i>"
msgstr "<i>그녀에게 귀족줄기를 보여준다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = e605bfe0-6c79-5d72-c0be-d39668e11e51
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:e605bfe0-6c79-5d72-c0be-d39668e11e51
msgctxt "hcaf6a29bgc071g4944gac17g21a8956adf38"
msgid "No? Thought not. Clear off then."
msgstr "싫다고? 그럴 줄 알았어. 그럼 저리 가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = e7c9c245-e433-5afd-49e5-d92c5152bd91
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - UND_MyconidCircle_DwarvenAlchemist_Event_CheatedDerryth(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:e7c9c245-e433-5afd-49e5-d92c5152bd91
#, fuzzy
msgctxt "h67693ea9gd643g4143g9c54g6cb29c62ee18"
msgid "<i>Take the reward and keep the noblestalk.</i>"
msgstr "<i>보상을 받고 귀족줄기도 가지고 있는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = e7d1c76e-1587-96dd-c498-1fa1d06ddc8c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:e7d1c76e-1587-96dd-c498-1fa1d06ddc8c
msgctxt "hb2f2e001g9758g4b56g8629g0c116cbd4735"
msgid ""
"Might do. But why bother? Thing sells in town for enough to make your eyes "
"bulge."
msgstr "그럴 수도 있어. 근데 왜 귀찮게 해? 그거 마을에서 팔면 눈이 튀어나올 만큼 돈을 벌 수 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = e8b9ad20-8318-350b-22fe-c254659ba81f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:e8b9ad20-8318-350b-22fe-c254659ba81f
msgctxt "h5a48c906g5fa0g4141gb85cgbc078f957aa6"
msgid "No love lost between you two, clearly."
msgstr "확실히 두분 사이에 애정은 없는 것 같군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = e8d9cb64-5498-5518-07dd-3281a78fbfce
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:e8d9cb64-5498-5518-07dd-3281a78fbfce
msgctxt "h050a986fgba62g49f0g94e5g644a997e62c0"
msgid "I'd say it was a pleasure doing business, 'cept it wasn't. Off you go."
msgstr "좋은 거래였다고 하고 싶지만, 그럴 수가 없군. 이제 저리 가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = e9365516-b2ae-1df8-e601-bced44660ba5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_MushroomHunter_State_HasMushroom(1) = True
#. SetFlags:
#.   Global:
#.     - UND_DwarvenAlchemist_State_AlchemistGotNoblestalk = True
#.   Object:
#.     - UND_MushroomHunter_Event_GiveMushroom(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:e9365516-b2ae-1df8-e601-bced44660ba5
#, fuzzy
msgctxt "ha321252bg9a7fg4066gb140g8b0785e97f32"
msgid "<i>Give her the noblestalk in return.</i>"
msgstr "<i>대가로 그녀에게 귀족줄기를 건네준다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = e9fb9945-7965-0b7e-a39a-7741ed91ae3c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:e9fb9945-7965-0b7e-a39a-7741ed91ae3c
msgctxt "h4570f7b7g2f13g47ddgb9a8g863faa31bb56"
msgid ""
"Baelen's meek now, but he used to be a rotten old bastard. Treated me like "
"an old shoe for seventy years."
msgstr "지금은 온순해졌지만, 베일렌은 원래 지독한 영감탱이였어. 70년 동안이나 날 헌신짝처럼 대했지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = ecd10243-eb91-0301-16ed-301320696c7c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_MyconidCircle_DwarvenAlchemist_Event_RefusedHerNoblestalk(1) = False
#.      - UND_MyconidCircle_DwarvenAlchemist_Event_CheatedDerryth(1) = True
#.   Global:
#.      - UND_DwarvenAlchemist_State_AlchemistGotNoblestalk = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:ecd10243-eb91-0301-16ed-301320696c7c
msgctxt "h55ff27fdg7746g48b6g9261ge078c0348122"
msgid ""
"Unless you want to take that lump with you, seeing as you've got the ring he "
"gave me."
msgstr "그 덩어리를 가지고 가길 원하지 않겠지. 그가 나한테 준 반지를 가지게 됐잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = ef6c1b76-f915-4717-3da9-e877ca397c91
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:ef6c1b76-f915-4717-3da9-e877ca397c91
msgctxt "ha653104agd4eag4436g89ddgbad2d1f8c926"
msgid ""
"Baelen ain't got a pet squirrel and you ain't seem him, have you? Forget it."
msgstr "베일렌은 애완 다람쥐가 없고, 당신은 그를 본 적이 없지? 잊어버려."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = f32b5392-7444-e455-9940-967487c94ce5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:f32b5392-7444-e455-9940-967487c94ce5
msgctxt "hf0e14033gdcc8g4333ga2c0gf4dc4db83198"
msgid "I thank you. Truly I do."
msgstr "고마워. 진심으로."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = f43981c7-12f4-8443-938b-697e163e97e0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MushroomHunter_State_BaelenDead = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:f43981c7-12f4-8443-938b-697e163e97e0
msgctxt "h546cc445gbce7g4b6bgb7afg1e46e267ae87"
msgid "Baelen is dead."
msgstr "베일렌은 죽었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = f5ee60f4-7024-6fb5-1d4a-88e3cbb5857a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_EvilTagPersuade = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:f5ee60f4-7024-6fb5-1d4a-88e3cbb5857a
msgctxt "h6ab2b143g1d12g485eg8205gf832af887f8b"
msgid "Fine, go ahead. I'll find a way to fish it back out, or get another."
msgstr "좋아, 계속해. 다시 낚을 방법을 찾거나 다른 것을 구할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = f5f494c0-2e70-1b59-4a26-a8edf92f537d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_EvilTagPersuade = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:f5f494c0-2e70-1b59-4a26-a8edf92f537d
msgctxt "ha540338eg3d2bg45e7gbd6dgd8c16ad2a0e3"
msgid ""
"I'm a businesswoman - I know a bluff when I hear it. Hand over the 'shroom "
"or clear off."
msgstr "나는 사업가야. 허풍은 들으면 알아. 버섯을 넘겨주거나 치워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = f5f94b0b-f77c-d8f4-d7f4-529cbdad4e11
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_MyconidCircle_DwarvenAlchemist_BaelenReturned_Hasmet(1) = True
#.   User:
#.      - UND_MushroomHunter_Event_LearnedAboutNoblestalk(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:f5f94b0b-f77c-d8f4-d7f4-529cbdad4e11
msgctxt "h60f1b9degb293g424bg9c13gde62d770edbf"
msgid "We'll be clearing out, soon enough."
msgstr "우린 조만간 여길 떠날 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = f753883b-82cc-6947-2b30-65018ed92218
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:f753883b-82cc-6947-2b30-65018ed92218
msgctxt "hdd72a946g154eg426fg8a3dg104cfa9766f6"
msgid "Green. With a very fine weave."
msgstr "초록색. 매우 세밀하게 짜여진."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = f7a7dbe9-23a4-6bca-8a64-37bdbea73ef1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_MyconidCircle_DwarvenAlchemist_knows_BaelenHusband(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:f7a7dbe9-23a4-6bca-8a64-37bdbea73ef1
msgctxt "h7e1da118gf7b7g4368g81a8gbeea737f03c3"
msgid ""
"Right now? Waiting for that idiot Baelen's return. 'less you've seen him, we "
"don't have much to discuss."
msgstr "지금 말인가? 그 머저리 베일렌의 귀환을 기다리고 있지. 당신이 그를 본 게 아니라면, 우리가 논할 것은 별로 없을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Derryth Bonecloak
#. NodeID = f8314ff6-9522-1810-eee1-20ed94109e93
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - fb0e13b6-cc68-d496-51c2-4594f4f5bf40_AcknowledgeBaelenQuery = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:f8314ff6-9522-1810-eee1-20ed94109e93
msgctxt "h9f50a194gf4f1g4f0cg94bcgaa3e113281ee"
msgid ""
"You're daft enough to get on with Baelen. Speaking of, you haven't answered "
"my question - seen him?"
msgstr "당신은 베일렌과 잘 지낼만큼 멍청해. 말하자면, 당신은 내 질문에 대답하지 않았어 - 그를 봤나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = fbb8b9f9-fba9-71f6-1944-e76c26e2f26f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - UND_MyconidCircle_DwarvenAlchemist_Event_RefusedHerNoblestalk(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:fbb8b9f9-fba9-71f6-1944-e76c26e2f26f
msgctxt "h591cba7dgf0b4g41a7g8e8fg5a532ca781ff"
msgid "Your grovelling needs work. I'm keeping this mushroom for myself."
msgstr "너의 비굴함은 더 노력이 필요해. 이 버섯은 내가 가져갈 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = fcb8d52c-f8ad-4f5b-6e1f-912b16cb2e23
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: LOLTHDROWELF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:fcb8d52c-f8ad-4f5b-6e1f-912b16cb2e23
msgctxt "h055b8516g9749g4eadg8fc1geb75af65d8c8"
msgid ""
"You're a fool to keep such a dolt at your side - you should leave him to die."
msgstr "그런 멍청이를 옆에 두는 당신이 바보야. 그를 죽게 내버려 두어야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist
#. Speaker = Player
#. NodeID = fcb8d52c-f8ad-4f5b-6e1f-912b16cb2e23
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_DUERGARDWARF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DwarvenAlchemist:fcb8d52c-f8ad-4f5b-6e1f-912b16cb2e23
msgctxt "h2e255c08gba5ag45b5g811fg4bd09c59e3ae"
msgid ""
"You ought to sell the dimwit. A little hard labour could be whipped out of "
"him."
msgstr "당신은 그 멍청이를 팔아야 해. 약간의 힘든 노동은 그에게 채찍질이 될 수 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 008f05b9-abeb-8a78-6cbc-6122a2b5a919
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:008f05b9-abeb-8a78-6cbc-6122a2b5a919
msgctxt "h7c21bfb1gd5f1g4031ga637g58688dba8085"
msgid "You're right. Got my own kin need helping, as soon as I'm on my feet."
msgstr "네 말이 맞아. 도움이 필요한 동족들이 있어, 내 발이 낫는다면 가야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 014c33b3-f5d0-bc31-514d-e6f5e2f60cc1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:014c33b3-f5d0-bc31-514d-e6f5e2f60cc1
msgctxt "h67c56e73g9a5fg4369gada3gcfbb995fd22f"
msgid "Aye, I heard about Wulbren. But the cause is bigger than any one of us."
msgstr "아, 울브렌 이야기는 들었어. 하지만 우리 중 누구도 명분보다 중요하진 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Player
#. NodeID = 050ec3fe-af11-d4ee-ecf0-cdbf06f4145e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GNOME(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:050ec3fe-af11-d4ee-ecf0-cdbf06f4145e
msgctxt "h6cccc17fg654ag4de9gbb82g2cba8ab7ec50"
msgid "May Earthcaller keep them."
msgstr "어스콜러께서 그들을 보존하시길."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Karlach
#. NodeID = 05a28660-297e-4c51-9299-e8f21c438ace
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_KARLACH(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:05a28660-297e-4c51-9299-e8f21c438ace
msgctxt "h89e765bfg99bdg4af3g8f35gad89536d0e53"
msgid "Sound shrooms. Snake druids take note."
msgstr "훌륭한 버섯들이군. 뱀의 드루이드들도 이걸 보고 배워야 하는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 08811d30-4fce-0529-d294-3069da1ff4fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:08811d30-4fce-0529-d294-3069da1ff4fc
msgctxt "hfb5ea6a8gf7d3g4586g8915g5e66eac7a449"
msgid "But bad enemies, too. Some folk are about to be reminded of that."
msgstr "하지만 최악의 적이 되기도 하지. 몇몇 녀석들에게 이를 상기시켜줄 참이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 08b1f959-1c74-d590-6628-ecdc09d82eac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:08b1f959-1c74-d590-6628-ecdc09d82eac
msgctxt "hd9014e3egee22g468bg91aag5630df9d45c8"
msgid ""
"... seems you're the helping kind. All right - I need you to rescue my kin."
msgstr "... 너는 남을 돕는 성격인 것 같네. 알았어 - 네가 내 동족을 구해줬으면 좋겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 0a0bf189-f847-5a81-7dac-0d9f2af2a7d8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_InjuredGnome_State_Healed = False
#.      - UND_InjuredGnome_State_Worse = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:0a0bf189-f847-5a81-7dac-0d9f2af2a7d8
msgctxt "h0fa00432g4b82g4192g84f2ge027b66b0aed"
msgid "Ah. Ngh."
msgstr "아. 윽."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 0b687408-7d99-0297-976f-7744c0f2832d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:0b687408-7d99-0297-976f-7744c0f2832d
msgctxt "hac174ce5g355bg41a3gb8c5gf83d1d230996"
msgid ""
"I owe you, sure enough. But I've nothing to give. If you were to free my "
"kin..."
msgstr "나는 너에게 충분히 빚졌지만 나는 가진 게 없어. 만약 네가 내 동족을 해방시켜준다면..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Player
#. NodeID = 0ba960a7-8942-03fc-f85b-d45b9311554b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_InjuredGnome_State_GaveQuest = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:0ba960a7-8942-03fc-f85b-d45b9311554b
msgctxt "h86173f99g782eg4c2fg9be0gbdc80fc50c24"
msgid "Sorry. You're going to have save them yourself."
msgstr "안타깝긴 하지만 네 손으로 직접 구하라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 0c30eb30-ece5-d9c8-043b-f170c2fba93e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:0c30eb30-ece5-d9c8-043b-f170c2fba93e
msgctxt "hd9cf73cagb5e3g453bgb0c3gc54d5fc8b4fa"
msgid "Aye, Now I know."
msgstr "그래, 이제 나도 알아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 0d3884d5-500e-b59b-2904-90cf12378521
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:0d3884d5-500e-b59b-2904-90cf12378521
msgctxt "h9b0ae464gd662g4a1dgadc4gab458cfbbc01"
msgid "Wise. Glad to run into someone with survival at heart."
msgstr "현명하네. 생존을 염두에 둔 사람을 만나서 다행이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 0dd8e222-bc3d-09d8-dc8b-ec3bec9f7c03
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:0dd8e222-bc3d-09d8-dc8b-ec3bec9f7c03
msgctxt "h3f416c7fg0d66g442dg9595ged234159a47e"
msgid "In just... just a minute."
msgstr "잠... 잠깐만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 0e4176bc-a2a4-342d-5a86-ae0581fec571
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:0e4176bc-a2a4-342d-5a86-ae0581fec571
msgctxt "hd51aa518g8c8eg4821g898bg435c8fb5702f"
msgid ""
"It's Ironhand we favoured most. Seems he didn't favour us back. Leave me, "
"please."
msgstr "우리가 섬기던 건 아이언핸드님이었어. 그분이 보답해 주시진 않은 것 같지만. 날 내버려 둬, 부탁이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Player
#. NodeID = 0f320ac1-06fb-f082-b9f4-b6617372fee1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_IronhandGnomes_Knows_WulbrenInMoonrise = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:0f320ac1-06fb-f082-b9f4-b6617372fee1
msgctxt "h616f2a7fg12b9g412cg8b13g76315e8127ab"
msgid "Your leader is still locked up in Moonrise Towers."
msgstr "너희 지도자가 아직 문라이즈 타워에 감금되어 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 10a291ba-31e4-702f-928a-eda0fb76c486
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_InjuredGnome_Knows_KinDead = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:10a291ba-31e4-702f-928a-eda0fb76c486
msgctxt "h82ba9dc9gfe66g47dagbea4g27edb3a190e3"
msgid "Told you already - leave me."
msgstr "이미 말해줬잖아, 날 내버려 둬."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Player
#. NodeID = 16f175a9-02c0-0f13-a309-c14772503c29
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:16f175a9-02c0-0f13-a309-c14772503c29
msgctxt "hb986ef29gca3dg43f5ga251g094c648054d2"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Player
#. NodeID = 1724b014-4c8f-2184-6226-5ee728111973
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_State_LeaderFreedGnomes = True
#.      - UND_GnomeWorkers_State_PermaDefeated = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:1724b014-4c8f-2184-6226-5ee728111973
msgctxt "h5fee9165ged83g41e1gb52age92151e4c1b3"
msgid "I've saved them. Expect to see them here soon."
msgstr "내가 구했어. 곧 볼 수 있을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 176cc1fc-c2cd-c35e-ffad-234bbde7f4ff
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_IronhandGnomes_Knows_IronhandGnomes = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:176cc1fc-c2cd-c35e-ffad-234bbde7f4ff
msgctxt "h743e7974gf6eeg423fga9f4gc651674ef3ba"
msgid "We can pay. We're Ironhand clan, best artificers in Baldur's Gate."
msgstr "제대로 보상할게. 우린 발더스 게이트 제일의 기술자들인 아이언핸드 클랜이니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Player
#. NodeID = 1858c177-1fab-4475-7552-9c536e159951
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 5e9c4c72-4f56-2646-ce36-88207d2dc33c_GaveVagueAnswer = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:1858c177-1fab-4475-7552-9c536e159951
msgctxt "h7d456fe7g6207g4664gbea4gbe48efa0f68a"
msgid "No, I don't understand. Enough evasion and explain it."
msgstr "아니, 이해되지 않는데. 빙 돌려 이야기하지 말고 설명해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 1af1a5cb-b8a6-dfb2-55df-7131806869ce
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_InjuredGnome_State_Healed = True
#.      - UND_GnomeWorkers_State_PermaDefeated = False
#.      - UND_DuergarCamp_State_GnomeAtMyconids = True
#.   Local:
#.      - 5e9c4c72-4f56-2646-ce36-88207d2dc33c_KinSaved = False
#. SetFlags:
#.   Local:
#.     - 5e9c4c72-4f56-2646-ce36-88207d2dc33c_KinSaved = True
#.   Quest:
#.     - HIDDEN_WLD_Boosters.UND_MyconidCircle_InjuredGnome_ReportedGrymforgeFate(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:1af1a5cb-b8a6-dfb2-55df-7131806869ce
msgctxt "hb9eee0adge68ag4fcag9c0agb803e016a801"
msgid ""
"No need for me to ask how you fared - some of my kin have already made it "
"here, safe and sound."
msgstr "어떻게 됐는지는 물을 필요도 없겠네. 내 동족 중 일부가 이미 안전하게 이곳에 도착했으니 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Player
#. NodeID = 1b5703e1-bd15-873b-924e-fcbf26b750d3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_Quest_LoneDuergar_Defeated = True
#.   Local:
#.      - 5e9c4c72-4f56-2646-ce36-88207d2dc33c_ToldLoneDuergarDead = False
#. SetFlags:
#.   Local:
#.     - 5e9c4c72-4f56-2646-ce36-88207d2dc33c_ToldLoneDuergarDead = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:1b5703e1-bd15-873b-924e-fcbf26b750d3
msgctxt "h8750c581gd62bg4fb1g92d0g6b76f60103fa"
msgid "I've killed the duergar that were hunting you."
msgstr "너를 쫓던 듀에르가를 죽였어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 1b998b93-bbc1-7c02-d23a-1e4b1470179e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:1b998b93-bbc1-7c02-d23a-1e4b1470179e
msgctxt "hb0eda91ag29acg45a9g9639ga5eaba1a35f7"
msgid "No. Please."
msgstr "안 돼. 제발."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 1bd179e7-4c41-b165-7ef2-1f54b6d932d0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:1bd179e7-4c41-b165-7ef2-1f54b6d932d0
msgctxt "h419b6bbag8f05g4a40gb2a9g8b69e0c7fcef"
msgid "Ngh. Hard to breathe. Blood's on fire..."
msgstr "으윽. 숨쉬기 힘들어. 피가 타올라..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 1f13c60a-39f2-5f12-72cb-a3e4b387bfc1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:1f13c60a-39f2-5f12-72cb-a3e4b387bfc1
msgctxt "hfd16331cg31aag45f7g8ed3g993dc2aaa9d0"
msgid "Maybe not... but <i>you </i>are. I need you to rescue my kin."
msgstr "그럴지도... 하지만 <i>너는 </i>달라. 네가 내 동족을 구해줬으면 좋겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 200e2247-eb63-a55f-ba42-7255a99c8738
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:200e2247-eb63-a55f-ba42-7255a99c8738
msgctxt "hebb5653bge5f2g4480g99a8gb4d56e3d064c"
msgid ""
"But the Ironhands owe you a different kind of debt. Find us and we'll make "
"good, that I promise."
msgstr "다만 아이언핸드는 너에게 여러모로 빚졌어. 우릴 찾아오면 잘해줄게. 그건 내가 장담해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 20b95ca1-7d6e-4dc3-a9a1-33b553b16c56
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - UND_InjuredGnome_State_Healer(1) = True
#.   Global:
#.     - UND_InjuredGnome_State_Healed = True
#.   Object:
#.     - UND_InjuredGnome_Event_AteNoblestalk(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:20b95ca1-7d6e-4dc3-a9a1-33b553b16c56
msgctxt "h826b4513g41dcg4e87ga682g0a978eed36a4"
msgid "Ah... Gods... whatever that is... I needed it."
msgstr "아... 세상에... 뭔지는 모르겠지만... 이게 필요했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 22491c81-1ade-6fad-a186-479a69d4689c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:22491c81-1ade-6fad-a186-479a69d4689c
msgctxt "hb6b27bedgc18cg4ac1gbbf9ga9b223b95643"
msgid ""
"<i>Hunters? </i>Scavengers, more like. Waiting out there in the dark for me "
"to die."
msgstr "<i>사냥꾼? </i>그냥 하이에나 놈들이야. 어둠 속에 숨어서 내가 죽기만을 기다리고 있겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 226d4472-b94b-f399-6510-cd7d2004dea8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_InjuredGnome_Event_StoleBoots(1) = True
#.      - UND_InjuredGnome_State_Healer(1) = True
#.   Quest:
#.      - UND_GnomeRescue.ThullaAskedHelp(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:226d4472-b94b-f399-6510-cd7d2004dea8
msgctxt "h7a8403dag3bb1g468aga95dgd266371d6c77"
msgid ""
"Ungh. Nick my boots and patch my wounds? An odd trade - but I'll take it."
msgstr "끙. 신발을 훔쳐가고 나서 상처를 치료해 준다고? 거래 방식 한 번 이상한데, 받아들일게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Player
#. NodeID = 23da5899-d1e5-0883-8886-5e636be2db14
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_InjuredGnome_Knows_Poisoned = False
#.   Object:
#.      - UND_InjuredGnome_Knows_DuergarPoisoned(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:23da5899-d1e5-0883-8886-5e636be2db14
msgctxt "h776b24ddg035bg46e7gac79g95bccb4b49af"
msgid "What's wrong with you?"
msgstr "무슨 문제야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Player
#. NodeID = 24229c84-75d0-17df-8b37-0c090722f07e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Quest:
#.      - UND_DuergarPoison.LearnedPoisoned(1) = True
#.   Script:
#.      - GEN_CheckHasItemTemplate_3 = True
#. SetFlags:
#.   Object:
#.     - UND_InjuredGnome_Event_GiveRemedy(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:24229c84-75d0-17df-8b37-0c090722f07e
msgctxt "haba24c3agf9cbg42b0g9a42gcbdd4eac246e"
msgid "<i>Give her a Remedial Potion.</i>"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 25313d30-5744-e9ea-5a6b-7dc1001f484e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_InjuredGnome_State_HasBoots(0) = True
#. SetFlags:
#.   Global:
#.     - UND_InjuredGnome_Knows_RunFromDuergar = True
#.   Object:
#.     - UND_InjuredGnome_Event_GiveBoots(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:25313d30-5744-e9ea-5a6b-7dc1001f484e
msgctxt "h46495437gdeaag4346g9006g0ab77c6ba46b"
msgid ""
"But here - I nabbed these boots from the greys when I ran. I'll feel better "
"knowing you're using 'em to kick some duergar arse."
msgstr ""
"대신 이걸 줄게. 도망치면서 회색 놈들한테서 이 부츠를 챙겨 왔어. 네가 이 부츠를 신고 그놈들 엉덩이를 걷어차 주면 내 기분이 좀 "
"나아질 것 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Player
#. NodeID = 280ae7ea-8a17-5fee-1665-1cab12d8d09e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_InjuredGnome_Event_StoleBoots(1) = False
#.   Global:
#.      - UND_MyconidCircle_Quest_LoneDuergar_Defeated = False
#.      - UND_LoneDuergar_Knows_DuergarHuntGnome = True
#.   Object:
#.      - UND_InjuredGnome_State_HasBoots(0) = True
#. SetFlags:
#.   Object:
#.     - UND_InjuredGnome_LootingSkillcheckSuccess(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:280ae7ea-8a17-5fee-1665-1cab12d8d09e
msgctxt "hebe31046gc342g436bgb179g340fa9d7b97c"
msgid "<i>Eye her boots. They must be the ones Gekh wants.</i>"
msgstr "<i>그녀의 부츠를 살펴본다. 분명 게크가 원하는 것임이 틀림없다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Narrator
#. NodeID = 28d4db9b-4ee0-1980-0307-6aba48b5ba0c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 5e9c4c72-4f56-2646-ce36-88207d2dc33c_CaughtLying = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:28d4db9b-4ee0-1980-0307-6aba48b5ba0c
msgctxt "had53d3a4g2cabg4cb6g8593ge3fa9c472ad3"
msgid "*The briefest hesitation, but enough. She's lying.*"
msgstr "*찰나의 주저함이지만, 알아채기에는 충분합니다. 그녀는 거짓말을 하고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Player
#. NodeID = 2a9f2496-85d6-594b-2f42-945a16259588
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:2a9f2496-85d6-594b-2f42-945a16259588
msgctxt "hb78c968dg750fg4953ga73eg4fa7fda02d08"
msgid "Take it easy and tell me what I can do."
msgstr "진정하고 내가 뭘 해줄 수 있는지 말해 줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Player
#. NodeID = 2c1ab037-71fd-1fe8-d775-481dcb3557b7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Quest:
#.      - UND_DuergarPoison.LearnedPoisoned(1) = True
#.   Script:
#.      - GEN_CheckHasItemTemplate_4 = True
#. SetFlags:
#.   Object:
#.     - UND_InjuredGnome_Event_PoisonResistance(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:2c1ab037-71fd-1fe8-d775-481dcb3557b7
msgctxt "h3a9e0ed7g8c9cg4491g8a75gebd43a325f50"
msgid "<i>Give her an Elixir of Poison Resistance.</i>"
msgstr "<i>독 저항의 영약을 준다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Player
#. NodeID = 2c67e7f1-320e-04c4-075c-87bff3cd76f3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_HiddenGnome_HasMet(1) = True
#.   Global:
#.      - UND_PanicRoom_Event_GnomeSuicide = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:2c67e7f1-320e-04c4-075c-87bff3cd76f3
msgctxt "hf8d54c9agd37fg4002g9c2eg2efb2ec85186"
msgid "Not entirely. Philomeen escaped, too."
msgstr "완전히는 아니야. 필로민도 탈출했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 2cb4c51d-786d-142c-7465-8381183eb470
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_InjuredGnome_HasMet(1) = False
#.   Global:
#.      - UND_InjuredGnome_State_Healed = False
#. SetFlags:
#.   Dialog:
#.     - UND_InjuredGnome_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:2cb4c51d-786d-142c-7465-8381183eb470
msgctxt "h75a1c9e5gd576g4ad8gb81age086dd759e39"
msgid "Don't."
msgstr "그러지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 2e32fb41-c885-91cd-179e-8bbebf0c5cf5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:2e32fb41-c885-91cd-179e-8bbebf0c5cf5
msgctxt "h30af6f17g4490g4d06gb956g47a7652b05f8"
msgid "Thank you. Only wish I could go with you."
msgstr "고마워. 너와 함께 갈 수 있었다면 좋았을 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 2fe35a53-dc1a-42f7-6af5-e76454c21fbb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:2fe35a53-dc1a-42f7-6af5-e76454c21fbb
msgctxt "hd46cee7bg6209g4abbgbb36gb8d7cc49be3f"
msgid "You did...? Then I owe you more than I can ever repay. Thank you."
msgstr "구했다고...? 네게 갚을 수 없는 신세를 졌네. 고마워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Player
#. NodeID = 307a95c7-ad13-2b18-04d4-12d82b24c33d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_InjuredGnome_State_HasAntidote(1) = True
#.   Quest:
#.      - UND_DuergarPoison.LearnedPoisoned(1) = True
#. SetFlags:
#.   Object:
#.     - UND_InjuredGnome_Event_GiveAntidote(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:307a95c7-ad13-2b18-04d4-12d82b24c33d
msgctxt "h32b78789gad90g4ff2gb53fge660501a7cda"
msgid "<i>Give her the antidote.</i>"
msgstr "<i>듀에르가 독의 해독제를 준다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 308ff936-d32f-01ac-5b37-c02600a9540e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:308ff936-d32f-01ac-5b37-c02600a9540e
msgctxt "hc277c556g3017g4c96gbd9fg247289bc9637"
msgid ""
"Should've known - you lot're cruel to the marrow. Well I ain't suffering you "
"easily."
msgstr "당신네들은 뼛속까지 사악하단 걸 알았어야 하는데. 나도 당하고만 있진 않을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 30bcfe64-84b0-52e3-8fa5-6a06c5f77ef1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 5e9c4c72-4f56-2646-ce36-88207d2dc33c_GaveVagueAnswer = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:30bcfe64-84b0-52e3-8fa5-6a06c5f77ef1
msgctxt "h29ec3ed3gd676g4b63g8768g3ddedcbde725"
msgid ""
"We were searching for something to turn the tide. That's all I can say - but "
"it's worth <i>a lot </i>to us. Understand?"
msgstr ""
"우리는 흐름을 전환할 무언가를 찾고 있었어. 내가 말할 수 있는 건 그뿐이지만, 우리에게 <i>큰 </i>의미가 있다고. 이해했어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Narrator
#. NodeID = 329f6676-5146-cefe-cd16-f792eee42f43
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_InjuredGnome_Knows_Poisoned = True
#.   Object:
#.     - UND_InjuredGnome_Knows_PoisonPassiveSuccess(1) = True
#.   Quest:
#.     - UND_DuergarPoison.LearnedPoisoned(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:329f6676-5146-cefe-cd16-f792eee42f43
msgctxt "h94a79396g22eeg48f0g8662g6420f3be7c95"
msgid ""
"*Her condition is familiar. Poison, derived from a wild weed common to the "
"Underdark.*"
msgstr "*그녀의 상태는 익숙합니다. 언더다크에서 흔한 야생 잡초의 독에 중독되었습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Player
#. NodeID = 32cc3557-c143-847a-36a7-c63fcad6caa2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GITHYANKI(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:32cc3557-c143-847a-36a7-c63fcad6caa2
msgctxt "hd46d0b5bge4fcg4125g8a5dg31ba4afa031e"
msgid ""
"Don't mourn. You took your freedom - they waited for it to be handed to them."
msgstr "슬퍼하지 마. 넌 자신의 자유를 쟁취했잖아, 다른 이들은 그저 기다리고만 있었고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 3438b5d3-e8c1-d94c-61e0-d996615e5e27
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:3438b5d3-e8c1-d94c-61e0-d996615e5e27
msgctxt "hd3c5837bgcdd3g4cdag988agf665437ed62a"
msgid ""
"But appearances aside, glad you came along. I have to go - got kin who need "
"me."
msgstr "외모는 제쳐두고라도, 와줘서 고마워. 난 이만 가봐야겠어. 동족이 날 필요로 하거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Player
#. NodeID = 344e47a9-0b77-5782-d18a-6a7e6e52641a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:344e47a9-0b77-5782-d18a-6a7e6e52641a
msgctxt "h15de828bg1560g47bfg94ecgd66c14d4cae4"
msgid "What was this expedition your clan were on?"
msgstr "너희 클랜은 어떤 목적으로 탐험한 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Narrator
#. NodeID = 35618130-508d-4074-ab07-65cdc812b75e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:35618130-508d-4074-ab07-65cdc812b75e
msgctxt "h7293d376gc676g4aacg8006g5437f3c569da"
msgid ""
"*But was it truly <i>nothing?  </i>The pain gripped you tight, robbing you "
"of all composure for a moment...*"
msgstr "*하지만 정말 <i>아무 것도</i> 아니었을까요? 고통은 당신을 꽉 휘어잡았고, 한순간 평정심을 잃을 정도였습니다...*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Player
#. NodeID = 356ed086-b9c9-4fe2-acb6-5a1f5a48a43f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_State_IncurableWound_Unavailable = False
#.      - GLO_Not_For_EA = True
#.   Tag:
#.      - AVATAR(1) = False
#.      - REALLY_SHADOWHEART(1) = True
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_Event_IncurableWoundFlared = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:356ed086-b9c9-4fe2-acb6-5a1f5a48a43f
msgctxt "h42705c2ag6cf1g47e4g8304g3c6a043c2858"
msgid "<i>Ngh</i>... it hurts..."
msgstr "<i>으</i>...아파..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Player
#. NodeID = 3582b153-4048-1bde-17ed-fbd9f8347551
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:3582b153-4048-1bde-17ed-fbd9f8347551
msgctxt "h4072f9f4gb74dg44ddgaa3dgac350820ad11"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 374e124d-5095-11c8-0a45-51d3cb8ceb94
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:374e124d-5095-11c8-0a45-51d3cb8ceb94
msgctxt "hea5d01e5g9744g4c66gab62gb1e06c420d56"
msgid "Garl's garters, I don't have <i>time</i> for this. My kin need me."
msgstr "아파 뒤지겠네, 이럴 <i>시간 </i>없는데. 동족이 날 필요로 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Player
#. NodeID = 3a7ccf0e-96b8-7c5c-ec12-5b59f62fbbb3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:3a7ccf0e-96b8-7c5c-ec12-5b59f62fbbb3
msgctxt "h4ce00c65gb714g4afeg8c5cg85ac7f496911"
msgid "How could I pass by? You were in pain."
msgstr "고통에 시달리고 있는 사람을 어떻게 그냥 지나칠 수 있겠어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Player
#. NodeID = 3b47a6dc-9862-2ea6-665b-1401ddd87403
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:3b47a6dc-9862-2ea6-665b-1401ddd87403
msgctxt "h2cc91d28g2c92g423agad42g83d89e49171c"
msgid "Does there have to be a reason?"
msgstr "꼭 이유가 있어야 하는 건 아니잖아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Player
#. NodeID = 3c41ff9e-3957-4590-0861-e1928336d39a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:3c41ff9e-3957-4590-0861-e1928336d39a
msgctxt "h0ca6ece1ge1d3g4854g86d6g8373124b1cb3"
msgid "I'm sorry. I did everything I could."
msgstr "미안해. 난 최선을 다했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 3ce63a95-e823-49d4-e4c1-a9ab3e0e0171
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:3ce63a95-e823-49d4-e4c1-a9ab3e0e0171
msgctxt "h07617d1fgcac0g44fcg97b7gc8faabd76d00"
msgid "... right. Fine. I'll do that."
msgstr "... 그래. 알았어. 내가 할게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 3d263718-c152-3288-21e0-df0dae43f558
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:3d263718-c152-3288-21e0-df0dae43f558
msgctxt "hbfd34f4dg067ag4f5dgb850g40040c19ba2d"
msgid ""
"No arguments there. Felt like a hook horror was sorting through my guts."
msgstr "반박할 수 없네. 마치 후크 호러가 내 내장을 헤집는 느낌이었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Lae'zel
#. NodeID = 3fd37772-39dc-44d3-bbb5-76aae7aa9d78
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(2) = True
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:3fd37772-39dc-44d3-bbb5-76aae7aa9d78
msgctxt "hee2c6915g4996g4b39g963bgaf96dfd4d0cb"
msgid ""
"These myconids are the welcoming sort, at least where blubbering gnomes are "
"concerned."
msgstr "이 마이코니드들은 우호적인걸. 적어도 흐느끼는 노움들에겐 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 3fed4921-04fb-fb21-7fa8-5aebdcc59657
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:3fed4921-04fb-fb21-7fa8-5aebdcc59657
msgctxt "h6d3e8048gc1e6g4767gbf05g0900db6e4529"
msgid "I know you mean well, but... leave me. Please."
msgstr "좋은 뜻인 건 알지만... 날 그냥 내버려 둬. 부탁이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Player
#. NodeID = 4021490f-0e9e-627d-72e8-a10a0f0cbc3f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DUERGARDWARF(1) = False
#.      - DUERGARDWARF(1) = True
#. SetFlags:
#.   Local:
#.     - 5e9c4c72-4f56-2646-ce36-88207d2dc33c_AdmitDisguise = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:4021490f-0e9e-627d-72e8-a10a0f0cbc3f
msgctxt "h915a36bag7e7cg427fgbd96gb6a0c35b0889"
msgid "I'm not really a duergar - this is just a disguise."
msgstr "난 진짜 듀에르가가 아니야. 그냥 위장한 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Player
#. NodeID = 40c564f7-cb06-45b1-bbd5-dd2beda094b9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:40c564f7-cb06-45b1-bbd5-dd2beda094b9
msgctxt "h41809045g0cbdg4808g975bgf58aacb763d3"
msgid "<i>It was nothing. Put it out of your mind.</i>"
msgstr "<i>아무 일도 아니었다. 마음 속에서 치워 버린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Wyll
#. NodeID = 410ef2b8-e6b4-41e7-a2a2-1fcefce7b751
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_WYLL(6) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:410ef2b8-e6b4-41e7-a2a2-1fcefce7b751
msgctxt "hf37d2792gbbb4g440bgba2dgfd0ca47d5f66"
msgid ""
"These myconids are the hospitable sort. Refreshing, after our run-in with "
"Kagha."
msgstr "이 마이코니드들은 친절하네. 카그하를 겪고 나니 더 기분좋게 느껴지는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Player
#. NodeID = 454f700f-da6c-b209-fd80-b5f2de96725d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:454f700f-da6c-b209-fd80-b5f2de96725d
msgctxt "h1fe4728eg5cfag4000g983cgb8b732d4bbd4"
msgid "You're in no condition to help anyone."
msgstr "그런 몸 상태로 누굴 돕겠다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 468adaff-5fda-eaf0-6437-22a068636e70
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_InjuredGnome_Knows_Poisoned = True
#.     - UND_InjuredGnome_Knows_RunFromDuergar = True
#.   Object:
#.     - UND_InjuredGnome_Knows_DuergarPoisoned(1) = True
#.   Quest:
#.     - UND_DuergarPoison.LearnedPoisoned(1) = True
#. TagRule: DUERGARDWARF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:468adaff-5fda-eaf0-6437-22a068636e70
msgctxt "h4501b0c3gdd2ag42c0gb6e1g9594631df25a"
msgid "Slashed by... <i>your kind. </i>Poison."
msgstr "<i>네...족속</i>이 날 베었어. 중독시켰어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 468adaff-5fda-eaf0-6437-22a068636e70
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_InjuredGnome_Knows_Poisoned = True
#.     - UND_InjuredGnome_Knows_RunFromDuergar = True
#.   Object:
#.     - UND_InjuredGnome_Knows_DuergarPoisoned(1) = True
#.   Quest:
#.     - UND_DuergarPoison.LearnedPoisoned(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:468adaff-5fda-eaf0-6437-22a068636e70
msgctxt "had8b39c2g2975g495eg9d50g0e260022d848"
msgid "Duergar... slashed me. Poison."
msgstr "듀에르가... 나를 벴어. 중독시켰어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Player
#. NodeID = 470eb6f0-4e9c-1dd2-56d3-d8efb357a1db
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:470eb6f0-4e9c-1dd2-56d3-d8efb357a1db
msgctxt "h8c2c9410g563bg4dfbgb2eag76b9fc2e8c2f"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Player
#. NodeID = 48521cf6-5ce8-6ac3-ce37-085b2033aa22
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:48521cf6-5ce8-6ac3-ce37-085b2033aa22
msgctxt "hf9472dcfg7046g4bf6g9696g0e45c8f91d60"
msgid "What are the duergar digging for?"
msgstr "듀에르가는 무엇을 위해서 채굴하고 있는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 487868a4-4bf0-6fdb-c3a9-42a674855a08
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:487868a4-4bf0-6fdb-c3a9-42a674855a08
msgctxt "hb8b5017agd98bg4a54gb6cfg1a1f55858cae"
msgid "Leave me, please."
msgstr "부디 떠나 줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Narrator
#. NodeID = 48956f16-3ed5-45f5-a917-285fce5f6c7e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:48956f16-3ed5-45f5-a917-285fce5f6c7e
msgctxt "h41f10d2bg611bg4398gb9acg29b1239fd015"
msgid "*She offers you nothing.*"
msgstr "*여신은 아무 것도 내려 주지 않습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 4a0d1034-cb4d-44b5-52f2-8209a49ee1a8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:4a0d1034-cb4d-44b5-52f2-8209a49ee1a8
msgctxt "h2792c56cg5ad1g4f80gb0a4gdef7727a8a43"
msgid "I'm telling you we take care of our friends. That's no lie."
msgstr "우리는 친구들을 챙긴다고 말했잖아. 거짓말이 아니라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 4b10fdc4-e3ba-d289-f6d8-49decd5af2e3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:4b10fdc4-e3ba-d289-f6d8-49decd5af2e3
msgctxt "h76f23eb8g11e3g44a7gb8fag4c0a599b840c"
msgid "But... ngh... that cure did the trick. Quick-sharp, too."
msgstr "하지만... 으윽... 그 치료제 효과가 제대로야. 날카롭게 빠르기도 하네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Player
#. NodeID = 4d0da55f-5e1c-3e63-c93b-4c53a57bc51b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_InjuredGnome_Knows_StillRecuperating = True
#.   Local:
#.      - 5e9c4c72-4f56-2646-ce36-88207d2dc33c_FittoMove = False
#. SetFlags:
#.   Local:
#.     - 5e9c4c72-4f56-2646-ce36-88207d2dc33c_FittoMove = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:4d0da55f-5e1c-3e63-c93b-4c53a57bc51b
msgctxt "h94ba4d0fga4c0g4c76gb302g0d8c878a8ad9"
msgid "How long before you're fit to move?"
msgstr "움직일 수 있을 때까지 얼마나 걸리겠어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Player
#. NodeID = 4d0e0ec3-6843-6ee7-49a1-17a9663501f4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 5e9c4c72-4f56-2646-ce36-88207d2dc33c_AgreedToHelp = False
#.   Object:
#.      - UND_InjuredGnome_State_TriedMedicineCheck(1) = True
#.      - UND_InjuredGnome_Knows_PoisonLore(1) = False
#. SetFlags:
#.   Local:
#.     - 5e9c4c72-4f56-2646-ce36-88207d2dc33c_AgreedToHelp = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:4d0e0ec3-6843-6ee7-49a1-17a9663501f4
msgctxt "h8c39ef5egffdag4547g96bcg58eeedfbcc23"
msgid "Sit tight. There must be some way to cure you."
msgstr "가만히 있어. 너를 치료할 방법이 있을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Narrator
#. NodeID = 4d211c59-c07b-3542-fa5e-90de682ca246
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_InjuredGnome_State_HasBoots(0) = True
#. SetFlags:
#.   Object:
#.     - UND_InjuredGnome_LootingSkillcheckSuccess(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:4d211c59-c07b-3542-fa5e-90de682ca246
msgctxt "h6fcfea68g3d88g42c0ga23cg65b2d45b10b5"
msgid "*Mostly junk, but her boots catch your eye.*"
msgstr "*대부분 쓰레기지만, 그녀의 부츠가 당신의 눈길을 끕니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 4d96f0e4-018a-f8d5-d92f-8bca8c62d8a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:4d96f0e4-018a-f8d5-d92f-8bca8c62d8a5
msgctxt "h8695ca37g1479g43bdgba75ga01ebbb76f6b"
msgid ""
"You're faking at being a drow? In the Underdark? I'm not sure if that's "
"genius or suicide."
msgstr "드로우로 변장을 하고 다닌다고? 이 언더다크에서? 똑똑한 건지 자살 행위인지 잘 모르겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Player
#. NodeID = 4e62ddb2-acb3-3c4d-d0a3-e0c2149236b6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_InjuredGnome_State_AgreedToHelp = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:4e62ddb2-acb3-3c4d-d0a3-e0c2149236b6
msgctxt "h2c8d8ae9g9117g4790gb4b7ga822ed8a505d"
msgid "All right. I'll free your people if I can."
msgstr "좋아. 네 동족들을 풀어 줄 방법을 알아볼게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Player
#. NodeID = 4e996e99-2d29-a244-8957-0eb7585b2cf3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:4e996e99-2d29-a244-8957-0eb7585b2cf3
msgctxt "hd4020ec0g2f52g4631g96a3g31e9a858ac15"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Player
#. NodeID = 52d2ca31-f71f-c3a3-761c-0146d11f633a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Quest:
#.      - UND_DuergarPoison.LearnedPoisoned(1) = True
#.   Script:
#.      - GEN_CheckHasItemTemplate = True
#. SetFlags:
#.   Object:
#.     - UND_InjuredGnome_Event_GiveAntitoxin(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:52d2ca31-f71f-c3a3-761c-0146d11f633a
msgctxt "h8f412655gb828g412bgb741g43ecf7489755"
msgid "<i>Give her an antitoxin.</i>"
msgstr "<i>주머니에 있는 해독제를 준다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 52d90718-406e-d0b1-4f74-ebb06aefaad7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:52d90718-406e-d0b1-4f74-ebb06aefaad7
msgctxt "hfee073fbgd94ag41f1gbdf2g9e00bf0e8d6f"
msgid ""
"Some dusty temple. It doesn't matter. They'll work my clan to death before "
"they ever get near it."
msgstr "먼지투성이 사원이야. 그건 상관없어. 그놈들이 사원에 가까이 도달하기도 전에 내 클랜이 혹사당해서 죽을 테니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Narrator
#. NodeID = 550d0cf4-d336-4d3b-a147-ff91e18841b7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:550d0cf4-d336-4d3b-a147-ff91e18841b7
msgctxt "hf799ecb1gf3bdg4735g8a31g181864d9219f"
msgid ""
"*Is Lady Shar punishing you? Or perhaps testing you? Is it the tadpole, or a "
"curse? You cannot say.*"
msgstr ""
"*샤 여신님이 당신을 벌하고 있는 걸까요? 아니면 시험하고 있는 걸까요? 올챙이 때문일까요, 아니면 저주 때문일까요? 당신은 대답하지 "
"못합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 55b23040-5158-0858-f624-c58d0a90174d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - UND_InjuredGnome_Event_Murder(1) = True
#.   Quest:
#.     - UND_LoneDuergar.KilledGnome(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:55b23040-5158-0858-f624-c58d0a90174d
msgctxt "h3d8c3869g0d0dg4566g854fg26f8eaa64c0c"
msgid "No. Don't."
msgstr "안 돼. 그러지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 5b396f2e-ce5b-5b96-c467-787b98c8a72a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_InjuredGnome_State_Insane = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:5b396f2e-ce5b-5b96-c467-787b98c8a72a
msgctxt "h979e6196gc37cg48c3gb908g93aebb3e46c2"
msgid "... eyes... to <i>yourself</i>..."
msgstr "...<i>너 자신에게나</i>... 신경 써..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 5b417171-e8d2-13b3-9905-413d3bd4e68a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:5b417171-e8d2-13b3-9905-413d3bd4e68a
msgctxt "h45880373g1542g41f7g9619gbdc4a0033c5d"
msgid "Like I say, we Ironhands make good friends."
msgstr "말했다시피, 우리 아이언핸드 일족은 좋은 친구가 된다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 5eca253f-c47d-8001-faf3-3d87266deb46
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:5eca253f-c47d-8001-faf3-3d87266deb46
msgctxt "ha3c90757gabbdg42d3g8ebeg92b321cd8f79"
msgid "I thank you for your help, but I gotta get moving - <i>ah!</i>"
msgstr "네 도움은 고맙지만, 나는 가봐야 - <i>아아!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 5f044c13-a604-fd3d-5fea-700b1a6c6344
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:5f044c13-a604-fd3d-5fea-700b1a6c6344
msgctxt "h5bf7b36cgc94dg4936gaa42g2d889fcba3ab"
msgid ""
"You must have been away from here to think that. Not many willing to risk "
"themselves for others right now."
msgstr "그런 생각을 할 거라면 여기로부터 벗어나야 해. 요즘은 다른 사람들을 위해 위험을 감수하는 이들은 그리 많지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 600600b8-08eb-444a-1b9b-9d82152e8a0e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:600600b8-08eb-444a-1b9b-9d82152e8a0e
msgctxt "h75bf6635g0c19g44c3gb7efg94d0c4d84c6c"
msgid ""
"There's plenty more guarding my people. But I'd say you've made a fine start."
msgstr "내 동족을 감시하는 놈들이 아직 많이 남았지만 시작은 좋았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Player
#. NodeID = 603b033f-a7d4-47e9-a2ce-5ec3df0e5c34
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:603b033f-a7d4-47e9-a2ce-5ec3df0e5c34
msgctxt "h896e6476g0fdcg4debga91ag092ce4a1b88a"
msgid "<i>Try to understand what's happening.</i>"
msgstr "<i>무슨 일이 일어나는지 이해하려 애쓴다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 6150a48a-687f-efbe-670d-7b4f6d5231a8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_InjuredGnome_State_Healed = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:6150a48a-687f-efbe-670d-7b4f6d5231a8
msgctxt "ha6150ee1g38f2g4d34gadc3gba63e95e6cf6"
msgid "A little more rest and I'll be ready to get out of here."
msgstr "조금만 더 쉬면 여기서 나갈 수 있을 것 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Player
#. NodeID = 61a09ee6-602d-96a4-28c1-0b0ac1807f31
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:61a09ee6-602d-96a4-28c1-0b0ac1807f31
msgctxt "hcec5701agcf51g4d8eg8973gffe1e11c4338"
msgid "<i>She won't last long. Finish her off.</i>"
msgstr "<i>오래 버티지 못할 것이다. 목숨을 거둔다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Player
#. NodeID = 61c7b5fc-9c2a-a3b5-73d2-1e16ec39853d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 5e9c4c72-4f56-2646-ce36-88207d2dc33c_HowDidYouGetHere = False
#. SetFlags:
#.   Local:
#.     - 5e9c4c72-4f56-2646-ce36-88207d2dc33c_HowDidYouGetHere = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:61c7b5fc-9c2a-a3b5-73d2-1e16ec39853d
msgctxt "haa484008gfb86g4259ga54bgbaaff5c50a6b"
msgid "How did you end up here?"
msgstr "어쩌다 여기까지 오게 된 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 61eb58e8-9757-141a-a848-c6a7b7dfc50d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:61eb58e8-9757-141a-a848-c6a7b7dfc50d
msgctxt "h9f9799f9g548cg4efag91b3ge05c44008464"
msgid "... do it."
msgstr "... 그렇게 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 620f1846-8598-bacf-09b1-360100d59293
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_InjuredGnome_State_Healed = True
#.      - UND_DuergarCamp_State_GnomeAtMyconids = True
#.   Local:
#.      - 5e9c4c72-4f56-2646-ce36-88207d2dc33c_KinSaved = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:620f1846-8598-bacf-09b1-360100d59293
msgctxt "ha3f48660g2e03g4475g9997g4a3020245e4e"
msgid "A little more rest and I'll be ready to get out of here."
msgstr "조금만 더 쉬고 나면, 떠날 준비를 할 수 있을 것 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 62248222-ef53-9294-f91a-47c9c406ebca
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_InjuredGnome_HasmetAfterHealedByOther(1) = False
#.      - UND_InjuredGnome_State_Healer(1) = False
#.      - UND_InjuredGnome_HasMet(1) = False
#. SetFlags:
#.   Dialog:
#.     - UND_InjuredGnome_HasmetAfterHealedByOther(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:62248222-ef53-9294-f91a-47c9c406ebca
msgctxt "hcf95a837g1eacg4d49g9fc4g70f8e2341216"
msgid ""
"I'd be dead if it weren't for some passing stranger. Kindness is rare "
"currency down here."
msgstr "지나가던 낯선 사람이 아니었다면 난 죽었을 거야. 이 아래에서 친절함이란 기대하기 힘든데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 643ed1a3-abb8-7ed4-d257-85a28b9ddb0f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:643ed1a3-abb8-7ed4-d257-85a28b9ddb0f
msgctxt "h6b048bb1g1f8cg4654g88f0gb519b29a944a"
msgid ""
"This damned place. Once my people are free, I promise you - we will <i>not</"
"i> be coming back."
msgstr "이 망할 장소 같으니. 내 동족들이 풀려나고 나면, 장담하건대 <i>다시는</i> 이곳에 돌아오지 않을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Player
#. NodeID = 6507617c-b4ba-9053-97b6-c44d379d1a61
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 5e9c4c72-4f56-2646-ce36-88207d2dc33c_AgreedToHelp = False
#.   Object:
#.      - UND_InjuredGnome_Knows_PoisonLore(1) = True
#. SetFlags:
#.   Local:
#.     - 5e9c4c72-4f56-2646-ce36-88207d2dc33c_AgreedToHelp = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:6507617c-b4ba-9053-97b6-c44d379d1a61
msgctxt "h24e3deb7g8f3dg4f09g98a3g19a97d58352c"
msgid "Sit tight. There must be more than one way to cure you."
msgstr "꼼짝 말고 있어. 분명 널 치유할 다른 방법이 있을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 67fbc6ef-dbc4-adf5-82ac-554ea5e234fd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_InjuredGnome_Knows_RunFromDuergar = True
#.   Object:
#.     - UND_InjuredGnome_Knows_DuergarPoisoned(1) = True
#. TagRule: DUERGARDWARF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:67fbc6ef-dbc4-adf5-82ac-554ea5e234fd
msgctxt "ha89a28a3gc7cbg4a49g809bg65dd618eaeca"
msgid "Your kind... slashed me..."
msgstr "네 종족... 날 벴어..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 67fbc6ef-dbc4-adf5-82ac-554ea5e234fd
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_InjuredGnome_Knows_RunFromDuergar = True
#.   Object:
#.     - UND_InjuredGnome_Knows_DuergarPoisoned(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:67fbc6ef-dbc4-adf5-82ac-554ea5e234fd
msgctxt "hfcb9bccbgc158g49acg9ae6g4ad810806ecb"
msgid "...Duergar... slashed me..."
msgstr "...듀에르가... 나를 벴어..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 6964c27e-7326-a0f9-de41-38f88a27805f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:6964c27e-7326-a0f9-de41-38f88a27805f
msgctxt "hcce72953g48a7g4824g917dg9e6680157b34"
msgid "They're... they're dead? I'm alone? No..."
msgstr "그들이... 그들이 죽었다고? 나 홀로 남았어? 안 돼..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Player
#. NodeID = 6a3c9e4d-fc0a-aad7-606d-6156fb12dab9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_GnomeWorkers_State_PermaDefeated = False
#. SetFlags:
#.   Global:
#.     - UND_InjuredGnome_State_AgreedToHelp = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:6a3c9e4d-fc0a-aad7-606d-6156fb12dab9
msgctxt "h11829290g3b58g4ff7g895cgbe2167d6565f"
msgid "Fine. I'll help your people."
msgstr "좋아. 네 동족을 도울게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Player
#. NodeID = 6c929cb8-37f6-8ff4-cdf7-803ad72ee0ba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:6c929cb8-37f6-8ff4-cdf7-803ad72ee0ba
msgctxt "h7d0554edg304ag4c06gabd6g91968131fceb"
msgid "It's always useful to be owed a favour."
msgstr "호의를 베푸는 건 언제나 유용하니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 6f4ab79d-9bb7-eafb-2f22-3220d6da5e4a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:6f4ab79d-9bb7-eafb-2f22-3220d6da5e4a
msgctxt "h04de9204g55b6g44d7g8bd8g36141690cef3"
msgid ""
"Phil... of course she did. Diehards for the cause, both of us. No cost too "
"great, eh?"
msgstr "필... 당연히 그랬겠지. 명분에 있어선 우리 둘 다 완강파였거든. 어떤 대가도 감수한다, 알지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Player
#. NodeID = 6f4c01ed-e1e4-7ceb-59ff-9d9e729cd49c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - UND_MushroomHunter_State_HasMushroom(1) = True
#.   Quest:
#.      - UND_DuergarPoison.LearnedPoisoned(1) = True
#. SetFlags:
#.   Object:
#.     - UND_MushroomHunter_Event_GiveMushroom(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:6f4c01ed-e1e4-7ceb-59ff-9d9e729cd49c
msgctxt "h2b33ede7g6289g4eb8g8303gdce981ab6505"
msgid "<i>Give her the noblestalk as a cure.</i>"
msgstr "<i>귀족줄기를 치유제로 준다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Player
#. NodeID = 73e741f4-f878-61a5-79ab-9752150ef3ef
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Quest:
#.      - UND_DuergarPoison.LearnedPoisoned(1) = True
#.   Script:
#.      - GEN_CheckHasItemTemplate_2 = True
#. SetFlags:
#.   Object:
#.     - UND_InjuredGnome_Event_GiveSilvanusAntidote(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:73e741f4-f878-61a5-79ab-9752150ef3ef
msgctxt "h76170a7bg7906g405ag8187g541324a407c5"
msgid "<i>Give her the Elixir of Silvanus.</i>"
msgstr "<i>실바누스의 영약을 준다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Player
#. NodeID = 754ec64d-6eba-5a5a-a0f6-fcfac01899e4
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_DEEPGNOME or REALLY_FORESTGNOME or REALLY_GNOME or REALLY_ROCKGNOME
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:754ec64d-6eba-5a5a-a0f6-fcfac01899e4
msgctxt "hee631b54gb608g4902g83a6g04b5acdf27c4"
msgid "We're kin. If we don't help one another, who will?"
msgstr "우린 동족이야. 우리가 서로를 돕지 않는다면, 누가 하겠어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 75b9b09f-bfdc-0b17-b0cb-f4efa85c17dd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_InjuredGnome_Knows_RunFromDuergar = True
#.   Quest:
#.     - UND_GnomeRescue.ThullaAskedHelp(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:75b9b09f-bfdc-0b17-b0cb-f4efa85c17dd
msgctxt "hbb0840dfg915bg48eag832ag42ecbcc15a2e"
msgid ""
"I got away, but not the others. The greys have them digging out some old "
"ruin across the lake."
msgstr ""
"나는 도망쳤지만, 다른 사람들은 그러지 못했어. 회색놈들이 호수 건너편에 있는 오래된 폐허에서 그 사람들에게 채굴을 시키고 있을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 769bc757-6ae3-0489-7ab6-d69c9554ebb2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:769bc757-6ae3-0489-7ab6-d69c9554ebb2
msgctxt "h82955787g7184g45f6g8e3bg57aa0d3784e7"
msgid ""
"Don't know. Longer than I'd like. But a slow recovery's still a recovery."
msgstr "모르겠어. 내가 바라는 것보단 오래 걸리겠지. 하지만 느린 회복도 회복이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Player
#. NodeID = 77bd2b76-6ea6-bd24-a5cf-1d7111c55dbb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:77bd2b76-6ea6-bd24-a5cf-1d7111c55dbb
msgctxt "h760b5a5eg6196g43c3gacabg408799dde0d4"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 7bc24bfe-683b-6e1d-efef-37205c1f44c5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:7bc24bfe-683b-6e1d-efef-37205c1f44c5
msgctxt "h1753a590g9414g4fb5ga569g105979ac5830"
msgid "I don't... I didn't <i>mean</i> to leave them. Leave me, please."
msgstr "난... 난 그들을 떠날 <i>의도가</i> 아니었어. 날 내버려 줘, 부탁이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 7d414ca1-34bc-82ab-f8fc-4d94b992f8d5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - UND_InjuredGnome_State_Healer(1) = True
#.   Global:
#.     - UND_InjuredGnome_State_Healed = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:7d414ca1-34bc-82ab-f8fc-4d94b992f8d5
msgctxt "h5a241b37g0071g4bcfgad35g883d5922f0fa"
msgid "Ah... Gods... whatever that is... I needed it."
msgstr "아... 세상에... 뭔지는 모르겠지만... 이게 필요했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Narrator
#. NodeID = 7ecef65b-3c3e-7c1d-0cfb-6e5421f0ccf5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:7ecef65b-3c3e-7c1d-0cfb-6e5421f0ccf5
msgctxt "hf79be351gb199g4e29gaa1age13b43b23bb1"
msgid "*She'll need an antidote soon - most likely held by the poisoner.*"
msgstr "*그녀는 곧 해독제가 필요할 것입니다. 그녀를 중독시킨 자가 갖고 있을 가능성이 높습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 7ff9748c-f775-bad8-cdb5-71774f1b4984
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:7ff9748c-f775-bad8-cdb5-71774f1b4984
msgctxt "hbc081de3ga6ceg4121gb834gdf3436552a9f"
msgid "We were on an expedition down here when the duergar snatched us up."
msgstr "우리는 이 지하를 탐험하던 중 듀에르가에게 납치당했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 8051d987-14f7-49e4-c6ca-0d4bc039b634
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_InjuredGnome_State_GaveBoots(1) = False
#.      - UND_InjuredGnome_State_Healer(1) = True
#.   Global:
#.      - UND_DuergarCamp_State_GnomeAtMyconids = False
#.   Quest:
#.      - UND_GnomeRescue.ThullaAskedHelp(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:8051d987-14f7-49e4-c6ca-0d4bc039b634
msgctxt "h316ed113ga709g4c20g99afg06d105b65525"
msgid "... wha? Pain's... fading."
msgstr "... 무슨? 고통이... 사라지고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 807a9639-f3ed-dff6-e48b-b8f623556732
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:807a9639-f3ed-dff6-e48b-b8f623556732
msgctxt "h9d73bcafg0690g43efgb6c8g812b528838ca"
msgid "Can't give up. Others need me."
msgstr "포기할 순 없어. 다른 이들은 내가 필요해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 824fadac-c4d2-e4f9-20cf-6ff7ffb93fac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:824fadac-c4d2-e4f9-20cf-6ff7ffb93fac
msgctxt "h79f97c1fgd344g4cd1ga8cag2c0bdccabfe4"
msgid ""
"Not charity, mind - we can pay. We're Ironhand clan, best artificers in "
"Baldur's Gate."
msgstr "자선해달라는 건 아니야. 보상을 줄 수 있어. 우리는 발더스 게이트 제일의 기술자들인 아이언핸드 클랜이니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 83756aae-ec5e-d630-9fa9-401f2b088024
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:83756aae-ec5e-d630-9fa9-401f2b088024
msgctxt "h2129fb60g30a8g482fga0f4g7883b04b2c10"
msgid ""
"Look. You've done me a good turn, and you deserve the truth. But that's as "
"much of it as I can tell - I swear it."
msgstr "이봐. 당신은 내게 선행을 베풀었고, 진실을 알 자격이 있어. 하지만 맹세코 내가 말할 수 있는 건 여기까지야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Shadowheart
#. NodeID = 83ace122-cdb6-40e0-8456-2d31e2da1140
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:83ace122-cdb6-40e0-8456-2d31e2da1140
msgctxt "h2a87ebeeg87ebg4b20g946fg93332a6e30fa"
msgid ""
"Paragons of hospitality, these myconids. The druids in the grove could've "
"learned a thing or two."
msgstr "이 마이코니드들은 환대의 모범이군 . 숲의 드루이드들이 한두 가지는 배웠어야 했는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 862827c8-7df3-382b-1105-eb66bbd43989
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_DUERGARDWARF
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:862827c8-7df3-382b-1105-eb66bbd43989
msgctxt "ha2a17c98gd145g49e1ga77cga3edbcc726ef"
msgid ""
"Like I said, save my kin. And if you kill any greys along the way, you won't "
"see tears from me."
msgstr "말했듯이, 내 동족을 구해 줘. 그리고 누구든 앞길을 막는 회색 놈들이 있다면, 죽여버려도 난 눈물 한 방울 흘리지 않을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 862827c8-7df3-382b-1105-eb66bbd43989
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:862827c8-7df3-382b-1105-eb66bbd43989
msgctxt "h030de2bdgb68dg4db2g852fge393acfd90bc"
msgid ""
"Like I said, save my kin. And if you kill any duergar, you won't see tears "
"from me."
msgstr "말했듯이, 내 동족을 구해 줘. 그리고 그 과정에서 듀에르가를 죽여버린다고 해도 난 눈물 한 방울 흘리지 않을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Player
#. NodeID = 87fad19b-ba98-730a-ec61-8ee2035472b4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - UND_InjuredGnome_Event_Murder(1) = True
#.   Quest:
#.     - UND_LoneDuergar.KilledGnome(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:87fad19b-ba98-730a-ec61-8ee2035472b4
msgctxt "h9df7dfb8g9c67g40dfg8502gd530800d1535"
msgid "<i>Give her a quick death.</i>"
msgstr "<i>그녀에게 빠른 죽음을 선사한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Narrator
#. NodeID = 8872a356-d6e7-4682-ae45-6e55935afb26
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ORI_Shadowheart_State_IncurableWound_Unavailable = False
#.      - GLO_Not_For_EA = True
#.   Tag:
#.      - AVATAR(1) = True
#.      - REALLY_SHADOWHEART(1) = True
#. SetFlags:
#.   Global:
#.     - ORI_Shadowheart_Event_IncurableWoundFlared = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:8872a356-d6e7-4682-ae45-6e55935afb26
msgctxt "hf79e1edfg340ag4eecg8ec0g83584fb2be4c"
msgid ""
"*Pain rushes through you from the wound on your hand. You glimpse yourself "
"reaching to help a fellow initiate back on his feet, only to hear a female "
"voice hiss your name in reprimand.*"
msgstr ""
"*손의 상처에서 고통이 밀려옵니다. 당신은 막 일어나려는 사람을 돕기 위해 손을 뻗으려 했지만, 여자의 목소리가 당신의 이름을 꾸짖듯이 "
"부르는 소리를 들을 뿐입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Narrator
#. NodeID = 8ba17966-c361-6d53-8233-2bc379b418ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:8ba17966-c361-6d53-8233-2bc379b418ea
msgctxt "h19fdc041gcd42g4098g9134g48d19b24d11e"
msgid ""
"*Like dwarves, duergar have innate resistance to poison - and thus no need "
"for intricate brews.*"
msgstr "*드워프들과 마찬가지로, 듀에르가는 독에 선천적인 면역력이 있습니다. 그래서 복잡한 제조를 필요로 하지 않습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 8c38bf87-cd62-90ed-f6eb-b3b3392c9080
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:8c38bf87-cd62-90ed-f6eb-b3b3392c9080
msgctxt "h8a5cd75cg6b81g4978gb37eg6cb9fec68f35"
msgid ""
"Course, I reckon the myconids are doing the same thing. You've seen how they "
"put the dead to work."
msgstr "물론, 마이코니드들도 똑같은 일을 하는 것 같던데. 그들이 시체를 어떻게 다루는지 봤잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 8dd96715-bd0b-214e-3c2f-2e7353e74307
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - UND_GnomeRescue.ThullaAskedHelp(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:8dd96715-bd0b-214e-3c2f-2e7353e74307
msgctxt "h90c45f4fgf318g4ee5g9019g4f489a988311"
msgid ""
"But our work pays well. Help my clan and we'll make it worth your while. I "
"swear."
msgstr "하지만 우리 일은 보수가 쏠쏠해. 내 클랜을 도와주면 맹세코 그에 상응하는 보답을 할게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 8faccba9-5181-c95a-a5a0-673b23f16cc3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_InjuredGnome_Event_StoleBoots(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:8faccba9-5181-c95a-a5a0-673b23f16cc3
msgctxt "h8780e019g25d0g4775gadf3gaacad839ccc5"
msgid ""
"You already relieved me of my boots. No hard feelings... once you use them "
"to free my clan."
msgstr "이미 내 부츠를 가져갔잖아. 악감정은 없어... 그걸로 내 일족을 해방해 주기만 한다면 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 9368631b-a13a-1160-386f-7e94e663632b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:9368631b-a13a-1160-386f-7e94e663632b
msgctxt "h50d60d72g1dbfg41ffg898cg490ae6902922"
msgid "... no fooling you. We've some scores to settle back in the Gate, aye."
msgstr "... 널 속일 순 없지. 우리는 그 게이트에서 해결해야 할 일들이 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Player
#. NodeID = 95b437de-b719-5680-2a9b-d682c15f49cf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_InjuredGnome_Knows_Poisoned = True
#.   Object:
#.      - UND_InjuredGnome_Knows_PoisonLore(1) = False
#.   Tag:
#.      - REALLY_DUERGARDWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:95b437de-b719-5680-2a9b-d682c15f49cf
msgctxt "h593fcbb5g86d7g4f60g9553g57b0f4356cff"
msgid "<i>Consider what you know of your people's poison lore.</i>"
msgstr "<i>동족의 독 지식에 대해 알고 있는 것을 생각해본다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 960e73f1-248a-7087-508d-f43bce602018
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_InjuredGnome_State_Insane = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:960e73f1-248a-7087-508d-f43bce602018
msgctxt "hdea6137eg77a8g4659g9a57g6f1073b9b586"
msgid "Mum, will you put the kettle on? I want to chat. Just us."
msgstr "엄마, 주전자 좀 올려주시겠어요? 얘기 좀 해요. 둘이."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Narrator
#. NodeID = 96c6ab55-773b-a515-226b-ce7df7d03580
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - UND_InjuredGnome_Knows_PoisonLore(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:96c6ab55-773b-a515-226b-ce7df7d03580
msgctxt "hbfc2e3e8gdc01g4e51gbca3g59eb0f2fa38a"
msgid ""
"*Though deadly if left untreated, the poison can be cured - by the antidote, "
"or natural remedies.*"
msgstr "*치료하지 않고 방치하면 치명적이지만, 해독제 또는 자연 요법으로 치료할 수 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Player
#. NodeID = 99c81185-a1d7-1540-345d-17f8a51ac755
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DUERGARDWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:99c81185-a1d7-1540-345d-17f8a51ac755
#, fuzzy
#| msgid "You were useless to me in that state."
msgctxt "h7338664bg6154g4369ga5ddg4db5281f4e10"
msgid "I need my slaves healthy and mobile. Now up - we're leaving."
msgstr "그 상태에선 내게 아무 쓸모도 없었거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Player
#. NodeID = 9a375db1-f6f5-30d2-8956-1ca2211aa328
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - RANGER(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:9a375db1-f6f5-30d2-8956-1ca2211aa328
msgctxt "h3a757ac4g24e0g44ecg9cacg7896c0fb50b7"
msgid ""
"Wounded creatures attract <i>hungry </i>creatures. We don't need that here."
msgstr "상처 입은 동물은 <i>굶주린 </i>동물을 불러오는 법이지. 그런 건 원치 않거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Player
#. NodeID = 9c232296-9322-4f28-741a-55d36010d099
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LOLTHDROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:9c232296-9322-4f28-741a-55d36010d099
msgctxt "hf05f0bf0g8a19g4282g8a53gb01161dd4d00"
msgid "Help? No. I just want to prolong your pain - at my hands."
msgstr "도움이라고? 아니. 난 그저 네 고통을 늘려주고 싶었을 뿐이야, 내 손으로 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = 9d1046b2-ab1a-6497-1cbb-a7c6ecfeb266
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - UND_InjuredGnome_Knows_RunFromDuergar = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:9d1046b2-ab1a-6497-1cbb-a7c6ecfeb266
msgctxt "hcdb0fba4g5870g4629ga6c7gf8102916fc9d"
msgid "Hah. Greys... don't <i>share</i>..."
msgstr "하. 회색놈들은... <i>나눠주지</i> 않아..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Player
#. NodeID = 9d70e0d1-f435-ad83-846a-90fcc31ab6f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:9d70e0d1-f435-ad83-846a-90fcc31ab6f1
msgctxt "hd5f5d0c5gefb0g41f5gbbb5g8b3cfaa4b272"
msgid "Focus on what I need. A reward, for starters."
msgstr "내가 필요한 것에 집중해. 우선은 보상이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Player
#. NodeID = 9e344059-af5f-0ced-847e-4899f41a1adc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_IronhandGnomes_Knows_Runepowder = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:9e344059-af5f-0ced-847e-4899f41a1adc
msgctxt "hbc9d3cc8g14f0g4220g99deg2ff9fe931716"
msgid "I know about the runepowder. I think I'll steer clear."
msgstr "룬파우더에 대해선 알고 있어. 나는 멀리해야겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Thulla
#. NodeID = a036814e-11dd-79ca-af2c-3f6d85c132ef
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_InjuredGnome_State_GaveQuest = True
#.      - UND_InjuredGnome_State_Healed = True
#.      - UND_DuergarCamp_State_GnomeAtMyconids = False
#.   Quest:
#.      - UND_GnomeRescue.ThullaAskedHelp(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:a036814e-11dd-79ca-af2c-3f6d85c132ef
msgctxt "h74896f03g8725g4e55gbe4dg14392d152b4d"
msgid ""
"<i>Argh...</i>I'm coming along. Just not fast enough. Any word on my people?"
msgstr "<i>아악...</i> 나도 같이 갈 거야. 좀 느린 것뿐이지. 내 동족 소식은 없어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Player
#. NodeID = a263fff7-352e-5930-8b63-fe54ea8ff419
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_DUERGARDWARF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome:a263fff7-352e-5930-8b63-fe54ea8ff419
msgctxt "he2809ed3g6940g496bgb96ag6136ed819cf5"
msgid "Not all duergar are slavers, you know."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_InjuredGnome
#. Speaker = Player
#. NodeID = a2fa1e4f-b947-65c6-316c-758670090ef4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
