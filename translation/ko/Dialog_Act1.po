msgctxt "hae4be002ga6a6g4043g8c49g568937d63bbd"
msgid "What happened to you?"
msgstr "무슨 일이 있었지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_DeadPrisoner_Dead
#. Speaker = Abducted Nobleman
#. NodeID = a3e3c287-1144-be92-8ebd-3230488bca2f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_DeadPrisoner_Dead:a3e3c287-1144-be92-8ebd-3230488bca2f
msgctxt "he355d30bgdda1g411dg887dg6d58bb37dcfd"
msgid "Guiding my cart... shadow fell... tentacle grabbed me..."
msgstr "수레를 끌다가... 그늘이 지더니... 촉수가 날 낚아챘어..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_DeadPrisoner_Dead
#. Speaker = Player
#. NodeID = a6df80f6-f9a1-e758-1cca-8bbbc61b59de
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_DeadPrisoner_Dead:a6df80f6-f9a1-e758-1cca-8bbbc61b59de
msgctxt "h7f1b651bg719fg4530ga94fg0d1747901dac"
msgid "Do you have anything valuable?"
msgstr "뭔가 값어치 있는 거 가지고 있진 않아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_DeadPrisoner_Dead
