msgctxt "h19846b02gd07eg436cg8eb8g07db4e9535ae"
msgid "Bring... him... to... the... Absolute..."
msgstr "절대자께... 놈을... 데려와라..."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_CultistsUndead_Zealot_Dead
