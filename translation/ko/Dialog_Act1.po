#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush:eedd03cd-c01a-0eaa-d108-8bf9f6bcd83a
msgctxt "h1f221dbbgabf4g4c3ega995g91d76b092104"
msgid "Stand down. Now."
msgstr "물러서. 당장."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush
#. Speaker = Goblin Booyahg
