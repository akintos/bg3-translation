msgctxt "hbcc7138egde8cg463cgb7aeg3667ea8558d0"
msgid "How did you die?"
msgstr "어떻게 죽었지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_MyconidCircle_DeadMyconid_Dead
#. Speaker = Narrator
#. NodeID = 4f57b6ea-3132-75cf-c9f8-e40cb63b97cb
