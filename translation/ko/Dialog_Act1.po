msgctxt "h7ec9db4fg4655g4b10g846ag4bf32f1cdb0e"
msgid "Feck off."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_WarchiefGrumpy_AD_WithChieftain
