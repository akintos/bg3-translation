#.      - ec5a6a29-18c8-62d7-4036-5f669d4508f9_KnowsDhourn = False
#.   Object:
#.      - GLO_SpeakWithDead_Event_QuestionAsked(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HookHorror_Hermit_Dead:1ef773b7-4829-1054-54b8-464e05c8b328
msgctxt "h8735b7d2gfef6g4eb4g8880g7d04790d4d89"
msgid "Who is this Dhourn?"
msgstr "이 '도운'이 누구지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_HookHorror_Hermit_Dead
#. Speaker = Player
#. NodeID = 2b78b03c-b395-439a-a0d6-661b3531d794
