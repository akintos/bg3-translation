msgctxt "h98b8f33cgc49fg4222g983dg7a06bbaebcfb"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin
#. Speaker = Lae'zel
#. NodeID = b2bf31f2-8433-4900-1aa7-782fd434805c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
