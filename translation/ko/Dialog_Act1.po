msgid "Ominous. Best not to linger."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkJusticiarCorpse_Looted_Solo
#. Speaker = Narrator
#. NodeID = f045f37d-458d-4805-a282-edb1aed40ec6
