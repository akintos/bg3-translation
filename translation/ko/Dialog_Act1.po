msgctxt "h36439427g60b6g4f46gacd0g6e99f764bd3e"
msgid "<i>Ah, fuck that. Fire's really going for broke, though.</i>"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PaladinsOfTyr_AvatarKarlachAfterEnrage
