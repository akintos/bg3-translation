msgctxt "h0a375893g6c33g48e9gbf71g11692d88ebca"
msgid "What is your profession?"
msgstr "무슨 일을 했지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Underdark/UND_DuergarCamp_HangedDrow_Dead
#. Speaker = Karlach
#. NodeID = 569a2840-4515-4bc4-ae46-04952305b254
