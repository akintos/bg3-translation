msgctxt "h7345bf7dge0ffg4d3bgb178gb39d7dee3603"
msgid "<i>Move the telescope to the right.</i>"
msgstr "<i>망원경을 오른쪽으로 돌린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Stargazing_Telescope
#. Speaker = Narrator
#. NodeID = c45f1440-c7dc-99f5-b6d5-265ecc6043ff
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Stargazing_State_Left = False
#.      - DEN_Stargazing_State_Right = False
#. SetFlags:
#.   Global:
#.     - DEN_Stargazing_State_Left = True
#.     - DEN_Stargazing_State_Right = True
