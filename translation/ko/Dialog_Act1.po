msgctxt "h3c43b504g9b93g4c4dg9e11g0d2f9f76c463"
msgid "Thulla. Somehow, you look worse than last I saw you."
msgstr "툴라. 어떻게 된 건진 모르겠지만, 저번에 봤을 때보다 더 끔찍하네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_MyconidCircle_AD_GnomesSaved
#. Speaker = Lunkbug
#. NodeID = 3efc5701-208f-4966-b8ef-076ee5ff40ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_MyconidCircle_AD_GnomesSaved:3efc5701-208f-4966-b8ef-076ee5ff40ac
msgctxt "hd05167ecg0d91g4698g91e2g939dca077a4a"
msgid "Maybe... maybe the myconids thought they were helping."
msgstr "어쩌면... 어쩌면 마이코니드들은 돕고자 했던 걸지도 몰라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_MyconidCircle_AD_GnomesSaved
#. Speaker = Beldron
#. NodeID = 4352887d-a86a-8844-a3e7-2ff0a28dfcb7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 8c546376-2838-10d2-9587-0b24d79bca24_LocalFlag2 = True
#.      - 8c546376-2838-10d2-9587-0b24d79bca24_LocalFlag1 = True
#.   Script:
#.      - GEN_IsSpeakerPresent_3 = False
#.      - GEN_IsSpeakerPresent_1 = True
#. SetFlags:
#.   Local:
#.     - 8c546376-2838-10d2-9587-0b24d79bca24_LocalFlag2 = False
#.     - 8c546376-2838-10d2-9587-0b24d79bca24_LocalFlag1 = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_MyconidCircle_AD_GnomesSaved:4352887d-a86a-8844-a3e7-2ff0a28dfcb7
msgctxt "h96ebd0e1gff0eg4f74gaaf7g7e9cda655cc5"
msgid "Enough dallying. We need to get back to Baldur's Gate."
msgstr "이제 그만 꾸물거려. 이제 발더스 게이트로 돌아가야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_MyconidCircle_AD_GnomesSaved
#. Speaker = Apprentice Laridda
#. NodeID = 5bb8db97-fdb1-4b7c-8f19-25132bb6c780
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_MyconidCircle_AD_GnomesSaved:5bb8db97-fdb1-4b7c-8f19-25132bb6c780
msgctxt "h19f49b95g2fe4g488cg86d3g367830cf0d57"
msgid "Let's just... let's just <i>go</i>."
msgstr "그냥... 그냥 <i>가자</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_MyconidCircle_AD_GnomesSaved
#. Speaker = Beldron
#. NodeID = 843171c6-f5d1-4b8b-8aea-e38c2f86b572
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_MyconidCircle_AD_GnomesSaved:843171c6-f5d1-4b8b-8aea-e38c2f86b572
msgctxt "h3349ef40g832ag4391g8b5dgdea2dc8627cc"
msgid "Aye - same as us, I expect."
msgstr "그럼 - 아마 우리랑 같겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_MyconidCircle_AD_GnomesSaved
#. Speaker = Beldron
#. NodeID = 8ce22b3a-38b8-4295-a120-cf9871c248b6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_State_BothSovereignsDead = False
#.   Local:
#.      - 8c546376-2838-10d2-9587-0b24d79bca24_LocalFlag2 = False
#.      - 8c546376-2838-10d2-9587-0b24d79bca24_LocalFlag1 = False
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = False
#.      - GEN_IsSpeakerPresent_1 = True
#. SetFlags:
#.   Local:
#.     - 8c546376-2838-10d2-9587-0b24d79bca24_LocalFlag1 = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_MyconidCircle_AD_GnomesSaved:8ce22b3a-38b8-4295-a120-cf9871c248b6
msgctxt "hbc2d1927ge019g44e9g94f1gda00d4ca76d3"
msgid "We won't stay long. We're done counting on the kindness of strangers."
msgstr "오래 머무르진 않을 거야. 이제 이방인의 친절함을 기대하는 데는 질렸어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_MyconidCircle_AD_GnomesSaved
#. Speaker = Beldron
#. NodeID = b60946c3-9f31-4005-8430-338c3822eaaf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_MyconidCircle_State_BothSovereignsDead = True
#.   Local:
#.      - 8c546376-2838-10d2-9587-0b24d79bca24_LocalFlag2 = False
#.      - 8c546376-2838-10d2-9587-0b24d79bca24_LocalFlag1 = False
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#.      - GEN_IsSpeakerPresent_1 = True
#. SetFlags:
#.   Local:
#.     - 8c546376-2838-10d2-9587-0b24d79bca24_LocalFlag1 = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_MyconidCircle_AD_GnomesSaved:b60946c3-9f31-4005-8430-338c3822eaaf
msgctxt "h2eccca04g18edg4248gaa73g81553ac29bc5"
msgid "From one slaughter to the bloody next."
msgstr "학살극이 끝나니 바로 다른 학살극이 벌어지는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_MyconidCircle_AD_GnomesSaved
#. Speaker = Beldron
#. NodeID = bb446c47-c5c6-4b8c-a7c4-23c1e1dfbaad
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 8c546376-2838-10d2-9587-0b24d79bca24_LocalFlag2 = False
#.      - 8c546376-2838-10d2-9587-0b24d79bca24_LocalFlag1 = True
