msgctxt "h32905c15gc6b3g46d4gb2ceg27bbd0a19a46"
msgid "This one's all yours."
msgstr "좋으실대로."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/AstralPlane/CRE_AstralPrison_DaisyCaveEntrance
#. Speaker = Narrator
#. NodeID = b969c554-f592-4362-973e-b5ded4d90832
