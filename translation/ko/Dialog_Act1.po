#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#. TagRule: UNDERDARK
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar_GCB_ForbiddenRaft:7ffc6e7e-e178-7c3b-8e14-33b2f94aae21
msgctxt "h12d8cc50gd8fcg4a8dgbf67g4f401a1a48f3"
msgid ""
"Saw you, making off with our boat. You should've known better than to come "
"back here."
msgstr "우리 배를 가지고 도망치는 걸 봤어. 여기로 돌아오다니 멍청하군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar_GCB_ForbiddenRaft
#. Speaker = Novice Garmor
#. NodeID = 7ffc6e7e-e178-7c3b-8e14-33b2f94aae21
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_LoneDuergar_State_StoleRaft = True
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar_GCB_ForbiddenRaft:7ffc6e7e-e178-7c3b-8e14-33b2f94aae21
msgctxt "h95d31659g4121g4715g892agc23ea8537dac"
msgid "Saw you, making off with our boat. You should've stayed away, sun-scum."
msgstr "우리 배로 도망치는 걸 봤어. 계속 도망쳤어야지, 태양 쓰레기."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar_GCB_ForbiddenRaft
#. Speaker = Novice Garmor
#. NodeID = 96b1ba8f-5ef6-c5fc-f69b-414b33f68c5d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GEB_State_CrimeDialog(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar_GCB_ForbiddenRaft:96b1ba8f-5ef6-c5fc-f69b-414b33f68c5d
msgctxt "hebbfcf86g2210g4e27g937ag9f53327931a4"
msgid "Gekh does the talking around here - bother him."
msgstr "여기 말하기 담당은 게크야, 그 녀석한테 가서 말해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar_GCB_ForbiddenRaft
#. Speaker = Novice Garmor
#. NodeID = a1e607bd-2dec-4433-c4e6-998fdfd5746f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - UND_LoneDuergar_State_TouchedRaft(1) = True
#.   Global:
#.      - UND_LoneDuergar_Quest_AttackMyconids = True
#.   Object:
#.      - UND_InjuredGnome_State_HasBoots(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar_GCB_ForbiddenRaft:a1e607bd-2dec-4433-c4e6-998fdfd5746f
msgctxt "h952a1ce8g7704g4126ga144g0aa171bc2e24"
msgid "Told you to keep away from there, didn't I?"
msgstr "내가 거기서 떨어지라고 말 안했던가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar_GCB_ForbiddenRaft
#. Speaker = Novice Garmor
#. NodeID = cf0bc52e-45bf-ec63-9ec3-5b3dbc53280c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar_GCB_ForbiddenRaft:cf0bc52e-45bf-ec63-9ec3-5b3dbc53280c
msgctxt "he685d673g2e56g4bc3g80f4g0c4efbe6e622"
msgid "Speak for yourself - I've got plenty of harm intended."
msgstr "변명해 보아라 - 지금 내가 해를 끼치지 않겠다고 단언할 자신이 없군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar_GCB_ForbiddenRaft
#. Speaker = Novice Garmor
#. NodeID = d24c097d-216d-1336-70ff-d689b1b4374a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_LoneDuergar_Quest_AttackMyconids = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar_GCB_ForbiddenRaft:d24c097d-216d-1336-70ff-d689b1b4374a
msgctxt "h070b0912g287ag43fcg929ega0ea85a9d29d"
msgid "Well you've looked. Now keep away from that raft until I say otherwise."
msgstr "음, 당신도 봤군. 내가 말할 때까지 그 뗏목에서 멀리 떨어져 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar_GCB_ForbiddenRaft
#. Speaker = Player
#. NodeID = e3a2b702-5fec-6223-f515-2f1d64111493
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar_GCB_ForbiddenRaft:e3a2b702-5fec-6223-f515-2f1d64111493
msgctxt "h7662144eg03deg432agbac6g3f46c7cf6b07"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar_GCB_ForbiddenRaft
#. Speaker = Player
#. NodeID = f5346ece-613b-10fa-220f-a961a66011fb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar_GCB_ForbiddenRaft:f5346ece-613b-10fa-220f-a961a66011fb
msgctxt "h8732f19ag0ab6g4f01g99ceg072e2359dda8"
msgid "No harm intended. Just looking."
msgstr "해칠 생각 없어. 그냥 보던 중이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar_Henchmen_Surprised
#. Speaker = Player
#. NodeID = 0ace0dcf-fbd0-40bc-8e9a-99046806b799
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - UND_LoneDuergar_Event_WaitingForMainDialog(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar_Henchmen_Surprised:0ace0dcf-fbd0-40bc-8e9a-99046806b799
msgctxt "h93316147g671eg4147g9020gcddc5eae25f7"
msgid "<i>Hold up your palms in peace.</i>"
msgstr "<i>평화의 표시로 손바닥을 들어 올린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar_Henchmen_Surprised
#. Speaker = Player
#. NodeID = abdc8879-2f3b-4a27-a127-d21bf9112318
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GLO_Event_SetSurprisedNextCombat(0) = True
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar_Henchmen_Surprised:abdc8879-2f3b-4a27-a127-d21bf9112318
msgctxt "h26e84de2gb7e2g4307g9f35g16be966718e4"
msgid "<i>Attack</i>."
msgstr "<i>공격한다</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar_Henchmen_Surprised
#. Speaker = GROUP_Act1_UND_LoneDuergar_Henchmen
#. NodeID = ffd36127-db91-4041-9d8f-aff56281b4ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_LoneDuergar_Henchmen_Surprised:ffd36127-db91-4041-9d8f-aff56281b4ad
msgctxt "h72438e05g7648g4dc7g9f6dg11480716a028"
msgid "What...? <i>Gekh! </i>Got someone sneaking up on us!"
msgstr "뭔...? <i>게크! </i>누군가 몰래 다가온다!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Underdark/UND_LoneDuergar_Squad_Caster_AD_CombatTurn
#. Speaker = Lurgan
#. NodeID = 9948fe1f-1ba2-41cf-becd-7a80b943b176
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/Underdark/UND_LoneDuergar_Squad_Caster_AD_CombatTurn:9948fe1f-1ba2-41cf-becd-7a80b943b176
msgctxt "hbd6007b5g82b4g4fe2g9b94g0b9eb6b1660a"
msgid "Die, so your carcass can rise!"
msgstr "죽어라. 그럼 네 시체가 일어설 거야!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Underdark/UND_LoneDuergar_Squad_Ranged_AD_CombatTurn
