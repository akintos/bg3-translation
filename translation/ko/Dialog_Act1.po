msgctxt "h91cf2c14g4457g4c73g9a84g3e13953e93ed"
msgid "D'you think it's bad to keep throwing stones at a dead lump?"
msgstr "가만히 있는 덩어리한테 돌을 던지는 게 나쁜 일이라고 생각해?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_Kid_001
#. Speaker = One
#. NodeID = ecc58a94-1e62-1596-12f8-01a6dddaf671
