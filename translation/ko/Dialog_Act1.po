#.      - 24124369-4e10-034f-351c-aff4c861ba26_GotToldBoring = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain:50519ece-2397-fcd3-5919-360ccaaae655
msgctxt "h121f4f7egf9e9g423fg895cg4619ae3a7ed5"
msgid "You again? Leave us alone, <i>k'chakhi</i>!"
msgstr "또 너야? 우릴 내버려 둬, <i>크차키</i>!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain
#. Speaker = Player
#. NodeID = 54b4ec1c-d4ed-fac2-3fa2-8da3272e5c26
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
