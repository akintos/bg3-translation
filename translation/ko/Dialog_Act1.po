msgctxt "hd110f5bcg92d3g4fe3g9cc9gb2dc9be2600e"
msgid "Hear that? Someone's calling out."
msgstr "들었어? 누가 부르고 있다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_MushroomHunter_PAD_HeardVoice
