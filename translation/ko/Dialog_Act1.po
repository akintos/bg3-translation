msgctxt "h258773cag4189g4529g964cgd8df4d2bea64"
msgid "No joy. Mould and metal, but it still needs something more."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_AdamantineForge_PAD_ForgingIncomplete
#. Speaker = Player
#. NodeID = 9f1df3e0-76fe-b5d4-ee81-3b13d33a9b2d
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_AdamantineForge_PAD_ForgingIncomplete:9f1df3e0-76fe-b5d4-ee81-3b13d33a9b2d
msgctxt "h9af469dbg541fg42cfga604g48c8d1e3b36f"
msgid "Mould and metal... but something's still missing."
msgstr "주형과 금속이라... 하지만 여전히 뭔가 모자라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_AdamantineForge_PAD_ForgingIncomplete
#. Speaker = Player
#. NodeID = dea6118f-63b8-419e-83c6-49fe06f11244
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_AdamantineForge_State_HaveCrafted = True
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_AdamantineForge_PAD_ForgingIncomplete:dea6118f-63b8-419e-83c6-49fe06f11244
msgctxt "h2edbc9f9g7bc1g4249gbc27g87b5159297c0"
msgid "No joy. Seems I need more lava."
msgstr "실패네. 재미 보려면 용암이 더 필요하겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_AdamantineForge_PAD_ForgingIncomplete
#. Speaker = Player
#. NodeID = dea6118f-63b8-419e-83c6-49fe06f11244
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_AdamantineForge_State_HaveCrafted = True
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_AdamantineForge_PAD_ForgingIncomplete:dea6118f-63b8-419e-83c6-49fe06f11244
msgctxt "h730257cegd47fg4f40g9e90gd740249628e6"
msgid "Any forging efforts will be in vain until I add lava into the mix.\n"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_AdamantineForge_PAD_ForgingIncomplete
#. Speaker = Player
#. NodeID = dea6118f-63b8-419e-83c6-49fe06f11244
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_AdamantineForge_State_HaveCrafted = True
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_AdamantineForge_PAD_ForgingIncomplete:dea6118f-63b8-419e-83c6-49fe06f11244
msgctxt "hc114b996gbe95g483ag9611g2e7a494a3ee2"
msgid "I'm missing heat. Lava."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_AdamantineForge_PAD_ForgingIncomplete
#. Speaker = Player
#. NodeID = dea6118f-63b8-419e-83c6-49fe06f11244
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_AdamantineForge_State_HaveCrafted = True
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_AdamantineForge_PAD_ForgingIncomplete:dea6118f-63b8-419e-83c6-49fe06f11244
msgctxt "h848b93d4g0d2ag4bf1gae20g81ebf7ee2ec3"
msgid "There can be no forging without a flame. The lava."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_AdamantineForge_PAD_ForgingIncomplete
#. Speaker = Player
#. NodeID = dea6118f-63b8-419e-83c6-49fe06f11244
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_AdamantineForge_State_HaveCrafted = True
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_AdamantineForge_PAD_ForgingIncomplete:dea6118f-63b8-419e-83c6-49fe06f11244
msgctxt "h726546bdgbd24g40f8gb89dg84240f30f893"
msgid "The mould and metal aren't much use without heat - the lava.\n"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_AdamantineForge_PAD_ForgingIncomplete
#. Speaker = Player
#. NodeID = dea6118f-63b8-419e-83c6-49fe06f11244
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
