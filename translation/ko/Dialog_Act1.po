msgctxt "h5297ef45g7caag4e08gb878g5e32851cdbe6"
msgid ""
"Blood. Hot blood, <i>salty </i>blood. Under your skin. Want it. <i>Want "
"it!</i>"
msgstr "피. 뜨겁고 <i>짭짤한</i>피. 네 피부 밑에. 원해. <i>원해!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeWorg1
#. Speaker = Worg
#. NodeID = 9de09a5d-81df-1109-75e1-316e88539a20
