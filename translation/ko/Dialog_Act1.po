#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinSulky:61c142db-8f4a-48f4-9105-29c1f06c1478
msgctxt "h2e700defg50e6g484fgbeedg704ea533d361"
msgid ""
"Then she falls flat on 'er face with an arrow in 'er back! That's the "
"Absolute that is. Protectin' me."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinSulky
#. Speaker = Devout Muzul
#. NodeID = 80a7ef27-052d-1f63-4974-e1247eb52300
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_GoblinSulky_HasMet(1) = False
#.   Tag:
#.      - BRANDED(0) = True
#. SetFlags:
#.   Dialog:
#.     - GOB_GoblinSulky_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinSulky:80a7ef27-052d-1f63-4974-e1247eb52300
msgctxt "h339471a0g47c1g4852gb1d0g4c21c6b77f45"
msgid "Lookit <i>this</i>. That's god's mark."
msgstr "<i>이거</i> 봐. 신의 표식이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinSulky
#. Speaker = Devout Muzul
#. NodeID = 91378d45-d84a-8b92-3f96-203cf7cc8a53
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_GoblinSulky_HasMet(1) = False
#.   Tag:
#.      - BRANDED(0) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_GoblinSulky_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinSulky:91378d45-d84a-8b92-3f96-203cf7cc8a53
msgctxt "h84cb7112ge6e9g4271gb63cg435d25878344"
msgid ""
"'Ere - you 'eard about wot happened on that last raid? Right so, some slob "
"'ad the drop on me... "
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Sharp-Eye Mirg
#. NodeID = 0523e87a-befe-223f-a0c8-26e7adf7828f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:0523e87a-befe-223f-a0c8-26e7adf7828f
msgctxt "h73fee61dge327g4712gba66gd8d682ba1c48"
msgid "That's it - down the hatch."
msgstr "그거야. 건배."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Sharp-Eye Mirg
#. NodeID = 061b5e28-b64f-80c5-0497-25b50291c3d4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:061b5e28-b64f-80c5-0497-25b50291c3d4
msgctxt "hb9f5fbafg4f56g480cgb9cfgfae248b025d5"
msgid "Bravo!"
msgstr "브라보!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Warlock Gurk
#. NodeID = 0b061503-d0e5-27be-2a2c-2f34914c0897
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_GoblinToast_ThirdGoblinToasted(4) = False
#.   Local:
#.      - 7f029596-e737-8960-2b43-4e375cb9f7fa_TEMPFLAG = True
#. SetFlags:
#.   Dialog:
#.     - GOB_GoblinToast_ThirdGoblinToasted(4) = True
#.   Global:
#.     - GLO_Moonrise_Knows_GoblinsCapturedADuke = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:0b061503-d0e5-27be-2a2c-2f34914c0897
msgctxt "haad37fa8gd430g4320g9abagf48a59396710"
msgid "To tha' duke's face when we gave 'im to the drow!"
msgstr "우리가 공작을 드로우에게 넘겼을 때의 그 낯짝을 위하여!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Sharp-Eye Aggy
#. NodeID = 2312e328-3d50-4b2a-ff23-3325b807bd9d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:2312e328-3d50-4b2a-ff23-3325b807bd9d
msgctxt "haedd61cfg5cc7g49b6g84a4g822977378c32"
msgid "Amateur!"
msgstr "아마추어 같으니!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Narrator
#. NodeID = 23c06ded-d6a3-596b-0fd0-ea0c1e640534
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_DUERGARDWARF or REALLY_DWARF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:23c06ded-d6a3-596b-0fd0-ea0c1e640534
msgctxt "h7aeaea07g548ag416cg8014g55ca611857d9"
msgid "*Besides a slight tingle, your stomach doesn't react to the poison.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Sharp-Eye Mirg
#. NodeID = 2adc6448-60bc-3c54-06eb-9007f5938dc6
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_GoblinToast_Event_FailedPersuasion = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:2adc6448-60bc-3c54-06eb-9007f5938dc6
msgctxt "hc7b6edb5g8875g4f4cg8b01gcb73b1b95dad"
msgid ""
"Yer... what... yer lyin', ain'tcha? Lemme show ya how we handle liars 'round "
"here."
msgstr "너...뭐... 너 거짓말 하는 거, 맞지? 여기서 거짓말 하는 놈에게 어떻게 하는지 보여줄까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Sharp-Eye Mirg
#. NodeID = 2bb83587-1834-dc52-7a00-c1e0d3a825ea
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Absolute_Knows_Name = True
#.   Local:
#.     - 150f6cfc-de70-b56b-df96-f0f49d89131e_MindHasBeenRead = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:2bb83587-1834-dc52-7a00-c1e0d3a825ea
msgctxt "he58ebdc8g9e04g4473g9faagfb5d3f4aef22"
msgid ""
"<i>Wastin' beer just like that drow True Soul. Said she needed a clear head "
"for Absolute business. Bah!</i>"
msgstr "<i>그 드로우 참된 영혼님처럼 맥주를 낭비하네. 그녀는 절대자의 본분을 위해 맑은 정신이 필요하다고 했지. 쳇!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Narrator
#. NodeID = 3cb82d93-e02d-f98d-1825-b6b30940a5f2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:3cb82d93-e02d-f98d-1825-b6b30940a5f2
msgctxt "h132877f3g6f23g4191g99a1g1e37b89057a5"
msgid "*The goblins blink at you in confusion.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Sharp-Eye Mirg
#. NodeID = 4222a3e3-b4d9-df4b-3bfb-7055940fb950
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:4222a3e3-b4d9-df4b-3bfb-7055940fb950
msgctxt "hb0c2ab10g8b88g43e7ga41eg0acc68dbd296"
msgid "That's how you end up dry, mate - not that I'm complainin'!"
msgstr "그러다 목 말라 죽어, 친구야. 그런다고 내가 불평하지 않아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Sharp-Eye Aggy
#. NodeID = 42b76d5b-9ad4-d04e-97ca-4a085dfaa27e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_GoblinToast_SecondGoblinToasted(4) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_GoblinToast_SecondGoblinToasted(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:42b76d5b-9ad4-d04e-97ca-4a085dfaa27e
msgctxt "h25759303g6202g4e93g8d7fg073e328c6cf6"
msgid "To findin' those looters and crushin' 'em!"
msgstr "도둑놈들을 찾아서 박살내자!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Sharp-Eye Mirg
#. NodeID = 46018c8f-4495-450f-291a-25071f37e05f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:46018c8f-4495-450f-291a-25071f37e05f
msgctxt "h807a6af4ge7d9g4fa1g8c77gddeba0b29204"
msgid ""
"Wait, 'ave ya been tamperin' with our beer? That what ye've been standin' "
"'round 'ere for?"
msgstr "잠깐, 너 우리 맥주에 손댄 거야? 그래서 여기 서있는 거였나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Sharp-Eye Mirg
#. NodeID = 49496612-ceb3-9565-0405-e97c8e8fb1a2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:49496612-ceb3-9565-0405-e97c8e8fb1a2
msgctxt "h01a4b0a0g8199g4bdeg8bbbge25200590d54"
msgid "Hey! Whatcha doin'? I knew there was something off 'bout you! Get 'er!"
msgstr "야! 뭐하고 있어? 너한테 뭔가 이상한 게 있다고 생각했어! 잡아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Sharp-Eye Mirg
#. NodeID = 49496612-ceb3-9565-0405-e97c8e8fb1a2
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:49496612-ceb3-9565-0405-e97c8e8fb1a2
msgctxt "hb3877220g014bg4108gb837g38ac251cc3c6"
msgid "Hey! Whatcha doin'? I knew there was something off 'bout you! Get 'im!"
msgstr "야! 뭐하고 있어? 너한테 뭔가 이상한 게 있다고 생각했어! 잡아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Sharp-Eye Mirg
#. NodeID = 49496612-ceb3-9565-0405-e97c8e8fb1a2
#. HandlePath = TaggedText[2].TagText[0]
#. SetFlags:
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:49496612-ceb3-9565-0405-e97c8e8fb1a2
msgctxt "h5acf7eb3gb089g4fd4gab5bgb1c0c76cebf1"
msgid "Hey! Whatcha doin'? I knew there was something off 'bout you! Get 'em!"
msgstr "야! 뭐하고 있어? 너희들한테 뭔가 이상한 게 있다고 생각했어! 잡아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Sharp-Eye Mirg
#. NodeID = 49ecbaf1-2b98-4fdb-50dd-f80a70e42444
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:49ecbaf1-2b98-4fdb-50dd-f80a70e42444
msgctxt "h04a60467g0e1cg4330gba7eg55ad7a8f8159"
msgid "Hey! That's our beer you're wastin'! Ain't good enough for ya?"
msgstr "이봐! 넌 우리 맥주를 버린 거야! 너에겐 안 맞는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Sharp-Eye Mirg
#. NodeID = 4dea28f6-3698-645d-4819-019588f67536
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GLO_Absolute_Knows_Name = True
#.     - GLO_Absolute_Knows_GoblinsWorship = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:4dea28f6-3698-645d-4819-019588f67536
msgctxt "h4d09bfbfg3793g4990g8e16g6c046671e342"
msgid ""
"Hah! You drew the short end of the stick, didn't ya? I'd say it's clear who "
"the Absolute favours."
msgstr "하! 너 짧은 막대를 뽑았지, 그렇지? 절대자가 누구를 선호하는지 분명해 보인다고 말하고 싶군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Player
#. NodeID = 523f9de2-b5b6-d6a7-abde-3a107601ea51
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:523f9de2-b5b6-d6a7-abde-3a107601ea51
msgctxt "h5cb9044ag398fg4940g9036g12bf2e02b31d"
msgid "You caught me. It's poisoned."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Narrator
#. NodeID = 53b3c244-2ec8-59d9-d4f0-d23d4857f908
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_GoblinToast_Event_DrinkPoisonedBeer(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:53b3c244-2ec8-59d9-d4f0-d23d4857f908
msgctxt "hf93975cbge938g4d69gb556gcdad2eee0c49"
msgid "*The poison burns your throat, but the goblin relaxes.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Warlock Gurk
#. NodeID = 549106e7-afc8-64b8-f887-3518b2fbf308
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:549106e7-afc8-64b8-f887-3518b2fbf308
msgctxt "h4e8d7471g0444g45dfgacdbg595095cf33f2"
msgid "Amateur!"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Warlock Gurk
#. NodeID = 585822dd-59d5-4b27-ce70-b358716f4f93
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:585822dd-59d5-4b27-ce70-b358716f4f93
msgctxt "h48d3bf1bgc0b7g4ff7g966bgaf42c2435b70"
msgid "I told ya we shouldn't be drinkin' the foam. It ain't right."
msgstr "내가 너희에게 거품도 마시면 안 된다고 했잖아. 이건 잘못됐어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Sharp-Eye Mirg
#. NodeID = 5adbcc43-8b37-1343-16f6-8e4c55bc8ac5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_GoblinToast_Event_FailedPersuasion = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:5adbcc43-8b37-1343-16f6-8e4c55bc8ac5
msgctxt "h26dea919gbc58g4759gb7b3gf417b9a55eaa"
msgid ""
"Right, you think I believe that? Lemme show ya how we handle liars 'round "
"here."
msgstr "그래, 네 말을 믿는다고 생각해? 여기서 거짓말쟁이들을 어떻게 다루는지 보여줄게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Sharp-Eye Mirg
#. NodeID = 61dcc621-ad62-6665-cfc5-6836bb2a9106
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: ELF
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:61dcc621-ad62-6665-cfc5-6836bb2a9106
msgctxt "ha9401848gb79cg48acgb764g87b24a968310"
msgid "Oh, go away! You elves think you're all special."
msgstr "오, 저리 가버려! 너희 엘프들은 모두 특별하다고 생각하는가봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Sharp-Eye Mirg
#. NodeID = 61dcc621-ad62-6665-cfc5-6836bb2a9106
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: HUMAN
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:61dcc621-ad62-6665-cfc5-6836bb2a9106
msgctxt "hd436e3e9gef23g450fg9d9egcddf13a3ea6e"
msgid "Oh, go away! You humans think you're all special."
msgstr "오, 저리 가버려! 너희 인간들은 모두 특별하다고 생각하는가봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Sharp-Eye Mirg
#. NodeID = 61dcc621-ad62-6665-cfc5-6836bb2a9106
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:61dcc621-ad62-6665-cfc5-6836bb2a9106
msgctxt "h17f40aa3ga29cg476dgb435g5150c64d63c4"
msgid "Oh, go away!"
msgstr "오, 저리 가버려!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Player
#. NodeID = 63215ee9-13da-2ac7-efbe-5392c8558ecb
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: RawAbility
#. RollAbility: Wisdom
#. DifficultyClass: 0
#. CheckFlags:
#.   Local:
#.      - 150f6cfc-de70-b56b-df96-f0f49d89131e_MindHasBeenRead = False
#.   Script:
#.      - GEN_CanDetectThoughts_5 = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:63215ee9-13da-2ac7-efbe-5392c8558ecb
msgctxt "h0a415d88g76b4g4646gad8agfd91853fd91d"
msgid "<i>Read her mind.</i>"
msgstr "<i>그녀의 생각을 읽는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Sharp-Eye Mirg
#. NodeID = 63e32add-b3b9-d2ab-9a81-83bff7707e24
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:63e32add-b3b9-d2ab-9a81-83bff7707e24
msgctxt "h040aa39eg7450g499dg883bg7d54efbb233b"
msgid "A toast! To our victory!"
msgstr "건배! 우리의 승리를 위하여!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Sharp-Eye Aggy
#. NodeID = 686edf41-4d8c-01a4-04fe-3cba48a2e6e2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_GoblinToast_Event_NoMoreRefills = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:686edf41-4d8c-01a4-04fe-3cba48a2e6e2
msgctxt "h8c421cc6gf466g4b8egbae7gb44ec897f228"
msgid "You think there's somethin' wrong with it?"
msgstr "뭔가 잘못된 건 줄 아나 보지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Sharp-Eye Mirg
#. NodeID = 6ce69873-ea1e-627a-c9a5-328dd91c6519
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_GoblinToast_Event_FailedPersuasion = True
#. TagRule: FEMALE
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:6ce69873-ea1e-627a-c9a5-328dd91c6519
msgctxt "h5de59bf4gbecag4380g9bf6g9f97e6bc49ed"
msgid "I shoulda known! Get 'er!"
msgstr "진작 널 알았어야 했는데! 잡아라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Sharp-Eye Mirg
#. NodeID = 6ce69873-ea1e-627a-c9a5-328dd91c6519
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_GoblinToast_Event_FailedPersuasion = True
#. TagRule: MALE
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:6ce69873-ea1e-627a-c9a5-328dd91c6519
msgctxt "he219b65ag0a7fg470ag9b8dg281fe1d8ea1b"
msgid "I shoulda known! Get 'im!"
msgstr "진작 널 알았어야 했는데! 잡아라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Sharp-Eye Mirg
#. NodeID = 6ce69873-ea1e-627a-c9a5-328dd91c6519
#. HandlePath = TaggedText[2].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_GoblinToast_Event_FailedPersuasion = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:6ce69873-ea1e-627a-c9a5-328dd91c6519
msgctxt "h2398f2b2g7cb7g4a7cgbd54g76db25f771c7"
msgid "I shoulda known! Get 'em!"
msgstr "진작 너흴 알았어야 했는데! 잡아라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Player
#. NodeID = 709cecc8-044d-7f6c-51e3-bf9cf5aadb64
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:709cecc8-044d-7f6c-51e3-bf9cf5aadb64
msgctxt "h4643965ag75e2g47b6gb32dgff63d7d553af"
msgid "<i>Drink quickly to squash their suspicions.</i>"
msgstr "<i>의심을 없애기 위해 빨리 마신다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Player
#. NodeID = 7539a969-c439-7945-2f0b-bba4c7fa67fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:7539a969-c439-7945-2f0b-bba4c7fa67fc
msgctxt "h7e1d2092gddd7g4b59gb86eg39db05c69c96"
msgid "I'm glad you asked. Tell everyone to gather round..."
msgstr "물어봐주니 기쁘군. 모두에게 모이라고 전해 줘…"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Player
#. NodeID = 77b3d022-4d0e-d030-94f9-c5a47d5c7da4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:77b3d022-4d0e-d030-94f9-c5a47d5c7da4
msgctxt "h10131816g424cg4c71gbb6bg763880fbe833"
msgid "It's your party - celebrate it however you like."
msgstr "이건 너희 파티니까 너희가 원하는 대로 축하해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Sharp-Eye Mirg
#. NodeID = 82d411dc-a9b5-1f3a-8b09-e0c9f61f04d3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:82d411dc-a9b5-1f3a-8b09-e0c9f61f04d3
msgctxt "h615c36d3g6d53g46e4gba78gbf78de994804"
msgid "Ehh..."
msgstr "에에..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Player
#. NodeID = 8524307c-72d5-3fb6-871b-4ec5b3a36ded
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:8524307c-72d5-3fb6-871b-4ec5b3a36ded
msgctxt "h4f8f45f6g78fag489eg8a7dgc468ddc3b055"
msgid "After you! I shouldn't drink before the host."
msgstr "너 먼저! 주최자보다 내가 먼저 마시면 안되지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Sharp-Eye Mirg
#. NodeID = 917155e7-02e2-3e8c-6c8e-f510f662c9f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:917155e7-02e2-3e8c-6c8e-f510f662c9f4
msgctxt "h57576622g735dg4889gbe20ga636c522e373"
msgid "Hey! That's our beer you're wastin'! Shove off!"
msgstr "이봐! 지금 우리 맥주를 낭비하고 있잖아! 저리 꺼져!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Player
#. NodeID = 91d27a03-2590-ddb4-8f7d-bf8e0b7f5016
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - BARD(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:91d27a03-2590-ddb4-8f7d-bf8e0b7f5016
msgctxt "he50685a0g501cg4dd3ga278g8ca5d254c47f"
msgid "<i>Show off an elaborate bartending trick.</i>"
msgstr "<i>정교한 바텐더 기술을 선보인다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Player
#. NodeID = 9e3fd3d6-e70e-ca07-5262-659a0fca765f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:9e3fd3d6-e70e-ca07-5262-659a0fca765f
msgctxt "h7f7458e3gcbeeg4d53ga090gb46b6ce490d4"
msgid "I'll pass. Need a clear head for now."
msgstr "난 사양하지. 지금은 맑은 정신을 유지해야 해서 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Player
#. NodeID = a0406cb5-0312-dd8a-e4c9-b879535532fc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Absolute_Knows_GoblinsWorship = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:a0406cb5-0312-dd8a-e4c9-b879535532fc
msgctxt "hc57f4ecbg2455g47c5g88d1gd849e234f683"
msgid "To the Absolute!"
msgstr "절대자님을 위하여!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Narrator
#. NodeID = ab209e34-b7d4-8bcc-fdfa-a318bae9c593
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_GoblinToast_Event_DrinkPoisonedBeer(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:ab209e34-b7d4-8bcc-fdfa-a318bae9c593
msgctxt "hf9383e80gf595g4b82ga4bdge0ce42e1994a"
msgid "*The poison burns your throat, but the goblins follow your lead.*"
msgstr "*독극물에 당신의 목이 타들어 가지만, 고블린들도 당신을 따라 마십니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Sharp-Eye Mirg
#. NodeID = b1cf607a-d686-4b98-3d64-d803074f3296
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:b1cf607a-d686-4b98-3d64-d803074f3296
msgctxt "h10206a50g2d35g487eg86abg3efb06c1159c"
msgid "Guys! This 'un's givin' us a toast!"
msgstr "얘들아! 이 녀석이 우리에게 건배를 한대!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Sharp-Eye Mirg
#. NodeID = b5e3c91a-c728-c4f0-6c66-913fe6addcca
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:b5e3c91a-c728-c4f0-6c66-913fe6addcca
msgctxt "h86d74813g9c9fg45d4g8d78gbdb857f42478"
msgid "Well, watch it - we worked hard for that beer!"
msgstr "야, 조심해 - 그 맥주를 얻으려고 엄청 고생했다고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Narrator
#. NodeID = b7175e04-7134-916a-963c-3175bc1d0909
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:b7175e04-7134-916a-963c-3175bc1d0909
msgctxt "hfb1d00d1ga434g4f36gbeedg36583ce88857"
msgid "*You raise your glass and shout...*"
msgstr "*당신은 잔을 들어올리며 외칩니다...*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Player
#. NodeID = b934a8c9-5d1e-b8f0-0c8a-951c6e3f14e3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:b934a8c9-5d1e-b8f0-0c8a-951c6e3f14e3
msgctxt "ha08741aaga8acg470eg8060gb4aac2c3bf73"
msgid "To... our health?"
msgstr "우리의... 건강을 위하여?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Player
#. NodeID = bb65c282-e260-4b3d-2dea-38db89828a4d
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 7
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:bb65c282-e260-4b3d-2dea-38db89828a4d
msgctxt "hed244d86gd1b7g4919gb0b9gddc0e10fea16"
msgid "Aw, c'mon. I've already had a few cups... can barely see straight."
msgstr "에이, 봐줘. 난 벌써 꽤 마셨다고... 앞도 잘 안 보일 지경이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Player
#. NodeID = bdd3ac3a-a6f8-2c16-ad88-2627d547f3a2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:bdd3ac3a-a6f8-2c16-ad88-2627d547f3a2
msgctxt "h2d58534egd89dg4f6bg8322gf7b25c94f914"
msgid "To drinking 'til we die!"
msgstr "죽을 때까지 퍼마시자!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Sharp-Eye Mirg
#. NodeID = c6b17b52-dea2-8d74-bd49-13d9775181c7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:c6b17b52-dea2-8d74-bd49-13d9775181c7
msgctxt "h803ef8cfg81ffg4392g97c9g7614a171751b"
msgid "Now you!"
msgstr "이제 네 차례야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Player
#. NodeID = c78000b1-5814-1473-4a7d-0505b01b7906
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 150f6cfc-de70-b56b-df96-f0f49d89131e_MindHasBeenRead = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:c78000b1-5814-1473-4a7d-0505b01b7906
msgctxt "hc3babc64g46b5g4f94gb024g04ce73ad4652"
msgid ""
"Don't be stupid. You might be able to drink all day - the Absolute needs me "
"sober."
msgstr "멍청하게 굴지 마. 너는 하루 종일 마셔도 되지만, 절대자님은 내가 맨정신이기를 원하셔."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Sharp-Eye Mirg
#. NodeID = c8cbee23-3858-87cf-091c-c7cc7b7640c1
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: TIEFLING
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:c8cbee23-3858-87cf-091c-c7cc7b7640c1
msgctxt "hf088dedcg0ccbg47c3g9467g9dab1410289a"
msgid ""
"Hah! Guess you tieflings can't help but look suspicious. Now get outta my "
"way - I need another drink!"
msgstr "하! 너희 티플링들은 의심스러워 보일 수밖에 없구나. 이제 저리 비켜. 난 한 잔 더 마셔야겠어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Sharp-Eye Mirg
#. NodeID = c8cbee23-3858-87cf-091c-c7cc7b7640c1
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:c8cbee23-3858-87cf-091c-c7cc7b7640c1
msgctxt "heca69055gcb0fg4d18gbf3bg4abdab07e2d1"
msgid ""
"Guess you can't help but look suspicious, without a nose and all. Now get "
"outta my way - I need another drink!"
msgstr "너희는 코도 없으니 의심스러워 보일 수밖에 없구나. 이제 저리 비켜. 난 한 잔 더 마셔야겠어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Sharp-Eye Mirg
#. NodeID = c8cbee23-3858-87cf-091c-c7cc7b7640c1
#. HandlePath = TaggedText[2].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:c8cbee23-3858-87cf-091c-c7cc7b7640c1
msgctxt "hf24471ffg9e38g4bd1g8197gb22081ca4622"
msgid ""
"You looked real suspicious for a bit. Now get outta my way - I need another "
"drink!"
msgstr "너 잠깐 동안 진짜 의심스러워 보였어. 이제 저리 비켜. 난 한 잔 더 마셔야겠어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Tracker Klagga
#. NodeID = cee93b9a-d205-decd-37d0-7dee2946b64c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:cee93b9a-d205-decd-37d0-7dee2946b64c
msgctxt "hbc4201beg1ee3g42e4gbff7gbf7cc0633715"
msgid "Ya can always take a bite out of me!"
msgstr "언제든 날 한입 물어도 좋아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Player
#. NodeID = cf0a02b0-1dc2-0b69-6713-888fbc08b4d5
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Dexterity
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:cf0a02b0-1dc2-0b69-6713-888fbc08b4d5
msgctxt "heebe0723gc407g4254gbdefg3f7b26168fb3"
msgid "<i>Spill the beer, then pretend to drink from the empty cup.</i>"
msgstr "<i>맥주를 쏟고 빈 잔을 마시는 척한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Sharp-Eye Mirg
#. NodeID = d2efd7e5-b8fc-00a3-012f-b0f6e993f35a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:d2efd7e5-b8fc-00a3-012f-b0f6e993f35a
msgctxt "he22ef2d9g3369g438eg84a4ge54b75be1309"
msgid ""
"Anyway. 'S good beer, so don't waste it. Now get outta my way - I need "
"another drink!"
msgstr "어쨌든. 좋은 맥주니까 낭비하지 마. 이제 저리 비켜. 난 한 잔 더 마셔야겠어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Player
#. NodeID = d3160ab9-ed79-f59f-63b0-cd43bb67943a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:d3160ab9-ed79-f59f-63b0-cd43bb67943a
msgctxt "h0c643420g909eg4b79g80efgbefac09a918a"
msgid "<i>Down the beer.</i>"
msgstr "<i>잔을 내린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Player
#. NodeID = d4a54e76-3e10-9924-f502-fe03f666d604
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:d4a54e76-3e10-9924-f502-fe03f666d604
msgctxt "hf284f0e3g0911g43dbgb161g4f1ea7eb8a33"
msgid "I was checking none of you idiots had spilled anything foul in there."
msgstr "난 너같은 멍청이들이 더러운 걸 흘리지 않았는지 확인하고 있었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Player
#. NodeID = d5c37eb0-77bd-0bb4-d115-0cad76c8e204
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:d5c37eb0-77bd-0bb4-d115-0cad76c8e204
msgctxt "haf099cf0ga8d3g4cfaga92bg9ebb8e7edf11"
msgid "May I bed each and every one of you before the sun sets!"
msgstr "해가 지기 전에 내가 너희 모두와 잘 수 있기를!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Sharp-Eye Mirg
#. NodeID = dd8bfbfe-4b6d-1bde-e129-377184c3127a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:dd8bfbfe-4b6d-1bde-e129-377184c3127a
msgctxt "haf4fd01fg12f1g42bega014g4d5cd92db082"
msgid "Yer... what - 'course we didn't!"
msgstr "너... 뭐라고 - 당연히 우린 안 했지!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Sharp-Eye Mirg
#. NodeID = e2a0d5bb-f5e5-4c5b-5a7e-a5f063f80292
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:e2a0d5bb-f5e5-4c5b-5a7e-a5f063f80292
msgctxt "h38be4301g518dg4e1agacceg94baa5721679"
msgid ""
"Why not? Wait, 'ave ya been tamperin' wif our beer? That what ye've been "
"standin' 'round 'ere for?"
msgstr "왜 안 돼? 잠깐, 너 우리 맥주에 장난질을 했어? 여기서 어슬렁거리던 이유였어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Sharp-Eye Mirg
#. NodeID = e336d328-ed9d-234c-0d63-805e9086c71c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:e336d328-ed9d-234c-0d63-805e9086c71c
msgctxt "hec2a8103g3d80g43a8g988fg67b5e7aa2393"
msgid "Watcha standing 'ere all dry fer? C'mere, have a drink!"
msgstr "목 마른데 가만히 서서 뭐해? 이리 와서 마셔!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
#. Speaker = Player
#. NodeID = e4dd815a-7e3b-748d-34d9-a9d340f019ad
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast:e4dd815a-7e3b-748d-34d9-a9d340f019ad
msgctxt "hb68ba558g1d05g4f43ga562g2a8f2c98b8a6"
msgid "To me!"
msgstr "나를 위하여!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinToast
