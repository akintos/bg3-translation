msgctxt "h1cd5449cg40b5g4023gbc12g9869e16e06a8"
msgid ""
"*The foul stench of slaughter turns suddenly sweet through the rat's nose.*"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_RatRacket_LocalRat_001
#. Speaker = Narrator
#. NodeID = 6bdbdf91-db84-3d39-756a-1c9a1a6427d9
#. HandlePath = TaggedText[0].TagText[0]
