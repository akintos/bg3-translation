msgctxt "hca8d360dg3e2cg4ac4g8cc8ga811e99ff7c7"
msgid "Ouch! My fing!\n"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_SwampExploration_PAD_PrickedFinger
#. Speaker = Player
#. NodeID = efb82b54-7591-ee2c-72fd-591b9e7e7bc5
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_SwampExploration_PAD_PrickedFinger:efb82b54-7591-ee2c-72fd-591b9e7e7bc5
msgctxt "hc4b835f5gb106g4d41gaf0dgc322f9e39a1b"
msgid "Ack - my finger. Those thorns are sharp."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_SwampExploration_PAD_PrickedFinger
#. Speaker = Player
#. NodeID = efb82b54-7591-ee2c-72fd-591b9e7e7bc5
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_SwampExploration_PAD_PrickedFinger:efb82b54-7591-ee2c-72fd-591b9e7e7bc5
msgctxt "h5a82dfc1g8647g408ag9a6dg87f243387887"
msgid "<i>Owh! </i>That smarts."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_SwampExploration_PAD_PrickedFinger
#. Speaker = Player
#. NodeID = efb82b54-7591-ee2c-72fd-591b9e7e7bc5
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_SwampExploration_PAD_PrickedFinger:efb82b54-7591-ee2c-72fd-591b9e7e7bc5
msgctxt "h2fa343cdgc693g4fe5gb3c6gefd49ade542b"
msgid "Damn it - my finger!"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_SwampExploration_PAD_PrickedFinger
#. Speaker = Player
#. NodeID = efb82b54-7591-ee2c-72fd-591b9e7e7bc5
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_SwampExploration_PAD_PrickedFinger:efb82b54-7591-ee2c-72fd-591b9e7e7bc5
msgctxt "h7c023079gda73g47fdgb00fg74b8601c3a28"
msgid "Ah! My finger."
msgstr "아, 내 손가락!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Well
#. Speaker = Player
#. NodeID = 0b207db8-328a-3654-3c2a-9246e7bc22fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Well:0b207db8-328a-3654-3c2a-9246e7bc22fc
msgctxt "h5a182c8agf3ebg4651g820fgdaa622e35d3f"
msgid "<i>Drink from the well.</i>"
msgstr "<i>우물에서 물을 마신다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Well
#. Speaker = Narrator
#. NodeID = 3fa72a2b-b2d2-d750-7221-bba4fbc38cd0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_ForestIllusion_Event_DropIllusion = False
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Well:3fa72a2b-b2d2-d750-7221-bba4fbc38cd0
msgctxt "h678f5583g881dg439cg9ccfgc467b6f609f4"
msgid "*Fresh, sweet-smelling water gurgles gently below.*"
msgstr "*달콤한 향기가 나는 신선한 물이 아래에서 조용히 흐르고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Well
#. Speaker = Narrator
#. NodeID = 49b2b9de-8de7-1501-606a-d12ee4e1a111
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_ForestIllusion_Event_DropIllusion = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Well:49b2b9de-8de7-1501-606a-d12ee4e1a111
msgctxt "h66c276d1g1f05g43d1g8061gf14a0137f68c"
msgid ""
"*A fetid smell assaults your nostrils. Dead flesh lies below - a great deal "
"of it.*"
msgstr "*썩은내가 코를 찌릅니다. 죽은 것들이 저 밑에 있습니다. 그것도 아주 많이.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Well
#. Speaker = Narrator
#. NodeID = 707117b9-d2d9-1afb-3328-e351de1ab3e5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - HAG_Well_Event_WellPoisoned(1) = False
#. SetFlags:
#.   Object:
#.     - HAG_Well_Event_DrinkWell(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Well:707117b9-d2d9-1afb-3328-e351de1ab3e5
msgctxt "h80ec8166g63e9g4cd2g9656g4e0aab90c68b"
msgid ""
"*The warm rush of power flows through you. You feel stronger, faster - "
"<i>better.*</i>"
msgstr "*힘이 당신을 타고 따뜻하게 흐릅니다. 당신은 더 강하고, 더 빠르고,- <i>더 나아진</i> 느낌이 듭니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Well
#. Speaker = Narrator
#. NodeID = 7b9992a8-f48e-da73-bf11-ba146c02fc76
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - HAG_Well_Event_WellPoisoned(1) = True
#. SetFlags:
#.   Object:
#.     - HAG_Well_Event_DrinkWell(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Well:7b9992a8-f48e-da73-bf11-ba146c02fc76
msgctxt "h23736421g0ebag445bg9787g01775db5768a"
msgid "*A cloying rot jams in your throat. All you can taste is <i>bile.</i>*"
msgstr "*역겨운 썩은 것이 목구멍에 걸립니다. <i>고약한</i> 맛만 느껴집니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Well
#. Speaker = Player
#. NodeID = ed7d4f5c-706a-753f-0f71-75e029fff12a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_Well:ed7d4f5c-706a-753f-0f71-75e029fff12a
msgctxt "h79230be0g3225g4c1fg88fcg03d802a72494"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Player
#. NodeID = 0268ba1f-a580-0fa0-ca1d-9c69ff0b5407
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - HAG_Hagspawn_Event_HasSummoningWand(2) = True
#. SetFlags:
#.   Object:
#.     - HAG_HagSpawn_Event_LockWand(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:0268ba1f-a580-0fa0-ca1d-9c69ff0b5407
msgctxt "heb50367fge69eg4de1g9e79ga37228a11fc6"
msgid "<i>Snap the wand in two. </i>"
msgstr "<i>마법봉을 두 조각으로 부러뜨린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Mayrina
#. NodeID = 02c07805-e751-bf9f-9fa2-8fcffb211be8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:02c07805-e751-bf9f-9fa2-8fcffb211be8
msgctxt "hb5ccecb9gaa48g4868gb372g9cf1e0a79081"
msgid "I don't even know if he's in there."
msgstr "저 안에 그가 있기는 한지도 잘 모르겠어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Player
#. NodeID = 03d24c3b-d2a6-6aa5-fe92-04f3b0b50205
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_SELUNE or PALADIN_SELUNE
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:03d24c3b-d2a6-6aa5-fe92-04f3b0b50205
msgctxt "hedeb6b57g5474g4c0fgb12ag0bfd077229a3"
msgid ""
"Light wanes only to wax again - and though life fades, memory shall not."
msgstr "빛은 꺼져도 다시 차오르기 마련이니, 삶이 끝나더라도, 기억은 남으리라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Mayrina
#. NodeID = 03dedd2d-6357-1e40-f076-a4a03c0661cc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:03dedd2d-6357-1e40-f076-a4a03c0661cc
msgctxt "hd3b49069g3a1eg4e12ga6a7gf01193af5480"
msgid "What in the hells was <i>that</i>?"
msgstr "지금 <i>무슨</i> 소리를 하는 거예요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Player
#. NodeID = 04079eef-15ec-0a5b-0a35-c25e6b1aaa77
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_ILMATER or PALADIN_ILMATER
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:04079eef-15ec-0a5b-0a35-c25e6b1aaa77
msgctxt "h97f40f06g5b38g4a62ga040g267dcbdb3bdf"
msgid ""
"You suffered and endured - may the Broken One shoulder your burdens, that "
"you might walk free."
msgstr "그대는 고통을 받고 인내했노라. 부서진 이께서 그대의 짐을 지시고, 그대를 자유롭게 하시기를."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Mayrina
#. NodeID = 064d3cd4-6af1-c9f7-5b34-072a2121a820
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - HAG_SurrogateMother_HasMet_Resurrect(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:064d3cd4-6af1-c9f7-5b34-072a2121a820
msgctxt "h26453d94g80c9g4a67g8887g84587767ec44"
msgid ""
"The thought of putting him in a wheelbarrow and making the journey all over "
"again... *Sigh.*"
msgstr "그를 손수레에 태우고 왔던 길을 다시 돌아간다는 건... *하아.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Mayrina
#. NodeID = 07b21500-3de9-7cc3-0e4c-67ac8f65807f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAG_SurrogateMother_HasMet_Resurrect(2) = True
#.      - HAG_Hagspawn_State_MayrinaAngry(2) = True
#.   User:
#.      - HAG_HagSpawn_Knows_OfferedResurrectHusband(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:07b21500-3de9-7cc3-0e4c-67ac8f65807f
msgctxt "ha616699fg9c8cg4233g87dbg79cb9e5a9567"
msgid "<i>What?</i>"
msgstr "<i>뭔데요?</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Player
#. NodeID = 091ff276-3e5b-8117-a2a1-5323082aae62
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_EVIL or PALADIN_EVIL
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:091ff276-3e5b-8117-a2a1-5323082aae62
#, fuzzy
msgctxt "hbb01e531gdaa5g469bgacbag485bfb011289"
msgid "Another reminder of mortal fragility. I am grateful for this gift."
msgstr "필멸자의 연약함에 대한 가르침을 주시니, 이 선물을 감사히 받습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Mayrina
#. NodeID = 09b076df-9d6f-4357-489e-31250d159de5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:09b076df-9d6f-4357-489e-31250d159de5
msgctxt "h6b06d9dbg1d8bg44a5gac8fge694d4467d29"
msgid "He's not a creature! He's my <i>husband</i>."
msgstr "괴생명체라니요! 내 <i>남편</i>이라고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Mayrina
#. NodeID = 0aa5fd67-5c1c-3d35-adcf-8cab1d9ea6cb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:0aa5fd67-5c1c-3d35-adcf-8cab1d9ea6cb
msgctxt "he06b43ecg0d62g4d00gb55bg62bfbda940f0"
msgid "I'll do it. I'll take him."
msgstr "알았어요. 제가 그를 데려갈게요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Mayrina
#. NodeID = 11148674-44b9-6a91-4755-139bd057a02b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:11148674-44b9-6a91-4755-139bd057a02b
msgctxt "h82619f0agcf20g477bgaec4ge3fa6173172e"
msgid "Then why are you even here? Damn it."
msgstr "그럼 애초에 여긴 왜 온 거예요? 망할."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Mayrina
#. NodeID = 187cb6dc-5e27-1d6c-313f-a5177721cb55
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:187cb6dc-5e27-1d6c-313f-a5177721cb55
msgctxt "h46fd86bag75eag4dd8g8bbeg4c834d5eb364"
msgid "We've barely spent a day apart since."
msgstr "그 이후로 우리는 하루도 떨어져 지낸 적이 없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Narrator
#. NodeID = 1d08135b-2604-b71f-0c6d-bbb216fd116b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:1d08135b-2604-b71f-0c6d-bbb216fd116b
msgctxt "hb4556d5bg2db0g407eg9ac9g4a20450556e5"
msgid ""
"*You feel something pull at you. The creature yearns - for a <i>master</i>.*"
msgstr "*무언가가 당신을 끌어당기는 것이 느껴집니다. 이 생명체는 <i>주인</i>을 갈망합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Mayrina
#. NodeID = 1ec9eca0-80ac-2a31-3be2-114b9659a289
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:1ec9eca0-80ac-2a31-3be2-114b9659a289
msgctxt "h6b8ed518gbed9g412bgb63dg820fb7c48460"
msgid "What have you done?! You BASTARD!"
msgstr "무슨 짓을 한 거야?! 이 <b>개자식</b>!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Player
#. NodeID = 21049db3-3ad9-b760-d53d-d945805f1e04
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAG_Hagspawn_Event_RecruitHusband = True
#.   Quest:
#.     - HAG_HagSpawn.TookHusband(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:21049db3-3ad9-b760-d53d-d945805f1e04
msgctxt "h294849c2g6c08g4406gbd76g406669837b07"
msgid "<i>Pocket the wand anyway. </i>"
msgstr "<i>상관하지 않고 마법봉을 챙긴다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Player
#. NodeID = 22d07ee8-c547-15d0-3a0f-2e779121d9a2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - HAG_HagSpawn_Event_DoResurrection(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:22d07ee8-c547-15d0-3a0f-2e779121d9a2
msgctxt "hd8cf9ae4g1cb6g4defg9275gad9d6f17a47b"
msgid "<i>Point the wand towards the coffin.</i>"
msgstr "<i>마법봉을 관 방향에 가리킨다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Mayrina
#. NodeID = 274c9da1-8617-c5cb-70e1-3b81c183bc9d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:274c9da1-8617-c5cb-70e1-3b81c183bc9d
msgctxt "h0e2366acg98abg4282ga827gb60f3aa1fb08"
msgid "He was... he<i> is </i>afraid of the dark."
msgstr "남편은 어두운 걸 싫어했... <i>싫어한다고요</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Mayrina
#. NodeID = 2888d3cc-ca0c-69a2-3dca-a5098e96ed60
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:2888d3cc-ca0c-69a2-3dca-a5098e96ed60
msgctxt "ha5ad71edg9b9dg474ag9709g5f8a285d66ba"
msgid "Not permanent? Bits of him are <i>falling off</i>."
msgstr "영구적이지 않다고요? 신체 부위들이 <i>떨어져 나가고</i> 있잖아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Mayrina
#. NodeID = 2a4978f9-e781-650a-07aa-f2ff1609f8fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:2a4978f9-e781-650a-07aa-f2ff1609f8fe
msgctxt "h50ca5a82g966ag4f24gbf5bg44e9ede09fb1"
msgid "Bring him back. Bring Connor back - <i>please</i>."
msgstr "우리 그이를 돌려줘요. 코너를 되살려 주세요. <i>제발요</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Mayrina
#. NodeID = 2d6439f4-877b-0a18-69f1-4edfdcf7a141
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:2d6439f4-877b-0a18-69f1-4edfdcf7a141
msgctxt "h963445e3g5b71g42f0ga948ga3c836f24b5e"
msgid "He'd have liked that. Thanks."
msgstr "그도 좋아했을 거예요. 고마워요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Mayrina
#. NodeID = 3069df9f-920e-a4a0-2f6e-3b74a41f3b88
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:3069df9f-920e-a4a0-2f6e-3b74a41f3b88
msgctxt "h98788315g1538g4ca2gbca5g76fd780a2371"
msgid "Please. Connor used to say only a fool turned down the divine."
msgstr "해주세요. 코너는 바보만이 신을 부정한다 말하곤 했어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Player
#. NodeID = 31b11452-73a1-ec63-0519-e5a55d22a7c0
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAG_Hagspawn_Event_LeaveHusband = True
#.     - HAG_Hagspawn_Event_WifeHusbandLeave = True
#.   Object:
#.     - HAG_Hagspawn_Event_GiveSummoningWand(0) = True
#.   Quest:
#.     - HAG_HagSpawn.LeftHusband(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:31b11452-73a1-ec63-0519-e5a55d22a7c0
msgctxt "h7240a25eg852ag4486g943cgc466639a62f8"
msgid "I'm sorry this is how things turned out."
msgstr "일이 이렇게 돼서 미안해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Player
#. NodeID = 3e871c90-b125-85f0-8c55-fd98b6aac7ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:3e871c90-b125-85f0-8c55-fd98b6aac7ea
msgctxt "h049ecc9cg6cf2g4a23g94dcg026f13e20096"
msgid "No. The dead should stay dead."
msgstr "안 돼. 죽은 자는 죽은 상태로 있어야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Player
#. NodeID = 3f07680b-dda7-efad-9606-92887ccb3359
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_TYR or PALADIN_TYR
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:3f07680b-dda7-efad-9606-92887ccb3359
#, fuzzy
msgctxt "hb983a578gd772g47degbaf4gb641bbd3f5d8"
msgid ""
"This man's death came too soon. See to it, Wounded Tyr, that he find some "
"justice beyond the grave."
msgstr "이 자의 죽음은 너무 일찍 찾아왔습니다. 상처입은 티르시여, 이 자를 굽어 살피사, 그가 무덤 너머에서 정의를 찾게 해주십시오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Narrator
#. NodeID = 425dcf34-ac86-2220-386d-073538c60a84
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:425dcf34-ac86-2220-386d-073538c60a84
msgctxt "h424a1fffg6ffcg48b0gabb1ga6d3806490a1"
msgid ""
"*You feel a surge of power from the wand - the air suddenly tastes acrid. It "
"<i>wants</i> to be used.*"
msgstr "*마법봉에서 힘이 솟구치는 것이 느껴지며 갑자기 공기가 매캐해집니다. 이 물건은 사용되길 <i>원합니다</i>.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Player
#. NodeID = 457ee28e-be95-1b48-fa05-7fae8d223eeb
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:457ee28e-be95-1b48-fa05-7fae8d223eeb
msgctxt "h0921a62ag5e2fg47f4g9b33g6f1eec1e1210"
msgid "I could say a prayer, if you'd like."
msgstr "당신이 괜찮다면 기도를 해줄 수도 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Mayrina
#. NodeID = 46dd3068-1a50-1f63-dc3c-3bbbd30df990
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:46dd3068-1a50-1f63-dc3c-3bbbd30df990
msgctxt "h38a92a26gb09cg4810gb947ge1e1d2ff1192"
msgid "You're a miserable bastard, you know that?"
msgstr "당신은 성질 나쁜 개자식이에요, 알고 있어요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Mayrina
#. NodeID = 473f1f85-548b-efd1-913e-8d9fdc6261ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:473f1f85-548b-efd1-913e-8d9fdc6261ed
msgctxt "hdfb64a93ga503g4299g8affg40ebc2e757db"
msgid "I'll... I'll figure something out. C'mon, love. Let's... let's go."
msgstr "제가... 제가 뭔가를 알아낼 거예요. 따라와요, 여보. 같이... 같이 가자고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Player
#. NodeID = 49c3ea73-11dc-a11e-80c7-dc1c83cc7fea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:49c3ea73-11dc-a11e-80c7-dc1c83cc7fea
msgctxt "he52bdd14gc257g4042g9fcege2435016f479"
msgid "Whining won't get you there any faster."
msgstr "징징거린다고 일이 빨라지진 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Connor Vinderblad
#. NodeID = 4b9d3e67-6a65-6bf1-9215-5d156feac5b8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:4b9d3e67-6a65-6bf1-9215-5d156feac5b8
msgctxt "h97ef91ddg0accg415ega3cfg03feaf766057"
msgid "<i>Argh.</i>"
msgstr "<i>아앍.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Player
#. NodeID = 51009960-8eeb-c66f-52a4-ad9703d9ac8e
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_KELEMVOR or PALADIN_KELEMVOR
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:51009960-8eeb-c66f-52a4-ad9703d9ac8e
msgctxt "h956ddfd3g39f2g4752g80c3g3db0458f6b68"
msgid ""
"You join the same path as all those before - may Kelemvor guide your steps."
msgstr "그대는 이전에 간 이들과 같은 길을 걷노라. 켈렘보르께서 그대의 발길을 인도하시기를."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Player
#. NodeID = 5b7e7d86-c6ba-a819-e9ae-f6023c7f2a47
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - HAG_Hagspawn_Event_HasSummoningWand(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:5b7e7d86-c6ba-a819-e9ae-f6023c7f2a47
msgctxt "h335afbabgdc7eg4acagaa1eg79425347cad9"
msgid "I can't. I don't have the wand anymore."
msgstr "못해. 이제 내게 그 마법봉은 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Mayrina
#. NodeID = 5cdd89be-3d76-4471-e035-d67573527cf7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:5cdd89be-3d76-4471-e035-d67573527cf7
msgctxt "hdcf00561g7882g497ag8f0cg9d27f956d011"
msgid ""
"Maybe someone in Baldur's Gate can help us. Connor always said you can find "
"anything in that city."
msgstr "발더스 게이트에 있는 누군가라면 저희를 도울 수 있을지도 몰라요. 코너가 항상 그 도시에선 뭐든지 찾을 수 있다고 했거든요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Mayrina
#. NodeID = 5d3d59ef-44d8-fc5e-e372-70b0fda335fc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:5d3d59ef-44d8-fc5e-e372-70b0fda335fc
msgctxt "hadfcf470gac8eg4c7bgafbdg98d2cf813ff9"
msgid "No! Don't! CONNOR!"
msgstr "안 돼! 하지 마! 코너!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Player
#. NodeID = 5eca63cf-0abb-ccf5-ff87-79bdb17170d8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAG_Hagspawn_Event_LeaveHusband = True
#.     - HAG_Hagspawn_Event_WifeHusbandLeave = True
#.   Object:
#.     - HAG_Hagspawn_Event_GiveSummoningWand(0) = True
#.   Quest:
#.     - HAG_HagSpawn.LeftHusband(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:5eca63cf-0abb-ccf5-ff87-79bdb17170d8
msgctxt "h0ef8cd38gfafdg4a1egb038g4ace151d4e14"
msgid "Your husband's gone - this thing is just a monster."
msgstr "당신 남편은 죽었어. 이런 건 괴물일 뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Connor Vinderblad
#. NodeID = 60d646fa-d779-8786-55c8-b92edf05aa93
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:60d646fa-d779-8786-55c8-b92edf05aa93
msgctxt "hf70028f1g234cg41f3gb51fgef54dfbe40ae"
msgid "Arggh..."
msgstr "아아앍..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Mayrina
#. NodeID = 6358b643-41ae-82f7-3809-3cddac410d5f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:6358b643-41ae-82f7-3809-3cddac410d5f
msgctxt "h12120d31gaeb9g43b2ga159gb1afef1447bd"
msgid "Gods. Why wasn't it me? Connor..."
msgstr "아, 차라리 내가 죽었더라면! 코너..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Player
#. NodeID = 646a1678-66d5-a4c6-34df-64e284df218c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - HAG_Hagspawn_Event_HasSummoningWand(2) = True
#. SetFlags:
#.   Object:
#.     - HAG_HagSpawn_Event_LockWand(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:646a1678-66d5-a4c6-34df-64e284df218c
msgctxt "h271e2db2g50cag47ccg8996g04455cb64ce6"
msgid "<i>Point the wand towards the grave. </i>"
msgstr "<i>마법봉을 무덤 쪽으로 가리킨다. </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Mayrina
#. NodeID = 65513923-6ce0-f34c-d058-6f2e923cfe9f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAG_Hagspawn_Event_WifeLeavesAlone = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:65513923-6ce0-f34c-d058-6f2e923cfe9f
msgctxt "hf72579c2g29f2g49e2g80f5g6c875a8ba431"
msgid "I thought you were going to help! I thought - I thought..."
msgstr "나는 당신이 도와줄 거라 생각했어! 나는 - 나는..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Player
#. NodeID = 658a25ce-9206-67e9-5e14-916c280d191a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:658a25ce-9206-67e9-5e14-916c280d191a
msgctxt "ha8185dc3g213fg4cb8gab55g74c88feba939"
msgid "Hold on - maybe it's not permanent."
msgstr "기다려봐. 이 상태가 영구적인 게 아닐 수도 있잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Mayrina
#. NodeID = 6812655c-84cd-d442-8a49-f9a65dfe4919
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:6812655c-84cd-d442-8a49-f9a65dfe4919
msgctxt "h9954aae8gb3fbg440fg8c60gaca885b62d81"
msgid "No! I won't let you put him back there."
msgstr "안 돼! 내 남편을 다시 묻게 두지 않겠어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Player
#. NodeID = 68cf345f-f72e-22fd-82bc-59ea0187cc79
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC_GOOD(2) = True
#. SetFlags:
#.   Global:
#.     - HAG_Hagspawn_Event_KillHusband = True
#.   Quest:
#.     - HAG_HagSpawn.FightJake(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:68cf345f-f72e-22fd-82bc-59ea0187cc79
msgctxt "h7b630976g8f8fg4541g9d4cg0c0309d704e1"
msgid "<i>Call on your god to smite the undead.</i>"
msgstr "<i>당신의 신의 힘으로 언데드를 강타한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Mayrina
#. NodeID = 6953f71d-820d-b939-b0be-f735c62532b5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:6953f71d-820d-b939-b0be-f735c62532b5
msgctxt "h7b253f4egd2dfg48fdg9c50g13bb1e7a6192"
msgid ""
"He got right up and pushed me back. I was so surprised that I just laughed. "
"He did too."
msgstr "그는 바로 일어서선 똑같이 절 밀어버렸죠. 저는 너무 놀라서 그냥 웃어버렸어요. 그도 그랬고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Mayrina
#. NodeID = 7120ab65-7ee4-4805-37cb-dcdd47b44012
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAG_SurrogateMother_HasMet_Resurrect(2) = False
#.   User:
#.      - HAG_HagSpawn_Knows_OfferedResurrectHusband(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:7120ab65-7ee4-4805-37cb-dcdd47b44012
msgctxt "he697b3fbg0ffbg4074g837egebf56cc5dd98"
msgid ""
"<i>Gods</i>, didn't hear you coming. I know I should head home, but I can't "
"bring myself to leave."
msgstr "<i>세상에</i>, 당신이 오는 소리를 못 들었어요. 집에 가야 한다는 건 알지만 도저히 떠날 수가 없어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Player
#. NodeID = 72093b52-ff8d-222c-87e9-c8ad357c159c
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAG_Hagspawn_Event_LeaveHusband = True
#.     - HAG_Hagspawn_Event_WifeHusbandLeave = True
#.   Object:
#.     - HAG_Hagspawn_Event_GiveSummoningWand(0) = True
#.   Quest:
#.     - HAG_HagSpawn.LeftHusband(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:72093b52-ff8d-222c-87e9-c8ad357c159c
msgctxt "ha4960940g4153g4ecdgae76g80210e0b06b5"
msgid "He's all yours - you'll need this wand."
msgstr "그러겠다면야 - 이 마법봉이 필요할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Mayrina
#. NodeID = 75ad71e0-10af-966b-c44d-77003ce73b57
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:75ad71e0-10af-966b-c44d-77003ce73b57
msgctxt "hf2bb267dg0c5fg49fcga297g5f18a8e9b7e6"
msgid "I wanted him back - back the way he was. Not <i>this</i>."
msgstr "내 남편이 원래 모습으로 돌아오길 원해요. <i>이런 것</i> 말고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Player
#. NodeID = 7693a8cd-e536-0e08-d1f0-c2550e99dffb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:7693a8cd-e536-0e08-d1f0-c2550e99dffb
msgctxt "h076c6eacge774g4482gba2cg0896c16bbd81"
msgid "So the hag fulfils her promise. It can never be simple, can it?"
msgstr "해그는 이런 식으로 약속을 지킬 셈이었군. 해그와의 계약이 단순할 리가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Mayrina
#. NodeID = 774a6acc-c0a4-0b2e-956a-78ab5551a531
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:774a6acc-c0a4-0b2e-956a-78ab5551a531
msgctxt "h404e8a3cg0266g45ebgb67ag9fbade400757"
msgid "But he might be. And if he is, I'll find him and bring him back."
msgstr "하지만 있을지도 몰라요. 있다면, 찾아내서 원래대로 돌려놓을 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Mayrina
#. NodeID = 79e606e2-d3ca-96b4-9fcb-2b3cc370cdec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:79e606e2-d3ca-96b4-9fcb-2b3cc370cdec
msgctxt "ha82edb54g2d88g4129g8d23gbcf2bd8c1c94"
msgid ""
"I promised him I'd fix this. And I'm gonna. Maybe - maybe someone in "
"Baldur's Gate can help us."
msgstr "제가 이 상태를 고치겠다고 그와 약속했어요. 그리고 고칠 거예요. 발더스 게이트에 있는 누군가가 우릴 도와줄지도 몰라요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Mayrina
#. NodeID = 79fcee41-1b92-b93a-cd1b-b752a058e793
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:79fcee41-1b92-b93a-cd1b-b752a058e793
msgctxt "hfb652686gd548g417dg853fgc9295d48d2fa"
msgid "I miss him. Every moment of every day. <i>Godsdammit. </i>"
msgstr "너무 그리워요. 매일, 매 순간. <i>이런 젠장. </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Mayrina
#. NodeID = 7a6303c8-3ef0-b8b4-a491-798d448dd09d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:7a6303c8-3ef0-b8b4-a491-798d448dd09d
msgctxt "h74233a56g2998g4caag88a6ge31e16ef4423"
msgid "No! Don't put him in the ground!"
msgstr "안 돼! 우리 그이를 땅속에 넣지 마요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Player
#. NodeID = 7c1de501-f361-07dd-8ae5-a4ecb4bc5b94
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_VLAAKITH or PALADIN_VLAAKITH
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:7c1de501-f361-07dd-8ae5-a4ecb4bc5b94
msgctxt "hdfb7e421g5d6dg4bfbgaff4gb425a4004e05"
msgid "You died as you lived - pathetically and without purpose."
msgstr "그대는 그대가 살 때와 같이 죽었노라, 한심하고도 무의미하게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Mayrina
#. NodeID = 7cd5dbbc-7664-436f-197a-7a386c18d783
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:7cd5dbbc-7664-436f-197a-7a386c18d783
msgctxt "h2359e0bcgb192g4c87g9ca2gc799556355bc"
msgid "Connor always said you can find anything in that city. Remember?"
msgstr "코너는 항상 그 도시에서 뭐든 찾을 수 있다고 했어요. 기억나요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Player
#. NodeID = 810edd13-74e6-6f55-2294-514581d8b150
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_EILISTRAEE or PALADIN_EILISTRAEE
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:810edd13-74e6-6f55-2294-514581d8b150
msgctxt "hadba5087ge72fg442agbfa4g1740b1d24caf"
msgid "May you dance beneath the boughs - happy and free."
msgstr "그대가 가지 아래에서 행복히, 자유로이 춤추기를."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Player
#. NodeID = 826e3a20-92ac-f2f1-4dd1-555b20d76034
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAG_Hagspawn_Event_RecruitHusband = True
#.   Quest:
#.     - HAG_HagSpawn.TookHusband(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:826e3a20-92ac-f2f1-4dd1-555b20d76034
msgctxt "h1fb72a59gc5e7g4c20gb6a2g88741c80bfd1"
msgid "Don't worry - I have the wand. I'll make use of him."
msgstr "걱정 마. 마법봉이 있잖아. 내 마음대로 부릴 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Player
#. NodeID = 841b987d-baf9-b1a6-e475-0cf14fc0f73d
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_GOOD or PALADIN_GOOD
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:841b987d-baf9-b1a6-e475-0cf14fc0f73d
msgctxt "hce52ccbbg5f9eg481dgbc89g16c5984d1b63"
msgid ""
"<i>Quietly whisper a blessing for protection. May Mayrina and her child "
"suffer no harm.</i>"
msgstr "<i>조용히 보호의 축복을 속삭인다. 메이리나와 그 아이가 고통 받지 않기를.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Mayrina
#. NodeID = 85dd575a-0f41-0cce-5023-5b8d7fd4d740
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:85dd575a-0f41-0cce-5023-5b8d7fd4d740
msgctxt "h52630298g3ae6g4efbgb4d0gc77716cffaac"
msgid "What - what's happening? Why is he still dead?"
msgstr "무슨... 어떻게 된 거예요? 왜 그이가 아직 죽은 상태인 거죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Player
#. NodeID = 86060ce6-099f-a49a-f89c-983a1143dd30
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:86060ce6-099f-a49a-f89c-983a1143dd30
msgctxt "hcdd8fe3dg08cfg4695g910fga46bd1306c40"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Player
#. NodeID = 88c857d0-b508-d533-1586-0c6869624bf1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:88c857d0-b508-d533-1586-0c6869624bf1
msgctxt "h2d5efe7eg1589g4295g9646g15a2ecb429c5"
msgid "We can always bury him again."
msgstr "언제든지 그를 다시 묻어줄 수 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Player
#. NodeID = 96c3ac78-4e30-13d0-c8ae-b2c7a5318602
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - HAG_Hagspawn_Event_HasSummoningWand(2) = True
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#. SetFlags:
#.   User:
#.     - HAG_HagSpawn_Knows_OfferedResurrectHusband(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:96c3ac78-4e30-13d0-c8ae-b2c7a5318602
msgctxt "h82e24d07g9ab8g4ed9gbeddgabb4d0fff57b"
msgid "I found a wand - I think I can resurrect your husband."
msgstr "마법봉 하나를 찾았어. 이걸로 당신 남편을 소생시킬 수 있을 것 같은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Mayrina
#. NodeID = 9ae46216-4fe8-582d-5240-1b1b9b0c7be3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:9ae46216-4fe8-582d-5240-1b1b9b0c7be3
msgctxt "h63161c34g8b71g4457gb39bg29653ac5b9b7"
msgid "But this isn't what she promised!"
msgstr "하지만 이건 그 여자가 약속한 게 아니에요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Mayrina
#. NodeID = 9c062a07-2670-bed3-d6d6-3036828f4662
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:9c062a07-2670-bed3-d6d6-3036828f4662
msgctxt "hdab8eabfg3881g4e5dga168g55c6071613f8"
msgid "You don't know that. He - he could still be in there. And I gotta try."
msgstr "아직 모를 일이에요. 그... 그이의 일부가 몸 안에 남아 있을지도 모른다구요. 방법을 찾고 말겠어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Player
#. NodeID = 9f0f5cad-0141-6439-a229-0f15363c7a15
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:9f0f5cad-0141-6439-a229-0f15363c7a15
msgctxt "hda48d563g6a89g40f6gb886ge6deec5ef89c"
msgid "You could just leave him here."
msgstr "이곳에 그를 남겨두고 갈 수도 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Mayrina
#. NodeID = 9fdcaad8-5783-41c9-5b3f-3bb4a0570c44
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:9fdcaad8-5783-41c9-5b3f-3bb4a0570c44
msgctxt "h9b00349cg5770g44d0ga553g1abfc7ed09cf"
msgid "No. This is my fault. And I'm - I'm gonna fix it."
msgstr "아니에요. 이건 제 잘못이에요. 그리고 제가 - 제가 이 상태를 고칠 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Player
#. NodeID = a13ced00-9968-2a71-8022-0599523fe5d8
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_MYRKUL or PALADIN_MYRKUL
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:a13ced00-9968-2a71-8022-0599523fe5d8
#, fuzzy
msgctxt "h5c7b1c74gf833g4b95gb3efg3aeaedb48e44"
msgid ""
"Chaff for the Reaper's harvest. May his bleached bones march in your host, "
"great Myrkul."
msgstr "사신의 수확에 쭉정이라. 그의 희어진 뼈가 그대 앞에 행진하게 하소서, 위대하신 머큘이시여."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Mayrina
#. NodeID = a14bad9d-9c7c-7f3c-e119-068303679f33
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:a14bad9d-9c7c-7f3c-e119-068303679f33
msgctxt "h51bf887dg9c5cg4640ga7ddgc9055a5ee8c2"
msgid "I'm sorry. I'm sorry I couldn't bring you back."
msgstr "미안해요. 당신을 살려내지 못해서 미안해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Mayrina
#. NodeID = a2fb9eb8-c8a6-6dfe-3a88-3237b4b8468e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAG_Hagspawn_State_SurrogateKnowsKilledBrothers(2) = True
#. SetFlags:
#.   Global:
#.     - HAG_Hagspawn_State_MayrinaLostEverything = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:a2fb9eb8-c8a6-6dfe-3a88-3237b4b8468e
msgctxt "h12f32523g10d6g4866ga03fg5d37d0d6f066"
msgid "No! You monster! I - I won't let you!"
msgstr "안돼! 이 괴물 자식! 그- 그러게 두진 않아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Mayrina
#. NodeID = a4b15af2-3bfc-3065-dd41-0f14694f062c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:a4b15af2-3bfc-3065-dd41-0f14694f062c
msgctxt "h32e1b50fg920cg487ega8b2g446dda75a20f"
msgid "Not even a little bit. But I will be."
msgstr "조금도 괜찮지 않아요. 언젠간 나아지겠죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Mayrina
#. NodeID = a61b23bb-a3c6-89d9-6bd6-b05a6ba516d8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:a61b23bb-a3c6-89d9-6bd6-b05a6ba516d8
msgctxt "h98aaf30cgef88g4334gabbcg8b6de033a620"
msgid ""
"<i>No.</i> He deserves a proper burial. He deserves some <i>rest</i>. And he "
"won't get that here."
msgstr "<i>안 돼요.</i> 그를 적절히 묻어줘야 해요. 그는 <i>잠들</i> 자격이 있어요. 여기서는 잠들 수 없잖아요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Mayrina
#. NodeID = a9ae3a7b-3add-ac4f-319f-33efaf6cefa2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:a9ae3a7b-3add-ac4f-319f-33efaf6cefa2
msgctxt "hb26a7d3bgf3d2g4871ga9c5g52e52c99310e"
msgid ""
"I'll find a wizard or something. Maybe someone in Baldur's Gate can help us."
msgstr "위저드나 뭐 그런 걸 찾아야겠어요. 발더스 게이트엔 도와줄 수 있는 사람이 있을지도 몰라요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Player
#. NodeID = a9e4ccc4-71f7-de73-b689-1edb4ca5fee2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:a9e4ccc4-71f7-de73-b689-1edb4ca5fee2
msgctxt "ha7d4e9dfg55f2g46dbg9e4fg512e189b3058"
msgid "Are you all right?"
msgstr "괜찮아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Player
#. NodeID = aa8c8a16-83b0-25f4-d1e7-3bd4a628ba41
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:aa8c8a16-83b0-25f4-d1e7-3bd4a628ba41
msgctxt "h8485c119g75feg460egb5c8g5c911c99d4d4"
msgid "This is your husband - do you want him or not?"
msgstr "이게 당신의 남편이야. 그를 원해, 원치 않아?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Player
#. NodeID = aabf10d1-d10c-6cd6-0ab9-5ecd08263b11
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAG_Hagspawn_Event_LeaveHusband = True
#.     - HAG_Hagspawn_Event_WifeHusbandLeave = True
#.   Object:
#.     - HAG_Hagspawn_Event_GiveSummoningWand(0) = True
#.   Quest:
#.     - HAG_HagSpawn.LeftHusband(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:aabf10d1-d10c-6cd6-0ab9-5ecd08263b11
msgctxt "h45c90485g97e1g417eg9e57g6ff0ea928f64"
msgid "Are you sure you want to do this?"
msgstr "정말 그러고 싶나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Player
#. NodeID = aedb21c6-51b4-27ca-1aab-c3d92ce66341
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_HELM or PALADIN_HELM
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:aedb21c6-51b4-27ca-1aab-c3d92ce66341
msgctxt "h133cb92egb2aag4b70gb20fgaf7b4325bc31"
msgid "A beloved husband and father - his vigil is ended, great Guardian."
msgstr "사랑받는 남편이자 아버지였던 이의 보호가 끝을 맞이합니다, 위대한 수호자시여."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Player
#. NodeID = b31df786-ed64-aaca-5a2a-081d6c98aae7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC_LOLTH(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:b31df786-ed64-aaca-5a2a-081d6c98aae7
msgctxt "he7ab2601g0e53g4ebbg9f4eg90078becf6c7"
msgid "Vermin dies as vermin lived. Good riddance."
msgstr "해충이 살듯 해충이 죽었네. 잘 되었구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Mayrina
#. NodeID = b44aa9fd-12b3-e5a1-0333-44ab59327ccf
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - HAG_Hagspawn_State_MayrinaAngry(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:b44aa9fd-12b3-e5a1-0333-44ab59327ccf
msgctxt "h74636e27gb477g46deg877egf2ae0f130317"
msgid "Get away from us. <i>Now. </i>"
msgstr "꺼져요. <i>당장. </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Player
#. NodeID = b5ffe9e6-669b-5f72-e4dc-6108ea346705
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:b5ffe9e6-669b-5f72-e4dc-6108ea346705
msgctxt "h40ff2f3ag4777g4059g81b6g488f0e9b44a0"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Mayrina
#. NodeID = b6298198-1518-31a7-7532-d7f30f852fff
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:b6298198-1518-31a7-7532-d7f30f852fff
msgctxt "hce779fbfg7a1ag432dgba40ge980151ddba8"
msgid "And thank you. I guess."
msgstr "그리고 고마워요. 확실치는 않지만요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Mayrina
#. NodeID = b89c7258-24e3-362d-b03b-b5b3fc57bca7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAG_Hagspawn_State_SurrogateKnowsKilledBrothers(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:b89c7258-24e3-362d-b03b-b5b3fc57bca7
msgctxt "hf0233d43ga40eg4b47g917bg82b5cd96c572"
msgid "You bastard! Give him back!"
msgstr "이 개자식! 그를 돌려줘!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Mayrina
#. NodeID = c26030bf-f0f8-371b-ae81-88c0d9ae0613
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:c26030bf-f0f8-371b-ae81-88c0d9ae0613
msgctxt "hfb690155g0d34g41d3gafedg080ddc6d5a30"
msgid ""
"We were just kids when we met. Heh. I might have pushed him off a swing I "
"wanted."
msgstr "저희가 처음 만났을 땐 그저 꼬마들이었어요. 헤. 제가 그네를 타고 싶을 때면 그를 그네에서 밀어버리곤 했죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Player
#. NodeID = c3271296-73ab-c804-8dac-7dcd8741f2f3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - CLERIC_GOOD(2) = False
#. SetFlags:
#.   Global:
#.     - HAG_Hagspawn_Event_KillHusband = True
#.   Quest:
#.     - HAG_HagSpawn.FightJake(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:c3271296-73ab-c804-8dac-7dcd8741f2f3
msgctxt "h1005a83cg788eg4daag99a4g2b14ad2229eb"
msgid "<i>Kill the undead abomination.</i>"
msgstr "<i>언데드 흉물을 죽여버린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Mayrina
#. NodeID = c3dc668e-696e-8cf3-3ec6-aac7060a3ada
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:c3dc668e-696e-8cf3-3ec6-aac7060a3ada
msgctxt "h833846f2gc09fg43aeg85aag910beb8163b2"
msgid "Connor? CONNOR!"
msgstr "코너? 코너!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Player
#. NodeID = c65b78c3-74ac-e7a9-5209-bcde24749fe9
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_NEUTRAL or PALADIN_NEUTRAL
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:c65b78c3-74ac-e7a9-5209-bcde24749fe9
msgctxt "hf5762341g347dg445bga0a0ga818d97f5f91"
msgid ""
"Where there is peace, may you have it. Where there is comfort, may those you "
"love know it."
msgstr "평화가 있는 곳에, 그대가 있기를. 평안이 있는 곳에, 그대가 사랑하는 이들이 있기를."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Player
#. NodeID = c7ea474f-4835-3e6b-f792-ee0adf3ae6d8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - HAG_Hagspawn_Event_KillHusband = True
#.   Quest:
#.     - HAG_HagSpawn.FightJake(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:c7ea474f-4835-3e6b-f792-ee0adf3ae6d8
msgctxt "h081e91f7g2324g4bd8g841dg80a6bf918342"
msgid "He's already dead. Don't get in my way."
msgstr "이자는 이미 죽었어. 날 방해하지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Player
#. NodeID = caf74d98-2667-ac30-3209-9b30873cb4e4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:caf74d98-2667-ac30-3209-9b30873cb4e4
msgctxt "h494acdcbg9969g4a41ga1d2g5e1af31ccdad"
msgid "<i>Leave her to mourn. </i>"
msgstr "<i>그녀가 슬퍼하도록 내버려둔다. </i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Player
#. NodeID = d69172f5-f72a-5862-b864-646ab5ed541f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:d69172f5-f72a-5862-b864-646ab5ed541f
msgctxt "h5c416660gbbd3g4081gac0cg5f1523d80eb6"
msgid "Here's the wand. Good luck to you and Connor."
msgstr "마법봉 여기 있어. 당신과 코너에게 행운을 빌게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Mayrina
#. NodeID = d6b55f67-0f82-1978-7bd0-49d8242bdc1b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:d6b55f67-0f82-1978-7bd0-49d8242bdc1b
msgctxt "ha98d1e4bgab6fg4a3dg881dgdfc05042d9cc"
msgid "Thank you."
msgstr "고맙습니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Mayrina
#. NodeID = def881d3-7a66-40e2-de24-cfd2821f9e8a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - HAG_HagSpawn_Event_LockWand(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:def881d3-7a66-40e2-de24-cfd2821f9e8a
msgctxt "hbe003e71gef69g4c14gbb16gb016e8084ff5"
msgid "What? You can?"
msgstr "뭐라고요? 그럴 수 있어요?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Mayrina
#. NodeID = e2c1a98c-d134-500b-30c8-bd3f882907d0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAG_SurrogateMother_HasMet_Resurrect(2) = True
#.   User:
#.      - HAG_HagSpawn_Knows_OfferedResurrectHusband(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:e2c1a98c-d134-500b-30c8-bd3f882907d0
msgctxt "h80ef3ce3gbaf7g43c1g84d4gfa5ed624cfa7"
msgid ""
"I can't believe it didn't work. That all of this was for <i>nothing</i>."
msgstr "통하지 않았다는 게 믿기지 않아. 이 모든 게 <i>헛수고</i>였다니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Player
#. NodeID = e4c20db7-de1d-ad42-c3d1-fe5a332f69c5
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: CLERIC_SHAR or PALADIN_SHAR
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:e4c20db7-de1d-ad42-c3d1-fe5a332f69c5
msgctxt "hc329e1d0g7626g4971gbbf1g02e6eb3b549c"
msgid ""
"Wife without husband, child without father - Dark Lady, two more know the "
"loss of your embrace."
msgstr "남편 없는 아내, 아버지 없는 아이. 어둠의 여신이시여, 이 둘이 그대의 포옹의 상실을 알게 하소서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Mayrina
#. NodeID = e7b83dbd-ca0d-1721-f5db-d339d08bd262
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:e7b83dbd-ca0d-1721-f5db-d339d08bd262
msgctxt "h67d45d21g5439g49c6gbdfag34efe296f9e5"
msgid "Thanks, but we'll need more than luck. A bloody miracle more like it."
msgstr "고마워요, 그런데 저희한테는 행운보다 더 한 게 필요할 거 같네요. 어마 무시한 기적 같은 거 말이죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Player
#. NodeID = e852af98-7ad1-d684-22ca-fbda25f79636
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:e852af98-7ad1-d684-22ca-fbda25f79636
msgctxt "hc19830e3g6349g4557ga49dg3c48a5fac479"
msgid "Huh. The creature's bound to this wand. How useful."
msgstr "허. 이 괴물이 마법봉에 결속돼있어. 유용하겠는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Mayrina
#. NodeID = eb146689-c239-9a36-d84c-3d631e232f92
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAG_SurrogateMother_HasMet_Resurrect(2) = False
#.      - HAG_Hagspawn_State_MayrinaAngry(2) = True
#.   User:
#.      - HAG_HagSpawn_Knows_OfferedResurrectHusband(2) = False
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:eb146689-c239-9a36-d84c-3d631e232f92
msgctxt "h08863504g4b75g4388gb76dgfa159bb1d37b"
msgid "Gods, don't creep up on people."
msgstr "깜짝이야, 사람 놀래키지 좀 마요. "

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband
#. Speaker = Mayrina
#. NodeID = ee279746-8796-afad-dcf1-313262b55c88
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_2 = True
#.   User:
#.      - HAG_HagSpawn_Knows_OfferedResurrectHusband(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Swamp/Hag_Hagspawn_ResurrectHusband:ee279746-8796-afad-dcf1-313262b55c88
msgctxt "h9b3b0864g1b3dg47fagabe1g49b06563cb0b"
msgid ""
"You said you can resurrect my husband? Bring him back. Bring Connor back. "
"<i>Please.</i>"
msgstr "제 남편을 살릴 수 있다고 했죠? 그를 되살려줘요. 코너를 되살려주세요. <i>제발요.</i>"

