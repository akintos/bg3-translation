msgctxt "h3fedac6eg4000g43faga55ag64e2d8960ad2"
msgid "You snarl, but you have no teeth."
msgstr "으르렁대고 있지만, 실속은 없네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Scratch
