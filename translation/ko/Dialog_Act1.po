msgctxt "h4bfb2c3fg454dg48c7ga286g561a2c3620ca"
msgid "*Growl.*"
msgstr "*으르렁.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DeepHole
#. Speaker = Voice from the Deep Hole
#. NodeID = 8d2ea87f-d609-db76-57f5-3387bf57220c
