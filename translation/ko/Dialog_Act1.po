msgstr "<i>문의 잠금 장치를 해제한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_TavernInvestigation_DesireDoor
#. Speaker = Counsellor Florrick
#. NodeID = eb73a54c-0856-92d8-e386-d395f2174e30
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_Desire_Quest_LockedDoorKey = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_TavernInvestigation_DesireDoor:eb73a54c-0856-92d8-e386-d395f2174e30
msgctxt "h407473cbg420eg4a2dgb114gdfab63fd18b2"
msgid "The key must be with the innkeep. Please - hurry!"
msgstr "여관주인에게 열쇠가 있을 겁니다. 제발 - 서두르세요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_TavernInvestigation_DesireDoor
#. Speaker = Player
#. NodeID = eca03641-6457-bcd6-c38e-dc3d2a95218f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_TavernInvestigation_DesireDoor:eca03641-6457-bcd6-c38e-dc3d2a95218f
msgctxt "hd0cc4ed8gc730g490cgbdd0g91616f55283a"
msgid "<i>Charge at the door.</i>"
msgstr "<i>문으로 돌진한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_TavernInvestigation_DesireDoor
#. Speaker = Counsellor Florrick
#. NodeID = fddc83b7-d324-e256-addf-970ba0d9399a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_TavernInvestigation_DesireDoor:fddc83b7-d324-e256-addf-970ba0d9399a
msgctxt "hf77d49b1g9a6ag4f36ga5e4g7bf08ead012e"
