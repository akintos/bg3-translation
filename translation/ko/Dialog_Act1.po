msgctxt "h530ef867g363cg4419g9a5eg1bbd185eb9c8"
msgid "She's not here. Maybe she's all right."
msgstr "여기 없구나. 괜찮을지도 몰라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_AD_ToWife
#. Speaker = Benryn
#. NodeID = fdf573b0-5a8f-b5c4-606f-be9562def67a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - PLA_StuckHalfElf_State_ReachedWifeBox(0) = False
