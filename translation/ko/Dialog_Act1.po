msgctxt "hc8d49216gccefg4fc2gb186g4ce540a5f2a1"
msgid "A statue of Selûne. This ruin must have been dedicated to her."
msgstr "셀루네의 조각상이야. 이 폐허는 그녀를 위한 신전이었나 보네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/VBs/GOB_ShadowHeart_VB_Temple
#. Speaker = Shadowheart
#. NodeID = 103c6d37-cb1a-d27c-5119-f1b19ae156b2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Shadowheart_State_RecogniseSeluneTemple = True
#.      - ShadowHeart_InParty_Knows_SharWorshipper = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/VBs/GOB_ShadowHeart_VB_Temple:103c6d37-cb1a-d27c-5119-f1b19ae156b2
msgctxt "h0b2c539dg60ffg4661g9f38gba0b2555a816"
msgid "More vile idolatry. Makes my stomach turn."
msgstr "불쾌한 우상들이 더 있군. 역겨움에 배가 아파질 정도야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/VBs/GOB_ShadowHeart_VB_Temple
#. Speaker = Shadowheart
#. NodeID = 1121558e-db2c-ed9a-6e7a-87bf330faa37
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
