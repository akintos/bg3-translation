msgctxt "hf58fd5dcg8e33g4e71ga3c2g7df7d53f3c3a"
msgid "I see tracks there - or footprints. That's worth a look."
msgstr "여기 흔적이 보여, 발자국일지도. 한번 살펴봐야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_ThullaHint_SurvivalCheck_PAD
#. Speaker = Player
#. NodeID = 6425661c-45c8-ae57-71f6-6b57423098a0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
