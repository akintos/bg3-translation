msgctxt "h073ff66cg8ba5g42e2ga6c8g6719d98ff48c"
msgid "You're going to pay for that!"
msgstr "넌 대가를 치를거야!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_General_MageHandMain
#. Speaker = Zel'i
#. NodeID = b85cace9-3066-ccfe-3a21-785e0dbfd863
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: MALE
