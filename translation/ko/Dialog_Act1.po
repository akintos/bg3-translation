msgid "Timmask and torchstalks. Hell of a combination."
msgstr "티마스크와 횃불줄기야. 환상적인 조합이네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_PAD_MushroomClearingNatureCheck
#. Speaker = Player
#. NodeID = 13d0a619-d055-5e6e-584c-389a4c3314a2
#. HandlePath = TaggedText[0].TagText[0]
