msgctxt "h0745069dg3b89g4308g9e36g1409c968b19f"
msgid "What were you doing here?"
msgstr "여기서 뭘 하고 있었지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7_Dead
#. Speaker = Gauntlet Dain
#. NodeID = 94f74c97-1801-4faf-9f35-ddbb60e4b23c
