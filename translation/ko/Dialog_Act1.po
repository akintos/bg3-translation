msgctxt "hde0c0169g8c46g4c6eg8b4ag822014805e78"
msgid ""
"We slay Karlach, and we save these souls from eternal damnation. Justice "
"will be served."
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Tollhouse_PAD_RefugeesAreCultists
#. Speaker = Player
#. NodeID = d628960c-fc12-4ec4-9694-d55a62988217
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_LAEZEL
