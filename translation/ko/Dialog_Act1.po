#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_AlarmUsedReaction:773deb47-364c-7f4e-5cb5-9ad5b81b6512
msgctxt "hc7939b2fgf81fg4dcfgb2cdg2ed15a5c6c0d"
msgid "Still got it, True Soul! Must be all that practice you're doin', heh."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_AlarmUsedReaction
#. Speaker = Sentinel Olak
