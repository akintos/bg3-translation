#. CheckFlags:
#.   Global:
#.      - FOR_SeluneStash_State_KnowShrineCheckSuccess = True
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_NoticeShrine:bed9db99-9a77-2def-4952-17de1d7364b8
msgctxt "h06d3a531gfc42g4c51g90b3g93fada72e9c2"
msgid "I'll be damned - a shrine to Selûne."
msgstr "이런 망할, 셀루네의 성소잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_SeluneStash_PAD_NoticeShrine
#. Speaker = Player
#. NodeID = bed9db99-9a77-2def-4952-17de1d7364b8
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
