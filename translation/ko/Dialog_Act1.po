msgctxt "he48fe645g8fc4g4a5cgb2ceg56fc62633119"
msgid "Back on your feet, or I'll bite your toes off, one by one!"
msgstr "일어서, 아니면 너희 발가락을 하나씩 뜯어주겠어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_DuergarGuardSergeant_AD
#. Speaker = Sergeant Thrinn
#. NodeID = 4a6f3f46-ac2c-f6d4-6b17-51a5d6255fde
