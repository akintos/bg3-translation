#. NodeID = 10603d7b-344a-57ab-c64e-8fa86a2ffb6c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 7131b9d6-232d-f988-7cff-7d1630dce3c5_DoctorTakesPart = False
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:10603d7b-344a-57ab-c64e-8fa86a2ffb6c
msgctxt "h4bf54078gfc71g4848g9529g12ecc57a4563"
msgid ""
"Damn it all! What has the <i>zaith'isk</i> torn from me? My Queen, why do "
"you forsake me?"
msgstr "빌어먹을! <i>제이트이스크</i>가 내게서 뭘 뜯어내 버린 거지? 나의 여왕이시여, 어찌하여 저를 저버리십니까?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Narrator
#. NodeID = 178a17c5-a8c8-fdc4-a078-4aea625f569b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_GithInfirmary_Event_KnowsZaithiskKills = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:178a17c5-a8c8-fdc4-a078-4aea625f569b
msgctxt "h0201a4f6ge541g47d7g8136g163dd598fe58"
msgid ""
"*Your life is laid bare among those that came before. Your innermost "
"thoughts are turned to silver thread and relayed to the Astral Sea.*"
msgstr "*당신의 삶이 선조들 사이에 드러나 있습니다. 가장 깊은 생각이 은빛 실로 바뀌고 '아스트랄 바다'로 전달됩니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Ghustil Stornugoss
#. NodeID = 18dc081d-6e33-d3ad-763a-984b29790022
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:18dc081d-6e33-d3ad-763a-984b29790022
msgctxt "h09c2bb34g0b08g4508gb851g18fe523f2886"
msgid "My life's work... gone."
msgstr "내 필생의 역작이... 사라지다니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Player
#. NodeID = 192a7784-b9df-e8ee-fd69-588a606a0950
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SavingThrow
#. RollAbility: Wisdom
#. DifficultyClass: 18
#. TagRule: MONK
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:192a7784-b9df-e8ee-fd69-588a606a0950
msgctxt "hc647b4aag4183g40b7g8029g00a1245e6736"
msgid "<i>Channel your ki. Flood the creature with your essence.</i>"
msgstr "<i>기를 발산한다. 당신의 정수로 올챙이를 가득 채운다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Player
#. NodeID = 192a7784-b9df-e8ee-fd69-588a606a0950
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SavingThrow
#. RollAbility: Wisdom
#. DifficultyClass: 18
#. TagRule: DRUID
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:192a7784-b9df-e8ee-fd69-588a606a0950
msgctxt "h2b9e3c84g6c40g491ag9e3egeff486bdad6d"
msgid "<i>Seek the tadpole's essence. Flood it with power.</i>"
msgstr "<i>올챙이의 정수를 찾아내, 힘으로 가득 채운다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Player
#. NodeID = 192a7784-b9df-e8ee-fd69-588a606a0950
#. HandlePath = TaggedText[2].TagText[0]
#. RollType: SavingThrow
#. RollAbility: Wisdom
#. DifficultyClass: 18
#. TagRule: CLERIC
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:192a7784-b9df-e8ee-fd69-588a606a0950
msgctxt "h94713a4dg8708g4aacg97e3g17d13f7624d1"
msgid "<i>Pray for deliverance. Flood the creature with divine power.</i>"
msgstr "<i>구원을 기도한다. 올챙이를 신성한 힘으로 가득 채운다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = GROUP_Daisy
#. NodeID = 1a16180d-ac5b-87a0-405c-4ee8c2678456
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: DAISY_MALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:1a16180d-ac5b-87a0-405c-4ee8c2678456
msgctxt "h2290e6e3gb22fg4dbfg97e3g63812808f947"
msgid "<i>Enough.</i>"
msgstr "<i>그만.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = GROUP_Daisy
#. NodeID = 1a16180d-ac5b-87a0-405c-4ee8c2678456
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: DAISY_FEMALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:1a16180d-ac5b-87a0-405c-4ee8c2678456
msgctxt "h2741ac10gbcf6g4af9gb7c4g5e003264f540"
msgid "<i>Enough.</i>"
msgstr "<i>그만.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Narrator
#. NodeID = 1b5c0c2f-6998-8204-ed9a-76656e65f535
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:1b5c0c2f-6998-8204-ed9a-76656e65f535
msgctxt "ha09fbe97g58e7g4342g9482g03b765761b70"
msgid ""
"*Her voice cuts with a fanatical edge - an obsession bordering on mania. If "
"there's a chance the parasite lives, she wants it.*"
msgstr ""
"*그녀의 목소리가 광기로 날이 서 있습니다. 강박에 가까운 집착이 느껴집니다. 올챙이가 살아있다는 걸 안다면, 가지길 원할 것입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Ghustil Stornugoss
#. NodeID = 1ba0cbbb-8194-0b3d-1dbf-bfdf78487e24
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:1ba0cbbb-8194-0b3d-1dbf-bfdf78487e24
msgctxt "h12566d41g9bd6g4cd2g9822g085b58a12e72"
msgid "Yes, child! Face her will!"
msgstr "그래, 아이여! 여왕님의 의지를 직면해라!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Narrator
#. NodeID = 1cec64ee-8bd1-6bf6-97e8-f426c8c327a4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_GithInfirmary_State_UsedDevice = True
#.   Object:
#.     - CRE_GithInfirmary_State_CharacterUsedDevice(2) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:1cec64ee-8bd1-6bf6-97e8-f426c8c327a4
msgctxt "hb1a3c7bfg51e9g431eg8c0fg4c690dea5e9f"
msgid ""
"*Layers of magic weave themselves tightly around your head. The tadpole "
"squirms and contracts. It's trying to <i>hide</i>.*"
msgstr "*마법적인 위브가 한 꺼풀 한 꺼풀 머리 주위를 감쌉니다. 올챙이가 몸부림치며 쪼그라듭니다. <i>숨으려는</i> 겁니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Narrator
#. NodeID = 1d746675-fc61-f4dc-969e-8ddde5051253
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CRE_GithInfirmary_Event_DamageBrainINT(2) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:1d746675-fc61-f4dc-969e-8ddde5051253
msgctxt "h35ab1ae8gaf69g4d11ga3b9g068d67542d70"
msgid ""
"*The machine lashes out aimlessly. Your right temple burns, then numbs. Part "
"of you is gone - a part you can no longer recall.*"
msgstr ""
"*장치가 분별 없이 목표물을 강타합니다. 당신의 우측 관자놀이가 불타오르고 마비됩니다. 당신의 일부가 사라져버렸습니다 - 다시는 되찾을 "
"수 없습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Ghustil Stornugoss
#. NodeID = 1fe58f44-d757-6f3d-5ad7-eeb5d24a6170
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_GithInfirmary_State_DoctorWaitsAtDevice = True
#.   Local:
#.      - 7131b9d6-232d-f988-7cff-7d1630dce3c5_WrongPlayerInDeviceRepeated = True
#.   Object:
#.      - CRE_GithInfirmary_State_DoctorIsExpectingCharacter(2) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:1fe58f44-d757-6f3d-5ad7-eeb5d24a6170
msgctxt "h0d8f3015g297bg492egba0cg5954d19f412b"
msgid "My time is not yours to waste. Do you have a tadpole or not?"
msgstr "내 시간을 낭비하게 하지 마라. 네 몸에 올챙이가 있나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Player
#. NodeID = 2187d26c-2fdb-cb5f-2384-26593b07d67b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:2187d26c-2fdb-cb5f-2384-26593b07d67b
msgctxt "hd5e45ba9g4a08g4440gb14cg34ed24a4d27d"
msgid "<i>Succumb to the machine.</i>"
msgstr "<i>기계에 굴복한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Player
#. NodeID = 21e78c64-c33a-4f27-9d6a-abeee33d9011
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_GithInfirmary_State_UsedDevice = False
#.   Tag:
#.      - AVATAR(2) = False
#.      - REALLY_LAEZEL(2) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:21e78c64-c33a-4f27-9d6a-abeee33d9011
msgctxt "h41f4c927g34a4g496dgabdeg5f8fd565cb29"
msgid "The <i>zaith'isk</i>. Vlaakith's purity, distilled. My duty. My right."
msgstr "<i>제이트이스크</i>. 블라키스 님의 순수함이여. 정화는 나의 의무이자 나의 권리이니."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Player
#. NodeID = 239fbeab-b8ca-7313-194a-cce000975f2e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 7131b9d6-232d-f988-7cff-7d1630dce3c5_DoctorTakesPart = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:239fbeab-b8ca-7313-194a-cce000975f2e
msgctxt "hca5454ecge7d2g4756gbf81g8ab18eb1d314"
msgid "Will it hurt me?"
msgstr "이걸로 다칠 수도 있나?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = GROUP_Daisy
#. NodeID = 23b5fb12-6b54-4ed8-9053-75fb46c3a6aa
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_GithInfirmary_State_DaisyIntervened = True
#. TagRule: DAISY_MALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:23b5fb12-6b54-4ed8-9053-75fb46c3a6aa
msgctxt "h85e3e610ge1a5g4058gbb0ag351ea1d42b50"
msgid "No. No more."
msgstr "그만. 더는 안 됩니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = GROUP_Daisy
#. NodeID = 23b5fb12-6b54-4ed8-9053-75fb46c3a6aa
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_GithInfirmary_State_DaisyIntervened = True
#. TagRule: DAISY_FEMALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:23b5fb12-6b54-4ed8-9053-75fb46c3a6aa
msgctxt "hf30fb3c1ge26dg476ega1a9g21662dba2b67"
msgid "No. No more."
msgstr "그만. 더는 안 돼요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Narrator
#. NodeID = 26db78ca-48b3-0b86-3bc0-b83178e64f37
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CRE_GithInfirmary_Event_GainNewPower(2) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:26db78ca-48b3-0b86-3bc0-b83178e64f37
msgctxt "h8a322cbag27e3g4423gac1age6fc98557a33"
msgid ""
"*Your body is a leaden husk, abandoned as you drift along the threads into "
"the darkness. Death awaits.*"
msgstr "*어둠 속으로 이어지는 실을 따라 떠내려 갑니다. 당신의 몸은 무기력하게 버려진 껍데기입니다. 죽음이 기다립니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Narrator
#. NodeID = 27d020c1-26c8-95cd-6d48-d8c9d16a5657
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:27d020c1-26c8-95cd-6d48-d8c9d16a5657
msgctxt "h34001d62g1d8fg4721gbfc1g259913948ae3"
msgid ""
"*You feel joints breaking, your blood vessels rupturing. Your body crumples. "
"Your heart shudders.*"
msgstr "*관절이 부러지고, 혈관이 파열되는 것이 느껴집니다. 전신이 일그러지고, 심장이 전율합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Narrator
#. NodeID = 2821e803-11f8-aae3-d895-b393b6be4ec5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:2821e803-11f8-aae3-d895-b393b6be4ec5
msgctxt "h4ce26866ge199g402cg93c0gd01c20a0c912"
msgid "*You feel your parasite stir.*"
msgstr "*머릿속 기생충의 떨림이 느껴집니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Ghustil Stornugoss
#. NodeID = 2a63bfca-1f6d-9781-ee11-293070cba994
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:2a63bfca-1f6d-9781-ee11-293070cba994
msgctxt "h8488afebgdf9eg4060gad67gf27fdb69446f"
msgid "No - NO. The <i>zaith'isk... </i>What have you done?"
msgstr "안 돼, 안 돼! <i>제이트이스크</i>가... 무슨 짓을 한 거냐?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Narrator
#. NodeID = 2ac00a03-6ac8-e714-0ed2-541959016c86
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 7131b9d6-232d-f988-7cff-7d1630dce3c5_DoctorTakesPart = True
#.      - 7131b9d6-232d-f988-7cff-7d1630dce3c5_FailedMindRoll = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:2ac00a03-6ac8-e714-0ed2-541959016c86
msgctxt "hc19a6eb8gd973g4356gbdd2g1b87ffd3bbbc"
msgid ""
"*The room swims back into focus. You are intact, but no longer whole. The "
"tadpole arches in satisfaction - it lives on.*"
msgstr ""
"*방의 모습이 서서히 눈에 들어옵니다. 당신은 무사하지만, 더는 온전하지 않습니다. 올챙이가 만족스럽게 몸을 구부립니다. 아직도 "
"살아있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Player
#. NodeID = 2ad138f8-f339-ceac-f888-fe4891fc9c5f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
#. SetFlags:
#.   Global:
#.     - CRE_GithInfirmary_State_DaisyIntervened = True
#.     - CRE_GithInfirmary_State_LaezelOMAllowedLaezel = True
#.   Object:
#.     - CRE_GithInfirmary_Event_DamageBrainINT(2) = True
#.     - CRE_GithInfirmary_Event_DamageBrainWIS(2) = True
#.     - CRE_GithInfirmary_Event_DamageBrainCON(2) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:2ad138f8-f339-ceac-f888-fe4891fc9c5f
msgctxt "h23f55fd5g8452g4077g910cg61b8746decfe"
msgid "No... stop talking... I don't understand... NO!"
msgstr "그만... 그만 말해... 이해가 안돼... 그만!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Player
#. NodeID = 2c19f1e0-a3eb-69ec-9a2c-f62ca020f0f7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
#. SetFlags:
#.   Object:
#.     - CRE_GithInfirmary_Event_DamageBrainWIS(2) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:2c19f1e0-a3eb-69ec-9a2c-f62ca020f0f7
msgctxt "h50a82041gbdceg49efga5f3g406fda6b37c0"
msgid "<i>Ch'mar, zal'a Vlaakith.</i> My Queen, hear me!"
msgstr "<i>츠마르, 잘라 블라키스.</i> 나의 여왕이시어, 들어 주소서!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Player
#. NodeID = 34250cbb-04ee-0be3-4403-3ead0633eb86
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 7131b9d6-232d-f988-7cff-7d1630dce3c5_TriedToEscapeDevice = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:34250cbb-04ee-0be3-4403-3ead0633eb86
msgctxt "h28f8fbadgf574g4823g832dg1d7d0af8597a"
msgid "<i>Enough is enough. Get out now.</i>"
msgstr "<i>더 이상은 안된다. 당장 빠져나간다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Ghustil Stornugoss
#. NodeID = 345f3667-9c8d-dab9-ae64-acfc044450b9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - GITHYANKI(2) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:345f3667-9c8d-dab9-ae64-acfc044450b9
msgctxt "hcb9b7282gabfcg4beegb47ag1192f15a457e"
msgid "More than ceremorphosis? <i>Chk.</i>"
msgstr "뇌변이보다 나쁘겠어? <i>츠크</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Narrator
#. NodeID = 3959b09f-e736-cc24-6cda-fe4d46f6b206
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - CRE_GithInfirmary_Knows_ToldWhatZaithiskDoes(2) = False
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:3959b09f-e736-cc24-6cda-fe4d46f6b206
msgctxt "h4ea8de9dg999ag4779g9a68gdeb9f1c4a8b7"
msgid ""
"*You realise the device is <i>hunting</i> your parasite. But it's doing so "
"blindly. Without direction, your faculties could be permanently damaged.*"
msgstr ""
"*당신은 이 장치가 머릿속의 기생충을 <i>사냥하고</i> 있다는 사실을 깨닫습니다. 하지만 다소 맹목적인 방식입니다. 정확한 지시가 "
"없다면, 영구적인 기능 손상이 초래될 수 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Narrator
#. NodeID = 3a25af77-a043-3a80-0197-25c51c3dcc47
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - CRE_GithInfirmary_Event_DamageBrainWIS(2) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:3a25af77-a043-3a80-0197-25c51c3dcc47
msgctxt "h13419c6ag8bf7g4c7ag9093g029600bc8e58"
msgid ""
"*The device misses its mark, searing the back of your skull. The world grows "
"dimmer, your perception weakens.*"
msgstr "*장치가 표시를 놓치더니, 두개골 뒤쪽을 태워버립니다. 세상이 점점 어두워지고, 지각 능력이 약해집니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Player
#. NodeID = 3ab0c4c2-5033-f609-0ab9-c90e129d3e85
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SavingThrow
#. RollAbility: Wisdom
#. DifficultyClass: 15
#. TagRule: !REALLY_GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:3ab0c4c2-5033-f609-0ab9-c90e129d3e85
msgctxt "h674eeb9bg2a75g4953g8e58gbb75b28057c9"
msgid "<i>Stay calm. Guide the device closer.</i>"
msgstr "<i>침착함을 유지한다. 장치를 더 가까이 유도한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Player
#. NodeID = 3ab0c4c2-5033-f609-0ab9-c90e129d3e85
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SavingThrow
#. RollAbility: Wisdom
#. DifficultyClass: 15
#. TagRule: REALLY_GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:3ab0c4c2-5033-f609-0ab9-c90e129d3e85
msgctxt "hd3c463e8gdd75g4190g98dbg87b1e276101e"
msgid "<i>Remember your orders. Bring the device closer.</i>"
msgstr "<i>명령을 기억한다. 장치를 더 가까이 유도한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Ghustil Stornugoss
#. NodeID = 3acc5f6c-439c-2db5-78d3-fc6a9f7f7d29
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 7131b9d6-232d-f988-7cff-7d1630dce3c5_DoctorTakesPart = True
#. TagRule: !GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:3acc5f6c-439c-2db5-78d3-fc6a9f7f7d29
msgctxt "hcfdb0a5bgf1e8g4e3cgabfag4f297e479d74"
msgid ""
"That's it. Ignore the pain. Think of the tadpole. Think of it <i>purged</i>."
msgstr "바로 그거다. 고통은 무시해라. 올챙이만 생각해. <i>정화</i>만을 생각해."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Ghustil Stornugoss
#. NodeID = 3acc5f6c-439c-2db5-78d3-fc6a9f7f7d29
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 7131b9d6-232d-f988-7cff-7d1630dce3c5_DoctorTakesPart = True
#. TagRule: GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:3acc5f6c-439c-2db5-78d3-fc6a9f7f7d29
msgctxt "hf3126c70g0572g4818g861cg6a9ffcf50630"
msgid "Keep going, my child. The <i>ghaik</i> spawn will soon be gone."
msgstr "계속해라, 훌륭한 자손이여. <i>게이크</i> 부산물이 곧 사라지리라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Ghustil Stornugoss
#. NodeID = 3dcde330-17b8-1a57-7ecd-7b32d7189a66
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_GithInfirmary_State_ResolvedPeacefully = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:3dcde330-17b8-1a57-7ecd-7b32d7189a66
msgctxt "h9ba41211g0bfbg40e9g95c0gb12249bf4e08"
msgid "But I've no use for gibbering idiots. Leave me."
msgstr "하지만 횡설수설하는 멍청이는 쓸모가 없지. 가라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Narrator
#. NodeID = 3ed17629-1670-fcd3-14e3-25d3c0eb36a5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:3ed17629-1670-fcd3-14e3-25d3c0eb36a5
msgctxt "h965405c1g9140g403cgb6f5gff751505c210"
msgid ""
"*The pain is too great. The visions flicker but refuse to come into focus.*"
msgstr "*고통이 너무 심합니다. 환영이 깜빡이지만 초점을 맞출 수가 없습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Ghustil Stornugoss
#. NodeID = 4225a69a-36c9-f6f2-6bb5-b0f274fedd1a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CRE_GithInfirmary_State_DoctorIsExpectingCharacter(2) = False
#.   Script:
#.      - GEN_IsSpeakerPresent_1 = True
#. SetFlags:
#.   Local:
#.     - 7131b9d6-232d-f988-7cff-7d1630dce3c5_DoctorTakesPart = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:4225a69a-36c9-f6f2-6bb5-b0f274fedd1a
msgctxt "h3090a1cfgf72ag4bb5g90d9g0290402bc47b"
msgid ""
"You're infected too, child? How fortunate you crossed my path. Take a seat."
msgstr "얘야, 너도 감염된 거냐? 나를 만나다니 정말 운이 좋구나. 앉아라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Lae'zel
#. NodeID = 44972945-f3d4-d6a3-01f0-7018917bf94b
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SavingThrow
#. RollAbility: Constitution
#. DifficultyClass: 18
#. CheckFlags:
#.   Tag:
#.      - AVATAR(2) = True
#.      - REALLY_LAEZEL(2) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:44972945-f3d4-d6a3-01f0-7018917bf94b
msgctxt "h307dd769g63d7g468dg9b01gffbbd7241f2c"
msgid "<i>Pursue the visions you saw. See where they lead.</i>"
msgstr "<i>당신이 목격했던 환영들을 좇는다. 그들이 어디로 이끄는지 본다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Narrator
#. NodeID = 474d0ede-17cd-5485-7d45-cc23c4753d6f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - AVATAR(2) = True
#.      - REALLY_LAEZEL(2) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:474d0ede-17cd-5485-7d45-cc23c4753d6f
msgctxt "hf39ad90fgb9efg4471gaeb9g2990feee7e22"
msgid ""
"*Your vision narrows. You sense myriad spectres of githyanki past. This is "
"their fate. This is their anguish.*"
msgstr ""
"*시야가 점점 좁아집니다. 당신은 과거의 무수한 기스양키 영혼들을 감지합니다. 이것이 그들의 운명입니다. 이것이 그들의 고뇌입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Narrator
#. NodeID = 48b176a6-bef6-d0a3-987a-f48e85d4cfb3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:48b176a6-bef6-d0a3-987a-f48e85d4cfb3
msgctxt "hf31e4fbdg3e89g48fag8e9bg47618e80284d"
msgid ""
"*You pour yourself into the tadpole's putrid magic. Its strength multiplied, "
"it unleashes on the machine.*"
msgstr "*올챙이의 부패한 마법에 당신의 힘을 쏟아붓습니다. 올챙이의 힘이 배가 되더니, 기계에 그 힘을 방출합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Ghustil Stornugoss
#. NodeID = 4a622fde-3ef2-44d3-ce18-a18142a2cff1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:4a622fde-3ef2-44d3-ce18-a18142a2cff1
msgctxt "h94036661gfb35g47d5g9c80gace4b3d32fd8"
msgid ""
"I am disappointed that we could not extract it alive. It would have been an "
"exceptional specimen."
msgstr "살아있는 상태로 추출하지 못한 게 정말 아쉽군. 아주 특별한 표본이었을 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Ghustil Stornugoss
#. NodeID = 4aa5967b-3c38-fc06-51b1-77a517910756
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - CRE_GithInfirmary_State_DoctorIsExpectingCharacter(2) = True
#.   Script:
#.      - GEN_IsSpeakerPresent_1 = True
#. SetFlags:
#.   Local:
#.     - 7131b9d6-232d-f988-7cff-7d1630dce3c5_DoctorTakesPart = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:4aa5967b-3c38-fc06-51b1-77a517910756
#, fuzzy
msgctxt "h09ca7affg3f29g4998g81efgb43b66dad372"
msgid "Take your place in the <i>zaith'isk</i>. Purification awaits."
msgstr "<i>제이트이스크</i>에 자리 잡도록. 정화가 기다린다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Player
#. NodeID = 4cfea6a2-09ea-884f-ef53-bc6625fefe65
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 7131b9d6-232d-f988-7cff-7d1630dce3c5_TriedToEscapeDevice = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:4cfea6a2-09ea-884f-ef53-bc6625fefe65
msgctxt "h22d361aagb5dfg4385gad12ga399101c7f56"
msgid "<i>Free yourself. Escape.</i>"
msgstr "<i>구속을 해제하고 빠져나간다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Narrator
#. NodeID = 4d048e15-4b22-a793-702d-560602c69622
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:4d048e15-4b22-a793-702d-560602c69622
msgctxt "h125debe3g72fdg4504g9320gccd95879927c"
msgid ""
"*The tadpole quivers. A different magic is building within it. This one is "
"ancient. Rotten.*"
msgstr "*올챙이가 경련합니다. 안쪽에서 다른 종류의 마법이 만들어지고 있습니다. 타락한, 고대의 마법입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Player
#. NodeID = 4ec15119-98e2-4801-bdc9-1ba0c33daf79
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:4ec15119-98e2-4801-bdc9-1ba0c33daf79
msgctxt "h2cf0f943gf064g4baag94efga0c1bda85989"
msgid "<i>Shout for help.</i>"
msgstr "<i>도와달라고 외친다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Narrator
#. NodeID = 515f1a9c-3fe1-1315-bb93-d82a0e8ca5f2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 7131b9d6-232d-f988-7cff-7d1630dce3c5_DoctorTakesPart = True
#.   Object:
#.      - CRE_GithInfirmary_Event_DamageBrainINT(2) = True
#.      - CRE_GithInfirmary_Event_GainNewPower(2) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:515f1a9c-3fe1-1315-bb93-d82a0e8ca5f2
msgctxt "h8e85c000g86b6g42adg9b3egd909797175b1"
msgid ""
"*The room swims back into focus. Your mind is fractured, but intact. Inside "
"it, the tadpole lives on. And you feel <i>different.</i>*"
msgstr ""
"*초점이 서서히 돌아옵니다. 당신의 정신은 손상되긴 했지만, 온전합니다. 머릿속 올챙이는 살아 있습니다. 하지만 어딘가 <i>달라진</"
"i> 느낌입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Ghustil Stornugoss
#. NodeID = 543e7a25-a421-1a63-ffb0-5ae3176fdd8f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:543e7a25-a421-1a63-ffb0-5ae3176fdd8f
msgctxt "h6e23ef27g978bg4279g92afgb87334dbf9fc"
msgid ""
"Since the <i>zaith'isk </i>did not extract it, we must resort to more "
"traditional means."
msgstr "<i>제이트이스크</i>가 추출하지 못했으니, 좀 더 전통적인 방법에 의지해야겠군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Narrator
#. NodeID = 55aa0373-1e58-4be8-5811-07fdb13613ab
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_GithInfirmary_State_AnyPlayerGotDeviceIntro = True
#.      - CRE_GithInfirmary_State_UsedDevice = False
#.   Object:
#.      - CRE_GithInfirmary_State_DoctorIsExpectingCharacter(2) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:55aa0373-1e58-4be8-5811-07fdb13613ab
msgctxt "h81780148gf231g4015g85d0gab54c6a884f2"
msgid ""
"*The <i>zaith'isk</i>. In its unnatural embrace lies the hope of being "
"cured. You feel your parasite stir.*"
msgstr ""
"*<i>제이트이스크</i>입니다. 그 부자연스러운 포옹 속에는 치료의 희망이 담겨 있습니다. 당신은 기생충이 떨리는 것을 느낍니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Ghustil Stornugoss
#. NodeID = 56aaee9c-7b08-1ec0-625c-83898ba3b017
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:56aaee9c-7b08-1ec0-625c-83898ba3b017
msgctxt "hd3633a93gd4c7g4a65g9de9g7e747b2db68c"
msgid "Frustrating. I should have liked to have found out what happened."
msgstr "실망스럽군. 무슨 일이 일어난 건지 알아내면 좋을 텐데."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Ghustil Stornugoss
#. NodeID = 598a4ada-b4fc-4077-6ef5-60042922cdc3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:598a4ada-b4fc-4077-6ef5-60042922cdc3
msgctxt "h1a73180fg7380g4967gad79g0253a1a85e5b"
msgid "It saved you?"
msgstr "그게 널 구했다고?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Ghustil Stornugoss
#. NodeID = 5e908085-fd63-9852-5bb5-dde4aee6a612
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_GithInfirmary_State_DoctorTriesToCallGuards = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:5e908085-fd63-9852-5bb5-dde4aee6a612
msgctxt "h27b3ada3gbbb9g48b0gadefga4fc7f33cce7"
msgid "Wait here. I will gather my tools."
msgstr "여기서 기다려라. 장비를 챙겨 오지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Ghustil Stornugoss
#. NodeID = 622e825b-a8ee-3956-5496-c05257628eb3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:622e825b-a8ee-3956-5496-c05257628eb3
msgctxt "he89f9f47gbb8eg4769ga2d0gc7ae95463967"
msgid "My child! To whom do you speak?"
msgstr "얘야! 누구에게 말하는 거냐?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Ghustil Stornugoss
#. NodeID = 65636420-545d-63d7-4aea-7a5114a2b5d2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:65636420-545d-63d7-4aea-7a5114a2b5d2
msgctxt "hf7ba3bf4gff66g4425ga894g78b968a56cd6"
msgid ""
"You're lying. You're protecting it. I knew it - the parasite has burrowed "
"deeper than I thought. It already owns you."
msgstr "거짓말. 기생충을 지키려 하는군, 알 수 있어. 그 기생충은 내 짐작보다 더 깊숙이 파고들었군. 이미 널 지배하고 있어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Player
#. NodeID = 6649bf23-6d7c-9e89-3fb9-2dce48c4e7cc
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SavingThrow
#. RollAbility: Constitution
#. DifficultyClass: 18
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(2) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:6649bf23-6d7c-9e89-3fb9-2dce48c4e7cc
msgctxt "h7fb21233gc1b7g4797g9f4ag445f04fdb507"
msgid "<i>LET THE TADPOLE FEED ON YOUR RAGE. MAKE IT <b>STRONG.</b></i>"
msgstr "<i>올챙이가 당신의 분노를 먹게 한다. <b>강하게</b> 키운다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Wyll
#. NodeID = 668ad2b3-1cda-22e0-9d40-e3d1f354decf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(6) = True
#.   Tag:
#.      - REALLY_WYLL(6) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:668ad2b3-1cda-22e0-9d40-e3d1f354decf
msgctxt "h52a5c4d1g8cb8g4943g9513gbc06a1bd546b"
msgid ""
"It's only a horrific machine of unspeakable form. What's the worst that "
"could happen?"
msgstr "말로 표현할 수 없는 끔찍한 형태의 기계일 뿐이잖아. 심한 일 생기겠어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Narrator
#. NodeID = 6738ec23-620b-33ec-419e-dd5021eb6651
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:6738ec23-620b-33ec-419e-dd5021eb6651
msgctxt "hf768f92eg251dg490egaa1agced9b68c02ef"
msgid ""
"*The parasite burrows deeper, sinking its teeth into your brain's exposed "
"tissue. It sucks greedily.*"
msgstr "*기생충이 더 깊숙이 파고들며, 당신의 노출된 뇌 조직에 이빨을 박아 넣고는 게걸스럽게 빨아들입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Karlach
#. NodeID = 6ca9e05a-69bc-4dba-9939-ff4c33b0d022
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_KARLACH(4) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:6ca9e05a-69bc-4dba-9939-ff4c33b0d022
msgctxt "hbf0009eegbadag454dga014g68c26ac02e69"
msgid "There's got to be some way to stop this thing!"
msgstr "이걸 막을 어떤 방법이 있을 거야!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Narrator
#. NodeID = 70a4de3c-cba9-69e3-5d4c-9fa1abe98ce4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:70a4de3c-cba9-69e3-5d4c-9fa1abe98ce4
msgctxt "h7ef3224dg759bg4081g87b3gb4b380bb2c5b"
msgid ""
"*There's something in her voice that goes beyond rage - curiosity, perhaps, "
"or regret. Whatever it is, you cannot identify it.*"
msgstr ""
"*그녀의 목소리에서 분노 이상의 무언가가 느껴집니다. 호기심, 어쩌면 낙담한 걸지도. 그것이 무엇이든지 간에 당신은 구분할 수 없습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Player
#. NodeID = 70b15e39-1b32-4afa-98d9-9e529925d5c2
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. TagRule: REALLY_DARK_URGE
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:70b15e39-1b32-4afa-98d9-9e529925d5c2
msgctxt "h4d41cb21g17f5g41fcgaec7gf9414f2f59f4"
msgid ""
"<i>Pretend the zaith'isk wrecked your brain further - you don't know what "
"she's talking about.</i>"
msgstr "<i>그녀가 무슨 말을 하고 있는지 모를 정도로, '제이트이스크'가 당신의 뇌를 더 망가뜨린 척 한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Player
#. NodeID = 70b15e39-1b32-4afa-98d9-9e529925d5c2
#. HandlePath = TaggedText[1].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:70b15e39-1b32-4afa-98d9-9e529925d5c2
msgctxt "hbae92ed4ge07ag44feg99f9g7e86076c7d9a"
msgid ""
"<i>Pretend the zaith'isk wiped your memories and you don't know what she's "
"talking about.</i>"
msgstr "<i>그녀가 무슨 말을 하고 있는지 모를 정도로, '제이트이스크'가 당신의 기억을 지워버린 척 한다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Narrator
#. NodeID = 734ad772-9bbe-3272-2a55-668d52ff756d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 7131b9d6-232d-f988-7cff-7d1630dce3c5_FailedMindRoll = True
#.   Object:
#.     - CRE_GithInfirmary_Event_DamageBrainCON(2) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:734ad772-9bbe-3272-2a55-668d52ff756d
msgctxt "hfcf215fcg2ea9g42e1gb383g8526e57e5fd6"
msgid ""
"*Unable to find its target, the device unleashes indiscriminately through "
"your body.*"
msgstr "*표적이 수색망에서 빠져나가자, 장치는 그 힘을 당신의 신체에 마구잡이로 풀어놓습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Ghustil Stornugoss
#. NodeID = 75f9e2fc-096d-b3a8-4426-4d8f789415d1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:75f9e2fc-096d-b3a8-4426-4d8f789415d1
msgctxt "h4890de16ga252g4603gaeefg86f1634fd368"
msgid "The <i>zaith'isk</i> does not fail."
msgstr "<i>제이트이스크</i>에 실패란 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Narrator
#. NodeID = 7a2dd116-20a7-a827-2924-d2b028522649
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:7a2dd116-20a7-a827-2924-d2b028522649
msgctxt "h65caf18cg1facg4a94gb09egae1d2bda0576"
msgid ""
"*The voices of the dead cry out as one. The <i>zaith'isk</i> collects "
"memories from the infected - and executes them. It is not for curing. It's "
"for killing.*"
msgstr ""
"*죽은 자들이 한목소리로 울부짖습니다. <i>제이트이스크</i>는 감염자들의 기억을 수집한 다음 처형합니다. 치료를 위해서가 아닙니다. "
"죽이기 위해서입니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Player
#. NodeID = 7b366681-09d4-2db2-f653-ef1c2b9dad0b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
#. SetFlags:
#.   Global:
#.     - CRE_GithInfirmary_State_UsedDevice = True
#.   Object:
#.     - CRE_GithInfirmary_State_CharacterUsedDevice(2) = True
#.     - CRE_GithInfirmary_Event_DamageBrainINT(2) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:7b366681-09d4-2db2-f653-ef1c2b9dad0b
msgctxt "ha433a89ag2361g439cg9b54g91ab8df2473a"
msgid "<i>Nnngh!</i>"
msgstr "<i>으윽!</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Player
#. NodeID = 7b630cdb-62b1-f13f-2bcd-911f1f4d787a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:7b630cdb-62b1-f13f-2bcd-911f1f4d787a
msgctxt "h9a06145dgf541g4e6fgb7afgb4cc738d7e23"
msgid "Your <i>zaith'isk </i>tried to kill me. And failed."
msgstr "네 기계가 날 죽이려고 했어. 그리고 실패했지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Ghustil Stornugoss
#. NodeID = 839b350e-95df-6a67-4855-7a15365793e1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_GithInfirmary_State_DoctorWaitsAtDevice = True
#.   Object:
#.      - CRE_GithInfirmary_State_DoctorIsExpectingCharacter(2) = True
#. SetFlags:
#.   Local:
#.     - 7131b9d6-232d-f988-7cff-7d1630dce3c5_DoctorTakesPart = True
#. TagRule: !GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:839b350e-95df-6a67-4855-7a15365793e1
msgctxt "hbb10c246ge030g4501g80fbg974b30361fb0"
msgid "Do not fear. My experience in operating this machine is unparalleled."
msgstr "두려워하지 마라. 내가 이 기계를 조작한 경험은 비할 데 없으니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Ghustil Stornugoss
#. NodeID = 839b350e-95df-6a67-4855-7a15365793e1
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_GithInfirmary_State_DoctorWaitsAtDevice = True
#.   Object:
#.      - CRE_GithInfirmary_State_DoctorIsExpectingCharacter(2) = True
#. SetFlags:
#.   Local:
#.     - 7131b9d6-232d-f988-7cff-7d1630dce3c5_DoctorTakesPart = True
#. TagRule: GITHYANKI
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:839b350e-95df-6a67-4855-7a15365793e1
msgctxt "ha09b4776g43f5g4f28g90c1g63ba1ada6f3b"
msgid "To sit in the <i>zaith'isk</i> is a rare blessing, kin. Be grateful."
msgstr "<i>제이트이스크</i>에 앉는 것은 귀한 축복이야, 동족. 감사해라."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Narrator
#. NodeID = 891fb4a5-a3d6-6e7b-c478-fb271b3e7428
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:891fb4a5-a3d6-6e7b-c478-fb271b3e7428
msgctxt "hd67c33f6g9839g4e78g903ag5e1338aa6cf8"
msgid ""
"*You feel yourself ebbing away, while the parasite only grows stronger. It's "
"<i>evolving</i>.*"
msgstr "*기생충이 점점 더 강해지는 동안 당신은 스스로가 점점 쇠퇴하는 것을 느낍니다. 그것은 <i>진화</i>하고 있습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Player
#. NodeID = 8a34707f-537d-1cd0-9793-22afa60416f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:8a34707f-537d-1cd0-9793-22afa60416f3
msgctxt "hb8e98362ge6d0g413egbd55gf52a6cbf4247"
msgid "<i>Try again. Try harder.</i>"
msgstr "<i>더 새게 다시 해본다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Player
#. NodeID = 8bf36951-54ce-c53e-4a70-f7e2f0c4ef89
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Script:
#.      - GEN_IsSpeakerPresent_4 = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:8bf36951-54ce-c53e-4a70-f7e2f0c4ef89
msgctxt "h81d29cf0gfc71g4ec6gb9b9g3ca1ae979841"
msgid "<i>Look to your companions for guidance.</i>"
msgstr "<i>동료들의 의견을 구해본다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Ghustil Stornugoss
#. NodeID = 919d5959-2644-5e3b-90db-4dabe0bcb58a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - CRE_GithInfirmary_State_AnyPlayerGotDeviceIntro = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:919d5959-2644-5e3b-90db-4dabe0bcb58a
msgctxt "ha5681cbbg5457g48d0g9051g8596ea1f586b"
msgid ""
"There is nothing on any plane stronger than a <i>zaith'isk</i> for curing "
"unwanted <i>afflictions</i>."
msgstr "원치 않는 고통을 치료하는 데에 <i>제이트이스크</i>보다 강력한 것은 그 어느 차원에도 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Narrator
#. NodeID = 9324e623-f86d-17a3-d9ff-2d77b0eed11b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 7131b9d6-232d-f988-7cff-7d1630dce3c5_DoctorTakesPart = True
#.   Object:
#.      - CRE_GithInfirmary_Event_DamageBrainINT(2) = False
#.      - CRE_GithInfirmary_Event_DamageBrainWIS(2) = False
#.      - CRE_GithInfirmary_Event_GainNewPower(2) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:9324e623-f86d-17a3-d9ff-2d77b0eed11b
msgctxt "h6e89d6ebgcf8ag4548g8071g0cd4e600dbe0"
msgid ""
"*The room swims back into focus. Your mind is intact, yet unfamiliar. Inside "
"it, the tadpole lives on. And you feel <i>different.</i>*"
msgstr ""
"*초점이 서서히 돌아옵니다. 당신의 정신은 온전하지만, 낯설게 느껴집니다. 머릿속 올챙이는 살아 있습니다. 하지만 어딘가 <i>달라진</"
"i> 듯합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Player
#. NodeID = 935194aa-ade9-221b-7056-4c3c0bb88ab3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_GithInfirmary_State_IncludedCompanionsPresentInDialog = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:935194aa-ade9-221b-7056-4c3c0bb88ab3
msgctxt "hbd0a388fg181bg4c6dgb249g821e1125b6b7"
msgid "<i>Look to your companions for guidance.</i>"
msgstr "<i>동료들의 의견을 구해본다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Karlach
#. NodeID = 948ff4ff-eb34-4840-87cb-b009d4472e1d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(4) = True
#.   Tag:
#.      - REALLY_KARLACH(4) = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:948ff4ff-eb34-4840-87cb-b009d4472e1d
msgctxt "hb27c4569gabb5g4615ga36agb06c73bb8690"
msgid "This can't be right. That things going to kill you - move, now!"
msgstr "뭔가 잘못 됐어. 저놈이 널 죽이려고 한다고 - 당장 나와!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Player
#. NodeID = 99d0b741-a5e0-dfd8-fedd-a1bd0fd20c51
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:99d0b741-a5e0-dfd8-fedd-a1bd0fd20c51
msgctxt "h7bb6cdc7gd2ffg4c5fg982bg4ee1f1c797bf"
msgid "The parasite lives, yes. And thank goodness - it saved me."
msgstr "그래, 기생충은 살아 있다. 고맙게도 그게 내 목숨을 구했지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Ghustil Stornugoss
#. NodeID = 9a5c101d-7e51-6526-a5e5-8e72acd13c63
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:9a5c101d-7e51-6526-a5e5-8e72acd13c63
msgctxt "h9043cb2fg4412g4071ga013g5bf7ad3f8303"
msgid ""
"And it destroyed a <i>zaith'isk</i>... Then its power is even more unique "
"than I thought. I must examine it."
msgstr "그리고 그 올챙이가 <i>제이트이스크</i>를 부쉈지... 예상보다 훨씬 특별한 힘이로군. 반드시 연구해야겠어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = Narrator
#. NodeID = 9aa99094-80dd-6565-e71e-fbce09913c4a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - CRE_GithInfirmary_State_UsedDevice = True
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:9aa99094-80dd-6565-e71e-fbce09913c4a
msgctxt "h8cb60eb8g923fg4f3ag8687gd8c8b27c3ff8"
msgid ""
"*Smoke rises like hot breath, but whatever semblance of life once powered "
"the <i>zaith'isk</i> is gone.*"
msgstr ""
"*연기가 뜨거운 숨처럼 피어오릅니다. 한때 <i>제이트이스크</i>를 추동했던 유사 생명체가 무엇이었든, 흔적 없이 사라져버렸습니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = GROUP_Daisy
#. NodeID = 9adcbd3c-efb1-4c53-32ad-075ca073b9d7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IMPOSSIBLE = True
#. TagRule: DAISY_DESIRETRACK and DAISY_MALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:9adcbd3c-efb1-4c53-32ad-075ca073b9d7
msgctxt "hd08bf453g52e3g46d8ga487g3d456e7935c1"
msgid "You're hurting. Let me help."
msgstr "다쳤군요. 도와줄게요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = GROUP_Daisy
#. NodeID = 9adcbd3c-efb1-4c53-32ad-075ca073b9d7
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IMPOSSIBLE = True
#. TagRule: DAISY_DESIRETRACK and DAISY_FEMALE_VOICE
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:9adcbd3c-efb1-4c53-32ad-075ca073b9d7
msgctxt "h692c3f78g1f01g49c8g8cf3gc9ba509ad9f8"
msgid "You're hurting. Let me help."
msgstr "다쳤군요. 도와줄게요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
#. Speaker = GROUP_Daisy
#. NodeID = 9adcbd3c-efb1-4c53-32ad-075ca073b9d7
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - IMPOSSIBLE = True
#. TagRule: DAISY_MALE_VOICE and DAISY_REASONTRACK
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device:9adcbd3c-efb1-4c53-32ad-075ca073b9d7
msgctxt "h521035c2gb8bag48d8g872bg937ac86f5023"
msgid "If you won't stop this, then I will."
msgstr "당신이 이걸 멈추지 않는다면, 내가 할 거예요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_GithInfirmary_Device
