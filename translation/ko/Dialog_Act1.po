msgctxt "heae5488bg3d34g40a9g84a9gd3b06b36fe43"
msgid "Hmph."
msgstr "흠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_CorpseDisposer_Companion
#. Speaker = Viss
#. NodeID = ea5551b8-4df3-0d7a-fa7c-d50c94ca3ff3
