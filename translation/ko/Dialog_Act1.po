msgctxt "h30c245ebg1c41g4e34g8112g595ae3fa6eb4"
msgid "Thank you... now how the hell do we get out of here?"
msgstr "고맙습니다... 여기선 도대체 어떻게 빠져나가죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_TryJoinParty
#. Speaker = Player
#. NodeID = dc171065-42b6-ecb2-4025-034e2efdd75a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_TryJoinParty:dc171065-42b6-ecb2-4025-034e2efdd75a
msgctxt "h7b1807d7gc675g44a5gbad3g2954cad2ef00"
msgid "The door's that way."
msgstr "문은 저쪽입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_TryJoinParty
#. Speaker = Player
#. NodeID = de055ac6-acae-1157-47b3-1cbfb18bcde1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_TryJoinParty:de055ac6-acae-1157-47b3-1cbfb18bcde1
msgctxt "hd5a04cfcg07aeg4ea6gafc0ge79720274668"
msgid "Come on, follow me."
msgstr "이리로, 따라오세요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_TryJoinParty
#. Speaker = Benryn
#. NodeID = e9e32481-51b8-db5b-6af2-ec3e1511f3ff
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - PLA_StuckHalfElf_State_DoNotAddToParty = True
#.   Quest:
#.     - PLA_StuckHalfElf.Freed2(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_StuckHalfElf_TryJoinParty:e9e32481-51b8-db5b-6af2-ec3e1511f3ff
msgctxt "h035a74e0g5e8cg4f2ag8d8fg621434c515c4"
msgid "Oh, gods. I'll have to make a run for it."
msgstr "오, 신이시여. 최대한 서둘러야겠군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_TavernInvestigation_DesireDoor
