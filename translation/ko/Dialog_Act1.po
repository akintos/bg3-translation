msgid ""
"One of the inn-whelps pulled a dagger on me - against me axe! Bloody idiot."
msgstr "여관에서 어떤 자식 하나가 내게 단검을 들이대더라 - 내 도끼를 상대로 말이야! 멍청한 새끼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_TakeRefill_000
#. Speaker = Devout Mezzka
#. NodeID = 194faa72-c886-d1ed-397c-3b20b6e44512
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_TakeRefill_000:194faa72-c886-d1ed-397c-3b20b6e44512
msgctxt "hbff8c8acg47f6g43b3g9e4bgd863fabf7076"
msgid "I ain't drunk enough yet."
msgstr "난 아직 덜 취한 것 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_Festivities_AD_TakeRefill_001
#. Speaker = Warrior Sul
