msgctxt "h19d54bf6gfe38g46c4gb483g28520f069a53"
msgid "Yawn."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_ArcaneTower_PAD_Poems
#. Speaker = Player
#. NodeID = 83839bf1-cce1-4457-ab2f-082b4d446929
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
