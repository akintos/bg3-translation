msgctxt "h2130b5c8g655fg47fcga534g7e257b199e1d"
msgid "So beautiful. So free."
msgstr "너무 아름다워. 너무 자유로운 느낌이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerCharmed
