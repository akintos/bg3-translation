msgctxt "hc2d086dage799g4ba2g9718g54d1dff9d6b5"
msgid "I'm, eh - Jane... Humanman."
msgstr "나는, 어... 제인... 휴먼맨이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_ThayanCellar_MagicMirror
