#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_Thieflings_AD_HideoutTrespass
#. Speaker = Mol
#. NodeID = 32f77d14-eb94-e3f4-19e5-c5d4607683a8
