#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinKid002_LootingCrime:85bef99f-a3f2-c5fd-d44c-05bb9d4885b5
msgctxt "h1d488388g0f5ag41beg9f72gc63ba0a03f05"
msgid "*A shiver runs across your mind... You feel sated.*"
msgstr "*전율이 불현듯 머릿속을 스쳐 지나가고... 만족감이 듭니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinKid002_LootingCrime
#. Speaker = Eight
#. NodeID = 8aa1e64c-e729-62f1-7b1d-c564518740ec
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_Festivities_Event_CorpseShoved = True
#. SetFlags:
#.   Dialog:
#.     - GOB_Festivities_GoblinKid002_WarnedAboutCorpse(1) = True
#.   Global:
#.     - GOB_Festivities_State_KidsFighting = True
#.   Object:
#.     - TemporaryHostilityAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinKid002_LootingCrime:8aa1e64c-e729-62f1-7b1d-c564518740ec
msgctxt "h63af8e3ag34abg4758g81efgf02ab811f77c"
msgid "That's <i>my</i> corpse - <i>I</i> killed him. And you're next!"
msgstr "저 시체는 <i>내</i> 거야 - 내가 죽였어. 그리고 네가 다음 차례고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinKid002_LootingCrime
#. Speaker = Player
#. NodeID = 8c6008cf-1399-e077-6581-9d4587a0479e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(1) = False
#.   Tag:
#.      - TRUESOUL(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinKid002_LootingCrime:8c6008cf-1399-e077-6581-9d4587a0479e
msgctxt "h8003c91bg365eg4b28g8cabg262a18a057d4"
msgid "I'll do what I want - and <i>you </i>will find another corpse."
msgstr "내가 뭘 하든 내 맘이다. <i>너는</i> 다른 시체나 찾아 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinKid002_LootingCrime
#. Speaker = Eight
#. NodeID = a21da6b2-9d3c-9ff5-9870-2d02b8934e84
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Festivities_GoblinKid002_WarnedAboutCorpse(1) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_Festivities_GoblinKid002_WarnedAboutCorpse(1) = True
#.   Object:
#.     - GEB_CrimeWarning_1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinKid002_LootingCrime:a21da6b2-9d3c-9ff5-9870-2d02b8934e84
msgctxt "hd82e5cbcgcf2cg488fgb819gd58fc98d5100"
msgid "Oi, get off! I killed him - he's mine!"
msgstr "야, 꺼져! 내가 죽였으니 내 거야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinKid002_LootingCrime
#. Speaker = Eight
#. NodeID = a43571e3-2a78-43bd-a501-8849db039bc2
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - d3974ebe-93df-248e-3615-6c1f9e560075_MindHasBeenRead = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinKid002_LootingCrime:a43571e3-2a78-43bd-a501-8849db039bc2
msgctxt "h947e8a7fg41fag4591g8d6age8da010fbbb3"
msgid ""
"<i>This meatbag might have nothin' but a few paper scraps, but I ain't gonna "
"let no one get 'em.</i>"
msgstr "<i>이 고기 덩어리에는 종이 쓰레기 밖에 없을지 모르지만, 아무도 그걸 가져가진 못하게 할 거야.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinKid002_LootingCrime
#. Speaker = Narrator
#. NodeID = a4615167-dcaf-0497-b682-b90c5479d876
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - GLO_TadpoleIntro_NPC(1) = False
#. SetFlags:
#.   User:
#.     - GLO_TadpoleIntro_NPC(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinKid002_LootingCrime:a4615167-dcaf-0497-b682-b90c5479d876
msgctxt "h2556e808g86ecg4f67gba17g71858da0c5c0"
msgid ""
"*A strange symbol glows, marked on their flesh, and something within you "
"stirs in response.*"
msgstr "*그들의 살갗에 새겨진 기묘한 상징이 빛나고, 이에 반응하여 당신 내면의 무언가가 꿈틀거립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinKid002_LootingCrime
#. Speaker = Player
#. NodeID = aa2f86bb-0a55-7514-0ac0-4441c7c1e317
#. HandlePath = TaggedText[0].TagText[0]
