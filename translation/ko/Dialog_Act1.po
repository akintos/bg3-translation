msgctxt "hb52b244dg5044g45bbg9ff0g8e67ff9be236"
msgid "Well isn't <i>this</i> a cheery place?\n"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_VB_EnteredGallery
#. Speaker = Player
#. NodeID = 14728410-4f59-53f3-971d-24a96e3f302b
