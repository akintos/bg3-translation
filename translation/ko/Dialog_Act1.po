msgctxt "h2711a440ga775g47f3g9bedg955c6d8c9225"
msgid ""
"Burrock... she will intercede for us, won't she? <i>She will save us?</i>"
msgstr "버록... 그분께서 우릴 위해 나서 주실 거야, 안 그래? <i>틀림없이 구해 주시겠지?</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_AD_EscortingCultistsChatter
#. Speaker = Raider Add'ath
#. NodeID = 97024409-42e9-24f9-176c-bb6947be0dc2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_AD_EscortingCultistsChatter:97024409-42e9-24f9-176c-bb6947be0dc2
msgctxt "h2272d1edge389g4702g8b9fga5ca0ceb132f"
msgid "Still your <i>istik</i> tongues, or I shall pull them from your heads. "
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_ChainOfCommand_AD_EscortingCultistsChatter
#. Speaker = Warrior Ith'dul
