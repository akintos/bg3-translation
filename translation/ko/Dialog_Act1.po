msgctxt "h35314067g64ffg48b8gb547g1d9d04fe435a"
msgid "Perhaps we're better off without magic this time?"
msgstr ""

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/Monastery/CRE_Library_PAD_GremishkaAllergyComment
#. Speaker = Player
#. NodeID = 4cbbfb54-b4aa-444d-a258-9ac0b14ecce9
