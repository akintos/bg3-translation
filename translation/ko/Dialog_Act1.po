msgctxt "h864a33eag6e94g46afgb67ag6e83e21f0602"
msgid "Go. Down the hall. The Inquisitor awaits."
msgstr "회랑을 지나서 가라. 심문관께서 기다리시니까."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_ChainOfCommand_AD_CultistCapture
