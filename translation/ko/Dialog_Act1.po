msgctxt "h9ea3f444g0167g4cc7g8501g281ba084e675"
msgid "*Snuff!*"
msgstr "*킁!*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_DevilishOx_MeetAtDruidsGrove
#. Speaker = Phasm
#. NodeID = 5ef991e4-1795-b63c-6b79-a6176e41f51b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_DevilishOx_MeetAtDruidsGrove:5ef991e4-1795-b63c-6b79-a6176e41f51b
msgctxt "hffaa6c7agdb91g46dfgbfcdgb4a59a44c5df"
msgid "Ohoho, I'd so love to see them try."
msgstr "오호호, 어디 해볼 테면 해보라지 그래."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_DevilishOx_MeetAtDruidsGrove
#. Speaker = Player
#. NodeID = 62767c56-dc17-4359-9e78-38c6a5e5efda
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_DevilishOx_MeetAtDruidsGrove:62767c56-dc17-4359-9e78-38c6a5e5efda
msgctxt "haa30168cg9e4dg40a3g8b2dg6a3750708fe1"
msgid "Haven't you ever met anyone who could speak to oxen?"
msgstr "황소랑 말 섞을 수 있는 사람 처음 봤어?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_DevilishOx_MeetAtDruidsGrove
#. Speaker = Player
#. NodeID = 77b679e7-d012-468b-be42-0982b5382817
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_DevilishOx_MeetAtDruidsGrove:77b679e7-d012-468b-be42-0982b5382817
msgctxt "h878baf68g1886g4acdg8f40g0d48ebe5573d"
msgid "A fine looking beast you are."
msgstr "제법 잘생긴 짐승인걸."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_DevilishOx_MeetAtDruidsGrove
