msgctxt "h99bf953eg00c8g4bd3g94aeg4d72a81b989e"
msgid "I told you to go!"
msgstr "가라고 했잖아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Scratch
#. NodeID = 4c5c33b1-ec3d-78f9-a704-a129316ff5b7
#. HandlePath = TaggedText[0].TagText[0]
