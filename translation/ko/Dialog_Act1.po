msgctxt "h9633d92bgae16g476agbe22gd8cce076da53"
msgid "Flowers as a light source! Necessity really is the mother of invention."
msgstr "꽃을 불빛으로 쓰다니! 역시 필요는 발명의 어머니라니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_ArcaneTower_PAD_Lights
