#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_AD_ViciousMockery:f2a89c35-1e47-e859-0eea-9a927970f53b
msgctxt "h05e7089agc48dg4efeg8b61g770bd5326ebd"
msgid "I'll banish you for good, outsider!"
msgstr "영원히 추방 시켜주마, 이방인!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_HagLair_AD_ViciousMockery
#. Speaker = Auntie Ethel
#. NodeID = f43a3a7f-57ab-7123-7a45-81d2acbee518
