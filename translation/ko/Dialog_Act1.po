msgid "*Whine.*"
msgstr "*훌쩍.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Narrator
#. NodeID = 6f52e9d2-6d71-58ac-fa00-92741a0382da
