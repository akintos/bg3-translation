msgctxt "h86ce70c4g3290g42b6ga80fg896ccaa02377"
msgid "*Whine.*"
msgstr "*훌쩍.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Player
#. NodeID = 62f8f3fd-5b78-b82a-834b-2cfa6030f776
