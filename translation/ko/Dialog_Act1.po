msgid "How about a donation...? ([01f129ea-b4dc-44b6-8154-9a948f876a82])"
msgstr "기부는 어때...? ([01f129ea-b4dc-44b6-8154-9a948f876a82])"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards
#. Speaker = Goblin Warrior
