msgstr "오, 이것 좀 봐. 새 친구가 놀러 왔네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_AdamantineForge_PAD_SpawnedEnemies
#. Speaker = Player
#. NodeID = 83fb75ce-ca5c-4160-bd53-15fe794c0ad8
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_AdamantineForge_PAD_SpawnedEnemies:83fb75ce-ca5c-4160-bd53-15fe794c0ad8
msgctxt "h2db4ac69ga539g4baegad9dgd297d6f470fb"
msgid "Out of the fire... guess that makes me the frying pan."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_AdamantineForge_PAD_SpawnedEnemies
#. Speaker = Player
#. NodeID = 83fb75ce-ca5c-4160-bd53-15fe794c0ad8
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_AdamantineForge_PAD_SpawnedEnemies:83fb75ce-ca5c-4160-bd53-15fe794c0ad8
msgctxt "hf0589b85g58f0g48c3gaaadge4a42fbbdc62"
msgid "All right - bring it on, whatever you are."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_AdamantineForge_PAD_SpawnedEnemies
#. Speaker = Player
#. NodeID = 83fb75ce-ca5c-4160-bd53-15fe794c0ad8
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_AdamantineForge_PAD_SpawnedEnemies:83fb75ce-ca5c-4160-bd53-15fe794c0ad8
msgctxt "h1fbc3aceg33f3g4dd9gbf64ge50587f1c1b2"
msgid "Right from the flames. By Vlaakith, I will be your end!"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_AdamantineForge_PAD_SpawnedEnemies
#. Speaker = Player
#. NodeID = 83fb75ce-ca5c-4160-bd53-15fe794c0ad8
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_AdamantineForge_PAD_SpawnedEnemies:83fb75ce-ca5c-4160-bd53-15fe794c0ad8
msgctxt "h24aa9f68gb3a8g4e6ag9e05g3e5d06bcf73d"
msgid "I think that disturbed something's slumber..."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_AdamantineForge_PAD_SpawnedEnemies
#. Speaker = Player
#. NodeID = 83fb75ce-ca5c-4160-bd53-15fe794c0ad8
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_AdamantineForge_PAD_SpawnedEnemies:83fb75ce-ca5c-4160-bd53-15fe794c0ad8
msgctxt "h4d7cfe62gff26g430bgb51bg8d6999125b1d"
msgid "Would you look at that? Someone's come to say hello."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_AdamantineForge_PAD_SpawnedEnemies
#. Speaker = Player
#. NodeID = 83fb75ce-ca5c-4160-bd53-15fe794c0ad8
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_AdamantineForge_PAD_SpawnedEnemies:83fb75ce-ca5c-4160-bd53-15fe794c0ad8
msgctxt "h33291363g5826g473fg8d15g2c3b9976af19"
msgid "Hells. I think I woke something up."
msgstr ""

