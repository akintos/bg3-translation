msgctxt "hbfaed6d7gc20eg46bfgbdbdg87759a3a883b"
msgid "Won't budge."
msgstr "꿈쩍도 않는군."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_StatuePuzzle_PAD_AthleticsCheckFailed
#. Speaker = Player
#. NodeID = 5d1e0edd-4a98-5bdc-370e-9ce1e0d5de3c
