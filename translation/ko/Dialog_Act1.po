msgid "What did you want with the tiefling?"
msgstr "티플링에게 원하는 게 뭐였지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_Refugee_Dead_PostEA
#. Speaker = Refugee
#. NodeID = 58844a04-13f8-4379-b3cb-ef0623e18588
