msgctxt "hb37aacaagdfc9g4992g807cg61729d8e709b"
msgid ""
"*Even with your keen eyesight, the hole below you soon plummets into an "
"abyss of impossible darkness.*"
msgstr "*발밑의 구덩이는 당신의 암흑시야로도 헤아릴 수 없는 어둠의 심연으로 이어져 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DeepHole
#. Speaker = Narrator
#. NodeID = 3d8c4cc9-a30d-e44a-2d60-dab4d63098db
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - UND_DeepHole_HasMet = False
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DeepHole:3d8c4cc9-a30d-e44a-2d60-dab4d63098db
msgctxt "h7dac8cc8g91e8g47fegacd3gbc66ddf131a7"
msgid ""
"*Looking into the hole, you see only darkness. It's impossible to tell how "
"deep it goes by sight alone.*"
msgstr "*구덩이 아래로 오직 어둠만이 내려다보입니다. 눈대중만으로는 깊이가 어느 정도인지 짐작되지 않습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DeepHole
#. Speaker = Player
#. NodeID = 72545e31-11ed-4a9b-8b09-73a284659e5c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DeepHole:72545e31-11ed-4a9b-8b09-73a284659e5c
msgctxt "h38c87430g0a53g4944g83f6gf05212e45277"
msgid "HellooooOH!"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DeepHole
#. Speaker = Player
#. NodeID = 7c64917a-a9ca-d33f-9021-4fef5f474a06
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DeepHole:7c64917a-a9ca-d33f-9021-4fef5f474a06
msgctxt "h8ebca20agef2dg4940g8477g38037c6a4a58"
msgid "Apologies. Didn't mean to disturb... whatever you are."
msgstr "사과하지. 방해할 생각은 아니었어... 네가 뭐든 간에."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DeepHole
#. Speaker = Player
#. NodeID = 822b60ad-b5eb-5284-e710-bc5bd9bb15cc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DeepHole:822b60ad-b5eb-5284-e710-bc5bd9bb15cc
msgctxt "h89b99d8ag312cg4e13g86b6g7f85e6574ab9"
msgid "<i>Listen and stare into the hole.</i>"
msgstr "<i>귀를 기울인 채 구멍 안을 응시한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DeepHole
#. Speaker = Voice from the Deep Hole
