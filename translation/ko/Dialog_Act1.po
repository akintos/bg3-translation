msgctxt "hd6402114g6565g4f05g8e93g30cadaf40de7"
msgid "<i>Put it away.</i>"
msgstr "<i>집어넣는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FurnaceSearch_DisguisedJournal
#. Speaker = Player
