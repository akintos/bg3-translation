msgctxt "ha3e1f2deg29cag40a8g96e5g9b023c8c60c5"
msgid "Hope the road isn't too bad."
msgstr "가는 길이 너무 험하지만 않으면 좋겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_YoungLover_AD_1
