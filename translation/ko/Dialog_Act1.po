msgctxt "h892c466egbb9ag4742g81bcgf08a2a2ed257"
msgid "I'm pretty sure you're infected, too."
msgstr "너도 감염된 것이 확실하네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
