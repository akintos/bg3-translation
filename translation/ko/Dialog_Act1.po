msgctxt "ha2a3be35gf110g48f5g95fag177f480b24e8"
msgid "Leave! It's not too late."
msgstr "떠나라! 아직 너무 늦지 않았다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_Apprentice
