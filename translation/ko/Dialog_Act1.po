msgctxt "hb7c6e82dga051g4f31ga191gfc7c12fb0c7b"
msgid "Hear, hear, ma'am!"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Checkpoint_Guard001
#. Speaker = Sentinel Olak
#. NodeID = 65254cec-37e4-610d-5518-de8fb5f8e9f5
#. HandlePath = TaggedText[2].TagText[0]
