#.      - REALLY_LAEZEL(2) = True
#. TagRule: !REALLY_GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_FistFight:18058462-81bb-6d45-ecbb-b0028e1fd24a
msgctxt "h4da8fea6g88ecg4aefg8d0eg6200df662ca5"
msgid ""
"You strike your prey, then offer aid? I will never understand your kind."
msgstr "사냥감을 잡아 놓고, 도움을 제의한다고? 네 종은 평생 이해할 수 없겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_FistFight
#. Speaker = Lae'zel
#. NodeID = 18058462-81bb-6d45-ecbb-b0028e1fd24a
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(2) = True
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_FistFight:18058462-81bb-6d45-ecbb-b0028e1fd24a
msgctxt "h2a46eec0gd72cg498bg8cf1gb724b107aa78"
msgid "You strike your prey, then offer aid? Deplorable."
msgstr "사냥감을 쓰러뜨리곤, 도움을 제안한다고? 개탄스럽군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_FistFight
#. Speaker = Player
#. NodeID = 1bca55c6-652e-3c0a-f01b-73ec54bf28c3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_DrunkGoblin_AskedToKiss(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_FistFight:1bca55c6-652e-3c0a-f01b-73ec54bf28c3
msgctxt "hc5c64285gad56g4dc8g89b3gbd1f815274f2"
msgid "Now. <i>You </i>should kiss <i>my </i>feet."
msgstr "자. <i>네가 내 발에</i> 입을 맞추시지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_FistFight
#. Speaker = Shadowheart
#. NodeID = 2131d33e-93cb-3670-af76-5188a3af4666
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_FistFight:2131d33e-93cb-3670-af76-5188a3af4666
msgctxt "h82480ff0g10adg473egba71g88c13b078e2e"
msgid ""
"Nicely done. I probably couldn't have resisted kicking him in the teeth."
msgstr "잘했어. 나였다면 저 녀석의 이빨을 걷어차는 걸 참기 어려웠을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_FistFight
#. Speaker = Player
#. NodeID = 232bec8e-c31c-6d81-b427-55388688fefb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_FistFight:232bec8e-c31c-6d81-b427-55388688fefb
msgctxt "h545f12ccg9f33g4239g8beege5fe6259d24b"
msgid "<i>Laugh at his eagerness and finish him off.</i>"
msgstr "<i>그의 간절함을 비웃고 그의 목숨을 끊는다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_FistFight
#. Speaker = Shadowheart
#. NodeID = 24342c2f-7333-0ce1-4eab-2bbfeddc3ca1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_FistFight:24342c2f-7333-0ce1-4eab-2bbfeddc3ca1
msgctxt "h5b16b785ga8cag46d4gbd25g295f493af98b"
msgid "I didn't realise we were here to make friends."
msgstr "여기 친구를 만들러 온 건지는 몰랐는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_FistFight
#. Speaker = Gale
#. NodeID = 2488fd62-dee5-0553-ec17-9151d2b94876
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_GALE(7) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_FistFight:2488fd62-dee5-0553-ec17-9151d2b94876
msgctxt "h88ec3fb2g5051g4fe0ga608gf4629591375d"
msgid "I hope you learned your lesson, young man!"
msgstr "이 정도면 교훈을 얻었길 바라지, 청년!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_FistFight
#. Speaker = Shadowheart
#. NodeID = 26cceb23-42a1-198f-ffd1-12a84cba64c1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(3) = True
#.   Tag:
#.      - REALLY_SHADOWHEART(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_FistFight:26cceb23-42a1-198f-ffd1-12a84cba64c1
msgctxt "h5146ee05g5afag4f48gbbeega47fed0e9550"
msgid "Good. We've had enough party games now, I think."
msgstr "좋아. 이 정도면 파티 게임은 충분히 즐긴 것 같네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_FistFight
#. Speaker = Lae'zel
#. NodeID = 2a23e49b-50eb-4a1a-30cb-ec0e7a18a891
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(2) = True
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_FistFight:2a23e49b-50eb-4a1a-30cb-ec0e7a18a891
msgctxt "h1a7a820bgaa8ag421ag815dg06e5dd82cf3c"
msgid "A fine show of dominance. Almost sweeter than blood. <i>Almost</i>."
msgstr "누가 위인지 확실히 보여줬군. 거의 피보다 달콤한 광경이야. <i>거의</i> 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_FistFight
#. Speaker = Player
#. NodeID = 2d56a03e-4096-9813-d997-03c389a64a77
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_FistFight:2d56a03e-4096-9813-d997-03c389a64a77
msgctxt "h07564d81g9f25g4fb0gb82agfdf4bcf885b8"
msgid "I think my point's been made. Come on, I'll help you up."
msgstr "이 정도면 내 뜻을 알아들었겠지. 자, 일으켜 세워 주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_FistFight
#. Speaker = Player
#. NodeID = 309e45ad-bba3-d3ee-55e6-5e16200ad9a7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_FistFight:309e45ad-bba3-d3ee-55e6-5e16200ad9a7
msgctxt "h95202747g6a60g44a7gab9dg17757c9b7ea4"
msgid "<i>Ignore his pleading and prepare for the finishing blow.</i>"
msgstr "<i>그의 애원을 무시하고 마무리 일격을 준비한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_FistFight
#. Speaker = Gale
#. NodeID = 37cabbef-09e9-d6b5-04fd-ba1d33d6e9d5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_GALE(7) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_FistFight:37cabbef-09e9-d6b5-04fd-ba1d33d6e9d5
msgctxt "hbba0650cga746g461cg8b42g2021cabbe4ea"
msgid "Courtesy is quite wasted on this fellow, I see."
msgstr "이 녀석에게 예의를 차릴 필요는 없겠지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_FistFight
#. Speaker = Crusher
#. NodeID = 3c023499-38f4-6656-9a86-0deebe680c33
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GOB_DrunkGoblin_Event_Spared(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_FistFight:3c023499-38f4-6656-9a86-0deebe680c33
msgctxt "h00d2e40cgdf1fg485cg8b9fg512060a056f0"
msgid "Gah. Arrogant <i>pig</i>."
msgstr "쳇. 오만한 <i>돼지</i> 같으니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_FistFight
#. Speaker = Astarion
#. NodeID = 429bfe39-843a-0ea9-ff4b-f9362a06efeb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(5) = True
#.   Tag:
#.      - REALLY_ASTARION(5) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_FistFight:429bfe39-843a-0ea9-ff4b-f9362a06efeb
msgctxt "h2c787ee3g06ebg41b4gbd07g13c07ff62958"
msgid "Ha! My, this place is fun."
msgstr "하! 여기 참 재밌는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_FistFight
#. Speaker = Gale
#. NodeID = 49b480d1-06f7-45f5-b073-8badaa282d9e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(7) = True
#.   Tag:
#.      - REALLY_GALE(7) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_FistFight:49b480d1-06f7-45f5-b073-8badaa282d9e
msgctxt "hc9502542g75bcg4fc5ga424g02fe74ce7f03"
msgid "Mercy is not your strong suit, is it?"
msgstr "자비는 너와 어울리지 않나 봐, 그렇지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_DrunkGoblin_FistFight
#. Speaker = Lae'zel
#. NodeID = 4bc8b491-eda1-8fbe-2399-dfc8ec683045
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - ORI_Inclusion_PickedAtRandom(2) = True
#.   Tag:
#.      - REALLY_LAEZEL(2) = True
