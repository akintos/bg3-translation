msgctxt "ha405bfbfg116cg4519g9ccbg625f0a29caa1"
msgid "I'm afraid you will not, <i>istik</i>."
msgstr "그렇게는 안 된다. <i>이스틱</i>."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointWarning
#. Speaker = Warrior Khunaruth
#. NodeID = fdee26bc-a2db-e2ff-5ebe-0dd15677db7b
