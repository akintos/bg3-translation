#: Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_MyconidCircle_InjuredGnome_AD_PainGrunt:da8812ef-d815-4ae7-a729-ae9fb0ac0730
msgctxt "h9cdd2200g4158g4835gb978g5c192500e79b"
msgid "<i>Argh</i>... damn it all."
msgstr "<i>아악</i>... 젠장할."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/ADs/UND_MyconidCircle_InjuredGnome_AD_PainGrunt
#. Speaker = Thulla
#. NodeID = da8812ef-d815-4ae7-a729-ae9fb0ac0730
