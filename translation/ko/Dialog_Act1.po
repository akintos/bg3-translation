msgctxt "hde126c06g46ebg4f89g8321g7c7553e486dd"
msgid "Arcane lights. Of course."
msgstr "비전 불빛이라. 그럼 그렇지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_ArcaneTower_PAD_Poems
#. Speaker = Player
#. NodeID = 83839bf1-cce1-4457-ab2f-082b4d446929
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
