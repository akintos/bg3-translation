msgctxt "h8c0bba0fg0425g4248g9120g1392896ec6ef"
msgid "Open passage... ancient forge... special..."
msgstr "길을 열어... 고대의 대장간... 특별해..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_FearfulRothe_Guard_001_Dead
