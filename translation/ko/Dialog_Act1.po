#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_DragonShadow:2420a414-311f-a483-b89d-d618377667e1
msgctxt "h45f7ac8agee12g4661gb6efgeac5f15f6422"
msgid "Blasted wyrm - where did it come from?"
msgstr "빌어먹을 웜 같으니, 어디서 나타난 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_DragonShadow
#. Speaker = Player
#. NodeID = 2420a414-311f-a483-b89d-d618377667e1
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Object:
#.      - PLA_GithChokepoint_State_FailedFrightenedSV(2) = True
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_DragonShadow:2420a414-311f-a483-b89d-d618377667e1
msgctxt "hbd1a5e18gf33eg4393gbf8bgb265089f4d01"
msgid "We stand no chance against such a foe. We should get out of sight!"
msgstr "저런 적을 상대할 수는 없어. 시야에서 벗어나자!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_DragonShadow
#. Speaker = Player
#. NodeID = 2420a414-311f-a483-b89d-d618377667e1
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Object:
#.      - PLA_GithChokepoint_State_FailedFrightenedSV(2) = True
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_DragonShadow:2420a414-311f-a483-b89d-d618377667e1
msgctxt "h813a02a3g2a79g4843ga385g10a46d9f6905"
msgid "Stay low - it might not see us."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_GithChokepoint_PAD_DragonShadow
#. Speaker = Player
#. NodeID = 2420a414-311f-a483-b89d-d618377667e1
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Object:
