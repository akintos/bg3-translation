msgctxt "h5ab2da5ag7219g41c8ga9fbg25c15e5eac61"
msgid "To the wetlands, is it? Why couldn't it have been an inn, or a winery?"
msgstr "결국 습지인가? 여관이나 술집이면 어디 덧나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_FairyRings_PAD_TeleportedFromUnderdarkToSwamp
#. Speaker = Player
#. NodeID = 056ebdff-ce1a-3a2b-1d28-1334257e07b3
