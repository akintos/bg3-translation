#.     - ORI_Karlach_Event_SetUpGoblinPriestBranch = True
#.   Object:
#.     - FactionHostileToPlayerGroupAfterDialog(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:c2f151d2-2ae6-774a-4b35-34698f3b67bc
msgctxt "h0170fa18gdefbg492fgb092g6431dbec5866"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Player
#. NodeID = c55614b2-5098-6268-5342-d4f92d704709
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:c55614b2-5098-6268-5342-d4f92d704709
msgctxt "h4a69857ag1ec6g494agbc21gb639d14dd372"
msgid "I've been looking for a healer - can you help?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = c57dcb09-c64b-09b6-8a20-69bdac6edbb9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_GoblinPriest_NotFollower(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:c57dcb09-c64b-09b6-8a20-69bdac6edbb9
msgctxt "h7261e59egc471g45b9g9a00ge7178bda9d0f"
msgid ""
"Only those that have faith are welcome here. Clear off before I cut you."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = Narrator
#. NodeID = c7e4634b-2661-1f69-2a8b-8b18ec368c77
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel:c7e4634b-2661-1f69-2a8b-8b18ec368c77
msgctxt "h6dfe2deag2dd2g419ega9f2g71351be4aac9"
msgid ""
"*She probes your mind, tangling your thoughts with hers. A familiar "
"sensation - she, too, carries a parasite.*"
msgstr ""
"*그녀가 당신의 정신을 탐색하여, 당신의 생각과 그녀의 생각이 뒤엉킵니다. 익숙한 감각입니다. 그녀도 기생충을 가지고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_GoblinPriest_Chapel
#. Speaker = True Soul Gut
#. NodeID = c897d4c4-fa42-4e85-d1a3-f117e1cb7e2d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_GoblinPriest_Event_CloseDoorFailed(0) = True
