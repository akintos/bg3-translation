msgctxt "h2b4d9b83gb75dg485bgab1fgbfb0a655182b"
msgid "<i>Sail to the cave shore.</i>"
msgstr "<i>동굴 호숫가로 항해한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/UND_DarkLake_DuergarBoatAtCamp
#. Speaker = Player
#. NodeID = 731f6ac3-f04e-4489-d186-94385d1fb1a3
