msgctxt "h0c4957ccga22bg4897g96adg5562f6bc50a2"
msgid "True Soul? Absolute? What were they raving on about?"
msgstr "참된 영혼? 절대자? 그들이 무슨 헛소리를 한 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_PriestsOfTheConqueringGod_PAD_PostScene
#. Speaker = Player
#. NodeID = 20dc1620-e337-5f7a-9fd1-c999644acf18
