msgctxt "he36bf79ag0b82g4d04g9e7dg003bd926f52c"
msgid "<i>Chk</i>. Fine - let the <i>ghustil</i> carry out your fate."
msgstr "<i>츠크</i>. 좋다 - <i>거스틸</i>이 네놈의 운명을 결정하게 두도록 하지."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
