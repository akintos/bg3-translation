msgctxt "hc4190adbg3153g4548gb0adg58a4d0c85861"
msgid "*The corpse regards you lifelessly.*"
msgstr "*시체가 생기 없는 모습으로 당신을 맞이합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_AD_ControlledByMask
#. Speaker = Player
#. NodeID = b971e04b-f97e-d892-adef-77ffadac8483
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_AD_ControlledByMask:b971e04b-f97e-d892-adef-77ffadac8483
msgctxt "h37245695g102cg462dg8dd4gae1ca224fd53"
msgid "No. Get out. GET OUT!"
msgstr "안돼. 나가. <b>나가</b>!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_AD_ControlledByMask
#. Speaker = Player
#. NodeID = b971e04b-f97e-d892-adef-77ffadac8483
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_AD_ControlledByMask:b971e04b-f97e-d892-adef-77ffadac8483
msgctxt "hf005b052g8907g4342g934cgd4daa0f1e445"
msgid "Out of my head, hag!"
msgstr "내 머리속에서 나가, 해그야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_AD_ControlledByMask
#. Speaker = Player
#. NodeID = b971e04b-f97e-d892-adef-77ffadac8483
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_AD_ControlledByMask:b971e04b-f97e-d892-adef-77ffadac8483
msgctxt "h469d17b5g32e5g474cg903dge007404953f3"
msgid "Try it hag! See what happens in this fucking head!"
msgstr "해봐, 해그야! 이 망할 머리속에서 어떤 일이 벌어지는지 보자고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_AD_ControlledByMask
#. Speaker = Player
#. NodeID = b971e04b-f97e-d892-adef-77ffadac8483
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_AD_ControlledByMask:b971e04b-f97e-d892-adef-77ffadac8483
msgctxt "h55405092g4156g418eg8bd4g7f6dca3909b9"
msgid "<i>Pa'vrylk! </i>Out of my head!"
msgstr "<i>Pa'vrylk! </i>내 머리에서 나가!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_AD_ControlledByMask
#. Speaker = Player
#. NodeID = b971e04b-f97e-d892-adef-77ffadac8483
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_AD_ControlledByMask:b971e04b-f97e-d892-adef-77ffadac8483
msgctxt "h0f7076ecg2cc7g4045g8373ga1edc2cc0a8f"
msgid "Get out of my head <i>at once!</i>"
msgstr "내 머릿속에서 나가, <i>당장!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_AD_ControlledByMask
#. Speaker = Player
#. NodeID = b971e04b-f97e-d892-adef-77ffadac8483
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_AD_ControlledByMask:b971e04b-f97e-d892-adef-77ffadac8483
msgctxt "hc2a43900g0a4ag4092g99f5g5c8bd1d3e687"
msgid "Damn it. Get out of my head!"
msgstr "젠장. 내 머릿속에서 나가!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_AD_ControlledByMask
#. Speaker = Player
#. NodeID = b971e04b-f97e-d892-adef-77ffadac8483
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_AD_ControlledByMask:b971e04b-f97e-d892-adef-77ffadac8483
msgctxt "h69a71cc2gf45cg4308g8481gbc5a2e25cddf"
msgid "Get out. GET OUT OF MY HEAD!"
msgstr "나가. <b>내 머릿속에서 나가라고</b>!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_AD_ControlledByMask
#. Speaker = Auntie Ethel
#. NodeID = d6a3635b-ac74-c5f5-eb5d-810359cc3aac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_AD_ControlledByMask:d6a3635b-ac74-c5f5-eb5d-810359cc3aac
msgctxt "h53eb43f9g0cd1g4746g8ac6g43bcd7130bb3"
msgid "Quiet, little one. Auntie will make it all better."
msgstr "쉿, 아가야. 이모가 편하게 해줄 거란다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_AD_PutOnMask
#. Speaker = Player
#. NodeID = 4a0ef2cd-6bd5-88a6-e2f7-9eeaf1d5f40a
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_AD_PutOnMask:4a0ef2cd-6bd5-88a6-e2f7-9eeaf1d5f40a
msgctxt "h36ea8ec8g9ac6g4e57g8a92gb3bee3a688cb"
msgid "The truth is revealed. In all its stinking glory."
msgstr "진실이 밝혀졌군. 이 모든 냄새나는 영광과 함께."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_AD_PutOnMask
#. Speaker = Player
#. NodeID = 4a0ef2cd-6bd5-88a6-e2f7-9eeaf1d5f40a
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_AD_PutOnMask:4a0ef2cd-6bd5-88a6-e2f7-9eeaf1d5f40a
msgctxt "h28bffbd7g7b67g4ef1ga462gcd0dd7062e4d"
msgid "Well now, to see through this mask is to see through different eyes."
msgstr "자 이제, 이 가면을 통해 본다는 건 또 다른 눈을 통해 보는 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_AD_PutOnMask
#. Speaker = Player
#. NodeID = 4a0ef2cd-6bd5-88a6-e2f7-9eeaf1d5f40a
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_AD_PutOnMask:4a0ef2cd-6bd5-88a6-e2f7-9eeaf1d5f40a
msgctxt "he5da9dafg42a0g4e5cg8926gf2906f67aa21"
msgid "There it is. The truth."
msgstr "여기 있군. 진실이."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_AD_PutOnMask
#. Speaker = Player
#. NodeID = 4a0ef2cd-6bd5-88a6-e2f7-9eeaf1d5f40a
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_AD_PutOnMask:4a0ef2cd-6bd5-88a6-e2f7-9eeaf1d5f40a
msgctxt "he9761408g3fa6g4777g9eefga63a6af1e914"
msgid "Curious. The illusion's been shattered."
msgstr "흥미롭군. 환영이 흩어져 버렸군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_AD_PutOnMask
#. Speaker = Player
#. NodeID = 4a0ef2cd-6bd5-88a6-e2f7-9eeaf1d5f40a
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_AD_PutOnMask:4a0ef2cd-6bd5-88a6-e2f7-9eeaf1d5f40a
msgctxt "hf040f7e8g2e2ag49e6ga908g824943133a27"
msgid "Talk about appearances being deceiving..."
msgstr "외모는 속일 수 있다더니..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_AD_PutOnMask
#. Speaker = Player
#. NodeID = 4a0ef2cd-6bd5-88a6-e2f7-9eeaf1d5f40a
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_AD_PutOnMask:4a0ef2cd-6bd5-88a6-e2f7-9eeaf1d5f40a
msgctxt "h669ded75gc187g44fcgabe7gc2aba7638ad7"
msgid "What in the... everything's <i>changed.</i>"
msgstr "뭐야 이게... 모든게 <i>변했군.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_AD_PutOnMask
#. Speaker = Player
#. NodeID = 4a0ef2cd-6bd5-88a6-e2f7-9eeaf1d5f40a
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_AD_PutOnMask:4a0ef2cd-6bd5-88a6-e2f7-9eeaf1d5f40a
msgctxt "h8ec144a7g3e50g4f4bga262g6220da8a9697"
msgid "Things look... different."
msgstr "모든게... 달라 보여."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_AD_PutOnMask
#. Speaker = Auntie Ethel
#. NodeID = fb7e564c-6817-58db-04a6-e3246c3ba285
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_AD_PutOnMask:fb7e564c-6817-58db-04a6-e3246c3ba285
msgctxt "hbfb5c34ag40dcg4384gb90fg9732518b8077"
msgid "Hello, petal. Just relax. Let me <i>in. </i>"
msgstr "안녕, 꽃잎아. 그냥 힘을 빼. 나를 <i>받아들여.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_AD_WearMask
#. Speaker = Auntie Ethel
#. NodeID = 18a29a89-02d8-2478-1f21-8b6800944bbe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 624ca66c-a2fa-e692-0c4d-57d292e14c8a_B = False
#.      - 624ca66c-a2fa-e692-0c4d-57d292e14c8a_A = True
#.   Object:
#.      - HAG_Mask_State_PossessedByHag(0) = False
#. SetFlags:
#.   Local:
#.     - 624ca66c-a2fa-e692-0c4d-57d292e14c8a_B = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_AD_WearMask:18a29a89-02d8-2478-1f21-8b6800944bbe
msgctxt "h4a98baadg0e08g40ebgbd8bga49608a0a7b8"
msgid "Stop fighting me, petal. Let me take care of you."
msgstr "거부하지 말거라, 꽃잎아. 너를 돌보게 해주렴."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_AD_WearMask
#. Speaker = Auntie Ethel
#. NodeID = 222eeaea-affc-57d1-1510-86ec54f65d44
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 624ca66c-a2fa-e692-0c4d-57d292e14c8a_D = True
#.      - 624ca66c-a2fa-e692-0c4d-57d292e14c8a_C = True
#.   Object:
#.      - HAG_Mask_State_PossessedByHag(0) = True
#. SetFlags:
#.   Local:
#.     - 624ca66c-a2fa-e692-0c4d-57d292e14c8a_D = False
#.     - 624ca66c-a2fa-e692-0c4d-57d292e14c8a_C = False
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_AD_WearMask:222eeaea-affc-57d1-1510-86ec54f65d44
msgctxt "h6bf14789g6837g4b61gaef5gec0cb53c951f"
msgid "Haha! I Knew you'd bow. Knew you'd BREAK."
msgstr "하하! 네가 굴복할 줄 알았다. <i>깨질 줄</i> 알았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_AD_WearMask
#. Speaker = Auntie Ethel
#. NodeID = 2409570b-3970-4b10-61cd-25230d1a7534
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 624ca66c-a2fa-e692-0c4d-57d292e14c8a_D = False
#.      - 624ca66c-a2fa-e692-0c4d-57d292e14c8a_C = True
#.   Object:
#.      - HAG_Mask_State_PossessedByHag(0) = True
#. SetFlags:
#.   Local:
#.     - 624ca66c-a2fa-e692-0c4d-57d292e14c8a_D = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_AD_WearMask:2409570b-3970-4b10-61cd-25230d1a7534
msgctxt "h17d553c4g097bg4a72g9d5dgc23cfe31f7c6"
msgid "YES. I've got you now, petal."
msgstr "<b>그래</b>. 이제 넌 내 거야, 꽃잎아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_AD_WearMask
#. Speaker = Auntie Ethel
#. NodeID = 45c57246-dd20-ef89-331a-3d14dc8dd9c6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 624ca66c-a2fa-e692-0c4d-57d292e14c8a_B = True
#.      - 624ca66c-a2fa-e692-0c4d-57d292e14c8a_A = False
#.   Object:
#.      - HAG_Mask_State_PossessedByHag(0) = False
#. SetFlags:
#.   Local:
#.     - 624ca66c-a2fa-e692-0c4d-57d292e14c8a_B = False
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_AD_WearMask:45c57246-dd20-ef89-331a-3d14dc8dd9c6
msgctxt "hf7ee3a5fg8b87g4e95gbe2ag134c265ffc62"
msgid "You can't resist me, sweetness. Not forever."
msgstr "넌 나를 거부할 수 없어, 아가야. 결국엔 무너지지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_AD_WearMask
#. Speaker = Auntie Ethel
#. NodeID = 4cc3e1f9-9040-f8e3-24d4-8a722a7ffc65
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 624ca66c-a2fa-e692-0c4d-57d292e14c8a_B = True
#.      - 624ca66c-a2fa-e692-0c4d-57d292e14c8a_A = True
#.   Object:
#.      - HAG_Mask_State_PossessedByHag(0) = False
#. SetFlags:
#.   Local:
#.     - 624ca66c-a2fa-e692-0c4d-57d292e14c8a_A = False
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_AD_WearMask:4cc3e1f9-9040-f8e3-24d4-8a722a7ffc65
msgctxt "h54420bc2g08c3g4550g8841gfa460f134b9b"
msgid "You'll break eventually, precious. They always do."
msgstr "언젠가는 무너질 거다, 이쁜 것. 결국엔 다들 그러지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_AD_WearMask
#. Speaker = Auntie Ethel
#. NodeID = 82467cce-8efc-a6b0-ecbb-ec185f7f62a2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 624ca66c-a2fa-e692-0c4d-57d292e14c8a_B = False
#.      - 624ca66c-a2fa-e692-0c4d-57d292e14c8a_A = False
#.   Object:
#.      - HAG_Mask_State_PossessedByHag(0) = False
#. SetFlags:
#.   Local:
#.     - 624ca66c-a2fa-e692-0c4d-57d292e14c8a_A = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_AD_WearMask:82467cce-8efc-a6b0-ecbb-ec185f7f62a2
msgctxt "h27818214g9223g4738gad80g4b848acde833"
msgid "Give in, sweet one. Serve your dear Auntie Ethel."
msgstr "굴복해라, 아가야. 사랑하는 에텔 이모를 모셔라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_AD_WearMask
#. Speaker = Auntie Ethel
#. NodeID = 9a301948-1c11-4a55-5b13-eaf1851b193a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 624ca66c-a2fa-e692-0c4d-57d292e14c8a_D = False
#.      - 624ca66c-a2fa-e692-0c4d-57d292e14c8a_C = False
#.   Object:
#.      - HAG_Mask_State_PossessedByHag(0) = True
#. SetFlags:
#.   Local:
#.     - 624ca66c-a2fa-e692-0c4d-57d292e14c8a_C = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_AD_WearMask:9a301948-1c11-4a55-5b13-eaf1851b193a
msgctxt "hbe38a97fgc61ag4291ga293g44e91747be1b"
msgid "HAH! You're MINE now, precious."
msgstr "<b>하!</b> 이제 너는 <b>내 거</b>야, 아가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_Lair
#. Speaker = Auntie Ethel
#. NodeID = 2dfedb92-4d88-8278-d5d5-d05bcba94f4f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_HagLair_PenOpened = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_Lair:2dfedb92-4d88-8278-d5d5-d05bcba94f4f
msgctxt "h0ed90c4ag8c48g405dgb005gf2994ad8ac6d"
msgid "You wretched little insect. I'm going to rip out your spine!"
msgstr "이 빌어먹을 벌레 같으니. 척추를 뽑아주겠어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_Lair
#. Speaker = Auntie Ethel
#. NodeID = 31883f07-5533-06c3-fce5-6abe46d4d7fb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_Lair:31883f07-5533-06c3-fce5-6abe46d4d7fb
msgctxt "hf30f5178gf66fg4bc6g9118g2a065b81ba48"
msgid "I'll use your blood to spice my stew."
msgstr "네 피는 스튜 양념으로 써주겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_Lair
#. Speaker = Auntie Ethel
#. NodeID = 3c54226c-3b51-c8b7-9951-6980d7a35ad9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_Lair:3c54226c-3b51-c8b7-9951-6980d7a35ad9
msgctxt "h8f88eb15g0f6bg444dg9aafg991522327207"
msgid "I'll keep you alive until I've sucked the marrow from your bones."
msgstr "끝까지 살려둔 채로 뼈의 골수까지 빨아내 주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_Lair
#. Speaker = Auntie Ethel
#. NodeID = 60e431bb-6467-2d56-3874-db37d1bcd5be
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_Lair:60e431bb-6467-2d56-3874-db37d1bcd5be
msgctxt "hfa5f0a10g1992g4602gb319ga2d9fdbbd1f2"
msgid "And then I'll bring you back and do it <i>all over again</i>."
msgstr "그리고 너를 다시 되살려서 이 <i>모든 걸 반복해 주마</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_Lair
#. Speaker = Mayrina
#. NodeID = aac136d2-1312-0323-563d-179f04f3c7bc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_Hagspawn_State_EthelKilledBrothers = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_Lair:aac136d2-1312-0323-563d-179f04f3c7bc
msgctxt "hb02ceb88g78dbg496aga2b4g4f4666b5549c"
msgid "Stop it! PLEASE. Let me go!"
msgstr "그만해요! 제발. 날 내보내줘요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_Lair
#. Speaker = Auntie Ethel
#. NodeID = c96cbbfb-0d47-124e-a0a8-e575da7c4336
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_Lair:c96cbbfb-0d47-124e-a0a8-e575da7c4336
msgctxt "h5a723a95geb43g4742ga243g99358680451a"
msgid "I'll rip your spine out your <i>arsehole</i>."
msgstr "네 <i>똥구멍</i>에서 척추를 빼내주겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_Lair
#. Speaker = Auntie Ethel
#. NodeID = cbb5ab60-2e86-e330-043b-c7f6c08607e0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_Lair:cbb5ab60-2e86-e330-043b-c7f6c08607e0
msgctxt "hd6f2195bg8276g4ae2gbdb4ga02fe979401a"
msgid ""
"You come to <i>my</i> home, interfere in <i>my </i>business, and now have "
"the <i>gall</i> to face me in the heart of my lair? You petulant bollocks."
msgstr ""
"<i>내</i> 집에 불쑥 와서는, <i>내</i> 일을 방해하고, 이제는 <i>뻔뻔스럽게</i> 내 은신처의 심장부에서 나를 맞이하는 "
"게냐? 이 못돼먹은 새끼야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_Lair
#. Speaker = Mayrina
#. NodeID = d4200249-d885-6cfa-2916-f09089fcae82
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_Lair:d4200249-d885-6cfa-2916-f09089fcae82
msgctxt "h6efcb244g9326g471ag981bg00f2451a9778"
msgid "Just get out of here! Please!"
msgstr "그냥 여기서 나가요! 제발!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1
#. Speaker = Player
#. NodeID = 0a803824-2c08-714a-a8b9-1c85e0caae45
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1:0a803824-2c08-714a-a8b9-1c85e0caae45
msgctxt "hbf31583cg1deag4c8dg9de7gb643efbcb5d5"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1
#. Speaker = Player
#. NodeID = 0cf766fb-5d46-9546-08bf-fab3058434ed
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAG_MaskedVictim1_NotOver(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1:0cf766fb-5d46-9546-08bf-fab3058434ed
msgctxt "hf3fbb7b3g8f30g4792ga369g289592a9ee37"
msgid "What do you mean 'this isn't over'?"
msgstr "끝은 아니라니 무슨 말이야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1
#. Speaker = Player
#. NodeID = 2871ea6f-b088-d7e2-29cd-29159d241083
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAG_MaskedVictim1_NotOver(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1:2871ea6f-b088-d7e2-29cd-29159d241083
msgctxt "hd1aa08e5gac38g4875g9947gb5428a8cc212"
msgid "Take whatever time you need - the hag's not coming back."
msgstr "얼마든지 여유롭게 행동해. 해그가 돌아오진 않을 테니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1
#. Speaker = Mask of Regret
#. NodeID = 28d77b69-efb8-302c-53e1-c0a1de57a747
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - HAG_MaskedVictim1_NotOver(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1:28d77b69-efb8-302c-53e1-c0a1de57a747
msgctxt "had0f104dg16f6g4846g9b57gc6d4e897d3a9"
msgid "Home, to Baldur's Gate. This isn't over yet."
msgstr "집으로. 발더스 게이트에 갈 거야. 이걸로 끝은 아니니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1
#. Speaker = Mask of Regret
#. NodeID = 2940d713-71a7-2b21-4145-ce0e02e6c101
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - HAG_MaskedVictim1_HasMetSurvived(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1:2940d713-71a7-2b21-4145-ce0e02e6c101
msgctxt "h2673ceadgd7e3g4bcag9fbcg13f497b06cc2"
msgid ""
"There's more hags out there - and I'm going to do what I can to make sure no "
"one else has to go through what I did."
msgstr "해그는 더 많이 있어. 아무도 다시는 나 같은 일을 겪지 않도록 뭐라도 해볼 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1
#. Speaker = Mask of Regret
#. NodeID = 2fe590b7-fa9b-f256-819b-7219d1c32e74
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1:2fe590b7-fa9b-f256-819b-7219d1c32e74
msgctxt "h7cab41e1g6058g470eg9659g813697519c97"
msgid "I know."
msgstr "맞아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1
#. Speaker = Player
#. NodeID = 30b4ac1f-e89f-706c-395d-8e1499e48363
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1:30b4ac1f-e89f-706c-395d-8e1499e48363
msgctxt "h5514c6c7g8ee8g4797gaab3g9a6ff52eb6e2"
msgid "How did you end up here?"
msgstr "어쩌다 여기까지 오게 된 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1
#. Speaker = Player
#. NodeID = 34425edb-12ac-1ede-8e61-01131b4f9aaa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1:34425edb-12ac-1ede-8e61-01131b4f9aaa
msgctxt "hac3b125ag16e9g47edg949cgddd95b505942"
msgid "You served her - give me one good reason to let you live."
msgstr "넌 해그를 섬겼지. 널 살려줘야 할 이유를 하나라도 대 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1
#. Speaker = Player
#. NodeID = 3476d405-c690-1eee-eb2f-9a3c9a06d67e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAG_MaskedVictim1_NotOver(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1:3476d405-c690-1eee-eb2f-9a3c9a06d67e
msgctxt "h62f57497g6debg402fg9925gff751a0e6437"
msgid "Where will you go?"
msgstr "어디로 갈 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1
#. Speaker = Mask of Regret
#. NodeID = 3c150e7a-8636-1ccc-cecd-ef34a6b48cb2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAG_MaskedVictim1_NotOver(1) = True
#.      - HAG_MaskedVictim1_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1:3c150e7a-8636-1ccc-cecd-ef34a6b48cb2
msgctxt "hd3851985g997dg4d3ega2c3g777186a6a8c9"
msgid ""
"As soon as my head's clear, I'm heading back to Baldur's Gate to finish this."
msgstr "머리만 좀 정리되면 바로 발더스 게이트로 가서 끝을 내겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1
#. Speaker = Player
#. NodeID = 4dd025ad-92b6-7ae0-80e1-f874fae66bbf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1:4dd025ad-92b6-7ae0-80e1-f874fae66bbf
msgctxt "h92e6d42agdf7fg43a3gb5adgdc1c007e9150"
msgid "Pull yourself together - the hag's dead. I made sure of it."
msgstr "정신 차려. 해그는 죽었어. 내가 확실히 죽였다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1
#. Speaker = Mask of Regret
#. NodeID = 52d00756-453b-2645-f45d-010adad37e1e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1:52d00756-453b-2645-f45d-010adad37e1e
msgctxt "h3e81389dg00f8g4f1bga345gcde46cda3939"
msgid ""
"It was the mask. It dug its roots into me... took away my will. I tried to "
"fight it."
msgstr "가면 때문이야. 내게 뿌리를 내리고서... 자유 의지를 빼앗았어. 나도 저항하려 했다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1
#. Speaker = Mask of Regret
#. NodeID = 69d8ff15-5add-78ab-b721-f032126bf6b1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1:69d8ff15-5add-78ab-b721-f032126bf6b1
msgctxt "h9ded4e98g2d9cg432dgb24dged1d0fff07ad"
msgid "You're right. I don't feel her anymore... she's really gone."
msgstr "네 말이 맞아. 더는 해그가 느껴지지 않아... 정말로 사라졌구나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1
#. Speaker = Player
#. NodeID = 6bd30dcd-ffb8-0a34-029e-91ea690fa270
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1:6bd30dcd-ffb8-0a34-029e-91ea690fa270
msgctxt "h8e965a58g780dg4784g93e0gc20544f8a4b4"
msgid "You're lucky I didn't cut you down."
msgstr "널 그냥 죽이지 않았던 걸 다행으로 알아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1
#. Speaker = Mask of Regret
#. NodeID = 6d98461d-9f4e-d4b8-4487-1d873051f0f4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1:6d98461d-9f4e-d4b8-4487-1d873051f0f4
msgctxt "h4063d702gf3bfg4fb7gbfb7g8439d5f700e4"
msgid ""
"Heard about this wise woman out in the back-end of nowhere who could help. I "
"knew it was too good to be true. But I didn't care."
msgstr "어디 구석에서 도울 수 있는 노파가 있다는 말을 들었지. 사실이라기엔 너무 달콤한 이야기인 건 알았지만, 어쩔 수 없었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1
#. Speaker = Mask of Regret
#. NodeID = 720de0db-d0f1-4ceb-a41d-ff80edf7137a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAG_MaskedVictim1_NotOver(1) = False
#.      - HAG_MaskedVictim1_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1:720de0db-d0f1-4ceb-a41d-ff80edf7137a
msgctxt "h51d85d4cg7a63g48e9g88f3g826e31ac9816"
msgid ""
"I think the danger's passed, but my head's still spinning. I'll leave when "
"I'm steadier on my feet."
msgstr "당장 위험은 지난 것 같지만, 머리가 아직도 어지러워. 제대로 걸을 수 있을 것 같으면 떠나겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1
#. Speaker = Mask of Regret
#. NodeID = 7cdaef00-b2d1-9216-ce94-16c3f76b70a0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1:7cdaef00-b2d1-9216-ce94-16c3f76b70a0
msgctxt "ha3a2f8c1gc356g494cgac8dg38288e8da03d"
msgid ""
"But she's been luring victims here for years - plenty of other folk will be "
"grateful too. I'll make sure they know your name."
msgstr ""
"다만, 오랜 세월 동안 해그는 수많은 희생자를 끌어들였지. 고마워할 사람이 많을 거야. 다들 당신 이름을 알 수 있도록 널리 알릴게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1
#. Speaker = Mask of Regret
#. NodeID = 81752635-4c45-dc62-3bb2-662e08702260
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_Hag_SummonedVictims = False
#.      - HAG_Hag_State_IsDead = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1:81752635-4c45-dc62-3bb2-662e08702260
msgctxt "h2876e80fgcc7cg4a66g881bg11b6e8493c20"
msgid "We need to leave. You're not supposed to be here - she'll be furious."
msgstr "떠나야 해. 당신은 여기 있으면 안 돼. 해그가 분노할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1
#. Speaker = Mask of Regret
#. NodeID = 8b7b0995-17fd-5200-1278-61572045ed00
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_Hag_SummonedVictims = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1:8b7b0995-17fd-5200-1278-61572045ed00
msgctxt "h4b3cb584g50e7g4140ga129g5e28ab51bebb"
msgid ""
"We need to leave - she might not be dead. I don't even know if she <i>can</"
"i> die."
msgstr "어서 떠나야 해. 해그가 안 죽었을지도 몰라. 죽는 게 <i>가능한지조차</i> 모르겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1
#. Speaker = Mask of Regret
#. NodeID = 8e94859b-c8be-1dd4-edc3-c8ac0e7bbe32
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - HAG_MaskedVictim1_HasMetSurvived(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1:8e94859b-c8be-1dd4-edc3-c8ac0e7bbe32
msgctxt "h4fe146b0g473ag477dg8dddgf0d01e953019"
msgid "I'm feeling stronger by the minute. I'll be fine."
msgstr "점점 힘이 돌아오는 게 느껴지네. 난 괜찮으니 걱정 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1
#. Speaker = Mask of Regret
#. NodeID = 95506ad6-80ec-15c3-29eb-46c506e80c01
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1:95506ad6-80ec-15c3-29eb-46c506e80c01
msgctxt "h22e4d3e6g3d6eg4310gb1a4ga7cb2899376b"
msgid "You think Ethel was the only hag in the realms? Not by a long shot."
msgstr "에텔이 렐름에서 유일한 해그인줄 알았어? 절대 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1
#. Speaker = Mask of Regret
#. NodeID = a3e6901e-832a-598a-1177-9ee1024f1ed8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1:a3e6901e-832a-598a-1177-9ee1024f1ed8
msgctxt "h50589fd3g0066g4ee8ga693gdabd45d504da"
msgid "I'd have begged Myrkul himself if I thought he'd listen."
msgstr "머큘이라도 찾아가서 빌었을 거야. 내 말을 들어주기만 했다면."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1
#. Speaker = Player
#. NodeID = a4fdda69-fc03-35b3-d890-7ab7f93bf64b
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - HAG_MaskedVictim1_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1:a4fdda69-fc03-35b3-d890-7ab7f93bf64b
msgctxt "hee90b4deg0ce4g4bd2gbf58g6615e13cf330"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1
#. Speaker = Player
#. NodeID = a55d7c5d-834b-129b-ed41-44d2d6471589
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1:a55d7c5d-834b-129b-ed41-44d2d6471589
msgctxt "h32078d87g1830g420cga7f5ge556e10595f5"
msgid "Where will you go now that you're free?"
msgstr "이제 자유를 얻었는데 어디로 갈 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1
#. Speaker = Player
#. NodeID = a65ecbc1-977c-a0a5-f35b-2bcf5e56c563
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1:a65ecbc1-977c-a0a5-f35b-2bcf5e56c563
msgctxt "h7e348fecgaa2eg4328gbcabg6f008a653f6c"
msgid "How do you feel now?"
msgstr "지금은 기분이 어때?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1
#. Speaker = Mask of Regret
#. NodeID = a81249ce-acb8-e6e5-0f8e-63ba8c87553a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1:a81249ce-acb8-e6e5-0f8e-63ba8c87553a
msgctxt "h30299783g010fg4f8bg9f09g8049a23f5ca1"
msgid ""
"Sheer desperation. My mother's mind is gone... she's forgotten herself. I "
"tried medicine, magic, prayer."
msgstr "절박함 때문이었지. 우리 어머니의 정신이 흐려지셨어... 자신이 누구인지도 몰라. 약, 마법, 기도를 전부 다 해 봤어. "

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1
#. Speaker = Player
#. NodeID = af725342-8a63-a62c-0478-dd69d9c01ed0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1:af725342-8a63-a62c-0478-dd69d9c01ed0
msgctxt "h79b04f17g6ea6g49b3g8661g0ba36f3ea848"
msgid "That warrants a reward, wouldn't you say?"
msgstr "내가 그렇게 해 줬으니 보상을 주는 게 맞겠지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1
#. Speaker = Player
#. NodeID = b1c99cba-d6b4-e5c3-452d-4ca6150d8006
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1:b1c99cba-d6b4-e5c3-452d-4ca6150d8006
msgctxt "h1f0fdffeg387bg4979g95f1g0486a5f43ea9"
msgid "She's dead. You're safe now."
msgstr "해그는 죽었어. 당신은 이제 안전해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1
#. Speaker = Player
#. NodeID = bb353dfe-dab7-da59-967c-648d9acc2889
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1:bb353dfe-dab7-da59-967c-648d9acc2889
msgctxt "hcf54f33cg030dg434fgbf7aga6350247b4b3"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1
#. Speaker = Mask of Regret
#. NodeID = bc278a51-fe69-3673-da36-873cf11c3c0d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1:bc278a51-fe69-3673-da36-873cf11c3c0d
msgctxt "hc4476e13g498bg4e7bg9122g77296e375da8"
msgid ""
"The hag took everything except my life. Gratitude's all I can offer for now."
msgstr "그 해그가 내 목숨 빼고 모든 걸 앗아갔어. 지금은 고맙다는 말밖에 못 하겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1
#. Speaker = Mask of Regret
#. NodeID = c035c6f6-e206-c187-a7c4-5d185a66deaf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1:c035c6f6-e206-c187-a7c4-5d185a66deaf
msgctxt "head99796g2f12g4a27g965cgb460cf082cde"
msgid "I thought I was lost... could feel my mind slipping away."
msgstr "난 끝장일 줄 알았어... 내 정신이 망가지는 게 느껴졌다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1
#. Speaker = Mask of Regret
#. NodeID = c03b4b7b-cd04-e58d-33b3-b58f1b47ec13
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - GLO_Background_FolkHero_Act1_HagThralls(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1:c03b4b7b-cd04-e58d-33b3-b58f1b47ec13
msgctxt "he1e7b62cg6faeg4ae8gb405gfa606366a9df"
msgid ""
"If it weren't for you, I would have ended up like the others. Hollowed out "
"and as good as dead."
msgstr "당신이 아니었다면 여기 다른 사람들처럼 됐겠지. 껍데기만 남아서 죽은 거나 다름없는 상태로."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1
#. Speaker = Mask of Regret
#. NodeID = c6504930-55bb-f306-95b7-f3851569ca53
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - HAG_Hag_SummonedVictims = False
#.      - HAG_Hag_State_IsDead = False
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1:c6504930-55bb-f306-95b7-f3851569ca53
msgctxt "h04bee70egcec2g42c7gb683g3b5c42ef13e6"
msgid "Auntie only wants what's best for us."
msgstr "이모는 다 우리를 위해서 그러는 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1
#. Speaker = Player
#. NodeID = d97cbe79-ec56-44f2-642e-3fc96389db12
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1:d97cbe79-ec56-44f2-642e-3fc96389db12
msgctxt "hd7c611d4g13a0g493eg9690gfc6905ad0360"
msgid "<i>Attack.</i>"
msgstr "<i>공격한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1
#. Speaker = Mask of Regret
#. NodeID = f794325b-0d20-bd63-5c8d-309765052993
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1:f794325b-0d20-bd63-5c8d-309765052993
msgctxt "hec54968ege0f0g4f34g8748gdec5a6b9b0f3"
msgid "Better... less confused."
msgstr "좀 나아... 덜 혼란스러워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/HagLair/HAG_Hag_MaskedVictim1_AD_FailResist
