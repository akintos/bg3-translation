#.      - TRUESOUL(1) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinSleeper_02:78d247b6-6fe9-c211-04c5-50b84f451f96
msgctxt "hff2cbc85gc3bcg44e1gb539g7c93af7e9b72"
msgid "Nothing. Lie back down and be silent."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinSleeper_02
#. Speaker = Narrator
#. NodeID = 80e8efb5-074d-3fa6-049e-1b6c0877f392
