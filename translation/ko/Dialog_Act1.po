msgctxt "hce8b0e2bg9347g445dg982eg8b8b425801fb"
msgid "No hard feelings, I hope."
msgstr "악감정은 없길 바라지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_ZhentDungeon_Zhent01
#. Speaker = Salazon
#. NodeID = 21244216-cfa3-038b-0b7c-bfe20b129274
