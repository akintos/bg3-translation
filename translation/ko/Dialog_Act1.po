#. Speaker = Volo
#. NodeID = 08e68a4e-9fa3-221d-ec08-c0631eb5133d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_VoloBallad_AD_Song:08e68a4e-9fa3-221d-ec08-c0631eb5133d
msgctxt "h98257b2eged42g4ccdg8948g995475751800"
msgid "His troops will disarm you and groar you the truth!"
msgstr "그댈 쓰러뜨리고 읊을 그분 절대자의 진실이다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_VoloBallad_AD_Song
#. Speaker = Volo
#. NodeID = 1c8fc4f7-9e0b-f93f-c68d-ffd2c99acf46
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_VoloBallad_AD_Song:1c8fc4f7-9e0b-f93f-c68d-ffd2c99acf46
msgctxt "hcb947e93g45bbg4809gb863gf95dc9e76ced"
msgid "- goblinkind will attease you and frelk you, areaded!"
msgstr "...고블린 부족 괴롭히고 목숨을 굴욕칠 테니!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_VoloBallad_AD_Song
#. Speaker = Volo
#. NodeID = 3a38ae56-1941-b0af-e0d4-3d2994c59121
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_VoloBallad_PlayedAD2(0) = True
#.      - GOB_VoloBallad_PlayedAD1(0) = True
#. SetFlags:
#.   Dialog:
#.     - GOB_VoloBallad_PlayedAD2(0) = False
#.     - GOB_VoloBallad_PlayedAD1(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_VoloBallad_AD_Song:3a38ae56-1941-b0af-e0d4-3d2994c59121
msgctxt "heee14f39g6726g4f32g81d3geb6ea101c327"
msgid "Hear Volo! I cry far and wide for great glory!"
msgstr "볼로가 고하노라! 위대한 영광을 내, 널리, 고함쳐 외치겠노라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_VoloBallad_AD_Song
#. Speaker = Volo
#. NodeID = 492b04ad-db21-fb27-74e1-d5f25a3b98fb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_VoloBallad_AD_Song:492b04ad-db21-fb27-74e1-d5f25a3b98fb
msgctxt "hfb0d068cga363g4686g8543gc44e309f6694"
msgid "The True Souls are coming, their lounders awake."
msgstr "참된 영혼이 다가오니 모두 정신 차려라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_VoloBallad_AD_Song
#. Speaker = Volo
#. NodeID = 626cee10-6c23-7a6a-a6d8-0e368a225d56
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_VoloBallad_AD_Song:626cee10-6c23-7a6a-a6d8-0e368a225d56
msgctxt "hd1910193gff9fg44d1g8fecgb8abeecdbfee"
msgid "A new age is dawning, with goblins atrust!"
msgstr "새론 시대 보이노니, 열망에 찬 고블린 되거라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_VoloBallad_AD_Song
#. Speaker = Volo
#. NodeID = 72f29aae-3c73-0316-f397-9c7aec56382f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_VoloBallad_AD_Song:72f29aae-3c73-0316-f397-9c7aec56382f
msgctxt "hd2865fbfg86c8g4a8dg8cfcgda4b1ae68ba9"
msgid "Dror Ragzlin's best make is a blade in the quarry!"
msgstr "드롤 라그즐린 최고의 작품, 내 보니 꿰뚫린 사냥감이라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_VoloBallad_AD_Song
#. Speaker = Volo
#. NodeID = 8de72362-c13e-ecb9-87cd-ebec907b8c96
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GOB_VoloBallad_Event_Leave(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_VoloBallad_AD_Song:8de72362-c13e-ecb9-87cd-ebec907b8c96
msgctxt "h2dcf6b89gea3ag4f46g9162g23b769ff29fe"
msgid "Alas, alack, a-rap-a-dash!"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_VoloBallad_AD_Song
#. Speaker = Volo
#. NodeID = aa264421-df11-0318-1f6c-e22fd4ce43b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_VoloBallad_AD_Song:aa264421-df11-0318-1f6c-e22fd4ce43b4
msgctxt "h65c25710g14c8g4357gbc26g0f4b9b21ace2"
msgid "Mountains' great mortals, all ginders to quake."
msgstr "참으로 위대한 산맥의 이, 모두 몸을 떨어라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_VoloBallad_AD_Song
#. Speaker = Volo
#. NodeID = b6beb2bb-7948-b0c1-2e2f-e36046ab81f2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_VoloBallad_AD_Song:b6beb2bb-7948-b0c1-2e2f-e36046ab81f2
msgctxt "hc9c5f0d8g564dg4302ga71dg59c63ff6cde3"
msgid "His name is Dror Ragzlin, his voice Absolute."
msgstr "이름하여 드롤 라그즐린, 그분 절대적인 목소리가!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_VoloBallad_AD_Song
#. Speaker = Volo
#. NodeID = cbb9db8a-6d01-ed0f-4c1f-80f3c5185451
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_VoloBallad_PlayedAD1(0) = False
#. SetFlags:
#.   Dialog:
#.     - GOB_VoloBallad_PlayedAD1(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_VoloBallad_AD_Song:cbb9db8a-6d01-ed0f-4c1f-80f3c5185451
msgctxt "h34ab5779g0c63g4c6ag8dabg4d95ead88770"
msgid "Be you beguiling or be you beheaded -"
msgstr "머리 잘못 굴리다간 머리통 굴러갈 테지..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_VoloBallad_AD_Song
#. Speaker = Volo
#. NodeID = f7404df6-9e09-9b26-dec8-db3e840df667
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_VoloBallad_AD_Song:f7404df6-9e09-9b26-dec8-db3e840df667
msgctxt "h98bd9907ge930g4307g8319gcdc5aff90d50"
msgid "Volo's fate changes oh-so-fast..."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_VoloBallad_AD_Song
#. Speaker = Volo
#. NodeID = fa17006c-2426-7528-769e-8f64ee505817
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_VoloBallad_PlayedAD2(0) = False
#.      - GOB_VoloBallad_PlayedAD1(0) = True
#. SetFlags:
#.   Dialog:
#.     - GOB_VoloBallad_PlayedAD2(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_VoloBallad_AD_Song:fa17006c-2426-7528-769e-8f64ee505817
msgctxt "h9ff13bc1g2f64g4bb6g9872g154c7d4781e1"
msgid "Laugh if you dare! Recoil, as you must!"
msgstr "감히 웃음 보이거라! 열심히 잘 도망가 보거라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_VoloBallad_AD_StudyingGoblins
