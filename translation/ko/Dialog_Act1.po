#.     - GOB_TorturedAdventurer_State_FailedPersuasion = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:f047f43b-6c6e-db5d-f7e4-821f1511f4fe
msgctxt "h716ac9d7g3e0bg40b4gac97g95015febaeab"
msgid "Y-you could've killed them! Just... just leave, please!"
msgstr "그-그들을 죽였을 수도 있잖아요! 그냥... 그냥 떠나 주세요, 제발요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = f10bfa82-a579-4c3b-1591-c1590d47e391
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:f10bfa82-a579-4c3b-1591-c1590d47e391
msgctxt "hb3d1311bgb3e3g4336gb744g4e027fa7574d"
msgid "... I'm... I'm free."
msgstr "... 푸... 풀려났군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = f2ece6fe-7797-f21c-13ea-e4da05963106
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:f2ece6fe-7797-f21c-13ea-e4da05963106
msgctxt "hd50d0a2ag00c0g45b0ga159g111a91b5c18f"
msgid ""
"P-please! You kn-know where the grove is! Th-there's nothing I can tell "
"you... please, let me go!"
msgstr "제-제발요! 숲이 어-어디에 있는지 아시잖아요! 더-더 이상 알려드릴 수 있는 건 없어요... 제발, 절 보내주세요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = f4d7df39-e2d2-a887-24bd-7fe94ac7ae28
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 6621e6ea-f89e-a19d-e8dc-6e6bc0779404_MindHasBeenRead = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:f4d7df39-e2d2-a887-24bd-7fe94ac7ae28
msgctxt "h25c3aafagc55fg41a8g8662g89c9b2302ac2"
msgid "Remira sent me. She said you were in trouble."
msgstr "레미라가 나를 보냈어. 그녀가 말하길 네가 곤경에 처해 있다더군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = f5872796-cd5e-25ab-e60f-888e2973bc1e
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_TorturedAdventurer_Knows_WasLookingForSH = True
#.   Quest:
#.     - SHA_Nightsong.LearnedLocation(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:f5872796-cd5e-25ab-e60f-888e2973bc1e
msgctxt "h42ecbc12gb81bg49a2ga197ga1704c86518f"
msgid ""
"Y-yes, it should be here somewhere. They said there was a hidden passage "
"underneath this temple."
msgstr "그-그래요, 여기 어딘가에 있을 거예요. 이 신전 아래에 숨겨진 통로가 있다고 들었어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = f703cce3-5a42-aced-b5f9-59f9dc208ce1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:f703cce3-5a42-aced-b5f9-59f9dc208ce1
msgctxt "h68c8a4aagc46dg4c17ga32egbce8439acaf5"
msgid ""
"Remira? She's... she's alive then. Oh, thank the gods. I - I need to get out "
"of here."
msgstr "레미라가요? 그녀가... 그녀가 살아남았다는 거군요. 오, 신이시여, 감사합니다. 전-전 여기서 빠져나가야 해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Player
#. NodeID = f71480b1-e7bb-36ed-7083-0ed7f05c28b5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:f71480b1-e7bb-36ed-7083-0ed7f05c28b5
msgctxt "h82437f89g538eg456cg9f66g22a9777e867c"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer
#. Speaker = Liam
#. NodeID = f92c4c0a-677f-79be-7dd1-5bb687bb4a44
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_TortureredAdventurer:f92c4c0a-677f-79be-7dd1-5bb687bb4a44
msgctxt "hd14a7c4agf328g44c4gb2abg3a8bfb9dd72c"
msgid "Th-thank you! Thank you so much!"
msgstr "가-감사합니다! 정말 감사합니다!"

