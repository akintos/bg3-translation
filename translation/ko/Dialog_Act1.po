msgctxt "h3edc411dg1f7bg49e8g893fg134113e27560"
msgid "What is the creature doing to those corpses?"
msgstr "저 생물체가 시체로 뭘 하려는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_MyconidCircle_VB_SawCorpse_Companions
#. Speaker = Player
#. NodeID = fddb56af-7c31-3efc-cfd7-cfd9e715e775
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_GALE or REALLY_UNDERDARK or WIZARD
#: Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_MyconidCircle_VB_SawCorpse_Companions:fddb56af-7c31-3efc-cfd7-cfd9e715e775
msgctxt "hc6fc1b2cgd6ddg479egbdbeg62a0c1846c73"
msgid "Yes. Myconids are more powerful than you realise."
msgstr "그래. 마이코니드들은 생각보다 강력하지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Underdark/VBs/UND_PAD_BarrelstalkInteraction
#. Speaker = Player
#. NodeID = a319cca9-ccf6-c736-a43c-040d1c333c8c
