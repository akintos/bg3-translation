msgctxt "h4c8e910egbc63g497dgb971ga0534d2dec78"
msgid "Chased elf... brains chased me..."
msgstr "쫓기던 엘프... 뇌가 내게 달려들었어..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Crash/CRA_DeadFisherman5_Dead
