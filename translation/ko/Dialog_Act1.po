msgctxt "h06d46719g19d7g4809ga55dg671a3c48ab07"
msgid "Hmph."
msgstr "흐읍."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear
#. Speaker = Player
#. NodeID = 52151704-7204-a9b3-2df5-af9095246cd7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_Tadpoled_UsedToday1(4) = False
#.   Tag:
#.      - TRUESOUL(4) = True
#. SetFlags:
#.   Object:
#.     - GLO_Tadpoled_UsedToday1(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear:52151704-7204-a9b3-2df5-af9095246cd7
msgctxt "h57cd2e12g0e07g41e3ga4d6g5021432b0745"
msgid "Let him out. I'll take care of the beast."
msgstr "녀석을 풀어줘. 내가 이 야수를 돌보겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear
#. Speaker = One
#. NodeID = 54021fbb-37cc-d297-9f25-c04026f65e20
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear:54021fbb-37cc-d297-9f25-c04026f65e20
msgctxt "hccae558dg84efg433egb46dgb2aed2aa9b36"
msgid "We made it squeal!"
msgstr "우리가 비명을 지르게 했어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear
#. Speaker = Player
#. NodeID = 5e43db36-0271-ba49-eb9f-887c424ddefc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear:5e43db36-0271-ba49-eb9f-887c424ddefc
msgctxt "hc4d28694gfa8fg48degb20dga6d43e39ce37"
msgid "<i>Turn away.</i>"
msgstr "<i>외면한다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear
#. Speaker = Brawler Birka
#. NodeID = 5eb36859-0cee-76c1-c078-486f04406410
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear:5eb36859-0cee-76c1-c078-486f04406410
msgctxt "h87974de5g5b20g43bcg957dg6acffeacd9b6"
msgid "Keep yer hand steady, Three."
msgstr "조준 잘 해라, 셋째야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear
#. Speaker = Brawler Birka
#. NodeID = 65ce5674-ef91-6f70-83b3-0217b18ced57
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear:65ce5674-ef91-6f70-83b3-0217b18ced57
msgctxt "hdbb2117fg50b0g4a9fg9f60gf5d90bff19b8"
msgid "How dare ya."
msgstr "어떻게 감히."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear
#. Speaker = Narrator
#. NodeID = 6a68d5f5-794a-c0a1-d7fe-a33b3f9eac52
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   User:
#.      - GLO_TadpoleIntro_NPC(4) = False
#. SetFlags:
#.   User:
#.     - GLO_TadpoleIntro_NPC(4) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear:6a68d5f5-794a-c0a1-d7fe-a33b3f9eac52
msgctxt "hfb382810ga7e1g4e55g87f3g8d2bb820cc40"
msgid ""
"*A strange symbol glows, marked on their flesh, and something within you "
"stirs in response.*"
msgstr "*그들의 살갗에 새겨진 기묘한 상징이 빛나고, 이에 반응하여 당신 내면의 무언가가 꿈틀거립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear
#. Speaker = Player
#. NodeID = 6b19677b-a5b3-27ce-6fa4-17af623501c8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - GOB_WolfPens_Event_SidedWithPrisoner = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear:6b19677b-a5b3-27ce-6fa4-17af623501c8
msgctxt "hffd0a83cgf5e1g4d6agb7a4g5cd18d08685b"
msgid "Then I'll just have to kill you."
msgstr "그럼 널 죽일 수 밖에 없겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear
#. Speaker = Player
#. NodeID = 7375590f-fbf6-7dae-e6e6-6dc5d148e74c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear:7375590f-fbf6-7dae-e6e6-6dc5d148e74c
msgctxt "h8416ab95g8defg4623g8e2agadca584c5d42"
msgid "What the hells are you doing?"
msgstr "대체 무슨 짓이야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear
#. Speaker = Brawler Birka
#. NodeID = 745a4cd0-2c23-827b-2e6a-6e8e8c963e17
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear:745a4cd0-2c23-827b-2e6a-6e8e8c963e17
msgctxt "hf2550149g9f6cg469bgb9e0gbd3e492bc870"
msgid ""
"All right, all right, if you're gonna throw a tantrum about it. Never seen "
"someone so worked up over a stupid animal."
msgstr "알았어, 알았어, 그만 성질부려. 멍청한 동물 하나 가지고 저렇게 열 내는 놈은 또 처음 보네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear
#. Speaker = Halsin
#. NodeID = 7468032b-3ca6-a2ee-f62f-075dc1415959
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(4) = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear:7468032b-3ca6-a2ee-f62f-075dc1415959
msgctxt "h809d7261gd65fg4765gba50g708f8b0b9d39"
msgid "*Growl.*"
msgstr "*으르렁.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear
#. Speaker = Player
#. NodeID = 751d9c00-af8f-d15d-406f-c2fcedb0d927
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear:751d9c00-af8f-d15d-406f-c2fcedb0d927
msgctxt "h126f2ea7g8a94g434dg9684gbcf178cc3e2c"
msgid "<i>Leave the bear to the goblin's mercy.</i>"
msgstr "<i>곰을 고블린의 자비에 맡긴다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_GroupDialogWithBear
#. Speaker = Brawler Birka
#. NodeID = 78c274f1-b922-8cb6-a5a8-2cda80d9695c
#. HandlePath = TaggedText[0].TagText[0]
