#.     - GOB_Festivities_GoblinSleeper02_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinSleeper_02:ef4afa6e-c1ca-bc2e-1da0-b671558dec13
msgctxt "h518d5dfcg8648g4b9eg9f6ag55a3b5c57372"
msgid "Argh, my head's killing me. What's all that noise?"
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinSleeper_02
#. Speaker = Booyahg Culk
#. NodeID = f2575327-aa41-927a-9432-fdf8e47308e7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinSleeper_02:f2575327-aa41-927a-9432-fdf8e47308e7
msgctxt "h76908117gf58eg40f5gbc75gab4b0148df42"
msgid "G'night."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinSleeper_02
#. Speaker = Narrator
#. NodeID = f922f931-c2f8-6320-85c5-bfbd07d131ec
