#.     - DEN_HarpyMeal_Event_OriginCharm3(0) = True
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerCharmed:0383f50b-4238-08bd-c76b-1a063fb7040a
msgctxt "h5a6f82b2g3ff4g4d1fg9d5ageca91486a913"
msgid "Yes, yes. <i>Sing to me.</i>"
msgstr "좋아, 좋았어. <i>내게 노래해 줘.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_HarpyMeal_AD_PlayerCharmed
#. Speaker = Player
#. NodeID = 05018964-92a4-0602-28a5-9e6fc53d548d
