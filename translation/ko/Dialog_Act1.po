msgctxt "he9d66b9ag13fag416bga387g4866458d9aad"
msgid "This device requires further examination."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/VBs/GOB_TempleAccess_PuzzleApproach_ReadInstructions_VB
#. Speaker = Player
#. NodeID = 96d4d9be-8433-6f1c-27a1-7bdb8bca02dc
