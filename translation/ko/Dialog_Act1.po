msgctxt "hd512a865g4e52g459cg9253gece7064b73f5"
msgid ""
"*The artefact stirs within your pocket - suddenly within your reach, but "
"reluctant to be known to the githyanki.*"
msgstr "*주머니 속의 유물이 동요하며 - 갑자기 손 닿는 거리에 잡히지만, 기스양키에게 알려지기를 주저합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
#. Speaker = Narrator
#. NodeID = f04ab4f3-c6a1-647d-724b-981456c53332
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing:f04ab4f3-c6a1-647d-724b-981456c53332
msgctxt "ha6dbc4b8g7c21g4c80gba78gdd0b5ee0b6dd"
msgid "*The sentry considers you for a moment, assessing the risk you pose.*"
msgstr "*보초가 잠시 당신의 자세를 훑어보며, 위험 요소를 저울질합니다.*"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/UpperCreche/CRE_UpperGuards_MainCheckpointTrespassing
