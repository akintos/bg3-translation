msgctxt "h2f4a3077g62d5g437dgbebbg6cdf7e335a33"
msgid "It was so big but... it died so easy."
msgstr "덩치는 큰데.. 아주 손쉽게 죽어버리네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_Kid_002
#. Speaker = Three
#. NodeID = 8ccd5b96-95ff-209e-44e6-9c53f9dd59b5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_WolfPens_State_PrisonerPermaDefeated = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_Kid_002:8ccd5b96-95ff-209e-44e6-9c53f9dd59b5
msgctxt "h188dc45eg98b4g4c96g958ag2202d0a1fede"
msgid "Look, look! I told ya it squealed!"
msgstr "봐, 봐! 내가 비명을 지를 거라고 했잖아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_Parent
#. Speaker = Brawler Birka
#. NodeID = 15f42ff6-d793-2ddf-ae6e-1d4411a586fd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_WolfPens_State_PrisonerPermaDefeated = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_Parent:15f42ff6-d793-2ddf-ae6e-1d4411a586fd
msgctxt "hb9cd32d4g7baag4c52g99ebg69f8d3dee074"
msgid "Good riddance."
msgstr "속이 시원하군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_Parent
#. Speaker = Brawler Birka
#. NodeID = 4e2c70f5-c55e-97d4-ea92-91c45168719a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_WolfPens_State_PrisonerPermaDefeated = False
#.   Tag:
#.      - DROWELF(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_Parent:4e2c70f5-c55e-97d4-ea92-91c45168719a
msgctxt "h5184305ag68f3g4b11gb62ag435a42b3d775"
msgid "Come to see the bear? Just wait 'til Boss Ragzlin sets the worgs on it."
msgstr "곰을 보러왔나? 라그즐린님 대장님이 워그랑 한판 붙게 하신다니까 기다려."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_Parent
#. Speaker = Brawler Birka
#. NodeID = 55412169-b447-57d6-a2ea-f0f2a065bd7c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GOB_WolfPens_State_PrisonerPermaDefeated = False
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_Parent:55412169-b447-57d6-a2ea-f0f2a065bd7c
msgctxt "he04810e3g1fc3g42a7gbc74gcdc855703aa9"
msgid "Mind yer own business."
msgstr "네 일이나 신경 써."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_WolfPens_Worg_001
#. Speaker = Ferr
#. NodeID = 0d40c530-5dae-6611-6a3d-3e58a9cf641b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
