#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_Trainer:05d15e83-a8f7-7c34-7539-342ac92b5d2f
msgctxt "h8dd57647g9ba6g4469g9169gf1403961dbf6"
msgid "Children - find a place to hide. Don't come out 'til I call."
msgstr "아이들은 숨을 곳을 찾아보도록 해. 내가 부를 때까지 나오지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_Trainer
#. Speaker = Asharak
#. NodeID = 0ff4f3b4-9f91-0f30-fb40-d28b3569a05a
