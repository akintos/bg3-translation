msgctxt "h2407513bg60d5g4334ga5eegbe4a0b9ad964"
msgid "Come and get me!"
msgstr "와서 잡아봐라!"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/Plains/PLA_PaladinsOfTyr_PAD_KarlachEnraged
#. Speaker = Karlach
#. NodeID = 84561fa7-4eb2-4e66-a339-3ff71a2af9a1
