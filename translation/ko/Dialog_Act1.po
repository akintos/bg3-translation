#.   Local:
#.      - 2d631516-9d64-7ed3-a3da-c76e2f3faf82_B = True
#. SetFlags:
#.   Local:
#.     - 2d631516-9d64-7ed3-a3da-c76e2f3faf82_C = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_WeaponsmithAndGuardsAfterAttack:a6908a56-b938-e270-6984-d03d5f72a778
msgctxt "h739a2da8gb9e1g407eg9d70gca96bb6f48c6"
msgid "Is this gonna hold up if those goblins come back?"
msgstr "고블린들이 또 쳐들어오면 이런 장비로 버틸 수 있을까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_WeaponsmithAndGuardsAfterAttack
#. Speaker = Rikka
#. NodeID = c878a4ff-6c56-c9c5-f94c-0f0c332fc5e2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 2d631516-9d64-7ed3-a3da-c76e2f3faf82_A = True
#. SetFlags:
#.   Local:
#.     - 2d631516-9d64-7ed3-a3da-c76e2f3faf82_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_WeaponsmithAndGuardsAfterAttack:c878a4ff-6c56-c9c5-f94c-0f0c332fc5e2
msgctxt "hd18857edgd2f4g4fbegb056g3fc67ca570ab"
msgid "I'm worried. I don't think we're ready."
msgstr "난 걱정이 돼. 우린 아직 준비 안 된 것 같다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_WeaponsmithAndGuardsAfterAttack
#. Speaker = Rikka
#. NodeID = eed7df09-ed7f-dde5-fd4c-432ca40eb431
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_WeaponsmithAndGuardsAfterAttack:eed7df09-ed7f-dde5-fd4c-432ca40eb431
msgctxt "h4d54cedeg38a8g4a23gbe7bgfe49eee12b7d"
msgid "Make that two."
msgstr "나까지 두 잔이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_YoungLover01
#. Speaker = Danis
#. NodeID = 077b3a8f-142c-41fa-bb2c-cae8573fb9b3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - b8993c89-0c1c-1bb8-4d8d-b49ce9f3c5cc_b = True
#.      - b8993c89-0c1c-1bb8-4d8d-b49ce9f3c5cc_a = True
#. SetFlags:
#.   Local:
#.     - b8993c89-0c1c-1bb8-4d8d-b49ce9f3c5cc_b = False
#.     - b8993c89-0c1c-1bb8-4d8d-b49ce9f3c5cc_a = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_YoungLover01:077b3a8f-142c-41fa-bb2c-cae8573fb9b3
msgctxt "h4fdbfbb8g362eg46e7g9e1ag7c69a50dd1b6"
msgid "Why're they doing this?!"
msgstr "왜 이런 짓을 하는 거야?!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_YoungLover01
#. Speaker = Danis
#. NodeID = 884c78cc-c65f-09e5-d6bf-2aed651a109a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_DruidAttack_State_InPosition(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_YoungLover01:884c78cc-c65f-09e5-d6bf-2aed651a109a
msgctxt "hfcb888d0g645eg4d0cg8a1aga4a78cbac457"
msgid "Got to hide. Find someplace safe..."
msgstr "숨어야 해. 어딘가 안전한 곳으로..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_YoungLover01
#. Speaker = Danis
#. NodeID = 932210fb-79cb-94f7-155d-a00ddd22cf7f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - b8993c89-0c1c-1bb8-4d8d-b49ce9f3c5cc_b = False
#.      - b8993c89-0c1c-1bb8-4d8d-b49ce9f3c5cc_a = True
#. SetFlags:
#.   Local:
#.     - b8993c89-0c1c-1bb8-4d8d-b49ce9f3c5cc_b = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_YoungLover01:932210fb-79cb-94f7-155d-a00ddd22cf7f
msgctxt "h3f73f522gbf36g4bcbgb210gab7cec794249"
msgid "The druids have gone mad - keep back!"
msgstr "드루이드들이 미쳐 버렸다! 물러나!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_YoungLover01
#. Speaker = Danis
#. NodeID = ee145eb1-6300-e832-3e7c-a2056bb78a87
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - b8993c89-0c1c-1bb8-4d8d-b49ce9f3c5cc_a = False
#. SetFlags:
#.   Local:
#.     - b8993c89-0c1c-1bb8-4d8d-b49ce9f3c5cc_a = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_YoungLover01:ee145eb1-6300-e832-3e7c-a2056bb78a87
msgctxt "hebf7a4b0g61c1g457fga658gf6598c96dfc1"
msgid "Somebody stop them!"
msgstr "누가 놈들 좀 막아줘!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Apprentice
#. Speaker = Nettie
#. NodeID = edadef00-815c-d21f-4b37-1eb0d89e76ac
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Apprentice:edadef00-815c-d21f-4b37-1eb0d89e76ac
msgctxt "h856b72afg39a2g46ffg94c7g6a5b09598b73"
msgid "Better that Master Halsin doesn't see this. It'd break his heart."
msgstr "마스터 할신이 이 광경을 안 보시는 편이 낫겠어. 억장이 무너지실 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Bard
#. Speaker = Alfira
#. NodeID = 266bfd84-dd70-ddce-8ada-acf2e5f3437b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_TieflingBard_Event_SmashedLute(1) = True
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_BardAfterAttack(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Bard:266bfd84-dd70-ddce-8ada-acf2e5f3437b
msgctxt "h01b139e8gf445g4a33g8d4cgbf51fa97f92b"
msgid ""
"I'll never forget what you did to my lute. But thank you. You bought the "
"little ones time to hide."
msgstr "내 류트에 한 짓은 잊지 못하겠지만, 고마워요. 아이들 숨을 시간을 벌어줘서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Bard
#. Speaker = Alfira
#. NodeID = 2d843165-5470-41ec-6b9c-058ce7726e0f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidAttack_HasMet_BardAfterAttack(1) = True
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Bard:2d843165-5470-41ec-6b9c-058ce7726e0f
msgctxt "h341c4a52g7821g491dgad17g436a303b5d70"
msgid "I think I'll stay to keep an eye on this lot."
msgstr "여기서 아이들 지켜봐야 할 것 같네요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Bard
#. Speaker = Alfira
#. NodeID = 52f79831-d7ff-79bc-53ec-03b5dba15870
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Bard:52f79831-d7ff-79bc-53ec-03b5dba15870
msgctxt "hc81377c4gaaa3g4666g84fbg9d7a15bbb83e"
msgid "Keep them away from the kids -<i> please. </i>"
msgstr "그놈들 아이들에게 못 오게 막아주세요. <i>제발요.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Bard
#. Speaker = Alfira
#. NodeID = cad12328-fac5-5c74-512c-49a5efbd2e18
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_BardAfterAttack(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Bard:cad12328-fac5-5c74-512c-49a5efbd2e18
msgctxt "ha29d6179g8d03g46b7g9887g5566e73af2de"
msgid ""
"That's twice you saved us now. Thank you. You bought enough time for the "
"little ones to hide."
msgstr "우리를 두 번이나 구해줬네요. 고마워요. 아이들 숨을 시간을 벌어줘서."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Bard
#. Speaker = Alfira
#. NodeID = fb9da461-73e1-bf34-1773-ff3b1dc32d09
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Bard:fb9da461-73e1-bf34-1773-ff3b1dc32d09
msgctxt "h90aaeab2g9a45g45d5g8452g111564a94388"
msgid "You're a person with many faces."
msgstr "당신은 여러 얼굴을 가진 사람이에요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_BirdSender
#. Speaker = Apikusis
#. NodeID = 2006e957-6c40-dc23-2bda-8d67874f0913
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_BirdSender:2006e957-6c40-dc23-2bda-8d67874f0913
msgctxt "h111d7195g1236g426ega97bgc4c6740a2868"
msgid "Fly. <i>Now. </i>While you can."
msgstr "날아가렴. <i>어서. </i> 갈 수 있을 때."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_CharmedKid
#. Speaker = Mirkon
#. NodeID = 3b5e0839-3623-deda-5546-563abae5fcb8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_CharmedKid:3b5e0839-3623-deda-5546-563abae5fcb8
msgctxt "hbf85459cg2ba8g4a43gb1d9g39c5b50d5e46"
msgid "Wh-what's happening? Please help!"
msgstr "무, 무슨 일이야? 살려주세요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_CharmedKid
#. Speaker = Mirkon
#. NodeID = a0a0822c-9f04-cd3d-062e-8567c482a505
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_CharmedKid:a0a0822c-9f04-cd3d-062e-8567c482a505
msgctxt "hc7dab7b4gb6c4g4d4cg9f3ag757e1337d820"
msgid "I wish you could stay with us - you'd keep everyone safe forever."
msgstr "우리랑 같이 지낼 수 있다면 좋겠어요 - 당신이라면 모두를 평생 지켜줄 수 있을 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Chef
#. Speaker = Okta
#. NodeID = 5ad2f137-7d7a-96dd-0963-9522b679e37c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidAttack_HasMet_ChefAfterAttack(1) = True
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Chef:5ad2f137-7d7a-96dd-0963-9522b679e37c
msgctxt "h7dd62821g956dg45eegac92gaa2d4636476e"
msgid "Least there's plenty of wood for the fire with the druids gone."
msgstr "드루이드들이 사라졌으니 적어도 불에 던져넣을 땔감은 충분하겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Chef
#. Speaker = Okta
#. NodeID = 6125a111-0f83-82d9-259b-17591f5e2b93
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Chef:6125a111-0f83-82d9-259b-17591f5e2b93
msgctxt "h940bee03gfd49g4da2gaf32g7c4380be6667"
msgid ""
"I'll give any druid that comes near me a backhand their mother will feel."
msgstr "어떤 드루이드든 가까이 오면 그 놈 어미까지 느낄 정도로 따귀를 먹여주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Chef
#. Speaker = Okta
#. NodeID = 75cc860e-8a56-4cbe-7986-a94e3ccecd6e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Chef:75cc860e-8a56-4cbe-7986-a94e3ccecd6e
msgctxt "hdb3a7662g5311g48c4gafcege1b813aa2fda"
msgid ""
"Now that this druid mess is over, I'm having to store up all the rations I "
"can."
msgstr "이제 드루이드 난장판이 끝났으니, 식량을 내가 모을 수 있을 만큼 모아볼게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Chef
#. Speaker = Okta
#. NodeID = d303d850-bdea-7e4f-bdba-37dc80a43a58
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Chef:d303d850-bdea-7e4f-bdba-37dc80a43a58
msgctxt "h1e1d47d3gbe99g4ac1gbda6g7e14f1cab5dd"
msgid "Which... isn't much. But we'll make do."
msgstr "그렇게 많지는... 않겠지만. 그래도 어떻게든 꾸려나갈 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Chef
#. Speaker = Okta
#. NodeID = fead447b-1044-56c7-5b74-195ddf67f6d9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_ChefAfterAttack(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Chef:fead447b-1044-56c7-5b74-195ddf67f6d9
msgctxt "hef4e75b2g2352g4478g9974g405ea9437306"
msgid "Sorry, no gruel on the pot today."
msgstr "미안, 오늘은 줄 귀리죽이 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_DruidGuard001
#. Speaker = Jeorna
#. NodeID = 9aefd3c4-1601-f866-4c0f-527b64ccd564
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_DruidGuard001:9aefd3c4-1601-f866-4c0f-527b64ccd564
msgctxt "ha2cca77bg0614g47afg95feg2824bda53ff3"
msgid "Time to reclaim our grove. Stand in our way and we'll cut you down."
msgstr "우리의 숲을 되찾을 시간이다. 방해한다면 너도 베어 넘겨버리겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_DruidGuard002
#. Speaker = Maggran
#. NodeID = 31ae967d-3987-3a10-cc0e-c21b8bd79989
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_DruidGuard002:31ae967d-3987-3a10-cc0e-c21b8bd79989
msgctxt "h16cd92a5g1b5dg45c0gb2b5g9ca96223be34"
msgid "The Grove will be cleansed!"
msgstr "숲이 정화되리라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_DruidGuard003
#. Speaker = Mino
#. NodeID = 1d345369-8e1a-e83d-6bb0-b141ac17d13f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_DruidGuard003:1d345369-8e1a-e83d-6bb0-b141ac17d13f
msgctxt "hdae8bdf3g3109g467bgb137g2fc049a3a903"
msgid ""
"You outsiders had your chance to leave. Now blood's going to be spilled."
msgstr "너희 외부인들은 떠날 기회가 있었다. 이제 피가 흐르게 될 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_DruidLeader
#. Speaker = Kagha
#. NodeID = 6024421e-7d7d-c0f0-d460-fed50b3eefbf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_DruidLeader:6024421e-7d7d-c0f0-d460-fed50b3eefbf
msgctxt "h55322e50g0c27g45e1g804bg2a93448be089"
msgid "The brood is restless. The mother strikes!"
msgstr "무리가 동요한다. 어미가 공격하리라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_DruidOpposed
#. Speaker = Rath
#. NodeID = 2d60d659-eaeb-cca4-6053-7b8f3e79ebbb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_DruidOpposedAfterAttack(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_DruidOpposed:2d60d659-eaeb-cca4-6053-7b8f3e79ebbb
msgctxt "hbf6e916fge229g4f65g80b2gf38defd96f88"
msgid ""
"We've won, yes, but at what cost? The peace of this grove has been shattered "
"forever."
msgstr "그래, 우리가 이겼군. 그 대가가 뭐였는지 아시오? 이 숲의 평화는 이제 영원토록 깨져 버린 것이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_DruidOpposed
#. Speaker = Rath
#. NodeID = b78fe1ce-4141-63cc-d22f-daf4f398ca51
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidAttack_HasMet_DruidOpposedAfterAttack(1) = True
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_DruidOpposed:b78fe1ce-4141-63cc-d22f-daf4f398ca51
msgctxt "h5c8da160gd77fg4b9fgadc1g54d201c71439"
msgid "Silvanus forgive me."
msgstr "실바누스께서 나를 용서하시길."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_DruidOpposed
#. Speaker = Rath
#. NodeID = f47a181e-28a7-45d2-3130-a164505fb199
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_DruidOpposed:f47a181e-28a7-45d2-3130-a164505fb199
msgctxt "h036eab7fgc8f4g40f0gb300g858e10214898"
msgid "I can handle myself. Find Kagha and end this!"
msgstr "내 몸은 내가 지킬 수 있소. 카그하를 찾아 끝내버리시오!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ElevatorBear
#. Speaker = Tuffet
#. NodeID = 21ba6baf-0e16-feed-33c3-0c94103cfe71
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidAttack_HasMet_ElevatorBear(1) = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ElevatorBear:21ba6baf-0e16-feed-33c3-0c94103cfe71
msgctxt "h44579124g1787g405dga623g38e5c2bfbebf"
msgid "No one wakes me up!"
msgstr "나 깨우지 말라고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ElevatorBear
#. Speaker = Tuffet
#. NodeID = 40f03eaf-bbd7-9e80-4272-d1e025158192
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_ElevatorBear(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ElevatorBear:40f03eaf-bbd7-9e80-4272-d1e025158192
msgctxt "hb1af4007ge917g4e3bgba3dgb267148b5097"
msgid "You... woke me up!"
msgstr "네 녀석이... 날 깨웠어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ElevatorBear
#. Speaker = Tuffet
#. NodeID = 4f4a634f-676b-02f7-c3a0-e8b1da526e39
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ElevatorBear:4f4a634f-676b-02f7-c3a0-e8b1da526e39
msgctxt "h990647a3ge83ag449bgbf67g0af23e0c92f7"
msgid "*Growl.*"
msgstr "*으르렁.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ExcitedBoar
#. Speaker = Tusk
#. NodeID = 33580900-c711-b937-f1a1-77ba2f89f593
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_ExcitedBoar(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ExcitedBoar:33580900-c711-b937-f1a1-77ba2f89f593
msgctxt "h7ec5363bg5739g4c5eg8fa2g0f447adb7679"
msgid "I should've known. All two-legs are the same!"
msgstr "두 발 달린 것들은 다 똑같다는 걸 알았어야 했는데!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ExcitedBoar
#. Speaker = Tusk
#. NodeID = 47485bda-7db3-fe14-e546-2cb1b9e9ad07
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidAttack_HasMet_ExcitedBoar(1) = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ExcitedBoar:47485bda-7db3-fe14-e546-2cb1b9e9ad07
msgctxt "h7ab7628egd750g46e9ga9b2g61135e4d3e59"
msgid "Start running, two-legs - I'll be right behind you."
msgstr "뛰어라, 두 발 달린 것아 - 바로 뒤에서 따라갈게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ExcitedBoar
#. Speaker = Tusk
#. NodeID = e4576ba0-a5f3-ae3c-190c-50dcc9e90ed6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ExcitedBoar:e4576ba0-a5f3-ae3c-190c-50dcc9e90ed6
msgctxt "h78c84ab1g8210g482ag8d98g727e203cace3"
msgid "*Grunt.*"
msgstr "*끙.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Gatekeeper
#. Speaker = Elegis
#. NodeID = 4bd08b3e-89f0-de81-36d5-02ebaf9b4614
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_GatekeeperAfterAttack(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Gatekeeper:4bd08b3e-89f0-de81-36d5-02ebaf9b4614
msgctxt "hca739a17g7704g4ea6g921dgea16511829a6"
msgid ""
"We no longer need to fear a dagger in the back from our kindly hosts. Thank "
"you - for standing by us."
msgstr "더는 살가운 집주인들이 우리 등 뒤에 칼 꽂을까 걱정하지 않아도 되겠네. 우리 편에 서줘서 고마워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Gatekeeper
#. Speaker = Elegis
#. NodeID = fa331692-dff6-cd82-2fab-acd93dcaafb2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Gatekeeper:fa331692-dff6-cd82-2fab-acd93dcaafb2
msgctxt "h76e194f3gfc2ag4949g906dga968cd1df14c"
msgid "Take them down! Hurry!"
msgstr "해치워버려! 빨리!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Gatekeeper
#. Speaker = Elegis
#. NodeID = fce3b549-152a-3ba5-cf5c-8c63d915528c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidAttack_HasMet_GatekeeperAfterAttack(1) = True
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Gatekeeper:fce3b549-152a-3ba5-cf5c-8c63d915528c
msgctxt "h5d570f6eg0e17g41bcga7c9ga79fc2197dc0"
msgid ""
"Now we need only concern ourselves with goblins, gnolls and whatever else "
"has their eyes on the grove."
msgstr "이제는 고블린에, 놀에, 뭐든 이 숲을 호시탐탐 노리고 있을 놈들만 걱정하면 되겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Griefling
#. Speaker = Arka
#. NodeID = c7df0e36-4329-b441-5a58-4b359fa3886e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_GrieflingAfterAttack(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Griefling:c7df0e36-4329-b441-5a58-4b359fa3886e
msgctxt "hd86e8c44g8b74g49d5g9ef1ge57a7ffde7cf"
msgid "Backstabbing filth. Good riddance to the lot of them."
msgstr "뒤통수치는 쓰레기 놈들. 저 새끼들 죽어버려서 잘 됐군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Griefling
#. Speaker = Arka
#. NodeID = d948ba64-0b9a-7a11-0371-2bec7983d00f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidAttack_HasMet_GrieflingAfterAttack(1) = True
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Griefling:d948ba64-0b9a-7a11-0371-2bec7983d00f
msgctxt "hb2ba86e4ga7b7g482agbef1gc9b3bf61cda0"
msgid "If we can survive the druids, we might survive the goblins."
msgstr "드루이드의 공격에서도 살아남았으니, 고블린에게서도 살아남을 수 있을지 몰라요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Griefling
#. Speaker = Arka
#. NodeID = fd7c3d1d-96ab-970f-5c7d-e1bdbed737f0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Griefling:fd7c3d1d-96ab-970f-5c7d-e1bdbed737f0
msgctxt "hb7ef7964g4c83g4710gabdfgf1504497f0ac"
msgid "Druids are up to something - get ready for a fight."
msgstr "드루이드들이 뭔가를 꾸미고 있다. 전투를 준비해요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_GrieflingFriend
#. Speaker = Memnos
#. NodeID = 33023997-b4ff-dd74-bee5-702c33876c8f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_GrieflingFriend:33023997-b4ff-dd74-bee5-702c33876c8f
msgctxt "h5f6a1f68g6ab4g4a6fgb62fg0cb944697c69"
msgid "These druids are insane - why are they doing this?!"
msgstr "드루이드들이 미쳤어요. 왜 이런 짓을 하는 거예요?!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_GrieflingFriend
#. Speaker = Memnos
#. NodeID = a7653cdd-dca8-b78d-a3dd-97c1d8707118
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidAttack_HasMet_GrieflingFriendAfterAttack(1) = True
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_GrieflingFriend:a7653cdd-dca8-b78d-a3dd-97c1d8707118
msgctxt "hb1623e3bg80d0g45e8gb062g036106506047"
msgid "Leave me be, please. Need to... need to gather my wits."
msgstr "제발 나를 좀 냅둬요. 머리를... 머리를 맑게 해야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_GrieflingFriend
#. Speaker = Memnos
#. NodeID = bcb5bb64-b4c6-410b-1172-611fd403c15a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_GrieflingFriendAfterAttack(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_GrieflingFriend:bcb5bb64-b4c6-410b-1172-611fd403c15a
msgctxt "h4cdd42d0g9f87g42ebgb776gb38e92727084"
msgid "The druids... they're all dead. Up to Kelemvor to judge them now."
msgstr "드루이드들이 전부... 죽었군요. 이제 켈렘보르께서 심판하시겠죠."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_GruntingKid
#. Speaker = Doni
#. NodeID = 5d9bae10-4a6f-9c26-fece-9a494e85c139
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_GruntingKid:5d9bae10-4a6f-9c26-fece-9a494e85c139
msgctxt "h76184945g65bcg4ad1gb0cfg4c0c1f43a05c"
msgid "*Grunt.*"
msgstr "*끙.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_GruntingKid
#. Speaker = Doni
#. NodeID = dc8b30ba-d835-ea3e-aa77-f00cb8a62f01
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_GruntingKid:dc8b30ba-d835-ea3e-aa77-f00cb8a62f01
msgctxt "h1bf4b02aga3a3g43f8gb06fgc530d4885b31"
msgid "*Grunt.*"
msgstr "*끙.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_HideoutLeader
#. Speaker = Player
#. NodeID = 07a8d88a-a01c-9976-cd1f-70990cc438b0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - ROGUE(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_HideoutLeader:07a8d88a-a01c-9976-cd1f-70990cc438b0
msgctxt "h6e5cd75agf8d2g49abga897g96a2ca1507bb"
msgid ""
"Here's some free advice, more valuable than gold: don't bargain, just take."
msgstr "금보다 값비싼 조언 하나 거저 해 줄게. 흥정할 시간에 그냥 빼앗아라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_HideoutLeader
#. Speaker = Mol
#. NodeID = 237c42ca-03e6-6b73-9534-cf1f783b6c7c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_HideoutLeader:237c42ca-03e6-6b73-9534-cf1f783b6c7c
msgctxt "h89a618a6g593fg40e1gb5b1g37aab313acbe"
msgid "You're a terrible liar. We had a deal."
msgstr "거짓말인 거 다 알아. 우린 거래하기로 약속했잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_HideoutLeader
#. Speaker = Mol
#. NodeID = 2e9b8653-31b2-6870-b48f-d24f94849599
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_HideoutLeader:2e9b8653-31b2-6870-b48f-d24f94849599
msgctxt "h4cf88d80g9559g42ebgbf88g4a156af0be80"
msgid "Damn it. Having that stashed away would have made life a lot easier."
msgstr "망할. 그걸 손에 넣었다면 삶이 좀 폈을 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_HideoutLeader
#. Speaker = Mol
#. NodeID = 2f6ba2aa-af78-0cec-b013-8910de8bc9c0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_HideoutLeader:2f6ba2aa-af78-0cec-b013-8910de8bc9c0
msgctxt "hef3945b5gd29fg4fcega4e5g10a1e11e3f82"
msgid "Alive. But poor."
msgstr "살아남았지. 거지꼴로 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_HideoutLeader
#. Speaker = Mol
#. NodeID = 33087402-d2c2-85dd-4640-689e543c791a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_AgreedStealIdol = False
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_HideoutLeaderAfterAttack(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_HideoutLeader:33087402-d2c2-85dd-4640-689e543c791a
msgctxt "h929971c2gb2a6g473cga0c1g073be5ee3663"
msgid "Nothing to see here. We're clearing out soon."
msgstr "여긴 볼일이 없군. 우린 조만간 여길 떠날 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_HideoutLeader
#. Speaker = Mol
#. NodeID = 5ee4c97c-ffc8-7c3a-113a-aa83f11d7d90
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_AgreedStealIdol = True
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_HideoutLeaderAfterAttack(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_HideoutLeader:5ee4c97c-ffc8-7c3a-113a-aa83f11d7d90
msgctxt "h7c751295ged01g4800gbf44g7cddfc734b2a"
msgid "You're alive! Did you get the idol? Is that why they went crazy?"
msgstr "살아 있었구나! 우상은 손에 얻었어? 그거 때문에 그들이 미쳐 날뛴 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_HideoutLeader
#. Speaker = Player
#. NodeID = 6058ce7d-065a-9fd7-d262-9cee441b3d4d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Thieflings_State_HasIdol(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_HideoutLeader:6058ce7d-065a-9fd7-d262-9cee441b3d4d
msgctxt "he62539f2ge9c1g442bg8d4bged31718d204f"
msgid "Not sure what happened to the idol."
msgstr "우상이 어떻게 됐는지 몰라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_HideoutLeader
#. Speaker = Player
#. NodeID = 615c9608-f791-fbce-6755-7f3abab4fa1d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Thieflings_State_HasIdol(1) = True
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Event_GaveMolIdol = True
#.   Object:
#.     - DEN_Thieflings_Event_TransferIdol(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_HideoutLeader:615c9608-f791-fbce-6755-7f3abab4fa1d
msgctxt "h0f12ead9gdf9dg44aag99a9g3836a51d724b"
msgid "Fine. Take it."
msgstr "좋아. 가져가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_HideoutLeader
#. Speaker = Mol
#. NodeID = 6351c984-f409-167d-c018-3f6a806d5deb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_HideoutLeader:6351c984-f409-167d-c018-3f6a806d5deb
msgctxt "hec6d7dadgdbb4g4b9agaeedg80e34a7f0bbf"
msgid "Fine. Hope the damn thing's cursed."
msgstr "좋아. 그 망할 물건에 저주나 깃들라지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_HideoutLeader
#. Speaker = Mol
#. NodeID = 64e3bc2a-4bf8-d795-663f-86266a373b96
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidAttack_HasMet_HideoutLeaderAfterAttack(1) = True
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_HideoutLeader:64e3bc2a-4bf8-d795-663f-86266a373b96
msgctxt "h617975b2gd524g4784gb2bdg1813c64d0909"
msgid "Clear off."
msgstr "꺼져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_HideoutLeader
#. Speaker = Mol
#. NodeID = 69ce8cf1-7739-7d66-162e-9d071e05aa38
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_GaveMolIdol = True
#.   Object:
#.      - DEN_Thieflings_State_HasIdol(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_HideoutLeader:69ce8cf1-7739-7d66-162e-9d071e05aa38
msgctxt "h20cdb600gd194g4473gb88dgb5ce4e89e42e"
msgid "If any of your stuff goes missing, just let me know. You're family now."
msgstr "혹시 네 물건이 사라진다면 나한테 말하면 돼. 넌 이제 우리 가족이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_HideoutLeader
#. Speaker = Player
#. NodeID = 78a58b76-c66a-93ac-3938-cd48a04c22ba
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_HideoutLeader:78a58b76-c66a-93ac-3938-cd48a04c22ba
msgctxt "hfc3387cfgc6a7g48b6ga37agd465c4c0e80a"
msgid "And now the deal's off. Bye, kid."
msgstr "그리고 이제 거래는 없던 거야. 잘 가라, 꼬맹아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_HideoutLeader
#. Speaker = Mol
#. NodeID = 8ae21432-aaaa-70a2-4efe-528ecf96a2b4
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Hideout_Event_BefriendedThieflings = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_HideoutLeader:8ae21432-aaaa-70a2-4efe-528ecf96a2b4
msgctxt "h91880b76g7b1cg4440g9883g610bb102b54d"
msgid ""
"Thanks. See you in Baldur's Gate, I hope. Now scram, before I get emotional."
msgstr "고마워. 발더스 게이트에서 보면 좋겠네. 이제 꺼져, 감정적으로 되기 전에."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_HideoutLeader
#. Speaker = Mol
#. NodeID = 998b8596-1256-f36e-ed5b-0accaa480657
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_HideoutLeader:998b8596-1256-f36e-ed5b-0accaa480657
msgctxt "h87b07848gd51bg4d6cga41cgee85c6238f51"
msgid "Can't say I blame you. But we did have a deal."
msgstr "네 탓이라고 할 수는 없겠네. 하지만 우리 거래 했잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_HideoutLeader
#. Speaker = Player
#. NodeID = 9bbb114a-21ad-8652-3c2a-6b06721aa17c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Thieflings_State_HasIdol(1) = True
#. SetFlags:
#.   Global:
#.     - DEN_Thieflings_Event_GaveMolIdol = True
#.   Object:
#.     - DEN_Thieflings_Event_TransferIdol(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_HideoutLeader:9bbb114a-21ad-8652-3c2a-6b06721aa17c
msgctxt "h6e2359c2gef46g4d31gbc61g64a97d153ed8"
msgid "Doesn't matter. It's over - and the idol's all yours."
msgstr "상관없다. 다 끝났어. 그리고 우상은 너희 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_HideoutLeader
#. Speaker = Player
#. NodeID = c2578acc-a50d-46ca-f04c-433cfdbb2c20
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 15
#. CheckFlags:
#.   Object:
#.      - DEN_Thieflings_State_HasIdol(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_HideoutLeader:c2578acc-a50d-46ca-f04c-433cfdbb2c20
msgctxt "hc5b4366eg59d7g46d6g88a7gb17f878d1920"
msgid "I didn't touch the idol. No idea who pissed them off."
msgstr "난 그 우상에 손도 안 댔어. 누가 저들을 화나게 한 건지 모르겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_HideoutLeader
#. Speaker = Mol
#. NodeID = c2b55530-7e2d-1199-bb1e-70daa77c184c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Thieflings_Event_GaveMolIdol = True
#.   Object:
#.      - DEN_Thieflings_State_HasIdol(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_HideoutLeader:c2b55530-7e2d-1199-bb1e-70daa77c184c
msgctxt "hd8e417d6gf542g4846g939ag00ff0269acf0"
msgid "Somebody stole the idol. If I find out who it was... I'll recruit 'em."
msgstr "누군가 우상을 훔친 거야. 누구였는지 알아내면... 걔네들을 고용할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_HideoutLeader
#. Speaker = Mol
#. NodeID = cdc639d3-5da8-1c7d-6dcb-d8711228b122
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_HideoutLeader:cdc639d3-5da8-1c7d-6dcb-d8711228b122
msgctxt "h6d7c64bdgbc1fg46dcgb358g5ebd8e99603e"
msgid "Sounds more like a challenge than advice. Keep an eye on your pack."
msgstr "조언보다는 참견같이 들리는데. 배낭 잘 간수하라구."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_HideoutLeader
#. Speaker = Player
#. NodeID = d1e221c2-018b-b750-a8fa-827eca4165fe
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Thieflings_State_HasIdol(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_HideoutLeader:d1e221c2-018b-b750-a8fa-827eca4165fe
msgctxt "hf2544512g18a5g4700g96e9g9f6514c1d290"
msgid "Yes. And after what I just went through, I'm keeping the damn thing."
msgstr "그래. 내가 겪은 걸 생각해 보면, 그 망할 것은 내가 가지겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_HideoutLeader
#. Speaker = Player
#. NodeID = ded7ce03-4af1-d08d-473e-66011381699f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_Thieflings_State_HasIdol(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_HideoutLeader:ded7ce03-4af1-d08d-473e-66011381699f
msgctxt "h561a1e77g62a7g48e5gb1aeg46b9a6516419"
msgid "I don't have it. Let's just be glad we're alive."
msgstr "나는 가지고 있지 않아. 그냥 살아남았다는 데 기뻐하자."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_HideoutLeader
#. Speaker = Mol
#. NodeID = f8996575-431d-9d06-6fd3-9cf24385e5d5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_HideoutLeader:f8996575-431d-9d06-6fd3-9cf24385e5d5
msgctxt "h9265c148g7594g4771gafdag9c21a189c994"
msgid "I <i>knew</i> they wanted us dead. I knew it!"
msgstr "놈들이 우리가 다 죽어버리길 원하는 건 <i>알고 있었지.</i> 알고 있었다고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_IrritatedTiefling
#. Speaker = Guex
#. NodeID = 95ec4fdf-541b-e29c-d6fa-cd743fdd1422
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_IrritatedTiefling:95ec4fdf-541b-e29c-d6fa-cd743fdd1422
msgctxt "hd2620bd1g8d6cg4986gab08g0e13eff3c286"
msgid "The druids - they're attacking!"
msgstr "드루이드다. 놈들이 공격하고 있어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_IrritatedTiefling
#. Speaker = Guex
#. NodeID = b2015137-4e2c-1d2f-e5d9-5775122aa0b7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidAttack_HasMet_IrritatedAfterAttack(1) = True
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_IrritatedTiefling:b2015137-4e2c-1d2f-e5d9-5775122aa0b7
msgctxt "h24f48722g73e8g40bfgb7d2g3a4cf96100cc"
msgid "Still have the goblins to deal with. Can't let our guard down just yet."
msgstr "고블린과의 싸움이 남아있어. 아직 마음 푹 놓을 수는 없지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_IrritatedTiefling
#. Speaker = Guex
#. NodeID = e92e5e79-bd1b-6d03-3c7b-dc21941d421d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_IrritatedAfterAttack(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_IrritatedTiefling:e92e5e79-bd1b-6d03-3c7b-dc21941d421d
msgctxt "h835f903ag1184g41e0g9668gef307bd73b39"
msgid "So much for the druids. Looks like all my sword training did some good."
msgstr "드루이드도 별 것 아니네. 그간 검술 훈련한 보람이 있었던 모양이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Kid004
#. Speaker = Zaki
#. NodeID = 6930fffb-af72-fe02-bf06-49edc8de786f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidAttack_HasMet_Kid004AfterAttack(1) = True
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Kid004:6930fffb-af72-fe02-bf06-49edc8de786f
msgctxt "he0b1bb44g5983g481cga163gc9a96b0a7f03"
msgid "I just wanna go home."
msgstr "난 그냥 집에 가고 싶어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Kid004
#. Speaker = Zaki
#. NodeID = b1245bf3-c86e-e536-6259-06ff408d6294
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_Kid004AfterAttack(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Kid004:b1245bf3-c86e-e536-6259-06ff408d6294
msgctxt "h636f29b7g36c9g4da7gb124g825585e37f04"
msgid "I... I miss home."
msgstr "난... 난 집이 그리워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Kid004
#. Speaker = Zaki
#. NodeID = c8a08531-4a7b-eac0-d4f3-58810d8a8aa9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Kid004:c8a08531-4a7b-eac0-d4f3-58810d8a8aa9
msgctxt "hf6c64528gfc09g465fg906ag1562953441c8"
msgid "The druids have gone crazy!"
msgstr "드루이드들이 미쳐버렸어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_LINE_DruidToCombat
#. Speaker = Sentry
#. NodeID = 078ddc1e-aed7-43c5-9971-a14b0538a1c0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_Event_IdolMissingReaction = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_LINE_DruidToCombat:078ddc1e-aed7-43c5-9971-a14b0538a1c0
msgctxt "h873bc08fga124g4df5ga664g512ebf0d5464"
msgid "The idol - it's gone! <i>Stolen!</i>"
msgstr "우상이 없어졌다! <i>도둑맞았어!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_LINE_DruidToCombat
#. Speaker = Sentry
#. NodeID = 2ba4306a-ff3c-4f98-9ec3-7d6627c83bb6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_LINE_DruidToCombat:2ba4306a-ff3c-4f98-9ec3-7d6627c83bb6
msgctxt "h0f63e4c0gca97g4247g8fbegad4f7aacec4e"
msgid "The outlander serves Zevlor!"
msgstr "이 이방인이 제블로어를 섬긴다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_LINE_DruidToCombat
#. Speaker = Sentry
#. NodeID = 7b01cfa4-5509-414e-9562-15d0a7c77ede
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_LINE_DruidToCombat:7b01cfa4-5509-414e-9562-15d0a7c77ede
msgctxt "hb86c41aegca72g4659gab4bg9aec27612765"
msgid "The time has come. <i>Remove the outsiders.</i>"
msgstr "때가 됐다. <i>외부인들을 몰아내자.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_LINE_DruidToCombat
#. Speaker = Kagha
#. NodeID = ccb91414-4a62-43a5-a12c-9479a90f2af3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_DruidToCombatTransitionInLair = True
#.   Object:
#.      - DEN_ShadowDruid_State_CourtHostile(4) = False
#.   Tag:
#.      - FEMALE(3) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_LINE_DruidToCombat:ccb91414-4a62-43a5-a12c-9479a90f2af3
msgctxt "hedb46057g58c3g459ag98aaga4071d2ae20b"
msgid ""
"The outlander has betrayed us. I should have known. Druids! We cannot "
"compromise any longer!"
msgstr "이방인이 우리를 배신했다. 그럴 줄 알고 있었어. 드루이드들이여! 우리는 더 이상 타협할 수 없다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_LINE_DruidToCombat
#. Speaker = Sentry
#. NodeID = d0936ba4-b91c-4be6-a568-348146a04f95
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_LINE_DruidToCombat:d0936ba4-b91c-4be6-a568-348146a04f95
msgctxt "h0a04e5e4gd4efg46b4gbdc7g710dbc37a278"
msgid "To arms!"
msgstr "무장하라!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_LINE_DruidToCombat
#. Speaker = Sentry
#. NodeID = e1fbbc9d-660c-8b7a-4257-c140d4244f58
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_DruidToCombatTransitionInLair = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_LINE_DruidToCombat:e1fbbc9d-660c-8b7a-4257-c140d4244f58
msgctxt "ha9680e19gebe7g4dd7g98bbg322d3db1fd4f"
msgid "The time has come. <i>Remove the outsiders.</i>"
msgstr "때가 됐다. <i>외부인들을 없애자.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ParentA
#. Speaker = Locke
#. NodeID = 160fdab9-34c8-e5cb-0291-69579860d28a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidAttack_HasMet_ParentAAfterAttack(1) = False
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_ParentAAfterAttack(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ParentA:160fdab9-34c8-e5cb-0291-69579860d28a
msgctxt "h9e08d68fg30bag4910g80e8g9bc49ee00acb"
msgid ""
"Never thought the druids would attack. Thank you. We were lucky to have you."
msgstr "드루이드들이 공격할 거라고는 생각도 못 했어요. 감사합니다. 당신이 있어서 다행이네요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ParentA
#. Speaker = Locke
#. NodeID = 2fa6c5b5-0ffa-7e8c-18fc-f7b69c4538c0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidAttack_HasMet_ParentAAfterAttack(1) = True
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ParentA:2fa6c5b5-0ffa-7e8c-18fc-f7b69c4538c0
msgctxt "h4bebeefbg6928g4307gbaa0g72db3ecce686"
msgid "May this be the last fight any of us see for a while."
msgstr "이 싸움이 당분간 우리가 보는 마지막 싸움이 되길."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ParentA
#. Speaker = Locke
#. NodeID = 41053b02-b1ca-1003-a72f-a68d43e431e3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidAttack_HasMet_ParentAAfterAttack(1) = True
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ParentA:41053b02-b1ca-1003-a72f-a68d43e431e3
msgctxt "h9925a280g2297g49b1g83f1g2538372410a0"
msgid ""
"Blood has followed us since Elturel. I just want to leave this place and "
"never look back."
msgstr "엘투렐 이후로 유혈사태는 계속됐죠. 그저 여기를 뒤도 안 보고 떠나고 싶을 뿐 입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ParentA
#. Speaker = Locke
#. NodeID = 8ddfa12f-581d-024b-0935-4f101565628a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidAttack_HasMet_ParentAAfterAttack(1) = False
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_ParentAAfterAttack(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ParentA:8ddfa12f-581d-024b-0935-4f101565628a
msgctxt "hc5d9f912g9bf9g477bgadd0gc40529b6ec8e"
msgid "Dead druids means my daughter Arabella saw some justice. Thank you."
msgstr "드루이드들의 죽음으로 제 딸 아라벨라도 약간의 정의가 실현된 걸 보았겠죠. 고마워요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ParentA
#. Speaker = Locke
#. NodeID = bc08e870-2a5f-fda1-1b44-4291e15917f3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ParentA:bc08e870-2a5f-fda1-1b44-4291e15917f3
msgctxt "h6eadf9c8gc6afg414fgbb91gf1bbb8441f92"
msgid "Damn it. Why did it come to this?"
msgstr "제길. 왜 이렇게 된 거죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ParentB
#. Speaker = Komira
#. NodeID = 01e883cd-8db0-9c13-4d32-daee973171ab
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_ParentBAfterAttack(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ParentB:01e883cd-8db0-9c13-4d32-daee973171ab
msgctxt "hb0e793a6g2745g4569ga875gf88f7bc5bb29"
msgid ""
"Thanks for gutting the druid bastards. Only wish I could've taken a few "
"myself."
msgstr "드루이드 놈들을 썰어줘서 고마워. 몇 놈을 내 손으로 해치울 수 있었다면 좋았을 텐데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ParentB
#. Speaker = Komira
#. NodeID = 0c991ba4-cd08-7bcb-9f35-435920c60ba5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidAttack_HasMet_ParentBAfterAttack(1) = True
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ParentB:0c991ba4-cd08-7bcb-9f35-435920c60ba5
msgctxt "hf244a0a9g473dg45e5gaba3ge3d439a39e85"
msgid ""
"With Kagha dead, I thought I'd feel better. I just miss my daughter more."
msgstr "카그하가 죽으면, 좀 나아질 줄 알았어요. 그런데 딸이 더 그립네요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ParentB
#. Speaker = Komira
#. NodeID = 7a588310-dcb3-537a-7d8e-59a442a267d7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ParentB:7a588310-dcb3-537a-7d8e-59a442a267d7
msgctxt "hdf99e23dg7cf4g4659g8d6aga715af41b7d1"
msgid "I knew those druids would turn on us. Well, we won't go quietly."
msgstr "드루이드들이 공격할 줄 알았어. 우리도 조용히 갈 수는 없지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ParentB
#. Speaker = Komira
#. NodeID = bdab9aaf-a290-0256-007d-ce13efaf7eeb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = False
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_ParentBAfterAttack(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ParentB:bdab9aaf-a290-0256-007d-ce13efaf7eeb
msgctxt "h943b5e00g747fg415eg9754g797e9382714a"
msgid ""
"Goblins, worgs, gnolls - let them all come. We'll protect our own. We proved "
"that."
msgstr "고블린, 워그, 놀 - 올 테면 와 보라지. 우린 스스로를 지킬 수 있어. 증명해 냈다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ParentB
#. Speaker = Komira
#. NodeID = d74409fd-6824-19c0-1431-14fe7292acfd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidAttack_HasMet_ParentBAfterAttack(1) = True
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = False
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ParentB:d74409fd-6824-19c0-1431-14fe7292acfd
msgctxt "hd7283c2eg6b2bg4e90ga8degef634fb195b7"
msgid ""
"I don't know about you, but I won't shed a tear for those druids. They hated "
"us from the get go."
msgstr "당신은 어떤지 모르겠지만, 난 드루이드들을 위해 눈물 한 방울 흘리지 않을 거야. 그들은 우릴 처음부터 싫어했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_PetWolf
#. Speaker = Silver
#. NodeID = 012863e6-9d21-0a7c-964b-5eb28bb4a8dc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_PetWolf(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_PetWolf:012863e6-9d21-0a7c-964b-5eb28bb4a8dc
msgctxt "heddae9c3g4731g48e1g8984g38aa6b34ac1b"
msgid ""
"Master says you're good. Told me to protect you. But one wrong move, and "
"your flesh is mine."
msgstr "주인이 넌 괜찮다고 한다. 널 지키라고 한다. 하지만 허튼짓한다면, 바로 널 먹을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_PetWolf
#. Speaker = Silver
#. NodeID = 124f4d1c-d8d7-0673-4032-cce1deb66616
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidAttack_HasMet_PetWolf(1) = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_PetWolf:124f4d1c-d8d7-0673-4032-cce1deb66616
msgctxt "h9de2193dg99f8g4232ga2ffgbc782fac41ab"
msgid "I will get the snake. Master always told me no. But not anymore."
msgstr "내가 뱀을 처리하겠다. 주인은 항상 안 된다고 했다. 하지만 이젠 아냐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_PetWolf
#. Speaker = Silver
#. NodeID = 6db2c599-d05f-529e-8b0a-e8609d899ca3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_PetWolf:6db2c599-d05f-529e-8b0a-e8609d899ca3
msgctxt "h19d77b34gb24bg4ab0gb963g4558b1a81a18"
msgid "*Snarl.*"
msgstr "*으르렁*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_PetWolf
#. Speaker = Silver
#. NodeID = a08e9aa6-f15e-4dd7-af69-fa6437360ac1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidPet_002_Knows_Calmed(1) = True
#.   Tag:
#.      - PETPAL(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_PetWolf(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_PetWolf:a08e9aa6-f15e-4dd7-af69-fa6437360ac1
msgctxt "hc632e302g3080g4ab0g89ceg6e4b3165afd5"
msgid "Finally. The hunt begins."
msgstr "마침내. 사냥이 시작되는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Pickpocket
#. Speaker = Silfy
#. NodeID = 285b945c-72e5-c9cb-dbb5-abe1f96d9802
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Pickpocket:285b945c-72e5-c9cb-dbb5-abe1f96d9802
msgctxt "hf738f4f7g03b5g4eadga623g20b2cd5fdd5d"
msgid "I think we made those animal people mad."
msgstr "우리가 이 동물 인간들을 화나게 했나 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Pickpocket
#. Speaker = Silfy
#. NodeID = 584e49f8-fe9a-a1ab-b0cb-4e4be2785592
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_PickpocketAfterAttack(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Pickpocket:584e49f8-fe9a-a1ab-b0cb-4e4be2785592
msgctxt "h991a84c2g564ag471cg8744g8ebdc602588a"
msgid "I'm glad it's over... those bear people were scary."
msgstr "끝나서 기쁘네... 이 곰사람들은 무서웠거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Pickpocket
#. Speaker = Silfy
#. NodeID = fd2d3457-82f5-a249-4289-f2a8a7fba682
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidAttack_HasMet_PickpocketAfterAttack(1) = True
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Pickpocket:fd2d3457-82f5-a249-4289-f2a8a7fba682
msgctxt "hbb7a3e4eg9e5fg4abbgada5g5621d0bf4d5e"
msgid "Um... thank you for helping us..."
msgstr "엄... 우릴 도와줘서 고마워..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_PickpocketTrader
#. Speaker = Mattis
#. NodeID = 302eba85-1c63-477f-a00f-38ac1f0e9975
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidAttack_HasMet_PickpocketTraderAfterAttack(1) = True
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_PickpocketTrader:302eba85-1c63-477f-a00f-38ac1f0e9975
msgctxt "h3208879cg8c70g4f0dg9a96gc30410bbdb5e"
msgid "Don't even think about touching the druids' stuff. We called it first."
msgstr "드루이드 물건 손댈 생각일랑 마. 우리가 먼저 찜해뒀어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_PickpocketTrader
#. Speaker = Mattis
#. NodeID = 4edcafcb-46d3-220e-31d7-c8e4b0ff4704
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_PickpocketTraderAfterAttack(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_PickpocketTrader:4edcafcb-46d3-220e-31d7-c8e4b0ff4704
msgctxt "h24a4ecb2g6f34g4210gbd16g08d97e1a98a8"
msgid "There goes half my customers. But you'll make up the difference, right?"
msgstr "고객이 반이나 사라졌네. 그래도 네가 그만큼 더 사줄 거지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_PickpocketTrader
#. Speaker = Mattis
#. NodeID = a6fbe0bf-ea4c-0350-cb2f-9f9e6f5245be
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_PickpocketTrader:a6fbe0bf-ea4c-0350-cb2f-9f9e6f5245be
msgctxt "hcbfcd534g1d72g48d9gab8dg964f0a143acf"
msgid "Just have to replenish our stock first."
msgstr "우선 재고부터 보충해야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_PickpocketTrader
#. Speaker = Mattis
#. NodeID = aed3c71f-4ae7-602a-f03c-128dac3a29c5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_PickpocketTrader:aed3c71f-4ae7-602a-f03c-128dac3a29c5
msgctxt "h931c5fbcg993fg456agbd13g4d1a1856efbd"
msgid "Hiding with the children, huh? I get it."
msgstr "애들하고 숨어있으라고? 알겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_PrisonGuard
#. Speaker = Tilses
#. NodeID = ab22b38a-ec7a-aff4-9635-3d8c653fc6c7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidAttack_HasMet_PrisonGuardAfterAttack(1) = True
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_PrisonGuard:ab22b38a-ec7a-aff4-9635-3d8c653fc6c7
msgctxt "h3c6c400ag36d4g411fg8ed7g35c790f5f380"
msgid "You look ready. Wish it were contagious."
msgstr "넌 준비 된 거 같네. 우리도 그래야 하는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_PrisonGuard
#. Speaker = Tilses
#. NodeID = ddfc1d11-a118-d821-cf5d-1079f19ffe3f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_PrisonGuardAfterAttack(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_PrisonGuard:ddfc1d11-a118-d821-cf5d-1079f19ffe3f
msgctxt "hf93b2f2fg0de8g4f24gb9aag5d968a234641"
msgid ""
"No point hanging around. We need to get ready for... for whatever comes next."
msgstr "어슬렁거릴 틈 따위 없어. 대비를 해둬야 한다고... 다음에 뭐가 닥드리든지 말이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_PrisonGuard
#. Speaker = Tilses
#. NodeID = e10a64f6-a26b-1931-a82f-af10569b12da
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_PrisonGuard:e10a64f6-a26b-1931-a82f-af10569b12da
msgctxt "h4e37eee6g93beg472cg9554g3942cea68b97"
msgid "<i>Bloody </i>bigots."
msgstr "<i> 빌어먹게 </i> 편협한 것들."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Prodigy
#. Speaker = Rolan
#. NodeID = 5fa557fc-ab0d-fc40-6697-ae4cea7c6550
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Prodigy:5fa557fc-ab0d-fc40-6697-ae4cea7c6550
msgctxt "h1064410ag37ebg4534gb4f8ga952cf76afd0"
msgid ""
"So you <i>can </i>handle yourself. Not bad - those druids really should have "
"known better."
msgstr "스스로 대처<i>할 수</i> 있었나 보네. 나쁘지 않아 - 드루이드 놈들 이렇게 될 줄 알았어야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Prodigy
#. Speaker = Rolan
#. NodeID = b01eece7-2cc7-daae-a518-5cfc0ede6a8b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Prodigy:b01eece7-2cc7-daae-a518-5cfc0ede6a8b
msgctxt "h651acf0egaa7eg4e2fg9e69geb773c9b6c4d"
msgid "Let them come! I'll end them with a single spell."
msgstr "오라고 해 봐! 단 한 번의 주문으로 끝장내주지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ProdigyBrother
#. Speaker = Cal
#. NodeID = 6a807557-4e1e-51c5-c93e-c8f6c9c4bdda
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ProdigyBrother:6a807557-4e1e-51c5-c93e-c8f6c9c4bdda
msgctxt "h7439a5f1g2a0eg4f4cg90e6g44f2318b7c09"
msgid "Damn it. How many are there?"
msgstr "이런 망할. 얼마나 많은 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ProdigyBrother
#. Speaker = Cal
#. NodeID = cab2d412-4a3c-fc79-f288-d6cb08643195
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ProdigyBrother:cab2d412-4a3c-fc79-f288-d6cb08643195
msgctxt "h7a07ffc3g55edg4c54g9bd4g2a755da4bd74"
msgid ""
"More blood and death. Don't know about you, but I'll never get used to it."
msgstr "더 많은 피와 죽음이라니. 당신은 몰라도, 저는 절대 익숙해지지 못하겠네요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ProdigySister
#. Speaker = Lia
#. NodeID = ebfb1c73-66e5-52dd-2599-d9899b6870c5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ProdigySister:ebfb1c73-66e5-52dd-2599-d9899b6870c5
msgctxt "h181ac23fg2f2fg491dg9865g7efc9b79253a"
msgid "I'm glad we were here - who knows what would have happened otherwise?"
msgstr "우리가 여기 함께 있어서 다행이야. 그렇지 않았다면 무슨 일이 있었을지 누가 알았겠어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ProdigySister
#. Speaker = Lia
#. NodeID = f8306c2a-b22b-ef6b-d44b-3bdbdd644d90
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ProdigySister:f8306c2a-b22b-ef6b-d44b-3bdbdd644d90
msgctxt "h36b7d0d9gbdbfg484eg9aaeg9cdc20cd3287"
msgid "My blade is ready."
msgstr "내 검은 준비됐어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Protester1
#. Speaker = Rechel
#. NodeID = 39023012-cd56-4ec6-ab0c-ef5dc42b5378
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Protester1:39023012-cd56-4ec6-ab0c-ef5dc42b5378
msgctxt "h4b36f144g2531g4709gb1a9g42c6a687dc80"
msgid "The druids have gone mad - save yourself!"
msgstr "드루이드들이 미쳐 버렸어. 스스로를 지켜!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Protester1
#. Speaker = Rechel
#. NodeID = 5fea07ae-f496-b1c5-1801-60415a14cfa8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_Protester1AfterAttack(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Protester1:5fea07ae-f496-b1c5-1801-60415a14cfa8
msgctxt "h530016a3gabfeg4524g9389g35112ab24e7c"
msgid "Look at this place. Some safe haven it turned out to be."
msgstr "이곳을 봐. 안전한 피난처인 줄 알았는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Protester1
#. Speaker = Rechel
#. NodeID = c7618b45-5162-23c3-5a79-7319da144e12
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidAttack_HasMet_Protester1AfterAttack(1) = True
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Protester1:c7618b45-5162-23c3-5a79-7319da144e12
msgctxt "h534ae804g87c9g4d81g8414gee8ad19a1fbe"
msgid "The whole place smells of blood. If I could be anywhere else..."
msgstr "도처에 피 냄새가 진동해. 다른 곳으로 갈 수만 있다면..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Protester2
#. Speaker = Amek
#. NodeID = 5300c1a5-ce69-707f-306a-ff2696b41a0c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidAttack_HasMet_Protester2AfterAttack(1) = True
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Protester2:5300c1a5-ce69-707f-306a-ff2696b41a0c
msgctxt "h662985f3ga968g4e69ga8f8gb7007bd6b96f"
msgid "I hope that lot burn in whatever hell they're destined for."
msgstr "저 자식들이 어느 지옥으로 떨어지든 죄다 불타버리길."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Protester2
#. Speaker = Amek
#. NodeID = 5f3b4115-2923-59d3-6d22-f70cd55f7e56
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Protester2:5f3b4115-2923-59d3-6d22-f70cd55f7e56
msgctxt "he5f65fc9g2926g43a0g99fcg7667535cba76"
msgid "The druids - they're <i>attacking us!</i>"
msgstr "드루이드들이, 놈들이 <i>우리를 공격한다!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Protester2
#. Speaker = Amek
#. NodeID = b9e6108f-22df-f969-112f-cdc9ec228945
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_Protester2AfterAttack(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Protester2:b9e6108f-22df-f969-112f-cdc9ec228945
msgctxt "hd57933d0ga4c1g4bf0gba90gb5a259e38123"
msgid ""
"Can you believe those druids? Taking us in, then <i>turning </i>on us? "
"Savages."
msgstr "저 드루이드들 믿을 수 있겠어요? 우리를 들여보내주더니, <i>뒤통수</i>를 친다고? 미개한 놈들."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Protester3
#. Speaker = Xeph
#. NodeID = 0e210c3c-d816-9594-13a4-aaaa5e92c912
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_Protester3AfterAttack(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Protester3:0e210c3c-d816-9594-13a4-aaaa5e92c912
msgctxt "ha20f47d0g74cfg47b3g9431g69fe2a49ec12"
msgid "Thought we were safe here. But nowhere's safe, is it?"
msgstr "우린 여기서 안전한 줄 알았어요. 그런데 안전한 곳은 아무 데도 없는 것 같네요, 그렇죠?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Protester3
#. Speaker = Xeph
#. NodeID = 2383efd2-a5fb-162b-c6da-8a0b86bab2c7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Protester3:2383efd2-a5fb-162b-c6da-8a0b86bab2c7
msgctxt "hf743c796g5fbcg4931gaccbga1714dbfd381"
msgid "The druids have turned on us - defend yourself!"
msgstr "드루이드들이 우리에게 등을 돌렸어! 스스로를 방어해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Protester3
#. Speaker = Xeph
#. NodeID = eb9f4a60-a893-7354-83d4-22086900168e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidAttack_HasMet_Protester3AfterAttack(1) = True
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Protester3:eb9f4a60-a893-7354-83d4-22086900168e
msgctxt "hfe182defg26e3g42f5ga1ebgca1bb03372e6"
msgid ""
"I was so relieved when we found this place. Now I can't wait to put it "
"behind me."
msgstr "우리가 이곳을 찾았을 때 저는 너무 기뻤어요. 이제는 그냥 빨리 떠나버리고 싶군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_RangerTrader
#. Speaker = Eramas
#. NodeID = 40965efd-aede-35f9-12ee-856a1e9e52a7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidAttack_HasMet_RangerTraderAfterAttack(1) = True
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_RangerTrader:40965efd-aede-35f9-12ee-856a1e9e52a7
msgctxt "hcad6d586ga83ag46bcg9438g023cac35d9a2"
msgid ""
"Thank you for helping us. Seems like there's<i> </i>still a few <i>real </"
"i>adventurers left."
msgstr "도와줘서 고마워요. 아직 <i>진정한</i> 모험가들이 남아있는 것 같군요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_RangerTrader
#. Speaker = Eramas
#. NodeID = 558412b9-b86b-8da4-3e85-14e09d0b8f0b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_RangerTraderAfterAttack(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_RangerTrader:558412b9-b86b-8da4-3e85-14e09d0b8f0b
msgctxt "hc6ae5e2fg0357g45d6ga728g90809dea5332"
msgid ""
"Those 'adventurers' ran at the slightest sound of trouble. At least they "
"left their goods. Take your pick."
msgstr "저 '모험가'들은 문제 생길 기미가 살짝이라도 보이자 도망쳐 버렸어요. 그래도 자기들 물건은 남겨두고 갔네요. 골라 봐요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_RangerTrader
#. Speaker = Eramas
#. NodeID = bcc9243a-f05a-90d1-a5cf-171441a274a2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_RangerTrader:bcc9243a-f05a-90d1-a5cf-171441a274a2
msgctxt "hc8f001b3g70ffg4fcbga229g6ecc9ae2b651"
msgid "I knew it. Damn druids. Get ready!"
msgstr "망할 드루이드 놈들, 알고 있었지. 준비해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Refugee004
#. Speaker = Toron
#. NodeID = 9e986a22-7175-a2dc-729b-665d2b226b06
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidAttack_HasMet_ToronAfterAttack(1) = True
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Refugee004:9e986a22-7175-a2dc-729b-665d2b226b06
msgctxt "h60cb6c0dg77c9g4883gb983g0cc6779c3156"
msgid ""
"We stood our own, I'll admit. Looks like we'll have to do it again with the "
"goblins."
msgstr "우리 힘으로 잘 이겨내긴 했네. 고블린 놈들 상대로도 똑같이 잘 해봐야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Refugee004
#. Speaker = Toron
#. NodeID = a79b8aff-67fd-da55-665c-30629560944d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Refugee004:a79b8aff-67fd-da55-665c-30629560944d
msgctxt "h1890528cgca22g4aaag8422g7b412e29687e"
msgid "They actually did it - those bloody druids have turned on us!"
msgstr "놈들이 진짜 일을 저질렀어. 망할 드루이드들이 우리 뒤통수를 쳤다고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Refugee004
#. Speaker = Toron
#. NodeID = fb973b1d-3a47-44a8-cba4-d44a62f5c7f7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_ToronAfterAttack(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Refugee004:fb973b1d-3a47-44a8-cba4-d44a62f5c7f7
msgctxt "h0b699188ga1b0g43efg8c8dga28549a6217c"
msgid ""
"A pile of dead druids, and the rest of us weakened before another fight. "
"Perfect."
msgstr "드루이드는 떼죽음 당했고, 남은 우린 또 다른 싸움 앞두고 진을 다 빼버렸군. 환장하겠네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_RitualDruid1
#. Speaker = Aelar
#. NodeID = f12bc1ec-b67f-2ba0-e5ba-bcecc78c96bd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_RitualDruid1:f12bc1ec-b67f-2ba0-e5ba-bcecc78c96bd
msgctxt "h2cd1210ag2d7bg4029g938ag59e0c2b67ed5"
msgid "Get back!"
msgstr "물러서!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_RitualDruid2
#. Speaker = Karrik
#. NodeID = cfa97eff-9ab7-f37e-666d-578a71746ee8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_RitualDruid2:cfa97eff-9ab7-f37e-666d-578a71746ee8
msgctxt "h132722e3g6c78g4e1cgbb69gf3115bd171be"
msgid "You won't stop us!"
msgstr "우리를 막지는 못할 거야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_RitualDruid3
#. Speaker = Inwe
#. NodeID = 1ecf9c5d-1bbd-4a8f-777a-a7b78c7f8cc7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_RitualDruid3:1ecf9c5d-1bbd-4a8f-777a-a7b78c7f8cc7
msgctxt "hfc1ea41fg9b75g46aegb8f8gc1f3d7d47276"
msgid "We <i>will </i>protect this grove."
msgstr "우리는 이 숲을 <i>수호</i>할 것이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_RitualDruid4
#. Speaker = Elwyn
#. NodeID = 7675eebb-eeef-07b4-e2ae-add6fa1e75b2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_RitualDruid4:7675eebb-eeef-07b4-e2ae-add6fa1e75b2
msgctxt "hd82da8aeg6ddeg4744gaa7fga7a2b42c76bd"
msgid "I'm sorry. But this must be done."
msgstr "유감이지만, 해야만 하는 일이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_RitualDruid5
#. Speaker = Tahan
#. NodeID = 8e8c2e7b-9868-8b54-3a60-0f2209c0ce55
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_RitualDruid5:8e8c2e7b-9868-8b54-3a60-0f2209c0ce55
msgctxt "h5b4d93feg0490g4f42g8942g95d5a1b4e607"
msgid "This is <i>our</i> grove!"
msgstr "여긴 <i>우리의</i> 숲이다!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_RobberKid
#. Speaker = Meli
#. NodeID = 6a561a3f-c805-c576-8f5f-96f5f128e70f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_RobberKid:6a561a3f-c805-c576-8f5f-96f5f128e70f
msgctxt "h75e082c6gc32bg4828ga0edgeca427903360"
msgid "You can beat them, can't you?"
msgstr "놈들 이길 수 있지? 그치?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_RobberKid
#. Speaker = Meli
#. NodeID = ea6cb360-fef8-9628-a2d5-87cefa277c52
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_RobberKidAfterAttack(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_RobberKid:ea6cb360-fef8-9628-a2d5-87cefa277c52
msgctxt "hc6d51d31g4ceag40f0gb329g4364c62d0e1a"
msgid ""
"Is it true some of the <i>rats </i>were druids? I used to have a pet rat."
msgstr "<i>쥐</i> 몇 마리가 드루이드였단 게 사실이야? 애완용으로 하나 길렀는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_RobberKid
#. Speaker = Meli
#. NodeID = fa58a8f7-f7fc-9865-4669-1c88f2b7190b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidAttack_HasMet_RobberKidAfterAttack(1) = True
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_RobberKid:fa58a8f7-f7fc-9865-4669-1c88f2b7190b
msgctxt "h34f5a83bg1f43g4eb4gb0e5g9d25499e9e26"
msgid "Suppose you get first pick of the loot, but leave something for us."
msgstr "전리품 댁이 먼저 챙겨도 괜찮은데, 우리 몫도 조금은 남겨줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Scammer
#. Speaker = Nerela
#. NodeID = 459dd4e4-d9a6-9bd1-8499-62d431dd294f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidAttack_HasMet_ScammerAfterAttack(1) = True
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Scammer:459dd4e4-d9a6-9bd1-8499-62d431dd294f
msgctxt "hf6f23143g62b2g4b27gb208g5f995df0fc00"
msgid "Just keeping watch."
msgstr "계속 지키는 중이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Scammer
#. Speaker = Nerela
#. NodeID = f2b71fcd-3341-4902-6ebd-adba568a2910
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Scammer:f2b71fcd-3341-4902-6ebd-adba568a2910
msgctxt "h94165d64ga6ddg4c13g8088g2839dce38f51"
msgid "There's nothing left those rats can take from me."
msgstr "저 쥐새끼들 나한테서는 아무것도 못 가져가."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Scammer
#. Speaker = Nerela
#. NodeID = ff0dc392-b982-5795-7049-e6452efe2c09
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_ScammerAfterAttack(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Scammer:ff0dc392-b982-5795-7049-e6452efe2c09
msgctxt "ha6f3882eg0432g4174gbb09gd9ff72e58c6c"
msgid ""
"Oh! Hi. Hello. You surprised me. But - erm - thank you! For your help with "
"the druids. A real star, you are."
msgstr "오! 아. 안녕. 깜짝 놀라긴 했지만 - 음 - 고마워! 드루이드에게서 도와준 거 말이야. 당신은 진짜 스타야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ScoutCaptive
#. Speaker = Findal
#. NodeID = 4ec69c54-f114-73ed-e7e7-ab66f4e65a95
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ScoutCaptive:4ec69c54-f114-73ed-e7e7-ab66f4e65a95
msgctxt "h85f3b54fgfce8g4267gaf74gbade4661a849"
msgid "You should have left while you could."
msgstr "떠날 수 있을 때 떠났어야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ServantGnome
#. Speaker = Loic
#. NodeID = 2e179242-0742-7e62-f7d7-a1e1d7cd0e93
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_ServantGnome(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ServantGnome:2e179242-0742-7e62-f7d7-a1e1d7cd0e93
msgctxt "hecb271c1g82e5g4d54g83c4gec900e57d0c8"
msgid "You've done enough."
msgstr "그만 해라 이제."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ServantGnome
#. Speaker = Loic
#. NodeID = e55ce4be-1e66-185a-ee6b-ad0c3ba6655e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidAttack_HasMet_ServantGnome(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ServantGnome:e55ce4be-1e66-185a-ee6b-ad0c3ba6655e
msgctxt "hd252a9a3g33f8g4c16g9573g7b4aafa80da4"
msgid "You will pay for this."
msgstr "대가를 치르게 해주마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ServantIntolerant
#. Speaker = Marcoryl
#. NodeID = 8df56805-ace8-0d75-15ea-d13ad2c80f4b
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: TIEFLING
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ServantIntolerant:8df56805-ace8-0d75-15ea-d13ad2c80f4b
msgctxt "h42774e70g680cg453ag8f1egff36832596d3"
msgid "Die, hellspawn."
msgstr "죽어라, 지옥의 자손아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ServantIntolerant
#. Speaker = Marcoryl
#. NodeID = 8df56805-ace8-0d75-15ea-d13ad2c80f4b
#. HandlePath = TaggedText[1].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ServantIntolerant:8df56805-ace8-0d75-15ea-d13ad2c80f4b
msgctxt "h6629b5deg037eg4c23ga7bfg84c49e400e65"
msgid "Die, hellspawn-lover."
msgstr "죽어라, 지옥의 자손 애호가야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ServantPlight
#. Speaker = Arron
#. NodeID = d8739c25-9bc7-1b30-f56b-2a0b036e6fa8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidAttack_HasMet_ServantPlight(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ServantPlight:d8739c25-9bc7-1b30-f56b-2a0b036e6fa8
msgctxt "ha48e84b4g0367g45b5g8861ge8fa43fac4e9"
msgid "This is your last chance. Leave."
msgstr "마지막 기회다. 떠나라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ServantPlight
#. Speaker = Arron
#. NodeID = fb86cead-bdfb-24a5-07d4-91b17846acbc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_ServantPlight(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ServantPlight:fb86cead-bdfb-24a5-07d4-91b17846acbc
msgctxt "he0fbc08bg1aaeg4015ga0e3g56ef0e391679"
msgid "You should leave, before my hands are forced."
msgstr "내가 강제로 쫓아내기 전에, 넌 떠나야 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_SnakeKid
#. Speaker = Arabella
#. NodeID = 3cfecc40-8a72-cff5-de04-b7db3e0cbc28
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_SnakeKid:3cfecc40-8a72-cff5-de04-b7db3e0cbc28
msgctxt "h48622ed2gd8bag4452ga296gb260d3318b69"
msgid "<i>I'm scared.</i>"
msgstr "<i>무서워요.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_SnakeKid
#. Speaker = Arabella
#. NodeID = aa040766-f580-d9d9-247b-8765c58d148a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_SnakeKid:aa040766-f580-d9d9-247b-8765c58d148a
msgctxt "h9ccd3c20gdf5dg4f98g8a23g31fb7b59c838"
msgid "They're gone. <i>Really </i>gone."
msgstr "다 죽었어요. <i>진짜</i> 죽은 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_SonOfChef
#. Speaker = Ikaron
#. NodeID = 52c3cb2f-b192-14ee-c923-c008a44c15c1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_SonOfChefAfterAttack(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_SonOfChef:52c3cb2f-b192-14ee-c923-c008a44c15c1
msgctxt "ha74bf667g40fcg489eg88efgdaaa0f93f61a"
msgid "We should be used to the knives in our backs by now."
msgstr "우리들 이젠 뒤통수 맞는 거에 익숙해져야 할 거 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_SonOfChef
#. Speaker = Ikaron
#. NodeID = 5ffb4b11-89cb-3e67-b0c0-7b66d537f940
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidAttack_HasMet_SonOfChefAfterAttack(1) = True
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_SonOfChef:5ffb4b11-89cb-3e67-b0c0-7b66d537f940
msgctxt "h2cd5ba8bge041g4c47gb31bg4104e0069e46"
msgid "I hope you're here when the goblins make their move."
msgstr "고블린들이 쳐들어 올 때도 댁이 있다면 좋겠는걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_SonOfChef
#. Speaker = Ikaron
#. NodeID = 7beac7f1-aeef-8b28-58d9-f9729f224029
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_SonOfChef:7beac7f1-aeef-8b28-58d9-f9729f224029
msgctxt "h42f9cc71ge189g4da5gbd7dg39795541878f"
msgid "Pick up a weapon and fight, damn it!"
msgstr "무기 들고 맞서 싸워, 제기랄!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_SonOfChef
#. Speaker = Ikaron
#. NodeID = ab37b65a-816c-0bca-00d3-4f6f09f512f8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_SonOfChef:ab37b65a-816c-0bca-00d3-4f6f09f512f8
msgctxt "h46384574g71a7g4daeg9fdag8041a294cc41"
msgid "Good thing you were with us."
msgstr "댁이 우리 편 들어 다행이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Stargazer
#. Speaker = Nadira
#. NodeID = 72f5fed9-1009-6e90-72eb-ff4ae5b5c886
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Stargazer:72f5fed9-1009-6e90-72eb-ff4ae5b5c886
msgctxt "hc3d2aa9dg9719g407cgaba9g0c010bd652c9"
msgid "Don't look at me! Those druids are out for blood."
msgstr "쳐다보지 마요! 저 드루이드들이 죽이려 한다고요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Stargazer
#. Speaker = Nadira
#. NodeID = 76f1adcb-9153-e080-0c9a-d20e54ce7252
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidAttack_HasMet_StargazerAfterAttack(1) = True
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Stargazer:76f1adcb-9153-e080-0c9a-d20e54ce7252
msgctxt "h1b1b33d9gd165g4243g8fc0gc95dabdaca37"
msgid ""
"Wouldn't be surprised if the earth opens up and swallows us at this point."
msgstr "이 상황에선 땅이 갈라지고 우릴 다 집어삼켜도 놀라지 않을 거 같네요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Stargazer
#. Speaker = Nadira
#. NodeID = 83b57536-43d2-2ee7-74b7-01f14f581612
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_StargazerAfterAttack(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Stargazer:83b57536-43d2-2ee7-74b7-01f14f581612
msgctxt "h2c6da045gc76dg46a5g99cdg86d75d4390a1"
msgid "This fight's over, but there will be more."
msgstr "이 싸움은 끝났지만, 앞으로 더 있을 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Tiefling001
#. Speaker = Rikka
#. NodeID = 9a984149-4e72-ed88-1cfc-0034e668ae6e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidAttack_HasMet_Tiefling001AfterAttack(1) = True
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Tiefling001:9a984149-4e72-ed88-1cfc-0034e668ae6e
msgctxt "h3825216fgd691g478egb2ccge3688ccdef2e"
msgid "Killing goblins is one thing, but this..."
msgstr "고블린 죽이는 건 그렇다 쳐도, 이들은..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Tiefling001
#. Speaker = Rikka
#. NodeID = a6ff1515-b182-68d3-a75c-6f58c650e488
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Tiefling001:a6ff1515-b182-68d3-a75c-6f58c650e488
msgctxt "h6ca86ef6g0b63g44f1g84e9g0a5a73e95953"
msgid "The druids will kill us - help us, please!"
msgstr "드루이드들이 우릴 죽일 거야. 도와줘, 제발!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Tiefling001
#. Speaker = Rikka
#. NodeID = d2e5c081-4415-dcc2-4dd7-f25c4aceade1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_Tiefling001AfterAttack(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Tiefling001:d2e5c081-4415-dcc2-4dd7-f25c4aceade1
msgctxt "h1f895323gba14g4540g980dgf8c79d7e95ab"
msgid "We got them. They're dead..."
msgstr "이겼어. 다 죽였다고..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Tiefling001
#. Speaker = Rikka
#. NodeID = e17a3fdc-377a-2010-ba8b-cb57c0d0c8c7
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Tiefling001:e17a3fdc-377a-2010-ba8b-cb57c0d0c8c7
msgctxt "h2e811413ga0eeg44d4gb855g9a1751a14584"
msgid "... I think I'm going to be sick."
msgstr "...나 토해버릴 거 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Tiefling004
#. Speaker = Kaldani
#. NodeID = 52b7275e-d9b7-92e6-a275-058c26579d15
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Tiefling004:52b7275e-d9b7-92e6-a275-058c26579d15
msgctxt "hd07f2428g3abfg41a3g91efg597521c6f6e0"
msgid "I'll take you all on! Just try me."
msgstr "내가 다 상대해 주마! 어디 덤벼보시지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Tiefling004
#. Speaker = Kaldani
#. NodeID = 6f15a7a1-7bbd-8f7e-284f-8281443a32de
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_Tiefling004AfterAttack(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Tiefling004:6f15a7a1-7bbd-8f7e-284f-8281443a32de
msgctxt "h7678bd75ge6d6g4fd4g81a9gdab87babc35d"
msgid ""
"No druids left to stop me from cutting down trees and making a nice "
"barricade."
msgstr "나무 베어다가 근사한 바리게이트 만드는 거 막을 드루이드는 이제 없어졌네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Tiefling004
#. Speaker = Kaldani
#. NodeID = e5d91acf-b311-4946-2c17-751b10a080fa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_Tiefling004AfterAttack(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Tiefling004:e5d91acf-b311-4946-2c17-751b10a080fa
msgctxt "h16544c0eg2bdcg411cgaa36g11874b7c6c50"
msgid "Tired of washing blood off my hands."
msgstr "손에서 피를 씻어내는 것도 이젠 지쳐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Tiefling005
#. Speaker = Pandirna
#. NodeID = 04052de8-3164-417d-b522-79d642b560f7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidAttack_HasMet_Tiefling005AfterAttack(1) = True
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Tiefling005:04052de8-3164-417d-b522-79d642b560f7
msgctxt "h5cc3210fgd8acg4049ga63fga4ebc3ef1e1c"
msgid ""
"I was able to wiggle a toe earlier - I guess that potion is finally wearing "
"off. Terrible timing, as usual."
msgstr "늦지 않게 발가락이 움직여지네 - 물약 효과가 비로소 사라졌나 봐. 타이밍 끔찍하네, 언제나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Tiefling005
#. Speaker = Pandirna
#. NodeID = 0f4e4630-a252-1629-13c4-2646c19c05ea
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_Tiefling005AfterAttack(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Tiefling005:0f4e4630-a252-1629-13c4-2646c19c05ea
msgctxt "hc7860ea9g89d5g478fgb636gf110f2f0a885"
msgid ""
"I can't believe I survived. Thank you - if they'd got to me... well, thank "
"you."
msgstr "살아남았다니 믿을 수가 없어. 고마워 - 만약 붙잡혔다면... 글쎄, 고마워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Tiefling005
#. Speaker = Pandirna
#. NodeID = 3498b47f-3540-9eb5-e472-a214d9ac6152
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidAttack_HasMet_Tiefling005AfterAttack(1) = True
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#.   Object:
#.      - DEN_General_State_PotionTieflingHealed(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Tiefling005:3498b47f-3540-9eb5-e472-a214d9ac6152
msgctxt "h74efee9ag88deg465fga2dfga0884c8b42e1"
msgid ""
"After this, I know we'll make it to Baldur's Gate. We've fought too hard not "
"to."
msgstr "이제는, 발더스 게이트에 갈 수 있을 거야. 안 가기엔 너무 열심히 싸웠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Tiefling005
#. Speaker = Pandirna
#. NodeID = 48f9cfaf-8957-cc6a-2625-d91565f05ce0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Tiefling005:48f9cfaf-8957-cc6a-2625-d91565f05ce0
msgctxt "h90e5ecbfgd75dg4ce1g82eegd2e00fe42d25"
msgid "Ignore me - protect the others!"
msgstr "무시해 - 다른 사람들을 지켜!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Tiefling005
#. Speaker = Pandirna
#. NodeID = 9427a320-5f6f-c683-9a99-7b55bddfc55e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#.   Object:
#.      - DEN_General_State_PotionTieflingHealed(0) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_Tiefling005AfterAttack(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Tiefling005:9427a320-5f6f-c683-9a99-7b55bddfc55e
msgctxt "h7147aa72g99c2g4d60gb9abg61f4ad6bebf5"
msgid ""
"Because of you, I could protect the people I call family. Thank you. It was "
"good to fight at your side."
msgstr "당신 덕분에, 가족 같은 사람들을 지킬 수 있었어. 고마워. 같은 편에서 싸울 수 있어서 좋았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Tiefling005
#. Speaker = Pandirna
#. NodeID = a7f07550-341a-144d-9135-335097e68f81
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_General_State_PotionTieflingHealed(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Tiefling005:a7f07550-341a-144d-9135-335097e68f81
msgctxt "hf70361eegf4ebg44d9g99f0g38dd6c54a546"
msgid ""
"I couldn't fight the goblins - but I'll make damn sure I get those druids."
msgstr "고블린과는 싸우질 못했지만 - 드루이드들은 아주 확실히 잡을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Tiefling010
#. Speaker = Lakrissa
#. NodeID = 2cb08a1a-e014-57ff-e6b5-8b359b766241
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_Tiefling010AfterAttack(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Tiefling010:2cb08a1a-e014-57ff-e6b5-8b359b766241
msgctxt "h2f43b2ebg404fg4521gb19cg8b397c63eaa5"
msgid ""
"You stood by us. I thought you might. Glad I was right. You might even hang "
"around and help us deal with goblins, by my reckoning."
msgstr ""
"당신은 우리 편에 서줬어. 그럴지도 모른다고 생각했는데, 내 생각이 맞아서 기뻐. 당신이 이곳에 남아서 고블린을 상대하는 걸 도와줄 수도 "
"있을 것 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Tiefling010
#. Speaker = Lakrissa
#. NodeID = 3883f5ab-eb6b-504e-9705-93a49cffa52f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidAttack_HasMet_Tiefling010AfterAttack(1) = True
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Tiefling010:3883f5ab-eb6b-504e-9705-93a49cffa52f
msgctxt "hdca34eeeg41d1g4bf7ga0fbg429f35fa50fe"
msgid ""
"When we make it to the city, I'm going to bed with a bottle. I'll have "
"bloody earned it. So will you."
msgstr "우리가 도시에 도착하면, 난 술을 가지고 침대에 들어갈 거야. 그 정도는 누릴 자격이 있다고 생각해. 당신도 마찬가지고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Tiefling010
#. Speaker = Lakrissa
#. NodeID = 5679aa9f-84a0-fd6c-b379-f9be826b86b5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Tiefling010:5679aa9f-84a0-fd6c-b379-f9be826b86b5
msgctxt "h3aed75e4gc45fg4ab5gba4fg68e1bb72b4ff"
msgid "It never <i>ends.</i>"
msgstr "끝이 <i>없군.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Tiefling011
#. Speaker = Zorru
#. NodeID = 1b00418d-422b-0dc8-73b9-a670dc48152e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidAttack_HasMet_Tiefling011AfterAttack(1) = True
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#. TagRule: GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Tiefling011:1b00418d-422b-0dc8-73b9-a670dc48152e
msgctxt "haa82e459g2caeg44fega561g6baa1d6151c6"
msgid "I said <i>out of my sight.</i>"
msgstr "내 눈앞에서 <i>꺼지라고</i> 했어!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Tiefling011
#. Speaker = Zorru
#. NodeID = 1b00418d-422b-0dc8-73b9-a670dc48152e
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidAttack_HasMet_Tiefling011AfterAttack(1) = True
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Tiefling011:1b00418d-422b-0dc8-73b9-a670dc48152e
msgctxt "h015a1892g47a5g4a3cg8869ga9a873f60233"
msgid "We're stronger than we thought. And the druid fight is proof."
msgstr "우린 우리가 생각한 것 이상으로 강해. 이 드루이드들이 증거지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Tiefling011
#. Speaker = Zorru
#. NodeID = 54859982-aff3-b940-fc6b-76322763b324
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Tiefling011_State_Met = True
#. TagRule: GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Tiefling011:54859982-aff3-b940-fc6b-76322763b324
msgctxt "hc69ecba1gd4ffg4faagbe43g4f68bd67d750"
msgid "Get away from me, before my blade finds your neck too."
msgstr "내 검이 네 목을 베기 전에, 나한테서 떨어져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Tiefling011
#. Speaker = Zorru
#. NodeID = 54859982-aff3-b940-fc6b-76322763b324
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_Tiefling011_State_Met = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Tiefling011:54859982-aff3-b940-fc6b-76322763b324
msgctxt "hf61fd01dg7ec4g461eg896ag75535bddc184"
msgid "Elturel. Hostile druids. Is nowhere safe?"
msgstr "처음엔 엘투렐. 이번엔 적대적인 드루이드라니. 안전한 곳은 없는 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Tiefling011
#. Speaker = Zorru
#. NodeID = 7869c8be-2e6c-f00a-af83-2e2689218036
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_Tiefling011AfterAttack(1) = True
#.   Global:
#.     - DEN_Tiefling011_State_Met = True
#. TagRule: GITHYANKI
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Tiefling011:7869c8be-2e6c-f00a-af83-2e2689218036
msgctxt "hb2abc5ddg610bg4754ga78ag1f513683b89c"
msgid "Out of my sight!"
msgstr "내 눈 앞에서 사라져!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Tiefling011
#. Speaker = Zorru
#. NodeID = 7869c8be-2e6c-f00a-af83-2e2689218036
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_Tiefling011AfterAttack(1) = True
#.   Global:
#.     - DEN_Tiefling011_State_Met = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Tiefling011:7869c8be-2e6c-f00a-af83-2e2689218036
msgctxt "h5f41b9fcg6b62g44degbb5dgc60b87373e4a"
msgid "We survived this, and goblins too. Maybe we do have a chance."
msgstr "우린 여기서도, 고블린에게서도 살아남았어. 우리에겐 아직 기회가 있을지도."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 1ca88241-c430-3c58-c119-28a0af27fdda
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_TieflingLeader:1ca88241-c430-3c58-c119-28a0af27fdda
msgctxt "h8dfc79efgd60cg47b2ga098ge3e4ce01bdc3"
msgid ""
"Thank you for standing with us. I need to check on my people, but come see "
"me when you have a chance."
msgstr "우리 편에 서 줘서 고맙네. 이제 난 내 사람들을 돌봐야 하지만, 시간이 있다면 언제든 날 찾아오게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 60a517a6-aea9-b062-9939-00f922eecfb0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_TieflingLeader_Quest_GobHuntResponded = False
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_LeaderAfterAttack(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_TieflingLeader:60a517a6-aea9-b062-9939-00f922eecfb0
msgctxt "h7ee8bd15ged43g4023ga28fg371bd2cc8d39"
msgid ""
"Please - come speak with me in the cave. I have an urgent matter to discuss "
"with you."
msgstr "부탁이네, 동굴에서 나와 대화해 주게. 자네와 상의할 급한 문제가 있네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 6f926ab9-abfb-b94e-bccd-f9ea83044dd6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_Event_FactionDeathCheckin = True
#. SetFlags:
#.   Global:
#.     - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_TieflingLeader:6f926ab9-abfb-b94e-bccd-f9ea83044dd6
msgctxt "hbf6c516fge67ag4acbga648g794d6dd89019"
msgid "I knew Kagha had twisted them, but for so many to turn on us..."
msgstr "카그하가 그들을 뒤틀었다는 건 알고 있었지만, 이리도 많은 이들이 우리에게 등을 돌릴 줄이야..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 93d43b5e-50f8-c3bf-c3b3-ac6f4139d524
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_TieflingLeader:93d43b5e-50f8-c3bf-c3b3-ac6f4139d524
msgctxt "h691691b6g2307g421fgaf9cge1cb495570a1"
msgid "Prepare yourself - I believe the druids are moving on us."
msgstr "준비하게, 드루이드들이 우리를 향해 오고 있는 것 같네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_TieflingLeader
#. Speaker = Zevlor
#. NodeID = 9465f24e-b23d-cd2b-cae5-69bb00eca31a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_LeaderAfterAttack(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_TieflingLeader:9465f24e-b23d-cd2b-cae5-69bb00eca31a
msgctxt "h6c4506e7gf0e1g49bbgb126g12f27b1b3515"
msgid ""
"Let's talk later. Our troubles aren't over yet - the goblins are still out "
"there."
msgstr "나중에 얘기하지. 아직 문제가 남아 있네 - 고블린들이 여전히 저 밖에 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_TieflingLeader
#. Speaker = Zevlor
#. NodeID = c69dbc2a-e05a-e700-ffe1-725dd6a14df1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidAttack_HasMet_LeaderAfterAttack(1) = True
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_TieflingLeader:c69dbc2a-e05a-e700-ffe1-725dd6a14df1
msgctxt "h1270f479g8ff3g456eg842bg2b0e1f1f55a4"
msgid "To think that this place was once a refuge."
msgstr "이곳을 한때 피난처로 생각했었다니."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Trainee001
#. Speaker = Umi
#. NodeID = 1bb2380b-d51b-1623-e216-ae5cfee744aa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidAttack_HasMet_Trainee001AfterAttack(1) = True
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Trainee001:1bb2380b-d51b-1623-e216-ae5cfee744aa
msgctxt "h4dfe7c9bg7b29g48a0gb5dcg68001a7d39a5"
msgid "I just want to go home."
msgstr "전 그냥 집에 가고 싶어요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Trainee001
#. Speaker = Umi
#. NodeID = 8941a2ce-9866-42de-49d9-f18a97dc0e64
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Trainee001:8941a2ce-9866-42de-49d9-f18a97dc0e64
msgctxt "hfba5d50cga25fg46a1gb078g6058a47fea22"
msgid "They're supposed to be our friends."
msgstr "저 사람들 우리랑 친구인 줄 알았는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Trainee001
#. Speaker = Umi
#. NodeID = c7cc6431-3c49-dce7-eb27-e83fc9f6a9cc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_Trainee001AfterAttack(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Trainee001:c7cc6431-3c49-dce7-eb27-e83fc9f6a9cc
msgctxt "hc4cf3af0g39c3g42c7gaf13ge349fe8abb26"
msgid "Everyone hates us. But we didn't do anything."
msgstr "다들 우릴 싫어해요. 우린 아무 짓도 안 했는데요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Trainee002
#. Speaker = Ide
#. NodeID = 688cc2dc-a90a-87cb-1f50-0ceae2411da1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_Trainee002AfterAttack(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Trainee002:688cc2dc-a90a-87cb-1f50-0ceae2411da1
msgctxt "h382e263cg19e1g4ebcg8d91g4481e51a983c"
msgid "You fought them all, didn't you? Whoa."
msgstr "그쪽이 저 모두랑 싸운 거죠? 우와."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Trainee002
#. Speaker = Ide
#. NodeID = a56b6f3d-29ec-130a-1cf4-2b473ec53687
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidAttack_HasMet_Trainee002AfterAttack(1) = True
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Trainee002:a56b6f3d-29ec-130a-1cf4-2b473ec53687
msgctxt "h52b42fe5gefafg486bg90e8gcd3d271d7240"
msgid "You better help if the goblins come!"
msgstr "고블린 쳐들어 올 때도 꼭 도와주세요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Trainee002
#. Speaker = Ide
#. NodeID = e942634f-4792-a200-0ded-29e2f0b17f8e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Trainee002:e942634f-4792-a200-0ded-29e2f0b17f8e
msgctxt "hdfb31094g1417g449dg98f6gb7d587aac37e"
msgid "Don't let them get us!"
msgstr "저희 좀 지켜주세요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Trainee003
#. Speaker = Gan
#. NodeID = 5e3988fc-1efa-7183-b533-19614b1ea316
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidAttack_HasMet_Trainee003AfterAttack(1) = True
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Trainee003:5e3988fc-1efa-7183-b533-19614b1ea316
msgctxt "h4797ade6g25a1g4fe5g9485ge612e1c682f0"
msgid "Leave one for me next time! A little one."
msgstr "다음엔 제 몫도 남겨 줘요! 쬐끄만 놈으로요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Trainee003
#. Speaker = Gan
#. NodeID = 83cce1fc-65e6-0f78-4ef2-77d389fc7e4f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_Trainee003AfterAttack(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Trainee003:83cce1fc-65e6-0f78-4ef2-77d389fc7e4f
msgctxt "h17303bfdg1264g47ceg87b5g619820a31538"
msgid "There's no druids left for us! No fair!"
msgstr "해치울 드루이드가 하나도 안 남았잖아! 치사해!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Trainee003
#. Speaker = Gan
#. NodeID = a5f20569-2d16-8b1a-9fff-350a6fe4a9a2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Trainee003:a5f20569-2d16-8b1a-9fff-350a6fe4a9a2
msgctxt "h3b688a5ega4eag45c7gb852g69c7c38d2385"
msgid "Don't worry about us. I'll stab anyone who sneaks in."
msgstr "우리 걱정은 마요. 누가 침입하면 제가 찔러버릴 거예요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Trainer
#. Speaker = Asharak
#. NodeID = 01b00788-91cd-96f4-1345-00e73479fd14
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Trainer:01b00788-91cd-96f4-1345-00e73479fd14
msgctxt "heab36f06g68fcg438bgad0dgefa4c43d83b9"
msgid "Get ready. It's happening. Just as I feared..."
msgstr "준비해. 내가 우려했던 대로 무언가 일이 일어나고 있어..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Trainer
#. Speaker = Asharak
#. NodeID = 170933ac-0330-b2b3-4488-d921d5f8781f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidAttack_HasMet_TrainerAfterAttack(1) = True
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#.      - DEN_TieflingLeader_State_PermaDefeated = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Trainer:170933ac-0330-b2b3-4488-d921d5f8781f
msgctxt "h9ddeb1a2g5b72g4af7ga354g6ae6fb1e190a"
msgid "Keep a good eye out. I don't trust anything anymore."
msgstr "제대로 잘 살펴봐. 나는 이제 아무 것도 믿지 못하겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Trainer
#. Speaker = Asharak
#. NodeID = 404ae5b5-9108-e86c-8046-64909f6aefef
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_Event_FactionDeathCheckin = True
#. SetFlags:
#.   Global:
#.     - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Trainer:404ae5b5-9108-e86c-8046-64909f6aefef
msgctxt "h15147039g05adg40ddgac89gaccab8dc44fb"
msgid ""
"I can't believe they turned on us. I suppose I <i>can </i>but... there are "
"children here."
msgstr "우리에게 등을 돌리다니 믿기지 않아. 난 <i>그렇다</i> 쳐도... 여긴 아이들이 있잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Trainer
#. Speaker = Asharak
#. NodeID = 8221fd47-86b1-768c-3263-dc7b2ecc803d
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_TrainerAfterAttack(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Trainer:8221fd47-86b1-768c-3263-dc7b2ecc803d
msgctxt "h936193dfgd92eg4ce9gbb57gc964e40609be"
msgid ""
"We need to prepare the gate. The threat <i>inside </i>is gone, but it's a "
"wild world out here."
msgstr "문이 필요해. <i>내부의</i>위협은 없어졌지만, 바깥 세상은 여전히 위험해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Trainer
#. Speaker = Asharak
#. NodeID = 8bfaf06d-bb83-3200-56d0-d50b2f18aa70
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Trainer:8bfaf06d-bb83-3200-56d0-d50b2f18aa70
msgctxt "h3c983a2fg5e07g4132g8a56g4a9c2993bf1e"
msgid "I thought druids valued life. Shows what I know."
msgstr "드루이드는 생명을 가치 있게 여기는 줄 알았어. 얼마나 몰랐던 건지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Trainer
#. Speaker = Asharak
#. NodeID = 97b829e7-8791-87e3-5f27-62ffcaddf468
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#.      - DEN_TieflingLeader_State_PermaDefeated = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_TrainerAfterAttack(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Trainer:97b829e7-8791-87e3-5f27-62ffcaddf468
msgctxt "h0cda9a4fg1bb6g4f08g970fgce697ab9ff5e"
msgid ""
"High time we put an end to every enemy that's haunted us here. You've given "
"us that chance. We won't waste it."
msgstr "지금이야말로 우리를 끊임없이 괴롭히던 모두를 끝장낼 때야. 네가 만들어 준 기회지. 절대 낭비하지 않겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Trainer
#. Speaker = Asharak
#. NodeID = b5b75e1b-0481-878f-eaed-2276d706c477
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Trainer:b5b75e1b-0481-878f-eaed-2276d706c477
msgctxt "h2f958eb3gc564g4106g8ac9g8c7009c0f894"
msgid ""
"We'd best prepare for the worst. If more goblins come now, we won't stand a "
"chance. Out of the cookpan..."
msgstr "최악의 상황에 대비하는 게 좋겠어. 지금 고블린 무리가 또 몰려온다면, 우리는 가망이 없네. 엎친 데 덮친다더니..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Trainer
#. Speaker = Asharak
#. NodeID = ba21e915-df95-d56f-366f-5097e8932239
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidAttack_HasMet_TrainerAfterAttack(1) = True
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Trainer:ba21e915-df95-d56f-366f-5097e8932239
msgctxt "ha90079a5gd55fg429eg9cb8gfaab88c07024"
msgid ""
"We won't forget what you did for us. You're one of <i>us </i>now. Always."
msgstr "네가 우리에게 해준 일을 잊지 않겠어. 넌 이제 <i>우리 </i> 일원이야. 언제나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_VoloBear
#. Speaker = Bosk
#. NodeID = 14f8b0b5-34c0-7f42-7c32-06eebc702fcd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidAttack_HasMet_VoloBear(1) = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_VoloBear:14f8b0b5-34c0-7f42-7c32-06eebc702fcd
msgctxt "h957e1f8bg3861g48dega79cg13d12701f6f2"
msgid "Monsters, all of you."
msgstr "너희들은 모두 괴물이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_VoloBear
#. Speaker = Bosk
#. NodeID = e47d76e8-a362-3a5b-261c-9f936e3c276a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_VoloBear:e47d76e8-a362-3a5b-261c-9f936e3c276a
msgctxt "h78f440fcgf369g4a81gb27ag6190cedb9c2c"
msgid "*Growl.*"
msgstr "*으르렁.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_VoloBear
#. Speaker = Bosk
#. NodeID = f40013e9-c009-79c0-6a70-a4ba53b16b5a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_VoloBear(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_VoloBear:f40013e9-c009-79c0-6a70-a4ba53b16b5a
msgctxt "hde41f336g9e89g4acegb9f0gf95a45869446"
msgid "We welcomed you, and now <i>this</i>?"
msgstr "우리는 너희를 환영해 줬건만, 은혜를 <i>이런 식으로</i>갚아?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Weaponsmith_PostEA
#. Speaker = Player
#. NodeID = 11fb682b-7aee-3465-b28a-bbb3d6b4f166
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Weaponsmith_PostEA:11fb682b-7aee-3465-b28a-bbb3d6b4f166
msgctxt "h7429792dgc61bg48acgbd12g4c1e60323094"
msgid "How are you managing to forge anything out here?"
msgstr "어떻게 이런 곳에서 대장장이 일을 해 나가고 있는 거지?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Weaponsmith_PostEA
#. Speaker = Player
#. NodeID = 53bb1edd-5b39-4715-bcbf-438091c50ba8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Weaponsmith_PostEA:53bb1edd-5b39-4715-bcbf-438091c50ba8
msgctxt "hd93c4339g487ag4a70g9d0fg58a151fdef91"
msgid "Let's see your wares."
msgstr "뭘 파는 지 보여줘."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Weaponsmith_PostEA
#. Speaker = Dammon
#. NodeID = 618ca4d7-b957-4741-87cd-e5e4511cdaa9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Weaponsmith_PostEA:618ca4d7-b957-4741-87cd-e5e4511cdaa9
msgctxt "hd426fc10gd193g4fd6g92abgff4181ef4646"
msgid "Could be a day or a season - bad timing for us either way."
msgstr "당장 내일일 수도 아니면 한 계절이 지나고 올 수도 있겠죠. 둘 다 우리에겐 좋은 시기는 아닙니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Weaponsmith_PostEA
#. Speaker = Dammon
#. NodeID = 7ff595a0-1a66-4cc4-9a70-f30d3d5db347
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Weaponsmith_PostEA:7ff595a0-1a66-4cc4-9a70-f30d3d5db347
msgctxt "h0a518909g4787g4065gb83egb76af089e59e"
msgid "The goblins will run us through unless I get them mended."
msgstr "고치지 않으면 고블린한테 모두 당하고 말겁니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Weaponsmith_PostEA
#. Speaker = Dammon
#. NodeID = 82c4e20c-82e9-93a7-c4f7-55bcd2439671
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Weaponsmith_PostEA:82c4e20c-82e9-93a7-c4f7-55bcd2439671
msgctxt "h6143fa4agbb42g4f95g9752g6e0cebd507a0"
msgid ""
"Between you and me, there's nothing in all the realms like the utter power "
"of infernal machinery. Can't replicate it outside the Hells. Probably for "
"the best."
msgstr ""
"우리끼리니까 하는 얘긴데, 지옥 기계장치의 순수한 힘과 비교될 만한 건 모든 세계를 통틀어도 없답니다. 지옥 바깥에서는 재현할 수 없죠. "
"다행이라고 해야겠군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Weaponsmith_PostEA
#. Speaker = Dammon
#. NodeID = 8d23ece8-b45c-47b9-aec8-610d888f1f95
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidAttack_HasMet_WeaponsmithAfterAttack(1) = True
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Weaponsmith_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Weaponsmith_PostEA:8d23ece8-b45c-47b9-aec8-610d888f1f95
msgctxt "ha176c709g5d47g4202ga898g694adfa3e11a"
msgid "I've got a dozen weapons to reforge. Goblins better not get here first."
msgstr "수리해야 할 무기가 열댓 개는 있습니다. 고블린들이 그 전에 오지 않았으면 하네요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Weaponsmith_PostEA
#. Speaker = Dammon
#. NodeID = a2e808ed-44a8-4779-aff0-a56f0d0c4f80
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Weaponsmith_PostEA:a2e808ed-44a8-4779-aff0-a56f0d0c4f80
msgctxt "ha0fec332g8656g4ac0ga588g4a21a96267a2"
msgid "We'll just have to prepare as best we can."
msgstr "우리는 그저 할 수 있는 최대한 대비할 수밖에요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Weaponsmith_PostEA
#. Speaker = Player
#. NodeID = aebb5faa-4cd2-4e4c-b428-ddb79c4c0c8c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidAttack_Event_WeaponsmithAboutGoblins(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_Event_WeaponsmithAboutGoblins(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Weaponsmith_PostEA:aebb5faa-4cd2-4e4c-b428-ddb79c4c0c8c
msgctxt "h3c53e13cgdd19g4131g8547g4bc4892ce203"
msgid "When do you think the goblins will attack?"
msgstr "고블린들이 언제 공격해올 것 같아?"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Weaponsmith_PostEA
#. Speaker = Dammon
#. NodeID = c0beeb0a-a60f-4168-dc1e-c2e6b4e5fc51
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_Weaponsmith_Knows_Elturel(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Weaponsmith_PostEA:c0beeb0a-a60f-4168-dc1e-c2e6b4e5fc51
msgctxt "h88bfecb8g855fg4056g920fg149cbb2f8889"
msgid ""
"When Elturel fell into Avernus, I was drafted into an infernal forge. "
"Learned a few techniques for making a lot out of a little."
msgstr ""
"엘투렐이 아베르누스로 떨어졌을 때 전 지옥의 대장간에 끌려가 일했어요. 적게 가지고도 많이 얻어내는 요령을 몇 개나마 배웠습니다."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Weaponsmith_PostEA
#. Speaker = Dammon
#. NodeID = cdb4845b-26c0-48ce-a0e3-f0b5911e971c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#. SetFlags:
#.   Dialog:
#.     - DEN_Weaponsmith_HasMet(1) = True
#.     - DEN_DruidAttack_HasMet_WeaponsmithAfterAttack(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Weaponsmith_PostEA:cdb4845b-26c0-48ce-a0e3-f0b5911e971c
msgctxt "hdf84a535g7eadg4282gbf8cg7fc1368fe554"
msgid "We managed against the druids, but half our weapons are bent or broken."
msgstr "드루이드는 어떻게든 이겨냈지만, 우리가 가진 무기 절반이 구부러지거나 부러졌군요."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Weaponsmith_PostEA
#. Speaker = Dammon
#. NodeID = dc45d974-3350-4d64-bfb0-d0a0a447a395
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_Weaponsmith_HasMet(1) = True
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Weaponsmith_PostEA:dc45d974-3350-4d64-bfb0-d0a0a447a395
msgctxt "h41f85a7eg58cdg41bbgb277g121340dc170d"
msgid "Our steel better hold."
msgstr "우리 무기가 버텨주길."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Weaponsmith_PostEA
#. Speaker = Player
#. NodeID = e43dea16-09c3-4af6-80f2-274f0799253b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Weaponsmith_PostEA:e43dea16-09c3-4af6-80f2-274f0799253b
msgctxt "h7648c541g9472g4899ga543g7bab87013ab8"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Weaponsmith_PostEA
#. Speaker = Dammon
#. NodeID = e6872a81-cc37-6eb7-6c83-905a0409c2f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/GustavDev/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Weaponsmith_PostEA:e6872a81-cc37-6eb7-6c83-905a0409c2f1
msgctxt "h1cc40d45g8f45g49dcg99c5gdc9e44678ee9"
msgid ""
"Though I wouldn't mind a bit of hellfire to put to use protecting this place."
msgstr "그렇지만 여길 지켜내는 데에 쓴다고 하면 지옥불이 조금 있어도 괜찮겠네요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Wyll
#. Speaker = Wyll
#. NodeID = 86334324-144f-d22d-d344-c9cd71db7a89
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Wyll:86334324-144f-d22d-d344-c9cd71db7a89
msgctxt "h01750181gfc14g489bgbd58gfbe2472d7333"
msgid "Not now. Trouble's afoot."
msgstr "나중에 얘기하자. 지금 상황이 심각해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Wyll
#. Speaker = Wyll
#. NodeID = ce4e2517-754d-128b-0c31-bd27a7eb19e7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_Wyll:ce4e2517-754d-128b-0c31-bd27a7eb19e7
msgctxt "h2f7b9b62g9244g45f2g8959g87ddc7d1bb63"
msgid "On your guard. Goblins are coming. I can <i>smell</i> them."
msgstr "조심해. 고블린들이 오고 있어. 놈들의 <i>냄새</i>가 나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_YoungLover01
#. Speaker = Danis
#. NodeID = 828704e5-106d-b9c8-801b-4fa33a7bc215
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_Lover01AfterAttack(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_YoungLover01:828704e5-106d-b9c8-801b-4fa33a7bc215
msgctxt "h06e86829gea46g449cg8fc9ga40e3ebc1fa8"
msgid ""
"I thought druids were peaceful sorts - nature-lovers. Shows what I know."
msgstr "난 드루이드들이 평화주의자로 알았는데. 자연 애호가니까. 내 생각이 틀렸네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_YoungLover01
#. Speaker = Danis
#. NodeID = 90f11bf8-f563-5a1e-4684-c186485e41f5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_YoungLover01:90f11bf8-f563-5a1e-4684-c186485e41f5
msgctxt "ha27c7339g7daag4affg99f7ge17a4c58381b"
msgid "Why are they doing this...?"
msgstr "대체 왜 이런 짓을 하는 거지...?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_YoungLover01
#. Speaker = Danis
#. NodeID = ddad7864-97b1-19c0-7f71-b5360b3d83a8
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidAttack_HasMet_Lover01AfterAttack(1) = True
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_YoungLover01:ddad7864-97b1-19c0-7f71-b5360b3d83a8
msgctxt "h3db0ebe1gbc1fg4ce0g9e71g80b1b50d76e2"
msgid "We were lucky this time. Next time, who knows?"
msgstr "이번에는 운이 좋았지만, 다음번에도 그럴까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_YoungLover02
#. Speaker = Bex
#. NodeID = 19fd61e7-edf4-3924-6d2e-3ee74c5314e5
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_YoungLover02:19fd61e7-edf4-3924-6d2e-3ee74c5314e5
msgctxt "h22078f4ag0554g4eecgbc88g93f0bca3a50b"
msgid "The druids - someone stop them!"
msgstr "드루이드다! 누가 놈들 좀 막아줘!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_YoungLover02
#. Speaker = Bex
#. NodeID = 46accc01-cf7a-ab78-babe-bedfbebb7c93
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_YoungLover02:46accc01-cf7a-ab78-babe-bedfbebb7c93
msgctxt "h3bcabd01gd8beg44fbg86a3g64cd56b26956"
msgid ""
"Thought this place was pretty when we first arrived. Slaughterhouse now."
msgstr "처음 막 왔을 때만 해도 괜찮은 곳인 줄 알았는데 말이야. 이젠 도살장이 따로 없네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_YoungLover02
#. Speaker = Bex
#. NodeID = dd2bc006-fddc-79a0-b5e6-33ee3992738f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidAttack_State_PrepAfterDeathOfDruids = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_Lover02AfterAttack(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_YoungLover02:dd2bc006-fddc-79a0-b5e6-33ee3992738f
msgctxt "h7c690114g8fd5g45e5ga967g910f55848db4"
msgid "Safe. For now."
msgstr "살았네. 당장은."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ZenBear
#. Speaker = Ormn
#. NodeID = 0ff3968a-0c78-8975-0943-11177c6fddb4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidAttack_HasMet_ZenBear(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ZenBear:0ff3968a-0c78-8975-0943-11177c6fddb4
msgctxt "h5295307bg1b36g40efga63ege16aff852e6e"
msgid "You ruined it! You ruined Master's grove!"
msgstr "네가 망가뜨렸어! 네가 주인님의 숲을 망가뜨렸다고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ZenBear
#. Speaker = Ormn
#. NodeID = 683a1747-f72a-2bc0-5b16-20005e3ae8de
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ZenBear:683a1747-f72a-2bc0-5b16-20005e3ae8de
msgctxt "he5e3bd00g9ec8g4773ga11fg5c274a453a2a"
msgid "*Growl.*"
msgstr "*으르렁.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ZenBear
#. Speaker = Ormn
#. NodeID = 8ca2327a-e2b4-9314-c5fe-3a70eddda74b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidAttack_HasMet_ZenBear(1) = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_ZenBear:8ca2327a-e2b4-9314-c5fe-3a70eddda74b
msgctxt "h58c77c30gb962g403dg8cbbg88d061b6f7fb"
msgid "You will regret this, two-legs. No cave is deep enough to hide you."
msgstr "후회할 거다, 두 발 달린 것아. 세상 어느 동굴도 네가 숨기에 충분하지 않을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoAlliance
#. Speaker = Narrator
#. NodeID = 15296dfb-f664-3c2f-5927-8caf72a714f7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_DruidLair_Knows_DruidsAlliance = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoAlliance:15296dfb-f664-3c2f-5927-8caf72a714f7
msgctxt "hb10b3e00g90f9g4a00g9234g71bb590da728"
msgid ""
"*'Harp and wild'? You recall stories of an alliance between druids and the "
"Harpers, but the details are vague.*"
msgstr "*'하프와 야생'이라? 당신은 드루이드와 하퍼즈 사이의 연합에 대한 이야기를 떠올리지만, 자세한 내용은 모호합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoAlliance
#. Speaker = Narrator
#. NodeID = 18675c09-10f1-afcd-5453-96e4872921e2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoAlliance:18675c09-10f1-afcd-5453-96e4872921e2
msgctxt "h8ef70254g680ag4c32gb171ga30f11252cd2"
msgid ""
"\n"
"<i>*'In darkest hour, a concord made,\n"
"'Twixt harp and wild against the shade.'*</i>"
msgstr ""
"\n"
"<i>*'가장 어두운 시기에 이루어진 화합,\n"
"'하프와 야생이 어둠에 맞서.'*</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoAlliance
#. Speaker = Narrator
#. NodeID = 6604d12d-2765-b3ec-cc4b-3e94e7e9fafd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoAlliance:6604d12d-2765-b3ec-cc4b-3e94e7e9fafd
msgctxt "h51f8936dgaafdg4102g914ag9e59906e1713"
msgid ""
"*'Harp and wild'? A riddle to some, but you understand the meaning "
"immediately.*"
msgstr "*'하프와 야생'? 누군가에겐 수수께끼겠지만, 당신은 그 의미를 즉시 이해합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoAlliance
#. Speaker = Narrator
#. NodeID = 99475990-8620-de28-4a56-cdfa97708a85
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidLair_Knows_DruidsAlliance = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoAlliance:99475990-8620-de28-4a56-cdfa97708a85
msgctxt "h2ce62fc7g771eg46afga9e4g14befccc5ee8"
msgid ""
"\n"
"<i>*'In darkest hour, a concord made,\n"
"'Twixt harp and wild against the shade.'*</i>"
msgstr ""
"\n"
"<i>*'가장 어두운 시기에 이루어진 화합,\n"
"'하프와 야생이 어둠에 맞서.'*</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoAlliance
#. Speaker = Narrator
#. NodeID = a05c7005-7329-c299-d8ac-b2fe95039805
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_DruidLair_State_FailedAllianceFresco(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoAlliance:a05c7005-7329-c299-d8ac-b2fe95039805
msgctxt "h2ace9863gc1f0g4cc0g94bag67dfaa026a6a"
msgid "*Local history, written in riddles.*"
msgstr "*수수께끼로 적힌 지역 역사입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoAlliance
#. Speaker = Narrator
#. NodeID = af64a592-688d-fd2c-179f-940a0ed05e63
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_DruidLair_Knows_DruidsAlliance = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoAlliance:af64a592-688d-fd2c-179f-940a0ed05e63
msgctxt "hab2e0e89gbaddg4bcfg8eacgaaa5c2ff8e11"
msgid ""
"*The druids turned to the Harpers for help. Unusual for such a territorial "
"group.*"
msgstr "*드루이드는 하퍼즈에게 도움을 청했습니다. 영역적 성격이 강한 집단치고는 이례적인 일입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoAlliance
#. Speaker = Narrator
#. NodeID = cd0eeb73-5c38-b65c-1c42-3aa237966484
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_DruidLair_State_FailedAllianceFresco(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoAlliance:cd0eeb73-5c38-b65c-1c42-3aa237966484
msgctxt "h04fb4f9egc5e8g4129gbeaag564f7025118c"
msgid ""
"\n"
"<i>*'In darkest hour, a concord made,\n"
"'Twixt harp and wild against the shade.'*</i>"
msgstr ""
"\n"
"<i>*'가장 어두운 시기에 이루어진 화합,\n"
"'하프와 야생이 어둠에 맞서.'*</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoAlliance
#. Speaker = Narrator
#. NodeID = cdfdc108-831a-a637-f14a-e020391e2147
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoAlliance:cdfdc108-831a-a637-f14a-e020391e2147
msgctxt "h5c5bf4b7gbdbbg41e0g8549g4b32b2ec1f7c"
msgid ""
"*You surmise that the druids allied with the Harpers. A formidable force.*"
msgstr "*당신은 드루이드가 하퍼와 동맹을 맺었던 것으로 추측합니다. 엄청난 세력이었겠군요. *"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoFoundingGrove
#. Speaker = Narrator
#. NodeID = 5802f71c-c600-9aca-4c3b-715f0fb5e468
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_DruidLair_State_FailedFoundingFresco(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoFoundingGrove:5802f71c-c600-9aca-4c3b-715f0fb5e468
msgctxt "h5d8ee3ebg873bg4ad2gbf83g34c9151ab58b"
msgid ""
"*<i>'By claw and tooth, from root to thorn,\n"
"The Old Oak's grove, to wildlings sworn.'</i>*"
msgstr ""
"<i>*'발톱과 송곳니로 일어섰으며, 뿌리에서 가시까지 뻗어나가리.\n"
"야생의 맹세로 맺어진 오랜 떡갈나무 숲.'*</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoFoundingGrove
#. Speaker = Narrator
#. NodeID = 89bc86b0-59a6-6e46-0e97-fd9f03df08e4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoFoundingGrove:89bc86b0-59a6-6e46-0e97-fd9f03df08e4
msgctxt "h78aa5706g467cg4d08g98d4g2d8c7a038939"
msgid ""
"*<i>'By claw and tooth, from root to thorn,\n"
"The Old Oak's grove, to wildlings sworn.'</i>*"
msgstr ""
"<i>*'발톱과 송곳니로 일어섰으며, 뿌리에서 가시까지 뻗어나가리.\n"
"야생의 맹세로 맺어진 오랜 떡갈나무 숲.'*</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoFoundingGrove
#. Speaker = Narrator
#. NodeID = 9867291d-cc26-c072-3313-9d85f7b4bacd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = True
#. SetFlags:
#.   Global:
#.     - DEN_DruidLair_Knows_FoundingGrove = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoFoundingGrove:9867291d-cc26-c072-3313-9d85f7b4bacd
msgctxt "h67098244g2decg4331gb6a8gc578af61367a"
msgid ""
"*You recognise the druids as elders of a circle. This place is a divine "
"sanctuary.*"
msgstr "*당신은 그림의 드루이드가 회합의 장로들이라는 것을 알아챕니다. 이곳은 성소입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoFoundingGrove
#. Speaker = Narrator
#. NodeID = a90ed51d-c39b-1a4c-6e35-ef117dee032f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_DruidLair_Knows_FoundingGrove = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoFoundingGrove:a90ed51d-c39b-1a4c-6e35-ef117dee032f
msgctxt "ha7027cffg45d7g4757ga231g3ffe82f5eec9"
msgid ""
"*The mural shows druids claiming the grove in the name of the Old Oak - "
"Silvanus, god of nature.*"
msgstr "*이 벽화는 드루이드들이 고대 떡갈나무, 대자연의 신 실바누스의 이름으로 숲을 차지하는 것을 보여줍니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoFoundingGrove
#. Speaker = Narrator
#. NodeID = d8c36cde-9363-dacf-c174-623a27d3f053
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidLair_Knows_FoundingGrove = True
#. TagRule: CLERIC_EVIL or PALADIN_EVIL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoFoundingGrove:d8c36cde-9363-dacf-c174-623a27d3f053
msgctxt "ha0c5e0cdg5d22g4e98gb022g1a434d069f4b"
msgid ""
"*The fresco shows a group of druids blessing a damp cave. A weak ritual for "
"a weak god.*"
msgstr "*이 벽화는 한 무리의 드루이드가 축축한 동굴에 축복을 비는 것을 보여줍니다. 나약한 신을 위한 별 볼일 없는 의식입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoFoundingGrove
#. Speaker = Narrator
#. NodeID = d8c36cde-9363-dacf-c174-623a27d3f053
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidLair_Knows_FoundingGrove = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoFoundingGrove:d8c36cde-9363-dacf-c174-623a27d3f053
msgctxt "h897a2ebbg787cg4d97gb96dgd4969f12ec73"
msgid ""
"*The fresco shows a group of druids, gathered in Silvanus' name. You are on "
"sacred ground.*"
msgstr "*이 벽화는 실바누스의 이름 아래 모여있는 한 무리의 드루이드를 보여줍니다. 당신은 성소에 들어와 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoFoundingGrove
#. Speaker = Narrator
#. NodeID = e8fe35fc-7ae4-8f92-b624-81002e002adc
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_DruidLair_State_FailedFoundingFresco(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoFoundingGrove:e8fe35fc-7ae4-8f92-b624-81002e002adc
msgctxt "he78957f0geb5fg4041g87a2g36e4b24186c3"
msgid ""
"*The mural depicts a ritual, but you do not recognise the deity involved.*"
msgstr "*이 벽화는 의식을 묘사하고 있지만, 당신은 그에 관련된 신을 모릅니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoVictory
#. Speaker = Narrator
#. NodeID = 05e5297a-c9ab-5b4b-f84c-97a0a642de67
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = True
#. SetFlags:
#.   Global:
#.     - DEN_DruidLair_Knows_DruidsVictory = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoVictory:05e5297a-c9ab-5b4b-f84c-97a0a642de67
msgctxt "h4137b40dge9f8g4008gb472g8fe8ce00f5fb"
msgid ""
"*She and her druid allies bloodied Shar's forces. But Shar persists. She "
"<i>thrives</i>.*"
msgstr "*셀루네와 드루이드 동맹군은 샤의 군세를 피로 적셨습니다. 하지만 샤는 끈질기게 살아남습니다. 샤는 <i>융성</i>합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoVictory
#. Speaker = Narrator
#. NodeID = 0c839b00-c916-a226-1ff5-47094f7285d7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoVictory:0c839b00-c916-a226-1ff5-47094f7285d7
msgctxt "h0846492dg6825g4579g9b2cg08badfd475c0"
msgid "*You see vanquished foes heaped at the druids' feet.*"
msgstr "*당신은 패배한 적들이 드루이드의 발 아래 산더미처럼 쌓인 광경을 봅니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoVictory
#. Speaker = Narrator
#. NodeID = 21d8f855-c45c-4e41-0819-215b6919c94d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_DruidLair_Knows_DruidsVictory = True
#. TagRule: CLERIC_SHAR or PALADIN_SHAR
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoVictory:21d8f855-c45c-4e41-0819-215b6919c94d
msgctxt "h29ab1084g41f6g4422g82d4gdee8012ae042"
msgid "*The 'moonrise' must be your Lady's wretched sister, Selûne.*"
msgstr "*'문라이즈'라 함은 당신이 믿는 여신의 경멸스러운 자매, 셀루네를 뜻하는 게 분명합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoVictory
#. Speaker = Narrator
#. NodeID = 21d8f855-c45c-4e41-0819-215b6919c94d
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_DruidLair_Knows_DruidsVictory = True
#. TagRule:
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoVictory:21d8f855-c45c-4e41-0819-215b6919c94d
msgctxt "hdbbacd1agf256g41dcg97a7gd71b307fed72"
msgid ""
"*And if the 'Darkest One' is Shar, 'moonrise' must be her celestial sister, "
"Selûne.*"
msgstr "*'가장 어두운 존재'가 샤를 뜻하는 것이라면, '문라이즈'는 그녀의 천상의 자매, 셀루네를 뜻하는 것이 분명합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoVictory
#. Speaker = Narrator
#. NodeID = 52321148-1d20-ca8e-fbe4-20106acc493a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoVictory:52321148-1d20-ca8e-fbe4-20106acc493a
msgctxt "h4cc9969ag10adg48eagae59g0ea434520ee5"
msgid ""
"*The inscription speaks of Moonrise... a reference to vile Selûne no doubt.*"
msgstr "*새겨진 글이 문라이즈에 대해 언급합니다... 사악한 셀루네를 지칭하는 말이 분명합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoVictory
#. Speaker = Narrator
#. NodeID = 570ce1d1-ecf7-258d-6786-f5f3f827a9aa
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoVictory:570ce1d1-ecf7-258d-6786-f5f3f827a9aa
msgctxt "h1d95185fgf310g4253ga91fgd2903e0cc239"
msgid ""
"<i>\n"
"*'The towers seized, the battle done, \n"
"the moonrise broke the Darkest One.'*</i>"
msgstr ""
"<i>\n"
"*'탑이 포위되고, 전투가 벌어졌네, \n"
"문라이즈가 가장 어두운 존재를 무너뜨렸다네.'*</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoVictory
#. Speaker = Narrator
#. NodeID = 57a3d20b-45a0-e4e4-17aa-c3f0672da010
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_DruidLair_State_FailedVictoryFresco(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoVictory:57a3d20b-45a0-e4e4-17aa-c3f0672da010
msgctxt "h5319a2a4gc3e8g47fcgbf5bg7a485aaa3141"
msgid ""
"<i>\n"
"*'The towers seized, the battle done, \n"
"the moonrise broke the Darkest One.'*</i>"
msgstr ""
"<i>\n"
"*'탑이 포위되고, 전투가 벌어졌네, \n"
"문라이즈가 가장 어두운 존재를 무너뜨렸다네.'*</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoVictory
#. Speaker = Narrator
#. NodeID = 5dac588d-1eac-5992-498c-f0587f12feeb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidLair_Knows_DruidsVictory = True
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoVictory:5dac588d-1eac-5992-498c-f0587f12feeb
msgctxt "h6f869dc7gf9c8g404egace3g1571b5b79575"
msgid "*A victory of the celestial Selûne over her dark sister Shar.*"
msgstr "*암흑 자매 샤를 상대로 승리한 천상의 셀루네.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoVictory
#. Speaker = Narrator
#. NodeID = 70f2e62f-671f-4c89-0d2e-b34eb390e534
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoVictory:70f2e62f-671f-4c89-0d2e-b34eb390e534
msgctxt "h86a2fc97g1110g47adgb2a0g7412989bb050"
msgid "*The fallen bear Shar's sacred symbol on their armour and banners.*"
msgstr "*쓰러진 자들은 갑옷과 깃발에 샤의 신성한 상징을 지니고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoVictory
#. Speaker = Narrator
#. NodeID = 74c1a015-803b-3b9e-bc23-65238988a14c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule: PALADIN_SHAR
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoVictory:74c1a015-803b-3b9e-bc23-65238988a14c
msgctxt "h733daa81gbfb9g4b96gaf7dg405d329877dd"
msgid ""
"*The broken helmet bears the mark of your goddess, Shar, the Lady of Loss.*"
msgstr "*이 부서진 투구에는 상실의 여인이자 당신의 여신인 샤의 표식이 새겨져 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoVictory
#. Speaker = Narrator
#. NodeID = 74c1a015-803b-3b9e-bc23-65238988a14c
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PALADIN(1) = True
#. TagRule:
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoVictory:74c1a015-803b-3b9e-bc23-65238988a14c
msgctxt "h187ca4b2g5e45g4756gb179g0a6b8bd5d2ca"
msgid "*The broken helmet bears the mark of Shar, the Dark Lady.*"
msgstr "*부서진 투구는 어둠의 여인, 샤의 표식을 지니고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoVictory
#. Speaker = Narrator
#. NodeID = 85c995d7-4a86-70eb-ceb2-fee549ad0973
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidLair_Knows_DruidsVictory = True
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoVictory:85c995d7-4a86-70eb-ceb2-fee549ad0973
msgctxt "h3ac7e3acgdc81g44a4gb97eg47e0bd676fd0"
msgid ""
"*You glower at the fresco. 'Moonrise'. A disgusting tribute to Selûne's past "
"glories.*"
msgstr "*당신은 벽화를 노려봅니다. '문라이즈'. 셀루네의 지난 영광에 바치는 역겨운 헌사입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoVictory
#. Speaker = Narrator
#. NodeID = c69ad273-1634-5999-e509-04b5e6974a9a
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_DruidLair_State_FailedVictoryFresco(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoVictory:c69ad273-1634-5999-e509-04b5e6974a9a
msgctxt "ha36e205bg07a7g4629g8da2gc9a037fc8317"
msgid "*History or myth. Whatever is depicted here is long past.*"
msgstr "*역사인지 허구인지. 어느 쪽이든 여기서 묘사된 건 오래전의 사건입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoVictory
#. Speaker = Shadowheart
#. NodeID = dae744c9-802a-8892-38e2-ed5034221181
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - ShadowHeart_InParty_Knows_SharWorshipper = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoVictory:dae744c9-802a-8892-38e2-ed5034221181
msgctxt "h3053dd8eg8904g4c50g94dfg3658593e8b2e"
msgid "So many dead. Sent to the Nightsinger's embrace."
msgstr "많이도 갔네. 나이트싱어의 품으로 말야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoVictory
#. Speaker = Narrator
#. NodeID = dd7acdfd-cb2b-35f6-6599-7cf322c78508
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoVictory:dd7acdfd-cb2b-35f6-6599-7cf322c78508
msgctxt "hff66ebe7gc47dg4d40ga078g10653e06aea0"
msgid ""
"*You recognise the mark of the dark goddess Shar on the broken helmet. This "
"army marched in her name.*"
msgstr "*당신은 부서진 투구에서 암흑 여제 샤의 표식을 알아봅니다. 이 군대는 그녀의 이름 하에 진격했습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoVictory
#. Speaker = Narrator
#. NodeID = e34dadd8-69e9-dc8e-7607-9f990a858089
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_DruidLair_Knows_DruidsVictory = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoVictory:e34dadd8-69e9-dc8e-7607-9f990a858089
msgctxt "h6447fc82geb0dg453agb611g1426add9f03f"
msgid "*'Moonrise' must be a reference to Shar's divine sister, Selûne.*"
msgstr "*'문라이즈'는 샤의 신성한 자매인 셀루네를 지칭하는 단어일 것입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoWorking
#. Speaker = Narrator
#. NodeID = 44ed8e79-db41-a502-7c49-463451de2dd8
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_DruidLair_Knows_DruidsClearedForest = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoWorking:44ed8e79-db41-a502-7c49-463451de2dd8
msgctxt "hb196362dg55e7g41ebg8fa2gba85e0b313ee"
msgid ""
"*The mural depicts a purge, a sacred cleansing of the land on a scale you've "
"never seen before.*"
msgstr "*이 벽화는 이제껏 본 적 없는 규모로 땅을 정화하는 성스러운 숙청을 묘사하고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoWorking
#. Speaker = Narrator
#. NodeID = 78f6cd8e-4a3d-3c0b-6429-2c15883cf73c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoWorking:78f6cd8e-4a3d-3c0b-6429-2c15883cf73c
msgctxt "h8a572990g5271g421bgb890gac88b94ef1d7"
msgid ""
"*The mural depicts druid and beast fighting together to drive monsters from "
"their land.*"
msgstr "*이 벽화는 드루이드와 야수가 함께 괴물을 자신들의 땅에서 몰아내기 위해 싸우는 모습을 묘사하고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoWorking
#. Speaker = Narrator
#. NodeID = 8293b13b-20d6-2e97-7ed0-eb7a9f8a0c42
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_DruidLair_Knows_DruidsClearedForest = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoWorking:8293b13b-20d6-2e97-7ed0-eb7a9f8a0c42
msgctxt "h0cf735c2g73c0g48c5ga79cgf9f6af9e8d68"
msgid ""
"*It looks like they were victorious. And yet the monsters have returned.*"
msgstr "*그들은 승리한 것으로 보입니다. 하지만 괴물은 다시 나타났습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoWorking
#. Speaker = Narrator
#. NodeID = 901e32d5-ff1a-e01e-2f34-7b9574abc13e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidLair_Knows_DruidsClearedForest = True
#. TagRule: DRUID
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoWorking:901e32d5-ff1a-e01e-2f34-7b9574abc13e
msgctxt "hbc8a07a3g98e1g4788g9e8cgf40de17e427b"
msgid "*Your druidic brethren cleansed this land once.*"
msgstr "*당신의 드루이드 동지들은 한때 이 땅을 정화했었습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoWorking
#. Speaker = Narrator
#. NodeID = 901e32d5-ff1a-e01e-2f34-7b9574abc13e
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidLair_Knows_DruidsClearedForest = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoWorking:901e32d5-ff1a-e01e-2f34-7b9574abc13e
msgctxt "h55b8bb5cgabf8g41afgbf52ge7bdab9dba91"
msgid "*The druids of this grove cleansed the land once.*"
msgstr "*이 숲의 드루이드들은 한때 이 땅을 정화했었습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoWorking
#. Speaker = Narrator
#. NodeID = a1ed9d5c-36c0-1d2f-5302-25280f88414e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_DruidLair_State_FailedWorkingFresco(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoWorking:a1ed9d5c-36c0-1d2f-5302-25280f88414e
msgctxt "h7bb9efe3gde4ag41fag91f0g201d333ffa32"
msgid ""
"<i>\n"
"*'The forest rose with claw and tooth\n"
"to tear the darkness from its roots.'*</i>"
msgstr ""
"<i>\n"
"*'숲이 일어나니 발톱과 이빨로\n"
"뿌리에 들러붙은 어둠을 찢으려 하노라.'*</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoWorking
#. Speaker = Narrator
#. NodeID = a95c377d-a77c-3e7a-b1c1-3a381991bfec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoWorking:a95c377d-a77c-3e7a-b1c1-3a381991bfec
msgctxt "hb2d42e27gdf64g4958gbbf8g2a5540235faf"
msgid ""
"<i>\n"
"*'The forest rose with claw and tooth\n"
"to tear the darkness from its roots.'*</i>"
msgstr ""
"<i>\n"
"*'숲이 일어나니 발톱과 이빨로\n"
"뿌리에 들러붙은 어둠을 찢으려 하노라.'*</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoWorking
#. Speaker = Narrator
#. NodeID = bc85a24e-c3bc-9046-ddd4-3b9a6f0406a3
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Object:
#.     - DEN_DruidLair_State_FailedWorkingFresco(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoWorking:bc85a24e-c3bc-9046-ddd4-3b9a6f0406a3
msgctxt "h19032a37gbb9bg431bg984cg632c3370abe3"
msgid ""
"*Beasts chasing beasts, alongside a wild woman - a depiction of some local "
"folktale, perhaps.*"
msgstr "*짐승이 짐승을 쫓고 있는데, 자연인 여성과 함께입니다. 아마도 민담을 묘사한 것 같습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoWorking
#. Speaker = Narrator
#. NodeID = ec042ffa-0a0b-51db-ecee-6a7fcf41f5b2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_FrescoWorking:ec042ffa-0a0b-51db-ecee-6a7fcf41f5b2
msgctxt "ha0ba01cdgcbcag49acg9c5cgc0e01e82604e"
msgid ""
"*Druidic orders often fight dark forces, but you do not recognise the events "
"depicted here.*"
msgstr "*드루이드 단체는 종종 어둠의 세력과 맞서지만, 당신은 여기에 묘사된 사건에 대해서는 알지 못합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_PAD_UnlockWithCirclet
#. Speaker = Player
#. NodeID = 80634494-6b30-b4ac-7105-ef0dbb674086
#. HandlePath = TaggedText[6].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_PAD_UnlockWithCirclet:80634494-6b30-b4ac-7105-ef0dbb674086
msgctxt "h6e615442ge28dg4586g85f9g52c5fd5251af"
msgid "It's opened. I wonder what's back there."
msgstr "열렸네. 뭐가 있는지 궁금한걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_PAD_UnlockWithCirclet
#. Speaker = Player
#. NodeID = 80634494-6b30-b4ac-7105-ef0dbb674086
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_PAD_UnlockWithCirclet:80634494-6b30-b4ac-7105-ef0dbb674086
msgctxt "h5c213f30g6a8ag483cg8fdfg6865ff66efa8"
msgid "Now, what have you been hiding?"
msgstr "자, 뭘 숨기고 계실까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_PAD_UnlockWithCirclet
#. Speaker = Player
#. NodeID = 80634494-6b30-b4ac-7105-ef0dbb674086
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_PAD_UnlockWithCirclet:80634494-6b30-b4ac-7105-ef0dbb674086
msgctxt "h483c5584gf0cdg40a7gadbeg36e0a39441e4"
msgid "Excellent. Time to uncover some secrets."
msgstr "좋았어. 비밀을 밝혀낼 시간이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_PAD_UnlockWithCirclet
#. Speaker = Player
#. NodeID = 80634494-6b30-b4ac-7105-ef0dbb674086
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_PAD_UnlockWithCirclet:80634494-6b30-b4ac-7105-ef0dbb674086
msgctxt "h92aa048fg3ca4g4626g8bf8gf5dae9bd7c57"
msgid "Ta-da!"
msgstr "짜-잔!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_PAD_UnlockWithCirclet
#. Speaker = Player
#. NodeID = 80634494-6b30-b4ac-7105-ef0dbb674086
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_PAD_UnlockWithCirclet:80634494-6b30-b4ac-7105-ef0dbb674086
msgctxt "hdca79016g5102g4896g87f9ga7dc8bc65f76"
msgid "The slab is open. What's it been hiding?"
msgstr "판석이 열려있군. 뭘 숨겨놨지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_PAD_UnlockWithCirclet
#. Speaker = Player
#. NodeID = 80634494-6b30-b4ac-7105-ef0dbb674086
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_PAD_UnlockWithCirclet:80634494-6b30-b4ac-7105-ef0dbb674086
msgctxt "h74016ad2g0e69g4243g9098ga0d632dda5ff"
msgid "That did the trick."
msgstr "이거였군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_PAD_UnlockWithCirclet
#. Speaker = Player
#. NodeID = 80634494-6b30-b4ac-7105-ef0dbb674086
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_PAD_UnlockWithCirclet:80634494-6b30-b4ac-7105-ef0dbb674086
msgctxt "h6f9a2e15ga9a0g44e3ga980gbf44ba6ebb4d"
msgid "Nice. Time to see what's lurking back there."
msgstr "좋아. 뭐가 숨겨져 있는지 확인할 시간이군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_VB_BrokenRunes
#. Speaker = Player
#. NodeID = 6ac1242f-3bed-195b-0273-bd42c92d5d92
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_VB_BrokenRunes:6ac1242f-3bed-195b-0273-bd42c92d5d92
msgctxt "hf9951de9g05b1g4d00gaebfg998a9ac189a8"
msgid "It's broken, but not too badly."
msgstr "망가졌지만, 고칠 순 있겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_VB_EmptyHolder
#. Speaker = Player
#. NodeID = 0f9f19f2-406d-0459-b510-dccd7cc85fa7
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_DruidLair_Knows_RuneAppearance = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_VB_EmptyHolder:0f9f19f2-406d-0459-b510-dccd7cc85fa7
msgctxt "h40042c69gb1d9g4e1fg91a6g5983d18fc70a"
msgid "The stone's less worn here. Recently uncovered."
msgstr "이 돌은 덜 닳았어. 최근에 노출됐군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_VB_EmptyHolder
#. Speaker = Player
#. NodeID = 3c917643-4319-bdd7-2073-c8965bccfa7c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidLair_Knows_RuneAppearance = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_VB_EmptyHolder:3c917643-4319-bdd7-2073-c8965bccfa7c
msgctxt "h78345d45g0491g4d08g83e6ga14d06864e2b"
msgid "A tidy slot, but no rune."
msgstr "깔끔한 슬롯이지만, 룬은 없군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_VB_LockedLibrary
#. Speaker = Player
#. NodeID = d09952e2-24d0-9f2c-134b-1775a836ba23
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_VB_LockedLibrary:d09952e2-24d0-9f2c-134b-1775a836ba23
msgctxt "h7e2d3066g2f52g4225gb8a6gfbd7a5c22a5e"
msgid "I can't even see a lock to pick."
msgstr "딸 자물쇠도 보이지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_VB_ObtainedReward
#. Speaker = Player
#. NodeID = 584df8ac-e267-bb6a-c914-a56e787e6824
#. HandlePath = TaggedText[0].TagText[0]
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_VB_ObtainedReward:584df8ac-e267-bb6a-c914-a56e787e6824
msgctxt "hcf2dba7egc071g4b88gbbe0gd65dd5fbf99f"
msgid ""
"I can feel the grief in the blade. It must be the glaive from the druid's "
"notebook."
msgstr "칼날에서 비통함이 느껴져. 드루이드의 공책에서 언급했던 글레이브가 틀림없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_VB_ObtainedReward
#. Speaker = Player
#. NodeID = 584df8ac-e267-bb6a-c914-a56e787e6824
#. HandlePath = TaggedText[1].TagText[0]
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_VB_ObtainedReward:584df8ac-e267-bb6a-c914-a56e787e6824
msgctxt "h789b2f21g1eb1g4bb2gb8a4g18d9fd396361"
msgid ""
"A dark blade. If I'm right - and I usually am - it's the glaive from the "
"druid's notebook."
msgstr "검은 칼날이군. 늘 그렇듯 내가 맞는다면, 이건 드루이드의 공책에 나온 글레이브야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_VB_ObtainedReward
#. Speaker = Player
#. NodeID = 584df8ac-e267-bb6a-c914-a56e787e6824
#. HandlePath = TaggedText[2].TagText[0]
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_VB_ObtainedReward:584df8ac-e267-bb6a-c914-a56e787e6824
msgctxt "h739b7d12g3905g47c9g8708g726990bd213d"
msgid "This is the blade from the druid's notes. It feels so... sad."
msgstr "이건 드루이드의 공책에 나왔던 무기야. 뭔가... 슬퍼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_VB_ObtainedReward
#. Speaker = Player
#. NodeID = 584df8ac-e267-bb6a-c914-a56e787e6824
#. HandlePath = TaggedText[3].TagText[0]
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_VB_ObtainedReward:584df8ac-e267-bb6a-c914-a56e787e6824
msgctxt "h3297b859g1a83g4fcag9519g79c6dba3efda"
msgid ""
"The blade from the druid's notebook. I feel the shadows living within it."
msgstr "드루이드의 공책에 나왔던 칼날이군. 이 안에 살아 숨 쉬는 어둠이 느껴진다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_VB_ObtainedReward
#. Speaker = Player
#. NodeID = 584df8ac-e267-bb6a-c914-a56e787e6824
#. HandlePath = TaggedText[4].TagText[0]
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_VB_ObtainedReward:584df8ac-e267-bb6a-c914-a56e787e6824
msgctxt "h4b5e62f9gb04cg4ba6g9480g31e9f96ea260"
msgid "This is the weapon mentioned in the notebook. Supposed to be cursed..."
msgstr "공책에서 언급한 무기야. 저주받았다고 하던데..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_VB_ObtainedReward
#. Speaker = Player
#. NodeID = 584df8ac-e267-bb6a-c914-a56e787e6824
#. HandlePath = TaggedText[5].TagText[0]
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_VB_ObtainedReward:584df8ac-e267-bb6a-c914-a56e787e6824
msgctxt "h635fd005gcafcg4c89g8f79g31a31169a851"
msgid ""
"There's dark magic in this blade. The glaive from the druid's notebook, no "
"doubt."
msgstr "이 검에 어두운 마법이 담겨 있군. 드루이드의 공책에 나왔던 글레이브야, 틀림없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_VB_ObtainedReward
#. Speaker = Player
#. NodeID = 584df8ac-e267-bb6a-c914-a56e787e6824
#. HandlePath = TaggedText[6].TagText[0]
#. TagRule: REALLY_GENERIC
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_VB_ObtainedReward:584df8ac-e267-bb6a-c914-a56e787e6824
msgctxt "h9552e746g55b0g47dcg86bfg1f97cc0a3036"
msgid ""
"The glaive the druid's notebook mentioned. Its owner thought it was cursed..."
msgstr "드루이드의 공책에서 언급한 글레이브야. 이 무기의 주인은 이게 저주 받았다고 여겼지..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_VB_ObtainedReward
#. Speaker = Player
#. NodeID = d96cbf0b-d644-09e8-6e50-05ef3b0e05c4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidLair_Knows_SharDagger = False
#. TagRule: REALLY_ASTARION
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_VB_ObtainedReward:d96cbf0b-d644-09e8-6e50-05ef3b0e05c4
msgctxt "h994bc163gdd4ag4075g91c6g296f6cc9a398"
msgid "There's a wicked edge to this. I can feel the darkness in the blade."
msgstr "칼날에 사악함이 깃들어 있어. 칼에서 어둠이 느껴져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_VB_ObtainedReward
#. Speaker = Player
#. NodeID = d96cbf0b-d644-09e8-6e50-05ef3b0e05c4
#. HandlePath = TaggedText[1].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidLair_Knows_SharDagger = False
#. TagRule: REALLY_GALE
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_VB_ObtainedReward:d96cbf0b-d644-09e8-6e50-05ef3b0e05c4
msgctxt "hb3f4e67cgc68ag4780g88b0g1b0ee7258464"
msgid ""
"An exquisite blade, although its magic is a little darker than I'd like."
msgstr "굉장히 아름다운 검이군, 담긴 마법이 내 생각보다 조금 어둡긴 하지만."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_VB_ObtainedReward
#. Speaker = Player
#. NodeID = d96cbf0b-d644-09e8-6e50-05ef3b0e05c4
#. HandlePath = TaggedText[2].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidLair_Knows_SharDagger = False
#. TagRule: REALLY_KARLACH
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_VB_ObtainedReward:d96cbf0b-d644-09e8-6e50-05ef3b0e05c4
msgctxt "hd4140004gf2d2g43d5g9522gec766d9af83f"
msgid "Something about this blade. It feels... sad."
msgstr "이 검에 무언가 있어. 뭔가... 슬픔이 느껴져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_VB_ObtainedReward
#. Speaker = Player
#. NodeID = d96cbf0b-d644-09e8-6e50-05ef3b0e05c4
#. HandlePath = TaggedText[3].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidLair_Knows_SharDagger = False
#. TagRule: REALLY_LAEZEL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_VB_ObtainedReward:d96cbf0b-d644-09e8-6e50-05ef3b0e05c4
msgctxt "h4d27beabg64c1g439dgbccbg9776134cbb0c"
msgid "This blade is - shadowed. I can feel the darkness living within it."
msgstr "이 검에는... 그림자가 깃들어 있군. 이 검 안에 살아 숨 쉬는 어둠이 느껴진다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_VB_ObtainedReward
#. Speaker = Player
#. NodeID = d96cbf0b-d644-09e8-6e50-05ef3b0e05c4
#. HandlePath = TaggedText[4].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidLair_Knows_SharDagger = False
#. TagRule: REALLY_SHADOWHEART
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_VB_ObtainedReward:d96cbf0b-d644-09e8-6e50-05ef3b0e05c4
msgctxt "hb379f71cg03efg41cbg85c7g249f368c26fb"
msgid ""
"There's something off about this glaive. Touched with magic, or... "
"<i>something</i>."
msgstr "이 글레이브는 뭔가 이상해. 마법의 영향을 받았거나, 아니면... <i>다른 존재</i>일지도."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_VB_ObtainedReward
#. Speaker = Player
#. NodeID = d96cbf0b-d644-09e8-6e50-05ef3b0e05c4
#. HandlePath = TaggedText[5].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidLair_Knows_SharDagger = False
#. TagRule: REALLY_WYLL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_VB_ObtainedReward:d96cbf0b-d644-09e8-6e50-05ef3b0e05c4
msgctxt "hb361b613gd672g4525g9547g1cb47e7f0a76"
msgid "A sharp blade, with sharper magic. Best be careful with this one."
msgstr "날카로운 검에, 더 날카로운 마법이 담겨 있군. 조심히 다뤄야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_VB_ObtainedReward
#. Speaker = Player
#. NodeID = d96cbf0b-d644-09e8-6e50-05ef3b0e05c4
#. HandlePath = TaggedText[6].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidLair_Knows_SharDagger = False
#. TagRule: REALLY_GENERIC
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_VB_ObtainedReward:d96cbf0b-d644-09e8-6e50-05ef3b0e05c4
msgctxt "h06638f4cg8648g4fa7gabf4g30b690b313f5"
msgid ""
"A beautiful glaive. So why does touching it give me a knot in my stomach?"
msgstr "아름다운 글레이브야. 근데 어째서 만지면 불길한 느낌이 드는 걸까?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_VB_UnlockedStudy
#. Speaker = Player
#. NodeID = e4a8d4d2-1a0c-7625-a9ce-93de8c9af214
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidLair_VB_UnlockedStudy:e4a8d4d2-1a0c-7625-a9ce-93de8c9af214
msgctxt "h5d704e57gc86ag414aga8b3g13cd916b5651"
msgid "Well well, what have we here."
msgstr "자, 여기 뭔가가 있었네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002
#. Speaker = Player
#. NodeID = 025dc336-42bc-f652-ddeb-414ed3df12ec
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - RANGER(1) = False
#.      - DRUID(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002:025dc336-42bc-f652-ddeb-414ed3df12ec
msgctxt "hbf9100efgdb76g4982g892dge51ca253bff0"
msgid "Shh. It's all right."
msgstr "쉬- 다 괜찮아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002
#. Speaker = Narrator
#. NodeID = 0504d8da-e46f-8e4e-c205-36c2ca51c28b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002:0504d8da-e46f-8e4e-c205-36c2ca51c28b
msgctxt "h4deaba00g3093g4111g9a0bgea50464aac68"
msgid "*The wolf's fur bristles. He wants to jump, wants to <i>bite</i>.*"
msgstr "*늑대의 털이 곤두섭니다. 그것은 달려들어 <i>물고</i> 싶어합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002
#. Speaker = Player
#. NodeID = 0603e2a3-9627-897a-053e-b3f51aa38724
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002:0603e2a3-9627-897a-053e-b3f51aa38724
msgctxt "he94b0cf5g11e8g4bafg8b03g8a6bd2b6612f"
msgid "Relax. No one is here to hurt you."
msgstr "진정해. 여기서 아무도 너를 해치지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002
#. Speaker = Player
#. NodeID = 16ad9c59-17fb-8cc8-ef87-e8982ac77ca8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002:16ad9c59-17fb-8cc8-ef87-e8982ac77ca8
msgctxt "h7b6a5b40g8339g45f2g92abg2640d2af0860"
msgid "Go boy. Chase!"
msgstr "착하지. 가서 잡아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002
#. Speaker = Silver
#. NodeID = 202cc06c-b294-1339-7fe0-ddd101f7cc09
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002:202cc06c-b294-1339-7fe0-ddd101f7cc09
msgctxt "hb2831d5bg1977g4a7aga647geb9912a4611b"
msgid "*Snarl!*"
msgstr "*으르렁!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002
#. Speaker = Player
#. NodeID = 2c8fcea0-d517-ed09-9fef-3e8a9b8e3138
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidPet_002_Knows_Calmed(1) = True
#. TagRule: DRUID or RANGER
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002:2c8fcea0-d517-ed09-9fef-3e8a9b8e3138
msgctxt "hee88d673ga29fg456fgba75g258669a90acd"
msgid "<i>Sit next to him, murmuring softly while avoiding eye contact.</i>"
msgstr "<i>옆에 앉아, 눈을 마주치지 않으며 부드럽게 중얼거린다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002
#. Speaker = Narrator
#. NodeID = 3c16f9c5-c2cb-c012-82aa-4dadcf09dcc6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002:3c16f9c5-c2cb-c012-82aa-4dadcf09dcc6
msgctxt "hd88e70e6g3377g40e5gaa3egc9f2ab74722b"
msgid ""
"*He snarls a warning, flattening his ears and lowering his body, ready to "
"pounce.*"
msgstr "*늑대가 경고의 의미로 으르렁거리고, 귀를 납작하게 만들며 몸을 낮추어, 달려들 준비를 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002
#. Speaker = Narrator
#. NodeID = 43785576-64e4-8730-acd1-4a997a7073cf
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_TIEFLING(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002:43785576-64e4-8730-acd1-4a997a7073cf
msgctxt "h0bb54872g2393g44bfg8235g15e524f99e1f"
msgid ""
"*A low growl builds in his throat as his eyes track the movement of your "
"tail. It's agitating him.*"
msgstr "*늑대가 낮은 소리로 으르렁대며 당신 꼬리의 움직임을 따라 시선을 움직입니다. 그것이 그를 흥분시키고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002
#. Speaker = Player
#. NodeID = 4e769719-5de1-f2ca-5a5c-ad67ee724c2f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002:4e769719-5de1-f2ca-5a5c-ad67ee724c2f
msgctxt "h9d7240a9g7fcdg4640gb48ag2e9eb4274626"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002
#. Speaker = Narrator
#. NodeID = 5035c30e-ec07-e1d5-9d21-b6040a01f8fe
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002:5035c30e-ec07-e1d5-9d21-b6040a01f8fe
msgctxt "h32f8f833gd5e9g4352gbf8dg77ac7b61c96b"
msgid ""
"*The wolf bares his teeth; he doesn't take orders from you. He would chase "
"you down, if not for his master.*"
msgstr "*늑대가 이빨을 드러냅니다; 그것은 당신의 지시를 따르지 않습니다. 주인만 없었다면 달려들었을 겁니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002
#. Speaker = Silver
#. NodeID = 59b44108-0ea1-b861-ee0e-713dda22c732
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidPet_002_Knows_Calmed(1) = True
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002:59b44108-0ea1-b861-ee0e-713dda22c732
msgctxt "h0860d7b7g1567g430eg8d97g756d7ab89547"
msgid "*Whine.*"
msgstr "*낑낑거림*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002
#. Speaker = Player
#. NodeID = 60b0cfc6-1a2f-7e03-83b2-816e2c7e21a0
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002:60b0cfc6-1a2f-7e03-83b2-816e2c7e21a0
msgctxt "h0a0c8c8cgee43g4090g903cgf0bc97cb17e7"
msgid "<i>Try to get closer.</i>"
msgstr "<i>가까이 다가간다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002
#. Speaker = Player
#. NodeID = 63924fc3-2a60-e54e-e901-89dd99bb6da6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002:63924fc3-2a60-e54e-e901-89dd99bb6da6
msgctxt "h4504394cg3db6g46aegb720g5d8eb25c2f91"
msgid "Shh, I won't hurt you."
msgstr "쉬이, 해치지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002
#. Speaker = Narrator
#. NodeID = 770a7ec7-6d28-5344-f30a-4de72feda0f1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002:770a7ec7-6d28-5344-f30a-4de72feda0f1
msgctxt "h93e2b0b4g43c4g425bga14fg17a97d514f42"
msgid ""
"*His ears twitch as you speak, but his eyes don't shift from your tail. He "
"sees you as a threat.*"
msgstr "*당신이 말하는 소리에 따라 늑대가 귀를 쫑긋거리지만, 눈은 여전히 꼬리를 쫓고 있습니다. 늑대는 당신을 위협으로 여깁니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002
#. Speaker = Silver
#. NodeID = 815b067c-5ed9-6b43-9efd-e932817600ca
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidPet_HasMet_002(1) = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002:815b067c-5ed9-6b43-9efd-e932817600ca
msgctxt "hc9b6cd48g1d0fg41eag9f20g5b86d174848e"
msgid "Leave. You are not wanted here."
msgstr "떠나라. 넌 여기서 환영받지 못한다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002
#. Speaker = Narrator
#. NodeID = 88130b66-f5fb-20e1-fceb-d7369c3ef345
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_TIEFLING(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002:88130b66-f5fb-20e1-fceb-d7369c3ef345
msgctxt "hc2f435c3g4171g41degaedfg0d3e6f22a35f"
msgid ""
"*His eyes dart back and forth as he sniffs the air. He can't see them "
"anymore, but he can smell them. Many, many strangers.*"
msgstr ""
"*공기를 들이쉬며 늑대의 눈이 빠르게 움직입니다. 그것은 더 이상 그들을 보지 못하지만 맡을 수 있습니다. 많고 많은 이방인들을.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002
#. Speaker = Player
#. NodeID = 88aa3954-b39d-02d6-a0d7-5fc61f7d8843
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002:88aa3954-b39d-02d6-a0d7-5fc61f7d8843
msgctxt "haf18bd4bg1f76g40c5gb453g181a32b8d3d8"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002
#. Speaker = Narrator
#. NodeID = 8f708270-ddca-2dac-7787-3bffb99b80ed
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002:8f708270-ddca-2dac-7787-3bffb99b80ed
msgctxt "hb3102645g0eefg4939gb443g3960120888e8"
msgid "*His ears twitch as he lowers his head down into your lap.*"
msgstr "*늑대가 당신의 무릎 위로 머리를 숙이며 귀를 쫑긋거립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002
#. Speaker = Silver
#. NodeID = 9898ed0d-bb12-8c12-24c4-56f57e13b75f
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidPet_HasMet_NoPetPal(1) = True
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002:9898ed0d-bb12-8c12-24c4-56f57e13b75f
msgctxt "h5da7e03bg87a9g4c77g97a4gb598b66be3de"
msgid "*Growl.*"
msgstr "*으르렁.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002
#. Speaker = Player
#. NodeID = a52c8c9c-e81d-95c5-e3ab-83a87d1d81e4
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Wisdom
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - REALLY_SHADOWHEART(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002:a52c8c9c-e81d-95c5-e3ab-83a87d1d81e4
msgctxt "h5e36a617g4963g4d1eg926ag421c647b5b29"
msgid "<i>Try to get closer.</i>"
msgstr "<i>가까이 다가간다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002
#. Speaker = Player
#. NodeID = b0aa9bc6-9399-70ee-af8e-f0c5d663d237
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidPet_002_Knows_Calmed(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002:b0aa9bc6-9399-70ee-af8e-f0c5d663d237
msgctxt "hfe0a0c2bg1982g44c9ga811g233827bed812"
msgid "I just wanted to give you my smell. I'll leave you be."
msgstr "그냥 네가 내 냄새를 맡아봤으면 좋겠어. 신경 안 쓸게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002
#. Speaker = Silver
#. NodeID = b71ed399-d70d-4c02-b5a1-8dd0338f1606
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002:b71ed399-d70d-4c02-b5a1-8dd0338f1606
msgctxt "h10c275dcg5ccdg4074g8ab0g8afe403476c6"
msgid "Stupid or a liar. Neither is needed here. <i>Go!</i>"
msgstr "멍청이거나 거짓말쟁이군. 어느 쪽이든 이곳에 필요 없다. <i>가버려!</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002
#. Speaker = Player
#. NodeID = c2984450-c351-533e-310a-3c097595546a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002:c2984450-c351-533e-310a-3c097595546a
msgctxt "h2d942fd0g8179g4548g8addg1581485aa890"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002
#. Speaker = Silver
#. NodeID = c5f9347f-3ca5-3c29-3ce8-29334d443256
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidPet_HasMet_NoPetPal(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002:c5f9347f-3ca5-3c29-3ce8-29334d443256
msgctxt "h9338bde5g489eg43c6gadf7g56a4c4eb7f3e"
msgid "*Growl.*"
msgstr "*으르렁.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002
#. Speaker = Narrator
#. NodeID = c6138f7e-3f9a-4221-a820-b3ca4e92dbfa
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidPet_002_Knows_Calmed(1) = True
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002:c6138f7e-3f9a-4221-a820-b3ca4e92dbfa
msgctxt "h0a6c6e7fg8319g488eg88ccgb7be7de8980f"
msgid "*The wolf focuses on you, calmed in your presence.*"
msgstr "*늑대가 당신을 쳐다봅니다, 당신의 존재에 숨을 죽입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002
#. Speaker = Player
#. NodeID = ce96cc5d-35f6-9d00-051f-d6cc168af8fb
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002:ce96cc5d-35f6-9d00-051f-d6cc168af8fb
msgctxt "he523f012gd803g463dgadc5g64af1de22df7"
msgid "Who's been pestering you? I'll teach them a lesson."
msgstr "누가 널 괴롭혔어? 내가 그 자식에게 한 수 가르쳐 줄게."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002
#. Speaker = Silver
#. NodeID = d1c39e21-62a2-5098-97bd-2288897a930e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002:d1c39e21-62a2-5098-97bd-2288897a930e
msgctxt "hf425a5c3gf643g4064gbedeg46600c891f13"
msgid "Silence. <i>Your </i>help is not required. Not by <i>me, </i>at least."
msgstr "조용히 해라. <i>너의 </i> 도움은 필요 없어. 적어도 <i>나한테는</i>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002
#. Speaker = Player
#. NodeID = eed3d41b-817b-5d1e-bfaf-6e9dd6f4f96f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002:eed3d41b-817b-5d1e-bfaf-6e9dd6f4f96f
msgctxt "hbb2b5922gbde7g4215g88fbg471010f6b402"
msgid "Down, boy."
msgstr "엎드려, 이 녀석."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002
#. Speaker = Silver
#. NodeID = efbcefda-20e1-6297-1e9a-0e5b10f889c5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidPet_HasMet_002(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002:efbcefda-20e1-6297-1e9a-0e5b10f889c5
msgctxt "h8e1eaa63g6931g4262gb250gc74f2c0bb931"
msgid ""
"Another stranger come to vex me. What will you do? Hunt me? Grab my tail? "
"Shout until my head hurts?"
msgstr ""
"또 다른 이방인이 나를 괴롭히러 왔군. 어떻게 할 건가? 날 사냥하려고? 내 꼬리를 잡으려고? 내 머리가 아플 때까지 소리치려고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002
#. Speaker = Silver
#. NodeID = ffb8cfed-1924-06c1-9e68-55fba609b209
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_002:ffb8cfed-1924-06c1-9e68-55fba609b209
msgctxt "h0eb55ef1g9b88g4f16ga15ag0656da1193df"
msgid "No - wait. You smell fresh. Safe. You can stay. If you must."
msgstr "아니, 잠깐. 너는 신선한 냄새가 나. 무해하군. 머물러도 좋다. 머물러야만 한다면."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003
#. Speaker = Topaz
#. NodeID = 0acb3e45-1620-466f-68ce-5e3c50df03bb
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003:0acb3e45-1620-466f-68ce-5e3c50df03bb
msgctxt "h946139e1gd701g4f17g9cbbg2446d7347ca1"
msgid "*Chirp!*"
msgstr "*짹짹!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003
#. Speaker = Topaz
#. NodeID = 2331fec8-f743-3c18-54b9-cb17581e3ec2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidPet_HasMet_003(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003:2331fec8-f743-3c18-54b9-cb17581e3ec2
msgctxt "h86f52b63g21d7g4d0cg901agd7e9723260f4"
msgid "Yes... yes, this is perfect."
msgstr "그래... 이거야. 아주 완벽해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003
#. Speaker = Player
#. NodeID = 368aa6ce-91d7-bc03-4401-3a420c1b9b5a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003:368aa6ce-91d7-bc03-4401-3a420c1b9b5a
msgctxt "h38135a15ge9b4g41edgb91dg296fd4657db2"
msgid "Stop fussing. It looks fine."
msgstr "소란 떨지 마. 괜찮아 보이는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003
#. Speaker = Player
#. NodeID = 3f19c94d-fc91-e3d4-a3a9-8f85421098f5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - BARD(1) = True
#.      - PETPAL(1) = True
#. TagRule: BARD
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003:3f19c94d-fc91-e3d4-a3a9-8f85421098f5
msgctxt "hf64d5c5cg5b86g4bdcg801bg96a2ff01b588"
msgid "Trinkets will rust, friend. A song shines on forever. Give it a try."
msgstr "장신구는 녹슬 거야, 친구. 노래는 영원히 빛나지. 한 번 해보라고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003
#. Speaker = Player
#. NodeID = 40a11712-5381-5787-8e8a-4f4df6f8c352
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - BERSERKER(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003:40a11712-5381-5787-8e8a-4f4df6f8c352
msgctxt "h224ad6bdg275bg4f68ga8d2g8d7f67863d4c"
msgid "<b><i>ROAR.</i></b>"
msgstr "<b><i>크아아.</i></b>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003
#. Speaker = Topaz
#. NodeID = 5251fb07-5b05-512e-9ccf-898a635190d1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidPet_003_State_NoCoinNearby = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003:5251fb07-5b05-512e-9ccf-898a635190d1
msgctxt "hc13794b5g49e2g41b7gb6dag6ce5873be46e"
msgid "No, no - where is it? I put the coin right here."
msgstr "이런, 안 돼. 어디 있지? 분명 동전을 여기 뒀는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003
#. Speaker = Topaz
#. NodeID = 54219741-37e0-440c-18e8-266312b1cd10
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003:54219741-37e0-440c-18e8-266312b1cd10
msgctxt "hbd521d0fg729dg4aecga962g3b51c6c4212e"
msgid "Shh, I'm concentrating. Does this look good? Is the coin in the middle?"
msgstr "쉿, 지금 집중하고 있어서. 어때 괜찮아 보여? 동전이 한 가운데 있는 게?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003
#. Speaker = Topaz
#. NodeID = 656623a1-e07f-2865-2320-7e985591afe5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidPet_003_State_PersuasionFailed(1) = True
#.   Global:
#.     - DEN_DruidPet_003_Event_TakeFlight = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003:656623a1-e07f-2865-2320-7e985591afe5
msgctxt "h45337949g916fg4708g8bbbg15d7f727e3b5"
msgid "Help! Help!"
msgstr "으아악! 도와줘!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003
#. Speaker = Player
#. NodeID = 66abb536-fd50-187d-9c40-721ee7cab336
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. TagRule: REALLY_DUERGARDWARF or REALLY_DWARF
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003:66abb536-fd50-187d-9c40-721ee7cab336
msgctxt "h81c55f53g6621g4992gbe3eg33b325050e7f"
msgid "Leave it out - the metal's bad quality. It'll turn green very quickly."
msgstr "질이 별로 좋지 않은데 치워버려. 금방 녹슬 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003
#. Speaker = Narrator
#. NodeID = 714e4411-18ae-84c8-afd2-aed83613a98b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - DEN_DruidPet_003_State_NearNest(0) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003:714e4411-18ae-84c8-afd2-aed83613a98b
msgctxt "h3a0c331eg1511g47fcga719g98239b00bbd7"
msgid ""
"*The bird hops around, scanning sticks and flowers, looking for a nice "
"addition to his nest.*"
msgstr "*새는 이리저리 뛰어다니며 둥지에 올릴 가지와 꽃을 찾고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003
#. Speaker = Topaz
#. NodeID = 739dea15-509f-62d5-27ea-d1e06843cb25
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidPet_003_State_PersuasionFailed(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003:739dea15-509f-62d5-27ea-d1e06843cb25
msgctxt "h63830e19ge5abg4962g8493g19bc3adb0ecc"
msgid "No you <i>don't</i>."
msgstr "<i>그만</i> 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003
#. Speaker = Player
#. NodeID = 741da10b-b7a5-4e3b-79cf-c90cefc786dc
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003:741da10b-b7a5-4e3b-79cf-c90cefc786dc
msgctxt "h88900540gbf10g4e3eg8f48ga5a649feadbd"
msgid "<i>Kick at the bird, trying to scare it away.</i>"
msgstr "<i>새를 쫓아내기 위해 발로 찬다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003
#. Speaker = Topaz
#. NodeID = 7813fc9c-41cc-498c-a8c1-d20d7e599ef5
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidPet_HasMet_003(1) = True
#.   Global:
#.     - DEN_DruidPet_003_Event_ClearOwnership = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003:7813fc9c-41cc-498c-a8c1-d20d7e599ef5
msgctxt "h756d31b8g0b36g4496g8c8ag954dadca467b"
msgid "Yeah... yeah, you're right. This is better."
msgstr "그래... 네 말이 맞네. 이게 훨씬 나아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003
#. Speaker = Player
#. NodeID = 7d3540bc-3461-6a38-98c8-c387d171b3c6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003:7d3540bc-3461-6a38-98c8-c387d171b3c6
msgctxt "hadfecd16ge222g473eg95d7g88b6518d252e"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003
#. Speaker = Topaz
#. NodeID = 827f89db-14ce-52de-3aba-16340c8c1396
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003:827f89db-14ce-52de-3aba-16340c8c1396
msgctxt "hb5b796e4g9d1eg4d65g99b6gef82cf504fb1"
msgid "Hmm. Hmmmm..."
msgstr "흠. 흐으음..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003
#. Speaker = Player
#. NodeID = 8dc2d207-1bc2-7fc5-4732-ada295f67260
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 5
#. CheckFlags:
#.   Tag:
#.      - BARBARIAN(1) = True
#.      - BERSERKER(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003:8dc2d207-1bc2-7fc5-4732-ada295f67260
msgctxt "h1cb33099g64a3g4a3fgbe59g84b18ba72fda"
msgid "Away from the coin, or I'll make a headpiece from your feathers."
msgstr "동전에서 물러서지 않으면 네 깃털로 투구를 만들어 버리겠다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003
#. Speaker = Topaz
#. NodeID = a01d2cdb-d02b-52a9-7136-a0d5d3537e67
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidPet_003_State_PersuasionFailed(1) = True
#.   Global:
#.     - DEN_DruidPet_003_Event_TakeFlight = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003:a01d2cdb-d02b-52a9-7136-a0d5d3537e67
msgctxt "hecb56527g01b9g4a7egb4d3g7642259a6ebe"
msgid "Stop it! Help - help!"
msgstr "그만둬! 도와줘요!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003
#. Speaker = Topaz
#. NodeID = a89b53f7-c804-263a-f317-89e9a2f8a870
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003:a89b53f7-c804-263a-f317-89e9a2f8a870
msgctxt "h0e74de9egc3ceg4f77gb5a0gfdfcfca50eae"
msgid "Ah, umm..."
msgstr "아, 으음..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003
#. Speaker = Narrator
#. NodeID = b64664c7-0ed5-0b8a-4c73-fecbdee6f7ac
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_DruidPet_003_State_PersuadedCharlatan = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003:b64664c7-0ed5-0b8a-4c73-fecbdee6f7ac
msgctxt "h4b66c20fgafe0g454bg8dcag7b9852dde931"
msgid ""
"*The bird is singing as loudly as his lungs will allow, practising "
"fervently.*"
msgstr "*새는 폐가 감당할 수 있는 한도 내에서 최대한 시끄럽게 노래하며 열렬히 연습 중입니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003
#. Speaker = Topaz
#. NodeID = c3e9b6bb-36c4-b8d9-feee-b5569f748e99
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidPet_003_State_PersuasionFailed(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003:c3e9b6bb-36c4-b8d9-feee-b5569f748e99
msgctxt "ha72095f8g9c90g44fcgb04cgde1f6f17aaa9"
msgid "I'm not afraid of you!"
msgstr "하나도 안 무섭거든!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003
#. Speaker = Topaz
#. NodeID = f126e8b3-2ff8-5eae-3800-f089f6c1a56f
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidPet_HasMet_003(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003:f126e8b3-2ff8-5eae-3800-f089f6c1a56f
msgctxt "ha303aef8g0112g49c4g9e1fg796474aedbc5"
msgid "No... it's leaning too much to the left. Yeah, that's it."
msgstr "아니야... 왼쪽으로 치우쳤잖아. 그래, 이거지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003
#. Speaker = Player
#. NodeID = f31c7ac8-76bd-9863-bd40-843d5a0b9903
#. HandlePath = TaggedText[0].TagText[0]
#. RollType: SkillCheck
#. RollAbility: Charisma
#. DifficultyClass: 10
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003:f31c7ac8-76bd-9863-bd40-843d5a0b9903
msgctxt "ha66b782dgb16ag4bbcgbaa6ga03bdc76c3fd"
msgid "I'd leave it out - it's too dull."
msgstr "나라면 그걸 치울 거야. 좀 별로거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003
#. Speaker = Topaz
#. NodeID = f5840cb8-4e7f-6bc7-4e1e-52e93f41c34a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidPet_003_State_PersuasionFailed(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003:f5840cb8-4e7f-6bc7-4e1e-52e93f41c34a
msgctxt "hedb8d53ag0af2g4481g862fg0e3f24f02e57"
msgid "Don't you <i>dare</i>."
msgstr "<i>꿈도</i> 꾸지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003
#. Speaker = Player
#. NodeID = f83bc309-44ef-2039-e9db-23d97ea02c76
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003:f83bc309-44ef-2039-e9db-23d97ea02c76
msgctxt "h2df5398dg4ddcg4f78ga872g3299969e3b3f"
msgid "It's slightly off - push it a bit to the right."
msgstr "살짝 삐져나왔어. 오른쪽으로 조금 옮겨 봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003
#. Speaker = Topaz
#. NodeID = f8475ca3-4440-d241-3fea-36d4f4ccfcd9
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidPet_HasMet_003(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003:f8475ca3-4440-d241-3fea-36d4f4ccfcd9
msgctxt "hecb0c72dg9380g4b38gbe9bg1a6158e94296"
msgid "Yes... yes, you're right. That's it."
msgstr "아... 그래, 네 말이 맞아. 이제 됐다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003
#. Speaker = Topaz
#. NodeID = fe0a1663-2777-8945-a7ca-09c7638cfd34
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidPet_003_State_PersuasionFailed(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003:fe0a1663-2777-8945-a7ca-09c7638cfd34
msgctxt "hd7a87d95g5313g42b2g9023g64f269dea135"
msgid "It's not. And you better keep those fingers far away."
msgstr "전혀. 그리고 그 손 저리 치워."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003
#. Speaker = Narrator
#. NodeID = ff717b9c-af62-bdb2-db7c-1601a23886d1
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Global:
#.     - DEN_DruidPet_003_State_PersuadedCharlatan = True
#.     - DEN_DruidPet_003_Event_ClearOwnership = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_003:ff717b9c-af62-bdb2-db7c-1601a23886d1
msgctxt "h3757b39age2c0g469egb3dbgabd241c5015c"
msgid ""
"*He lets out a tentative chirp. Gaining confidence, he starts a song, "
"abandoning his nest-building efforts.*"
msgstr "*새가 시험삼아 지저귑니다. 자신감을 얻은 새는 둥지 건설 작업을 포기한 채 노래를 부르기 시작합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_004
#. Speaker = Tusk
#. NodeID = 112fdfea-1a33-c111-4d72-7c1a7f2188ba
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidPet_HasMet_004(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidPet_HasMet_004(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_004:112fdfea-1a33-c111-4d72-7c1a7f2188ba
msgctxt "h56f67b5cgd3a1g4369g9c28g4e3c93f8816c"
msgid "Hmph. I thought you were Halsin."
msgstr "에이. 네가 할신인 줄 알았는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_004
#. Speaker = Tusk
#. NodeID = 1806aa2d-ff41-de61-31da-3ed8a4d82c77
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_004:1806aa2d-ff41-de61-31da-3ed8a4d82c77
msgctxt "hae876a1egab7dg4f16gbaf0gd2ead6de9800"
msgid "Where's Halsin? He promised me a mate!"
msgstr "할신은 어딨어? 짝을 데려오겠다고 약속했단 말야!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_004
#. Speaker = Tusk
#. NodeID = 952b12de-2a45-f635-b250-2afbcf0a6421
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_004:952b12de-2a45-f635-b250-2afbcf0a6421
msgctxt "h436ef39cg7434g41ebg94degc32a0919140d"
msgid ""
"At least the sun is nice. You should try it - lay down and bask in its "
"warmth."
msgstr "그래도 햇살은 좋구만. 너도 한 번 누워서 따스한 햇볕을 쬐어봐."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_004
#. Speaker = Narrator
#. NodeID = dd0661ee-e6ca-7abd-13bc-860008d10831
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_004:dd0661ee-e6ca-7abd-13bc-860008d10831
msgctxt "h62e7db34geda1g4184gbd25gd4aa402c15b0"
msgid ""
"*The boar prances around, haunches clenching and unclenching impatiently.*"
msgstr "*멧돼지가 이리저리 돌아다니며, 초조하게 뒷다리를 구부렸다 폈다가 하고 있습니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_004
#. Speaker = Tusk
#. NodeID = ed1aad68-073e-7e46-9d69-58280ba8c76b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - PETPAL(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_004:ed1aad68-073e-7e46-9d69-58280ba8c76b
msgctxt "h4a6b90fbg0d3fg4339gbb50g51b94b908505"
msgid "*Grunt.*"
msgstr "*끙.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_AD_002
#. Speaker = Silver
#. NodeID = e05d8b5e-09bd-7f2c-6d55-8ba96827aba9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_AD_002:e05d8b5e-09bd-7f2c-6d55-8ba96827aba9
msgctxt "hbb0929adg7763g467aga3fcg250db45f4cb4"
msgid "*Growl.*"
msgstr "*으르렁.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_AD_004
#. Speaker = Tusk
#. NodeID = 80520531-bd05-80a9-6c8f-a63eb932092d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_AD_004:80520531-bd05-80a9-6c8f-a63eb932092d
msgctxt "hbda53f44gf932g4a6fgbc36gfaff89d9e760"
msgid "*Grunt.*"
msgstr "*끙.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_AD_BirdStealReaction
#. Speaker = Topaz
#. NodeID = 739f70da-975f-b1cc-6b61-bba5b80268b4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_AD_BirdStealReaction:739f70da-975f-b1cc-6b61-bba5b80268b4
msgctxt "h0d6a6ba3g41c6g498dg91cfgb8feb716ffb8"
msgid "*Screech!*"
msgstr "*끼이익!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_AD_Birdsong
#. Speaker = Topaz
#. NodeID = f86c8ca8-48c0-a72d-e015-b667f13d594a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidPet_AD_Birdsong:f86c8ca8-48c0-a72d-e015-b667f13d594a
msgctxt "h0a660741gb3d6g43f2ga21ag7f75d3c7da6c"
msgid "*Chirp! Chirp!*"
msgstr "*짹짹! 짹쨱!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_002
#. Speaker = Marcoryl
#. NodeID = 049d8589-f5be-5abc-1fab-f008bf70ff27
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidServant_HasMet_Pacified002(1) = False
#.   Global:
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidServant_HasMet_Pacified002(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_002:049d8589-f5be-5abc-1fab-f008bf70ff27
msgctxt "h85d9e6c6g1a3fg41e2ga3dbgccfdd2e5163a"
msgid "You may have won over Kagha, but I'm not so easily swayed."
msgstr "네가 카그하 님은 설득했을지 몰라도, 난 그렇게 쉽게 흔들리지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_002
#. Speaker = Marcoryl
#. NodeID = 49024eb2-1b5a-91af-7222-af3a825d01e9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - TIEFLING(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_002:49024eb2-1b5a-91af-7222-af3a825d01e9
msgctxt "hb1ec5bc6g08c5g4827gb7fbg6e772718947c"
msgid "Leave me. I detest the smell of sulphur."
msgstr "저리 비켜. 난 유황 냄새가 싫어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_002
#. Speaker = Marcoryl
#. NodeID = 57ca535e-3b76-0054-22d9-e7258dc369b4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidServant_HasMet_002(1) = False
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidServant_HasMet_002(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_002:57ca535e-3b76-0054-22d9-e7258dc369b4
msgctxt "ha50a625agfe1eg41f4gb9b3g3172910451ca"
msgid ""
"Goblin attacks and now a dead child. We never should have opened our gates."
msgstr "고블린이 공격해오더니 이젠 아이가 죽었네. 문을 열지 말았어야 했어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_002
#. Speaker = Marcoryl
#. NodeID = 644996b5-5831-31f5-3634-d37b44b2e2ac
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidServant_HasMet_002(1) = False
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#.   Tag:
#.      - TIEFLING(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidServant_HasMet_002(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_002:644996b5-5831-31f5-3634-d37b44b2e2ac
msgctxt "h617e400dg7d3fg4bdeg9431g8264b952fcc0"
msgid ""
"That poor child. This should never have happened. You people should have "
"left when Kagha asked."
msgstr "불쌍한 아이구나. 이 일은 애초에 일어나지 말았어야 해. 너희 사람들은 카그하 님이 부탁하셨을 때 떠났어야 했다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_002
#. Speaker = Marcoryl
#. NodeID = 6490c334-ad2e-58a2-c99d-7de3c10bb6a4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_002:6490c334-ad2e-58a2-c99d-7de3c10bb6a4
msgctxt "h2162972fg429ag4017ga5eeg47d7d76d2bed"
msgid ""
"By Silvanus - another outsider. Should you have an ounce of sense, you will "
"leave. Immediately."
msgstr "실바누스시여, 또 다른 외부인이라니. 조금이라도 분별력이 있다면, 당장 떠나도록 해."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_002
#. Speaker = Marcoryl
#. NodeID = 69de903e-0d4f-881a-fcca-2816d4153c81
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidServant_HasMet_Left002(1) = False
#.   Global:
#.      - DEN_Refugees_State_LeadersAreDead = True
#.      - GLO_Halsin_State_Returned = True
#.      - GLO_Halsin_State_PermaDefeated = False
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidServant_HasMet_Left002(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_002:69de903e-0d4f-881a-fcca-2816d4153c81
msgctxt "hdcac7cd0g0da2g4909gaeb6g49cb920eff96"
msgid ""
"You may be in Halsin's good graces, but mine are another matter. This grove "
"is a darker place for your presence."
msgstr "너는 할신 님의 호의 아래 있을지도, 하지만 나와는 별개의 이야기지. 이 숲은 네 존재만으로도 더 어두운 곳이 되어가고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_002
#. Speaker = Marcoryl
#. NodeID = 8bb05ade-ec7c-d068-6100-a6a99f949460
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_002:8bb05ade-ec7c-d068-6100-a6a99f949460
msgctxt "he981ec73g11b2g409cgba9eg8bbd3af81373"
msgid ""
"No doubt the tieflings will blame us for the child's death. This is a "
"disaster."
msgstr "티플링들이 아이의 죽음에 대해 우리 탓을 할 게 분명해. 이건 대참사야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_002
#. Speaker = Marcoryl
#. NodeID = 928cf6fb-a512-b76a-2906-391756f56d4e
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidServant_HasMet_002(1) = False
#.   Global:
#.      - DEN_ShadowDruid_State_KidFreed = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidServant_HasMet_002(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_002:928cf6fb-a512-b76a-2906-391756f56d4e
msgctxt "hbd9a6e6fgdff6g429bg8402g1499ce3fe39a"
msgid ""
"What will the tieflings want next? Letting the hell child go was a mistake."
msgstr "이 다음엔 티플링들이 뭘 원할까? 그 지옥의 아이를 그냥 보낸 건 실수였어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_002
#. Speaker = Marcoryl
#. NodeID = 9c9f9dd9-8085-6076-6a74-1a6ad3fec322
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Refugees_State_LeadersAreDead = True
#.      - GLO_Halsin_State_PermaDefeated = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_002:9c9f9dd9-8085-6076-6a74-1a6ad3fec322
msgctxt "h4fa7b797g9d6ag4c5fg8a2dg38d9b84c299c"
msgid ""
"It's outsiders like you who brought trouble in the first place. Away - I "
"detest the sight of you."
msgstr "애초에 너희 같은 외부인들이 문제를 몰고 온 거야. 꼴도 보기 싫으니 꺼져."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_002
#. Speaker = Marcoryl
#. NodeID = b90a1fd5-86ae-33d9-1f09-b8ce8d961a02
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_002:b90a1fd5-86ae-33d9-1f09-b8ce8d961a02
msgctxt "hb2153e0bg5226g49e0g89a7g57a2142d5ace"
msgid "Remember - this is our grove. You are never far from watching eyes."
msgstr "기억하라고, 여기는 우리의 숲이야. 지켜보는 눈이 곳곳에 있다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_002
#. Speaker = Marcoryl
#. NodeID = c09c0e49-6ca3-7a16-51b2-13894830e609
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidServant_HasMet_Left002(1) = False
#.   Global:
#.      - DEN_Refugees_State_LeadersAreDead = True
#.      - GLO_Halsin_State_PermaDefeated = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidServant_HasMet_Left002(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_002:c09c0e49-6ca3-7a16-51b2-13894830e609
msgctxt "h9c089ee0g5498g432dgba3egc06f3e17e769"
msgid ""
"Do not expect thanks for killing goblins. For all I know, you had something "
"to do with Halsin's disappearance."
msgstr "고블린을 죽여준 것에 대해 감사를 기대하지는 마. 내가 듣기로는, 할신 님이 사라진 것에는 네 책임도 있다던데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_002
#. Speaker = Marcoryl
#. NodeID = f2c687bf-e65d-bad4-978a-6c8f53b15718
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Refugees_State_LeadersAreDead = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_002:f2c687bf-e65d-bad4-978a-6c8f53b15718
msgctxt "hb95ed4bbg79c9g4c61ga137ga38f5668748f"
msgid "Be gone - surely you have others to bother."
msgstr "썩 사라져. 가서 다른 사람 괴롭혀."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_002
#. Speaker = Marcoryl
#. NodeID = fe3c1bad-5a94-19fa-0eae-b7cf9c117cda
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidServant_HasMet_002(1) = False
#.   Tag:
#.      - TIEFLING(1) = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidServant_HasMet_002(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_002:fe3c1bad-5a94-19fa-0eae-b7cf9c117cda
msgctxt "he8be60dfg030eg440dg80f4g6f4d68d66972"
msgid ""
"What will you people want next? Letting the hell child go was a mistake."
msgstr "이 다음엔 너희 족속들이 뭘 원할까? 그 지옥의 아이를 그냥 보낸 건 실수였어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_003
#. Speaker = Loic
#. NodeID = 01333aa5-fa66-cf0c-7865-1330883c9835
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KaghaKilled = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidServant_HasMet_SaghaGood_003(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_003:01333aa5-fa66-cf0c-7865-1330883c9835
msgctxt "h2c21a807g516bg46dbg891fg157ba5853a57"
msgid ""
"Shadow Druids... To think we were rotting from within. I'm sorry. I need a "
"moment."
msgstr "그림자 드루이드라니... 우리가 안에서부터 썩어 문드러졌을 줄이야. 미안하군. 생각 좀 해야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_003
#. Speaker = Loic
#. NodeID = 117cd00c-0363-75a3-01f0-e07e3f8569a5
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidServant_HasMet_003(1) = True
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_003:117cd00c-0363-75a3-01f0-e07e3f8569a5
msgctxt "h64f6a860g5ddbg4237g9cbbg634529486390"
msgid "Begone. You'll only help this grove by leaving it to us."
msgstr "꺼져. 네가 이 숲을 돕는 유일한 길은 우리가 알아서 하게 두는 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_003
#. Speaker = Loic
#. NodeID = 6b67de84-16ed-7120-e30e-ff33c49d7e43
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidServant_HasMet_SaghaGood_003(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_003:6b67de84-16ed-7120-e30e-ff33c49d7e43
msgctxt "h37f3f52bg63bag4bd2g92ecg1f063a0df09b"
msgid ""
"Shadow Druids... To think we were rotting from within. I'm sorry. I need a "
"moment."
msgstr "그림자 드루이드라니... 우리가 안에서부터 썩어 문드러졌을 줄이야. 미안하군. 생각 좀 해야겠어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_003
#. Speaker = Loic
#. NodeID = 7ece07d9-1508-72ba-e968-72fbaa890149
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidServant_HasMet_003(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidServant_HasMet_003(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_003:7ece07d9-1508-72ba-e968-72fbaa890149
msgctxt "heb9f3ad7gc933g4d77gbdb6gd581aadd28c3"
msgid ""
"Please leave. Our hospitality has limits - and they were crossed long ago."
msgstr "부디 떠나시죠. 우리의 친절도 한계에 다다른지 오래입니다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_003
#. Speaker = Loic
#. NodeID = 9be85e88-206d-7563-3c87-f988b7edf705
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidServant_HasMet_003(1) = False
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidServant_HasMet_003(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_003:9be85e88-206d-7563-3c87-f988b7edf705
msgctxt "h619e3026g249eg4e4cga408g86354a5d676c"
msgid ""
"We never meant to hurt a child... you should leave. This grove has been "
"disrupted enough."
msgstr "아이를 다치게 할 생각은 없었는데... 너는 떠나는 게 좋겠어. 이 숲은 이미 충분히 혼란스럽다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_003
#. Speaker = Loic
#. NodeID = e309b18a-28d5-531a-400f-233a38051bf0
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidServant_HasMet_SaghaGood_003(1) = True
#.   Global:
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_003:e309b18a-28d5-531a-400f-233a38051bf0
msgctxt "hc105e60ag4bd6g44dbg96bfgfe3bcf1dec33"
msgid ""
"It all makes sense now. What Kagha did... the Shadow Druids poisoned her "
"mind."
msgstr "이제야 알겠네. 카그하가 한 짓은... 그림자 드루이드들이 그녀의 마음에 독을 탄 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_003
#. Speaker = Loic
#. NodeID = e6272b68-18e5-890f-cc7e-098767233171
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidServant_HasMet_SaghaGood_003(1) = True
#.   Global:
#.      - DEN_ShadowDruid_State_KaghaKilled = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_003:e6272b68-18e5-890f-cc7e-098767233171
msgctxt "h91d0e9d7g1d5cg4ad5g8a31gd1ebd201daa7"
msgid ""
"It all makes sense now. What Kagha did... the Shadow Druids poisoned her "
"mind."
msgstr "이제야 알겠네. 카그하가 한 짓은... 그림자 드루이드들이 그녀의 마음에 독을 탄 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_003
#. Speaker = Loic
#. NodeID = ffdff10d-7e83-c778-a41a-e98a79636d48
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidServant_HasMet_003(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_003:ffdff10d-7e83-c778-a41a-e98a79636d48
msgctxt "hb83537bdg68ffg41ccgb699gc0c51884aa81"
msgid ""
"I asked you to leave. Staying will only disrupt the balance of this grove."
msgstr "떠나달라고 했잖아. 남아있으면 이 숲의 균형에 방해만 될 뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005
#. Speaker = Arron
#. NodeID = 020c2595-72f5-02c5-8830-47add8780c95
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005:020c2595-72f5-02c5-8830-47add8780c95
msgctxt "h3bda8f59g3277g4509gba4ag4ea22107fde4"
msgid ""
"Ignorance is agony, my friend. I will include you in my prayers. I'd better "
"get started - for your sake."
msgstr "무지는 고통이라오, 친구. 당신도 내 기도 대상에 넣어야겠군. 꼴을 보니 얼른 기도를 시작해야겠구려."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005
#. Speaker = Arron
#. NodeID = 0993ed86-37ef-451f-113b-04a0c6e97c25
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Quest:
#.     - GLO_Tadpole_SUB_Druid.LearnedLostHalsin(1) = True
#.     - GLO_Tadpole_SUB_Apprentice.LearnedAboutNettie(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005:0993ed86-37ef-451f-113b-04a0c6e97c25
msgctxt "h39eaaabfgc4fag4817g9a19gf80b75792a18"
msgid ""
"Nettie's your best bet, with Master Halsin gone. She should be with the "
"others in the inner chambers."
msgstr "마스터 할신은 이제 없으니, 네티를 찾는 게 최선이겠군. 안쪽 터 실내에 다른 이들과 함께 있을 거요."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005
#. Speaker = Arron
#. NodeID = 1b9f55ab-0d86-f5d9-3068-31fba0069464
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005:1b9f55ab-0d86-f5d9-3068-31fba0069464
msgctxt "h91aa7d6dg53ddg463bga642g31401b126abc"
msgid "You don't know Kagha. She won't listen. I'm truly sorry."
msgstr "카그하를 잘 모르는군. 그럴 이가 아니오. 정말 유감이외다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005
#. Speaker = Player
#. NodeID = 1e2fb80c-9b0f-10a0-2eb0-2a1e6aca19b2
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidServant005_Knows_TalkedAboutLockdown(1) = False
#.   Global:
#.      - DEN_GroveConflict_State_DruidsPacified = False
#.      - DEN_GroveConflict_Knows_HeardAboutRitual = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005:1e2fb80c-9b0f-10a0-2eb0-2a1e6aca19b2
msgctxt "h9bb4eb05g0b4dg4334g849ag8835cc6fa7e9"
msgid "What do you mean?"
msgstr "그게 무슨 말이지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005
#. Speaker = Arron
#. NodeID = 243126c7-6542-70f0-7f58-eb80215d9b0d
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidServant005_Knows_TalkedAboutLockdown(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005:243126c7-6542-70f0-7f58-eb80215d9b0d
msgctxt "h2f549610g81bdg42cagb3e8g3f4a04193e65"
msgid ""
"I know it's drastic, but more monsters seem to terrorise this region every "
"day."
msgstr "극단적이란 건 아오. 하지만 날이 갈수록 괴물들이 기승을 부려대니 이럴 수밖에."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005
#. Speaker = Player
#. NodeID = 259dc70d-a8c3-69ba-c325-3878104d8fc3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_Apprentice_Knows_HeardAboutNettie = False
#.      - GLO_Halsin_State_Returned = False
#.      - DEN_Apprentice_UserShortcut = False
#.      - DEN_Apprentice_State_Dead = False
#. SetFlags:
#.   Global:
#.     - DEN_Apprentice_Knows_HeardAboutNettie = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005:259dc70d-a8c3-69ba-c325-3878104d8fc3
msgctxt "h05d7c190g6eccg462agbfd0g061a5a127c41"
msgid "I'm looking for a healer."
msgstr "치유사를 찾고 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005
#. Speaker = Arron
#. NodeID = 26063887-42d6-af14-5ec3-41a92676cd15
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005:26063887-42d6-af14-5ec3-41a92676cd15
msgctxt "h12abe64cg0802g4300gb16fgeb8fc6aa0cce"
msgid "There just aren't enough supplies to support everyone."
msgstr "모든 사람을 부양할 만큼의 물자가 없단 말이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005
#. Speaker = Arron
#. NodeID = 2678c68b-1ff9-c51d-76e5-226c41b2d7b8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005:2678c68b-1ff9-c51d-76e5-226c41b2d7b8
msgctxt "h4781a3d6g0a05g4354g94f5g8af05b730e25"
msgid ""
"We druids will be safe. As for those that took refuge here... well, may "
"Silvanus guard them as they continue their travels."
msgstr "우리 드루이드는 무사할 거요. 여기로 피난 온 저 난민들은... 뭐, 실바누스께서 그들의 여정을 쭉 가호해 주시기만 바라야지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005
#. Speaker = Arron
#. NodeID = 4021c2e0-a990-9b61-d7a0-25ba7a1ed80d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005:4021c2e0-a990-9b61-d7a0-25ba7a1ed80d
msgctxt "h0ade0e44gb22dg4db2g8041g410bbefc0637"
msgid ""
"I pray to Silvanus each night - the Wild Father will protect those refugees. "
"I hope."
msgstr "매일 밤 실바누스께 기도를 올린다오. 야생의 아버지께서 저 난민들을 가호해달라고요. 부디 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005
#. Speaker = Arron
#. NodeID = 455fc399-384a-1aa2-3f59-8edca31af621
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005:455fc399-384a-1aa2-3f59-8edca31af621
msgctxt "hfac6105bgf872g4410gb8bag16d50ebb014c"
msgid "Always happy to help those who follow the First Circle."
msgstr "시초의 의회를 따르는 이를 돕는 일은 언제든 환영이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005
#. Speaker = Arron
#. NodeID = 4c3768a7-844d-c0ea-3fd5-5d3f59b5fbd2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005:4c3768a7-844d-c0ea-3fd5-5d3f59b5fbd2
msgctxt "hd033edd1ga3dag484egb109g5f828d429d33"
msgid "Of course. But please remember: you're not the only one in need."
msgstr "그러시오. 다만 이건 염두에 두시구려. 당신만 물자가 필요한 게 아니라오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005
#. Speaker = Player
#. NodeID = 518010f0-c2b0-a8ce-5e8d-5394550c61d9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_TIEFLING(1) = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005:518010f0-c2b0-a8ce-5e8d-5394550c61d9
msgctxt "hd2c2abecgef02g48d5g8efdg643810730cf7"
msgid ""
"Seems like most are tieflings. They'll be fine. They have devilish powers."
msgstr "저들 대부분은 티플링 같으니, 별 탈은 안 나겠네. 데빌의 힘을 지닌 자들이니까."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005
#. Speaker = Player
#. NodeID = 55923983-80c5-be1e-826a-7ab6ebf9ff95
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005:55923983-80c5-be1e-826a-7ab6ebf9ff95
msgctxt "hd722888fgd93cg4677gb927g2d9fce74c91f"
msgid "Your prayers won't save them. But your voice might sway Kagha."
msgstr "기도는 저들을 구하지 못해. 카그하에게 직접 건의하면 일이 바뀔지도 모르잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005
#. Speaker = Player
#. NodeID = 5d68ece1-6f00-b80d-528b-c070dd72a036
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidServant005_Knows_TalkedAboutLockdown(1) = False
#.   Global:
#.      - DEN_GroveConflict_State_DruidsPacified = False
#.      - DEN_GroveConflict_Knows_HeardAboutRitual = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005:5d68ece1-6f00-b80d-528b-c070dd72a036
msgctxt "h20a11af3g7a09g4b68g81c6ga5843e599331"
msgid "So you're really locking down the grove?"
msgstr "정말로 숲을 외부와 단절시킬 작정인가 보지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005
#. Speaker = Arron
#. NodeID = 5ee8e092-4e57-2103-ac01-c1e83e968bd7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_State_DruidsPacified = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005:5ee8e092-4e57-2103-ac01-c1e83e968bd7
msgctxt "hed71e8dfg165dg4fcbga4e7geb72ea8d7150"
msgid ""
"But you'll need to be quick - the ritual will be complete before too long."
msgstr "다만 서둘러 사야 할 거요. 머잖아 의식이 완료되어버릴 테니까 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005
#. Speaker = Arron
#. NodeID = 63d4008d-96e7-c482-5cf2-9a2f824ad0ad
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_General_State_RitualStoppedNoTieflings = True
#. SetFlags:
#.   Dialog:
#.     - DEN_druidservant_005_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005:63d4008d-96e7-c482-5cf2-9a2f824ad0ad
msgctxt "he43abcb8gbac6g4577gbda1g05c602a83ae8"
msgid "Another outsider? This place has certainly become popular."
msgstr "또 다른 외부인인가? 요즘 들어 눈에 띄게 숲이 북적대는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005
#. Speaker = Arron
#. NodeID = 65ef3630-286a-fd8c-a160-8847fde61f7b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_State_DruidsPacified = False
#. SetFlags:
#.   Quest:
#.     - GLO_Tadpole_SUB_Apprentice.LearnedAboutNettie(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005:65ef3630-286a-fd8c-a160-8847fde61f7b
msgctxt "hdbc44c30g35bcg493egaec2g5b8fda933e48"
msgid ""
"Nettie could put you to rights. She should be with the others in the inner "
"chambers, but I doubt she'll be taking on new patients. The grove will be "
"locked down soon."
msgstr ""
"네티를 찾으면 치료를 해줄 거요. 안쪽 터 실내에 다른 이들과 함께 있을 테지. 다만 새 환자를 받을 여유가 있을진 모르겠구려. 머잖아 "
"숲이 폐쇄될 예정이거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005
#. Speaker = Arron
#. NodeID = 71852463-01e1-eb1d-eb48-40812fd567d2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005:71852463-01e1-eb1d-eb48-40812fd567d2
msgctxt "h935c05bbg626bg445bg8bb1gcd671d116eb6"
msgid ""
"As I said, it's a drastic measure. But the survival of the grove is "
"paramount."
msgstr "이미 말했지만 극단적인 조치가 맞소. 하지만 숲의 생존이 우리에겐 최우선이외다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005
#. Speaker = Arron
#. NodeID = 8876d688-50bc-c63a-58e7-29fcd1f59deb
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidServant005_Knows_TalkedAboutLockdown(1) = True
#.   Global:
#.     - DEN_GroveConflict_Knows_HeardAboutRitual = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005:8876d688-50bc-c63a-58e7-29fcd1f59deb
msgctxt "hc8863b8bga4c5g4c5cg9e26ge0a6d8d9f49f"
msgid ""
"A drastic measure. But more monsters seem to terrorise this region every day."
msgstr "극단적인 조치이긴 하오. 하지만 날이 갈수록 괴물들이 기승을 부려대니 이럴 수밖에."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005
#. Speaker = Arron
#. NodeID = 89a5cc6e-a1ec-df19-bf0d-36ddab3beb1b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005:89a5cc6e-a1ec-df19-bf0d-36ddab3beb1b
msgctxt "hd018d965g5bcag4f90ga690gfd6254943312"
msgid ""
"I can do nothing but pray to Silvanus in the hopes that He'll protect them."
msgstr "내가 할 수 있는 건 실바누스께 저들을 가호해 주시길 기도하는 것뿐이외다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005
#. Speaker = Arron
#. NodeID = 8a74df8f-64d0-0cc5-4084-112af75f28bc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005:8a74df8f-64d0-0cc5-4084-112af75f28bc
msgctxt "hc69234b3g539cg4b27ga718gf0389c78a190"
msgid "You sound just like Kagha. Oh, that it had to come to this..."
msgstr "딱 카그하처럼 말하는구려. 아, 어쩌다 이 지경이 된 건지..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005
#. Speaker = Arron
#. NodeID = 8f8fc8aa-654b-b45b-290a-92f7b1ca1926
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005:8f8fc8aa-654b-b45b-290a-92f7b1ca1926
msgctxt "he2aa7323ged6cg4212g9b6fg2027b4bc8b77"
msgid "I pray no goblin arrow has grazed you!"
msgstr "고블린 화살에 상처라도 입은 게 아니길 비오!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005
#. Speaker = Player
#. NodeID = 9275d39e-2a7e-68a6-6f60-c00e922c2dd7
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidServant_005_SoldBefore(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005:9275d39e-2a7e-68a6-6f60-c00e922c2dd7
msgctxt "ha2e26b18gc64bg4c70ga652gdd570988f494"
msgid "I'd like to see your wares."
msgstr "물건 좀 보고 싶은데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005
#. Speaker = Arron
#. NodeID = 94a3f989-384b-88e7-bf33-ed1b4ddbf796
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005:94a3f989-384b-88e7-bf33-ed1b4ddbf796
msgctxt "h8cb4f656gbf0dg4eedga7e1ga8d6c3e48d1c"
msgid "Silvanus be with you."
msgstr "실바누스께서 함께 하시길."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005
#. Speaker = Arron
#. NodeID = 9a7733e7-4d43-6ff1-6e16-52b70f371f55
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005:9a7733e7-4d43-6ff1-6e16-52b70f371f55
msgctxt "h038e7bedg38c2g4be1g908egb5ee2b0eae55"
msgid "None will be able to enter - or leave."
msgstr "아무도 들어올 수도, 나갈 수도 없게 되지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005
#. Speaker = Arron
#. NodeID = 9b1b4b3c-0052-efff-ebc4-3eb74b108983
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005:9b1b4b3c-0052-efff-ebc4-3eb74b108983
msgctxt "ha7faa0c1g872ag44b7gb9d2g8e9fc7c3055d"
msgid ""
"Ah - I forgot you're a blow-in. A few days hence, this grove will be "
"completely concealed by thorny vines."
msgstr "아, 댁이 이방인이란 걸 깜빡했군. 며칠 이내로 이 숲은 가시덩굴로 뒤덮혀 완전히 감춰질 것이외다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005
#. Speaker = Arron
#. NodeID = 9cc2408f-85a5-5574-053c-3acdfb43ff31
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005:9cc2408f-85a5-5574-053c-3acdfb43ff31
msgctxt "h639c6470gc92ag4205gbaf7gedf26460bf14"
msgid "Silvanus guide your path."
msgstr "실바누스께서 인도해 주시길."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005
#. Speaker = Player
#. NodeID = a7d016ab-f1bc-da6e-0334-d2f8152d1b3a
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - REALLY_TIEFLING(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005:a7d016ab-f1bc-da6e-0334-d2f8152d1b3a
msgctxt "hb9d0da6eg77c4g4d87gb39egd34adff41432"
msgid "Casting out the tieflings. Original."
msgstr "티플링들을 몰아낸다라. 거 참 새삼스럽군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005
#. Speaker = Player
#. NodeID = a8c56535-767f-5e0e-e36e-0919abbb463c
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005:a8c56535-767f-5e0e-e36e-0919abbb463c
msgctxt "ha5e327afg8762g4190gb619g360a733cb852"
msgid "Dire times. High stakes. I understand."
msgstr "지독한 상황에, 위험부담은 크니까. 이해가 가네."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005
#. Speaker = Player
#. NodeID = a8c823ef-8a5d-dd83-aac1-5a885879b86b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_State_DruidsPacified = False
#.      - DEN_GroveConflict_Knows_HeardAboutRitual = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005:a8c823ef-8a5d-dd83-aac1-5a885879b86b
msgctxt "h0fab5e36g9722g4374gb307g6b8d0dc4178d"
msgid "Are you really locking down the grove?"
msgstr "정말로 숲을 외부와 단절시킬 작정인 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005
#. Speaker = Arron
#. NodeID = a9ed9bfc-f607-31f6-5927-741b2ba24132
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_druidservant_005_HasMet(1) = True
#. TagRule: DROWELF
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005:a9ed9bfc-f607-31f6-5927-741b2ba24132
msgctxt "h614d12afg2670g4851gb68cg0280fd9c40b6"
msgid ""
"Refugees, adventurers, and even a drow! No one in years and suddenly we're "
"overwhelmed."
msgstr "난민에, 모험가에, 이젠 드로우까지! 몇 년간 아무도 찾지 않던 곳이 갑자기 바글바글대는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005
#. Speaker = Arron
#. NodeID = a9ed9bfc-f607-31f6-5927-741b2ba24132
#. HandlePath = TaggedText[1].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_druidservant_005_HasMet(1) = True
#. TagRule: BESTIAL
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005:a9ed9bfc-f607-31f6-5927-741b2ba24132
msgctxt "hd2a19ecbg9d83g41a0gaef7g9b8ccb540f36"
msgid ""
"Refugees, adventurers, and now a far-out visitor! No one in years and "
"suddenly we're overwhelmed."
msgstr "난민에, 모험가에, 이젠 딴 세상의 방문자까지! 몇 년간 아무도 찾지 않던 곳이 갑자기 바글바글대는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005
#. Speaker = Arron
#. NodeID = a9ed9bfc-f607-31f6-5927-741b2ba24132
#. HandlePath = TaggedText[2].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_druidservant_005_HasMet(1) = True
#. TagRule: DUERGARDWARF
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005:a9ed9bfc-f607-31f6-5927-741b2ba24132
msgctxt "ha34b3528g1e75g4dcegb5a3ge8edfc574438"
msgid ""
"Refugees, adventurers, and even a duergar! No one in years and suddenly "
"we're overwhelmed."
msgstr "난민에, 모험가에, 이젠 듀에르가까지! 몇 년간 아무도 찾지 않던 곳이 갑자기 바글바글대는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005
#. Speaker = Arron
#. NodeID = a9ed9bfc-f607-31f6-5927-741b2ba24132
#. HandlePath = TaggedText[3].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - DEN_druidservant_005_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005:a9ed9bfc-f607-31f6-5927-741b2ba24132
msgctxt "h8964f820gc407g4b0fg9f36g035ede299bfd"
msgid "Refugees, adventurers - no one in years and suddenly we're overwhelmed."
msgstr "난민에, 모험가에... 몇 년간 아무도 찾지 않던 곳이 갑자기 바글바글대는군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005
#. Speaker = Player
#. NodeID = b89c649e-ea2c-51d9-aa61-ee90be813eb4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005:b89c649e-ea2c-51d9-aa61-ee90be813eb4
msgctxt "h57d5e313g371fg4de6ga66cgf3b2450f9d52"
msgid "What about the people here?"
msgstr "여기 있는 사람들은 어쩌고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005
#. Speaker = Player
#. NodeID = bdf50c48-647f-d5cd-6b56-3e55d71a0f0a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005:bdf50c48-647f-d5cd-6b56-3e55d71a0f0a
msgctxt "hab07ec82g91beg47c7gb77fg9ac17c995ba1"
msgid ""
"You just said the region's overrun by monsters. They won't survive by "
"themselves."
msgstr "이 일대에 괴물들이 기승을 부린다고 했잖아. 저들은 살아남을 재주가 없다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005
#. Speaker = Arron
#. NodeID = c6a99939-6451-6bbe-3c46-7405e379ac28
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_druidservant_005_HasMet(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005:c6a99939-6451-6bbe-3c46-7405e379ac28
msgctxt "h783af6fag46b7g4d0fg9586gd3cc57f62189"
msgid "Need anything else?"
msgstr "달리 필요한 거 있소?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005
#. Speaker = Arron
#. NodeID = c78fcd81-d875-28b6-be9d-7dad6c34ba14
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Tag:
#.      - DRUID(1) = True
#. SetFlags:
#.   Object:
#.     - DEN_DruidServant005_Event_RaiseAttitude(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005:c78fcd81-d875-28b6-be9d-7dad6c34ba14
msgctxt "h1b2914e9g87b6g4ff6ga121gf14d398811e0"
msgid "Is there anything you need? I lower my prices for fellow druids."
msgstr "뭐 필요한 거 있소? 같은 드루이드이니 싸게 팔아드리리다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005
#. Speaker = Player
#. NodeID = ccfb36fc-ca6d-f136-838b-c4dcedf6d934
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - DEN_DruidServant_005_SoldBefore(1) = False
#. SetFlags:
#.   Dialog:
#.     - DEN_DruidServant_005_SoldBefore(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005:ccfb36fc-ca6d-f136-838b-c4dcedf6d934
msgctxt "hfa94b4f5g31bfg4a92ga10cg332043a9b1f6"
msgid "What are you selling?"
msgstr "어떤 물건을 파는데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005
#. Speaker = Arron
#. NodeID = cd6da595-acaa-b732-4d87-6ba49d049f8a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005:cd6da595-acaa-b732-4d87-6ba49d049f8a
msgctxt "hb3f2dd91gb70eg41efg8be4g40c5a0b3644f"
msgid "Just some bits and bobs I no longer need."
msgstr "그냥 내게 더는 필요없는 잡다한 물건들이오."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005
#. Speaker = Player
#. NodeID = d737f528-9797-32e2-49d8-ea7d74311f1e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005:d737f528-9797-32e2-49d8-ea7d74311f1e
msgctxt "hf395d07fgdc94g4fb9ga02ag2e94c3c7d26c"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005
#. Speaker = Arron
#. NodeID = eac9ed1d-70d9-4e56-92f0-2b1d2d02c8a6
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_State_DruidsPacified = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005:eac9ed1d-70d9-4e56-92f0-2b1d2d02c8a6
msgctxt "h419524e3g38c6g4df3gbe85g06550579154e"
msgid ""
"Is there anything you need? Act fast if you do - the ritual will be complete "
"before too long."
msgstr "뭐 필요한 거 있소? 있다면 빨리 사시오. 머잖아 의식이 완료되어버릴 테니까 말이지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005
#. Speaker = Arron
#. NodeID = ecbbde40-e8c6-cca5-5947-4550eb708ae3
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005:ecbbde40-e8c6-cca5-5947-4550eb708ae3
msgctxt "hfdb6cc30gd6aeg4ad8gb652g75f8dbfe50c8"
msgid "I don't want this to happen either, but Kagha makes the decisions."
msgstr "나도 일이 그리되는 건 원치 않소. 결정권이 카그하에게 있어서 문제지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005
#. Speaker = Arron
#. NodeID = f0c00844-6026-caa0-1abb-a5d2f3dbeacf
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005:f0c00844-6026-caa0-1abb-a5d2f3dbeacf
msgctxt "haf9cb6adgd5c3g4433g9a16ge8332c9c2a3d"
msgid ""
"Well met, and thank you for beating back those goblins. Most brave of you."
msgstr "반갑소. 그 고블린 놈들 물리쳐준 것도 고맙고 말이오. 정말 용감하더이다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005
#. Speaker = Player
#. NodeID = f71b2eaa-452b-cfe2-6bc6-7ca0b5d01fda
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_GroveConflict_State_DruidsPacified = False
#.      - DEN_GroveConflict_Knows_HeardAboutRitual = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_005:f71b2eaa-452b-cfe2-6bc6-7ca0b5d01fda
msgctxt "h2a0d86abgb0a3g49b1g9dccgc94d1def9e66"
msgid "What ritual are you talking about?"
msgstr "의식이라니, 무슨 의식을 말하는 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_ChaseAwayBoar
#. Speaker = Apikusis
#. NodeID = 6843a7bf-eac4-ac9b-e6c9-5d5df8ecb7ab
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 8724b491-a686-e39a-3dc4-80a607af0e7f_C = True
#. SetFlags:
#.   Local:
#.     - 8724b491-a686-e39a-3dc4-80a607af0e7f_A = False
#.     - 8724b491-a686-e39a-3dc4-80a607af0e7f_C = False
#.     - 8724b491-a686-e39a-3dc4-80a607af0e7f_B = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_ChaseAwayBoar:6843a7bf-eac4-ac9b-e6c9-5d5df8ecb7ab
msgctxt "h16cb4439g2c36g40bfgb9f0g1e8ddb29d963"
msgid "You're testing my patience, pig."
msgstr "너는 내 인내심을 시험하고 있어, 돼지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_ChaseAwayBoar
#. Speaker = Apikusis
#. NodeID = 87b81ec1-da9d-fa6b-939e-653fe0318ab9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 8724b491-a686-e39a-3dc4-80a607af0e7f_B = True
#. SetFlags:
#.   Local:
#.     - 8724b491-a686-e39a-3dc4-80a607af0e7f_C = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_ChaseAwayBoar:87b81ec1-da9d-fa6b-939e-653fe0318ab9
msgctxt "h66ccba95g0215g450fg811dga957f308b2a7"
msgid "Please, Tusk. It's not the time."
msgstr "터스크, 제발. 지금은 그럴 때가 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_ChaseAwayBoar
#. Speaker = Apikusis
#. NodeID = c88d91b0-37f6-77c2-e849-a5e8167d4172
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 8724b491-a686-e39a-3dc4-80a607af0e7f_A = True
#. SetFlags:
#.   Local:
#.     - 8724b491-a686-e39a-3dc4-80a607af0e7f_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_ChaseAwayBoar:c88d91b0-37f6-77c2-e849-a5e8167d4172
msgctxt "h0c7af29cga709g4d97gbb02g14163a96ef94"
msgid "What did I tell you? Shoo!"
msgstr "내가 얘기했잖니? 훠이!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_ChaseAwayBoar
#. Speaker = Apikusis
#. NodeID = ce37f002-d2f0-b613-f7ec-4c2a7e977685
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - 8724b491-a686-e39a-3dc4-80a607af0e7f_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_ChaseAwayBoar:ce37f002-d2f0-b613-f7ec-4c2a7e977685
msgctxt "h7ea34c53g8356g436fg9c74g33182a9b0d71"
msgid "Not now, Tusk."
msgstr "지금 말고, 터스크."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_ChaseAwayBoar
#. Speaker = Tusk
#. NodeID = f977a060-20aa-7971-53d3-e348ff73f53e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_ChaseAwayBoar:f977a060-20aa-7971-53d3-e348ff73f53e
msgctxt "h27900fc4g77b3g40edgbdefg597428086cb9"
msgid "*Grunt!*"
msgstr "*끙!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Loic
#. NodeID = 03e863c6-e699-4bc3-1e38-8f782188cfcc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:03e863c6-e699-4bc3-1e38-8f782188cfcc
msgctxt "h39c01ff6g08dcg48b4g939eg903dd6557434"
msgid "He went to make sure those 'strays' could go."
msgstr "그 '부랑자'들이 떠날 수 있도록 하기 위해 그가 갔던 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Marcoryl
#. NodeID = 06c515f6-7e5b-508e-ea91-4d2815525b90
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:06c515f6-7e5b-508e-ea91-4d2815525b90
msgctxt "h9323a445g5bc9g4645ga69fgeb85d10f99ec"
msgid "Never took you for a coward."
msgstr "네가 겁쟁이인 줄은 몰랐는데."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Loic
#. NodeID = 085f621b-4b9b-5733-33eb-bdc556d63b6a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:085f621b-4b9b-5733-33eb-bdc556d63b6a
msgctxt "h9e035d8dg9adcg410egb780g2f481745ea17"
msgid "So that's what you want? To kill a bunch of innocents?"
msgstr "그게 네가 바라는 거란 말야? 무고한 이들을 몰살하는 거?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Marcoryl
#. NodeID = 112b1ebc-1a90-3d69-4ab3-4eb45ef10c9e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:112b1ebc-1a90-3d69-4ab3-4eb45ef10c9e
msgctxt "h4fac50a4g3a88g4c44gbf53gaad2841faf3a"
msgid "Good. Not another word then."
msgstr "좋아. 그럼 딴말하지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Marcoryl
#. NodeID = 14029734-a977-0c38-fd04-43f3cc0dc216
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:14029734-a977-0c38-fd04-43f3cc0dc216
msgctxt "h474ce2eegdf6eg4060gb622g8a07865e08f3"
msgid "By letting that child escape without consequence?"
msgstr "그 꼬맹이를 그냥 가게 해서 말이야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Marcoryl
#. NodeID = 1c72b26d-211a-2f0a-ae71-d3ddf4902b6d
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:1c72b26d-211a-2f0a-ae71-d3ddf4902b6d
msgctxt "h868d8a1egf5afg4c16ga5d4g1f756587e752"
msgid "Since they forced our hand."
msgstr "그들이 우리를 그렇게 만들었지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Marcoryl
#. NodeID = 20918f43-1cb2-2c69-b840-d88337a27d21
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:20918f43-1cb2-2c69-b840-d88337a27d21
msgctxt "h6ccf2c4eg39dfg4934g8bd3gb710d3dff667"
msgid "Exactly as we have always done - tend this grove. Nothing has changed."
msgstr "항상 해 온 대로 이 숲을 보살펴야지. 바뀐 건 아무것도 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Loic
#. NodeID = 2181c4e0-252f-3f82-c5c5-4fa018e530ea
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:2181c4e0-252f-3f82-c5c5-4fa018e530ea
msgctxt "h191e6d76gb7b0g4febga108g657d39795e4e"
msgid "What will we do without a First Druid?"
msgstr "최고 드루이드 없이 뭘 해야 하지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Loic
#. NodeID = 2c315734-07bb-f3b9-de9a-68c10e66da1a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:2c315734-07bb-f3b9-de9a-68c10e66da1a
msgctxt "ha342aef1g1e8cg41e7g9eeegb4f0345a8d56"
msgid "I can't believe he just left..."
msgstr "그가 떠났다니.. 믿을 수 없어..."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Loic
#. NodeID = 307b48b1-fb99-7f2f-ce75-b0d5e5280302
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#.      - DEN_ShadowDruid_State_KaghaIsDead = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:307b48b1-fb99-7f2f-ce75-b0d5e5280302
msgctxt "ha7df5301g53e8g4788gad4dg68a0bc7b30d4"
msgid "Oh? Because things went so well with Kagha?"
msgstr "오? 카그하랑은 일이 잘 풀리나 봐?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Loic
#. NodeID = 3564c934-c2e9-85ce-1123-da3534807786
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:3564c934-c2e9-85ce-1123-da3534807786
msgctxt "h769cc6feg7395g4598gaa38gca9b02bf4c1d"
msgid "It was steeped in shadow magic!"
msgstr "그 의식은 그림자 마법에 물들고 있었다고!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Loic
#. NodeID = 3bcadbb7-b33f-a565-1ebc-765316f0845e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:3bcadbb7-b33f-a565-1ebc-765316f0845e
msgctxt "h350c9538ge9d5g4053g9617gadc4f350e60d"
msgid "Stopping the ritual was the right thing to do."
msgstr "의식을 중단하는 것이 옳은 일이었다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Marcoryl
#. NodeID = 3f9561ad-9863-1bb9-a7ba-011f77950606
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = True
#. SetFlags:
#.   Local:
#.     - ca797aab-5a73-7ec5-edb7-022122573b39_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:3f9561ad-9863-1bb9-a7ba-011f77950606
msgctxt "h62a07720g6aebg4e37g8fc9gfacd19ec9fa2"
msgid "What is Kagha thinking?"
msgstr "카그하는 무슨 생각인데?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Loic
#. NodeID = 3feb8993-efc2-9d70-f923-58d325f51206
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:3feb8993-efc2-9d70-f923-58d325f51206
msgctxt "hc53c06ebg4dfbg400bgb652g262921586f7a"
msgid "I'm no fan of those devils either, but they're leaving."
msgstr "나도 저 데빌들에게 좋은 감정은 없지만, 어쨌든 여길 떠나고 있잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Loic
#. NodeID = 40302fed-84eb-6d63-8784-d5ea6dac1b9a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:40302fed-84eb-6d63-8784-d5ea6dac1b9a
msgctxt "h29dce5b9g5142g4618ga784g2a5558d6c1fd"
msgid "Don't say that."
msgstr "그런 말 하지 마."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Marcoryl
#. NodeID = 4829e9d5-9235-7a5b-e81a-627a522f08c4
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:4829e9d5-9235-7a5b-e81a-627a522f08c4
msgctxt "h22a956d1g9b40g4f14g8799gcf1d22e8deda"
msgid "What if they try to steal from us? Again?"
msgstr "걔네들이 우리 걸 또 훔치려고 하면 어떡하지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Marcoryl
#. NodeID = 4cd8f138-9104-4e0f-737e-b818a4f969fd
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_State_Returned = True
#.      - DEN_AttackOnDen_State_DenVictory = True
#.      - GLO_Halsin_State_PermaDefeated = False
#.   Local:
#.      - ca797aab-5a73-7ec5-edb7-022122573b39_A = True
#. SetFlags:
#.   Local:
#.     - ca797aab-5a73-7ec5-edb7-022122573b39_A = False
#.     - ca797aab-5a73-7ec5-edb7-022122573b39_B = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:4cd8f138-9104-4e0f-737e-b818a4f969fd
msgctxt "hf5b13cc7gfef0g45ceg9f2ag5696b149d5a8"
msgid "Master Halsin's past his prime. It might be time for another."
msgstr "마스터 할신의 전성기는 지났어. 새로운 지도자가 필요할 때가 온 것 같아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Marcoryl
#. NodeID = 5620e5fc-051f-fa6f-eaf7-7496fdc25079
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:5620e5fc-051f-fa6f-eaf7-7496fdc25079
msgctxt "h02aedbc5g6eaag4021ga2b9g12569d0d837e"
msgid ""
"The grove suffered because of Halsin. We have no need of him. Not anymore."
msgstr "할신 때문에 숲이 고통받았어. 우린 더 이상 그가 필요하지 않아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Loic
#. NodeID = 57c2096e-567d-1a06-a637-3e4ba342b8ca
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#.   Local:
#.      - ca797aab-5a73-7ec5-edb7-022122573b39_A = True
#.      - ca797aab-5a73-7ec5-edb7-022122573b39_B = True
#. SetFlags:
#.   Local:
#.     - ca797aab-5a73-7ec5-edb7-022122573b39_A = False
#.     - ca797aab-5a73-7ec5-edb7-022122573b39_B = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:57c2096e-567d-1a06-a637-3e4ba342b8ca
msgctxt "hfd663315g455dg4847g9d14gd78e4ebfb879"
msgid "This isn't why I became a druid."
msgstr "내가 드루이드가 된 이유는 이게 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Loic
#. NodeID = 614765d9-842b-fe7b-8782-2f674a4f34bd
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:614765d9-842b-fe7b-8782-2f674a4f34bd
msgctxt "hbef5eaabga910g4de4g9d5fg57773f7ba356"
msgid "We'll find another way to stop them. We must."
msgstr "우린 그들을 멈출 다른 방법을 찾을 거야. 반드시."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Loic
#. NodeID = 65459bb1-8586-b81a-23e1-cf563283c006
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#. SetFlags:
#.   Local:
#.     - ca797aab-5a73-7ec5-edb7-022122573b39_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:65459bb1-8586-b81a-23e1-cf563283c006
msgctxt "hfcfb64ccge4d5g4cdfg9ab0g5bc206ffb523"
msgid "If only we'd never let the tieflings in... the child might have lived."
msgstr "우리가 티플링들을 들여보내지 않았더라면... 그 아이는 살았을지도 몰라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Marcoryl
#. NodeID = 683366bf-ea2c-93c6-a12d-b2f0e514d09a
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:683366bf-ea2c-93c6-a12d-b2f0e514d09a
msgctxt "h71ee5e41g6edcg4350ga8a2g6a23e79575fc"
msgid "He lost sight of what is important."
msgstr "그는 뭐가 중요한지에 대한 통찰을 잃었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Loic
#. NodeID = 6b879e7e-eb6d-b763-bd8f-a2762102fff2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:6b879e7e-eb6d-b763-bd8f-a2762102fff2
msgctxt "hcbe88fd4g0395g466eg9f59gbd86348b9a50"
msgid "You think so?"
msgstr "그렇게 생각해?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Loic
#. NodeID = 6dcf73b2-c31a-8dc0-04a3-9ddea1f27686
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:6dcf73b2-c31a-8dc0-04a3-9ddea1f27686
msgctxt "h60ecbcb1g56ecg49fbgb03dg26012125f355"
msgid "Are you the one doubting her now?"
msgstr "지금 그녀를 의심하는 건가?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Marcoryl
#. NodeID = 6f8b72d7-9ed8-e889-f90a-3517be9415a9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = True
#.   Local:
#.      - ca797aab-5a73-7ec5-edb7-022122573b39_A = True
#. SetFlags:
#.   Local:
#.     - ca797aab-5a73-7ec5-edb7-022122573b39_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:6f8b72d7-9ed8-e889-f90a-3517be9415a9
msgctxt "hf732cc0fga7e3g4467g88f9g007b6fc406a8"
msgid "We might as well lay down and let the goblins cut us up."
msgstr "그냥 여기 드러 누워서 고블린들이 우리를 베어버리길 기다리는 게 낫겠군."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Loic
#. NodeID = 71d21a22-e7f8-5b70-2a64-e06d745c6f30
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#.      - GLO_Halsin_State_PermaDefeated = True
#. SetFlags:
#.   Local:
#.     - ca797aab-5a73-7ec5-edb7-022122573b39_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:71d21a22-e7f8-5b70-2a64-e06d745c6f30
msgctxt "h27261d62g7f61g4252gabacg8eec7adcfef0"
msgid "I still can't believe Master Halsin is dead."
msgstr "마스터 할신이 죽었다는 걸 아직도 믿을 수 없어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Loic
#. NodeID = 74a767a9-8e9d-037f-b707-81b4913f1ae1
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:74a767a9-8e9d-037f-b707-81b4913f1ae1
msgctxt "he632670cg1f83g451cgb0a8g6959dbf8ba62"
msgid "Yet she failed - that's what matters."
msgstr "시도에 그쳤잖아. 그게 중요한 거지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Marcoryl
#. NodeID = 7789261f-12b5-b126-5a95-39f169bb1a7f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:7789261f-12b5-b126-5a95-39f169bb1a7f
msgctxt "hb3535049g6bd9g4028g80eagbd12056edaf8"
msgid "We have the right to defend our home."
msgstr "우리 집을 지킬 권리가 있어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Loic
#. NodeID = 78d418ed-a55e-5999-f0a1-18968c8f17ba
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - ca797aab-5a73-7ec5-edb7-022122573b39_A = True
#. SetFlags:
#.   Local:
#.     - ca797aab-5a73-7ec5-edb7-022122573b39_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:78d418ed-a55e-5999-f0a1-18968c8f17ba
msgctxt "h957196a1g184eg438cg8931gec08e048215f"
msgid "This will all be over. The ritual's almost finished."
msgstr "곧 전부 끝날 거야. 의식이 거의 완료되기 직전이거든."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Loic
#. NodeID = 7ec5182e-9df0-3cf3-6c16-c2a54db3db81
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:7ec5182e-9df0-3cf3-6c16-c2a54db3db81
msgctxt "h549192a1g8a82g4d50g9770gfc186490beb6"
msgid "Since when did we become killers?"
msgstr "언제부터 우리가 살인자가 된 거야?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Marcoryl
#. NodeID = 82268adc-4e9f-0867-c1dc-285ccf405bf6
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:82268adc-4e9f-0867-c1dc-285ccf405bf6
msgctxt "hd35f7a63g0c8dg47adga346g0b0864f82c93"
msgid "What will happen to the grove? To us?"
msgstr "숲에는 무슨 일이 벌어질까? 우리에게는?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Marcoryl
#. NodeID = 8479cb7f-b3f5-8465-5792-4ee16d2b9024
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:8479cb7f-b3f5-8465-5792-4ee16d2b9024
msgctxt "h1b0ff59cg4e3dg4c78g87c5g7cfdc7b1ea4a"
msgid "Like that'll do any good! That ritual was our salvation."
msgstr "그래서 그게 뭐가 도움이 되겠어! 그 의식이 우리의 구원이었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Loic
#. NodeID = 886fcb0b-b128-1d43-c443-a5975fc6a8d9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:886fcb0b-b128-1d43-c443-a5975fc6a8d9
msgctxt "hdcd01a57gd574g421ega286g8e92c46e52e7"
msgid "She's a child."
msgstr "어린 아이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Marcoryl
#. NodeID = 8c1e140f-cb90-4ee4-8e7e-e5ace4becad0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:8c1e140f-cb90-4ee4-8e7e-e5ace4becad0
msgctxt "hf14864a2g77d2g4a16g82ddg016862a6d416"
msgid "But to not even consult with us?"
msgstr "하지만 우리와 상의도 하지 않았다고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Loic
#. NodeID = 95977d2b-e5a0-f6c9-0776-0f041fdc28fc
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_Event_KaghaTurnedGood = True
#.   Local:
#.      - ca797aab-5a73-7ec5-edb7-022122573b39_A = True
#.      - ca797aab-5a73-7ec5-edb7-022122573b39_B = True
#. SetFlags:
#.   Local:
#.     - ca797aab-5a73-7ec5-edb7-022122573b39_A = False
#.     - ca797aab-5a73-7ec5-edb7-022122573b39_B = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:95977d2b-e5a0-f6c9-0776-0f041fdc28fc
msgctxt "h5ca06346gd509g4c71gb63cgd0a5af6b3946"
msgid "The ritual was flawed. It could've damaged the grove."
msgstr "그 의식에는 문제가 있었어. 숲에 해를 끼쳤을지도 몰라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Loic
#. NodeID = 9d4760b6-3d81-bca0-2363-54c17c7b3e92
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - GLO_Halsin_State_Returned = True
#.      - DEN_AttackOnDen_State_DenVictory = True
#.      - GLO_Halsin_State_PermaDefeated = False
#. SetFlags:
#.   Local:
#.     - ca797aab-5a73-7ec5-edb7-022122573b39_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:9d4760b6-3d81-bca0-2363-54c17c7b3e92
msgctxt "h641ca8a5gf491g4a55gb033gfd55a549507b"
msgid "Master Halsin's home - by Silvanus' mercy."
msgstr "실바누스님의 자비로 마스터 할신께서 돌아오셨어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Loic
#. NodeID = 9edd4f55-a016-e5e9-db78-f32ae33eaeec
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:9edd4f55-a016-e5e9-db78-f32ae33eaeec
msgctxt "h6a243099gd0c1g4defg8fadgb701801d6e35"
msgid "They'll have to cut through all those tieflings first."
msgstr "고블린들은 먼저 티플링들을 모두 베어버려야 할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Marcoryl
#. NodeID = ae4e7bea-1515-39e1-e867-12d6e0a3ff97
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:ae4e7bea-1515-39e1-e867-12d6e0a3ff97
msgctxt "h5842d463g2bd3g4d37g9697gee527f3bbca4"
msgid "You have master Halsin to blame for that."
msgstr "그건 할신 님의 탓이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Marcoryl
#. NodeID = af5bbb5b-9d6b-483f-a4c3-083b000260c8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:af5bbb5b-9d6b-483f-a4c3-083b000260c8
msgctxt "h12e47703g2b3cg4b73g9b4bgc6bee5d19231"
msgid "And if it comes to a fight? You'll not shy away from bloodshed I hope."
msgstr "만약 싸움을 피할 수 없다면? 네가 피를 보는 것을 두려워 하지 않길 바라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Marcoryl
#. NodeID = b2453e19-756e-b25a-173a-159629d8382e
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:b2453e19-756e-b25a-173a-159629d8382e
msgctxt "ha8d7d57ag608cg46b1gad23g776620a0e8b5"
msgid ""
"I don't want to kill anyone - but I won't let this grove be harmed. Not "
"again."
msgstr "누구도 죽이고 싶진 않지만 다시는 이 숲이 파괴되게 두진 않을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Marcoryl
#. NodeID = bc365819-ac99-730a-e800-d6fc11b959bc
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:bc365819-ac99-730a-e800-d6fc11b959bc
msgctxt "h5618f2d1gac94g413cg9639gc5b70e70e337"
msgid "We can't do the same."
msgstr "우리마저 그렇게 되어선 안 돼."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Marcoryl
#. NodeID = c0041741-56f3-2a3b-222d-b762cffd8e24
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:c0041741-56f3-2a3b-222d-b762cffd8e24
msgctxt "heb49e9e5g2b48g4b14gbc84g3660f5e63a17"
msgid "Having second thoughts?"
msgstr "마음이 변했어?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Marcoryl
#. NodeID = c3f2fc1e-d1d3-6afa-f9db-625fb4418794
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Local:
#.     - ca797aab-5a73-7ec5-edb7-022122573b39_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:c3f2fc1e-d1d3-6afa-f9db-625fb4418794
msgctxt "h696b204cgfbdfg458fg9c3bg5ad092aecfcd"
msgid "Ridiculous. We just let her run off?"
msgstr "말도 안 돼. 그걸 그냥 보내준다고?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Loic
#. NodeID = c806651e-44bf-d154-38bd-9bd994eaede8
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:c806651e-44bf-d154-38bd-9bd994eaede8
msgctxt "h823d0366ge344g4df2ga5f6g354e6769376d"
msgid "I'm not."
msgstr "겁쟁이 아니야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Marcoryl
#. NodeID = cba5710e-3b8b-7795-9eec-bd15aec04c85
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:cba5710e-3b8b-7795-9eec-bd15aec04c85
msgctxt "hdaf3e32ag46e8g41d1g8816g75109a64f003"
msgid "It might've been better if he stayed away."
msgstr "차라리 계속 떠나 있는 편이 더 나았을지도 모르지."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Marcoryl
#. NodeID = ceabb447-3692-4bd1-92a5-ccfc46f89dc2
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:ceabb447-3692-4bd1-92a5-ccfc46f89dc2
msgctxt "hd0386a48g7acfg4271g8103gb8faaf9ee029"
msgid "If it had been up to Kagha, they would never have been here at all."
msgstr "카그하였더라면 저들은 여기 오지도 못했을걸."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Loic
#. NodeID = d31d2d6e-e73e-d69f-f833-44e97d4c7a4f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:d31d2d6e-e73e-d69f-f833-44e97d4c7a4f
msgctxt "h68b332aega4f1g4e91ga597g55d5ab40d67a"
msgid "I just hope they leave, and we can close this grove in peace."
msgstr "난 저들이 떠나고 평화롭게 숲을 닫을 수 있기만을 바랄 뿐이야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Marcoryl
#. NodeID = d47e2e0f-658b-072d-cfb6-fe15a3f1c0b0
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:d47e2e0f-658b-072d-cfb6-fe15a3f1c0b0
msgctxt "h4dbdb7a7gac50g408bg9457g135290a981df"
msgid "And if the goblins get in here?"
msgstr "그런데 만약 고블린들이 여기 안쪽까지 침입한다면?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Marcoryl
#. NodeID = d5375e94-76d0-c390-bc77-be5eeb02d935
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_ShadowDruid_State_KidDied = True
#.   Local:
#.      - ca797aab-5a73-7ec5-edb7-022122573b39_A = True
#. SetFlags:
#.   Local:
#.     - ca797aab-5a73-7ec5-edb7-022122573b39_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:d5375e94-76d0-c390-bc77-be5eeb02d935
msgctxt "hc40362deg8913g471dgac85g1e32180fa741"
msgid "I pray the tieflings realise we are not to be trifled with."
msgstr "티플링들이 우리를 우습게 보면 안된다는 것을 깨달았길 바라."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Marcoryl
#. NodeID = d7ee73a7-a68f-b2ac-a598-2df91d21e4a9
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:d7ee73a7-a68f-b2ac-a598-2df91d21e4a9
msgctxt "h4dbe4cf4g8a42g42b7g9167gcdbab6dc2428"
msgid "We might as well have lain on the ground and let them trample us."
msgstr "가만히 드러누워서 저들이 우릴 짓밟게 놔두는 거나 다름 없잖아."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Loic
#. NodeID = dbb06c2f-8f40-39c6-4c66-f1b778002fe4
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Global:
#.      - DEN_AttackOnDen_State_DenVictory = True
#.      - GLO_Halsin_State_PermaDefeated = True
#.   Local:
#.      - ca797aab-5a73-7ec5-edb7-022122573b39_A = True
#. SetFlags:
#.   Local:
#.     - ca797aab-5a73-7ec5-edb7-022122573b39_A = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:dbb06c2f-8f40-39c6-4c66-f1b778002fe4
msgctxt "he360ebe4gae66g402cgbda0gaaa4e5878f16"
msgid "Master Halsin was a First Druid. None of us can match him in power."
msgstr "마스터 할신은 최고 드루이드였어. 우리 중 누구도 할신 님의 힘에 견주지 못할 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Loic
#. NodeID = de1bb7d3-95fa-aaf6-235f-470804da804f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:de1bb7d3-95fa-aaf6-235f-470804da804f
msgctxt "h9363e132g70d6g4581g81c3gdd147dbaca24"
msgid "It's not that. I just wish there was another way."
msgstr "그게 아니야. 그냥 다른 방법이 있었다면 좋았을 거야."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Marcoryl
#. NodeID = e065810d-02ed-8d51-421c-3567b838cc66
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:e065810d-02ed-8d51-421c-3567b838cc66
msgctxt "h6dc71fe2gffe9g402agaa26gc8a6ecb7fbd6"
msgid "O-of course not! But this was our best defence!"
msgstr "무, 물론 아니야! 하지만 의식은 우리의 최고 방어 수단이었잖아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Loic
#. NodeID = e0985c2a-a046-8e6c-201d-5d14c6ea1973
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:e0985c2a-a046-8e6c-201d-5d14c6ea1973
msgctxt "hcf64f15fgf7afg4e74ga3bfg7fee8234a9df"
msgid "We've shown them once - we take grove law seriously."
msgstr "우리가 숲의 법을 중요히 여긴다는 걸 그들에게 보여줬어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Marcoryl
#. NodeID = e4611b01-0138-6fba-5122-33c21dd34884
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:e4611b01-0138-6fba-5122-33c21dd34884
msgctxt "h336c1161g1241g46f4gb960g988222523bec"
msgid "Come now. He took IN those strays, and then he just left!"
msgstr "아니 글쎄. 할신이 그 부랑자들을 <b>데리고 와놓고는</b> 자기는 그냥 가버렸잖아!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Loic
#. NodeID = e733b011-b497-cc58-1d90-193fbadcb601
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - ca797aab-5a73-7ec5-edb7-022122573b39_A = True
#.      - ca797aab-5a73-7ec5-edb7-022122573b39_B = True
#. SetFlags:
#.   Local:
#.     - ca797aab-5a73-7ec5-edb7-022122573b39_A = False
#.     - ca797aab-5a73-7ec5-edb7-022122573b39_B = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:e733b011-b497-cc58-1d90-193fbadcb601
msgctxt "h2d85d1d7g2996g4990g9f35gddb6c3a7e91c"
msgid "I don't want blood on my hands."
msgstr "내 손에 피 묻히기 싫어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Marcoryl
#. NodeID = f23930ec-0df0-da0a-3709-46c4f3690056
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:f23930ec-0df0-da0a-3709-46c4f3690056
msgctxt "h70a0d2fegded3g4b98ga511gdafdbddb206a"
msgid ""
"I can. He let in outsiders, then rushed off - he's made one mistake after "
"the other."
msgstr "난 그럴만하다고 봐. 외부인을 들여보내고, 서둘러 떠나는 실수를 연이어 저지르고 말았어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Marcoryl
#. NodeID = f95493ce-7661-d751-418f-a3a743e3836f
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:f95493ce-7661-d751-418f-a3a743e3836f
msgctxt "h764d0234gaa9bg44f1ga170gdd3b09cf10bc"
msgid "I know it."
msgstr "그래."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate
#. Speaker = Marcoryl
#. NodeID = feec5523-4139-46e3-b72f-9733b32c3b82
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidServant_AD_Debate:feec5523-4139-46e3-b72f-9733b32c3b82
msgctxt "h4e434cb1gc258g4834g9c03g6ebdf6a46cf6"
msgid "A <i>devil </i>child. One who tried to steal from us."
msgstr "<i>데빌</i> 꼬맹이지. 손버릇 나쁜 도둑년이고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_Adventurer02
#. Speaker = Barth
#. NodeID = 6ea42c6d-8c7c-943d-e9fc-5fb29cb1099b
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 7a31d7a5-c394-e524-85f5-5a33bbc699f3_C = True
#. SetFlags:
#.   Local:
#.     - 7a31d7a5-c394-e524-85f5-5a33bbc699f3_C = False
#.     - 7a31d7a5-c394-e524-85f5-5a33bbc699f3_B = False
#.     - 7a31d7a5-c394-e524-85f5-5a33bbc699f3_A = False
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_Adventurer02:6ea42c6d-8c7c-943d-e9fc-5fb29cb1099b
msgctxt "hc530c575g92b3g4376g9de5ga1d4a0e08126"
msgid "Damn this. Damn them. Damn everything."
msgstr "좆 까라지. 놈들도 좆 까고. 다 좆 까라 그래."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_Adventurer02
#. Speaker = Barth
#. NodeID = 870b7d52-c8eb-55ca-46e4-9849bee95910
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 7a31d7a5-c394-e524-85f5-5a33bbc699f3_C = False
#.      - 7a31d7a5-c394-e524-85f5-5a33bbc699f3_B = False
#.      - 7a31d7a5-c394-e524-85f5-5a33bbc699f3_A = True
#. SetFlags:
#.   Local:
#.     - 7a31d7a5-c394-e524-85f5-5a33bbc699f3_B = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_Adventurer02:870b7d52-c8eb-55ca-46e4-9849bee95910
msgctxt "hee2270b3g26fbg4fbagbed1g587ea902ae36"
msgid "We should be back in the Gate by now."
msgstr "진즉에 발더스 게이트에 도착했어야 한다고."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_Adventurer02
#. Speaker = Barth
#. NodeID = d452153b-abfd-14d7-a379-42a894c705d9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 7a31d7a5-c394-e524-85f5-5a33bbc699f3_C = False
#.      - 7a31d7a5-c394-e524-85f5-5a33bbc699f3_B = False
#.      - 7a31d7a5-c394-e524-85f5-5a33bbc699f3_A = False
#. SetFlags:
#.   Local:
#.     - 7a31d7a5-c394-e524-85f5-5a33bbc699f3_A = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_Adventurer02:d452153b-abfd-14d7-a379-42a894c705d9
msgctxt "h4928ed00gb3b8g4c27g82fag7b88a2776d1b"
msgid "Had my fill of this place."
msgstr "여긴 이제 진절머리 나."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_General_AD_Adventurer02
#. Speaker = Barth
#. NodeID = f51c017a-d1c7-7fcd-9a11-3c39727c510c
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - 7a31d7a5-c394-e524-85f5-5a33bbc699f3_C = False
#.      - 7a31d7a5-c394-e524-85f5-5a33bbc699f3_B = True
#. SetFlags:
#.   Local:
