msgid "<i>Rhaal'tuuch</i>!"
msgstr "<i>라아알'투우치</i>!"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/ADs/GOB_DrowCommander_AD_WaitingBold
#. Speaker = Warrior Clack
#. NodeID = 384ee262-9f55-4b30-2b24-78bb59fad87b
#. HandlePath = TaggedText[0].TagText[0]
