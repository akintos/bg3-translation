msgctxt "h5fcffc96gb06eg410fgb82bg7b8f9450179f"
msgid "<i>Leave.</i>"
msgstr "<i>떠난다.</i>"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Swamp/HAG_GurHunter_Dead
#. Speaker = Player
#. NodeID = 54459843-cbe1-0549-969f-7ea66ffe1bc4
