msgctxt "hab42590fg2343g4895ga1ccgaf4369427781"
msgid "*Your mind lurches, reeling suddenly as if... bitten.*"
msgstr "*뭔가에 깨물린 것처럼 느닷없이 정신이 휘청거립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards
#. Speaker = Goblin Warrior
#. NodeID = f1ce5e5e-8e47-3636-3ba3-8c6b0729169b
#. HandlePath = TaggedText[0].TagText[0]
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards:f1ce5e5e-8e47-3636-3ba3-8c6b0729169b
msgctxt "h39f953d6ga730g40f5g8c1fgb645f2f440c8"
msgid ""
"Local soil-scratchers probably called it something else, but they's dead a "
"hundred years."
msgstr "이 동네 농사꾼들은 아마 다른 이름으로 불렀을 테지만, 이제 죄다 백 번은 죽었어."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GoblinAmbush_CheckpointGuards
#. Speaker = Player
#. NodeID = fcc25420-8769-5cd1-6d80-f01d974660e2
#. HandlePath = TaggedText[0].TagText[0]
