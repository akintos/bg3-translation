msgid "You are not the one I wish to speak with."
msgstr "너와는 할 말이 없어."

#. Dialog = Mods/GustavDev/Story/Dialogs/Act1b/AstralPlane/CRE_AstralPrison_DaisyCaveEntrance
#. Speaker = Astarion
#. NodeID = f86d9f87-6a57-470e-9d2a-266668be9b68
