msgctxt "h9bf3a605gd26eg460dg964fg40970df09a81"
msgid "C'mon. Scream. SCREAM OR BEG."
msgstr "좀. 비명을 지르라고. <b>비명을 지르던가 빌어봐</b>."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Torturers_Torture
