msgctxt "h3ae1743egd40fg4fdeg82c3ge441d2546df2"
msgid "Master Halsin forgive us."
msgstr "마스터 할신께서 우리를 용서하시길."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_BardAndKidAfterAttack
#. Speaker = Zaki
#. NodeID = 43caedc1-410f-65ff-819f-d60c37253dd3
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Local:
#.      - f108995b-14f4-7823-d218-790177a93da8_B = True
