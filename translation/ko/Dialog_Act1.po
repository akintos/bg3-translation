msgctxt "he6d8ed0cg5192g40deg803eg05be9ea0bf27"
msgid "Who did you answer to?"
msgstr "누구의 명을 따랐지?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Dead
#. Speaker = Player
#. NodeID = defdd00b-4b6d-e262-0308-d02be74c48b9
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_QuestionsLimitReached(0) = False
#. SetFlags:
#.   Object:
#.     - GLO_SpeakWithDead_Event_QuestionAsked(0) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Dead:defdd00b-4b6d-e262-0308-d02be74c48b9
msgctxt "h6064ae9fgfed2g4f67gac13g3fca6fedea94"
msgid "Did you have any valuables?"
msgstr "지니고 있던 귀중품이 있나?"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Dead
#. Speaker = Narrator
#. NodeID = efa1e4c4-b790-9e7b-c673-0187d583acce
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Object:
#.      - GLO_SpeakWithDead_State_Killer(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_Dead:efa1e4c4-b790-9e7b-c673-0187d583acce
msgctxt "h73049fc0g1b01g4a04ga998g91e6903bd5c4"
msgid "*The corpse seems willing to speak - but not to its killer.*"
msgstr "*시체는 말할 의지가 있지만, 자신을 죽인 자와 대화하고 싶지는 않은 듯 합니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_GnomeGoblin1_StatusFallback
#. Speaker = Fezzerk
#. NodeID = 273818d3-4407-4628-8386-909b6754d0f0
