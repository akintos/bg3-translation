msgid ""
"I don't have the Fists to take on a Zhentarim base. We're stretched thin as "
"it is."
msgstr ""

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Plains/PLA_FlamingFist7
#. Speaker = Gauntlet Dain
#. NodeID = 5aa19dce-8c09-2da1-0338-ecbfc0d602e2
