#.   Object:
#.      - GLO_TadpoledCount3(1) = False
#.   Tag:
#.      - TRUESOUL(1) = False
#. SetFlags:
#.   Object:
#.     - GLO_TadpoledCount3(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_GoblinSleeper_02:f922f931-c2f8-6320-85c5-bfbd07d131ec
msgctxt "hfb619371gabf9g425cga583g661c60e078fa"
msgid "*Your mind lurches, reeling suddenly as if... bitten.*"
msgstr "*뭔가에 깨물린 것처럼 느닷없이 정신이 휘청거립니다.*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Ogre_00
#. Speaker = Guard Gurgon
#. NodeID = 273e130d-9f69-6788-19d8-e8168eacdecd
#. HandlePath = TaggedText[0].TagText[0]
#. SetFlags:
#.   Dialog:
#.     - GOB_Festivities_HasMet_Ogre_00(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Ogre_00:273e130d-9f69-6788-19d8-e8168eacdecd
msgctxt "h11f07ae7g7c31g4053gb286gc0187f47b9e4"
msgid "No go inside. Inside boring."
msgstr "안에 가지 마라. 안은 지루하다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Ogre_00
#. Speaker = Guard Gurgon
#. NodeID = 91c1187c-30fe-2388-61cb-e977d901ae79
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
#.   Dialog:
#.      - GOB_Festivities_HasMet_Ogre_00(1) = True
#: Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Ogre_00:91c1187c-30fe-2388-61cb-e977d901ae79
msgctxt "h532633edg736dg414agbe04ge8bcab4d7fe6"
msgid "Here has music, beer, dance! You dance too."
msgstr "여기는 음악, 맥주, 춤이 있다! 너도 춤 추면 된다."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Goblin/GOB_Festivities_Ogre_00
#. Speaker = Guard Gurgon
#. NodeID = f1a1de54-8187-44d3-7907-5c7896f16e25
