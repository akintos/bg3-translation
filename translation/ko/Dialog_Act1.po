#.      - 7c86843a-fb12-8ba6-ba76-80306579fc6d_a = True
#.      - 7c86843a-fb12-8ba6-ba76-80306579fc6d_b = False
#. SetFlags:
#.   Local:
#.     - 7c86843a-fb12-8ba6-ba76-80306579fc6d_b = True
#: Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_HideoutLeader:db92088a-e202-53f3-ab6b-cca46c99ad0f
msgctxt "h2c9f0950g4870g492dg9883ge75038461674"
msgid "Stay with me. Whatever happens."
msgstr "무슨 일이 있더라도 함께 있어 줘."

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/DEN/DEN_DruidAttack_AD_IrritatedTieflingTrainingAfterAttack
