msgctxt "h3485d18bg1df5g4a74g9acbgcf777e92e24c"
msgid "*<i>Grrrr</i>-arf! Arf! Arf!*"
msgstr "*<i>그르렁</i>-멍! 멍! 멍!*"

#. Dialog = Mods/Gustav/Story/Dialogs/Act1/Forest/FOR_Courier_Dog
#. Speaker = Player
#. NodeID = 5f484b06-9492-c423-9143-725a0705e5b1
#. HandlePath = TaggedText[0].TagText[0]
#. CheckFlags:
